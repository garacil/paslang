# paslang: what the repository leaves out.

# Built by configure and make: objects, assembly, binaries, units.
build/
/bin/
*.go.bin
/units/
/config.log
/config.status
/config.mk
a.out
*.o
*.core
__pycache__/

# The Go source tree kept here as a reference, not paslang's.
/golang/

# The working rules of the project, not documentation of paslang.
/REGLAS_DE_ORO.md

# Settings of the tools of this machine.
/.vscode/
/.idea/
*.swp
*~

# docs: only paslang's own documentation. The references (docs/ref:
# manuals, standards, Go's sources), the benchmark records, the audits,
# the milestones and the working notes stay out.
/docs/*
!/docs/MANUAL.md
!/docs/manual/
!/docs/HELP.md
!/docs/TYPES.md
!/docs/GC.md
!/docs/QUAD.md
!/docs/KERNELS.md
!/docs/VISION.md
!/docs/CONSTRAINTS.md
