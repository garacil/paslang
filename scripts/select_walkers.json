    "pasopt:topt.copys": {
      "mode": "limited",
      "reason": "InlineAt is gated by Inlinable/PlainS; UnrollAt rejects non-PlainS before CopyS. PlainS rejects skSelect and nonempty Sels, so CopyS never owns a select arm. Caller/control-flow source seals require review if this restriction changes."
    },
    "pasopt:topt.sizes": {
      "mode": "limited",
      "reason": "Cost estimate for PlainS-only copying. Inlinable checks PlainS before size; UnrollAt checks PlainS after size and before CopyS. An underestimated refused select cannot authorize copying."
    },
    "pasopt:topt.plains": {
      "mode": "limited",
      "reason": "Closed accepted-kind set excludes select; the nonempty-Sels check rejects malformed carrier combinations too. Returning false prevents copying or inlining."
    },
    "pasopt:topt.quiets": {
      "mode": "limited",
      "reason": "Select itself is effectful, even when default is empty. The proposed skSelect guard returns false before descent; no child can restore quietness."
    },
    "pasopt:topt.reachesout": {
      "mode": "limited",
      "reason": "Select itself is a scheduling boundary. The proposed skSelect guard returns true before descent; its children cannot make it less effectful."
    },
    "pasemit:temitter.shallows": {
      "mode": "limited",
      "reason": "Closed case whitelist excludes select and else returns false: select cannot enter the shallow-expression optimization."
    },
    "pasemit:temitter.leafs": {
      "mode": "limited",
      "reason": "Closed accepted-kind set excludes select and else returns false: select cannot become a no-call numeric kernel."
    },
    "pasemit:temitter.pureints": {
      "mode": "limited",
      "reason": "Closed case whitelist excludes select and else returns false: select is rejected by pure integer eligibility."
    },
    "pasemit:temitter.promostmtok": {
      "mode": "limited",
      "reason": "Result starts false for nonnil nodes; closed case labels exclude select, which is kept outside a promoted run."
    },
    "pasemit:temitter.promoscans": {
      "mode": "limited",
      "reason": "Select is handled as an island by RegionStmtOK/IsleOK; PromoScanS exits at IsleAt, while CollectNames and IsleOddS retain its uses/writes. Pure promoted runs are gated by PromoStmtOK. The whole PStmt inventory and body seals guard these paths."
    },
    "pasemit:temitter.regionstmtok": {
      "mode": "limited",
      "reason": "Select has no recursive region case: it falls through to a whole island, checked with IsleOK and scanned by CollectNames. Descending it as ordinary promoted statements would violate the island boundary."
    },
    "pasemit:temitter.isleodds": {
      "mode": "limited",
      "reason": "Select is deliberately outside the known ordinary-write whitelist, so the predicate returns true conservatively for its receive destination and body."
    },
    "pasemit:temitter.shascall": {
      "mode": "limited",
      "reason": "Select is deliberately outside the known no-call statement whitelist; it returns true conservatively because selection invokes the runtime."
    },
    "pasemit:temitter.endsforgood": {
      "mode": "limited",
      "reason": "Only raise/halt, terminal block position and both if arms prove termination. Other kinds including select return false conservatively; this affects arm weight only."
    }
