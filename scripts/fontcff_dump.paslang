  P513: prints what pasfontcff reads of a bare CFF file: the number of glyphs, whether it
  is CID-keyed, the name of each glyph (the CID and the glyph it selects for a
  CID-keyed font) and the glyph of each code of the font's own encoding.
  scripts/check_fontcff.py compares the lines with a reader of its own written
  in Python. }
program fontcff_dump;
uses sysutils, pasfontcff;
var
  s: string;
  f: TCffFont;
  g, c: Integer;
begin
  if not ReadFile(ParamStr(1), s) then
  begin
    WriteLn('cannot read');
    Halt(2);
  end;
  f := TCffFont.Create(s);
  if not f.Valid then
  begin
    WriteLn('invalid');
    Exit;
  end;
  if f.IsCID then
    WriteLn('glyphs ', f.NumGlyphs, ' cid True')
  else
    WriteLn('glyphs ', f.NumGlyphs, ' cid False');
  if f.IsCID then
  begin
    for g := 0 to f.NumGlyphs - 1 do
      WriteLn('c ', g, ' ', f.CidOfGlyph(g), ' ', f.GlyphOfCid(f.CidOfGlyph(g)));
  end
  else
  begin
    for g := 0 to f.NumGlyphs - 1 do
      WriteLn('n ', g, ' ', f.GlyphName(g));
    for c := 0 to 255 do
      if f.GlyphOfCode(c) > 0 then
        WriteLn('e ', c, ' ', f.GlyphOfCode(c));
  end;
end.
