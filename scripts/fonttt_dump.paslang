  P512: prints what pasfonttt reads of a font file: the number of glyphs, the cmap
  subtables, the Unicode of each glyph and its post name. scripts/check_fonttt.py
  runs it on every font of a directory and compares the lines with a reader of
  its own written in Python. }
program fonttt_dump;
uses sysutils, pasfonttt;
var
  s: string;
  f: TTrueType;
  i, g, u: Integer;
  n: string;
begin
  if not ReadFile(ParamStr(1), s) then
  begin
    WriteLn('cannot read');
    Halt(2);
  end;
  f := TTrueType.Create(s);
  if not f.Valid then
  begin
    WriteLn('invalid');
    Exit;
  end;
  WriteLn('glyphs ', f.NumGlyphs);
  for i := 0 to f.CmapCount - 1 do
    WriteLn('cmap ', f.CmapPlatform(i), ' ', f.CmapEncoding(i));
  for g := 1 to f.NumGlyphs - 1 do
  begin
    u := f.GlyphUnicode(g);
    if u >= 0 then
      WriteLn('u ', g, ' ', u);
  end;
  for g := 0 to f.NumGlyphs - 1 do
  begin
    n := f.GlyphName(g);
    if n <> '' then
      WriteLn('n ', g, ' ', n);
  end;
end.
