  P512: reads a font file, bends it a number of times (cut, bytes changed, bits
  flipped, a piece repeated, the table directory spoilt) and uses every part of
  TTrueType on each copy: whatever the bytes, it returns. Arguments: the file,
  the seed, the number of copies. }
program fonttt_fuzz;
uses sysutils, pasfonttt;
var
  GS: UInt64;
function Rnd(N: Integer): Integer;
begin
  GS := GS * 6364136223846793005 + 1442695040888963407;
  if N < 1 then
    N := 1;
  Result := Integer((GS shr 33) mod UInt64(N));
end;
var
  orig, mut: string;
  f: TTrueType;
  r, k, a, b, g, i, sum, valid: Integer;
  rounds: Integer;
begin
  GS := StrToInt(ParamStr(2));
  rounds := StrToInt(ParamStr(3));
  if not ReadFile(ParamStr(1), orig) then
    Halt(2);
  valid := 0;
  sum := 0;
  for r := 1 to rounds do
  begin
    mut := orig;
    case Rnd(5) of
      0: mut := Copy(orig, 1, Rnd(Length(orig) + 1));
      1:
        for k := 1 to 1 + Rnd(8) do
        begin
          a := Rnd(Length(mut)) + 1;
          mut[a] := Chr(Rnd(256));
        end;
      2:
        { the table directory and the heads of the tables }
        for k := 1 to 1 + Rnd(6) do
        begin
          a := 1 + Rnd(300);
          if a <= Length(mut) then
            mut[a] := Chr(Rnd(256));
        end;
      3:
        for k := 1 to 1 + Rnd(4) do
        begin
          a := Rnd(Length(mut)) + 1;
          mut[a] := Chr(Ord(mut[a]) xor (1 shl Rnd(8)));
        end;
      4:
        begin
          a := Rnd(Length(orig)) + 1;
          b := Rnd(Length(orig)) + 1;
          mut := Copy(orig, 1, a) + Copy(orig, b, 30 + Rnd(300)) + Copy(orig, a + 1, Length(orig));
        end;
    end;
    f := TTrueType.Create(mut);
    if f.Valid then
    begin
      valid := valid + 1;
      for i := 0 to f.CmapCount - 1 do
      begin
        sum := sum + f.CmapPlatform(i) + f.CmapEncoding(i);
        for k := 0 to 300 do
          sum := sum + f.CmapGlyph(i, Rnd(70000));
      end;
      for g := 0 to f.NumGlyphs - 1 do
      begin
        sum := sum + f.GlyphUnicode(g) + Length(f.GlyphName(g));
        if g > 3000 then
          Break;
      end;
      for k := 0 to 255 do
        sum := sum + f.GlyphOfCode(k);
    end;
  end;
  WriteLn('rounds ', rounds, ' valid ', valid, ' sum ', sum);
end.
