  P512: prints the codes the best Unicode subtable of a font maps to a glyph, as
  ranges, for scripts/check_fonttt.py to compare with the charset fontconfig
  (FreeType) reports for the same file. }
program fonttt_cov;
uses sysutils, pasfonttt;
var
  s, line: string;
  f: TTrueType;
  i, c, best, bestr, r, runstart, runend: Integer;
  inrun: Boolean;
function UniRank(p, e: Integer): Integer;
begin
  Result := -1;
  if (p = 3) and (e = 10) then Result := 0
  else if (p = 0) and (e = 4) then Result := 1
  else if (p = 0) and (e = 6) then Result := 2
  else if (p = 3) and (e = 1) then Result := 3
  else if (p = 0) and (e = 3) then Result := 4
  else if (p = 0) and (e <= 2) then Result := 5;
end;
begin
  if not ReadFile(ParamStr(1), s) then
    Halt(2);
  f := TTrueType.Create(s);
  if not f.Valid then
  begin
    WriteLn('invalid');
    Exit;
  end;
  best := -1;
  bestr := 99;
  for i := 0 to f.CmapCount - 1 do
  begin
    r := UniRank(f.CmapPlatform(i), f.CmapEncoding(i));
    if (r >= 0) and (r < bestr) then
    begin
      bestr := r;
      best := i;
    end;
  end;
  if best < 0 then
  begin
    WriteLn('none');
    Exit;
  end;
  line := '';
  inrun := False;
  for c := 0 to $10FFFF do
  begin
    if f.CmapGlyph(best, c) > 0 then
    begin
      if not inrun then
      begin
        inrun := True;
        runstart := c;
      end;
      runend := c;
    end
    else if inrun then
    begin
      inrun := False;
      if runstart = runend then
        line := line + IntToHex(runstart, 1) + ' '
      else
        line := line + IntToHex(runstart, 1) + '-' + IntToHex(runend, 1) + ' ';
    end;
  end;
  if inrun then
    line := line + IntToHex(runstart, 1) + '-' + IntToHex(runend, 1) + ' ';
  WriteLn(line);
end.
