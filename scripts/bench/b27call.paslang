{ P223: calls through a value, each section its own pair, 100 million
  each over an array of 64 entries whose kinds alternate, so no call can
  be resolved when compiling. iface calls a method through an interface
  (two classes against two Go types behind one interface); closure
  calls closures that captured a different number (against Go func
  values that captured one); proc calls plain routines through a
  routine value (against Go func values of plain functions). Each
  prints a sum. }
program b27call;

type
  IShape = interface
    function Area(K: Integer): Integer;
  end;
  TSquare = class(IShape)
    Side: Integer;
    function Area(K: Integer): Integer;
  end;
  TRect = class(IShape)
    W, H: Integer;
    function Area(K: Integer): Integer;
  end;
  TFn = function(K: Integer): Integer;

function TSquare.Area(K: Integer): Integer;
begin
  Result := Side * Side + K;
end;

function TRect.Area(K: Integer): Integer;
begin
  Result := W * H - K;
end;

function Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

function Thrice(K: Integer): Integer;
begin
  Result := K * 3;
end;

function Adder(N: Integer): TFn;
begin
  Result := function(K: Integer): Integer
  begin
    Result := K + N;
  end;
end;

var
  shapes: array[0..63] of IShape;
  fns: array[0..63] of TFn;
  sq: TSquare;
  re: TRect;
  i, t: Integer;

begin
  t := 0;
  if ParamStr(1) = 'iface' then
  begin
    for i := 0 to 63 do
      if i mod 2 = 0 then
      begin
        sq := TSquare.Create;
        sq.Side := i;
        shapes[i] := sq;
      end
      else
      begin
        re := TRect.Create;
        re.W := i;
        re.H := 3;
        shapes[i] := re;
      end;
    for i := 1 to 100000000 do
      t := t + shapes[i and 63].Area(i and 15);
  end
  else if ParamStr(1) = 'closure' then
  begin
    for i := 0 to 63 do
      fns[i] := Adder(i);
    for i := 1 to 100000000 do
      t := t + fns[i and 63](i and 15);
  end
  else if ParamStr(1) = 'proc' then
  begin
    for i := 0 to 63 do
      if i mod 2 = 0 then
        fns[i] := @Twice
      else
        fns[i] := @Thrice;
    for i := 1 to 100000000 do
      t := t + fns[i and 63](i and 15);
  end
  else
  begin
    WriteLn('b27call: iface, closure or proc');
    Halt(2);
  end;
  WriteLn(t);
end.
