{ P223: dates, each section its own pair, for moments a little over two
  hours apart from 2026-01-01. stamp writes two million of them as
  'YYYY-MM-DD hh:mm:ss' in UTC (StampStr against time.Unix().UTC() and
  Format); date gives the year, month and day of twenty million
  (UnixToDate against time.Unix().UTC().Date()). Each prints a sum. }
program b23date;

uses
  pastime;

var
  i, t: Integer;
  s: string;
  d: TDate;

begin
  t := 0;
  if ParamStr(1) = 'stamp' then
  begin
    for i := 1 to 2000000 do
    begin
      s := StampStr(1767225600 + Int64(i) * 7919);
      t := t + Ord(s[9]) + Ord(s[18]);
    end;
  end
  else if ParamStr(1) = 'date' then
  begin
    for i := 1 to 20000000 do
    begin
      d := UnixToDate(1767225600 + Int64(i) * 7919);
      t := t + d.Year + d.Month + d.Day;
    end;
  end
  else
  begin
    WriteLn('b23date: stamp or date');
    Halt(2);
  end;
  WriteLn(t);
end.
