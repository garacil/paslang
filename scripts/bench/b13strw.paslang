{ P223: the string words, each section its own pair, on the same text:
  64 KiB of lowercase letters and spaces from a linear congruence, in
  both twins. index finds a word near the end of it 20,000 times (Pos
  against strings.Index); upper and lower change 1 KiB of it 300,000
  times (UpperCase, LowerCase against strings.ToUpper, ToLower);
  replace changes every 'ab' of 1 KiB into 'xyz' 200,000 times
  (StringReplace against strings.ReplaceAll); trim takes the spaces off
  a 40-byte string five million times (Trim against strings.TrimSpace);
  compare and equalfold compare two 1 KiB strings that differ in the
  last byte two million times (CompareStr and SameText against
  strings.Compare and strings.EqualFold); concat builds a string of
  twenty million bytes one at a time (s := s + c against
  strings.Builder's WriteByte). }
program b13strw;

uses
  sysutils;

var
  text: string;

procedure MakeText;
var
  i, x: Integer;
begin
  SetLength(text, 65536);
  x := 12345;
  for i := 1 to 65536 do
  begin
    x := (x * 1103515245 + 12345) and $7FFFFFFF;
    if (x shr 16) mod 7 = 0 then
      text[i] := ' '
    else
      text[i] := Char(97 + (x shr 16) mod 26);
  end;
end;

procedure IndexS;
var
  i, t: Integer;
  w: string;
begin
  w := Copy(text, 65000, 12);
  t := 0;
  for i := 1 to 20000 do
    t := t + Pos(w, text);
  WriteLn(t);
end;

procedure UpperS;
var
  i, t: Integer;
  s, u: string;
begin
  s := Copy(text, 1, 1024);
  t := 0;
  for i := 1 to 300000 do
  begin
    u := UpperCase(s);
    t := t + Ord(u[1 + i mod 1024]);
  end;
  WriteLn(t);
end;

procedure LowerS;
var
  i, t: Integer;
  s, u: string;
begin
  s := UpperCase(Copy(text, 1, 1024));
  t := 0;
  for i := 1 to 300000 do
  begin
    u := LowerCase(s);
    t := t + Ord(u[1 + i mod 1024]);
  end;
  WriteLn(t);
end;

procedure ReplaceS;
var
  i, t: Integer;
  s, u: string;
begin
  s := Copy(text, 1, 1024);
  t := 0;
  for i := 1 to 200000 do
  begin
    u := StringReplace(s, 'ab', 'xyz', [rfReplaceAll]);
    t := t + Length(u);
  end;
  WriteLn(t);
end;

procedure TrimS;
var
  i, t: Integer;
  s, u: string;
begin
  s := '      ' + Copy(text, 100, 28) + '      ';
  t := 0;
  for i := 1 to 5000000 do
  begin
    u := Trim(s);
    t := t + Length(u);
  end;
  WriteLn(t);
end;

procedure CompareS;
var
  i, t, c: Integer;
  a, b: string;
begin
  a := Copy(text, 1, 1024);
  b := Copy(text, 1, 1023) + '~';
  t := 0;
  for i := 1 to 2000000 do
  begin
    c := CompareStr(a, b);
    if c < 0 then
      t := t - 1
    else if c > 0 then
      t := t + 1;
  end;
  WriteLn(t);
end;

procedure EqualFoldS;
var
  i, t: Integer;
  a, b: string;
begin
  a := Copy(text, 1, 1024);
  b := UpperCase(Copy(text, 1, 1023)) + '~';
  t := 0;
  for i := 1 to 2000000 do
    if SameText(a, b) then
      t := t + 1
    else
      t := t + 2;
  WriteLn(t);
end;

procedure Append1;
var
  i: Integer;
  s: string;
begin
  s := '';
  for i := 1 to 20000000 do
    s := s + text[1 + i mod 65536];
  WriteLn(Length(s), ' ', Ord(s[12345]));
end;

begin
  MakeText;
  if ParamStr(1) = 'index' then
    IndexS
  else if ParamStr(1) = 'upper' then
    UpperS
  else if ParamStr(1) = 'lower' then
    LowerS
  else if ParamStr(1) = 'replace' then
    ReplaceS
  else if ParamStr(1) = 'trim' then
    TrimS
  else if ParamStr(1) = 'compare' then
    CompareS
  else if ParamStr(1) = 'equalfold' then
    EqualFoldS
  else if ParamStr(1) = 'concat' then
    Append1
  else
  begin
    WriteLn('b13strw: index, upper, lower, replace, trim, compare, equalfold or concat');
    Halt(2);
  end;
end.
