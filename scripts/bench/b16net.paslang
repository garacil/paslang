{ P223: a stream between two routines, each section its own pair. tcp
  sends 1 GiB over the loopback in 64 KiB writes from one routine to
  another (TcpWrite and TcpRead against net.Conn's Write and Read);
  unix the same over a pair of connected Unix sockets (UnixPair
  against syscall.Socketpair and net.FileConn). Each prints the bytes
  read and the last byte. }
program b16net;

uses
  pasnet;

const
  Total = 1073741824;
  Block = 65536;

var
  blk: string;

procedure Writer(Fd: Integer);
var
  sent: Integer;
begin
  sent := 0;
  while sent < Total do
    sent := sent + TcpWrite(Fd, blk);
  TcpClose(Fd);
end;

procedure Drain(Fd: Integer);
var
  n, last: Integer;
  s: string;
begin
  n := 0;
  last := 0;
  repeat
    s := TcpRead(Fd, Block);
    n := n + Length(s);
    if s <> '' then
      last := Ord(s[Length(s)]);
  until s = '';
  WriteLn(n, ' ', last);
end;

procedure Tcp;
var
  l, a, c: Integer;
begin
  l := TcpListen(0);
  c := TcpConnect('127.0.0.1', TcpPort(l));
  a := TcpAccept(l);
  pas Writer(c);
  Drain(a);
end;

procedure Unix;
var
  a, b: Integer;
begin
  if not UnixPair(a, b) then
    Halt(1);
  pas Writer(a);
  Drain(b);
end;

var
  i: Integer;

begin
  SetLength(blk, Block);
  for i := 1 to Block do
    blk[i] := Char(i * 7 and 255);
  if ParamStr(1) = 'tcp' then
    Tcp
  else if ParamStr(1) = 'unix' then
    Unix
  else
  begin
    WriteLn('b16net: tcp or unix');
    Halt(2);
  end;
end.
