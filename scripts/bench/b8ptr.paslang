program b8ptr;

{ P104's bench pair: pointer work. 32 MiB written byte by byte through a
  PByte walk and summed through a PDWord view, four times; then a list of
  a million records linked by pointers, walked twenty times. Go's twin is
  b8ptr.go (a slice for the block, the same list). make bench also runs
  this one built with -checkptr: what the check costs. }

type
  PNode = ^TNode;
  TNode = record
    Val: Integer;
    Next: PNode;
  end;

var
  base, p: PByte;
  q: PDWord;
  i, r, n, sum: Integer;
  head, nd: PNode;

begin
  n := 32 * 1024 * 1024;
  GetMem(base, n, 0);
  sum := 0;
  for r := 1 to 4 do
  begin
    p := base;
    for i := 0 to n - 1 do
    begin
      p^ := Byte(i + r);
      Inc(p);
    end;
    q := PDWord(base);
    for i := 0 to n div 4 - 1 do
    begin
      sum := sum + q^;
      Inc(q);
    end;
  end;
  head := nil;
  for i := 1 to 1000000 do
  begin
    New(nd);
    nd^.Val := i;
    nd^.Next := head;
    head := nd;
  end;
  for r := 1 to 20 do
  begin
    nd := head;
    while nd <> nil do
    begin
      sum := sum + nd^.Val;
      nd := nd^.Next;
    end;
  end;
  WriteLn(sum);
end.
