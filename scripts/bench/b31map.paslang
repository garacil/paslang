{ P223: more of the map, each section its own pair, on a million
  Integer keys i * 7919. iter walks it twenty times (for k, v in m
  against for k, v := range); delete puts the keys in and takes them
  all out (Delete against delete); update adds one to every value ten
  times (m[k] := m[k] + 1 against m[k]++). Each prints a sum and the
  length left. b5map puts and gets, b6smap with string keys. }
program b31map;

var
  m: map[Integer] of Integer;
  i, r, t, k, v: Integer;

begin
  New(m);
  for i := 1 to 1000000 do
    m[i * 7919] := i;
  t := 0;
  if ParamStr(1) = 'iter' then
  begin
    for r := 1 to 20 do
      for k, v in m do
        t := t + (k xor v);
  end
  else if ParamStr(1) = 'delete' then
  begin
    for i := 1 to 1000000 do
      Delete(m, i * 7919);
    t := 1;
  end
  else if ParamStr(1) = 'update' then
  begin
    for r := 1 to 10 do
      for i := 1 to 1000000 do
        m[i * 7919] := m[i * 7919] + 1;
    t := m[7919] + m[7919 * 1000000];
  end
  else
  begin
    WriteLn('b31map: iter, delete or update');
    Halt(2);
  end;
  WriteLn(t, ' ', Length(m));
end.
