{ P223: sorting, each section its own pair, the values from one 64-bit
  linear congruence in both twins. ints sorts two million Int64
  (SortInts against slices.Sort), strings half a million strings 'k'
  and a number (SortStrings against slices.Sort), reals two million
  reals in [0, 1) (SortReals against slices.Sort). Each prints the
  first, middle and last values. }
program b14sort;

uses
  sysutils, passort;

var
  x: Int64;

function Next: Int64;
begin
  x := x * 6364136223846793005 + 1442695040888963407;
  Result := x;
end;

procedure Ints;
var
  a: array of Int64;
  i, n: Integer;
begin
  n := 2000000;
  SetLength(a, n);
  for i := 0 to n - 1 do
    a[i] := Next shr 11;
  SortInts(a);
  WriteLn(a[0], ' ', a[n div 2], ' ', a[n - 1]);
end;

procedure Strs;
var
  a: array of string;
  i, n: Integer;
begin
  n := 500000;
  SetLength(a, n);
  for i := 0 to n - 1 do
    a[i] := 'k' + IntToStr(Next shr 40);
  SortStrings(a);
  WriteLn(a[0], ' ', a[n div 2], ' ', a[n - 1]);
end;

procedure Reals;
var
  a: array of Real;
  i, n: Integer;
begin
  n := 2000000;
  SetLength(a, n);
  for i := 0 to n - 1 do
    a[i] := (Next shr 11) / 9007199254740992.0;
  SortReals(a);
  WriteLn(Trunc(a[0] * 1e15), ' ', Trunc(a[n div 2] * 1e15), ' ', Trunc(a[n - 1] * 1e15));
end;

begin
  x := 12345;
  if ParamStr(1) = 'ints' then
    Ints
  else if ParamStr(1) = 'strings' then
    Strs
  else if ParamStr(1) = 'reals' then
    Reals
  else
  begin
    WriteLn('b14sort: ints, strings or reals');
    Halt(2);
  end;
end.
