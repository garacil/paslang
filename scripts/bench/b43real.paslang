{ P486: real arithmetic, the paslang side of scripts/bench/b43real.go: the
  Mandelbrot set on a grid of 500 by 500 points, each point iterated up to 200
  times with Doubles (z := z * z + c in real and imaginary parts); the
  iterations are summed. }
program b43real;

function Iter(cr, ci: Double): Integer;
var
  zr, zi, t: Double;
  n: Integer;
begin
  zr := 0.0;
  zi := 0.0;
  n := 0;
  while (n < 200) and (zr * zr + zi * zi < 4.0) do
  begin
    t := zr * zr - zi * zi + cr;
    zi := 2.0 * zr * zi + ci;
    zr := t;
    n := n + 1;
  end;
  Result := n;
end;

var
  x, y, total: Integer;
begin
  total := 0;
  for y := 0 to 499 do
    for x := 0 to 499 do
      total := total + Iter(x / 250.0 - 1.5, y / 250.0 - 1.0);
  WriteLn(total);
end.
