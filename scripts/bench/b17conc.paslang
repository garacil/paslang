{ P223: channels and time, each section its own pair. sleep: 20,000
  routines sleep 1 ms ten times (Sleep against time.Sleep). timeout:
  20,000 routines wait five times for a message that never comes or a
  millisecond, whichever is first (a select with a routine that sleeps
  and sends, paslang's way, against a select with time.After). pipe:
  ten million integers through a channel of 128 from one routine to
  another. fanin: four routines send 2.5 million integers each on a
  channel of 64 of their own and one routine takes them all with a
  select over the four. Each prints what it counted. }
program b17conc;

var
  wg: waitgroup;
  count: Integer;

procedure Sleeper;
var
  k: Integer;
begin
  for k := 1 to 10 do
    Sleep(1);
  AtomicAdd(@count, 1);
  wg.Done;
end;

procedure Ring(C: chan of Integer);
begin
  Sleep(1);
  Send(C, 1);
end;

procedure Waiter;
var
  never, alarm: chan of Integer;
  k, x: Integer;
begin
  never := MakeChan();
  for k := 1 to 5 do
  begin
    alarm := MakeChan(1);
    pas Ring(alarm);
    select
      Recv(never, x): AtomicAdd(@count, 100);
      Recv(alarm, x): AtomicAdd(@count, x);
    end;
  end;
  wg.Done;
end;

procedure Producer(C: chan of Integer; N: Integer);
var
  i: Integer;
begin
  for i := 1 to N do
    Send(C, i);
end;

procedure Pipe;
var
  c: chan of Integer;
  i, t: Integer;
begin
  c := MakeChan(128);
  pas Producer(c, 10000000);
  t := 0;
  for i := 1 to 10000000 do
    t := t + Recv(c);
  WriteLn(t);
end;

procedure FanIn;
var
  a, b, c, d: chan of Integer;
  i, t, x: Integer;
begin
  a := MakeChan(64);
  b := MakeChan(64);
  c := MakeChan(64);
  d := MakeChan(64);
  pas Producer(a, 2500000);
  pas Producer(b, 2500000);
  pas Producer(c, 2500000);
  pas Producer(d, 2500000);
  t := 0;
  for i := 1 to 10000000 do
    select
      Recv(a, x): t := t + x;
      Recv(b, x): t := t + x;
      Recv(c, x): t := t + x;
      Recv(d, x): t := t + x;
    end;
  WriteLn(t);
end;

var
  i: Integer;

begin
  count := 0;
  if ParamStr(1) = 'sleep' then
  begin
    wg.Add(20000);
    for i := 1 to 20000 do
      pas Sleeper;
    wg.Wait;
    WriteLn(count);
  end
  else if ParamStr(1) = 'timeout' then
  begin
    wg.Add(20000);
    for i := 1 to 20000 do
      pas Waiter;
    wg.Wait;
    WriteLn(count);
  end
  else if ParamStr(1) = 'pipe' then
    Pipe
  else if ParamStr(1) = 'fanin' then
    FanIn
  else
  begin
    WriteLn('b17conc: sleep, timeout, pipe or fanin');
    Halt(2);
  end;
end.
