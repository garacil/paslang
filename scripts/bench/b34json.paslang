{ P203: JSON, the twin of b34json.go. The seven files of Go's corpus
  (testdata/json/corpus, decompressed by run.py into build/bench/json),
  each section over all of them, ten times: parse reads each into a
  document (Go's encoding/json/v2 into any, parse1 its v1) and walks
  it, counting the values; compact, pretty and their v1 twins write the
  parsed document on one line and a value a line (Go marshals its any);
  canonical writes each text in RFC 8785's form (Go's
  jsontext.Value.Canonicalize). Each prints what it counted: the values,
  the documents written, the canonical bytes. }
program b34json;

uses sysutils;

const
  Files: array[0..6] of string = ('canada_geometry', 'citm_catalog', 'golang_source',
    'string_escaped', 'string_unicode', 'synthea_fhir', 'twitter_status');
  Rounds = 10;

var
  texts: array[0..6] of string;
  docs: array[0..6] of json;
  part, t: string;
  i, r, total: Integer;

{ The values of a document, a container's children included, walked with
  an explicit stack as Go's side walks its any. }
function Count(J: json): Integer;
var
  stack: array of json;
  n: Integer;
  v, w: json;
begin
  Result := 0;
  SetLength(stack, 64);
  stack[0] := J;
  n := 1;
  while n > 0 do
  begin
    n := n - 1;
    v := stack[n];
    Result := Result + 1;
    if (v.Kind = jkArray) or (v.Kind = jkObject) then
      for w in v do
      begin
        if n >= Length(stack) then
          SetLength(stack, Length(stack) * 2);
        stack[n] := w;
        n := n + 1;
      end;
  end;
end;

{ A file's bytes as a string, read whole at its size. }
function Load(const Path: string): string;
var
  h: THandle;
  n: Integer;
  buf: TBytes;
begin
  Result := '';
  h := FileOpen(Path, fmOpenRead);
  if h < 0 then
  begin
    WriteLn('no ', Path, ': run.py writes it');
    Halt(1);
  end;
  n := FileSeek(h, 0, 2);
  FileSeek(h, 0, 0);
  SetLength(buf, n);
  if FileRead(h, buf, n) <> n then
    Halt(1);
  FileClose(h);
  SetLength(Result, n);
  Move(buf[0], Result[1], n);
end;

begin
  part := ParamStr(1);
  for i := 0 to 6 do
    texts[i] := Load('build/bench/json/' + Files[i] + '.json');
  total := 0;
  if (part = 'parse') or (part = 'parse1') then
  begin
    for r := 1 to Rounds do
      for i := 0 to 6 do
        total := total + Count(JsonParse(texts[i]));
  end
  else if (part = 'canonical') then
  begin
    for r := 1 to Rounds do
      for i := 0 to 6 do
        total := total + Length(JsonEncode(JsonParse(texts[i]), JsonCanonical));
  end
  else
  begin
    for i := 0 to 6 do
      docs[i] := JsonParse(texts[i]);
    for r := 1 to Rounds do
      for i := 0 to 6 do
      begin
        if (part = 'compact') or (part = 'compact1') then
          t := JsonEncode(docs[i])
        else
          t := JsonEncode(docs[i], JsonPretty);
        if Length(t) > 0 then
          total := total + 1;
      end;
  end;
  WriteLn(total);
end.
