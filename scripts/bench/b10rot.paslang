{ P108: xoshiro256** (Blackman and Vigna), 100 million numbers summed:
  two rotations, shifts and xors a step, the work of every modern
  generator and hash mixer. Go: math/bits.RotateLeft64. }
program b10rot;

var
  s0, s1, s2, s3, t, r, sum: Integer;
  i: Integer;

begin
  s0 := 1;
  s1 := 2;
  s2 := 3;
  s3 := 4;
  sum := 0;
  for i := 1 to 100000000 do
  begin
    r := ((s1 * 5) rol 7) * 9;
    t := s1 shl 17;
    s2 := s2 xor s0;
    s3 := s3 xor s1;
    s1 := s1 xor s2;
    s0 := s0 xor s3;
    s2 := s2 xor t;
    s3 := s3 rol 45;
    sum := sum + r;
  end;
  WriteLn(sum, ' ', s0);
end.
