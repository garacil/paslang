program b3spawn;

var
  wg: waitgroup;
  mu: mutex;
  n, i: Integer;

procedure Work;
begin
  lock mu do
    n := n + 1;
  wg.Done;
end;

begin
  n := 0;
  wg.Add(100000);
  for i := 1 to 100000 do
    pas Work;
  wg.Wait;
  WriteLn(n);
end.
