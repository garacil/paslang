{ P223: numbers as text, each section its own pair. itoa writes ten
  million integers (IntToStr against strconv.Itoa); ftoa three million
  reals as their shortest digits (FloatToStr against strconv.FormatFloat
  'f', -1, both plain between 1e-3 and 1e15); fmt two million lines of
  Format('%d:%s:%.3f') against fmt.Sprintf; atoi reads a million
  integers twenty times (StrToInt against strconv.Atoi); atof a million
  reals twice (StrToFloat against strconv.ParseFloat). Each prints
  the total length and the bytes of one text in a thousand. }
program b12num;

uses
  sysutils;

const
  N = 1000000;

var
  strs: array of string;

procedure Itoa;
var
  i, total, sum, j: Integer;
  s: string;
begin
  total := 0;
  sum := 0;
  for i := 1 to 10000000 do
  begin
    s := IntToStr(i * 7919 - 40000000000);
    total := total + Length(s);
    if i mod 1000 = 0 then
      for j := 1 to Length(s) do
        sum := sum + Ord(s[j]);
  end;
  WriteLn(total, ' ', sum);
end;

procedure Ftoa;
var
  i, total, sum, j: Integer;
  s: string;
begin
  total := 0;
  sum := 0;
  for i := 1 to 3000000 do
  begin
    s := FloatToStr(i / 7);
    total := total + Length(s);
    if i mod 1000 = 0 then
      for j := 1 to Length(s) do
        sum := sum + Ord(s[j]);
  end;
  WriteLn(total, ' ', sum);
end;

procedure Fmt;
var
  i, total, sum, j: Integer;
  s: string;
begin
  total := 0;
  sum := 0;
  for i := 1 to 2000000 do
  begin
    s := Format('%d:%s:%.3f', [i, 'ab', i / 7]);
    total := total + Length(s);
    if i mod 1000 = 0 then
      for j := 1 to Length(s) do
        sum := sum + Ord(s[j]);
  end;
  WriteLn(total, ' ', sum);
end;

procedure Atoi;
var
  k, r, t: Integer;
begin
  SetLength(strs, N);
  for k := 0 to N - 1 do
    strs[k] := IntToStr(k * 7919 - 40000000000);
  t := 0;
  for r := 1 to 20 do
    for k := 0 to N - 1 do
      t := t + StrToInt(strs[k]);
  WriteLn(t);
end;

procedure Atof;
var
  k, r: Integer;
  t: Double;
begin
  SetLength(strs, N);
  for k := 0 to N - 1 do
    strs[k] := FloatToStr(k / 7);
  t := 0;
  for r := 1 to 2 do
    for k := 0 to N - 1 do
      t := t + StrToFloat(strs[k]);
  WriteLn(Trunc(t));
end;

begin
  if ParamStr(1) = 'itoa' then
    Itoa
  else if ParamStr(1) = 'ftoa' then
    Ftoa
  else if ParamStr(1) = 'fmt' then
    Fmt
  else if ParamStr(1) = 'atoi' then
    Atoi
  else if ParamStr(1) = 'atof' then
    Atof
  else
  begin
    WriteLn('b12num: itoa, ftoa, fmt, atoi or atof');
    Halt(2);
  end;
end.
