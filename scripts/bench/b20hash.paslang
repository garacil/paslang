{ P223: the hashes Go has too, each section its own pair, over the same
  1 MiB buffer, its first byte changed each round so nothing is kept:
  md5 and sha512 128 times, sha1 256 times (Md5, Sha512, Sha1 against
  crypto/md5, sha512, sha1), sha3 64 times (Sha3_256 against
  crypto/sha3), hmac 256 times (HmacSha256 against crypto/hmac with
  sha256), crc32 2048 times, its second byte changed too (Crc32, IEEE,
  against hash/crc32.ChecksumIEEE), adler32 512 times (Adler32 against
  hash/adler32), fnv 256 times (Fnv1a64 against
  hash/fnv's New64a). Each prints the last digest in hex or the
  checksums' xor. b9hash has SHA-256 and CRC-32C. }
program b20hash;

var
  s, d: string;
  i, acc: Integer;

procedure Fill;
var
  k: Integer;
begin
  SetLength(s, 1048576);
  for k := 1 to Length(s) do
    s[k] := Char((k * 31) and 255);
end;

begin
  Fill;
  acc := 0;
  d := '';
  if ParamStr(1) = 'md5' then
    for i := 1 to 128 do
    begin
      s[1] := Char(i);
      d := Md5(s);
    end
  else if ParamStr(1) = 'sha1' then
    for i := 1 to 256 do
    begin
      s[1] := Char(i);
      d := Sha1(s);
    end
  else if ParamStr(1) = 'sha512' then
    for i := 1 to 128 do
    begin
      s[1] := Char(i);
      d := Sha512(s);
    end
  else if ParamStr(1) = 'sha3' then
    for i := 1 to 64 do
    begin
      s[1] := Char(i);
      d := Sha3_256(s);
    end
  else if ParamStr(1) = 'hmac' then
    for i := 1 to 256 do
    begin
      s[1] := Char(i);
      d := HmacSha256('key of the bench', s);
    end
  else if ParamStr(1) = 'crc32' then
    for i := 1 to 2048 do
    begin
      s[1] := Char(i and 255);
      s[2] := Char(i shr 8);
      acc := acc xor Crc32(s);
    end
  else if ParamStr(1) = 'adler32' then
    for i := 1 to 512 do
    begin
      s[1] := Char(i and 255);
      acc := acc xor Adler32(s);
    end
  else if ParamStr(1) = 'fnv' then
    for i := 1 to 256 do
    begin
      s[1] := Char(i);
      acc := acc xor Fnv1a64(s);
    end
  else
  begin
    WriteLn('b20hash: md5, sha1, sha512, sha3, hmac, crc32, adler32 or fnv');
    Halt(2);
  end;
  if d <> '' then
    WriteLn(Hex(d))
  else
    WriteLn(acc);
end.
