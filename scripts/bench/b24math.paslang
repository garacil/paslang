{ P223: the real functions, each section its own pair, ten million
  calls on arguments from i / 997: sin (Sin against math.Sin), exp
  (Exp of an argument in [-1, 1) against math.Exp), ln (Ln against
  math.Log), sqrt (Sqrt against math.Sqrt), pow (Power(x, 1.37) of x
  in (0, 1] against math.Pow), atan (ArcTan against math.Atan). Each
  prints the sum in thousandths, its arguments kept small enough that
  the sum's rounding stays far below a thousandth: a value one ulp
  apart on the two sides must not change what is printed. }
program b24math;

var
  i: Integer;
  x, t: Double;

begin
  t := 0;
  if ParamStr(1) = 'sin' then
    for i := 1 to 10000000 do
      t := t + Sin(i / 997)
  else if ParamStr(1) = 'exp' then
    for i := 1 to 10000000 do
    begin
      x := (i mod 2000) / 1000 - 1;
      t := t + Exp(x);
    end
  else if ParamStr(1) = 'ln' then
    for i := 1 to 10000000 do
      t := t + Ln(i / 997)
  else if ParamStr(1) = 'sqrt' then
    for i := 1 to 10000000 do
      t := t + Sqrt(i / 997)
  else if ParamStr(1) = 'pow' then
    for i := 1 to 10000000 do
      t := t + Power((i mod 997 + 1) / 997, 1.37)
  else if ParamStr(1) = 'atan' then
    for i := 1 to 10000000 do
      t := t + ArcTan(i / 997)
  else
  begin
    WriteLn('b24math: sin, exp, ln, sqrt, pow or atan');
    Halt(2);
  end;
  WriteLn(Trunc(t * 1000));
end.
