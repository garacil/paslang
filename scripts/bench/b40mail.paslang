{ P433: mail, the paslang side of scripts/bench/b40mail.go: the same four
  sections (the argument names one). message reads 200 multipart messages (a
  quoted-printable text, a base64 file) 100 times each into a tree of parts
  with their bodies decoded; addr parses address lists; build makes messages
  with TMailBuilder; words encodes and decodes header words. }
program b40mail;

uses
  sysutils, pascodec, pastextproto, pasmime;

function Message(I: Integer): string;
var
  b, enc: string;
  k, j: Integer;
  raw: string;
  bnd: string;
begin
  bnd := 'BND' + IntToStr(I);
  b := 'From: Ana <ana@example.com>' + #13#10 + 'To: b@example.org' + #13#10 + 'Subject: Message ' + IntToStr(I) + #13#10;
  b := b + 'MIME-Version: 1.0' + #13#10 + 'Content-Type: multipart/mixed; boundary="' + bnd + '"' + #13#10 + #13#10;
  b := b + '--' + bnd + #13#10 + 'Content-Type: text/plain; charset=utf-8' + #13#10 + 'Content-Transfer-Encoding: quoted-printable' + #13#10 + #13#10;
  for k := 0 to 19 do
    b := b + 'line ' + IntToStr(k) + ' of message ' + IntToStr(I) + ' with =C3=A9 accents and a soft break =' + #13#10 + 'that goes on' + #13#10;
  b := b + #13#10 + '--' + bnd + #13#10 + 'Content-Type: application/octet-stream; name="f.bin"' + #13#10 + 'Content-Transfer-Encoding: base64' + #13#10;
  b := b + 'Content-Disposition: attachment; filename="f.bin"' + #13#10 + #13#10;
  SetLength(raw, 3000 + I * 7);
  for j := 0 to Length(raw) - 1 do
    raw[j + 1] := Chr((I * 7 + j * 13) and 255);
  enc := Base64Encode(raw, False, True);
  while Length(enc) > 76 do
  begin
    b := b + Copy(enc, 1, 76) + #13#10;
    enc := Copy(enc, 77, Length(enc) - 76);
  end;
  Result := b + enc + #13#10 + '--' + bnd + '--' + #13#10;
end;

var
  Parts, Bytes: Integer;

procedure Walk(E: TMailEntity);
var
  i: Integer;
begin
  if E.IsMultipart then
  begin
    for i := 0 to E.KidCount - 1 do
      Walk(E.Kid(i));
    Exit;
  end;
  Parts := Parts + 1;
  Bytes := Bytes + Length(E.Body);
end;

procedure SecMessage;
var
  msgs: array of string;
  i, rep: Integer;
  e: TMailEntity;
  err: string;
begin
  SetLength(msgs, 200);
  for i := 0 to 199 do
    msgs[i] := Message(i);
  Parts := 0;
  Bytes := 0;
  for rep := 1 to 100 do
    for i := 0 to 199 do
      if MailParseEntity(msgs[i], e, err) then
        Walk(e);
  WriteLn(Parts, ' ', Bytes);
end;

procedure SecAddr;
var
  lists: array of string;
  rep, i, j, n, bytesN: Integer;
  l: TMailAddressArray;
  err: string;
begin
  SetLength(lists, 8);
  lists[0] := 'Ana <ana@example.com>, bea@example.org';
  lists[1] := '"Garc' + #195 + #173 + 'a, Jos' + #195 + #169 + '" <jose@example.com>, =?UTF-8?Q?Mar=C3=ADa?= <maria@example.org>';
  lists[2] := 'group: a@b.c, d@e.f;, Carlos <carlos@example.net>';
  lists[3] := 'first.last@sub.example.co.uk';
  lists[4] := 'Name (comment) <addr@example.com>, other@example.org (Other)';
  lists[5] := '"quoted \"name\"" <q@example.com>';
  lists[6] := 'x@[192.168.1.1], y@example.com';
  lists[7] := 'Ana <ana@example.com>, Bea <bea@example.org>, Carlos <carlos@example.net>, Diana <diana@example.edu>, Eva <eva@example.io>';
  n := 0;
  bytesN := 0;
  for rep := 1 to 20000 do
    for i := 0 to 7 do
      if MailParseAddressList(lists[i], False, l, err) then
        for j := 0 to Length(l) - 1 do
        begin
          n := n + 1;
          bytesN := bytesN + Length(l[j].Name) + Length(l[j].Address);
        end;
  WriteLn(n, ' ', bytesN);
end;

procedure SecBuild;
var
  rep, j, total: Integer;
  b: TMailBuilder;
  raw, m, txt: string;
  k: Integer;
begin
  total := 0;
  txt := '';
  for k := 1 to 20 do
    txt := txt + 'Se' + #195 + #177 + 'or Garc' + #195 + #173 + 'a: texto con acentos ' + #195 + #161 + #195 + #169 + #195 + #173 + #195 + #179 + #195 + #186 + '.' + #13#10;
  SetLength(raw, 3000);
  for rep := 0 to 1999 do
  begin
    for j := 0 to 2999 do
      raw[j + 1] := Chr((rep + j * 13) and 255);
    b := TMailBuilder.Create;
    b.Sender.Name := 'Ana P' + #195 + #169 + 'rez';
    b.Sender.Address := 'ana@example.com';
    b.AddTo('Bea', 'bea@example.org');
    b.Subject := 'Informe n' + #195 + #186 + 'mero ' + IntToStr(rep);
    b.TextBody := txt;
    b.Attach('f.bin', 'application/octet-stream', raw);
    b.Boundary := 'BOUNDARY';
    b.MessageId := 'x@y';
    m := b.Build;
    if Length(m) > 0 then
      total := total + 1;
  end;
  WriteLn(total);
end;

procedure SecWords;
var
  rep, n, total: Integer;
  w, s, err: string;
begin
  n := 0;
  total := 0;
  for rep := 0 to 49999 do
  begin
    w := MimeEncodeWord('utf-8', 'Se' + #195 + #177 + 'or Garc' + #195 + #173 + 'a ' + IntToStr(rep), False);
    if MimeDecodeHeader(w, False, s, err) then
    begin
      n := n + 1;
      total := total + Length(s);
    end;
  end;
  WriteLn(n, ' ', total);
end;

var
  section: string;
begin
  section := 'message';
  if ParamCount > 0 then
    section := ParamStr(1);
  if section = 'message' then
    SecMessage
  else if section = 'addr' then
    SecAddr
  else if section = 'build' then
    SecBuild
  else if section = 'words' then
    SecWords;
end.
