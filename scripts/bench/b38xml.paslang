{ P426: XML read token by token. tokens reads a worksheet of twenty
  thousand rows of eight cells (about 9 MB, made here: inline strings
  with an entity in them, numbers, empty cells) five times with
  TXmlReader.Next, against encoding/xml's Decoder.Token. Both count the
  start tags, the end tags, the bytes of text and the attributes and the
  bytes of their values, and print the four. }
program b38xml;

uses
  sysutils, pasxml;

function Sheet: string;
var
  r, c, k: Integer;
  b: string;
begin
  b := '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' + #10 +
    '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData>';
  Result := b;
  for r := 1 to 20000 do
  begin
    Result := Result + '<row r="' + IntToStr(r) + '" spans="1:8">';
    for c := 0 to 7 do
    begin
      k := r * 8 + c;
      if c mod 3 = 0 then
        Result := Result + '<c r="' + Chr(65 + c) + IntToStr(r) + '" t="inlineStr"><is><t>valor ' + IntToStr(k) +
          ' &amp; x</t></is></c>'
      else if c mod 3 = 1 then
        Result := Result + '<c r="' + Chr(65 + c) + IntToStr(r) + '" s="1"><v>' + IntToStr(k) + '.5</v></c>'
      else
        Result := Result + '<c r="' + Chr(65 + c) + IntToStr(r) + '"/>';
    end;
    Result := Result + '</row>';
  end;
  Result := Result + '</sheetData></worksheet>';
end;

var
  doc: string;
  rd: TXmlReader;
  tok: TXmlToken;
  rep, i: Integer;
  starts, ends, text, attrs, vals: Integer;

begin
  doc := Sheet;
  starts := 0;
  ends := 0;
  text := 0;
  attrs := 0;
  vals := 0;
  for rep := 1 to 5 do
  begin
    rd := TXmlReader.Create(doc);
    while rd.Next(tok) do
      case tok.Kind of
        xtStart:
          begin
            starts := starts + 1;
            for i := 0 to High(tok.Attrs) do
              if not tok.Attrs[i].IsNs then
              begin
                attrs := attrs + 1;
                vals := vals + Length(tok.Attrs[i].Value);
              end;
          end;
        xtEnd:
          ends := ends + 1;
        xtText:
          text := text + Length(tok.Value);
      end;
  end;
  WriteLn(starts, ' ', ends, ' ', text, ' ', attrs, ' ', vals);
end.
