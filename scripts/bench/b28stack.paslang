{ P223: stacks that grow, each section its own pair. deep recurses a
  million calls deep twenty times in one routine; many has 2000
  routines each recurse 20,000 deep, each stack growing from its start.
  Each prints a sum. }
program b28stack;

var
  wg: waitgroup;
  total: Integer;

function Down(N: Integer): Integer;
begin
  if N = 0 then
    Result := 0
  else
    Result := Down(N - 1) + (N and 3);
end;

procedure Grower;
begin
  AtomicAdd(@total, Down(20000));
  wg.Done;
end;

var
  i: Integer;

begin
  total := 0;
  if ParamStr(1) = 'deep' then
    for i := 1 to 20 do
      total := total + Down(1000000)
  else if ParamStr(1) = 'many' then
  begin
    wg.Add(2000);
    for i := 1 to 2000 do
      pas Grower;
    wg.Wait;
  end
  else
  begin
    WriteLn('b28stack: deep or many');
    Halt(2);
  end;
  WriteLn(total);
end.
