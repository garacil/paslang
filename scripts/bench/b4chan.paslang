program b4chan;

var
  a, b: chan of Integer;
  i, x: Integer;

procedure Pong;
var
  n: Integer;
begin
  repeat
    n := Recv(a);
    if n >= 0 then
      Send(b, n + 1);
  until n < 0;
end;

begin
  a := MakeChan();
  b := MakeChan();
  pas Pong;
  x := 0;
  for i := 1 to 1000000 do
  begin
    Send(a, x);
    x := Recv(b);
  end;
  Send(a, -1);
  WriteLn(x);
end.
