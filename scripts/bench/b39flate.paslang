{ P427: DEFLATE against compress/flate, the twin of b39flate.go. The text
  is a worksheet of 30000 rows of eight cells (about 8 MB, made here the
  same on both sides). deflate: the text compressed at level 6 four times,
  then read back once; inflate: compressed once at level 1 and read back
  twenty times. Each prints the length of the text and a sum of its bytes
  as read back, not the compressed size (the two compressors make
  different bytes). }
program b39flate;

uses
  sysutils, pasflate;

function Sheet: string;
var
  r, c, k: Integer;
  b: string;
begin
  Result := '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' + #10 +
    '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData>';
  for r := 1 to 30000 do
  begin
    b := '<row r="' + IntToStr(r) + '" spans="1:8">';
    for c := 0 to 7 do
    begin
      k := r * 8 + c;
      case c mod 3 of
        0:
          b := b + '<c r="' + Chr(65 + c) + IntToStr(r) + '" t="inlineStr"><is><t>item ' + IntToStr(k mod 977) +
            ' &amp; co</t></is></c>';
        1:
          b := b + '<c r="' + Chr(65 + c) + IntToStr(r) + '" s="2"><v>' + IntToStr(k * 7 mod 100003) + '.' +
            IntToStr(k mod 100) + '</v></c>';
      else
        b := b + '<c r="' + Chr(65 + c) + IntToStr(r) + '"/>';
      end;
    end;
    Result := Result + b + '</row>';
  end;
  Result := Result + '</sheetData></worksheet>';
end;

function Sum(const S: string): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to Length(S) do
    Result := (Result * 31 + Ord(S[i])) and $FFFFFFFF;
end;

var
  text, comp, back, section: string;
  i, total, used: Integer;
begin
  section := ParamStr(1);
  text := Sheet;
  if section = 'build' then
    WriteLn(Length(text))
  else if section = 'deflate' then
  begin
    for i := 1 to 4 do
      comp := FlateDeflate(text, 6);
    back := FlateInflate(comp, 1, used);
    WriteLn(Length(text), ' ', Sum(back));
  end
  else
  begin
    comp := FlateDeflate(text, 1);
    total := 0;
    for i := 1 to 20 do
    begin
      back := FlateInflate(comp, 1, used);
      total := total + Length(back);
    end;
    WriteLn(Length(text), ' ', Sum(back), ' ', total);
  end;
end.
