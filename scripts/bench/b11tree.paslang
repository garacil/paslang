{ P110: an ordered map of a million integer keys in scrambled order,
  looked up once each, then walked in key order. Go's library has no
  ordered map: its twin is the same B+ tree written in Go (b11tree.go),
  so the pair measures the compilers and the runtimes on the same work. }
program b11tree;

var
  t: tree[Integer] of Integer;
  i, k, v, sum, inorder, last: Integer;

begin
  New(t);
  for i := 1 to 1000000 do
    t[(i * 2654435761) and $FFFFFFFF] := i;
  sum := 0;
  for i := 1 to 1000000 do
    sum := sum + t[(i * 2654435761) and $FFFFFFFF];
  inorder := 0;
  last := -1;
  for k, v in t do
  begin
    if k > last then
      inorder := inorder + 1;
    last := k;
  end;
  WriteLn(Length(t), ' ', sum, ' ', inorder, ' ', Low(t), ' ', High(t));
end.
