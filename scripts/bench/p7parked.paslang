program p7parked;

var
  gate: chan of Integer;
  wg: waitgroup;
  i: Integer;

procedure Waiter;
var
  n: Integer;
begin
  n := Recv(gate);
  wg.Done;
end;

begin
  gate := MakeChan();
  wg.Add(100000);
  for i := 1 to 100000 do
    pas Waiter;
  Sleep(200);
  WriteLn(GCount);
  for i := 1 to 100000 do
    Send(gate, i);
  wg.Wait;
  WriteLn('released');
end.
