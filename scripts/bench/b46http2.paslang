{ P617: an HTTP/2 client, the paslang side of scripts/bench/b46http2.go.
  The client is pashttp2's THttp2Conn on one end of a pair of connected
  Unix sockets; on the other a routine of this program plays the server
  the same way in both languages: it reads frames and answers every
  request's HEADERS with a response written once and sent again with
  the stream's number put in (:status 200, content-type, content-length
  and the content in DATA frames of 16384 octets). No TLS: what is
  measured is the client's HTTP/2, its frames, HPACK, streams and
  windows. seq sends 50,000 requests one after another, each answered
  with 200 octets; conc sends 128,000 from 64 routines at once; big
  takes 100 responses of 2 MiB. Each prints its requests and the
  octets of content it got. }
program b46http2;

uses
  sysutils, pasnet, pasconn, pashttp2;

var
  conn: THttp2Conn;
  hdr: THpackFields;
  wg: waitgroup;
  mu: mutex;
  total: Integer;

function Be32(V: Integer): string;
begin
  Result := Chr((V shr 24) and 255) + Chr((V shr 16) and 255) + Chr((V shr 8) and 255) + Chr(V and 255);
end;

function Frame(Typ, Flags, Id: Integer; const Payload: string): string;
var
  n: Integer;
begin
  n := Length(Payload);
  Result := Chr((n shr 16) and 255) + Chr((n shr 8) and 255) + Chr(n and 255) + Chr(Typ) + Chr(Flags) + Be32(Id) + Payload;
end;

procedure WriteAll(Fd: Integer; const S: string);
var
  p, k: Integer;
begin
  p := 1;
  while p <= Length(S) do
  begin
    k := PasIoWrite(Fd, @S[p], Length(S) - p + 1, 0);
    if k <= 0 then
      Halt(3);
    p := p + k;
  end;
end;

{ the server: a response of BodyLen octets to every request }
procedure Peer(Fd, BodyLen: Integer);
var
  buf, resp, body, lens: string;
  ids: array of Integer;
  have, at0, n, typ, flags, id, i, k, part: Integer;
begin
  { the response once: HEADERS, then DATA frames; ids holds where each
    frame's stream number goes }
  lens := IntToStr(BodyLen);
  resp := Frame(1, 4, 0, #136 + #15#16 + Chr(10) + 'text/plain' + #15#13 + Chr(Length(lens)) + lens);
  SetLength(ids, 1);
  ids[0] := 5;
  SetLength(body, 16384);
  for i := 1 to 16384 do
    body[i] := Chr(97 + i mod 26);
  i := 0;
  while i < BodyLen do
  begin
    part := BodyLen - i;
    if part > 16384 then
      part := 16384;
    flags := 0;
    if i + part = BodyLen then
      flags := 1;
    ids := Append(ids, Length(resp) + 5);
    resp := resp + Frame(0, flags, 0, Copy(body, 1, part));
    i := i + part;
  end;
  SetLength(buf, 65536);
  have := 0;
  at0 := 1;
  { the preface, then SETTINGS: a thousand streams at once }
  while have < 24 do
  begin
    k := PasIoRead(Fd, @buf[have + 1], 65536 - have, 0);
    if k <= 0 then
      Exit;
    have := have + k;
  end;
  at0 := 25;
  WriteAll(Fd, Frame(4, 0, 0, #0#3 + Be32(1000)));
  while True do
  begin
    { a whole frame in buf from at0 }
    while (have - at0 + 1 < 9) or
      (have - at0 + 1 < 9 + ((Ord(buf[at0]) shl 16) or (Ord(buf[at0 + 1]) shl 8) or Ord(buf[at0 + 2]))) do
    begin
      if at0 > 1 then
      begin
        for i := 1 to have - at0 + 1 do
          buf[i] := buf[at0 + i - 1];
        have := have - at0 + 1;
        at0 := 1;
      end;
      k := PasIoRead(Fd, @buf[have + 1], 65536 - have, 0);
      if k <= 0 then
        Exit;
      have := have + k;
    end;
    n := (Ord(buf[at0]) shl 16) or (Ord(buf[at0 + 1]) shl 8) or Ord(buf[at0 + 2]);
    typ := Ord(buf[at0 + 3]);
    flags := Ord(buf[at0 + 4]);
    id := (Ord(buf[at0 + 5]) shl 24) or (Ord(buf[at0 + 6]) shl 16) or (Ord(buf[at0 + 7]) shl 8) or Ord(buf[at0 + 8]);
    at0 := at0 + 9 + n;
    if (typ = 4) and ((flags and 1) = 0) then
      WriteAll(Fd, Frame(4, 1, 0, ''))
    else if typ = 1 then
    begin
      for i := 0 to High(ids) do
      begin
        k := ids[i];
        resp[k + 1] := Chr((id shr 24) and 255);
        resp[k + 2] := Chr((id shr 16) and 255);
        resp[k + 3] := Chr((id shr 8) and 255);
        resp[k + 4] := Chr(id and 255);
      end;
      WriteAll(Fd, resp);
    end;
  end;
end;

function Fetch(I: Integer): Integer;
var
  r: THttp2Response;
  e: string;
begin
  if not conn.Request('GET', '/item/' + IntToStr(I), hdr, '', 0, 0, r, e) then
  begin
    WriteLn('failed: ', e);
    Halt(1);
  end;
  if r.Status <> 200 then
    Halt(4);
  Result := Length(r.Body);
end;

procedure Worker(K, N: Integer);
var
  i, s: Integer;
begin
  s := 0;
  for i := 1 to N do
    s := s + Fetch(K * 100000 + i);
  lock mu do
    total := total + s;
  wg.Done;
end;

procedure Run(Routines, Each, BodyLen: Integer);
var
  a, b, k: Integer;
begin
  if not UnixPair(a, b) then
    Halt(1);
  pas Peer(b, BodyLen);
  conn := THttp2Conn.Create(TTcpStream.Create(a), 'http', 'bench', Default(THttp2Options));
  SetLength(hdr, 3);
  hdr[0] := Http2FieldIndexed('user-agent', 'bench/1.0');
  hdr[1] := Http2FieldIndexed('accept', '*/*');
  hdr[2] := Http2FieldIndexed('authorization', 'Bearer abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz');
  { a first request, as the Go program makes one to have its connection
    made before its routines start }
  k := Fetch(0);
  wg.Add(Routines);
  for k := 1 to Routines do
    pas Worker(k, Each);
  wg.Wait;
  WriteLn(Routines * Each, ' ', total);
  conn.Dispose;
end;

begin
  if ParamStr(1) = 'seq' then
    Run(1, 50000, 200)
  else if ParamStr(1) = 'conc' then
    Run(64, 2000, 200)
  else if ParamStr(1) = 'big' then
    Run(1, 100, 2097152)
  else
  begin
    WriteLn('b46http2: seq, conc or big');
    Halt(2);
  end;
end.
