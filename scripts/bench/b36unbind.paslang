{ P206: typed JSON read, the twin of b36unbind.go: the text of 20000
  items of b35bind's record (an integer, a string, an array of strings,
  a real, a Boolean, an array of records and a map) read 20 times into
  a new array (unmarshal: Go's v2; unmarshal1: v1). It prints a sum of
  what was read. }
program b36unbind;

uses
  sysutils;

type
  TPoint = record
    X: Double json 'x';
    Y: Double json 'y';
  end;

  TItem = record
    Id: Integer json 'id';
    Name: string json 'name';
    Tags: array of string json 'tags';
    Price: Double json 'price';
    Active: Boolean json 'active';
    Pts: array of TPoint json 'pts';
    Attrs: map[string] of Integer json 'attrs';
  end;

const
  N = 20000;
  Rounds = 20;

var
  items, got: array of TItem;
  section, t: string;
  i, k, r, total: Integer;

begin
  section := ParamStr(1);
  SetLength(items, N);
  for i := 0 to N - 1 do
  begin
    items[i].Id := i;
    items[i].Name := 'item ' + IntToStr(i);
    SetLength(items[i].Tags, 3);
    items[i].Tags[0] := 't' + IntToStr(i mod 7);
    items[i].Tags[1] := 'u' + IntToStr(i mod 11);
    items[i].Tags[2] := 'v';
    items[i].Price := i * 0.25 + 0.1;
    items[i].Active := i mod 3 = 0;
    SetLength(items[i].Pts, 4);
    for k := 0 to 3 do
    begin
      items[i].Pts[k].X := i + k;
      items[i].Pts[k].Y := i / 8;
    end;
    New(items[i].Attrs);
    items[i].Attrs['c'] := i;
    items[i].Attrs['a'] := i + 1;
    items[i].Attrs['b'] := i + 2;
  end;
  t := JsonEncode(items);
  total := 0;
  for r := 1 to Rounds do
  begin
    got := nil;
    JsonDecode(t, got);
    for i := 0 to High(got) do
      total := total + got[i].Id + Length(got[i].Name) + Length(got[i].Tags[1]) +
        Round(got[i].Pts[3].X) + got[i].Attrs['b'] + Ord(got[i].Active);
  end;
  WriteLn(total);
end.
