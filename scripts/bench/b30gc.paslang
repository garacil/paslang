{ P223: the collector under allocation, the binary-trees program of the
  Computer Language Benchmarks Game at depth 18: a stretch tree of depth
  19, a tree of depth 18 kept to the end, and for each even depth from
  4 to 18, 2^(22 - depth) trees built and checked. Records linked by
  pointers against Go structs; both collectors as they come. It prints
  the game's lines. }
program b30gc;

type
  PNode = ^TNode;
  TNode = record
    Left, Right: PNode;
  end;

function Make(D: Integer): PNode;
begin
  New(Result);
  if D > 0 then
  begin
    Result^.Left := Make(D - 1);
    Result^.Right := Make(D - 1);
  end
  else
  begin
    Result^.Left := nil;
    Result^.Right := nil;
  end;
end;

function Check(N: PNode): Integer;
begin
  if N^.Left = nil then
    Result := 1
  else
    Result := 1 + Check(N^.Left) + Check(N^.Right);
end;

const
  MaxDepth = 18;
  MinDepth = 4;

var
  long: PNode;
  d, i, iters, chk: Integer;

begin
  if ParamStr(1) <> 'trees' then
  begin
    WriteLn('b30gc: trees');
    Halt(2);
  end;
  WriteLn('stretch tree of depth ', MaxDepth + 1, ' check: ', Check(Make(MaxDepth + 1)));
  long := Make(MaxDepth);
  d := MinDepth;
  while d <= MaxDepth do
  begin
    iters := 1 shl (MaxDepth - d + MinDepth);
    chk := 0;
    for i := 1 to iters do
      chk := chk + Check(Make(d));
    WriteLn(iters, ' trees of depth ', d, ' check: ', chk);
    d := d + 2;
  end;
  WriteLn('long lived tree of depth ', MaxDepth, ' check: ', Check(long));
end.
