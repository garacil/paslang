{ P223: bytes as text, each section its own pair. hex writes 1 MiB in
  hexadecimal 200 times (Hex against encoding/hex.EncodeToString);
  runes walks 1 MiB of UTF-8 (ASCII, two-, three- and four-byte
  characters from a linear congruence) by its scalars 100 times (for r
  in s against for range). Each prints a sum. }
program b21text;

var
  text: string;

procedure Put(var N: Integer; B: Integer);
begin
  N := N + 1;
  text[N] := Char(B);
end;

{ Written byte by byte into a string sized first: a string built by
  joining one character at a time is quadratic until its hito (P223). }
procedure MakeText;
var
  x, k, n: Integer;
begin
  SetLength(text, 1048576 + 3);
  n := 0;
  x := 12345;
  while n < 1048576 do
  begin
    x := (x * 1103515245 + 12345) and $7FFFFFFF;
    k := (x shr 16) mod 10;
    if k < 6 then
      Put(n, 97 + (x shr 8) mod 26)
    else if k < 8 then
    begin
      Put(n, $C3);
      Put(n, $B1);
    end
    else if k < 9 then
    begin
      Put(n, $E2);
      Put(n, $82);
      Put(n, $AC);
    end
    else
    begin
      Put(n, $F0);
      Put(n, $9F);
      Put(n, $98);
      Put(n, $80);
    end;
  end;
  SetLength(text, n);
end;

procedure HexS;
var
  i, t: Integer;
  h: string;
begin
  t := 0;
  for i := 1 to 200 do
  begin
    text[1] := Char(97 + i mod 26);
    h := Hex(text);
    t := t + Ord(h[1 + i]) + Length(h);
  end;
  WriteLn(t);
end;

procedure Runes;
var
  i, t, n: Integer;
  r: Rune;
begin
  t := 0;
  n := 0;
  for i := 1 to 100 do
    for r in text do
    begin
      t := t + Ord(r);
      n := n + 1;
    end;
  WriteLn(n, ' ', t);
end;

begin
  MakeText;
  if ParamStr(1) = 'hex' then
    HexS
  else if ParamStr(1) = 'runes' then
    Runes
  else
  begin
    WriteLn('b21text: hex or runes');
    Halt(2);
  end;
end.
