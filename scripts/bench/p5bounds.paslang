program p5bounds;

var
  a: array[0..4] of Integer;
  d: array of Integer;
  i: Integer;

begin
  for i := 0 to 4 do
    a[i] := i;
  i := 10 + ParamCount;
  WriteLn(a[i]);
  SetLength(d, 3);
  WriteLn(d[i]);
end.
