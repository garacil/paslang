{ P223: file reads and writes in small blocks, the cost of a call, each
  section its own pair, on a file in /dev/shm (memory, so no disk is
  measured). small writes 64 MiB in 256-byte blocks (FileWrite against
  os.File.Write); smallread writes 64 MiB once in 64 KiB blocks and
  reads it back in 256-byte blocks (FileRead against os.File.Read). In
  64 KiB blocks both twins took the same time to within 2 % (256 MiB
  written in 0.149 s, 512 MiB read in 0.108 s): the kernel's copy, which
  no language changes, so the bulk sizes are not a pair. Each prints the
  bytes moved and a byte of the end. }
program b15io;

uses
  sysutils;

var
  path: string;

procedure WriteBlocks(Size, Count: Integer);
var
  buf: TBytes;
  h, i, n: Integer;
begin
  SetLength(buf, Size);
  for i := 0 to Size - 1 do
    buf[i] := Byte(i * 7);
  h := FileCreate(path);
  n := 0;
  for i := 1 to Count do
    n := n + FileWrite(h, buf, Size);
  FileClose(h);
  WriteLn(n, ' ', buf[Size - 1]);
end;

procedure ReadBack;
var
  buf, small: TBytes;
  h, i, n, got: Integer;
begin
  SetLength(buf, 65536);
  for i := 0 to 65535 do
    buf[i] := Byte(i * 7);
  h := FileCreate(path);
  for i := 1 to 1024 do
    FileWrite(h, buf, 65536);
  FileClose(h);
  SetLength(small, 256);
  n := 0;
  h := FileOpen(path, fmOpenRead);
  repeat
    got := FileRead(h, small, 256);
    n := n + got;
  until got <= 0;
  FileClose(h);
  WriteLn(n, ' ', small[255]);
end;

begin
  path := '/dev/shm/paslang-b15io-pl';
  if ParamStr(1) = 'small' then
    WriteBlocks(256, 262144)
  else if ParamStr(1) = 'smallread' then
    ReadBack
  else
  begin
    WriteLn('b15io: small or smallread');
    Halt(2);
  end;
  DeleteFile(path);
end.
