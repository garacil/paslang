program b7narrow;

{ P100's bench pair: 64 MiB of Byte filled from a linear congruence, then
  four passes of a table lookup and a histogram. Go's twin is
  b7narrow.go. }

var
  data: array of Byte;
  tab: array[0..255] of Byte;
  hist: array[0..255] of Integer;
  i, n, x, sum, pass: Integer;

begin
  n := 64 * 1024 * 1024;
  SetLength(data, n);
  x := 12345;
  for i := 0 to n - 1 do
  begin
    x := x * 1103515245 + 12345;
    data[i] := Byte(x shr 16);
  end;
  for i := 0 to 255 do
    tab[i] := Byte(i * 7 + 3);
  for pass := 1 to 4 do
  begin
    for i := 0 to n - 1 do
      data[i] := tab[data[i]];
    for i := 0 to n - 1 do
      hist[data[i]] := hist[data[i]] + 1;
  end;
  sum := 0;
  for i := 0 to 255 do
    sum := sum + hist[i] * i;
  WriteLn(sum);
end.
