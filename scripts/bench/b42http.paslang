{ P479: HTTP requests read, the paslang side of scripts/bench/b42http.go:
  200,000 requests of six shapes (a bare GET, a POST with a JSON body, a
  GET with a long query and cookies, a chunked POST, a PUT whose header
  names are in lower case, a GET with twelve headers) each read whole from
  a string with pashttp's reader; the method, the path, the number of
  fields (less the Host that pashttp keeps among them and Go's ReadRequest moves to
  Request.Host), the Content-Length and the body's length are summed. }
program b42http;

uses
  sysutils, pashttp;

const
  H = #13#10;

var
  reqs: array[0..5] of string;
  i, n: Integer;
  r: THttpMessageReader;
  sum: Int64;

begin
  reqs[0] := 'GET /items/42 HTTP/1.1' + H + 'Host: 127.0.0.1:8080' + H + 'User-Agent: bench/1.0' + H +
    'Accept: */*' + H + 'Accept-Encoding: gzip' + H + 'Connection: keep-alive' + H + H;
  reqs[1] := 'POST /items HTTP/1.1' + H + 'Host: 127.0.0.1:8080' + H + 'User-Agent: bench/1.0' + H +
    'Content-Type: application/json' + H + 'Content-Length: 21' + H + H + '{"name":"Ana","n":42}';
  reqs[2] := 'GET /search?q=pascal&page=2&sort=name HTTP/1.1' + H + 'Host: example.org' + H +
    'Cookie: session=0123456789abcdef0123456789abcdef; theme=dark; lang=es; tracking=abcdefghijklmnopqrstuvwxyz' + H +
    'Authorization: Bearer abcdefghijklmnopqrstuvwxyz0123456789' + H + 'Accept-Language: es-ES,es;q=0.9,en;q=0.8' + H + H;
  reqs[3] := 'POST /upload HTTP/1.1' + H + 'Host: example.org' + H + 'Transfer-Encoding: chunked' + H +
    'Content-Type: text/plain' + H + H + '10' + H + '0123456789abcdef' + H + '5' + H + 'hello' + H + '0' + H + H;
  reqs[4] := 'PUT /files/a/b/c.txt HTTP/1.1' + H + 'host: example.org' + H + 'content-length: 5' + H +
    'content-type: text/plain' + H + 'x-request-id: 42' + H + H + 'hello';
  reqs[5] := 'GET /api/v1/users HTTP/1.1' + H + 'Host: example.org' + H + 'User-Agent: Mozilla/5.0 (X11; Linux x86_64)' + H +
    'Accept: text/html,application/xhtml+xml' + H + 'Accept-Language: en-US' + H + 'Accept-Encoding: gzip, deflate' + H +
    'Connection: keep-alive' + H + 'Upgrade-Insecure-Requests: 1' + H + 'Cache-Control: max-age=0' + H +
    'X-Forwarded-For: 10.0.0.1' + H + 'X-Real-IP: 10.0.0.1' + H + 'X-Request-Id: abcdef' + H + H;
  sum := 0;
  for n := 1 to 200000 do
  begin
    i := n mod 6;
    r := THttpMessageReader.Create(True, '');
    r.Feed(reqs[i]);
    sum := sum + Length(r.Head.Method) + Length(r.Head.Url.Path) + (r.Head.Fields.Count - 1) + Length(r.TakeBody) +
      r.Head.ContentLength;
  end;
  WriteLn(sum);
end.
