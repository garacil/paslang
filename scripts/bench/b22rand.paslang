{ P223: random numbers, each section its own pair. own draws 100
  million words from a generator the routine owns (RandNext on a TRand,
  xoshiro256**, against rand.New(rand.NewPCG(...)).Uint64()); below 50
  million below 1000 (RandBelow against IntN); real 50 million in
  [0, 1) (RandReal against Float64); global 20 million from the
  generator everybody shares (RandInt against rand.Uint64); globalpar
  the same from eight routines at once, 2.5 million each. The streams
  differ, so each prints only how many it drew. }
program b22rand;

uses
  pasrand;

var
  wg: waitgroup;
  r: TRand;
  sink: Integer;

procedure Drawer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 1 to 2500000 do
    t := t xor RandInt;
  AtomicAdd(@sink, t and 1);
  wg.Done;
end;

var
  i, t, n: Integer;
  f: Real;

begin
  RandInit(r, 42);
  t := 0;
  n := 0;
  if ParamStr(1) = 'own' then
  begin
    for i := 1 to 100000000 do
      t := t xor RandNext(r);
    n := 100000000;
  end
  else if ParamStr(1) = 'below' then
  begin
    for i := 1 to 50000000 do
      t := t + RandBelow(r, 1000);
    n := 50000000;
  end
  else if ParamStr(1) = 'real' then
  begin
    f := 0;
    for i := 1 to 50000000 do
      f := f + RandReal(r);
    t := Trunc(f);
    n := 50000000;
  end
  else if ParamStr(1) = 'global' then
  begin
    RandSeed(42);
    for i := 1 to 20000000 do
      t := t xor RandInt;
    n := 20000000;
  end
  else if ParamStr(1) = 'globalpar' then
  begin
    RandSeed(42);
    wg.Add(8);
    for i := 1 to 8 do
      pas Drawer;
    wg.Wait;
    n := 20000000;
  end
  else
  begin
    WriteLn('b22rand: own, below, real, global or globalpar');
    Halt(2);
  end;
  if t = 1 then
    sink := sink + 1;
  WriteLn(n);
end.
