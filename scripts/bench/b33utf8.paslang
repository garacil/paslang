{ P201: UTF-8 validation, the twin of b33utf8.go. A text of one MiB is
  checked 2000 times: ascii is letters, digits and spaces alone, mixed
  a run of Latin, CJK, a dash and an emoji among them (PasUtf8Valid
  against unicode/utf8.Valid). Each prints the bytes found right. }
program b33utf8;

var
  buf, u: string;
  i, t: Integer;

begin
  u := 'abcdefghijklmnopqrstuvwxyz0123456789 ';
  if ParamStr(1) = 'mixed' then
    u := 'Grüße, 世界! añadir — ünïcödé 😀 text ';
  buf := '';
  while Length(buf) + Length(u) <= 1048576 do
    buf := buf + u;
  t := 0;
  for i := 0 to 1999 do
    if PasUtf8Valid(@buf[1], Length(buf), False) < 0 then
      t := t + Length(buf);
  WriteLn(t);
end.
