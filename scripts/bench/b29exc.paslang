{ P223: an error carried up and caught, a million times: a routine
  three calls down raises an object and the caller's except part takes
  it (raise and try ... except on E: against panic of a pointer and a
  deferred recover). It prints a sum of what was caught. }
program b29exc;

type
  EBench = class
    Code: Integer;
    constructor Create(C: Integer);
  end;

constructor EBench.Create(C: Integer);
begin
  Code := C;
end;

procedure Deep3(K: Integer);
begin
  if K >= 0 then
    raise EBench.Create(K and 7);
end;

procedure Deep2(K: Integer);
begin
  Deep3(K);
end;

procedure Deep1(K: Integer);
begin
  Deep2(K);
end;

function Catch(K: Integer): Integer;
begin
  Result := 0;
  try
    Deep1(K);
  except
    on E: EBench do
      Result := E.Code;
  end;
end;

var
  i, t: Integer;

begin
  if ParamStr(1) <> 'raise' then
  begin
    WriteLn('b29exc: raise');
    Halt(2);
  end;
  t := 0;
  for i := 1 to 1000000 do
    t := t + Catch(i);
  WriteLn(t);
end.
