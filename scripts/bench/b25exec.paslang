{ P223: starting programs, each section its own pair. serial runs
  /usr/bin/true 500 times one after another (ExecuteProcess against
  os/exec's Command and Run); par runs it 400 times from eight
  routines at once, 50 each. Each prints the exit codes' sum. }
program b25exec;

uses
  sysutils;

var
  wg: waitgroup;
  total: Integer;

procedure Runner;
var
  k, t: Integer;
begin
  t := 0;
  for k := 1 to 50 do
    t := t + ExecuteProcess('/usr/bin/true', []);
  AtomicAdd(@total, t);
  wg.Done;
end;

var
  i: Integer;

begin
  total := 0;
  if ParamStr(1) = 'serial' then
    for i := 1 to 500 do
      total := total + ExecuteProcess('/usr/bin/true', [])
  else if ParamStr(1) = 'par' then
  begin
    wg.Add(8);
    for i := 1 to 8 do
      pas Runner;
    wg.Wait;
  end
  else
  begin
    WriteLn('b25exec: serial or par');
    Halt(2);
  end;
  WriteLn(total);
end.
