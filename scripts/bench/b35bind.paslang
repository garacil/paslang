{ P205: typed JSON written, the twin of b35bind.go: 20000 items of a
  record with an integer, a string, an array of strings, a real, a
  Boolean, an array of records and a map, written 20 times compact
  (marshal, marshal1: Go's v2 with Deterministic and v1, which order a
  map's names as paslang does) and a value a line (indent, indent1). It
  prints the bytes written. }
program b35bind;

uses
  sysutils;

type
  TPoint = record
    X: Double json 'x';
    Y: Double json 'y';
  end;

  TItem = record
    Id: Integer json 'id';
    Name: string json 'name';
    Tags: array of string json 'tags';
    Price: Double json 'price';
    Active: Boolean json 'active';
    Pts: array of TPoint json 'pts';
    Attrs: map[string] of Integer json 'attrs';
  end;

const
  N = 20000;
  Rounds = 20;

var
  items: array of TItem;
  section, t: string;
  i, k, r, total: Integer;

begin
  section := ParamStr(1);
  SetLength(items, N);
  for i := 0 to N - 1 do
  begin
    items[i].Id := i;
    items[i].Name := 'item ' + IntToStr(i);
    SetLength(items[i].Tags, 3);
    items[i].Tags[0] := 't' + IntToStr(i mod 7);
    items[i].Tags[1] := 'u' + IntToStr(i mod 11);
    items[i].Tags[2] := 'v';
    items[i].Price := i * 0.25 + 0.1;
    items[i].Active := i mod 3 = 0;
    SetLength(items[i].Pts, 4);
    for k := 0 to 3 do
    begin
      items[i].Pts[k].X := i + k;
      items[i].Pts[k].Y := i / 8;
    end;
    New(items[i].Attrs);
    items[i].Attrs['c'] := i;
    items[i].Attrs['a'] := i + 1;
    items[i].Attrs['b'] := i + 2;
  end;
  total := 0;
  for r := 1 to Rounds do
  begin
    if (section = 'marshal') or (section = 'marshal1') then
      t := JsonEncode(items)
    else
      t := JsonEncode(items, JsonPretty);
    total := total + Length(t);
  end;
  WriteLn(total);
end.
