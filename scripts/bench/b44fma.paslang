{ P425: the fused multiply-add, the paslang side of scripts/bench/b44fma.go:
  Horner's rule of degree 16 with Fma at thirty million points; the sums are
  folded into one hash of the bits. }
program b44fma;

function Horner(x: Double): Double;
var
  i: Integer;
  r: Double;
begin
  r := 0.0;
  for i := 1 to 16 do
    r := Fma(r, x, i);
  Result := r;
end;

var
  k: Integer;
  total: Double;
begin
  total := 0.0;
  for k := 0 to 29999999 do
    total := total + Horner((k mod 2000) / 2000.0 - 0.5);
  WriteLn(total as Integer);
end.
