{ P451: base64, the paslang side of scripts/bench/b41base64.go: ten times a
  buffer of 3 MB encoded with Base64Encode and decoded again, the lengths
  summed. }
program b41base64;

uses
  sysutils, pascodec;

var
  s, e, d: string;
  i, j, sum: Integer;
  ok: Boolean;

begin
  SetLength(s, 3000000);
  for i := 1 to Length(s) do
    s[i] := Chr((i * 7) and 255);
  sum := 0;
  for j := 1 to 10 do
  begin
    e := Base64Encode(s, False, True);
    ok := Base64Decode(e, False, True, d);
    sum := sum + Length(e) + Length(d);
  end;
  WriteLn(sum);
end.
