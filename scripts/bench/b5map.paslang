program b5map;

var
  m: map[Integer] of Integer;
  i, t: Integer;

begin
  New(m);
  for i := 1 to 1000000 do
    m[i * 7919] := i;
  t := 0;
  for i := 1 to 1000000 do
    t := t + m[i * 7919];
  WriteLn(Length(m), ' ', t);
end.
