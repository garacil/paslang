{ P223: the sync words, each section its own pair. mutex: 16 routines
  take one mutex 500,000 times each to add one (lock mu do against
  sync.Mutex). rwread: 16 routines take an rwmutex to read 1,000,000
  times each (lock rw read do against RLock). once: one routine passes
  a once that has run, 50 million times (once init do against
  sync.Once.Do). cond: two routines hand a turn to each other 200,000
  times under a mutex and a cond (Wait and Signal). atomic: 16 routines
  add one 2,000,000 times each to one word (AtomicAdd against
  atomic.AddInt64). Each prints its count. }
program b18sync;

var
  wg: waitgroup;
  mu: mutex;
  rw: rwmutex;
  init: once;
  turn: cond;
  count, shared, whose: Integer;

procedure Locker;
var
  k: Integer;
begin
  for k := 1 to 500000 do
    lock mu do
      count := count + 1;
  wg.Done;
end;

procedure Reader;
var
  k, v, t: Integer;
begin
  t := 0;
  for k := 1 to 1000000 do
  begin
    lock rw read do
      v := shared;
    t := t + v;
  end;
  AtomicAdd(@count, t);
  wg.Done;
end;

procedure Setup;
begin
  shared := shared + 1;
end;

procedure Player(Me: Integer);
var
  k: Integer;
begin
  for k := 1 to 200000 do
  begin
    mu.Lock;
    while whose <> Me do
      turn.Wait(mu);
    whose := 1 - Me;
    count := count + 1;
    turn.Signal;
    mu.Unlock;
  end;
  wg.Done;
end;

procedure Adder;
var
  k: Integer;
begin
  for k := 1 to 2000000 do
    AtomicAdd(@count, 1);
  wg.Done;
end;

var
  i: Integer;

begin
  count := 0;
  shared := 3;
  if ParamStr(1) = 'mutex' then
  begin
    wg.Add(16);
    for i := 1 to 16 do
      pas Locker;
    wg.Wait;
  end
  else if ParamStr(1) = 'rwread' then
  begin
    wg.Add(16);
    for i := 1 to 16 do
      pas Reader;
    wg.Wait;
  end
  else if ParamStr(1) = 'once' then
  begin
    for i := 1 to 50000000 do
      once init do
        Setup;
    count := shared;
  end
  else if ParamStr(1) = 'cond' then
  begin
    whose := 0;
    wg.Add(2);
    pas Player(0);
    pas Player(1);
    wg.Wait;
  end
  else if ParamStr(1) = 'atomic' then
  begin
    wg.Add(16);
    for i := 1 to 16 do
      pas Adder;
    wg.Wait;
  end
  else
  begin
    WriteLn('b18sync: mutex, rwread, once, cond or atomic');
    Halt(2);
  end;
  WriteLn(count);
end.
