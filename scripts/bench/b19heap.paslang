{ P223: a binary min-heap, each section its own pair. ints pushes two
  million Int64 from a linear congruence and pops them all (heap of
  Integer against container/heap on a slice of int64); strings half a
  million strings 'k' and a number. Each prints a sum over the order of
  popping and the last value. }
program b19heap;

uses
  sysutils;

var
  x: Int64;

function Next: Int64;
begin
  x := x * 6364136223846793005 + 1442695040888963407;
  Result := x;
end;

procedure Ints;
var
  h: heap of Integer;
  i, v, t: Integer;
begin
  New(h);
  for i := 1 to 2000000 do
    Push(h, Next shr 11);
  t := 0;
  v := 0;
  for i := 1 to 2000000 do
  begin
    v := Pop(h);
    t := t + (v and 1023) * (i and 7);
  end;
  WriteLn(t, ' ', v);
end;

procedure Strs;
var
  h: heap of string;
  i, t: Integer;
  v: string;
begin
  New(h);
  for i := 1 to 500000 do
    Push(h, 'k' + IntToStr(Next shr 40));
  t := 0;
  v := '';
  for i := 1 to 500000 do
  begin
    v := Pop(h);
    t := t + Length(v) * (i and 7);
  end;
  WriteLn(t, ' ', v);
end;

begin
  x := 12345;
  if ParamStr(1) = 'ints' then
    Ints
  else if ParamStr(1) = 'strings' then
    Strs
  else
  begin
    WriteLn('b19heap: ints or strings');
    Halt(2);
  end;
end.
