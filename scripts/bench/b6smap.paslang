{ A map with a million string keys ("key" and a number), inserted and
  read back; the keys are built first. The pair of b5map for strings
  (1.0.65): Go's map[string]int. }
program b6smap;

uses
  paslib;

var
  m: map[string] of Integer;
  keys: array of string;
  i, t: Integer;

begin
  SetLength(keys, 1000000);
  for i := 0 to 999999 do
    keys[i] := 'key' + IntToStr(i * 7919);
  New(m);
  for i := 0 to 999999 do
    m[keys[i]] := i;
  t := 0;
  for i := 0 to 999999 do
    t := t + m[keys[i]];
  WriteLn(Length(m), ' ', t);
end.
