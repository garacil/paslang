{ Argon2 and BLAKE2b against golang.org/x/crypto (P438): argon2id eight
  hashes of the default parameters (64 MiB, t=3, p=4), each with another
  salt, the tags xored together; blake2b the BLAKE2b-512 of a 1 MiB
  buffer 64 times, its first byte changed each round. The section is
  the argument; the output is the same on both sides. }
program b37argon2;

uses argon2;

var
  s, tag, acc: string;
  i, k: Integer;

begin
  if ParamStr(1) = 'argon2id' then
  begin
    acc := StringOfChar(#0, 32);
    for i := 1 to 8 do
    begin
      tag := Argon2idKey('correct horse battery staple', 'salt' + IntToStr(i) + 'saltsalt', 3, 65536, 4, 32);
      for k := 1 to 32 do
        acc[k] := Chr(Ord(acc[k]) xor Ord(tag[k]));
    end;
    WriteLn(Hex(acc));
  end
  else
  begin
    SetLength(s, 1048576);
    for k := 1 to Length(s) do
      s[k] := Chr((k * 31) and 255);
    acc := '';
    for i := 1 to 64 do
    begin
      s[1] := Chr(i);
      tag := Blake2b(s, 64, '');
      if i = 64 then
        acc := tag;
    end;
    WriteLn(Hex(acc));
  end;
end.
