const
  Rounds = 10;

var
  arg, op, name, text, t: string;
  doc: json;
  i, total, k: Integer;
  canada: TCanadaRoot;
  citm: TCitmRoot;
  golang: TGolangRoot;
  strs: TStringRoot;
  synthea: TSyntheaRoot;
  twitter: TTwitterRoot;

{ The values of a document, a container's children included, walked with
  an explicit stack as Go's side walks its any. }
function Count(J: json): Integer;
var
  stack: array of json;
  n: Integer;
  v, w: json;
begin
  Result := 0;
  SetLength(stack, 64);
  stack[0] := J;
  n := 1;
  while n > 0 do
  begin
    n := n - 1;
    v := stack[n];
    Result := Result + 1;
    if (v.Kind = jkArray) or (v.Kind = jkObject) then
      for w in v do
      begin
        if n >= Length(stack) then
          SetLength(stack, Length(stack) * 2);
        stack[n] := w;
        n := n + 1;
      end;
  end;
end;

{ A file's bytes as a string, read whole at its size. }
function Load(const Path: string): string;
var
  h: THandle;
  n: Integer;
  buf: TBytes;
begin
  Result := '';
  h := FileOpen(Path, fmOpenRead);
  if h < 0 then
  begin
    WriteLn('no ', Path, ': run.py writes it');
    Halt(1);
  end;
  n := FileSeek(h, 0, 2);
  FileSeek(h, 0, 0);
  SetLength(buf, n);
  if FileRead(h, buf, n) <> n then
    Halt(1);
  FileClose(h);
  SetLength(Result, n);
  Move(buf[0], Result[1], n);
end;

{ The text again, a token at a time: each token the reader reads written
  by the writer as it was read, into memory, as Go's jsontext.Decoder
  tokens go into its Encoder. }
function Rebuild(const S: string): string;
var
  r: TJsonReader;
  w: TJsonWriter;
begin
  r := JsonReader(S);
  w := JsonWriter;
  while r.Next <> jtkEnd do
    w.Token(r);
  { the newline after the value, which Go's side trims too }
  Result := w.Text;
  if (Length(Result) > 0) and (Result[Length(Result)] = #10) then
    SetLength(Result, Length(Result) - 1);
end;

begin
  arg := ParamStr(1);
  k := Pos('-', arg);
  op := Copy(arg, 1, k - 1);
  name := Copy(arg, k + 1, Length(arg));
  if (op <> '') and (op[Length(op)] = '1') then
    op := Copy(op, 1, Length(op) - 1);
  text := Load('build/bench/json/' + name + '.json');
  total := 0;
  if op = 'parse' then
    for i := 1 to Rounds do
      total := total + Count(JsonParse(text))
  else if op = 'valid' then
    for i := 1 to Rounds do
      total := total + Ord(JsonValid(text))
  else if op = 'canonical' then
    for i := 1 to Rounds do
      total := total + Length(JsonEncode(JsonParse(text), JsonCanonical))
  else if op = 'build' then
    for i := 1 to Rounds do
      total := total + Length(Rebuild(text))
  else if (op = 'compact') or (op = 'pretty') then
  begin
    doc := JsonParse(text);
    for i := 1 to Rounds do
    begin
      if op = 'compact' then
        t := JsonEncode(doc)
      else
        t := JsonEncode(doc, JsonPretty);
      if Length(t) > 0 then
        total := total + 1;
    end;
  end
  else if (op = 'decode') or (op = 'encode') then
  begin
    for i := 1 to Rounds do
      if (op = 'decode') or (i = 1) then
      begin
        if name = 'canada_geometry' then
          JsonDecode(text, canada)
        else if name = 'citm_catalog' then
          JsonDecode(text, citm)
        else if name = 'golang_source' then
          JsonDecode(text, golang)
        else if name = 'synthea_fhir' then
          JsonDecode(text, synthea)
        else if name = 'twitter_status' then
          JsonDecode(text, twitter)
        else
          JsonDecode(text, strs);
        if op = 'decode' then
          total := total + 1;
      end;
    if op = 'encode' then
      for i := 1 to Rounds do
      begin
        if name = 'canada_geometry' then
          t := JsonEncode(canada)
        else if name = 'citm_catalog' then
          t := JsonEncode(citm)
        else if name = 'golang_source' then
          t := JsonEncode(golang)
        else if name = 'synthea_fhir' then
          t := JsonEncode(synthea)
        else if name = 'twitter_status' then
          t := JsonEncode(twitter)
        else
          t := JsonEncode(strs);
        if Length(t) > 0 then
          total := total + 1;
      end;
  end
  else
  begin
    WriteLn('unknown section ', arg);
    Halt(1);
  end;
  WriteLn(total);
end.
