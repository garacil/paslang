{ P211: JSON on each file of Go's corpus, the twin of b37json.go. Its
  argument is OP-FILE: the operation on that file alone, ten times
  (b34json takes the seven files together). parse reads the text into a
  document and walks it (Go's v2 into any, parse1 v1); valid only checks
  it (jsontext.Value.IsValid, v1's Valid); decode reads it into the
  file's own type (Go's jsontest types, records here; v2's Unmarshal,
  v1's) and encode writes that value back; compact and pretty write the
  parsed document on one line and a value a line; canonical writes the
  text in RFC 8785's form; build makes the document again a token at a
  time (the reader's tokens into a TJsonWriter by Token, Go's jsontext.Decoder
  tokens into an Encoder). Each prints what it counted, as Go's side. }
program b37json;

uses sysutils;


type
  { Go's encoding/json/internal/jsontest/testdata.go, the concrete types
    of the corpus, as records: an anonymous struct of Go's a record of
    its own name, *struct a pointer, any and rawValue a json, time.Time a
    TDateTime as RFC 3339, ,string quoted. }

  { canada_geometry }
  TCanadaProps = record
    Name: string json 'name';
  end;
  TCanadaPoint = array[0..1] of Double;
  TCanadaGeometry = record
    Type_: string json 'type';
    Coordinates: array of array of TCanadaPoint json 'coordinates';
  end;
  TCanadaFeature = record
    Type_: string json 'type';
    Properties: TCanadaProps json 'properties';
    Geometry: TCanadaGeometry json 'geometry';
  end;
  TCanadaRoot = record
    Type_: string json 'type';
    Features: array of TCanadaFeature json 'features';
  end;

  { citm_catalog }
  TCitmEvent = record
    Description: string json 'description';
    Id: Integer json 'id';
    Logo: string json 'logo';
    Name: string json 'name';
    SubTopicIds: array of Integer json 'subTopicIds';
    SubjectCode: json json 'subjectCode';
    Subtitle: json json 'subtitle';
    TopicIds: array of Integer json 'topicIds';
  end;
  TCitmPrice = record
    Amount: Integer json 'amount';
    AudienceSubCategoryId: Integer json 'audienceSubCategoryId';
    SeatCategoryId: Integer json 'seatCategoryId';
  end;
  TCitmArea = record
    AreaId: Integer json 'areaId';
    BlockIds: array of json json 'blockIds';
  end;
  TCitmSeatCategory = record
    Areas: array of TCitmArea json 'areas';
    SeatCategoryId: Integer json 'seatCategoryId';
  end;
  TCitmPerformance = record
    EventId: Integer json 'eventId';
    Id: Integer json 'id';
    Logo: json json 'logo';
    Name: json json 'name';
    Prices: array of TCitmPrice json 'prices';
    SeatCategories: array of TCitmSeatCategory json 'seatCategories';
    SeatMapImage: json json 'seatMapImage';
    Start: Integer json 'start';
    VenueCode: string json 'venueCode';
  end;
  TCitmRoot = record
    AreaNames: map[Integer] of string json 'areaNames';
    AudienceSubCategoryNames: map[Integer] of string json 'audienceSubCategoryNames';
    BlockNames: map[Integer] of string json 'blockNames';
    Events: map[Integer] of TCitmEvent json 'events';
    Performances: array of TCitmPerformance json 'performances';
    SeatCategoryNames: map[UInt64] of string json 'seatCategoryNames';
    SubTopicNames: map[UInt64] of string json 'subTopicNames';
    SubjectNames: map[UInt64] of string json 'subjectNames';
    TopicNames: map[UInt64] of string json 'topicNames';
    TopicSubTopics: map[UInt64] of array of UInt64 json 'topicSubTopics';
    VenueNames: map[string] of string json 'venueNames';
  end;

