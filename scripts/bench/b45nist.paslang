{ P471: one first public-key derivation per fresh process. The argument
  chooses p256 or p384; both sides validate the same private scalar and
  write its complete SEC 1 point. Optional report prints the first call
  and 100 subsequent calls separately for development measurements. }
program b45nist;

uses pasnist;

var
  curve, size, i, started, cold, warm: Integer;
  privateKey, publicKey: string;
  report: Boolean;
begin
  curve := NistP256;
  size := 32;
  if ParamStr(1) = 'p384' then
  begin
    curve := NistP384;
    size := 48;
  end;
  privateKey := StringOfChar(#1, size);
  report := ParamStr(2) = 'report';
  started := 0;
  if report then started := Nanotime;
  publicKey := NistPublicKey(curve, privateKey);
  if report then
  begin
    cold := Nanotime - started;
    started := Nanotime;
    for i := 1 to 100 do
      publicKey := NistPublicKey(curve, privateKey);
    warm := Nanotime - started;
    WriteLn(cold, ' ', warm);
  end;
  if Length(publicKey) <> 2 * size + 1 then Halt(1);
  WriteLn(Hex(publicKey));
end.
