{ P111: SHA-256 and CRC-32C over a 1 MiB buffer, 64 and 256 times, the
  first byte changed each round so nothing is cached. Go: crypto/sha256
  and hash/crc32 (Castagnoli), both on the processor's instructions. }
program b9hash;

var
  s, d: string;
  i, acc, crc: Integer;

begin
  SetLength(s, 1048576);
  for i := 1 to Length(s) do
    s[i] := Char((i * 31) and 255);
  acc := 0;
  for i := 1 to 64 do
  begin
    s[1] := Char(i);
    d := Sha256(s);
    acc := acc + Ord(d[1]) + Ord(d[32]);
  end;
  crc := 0;
  for i := 1 to 256 do
  begin
    s[1] := Char(i);
    crc := crc xor Crc32c(s);
  end;
  WriteLn(acc, ' ', crc, ' ', Hex(d));
end.
