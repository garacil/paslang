{ P223: growing slices, each section its own pair. ints appends twenty
  million integers one at a time (s := Append(s, x) against append);
  strings appends two million strings 'k' and a number. Each prints
  the length and a sum. }
program b26slice;

uses
  sysutils;

var
  a: array of Integer;
  b: array of string;
  i, t: Integer;

begin
  t := 0;
  if ParamStr(1) = 'ints' then
  begin
    for i := 1 to 20000000 do
      a := Append(a, i * 3);
    for i := 0 to Length(a) - 1 do
      t := t + (a[i] and 7);
    WriteLn(Length(a), ' ', t);
  end
  else if ParamStr(1) = 'strings' then
  begin
    for i := 1 to 2000000 do
      b := Append(b, 'k' + IntToStr(i));
    for i := 0 to Length(b) - 1 do
      t := t + Length(b[i]);
    WriteLn(Length(b), ' ', t);
  end
  else
  begin
    WriteLn('b26slice: ints or strings');
    Halt(2);
  end;
end.
