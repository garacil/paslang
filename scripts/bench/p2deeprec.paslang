program p2deeprec;

function Depth(N: Integer): Integer;
var
  a, b: Integer;
begin
  a := N;
  b := N + 1;
  if N = 0 then
    Result := 0
  else
    Result := 1 + Depth(N - 1) + (a - b + 1);
end;

begin
  WriteLn(Depth(1000000));
end.
