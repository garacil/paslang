{ P223: the file system, each section its own pair. stat asks whether
  a file exists 500,000 times (FileExists against os.Stat); list reads
  the names of a directory of 2000 files 500 times (ListDir against
  os.File.Readdirnames, unsorted both). The directory is made in /dev/shm
  before and removed after. Each prints a count. }
program b32fs;

uses
  paslib, sysutils;

var
  dir: string;
  i, t, k: Integer;
  names: string;

begin
  dir := '/dev/shm/paslang-b32fs-pl';
  ForceDirectories(dir);
  for i := 1 to 2000 do
    FileClose(FileCreate(dir + '/f' + IntToStr(i)));
  t := 0;
  if ParamStr(1) = 'stat' then
  begin
    for i := 1 to 500000 do
      if FileExists(dir + '/f' + IntToStr(1 + i mod 2000)) then
        t := t + 1;
  end
  else if ParamStr(1) = 'list' then
  begin
    for i := 1 to 500 do
    begin
      names := ListDir(dir);
      for k := 1 to Length(names) do
        if names[k] = #10 then
          t := t + 1;
    end;
  end
  else
  begin
    WriteLn('b32fs: stat or list');
    Halt(2);
  end;
  for i := 1 to 2000 do
    DeleteFile(dir + '/f' + IntToStr(i));
  RemoveDir(dir);
  WriteLn(t);
end.
