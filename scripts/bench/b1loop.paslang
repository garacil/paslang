program b1loop;

var
  i, s, n: Integer;

begin
  n := 1000000000;
  s := 0;
  i := 1;
  while i <= n do
  begin
    s := s + ((i xor s) and 255);
    i := i + 1;
  end;
  WriteLn(s);
end.
