{ rm PATH: sysutils' RemoveAll of PATH, for scripts/bench_rmall.py
  (P631). }
program rm;

uses
  sysutils;

var
  e: TSysError;

begin
  if not TryRemoveAllAt(CurrentDirectoryHandle, ParamStr(1), e) then
  begin
    WriteLn('error: ', e.Code, ' ', e.Path);
    Halt(1);
  end;
end.
