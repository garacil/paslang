{ P426: a document's tokens as testdata/xmlcorpus prints them, for
  scripts/xmlconf.py (the W3C conformance suite) and by hand:
  xmldump FILE [flat] [ext] [dtd]. A line a token: S start tag (name and attributes by
  name, as hex), E end, T text (joined), C comment, P processing
  instruction, then OK, or "# reason" and ERR for a document the reader
  refuses. With ext (P477) the reader has a resolver that reads the
  system identifier of an external entity as a file beside FILE; with
  dtd (P511) it is asked for the external subset and the external
  parameter entities too. }
program xmldump;

uses
  sysutils, pasxml;

const
  HexDigits: string = '0123456789abcdef';

function HexOf(const S: string): string;
var
  i: Integer;
begin
  SetLength(Result, Length(S) * 2);
  for i := 1 to Length(S) do
  begin
    Result[i * 2 - 1] := HexDigits[(Ord(S[i]) shr 4) + 1];
    Result[i * 2] := HexDigits[(Ord(S[i]) and 15) + 1];
  end;
end;

function QN(const U, L: string): string;
begin
  if U = '' then
    Result := L
  else
    Result := U + ' ' + L;
end;

var
  Base: string;

function FileResolver(const PublicId, SystemId: string): string;
var
  data: string;
begin
  if not ReadFile(Base + SystemId, data) then
    raise Exception.Create('no such file ' + SystemId);
  Result := data;
end;

var
  r: TXmlReader;
  tok: TXmlToken;
  txt, line, t: string;
  i, j, k, depth: Integer;
  names, vals: array of string;
  ns, ext, dtd: Boolean;
begin
  ns := True;
  ext := False;
  dtd := False;
  for k := 2 to ParamCount do
  begin
    if ParamStr(k) = 'flat' then
      ns := False;
    if ParamStr(k) = 'ext' then
      ext := True;
    if ParamStr(k) = 'dtd' then
    begin
      ext := True;
      dtd := True;
    end;
  end;
  Base := ParamStr(1);
  k := Length(Base);
  while (k > 0) and (Base[k] <> '/') do
    k := k - 1;
  Base := Copy(Base, 1, k);
  if not ReadFile(ParamStr(1), txt) then
  begin
    WriteLn('# no such file');
    WriteLn('ERR');
    Halt(2);
  end;
  depth := 0;
  line := '';
  try
    r := TXmlReader.Create(txt);
    r.Namespaces := ns;
    if ext then
      r.Resolver := @FileResolver;
    r.LoadSubset := dtd;
    while r.Next(tok) do
    begin
      if (tok.Kind <> xtText) and (tok.Kind <> xtCData) and (line <> '') then
      begin
        if depth > 0 then
          WriteLn('T ', HexOf(line));
        line := '';
      end;
      case tok.Kind of
        xtStart:
          begin
            names := nil;
            vals := nil;
            for i := 0 to High(tok.Attrs) do
              if not tok.Attrs[i].IsNs then
              begin
                SetLength(names, Length(names) + 1);
                SetLength(vals, Length(vals) + 1);
                if ns then
                  names[High(names)] := QN(tok.Attrs[i].URI, tok.Attrs[i].Local)
                else
                  names[High(names)] := tok.Attrs[i].Name;
                vals[High(vals)] := tok.Attrs[i].Value;
              end;
            for i := 0 to High(names) do
              for j := i + 1 to High(names) do
                if names[j] < names[i] then
                begin
                  t := names[i];
                  names[i] := names[j];
                  names[j] := t;
                  t := vals[i];
                  vals[i] := vals[j];
                  vals[j] := t;
                end;
            Write('S ', HexOf(QN(tok.URI, tok.Local)));
            for i := 0 to High(names) do
              Write(' ', HexOf(names[i]), '=', HexOf(vals[i]));
            WriteLn;
            depth := depth + 1;
          end;
        xtEnd:
          begin
            WriteLn('E');
            depth := depth - 1;
          end;
        xtText, xtCData:
          if depth > 0 then
            line := line + tok.Value;
        xtComment:
          WriteLn('C ', HexOf(tok.Value));
        xtPI:
          WriteLn('P ', HexOf(tok.Name), ' ', HexOf(tok.Value));
      end;
    end;
    WriteLn('OK');
  except
    on E: EXmlError do
    begin
      WriteLn('# ', E.Message);
      WriteLn('ERR');
    end;
  end;
end.
