QEMU 11.1.1 linux-user: pass through transparent huge-page advice.

The arm64 runtime advises base or huge pages for the heap as it grows.
Apply the advice to the corresponding host pages when they have the
same mapping semantics as the guest, like MADV_DONTNEED.

--- a/linux-user/mmap.c
+++ b/linux-user/mmap.c
@@ -1339,12 +1339,17 @@
             }
         }
         break;
+    case MADV_HUGEPAGE:
+    case MADV_NOHUGEPAGE:
+        ret = -EINVAL;
+        if (page_check_range(start, len, PAGE_PASSTHROUGH)) {
+            ret = get_errno(madvise(g2h_untagged(start), len, advice));
+        }
+        break;
     case MADV_DONTFORK:
     case MADV_HWPOISON:
     case MADV_MERGEABLE:
     case MADV_UNMERGEABLE:
-    case MADV_HUGEPAGE:
-    case MADV_NOHUGEPAGE:
     case MADV_POPULATE_READ:
     case MADV_POPULATE_WRITE:
 #ifdef MADV_COLLAPSE
