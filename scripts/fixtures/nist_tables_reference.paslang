{ Test view only. Recompute the public multiples as Go's
  nistec/p256_table_test.go and p384.go generatorTable do, using
  pasnist's ordinary point operations, independently of the generator. }
procedure ProbeControl;
begin
  if not NistPointValid(NistP256, NistUnHex('046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5')) then
    Halt(90);
  if not NistPointValid(NistP384, NistUnHex('04aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab73617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f')) then
    Halt(91);
  WriteLn('control');
end;

procedure ProbeTables;
var
  base256, point256: TP256Point;
  base384, point384, selected384: TP384Point;
  inverse256, x256, y256: TP256Fe;
  inverse384, x384, y384, one384: TP384Fe;
  i, j, k, selected: Integer;

  procedure Require(Condition: Boolean; const Message: string);
  begin
    if not Condition then
    begin
      WriteLn(Message);
      Halt(1);
    end;
  end;

begin
  Require(P256FeSetBytes(base256.X, NistUnHex('6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296'), 1), 'P256 generator X');
  Require(P256FeSetBytes(base256.Y, NistUnHex('4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5'), 1), 'P256 generator Y');
  P256SetOne(base256.Z);
  for i := 0 to 42 do
  begin
    P256SetInfinity(point256);
    for j := 0 to 31 do
    begin
      P256PointAdd(point256, point256, base256);
      P256FeInvert(inverse256, point256.Z);
      P256Mul(x256, point256.X, inverse256);
      P256Mul(y256, point256.Y, inverse256);
      for k := 0 to 3 do
      begin
        Require(x256[k] = P256GenTables[i][j].X[k], 'P256 table X');
        Require(y256[k] = P256GenTables[i][j].Y[k], 'P256 table Y');
      end;
    end;
    for k := 0 to 5 do
      P256PointDouble(base256, base256);
  end;
  WriteLn('P256 1376 entries');
  Require(P384FeSetBytes(base384.X, NistUnHex('aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7'), 1), 'P384 generator X');
  Require(P384FeSetBytes(base384.Y, NistUnHex('3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f'), 1), 'P384 generator Y');
  P384SetOne(base384.Z);
  P384SetOne(one384);
  for i := 0 to 95 do
  begin
    point384 := base384;
    for j := 0 to 14 do
    begin
      P384FeInvert(inverse384, point384.Z);
      P384Mul(x384, point384.X, inverse384);
      P384Mul(y384, point384.Y, inverse384);
      for k := 0 to 5 do
      begin
        Require(x384[k] = P384GenTables[i][j].X[k], 'P384 table X');
        Require(y384[k] = P384GenTables[i][j].Y[k], 'P384 table Y');
      end;
      P384PointAdd(point384, point384, base384);
    end;
    for selected := 0 to 15 do
    begin
      P384GenTableSelect(P384GenTables[i], selected384, selected);
      for k := 0 to 5 do
        if selected = 0 then
        begin
          Require(selected384.X[k] = 0, 'P384 infinity X');
          Require(selected384.Y[k] = one384[k], 'P384 infinity Y');
          Require(selected384.Z[k] = 0, 'P384 infinity Z');
        end
        else
        begin
          Require(selected384.X[k] = P384GenTables[i][selected - 1].X[k], 'P384 selection X');
          Require(selected384.Y[k] = P384GenTables[i][selected - 1].Y[k], 'P384 selection Y');
          Require(selected384.Z[k] = one384[k], 'P384 selection Z');
        end;
    end;
    for k := 0 to 3 do
      P384PointDouble(base384, base384);
  end;
  WriteLn('P384 1440 entries; 1536 selections');
end;
