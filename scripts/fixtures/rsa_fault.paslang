program rsafault;
{ The driver of scripts/check_rsa_faults.py (P616): makes the key of
  its five arguments (n, e, d, p, q in hexadecimal), signs one message
  with it three ways (PKCS #1 v1.5, PSS with a salt given, PSS with a
  salt from the kernel) and says what happened, a line each. }
uses pasrsa;

function UnHex(const h: string): string;
var
  i, d, v: Integer;
  c: Char;
  t: string;
begin
  t := h;
  if Odd(Length(t)) then
    t := '0' + t;
  Result := '';
  SetLength(Result, Length(t) div 2);
  v := 0;
  for i := 1 to Length(t) do
  begin
    c := t[i];
    if (c >= '0') and (c <= '9') then d := Ord(c) - 48
    else d := Ord(c) - 87;
    if Odd(i) then v := d shl 4
    else Result[i div 2] := Chr(v or d);
  end;
end;

function HexValue(const H: string): Integer;
var
  i, d: Integer;
begin
  Result := 0;
  for i := 1 to Length(H) do
  begin
    if (H[i] >= '0') and (H[i] <= '9') then d := Ord(H[i]) - 48
    else d := Ord(H[i]) - 87;
    Result := Result * 16 + d;
  end;
end;

var
  k: TRsaPrivateKey;
  err, sig, digest: string;
  made, signed: Boolean;
begin
  if ParamCount <> 5 then
    Halt(81);
  made := RsaPrivateKeyInit(k, UnHex(ParamStr(1)), HexValue(ParamStr(2)), UnHex(ParamStr(3)),
    UnHex(ParamStr(4)), UnHex(ParamStr(5)), err);
  WriteLn('made ', made, ' ', err);
  digest := Sha256('a fault must not leave as a signature');
  signed := RsaSignPkcs1v15(k, RsaSha256, digest, sig);
  WriteLn('signed ', signed);
  WriteLn('sig ', Hex(sig));
  WriteLn('verifies ', RsaKeyVerifyPkcs1v15(k.Pub, RsaSha256, digest, sig));
  signed := RsaSignPssSalt(k, RsaSha256, digest, 'salt', sig);
  WriteLn('pss ', signed, ' ', Length(sig));
  signed := RsaSignPss(k, RsaSha256, digest, RsaPssSaltEqualsHash, sig);
  WriteLn('rnd ', signed, ' ', Length(sig), ' ', RsaKeyVerifyPss(k.Pub, RsaSha256, digest, sig, 32));
end.
