program ctast;
uses pasast,pasparse,paslib;

procedure Text(const S:string);
var I:Integer; C:Char;
begin
  Write('"');
  for I:=1 to Length(S) do
  begin
    C:=S[I];
    if (C='"') or (C='\') then Write('\');
    if Ord(C)<32 then Halt(80);
    Write(C);
  end;
  Write('"');
end;

procedure Expr(E:PExpr);
var I:Integer;
begin
  if E=nil then begin Write('null'); Exit; end;
  Write('{"kind":',Ord(E^.Kind),',"num":',E^.Num,',"name":'); Text(E^.Name);
  Write(',"bin":',Ord(E^.Bin),',"un":',Ord(E^.Un),',"flags":',E^.Flags);
  Write(',"line":',E^.PosLine,',"l":'); Expr(E^.L);
  Write(',"r":'); Expr(E^.R);
  Write(',"args":[');
  for I:=0 to High(E^.Args) do begin if I>0 then Write(','); Expr(E^.Args[I]); end;
  Write(']}');
end;

procedure Stmt(S:PStmt);
var I:Integer;
begin
  if S=nil then begin Write('null'); Exit; end;
  Write('{"kind":',Ord(S^.Kind),',"line":',S^.Line,',"name":'); Text(S^.Name);
  Write(',"down":',Ord(S^.Down),',"e":'); Expr(S^.E);
  Write(',"e2":'); Expr(S^.E2);
  Write(',"dest":'); Expr(S^.Dest);
  Write(',"args":[');
  for I:=0 to High(S^.Args) do begin if I>0 then Write(','); Expr(S^.Args[I]); end;
  Write('],"then":'); Stmt(S^.ThenSt);
  Write(',"else":'); Stmt(S^.ElseSt);
  Write(',"body":'); Stmt(S^.Body);
  Write(',"stmts":[');
  for I:=0 to High(S^.Stmts) do begin if I>0 then Write(','); Stmt(S^.Stmts[I]); end;
  Write(']}');
end;

var Source,N:string;Paths:array of string;Model:TProgram;I,J,Seen:Integer;Arm:Boolean;
begin
  if ParamCount<>4 then Halt(81);
  if not ReadFile(ParamStr(1),Source) then Halt(82);
  Paths:=[ParamStr(2),ParamStr(3)];
  Arm:=ParamStr(4)='arm64';
  Model:=ParseSource(Source,Paths,Arm,0,0);
  Seen:=0;
  Write('[');
  for I:=0 to High(Model.Procs) do
  begin
    N:=LowerCase(Model.Procs[I].Name);
    if (not Model.Procs[I].IsExt) and
      ((N='orderreduce') or (N='ordermontmul') or (N='ordermul') or (N='orderadd') or (N='orderinverse')) then
    begin
      if Seen>0 then Write(',');
      Inc(Seen);
      Write('{"name":'); Text(N);
      Write(',"sym":'); Text(Model.Procs[I].Sym);
      Write(',"params":[');
      for J:=0 to High(Model.Procs[I].Params) do
      begin
        if J>0 then Write(',');
        Write('{"name":'); Text(Model.Procs[I].Params[J].Name);
        Write(',"const":',Ord(Model.Procs[I].Params[J].IsConst),
          ',"byref":',Ord(Model.Procs[I].Params[J].ByRef),'}');
      end;
      Write('],"body":'); Stmt(Model.Procs[I].Body); Write('}');
    end;
  end;
  WriteLn(']');
  if Seen<>5 then Halt(83);
end.
