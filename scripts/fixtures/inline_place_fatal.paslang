program inlinefatal;
uses paslib;
var grid: array[0..3] of Integer;

function Cell(I: Integer): Integer;
begin
  Result := grid[I];
end;

function Half(I: Integer): Integer;
begin
  Result := 7 div I;
end;

function Whole(I: Double): Integer;
begin
  Result := Trunc(I);
end;

function Load(I: ^Integer): Integer;
begin
  Result := I^;
end;

begin
  WriteLn('before');
  if ParamStr(1) = 'index' then
    WriteLn(Cell(6) + 1)
  else if ParamStr(1) = 'divide' then
    WriteLn(Half(0) + 1)
  else if ParamStr(1) = 'range' then
    WriteLn(Whole(1.0e30) + 1)
  else if ParamStr(1) = 'nil' then
    WriteLn(Load(nil) + 1);
end.

