{ An owned builder; edits never change an earlier string snapshot. }
program textbuilding;
uses sysutils;
var builder: TStringBuilder; snapshot: string; settings: TFormatSettings;
begin
  settings := DefaultFormatSettings;
  builder := TStringBuilder.Create(0);
  try
    builder.AddText('hello ').AddRune(128512);
    snapshot := builder.ToString;
    builder.InsertText(0, 'Pascal: ').AddChar(' ').AddInteger(42);
    WriteLn(snapshot);
    WriteLn(builder.ToString);
    builder.Reset;
    builder.AddFormat('%s: %.2f', ['price', 1.25], settings);
    WriteLn(builder.ToString);
  finally builder.Free end;
end.
