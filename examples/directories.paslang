program directories;
uses sysutils;
var cursor: TDirectoryReader; search: TSearchRec; name: string;
  error: TSysError; count, resultCode: Integer;
begin
  if not TryOpenDirectoryAt(CurrentDirectoryHandle, '/proc/self/fd',
    cursor, error) then error.RaiseError;
  try
    count := 0;
    while cursor.Next(name, error) do
    begin
      Inc(count);
      { Name is an owned string, not a pointer into the cursor buffer. }
      if (name = '.') or (name = '..') then Halt(2);
    end;
    error.RaiseError;                         { code zero means EOF }
    WriteLn('owned cursor entries available ', Ord(count > 0));
    if not cursor.CloseDirectory(error) then error.RaiseError; { idempotent }
  finally
    cursor.Free;                             { also closes on early exit }
  end;
  resultCode := FindFirst('/proc/self/exe', faAnyFile or faSymLink, search);
  try
    if resultCode <> 0 then RaiseLastOSError(resultCode);
    WriteLn('Pascal search ', search.Name, ', link ', Ord((search.Attr and faSymLink) <> 0));
  finally
    FindClose(search);
  end;
end.
