{ Strict encodings, explicit byte errors, no implicit BOM or replacement. }
program textencoding;
uses sysutils;
var bytes: TBytes; text: string; error: TEncodingError;
begin
  bytes := TEncoding.Unicode.GetBytes('ñ雪😀');
  WriteLn(TEncoding.Unicode.GetString(bytes), ' ', Length(bytes));
  bytes := TEncoding.Convert(TEncoding.Unicode, TEncoding.UTF8, bytes);
  WriteLn(TEncoding.UTF8.GetString(bytes), ' ', Length(bytes));
  bytes := [192, 175];
  if not TEncoding.UTF8.TryGetString(bytes, text, error) then
    WriteLn('invalid UTF-8 at byte ', error.ByteIndex);
end.
