program paths;
uses sysutils;
begin
  WriteLn(CleanPath('data//./old/../report.txt'));
  WriteLn(JoinPaths(['', 'data', 'old', '..', 'report.txt']));
  WriteLn('Pascal empty base: ', ConcatPaths(['', 'report.txt']));
  WriteLn('local ', Ord(IsLocalPath('data/../report.txt')),
    ', escape ', Ord(IsLocalPath('../report.txt')));
  WriteLn(ExpandFileName('../report.txt', '/srv/application/data'));
  WriteLn(ExtractFilePath('data/report.txt'), ' ', ExtractFileName('data/report.txt'));
  WriteLn(ChangeFileExt('data/report.txt', '.json'));
  WriteLn('dotfile extension: [', ExtractFileExt('.gitignore'), ']');
  WriteLn('backslash is literal: ', ExtractFileName('a\b.txt'));
  WriteLn('UTF-8 pattern ', Ord(MatchesFileName('ni?o', 'ni'#195#177'o')));
end.
