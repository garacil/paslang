program money;
uses sysutils;
var price, tax, total, parsed: Currency; settings: TFormatSettings;
  results: chan of Currency; i: Integer;
procedure Quote(Price: Currency; Results: chan of Currency);
begin Send(Results, Price * 3) end;
begin
  settings := DefaultFormatSettings;
  settings.DecimalSeparator := '.'; settings.ThousandSeparator := ',';
  price := 2.675; tax := 0.20;
  total := price * 3 * (1 + tax);
  WriteLn('total: ', CurrToStr(total, settings));
  WriteLn('invoice: ', FormatCurr('0.00', total, settings));
  WriteLn('round once, ties to even: ', Format('%.2f', [price], settings));
  parsed := Currency.Parse('1.23445', settings);
  WriteLn('decimal input: ', parsed.ToString(settings));
  WriteLn('wire integer: ', parsed.ToScaled);
  parsed := Currency.FromScaled(12345);
  WriteLn('wire round trip: ', CurrToStr(parsed, settings));
  results := MakeChan(4);
  for i := 1 to 4 do pas Quote(price, results);
  total := 0;
  for i := 1 to 4 do total := total + Recv(results);
  WriteLn('four independent quotes: ', CurrToStr(total, settings));
  total := High(Currency);
  try total := total + 0.0001
  except on error: ECurrencyError do WriteLn('checked failure: ', error.Message) end;
end.
