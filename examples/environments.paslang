{ Immutable values for per-child settings, without process-wide mutation. }
program environments;
uses sysutils;
var original, child: TEnvironment; entries: TEnvironmentEntries; value: string;
begin
  original := TEnvironment.Create(['MODE=initial', 'EMPTY=', 'MODE=modern']);
  child := original.WithValue('MODE', 'worker').WithValue('EXTRA', 'ñ value');
  child := child.WithoutValue('EMPTY');
  original.Lookup('MODE', value);
  WriteLn(value, ' ', original.Count);
  child.Lookup('MODE', value);
  WriteLn(value, ' ', child.Count);
  WriteLn(original.Lookup('EMPTY', value), ' ', Length(value));
  WriteLn(child.Lookup('EMPTY', value), ' ', Length(value));
  entries := original.ToArray;
  entries[0] := 'MODE=changed copy';
  original.Lookup('MODE', value);
  WriteLn(value);
  try
    child := TEnvironment.Create(['BROKEN']);
  except on e: EArgumentException do WriteLn(e.Message); end;
end.
