program filemetadata;
uses sysutils;
var info: TFileInfo; error: TSysError;
begin
  if not TryFileInfoAt(CurrentDirectoryHandle, '/proc/self/exe', True,
    info, error) then error.RaiseError;
  WriteLn('running process is regular ', Ord(info.IsRegular));
  WriteLn('nonempty executable ', Ord(info.Has(fiSize) and (info.Size > 0)));
  WriteLn('exact modified timestamp ', Ord(info.Has(fiModified) and
    (info.Modified.Nanoseconds >= 0) and (info.Modified.Nanoseconds < 1000000000)));
  { Creation time is optional. Test Has(fiCreated) before reading it. }
  if not TryFileInfoAt(CurrentDirectoryHandle, '/proc/self/exe', False,
    info, error) then error.RaiseError;
  WriteLn('proc entry itself is a link ', Ord(info.IsSymbolicLink));
end.
