{ Owned resources: exclusive creation, secure permissions, explicit cleanup. }
program temporaryresources;
uses sysutils;
var directory, name: string; handle, count: Integer;
  data: TBytes; error: TSysError;
begin
  if not TryCreateTempDirectoryAt(CurrentDirectoryHandle, '', 'paslang-*',
    directory, error) then error.RaiseError;
  try
    if not TryCreateTempFileAt(CurrentDirectoryHandle, directory, 'key-*.bin',
      name, handle, error) then error.RaiseError;
    try
      try
        data := RandomBytes(32);
        if not TryFileWrite(handle, data, 0, Length(data), count, error) then error.RaiseError;
        WriteLn('random bytes written ', count);
        WriteLn('owned file exists ', FileExists(name));
      finally
        FileClose(handle);
      end;
    finally
      if not DeleteFile(name) then RaiseLastOSError;
    end;
  finally
    if not RemoveDir(directory) then RaiseLastOSError;
  end;
  WriteLn('temporary resources removed');
end.
