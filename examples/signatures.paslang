program signatures;
{ Generate an ECDSA key and sign a prehashed message with raw ES256 components. }
uses pasnist;
var priv, pub, hash, r, s: string;
begin
  priv := NistGenerateKey(NistP256);
  if Length(priv) <> 32 then Halt(1);
  pub := NistPublicKey(NistP256, priv);
  hash := Sha256('header.payload');
  if not NistEcdsaSign(NistP256, priv, hash, r, s) then Halt(1);
  WriteLn('raw signature bytes: ', Length(r + s));
  if not NistEcdsaVerify(NistP256, pub, hash, r, s) then Halt(1);
  WriteLn('signature verified');
end.

