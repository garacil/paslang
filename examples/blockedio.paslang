program blockedio;

uses paslinux;

const Readers = 4;
var
  Pipes: array[0..Readers - 1, 0..1] of Int32;
  Started: chan of Integer;
  Joined: waitgroup;
  I, Token, Completed: Integer;
  Sent: Byte;

procedure Reader(Index: Integer);
var
  Answer: Byte;
  Count: Integer;
begin
  Send(Started, Index);
  repeat
    Count := OsRead(Pipes[Index, 0], Integer(@Answer), 1);
  until Count <> -4;                 { retry an interrupted call }
  if (Count <> 1) or (Answer <> 42) then Halt(2);
  AtomicAdd(@Completed, 1);
  Joined.Done;
end;

begin
  Started := MakeChan();
  for I := 0 to Readers - 1 do
    if OsPipe(Integer(@Pipes[I, 0])) <> 0 then Halt(3);
  Joined.Add(Readers);
  for I := 0 to Readers - 1 do pas Reader(I);
  for I := 0 to Readers - 1 do Token := Recv(Started);
  Sleep(50);                         { readers wait; main still runs }
  GcCollect;
  Sent := 42;
  for I := 0 to Readers - 1 do
    if OsWrite(Pipes[I, 1], Integer(@Sent), 1) <> 1 then Halt(4);
  Joined.Wait;
  for I := 0 to Readers - 1 do
  begin
    if OsClose(Pipes[I, 0]) <> 0 then Halt(5);
    if OsClose(Pipes[I, 1]) <> 0 then Halt(6);
  end;
  WriteLn('completed ', Completed);
end.
