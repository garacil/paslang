{ Two HTTP servers in one program, a public one and an admin one, that
  stop together on SIGTERM (P639). A program waits for its routines when
  main ends, so a second accept loop started with pas kept it alive after
  ServeUntilSignal had returned, and systemd could not restart it. The
  admin server's loop is a background routine: it does not keep the
  program alive, and main's end, after the public server has shut down
  cleanly, ends the program. The ports are the arguments, 0 for any free
  one; they go to standard error, for scripts/check_twoservers.py. }
program twoservers;

uses
  httpserver, passignal, sysutils;

procedure HPublic(Req: THttpRequest; Resp: THttpResponse);
begin
  Resp.ReplyText(200, 'public' + #10);
end;

procedure HHealth(Req: THttpRequest; Resp: THttpResponse);
begin
  Resp.ReplyText(200, 'ok' + #10);
end;

procedure RunAdmin(S: THttpServer);
begin
  S.Serve;
end;

var
  pub, admin: THttpServer;
  pr, ar: THttpRouter;

begin
  pr := THttpRouter.Create;
  pr.Handle('GET', '/', @HPublic);
  ar := THttpRouter.Create;
  ar.Handle('GET', '/health', @HHealth);
  pub := THttpServer.Create(pr);
  admin := THttpServer.Create(ar);
  pub.AccessLog := False;
  admin.AccessLog := False;
  if not pub.ListenTcp('127.0.0.1', StrToIntDef(ParamStr(1), 8080)) or
    not admin.ListenTcp('127.0.0.1', StrToIntDef(ParamStr(2), 8081)) then
  begin
    WriteLn('twoservers: cannot listen');
    Halt(1);
  end;
  WriteLn(ErrOutput, 'ports ', pub.Port, ' ', admin.Port);
  WriteLn('two servers ready');
  { the admin loop does not keep the program alive }
  pas background RunAdmin(admin);
  { the public one serves until SIGTERM or SIGINT, then finishes the
    requests in flight; main's end is the program's }
  WriteLn('stopped on ', SignalName(pub.ServeUntilSignal));
end.
