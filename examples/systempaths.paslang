{ Pure configuration selection: no directory or process-global mutation. }
program systempaths;
uses sysutils;
var environment: TEnvironment; directory: string; error: TSysError;
begin
  environment := TEnvironment.Create(['HOME=/home/user', 'XDG_CONFIG_HOME=relative',
    'XDG_CACHE_HOME=/cache']);
  WriteLn(GetApplicationConfigDirectory(environment, 'reporter'));
  if not TryGetUserCacheDirectory(environment, directory, error) then error.RaiseError;
  WriteLn(directory);
  if not TryGetUserDataDirectory(environment, directory, error) then error.RaiseError;
  WriteLn(directory);
  if not TryGetUserStateDirectory(environment, directory, error) then error.RaiseError;
  WriteLn(directory);
  WriteLn('Linux kernel ', TOSVersion.Name = 'Linux');
  WriteLn('compiled architecture ', TOSVersion.Architecture = GetCompiledArchitecture);
  WriteLn('current kernel check ', TOSVersion.Check(TOSVersion.Major,
    TOSVersion.Minor, TOSVersion.Build));
end.
