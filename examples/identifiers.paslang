{ RFC UUIDs: explicit network bytes, random IDs and time-prefixed IDs. }
program identifiers;
uses sysutils;
var value, random, timed: TGUID; bytes: TBytes;
begin
  value := TGUID.Create('017f22e2-79b0-7cc3-98c4-dc0c0c07398f');
  WriteLn(value.ToString);
  WriteLn(value.UnixMilliseconds);
  bytes := value.ToByteArray;
  WriteLn(IntToHex(bytes[0], 2), IntToHex(bytes[1], 2));
  random := TGUID.NewGuid;
  timed := TGUID.NewTimeGuid;
  WriteLn('generated versions ', random.Version, ' ', timed.Version);
end.
