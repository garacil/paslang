program scopedtypes;

type
  TPacket = record
    const Limit = 4;
    type
      TBytes = array[0..Limit - 1] of Byte;
      generic TCell<T> = record Value: T; end;
      TText = specialize TCell<string>;
  var
    Data: TBytes;
    Note: TText;
    class var Count: Integer;
    constructor Create(Value: Byte; const Text: string);
    class constructor Start;
    class function Capacity: Integer; static;
  end;
  TText = specialize TPacket.TCell<string>;

class constructor TPacket.Start;
begin
  Count := 0;
end;

constructor TPacket.Create(Value: Byte; const Text: string);
begin
  Data[0] := Value;
  Note.Value := Text;
  Count := Count + 1;
end;

class function TPacket.Capacity: Integer;
begin
  Result := Limit;
end;

var
  Packet: TPacket;
  Text: TText;
begin
  Packet := TPacket.Create(42, 'ready');
  Text := Packet.Note;
  Text.Value[1] := 'R';
  WriteLn('packet ', Packet.Data[0], ' ', TPacket.Capacity, ' ', TPacket.Count);
  WriteLn(Packet.Note.Value, ' ', Text.Value);
end.
