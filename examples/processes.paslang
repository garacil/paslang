{ Explicit arguments/environments and real spawn errors, not shell text. }
program processes;
uses sysutils;
var options: TProcessOptions; outcome: TProcessResult; error: TSysError;
begin
  options := TProcessOptions.Defaults;
  options.InheritEnvironment := False;
  options.Environment := TEnvironment.Create(['MESSAGE=modern Pascal']);
  if not TryExecuteProcess('/bin/sh', ['-c', 'printf "%s: %s\n" "$MESSAGE" "$1"',
    'example', 'a b "quoted"'], options, outcome, error) then error.RaiseError;
  WriteLn('success ', outcome.Succeeded);
  WriteLn('real exit ', ExecuteProcess('/bin/sh', ['-c', 'exit 127']));
  if not TryExecuteProcess('/dev/null', [], options, outcome, error) then
    WriteLn(error.Operation, ': ', error.Code);
end.
