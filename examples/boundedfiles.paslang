program boundedfiles;
uses sysutils;
var handle, count: Integer; buffer, contents: TBytes; error: TSysError;
begin
  handle := FileOpen('/dev/zero', fmOpenRead);
  if handle < 0 then RaiseLastOSError;
  try
    buffer := BytesOf('........');
    if not TryFileRead(handle, buffer, 2, 4, count, error) then error.RaiseError;
    WriteLn('bounded read ', count, ', untouched edges ', Char(buffer[0]), Char(buffer[7]));
    if not TryFileReadAt(handle, buffer, 0, 4, 100, count, error) then error.RaiseError;
    WriteLn('positional read ', count);
  finally
    FileClose(handle);
  end;
  handle := FileOpen('/dev/null', fmOpenWrite);
  if handle < 0 then RaiseLastOSError;
  try
    contents := BytesOf('Pascal');
    WriteLn('bounded write ', FileWrite(handle, contents, Length(contents)));
  finally
    FileClose(handle);
  end;
  if not TryReadFileAt(CurrentDirectoryHandle, '/proc/sys/kernel/pid_max',
    8192, contents, error) then error.RaiseError;
  WriteLn('proc content available ', Ord(Length(contents) > 0));
end.
