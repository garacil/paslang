{ Byte-indexed string helpers and explicit numeric format settings. }
program valuehelpers;
uses sysutils;
var text: string; parts: TStringArray; number: Integer;
  value: Double; settings: TFormatSettings;
begin
  text := 'ñ::雪::';
  parts := text.SplitText('::');
  WriteLn(string.JoinText('/', parts));
  WriteLn(text.Substring(4, 3), ' at ', text.IndexOf('雪'));
  number := Integer.Parse('42');
  WriteLn(number.ToString, ' ', number.ToHexString(4));
  settings := DefaultFormatSettings;
  settings.DecimalSeparator := ',';
  value := Double.Parse('1,25', settings);
  WriteLn(value.ToString(settings));
end.
