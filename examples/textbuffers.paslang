{ Typed C-string buffers: a checked capacity includes the NUL byte. }
program textbuffers;
uses sysutils;
var bytes: TBytes; count: Integer; settings: TFormatSettings;
begin
  SetLength(bytes, 32);
  count := StrPCopy(bytes, 0, Length(bytes), 'hello');
  count := StrCat(bytes, CStringOf(' ñ'));
  WriteLn(StrPas(bytes), ' ', count);
  settings := DefaultFormatSettings;
  count := StrFmt(bytes, 0, Length(bytes), '%.2f', [1.25], settings);
  WriteLn(StrPas(bytes), ' ', count);
  try
    count := StrPCopy(bytes, 0, 3, 'too long');
  except
    on EArgumentOutOfRangeException do WriteLn('unchanged: ', StrPas(bytes));
  end;
end.
