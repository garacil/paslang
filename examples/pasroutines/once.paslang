{ once runs its block one time. A later once on the same variable skips
  the block, and a routine that arrives while the block is running waits
  for it to finish. }
program onceonly;

var
  init: once;
  n: Integer;

procedure Fill;
begin
  n := n + 1;
end;

begin
  once init do
    Fill;
  once init do               { skipped: the block already ran }
    Fill;
  if init.Done then
    WriteLn(n)               { 1 }
  else
    WriteLn('not done');
end.
