{ The main routine is G 1. Yield returns it to the run queue.
  NumGoroutine is how many routines are alive. Nothing to import:
  these names are part of the language. }
program who;

begin
  WriteLn(Goid);             { 1 }
  WriteLn(NumGoroutine);     { 1 }
  Yield;
  WriteLn(NumGoroutine);     { 1 }
end.
