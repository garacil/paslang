{ Readers share an rwmutex; a writer takes it alone. Each reader copies
  the value it saw under a shared lock and adds it under an exclusive
  one. }
program readwrite;

var
  wg: waitgroup;
  rw: rwmutex;
  n, seen, i: Integer;

procedure Reader(K: Integer);
var
  v: Integer;
begin
  lock rw read do            { shared: other readers may hold it too }
    v := n;
  lock rw do                 { exclusive }
    seen := seen + v;
  wg.Done;
end;

begin
  lock rw do
    n := 4;
  wg.Add(3);
  for i := 1 to 3 do
    pas Reader(i);
  wg.Wait;
  WriteLn(seen);             { 12 }
end.
