{ WriteLn from several routines. Each line is published whole; the
  order of the four lines is up to the scheduler. The wait group returns
  after the four lines, then the main routine prints done. }
program lines;

var
  wg: waitgroup;

procedure W(K: Integer);
begin
  if K = 1 then
    WriteLn('one')
  else if K = 2 then
    WriteLn('two')
  else if K = 3 then
    WriteLn('three')
  else
    WriteLn('four');
  wg.Done;
end;

begin
  wg.Add(4);                 { four routines will call Done }
  pas W(1);
  pas W(2);
  pas W(3);
  pas W(4);
  wg.Wait;                   { parks until the count is back to zero }
  WriteLn('done');
end.
