{ Two routines wait on a condition variable until the main routine
  broadcasts. cond, mutex and waitgroup are language types: no uses
  clause and no Create; the zero value is ready. }
program condvar;

var
  wg: waitgroup;
  mu: mutex;
  ready: cond;
  arrived, go, n: Integer;

procedure Waiter(K: Integer);
begin
  mu.Lock;
  arrived := arrived + 1;
  while go = 0 do
    ready.Wait(mu);          { releases mu while parked, takes it back after }
  n := n + K;
  mu.Unlock;
  wg.Done;
end;

begin
  wg.Add(2);
  pas Waiter(1);
  pas Waiter(2);
  mu.Lock;
  while arrived < 2 do       { let both routines reach the wait }
  begin
    mu.Unlock;
    Yield;
    mu.Lock;
  end;
  go := 1;
  ready.Broadcast;           { wake every waiter }
  mu.Unlock;
  wg.Wait;
  WriteLn(n);                { 3 }
end.
