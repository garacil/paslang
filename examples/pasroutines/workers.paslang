{ Four routines add to one counter. lock mu do keeps each add whole and
  releases the mutex at the end of the statement. The wait group returns
  when every routine has called Done. }
program workers;

var
  wg: waitgroup;
  mu: mutex;
  n, i: Integer;

procedure Worker(K: Integer);
var
  j: Integer;
begin
  for j := 1 to 25 do
    lock mu do
      n := n + K;
  wg.Done;
end;

begin
  wg.Add(4);
  for i := 1 to 4 do
    pas Worker(i);
  wg.Wait;
  WriteLn(n);                { 250 }
end.
