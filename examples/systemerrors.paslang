program systemerrors;
uses sysutils;
var
  joined: waitgroup;
  completed: Integer;
  error: TSysError;

procedure Worker(Code: Integer);
begin
  SetLastOSError(Code);                { belongs to this G, not its M }
  Yield;
  try
    RaiseLastOSError;
  except
    on E: EOSError do
      if E.ErrorCode <> Code then Halt(2);
  end;
  AtomicAdd(@completed, 1);
  joined.Done;
end;

begin
  error.Code := 2;
  error.Operation := 'open';
  error.Path := 'report.txt';
  WriteLn(error.Message);
  joined.Add(2);
  pas Worker(13);
  pas Worker(9);
  joined.Wait;
  WriteLn('independent errors ', completed, ', main ', GetLastOSError);
end.
