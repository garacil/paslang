    $A7655D1D21039120, $9071EE70F0F1DE6A,
    $D13EB46469447568, $B48E6A0D2D2E5604);
  Pow10U: array[0..18] of Int64 = (1, 10, 100, 1000, 10000, 100000, 1000000, 10000000,
    100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000,
    100000000000000, 1000000000000000, 10000000000000000, 100000000000000000,
    1000000000000000000);

type
  { the scaling constants of an e, p pair (uscale.go's scaler) }
  TScaler = record
    PmHi, PmLo, S: Int64;
  end;

{ A below B as 64-bit unsigned numbers. }
function ULt(A, B: Int64): Boolean;
begin
  Result := (A xor Low(Int64)) < (B xor Low(Int64));
end;

{ floor(x * log10 2) and floor(x * log2 10) (uscale.go's log10Pow2,
  log2Pow10) }
function Log10Pow2(X: Int64): Int64;
begin
  Result := (X * 78913) sar 18;
end;

function Log2Pow10(X: Int64): Int64;
begin
  Result := (X * 108853) sar 15;
end;

{ An unrounded value (uscale.go): the value times 4, its low bit set
  when anything below was lost. }
function UFloor(U: Int64): Int64;
begin
  Result := U shr 2;
end;

function URound(U: Int64): Int64;
begin
  Result := (U + 1 + ((U shr 2) and 1)) shr 2;
end;

function UCeil(U: Int64): Int64;
begin
  Result := (U + 3) shr 2;
end;

{ U divided by 10 as an unsigned number, the lost part in the low bit. }
function UDiv10(U: Int64): Int64;
var
  q: Int64;
begin
  q := (U shr 1) div 5;
  Result := q or (U and 1);
  if U - q * 10 <> 0 then
    Result := Result or 1;
end;

{ the least unrounded value that rounds to X }
function UnMin(X: Int64): Int64;
begin
  Result := (X shl 2) - 2;
end;

procedure Prescale(var Pre: TScaler; E, P, Lp: Int64);
begin
  Pre.PmHi := Pow10Tab[2 * (P - Pow10Min)];
  Pre.PmLo := Pow10Tab[2 * (P - Pow10Min) + 1];
  Pre.S := -(E + Lp + 3);
end;

{ unround(X * 2^e * 10^p) for the Pre of e, p; X left-justified. }
function UScale(X: Int64; const Pre: TScaler): Int64;
var
  hi, mid, mid2, s: Int64;
begin
  hi := MulHi(X, Pre.PmHi);
  mid := X * Pre.PmHi;
  s := Pre.S and 63;
  if ((hi shr s) shl s) <> hi then
  begin
    Result := (hi shr s) or 1;
    Exit;
  end;
  mid2 := MulHi(X, Pre.PmLo);
  if ULt(mid, mid2) then
    hi := hi - 1;
  Result := hi shr s;
  if ULt(1, mid - mid2) then
    Result := Result or 1;
end;

{ The N-digit (18 at most) decimal form of M * 2^E as D * 10^P
  (fixedWidthFloat); with Decs >= 0, the 'f' form: N an estimate, digits
  dropped until Decs are left after the point. }
procedure FixedWidth(M, E, N, Decs: Int64; out D, P: Int64);
var
  pre: TScaler;
  u, q: Int64;
begin
  q := N - 1 - Log10Pow2(E + 63);
  Prescale(pre, E, q, Log2Pow10(q));
  u := UScale(M, pre);
  if not ULt(u, UnMin(Pow10U[N])) then
  begin
    u := UDiv10(u);
    q := q - 1;
  end;
  if Decs >= 0 then
    while q > Decs do
    begin
      u := UDiv10(u);
      q := q - 1;
    end;
  D := URound(u);
  P := -q;
end;

{ floor(log10(3/4 * 2^e)) (skewed) }
function Skewed(E: Int64): Int64;
begin
  Result := (E * 631305 - 261663) sar 21;
end;

{ The fewest digits of M * 2^E that read back as the same real
  (shortFloat) of MantBits bits (52 a Double, 23 a Single): D * 10^P. }
procedure ShortFloat(M, E: Int64; MantBits, MinExp: Integer; out D, P: Int64);
var
  z, oddm, mn, mx, dmin, dmax, dd, q: Int64;
  pre: TScaler;
begin
  z := 63 - MantBits;
  if (M = Low(Int64)) and (E > MinExp) then
  begin
    q := -Skewed(E + z);
    mn := M - (Int64(1) shl (z - 2));
    mx := M + (Int64(1) shl (z - 1));
  end
  else if E >= MinExp then
  begin
    q := -Log10Pow2(E + z);
    mn := M - (Int64(1) shl (z - 1));
    mx := M + (Int64(1) shl (z - 1));
  end
  else
  begin
    z := z + (MinExp - E);
    q := -Log10Pow2(E + z);
    mn := M - (Int64(1) shl (z - 1));
    mx := M + (Int64(1) shl (z - 1));
  end;
  oddm := (M shr z) and 1;
  Prescale(pre, E, q, Log2Pow10(q));
  dmin := UCeil(UScale(mn, pre) + oddm);
  dmax := UFloor(UScale(mx, pre) - oddm);
  dd := dmax div 10;
  if not ULt(dd * 10, dmin) then
  begin
    D := dd;
    P := -(q - 1);
    Exit;
  end;
  dd := dmin;
  if ULt(dd, dmax) then
    dd := URound(UScale(M, pre));
  D := dd;
  P := -q;
end;

{ The digits of D (not 0) with its trailing zeros gone, and the place of
  the point for D * 10^P (setDigits, numDigits): the count of digits from
  the bits, the zeros taken off the number, one string made. }
procedure SetDigits(Dv, P: Int64; out S: string; out Dp: Integer);
var
  nd: Integer;
begin
  nd := Log10Pow2(64 - LeadingZeros(Dv));
  if Dv >= Pow10U[nd] then
    nd := nd + 1;
  Dp := nd + P;
  while Dv mod 10 = 0 do
    Dv := Dv div 10;
  S := PasFmtInt(Dv, 0);
end;

{ A real's parts: its sign, its mantissa left-justified in 64 bits and
  the power of 2 of that mantissa; Kind 0 a number, 1 a zero, 2 an
  infinity, 3 a NaN. Of a Single when IsSingle. }
procedure SplitReal(X: Double; IsSingle: Boolean; out Neg: Boolean; out M, E: Int64;
  out Kind: Integer);
var
  bits, ex, mant, s: Int64;
  sg: Single;
  sb: Int32;
  mbits, bias, emax: Integer;
begin
  if IsSingle then
  begin
    sg := Single(X);
    Move(sg, sb, 4);
    bits := Int64(sb) and 4294967295;
    Neg := (bits shr 31) <> 0;
    ex := (bits shr 23) and 255;
    mant := bits and 8388607;
    mbits := 23;
    bias := -127;
    emax := 255;
  end
  else
  begin
    bits := 0;
    Move(X, bits, 8);
    Neg := bits < 0;
    ex := (bits shr 52) and 2047;
    mant := bits and 4503599627370495;
    mbits := 52;
    bias := -1023;
    emax := 2047;
  end;
  if ex = emax then
  begin
    if mant <> 0 then
      Kind := 3
    else
      Kind := 2;
    M := 0;
    E := 0;
    Exit;
  end;
  if ex = 0 then
    ex := 1
  else
    mant := mant or (Int64(1) shl mbits);
  if mant = 0 then
  begin
    Kind := 1;
    M := 0;
    E := 0;
    Exit;
  end;
  Kind := 0;
  ex := ex + bias;
  s := 64 - (64 - LeadingZeros(mant));
  M := mant shl s;
  E := ex - s - mbits;
end;

{ Every significant digit of the magnitude of X (finite, not 0) exactly:
  X = 0.D * 10^Dp; from pasfmt's exact expansion, Go's bignum case. }
procedure ExactDigits(X: Double; out D: string; out Dp: Integer);
var
  bits, e2: Int64;
  t: string;
  p, first, last: Integer;
begin
  bits := 0;
  Move(X, bits, 8);
  bits := bits and High(Int64);
  Move(bits, X, 8);
  e2 := (bits shr 52) and 2047;
  if e2 = 0 then
    e2 := 1;
  e2 := e2 - 1075;
  if e2 < 0 then
    t := PasFmtReal(X, 0, -e2)
  else
    t := PasFmtReal(X, 0, 0);
  p := Pos('.', t);
  if p = 0 then
    p := Length(t) + 1
  else
    Delete(t, p, 1);
  first := 1;
  while (first <= Length(t)) and (t[first] = '0') do
    first := first + 1;
  last := Length(t);
  while (last > first) and (t[last] = '0') do
    last := last - 1;
  D := Copy(t, first, last - first + 1);
  Dp := p - first;
end;

{ Exact digits D, the point after Dp of them, rounded to N digits, a tie
  to even as Go's decimal.Round: D keeps at most N digits, its trailing
  zeros gone; a carry out of the first digit a 1 and Dp one more; N 0
  rounds to the left of every digit, and below 0 further left, where
  every value rounds to 0 (D ''). }
procedure RoundDigits(var D: string; var Dp: Integer; N: Integer);
var
  up: Boolean;
  k: Integer;
begin
  if N < 0 then
  begin
    D := '';
    Exit;
  end;
  if N >= Length(D) then
    Exit;
  if (D[N + 1] = '5') and (N + 1 = Length(D)) then
    up := (N > 0) and (((Ord(D[N]) - 48) and 1) <> 0)
  else
    up := D[N + 1] >= '5';
  D := Copy(D, 1, N);
  if up then
  begin
    k := N;
    while (k >= 1) and (D[k] = '9') do
      k := k - 1;
    if k = 0 then
    begin
      D := '1';
      Dp := Dp + 1;
    end
    else
    begin
      D := Copy(D, 1, k - 1) + Chr(Ord(D[k]) + 1);
    end;
  end
  else
  begin
    k := Length(D);
    while (k > 0) and (D[k] = '0') do
      k := k - 1;
    D := Copy(D, 1, k);
  end;
end;

{ The fewest digits that read back as X, a Double, or as the Single it
  holds when IsSingle: X = 0.D * 10^Dp (X finite, not 0). }
procedure ShortestDigits(X: Double; IsSingle: Boolean; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p: Int64;
  kind: Integer;
begin
  SplitReal(X, IsSingle, neg, m, e, kind);
  if IsSingle then
    ShortFloat(m, e, 23, -189, dv, p)
  else
    ShortFloat(m, e, 52, -1085, dv, p);
  SetDigits(dv, p, D, Dp);
end;

{ N significant digits of X (finite, not 0) rounded once, a tie to even:
  at most N digits in D, their trailing zeros gone; X = 0.D * 10^Dp. N 0
  or below rounds as RoundDigits does. }
procedure SigDigits(X: Double; N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p: Int64;
  kind: Integer;
begin
  if (N >= 1) and (N <= 18) then
  begin
    SplitReal(X, False, neg, m, e, kind);
    FixedWidth(m, e, N, -1, dv, p);
    SetDigits(dv, p, D, Dp);
    Exit;
  end;
  ExactDigits(X, D, Dp);
  RoundDigits(D, Dp, N);
end;

{ The digits of X (finite, not 0) rounded once at Decs places after the
  point, a tie to even ('f'; Decs below 0 a place before the point): D
  may be '' (it rounds to 0), its trailing zeros gone; X = 0.D * 10^Dp. }
procedure FracDigits(X: Double; Decs: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p, ex, digits, bits: Int64;
  kind: Integer;
begin
  bits := 0;
  Move(X, bits, 8);
  ex := (bits shr 52) and 2047;
  if ex = 0 then
    ex := 1;
  ex := ex - 1023;
  if ex >= 0 then
    digits := 1 + Log10Pow2(1 + ex) + Decs
  else
    digits := 1 + Decs - Log10Pow2(-ex);
  if (digits <= 18) and (Decs >= 0) then
  begin
    D := '';
    Dp := 0;
    if digits <= 0 then
      Exit;
    SplitReal(X, False, neg, m, e, kind);
    FixedWidth(m, e, digits, Decs, dv, p);
    if dv <> 0 then
      SetDigits(dv, p, D, Dp);
    Exit;
  end;
  ExactDigits(X, D, Dp);
  RoundDigits(D, Dp, Dp + Decs);
  if D = '' then
    Dp := 0;
end;

{ ---- the text of a real (P129) ---- }

{ Free Pascal's forms and names (sysstr.inc, fmtflt.inc), Go's digits:
  correctly rounded once, a tie to even, and the fewest that read back
  when no precision is asked (the manual's §19). NaN, +Inf and -Inf as
  paslang and Go write them. }

function SpecialText(Kind: Integer; Neg: Boolean): string;
begin
  if Kind = 3 then
    Result := 'NaN'
  else if Neg then
    Result := '-Inf'
  else
    Result := '+Inf';
end;

{ Each form below works out its length first and makes its string once,
  filled through a pointer with Move and FillChar: a string built with +
  makes one for every piece, and FloatToStr took four times Go's time.

  D (trailing zeros gone) with the point after Dp of its digits, as a
  number with Decs places ('' for none); zeros where D has no digit. }
function FixedOf(const D: string; Dp, Decs: Integer; Sep: Char): string;
var
  nd, ip, lz, mid, tz, off, n, k: Integer;
  p, q: PChar;
begin
  nd := Length(D);
  if (Dp > 0) and (nd > 0) then
    ip := Dp
  else
    ip := 1;
  lz := 0;
  mid := 0;
  tz := 0;
  off := 0;
  n := ip;
  if Decs > 0 then
  begin
    if nd = 0 then
      lz := Decs
    else
    begin
      lz := -Dp;
      if lz < 0 then
        lz := 0;
      if lz > Decs then
        lz := Decs;
    end;
    off := Dp + lz;
    mid := nd - off;
    if mid > Decs - lz then
      mid := Decs - lz;
    if mid < 0 then
      mid := 0;
    tz := Decs - lz - mid;
    n := ip + 1 + Decs;
  end;
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  q := PChar(D);
  if (Dp > 0) and (nd > 0) then
  begin
    if Dp <= nd then
      Move(q^, p^, Dp)
    else
    begin
      Move(q^, p^, nd);
      FillChar(p[nd], Dp - nd, 48);
    end;
  end
  else
    p[0] := '0';
  if Decs > 0 then
  begin
    k := ip;
    p[k] := Sep;
    k := k + 1;
    if lz > 0 then
      FillChar(p[k], lz, 48);
    k := k + lz;
    if mid > 0 then
      Move(q[off], p[k], mid);
    k := k + mid;
    if tz > 0 then
      FillChar(p[k], tz, 48);
  end;
end;

{ The integer part of a fixed number with a thousands separator every
  three digits, as ffNumber and ffCurrency write it. }
function Grouped(const S: string; DecSep, ThouSep: Char): string;
var
  p, k: Integer;
begin
  Result := S;
  if ThouSep = #0 then
    Exit;
  p := Pos(DecSep, Result);
  if p = 0 then
    p := Length(Result) + 1;
  k := p - 3;
  while k > 1 do
  begin
    Insert(ThouSep, Result, k);
    k := k - 3;
  end;
end;

{ ffGeneral: the digits with the point where it goes while the exponent
  is above -6 and below Thr, else d.dddEx with no sign for a positive
  exponent and no leading zeros, as Free Pascal writes it. }
function GeneralOf(Neg: Boolean; const D: string; Dp, Thr: Integer; Sep: Char): string;
var
  ex, nd, n, k, j, e, ed: Integer;
  plain: Boolean;
  p, q: PChar;
begin
  nd := Length(D);
  ex := Dp - 1;
  plain := (ex > -6) and (ex < Thr);
  e := Abs(ex);
  ed := 1;
  if plain then
  begin
    if Dp <= 0 then
      n := 2 - Dp + nd
    else if Dp >= nd then
      n := Dp
    else
      n := nd + 1;
  end
  else
  begin
    if e >= 10 then
      ed := 2;
    if e >= 100 then
      ed := 3;
    if e >= 1000 then
      ed := 4;
    n := nd + 1 + ed + Ord(ex < 0);
    if nd > 1 then
      n := n + 1;
  end;
  n := n + Ord(Neg);
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  q := PChar(D);
  k := 0;
  if Neg then
  begin
    p[0] := '-';
    k := 1;
  end;
  if plain then
  begin
    if Dp <= 0 then
    begin
      p[k] := '0';
      p[k + 1] := Sep;
      k := k + 2;
      if Dp < 0 then
        FillChar(p[k], -Dp, 48);
      Move(q^, p[k - Dp], nd);
    end
    else if Dp >= nd then
    begin
      Move(q^, p[k], nd);
      if Dp > nd then
        FillChar(p[k + nd], Dp - nd, 48);
    end
    else
    begin
      Move(q^, p[k], Dp);
      p[k + Dp] := Sep;
      Move(q[Dp], p[k + Dp + 1], nd - Dp);
    end;
  end
  else
  begin
    p[k] := q[0];
    k := k + 1;
    if nd > 1 then
    begin
      p[k] := Sep;
      Move(q[1], p[k + 1], nd - 1);
      k := k + nd;
    end;
    p[k] := 'E';
    k := k + 1;
    if ex < 0 then
    begin
      p[k] := '-';
      k := k + 1;
    end;
    j := k + ed - 1;
    while j >= k do
    begin
      p[j] := Chr(48 + e mod 10);
      e := e div 10;
      j := j - 1;
    end;
  end;
end;

{ ffExponent: one digit, the point, Prec - 1 more (the digits D has when
  Prec is 0: the fewest), E, the exponent's sign and at least ExpDigits of
  its digits (4 at most); with ExpDigits 0 or below an exponent 0 is not
  written, E and sign too, as Free Pascal drops it. }
function ExponentOf(Neg: Boolean; const D: string; Dp, Prec, ExpDigits: Integer; Sep: Char): string;
var
  nd, ex, fr, have, e, ed, n, k, j: Integer;
  withExp: Boolean;
  p, q: PChar;
begin
  nd := Length(D);
  if nd = 0 then
    ex := 0
  else
    ex := Dp - 1;
  if Prec <= 0 then
    fr := nd - 1
  else
    fr := Prec - 1;
  if fr < 0 then
    fr := 0;
  if ExpDigits > 4 then
    ExpDigits := 4;
  withExp := (ExpDigits > 0) or (ex <> 0);
  e := Abs(ex);
  ed := 1;
  if e >= 10 then
    ed := 2;
  if e >= 100 then
    ed := 3;
  if e >= 1000 then
    ed := 4;
  if ed < ExpDigits then
    ed := ExpDigits;
  n := Ord(Neg) + 1;
  if fr > 0 then
    n := n + 1 + fr;
  if withExp then
    n := n + 2 + ed;
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  q := PChar(D);
  k := 0;
  if Neg then
  begin
    p[0] := '-';
    k := 1;
  end;
  if nd = 0 then
    p[k] := '0'
  else
    p[k] := q[0];
  k := k + 1;
  if fr > 0 then
  begin
    p[k] := Sep;
    k := k + 1;
    have := nd - 1;
    if have > fr then
      have := fr;
    if have < 0 then
      have := 0;
    if have > 0 then
      Move(q[1], p[k], have);
    if fr > have then
      FillChar(p[k + have], fr - have, 48);
    k := k + fr;
  end;
  if withExp then
  begin
    p[k] := 'E';
    if ex < 0 then
      p[k + 1] := '-'
    else
      p[k + 1] := '+';
    k := k + 2;
    j := k + ed - 1;
    while j >= k do
    begin
      p[j] := Chr(48 + e mod 10);
      e := e div 10;
      j := j - 1;
    end;
  end;
end;

{ The money forms (sysstr.inc's FloatToStrFIntl): CurrencyFormat for a
  positive amount, NegCurrFormat for a negative one; a format out of
  their range writes the amount alone, with its sign. }
function CurrencyOf(Neg: Boolean; const S: string; const FS: TFormatSettings): string;
var
  c: string;
begin
  c := FS.CurrencyString;
  if not Neg then
    case FS.CurrencyFormat of
      0: Result := c + S;
      1: Result := S + c;
      2: Result := c + ' ' + S;
      3: Result := S + ' ' + c;
    else
      Result := S;
    end
  else
    case FS.NegCurrFormat of
      0: Result := '(' + c + S + ')';
      1: Result := '-' + c + S;
      2: Result := c + '-' + S;
      3: Result := c + S + '-';
      4: Result := '(' + S + c + ')';
      5: Result := '-' + S + c;
      6: Result := S + '-' + c;
      7: Result := S + c + '-';
      8: Result := '-' + S + ' ' + c;
      9: Result := '-' + c + ' ' + S;
      10: Result := S + ' ' + c + '-';
      11: Result := c + ' ' + S + '-';
      12: Result := c + ' ' + '-' + S;
      13: Result := S + '-' + ' ' + c;
      14: Result := '(' + c + ' ' + S + ')';
      15: Result := '(' + S + ' ' + c + ')';
    else
      Result := '-' + S;
    end;
end;

{ The digits of an integer as a real's: D without trailing zeros, Dp
  its length. }
procedure IntDigits(V: Int64; out D: string; out Dp: Integer; out Neg: Boolean);
var
  k: Integer;
begin
  Neg := V < 0;
  D := UIntToStr(Abs(V));
  if V = Low(Int64) then
    D := '9223372036854775808';
  Dp := Length(D);
  k := Length(D);
  while (k > 0) and (D[k] = '0') do
    k := k - 1;
  D := Copy(D, 1, k);
end;

{ A Quad's parts: its sign and Kind as SplitReal's; its two words. }
procedure SplitQuad(Q: Quad; out Neg: Boolean; out Lo, Hi: Int64; out Kind: Integer);
var
  w: array[0..1] of Int64;
  ex: Int64;
begin
  Move(Q, w, 16);
  Lo := w[0];
  Hi := w[1];
  Neg := Hi < 0;
  ex := (Hi shr 48) and 32767;
  if ex = 32767 then
  begin
    if ((Hi and 281474976710655) <> 0) or (Lo <> 0) then
      Kind := 3
    else
      Kind := 2;
  end
  else if (ex = 0) and ((Hi and 281474976710655) = 0) and (Lo = 0) then
    Kind := 1
  else
    Kind := 0;
end;

type
  { a value the formats write: a Double, a Single's, an integer's, a
    Quad's }
  TRealSource = (rsDouble, rsSingle, rsInt, rsQuad, rsCurrency);
  TRealArg = record
    Src: TRealSource;
    X: Double;
    I: Int64;
    Q: Quad;
  end;

{ A value to write, in A, every field set (a record a function returned,
  or Default made, goes through the heap at every call). }
procedure ArgDouble(out A: TRealArg; X: Double);
begin
  A.Src := rsDouble;
  A.X := X;
  A.I := 0;
  A.Q := 0;
end;

procedure ArgSingle(out A: TRealArg; X: Single);
begin
  A.Src := rsSingle;
  A.X := X;
  A.I := 0;
  A.Q := 0;
end;

procedure ArgInt(out A: TRealArg; V: Int64);
begin
  A.Src := rsInt;
  A.X := 0;
  A.I := V;
  A.Q := 0;
end;

procedure ArgQuad(out A: TRealArg; Q: Quad);
begin
  A.Src := rsQuad;
  A.X := 0;
  A.I := 0;
  A.Q := Q;
end;

procedure ArgCurrency(out A: TRealArg; Value: Currency);
begin
  A.Src := rsCurrency;
  A.X := 0;
  A.I := CurrencyToScaled(Value);
  A.Q := 0;
end;

{ A value's sign and kind as SplitReal's: 0 a number, 1 a zero, 2 an
  infinity, 3 a NaN. }
procedure ArgKind(const A: TRealArg; out Neg: Boolean; out Kind: Integer);
var
  m, e, lo, hi: Int64;
begin
  case A.Src of
    rsInt, rsCurrency:
      begin
        Neg := A.I < 0;
        if A.I = 0 then
          Kind := 1
        else
          Kind := 0;
      end;
    rsQuad:
      SplitQuad(A.Q, Neg, lo, hi, Kind);
  else
    SplitReal(A.X, A.Src = rsSingle, Neg, m, e, Kind);
  end;
end;

{ A Quad's digits in Mode, as pasfmt's PasQuadDigits writes them. }
procedure QuadDigits(const A: TRealArg; Mode, N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  lo, hi, p: Int64;
  kind: Integer;
begin
  SplitQuad(A.Q, neg, lo, hi, kind);
  D := PasQuadDigits(lo, hi, Mode, N, p);
  Dp := p;
end;

{ The fewest digits that read back as the value in its own type; an
  integer's are all of them. }
procedure ArgShortest(const A: TRealArg; out D: string; out Dp: Integer);
var
  neg: Boolean;
  point: Int64;
begin
  case A.Src of
    rsDouble:
      ShortestDigits(A.X, False, D, Dp);
    rsSingle:
      ShortestDigits(A.X, True, D, Dp);
    rsQuad:
      QuadDigits(A, 0, 0, D, Dp);
    rsCurrency:
      begin D := PasCurrencyDigits(A.I, 0, 0, point); Dp := point end;
  else
    IntDigits(A.I, D, Dp, neg);
  end;
end;

{ N significant digits of the value, rounded once, a tie to even (a
  Single's are its Double's: the same value). }
procedure ArgSig(const A: TRealArg; N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  point: Int64;
begin
  case A.Src of
    rsDouble, rsSingle:
      SigDigits(A.X, N, D, Dp);
    rsQuad:
      QuadDigits(A, 1, N, D, Dp);
    rsCurrency:
      begin D := PasCurrencyDigits(A.I, 1, N, point); Dp := point end;
  else
    begin
      IntDigits(A.I, D, Dp, neg);
      RoundDigits(D, Dp, N);
    end;
  end;
end;

{ The value's digits rounded once at Decs places after the point, a tie
  to even; D '' and Dp 0 when it rounds to 0. }
procedure ArgFrac(const A: TRealArg; Decs: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  point: Int64;
begin
  case A.Src of
    rsDouble, rsSingle:
      FracDigits(A.X, Decs, D, Dp);
    rsQuad:
      QuadDigits(A, 2, Decs, D, Dp);
    rsCurrency:
      begin D := PasCurrencyDigits(A.I, 2, Decs, point); Dp := point end;
  else
    begin
      IntDigits(A.I, D, Dp, neg);
      RoundDigits(D, Dp, Dp + Decs);
      if D = '' then
        Dp := 0;
    end;
  end;
end;

{ One real in Free Pascal's formats: the digits rounded once, a tie to
  even (Go's), Precision 0 or below the fewest that read back; a Single's
  and a Quad's as their own type's, an integer's exact. No count of
  digits is capped: what is asked is written, as Go does. }
function RealText(const A: TRealArg; Fmt: TFloatFormat; Precision, Digits: Integer;
  const FS: TFormatSettings): string;
var
  neg: Boolean;
  kind, dp, thr: Integer;
  d, s: string;
begin
  ArgKind(A, neg, kind);
  if kind >= 2 then
  begin
    Result := SpecialText(kind, neg);
    Exit;
  end;
  d := '';
  dp := 0;
  case Fmt of
    ffGeneral, ffExponent:
      begin
        if kind = 0 then
        begin
          if Precision <= 0 then
            ArgShortest(A, d, dp)
          else
            ArgSig(A, Precision, d, dp);
        end;
        if Fmt = ffGeneral then
        begin
          if d = '' then
            Result := '0'
          else
          begin
            thr := Precision;
            if thr <= 0 then
              thr := 15;
            Result := GeneralOf(neg, d, dp, thr, FS.DecimalSeparator);
          end;
        end
        else
          Result := ExponentOf(neg and (d <> ''), d, dp, Precision, Digits, FS.DecimalSeparator);
      end;
  else
    begin
      if Digits < 0 then
      begin
        if Fmt = ffCurrency then
          Digits := FS.CurrencyDecimals
        else
          Digits := 2;
      end;
      if kind = 0 then
        ArgFrac(A, Digits, d, dp);
      neg := neg and (d <> '');
      s := FixedOf(d, dp, Digits, FS.DecimalSeparator);
      if Fmt <> ffFixed then
        s := Grouped(s, FS.DecimalSeparator, FS.ThousandSeparator);
      if Fmt = ffCurrency then
        Result := CurrencyOf(neg, s, FS)
      else if neg then
        Result := '-' + s
      else
        Result := s;
    end;
  end;
end;

function FloatToStrF(Value: Double; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

function CurrToStr(Value: Currency; const AFormatSettings: TFormatSettings): string;
var point: Integer;
begin
  { Decimal values stay decimal, including the full signed endpoints. }
  Result := PasFmtCurrency(CurrencyToScaled(Value), 0, -1);
  if AFormatSettings.DecimalSeparator <> '.' then
  begin
    point := Pos('.', Result);
    if point <> 0 then Result[point] := AFormatSettings.DecimalSeparator;
  end;
end;

function CurrToStr(Value: Currency): string;
begin Result := CurrToStr(Value, DefaultFormatSettings) end;

function FloatToStr(Value: Currency; const AFormatSettings: TFormatSettings): string;
begin Result := CurrToStr(Value, AFormatSettings) end;

function FloatToStr(Value: Currency): string;
begin Result := CurrToStr(Value, DefaultFormatSettings) end;

function FloatToStrF(Value: Currency; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var argument: TRealArg;
begin
  ArgCurrency(argument, Value);
  Result := RealText(argument, AFormat, Precision, Digits, AFormatSettings);
end;

function FloatToStrF(Value: Currency; AFormat: TFloatFormat; Precision, Digits: Integer): string;
begin Result := FloatToStrF(Value, AFormat, Precision, Digits, DefaultFormatSettings) end;

function CurrToStrF(Value: Currency; AFormat: TFloatFormat; Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
begin Result := FloatToStrF(Value, AFormat, 19, Digits, AFormatSettings) end;

function CurrToStrF(Value: Currency; AFormat: TFloatFormat; Digits: Integer): string;
begin Result := CurrToStrF(Value, AFormat, Digits, DefaultFormatSettings) end;

function FloatToStrF(Value: Double; AFormat: TFloatFormat; Precision, Digits: Integer): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, DefaultFormatSettings);
end;

function FloatToStrF(Value: Single; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgSingle(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

function FloatToStrF(Value: Single; AFormat: TFloatFormat; Precision, Digits: Integer): string;
var
  a: TRealArg;
begin
  ArgSingle(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, DefaultFormatSettings);
end;

function FloatToStrF(Value: Int64; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

function FloatToStrF(Value: Int64; AFormat: TFloatFormat; Precision, Digits: Integer): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, DefaultFormatSettings);
end;

function FloatToStrF(Value: Quad; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

function FloatToStrF(Value: Quad; AFormat: TFloatFormat; Precision, Digits: Integer): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, DefaultFormatSettings);
end;

{ The fewest digits that read back as Value (Go's shortest), where Free
  Pascal writes 15: 0.1 is 0.1, 1/3 is 0.3333333333333333. }
function FloatToStr(Value: Double; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, AFormatSettings);
end;

function FloatToStr(Value: Double): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, DefaultFormatSettings);
end;

function FloatToStr(Value: Single; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgSingle(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, AFormatSettings);
end;

function FloatToStr(Value: Single): string;
var
  a: TRealArg;
begin
  ArgSingle(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, DefaultFormatSettings);
end;

function FloatToStr(Value: Int64; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, AFormatSettings);
end;

function FloatToStr(Value: Int64): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, DefaultFormatSettings);
end;

function FloatToStr(Value: Quad; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, AFormatSettings);
end;

function FloatToStr(Value: Quad): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, DefaultFormatSettings);
end;

{ Free Pascal's FloatToDecimal: at most Precision significant digits (18
  at most, what TFloatRec holds) and Decimals places after the point,
  correctly rounded, followed by #0; Exponent the place of the point
  (32767 an infinity, -32768 a NaN); a value that rounds to 0 has no
  digit, exponent 0 and no sign. }
procedure ArgToDecimal(out Result: TFloatRec; const A: TRealArg; Precision, Decimals: Integer);
var
  neg: Boolean;
  kind, dp, i: Integer;
  d, s: string;
begin
  Result := Default(TFloatRec);
  ArgKind(A, neg, kind);
  if kind = 2 then
  begin
    Result.Exponent := 32767;
    Result.Negative := neg;
    Exit;
  end;
  if kind = 3 then
  begin
    Result.Exponent := -32768;
    Exit;
  end;
  if Precision > 18 then
    Precision := 18;
  d := '';
  dp := 0;
  if kind = 0 then
  begin
    ArgFrac(A, Decimals, d, dp);
    if Length(d) > Precision then
    begin
      ArgSig(A, Precision, s, i);
      d := s;
      dp := i;
    end;
  end;
  if d = '' then
    Exit;
  Result.Negative := neg;
  Result.Exponent := dp;
  for i := 1 to Length(d) do
    Result.Digits[i - 1] := d[i];
end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Double; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgDouble(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Single; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgSingle(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Int64; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgInt(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Quad; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgQuad(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Currency; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgCurrency(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

{ Free Pascal's FormatFloat (fmtflt.inc's IntFloatToTextFmt): up to
  three sections, for a positive value, a negative one and zero; 0 a
  digit always written, # one written when there is one, . the point, ,
  the thousands, E+ and E- an exponent, quotes literal text. Its digits
  are Go's, exact however many are asked, where Free Pascal stopped at
  18 and wrote a larger number in its general form. An empty section
  for a negative value or zero takes the first. }
function FloatFmtText(const Fmt: string; const A: TRealArg; const AFormatSettings: TFormatSettings): string;
var
  section, digs: string;
  neg, thousandSep, isSci, inLit: Boolean;
  decimalPos, firstDigit, lastDigit, requested, expSize, available, current, padZeroes,
    distToDecimal, s, i, n, fl, kind, dp: Integer;
  starts: array[0..4] of Integer;
  q, c: Char;

  procedure WriteDigit(ADigit: Char);
  begin
    if ADigit = #0 then
      Exit;
    distToDecimal := distToDecimal - 1;
    if distToDecimal = -1 then
      Result := Result + AFormatSettings.DecimalSeparator + ADigit
    else
    begin
      Result := Result + ADigit;
      if thousandSep and ((distToDecimal mod 3) = 0) and (distToDecimal > 1) then
        Result := Result + AFormatSettings.ThousandSeparator;
    end;
  end;

  function GetDigit: Char;
  begin
    Result := #0;
    if current <= available then
    begin
      Result := digs[current + 1];
      current := current + 1;
    end
    else if distToDecimal <= lastDigit then
      distToDecimal := distToDecimal - 1
    else
      Result := '0';
  end;

  procedure CopyDigit;
  begin
    if padZeroes = 0 then
      WriteDigit(GetDigit)
    else if padZeroes < 0 then
    begin
      padZeroes := padZeroes + 1;
      if distToDecimal <= firstDigit then
        WriteDigit('0')
      else
        distToDecimal := distToDecimal - 1;
    end
    else
    begin
      while padZeroes > 0 do
      begin
        WriteDigit(GetDigit);
        padZeroes := padZeroes - 1;
      end;
      WriteDigit(GetDigit);
    end;
  end;

  function ExponentText(ASign: Char; AExp: Integer): string;
  begin
    if digs = '' then
      AExp := 0;
    Result := IntToStr(Abs(AExp));
    if Length(Result) < expSize then
      Result := StringOfChar('0', expSize - Length(Result)) + Result;
    if AExp < 0 then
      Result := '-' + Result
    else if ASign = '+' then
      Result := '+' + Result;
  end;

begin
  Result := '';
  ArgKind(A, neg, kind);
  if kind >= 2 then
  begin
    Result := SpecialText(kind, neg);
    Exit;
  end;
  { the sections, ; outside quotes }
  fl := Length(Fmt);
  starts[0] := 1;
  n := 1;
  inLit := False;
  q := #0;
  for i := 1 to fl do
  begin
    c := Fmt[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if (c = ';') and not inLit then
    begin
      if n > 3 then
        raise EConvertError.Create('Invalid float format');
      starts[n] := i + 1;
      n := n + 1;
    end;
  end;
  starts[n] := fl + 2;
  if kind = 1 then
    s := 3
  else if neg then
    s := 2
  else
    s := 1;
  if (s > n) or (starts[s] - starts[s - 1] - 1 = 0) then
    s := 1;
  section := Copy(Fmt, starts[s - 1], starts[s] - starts[s - 1] - 1);
  if section = '' then
  begin
    Result := RealText(A, ffGeneral, 0, 0, AFormatSettings);
    Exit;
  end;
  { what the section asks (AnalyzeFormat) }
  thousandSep := False;
  isSci := False;
  decimalPos := 0;
  firstDigit := High(Int64);
  lastDigit := 0;
  requested := 0;
  expSize := 0;
  inLit := False;
  q := #0;
  i := 1;
  while i <= Length(section) do
  begin
    c := section[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if not inLit then
      case c of
        '.':
          if decimalPos = 0 then
            decimalPos := requested + 1;
        ',':
          thousandSep := AFormatSettings.ThousandSeparator <> #0;
        'e', 'E':
          begin
            i := i + 1;
            if i < Length(section) then
            begin
              c := section[i];
              isSci := (c = '-') or (c = '+');
              if isSci then
                while (i < Length(section)) and (section[i + 1] = '0') do
                begin
                  expSize := expSize + 1;
                  i := i + 1;
                end;
              if expSize > 4 then
                expSize := 4;
            end;
          end;
        '#':
          requested := requested + 1;
        '0':
          begin
            if requested < firstDigit then
              firstDigit := requested + 1;
            requested := requested + 1;
            lastDigit := requested + 1;
          end;
      end;
    i := i + 1;
  end;
  if decimalPos = 0 then
    decimalPos := requested + 1;
  lastDigit := decimalPos - lastDigit;
  if lastDigit > 0 then
    lastDigit := 0;
  firstDigit := decimalPos - firstDigit;
  if firstDigit < 0 then
    firstDigit := 0;
  { the digits (CalcRunVars), correctly rounded }
  digs := '';
  dp := 0;
  if kind = 0 then
  begin
    if isSci then
    begin
      if requested > 0 then
        ArgSig(A, requested, digs, dp);
    end
    else
      ArgFrac(A, requested - decimalPos + 1, digs, dp);
  end;
  if digs = '' then
  begin
    neg := False;
    dp := 0;
  end;
  distToDecimal := decimalPos - 1;
  if isSci then
    padZeroes := 0
  else
  begin
    padZeroes := dp - (decimalPos - 1);
    if padZeroes >= 0 then
      distToDecimal := dp;
  end;
  available := Length(digs) - 1;
  current := 0;
  { the section written }
  if neg and (s = 1) then
    Result := '-';
  inLit := False;
  q := ' ';
  i := 1;
  while i <= Length(section) do
  begin
    c := section[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if inLit then
      Result := Result + c
    else
      case c of
        '0', '#':
          CopyDigit;
        '.', ',':
          ;
        'e', 'E':
          begin
            Result := Result + c;
            if isSci then
            begin
              i := i + 1;
              if i <= Length(section) then
              begin
                c := section[i];
                if (c = '+') or (c = '-') then
                begin
                  Result := Result + ExponentText(c, dp - decimalPos + 1);
                  while (i < Length(section)) and (section[i + 1] = '0') do
                    i := i + 1;
                end;
              end;
            end
            else if i < Length(section) then
            begin
              i := i + 1;
              Result := Result + section[i];
            end;
          end;
      else
        Result := Result + c;
      end;
    i := i + 1;
  end;
end;

function FormatFloat(const Fmt: string; Value: Double; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := FloatFmtText(Fmt, a, AFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Double): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := FloatFmtText(Fmt, a, DefaultFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Single; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgSingle(a, Value);
  Result := FloatFmtText(Fmt, a, AFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Single): string;
var
  a: TRealArg;
begin
  ArgSingle(a, Value);
  Result := FloatFmtText(Fmt, a, DefaultFormatSettings);
end;

{ an integer exactly, and FormatFloat('0', 5) is no choice between the
  reals }
function FormatFloat(const Fmt: string; Value: Int64; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := FloatFmtText(Fmt, a, AFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Int64): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := FloatFmtText(Fmt, a, DefaultFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Quad; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := FloatFmtText(Fmt, a, AFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Quad): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := FloatFmtText(Fmt, a, DefaultFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Currency;
  const AFormatSettings: TFormatSettings): string;
var argument: TRealArg;
begin
  ArgCurrency(argument, Value);
  Result := FloatFmtText(Fmt, argument, AFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Currency): string;
begin Result := FormatFloat(Fmt, Value, DefaultFormatSettings) end;

function FormatCurr(const Fmt: string; Value: Currency;
  const AFormatSettings: TFormatSettings): string;
begin Result := FormatFloat(Fmt, Value, AFormatSettings) end;

function FormatCurr(const Fmt: string; Value: Currency): string;
begin Result := FormatFloat(Fmt, Value, DefaultFormatSettings) end;

{ ---- Format ---- }

procedure FormatError(Code: Integer; const Fmt: string);
begin
  case Code of
    1: raise EConvertError.Create('Invalid format specifier : "' + Fmt + '"');
    2: raise EConvertError.Create('Missing argument in format "' + Fmt + '"');
  else
    raise EConvertError.Create('Invalid argument index in format "' + Fmt + '"');
  end;
end;

{ Free Pascal's Format (sysformt.inc): %[index:][-][width][.prec]type,
  * a width or a precision from the arguments; d u x integers, e f g n m
  reals (a Double, or a Quad whole), s a string or a Char, p a
  pointer, b a Boolean, o an object's ToString or a class's name, %% a
  %; any other letter is an EConvertError. An integer is 64 bits, as
  paslang's (d u x of -1 are -1, 18446744073709551615,
  FFFFFFFFFFFFFFFF); a real's digits are Go's, the fewest that read back
  for %e and %g with no precision (the manual's §19). }
function Format(const Fmt: string; const Args: array of const;
  const AFormatSettings: TFormatSettings): string;
var
  chPos, oldPos, argPos, doArg, len, index, width, prec, value, nd: Integer;
  left: Boolean;
  fchar: Char;
  toAdd, hs: string;
  vq: Int64;

  procedure ReadInteger;
  var
    argN: Integer;
    code: Int64;
  begin
    if value <> -1 then
      Exit;
    oldPos := chPos;
    while (chPos <= len) and (Fmt[chPos] <= '9') and (Fmt[chPos] >= '0') do
      chPos := chPos + 1;
    if chPos > len then
      FormatError(1, Fmt);
    if Fmt[chPos] = '*' then
    begin
      if index = -1 then
        argN := argPos
      else
      begin
        argN := index;
        index := index + 1;
      end;
      if (chPos > oldPos) or (argN > High(Args)) then
        FormatError(1, Fmt);
      argPos := argN + 1;
      if Args[argN].VType = vtInteger then
        value := Args[argN].VInteger
      else
        FormatError(1, Fmt);
      chPos := chPos + 1;
    end
    else if oldPos < chPos then
    begin
      value := PasValInt(Copy(Fmt, oldPos, chPos - oldPos), False, code);
      if code <> 0 then
        FormatError(1, Fmt);
    end
    else
      value := -1;
  end;

  function ReadFormat: Char;
  begin
    index := -1;
    width := -1;
    prec := -1;
    value := -1;
    chPos := chPos + 1;
    if Fmt[chPos] = '%' then
    begin
      Result := '%';
      Exit;
    end;
    { the index, index: }
    if Fmt[chPos] <> ':' then
      ReadInteger
    else
      value := 0;
    if Fmt[chPos] = ':' then
    begin
      if value = -1 then
        FormatError(2, Fmt);
      index := value;
      value := -1;
      chPos := chPos + 1;
    end;
    { left alignment }
    if Fmt[chPos] = '-' then
    begin
      left := True;
      chPos := chPos + 1;
    end
    else
      left := False;
    { the width }
    ReadInteger;
    if value <> -1 then
    begin
      width := value;
      value := -1;
    end;
    { the precision }
    if Fmt[chPos] = '.' then
    begin
      chPos := chPos + 1;
      ReadInteger;
      if value = -1 then
        value := 0;
      prec := value;
    end;
    Result := UpCase(Fmt[chPos]);
  end;

  { the argument to use, of kind AKind; Err: a wrong kind is an error }
  function CheckArg(AKind: Integer; Err: Boolean): Boolean;
  begin
    Result := False;
    if index = -1 then
      doArg := argPos
    else
      doArg := index;
    argPos := doArg + 1;
    if (doArg > High(Args)) or (Args[doArg].VType <> AKind) then
    begin
      if Err then
        FormatError(3, Fmt);
      argPos := argPos - 1;
      Exit;
    end;
    Result := True;
  end;

  { a real argument: a Double, or a Quad kept whole }
  function RealArg(out X: TRealArg): Boolean;
  begin
    Result := True;
    if CheckArg(vtExtended, False) then
      ArgDouble(X, Args[doArg].VExtended)
    else if CheckArg(vtQuad, False) then
      ArgQuad(X, Args[doArg].VQuad)
    else if CheckArg(vtCurrency, False) then
      ArgCurrency(X, Args[doArg].VCurrency)
    else
      Result := CheckArg(vtExtended, True);
  end;

var
  x: TRealArg;
begin
  Result := '';
  len := Length(Fmt);
  chPos := 1;
  oldPos := 1;
  argPos := 0;
  while chPos <= len do
  begin
    while (chPos <= len) and (Fmt[chPos] <> '%') do
      chPos := chPos + 1;
    if chPos > oldPos then
      Result := Result + Copy(Fmt, oldPos, chPos - oldPos);
    if chPos < len then
    begin
      fchar := ReadFormat;
      toAdd := '';
      case fchar of
        'B':
          begin
            if CheckArg(vtBoolean, False) then
              toAdd := BoolToStr(Args[doArg].VBoolean, True)
            else if CheckArg(vtInteger, True) then
              toAdd := BoolToStr(Args[doArg].VInteger <> 0, True);
            if (prec <> -1) and (Length(toAdd) > prec) then
              toAdd := Copy(toAdd, 1, prec);
          end;
        'D':
          begin
            CheckArg(vtInteger, True);
            toAdd := IntToStr(Args[doArg].VInteger);
            width := Abs(width);
            nd := prec - Length(toAdd);
            if (toAdd <> '') and (toAdd[1] = '-') then
              Insert(StringOfChar('0', nd + 1), toAdd, 2)
            else
              toAdd := StringOfChar('0', nd) + toAdd;
          end;
        'U':
          begin
            CheckArg(vtInteger, True);
            toAdd := UIntToStr(Args[doArg].VInteger);
            width := Abs(width);
            toAdd := StringOfChar('0', prec - Length(toAdd)) + toAdd;
          end;
        'X':
          begin
            CheckArg(vtInteger, True);
            vq := Args[doArg].VInteger;
            toAdd := IntToHex(vq, 1);
            if Length(toAdd) < prec then
              toAdd := StringOfChar('0', prec - Length(toAdd)) + toAdd;
          end;
        'E':
          if RealArg(x) then
            toAdd := RealText(x, ffExponent, prec, 3, AFormatSettings);
        'F':
          if RealArg(x) then
            toAdd := RealText(x, ffFixed, 9999, prec, AFormatSettings);
        'G':
          if RealArg(x) then
            toAdd := RealText(x, ffGeneral, prec, 3, AFormatSettings);
        'N':
          if RealArg(x) then
            toAdd := RealText(x, ffNumber, 9999, prec, AFormatSettings);
        'M':
          if RealArg(x) then
            toAdd := RealText(x, ffCurrency, 9999, prec, AFormatSettings);
        'S':
          begin
            if CheckArg(vtAnsiString, False) then
              hs := Args[doArg].VAnsiString
            else if CheckArg(vtChar, False) then
              hs := Args[doArg].VChar
            else
              { A raw pointer has no readable extent. Precision is an
                output limit, not proof of its allocation size. }
              FormatError(3, Fmt);
            if (prec <> -1) and (Length(hs) > prec) then
              hs := Copy(hs, 1, prec);
            toAdd := hs;
          end;
        'O':
          begin
            if CheckArg(vtClass, False) then
            begin
              if Args[doArg].VClass = nil then
                toAdd := '<Nil>'
              else
                toAdd := Args[doArg].VClass.ClassName;
            end
            else
            begin
              CheckArg(vtObject, True);
              if Args[doArg].VObject = nil then
                toAdd := '<Nil>'
              else
                toAdd := Args[doArg].VObject.ToString;
            end;
          end;
        'P':
          begin
            if CheckArg(vtObject, False) then
              toAdd := IntToHex(Int64(Pointer(Args[doArg].VObject)), 16)
            else if CheckArg(vtClass, False) then
              toAdd := IntToHex(Int64(Pointer(Args[doArg].VClass)), 16)
            else
            begin
              CheckArg(vtPointer, True);
              toAdd := IntToHex(Int64(Args[doArg].VPointer), 16);
            end;
          end;
        '%':
          toAdd := '%';
      else
        { Free Pascal writes nothing for a letter it does not know, or
          what the directive before wrote (ToAdd is not cleared); a
          directive dropped without a word is refused (the manual's §19) }
        FormatError(1, Fmt);
      end;
      if (width = -1) or (Length(toAdd) >= width) then
        Result := Result + toAdd
      else if left then
        Result := Result + toAdd + StringOfChar(' ', width - Length(toAdd))
      else
        Result := Result + StringOfChar(' ', width - Length(toAdd)) + toAdd;
    end;
    chPos := chPos + 1;
    oldPos := chPos;
  end;
end;

function Format(const Fmt: string; const Args: array of const): string;
begin
  Result := Format(Fmt, Args, DefaultFormatSettings);
end;

procedure FmtStr(var Res: string; const Fmt: string; const Args: array of const);
begin
  Res := Format(Fmt, Args, DefaultFormatSettings);
end;

procedure FmtStr(var Res: string; const Fmt: string; const Args: array of const;
  const AFormatSettings: TFormatSettings);
begin
  Res := Format(Fmt, Args, AFormatSettings);
end;

{ ---- dates and times (P131) ---- }

{ Free Pascal's (objpas/sysutils/dati.inc, rtl/unix/sysutils.pp), its
  names, parameters and algorithms, on paslang's words: the local clock
  is Go's time.Local (pastime: the zone $TZ names, /etc/localtime, the
  TZif files), a moment before 1970 is its own day and second (Free
  Pascal's EpochToLocal mirrors it about midnight), a value parameter
  Free Pascal declares a Word is an Integer (a year of 70000 is no date,
  where the Word made it 4464), and a text has no 255-character limit.
  The manual's section 19 lists each. }

function DateTimeToTimeStamp(DateTime: TDateTime): TTimeStamp;
var
  d: Double;
  n: Int64;
begin
  { to the nearest millisecond, half away from 0; Free Pascal multiplies
    by Single(MSecsPerDay), which holds 86400000 exactly }
  d := DateTime * MSecsPerDay;
  if d < 0 then
    d := d - 0.5
  else
    d := d + 0.5;
  n := Trunc(d);
  Result.Time := Abs(n) mod MSecsPerDay;
  Result.Date := DateDelta + n div MSecsPerDay;
end;

function TimeStampToDateTime(const TimeStamp: TTimeStamp): TDateTime;
begin
  Result := ComposeDateTime(TimeStamp.Date - DateDelta, TimeStamp.Time / MSecsPerDay);
end;

function MSecsToTimeStamp(MSecs: Int64): TTimeStamp;
begin
  Result.Date := MSecs div MSecsPerDay;
  Result.Time := MSecs - Result.Date * MSecsPerDay;
end;

function TimeStampToMSecs(const TimeStamp: TTimeStamp): Int64;
begin
  Result := TimeStamp.Time + TimeStamp.Date * Int64(MSecsPerDay);
end;

function IsLeapYear(Year: Integer): Boolean;
begin
  Result := ((Year mod 4) = 0) and (((Year mod 100) <> 0) or ((Year mod 400) = 0));
end;

function TryEncodeDate(Year, Month, Day: Integer; out ADate: TDateTime): Boolean;
var
  c, ya: Int64;
begin
  Result := (Year > 0) and (Year < 10000) and (Month >= 1) and (Month <= 12) and (Day > 0);
  if Result then
    Result := Day <= MonthDays[IsLeapYear(Year), Month];
  if Result then
  begin
    { the year from March, so that February's length falls at its end }
    if Month > 2 then
      Month := Month - 3
    else
    begin
      Month := Month + 9;
      Year := Year - 1;
    end;
    c := Year div 100;
    ya := Year - 100 * c;
    ADate := (146097 * c) shr 2 + (1461 * ya) shr 2 + (153 * Month + 2) div 5 + Day;
    ADate := ADate - 693900;
  end;
end;

function TryEncodeTime(Hour, Minute, Second, MilliSecond: Integer; out ATime: TDateTime): Boolean;
begin
  { 23:59:60, a leap second, too }
  Result := (Hour >= 0) and (Minute >= 0) and (Second >= 0) and (MilliSecond >= 0) and
    (((Hour < 24) and (Minute < 60) and (Second < 60) and (MilliSecond < 1000)) or
    ((Hour = 23) and (Minute = 59) and (Second = 60) and (MilliSecond < 1000)));
  if Result then
    ATime := (Hour * 3600000 + Minute * 60000 + Second * 1000 + MilliSecond) / MSecsPerDay;
end;

function EncodeDate(Year, Month, Day: Integer): TDateTime;
begin
  if not TryEncodeDate(Year, Month, Day, Result) then
    raise EConvertError.CreateFmt(SErrInvalidDate, [Year, Month, Day]);
end;

function EncodeTime(Hour, Minute, Second, MilliSecond: Integer): TDateTime;
begin
  if not TryEncodeTime(Hour, Minute, Second, MilliSecond, Result) then
    raise EConvertError.CreateFmt(SerrInvalidHourMinuteSecMsec, [Hour, Minute, Second, MilliSecond]);
end;

{ The day of a date that is one, else 0; the time of a time that is
  one, else 0 (DoEncodeDate, DoEncodeTime). }
function DayOrZero(Year, Month, Day: Integer): TDateTime;
var
  d: TDateTime;
begin
  Result := 0;
  if TryEncodeDate(Year, Month, Day, d) then
    Result := Trunc(d);
end;

function TimeOrZero(Hour, Minute, Second, MilliSecond: Integer): TDateTime;
begin
  if not TryEncodeTime(Hour, Minute, Second, MilliSecond, Result) then
    Result := 0;
end;

function ComposeDateTime(ADate, ATime: TDateTime): TDateTime;
begin
  if ADate < 0 then
    Result := Trunc(ADate) - Abs(Frac(ATime))
  else
    Result := Trunc(ADate) + Abs(Frac(ATime));
end;

procedure DecodeDate(ADate: TDateTime; out Year, Month, Day: Word);
var
  ly, ld, lm, j: Int64;
begin
  if ADate <= -DateDelta then
  begin
    { before 0001-01-01: 0-0-0 }
    Year := 0;
    Month := 0;
    Day := 0;
  end
  else
  begin
    { half a millisecond on, as DecodeTime rounds to the millisecond }
    if ADate > 0 then
      ADate := ADate + 1 / (MSecsPerDay * 2)
    else
      ADate := ADate - 1 / (MSecsPerDay * 2);
    if ADate > MaxDateTime then
      ADate := MaxDateTime;
    j := ((Trunc(ADate) + 693900) shl 2) - 1;
    ly := j div 146097;
    j := j - 146097 * ly;
    ld := j shr 2;
    j := ((ld shl 2) + 3) div 1461;
    ld := ((ld shl 2) + 7 - 1461 * j) shr 2;
    lm := (5 * ld - 3) div 153;
    ld := (5 * ld + 2 - 153 * lm) div 5;
    ly := 100 * ly + j;
    if lm < 10 then
      lm := lm + 3
    else
    begin
      lm := lm - 9;
      ly := ly + 1;
    end;
    Year := Word(ly);
    Month := Word(lm);
    Day := Word(ld);
  end;
end;

function DayOfWeek(DateTime: TDateTime): Integer;
begin
  { 1 is Sunday }
  Result := 1 + ((Trunc(DateTime) - 1) mod 7);
  if Result <= 0 then
    Result := Result + 7;
end;

function DecodeDateFully(const DateTime: TDateTime; out Year, Month, Day, DOW: Word): Boolean;
begin
  DecodeDate(DateTime, Year, Month, Day);
  DOW := Word(DayOfWeek(DateTime));
  Result := IsLeapYear(Year);
end;

procedure DecodeTime(ATime: TDateTime; out Hour, Minute, Second, MilliSecond: Word);
var
  l: Int64;
begin
  l := DateTimeToTimeStamp(ATime).Time;
  Hour := Word(l div 3600000);
  l := l mod 3600000;
  Minute := Word(l div 60000);
  l := l mod 60000;
  Second := Word(l div 1000);
  MilliSecond := Word(l mod 1000);
end;

procedure DateTimeToSystemTime(DateTime: TDateTime; out SystemTime: TSystemTime);
begin
  DecodeDateFully(DateTime, SystemTime.Year, SystemTime.Month, SystemTime.Day,
    SystemTime.DayOfWeek);
  DecodeTime(DateTime, SystemTime.Hour, SystemTime.Minute, SystemTime.Second,
    SystemTime.MilliSecond);
  SystemTime.DayOfWeek := SystemTime.DayOfWeek - 1;
end;

function SystemTimeToDateTime(const SystemTime: TSystemTime): TDateTime;
begin
  Result := ComposeDateTime(DayOrZero(SystemTime.Year, SystemTime.Month, SystemTime.Day),
    TimeOrZero(SystemTime.Hour, SystemTime.Minute, SystemTime.Second, SystemTime.MilliSecond));
end;

{ The moment the wall clock shows, in whole seconds since 1970 and the
  milliseconds of that second (gettimeofday's, as Free Pascal's). }
procedure WallClock(out Secs, MSecs: Int64);
var
  ns: Int64;
begin
  ns := NowNanos;
  Secs := ns div NsPerSec;
  MSecs := (ns mod NsPerSec) div NsPerMs;
  if MSecs < 0 then
  begin
    Secs := Secs - 1;
    MSecs := MSecs + 1000;
  end;
end;

procedure FillSystemTime(const D: pastime.TDate; MSecs: Int64; var SystemTime: TSystemTime);
begin
  SystemTime.Year := Word(D.Year);
  SystemTime.Month := Word(D.Month);
  SystemTime.Day := Word(D.Day);
  SystemTime.DayOfWeek := Word(D.Wday);
  SystemTime.Hour := Word(D.Hour);
  SystemTime.Minute := Word(D.Minute);
  SystemTime.Second := Word(D.Second);
  SystemTime.MilliSecond := Word(MSecs);
end;

procedure GetLocalTime(var SystemTime: TSystemTime);
var
  secs, ms: Int64;
begin
  WallClock(secs, ms);
  FillSystemTime(UnixToLocalDate(secs), ms, SystemTime);
end;

{ The day of the week too, where Free Pascal leaves it as it was. }
function GetUniversalTime(var SystemTime: TSystemTime): Boolean;
var
  secs, ms: Int64;
begin
  WallClock(secs, ms);
  FillSystemTime(UnixToDate(secs), ms, SystemTime);
  Result := True;
end;

function Date: TDateTime;
var
  st: TSystemTime;
begin
  GetLocalTime(st);
  Result := DayOrZero(st.Year, st.Month, st.Day);
end;

function Time: TDateTime;
var
  st: TSystemTime;
begin
  GetLocalTime(st);
  Result := TimeOrZero(st.Hour, st.Minute, st.Second, st.MilliSecond);
end;

function Now: TDateTime;
var
  st: TSystemTime;
begin
  GetLocalTime(st);
  Result := SystemTimeToDateTime(st);
end;

function NowUTC: TDateTime;
var
  st: TSystemTime;
begin
  GetUniversalTime(st);
  Result := SystemTimeToDateTime(st);
end;

function CurrentYear: Word;
var
  st: TSystemTime;
begin
  GetLocalTime(st);
  Result := st.Year;
end;

procedure IncAMonth(var Year, Month, Day: Word; NumberOfMonths: Integer = 1);
var
  tempMonth, sgn: Integer;
begin
  if NumberOfMonths >= 0 then
    sgn := 1
  else
    sgn := -1;
  Year := Word(Year + NumberOfMonths div 12);
  tempMonth := Month + (NumberOfMonths mod 12) - 1;
  if (tempMonth > 11) or (tempMonth < 0) then
  begin
    tempMonth := tempMonth - sgn * 12;
    Year := Word(Year + sgn);
  end;
  Month := Word(tempMonth + 1);
  if Day > MonthDays[IsLeapYear(Year), Month] then
    Day := MonthDays[IsLeapYear(Year), Month];
end;

function IncMonth(const DateTime: TDateTime; NumberOfMonths: Integer = 1): TDateTime;
var
  y, m, d: Word;
begin
  DecodeDate(DateTime, y, m, d);
  IncAMonth(y, m, d, NumberOfMonths);
  Result := ComposeDateTime(DayOrZero(y, m, d), DateTime);
end;

procedure ReplaceTime(var dati: TDateTime; NewTime: TDateTime);
begin
  dati := ComposeDateTime(dati, NewTime);
end;

procedure ReplaceDate(var DateTime: TDateTime; const NewDate: TDateTime);
var
  tmp: TDateTime;
begin
  tmp := NewDate;
  ReplaceTime(tmp, DateTime);
  DateTime := tmp;
end;

function FloatToDateTime(const Value: Extended): TDateTime;
begin
  if (Value < MinDateTime) or (Value > MaxDateTime) then
    raise EConvertError.CreateFmt(SInvalidDateTimeFloat, [Value]);
  Result := Value;
end;

{ Whether the format from P, in its bytes up to Stop, starts with W,
  capitals or not (StrLIComp's test of the next Length(W) characters). }
function FormatAt(const F: string; P, Stop: Integer; const W: string): Boolean;
var
  i: Integer;
begin
  Result := False;
  if P + Length(W) - 1 > Stop then
    Exit;
  for i := 1 to Length(W) do
    if UpCase(F[P + i - 1]) <> W[i] then
      Exit;
  Result := True;
end;

{ Value written with at least Digits digits, zeros before it (Str's
  width and its blanks turned to zeros, as Free Pascal's StoreInt). }
function ZeroPad(Value: Int64; Digits: Integer): string;
var
  i: Integer;
begin
  Str(Value: Digits, Result);
  for i := 1 to Length(Result) do
  begin
    if Result[i] <> ' ' then
      Break;
    Result[i] := '0';
  end;
end;

procedure DateTimeToString(out Result: string; const FormatStr: string; const DateTime: TDateTime;
  const AFormatSettings: TFormatSettings; Options: TFormatDateTimeOptions = []);
var
  year, month, day, dow, hour, minute, second, msec: Word;
  res: string;

  { the whole days of an interval, one more when the time rounds up to
    the next midnight }
  function FullDays(ADateTime: TDateTime): Int64;
  begin
    if ADateTime < 0 then
      ADateTime := -ADateTime;
    Result := Trunc(ADateTime);
    if (Frac(ADateTime) > 0.9) and (hour = 0) and (minute = 0) and (second = 0) and (msec = 0) then
      Result := Result + 1;
  end;

  procedure StoreFormat(const Fmt: string; Nesting: Integer; TimeFlag: Boolean);
  var
    token, lastToken, prevToken: Char;
    cur, stop, count, p, tmp: Integer;
    clock12, isInterval: Boolean;
  begin
    { a format the format names (ddddd, c, t) is read once more, not
      deeper }
    if Nesting > 1 then
      Exit;
    stop := Length(Fmt);
    clock12 := False;
    isInterval := False;
    { a 12-hour clock when am/pm, a/p or ampm is there, out of quotes }
    p := 1;
    while p <= stop do
    begin
      token := Fmt[p];
      if (token = '''') or (token = '"') then
      begin
        p := p + 1;
        while (p <= stop) and (Fmt[p] <> token) do
          p := p + 1;
      end
      else if ((token = 'A') or (token = 'a')) and (FormatAt(Fmt, p, stop, 'A/P') or
        FormatAt(Fmt, p, stop, 'AMPM') or FormatAt(Fmt, p, stop, 'AM/PM')) then
      begin
        clock12 := True;
        Break;
      end;
      p := p + 1;
    end;
    lastToken := ' ';
    prevToken := 'H';
    cur := 1;
    while cur <= stop do
    begin
      token := UpCase(Fmt[cur]);
      count := 1;
      p := cur + 1;
      if (token = '''') or (token = '"') then
      begin
        { the text between quotes as it is; a quote left open takes the
          rest }
        while (p <= stop) and (Fmt[p] <> token) do
          p := p + 1;
        p := p + 1;
        count := p - cur;
        res := res + Copy(Fmt, cur + 1, count - 2);
      end
      else if token = 'A' then
      begin
        if FormatAt(Fmt, cur, stop, 'AMPM') then
        begin
          count := 4;
          if hour < 12 then
            res := res + AFormatSettings.TimeAMString
          else
            res := res + AFormatSettings.TimePMString;
        end
        else if FormatAt(Fmt, cur, stop, 'AM/PM') then
        begin
          count := 5;
          if hour < 12 then
            res := res + Copy(Fmt, cur, 2)
          else
            res := res + Copy(Fmt, cur + 3, 2);
        end
        else if FormatAt(Fmt, cur, stop, 'A/P') then
        begin
          count := 3;
          if hour < 12 then
            res := res + Fmt[cur]
          else
            res := res + Fmt[cur + 2];
        end
        else
          raise EConvertError.Create('Illegal character in format string');
      end
      else if token = '/' then
      begin
        if AFormatSettings.DateSeparator <> #0 then
          res := res + AFormatSettings.DateSeparator;
      end
      else if token = ':' then
      begin
        if AFormatSettings.TimeSeparator <> #0 then
          res := res + AFormatSettings.TimeSeparator;
      end
      else if token = '[' then
      begin
        if fdoInterval in Options then
          isInterval := True
        else
          res := res + '[';
      end
      else if token = ']' then
      begin
        if fdoInterval in Options then
          isInterval := False
        else
          res := res + ']';
      end
      else if (token = ' ') or (token = 'C') or (token = 'D') or (token = 'H') or (token = 'M') or
        (token = 'N') or (token = 'S') or (token = 'T') or (token = 'Y') or (token = 'Z') or
        (token = 'F') then
      begin
        while (p <= stop) and (UpCase(Fmt[p]) = token) do
          p := p + 1;
        count := p - cur;
        if token = ' ' then
          res := res + Copy(Fmt, cur, count)
        else if token = 'Y' then
        begin
          if count > 2 then
            res := res + ZeroPad(year, 4)
          else
            res := res + ZeroPad(year mod 100, 2);
        end
        else if token = 'M' then
        begin
          { minutes after an hour, and in a time's format; else the month }
          if isInterval and ((prevToken = 'H') or TimeFlag) then
            res := res + ZeroPad(minute + (hour + FullDays(DateTime) * 24) * 60, 0)
          else if (lastToken = 'H') or TimeFlag then
          begin
            if count = 1 then
              res := res + ZeroPad(minute, 0)
            else
              res := res + ZeroPad(minute, 2);
          end
          else if count = 1 then
            res := res + ZeroPad(month, 0)
          else if count = 2 then
            res := res + ZeroPad(month, 2)
          else if count = 3 then
            res := res + AFormatSettings.ShortMonthNames[month]
          else
            res := res + AFormatSettings.LongMonthNames[month];
        end
        else if token = 'D' then
        begin
          if count = 1 then
            res := res + ZeroPad(day, 0)
          else if count = 2 then
            res := res + ZeroPad(day, 2)
          else if count = 3 then
            res := res + AFormatSettings.ShortDayNames[dow]
          else if count = 4 then
            res := res + AFormatSettings.LongDayNames[dow]
          else if count = 5 then
            StoreFormat(AFormatSettings.ShortDateFormat, Nesting + 1, False)
          else
            StoreFormat(AFormatSettings.LongDateFormat, Nesting + 1, False);
        end
        else if token = 'H' then
        begin
          if isInterval then
            res := res + ZeroPad(hour + FullDays(DateTime) * 24, count)
          else if clock12 then
          begin
            tmp := hour mod 12;
            if tmp = 0 then
              tmp := 12;
            if count = 1 then
              res := res + ZeroPad(tmp, 0)
            else
              res := res + ZeroPad(tmp, 2);
          end
          else if count = 1 then
            res := res + ZeroPad(hour, 0)
          else
            res := res + ZeroPad(hour, 2);
        end
        else if token = 'N' then
        begin
          if isInterval then
            res := res + ZeroPad(minute + (hour + FullDays(DateTime) * 24) * 60, count)
          else if count = 1 then
            res := res + ZeroPad(minute, 0)
          else
            res := res + ZeroPad(minute, 2);
        end
        else if token = 'S' then
        begin
          if isInterval then
            res := res + ZeroPad(second + (minute + (hour + FullDays(DateTime) * 24) * 60) * 60,
              count)
          else if count = 1 then
            res := res + ZeroPad(second, 0)
          else
            res := res + ZeroPad(second, 2);
        end
        else if token = 'Z' then
        begin
          if count = 1 then
            res := res + ZeroPad(msec, 0)
          else
            res := res + ZeroPad(msec, 3);
        end
        else if token = 'T' then
        begin
          if count = 1 then
            StoreFormat(AFormatSettings.ShortTimeFormat, Nesting + 1, True)
          else
            StoreFormat(AFormatSettings.LongTimeFormat, Nesting + 1, True);
        end
        else if token = 'C' then
        begin
          StoreFormat(AFormatSettings.ShortDateFormat, Nesting + 1, False);
          if (hour <> 0) or (minute <> 0) or (second <> 0) then
          begin
            res := res + ' ';
            StoreFormat(AFormatSettings.LongTimeFormat, Nesting + 1, True);
          end;
        end
        else
        begin
          StoreFormat(AFormatSettings.ShortDateFormat, Nesting + 1, False);
          res := res + ' ';
          StoreFormat(AFormatSettings.LongTimeFormat, Nesting + 1, True);
        end;
        prevToken := lastToken;
        lastToken := token;
      end
      else
        { any other character as it is written (Free Pascal writes a
          letter it does not know in capitals) }
        res := res + Fmt[cur];
      cur := cur + count;
    end;
  end;

begin
  DecodeDateFully(DateTime, year, month, day, dow);
  DecodeTime(DateTime, hour, minute, second, msec);
  res := '';
  if FormatStr <> '' then
    StoreFormat(FormatStr, 0, False)
  else
    StoreFormat('C', 0, False);
  { an interval before 0 is written with its sign (Free Pascal 3.3.1;
    3.2.2 writes none) }
  if (DateTime < 0) and (fdoInterval in Options) then
    res := '-' + res;
  Result := res;
end;

procedure DateTimeToString(out Result: string; const FormatStr: string; const DateTime: TDateTime;
  Options: TFormatDateTimeOptions = []);
begin
  DateTimeToString(Result, FormatStr, DateTime, DefaultFormatSettings, Options);
end;

function FormatDateTime(const FormatStr: string; DateTime: TDateTime;
  Options: TFormatDateTimeOptions = []): string;
begin
  DateTimeToString(Result, FormatStr, DateTime, DefaultFormatSettings, Options);
end;

function FormatDateTime(const FormatStr: string; DateTime: TDateTime;
  const AFormatSettings: TFormatSettings; Options: TFormatDateTimeOptions = []): string;
begin
  DateTimeToString(Result, FormatStr, DateTime, AFormatSettings, Options);
end;

function DateToStr(ADate: TDateTime): string;
begin
  DateTimeToString(Result, 'ddddd', ADate);
end;

function DateToStr(ADate: TDateTime; const AFormatSettings: TFormatSettings): string;
begin
  DateTimeToString(Result, AFormatSettings.ShortDateFormat, ADate, AFormatSettings);
end;

function TimeToStr(ATime: TDateTime): string;
begin
  DateTimeToString(Result, 'tt', ATime);
end;

function TimeToStr(ATime: TDateTime; const AFormatSettings: TFormatSettings): string;
begin
  DateTimeToString(Result, AFormatSettings.LongTimeFormat, ATime, AFormatSettings);
end;

function DateTimeToStr(DateTime: TDateTime; ForceTimeIfZero: Boolean = False): string;
begin
  if ForceTimeIfZero then
    DateTimeToString(Result, 'f', DateTime)
  else
    DateTimeToString(Result, 'c', DateTime);
end;

function DateTimeToStr(DateTime: TDateTime; const AFormatSettings: TFormatSettings;
  ForceTimeIfZero: Boolean = False): string;
begin
  if ForceTimeIfZero then
    DateTimeToString(Result, 'f', DateTime, AFormatSettings)
  else
    DateTimeToString(Result, 'c', DateTime, AFormatSettings);
end;

{ A date read from S with the order of UseFormat's d, m and y and the
  separator Separator (#0: the settings'); an error's message in
  ErrorMsg, '' when it is one (Free Pascal's IntStrToDate). A day and a
  month alone are this year's, a day alone this month's; a year of one
  or two digits is placed in the century TwoDigitYearCenturyWindow
  says. }
function ReadDate(out ErrorMsg: string; const S, UseFormat: string; const Defs: TFormatSettings;
  Separator: Char): TDateTime;
var
  df, s1: string;
  d, m, y, ly, n, i, len, code: Integer;
  dp, mp, yp, which: Integer;
  values: array[1..3] of Int32;
  st: TSystemTime;
  wide: Boolean;
begin
  ErrorMsg := '';
  Result := 0;
  len := Length(S);
  while (len > 0) and ((S[len] = ' ') or (S[len] = #8) or (S[len] = #9) or (S[len] = #10) or
    (S[len] = #12) or (S[len] = #13)) do
    len := len - 1;
  if len = 0 then
  begin
    ErrorMsg := Format('"%s" is not a valid date format', ['']);
    Exit;
  end;
  wide := False;
  if Separator = #0 then
    Separator := Defs.DateSeparator;
  df := UpperCase(UseFormat);
  { the order of D, M and Y, the first of each }
  yp := 0;
  mp := 0;
  dp := 0;
  which := 0;
  i := 0;
  while (i < Length(df)) and (which < 3) do
  begin
    i := i + 1;
    if (df[i] = 'Y') and (yp = 0) then
    begin
      which := which + 1;
      yp := which;
    end
    else if (df[i] = 'M') and (mp = 0) then
    begin
      which := which + 1;
      mp := which;
    end
    else if (df[i] = 'D') and (dp = 0) then
    begin
      which := which + 1;
      dp := which;
    end;
  end;
  for i := 1 to 3 do
    values[i] := 0;
  s1 := '';
  n := 0;
  for i := 1 to len do
  begin
    if (S[i] >= '0') and (S[i] <= '9') then
      s1 := s1 + S[i];
    { a blank that is no separator is skipped: some short date formats
      have one }
    if (Separator <> ' ') and (S[i] = ' ') then
      Continue;
    if (S[i] = Separator) or ((i = len) and (S[i] >= '0') and (S[i] <= '9')) then
    begin
      n := n + 1;
      if n > 3 then
      begin
        ErrorMsg := Format('"%s" is not a valid date format', [S]);
        Exit;
      end;
      if (n = yp) and (Length(s1) > 2) then
        wide := True;
      Val(s1, values[n], code);
      if code <> 0 then
      begin
        ErrorMsg := Format('"%s" is not a valid date format', [S]);
        Exit;
      end;
      s1 := '';
    end
    else if not ((S[i] >= '0') and (S[i] <= '9')) then
    begin
      ErrorMsg := Format('"%s" is not a valid date format', [S]);
      Exit;
    end;
  end;
  if (which < 3) and (n > which) then
  begin
    ErrorMsg := Format('"%s" is not a valid date format', [S]);
    Exit;
  end;
  GetLocalTime(st);
  ly := st.Year;
  for i := 1 to 3 do
    if values[i] > High(Word) then
    begin
      ErrorMsg := 'Invalid date';
      Exit;
    end;
  if n = 3 then
  begin
    y := values[yp];
    m := values[mp];
    d := values[dp];
  end
  else
  begin
    y := ly;
    if n < 2 then
    begin
      d := values[1];
      m := st.Month;
    end
    else if dp < mp then
    begin
      d := values[1];
      m := values[2];
    end
    else
    begin
      d := values[2];
      m := values[1];
    end;
  end;
  if (y >= 0) and (y < 100) and not wide then
  begin
    ly := ly - Defs.TwoDigitYearCenturyWindow;
    y := y + ly div 100 * 100;
    if (Defs.TwoDigitYearCenturyWindow > 0) and (y < ly) then
      y := y + 100;
  end;
  if not TryEncodeDate(y, m, d, Result) then
    ErrorMsg := 'Invalid date';
end;

{ A time read from S, an hour and optional minutes, seconds and
  milliseconds, the separator Separator (#0: the settings') between
  them and the decimal separator before the milliseconds, an AM or a PM
  (the settings' or those) before or after them; an error's message in
  ErrorMsg (Free Pascal's IntStrToTime and its SplitElements). }
function ReadTime(out ErrorMsg: string; const S: string; const Defs: TFormatSettings;
  Separator: Char): TDateTime;
const
  AmPmNone = 0;
  AmPmAM = 1;
  AmPmPM = 2;
var
  values: array[0..3] of Integer;
  ampm: Integer;

  function IsDigit(C: Char): Boolean;
  begin
    Result := (C >= '0') and (C <= '9');
  end;

  { S's bytes are S[0..len-1] here, as Free Pascal reads its PChar }
  function At(I: Integer): Char;
  begin
    Result := S[I + 1];
  end;

  function SplitTime: Boolean;
  var
    cur, offset, elemLen, err, index, first, len: Integer;
    value: Word;
    digitPending, msecPending: Boolean;
    ampmStr: string;
    c: Char;
  begin
    Result := False;
    len := Length(S);
    ampm := AmPmNone;
    msecPending := False;
    index := 0;
    values[0] := 0;
    values[1] := 0;
    values[2] := 0;
    values[3] := 0;
    cur := 0;
    { blanks first; then no separator }
    while (cur < len) and (At(cur) = ' ') do
      cur := cur + 1;
    if (cur > len - 1) or (At(cur) = Separator) or (At(cur) = Defs.DecimalSeparator) then
      Exit;
    digitPending := IsDigit(At(cur));
    while cur < len do
    begin
      c := At(cur);
      if IsDigit(c) then
      begin
        { a number after the start, a separator or an AM or a PM }
        if (not digitPending) or (index > 3) then
          Exit;
        offset := cur;
        if c <> '0' then
          first := offset
        else
          first := -1;
        while (cur < len - 1) and IsDigit(At(cur + 1)) do
        begin
          if (first = -1) and (At(cur) <> '0') then
            first := cur;
          cur := cur + 1;
        end;
        if first = -1 then
          first := cur;
        elemLen := 1 + cur - first;
        { two digits, three for the milliseconds, the zeros before them
          aside }
        if (elemLen <= 2) or ((elemLen <= 3) and (index = 3)) then
        begin
          Val(Copy(S, first + 1, elemLen), value, err);
          values[index] := value;
          index := index + 1;
          digitPending := False;
        end
        else
          Exit;
      end
      else if c = ' ' then
      begin
      end
      else if c = Separator then
      begin
        if digitPending or (index > 2) then
          Exit;
        digitPending := True;
        msecPending := False;
      end
      else if c = Defs.DecimalSeparator then
      begin
        if digitPending or msecPending or (index <> 3) then
          Exit;
        digitPending := True;
        msecPending := True;
      end
      else
      begin
        { anything else starts an AM or a PM }
        if (ampm <> AmPmNone) or digitPending then
          Exit;
        offset := cur;
        while (cur < len - 1) and (At(cur + 1) <> Separator) and (At(cur + 1) <> ' ') and
          (At(cur + 1) <> Defs.DecimalSeparator) and not IsDigit(At(cur + 1)) do
          cur := cur + 1;
        elemLen := 1 + cur - offset;
        ampmStr := Copy(S, offset + 1, elemLen);
        if AnsiCompareText(ampmStr, Defs.TimeAMString) = 0 then
          ampm := AmPmAM
        else if AnsiCompareText(ampmStr, Defs.TimePMString) = 0 then
          ampm := AmPmPM
        else if CompareText(ampmStr, 'AM') = 0 then
          ampm := AmPmAM
        else if CompareText(ampmStr, 'PM') = 0 then
          ampm := AmPmPM
        else
          Exit;
        { before the hour, a number follows; after it, nothing more }
        if index = 0 then
          digitPending := True
        else
        begin
          index := 4;
          digitPending := False;
        end;
      end;
      cur := cur + 1;
    end;
    { an hour at least, of 1 to 12 with an AM or a PM }
    if (index = 0) or ((ampm <> AmPmNone) and ((values[0] > 12) or (values[0] = 0))) or
      digitPending then
      Exit;
    Result := True;
  end;

begin
  ErrorMsg := '';
  Result := 0;
  if Separator = #0 then
    Separator := Defs.TimeSeparator;
  ampm := AmPmNone;
  if not SplitTime then
  begin
    ErrorMsg := Format(SErrInvalidTimeFormat, [S]);
    Exit;
  end;
  if (ampm = AmPmPM) and (values[0] <> 12) then
    values[0] := values[0] + 12
  else if (ampm = AmPmAM) and (values[0] = 12) then
    values[0] := 0;
  if not TryEncodeTime(values[0], values[1], values[2], values[3], Result) then
    ErrorMsg := Format(SErrInvalidTimeFormat, [S]);
end;

{ The Len bytes at S, a PChar that need not end in #0 there. }
function PCharText(const S: PChar; Len: Integer): string;
var
  i: Integer;
begin
  Result := '';
  if (S = nil) or (Len <= 0) then
    Exit;
  SetLength(Result, Len);
  for i := 1 to Len do
    Result[i] := S[i - 1];
end;

function StrToDate(const S: string; const UseFormat: string; Separator: Char = #0): TDateTime;
var
  msg: string;
begin
  Result := ReadDate(msg, S, UseFormat, DefaultFormatSettings, Separator);
  if msg <> '' then
    raise EConvertError.Create(msg);
end;

function StrToDate(const S: PChar; Len: Integer; const UseFormat: string;
  Separator: Char = #0): TDateTime;
begin
  Result := StrToDate(PCharText(S, Len), UseFormat, Separator);
end;

function StrToDate(const S: string): TDateTime;
begin
  Result := StrToDate(S, DefaultFormatSettings.ShortDateFormat, #0);
end;

function StrToDate(const S: string; Separator: Char): TDateTime;
begin
  Result := StrToDate(S, DefaultFormatSettings.ShortDateFormat, Separator);
end;

function StrToDate(const S: string; const AFormatSettings: TFormatSettings): TDateTime;
var
  msg: string;
begin
  Result := ReadDate(msg, S, AFormatSettings.ShortDateFormat, AFormatSettings, #0);
  if msg <> '' then
    raise EConvertError.Create(msg);
end;

function StrToTime(const S: string; Separator: Char): TDateTime;
var
  msg: string;
begin
  Result := ReadTime(msg, S, DefaultFormatSettings, Separator);
  if msg <> '' then
    raise EConvertError.Create(msg);
end;

function StrToTime(const S: PChar; Len: Integer; Separator: Char = #0): TDateTime;
begin
  Result := StrToTime(PCharText(S, Len), Separator);
end;

function StrToTime(const S: string): TDateTime;
begin
  Result := StrToTime(S, #0);
end;

function StrToTime(const S: string; const AFormatSettings: TFormatSettings): TDateTime;
var
  msg: string;
begin
  Result := ReadTime(msg, S, AFormatSettings, #0);
  if msg <> '' then
    raise EConvertError.Create(msg);
end;

{ A date and a time, a date or a time as StrToDateTime reads them: the
  date first, blanks between (Free Pascal's SplitDateTimeStr); the
  number of parts found, 0 for none. }
function SplitDateTime(const S: string; const FS: TFormatSettings; out DatePart,
  TimePart: string): Integer;
var
  p: Integer;
  dt: string;
  dummy: TDateTime;
begin
  Result := 0;
  DatePart := '';
  TimePart := '';
  dt := Trim(S);
  if Length(dt) = 0 then
    Exit;
  if (FS.DateSeparator = ' ') and (FS.TimeSeparator = ' ') and (Pos(' ', dt) > 0) then
  begin
    { both separators blanks: a date }
    DatePart := dt;
    Result := 1;
    Exit;
  end;
  p := 1;
  if FS.DateSeparator <> ' ' then
  begin
    while (p < Length(dt)) and not ((dt[p + 1] = #9) or (dt[p + 1] = #10) or
      (dt[p + 1] = #13) or (dt[p + 1] = ' ')) do
      p := p + 1;
  end
  else
  begin
    p := Pos(FS.TimeSeparator, dt);
    if p <> 0 then
      repeat
        p := p - 1;
      until (p = 0) or (dt[p] = #9) or (dt[p] = #10) or (dt[p] = #13) or (dt[p] = ' ');
  end;
  if p = 0 then
    p := Length(dt);
  DatePart := Copy(dt, 1, p);
  TimePart := Trim(Copy(dt, p + 1, Length(dt)));
  if Length(TimePart) <> 0 then
    Result := 2
  else
  begin
    Result := 1;
    { one part, a time: it has the time separator where the two differ,
      or is no date where they are one }
    if ((FS.DateSeparator <> FS.TimeSeparator) and (Pos(FS.TimeSeparator, DatePart) > 0)) or
      ((FS.DateSeparator = FS.TimeSeparator) and not TryStrToDate(DatePart, dummy, FS)) then
    begin
      TimePart := DatePart;
      DatePart := '';
    end;
  end;
end;

function StrToDateTime(const S: string; const AFormatSettings: TFormatSettings): TDateTime;
var
  datePart, timePart: string;
begin
  Result := 0;
  case SplitDateTime(S, AFormatSettings, datePart, timePart) of
    0:
      Result := StrToDate('');
    1:
      if Length(datePart) > 0 then
        Result := StrToDate(datePart, AFormatSettings.ShortDateFormat,
          AFormatSettings.DateSeparator)
      else
        Result := StrToTime(timePart, AFormatSettings);
    2:
      Result := ComposeDateTime(StrToDate(datePart, AFormatSettings.ShortDateFormat,
        AFormatSettings.DateSeparator), StrToTime(timePart, AFormatSettings));
  end;
end;

function StrToDateTime(const S: string): TDateTime;
begin
  Result := StrToDateTime(S, DefaultFormatSettings);
end;

function TryStrToDate(const S: string; out Value: TDateTime; const UseFormat: string;
  Separator: Char = #0): Boolean;
var
  msg: string;
begin
  Result := Length(S) <> 0;
  if Result then
  begin
    Value := ReadDate(msg, S, UseFormat, DefaultFormatSettings, Separator);
    Result := msg = '';
  end;
end;

function TryStrToDate(const S: string; out Value: TDateTime): Boolean;
begin
  Result := TryStrToDate(S, Value, DefaultFormatSettings.ShortDateFormat, #0);
end;

function TryStrToDate(const S: string; out Value: TDateTime; Separator: Char): Boolean;
begin
  Result := TryStrToDate(S, Value, DefaultFormatSettings.ShortDateFormat, Separator);
end;

function TryStrToDate(const S: string; out Value: TDateTime;
  const AFormatSettings: TFormatSettings): Boolean;
var
  msg: string;
begin
  Result := Length(S) <> 0;
  if Result then
  begin
    Value := ReadDate(msg, S, AFormatSettings.ShortDateFormat, AFormatSettings, #0);
    Result := msg = '';
  end;
end;

function TryStrToTime(const S: string; out Value: TDateTime; Separator: Char): Boolean;
var
  msg: string;
begin
  Result := Length(S) <> 0;
  if Result then
  begin
    Value := ReadTime(msg, S, DefaultFormatSettings, Separator);
    Result := msg = '';
  end;
end;

function TryStrToTime(const S: string; out Value: TDateTime): Boolean;
begin
  Result := TryStrToTime(S, Value, #0);
end;

function TryStrToTime(const S: string; out Value: TDateTime;
  const AFormatSettings: TFormatSettings): Boolean;
var
  msg: string;
begin
  Result := Length(S) <> 0;
  if Result then
  begin
    Value := ReadTime(msg, S, AFormatSettings, #0);
    Result := msg = '';
  end;
end;

{ A date, a time, or a date and a time after the last blank before the
  time separator (Free Pascal's TryStrToDateTime, which splits otherwise
  than StrToDateTime). }
function TryStrToDateTime(const S: string; out Value: TDateTime;
  const AFormatSettings: TFormatSettings): Boolean;
var
  i: Integer;
  dtDate, dtTime: TDateTime;
begin
  Result := False;
  i := Pos(AFormatSettings.TimeSeparator, S);
  if i > 0 then
  begin
    while (i > 0) and (S[i] <> ' ') do
      i := i - 1;
    if i > 0 then
    begin
      if not TryStrToDate(Copy(S, 1, i - 1), dtDate, AFormatSettings) then
        Exit;
      if not TryStrToTime(Copy(S, i + 1, Length(S) - i), dtTime, AFormatSettings) then
        Exit;
      Value := ComposeDateTime(dtDate, dtTime);
      Result := True;
    end
    else
      Result := TryStrToTime(S, Value, AFormatSettings);
  end
  else
    Result := TryStrToDate(S, Value, AFormatSettings);
end;

function TryStrToDateTime(const S: string; out Value: TDateTime): Boolean;
begin
  Result := TryStrToDateTime(S, Value, DefaultFormatSettings);
end;

function StrToDateDef(const S: string; const Defvalue: TDateTime; Separator: Char): TDateTime;
begin
  if not TryStrToDate(S, Result, Separator) then
    Result := Defvalue;
end;

function StrToDateDef(const S: string; const Defvalue: TDateTime): TDateTime;
begin
  Result := StrToDateDef(S, Defvalue, #0);
end;

function StrToTimeDef(const S: string; const Defvalue: TDateTime; Separator: Char): TDateTime;
begin
  if not TryStrToTime(S, Result, Separator) then
    Result := Defvalue;
end;

function StrToTimeDef(const S: string; const Defvalue: TDateTime): TDateTime;
begin
  Result := StrToTimeDef(S, Defvalue, #0);
end;

function StrToDateTimeDef(const S: string; const Defvalue: TDateTime;
  const AFormatSettings: TFormatSettings): TDateTime;
begin
  if not TryStrToDateTime(S, Result, AFormatSettings) then
    Result := Defvalue;
end;

function StrToDateTimeDef(const S: string; const Defvalue: TDateTime): TDateTime;
begin
  if not TryStrToDateTime(S, Result) then
    Result := Defvalue;
end;

{ ---- the local clock (P131): pastime's zone, Go's time.Local ---- }

{ A moment's date and time in seconds, the milliseconds dropped, as
  Free Pascal's DecodeDate and DecodeTime give them. }
procedure DateTimeParts(DateTime: TDateTime; out Y, M, D, HH, MM, SS: Integer);
var
  yy, mo, dd, h, mi, s, ms: Word;
begin
  DecodeDate(DateTime, yy, mo, dd);
  DecodeTime(DateTime, h, mi, s, ms);
  Y := yy;
  M := mo;
  D := dd;
  HH := h;
  MM := mi;
  SS := s;
end;

function DateTimeToFileDate(DateTime: TDateTime): Int64;
var
  y, m, d, hh, mm, ss: Integer;
begin
  DateTimeParts(DateTime, y, m, d, hh, mm, ss);
  Result := LocalDateToUnix(y, m, d, hh, mm, ss);
end;

function UniversalToFileDate(DateTime: TDateTime): Int64;
var
  y, m, d, hh, mm, ss: Integer;
begin
  DateTimeParts(DateTime, y, m, d, hh, mm, ss);
  Result := DateToUnix(y, m, d, hh, mm, ss);
end;

function FileDateOf(const T: pastime.TDate): TDateTime;
begin
  Result := ComposeDateTime(EncodeDate(T.Year, T.Month, T.Day),
    EncodeTime(T.Hour, T.Minute, T.Second, 0));
end;

function FileDateToDateTime(Filedate: Int64): TDateTime;
begin
  Result := FileDateOf(UnixToLocalDate(Filedate));
end;

function FileDateToUniversal(Filedate: Int64): TDateTime;
begin
  Result := FileDateOf(UnixToDate(Filedate));
end;

{ The minutes to add to the local time to have UTC, now: -60 in Madrid
  in winter (Free Pascal's -Tzseconds div 60, which it reads once when
  the program starts). }
function GetLocalTimeOffset: Integer;
begin
  Result := -LocalOffset(NowUnix) div 60;
end;

function GetLocalTimeOffset(const DateTime: TDateTime; const InputIsUTC: Boolean;
  out Offset: Integer; out IsDST: Boolean): Boolean;
var
  y, m, d, hh, mm, ss: Integer;
  t, off: Int64;
  abbr: string;
begin
  DateTimeParts(DateTime, y, m, d, hh, mm, ss);
  if InputIsUTC then
    t := DateToUnix(y, m, d, hh, mm, ss)
  else
    t := LocalDateToUnix(y, m, d, hh, mm, ss);
  LocalZoneAt(t, abbr, off, IsDST);
  Offset := -off div 60;
  Result := True;
end;

function GetLocalTimeOffset(const DateTime: TDateTime; const InputIsUTC: Boolean;
  out Offset: Integer): Boolean;
var
  dst: Boolean;
begin
  Result := GetLocalTimeOffset(DateTime, InputIsUTC, Offset, dst);
end;

function GetLocalTimeOffset(const DateTime: TDateTime; const InputIsUTC: Boolean = False): Integer;
var
  dst: Boolean;
begin
  if not GetLocalTimeOffset(DateTime, InputIsUTC, Result, dst) then
    Result := GetLocalTimeOffset();
end;

function UniversalTimeToLocal(UT: TDateTime; TZOffset: Integer): TDateTime;
begin
  if TZOffset > 0 then
    Result := UT + EncodeTime(TZOffset div 60, TZOffset mod 60, 0, 0)
  else if TZOffset < 0 then
    Result := UT - EncodeTime(Abs(TZOffset) div 60, Abs(TZOffset) mod 60, 0, 0)
  else
    Result := UT;
end;

{ UT plus the zone's offset at that moment, to the second (a zone's old
  mean time, Kolkata's +5:21:10 before 1942, has seconds that Free
  Pascal's whole minutes drop), the milliseconds kept. }
function UniversalTimeToLocal(UT: TDateTime): TDateTime;
var
  y, m, d, hh, mm, ss: Integer;
begin
  DateTimeParts(UT, y, m, d, hh, mm, ss);
  Result := UT + LocalOffset(DateToUnix(y, m, d, hh, mm, ss)) / SecsPerDay;
end;

function LocalTimeToUniversal(LT: TDateTime; TZOffset: Integer): TDateTime;
begin
  if TZOffset > 0 then
    Result := LT - EncodeTime(TZOffset div 60, TZOffset mod 60, 0, 0)
  else if TZOffset < 0 then
    Result := LT + EncodeTime(Abs(TZOffset) div 60, Abs(TZOffset) mod 60, 0, 0)
  else
    Result := LT;
end;

{ LT minus the offset of the moment the local clock shows as LT (Go's
  Date for a time the clock skipped or showed twice), to the second. }
function LocalTimeToUniversal(LT: TDateTime): TDateTime;
var
  y, m, d, hh, mm, ss: Integer;
begin
  DateTimeParts(LT, y, m, d, hh, mm, ss);
  Result := LT - LocalOffset(LocalDateToUnix(y, m, d, hh, mm, ss)) / SecsPerDay;
end;

{ ==== system errors (P179) ==== }

{ G+256 is Carry, one byte. The aligned unused word at G+260 is
  compatibility errno. rt_pas already clears the whole eight-byte word
  at +256 when recycling a G. No global table, TLS or growing-stack
  pointer is needed: migration keeps the G itself. See current Go's
  explicit syscall.Errno and io/fs.PathError; this slot exists only
  for Pascal's compatibility last-error API. }
function GetLastOSError: Integer;
begin
  asm amd64 (Result: out rax)
    movl 260(%r14), %eax
  end;
  asm arm64 (Result: out x0)
    ldr w0, [x28, #260]
  end;
end;

procedure SetLastOSError(Code: Integer);
begin
  if (Code < 0) or (Code > 2147483647) then
    raise EArgumentOutOfRangeException.Create('system error code must fit a nonnegative Int32');
  asm amd64 (Code: in rax)
    movl %eax, 260(%r14)
  end;
  asm arm64 (Code: in x0)
    str w0, [x28, #260]
  end;
end;

{ Linux asm-generic/errno[-base].h supplies the stable numeric codes;
  current Go syscall/zerrors_linux_amd64.go supplies the English
  descriptions. Newer kernel codes133/134 are included too. Messages
  are deterministic, not process-global locale state. }
function SysErrorMessage(ErrorCode: Integer): string;
begin
  case ErrorCode of
    0: Result := 'success';
    1: Result := 'operation not permitted';
    2: Result := 'no such file or directory';
    3: Result := 'no such process';
    4: Result := 'interrupted system call';
    5: Result := 'input/output error';
    6: Result := 'no such device or address';
    7: Result := 'argument list too long';
    8: Result := 'exec format error';
    9: Result := 'bad file descriptor';
    10: Result := 'no child processes';
    11: Result := 'resource temporarily unavailable';
    12: Result := 'cannot allocate memory';
    13: Result := 'permission denied';
    14: Result := 'bad address';
    15: Result := 'block device required';
    16: Result := 'device or resource busy';
    17: Result := 'file exists';
    18: Result := 'invalid cross-device link';
    19: Result := 'no such device';
    20: Result := 'not a directory';
    21: Result := 'is a directory';
    22: Result := 'invalid argument';
    23: Result := 'too many open files in system';
    24: Result := 'too many open files';
    25: Result := 'inappropriate ioctl for device';
    26: Result := 'text file busy';
    27: Result := 'file too large';
    28: Result := 'no space left on device';
    29: Result := 'illegal seek';
    30: Result := 'read-only file system';
    31: Result := 'too many links';
    32: Result := 'broken pipe';
    33: Result := 'numerical argument out of domain';
    34: Result := 'numerical result out of range';
    35: Result := 'resource deadlock avoided';
    36: Result := 'file name too long';
    37: Result := 'no locks available';
    38: Result := 'function not implemented';
    39: Result := 'directory not empty';
    40: Result := 'too many levels of symbolic links';
    42: Result := 'no message of desired type';
    43: Result := 'identifier removed';
    44: Result := 'channel number out of range';
    45: Result := 'level 2 not synchronized';
    46: Result := 'level 3 halted';
    47: Result := 'level 3 reset';
    48: Result := 'link number out of range';
    49: Result := 'protocol driver not attached';
    50: Result := 'no CSI structure available';
    51: Result := 'level 2 halted';
    52: Result := 'invalid exchange';
    53: Result := 'invalid request descriptor';
    54: Result := 'exchange full';
    55: Result := 'no anode';
    56: Result := 'invalid request code';
    57: Result := 'invalid slot';
    59: Result := 'bad font file format';
    60: Result := 'device not a stream';
    61: Result := 'no data available';
    62: Result := 'timer expired';
    63: Result := 'out of streams resources';
    64: Result := 'machine is not on the network';
    65: Result := 'package not installed';
    66: Result := 'object is remote';
    67: Result := 'link has been severed';
    68: Result := 'advertise error';
    69: Result := 'srmount error';
    70: Result := 'communication error on send';
    71: Result := 'protocol error';
    72: Result := 'multihop attempted';
    73: Result := 'RFS specific error';
    74: Result := 'bad message';
    75: Result := 'value too large for defined data type';
    76: Result := 'name not unique on network';
    77: Result := 'file descriptor in bad state';
    78: Result := 'remote address changed';
    79: Result := 'can not access a needed shared library';
    80: Result := 'accessing a corrupted shared library';
    81: Result := '.lib section in a.out corrupted';
    82: Result := 'attempting to link in too many shared libraries';
    83: Result := 'cannot exec a shared library directly';
    84: Result := 'invalid or incomplete multibyte or wide character';
    85: Result := 'interrupted system call should be restarted';
    86: Result := 'streams pipe error';
    87: Result := 'too many users';
    88: Result := 'socket operation on non-socket';
    89: Result := 'destination address required';
    90: Result := 'message too long';
    91: Result := 'protocol wrong type for socket';
    92: Result := 'protocol not available';
    93: Result := 'protocol not supported';
    94: Result := 'socket type not supported';
    95: Result := 'operation not supported';
    96: Result := 'protocol family not supported';
    97: Result := 'address family not supported by protocol';
    98: Result := 'address already in use';
    99: Result := 'cannot assign requested address';
    100: Result := 'network is down';
    101: Result := 'network is unreachable';
    102: Result := 'network dropped connection on reset';
    103: Result := 'software caused connection abort';
    104: Result := 'connection reset by peer';
    105: Result := 'no buffer space available';
    106: Result := 'transport endpoint is already connected';
    107: Result := 'transport endpoint is not connected';
    108: Result := 'cannot send after transport endpoint shutdown';
    109: Result := 'too many references: cannot splice';
    110: Result := 'connection timed out';
    111: Result := 'connection refused';
    112: Result := 'host is down';
    113: Result := 'no route to host';
    114: Result := 'operation already in progress';
    115: Result := 'operation now in progress';
    116: Result := 'stale file handle';
    117: Result := 'structure needs cleaning';
    118: Result := 'not a XENIX named type file';
    119: Result := 'no XENIX semaphores available';
    120: Result := 'is a named type file';
    121: Result := 'remote I/O error';
    122: Result := 'disk quota exceeded';
    123: Result := 'no medium found';
    124: Result := 'wrong medium type';
    125: Result := 'operation canceled';
    126: Result := 'required key not available';
    127: Result := 'key has expired';
    128: Result := 'key has been revoked';
    129: Result := 'key was rejected by service';
    130: Result := 'owner died';
    131: Result := 'state not recoverable';
    132: Result := 'operation not possible due to RF-kill';
    133: Result := 'memory page has hardware error';
    134: Result := 'wrong file type for the intended operation';
  else
    Result := 'unknown system error ' + IntToStr(ErrorCode);
  end;
end;

procedure RaiseLastOSError(ErrorCode: Integer);
var
  error: EOSError;
begin
  error := EOSError.Create(SysErrorMessage(ErrorCode));
  error.ErrorCode := ErrorCode;
  raise error;
end;

procedure RaiseLastOSError;
begin
  RaiseLastOSError(GetLastOSError);
end;

function TSysError.Failed: Boolean;
begin
  Result := Code <> 0;
end;

function TSysError.Message: string;
begin
  Result := SysErrorMessage(Code);
  if Operation <> '' then Result := Operation + ': ' + Result;
  if Path <> '' then Result := Path + ': ' + Result;
end;

procedure TSysError.RaiseError;
var
  error: EOSError;
begin
  if Code = 0 then Exit;
  error := EOSError.Create(Message);
  error.ErrorCode := Code;
  raise error;
end;

{ ==== bounded file I/O (P130) ==== }

function SystemNumber(AmdNumber, ArmNumber: Integer): Integer;
begin
  if Amd64 then Result := AmdNumber else Result := ArmNumber;
end;

procedure SystemError(out Error: TSysError; Code: Integer;
  const Operation, Path: string);
begin
  Error.Code := Code;
  Error.Operation := Operation;
  Error.Path := Path;
end;

function CompatibilityResult(Code: Integer): Boolean;
begin
  SetLastOSError(Code);
  Result := Code = 0;
end;

function ValidSystemPath(const Path: string): Boolean;
begin
  Result := Pos(#0, Path) = 0;
end;

function ValidFileHandle(Handle: THandle): Boolean;
begin
  { Linux consumes signed int32 descriptors. Integer is wider: never
    let truncation alias a different live file, including during close. }
  Result := (Handle >= 0) and (Handle <= 2147483647);
end;

function ValidDirectoryBase(Handle: THandle; const Path: string): Boolean;
begin
  { Absolute Linux paths ignore dirfd. AT_FDCWD is the sole special base. }
  Result := IsAbsolutePath(Path) or (Handle = CurrentDirectoryHandle) or
    ValidFileHandle(Handle);
end;

{ Current Go os/file_unix.go: CLOEXEC is part of open, not a racy
  fcntl after it. Explicit base descriptors survive concurrent chdir.
  Append an owned NUL directly to avoid the additional PChar snapshot
  copy; keep its string alive through GC and stack migration. }
function TryOpenFileAt(DirectoryHandle: THandle; const Path: string;
  Flags, Rights: Integer; out Handle: THandle; out Error: TSysError): Boolean;
var
  terminated: string;
begin
  Handle := -1;
  SystemError(Error, 0, 'open', Path);
  if not ValidSystemPath(Path) or (Rights < 0) or (Rights > 4095) or
    (Flags < 0) or (Flags > 2147483647) then
    Error.Code := 22
  else if not ValidDirectoryBase(DirectoryHandle, Path) then Error.Code := 9
  else
  begin
    terminated := Path + #0;
    repeat
      Handle := OsOpenAt(DirectoryHandle, Integer(@terminated[1]), Flags or 524288, Rights);
    until Handle <> -4;
    if Handle < 0 then
    begin
      Error.Code := -Handle;
      Handle := -1;
    end;
  end;
  Result := Error.Code = 0;
end;

function FileOpen(const FileName: string; Mode: Integer): THandle;
var
  error: TSysError;
begin
  Result := -1;
  if (Mode < 0) or (Mode > 2) then
  begin
    SetLastOSError(22);
    Exit;
  end;
  TryOpenFileAt(CurrentDirectoryHandle, FileName, Mode, 0, Result, error);
  CompatibilityResult(error.Code);
end;

function FileCreate(const FileName: string; Rights: Integer): THandle;
var
  error: TSysError;
begin
  TryOpenFileAt(CurrentDirectoryHandle, FileName, ORdwr or OCreat or OTrunc,
    Rights, Result, error);
  CompatibilityResult(error.Code);
end;

function FileCreate(const FileName: string): THandle;
begin
  Result := FileCreate(FileName, 438); { 0666, subject to process umask }
end;

{ Linux close releases the fd even on EINTR. Retrying could close an
  unrelated descriptor already reused by another G. Current Go's
  internal/poll.SysFile.destroy also calls close exactly once. }
function TryFileClose(Handle: THandle; out Error: TSysError): Boolean;
var
  answer: Integer;
begin
  SystemError(Error, 0, 'close', '');
  if not ValidFileHandle(Handle) then Error.Code := 9
  else
  begin
    answer := OsClose(Handle);
    if answer < 0 then Error.Code := -answer;
  end;
  Result := Error.Code = 0;
end;

procedure FileClose(Handle: THandle);
var
  error: TSysError;
begin
  TryFileClose(Handle, error);
  CompatibilityResult(error.Code);
end;

function BufferRange(Size, Offset, Count: Integer): Boolean;
begin
  { No Offset+Count overflow and no pointer formed for an empty range. }
  Result := (Offset >= 0) and (Count >= 0) and (Offset <= Size) and
    (Count <= Size - Offset);
end;

{ One transfer, not "read all": a short read and EOF are successful.
  EINTR retries. Pollable EAGAIN parks G; a blocking foreign fd and
  regular-disk I/O use the central runtime M/P syscall protocol. }
function TryFileRead(Handle: THandle; var Buffer: TBytes; Offset, Count: Integer;
  out Transferred: Integer; out Error: TSysError): Boolean;
var
  answer, want: Integer;
begin
  Transferred := 0;
  SystemError(Error, 0, 'read', '');
  if not BufferRange(Length(Buffer), Offset, Count) then Error.Code := 22
  else if not ValidFileHandle(Handle) then Error.Code := 9
  else if Count > 0 then
  begin
    want := Count;
    if want > 1073741824 then want := 1073741824; { Go's maxRW }
    repeat
      answer := OsRead(Handle, Integer(@Buffer[Offset]), want);
      if answer = -11 then
      begin
        answer := WaitIo(Handle, 1);
        if answer < 0 then Break;
        answer := -11;
      end;
    until (answer <> -4) and (answer <> -11);
    if answer < 0 then Error.Code := -answer else Transferred := answer;
  end;
  Result := Error.Code = 0;
end;

function TryFileWrite(Handle: THandle; const Buffer: TBytes; Offset, Count: Integer;
  out Transferred: Integer; out Error: TSysError): Boolean;
var
  answer, want: Integer;
begin
  Transferred := 0;
  SystemError(Error, 0, 'write', '');
  if not BufferRange(Length(Buffer), Offset, Count) then Error.Code := 22
  else if not ValidFileHandle(Handle) then Error.Code := 9
  else if Count > 0 then
  begin
    want := Count;
    if want > 1073741824 then want := 1073741824;
    repeat
      answer := OsWrite(Handle, Integer(@Buffer[Offset]), want);
      if answer = -11 then
      begin
        answer := WaitIo(Handle, 4);
        if answer < 0 then Break;
        answer := -11;
      end;
    until (answer <> -4) and (answer <> -11);
    if answer < 0 then Error.Code := -answer else Transferred := answer;
  end;
  Result := Error.Code = 0;
end;

function FileRead(Handle: THandle; var Buffer: TBytes; Count: Integer): Integer;
var
  error: TSysError;
begin
  TryFileRead(Handle, Buffer, 0, Count, Result, error);
  if not CompatibilityResult(error.Code) then Result := -1;
end;

function FileWrite(Handle: THandle; const Buffer: TBytes; Count: Integer): Integer;
var
  error: TSysError;
begin
  TryFileWrite(Handle, Buffer, 0, Count, Result, error);
  if not CompatibilityResult(error.Code) then Result := -1;
end;

function TryFileReadAt(Handle: THandle; var Buffer: TBytes; Offset, Count,
  FileOffset: Integer; out Transferred: Integer; out Error: TSysError): Boolean;
var
  answer, want: Integer;
begin
  Transferred := 0;
  SystemError(Error, 0, 'readat', '');
  if not BufferRange(Length(Buffer), Offset, Count) or (FileOffset < 0) then Error.Code := 22
  else if not ValidFileHandle(Handle) then Error.Code := 9
  else if Count > 0 then
  begin
    want := Count;
    if want > 1073741824 then want := 1073741824;
    repeat
      answer := Syscall(SystemNumber(17, 67), Handle, Integer(@Buffer[Offset]), want, FileOffset);
    until answer <> -4;
    if answer < 0 then Error.Code := -answer else Transferred := answer;
  end;
  Result := Error.Code = 0;
end;

function TryFileWriteAt(Handle: THandle; const Buffer: TBytes; Offset, Count,
  FileOffset: Integer; out Transferred: Integer; out Error: TSysError): Boolean;
var
  answer, want, flags: Integer;
begin
  Transferred := 0;
  SystemError(Error, 0, 'writeat', '');
  if not BufferRange(Length(Buffer), Offset, Count) or (FileOffset < 0) then Error.Code := 22
  else if not ValidFileHandle(Handle) then Error.Code := 9
  else if Count > 0 then
  begin
    { Linux pwrite ignores its offset on an O_APPEND fd. Like current
      Go os.File.WriteAt, reject append rather than silently appending.
      A raw owned handle has no cached flags, so check its real flags. }
    flags := Syscall(SystemNumber(72, 25), Handle, 3);
    if flags < 0 then
    begin
      Error.Code := -flags;
      Result := False;
      Exit;
    end;
    if (flags and OAppend) <> 0 then
    begin
      Error.Code := 22;
      Result := False;
      Exit;
    end;
    want := Count;
    if want > 1073741824 then want := 1073741824;
    repeat
      answer := Syscall(SystemNumber(18, 68), Handle, Integer(@Buffer[Offset]), want, FileOffset);
    until answer <> -4;
    if answer < 0 then Error.Code := -answer else Transferred := answer;
  end;
  Result := Error.Code = 0;
end;

function FileSeek(Handle: THandle; Offset, Origin: Integer): Integer;
begin
  if not ValidFileHandle(Handle) then
  begin
    SetLastOSError(9);
    Result := -1;
    Exit;
  end;
  if (Origin < 0) or (Origin > 4) then
  begin
    SetLastOSError(22);
    Result := -1;
    Exit;
  end;
  repeat
    Result := Syscall(SystemNumber(8, 62), Handle, Offset, Origin);
  until Result <> -4;
  if Result < 0 then
  begin
    SetLastOSError(-Result);
    Result := -1;
  end
  else SetLastOSError(0);
end;

function FileFlush(Handle: THandle): Boolean;
var
  answer: Integer;
begin
  if not ValidFileHandle(Handle) then
  begin
    Result := CompatibilityResult(9);
    Exit;
  end;
  repeat
    answer := Syscall(SystemNumber(74, 82), Handle);
  until answer <> -4;
  if answer < 0 then Result := CompatibilityResult(-answer)
  else Result := CompatibilityResult(0);
end;

function FileTruncate(Handle: THandle; Size: Integer): Boolean;
var
  answer: Integer;
begin
  if not ValidFileHandle(Handle) then
  begin
    Result := CompatibilityResult(9);
    Exit;
  end;
  if Size < 0 then
  begin
    Result := CompatibilityResult(22);
    Exit;
  end;
  repeat
    answer := Syscall(SystemNumber(77, 46), Handle, Size);
  until answer <> -4;
  if answer < 0 then Result := CompatibilityResult(-answer)
  else Result := CompatibilityResult(0);
end;

{ ==== metadata (P130) ==== }

type
  TStatXBytes = array[0..255] of Byte;

{ Linux UAPI linux/stat.h and statx(2): the same 256-byte ABI on
  amd64 and arm64, unlike struct stat. Read individual fields with
  Move, not an unaligned typed dereference or a compiler-layout guess.
  Current Go os/stat_linux.go supplies the file-kind mapping; statx
  adds exact nanoseconds and explicit availability of birth time. }
function StatWord(const Data: TStatXBytes; Offset: Integer): Integer;
var value: Word;
begin
  Move(Data[Offset], value, 2);
  Result := value;
end;

function StatLong(const Data: TStatXBytes; Offset: Integer): Integer;
var value: LongWord;
begin
  Move(Data[Offset], value, 4);
  Result := value;
end;

function StatQuad(const Data: TStatXBytes; Offset: Integer): Int64;
begin
  Move(Data[Offset], Result, 8);
end;

procedure StatTime(const Data: TStatXBytes; Offset: Integer; out Value: TFileTime);
begin
  Value.Seconds := StatQuad(Data, Offset);
  Value.Nanoseconds := StatLong(Data, Offset + 8);
end;

function TFileInfo.Has(Fields: Integer): Boolean;
begin
  Result := (ValidFields and Fields) = Fields;
end;

function TFileInfo.IsDirectory: Boolean;
begin
  Result := Has(fiType) and ((Mode and 61440) = 16384);
end;

function TFileInfo.IsRegular: Boolean;
begin
  Result := Has(fiType) and ((Mode and 61440) = 32768);
end;

function TFileInfo.IsSymbolicLink: Boolean;
begin
  Result := Has(fiType) and ((Mode and 61440) = 40960);
end;

function SystemFileInfo(DirectoryHandle: THandle; const Path: string;
  Flags: Integer; out Info: TFileInfo; out Error: TSysError): Boolean;
var
  data: TStatXBytes;
  terminated: string;
  answer: Integer;
begin
  Info := Default(TFileInfo);
  SystemError(Error, 0, 'stat', Path);
  if not ValidSystemPath(Path) then Error.Code := 22
  else if not ValidDirectoryBase(DirectoryHandle, Path) then Error.Code := 9
  else
  begin
    terminated := Path + #0;
    repeat
      answer := Syscall(SystemNumber(332, 291), DirectoryHandle,
        Integer(@terminated[1]), Flags or 2048, 2047 or fiCreated or fiMount, Integer(@data[0]));
    until answer <> -4;
    if answer < 0 then Error.Code := -answer
    else
    begin
      Info.ValidFields := StatLong(data, 0);
      Info.Mode := StatWord(data, 28);
      Info.Links := StatLong(data, 16);
      Info.UserId := StatLong(data, 20);
      Info.GroupId := StatLong(data, 24);
      Info.Inode := StatQuad(data, 32);
      Info.Size := StatQuad(data, 40);
      Info.Attributes := StatQuad(data, 8);
      Info.AttributeMask := StatQuad(data, 56);
      StatTime(data, 64, Info.Accessed);
      StatTime(data, 80, Info.Created);
      StatTime(data, 96, Info.Changed);
      StatTime(data, 112, Info.Modified);
      Info.DeviceMajor := StatLong(data, 136);
      Info.DeviceMinor := StatLong(data, 140);
      Info.MountId := StatQuad(data, 144);
    end;
  end;
  Result := Error.Code = 0;
end;

function TryFileInfoAt(DirectoryHandle: THandle; const Path: string;
  FollowLink: Boolean; out Info: TFileInfo; out Error: TSysError): Boolean;
var flags: Integer;
begin
  flags := 0;
  if not FollowLink then flags := 256;
  Result := SystemFileInfo(DirectoryHandle, Path, flags, Info, Error);
end;

function TryHandleInfo(Handle: THandle; out Info: TFileInfo;
  out Error: TSysError): Boolean;
begin
  if not ValidFileHandle(Handle) then
  begin
    Info := Default(TFileInfo);
    SystemError(Error, 9, 'stat', '');
    Result := False;
  end
  else Result := SystemFileInfo(Handle, '', 4096, Info, Error);
end;

function FileExists(const FileName: string; FollowLink: Boolean): Boolean;
var info: TFileInfo; error: TSysError;
begin
  Result := TryFileInfoAt(CurrentDirectoryHandle, FileName, FollowLink, info, error);
  CompatibilityResult(error.Code);
  Result := Result and info.Has(fiType) and not info.IsDirectory;
end;

function DirectoryExists(const Directory: string; FollowLink: Boolean): Boolean;
var info: TFileInfo; error: TSysError;
begin
  Result := TryFileInfoAt(CurrentDirectoryHandle, Directory, FollowLink, info, error);
  CompatibilityResult(error.Code);
  Result := Result and info.IsDirectory;
end;

function FileAttributes(const Path: string; const Info: TFileInfo): Integer;
var name: string;
begin
  Result := faArchive;
  if Info.IsDirectory then Result := Result or faDirectory;
  if Info.IsSymbolicLink then Result := Result or faSymLink;
  if not Info.IsRegular and not Info.IsDirectory and not Info.IsSymbolicLink then
    Result := Result or faSysFile;
  if Info.Has(fiMode) and ((Info.Mode and 128) = 0) then Result := Result or faReadOnly;
  name := ExtractFileName(Path);
  if (Length(name) >= 2) and (name[1] = '.') and (name[2] <> '.') then
    Result := Result or faHidden;
end;

function FileGetAttr(const FileName: string): Integer;
var info: TFileInfo; error: TSysError;
begin
  Result := -1;
  if TryFileInfoAt(CurrentDirectoryHandle, FileName, False, info, error) then
    Result := FileAttributes(FileName, info);
  CompatibilityResult(error.Code);
end;

function FileAge(const FileName: string): Int64;
var info: TFileInfo; error: TSysError;
begin
  Result := -1;
  if TryFileInfoAt(CurrentDirectoryHandle, FileName, True, info, error) then
    if info.IsDirectory then error.Code := 21
    else if not info.Has(fiModified) then error.Code := 95
    else Result := info.Modified.Seconds;
  CompatibilityResult(error.Code);
end;

function FileAge(const FileName: string; out FileDateTime: TDateTime;
  FollowLink: Boolean): Boolean;
var info: TFileInfo; error: TSysError;
begin
  FileDateTime := 0;
  Result := TryFileInfoAt(CurrentDirectoryHandle, FileName, FollowLink, info, error);
  if Result and not info.Has(fiModified) then error.Code := 95;
  Result := CompatibilityResult(error.Code);
  if Result then FileDateTime := FileDateToDateTime(info.Modified.Seconds);
end;

function FileAgeUTC(const FileName: string; out FileDateTimeUTC: TDateTime;
  FollowLink: Boolean): Boolean;
var info: TFileInfo; error: TSysError;
begin
  FileDateTimeUTC := 0;
  Result := TryFileInfoAt(CurrentDirectoryHandle, FileName, FollowLink, info, error);
  if Result and not info.Has(fiModified) then error.Code := 95;
  Result := CompatibilityResult(error.Code);
  if Result then FileDateTimeUTC := FileDateToUniversal(info.Modified.Seconds);
end;

function FileGetDate(Handle: THandle): Int64;
var info: TFileInfo; error: TSysError;
begin
  Result := -1;
  if TryHandleInfo(Handle, info, error) then
    if not info.Has(fiModified) then error.Code := 95
    else Result := info.Modified.Seconds;
  CompatibilityResult(error.Code);
end;

function SystemSetFileTimes(DirectoryHandle: THandle; const Path: string;
  Flags: Integer; const Accessed, Modified: TFileTime; out Error: TSysError): Boolean;
var times: array[0..3] of Int64; terminated: string; answer: Integer;
begin
  SystemError(Error, 0, 'set times', Path);
  if not ValidSystemPath(Path) or (Accessed.Nanoseconds < 0) or
    (Accessed.Nanoseconds >= 1000000000) or (Modified.Nanoseconds < 0) or
    (Modified.Nanoseconds >= 1000000000) then Error.Code := 22
  else if not ValidDirectoryBase(DirectoryHandle, Path) then Error.Code := 9
  else
  begin
    times[0] := Accessed.Seconds;
    times[1] := Accessed.Nanoseconds;
    times[2] := Modified.Seconds;
    times[3] := Modified.Nanoseconds;
    terminated := Path + #0;
    repeat
      answer := Syscall(SystemNumber(280, 88), DirectoryHandle,
        Integer(@terminated[1]), Integer(@times[0]), Flags);
    until answer <> -4;
    if answer < 0 then Error.Code := -answer;
  end;
  Result := Error.Code = 0;
end;

function TrySetFileTimesAt(DirectoryHandle: THandle; const Path: string;
  FollowLink: Boolean; const Accessed, Modified: TFileTime;
  out Error: TSysError): Boolean;
var flags: Integer;
begin
  flags := 0;
  if not FollowLink then flags := 256;
  Result := SystemSetFileTimes(DirectoryHandle, Path, flags, Accessed, Modified, Error);
end;

function FileSetDate(const FileName: string; Age: Int64): Integer;
var stamp: TFileTime; error: TSysError;
begin
  stamp.Seconds := Age;
  stamp.Nanoseconds := 0;
  TrySetFileTimesAt(CurrentDirectoryHandle, FileName, True, stamp, stamp, error);
  CompatibilityResult(error.Code);
  Result := error.Code;
end;

function FileSetDate(Handle: THandle; Age: Int64): Integer;
var stamp: TFileTime; error: TSysError;
begin
  stamp.Seconds := Age;
  stamp.Nanoseconds := 0;
  if not ValidFileHandle(Handle) then SystemError(error, 9, 'set times', '')
  else SystemSetFileTimes(Handle, '', 4096, stamp, stamp, error);
  CompatibilityResult(error.Code);
  Result := error.Code;
end;

function FileSetDate(const FileName: string; const FileDateTime: TDateTime): Integer;
begin
  Result := FileSetDate(FileName, DateTimeToFileDate(FileDateTime));
end;

function FileSetDateUTC(const FileName: string; const FileDateTimeUTC: TDateTime): Integer;
begin
  Result := FileSetDate(FileName, UniversalToFileDate(FileDateTimeUTC));
end;

function TrySetFileModeAt(DirectoryHandle: THandle; const Path: string;
  Rights: Integer; out Error: TSysError): Boolean;
var terminated: string; answer: Integer;
begin
  SystemError(Error, 0, 'chmod', Path);
  if not ValidSystemPath(Path) or (Rights < 0) or (Rights > 4095) then Error.Code := 22
  else if not ValidDirectoryBase(DirectoryHandle, Path) then Error.Code := 9
  else
  begin
    terminated := Path + #0;
    repeat
      answer := Syscall(SystemNumber(268, 53), DirectoryHandle, Integer(@terminated[1]), Rights);
    until answer <> -4;
    if answer < 0 then Error.Code := -answer;
  end;
  Result := Error.Code = 0;
end;

function TryDeleteFileAt(DirectoryHandle: THandle; const Path: string;
  IsDirectory: Boolean; out Error: TSysError): Boolean;
var terminated: string; flags, answer: Integer;
begin
  SystemError(Error, 0, 'remove', Path);
  if not ValidSystemPath(Path) then Error.Code := 22
  else if not ValidDirectoryBase(DirectoryHandle, Path) then Error.Code := 9
  else
  begin
    flags := 0;
    if IsDirectory then flags := 512;
    terminated := Path + #0;
    repeat
      answer := Syscall(SystemNumber(263, 35), DirectoryHandle, Integer(@terminated[1]), flags);
    until answer <> -4;
    if answer < 0 then Error.Code := -answer;
  end;
  Result := Error.Code = 0;
end;

function TryRenameFileAt(OldDirectoryHandle: THandle; const OldPath: string;
  NewDirectoryHandle: THandle; const NewPath: string; ReplaceExisting: Boolean;
  out Error: TSysError): Boolean;
var oldTerminated, newTerminated: string; flags, answer: Integer;
begin
  SystemError(Error, 0, 'rename', OldPath + ' -> ' + NewPath);
  if not ValidSystemPath(OldPath) or not ValidSystemPath(NewPath) then Error.Code := 22
  else if not ValidDirectoryBase(OldDirectoryHandle, OldPath) or
    not ValidDirectoryBase(NewDirectoryHandle, NewPath) then Error.Code := 9
  else
  begin
    flags := 0;
    if not ReplaceExisting then flags := 1; { RENAME_NOREPLACE: atomic, no exists/check race }
    oldTerminated := OldPath + #0;
    newTerminated := NewPath + #0;
    repeat
      answer := Syscall(SystemNumber(316, 276), OldDirectoryHandle, Integer(@oldTerminated[1]),
        NewDirectoryHandle, Integer(@newTerminated[1]), flags);
    until answer <> -4;
    if answer < 0 then Error.Code := -answer;
  end;
  Result := Error.Code = 0;
end;

function DeleteFile(const FileName: string): Boolean;
var error: TSysError;
begin
  TryDeleteFileAt(CurrentDirectoryHandle, FileName, False, error);
  Result := CompatibilityResult(error.Code);
end;

function RenameFile(const OldName, NewName: string): Boolean;
var error: TSysError;
begin
  TryRenameFileAt(CurrentDirectoryHandle, OldName, CurrentDirectoryHandle, NewName, True, error);
  Result := CompatibilityResult(error.Code);
end;

function CreateDir(const Directory: string): Boolean;
var error: TSysError;
begin
  TryCreateDirectoryAt(CurrentDirectoryHandle, Directory, 511, error);
  Result := CompatibilityResult(error.Code);
end;

function RemoveDir(const Directory: string): Boolean;
var error: TSysError;
begin
  TryDeleteFileAt(CurrentDirectoryHandle, Directory, True, error);
  Result := CompatibilityResult(error.Code);
end;

{ ==== directory cursors (P130) ==== }

constructor TDirectoryReader.Create(Handle: THandle; const Path: string);
begin
  FHandle := Handle;
  FPath := Path;
end;

function TryOpenDirectoryAt(DirectoryHandle: THandle; const Path: string;
  out Reader: TDirectoryReader; out Error: TSysError): Boolean;
var handle: THandle; closeError: TSysError;
begin
  Reader := nil;
  Result := TryOpenFileAt(DirectoryHandle, Path, ODirectory, 0, handle, Error);
  if not Result then Exit;
  try
    Reader := TDirectoryReader.Create(handle, Path);
  except
    TryFileClose(handle, closeError);
    raise;
  end;
end;

function TDirectoryReader.CloseDirectory(out Error: TSysError): Boolean;
var owned: THandle;
begin
  owned := FHandle;
  FHandle := -1;
  if owned < 0 then
  begin
    SystemError(Error, 0, 'close directory', FPath);
    Result := True;
  end
  else
  begin
    Result := TryFileClose(owned, Error);
    Error.Operation := 'close directory';
    Error.Path := FPath;
  end;
end;

destructor TDirectoryReader.Destroy;
var error: TSysError;
begin
  CloseDirectory(error);
  inherited Destroy;
end;

{ Current Go os/dir_unix.go: bounded dirent parsing, 8192-byte reads,
  skip dot entries before allocating. Linux getdents64(2) gives name
  offset19 and record length at16; inode0 is valid on Linux/FUSE.
  Unlike Go's silent malformed-record break, report EIO explicitly. }
function TDirectoryReader.Next(out Name: string; out Error: TSysError): Boolean;
var recordSize, start, finish, answer, nameSize: Integer;
begin
  Name := '';
  SystemError(Error, 0, 'read directory', FPath);
  Result := False;
  if FEnded then Exit;
  if FHandle < 0 then
  begin
    Error.Code := 9;
    Exit;
  end;
  while True do
  begin
    if FPosition >= FCount then
    begin
      repeat
        answer := OsGetdents(FHandle, Integer(@FBuffer[0]), SizeOf(FBuffer));
      until answer <> -4;
      if answer < 0 then
      begin
        Error.Code := -answer;
        Exit;
      end;
      if answer = 0 then
      begin
        FEnded := True;
        CloseDirectory(Error);
        Exit;
      end;
      FPosition := 0;
      FCount := answer;
    end;
    if FCount - FPosition < 20 then
    begin
      Error.Code := 5;
      Exit;
    end;
    recordSize := Integer(FBuffer[FPosition + 16]) or (Integer(FBuffer[FPosition + 17]) shl 8);
    if (recordSize < 20) or (recordSize > FCount - FPosition) then
    begin
      Error.Code := 5;
      Exit;
    end;
    start := FPosition + 19;
    finish := start;
    while (finish < FPosition + recordSize) and (FBuffer[finish] <> 0) do Inc(finish);
    if (finish = start) or (finish = FPosition + recordSize) then
    begin
      Error.Code := 5;
      Exit;
    end;
    FPosition := FPosition + recordSize;
    nameSize := finish - start;
    if (FBuffer[start] = 46) and ((nameSize = 1) or
      ((nameSize = 2) and (FBuffer[start + 1] = 46))) then Continue;
    SetLength(Name, nameSize);
    Move(FBuffer[start], Name[1], nameSize);
    Result := True;
    Exit;
  end;
end;

{ Current Go unicode/utf8.DecodeRuneInString: invalid encodings consume
  exactly one byte. Only the extent is needed here; the same validation
  excludes overlong encodings, surrogates and values above U+10FFFF. }
function Utf8Width(const S: string; Index: Integer): Integer;
var first, second, width, k: Integer;
begin
  Result := 1;
  first := Ord(S[Index]);
  if first < 128 then Exit;
  if (first >= 194) and (first <= 223) then width := 2
  else if (first >= 224) and (first <= 239) then width := 3
  else if (first >= 240) and (first <= 244) then width := 4
  else Exit;
  if width > Length(S) - Index + 1 then Exit;
  second := Ord(S[Index + 1]);
  if (second < 128) or (second > 191) then Exit;
  if ((first = 224) and (second < 160)) or
    ((first = 237) and (second > 159)) or
    ((first = 240) and (second < 144)) or
    ((first = 244) and (second > 143)) then Exit;
  for k := 2 to width - 1 do
    if (Ord(S[Index + k]) < 128) or (Ord(S[Index + k]) > 191) then Exit;
  Result := width;
end;

{ Pascal filename patterns: '*' and '?', other bytes literal (including
  backslash/brackets). '?' consumes one UTF-8 character. Iterative star
  backtracking has no recursive/exponential search tree. }
function MatchesFileName(const Pattern, Name: string): Boolean;
var p, n, star, retryAt: Integer;
begin
  Result := False;
  if (Pos('/', Pattern) > 0) or (Pos('/', Name) > 0) then Exit;
  p := 1;
  n := 1;
  star := 0;
  retryAt := 0;
  while n <= Length(Name) do
  begin
    if (p <= Length(Pattern)) and (Pattern[p] = '*') then
    begin
      star := p;
      retryAt := n;
      Inc(p);
    end
    else if (p <= Length(Pattern)) and (Pattern[p] = '?') then
    begin
      Inc(p);
      n := n + Utf8Width(Name, n);
    end
    else if (p <= Length(Pattern)) and (Pattern[p] = Name[n]) then
    begin
      Inc(p);
      Inc(n);
    end
    else if (star <> 0) and (retryAt <= Length(Name)) then
    begin
      retryAt := retryAt + Utf8Width(Name, retryAt);
      n := retryAt;
      p := star + 1;
    end
    else Exit;
  end;
  while (p <= Length(Pattern)) and (Pattern[p] = '*') do Inc(p);
  Result := p > Length(Pattern);
end;

function TSearchRec.IsDirectory: Boolean;
begin
  Result := (Attr and faDirectory) <> 0;
end;

function TSearchRec.IsCurrentOrParentDir: Boolean;
begin
  Result := (Name = '.') or (Name = '..');
end;

procedure FindClose(var Search: TSearchRec);
begin
  if Search.FReader <> nil then Search.FReader.Free;
  Search.FReader := nil;
end;

procedure SearchInfo(var Search: TSearchRec; const Name: string; const Info: TFileInfo);
begin
  Search.Name := Name;
  Search.Size := Info.Size;
  Search.Time := Info.Modified.Seconds;
  Search.Mode := Info.Mode;
  Search.Attr := FileAttributes(Name, Info);
end;

function FindNext(var Search: TSearchRec): Integer;
var name: string; info: TFileInfo; error: TSysError;
begin
  Result := 2;
  if Search.FReader <> nil then
    while True do
    begin
      if not Search.FReader.Next(name, error) then
      begin
        if error.Failed then Result := error.Code;
        FindClose(Search);
        Break;
      end;
      if not MatchesFileName(Search.FPattern, name) then Continue;
      if not TryFileInfoAt(Search.FReader.Handle, name,
        (Search.FAllowed and faSymLink) = 0, info, error) then
      begin
        if error.Code = 2 then Continue; { removed between readdir/stat, as Go }
        Result := error.Code;
        FindClose(Search);
        Break;
      end;
      if (FileAttributes(name, info) and not Search.FAllowed) <> 0 then Continue;
      SearchInfo(Search, name, info);
      Result := 0;
      Break;
    end;
  SetLastOSError(Result);
end;

function FindFirst(const Path: string; Attr: Integer; out Search: TSearchRec): Integer;
var directory, pattern: string; info: TFileInfo; error: TSysError;
begin
  Search := Default(TSearchRec);
  Search.FAllowed := Attr or faArchive or faReadOnly;
  if (Pos('*', Path) = 0) and (Pos('?', Path) = 0) then
  begin
    Result := 2;
    if TryFileInfoAt(CurrentDirectoryHandle, Path, (Attr and faSymLink) = 0, info, error) then
    begin
      if (FileAttributes(Path, info) and not Search.FAllowed) = 0 then
      begin
        SearchInfo(Search, ExtractFileName(Path), info);
        Result := 0;
      end;
    end
    else Result := error.Code;
    SetLastOSError(Result);
    Exit;
  end;
  directory := ExtractFilePath(Path);
  if directory = '' then directory := '.';
  pattern := ExtractFileName(Path);
  Search.FPattern := pattern;
  if not TryOpenDirectoryAt(CurrentDirectoryHandle, directory, Search.FReader, error) then
  begin
    Result := error.Code;
    SetLastOSError(Result);
    Exit;
  end;
  Result := FindNext(Search);
end;

{ ==== directories and whole-file contents (P130) ==== }

function TryCreateDirectoryAt(DirectoryHandle: THandle; const Path: string;
  Rights: Integer; out Error: TSysError): Boolean;
var terminated: string; answer: Integer;
begin
  SystemError(Error, 0, 'mkdir', Path);
  if not ValidSystemPath(Path) or (Rights < 0) or (Rights > 4095) then Error.Code := 22
  else if not ValidDirectoryBase(DirectoryHandle, Path) then Error.Code := 9
  else
  begin
    terminated := Path + #0;
    repeat
      answer := Syscall(SystemNumber(258, 34), DirectoryHandle, Integer(@terminated[1]), Rights);
    until answer <> -4;
    if answer < 0 then Error.Code := -answer;
  end;
  Result := Error.Code = 0;
end;

{ Current Go os/path.go MkdirAll verifies EEXIST is really a directory.
  Walk with owned base descriptors instead of recursive string prefixes:
  no path/depth cap, no chdir, no quadratic prefix copies, stable bases.
  Do not CleanPath here: symlink/.. traversal is filesystem semantics.
  Following links is intentional; an explicit base is not a sandbox. }
function TryForceDirectoriesAt(DirectoryHandle: THandle; const Path: string;
  Rights: Integer; out Error: TSysError): Boolean;
var current, next: THandle; start, finish: Integer; component: string;
  closeError: TSysError;
begin
  SystemError(Error, 0, 'mkdir all', Path);
  Result := False;
  if (Path = '') or not ValidSystemPath(Path) or (Rights < 0) or (Rights > 4095) then
  begin
    Error.Code := 22;
    Exit;
  end;
  current := -1;
  next := -1;
  if IsAbsolutePath(Path) then component := '/' else component := '.';
  if not TryOpenFileAt(DirectoryHandle, component, ODirectory, 0, current, Error) then Exit;
  try
    start := 1;
    while start <= Length(Path) do
    begin
      if Path[start] = '/' then
      begin
        Inc(start);
        Continue;
      end;
      finish := start;
      while (finish <= Length(Path)) and (Path[finish] <> '/') do Inc(finish);
      component := Copy(Path, start, finish - start);
      if not TryCreateDirectoryAt(current, component, Rights, Error) and
        (Error.Code <> 17) then Exit;
      if not TryOpenFileAt(current, component, ODirectory, 0, next, Error) then Exit;
      if not TryFileClose(current, closeError) then
      begin
        current := -1;
        Error := closeError;
        Exit;
      end;
      current := next;
      next := -1;
      start := finish;
    end;
    Result := True;
  finally
    if next >= 0 then TryFileClose(next, closeError);
    if current >= 0 then
      if not TryFileClose(current, closeError) and Result then
      begin
        Result := False;
        Error := closeError;
      end;
    Error.Operation := 'mkdir all';
    Error.Path := Path;
  end;
end;

function ForceDirectories(const Directory: string): Boolean;
var error: TSysError;
begin
  TryForceDirectoriesAt(CurrentDirectoryHandle, Directory, 511, error);
  Result := CompatibilityResult(error.Code);
end;

function SameSystemFile(const Left, Right: TFileInfo): Boolean;
begin
  Result := (Left.Inode = Right.Inode) and (Left.DeviceMajor = Right.DeviceMajor) and
    (Left.DeviceMinor = Right.DeviceMinor);
  if Left.Has(fiMount) and Right.Has(fiMount) then
    Result := Result and (Left.MountId = Right.MountId);
end;

{ Current Go os/getwd.go fallback: find the current inode in its parent.
  Improve its growing '../..' string and arbitrary 1024-byte cap: keep
  owned directory descriptors, collect components, join once. Never
  mutate the process cwd, trust PWD or use a stale global path cache. }
function TryGetDirectoryPath(DirectoryHandle: THandle; out Path: string;
  out Error: TSysError): Boolean;
var current, parent, rootHandle: THandle; cursor: TDirectoryReader;
  currentInfo, parentInfo, rootInfo, entryInfo: TFileInfo;
  parts: array of string;
  name, temporary: string;
  count, k: Integer;
  matched: Boolean;
  closeError: TSysError;
begin
  Path := '';
  SystemError(Error, 0, 'directory path', '');
  Result := False;
  current := -1;
  parent := -1;
  rootHandle := -1;
  cursor := nil;
  count := 0;
  try
    if not TryOpenFileAt(DirectoryHandle, '.', ODirectory, 0, current, Error) then Exit;
    if not TryOpenFileAt(CurrentDirectoryHandle, '/', ODirectory, 0, rootHandle, Error) then Exit;
    if not TryHandleInfo(current, currentInfo, Error) then Exit;
    if not TryHandleInfo(rootHandle, rootInfo, Error) then Exit;
    if not currentInfo.Has(fiInode) or not rootInfo.Has(fiInode) then
    begin
      Error.Code := 95;
      Exit;
    end;
    while not SameSystemFile(currentInfo, rootInfo) do
    begin
      if not TryOpenFileAt(current, '..', ODirectory, 0, parent, Error) then Exit;
      if not TryHandleInfo(parent, parentInfo, Error) then Exit;
      if not parentInfo.Has(fiInode) then
      begin
        Error.Code := 95;
        Exit;
      end;
      if SameSystemFile(currentInfo, parentInfo) then
      begin
        Error.Code := 2; { outside the process root/unreachable }
        Exit;
      end;
      if not TryOpenDirectoryAt(parent, '.', cursor, Error) then Exit;
      matched := False;
      while cursor.Next(name, Error) do
      begin
        if not TryFileInfoAt(parent, name, False, entryInfo, Error) then
        begin
          if Error.Code = 2 then Continue;
          Exit;
        end;
        if entryInfo.Has(fiInode) and SameSystemFile(entryInfo, currentInfo) then
        begin
          matched := True;
          Break;
        end;
      end;
      if not matched then
      begin
        if not Error.Failed then Error.Code := 2; { deleted/renamed away }
        Exit;
      end;
      cursor.Free;
      cursor := nil;
      if count = Length(parts) then
      begin
        if count > High(Integer) div 2 then
          raise EArgumentOutOfRangeException.Create('directory path is too large');
        if count = 0 then SetLength(parts, 16) else SetLength(parts, count * 2);
      end;
      parts[count] := name;
      Inc(count);
      if not TryFileClose(current, closeError) then
      begin
        current := -1;
        Error := closeError;
        Exit;
      end;
      current := parent;
      parent := -1;
      currentInfo := parentInfo;
    end;
    if count = 0 then Path := '/'
    else
    begin
      SetLength(parts, count);
      for k := 0 to count div 2 - 1 do
      begin
        temporary := parts[k];
        parts[k] := parts[count - k - 1];
        parts[count - k - 1] := temporary;
      end;
      Path := '/' + JoinPaths(parts);
    end;
    SystemError(Error, 0, 'directory path', '');
    Result := True;
  finally
    if cursor <> nil then cursor.Free;
    if current >= 0 then TryFileClose(current, closeError);
    if parent >= 0 then TryFileClose(parent, closeError);
    if rootHandle >= 0 then TryFileClose(rootHandle, closeError);
    Error.Operation := 'directory path';
    if not Result then Path := '';
  end;
end;

function TryGetCurrentDir(out Directory: string; out Error: TSysError): Boolean;
var buffer: array[0..4095] of Byte; answer: Integer;
begin
  Directory := '';
  SystemError(Error, 0, 'getcwd', '');
  repeat
    answer := Syscall(SystemNumber(79, 17), Integer(@buffer[0]), SizeOf(buffer));
  until answer <> -4;
  if (answer = -34) or (answer = -36) then
  begin
    Result := TryGetDirectoryPath(CurrentDirectoryHandle, Directory, Error);
    Exit;
  end;
  Result := False;
  if answer < 0 then Error.Code := -answer
  else if (answer < 2) or (answer > SizeOf(buffer)) or
    (buffer[0] <> 47) or (buffer[answer - 1] <> 0) then Error.Code := 2
  else
  begin
    SetLength(Directory, answer - 1);
    Move(buffer[0], Directory[1], answer - 1);
    Result := True;
  end;
end;

function GetCurrentDir: string;
var error: TSysError;
begin
  TryGetCurrentDir(Result, error);
  CompatibilityResult(error.Code);
end;

function SetCurrentDir(const Directory: string): Boolean;
var terminated: string; answer: Integer;
begin
  if not ValidSystemPath(Directory) then answer := -22
  else
  begin
    terminated := Directory + #0;
    repeat
      answer := Syscall(SystemNumber(80, 49), Integer(@terminated[1]));
    until answer <> -4;
  end;
  if answer < 0 then Result := CompatibilityResult(-answer)
  else Result := CompatibilityResult(0);
end;

{ Current Go os/file.go readFileContents grows incrementally and does
  not trust stat's size (proc files can report zero). Require a byte
  budget and probe only one byte beyond it, returning EFBIG explicitly.
  A separate fixed read buffer avoids tiny /proc reads except when the
  caller's remaining budget itself is tiny. Errors discard the partial
  result; borrowed Handle remains open and its position advances. }
function TryReadFileContents(Handle: THandle; MaxBytes: Integer;
  out Contents: TBytes; out Error: TSysError): Boolean;
var chunk: TBytes; used, want, transferred, capacity, needed: Integer;
begin
  Contents := nil;
  SystemError(Error, 0, 'read contents', '');
  Result := False;
  if MaxBytes < 0 then
  begin
    Error.Code := 22;
    Exit;
  end;
  SetLength(chunk, 8192);
  used := 0;
  capacity := 0;
  while True do
  begin
    want := Length(chunk);
    if MaxBytes - used < want then want := MaxBytes - used + 1;
    if not TryFileRead(Handle, chunk, 0, want, transferred, Error) then Break;
    if transferred = 0 then
    begin
      SetLength(Contents, used);
      Result := True;
      Exit;
    end;
    if transferred > MaxBytes - used then
    begin
      Error.Code := 27;
      Break;
    end;
    needed := used + transferred;
    if needed > capacity then
    begin
      if capacity = 0 then capacity := Length(chunk)
      else if capacity > MaxBytes div 2 then capacity := MaxBytes
      else capacity := capacity * 2;
      if capacity > MaxBytes then capacity := MaxBytes;
      if capacity < needed then capacity := needed;
      SetLength(Contents, capacity);
    end;
    Move(chunk[0], Contents[used], transferred);
    used := needed;
  end;
  Contents := nil;
  Error.Operation := 'read contents';
end;

function TryReadFileAt(DirectoryHandle: THandle; const Path: string; MaxBytes: Integer;
  out Contents: TBytes; out Error: TSysError): Boolean;
var handle: THandle; closeError: TSysError;
begin
  Contents := nil;
  Result := False;
  if MaxBytes < 0 then
  begin
    SystemError(Error, 22, 'read contents', Path);
    Exit;
  end;
  if not TryOpenFileAt(DirectoryHandle, Path, ORdonly, 0, handle, Error) then Exit;
  try
    Result := TryReadFileContents(handle, MaxBytes, Contents, Error);
  finally
    if not TryFileClose(handle, closeError) and Result then
    begin
      Result := False;
      Contents := nil;
      Error := closeError;
    end;
    Error.Path := Path;
  end;
end;

function TryWriteFileAt(DirectoryHandle: THandle; const Path: string;
  const Contents: TBytes; Rights: Integer; out Error: TSysError): Boolean;
var handle: THandle; used, transferred: Integer; closeError: TSysError;
begin
  Result := False;
  if not TryOpenFileAt(DirectoryHandle, Path, OWronly or OCreat or OTrunc,
    Rights, handle, Error) then Exit;
  try
    used := 0;
    while used < Length(Contents) do
    begin
      if not TryFileWrite(handle, Contents, used, Length(Contents) - used, transferred, Error) then Exit;
      if transferred = 0 then
      begin
        SystemError(Error, 5, 'write contents', Path);
        Exit;
      end;
      used := used + transferred;
    end;
    Result := True;
  finally
    if not TryFileClose(handle, closeError) and Result then
    begin
      Result := False;
      Error := closeError;
    end;
    Error.Path := Path;
  end;
end;

function GetFileContents(const FileName: string; MaxBytes: Integer): TBytes;
var error: TSysError;
begin
  TryReadFileAt(CurrentDirectoryHandle, FileName, MaxBytes, Result, error);
  error.RaiseError;
end;

function GetFileContents(Handle: THandle; MaxBytes: Integer): TBytes;
var error: TSysError;
begin
  TryReadFileContents(Handle, MaxBytes, Result, error);
  error.RaiseError;
end;

function GetFileAsString(const FileName: string; MaxBytes: Integer): string;
begin
  Result := StringOf(GetFileContents(FileName, MaxBytes));
end;

{ ==== paths (P130) ==== }

{ Current Go internal/filepathlite/path.go Clean. One bounded output
  allocation, linear scan and backtracking; UTF-8 bytes and literal
  backslashes are untouched. This is lexical, not symlink resolution. }
function CleanPath(const Path: string): string;
var
  r, w, barrier, n: Integer;
  rooted: Boolean;
begin
  n := Length(Path);
  if n = 0 then
  begin
    Result := '.';
    Exit;
  end;
  SetLength(Result, n);
  rooted := Path[1] = '/';
  r := 1;
  w := 0;
  barrier := 0;
  if rooted then
  begin
    Result[1] := '/';
    r := 2;
    w := 1;
    barrier := 1;
  end;
  while r <= n do
  begin
    if Path[r] = '/' then Inc(r)
    else if (Path[r] = '.') and ((r = n) or (Path[r + 1] = '/')) then Inc(r)
    else if (Path[r] = '.') and (r < n) and (Path[r + 1] = '.') and
      ((r + 1 = n) or (Path[r + 2] = '/')) then
    begin
      r := r + 2;
      if w > barrier then
      begin
        while (w > barrier) and (Result[w] <> '/') do Dec(w);
        if w > barrier then Dec(w);
      end
      else if not rooted then
      begin
        if w > 0 then
        begin
          Inc(w);
          Result[w] := '/';
        end;
        Inc(w);
        Result[w] := '.';
        Inc(w);
        Result[w] := '.';
        barrier := w;
      end;
    end
    else
    begin
      if (rooted and (w <> 1)) or (not rooted and (w <> 0)) then
      begin
        Inc(w);
        Result[w] := '/';
      end;
      while (r <= n) and (Path[r] <> '/') do
      begin
        Inc(w);
        Result[w] := Path[r];
        Inc(r);
      end;
    end;
  end;
  if w = 0 then
  begin
    Result := '.';
    Exit;
  end;
  SetLength(Result, w);
end;

function IsPathDelimiter(const Path: string; Index: Integer): Boolean;
begin
  Result := (Index > 0) and (Index <= Length(Path)) and (Path[Index] = '/');
end;

function IsAbsolutePath(const Path: string): Boolean;
begin
  Result := (Length(Path) > 0) and (Path[1] = '/');
end;

function IsLocalPath(const Path: string): Boolean;
var
  cleaned: string;
begin
  Result := False;
  if (Path = '') or IsAbsolutePath(Path) or not ValidSystemPath(Path) then Exit;
  cleaned := CleanPath(Path);
  Result := (cleaned <> '..') and (Copy(cleaned, 1, 3) <> '../');
end;

function PathSplit(const FileName: string): Integer;
begin
  Result := Length(FileName);
  while (Result > 0) and (FileName[Result] <> '/') do Dec(Result);
end;

function ExtractFileName(const FileName: string): string;
begin
  Result := Copy(FileName, PathSplit(FileName) + 1);
end;

function ExtractFilePath(const FileName: string): string;
begin
  Result := Copy(FileName, 1, PathSplit(FileName));
end;

function ExtractFileDir(const FileName: string): string;
var
  pathEnd: Integer;
begin
  pathEnd := PathSplit(FileName);
  if (pathEnd > 1) and (FileName[pathEnd - 1] <> '/') then Dec(pathEnd);
  Result := Copy(FileName, 1, pathEnd);
end;

function ExtractFileExt(const FileName: string): string;
var
  k: Integer;
begin
  Result := '';
  k := Length(FileName);
  while (k > 0) and (FileName[k] <> '/') do
  begin
    if FileName[k] = '.' then
    begin
      { Pascal dotfiles have no extension merely for their initial dot. }
      if (k > 1) and (FileName[k - 1] <> '/') then Result := Copy(FileName, k);
      Exit;
    end;
    Dec(k);
  end;
end;

function ChangeFileExt(const FileName, Extension: string): string;
begin
  Result := Copy(FileName, 1, Length(FileName) - Length(ExtractFileExt(FileName))) + Extension;
end;

function ChangeFilePath(const FileName, Path: string): string;
begin
  Result := IncludeTrailingPathDelimiter(Path) + ExtractFileName(FileName);
end;

function IncludeTrailingPathDelimiter(const Path: string): string;
begin
  Result := Path;
  if (Path = '') or (Path[Length(Path)] <> '/') then Result := Path + '/';
end;

function ExcludeTrailingPathDelimiter(const Path: string): string;
var
  n: Integer;
begin
  n := Length(Path);
  if (n > 0) and (Path[n] = '/') then Dec(n);
  Result := Copy(Path, 1, n);
end;

function IncludeLeadingPathDelimiter(const Path: string): string;
begin
  Result := Path;
  if not IsAbsolutePath(Path) then Result := '/' + Path;
end;

function ExcludeLeadingPathDelimiter(const Path: string): string;
begin
  Result := Path;
  if IsAbsolutePath(Path) then Result := Copy(Path, 2);
end;

function ConcatPaths(const Paths: array of string): string;
var
  k: Integer;
begin
  Result := '';
  if Length(Paths) = 0 then Exit;
  Result := Paths[0];
  for k := 1 to High(Paths) do
    if Paths[k] <> '' then
      Result := IncludeTrailingPathDelimiter(Result) + ExcludeLeadingPathDelimiter(Paths[k]);
end;

{ Current Go filepath/path_unix.go join: leading empties do not make
  a relative path absolute. Later rooted components do not discard the
  earlier base. One bounded concatenation, then the shared lexical clean. }
function JoinPaths(const Paths: array of string): string;
var
  k, first, total, position, n: Integer;
  joined: string;
begin
  Result := '';
  first := 0;
  while (first < Length(Paths)) and (Paths[first] = '') do Inc(first);
  if first = Length(Paths) then Exit;
  total := 0;
  for k := first to High(Paths) do
  begin
    n := Length(Paths[k]);
    if n > High(Integer) - total - 1 then
      raise EArgumentOutOfRangeException.Create('joined path is too large');
    total := total + n;
    if k > first then Inc(total);
  end;
  SetLength(joined, total);
  position := 1;
  for k := first to High(Paths) do
  begin
    if k > first then
    begin
      joined[position] := '/';
      Inc(position);
    end;
    n := Length(Paths[k]);
    if n > 0 then
    begin
      Move(Paths[k][1], joined[position], n);
      position := position + n;
    end;
  end;
  Result := CleanPath(joined);
end;

function ExpandFileName(const FileName, BasePath: string): string;
var base: string;
begin
  if not ValidSystemPath(FileName) or not ValidSystemPath(BasePath) then
    raise EArgumentException.Create('path contains NUL');
  if IsAbsolutePath(FileName) then Result := CleanPath(FileName)
  else
  begin
    base := BasePath;
    if not IsAbsolutePath(base) then
    begin
      base := GetCurrentDir;
      if base = '' then RaiseLastOSError;
      base := JoinPaths([base, BasePath]);
    end;
    Result := JoinPaths([base, FileName]);
  end;
end;

function ExpandFileName(const FileName: string): string;
begin
  Result := ExpandFileName(FileName, '');
end;

{ ==== immutable environments (P132/P181) ==== }

var CurrentEnvironment: TEnvironment;

function ValidEnvironmentName(const Name: string): Boolean;
begin
  Result := (Name <> '') and (Pos('=', Name) = 0) and (Pos(#0, Name) = 0);
end;

{ Current Go os/exec.exec.go dedupEnv: explicit child entries use the
  last value of a duplicate key. The initial Linux vector instead uses
  the first, as syscall/env_unix.go; InitializeEnvironment filters it.
  Arrays are copied because slices are mutable, not string-COW values. }
constructor TEnvironment.Create(const Entries: array of string);
var i, separator, slot, used: Integer; key: string;
begin
  SetLength(FEntries, Length(Entries));
  New(FIndex, Length(Entries));
  used := 0;
  for i := 0 to High(Entries) do
  begin
    separator := Pos('=', Entries[i]);
    if (separator <= 1) or (Pos(#0, Entries[i]) > 0) then
      raise EArgumentException.Create('environment entry must be NAME=value without NUL');
    key := Copy(Entries[i], 1, separator - 1);
    if not TryGet(FIndex, key, slot) then
    begin
      slot := used;
      FIndex[key] := slot;
      Inc(used);
    end;
    FEntries[slot] := Entries[i];
  end;
  SetLength(FEntries, used);
end;

class function TEnvironment.Current: TEnvironment;
begin
  Result := CurrentEnvironment;
end;

function TEnvironment.GetCount: Integer;
begin
  Result := Length(FEntries);
end;

function TEnvironment.Lookup(const Name: string; out Value: string): Boolean;
var slot: Integer;
begin
  Value := '';
  Result := False;
  if not ValidEnvironmentName(Name) then Exit;
  if (Length(FEntries) > 0) and TryGet(FIndex, Name, slot) then
  begin
    Value := Copy(FEntries[slot], Length(Name) + 2);
    Result := True;
  end;
end;

function TEnvironment.Entry(Index: Integer): string;
begin
  Result := '';
  if (Index > 0) and (Index <= Length(FEntries)) then Result := FEntries[Index - 1];
end;

function TEnvironment.ToArray: TEnvironmentEntries;
var i: Integer;
begin
  SetLength(Result, Length(FEntries));
  for i := 0 to High(FEntries) do Result[i] := FEntries[i];
end;

function TEnvironment.WithValue(const Name, Value: string): TEnvironment;
var entries: TEnvironmentEntries; slot: Integer;
begin
  if not ValidEnvironmentName(Name) or (Pos(#0, Value) > 0) then
    raise EArgumentException.Create('invalid environment name or value');
  entries := ToArray;
  if not TryGet(FIndex, Name, slot) then
  begin
    slot := Length(entries);
    SetLength(entries, slot + 1);
  end;
  entries[slot] := Name + '=' + Value;
  Result := TEnvironment.Create(entries);
end;

function TEnvironment.WithoutValue(const Name: string): TEnvironment;
var entries: TEnvironmentEntries; slot, i, used: Integer;
begin
  if not ValidEnvironmentName(Name) then
    raise EArgumentException.Create('invalid environment name');
  if not TryGet(FIndex, Name, slot) then
  begin
    Result := Self;
    Exit;
  end;
  SetLength(entries, Length(FEntries) - 1);
  used := 0;
  for i := 0 to High(FEntries) do
    if i <> slot then
    begin
      entries[used] := FEntries[i];
      Inc(used);
    end;
  Result := TEnvironment.Create(entries);
end;

function GetEnvironmentVariable(const Name: string): string;
begin
  LookupProcessEnvironment(Name, Result);
end;

function TryGetEnvironmentVariable(const Name: string; out Value: string): Boolean;
begin
  Result := LookupProcessEnvironment(Name, Value);
end;

function GetEnvironmentVariableCount: Integer;
begin
  Result := ProcessEnvironmentCount;
end;

function GetEnvironmentString(Index: Integer): string;
begin
  Result := ProcessEnvironmentEntry(Index);
end;

procedure InitializeEnvironment;
var entries: TEnvironmentEntries; seen: map[string] of Integer;
  i, separator, used: Integer; item, key: string;
begin
  SetLength(entries, ProcessEnvironmentCount);
  New(seen, ProcessEnvironmentCount);
  used := 0;
  for i := 1 to ProcessEnvironmentCount do
  begin
    item := ProcessEnvironmentEntry(i);
    separator := Pos('=', item);
    if separator > 1 then
    begin
      key := Copy(item, 1, separator - 1);
      if not (key in seen) then
      begin
        seen[key] := used;
        entries[used] := item;
        Inc(used);
      end;
    end;
  end;
  SetLength(entries, used);
  CurrentEnvironment := TEnvironment.Create(entries);
end;

{ ==== processes (P132) ==== }

class function TProcessOptions.Defaults: TProcessOptions;
var i: Integer;
begin
  Result.DirectoryHandle := CurrentDirectoryHandle;
  Result.Directory := '.';
  Result.InheritEnvironment := True;
  for i := 0 to 2 do Result.StandardHandles[i] := -2;
end;

function TProcessResult.Succeeded: Boolean;
begin
  Result := Exited and not TimedOut and (ExitCode = 0);
end;

procedure DecodeProcessStatus(Status: Int32; var Outcome: TProcessResult);
begin
  Outcome.Signal := Status and 127;
  Outcome.Exited := Outcome.Signal = 0;
  Outcome.ExitCode := -1;
  if Outcome.Exited then Outcome.ExitCode := (Status shr 8) and 255;
end;

{ Go syscall/exec_unix.go: prepare everything before fork, and a
  CLOEXEC error pipe distinguishes failed exec from a real exit 127.
  Unlike the old Pascal command-line-string contract, arguments remain
  separate. We use Linux pidfds for pollable, PID-stable execution waits.
  close_range(CLOEXEC) in the child's private table closes even foreign
  descriptors on exec: only the three explicit standard handles escape.
  fork (not CLONE_VM/vfork) allows ordinary stack locals without sharing
  a frame with the parent. The child must execute only raw Sys* wrappers,
  never allocation, a stack check, exception or runtime finalization. }
function TryExecuteProcess(const Path: string; const Args: array of string;
  const Options: TProcessOptions; out Outcome: TProcessResult;
  out Error: TSysError): Boolean;
var
  arguments, environment: TEnvironmentEntries;
  argv, envp: array of Pointer;
  standard: array[0..2] of THandle;
  pipeFds: array[0..1] of Int32;
  action: array[0..3] of Int64;
  execPath, directory: string;
  pipeRead, pipeWrite, directoryFd, pidFd, pid, handle: Integer;
  i, used, transferred, waitResult, fcntlNr, dupNr, chdirNr,
    actionNr, closeNr, writeNr, execNr, exitNr: Integer;
  rawPath, rawArgv, rawEnvp, rawAction, rawError: Pointer;
  childError, callResult: Int64;
  status: Int32;
  reaped: Boolean;
  messageBytes: TBytes;
  ioError: TSysError;
begin
  Outcome := Default(TProcessResult);
  Outcome.ExitCode := -1;
  SystemError(Error, 0, 'execute', Path);
  Result := False;
  if (Path = '') or not ValidSystemPath(Path) or
    not ValidSystemPath(Options.Directory) or (Options.TimeoutMs < 0) or
    (Options.TimeoutMs > High(Integer) div 1000000) then
  begin Error.Code := 22; Exit end;
  for i := 0 to High(Args) do
    if not ValidSystemPath(Args[i]) then begin Error.Code := 22; Exit end;
  for i := 0 to 2 do
  begin
    if Options.StandardHandles[i] < -2 then begin Error.Code := 22; Exit end;
    if Options.StandardHandles[i] > 2147483647 then begin Error.Code := 9; Exit end;
  end;
  SetLength(arguments, Length(Args) + 1);
  SetLength(argv, Length(Args) + 2);
  execPath := Path + #0;
  arguments[0] := execPath;
  for i := 0 to High(Args) do arguments[i + 1] := Args[i] + #0;
  for i := 0 to High(arguments) do argv[i] := @arguments[i][1];
  argv[High(argv)] := nil;
  if Options.InheritEnvironment then environment := CurrentEnvironment.ToArray
  else environment := Options.Environment.ToArray;
  SetLength(envp, Length(environment) + 1);
  for i := 0 to High(environment) do
  begin
    environment[i] := environment[i] + #0;
    envp[i] := @environment[i][1];
  end;
  envp[High(envp)] := nil;
  rawPath := @execPath[1]; rawArgv := @argv[0]; rawEnvp := @envp[0];
  FillChar(action, SizeOf(action), 0);
  rawAction := @action[0]; rawError := @childError;
  fcntlNr := SystemNumber(72, 25); dupNr := SystemNumber(292, 24);
  chdirNr := SystemNumber(81, 50); actionNr := SystemNumber(13, 134);
  closeNr := NrClose; execNr := NrExecve; exitNr := NrExit;
  writeNr := SystemNumber(1, 64);
  for i := 0 to 2 do standard[i] := -1;
  pipeRead := -1; pipeWrite := -1; directoryFd := -1; pidFd := -1;
  pid := -1; reaped := False;
  try
    { Capture standard handles before any open can reuse a closed 0..2. }
    for i := 0 to 2 do
    begin
      handle := Options.StandardHandles[i];
      if handle = -2 then handle := i;
      if handle >= 0 then
      begin
        repeat standard[i] := Syscall(fcntlNr, handle, 1030, 3);
        until standard[i] <> -4;
        if standard[i] < 0 then
        begin
          if (Options.StandardHandles[i] <> -2) or (standard[i] <> -9) then
          begin Error.Code := -standard[i]; standard[i] := -1; Exit end;
          standard[i] := -1;
        end;
      end;
    end;
    directory := Options.Directory;
    if directory = '' then directory := '.';
    if not TryOpenFileAt(Options.DirectoryHandle, directory, ODirectory,
      0, directoryFd, ioError) then begin Error.Code := ioError.Code; Exit end;
    repeat callResult := Syscall(SystemNumber(293, 59), Integer(@pipeFds[0]), 524288 or ONonblock);
    until callResult <> -4;
    if callResult < 0 then begin Error.Code := -callResult; Exit end;
    pipeRead := pipeFds[0]; pipeWrite := pipeFds[1];
    if pipeWrite < 3 then
    begin
      repeat handle := Syscall(fcntlNr, pipeWrite, 1030, 3); until handle <> -4;
      if handle < 0 then begin Error.Code := -handle; Exit end;
      OsClose(pipeWrite); pipeWrite := handle;
    end;
    pid := OsFork;
    if pid < 0 then begin Error.Code := -pid; Exit end;
    if pid = 0 then
    begin
      { No managed operation or ordinary Pascal call in this branch. }
      callResult := Sys1(closeNr, pipeRead);
      callResult := Sys3(436, 3, 4294967295, 4);
      if callResult = 0 then callResult := Sys1(chdirNr, directoryFd);
      if callResult = 0 then callResult := Sys4(actionNr, 13, Integer(rawAction), 0, 8);
      i := 0;
      while (i < 3) and (callResult = 0) do
      begin
        if standard[i] < 0 then
          childError := Sys1(closeNr, i)
        else
        begin
          callResult := Sys3(dupNr, standard[i], i, 0);
          if callResult >= 0 then callResult := 0;
        end;
        Inc(i);
      end;
      if callResult = 0 then
        callResult := Sys3(execNr, Integer(rawPath), Integer(rawArgv), Integer(rawEnvp));
      childError := -callResult;
      repeat callResult := Sys3(writeNr, pipeWrite, Integer(rawError), 8); until callResult <> -4;
      repeat callResult := Sys1(exitNr, 127); until False;
    end;
    Outcome.ProcessId := pid;
    OsClose(pipeWrite); pipeWrite := -1;
    for i := 0 to 2 do
      if standard[i] >= 0 then begin OsClose(standard[i]); standard[i] := -1 end;
    OsClose(directoryFd); directoryFd := -1;
    repeat pidFd := Syscall(434, pid, 0); until pidFd <> -4;
    if pidFd < 0 then begin Error.Code := -pidFd; Exit end;
    SetLength(messageBytes, 8);
    used := 0;
    repeat
      if not TryFileRead(pipeRead, messageBytes, used, 8 - used, transferred, ioError) then
      begin Error.Code := ioError.Code; Exit end;
      Inc(used, transferred);
    until (transferred = 0) or (used = 8);
    OsClose(pipeRead); pipeRead := -1;
    if used > 0 then
    begin
      Error.Code := 5;
      if used = 8 then
      begin
        Move(messageBytes[0], childError, 8);
        if (childError > 0) and (childError <= 2147483647) then Error.Code := childError;
      end;
      Exit;
    end;
    if Options.TimeoutMs = 0 then waitResult := WaitIo(pidFd, 1)
    else waitResult := WaitMs(pidFd, 1, Options.TimeoutMs);
    if waitResult < 0 then begin Error.Code := -waitResult; Exit end;
    status := 0;
    if Options.TimeoutMs = 0 then
      repeat callResult := OsWait(pid, Integer(@status), 0, 0); until callResult <> -4
    else
      repeat callResult := OsWait(pid, Integer(@status), 1, 0); until callResult <> -4;
    if callResult < 0 then begin Error.Code := -callResult; Exit end;
    if callResult = 0 then
    begin
      Error.Code := 110;
      Outcome.TimedOut := True;
      Exit;
    end;
    reaped := True;
    DecodeProcessStatus(status, Outcome);
    Result := True;
  finally
    if (pid > 0) and not reaped then
    begin
      { Reap every failure, including a timeout, before returning. The
        pid cannot be reused while this call still owns its unreaped
        child. A pidfd failure uses kill only in this cleanup path. }
      if pidFd >= 0 then
        repeat callResult := Syscall(424, pidFd, 9, 0, 0); until callResult <> -4
      else
        repeat callResult := Syscall(SystemNumber(62, 129), pid, 9); until callResult <> -4;
      repeat callResult := OsWait(pid, Integer(@status), 0, 0); until callResult <> -4;
      if callResult > 0 then DecodeProcessStatus(status, Outcome);
    end;
    if pidFd >= 0 then OsClose(pidFd);
    if pipeRead >= 0 then OsClose(pipeRead);
    if pipeWrite >= 0 then OsClose(pipeWrite);
    if directoryFd >= 0 then OsClose(directoryFd);
    for i := 0 to 2 do if standard[i] >= 0 then OsClose(standard[i]);
  end;
end;

function ExecuteProcess(const Path: string; const Args: array of string): Integer;
var options: TProcessOptions; outcome: TProcessResult; error: TSysError;
begin
  options := TProcessOptions.Defaults;
  if not TryExecuteProcess(Path, Args, options, outcome, error) then error.RaiseError;
  if outcome.Exited then Result := outcome.ExitCode else Result := 128 + outcome.Signal;
end;

{ ==== secure randomness and temporary resources (P132) ==== }

{ Current Go crypto/internal/sysrand/rand_getrandom.go: retry EINTR and
  short fills. Our modern kernel floor needs no /dev/urandom fallback.
  Unlike a fatal-only interface, return explicit errors and erase the
  entire requested range on failure, never leave partial random output. }
function TryRandomBytes(var Buffer: TBytes; Offset, Count: Integer;
  out Error: TSysError): Boolean;
var used, want, answer: Integer;
begin
  SystemError(Error, 0, 'random bytes', '');
  if not BufferRange(Length(Buffer), Offset, Count) then Error.Code := 22
  else
  begin
    used := 0;
    while used < Count do
    begin
      want := Count - used;
      if want > 1073741824 then want := 1073741824;
      repeat answer := Syscall(SystemNumber(318, 278), Integer(@Buffer[Offset + used]), want, 0);
      until answer <> -4;
      if answer <= 0 then
      begin
        if answer < 0 then Error.Code := -answer else Error.Code := 5;
        FillChar(Buffer[Offset], Count, 0);
        Break;
      end;
      used := used + answer;
    end;
  end;
  Result := Error.Code = 0;
end;

function RandomBytes(Count: Integer): TBytes;
var error: TSysError;
begin
  if Count < 0 then raise EArgumentException.Create('Negative random byte count');
  SetLength(Result, Count);
  if not TryRandomBytes(Result, 0, Count, error) then error.RaiseError;
end;

function GetTempDir: string;
begin
  Result := GetEnvironmentVariable('TMPDIR');
  if Result = '' then Result := '/tmp';
  Result := IncludeTrailingPathDelimiter(Result);
end;

function GetTempDir(Global: Boolean): string;
begin
  { Linux has no separate per-user/global temporary root. }
  Result := GetTempDir;
end;

function CreateTemporary(DirectoryHandle: THandle; const Directory, Pattern: string;
  IsDirectory: Boolean; out Name: string; out Handle: THandle;
  out Error: TSysError): Boolean;
const Digits = '0123456789abcdef';
var directoryPath, prefix, suffix, leaf, token: string;
  base: THandle; random: TBytes; starIndex, i, attempt: Integer;
  closeError: TSysError;
begin
  Name := ''; Handle := -1; Result := False;
  SystemError(Error, 0, 'create temporary', Directory);
  if not ValidSystemPath(Pattern) or (Pos('/', Pattern) <> 0) then
  begin Error.Code := 22; Exit end;
  directoryPath := Directory;
  if directoryPath = '' then directoryPath := GetTempDir;
  starIndex := Length(Pattern);
  while (starIndex > 0) and (Pattern[starIndex] <> '*') do Dec(starIndex);
  if starIndex = 0 then begin prefix := Pattern; suffix := '' end
  else begin prefix := Copy(Pattern, 1, starIndex - 1); suffix := Copy(Pattern, starIndex + 1) end;
  if not TryOpenFileAt(DirectoryHandle, directoryPath, ODirectory, 0, base, Error) then Exit;
  try
    SetLength(random, 16);
    SetLength(token, 32);
    for attempt := 1 to 10000 do
    begin
      if not TryRandomBytes(random, 0, 16, Error) then Exit;
      for i := 0 to 15 do
      begin
        token[i * 2 + 1] := Digits[Integer(random[i] shr 4) + 1];
        token[i * 2 + 2] := Digits[Integer(random[i] and 15) + 1];
      end;
      leaf := prefix + token + suffix;
      if IsDirectory then Result := TryCreateDirectoryAt(base, leaf, 448, Error)
      else Result := TryOpenFileAt(base, leaf, ORdwr or OCreat or OExcl, 384, Handle, Error);
      if Result then
      begin
        Name := IncludeTrailingPathDelimiter(directoryPath) + leaf;
        Exit;
      end;
      if Error.Code <> 17 then Exit;
    end;
  finally
    { Cleanup of the owned directory snapshot does not replace the
      primary creation result. As with Go, close is never retried. }
    TryFileClose(base, closeError);
    Error.Operation := 'create temporary';
    Error.Path := directoryPath;
  end;
end;

function TryCreateTempFileAt(DirectoryHandle: THandle; const Directory,
  Pattern: string; out Name: string; out Handle: THandle;
  out Error: TSysError): Boolean;
begin
  Result := CreateTemporary(DirectoryHandle, Directory, Pattern, False, Name, Handle, Error);
end;

function TryCreateTempDirectoryAt(DirectoryHandle: THandle; const Directory,
  Pattern: string; out Name: string; out Error: TSysError): Boolean;
var handle: THandle;
begin
  Result := CreateTemporary(DirectoryHandle, Directory, Pattern, True, Name, handle, Error);
end;

function GetTempFileName(const Directory, Prefix: string): string;
var handle: THandle; error: TSysError; pattern: string;
begin
  pattern := Prefix;
  if pattern = '' then pattern := 'TMP';
  pattern := pattern + '*.tmp';
  if not TryCreateTempFileAt(CurrentDirectoryHandle, Directory, pattern, Result, handle, error) then
    error.RaiseError;
  if not TryFileClose(handle, error) then error.RaiseError;
end;

function GetTempFileName: string;
begin
  Result := GetTempFileName('', '');
end;

{ ==== user/application paths (P132) ==== }

function TryGetUserDirectory(const Environment: TEnvironment; out Directory: string;
  out Error: TSysError): Boolean;
begin
  Environment.Lookup('HOME', Directory);
  SystemError(Error, 0, 'user directory', Directory);
  if Directory = '' then Error.Code := 2
  else if not IsAbsolutePath(Directory) then Error.Code := 22;
  Result := Error.Code = 0;
  if Result then Directory := CleanPath(Directory) else Directory := '';
end;

function UserBaseDirectory(const Environment: TEnvironment;
  const Key, Fallback: string; out Directory: string; out Error: TSysError): Boolean;
begin
  { XDG basedir 0.8: ignore invalid relative values. Current Go's
    os.UserConfigDir/UserCacheDir provides the shared fallback design;
    follow the specification, rather than Go's relative-path error. }
  Environment.Lookup(Key, Directory);
  SystemError(Error, 0, Key, Directory);
  if (Directory = '') or not IsAbsolutePath(Directory) then
  begin
    Result := TryGetUserDirectory(Environment, Directory, Error);
    if not Result then Exit;
    Directory := IncludeTrailingPathDelimiter(Directory) + Fallback;
  end;
  Directory := CleanPath(Directory);
  Result := True;
end;

function TryGetUserConfigDirectory(const Environment: TEnvironment; out Directory: string;
  out Error: TSysError): Boolean;
begin Result := UserBaseDirectory(Environment, 'XDG_CONFIG_HOME', '.config', Directory, Error) end;
function TryGetUserCacheDirectory(const Environment: TEnvironment; out Directory: string;
  out Error: TSysError): Boolean;
begin Result := UserBaseDirectory(Environment, 'XDG_CACHE_HOME', '.cache', Directory, Error) end;
function TryGetUserDataDirectory(const Environment: TEnvironment; out Directory: string;
  out Error: TSysError): Boolean;
begin Result := UserBaseDirectory(Environment, 'XDG_DATA_HOME', '.local/share', Directory, Error) end;
function TryGetUserStateDirectory(const Environment: TEnvironment; out Directory: string;
  out Error: TSysError): Boolean;
begin Result := UserBaseDirectory(Environment, 'XDG_STATE_HOME', '.local/state', Directory, Error) end;

function GetUserDir: string;
var error: TSysError;
begin
  if not TryGetUserDirectory(TEnvironment.Current, Result, error) then error.RaiseError;
  Result := IncludeTrailingPathDelimiter(Result);
end;

function ApplicationName: string;
begin
  Result := ChangeFileExt(ExtractFileName(ParamStr(0)), '');
end;

function GetApplicationConfigDirectory(const Environment: TEnvironment;
  const AppName: string; Global: Boolean): string;
var error: TSysError;
begin
  if (AppName = '') or (AppName = '.') or (AppName = '..') or
    not ValidSystemPath(AppName) or (Pos('/', AppName) <> 0) then
    raise EArgumentException.Create('Invalid application name');
  if Global then Result := '/etc'
  else if not TryGetUserConfigDirectory(Environment, Result, error) then error.RaiseError;
  Result := IncludeTrailingPathDelimiter(Result) + AppName + '/';
end;

function GetAppConfigDir(Global: Boolean): string;
begin Result := GetApplicationConfigDirectory(TEnvironment.Current, ApplicationName, Global) end;

function GetAppConfigFile(Global, SubDir: Boolean): string;
var error: TSysError;
begin
  if SubDir then Result := GetAppConfigDir(Global)
  else if Global then Result := '/etc/'
  else
  begin
    if not TryGetUserConfigDirectory(TEnvironment.Current, Result, error) then error.RaiseError;
    Result := IncludeTrailingPathDelimiter(Result);
  end;
  Result := Result + ApplicationName + '.cfg';
end;

function GetAppConfigFile(Global: Boolean): string;
begin Result := GetAppConfigFile(Global, False) end;

{ ==== bounded C-string buffers (P133) ==== }

function CStringOf(const Text: string): TBytes;
begin Result := BytesOf(Text + #0) end;

function StrLen(const Buffer: TBytes; Offset, Capacity: Integer): Integer;
begin
  if not BufferRange(Length(Buffer), Offset, Capacity) then
    raise EArgumentOutOfRangeException.Create('Invalid C-string buffer range');
  Result := 0;
  while Result < Capacity do
  begin
    if Buffer[Offset + Result] = 0 then Exit;
    Inc(Result);
  end;
  raise EConvertError.Create('C-string terminator is outside its buffer');
end;

function StrLen(const Buffer: TBytes): Integer;
begin Result := StrLen(Buffer, 0, Length(Buffer)) end;

function StrPas(const Buffer: TBytes; Offset, Capacity: Integer): string;
var count: Integer;
begin
  count := StrLen(Buffer, Offset, Capacity);
  SetLength(Result, count);
  if count > 0 then Move(Buffer[Offset], Result[1], count);
end;

function StrPas(const Buffer: TBytes): string;
begin Result := StrPas(Buffer, 0, Length(Buffer)) end;

function StrPCopy(var Buffer: TBytes; Offset, Capacity: Integer;
  const Text: string): Integer;
begin
  if not BufferRange(Length(Buffer), Offset, Capacity) or (Length(Text) >= Capacity) then
    raise EArgumentOutOfRangeException.Create('C-string output does not fit its buffer');
  Result := Length(Text);
  if Result > 0 then Move(Text[1], Buffer[Offset], Result);
  Buffer[Offset + Result] := 0;
end;

function StrCopy(var Destination: TBytes; DestinationOffset, Capacity: Integer;
  const Source: TBytes; SourceOffset, SourceCapacity: Integer): Integer;
begin
  Result := StrPCopy(Destination, DestinationOffset, Capacity,
    StrPas(Source, SourceOffset, SourceCapacity));
end;

procedure StrMove(var Destination: TBytes; DestinationOffset: Integer;
  const Source: TBytes; SourceOffset, Count: Integer);
begin
  if not BufferRange(Length(Destination), DestinationOffset, Count) or
    not BufferRange(Length(Source), SourceOffset, Count) then
    raise EArgumentOutOfRangeException.Create('Invalid C-string move range');
  if Count > 0 then Move(Source[SourceOffset], Destination[DestinationOffset], Count);
end;

function StrCat(var Destination: TBytes; const Source: TBytes): Integer;
var text: string;
begin
  text := StrPas(Destination) + StrPas(Source);
  Result := StrPCopy(Destination, 0, Length(Destination), text);
end;

function StrComp(const Left, Right: TBytes): Integer;
begin Result := CompareStr(StrPas(Left), StrPas(Right)) end;

function StrIComp(const Left, Right: TBytes): Integer;
begin Result := CompareText(StrPas(Left), StrPas(Right)) end;

function StrPos(const Buffer, Needle: TBytes): Integer;
var text, part: string;
begin
  text := StrPas(Buffer); part := StrPas(Needle);
  if part = '' then Result := 0 else Result := Pos(part, text) - 1;
end;

function StrScan(const Buffer: TBytes; Value: Char): Integer;
var text: string;
begin
  text := StrPas(Buffer);
  if Value = #0 then Result := Length(text) else Result := Pos(Value, text) - 1;
end;

function StrRScan(const Buffer: TBytes; Value: Char): Integer;
var text: string; i: Integer;
begin
  text := StrPas(Buffer);
  if Value = #0 then begin Result := Length(text); Exit end;
  for i := Length(text) downto 1 do
    if text[i] = Value then begin Result := i - 1; Exit end;
  Result := -1;
end;

procedure StrUpper(var Buffer: TBytes);
begin StrPCopy(Buffer, 0, Length(Buffer), UpCase(StrPas(Buffer))) end;

procedure StrLower(var Buffer: TBytes);
begin StrPCopy(Buffer, 0, Length(Buffer), LowerCase(StrPas(Buffer))) end;

function FormatBuf(var Buffer: TBytes; Offset, Capacity: Integer;
  const Template: string; const Args: array of const;
  const Settings: TFormatSettings): Integer;
var text: string;
begin
  if not BufferRange(Length(Buffer), Offset, Capacity) then
    raise EArgumentOutOfRangeException.Create('Invalid formatting buffer range');
  text := Format(Template, Args, Settings);
  Result := Length(text);
  if Result > Capacity then
    raise EArgumentOutOfRangeException.Create('Formatted output does not fit its buffer');
  if Result > 0 then Move(text[1], Buffer[Offset], Result);
end;

function StrFmt(var Buffer: TBytes; Offset, Capacity: Integer;
  const Template: string; const Args: array of const;
  const Settings: TFormatSettings): Integer;
begin
  Result := StrPCopy(Buffer, Offset, Capacity, Format(Template, Args, Settings));
end;

{ ==== owned string building (P133) ==== }

{ Current Go strings/builder.go: geometric capacity growth and a private
  byte buffer. Pascal's class identity replaces Go's copyCheck; no unsafe
  string view or mutable byte buffer escapes this builder. }
constructor TStringBuilder.Create(ACapacity: Integer);
begin
  if ACapacity < 0 then raise EArgumentOutOfRangeException.Create('Negative builder capacity');
  SetLength(FData, ACapacity);
end;

constructor TStringBuilder.Create(const Text: string);
begin
  SetLength(FData, Max(64, Length(Text)));
  AddText(Text);
end;

function TStringBuilder.GetCapacity: Integer;
begin Result := Length(FData) end;

function TStringBuilder.EnsureCapacity(Minimum: Integer): Integer;
var capacityValue: Integer;
begin
  if Minimum < 0 then raise EArgumentOutOfRangeException.Create('Negative builder capacity');
  capacityValue := Length(FData);
  if Minimum > capacityValue then
  begin
    if capacityValue <= High(Integer) div 2 then capacityValue := capacityValue * 2;
    if capacityValue < Minimum then capacityValue := Minimum;
    SetLength(FData, capacityValue);
  end;
  Result := Length(FData);
end;

function TStringBuilder.AddText(const Text: string): TStringBuilder;
var count: Integer;
begin
  count := Length(Text);
  if count > High(Integer) - FByteLength then
    raise EArgumentOutOfRangeException.Create('Builder length overflow');
  if count > 0 then
  begin
    EnsureCapacity(FByteLength + count);
    Move(Text[1], FData[FByteLength], count);
    Inc(FByteLength, count);
  end;
  Result := Self;
end;

function TStringBuilder.AddChar(Value: Char): TStringBuilder;
begin Result := AddText(string(Value)) end;

{ Current Go unicode/utf8.EncodeRune: the same Unicode scalar and byte
  boundaries. Unlike implicit replacement, invalid scalars are errors. }
function Utf8OfScalar(CodePoint: Integer): string;
var width, firstMask, k, value: Integer;
begin
  if (CodePoint < 0) or (CodePoint > 1114111) or
    ((CodePoint >= 55296) and (CodePoint <= 57343)) then
    raise EEncodingError.CreateAt('Invalid Unicode scalar', -1);
  if CodePoint < 128 then begin width := 1; firstMask := 0 end
  else if CodePoint < 2048 then begin width := 2; firstMask := 192 end
  else if CodePoint < 65536 then begin width := 3; firstMask := 224 end
  else begin width := 4; firstMask := 240 end;
  SetLength(Result, width);
  value := CodePoint;
  for k := width downto 2 do
  begin Result[k] := Chr(128 or (value and 63)); value := value shr 6 end;
  Result[1] := Chr(firstMask or value);
end;

function TStringBuilder.AddRune(CodePoint: Integer): TStringBuilder;
begin Result := AddText(Utf8OfScalar(CodePoint)) end;

function TStringBuilder.AddInteger(Value: Integer): TStringBuilder;
begin Result := AddText(IntToStr(Value)) end;

function TStringBuilder.AddReal(Value: Double; const Settings: TFormatSettings): TStringBuilder;
begin Result := AddText(FloatToStr(Value, Settings)) end;

function TStringBuilder.AddBoolean(Value: Boolean): TStringBuilder;
begin
  if Value then Result := AddText('True') else Result := AddText('False');
end;

function TStringBuilder.AddLine(const Text: string): TStringBuilder;
begin Result := AddText(Text).AddChar(#10) end;

function TStringBuilder.AddFormat(const Template: string; const Args: array of const;
  const Settings: TFormatSettings): TStringBuilder;
begin Result := AddText(Format(Template, Args, Settings)) end;

function TStringBuilder.InsertText(Index: Integer; const Text: string): TStringBuilder;
var count, tail: Integer;
begin
  if (Index < 0) or (Index > FByteLength) then
    raise EArgumentOutOfRangeException.Create('Builder insertion index');
  count := Length(Text);
  if count > High(Integer) - FByteLength then
    raise EArgumentOutOfRangeException.Create('Builder length overflow');
  if count > 0 then
  begin
    EnsureCapacity(FByteLength + count);
    tail := FByteLength - Index;
    if tail > 0 then Move(FData[Index], FData[Index + count], tail);
    Move(Text[1], FData[Index], count);
    Inc(FByteLength, count);
  end;
  Result := Self;
end;

function TStringBuilder.Remove(Index, Count: Integer): TStringBuilder;
var tail: Integer;
begin
  if not BufferRange(FByteLength, Index, Count) then
    raise EArgumentOutOfRangeException.Create('Builder removal range');
  tail := FByteLength - Index - Count;
  if (Count > 0) and (tail > 0) then Move(FData[Index + Count], FData[Index], tail);
  Dec(FByteLength, Count);
  Result := Self;
end;

procedure TStringBuilder.Reset;
begin FByteLength := 0 end;

function TStringBuilder.ToString: string;
begin
  SetLength(Result, FByteLength);
  if FByteLength > 0 then Move(FData[0], Result[1], FByteLength);
end;

{ ==== strict immutable text encodings (P133) ==== }

constructor EEncodingError.CreateAt(const Msg: string; Index: Integer);
begin
  inherited Create(Msg);
  ByteIndex := Index;
end;

function TEncodingError.Message: string;
begin
  case Kind of
    teNone: Result := 'success';
    teRange: Result := 'Invalid encoding buffer range';
    teInvalidUTF8: Result := 'Invalid UTF-8';
    teInvalidUTF16: Result := 'Invalid UTF-16';
    teNonASCII: Result := 'Non-ASCII text';
  end;
  if Kind <> teNone then Result := Result + ' at byte ' + IntToStr(ByteIndex);
end;

procedure TEncodingError.RaiseError;
begin
  if Kind = teRange then raise EArgumentOutOfRangeException.Create(Message);
  if Kind <> teNone then raise EEncodingError.CreateAt(Message, ByteIndex);
end;

class function TEncoding.GetUTF8: TEncoding;
begin Result.FKind := encUTF8 end;
class function TEncoding.GetUTF16LE: TEncoding;
begin Result.FKind := encUTF16LE end;
class function TEncoding.GetUTF16BE: TEncoding;
begin Result.FKind := encUTF16BE end;
class function TEncoding.GetASCII: TEncoding;
begin Result.FKind := encASCII end;

function TEncoding.GetName: string;
begin
  case FKind of
    encUTF8: Result := 'UTF-8';
    encUTF16LE: Result := 'UTF-16LE';
    encUTF16BE: Result := 'UTF-16BE';
    encASCII: Result := 'US-ASCII';
  end;
end;

function TEncoding.GetCodePage: Integer;
begin
  case FKind of
    encUTF8: Result := 65001;
    encUTF16LE: Result := 1200;
    encUTF16BE: Result := 1201;
    encASCII: Result := 20127;
  end;
end;

function ReadUtf8Scalar(const Text: string; Index: Integer;
  out CodePoint, Width: Integer): Boolean;
var k: Integer;
begin
  Width := Utf8Width(Text, Index);
  CodePoint := Ord(Text[Index]);
  Result := (CodePoint < 128) or (Width > 1);
  if not Result then Exit;
  if Width = 1 then Exit;
  CodePoint := CodePoint and (127 shr Width);
  for k := 1 to Width - 1 do
    CodePoint := (CodePoint shl 6) or (Ord(Text[Index + k]) and 63);
end;

function TEncoding.TryGetBytes(const Text: string; out Bytes: TBytes;
  out Error: TEncodingError): Boolean;
var index, scalar, width, size, amount, cursor, first, second: Integer;
begin
  Bytes := nil; Error.Kind := teNone; Error.ByteIndex := -1; Result := False;
  index := 1; size := 0;
  while index <= Length(Text) do
  begin
    if not ReadUtf8Scalar(Text, index, scalar, width) then
    begin Error.Kind := teInvalidUTF8; Error.ByteIndex := index - 1; Exit end;
    if (FKind = encASCII) and (scalar > 127) then
    begin Error.Kind := teNonASCII; Error.ByteIndex := index - 1; Exit end;
    if FKind = encUTF8 then amount := width
    else if FKind = encASCII then amount := 1
    else if scalar < 65536 then amount := 2 else amount := 4;
    if amount > High(Integer) - size then
    begin Error.Kind := teRange; Error.ByteIndex := index - 1; Exit end;
    Inc(size, amount); Inc(index, width);
  end;
  if FKind = encUTF8 then Bytes := BytesOf(Text)
  else
  begin
    SetLength(Bytes, size);
    index := 1; cursor := 0;
    while index <= Length(Text) do
    begin
      ReadUtf8Scalar(Text, index, scalar, width);
      if FKind = encASCII then
      begin Bytes[cursor] := Byte(scalar); Inc(cursor) end
      else
      begin
        { Go unicode/utf16.EncodeRune: surrogate high/low ten bits. }
        if scalar < 65536 then begin first := scalar; second := -1 end
        else
        begin
          scalar := scalar - 65536;
          first := 55296 or (scalar shr 10); second := 56320 or (scalar and 1023);
        end;
        repeat
          if FKind = encUTF16LE then
          begin Bytes[cursor] := Byte(first and 255); Bytes[cursor + 1] := Byte(first shr 8) end
          else
          begin Bytes[cursor] := Byte(first shr 8); Bytes[cursor + 1] := Byte(first and 255) end;
          Inc(cursor, 2); first := second; second := -1;
        until first < 0;
      end;
      Inc(index, width);
    end;
  end;
  Result := True;
end;

function TEncoding.GetBytes(const Text: string): TBytes;
var error: TEncodingError;
begin
  if not TryGetBytes(Text, Result, error) then error.RaiseError;
end;

function EncodingWord(const Bytes: TBytes; Index: Integer; BigEndian: Boolean): Integer;
begin
  if BigEndian then Result := (Integer(Bytes[Index]) shl 8) or Integer(Bytes[Index + 1])
  else Result := Integer(Bytes[Index]) or (Integer(Bytes[Index + 1]) shl 8);
end;

function TEncoding.TryGetString(const Bytes: TBytes; Offset, Count: Integer;
  out Text: string; out Error: TEncodingError): Boolean;
var index, scalar, width, second, finish: Integer; builder: TStringBuilder;
begin
  Text := ''; Error.Kind := teNone; Error.ByteIndex := -1; Result := False;
  if not BufferRange(Length(Bytes), Offset, Count) then
  begin Error.Kind := teRange; Error.ByteIndex := Offset; Exit end;
  if FKind = encUTF8 then
  begin
    Text := StringOf(Copy(Bytes, Offset, Count)); index := 1;
    while index <= Length(Text) do
    begin
      if not ReadUtf8Scalar(Text, index, scalar, width) then
      begin
        Error.Kind := teInvalidUTF8; Error.ByteIndex := Offset + index - 1;
        Text := ''; Exit;
      end;
      Inc(index, width);
    end;
    Result := True; Exit;
  end;
  builder := TStringBuilder.Create(Count);
  try
    index := Offset; finish := Offset + Count;
    while index < finish do
    begin
      if FKind = encASCII then
      begin
        scalar := Integer(Bytes[index]); width := 1;
        if scalar > 127 then Error.Kind := teNonASCII;
      end
      else
      begin
        if finish - index < 2 then
        begin Error.Kind := teInvalidUTF16; Error.ByteIndex := index; Exit end;
        scalar := EncodingWord(Bytes, index, FKind = encUTF16BE); width := 2;
        if (scalar >= 55296) and (scalar < 56320) then
        begin
          if finish - index < 4 then Error.Kind := teInvalidUTF16
          else
          begin
            second := EncodingWord(Bytes, index + 2, FKind = encUTF16BE);
            if (second < 56320) or (second > 57343) then Error.Kind := teInvalidUTF16
            else begin scalar := 65536 + ((scalar - 55296) shl 10) + second - 56320; width := 4 end;
          end;
        end
        else if (scalar >= 56320) and (scalar <= 57343) then Error.Kind := teInvalidUTF16;
      end;
      if Error.Kind <> teNone then
      begin Error.ByteIndex := index; Exit end;
      builder.AddRune(scalar); Inc(index, width);
    end;
    Text := builder.ToString; Result := True;
  finally builder.Free; end;
end;

function TEncoding.TryGetString(const Bytes: TBytes; out Text: string;
  out Error: TEncodingError): Boolean;
begin Result := TryGetString(Bytes, 0, Length(Bytes), Text, Error) end;

function TEncoding.GetString(const Bytes: TBytes): string;
begin Result := GetString(Bytes, 0, Length(Bytes)) end;

function TEncoding.GetString(const Bytes: TBytes; Offset, Count: Integer): string;
var error: TEncodingError;
begin if not TryGetString(Bytes, Offset, Count, Result, error) then error.RaiseError end;

function TEncoding.GetPreamble: TBytes;
begin
  case FKind of
    encUTF8: Result := BytesOf(#239#187#191);
    encUTF16LE: Result := BytesOf(#255#254);
    encUTF16BE: Result := BytesOf(#254#255);
    encASCII: Result := nil;
  end;
end;

class function TEncoding.Convert(const Source, Destination: TEncoding;
  const Bytes: TBytes): TBytes;
begin Result := Destination.GetBytes(Source.GetString(Bytes)) end;

{ ==== checked helpers (P133) ==== }

procedure TextRange(Size, Index, Count: Integer);
begin
  if not BufferRange(Size, Index, Count) then
    raise EArgumentOutOfRangeException.Create('Invalid string byte range');
end;

function HelperTrim(const Text: string): string;
begin Result := Trim(Text) end;

function TStringHelper.GetByteLength: Integer;
begin Result := Length(Self) end;
function TStringHelper.GetChar(Index: Integer): Char;
begin TextRange(Length(Self), Index, 1); Result := Self[Index + 1] end;
function TStringHelper.IsEmpty: Boolean;
begin Result := Length(Self) = 0 end;
function TStringHelper.HasText(const Text: string): Boolean;
begin Result := IndexOf(Text) >= 0 end;
function TStringHelper.StartsWith(const Text: string): Boolean;
begin Result := (Length(Text) <= Length(Self)) and (Copy(Self, 1, Length(Text)) = Text) end;
function TStringHelper.EndsWith(const Text: string): Boolean;
begin
  Result := (Length(Text) <= Length(Self)) and
    (Copy(Self, Length(Self) - Length(Text) + 1, Length(Text)) = Text);
end;
function TStringHelper.IndexOf(const Text: string; StartIndex: Integer): Integer;
begin
  TextRange(Length(Self), StartIndex, 0);
  if Length(Text) = 0 then Result := StartIndex
  else Result := Pos(Text, Self, StartIndex + 1) - 1;
end;
function TStringHelper.Substring(StartIndex, Count: Integer): string;
begin TextRange(Length(Self), StartIndex, Count); Result := Copy(Self, StartIndex + 1, Count) end;
function TStringHelper.Substring(StartIndex: Integer): string;
begin TextRange(Length(Self), StartIndex, 0); Result := Copy(Self, StartIndex + 1) end;
function TStringHelper.InsertText(Index: Integer; const Text: string): string;
begin
  TextRange(Length(Self), Index, 0);
  if Length(Text) > High(Integer) - Length(Self) then
    raise EArgumentOutOfRangeException.Create('String insertion overflow');
  Result := Copy(Self, 1, Index) + Text + Copy(Self, Index + 1);
end;
function TStringHelper.Remove(Index, Count: Integer): string;
begin
  TextRange(Length(Self), Index, Count);
  Result := Copy(Self, 1, Index) + Copy(Self, Index + Count + 1);
end;
function TStringHelper.Replace(const OldText, NewText: string; Flags: TReplaceFlags): string;
begin Result := StringReplace(Self, OldText, NewText, Flags) end;

{ Current Go strings.genSplit: literal non-overlapping separators and
  retained empty fields. Unlike Go's empty-separator rune splitting,
  an empty delimiter is rejected: byte strings do not invent rune
  boundaries or silently repair invalid UTF-8. }
function TStringHelper.SplitText(const Separator: string; MaxParts: Integer): TStringArray;
var count, start, found, index: Integer;
begin
  Result := nil;
  if Length(Separator) = 0 then
    raise EArgumentException.Create('Split requires a nonempty separator');
  if MaxParts < -1 then raise EArgumentOutOfRangeException.Create('Invalid split limit');
  if MaxParts = 0 then Exit;
  count := 1; start := 1;
  while (MaxParts = -1) or (count < MaxParts) do
  begin
    found := Pos(Separator, Self, start);
    if found = 0 then Break;
    Inc(count); start := found + Length(Separator);
  end;
  SetLength(Result, count);
  start := 1;
  for index := 0 to count - 2 do
  begin
    found := Pos(Separator, Self, start);
    Result[index] := Copy(Self, start, found - start);
    start := found + Length(Separator);
  end;
  Result[count - 1] := Copy(Self, start);
end;

{ Current Go strings.Join: checked total length, then a single reserve. }
class function TStringHelper.JoinText(const Separator: string; const Values: array of string): string;
var total, index: Integer; builder: TStringBuilder;
begin
  total := 0;
  for index := 0 to Length(Values) - 1 do
  begin
    if Length(Values[index]) > High(Integer) - total then
      raise EArgumentOutOfRangeException.Create('String join overflow');
    total := total + Length(Values[index]);
    if index > 0 then
    begin
      if Length(Separator) > High(Integer) - total then
        raise EArgumentOutOfRangeException.Create('String join overflow');
      total := total + Length(Separator);
    end;
  end;
  builder := TStringBuilder.Create(total);
  try
    for index := 0 to Length(Values) - 1 do
    begin
      if index > 0 then builder.AddText(Separator);
      builder.AddText(Values[index]);
    end;
    Result := builder.ToString;
  finally builder.Free end;
end;
function TStringHelper.ToLower: string;
begin Result := LowerCase(Self) end;
function TStringHelper.ToUpper: string;
begin Result := UpperCase(Self) end;
function TStringHelper.Trim: string;
begin Result := HelperTrim(Self) end;
function TStringHelper.ToInteger: Integer;
begin Result := StrToInt(Self) end;
function TStringHelper.ToDouble(const Settings: TFormatSettings): Double;
begin Result := StrToFloat(Self, Settings) end;
function TStringHelper.ToBoolean: Boolean;
begin Result := StrToBool(Self) end;
class function TIntegerHelper.Parse(const Text: string): Integer;
begin Result := StrToInt(Text) end;
class function TIntegerHelper.TryParse(const Text: string; out Value: Integer): Boolean;
begin Result := TryStrToInt(Text, Value) end;
function TIntegerHelper.ToString: string;
begin Result := IntToStr(Self) end;
function TIntegerHelper.ToHexString(Digits: Integer): string;
begin
  if Digits < 0 then raise EArgumentOutOfRangeException.Create('Negative hexadecimal width');
  Result := IntToHex(Self, Digits);
end;
function TIntegerHelper.ToDouble: Double;
begin Result := Double(Self) end;
function TIntegerHelper.ToBoolean: Boolean;
begin Result := Self <> 0 end;
class function TDoubleHelper.Parse(const Text: string; const Settings: TFormatSettings): Double;
begin Result := StrToFloat(Text, Settings) end;
class function TDoubleHelper.TryParse(const Text: string; out Value: Double;
  const Settings: TFormatSettings): Boolean;
begin Result := TryStrToFloat(Text, Value, Settings) end;
function TDoubleHelper.ToString(const Settings: TFormatSettings): string;
begin Result := FloatToStr(Self, Settings) end;
{ Current Go math/bits.go: IEEE comparisons, no type-punned overlays. }
function TDoubleHelper.IsNotANumber: Boolean;
begin Result := Self <> Self end;
function TDoubleHelper.IsInfinity: Boolean;
begin Result := (Self > 1.7976931348623157e308) or (Self < -1.7976931348623157e308) end;
function TDoubleHelper.IsFinite: Boolean;
begin Result := not IsNotANumber and not IsInfinity end;
class function TCurrencyHelper.Parse(const Text: string; const Settings: TFormatSettings): Currency;
begin Result := StrToCurr(Text, Settings) end;
class function TCurrencyHelper.TryParse(const Text: string; out Value: Currency;
  const Settings: TFormatSettings): Boolean;
begin Result := TryStrToCurr(Text, Value, Settings) end;
class function TCurrencyHelper.FromScaled(Value: Int64): Currency;
begin Result := CurrencyFromScaled(Value) end;
function TCurrencyHelper.ToString(const Settings: TFormatSettings): string;
begin Result := CurrToStr(Self, Settings) end;
function TCurrencyHelper.ToScaled: Int64;
begin Result := CurrencyToScaled(Self) end;
class function TBooleanHelper.Parse(const Text: string): Boolean;
begin Result := StrToBool(Text) end;
class function TBooleanHelper.TryParse(const Text: string; out Value: Boolean): Boolean;
begin Result := TryStrToBool(Text, Value) end;
function TBooleanHelper.ToString(UseBoolStrs: Boolean): string;
begin Result := BoolToStr(Self, UseBoolStrs) end;
function TBooleanHelper.ToInteger: Integer;
begin Result := Ord(Self) end;
function TCharHelper.IsAsciiDigit: Boolean;
begin Result := (Self >= '0') and (Self <= '9') end;
function TCharHelper.IsAsciiLetter: Boolean;
begin Result := ((Self >= 'A') and (Self <= 'Z')) or ((Self >= 'a') and (Self <= 'z')) end;
function TCharHelper.IsAsciiWhiteSpace: Boolean;
begin Result := (Self = ' ') or ((Self >= #9) and (Self <= #13)) end;
function TCharHelper.ToLower: Char;
begin
  Result := Self;
  if (Self >= 'A') and (Self <= 'Z') then Result := Chr(Ord(Self) + 32);
end;
function TCharHelper.ToUpper: Char;
begin Result := UpCase(Self) end;
function TCharHelper.ToString: string;
begin Result := string(Self) end;

{ ==== GUID / UUID (RFC 9562 §§4, 5.4, 5.7) ==== }

function GuidFromBytes(const Bytes: TBytes): TGUID;
var index: Integer;
begin
  if Length(Bytes) <> 16 then raise EArgumentException.Create('GUID requires exactly 16 bytes');
  Result.D1 := UInt32((Integer(Bytes[0]) shl 24) or (Integer(Bytes[1]) shl 16) or
    (Integer(Bytes[2]) shl 8) or Bytes[3]);
  Result.D2 := Word((Integer(Bytes[4]) shl 8) or Bytes[5]);
  Result.D3 := Word((Integer(Bytes[6]) shl 8) or Bytes[7]);
  for index := 0 to 7 do Result.D4[index] := Bytes[index + 8];
end;
function GuidToBytes(const Value: TGUID): TBytes;
var index: Integer;
begin
  SetLength(Result, 16);
  for index := 0 to 3 do Result[index] := Byte(Value.D1 shr ((3 - index) * 8));
  Result[4] := Byte(Value.D2 shr 8); Result[5] := Byte(Value.D2);
  Result[6] := Byte(Value.D3 shr 8); Result[7] := Byte(Value.D3);
  for index := 0 to 7 do Result[index + 8] := Value.D4[index];
end;
function GuidHex(Value: Char): Integer;
begin
  Result := -1;
  if (Value >= '0') and (Value <= '9') then Result := Ord(Value) - Ord('0')
  else if (Value >= 'A') and (Value <= 'F') then Result := Ord(Value) - Ord('A') + 10
  else if (Value >= 'a') and (Value <= 'f') then Result := Ord(Value) - Ord('a') + 10;
end;
function TryStringToGUID(const Text: string; out Value: TGUID): Boolean;
var start, count, position, index, highNibble, lowNibble: Integer; bytes: TBytes;
begin
  FillChar(Value, SizeOf(Value), 0); Result := False;
  start := 1; count := Length(Text);
  if (count = 38) and (Text[1] = '{') and (Text[38] = '}') then
  begin start := 2; count := 36 end;
  if count <> 36 then Exit;
  SetLength(bytes, 16); position := 0;
  for index := 0 to 15 do
  begin
    if (index = 4) or (index = 6) or (index = 8) or (index = 10) then
    begin
      if Text[start + position] <> '-' then Exit;
      Inc(position);
    end;
    highNibble := GuidHex(Text[start + position]);
    lowNibble := GuidHex(Text[start + position + 1]);
    if (highNibble < 0) or (lowNibble < 0) then Exit;
    bytes[index] := Byte(highNibble * 16 + lowNibble); position := position + 2;
  end;
  Value := GuidFromBytes(bytes); Result := True;
end;
function StringToGUID(const Text: string): TGUID;
begin
  if not TryStringToGUID(Text, Result) then raise EConvertError.Create('Invalid GUID: ' + Text);
end;
function GuidText(const Value: TGUID; Brackets: Boolean): string;
var bytes: TBytes; index: Integer;
begin
  bytes := GuidToBytes(Value); Result := '';
  if Brackets then Result := '{';
  for index := 0 to 15 do
  begin
    if (index = 4) or (index = 6) or (index = 8) or (index = 10) then Result := Result + '-';
    Result := Result + IntToHex(bytes[index], 2);
  end;
  if Brackets then Result := Result + '}';
end;
function GUIDToString(const Value: TGUID): string;
begin Result := GuidText(Value, True) end;
function IsEqualGUID(const Left, Right: TGUID): Boolean;
var index: Integer;
begin
  Result := False;
  if (Left.D1 <> Right.D1) or (Left.D2 <> Right.D2) or (Left.D3 <> Right.D3) then Exit;
  for index := 0 to 7 do if Left.D4[index] <> Right.D4[index] then Exit;
  Result := True;
end;
function TryCreateGUID(out Value: TGUID; out Error: TSysError): Boolean;
var bytes: TBytes;
begin
  FillChar(Value, SizeOf(Value), 0); SetLength(bytes, 16);
  Result := TryRandomBytes(bytes, 0, 16, Error);
  if not Result then Exit;
  bytes[6] := Byte((bytes[6] and 15) or 64);
  bytes[8] := Byte((bytes[8] and 63) or 128);
  Value := GuidFromBytes(bytes);
end;
function CreateGUID(out Value: TGUID): Integer;
var error: TSysError;
begin TryCreateGUID(Value, error); Result := error.Code end;
function FreshGUID(TimeOrdered: Boolean): TGUID;
var error: TSysError; bytes: TBytes; clock: array[0..1] of Integer;
  answer, milliseconds, index: Integer;
begin
  if not TimeOrdered then
  begin if not TryCreateGUID(Result, error) then error.RaiseError; Exit end;
  { Unlike NowNanos, compute directly in milliseconds so a seconds×1e9
    intermediate cannot overflow within the UUIDv7 48-bit time range. }
  repeat answer := Syscall(SystemNumber(228, 113), 0, Integer(@clock[0])); until answer <> -4;
  if answer < 0 then
  begin SystemError(error, -answer, 'clock_gettime', ''); error.RaiseError end;
  if (clock[0] < 0) or (clock[0] > 281474976710) or
    (clock[1] < 0) or (clock[1] >= 1000000000) then
    raise EArgumentOutOfRangeException.Create('UUIDv7 timestamp is outside its 48-bit range');
  milliseconds := clock[0] * 1000 + clock[1] div 1000000;
  if milliseconds > 281474976710655 then
    raise EArgumentOutOfRangeException.Create('UUIDv7 timestamp is outside its 48-bit range');
  bytes := RandomBytes(16);
  for index := 0 to 5 do bytes[index] := Byte(milliseconds shr ((5 - index) * 8));
  bytes[6] := Byte((bytes[6] and 15) or 112);
  bytes[8] := Byte((bytes[8] and 63) or 128);
  Result := GuidFromBytes(bytes);
end;
function NewGUID: TGUID;
begin Result := FreshGUID(False) end;
function NewTimeGUID: TGUID;
begin Result := FreshGUID(True) end;
class function TGuidHelper.Create(const Text: string): TGUID;
begin Result := StringToGUID(Text) end;
class function TGuidHelper.Create(const Bytes: TBytes): TGUID;
begin Result := GuidFromBytes(Bytes) end;
class function TGuidHelper.NewGuid: TGUID;
begin Result := FreshGUID(False) end;
class function TGuidHelper.NewTimeGuid: TGUID;
begin Result := FreshGUID(True) end;
function TGuidHelper.ToString(SkipBrackets: Boolean): string;
begin Result := GuidText(Self, not SkipBrackets) end;
function TGuidHelper.ToByteArray: TBytes;
begin Result := GuidToBytes(Self) end;
function TGuidHelper.IsEmpty: Boolean;
var empty: TGUID;
begin FillChar(empty, SizeOf(empty), 0); Result := IsEqualGUID(Self, empty) end;
function TGuidHelper.Version: Integer;
begin Result := D3 shr 12 end;
function TGuidHelper.UnixMilliseconds: Integer;
begin
  if (Version <> 7) or ((D4[0] and 192) <> 128) then
    raise EArgumentException.Create('Timestamp requires an RFC UUIDv7');
  Result := Integer(D1) * 65536 + D2;
end;

{ ==== immutable kernel identity (P132) ==== }

function GetCompiledArchitecture: TOSVersion.TArchitecture;
begin
  if Amd64 then Result := TOSVersion.TArchitecture.arIntelX64
  else Result := TOSVersion.TArchitecture.arARM64;
end;

function GetCompiledPlatform: TOSVersion.TPlatform;
begin Result := TOSVersion.TPlatform.pfLinux end;

class constructor TOSVersion.Create;
var bytes: array[0..389] of Byte; answer, field, start, finish,
  component, cursor, digit: Integer; parts: array[0..2] of Integer;
  text: string; error: TSysError;
begin
  repeat answer := Syscall(SystemNumber(63, 160), Integer(@bytes[0])); until answer <> -4;
  if answer < 0 then
  begin SystemError(error, -answer, 'uname', ''); error.RaiseError end;
  for field := 0 to 4 do
  begin
    start := field * 65;
    finish := start;
    while (finish < start + 65) and (bytes[finish] <> 0) do Inc(finish);
    SetLength(text, finish - start);
    if finish > start then Move(bytes[start], text[1], finish - start);
    case field of
      0: FName := text;
      2: FRelease := text;
      3: FVersion := text;
      4: FMachine := text;
    end;
  end;
  FillChar(parts, SizeOf(parts), 0);
  cursor := 1;
  for component := 0 to 2 do
  begin
    while (cursor <= Length(FRelease)) and (FRelease[cursor] >= '0') and
      (FRelease[cursor] <= '9') do
    begin
      digit := Ord(FRelease[cursor]) - Ord('0');
      if parts[component] > (High(Integer) - digit) div 10 then
        raise EConvertError.Create('Kernel version component overflow');
      parts[component] := parts[component] * 10 + digit;
      Inc(cursor);
    end;
    if (cursor > Length(FRelease)) or (FRelease[cursor] <> '.') then Break;
    Inc(cursor);
  end;
  FMajor := parts[0]; FMinor := parts[1]; FBuild := parts[2];
  FArchitecture := GetCompiledArchitecture;
end;

class function TOSVersion.Check(AMajor: Integer): Boolean;
begin Result := FMajor >= AMajor end;
class function TOSVersion.Check(AMajor, AMinor: Integer): Boolean;
begin Result := (FMajor > AMajor) or ((FMajor = AMajor) and (FMinor >= AMinor)) end;
class function TOSVersion.Check(AMajor, AMinor, APatch: Integer): Boolean;
begin
  Result := (FMajor > AMajor) or ((FMajor = AMajor) and (FMinor > AMinor)) or
    ((FMajor = AMajor) and (FMinor = AMinor) and (FBuild >= APatch));
end;
class function TOSVersion.ToString: string;
begin Result := FMachine + '-' + FName + ' ' + FRelease end;

initialization
  InitializeEnvironment;

end.
