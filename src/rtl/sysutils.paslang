implementation

uses
  pastime, paslinux, pasnum;

const
  { the variant errors EVariantError.CreateCode names, Free Pascal's
    (varerror.inc; neither its System nor its SysUtils exports them): an
    HRESULT, a 32-bit signed number }
  VAR_OK = 0;
  VAR_PARAMNOTFOUND = -2147352572;
  VAR_TYPEMISMATCH = -2147352571;
  VAR_BADVARTYPE = -2147352568;
  VAR_EXCEPTION = -2147352567;
  VAR_OVERFLOW = -2147352566;
  VAR_BADINDEX = -2147352565;
  VAR_ARRAYISLOCKED = -2147352563;
  VAR_NOTIMPL = -2147467263;
  VAR_OUTOFMEMORY = -2147024882;
  VAR_INVALIDARG = -2147024809;
  VAR_UNEXPECTED = -2147418113;

{ ==== exceptions ==== }

constructor Exception.Create(const Msg: string);
begin
  FMessage := Msg;
end;

constructor Exception.CreateHelp(const Msg: string; AHelpContext: Integer);
begin
  FMessage := Msg;
  FHelpContext := AHelpContext;
end;

constructor Exception.CreateFmt(const Msg: string; const Args: array of const);
begin
  FMessage := Format(Msg, Args);
end;

constructor Exception.CreateFmtHelp(const Msg: string; const Args: array of const;
  AHelpContext: Integer);
begin
  FMessage := Format(Msg, Args);
  FHelpContext := AHelpContext;
end;

{ ClassName: Message, as Free Pascal's; what an uncaught one prints. }
function Exception.ToString: string;
begin
  Result := ClassName + ': ' + FMessage;
end;

function Exception.GetBaseException: Exception;
begin
  Result := Self;
end;

{ The message of each variant error, as Free Pascal's (sysutils.inc). }
constructor EVariantError.CreateCode(Code: Integer);
begin
  case Code of
    VAR_OK:
      FMessage := SNoError;
    VAR_PARAMNOTFOUND:
      FMessage := SVarParamNotFound;
    VAR_TYPEMISMATCH:
      FMessage := SInvalidVarCast;
    VAR_BADVARTYPE:
      FMessage := SVarBadType;
    VAR_OVERFLOW:
      FMessage := SVarOverflow;
    VAR_BADINDEX:
      FMessage := SVarArrayBounds;
    VAR_ARRAYISLOCKED:
      FMessage := SVarArrayLocked;
    VAR_NOTIMPL:
      FMessage := SVarNotImplemented;
    VAR_OUTOFMEMORY:
      FMessage := SVarOutOfMemory;
    VAR_INVALIDARG:
      FMessage := SVarInvalid;
    VAR_UNEXPECTED, VAR_EXCEPTION:
      FMessage := SVarUnexpected;
  else
    FMessage := 'Unknown error code: ' + IntToStr(Code);
  end;
  ErrCode := Code;
end;

constructor EInOutArgumentException.Create(const AMsg, APath: string);
begin
  FMessage := AMsg;
  Path := APath;
end;

{ The object of the raise the running routine handles, nil outside an
  except part: the routine's G keeps it at 272, its raise's place at
  280 (P122). }
function ExceptObject: TObject;
begin
  asm amd64 (Result: out rax)
    movq 272(%r14), %rax
  end;
  asm arm64 (Result: out x0)
    ldr x0, [x28, #272]
  end;
end;

function ExceptAddr: Pointer;
begin
  asm amd64 (Result: out rax)
    movq 280(%r14), %rax
  end;
  asm arm64 (Result: out x0)
    ldr x0, [x28, #280]
  end;
end;

procedure Abort;
begin
  raise EAbort.Create(SAbortError);
end;

procedure OutOfMemoryError;
begin
  raise EOutOfMemory.Create(SOutOfMemory);
end;

{ ==== strings ==== }

function UpperCase(const S: string): string;
begin
  Result := UpCase(S);
end;

{ The Ansi words on paslang's UTF-8 strings: the ASCII letters change
  and every other byte, a multi-byte character's too, stays. }
function AnsiUpperCase(const S: string): string;
begin
  Result := UpCase(S);
end;

function AnsiLowerCase(const S: string): string;
begin
  Result := LowerCase(S);
end;

{ The difference of the first bytes of A and B that differ over N bytes,
  0 when none, by passtr's CmpByte kernel of the processor compiled for at
  most 64 KiB a call (P270): what CompareStr gives a run longer than that. }
function CompareStrLong(A, B: Pointer; N: Integer): Integer;
var
  done: Integer;
begin
  done := 0;
  while N - done > 65536 do
  begin
{$ifdef CPU_AVX2}
    Result := PasCmpByteCpu(Pointer(Integer(A) + done), Pointer(Integer(B) + done), 65536);
{$else}
    Result := PasCmpByteBase(Pointer(Integer(A) + done), Pointer(Integer(B) + done), 65536);
{$endif}
    if Result <> 0 then
      Exit;
    done := done + 65536;
  end;
{$ifdef CPU_AVX2}
  Result := PasCmpByteCpu(Pointer(Integer(A) + done), Pointer(Integer(B) + done), N - done);
{$else}
  Result := PasCmpByteBase(Pointer(Integer(A) + done), Pointer(Integer(B) + done), N - done);
{$endif}
end;

{ The difference of the first bytes of A and B that differ over N bytes,
  0 when none, by passtr's CaseCmp kernel of the processor compiled for at
  most 64 KiB a call (P270): what CompareText gives a run longer than that. }
function CompareTextLong(A, B: Pointer; N: Integer): Integer;
var
  done: Integer;
begin
  done := 0;
  while N - done > 65536 do
  begin
{$ifdef CPU_AVX2}
    Result := PasCaseCmpCpu(Pointer(Integer(A) + done), Pointer(Integer(B) + done), 65536);
{$else}
    Result := PasCaseCmpBase(Pointer(Integer(A) + done), Pointer(Integer(B) + done), 65536);
{$endif}
    if Result <> 0 then
      Exit;
    done := done + 65536;
  end;
{$ifdef CPU_AVX2}
  Result := PasCaseCmpCpu(Pointer(Integer(A) + done), Pointer(Integer(B) + done), N - done);
{$else}
  Result := PasCaseCmpBase(Pointer(Integer(A) + done), Pointer(Integer(B) + done), N - done);
{$endif}
end;

{ The bytes' difference at the first place the strings differ, else the
  lengths' order as -1, 0 or 1, as Free Pascal's (sysstr.inc): the
  common part on CompareByte's kernel (P147) of the processor compiled
  for (P148), a part longer than 64 KiB a slice at a time (P270). }
function CompareStr(const S1, S2: string): Integer;
var
  n: Integer;
begin
  n := Length(S1);
  if Length(S2) < n then
    n := Length(S2);
  if n > 0 then
  begin
    if n > 65536 then
      Result := CompareStrLong(Pointer(S1), Pointer(S2), n)
    else
{$ifdef CPU_AVX2}
      Result := PasCmpByteCpu(@S1[1], @S2[1], n);
{$else}
      Result := PasCmpByteBase(@S1[1], @S2[1], n);
{$endif}
    if Result <> 0 then
      Exit;
  end;
  if Length(S1) > Length(S2) then
    Result := 1
  else if Length(S1) < Length(S2) then
    Result := -1
  else
    Result := 0;
end;

{ As CompareStr with the ASCII letters of both taken as capitals, on
  passtr's CaseCmp kernel of the processor compiled for (P148), a part
  longer than 64 KiB a slice at a time (P270). }
function CompareText(const S1, S2: string): Integer;
var
  n: Integer;
begin
  n := Length(S1);
  if Length(S2) < n then
    n := Length(S2);
  if n > 0 then
  begin
    if n > 65536 then
      Result := CompareTextLong(Pointer(S1), Pointer(S2), n)
    else
{$ifdef CPU_AVX2}
      Result := PasCaseCmpCpu(@S1[1], @S2[1], n);
{$else}
      Result := PasCaseCmpBase(@S1[1], @S2[1], n);
{$endif}
    if Result <> 0 then
      Exit;
  end;
  if Length(S1) > Length(S2) then
    Result := 1
  else if Length(S1) < Length(S2) then
    Result := -1
  else
    Result := 0;
end;

function SameStr(const S1, S2: string): Boolean;
begin
  Result := S1 = S2;
end;

function SameText(const S1, S2: string): Boolean;
begin
  Result := (Length(S1) = Length(S2)) and (CompareText(S1, S2) = 0);
end;

{ The order of two strings as -1, 0 or 1. }
function AnsiCompareStr(const S1, S2: string): Integer;
begin
  if S1 < S2 then
    Result := -1
  else if S1 > S2 then
    Result := 1
  else
    Result := 0;
end;

function AnsiCompareText(const S1, S2: string): Integer;
var
  r: Integer;
begin
  r := CompareText(S1, S2);
  if r < 0 then
    Result := -1
  else if r > 0 then
    Result := 1
  else
    Result := 0;
end;

function AnsiSameStr(const S1, S2: string): Boolean;
begin
  Result := S1 = S2;
end;

function AnsiSameText(const S1, S2: string): Boolean;
begin
  Result := SameText(S1, S2);
end;

function CompareMem(P1, P2: Pointer; Len: Integer): Boolean;
begin
  if (P1 = P2) or (Len <= 0) then
    Result := True
  else if Len > 65536 then
    Result := CompareStrLong(P1, P2, Len) = 0
  else
{$ifdef CPU_AVX2}
    Result := PasCmpByteCpu(P1, P2, Len) = 0;
{$else}
    Result := PasCmpByteBase(P1, P2, Len) = 0;
{$endif}
end;

{ Blanks are the characters up to ' ', #0 among them. }
function Trim(const S: string): string;
var
  a, b: Integer;
begin
  a := 1;
  b := Length(S);
  while (a <= b) and (S[a] <= ' ') do
    a := a + 1;
  while (a <= b) and (S[b] <= ' ') do
    b := b - 1;
  if (a = 1) and (b = Length(S)) then
    Result := S
  else
    Result := Copy(S, a, b - a + 1);
end;

function TrimLeft(const S: string): string;
var
  a: Integer;
begin
  a := 1;
  while (a <= Length(S)) and (S[a] <= ' ') do
    a := a + 1;
  if a = 1 then
    Result := S
  else
    Result := Copy(S, a);
end;

function TrimRight(const S: string): string;
var
  b: Integer;
begin
  b := Length(S);
  while (b >= 1) and (S[b] <= ' ') do
    b := b - 1;
  if b = Length(S) then
    Result := S
  else
    Result := Copy(S, 1, b);
end;

function QuotedStr(const S: string): string;
begin
  Result := AnsiQuotedStr(S, '''');
end;

{ S between two Quotes, each Quote inside doubled. }
function AnsiQuotedStr(const S: string; Quote: Char): string;
var
  i, j: Integer;
begin
  Result := Quote;
  j := 1;
  i := Pos(Quote, S);
  while i > 0 do
  begin
    Result := Result + Copy(S, j, i - j + 1) + Quote;
    j := i + 1;
    i := Pos(Quote, S, j);
  end;
  Result := Result + Copy(S, j) + Quote;
end;

{ S unquoted when it starts with AQuote: the text to the closing one, a
  doubled one inside a single one; S as it is when it does not start
  with AQuote. }
function AnsiDequotedStr(const S: string; AQuote: Char): string;
var
  i: Integer;
begin
  if (Length(S) = 0) or (S[1] <> AQuote) then
  begin
    Result := S;
    Exit;
  end;
  Result := '';
  i := 2;
  while i <= Length(S) do
  begin
    if S[i] = AQuote then
    begin
      if (i < Length(S)) and (S[i + 1] = AQuote) then
      begin
        Result := Result + AQuote;
        i := i + 2;
        Continue;
      end;
      Exit;
    end;
    Result := Result + S[i];
    i := i + 1;
  end;
end;

function AnsiPos(const Substr, S: string): Integer;
begin
  Result := Pos(Substr, S);
end;

function LeftStr(const S: string; Count: Integer): string;
begin
  if Count <= 0 then
    Result := ''
  else
    Result := Copy(S, 1, Count);
end;

function RightStr(const S: string; Count: Integer): string;
begin
  if Count <= 0 then
    Result := ''
  else if Count >= Length(S) then
    Result := S
  else
    Result := Copy(S, Length(S) - Count + 1, Count);
end;

{ Free Pascal's StringReplace (syssr.inc): OldPattern found with Pos, in
  capitals on both sides for rfIgnoreCase, once or everywhere; the new
  string built once at its length. }
function StringReplace(const S, OldPattern, NewPattern: string; Flags: TReplaceFlags;
  out ACount: Integer): string;
var
  src, pat: string;
  p, np, q, k: Integer;
begin
  ACount := 0;
  if Length(OldPattern) = 0 then
  begin
    Result := S;
    Exit;
  end;
  if rfIgnoreCase in Flags then
  begin
    src := UpCase(S);
    pat := UpCase(OldPattern);
  end
  else
  begin
    src := S;
    pat := OldPattern;
  end;
  np := Length(pat);
  p := Pos(pat, src);
  if p = 0 then
  begin
    Result := S;
    Exit;
  end;
  Result := '';
  q := 1;
  k := 0;
  while p > 0 do
  begin
    Result := Result + Copy(S, q, p - q) + NewPattern;
    q := p + np;
    k := k + 1;
    if not (rfReplaceAll in Flags) then
      Break;
    p := Pos(pat, src, q);
  end;
  Result := Result + Copy(S, q);
  ACount := k;
end;

function StringReplace(const S, OldPattern, NewPattern: string; Flags: TReplaceFlags): string;
var
  n: Integer;
begin
  Result := StringReplace(S, OldPattern, NewPattern, Flags, n);
end;

function IsDelimiter(const Delimiters, S: string; Index: Integer): Boolean;
begin
  Result := (Index > 0) and (Index <= Length(S)) and (Pos(S[Index], Delimiters) > 0);
end;

function LastDelimiter(const Delimiters, S: string): Integer;
var
  chs: TSysCharSet;
  i: Integer;
begin
  chs := [];
  for i := 1 to Length(Delimiters) do
    Include(chs, Delimiters[i]);
  Result := Length(S);
  while (Result > 0) and not (S[Result] in chs) do
    Result := Result - 1;
end;

{ CR LF, CR alone and LF alone become the line end of the machine, LF. }
function AdjustLineBreaks(const S: string): string;
var
  i: Integer;
begin
  if Pos(#13, S) = 0 then
  begin
    Result := S;
    Exit;
  end;
  Result := '';
  i := 1;
  while i <= Length(S) do
  begin
    if S[i] = #13 then
    begin
      Result := Result + #10;
      if (i < Length(S)) and (S[i + 1] = #10) then
        i := i + 1;
    end
    else
      Result := Result + S[i];
    i := i + 1;
  end;
end;

{ Free Pascal's WrapText (sysstr.inc): Line cut into lines of up to
  MaxCol columns at a character of BreakChars, the text in quotes never
  cut, BreakStr put at each cut; a BreakStr in the text starts a line. }
function WrapText(const Line, BreakStr: string; const BreakChars: TSysCharSet;
  MaxCol: Integer): string;
var
  l: string;
  c, lq, bc: Char;
  p, blen, len: Integer;
  hb, ibc: Boolean;
begin
  Result := '';
  l := Line;
  blen := Length(BreakStr);
  if blen > 0 then
    bc := BreakStr[1]
  else
    bc := #0;
  len := Length(l);
  while len > 0 do
  begin
    p := 1;
    lq := #0;
    hb := False;
    ibc := False;
    while ((p <= len) and ((p <= MaxCol) or not ibc)) and ((lq <> #0) or not hb) do
    begin
      c := l[p];
      if c = lq then
        lq := #0
      else if (c = '''') or (c = '"') then
        lq := c;
      if lq <> #0 then
        p := p + 1
      else
      begin
        hb := (c = bc) and (BreakStr = Copy(l, p, blen));
        if hb then
          p := p + blen
        else
        begin
          if p >= MaxCol then
            ibc := c in BreakChars;
          p := p + 1;
        end;
      end;
    end;
    Result := Result + Copy(l, 1, p - 1);
    Delete(l, 1, p - 1);
    len := Length(l);
    if (len > 0) and not hb then
      Result := Result + BreakStr;
  end;
end;

function WrapText(const Line: string; MaxCol: Integer): string;
begin
  Result := WrapText(Line, sLineBreak, [' ', '-', #9], MaxCol);
end;

{ A letter or _ first, then letters, digits or _; with AllowDots a dot
  between names too, and with StrictDots none last. }
function IsValidIdent(const Ident: string; AllowDots: Boolean = False;
  StrictDots: Boolean = False): Boolean;
var
  i: Integer;
  first: Boolean;
  c: Char;
begin
  Result := False;
  if Length(Ident) < 1 then
    Exit;
  first := True;
  for i := 1 to Length(Ident) do
  begin
    c := Ident[i];
    if first then
    begin
      Result := (c in ['A'..'Z', 'a'..'z', '_']);
      first := False;
    end
    else if AllowDots and (c = '.') then
    begin
      if StrictDots then
      begin
        Result := i < Length(Ident);
        first := True;
      end;
    end
    else
      Result := c in ['A'..'Z', 'a'..'z', '0'..'9', '_'];
    if not Result then
      Exit;
  end;
end;

function CharInSet(C: Char; const CharSet: TSysCharSet): Boolean;
begin
  Result := C in CharSet;
end;

procedure AppendStr(var Dest: string; const S: string);
begin
  Dest := Dest + S;
end;

function BytesOf(const S: string): TBytes;
begin
  Result := nil;
  SetLength(Result, Length(S));
  if Length(S) > 0 then
    Move(S[1], Result[0], Length(S));
end;

function StringOf(const Bytes: TBytes): string;
begin
  Result := '';
  SetLength(Result, Length(Bytes));
  if Length(Bytes) > 0 then
    Move(Bytes[0], Result[1], Length(Bytes));
end;

{ ==== integers and Booleans ==== }

function IntToStr(Value: Int64): string;
begin
  Result := PasFmtInt(Value, 0);
end;

{ Value's 64 bits as an unsigned number, Free Pascal's QWord. }
function UIntToStr(Value: Int64): string;
var
  q, r: Int64;
begin
  if Value >= 0 then
  begin
    Result := PasFmtInt(Value, 0);
    Exit;
  end;
  { the unsigned value, halved to fit, then its last digit }
  q := (Value shr 1) div 5;
  r := Value - q * 10;
  Result := PasFmtInt(q, 0) + Chr(48 + r);
end;

{ The hexadecimal digits of Value's 64 bits, capitals, at least Digits of
  them with zeros in front. }
function IntToHex(Value: Int64; Digits: Integer): string;
const
  HexDigits = '0123456789ABCDEF';
var
  v: Int64;
begin
  Result := '';
  v := Value;
  repeat
    Result := HexDigits[(v and 15) + 1] + Result;
    v := v shr 4;
  until v = 0;
  while Length(Result) < Digits do
    Result := '0' + Result;
end;

{ All sixteen digits of an Int64, as Free Pascal's IntToHex(Int64). }
function IntToHex(Value: Int64): string;
begin
  Result := IntToHex(Value, 16);
end;

{ Val's reading (P134), and its code 0 the only success. }
function ReadInt(const S: string; Unsigned: Boolean; out V: Int64): Boolean;
var
  code: Int64;
begin
  V := PasValInt(S, Unsigned, code);
  Result := code = 0;
end;

{ Val's reading into a DWord's range, 0 to 2^32 - 1 (P149): a number past
  it is an error, as Free Pascal 3.3.1's TryStrToDWord says, where its
  low 32 bits were kept. }
function ReadDWord(const S: string; out V: Int64): Boolean;
var
  code: Int64;
begin
  V := PasValRange(S, 0, 4294967295, True, 32, code);
  Result := code = 0;
end;

procedure BadInt(const S: string);
begin
  raise EConvertError.Create('"' + S + '" is an invalid integer');
end;

function StrToInt(const S: string): Integer;
begin
  if PasValDecimal(S, Result) then
    Exit;
  if not ReadInt(S, False, Result) then
    BadInt(S);
end;

function StrToInt64(const S: string): Int64;
begin
  if PasValDecimal(S, Result) then
    Exit;
  if not ReadInt(S, False, Result) then
    BadInt(S);
end;

function StrToQWord(const S: string): Int64;
begin
  if not ReadInt(S, True, Result) then
    BadInt(S);
end;

function StrToUInt64(const S: string): Int64;
begin
  Result := StrToQWord(S);
end;

function StrToDWord(const S: string): Int64;
begin
  if not ReadDWord(S, Result) then
    BadInt(S);
end;

function StrToUInt(const S: string): Int64;
begin
  Result := StrToDWord(S);
end;

function StrToIntDef(const S: string; ADefault: Integer): Integer;
begin
  if PasValDecimal(S, Result) then
    Exit;
  if not ReadInt(S, False, Result) then
    Result := ADefault;
end;

function StrToInt64Def(const S: string; ADefault: Int64): Int64;
begin
  if PasValDecimal(S, Result) then
    Exit;
  if not ReadInt(S, False, Result) then
    Result := ADefault;
end;

function StrToQWordDef(const S: string; ADefault: Int64): Int64;
begin
  if not ReadInt(S, True, Result) then
    Result := ADefault;
end;

function StrToUInt64Def(const S: string; ADefault: Int64): Int64;
begin
  Result := StrToQWordDef(S, ADefault);
end;

function StrToDWordDef(const S: string; ADefault: Int64): Int64;
begin
  if not ReadDWord(S, Result) then
    Result := ADefault;
end;

function StrToUIntDef(const S: string; ADefault: Int64): Int64;
begin
  Result := StrToDWordDef(S, ADefault);
end;

function TryStrToInt(const S: string; out I: Integer): Boolean;
begin
  Result := ReadInt(S, False, I);
end;

function TryStrToInt64(const S: string; out I: Int64): Boolean;
begin
  Result := ReadInt(S, False, I);
end;

function TryStrToQWord(const S: string; out Q: Int64): Boolean;
begin
  Result := ReadInt(S, True, Q);
end;

function TryStrToUInt64(const S: string; out Q: Int64): Boolean;
begin
  Result := ReadInt(S, True, Q);
end;

function TryStrToDWord(const S: string; out D: Int64): Boolean;
begin
  Result := ReadDWord(S, D);
end;

function TryStrToUInt(const S: string; out U: Int64): Boolean;
begin
  Result := TryStrToDWord(S, U);
end;

{ '-1' and '0', as Free Pascal's; with UseBoolStrs the first of
  TrueBoolStrs and FalseBoolStrs, True and False unless set. Empty
  compatibility tables use pure fallbacks: never initialize mutable
  process-wide arrays in a concurrent reader. Set tables only before
  spawning readers, or under caller-owned synchronization. }
function BoolToStr(B: Boolean; UseBoolStrs: Boolean = False): string;
begin
  if UseBoolStrs then
  begin
    if B then
    begin
      if Length(TrueBoolStrs) = 0 then Result := 'True'
      else Result := TrueBoolStrs[0];
    end
    else
    begin
      if Length(FalseBoolStrs) = 0 then Result := 'False'
      else Result := FalseBoolStrs[0];
    end;
  end
  else if B then
    Result := '-1'
  else
    Result := '0';
end;

function BoolToStr(B: Boolean; const TrueS, FalseS: string): string;
begin
  if B then
    Result := TrueS
  else
    Result := FalseS;
end;

{ A number, any but 0 True; else one of TrueBoolStrs or FalseBoolStrs,
  whatever its case. }
function TryStrToBool(const S: string; out Value: Boolean): Boolean;
var
  code: Int64;
  d: Double;
  t: string;
  i: Integer;
begin
  Result := True;
  t := UpCase(S);
  d := PasValReal(t, code);
  if code = 0 then
  begin
    Value := d <> 0.0;
    Exit;
  end;
  if ((Length(TrueBoolStrs) = 0) and (t = 'TRUE')) or
    ((Length(FalseBoolStrs) = 0) and (t = 'FALSE')) then
  begin Value := t = 'TRUE'; Exit end;
  for i := 0 to High(TrueBoolStrs) do
    if t = UpCase(TrueBoolStrs[i]) then
    begin
      Value := True;
      Exit;
    end;
  for i := 0 to High(FalseBoolStrs) do
    if t = UpCase(FalseBoolStrs[i]) then
    begin
      Value := False;
      Exit;
    end;
  Value := False;
  Result := False;
end;

function StrToBool(const S: string): Boolean;
begin
  if not TryStrToBool(S, Result) then
    raise EConvertError.Create('"' + S + '" is not a valid boolean.');
end;

function StrToBoolDef(const S: string; ADefault: Boolean): Boolean;
begin
  if not TryStrToBool(S, Result) then
    Result := ADefault;
end;

{ ==== reals ==== }

{ The text of a real as Free Pascal's TextToFloat takes it (sysstr.inc):
  no thousands separator, the decimal separator of the settings made a
  point (a point is refused when that is another), blanks cut off; the
  digits are then Val's. }
function RealText(const S: string; const AFormatSettings: TFormatSettings; out T: string): Boolean;
var
  p: Integer;
begin
  Result := False;
  T := S;
  if T = '' then
    Exit;
  if (AFormatSettings.ThousandSeparator <> AFormatSettings.DecimalSeparator) and
    (Pos(AFormatSettings.ThousandSeparator, T) <> 0) then
    Exit;
  if AFormatSettings.DecimalSeparator <> '.' then
  begin
    if Pos('.', T) <> 0 then
      Exit;
    p := Pos(AFormatSettings.DecimalSeparator, T);
    if p <> 0 then
      T[p] := '.';
  end;
  T := Trim(T);
  Result := True;
end;

function TryStrToFloat(const S: string; out Value: Double;
  const AFormatSettings: TFormatSettings): Boolean;
var
  t: string;
  code, bits: Int64;
  sc: TPasNumScan;
begin
  { a plain number, nothing but the number in the text and the point as
    Pascal writes it (no blank to cut, no thousands separator to find): read
    where it lies, by the scanner and the rounding Val uses; any other text,
    and a number too large, go the long way below }
  if (AFormatSettings.DecimalSeparator = '.') and (S <> '') and
    PasNumScan(Pointer(S), Length(S), False, sc) and (sc.Len = Length(S)) and
    PasNumF64(Pointer(S), sc, bits) then
  begin
    Move(bits, Value, 8);
    Result := True;
    Exit;
  end;
  Value := 0;
  Result := False;
  if not RealText(S, AFormatSettings, t) then
    Exit;
  Value := PasValReal(t, code);
  Result := code = 0;
end;

function CurrencyFromScaled(Value: Int64): Currency;
begin Result := Value as Currency end;

function CurrencyToScaled(Value: Currency): Int64;
begin Result := Value as Int64 end;

function TryStrToCurr(const S: string; out Value: Currency;
  const AFormatSettings: TFormatSettings): Boolean;
var text: string; scaled: Int64;
begin
  Value := 0;
  { An embedded NUL is data, never surrounding whitespace or a C
    terminator. Reject it before the compatibility Trim operation. }
  if Pos(#0, S) <> 0 then begin Result := False; Exit end;
  Result := RealText(S, AFormatSettings, text);
  if Result then Result := PasTryParseCurrency(text, scaled);
  if Result then Value := CurrencyFromScaled(scaled);
end;

function TryStrToCurr(const S: string; out Value: Currency): Boolean;
begin Result := TryStrToCurr(S, Value, DefaultFormatSettings) end;

function StrToCurr(const S: string; const AFormatSettings: TFormatSettings): Currency;
begin
  if not TryStrToCurr(S, Result, AFormatSettings) then
    raise EConvertError.Create('"' + S + '" is an invalid currency');
end;

function StrToCurr(const S: string): Currency;
begin Result := StrToCurr(S, DefaultFormatSettings) end;

function StrToCurrDef(const S: string; ADefault: Currency;
  const AFormatSettings: TFormatSettings): Currency;
begin
  if not TryStrToCurr(S, Result, AFormatSettings) then Result := ADefault;
end;

function StrToCurrDef(const S: string; ADefault: Currency): Currency;
begin Result := StrToCurrDef(S, ADefault, DefaultFormatSettings) end;

function TryFloatToCurr(Value: Double; out AResult: Currency): Boolean;
begin
  AResult := 0;
  try
    AResult := CurrencyFromScaled(PasCurrFromReal(Value));
    Result := True;
  except
    on error: ECurrencyError do Result := False;
  end;
end;

function FloatToCurr(Value: Double): Currency;
begin
  if not TryFloatToCurr(Value, Result) then
    raise EConvertError.Create('Floating-point value does not fit Currency');
end;

function TryStrToFloat(const S: string; out Value: Double): Boolean;
begin
  Result := TryStrToFloat(S, Value, DefaultFormatSettings);
end;

{ A Single rounded once from the digits (P146). }
function TryStrToFloat(const S: string; out Value: Single;
  const AFormatSettings: TFormatSettings): Boolean;
var
  t: string;
  code, bits: Int64;
  sc: TPasNumScan;
  w: Integer;
begin
  if (AFormatSettings.DecimalSeparator = '.') and (S <> '') and
    PasNumScan(Pointer(S), Length(S), False, sc) and (sc.Len = Length(S)) and
    PasNumF32(Pointer(S), sc, bits) then
  begin
    w := Integer(bits);
    Move(w, Value, 4);
    Result := True;
    Exit;
  end;
  Value := 0;
  Result := False;
  if not RealText(S, AFormatSettings, t) then
    Exit;
  Value := PasValSingle(t, code);
  Result := code = 0;
end;

function TryStrToFloat(const S: string; out Value: Single): Boolean;
begin
  Result := TryStrToFloat(S, Value, DefaultFormatSettings);
end;

function StrToFloat(const S: string; const AFormatSettings: TFormatSettings): Extended;
begin
  if not TryStrToFloat(S, Result, AFormatSettings) then
    raise EConvertError.Create('"' + S + '" is an invalid float');
end;

function StrToFloat(const S: string): Extended;
begin
  Result := StrToFloat(S, DefaultFormatSettings);
end;

function StrToFloatDef(const S: string; const ADefault: Extended;
  const AFormatSettings: TFormatSettings): Extended;
begin
  if not TryStrToFloat(S, Result, AFormatSettings) then
    Result := ADefault;
end;

function StrToFloatDef(const S: string; const ADefault: Extended): Extended;
begin
  Result := StrToFloatDef(S, ADefault, DefaultFormatSettings);
end;

{ ==== reals as text (P129) ==== }

{ A real's digits as Go makes them (the manual's §20): the unrounded
  scaling of Go's src/internal/strconv/uscale.go and ftoa.go (Russ Cox,
  "Floating-Point Printing and Parsing Can Be Simple And Fast",
  research.swtch.com/fp), which the core unit pasnum holds since P200
  (PasNumSplitReal, PasNumShortFloat, PasNumFixedWidth), the exact
  expansion past 18 digits as its bignum case; rounded once, a tie to
  even. Go's license covers the port (LICENSE-GO). }

{ The digits of D (not 0) with its trailing zeros gone, and the place of
  the point for D * 10^P (setDigits, numDigits): the count of digits from
  the bits, the zeros taken off the number, one string made. }
procedure SetDigits(Dv, P: Int64; out S: string; out Dp: Integer);
begin
  Dp := PasNumDigitCount(Dv) + P;
  while Dv mod 10 = 0 do
    Dv := Dv div 10;
  S := PasFmtInt(Dv, 0);
end;

{ Every significant digit of the magnitude of X (finite, not 0) exactly:
  X = 0.D * 10^Dp; from pasfmt's exact expansion, Go's bignum case. }
procedure ExactDigits(X: Double; out D: string; out Dp: Integer);
var
  bits, e2: Int64;
  t: string;
  p, first, last: Integer;
begin
  bits := 0;
  Move(X, bits, 8);
  bits := bits and High(Int64);
  Move(bits, X, 8);
  e2 := (bits shr 52) and 2047;
  if e2 = 0 then
    e2 := 1;
  e2 := e2 - 1075;
  if e2 < 0 then
    t := PasFmtReal(X, 0, -e2)
  else
    t := PasFmtReal(X, 0, 0);
  p := Pos('.', t);
  if p = 0 then
    p := Length(t) + 1
  else
    Delete(t, p, 1);
  first := 1;
  while (first <= Length(t)) and (t[first] = '0') do
    first := first + 1;
  last := Length(t);
  while (last > first) and (t[last] = '0') do
    last := last - 1;
  D := Copy(t, first, last - first + 1);
  Dp := p - first;
end;

{ Exact digits D, the point after Dp of them, rounded to N digits, a tie
  to even as Go's decimal.Round: D keeps at most N digits, its trailing
  zeros gone; a carry out of the first digit a 1 and Dp one more; N 0
  rounds to the left of every digit, and below 0 further left, where
  every value rounds to 0 (D ''). }
procedure RoundDigits(var D: string; var Dp: Integer; N: Integer);
var
  up: Boolean;
  k: Integer;
begin
  if N < 0 then
  begin
    D := '';
    Exit;
  end;
  if N >= Length(D) then
    Exit;
  if (D[N + 1] = '5') and (N + 1 = Length(D)) then
    up := (N > 0) and (((Ord(D[N]) - 48) and 1) <> 0)
  else
    up := D[N + 1] >= '5';
  D := Copy(D, 1, N);
  if up then
  begin
    k := N;
    while (k >= 1) and (D[k] = '9') do
      k := k - 1;
    if k = 0 then
    begin
      D := '1';
      Dp := Dp + 1;
    end
    else
    begin
      D := Copy(D, 1, k - 1) + Chr(Ord(D[k]) + 1);
    end;
  end
  else
  begin
    k := Length(D);
    while (k > 0) and (D[k] = '0') do
      k := k - 1;
    D := Copy(D, 1, k);
  end;
end;

{ The fewest digits that read back as X, a Double, or as the Single it
  holds when IsSingle: X = 0.D * 10^Dp (X finite, not 0). }
procedure ShortestDigits(X: Double; IsSingle: Boolean; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p: Int64;
  kind: Integer;
begin
  PasNumSplitReal(X, IsSingle, neg, m, e, kind);
  if IsSingle then
    PasNumShortFloat(m, e, 23, -189, dv, p)
  else
    PasNumShortFloat(m, e, 52, -1085, dv, p);
  SetDigits(dv, p, D, Dp);
end;

{ N significant digits of X (finite, not 0) rounded once, a tie to even:
  at most N digits in D, their trailing zeros gone; X = 0.D * 10^Dp. N 0
  or below rounds as RoundDigits does. }
procedure SigDigits(X: Double; N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p: Int64;
  kind: Integer;
begin
  if (N >= 1) and (N <= 18) then
  begin
    PasNumSplitReal(X, False, neg, m, e, kind);
    PasNumFixedWidth(m, e, N, -1, dv, p);
    SetDigits(dv, p, D, Dp);
    Exit;
  end;
  ExactDigits(X, D, Dp);
  RoundDigits(D, Dp, N);
end;

{ The digits of X (finite, not 0) rounded once at Decs places after the
  point, a tie to even ('f'; Decs below 0 a place before the point): D
  may be '' (it rounds to 0), its trailing zeros gone; X = 0.D * 10^Dp. }
procedure FracDigits(X: Double; Decs: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p, ex, digits, bits: Int64;
  kind: Integer;
begin
  bits := 0;
  Move(X, bits, 8);
  ex := (bits shr 52) and 2047;
  if ex = 0 then
    ex := 1;
  ex := ex - 1023;
  if ex >= 0 then
    digits := 1 + PasNumLog10Pow2(1 + ex) + Decs
  else
    digits := 1 + Decs - PasNumLog10Pow2(-ex);
  if (digits <= 18) and (Decs >= 0) then
  begin
    D := '';
    Dp := 0;
    if digits <= 0 then
      Exit;
    PasNumSplitReal(X, False, neg, m, e, kind);
    PasNumFixedWidth(m, e, digits, Decs, dv, p);
    if dv <> 0 then
      SetDigits(dv, p, D, Dp);
    Exit;
  end;
  ExactDigits(X, D, Dp);
  RoundDigits(D, Dp, Dp + Decs);
  if D = '' then
    Dp := 0;
end;

{ ---- the text of a real (P129) ---- }

{ Free Pascal's forms and names (sysstr.inc, fmtflt.inc), Go's digits:
  correctly rounded once, a tie to even, and the fewest that read back
  when no precision is asked (the manual's §20). NaN, +Inf and -Inf as
  paslang and Go write them. }

function SpecialText(Kind: Integer; Neg: Boolean): string;
begin
  if Kind = 3 then
    Result := 'NaN'
  else if Neg then
    Result := '-Inf'
  else
    Result := '+Inf';
end;

{ Each form below works out its length first and makes its string once,
  filled through a pointer with Move and FillChar: a string built with +
  makes one for every piece, and FloatToStr took four times Go's time.

  D (trailing zeros gone) with the point after Dp of its digits, as a
  number with Decs places ('' for none); zeros where D has no digit. }
function FixedOfP(Neg: Boolean; q: PChar; nd, Dp, Decs: Integer; Sep: Char): string;
var
  ip, lz, mid, tz, off, n, k: Integer;
  p: PChar;
begin
  if (Dp > 0) and (nd > 0) then
    ip := Dp
  else
    ip := 1;
  lz := 0;
  mid := 0;
  tz := 0;
  off := 0;
  n := ip;
  if Decs > 0 then
  begin
    if nd = 0 then
      lz := Decs
    else
    begin
      lz := -Dp;
      if lz < 0 then
        lz := 0;
      if lz > Decs then
        lz := Decs;
    end;
    off := Dp + lz;
    mid := nd - off;
    if mid > Decs - lz then
      mid := Decs - lz;
    if mid < 0 then
      mid := 0;
    tz := Decs - lz - mid;
    n := ip + 1 + Decs;
  end;
  n := n + Ord(Neg);
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  if Neg then
  begin
    p[0] := '-';
    p := @p[1];
  end;
  if (Dp > 0) and (nd > 0) then
  begin
    if Dp <= nd then
      Move(q^, p^, Dp)
    else
    begin
      Move(q^, p^, nd);
      FillChar(p[nd], Dp - nd, 48);
    end;
  end
  else
    p[0] := '0';
  if Decs > 0 then
  begin
    k := ip;
    p[k] := Sep;
    k := k + 1;
    if lz > 0 then
      FillChar(p[k], lz, 48);
    k := k + lz;
    if mid > 0 then
      Move(q[off], p[k], mid);
    k := k + mid;
    if tz > 0 then
      FillChar(p[k], tz, 48);
  end;
end;

function FixedOf(const D: string; Dp, Decs: Integer; Sep: Char): string;
begin
  Result := FixedOfP(False, PChar(D), Length(D), Dp, Decs, Sep);
end;

{ ffFixed of a Double (Decs below 0 are 2), the digits rounded once at Decs
  places as FracDigits makes them but written into a buffer on the stack and
  the one string made from them; False, and R untouched, when FracDigits
  would take the exact digits (more than 18 of them), which is left to the
  long way. }
function FixedShort(X: Double; Decs: Integer; Sep: Char; out R: string): Boolean;
var
  neg: Boolean;
  m, e, dv, p, ex, digits, bits, nd, t: Int64;
  kind: Integer;
  buf: array[0..31] of Char;
begin
  Result := False;
  if Decs < 0 then
    Decs := 2;
  bits := 0;
  Move(X, bits, 8);
  ex := (bits shr 52) and 2047;
  if ex = 0 then
    ex := 1;
  ex := ex - 1023;
  if ex >= 0 then
    digits := 1 + PasNumLog10Pow2(1 + ex) + Decs
  else
    digits := 1 + Decs - PasNumLog10Pow2(-ex);
  PasNumSplitReal(X, False, neg, m, e, kind);
  if kind >= 2 then
  begin
    R := SpecialText(kind, neg);
    Result := True;
    Exit;
  end;
  nd := 0;
  t := 0;
  if kind = 0 then
  begin
    if digits > 18 then
      Exit;
    if digits > 0 then
    begin
      PasNumFixedWidth(m, e, digits, Decs, dv, p);
      if dv <> 0 then
      begin
        t := PasNumDigitCount(dv) + p;
        while dv mod 10 = 0 do
          dv := dv div 10;
        nd := PasNumAppendUint(@buf[0], dv);
      end;
    end;
  end;
  R := FixedOfP(neg and (nd > 0), @buf[0], nd, t, Decs, Sep);
  Result := True;
end;

{ The integer part of a fixed number with a thousands separator every
  three digits, as ffNumber and ffCurrency write it. }
function Grouped(const S: string; DecSep, ThouSep: Char): string;
var
  p, k: Integer;
begin
  Result := S;
  if ThouSep = #0 then
    Exit;
  p := Pos(DecSep, Result);
  if p = 0 then
    p := Length(Result) + 1;
  k := p - 3;
  while k > 1 do
  begin
    Insert(ThouSep, Result, k);
    k := k - 3;
  end;
end;

{ ffGeneral: the digits with the point where it goes while the exponent
  is above -6 and below Thr, else d.dddEx with no sign for a positive
  exponent and no leading zeros, as Free Pascal writes it. }
function GeneralOfP(Neg: Boolean; q: PChar; nd, Dp, Thr: Integer; Sep: Char): string;
var
  ex, n, k, j, e, ed: Integer;
  plain: Boolean;
  p: PChar;
begin
  ex := Dp - 1;
  plain := (ex > -6) and (ex < Thr);
  e := Abs(ex);
  ed := 1;
  if plain then
  begin
    if Dp <= 0 then
      n := 2 - Dp + nd
    else if Dp >= nd then
      n := Dp
    else
      n := nd + 1;
  end
  else
  begin
    if e >= 10 then
      ed := 2;
    if e >= 100 then
      ed := 3;
    if e >= 1000 then
      ed := 4;
    n := nd + 1 + ed + Ord(ex < 0);
    if nd > 1 then
      n := n + 1;
  end;
  n := n + Ord(Neg);
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  k := 0;
  if Neg then
  begin
    p[0] := '-';
    k := 1;
  end;
  if plain then
  begin
    if Dp <= 0 then
    begin
      p[k] := '0';
      p[k + 1] := Sep;
      k := k + 2;
      if Dp < 0 then
        FillChar(p[k], -Dp, 48);
      Move(q^, p[k - Dp], nd);
    end
    else if Dp >= nd then
    begin
      Move(q^, p[k], nd);
      if Dp > nd then
        FillChar(p[k + nd], Dp - nd, 48);
    end
    else
    begin
      Move(q^, p[k], Dp);
      p[k + Dp] := Sep;
      Move(q[Dp], p[k + Dp + 1], nd - Dp);
    end;
  end
  else
  begin
    p[k] := q[0];
    k := k + 1;
    if nd > 1 then
    begin
      p[k] := Sep;
      Move(q[1], p[k + 1], nd - 1);
      k := k + nd;
    end;
    p[k] := 'E';
    k := k + 1;
    if ex < 0 then
    begin
      p[k] := '-';
      k := k + 1;
    end;
    j := k + ed - 1;
    while j >= k do
    begin
      p[j] := Chr(48 + e mod 10);
      e := e div 10;
      j := j - 1;
    end;
  end;
end;

function GeneralOf(Neg: Boolean; const D: string; Dp, Thr: Integer; Sep: Char): string;
begin
  Result := GeneralOfP(Neg, PChar(D), Length(D), Dp, Thr, Sep);
end;

{ FloatToStr of a Double or a Single (ffGeneral, the fewest digits): the
  same as RealText with an argument made for it and a string of digits made
  from the bits, but the bits split once, the digits written into a buffer
  on the stack and the one string made from them. }
function FloatToStrShort(X: Double; IsSingle: Boolean; Sep: Char): string;
var
  neg: Boolean;
  m, e, dv, p, nd, t: Int64;
  kind: Integer;
  buf: array[0..31] of Char;
begin
  PasNumSplitReal(X, IsSingle, neg, m, e, kind);
  if kind >= 2 then
  begin
    Result := SpecialText(kind, neg);
    Exit;
  end;
  if kind = 1 then
  begin
    Result := '0';
    Exit;
  end;
  if IsSingle then
    PasNumShortFloat(m, e, 23, -189, dv, p)
  else
    PasNumShortFloat(m, e, 52, -1085, dv, p);
  t := PasNumDigitCount(dv) + p;
  while dv mod 10 = 0 do
    dv := dv div 10;
  nd := PasNumAppendUint(@buf[0], dv);
  Result := GeneralOfP(neg, @buf[0], nd, t, 15, Sep);
end;

{ ffExponent: one digit, the point, Prec - 1 more (the digits D has when
  Prec is 0: the fewest), E, the exponent's sign and at least ExpDigits of
  its digits (4 at most); with ExpDigits 0 or below an exponent 0 is not
  written, E and sign too, as Free Pascal drops it. }
function ExponentOf(Neg: Boolean; const D: string; Dp, Prec, ExpDigits: Integer; Sep: Char): string;
var
  nd, ex, fr, have, e, ed, n, k, j: Integer;
  withExp: Boolean;
  p, q: PChar;
begin
  nd := Length(D);
  if nd = 0 then
    ex := 0
  else
    ex := Dp - 1;
  if Prec <= 0 then
    fr := nd - 1
  else
    fr := Prec - 1;
  if fr < 0 then
    fr := 0;
  if ExpDigits > 4 then
    ExpDigits := 4;
  withExp := (ExpDigits > 0) or (ex <> 0);
  e := Abs(ex);
  ed := 1;
  if e >= 10 then
    ed := 2;
  if e >= 100 then
    ed := 3;
  if e >= 1000 then
    ed := 4;
  if ed < ExpDigits then
    ed := ExpDigits;
  n := Ord(Neg) + 1;
  if fr > 0 then
    n := n + 1 + fr;
  if withExp then
    n := n + 2 + ed;
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  q := PChar(D);
  k := 0;
  if Neg then
  begin
    p[0] := '-';
    k := 1;
  end;
  if nd = 0 then
    p[k] := '0'
  else
    p[k] := q[0];
  k := k + 1;
  if fr > 0 then
  begin
    p[k] := Sep;
    k := k + 1;
    have := nd - 1;
    if have > fr then
      have := fr;
    if have < 0 then
      have := 0;
    if have > 0 then
      Move(q[1], p[k], have);
    if fr > have then
      FillChar(p[k + have], fr - have, 48);
    k := k + fr;
  end;
  if withExp then
  begin
    p[k] := 'E';
    if ex < 0 then
      p[k + 1] := '-'
    else
      p[k + 1] := '+';
    k := k + 2;
    j := k + ed - 1;
    while j >= k do
    begin
      p[j] := Chr(48 + e mod 10);
      e := e div 10;
      j := j - 1;
    end;
  end;
end;

{ The money forms (sysstr.inc's FloatToStrFIntl): CurrencyFormat for a
  positive amount, NegCurrFormat for a negative one; a format out of
  their range writes the amount alone, with its sign. }
function CurrencyOf(Neg: Boolean; const S: string; const FS: TFormatSettings): string;
var
  c: string;
begin
  c := FS.CurrencyString;
  if not Neg then
    case FS.CurrencyFormat of
      0: Result := c + S;
      1: Result := S + c;
      2: Result := c + ' ' + S;
      3: Result := S + ' ' + c;
    else
      Result := S;
    end
  else
    case FS.NegCurrFormat of
      0: Result := '(' + c + S + ')';
      1: Result := '-' + c + S;
      2: Result := c + '-' + S;
      3: Result := c + S + '-';
      4: Result := '(' + S + c + ')';
      5: Result := '-' + S + c;
      6: Result := S + '-' + c;
      7: Result := S + c + '-';
      8: Result := '-' + S + ' ' + c;
      9: Result := '-' + c + ' ' + S;
      10: Result := S + ' ' + c + '-';
      11: Result := c + ' ' + S + '-';
      12: Result := c + ' ' + '-' + S;
      13: Result := S + '-' + ' ' + c;
      14: Result := '(' + c + ' ' + S + ')';
      15: Result := '(' + S + ' ' + c + ')';
    else
      Result := '-' + S;
    end;
end;

{ The digits of an integer as a real's: D without trailing zeros, Dp
  its length. }
procedure IntDigits(V: Int64; out D: string; out Dp: Integer; out Neg: Boolean);
var
  k: Integer;
begin
  Neg := V < 0;
  D := UIntToStr(Abs(V));
  if V = Low(Int64) then
    D := '9223372036854775808';
  Dp := Length(D);
  k := Length(D);
  while (k > 0) and (D[k] = '0') do
    k := k - 1;
  D := Copy(D, 1, k);
end;

{ A Quad's parts: its sign and Kind as PasNumSplitReal's; its two words. }
procedure SplitQuad(Q: Quad; out Neg: Boolean; out Lo, Hi: Int64; out Kind: Integer);
var
  w: array[0..1] of Int64;
  ex: Int64;
begin
  Move(Q, w, 16);
  Lo := w[0];
  Hi := w[1];
  Neg := Hi < 0;
  ex := (Hi shr 48) and 32767;
  if ex = 32767 then
  begin
    if ((Hi and 281474976710655) <> 0) or (Lo <> 0) then
      Kind := 3
    else
      Kind := 2;
  end
  else if (ex = 0) and ((Hi and 281474976710655) = 0) and (Lo = 0) then
    Kind := 1
  else
    Kind := 0;
end;

type
  { a value the formats write: a Double, a Single's, an integer's, a
    Quad's }
  TRealSource = (rsDouble, rsSingle, rsInt, rsQuad, rsCurrency);
  TRealArg = record
    Src: TRealSource;
    X: Double;
    I: Int64;
    Q: Quad;
  end;

{ A value to write, in A, every field set (a record a function returned,
  or Default made, goes through the heap at every call). }
procedure ArgDouble(out A: TRealArg; X: Double);
begin
  A.Src := rsDouble;
  A.X := X;
  A.I := 0;
  A.Q := 0;
end;

procedure ArgSingle(out A: TRealArg; X: Single);
begin
  A.Src := rsSingle;
  A.X := X;
  A.I := 0;
  A.Q := 0;
end;

procedure ArgInt(out A: TRealArg; V: Int64);
begin
  A.Src := rsInt;
  A.X := 0;
  A.I := V;
  A.Q := 0;
end;

procedure ArgQuad(out A: TRealArg; Q: Quad);
begin
  A.Src := rsQuad;
  A.X := 0;
  A.I := 0;
  A.Q := Q;
end;

procedure ArgCurrency(out A: TRealArg; Value: Currency);
begin
  A.Src := rsCurrency;
  A.X := 0;
  A.I := CurrencyToScaled(Value);
  A.Q := 0;
end;

{ A value's sign and kind as PasNumSplitReal's: 0 a number, 1 a zero, 2 an
  infinity, 3 a NaN. }
procedure ArgKind(const A: TRealArg; out Neg: Boolean; out Kind: Integer);
var
  m, e, lo, hi: Int64;
begin
  case A.Src of
    rsInt, rsCurrency:
      begin
        Neg := A.I < 0;
        if A.I = 0 then
          Kind := 1
        else
          Kind := 0;
      end;
    rsQuad:
      SplitQuad(A.Q, Neg, lo, hi, Kind);
  else
    PasNumSplitReal(A.X, A.Src = rsSingle, Neg, m, e, Kind);
  end;
end;

{ A Quad's digits in Mode, as pasfmt's PasQuadDigits writes them. }
procedure QuadDigits(const A: TRealArg; Mode, N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  lo, hi, p: Int64;
  kind: Integer;
begin
  SplitQuad(A.Q, neg, lo, hi, kind);
  D := PasQuadDigits(lo, hi, Mode, N, p);
  Dp := p;
end;

{ The fewest digits that read back as the value in its own type; an
  integer's are all of them. }
procedure ArgShortest(const A: TRealArg; out D: string; out Dp: Integer);
var
  neg: Boolean;
  point: Int64;
begin
  case A.Src of
    rsDouble:
      ShortestDigits(A.X, False, D, Dp);
    rsSingle:
      ShortestDigits(A.X, True, D, Dp);
    rsQuad:
      QuadDigits(A, 0, 0, D, Dp);
    rsCurrency:
      begin D := PasCurrencyDigits(A.I, 0, 0, point); Dp := point end;
  else
    IntDigits(A.I, D, Dp, neg);
  end;
end;

{ N significant digits of the value, rounded once, a tie to even (a
  Single's are its Double's: the same value). }
procedure ArgSig(const A: TRealArg; N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  point: Int64;
begin
  case A.Src of
    rsDouble, rsSingle:
      SigDigits(A.X, N, D, Dp);
    rsQuad:
      QuadDigits(A, 1, N, D, Dp);
    rsCurrency:
      begin D := PasCurrencyDigits(A.I, 1, N, point); Dp := point end;
  else
    begin
      IntDigits(A.I, D, Dp, neg);
      RoundDigits(D, Dp, N);
    end;
  end;
end;

{ The value's digits rounded once at Decs places after the point, a tie
  to even; D '' and Dp 0 when it rounds to 0. }
procedure ArgFrac(const A: TRealArg; Decs: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  point: Int64;
begin
  case A.Src of
    rsDouble, rsSingle:
      FracDigits(A.X, Decs, D, Dp);
    rsQuad:
      QuadDigits(A, 2, Decs, D, Dp);
    rsCurrency:
      begin D := PasCurrencyDigits(A.I, 2, Decs, point); Dp := point end;
  else
    begin
      IntDigits(A.I, D, Dp, neg);
      RoundDigits(D, Dp, Dp + Decs);
      if D = '' then
        Dp := 0;
    end;
  end;
end;

{ One real in Free Pascal's formats: the digits rounded once, a tie to
  even (Go's), Precision 0 or below the fewest that read back; a Single's
  and a Quad's as their own type's, an integer's exact. No count of
  digits is capped: what is asked is written, as Go does. }
function RealText(const A: TRealArg; Fmt: TFloatFormat; Precision, Digits: Integer;
  const FS: TFormatSettings): string;
var
  neg: Boolean;
  kind, dp, thr: Integer;
  d, s: string;
begin
  ArgKind(A, neg, kind);
  if kind >= 2 then
  begin
    Result := SpecialText(kind, neg);
    Exit;
  end;
  d := '';
  dp := 0;
  case Fmt of
    ffGeneral, ffExponent:
      begin
        if kind = 0 then
        begin
          if Precision <= 0 then
            ArgShortest(A, d, dp)
          else
            ArgSig(A, Precision, d, dp);
        end;
        if Fmt = ffGeneral then
        begin
          if d = '' then
            Result := '0'
          else
          begin
            thr := Precision;
            if thr <= 0 then
              thr := 15;
            Result := GeneralOf(neg, d, dp, thr, FS.DecimalSeparator);
          end;
        end
        else
          Result := ExponentOf(neg and (d <> ''), d, dp, Precision, Digits, FS.DecimalSeparator);
      end;
  else
    begin
      if Digits < 0 then
      begin
        if Fmt = ffCurrency then
          Digits := FS.CurrencyDecimals
        else
          Digits := 2;
      end;
      if kind = 0 then
        ArgFrac(A, Digits, d, dp);
      neg := neg and (d <> '');
      s := FixedOf(d, dp, Digits, FS.DecimalSeparator);
      if Fmt <> ffFixed then
        s := Grouped(s, FS.DecimalSeparator, FS.ThousandSeparator);
      if Fmt = ffCurrency then
        Result := CurrencyOf(neg, s, FS)
      else if neg then
        Result := '-' + s
      else
        Result := s;
    end;
  end;
end;

function FloatToStrF(Value: Double; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

function CurrToStr(Value: Currency; const AFormatSettings: TFormatSettings): string;
var point: Integer;
begin
  { Decimal values stay decimal, including the full signed endpoints. }
  Result := PasFmtCurrency(CurrencyToScaled(Value), 0, -1);
  if AFormatSettings.DecimalSeparator <> '.' then
  begin
    point := Pos('.', Result);
    if point <> 0 then Result[point] := AFormatSettings.DecimalSeparator;
  end;
end;

function CurrToStr(Value: Currency): string;
begin Result := CurrToStr(Value, DefaultFormatSettings) end;

function FloatToStr(Value: Currency; const AFormatSettings: TFormatSettings): string;
begin Result := CurrToStr(Value, AFormatSettings) end;

function FloatToStr(Value: Currency): string;
begin Result := CurrToStr(Value, DefaultFormatSettings) end;

function FloatToStrF(Value: Currency; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var argument: TRealArg;
begin
  ArgCurrency(argument, Value);
  Result := RealText(argument, AFormat, Precision, Digits, AFormatSettings);
end;

function FloatToStrF(Value: Currency; AFormat: TFloatFormat; Precision, Digits: Integer): string;
begin Result := FloatToStrF(Value, AFormat, Precision, Digits, DefaultFormatSettings) end;

function CurrToStrF(Value: Currency; AFormat: TFloatFormat; Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
begin Result := FloatToStrF(Value, AFormat, 19, Digits, AFormatSettings) end;

function CurrToStrF(Value: Currency; AFormat: TFloatFormat; Digits: Integer): string;
begin Result := CurrToStrF(Value, AFormat, Digits, DefaultFormatSettings) end;

function FloatToStrF(Value: Double; AFormat: TFloatFormat; Precision, Digits: Integer): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, DefaultFormatSettings);
end;

function FloatToStrF(Value: Single; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgSingle(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

function FloatToStrF(Value: Single; AFormat: TFloatFormat; Precision, Digits: Integer): string;
var
  a: TRealArg;
begin
  ArgSingle(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, DefaultFormatSettings);
end;

function FloatToStrF(Value: Int64; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

function FloatToStrF(Value: Int64; AFormat: TFloatFormat; Precision, Digits: Integer): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, DefaultFormatSettings);
end;

function FloatToStrF(Value: Quad; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

function FloatToStrF(Value: Quad; AFormat: TFloatFormat; Precision, Digits: Integer): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, DefaultFormatSettings);
end;

{ The fewest digits that read back as Value (Go's shortest), where Free
  Pascal writes 15: 0.1 is 0.1, 1/3 is 0.3333333333333333. }
function FloatToStr(Value: Double; const AFormatSettings: TFormatSettings): string;
begin
  Result := FloatToStrShort(Value, False, AFormatSettings.DecimalSeparator);
end;

function FloatToStr(Value: Double): string;
begin
  Result := FloatToStrShort(Value, False, DefaultFormatSettings.DecimalSeparator);
end;

function FloatToStr(Value: Single; const AFormatSettings: TFormatSettings): string;
begin
  Result := FloatToStrShort(Value, True, AFormatSettings.DecimalSeparator);
end;

function FloatToStr(Value: Single): string;
begin
  Result := FloatToStrShort(Value, True, DefaultFormatSettings.DecimalSeparator);
end;

function FloatToStr(Value: Int64; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, AFormatSettings);
end;

function FloatToStr(Value: Int64): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, DefaultFormatSettings);
end;

function FloatToStr(Value: Quad; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, AFormatSettings);
end;

function FloatToStr(Value: Quad): string;
var
  a: TRealArg;
begin
  ArgQuad(a, Value);
  Result := RealText(a, ffGeneral, 0, 0, DefaultFormatSettings);
end;

{ Free Pascal's FloatToDecimal: at most Precision significant digits (18
  at most, what TFloatRec holds) and Decimals places after the point,
  correctly rounded, followed by #0; Exponent the place of the point
  (32767 an infinity, -32768 a NaN); a value that rounds to 0 has no
  digit, exponent 0 and no sign. }
procedure ArgToDecimal(out Result: TFloatRec; const A: TRealArg; Precision, Decimals: Integer);
var
  neg: Boolean;
  kind, dp, i: Integer;
  d, s: string;
begin
  Result := Default(TFloatRec);
  ArgKind(A, neg, kind);
  if kind = 2 then
  begin
    Result.Exponent := 32767;
    Result.Negative := neg;
    Exit;
  end;
  if kind = 3 then
  begin
    Result.Exponent := -32768;
    Exit;
  end;
  if Precision > 18 then
    Precision := 18;
  d := '';
  dp := 0;
  if kind = 0 then
  begin
    ArgFrac(A, Decimals, d, dp);
    if Length(d) > Precision then
    begin
      ArgSig(A, Precision, s, i);
      d := s;
      dp := i;
    end;
  end;
  if d = '' then
    Exit;
  Result.Negative := neg;
  Result.Exponent := dp;
  for i := 1 to Length(d) do
    Result.Digits[i - 1] := d[i];
end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Double; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgDouble(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Single; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgSingle(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Int64; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgInt(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Quad; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgQuad(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

procedure FloatToDecimal(out Result: TFloatRec; Value: Currency; Precision, Decimals: Integer);
var a: TRealArg;
begin ArgCurrency(a, Value); ArgToDecimal(Result, a, Precision, Decimals) end;

{ Free Pascal's FormatFloat (fmtflt.inc's IntFloatToTextFmt): up to
  three sections, for a positive value, a negative one and zero; 0 a
  digit always written, # one written when there is one, . the point, ,
  the thousands, E+ and E- an exponent, quotes literal text. Its digits
  are Go's, exact however many are asked, where Free Pascal stopped at
  18 and wrote a larger number in its general form. An empty section
  for a negative value or zero takes the first. }
function FloatFmtText(const Fmt: string; const A: TRealArg; const AFormatSettings: TFormatSettings): string;
var
  section, digs: string;
  neg, thousandSep, isSci, inLit: Boolean;
  decimalPos, firstDigit, lastDigit, requested, expSize, available, current, padZeroes,
    distToDecimal, s, i, n, fl, kind, dp: Integer;
  starts: array[0..4] of Integer;
  q, c: Char;

  procedure WriteDigit(ADigit: Char);
  begin
    if ADigit = #0 then
      Exit;
    distToDecimal := distToDecimal - 1;
    if distToDecimal = -1 then
      Result := Result + AFormatSettings.DecimalSeparator + ADigit
    else
    begin
      Result := Result + ADigit;
      if thousandSep and ((distToDecimal mod 3) = 0) and (distToDecimal > 1) then
        Result := Result + AFormatSettings.ThousandSeparator;
    end;
  end;

  function GetDigit: Char;
  begin
    Result := #0;
    if current <= available then
    begin
      Result := digs[current + 1];
      current := current + 1;
    end
    else if distToDecimal <= lastDigit then
      distToDecimal := distToDecimal - 1
    else
      Result := '0';
  end;

  procedure CopyDigit;
  begin
    if padZeroes = 0 then
      WriteDigit(GetDigit)
    else if padZeroes < 0 then
    begin
      padZeroes := padZeroes + 1;
      if distToDecimal <= firstDigit then
        WriteDigit('0')
      else
        distToDecimal := distToDecimal - 1;
    end
    else
    begin
      while padZeroes > 0 do
      begin
        WriteDigit(GetDigit);
        padZeroes := padZeroes - 1;
      end;
      WriteDigit(GetDigit);
    end;
  end;

  function ExponentText(ASign: Char; AExp: Integer): string;
  begin
    if digs = '' then
      AExp := 0;
    Result := IntToStr(Abs(AExp));
    if Length(Result) < expSize then
      Result := StringOfChar('0', expSize - Length(Result)) + Result;
    if AExp < 0 then
      Result := '-' + Result
    else if ASign = '+' then
      Result := '+' + Result;
  end;

begin
  Result := '';
  ArgKind(A, neg, kind);
  if kind >= 2 then
  begin
    Result := SpecialText(kind, neg);
    Exit;
  end;
  { the sections, ; outside quotes }
  fl := Length(Fmt);
  starts[0] := 1;
  n := 1;
  inLit := False;
  q := #0;
  for i := 1 to fl do
  begin
    c := Fmt[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if (c = ';') and not inLit then
    begin
      if n > 3 then
        raise EConvertError.Create('Invalid float format');
      starts[n] := i + 1;
      n := n + 1;
    end;
  end;
  starts[n] := fl + 2;
  if kind = 1 then
    s := 3
  else if neg then
    s := 2
  else
    s := 1;
  if (s > n) or (starts[s] - starts[s - 1] - 1 = 0) then
    s := 1;
  section := Copy(Fmt, starts[s - 1], starts[s] - starts[s - 1] - 1);
  if section = '' then
  begin
    Result := RealText(A, ffGeneral, 0, 0, AFormatSettings);
    Exit;
  end;
  { what the section asks (AnalyzeFormat) }
  thousandSep := False;
  isSci := False;
  decimalPos := 0;
  firstDigit := High(Int64);
  lastDigit := 0;
  requested := 0;
  expSize := 0;
  inLit := False;
  q := #0;
  i := 1;
  while i <= Length(section) do
  begin
    c := section[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if not inLit then
      case c of
        '.':
          if decimalPos = 0 then
            decimalPos := requested + 1;
        ',':
          thousandSep := AFormatSettings.ThousandSeparator <> #0;
        'e', 'E':
          begin
            i := i + 1;
            if i < Length(section) then
            begin
              c := section[i];
              isSci := (c = '-') or (c = '+');
              if isSci then
                while (i < Length(section)) and (section[i + 1] = '0') do
                begin
                  expSize := expSize + 1;
                  i := i + 1;
                end;
              if expSize > 4 then
                expSize := 4;
            end;
          end;
        '#':
          requested := requested + 1;
        '0':
          begin
            if requested < firstDigit then
              firstDigit := requested + 1;
            requested := requested + 1;
            lastDigit := requested + 1;
          end;
      end;
    i := i + 1;
  end;
  if decimalPos = 0 then
    decimalPos := requested + 1;
  lastDigit := decimalPos - lastDigit;
  if lastDigit > 0 then
    lastDigit := 0;
  firstDigit := decimalPos - firstDigit;
  if firstDigit < 0 then
    firstDigit := 0;
  { the digits (CalcRunVars), correctly rounded }
  digs := '';
  dp := 0;
  if kind = 0 then
  begin
    if isSci then
    begin
      if requested > 0 then
        ArgSig(A, requested, digs, dp);
    end
    else
      ArgFrac(A, requested - decimalPos + 1, digs, dp);
  end;
  if digs = '' then
  begin
    neg := False;
    dp := 0;
  end;
  distToDecimal := decimalPos - 1;
  if isSci then
    padZeroes := 0
  else
  begin
    padZeroes := dp - (decimalPos - 1);
    if padZeroes >= 0 then
      distToDecimal := dp;
  end;
  available := Length(digs) - 1;
  current := 0;
  { the section written }
  if neg and (s = 1) then
    Result := '-';
  inLit := False;
  q := ' ';
  i := 1;
  while i <= Length(section) do
  begin
    c := section[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if inLit then
      Result := Result + c
    else
      case c of
        '0', '#':
          CopyDigit;
        '.', ',':
          ;
        'e', 'E':
          begin
            Result := Result + c;
            if isSci then
            begin
              i := i + 1;
              if i <= Length(section) then
              begin
                c := section[i];
                if (c = '+') or (c = '-') then
                begin
                  Result := Result + ExponentText(c, dp - decimalPos + 1);
                  while (i < Length(section)) and (section[i + 1] = '0') do
                    i := i + 1;
                end;
              end;
            end
            else if i < Length(section) then
            begin
              i := i + 1;
              Result := Result + section[i];
            end;
          end;
      else
        Result := Result + c;
      end;
    i := i + 1;
  end;
end;

function FormatFloat(const Fmt: string; Value: Double; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := FloatFmtText(Fmt, a, AFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Double): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := FloatFmtText(Fmt, a, DefaultFormatSettings);
end;

function FormatFloat(const Fmt: string; Value: Single; const AFormatSettings: TFormatSettings): string;
var
