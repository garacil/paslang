{ an integer exactly, and FormatFloat('0', 5) is no choice between the
  reals }
function FormatFloat(const Fmt: string; Value: Int64; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgInt(a, Value);
  Result := FloatFmtText(Fmt, a, AFormatSettings);
