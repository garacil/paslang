  const AFormatSettings: TFormatSettings);


implementation

const
  { the variant errors EVariantError.CreateCode names, Free Pascal's
    (varerror.inc; neither its System nor its SysUtils exports them): an
    HRESULT, a 32-bit signed number }
  VAR_OK = 0;
  VAR_PARAMNOTFOUND = -2147352572;
  VAR_TYPEMISMATCH = -2147352571;
  VAR_BADVARTYPE = -2147352568;
  VAR_EXCEPTION = -2147352567;
  VAR_OVERFLOW = -2147352566;
  VAR_BADINDEX = -2147352565;
  VAR_ARRAYISLOCKED = -2147352563;
  VAR_NOTIMPL = -2147467263;
  VAR_OUTOFMEMORY = -2147024882;
  VAR_INVALIDARG = -2147024809;
  VAR_UNEXPECTED = -2147418113;

{ ==== exceptions ==== }

constructor Exception.Create(const Msg: string);
begin
  FMessage := Msg;
end;

constructor Exception.CreateHelp(const Msg: string; AHelpContext: Integer);
begin
  FMessage := Msg;
  FHelpContext := AHelpContext;
end;

constructor Exception.CreateFmt(const Msg: string; const Args: array of const);
begin
  FMessage := Format(Msg, Args);
end;

constructor Exception.CreateFmtHelp(const Msg: string; const Args: array of const;
  AHelpContext: Integer);
begin
  FMessage := Format(Msg, Args);
  FHelpContext := AHelpContext;
end;

{ ClassName: Message, as Free Pascal's; what an uncaught one prints. }
function Exception.ToString: string;
begin
  Result := ClassName + ': ' + FMessage;
end;

function Exception.GetBaseException: Exception;
begin
  Result := Self;
end;

{ The message of each variant error, as Free Pascal's (sysutils.inc). }
constructor EVariantError.CreateCode(Code: Integer);
begin
  case Code of
    VAR_OK:
      FMessage := SNoError;
    VAR_PARAMNOTFOUND:
      FMessage := SVarParamNotFound;
    VAR_TYPEMISMATCH:
      FMessage := SInvalidVarCast;
    VAR_BADVARTYPE:
      FMessage := SVarBadType;
    VAR_OVERFLOW:
      FMessage := SVarOverflow;
    VAR_BADINDEX:
      FMessage := SVarArrayBounds;
    VAR_ARRAYISLOCKED:
      FMessage := SVarArrayLocked;
    VAR_NOTIMPL:
      FMessage := SVarNotImplemented;
    VAR_OUTOFMEMORY:
      FMessage := SVarOutOfMemory;
    VAR_INVALIDARG:
      FMessage := SVarInvalid;
    VAR_UNEXPECTED, VAR_EXCEPTION:
      FMessage := SVarUnexpected;
  else
    FMessage := 'Unknown error code: ' + IntToStr(Code);
  end;
  ErrCode := Code;
end;

constructor EInOutArgumentException.Create(const AMsg, APath: string);
begin
  FMessage := AMsg;
  Path := APath;
end;

{ The object of the raise the running routine handles, nil outside an
  except part: the routine's G keeps it at 272, its raise's place at
  280 (P122). }
function ExceptObject: TObject;
begin
  asm amd64 (Result: out rax)
    movq 272(%r14), %rax
  end;
  asm arm64 (Result: out x0)
    ldr x0, [x28, #272]
  end;
end;

function ExceptAddr: Pointer;
begin
  asm amd64 (Result: out rax)
    movq 280(%r14), %rax
  end;
  asm arm64 (Result: out x0)
    ldr x0, [x28, #280]
  end;
end;

procedure Abort;
begin
  raise EAbort.Create(SAbortError);
end;

procedure OutOfMemoryError;
begin
  raise EOutOfMemory.Create(SOutOfMemory);
end;

{ ==== strings ==== }

function UpperCase(const S: string): string;
begin
  Result := UpCase(S);
end;

{ The Ansi words on paslang's UTF-8 strings: the ASCII letters change
  and every other byte, a multi-byte character's too, stays. }
function AnsiUpperCase(const S: string): string;
begin
  Result := UpCase(S);
end;

function AnsiLowerCase(const S: string): string;
begin
  Result := LowerCase(S);
end;

{ The bytes' difference at the first place the strings differ, else the
  lengths' order as -1, 0 or 1, as Free Pascal's (sysstr.inc): the
  common part on CompareByte's kernel (P147). }
function CompareStr(const S1, S2: string): Integer;
var
  n: Integer;
begin
  n := Length(S1);
  if Length(S2) < n then
    n := Length(S2);
  if n > 0 then
  begin
    Result := CompareByte(S1[1], S2[1], n);
    if Result <> 0 then
      Exit;
  end;
  if Length(S1) > Length(S2) then
    Result := 1
  else if Length(S1) < Length(S2) then
    Result := -1
  else
    Result := 0;
end;

{ As CompareStr with the ASCII letters of both taken as capitals, on
  passtr's CaseCmp kernel of the processor compiled for (P148). }
function CompareText(const S1, S2: string): Integer;
var
  n: Integer;
begin
  n := Length(S1);
  if Length(S2) < n then
    n := Length(S2);
  if n > 0 then
  begin
{$ifdef CPU_AVX2}
    Result := PasCaseCmpCpu(@S1[1], @S2[1], n);
{$else}
    Result := PasCaseCmpBase(@S1[1], @S2[1], n);
{$endif}
    if Result <> 0 then
      Exit;
  end;
  if Length(S1) > Length(S2) then
    Result := 1
  else if Length(S1) < Length(S2) then
    Result := -1
  else
    Result := 0;
end;

function SameStr(const S1, S2: string): Boolean;
begin
  Result := S1 = S2;
end;

function SameText(const S1, S2: string): Boolean;
begin
  Result := (Length(S1) = Length(S2)) and (CompareText(S1, S2) = 0);
end;

{ The order of two strings as -1, 0 or 1. }
function AnsiCompareStr(const S1, S2: string): Integer;
begin
  if S1 < S2 then
    Result := -1
  else if S1 > S2 then
    Result := 1
  else
    Result := 0;
end;

function AnsiCompareText(const S1, S2: string): Integer;
var
  r: Integer;
begin
  r := CompareText(S1, S2);
  if r < 0 then
    Result := -1
  else if r > 0 then
    Result := 1
  else
    Result := 0;
end;

function AnsiSameStr(const S1, S2: string): Boolean;
begin
  Result := S1 = S2;
end;

function AnsiSameText(const S1, S2: string): Boolean;
begin
  Result := SameText(S1, S2);
end;

function CompareMem(P1, P2: Pointer; Len: Integer): Boolean;
begin
  if (P1 = P2) or (Len <= 0) then
    Result := True
  else
    Result := CompareByte(PByte(P1)^, PByte(P2)^, Len) = 0;
end;

{ Blanks are the characters up to ' ', #0 among them. }
function Trim(const S: string): string;
var
  a, b: Integer;
begin
  a := 1;
  b := Length(S);
  while (a <= b) and (S[a] <= ' ') do
    a := a + 1;
  while (a <= b) and (S[b] <= ' ') do
    b := b - 1;
  if (a = 1) and (b = Length(S)) then
    Result := S
  else
    Result := Copy(S, a, b - a + 1);
end;

function TrimLeft(const S: string): string;
var
  a: Integer;
begin
  a := 1;
  while (a <= Length(S)) and (S[a] <= ' ') do
    a := a + 1;
  if a = 1 then
    Result := S
  else
    Result := Copy(S, a);
end;

function TrimRight(const S: string): string;
var
  b: Integer;
begin
  b := Length(S);
  while (b >= 1) and (S[b] <= ' ') do
    b := b - 1;
  if b = Length(S) then
    Result := S
  else
    Result := Copy(S, 1, b);
end;

function QuotedStr(const S: string): string;
begin
  Result := AnsiQuotedStr(S, '''');
end;

{ S between two Quotes, each Quote inside doubled. }
function AnsiQuotedStr(const S: string; Quote: Char): string;
var
  i, j: Integer;
begin
  Result := Quote;
  j := 1;
  i := Pos(Quote, S);
  while i > 0 do
  begin
    Result := Result + Copy(S, j, i - j + 1) + Quote;
    j := i + 1;
    i := Pos(Quote, S, j);
  end;
  Result := Result + Copy(S, j) + Quote;
end;

{ S unquoted when it starts with AQuote: the text to the closing one, a
  doubled one inside a single one; S as it is when it does not start
  with AQuote. }
function AnsiDequotedStr(const S: string; AQuote: Char): string;
var
  i: Integer;
begin
  if (Length(S) = 0) or (S[1] <> AQuote) then
  begin
    Result := S;
    Exit;
  end;
  Result := '';
  i := 2;
  while i <= Length(S) do
  begin
    if S[i] = AQuote then
    begin
      if (i < Length(S)) and (S[i + 1] = AQuote) then
      begin
        Result := Result + AQuote;
        i := i + 2;
        Continue;
      end;
      Exit;
    end;
    Result := Result + S[i];
    i := i + 1;
  end;
end;

function AnsiPos(const Substr, S: string): Integer;
begin
  Result := Pos(Substr, S);
end;

function LeftStr(const S: string; Count: Integer): string;
begin
  if Count <= 0 then
    Result := ''
  else
    Result := Copy(S, 1, Count);
end;

function RightStr(const S: string; Count: Integer): string;
begin
  if Count <= 0 then
    Result := ''
  else if Count >= Length(S) then
    Result := S
  else
    Result := Copy(S, Length(S) - Count + 1, Count);
end;

{ Free Pascal's StringReplace (syssr.inc): OldPattern found with Pos, in
  capitals on both sides for rfIgnoreCase, once or everywhere; the new
  string built once at its length. }
function StringReplace(const S, OldPattern, NewPattern: string; Flags: TReplaceFlags;
  out ACount: Integer): string;
var
  src, pat: string;
  p, np, q, k: Integer;
begin
  ACount := 0;
  if Length(OldPattern) = 0 then
  begin
    Result := S;
    Exit;
  end;
  if rfIgnoreCase in Flags then
  begin
    src := UpCase(S);
    pat := UpCase(OldPattern);
  end
  else
  begin
    src := S;
    pat := OldPattern;
  end;
  np := Length(pat);
  p := Pos(pat, src);
  if p = 0 then
  begin
    Result := S;
    Exit;
  end;
  Result := '';
  q := 1;
  k := 0;
  while p > 0 do
  begin
    Result := Result + Copy(S, q, p - q) + NewPattern;
    q := p + np;
    k := k + 1;
    if not (rfReplaceAll in Flags) then
      Break;
    p := Pos(pat, src, q);
  end;
  Result := Result + Copy(S, q);
  ACount := k;
end;

function StringReplace(const S, OldPattern, NewPattern: string; Flags: TReplaceFlags): string;
var
  n: Integer;
begin
  Result := StringReplace(S, OldPattern, NewPattern, Flags, n);
end;

function IsDelimiter(const Delimiters, S: string; Index: Integer): Boolean;
begin
  Result := (Index > 0) and (Index <= Length(S)) and (Pos(S[Index], Delimiters) > 0);
end;

function LastDelimiter(const Delimiters, S: string): Integer;
var
  chs: TSysCharSet;
  i: Integer;
begin
  chs := [];
  for i := 1 to Length(Delimiters) do
    Include(chs, Delimiters[i]);
  Result := Length(S);
  while (Result > 0) and not (S[Result] in chs) do
    Result := Result - 1;
end;

{ CR LF, CR alone and LF alone become the line end of the machine, LF. }
function AdjustLineBreaks(const S: string): string;
var
  i: Integer;
begin
  if Pos(#13, S) = 0 then
  begin
    Result := S;
    Exit;
  end;
  Result := '';
  i := 1;
  while i <= Length(S) do
  begin
    if S[i] = #13 then
    begin
      Result := Result + #10;
      if (i < Length(S)) and (S[i + 1] = #10) then
        i := i + 1;
    end
    else
      Result := Result + S[i];
    i := i + 1;
  end;
end;

{ Free Pascal's WrapText (sysstr.inc): Line cut into lines of up to
  MaxCol columns at a character of BreakChars, the text in quotes never
  cut, BreakStr put at each cut; a BreakStr in the text starts a line. }
function WrapText(const Line, BreakStr: string; const BreakChars: TSysCharSet;
  MaxCol: Integer): string;
var
  l: string;
  c, lq, bc: Char;
  p, blen, len: Integer;
  hb, ibc: Boolean;
begin
  Result := '';
  l := Line;
  blen := Length(BreakStr);
  if blen > 0 then
    bc := BreakStr[1]
  else
    bc := #0;
  len := Length(l);
  while len > 0 do
  begin
    p := 1;
    lq := #0;
    hb := False;
    ibc := False;
    while ((p <= len) and ((p <= MaxCol) or not ibc)) and ((lq <> #0) or not hb) do
    begin
      c := l[p];
      if c = lq then
        lq := #0
      else if (c = '''') or (c = '"') then
        lq := c;
      if lq <> #0 then
        p := p + 1
      else
      begin
        hb := (c = bc) and (BreakStr = Copy(l, p, blen));
        if hb then
          p := p + blen
        else
        begin
          if p >= MaxCol then
            ibc := c in BreakChars;
          p := p + 1;
        end;
      end;
    end;
    Result := Result + Copy(l, 1, p - 1);
    Delete(l, 1, p - 1);
    len := Length(l);
    if (len > 0) and not hb then
      Result := Result + BreakStr;
  end;
end;

function WrapText(const Line: string; MaxCol: Integer): string;
begin
  Result := WrapText(Line, sLineBreak, [' ', '-', #9], MaxCol);
end;

{ A letter or _ first, then letters, digits or _; with AllowDots a dot
  between names too, and with StrictDots none last. }
function IsValidIdent(const Ident: string; AllowDots: Boolean = False;
  StrictDots: Boolean = False): Boolean;
var
  i: Integer;
  first: Boolean;
  c: Char;
begin
  Result := False;
  if Length(Ident) < 1 then
    Exit;
  first := True;
  for i := 1 to Length(Ident) do
  begin
    c := Ident[i];
    if first then
    begin
      Result := (c in ['A'..'Z', 'a'..'z', '_']);
      first := False;
    end
    else if AllowDots and (c = '.') then
    begin
      if StrictDots then
      begin
        Result := i < Length(Ident);
        first := True;
      end;
    end
    else
      Result := c in ['A'..'Z', 'a'..'z', '0'..'9', '_'];
    if not Result then
      Exit;
  end;
end;

function CharInSet(C: Char; const CharSet: TSysCharSet): Boolean;
begin
  Result := C in CharSet;
end;

procedure AppendStr(var Dest: string; const S: string);
begin
  Dest := Dest + S;
end;

function BytesOf(const S: string): TBytes;
begin
  Result := nil;
  SetLength(Result, Length(S));
  if Length(S) > 0 then
    Move(S[1], Result[0], Length(S));
end;

function StringOf(const Bytes: TBytes): string;
begin
  Result := '';
  SetLength(Result, Length(Bytes));
  if Length(Bytes) > 0 then
    Move(Bytes[0], Result[1], Length(Bytes));
end;

{ ==== integers and Booleans ==== }

function IntToStr(Value: Int64): string;
begin
  Result := PasFmtInt(Value, 0);
end;

{ Value's 64 bits as an unsigned number, Free Pascal's QWord. }
function UIntToStr(Value: Int64): string;
var
  q, r: Int64;
begin
  if Value >= 0 then
  begin
    Result := PasFmtInt(Value, 0);
    Exit;
  end;
  { the unsigned value, halved to fit, then its last digit }
  q := (Value shr 1) div 5;
  r := Value - q * 10;
  Result := PasFmtInt(q, 0) + Chr(48 + r);
end;

{ The hexadecimal digits of Value's 64 bits, capitals, at least Digits of
  them with zeros in front. }
function IntToHex(Value: Int64; Digits: Integer): string;
const
  HexDigits = '0123456789ABCDEF';
var
  v: Int64;
begin
  Result := '';
  v := Value;
  repeat
    Result := HexDigits[(v and 15) + 1] + Result;
    v := v shr 4;
  until v = 0;
  while Length(Result) < Digits do
    Result := '0' + Result;
end;

{ All sixteen digits of an Int64, as Free Pascal's IntToHex(Int64). }
function IntToHex(Value: Int64): string;
begin
  Result := IntToHex(Value, 16);
end;

{ Val's reading (P134), and its code 0 the only success. }
function ReadInt(const S: string; Unsigned: Boolean; out V: Int64): Boolean;
var
  code: Int64;
begin
  V := PasValInt(S, Unsigned, code);
  Result := code = 0;
end;

{ Val's reading into a DWord's range, 0 to 2^32 - 1 (P149): a number past
  it is an error, as Free Pascal 3.3.1's TryStrToDWord says, where its
  low 32 bits were kept. }
function ReadDWord(const S: string; out V: Int64): Boolean;
var
  code: Int64;
begin
  V := PasValRange(S, 0, 4294967295, True, 32, code);
  Result := code = 0;
end;

procedure BadInt(const S: string);
begin
  raise EConvertError.Create('"' + S + '" is an invalid integer');
end;

function StrToInt(const S: string): Integer;
begin
  if not ReadInt(S, False, Result) then
    BadInt(S);
end;

function StrToInt64(const S: string): Int64;
begin
  if not ReadInt(S, False, Result) then
    BadInt(S);
end;

function StrToQWord(const S: string): Int64;
begin
  if not ReadInt(S, True, Result) then
    BadInt(S);
end;

function StrToUInt64(const S: string): Int64;
begin
  Result := StrToQWord(S);
end;

function StrToDWord(const S: string): Int64;
begin
  if not ReadDWord(S, Result) then
    BadInt(S);
end;

function StrToUInt(const S: string): Int64;
begin
  Result := StrToDWord(S);
end;

function StrToIntDef(const S: string; ADefault: Integer): Integer;
begin
  if not ReadInt(S, False, Result) then
    Result := ADefault;
end;

function StrToInt64Def(const S: string; ADefault: Int64): Int64;
begin
  if not ReadInt(S, False, Result) then
    Result := ADefault;
end;

function StrToQWordDef(const S: string; ADefault: Int64): Int64;
begin
  if not ReadInt(S, True, Result) then
    Result := ADefault;
end;

function StrToUInt64Def(const S: string; ADefault: Int64): Int64;
begin
  Result := StrToQWordDef(S, ADefault);
end;

function StrToDWordDef(const S: string; ADefault: Int64): Int64;
begin
  if not ReadDWord(S, Result) then
    Result := ADefault;
end;

function StrToUIntDef(const S: string; ADefault: Int64): Int64;
begin
  Result := StrToDWordDef(S, ADefault);
end;

function TryStrToInt(const S: string; out I: Integer): Boolean;
begin
  Result := ReadInt(S, False, I);
end;

function TryStrToInt64(const S: string; out I: Int64): Boolean;
begin
  Result := ReadInt(S, False, I);
end;

function TryStrToQWord(const S: string; out Q: Int64): Boolean;
begin
  Result := ReadInt(S, True, Q);
end;

function TryStrToUInt64(const S: string; out Q: Int64): Boolean;
begin
  Result := ReadInt(S, True, Q);
end;

function TryStrToDWord(const S: string; out D: Int64): Boolean;
begin
  Result := ReadDWord(S, D);
end;

function TryStrToUInt(const S: string; out U: Int64): Boolean;
begin
  Result := TryStrToDWord(S, U);
end;

procedure CheckBoolStrs;
begin
  if Length(TrueBoolStrs) = 0 then
  begin
    SetLength(TrueBoolStrs, 1);
    TrueBoolStrs[0] := 'True';
  end;
  if Length(FalseBoolStrs) = 0 then
  begin
    SetLength(FalseBoolStrs, 1);
    FalseBoolStrs[0] := 'False';
  end;
end;

{ '-1' and '0', as Free Pascal's; with UseBoolStrs the first of
  TrueBoolStrs and FalseBoolStrs, True and False unless set. }
function BoolToStr(B: Boolean; UseBoolStrs: Boolean = False): string;
begin
  if UseBoolStrs then
  begin
    CheckBoolStrs;
    if B then
      Result := TrueBoolStrs[0]
    else
      Result := FalseBoolStrs[0];
  end
  else if B then
    Result := '-1'
  else
    Result := '0';
end;

function BoolToStr(B: Boolean; const TrueS, FalseS: string): string;
begin
  if B then
    Result := TrueS
  else
    Result := FalseS;
end;

{ A number, any but 0 True; else one of TrueBoolStrs or FalseBoolStrs,
  whatever its case. }
function TryStrToBool(const S: string; out Value: Boolean): Boolean;
var
  code: Int64;
  d: Double;
  t: string;
  i: Integer;
begin
  Result := True;
  t := UpCase(S);
  d := PasValReal(t, code);
  if code = 0 then
  begin
    Value := d <> 0.0;
    Exit;
  end;
  CheckBoolStrs;
  for i := 0 to High(TrueBoolStrs) do
    if t = UpCase(TrueBoolStrs[i]) then
    begin
      Value := True;
      Exit;
    end;
  for i := 0 to High(FalseBoolStrs) do
    if t = UpCase(FalseBoolStrs[i]) then
    begin
      Value := False;
      Exit;
    end;
  Value := False;
  Result := False;
end;

function StrToBool(const S: string): Boolean;
begin
  if not TryStrToBool(S, Result) then
    raise EConvertError.Create('"' + S + '" is not a valid boolean.');
end;

function StrToBoolDef(const S: string; ADefault: Boolean): Boolean;
begin
  if not TryStrToBool(S, Result) then
    Result := ADefault;
end;

{ ==== reals ==== }

{ The text of a real as Free Pascal's TextToFloat takes it (sysstr.inc):
  no thousands separator, the decimal separator of the settings made a
  point (a point is refused when that is another), blanks cut off; the
  digits are then Val's. }
function RealText(const S: string; const AFormatSettings: TFormatSettings; out T: string): Boolean;
var
  p: Integer;
begin
  Result := False;
  T := S;
  if T = '' then
    Exit;
  if (AFormatSettings.ThousandSeparator <> AFormatSettings.DecimalSeparator) and
    (Pos(AFormatSettings.ThousandSeparator, T) <> 0) then
    Exit;
  if AFormatSettings.DecimalSeparator <> '.' then
  begin
    if Pos('.', T) <> 0 then
      Exit;
    p := Pos(AFormatSettings.DecimalSeparator, T);
    if p <> 0 then
      T[p] := '.';
  end;
  T := Trim(T);
  Result := True;
end;

function TryStrToFloat(const S: string; out Value: Double;
  const AFormatSettings: TFormatSettings): Boolean;
var
  t: string;
  code: Int64;
begin
  Value := 0;
  Result := False;
  if not RealText(S, AFormatSettings, t) then
    Exit;
  Value := PasValReal(t, code);
  Result := code = 0;
end;

function TryStrToFloat(const S: string; out Value: Double): Boolean;
begin
  Result := TryStrToFloat(S, Value, DefaultFormatSettings);
end;

{ A Single rounded once from the digits (P146). }
function TryStrToFloat(const S: string; out Value: Single;
  const AFormatSettings: TFormatSettings): Boolean;
var
  t: string;
  code: Int64;
begin
  Value := 0;
  Result := False;
  if not RealText(S, AFormatSettings, t) then
    Exit;
  Value := PasValSingle(t, code);
  Result := code = 0;
end;

function TryStrToFloat(const S: string; out Value: Single): Boolean;
begin
  Result := TryStrToFloat(S, Value, DefaultFormatSettings);
end;

function StrToFloat(const S: string; const AFormatSettings: TFormatSettings): Extended;
begin
  if not TryStrToFloat(S, Result, AFormatSettings) then
    raise EConvertError.Create('"' + S + '" is an invalid float');
end;

function StrToFloat(const S: string): Extended;
begin
  Result := StrToFloat(S, DefaultFormatSettings);
end;

function StrToFloatDef(const S: string; const ADefault: Extended;
  const AFormatSettings: TFormatSettings): Extended;
begin
  if not TryStrToFloat(S, Result, AFormatSettings) then
    Result := ADefault;
end;

function StrToFloatDef(const S: string; const ADefault: Extended): Extended;
begin
  Result := StrToFloatDef(S, ADefault, DefaultFormatSettings);
end;

{ ==== reals as text (P129) ==== }

{ A real's digits as Go makes them (the manual's §19): the unrounded
  scaling of Go's src/internal/strconv/uscale.go and ftoa.go (Russ Cox,
  "Floating-Point Printing and Parsing Can Be Simple And Fast",
  research.swtch.com/fp), the exact expansion past 18 digits as its
  bignum case; rounded once, a tie to even. Go's license covers the
  port (LICENSE-GO). }

