    100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000,
    100000000000000, 1000000000000000, 10000000000000000, 100000000000000000,
    1000000000000000000);

type
  { the scaling constants of an e, p pair (uscale.go's scaler) }
  TScaler = record
    PmHi, PmLo, S: Int64;
  end;

{ A below B as 64-bit unsigned numbers. }
function ULt(A, B: Int64): Boolean;
begin
  Result := (A xor Low(Int64)) < (B xor Low(Int64));
end;

{ floor(x * log10 2) and floor(x * log2 10) (uscale.go's log10Pow2,
  log2Pow10) }
function Log10Pow2(X: Int64): Int64;
begin
  Result := (X * 78913) sar 18;
end;

function Log2Pow10(X: Int64): Int64;
begin
  Result := (X * 108853) sar 15;
end;

{ An unrounded value (uscale.go): the value times 4, its low bit set
  when anything below was lost. }
function UFloor(U: Int64): Int64;
begin
  Result := U shr 2;
end;

function URound(U: Int64): Int64;
begin
  Result := (U + 1 + ((U shr 2) and 1)) shr 2;
end;

function UCeil(U: Int64): Int64;
begin
  Result := (U + 3) shr 2;
end;

{ U divided by 10 as an unsigned number, the lost part in the low bit. }
function UDiv10(U: Int64): Int64;
var
  q: Int64;
begin
  q := (U shr 1) div 5;
  Result := q or (U and 1);
  if U - q * 10 <> 0 then
    Result := Result or 1;
end;

{ the least unrounded value that rounds to X }
function UnMin(X: Int64): Int64;
begin
  Result := (X shl 2) - 2;
end;

procedure Prescale(var Pre: TScaler; E, P, Lp: Int64);
begin
  Pre.PmHi := Pow10Tab[2 * (P - Pow10Min)];
  Pre.PmLo := Pow10Tab[2 * (P - Pow10Min) + 1];
  Pre.S := -(E + Lp + 3);
end;

{ unround(X * 2^e * 10^p) for the Pre of e, p; X left-justified. }
function UScale(X: Int64; const Pre: TScaler): Int64;
var
  hi, mid, mid2, s: Int64;
begin
  hi := MulHi(X, Pre.PmHi);
  mid := X * Pre.PmHi;
  s := Pre.S and 63;
  if ((hi shr s) shl s) <> hi then
  begin
    Result := (hi shr s) or 1;
    Exit;
  end;
  mid2 := MulHi(X, Pre.PmLo);
  if ULt(mid, mid2) then
    hi := hi - 1;
  Result := hi shr s;
  if ULt(1, mid - mid2) then
    Result := Result or 1;
end;

{ The N-digit (18 at most) decimal form of M * 2^E as D * 10^P
  (fixedWidthFloat); with Decs >= 0, the 'f' form: N an estimate, digits
  dropped until Decs are left after the point. }
procedure FixedWidth(M, E, N, Decs: Int64; out D, P: Int64);
var
  pre: TScaler;
  u, q: Int64;
begin
  q := N - 1 - Log10Pow2(E + 63);
  Prescale(pre, E, q, Log2Pow10(q));
  u := UScale(M, pre);
  if not ULt(u, UnMin(Pow10U[N])) then
  begin
    u := UDiv10(u);
    q := q - 1;
  end;
  if Decs >= 0 then
    while q > Decs do
    begin
      u := UDiv10(u);
      q := q - 1;
    end;
  D := URound(u);
  P := -q;
end;

{ floor(log10(3/4 * 2^e)) (skewed) }
function Skewed(E: Int64): Int64;
begin
  Result := (E * 631305 - 261663) sar 21;
end;

{ The fewest digits of M * 2^E that read back as the same real
  (shortFloat) of MantBits bits (52 a Double, 23 a Single): D * 10^P. }
procedure ShortFloat(M, E: Int64; MantBits, MinExp: Integer; out D, P: Int64);
var
  z, oddm, mn, mx, dmin, dmax, dd, q: Int64;
  pre: TScaler;
begin
  z := 63 - MantBits;
  if (M = Low(Int64)) and (E > MinExp) then
  begin
    q := -Skewed(E + z);
    mn := M - (Int64(1) shl (z - 2));
    mx := M + (Int64(1) shl (z - 1));
  end
  else if E >= MinExp then
  begin
    q := -Log10Pow2(E + z);
    mn := M - (Int64(1) shl (z - 1));
    mx := M + (Int64(1) shl (z - 1));
  end
  else
  begin
    z := z + (MinExp - E);
    q := -Log10Pow2(E + z);
    mn := M - (Int64(1) shl (z - 1));
    mx := M + (Int64(1) shl (z - 1));
  end;
  oddm := (M shr z) and 1;
  Prescale(pre, E, q, Log2Pow10(q));
  dmin := UCeil(UScale(mn, pre) + oddm);
  dmax := UFloor(UScale(mx, pre) - oddm);
  dd := dmax div 10;
  if not ULt(dd * 10, dmin) then
  begin
    D := dd;
    P := -(q - 1);
    Exit;
  end;
  dd := dmin;
  if ULt(dd, dmax) then
    dd := URound(UScale(M, pre));
  D := dd;
  P := -q;
end;

{ The digits of D (not 0) with its trailing zeros gone, and the place of
  the point for D * 10^P (setDigits, numDigits): the count of digits from
  the bits, the zeros taken off the number, one string made. }
procedure SetDigits(Dv, P: Int64; out S: string; out Dp: Integer);
var
  nd: Integer;
begin
  nd := Log10Pow2(64 - LeadingZeros(Dv));
  if Dv >= Pow10U[nd] then
    nd := nd + 1;
  Dp := nd + P;
  while Dv mod 10 = 0 do
    Dv := Dv div 10;
  S := PasFmtInt(Dv, 0);
end;

{ A real's parts: its sign, its mantissa left-justified in 64 bits and
  the power of 2 of that mantissa; Kind 0 a number, 1 a zero, 2 an
  infinity, 3 a NaN. Of a Single when IsSingle. }
procedure SplitReal(X: Double; IsSingle: Boolean; out Neg: Boolean; out M, E: Int64;
  out Kind: Integer);
var
  bits, ex, mant, s: Int64;
  sg: Single;
  sb: Int32;
  mbits, bias, emax: Integer;
begin
  if IsSingle then
  begin
    sg := Single(X);
    Move(sg, sb, 4);
    bits := Int64(sb) and 4294967295;
    Neg := (bits shr 31) <> 0;
    ex := (bits shr 23) and 255;
    mant := bits and 8388607;
    mbits := 23;
    bias := -127;
    emax := 255;
  end
  else
  begin
    bits := 0;
    Move(X, bits, 8);
    Neg := bits < 0;
    ex := (bits shr 52) and 2047;
    mant := bits and 4503599627370495;
    mbits := 52;
    bias := -1023;
    emax := 2047;
  end;
  if ex = emax then
  begin
    if mant <> 0 then
      Kind := 3
    else
      Kind := 2;
    M := 0;
    E := 0;
    Exit;
  end;
  if ex = 0 then
    ex := 1
  else
    mant := mant or (Int64(1) shl mbits);
  if mant = 0 then
  begin
    Kind := 1;
    M := 0;
    E := 0;
    Exit;
  end;
  Kind := 0;
  ex := ex + bias;
  s := 64 - (64 - LeadingZeros(mant));
  M := mant shl s;
  E := ex - s - mbits;
end;

{ Every significant digit of the magnitude of X (finite, not 0) exactly:
  X = 0.D * 10^Dp; from pasfmt's exact expansion, Go's bignum case. }
procedure ExactDigits(X: Double; out D: string; out Dp: Integer);
var
  bits, e2: Int64;
  t: string;
  p, first, last: Integer;
begin
  bits := 0;
  Move(X, bits, 8);
  bits := bits and High(Int64);
  Move(bits, X, 8);
  e2 := (bits shr 52) and 2047;
  if e2 = 0 then
    e2 := 1;
  e2 := e2 - 1075;
  if e2 < 0 then
    t := PasFmtReal(X, 0, -e2)
  else
    t := PasFmtReal(X, 0, 0);
  p := Pos('.', t);
  if p = 0 then
    p := Length(t) + 1
  else
    Delete(t, p, 1);
  first := 1;
  while (first <= Length(t)) and (t[first] = '0') do
    first := first + 1;
  last := Length(t);
  while (last > first) and (t[last] = '0') do
    last := last - 1;
  D := Copy(t, first, last - first + 1);
  Dp := p - first;
end;

{ Exact digits D, the point after Dp of them, rounded to N digits, a tie
  to even as Go's decimal.Round: D keeps at most N digits, its trailing
  zeros gone; a carry out of the first digit a 1 and Dp one more; N 0
  rounds to the left of every digit, and below 0 further left, where
  every value rounds to 0 (D ''). }
procedure RoundDigits(var D: string; var Dp: Integer; N: Integer);
var
  up: Boolean;
  k: Integer;
begin
  if N < 0 then
  begin
    D := '';
    Exit;
  end;
  if N >= Length(D) then
    Exit;
  if (D[N + 1] = '5') and (N + 1 = Length(D)) then
    up := (N > 0) and (((Ord(D[N]) - 48) and 1) <> 0)
  else
    up := D[N + 1] >= '5';
  D := Copy(D, 1, N);
  if up then
  begin
    k := N;
    while (k >= 1) and (D[k] = '9') do
      k := k - 1;
    if k = 0 then
    begin
      D := '1';
      Dp := Dp + 1;
    end
    else
    begin
      D := Copy(D, 1, k - 1) + Chr(Ord(D[k]) + 1);
    end;
  end
  else
  begin
    k := Length(D);
    while (k > 0) and (D[k] = '0') do
      k := k - 1;
    D := Copy(D, 1, k);
  end;
end;

{ The fewest digits that read back as X, a Double, or as the Single it
  holds when IsSingle: X = 0.D * 10^Dp (X finite, not 0). }
procedure ShortestDigits(X: Double; IsSingle: Boolean; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p: Int64;
  kind: Integer;
begin
  SplitReal(X, IsSingle, neg, m, e, kind);
  if IsSingle then
    ShortFloat(m, e, 23, -189, dv, p)
  else
    ShortFloat(m, e, 52, -1085, dv, p);
  SetDigits(dv, p, D, Dp);
end;

{ N significant digits of X (finite, not 0) rounded once, a tie to even:
  at most N digits in D, their trailing zeros gone; X = 0.D * 10^Dp. N 0
  or below rounds as RoundDigits does. }
procedure SigDigits(X: Double; N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p: Int64;
  kind: Integer;
begin
  if (N >= 1) and (N <= 18) then
  begin
    SplitReal(X, False, neg, m, e, kind);
    FixedWidth(m, e, N, -1, dv, p);
    SetDigits(dv, p, D, Dp);
    Exit;
  end;
  ExactDigits(X, D, Dp);
  RoundDigits(D, Dp, N);
end;

{ The digits of X (finite, not 0) rounded once at Decs places after the
  point, a tie to even ('f'; Decs below 0 a place before the point): D
  may be '' (it rounds to 0), its trailing zeros gone; X = 0.D * 10^Dp. }
procedure FracDigits(X: Double; Decs: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  m, e, dv, p, ex, digits, bits: Int64;
  kind: Integer;
begin
  bits := 0;
  Move(X, bits, 8);
  ex := (bits shr 52) and 2047;
  if ex = 0 then
    ex := 1;
  ex := ex - 1023;
  if ex >= 0 then
    digits := 1 + Log10Pow2(1 + ex) + Decs
  else
    digits := 1 + Decs - Log10Pow2(-ex);
  if (digits <= 18) and (Decs >= 0) then
  begin
    D := '';
    Dp := 0;
    if digits <= 0 then
      Exit;
    SplitReal(X, False, neg, m, e, kind);
    FixedWidth(m, e, digits, Decs, dv, p);
    if dv <> 0 then
      SetDigits(dv, p, D, Dp);
    Exit;
  end;
  ExactDigits(X, D, Dp);
  RoundDigits(D, Dp, Dp + Decs);
  if D = '' then
    Dp := 0;
end;

{ ---- the text of a real (P129) ---- }

{ Free Pascal's forms and names (sysstr.inc, fmtflt.inc), Go's digits:
  correctly rounded once, a tie to even, and the fewest that read back
  when no precision is asked (the manual's §19). NaN, +Inf and -Inf as
  paslang and Go write them. }

function SpecialText(Kind: Integer; Neg: Boolean): string;
begin
  if Kind = 3 then
    Result := 'NaN'
  else if Neg then
    Result := '-Inf'
  else
    Result := '+Inf';
end;

{ Each form below works out its length first and makes its string once,
  filled through a pointer with Move and FillChar: a string built with +
  makes one for every piece, and FloatToStr took four times Go's time.

  D (trailing zeros gone) with the point after Dp of its digits, as a
  number with Decs places ('' for none); zeros where D has no digit. }
function FixedOf(const D: string; Dp, Decs: Integer; Sep: Char): string;
var
  nd, ip, lz, mid, tz, off, n, k: Integer;
  p, q: PChar;
begin
  nd := Length(D);
  if (Dp > 0) and (nd > 0) then
    ip := Dp
  else
    ip := 1;
  lz := 0;
  mid := 0;
  tz := 0;
  off := 0;
  n := ip;
  if Decs > 0 then
  begin
    if nd = 0 then
      lz := Decs
    else
    begin
      lz := -Dp;
      if lz < 0 then
        lz := 0;
      if lz > Decs then
        lz := Decs;
    end;
    off := Dp + lz;
    mid := nd - off;
    if mid > Decs - lz then
      mid := Decs - lz;
    if mid < 0 then
      mid := 0;
    tz := Decs - lz - mid;
    n := ip + 1 + Decs;
  end;
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  q := PChar(D);
  if (Dp > 0) and (nd > 0) then
  begin
    if Dp <= nd then
      Move(q^, p^, Dp)
    else
    begin
      Move(q^, p^, nd);
      FillChar(p[nd], Dp - nd, 48);
    end;
  end
  else
    p[0] := '0';
  if Decs > 0 then
  begin
    k := ip;
    p[k] := Sep;
    k := k + 1;
    if lz > 0 then
      FillChar(p[k], lz, 48);
    k := k + lz;
    if mid > 0 then
      Move(q[off], p[k], mid);
    k := k + mid;
    if tz > 0 then
      FillChar(p[k], tz, 48);
  end;
end;

{ The integer part of a fixed number with a thousands separator every
  three digits, as ffNumber and ffCurrency write it. }
function Grouped(const S: string; DecSep, ThouSep: Char): string;
var
  p, k: Integer;
begin
  Result := S;
  if ThouSep = #0 then
    Exit;
  p := Pos(DecSep, Result);
  if p = 0 then
    p := Length(Result) + 1;
  k := p - 3;
  while k > 1 do
  begin
    Insert(ThouSep, Result, k);
    k := k - 3;
  end;
end;

{ ffGeneral: the digits with the point where it goes while the exponent
  is above -6 and below Thr, else d.dddEx with no sign for a positive
  exponent and no leading zeros, as Free Pascal writes it. }
function GeneralOf(Neg: Boolean; const D: string; Dp, Thr: Integer; Sep: Char): string;
var
  ex, nd, n, k, j, e, ed: Integer;
  plain: Boolean;
  p, q: PChar;
begin
  nd := Length(D);
  ex := Dp - 1;
  plain := (ex > -6) and (ex < Thr);
  e := Abs(ex);
  ed := 1;
  if plain then
  begin
    if Dp <= 0 then
      n := 2 - Dp + nd
    else if Dp >= nd then
      n := Dp
    else
      n := nd + 1;
  end
  else
  begin
    if e >= 10 then
      ed := 2;
    if e >= 100 then
      ed := 3;
    if e >= 1000 then
      ed := 4;
    n := nd + 1 + ed + Ord(ex < 0);
    if nd > 1 then
      n := n + 1;
  end;
  n := n + Ord(Neg);
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  q := PChar(D);
  k := 0;
  if Neg then
  begin
    p[0] := '-';
    k := 1;
  end;
  if plain then
  begin
    if Dp <= 0 then
    begin
      p[k] := '0';
      p[k + 1] := Sep;
      k := k + 2;
      if Dp < 0 then
        FillChar(p[k], -Dp, 48);
      Move(q^, p[k - Dp], nd);
    end
    else if Dp >= nd then
    begin
      Move(q^, p[k], nd);
      if Dp > nd then
        FillChar(p[k + nd], Dp - nd, 48);
    end
    else
    begin
      Move(q^, p[k], Dp);
      p[k + Dp] := Sep;
      Move(q[Dp], p[k + Dp + 1], nd - Dp);
    end;
  end
  else
  begin
    p[k] := q[0];
    k := k + 1;
    if nd > 1 then
    begin
      p[k] := Sep;
      Move(q[1], p[k + 1], nd - 1);
      k := k + nd;
    end;
    p[k] := 'E';
    k := k + 1;
    if ex < 0 then
    begin
      p[k] := '-';
      k := k + 1;
    end;
    j := k + ed - 1;
    while j >= k do
    begin
      p[j] := Chr(48 + e mod 10);
      e := e div 10;
      j := j - 1;
    end;
  end;
end;

{ ffExponent: one digit, the point, Prec - 1 more (the digits D has when
  Prec is 0: the fewest), E, the exponent's sign and at least ExpDigits of
  its digits (4 at most); with ExpDigits 0 or below an exponent 0 is not
  written, E and sign too, as Free Pascal drops it. }
function ExponentOf(Neg: Boolean; const D: string; Dp, Prec, ExpDigits: Integer; Sep: Char): string;
var
  nd, ex, fr, have, e, ed, n, k, j: Integer;
  withExp: Boolean;
  p, q: PChar;
begin
  nd := Length(D);
  if nd = 0 then
    ex := 0
  else
    ex := Dp - 1;
  if Prec <= 0 then
    fr := nd - 1
  else
    fr := Prec - 1;
  if fr < 0 then
    fr := 0;
  if ExpDigits > 4 then
    ExpDigits := 4;
  withExp := (ExpDigits > 0) or (ex <> 0);
  e := Abs(ex);
  ed := 1;
  if e >= 10 then
    ed := 2;
  if e >= 100 then
    ed := 3;
  if e >= 1000 then
    ed := 4;
  if ed < ExpDigits then
    ed := ExpDigits;
  n := Ord(Neg) + 1;
  if fr > 0 then
    n := n + 1 + fr;
  if withExp then
    n := n + 2 + ed;
  Result := '';
  SetLength(Result, n);
  p := @Result[1];
  q := PChar(D);
  k := 0;
  if Neg then
  begin
    p[0] := '-';
    k := 1;
  end;
  if nd = 0 then
    p[k] := '0'
  else
    p[k] := q[0];
  k := k + 1;
  if fr > 0 then
  begin
    p[k] := Sep;
    k := k + 1;
    have := nd - 1;
    if have > fr then
      have := fr;
    if have < 0 then
      have := 0;
    if have > 0 then
      Move(q[1], p[k], have);
    if fr > have then
      FillChar(p[k + have], fr - have, 48);
    k := k + fr;
  end;
  if withExp then
  begin
    p[k] := 'E';
    if ex < 0 then
      p[k + 1] := '-'
    else
      p[k + 1] := '+';
    k := k + 2;
    j := k + ed - 1;
    while j >= k do
    begin
      p[j] := Chr(48 + e mod 10);
      e := e div 10;
      j := j - 1;
    end;
  end;
end;

{ The money forms (sysstr.inc's FloatToStrFIntl): CurrencyFormat for a
  positive amount, NegCurrFormat for a negative one; a format out of
  their range writes the amount alone, with its sign. }
function CurrencyOf(Neg: Boolean; const S: string; const FS: TFormatSettings): string;
var
  c: string;
begin
  c := FS.CurrencyString;
  if not Neg then
    case FS.CurrencyFormat of
      0: Result := c + S;
      1: Result := S + c;
      2: Result := c + ' ' + S;
      3: Result := S + ' ' + c;
    else
      Result := S;
    end
  else
    case FS.NegCurrFormat of
      0: Result := '(' + c + S + ')';
      1: Result := '-' + c + S;
      2: Result := c + '-' + S;
      3: Result := c + S + '-';
      4: Result := '(' + S + c + ')';
      5: Result := '-' + S + c;
      6: Result := S + '-' + c;
      7: Result := S + c + '-';
      8: Result := '-' + S + ' ' + c;
      9: Result := '-' + c + ' ' + S;
      10: Result := S + ' ' + c + '-';
      11: Result := c + ' ' + S + '-';
      12: Result := c + ' ' + '-' + S;
      13: Result := S + '-' + ' ' + c;
      14: Result := '(' + c + ' ' + S + ')';
      15: Result := '(' + S + ' ' + c + ')';
    else
      Result := '-' + S;
    end;
end;

{ The digits of an integer as a real's: D without trailing zeros, Dp
  its length. }
procedure IntDigits(V: Int64; out D: string; out Dp: Integer; out Neg: Boolean);
var
  k: Integer;
begin
  Neg := V < 0;
  D := UIntToStr(Abs(V));
  if V = Low(Int64) then
    D := '9223372036854775808';
  Dp := Length(D);
  k := Length(D);
  while (k > 0) and (D[k] = '0') do
    k := k - 1;
  D := Copy(D, 1, k);
end;

{ A Quad's parts: its sign and Kind as SplitReal's; its two words. }
procedure SplitQuad(Q: Quad; out Neg: Boolean; out Lo, Hi: Int64; out Kind: Integer);
var
  w: array[0..1] of Int64;
  ex: Int64;
begin
  Move(Q, w, 16);
  Lo := w[0];
  Hi := w[1];
  Neg := Hi < 0;
  ex := (Hi shr 48) and 32767;
  if ex = 32767 then
  begin
    if ((Hi and 281474976710655) <> 0) or (Lo <> 0) then
      Kind := 3
    else
      Kind := 2;
  end
  else if (ex = 0) and ((Hi and 281474976710655) = 0) and (Lo = 0) then
    Kind := 1
  else
    Kind := 0;
end;

{ A PChar's characters to its #0 (Format's %s of one). }
function PCharText(P: PChar): string;
var
  n: Int64;
begin
  Result := '';
  if P = nil then
    Exit;
  n := 0;
  while P[n] <> #0 do
    n := n + 1;
  SetLength(Result, n);
  if n > 0 then
    Move(P^, Result[1], n);
end;

type
  { a value the formats write: a Double, a Single's, an integer's, a
    Quad's }
  TRealSource = (rsDouble, rsSingle, rsInt, rsQuad);
  TRealArg = record
    Src: TRealSource;
    X: Double;
    I: Int64;
    Q: Quad;
  end;

{ A value to write, in A, every field set (a record a function returned,
  or Default made, goes through the heap at every call). }
procedure ArgDouble(out A: TRealArg; X: Double);
begin
  A.Src := rsDouble;
  A.X := X;
  A.I := 0;
  A.Q := 0;
end;

procedure ArgSingle(out A: TRealArg; X: Single);
begin
  A.Src := rsSingle;
  A.X := X;
  A.I := 0;
  A.Q := 0;
end;

procedure ArgInt(out A: TRealArg; V: Int64);
begin
  A.Src := rsInt;
  A.X := 0;
  A.I := V;
  A.Q := 0;
end;

procedure ArgQuad(out A: TRealArg; Q: Quad);
begin
  A.Src := rsQuad;
  A.X := 0;
  A.I := 0;
  A.Q := Q;
end;

{ A value's sign and kind as SplitReal's: 0 a number, 1 a zero, 2 an
  infinity, 3 a NaN. }
procedure ArgKind(const A: TRealArg; out Neg: Boolean; out Kind: Integer);
var
  m, e, lo, hi: Int64;
begin
  case A.Src of
    rsInt:
      begin
        Neg := A.I < 0;
        if A.I = 0 then
          Kind := 1
        else
          Kind := 0;
      end;
    rsQuad:
      SplitQuad(A.Q, Neg, lo, hi, Kind);
  else
    SplitReal(A.X, A.Src = rsSingle, Neg, m, e, Kind);
  end;
end;

{ A Quad's digits in Mode, as pasfmt's PasQuadDigits writes them. }
procedure QuadDigits(const A: TRealArg; Mode, N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
  lo, hi, p: Int64;
  kind: Integer;
begin
  SplitQuad(A.Q, neg, lo, hi, kind);
  D := PasQuadDigits(lo, hi, Mode, N, p);
  Dp := p;
end;

{ The fewest digits that read back as the value in its own type; an
  integer's are all of them. }
procedure ArgShortest(const A: TRealArg; out D: string; out Dp: Integer);
var
  neg: Boolean;
begin
  case A.Src of
    rsDouble:
      ShortestDigits(A.X, False, D, Dp);
    rsSingle:
      ShortestDigits(A.X, True, D, Dp);
    rsQuad:
      QuadDigits(A, 0, 0, D, Dp);
  else
    IntDigits(A.I, D, Dp, neg);
  end;
end;

{ N significant digits of the value, rounded once, a tie to even (a
  Single's are its Double's: the same value). }
procedure ArgSig(const A: TRealArg; N: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
begin
  case A.Src of
    rsDouble, rsSingle:
      SigDigits(A.X, N, D, Dp);
    rsQuad:
      QuadDigits(A, 1, N, D, Dp);
  else
    begin
      IntDigits(A.I, D, Dp, neg);
      RoundDigits(D, Dp, N);
    end;
  end;
end;

{ The value's digits rounded once at Decs places after the point, a tie
  to even; D '' and Dp 0 when it rounds to 0. }
procedure ArgFrac(const A: TRealArg; Decs: Integer; out D: string; out Dp: Integer);
var
  neg: Boolean;
begin
  case A.Src of
    rsDouble, rsSingle:
      FracDigits(A.X, Decs, D, Dp);
    rsQuad:
      QuadDigits(A, 2, Decs, D, Dp);
  else
    begin
      IntDigits(A.I, D, Dp, neg);
      RoundDigits(D, Dp, Dp + Decs);
      if D = '' then
        Dp := 0;
    end;
  end;
end;

{ One real in Free Pascal's formats: the digits rounded once, a tie to
  even (Go's), Precision 0 or below the fewest that read back; a Single's
  and a Quad's as their own type's, an integer's exact. No count of
  digits is capped: what is asked is written, as Go does. }
function RealText(const A: TRealArg; Fmt: TFloatFormat; Precision, Digits: Integer;
  const FS: TFormatSettings): string;
var
  neg: Boolean;
  kind, dp, thr: Integer;
  d, s: string;
begin
  ArgKind(A, neg, kind);
  if kind >= 2 then
  begin
    Result := SpecialText(kind, neg);
    Exit;
  end;
  d := '';
  dp := 0;
  case Fmt of
    ffGeneral, ffExponent:
      begin
        if kind = 0 then
        begin
          if Precision <= 0 then
            ArgShortest(A, d, dp)
          else
            ArgSig(A, Precision, d, dp);
        end;
        if Fmt = ffGeneral then
        begin
          if d = '' then
            Result := '0'
          else
          begin
            thr := Precision;
            if thr <= 0 then
              thr := 15;
            Result := GeneralOf(neg, d, dp, thr, FS.DecimalSeparator);
          end;
        end
        else
          Result := ExponentOf(neg and (d <> ''), d, dp, Precision, Digits, FS.DecimalSeparator);
      end;
  else
    begin
      if Digits < 0 then
      begin
        if Fmt = ffCurrency then
          Digits := FS.CurrencyDecimals
        else
          Digits := 2;
      end;
      if kind = 0 then
        ArgFrac(A, Digits, d, dp);
      neg := neg and (d <> '');
      s := FixedOf(d, dp, Digits, FS.DecimalSeparator);
      if Fmt <> ffFixed then
        s := Grouped(s, FS.DecimalSeparator, FS.ThousandSeparator);
      if Fmt = ffCurrency then
        Result := CurrencyOf(neg, s, FS)
      else if neg then
        Result := '-' + s
      else
        Result := s;
    end;
  end;
end;

function FloatToStrF(Value: Double; AFormat: TFloatFormat; Precision, Digits: Integer;
  const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := RealText(a, AFormat, Precision, Digits, AFormatSettings);
end;

