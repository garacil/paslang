{$mode objfpc}{$H+}

{ SysUtils (P128-P133): a modern Pascal system library. Familiar Pascal
  names retain their intended semantics; Free Pascal is an executable
  reference, not the design specification. Current Go and the system
  contracts guide ownership, scheduling, exactness and explicit errors, on
  paslang's own words: a string is UTF-8 and the Ansi routines work on
  it, Integer is 64 bits, a file is a descriptor the runtime reads and
  writes by parking the routine. The unit is built for the base
  processor and again for a level of each machine (P143), so the words
  it calls take the kernels of the program's -cpu, and its own kernel
  pairs are chosen by the CPU_ words (P148). Where Free Pascal carries a
  limit or an approximation of its history, the unit follows Go and the
  manual's §19 says so: a real is written with its digits correctly
  rounded, once, the fewest that read back when no precision is asked;
  the local clock of the dates and times is Go's time.Local (pastime's
  zone: TZ, /etc/localtime, the TZif files). Sleep and LowerCase are
  words of the language, which SysUtils does not declare again. }

unit sysutils;

interface

type
  { ---- the types ---- }
  TBytes = array of Byte;
  TSysCharSet = set of Char;
  TReplaceFlag = (rfReplaceAll, rfIgnoreCase);
  TReplaceFlags = set of TReplaceFlag;
  THandle = Integer;

  { ---- the settings of the formats: separators, money, dates ---- }
  TMonthNameArray = array[1..12] of string;
  TWeekNameArray = array[1..7] of string;
  { ---- the text of reals ---- }
  TFloatFormat = (ffGeneral, ffExponent, ffFixed, ffNumber, ffCurrency);
  TFloatValue = (fvExtended, fvCurrency, fvSingle, fvReal, fvDouble, fvComp);
  TFloatRec = record
    Exponent: Integer;
    Negative: Boolean;
    Digits: array[0..18] of Char;
  end;

  { ---- dates and times (P131) ---- }
  { the days since 1899-12-30, the time the fraction of a day; before it
    the fraction is still the time: -1.25 is 1899-12-29 06:00 }
  TDateTime = Double;
  TDate = TDateTime;
  TTime = TDateTime;
  PDateTime = ^TDateTime;
  PDayTable = ^TDayTable;
  TDayTable = array[1..12] of Word;
  TFormatDateTimeOption = (fdoInterval);
  TFormatDateTimeOptions = set of TFormatDateTimeOption;
  TSystemTime = record
    case Integer of
      0: (Year, Month, Day, DayOfWeek: Word;
          Hour, Minute, Second, MilliSecond: Word);
      1: (wYear, wMonth, wDay, wDayOfWeek: Word;
          wHour, wMinute, wSecond, wMilliseconds: Word);
  end;
  { Time, the milliseconds since midnight; Date, one more than the days
    since 0001-01-01 }
  TTimeStamp = record
    Time: LongInt;
    Date: LongInt;
  end;

  TFormatSettings = record
    CurrencyFormat: Byte;
    NegCurrFormat: Byte;
    ThousandSeparator: Char;
    DecimalSeparator: Char;
    CurrencyDecimals: Byte;
    DateSeparator: Char;
    TimeSeparator: Char;
    ListSeparator: Char;
    CurrencyString: string;
    ShortDateFormat: string;
    LongDateFormat: string;
    TimeAMString: string;
    TimePMString: string;
    ShortTimeFormat: string;
    LongTimeFormat: string;
    ShortMonthNames: TMonthNameArray;
    LongMonthNames: TMonthNameArray;
    ShortDayNames: TWeekNameArray;
    LongDayNames: TWeekNameArray;
    TwoDigitYearCenturyWindow: Word;
  end;

  { ---- the exceptions ---- }
  Exception = class(TObject)
  private
    FMessage: string;
    FHelpContext: Integer;
  public
    constructor Create(const Msg: string);
    constructor CreateFmt(const Msg: string; const Args: array of const);
    constructor CreateHelp(const Msg: string; AHelpContext: Integer);
    constructor CreateFmtHelp(const Msg: string; const Args: array of const; AHelpContext: Integer);
    function ToString: string; override;
    function GetBaseException: Exception; virtual;
    property HelpContext: Integer read FHelpContext write FHelpContext;
    property Message: string read FMessage write FMessage;
  end;

  ExceptClass = class of Exception;

  EExternal = class(Exception);
  EIntError = class(EExternal);
  EDivByZero = class(EIntError);
  ERangeError = class(EIntError);
  EIntOverflow = class(EIntError);
  EMathError = class(EExternal);
  EInvalidOp = class(EMathError);
  EZeroDivide = class(EMathError);
  EOverflow = class(EMathError);
  EUnderflow = class(EMathError);

  EInOutError = class(Exception)
  public
    ErrorCode: Integer;
  end;

  EHeapMemoryError = class(Exception);
  EExternalException = class(EExternal);
  EInvalidPointer = class(EHeapMemoryError);
  EOutOfMemory = class(EHeapMemoryError);
  EInvalidCast = class(Exception);

  EVariantError = class(Exception)
  public
    ErrCode: Integer;
    constructor CreateCode(Code: Integer);
  end;

  EAccessViolation = class(EExternal);
  EBusError = class(EAccessViolation);
  EPrivilege = class(EExternal);
  EStackOverflow = class(EExternal);
  EControlC = class(EExternal);
  EConvertError = class(Exception);
  EFormatError = class(Exception);
  EAbort = class(Exception);
  EAbstractError = class(Exception);
  EAssertionFailed = class(Exception);
  EObjectCheck = class(Exception);
  EThreadError = class(Exception);
  ESigQuit = class(Exception);
  EPropReadOnly = class(Exception);
  EPropWriteOnly = class(Exception);
  EIntfCastError = class(Exception);
  EInvalidContainer = class(Exception);
  EInvalidInsert = class(Exception);
  EPackageError = class(Exception);
  ECFError = class(Exception);

  EOSError = class(Exception)
  public
    ErrorCode: Integer;
  end;

  ESafecallException = class(Exception);
  ENoThreadSupport = class(Exception);
  ENoWideStringSupport = class(Exception);
  ENoDynLibsSupport = class(Exception);
  EProgrammerNotFound = class(Exception);
  EMonitor = class(Exception);
  EMonitorLockException = class(EMonitor);
  ENoMonitorSupportException = class(EMonitor);
  EObjectDisposed = class(Exception);
  ENotImplemented = class(Exception);
  EArgumentException = class(Exception);
  EArgumentOutOfRangeException = class(EArgumentException);
  EArgumentNilException = class(EArgumentException);
  EPathTooLongException = class(Exception);
  ENotSupportedException = class(Exception);
  EDirectoryNotFoundException = class(Exception);
  EFileNotFoundException = class(Exception);
  EPathNotFoundException = class(Exception);

  EInOutArgumentException = class(EArgumentException)
  public
    Path: string;
    constructor Create(const AMsg, APath: string);
  end;

  EInvalidOpException = class(Exception);
  ENoConstructException = class(Exception);
  EListError = class(Exception);
  EOperationCancelled = class(Exception);
  EEncodingError = class(EConvertError)
  public
    ByteIndex: Integer;
    constructor CreateAt(const Msg: string; Index: Integer);
  end;
  TEncodingErrorKind = (teNone, teRange, teInvalidUTF8, teInvalidUTF16, teNonASCII);
  TEncodingError = record
    Kind: TEncodingErrorKind;
    ByteIndex: Integer;
    function Message: string;
    procedure RaiseError;
  end;
  TEncodingKind = (encUTF8, encUTF16LE, encUTF16BE, encASCII);
  { Immutable value: no lazily allocated singleton, shared cache, Free
    or process-locale dependency. UTF-8 is also the zero value. }
  TEncoding = record
  strict private
    FKind: TEncodingKind;
    class function GetUTF8: TEncoding; static;
    class function GetUTF16LE: TEncoding; static;
    class function GetUTF16BE: TEncoding; static;
    class function GetASCII: TEncoding; static;
    function GetName: string;
    function GetCodePage: Integer;
  public
    function TryGetBytes(const Text: string; out Bytes: TBytes;
      out Error: TEncodingError): Boolean;
    function GetBytes(const Text: string): TBytes;
    function TryGetString(const Bytes: TBytes; Offset, Count: Integer;
      out Text: string; out Error: TEncodingError): Boolean;
    function TryGetString(const Bytes: TBytes; out Text: string;
      out Error: TEncodingError): Boolean;
    function GetString(const Bytes: TBytes): string;
    function GetString(const Bytes: TBytes; Offset, Count: Integer): string;
    function GetPreamble: TBytes;
    class function Convert(const Source, Destination: TEncoding;
      const Bytes: TBytes): TBytes; static;
    class property UTF8: TEncoding read GetUTF8;
    class property ANSI: TEncoding read GetUTF8;
    class property Unicode: TEncoding read GetUTF16LE;
    class property BigEndianUnicode: TEncoding read GetUTF16BE;
    class property ASCII: TEncoding read GetASCII;
    property EncodingName: string read GetName;
    property CodePage: Integer read GetCodePage;
  end;

  { One mutable owner, like current Go strings.Builder. A class avoids
    Go's copied-value hazard; ToString returns an independent snapshot.
    Byte indexes/lengths are explicit. Reserved language words Append,
    Insert, Clear and Length are not redeclared as library members. }
  TStringBuilder = class(TObject)
  strict private
    FData: TBytes;
    FByteLength: Integer;
    function GetCapacity: Integer;
  public
    constructor Create(ACapacity: Integer = 64);
    constructor Create(const Text: string);
    function EnsureCapacity(Minimum: Integer): Integer;
    function AddText(const Text: string): TStringBuilder;
    function AddChar(Value: Char): TStringBuilder;
    function AddRune(CodePoint: Integer): TStringBuilder;
    function AddInteger(Value: Integer): TStringBuilder;
    function AddReal(Value: Double; const Settings: TFormatSettings): TStringBuilder;
    function AddBoolean(Value: Boolean): TStringBuilder;
    function AddLine(const Text: string = ''): TStringBuilder;
    function AddFormat(const Template: string; const Args: array of const;
      const Settings: TFormatSettings): TStringBuilder;
    function InsertText(Index: Integer; const Text: string): TStringBuilder;
    function Remove(Index, Count: Integer): TStringBuilder;
    procedure Reset;
    function ToString: string; override;
    property ByteLength: Integer read FByteLength;
    property Capacity: Integer read GetCapacity;
  end;

  TStringArray = array of string;
  { Helpers are thin views of the same checked kernels, not a second
    string library. Indexes/counts are UTF-8 bytes, zero-based. }
  TStringHelper = type helper for string
  private
    function GetByteLength: Integer;
    function GetChar(Index: Integer): Char;
  public
    function IsEmpty: Boolean;
    function HasText(const Text: string): Boolean;
    function StartsWith(const Text: string): Boolean;
    function EndsWith(const Text: string): Boolean;
    function IndexOf(const Text: string; StartIndex: Integer = 0): Integer;
    function Substring(StartIndex: Integer): string;
    function Substring(StartIndex, Count: Integer): string;
    function InsertText(Index: Integer; const Text: string): string;
    function Remove(Index, Count: Integer): string;
    function Replace(const OldText, NewText: string;
      Flags: TReplaceFlags = [rfReplaceAll]): string;
    function SplitText(const Separator: string; MaxParts: Integer = -1): TStringArray;
    class function JoinText(const Separator: string; const Values: array of string): string; static;
    function ToLower: string;
    function ToUpper: string;
    function Trim: string;
    function ToInteger: Integer;
    function ToDouble(const Settings: TFormatSettings): Double;
    function ToBoolean: Boolean;
    property ByteLength: Integer read GetByteLength;
    property Chars[Index: Integer]: Char read GetChar;
  end;
  TIntegerHelper = type helper for Integer
    class function Parse(const Text: string): Integer; static;
    class function TryParse(const Text: string; out Value: Integer): Boolean; static;
    function ToString: string;
    function ToHexString(Digits: Integer = 1): string;
    function ToDouble: Double;
    function ToBoolean: Boolean;
  end;
  TDoubleHelper = type helper for Double
    class function Parse(const Text: string; const Settings: TFormatSettings): Double; static;
    class function TryParse(const Text: string; out Value: Double;
      const Settings: TFormatSettings): Boolean; static;
    function ToString(const Settings: TFormatSettings): string;
    function IsNotANumber: Boolean;
    function IsInfinity: Boolean;
    function IsFinite: Boolean;
  end;
  TBooleanHelper = type helper for Boolean
    class function Parse(const Text: string): Boolean; static;
    class function TryParse(const Text: string; out Value: Boolean): Boolean; static;
    function ToString(UseBoolStrs: Boolean = True): string;
    function ToInteger: Integer;
  end;
  TCurrencyHelper = type helper for Currency
    class function Parse(const Text: string; const Settings: TFormatSettings): Currency; static;
    class function TryParse(const Text: string; out Value: Currency;
      const Settings: TFormatSettings): Boolean; static;
    class function FromScaled(Value: Int64): Currency; static;
    function ToString(const Settings: TFormatSettings): string;
    function ToScaled: Int64;
    property ScaledValue: Int64 read ToScaled;
  end;
  { Char is a byte, not a Unicode scalar: these names explicitly say
    ASCII instead of pretending a byte can classify Unicode. }
  TCharHelper = type helper for Char
    function IsAsciiDigit: Boolean;
    function IsAsciiLetter: Boolean;
    function IsAsciiWhiteSpace: Boolean;
    function ToLower: Char;
    function ToUpper: Char;
    function ToString: string;
  end;

  { Pascal fields in memory; explicit RFC 9562 network order at the
    wire boundary, independent of the machine's endianness. }
  TGUID = record
    D1: UInt32;
    D2, D3: Word;
    D4: array[0..7] of Byte;
  end;
  TGuidHelper = record helper for TGUID
    class function Create(const Text: string): TGUID; static;
    class function Create(const Bytes: TBytes): TGUID; static;
    class function NewGuid: TGUID; static;
    class function NewTimeGuid: TGUID; static;
    function ToString(SkipBrackets: Boolean = False): string;
    function ToByteArray: TBytes;
    function IsEmpty: Boolean;
    function Version: Integer;
    function UnixMilliseconds: Integer;
  end;

  { An owned error value, like current Go io/fs.PathError, but with a
    stable numeric system code as well as operation/path context. }
  TSysError = record
    Code: Integer;
    Operation, Path: string;
    function Failed: Boolean;
    function Message: string;
    procedure RaiseError;
  end;

  TEnvironmentEntries = array of string;
  { Immutable, owned values: record copies may be shared by pasroutines.
    Updates return a new value, never change the process environment. }
  TEnvironment = record
  strict private
    FEntries: TEnvironmentEntries;
    FIndex: map[string] of Integer;
    function GetCount: Integer;
  public
    constructor Create(const Entries: array of string);
    class function Current: TEnvironment; static;
    function Lookup(const Name: string; out Value: string): Boolean;
    function Entry(Index: Integer): string;
    function ToArray: TEnvironmentEntries;
    function WithValue(const Name, Value: string): TEnvironment;
    function WithoutValue(const Name: string): TEnvironment;
    property Count: Integer read GetCount;
  end;

  TOSVersion = record
  public type
    TArchitecture = (arIntelX64, arARM64, arOther);
    TPlatform = (pfLinux);
  strict private
    class var FName, FRelease, FVersion, FMachine: string;
    class var FMajor, FMinor, FBuild: Integer;
    class var FArchitecture: TArchitecture;
    class constructor Create;
  public
    class function Check(AMajor: Integer): Boolean; static;
    class function Check(AMajor, AMinor: Integer): Boolean; static;
    class function Check(AMajor, AMinor, APatch: Integer): Boolean; static;
    class function ToString: string; static;
    class property Name: string read FName;
    class property Release: string read FRelease;
    class property Version: string read FVersion;
    class property Machine: string read FMachine;
    class property Major: Integer read FMajor;
    class property Minor: Integer read FMinor;
    class property Build: Integer read FBuild;
    class property Architecture: TArchitecture read FArchitecture;
  end;

  TProcessOptions = record
    DirectoryHandle: THandle;
    Directory: string;
    Environment: TEnvironment;
    InheritEnvironment: Boolean;
    { -2 inherits the corresponding standard descriptor, -1 closes it. }
    StandardHandles: array[0..2] of THandle;
    { Zero: unlimited. Positive: execution timeout after successful exec. }
    TimeoutMs: Integer;
    class function Defaults: TProcessOptions; static;
  end;
  TProcessResult = record
    ProcessId, ExitCode, Signal: Integer;
    Exited, TimedOut: Boolean;
    function Succeeded: Boolean;
  end;

  { Exact UTC seconds and nanoseconds; no floating-point date loss. }
  TFileTime = record
    Seconds, Nanoseconds: Int64;
  end;
  TFileInfo = record
    ValidFields, Mode, UserId, GroupId, Links: Integer;
    Size, Inode, DeviceMajor, DeviceMinor, MountId: Int64;
    Attributes, AttributeMask: Int64;
    Accessed, Created, Changed, Modified: TFileTime;
    function Has(Fields: Integer): Boolean;
    function IsDirectory: Boolean;
    function IsRegular: Boolean;
    function IsSymbolicLink: Boolean;
  end;

  { An owned cursor. Calls on one cursor are exclusive; different
    cursors are independent and may run in different pasroutines. }
  TDirectoryReader = class(TObject)
  private
    FHandle: THandle;
    FPath: string;
    FBuffer: array[0..8191] of Byte;
    FPosition, FCount: Integer;
    FEnded: Boolean;
    constructor Create(Handle: THandle; const Path: string);
  public
    destructor Destroy; override;
    function Next(out Name: string; out Error: TSysError): Boolean;
    function CloseDirectory(out Error: TSysError): Boolean;
    property Handle: THandle read FHandle;
  end;
  TSearchRec = record
    Time, Size: Int64;
    Attr, Mode: Integer;
    Name: string;
  private
    FReader: TDirectoryReader;
    FPattern: string;
    FAllowed: Integer;
  public
    function IsDirectory: Boolean;
    function IsCurrentOrParentDir: Boolean;
  end;

const
  { Linux names are UTF-8 byte sequences; only '/' separates components. }
  ExtensionSeparator = '.';
  fmOpenRead = 0;
  fmOpenWrite = 1;
  fmOpenReadWrite = 2;
  fsFromBeginning = 0;
  fsFromCurrent = 1;
  fsFromEnd = 2;
  feInvalidHandle = -1;
  CurrentDirectoryHandle = -100;
  fiType = 1;
  fiMode = 2;
  fiLinks = 4;
  fiUser = 8;
  fiGroup = 16;
  fiAccessed = 32;
  fiModified = 64;
  fiChanged = 128;
  fiInode = 256;
  fiSize = 512;
  fiCreated = 2048;
  fiMount = 4096;
  faReadOnly = 1;
  faHidden = 2;
  faSysFile = 4;
  faDirectory = 16;
  faArchive = 32;
  faSymLink = 1024;
  faAnyFile = 511;

  { ---- the messages, Free Pascal's texts (sysconst.pp) ---- }
  SAbortError = 'Operation aborted';
  SAccessViolation = 'Access violation';
  SDivByZero = 'Division by zero';
  SIntOverflow = 'Arithmetic overflow';
  SInvalidBoolean = '"%s" is not a valid boolean.';
  SInvalidCast = 'Invalid type cast';
  SInvalidFloat = '"%s" is an invalid float';
  SInvalidInteger = '"%s" is an invalid integer';
  SOutOfMemory = 'Out of memory';
  SRangeError = 'Range check error';
  SUnknownErrorCode = 'Unknown error code: %d';
  SNoError = 'No error.';
  SVarParamNotFound = 'Variant Parameter not found';
  SInvalidVarCast = 'Invalid variant type cast';
  SVarBadType = 'Invalid variant type';
  SVarOverflow = 'Variant overflow';
  SVarArrayBounds = 'Variant array bounds error';
  SVarArrayLocked = 'Variant array locked';
  SVarNotImplemented = 'Operation not supported';
  SVarOutOfMemory = 'Variant operation ran out memory';
  SVarInvalid = 'Invalid argument';
  SVarUnexpected = 'Unexpected variant error';
  SInvalidDateTime = '"%s" is not a valid date/time value.';
  SInvalidDateTimeFloat = '%f is not a valid date/time value.';
  SErrInvalidTimeFormat = '"%s" is not a valid time';
  SErrInvalidDate = '%d-%d-%d is not a valid date specification';
  SerrInvalidHourMinuteSecMsec = '%d:%d:%d.%d is not a valid time specification';
  EmptyStr = '';
  LineEnding = #10;
  sLineBreak = #10;
  PathDelim = '/';
  DirectorySeparator = '/';
  DriveDelim = '';
  PathSep = ':';
  MaxPathLen = 4096;
  AllowDirectorySeparators: TSysCharSet = ['/'];
  AllowDriveSeparators: TSysCharSet = [];
  { ---- dates and times (P131), Free Pascal's (datih.inc) ---- }
  HoursPerDay = 24;
  MinsPerHour = 60;
  SecsPerMin = 60;
  MSecsPerSec = 1000;
  MinsPerDay = HoursPerDay * MinsPerHour;
  SecsPerHour = SecsPerMin * MinsPerHour;
  SecsPerDay = MinsPerDay * SecsPerMin;
  MSecsPerDay = SecsPerDay * MSecsPerSec;
  JulianEpoch = TDateTime(-2415018.5);
  UnixEpoch = JulianEpoch + TDateTime(2440587.5);
  DateDelta = 693594;
  UnixDateDelta = Trunc(UnixEpoch);
  MonthDays: array[Boolean] of TDayTable =
    ((31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31),
     (31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31));
  MinDateTime: TDateTime = -693593.99999999;
  MaxDateTime: TDateTime = 2958465.99999999;
  MinCurrency: Currency = -922337203685477.5808;
  MaxCurrency: Currency = 922337203685477.5807;

var
  TrueBoolStrs: array of string;
  FalseBoolStrs: array of string;
  { Free Pascal's settings (sysinth.inc), the ones of a program that
    reads no locale; FormatSettings is the same record }
  DefaultFormatSettings: TFormatSettings = (
    CurrencyFormat: 1;
    NegCurrFormat: 5;
    ThousandSeparator: ',';
    DecimalSeparator: '.';
    CurrencyDecimals: 2;
    DateSeparator: '-';
    TimeSeparator: ':';
    ListSeparator: ',';
    CurrencyString: '$';
    ShortDateFormat: 'd/m/y';
    LongDateFormat: 'dd" "mmmm" "yyyy';
    TimeAMString: 'AM';
    TimePMString: 'PM';
    ShortTimeFormat: 'hh:nn';
    LongTimeFormat: 'hh:nn:ss';
    ShortMonthNames: ('Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec');
    LongMonthNames: ('January', 'February', 'March', 'April', 'May', 'June', 'July', 'August',
      'September', 'October', 'November', 'December');
    ShortDayNames: ('Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat');
    LongDayNames: ('Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday');
    TwoDigitYearCenturyWindow: 50);
  FormatSettings: TFormatSettings absolute DefaultFormatSettings;
  { each setting under its own name too, Free Pascal's (sysinth.inc,
    which calls them deprecated): another name for the field, P162 }
  DateSeparator: Char absolute DefaultFormatSettings.DateSeparator;
  ShortDateFormat: string absolute DefaultFormatSettings.ShortDateFormat;
  LongDateFormat: string absolute DefaultFormatSettings.LongDateFormat;
  ShortMonthNames: TMonthNameArray absolute DefaultFormatSettings.ShortMonthNames;
  LongMonthNames: TMonthNameArray absolute DefaultFormatSettings.LongMonthNames;
  ShortDayNames: TWeekNameArray absolute DefaultFormatSettings.ShortDayNames;
  LongDayNames: TWeekNameArray absolute DefaultFormatSettings.LongDayNames;
  ShortTimeFormat: string absolute DefaultFormatSettings.ShortTimeFormat;
  LongTimeFormat: string absolute DefaultFormatSettings.LongTimeFormat;
  TimeSeparator: Char absolute DefaultFormatSettings.TimeSeparator;
  TimeAMString: string absolute DefaultFormatSettings.TimeAMString;
  TimePMString: string absolute DefaultFormatSettings.TimePMString;
  DecimalSeparator: Char absolute DefaultFormatSettings.DecimalSeparator;
  ThousandSeparator: Char absolute DefaultFormatSettings.ThousandSeparator;
  CurrencyDecimals: Byte absolute DefaultFormatSettings.CurrencyDecimals;
  CurrencyFormat: Byte absolute DefaultFormatSettings.CurrencyFormat;
  NegCurrFormat: Byte absolute DefaultFormatSettings.NegCurrFormat;
  CurrencyString: string absolute DefaultFormatSettings.CurrencyString;
  ListSeparator: Char absolute DefaultFormatSettings.ListSeparator;
  TwoDigitYearCenturyWindow: Word absolute DefaultFormatSettings.TwoDigitYearCenturyWindow;

{ ---- exceptions ---- }
function ExceptObject: TObject;
function ExceptAddr: Pointer;
procedure Abort;
procedure OutOfMemoryError;

{ Positive errno codes, zero for success. Compatibility last-error
  storage belongs to the G, never to its current OS thread. }
function GetLastOSError: Integer;
procedure SetLastOSError(Code: Integer);
function SysErrorMessage(ErrorCode: Integer): string;
procedure RaiseLastOSError;
procedure RaiseLastOSError(ErrorCode: Integer);

{ ---- files: bounded buffers and explicit errors (P130) ---- }
{ Owned descriptors: no active operation may race a close. Ordinary
  reads/writes share a file position; positional forms do not. }
function TryOpenFileAt(DirectoryHandle: THandle; const Path: string;
  Flags, Rights: Integer; out Handle: THandle; out Error: TSysError): Boolean;
function FileOpen(const FileName: string; Mode: Integer): THandle;
function FileCreate(const FileName: string): THandle;
function FileCreate(const FileName: string; Rights: Integer): THandle;
function TryFileClose(Handle: THandle; out Error: TSysError): Boolean;
procedure FileClose(Handle: THandle);
function TryFileRead(Handle: THandle; var Buffer: TBytes; Offset, Count: Integer;
  out Transferred: Integer; out Error: TSysError): Boolean;
function TryFileWrite(Handle: THandle; const Buffer: TBytes; Offset, Count: Integer;
  out Transferred: Integer; out Error: TSysError): Boolean;
function FileRead(Handle: THandle; var Buffer: TBytes; Count: Integer): Integer;
function FileWrite(Handle: THandle; const Buffer: TBytes; Count: Integer): Integer;
function TryFileReadAt(Handle: THandle; var Buffer: TBytes; Offset, Count,
