{ Free Pascal's FloatToDecimal: at most Precision significant digits (18
  at most, what TFloatRec holds) and Decimals places after the point,
  correctly rounded, followed by #0; Exponent the place of the point
  (32767 an infinity, -32768 a NaN); a value that rounds to 0 has no
  digit, exponent 0 and no sign. }
procedure FloatToDecimal(out Result: TFloatRec; Value: Double; Precision, Decimals: Integer);
var
  neg: Boolean;
  m, e: Int64;
  kind, dp, i: Integer;
  d, s: string;
begin
  Result := Default(TFloatRec);
  SplitReal(Value, False, neg, m, e, kind);
  if kind = 2 then
  begin
    Result.Exponent := 32767;
    Result.Negative := neg;
    Exit;
  end;
  if kind = 3 then
  begin
    Result.Exponent := -32768;
    Exit;
  end;
  if Precision > 18 then
    Precision := 18;
  d := '';
  dp := 0;
  if kind = 0 then
  begin
    FracDigits(Value, Decimals, d, dp);
    if Length(d) > Precision then
    begin
      SigDigits(Value, Precision, s, i);
      d := s;
      dp := i;
    end;
  end;
  if d = '' then
    Exit;
  Result.Negative := neg;
  Result.Exponent := dp;
  for i := 1 to Length(d) do
    Result.Digits[i - 1] := d[i];
end;

{ Free Pascal's FormatFloat (fmtflt.inc's IntFloatToTextFmt): up to
  three sections, for a positive value, a negative one and zero; 0 a
  digit always written, # one written when there is one, . the point, ,
  the thousands, E+ and E- an exponent, quotes literal text. Its digits
  are Go's, exact however many are asked, where Free Pascal stopped at
  18 and wrote a larger number in its general form. An empty section
  for a negative value or zero takes the first. }
function FloatFmtText(const Fmt: string; const A: TRealArg; const AFormatSettings: TFormatSettings): string;
var
  section, digs: string;
  neg, thousandSep, isSci, inLit: Boolean;
  decimalPos, firstDigit, lastDigit, requested, expSize, available, current, padZeroes,
    distToDecimal, s, i, n, fl, kind, dp: Integer;
  starts: array[0..4] of Integer;
  q, c: Char;

  procedure WriteDigit(ADigit: Char);
  begin
    if ADigit = #0 then
      Exit;
    distToDecimal := distToDecimal - 1;
    if distToDecimal = -1 then
      Result := Result + AFormatSettings.DecimalSeparator + ADigit
    else
    begin
      Result := Result + ADigit;
      if thousandSep and ((distToDecimal mod 3) = 0) and (distToDecimal > 1) then
        Result := Result + AFormatSettings.ThousandSeparator;
    end;
  end;

  function GetDigit: Char;
  begin
    Result := #0;
    if current <= available then
    begin
      Result := digs[current + 1];
      current := current + 1;
    end
    else if distToDecimal <= lastDigit then
      distToDecimal := distToDecimal - 1
    else
      Result := '0';
  end;

  procedure CopyDigit;
  begin
    if padZeroes = 0 then
      WriteDigit(GetDigit)
    else if padZeroes < 0 then
    begin
      padZeroes := padZeroes + 1;
      if distToDecimal <= firstDigit then
        WriteDigit('0')
      else
        distToDecimal := distToDecimal - 1;
    end
    else
    begin
      while padZeroes > 0 do
      begin
        WriteDigit(GetDigit);
        padZeroes := padZeroes - 1;
      end;
      WriteDigit(GetDigit);
    end;
  end;

  function ExponentText(ASign: Char; AExp: Integer): string;
  begin
    if digs = '' then
      AExp := 0;
    Result := IntToStr(Abs(AExp));
    if Length(Result) < expSize then
      Result := StringOfChar('0', expSize - Length(Result)) + Result;
    if AExp < 0 then
      Result := '-' + Result
    else if ASign = '+' then
      Result := '+' + Result;
  end;

begin
  Result := '';
  ArgKind(A, neg, kind);
  if kind >= 2 then
  begin
    Result := SpecialText(kind, neg);
    Exit;
  end;
  { the sections, ; outside quotes }
  fl := Length(Fmt);
  starts[0] := 1;
  n := 1;
  inLit := False;
  q := #0;
  for i := 1 to fl do
  begin
    c := Fmt[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if (c = ';') and not inLit then
    begin
      if n > 3 then
        raise EConvertError.Create('Invalid float format');
      starts[n] := i + 1;
      n := n + 1;
    end;
  end;
  starts[n] := fl + 2;
  if kind = 1 then
    s := 3
  else if neg then
    s := 2
  else
    s := 1;
  if (s > n) or (starts[s] - starts[s - 1] - 1 = 0) then
    s := 1;
  section := Copy(Fmt, starts[s - 1], starts[s] - starts[s - 1] - 1);
  if section = '' then
  begin
    Result := RealText(A, ffGeneral, 0, 0, AFormatSettings);
    Exit;
  end;
  { what the section asks (AnalyzeFormat) }
  thousandSep := False;
  isSci := False;
  decimalPos := 0;
  firstDigit := High(Int64);
  lastDigit := 0;
  requested := 0;
  expSize := 0;
  inLit := False;
  q := #0;
  i := 1;
  while i <= Length(section) do
  begin
    c := section[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if not inLit then
      case c of
        '.':
          if decimalPos = 0 then
            decimalPos := requested + 1;
        ',':
          thousandSep := AFormatSettings.ThousandSeparator <> #0;
        'e', 'E':
          begin
            i := i + 1;
            if i < Length(section) then
            begin
              c := section[i];
              isSci := (c = '-') or (c = '+');
              if isSci then
                while (i < Length(section)) and (section[i + 1] = '0') do
                begin
                  expSize := expSize + 1;
                  i := i + 1;
                end;
              if expSize > 4 then
                expSize := 4;
            end;
          end;
        '#':
          requested := requested + 1;
        '0':
          begin
            if requested < firstDigit then
              firstDigit := requested + 1;
            requested := requested + 1;
            lastDigit := requested + 1;
          end;
      end;
    i := i + 1;
  end;
  if decimalPos = 0 then
    decimalPos := requested + 1;
  lastDigit := decimalPos - lastDigit;
  if lastDigit > 0 then
    lastDigit := 0;
  firstDigit := decimalPos - firstDigit;
  if firstDigit < 0 then
    firstDigit := 0;
  { the digits (CalcRunVars), correctly rounded }
  digs := '';
  dp := 0;
  if kind = 0 then
  begin
    if isSci then
    begin
      if requested > 0 then
        ArgSig(A, requested, digs, dp);
    end
    else
      ArgFrac(A, requested - decimalPos + 1, digs, dp);
  end;
  if digs = '' then
  begin
    neg := False;
    dp := 0;
  end;
  distToDecimal := decimalPos - 1;
  if isSci then
    padZeroes := 0
  else
  begin
    padZeroes := dp - (decimalPos - 1);
    if padZeroes >= 0 then
      distToDecimal := dp;
  end;
  available := Length(digs) - 1;
  current := 0;
  { the section written }
  if neg and (s = 1) then
    Result := '-';
  inLit := False;
  q := ' ';
  i := 1;
  while i <= Length(section) do
  begin
    c := section[i];
    if (c = '"') or (c = '''') then
    begin
      if inLit then
        inLit := c <> q
      else
      begin
        inLit := True;
        q := c;
      end;
    end
    else if inLit then
      Result := Result + c
    else
      case c of
        '0', '#':
          CopyDigit;
        '.', ',':
          ;
        'e', 'E':
          begin
            Result := Result + c;
            if isSci then
            begin
              i := i + 1;
              if i <= Length(section) then
              begin
                c := section[i];
                if (c = '+') or (c = '-') then
                begin
                  Result := Result + ExponentText(c, dp - decimalPos + 1);
                  while (i < Length(section)) and (section[i + 1] = '0') do
                    i := i + 1;
                end;
              end;
            end
            else if i < Length(section) then
            begin
              i := i + 1;
              Result := Result + section[i];
            end;
          end;
      else
        Result := Result + c;
      end;
    i := i + 1;
  end;
end;

function FormatFloat(const Fmt: string; Value: Double; const AFormatSettings: TFormatSettings): string;
var
  a: TRealArg;
begin
  ArgDouble(a, Value);
  Result := FloatFmtText(Fmt, a, AFormatSettings);
end;

