{$mode objfpc}{$H+}

{ The debugger inside the executable (P118, 1.1.1). A program compiled
  with -debug calls PasDebugLine at every statement with its line, its
  routine and its frame, and PasDebugStart before its body. When the
  environment names a socket (PASLANG_DEBUG=path, @name for an abstract
  one) the program listens there and answers a text protocol, one line
  a request and a reply of lines ending in "ok" or "error: ...": the
  routines and where each is, a routine's frames, the variables of a
  frame with their values by type, the globals, the functions, breaks at
  a line or a routine, step, next, continue, stop, run again with a
  command line, quit. A routine that hits a break parks on a channel of
  its own until the client lets it go; the others run on. Without the
  variable the hooks cost a call each and nothing listens. The tables
  the compiler writes into the section pasdbg say the routines, their
  lines and their variables; the runtime gives the list of routines.

  The console (P120, 1.1.1): the program's first argument may ask for
  it. --debug-mode runs the program with a console on its terminal,
  stopped before its first statement; --debug-listen SOCKET serves the
  socket and waits, stopped there, for a client; --debug-attach SOCKET
  makes the executable a console for the program that listens there.
  The words are taken out of the command line the program sees. The
  console speaks the protocol like any client: gdb's short words, the
  routine it stopped in as the one the commands act on, the source
  around a stop, one variable, an empty line that repeats a step, and
  Ctrl-C that stops every routine. pasdbg is the same console. }
unit pasdebug;

interface

procedure PasDebugStart(HeapState, Tables, TablesEnd: Pointer);
procedure PasDebugLine(Line: Integer; Fn, Frame: Pointer);

{ A console on this terminal for the program that listens at Sock: it
  connects (waiting up to five seconds for the program to listen) and
  reads commands until quit or the end of the input. Owned says the
  program is this process: quit ends it. }
procedure PasDebugConsole(const Sock: string; Owned: Boolean);

implementation

uses
  pasnet, paslib;

type
  PInt = ^Integer;

  TLocal = record
    Name: string;
    Off: Integer;
    Code: Integer;
    Size: Integer;
    Box: Integer;     { its offset inside the heap box a closure holds it in, -1 in the frame }
  end;
  TFn = record
    Start, Stop: Integer;
    Name, Src: string;
    Line: Integer;
    Locals: array of TLocal;
  end;
  TGlobal = record
    Name: string;
    Addr, Code, Size: Integer;
  end;
  TLinePc = record
    Pc, Line: Integer;
  end;
  TBreak = record
    Num: Integer;
    Src: string;
    Line: Integer;    { 0 for a break at a routine }
    Fn: Integer;      { the routine's start, 0 for a break at a line }
    Text: string;
  end;
  PGState = ^TGState;
  TGState = record
    Id: Integer;
    Line: Integer;
    Fn: Integer;
    Frame: Integer;      { distance from GRec's stack high, never an absolute address }
    GRec: Pointer;       { the runtime G record never moves }
    Stopped: Boolean;
    Freeze: Boolean;
    Step: Integer;       { 0 none, 1 a line, 2 a line in this frame or an outer one }
    StepFrame: Integer;  { the same stack-relative distance }
    Resume: chan of Integer;
  end;

var
  HeapAddr: Integer;
  Fns: array of TFn;
  Globals: array of TGlobal;
  Lines: array of TLinePc;
  Breaks: array of TBreak;
  BreakNum: Integer;
  States: map[Integer] of PGState;
  Guard: Mutex;
  Armed: Boolean;
  PauseAll: Boolean;
  Stops: chan of Integer;
  SockPath: string;
  Mode: Integer;          { 0 PASLANG_DEBUG's socket, 1 --debug-mode, 2 --debug-listen }
  Interrupted: Boolean;   { Ctrl-C in a console: set by the handler CatchInterrupt installs }

{ ---- the tables ---- }

function StrAt(P, N: Integer): string;
begin
  Result := '';
  if (P = 0) or (N <= 0) then
    Exit;
  SetLength(Result, N);
  Move(PByte(P)^, Result[1], N);
end;

procedure ReadTables(Tables, TablesEnd: Pointer);
var
  p, e, k, n, i, q: Integer;
  fn: TFn;
begin
  p := Integer(Tables);
  e := Integer(TablesEnd);
  while p + 96 <= e do
  begin
    k := PInt(p)^;
    if k = 1 then
    begin
      fn.Start := PInt(p + 8)^;
      fn.Stop := PInt(p + 16)^;
      fn.Name := StrAt(PInt(p + 24)^, PInt(p + 32)^);
      fn.Src := StrAt(PInt(p + 40)^, PInt(p + 48)^);
      fn.Line := PInt(p + 56)^;
      n := PInt(p + 64)^;
      q := PInt(p + 72)^;
      fn.Locals := nil;
      SetLength(fn.Locals, n);
      for i := 0 to n - 1 do
      begin
        fn.Locals[i].Name := StrAt(PInt(q)^, PInt(q + 8)^);
        fn.Locals[i].Off := PInt(q + 16)^;
        fn.Locals[i].Code := PInt(q + 24)^;
        fn.Locals[i].Size := PInt(q + 32)^;
        fn.Locals[i].Box := PInt(q + 40)^;
        q := q + 48;
      end;
      SetLength(Fns, Length(Fns) + 1);
      Fns[High(Fns)] := fn;
    end
    else if k = 2 then
    begin
      SetLength(Globals, Length(Globals) + 1);
      Globals[High(Globals)].Addr := PInt(p + 8)^;
      Globals[High(Globals)].Name := StrAt(PInt(p + 16)^, PInt(p + 24)^);
      Globals[High(Globals)].Code := PInt(p + 32)^;
      Globals[High(Globals)].Size := PInt(p + 40)^;
    end
    else if k = 3 then
    begin
      n := PInt(p + 8)^;
      q := PInt(p + 16)^;
      for i := 0 to n - 1 do
      begin
        SetLength(Lines, Length(Lines) + 1);
        Lines[High(Lines)].Pc := PInt(q)^;
        Lines[High(Lines)].Line := PInt(q + 8)^;
        q := q + 16;
      end;
    end;
    p := p + 96;
  end;
end;

function FnOf(Pc: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(Fns) do
    if (Pc >= Fns[i].Start) and (Pc < Fns[i].Stop) then
    begin
      Result := i;
      Exit;
    end;
end;

function FnByStart(Start: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(Fns) do
    if Fns[i].Start = Start then
    begin
      Result := i;
      Exit;
    end;
end;

function FnByName(const N: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(Fns) do
    if ToLower(Fns[i].Name) = ToLower(N) then
    begin
      Result := i;
      Exit;
    end;
end;

{ The line of a return address: the greatest line entry not above it
  inside the routine that holds it. }
function LineOfPc(Pc: Integer): Integer;
var
  i, f, best: Integer;
begin
  Result := 0;
  f := FnOf(Pc);
  if f < 0 then
    Exit;
  best := 0;
  for i := 0 to High(Lines) do
    if (Lines[i].Pc <= Pc) and (Lines[i].Pc >= Fns[f].Start) and (Lines[i].Pc >= best) then
    begin
      best := Lines[i].Pc;
      Result := Lines[i].Line;
    end;
end;

{ ---- values ---- }

function HexOf(V: Integer): string;
const
  Digits = '0123456789abcdef';
var
  i: Integer;
begin
  Result := '';
  if V = 0 then
  begin
    Result := '$0';
    Exit;
  end;
  for i := 1 to 16 do
  begin
    Result := Digits[(V and 15) + 1] + Result;
    V := V shr 4;
    if V = 0 then
      Break;
  end;
  Result := '$' + Result;
end;

function RealText(R: Real): string;
var
  neg: Boolean;
  ip, fp: Integer;
begin
  neg := R < 0;
  if neg then
    R := -R;
  ip := Trunc(R);
  fp := Trunc((R - ip) * 1000000 + 0.5);
  if fp >= 1000000 then
  begin
    ip := ip + 1;
    fp := fp - 1000000;
  end;
  Result := IntToStr(ip) + '.' + Copy(IntToStr(fp + 1000000), 2, 6);
  if neg then
    Result := '-' + Result;
end;

function Quoted(const S: string): string;
var
  i: Integer;
  c: Char;
  open: Boolean;
begin
  Result := '';
  open := False;
  for i := 1 to Length(S) do
  begin
    c := S[i];
    if (c >= ' ') and (c <= '~') then
    begin
      if not open then
      begin
        Result := Result + '''';
        open := True;
      end;
      if c = '''' then
        Result := Result + ''''''
      else
        Result := Result + c;
    end
    else
    begin
      if open then
      begin
        Result := Result + '''';
        open := False;
      end;
      Result := Result + '#' + IntToStr(Ord(c));
    end;
  end;
  if open or (S = '') then
    Result := Result + '''';
  if S = '' then
    Result := '''''';
end;

{ The value at address A of the code and size the table gives. }
function ValueText(A, Code, Size: Integer): string;
var
  v, n: Integer;
  s: string;
begin
  case Code of
    1:
      begin
        if Size = 1 then
          v := PInt8(A)^
        else if Size = 2 then
          v := PInt16(A)^
        else if Size = 4 then
          v := PInt32(A)^
        else
          v := PInt(A)^;
        Result := IntToStr(v);
      end;
    2:
      begin
        if Size = 1 then
          v := PByte(A)^
        else if Size = 2 then
          v := PWord(A)^
        else if Size = 4 then
          v := PUInt32(A)^
        else
          v := PInt(A)^;
        Result := IntToStr(v);
      end;
    3:
      if PByte(A)^ <> 0 then
        Result := 'True'
      else
        Result := 'False';
    4:
      begin
        v := PByte(A)^;
        if (v >= 32) and (v <= 126) then
          Result := '''' + Chr(v) + ''''
        else
          Result := '#' + IntToStr(v);
      end;
    5:
      begin
        n := PInt(A + 8)^;
        if (n < 0) or (n > 1048576) or (PInt(A)^ = 0) then
          Result := ''''''
        else
        begin
          if n > 200 then
            s := StrAt(PInt(A)^, 200)
          else
            s := StrAt(PInt(A)^, n);
          Result := Quoted(s);
          if n > 200 then
            Result := Result + ' (' + IntToStr(n) + ' bytes)';
        end;
      end;
    6:
      Result := RealText(PDouble(A)^);
    7:
      Result := RealText(PSingle(A)^);
    8:
      begin
        v := PInt(A)^;
        if v = 0 then
          Result := 'nil'
        else
          Result := HexOf(v);
      end;
    9:
      Result := IntToStr(PInt(A)^);
    11:
      Result := PasFmtCurrency(PInt(A)^, 0, -1);
  else
    Result := '<' + IntToStr(Size) + ' bytes>';
  end;
end;

{ ---- the states of the routines ---- }

{ Current Go runtime/stubs.go getg: use the dedicated G register, not
  a traversal of allgs (whose array can grow concurrently). Intel SDM
  MOV and ARM ARM MOV(register)/ORR were read: only Result changes. }
function CurrentRoutine: Pointer;
begin
  asm amd64 (Result: out rax)
    movq %r14, %rax
  end;
  asm arm64 (Result: out x0)
    mov x0, x28
  end;
end;

function StateOf(G: Integer): PGState;
var
  st: PGState;
begin
  if not TryGet(States, G, st) then
  begin
    New(st);
    st^.Id := G;
    st^.Line := 0;
    st^.Fn := 0;
    st^.Frame := 0;
    st^.GRec := nil;
    st^.Stopped := False;
    st^.Freeze := False;
    st^.Step := 0;
    st^.StepFrame := 0;
    st^.Resume := MakeChan(1);
    States[G] := st;
  end;
  Result := st;
end;

function BreakAt(Line: Integer; Fn: Integer): Boolean;
var
  i, f: Integer;
begin
  Result := False;
  f := FnByStart(Fn);
  for i := 0 to High(Breaks) do
  begin
    if (Breaks[i].Line > 0) and (Breaks[i].Line = Line) and
      ((Breaks[i].Src = '') or (f < 0) or (BaseName(Fns[f].Src) = Breaks[i].Src)) then
    begin
      Result := True;
      Exit;
    end;
    if (Breaks[i].Line = 0) and (Breaks[i].Fn = Fn) and (f >= 0) and (Fns[f].Line = Line) then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

procedure PasDebugLine(Line: Integer; Fn, Frame: Pointer);
var
  g: Integer;
  st: PGState;
  stop: Boolean;
begin
  if not Armed then
    Exit;
  g := Goid;
  Guard.Lock;
  st := StateOf(g);
  st^.Line := Line;
  st^.Fn := Integer(Fn);
  st^.GRec := CurrentRoutine;
  { Go stack.go copystack preserves each frame's distance from stack.hi.
    Frame is a typed stack root and moves if any preceding call grows
    this G. No call separates the high load from the subtraction. }
  st^.Frame := PInt(Integer(st^.GRec) + 8)^ - Integer(Frame);
  stop := False;
  if st^.Step = 1 then
    stop := True
  else if (st^.Step = 2) and (st^.Frame <= st^.StepFrame) then
    stop := True
  else if PauseAll or st^.Freeze then
    stop := True
  else if Length(Breaks) > 0 then
    stop := BreakAt(Line, Integer(Fn));
  if stop then
  begin
    st^.Stopped := True;
    st^.Step := 0;
    st^.Freeze := False;
  end;
  Guard.Unlock;
  if stop then
  begin
    Send(Stops, g);
    g := Recv(st^.Resume);
  end;
end;

{ ---- the server ---- }

function Word1(const S: string; var I: Integer): string;
var
  j: Integer;
begin
  while (I <= Length(S)) and (S[I] = ' ') do
    I := I + 1;
  j := I;
  while (j <= Length(S)) and (S[j] <> ' ') do
    j := j + 1;
  Result := Copy(S, I, j - I);
  I := j;
end;

function IntArg(const S: string; Def: Integer): Integer;
var
  v: Int64;
begin
  if StrToInt64(S, v) then
    Result := v
  else
    Result := Def;
end;

{ g7 or 7 }
function GArg(const S: string): Integer;
begin
  if (Length(S) > 1) and (S[1] = 'g') then
    Result := IntArg(Copy(S, 2, Length(S) - 1), -1)
  else
    Result := IntArg(S, -1);
end;

function StatusWord(St: Integer): string;
begin
  case St of
    0: Result := 'running';
    1: Result := 'parked';
    2: Result := 'waiting';
    3: Result := 'ready';
    4: Result := 'dead';
  else
    Result := 'status' + IntToStr(St);
  end;
end;

function WhereText(St: PGState): string;
var
  f: Integer;
begin
  f := FnByStart(St^.Fn);
  if f >= 0 then
    Result := Fns[f].Name + ' ' + BaseName(Fns[f].Src) + ':' + IntToStr(St^.Line)
  else
    Result := '? :' + IntToStr(St^.Line);
end;

procedure Reply(C: Integer; const S: string);
begin
  TcpWrite(C, S + #10);
end;

{ A break from its text: a line, file:line or a routine. Msg is the
  reply, "break <n> at <text>" or the error. }
function AddBreak(const A: string; out Msg: string): Boolean;
var
  k, n, f: Integer;
begin
  Result := False;
  if A = '' then
  begin
    Msg := 'error: break line | break file:line | break routine';
    Exit;
  end;
  k := 0;
  for n := 1 to Length(A) do
    if A[n] = ':' then
      k := n;
  f := -1;
  if (k = 0) and (IntArg(A, 0) <= 0) then
  begin
    f := FnByName(A);
    if f < 0 then
    begin
      Msg := 'error: no routine ' + A;
      Exit;
    end;
  end;
  Guard.Lock;
  BreakNum := BreakNum + 1;
  SetLength(Breaks, Length(Breaks) + 1);
  Breaks[High(Breaks)].Num := BreakNum;
  Breaks[High(Breaks)].Src := '';
  Breaks[High(Breaks)].Line := 0;
  Breaks[High(Breaks)].Fn := 0;
  Breaks[High(Breaks)].Text := A;
  if k > 0 then
  begin
    Breaks[High(Breaks)].Src := Copy(A, 1, k - 1);
    Breaks[High(Breaks)].Line := IntArg(Copy(A, k + 1, Length(A) - k), 0);
  end
  else if f >= 0 then
    Breaks[High(Breaks)].Fn := Fns[f].Start
  else
    Breaks[High(Breaks)].Line := IntArg(A, 0);
  Guard.Unlock;
  Msg := 'break ' + IntToStr(BreakNum) + ' at ' + A;
  Result := True;
end;

{ list file:first [count]: Count lines of a source of the program from
  First, each "<n><tab><text>". The file is read where the program
  runs, by its name in the tables or its base name. }
procedure ListSource(C: Integer; const Spec: string; Count: Integer);
var
  k, i, n, first: Integer;
  name, path, text: string;
begin
  k := 0;
  for i := 1 to Length(Spec) do
    if Spec[i] = ':' then
      k := i;
  if k = 0 then
  begin
    Reply(C, 'error: list file:line [count]');
    Exit;
  end;
  name := Copy(Spec, 1, k - 1);
  first := IntArg(Copy(Spec, k + 1, Length(Spec) - k), 1);
  if first < 1 then
    first := 1;
  path := '';
  for i := 0 to High(Fns) do
    if (Fns[i].Src = name) or (BaseName(Fns[i].Src) = name) then
    begin
      path := Fns[i].Src;
      Break;
    end;
  if path = '' then
  begin
    Reply(C, 'error: no source ' + name);
    Exit;
  end;
  if not ReadFile(path, text) then
  begin
    Reply(C, 'error: cannot read ' + path);
    Exit;
  end;
  n := 1;
  i := 1;
  while (i <= Length(text)) and (n < first + Count) do
  begin
    k := i;
    while (k <= Length(text)) and (text[k] <> #10) do
      k := k + 1;
    if n >= first then
      Reply(C, IntToStr(n) + #9 + Copy(text, i, k - i));
    n := n + 1;
    i := k + 1;
  end;
  Reply(C, 'ok');
end;

{ The frames of a stopped routine: its own, then up the chain of frame
  pointers while the return address is in a routine the tables know.
  Want -1 lists them; Want n gives frame n's pointer and routine. }
procedure Frames(C: Integer; St: PGState; Want: Integer; out OutBp, OutFn: Integer);
var
  bp, ret, f, depth: Integer;
begin
  { Stopped is published before Unlock/Send/Recv finish. Wait for the
    runtime's release-published waiting state before resolving an address.
    The Guard held by the server prevents resume; after notification the
    G executes only leaf channel runtime code until Recv parks, so even a
    full Stops buffer cannot introduce another stack-growth safe point.
    Like Go preempt.go suspendG, never inspect a running/moving stack. }
  while AtomicLoad(PInt32(Integer(St^.GRec) + 152)^) <> 2 do
    Sleep(1);
  OutBp := PInt(Integer(St^.GRec) + 8)^ - St^.Frame;
  OutFn := FnByStart(St^.Fn);
  bp := OutBp;
  f := OutFn;
  depth := 0;
  if (Want < 0) and (f >= 0) then
    Reply(C, '0 ' + Fns[f].Name + ' ' + BaseName(Fns[f].Src) + ':' + IntToStr(St^.Line));
  if Want = 0 then
    Exit;
  while (bp <> 0) and (depth < 64) do
  begin
    ret := PInt(bp + 8)^;
    bp := PInt(bp)^;
    f := FnOf(ret);
    if f < 0 then
      Break;
    depth := depth + 1;
    if Want < 0 then
      Reply(C, IntToStr(depth) + ' ' + Fns[f].Name + ' ' + BaseName(Fns[f].Src) + ':' + IntToStr(LineOfPc(ret)))
    else if depth = Want then
    begin
      OutBp := bp;
      OutFn := f;
      Exit;
    end;
  end;
  if Want > 0 then
  begin
    OutBp := 0;
    OutFn := -1;
  end;
end;

procedure Vars(C: Integer; St: PGState; Frame: Integer);
var
  bp, f, i, a: Integer;
begin
  Frames(C, St, Frame, bp, f);
  if (f < 0) or (bp = 0) then
  begin
    Reply(C, 'error: no such frame');
    Exit;
  end;
  for i := 0 to High(Fns[f].Locals) do
  begin
    a := bp + Fns[f].Locals[i].Off;
    if Fns[f].Locals[i].Box >= 0 then
    begin
      a := PInt(a)^;
      if a <> 0 then
        a := a + Fns[f].Locals[i].Box;
    end;
    if a = 0 then
      Reply(C, Fns[f].Locals[i].Name + ' = (not yet)')
    else
      Reply(C, Fns[f].Locals[i].Name + ' = ' +
        ValueText(a, Fns[f].Locals[i].Code, Fns[f].Locals[i].Size));
  end;
  Reply(C, 'ok');
end;

procedure Routines(C: Integer);
var
  arr, n, i, g, st, id: Integer;
  s: PGState;
  line: string;
begin
  arr := PInt(HeapAddr + 136)^;
  n := PInt(HeapAddr + 144)^;
  for i := 0 to n - 1 do
  begin
    g := PInt(arr + i * 8)^;
    if g = 0 then
      Continue;
    st := AtomicLoad(PInt32(g + 152)^);
    if st = 4 then
      Continue;
    id := PInt(g + 176)^;
    line := 'g' + IntToStr(id) + ' ' + StatusWord(st);
    Guard.Lock;
    if TryGet(States, id, s) then
    begin
      if s^.Stopped then
        line := line + ' stopped at ' + WhereText(s)
      else if s^.Line > 0 then
        line := line + ' at ' + WhereText(s);
    end;
    Guard.Unlock;
    Reply(C, line);
  end;
  Reply(C, 'ok');
end;

procedure Resume(C: Integer; const GText: string; Mode: Integer);
var
  st: PGState;
  g: Integer;
begin
  g := GArg(GText);
  Guard.Lock;
  if (not TryGet(States, g, st)) or (not st^.Stopped) then
  begin
    Guard.Unlock;
    Reply(C, 'error: g' + IntToStr(g) + ' is not stopped');
    Exit;
  end;
  st^.Stopped := False;
  st^.Step := Mode;
  st^.StepFrame := st^.Frame;
  PauseAll := False;
  Guard.Unlock;
  Send(st^.Resume, 1);
  Reply(C, 'ok');
end;

procedure ResumeAll;
var
  id: Integer;
  st: PGState;
begin
  Guard.Lock;
  PauseAll := False;
  for id, st in States do
    if st^.Stopped then
    begin
      st^.Stopped := False;
      st^.Step := 0;
      Send(st^.Resume, 1);
    end;
  Guard.Unlock;
end;

function CString(const S: string): PChar;
var
  n: SizeInt;
begin
  n := Length(S);
  GetMem(Result, n + 1);
  if n > 0 then
    Move(S[1], Result^, n);
  Result[n] := #0;
end;

{ The program again from the start with the words given, the socket
  the same: execve of /proc/self/exe with the environment as it is, the
  words that asked for the debugger before those given, and the breaks
  in PASLANG_DEBUG_BREAKS for the new program to set again. }
procedure RunAgain(C: Integer; const Args: string);
var
  argv: array of PChar;
  envp: array of PChar;
  env, w, exe: string;
  i, k, n, m: Integer;
  words: array of string;
begin
  words := nil;
  i := 1;
  while True do
  begin
    w := Word1(Args, i);
    if w = '' then
      Break;
    SetLength(words, Length(words) + 1);
    words[High(words)] := w;
  end;
  SetLength(argv, Length(words) + 4);
  m := 0;
  argv[m] := CString(ParamStr(0));
  m := m + 1;
  if Mode = 1 then
  begin
    argv[m] := CString('--debug-mode');
    m := m + 1;
  end
  else if Mode = 2 then
  begin
    argv[m] := CString('--debug-listen');
    argv[m + 1] := CString(SockPath);
    m := m + 2;
  end;
  for k := 0 to High(words) do
  begin
    argv[m] := CString(words[k]);
    m := m + 1;
  end;
  argv[m] := nil;
  envp := nil;
  if ReadFile('/proc/self/environ', env) then
  begin
    i := 1;
    while i <= Length(env) do
    begin
      k := i;
      while (k <= Length(env)) and (env[k] <> #0) do
        k := k + 1;
      if (k > i) and (Copy(env, i, 21) <> 'PASLANG_DEBUG_BREAKS=') then
      begin
        SetLength(envp, Length(envp) + 1);
        envp[High(envp)] := CString(Copy(env, i, k - i));
      end;
      i := k + 1;
    end;
  end;
  w := '';
  Guard.Lock;
  for k := 0 to High(Breaks) do
  begin
    if w <> '' then
      w := w + ',';
    w := w + Breaks[k].Text;
  end;
  Guard.Unlock;
  if w <> '' then
  begin
    SetLength(envp, Length(envp) + 1);
    envp[High(envp)] := CString('PASLANG_DEBUG_BREAKS=' + w);
  end;
  SetLength(envp, Length(envp) + 1);
  envp[High(envp)] := nil;
  Reply(C, 'ok');
  TcpClose(C);
  exe := '/proc/self/exe';
  if Amd64 = 0 then
    n := Syscall(221, CString(exe), Pointer(argv), Pointer(envp))
  else
    n := Syscall(59, CString(exe), Pointer(argv), Pointer(envp));
  Halt(1);
end;

procedure Session(C: Integer);
var
  buf, line, cmd, a, b, msg: string;
  i, g, n, k, f: Integer;
  st: PGState;
  ok: Boolean;
begin
  buf := '';
  Reply(C, 'paslang debugger: help for the commands');
  while TcpReadLine(C, buf, line) do
  begin
    i := 1;
    cmd := ToLower(Word1(line, i));
    a := Word1(line, i);
    b := Word1(line, i);
    if cmd = '' then
      Continue
    else if cmd = 'help' then
    begin
      Reply(C, 'routines | stopped | wait [ms] | where g | vars g [frame] | globals | functions');
      Reply(C, 'break line | break file:line | break routine | breaks | delete n | list file:line [n]');
      Reply(C, 'step g | next g | continue g | stop [g] | run [args...] | quit');
      Reply(C, 'ok');
    end
    else if cmd = 'routines' then
      Routines(C)
    else if cmd = 'stopped' then
    begin
      Guard.Lock;
      for g, st in States do
        if st^.Stopped then
          Reply(C, 'g' + IntToStr(g) + ' stopped at ' + WhereText(st));
      Guard.Unlock;
      Reply(C, 'ok');
    end
    else if cmd = 'wait' then
    begin
      n := IntArg(a, 5000);
      k := 0;
      ok := False;
      while k < n do
      begin
        select
          Recv(Stops, g):
            begin
              { a stop someone already saw through stopped, and let go
                on, is not one to report }
              Guard.Lock;
              ok := StateOf(g)^.Stopped;
              Guard.Unlock;
              if ok then
                Break;
            end;
        else
          begin
            Sleep(1);
            k := k + 1;
          end;
        end;
      end;
      if ok then
      begin
        Guard.Lock;
        st := StateOf(g);
        Reply(C, 'stopped g' + IntToStr(g) + ' at ' + WhereText(st));
        Guard.Unlock;
        Reply(C, 'ok');
      end
      else
        Reply(C, 'error: nothing stopped in ' + IntToStr(n) + ' ms');
    end
    else if cmd = 'where' then
    begin
      g := GArg(a);
      Guard.Lock;
      if TryGet(States, g, st) and st^.Stopped then
      begin
        Frames(C, st, -1, n, f);
        Guard.Unlock;
        Reply(C, 'ok');
      end
      else
      begin
        Guard.Unlock;
        Reply(C, 'error: g' + IntToStr(g) + ' is not stopped');
      end;
    end
    else if cmd = 'vars' then
    begin
      g := GArg(a);
      Guard.Lock;
      if TryGet(States, g, st) and st^.Stopped then
      begin
        Vars(C, st, IntArg(b, 0));
        Guard.Unlock;
      end
      else
      begin
        Guard.Unlock;
        Reply(C, 'error: g' + IntToStr(g) + ' is not stopped');
      end;
    end
    else if cmd = 'globals' then
    begin
      for k := 0 to High(Globals) do
        Reply(C, Globals[k].Name + ' = ' + ValueText(Globals[k].Addr, Globals[k].Code, Globals[k].Size));
      Reply(C, 'ok');
    end
    else if cmd = 'functions' then
    begin
      for k := 0 to High(Fns) do
        Reply(C, Fns[k].Name + ' ' + BaseName(Fns[k].Src) + ':' + IntToStr(Fns[k].Line));
      Reply(C, 'ok');
    end
    else if cmd = 'break' then
    begin
      if AddBreak(a, msg) then
      begin
        Reply(C, msg);
        Reply(C, 'ok');
      end
      else
        Reply(C, msg);
    end
    else if cmd = 'list' then
      ListSource(C, a, IntArg(b, 10))
    else if cmd = 'breaks' then
    begin
      for k := 0 to High(Breaks) do
        Reply(C, 'break ' + IntToStr(Breaks[k].Num) + ' at ' + Breaks[k].Text);
      Reply(C, 'ok');
    end
    else if cmd = 'delete' then
    begin
      n := IntArg(a, -1);
      ok := False;
      Guard.Lock;
      for k := 0 to High(Breaks) do
        if Breaks[k].Num = n then
        begin
          Breaks[k] := Breaks[High(Breaks)];
          SetLength(Breaks, Length(Breaks) - 1);
          ok := True;
          Break;
        end;
      Guard.Unlock;
      if ok then
        Reply(C, 'ok')
      else
        Reply(C, 'error: no break ' + a);
    end
    else if cmd = 'continue' then
      Resume(C, a, 0)
    else if cmd = 'step' then
      Resume(C, a, 1)
    else if cmd = 'next' then
      Resume(C, a, 2)
    else if cmd = 'stop' then
    begin
      Guard.Lock;
      if a = '' then
        PauseAll := True
      else
        StateOf(GArg(a))^.Freeze := True;
      Guard.Unlock;
      Reply(C, 'ok');
    end
    else if cmd = 'run' then
      RunAgain(C, Copy(line, 4, Length(line) - 3))
    else if cmd = 'quit' then
    begin
      Reply(C, 'ok');
      Break;
    end
    else
      Reply(C, 'error: unknown command ' + cmd + ' (help)');
  end;
  TcpClose(C);
  { the client is gone: its breaks with it, and every routine runs on }
  Guard.Lock;
  Breaks := nil;
  Armed := False;
  Guard.Unlock;
  ResumeAll;
end;

{ The serving routine is not one the program waits for: when the main
  routine ends, the runtime waits until the live count is one (rt_nlive,
  rt_waitall), and a routine parked in accept for ever would keep the
  program from ending. It leaves the count as if it had ended. }
procedure Daemon;
begin
  asm amd64
    lock decq rt_nlive(%rip)
  end;
  asm arm64
    adrp x9, rt_nlive
    add x9, x9, :lo12:rt_nlive
  1:
    ldaxr x10, [x9]
    sub x10, x10, #1
    stlxr w11, x10, [x9]
    cbnz w11, 1b
  end;
end;

procedure Serve(L: Integer);
var
  c: Integer;
begin
  Daemon;
  while True do
  begin
    c := UnixAccept(L);
    if c < 0 then
      Break;
    Armed := True;
    Session(c);
  end;
end;

{ ---- the command line and Ctrl-C ---- }

{ The first K words after the program's name leave its command line:
  argv moves up K words and its first word goes with it, so the
  environment, which the runtime finds after argv's end, stays where it
  was. }
procedure DropArgs(K: Integer);
begin
  asm amd64 (K: in rdi)
    movq rt_argv(%rip), %rax
    movq (%rax), %rcx
    leaq (%rax,%rdi,8), %rax
    movq %rcx, (%rax)
    movq %rax, rt_argv(%rip)
    subq %rdi, rt_argc(%rip)
  end;
  asm arm64 (K: in x0)
    adrp x9, rt_argv
    add x9, x9, :lo12:rt_argv
    ldr x10, [x9]
    ldr x11, [x10]
    add x10, x10, x0, lsl #3
    str x11, [x10]
    str x10, [x9]
    adrp x9, rt_argc
    add x9, x9, :lo12:rt_argc
    ldr x10, [x9]
    sub x10, x10, x0
    str x10, [x9]
  end;
end;

{ Ctrl-C sets Interrupted instead of ending the process: a handler of
  SIGINT that stores 1 and returns, on the signal stack, the system
  call it broke restarted. }
procedure CatchInterrupt;
begin
  asm amd64
    jmp 92f
  91:
    movq $1, v_pasdebug.interrupted(%rip)
    ret
  92:
    subq $32, %rsp
    leaq 91b(%rip), %rax
    movq %rax, (%rsp)
    movq $469762048, 8(%rsp)
    leaq rt_sigreturn(%rip), %rax
    movq %rax, 16(%rsp)
    movq $0, 24(%rsp)
    movq $2, %rdi
    movq %rsp, %rsi
    xorq %rdx, %rdx
    movq $8, %r10
    movq $13, %rax
    syscall
    addq $32, %rsp
  end;
  asm arm64
    b 92f
  91:
    adrp x9, v_pasdebug.interrupted
    add x9, x9, :lo12:v_pasdebug.interrupted
    mov x10, #1
    str x10, [x9]
    ret
  92:
    sub sp, sp, #32
    adr x10, 91b
    str x10, [sp]
    movz x10, #0x1800, lsl #16
    str x10, [sp, #8]
    str xzr, [sp, #16]
    str xzr, [sp, #24]
    mov x0, #2
    mov x1, sp
    mov x2, #0
    mov x3, #8
    mov x8, #134
    svc #0
    add sp, sp, #32
  end;
end;

function IsTty(Fd: Integer): Boolean;
var
  t: array[0..63] of Byte;
begin
  if Amd64 = 0 then
    Result := Syscall(29, Fd, $5401, Integer(@t[0])) >= 0
  else
    Result := Syscall(16, Fd, $5401, Integer(@t[0])) >= 0;
end;

function GetPid: Integer;
begin
  if Amd64 = 0 then
    Result := Syscall(172)
  else
    Result := Syscall(39);
end;

{ ---- the console ---- }

type
  TStrs = array of string;

var
  KC: Integer;           { the connection to the program's debugger }
  KBuf: string;          { its bytes after the last line read }
  KGone: Boolean;        { the program closed it: it ended or ran again }
  KCur, KFrame: Integer; { the routine the commands act on, and its frame }
  KFn, KSrc: string;     { where that routine stopped: its routine and file }
  KLine: Integer;
  KListSrc: string;      { what list shows next }
  KListAt: Integer;
  KLast: string;         { what an empty line repeats }

function Clean(const S: string): string;
var
  i, j: Integer;
begin
  i := 1;
  j := Length(S);
  while (i <= j) and ((S[i] = ' ') or (S[i] = #9) or (S[i] = #13)) do
    i := i + 1;
  while (j >= i) and ((S[j] = ' ') or (S[j] = #9) or (S[j] = #13)) do
    j := j - 1;
  Result := Copy(S, i, j - i + 1);
end;

function PadL(const S: string; W: Integer): string;
begin
  Result := S;
  while Length(Result) < W do
    Result := ' ' + Result;
end;

{ One line of the terminal, a byte at a time: a line read ahead would
  be lost to a run, which starts the program again in this process. }
function ReadCmd(out Line: string): Boolean;
var
  ch: string;
begin
  Line := '';
  while True do
  begin
    ch := TcpRead(0, 1);
    if ch = '' then
    begin
      Result := Line <> '';
      Exit;
    end;
    if ch = #10 then
    begin
      Result := True;
      Exit;
    end;
    Line := Line + ch;
  end;
end;

{ A request and its reply: the lines before "ok", True; the lines up to
  an "error: ...", which they end with, False. }
function Ask(const Req: string; out Lines: TStrs): Boolean;
var
  l: string;
begin
  Result := False;
  Lines := nil;
  if KGone then
    Exit;
  if TcpWrite(KC, Req + #10) < 0 then
  begin
    KGone := True;
    Exit;
  end;
  while TcpReadLine(KC, KBuf, l) do
  begin
    if l = 'ok' then
    begin
      Result := True;
      Exit;
    end;
    SetLength(Lines, Length(Lines) + 1);
    Lines[High(Lines)] := l;
    if Copy(l, 1, 7) = 'error: ' then
      Exit;
  end;
  KGone := True;
end;

procedure Show(const Lines: TStrs);
var
  i: Integer;
begin
  for i := 0 to High(Lines) do
    WriteLn(Lines[i]);
end;

function LastColon(const S: string): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to Length(S) do
    if S[i] = ':' then
      Result := i;
end;

{ "stopped g3 at Work f.paslang:29" from wait, or "g3 stopped at Work
  f.paslang:29" from stopped: g3 becomes the routine the commands act
  on, at that place. }
function TakeStop(const L: string): Boolean;
var
  i, k, g: Integer;
  w, last, prev: string;
begin
  Result := False;
  i := 1;
  g := -1;
  last := '';
  prev := '';
  while True do
  begin
    w := Word1(L, i);
    if w = '' then
      Break;
    if (g < 0) and (Length(w) > 1) and (w[1] = 'g') then
      g := IntArg(Copy(w, 2, Length(w) - 1), -1);
    prev := last;
    last := w;
  end;
  if g < 0 then
    Exit;
  KCur := g;
  KFrame := 0;
  KFn := prev;
  k := LastColon(last);
  KSrc := Copy(last, 1, k - 1);
  KLine := IntArg(Copy(last, k + 1, Length(last) - k), 0);
  KListSrc := KSrc;
  KListAt := KLine - 5;
  if KListAt < 1 then
    KListAt := 1;
  Result := True;
end;

{ Count lines of Src from First, the line a routine stopped at marked. }
procedure ShowSource(const Src: string; First, Count: Integer);
var
  ls: TStrs;
  i, t, n: Integer;
  mark: string;
begin
  if First < 1 then
    First := 1;
  if not Ask('list ' + Src + ':' + IntToStr(First) + ' ' + IntToStr(Count), ls) then
  begin
    Show(ls);
    Exit;
  end;
  for i := 0 to High(ls) do
  begin
    t := 1;
    while (t <= Length(ls[i])) and (ls[i][t] <> #9) do
      t := t + 1;
    n := IntArg(Copy(ls[i], 1, t - 1), 0);
    if (n = KLine) and (Src = KSrc) then
      mark := '=> '
    else
      mark := '   ';
    WriteLn(mark, PadL(IntToStr(n), 4), '  ', Copy(ls[i], t + 1, Length(ls[i]) - t));
  end;
end;

procedure ShowStop;
begin
  WriteLn('g', KCur, ' stopped at ', KFn, ' ', KSrc, ':', KLine);
  ShowSource(KSrc, KLine, 1);
end;

{ After continue, step, next or stop: until a routine stops, which
  becomes the one the commands act on, or the program ends, or Limit ms
  pass (0: no limit). Ctrl-C stops every routine at its next statement;
  a second one gives the prompt back while the program runs on (a
  routine waiting for input or a lock reaches no statement). }
function WaitStop(Limit: Integer): Boolean;
var
  ls: TStrs;
  ok: Boolean;
  waited, hits: Integer;
begin
  Result := False;
  waited := 0;
  hits := 0;
  while True do
  begin
    if Interrupted then
    begin
      Interrupted := False;
      hits := hits + 1;
      if hits > 1 then
      begin
        WriteLn('interrupt: the prompt again; the program runs on (wait waits for a stop)');
        Exit;
      end;
      Ask('stop', ls);
      WriteLn('interrupt: every routine stops at its next statement');
    end;
    ok := Ask('wait 200', ls);
    if KGone then
    begin
      WriteLn('the program ended');
      Exit;
    end;
    if ok and (Length(ls) > 0) and TakeStop(ls[0]) then
    begin
      ShowStop;
      Result := True;
      Exit;
    end;
    waited := waited + 200;
    if (Limit > 0) and (waited >= Limit) then
    begin
      WriteLn('nothing stopped in ', Limit, ' ms: the routines are stopped already or wait for something (wait waits more)');
      Exit;
    end;
  end;
end;

{ The routines stopped now; the first becomes the current one. }
procedure ShowStopped;
var
  ls: TStrs;
  i: Integer;
begin
  if Ask('stopped', ls) and (Length(ls) > 0) then
  begin
    for i := 1 to High(ls) do
      WriteLn(ls[i]);
    if TakeStop(ls[0]) then
      ShowStop;
  end
  else
    WriteLn('the program runs: break sets a break, stop stops every routine');
end;

{ file:line of a routine of the program, from functions. }
function FnPlace(const Name: string): string;
var
  ls: TStrs;
  i, j: Integer;
  w: string;
begin
  Result := '';
  if not Ask('functions', ls) then
    Exit;
  for i := 0 to High(ls) do
  begin
    j := 1;
    w := Word1(ls[i], j);
    if ToLower(w) = ToLower(Name) then
    begin
      Result := Word1(ls[i], j);
      Exit;
    end;
  end;
end;

{ Connected when the greeting comes: a connection the program closes
  without it (the program was starting again, as after run, and the old
  one took the connection with it) is tried again, for five seconds. }
function Connect(const Sock: string): Boolean;
var
  tries: Integer;
  l: string;
begin
  Result := False;
  KGone := False;
  tries := 0;
  while tries < 250 do
  begin
    KBuf := '';
    KC := UnixConnect(Sock);
    if KC >= 0 then
    begin
      if TcpReadLine(KC, KBuf, l) then
      begin
        Result := True;
        Exit;
      end;
      TcpClose(KC);
    end;
    Sleep(20);
    tries := tries + 1;
  end;
end;

procedure ConsoleHelp;
begin
  WriteLn('  run [args] (r)            start the program again; the breaks stay');
  WriteLn('  break [line | file:line | routine] (b)   a break; alone, at this line');
  WriteLn('  breaks (info b)   delete n (d)');
  WriteLn('  continue (c)   step (s)   next (n)   the current routine: on, a statement, over calls');
  WriteLn('  stop                      every routine at its next statement (Ctrl-C too)');
  WriteLn('  where (bt)   frame n (f)  the frames; the one vars and print read');
  WriteLn('  vars (locals)   globals   print name (p)');
  WriteLn('  list [line | file:line | routine] (l)   the source around the stop, or there');
  WriteLn('  routines   routine n (g n)   functions   wait');
  WriteLn('  quit (q)                  leave; under --debug-mode, the program ends too');
  WriteLn('  An empty line repeats continue, step, next or list; any other line goes');
  WriteLn('  to the program''s debugger as it is (raw help lists those requests).');
end;

procedure PasDebugConsole(const Sock: string; Owned: Boolean);
var
  line, cmd, a, rest, place: string;
  i, n, k: Integer;
  ls: TStrs;
  echo, found: Boolean;
begin
  CatchInterrupt;
  echo := not IsTty(0);
  KCur := 0;
  KFrame := 0;
  KFn := '';
  KSrc := '';
  KLine := 0;
  KListSrc := '';
  KListAt := 1;
  KLast := '';
  if not Connect(Sock) then
  begin
    WriteLn(ErrOutput, 'pasdbg: nothing listens at ', Sock);
    Exit;
  end;
  WriteLn('paslang debugger: help for the commands');
  if Owned then
    WaitStop(0)
  else
    ShowStopped;
  while not KGone do
  begin
    Write('(pasdbg) ');
    if not ReadCmd(line) then
    begin
      WriteLn;
      Break;
    end;
    if echo then
      WriteLn(line);
    line := Clean(line);
    if line = '' then
      line := KLast;
    KLast := '';
    if line = '' then
      Continue;
    i := 1;
    cmd := ToLower(Word1(line, i));
    rest := Clean(Copy(line, i, Length(line) - i + 1));
    a := Word1(line, i);
    if (cmd = 'q') or (cmd = 'quit') or (cmd = 'exit') then
      Break
    else if (cmd = 'h') or (cmd = 'help') then
      ConsoleHelp
    else if cmd = 'raw' then
    begin
      Ask(rest, ls);
      Show(ls);
    end
    else if (cmd = 'r') or (cmd = 'run') then
    begin
      Ask('run ' + rest, ls);
      if Owned then
        while True do
          Sleep(1000);   { the program starts again in this process }
      TcpClose(KC);
      if not Connect(Sock) then
      begin
        WriteLn('the program does not listen again at ', Sock);
        Exit;
      end;
      WriteLn('the program started again');
      ShowStopped;
    end
    else if (cmd = 'b') or (cmd = 'break') then
    begin
      if (a = '') and (KLine > 0) then
        a := KSrc + ':' + IntToStr(KLine);
      Ask('break ' + a, ls);
      Show(ls);
    end
    else if (cmd = 'd') or (cmd = 'delete') then
    begin
      if Ask('delete ' + a, ls) then
        WriteLn('break ', a, ' deleted')
      else
        Show(ls);
    end
    else if (cmd = 'breaks') or (((cmd = 'i') or (cmd = 'info')) and
      ((a = 'b') or (a = 'break') or (a = 'breaks') or (a = 'breakpoints'))) then
    begin
      if Ask('breaks', ls) and (Length(ls) = 0) then
        WriteLn('no breaks')
      else
        Show(ls);
    end
    else if (cmd = 'c') or (cmd = 'continue') or (cmd = 's') or (cmd = 'step') or
      (cmd = 'n') or (cmd = 'next') then
    begin
      if KCur <= 0 then
        WriteLn('no routine is stopped: stop, or break and wait')
      else
      begin
        if (cmd = 'c') or (cmd = 'continue') then
          line := 'continue'
        else if (cmd = 's') or (cmd = 'step') then
          line := 'step'
        else
          line := 'next';
        Interrupted := False;
        if Ask(line + ' g' + IntToStr(KCur), ls) then
        begin
          KLast := line;
          WaitStop(0);
        end
        else
          Show(ls);
      end;
    end
    else if cmd = 'stop' then
    begin
      Interrupted := False;
      if Ask('stop', ls) then
        WaitStop(1000)
      else
        Show(ls);
    end
    else if cmd = 'wait' then
    begin
      Interrupted := False;
      WaitStop(0);
    end
    else if (cmd = 'bt') or (cmd = 'where') or (cmd = 'backtrace') then
    begin
      if Ask('where g' + IntToStr(KCur), ls) then
        for k := 0 to High(ls) do
          WriteLn('#', ls[k])
      else
        Show(ls);
    end
    else if (cmd = 'f') or (cmd = 'frame') then
    begin
      n := IntArg(a, 0);
      found := False;
      if Ask('where g' + IntToStr(KCur), ls) then
        for k := 0 to High(ls) do
        begin
          i := 1;
          if IntArg(Word1(ls[k], i), -1) = n then
          begin
            WriteLn('#', ls[k]);
            KFrame := n;
            found := True;
          end;
        end
      else
        Show(ls);
      if not found then
        WriteLn('no frame ', n);
    end
    else if (cmd = 'vars') or (cmd = 'locals') or
      (((cmd = 'i') or (cmd = 'info')) and (a = 'locals')) then
    begin
      if Ask('vars g' + IntToStr(KCur) + ' ' + IntToStr(KFrame), ls) and (Length(ls) = 0) then
        WriteLn('no local variables')
      else
        Show(ls);
    end
    else if cmd = 'globals' then
    begin
      Ask('globals', ls);
      Show(ls);
    end
    else if (cmd = 'p') or (cmd = 'print') then
    begin
      if a = '' then
        WriteLn('print name')
      else
      begin
        found := False;
        if (KCur > 0) and Ask('vars g' + IntToStr(KCur) + ' ' + IntToStr(KFrame), ls) then
          for k := 0 to High(ls) do
            if ToLower(Copy(ls[k], 1, Length(a) + 3)) = ToLower(a) + ' = ' then
            begin
              WriteLn(ls[k]);
              found := True;
            end;
        if (not found) and Ask('globals', ls) then
          for k := 0 to High(ls) do
            if ToLower(Copy(ls[k], 1, Length(a) + 3)) = ToLower(a) + ' = ' then
            begin
              WriteLn(ls[k]);
              found := True;
            end;
        if not found then
          WriteLn('no variable ', a, ' here');
      end;
    end
    else if (cmd = 'l') or (cmd = 'list') then
    begin
      place := '';
      if a = '' then
      begin
        if KListSrc = '' then
        begin
          place := FnPlace('main');
          k := LastColon(place);
          KListSrc := Copy(place, 1, k - 1);
          KListAt := IntArg(Copy(place, k + 1, Length(place) - k), 1) - 5;
        end;
      end
      else
      begin
        k := LastColon(a);
        if k > 0 then
          place := a
        else if IntArg(a, 0) > 0 then
        begin
          if KListSrc = '' then
          begin
            place := FnPlace('main');
            KListSrc := Copy(place, 1, LastColon(place) - 1);
          end;
          place := KListSrc + ':' + a;
        end
        else
          place := FnPlace(a);
        if place = '' then
        begin
          WriteLn('no line or routine ', a);
          Continue;
        end;
        k := LastColon(place);
        KListSrc := Copy(place, 1, k - 1);
        KListAt := IntArg(Copy(place, k + 1, Length(place) - k), 1) - 5;
      end;
      if KListAt < 1 then
        KListAt := 1;
      if KListSrc <> '' then
      begin
        ShowSource(KListSrc, KListAt, 10);
        KListAt := KListAt + 10;
        KLast := 'list';
      end;
    end
    else if (cmd = 'g') or (cmd = 'routine') or (cmd = 'thread') then
    begin
      n := GArg(a);
      found := False;
      if Ask('stopped', ls) then
        for k := 0 to High(ls) do
        begin
          i := 1;
          if GArg(Word1(ls[k], i)) = n then
          begin
            TakeStop(ls[k]);
            ShowStop;
            found := True;
          end;
        end;
      if not found then
        WriteLn('g', n, ' is not stopped');
    end
    else if (cmd = 'routines') or (((cmd = 'i') or (cmd = 'info')) and (a = 'threads')) then
    begin
      Ask('routines', ls);
      Show(ls);
    end
    else if cmd = 'functions' then
    begin
      Ask('functions', ls);
      Show(ls);
    end
    else
    begin
      Ask(line, ls);
      Show(ls);
    end;
  end;
  if not KGone then
    Ask('quit', ls);
  TcpClose(KC);
  if Owned then
    Halt(0);
end;

{ --debug-mode: this process's console, as a routine of it that the
  program does not wait for. }
procedure Local;
begin
  Daemon;
  PasDebugConsole(SockPath, True);
  Halt(1);
end;

procedure PasDebugStart(HeapState, Tables, TablesEnd: Pointer);
var
  l, i, k: Integer;
  a, w, msg: string;
begin
  HeapAddr := Integer(HeapState);
  Mode := 0;
  a := ParamStr(1);
  if a = '--debug-mode' then
  begin
    DropArgs(1);
    Mode := 1;
    SockPath := '@pasdbg-' + IntToStr(GetPid);
  end
  else if ((a = '--debug-listen') or (a = '--debug-attach')) and (ParamCount >= 2) then
  begin
    SockPath := ParamStr(2);
    DropArgs(2);
    if a = '--debug-attach' then
    begin
      { this executable is a console for another process }
      PasDebugConsole(SockPath, False);
      Halt(0);
    end;
    Mode := 2;
  end
  else
    SockPath := GetEnv('PASLANG_DEBUG');
  if SockPath = '' then
    Exit;
  ReadTables(Tables, TablesEnd);
  New(States);
  Stops := MakeChan(1024);
  l := UnixListen(SockPath);
  if l < 0 then
  begin
    WriteLn(ErrOutput, 'paslang: -debug cannot listen at ', SockPath);
    if Mode > 0 then
      Halt(1);
    Exit;
  end;
  { the breaks a run carried over }
  w := GetEnv('PASLANG_DEBUG_BREAKS');
  i := 1;
  while i <= Length(w) do
  begin
    k := i;
    while (k <= Length(w)) and (w[k] <> ',') do
      k := k + 1;
    if k > i then
      AddBreak(Copy(w, i, k - i), msg);
    i := k + 1;
  end;
  if Mode > 0 then
  begin
    { the main routine stops before its first statement }
    Armed := True;
    Guard.Lock;
    StateOf(Goid)^.Freeze := True;
    Guard.Unlock;
  end;
  pas Serve(l);
  if Mode = 1 then
    pas Local;
end;

finalization
  { the main routine reached its end.: under --debug-mode the console
    says so (a Halt ends the program without it) }
  if Mode = 1 then
    WriteLn('the program ended');

end.
