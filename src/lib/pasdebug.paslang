{$mode objfpc}{$H+}

{ The debugger inside the executable (P118, 1.1.1). A program compiled
  with -debug calls PasDebugLine at every statement with its line, its
  routine and its frame, and PasDebugStart before its body. When the
  environment names a socket (PASLANG_DEBUG=path, @name for an abstract
  one) the program listens there and answers a text protocol, one line
  a request and a reply of lines ending in "ok" or "error: ...": the
  routines and where each is, a routine's frames, the variables of a
  frame with their values by type, the globals, the functions, breaks at
  a line or a routine, step, next, continue, stop, run again with a
  command line, quit. A routine that hits a break parks on a channel of
  its own until the client lets it go; the others run on. Without the
  variable the hooks cost a call each and nothing listens. The tables
  the compiler writes into the section pasdbg say the routines, their
  lines and their variables; the runtime gives the list of routines. }
unit pasdebug;

interface

procedure PasDebugStart(HeapState, Tables, TablesEnd: Pointer);
procedure PasDebugLine(Line: Integer; Fn, Frame: Pointer);

implementation

uses
  pasnet, paslib;

type
  PInt = ^Integer;

  TLocal = record
    Name: string;
    Off: Integer;
    Code: Integer;
    Size: Integer;
    Box: Integer;     { its offset inside the heap box a closure holds it in, -1 in the frame }
  end;
  TFn = record
    Start, Stop: Integer;
    Name, Src: string;
    Line: Integer;
    Locals: array of TLocal;
  end;
  TGlobal = record
    Name: string;
    Addr, Code, Size: Integer;
  end;
  TLinePc = record
    Pc, Line: Integer;
  end;
  TBreak = record
    Num: Integer;
    Src: string;
    Line: Integer;    { 0 for a break at a routine }
    Fn: Integer;      { the routine's start, 0 for a break at a line }
    Text: string;
  end;
  PGState = ^TGState;
  TGState = record
    Id: Integer;
    Line: Integer;
    Fn: Integer;
    Frame: Integer;
    Stopped: Boolean;
    Freeze: Boolean;
    Step: Integer;       { 0 none, 1 a line, 2 a line in this frame or an outer one }
    StepFrame: Integer;
    Resume: chan of Integer;
  end;

var
  HeapAddr: Integer;
  Fns: array of TFn;
  Globals: array of TGlobal;
  Lines: array of TLinePc;
  Breaks: array of TBreak;
  BreakNum: Integer;
  States: map[Integer] of PGState;
  Guard: Mutex;
  Armed: Boolean;
  PauseAll: Boolean;
  Stops: chan of Integer;
  SockPath: string;

{ ---- the tables ---- }

function StrAt(P, N: Integer): string;
begin
  Result := '';
  if (P = 0) or (N <= 0) then
    Exit;
  SetLength(Result, N);
  Move(PByte(P)^, Result[1], N);
end;

procedure ReadTables(Tables, TablesEnd: Pointer);
var
  p, e, k, n, i, q: Integer;
  fn: TFn;
begin
  p := Integer(Tables);
  e := Integer(TablesEnd);
  while p + 96 <= e do
  begin
    k := PInt(p)^;
    if k = 1 then
    begin
      fn.Start := PInt(p + 8)^;
      fn.Stop := PInt(p + 16)^;
      fn.Name := StrAt(PInt(p + 24)^, PInt(p + 32)^);
      fn.Src := StrAt(PInt(p + 40)^, PInt(p + 48)^);
      fn.Line := PInt(p + 56)^;
      n := PInt(p + 64)^;
      q := PInt(p + 72)^;
      fn.Locals := nil;
      SetLength(fn.Locals, n);
      for i := 0 to n - 1 do
      begin
        fn.Locals[i].Name := StrAt(PInt(q)^, PInt(q + 8)^);
        fn.Locals[i].Off := PInt(q + 16)^;
        fn.Locals[i].Code := PInt(q + 24)^;
        fn.Locals[i].Size := PInt(q + 32)^;
        fn.Locals[i].Box := PInt(q + 40)^;
        q := q + 48;
      end;
      SetLength(Fns, Length(Fns) + 1);
      Fns[High(Fns)] := fn;
    end
    else if k = 2 then
    begin
      SetLength(Globals, Length(Globals) + 1);
      Globals[High(Globals)].Addr := PInt(p + 8)^;
      Globals[High(Globals)].Name := StrAt(PInt(p + 16)^, PInt(p + 24)^);
      Globals[High(Globals)].Code := PInt(p + 32)^;
      Globals[High(Globals)].Size := PInt(p + 40)^;
    end
    else if k = 3 then
    begin
      n := PInt(p + 8)^;
      q := PInt(p + 16)^;
      for i := 0 to n - 1 do
      begin
        SetLength(Lines, Length(Lines) + 1);
        Lines[High(Lines)].Pc := PInt(q)^;
        Lines[High(Lines)].Line := PInt(q + 8)^;
        q := q + 16;
      end;
    end;
    p := p + 96;
  end;
end;

function FnOf(Pc: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(Fns) do
    if (Pc >= Fns[i].Start) and (Pc < Fns[i].Stop) then
    begin
      Result := i;
      Exit;
    end;
end;

function FnByStart(Start: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(Fns) do
    if Fns[i].Start = Start then
    begin
      Result := i;
      Exit;
    end;
end;

function FnByName(const N: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(Fns) do
    if ToLower(Fns[i].Name) = ToLower(N) then
    begin
      Result := i;
      Exit;
    end;
end;

{ The line of a return address: the greatest line entry not above it
  inside the routine that holds it. }
function LineOfPc(Pc: Integer): Integer;
var
  i, f, best: Integer;
begin
  Result := 0;
  f := FnOf(Pc);
  if f < 0 then
    Exit;
  best := 0;
  for i := 0 to High(Lines) do
    if (Lines[i].Pc <= Pc) and (Lines[i].Pc >= Fns[f].Start) and (Lines[i].Pc >= best) then
    begin
      best := Lines[i].Pc;
      Result := Lines[i].Line;
    end;
end;

{ ---- values ---- }

function HexOf(V: Integer): string;
const
  Digits = '0123456789abcdef';
var
  i: Integer;
begin
  Result := '';
  if V = 0 then
  begin
    Result := '$0';
    Exit;
  end;
  for i := 1 to 16 do
  begin
    Result := Digits[(V and 15) + 1] + Result;
    V := V shr 4;
    if V = 0 then
      Break;
  end;
  Result := '$' + Result;
end;

function RealText(R: Real): string;
var
  neg: Boolean;
  ip, fp: Integer;
begin
  neg := R < 0;
  if neg then
    R := -R;
  ip := Trunc(R);
  fp := Trunc((R - ip) * 1000000 + 0.5);
  if fp >= 1000000 then
  begin
    ip := ip + 1;
    fp := fp - 1000000;
  end;
  Result := IntToStr(ip) + '.' + Copy(IntToStr(fp + 1000000), 2, 6);
  if neg then
    Result := '-' + Result;
end;

function Quoted(const S: string): string;
var
  i: Integer;
  c: Char;
  open: Boolean;
begin
  Result := '';
  open := False;
  for i := 1 to Length(S) do
  begin
    c := S[i];
    if (c >= ' ') and (c <= '~') then
    begin
      if not open then
      begin
        Result := Result + '''';
        open := True;
      end;
      if c = '''' then
        Result := Result + ''''''
      else
        Result := Result + c;
    end
    else
    begin
      if open then
      begin
        Result := Result + '''';
        open := False;
      end;
      Result := Result + '#' + IntToStr(Ord(c));
    end;
  end;
  if open or (S = '') then
    Result := Result + '''';
  if S = '' then
    Result := '''''';
end;

{ The value at address A of the code and size the table gives. }
function ValueText(A, Code, Size: Integer): string;
var
  v, n: Integer;
  s: string;
begin
  case Code of
    1:
      begin
        if Size = 1 then
          v := PInt8(A)^
        else if Size = 2 then
          v := PInt16(A)^
        else if Size = 4 then
          v := PInt32(A)^
        else
          v := PInt(A)^;
        Result := IntToStr(v);
      end;
    2:
      begin
        if Size = 1 then
          v := PByte(A)^
        else if Size = 2 then
          v := PWord(A)^
        else if Size = 4 then
          v := PUInt32(A)^
        else
          v := PInt(A)^;
        Result := IntToStr(v);
      end;
    3:
      if PByte(A)^ <> 0 then
        Result := 'True'
      else
        Result := 'False';
    4:
      begin
        v := PByte(A)^;
        if (v >= 32) and (v <= 126) then
          Result := '''' + Chr(v) + ''''
        else
          Result := '#' + IntToStr(v);
      end;
    5:
      begin
        n := PInt(A + 8)^;
        if (n < 0) or (n > 1048576) or (PInt(A)^ = 0) then
          Result := ''''''
        else
        begin
          if n > 200 then
            s := StrAt(PInt(A)^, 200)
          else
            s := StrAt(PInt(A)^, n);
          Result := Quoted(s);
          if n > 200 then
            Result := Result + ' (' + IntToStr(n) + ' bytes)';
        end;
      end;
    6:
      Result := RealText(PDouble(A)^);
    7:
      Result := RealText(PSingle(A)^);
    8:
      begin
        v := PInt(A)^;
        if v = 0 then
          Result := 'nil'
        else
          Result := HexOf(v);
      end;
    9:
      Result := IntToStr(PInt(A)^);
  else
    Result := '<' + IntToStr(Size) + ' bytes>';
  end;
end;

{ ---- the states of the routines ---- }

function StateOf(G: Integer): PGState;
var
  st: PGState;
begin
  if not TryGet(States, G, st) then
  begin
    New(st);
    st^.Id := G;
    st^.Line := 0;
    st^.Fn := 0;
    st^.Frame := 0;
    st^.Stopped := False;
    st^.Freeze := False;
    st^.Step := 0;
    st^.StepFrame := 0;
    st^.Resume := MakeChan(1);
    States[G] := st;
  end;
  Result := st;
end;

function BreakAt(Line: Integer; Fn: Integer): Boolean;
var
  i, f: Integer;
begin
  Result := False;
  f := FnByStart(Fn);
  for i := 0 to High(Breaks) do
  begin
    if (Breaks[i].Line > 0) and (Breaks[i].Line = Line) and
      ((Breaks[i].Src = '') or (f < 0) or (BaseName(Fns[f].Src) = Breaks[i].Src)) then
    begin
      Result := True;
      Exit;
    end;
    if (Breaks[i].Line = 0) and (Breaks[i].Fn = Fn) and (f >= 0) and (Fns[f].Line = Line) then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

procedure PasDebugLine(Line: Integer; Fn, Frame: Pointer);
var
  g: Integer;
  st: PGState;
  stop: Boolean;
begin
  if not Armed then
    Exit;
  g := Goid;
  Guard.Lock;
  st := StateOf(g);
  st^.Line := Line;
  st^.Fn := Integer(Fn);
  st^.Frame := Integer(Frame);
  stop := False;
  if st^.Step = 1 then
    stop := True
  else if (st^.Step = 2) and (Integer(Frame) >= st^.StepFrame) then
    stop := True
  else if PauseAll or st^.Freeze then
    stop := True
  else if Length(Breaks) > 0 then
    stop := BreakAt(Line, Integer(Fn));
  if stop then
  begin
    st^.Stopped := True;
    st^.Step := 0;
    st^.Freeze := False;
  end;
  Guard.Unlock;
  if stop then
  begin
    Send(Stops, g);
    g := Recv(st^.Resume);
  end;
end;

{ ---- the server ---- }

function Word1(const S: string; var I: Integer): string;
var
  j: Integer;
begin
  while (I <= Length(S)) and (S[I] = ' ') do
    I := I + 1;
  j := I;
  while (j <= Length(S)) and (S[j] <> ' ') do
    j := j + 1;
  Result := Copy(S, I, j - I);
  I := j;
end;

function IntArg(const S: string; Def: Integer): Integer;
var
  v: Int64;
begin
  if StrToInt64(S, v) then
    Result := v
  else
    Result := Def;
end;

{ g7 or 7 }
function GArg(const S: string): Integer;
begin
  if (Length(S) > 1) and (S[1] = 'g') then
    Result := IntArg(Copy(S, 2, Length(S) - 1), -1)
  else
    Result := IntArg(S, -1);
end;

function StatusWord(St: Integer): string;
begin
  case St of
    0: Result := 'running';
    1: Result := 'parked';
    2: Result := 'waiting';
    3: Result := 'ready';
    4: Result := 'dead';
  else
    Result := 'status' + IntToStr(St);
  end;
end;

function WhereText(St: PGState): string;
var
  f: Integer;
begin
  f := FnByStart(St^.Fn);
  if f >= 0 then
    Result := Fns[f].Name + ' ' + BaseName(Fns[f].Src) + ':' + IntToStr(St^.Line)
  else
    Result := '? :' + IntToStr(St^.Line);
end;

procedure Reply(C: Integer; const S: string);
begin
  TcpWrite(C, S + #10);
end;

{ The frames of a stopped routine: its own, then up the chain of frame
  pointers while the return address is in a routine the tables know.
  Want -1 lists them; Want n gives frame n's pointer and routine. }
procedure Frames(C: Integer; St: PGState; Want: Integer; out OutBp, OutFn: Integer);
var
  bp, ret, f, depth: Integer;
begin
  OutBp := St^.Frame;
  OutFn := FnByStart(St^.Fn);
  bp := St^.Frame;
  f := OutFn;
  depth := 0;
  if (Want < 0) and (f >= 0) then
    Reply(C, '0 ' + Fns[f].Name + ' ' + BaseName(Fns[f].Src) + ':' + IntToStr(St^.Line));
  if Want = 0 then
    Exit;
  while (bp <> 0) and (depth < 64) do
  begin
    ret := PInt(bp + 8)^;
    bp := PInt(bp)^;
    f := FnOf(ret);
    if f < 0 then
      Break;
    depth := depth + 1;
    if Want < 0 then
      Reply(C, IntToStr(depth) + ' ' + Fns[f].Name + ' ' + BaseName(Fns[f].Src) + ':' + IntToStr(LineOfPc(ret)))
    else if depth = Want then
    begin
      OutBp := bp;
      OutFn := f;
      Exit;
    end;
  end;
  if Want > 0 then
  begin
    OutBp := 0;
    OutFn := -1;
  end;
end;

procedure Vars(C: Integer; St: PGState; Frame: Integer);
var
  bp, f, i, a: Integer;
begin
  Frames(C, St, Frame, bp, f);
  if (f < 0) or (bp = 0) then
  begin
    Reply(C, 'error: no such frame');
    Exit;
  end;
  for i := 0 to High(Fns[f].Locals) do
  begin
    a := bp + Fns[f].Locals[i].Off;
    if Fns[f].Locals[i].Box >= 0 then
    begin
      a := PInt(a)^;
      if a <> 0 then
        a := a + Fns[f].Locals[i].Box;
    end;
    if a = 0 then
      Reply(C, Fns[f].Locals[i].Name + ' = (not yet)')
    else
      Reply(C, Fns[f].Locals[i].Name + ' = ' +
        ValueText(a, Fns[f].Locals[i].Code, Fns[f].Locals[i].Size));
  end;
  Reply(C, 'ok');
end;

procedure Routines(C: Integer);
var
  arr, n, i, g, st, id: Integer;
  s: PGState;
  line: string;
begin
  arr := PInt(HeapAddr + 136)^;
  n := PInt(HeapAddr + 144)^;
  for i := 0 to n - 1 do
  begin
    g := PInt(arr + i * 8)^;
    if g = 0 then
      Continue;
    st := PInt32(g + 152)^;
    if st = 4 then
      Continue;
    id := PInt(g + 176)^;
    line := 'g' + IntToStr(id) + ' ' + StatusWord(st);
    Guard.Lock;
    if TryGet(States, id, s) then
    begin
      if s^.Stopped then
        line := line + ' stopped at ' + WhereText(s)
      else if s^.Line > 0 then
        line := line + ' at ' + WhereText(s);
    end;
    Guard.Unlock;
    Reply(C, line);
  end;
  Reply(C, 'ok');
end;

procedure Resume(C: Integer; const GText: string; Mode: Integer);
var
  st: PGState;
  g: Integer;
begin
  g := GArg(GText);
  Guard.Lock;
  if (not TryGet(States, g, st)) or (not st^.Stopped) then
  begin
    Guard.Unlock;
    Reply(C, 'error: g' + IntToStr(g) + ' is not stopped');
    Exit;
  end;
  st^.Stopped := False;
  st^.Step := Mode;
  st^.StepFrame := st^.Frame;
  Guard.Unlock;
  Send(st^.Resume, 1);
  Reply(C, 'ok');
end;

procedure ResumeAll;
var
  id: Integer;
  st: PGState;
begin
  Guard.Lock;
  PauseAll := False;
  for id, st in States do
    if st^.Stopped then
    begin
      st^.Stopped := False;
      st^.Step := 0;
      Send(st^.Resume, 1);
    end;
  Guard.Unlock;
end;

function CString(const S: string): PChar;
var
  n: SizeInt;
begin
  n := Length(S);
  GetMem(Result, n + 1);
  if n > 0 then
    Move(S[1], Result^, n);
  Result[n] := #0;
end;

{ The program again from the start with the words given, the socket
  the same: execve of /proc/self/exe with the environment as it is. }
procedure RunAgain(C: Integer; const Args: string);
var
  argv: array of PChar;
  envp: array of PChar;
  env, w, exe: string;
  i, k, n: Integer;
  words: array of string;
begin
  words := nil;
  i := 1;
  while True do
  begin
    w := Word1(Args, i);
    if w = '' then
      Break;
    SetLength(words, Length(words) + 1);
    words[High(words)] := w;
  end;
  SetLength(argv, Length(words) + 2);
  argv[0] := CString(ParamStr(0));
  for k := 0 to High(words) do
    argv[k + 1] := CString(words[k]);
  argv[High(argv)] := nil;
  envp := nil;
  if ReadFile('/proc/self/environ', env) then
  begin
    i := 1;
    while i <= Length(env) do
    begin
      k := i;
      while (k <= Length(env)) and (env[k] <> #0) do
        k := k + 1;
      if k > i then
      begin
        SetLength(envp, Length(envp) + 1);
        envp[High(envp)] := CString(Copy(env, i, k - i));
      end;
      i := k + 1;
    end;
  end;
  SetLength(envp, Length(envp) + 1);
  envp[High(envp)] := nil;
  Reply(C, 'ok');
  TcpClose(C);
  exe := '/proc/self/exe';
  if Amd64 = 0 then
    n := Syscall(221, CString(exe), Pointer(argv), Pointer(envp))
  else
    n := Syscall(59, CString(exe), Pointer(argv), Pointer(envp));
  Halt(1);
end;

procedure Session(C: Integer);
var
  buf, line, cmd, a, b: string;
  i, g, n, k, f: Integer;
  st: PGState;
  ok: Boolean;
begin
  buf := '';
  Reply(C, 'paslang debugger: help for the commands');
  while TcpReadLine(C, buf, line) do
  begin
    i := 1;
    cmd := ToLower(Word1(line, i));
    a := Word1(line, i);
    b := Word1(line, i);
    if cmd = '' then
      Continue
    else if cmd = 'help' then
    begin
      Reply(C, 'routines | stopped | wait [ms] | where g | vars g [frame] | globals | functions');
      Reply(C, 'break line | break file:line | break routine | breaks | delete n');
      Reply(C, 'step g | next g | continue g | stop [g] | run [args...] | quit');
      Reply(C, 'ok');
    end
    else if cmd = 'routines' then
      Routines(C)
    else if cmd = 'stopped' then
    begin
      Guard.Lock;
      for g, st in States do
        if st^.Stopped then
          Reply(C, 'g' + IntToStr(g) + ' stopped at ' + WhereText(st));
      Guard.Unlock;
      Reply(C, 'ok');
    end
    else if cmd = 'wait' then
    begin
      n := IntArg(a, 5000);
      k := 0;
      ok := False;
      while k < n do
      begin
        select
          Recv(Stops, g):
            begin
              ok := True;
              Break;
            end;
        else
          begin
            Sleep(1);
            k := k + 1;
          end;
        end;
      end;
      if ok then
      begin
        Guard.Lock;
        st := StateOf(g);
        Reply(C, 'stopped g' + IntToStr(g) + ' at ' + WhereText(st));
        Guard.Unlock;
        Reply(C, 'ok');
      end
      else
        Reply(C, 'error: nothing stopped in ' + IntToStr(n) + ' ms');
    end
    else if cmd = 'where' then
    begin
      g := GArg(a);
      Guard.Lock;
      if TryGet(States, g, st) and st^.Stopped then
      begin
        Frames(C, st, -1, n, f);
        Guard.Unlock;
        Reply(C, 'ok');
      end
      else
      begin
        Guard.Unlock;
        Reply(C, 'error: g' + IntToStr(g) + ' is not stopped');
      end;
    end
    else if cmd = 'vars' then
    begin
      g := GArg(a);
      Guard.Lock;
      if TryGet(States, g, st) and st^.Stopped then
      begin
        Vars(C, st, IntArg(b, 0));
        Guard.Unlock;
      end
      else
      begin
        Guard.Unlock;
        Reply(C, 'error: g' + IntToStr(g) + ' is not stopped');
      end;
    end
    else if cmd = 'globals' then
    begin
      for k := 0 to High(Globals) do
        Reply(C, Globals[k].Name + ' = ' + ValueText(Globals[k].Addr, Globals[k].Code, Globals[k].Size));
      Reply(C, 'ok');
    end
    else if cmd = 'functions' then
    begin
      for k := 0 to High(Fns) do
        Reply(C, Fns[k].Name + ' ' + BaseName(Fns[k].Src) + ':' + IntToStr(Fns[k].Line));
      Reply(C, 'ok');
    end
    else if cmd = 'break' then
    begin
      if a = '' then
        Reply(C, 'error: break line | break file:line | break routine')
      else
      begin
        k := 0;
        for n := 1 to Length(a) do
          if a[n] = ':' then
            k := n;
        f := -1;
        if (k = 0) and (IntArg(a, 0) <= 0) then
        begin
          f := FnByName(a);
          if f < 0 then
          begin
            Reply(C, 'error: no routine ' + a);
            Continue;
          end;
        end;
        BreakNum := BreakNum + 1;
        SetLength(Breaks, Length(Breaks) + 1);
        Breaks[High(Breaks)].Num := BreakNum;
        Breaks[High(Breaks)].Src := '';
        Breaks[High(Breaks)].Line := 0;
        Breaks[High(Breaks)].Fn := 0;
        Breaks[High(Breaks)].Text := a;
        if k > 0 then
        begin
          Breaks[High(Breaks)].Src := Copy(a, 1, k - 1);
          Breaks[High(Breaks)].Line := IntArg(Copy(a, k + 1, Length(a) - k), 0);
        end
        else if f >= 0 then
          Breaks[High(Breaks)].Fn := Fns[f].Start
        else
          Breaks[High(Breaks)].Line := IntArg(a, 0);
        Reply(C, 'break ' + IntToStr(BreakNum) + ' at ' + a);
        Reply(C, 'ok');
      end;
    end
    else if cmd = 'breaks' then
    begin
      for k := 0 to High(Breaks) do
        Reply(C, 'break ' + IntToStr(Breaks[k].Num) + ' at ' + Breaks[k].Text);
      Reply(C, 'ok');
    end
    else if cmd = 'delete' then
    begin
      n := IntArg(a, -1);
      ok := False;
      for k := 0 to High(Breaks) do
        if Breaks[k].Num = n then
        begin
          Breaks[k] := Breaks[High(Breaks)];
          SetLength(Breaks, Length(Breaks) - 1);
          ok := True;
          Break;
        end;
      if ok then
        Reply(C, 'ok')
      else
        Reply(C, 'error: no break ' + a);
    end
    else if cmd = 'continue' then
      Resume(C, a, 0)
    else if cmd = 'step' then
      Resume(C, a, 1)
    else if cmd = 'next' then
      Resume(C, a, 2)
    else if cmd = 'stop' then
    begin
      Guard.Lock;
      if a = '' then
        PauseAll := True
      else
        StateOf(GArg(a))^.Freeze := True;
      Guard.Unlock;
      Reply(C, 'ok');
    end
    else if cmd = 'run' then
      RunAgain(C, Copy(line, 4, Length(line) - 3))
    else if cmd = 'quit' then
    begin
      Reply(C, 'ok');
      Break;
    end
    else
      Reply(C, 'error: unknown command ' + cmd + ' (help)');
  end;
  TcpClose(C);
  ResumeAll;
end;

{ The serving routine is not one the program waits for: when the main
  routine ends, the runtime waits until the live count is one (rt_nlive,
  rt_waitall), and a routine parked in accept for ever would keep the
  program from ending. It leaves the count as if it had ended. }
procedure Daemon;
begin
  asm amd64
    lock decq rt_nlive(%rip)
  end;
  asm arm64
    adrp x9, rt_nlive
    add x9, x9, :lo12:rt_nlive
  1:
    ldaxr x10, [x9]
    sub x10, x10, #1
    stlxr w11, x10, [x9]
    cbnz w11, 1b
  end;
end;

procedure Serve(L: Integer);
var
  c: Integer;
begin
  Daemon;
  while True do
  begin
    c := UnixAccept(L);
    if c < 0 then
      Break;
    Armed := True;
    Session(c);
  end;
end;

procedure PasDebugStart(HeapState, Tables, TablesEnd: Pointer);
var
  l: Integer;
begin
  HeapAddr := Integer(HeapState);
  SockPath := GetEnv('PASLANG_DEBUG');
  if SockPath = '' then
    Exit;
  ReadTables(Tables, TablesEnd);
  New(States);
  Stops := MakeChan(1024);
  l := UnixListen(SockPath);
  if l < 0 then
  begin
    WriteLn(ErrOutput, 'paslang: -debug cannot listen at ', SockPath);
    Exit;
  end;
  pas Serve(l);
end;

end.
