{ Core sync. mutex, rwmutex, waitgroup, cond and once are language
  types whose zero value is ready to use; a local or a global of these
  types needs no constructor. Waiting parks the G: there is no second
  scheduler and no OS thread is blocked. The compiler turns mu.Lock,
  wg.Add(n), c.Wait(mu), lock ... do and once ... do into calls of the
  routines below; user code never names them. }
unit pasroutines;

interface

type
  { Go's sync.Mutex (P98). State: bit 0 locked, bit 1 a waiter is awake
    (Unlock need not wake another), bit 2 starving (the mutex goes from
    hand to hand in queue order), and the number of parked routines from
    bit 3. Parking takes no lock: a new waiter pushes itself on Arrived
    with one CAS, and the one routine that may take waiters out (the
    holder of the awake bit, or the owner while starving) serves them
    from its own queue, Head to Tail, refilled from Arrived in arrival
    order. A woken waiter that lost the race goes back to the front. }
  TPasMutex = record
    State: Integer;
    Arrived: Integer;
    Head: Integer;
    Tail: Integer;
  end;

  { Go's sync.RWMutex (rwmutex.go), P246: writer preferred, once a writer
    waits new readers wait too, so a stream of readers cannot starve it.
    RC is the readers in, less 2^30 while a writer is waiting or in; RWait
    the readers a waiting writer still waits for; W keeps writers from each
    other. Readers and the writer park on a semaphore each (a count of
    permits and a queue under Spin), a permit handed to the routine that
    is woken. A reader that finds no writer is one atomic add. }
  TPasRWMutex = record
    W: TPasMutex;
    Spin: Integer;
    RC: Integer;
    RWait: Integer;
    RSem: Integer;
    WSem: Integer;
    ReadQ: Integer;
    WriteQ: Integer;
  end;

  TPasWaitGroup = record
    Count: Integer;
    Spin: Integer;
    Head: Integer;
  end;

  TPasCond = record
    Waited: Integer;
    Notified: Integer;
    Spin: Integer;
    Head, Tail: Integer;
  end;

  { Fired, not Done: a field named Done hid the Boolean init.Done, so not
    init.Done flipped the bits of the Integer (1.0.74). }
  TPasOnce = record
    Fired: Integer;
    Running: Integer;
    Spin: Integer;
    Head: Integer;
  end;

procedure PasMutexLock(var M: TPasMutex);
procedure PasMutexUnlock(var M: TPasMutex);
function PasMutexTryLock(var M: TPasMutex): Boolean;
procedure PasRWLock(var R: TPasRWMutex);
procedure PasRWUnlock(var R: TPasRWMutex);
procedure PasRWBeginRead(var R: TPasRWMutex);
procedure PasRWEndRead(var R: TPasRWMutex);
procedure PasWaitGroupAdd(var W: TPasWaitGroup; Delta: Integer);
procedure PasWaitGroupDone(var W: TPasWaitGroup);
procedure PasWaitGroupWait(var W: TPasWaitGroup);
procedure PasCondWait(var C: TPasCond; var M: TPasMutex);
procedure PasCondSignal(var C: TPasCond);
procedure PasCondBroadcast(var C: TPasCond);
function PasOnceBegin(var O: TPasOnce): Boolean;
procedure PasOnceEnd(var O: TPasOnce);
function PasOnceDone(var O: TPasOnce): Boolean;
function Goid: Integer;
function NumGoroutine: Integer;
procedure Yield;
{ Pair in a try/finally. The saved setting belongs to the current
  pasroutine. The linked arm64 program selects DIT with -cpu. }
function PasDitEnter: Boolean;
procedure PasDitLeave(Previous: Boolean);
procedure PasReadLn(Dest: Pointer);
procedure PasReadLnFed(var Line: string; var Fed: Boolean);
function PasEof: Boolean;

{ The one loop of a transfer that parks (P199). After a system call on a
  descriptor answers Answer, PasIoRetry says whether to make the call
  again: on EINTR at once, on EAGAIN once the routine has parked until
  the descriptor is ready (Ev 1 to read, 4 to write) or until Deadline,
  a Nanotime, passes (0 is no deadline). A failed wait puts its -errno
  in Answer, a deadline that passed -110 (ETIMEDOUT). PasIoDeadline is
  the deadline Ms milliseconds from now. PasIoRead and PasIoWrite are
  one transfer each through it; NetRead and NetWrite are PasNetRead and
  PasNetWrite. PasConnect makes a connection on a socket that does not
  block, waiting as Go's netFD.connect does (P216); NetConnect is
  PasNetConnect. }
function PasIoRetry(var Answer: Integer; Fd, Ev, Deadline: Integer): Boolean;
function PasIoDeadline(Ms: Integer): Integer;
function PasIoRead(Fd: Integer; Buf: Pointer; N, Deadline: Integer): Integer;
function PasIoWrite(Fd: Integer; Buf: Pointer; N, Deadline: Integer): Integer;
procedure PasNetRead(Fd, MaxN: Integer; Dest: Pointer);
function PasNetWrite(Fd: Integer; P: Pointer; N: Integer): Integer;
function PasConnect(Fd: Integer; Sa: Pointer; Size, Deadline: Integer): Integer;
function PasNetConnect(Ip, Port: Integer): Integer;

{$if PASLANG_FULLVERSION >= 1003055}
{ The waits on a descriptor and its close (P441). WaitFd, WaitIo and
  WaitMs are PasWaitIo and PasWaitMs, NetAccept is PasNetAccept: every
  wait goes through the record of its descriptor. A close of the
  descriptor, by NetClose or by Syscall, wakes every routine waiting on
  it, which answers -9 (EBADF). A new wait that encounters a close in
  progress waits for it to finish. The runtime calls PasPollClosing
  before the close and PasPollClosed after it. Any number of routines may wait on
  one descriptor, for one direction or both: each is served.
  PasWaitSet parks on Ep, an epoll set of the caller's that holds Fds,
  until Ep can be read or Ms milliseconds pass (0 or less does not
  wait): 0, a negative errno when the wait could not be registered, or
  -9 when one of Fds was closed meanwhile; it is WaitAny's wait. }
function PasWaitIo(Fd, Ev: Integer): Integer;
function PasWaitMs(Fd, Ev, Ms: Integer): Integer;
function PasNetAccept(Fd: Integer): Integer;
procedure PasPollClosing(Fd: Integer);
procedure PasPollClosed(Fd: Integer);
function PasWaitSet(Ep: Integer; const Fds: array of Integer; Ms: Integer): Integer;
{ Set up each epoll member together with the watcher for its close. }
function PasWaitEvents(Ep: Integer; const Fds: array of Integer; Ev, Ms: Integer): Integer;
{$endif}

implementation

function PasDitEnter: Boolean;
begin
{$ifdef CPUAARCH64}
{$if PASLANG_FULLVERSION >= 1003080}
  asm arm64 (Result: out x0)
    bl rt_dit_enter
  end;
{$else}
  Result := False;
{$endif}
{$else}
  Result := False;
{$endif}
end;

procedure PasDitLeave(Previous: Boolean);
begin
{$ifdef CPUAARCH64}
{$if PASLANG_FULLVERSION >= 1003080}
  asm arm64 (Previous: in x0)
    bl rt_dit_leave
  end;
{$endif}
{$endif}
end;

{ A failure the unit reports itself: a waitgroup counted below zero, as Go panics on a
  negative WaitGroup counter (sync/waitgroup.go), and the misuse of a
  mutex, which is fatal in Go too (internal/sync/mutex.go: unlock of
  unlocked mutex). The runtime takes it
  (rt_libfault, P569): the failure is the program's, whose call entered
  the library, so the line it writes ends with that call's place, and
  with a Kind, one of SysFault's, the failure is raised there when a try
  stands on the program's way and SysUtils is in it. Kind 0 ends the
  program whatever stands around it. A compiler before this one has no
  rt_libfault, so the first stage of a build from it writes the line
  and stops, as every stage did. }
{$if PASLANG_FULLVERSION >= 1002387}
procedure Fatal(Kind: Int64; const Msg: string);
var
  p: Pointer;
  n: Int64;
begin
  p := @Msg[1];
  n := Length(Msg);
  asm amd64 (p: in rdi; n: in rsi; Kind: in rdx)
    call rt_libfault
  end;
  asm arm64 (p: in x0; n: in x1; Kind: in x2)
    bl rt_libfault
  end;
end;
{$else}
procedure Fatal(Kind: Int64; const Msg: string);
begin
  WriteLn(ErrOutput, Msg);
  Halt(1);
end;
{$endif}

{ ---- mutex ---- }

{ The slow path of Lock, Go's lockSlow. A waiter spins while the holder
  runs, a few rounds and only when CanSpin says the time is not taken
  from other routines; otherwise it counts itself in State and parks.
  WaitPush does the count and the push in one primitive, with no place
  to be preempted between them, so the Unlock that sees the count finds
  the routine queued at once or a few instructions later (Go's
  semaphore count does that job there). A woken waiter that lost the
  race still holds the awake bit, so the queue is its own: WaitFront
  puts it back at the front and then counts it. A lock here, taken by
  every waiter, was where b3spawn spent its time (P98). A routine that
  waited more than a millisecond turns the mutex to starvation mode,
  where Unlock hands it straight to the first in the queue and a
  newcomer queues instead of taking it; the last waiter, or one that
  waited less, turns it back. The clock is read once before the first
  park and, after a wake, only while not starving yet. }
procedure MutexLockSlow(var M: TPasMutex);
var
  wait0, t, old, nw, iter, j: Integer;
  starving, awoke, queued: Boolean;
begin
  wait0 := 0;
  t := 0;
  starving := False;
  awoke := False;
  iter := 0;
  old := M.State;
  while True do
  begin
    if ((old and 5) = 1) and (iter < 4) and CanSpin then
    begin
      { Tell Unlock that a waiter is awake, so it wakes no other. }
      if (not awoke) and ((old and 2) = 0) and ((old shr 3) <> 0) and
        AtomicCas(@M.State, old, old or 2) then
        awoke := True;
      for j := 1 to 30 do
        Pause;
      iter := iter + 1;
      old := M.State;
      Continue;
    end;
    nw := old;
    if (old and 4) = 0 then
      nw := nw or 1;
    if (old and 5) <> 0 then
      nw := nw + 8;
    if starving and ((old and 1) <> 0) then
      nw := nw or 4;
    if awoke then
    begin
      if (nw and 2) = 0 then
        Fatal(0, 'paslang: inconsistent mutex state');
      nw := nw and (-3);
    end;
    if (old and 5) = 0 then
    begin
      { Free and not starving: this CAS takes it. }
      if AtomicCas(@M.State, old, nw) then
        Exit;
      old := M.State;
      Continue;
    end;
    if (wait0 = 0) and (t = 0) then
      t := Nanotime;
    if wait0 = 0 then
      queued := WaitPush(@M.State, old, nw, @M.Arrived)
    else
      queued := WaitFront(@M.State, old, nw, @M.Head);
    if not queued then
    begin
      old := M.State;
      Continue;
    end;
    if wait0 = 0 then
      wait0 := t;
    ParkMarked;
    if not starving then
      starving := Nanotime - wait0 > 1000000;
    old := M.State;
    if (old and 4) <> 0 then
    begin
      { Handed over in starvation mode: the locked bit is not set yet
        and this routine still counts as a waiter. }
      if ((old and 3) <> 0) or ((old shr 3) = 0) then
        Fatal(0, 'paslang: inconsistent mutex state');
      nw := 1 - 8;
      if (not starving) or ((old shr 3) = 1) then
        nw := nw - 4;
      AtomicAdd(@M.State, nw);
      Exit;
    end;
    awoke := True;
    iter := 0;
  end;
end;

procedure PasMutexLock(var M: TPasMutex);
begin
  if AtomicCas(@M.State, 0, 1) then
    Exit;
  MutexLockSlow(M);
end;

{ The slow path of Unlock, Go's unlockSlow: wake one waiter, unless none
  is parked or one is already awake or the mutex was taken meanwhile; in
  starvation mode hand it to the first waiter and yield (Go's handoff). }
procedure MutexUnlockSlow(var M: TPasMutex; nw: Integer);
var
  old, g: Integer;
  starve: Boolean;
begin
  if ((nw + 1) and 1) = 0 then
    Fatal(0, 'paslang: unlock of an unlocked mutex');
  starve := (nw and 4) <> 0;
  if not starve then
  begin
    old := nw;
    while True do
    begin
      if ((old shr 3) = 0) or ((old and 7) <> 0) then
        Exit;
      if AtomicCas(@M.State, old, (old - 8) or 2) then
        Break;
      old := M.State;
    end;
  end;
  { A waiter that counted itself may still be pushing itself. }
  g := WaitTake(@M.Arrived, @M.Head);
  while g = 0 do
  begin
    Pause;
    g := WaitTake(@M.Arrived, @M.Head);
  end;
  ReadyG(g);
  { Starving: the waiter owns the mutex now and runs next, on this M,
    while this routine waits at the tail of the queue (Go's handoff). }
  if starve then
    Goyield;
end;

procedure PasMutexUnlock(var M: TPasMutex);
var
  nw: Integer;
begin
  nw := AtomicAdd(@M.State, -1);
  if nw <> 0 then
    MutexUnlockSlow(M, nw);
end;

{ Go's TryLock: a free mutex is taken even with waiters parked, unless
  it is starving. }
function PasMutexTryLock(var M: TPasMutex): Boolean;
var
  old: Integer;
begin
  Result := False;
  old := M.State;
  if (old and 5) <> 0 then
    Exit;
  Result := AtomicCas(@M.State, old, old or 1);
end;

{ ---- rwmutex ---- }

const
  RWMaxReaders = 1073741824;

{ Go's runtime_SemacquireRWMutexR: a permit if there is one, else parked
  until a release hands it over. }
procedure RWReadAcquire(var R: TPasRWMutex);
begin
  SpinLock(@R.Spin);
  if R.RSem > 0 then
  begin
    R.RSem := R.RSem - 1;
    SpinUnlock(@R.Spin);
    Exit;
  end;
  QWait(@R.ReadQ);
  ParkUnlock(@R.Spin);
end;

procedure RWReadRelease(var R: TPasRWMutex);
var
  g: Integer;
begin
  SpinLock(@R.Spin);
  g := QWake1(@R.ReadQ);
  if g = 0 then
    R.RSem := R.RSem + 1;
  SpinUnlock(@R.Spin);
  if g <> 0 then
    ReadyG(g);
end;

procedure RWWriteAcquire(var R: TPasRWMutex);
begin
  SpinLock(@R.Spin);
  if R.WSem > 0 then
  begin
    R.WSem := R.WSem - 1;
    SpinUnlock(@R.Spin);
    Exit;
  end;
  QWait(@R.WriteQ);
  ParkUnlock(@R.Spin);
end;

procedure RWWriteRelease(var R: TPasRWMutex);
var
  g: Integer;
begin
  SpinLock(@R.Spin);
  g := QWake1(@R.WriteQ);
  if g = 0 then
    R.WSem := R.WSem + 1;
  SpinUnlock(@R.Spin);
  if g <> 0 then
    ReadyG(g);
end;

procedure PasRWBeginRead(var R: TPasRWMutex);
begin
  if AtomicAdd(@R.RC, 1) < 0 then
    RWReadAcquire(R);
end;

procedure PasRWEndRead(var R: TPasRWMutex);
var
  r1: Integer;
begin
  r1 := AtomicAdd(@R.RC, -1);
  if r1 < 0 then
  begin
    if (r1 + 1 = 0) or (r1 + 1 = -RWMaxReaders) then
      Fatal(0, 'paslang: unlock read of an unlocked rwmutex');
    if AtomicAdd(@R.RWait, -1) = 0 then
      RWWriteRelease(R);
  end;
end;

procedure PasRWLock(var R: TPasRWMutex);
var
  r1: Integer;
begin
  PasMutexLock(R.W);
  r1 := AtomicAdd(@R.RC, -RWMaxReaders) + RWMaxReaders;
  if (r1 <> 0) and (AtomicAdd(@R.RWait, r1) <> 0) then
    RWWriteAcquire(R);
end;

procedure PasRWUnlock(var R: TPasRWMutex);
var
  r1, i: Integer;
begin
  r1 := AtomicAdd(@R.RC, RWMaxReaders);
  if r1 >= RWMaxReaders then
    Fatal(0, 'paslang: unlock of an unlocked rwmutex');
  for i := 1 to r1 do
    RWReadRelease(R);
  PasMutexUnlock(R.W);
end;

{ ---- waitgroup ---- }

procedure PasWaitGroupAdd(var W: TPasWaitGroup; Delta: Integer);
var
  g, n: Integer;
begin
  { The count moves with one atomic add, as Go's WaitGroup does; the
    lock is taken only by the call that brings it to zero, to wake the
    waiters, and by Wait (P98). That call wakes only while the count is
    still zero (P585): the add and the lock are two steps, and a routine
    may be stopped between them, by the collector, by the scheduler or
    by the lock itself when a Wait holds it. A routine that found the
    count at zero without parking has by then gone on, and a waitgroup
    is used again with a new Add: the late call found that routine
    parked in the next Wait and woke it with routines still to come.
    Under the lock a count of zero says that everyone in the queue may
    go, since Wait queues itself under the same lock and only with a
    count that is not zero; a count that has left zero again says that
    the queue is the next use's, whose own last Done will wake it. Go's
    WaitGroup keeps the number of waiters in the word of the count, and
    the Add that reaches zero learns both with one operation
    (sync/waitgroup.go). }
  n := AtomicAdd(@W.Count, Delta);
  if n < 0 then
    Fatal(17, 'paslang: negative waitgroup counter');
  if n <> 0 then
    Exit;
  SpinLock(@W.Spin);
  if AtomicAdd(@W.Count, 0) = 0 then
  begin
    g := QWake1(@W.Head);
    while g <> 0 do
    begin
      ReadyG(g);
      g := QWake1(@W.Head);
    end;
  end;
  SpinUnlock(@W.Spin);
end;

procedure PasWaitGroupDone(var W: TPasWaitGroup);
begin
  PasWaitGroupAdd(W, -1);
end;

procedure PasWaitGroupWait(var W: TPasWaitGroup);
begin
  if AtomicAdd(@W.Count, 0) = 0 then
    Exit;
  SpinLock(@W.Spin);
  if AtomicAdd(@W.Count, 0) = 0 then
  begin
    SpinUnlock(@W.Spin);
    Exit;
  end;
  QWait(@W.Head);
  ParkUnlock(@W.Spin);
end;

{ ---- cond ---- }

const
  CondTicketMask = High(Integer);
  CondTicketHalf = 4611686018427387904;
  { A G can wait on a cond or in the poller. Poll generations at G+192
    are positive and at most 65536. A cond ticket uses the sign bit, so
    even a stale poll event cannot claim it. The sync queue links at
    G+232 are the same ones QWaitBack and QWake1 use. }
  GWaitToken = 192;
  GSyncNext = 232;

{ Go sync.Cond.Wait and runtime/sema.go's notifyList reserve a ticket
  before dropping the caller's mutex. The queue lock is taken after
  the unlock. An earlier notification advances the ticket and this
  routine skips the park. The counters are modulo 2^63. A difference
  with bit 62 set is behind the notification counter. }
procedure PasCondWait(var C: TPasCond; var M: TPasMutex);
var
  ticket: Integer;
begin
  ticket := ((AtomicAdd(@C.Waited, 1) and CondTicketMask) - 1) and CondTicketMask;
  PasMutexUnlock(M);
  SpinLock(@C.Spin);
  if ((ticket - C.Notified) and CondTicketHalf) <> 0 then
    SpinUnlock(@C.Spin)
  else
  begin
    QWaitBack(@C.Head);
    AtomicStore(PInt64(Pointer(C.Tail + GWaitToken))^, ticket or Low(Integer));
    ParkUnlock(@C.Spin);
  end;
  PasMutexLock(M);
end;

procedure PasCondSignal(var C: TPasCond);
var
  g, prev, ticket, tagged: Integer;
  link: PInt64;
begin
  if (AtomicLoad(C.Waited) and CondTicketMask) = AtomicLoad(C.Notified) then
    Exit;
  SpinLock(@C.Spin);
  ticket := C.Notified;
  if (AtomicLoad(C.Waited) and CondTicketMask) = ticket then
  begin
    SpinUnlock(@C.Spin);
    Exit;
  end;
  { Modulo 2^63, subtracting the mask advances one without overflow. }
  AtomicStore(C.Notified, (ticket - CondTicketMask) and CondTicketMask);
  tagged := ticket or Low(Integer);
  prev := 0;
  link := @C.Head;
  g := link^;
  while g <> 0 do
  begin
    if AtomicLoad(PInt64(Pointer(g + GWaitToken))^) = tagged then
    begin
      link^ := PInt64(Pointer(g + GSyncNext))^;
      if C.Tail = g then
        C.Tail := prev;
      PInt64(Pointer(g + GSyncNext))^ := 0;
      AtomicStore(PInt64(Pointer(g + GWaitToken))^, 0);
      Break;
    end;
    prev := g;
    link := PInt64(Pointer(g + GSyncNext));
    g := link^;
  end;
  SpinUnlock(@C.Spin);
  if g <> 0 then
    ReadyG(g);
end;

procedure PasCondBroadcast(var C: TPasCond);
var
  head, g: Integer;
begin
  if (AtomicLoad(C.Waited) and CondTicketMask) = AtomicLoad(C.Notified) then
    Exit;
  SpinLock(@C.Spin);
  head := C.Head;
  C.Head := 0;
  C.Tail := 0;
  AtomicStore(C.Notified, AtomicLoad(C.Waited) and CondTicketMask);
  SpinUnlock(@C.Spin);
  g := QWake1(@head);
  while g <> 0 do
  begin
    AtomicStore(PInt64(Pointer(g + GWaitToken))^, 0);
    ReadyG(g);
    g := QWake1(@head);
  end;
end;

{ ---- once ---- }

{ True for the routine that must run the block. Every other routine
  waits until that block has finished and then gets False. }
function OnceBeginSlow(var O: TPasOnce): Boolean;
begin
  Result := False;
  SpinLock(@O.Spin);
  if O.Fired <> 0 then
  begin
    SpinUnlock(@O.Spin);
    Exit;
  end;
  if O.Running <> 0 then
  begin
    QWait(@O.Head);
    ParkUnlock(@O.Spin);
    Exit;
  end;
  O.Running := 1;
  SpinUnlock(@O.Spin);
  Result := True;
end;

{ The fast path alone, small enough to be put in place at every once ... do:
  a once that has run is one load and a compare. }
function PasOnceBegin(var O: TPasOnce): Boolean;
begin
  if O.Fired <> 0 then
    Result := False
  else
    Result := OnceBeginSlow(O);
end;

procedure PasOnceEnd(var O: TPasOnce);
var
  g: Integer;
begin
  SpinLock(@O.Spin);
  O.Fired := 1;
  O.Running := 0;
  g := QWake1(@O.Head);
  while g <> 0 do
  begin
    ReadyG(g);
    g := QWake1(@O.Head);
  end;
  SpinUnlock(@O.Spin);
end;

function PasOnceDone(var O: TPasOnce): Boolean;
begin
  Result := O.Fired <> 0;
end;

{ ---- the scheduler seen from a routine ---- }

function Goid: Integer;
begin
  Result := GId;
end;

function NumGoroutine: Integer;
begin
  Result := GCount;
end;

procedure Yield;
begin
  Gosched;
end;

{ ---- ReadLn (1.0.57) ---- }

{ ReadLn reads standard input through one buffer that lives as long as
  the program, so the bytes after a line wait for the next ReadLn: each
  call had 256 bytes of its own, dropped whatever came after the first
  line and cut a longer line. A line ends at a line feed, which is not
  kept, or at the end of the input or an error. A routine waiting for
  input parks on the poller (PasIoRead, P199) and its M runs others;
  one routine reads at a time, the rest wait on InMu. The runtime's
  rt_readln jumps here with Dest, the string to fill. }
type
  PStr = ^string;

var
  InBuf: array[0..4095] of Char;
  InPos, InEnd: Integer;
  InMu: TPasMutex;

{ One line into Line; Fed says whether a line feed ended it, False when
  the end of the input or an error did (P665): Go's ReadString('\n')
  keeps the delimiter for the same reason, so that a copy can give back
  a last line that had none. }
procedure ReadLine(var Line: string; var Fed: Boolean);
var
  got: string;
  n, k, old: Integer;
  done: Boolean;
begin
  got := '';
  Fed := False;
  PasMutexLock(InMu);
  done := False;
  while not done do
    if InPos >= InEnd then
    begin
      n := PasIoRead(0, @InBuf[0], 4096, 0);
      if n > 0 then
      begin
        InPos := 0;
        InEnd := n;
      end
      else
        done := True;
    end
    else
    begin
      k := InPos;
      while (k < InEnd) and (InBuf[k] <> #10) do
        k := k + 1;
      if k > InPos then
      begin
        old := Length(got);
        SetLength(got, old + k - InPos);
        Move(InBuf[InPos], got[old + 1], k - InPos);
      end;
      if k < InEnd then
      begin
        InPos := k + 1;
        Fed := True;
        done := True;
      end
      else
        InPos := InEnd;
    end;
  PasMutexUnlock(InMu);
  Line := got;
end;

procedure PasReadLn(Dest: Pointer);
var
  fed: Boolean;
begin
  ReadLine(PStr(Dest)^, fed);
end;

{ ReadLn(s, fed) }
procedure PasReadLnFed(var Line: string; var Fed: Boolean);
begin
  ReadLine(Line, Fed);
end;

{ Eof and Eof(Input) (P665): True when standard input has no octet
  left. ReadLn gives an empty string for an empty line and at the end
  alike, so a program could not tell them apart. As Free Pascal's Eof
  on a terminal or a pipe, it reads ahead when the buffer is empty,
  waiting for an octet or the end, into ReadLn's own buffer, so what it
  saw is the next ReadLn's; the wait parks on the poller as ReadLn's
  does, and the other routines run. A failed read is the end, as it is
  for ReadLn. }
function PasEof: Boolean;
var
  n: Integer;
begin
  PasMutexLock(InMu);
  if InPos >= InEnd then
  begin
    n := PasIoRead(0, @InBuf[0], 4096, 0);
    if n > 0 then
    begin
      InPos := 0;
      InEnd := n;
    end;
  end;
  Result := InPos >= InEnd;
  PasMutexUnlock(InMu);
end;

{ ---- I/O that parks (P199) ---- }

{ Every unit's read and write loop was its own copy: sysutils', ten in
  pasnet, ReadLn's here and NetRead's and NetWrite's in the runtime's
  assembler, and most of them read EINTR as the end of the stream or
  tried again after a wait that had failed, spinning. The policy is
  Go's (golang src/internal/poll/fd_unix.go: Read, Write, ReadMsg,
  WriteTo and WriteMsg, with ignoringEINTRIO): EINTR makes the call
  again; EAGAIN waits for the descriptor and makes it again, unless
  the wait fails. A descriptor epoll does not take (EPERM, a disk file)
  is one Go's poller never registered (src/os/file_unix.go newFile), so
  its EAGAIN is the answer; any other failed registration is returned,
  as WaitIo reports it (P180). A deadline makes the wait WaitMs, to the
  millisecond after it, and an EAGAIN past it the answer -110, Go's
  ErrDeadlineExceeded; the call is tried before the deadline is looked
  at. Waiting parks the routine: no M and no P is held, and a blocking
  descriptor blocks in the call with the P handed over (P178). }

const
  { Go's maxRW: at most 1 GiB a transfer, so a count never overflows a
    system call's answer and long reads stay aligned }
  MaxRW = 1073741824;

function PasIoRetry(var Answer: Integer; Fd, Ev, Deadline: Integer): Boolean;
var
  left, w: Integer;
begin
  Result := Answer = -4;
  if Answer <> -11 then
    Exit;
  if Deadline > 0 then
  begin
    left := Deadline - Nanotime;
    if left <= 0 then
    begin
      Answer := -110;
      Exit;
    end;
    w := WaitMs(Fd, Ev, left div 1000000 + 1);
  end
  else
    w := WaitIo(Fd, Ev);
  if w = -1 then
    Exit;
  if w < 0 then
  begin
    Answer := w;
    Exit;
  end;
  Result := True;
end;

{ The Nanotime Ms milliseconds from now: 0 or less is now, so a wait
  ends at once, and at most 2^40 ms, as WaitMs takes, so it neither
  overflows nor comes out 0, which is no deadline. }
function PasIoDeadline(Ms: Integer): Integer;
begin
  if Ms < 0 then
    Ms := 0;
  if Ms > 1099511627776 then
    Ms := 1099511627776;
  Result := Nanotime + Ms * 1000000;
end;

{ One read: the count, 0 at the end of the stream or for N of 0 or
  less (Go's Read returns at once for an empty buffer), or -errno. }
function PasIoRead(Fd: Integer; Buf: Pointer; N, Deadline: Integer): Integer;
var
  nr: Integer;
begin
  Result := 0;
  if N <= 0 then
    Exit;
  if N > MaxRW then
    N := MaxRW;
  if Amd64 = 1 then
    nr := 0
  else
    nr := 63;
  repeat
    Result := Syscall(nr, Fd, Buf, N);
  until not PasIoRetry(Result, Fd, 1, Deadline);
end;

{ One write: the count, which may be short, 0 for N of 0 or less, or
  -errno. The caller writes the rest. }
function PasIoWrite(Fd: Integer; Buf: Pointer; N, Deadline: Integer): Integer;
var
  nr: Integer;
begin
  Result := 0;
  if N <= 0 then
    Exit;
  if N > MaxRW then
    N := MaxRW;
  if Amd64 = 1 then
    nr := 1
  else
    nr := 64;
  repeat
    Result := Syscall(nr, Fd, Buf, N);
  until not PasIoRetry(Result, Fd, 4, Deadline);
end;

{ NetRead(fd, max, s): the runtime's rt_tcpread jumps here. Up to MaxN
  bytes (1 to 65536) in the string at Dest, read into a block of MaxN
  and shortened by SetLength, which keeps that block while the read
  fills more than half of it and gives a shorter one a block of its
  own (P214, P222; before, this wrote the length word itself and kept
  the whole block for any read); the empty string at the end of the
  stream or on an error. }
procedure PasNetRead(Fd, MaxN: Integer; Dest: Pointer);
var
  n: Integer;
begin
  if MaxN < 1 then
    MaxN := 1;
  if MaxN > 65536 then
    MaxN := 65536;
  PStr(Dest)^ := '';
  SetLength(PStr(Dest)^, MaxN);
  n := PasIoRead(Fd, Pointer(PStr(Dest)^), MaxN, 0);
  if n > 0 then
    SetLength(PStr(Dest)^, n)
  else
    PStr(Dest)^ := '';
end;

{ NetWrite(fd, s): the runtime's rt_tcpwrite jumps here with the
  string's two words. All of it, parking while the socket is full: N,
  or -errno. A socket is asked for no SIGPIPE (MSG_NOSIGNAL, 1.1.1),
  so a peer that went away is EPIPE, as Go's net has it; a descriptor
  that is not a socket says ENOTSOCK to sendto and gets a plain write.
  A write that moves nothing ends with the count so far, where Go's
  Write ends with io.ErrUnexpectedEOF. }
function PasNetWrite(Fd: Integer; P: Pointer; N: Integer): Integer;
var
  r, want, nsend, nwrite: Integer;
begin
  if Amd64 = 1 then
  begin
    nsend := 44;
    nwrite := 1;
  end
  else
  begin
    nsend := 206;
    nwrite := 64;
  end;
  Result := 0;
  while Result < N do
  begin
    want := N - Result;
    if want > MaxRW then
      want := MaxRW;
    repeat
      r := Syscall(nsend, Fd, Integer(P) + Result, want, 16384, 0, 0);
      if r = -88 then
        r := Syscall(nwrite, Fd, Integer(P) + Result, want);
    until not PasIoRetry(r, Fd, 4, 0);
    if r < 0 then
    begin
      Result := r;
      Exit;
    end;
    if r = 0 then
      Exit;
    Result := Result + r;
  end;
end;

{ ---- connecting (P216) ---- }

{ A connection on Fd, a socket that does not block, to the sockaddr of
  Size bytes at Sa: 0 once it is made, else -errno; Deadline a Nanotime
  (0 none), past which the answer is -110, Go's ErrDeadlineExceeded.
  Go's netFD.connect (net/fd_unix.go): EINPROGRESS, EALREADY and EINTR
  from connect(2) say the connection is on its way, 0 and EISCONN that
  it is made, anything else is the answer. On its way, the routine
  parks until the socket can be written, and a failed wait is the
  answer; then SO_ERROR says how it went, since another connect call
  need not give an earlier error (Go issue 7474): EINPROGRESS, EALREADY
  and EINTR wait again, EISCONN is made, 0 is made once getpeername
  agrees, because the poller may wake a routine spuriously (Go issues
  14548 and 19289), and anything else is the answer. Before, NetConnect,
  TcpConnect6 and TcpConnectTo waited once, took SO_ERROR 0 for a
  connection and EINTR from connect for a failure. Errno values and
  call numbers from Go's syscall/zerrors_linux_*.go and
  zsysnum_linux_*.go, the same on both machines but the calls. }
function PasConnect(Fd: Integer; Sa: Pointer; Size, Deadline: Integer): Integer;
var
  nconnect, ngetsockopt, ngetpeername, err, olen, plen, left, w: Integer;
  peer: array[0..127] of Byte;
begin
  if Amd64 = 1 then
  begin
    nconnect := 42;
    ngetsockopt := 55;
    ngetpeername := 52;
  end
  else
  begin
    nconnect := 203;
    ngetsockopt := 209;
    ngetpeername := 205;
  end;
  Result := Syscall(nconnect, Fd, Sa, Size);
  if (Result = 0) or (Result = -106) then
  begin
    Result := 0;
    Exit;
  end;
  if (Result <> -115) and (Result <> -114) and (Result <> -4) then
    Exit;
  while True do
  begin
    if Deadline > 0 then
    begin
      left := Deadline - Nanotime;
      if left <= 0 then
      begin
        Result := -110;
        Exit;
      end;
      w := WaitMs(Fd, 4, left div 1000000 + 1);
    end
    else
      w := WaitIo(Fd, 4);
    if w < 0 then
    begin
      Result := w;
      Exit;
    end;
    err := 0;
    olen := 4;
    Result := Syscall(ngetsockopt, Fd, 1, 4, @err, @olen);
    if Result < 0 then
      Exit;
    if err = 106 then
    begin
      Result := 0;
      Exit;
    end;
    if err = 0 then
    begin
      plen := 128;
      if Syscall(ngetpeername, Fd, @peer, @plen) = 0 then
      begin
        Result := 0;
        Exit;
      end;
    end
    else if (err <> 115) and (err <> 114) and (err <> 4) then
    begin
      Result := -err;
      Exit;
    end;
  end;
end;

{ NetConnect(ip4, port): the runtime's rt_tcpconnect jumps here. A TCP
  socket that does not block and closes on exec, TCP_NODELAY set as Go
  sets it on every TCP connection, connected through PasConnect: its
  descriptor, or -1 with the socket closed. }
function PasNetConnect(Ip, Port: Integer): Integer;
var
  nsocket, nsetsockopt, nclose, fd, one, r: Integer;
  sa: array[0..15] of Byte;
  i: Integer;
begin
  if Amd64 = 1 then
  begin
    nsocket := 41;
    nsetsockopt := 54;
    nclose := 3;
  end
  else
  begin
    nsocket := 198;
    nsetsockopt := 208;
    nclose := 57;
  end;
  Result := -1;
  fd := Syscall(nsocket, 2, 526337, 0);
  if fd < 0 then
    Exit;
  one := 1;
  r := Syscall(nsetsockopt, fd, 6, 1, @one, 4);
  for i := 0 to 15 do
    sa[i] := 0;
  sa[0] := 2;
  sa[2] := Byte((Port shr 8) and 255);
  sa[3] := Byte(Port and 255);
  sa[4] := Byte((Ip shr 24) and 255);
  sa[5] := Byte((Ip shr 16) and 255);
  sa[6] := Byte((Ip shr 8) and 255);
  sa[7] := Byte(Ip and 255);
  if PasConnect(fd, @sa, 16, 0) <> 0 then
  begin
    r := Syscall(nclose, fd);
    Exit;
  end;
  Result := fd;
end;

{$if PASLANG_FULLVERSION >= 1003055}
{ ---- the waits on a descriptor, and its close (P441) ---- }

{ Go gives a descriptor one record for its life (runtime/netpoll.go
  pollDesc) with a slot for the routine that reads and one for the
  routine that writes, and its close evicts both before the descriptor
  goes (internal/poll/fd_poll_runtime.go evict; poll_runtime_pollUnblock
  sets closing and unblocks rg and wg), after fdMutex has refused every
  new operation (fd_mutex.go increfAndClose). There the record belongs
  to an object, poll.FD. A descriptor here is a number any routine may
  hand to a wait or to a close, so the record is found by the number,
  and its lock (Spin) orders the waits and the closes of that number:

  - A wait names itself in the record and parks with rt_pollpark, which
    lets the lock go only when the routine's token is armed and epoll
    holds its registration. A close (PasPollClosing, called by the
    runtime before every close it makes) takes the lock, adds one to
    Gen and takes the token of every waiter the record names. So a
    close comes whole before a wait or whole after its registration:
    the waiter is always woken, sees Gen changed, and answers EBADF
    without touching the descriptor again, whose number may be another
    file's by then.
  - Closing counts the closes of the number in flight, from the call
    before the close to the call after it (PasPollClosed). A wait that
    begins meanwhile waits for the close to end and then goes on: on a
    number that is closed, where epoll answers EBADF, or on the file
    that has the number now. Registered between the eviction and the
    close itself, it would be parked on a file gone a moment later.
  - Lead, for each direction (0 every wait but a wait to write alone,
    1 that one: the two sets of rt_pollpark), is the token of the
    routine registered with epoll, Ev0 the events of direction 0's, and
    Head the routines waiting their turn behind it. A registration
    holds one token, so a second wait for the same direction took the
    first one's place and the first was never woken (P668's report: two
    readers of one socket, two octets written, one read). The one that
    leaves, woken by the descriptor, by its deadline or by an error,
    wakes the first behind it, which registers itself: epoll_ctl reads
    the descriptor's readiness again (EPOLL_CTL_MOD), so what the first
    left is the second's. Go has one waiter a direction because
    poll.FD's mutex lets one routine at a time read; with a number and
    no object, the record is the queue.
  - A routine that finds another registered first makes sure it still
    is (PollProbe): a number closed where the runtime does not see it
    (dup2 over it, close_range, a close in assembly) takes the
    registration with it, and the routine named in the record would
    keep every later wait of that number behind it for ever.
  - Watch, the waits on several descriptors (PasWaitSet) this one is
    part of.

  The records are system pages that never go back (mmap), found through
  three levels by the descriptor's number, a page each, 32 records a
  page; the first 32 descriptors have theirs in the program's own data,
  so a small program maps nothing. They are not the collector's: a
  record names its waiters by token, and the nodes of Head and Watch
  belong to routines parked in the calls below, whose frames keep them
  alive until each has taken its node out, under the record's lock. No
  node is reached from a record after its routine has gone on. }

type
  PPollCell = ^TPollCell;
  TPollCell = record
    V: Integer;
  end;

  PPollNode = ^TPollNode;
  TPollNode = record
    Next: PPollNode;
    Token: Integer;
    Cell: PPollCell;
    Linked: Integer;
  end;

  PPollRec = ^TPollRec;
  TPollRec = record
    Spin: Integer;
    Gen: Integer;
    Closing: Integer;
    Lead: array[0..1] of Integer;
    Ev0: Integer;
    Head: array[0..1] of PPollNode;
    Watch: PPollNode;
    Spare: array[0..6] of Integer;
  end;

const
  { SizeOf(TPollRec): 32 of them a page }
  PollRecSize = 128;

var
  PollLeaf0: array[0..31] of TPollRec;
  PollTop: array[0..255] of Integer;
  PollTabLock: Integer;

{ The token this routine's next wait arms (rt_polltoken). }
function PollToken: Integer;
begin
  asm amd64 (Result: out rax)
    call rt_polltoken
  end;
  asm arm64 (Result: out x0)
    str x30, [sp, #-16]!
    bl rt_polltoken
    ldr x30, [sp], #16
  end;
end;

{ The routine of Token, when its wait is still armed, is made ready
  (rt_pollwake); a token whose wait has ended wakes nobody. }
procedure PollWake(Token: Integer);
begin
  asm amd64 (Token: in rdi)
    call rt_pollwake
  end;
  asm arm64 (Token: in x0)
    str x30, [sp, #-16]!
    bl rt_pollwake
    ldr x30, [sp], #16
  end;
end;

{ The park (rt_pollpark): on Fd for Ev, or on the token alone when Fd is
  negative, until Deadline, a Nanotime (-1 none), and not at all when
  the word at Cancel (nil: none) is not Expect once the token is armed.
  Held, a lock this routine holds (SpinLock) or nil, is let go once the
  token is armed and registered. 0 on a wake, -9 for a changed word,
  another negative errno when epoll refused the descriptor. }
function PollPark(Fd, Ev, Deadline: Integer; Cancel: Pointer; Expect: Integer; Held: Pointer): Integer;
begin
  asm amd64 (Fd: in rdi; Ev: in rsi; Deadline: in rdx; Cancel: in rcx; Expect: in r8; Held: in r9; Result: out rax)
    call rt_pollpark
  end;
  asm arm64 (Fd: in x0; Ev: in x1; Deadline: in x2; Cancel: in x3; Expect: in x4; Held: in x5; Result: out x0)
    str x30, [sp, #-16]!
    bl rt_pollpark
    ldr x30, [sp], #16
  end;
end;

{ The runtime's two epoll sets: the readers' and the writers'. }
function PollSetR: Integer;
begin
  asm amd64 (Result: out rax)
    movq rt_epfd(%rip), %rax
  end;
  asm arm64 (Result: out x0)
    adrp x0, rt_epfd
    ldr x0, [x0, :lo12:rt_epfd]
  end;
end;

function PollSetW: Integer;
begin
  asm amd64 (Result: out rax)
    movq rt_epfdw(%rip), %rax
  end;
  asm arm64 (Result: out x0)
    adrp x0, rt_epfdw
    ldr x0, [x0, :lo12:rt_epfdw]
  end;
end;

{ A page of zeros from the system (mmap: PROT_READ and PROT_WRITE,
  MAP_PRIVATE and MAP_ANONYMOUS), or 0. }
function PollPage: Integer;
begin
  if Amd64 = 1 then
    Result := Syscall(9, 0, 4096, 3, 34, -1, 0)
  else
    Result := Syscall(222, 0, 4096, 3, 34, -1, 0);
  if (Result < 0) and (Result > -4096) then
    Result := 0;
end;

{ The page the word at P names, mapped when it names none yet: 0 when
  the system gives no page. A page is published once and never taken
  back, and it is all zeros when its address is stored, so a reader
  needs no lock. }
function PollSlot(P: Integer): Integer;
begin
  Result := AtomicLoad(PInt64(Pointer(P))^);
  if Result <> 0 then
    Exit;
  SpinLock(@PollTabLock);
  Result := PInt64(Pointer(P))^;
  if Result = 0 then
  begin
    Result := PollPage;
    if Result <> 0 then
      AtomicStore(PInt64(Pointer(P))^, Result);
  end;
  SpinUnlock(@PollTabLock);
end;

{ The descriptor as the kernel reads it: an int, the low 32 bits of the
  word a system call is given (close(2) takes an unsigned int and
  epoll_ctl an int, and neither has a descriptor above 2^31 - 1), so a
  wait and a close of one number find one record whatever the word's
  high half held. -1 for a number no descriptor has. }
function PollFd(Fd: Integer): Integer;
begin
  Result := Fd and $FFFFFFFF;
  if Result > 2147483647 then
    Result := -1;
end;

{ The record of descriptor Fd, 0 to 2^31 - 1; nil when the system has
  no page for it. }
function PollRec(Fd: Integer): PPollRec;
var
  p: Integer;
begin
  if Fd < 32 then
  begin
    Result := @PollLeaf0[Fd];
    Exit;
  end;
  Result := nil;
  p := PollSlot(Integer(@PollTop[Fd shr 23]));
  if p = 0 then
    Exit;
  p := PollSlot(p + ((Fd shr 14) and 511) * 8);
  if p = 0 then
    Exit;
  p := PollSlot(p + ((Fd shr 5) and 511) * 8);
  if p = 0 then
    Exit;
  Result := PPollRec(Pointer(p + (Fd and 31) * PollRecSize));
end;

{ A routine that finds a close of its descriptor under way, or its turn
  not come, lets the others run: the first rounds by yielding, then by
  sleeping a millisecond a round, since a close may take its time. }
procedure PollYield(var Rounds: Integer);
begin
  Rounds := Rounds + 1;
  if Rounds < 64 then
    Gosched
  else
    Sleep(1);
end;

{ Node out of the list at Head, when it is in it. Under the record's
  lock. }
procedure PollUnlink(var Head: PPollNode; Node: PPollNode);
var
  q: PPollNode;
begin
  if Node^.Linked = 0 then
    Exit;
  Node^.Linked := 0;
  if Head = Node then
  begin
    Head := Node^.Next;
    Exit;
  end;
  q := Head;
  while (q <> nil) and (q^.Next <> Node) do
    q := q^.Next;
  if q <> nil then
    q^.Next := Node^.Next;
end;

{ The token of the first routine waiting its turn for direction D of R,
  taken out of the queue, or 0. Under the record's lock; the caller
  wakes it once the lock is dropped. }
function PollNext(R: PPollRec; D: Integer): Integer;
var
  n: PPollNode;
begin
  Result := 0;
  n := R^.Head[D];
  if n = nil then
    Exit;
  R^.Head[D] := n^.Next;
  n^.Linked := 0;
  Result := n^.Token;
end;

{ Is the routine R names for direction D of Fd still registered? Its
  registration is armed again as it was (EPOLL_CTL_MOD with its own
  events and token, which changes nothing it could tell): 0 when epoll
  still holds it, -2 (ENOENT) when the number is not in the set, so the
  file it was registered for is gone and the number is another's, -9
  when the number is not open at all. Under the record's lock; the
  event is amd64's packed twelve octets or arm64's sixteen. }
function PollProbe(R: PPollRec; Fd, D: Integer): Integer;
var
  evt: array[0..1] of Integer;
  mask, tok: Integer;
begin
  tok := R^.Lead[D];
  if D = 1 then
    mask := 4
  else
    mask := R^.Ev0 and $FFFFFFFF;
  mask := mask or $40000000;
  if Amd64 = 1 then
  begin
    evt[0] := mask or (tok shl 32);
    evt[1] := (tok shr 32) and $FFFFFFFF;
    if D = 1 then
      Result := Syscall(233, PollSetW, 3, Fd, @evt)
    else
      Result := Syscall(233, PollSetR, 3, Fd, @evt);
  end
  else
  begin
    evt[0] := mask;
    evt[1] := tok;
    if D = 1 then
      Result := Syscall(21, PollSetW, 3, Fd, @evt)
    else
      Result := Syscall(21, PollSetR, 3, Fd, @evt);
  end;
end;

{ One wait: Fd ready for Ev, Deadline (a Nanotime, -1 none) come, or
  the descriptor closed. }
function PollWait(Fd, Ev, Deadline: Integer): Integer;
var
  r: PPollRec;
  d, expect, tok, wake, rounds, pr: Integer;
  node, q: PPollNode;
  turn, haveGeneration: Boolean;
begin
  Fd := PollFd(Fd);
  if Fd < 0 then
  begin
    Result := -9;
    Exit;
  end;
  r := PollRec(Fd);
  if r = nil then
  begin
    Result := -12;
    Exit;
  end;
  if Ev = 4 then
    d := 1
  else
    d := 0;
  node := nil;
  rounds := 0;
  expect := 0;
  haveGeneration := False;
  while True do
  begin
    SpinLock(@r^.Spin);
    if haveGeneration and (r^.Gen <> expect) then
    begin
      SpinUnlock(@r^.Spin);
      Result := -9;
      Exit;
    end;
    if r^.Closing <> 0 then
    begin
      SpinUnlock(@r^.Spin);
      PollYield(rounds);
      Continue;
    end;
    { Keep the first generation when dropping the lock to allocate a
      node or when a queued routine is promoted. Linux can reuse the
      descriptor number before the routine gets its next turn. }
    expect := r^.Gen;
    haveGeneration := True;
    tok := PollToken;
    if r^.Lead[d] = 0 then
    begin
      { Nobody is registered for this direction: this routine is, and
        the park lets the lock go once epoll has it. }
      r^.Lead[d] := tok;
      if d = 0 then
        r^.Ev0 := Ev;
      Result := PollPark(Fd, Ev, Deadline, nil, 0, @r^.Spin);
      wake := 0;
      SpinLock(@r^.Spin);
      if r^.Gen <> expect then
        Result := -9
      else if r^.Lead[d] = tok then
      begin
        r^.Lead[d] := 0;
        wake := PollNext(r, d);
      end
      else if Result = 0 then
        { another routine found this one's registration gone
          (PollProbe) and took its place: the file it waited on is no
          more }
        Result := -9;
      SpinUnlock(@r^.Spin);
      if wake <> 0 then
        PollWake(wake);
      Exit;
    end;
    { Another routine is: wait for the turn, on the token alone. The
      node is made with no lock held, since making it may wait for the
      collector. }
    if node = nil then
    begin
      SpinUnlock(@r^.Spin);
      New(node);
      node^.Next := nil;
      node^.Token := 0;
      node^.Cell := nil;
      node^.Linked := 0;
      Continue;
    end;
    pr := PollProbe(r, Fd, d);
    if pr < 0 then
    begin
      wake := r^.Lead[d];
      r^.Lead[d] := 0;
      SpinUnlock(@r^.Spin);
      PollWake(wake);
      if pr <> -2 then
      begin
        Result := pr;
        Exit;
      end;
      Continue;
    end;
    node^.Token := tok;
    node^.Next := nil;
    node^.Linked := 1;
    q := r^.Head[d];
    if q = nil then
      r^.Head[d] := node
    else
    begin
      while q^.Next <> nil do
        q := q^.Next;
      q^.Next := node;
    end;
    Result := PollPark(-1, 0, Deadline, nil, 0, @r^.Spin);
    SpinLock(@r^.Spin);
    if r^.Gen <> expect then
    begin
      SpinUnlock(@r^.Spin);
      Result := -9;
      Exit;
    end;
    { Still in the queue: the deadline woke it. Out of it: the turn is
      this routine's. }
    turn := node^.Linked = 0;
    PollUnlink(r^.Head[d], node);
    SpinUnlock(@r^.Spin);
    if (Deadline >= 0) and (Nanotime >= Deadline) then
    begin
      { The deadline came: 0, the answer of a wait that ran out. A turn
        given to a routine that leaves goes on to the next. }
      if turn then
      begin
        wake := 0;
        SpinLock(@r^.Spin);
        if (r^.Gen = expect) and (r^.Lead[d] = 0) then
          wake := PollNext(r, d);
        SpinUnlock(@r^.Spin);
        if wake <> 0 then
          PollWake(wake);
      end;
      Result := 0;
      Exit;
    end;
  end;
end;

{ WaitFd and WaitIo: the runtime's rt_waitio jumps here. }
function PasWaitIo(Fd, Ev: Integer): Integer;
begin
  Result := PollWait(Fd, Ev, -1);
end;

{ WaitMs: the runtime's rt_waitms jumps here. At most 2^40 ms, so the
  deadline cannot overflow; 0 or less returns 0 at once, the answer of
  a deadline that came, as Go answers pollErrTimeout at once for a
  deadline already past (runtime/netpoll.go netpollcheckerr). }
function PasWaitMs(Fd, Ev, Ms: Integer): Integer;
begin
  Result := 0;
  if Ms <= 0 then
    Exit;
  if Ms > 1099511627776 then
    Ms := 1099511627776;
  Result := PollWait(Fd, Ev, Nanotime + Ms * 1000000);
end;

{ NetAccept: the runtime's rt_tcpaccept jumps here. The next connection
  of the listening socket Fd, a socket that does not block and closes
  on exec (accept4 with SOCK_NONBLOCK and SOCK_CLOEXEC), parking until
  one comes: its descriptor, or a negative errno from accept4 or from
  the wait, -9 when the listener was closed meanwhile. The loop is the
  one of every transfer (PasIoRetry), as Go's FD.Accept is
  (internal/poll/fd_unix.go). }
function PasNetAccept(Fd: Integer): Integer;
var
  nr: Integer;
begin
  if Amd64 = 1 then
    nr := 288
  else
    nr := 242;
  repeat
    Result := Syscall(nr, Fd, 0, 0, 526336);
  until not PasIoRetry(Result, Fd, 1, 0);
end;

{ Before a close of Fd: every routine waiting on it is woken with EBADF
  and no wait on it begins until PasPollClosed. The runtime calls it
  (rt_closeout through rt_gocall) with preemption off, so it neither
  parks nor makes anything: the tokens are taken under the record's
  lock, which is safe since waking takes the scheduler's locks and none
  of those is ever held while this one is taken. A watcher's cell is
  stored atomically before its token is taken: on amd64 no read passes
  a locked instruction (Intel SDM vol. 3A, 11.2.2) and on arm64 the
  load with acquire of rt_pollwake cannot come before a store with
  release (Arm ARM B2.6.10), while the watcher arms its token, with
  rt_pollarm's barrier, and then reads the cell. }
procedure PasPollClosing(Fd: Integer);
var
  r: PPollRec;
  n, nx: PPollNode;
  d, t: Integer;
begin
  Fd := PollFd(Fd);
  if Fd < 0 then
    Exit;
  r := PollRec(Fd);
  if r = nil then
    Exit;
  SpinLock(@r^.Spin);
  r^.Gen := r^.Gen + 1;
  r^.Closing := r^.Closing + 1;
  for d := 0 to 1 do
  begin
    t := r^.Lead[d];
    r^.Lead[d] := 0;
    if t <> 0 then
      PollWake(t);
    n := r^.Head[d];
    r^.Head[d] := nil;
    while n <> nil do
    begin
      nx := n^.Next;
      n^.Next := nil;
      n^.Linked := 0;
      PollWake(n^.Token);
      n := nx;
    end;
  end;
  n := r^.Watch;
  r^.Watch := nil;
  while n <> nil do
  begin
    nx := n^.Next;
    n^.Next := nil;
    n^.Linked := 0;
    AtomicStore(n^.Cell^.V, 1);
    PollWake(n^.Token);
    n := nx;
  end;
  SpinUnlock(@r^.Spin);
end;

{ After the close of Fd that PasPollClosing announced. }
procedure PasPollClosed(Fd: Integer);
var
  r: PPollRec;
begin
  Fd := PollFd(Fd);
  if Fd < 0 then
    Exit;
  r := PollRec(Fd);
  if r = nil then
    Exit;
  SpinLock(@r^.Spin);
  if r^.Closing > 0 then
    r^.Closing := r^.Closing - 1;
  SpinUnlock(@r^.Spin);
end;

{ WaitAny's wait: see the interface. The routine is named in the record
  of each of Fds, so a close of any of them takes its token; the cancel
  word is a cell of the collector's that every node names, since a
  routine's stack may move while it is parked. The set is the caller's
  alone, so nobody closes it under this wait and it needs no record. }
procedure PollAddMember(Ep, Fd, Ev, Index: Integer);
var
  evt: array[0..1] of Integer;
  ignored: Integer;
begin
  if Amd64 = 1 then
  begin
    { Linux's amd64 epoll_event is packed. }
    evt[0] := Ev or (Index shl 32);
    evt[1] := Index shr 32;
    ignored := Syscall(233, Ep, 1, Fd, @evt);
  end
  else
  begin
    evt[0] := Ev;
    evt[1] := Index;
    ignored := Syscall(21, Ep, 1, Fd, @evt);
  end;
end;

function PollWaitSet(Ep: Integer; const Fds: array of Integer; Ev, Ms: Integer;
                     AddMembers: Boolean): Integer;
var
  nodes: array of PPollNode;
  cell: PPollCell;
  r: PPollRec;
  i, n, tok, deadline, rounds: Integer;
  linked: Boolean;
begin
  Result := 0;
  if Ms <= 0 then
  begin
    if AddMembers then
      for i := 0 to High(Fds) do
        PollAddMember(Ep, Fds[i], Ev, i);
    Exit;
  end;
  if Ms > 1099511627776 then
    Ms := 1099511627776;
  n := Length(Fds);
  New(cell);
  cell^.V := 0;
  SetLength(nodes, n);
  for i := 0 to n - 1 do
  begin
    New(nodes[i]);
    nodes[i]^.Next := nil;
    nodes[i]^.Token := 0;
    nodes[i]^.Cell := cell;
    nodes[i]^.Linked := 0;
  end;
  { every record there is before the token is read: finding one may map
    a page, and nothing between the token and the park may arm another }
  for i := 0 to n - 1 do
    if (PollFd(Fds[i]) >= 0) and (PollRec(PollFd(Fds[i])) = nil) then
    begin
      Result := -12;
      Exit;
    end;
  deadline := Nanotime + Ms * 1000000;
  tok := PollToken;
  rounds := 0;
  for i := 0 to n - 1 do
    if PollFd(Fds[i]) >= 0 then
    begin
      r := PollRec(PollFd(Fds[i]));
      linked := False;
      repeat
        SpinLock(@r^.Spin);
        if r^.Closing = 0 then
        begin
          nodes[i]^.Token := tok;
          nodes[i]^.Next := r^.Watch;
          nodes[i]^.Linked := 1;
          r^.Watch := nodes[i];
          { Linux can silently remove the member on close. Arm the
            watcher and register the member under the same lock so
            a close can always cancel a registration that succeeded. }
          if AddMembers then
            PollAddMember(Ep, Fds[i], Ev, i);
          linked := True;
        end;
        SpinUnlock(@r^.Spin);
        if not linked then
          PollYield(rounds);
      until linked;
    end;
  Result := PollPark(Ep, 1, deadline, cell, 0, nil);
  for i := 0 to n - 1 do
    if nodes[i]^.Linked <> 0 then
    begin
      r := PollRec(PollFd(Fds[i]));
      SpinLock(@r^.Spin);
      PollUnlink(r^.Watch, nodes[i]);
      SpinUnlock(@r^.Spin);
    end;
  if AtomicLoad(cell^.V) <> 0 then
    Result := -9;
end;
function PasWaitSet(Ep: Integer; const Fds: array of Integer; Ms: Integer): Integer;
begin
  Result := PollWaitSet(Ep, Fds, 0, Ms, False);
end;

function PasWaitEvents(Ep: Integer; const Fds: array of Integer; Ev, Ms: Integer): Integer;
begin
  Result := PollWaitSet(Ep, Fds, Ev, Ms, True);
end;
{$endif}

end.
