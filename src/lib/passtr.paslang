    movzbl (%rdi,%rdx), %ecx
    subq %rcx, %rax
    jmp 9f
    32:
    testq %rbx, %rbx
    jle 9f
    33:
    movzbl (%rsi), %eax
    movzbl (%rdi), %ecx
    subq %rcx, %rax
    jnz 9f
    incq %rsi
    incq %rdi
    decq %rbx
    jnz 33b
    9:
  end;
  asm arm64 (A: in x0; B: in x1; N: in x2; Result: out x0)
    mov x3, x0
    mov x0, #0
