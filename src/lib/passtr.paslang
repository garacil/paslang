    pcmpeqb %xmm1, %xmm0
    pmovmskb %xmm0, %edx
    xorl $0xffff, %edx
    jz 9f
    26:
    bsfl %edx, %edx
    movzbl (%rsi,%rdx), %eax
    movzbl (%rdi,%rdx), %ecx
    subq %rcx, %rax
    jmp 9f
    30:
