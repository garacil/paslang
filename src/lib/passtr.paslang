    vmovdqu 32(%rsi), %ymm1
    vpcmpeqb (%rdi), %ymm0, %ymm0
    vpcmpeqb 32(%rdi), %ymm1, %ymm1
    vpand %ymm0, %ymm1, %ymm2
    vpmovmskb %ymm2, %edx
    cmpl $0xffffffff, %edx
    jne 2f
    addq $64, %rsi
    addq $64, %rdi
    subq $64, %rbx
    jmp 1b
    2:
    vpmovmskb %ymm0, %edx
    xorl $0xffffffff, %edx
    jnz 6f
    vpmovmskb %ymm1, %edx
    xorl $0xffffffff, %edx
    addq $32, %rsi
    addq $32, %rdi
    jmp 6f
    3:
    cmpq $32, %rbx
    jb 4f
    vmovdqu (%rsi), %ymm0
    vpcmpeqb (%rdi), %ymm0, %ymm0
    vpmovmskb %ymm0, %edx
    xorl $0xffffffff, %edx
    jnz 6f
