{$endif}

{ The base processor's: on amd64 the sequence the block before left
  open is finished from Prev, then Utf8ScanBase reads the rest; on
  arm64 NEON is the base, and the body is the one above. The same
  contract: the first block with an error, NBlocks when none, Prev the
  32 bytes before and after. }
function PasUtf8BlocksBase(P: Pointer; NBlocks: Int64; Prev: Pointer; IJson: Boolean): Int64;
{$ifdef CPUAARCH64}
begin
  Result := PasUtf8BlocksCpu(P, NBlocks, Prev, IJson);
end;
{$else}
var
  b, pv: PByte;
  n, i, k, l, need, pend, c, r: Int64;
  tmp: array[0..7] of Byte;
begin
  Result := NBlocks;
  if NBlocks <= 0 then
    Exit;
  b := PByte(P);
  pv := PByte(Prev);
  n := NBlocks * 64;
  { the open sequence: its lead among the last three bytes before }
  i := 0;
  k := 0;
  if pv[31] >= $C0 then
    k := 1
  else if (pv[30] >= $C0) and ((pv[31] and $C0) = $80) then
    k := 2
  else if (pv[29] >= $C0) and ((pv[30] and $C0) = $80) and ((pv[31] and $C0) = $80) then
    k := 3;
  if k > 0 then
  begin
    l := Utf8SeqLen(pv[32 - k]);
    if l > k then
    begin
      need := l - k;
      for c := 0 to k - 1 do
        tmp[c] := pv[32 - k + c];
      for c := 0 to need - 1 do
        tmp[k + c] := b[c];
      if (PasUtf8Plain(@tmp[0], l, IJson, pend) >= 0) or (pend > 0) then
      begin
        Result := 0;
        Exit;
      end;
      i := need;
    end;
  end;
  r := Utf8ScanBase(@b[i], n - i, IJson);
  if r >= 0 then
    Result := (i + r) shr 6
  else if r <= -2 then
  begin
    { the end cut a sequence: right so far, or wrong now }
    r := -r - 2;
    if PasUtf8Plain(@b[i + r], n - i - r, IJson, pend) >= 0 then
      Result := (i + r) shr 6;
  end;
  Move(b[n - 32], pv[0], 32);
end;
{$endif}

{ The first bad byte of P[0..N-1] at or after the block that starts at
  B, whose bytes before are right: the Plain body read from the start of
  the sequence that crosses B (its lead at most three bytes before, when
  it runs past B); a sequence the end cuts is the bad one there. }
function Utf8Locate(P: Pointer; N, B: Int64; IJson: Boolean): Int64;
var
  j, s, r, pend: Int64;
begin
  s := B;
  j := B - 1;
  while (j >= 0) and (j >= B - 3) and ((PByte(P)[j] and $C0) = $80) do
    j := j - 1;
  if (j >= 0) and (j >= B - 3) and (PByte(P)[j] >= $C0) and (j + Utf8SeqLen(PByte(P)[j]) > B) then
    s := j;
  r := PasUtf8Plain(@PByte(P)[s], N - s, IJson, pend);
  if r >= 0 then
    Result := s + r
  else if pend > 0 then
    Result := N - pend
  else
    Result := -1;
end;

{ The kernel of the processor the unit is compiled for (P148): AVX2's
  in the build for x86-64-v3 (P143), the base's in the base build. }
function Utf8Kernel(P: Pointer; NBlocks: Int64; Prev: Pointer; IJson: Boolean): Int64;
begin
{$ifdef CPU_AVX2}
  Result := PasUtf8BlocksCpu(P, NBlocks, Prev, IJson);
{$else}
  Result := PasUtf8BlocksBase(P, NBlocks, Prev, IJson);
{$endif}
end;

{ NBlocks blocks through the kernel in calls of at most Utf8MaxBlocks,
  Prev carried from one to the next (P269): an asm block is not
  preempted, and the code between two calls is where the routine can be
  stopped, for the collector or for another routine (§19). The place
  of the first block found wrong, NBlocks when none, and then Prev the
  last 32 bytes, as one call gives them. }
function Utf8Blocks(P: Pointer; NBlocks: Int64; Prev: Pointer; IJson: Boolean): Int64;
var
  done, take, k: Int64;
begin
  done := 0;
  while done < NBlocks do
  begin
    take := NBlocks - done;
    if take > Utf8MaxBlocks then
      take := Utf8MaxBlocks;
    k := Utf8Kernel(@PByte(P)[done shl 6], take, Prev, IJson);
    if k < take then
    begin
      Result := done + k;
      Exit;
    end;
    done := done + take;
  end;
  Result := NBlocks;
end;

{ Whether P[0..N-1] is UTF-8 (RFC 3629; and I-JSON's, RFC 7493 2.1,
  without noncharacters, when IJson says): -1 when it is, else the place
  from 0 of the first byte of the first sequence that is not, as
  Python's strict decoder gives it (the start of its error). The whole
  blocks go to the kernel; the tail, with a block of zeros after it, is
  copied into a local block, so nothing past P[N-1] is read and a
  sequence the end cuts is an error. }
function PasUtf8Valid(P: Pointer; N: Int64; IJson: Boolean): Int64;
var
  prev: array[0..31] of Byte;
  blk: array[0..63] of Byte;
  nb, k, t: Int64;
begin
  Result := -1;
  if N <= 0 then
    Exit;
  FillChar(prev, 32, 0);
  nb := N shr 6;
  k := Utf8Blocks(P, nb, @prev[0], IJson);
  if k < nb then
  begin
    Result := Utf8Locate(P, N, k shl 6, IJson);
    Exit;
  end;
  t := N - (nb shl 6);
  FillChar(blk, 64, 0);
  if t > 0 then
    Move(PByte(P)[nb shl 6], blk[0], t);
  if Utf8Blocks(@blk[0], 1, @prev[0], IJson) = 0 then
    Result := Utf8Locate(P, N, nb shl 6, IJson);
end;

{ A validation in pieces (a stream of JSON, P208): Start, Feed with each
  piece, End at the end. A sequence a piece ends in the middle of waits
  for the next; the places are from 0 of the whole. }
procedure PasUtf8Start(var S: TPasUtf8; IJson: Boolean);
var
  i: Int64;
begin
  for i := 0 to 31 do
    S.Prev[i] := 0;
  for i := 0 to 3 do
    S.Pend[i] := 0;
  S.NPend := 0;
  S.Fed := 0;
  S.Bad := -1;
  S.IJson := IJson;
end;

{ -1 while every byte so far is right, else the place of the first bad
  one; the state then stays bad. }
function PasUtf8Feed(var S: TPasUtf8; P: Pointer; N: Int64): Int64;
var
  tmp: array[0..7] of Byte;
  c, l, take, r, pend, off, nb, k, b0, t: Int64;
  q: PByte;
begin
  Result := -1;
  if S.Bad >= 0 then
  begin
    Result := S.Bad;
    Exit;
  end;
  if N <= 0 then
    Exit;
  q := PByte(P);
  off := 0;
  if S.NPend > 0 then
  begin
    { the open sequence first, with the bytes this piece has for it }
    l := Utf8SeqLen(S.Pend[0]);
    take := l - S.NPend;
    if take > N then
      take := N;
    for c := 0 to S.NPend - 1 do
      tmp[c] := S.Pend[c];
    for c := 0 to take - 1 do
      tmp[S.NPend + c] := q[c];
    r := PasUtf8Plain(@tmp[0], S.NPend + take, S.IJson, pend);
    if r >= 0 then
    begin
      S.Bad := S.Fed - S.NPend + r;
      Result := S.Bad;
      Exit;
    end;
    if pend > 0 then
    begin
      for c := 0 to take - 1 do
        S.Pend[S.NPend + c] := q[c];
      S.NPend := S.NPend + take;
      S.Fed := S.Fed + N;
      Exit;
    end;
    S.NPend := 0;
    off := take;
  end;
  { whole blocks to the kernel from a sequence's start, the rest read by
    the Plain body from the start of the sequence that crosses it }
  nb := (N - off) shr 6;
  for c := 0 to 31 do
    S.Prev[c] := 0;
  k := Utf8Blocks(@q[off], nb, @S.Prev[0], S.IJson);
  if k < nb then
    b0 := off + (k shl 6)
  else
    b0 := off + (nb shl 6);
  t := b0;
  c := t - 1;
  while (c >= off) and (c >= t - 3) and ((q[c] and $C0) = $80) do
    c := c - 1;
  if (c >= off) and (c >= t - 3) and (q[c] >= $C0) and (c + Utf8SeqLen(q[c]) > t) then
    t := c;
  r := PasUtf8Plain(@q[t], N - t, S.IJson, pend);
  if r >= 0 then
  begin
    S.Bad := S.Fed + t + r;
    Result := S.Bad;
    Exit;
  end;
  for c := 0 to pend - 1 do
    S.Pend[c] := q[N - pend + c];
  S.NPend := pend;
  S.Fed := S.Fed + N;
end;

{ At the end: -1 when everything was right and nothing is left open,
  else the place of the first bad byte, or of the sequence left open. }
function PasUtf8End(var S: TPasUtf8): Int64;
begin
  if S.Bad >= 0 then
    Result := S.Bad
  else if S.NPend > 0 then
    Result := S.Fed - S.NPend
  else
    Result := -1;
end;

{ ---- Insert, Delete, StringOfChar ---- }

{ Insert(Src, S, Index), as Free Pascal: Src goes in before S[Index],
  at the start when Index is below 1, at the end when it is past S. }
procedure PasInsertStr(const Src: string; var S: string; Index: Int64);
var
  n, k: Int64;
  r: string;
begin
  k := Length(Src);
  if k = 0 then
    Exit;
  n := Length(S);
  if Index < 1 then
    Index := 1;
  if Index > n + 1 then
    Index := n + 1;
  r := '';
  SetLength(r, n + k);
  if Index > 1 then
    Move(S[1], r[1], Index - 1);
  Move(Src[1], r[Index], k);
  if Index <= n then
    Move(S[Index], r[Index + k], n - Index + 1);
  S := r;
end;

{ Delete(S, Index, Count), as Free Pascal: Count characters from
  S[Index] on, to the end when there are fewer; nothing when Index is
  below 1 or past S or Count is not above 0. }
procedure PasDeleteStr(var S: string; Index, Count: Int64);
var
  n: Int64;
  r: string;
begin
  n := Length(S);
  if (Index < 1) or (Index > n) or (Count <= 0) then
    Exit;
  if Count > n - Index + 1 then
    Count := n - Index + 1;
  r := '';
  SetLength(r, n - Count);
  if Index > 1 then
    Move(S[1], r[1], Index - 1);
  if Index + Count <= n then
    Move(S[Index + Count], r[Index], n - Index - Count + 1);
  S := r;
end;

{ N characters C, none when N is not above 0. }
function PasStringOfChar(C: Char; N: Int64): string;
begin
  Result := '';
  if N <= 0 then
    Exit;
  SetLength(Result, N);
  FillChar(Result[1], N, Ord(C));
end;

{ ---- Val ---- }

{ A number's text as Free Pascal's Val reads it, into a type whose values
  go from Lo to Hi (P149): blanks and tabs first, a sign, then decimal
  digits, or $ (or 0x or x) and hexadecimal ones, % and binary ones, &
  and octal ones; a NUL ends it. Unsigned: Hi is read unsigned (-1 is
  2^64 - 1) and a minus is refused at its place. Bits: the width of an
  integer type, whose whole pattern a number in another base may fill
  ($FF into a ShortInt is -1); 0 for a subrange, whose bounds hold in
  every base. Code is 0, or the place from 1 of the first character that
  is none of the number (the end's when the digits are missing), of the
  digit that takes it past its type, or of the last digit of a number
  below a subrange's lowest value: Free Pascal 3.3.1's Val
  (rtl/inc/sstrings.inc checks the destination's size; its 3.2.2 kept
  the low bits of an unsigned one, as this did, a value lost without a
  word). On an error the value is 0, or Lo when 0 is not one of the
  type's, where Free Pascal says the variable is undefined. }
function PasValRange(const S: string; Lo, Hi: Int64; Unsigned: Boolean; Bits: Int64;
  out Code: Int64): Int64;
var
  i, n, base, d, acc, v, bad: Int64;
  neg: Boolean;
  c: Char;
begin
  if (Lo <= 0) and (Unsigned or (Hi >= 0)) then
    bad := 0
  else
    bad := Lo;
  Result := bad;
  n := Length(S);
  i := 1;
  while (i <= n) and ((S[i] = ' ') or (S[i] = #9)) do
    i := i + 1;
  Code := i;
  if (i > n) or (S[i] = #0) then
    Exit;
  neg := False;
  if S[i] = '-' then
  begin
    { an unsigned type takes no minus: its place }
    if Unsigned then
      Exit;
    neg := True;
    i := i + 1;
  end
  else if S[i] = '+' then
    i := i + 1;
  base := 10;
  if i <= n then
  begin
    if S[i] = '$' then
    begin
      base := 16;
      i := i + 1;
    end
    else if S[i] = '%' then
    begin
      base := 2;
      i := i + 1;
    end
    else if S[i] = '&' then
    begin
      base := 8;
      i := i + 1;
    end
    else if (S[i] = 'x') or (S[i] = 'X') then
    begin
      base := 16;
      i := i + 1;
    end
    else if (S[i] = '0') and (i < n) and ((S[i + 1] = 'x') or (S[i + 1] = 'X')) then
    begin
      base := 16;
      i := i + 2;
    end;
  end;
  Code := i;
  if (i > n) or (S[i] = #0) then
    Exit;
  acc := 0;
  while (i <= n) and (S[i] <> #0) do
  begin
    c := S[i];
    if (c >= '0') and (c <= '9') then
      d := Ord(c) - 48
    else if (c >= 'a') and (c <= 'f') then
      d := Ord(c) - 87
    else if (c >= 'A') and (c <= 'F') then
      d := Ord(c) - 55
    else
      d := 99;
    Code := i;
    if d >= base then
      Exit;
    if (base = 10) and Unsigned then
    begin
      { counted up to 2^64 - 1 (P142), compared unsigned: past 2^63 acc
        has its top bit set, and a 21st digit went through a signed
        test and wrapped (found by P149's model); then not past Hi }
      if ((acc xor Low(Int64)) > (1844674407370955161 xor Low(Int64))) or
        ((acc = 1844674407370955161) and (d > 5)) then
        Exit;
      acc := acc * 10 + d;
      if (acc xor Low(Int64)) > (Hi xor Low(Int64)) then
        Exit;
    end
    else if base = 10 then
    begin
      { worked out below zero, where Int64 reaches one further; not past
        Lo, or -Hi for a positive number (Hi is at most 2^63 - 1) }
      if (acc < -922337203685477580) or ((acc = -922337203685477580) and (d > 8)) then
        Exit;
      acc := acc * 10 - d;
      if neg and (acc < Lo) then
        Exit;
      if (not neg) and (acc < -Hi) then
        Exit;
    end
    else
    begin
      { hexadecimal, octal, binary: any 64 bits, then the width's pattern
        or the bounds; a negative one's magnitude up to -Lo }
      if (base = 16) and ((acc shr 60) <> 0) or (base = 8) and ((acc shr 61) <> 0) or
        (base = 2) and ((acc shr 63) <> 0) then
        Exit;
      if base = 16 then
        acc := (acc shl 4) or d
      else if base = 8 then
        acc := (acc shl 3) or d
      else
        acc := (acc shl 1) or d;
      if neg then
      begin
        if (acc xor Low(Int64)) > ((-Lo) xor Low(Int64)) then
          Exit;
      end
      else if (Bits > 0) and (Bits < 64) then
      begin
        if (acc shr Bits) <> 0 then
          Exit;
      end
      else if (Bits = 0) and ((acc xor Low(Int64)) > (Hi xor Low(Int64))) then
        Exit;
    end;
    i := i + 1;
  end;
  if (base = 10) and Unsigned then
    v := acc
  else if base = 10 then
  begin
    if neg then
      v := acc
    else
      v := -acc;
  end
  else if neg then
    v := -acc
  else if (Bits > 0) and (Bits < 64) and not Unsigned then
    { the width's pattern, its top bit the sign }
    v := (acc shl (64 - Bits)) sar (64 - Bits)
  else
    v := acc;
  { a subrange's lowest value above the digits, or its highest below a
    negative number's: the number, whole, is out of it }
  Code := i - 1;
  if Unsigned then
  begin
    if (v xor Low(Int64)) < (Lo xor Low(Int64)) then
      Exit;
  end
  else if (v < Lo) or (v > Hi) then
    Exit;
  Code := 0;
  Result := v;
end;

{ Val's reading into 64 bits (P134): an Integer's range, or with Unsigned
  a QWord's, 0 to 2^64 - 1 (P142). }
function PasValInt(const S: string; Unsigned: Boolean; out Code: Int64): Int64;
begin
  if Unsigned then
    Result := PasValRange(S, 0, -1, True, 64, Code)
  else
    Result := PasValRange(S, Low(Int64), High(Int64), False, 64, Code);
end;

{ A real's text as Val reads it: blanks, a sign, digits with a point
  among or after them, an exponent; Code as PasValInt's. T is the text
  as pasfmt's parsers read it, AStart where it begins; False with Code
  at the first character that is not a real's. }
function ValRealText(const S: string; out Code: Int64; out T: string; out AStart: Int64): Boolean;
var
  i, n, start, nd, k: Int64;
begin
  Result := False;
  T := '';
  AStart := 1;
  n := Length(S);
  i := 1;
  while (i <= n) and ((S[i] = ' ') or (S[i] = #9)) do
    i := i + 1;
  Code := i;
  if (i > n) or (S[i] = #0) then
    Exit;
  start := i;
  if (S[i] = '-') or (S[i] = '+') then
    i := i + 1;
  nd := 0;
  while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
  begin
    i := i + 1;
    nd := nd + 1;
  end;
  if (i <= n) and (S[i] = '.') then
  begin
    i := i + 1;
    while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
    begin
      i := i + 1;
      nd := nd + 1;
    end;
  end;
  if nd = 0 then
  begin
    Code := i;
    Exit;
  end;
  if (i <= n) and ((S[i] = 'e') or (S[i] = 'E')) then
  begin
    i := i + 1;
    if (i <= n) and ((S[i] = '-') or (S[i] = '+')) then
      i := i + 1;
    if (i > n) or (S[i] < '0') or (S[i] > '9') then
    begin
      Code := i;
      Exit;
    end;
    while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
      i := i + 1;
  end;
  if (i <= n) and (S[i] <> #0) then
  begin
    Code := i;
    Exit;
  end;
  { the digits as PasParseReal reads them: a 0 before a leading point
    and after a trailing one }
  for k := start to i - 1 do
  begin
    if (S[k] = '.') and ((k = start) or (S[k - 1] < '0') or (S[k - 1] > '9')) then
      T := T + '0';
    T := T + S[k];
    if (S[k] = '.') and ((k = i - 1) or (S[k + 1] < '0') or (S[k + 1] > '9')) then
      T := T + '0';
  end;
  if (Length(T) > 0) and (T[1] = '+') then
    T := Copy(T, 2, Length(T) - 1);
  AStart := start;
  Result := True;
end;

function PasValCurrency(const S: string; out Code: Int64): Int64;
var text: string; start: Int64;
begin
  Result := 0;
  if not ValRealText(S, Code, text, start) then Exit;
  if not PasTryParseCurrency(text, Result) then Code := start
  else Code := 0;
end;

{ The real at the start of S, after blanks, scanned in place by pasnum
  with Pascal's grammar (P200): Code as ValRealText's, 0 when the text
  ends with it or a NUL follows it, else the place of the character that
  stopped it; Bits the nearest Double, or Single when IsSingle, rounded
  once. Nothing is copied. }
function ValRealBits(const S: string; IsSingle: Boolean; out Code, Bits: Int64): Boolean;
var
  i, n: Int64;
  sc: TPasNumScan;
begin
  Result := False;
  Bits := 0;
  n := Length(S);
  i := 1;
  while (i <= n) and ((S[i] = ' ') or (S[i] = #9)) do
    i := i + 1;
  Code := i;
  if (i > n) or (S[i] = #0) then
    Exit;
  if not PasNumScan(@S[i], n - i + 1, False, sc) then
  begin
    Code := i + sc.Len;
    Exit;
  end;
  if (i + sc.Len <= n) and (S[i + sc.Len] <> #0) then
  begin
    Code := i + sc.Len;
    Exit;
  end;
  if IsSingle then
    PasNumF32(@S[i], sc, Bits)
  else
    PasNumF64(@S[i], sc, Bits);
  Code := 0;
  Result := True;
end;

{ The value is the nearest Double (P200: it read the text through the
  bignum of pasfmt, 9 microseconds a number). }
function PasValReal(const S: string; out Code: Int64): Double;
var
  bits: Int64;
begin
  Result := 0;
  if ValRealBits(S, False, Code, bits) then
    Result := (bits as Double);
end;

{ The nearest Single, rounded once from the digits (P146), as Go's
  ParseFloat(s, 32): through a Double it could be one off. Free Pascal
  reads an Extended first and rounds that again. }
function PasValSingle(const S: string; out Code: Int64): Single;
var
  bits: Int64;
  sb: Int32;
begin
  Result := 0;
  if ValRealBits(S, True, Code, bits) then
  begin
    sb := Int32(bits);
    Result := (sb as Single);
  end;
end;

{ The Quad nearest the digits, rounded once (P146), pasfmt's
  PasParseQuad: its low word, and its high word in Hi. Through a Double
  it kept 53 bits of the 113. }
function PasValQuadLo(const S: string; out Code, Hi: Int64): Int64;
var
  t: string;
  start, lo: Int64;
begin
  Result := 0;
  Hi := 0;
  if not ValRealText(S, Code, t, start) then
    Exit;
  if not PasParseQuad(t, lo, Hi) then
  begin
    Code := start;
    Hi := 0;
    Exit;
  end;
  Result := lo;
  Code := 0;
end;

{ Names: an enumeration's members, each followed by a NUL; the one S
  names, whatever its case, and Code 0; else -1 and Code 1. }
function PasValEnum(const S: string; const Names: string; out Code: Int64): Int64;
var
  i, k, st: Int64;
  w: string;
begin
  Result := 0;
  Code := 1;
  k := 0;
  st := 1;
  for i := 1 to Length(Names) do
    if Names[i] = #0 then
    begin
      w := Copy(Names, st, i - st);
      if (Length(w) = Length(S)) and (MapCaseBase(w, True) = MapCaseBase(S, True)) then
      begin
        Result := k;
        Code := 0;
        Exit;
      end;
      k := k + 1;
      st := i + 1;
    end;
end;

{ The name of member V of the enumeration whose names Names holds, as
  PasValEnum reads them; its number when V is none of them. Width W pads
  it on the right with blanks, as Free Pascal's Str does. }
function PasEnumName(V: Int64; const Names: string; W: Int64): string;
var
  i, k, st: Int64;
begin
  k := 0;
  st := 1;
  for i := 1 to Length(Names) do
    if Names[i] = #0 then
    begin
      if k = V then
      begin
        Result := Copy(Names, st, i - st);
        while Length(Result) < W do
          Result := Result + ' ';
        Exit;
      end;
      k := k + 1;
      st := i + 1;
    end;
  Result := PasFmtInt(V, W);
end;

{ Current Go syscall.ByteSliceFromString owns len(s)+1 bytes including
  the terminator. Pascal PChar conversion retains embedded NULs, unlike
  a system-path conversion; system APIs validate paths separately. }
function PasCString(const S: string): PChar;
var terminated: string;
begin
  terminated := S + #0;
  Result := @terminated[1];
end;

{ ---- String views ---- }

type
  { a string as it lies in memory: the address of its bytes and their
    count, as pasobject's }
  TStrWords = record
    P: Pointer;
    N: Int64;
  end;

procedure ViewFatal(const Msg: string);
begin
  WriteLn(ErrOutput, Msg);
  Halt(1);
end;

{ The N bytes at P as a string, with no copy (P198, 1.1.93): a view, as
  Go's unsafe.String (golang src/unsafe/unsafe.go String, checked as
  src/runtime/unsafe.go unsafestring does). The contract (TYPES.md,
  GC.md 2.6): the bytes from P - 1 to P + N - 1 lie in one block of the
  heap that nothing writes while a view of it lives, and the byte at
  P - 1 has bit 0 set, the mark rt_stralloc's header gives characters
  another string shares. A write through the view, or through any
  string it is stored in, then copies the characters first
  (rt_strunique), and no store ever writes that byte: ShareStr,
  rt_strshare and rt_setpropstr write the mark only when it is clear.
  P points inside the block, so a view keeps the whole block alive.
  N = 0 gives the empty string, never a view. A length below 0 or past
  the end of the address space and a nil P with N above 0 stop the
  program, where Go panics; so does a byte before P without the mark,
  which the first store of the view would write. }
function PasStrView(P: Pointer; N: Int64): string;
var
  w: TStrWords;
begin
  Result := '';
  if N = 0 then
    Exit;
  if N < 0 then
    ViewFatal('paslang: string view length ' + PasFmtInt(N, 0) + ' out of range');
  if P = nil then
    ViewFatal('paslang: string view of nil with length ' + PasFmtInt(N, 0));
  if (Int64(P) < 0) and (Int64(P) + N >= 0) then
    ViewFatal('paslang: string view length ' + PasFmtInt(N, 0) + ' out of range');
  if (PByte(Int64(P) - 1)^ and 1) = 0 then
    ViewFatal('paslang: string view over bytes not marked shared');
  w.P := P;
  w.N := N;
  Result := w as string;
end;

end.
