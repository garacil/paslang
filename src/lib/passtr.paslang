{ The standard string words of the language (P134): Pos, Insert, Delete
  of a string, StringOfChar, UpCase and LowerCase of a string, Val's
  reading of a number, a real and an enumeration's member. Their hot
  cores are kernels, one per machine, after Go 1.23's internal/bytealg
  (docs/ref/go1.23), each with a body on the processor's extension
  (Cpu), one on the base processor (Base) and the Pascal it does
  (Plain), which the tests hold them to:

  IndexByte, the first place of a byte: AVX2's vpcmpeqb over 32 bytes,
  SSE2's pcmpeqb over 16 (indexbyte_amd64.s), NEON's cmeq over 32 bytes
  and a syndrome whose trailing zeros are the place (indexbyte_arm64.s).
  MemEq, whether two runs of bytes are equal: 64 bytes a step on AVX2
  or SSE2, eight bytes a step on the rest (equal_amd64.s); NEON's 64 a
  step and eight after (equal_arm64.s).
  CaseMap, a string's ASCII letters to upper or lower case: a byte is a
  letter when its distance from 'a' (or 'A') is below 26, which pminub
  and pcmpeqb tell on AVX2 and SSE2 and cmhi on NEON, and its case bit,
  32, flips.

  Utf8, whether bytes are UTF-8 (P201): simdjson's lookup4 on AVX2 and
  NEON, three nibble tables and the bytes one to three back, 64 bytes a
  block, a block of ASCII skipped; SSE2's ASCII skip and Go's
  utf8.Valid automaton on the base; Go's automaton the reference.

  Pos searches as Go's strings.Index does: IndexByte finds the first
  byte, MemEq checks the rest, and when the first byte keeps matching
  where the rest does not, Rabin-Karp takes over, so the search stays
  linear. On arm64 NEON is part of the base processor: its Cpu and Base
  bodies are one.

  A kernel takes any length in one call, and an asm block is not
  preempted, so no word gives one more than 64 KiB a call (P269, P270):
  Pos over a slice of the text at a time, PasFindByte and PasCompareByte
  (IndexByte and CompareByte) and the case map in a loop of calls, the
  UTF-8 validation 1024 blocks a call; the loop's head is where the
  routine can be stopped. Nothing is added to the loops that call a
  kernel most: Pos's own runs over each slice as it did over the text. }

unit passtr;

interface

function PasIndexByteCpu(P: Pointer; N, C: Int64): Int64;
function PasIndexByteBase(P: Pointer; N, C: Int64): Int64;
function PasIndexBytePlain(P: Pointer; N, C: Int64): Int64;
function PasMemEqCpu(A, B: Pointer; N: Int64): Boolean;
function PasMemEqBase(A, B: Pointer; N: Int64): Boolean;
function PasMemEqPlain(A, B: Pointer; N: Int64): Boolean;
function PasCmpByteCpu(A, B: Pointer; N: Int64): Int64;
function PasCmpByteBase(A, B: Pointer; N: Int64): Int64;
function PasCmpBytePlain(A, B: Pointer; N: Int64): Int64;
function PasCaseCmpCpu(A, B: Pointer; N: Int64): Int64;
function PasCaseCmpBase(A, B: Pointer; N: Int64): Int64;
function PasCaseCmpPlain(A, B: Pointer; N: Int64): Int64;
procedure PasCaseMapCpu(Src, Dst: Pointer; N: Int64; Upper: Boolean);
procedure PasCaseMapBase(Src, Dst: Pointer; N: Int64; Upper: Boolean);
procedure PasCaseMapPlain(Src, Dst: Pointer; N: Int64; Upper: Boolean);
function PasFindByteCpu(P: Pointer; N, C: Int64): Int64;
function PasFindByteBase(P: Pointer; N, C: Int64): Int64;
function PasCompareByteCpu(A, B: Pointer; N: Int64): Int64;
function PasCompareByteBase(A, B: Pointer; N: Int64): Int64;

type
  { a validation of UTF-8 in pieces (P201): PasUtf8Start, PasUtf8Feed
    with each piece, PasUtf8End }
  TPasUtf8 = record
    Prev: array[0..31] of Byte;
    Pend: array[0..3] of Byte;
    NPend: Int64;
    Fed: Int64;
    Bad: Int64;
    IJson: Boolean;
  end;

function PasUtf8Plain(P: Pointer; N: Int64; IJson: Boolean; out Pend: Int64): Int64;
function PasUtf8BlocksCpu(P: Pointer; NBlocks: Int64; Prev: Pointer; IJson: Boolean): Int64;
function PasUtf8BlocksBase(P: Pointer; NBlocks: Int64; Prev: Pointer; IJson: Boolean): Int64;
function PasUtf8Valid(P: Pointer; N: Int64; IJson: Boolean): Int64;
procedure PasUtf8Start(var S: TPasUtf8; IJson: Boolean);
function PasUtf8Feed(var S: TPasUtf8; P: Pointer; N: Int64): Int64;
function PasUtf8End(var S: TPasUtf8): Int64;

function PasPosCpu(const Sub, S: string; Offset: Int64): Int64;
function PasPosBase(const Sub, S: string; Offset: Int64): Int64;
function PasPosCharCpu(C: Char; const S: string; Offset: Int64): Int64;
function PasPosCharBase(C: Char; const S: string; Offset: Int64): Int64;
function PasUpperCpu(const S: string): string;
function PasUpperBase(const S: string): string;
function PasLowerCpu(const S: string): string;
function PasLowerBase(const S: string): string;

procedure PasInsertStr(const Src: string; var S: string; Index: Int64);
procedure PasDeleteStr(var S: string; Index, Count: Int64);
function PasStringOfChar(C: Char; N: Int64): string;

function PasValInt(const S: string; Unsigned: Boolean; out Code: Int64): Int64;
function PasValRange(const S: string; Lo, Hi: Int64; Unsigned: Boolean; Bits: Int64;
  out Code: Int64): Int64;
function PasValReal(const S: string; out Code: Int64): Double;
function PasValCurrency(const S: string; out Code: Int64): Int64;
function PasValSingle(const S: string; out Code: Int64): Single;
function PasValQuadLo(const S: string; out Code, Hi: Int64): Int64;
function PasValEnum(const S: string; const Names: string; out Code: Int64): Int64;
function PasEnumName(V: Int64; const Names: string; W: Int64): string;
function PasCString(const S: string): PChar;
function PasStrView(P: Pointer; N: Int64): string;

implementation

uses pasfmt, pasnum;

const
  PrimeRK = 16777619;
  { At most this many blocks of 64 bytes, 64 KiB, go to the UTF-8
    kernel in one call, as JsonMaxBlocks in pasjson (P269). }
  Utf8MaxBlocks = 1024;
  { At most this many bytes, 64 KiB, go to a kernel of search, compare
    or case in one call (P270): an asm block is not preempted, and the
    code between two calls is where the routine can be stopped, for the
    collector or for another routine (§19). }
  StrMaxBytes = 65536;

{ ---- IndexByte ---- }

{ The place of byte C in P[0..N-1] from 0, -1 when it is not there: the
  reference the kernels are held to. }
function PasIndexBytePlain(P: Pointer; N, C: Int64): Int64;
var
  i: Int64;
  b: Int64;
begin
  Result := -1;
  b := C and 255;
  for i := 0 to N - 1 do
    if PByte(P)[i] = b then
    begin
      Result := i;
      Exit;
    end;
end;

{ AVX2 over 32 bytes a step, SSE2 under 32 and at the tail, after Go's
  indexbytebody (indexbyte_amd64.s): the byte in every lane, vpcmpeqb,
  vptest to tell a match, vpmovmskb and bsf for its place; a run under
  16 bytes is read in one load that stays inside its page. NEON on
  arm64, after indexbyte_arm64.s: 32 aligned bytes a step, each match a
  bit of a 64-bit syndrome (two bits a byte, 0x40100401 the lanes'
  weights), rbit and clz for the first. }
function PasIndexByteCpu(P: Pointer; N, C: Int64): Int64;
begin
  asm amd64 (P: in rsi; N: in rbx; C: in rax; Result: out rax)
    movd %eax, %xmm0
    punpcklbw %xmm0, %xmm0
    punpcklbw %xmm0, %xmm0
    pshufd $0, %xmm0, %xmm0
    cmpq $16, %rbx
    jl 5f
    movq %rsi, %rdi
    cmpq $32, %rbx
    ja 8f
    leaq -16(%rsi,%rbx), %rax
    jmp 2f
    .p2align 5
    1:
    movdqu (%rdi), %xmm1
    pcmpeqb %xmm0, %xmm1
    pmovmskb %xmm1, %edx
    bsfl %edx, %edx
    jnz 4f
    addq $16, %rdi
    2:
    cmpq %rax, %rdi
    jb 1b
    movq %rax, %rdi
    movdqu (%rax), %xmm1
    pcmpeqb %xmm0, %xmm1
    pmovmskb %xmm1, %edx
    bsfl %edx, %edx
    jnz 4f
    .p2align 5
    3:
    movq $-1, %rax
    jmp 9f
    4:
    subq %rsi, %rdi
    addq %rdx, %rdi
    movq %rdi, %rax
    jmp 9f
    5:
    testq %rbx, %rbx
    jle 3b
    leaq 16(%rsi), %rax
    testw $0xff0, %ax
    je 6f
    movdqu (%rsi), %xmm1
    pcmpeqb %xmm0, %xmm1
    pmovmskb %xmm1, %edx
    bsfl %edx, %edx
    jz 3b
    cmpl %ebx, %edx
    jae 3b
    movq %rdx, %rax
    jmp 9f
    6:
    movdqu -16(%rsi,%rbx), %xmm1
    pcmpeqb %xmm0, %xmm1
    pmovmskb %xmm1, %edx
    movl %ebx, %ecx
    shll %cl, %edx
    shrl $16, %edx
    bsfl %edx, %edx
    jz 3b
    movq %rdx, %rax
    jmp 9f
    8:
    vpbroadcastb %xmm0, %ymm1
    leaq -32(%rsi,%rbx), %r11
    .p2align 5
    7:
    vmovdqu (%rdi), %ymm2
    vpcmpeqb %ymm1, %ymm2, %ymm3
    vptest %ymm3, %ymm3
    jnz 10f
    addq $32, %rdi
    cmpq %r11, %rdi
    jl 7b
    movq %r11, %rdi
    vmovdqu (%rdi), %ymm2
    vpcmpeqb %ymm1, %ymm2, %ymm3
    vptest %ymm3, %ymm3
    jnz 10f
    vzeroupper
    movq $-1, %rax
    jmp 9f
    10:
    vpmovmskb %ymm3, %edx
    bsfl %edx, %edx
    subq %rsi, %rdi
    addq %rdi, %rdx
    movq %rdx, %rax
    vzeroupper
    9:
  end;
  asm arm64 (P: in x0; C: in x1; N: in x2; Result: out x0)
    cmp x2, #0
    b.le 9f
    mov x11, x0
    movz w5, #0x0401
    movk w5, #0x4010, lsl #16
    dup v0.16b, w1
    bic x3, x0, #0x1f
    dup v5.4s, w5
    ands x9, x0, #0x1f
    and x10, x2, #0x1f
    b.eq 2f
    ld1 {v1.16b, v2.16b}, [x3], #32
    sub x4, x9, #0x20
    adds x2, x2, x4
    cmeq v3.16b, v1.16b, v0.16b
    cmeq v4.16b, v2.16b, v0.16b
    and v3.16b, v3.16b, v5.16b
    and v4.16b, v4.16b, v5.16b
    addp v6.16b, v3.16b, v4.16b
    addp v6.16b, v6.16b, v6.16b
    mov x6, v6.d[0]
    lsl x4, x9, #1
    lsr x6, x6, x4
    lsl x6, x6, x4
    b.ls 4f
    cbnz x6, 5f
    .p2align 5
    2:
    ld1 {v1.16b, v2.16b}, [x3], #32
    subs x2, x2, #0x20
    cmeq v3.16b, v1.16b, v0.16b
    cmeq v4.16b, v2.16b, v0.16b
    b.ls 3f
    orr v6.16b, v3.16b, v4.16b
    addp v6.2d, v6.2d, v6.2d
    mov x6, v6.d[0]
    cbz x6, 2b
    3:
    and v3.16b, v3.16b, v5.16b
    and v4.16b, v4.16b, v5.16b
    addp v6.16b, v3.16b, v4.16b
    addp v6.16b, v6.16b, v6.16b
    mov x6, v6.d[0]
    b.hs 5f
    4:
    add x4, x9, x10
    and x4, x4, #0x1f
    sub x4, x4, #0x20
    neg x4, x4, lsl #1
    lsl x6, x6, x4
    lsr x6, x6, x4
    5:
    cbz x6, 9f
    rbit x6, x6
    sub x3, x3, #0x20
    clz x6, x6
    add x0, x3, x6, lsr #1
    sub x0, x0, x11
    b 10f
    9:
    mov x0, #-1
    10:
  end;
end;

{ The base processor's: SSE2 alone on amd64, the same NEON on arm64. }
function PasIndexByteBase(P: Pointer; N, C: Int64): Int64;
begin
  asm amd64 (P: in rsi; N: in rbx; C: in rax; Result: out rax)
    movd %eax, %xmm0
    punpcklbw %xmm0, %xmm0
    punpcklbw %xmm0, %xmm0
    pshufd $0, %xmm0, %xmm0
    cmpq $16, %rbx
    jl 5f
    movq %rsi, %rdi
    leaq -16(%rsi,%rbx), %rax
    jmp 2f
    .p2align 5
    1:
    movdqu (%rdi), %xmm1
    pcmpeqb %xmm0, %xmm1
    pmovmskb %xmm1, %edx
    bsfl %edx, %edx
    jnz 4f
    addq $16, %rdi
    2:
    cmpq %rax, %rdi
    jb 1b
    movq %rax, %rdi
    movdqu (%rax), %xmm1
    pcmpeqb %xmm0, %xmm1
    pmovmskb %xmm1, %edx
    bsfl %edx, %edx
    jnz 4f
    .p2align 5
    3:
    movq $-1, %rax
    jmp 9f
    4:
    subq %rsi, %rdi
    addq %rdx, %rdi
    movq %rdi, %rax
    jmp 9f
    5:
    testq %rbx, %rbx
    jle 3b
    leaq 16(%rsi), %rax
    testw $0xff0, %ax
    je 6f
    movdqu (%rsi), %xmm1
    pcmpeqb %xmm0, %xmm1
    pmovmskb %xmm1, %edx
    bsfl %edx, %edx
    jz 3b
    cmpl %ebx, %edx
    jae 3b
    movq %rdx, %rax
    jmp 9f
    6:
    movdqu -16(%rsi,%rbx), %xmm1
    pcmpeqb %xmm0, %xmm1
    pmovmskb %xmm1, %edx
    movl %ebx, %ecx
    shll %cl, %edx
    shrl $16, %edx
    bsfl %edx, %edx
    jz 3b
    movq %rdx, %rax
    9:
  end;
  asm arm64 (P: in x0; C: in x1; N: in x2; Result: out x0)
    cmp x2, #0
    b.le 9f
    mov x11, x0
    movz w5, #0x0401
    movk w5, #0x4010, lsl #16
    dup v0.16b, w1
    bic x3, x0, #0x1f
    dup v5.4s, w5
    ands x9, x0, #0x1f
    and x10, x2, #0x1f
    b.eq 2f
    ld1 {v1.16b, v2.16b}, [x3], #32
    sub x4, x9, #0x20
    adds x2, x2, x4
    cmeq v3.16b, v1.16b, v0.16b
    cmeq v4.16b, v2.16b, v0.16b
    and v3.16b, v3.16b, v5.16b
    and v4.16b, v4.16b, v5.16b
    addp v6.16b, v3.16b, v4.16b
    addp v6.16b, v6.16b, v6.16b
    mov x6, v6.d[0]
    lsl x4, x9, #1
    lsr x6, x6, x4
    lsl x6, x6, x4
    b.ls 4f
    cbnz x6, 5f
    .p2align 5
    2:
    ld1 {v1.16b, v2.16b}, [x3], #32
    subs x2, x2, #0x20
    cmeq v3.16b, v1.16b, v0.16b
    cmeq v4.16b, v2.16b, v0.16b
    b.ls 3f
    orr v6.16b, v3.16b, v4.16b
    addp v6.2d, v6.2d, v6.2d
    mov x6, v6.d[0]
    cbz x6, 2b
    3:
    and v3.16b, v3.16b, v5.16b
    and v4.16b, v4.16b, v5.16b
    addp v6.16b, v3.16b, v4.16b
    addp v6.16b, v6.16b, v6.16b
    mov x6, v6.d[0]
    b.hs 5f
    4:
    add x4, x9, x10
    and x4, x4, #0x1f
    sub x4, x4, #0x20
    neg x4, x4, lsl #1
    lsl x6, x6, x4
    lsr x6, x6, x4
    5:
    cbz x6, 9f
    rbit x6, x6
    sub x3, x3, #0x20
    clz x6, x6
    add x0, x3, x6, lsr #1
    sub x0, x0, x11
    b 10f
    9:
    mov x0, #-1
    10:
  end;
end;

{ ---- MemEq ---- }

function PasMemEqPlain(A, B: Pointer; N: Int64): Boolean;
var
  i: Int64;
begin
  Result := False;
  for i := 0 to N - 1 do
    if PByte(A)[i] <> PByte(B)[i] then
      Exit;
  Result := True;
end;

{ Go's memeqbody (equal_amd64.s): 64 bytes a step on AVX2 (Cpu) or
  SSE2 (Base), 8 a step below 64, the last 8 read ending at the end;
  under 8, one load of each that stays inside its page, shifted to the
  bytes wanted. On arm64 equal_arm64.s: 64 bytes a step compared as
  words by NEON, 16 by two ldp, then 8, 4, 2 and 1. }
function PasMemEqCpu(A, B: Pointer; N: Int64): Boolean;
begin
  asm amd64 (A: in rsi; B: in rdi; N: in rbx; Result: out rax)
    cmpq $8, %rbx
    jb 5f
    cmpq $64, %rbx
    jb 3f
    .p2align 5
    1:
    cmpq $64, %rbx
    jb 2f
    vmovdqu (%rsi), %ymm0
    vmovdqu (%rdi), %ymm1
    vmovdqu 32(%rsi), %ymm2
    vmovdqu 32(%rdi), %ymm3
    vpcmpeqb %ymm1, %ymm0, %ymm4
    vpcmpeqb %ymm2, %ymm3, %ymm5
    vpand %ymm4, %ymm5, %ymm6
    vpmovmskb %ymm6, %edx
    addq $64, %rsi
    addq $64, %rdi
    subq $64, %rbx
    cmpl $0xffffffff, %edx
    je 1b
    vzeroupper
    xorl %eax, %eax
    jmp 9f
    2:
    vzeroupper
    .p2align 5
    3:
    cmpq $8, %rbx
    jbe 4f
    movq (%rsi), %rcx
    movq (%rdi), %rdx
    addq $8, %rsi
    addq $8, %rdi
    subq $8, %rbx
    cmpq %rdx, %rcx
    je 3b
    xorl %eax, %eax
    jmp 9f
    4:
    movq -8(%rsi,%rbx), %rcx
    movq -8(%rdi,%rbx), %rdx
    xorl %eax, %eax
    cmpq %rdx, %rcx
    sete %al
    jmp 9f
    5:
    movl $0, %eax
    cmpq $0, %rbx
    je 8f
    leaq 0(,%rbx,8), %rcx
    negq %rcx
    cmpb $0xf8, %sil
    ja 6f
    movq (%rsi), %rsi
    jmp 7f
    6:
    movq -8(%rsi,%rbx), %rsi
    shrq %cl, %rsi
    7:
    cmpb $0xf8, %dil
    ja 10f
    movq (%rdi), %rdi
    jmp 11f
    10:
    movq -8(%rdi,%rbx), %rdi
    shrq %cl, %rdi
    11:
    subq %rsi, %rdi
    shlq %cl, %rdi
    movl $0, %eax
    8:
    sete %al
    9:
  end;
  asm arm64 (A: in x0; B: in x1; N: in x2; Result: out x0)
    cbz x2, 8f
    cmp x2, #1
    b.eq 7f
    cmp x2, #16
    b.lo 4f
    bic x3, x2, #0x3f
    cbz x3, 2f
    add x6, x0, x3
    .p2align 5
    1:
    ld1 {v0.2d, v1.2d, v2.2d, v3.2d}, [x0], #64
    ld1 {v4.2d, v5.2d, v6.2d, v7.2d}, [x1], #64
    cmeq v8.2d, v0.2d, v4.2d
    cmeq v9.2d, v1.2d, v5.2d
    cmeq v10.2d, v2.2d, v6.2d
    cmeq v11.2d, v3.2d, v7.2d
    and v8.16b, v8.16b, v9.16b
    and v8.16b, v8.16b, v10.16b
    and v8.16b, v8.16b, v11.16b
    cmp x0, x6
    mov x4, v8.d[0]
    mov x5, v8.d[1]
    cbz x4, 9f
    cbz x5, 9f
    b.ne 1b
    and x2, x2, #0x3f
    cbz x2, 8f
    2:
    bic x3, x2, #0xf
    cbz x3, 4f
    add x6, x0, x3
    .p2align 5
    3:
    ldp x4, x5, [x0], #16
    ldp x7, x9, [x1], #16
    eor x7, x4, x7
    cbnz x7, 9f
    eor x9, x5, x9
    cbnz x9, 9f
    cmp x0, x6
    b.ne 3b
    and x2, x2, #0xf
    cbz x2, 8f
    4:
    tbz x2, #3, 5f
    ldr x4, [x0]
    ldr x5, [x1]
    eor x5, x4, x5
    cbnz x5, 9f
    sub x6, x2, #8
    ldr x4, [x0, x6]
    ldr x5, [x1, x6]
    eor x5, x4, x5
    cbnz x5, 9f
    b 8f
    5:
    tbz x2, #2, 6f
    ldr w4, [x0]
    ldr w5, [x1]
    eor w5, w4, w5
    cbnz w5, 9f
    sub x6, x2, #4
    ldr w4, [x0, x6]
    ldr w5, [x1, x6]
    eor w5, w4, w5
    cbnz w5, 9f
    b 8f
    6:
    tbz x2, #1, 10f
    ldrh w4, [x0], #2
    ldrh w5, [x1], #2
    cmp w4, w5
    b.ne 9f
    10:
    tbz x2, #0, 8f
    7:
