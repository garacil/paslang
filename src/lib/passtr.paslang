{ The base: SSE2 16 bytes a step, the last 16 ending at the end; under
  16 a byte at a time. On arm64 the NEON body. }
function PasCaseCmpBase(A, B: Pointer; N: Int64): Int64;
begin
  asm amd64 (A: in rsi; B: in rdi; N: in rbx; Result: out rax)
    xorl %eax, %eax
    cmpq $16, %rbx
    jl 30f
    movl $0x61616161, %ecx
    movd %ecx, %xmm7
    pshufd $0, %xmm7, %xmm7
    movl $0x19191919, %ecx
    movd %ecx, %xmm6
    pshufd $0, %xmm6, %xmm6
    movl $0x20202020, %ecx
    movd %ecx, %xmm5
    pshufd $0, %xmm5, %xmm5
    21:
    movdqu (%rsi), %xmm0
    movdqu (%rdi), %xmm1
    movdqa %xmm0, %xmm2
    psubb %xmm7, %xmm2
    movdqa %xmm2, %xmm3
    pminub %xmm6, %xmm3
    pcmpeqb %xmm3, %xmm2
    pand %xmm5, %xmm2
    pxor %xmm2, %xmm0
    movdqa %xmm1, %xmm2
    psubb %xmm7, %xmm2
    movdqa %xmm2, %xmm3
    pminub %xmm6, %xmm3
    pcmpeqb %xmm3, %xmm2
    pand %xmm5, %xmm2
    pxor %xmm2, %xmm1
    pcmpeqb %xmm1, %xmm0
    pmovmskb %xmm0, %edx
    xorl $0xffff, %edx
    jnz 26f
    addq $16, %rsi
    addq $16, %rdi
    subq $16, %rbx
    cmpq $16, %rbx
    jae 21b
    testq %rbx, %rbx
    jz 9f
    leaq -16(%rsi,%rbx), %rsi
    leaq -16(%rdi,%rbx), %rdi
    movq $16, %rbx
    jmp 21b
    26:
    bsfl %edx, %edx
    jmp 40f
    30:
    testq %rbx, %rbx
    jle 9f
    xorl %edx, %edx
    31:
    movzbl (%rsi,%rdx), %eax
    leal -97(%rax), %r8d
    cmpl $25, %r8d
    ja 32f
    subl $32, %eax
    32:
    movzbl (%rdi,%rdx), %ecx
    leal -97(%rcx), %r8d
    cmpl $25, %r8d
    ja 33f
    subl $32, %ecx
    33:
    subq %rcx, %rax
    jnz 9f
    incq %rdx
    cmpq %rbx, %rdx
    jb 31b
    jmp 9f
    40:
    movzbl (%rsi,%rdx), %eax
    leal -97(%rax), %r8d
    cmpl $25, %r8d
    ja 41f
    subl $32, %eax
    41:
    movzbl (%rdi,%rdx), %ecx
    leal -97(%rcx), %r8d
    cmpl $25, %r8d
    ja 42f
    subl $32, %ecx
    42:
    subq %rcx, %rax
    9:
  end;
  asm arm64 (A: in x0; B: in x1; N: in x2; Result: out x0)
    mov x3, x0
    mov x0, #0
    cmp x2, #16
    b.lt 30f
    movi v7.16b, #0x61
    movi v6.16b, #26
    movi v5.16b, #0x20
    1:
    ldr q0, [x3]
    ldr q1, [x1]
    sub v2.16b, v0.16b, v7.16b
    cmhi v2.16b, v6.16b, v2.16b
    and v2.16b, v2.16b, v5.16b
    eor v0.16b, v0.16b, v2.16b
    sub v2.16b, v1.16b, v7.16b
    cmhi v2.16b, v6.16b, v2.16b
    and v2.16b, v2.16b, v5.16b
    eor v1.16b, v1.16b, v2.16b
    cmeq v2.16b, v0.16b, v1.16b
    not v2.16b, v2.16b
    shrn v3.8b, v2.8h, #4
    fmov x4, d3
    cbnz x4, 6f
    add x3, x3, #16
    add x1, x1, #16
    sub x2, x2, #16
    cmp x2, #16
    b.hs 1b
    cbz x2, 9f
    sub x5, x2, #16
    add x3, x3, x5
    add x1, x1, x5
    mov x2, #16
    b 1b
    6:
    rbit x4, x4
    clz x4, x4
    lsr x4, x4, #2
    b 40f
    30:
    cmp x2, #0
    b.le 9f
    mov x4, #0
    31:
    ldrb w5, [x3, x4]
    sub w8, w5, #97
    cmp w8, #25
    b.hi 32f
    sub w5, w5, #32
    32:
    ldrb w6, [x1, x4]
    sub w8, w6, #97
    cmp w8, #25
    b.hi 33f
    sub w6, w6, #32
    33:
    subs x0, x5, x6
    b.ne 9f
    add x4, x4, #1
    cmp x4, x2
    b.lo 31b
    b 9f
    40:
    ldrb w5, [x3, x4]
    sub w8, w5, #97
    cmp w8, #25
    b.hi 41f
    sub w5, w5, #32
    41:
    ldrb w6, [x1, x4]
    sub w8, w6, #97
    cmp w8, #25
    b.hi 42f
    sub w6, w6, #32
    42:
    sub x0, x5, x6
    9:
  end;
end;

{ ---- CaseMap ---- }

{ Dst[i] := Src[i] with the ASCII letters to upper case (Upper) or to
  lower case: a byte b is a letter to flip when b - First, a byte's
  wrap, is at most 25, First 'a' or 'A', and its bit 32 flips. }
procedure PasCaseMapPlain(Src, Dst: Pointer; N: Int64; Upper: Boolean);
var
  i, b, first: Int64;
begin
  if Upper then
    first := 97
  else
    first := 65;
  for i := 0 to N - 1 do
  begin
    b := PByte(Src)[i];
    if ((b - first) and 255) <= 25 then
      b := b xor 32;
    PByte(Dst)[i] := Byte(b);
  end;
end;

{ 32 bytes a step on AVX2 and 16 after, 16 on SSE2 (Base): vpsubb takes
  First away, vpminub against 25 and vpcmpeqb mark the letters, vpand
  keeps 32 there and vpxor flips it; the last bytes one by one. NEON on
  arm64: sub, cmhi against 26, and, eor, 16 bytes a step. }
procedure PasCaseMapCpu(Src, Dst: Pointer; N: Int64; Upper: Boolean);
begin
  asm amd64 (Src: in rsi; Dst: in rdi; N: in rcx; Upper: in rdx)
    movl $97, %r10d
    testq %rdx, %rdx
    jnz 1f
    movl $65, %r10d
    1:
    vmovd %r10d, %xmm0
    vpbroadcastb %xmm0, %ymm0
    movl $25, %eax
    vmovd %eax, %xmm1
    vpbroadcastb %xmm1, %ymm1
    movl $32, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    2:
    cmpq $32, %rcx
    jb 3f
    vmovdqu (%rsi), %ymm3
    vpsubb %ymm0, %ymm3, %ymm4
    vpminub %ymm1, %ymm4, %ymm5
    vpcmpeqb %ymm4, %ymm5, %ymm5
    vpand %ymm2, %ymm5, %ymm5
    vpxor %ymm5, %ymm3, %ymm3
    vmovdqu %ymm3, (%rdi)
    addq $32, %rsi
    addq $32, %rdi
    subq $32, %rcx
    jmp 2b
    3:
    cmpq $16, %rcx
    jb 4f
    vmovdqu (%rsi), %xmm3
    vpsubb %xmm0, %xmm3, %xmm4
    vpminub %xmm1, %xmm4, %xmm5
    vpcmpeqb %xmm4, %xmm5, %xmm5
    vpand %xmm2, %xmm5, %xmm5
    vpxor %xmm5, %xmm3, %xmm3
    vmovdqu %xmm3, (%rdi)
    addq $16, %rsi
    addq $16, %rdi
    subq $16, %rcx
    4:
    testq %rcx, %rcx
    jz 9f
    5:
    movzbl (%rsi), %r8d
    movl %r8d, %r9d
    subl %r10d, %r9d
    andl $255, %r9d
    cmpl $25, %r9d
    ja 6f
    xorl $32, %r8d
    6:
    movb %r8b, (%rdi)
    incq %rsi
    incq %rdi
    decq %rcx
    jnz 5b
    9:
    vzeroupper
  end;
  asm arm64 (Src: in x0; Dst: in x1; N: in x2; Upper: in x3)
    mov w4, #97
    cbnz x3, 1f
    mov w4, #65
    1:
    dup v0.16b, w4
    movi v1.16b, #26
    movi v2.16b, #32
    2:
    cmp x2, #16
    b.lo 3f
    ldr q3, [x0], #16
    sub v4.16b, v3.16b, v0.16b
    cmhi v5.16b, v1.16b, v4.16b
    and v5.16b, v5.16b, v2.16b
    eor v3.16b, v3.16b, v5.16b
    str q3, [x1], #16
    sub x2, x2, #16
    b 2b
    3:
    cbz x2, 9f
    ldrb w5, [x0], #1
    sub w6, w5, w4
    and w6, w6, #255
    cmp w6, #25
    b.hi 4f
    eor w5, w5, #32
    4:
    strb w5, [x1], #1
    sub x2, x2, #1
    b 3b
    9:
  end;
end;

procedure PasCaseMapBase(Src, Dst: Pointer; N: Int64; Upper: Boolean);
begin
  asm amd64 (Src: in rsi; Dst: in rdi; N: in rcx; Upper: in rdx)
    movl $97, %r10d
    testq %rdx, %rdx
    jnz 1f
    movl $65, %r10d
    1:
    movd %r10d, %xmm0
    punpcklbw %xmm0, %xmm0
    punpcklbw %xmm0, %xmm0
    pshufd $0, %xmm0, %xmm0
    movl $0x19191919, %eax
    movd %eax, %xmm1
    pshufd $0, %xmm1, %xmm1
    movl $0x20202020, %eax
    movd %eax, %xmm2
    pshufd $0, %xmm2, %xmm2
    2:
    cmpq $16, %rcx
    jb 4f
    movdqu (%rsi), %xmm3
    movdqa %xmm3, %xmm4
    psubb %xmm0, %xmm4
    movdqa %xmm4, %xmm5
    pminub %xmm1, %xmm5
    pcmpeqb %xmm4, %xmm5
    pand %xmm2, %xmm5
    pxor %xmm5, %xmm3
    movdqu %xmm3, (%rdi)
    addq $16, %rsi
    addq $16, %rdi
    subq $16, %rcx
    jmp 2b
    4:
    testq %rcx, %rcx
    jz 9f
    5:
    movzbl (%rsi), %r8d
    movl %r8d, %r9d
    subl %r10d, %r9d
    andl $255, %r9d
    cmpl $25, %r9d
    ja 6f
    xorl $32, %r8d
    6:
    movb %r8b, (%rdi)
    incq %rsi
    incq %rdi
    decq %rcx
    jnz 5b
    9:
  end;
  asm arm64 (Src: in x0; Dst: in x1; N: in x2; Upper: in x3)
    mov w4, #97
    cbnz x3, 1f
    mov w4, #65
    1:
    dup v0.16b, w4
    movi v1.16b, #26
    movi v2.16b, #32
    2:
    cmp x2, #16
    b.lo 3f
    ldr q3, [x0], #16
    sub v4.16b, v3.16b, v0.16b
    cmhi v5.16b, v1.16b, v4.16b
    and v5.16b, v5.16b, v2.16b
    eor v3.16b, v3.16b, v5.16b
    str q3, [x1], #16
    sub x2, x2, #16
    b 2b
    3:
    cbz x2, 9f
    ldrb w5, [x0], #1
    sub w6, w5, w4
    and w6, w6, #255
    cmp w6, #25
    b.hi 4f
    eor w5, w5, #32
    4:
    strb w5, [x1], #1
    sub x2, x2, #1
    b 3b
    9:
  end;
end;

{ ---- Pos ---- }

{ Rabin-Karp over S[From..N-1] for Sub (Go's IndexRabinKarp): the place
  from 0 in S, -1 when there is none. }
function RabinKarp(Sp, Sb: PByte; N, NS, From: Int64; Cpu: Boolean): Int64;
var
  hs, pw, sq, h: UInt32;
  i, k: Int64;
begin
  Result := -1;
  hs := 0;
  for i := 0 to NS - 1 do
    hs := hs * PrimeRK + Sb[i];
  pw := 1;
  sq := PrimeRK;
  k := NS;
  while k > 0 do
  begin
    if (k and 1) <> 0 then
      pw := pw * sq;
    sq := sq * sq;
    k := k shr 1;
  end;
  if N - From < NS then
    Exit;
  h := 0;
  for i := From to From + NS - 1 do
    h := h * PrimeRK + Sp[i];
  i := From + NS;
  while True do
  begin
    if h = hs then
    begin
      if Cpu then
      begin
        if PasMemEqCpu(@Sp[i - NS], Sb, NS) then
        begin
          Result := i - NS;
          Exit;
        end;
      end
      else if PasMemEqBase(@Sp[i - NS], Sb, NS) then
      begin
        Result := i - NS;
        Exit;
      end;
    end;
    if i >= N then
      Exit;
    h := h * PrimeRK + Sp[i];
    h := h - pw * Sp[i - NS];
    i := i + 1;
  end;
end;

{ The place from 0 of Sub (NS bytes) in S (N bytes) from byte From on,
  -1 when it is not there: Go's stringslite.Index, IndexByte to the
  next first byte, MemEq for the rest, Rabin-Karp once the first byte
  has matched too often in vain. }
function IndexOf(Sp, Sb: PByte; N, NS, From: Int64; Cpu: Boolean): Int64;
var
  c0, c1: Int64;
  i, t, o, fails: Int64;
  eq: Boolean;
begin
  Result := -1;
  if NS > N - From then
    Exit;
  c0 := Sb[0];
  if NS = 1 then
  begin
    if Cpu then
      o := PasIndexByteCpu(@Sp[From], N - From, c0)
    else
      o := PasIndexByteBase(@Sp[From], N - From, c0);
    if o >= 0 then
      Result := From + o;
    Exit;
  end;
  c1 := Sb[1];
  i := From;
  t := N - NS + 1;
  fails := 0;
  while i < t do
  begin
    if Sp[i] <> c0 then
    begin
      if Cpu then
        o := PasIndexByteCpu(@Sp[i + 1], t - i - 1, c0)
      else
        o := PasIndexByteBase(@Sp[i + 1], t - i - 1, c0);
      if o < 0 then
        Exit;
      i := i + o + 1;
    end;
    if Sp[i + 1] = c1 then
    begin
      if Cpu then
        eq := PasMemEqCpu(@Sp[i], Sb, NS)
      else
        eq := PasMemEqBase(@Sp[i], Sb, NS);
      if eq then
      begin
        Result := i;
        Exit;
      end;
    end;
    i := i + 1;
    fails := fails + 1;
    if (fails >= 4 + (i shr 4)) and (i < t) then
    begin
      Result := RabinKarp(Sp, Sb, N, NS, i, Cpu);
      Exit;
    end;
  end;
end;

{ Pos(Sub, S, Offset), as Free Pascal: the place from 1 of the first
  Sub in S at Offset or after, 0 when there is none, when Sub is empty
  or when Offset is below 1 or past S. }
function PosOf(const Sub, S: string; Offset: Int64; Cpu: Boolean): Int64;
var
  r: Int64;
begin
  Result := 0;
  if (Length(Sub) = 0) or (Offset < 1) or (Offset > Length(S)) then
    Exit;
  r := IndexOf(PByte(@S[1]), PByte(@Sub[1]), Length(S), Length(Sub), Offset - 1, Cpu);
  if r >= 0 then
    Result := r + 1;
end;

function PasPosCpu(const Sub, S: string; Offset: Int64): Int64;
begin
  Result := PosOf(Sub, S, Offset, True);
end;

function PasPosBase(const Sub, S: string; Offset: Int64): Int64;
begin
  Result := PosOf(Sub, S, Offset, False);
end;

function PasPosCharCpu(C: Char; const S: string; Offset: Int64): Int64;
var
  r: Int64;
begin
  Result := 0;
  if (Offset < 1) or (Offset > Length(S)) then
    Exit;
  r := PasIndexByteCpu(@S[Offset], Length(S) - Offset + 1, Ord(C));
  if r >= 0 then
    Result := Offset + r;
end;

function PasPosCharBase(C: Char; const S: string; Offset: Int64): Int64;
var
  r: Int64;
begin
  Result := 0;
  if (Offset < 1) or (Offset > Length(S)) then
    Exit;
  r := PasIndexByteBase(@S[Offset], Length(S) - Offset + 1, Ord(C));
  if r >= 0 then
    Result := Offset + r;
end;

{ ---- Case ---- }

function MapCase(const S: string; Upper, Cpu: Boolean): string;
begin
  Result := '';
  if Length(S) = 0 then
    Exit;
  SetLength(Result, Length(S));
  if Cpu then
    PasCaseMapCpu(@S[1], @Result[1], Length(S), Upper)
  else
    PasCaseMapBase(@S[1], @Result[1], Length(S), Upper);
end;

function PasUpperCpu(const S: string): string;
begin
  Result := MapCase(S, True, True);
end;

function PasUpperBase(const S: string): string;
begin
  Result := MapCase(S, True, False);
end;

function PasLowerCpu(const S: string): string;
begin
  Result := MapCase(S, False, True);
end;

function PasLowerBase(const S: string): string;
begin
  Result := MapCase(S, False, False);
end;

{ ---- Insert, Delete, StringOfChar ---- }

{ Insert(Src, S, Index), as Free Pascal: Src goes in before S[Index],
  at the start when Index is below 1, at the end when it is past S. }
procedure PasInsertStr(const Src: string; var S: string; Index: Int64);
var
  n, k: Int64;
  r: string;
begin
  k := Length(Src);
  if k = 0 then
    Exit;
  n := Length(S);
  if Index < 1 then
    Index := 1;
  if Index > n + 1 then
    Index := n + 1;
  r := '';
  SetLength(r, n + k);
  if Index > 1 then
    Move(S[1], r[1], Index - 1);
  Move(Src[1], r[Index], k);
  if Index <= n then
    Move(S[Index], r[Index + k], n - Index + 1);
  S := r;
end;

{ Delete(S, Index, Count), as Free Pascal: Count characters from
  S[Index] on, to the end when there are fewer; nothing when Index is
  below 1 or past S or Count is not above 0. }
procedure PasDeleteStr(var S: string; Index, Count: Int64);
var
  n: Int64;
  r: string;
begin
  n := Length(S);
  if (Index < 1) or (Index > n) or (Count <= 0) then
    Exit;
  if Count > n - Index + 1 then
    Count := n - Index + 1;
  r := '';
  SetLength(r, n - Count);
  if Index > 1 then
    Move(S[1], r[1], Index - 1);
  if Index + Count <= n then
    Move(S[Index + Count], r[Index], n - Index - Count + 1);
  S := r;
end;

{ N characters C, none when N is not above 0. }
function PasStringOfChar(C: Char; N: Int64): string;
begin
  Result := '';
  if N <= 0 then
    Exit;
  SetLength(Result, N);
  FillChar(Result[1], N, Ord(C));
end;

{ ---- Val ---- }

{ A number's text as Free Pascal's Val reads it: blanks and tabs first,
  a sign, then decimal digits, or $ (or 0x or x) and hexadecimal ones,
  % and binary ones, & and octal ones; a NUL ends it. Code is 0, or the
  place from 1 of the first character that is none of it (the end's
  place when the digits are missing, the digit's where 64 bits
  overflow); an unsigned type's number takes no minus, the place of
  its first digit said. }
function PasValInt(const S: string; Unsigned: Boolean; out Code: Int64): Int64;
var
  i, n, base, d, acc: Int64;
  neg: Boolean;
  c: Char;
begin
  Result := 0;
  n := Length(S);
  i := 1;
  while (i <= n) and ((S[i] = ' ') or (S[i] = #9)) do
    i := i + 1;
  Code := i;
  if (i > n) or (S[i] = #0) then
    Exit;
  neg := False;
  if S[i] = '-' then
  begin
    neg := True;
    i := i + 1;
  end
  else if S[i] = '+' then
    i := i + 1;
  base := 10;
  if i <= n then
  begin
    if S[i] = '$' then
    begin
      base := 16;
      i := i + 1;
    end
    else if S[i] = '%' then
    begin
      base := 2;
      i := i + 1;
    end
    else if S[i] = '&' then
    begin
      base := 8;
      i := i + 1;
    end
    else if (S[i] = 'x') or (S[i] = 'X') then
    begin
      base := 16;
      i := i + 1;
    end
    else if (S[i] = '0') and (i < n) and ((S[i + 1] = 'x') or (S[i + 1] = 'X')) then
    begin
      base := 16;
      i := i + 2;
    end;
  end;
  Code := i;
  if (i > n) or (S[i] = #0) then
    Exit;
  if neg and Unsigned then
    Exit;
  acc := 0;
  while (i <= n) and (S[i] <> #0) do
  begin
    c := S[i];
    if (c >= '0') and (c <= '9') then
      d := Ord(c) - 48
    else if (c >= 'a') and (c <= 'f') then
      d := Ord(c) - 87
    else if (c >= 'A') and (c <= 'F') then
      d := Ord(c) - 55
    else
      d := 99;
    if d >= base then
    begin
      Code := i;
      Result := 0;
      Exit;
    end;
    if (base = 10) and Unsigned then
    begin
      { an unsigned number to 2^64 - 1, as Free Pascal's Val reads one
        for a QWord, a Cardinal, a Word or a Byte (P142): acc stays below
        2^63 until the last step, which may set the top bit }
      if (acc > 1844674407370955161) or ((acc = 1844674407370955161) and (d > 5)) then
      begin
        Code := i;
        Result := 0;
        Exit;
      end;
      acc := acc * 10 + d;
    end
    else if base = 10 then
    begin
      { worked out below zero, where Int64 reaches one further }
      if (acc < -922337203685477580) or ((acc = -922337203685477580) and (d > 8)) then
      begin
        Code := i;
        Result := 0;
        Exit;
      end;
      acc := acc * 10 - d;
    end
    else
    begin
      { hexadecimal, octal, binary: any 64 bits }
      if (base = 16) and ((acc shr 60) <> 0) or (base = 8) and ((acc shr 61) <> 0) or
        (base = 2) and ((acc shr 63) <> 0) then
      begin
        Code := i;
        Result := 0;
        Exit;
      end;
      if base = 16 then
        acc := (acc shl 4) or d
      else if base = 8 then
        acc := (acc shl 3) or d
      else
        acc := (acc shl 1) or d;
    end;
    i := i + 1;
  end;
  if (base = 10) and Unsigned then
    Result := acc
  else if base = 10 then
  begin
    if neg then
      Result := acc
    else if acc = Low(Int64) then
    begin
      { 2^63 has no Int64: the last digit overflows }
      Code := i - 1;
      Exit;
    end
    else
      Result := -acc;
  end
  else if neg then
    Result := -acc
  else
    Result := acc;
  Code := 0;
end;

{ A real's text as Val reads it: blanks, a sign, digits with a point
  among or after them, an exponent; Code as PasValInt's. T is the text
  as pasfmt's parsers read it, AStart where it begins; False with Code
  at the first character that is not a real's. }
function ValRealText(const S: string; out Code: Int64; out T: string; out AStart: Int64): Boolean;
var
  i, n, start, nd, k: Int64;
begin
  Result := False;
  T := '';
  AStart := 1;
  n := Length(S);
  i := 1;
  while (i <= n) and ((S[i] = ' ') or (S[i] = #9)) do
    i := i + 1;
  Code := i;
  if (i > n) or (S[i] = #0) then
    Exit;
  start := i;
  if (S[i] = '-') or (S[i] = '+') then
    i := i + 1;
  nd := 0;
  while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
  begin
    i := i + 1;
    nd := nd + 1;
  end;
  if (i <= n) and (S[i] = '.') then
  begin
    i := i + 1;
    while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
    begin
      i := i + 1;
      nd := nd + 1;
    end;
  end;
  if nd = 0 then
  begin
    Code := i;
    Exit;
  end;
  if (i <= n) and ((S[i] = 'e') or (S[i] = 'E')) then
  begin
    i := i + 1;
    if (i <= n) and ((S[i] = '-') or (S[i] = '+')) then
      i := i + 1;
    if (i > n) or (S[i] < '0') or (S[i] > '9') then
    begin
      Code := i;
      Exit;
    end;
    while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
      i := i + 1;
  end;
  if (i <= n) and (S[i] <> #0) then
  begin
    Code := i;
    Exit;
  end;
  { the digits as PasParseReal reads them: a 0 before a leading point
    and after a trailing one }
  for k := start to i - 1 do
  begin
    if (S[k] = '.') and ((k = start) or (S[k - 1] < '0') or (S[k - 1] > '9')) then
      T := T + '0';
    T := T + S[k];
    if (S[k] = '.') and ((k = i - 1) or (S[k + 1] < '0') or (S[k + 1] > '9')) then
      T := T + '0';
  end;
  if (Length(T) > 0) and (T[1] = '+') then
    T := Copy(T, 2, Length(T) - 1);
  AStart := start;
  Result := True;
end;

{ The value is the nearest Double, pasfmt's PasParseReal. }
function PasValReal(const S: string; out Code: Int64): Double;
var
  t: string;
  start, bits: Int64;
begin
  Result := 0;
  if not ValRealText(S, Code, t, start) then
    Exit;
  if not PasParseReal(t, bits) then
  begin
    Code := start;
    Exit;
  end;
  Result := (bits as Double);
  Code := 0;
end;

{ The nearest Single, rounded once from the digits (P146), pasfmt's
  PasParseSingle, as Go's ParseFloat(s, 32): through a Double it could
  be one off. Free Pascal reads an Extended first and rounds that
  again. }
function PasValSingle(const S: string; out Code: Int64): Single;
var
  t: string;
  start, bits: Int64;
  sb: Int32;
begin
  Result := 0;
  if not ValRealText(S, Code, t, start) then
    Exit;
  if not PasParseSingle(t, bits) then
  begin
    Code := start;
    Exit;
  end;
  sb := Int32(bits);
  Result := (sb as Single);
  Code := 0;
end;

{ The Quad nearest the digits, rounded once (P146), pasfmt's
  PasParseQuad: its low word, and its high word in Hi. Through a Double
  it kept 53 bits of the 113. }
function PasValQuadLo(const S: string; out Code, Hi: Int64): Int64;
var
  t: string;
  start, lo: Int64;
begin
  Result := 0;
  Hi := 0;
  if not ValRealText(S, Code, t, start) then
    Exit;
  if not PasParseQuad(t, lo, Hi) then
  begin
    Code := start;
    Hi := 0;
    Exit;
  end;
  Result := lo;
  Code := 0;
end;

{ Names: an enumeration's members, each followed by a NUL; the one S
  names, whatever its case, and Code 0; else -1 and Code 1. }
function PasValEnum(const S: string; const Names: string; out Code: Int64): Int64;
var
  i, k, st: Int64;
  w: string;
begin
  Result := 0;
  Code := 1;
  k := 0;
  st := 1;
  for i := 1 to Length(Names) do
    if Names[i] = #0 then
    begin
      w := Copy(Names, st, i - st);
      if (Length(w) = Length(S)) and (MapCase(w, True, False) = MapCase(S, True, False)) then
      begin
        Result := k;
        Code := 0;
        Exit;
      end;
      k := k + 1;
      st := i + 1;
    end;
end;

{ The name of member V of the enumeration whose names Names holds, as
  PasValEnum reads them; its number when V is none of them. Width W pads
  it on the right with blanks, as Free Pascal's Str does. }
function PasEnumName(V: Int64; const Names: string; W: Int64): string;
var
  i, k, st: Int64;
begin
  k := 0;
  st := 1;
  for i := 1 to Length(Names) do
    if Names[i] = #0 then
    begin
      if k = V then
      begin
        Result := Copy(Names, st, i - st);
        while Length(Result) < W do
          Result := Result + ' ';
        Exit;
      end;
      k := k + 1;
      st := i + 1;
    end;
  Result := PasFmtInt(V, W);
end;

end.
