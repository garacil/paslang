    movq (%rsi), %rcx
    movq (%rdi), %rdx
    xorq %rcx, %rdx
    jnz 31f
    leaq -8(%rsi,%rbx), %rsi
    leaq -8(%rdi,%rbx), %rdi
    movq (%rsi), %rcx
    movq (%rdi), %rdx
    xorq %rcx, %rdx
    jz 9f
    31:
    bsfq %rdx, %rdx
    shrq $3, %rdx
    movzbl (%rsi,%rdx), %eax
    movzbl (%rdi,%rdx), %ecx
    subq %rcx, %rax
    jmp 9f
    32:
    testq %rbx, %rbx
    jle 9f
    33:
    movzbl (%rsi), %eax
    movzbl (%rdi), %ecx
    subq %rcx, %rax
    jnz 9f
    incq %rsi
    incq %rdi
    decq %rbx
    jnz 33b
    9:
