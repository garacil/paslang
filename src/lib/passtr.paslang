{ ---- CaseCmp ---- }

{ CompareText's comparison (P147): the difference of the first bytes of A
  and B that differ once the ASCII letters of both are capitals, 0 when
  their N bytes are equal so, or N is not above 0: the reference the
  kernels are held to. }
function PasCaseCmpPlain(A, B: Pointer; N: Int64): Int64;
var
  i, c, d: Int64;
begin
  Result := 0;
  for i := 0 to N - 1 do
  begin
    c := PByte(A)[i];
    d := PByte(B)[i];
    if (c >= 97) and (c <= 122) then
      c := c - 32;
    if (d >= 97) and (d <= 122) then
      d := d - 32;
    if c <> d then
    begin
      Result := c - d;
      Exit;
    end;
  end;
end;

{ CmpByte's walk with both runs made capitals first, as CaseMap makes
  them: a byte less 'a' that is at most 25 is a letter, whose bit 32
  goes (vpsubb, vpminub and vpcmpeqb mark them, vpand keeps 32 of the
  mark, vpxor clears it); AVX2 32 bytes a step, the last 32 read ending
  at the end, then the place of the first difference by bsf and its two
  bytes made capitals again. Under 32 bytes the SSE2 body of the base.
  On arm64 NEON, part of the base: sub, cmhi against 26, and and eor
  make the capitals over 16 bytes, cmeq, not and shrn find the place. }
