    pand %xmm5, %xmm2
    pxor %xmm2, %xmm1
    pcmpeqb %xmm1, %xmm0
    pmovmskb %xmm0, %edx
    xorl $0xffff, %edx
    jnz 26f
    addq $16, %rsi
