{ ---- CmpByte ---- }

{ CompareByte (P147): the difference of the first bytes of A and B that
  differ, 0 when their N bytes are equal or N is not above 0: the
  reference the kernels are held to. }
function PasCmpBytePlain(A, B: Pointer; N: Int64): Int64;
var
  i: Int64;
begin
  Result := 0;
  for i := 0 to N - 1 do
    if PByte(A)[i] <> PByte(B)[i] then
    begin
      Result := Int64(PByte(A)[i]) - Int64(PByte(B)[i]);
      Exit;
    end;
end;

{ After Go's cmpbody (compare_amd64.s), with the place of the first
  difference kept, since the result is its bytes' difference: AVX2's
  vpcmpeqb over 64 bytes a step, then 32, the last 32 read ending at the
  end; the mask of equal bytes inverted by xor (not sets no flag) and bsf
  for the first one that differs. Under 32 bytes the SSE2 path of the
  base. On arm64 NEON, part of the base: cmeq over 16 bytes, not, and a
  64-bit syndrome of four bits a byte (shrn by 4), rbit and clz for the
  first; under 16, two 8-byte words and eor, under 8 a byte at a time. }
function PasCmpByteCpu(A, B: Pointer; N: Int64): Int64;
begin
