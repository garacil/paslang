    movl $0xBE, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 256(%rsp)
    movl $0xBF, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 288(%rsp)
    movl $0xCF, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 320(%rsp)
    movl $0x8F, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 352(%rsp)
    movl $0xF0, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 384(%rsp)
