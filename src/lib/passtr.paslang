    vpand %ymm5, %ymm2, %ymm2
    vpxor %ymm2, %ymm0, %ymm0
    vpsubb %ymm7, %ymm1, %ymm2
    vpminub %ymm6, %ymm2, %ymm3
    vpcmpeqb %ymm3, %ymm2, %ymm2
    vpand %ymm5, %ymm2, %ymm2
    vpxor %ymm2, %ymm1, %ymm1
    vpcmpeqb %ymm1, %ymm0, %ymm0
    vpmovmskb %ymm0, %edx
    xorl $0xffffffff, %edx
    jnz 6f
    addq $32, %rsi
    addq $32, %rdi
    subq $32, %rbx
    cmpq $32, %rbx
    jae 1b
    testq %rbx, %rbx
    jz 8f
    leaq -32(%rsi,%rbx), %rsi
    leaq -32(%rdi,%rbx), %rdi
    movq $32, %rbx
    jmp 1b
    6:
