    ldr x5, [x3]
    ldr x6, [x1]
    eor x7, x5, x6
    cbnz x7, 21f
    sub x4, x2, #8
    add x3, x3, x4
    add x1, x1, x4
    ldr x5, [x3]
    ldr x6, [x1]
