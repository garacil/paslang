    add x1, x1, #16
    sub x2, x2, #16
    cmp x2, #16
    b.hs 1b
    cbz x2, 9f
    sub x5, x2, #16
    add x3, x3, x5
    add x1, x1, x5
    ldr q0, [x3]
    ldr q1, [x1]
    cmeq v2.16b, v0.16b, v1.16b
    not v2.16b, v2.16b
    shrn v3.8b, v2.8h, #4
    fmov x4, d3
    cbz x4, 9f
    6:
    rbit x4, x4
    clz x4, x4
    lsr x4, x4, #2
    ldrb w5, [x3, x4]
    ldrb w6, [x1, x4]
    sub x0, x5, x6
    b 9f
