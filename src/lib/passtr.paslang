{$ifndef CPUAARCH64}
{ The run P[0..N-1] read from a sequence's start on the base processor
  (amd64): SSE2 skips ASCII, 64 bytes a step by four MOVDQU, POR and one
  PMOVMSKB, then 16 at a time with BSF to the first byte that is not
  (Go's Valid skips 32 a step by words of eight); the rest is Go's
  utf8.Valid automaton (golang src/unicode/utf8/utf8.go: the second
  byte's range by the lead, 80h to BFh after it), written out in
  compares. -1 when every sequence is right, the place of the first
  that is not, or -2 - k when the end cuts the sequence that starts at
  k (its bytes so far for the caller to check). IJson refuses the
  noncharacters as the Plain body does. }
function Utf8ScanBase(P: Pointer; N: Int64; IJson: Boolean): Int64;
begin
  asm amd64 (P: in rsi; N: in rbx; IJson: in rcx; Result: out rax)
    movq %rsi, %r9
    leaq (%rsi,%rbx), %rdx
    .p2align 5
    1:
    movq %rdx, %rax
    subq %rsi, %rax
    cmpq $64, %rax
    jb 3f
    .p2align 5
    2:
    movdqu (%rsi), %xmm0
    movdqu 16(%rsi), %xmm1
    movdqu 32(%rsi), %xmm2
    movdqu 48(%rsi), %xmm3
    por %xmm1, %xmm0
    por %xmm3, %xmm2
    por %xmm2, %xmm0
    pmovmskb %xmm0, %eax
    testl %eax, %eax
    jnz 3f
    addq $64, %rsi
    movq %rdx, %rax
    subq %rsi, %rax
    cmpq $64, %rax
    jae 2b
    .p2align 5
    3:
    movq %rdx, %rax
    subq %rsi, %rax
    cmpq $16, %rax
    jb 5f
    movdqu (%rsi), %xmm0
    pmovmskb %xmm0, %eax
    testl %eax, %eax
    jnz 4f
    addq $16, %rsi
    jmp 3b
    4:
    bsfl %eax, %eax
    addq %rax, %rsi
    jmp 6f
    .p2align 5
    5:
    cmpq %rdx, %rsi
    jae 90f
    movzbl (%rsi), %eax
    cmpl $0x80, %eax
    jae 6f
    incq %rsi
    jmp 5b
    .p2align 5
    6:
    movzbl (%rsi), %eax
    cmpl $0xC2, %eax
    jb 80f
    cmpl $0xE0, %eax
    jae 61f
    leaq 2(%rsi), %r10
    cmpq %rdx, %r10
    ja 70f
    movzbl 1(%rsi), %r11d
    xorl $0x80, %r11d
    cmpl $0x40, %r11d
    jae 80f
    movq %r10, %rsi
    jmp 7f
    61:
    cmpl $0xF0, %eax
    jae 64f
    leaq 3(%rsi), %r10
    cmpq %rdx, %r10
    ja 70f
    movzbl 1(%rsi), %r11d
    movl $0x80, %r8d
    cmpl $0xE0, %eax
    jne 62f
    movl $0xA0, %r8d
    62:
    cmpl %r8d, %r11d
    jb 80f
    movl $0xBF, %r8d
    cmpl $0xED, %eax
    jne 63f
    movl $0x9F, %r8d
    63:
    cmpl %r8d, %r11d
    ja 80f
    movzbl 2(%rsi), %r8d
    xorl $0x80, %r8d
    cmpl $0x40, %r8d
    jae 80f
    testq %rcx, %rcx
    jz 69f
    cmpl $0xEF, %eax
    jne 69f
    cmpl $0xB7, %r11d
    jne 65f
    cmpl $0x10, %r8d
    jb 69f
    cmpl $0x2F, %r8d
    jbe 80f
    jmp 69f
    65:
    cmpl $0xBF, %r11d
    jne 69f
    andl $0xFE, %r8d
    cmpl $0x3E, %r8d
    je 80f
    69:
    movq %r10, %rsi
    jmp 7f
    64:
    cmpl $0xF4, %eax
    ja 80f
    leaq 4(%rsi), %r10
    cmpq %rdx, %r10
    ja 70f
    movzbl 1(%rsi), %r11d
    movl $0x80, %r8d
    cmpl $0xF0, %eax
    jne 66f
    movl $0x90, %r8d
    66:
    cmpl %r8d, %r11d
    jb 80f
    movl $0xBF, %r8d
    cmpl $0xF4, %eax
    jne 67f
    movl $0x8F, %r8d
    67:
    cmpl %r8d, %r11d
    ja 80f
    movzbl 2(%rsi), %r8d
    xorl $0x80, %r8d
    cmpl $0x40, %r8d
    jae 80f
    movzbl 3(%rsi), %eax
    xorl $0x80, %eax
    cmpl $0x40, %eax
    jae 80f
    testq %rcx, %rcx
    jz 68f
    andl $0x0F, %r11d
    cmpl $0x0F, %r11d
    jne 68f
    cmpl $0x3F, %r8d
    jne 68f
    andl $0x3E, %eax
    cmpl $0x3E, %eax
    je 80f
    68:
    movq %r10, %rsi
    7:
    cmpq %rdx, %rsi
    jae 90f
    movzbl (%rsi), %eax
    cmpl $0x80, %eax
    jae 6b
    jmp 1b
    70:
    movq %r9, %rax
    subq %rsi, %rax
    subq $2, %rax
    jmp 99f
    80:
    movq %rsi, %rax
    subq %r9, %rax
    jmp 99f
    90:
    movq $-1, %rax
