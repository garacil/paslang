    movl $0xB7, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 160(%rsp)
    movl $0xE0, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 192(%rsp)
    movl $0xFE, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
