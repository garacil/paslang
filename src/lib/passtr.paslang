    bsfl %edx, %edx
    movzbl (%rsi,%rdx), %eax
    movzbl (%rdi,%rdx), %ecx
    subq %rcx, %rax
    jmp 9f
    8:
    vzeroupper
    xorl %eax, %eax
    jmp 9f
    20:
    cmpq $16, %rbx
    jl 30f
    movdqu (%rsi), %xmm0
    movdqu (%rdi), %xmm1
    pcmpeqb %xmm1, %xmm0
    pmovmskb %xmm0, %edx
    xorl $0xffff, %edx
    jnz 26f
