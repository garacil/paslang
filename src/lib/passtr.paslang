    subl $32, %eax
    41:
    movzbl (%rdi,%rdx), %ecx
    leal -97(%rcx), %r8d
    cmpl $25, %r8d
    ja 42f
    subl $32, %ecx
    42:
    subq %rcx, %rax
    9:
  end;
  asm arm64 (A: in x0; B: in x1; N: in x2; Result: out x0)
    mov x3, x0
    mov x0, #0
    cmp x2, #16
    b.lt 30f
    movi v7.16b, #0x61
    movi v6.16b, #26
    movi v5.16b, #0x20
    .p2align 5
    1:
    ldr q0, [x3]
    ldr q1, [x1]
    sub v2.16b, v0.16b, v7.16b
    cmhi v2.16b, v6.16b, v2.16b
    and v2.16b, v2.16b, v5.16b
    eor v0.16b, v0.16b, v2.16b
    sub v2.16b, v1.16b, v7.16b
    cmhi v2.16b, v6.16b, v2.16b
    and v2.16b, v2.16b, v5.16b
    eor v1.16b, v1.16b, v2.16b
    cmeq v2.16b, v0.16b, v1.16b
    not v2.16b, v2.16b
    shrn v3.8b, v2.8h, #4
    fmov x4, d3
    cbnz x4, 6f
    add x3, x3, #16
    add x1, x1, #16
    sub x2, x2, #16
    cmp x2, #16
    b.hs 1b
    cbz x2, 9f
    sub x5, x2, #16
    add x3, x3, x5
    add x1, x1, x5
    mov x2, #16
    b 1b
    6:
    rbit x4, x4
    clz x4, x4
    lsr x4, x4, #2
    b 40f
    30:
    cmp x2, #0
    b.le 9f
    mov x4, #0
    .p2align 5
    31:
    ldrb w5, [x3, x4]
    sub w8, w5, #97
    cmp w8, #25
    b.hi 32f
    sub w5, w5, #32
    32:
    ldrb w6, [x1, x4]
    sub w8, w6, #97
    cmp w8, #25
    b.hi 33f
    sub w6, w6, #32
    33:
    subs x0, x5, x6
    b.ne 9f
    add x4, x4, #1
    cmp x4, x2
    b.lo 31b
    b 9f
    40:
    ldrb w5, [x3, x4]
    sub w8, w5, #97
    cmp w8, #25
    b.hi 41f
    sub w5, w5, #32
    41:
    ldrb w6, [x1, x4]
    sub w8, w6, #97
    cmp w8, #25
    b.hi 42f
    sub w6, w6, #32
    42:
    sub x0, x5, x6
    9:
  end;
end;

{ The base: SSE2 16 bytes a step, the last 16 ending at the end; under
  16 a byte at a time. On arm64 the NEON body. }
function PasCaseCmpBase(A, B: Pointer; N: Int64): Int64;
begin
  asm amd64 (A: in rsi; B: in rdi; N: in rbx; Result: out rax)
    xorl %eax, %eax
    cmpq $16, %rbx
    jl 30f
    movl $0x61616161, %ecx
    movd %ecx, %xmm7
    pshufd $0, %xmm7, %xmm7
    movl $0x19191919, %ecx
    movd %ecx, %xmm6
    pshufd $0, %xmm6, %xmm6
    movl $0x20202020, %ecx
    movd %ecx, %xmm5
    pshufd $0, %xmm5, %xmm5
    .p2align 5
    21:
    movdqu (%rsi), %xmm0
    movdqu (%rdi), %xmm1
    movdqa %xmm0, %xmm2
    psubb %xmm7, %xmm2
    movdqa %xmm2, %xmm3
    pminub %xmm6, %xmm3
    pcmpeqb %xmm3, %xmm2
    pand %xmm5, %xmm2
    pxor %xmm2, %xmm0
    movdqa %xmm1, %xmm2
    psubb %xmm7, %xmm2
    movdqa %xmm2, %xmm3
    pminub %xmm6, %xmm3
    pcmpeqb %xmm3, %xmm2
    pand %xmm5, %xmm2
    pxor %xmm2, %xmm1
    pcmpeqb %xmm1, %xmm0
    pmovmskb %xmm0, %edx
    xorl $0xffff, %edx
    jnz 26f
    addq $16, %rsi
    addq $16, %rdi
    subq $16, %rbx
    cmpq $16, %rbx
    jae 21b
    testq %rbx, %rbx
    jz 9f
    leaq -16(%rsi,%rbx), %rsi
    leaq -16(%rdi,%rbx), %rdi
    movq $16, %rbx
    jmp 21b
    26:
    bsfl %edx, %edx
    jmp 40f
    30:
    testq %rbx, %rbx
    jle 9f
    xorl %edx, %edx
    .p2align 5
    31:
    movzbl (%rsi,%rdx), %eax
    leal -97(%rax), %r8d
    cmpl $25, %r8d
    ja 32f
    subl $32, %eax
    32:
    movzbl (%rdi,%rdx), %ecx
    leal -97(%rcx), %r8d
    cmpl $25, %r8d
    ja 33f
    subl $32, %ecx
    33:
    subq %rcx, %rax
    jnz 9f
    incq %rdx
    cmpq %rbx, %rdx
    jb 31b
    jmp 9f
    40:
    movzbl (%rsi,%rdx), %eax
    leal -97(%rax), %r8d
    cmpl $25, %r8d
    ja 41f
    subl $32, %eax
    41:
    movzbl (%rdi,%rdx), %ecx
    leal -97(%rcx), %r8d
    cmpl $25, %r8d
    ja 42f
    subl $32, %ecx
    42:
    subq %rcx, %rax
    9:
  end;
  asm arm64 (A: in x0; B: in x1; N: in x2; Result: out x0)
    mov x3, x0
    mov x0, #0
    cmp x2, #16
    b.lt 30f
    movi v7.16b, #0x61
    movi v6.16b, #26
    movi v5.16b, #0x20
    .p2align 5
    1:
    ldr q0, [x3]
    ldr q1, [x1]
    sub v2.16b, v0.16b, v7.16b
    cmhi v2.16b, v6.16b, v2.16b
    and v2.16b, v2.16b, v5.16b
    eor v0.16b, v0.16b, v2.16b
    sub v2.16b, v1.16b, v7.16b
    cmhi v2.16b, v6.16b, v2.16b
    and v2.16b, v2.16b, v5.16b
    eor v1.16b, v1.16b, v2.16b
    cmeq v2.16b, v0.16b, v1.16b
    not v2.16b, v2.16b
    shrn v3.8b, v2.8h, #4
    fmov x4, d3
    cbnz x4, 6f
    add x3, x3, #16
    add x1, x1, #16
    sub x2, x2, #16
    cmp x2, #16
    b.hs 1b
    cbz x2, 9f
    sub x5, x2, #16
    add x3, x3, x5
    add x1, x1, x5
    mov x2, #16
    b 1b
    6:
    rbit x4, x4
    clz x4, x4
    lsr x4, x4, #2
    b 40f
    30:
    cmp x2, #0
    b.le 9f
    mov x4, #0
    .p2align 5
    31:
    ldrb w5, [x3, x4]
    sub w8, w5, #97
    cmp w8, #25
    b.hi 32f
    sub w5, w5, #32
    32:
    ldrb w6, [x1, x4]
    sub w8, w6, #97
    cmp w8, #25
    b.hi 33f
    sub w6, w6, #32
    33:
    subs x0, x5, x6
    b.ne 9f
    add x4, x4, #1
    cmp x4, x2
    b.lo 31b
    b 9f
    40:
    ldrb w5, [x3, x4]
    sub w8, w5, #97
    cmp w8, #25
    b.hi 41f
    sub w5, w5, #32
    41:
    ldrb w6, [x1, x4]
    sub w8, w6, #97
    cmp w8, #25
    b.hi 42f
    sub w6, w6, #32
    42:
    sub x0, x5, x6
    9:
  end;
end;

{ ---- CaseMap ---- }

{ Dst[i] := Src[i] with the ASCII letters to upper case (Upper) or to
  lower case: a byte b is a letter to flip when b - First, a byte's
  wrap, is at most 25, First 'a' or 'A', and its bit 32 flips. }
procedure PasCaseMapPlain(Src, Dst: Pointer; N: Int64; Upper: Boolean);
var
  i, b, first: Int64;
begin
  if Upper then
    first := 97
  else
    first := 65;
  for i := 0 to N - 1 do
  begin
    b := PByte(Src)[i];
    if ((b - first) and 255) <= 25 then
      b := b xor 32;
    PByte(Dst)[i] := Byte(b);
  end;
end;

{ 32 bytes a step on AVX2 and 16 after, 16 on SSE2 (Base): vpsubb takes
  First away, vpminub against 25 and vpcmpeqb mark the letters, vpand
  keeps 32 there and vpxor flips it; the last bytes one by one. NEON on
  arm64: sub, cmhi against 26, and, eor, 16 bytes a step. }
procedure PasCaseMapCpu(Src, Dst: Pointer; N: Int64; Upper: Boolean);
begin
  asm amd64 (Src: in rsi; Dst: in rdi; N: in rcx; Upper: in rdx)
    movl $97, %r10d
    testq %rdx, %rdx
    jnz 1f
    movl $65, %r10d
    1:
    vmovd %r10d, %xmm0
    vpbroadcastb %xmm0, %ymm0
    movl $25, %eax
    vmovd %eax, %xmm1
    vpbroadcastb %xmm1, %ymm1
    movl $32, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    .p2align 5
    2:
    cmpq $32, %rcx
    jb 3f
    vmovdqu (%rsi), %ymm3
    vpsubb %ymm0, %ymm3, %ymm4
    vpminub %ymm1, %ymm4, %ymm5
    vpcmpeqb %ymm4, %ymm5, %ymm5
    vpand %ymm2, %ymm5, %ymm5
    vpxor %ymm5, %ymm3, %ymm3
    vmovdqu %ymm3, (%rdi)
    addq $32, %rsi
    addq $32, %rdi
    subq $32, %rcx
    jmp 2b
    3:
    cmpq $16, %rcx
    jb 4f
    vmovdqu (%rsi), %xmm3
    vpsubb %xmm0, %xmm3, %xmm4
    vpminub %xmm1, %xmm4, %xmm5
    vpcmpeqb %xmm4, %xmm5, %xmm5
    vpand %xmm2, %xmm5, %xmm5
    vpxor %xmm5, %xmm3, %xmm3
    vmovdqu %xmm3, (%rdi)
    addq $16, %rsi
    addq $16, %rdi
    subq $16, %rcx
    4:
    testq %rcx, %rcx
    jz 9f
    .p2align 5
    5:
    movzbl (%rsi), %r8d
    movl %r8d, %r9d
    subl %r10d, %r9d
    andl $255, %r9d
    cmpl $25, %r9d
    ja 6f
    xorl $32, %r8d
    6:
    movb %r8b, (%rdi)
    incq %rsi
    incq %rdi
    decq %rcx
    jnz 5b
    9:
    vzeroupper
  end;
  asm arm64 (Src: in x0; Dst: in x1; N: in x2; Upper: in x3)
    mov w4, #97
    cbnz x3, 1f
    mov w4, #65
    1:
    dup v0.16b, w4
    movi v1.16b, #26
    movi v2.16b, #32
    .p2align 5
    2:
    cmp x2, #16
    b.lo 3f
    ldr q3, [x0], #16
    sub v4.16b, v3.16b, v0.16b
    cmhi v5.16b, v1.16b, v4.16b
    and v5.16b, v5.16b, v2.16b
    eor v3.16b, v3.16b, v5.16b
    str q3, [x1], #16
    sub x2, x2, #16
    b 2b
    .p2align 5
    3:
    cbz x2, 9f
    ldrb w5, [x0], #1
    sub w6, w5, w4
    and w6, w6, #255
    cmp w6, #25
    b.hi 4f
    eor w5, w5, #32
    4:
    strb w5, [x1], #1
    sub x2, x2, #1
    b 3b
    9:
  end;
end;

procedure PasCaseMapBase(Src, Dst: Pointer; N: Int64; Upper: Boolean);
begin
  asm amd64 (Src: in rsi; Dst: in rdi; N: in rcx; Upper: in rdx)
    movl $97, %r10d
    testq %rdx, %rdx
    jnz 1f
    movl $65, %r10d
    1:
    movd %r10d, %xmm0
    punpcklbw %xmm0, %xmm0
    punpcklbw %xmm0, %xmm0
    pshufd $0, %xmm0, %xmm0
    movl $0x19191919, %eax
    movd %eax, %xmm1
    pshufd $0, %xmm1, %xmm1
    movl $0x20202020, %eax
    movd %eax, %xmm2
    pshufd $0, %xmm2, %xmm2
    .p2align 5
    2:
    cmpq $16, %rcx
    jb 4f
    movdqu (%rsi), %xmm3
    movdqa %xmm3, %xmm4
    psubb %xmm0, %xmm4
    movdqa %xmm4, %xmm5
    pminub %xmm1, %xmm5
    pcmpeqb %xmm4, %xmm5
    pand %xmm2, %xmm5
    pxor %xmm5, %xmm3
    movdqu %xmm3, (%rdi)
    addq $16, %rsi
    addq $16, %rdi
    subq $16, %rcx
    jmp 2b
    4:
    testq %rcx, %rcx
    jz 9f
    .p2align 5
    5:
    movzbl (%rsi), %r8d
    movl %r8d, %r9d
    subl %r10d, %r9d
    andl $255, %r9d
    cmpl $25, %r9d
    ja 6f
    xorl $32, %r8d
    6:
    movb %r8b, (%rdi)
    incq %rsi
    incq %rdi
    decq %rcx
    jnz 5b
    9:
  end;
  asm arm64 (Src: in x0; Dst: in x1; N: in x2; Upper: in x3)
    mov w4, #97
    cbnz x3, 1f
    mov w4, #65
    1:
    dup v0.16b, w4
    movi v1.16b, #26
    movi v2.16b, #32
    .p2align 5
    2:
    cmp x2, #16
    b.lo 3f
    ldr q3, [x0], #16
    sub v4.16b, v3.16b, v0.16b
    cmhi v5.16b, v1.16b, v4.16b
    and v5.16b, v5.16b, v2.16b
    eor v3.16b, v3.16b, v5.16b
    str q3, [x1], #16
    sub x2, x2, #16
    b 2b
    .p2align 5
    3:
    cbz x2, 9f
    ldrb w5, [x0], #1
    sub w6, w5, w4
    and w6, w6, #255
    cmp w6, #25
    b.hi 4f
    eor w5, w5, #32
    4:
    strb w5, [x1], #1
    sub x2, x2, #1
    b 3b
    9:
  end;
end;

{ ---- Slices ---- }

{ IndexByte and CompareByte (the compiler calls the body of the -cpu):
  the kernel at most StrMaxBytes a call (P270). A short run goes to it
  at once, a longer one to a loop of calls (a branch only: a loop's
  test, its preemption check among them, costs every call), a search
  going on in the next slice when one holds no match, a comparison the
  first slice's answer that is not 0, as one call gives it, since the
  answer is the difference of the first bytes that differ. }
function FindByteLongCpu(P: Pointer; N, C: Int64): Int64;
var
  done, r: Int64;
begin
  done := 0;
  while N - done > StrMaxBytes do
  begin
    r := PasIndexByteCpu(Pointer(Integer(P) + done), StrMaxBytes, C);
    if r >= 0 then
    begin
      Result := done + r;
      Exit;
    end;
    done := done + StrMaxBytes;
  end;
  r := PasIndexByteCpu(Pointer(Integer(P) + done), N - done, C);
  if r >= 0 then
    r := done + r;
  Result := r;
end;

function PasFindByteCpu(P: Pointer; N, C: Int64): Int64;
begin
  if N <= StrMaxBytes then
    Result := PasIndexByteCpu(P, N, C)
  else
    Result := FindByteLongCpu(P, N, C);
end;

function CompareByteLongCpu(A, B: Pointer; N: Int64): Int64;
var
  done: Int64;
begin
  done := 0;
  while N - done > StrMaxBytes do
  begin
    Result := PasCmpByteCpu(Pointer(Integer(A) + done), Pointer(Integer(B) + done), StrMaxBytes);
    if Result <> 0 then
      Exit;
    done := done + StrMaxBytes;
  end;
  Result := PasCmpByteCpu(Pointer(Integer(A) + done), Pointer(Integer(B) + done), N - done);
end;

function PasCompareByteCpu(A, B: Pointer; N: Int64): Int64;
begin
  if N <= StrMaxBytes then
    Result := PasCmpByteCpu(A, B, N)
  else
    Result := CompareByteLongCpu(A, B, N);
end;

{ The case map of N bytes, at most StrMaxBytes a call (P270). }
procedure CaseMapLongCpu(Src, Dst: PByte; N: Int64; Upper: Boolean);
var
  done: Int64;
begin
  done := 0;
  while N - done > StrMaxBytes do
  begin
    PasCaseMapCpu(@Src[done], @Dst[done], StrMaxBytes, Upper);
    done := done + StrMaxBytes;
  end;
  PasCaseMapCpu(@Src[done], @Dst[done], N - done, Upper);
end;

{ Whether A and B hold the same N bytes, MemEq at most StrMaxBytes a
  call: the check of a needle longer than that (P270). }
function MemEqLongCpu(A, B: PByte; N: Int64): Boolean;
var
  done: Int64;
begin
  done := 0;
  while N - done > StrMaxBytes do
  begin
    if not PasMemEqCpu(@A[done], @B[done], StrMaxBytes) then
    begin
      Result := False;
      Exit;
    end;
    done := done + StrMaxBytes;
  end;
  Result := PasMemEqCpu(@A[done], @B[done], N - done);
end;

function FindByteLongBase(P: Pointer; N, C: Int64): Int64;
var
  done, r: Int64;
begin
  done := 0;
  while N - done > StrMaxBytes do
  begin
    r := PasIndexByteBase(Pointer(Integer(P) + done), StrMaxBytes, C);
    if r >= 0 then
    begin
      Result := done + r;
      Exit;
    end;
    done := done + StrMaxBytes;
  end;
  r := PasIndexByteBase(Pointer(Integer(P) + done), N - done, C);
  if r >= 0 then
    r := done + r;
  Result := r;
end;

function PasFindByteBase(P: Pointer; N, C: Int64): Int64;
begin
  if N <= StrMaxBytes then
    Result := PasIndexByteBase(P, N, C)
  else
    Result := FindByteLongBase(P, N, C);
end;

function CompareByteLongBase(A, B: Pointer; N: Int64): Int64;
var
  done: Int64;
begin
  done := 0;
  while N - done > StrMaxBytes do
  begin
    Result := PasCmpByteBase(Pointer(Integer(A) + done), Pointer(Integer(B) + done), StrMaxBytes);
    if Result <> 0 then
      Exit;
    done := done + StrMaxBytes;
  end;
  Result := PasCmpByteBase(Pointer(Integer(A) + done), Pointer(Integer(B) + done), N - done);
end;

function PasCompareByteBase(A, B: Pointer; N: Int64): Int64;
begin
  if N <= StrMaxBytes then
    Result := PasCmpByteBase(A, B, N)
  else
    Result := CompareByteLongBase(A, B, N);
end;

{ The case map of N bytes, at most StrMaxBytes a call (P270). }
procedure CaseMapLongBase(Src, Dst: PByte; N: Int64; Upper: Boolean);
var
  done: Int64;
begin
  done := 0;
  while N - done > StrMaxBytes do
  begin
    PasCaseMapBase(@Src[done], @Dst[done], StrMaxBytes, Upper);
    done := done + StrMaxBytes;
  end;
  PasCaseMapBase(@Src[done], @Dst[done], N - done, Upper);
end;

{ Whether A and B hold the same N bytes, MemEq at most StrMaxBytes a
  call: the check of a needle longer than that (P270). }
function MemEqLongBase(A, B: PByte; N: Int64): Boolean;
var
  done: Int64;
begin
  done := 0;
  while N - done > StrMaxBytes do
  begin
    if not PasMemEqBase(@A[done], @B[done], StrMaxBytes) then
    begin
      Result := False;
      Exit;
    end;
    done := done + StrMaxBytes;
  end;
  Result := PasMemEqBase(@A[done], @B[done], N - done);
end;

{ ---- Pos ---- }

{ Rabin-Karp over S[From..N-1] for Sub (Go's IndexRabinKarp), its
  hashing apart from the check of a place, so each body of Pos checks
  with its own kernel and nothing is chosen at run time (P268, Regla
  8): RkStart gives Sub's hash Hs, the power Pw its first byte leaves
  in the window and the hash H of the first window, S[From..From+NS-1];
  RkNext the next place, from the window that ends before I on, whose
  hash is Sub's (-1 when there is none), the window moved past it. }
procedure RkStart(Sp, Sb: PByte; NS, From: Int64; out Hs, Pw, H: UInt32);
var
  sq: UInt32;
  i, k: Int64;
begin
  Hs := 0;
  for i := 0 to NS - 1 do
    Hs := Hs * PrimeRK + Sb[i];
  Pw := 1;
  sq := PrimeRK;
  k := NS;
  while k > 0 do
  begin
    if (k and 1) <> 0 then
      Pw := Pw * sq;
    sq := sq * sq;
    k := k shr 1;
  end;
  H := 0;
  for i := From to From + NS - 1 do
    H := H * PrimeRK + Sp[i];
end;

function RkNext(Sp: PByte; N, NS: Int64; Hs, Pw: UInt32; var I: Int64; var H: UInt32): Int64;
var
  hit: Boolean;
begin
  Result := -1;
  while I <= N do
  begin
    hit := H = Hs;
    if hit then
      Result := I - NS;
    if I < N then
    begin
      H := H * PrimeRK + Sp[I];
      H := H - Pw * Sp[I - NS];
    end;
    I := I + 1;
    if hit then
      Exit;
  end;
end;

{ The place from 0 in S of Sub by Rabin-Karp from byte From on, -1 when
  there is none: each body's place checked with its own MemEq. }
function RabinKarpCpu(Sp, Sb: PByte; N, NS, From: Int64): Int64;
var
  hs, pw, h: UInt32;
  i, p: Int64;
begin
  Result := -1;
  if N - From < NS then
    Exit;
  RkStart(Sp, Sb, NS, From, hs, pw, h);
  i := From + NS;
  repeat
    p := RkNext(Sp, N, NS, hs, pw, i, h);
    if (p >= 0) and PasMemEqCpu(@Sp[p], Sb, NS) then
    begin
      Result := p;
      Exit;
    end;
  until p < 0;
end;

{ A needle longer than StrMaxBytes (P270): Rabin-Karp all the way, linear
  as Pos's own, each place the hashes agree checked a slice at a time. }
function IndexOfLongCpu(Sp, Sb: PByte; N, NS, From: Int64): Int64;
var
  hs, pw, h: UInt32;
  i, p: Int64;
begin
  Result := -1;
  RkStart(Sp, Sb, NS, From, hs, pw, h);
  i := From + NS;
  repeat
    p := RkNext(Sp, N, NS, hs, pw, i, h);
    if (p >= 0) and MemEqLongCpu(@Sp[p], Sb, NS) then
    begin
      Result := p;
      Exit;
    end;
  until p < 0;
end;

function RabinKarpBase(Sp, Sb: PByte; N, NS, From: Int64): Int64;
var
  hs, pw, h: UInt32;
  i, p: Int64;
begin
  Result := -1;
  if N - From < NS then
    Exit;
  RkStart(Sp, Sb, NS, From, hs, pw, h);
  i := From + NS;
  repeat
    p := RkNext(Sp, N, NS, hs, pw, i, h);
    if (p >= 0) and PasMemEqBase(@Sp[p], Sb, NS) then
    begin
      Result := p;
      Exit;
    end;
  until p < 0;
end;

{ A needle longer than StrMaxBytes (P270): Rabin-Karp all the way, linear
  as Pos's own, each place the hashes agree checked a slice at a time. }
function IndexOfLongBase(Sp, Sb: PByte; N, NS, From: Int64): Int64;
var
  hs, pw, h: UInt32;
  i, p: Int64;
begin
  Result := -1;
  RkStart(Sp, Sb, NS, From, hs, pw, h);
  i := From + NS;
  repeat
    p := RkNext(Sp, N, NS, hs, pw, i, h);
    if (p >= 0) and MemEqLongBase(@Sp[p], Sb, NS) then
    begin
      Result := p;
      Exit;
    end;
  until p < 0;
end;

function IndexOfCpu(Sp, Sb: PByte; N, NS, From: Int64): Int64; forward;

{ A text with more than StrMaxBytes places for Sub after From (P270):
  IndexOf over each StrMaxBytes of them in turn, the text it is given
  ending where the last of them ends a match, so no call of a kernel
  and no Rabin-Karp goes further; the loop head between two is where
  the routine can be stopped. }
function IndexOfSlicesCpu(Sp, Sb: PByte; N, NS, From: Int64): Int64;
var
  i, n2: Int64;
begin
  i := From;
  repeat
    n2 := i + StrMaxBytes + NS - 1;
    if n2 > N then
      n2 := N;
    Result := IndexOfCpu(Sp, Sb, n2, NS, i);
    if Result >= 0 then
      Exit;
    i := i + StrMaxBytes;
  until i + NS > N;
  Result := -1;
end;

{ The place from 0 of Sub (NS bytes) in S (N bytes) from byte From on,
  -1 when it is not there: Go's stringslite.Index, IndexByte to the
  next first byte, MemEq for the rest, Rabin-Karp once the first byte
  has matched too often in vain. One body for each processor, the same
  steps, each calling its own kernels (P268): the choice is made when
  the program is compiled, by which of PasPosCpu and PasPosBase the
  compiler calls, and a program for the base links no AVX2 kernel. }
function IndexOfCpu(Sp, Sb: PByte; N, NS, From: Int64): Int64;
var
  c0, c1: Int64;
  i, t, o, fails: Int64;
begin
  Result := -1;
  if NS > N - From then
    Exit;
  if NS > StrMaxBytes then
  begin
    Result := IndexOfLongCpu(Sp, Sb, N, NS, From);
    Exit;
  end;
  c0 := Sb[0];
  if NS = 1 then
  begin
    o := PasFindByteCpu(@Sp[From], N - From, c0);
    if o >= 0 then
      Result := From + o;
    Exit;
  end;
  c1 := Sb[1];
  i := From;
  t := N - NS + 1;
  { more than StrMaxBytes places: a slice of them at a time (P270) }
  if t - i > StrMaxBytes then
  begin
    Result := IndexOfSlicesCpu(Sp, Sb, N, NS, From);
    Exit;
  end;
  fails := 0;
  while i < t do
  begin
    if Sp[i] <> c0 then
    begin
      o := PasIndexByteCpu(@Sp[i + 1], t - i - 1, c0);
      if o < 0 then
        Exit;
      i := i + o + 1;
    end;
    if (Sp[i + 1] = c1) and PasMemEqCpu(@Sp[i], Sb, NS) then
    begin
      Result := i;
      Exit;
    end;
    i := i + 1;
    fails := fails + 1;
    if (fails >= 4 + (i shr 4)) and (i < t) then
    begin
      Result := RabinKarpCpu(Sp, Sb, N, NS, i);
      Exit;
    end;
  end;
end;

function IndexOfBase(Sp, Sb: PByte; N, NS, From: Int64): Int64; forward;

{ A text with more than StrMaxBytes places for Sub after From (P270):
  IndexOf over each StrMaxBytes of them in turn, the text it is given
  ending where the last of them ends a match, so no call of a kernel
  and no Rabin-Karp goes further; the loop head between two is where
  the routine can be stopped. }
function IndexOfSlicesBase(Sp, Sb: PByte; N, NS, From: Int64): Int64;
var
  i, n2: Int64;
begin
  i := From;
  repeat
    n2 := i + StrMaxBytes + NS - 1;
    if n2 > N then
      n2 := N;
    Result := IndexOfBase(Sp, Sb, n2, NS, i);
    if Result >= 0 then
      Exit;
    i := i + StrMaxBytes;
  until i + NS > N;
  Result := -1;
end;

function IndexOfBase(Sp, Sb: PByte; N, NS, From: Int64): Int64;
var
  c0, c1: Int64;
  i, t, o, fails: Int64;
begin
  Result := -1;
  if NS > N - From then
    Exit;
  if NS > StrMaxBytes then
  begin
    Result := IndexOfLongBase(Sp, Sb, N, NS, From);
    Exit;
  end;
  c0 := Sb[0];
  if NS = 1 then
  begin
    o := PasFindByteBase(@Sp[From], N - From, c0);
    if o >= 0 then
      Result := From + o;
    Exit;
  end;
  c1 := Sb[1];
  i := From;
  t := N - NS + 1;
  { more than StrMaxBytes places: a slice of them at a time (P270) }
  if t - i > StrMaxBytes then
  begin
    Result := IndexOfSlicesBase(Sp, Sb, N, NS, From);
    Exit;
  end;
  fails := 0;
  while i < t do
  begin
    if Sp[i] <> c0 then
    begin
      o := PasIndexByteBase(@Sp[i + 1], t - i - 1, c0);
      if o < 0 then
        Exit;
      i := i + o + 1;
    end;
    if (Sp[i + 1] = c1) and PasMemEqBase(@Sp[i], Sb, NS) then
    begin
      Result := i;
      Exit;
    end;
    i := i + 1;
    fails := fails + 1;
    if (fails >= 4 + (i shr 4)) and (i < t) then
    begin
      Result := RabinKarpBase(Sp, Sb, N, NS, i);
      Exit;
    end;
  end;
end;

{ Pos(Sub, S, Offset), as Free Pascal: the place from 1 of the first
  Sub in S at Offset or after, 0 when there is none, when Sub is empty
  or when Offset is below 1 or past S. }
function PasPosCpu(const Sub, S: string; Offset: Int64): Int64;
var
  r: Int64;
begin
  Result := 0;
  if (Length(Sub) = 0) or (Offset < 1) or (Offset > Length(S)) then
    Exit;
  r := IndexOfCpu(PByte(@S[1]), PByte(@Sub[1]), Length(S), Length(Sub), Offset - 1);
  if r >= 0 then
    Result := r + 1;
end;

function PasPosBase(const Sub, S: string; Offset: Int64): Int64;
var
  r: Int64;
begin
  Result := 0;
  if (Length(Sub) = 0) or (Offset < 1) or (Offset > Length(S)) then
    Exit;
  r := IndexOfBase(PByte(@S[1]), PByte(@Sub[1]), Length(S), Length(Sub), Offset - 1);
  if r >= 0 then
    Result := r + 1;
end;

function PasPosCharCpu(C: Char; const S: string; Offset: Int64): Int64;
var
  r: Int64;
begin
  Result := 0;
  if (Offset < 1) or (Offset > Length(S)) then
    Exit;
  if Length(S) - Offset + 1 <= StrMaxBytes then
    r := PasIndexByteCpu(@S[Offset], Length(S) - Offset + 1, Ord(C))
  else
    r := FindByteLongCpu(@S[Offset], Length(S) - Offset + 1, Ord(C));
  if r >= 0 then
    Result := Offset + r;
end;

function PasPosCharBase(C: Char; const S: string; Offset: Int64): Int64;
var
  r: Int64;
begin
  Result := 0;
  if (Offset < 1) or (Offset > Length(S)) then
    Exit;
  if Length(S) - Offset + 1 <= StrMaxBytes then
    r := PasIndexByteBase(@S[Offset], Length(S) - Offset + 1, Ord(C))
  else
    r := FindByteLongBase(@S[Offset], Length(S) - Offset + 1, Ord(C));
  if r >= 0 then
    Result := Offset + r;
end;

{ ---- Case ---- }

{ S with its ASCII letters made capitals (Upper) or small, by the
  kernel of each body, chosen when the program is compiled (P268). }
function MapCaseCpu(const S: string; Upper: Boolean): string;
begin
  Result := '';
  if Length(S) = 0 then
    Exit;
  SetLength(Result, Length(S));
  { at most StrMaxBytes a call (P270) }
  if Length(S) <= StrMaxBytes then
    PasCaseMapCpu(@S[1], @Result[1], Length(S), Upper)
  else
    CaseMapLongCpu(@S[1], @Result[1], Length(S), Upper);
end;

function MapCaseBase(const S: string; Upper: Boolean): string;
begin
  Result := '';
  if Length(S) = 0 then
    Exit;
  SetLength(Result, Length(S));
  { at most StrMaxBytes a call (P270) }
  if Length(S) <= StrMaxBytes then
    PasCaseMapBase(@S[1], @Result[1], Length(S), Upper)
  else
    CaseMapLongBase(@S[1], @Result[1], Length(S), Upper);
end;

function PasUpperCpu(const S: string): string;
begin
  Result := MapCaseCpu(S, True);
end;

function PasUpperBase(const S: string): string;
begin
  Result := MapCaseBase(S, True);
end;

function PasLowerCpu(const S: string): string;
begin
  Result := MapCaseCpu(S, False);
end;

function PasLowerBase(const S: string): string;
begin
  Result := MapCaseBase(S, False);
end;

{ ---- UTF-8 ---- }

{ The length of the sequence lead byte B starts, 4 for every byte from
  F0h on (an F5h to FFh fails where it is read). }
function Utf8SeqLen(B: Int64): Int64;
begin
  if B < $C0 then
    Result := 1
  else if B < $E0 then
    Result := 2
  else if B < $F0 then
    Result := 3
  else
    Result := 4;
end;

{ Whether P[0..N-1] is UTF-8 (RFC 3629), byte by byte as Go's
  utf8.Valid reads it (golang src/unicode/utf8/utf8.go: first and
  acceptRanges, the second byte's range by the lead, the rest 80h to
  BFh): the place from 0 of the first byte of the first sequence that is
  not, -1 when every one is; a sequence the end cuts while its bytes
  are right so far is Pend bytes long and not an error, so a reading in
  pieces goes on with it. IJson also refuses a noncharacter, U+FDD0 to
  U+FDEF and the last two of each plane (RFC 7493 2.1). The reference
  the kernels are held to. }
function PasUtf8Plain(P: Pointer; N: Int64; IJson: Boolean; out Pend: Int64): Int64;
var
  i, k, sz, lo, hi, b0, b, cp: Int64;
begin
  Result := -1;
  Pend := 0;
  i := 0;
  while i < N do
  begin
    b0 := PByte(P)[i];
    if b0 < $80 then
    begin
      i := i + 1;
      Continue;
    end;
    lo := $80;
    hi := $BF;
    if (b0 >= $C2) and (b0 <= $DF) then
      sz := 2
    else if b0 = $E0 then
    begin
      sz := 3;
      lo := $A0;
    end
    else if b0 = $ED then
    begin
      sz := 3;
      hi := $9F;
    end
    else if (b0 >= $E1) and (b0 <= $EF) then
      sz := 3
    else if b0 = $F0 then
    begin
      sz := 4;
      lo := $90;
    end
    else if (b0 >= $F1) and (b0 <= $F3) then
      sz := 4
    else if b0 = $F4 then
    begin
      sz := 4;
      hi := $8F;
    end
    else
    begin
      Result := i;
      Exit;
    end;
    for k := 1 to sz - 1 do
    begin
      if i + k >= N then
      begin
        Pend := N - i;
        Exit;
      end;
      b := PByte(P)[i + k];
      if k > 1 then
      begin
        lo := $80;
        hi := $BF;
      end;
      if (b < lo) or (b > hi) then
      begin
        Result := i;
        Exit;
      end;
    end;
    if IJson and (sz >= 3) then
    begin
      if sz = 3 then
        cp := ((b0 and $0F) shl 12) or ((PByte(P)[i + 1] and $3F) shl 6) or (PByte(P)[i + 2] and $3F)
      else
        cp := ((b0 and $07) shl 18) or ((PByte(P)[i + 1] and $3F) shl 12) or
          ((PByte(P)[i + 2] and $3F) shl 6) or (PByte(P)[i + 3] and $3F);
      if ((cp >= $FDD0) and (cp <= $FDEF)) or ((cp and $FFFE) = $FFFE) then
      begin
        Result := i;
        Exit;
      end;
    end;
    i := i + sz;
  end;
end;

{ NBlocks blocks of 64 bytes from P checked as UTF-8, after simdjson's
  lookup4 (docs/ref/json/simdjson-5.0.3, src/generic/stage1/
  utf8_lookup4_algorithm.h, its haswell and arm64 bodies): every byte
  checked against the three before it by three table lookups of four
  bits each (the error classes of the first byte by its high and its
  low nibble and of the second by its high nibble, ANDed) and the third
  and fourth bytes of a sequence by a saturating subtraction from the
  ones two and three back; a block of ASCII alone is skipped, an error
  only when the block before left a sequence open. Prev is the 32 bytes
  before P (zeros at a start), and the last 32 of the last block on
  return. IJson refuses noncharacters too: EF B7 90..AF (U+FDD0 to
  U+FDEF), EF BF BE..BF, and a four-byte sequence whose second byte's
  low nibble is F and third byte BF and fourth BE or BF (the last two of
  each plane). The place from 0 of the first block where it finds an
  error, NBlocks when none: a sequence it finds wrong is the bytes up to
  the one where it is found, which may begin up to three bytes before
  that block (PasUtf8Valid finds the exact byte with the Plain body).
  amd64 AVX2, 32 bytes a chunk: VPERM2I128 and VPALIGNR for the bytes
  one to three back (SDM vol. 2C 5-496, vol. 2B 4-217), VPSHUFB for the
  tables, VPSUBUSB, VPTEST (vol. 2B). arm64 NEON, 16 bytes a chunk: EXT
  for the bytes back, TBL for the tables (ARM ARM C7.2.44, C7.2.397),
  UQSUB, UMAXV to tell any byte set. }
function PasUtf8BlocksCpu(P: Pointer; NBlocks: Int64; Prev: Pointer; IJson: Boolean): Int64;
begin
  asm amd64 (P: in rsi; NBlocks: in rbx; Prev: in rdi; IJson: in rcx; Result: out rax)
    subq $416, %rsp
    movabsq $0x0202020202020202, %rax
    vmovq %rax, %xmm13
    movabsq $0x4915012180808080, %rax
    vpinsrq $1, %rax, %xmm13, %xmm13
    vinserti128 $1, %xmm13, %ymm13, %ymm13
    movabsq $0xCBCBCB8B8383A3E7, %rax
    vmovq %rax, %xmm12
    movabsq $0xCBCBDBCBCBCBCBCB, %rax
    vpinsrq $1, %rax, %xmm12, %xmm12
    vinserti128 $1, %xmm12, %ymm12, %ymm12
    movabsq $0x0101010101010101, %rax
    vmovq %rax, %xmm11
    movabsq $0x01010101BABAAEE6, %rax
    vpinsrq $1, %rax, %xmm11, %xmm11
    vinserti128 $1, %xmm11, %ymm11, %ymm11
    movl $0x0F, %eax
    vmovd %eax, %xmm10
    vpbroadcastb %xmm10, %ymm10
    movl $0x60, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, (%rsp)
    movl $0x70, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 32(%rsp)
    movl $0x80, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
    vmovdqu %ymm2, 64(%rsp)
    vpcmpeqb %ymm2, %ymm2, %ymm2
    vmovdqu %ymm2, 96(%rsp)
    movb $0xEF, 125(%rsp)
    movb $0xDF, 126(%rsp)
    movb $0xBF, 127(%rsp)
    movl $0xEF, %eax
    vmovd %eax, %xmm2
    vpbroadcastb %xmm2, %ymm2
