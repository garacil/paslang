    vpcmpeqb 352(%rsp), %ymm9, %ymm9
    vpand 384(%rsp), %ymm5, %ymm5
    vpcmpeqb 384(%rsp), %ymm5, %ymm5
    vpand %ymm5, %ymm9, %ymm9
    vpor %ymm6, %ymm9, %ymm9
    vpand %ymm9, %ymm8, %ymm8
    vpor %ymm8, %ymm7, %ymm7
    vpor %ymm7, %ymm14, %ymm14
    4:
    vmovdqa %ymm1, %ymm15
    vptest %ymm14, %ymm14
    jnz 7f
    6:
    addq $64, %rsi
    incq %rdx
    jmp 1b
    7:
    movq %rdx, %rax
    jmp 9f
    8:
    movq %rbx, %rax
    9:
    vmovdqu %ymm15, (%rdi)
    addq $416, %rsp
  end;
  asm arm64 (P: in x0; NBlocks: in x1; Prev: in x2; IJson: in x3; Result: out x0)
    movz x6, #0x0202
    movk x6, #0x0202, lsl #16
    movk x6, #0x0202, lsl #32
    movk x6, #0x0202, lsl #48
    mov v29.d[0], x6
    movz x6, #0x8080
    movk x6, #0x8080, lsl #16
    movk x6, #0x0121, lsl #32
    movk x6, #0x4915, lsl #48
    mov v29.d[1], x6
    movz x6, #0xA3E7
    movk x6, #0x8383, lsl #16
    movk x6, #0xCB8B, lsl #32
    movk x6, #0xCBCB, lsl #48
    mov v28.d[0], x6
    movz x6, #0xCBCB
    movk x6, #0xCBCB, lsl #16
    movk x6, #0xDBCB, lsl #32
    movk x6, #0xCBCB, lsl #48
    mov v28.d[1], x6
    movi v27.16b, #0x01
    movz x6, #0xAEE6
    movk x6, #0xBABA, lsl #16
    movk x6, #0x0101, lsl #32
    movk x6, #0x0101, lsl #48
    mov v27.d[1], x6
    movi v26.16b, #0x0F
    movi v25.16b, #0x60
    movi v24.16b, #0x70
    movi v23.16b, #0x80
    movi v22.2d, #0xffffffffffffffff
    movz x6, #0xFFFF
    movk x6, #0xFFFF, lsl #16
    movk x6, #0xEFFF, lsl #32
    movk x6, #0xBFDF, lsl #48
    mov v22.d[1], x6
    movi v14.16b, #0xEF
    movi v15.16b, #0xB7
    movi v16.16b, #0xE0
    movi v17.16b, #0xFE
    movi v18.16b, #0xBE
    movi v19.16b, #0xBF
    movi v20.16b, #0xCF
    movi v21.16b, #0x8F
    movi v5.16b, #0xF0
    ldr q31, [x2, #16]
    mov x7, x30
    mov x4, #0
    .p2align 5
    1:
    cmp x4, x1
    b.hs 8f
    ld1 {v0.16b, v1.16b, v2.16b, v3.16b}, [x0], #64
    orr v4.16b, v0.16b, v1.16b
    orr v8.16b, v2.16b, v3.16b
    orr v4.16b, v4.16b, v8.16b
    umaxv b4, v4.16b
    umov w6, v4.b[0]
    cmp w6, #0x80
    b.hs 2f
    uqsub v4.16b, v31.16b, v22.16b
    umaxv b4, v4.16b
    umov w6, v4.b[0]
    cbnz w6, 7f
    mov v31.16b, v3.16b
    add x4, x4, #1
    b 1b
    2:
    movi v30.16b, #0
    mov v6.16b, v31.16b
    mov v7.16b, v0.16b
    bl 5f
    mov v6.16b, v0.16b
    mov v7.16b, v1.16b
    bl 5f
    mov v6.16b, v1.16b
    mov v7.16b, v2.16b
    bl 5f
    mov v6.16b, v2.16b
    mov v7.16b, v3.16b
    bl 5f
    mov v31.16b, v3.16b
    umaxv b4, v30.16b
    umov w6, v4.b[0]
    cbnz w6, 7f
    add x4, x4, #1
    b 1b
    5:
    ext v4.16b, v6.16b, v7.16b, #15
    ext v8.16b, v6.16b, v7.16b, #14
    ext v9.16b, v6.16b, v7.16b, #13
    ushr v10.16b, v4.16b, #4
    tbl v10.16b, {v29.16b}, v10.16b
    and v11.16b, v4.16b, v26.16b
    tbl v11.16b, {v28.16b}, v11.16b
    and v10.16b, v10.16b, v11.16b
    ushr v11.16b, v7.16b, #4
    tbl v11.16b, {v27.16b}, v11.16b
    and v10.16b, v10.16b, v11.16b
    uqsub v11.16b, v8.16b, v25.16b
    uqsub v12.16b, v9.16b, v24.16b
