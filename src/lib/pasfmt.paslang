{$mode objfpc}{$H+}
unit pasfmt;

{ Write and WriteLn formatting (1.0.79), a core unit every program sees.
  A real prints exactly: its binary value times 10^D, rounded to the
  nearest integer (a tie to the even one) with integers as long as it
  takes, so 1e20 and 2.675 print what they are (2.5e-7 rounds to 0.0 at
  the default of one decimal and prints whole as 2.5e-7:0:9); x:w pads
  any value to w columns and x:w:d gives a real d decimals. }

interface

{ The foreign bootstrap has System.TObject; native code uses our root. }
{$ifndef FPC}uses pasobject;{$endif}

type
  TCurrencyFault = (cfOverflow, cfDivideByZero, cfInvalidValue);
  TCurrencyQuadWords = array[0..1] of Int64;
  { Primitive arithmetic is independent of the optional SysUtils unit.
    Like every raised object, this fault belongs to the current G. }
  ECurrencyError = class(TObject)
  private
    FKind: TCurrencyFault;
    FMessage: string;
  public
    constructor Create(AKind: TCurrencyFault);
    function ToString: string; override;
    property Kind: TCurrencyFault read FKind;
    property Message: string read FMessage;
  end;

{ Currency kernels exchange the signed integer of ten-thousandths,
  never a binary floating-point approximation of a decimal value. }
function PasCurrFromInt(V: Int64): Int64;
function PasCurrFromReal(X: Double): Int64;
function PasCurrFromQuad(Lo, Hi: Int64): Int64;
function PasCurrFromQuadWords(const Words: TCurrencyQuadWords): Int64;
function PasCurrToReal(V: Int64): Double;
function PasCurrAdd(A, B: Int64): Int64;
function PasCurrSub(A, B: Int64): Int64;
function PasCurrMul(A, B: Int64): Int64;
function PasCurrSqr(V: Int64): Int64;
{$ifndef FPC}
function PasCurrFromQuadValue(Value: Quad): Int64;
{$endif}
function PasCurrDiv(A, B: Int64): Int64;
function PasCurrNeg(V: Int64): Int64;
function PasCurrAbs(V: Int64): Int64;
function PasCurrTrunc(V: Int64): Int64;
function PasCurrRound(V: Int64): Int64;
function PasCurrFloor(V: Int64): Int64;
function PasCurrCeil(V: Int64): Int64;
function PasCurrInt(V: Int64): Int64;
function PasCurrFrac(V: Int64): Int64;
function PasCurrMin(A, B: Int64): Int64;
function PasCurrMax(A, B: Int64): Int64;
function PasTryParseCurrency(const S: string; out V: Int64): Boolean;
function PasFmtCurrency(V: Int64; W, D: Integer): string;
function PasCurrencyDigits(V, Mode, N: Int64; out Dp: Int64): string;

function PasFmtReal(X: Double; W, D: Integer): string;
function PasFmtInt(V: Int64; W: Integer): string;
function PasFmtStr(const S: string; W: Integer): string;
function PasParseReal(const S: string; out Bits: Int64): Boolean;
function PasParseSingle(const S: string; out Bits: Int64): Boolean;
function PasF64ToF32(B: Int64): Int64;
function PasF32ToF64(B: Int64): Int64;
function PasParseQuad(const S: string; out Lo, Hi: Int64): Boolean;
function PasFmtQuad(Lo, Hi: Int64; W, D: Integer): string;
function PasQuadDigits(Lo, Hi: Int64; Mode, N: Int64; out Dp: Int64): string;

implementation

type
  TBig = array of Int64;

{ Limbs of 32 bits, low first, each in an Int64 so a limb times 10^9
  plus a carry stays below 2^63. }

procedure BigTrim(var A: TBig);
var
  n: Integer;
begin
  n := Length(A);
  while (n > 1) and (A[n - 1] = 0) do
    n := n - 1;
  SetLength(A, n);
end;

procedure BigMulSmall(var A: TBig; M: Int64);
var
  i: Integer;
  t, cy: Int64;
begin
  cy := 0;
  for i := 0 to High(A) do
  begin
    t := A[i] * M + cy;
    A[i] := t and 4294967295;
    cy := t shr 32;
  end;
  while cy <> 0 do
  begin
    SetLength(A, Length(A) + 1);
    A[High(A)] := cy and 4294967295;
    cy := cy shr 32;
  end;
end;

procedure BigShl(var A: TBig; N: Integer);
var
  words, bits, i, old: Integer;
  cur, cy: Int64;
begin
  words := N div 32;
  bits := N mod 32;
  old := Length(A);
  SetLength(A, old + words + 1);
  for i := old + words to High(A) do
    A[i] := 0;
  for i := old - 1 downto 0 do
    A[i + words] := A[i];
  for i := 0 to words - 1 do
    A[i] := 0;
  if bits > 0 then
  begin
    cy := 0;
    for i := words to High(A) do
    begin
      cur := (A[i] shl bits) or cy;
      cy := (A[i] shr (32 - bits)) and 4294967295;
      A[i] := cur and 4294967295;
    end;
  end;
  BigTrim(A);
end;

function BigBit(const A: TBig; N: Integer): Boolean;
var
  w: Integer;
begin
  w := N div 32;
  Result := False;
  if w < Length(A) then
    Result := ((A[w] shr (N mod 32)) and 1) = 1;
end;

{ Any bit below N set? }
function BigLowAny(const A: TBig; N: Integer): Boolean;
var
  i, w: Integer;
begin
  Result := False;
  w := N div 32;
  for i := 0 to w - 1 do
    if (i < Length(A)) and (A[i] <> 0) then
    begin
      Result := True;
      Exit;
    end;
  if (w < Length(A)) and ((N mod 32) > 0) then
    if (A[w] and ((Int64(1) shl (N mod 32)) - 1)) <> 0 then
      Result := True;
end;

{ A shifted right by N bits, the bits below dropped. }
procedure BigShrTrunc(var A: TBig; N: Integer);
var
  words, bits, i: Integer;
begin
  words := N div 32;
  bits := N mod 32;
  if words >= Length(A) then
  begin
    SetLength(A, 1);
    A[0] := 0;
    Exit;
  end;
  for i := 0 to High(A) - words do
    A[i] := A[i + words];
  SetLength(A, Length(A) - words);
  if bits > 0 then
  begin
    for i := 0 to High(A) do
    begin
      A[i] := A[i] shr bits;
      if i < High(A) then
        A[i] := A[i] or ((A[i + 1] shl (32 - bits)) and 4294967295);
    end;
  end;
  BigTrim(A);
end;

{ A shifted right by N bits, rounded to the nearest, a tie to even. }
procedure BigShrRound(var A: TBig; N: Integer);
var
  up: Boolean;
  i: Integer;
begin
  up := False;
  if BigBit(A, N - 1) then
  begin
    if BigLowAny(A, N - 1) then
      up := True
    else
      up := BigBit(A, N);
  end;
  BigShrTrunc(A, N);
  if up then
  begin
    i := 0;
    while True do
    begin
      if i > High(A) then
      begin
        SetLength(A, Length(A) + 1);
        A[i] := 0;
      end;
      A[i] := A[i] + 1;
      if A[i] <= 4294967295 then
        Break;
      A[i] := 0;
      i := i + 1;
    end;
  end;
  BigTrim(A);
end;

{ A div M, the remainder in R; M below 2^31. }
procedure BigDivSmall(var A: TBig; M: Int64; out R: Int64);
var
  i: Integer;
  rem, cur: Int64;
begin
  rem := 0;
  for i := High(A) downto 0 do
  begin
    cur := rem * 4294967296 + A[i];
    A[i] := cur div M;
    rem := cur mod M;
  end;
  R := rem;
  BigTrim(A);
end;

function BigIsZero(const A: TBig): Boolean;
begin
  Result := (Length(A) = 1) and (A[0] = 0);
end;

{ The decimal digits of A, which is used up: an array passed by value is
  the same array, and the divisions leave it 0. }
function BigToDec(A: TBig): string;
var
  r: Int64;
  chunk: string;
  k: Integer;
begin
  Result := '';
  if BigIsZero(A) then
  begin
    Result := '0';
    Exit;
  end;
  while not BigIsZero(A) do
  begin
    BigDivSmall(A, 1000000000, r);
    chunk := '';
    for k := 1 to 9 do
    begin
      chunk := Chr(48 + r mod 10) + chunk;
      r := r div 10;
    end;
    Result := chunk + Result;
  end;
  k := 1;
  while (k < Length(Result)) and (Result[k] = '0') do
    k := k + 1;
  Result := Copy(Result, k, Length(Result) - k + 1);
end;

function BigBitLen(const A: TBig): Integer;
var
  top: Int64;
begin
  Result := (Length(A) - 1) * 32;
  top := A[High(A)];
  while top <> 0 do
  begin
    Result := Result + 1;
    top := top shr 1;
  end;
end;

function BigCmp(const A, B: TBig): Integer;
var
  i: Integer;
begin
  Result := 0;
  if Length(A) <> Length(B) then
  begin
    if Length(A) > Length(B) then
      Result := 1
    else
      Result := -1;
    Exit;
  end;
  for i := High(A) downto 0 do
    if A[i] <> B[i] then
    begin
      if A[i] > B[i] then
        Result := 1
      else
        Result := -1;
      Exit;
    end;
end;

{ A := A - B, for A >= B. }
procedure BigSub(var A: TBig; const B: TBig);
var
  i: Integer;
  borrow, t: Int64;
begin
  borrow := 0;
  for i := 0 to High(A) do
  begin
    t := A[i] - borrow;
    if i <= High(B) then
      t := t - B[i];
    if t < 0 then
    begin
      t := t + 4294967296;
      borrow := 1;
    end
    else
      borrow := 0;
    A[i] := t;
  end;
  BigTrim(A);
end;

{ Q := A div B, R := A mod B, bit by bit: the literals are short. }
procedure BigDivMod(const A, B: TBig; out Q, R: TBig);
var
  i, n: Integer;
begin
  Q := nil;
  SetLength(Q, Length(A));
  for i := 0 to High(Q) do
    Q[i] := 0;
  R := nil;
  SetLength(R, 1);
  R[0] := 0;
  n := BigBitLen(A);
  for i := n - 1 downto 0 do
  begin
    BigShl(R, 1);
    if BigBit(A, i) then
      R[0] := R[0] or 1;
    if BigCmp(R, B) >= 0 then
    begin
      BigSub(R, B);
      Q[i div 32] := Q[i div 32] or (Int64(1) shl (i mod 32));
    end;
  end;
  BigTrim(Q);
end;

procedure BigAddSmall(var A: TBig; V: Int64);
var
  i: Integer;
  t: Int64;
begin
  i := 0;
  while V <> 0 do
  begin
    if i > High(A) then
    begin
      SetLength(A, Length(A) + 1);
      A[i] := 0;
    end;
    t := A[i] + V;
    A[i] := t and 4294967295;
    V := t shr 32;
    i := i + 1;
  end;
end;

{ The binary float nearest to Q * 2^-S, and a little more when Sticky: P
  significant bits (53 for a double, 24 for a single), EMin the power of
  two of the smallest subnormal's bit (1074, 149), EMax the exponent field
  of infinity (2047, 255); a tie goes to the even one, below the normal
  range the subnormals, then 0 (P101 made it take the precision). }
function RoundToFloat(const Q: TBig; S: Integer; Sticky: Boolean; P, EMin: Integer;
  EMax: Int64): Int64;
var
  L, shift, i: Integer;
  m, e, field, top, hidden: Int64;
  rbit, lower: Boolean;
begin
  Result := 0;
  if BigIsZero(Q) then
    Exit;
  L := BigBitLen(Q);
  shift := L - P;
  if S - EMin > shift then
    shift := S - EMin;
  m := 0;
  for i := 0 to P - 1 do
    if (shift + i >= 0) and BigBit(Q, shift + i) then
      m := m or (Int64(1) shl i);
  rbit := False;
  lower := Sticky;
  if shift > 0 then
  begin
    rbit := BigBit(Q, shift - 1);
    if (shift > 1) and BigLowAny(Q, shift - 1) then
      lower := True;
  end;
  if rbit and (lower or ((m and 1) = 1)) then
    m := m + 1;
  e := shift - S;
  top := Int64(1) shl P;
  hidden := Int64(1) shl (P - 1);
  if m = top then
  begin
    m := hidden;
    e := e + 1;
  end;
  if m >= hidden then
  begin
    field := e + EMin + 1;
    if field >= EMax then
      Result := EMax shl (P - 1)
    else
      Result := (field shl (P - 1)) or (m - hidden);
  end
  else
    Result := m;
end;

function RoundToDouble(const Q: TBig; S: Integer; Sticky: Boolean): Int64;
begin
  Result := RoundToFloat(Q, S, Sticky, 53, 1074, 2047);
end;

{ S as the nearest float of P significant bits: the digits as one
  integer, times or divided by the power of ten exactly, rounded once, a
  tie to even, subnormals kept (1.0.79 for doubles, P101 for singles). }
{ The number S says, as an integer D of NDig significant digits times
  10^Exp10: [+|-]digits[.digits][e[+|-]digits]. False when S is not one.
  Shared by the double, the single and the quad (P103). }
function ScanReal(const S: string; out Neg: Boolean; out D: TBig; out NDig, Exp10: Integer): Boolean;
var
  i, n, nfrac, ex: Integer;
  eneg, anyd: Boolean;
begin
  Result := False;
  Neg := False;
  NDig := 0;
  Exp10 := 0;
  n := Length(S);
  i := 1;
  if (i <= n) and ((S[i] = '+') or (S[i] = '-')) then
  begin
    Neg := S[i] = '-';
    i := i + 1;
  end;
  D := nil;
  SetLength(D, 1);
  D[0] := 0;
  nfrac := 0;
  anyd := False;
  while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
  begin
    BigMulSmall(D, 10);
    BigAddSmall(D, Ord(S[i]) - 48);
    if not BigIsZero(D) then
      NDig := NDig + 1;
    anyd := True;
    i := i + 1;
  end;
  if (i <= n) and (S[i] = '.') then
  begin
    i := i + 1;
    while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
    begin
      BigMulSmall(D, 10);
      BigAddSmall(D, Ord(S[i]) - 48);
      if not BigIsZero(D) then
        NDig := NDig + 1;
      nfrac := nfrac + 1;
      anyd := True;
      i := i + 1;
    end;
  end;
  if not anyd then
    Exit;
  ex := 0;
  if (i <= n) and ((S[i] = 'e') or (S[i] = 'E')) then
  begin
    i := i + 1;
    eneg := False;
    if (i <= n) and ((S[i] = '+') or (S[i] = '-')) then
    begin
      eneg := S[i] = '-';
      i := i + 1;
    end;
    if (i > n) or (S[i] < '0') or (S[i] > '9') then
      Exit;
    while (i <= n) and (S[i] >= '0') and (S[i] <= '9') do
    begin
      if ex < 100000 then
        ex := ex * 10 + Ord(S[i]) - 48;
      i := i + 1;
    end;
    if eneg then
      ex := -ex;
  end;
  if i <= n then
    Exit;
  Exp10 := ex - nfrac;
  Result := True;
end;

function ParseRealP(const S: string; IsSingle: Boolean; out Bits: Int64): Boolean;
var
  i, ndig, s2, p, emin, big, small, exp10: Integer;
  emax: Int64;
  neg: Boolean;
  d, pw, num, q, r: TBig;
begin
  Bits := 0;
  if IsSingle then
  begin
    p := 24;
    emin := 149;
    emax := 255;
    big := 40;
    small := -50;
  end
  else
  begin
    p := 53;
    emin := 1074;
    emax := 2047;
    big := 310;
    small := -330;
  end;
  Result := ScanReal(S, neg, d, ndig, exp10);
  if not Result then
    Exit;
  if BigIsZero(d) then
    Bits := 0
  else if exp10 + ndig > big then
    Bits := emax shl (p - 1)
  else if exp10 + ndig < small then
    Bits := 0
  else if exp10 >= 0 then
  begin
    for i := 1 to exp10 do
      BigMulSmall(d, 10);
    Bits := RoundToFloat(d, 0, False, p, emin, emax);
  end
  else
  begin
    pw := nil;
    SetLength(pw, 1);
    pw[0] := 1;
    for i := 1 to -exp10 do
      BigMulSmall(pw, 10);
    s2 := p + 2 + BigBitLen(pw) - BigBitLen(d);
    if s2 < 0 then
      s2 := 0;
    num := d;
    BigShl(num, s2);
    BigDivMod(num, pw, q, r);
    Bits := RoundToFloat(q, s2, not BigIsZero(r), p, emin, emax);
  end;
  if neg then
  begin
    if IsSingle then
      Bits := Bits or (Int64(1) shl 31)
    else
      Bits := Bits or (Int64(1) shl 63);
  end;
end;

{ Q / 2^S as the nearest binary128 (P103), a tie to even, subnormals
  kept, past the top infinity: RoundToFloat for 113 bits, the
  significand in two words. }
procedure RoundToQuad(const Q: TBig; S: Integer; Sticky: Boolean; out Lo, Hi: Int64);
var
  L, shift, i: Integer;
  mlo, mhi, e, field: Int64;
  rbit, lower: Boolean;
begin
  Lo := 0;
  Hi := 0;
  if BigIsZero(Q) then
    Exit;
  L := BigBitLen(Q);
  shift := L - 113;
  if S - 16494 > shift then
    shift := S - 16494;
  mlo := 0;
  mhi := 0;
  for i := 0 to 112 do
    if (shift + i >= 0) and BigBit(Q, shift + i) then
    begin
      if i < 64 then
        mlo := mlo or (Int64(1) shl i)
      else
        mhi := mhi or (Int64(1) shl (i - 64));
    end;
  rbit := False;
  lower := Sticky;
  if shift > 0 then
  begin
    rbit := BigBit(Q, shift - 1);
    if (shift > 1) and BigLowAny(Q, shift - 1) then
      lower := True;
  end;
  if rbit and (lower or ((mlo and 1) = 1)) then
  begin
    mlo := mlo + 1;
    if mlo = 0 then
      mhi := mhi + 1;
  end;
  e := shift - S;
  if (mhi = Int64(1) shl 49) and (mlo = 0) then
  begin
    mhi := Int64(1) shl 48;
    e := e + 1;
  end;
  if mhi >= Int64(1) shl 48 then
  begin
    field := e + 16495;
    if field >= 32767 then
    begin
      Hi := Int64(32767) shl 48;
      Exit;
    end;
    Hi := (field shl 48) or (mhi - (Int64(1) shl 48));
    Lo := mlo;
  end
  else
  begin
    Hi := mhi;
    Lo := mlo;
  end;
end;

{ S as the nearest binary128 (P103), rounded once from its digits, a tie
  to even, subnormals kept. False when S is not a number. }
function PasParseQuad(const S: string; out Lo, Hi: Int64): Boolean;
var
  i, ndig, exp10, s2: Integer;
  neg: Boolean;
  d, pw, num, q, r: TBig;
begin
  Lo := 0;
  Hi := 0;
  Result := ScanReal(S, neg, d, ndig, exp10);
  if not Result then
    Exit;
  if BigIsZero(d) then
    Hi := 0
  else if exp10 + ndig > 4934 then
    Hi := Int64(32767) shl 48
  else if exp10 + ndig < -4970 then
    Hi := 0
  else if exp10 >= 0 then
  begin
    for i := 1 to exp10 do
      BigMulSmall(d, 10);
    RoundToQuad(d, 0, False, Lo, Hi);
  end
  else
  begin
    pw := nil;
    SetLength(pw, 1);
    pw[0] := 1;
    for i := 1 to -exp10 do
      BigMulSmall(pw, 10);
    s2 := 115 + BigBitLen(pw) - BigBitLen(d);
    if s2 < 0 then
      s2 := 0;
    num := d;
    BigShl(num, s2);
    BigDivMod(num, pw, q, r);
    RoundToQuad(q, s2, not BigIsZero(r), Lo, Hi);
  end;
  if neg then
    Hi := Hi or (Int64(1) shl 63);
end;

{ S as the nearest double (1.0.79): the digits as one integer, times or
  divided by the power of ten exactly, rounded once, a tie to even,
  subnormals kept. False when S is not a number:
  [+|-]digits[.digits][e[+|-]digits]. }
function PasParseReal(const S: string; out Bits: Int64): Boolean;
begin
  Result := ParseRealP(S, False, Bits);
end;

{ S as the nearest single (P101), rounded once from the digits: parsing
  to a double first and rounding that again can miss by one. The bits in
  the low 32. }
function PasParseSingle(const S: string; out Bits: Int64): Boolean;
begin
  Result := ParseRealP(S, True, Bits);
end;

{ The single nearest to the double with bits B (P101), a tie to even:
  its value exactly as an integer times a power of two, rounded once.
  Infinity stays infinity, a NaN a quiet NaN with the top of its
  payload. The bits in the low 32. }
function PasF64ToF32(B: Int64): Int64;
var
  sign, ex, man: Int64;
  q: TBig;
  s: Integer;
begin
  sign := (B shr 63) and 1;
  ex := (B shr 52) and 2047;
  man := B and ((Int64(1) shl 52) - 1);
  if ex = 2047 then
  begin
    if man = 0 then
      Result := Int64(255) shl 23
    else
      Result := (Int64(255) shl 23) or (Int64(1) shl 22) or (man shr 29);
  end
  else if (ex = 0) and (man = 0) then
    Result := 0
  else
  begin
    if ex = 0 then
      ex := 1
    else
      man := man or (Int64(1) shl 52);
    { value = man * 2^(ex - 1075) }
    q := nil;
    SetLength(q, 3);
    q[0] := man and 4294967295;
    q[1] := man shr 32;
    q[2] := 0;
    BigTrim(q);
    s := 1075 - ex;
    if s < 0 then
    begin
      BigShl(q, -s);
      s := 0;
    end;
    Result := RoundToFloat(q, s, False, 24, 149, 255);
  end;
  Result := Result or (sign shl 31);
end;

{ The double with the value of the single with bits B, exactly. }
function PasF32ToF64(B: Int64): Int64;
var
  sign, ex, man: Int64;
begin
  sign := (B shr 31) and 1;
  ex := (B shr 23) and 255;
  man := B and ((Int64(1) shl 23) - 1);
  if ex = 255 then
    Result := (Int64(2047) shl 52) or (man shl 29)
  else if (ex = 0) and (man = 0) then
    Result := 0
  else if ex = 0 then
  begin
    { A subnormal man * 2^-149 is a normal double. }
    ex := 1;
    while (man and (Int64(1) shl 23)) = 0 do
    begin
      man := man shl 1;
      ex := ex - 1;
    end;
    man := man and ((Int64(1) shl 23) - 1);
    Result := ((ex - 127 + 1023) shl 52) or (man shl 29);
  end
  else
    Result := ((ex - 127 + 1023) shl 52) or (man shl 29);
  Result := Result or (sign shl 63);
end;

{ S right-aligned in W columns: one string made, the spaces and then S
  (P129; it put one space before the string at a time). }
function Pad(const S: string; W: Integer): string;
var
  n: Integer;
begin
  n := W - Length(S);
  if n <= 0 then
  begin
    Result := S;
    Exit;
  end;
  Result := '';
  SetLength(Result, W);
  FillChar(Result[1], n, 32);
  if Length(S) > 0 then
    Move(S[1], Result[n + 1], Length(S));
end;

{ The number Big * 2^Shift, negative when Neg, with D decimals (6, the
  zeros at the end dropped but one kept, when D is below 0), rounded
  once, exactly, a tie to even; padded to W. Shared by the double and
  the quad (P103). }
function FmtExact(var Big: TBig; Shift: Integer; Neg: Boolean; W, D: Integer): string;
var
  s, digits, ip, fp: string;
  dd, i: Integer;
begin
  dd := D;
  if dd < 0 then
    dd := 6;
  i := dd;
  while i >= 9 do
  begin
    BigMulSmall(Big, 1000000000);
    i := i - 9;
  end;
  while i > 0 do
  begin
    BigMulSmall(Big, 10);
    i := i - 1;
  end;
  if Shift > 0 then
    BigShl(Big, Shift)
  else if Shift < 0 then
    BigShrRound(Big, -Shift);
  digits := BigToDec(Big);
  while Length(digits) <= dd do
    digits := '0' + digits;
  ip := Copy(digits, 1, Length(digits) - dd);
  fp := Copy(digits, Length(digits) - dd + 1, dd);
  if D < 0 then
  begin
    i := Length(fp);
    while (i > 1) and (fp[i] = '0') do
      i := i - 1;
    fp := Copy(fp, 1, i);
  end;
  if dd = 0 then
    s := ip
  else
    s := ip + '.' + fp;
  if Neg then
    s := '-' + s;
  Result := Pad(s, W);
end;

function PasFmtReal(X: Double; W, D: Integer): string;
var
  bits, m, e: Int64;
  neg: Boolean;
  big: TBig;
  s: string;
begin
  bits := 0;
  Move(X, bits, 8);
  neg := bits < 0;
  e := (bits shr 52) and 2047;
  m := bits and 4503599627370495;
  if e = 2047 then
  begin
    if m <> 0 then
      s := 'NaN'
    else if neg then
      s := '-Inf'
    else
      s := '+Inf';
    Result := Pad(s, W);
    Exit;
  end;
  if e = 0 then
    e := 1
  else
    m := m or 4503599627370496;
  big := nil;
  SetLength(big, 2);
  big[0] := m and 4294967295;
  big[1] := m shr 32;
  BigTrim(big);
  Result := FmtExact(big, e - 1075, neg, W, D);
end;

{ A binary128 (P103) exactly with D decimals, as PasFmtReal does a
  double. }
function PasFmtQuad(Lo, Hi: Int64; W, D: Integer): string;
var
  e, mh: Int64;
  neg: Boolean;
  big: TBig;
  s: string;
begin
  neg := Hi < 0;
  e := (Hi shr 48) and 32767;
  mh := Hi and 281474976710655;
  if e = 32767 then
  begin
    if (mh <> 0) or (Lo <> 0) then
      s := 'NaN'
    else if neg then
      s := '-Inf'
    else
      s := '+Inf';
    Result := Pad(s, W);
    Exit;
  end;
  if e = 0 then
    e := 1
  else
    mh := mh or 281474976710656;
  big := nil;
  SetLength(big, 4);
  big[0] := Lo and 4294967295;
  big[1] := Lo shr 32;
  big[2] := mh and 4294967295;
  big[3] := mh shr 32;
  BigTrim(big);
  Result := FmtExact(big, e - 16495, neg, W, D);
end;

{ ---- the digits of a Quad (P129) ---- }

{ 10^K, K from 0 to 9. }
function SmallPow10(K: Int64): Int64;
begin
  Result := 1;
  while K > 0 do
  begin
    Result := Result * 10;
    K := K - 1;
  end;
end;

function BigCopy(const A: TBig): TBig;
var
  i: Integer;
begin
  Result := nil;
  SetLength(Result, Length(A));
  for i := 0 to High(A) do
    Result[i] := A[i];
end;

{ A times 10^K, K not below 0. }
procedure BigMulPow10(var A: TBig; K: Int64);
begin
  while K >= 9 do
  begin
    BigMulSmall(A, 1000000000);
    K := K - 9;
  end;
  if K > 0 then
    BigMulSmall(A, SmallPow10(K));
end;

{ What a floor dropped, against half the last unit it kept, is a class:
  0 nothing, 1 less than a half, 2 a half, 3 more. }

{ A divided by 10^K, K above 0, and Cls the class of what the division
  dropped: nine digits at a time from the lowest, so the last remainder
  is the top of the dropped part and the ones before only say whether it
  goes on. }
procedure BigDivPow10(var A: TBig; K: Int64; out Cls: Integer);
var
  r, t, top, half: Int64;
  lowNZ: Boolean;
begin
  lowNZ := False;
  top := 0;
  t := 1;
  while K > 0 do
  begin
    t := K;
    if t > 9 then
      t := 9;
    BigDivSmall(A, SmallPow10(t), r);
    K := K - t;
    if K > 0 then
      lowNZ := lowNZ or (r <> 0)
    else
      top := r;
  end;
  half := 5 * SmallPow10(t - 1);
  if top > half then
    Cls := 3
  else if top = half then
  begin
    if lowNZ then
      Cls := 3
    else
      Cls := 2;
  end
  else if (top = 0) and not lowNZ then
    Cls := 0
  else
    Cls := 1;
end;

{ floor(M * 2^E * 10^P) in D, and in Cls the class of what the floor
  dropped: the power of 10 first, exactly (a product, or a division whose
  remainder is kept as its class), then the power of 2, whose dropped
  bits say the rest (the half bit, and any bit below it or a remainder
  of the division). }
procedure QuadScale(const M: TBig; E, P: Int64; out D: TBig; out Cls: Integer);
var
  s: Int64;
  dc: Integer;
  half, rest: Boolean;
begin
  D := BigCopy(M);
  s := 0;
  if E >= 0 then
    BigShl(D, E)
  else
    s := -E;
  dc := 0;
  if P > 0 then
    BigMulPow10(D, P)
  else if P < 0 then
    BigDivPow10(D, -P, dc);
  if s = 0 then
  begin
    Cls := dc;
    Exit;
  end;
  half := BigBit(D, s - 1);
  rest := (dc <> 0) or BigLowAny(D, s - 1);
  BigShrTrunc(D, s);
  if half then
  begin
    if rest then
      Cls := 3
    else
      Cls := 2;
  end
  else if rest then
    Cls := 1
  else
    Cls := 0;
end;

{ D rounded by what its floor dropped: up above a half, and at a half
  when D is odd (a tie to even). }
procedure BigRoundCls(var D: TBig; Cls: Integer);
begin
  if (Cls = 3) or ((Cls = 2) and ((D[0] and 1) <> 0)) then
    BigAddSmall(D, 1);
end;

{ floor(X * log10 2), and floor(X * log10 2 + log10 3/4): uscale.go's
  log10Pow2 and skewed with constants of 32 bits, exact for every X from
  -17000 to 17000 (checked against 80 digits), the range of a Quad; Go's
  of 18 and 21 bits are exact for a Double's. }
function Log10Pow2Q(X: Int64): Int64;
begin
{$ifdef FPC}
  Result := SarInt64(X * 1292913986, 32);
{$else}
  Result := (X * 1292913986) sar 32;
{$endif}
end;

function SkewedQ(X: Int64): Int64;
begin
{$ifdef FPC}
  Result := SarInt64(X * 1292913986 - 536607788, 32);
{$else}
  Result := (X * 1292913986 - 536607788) sar 32;
{$endif}
end;

{ The significand of a Quad with its hidden bit, M, and the power of 2
  of its last bit, E: the magnitude is M * 2^E. Field is the exponent
  field; Kind 0 a number, 1 a zero, 2 an infinity or a NaN. }
procedure QuadParts(Lo, Hi: Int64; out M: TBig; out E, Field: Int64; out Kind: Integer);
var
  mh: Int64;
begin
  Field := (Hi shr 48) and 32767;
  mh := Hi and 281474976710655;
  M := nil;
  SetLength(M, 4);
  E := 0;
  if Field = 32767 then
  begin
    Kind := 2;
    Exit;
  end;
  if Field = 0 then
    E := 1
  else
  begin
    E := Field;
    mh := mh or 281474976710656;
  end;
  E := E - 16495;
  M[0] := Lo and 4294967295;
  M[1] := Lo shr 32;
  M[2] := mh and 4294967295;
  M[3] := mh shr 32;
  BigTrim(M);
  if BigIsZero(M) then
    Kind := 1
  else
    Kind := 0;
end;

{ The digits of a Quad's magnitude as Go writes a float64's (ftoa.go;
  uscale.go's shortFloat and fixedWidthFloat), with exact arithmetic in
  place of the unrounded scaling, which Go works out for 64 bits: Mode 0
  the fewest digits that read back as the Quad, the nearest of them when
  two do; 1 N significant digits; 2 the digits to N places after the
  point (below 0, a place before it). Rounded once, a tie to even. The
  magnitude is 0.Result * 10^Dp; Result has no trailing zero and is ''
  (Dp 0) for a zero, a value that rounds to 0, or one not finite. }
function PasQuadDigits(Lo, Hi: Int64; Mode, N: Int64; out Dp: Int64): string;
var
  m, d, t, dmin, dmax, one: TBig;
  e, field, p, k, pt, r: Int64;
  kind, cls: Integer;
  skew, incl: Boolean;
  s: string;
  i: Integer;
begin
  Result := '';
  Dp := 0;
  QuadParts(Lo, Hi, m, e, field, kind);
  if kind <> 0 then
    Exit;
  if Mode = 0 then
  begin
    { the values that round to the Quad: half its last bit either side,
      a quarter below when it is a power of 2 whose neighbour below has
      half its spacing; the bounds too when its last bit is 0 (a tie
      goes to it). In quarters of that bit, scaled by 10^p, p chosen so
      that the interval spans 1 to 10 units (shortFloat's). }
    skew := (field > 1) and (Lo = 0) and ((Hi and 281474976710655) = 0);
    incl := (m[0] and 1) = 0;
    one := nil;
    SetLength(one, 1);
    t := BigCopy(m);
    BigShl(t, 2);
    if skew then
    begin
      one[0] := 1;
      p := -SkewedQ(e);
    end
    else
    begin
      one[0] := 2;
      p := -Log10Pow2Q(e);
    end;
    BigSub(t, one);
    QuadScale(t, e - 2, p, dmin, cls);
    if (cls <> 0) or not incl then
      BigAddSmall(dmin, 1);
    t := BigCopy(m);
    BigShl(t, 2);
    BigAddSmall(t, 2);
    QuadScale(t, e - 2, p, dmax, cls);
    if (cls = 0) and not incl then
    begin
      one[0] := 1;
      BigSub(dmax, one);
    end;
    { a multiple of 10 among them is a digit fewer }
    t := BigCopy(dmax);
    BigDivSmall(t, 10, r);
    d := BigCopy(t);
    BigMulSmall(d, 10);
    if BigCmp(d, dmin) >= 0 then
    begin
      s := BigToDec(t);
      pt := Length(s) - p + 1;
    end
    else
    begin
      if BigCmp(dmin, dmax) < 0 then
      begin
        QuadScale(m, e, p, d, cls);
        BigRoundCls(d, cls);
      end
      else
        d := dmin;
      s := BigToDec(d);
      pt := Length(s) - p;
    end;
  end
  else if Mode = 1 then
  begin
    { the place of the point first, from the bits and then checked: k
      digits (one when N asks for none) must come out }
    k := N;
    if k < 1 then
      k := 1;
    pt := Log10Pow2Q(BigBitLen(m) + e - 1) + 1;
    repeat
      QuadScale(m, e, k - pt, d, cls);
      s := BigToDec(BigCopy(d));
      if Length(s) > k then
        pt := pt + 1
      else if Length(s) < k then
        pt := pt - 1
      else
        Break;
    until False;
    p := k - pt;
    if N < 1 then
    begin
      p := N - pt;
      QuadScale(m, e, p, d, cls);
    end;
    BigRoundCls(d, cls);
    s := BigToDec(d);
    if s = '0' then
      Exit;
    pt := Length(s) - p;
  end
  else
  begin
    QuadScale(m, e, N, d, cls);
    BigRoundCls(d, cls);
    s := BigToDec(d);
    if s = '0' then
      Exit;
    pt := Length(s) - N;
  end;
  i := Length(s);
  while (i > 1) and (s[i] = '0') do
    i := i - 1;
  Result := Copy(s, 1, i);
  Dp := pt;
end;

const
  DigitPairs = '00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899';

{ V in decimal, right-aligned in W columns (P129, from paslib's IntToStr,
  which calls it now): two digits at a time from DigitPairs, from the
  end of a buffer, as Go's strconv.formatBits; the value is kept at or
  below zero, so Low(Int64), which has no positive twin, comes out whole;
  one string made. It put one digit before the string at a time, a
  string made for each. The digits go through pointers, b into buf and
  dp into DigitPairs: every index is in range by construction (i from 24
  down, at most 19 digits and a sign; r below 100). }
function PasFmtInt(V: Int64; W: Integer): string;
var
  buf: array[0..23] of Char;
  b, dp: PChar;
  i, n, sp: Integer;
  q, r, t: Int64;
begin
  b := @buf[0];
  dp := @DigitPairs[1];
  if V > 0 then
    q := -V
  else
    q := V;
  i := 24;
  while q <= -100 do
  begin
    t := q div 100;
    r := t * 100 - q;
    q := t;
    i := i - 2;
    b[i] := dp[r * 2];
    b[i + 1] := dp[r * 2 + 1];
  end;
  r := -q;
  if r >= 10 then
  begin
    i := i - 2;
    b[i] := dp[r * 2];
    b[i + 1] := dp[r * 2 + 1];
  end
  else
  begin
    i := i - 1;
    b[i] := Char(Ord('0') + r);
  end;
  if V < 0 then
  begin
    i := i - 1;
    b[i] := '-';
  end;
  n := 24 - i;
  sp := W - n;
  if sp < 0 then
    sp := 0;
  Result := '';
  SetLength(Result, n + sp);
  if sp > 0 then
    FillChar(Result[1], sp, 32);
  Move(b[i], Result[sp + 1], n);
end;

function PasFmtStr(const S: string; W: Integer): string;
begin
  Result := Pad(S, W);
end;

constructor ECurrencyError.Create(AKind: TCurrencyFault);
begin
  FKind := AKind;
  case AKind of
    cfOverflow: FMessage := 'Currency overflow';
    cfDivideByZero: FMessage := 'Currency divide by zero';
    cfInvalidValue: FMessage := 'invalid Currency value';
  end;
end;

function ECurrencyError.ToString: string;
begin
  Result := FMessage;
end;

function CurrMagnitude(V: Int64): Int64;
begin
  Result := V;
  if V < 0 then Result := -V;
end;

{ Q is unsigned. The sole allowed high-bit magnitude is exactly 2^63
  when negative: the asymmetric signed boundary is intentional. }
function CurrSigned(Q: Int64; Negative: Boolean): Int64;
begin
  if (Q < 0) and not (Negative and (Q = Low(Int64))) then
    raise ECurrencyError.Create(cfOverflow);
  Result := Q;
  if Negative then Result := -Q;
end;

function CurrBigSigned(const A: TBig; Negative: Boolean; out V: Int64): Boolean;
var magnitude: Int64;
begin
  Result := False; V := 0;
  if Length(A) > 2 then Exit;
  magnitude := A[0];
  if Length(A) = 2 then magnitude := magnitude or (A[1] shl 32);
  if (magnitude < 0) and not (Negative and (magnitude = Low(Int64))) then Exit;
  V := magnitude;
  if Negative then V := -V;
  Result := True;
end;

function CurrBig(V: Int64): TBig;
begin
  Result := nil; SetLength(Result, 2);
  Result[0] := V and 4294967295;
  Result[1] := V shr 32;
  BigTrim(Result);
end;

function PasCurrFromInt(V: Int64): Int64;
begin
  if (V < -922337203685477) or (V > 922337203685477) then
    raise ECurrencyError.Create(cfOverflow);
  Result := V * 10000;
end;

function PasCurrAdd(A, B: Int64): Int64;
begin
  Result := A + B;
  if ((A xor Result) and (B xor Result)) < 0 then
    raise ECurrencyError.Create(cfOverflow);
end;

function PasCurrSub(A, B: Int64): Int64;
begin
  Result := A - B;
  if ((A xor B) and (A xor Result)) < 0 then
    raise ECurrencyError.Create(cfOverflow);
end;

function PasCurrNeg(V: Int64): Int64;
begin
  if V = Low(Int64) then raise ECurrencyError.Create(cfOverflow);
  Result := -V;
end;

function PasCurrAbs(V: Int64): Int64;
begin
  Result := V;
  if V < 0 then Result := PasCurrNeg(V);
end;

{ Go math/big/float.go round: the discarded half and sticky remainder
  determine one nearest-even decision. The native product/division use
  the existing machine-word kernels, not new assembler in this unit. }
procedure CurrWideMul(A, B: Int64; out Hi, Lo: Int64);
{$ifdef FPC}
var a0, a1, b0, b1, t, middle, carry: Int64;
{$endif}
begin
{$ifdef FPC}
  a0 := A and 4294967295; a1 := A shr 32;
  b0 := B and 4294967295; b1 := B shr 32;
  t := a0 * b0; Lo := t and 4294967295;
  t := a1 * b0 + (t shr 32); middle := t and 4294967295;
  carry := t shr 32; t := a0 * b1 + middle;
  Hi := a1 * b1 + carry + (t shr 32);
  Lo := Lo or (t shl 32);
{$else}
  Mul128(A, B, Hi, Lo);
{$endif}
end;

procedure CurrWideDiv(Hi, Lo, Denominator: Int64; out Q, R: Int64);
{$ifdef FPC}
var numerator, divisor, quotient, remainder: TBig;
{$endif}
begin
{$ifdef FPC}
  numerator := nil; SetLength(numerator, 4);
  numerator[0] := Lo and 4294967295; numerator[1] := Lo shr 32;
  numerator[2] := Hi and 4294967295; numerator[3] := Hi shr 32;
  BigTrim(numerator); divisor := CurrBig(Denominator);
  BigDivMod(numerator, divisor, quotient, remainder);
  Q := quotient[0];
  if Length(quotient) = 2 then Q := Q or (quotient[1] shl 32);
  R := remainder[0];
  if Length(remainder) = 2 then R := R or (remainder[1] shl 32);
{$else}
  DivMod128(Hi, Lo, Denominator, Q, R);
{$endif}
end;

function CurrQuotient(Hi, Lo, Denominator: Int64; Negative: Boolean): Int64;
var q, r, half: Int64;
begin
  { Native DivMod128 requires an unsigned quotient that fits one word.
    Hi is nonnegative here; a negative denominator means exactly 2^63. }
  if (Denominator >= 0) and (Hi >= Denominator) then
    raise ECurrencyError.Create(cfOverflow);
  CurrWideDiv(Hi, Lo, Denominator, q, r);
  half := Denominator shr 1;
  if (r > half) or ((r = half) and ((Denominator and 1) = 0) and Odd(q)) then
  begin
    if q = -1 then raise ECurrencyError.Create(cfOverflow);
    q := q + 1;
  end;
  Result := CurrSigned(q, Negative);
end;

function PasCurrMul(A, B: Int64): Int64;
var hi, lo: Int64;
begin
  CurrWideMul(CurrMagnitude(A), CurrMagnitude(B), hi, lo);
  Result := CurrQuotient(hi, lo, 10000, (A < 0) <> (B < 0));
end;

function PasCurrDiv(A, B: Int64): Int64;
var hi, lo: Int64;
begin
  if B = 0 then raise ECurrencyError.Create(cfDivideByZero);
  CurrWideMul(CurrMagnitude(A), 10000, hi, lo);
  Result := CurrQuotient(hi, lo, CurrMagnitude(B), (A < 0) <> (B < 0));
end;

function PasCurrSqr(V: Int64): Int64;
begin Result := PasCurrMul(V, V) end;

{$ifndef FPC}
function PasCurrFromQuadValue(Value: Quad): Int64;
var words: TCurrencyQuadWords;
begin
  Move(Value, words, SizeOf(words));
  Result := PasCurrFromQuad(words[0], words[1]);
end;
{$endif}

function PasCurrTrunc(V: Int64): Int64;
begin
  Result := V div 10000;
end;

function PasCurrRound(V: Int64): Int64;
var remainder: Int64;
begin
  Result := V div 10000; remainder := V mod 10000;
  if (Abs(remainder) > 5000) or ((Abs(remainder) = 5000) and Odd(Result)) then
    if V < 0 then Result := Result - 1 else Result := Result + 1;
end;

function PasCurrFloor(V: Int64): Int64;
begin
  Result := V div 10000;
  if (V < 0) and ((V mod 10000) <> 0) then Result := Result - 1;
end;

function PasCurrCeil(V: Int64): Int64;
begin
  Result := V div 10000;
  if (V > 0) and ((V mod 10000) <> 0) then Result := Result + 1;
end;

function PasCurrInt(V: Int64): Int64;
begin Result := (V div 10000) * 10000 end;

function PasCurrFrac(V: Int64): Int64;
begin Result := V mod 10000 end;

function PasCurrMin(A, B: Int64): Int64;
begin if A < B then Result := A else Result := B end;

function PasCurrMax(A, B: Int64): Int64;
begin if A > B then Result := A else Result := B end;

function PasTryParseCurrency(const S: string; out V: Int64): Boolean;
var magnitude: TBig; negative: Boolean; digits, exponent, cls: Integer;
begin
  V := 0; Result := False;
  if not ScanReal(S, negative, magnitude, digits, exponent) then Exit;
  if BigIsZero(magnitude) then begin Result := True; Exit end;
  exponent := exponent + 4;
  { At most 19 scaled digits fit. A magnitude strictly below a tenth
    of one scaled unit rounds to zero without constructing 10^100000. }
  if digits + exponent > 19 then Exit;
  if digits + exponent < 0 then begin Result := True; Exit end;
  if exponent >= 0 then BigMulPow10(magnitude, exponent)
  else
  begin
    BigDivPow10(magnitude, -exponent, cls);
    BigRoundCls(magnitude, cls);
  end;
  Result := CurrBigSigned(magnitude, negative, V);
end;

function PasCurrFromReal(X: Double): Int64;
var bits, field, mantissa: Int64; exponent: Integer; magnitude: TBig;
begin
  bits := 0;
  Move(X, bits, 8); field := (bits shr 52) and 2047;
  if field = 2047 then raise ECurrencyError.Create(cfInvalidValue);
  mantissa := bits and 4503599627370495;
  if field = 0 then exponent := -1074
  else
  begin
    mantissa := mantissa or 4503599627370496;
    exponent := field - 1075;
  end;
  magnitude := CurrBig(mantissa); BigMulSmall(magnitude, 10000);
  if exponent >= 0 then BigShl(magnitude, exponent)
  else BigShrRound(magnitude, -exponent);
  if not CurrBigSigned(magnitude, bits < 0, Result) then
    raise ECurrencyError.Create(cfOverflow);
end;

function PasCurrFromQuad(Lo, Hi: Int64): Int64;
var mantissa, magnitude: TBig; exponent, field: Int64; kind, cls: Integer;
begin
  QuadParts(Lo, Hi, mantissa, exponent, field, kind);
  if kind = 2 then raise ECurrencyError.Create(cfInvalidValue);
  QuadScale(mantissa, exponent, 4, magnitude, cls);
  BigRoundCls(magnitude, cls);
  if not CurrBigSigned(magnitude, Hi < 0, Result) then
    raise ECurrencyError.Create(cfOverflow);
end;

function PasCurrFromQuadWords(const Words: TCurrencyQuadWords): Int64;
begin Result := PasCurrFromQuad(Words[0], Words[1]) end;

{ A decimal of four places is already exact. Precision requests alter
  the integer scale, round once, and reuse the common formatting engine.
  There is no intermediate Double/Quad or dependence on a CPU FP mode. }
function PasCurrencyDigits(V, Mode, N: Int64; out Dp: Int64): string;
var magnitude: TBig; shift: Int64; cls: Integer;
begin
  Dp := 0; Result := '';
  if V = 0 then Exit;
  magnitude := CurrBig(CurrMagnitude(V));
  Result := BigToDec(BigCopy(magnitude));
  Dp := Length(Result) - 4;
  if Mode = 1 then
  begin
    if N < 1 then N := 1;
    shift := N - Dp - 4;
  end
  else if Mode = 2 then shift := N - 4
  else shift := 0;
  if shift > 0 then BigMulPow10(magnitude, shift)
  else if shift < 0 then
  begin
    BigDivPow10(magnitude, -shift, cls);
    BigRoundCls(magnitude, cls);
  end;
  if BigIsZero(magnitude) then begin Result := ''; Dp := 0; Exit end;
  Result := BigToDec(magnitude);
  Dp := Length(Result) - 4 - shift;
  while (Length(Result) > 1) and (Result[Length(Result)] = '0') do
    SetLength(Result, Length(Result) - 1);
end;

function PasFmtCurrency(V: Int64; W, D: Integer): string;
var digits, text: string; dp, places, count, index, offset, total: Int64;
begin
  if D < -1 then raise ECurrencyError.Create(cfInvalidValue);
  if D = -1 then digits := PasCurrencyDigits(V, 0, 0, dp)
  else digits := PasCurrencyDigits(V, 2, D, dp);
  places := D;
  if places < 0 then
  begin
    places := Length(digits) - dp;
    if places < 0 then places := 0;
  end;
  count := dp; if count < 1 then count := 1;
  offset := 0;
  if (V < 0) and (digits <> '') then offset := 1;
  if places > High(Int64) - count - offset - 1 then
    raise ECurrencyError.Create(cfOverflow);
  total := offset + count + places;
  if places > 0 then total := total + 1;
  text := ''; SetLength(text, total);
  FillChar(text[1], total, 48);
  if offset > 0 then text[1] := '-';
  for index := 1 to dp do
    if index <= Length(digits) then text[offset + index] := digits[index];
  if places > 0 then
  begin
    text[offset + count + 1] := '.';
    for index := 1 to places do
      if (dp + index > 0) and (dp + index <= Length(digits)) then
        text[offset + count + 1 + index] := digits[dp + index];
  end;
  Result := Pad(text, W);
end;

function PasCurrToReal(V: Int64): Double;
var bits: Int64;
begin
  Result := 0;
  if not PasParseReal(PasFmtCurrency(V, 0, -1), bits) then
    raise ECurrencyError.Create(cfInvalidValue);
  Move(bits, Result, 8);
end;

end.
