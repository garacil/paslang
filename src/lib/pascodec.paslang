{ The code point at S[I] and its length; a byte that does not start a
  well-formed sequence is itself, length 1 (-1 - the byte) }
function RuneAt(const S: string; I: Integer; out N: Integer): Integer;
var
  c, c2, c3, c4: Integer;
begin
  c := Ord(S[I]);
  N := 1;
  if c < $80 then
  begin
    Result := c;
    Exit;
  end;
  Result := -1 - c;
  if (c >= $C2) and (c <= $DF) and (I + 1 <= Length(S)) then
  begin
    c2 := Ord(S[I + 1]);
    if (c2 and $C0) = $80 then
    begin
      Result := ((c and $1F) shl 6) or (c2 and $3F);
      N := 2;
    end;
  end
  else if (c >= $E0) and (c <= $EF) and (I + 2 <= Length(S)) then
  begin
    c2 := Ord(S[I + 1]);
    c3 := Ord(S[I + 2]);
    if ((c2 and $C0) = $80) and ((c3 and $C0) = $80) and ((c <> $E0) or (c2 >= $A0)) and
      ((c <> $ED) or (c2 < $A0)) then
    begin
      Result := ((c and $0F) shl 12) or ((c2 and $3F) shl 6) or (c3 and $3F);
      N := 3;
    end;
  end
  else if (c >= $F0) and (c <= $F4) and (I + 3 <= Length(S)) then
  begin
    c2 := Ord(S[I + 1]);
    c3 := Ord(S[I + 2]);
    c4 := Ord(S[I + 3]);
    if ((c2 and $C0) = $80) and ((c3 and $C0) = $80) and ((c4 and $C0) = $80) and
      ((c <> $F0) or (c2 >= $90)) and ((c <> $F4) or (c2 < $90)) then
    begin
      Result := ((c and $07) shl 18) or ((c2 and $3F) shl 12) or ((c3 and $3F) shl 6) or (c4 and $3F);
      N := 4;
    end;
  end;
end;

function RuneBytes(R: Integer): string;
begin
  if R < $80 then
    Result := Chr(R)
  else if R < $800 then
    Result := Chr($C0 or (R shr 6)) + Chr($80 or (R and $3F))
  else
    Result := Chr($E0 or (R shr 12)) + Chr($80 or ((R shr 6) and $3F)) + Chr($80 or (R and $3F));
end;

function FoldAccents(const S: string): string;
var
  i, n, r: Integer;
begin
  Result := '';
  i := 1;
  while i <= Length(S) do
  begin
    r := RuneAt(S, i, n);
    if (r >= $80) and (r <= $17F) and (FoldTab[r - $80] <> '') then
      Result := Result + FoldTab[r - $80]
    else
      Result := Result + Copy(S, i, n);
    i := i + n;
  end;
end;

function UpperText(const S: string): string;
var
  i, n, r: Integer;
begin
  Result := '';
  i := 1;
  while i <= Length(S) do
  begin
    r := RuneAt(S, i, n);
    if (r >= 0) and (r <= $17F) then
      Result := Result + RuneBytes(UpperTab[r])
    else
      Result := Result + Copy(S, i, n);
    i := i + n;
  end;
end;

function LowerText(const S: string): string;
var
  i, n, r: Integer;
begin
  Result := '';
  i := 1;
  while i <= Length(S) do
  begin
    r := RuneAt(S, i, n);
    if (r >= 0) and (r <= $17F) then
      Result := Result + RuneBytes(LowerTab[r])
    else
      Result := Result + Copy(S, i, n);
    i := i + n;
  end;
end;

end.
