{ Text codecs a service needs (P435, 1.1.261): base64 and base64url as
  Go's encoding/base64 reads and writes them, URL escaping as Go's
  net/url QueryEscape, PathEscape and their unescapes, CSV as Go's
  encoding/csv reads and writes it, and the letters of Spanish text:
  accents taken off for a search key, upper and lower case of the
  code points U+0000 to U+017F as Go's strings.ToUpper and ToLower map
  them. Free of units and of state, so every routine may call these
  at once (Regla 11). }
unit pascodec;

interface

uses
  sysutils;

{ Base64 (RFC 4648 4 and 5): the standard alphabet, or with Url the one
  that has - and _; with Pad the = at the end. The decoder reads as
  Go's DecodeString does: CR and LF are skipped, nothing else but the
  alphabet is let by, the padding must be there when Pad and must not
  when not; False for what it refuses. }
function Base64Encode(const S: string; Url, Pad: Boolean): string;
function Base64Decode(const S: string; Url, Pad: Boolean; out R: string): Boolean;

{ URL escaping as Go's net/url: UrlQueryEscape (QueryEscape: a space is
  +, everything but letters, digits and -_.~ is %XX) and UrlPathEscape
  (PathEscape: a path segment, which keeps $&+=:@ and lets / and ? go).
  The unescapes read %XX and, for the query form, + as a space; False
  for a % not followed by two hex digits. }
function UrlQueryEscape(const S: string): string;
function UrlPathEscape(const S: string): string;
function UrlQueryUnescape(const S: string; out R: string): Boolean;
function UrlPathUnescape(const S: string; out R: string): Boolean;

type
  ECsvError = class(Exception)
  public
    { 1 bare quote in an unquoted field, 2 extraneous or missing quote
      in a quoted one, 3 wrong number of fields }
    Kind: Integer;
    StartLine, Line, Column: Integer;
    constructor CreateAt(AKind, AStart, ALine, ACol: Integer);
  end;

  { Records of CSV text as Go's csv.Reader reads them: a UTF-8 byte
    order mark at the start is dropped; a line ends at LF, CRLF or a
    CR that ends the text, and a CRLF inside a quoted field is read as
    LF; empty lines and, when Comment is set, lines that start with it
    are skipped; a field in quotes holds the separator, line ends and
    "" for a quote. Comma and Comment are one byte. }
  TCsvReader = class
  private
    FText: string;
    FPos: Integer;
    FLine: Integer;
  public
    Comma: Char;
    Comment: Char;
    { 0: the first record sets the count, a later one with another is an
      error; above 0: that count; below 0: any }
    FieldsPerRecord: Integer;
    { a quote in an unquoted field, or one not followed by a separator in
      a quoted one, is taken as it stands }
    LazyQuotes: Boolean;
    TrimLeadingSpace: Boolean;
    constructor Create(const AText: string);
    { the next record; False at the end of the text; ECsvError for a bad
      one (the reader then goes on at the next line) }
    function ReadRecord(out Fields: TStringArray): Boolean;
    { the line the next record starts on (1-based) }
    function NextLine: Integer;
  end;

{ One record as a line of CSV, as Go's csv.Writer writes it: a field is
  quoted when it is empty-looking trouble (a separator, a quote, a CR or
  LF, a leading space, or \. alone), a quote doubled; the line ends with
  LF, or CRLF when CrLf. }
function CsvLine(const Fields: array of string; Comma: Char; CrLf: Boolean): string;

{ S without the marks of its letters, for a search that ignores accents:
  the letters of Latin-1 and Latin Extended-A to their ASCII base (é e,
  ñ n, ç c, ü u), and ß ss, æ ae, œ oe, ø o, đ d, ð d, þ th, ł l; every
  other code point as it is. UTF-8 in, UTF-8 out; bytes that are not UTF-8
  pass as they are. }
function FoldAccents(const S: string): string;
{ Go's ToUpper and ToLower for the code points U+0000 to U+017F, the
  rest of the text as it is: á to Á, ñ to Ñ, ÿ to Ÿ, ß stays }
function UpperText(const S: string): string;
function LowerText(const S: string): string;

implementation

const
  HexUpper: string = '0123456789ABCDEF';

{ ---- base64, encoding/base64 ---- }

const
  B64Std: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
  B64Url: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';

function Base64Encode(const S: string; Url, Pad: Boolean): string;
var
  i, n, v, k: Integer;
  al: string;
begin
  if Url then
    al := B64Url
  else
    al := B64Std;
  n := Length(S);
  SetLength(Result, ((n + 2) div 3) * 4);
  k := 0;
  i := 1;
  while i + 2 <= n do
  begin
    v := (Ord(S[i]) shl 16) or (Ord(S[i + 1]) shl 8) or Ord(S[i + 2]);
    Result[k + 1] := al[(v shr 18) + 1];
    Result[k + 2] := al[((v shr 12) and 63) + 1];
    Result[k + 3] := al[((v shr 6) and 63) + 1];
    Result[k + 4] := al[(v and 63) + 1];
    k := k + 4;
    i := i + 3;
  end;
  if n - i = 1 then
  begin
    v := (Ord(S[i]) shl 16) or (Ord(S[i + 1]) shl 8);
    Result[k + 1] := al[(v shr 18) + 1];
    Result[k + 2] := al[((v shr 12) and 63) + 1];
    Result[k + 3] := al[((v shr 6) and 63) + 1];
    if Pad then
    begin
      Result[k + 4] := '=';
      k := k + 4;
    end
    else
      k := k + 3;
  end
  else if n - i = 0 then
  begin
    v := Ord(S[i]) shl 16;
    Result[k + 1] := al[(v shr 18) + 1];
    Result[k + 2] := al[((v shr 12) and 63) + 1];
    if Pad then
    begin
      Result[k + 3] := '=';
      Result[k + 4] := '=';
      k := k + 4;
    end
    else
      k := k + 2;
  end;
  SetLength(Result, k);
end;

function B64Val(C: Char; Url: Boolean): Integer;
begin
  case C of
    'A'..'Z': Result := Ord(C) - 65;
    'a'..'z': Result := Ord(C) - 71;
    '0'..'9': Result := Ord(C) + 4;
    '+': if Url then Result := -1 else Result := 62;
    '/': if Url then Result := -1 else Result := 63;
    '-': if Url then Result := 62 else Result := -1;
    '_': if Url then Result := 63 else Result := -1;
  else
    Result := -1;
  end;
end;

{ Go's decodeQuantum, which reads four symbols at a time, skips CR and LF
  anywhere, and takes = only as the one or two last symbols of the last
  quantum when padding is on; nothing may follow the padding. Trailing
  bits that are not zero are let by, as Go's default decoder lets them. }
function Base64Decode(const S: string; Url, Pad: Boolean; out R: string): Boolean;
var
  i, n, k, d, cnt, v, pads, w: Integer;
  c: Char;
begin
  Result := False;
  R := '';
  n := Length(S);
  SetLength(R, (n div 4) * 3 + 3);
  k := 0;
  cnt := 0;
  v := 0;
  pads := 0;
  i := 1;
  while i <= n do
  begin
    c := S[i];
    i := i + 1;
    if (c = #13) or (c = #10) then
      Continue;
    if c = '=' then
    begin
      { only when padding is on, after two or three symbols of a quantum,
        and then up to the quantum's end, and the text ends there }
      if (not Pad) or (cnt < 2) then
      begin
        R := '';
        Exit;
      end;
      pads := 1;
      w := cnt + 1;
      while w < 4 do
      begin
        while (i <= n) and ((S[i] = #13) or (S[i] = #10)) do
          i := i + 1;
        if (i > n) or (S[i] <> '=') then
        begin
          R := '';
          Exit;
        end;
        i := i + 1;
        w := w + 1;
      end;
      while (i <= n) and ((S[i] = #13) or (S[i] = #10)) do
        i := i + 1;
      if i <= n then
      begin
        R := '';
        Exit;
      end;
      Break;
    end;
    d := B64Val(c, Url);
    if d < 0 then
    begin
      R := '';
      Exit;
    end;
    v := (v shl 6) or d;
    cnt := cnt + 1;
    if cnt = 4 then
    begin
      R[k + 1] := Chr((v shr 16) and 255);
      R[k + 2] := Chr((v shr 8) and 255);
      R[k + 3] := Chr(v and 255);
      k := k + 3;
      cnt := 0;
      v := 0;
    end;
  end;
  if pads = 0 then
  begin
    { no padding: a last quantum of two or three symbols (Go: when Pad
      is on a short last quantum is an error) }
    if cnt = 1 then
    begin
      R := '';
      Exit;
    end;
    if (cnt > 0) and Pad then
    begin
      R := '';
      Exit;
    end;
  end;
  if cnt = 2 then
  begin
    R[k + 1] := Chr((v shr 4) and 255);
    k := k + 1;
  end
  else if cnt = 3 then
  begin
    R[k + 1] := Chr((v shr 10) and 255);
    R[k + 2] := Chr((v shr 2) and 255);
    k := k + 2;
  end;
  SetLength(R, k);
  Result := True;
end;

{ ---- net/url ---- }

{ Whether Go's shouldEscape says the byte stays as it is, in the query
  form (Q) or the path segment form }
function UrlKeep(C: Char; Query: Boolean): Boolean;
begin
  case C of
    'a'..'z', 'A'..'Z', '0'..'9', '-', '_', '.', '~':
      Result := True;
    '$', '&', '+', '=', ':', '@':
      Result := not Query;
  else
    Result := False;
  end;
end;

function UrlEscape(const S: string; Query: Boolean): string;
var
  i, n, k: Integer;
  c: Char;
begin
  n := 0;
  for i := 1 to Length(S) do
    if not UrlKeep(S[i], Query) and not (Query and (S[i] = ' ')) then
      n := n + 1;
  SetLength(Result, Length(S) + 2 * n);
  k := 0;
  for i := 1 to Length(S) do
  begin
    c := S[i];
    if Query and (c = ' ') then
    begin
      k := k + 1;
      Result[k] := '+';
    end
    else if UrlKeep(c, Query) then
    begin
      k := k + 1;
      Result[k] := c;
    end
    else
    begin
      Result[k + 1] := '%';
      Result[k + 2] := HexUpper[(Ord(c) shr 4) + 1];
      Result[k + 3] := HexUpper[(Ord(c) and 15) + 1];
      k := k + 3;
    end;
  end;
end;

function UrlQueryEscape(const S: string): string;
begin
  Result := UrlEscape(S, True);
end;

function UrlPathEscape(const S: string): string;
begin
  Result := UrlEscape(S, False);
end;

function HexVal(C: Char): Integer;
begin
  case C of
    '0'..'9': Result := Ord(C) - 48;
    'a'..'f': Result := Ord(C) - 87;
    'A'..'F': Result := Ord(C) - 55;
  else
    Result := -1;
  end;
end;

function UrlUnescape(const S: string; Query: Boolean; out R: string): Boolean;
var
  i, k, h, l: Integer;
begin
  Result := False;
  R := '';
  SetLength(R, Length(S));
  k := 0;
  i := 1;
  while i <= Length(S) do
  begin
    if S[i] = '%' then
    begin
      if i + 2 > Length(S) then
      begin
        R := '';
        Exit;
      end;
      h := HexVal(S[i + 1]);
      l := HexVal(S[i + 2]);
      if (h < 0) or (l < 0) then
      begin
        R := '';
        Exit;
      end;
      k := k + 1;
      R[k] := Chr(h * 16 + l);
      i := i + 3;
    end
    else
    begin
      k := k + 1;
      if Query and (S[i] = '+') then
        R[k] := ' '
      else
        R[k] := S[i];
      i := i + 1;
    end;
  end;
  SetLength(R, k);
  Result := True;
end;

function UrlQueryUnescape(const S: string; out R: string): Boolean;
begin
  Result := UrlUnescape(S, True, R);
end;

function UrlPathUnescape(const S: string; out R: string): Boolean;
begin
  Result := UrlUnescape(S, False, R);
end;

{ ---- encoding/csv ---- }

constructor ECsvError.CreateAt(AKind, AStart, ALine, ACol: Integer);
var
  what: string;
begin
  case AKind of
    1: what := 'bare " in non-quoted field';
    2: what := 'extraneous or missing " in quoted-field';
    3: what := 'wrong number of fields';
  else
    what := 'invalid delimiter';
  end;
  inherited Create('record on line ' + IntToStr(AStart) + ', line ' + IntToStr(ALine) + ', column ' +
    IntToStr(ACol) + ': ' + what);
  Kind := AKind;
  StartLine := AStart;
  Line := ALine;
  Column := ACol;
end;

constructor TCsvReader.Create(const AText: string);
begin
  FText := AText;
  FPos := 1;
  FLine := 0;
  Comma := ',';
  Comment := #0;
  FieldsPerRecord := 0;
  if (Length(FText) >= 3) and (FText[1] = Chr($EF)) and (FText[2] = Chr($BB)) and (FText[3] = Chr($BF)) then
    FPos := 4;
end;

function TCsvReader.NextLine: Integer;
begin
  Result := FLine + 1;
end;

{ Go's readLine: the line with its LF; CRLF becomes LF; a CR that ends
  the text with no LF is dropped; '' (and False) at the end }
function CsvReadLine(R: TCsvReader; out Line: string): Boolean;
var
  i, n: Integer;
begin
  n := Length(R.FText);
  Line := '';
  if R.FPos > n then
  begin
    Result := False;
    Exit;
  end;
  i := R.FPos;
  while (i <= n) and (R.FText[i] <> #10) do
    i := i + 1;
  if i <= n then
  begin
    Line := Copy(R.FText, R.FPos, i - R.FPos + 1);
    if (Length(Line) >= 2) and (Line[Length(Line) - 1] = #13) then
    begin
      Line[Length(Line) - 1] := #10;
      SetLength(Line, Length(Line) - 1);
    end;
    R.FPos := i + 1;
  end
  else
  begin
    Line := Copy(R.FText, R.FPos, n - R.FPos + 1);
    if (Line <> '') and (Line[Length(Line)] = #13) then
      SetLength(Line, Length(Line) - 1);
    R.FPos := n + 1;
  end;
  R.FLine := R.FLine + 1;
  Result := True;
end;

function CsvNL(const L: string): Integer;
begin
  if (L <> '') and (L[Length(L)] = #10) then
    Result := 1
  else
    Result := 0;
end;

function IsSpaceByte(C: Char): Boolean;
begin
  Result := (C = ' ') or (C = #9) or (C = #11) or (C = #12) or (C = #13) or (C = #10);
end;

function TCsvReader.ReadRecord(out Fields: TStringArray): Boolean;
var
  line, rec, field: string;
  idx: array of Integer;
  nf, i, j, recLine, col, lineNo, posLine: Integer;
  more, haveLine, failed: Boolean;
  errKind, errLine, errCol: Integer;
  atEof: Boolean;
begin
  Fields := nil;
  Result := False;
  { skip comment and empty lines }
  while True do
  begin
    haveLine := CsvReadLine(Self, line);
    if not haveLine then
      Exit;
    if (Comment <> #0) and (line <> '') and (line[1] = Comment) then
      Continue;
    if Length(line) = CsvNL(line) then
      Continue;
    Break;
  end;
  recLine := FLine;
  rec := '';
  nf := 0;
  SetLength(idx, 0);
  col := 1;
  posLine := FLine;
  errKind := 0;
  errLine := 0;
  errCol := 0;
  failed := False;
  atEof := False;
  while True do
  begin
    if TrimLeadingSpace then
    begin
      i := 1;
      while (i <= Length(line)) and IsSpaceByte(line[i]) do
        i := i + 1;
      if i > Length(line) then
        col := col - CsvNL(line);
      col := col + i - 1;
      line := Copy(line, i, Length(line) - i + 1);
    end;
    if (line = '') or (line[1] <> '"') then
    begin
      i := Pos(Comma, line);
      if i > 0 then
        field := Copy(line, 1, i - 1)
      else
        field := Copy(line, 1, Length(line) - CsvNL(line));
      if (not LazyQuotes) and (Pos('"', field) > 0) then
      begin
        failed := True;
        errKind := 1;
        errLine := FLine;
        errCol := col + Pos('"', field) - 1;
        Break;
      end;
      rec := rec + field;
      SetLength(idx, nf + 1);
      idx[nf] := Length(rec);
      nf := nf + 1;
      if i > 0 then
      begin
        line := Copy(line, i + 1, Length(line) - i);
        col := col + i;
        Continue;
      end;
      Break;
    end
    else
    begin
      line := Copy(line, 2, Length(line) - 1);
      col := col + 1;
      while True do
      begin
        i := Pos('"', line);
        if i > 0 then
        begin
          rec := rec + Copy(line, 1, i - 1);
          line := Copy(line, i + 1, Length(line) - i);
          col := col + i;
          if (line <> '') and (line[1] = '"') then
          begin
            rec := rec + '"';
            line := Copy(line, 2, Length(line) - 1);
            col := col + 1;
          end
          else if (line <> '') and (line[1] = Comma) then
          begin
            line := Copy(line, 2, Length(line) - 1);
            col := col + 1;
            SetLength(idx, nf + 1);
            idx[nf] := Length(rec);
            nf := nf + 1;
            more := True;
            Break;
          end
          else if Length(line) = CsvNL(line) then
          begin
            SetLength(idx, nf + 1);
            idx[nf] := Length(rec);
            nf := nf + 1;
            more := False;
            Break;
          end
          else if LazyQuotes then
            rec := rec + '"'
          else
          begin
            failed := True;
            errKind := 2;
            errLine := FLine;
            errCol := col - 1;
            more := False;
            Break;
          end;
        end
        else if line <> '' then
        begin
          rec := rec + line;
          col := col + Length(line);
          haveLine := CsvReadLine(Self, line);
          if haveLine and (line <> '') then
          begin
            posLine := FLine;
            col := 1;
          end;
          if not haveLine then
          begin
            { the text ended inside the quotes }
            atEof := True;
            if not LazyQuotes then
            begin
              failed := True;
              errKind := 2;
              errLine := posLine;
              errCol := col;
            end
            else
            begin
              SetLength(idx, nf + 1);
              idx[nf] := Length(rec);
              nf := nf + 1;
            end;
            more := False;
            Break;
          end;
        end
        else
        begin
          if (not LazyQuotes) and (not atEof) then
          begin
            failed := True;
            errKind := 2;
            errLine := posLine;
            errCol := col;
            more := False;
            Break;
          end;
          SetLength(idx, nf + 1);
          idx[nf] := Length(rec);
          nf := nf + 1;
          more := False;
          Break;
        end;
      end;
      if failed or not more then
        Break;
    end;
  end;
  SetLength(Fields, nf);
  j := 0;
  for i := 0 to nf - 1 do
  begin
    Fields[i] := Copy(rec, j + 1, idx[i] - j);
    j := idx[i];
  end;
  Result := True;
  if failed then
    raise ECsvError.CreateAt(errKind, recLine, errLine, errCol);
  if FieldsPerRecord > 0 then
  begin
    if nf <> FieldsPerRecord then
      raise ECsvError.CreateAt(3, recLine, recLine, 1);
  end
  else if FieldsPerRecord = 0 then
    FieldsPerRecord := nf;
end;

{ csv.Writer.fieldNeedsQuotes }
function CsvNeedsQuotes(const F: string; Comma: Char): Boolean;
var
  i: Integer;
begin
  Result := False;
  if F = '' then
    Exit;
  if F = '\.' then
  begin
    Result := True;
    Exit;
  end;
  for i := 1 to Length(F) do
    if (F[i] = Comma) or (F[i] = '"') or (F[i] = #13) or (F[i] = #10) then
    begin
      Result := True;
      Exit;
    end;
  { a leading space (unicode.IsSpace of the first rune: the ASCII ones
    and U+0085, U+00A0, the Unicode spaces from U+1680) }
  Result := IsSpaceByte(F[1]) or ((Length(F) >= 2) and (F[1] = Chr($C2)) and ((F[2] = Chr($85)) or (F[2] = Chr($A0)))) or
    ((Length(F) >= 3) and (F[1] = Chr($E1)) and (F[2] = Chr($9A)) and (F[3] = Chr($80))) or
    ((Length(F) >= 3) and (F[1] = Chr($E2)) and (F[2] = Chr($80)) and (Ord(F[3]) >= $80) and (Ord(F[3]) <= $8A)) or
    ((Length(F) >= 3) and (F[1] = Chr($E2)) and (F[2] = Chr($80)) and ((F[3] = Chr($A8)) or (F[3] = Chr($A9)) or (F[3] = Chr($AF)))) or
    ((Length(F) >= 3) and (F[1] = Chr($E2)) and (F[2] = Chr($81)) and (F[3] = Chr($9F))) or
    ((Length(F) >= 3) and (F[1] = Chr($E3)) and (F[2] = Chr($80)) and (F[3] = Chr($80)));
end;

function CsvLine(const Fields: array of string; Comma: Char; CrLf: Boolean): string;
var
  i, j: Integer;
  f: string;
begin
  Result := '';
  for i := 0 to High(Fields) do
  begin
    if i > 0 then
      Result := Result + Comma;
    f := Fields[i];
    if not CsvNeedsQuotes(f, Comma) then
      Result := Result + f
    else
    begin
      Result := Result + '"';
      for j := 1 to Length(f) do
        case f[j] of
          '"': Result := Result + '""';
          #13:
            if not CrLf then
              Result := Result + #13;
          #10:
            if CrLf then
              Result := Result + #13#10
            else
              Result := Result + #10;
        else
          Result := Result + f[j];
        end;
      Result := Result + '"';
    end;
  end;
  if CrLf then
    Result := Result + #13#10
  else
    Result := Result + #10;
end;

{ ---- the tables, scripts/codec_tables.py ---- }

const
  { Go's strings.ToUpper and ToLower of each code point to U+017F }
  UpperTab: array[0..383] of Word = (
    $0000, $0001, $0002, $0003, $0004, $0005, $0006, $0007, $0008, $0009, $000A, $000B,
    $000C, $000D, $000E, $000F, $0010, $0011, $0012, $0013, $0014, $0015, $0016, $0017,
    $0018, $0019, $001A, $001B, $001C, $001D, $001E, $001F, $0020, $0021, $0022, $0023,
