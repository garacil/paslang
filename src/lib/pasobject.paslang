{$mode objfpc}{$H+}

{ The root of every class (P121): TObject, which a class declared with
  no parent descends from, as in Object Pascal. It is a core unit: every
  program and unit links it without a uses clause, and TObject and TClass
  are words of the language.

  A class's method table carries, in the words before its first slot,
  what the class words read (the compiler writes them): at -8 the
  published properties, at -16 the parent's table (0 for TObject), at
  -24 the size of an instance in bytes, at -32 and -40 the length and the
  address of the class's name, written as a string literal is, with its
  header, so ClassName gives it back without a copy. The words
  ClassName, ClassType, ClassParent, InheritsFrom, InstanceSize and
  ClassNameIs, on an object or a class, are the compiler's: it calls the
  routines below with the table.

  Destroy, AfterConstruction, BeforeDestruction, Equals, GetHashCode and
  ToString are TObject's virtual methods, slots 0 to 5. The compiler
  calls AfterConstruction when a constructor has made an object, when
  the class overrides it (else nothing is called), and BeforeDestruction
  before Destroy when Free or an outermost Destroy ends an object. The
  memory goes back to the collector when nothing points to the object. }
unit pasobject;

interface

type
  TObject = class
    constructor Create;
    destructor Destroy; virtual;
    procedure AfterConstruction; virtual;
    procedure BeforeDestruction; virtual;
    function Equals(Obj: TObject): Boolean; virtual;
    function GetHashCode: Int64; virtual;
    function ToString: string; virtual;
  end;

function PasClassName(Vmt: Pointer): string;
function PasClassParent(Vmt: Pointer): Pointer;
function PasInheritsFrom(Vmt, Ancestor: Pointer): Boolean;
function PasInstanceSize(Vmt: Pointer): Int64;
function PasClassNameIs(Vmt: Pointer; const Name: string): Boolean;
procedure PasObjFree(Obj: TObject);

implementation

type
  { a string as it lies in memory: the address of its bytes and their
    count }
  TStrWords = record
    P: Pointer;
    N: Int64;
  end;

constructor TObject.Create;
begin
end;

destructor TObject.Destroy;
begin
end;

procedure TObject.AfterConstruction;
begin
end;

procedure TObject.BeforeDestruction;
begin
end;

{ the same object }
function TObject.Equals(Obj: TObject): Boolean;
begin
  Result := Pointer(Obj) = Pointer(Self);
end;

{ the object's address, as FPC gives it }
function TObject.GetHashCode: Int64;
begin
  Result := Int64(Pointer(Self));
end;

function TObject.ToString: string;
begin
  Result := PasClassName(PPointer(Pointer(Self))^);
end;

{ The name the table points at: a literal's bytes, shared, so a write to
  the string copies it first. }
function PasClassName(Vmt: Pointer): string;
var
  w: TStrWords;
begin
  w.P := PPointer(Int64(Vmt) - 40)^;
  w.N := PInt64(Int64(Vmt) - 32)^;
  Result := w as string;
end;

function PasClassParent(Vmt: Pointer): Pointer;
begin
  Result := PPointer(Int64(Vmt) - 16)^;
end;

{ Vmt is Ancestor's table or a descendant's: up the parents, each a
  compare. }
function PasInheritsFrom(Vmt, Ancestor: Pointer): Boolean;
var
  v: Pointer;
begin
  Result := False;
  v := Vmt;
  while v <> nil do
  begin
    if v = Ancestor then
    begin
      Result := True;
      Exit;
    end;
    v := PPointer(Int64(v) - 16)^;
  end;
end;

function PasInstanceSize(Vmt: Pointer): Int64;
begin
  Result := PInt64(Int64(Vmt) - 24)^;
end;

{ x.Free: Destroy through its slot when x is not nil, as TObject.Free
  does; the call is an outermost Destroy, so the compiler runs
  BeforeDestruction before it. The memory stays with the collector. }
procedure PasObjFree(Obj: TObject);
begin
  if Obj <> nil then
    Obj.Destroy;
end;

{ The name compared as FPC's ClassNameIs compares it: ASCII letters in
  either case. }
function PasClassNameIs(Vmt: Pointer; const Name: string): Boolean;
var
  n: string;
  i, a, b: Integer;
begin
  n := PasClassName(Vmt);
  Result := False;
  if Length(n) <> Length(Name) then
    Exit;
  for i := 1 to Length(n) do
  begin
    a := Ord(n[i]);
    b := Ord(Name[i]);
    if (a >= 97) and (a <= 122) then
      a := a - 32;
    if (b >= 97) and (b <= 122) then
      b := b - 32;
    if a <> b then
      Exit;
  end;
  Result := True;
end;

end.
