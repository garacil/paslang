{ ---- SHA-1 (FIPS 180-4, 6.1) ---- }

procedure Sha1BlocksPlain(State, Data: Pointer; N: Integer);
var
  w0, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15: UInt32;
  a, b, c, d, e: UInt32;
  j: Integer;
  p: Pointer;
begin
  for j := 0 to N - 1 do
  begin
    p := Pointer(Integer(Data) + j * 64);
    w0 := LoadBE32(p);
    w1 := LoadBE32(Pointer(Integer(p) + 4));
    w2 := LoadBE32(Pointer(Integer(p) + 8));
    w3 := LoadBE32(Pointer(Integer(p) + 12));
    w4 := LoadBE32(Pointer(Integer(p) + 16));
    w5 := LoadBE32(Pointer(Integer(p) + 20));
    w6 := LoadBE32(Pointer(Integer(p) + 24));
    w7 := LoadBE32(Pointer(Integer(p) + 28));
    w8 := LoadBE32(Pointer(Integer(p) + 32));
    w9 := LoadBE32(Pointer(Integer(p) + 36));
    w10 := LoadBE32(Pointer(Integer(p) + 40));
    w11 := LoadBE32(Pointer(Integer(p) + 44));
    w12 := LoadBE32(Pointer(Integer(p) + 48));
    w13 := LoadBE32(Pointer(Integer(p) + 52));
    w14 := LoadBE32(Pointer(Integer(p) + 56));
    w15 := LoadBE32(Pointer(Integer(p) + 60));
