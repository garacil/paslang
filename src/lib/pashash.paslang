    b := RotateLeft(b, 30);
    d := d + RotateLeft(e, 5) + ((a and b) xor ((not a) and c)) + $5a827999 + w1;
    a := RotateLeft(a, 30);
    c := c + RotateLeft(d, 5) + ((e and a) xor ((not e) and b)) + $5a827999 + w2;
    e := RotateLeft(e, 30);
    b := b + RotateLeft(c, 5) + ((d and e) xor ((not d) and a)) + $5a827999 + w3;
    d := RotateLeft(d, 30);
    a := a + RotateLeft(b, 5) + ((c and d) xor ((not c) and e)) + $5a827999 + w4;
    c := RotateLeft(c, 30);
    e := e + RotateLeft(a, 5) + ((b and c) xor ((not b) and d)) + $5a827999 + w5;
    b := RotateLeft(b, 30);
    d := d + RotateLeft(e, 5) + ((a and b) xor ((not a) and c)) + $5a827999 + w6;
    a := RotateLeft(a, 30);
    c := c + RotateLeft(d, 5) + ((e and a) xor ((not e) and b)) + $5a827999 + w7;
    e := RotateLeft(e, 30);
    b := b + RotateLeft(c, 5) + ((d and e) xor ((not d) and a)) + $5a827999 + w8;
    d := RotateLeft(d, 30);
    a := a + RotateLeft(b, 5) + ((c and d) xor ((not c) and e)) + $5a827999 + w9;
    c := RotateLeft(c, 30);
    e := e + RotateLeft(a, 5) + ((b and c) xor ((not b) and d)) + $5a827999 + w10;
    b := RotateLeft(b, 30);
    d := d + RotateLeft(e, 5) + ((a and b) xor ((not a) and c)) + $5a827999 + w11;
    a := RotateLeft(a, 30);
    c := c + RotateLeft(d, 5) + ((e and a) xor ((not e) and b)) + $5a827999 + w12;
    e := RotateLeft(e, 30);
    b := b + RotateLeft(c, 5) + ((d and e) xor ((not d) and a)) + $5a827999 + w13;
    d := RotateLeft(d, 30);
    a := a + RotateLeft(b, 5) + ((c and d) xor ((not c) and e)) + $5a827999 + w14;
    c := RotateLeft(c, 30);
    e := e + RotateLeft(a, 5) + ((b and c) xor ((not b) and d)) + $5a827999 + w15;
    b := RotateLeft(b, 30);
    w0 := RotateLeft(w13 xor w8 xor w2 xor w0, 1);
    d := d + RotateLeft(e, 5) + ((a and b) xor ((not a) and c)) + $5a827999 + w0;
    a := RotateLeft(a, 30);
    w1 := RotateLeft(w14 xor w9 xor w3 xor w1, 1);
    c := c + RotateLeft(d, 5) + ((e and a) xor ((not e) and b)) + $5a827999 + w1;
    e := RotateLeft(e, 30);
    w2 := RotateLeft(w15 xor w10 xor w4 xor w2, 1);
    b := b + RotateLeft(c, 5) + ((d and e) xor ((not d) and a)) + $5a827999 + w2;
    d := RotateLeft(d, 30);
    w3 := RotateLeft(w0 xor w11 xor w5 xor w3, 1);
    a := a + RotateLeft(b, 5) + ((c and d) xor ((not c) and e)) + $5a827999 + w3;
