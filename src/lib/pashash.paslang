{ ---- MD5 (RFC 1321) ---- }

procedure Md5Blocks(State, Data: Pointer; N: Integer);
var
  m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15: UInt32;
  a, b, c, d: UInt32;
  j: Integer;
  p: Pointer;
begin
  for j := 0 to N - 1 do
  begin
    p := Pointer(Integer(Data) + j * 64);
    m0 := LoadLE32(p);
    m1 := LoadLE32(Pointer(Integer(p) + 4));
    m2 := LoadLE32(Pointer(Integer(p) + 8));
    m3 := LoadLE32(Pointer(Integer(p) + 12));
    m4 := LoadLE32(Pointer(Integer(p) + 16));
    m5 := LoadLE32(Pointer(Integer(p) + 20));
    m6 := LoadLE32(Pointer(Integer(p) + 24));
    m7 := LoadLE32(Pointer(Integer(p) + 28));
    m8 := LoadLE32(Pointer(Integer(p) + 32));
    m9 := LoadLE32(Pointer(Integer(p) + 36));
    m10 := LoadLE32(Pointer(Integer(p) + 40));
    m11 := LoadLE32(Pointer(Integer(p) + 44));
    m12 := LoadLE32(Pointer(Integer(p) + 48));
    m13 := LoadLE32(Pointer(Integer(p) + 52));
    m14 := LoadLE32(Pointer(Integer(p) + 56));
    m15 := LoadLE32(Pointer(Integer(p) + 60));
    a := LoadLE32(State);
    b := LoadLE32(Pointer(Integer(State) + 4));
    c := LoadLE32(Pointer(Integer(State) + 8));
    d := LoadLE32(Pointer(Integer(State) + 12));
    a := b + RotateLeft(a + ((b and c) or ((not b) and d)) + $d76aa478 + m0, 7);
    d := a + RotateLeft(d + ((a and b) or ((not a) and c)) + $e8c7b756 + m1, 12);
    c := d + RotateLeft(c + ((d and a) or ((not d) and b)) + $242070db + m2, 17);
    b := c + RotateLeft(b + ((c and d) or ((not c) and a)) + $c1bdceee + m3, 22);
    a := b + RotateLeft(a + ((b and c) or ((not b) and d)) + $f57c0faf + m4, 7);
    d := a + RotateLeft(d + ((a and b) or ((not a) and c)) + $4787c62a + m5, 12);
    c := d + RotateLeft(c + ((d and a) or ((not d) and b)) + $a8304613 + m6, 17);
    b := c + RotateLeft(b + ((c and d) or ((not c) and a)) + $fd469501 + m7, 22);
    a := b + RotateLeft(a + ((b and c) or ((not b) and d)) + $698098d8 + m8, 7);
    d := a + RotateLeft(d + ((a and b) or ((not a) and c)) + $8b44f7af + m9, 12);
    c := d + RotateLeft(c + ((d and a) or ((not d) and b)) + $ffff5bb1 + m10, 17);
    b := c + RotateLeft(b + ((c and d) or ((not c) and a)) + $895cd7be + m11, 22);
    a := b + RotateLeft(a + ((b and c) or ((not b) and d)) + $6b901122 + m12, 7);
    d := a + RotateLeft(d + ((a and b) or ((not a) and c)) + $fd987193 + m13, 12);
    c := d + RotateLeft(c + ((d and a) or ((not d) and b)) + $a679438e + m14, 17);
    b := c + RotateLeft(b + ((c and d) or ((not c) and a)) + $49b40821 + m15, 22);
    a := b + RotateLeft(a + ((d and b) or ((not d) and c)) + $f61e2562 + m1, 5);
    d := a + RotateLeft(d + ((c and a) or ((not c) and b)) + $c040b340 + m6, 9);
    c := d + RotateLeft(c + ((b and d) or ((not b) and a)) + $265e5a51 + m11, 14);
    b := c + RotateLeft(b + ((a and c) or ((not a) and d)) + $e9b6c7aa + m0, 20);
    a := b + RotateLeft(a + ((d and b) or ((not d) and c)) + $d62f105d + m5, 5);
    d := a + RotateLeft(d + ((c and a) or ((not c) and b)) + $02441453 + m10, 9);
    c := d + RotateLeft(c + ((b and d) or ((not b) and a)) + $d8a1e681 + m15, 14);
    b := c + RotateLeft(b + ((a and c) or ((not a) and d)) + $e7d3fbc8 + m4, 20);
    a := b + RotateLeft(a + ((d and b) or ((not d) and c)) + $21e1cde6 + m9, 5);
    d := a + RotateLeft(d + ((c and a) or ((not c) and b)) + $c33707d6 + m14, 9);
    c := d + RotateLeft(c + ((b and d) or ((not b) and a)) + $f4d50d87 + m3, 14);
    b := c + RotateLeft(b + ((a and c) or ((not a) and d)) + $455a14ed + m8, 20);
    a := b + RotateLeft(a + ((d and b) or ((not d) and c)) + $a9e3e905 + m13, 5);
    d := a + RotateLeft(d + ((c and a) or ((not c) and b)) + $fcefa3f8 + m2, 9);
    c := d + RotateLeft(c + ((b and d) or ((not b) and a)) + $676f02d9 + m7, 14);
    b := c + RotateLeft(b + ((a and c) or ((not a) and d)) + $8d2a4c8a + m12, 20);
    a := b + RotateLeft(a + (b xor c xor d) + $fffa3942 + m5, 4);
    d := a + RotateLeft(d + (a xor b xor c) + $8771f681 + m8, 11);
    c := d + RotateLeft(c + (d xor a xor b) + $6d9d6122 + m11, 16);
    b := c + RotateLeft(b + (c xor d xor a) + $fde5380c + m14, 23);
    a := b + RotateLeft(a + (b xor c xor d) + $a4beea44 + m1, 4);
    d := a + RotateLeft(d + (a xor b xor c) + $4bdecfa9 + m4, 11);
    c := d + RotateLeft(c + (d xor a xor b) + $f6bb4b60 + m7, 16);
    b := c + RotateLeft(b + (c xor d xor a) + $bebfbc70 + m10, 23);
    a := b + RotateLeft(a + (b xor c xor d) + $289b7ec6 + m13, 4);
    d := a + RotateLeft(d + (a xor b xor c) + $eaa127fa + m0, 11);
    c := d + RotateLeft(c + (d xor a xor b) + $d4ef3085 + m3, 16);
    b := c + RotateLeft(b + (c xor d xor a) + $04881d05 + m6, 23);
    a := b + RotateLeft(a + (b xor c xor d) + $d9d4d039 + m9, 4);
    d := a + RotateLeft(d + (a xor b xor c) + $e6db99e5 + m12, 11);
    c := d + RotateLeft(c + (d xor a xor b) + $1fa27cf8 + m15, 16);
    b := c + RotateLeft(b + (c xor d xor a) + $c4ac5665 + m2, 23);
    a := b + RotateLeft(a + (c xor (b or (not d))) + $f4292244 + m0, 6);
    d := a + RotateLeft(d + (b xor (a or (not c))) + $432aff97 + m7, 10);
    c := d + RotateLeft(c + (a xor (d or (not b))) + $ab9423a7 + m14, 15);
    b := c + RotateLeft(b + (d xor (c or (not a))) + $fc93a039 + m5, 21);
    a := b + RotateLeft(a + (c xor (b or (not d))) + $655b59c3 + m12, 6);
    d := a + RotateLeft(d + (b xor (a or (not c))) + $8f0ccc92 + m3, 10);
    c := d + RotateLeft(c + (a xor (d or (not b))) + $ffeff47d + m10, 15);
    b := c + RotateLeft(b + (d xor (c or (not a))) + $85845dd1 + m1, 21);
    a := b + RotateLeft(a + (c xor (b or (not d))) + $6fa87e4f + m8, 6);
    d := a + RotateLeft(d + (b xor (a or (not c))) + $fe2ce6e0 + m15, 10);
    c := d + RotateLeft(c + (a xor (d or (not b))) + $a3014314 + m6, 15);
    b := c + RotateLeft(b + (d xor (c or (not a))) + $4e0811a1 + m13, 21);
    a := b + RotateLeft(a + (c xor (b or (not d))) + $f7537e82 + m4, 6);
    d := a + RotateLeft(d + (b xor (a or (not c))) + $bd3af235 + m11, 10);
    c := d + RotateLeft(c + (a xor (d or (not b))) + $2ad7d2bb + m2, 15);
    b := c + RotateLeft(b + (d xor (c or (not a))) + $eb86d391 + m9, 21);
    StoreLE32(State, LoadLE32(State) + a);
    StoreLE32(Pointer(Integer(State) + 4), LoadLE32(Pointer(Integer(State) + 4)) + b);
    StoreLE32(Pointer(Integer(State) + 8), LoadLE32(Pointer(Integer(State) + 8)) + c);
    StoreLE32(Pointer(Integer(State) + 12), LoadLE32(Pointer(Integer(State) + 12)) + d);
  end;
end;

function PasMd5(const S: string): string;
var
  st: array[0..3] of UInt32;
  buf: array[0..127] of Byte;
  i, n, nb: Integer;
begin
  st[0] := $67452301;
  st[1] := $efcdab89;
  st[2] := $98badcfe;
  st[3] := $10325476;
  n := Length(S) div 64;
  if n > 0 then
    Md5Blocks(@st[0], Pointer(S), n);
  Tail64(S, @buf[0], nb, True);
  Md5Blocks(@st[0], @buf[0], nb);
  SetLength(Result, 16);
  for i := 0 to 3 do
    StoreLE32(@Result[i * 4 + 1], st[i]);
end;

{ ---- SHA-3 (FIPS 202): the sponge with rate 1600 - 2 d bits and the
  01 suffix ---- }

{ Keccak-f[1600] (FIPS 202, 3.2 and 3.3): the 25 lanes in variables, each
  step written out, the 24 rounds in a loop, the round constants and
  the rotations of Table 2 in place. }
procedure KeccakF(A: Pointer);
var
  a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24: Integer;
  b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24: Integer;
  c0, c1, c2, c3, c4, d0, d1, d2, d3, d4: Integer;
  r: Integer;
begin
  a0 := LoadLE64(A);
  a1 := LoadLE64(Pointer(Integer(A) + 8));
  a2 := LoadLE64(Pointer(Integer(A) + 16));
  a3 := LoadLE64(Pointer(Integer(A) + 24));
  a4 := LoadLE64(Pointer(Integer(A) + 32));
  a5 := LoadLE64(Pointer(Integer(A) + 40));
  a6 := LoadLE64(Pointer(Integer(A) + 48));
  a7 := LoadLE64(Pointer(Integer(A) + 56));
  a8 := LoadLE64(Pointer(Integer(A) + 64));
  a9 := LoadLE64(Pointer(Integer(A) + 72));
  a10 := LoadLE64(Pointer(Integer(A) + 80));
  a11 := LoadLE64(Pointer(Integer(A) + 88));
  a12 := LoadLE64(Pointer(Integer(A) + 96));
  a13 := LoadLE64(Pointer(Integer(A) + 104));
  a14 := LoadLE64(Pointer(Integer(A) + 112));
  a15 := LoadLE64(Pointer(Integer(A) + 120));
  a16 := LoadLE64(Pointer(Integer(A) + 128));
  a17 := LoadLE64(Pointer(Integer(A) + 136));
  a18 := LoadLE64(Pointer(Integer(A) + 144));
  a19 := LoadLE64(Pointer(Integer(A) + 152));
  a20 := LoadLE64(Pointer(Integer(A) + 160));
  a21 := LoadLE64(Pointer(Integer(A) + 168));
  a22 := LoadLE64(Pointer(Integer(A) + 176));
  a23 := LoadLE64(Pointer(Integer(A) + 184));
  a24 := LoadLE64(Pointer(Integer(A) + 192));
  for r := 0 to 23 do
  begin
    c0 := a0 xor a5 xor a10 xor a15 xor a20;
    c1 := a1 xor a6 xor a11 xor a16 xor a21;
    c2 := a2 xor a7 xor a12 xor a17 xor a22;
    c3 := a3 xor a8 xor a13 xor a18 xor a23;
    c4 := a4 xor a9 xor a14 xor a19 xor a24;
    d0 := c4 xor RotateLeft(c1, 1);
    d1 := c0 xor RotateLeft(c2, 1);
    d2 := c1 xor RotateLeft(c3, 1);
    d3 := c2 xor RotateLeft(c4, 1);
    d4 := c3 xor RotateLeft(c0, 1);
    a0 := a0 xor d0;
    a1 := a1 xor d1;
    a2 := a2 xor d2;
    a3 := a3 xor d3;
    a4 := a4 xor d4;
    a5 := a5 xor d0;
    a6 := a6 xor d1;
    a7 := a7 xor d2;
    a8 := a8 xor d3;
    a9 := a9 xor d4;
    a10 := a10 xor d0;
    a11 := a11 xor d1;
    a12 := a12 xor d2;
    a13 := a13 xor d3;
    a14 := a14 xor d4;
    a15 := a15 xor d0;
    a16 := a16 xor d1;
    a17 := a17 xor d2;
    a18 := a18 xor d3;
    a19 := a19 xor d4;
    a20 := a20 xor d0;
    a21 := a21 xor d1;
    a22 := a22 xor d2;
    a23 := a23 xor d3;
    a24 := a24 xor d4;
    b0 := a0;
    b10 := RotateLeft(a1, 1);
    b20 := RotateLeft(a2, 62);
    b5 := RotateLeft(a3, 28);
    b15 := RotateLeft(a4, 27);
    b16 := RotateLeft(a5, 36);
    b1 := RotateLeft(a6, 44);
    b11 := RotateLeft(a7, 6);
    b21 := RotateLeft(a8, 55);
    b6 := RotateLeft(a9, 20);
    b7 := RotateLeft(a10, 3);
    b17 := RotateLeft(a11, 10);
    b2 := RotateLeft(a12, 43);
    b12 := RotateLeft(a13, 25);
    b22 := RotateLeft(a14, 39);
    b23 := RotateLeft(a15, 41);
    b8 := RotateLeft(a16, 45);
    b18 := RotateLeft(a17, 15);
    b3 := RotateLeft(a18, 21);
    b13 := RotateLeft(a19, 8);
    b14 := RotateLeft(a20, 18);
    b24 := RotateLeft(a21, 2);
    b9 := RotateLeft(a22, 61);
    b19 := RotateLeft(a23, 56);
    b4 := RotateLeft(a24, 14);
    a0 := b0 xor ((not b1) and b2);
    a1 := b1 xor ((not b2) and b3);
    a2 := b2 xor ((not b3) and b4);
    a3 := b3 xor ((not b4) and b0);
    a4 := b4 xor ((not b0) and b1);
    a5 := b5 xor ((not b6) and b7);
    a6 := b6 xor ((not b7) and b8);
    a7 := b7 xor ((not b8) and b9);
    a8 := b8 xor ((not b9) and b5);
    a9 := b9 xor ((not b5) and b6);
    a10 := b10 xor ((not b11) and b12);
    a11 := b11 xor ((not b12) and b13);
    a12 := b12 xor ((not b13) and b14);
    a13 := b13 xor ((not b14) and b10);
    a14 := b14 xor ((not b10) and b11);
    a15 := b15 xor ((not b16) and b17);
    a16 := b16 xor ((not b17) and b18);
    a17 := b17 xor ((not b18) and b19);
    a18 := b18 xor ((not b19) and b15);
    a19 := b19 xor ((not b15) and b16);
    a20 := b20 xor ((not b21) and b22);
    a21 := b21 xor ((not b22) and b23);
    a22 := b22 xor ((not b23) and b24);
    a23 := b23 xor ((not b24) and b20);
    a24 := b24 xor ((not b20) and b21);
    a0 := a0 xor KeccakRC[r];
  end;
  StoreLE64(A, a0);
  StoreLE64(Pointer(Integer(A) + 8), a1);
  StoreLE64(Pointer(Integer(A) + 16), a2);
  StoreLE64(Pointer(Integer(A) + 24), a3);
  StoreLE64(Pointer(Integer(A) + 32), a4);
  StoreLE64(Pointer(Integer(A) + 40), a5);
  StoreLE64(Pointer(Integer(A) + 48), a6);
  StoreLE64(Pointer(Integer(A) + 56), a7);
  StoreLE64(Pointer(Integer(A) + 64), a8);
  StoreLE64(Pointer(Integer(A) + 72), a9);
  StoreLE64(Pointer(Integer(A) + 80), a10);
  StoreLE64(Pointer(Integer(A) + 88), a11);
  StoreLE64(Pointer(Integer(A) + 96), a12);
  StoreLE64(Pointer(Integer(A) + 104), a13);
  StoreLE64(Pointer(Integer(A) + 112), a14);
  StoreLE64(Pointer(Integer(A) + 120), a15);
  StoreLE64(Pointer(Integer(A) + 128), a16);
  StoreLE64(Pointer(Integer(A) + 136), a17);
  StoreLE64(Pointer(Integer(A) + 144), a18);
  StoreLE64(Pointer(Integer(A) + 152), a19);
  StoreLE64(Pointer(Integer(A) + 160), a20);
  StoreLE64(Pointer(Integer(A) + 168), a21);
  StoreLE64(Pointer(Integer(A) + 176), a22);
  StoreLE64(Pointer(Integer(A) + 184), a23);
  StoreLE64(Pointer(Integer(A) + 192), a24);
end;

function PasSha3(const S: string; Bits: Integer): string;
var
  a: array[0..24] of Integer;
  blk: array[0..143] of Byte;
  rate, i, j, n, off, rest, lanes: Integer;
  t: Integer;
begin
  if not ((Bits = 224) or (Bits = 256) or (Bits = 384) or (Bits = 512)) then
  begin
    WriteLn(ErrOutput, 'paslang: Sha3 takes 224, 256, 384 or 512 bits');
    Halt(1);
  end;
  rate := 200 - 2 * (Bits div 8);
  lanes := rate div 8;
  for i := 0 to 24 do
    a[i] := 0;
  n := Length(S) div rate;
  for j := 0 to n - 1 do
  begin
    for i := 0 to lanes - 1 do
      a[i] := a[i] xor LoadLE64(Pointer(Integer(Pointer(S)) + j * rate + i * 8));
    KeccakF(@a[0]);
  end;
  off := n * rate;
  rest := Length(S) - off;
  for i := 0 to 143 do
    blk[i] := 0;
  for i := 0 to rest - 1 do
    blk[i] := Byte(S[off + 1 + i]);
  blk[rest] := blk[rest] xor $06;
  blk[rate - 1] := blk[rate - 1] xor $80;
  for i := 0 to lanes - 1 do
    a[i] := a[i] xor LoadLE64(@blk[i * 8]);
  KeccakF(@a[0]);
  SetLength(Result, Bits div 8);
  i := 0;
  while i < Bits div 8 do
  begin
    t := a[i div 8];
    for j := 0 to 7 do
      if i + j < Bits div 8 then
        Result[i + j + 1] := Char((t shr (8 * j)) and 255);
    i := i + 8;
  end;
end;

{ ---- CRC-32 (RFC 1952, the polynomial of Ethernet and zlib) and
  CRC-32C (RFC 3720, Castagnoli), reflected; the table of 256 entries
  built the first time a Pascal path needs it ---- }

{ Two routines building the tables at once write the same values; the
  flag is stored after them and read before them, so a routine that
  sees it sees the tables. }
procedure BuildTabs;
var
  i, j: Integer;
  c, cc: UInt32;
begin
  if AtomicLoad(TabsReady) <> 0 then
    Exit;
  for i := 0 to 255 do
  begin
    c := UInt32(i);
    cc := UInt32(i);
    for j := 0 to 7 do
    begin
      if (c and 1) <> 0 then
        c := (c shr 1) xor $edb88320
      else
        c := c shr 1;
      if (cc and 1) <> 0 then
        cc := (cc shr 1) xor $82f63b78
      else
        cc := cc shr 1;
    end;
    Crc32Tab[i] := c;
    Crc32cTab[i] := cc;
  end;
  AtomicStore(TabsReady, 1);
end;

function Crc32Plain(Crc: UInt32; P: Pointer; N: Integer; Castagnoli: Boolean): UInt32;
var
  i: Integer;
  b: Integer;
begin
  Result := Crc;
  if Castagnoli then
    for i := 0 to N - 1 do
    begin
      b := PByte(P)[i];
      Result := Crc32cTab[(Result xor b) and 255] xor (Result shr 8);
    end
  else
    for i := 0 to N - 1 do
    begin
      b := PByte(P)[i];
      Result := Crc32Tab[(Result xor b) and 255] xor (Result shr 8);
    end;
end;

{ CRC32C on the processor: SSE4.2's crc32 eight bytes a step (SDM vol.
  2A, CRC32), FEAT_CRC32's CRC32CX two words a step after Go's
  crc32_arm64.s (Arm ARM C6.2.136). }
function Crc32cCpu(Crc: UInt32; P: Pointer; N: Integer): UInt32;
var
  c: UInt32;
begin
  c := Crc;
  asm amd64 (P: in rsi; N: in rcx; c: inout rax)
    1:
    cmpq $8, %rcx
    jb 2f
    crc32q (%rsi), %rax
    addq $8, %rsi
    subq $8, %rcx
    jmp 1b
    2:
    testq %rcx, %rcx
    jz 3f
    crc32b (%rsi), %eax
    incq %rsi
    decq %rcx
    jmp 2b
    3:
  end;
  asm arm64 (P: in x1; N: in x2; c: inout x0)
    1:
    cmp x2, #16
    b.lt 2f
    ldp x8, x10, [x1], #16
    crc32cx w0, w0, x8
    crc32cx w0, w0, x10
    sub x2, x2, #16
    b 1b
    2:
    tbz x2, #3, 3f
    ldr x10, [x1], #8
    crc32cx w0, w0, x10
    3:
    tbz x2, #2, 4f
    ldr w10, [x1], #4
    crc32cw w0, w0, w10
    4:
    tbz x2, #1, 5f
    ldrh w10, [x1], #2
    crc32ch w0, w0, w10
    5:
    tbz x2, #0, 6f
    ldrb w10, [x1]
    crc32cb w0, w0, w10
    6:
  end;
  Result := c;
end;

{$ifndef CPUAARCH64}
{ Three crc32q chains at once (1.1.1), after Go's castagnoliSSE42Triple:
  crc32q takes three cycles but three of them run together, so three
  pieces of a buffer are summed in the time of one; A, B and C are the
  three CRCs, PA, PB and PC the pieces, Rounds how many 24-byte steps.
  Folding by PCLMULQDQ with Castagnoli's constants gave 18 GB/s here,
  this 33, so the fold was dropped. }
procedure Crc32cTriple(var A, B, C: UInt32; PA, PB, PC: Pointer; Rounds: Integer);
var
  ca, cb, cc: UInt32;
begin
  ca := A;
  cb := B;
  cc := C;
  asm amd64 (ca: inout rax; cb: inout rcx; cc: inout rdx; PA: in rsi; PB: in rdi; PC: in r8; Rounds: in r9)
    1:
    crc32q (%rsi), %rax
    crc32q (%rdi), %rcx
    crc32q (%r8), %rdx
    crc32q 8(%rsi), %rax
    crc32q 8(%rdi), %rcx
    crc32q 8(%r8), %rdx
    crc32q 16(%rsi), %rax
    crc32q 16(%rdi), %rcx
    crc32q 16(%r8), %rdx
    addq $24, %rsi
    addq $24, %rdi
    addq $24, %r8
    decq %r9
    jnz 1b
  end;
  A := ca;
  B := cb;
  C := cc;
end;

const
  CrcK1 = 168;
  CrcK2 = 1344;

var
  { CRC(i000, O), CRC(0i00, O), CRC(00i0, O), CRC(000i, O) for O of K
    zero bytes, K1 and K2: the CRC of a piece carried over the pieces
    after it (Go's castagnoliShift). Built at first use. }
  CrcShiftK1: array[0..3] of array[0..255] of UInt32;
  CrcShiftK2: array[0..3] of array[0..255] of UInt32;
  CrcShiftReady: Integer;

procedure BuildCrcShift;
var
  zeros: array[0..1343] of Byte;
  b, i: Integer;
begin
  if AtomicLoad(CrcShiftReady) <> 0 then
    Exit;
  for i := 0 to High(zeros) do
    zeros[i] := 0;
  for b := 0 to 3 do
    for i := 0 to 255 do
    begin
      CrcShiftK1[b][i] := Crc32cCpu(UInt32(i) shl (b * 8), @zeros[0], CrcK1);
      CrcShiftK2[b][i] := Crc32cCpu(UInt32(i) shl (b * 8), @zeros[0], CrcK2);
    end;
  AtomicStore(CrcShiftReady, 1);
end;

function CrcShift1(Crc: UInt32): UInt32;
begin
  Result := CrcShiftK1[3][Crc shr 24] xor CrcShiftK1[2][(Crc shr 16) and 255] xor
    CrcShiftK1[1][(Crc shr 8) and 255] xor CrcShiftK1[0][Crc and 255];
end;

function CrcShift2(Crc: UInt32): UInt32;
begin
  Result := CrcShiftK2[3][Crc shr 24] xor CrcShiftK2[2][(Crc shr 16) and 255] xor
    CrcShiftK2[1][(Crc shr 8) and 255] xor CrcShiftK2[0][Crc and 255];
end;

{ Go's updateCastagnoli: the buffer in three pieces of K2 (then K1)
  bytes summed together, the CRC of the first two carried over the
  bytes after them by the tables, the rest by one chain. }
function Crc32cFast(Crc: UInt32; P: Pointer; N: Integer): UInt32;
var
  a, b, c: UInt32;
  q, delta: Integer;
begin
  Result := Crc;
  q := Integer(P);
  if N >= CrcK1 * 3 then
  begin
    delta := q and 7;
    if delta <> 0 then
    begin
      delta := 8 - delta;
      Result := Crc32cCpu(Result, Pointer(q), delta);
      q := q + delta;
      N := N - delta;
    end;
    BuildCrcShift;
  end;
  while N >= CrcK2 * 3 do
  begin
    a := Result;
    b := 0;
    c := 0;
    Crc32cTriple(a, b, c, Pointer(q), Pointer(q + CrcK2), Pointer(q + 2 * CrcK2), CrcK2 div 24);
    Result := CrcShift2(CrcShift2(a) xor b) xor c;
    q := q + 3 * CrcK2;
    N := N - 3 * CrcK2;
  end;
  while N >= CrcK1 * 3 do
  begin
    a := Result;
    b := 0;
    c := 0;
    Crc32cTriple(a, b, c, Pointer(q), Pointer(q + CrcK1), Pointer(q + 2 * CrcK1), CrcK1 div 24);
    Result := CrcShift1(CrcShift1(a) xor b) xor c;
    q := q + 3 * CrcK1;
    N := N - 3 * CrcK1;
  end;
  if N > 0 then
    Result := Crc32cCpu(Result, Pointer(q), N);
end;
{$endif}

{ CRC32 on the processor: on arm64 FEAT_CRC32's CRC32X as above (Arm
  ARM C6.2.135); on amd64 the folding by PCLMULQDQ after Go's
  crc32_amd64.s ieeeCLMUL (Intel, Fast CRC Computation for Generic
  Polynomials Using PCLMULQDQ Instruction), which takes at least 64
  bytes and a whole number of 16-byte pieces: N is that, the caller
  finishes the rest. }
function Crc32Cpu(Crc: UInt32; P: Pointer; N: Integer): UInt32;
var
  c: UInt32;
begin
  c := Crc;
  asm amd64 (P: in rsi; N: in rcx; c: inout rax)
    movd %eax, %xmm0
    movdqu (%rsi), %xmm1
    movdqu 16(%rsi), %xmm2
    movdqu 32(%rsi), %xmm3
    movdqu 48(%rsi), %xmm4
    pxor %xmm0, %xmm1
    addq $64, %rsi
    subq $64, %rcx
    cmpq $64, %rcx
    jb 2f
    movabsq $0x154442bd4, %rdx
    movq %rdx, %xmm0
    movabsq $0x1c6e41596, %rdx
    pinsrq $1, %rdx, %xmm0
    1:
    movdqa %xmm1, %xmm5
    movdqa %xmm2, %xmm6
    movdqa %xmm3, %xmm7
    movdqa %xmm4, %xmm8
    pclmulqdq $0, %xmm0, %xmm1
    pclmulqdq $0, %xmm0, %xmm2
    pclmulqdq $0, %xmm0, %xmm3
    pclmulqdq $0, %xmm0, %xmm4
    movdqu (%rsi), %xmm11
    movdqu 16(%rsi), %xmm12
    movdqu 32(%rsi), %xmm13
    movdqu 48(%rsi), %xmm14
    pclmulqdq $0x11, %xmm0, %xmm5
    pclmulqdq $0x11, %xmm0, %xmm6
    pclmulqdq $0x11, %xmm0, %xmm7
    pclmulqdq $0x11, %xmm0, %xmm8
    pxor %xmm5, %xmm1
    pxor %xmm6, %xmm2
    pxor %xmm7, %xmm3
    pxor %xmm8, %xmm4
    pxor %xmm11, %xmm1
    pxor %xmm12, %xmm2
    pxor %xmm13, %xmm3
    pxor %xmm14, %xmm4
    addq $64, %rsi
    subq $64, %rcx
    cmpq $64, %rcx
    jge 1b
    2:
    movabsq $0x1751997d0, %rdx
    movq %rdx, %xmm0
    movabsq $0x0ccaa009e, %rdx
    pinsrq $1, %rdx, %xmm0
    movdqa %xmm1, %xmm5
    pclmulqdq $0, %xmm0, %xmm1
    pclmulqdq $0x11, %xmm0, %xmm5
    pxor %xmm5, %xmm1
    pxor %xmm2, %xmm1
    movdqa %xmm1, %xmm5
    pclmulqdq $0, %xmm0, %xmm1
    pclmulqdq $0x11, %xmm0, %xmm5
    pxor %xmm5, %xmm1
    pxor %xmm3, %xmm1
    movdqa %xmm1, %xmm5
    pclmulqdq $0, %xmm0, %xmm1
    pclmulqdq $0x11, %xmm0, %xmm5
    pxor %xmm5, %xmm1
    pxor %xmm4, %xmm1
    cmpq $16, %rcx
    jb 4f
    3:
    movdqu (%rsi), %xmm10
    movdqa %xmm1, %xmm5
    pclmulqdq $0, %xmm0, %xmm1
    pclmulqdq $0x11, %xmm0, %xmm5
    pxor %xmm5, %xmm1
    pxor %xmm10, %xmm1
    subq $16, %rcx
    addq $16, %rsi
    cmpq $16, %rcx
    jge 3b
    4:
    pcmpeqb %xmm3, %xmm3
    pclmulqdq $1, %xmm1, %xmm0
    psrldq $8, %xmm1
    pxor %xmm0, %xmm1
    movdqa %xmm1, %xmm2
    movabsq $0x163cd6124, %rdx
    movq %rdx, %xmm0
    psrlq $32, %xmm3
    psrldq $4, %xmm2
    pand %xmm3, %xmm1
    pclmulqdq $0, %xmm0, %xmm1
    pxor %xmm2, %xmm1
    movabsq $0x1db710641, %rdx
    movq %rdx, %xmm0
    movabsq $0x1f7011641, %rdx
    pinsrq $1, %rdx, %xmm0
    movdqa %xmm1, %xmm2
    pand %xmm3, %xmm1
    pclmulqdq $0x10, %xmm0, %xmm1
    pand %xmm3, %xmm1
    pclmulqdq $0, %xmm0, %xmm1
    pxor %xmm2, %xmm1
    pextrd $1, %xmm1, %eax
  end;
  asm arm64 (P: in x1; N: in x2; c: inout x0)
    1:
    cmp x2, #16
    b.lt 2f
    ldp x8, x10, [x1], #16
    crc32x w0, w0, x8
    crc32x w0, w0, x10
    sub x2, x2, #16
    b 1b
    2:
    tbz x2, #3, 3f
    ldr x10, [x1], #8
    crc32x w0, w0, x10
    3:
    tbz x2, #2, 4f
    ldr w10, [x1], #4
    crc32w w0, w0, w10
    4:
    tbz x2, #1, 5f
    ldrh w10, [x1], #2
    crc32h w0, w0, w10
    5:
    tbz x2, #0, 6f
    ldrb w10, [x1]
    crc32b w0, w0, w10
    6:
  end;
  Result := c;
end;

function PasCrc32Base(const S: string; Crc: Integer): Integer;
var
  c: UInt32;
begin
  BuildTabs;
  c := UInt32(Crc);
  c := not c;
  if Length(S) > 0 then
    c := Crc32Plain(c, Pointer(S), Length(S), False);
  c := not c;
  Result := c;
end;

function PasCrc32Cpu(const S: string; Crc: Integer): Integer;
var
  c: UInt32;
  n, done: Integer;
begin
  c := UInt32(Crc);
  c := not c;
  n := Length(S);
  done := 0;
  if n > 0 then
  begin
{$ifdef CPUAARCH64}
    c := Crc32Cpu(c, Pointer(S), n);
    done := n;
{$else}
    if n >= 64 then
    begin
      done := n - (n mod 16);
      c := Crc32Cpu(c, Pointer(S), done);
    end;
{$endif}
    if done < n then
    begin
      BuildTabs;
      c := Crc32Plain(c, Pointer(Integer(Pointer(S)) + done), n - done, False);
    end;
  end;
  c := not c;
  Result := c;
end;

function PasCrc32cBase(const S: string; Crc: Integer): Integer;
var
  c: UInt32;
begin
  BuildTabs;
  c := UInt32(Crc);
  c := not c;
  if Length(S) > 0 then
    c := Crc32Plain(c, Pointer(S), Length(S), True);
  c := not c;
  Result := c;
end;

function PasCrc32cCpu(const S: string; Crc: Integer): Integer;
var
  c: UInt32;
  n, done: Integer;
begin
  c := UInt32(Crc);
  c := not c;
  n := Length(S);
  done := 0;
{$ifndef CPUAARCH64}
  if n > 0 then
  begin
    c := Crc32cFast(c, Pointer(S), n);
    done := n;
  end;
{$endif}
  if done < n then
    c := Crc32cCpu(c, Pointer(Integer(Pointer(S)) + done), n - done);
  c := not c;
  Result := c;
end;

{ ---- Adler-32 (RFC 1950), in runs of 5552 bytes between reductions ---- }

function PasAdler32(const S: string; Adler: Integer): Integer;
var
  a, b: Integer;
  i, n, run: Integer;
begin
  a := Adler and $ffff;
  b := (Adler shr 16) and $ffff;
  i := 1;
  n := Length(S);
  while i <= n do
  begin
    run := n - i + 1;
    if run > 5552 then
      run := 5552;
    while run > 0 do
    begin
      a := a + Ord(S[i]);
      b := b + a;
      i := i + 1;
      run := run - 1;
    end;
    a := a mod 65521;
    b := b mod 65521;
  end;
  Result := (b shl 16) or a;
end;

{ ---- FNV-1a, 32 and 64 bits (Fowler, Noll, Vo) ---- }

function PasFnv1a32(const S: string): Integer;
var
  h: UInt32;
  i: Integer;
begin
  h := $811c9dc5;
  for i := 1 to Length(S) do
  begin
    h := h xor UInt32(Ord(S[i]));
    h := h * $01000193;
  end;
  Result := h;
end;

function PasFnv1a64(const S: string): Integer;
var
  h, i: Integer;
begin
  h := $cbf29ce484222325;
  for i := 1 to Length(S) do
  begin
    h := h xor Ord(S[i]);
    h := h * $100000001b3;
  end;
  Result := h;
end;

{ ---- MurmurHash3, the 32-bit x86 variant (Austin Appleby) ---- }

function PasMurmur3(const S: string; Seed: Integer): Integer;
var
  h, k: UInt32;
  i, n, blocks: Integer;
begin
  h := UInt32(Seed);
  n := Length(S);
  blocks := n div 4;
  for i := 0 to blocks - 1 do
  begin
    k := LoadLE32(Pointer(Integer(Pointer(S)) + i * 4));
    k := k * $cc9e2d51;
    k := RotateLeft(k, 15);
    k := k * $1b873593;
    h := h xor k;
    h := RotateLeft(h, 13);
    h := h * 5 + $e6546b64;
  end;
  k := 0;
  if (n and 3) >= 3 then
    k := k xor UInt32(Ord(S[blocks * 4 + 3]) shl 16);
  if (n and 3) >= 2 then
    k := k xor UInt32(Ord(S[blocks * 4 + 2]) shl 8);
  if (n and 3) >= 1 then
  begin
    k := k xor UInt32(Ord(S[blocks * 4 + 1]));
    k := k * $cc9e2d51;
    k := RotateLeft(k, 15);
    k := k * $1b873593;
    h := h xor k;
  end;
  h := h xor UInt32(n);
  h := h xor (h shr 16);
  h := h * $85ebca6b;
  h := h xor (h shr 13);
  h := h * $c2b2ae35;
  h := h xor (h shr 16);
  Result := h;
end;

{ ---- SipHash-2-4 (Aumasson and Bernstein), a 128-bit key in two
  words, 64 bits out, each round written out ---- }

function PasSipHash(const S: string; K0, K1: Integer): Integer;
var
  v0, v1, v2, v3, m, b: Integer;
  i, n, blocks, j: Integer;
begin
  v0 := K0 xor $736f6d6570736575;
  v1 := K1 xor $646f72616e646f6d;
  v2 := K0 xor $6c7967656e657261;
  v3 := K1 xor $7465646279746573;
  n := Length(S);
  blocks := n div 8;
  for i := 0 to blocks - 1 do
  begin
    m := LoadLE64(Pointer(Integer(Pointer(S)) + i * 8));
    v3 := v3 xor m;
    v0 := v0 + v1;
    v1 := RotateLeft(v1, 13);
    v1 := v1 xor v0;
    v0 := RotateLeft(v0, 32);
    v2 := v2 + v3;
    v3 := RotateLeft(v3, 16);
    v3 := v3 xor v2;
    v0 := v0 + v3;
    v3 := RotateLeft(v3, 21);
    v3 := v3 xor v0;
    v2 := v2 + v1;
    v1 := RotateLeft(v1, 17);
    v1 := v1 xor v2;
    v2 := RotateLeft(v2, 32);
    v0 := v0 + v1;
    v1 := RotateLeft(v1, 13);
    v1 := v1 xor v0;
    v0 := RotateLeft(v0, 32);
    v2 := v2 + v3;
    v3 := RotateLeft(v3, 16);
    v3 := v3 xor v2;
    v0 := v0 + v3;
    v3 := RotateLeft(v3, 21);
    v3 := v3 xor v0;
    v2 := v2 + v1;
    v1 := RotateLeft(v1, 17);
    v1 := v1 xor v2;
    v2 := RotateLeft(v2, 32);
    v0 := v0 xor m;
  end;
  b := n shl 56;
  for j := 0 to (n and 7) - 1 do
    b := b or (Ord(S[blocks * 8 + 1 + j]) shl (8 * j));
  v3 := v3 xor b;
    v0 := v0 + v1;
    v1 := RotateLeft(v1, 13);
    v1 := v1 xor v0;
    v0 := RotateLeft(v0, 32);
    v2 := v2 + v3;
    v3 := RotateLeft(v3, 16);
    v3 := v3 xor v2;
    v0 := v0 + v3;
    v3 := RotateLeft(v3, 21);
    v3 := v3 xor v0;
    v2 := v2 + v1;
    v1 := RotateLeft(v1, 17);
    v1 := v1 xor v2;
    v2 := RotateLeft(v2, 32);
    v0 := v0 + v1;
    v1 := RotateLeft(v1, 13);
    v1 := v1 xor v0;
    v0 := RotateLeft(v0, 32);
    v2 := v2 + v3;
    v3 := RotateLeft(v3, 16);
    v3 := v3 xor v2;
    v0 := v0 + v3;
    v3 := RotateLeft(v3, 21);
    v3 := v3 xor v0;
    v2 := v2 + v1;
    v1 := RotateLeft(v1, 17);
    v1 := v1 xor v2;
    v2 := RotateLeft(v2, 32);
  v0 := v0 xor b;
  v2 := v2 xor $ff;
    v0 := v0 + v1;
    v1 := RotateLeft(v1, 13);
    v1 := v1 xor v0;
    v0 := RotateLeft(v0, 32);
    v2 := v2 + v3;
    v3 := RotateLeft(v3, 16);
    v3 := v3 xor v2;
    v0 := v0 + v3;
    v3 := RotateLeft(v3, 21);
    v3 := v3 xor v0;
    v2 := v2 + v1;
    v1 := RotateLeft(v1, 17);
    v1 := v1 xor v2;
    v2 := RotateLeft(v2, 32);
    v0 := v0 + v1;
    v1 := RotateLeft(v1, 13);
    v1 := v1 xor v0;
    v0 := RotateLeft(v0, 32);
    v2 := v2 + v3;
    v3 := RotateLeft(v3, 16);
    v3 := v3 xor v2;
    v0 := v0 + v3;
    v3 := RotateLeft(v3, 21);
    v3 := v3 xor v0;
    v2 := v2 + v1;
    v1 := RotateLeft(v1, 17);
    v1 := v1 xor v2;
    v2 := RotateLeft(v2, 32);
    v0 := v0 + v1;
    v1 := RotateLeft(v1, 13);
    v1 := v1 xor v0;
    v0 := RotateLeft(v0, 32);
    v2 := v2 + v3;
    v3 := RotateLeft(v3, 16);
    v3 := v3 xor v2;
    v0 := v0 + v3;
    v3 := RotateLeft(v3, 21);
    v3 := v3 xor v0;
    v2 := v2 + v1;
    v1 := RotateLeft(v1, 17);
    v1 := v1 xor v2;
    v2 := RotateLeft(v2, 32);
    v0 := v0 + v1;
    v1 := RotateLeft(v1, 13);
    v1 := v1 xor v0;
    v0 := RotateLeft(v0, 32);
    v2 := v2 + v3;
    v3 := RotateLeft(v3, 16);
    v3 := v3 xor v2;
    v0 := v0 + v3;
    v3 := RotateLeft(v3, 21);
    v3 := v3 xor v0;
    v2 := v2 + v1;
    v1 := RotateLeft(v1, 17);
    v1 := v1 xor v2;
    v2 := RotateLeft(v2, 32);
  Result := v0 xor v1 xor v2 xor v3;
end;


function Sha256OfCpu(const S: string; Init: Pointer; OutWords: Integer): string;
var
  st: array[0..7] of UInt32;
  buf: array[0..127] of Byte;
  i, n, nb: Integer;
begin
  for i := 0 to 7 do
    st[i] := LoadLE32(Pointer(Integer(Init) + i * 4));
  n := Length(S) div 64;
  if n > 0 then
    Sha256BlocksCpu(@st[0], Pointer(S), n);
  Tail64(S, @buf[0], nb, False);
  Sha256BlocksCpu(@st[0], @buf[0], nb);
  SetLength(Result, OutWords * 4);
  for i := 0 to OutWords - 1 do
    StoreBE32(@Result[i * 4 + 1], st[i]);
end;

function PasSha256Cpu(const S: string): string;
begin
  Result := Sha256OfCpu(S, @H256[0], 8);
end;

function PasSha224Cpu(const S: string): string;
begin
  Result := Sha256OfCpu(S, @H224[0], 7);
end;

function PasSha1Cpu(const S: string): string;
var
  st: array[0..4] of UInt32;
  buf: array[0..127] of Byte;
  i, n, nb: Integer;
begin
  st[0] := $67452301;
  st[1] := $efcdab89;
  st[2] := $98badcfe;
  st[3] := $10325476;
  st[4] := $c3d2e1f0;
  n := Length(S) div 64;
  if n > 0 then
    Sha1BlocksCpu(@st[0], Pointer(S), n);
  Tail64(S, @buf[0], nb, False);
  Sha1BlocksCpu(@st[0], @buf[0], nb);
  SetLength(Result, 20);
  for i := 0 to 4 do
    StoreBE32(@Result[i * 4 + 1], st[i]);
end;

function Sha512OfCpu(const S: string; Init: Pointer; OutWords: Integer): string;
var
  st: array[0..7] of Integer;
  buf: array[0..255] of Byte;
  i, n, off, rest, nb: Integer;
begin
  for i := 0 to 7 do
    st[i] := LoadLE64(Pointer(Integer(Init) + i * 8));
  n := Length(S) div 128;
  if n > 0 then
    Sha512BlocksCpu(@st[0], Pointer(S), n);
  { FIPS 180-4, 5.1.2: a 1 bit, zeros, the length in 128 bits }
  off := n * 128;
  rest := Length(S) - off;
  for i := 0 to 255 do
    buf[i] := 0;
  for i := 0 to rest - 1 do
    buf[i] := Byte(S[off + 1 + i]);
  buf[rest] := 128;
  if rest < 112 then
    nb := 1
  else
    nb := 2;
  StoreBE64(@buf[nb * 128 - 8], Length(S) * 8);
  Sha512BlocksCpu(@st[0], @buf[0], nb);
  SetLength(Result, OutWords * 8);
  for i := 0 to OutWords - 1 do
    StoreBE64(@Result[i * 8 + 1], st[i]);
end;

function PasSha512Cpu(const S: string): string;
begin
  Result := Sha512OfCpu(S, @H512[0], 8);
end;

function PasSha384Cpu(const S: string): string;
begin
  Result := Sha512OfCpu(S, @H384[0], 6);
end;

function HashByCpu(Alg: Integer; const S: string): string;
begin
  case Alg of
    0: Result := PasMd5(S);
    1: Result := PasSha1Cpu(S);
    2: Result := PasSha224Cpu(S);
    3: Result := PasSha256Cpu(S);
    4: Result := PasSha384Cpu(S);
  else
    Result := PasSha512Cpu(S);
  end;
end;

{ HMAC (RFC 2104): H((K xor opad) || H((K xor ipad) || M)), the key
  hashed first when longer than the block. }
function PasHmacCpu(Alg: Integer; const Key, Msg: string): string;
var
  blk, i: Integer;
  k, ipad, opad: string;
begin
  if Alg >= 4 then
    blk := 128
  else
    blk := 64;
  k := Key;
  if Length(k) > blk then
    k := HashByCpu(Alg, k);
  SetLength(ipad, blk);
  SetLength(opad, blk);
  for i := 1 to blk do
  begin
    if i <= Length(k) then
    begin
      ipad[i] := Char(Ord(k[i]) xor $36);
      opad[i] := Char(Ord(k[i]) xor $5c);
    end
    else
    begin
      ipad[i] := Char($36);
      opad[i] := Char($5c);
    end;
  end;
  Result := HashByCpu(Alg, opad + HashByCpu(Alg, ipad + Msg));
end;

{ The Merkle tree of RFC 9162: a leaf is SHA-256 of 0x00 and the entry,
  a node SHA-256 of 0x01 and its two children, the split of n leaves at
  the greatest power of two below n. }
function MTHCpu(const Items: array of string; Lo, Hi: Integer): string;
var
  n, k: Integer;
begin
  n := Hi - Lo;
  if n = 0 then
  begin
    Result := PasSha256Cpu('');
    Exit;
  end;
  if n = 1 then
  begin
    Result := PasSha256Cpu(Char(0) + Items[Lo]);
    Exit;
  end;
  k := 1;
  while k * 2 < n do
    k := k * 2;
  Result := PasSha256Cpu(Char(1) + MTHCpu(Items, Lo, Lo + k) + MTHCpu(Items, Lo + k, Hi));
end;

function PasMerkleRootCpu(const Leaves: array of string): string;
begin
  Result := MTHCpu(Leaves, 0, Length(Leaves));
end;

function PathCpu(const Items: array of string; Index, Lo, Hi: Integer): string;
var
  n, k: Integer;
begin
  n := Hi - Lo;
  if n <= 1 then
  begin
    Result := '';
    Exit;
  end;
  k := 1;
  while k * 2 < n do
    k := k * 2;
  if Index < Lo + k then
    Result := PathCpu(Items, Index, Lo, Lo + k) + MTHCpu(Items, Lo + k, Hi)
  else
    Result := PathCpu(Items, Index, Lo + k, Hi) + MTHCpu(Items, Lo, Lo + k);
end;

function PasMerkleProofCpu(const Leaves: array of string; Index: Integer): string;
begin
  if (Index < 0) or (Index >= Length(Leaves)) then
  begin
    WriteLn(ErrOutput, 'paslang: merkle index');
    Halt(1);
  end;
  Result := PathCpu(Leaves, Index, 0, Length(Leaves));
end;

{ RFC 9162, 2.1.3.2: the proof walked from the leaf up. }
function PasMerkleCheckCpu(const Leaf: string; Index, Count: Integer;
  const Proof, Root: string): Boolean;
var
  r, p: string;
  fn, sn, i: Integer;
begin
  Result := False;
  if (Index < 0) or (Index >= Count) then
    Exit;
  if Length(Proof) mod 32 <> 0 then
    Exit;
  r := PasSha256Cpu(Char(0) + Leaf);
  fn := Index;
  sn := Count - 1;
  i := 1;
  while i + 31 <= Length(Proof) do
  begin
    if sn = 0 then
      Exit;
    p := Copy(Proof, i, 32);
    if ((fn and 1) <> 0) or (fn = sn) then
    begin
      r := PasSha256Cpu(Char(1) + p + r);
      while ((fn and 1) = 0) and (fn <> 0) do
      begin
        fn := fn shr 1;
        sn := sn shr 1;
      end;
    end
    else
      r := PasSha256Cpu(Char(1) + r + p);
    fn := fn shr 1;
    sn := sn shr 1;
    i := i + 32;
  end;
  Result := (sn = 0) and (r = Root);
end;


function Sha256OfBase(const S: string; Init: Pointer; OutWords: Integer): string;
var
  st: array[0..7] of UInt32;
  buf: array[0..127] of Byte;
  i, n, nb: Integer;
begin
  for i := 0 to 7 do
    st[i] := LoadLE32(Pointer(Integer(Init) + i * 4));
  n := Length(S) div 64;
  if n > 0 then
    Sha256BlocksPlain(@st[0], Pointer(S), n);
  Tail64(S, @buf[0], nb, False);
  Sha256BlocksPlain(@st[0], @buf[0], nb);
  SetLength(Result, OutWords * 4);
  for i := 0 to OutWords - 1 do
    StoreBE32(@Result[i * 4 + 1], st[i]);
end;

function PasSha256Base(const S: string): string;
begin
  Result := Sha256OfBase(S, @H256[0], 8);
end;

function PasSha224Base(const S: string): string;
begin
  Result := Sha256OfBase(S, @H224[0], 7);
end;

function PasSha1Base(const S: string): string;
var
  st: array[0..4] of UInt32;
  buf: array[0..127] of Byte;
  i, n, nb: Integer;
begin
  st[0] := $67452301;
  st[1] := $efcdab89;
  st[2] := $98badcfe;
  st[3] := $10325476;
  st[4] := $c3d2e1f0;
  n := Length(S) div 64;
  if n > 0 then
    Sha1BlocksPlain(@st[0], Pointer(S), n);
  Tail64(S, @buf[0], nb, False);
  Sha1BlocksPlain(@st[0], @buf[0], nb);
  SetLength(Result, 20);
  for i := 0 to 4 do
    StoreBE32(@Result[i * 4 + 1], st[i]);
end;

function Sha512OfBase(const S: string; Init: Pointer; OutWords: Integer): string;
var
  st: array[0..7] of Integer;
  buf: array[0..255] of Byte;
  i, n, off, rest, nb: Integer;
begin
  for i := 0 to 7 do
    st[i] := LoadLE64(Pointer(Integer(Init) + i * 8));
  n := Length(S) div 128;
  if n > 0 then
    Sha512BlocksPlain(@st[0], Pointer(S), n);
  { FIPS 180-4, 5.1.2: a 1 bit, zeros, the length in 128 bits }
  off := n * 128;
  rest := Length(S) - off;
  for i := 0 to 255 do
    buf[i] := 0;
  for i := 0 to rest - 1 do
    buf[i] := Byte(S[off + 1 + i]);
  buf[rest] := 128;
  if rest < 112 then
    nb := 1
  else
    nb := 2;
  StoreBE64(@buf[nb * 128 - 8], Length(S) * 8);
  Sha512BlocksPlain(@st[0], @buf[0], nb);
  SetLength(Result, OutWords * 8);
  for i := 0 to OutWords - 1 do
    StoreBE64(@Result[i * 8 + 1], st[i]);
end;

function PasSha512Base(const S: string): string;
begin
  Result := Sha512OfBase(S, @H512[0], 8);
end;

function PasSha384Base(const S: string): string;
begin
  Result := Sha512OfBase(S, @H384[0], 6);
end;

function HashByBase(Alg: Integer; const S: string): string;
begin
  case Alg of
    0: Result := PasMd5(S);
    1: Result := PasSha1Base(S);
    2: Result := PasSha224Base(S);
    3: Result := PasSha256Base(S);
    4: Result := PasSha384Base(S);
  else
    Result := PasSha512Base(S);
  end;
end;

{ HMAC (RFC 2104): H((K xor opad) || H((K xor ipad) || M)), the key
  hashed first when longer than the block. }
function PasHmacBase(Alg: Integer; const Key, Msg: string): string;
var
  blk, i: Integer;
  k, ipad, opad: string;
begin
  if Alg >= 4 then
    blk := 128
  else
    blk := 64;
  k := Key;
  if Length(k) > blk then
    k := HashByBase(Alg, k);
  SetLength(ipad, blk);
  SetLength(opad, blk);
  for i := 1 to blk do
  begin
    if i <= Length(k) then
    begin
      ipad[i] := Char(Ord(k[i]) xor $36);
      opad[i] := Char(Ord(k[i]) xor $5c);
    end
    else
    begin
      ipad[i] := Char($36);
      opad[i] := Char($5c);
    end;
  end;
  Result := HashByBase(Alg, opad + HashByBase(Alg, ipad + Msg));
end;

{ The Merkle tree of RFC 9162: a leaf is SHA-256 of 0x00 and the entry,
  a node SHA-256 of 0x01 and its two children, the split of n leaves at
  the greatest power of two below n. }
function MTHBase(const Items: array of string; Lo, Hi: Integer): string;
var
  n, k: Integer;
begin
  n := Hi - Lo;
  if n = 0 then
  begin
    Result := PasSha256Base('');
    Exit;
  end;
  if n = 1 then
  begin
    Result := PasSha256Base(Char(0) + Items[Lo]);
    Exit;
  end;
  k := 1;
  while k * 2 < n do
    k := k * 2;
  Result := PasSha256Base(Char(1) + MTHBase(Items, Lo, Lo + k) + MTHBase(Items, Lo + k, Hi));
end;

function PasMerkleRootBase(const Leaves: array of string): string;
begin
  Result := MTHBase(Leaves, 0, Length(Leaves));
end;

function PathBase(const Items: array of string; Index, Lo, Hi: Integer): string;
var
  n, k: Integer;
begin
  n := Hi - Lo;
  if n <= 1 then
  begin
    Result := '';
    Exit;
  end;
  k := 1;
  while k * 2 < n do
    k := k * 2;
  if Index < Lo + k then
    Result := PathBase(Items, Index, Lo, Lo + k) + MTHBase(Items, Lo + k, Hi)
  else
    Result := PathBase(Items, Index, Lo + k, Hi) + MTHBase(Items, Lo, Lo + k);
end;

function PasMerkleProofBase(const Leaves: array of string; Index: Integer): string;
begin
  if (Index < 0) or (Index >= Length(Leaves)) then
  begin
    WriteLn(ErrOutput, 'paslang: merkle index');
    Halt(1);
  end;
  Result := PathBase(Leaves, Index, 0, Length(Leaves));
end;

{ RFC 9162, 2.1.3.2: the proof walked from the leaf up. }
function PasMerkleCheckBase(const Leaf: string; Index, Count: Integer;
  const Proof, Root: string): Boolean;
var
  r, p: string;
  fn, sn, i: Integer;
begin
  Result := False;
  if (Index < 0) or (Index >= Count) then
    Exit;
  if Length(Proof) mod 32 <> 0 then
    Exit;
  r := PasSha256Base(Char(0) + Leaf);
  fn := Index;
  sn := Count - 1;
  i := 1;
  while i + 31 <= Length(Proof) do
  begin
    if sn = 0 then
      Exit;
    p := Copy(Proof, i, 32);
    if ((fn and 1) <> 0) or (fn = sn) then
    begin
      r := PasSha256Base(Char(1) + p + r);
      while ((fn and 1) = 0) and (fn <> 0) do
      begin
        fn := fn shr 1;
        sn := sn shr 1;
      end;
    end
    else
      r := PasSha256Base(Char(1) + r + p);
    fn := fn shr 1;
    sn := sn shr 1;
    i := i + 32;
  end;
  Result := (sn = 0) and (r = Root);
end;


end.
