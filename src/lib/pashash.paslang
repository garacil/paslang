    e := e + RotateLeft(a, 5) + (b xor c xor d) + $6ed9eba1 + w4;
    b := RotateLeft(b, 30);
    w5 := RotateLeft(w2 xor w13 xor w7 xor w5, 1);
    d := d + RotateLeft(e, 5) + (a xor b xor c) + $6ed9eba1 + w5;
    a := RotateLeft(a, 30);
    w6 := RotateLeft(w3 xor w14 xor w8 xor w6, 1);
    c := c + RotateLeft(d, 5) + (e xor a xor b) + $6ed9eba1 + w6;
    e := RotateLeft(e, 30);
    w7 := RotateLeft(w4 xor w15 xor w9 xor w7, 1);
    b := b + RotateLeft(c, 5) + (d xor e xor a) + $6ed9eba1 + w7;
    d := RotateLeft(d, 30);
    w8 := RotateLeft(w5 xor w0 xor w10 xor w8, 1);
    a := a + RotateLeft(b, 5) + (c xor d xor e) + $6ed9eba1 + w8;
    c := RotateLeft(c, 30);
    w9 := RotateLeft(w6 xor w1 xor w11 xor w9, 1);
    e := e + RotateLeft(a, 5) + (b xor c xor d) + $6ed9eba1 + w9;
    b := RotateLeft(b, 30);
    w10 := RotateLeft(w7 xor w2 xor w12 xor w10, 1);
    d := d + RotateLeft(e, 5) + (a xor b xor c) + $6ed9eba1 + w10;
    a := RotateLeft(a, 30);
    w11 := RotateLeft(w8 xor w3 xor w13 xor w11, 1);
