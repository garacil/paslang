    b := LoadLE32(Pointer(Integer(State) + 4));
    c := LoadLE32(Pointer(Integer(State) + 8));
    d := LoadLE32(Pointer(Integer(State) + 12));
    e := LoadLE32(Pointer(Integer(State) + 16));
