{ Ed25519 from the RFC 8032 formulas and the node's strict verifier.
  The double-scalar path follows Go's edwards25519/scalarmult.go.
  Go-derived portions: Copyright (c) 2016, 2017, 2019 The Go Authors.
  All rights reserved. See LICENSE-GO for the BSD terms. }
unit pased25519;

interface

type
  { Treat a prepared key as private key material. A prepared, unmodified
    value can be used by several pasroutines at once. }
  TEd25519SigningKey = record
  private
    ExpandedScalar, NoncePrefix, EncodedPublicKey: string;
  end;

const
  Ed25519SeedSize = 32;
  Ed25519PublicKeySize = 32;
  Ed25519SignatureSize = 64;
{ Apply the RFC 7748 clamp and return the fixed-base Montgomery public
  coordinate. An input of another size returns an empty string. }
function Edwards25519MontgomeryBase(const Priv: string): string;

{ Binary strings. Private input is the RFC 8032 32-byte seed, never seed||public.
  Bad lengths return empty output / False. Pure Ed25519 only, no ctx/ph. }
function Ed25519PublicKey(const Seed: string): string;
function Ed25519Sign(const Seed, Message: string): string;
{ Prepare once and use SignPrepared for multiple messages. Failure
  clears Key; signing with a default key returns an empty string. }
function Ed25519PrepareSigningKey(const Seed: string; out Key: TEd25519SigningKey): Boolean;
function Ed25519PreparedPublicKey(const Key: TEd25519SigningKey): string;
function Ed25519SignPrepared(const Key: TEd25519SigningKey; const Message: string): string;
{ Verification of public inputs uses variable-time double-scalar
  multiplication and RFC 8032 5.1.7's uncofactored equation. It requires
  S < L and canonical A and R and rejects small-order A and R. }
function Ed25519Verify(const PublicKey, Message, Signature: string): Boolean;
procedure Ed25519Keygen(out Seed, PublicKey: string);

implementation

uses sysutils, pasfield25519;

type
  TPoint = record X, Y, Z, T: TFe; end;
  TAffinePoint = record Plus, Minus, TwiceDT: TFe; end;
  TSigningRow = array[1..8] of TAffinePoint;
  TRadix16 = array[0..63] of Integer;
  TCachedPoint = record Plus, Minus, TwiceZ, TwiceDT: TFe; end;
  TNaf = array[0..255] of Int8;
  TScalar = array[0..31] of Integer;
  TScalarWords = array[0..3] of Integer;
  TScalarWideWords = array[0..7] of Integer;

const
  CurveD: TFe = (929955233495203, 466365720129213, 1662059464998953, 2033849074728123, 1442794654840575);
  SqrtM1: TFe = (1718705420411056, 234908883556509, 2233514472574048, 2117202627021982, 765476049583133);
  { L = 2^252 + 27742317777372353535851937790883648493. }
  ScalarOrder: TScalarWords = ($5812631A5CF5D3ED, $14DEF9DEA2F79CD6, 0, $1000000000000000);
  ScalarReciprocal: array[0..4] of Integer = ($ED9CE5A30A2C131B, $2106215D086329A7, $FFFFFFFFFFFFFFEB, $FFFFFFFFFFFFFFFF, $000000000000000F);
var
  basePoint: TPoint;
  baseOnce: once;
  verifyBase: array[0..63] of TCachedPoint;
  verifyOnce: once;
  signingTable: array[0..31] of TSigningRow;
  signingOnce: once;

procedure FeNeg(var V: TFe; const A: TFe);
var
  zero: TFe;
begin
  FeZero(zero);
  FeSub(V, zero, A);
end;

procedure FePow22523(var V: TFe; const X: TFe);
var
  t0, t1, t2: TFe;
begin
  FeSquare(t0, X);
  FeMul(t1, X, t0);
  FeSquare(t0, t1);
  FeSquare(t0, t0);
  FeMul(t0, t1, t0);
  FeSquare(t0, t0);
  FeMul(t0, X, t0);
  FeSquareN(t1, t0, 5);
  FeMul(t1, t1, t0);
  FeSquareN(t2, t1, 5);
  FeMul(t0, t2, t0);
  FeSquareN(t2, t0, 15);
  FeMul(t2, t2, t0);
  FeSquareN(t0, t2, 30);
  FeMul(t0, t0, t2);
  FeSquareN(t2, t0, 60);
  FeMul(t2, t2, t0);
  FeSquareN(t0, t2, 120);
  FeMul(t0, t0, t2);
  FeSquareN(t0, t0, 10);
  FeMul(t0, t0, t1);
  FeSquareN(t0, t0, 2);
  FeMul(V, t0, X);
end;

procedure PointIdentity(var P: TPoint);
begin
  FeZero(P.X);
  FeOne(P.Y);
  FeOne(P.Z);
  FeZero(P.T);
end;

procedure PointAdd(var V: TPoint; const P, Q: TPoint);
var
  a, b, c, d, e, f, g, h, t, u: TFe;
begin
  FeSub(t, P.Y, P.X);
  FeSub(u, Q.Y, Q.X);
  FeMul(a, t, u);
  FeAdd(t, P.Y, P.X);
  FeAdd(u, Q.Y, Q.X);
  FeMul(b, t, u);
  FeMul(t, P.T, Q.T);
  FeMul(c, t, CurveD);
  FeAdd(c, c, c);
  FeMul(d, P.Z, Q.Z);
  FeAdd(d, d, d);
  FeSub(e, b, a);
  FeSub(f, d, c);
  FeAdd(g, d, c);
  FeAdd(h, b, a);
  FeMul(V.X, e, f);
  FeMul(V.Y, g, h);
  FeMul(V.T, e, h);
  FeMul(V.Z, f, g);
end;

procedure PointDouble(var V: TPoint; const P: TPoint; NeedT: Boolean = True);
var
  a, b, c, e, f, g, h, t: TFe;
begin
  FeSquare(a, P.X);
  FeSquare(b, P.Y);
  FeSquare(c, P.Z);
  FeAdd(c, c, c);
  FeAdd(h, a, b);
  FeAdd(t, P.X, P.Y);
  FeSquare(t, t);
  FeSub(e, h, t);
  FeSub(g, a, b);
  FeAdd(f, c, g);
  FeMul(V.X, e, f);
  FeMul(V.Y, g, h);
  if NeedT then FeMul(V.T, e, h);
  FeMul(V.Z, f, g);
end;

function PointBytes(const P: TPoint): string;
var
  inv, x, y: TFe;
  xb: string;
begin
  FeInvert(inv, P.Z);
  FeMul(x, P.X, inv);
  FeMul(y, P.Y, inv);
  Result := FeBytes(y);
  xb := FeBytes(x);
  Result[32] := Chr(Ord(Result[32]) or ((Ord(xb[1]) and 1) shl 7));
end;

function PointDecode(const Encoded: string; out P: TPoint): Boolean;
var
  y2, u, v, v2, v3, v7, x, check, negative, one: TFe;
  ys, xs: string;
  sign: Integer;
begin
  Result := False;
  if Length(Encoded) <> 32 then
    Exit;
  ys := Encoded;
  sign := Ord(ys[32]) shr 7;
  ys[32] := Chr(Ord(ys[32]) and 127);
  FeSetBytes(P.Y, @ys[1]);
  if FeBytes(P.Y) <> ys then Exit;
  { RFC 8032 5.1.3: y < p. }
  FeOne(one);
  FeSquare(y2, P.Y);
  FeSub(u, y2, one);
  FeMul(v, y2, CurveD);
  FeAdd(v, v, one);
  FeSquare(v2, v);
  FeMul(v3, v2, v);
  FeMul(v3, u, v3);
  FeSquare(v7, v2);
  FeMul(v7, v3, v7);
  FePow22523(x, v7);
  FeMul(x, v3, x);
  FeSquare(check, x);
  FeMul(check, v, check);
  if FeBytes(check) <> FeBytes(u) then
  begin
    FeNeg(negative, u);
    if FeBytes(check) <> FeBytes(negative) then
      Exit;
    FeMul(x, x, SqrtM1);
  end;
  xs := FeBytes(x);
  if (xs = StringOfChar(#0, 32)) and (sign = 1) then
    Exit;
  if (Ord(xs[1]) and 1) <> sign then
    FeNeg(x, x);
  P.X := x;
  FeOne(P.Z);
  FeMul(P.T, P.X, P.Y);
  Result := True;
end;

procedure EnsureBase;
var
  encoded: string;
begin
  once baseOnce do
  begin
    encoded := #88 + StringOfChar(#102, 31);
    if not PointDecode(encoded, basePoint) then
      raise Exception.Create('Ed25519 base point');
  end;
end;

{ Go's edwards25519/scalarmult.go precomputes eight multiples of
  [256^row]B. Every entry and every operation here is public. }
procedure BuildSigningTable;
var
  rowBase: TPoint;
  points: array[1..8] of TPoint;
  prefixes: array[0..8] of TFe;
  inverse, inverseZ, x, y, xy: TFe;
  row, column, i: Integer;
begin
  EnsureBase;
  rowBase := basePoint;
  FeOne(prefixes[0]);
  for row := 0 to High(signingTable) do
  begin
    points[1] := rowBase;
    for column := 2 to High(points) do
      PointAdd(points[column], points[column - 1], rowBase);
    for column := 1 to High(points) do
      FeMul(prefixes[column], prefixes[column - 1], points[column].Z);

    { Invert the product once, then recover each individual inverse. }
    FeInvert(inverse, prefixes[High(points)]);
    for column := High(points) downto 1 do
    begin
      FeMul(inverseZ, inverse, prefixes[column - 1]);
      FeMul(inverse, inverse, points[column].Z);
      FeMul(x, points[column].X, inverseZ);
      FeMul(y, points[column].Y, inverseZ);
      FeAdd(signingTable[row, column].Plus, y, x);
      FeSub(signingTable[row, column].Minus, y, x);
      FeMul(xy, points[column].T, inverseZ);
      FeMul(xy, xy, CurveD);
      FeAdd(signingTable[row, column].TwiceDT, xy, xy);
    end;
    for i := 1 to 8 do
      PointDouble(rowBase, rowBase);
  end;
end;

{ Select a signed digit in [-8, 8] by touching all eight entries.
  Negation swaps Y+X and Y-X and changes the sign of 2dXY. }
procedure SelectSigningPoint(out Selected: TAffinePoint; const Row: TSigningRow; Digit: Integer);
var
  negative, magnitude, mask, t, i, j: Integer;
  negatedDT: TFe;
begin
  negative := 0 - (Digit shr 63);
  magnitude := (Digit xor negative) - negative;
  FeOne(Selected.Plus);
  FeOne(Selected.Minus);
  FeZero(Selected.TwiceDT);
  for j := 1 to 8 do
  begin
    mask := 0 - (((j xor magnitude) - 1) shr 63);
    for i := 0 to 4 do
    begin
      Selected.Plus[i] := Selected.Plus[i] xor (mask and (Selected.Plus[i] xor Row[j].Plus[i]));
      Selected.Minus[i] := Selected.Minus[i] xor (mask and (Selected.Minus[i] xor Row[j].Minus[i]));
      Selected.TwiceDT[i] := Selected.TwiceDT[i] xor (mask and (Selected.TwiceDT[i] xor Row[j].TwiceDT[i]));
    end;
  end;
  FeNeg(negatedDT, Selected.TwiceDT);
  for i := 0 to 4 do
  begin
    t := negative and (Selected.Plus[i] xor Selected.Minus[i]);
    Selected.Plus[i] := Selected.Plus[i] xor t;
    Selected.Minus[i] := Selected.Minus[i] xor t;
    Selected.TwiceDT[i] := Selected.TwiceDT[i] xor (negative and (Selected.TwiceDT[i] xor negatedDT[i]));
  end;
end;

procedure PointAddAffine(var V: TPoint; const P: TPoint; const Q: TAffinePoint);
var
  a, b, c, d, e, f, g, h: TFe;
begin
  FeSub(a, P.Y, P.X);
  FeAdd(b, P.Y, P.X);
  FeMul(a, a, Q.Minus);
  FeMul(b, b, Q.Plus);
  FeMul(c, P.T, Q.TwiceDT);
  FeAdd(d, P.Z, P.Z);
  FeSub(e, b, a);
  FeSub(f, d, c);
  FeAdd(g, d, c);
  FeAdd(h, b, a);
  FeMul(V.X, e, f);
  FeMul(V.Y, g, h);
  FeMul(V.T, e, h);
  FeMul(V.Z, f, g);
end;

{ Accumulate the odd radix-16 digits, multiply the sum by 16 in
  four doublings, then accumulate the even digits. Same fixed work
  for every scalar, including the correction to signed digits. }
procedure PointMultiplyBase(var V: TPoint; const S: TScalar);
var
  digits: TRadix16;
  selected: TAffinePoint;
  i, digit, digitCarry: Integer;
begin
  once signingOnce do
    BuildSigningTable;
  digitCarry := 0;
  for i := 0 to 62 do
  begin
    digit := ((S[i shr 1] shr ((i and 1) * 4)) and 15) + digitCarry;
    digitCarry := (digit + 8) shr 4;
    digits[i] := digit - 16 * digitCarry;
  end;
  digits[63] := (S[31] shr 4) + digitCarry;

  PointIdentity(V);
  for i := 0 to 31 do
  begin
    SelectSigningPoint(selected, signingTable[i], digits[2 * i + 1]);
    PointAddAffine(V, V, selected);
  end;
  for i := 1 to 4 do
    PointDouble(V, V);
  for i := 0 to 31 do
  begin
    SelectSigningPoint(selected, signingTable[i], digits[2 * i]);
    PointAddAffine(V, V, selected);
  end;
  FillChar(digits, SizeOf(digits), 0);
end;

{ The odd multiples for Straus verification. As in Go's
  edwards25519/scalarmult.go, cache the additions by public digits. }
procedure CacheOddMultiples(Table: array of TCachedPoint; const P: TPoint);
var
  doublePoint, current: TPoint;
  i: Integer;
begin
  PointDouble(doublePoint, P);
  current := P;
  for i := 0 to High(Table) do
  begin
    FeAdd(Table[i].Plus, current.Y, current.X);
    FeSub(Table[i].Minus, current.Y, current.X);
    FeAdd(Table[i].TwiceZ, current.Z, current.Z);
    FeMul(Table[i].TwiceDT, current.T, CurveD);
    FeAdd(Table[i].TwiceDT, Table[i].TwiceDT, Table[i].TwiceDT);
    if i < High(Table) then
      PointAdd(current, current, doublePoint);
  end;
end;

procedure PointAddDigit(var V: TPoint; const P: TPoint;
                        const Table: array of TCachedPoint;
                        Digit: Integer);
var
  a, b, c, d, e, f, g, h, minus, plus: TFe;
  i: Integer;
begin
  i := (Abs(Digit) - 1) shr 1;
  FeSub(minus, P.Y, P.X);
  FeAdd(plus, P.Y, P.X);
  FeMul(c, P.T, Table[i].TwiceDT);
  if Digit < 0 then
  begin
    FeMul(a, minus, Table[i].Plus);
    FeMul(b, plus, Table[i].Minus);
    FeNeg(c, c);
  end
  else
  begin
    FeMul(a, minus, Table[i].Minus);
    FeMul(b, plus, Table[i].Plus);
  end;
  FeMul(d, P.Z, Table[i].TwiceZ);
  FeSub(e, b, a);
  FeSub(f, d, c);
  FeAdd(g, d, c);
  FeAdd(h, b, a);
  FeMul(V.X, e, f);
  FeMul(V.Y, g, h);
  FeMul(V.T, e, h);
  FeMul(V.Z, f, g);
end;

{ Go's edwards25519/scalar.go nonAdjacentForm, with byte windows.
  Fixed-width signed digits are sparse. Both scalars here are public. }
procedure PublicNaf(const Scalar: TScalar; Width: Integer; out Digits: TNaf);
var
  bitIndex, octet, window, limit, digitCarry: Integer;
begin
  FillChar(Digits, SizeOf(Digits), 0);
  bitIndex := 0;
  digitCarry := 0;
  limit := 1 shl Width;
  while bitIndex < 256 do
  begin
    octet := bitIndex shr 3;
    window := Scalar[octet];
    if octet < 31 then
      window := window or (Scalar[octet + 1] shl 8);
    window := ((window shr (bitIndex and 7)) and (limit - 1)) + digitCarry;
    if (window and 1) = 0 then
      Inc(bitIndex)
    else
    begin
      digitCarry := 0;
      if window >= limit div 2 then
      begin
        window := window - limit;
        digitCarry := 1;
      end;
      Digits[bitIndex] := Int8(window);
      Inc(bitIndex, Width);
    end;
  end;
end;

{ [S]B - [K]A, a single doubling for each bit of either public scalar.
  The higher width for B amortizes its table across calls. Signing
  uses PointMultiplyBase with its fixed sequence and scans. }
procedure VerifyMultiply(var V: TPoint; const A: TPoint; const S, K: TScalar);
var
  table: array[0..7] of TCachedPoint;
  aDigits, bDigits: TNaf;
  bitIndex: Integer;
begin
  once verifyOnce do
  begin
    EnsureBase;
    CacheOddMultiples(verifyBase, basePoint);
  end;
  CacheOddMultiples(table, A);
  PublicNaf(K, 5, aDigits);
  PublicNaf(S, 8, bDigits);
  PointIdentity(V);
  bitIndex := High(bDigits);
  while (bitIndex >= 0) and (aDigits[bitIndex] = 0) and (bDigits[bitIndex] = 0) do
    Dec(bitIndex);
  while bitIndex >= 0 do
  begin
    { The next doubling and the final comparison use only X, Y and Z.
      As in Go's VarTimeDoubleScalarBaseMult, compute T for additions. }
    PointDouble(V, V, (aDigits[bitIndex] <> 0) or (bDigits[bitIndex] <> 0));
    if aDigits[bitIndex] <> 0 then
      PointAddDigit(V, V, table, -Integer(aDigits[bitIndex]));
    if bDigits[bitIndex] <> 0 then
      PointAddDigit(V, V, verifyBase, bDigits[bitIndex]);
    Dec(bitIndex);
  end;
end;

function PointSmallOrder(const P: TPoint): Boolean;
var
  q: TPoint;
  yMinusZ: TFe;
  i, difference: Integer;
begin
  q := P;
  for i := 1 to 3 do
    PointDouble(q, q);
  { In projective coordinates the identity is X = 0 and Y = Z. }
  FeSub(yMinusZ, q.Y, q.Z);
  FeReduce(q.X);
  FeReduce(yMinusZ);
  difference := 0;
  for i := 0 to 4 do
    difference := difference or q.X[i] or yMinusZ[i];
  Result := difference = 0;
end;

{ Little-endian word product, truncated to the output width.
  The column carry is at most one word, since each accumulation
  is bounded by (2^64-1)^2 + 2*(2^64-1). }
procedure ScalarWordProduct(const A, B: array of Integer; Product: array of Integer);
var
  i, j, rowCarry, hi, lo, carryWord: Integer;
begin
  for i := 0 to High(Product) do
    Product[i] := 0;
  for i := 0 to High(A) do
  begin
    rowCarry := 0;
    for j := 0 to High(B) do
    begin
      if i+j > High(Product) then Break;
      Mul128(A[i], B[j], hi, lo);
      lo := AddCarry(lo, Product[i+j], 0, carryWord);
      hi := hi + carryWord;
      Product[i+j] := AddCarry(lo, rowCarry, 0, carryWord);
      rowCarry := hi + carryWord;
    end;
    if i+Length(B) <= High(Product) then
      Product[i+Length(B)] := rowCarry;
  end;
end;

{ Barrett reduction with mu = floor(2^512 / L). For x < 2^512,
  q = floor(x*mu/2^512) is at most one below floor(x/L). Thus
  x - q*L is nonnegative and less than 2L, so its low 256 bits
  suffice. The final subtraction uses a mask. }
procedure ScalarReduce(const Words: TScalarWideWords; out S: TScalar);
var
  approximation: array[0..12] of Integer;
  quotient, product, remainder, reduced: TScalarWords;
  i, borrow, mask: Integer;
begin
  ScalarWordProduct(Words, ScalarReciprocal, approximation);
  for i := 0 to 3 do
    quotient[i] := approximation[8+i];
  ScalarWordProduct(quotient, ScalarOrder, product);
  borrow := 0;
  for i := 0 to 3 do
    remainder[i] := SubBorrow(Words[i], product[i], borrow, borrow);
  borrow := 0;
  for i := 0 to 3 do
    reduced[i] := SubBorrow(remainder[i], ScalarOrder[i], borrow, borrow);
  mask := borrow - 1;
  for i := 0 to 3 do
    remainder[i] := remainder[i] xor (mask and (remainder[i] xor reduced[i]));
  for i := 0 to 31 do
    S[i] := (remainder[i shr 3] shr ((i and 7) * 8)) and 255;
  FillChar(approximation, SizeOf(approximation), 0);
  FillChar(quotient, SizeOf(quotient), 0);
  FillChar(product, SizeOf(product), 0);
  FillChar(remainder, SizeOf(remainder), 0);
  FillChar(reduced, SizeOf(reduced), 0);
end;

procedure ScalarFromBytes(const Text: string; out S: TScalar);
var
  words: TScalarWideWords;
  i, wordIndex: Integer;
begin
  FillChar(words, SizeOf(words), 0);
  for i := 1 to Length(Text) do
  begin
    wordIndex := (i - 1) shr 3;
    words[wordIndex] := words[wordIndex] or (Ord(Text[i]) shl (((i - 1) and 7) * 8));
  end;
  ScalarReduce(words, S);
  FillChar(words, SizeOf(words), 0);
end;

function ScalarBytes(const S: TScalar): string;
var
  i: Integer;
begin
  SetLength(Result, 32);
  for i := 0 to 31 do
    Result[i + 1] := Chr(S[i]);
end;

procedure ScalarMultiplyAdd(const A, B, C: TScalar; out S: TScalar);
var
  aWords, bWords, cWords: TScalarWords;
  product: TScalarWideWords;
  i, bitOffset, wordIndex, carryWord: Integer;
begin
  FillChar(aWords, SizeOf(aWords), 0);
  FillChar(bWords, SizeOf(bWords), 0);
  FillChar(cWords, SizeOf(cWords), 0);
  for i := 0 to 31 do
  begin
    wordIndex := i shr 3;
    bitOffset := (i and 7) * 8;
    aWords[wordIndex] := aWords[wordIndex] or (A[i] shl bitOffset);
    bWords[wordIndex] := bWords[wordIndex] or (B[i] shl bitOffset);
    cWords[wordIndex] := cWords[wordIndex] or (C[i] shl bitOffset);
  end;
  ScalarWordProduct(aWords, bWords, product);
  carryWord := 0;
  for i := 0 to 3 do
    product[i] := AddCarry(product[i], cWords[i], carryWord, carryWord);
  for i := 4 to 7 do
    product[i] := AddCarry(product[i], 0, carryWord, carryWord);
  ScalarReduce(product, S);
  FillChar(aWords, SizeOf(aWords), 0);
  FillChar(bWords, SizeOf(bWords), 0);
  FillChar(cWords, SizeOf(cWords), 0);
  FillChar(product, SizeOf(product), 0);
end;

function SeedScalar(const Seed: string; out S: TScalar): string;
var
  h, clamped: string;
begin
  h := Sha512(Seed);
  clamped := Copy(h, 1, 32);
  clamped[1] := Chr(Ord(clamped[1]) and 248);
  clamped[32] := Chr((Ord(clamped[32]) and 63) or 64);
  ScalarFromBytes(clamped, S);
  Result := Copy(h, 33, 32);
end;

function ExpandAndDerive(const Seed: string; out Scalar: TScalar; out Prefix: string): string;
var
  point: TPoint;
begin
  Prefix := SeedScalar(Seed, Scalar);
  PointMultiplyBase(point, Scalar);
  Result := PointBytes(point);
end;

{ RFC 7748 4.1 and ring's x25519_public_from_private_generic_masked:
  use the fixed-base Edwards table, then recover u = (Z + Y) / (Z - Y). }
function Edwards25519MontgomeryBase(const Priv: string): string;
var
  scalar: TScalar;
  point: TPoint;
  zPlusY, zMinusY: TFe;
  i: Integer;
{$ifdef CPUAARCH64}
  ditPrevious: Boolean;
{$endif}
begin
  Result := '';
  if Length(Priv) <> 32 then Exit;
{$ifdef CPUAARCH64}
  ditPrevious := PasDitEnter;
  try
{$endif}
  for i := 0 to 31 do scalar[i] := Ord(Priv[i + 1]);
  scalar[0] := scalar[0] and 248;
  scalar[31] := (scalar[31] and 127) or 64;
  PointMultiplyBase(point, scalar);
  FillChar(scalar, SizeOf(scalar), 0);
  FeAdd(zPlusY, point.Z, point.Y);
  FeSub(zMinusY, point.Z, point.Y);
  FeInvert(zMinusY, zMinusY);
  FeMul(zPlusY, zPlusY, zMinusY);
  Result := FeBytes(zPlusY);
{$ifdef CPUAARCH64}
  finally
    PasDitLeave(ditPrevious);
  end;
{$endif}
end;

function Ed25519PublicKey(const Seed: string): string;
var
  s: TScalar;
  prefix: string;
{$ifdef CPUAARCH64}
  ditPrevious: Boolean;
{$endif}
begin
{$ifdef CPUAARCH64}
  ditPrevious := PasDitEnter;
  try
{$endif}
  Result := '';
  if Length(Seed) <> Ed25519SeedSize then Exit;
  Result := ExpandAndDerive(Seed, s, prefix);
  FillChar(s, SizeOf(s), 0);
{$ifdef CPUAARCH64}
  finally
    PasDitLeave(ditPrevious);
  end;
{$endif}
end;

procedure PrepareSigningKey(const Seed: string; out Key: TEd25519SigningKey);
var
  scalar: TScalar;
begin
  Key.EncodedPublicKey := ExpandAndDerive(Seed, scalar, Key.NoncePrefix);
  Key.ExpandedScalar := ScalarBytes(scalar);
  FillChar(scalar, SizeOf(scalar), 0);
end;

function Ed25519PrepareSigningKey(const Seed: string; out Key: TEd25519SigningKey): Boolean;
var
  prepared: TEd25519SigningKey;
{$ifdef CPUAARCH64}
  ditPrevious: Boolean;
{$endif}
begin
  Key.ExpandedScalar := '';
  Key.NoncePrefix := '';
  Key.EncodedPublicKey := '';
  Result := Length(Seed) = Ed25519SeedSize;
  if not Result then
    Exit;
{$ifdef CPUAARCH64}
  ditPrevious := PasDitEnter;
  try
{$endif}
  PrepareSigningKey(Seed, prepared);
  Key := prepared;
{$ifdef CPUAARCH64}
  finally
    PasDitLeave(ditPrevious);
  end;
{$endif}
end;

function Ed25519PreparedPublicKey(const Key: TEd25519SigningKey): string;
begin
  Result := Key.EncodedPublicKey;
end;

function SignExpanded(const Scalar: TScalar;
                      const Prefix, PublicKey, Message: string): string;
var
  r, k, sum: TScalar;
  point: TPoint;
  encoded: string;
begin
  ScalarFromBytes(Sha512(Prefix + Message), r);
  PointMultiplyBase(point, r);
  encoded := PointBytes(point);
  ScalarFromBytes(Sha512(encoded + PublicKey + Message), k);
  ScalarMultiplyAdd(k, Scalar, r, sum);
  Result := encoded + ScalarBytes(sum);
  FillChar(r, SizeOf(r), 0);
  FillChar(k, SizeOf(k), 0);
  FillChar(sum, SizeOf(sum), 0);
end;

function Ed25519SignPrepared(const Key: TEd25519SigningKey; const Message: string): string;
var
  scalar: TScalar;
  i: Integer;
{$ifdef CPUAARCH64}
  ditPrevious: Boolean;
{$endif}
begin
  Result := '';
  if Key.EncodedPublicKey = '' then
    Exit;
{$ifdef CPUAARCH64}
  ditPrevious := PasDitEnter;
  try
{$endif}
  for i := 0 to 31 do
    scalar[i] := Ord(Key.ExpandedScalar[i + 1]);
  Result := SignExpanded(scalar, Key.NoncePrefix, Key.EncodedPublicKey, Message);
  FillChar(scalar, SizeOf(scalar), 0);
{$ifdef CPUAARCH64}
  finally
    PasDitLeave(ditPrevious);
  end;
{$endif}
end;

function Ed25519Sign(const Seed, Message: string): string;
var
  scalar: TScalar;
  prefix, publicKey: string;
{$ifdef CPUAARCH64}
  ditPrevious: Boolean;
{$endif}
begin
  Result := '';
  if Length(Seed) <> Ed25519SeedSize then
    Exit;
{$ifdef CPUAARCH64}
  ditPrevious := PasDitEnter;
  try
{$endif}
  publicKey := ExpandAndDerive(Seed, scalar, prefix);
  Result := SignExpanded(scalar, prefix, publicKey, Message);
  FillChar(scalar, SizeOf(scalar), 0);
{$ifdef CPUAARCH64}
  finally
    PasDitLeave(ditPrevious);
  end;
{$endif}
end;

function Ed25519Verify(const PublicKey, Message, Signature: string): Boolean;
var
  a, r, product: TPoint;
  s, k: TScalar;
  encodedR: string;
  i, wordValue: Integer;
begin
  Result := False;
  if (Length(PublicKey) <> Ed25519PublicKeySize) or (Length(Signature) <> Ed25519SignatureSize) then
    Exit;
  for i := 0 to 31 do
    s[i] := Ord(Signature[33 + i]);
  { Compare the public little-endian S with L as unsigned words. }
  i := High(ScalarOrder);
  wordValue := LoadLE64(@Signature[33 + 8 * i]);
  while wordValue = ScalarOrder[i] do
  begin
    if i = 0 then
      Exit;
    Dec(i);
    wordValue := LoadLE64(@Signature[33 + 8 * i]);
  end;
  if (wordValue xor Low(Int64)) > (ScalarOrder[i] xor Low(Int64)) then
    Exit;
  encodedR := Copy(Signature, 1, 32);
  if not PointDecode(PublicKey, a) then
    Exit;
  if not PointDecode(encodedR, r) then
    Exit;
  if PointSmallOrder(a) or PointSmallOrder(r) then
    Exit;
  ScalarFromBytes(Sha512(encodedR + PublicKey + Message), k);
  VerifyMultiply(product, a, s, k);
  { Compare the uncofactored equation in projective coordinates, as
    Go's edwards25519.Point.Equal does. The decoded R has Z = 1, so
    multiplying its affine coordinates by the computed Z suffices. }
  FeMul(r.X, r.X, product.Z);
  FeMul(r.Y, r.Y, product.Z);
  Result := (FeBytes(r.X) = FeBytes(product.X)) and
            (FeBytes(r.Y) = FeBytes(product.Y));
end;

procedure Ed25519Keygen(out Seed, PublicKey: string);
begin
  Seed := StringOf(RandomBytes(Ed25519SeedSize));
  PublicKey := Ed25519PublicKey(Seed);
end;
end.
