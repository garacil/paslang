{ Modular arithmetic on big natural numbers and RSA signature
  verification, in pure paslang (P429).

  The first half follows Go 1.27.3's crypto/internal/fips140/bigmod
  (nat.go) routine by routine: a TNat is a natural number of 64-bit
  limbs, little-endian, whose announced length (the number of limbs) is
  public and whose value is not; a TModulus holds an odd or even
  modulus with the constants of Montgomery multiplication (m0inv, the
  inverse of -m mod 2^64, and rr, R*R mod m). Everything that may see a
  secret value runs in a time that depends on announced lengths alone,
  as Go's: no branch and no memory index on a limb's value (Add, Sub,
  Mul, Mod, Exp, Equal, the Montgomery product). The routines Go names
  VarTime leak what their names say (ExpShortVarTime the exponent,
  BitLenVarTime the bit length).

  The second half is RSA's public operation and the two signature
  schemes, as Go's crypto/internal/fips140/rsa (rsa.go checkPublicKey
  and encrypt, pkcs1v15.go verifyPKCS1v15, pkcs1v22.go verifyPSS and
  emsaPSSVerify) and the key size check of crypto/rsa (rsa.go
  checkKeySize: 1024 bits at least): RFC 8017 5.2.2 (RSAVP1), 8.1.2
  (RSASSA-PSS-VERIFY), 8.2.2 (RSASSA-PKCS1-V1_5-VERIFY), 9.1.2
  (EMSA-PSS-VERIFY), 9.2 (EMSA-PKCS1-v1_5) and B.2.1 (MGF1).
  Verification works on public data only, so it may take variable
  time, as Go's does. A modulus, a signature and a digest are strings
  of bytes; integers are big-endian.

  The third part is the private key and its signatures (P616), as the
  same Go package at commit f043823 (rsa.go NewPrivateKey,
  NewPrivateKeyWithPrecomputation, checkPrivateKey and decrypt;
  pkcs1v15.go signPKCS1v15; pkcs1v22.go SignPSS and emsaPSSEncode) and
  crypto/rsa (fips.go SignPKCS1v15 and SignPSS, the salt lengths): RFC
  8017 5.2.1 (RSASP1), 8.1.1 (RSASSA-PSS-SIGN), 8.2.1
  (RSASSA-PKCS1-V1_5-SIGN) and 9.1.1 (EMSA-PSS-ENCODE). The private
  operation is the Chinese remainder form on the constant-time
  routines of the first half, so its time depends on the key's
  announced lengths alone, and its result is raised to e and compared
  with what was signed before it leaves: a fault in one half would
  otherwise give the factors away. There is no blinding, as there is
  none in Go's: blinding hides a variable-time exponentiation, and
  this one is not variable. Keys of more than two primes, which Go
  keeps only as deprecated, are not taken. }
unit pasrsa;

interface

const
  { the hashes of a signature. RsaHashNone signs the digest as given,
    with no DigestInfo (Go's crypto.Hash(0), TLS 1.0's MD5+SHA1);
    PKCS #1 v1.5 only }
  RsaHashNone = 0;
  RsaSha1 = 1;
  RsaSha224 = 2;
  RsaSha256 = 3;
  RsaSha384 = 4;
  RsaSha512 = 5;
  RsaSha3_224 = 6;
  RsaSha3_256 = 7;
  RsaSha3_384 = 8;
  RsaSha3_512 = 9;
  { the salt length that EMSA-PSS-VERIFY reads from the encoded message,
    Go's pssSaltLengthAutodetect (crypto/rsa's PSSSaltLengthAuto) }
  RsaPssSaltAuto = -1;
  { a salt as long as the hash's digest, signing and verifying (Go's
    PSSSaltLengthEqualsHash). When signing, RsaPssSaltAuto is the
    longest salt the key takes (Go's PSSSaltLengthAuto) }
  RsaPssSaltEqualsHash = -2;

type
  { a natural number: Limbs[0] is the least significant 64 bits, and
    Length(Limbs) is its announced length. Two TNat must not share
    their Limbs: copy one with NatSet, never with := }
  TNat = record
    Limbs: array of Integer;
  end;

  { a modulus greater than one, kept without leading zero limbs; when
    it is odd, M0Inv is -Nat^-1 mod 2^64 and RR is R*R mod Nat with
    R = 2^(64 * Length(Nat.Limbs)), the constants of Montgomery
    multiplication (Go's bigmod.Modulus) }
  TModulus = record
    Nat: TNat;
    OddModulus: Boolean;
    M0Inv: Integer;
    RR: TNat;
  end;

  { an RSA public key that passed Go's checks (crypto/rsa checkKeySize,
    fips140/rsa checkPublicKey), its modulus made ready once for many
    verifications }
  TRsaPublicKey = record
    N: TModulus;
    E: Integer;
  end;

  { an RSA private key of two primes that passed Go's checks
    (fips140/rsa checkPrivateKey), made ready once for many signatures:
    the primes as moduli, the exponents d mod (p-1) and d mod (q-1) as
    big-endian bytes of the size of p-1 and q-1, and q^-1 mod p.
    Everything but Pub is secret. A key that is Ready is only read, so
    any number of routines may sign with it at once; make one with
    RsaPrivateKeyInit or RsaPrivateKeyInitCrt, never field by field }
  TRsaPrivateKey = record
    Pub: TRsaPublicKey;
    D: TNat;
    P, Q: TModulus;
    DP, DQ: string;
    QInv: TNat;
    Ready: Boolean;
  end;

{ ---- bigmod: natural numbers modulo m (Go's nat.go) ---- }

{ X becomes a zero of N limbs (Go's reset) }
procedure NatReset(var X: TNat; N: Integer);
{ X becomes the big-endian B, its announced length that of B's value
  (Go's resetToBytes): an operand of NatMod of any length }
procedure NatResetToBytes(var X: TNat; const B: string);
{ X becomes a copy of Y, of Y's announced length (Go's set) }
procedure NatSet(var X: TNat; const Y: TNat);
{ X becomes the one-limb Y (Go's SetUint) }
procedure NatSetUint(var X: TNat; Y: Integer);
{ X grows to M's announced length, its value kept (Go's ExpandFor);
  False when X is longer than M }
function NatExpandFor(var X: TNat; const M: TModulus): Boolean;
{ X becomes the big-endian B, of M's announced length (Go's SetBytes);
  False when B is not below M }
function NatSetBytes(var X: TNat; const B: string; const M: TModulus): Boolean;
{ X as big-endian bytes, as many as M has (Go's Bytes); X must be of
  M's length and not above it, else '' }
function NatBytes(const X: TNat; const M: TModulus): string;
{ 1 when X = Y (both of one announced length), else 0, in constant
  time (Go's Equal) }
function NatEqual(const X, Y: TNat): Integer;
{ 1 when X is zero, else 0, in constant time (Go's IsZero) }
function NatIsZero(const X: TNat): Integer;
{ 1 when X is odd (Go's IsOdd) }
function NatIsOdd(const X: TNat): Integer;
{ the bit length of X's value; leaks it (Go's BitLenVarTime) }
function NatBitLenVarTime(const X: TNat): Integer;
{ X := X + Y mod M and X := X - Y mod M, both reduced and of M's
  length (Go's Add and Sub) }
procedure NatAdd(var X: TNat; const Y: TNat; const M: TModulus);
procedure NatSub(var X: TNat; const Y: TNat; const M: TModulus);
{ X := X * Y mod M, both reduced and of M's length (Go's Mul) }
procedure NatMul(var X: TNat; const Y: TNat; const M: TModulus);
{ Res := X mod M for an X of any length (Go's Mod) }
procedure NatMod(var Res: TNat; const X: TNat; const M: TModulus);
{ Res := X^E mod M in constant time, E a big-endian exponent of public
  length, X reduced; M must be odd, else Res is empty (Go's Exp) }
procedure NatExp(var Res: TNat; const X: TNat; const E: string; const M: TModulus);
{ Res := X^E mod M for a public E above zero; leaks E (Go's
  ExpShortVarTime); M must be odd, else Res is empty }
procedure NatExpShortVarTime(var Res: TNat; const X: TNat; E: Integer; const M: TModulus);

{ M becomes the big-endian B (leading zeros dropped); False when it is
  not above one (Go's NewModulus) }
function NewModulus(var M: TModulus; const B: string): Boolean;
{ M's bit length and its size in bytes (Go's Modulus.BitLen, Size) }
function ModulusBitLen(const M: TModulus): Integer;
function ModulusSize(const M: TModulus): Integer;
{ a copy of M's value (Go's Modulus.Nat) }
procedure ModulusNat(var X: TNat; const M: TModulus);

{ ---- RSA ---- }

{ the digest of Msg by Hash, '' for RsaHashNone or an unknown one }
function RsaHash(Hash: Integer; const Msg: string): string;
{ the size of Hash's digest, -1 for RsaHashNone or an unknown one }
function RsaHashSize(Hash: Integer): Integer;

{ Key from the big-endian modulus N and the exponent E; False when Go
  refuses the key: N under 1024 bits (crypto/rsa checkKeySize), N even
  or not above one, E below 2, even or above 2^31 - 1 (fips140/rsa
  checkPublicKey) }
function RsaPublicKeyInit(var Key: TRsaPublicKey; const N: string; E: Integer): Boolean;
{ the size of Key's modulus in bytes, k of RFC 8017 }
function RsaPublicKeySize(const Key: TRsaPublicKey): Integer;
{ RSAVP1 (RFC 8017 5.2.2), Go's encrypt: S^e mod n as k bytes; False
  when S is not below n }
function RsaPublicOp(const Key: TRsaPublicKey; const S: string; out Em: string): Boolean;

{ RSASSA-PKCS1-V1_5-VERIFY (RFC 8017 8.2.2) of Sig over the digest
  Hashed, as Go's VerifyPKCS1v15: the whole encoded message compared
  byte for byte with the one built from Hashed }
function RsaKeyVerifyPkcs1v15(const Key: TRsaPublicKey; Hash: Integer; const Hashed, Sig: string): Boolean;
{ RSASSA-PSS-VERIFY (RFC 8017 8.1.2) with MGF1 on the same hash, as
  Go's VerifyPSS (SaltLen RsaPssSaltAuto) and VerifyPSSWithSaltLength
  (SaltLen 0 or more); Hash not RsaHashNone }
function RsaKeyVerifyPss(const Key: TRsaPublicKey; Hash: Integer; const Hashed, Sig: string; SaltLen: Integer): Boolean;

{ the same from the modulus N and exponent E at once }
function RsaVerifyPkcs1v15(const N: string; E: Integer; Hash: Integer; const Hashed, Sig: string): Boolean;
function RsaVerifyPss(const N: string; E: Integer; Hash: Integer; const Hashed, Sig: string; SaltLen: Integer): Boolean;

{ ---- RSA private keys and signatures ---- }

{ Key from the big-endian modulus N, the exponents E and D and the
  primes P and Q, the Chinese remainder values worked out in constant
  time (Go's NewPrivateKey). False with the reason in Err, Go's text
  where Go has one, when the key is refused: the public half as RsaPublicKeyInit refuses
  it; a prime that is even or not above one; D not below N; P * Q not
  N (the whole product is compared, where Go asks for a multiple of N);
  E * dP not 1 mod P-1 or E * dQ not 1 mod Q-1; qInv * Q not 1 mod P;
  D that disagrees with dP or dQ; P and Q equal or closer than
  2^(bits/2 - 100), which Fermat's method factors; D not above
  2^(bits/2). Leading zero bytes are dropped }
function RsaPrivateKeyInit(var Key: TRsaPrivateKey; const N: string; E: Integer;
  const D, P, Q: string; out Err: string): Boolean;
{ the same with dP = D mod (P-1), dQ = D mod (Q-1) and qInv = Q^-1 mod P
  given, as a key file holds them, and checked against the rest (Go's
  NewPrivateKeyWithPrecomputation) }
function RsaPrivateKeyInitCrt(var Key: TRsaPrivateKey; const N: string; E: Integer;
  const D, P, Q, DP, DQ, QInv: string; out Err: string): Boolean;
{ the size of Key's modulus in bytes, the size of its signatures }
function RsaPrivateKeySize(const Key: TRsaPrivateKey): Integer;
{ for a key that is no longer needed: its secret numbers are zeroed
  where they lie, then Key holds nothing and is not Ready. A copy of
  the key made with := shares those numbers and is zeroed with it (it
  then signs nothing: its result fails the check). The memory itself
  goes back to the collector, which may have moved nothing: the heap
  never moves, so no other copy of the numbers is left by it }
procedure RsaPrivateKeyClear(var Key: TRsaPrivateKey);

{ RSASSA-PKCS1-V1_5-SIGN (RFC 8017 8.2.1) of the digest Hashed, as Go's
  SignPKCS1v15: the same signature every time. Hash RsaHashNone signs
  Hashed as given, with no DigestInfo, for old protocols only. False
  when Key is not Ready, Hashed is not a digest of Hash, the key is too
  short for it, or the result failed its check }
function RsaSignPkcs1v15(const Key: TRsaPrivateKey; Hash: Integer; const Hashed: string; out Sig: string): Boolean;
{ RSASSA-PSS-SIGN (RFC 8017 8.1.1) with MGF1 on the same hash, as Go's
  SignPSS: a salt of SaltLen bytes from the kernel's generator
  (getrandom), RsaPssSaltEqualsHash for the digest's size (what TLS 1.3
  and JWT's PS256 ask) or RsaPssSaltAuto for the longest the key takes.
  Hash not RsaHashNone }
function RsaSignPss(const Key: TRsaPrivateKey; Hash: Integer; const Hashed: string; SaltLen: Integer; out Sig: string): Boolean;
{ the same with the salt given: for test vectors, whose salts are
  written down. A salt must not be used twice with a secret message }
function RsaSignPssSalt(const Key: TRsaPrivateKey; Hash: Integer; const Hashed, Salt: string; out Sig: string): Boolean;

implementation

const
  { the limbs a Montgomery product keeps on the stack: moduli up to
    16384 bits; larger ones take a heap block }
  StackLimbs = 256;
  { the sign bit: x xor SignBit < y xor SignBit is x < y without sign }
  SignBit = Integer($8000000000000000);

type
  TScratch = array[0..2 * StackLimbs - 1] of Integer;

{ ---- constant-time helpers (nat.go not, ctMask, ctEq) ---- }

{ ctEq: 1 when X = Y, else 0. If X <> Y, either X - Y or Y - X borrows }
function CtEq(X, Y: Integer): Integer;
var
  c1, c2, d: Integer;
begin
  d := SubBorrow(X, Y, 0, c1);
  d := SubBorrow(Y, X, 0, c2);
  Result := 1 xor (c1 or c2);
end;

{ ---- Nat (nat.go) ---- }

procedure NatReset(var X: TNat; N: Integer);
var
  i: Integer;
begin
  if Length(X.Limbs) = N then
  begin
    for i := 0 to N - 1 do
      X.Limbs[i] := 0;
  end
  else
  begin
    X.Limbs := nil;
    SetLength(X.Limbs, N);
  end;
end;

{ expand: X grows to N limbs, its value unchanged }
procedure NatExpand(var X: TNat; N: Integer);
begin
  if Length(X.Limbs) < N then
    SetLength(X.Limbs, N);
end;

procedure NatSet(var X: TNat; const Y: TNat);
var
  i, n: Integer;
begin
  n := Length(Y.Limbs);
  NatReset(X, n);
  for i := 0 to n - 1 do
    X.Limbs[i] := Y.Limbs[i];
end;

procedure NatSetUint(var X: TNat; Y: Integer);
begin
  NatReset(X, 1);
  X.Limbs[0] := Y;
end;

{ trim: drop the most significant zero limbs. Comparison with zero
  (not the branch) is taken as constant time, as Go does }
procedure NatTrim(var X: TNat);
var
  i: Integer;
begin
  i := Length(X.Limbs);
  while (i > 0) and (X.Limbs[i - 1] = 0) do
    Dec(i);
  if i < Length(X.Limbs) then
    SetLength(X.Limbs, i);
end;

{ setBytes: the big-endian B into X's limbs (X zeroed); False when B
  does not fit them }
function NatSetBytesRaw(var X: TNat; const B: string): Boolean;
var
  i, k, s, n: Integer;
begin
  i := Length(B);
  k := 0;
  n := Length(X.Limbs);
  while (k < n) and (i >= 8) do
  begin
    X.Limbs[k] := LoadBE64(@B[i - 7]);
    i := i - 8;
    Inc(k);
  end;
  s := 0;
  while (s < 64) and (k < n) and (i > 0) do
  begin
    X.Limbs[k] := X.Limbs[k] or (Ord(B[i]) shl s);
    Dec(i);
    s := s + 8;
  end;
  Result := i = 0;
end;

{ resetToBytes }
procedure NatResetToBytes(var X: TNat; const B: string);
begin
  NatReset(X, (Length(B) + 7) div 8);
  NatSetBytesRaw(X, B);
  NatTrim(X);
end;

function NatEqual(const X, Y: TNat): Integer;
var
  i, eq: Integer;
begin
  eq := 1;
  for i := 0 to Length(X.Limbs) - 1 do
    eq := eq and CtEq(X.Limbs[i], Y.Limbs[i]);
  Result := eq;
end;

function NatIsZero(const X: TNat): Integer;
var
  i, z: Integer;
begin
  z := 1;
  for i := 0 to Length(X.Limbs) - 1 do
    z := z and CtEq(X.Limbs[i], 0);
  Result := z;
end;

{ IsOne: 1 when X = 1 }
function NatIsOne(const X: TNat): Integer;
var
  i, one: Integer;
begin
  if Length(X.Limbs) = 0 then
    Exit(0);
  one := CtEq(X.Limbs[0], 1);
  for i := 1 to Length(X.Limbs) - 1 do
    one := one and CtEq(X.Limbs[i], 0);
  Result := one;
end;

function NatIsOdd(const X: TNat): Integer;
begin
  if Length(X.Limbs) = 0 then
    Exit(0);
  Result := X.Limbs[0] and 1;
end;

{ cmpGeq: 1 when X >= Y (one announced length): X - Y does not borrow }
function NatCmpGeq(const X, Y: TNat): Integer;
var
  i, c, d: Integer;
begin
  c := 0;
  for i := 0 to Length(X.Limbs) - 1 do
    d := SubBorrow(X.Limbs[i], Y.Limbs[i], c, c);
  Result := 1 xor c;
end;

{ assign: X := Y when On = 1, unchanged when On = 0, in constant time }
procedure NatAssign(var X: TNat; On: Integer; const Y: TNat);
var
  i, mask: Integer;
begin
  mask := -On;
  for i := 0 to Length(X.Limbs) - 1 do
    X.Limbs[i] := X.Limbs[i] xor (mask and (X.Limbs[i] xor Y.Limbs[i]));
end;

{ add: X += Y (one announced length), the carry out }
function NatAddRaw(var X: TNat; const Y: TNat): Integer;
var
  i, c: Integer;
begin
  c := 0;
  for i := 0 to Length(X.Limbs) - 1 do
    X.Limbs[i] := AddCarry(X.Limbs[i], Y.Limbs[i], c, c);
  Result := c;
end;

{ sub: X -= Y (one announced length), the borrow out }
function NatSubRaw(var X: TNat; const Y: TNat): Integer;
var
  i, c: Integer;
begin
  c := 0;
  for i := 0 to Length(X.Limbs) - 1 do
    X.Limbs[i] := SubBorrow(X.Limbs[i], Y.Limbs[i], c, c);
  Result := c;
end;

function NatBitLenVarTime(const X: TNat): Integer;
var
  i, v, n: Integer;
begin
  for i := Length(X.Limbs) - 1 downto 0 do
    if X.Limbs[i] <> 0 then
    begin
      { bitLen: only the bit length of the limb leaks, not its value }
      v := X.Limbs[i];
      n := 0;
      while v <> 0 do
      begin
        Inc(n);
        v := v shr 1;
      end;
      Exit(i * 64 + n);
    end;
  Result := 0;
end;

{ ---- Modulus ---- }

function ModulusBitLen(const M: TModulus): Integer;
begin
  Result := NatBitLenVarTime(M.Nat);
end;

function ModulusSize(const M: TModulus): Integer;
begin
  Result := (ModulusBitLen(M) + 7) div 8;
end;

procedure ModulusNat(var X: TNat; const M: TModulus);
begin
  NatSet(X, M.Nat);
end;

function NatExpandFor(var X: TNat; const M: TModulus): Boolean;
begin
  Result := Length(X.Limbs) <= Length(M.Nat.Limbs);
  if Result then
    NatExpand(X, Length(M.Nat.Limbs));
end;

{ resetFor: X zeroed, of M's announced length }
procedure NatResetFor(var X: TNat; const M: TModulus);
begin
  NatReset(X, Length(M.Nat.Limbs));
end;

{ maybeSubtractModulus: X -= M when X >= M or when Always = 1 (the
  carry of an operation that overflowed X's size), in constant time.
  X - M is worked out on the stack, as Go's NewNat keeps it there }
procedure NatMaybeSubtractModulus(var X: TNat; Always: Integer; const M: TModulus);
var
  buf: array[0..StackLimbs - 1] of Integer;
  big: array of Integer;
  t, xp, mp: PInteger;
  n, i, underflow, keep, mask: Integer;
begin
  n := Length(X.Limbs);
  if n = 0 then
    Exit;
  if n <= StackLimbs then
    t := @buf[0]
  else
  begin
    SetLength(big, n);
    t := @big[0];
  end;
  xp := @X.Limbs[0];
  mp := @M.Nat.Limbs[0];
  { t := x; underflow := t.sub(m.nat) }
  underflow := 0;
  for i := 0 to n - 1 do
    t[i] := SubBorrow(xp[i], mp[i], underflow, underflow);
  { keep X - M when it did not underflow (X >= M) or when Always }
  keep := (1 xor underflow) or Always;
  { x.assign(keep, t) }
  mask := -keep;
  for i := 0 to n - 1 do
    xp[i] := xp[i] xor (mask and (xp[i] xor t[i]));
end;

procedure NatSub(var X: TNat; const Y: TNat; const M: TModulus);
var
  t: TNat;
  underflow, d: Integer;
begin
  underflow := NatSubRaw(X, Y);
  { if the subtraction underflowed, add M }
  NatSet(t, X);
  d := NatAddRaw(t, M.Nat);
  NatAssign(X, underflow, t);
end;

procedure NatAdd(var X: TNat; const Y: TNat; const M: TModulus);
var
  overflow: Integer;
begin
  overflow := NatAddRaw(X, Y);
  NatMaybeSubtractModulus(X, overflow, M);
end;

{ addMulVVW: Z[0..N-1] += X[0..N-1] * Y, the final carry out; one row
  of a pen-and-paper column multiplication. Go adds with bits.Add; here
  the carry of each addition is the unsigned compare of the sum with an
  addend (sum < addend), the sign bit flipped on both sides of a signed
  compare, which is a setl, constant time. AddCarry takes the place of
  bits.Add elsewhere, but its carry goes through memory, and in this
  loop that made the whole of RSA verification 2.1 times slower }
function AddMulVVW(Z, X: PInteger; N, Y: Integer): Integer;
var
  i, hi, lo, p, zi, cy: Integer;
begin
  cy := 0;
  for i := 0 to N - 1 do
  begin
    { hi, lo := bits.Mul(x[i], y) }
    p := X[i];
    lo := p * Y;
    hi := MulHi(p, Y);
    { lo, c := bits.Add(lo, z[i], 0); hi, _ := bits.Add(hi, 0, c): hi is
      at most 2^64 - 2, so neither add to it overflows }
    zi := Z[i];
    lo := lo + zi;
    hi := hi + Ord((lo xor SignBit) < (zi xor SignBit));
    { lo, c = bits.Add(lo, carry, 0); hi, _ = bits.Add(hi, 0, c) }
    lo := lo + cy;
    hi := hi + Ord((lo xor SignBit) < (cy xor SignBit));
    cy := hi;
    Z[i] := lo;
  end;
  Result := cy;
end;

{ montgomeryMul: X := A * B / R mod M, R = 2^(64 n), n M's announced
  length; A and B reduced and of length n, X may be either of them.
  Word-by-word Montgomery multiplication, Algorithm 4 of Gueron's
  "Efficient Software Implementations of Modular Exponentiation", as
  Go's default case: step 1 (T = A * B) runs a digit at a time inside
  the loop of steps 2 to 6, and step 6 slides the window T[i..] }
procedure NatMontgomeryMul(var X: TNat; const A, B: TNat; const M: TModulus);
var
  buf: TScratch;
  big: array of Integer;
  T, ap, mp: PInteger;
  n, i, c, c1, c2, d, y: Integer;
begin
  n := Length(M.Nat.Limbs);
  if n <= StackLimbs then
  begin
    T := @buf[0];
    FillChar(T^, 16 * n, 0);
  end
  else
  begin
    SetLength(big, 2 * n);
    T := @big[0];
  end;
  ap := @A.Limbs[0];
  mp := @M.Nat.Limbs[0];
  c := 0;
  for i := 0 to n - 1 do
  begin
    d := B.Limbs[i];
    c1 := AddMulVVW(T + i, ap, n, d);
    { steps 2 and 3: T mod 2^64 is T[i], k0 is m0inv }
    y := T[i] * M.M0Inv;
    { steps 4 and 5: T += Y * M; the two carries go to T[n + i] and its
      carry to the next round }
    c2 := AddMulVVW(T + i, mp, n, y);
    T[n + i] := AddCarry(c1, c2, c, c);
  end;
  { step 7: the window T[n..2n-1] into X, M subtracted when X >= M or
    when it overflowed }
  NatReset(X, n);
  for i := 0 to n - 1 do
    X.Limbs[i] := T[n + i];
  NatMaybeSubtractModulus(X, c, M);
end;

{ montgomeryRepresentation: X := X * R mod M, a Montgomery product by
  R*R }
procedure NatMontgomeryRepresentation(var X: TNat; const M: TModulus);
begin
  NatMontgomeryMul(X, X, M.RR, M);
end;

{ montgomeryReduction: X := X / R mod M, a Montgomery product by 1 }
procedure NatMontgomeryReduction(var X: TNat; const M: TModulus);
var
  one: TNat;
begin
  NatReset(one, Length(M.Nat.Limbs));
  one.Limbs[0] := 1;
  NatMontgomeryMul(X, X, one, M);
end;

{ rr: R*R mod M, R = 2^(64 n). From 2^(bitlen - 1) doublings reach R
  mod M; then a few more doublings and a square-and-double chain reach
  R*R (R in Montgomery form), the threshold n / 4 Go's }
procedure ModulusRR(var RR: TNat; const M: TModulus);
var
  n, mLen, logR, i, k, threshold: Integer;
begin
  NatReset(RR, Length(M.Nat.Limbs));
  n := Length(RR.Limbs);
  mLen := ModulusBitLen(M);
  logR := 64 * n;
  { 2^floor(log2 m), the highest bit that needs no reduction }
  RR.Limbs[n - 1] := 1 shl ((mLen - 1) mod 64);
  { then doublings up to 2^(64 n) }
  for i := mLen - 1 to logR - 1 do
    NatAdd(RR, RR, M);
  threshold := n div 4;
  { the most significant bits of the exponent logR done with doublings.
    Go starts at i = 64, where logR >> 64 is 0 and the loop goes on;
    a shift by 64 is a shift by 0 on both machines, so start at 63 }
  i := 63;
  while (logR shr i) <= threshold do
    Dec(i);
  for k := 0 to (logR shr i) - 1 do
    NatAdd(RR, RR, M);
  { the rest with a square-and-double chain }
  while i > 0 do
  begin
    NatMontgomeryMul(RR, RR, RR, M);
    Dec(i);
    if ((logR shr i) and 1) <> 0 then
      NatAdd(RR, RR, M);
  end;
end;

{ minusInverseModW: -X^-1 mod 2^64 for an odd X; each round doubles the
  correct low bits of the inverse, three to begin with }
function MinusInverseModW(X: Integer): Integer;
var
  y, i: Integer;
begin
  y := X;
  for i := 0 to 4 do
    y := y * (2 - X * y);
  Result := -y;
end;

{ NewModulus and newModulus }
function NewModulus(var M: TModulus; const B: string): Boolean;
begin
  NatResetToBytes(M.Nat, B);
  M.OddModulus := False;
  M.M0Inv := 0;
  M.RR.Limbs := nil;
  if (NatIsZero(M.Nat) = 1) or (NatIsOne(M.Nat) = 1) then
    Exit(False);
  if NatIsOdd(M.Nat) = 1 then
  begin
    M.OddModulus := True;
    M.M0Inv := MinusInverseModW(M.Nat.Limbs[0]);
    ModulusRR(M.RR, M);
  end;
  Result := True;
end;

function NatSetBytes(var X: TNat; const B: string; const M: TModulus): Boolean;
begin
  NatResetFor(X, M);
  if not NatSetBytesRaw(X, B) then
    Exit(False);
  { input overflows the modulus }
  Result := NatCmpGeq(X, M.Nat) = 0;
end;

function NatBytes(const X: TNat; const M: TModulus): string;
var
  i, j, k, limb: Integer;
begin
  i := ModulusSize(M);
  Result := '';
  SetLength(Result, i);
  for k := 0 to Length(X.Limbs) - 1 do
  begin
    limb := X.Limbs[k];
    for j := 0 to 7 do
    begin
      Dec(i);
      if i < 0 then
      begin
        if limb = 0 then
          Break;
        { the modulus is smaller than the nat }
        Exit('');
      end;
      Result[i + 1] := Chr(limb and 255);
      limb := limb shr 8;
    end;
  end;
end;

{ shiftIn: X := X * 2^64 + Y mod M, X reduced. A bit of Y at a time:
  each round works out 2X + b and 2X + b - M, and the next round (and
  the end) keeps the one that is reduced }
procedure NatShiftIn(var X: TNat; Y: Integer; const M: TModulus);
var
  d: TNat;
  size, i, j, cy, borrow, mask, l, needSub: Integer;
begin
  NatResetFor(d, M);
  size := Length(M.Nat.Limbs);
  needSub := 0;
  for i := 63 downto 0 do
  begin
    cy := (Y shr i) and 1;
    borrow := 0;
    mask := -needSub;
    for j := 0 to size - 1 do
    begin
      l := X.Limbs[j] xor (mask and (X.Limbs[j] xor d.Limbs[j]));
      X.Limbs[j] := AddCarry(l, l, cy, cy);
      d.Limbs[j] := SubBorrow(X.Limbs[j], M.Nat.Limbs[j], borrow, borrow);
    end;
    { subtract when 2X + b - M did not underflow, or when 2X + b
      overflowed the limbs }
    needSub := (1 xor borrow) or cy;
  end;
  NatAssign(X, needSub, d);
end;

procedure NatMod(var Res: TNat; const X: TNat; const M: TModulus);
var
  i, j, start: Integer;
  xs: TNat;
begin
  { X copied first: Res may be X }
  NatSet(xs, X);
  NatResetFor(Res, M);
  i := Length(xs.Limbs) - 1;
  { the first N - 1 limbs go straight to their shifted place }
  start := Length(M.Nat.Limbs) - 2;
  if i < start then
    start := i;
  for j := start downto 0 do
  begin
    Res.Limbs[j] := xs.Limbs[i];
    Dec(i);
  end;
  { the rest shifted in, reduced each time }
  while i >= 0 do
  begin
    NatShiftIn(Res, xs.Limbs[i], M);
    Dec(i);
  end;
end;

procedure NatMul(var X: TNat; const Y: TNat; const M: TModulus);
var
  xR, t: TNat;
  n, i: Integer;
begin
  if M.OddModulus then
  begin
    { a Montgomery product by a value outside the Montgomery domain
      takes the result out of it: xR = X * R, X = xR * Y / R }
    NatSet(xR, X);
    NatMontgomeryRepresentation(xR, M);
    NatMontgomeryMul(X, xR, Y, M);
    Exit;
  end;
  n := Length(M.Nat.Limbs);
  NatReset(t, 2 * n);
  { T = X * Y, then X = T mod M }
  for i := 0 to n - 1 do
    t.Limbs[n + i] := AddMulVVW(@t.Limbs[i], @X.Limbs[0], n, Y.Limbs[i]);
  NatMod(X, t, M);
end;

procedure NatExp(var Res: TNat; const X: TNat; const E: string; const M: TModulus);
var
  table: array[0..14] of TNat;
  tmp: TNat;
  i, p, j, b, k: Integer;
begin
  if not M.OddModulus then
  begin
    NatReset(Res, 0);
    Exit;
  end;
  { a 4-bit window: table[i] = X^(i+1), in Montgomery form }
  NatSet(table[0], X);
  NatMontgomeryRepresentation(table[0], M);
  for i := 1 to 14 do
    NatMontgomeryMul(table[i], table[i - 1], table[0], M);
  NatResetFor(Res, M);
  Res.Limbs[0] := 1;
  NatMontgomeryRepresentation(Res, M);
  NatResetFor(tmp, M);
  for p := 1 to Length(E) do
  begin
    b := Ord(E[p]);
    j := 4;
    while j >= 0 do
    begin
      { square four times }
      NatMontgomeryMul(Res, Res, Res, M);
      NatMontgomeryMul(Res, Res, Res, M);
      NatMontgomeryMul(Res, Res, Res, M);
      NatMontgomeryMul(Res, Res, Res, M);
      { X^k chosen from the table in constant time }
      k := (b shr j) and 15;
      for i := 0 to 14 do
        NatAssign(tmp, CtEq(k, i + 1), table[i]);
      { multiply by X^k, the product dropped when k = 0 }
      NatMontgomeryMul(tmp, Res, tmp, M);
      NatAssign(Res, 1 xor CtEq(k, 0), tmp);
      j := j - 4;
    end;
  end;
  NatMontgomeryReduction(Res, M);
end;

procedure NatExpShortVarTime(var Res: TNat; const X: TNat; E: Integer; const M: TModulus);
var
  xR: TNat;
  i, bl, v: Integer;
begin
  if not M.OddModulus then
  begin
    NatReset(Res, 0);
    Exit;
  end;
  { a conditional square-and-multiply chain past the leading zeros }
  NatSet(xR, X);
  NatMontgomeryRepresentation(xR, M);
  NatSet(Res, xR);
  bl := 0;
  v := E;
  while v <> 0 do
  begin
    Inc(bl);
    v := v shr 1;
  end;
  for i := 64 - bl + 1 to 63 do
  begin
    NatMontgomeryMul(Res, Res, Res, M);
    if ((E shr (63 - i)) and 1) <> 0 then
      NatMontgomeryMul(Res, Res, xR, M);
  end;
  NatMontgomeryReduction(Res, M);
end;

{ ---- hashes ---- }

function RsaHash(Hash: Integer; const Msg: string): string;
begin
  case Hash of
    RsaSha1: Result := Sha1(Msg);
    RsaSha224: Result := Sha224(Msg);
    RsaSha256: Result := Sha256(Msg);
    RsaSha384: Result := Sha384(Msg);
    RsaSha512: Result := Sha512(Msg);
    RsaSha3_224: Result := Sha3_224(Msg);
    RsaSha3_256: Result := Sha3_256(Msg);
    RsaSha3_384: Result := Sha3_384(Msg);
    RsaSha3_512: Result := Sha3_512(Msg);
  else
    Result := '';
  end;
end;

{ pkcs1v15.go hashSize }
function RsaHashSize(Hash: Integer): Integer;
begin
  case Hash of
    RsaSha1: Result := 20;
    RsaSha224, RsaSha3_224: Result := 28;
    RsaSha256, RsaSha3_256: Result := 32;
    RsaSha384, RsaSha3_384: Result := 48;
    RsaSha512, RsaSha3_512: Result := 64;
  else
    Result := -1;
  end;
end;

function UnHexConst(const H: string): string;
var
  i, d, v: Integer;
  c: Char;
begin
  Result := '';
  SetLength(Result, Length(H) div 2);
  v := 0;
  for i := 1 to Length(H) do
  begin
    c := H[i];
    if (c >= '0') and (c <= '9') then
      d := Ord(c) - 48
    else
      d := Ord(c) - 87;
    if Odd(i) then
      v := d shl 4
    else
      Result[i div 2] := Chr(v or d);
  end;
end;

{ pkcs1v15.go hashPrefixes: the DER of DigestInfo up to the digest
  (RFC 8017 9.2 note 1) }
function HashPrefix(Hash: Integer): string;
begin
  case Hash of
    RsaSha1: Result := UnHexConst('3021300906052b0e03021a05000414');
    RsaSha224: Result := UnHexConst('302d300d06096086480165030402040500041c');
    RsaSha256: Result := UnHexConst('3031300d060960864801650304020105000420');
    RsaSha384: Result := UnHexConst('3041300d060960864801650304020205000430');
    RsaSha512: Result := UnHexConst('3051300d060960864801650304020305000440');
    RsaSha3_224: Result := UnHexConst('302d300d06096086480165030402070500041c');
    RsaSha3_256: Result := UnHexConst('3031300d060960864801650304020805000420');
    RsaSha3_384: Result := UnHexConst('3041300d060960864801650304020905000430');
    RsaSha3_512: Result := UnHexConst('3051300d060960864801650304020a05000440');
  else
    Result := '';
  end;
end;

{ ---- RSA (fips140/rsa rsa.go) ---- }

{ the checks of RsaPublicKeyInit with the reason of a refusal, Go's
  text, for a private key's loader to give }
function PublicKeyInitErr(var Key: TRsaPublicKey; const N: string; E: Integer; out Err: string): Boolean;
var
  bits: Integer;
  digits: string;
begin
  Result := False;
  Err := '';
  Key.E := 0;
  { crypto/rsa fipsPublicKey: bigmod.NewModulus, the value above one }
  if not NewModulus(Key.N, N) then
  begin
    Err := 'crypto/rsa: invalid modulus';
    Exit;
  end;
  bits := ModulusBitLen(Key.N);
  { crypto/rsa checkKeySize: 1024 bits at least }
  if bits < 1024 then
  begin
    Str(bits, digits);
    Err := 'crypto/rsa: ' + digits + '-bit keys are insecure';
    Exit;
  end;
  { checkPublicKey: the modulus odd }
  if not Key.N.OddModulus then
  begin
    Err := 'crypto/rsa: public modulus is even';
    Exit;
  end;
  { e at least 2, odd (coprime with p - 1 and q - 1), at most 2^31 - 1 }
  if E < 2 then
  begin
    Err := 'crypto/rsa: public exponent too small or negative';
    Exit;
  end;
  if (E and 1) = 0 then
  begin
    Err := 'crypto/rsa: public exponent is even';
    Exit;
  end;
  if E > $7FFFFFFF then
  begin
    Err := 'crypto/rsa: public exponent too large';
    Exit;
  end;
  Key.E := E;
  Result := True;
end;

function RsaPublicKeyInit(var Key: TRsaPublicKey; const N: string; E: Integer): Boolean;
var
  why: string;
begin
  Result := PublicKeyInitErr(Key, N, E, why);
end;

function RsaPublicKeySize(const Key: TRsaPublicKey): Integer;
begin
  Result := ModulusSize(Key.N);
end;

{ encrypt: m from S (refused when not below n), m^e mod n, its k bytes }
function RsaPublicOp(const Key: TRsaPublicKey; const S: string; out Em: string): Boolean;
var
  m, c: TNat;
begin
  Em := '';
  if Key.E = 0 then
    Exit(False);
  if not NatSetBytes(m, S, Key.N) then
    Exit(False);
  NatExpShortVarTime(c, m, Key.E, Key.N);
  Em := NatBytes(c, Key.N);
  Result := True;
end;

{ ---- PKCS #1 v1.5 (pkcs1v15.go) ---- }

{ pkcs1v15ConstructEM: EM = 0x00 || 0x01 || PS || 0x00 || T, T the
  DigestInfo prefix and the digest, PS 0xff bytes, at least 8 }
function Pkcs1v15ConstructEM(K: Integer; Hash: Integer; const Hashed: string; out Em: string): Boolean;
var
  prefix: string;
  i: Integer;
begin
  Em := '';
  prefix := '';
  if Hash <> RsaHashNone then
  begin
    prefix := HashPrefix(Hash);
    { unsupported hash function }
    if prefix = '' then
      Exit(False);
    { hashed message length does not match the hash }
    if Length(Hashed) <> RsaHashSize(Hash) then
      Exit(False);
  end;
  if K < Length(prefix) + Length(Hashed) + 2 + 8 + 1 then
    Exit(False);
  SetLength(Em, K);
  Em[2] := #1;
  for i := 3 to K - Length(prefix) - Length(Hashed) - 1 do
    Em[i] := #255;
  for i := 1 to Length(prefix) do
    Em[K - Length(prefix) - Length(Hashed) + i] := prefix[i];
  for i := 1 to Length(Hashed) do
    Em[K - Length(Hashed) + i] := Hashed[i];
  Result := True;
end;

{ verifyPKCS1v15 }
function RsaKeyVerifyPkcs1v15(const Key: TRsaPublicKey; Hash: Integer; const Hashed, Sig: string): Boolean;
var
  em, expected: string;
begin
  Result := False;
  if Key.E = 0 then
    Exit;
  { crypto/rsa VerifyPKCS1v15: the input must be a digest of the hash }
  if (Hash <> RsaHashNone) and (Length(Hashed) <> RsaHashSize(Hash)) then
    Exit;
  { RFC 8017 8.2.2 step 1: S of k octets }
  if RsaPublicKeySize(Key) <> Length(Sig) then
    Exit;
  { step 2: RSAVP1 }
  if not RsaPublicOp(Key, Sig, em) then
    Exit;
  { step 3: EMSA-PKCS1-v1_5 encoding of the digest }
  if not Pkcs1v15ConstructEM(RsaPublicKeySize(Key), Hash, Hashed, expected) then
    Exit;
  { step 4: the two encoded messages compared whole }
  Result := em = expected;
end;

{ ---- PSS (pkcs1v22.go) ---- }

{ mgf1XOR: Data[From..From+Len-1] xored with MGF1(Seed, Len) (RFC 8017
  B.2.1), the counter four big-endian bytes (incCounter) }
procedure Mgf1Xor(var Data: string; From, Len: Integer; Hash: Integer; const Seed: string);
var
  counter: Integer;
  digest, ctr: string;
  done, i: Integer;
begin
  done := 0;
  counter := 0;
  while done < Len do
  begin
    ctr := Chr((counter shr 24) and 255) + Chr((counter shr 16) and 255) +
      Chr((counter shr 8) and 255) + Chr(counter and 255);
    digest := RsaHash(Hash, Seed + ctr);
    i := 1;
    while (i <= Length(digest)) and (done < Len) do
    begin
      Data[From + done] := Chr(Ord(Data[From + done]) xor Ord(digest[i]));
      Inc(done);
      Inc(i);
    end;
    Inc(counter);
  end;
end;

{ emsaPSSVerify (RFC 8017 9.1.2) of the digest MHash against EM of
  EmBits bits; SLen RsaPssSaltAuto finds the salt at the 0x01 that ends
  the padding }
function EmsaPssVerify(const MHash: string; Em: string; EmBits, SLen: Integer; Hash: Integer): Boolean;
var
  hLen, emLen, dbLen, bitMask, psLen, i: Integer;
  h, salt, h0: string;
begin
  Result := False;
  hLen := RsaHashSize(Hash);
  emLen := (EmBits + 7) div 8;
  if emLen <> Length(Em) then
    Exit;
  { steps 1 and 2: mHash of hLen octets }
  if hLen <> Length(MHash) then
    Exit;
  { step 3 }
  if emLen < hLen + SLen + 2 then
    Exit;
  { step 4: the rightmost octet 0xbc }
  if Ord(Em[emLen]) <> $bc then
    Exit;
  { step 5: maskedDB the leftmost emLen - hLen - 1 octets, H the next hLen }
  dbLen := emLen - hLen - 1;
  h := Copy(Em, dbLen + 1, hLen);
  { step 6: the leftmost 8 emLen - emBits bits zero }
  bitMask := $ff shr (8 * emLen - EmBits);
  if (Ord(Em[1]) and (not bitMask) and $ff) <> 0 then
    Exit;
  { steps 7 and 8: DB = maskedDB xor MGF(H, emLen - hLen - 1) }
  Mgf1Xor(Em, 1, dbLen, Hash, h);
  { step 9 }
  Em[1] := Chr(Ord(Em[1]) and bitMask);
  { an unknown salt length: the place of the 0x01 delimiter }
  if SLen = RsaPssSaltAuto then
  begin
    psLen := -1;
    for i := 1 to dbLen do
      if Em[i] = #1 then
      begin
        psLen := i - 1;
        Break;
      end;
    if psLen < 0 then
      Exit;
    SLen := dbLen - psLen - 1;
  end;
  { step 10: emLen - hLen - sLen - 2 zero octets, then 0x01 }
  psLen := emLen - hLen - SLen - 2;
  for i := 1 to psLen do
    if Em[i] <> #0 then
      Exit;
  if Em[psLen + 1] <> #1 then
    Exit;
  { step 11: the salt the last sLen octets of DB }
  salt := Copy(Em, dbLen - SLen + 1, SLen);
  { steps 12 and 13: H' = Hash(8 zero octets || mHash || salt) }
  h0 := RsaHash(Hash, StringOfChar(#0, 8) + MHash + salt);
  { step 14 }
  Result := h0 = h;
end;

{ verifyPSS }
function RsaKeyVerifyPss(const Key: TRsaPublicKey; Hash: Integer; const Hashed, Sig: string; SaltLen: Integer): Boolean;
var
  em: string;
  emBits, emLen, skip: Integer;
begin
  Result := False;
  if Key.E = 0 then
    Exit;
  if RsaHashSize(Hash) < 0 then
    Exit;
  { crypto/rsa VerifyPSS: PSSSaltLengthEqualsHash is the digest's size }
  if SaltLen = RsaPssSaltEqualsHash then
    SaltLen := RsaHashSize(Hash);
  { VerifyPSSWithSaltLength: the salt length cannot be negative }
  if SaltLen < RsaPssSaltAuto then
    Exit;
  if Length(Sig) <> RsaPublicKeySize(Key) then
    Exit;
  emBits := ModulusBitLen(Key.N) - 1;
  emLen := (emBits + 7) div 8;
  if not RsaPublicOp(Key, Sig, em) then
    Exit;
  { an EM one octet shorter than k when modBits - 1 is a multiple of 8:
    the leading octet must be zero and is dropped }
  skip := 0;
  while (Length(em) - skip > emLen) and (Length(em) - skip > 0) do
  begin
    if em[skip + 1] <> #0 then
      Exit;
    Inc(skip);
  end;
  if skip > 0 then
    em := Copy(em, skip + 1, Length(em) - skip);
  Result := EmsaPssVerify(Hashed, em, emBits, SaltLen, Hash);
end;

function RsaVerifyPkcs1v15(const N: string; E: Integer; Hash: Integer; const Hashed, Sig: string): Boolean;
var
  key: TRsaPublicKey;
begin
  Result := False;
  if (Hash <> RsaHashNone) and (Length(Hashed) <> RsaHashSize(Hash)) then
    Exit;
  if not RsaPublicKeyInit(key, N, E) then
    Exit;
  Result := RsaKeyVerifyPkcs1v15(key, Hash, Hashed, Sig);
end;

function RsaVerifyPss(const N: string; E: Integer; Hash: Integer; const Hashed, Sig: string; SaltLen: Integer): Boolean;
var
  key: TRsaPublicKey;
begin
  Result := False;
  if not RsaPublicKeyInit(key, N, E) then
    Exit;
  Result := RsaKeyVerifyPss(key, Hash, Hashed, Sig, SaltLen);
end;

{ ---- the private key (fips140/rsa rsa.go) ---- }

{ SubOne: X := X - 1 mod M, X of M's length. Sub asks for a reduced X
  and SubOne is given M itself; with Y = 1 it works, as Go notes }
procedure NatSubOne(var X: TNat; const M: TModulus);
var
  one: TNat;
begin
  NatResetFor(one, M);
  one.Limbs[0] := 1;
  NatSub(X, one, M);
end;

{ 1 when A * B = C as whole numbers, else 0, in constant time: the
  product worked out a row at a time and compared limb by limb. A, B
  and C carry no leading zero limbs (they are moduli) }
function NatProductIs(const A, B, C: TNat): Integer;
var
  t: TNat;
  la, lb, lc, i, eq: Integer;
begin
  la := Length(A.Limbs);
  lb := Length(B.Limbs);
  lc := Length(C.Limbs);
  if (la = 0) or (lb = 0) or (lc > la + lb) then
    Exit(0);
  NatReset(t, la + lb);
  for i := 0 to lb - 1 do
    t.Limbs[la + i] := AddMulVVW(@t.Limbs[i], @A.Limbs[0], la, B.Limbs[i]);
  eq := 1;
  for i := 0 to lc - 1 do
    eq := eq and CtEq(t.Limbs[i], C.Limbs[i]);
  for i := lc to la + lb - 1 do
    eq := eq and CtEq(t.Limbs[i], 0);
  Result := eq;
end;

{ B without its leading zero bytes: a key file's integers carry one
  when their top bit is set, and setBytes refuses bytes past the limbs.
  How long a number is, a key's file already says }
function DropZeros(const B: string): string;
var
  i: Integer;
begin
  i := 1;
  while (i < Length(B)) and (B[i] = #0) do
    Inc(i);
  Result := Copy(B, i, Length(B) - i + 1);
end;

{ Key holds nothing: what it held is let go, not written over, since a
  copy of the key may share it, and the two exponents may still be the
  strings the caller gave. A key that is refused is left so }
procedure KeyDrop(var Key: TRsaPrivateKey);
begin
  Key := Default(TRsaPrivateKey);
end;

{ X zeroed where it lies }
procedure NatWipe(var X: TNat);
var
  i: Integer;
begin
  for i := 0 to Length(X.Limbs) - 1 do
    X.Limbs[i] := 0;
end;

{ the bytes of S zeroed where they lie. Only for a string this unit
  made itself (NatBytes): a string is otherwise not written through }
procedure StrWipe(var S: string);
var
  b: PByte;
begin
  if S <> '' then
  begin
    b := PByte(Pointer(S));
    FillChar(b^, Length(S), 0);
  end;
end;

procedure RsaPrivateKeyClear(var Key: TRsaPrivateKey);
begin
  { a key that is Ready holds only numbers made here: CheckPrivateKey
    left the two exponents as NatBytes wrote them }
  if Key.Ready then
  begin
    NatWipe(Key.D);
    NatWipe(Key.QInv);
    NatWipe(Key.P.Nat);
    NatWipe(Key.P.RR);
    NatWipe(Key.Q.Nat);
    NatWipe(Key.Q.RR);
    StrWipe(Key.DP);
    StrWipe(Key.DQ);
  end;
  KeyDrop(Key);
end;

{ the modulus M - 1 of an odd modulus M above two }
function ModulusLessOne(var Res: TModulus; const M: TModulus): Boolean;
var
  t: TNat;
begin
  ModulusNat(t, M);
  NatSubOne(t, M);
  Result := NewModulus(Res, NatBytes(t, M));
end;

{ checkPrivateKey: every relation between the parts of a key of two
  primes, each compared in constant time; only which check failed, and
  the sizes of p - q and of d, are let out, as Go lets them. The two
  exponents are left at the sizes of p - 1 and q - 1 }
function CheckPrivateKey(var Key: TRsaPrivateKey; out Err: string): Boolean;
var
  pm1, qm1: TModulus;
  t, cp, cq, de, qp, diff: TNat;
begin
  Result := False;
  { bigmod's Exp asks for an odd modulus, and a prime above two is odd:
    Go refuses an even p in newPrivateKey }
  if not (Key.P.OddModulus and Key.Q.OddModulus) then
  begin
    Err := 'crypto/rsa: invalid prime';
    Exit;
  end;
  { p * q = n. Go compares modulo n, which also takes a p * q of twice
    or three times n and leaves it to the check of each result }
  if NatProductIs(Key.P.Nat, Key.Q.Nat, Key.Pub.N.Nat) <> 1 then
  begin
    Err := 'crypto/rsa: p * q != n';
    Exit;
  end;
  { d * e = 1 mod p - 1 and mod q - 1: e is then coprime to both, and
    a^(d * e) = a mod n for every a coprime to n. This checks dP, dQ
    and e }
  if not (ModulusLessOne(pm1, Key.P) and ModulusLessOne(qm1, Key.Q)) then
  begin
    Err := 'crypto/rsa: invalid prime';
    Exit;
  end;
  if not (NatSetBytes(cp, Key.DP, pm1) and NatSetBytes(cq, Key.DQ, qm1)) then
  begin
    Err := 'crypto/rsa: invalid CRT exponent';
    Exit;
  end;
  NatSetUint(de, Key.Pub.E);
  if not NatExpandFor(de, pm1) then
    Exit;
  NatMul(de, cp, pm1);
  if NatIsOne(de) <> 1 then
  begin
    Err := 'crypto/rsa: invalid CRT exponent';
    Exit;
  end;
  NatSetUint(de, Key.Pub.E);
  if not NatExpandFor(de, qm1) then
    Exit;
  NatMul(de, cq, qm1);
  if NatIsOne(de) <> 1 then
  begin
    Err := 'crypto/rsa: invalid CRT exponent';
    Exit;
  end;
  { qInv * q = 1 mod p }
  NatMod(qp, Key.Q.Nat, Key.P);
  NatMul(qp, Key.QInv, Key.P);
  if NatIsOne(qp) <> 1 then
  begin
    Err := 'crypto/rsa: invalid CRT coefficient';
    Exit;
  end;
  { d against dP and dQ: d is never used, but the key must agree with
    itself }
  NatMod(t, Key.D, pm1);
  if NatEqual(t, cp) <> 1 then
  begin
    Err := 'crypto/rsa: d does not match dP';
    Exit;
  end;
  NatMod(t, Key.D, qm1);
  if NatEqual(t, cq) <> 1 then
  begin
    Err := 'crypto/rsa: d does not match dQ';
    Exit;
  end;
  { |p - q| > 2^(nlen / 2 - 100): closer primes fall to Fermat's method
    (Böck, Fermat Factorization in the Wild, eprint 2023/026). 0 - x
    mod m is m - x }
  if NatSetBytes(qp, NatBytes(Key.Q.Nat, Key.Q), Key.P) then
  begin
    NatResetFor(diff, Key.P);
    NatSub(diff, qp, Key.P);
  end
  else if NatSetBytes(qp, NatBytes(Key.P.Nat, Key.P), Key.Q) then
  begin
    NatResetFor(diff, Key.Q);
    NatSub(diff, qp, Key.Q);
  end
  else
  begin
    Err := 'crypto/rsa: p == q';
    Exit;
  end;
  if NatBitLenVarTime(diff) <= ModulusBitLen(Key.Pub.N) div 2 - 100 then
  begin
    Err := 'crypto/rsa: |p - q| too small';
    Exit;
  end;
  { d > 2^(nlen / 2): a small d is found from n and e (Boneh, Twenty
    Years of Attacks on the RSA Cryptosystem, section 3) }
  if NatBitLenVarTime(Key.D) <= ModulusBitLen(Key.Pub.N) div 2 then
  begin
    Err := 'crypto/rsa: d too small';
    Exit;
  end;
  Key.DP := NatBytes(cp, pm1);
  Key.DQ := NatBytes(cq, qm1);
  Result := True;
end;

{ the parts every private key has: the public half, the primes and d }
function KeyParts(var Key: TRsaPrivateKey; const N: string; E: Integer;
  const D, P, Q: string; out Err: string): Boolean;
begin
  Result := False;
  KeyDrop(Key);
  if not PublicKeyInitErr(Key.Pub, N, E, Err) then
  begin
    KeyDrop(Key);
    Exit;
  end;
  if not (NewModulus(Key.P, P) and NewModulus(Key.Q, Q)) then
  begin
    Err := 'crypto/rsa: invalid prime';
    KeyDrop(Key);
    Exit;
  end;
  if not NatSetBytes(Key.D, DropZeros(D), Key.Pub.N) then
  begin
    Err := 'crypto/rsa: invalid private exponent';
    KeyDrop(Key);
    Exit;
  end;
  Result := True;
end;

{ newPrivateKey: dP = d mod (p - 1), dQ = d mod (q - 1), and qInv by
  Fermat's little theorem, q^(p - 2) mod p, an inversion in constant
  time for a prime p }
function RsaPrivateKeyInit(var Key: TRsaPrivateKey; const N: string; E: Integer;
  const D, P, Q: string; out Err: string): Boolean;
var
  pm1, qm1: TModulus;
  t, qp: TNat;
begin
  Result := False;
  if not KeyParts(Key, N, E, D, P, Q, Err) then
    Exit;
  if not (Key.P.OddModulus and Key.Q.OddModulus and ModulusLessOne(pm1, Key.P) and
    ModulusLessOne(qm1, Key.Q)) then
  begin
    Err := 'crypto/rsa: invalid prime';
    KeyDrop(Key);
    Exit;
  end;
  NatMod(t, Key.D, pm1);
  Key.DP := NatBytes(t, pm1);
  NatMod(t, Key.D, qm1);
  Key.DQ := NatBytes(t, qm1);
  ModulusNat(t, Key.P);
  NatSubOne(t, Key.P);
  NatSubOne(t, Key.P);
  NatMod(qp, Key.Q.Nat, Key.P);
  NatExp(Key.QInv, qp, NatBytes(t, Key.P), Key.P);
  if not CheckPrivateKey(Key, Err) then
  begin
    KeyDrop(Key);
    Exit;
  end;
  Key.Ready := True;
  Result := True;
end;

function RsaPrivateKeyInitCrt(var Key: TRsaPrivateKey; const N: string; E: Integer;
  const D, P, Q, DP, DQ, QInv: string; out Err: string): Boolean;
begin
  Result := False;
  if not KeyParts(Key, N, E, D, P, Q, Err) then
    Exit;
  Key.DP := DropZeros(DP);
  Key.DQ := DropZeros(DQ);
  if not NatSetBytes(Key.QInv, DropZeros(QInv), Key.P) then
  begin
    Err := 'crypto/rsa: invalid CRT coefficient';
    KeyDrop(Key);
    Exit;
  end;
  if not CheckPrivateKey(Key, Err) then
  begin
    KeyDrop(Key);
    Exit;
  end;
  Key.Ready := True;
  Result := True;
end;

function RsaPrivateKeySize(const Key: TRsaPrivateKey): Integer;
begin
  Result := ModulusSize(Key.Pub.N);
end;

{ decrypt with its check: RSASP1 (RFC 8017 5.2.1) of the k bytes C by
  the Chinese remainder theorem, every step on the constant-time
  routines above; then the result raised to e and compared with C, so
  that a fault in either half never leaves as a signature (a wrong
  half and the right one give a factor of n: Boneh, DeMillo and
  Lipton). False when C is not below n or the check fails }
function PrivateOp(const Key: TRsaPrivateKey; const C: string; out M: string): Boolean;
var
  cn, m1, m2, t0, check: TNat;
begin
  M := '';
  Result := False;
  if not NatSetBytes(cn, C, Key.Pub.N) then
    Exit;
  { m1 = c^dP mod p }
  NatMod(t0, cn, Key.P);
  NatExp(m1, t0, Key.DP, Key.P);
  { m2 = c^dQ mod q }
  NatMod(t0, cn, Key.Q);
  NatExp(m2, t0, Key.DQ, Key.Q);
  { m1 = (m1 - m2) * qInv mod p }
  NatMod(t0, m2, Key.P);
  NatSub(m1, t0, Key.P);
  NatMul(m1, Key.QInv, Key.P);
  { m1 = m1 * q + m2 mod n }
  if not NatExpandFor(m1, Key.Pub.N) then
    Exit;
  NatMod(t0, Key.Q.Nat, Key.Pub.N);
  NatMul(m1, t0, Key.Pub.N);
  if not NatExpandFor(m2, Key.Pub.N) then
    Exit;
  NatAdd(m1, m2, Key.Pub.N);
  { the check: m1^e = c. NatEqual compares as many limbs as its first
    number has, so the two lengths are compared first: a result that
    was never worked out is no match }
  NatExpShortVarTime(check, m1, Key.Pub.E, Key.Pub.N);
  if Length(check.Limbs) <> Length(cn.Limbs) then
    Exit;
  if NatEqual(check, cn) <> 1 then
    Exit;
  M := NatBytes(m1, Key.Pub.N);
  Result := M <> '';
end;

{ signPKCS1v15 }
function RsaSignPkcs1v15(const Key: TRsaPrivateKey; Hash: Integer; const Hashed: string; out Sig: string): Boolean;
var
  em: string;
begin
  Sig := '';
  Result := False;
  if not Key.Ready then
    Exit;
  { crypto/rsa SignPKCS1v15: the input must be a digest of the hash }
  if (Hash <> RsaHashNone) and (Length(Hashed) <> RsaHashSize(Hash)) then
    Exit;
  { RFC 8017 8.2.1 step 1: EMSA-PKCS1-v1_5 encoding of the digest }
  if not Pkcs1v15ConstructEM(RsaPublicKeySize(Key.Pub), Hash, Hashed, em) then
    Exit;
  { steps 2 to 4: RSASP1 and its k bytes }
  Result := PrivateOp(Key, em, Sig);
end;

{ ---- PSS signatures (pkcs1v22.go) ---- }

{ emsaPSSEncode (RFC 8017 9.1.1): EM of EmBits bits from the digest
  MHash and Salt; False when MHash is not a digest of Hash or the key
  is too short for the hash and the salt }
function EmsaPssEncode(const MHash, Salt: string; EmBits: Integer; Hash: Integer; out Em: string): Boolean;
var
  hLen, sLen, emLen, psLen, dbLen, i: Integer;
  h: string;
begin
  Em := '';
  Result := False;
  hLen := RsaHashSize(Hash);
  sLen := Length(Salt);
  emLen := (EmBits + 7) div 8;
  { steps 1 and 2: mHash of hLen octets }
  if (hLen < 0) or (Length(MHash) <> hLen) then
    Exit;
  { step 3 }
  if emLen < hLen + sLen + 2 then
    Exit;
  psLen := emLen - sLen - hLen - 2;
  dbLen := psLen + 1 + sLen;
  { steps 5 and 6: H = Hash(8 zero octets || mHash || salt) }
  h := RsaHash(Hash, StringOfChar(#0, 8) + MHash + Salt);
  { steps 7 and 8: DB = PS || 0x01 || salt, PS psLen zero octets }
  SetLength(Em, emLen);
  Em[psLen + 1] := #1;
  for i := 1 to sLen do
    Em[psLen + 1 + i] := Salt[i];
  { steps 9 and 10: maskedDB = DB xor MGF(H, emLen - hLen - 1) }
  Mgf1Xor(Em, 1, dbLen, Hash, h);
  { step 11: the leftmost 8 emLen - emBits bits zero }
  Em[1] := Chr(Ord(Em[1]) and ($ff shr (8 * emLen - EmBits)));
  { step 12: EM = maskedDB || H || 0xbc }
  for i := 1 to hLen do
    Em[dbLen + i] := h[i];
  Em[emLen] := Chr($bc);
  Result := True;
end;

{ N bytes of the kernel's generator, '' when it fails: getrandom with
  no flags, an interrupted call and a short read tried again, as Go's
  sysrand (rand_getrandom.go) and pasnist's key generation. The system
  call gives up its P while it waits for entropy }
function KernelRandom(N: Integer): string;
var
  nr, used, count: Integer;
begin
  Result := '';
  if N <= 0 then
    Exit;
  if Amd64 = 0 then nr := 278 else nr := 318;
  SetLength(Result, N);
  used := 0;
  while used < N do
  begin
    repeat
      count := Syscall(nr, Integer(@Result[used + 1]), N - used, 0);
    until count <> -4;
    if (count <= 0) or (count > N - used) then
    begin
      Result := '';
      Exit;
    end;
    used := used + count;
  end;
end;

function RsaSignPssSalt(const Key: TRsaPrivateKey; Hash: Integer; const Hashed, Salt: string; out Sig: string): Boolean;
var
  em: string;
begin
  Sig := '';
  Result := False;
  if not Key.Ready then
    Exit;
  { RFC 8017 8.1.1 step 1: EM of modBits - 1 bits }
  if not EmsaPssEncode(Hashed, Salt, ModulusBitLen(Key.Pub.N) - 1, Hash, em) then
    Exit;
  { step 2: RSASP1. EM is one octet shorter than k when modBits - 1 is
    a multiple of 8; Go puts a zero octet in front, and here the
    number is the same without it }
  Result := PrivateOp(Key, em, Sig);
end;

function RsaSignPss(const Key: TRsaPrivateKey; Hash: Integer; const Hashed: string; SaltLen: Integer; out Sig: string): Boolean;
var
  hLen, sLen: Integer;
  salt: string;
begin
  Sig := '';
  Result := False;
  if not Key.Ready then
    Exit;
  hLen := RsaHashSize(Hash);
  if hLen < 0 then
    Exit;
  sLen := SaltLen;
  if SaltLen = RsaPssSaltAuto then
  begin
    { PSSMaxSaltLength }
    sLen := (ModulusBitLen(Key.Pub.N) - 1 + 7) div 8 - 2 - hLen;
    if sLen < 0 then
      Exit;
  end
  else if SaltLen = RsaPssSaltEqualsHash then
    sLen := hLen
  else if SaltLen < 0 then
    Exit;
  salt := '';
  if sLen > 0 then
  begin
    salt := KernelRandom(sLen);
    if Length(salt) <> sLen then
      Exit;
  end;
  Result := RsaSignPssSalt(Key, Hash, Hashed, salt, Sig);
end;

end.
