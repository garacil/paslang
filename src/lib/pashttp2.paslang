{ An HTTP/2 client (P617): RFC 9113 over a TLS connection whose ALPN
  chose h2, or over TCP for a server known to speak it there, and HPACK,
  RFC 7541, whole: the static table, literals, the Huffman code both
  ways and the dynamic table both ways.

  One connection carries many requests at once, from any number of
  routines: THttp2Conn.Request sends one and parks until its response
  is whole, its deadline passes or the connection ends. The shape
  follows Go's client (net/http/internal/http2 of Go 1.27.4:
  transport.go's ClientConn, its readLoop and process routines, flow.go's
  windows, frame.go's checks) and its hpack package
  (golang.org/x/net/http2/hpack as that Go vendors it); what differs is
  said where it does, and these are the larger differences:

  - One mutex guards a connection, where Go has two. Frames reach the
    peer in the order they are posted, which is the order the stream
    numbers and the compression's state need (RFC 9113 5.1.1 and 4.3),
    but nobody waits for another's write: while one routine writes, what
    the others post is left for it, and a routine of the connection's
    carries on when there is more.
  - One routine reads every frame and hands each to its stream; the
    content of a response is read from the connection straight into the
    string the caller gets, and the windows are given back at half
    (5.2, 6.9), since what is read is kept within its budget and never
    waits for a reader.
  - One routine keeps every deadline, parked on an eventfd; it writes
    nothing itself, so a peer that takes nothing cannot hold a deadline
    back. It also asks a silent peer whether it is there (PING).
  - A response is checked as RFC 9113 8.1 and 8.2 say a recipient must
    (Go lets some of it by): what is malformed ends its request.

  The unit's limits are all set: a response's header fields and its
  content have a budget in octets, a request a deadline, a field block
  and a frame a largest size, a write a longest time. A redirect is an
  answer like any other: nothing is followed. Server push is refused
  (SETTINGS_ENABLE_PUSH 0). A connection is one object for any number of
  routines; nothing of it is global (Regla 11). }
unit pashttp2;

interface

uses
  sysutils, pasconn, pastls;

const
  { the error codes of RFC 9113 section 7 }
  H2NoError = 0;
  H2ProtocolError = 1;
  H2InternalError = 2;
  H2FlowControlError = 3;
  H2SettingsTimeout = 4;
  H2StreamClosed = 5;
  H2FrameSizeError = 6;
  H2RefusedStream = 7;
  H2Cancel = 8;
  H2CompressionError = 9;
  H2ConnectError = 10;
  H2EnhanceYourCalm = 11;
  H2InadequateSecurity = 12;
  H2Http11Required = 13;

type
  { one header field. Sensitive is HPACK's never-indexed literal (RFC
    7541 6.2.3 and 7.1.3): the value is sent as it is every time and
    never enters the compression's table }
  THpackField = record
    Name, Value: string;
    Sensitive: Boolean;
    { a literal that does not enter the table and is no secret (RFC
      7541 6.2.2): for a value that is not said again, which would only
      push out of the table what is }
    Once: Boolean;
  end;
  THpackFields = array of THpackField;

  { a dynamic table (RFC 7541 2.3.2 and 4): the entries, the oldest
    first; Size is the sum of their sizes (name, value and 32), MaxSize
    what it may reach now and Allowed what a size update may ask for }
  THpackTable = record
    Ents: THpackFields;
    First: Integer;
    Size, MaxSize, Allowed: Integer;
  end;

  { the decoding half of a connection's compression: one for all the
    header blocks received, in the order they came }
  THpackDecoder = record
    Tab: THpackTable;
  end;

  { the encoding half: one for all the header blocks sent, in order }
  THpackEncoder = record
    Tab: THpackTable;
    { the smallest size the table was set to since the last block, and
      whether a size update is owed at the start of the next (4.2) }
    MinSize: Integer;
    Update: Boolean;
    { no string is Huffman coded: for the examples of RFC 7541 C.3 and
      C.5, and for whoever wants the octets plain }
    NoHuffman: Boolean;
  end;

{ ---- HPACK (RFC 7541) ---- }

{ the Huffman code of S (appendix B), padded with ones to an octet;
  how many octets that is; and S back from its code: False for padding
  of eight bits or more, padding that is not ones, or EOS inside }
function HuffmanEncode(const S: string): string;
function HuffmanLength(const S: string): Integer;
function HuffmanDecode(const S: string; out Res: string): Boolean;

{ a decoder whose table may hold Allowed octets, what this end said in
  SETTINGS_HEADER_TABLE_SIZE (4096 when it said nothing) }
procedure HpackDecoderInit(var D: THpackDecoder; Allowed: Integer);
{ the fields of one whole header block, added to Fields while their
  sizes (name, value and 32 each) fit in Budget octets; the rest are
  decoded, for the table must follow, and dropped, and TooLarge says
  so. False with the reason in Err for a block that is not HPACK: the
  connection's compression is then lost (RFC 9113 4.3) }
function HpackDecode(var D: THpackDecoder; const Block: string; Budget: Integer; var Fields: THpackFields;
  out TooLarge: Boolean; out Err: string): Boolean;

procedure HpackEncoderInit(var E: THpackEncoder);
{ the peer's SETTINGS_HEADER_TABLE_SIZE: the table uses at most 4096
  octets of it, and the next block says its new size }
procedure HpackEncoderLimit(var E: THpackEncoder; PeerSize: Integer);
{ one header block for Fields, in order: a field the tables hold is an
  index, another a literal that enters the table unless it is Sensitive
  or larger than the table, its strings Huffman coded when shorter }
function HpackEncode(var E: THpackEncoder; const Fields: THpackFields): string;

{ a field; Http2Field marks authorization, proxy-authorization, cookie
  and set-cookie Sensitive, as RFC 7541 7.1.3 advises for values an
  attacker who can add fields to the same connection could guess a
  piece at a time. Http2FieldIndexed never does: for a connection all
  of whose fields are one's own, where a token sent with every request
  is then sent once }
function Http2Field(const Name, Value: string): THpackField;
function Http2FieldIndexed(const Name, Value: string): THpackField;
{ a field whose value is not said again, as an identifier made for one
  request: it is written out and stays out of the table }
function Http2FieldOnce(const Name, Value: string): THpackField;
{ the value of the first field of that name (in lower case), '' when
  there is none }
function Http2Get(const Fields: THpackFields; const Name: string): string;

{ ---- the connection (RFC 9113) ---- }

type
  { what a connection is given when it is made; a field left at 0 takes
    the value said beside it }
  THttp2Options = record
    { a response's header fields may take this many octets, their names,
      their values and 32 for each: 1 MiB. The peer is told
      (SETTINGS_MAX_HEADER_LIST_SIZE) }
    MaxHeaderBytes: Integer;
    { a response's content may take this many octets when its request
      gives no budget of its own: 64 MiB }
    MaxBodyBytes: Integer;
    { how long one write to the peer may wait, in milliseconds: 30000.
      A peer that takes nothing for that long has lost the connection }
    WriteTimeoutMs: Integer;
    { how long the answer to a PING may take: 15000 (Go's PingTimeout) }
    PingTimeoutMs: Integer;
    { when nothing has come from the peer for this long a PING asks
      whether it is there, and the connection ends when no answer comes
      in PingTimeoutMs. 0 never asks (Go's ReadIdleTimeout, 0 too): set
      it on a connection that is kept for hours, which a network may
      drop without a word }
    ReadIdleMs: Integer;
  end;

  { A response: its status, its header fields without :status, its
    content whole, and its trailer fields when it sent some.

    When the request failed: NotProcessed says it never reached the
    server's handling, for the connection ended or was going away
    before it, or the server refused the stream (REFUSED_STREAM); it
    may then be sent again on another connection whatever its method
    (RFC 9113 8.7). TimedOut says its deadline passed. ErrorCode is the
    code of the server's RST_STREAM or GOAWAY, -1 when it sent neither.
    Status and Fields are there when the header fields came before the
    failure }
  THttp2Response = record
    Status: Integer;
    Fields: THpackFields;
    Body: string;
    Trailers: THpackFields;
    NotProcessed: Boolean;
    TimedOut: Boolean;
    ErrorCode: Integer;
  end;

  { one request and its response on their way: the connection's own }
  TH2Stream = class
  public
    Id: Integer;
    SendWindow, RecvWindow, RecvUnacked: Integer;
    Deadline, TimeoutMs, TimedAt: Integer;
    MaxBody, WantLength, Received, InterimBytes, ReadMark: Integer;
    Status: Integer;
    Fields, Trailers: THpackFields;
    { the content received: the first Received octets of Buf }
    Buf: string;
    HasSlot, IsHead, GotHeaders, Ended, Ok, TimedOut, Refused, AskPeer: Boolean;
    ErrorCode: Integer;
    Err: string;
    PingData: string;
    Wake: cond;
  end;
  TH2Streams = array of TH2Stream;

  { A connection. Http2Dial makes one over TLS; Create makes one over a
    stream that already speaks HTTP/2, as a TCP connection to a server
    known to (prior knowledge, RFC 9113 3.3).

    Any number of routines call Request at once: each parks until its
    response is whole. The connection keeps routines of its own, one
    that reads and one that keeps the deadlines, until Dispose or until
    the connection ends: a program that is done with a connection calls
    Dispose, which also gives its descriptors back; a connection that
    ended by itself has given them back already. }
  THttp2Conn = class
  private
    FStream: TNetStream;
    FScheme, FAuthority: string;
    FOpt: THttp2Options;
    { FMu guards every field below but those the reading routine keeps
      for itself, which are said }
    FMu: mutex;
    { parked here: who waits for a place among the streams, for a window
      to open, for what is pending to be written }
    FCond: cond;
    FStreams: map[Integer] of TH2Stream;
    FTimed: TH2Streams;
    FTimedN: Integer;
    FPings: TH2Streams;
    FNextId, FActive, FPendingResets: Integer;
    FEnc: THpackEncoder;
    FLastPath: string;
    FSendWindow, FRecvWindow, FRecvUnacked: Integer;
    FPeerInitialWindow, FPeerMaxFrame, FPeerMaxStreams, FPeerMaxHeaderList: Integer;
    FClosed, FBroken, FTornDown, FUserClosed: Boolean;
    { a write failed: nothing more is written, and the connection ends at
      FFailDue for FFailWhy unless the reading routine ends it before }
    FWriteBroken: Boolean;
    FFailDue: Integer;
    FFailWhy: string;
    FGotSettings, FSettingsAcked: Boolean;
    FGoAway: Boolean;
    { the last stream number there is was given out (5.1.1) }
    FSpent: Boolean;
    FGoAwayLast, FGoAwayCode: Integer;
    FGoAwayDebug: string;
    FErr: string;
    { what is to be written while another routine writes, and whether
      one does }
    FOut: TStringBuilder;
    FWBusy: Boolean;
    { the routine of the deadlines: its eventfd, what it is parked until }
    FTimerFd, FTimerNext: Integer;
    FHealthDue: Integer;
    FHealthData: string;
    FPingSeq: Integer;
    FReadCount, FLastRead: Integer;
    FConnErr: Integer;
    FWhy: string;
    FWg: waitgroup;
    { the reading routine's own: what it has read and not yet parsed
      (FIn from FInPos to before FInEnd), the field block it is in the
      middle of, the frames it owes the peer }
    FIn: string;
    FInPos, FInEnd: Integer;
    FGotFrame: Boolean;
    FDec: THpackDecoder;
    FContId, FContFlags: Integer;
    FContFirst: string;
    FContMore: TStringBuilder;
    FOwed: string;
    function Raw(const Frames: string): Boolean;
    procedure WriteFailed;
    procedure WriteNow(const Frames: string);
    procedure WriteContent(S: TH2Stream; const Body: string; Offset, N: Integer; Last: Boolean);
    procedure WriteDone;
    procedure Flusher;
    procedure Post(const Frames: string; Direct: Boolean);
    procedure Owe;
    procedure Fail(const Why: string; Broken: Boolean);
    procedure Finish(S: TH2Stream);
    procedure Watch(S: TH2Stream);
    procedure Unwatch(S: TH2Stream);
    procedure Arm(Due: Integer);
    procedure Poke;
    procedure HealthPing;
    function Credit(S: TH2Stream; Want: Integer): Integer;
    function GoAwayText: string;
    function ReadWhy(R: Integer): string;
    function Fill(Need: Integer): Integer;
    function ReadBytes(N: Integer; out Data: string): Integer;
    function ReadTo(var Dest: string; Offset, N: Integer): Integer;
    function Skip(N: Integer): Integer;
    function ReadHead(out Typ, Flags, Id, N: Integer): Integer;
    function Before(Typ, Flags, Id: Integer; const Payload: string; out Data: string; out Whole: Boolean;
      out All: THpackFields; out TooLarge: Boolean): Integer;
    procedure ConnError(Code: Integer; const Why: string);
    procedure StreamError(S: TH2Stream; Id, Code: Integer; const Why: string);
    procedure GiveBack(S: TH2Stream; N: Integer);
    procedure EndOfStream(S: TH2Stream);
    procedure OnHeaders(Id: Integer; EndStream: Boolean; const All: THpackFields; TooLarge: Boolean);
    function DataBegin(Id, N, Counted: Integer): TH2Stream;
    procedure DataEnd(S: TH2Stream; N, Counted: Integer; EndStream: Boolean);
    procedure OnData(Id: Integer; EndStream: Boolean; const Data: string; Counted: Integer);
    procedure OnSettings(Flags, Id: Integer; const Payload: string);
    procedure OnRst(Id: Integer; const Payload: string);
    procedure OnPing(Flags, Id: Integer; const Payload: string);
    procedure OnGoAway(Id: Integer; const Payload: string);
    procedure OnWindowUpdate(Id: Integer; const Payload: string);
    procedure OnPriority(Id: Integer; const Payload: string);
    function SendErrorGoAway: Boolean;
    function Step: Boolean;
    procedure ReadLoop;
    procedure TimerLoop;
  public
    { the connection begins on Stream, which is the connection's from
      now on: the preface and SETTINGS are written (3.4). AScheme and
      AAuthority are what every request's :scheme and :authority say.
      A connection that could not begin is ended at once: Alive says
      so and LastError why }
    constructor Create(Stream: TNetStream; const AScheme, AAuthority: string; const Options: THttp2Options);
    { One request and its response. Headers are the fields after the
      pseudo-header fields, their names in lower case; content-length
      is written from Body, and a field that belongs to an HTTP/1.1
      connection (connection, host, transfer-encoding and their like) is
      refused with its reason, for HTTP/2 has no place for it (8.2.2).

      The call parks until the response is whole and gives True, or
      gives False with the reason in Err: the request is not well
      formed; TimeoutMs milliseconds passed (0 is no deadline); the
      response's content is past MaxBody octets (0 is the connection's
      budget); the stream or the connection ended; the response was
      malformed. A response is a response whatever its status, and a
      redirect is not followed. A request whose own write the peer
      does not take can run past its deadline, by the connection's
      WriteTimeoutMs at most }
    function Request(const Method, Path: string; const Headers: THpackFields; const Body: string;
      TimeoutMs, MaxBody: Integer; out Resp: THttp2Response; out Err: string): Boolean;
    { a PING and its answer within TimeoutMs (0 waits as long as the
      connection lasts): the peer is there }
    function Ping(TimeoutMs: Integer): Boolean;
    { GOAWAY to the peer, the requests on their way fail, and the
      connection ends: its routines are waited for and its descriptors
      given back. More than once does no harm }
    procedure Dispose;
    { it takes new requests: it has not ended, the peer has not said
      GOAWAY, and it has stream numbers left }
    function Alive: Boolean;
    { why it ended, '' while it has not }
    function LastError: string;
    { the additional data of the peer's GOAWAY, where a server says its
      reason (APNs writes one in JSON); '' when it sent none }
    function GoAwayData: string;
    { the requests on their way, and how many the peer lets be at once }
    function Streams: Integer;
    function PeerMaxStreams: Integer;
  end;

  { a connection being made, and what came of it: the client's own }
  TH2Dial = class
  public
    Finished: chan of Integer;
    Conn: THttp2Conn;
    Err: string;
  end;

  { A client of one server that keeps one connection and makes another
    when that one has ended or is going away: for a long-lived
    connection that carries many requests, as a push service asks. A
    request the server did not act on (NotProcessed) is sent once more,
    on a new connection when the first has ended. Any number of
    routines use one client at once.

    A connection is made by a routine of the client's, once for all the
    requests that wait for it: each waits within its own deadline, and
    what comes of the connection, made or not, is the answer for all of
    them }
  THttp2Client = class
  private
    FMu: mutex;
    FConn: THttp2Conn;
    FHost: string;
    FPort: Integer;
    FConfig: TTlsConfig;
    FOptions: THttp2Options;
    FDials: Integer;
    { the connection being made, nil when none is; FEpoch is raised by
      Dispose, and a connection begun before it is not kept }
    FDial: TH2Dial;
    FEpoch: Integer;
    procedure Dialer(D: TH2Dial; Epoch: Integer);
    function Conn(Due: Integer; out Err: string; out Late: Boolean): THttp2Conn;
  public
    { how long making a connection may take, in milliseconds (10000) }
    ConnectTimeoutMs: Integer;
    { no TLS: HTTP/2 straight on TCP, for a server known to take it
      (prior knowledge, RFC 9113 3.3). Set before the first request }
    Plain: Boolean;
    { Config may be nil; what it says of ALPN is not looked at }
    constructor Create(const Host: string; Port: Integer; Config: TTlsConfig; const Options: THttp2Options);
    { as THttp2Conn.Request. TimeoutMs covers the wait for a connection
      too: a request does not wait for one past its own deadline, and
      the connection goes on being made for the requests that can wait }
    function Request(const Method, Path: string; const Headers: THpackFields; const Body: string;
      TimeoutMs, MaxBody: Integer; out Resp: THttp2Response; out Err: string): Boolean;
    { how many connections it has made }
    function Dials: Integer;
    { the connection it holds is disposed of, and one that is being made
      is not kept; a later request makes another }
    procedure Dispose;
  end;

{ a TLS connection to Host:Port that offers h2 by ALPN (RFC 9113 3.2),
  made within ConnectMs milliseconds; nil with Err when it cannot be
  made or the server does not choose h2. Config may be nil, and what it
  says of ALPN is not looked at }
function Http2Dial(const Host: string; Port, ConnectMs: Integer; Config: TTlsConfig; const Options: THttp2Options;
  out Err: string): THttp2Conn;
{ the same on TCP without TLS, for a server known to speak HTTP/2 there
  (prior knowledge, RFC 9113 3.3) }
function Http2DialPlain(const Host: string; Port, ConnectMs: Integer; const Options: THttp2Options;
  out Err: string): THttp2Conn;
{ the name of an error code of RFC 9113 section 7 }
function Http2ErrorName(Code: Integer): string;
{ what :authority says of Host and Port, as the two calls above write
  it: the port left out when it is the scheme's own, 443 with TLS and 80
  without, and an IPv6 address in its brackets (RFC 3986 3.2) }
function Http2Authority(const Host: string; Port: Integer; Tls: Boolean): string;

implementation

{ hpack tables: written by scripts/hpack_tables.py from RFC 7541, appendices A and B }
const
  { the static table (appendix A): names and values, from 1 }
  HpackStaticLen = 61;
  HpackStaticName: array[1..61] of string = (
    ':authority', ':method', ':method', ':path',
    ':path', ':scheme', ':scheme', ':status',
    ':status', ':status', ':status', ':status',
    ':status', ':status', 'accept-charset', 'accept-encoding',
    'accept-language', 'accept-ranges', 'accept', 'access-control-allow-origin',
    'age', 'allow', 'authorization', 'cache-control',
    'content-disposition', 'content-encoding', 'content-language', 'content-length',
    'content-location', 'content-range', 'content-type', 'cookie',
    'date', 'etag', 'expect', 'expires',
    'from', 'host', 'if-match', 'if-modified-since',
    'if-none-match', 'if-range', 'if-unmodified-since', 'last-modified',
    'link', 'location', 'max-forwards', 'proxy-authenticate',
    'proxy-authorization', 'range', 'referer', 'refresh',
    'retry-after', 'server', 'set-cookie', 'strict-transport-security',
    'transfer-encoding', 'user-agent', 'vary', 'via',
    'www-authenticate');
  HpackStaticValue: array[1..61] of string = (
    '', 'GET', 'POST', '/',
    '/index.html', 'http', 'https', '200',
    '204', '206', '304', '400',
    '404', '500', '', 'gzip, deflate',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '', '', '', '',
    '');
  { the Huffman code (appendix B): each octet's code, its last bit the
    lowest, and its length in bits; EOS is thirty ones }
  HuffCode: array[0..255] of Integer = (
    $1ff8, $7fffd8, $fffffe2, $fffffe3, $fffffe4, $fffffe5, $fffffe6, $fffffe7,
    $fffffe8, $ffffea, $3ffffffc, $fffffe9, $fffffea, $3ffffffd, $fffffeb, $fffffec,
    $fffffed, $fffffee, $fffffef, $ffffff0, $ffffff1, $ffffff2, $3ffffffe, $ffffff3,
    $ffffff4, $ffffff5, $ffffff6, $ffffff7, $ffffff8, $ffffff9, $ffffffa, $ffffffb,
    $14, $3f8, $3f9, $ffa, $1ff9, $15, $f8, $7fa,
    $3fa, $3fb, $f9, $7fb, $fa, $16, $17, $18,
    $0, $1, $2, $19, $1a, $1b, $1c, $1d,
    $1e, $1f, $5c, $fb, $7ffc, $20, $ffb, $3fc,
    $1ffa, $21, $5d, $5e, $5f, $60, $61, $62,
    $63, $64, $65, $66, $67, $68, $69, $6a,
    $6b, $6c, $6d, $6e, $6f, $70, $71, $72,
    $fc, $73, $fd, $1ffb, $7fff0, $1ffc, $3ffc, $22,
    $7ffd, $3, $23, $4, $24, $5, $25, $26,
    $27, $6, $74, $75, $28, $29, $2a, $7,
    $2b, $76, $2c, $8, $9, $2d, $77, $78,
    $79, $7a, $7b, $7ffe, $7fc, $3ffd, $1ffd, $ffffffc,
    $fffe6, $3fffd2, $fffe7, $fffe8, $3fffd3, $3fffd4, $3fffd5, $7fffd9,
    $3fffd6, $7fffda, $7fffdb, $7fffdc, $7fffdd, $7fffde, $ffffeb, $7fffdf,
    $ffffec, $ffffed, $3fffd7, $7fffe0, $ffffee, $7fffe1, $7fffe2, $7fffe3,
    $7fffe4, $1fffdc, $3fffd8, $7fffe5, $3fffd9, $7fffe6, $7fffe7, $ffffef,
    $3fffda, $1fffdd, $fffe9, $3fffdb, $3fffdc, $7fffe8, $7fffe9, $1fffde,
    $7fffea, $3fffdd, $3fffde, $fffff0, $1fffdf, $3fffdf, $7fffeb, $7fffec,
    $1fffe0, $1fffe1, $3fffe0, $1fffe2, $7fffed, $3fffe1, $7fffee, $7fffef,
    $fffea, $3fffe2, $3fffe3, $3fffe4, $7ffff0, $3fffe5, $3fffe6, $7ffff1,
    $3ffffe0, $3ffffe1, $fffeb, $7fff1, $3fffe7, $7ffff2, $3fffe8, $1ffffec,
    $3ffffe2, $3ffffe3, $3ffffe4, $7ffffde, $7ffffdf, $3ffffe5, $fffff1, $1ffffed,
    $7fff2, $1fffe3, $3ffffe6, $7ffffe0, $7ffffe1, $3ffffe7, $7ffffe2, $fffff2,
    $1fffe4, $1fffe5, $3ffffe8, $3ffffe9, $ffffffd, $7ffffe3, $7ffffe4, $7ffffe5,
    $fffec, $fffff3, $fffed, $1fffe6, $3fffe9, $1fffe7, $1fffe8, $7ffff3,
    $3fffea, $3fffeb, $1ffffee, $1ffffef, $fffff4, $fffff5, $3ffffea, $7ffff4,
    $3ffffeb, $7ffffe6, $3ffffec, $3ffffed, $7ffffe7, $7ffffe8, $7ffffe9, $7ffffea,
