{ ---- Huffman (RFC 7541 5.2 and appendix B) ---- }

function HuffmanLength(const S: string): Integer;
var
  i, bits: Integer;
begin
  bits := 0;
  for i := 1 to Length(S) do
    bits := bits + HuffBits[Ord(S[i])];
  Result := (bits + 7) div 8;
end;

function HuffmanEncode(const S: string): string;
var
  i, n, acc, have, code, width, p: Integer;
begin
  Result := '';
  n := HuffmanLength(S);
  if n = 0 then
    Exit;
  SetLength(Result, n);
  acc := 0;
  have := 0;
  p := 1;
  for i := 1 to Length(S) do
  begin
    code := HuffCode[Ord(S[i])];
    width := HuffBits[Ord(S[i])];
    { a code is 30 bits at most and at most 7 wait: 37 bits in a word }
    acc := (acc shl width) or code;
    have := have + width;
    while have >= 8 do
    begin
      have := have - 8;
      Result[p] := Chr((acc shr have) and 255);
      Inc(p);
    end;
    acc := acc and ((1 shl have) - 1);
  end;
  { the bits left over, then ones: the first bits of EOS }
  if have > 0 then
    Result[p] := Chr(((acc shl (8 - have)) or ((1 shl (8 - have)) - 1)) and 255);
end;

function HuffmanDecode(const S: string; out Res: string): Boolean;
var
  i, state, step, b, n: Integer;
  mayEnd: Boolean;
begin
  Res := '';
  Result := False;
  { a code is five bits at least: eight octets give at most twelve }
  SetLength(Res, (Length(S) * 8) div 5 + 1);
  n := 0;
  state := 0;
  mayEnd := True;
  for i := 1 to Length(S) do
  begin
    b := Ord(S[i]);
    step := HuffStep[state * 16 + (b shr 4)];
    if (step and $40000) <> 0 then
    begin
      Res := '';
      Exit;
    end;
    if (step and $10000) <> 0 then
    begin
      Inc(n);
      Res[n] := Chr((step shr 8) and 255);
    end;
    state := step and 255;
    step := HuffStep[state * 16 + (b and 15)];
    if (step and $40000) <> 0 then
    begin
      Res := '';
      Exit;
    end;
    if (step and $10000) <> 0 then
    begin
      Inc(n);
      Res[n] := Chr((step shr 8) and 255);
    end;
    state := step and 255;
    mayEnd := (step and $20000) <> 0;
  end;
  if not mayEnd then
  begin
    Res := '';
    Exit;
  end;
  SetLength(Res, n);
  Result := True;
end;

{ ---- the dynamic table (RFC 7541 2.3.2 and 4) ---- }

function FieldSize(const F: THpackField): Integer;
begin
  Result := Length(F.Name) + Length(F.Value) + 32;
end;

function TableLen(const T: THpackTable): Integer;
begin
  Result := Length(T.Ents) - T.First;
end;

{ 4.3 and 4.4: the oldest entries go until the table fits }
procedure TableEvict(var T: THpackTable);
var
  i, n: Integer;
begin
  while (T.Size > T.MaxSize) and (T.First < Length(T.Ents)) do
  begin
    T.Size := T.Size - FieldSize(T.Ents[T.First]);
    T.Ents[T.First].Name := '';
    T.Ents[T.First].Value := '';
    Inc(T.First);
  end;
  { the room the evicted ones held, given back when it is half the array }
  if (T.First > 32) and (T.First * 2 > Length(T.Ents)) then
  begin
    n := Length(T.Ents) - T.First;
    for i := 0 to n - 1 do
      T.Ents[i] := T.Ents[T.First + i];
    SetLength(T.Ents, n);
    T.First := 0;
  end;
end;

procedure TableSetMax(var T: THpackTable; V: Integer);
begin
  T.MaxSize := V;
  TableEvict(T);
end;

{ 4.4: an entry larger than the table empties it and is not kept }
procedure TableAdd(var T: THpackTable; const F: THpackField);
var
  kept: THpackField;
begin
  kept.Name := F.Name;
  kept.Value := F.Value;
  kept.Sensitive := False;
  T.Ents := Append(T.Ents, kept);
  T.Size := T.Size + FieldSize(kept);
  TableEvict(T);
end;

{ the entry of index I, from 1: the static table's 61, then the
  dynamic table's from its newest (2.3.3); False past both }
function TableAt(const T: THpackTable; I: Integer; out F: THpackField): Boolean;
var
  k: Integer;
begin
  Result := False;
  F.Name := '';
  F.Value := '';
  F.Sensitive := False;
  if I < 1 then
    Exit;
  if I <= HpackStaticLen then
  begin
    F.Name := HpackStaticName[I];
    F.Value := HpackStaticValue[I];
    Result := True;
    Exit;
  end;
  k := I - HpackStaticLen;
  if k > TableLen(T) then
    Exit;
  F := T.Ents[Length(T.Ents) - k];
  Result := True;
end;

{ ---- the decoder (RFC 7541 3, 5 and 6) ---- }

procedure HpackDecoderInit(var D: THpackDecoder; Allowed: Integer);
begin
  D.Tab.Ents := nil;
  D.Tab.First := 0;
  D.Tab.Size := 0;
  D.Tab.Allowed := Allowed;
  D.Tab.MaxSize := Allowed;
  if D.Tab.MaxSize > 4096 then
    D.Tab.MaxSize := 4096;
end;

{ 5.1: an integer whose prefix is the low N bits of the octet at P; P
  moves past it. False when the block ends inside it or it is past
  2^31, which no index and no length of this unit reaches }
function ReadInt(const B: string; var P: Integer; N: Integer; out V: Integer): Boolean;
var
  mask, shift, octet: Integer;
begin
  Result := False;
  V := 0;
  if P > Length(B) then
    Exit;
  mask := (1 shl N) - 1;
  V := Ord(B[P]) and mask;
  Inc(P);
  if V < mask then
  begin
    Result := True;
    Exit;
  end;
  shift := 0;
  while P <= Length(B) do
  begin
    octet := Ord(B[P]);
    Inc(P);
    V := V + ((octet and 127) shl shift);
    if V > $7FFFFFFF then
      Exit;
    if (octet and 128) = 0 then
    begin
      Result := True;
      Exit;
    end;
    shift := shift + 7;
    if shift > 28 then
      Exit;
  end;
end;

{ 5.2: a string literal at P }
function ReadString(const B: string; var P: Integer; out S: string): Boolean;
var
  huff: Boolean;
  n: Integer;
begin
  Result := False;
  S := '';
  if P > Length(B) then
    Exit;
  huff := (Ord(B[P]) and 128) <> 0;
  if not ReadInt(B, P, 7, n) then
    Exit;
  if n > Length(B) - P + 1 then
    Exit;
  if huff then
    Result := HuffmanDecode(Copy(B, P, n), S)
  else
  begin
    S := Copy(B, P, n);
    Result := True;
  end;
  P := P + n;
end;

function HpackDecode(var D: THpackDecoder; const Block: string; Budget: Integer; var Fields: THpackFields;
  out TooLarge: Boolean; out Err: string): Boolean;
var
  p, b, idx, size, used: Integer;
  f, named: THpackField;
  index, started: Boolean;
begin
  Result := False;
  TooLarge := False;
  Err := '';
  p := 1;
  used := 0;
  started := False;
  while p <= Length(Block) do
  begin
    b := Ord(Block[p]);
    if (b and $E0) = $20 then
    begin
      { 6.3: a size update, at the beginning of a block alone (4.2) }
      if started then
      begin
        Err := 'hpack: a table size update after a header field';
        Exit;
      end;
      if not ReadInt(Block, p, 5, size) then
      begin
        Err := 'hpack: truncated table size update';
        Exit;
      end;
      if size > D.Tab.Allowed then
      begin
        Err := 'hpack: table size update past the size allowed';
        Exit;
      end;
      TableSetMax(D.Tab, size);
      Continue;
    end;
    started := True;
    if (b and $80) <> 0 then
    begin
      { 6.1: an indexed field }
      if not ReadInt(Block, p, 7, idx) then
      begin
        Err := 'hpack: truncated index';
        Exit;
      end;
      if not TableAt(D.Tab, idx, f) then
      begin
        Err := 'hpack: no header field has that index';
        Exit;
      end;
    end
    else
    begin
      { 6.2: a literal, with indexing (01), without (0000) or never
        indexed (0001) }
      index := (b and $C0) = $40;
      if index then
      begin
        if not ReadInt(Block, p, 6, idx) then
          idx := -1;
      end
      else if not ReadInt(Block, p, 4, idx) then
        idx := -1;
      if idx < 0 then
      begin
        Err := 'hpack: truncated literal';
        Exit;
      end;
      f.Sensitive := (b and $F0) = $10;
      if idx > 0 then
      begin
        if not TableAt(D.Tab, idx, named) then
        begin
          Err := 'hpack: no header field has that index';
          Exit;
        end;
        f.Name := named.Name;
      end
      else if not ReadString(Block, p, f.Name) then
      begin
        Err := 'hpack: a name that is no string';
        Exit;
      end;
      if not ReadString(Block, p, f.Value) then
      begin
        Err := 'hpack: a value that is no string';
        Exit;
      end;
      if index then
        TableAdd(D.Tab, f);
    end;
    used := used + FieldSize(f);
    if used > Budget then
      TooLarge := True
    else
      Fields := Append(Fields, f);
  end;
  Result := True;
end;

{ ---- the encoder (RFC 7541 2.4 and 6; Go's hpack encode.go) ---- }

procedure HpackEncoderInit(var E: THpackEncoder);
begin
  E.Tab.Ents := nil;
  E.Tab.First := 0;
  E.Tab.Size := 0;
  E.Tab.Allowed := 4096;
  E.Tab.MaxSize := 4096;
  E.MinSize := -1;
  E.Update := False;
  E.NoHuffman := False;
end;

procedure HpackEncoderLimit(var E: THpackEncoder; PeerSize: Integer);
var
  v: Integer;
begin
  { SetMaxDynamicTableSizeLimit and SetMaxDynamicTableSize of Go's
    encoder in one: the table never grows past the 4096 octets it
    began with, as Go's client keeps it, and a smaller size the peer
    asks for is taken and said in the next block }
  v := PeerSize;
  if v > 4096 then
    v := 4096;
  if v < 0 then
    v := 0;
  if v = E.Tab.MaxSize then
    Exit;
  if (E.MinSize < 0) or (v < E.MinSize) then
    E.MinSize := v;
  E.Update := True;
  E.Tab.Allowed := v;
  TableSetMax(E.Tab, v);
end;

procedure PutInt(var Res: TStringBuilder; N, First, V: Integer);
var
  mask, rest: Integer;
begin
  mask := (1 shl N) - 1;
  if V < mask then
  begin
    Res.AddChar(Chr(First or V));
    Exit;
  end;
  Res.AddChar(Chr(First or mask));
  rest := V - mask;
  while rest >= 128 do
  begin
    Res.AddChar(Chr((rest and 127) or 128));
    rest := rest shr 7;
  end;
  Res.AddChar(Chr(rest));
end;

procedure PutString(var Res: TStringBuilder; const S: string; NoHuffman: Boolean);
var
  n: Integer;
begin
  n := HuffmanLength(S);
  if (not NoHuffman) and (n < Length(S)) then
  begin
    PutInt(Res, 7, 128, n);
    Res.AddText(HuffmanEncode(S));
  end
  else
  begin
    PutInt(Res, 7, 0, Length(S));
    Res.AddText(S);
  end;
end;

{ searchTable: the index of a field of this name and value and True,
  or of one of this name and False, or 0: the static table first, then
  the dynamic one from its newest }
function TableSearch(const T: THpackTable; const F: THpackField; out Whole: Boolean): Integer;
var
  i, byName: Integer;
begin
  Whole := False;
  byName := 0;
  for i := 1 to HpackStaticLen do
    if HpackStaticName[i] = F.Name then
    begin
      if HpackStaticValue[i] = F.Value then
      begin
        Whole := True;
        Result := i;
        Exit;
      end;
      if byName = 0 then
        byName := i;
    end;
  for i := Length(T.Ents) - 1 downto T.First do
    if T.Ents[i].Name = F.Name then
    begin
      if T.Ents[i].Value = F.Value then
      begin
        Whole := True;
        Result := HpackStaticLen + Length(T.Ents) - i;
        Exit;
      end;
      if byName = 0 then
        byName := HpackStaticLen + Length(T.Ents) - i;
    end;
  Result := byName;
end;

function HpackEncode(var E: THpackEncoder; const Fields: THpackFields): string;
var
  res: TStringBuilder;
  i, idx: Integer;
  whole, index: Boolean;
begin
  res := TStringBuilder.Create(256);
  if E.Update then
  begin
    { 4.2: the smallest size since the last block, when it was smaller
      than the size now, then the size now }
    E.Update := False;
    if (E.MinSize >= 0) and (E.MinSize < E.Tab.MaxSize) then
      PutInt(res, 5, $20, E.MinSize);
    E.MinSize := -1;
    PutInt(res, 5, $20, E.Tab.MaxSize);
  end;
  for i := 0 to High(Fields) do
  begin
    idx := TableSearch(E.Tab, Fields[i], whole);
    if whole and not Fields[i].Sensitive then
    begin
      PutInt(res, 7, $80, idx);
      Continue;
    end;
    index := (not Fields[i].Sensitive) and (not Fields[i].Once) and (FieldSize(Fields[i]) <= E.Tab.MaxSize);
    if Fields[i].Sensitive then
      PutInt(res, 4, $10, idx)
    else if index then
      PutInt(res, 6, $40, idx)
    else
      PutInt(res, 4, 0, idx);
    if idx = 0 then
      PutString(res, Fields[i].Name, E.NoHuffman);
    PutString(res, Fields[i].Value, E.NoHuffman);
    if index then
      TableAdd(E.Tab, Fields[i]);
  end;
  Result := res.ToString;
end;

function Http2FieldIndexed(const Name, Value: string): THpackField;
begin
  Result.Name := Name;
  Result.Value := Value;
  Result.Sensitive := False;
  Result.Once := False;
end;

function Http2FieldOnce(const Name, Value: string): THpackField;
begin
  Result.Name := Name;
  Result.Value := Value;
  Result.Sensitive := False;
  Result.Once := True;
end;

function Http2Field(const Name, Value: string): THpackField;
begin
  Result.Name := Name;
  Result.Value := Value;
  Result.Sensitive := (Name = 'authorization') or (Name = 'proxy-authorization') or (Name = 'cookie') or
    (Name = 'set-cookie');
  Result.Once := False;
end;

function Http2Get(const Fields: THpackFields; const Name: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to High(Fields) do
    if Fields[i].Name = Name then
    begin
      Result := Fields[i].Value;
      Exit;
    end;
end;

{ ---- the connection (RFC 9113) ---- }

const
  { the client's connection preface (3.4) }
  H2Preface = 'PRI * HTTP/2.0'#13#10#13#10'SM'#13#10#13#10;
  { the frame types (6) and their flags }
  FrData = 0;
  FrHeaders = 1;
  FrPriority = 2;
  FrRstStream = 3;
  FrSettings = 4;
  FrPushPromise = 5;
  FrPing = 6;
  FrGoAway = 7;
  FrWindowUpdate = 8;
  FrContinuation = 9;
  FlEndStream = 1;
  FlAck = 1;
  FlEndHeaders = 4;
  FlPadded = 8;
  FlPriority = 32;
  { a window before SETTINGS say otherwise, and the largest there is
    (6.9.1, 6.9.2); it is the largest stream number too (5.1.1) }
  H2InitialWindow = 65535;
  H2MaxWindow = 2147483647;
  { what this end lets the peer send: on the whole connection and on a
    stream (Go's transportDefaultConnFlow and transportDefaultStreamFlow),
    and in one frame (its defaultMaxReadFrameSize) }
  H2ConnWindow = 1073741824;
  H2StreamWindow = 4194304;
  H2ReadFrame = 1048576;
  { the content of a request goes in frames of this size at most, so
    that the requests of other routines get in between; a request that
    is alone on its connection has nobody to let in, and its frames are
    as large as Go's (transport.go frameScratchBufferLen: the peer's
    largest frame, 512 KiB at most): 50 MB to Go's server went in 763
    frames and twice as many writes where Go's client made 107, in the
    time Go's takes; in frames of Go's size it takes 0.88 of it }
  H2DataChunk = 65536;
  H2DataAlone = 524288;
  { content of this much or more in one frame is written from where it
    is, in a write of its own after its frame's nine octets; less is
    copied behind them and goes in one write }
  H2Unframed = 16384;
  { content waits for its turn while this much is pending to be written }
  H2OutMax = 262144;
  { what the reading routine reads ahead: a frame's nine octets and, of
    a small frame, the rest with them; the content of a larger one is
    read where it is kept, past what came with its head }
  H2InBuf = 16384;
  { A connection error gets one second to issue GOAWAY, as in Go
    http2's goAwayTimeout, and a bounded drain after the write half-close
    (RFC 9112 9.6). Count octets read from the transport while draining. }
  H2CloseMs = 1000;
  H2DrainBytes = 65536;
  { the end of the stream, as the reading routines say it }
  H2Eof = -1000000;

function Be32(V: Integer): string;
begin
  SetLength(Result, 4);
  Result[1] := Chr((V shr 24) and 255);
  Result[2] := Chr((V shr 16) and 255);
  Result[3] := Chr((V shr 8) and 255);
  Result[4] := Chr(V and 255);
end;

function U32At(const S: string; P: Integer): Integer;
begin
  Result := (Ord(S[P]) shl 24) or (Ord(S[P + 1]) shl 16) or (Ord(S[P + 2]) shl 8) or Ord(S[P + 3]);
end;

{ the nine octets before a frame's payload (4.1) }
procedure FrameHead(var F: string; N, Typ, Flags, Id: Integer);
begin
  F[1] := Chr((N shr 16) and 255);
  F[2] := Chr((N shr 8) and 255);
  F[3] := Chr(N and 255);
  F[4] := Chr(Typ);
  F[5] := Chr(Flags);
  F[6] := Chr((Id shr 24) and 127);
  F[7] := Chr((Id shr 16) and 255);
  F[8] := Chr((Id shr 8) and 255);
  F[9] := Chr(Id and 255);
end;

function Frame(Typ, Flags, Id: Integer; const Payload: string): string;
var
  n: Integer;
begin
  n := Length(Payload);
  SetLength(Result, 9 + n);
  FrameHead(Result, n, Typ, Flags, Id);
  if n > 0 then
    Move(Payload[1], Result[10], n);
end;

{ a DATA frame of the N octets of Body from P (6.1) }
function DataFrame(Id: Integer; Last: Boolean; const Body: string; P, N: Integer): string;
var
  flags: Integer;
begin
  flags := 0;
  if Last then
    flags := FlEndStream;
  SetLength(Result, 9 + N);
  FrameHead(Result, N, FrData, flags, Id);
  if N > 0 then
    Move(Body[P], Result[10], N);
end;

function Setting(Id, V: Integer): string;
begin
  Result := Chr((Id shr 8) and 255) + Chr(Id and 255) + Be32(V);
end;

{ GOAWAY (6.8). The last stream of the peer's that this end took is 0:
  a server opens none, for push is off }
function GoAwayFrame(Code: Integer): string;
begin
  Result := Frame(FrGoAway, 0, 0, Be32(0) + Be32(Code));
end;

function RstFrame(Id, Code: Integer): string;
begin
  Result := Frame(FrRstStream, 0, Id, Be32(Code));
end;

{ a field block as HEADERS and, past the peer's largest frame, as the
  CONTINUATION frames that follow it at once (6.2, 6.10; Go's
  ClientConn.writeHeaders) }
function HeaderFrames(Id: Integer; const Block: string; EndStream: Boolean; MaxFrame: Integer): string;
var
  flags, p, n: Integer;
  res: TStringBuilder;
begin
  flags := 0;
  if EndStream then
    flags := FlEndStream;
  if Length(Block) <= MaxFrame then
  begin
    Result := Frame(FrHeaders, flags or FlEndHeaders, Id, Block);
    Exit;
  end;
  res := TStringBuilder.Create(Length(Block) + 9 * (Length(Block) div MaxFrame + 1));
  res.AddText(Frame(FrHeaders, flags, Id, Copy(Block, 1, MaxFrame)));
  p := MaxFrame + 1;
  while p <= Length(Block) do
  begin
    n := Length(Block) - p + 1;
    flags := FlEndHeaders;
    if n > MaxFrame then
    begin
      n := MaxFrame;
      flags := 0;
    end;
    res.AddText(Frame(FrContinuation, flags, Id, Copy(Block, p, n)));
    p := p + n;
  end;
  Result := res.ToString;
end;

function Http2ErrorName(Code: Integer): string;
begin
  case Code of
    0: Result := 'NO_ERROR';
    1: Result := 'PROTOCOL_ERROR';
    2: Result := 'INTERNAL_ERROR';
    3: Result := 'FLOW_CONTROL_ERROR';
    4: Result := 'SETTINGS_TIMEOUT';
    5: Result := 'STREAM_CLOSED';
    6: Result := 'FRAME_SIZE_ERROR';
    7: Result := 'REFUSED_STREAM';
    8: Result := 'CANCEL';
    9: Result := 'COMPRESSION_ERROR';
    10: Result := 'CONNECT_ERROR';
    11: Result := 'ENHANCE_YOUR_CALM';
    12: Result := 'INADEQUATE_SECURITY';
    13: Result := 'HTTP_1_1_REQUIRED';
  else
    Result := 'error ' + IntToStr(Code);
  end;
end;

{ a token of RFC 9110 5.6.2. Lower refuses A to Z too: a field name is
  written in lower case (RFC 9113 8.2.1) }
function IsToken(const S: string; Lower: Boolean): Boolean;
var
  i, c: Integer;
begin
  Result := False;
  if S = '' then
    Exit;
  for i := 1 to Length(S) do
  begin
    c := Ord(S[i]);
    if ((c >= 97) and (c <= 122)) or ((c >= 48) and (c <= 57)) then
      Continue;
    if (c >= 65) and (c <= 90) then
    begin
      if Lower then
        Exit;
      Continue;
    end;
    { ! # $ % & ' * + - . ^ _ ` | ~ }
    case c of
      33, 35, 36, 37, 38, 39, 42, 43, 45, 46, 94, 95, 96, 124, 126:
        Continue;
    else
      Exit;
    end;
  end;
  Result := True;
end;

{ a field value (RFC 9113 8.2.1): no octet below the space but the
  tab, no DEL, and neither a space nor a tab at its ends }
function IsFieldValue(const S: string): Boolean;
var
  i, c, n: Integer;
begin
  Result := False;
  n := Length(S);
  for i := 1 to n do
  begin
    c := Ord(S[i]);
    if ((c < 32) and (c <> 9)) or (c = 127) then
      Exit;
  end;
  if n > 0 then
    if (S[1] = ' ') or (S[1] = #9) or (S[n] = ' ') or (S[n] = #9) then
      Exit;
  Result := True;
end;

{ the fields of an HTTP/1.1 connection, which a message of HTTP/2 does
  not carry (8.2.2) }
function IsConnField(const Name: string): Boolean;
begin
  Result := (Name = 'connection') or (Name = 'proxy-connection') or (Name = 'keep-alive') or
    (Name = 'transfer-encoding') or (Name = 'upgrade');
end;

{ The fields of a request, the pseudo-header fields first (8.3.1) in
  the order Go writes them, and their size as a peer counts it; or why
  the request is not well formed. The third is :path }
function RequestFields(const Scheme, Authority, Method, Path: string; const Headers: THpackFields;
  BodyLen: Integer; out Fields: THpackFields; out Size: Integer): string;
var
  i, c, p, q: Integer;
  f, piece: THpackField;
begin
  Result := '';
  Fields := nil;
  Size := 0;
  if not IsToken(Method, False) then
  begin
    Result := 'http2: the method is not a token';
    Exit;
  end;
  if Method = 'CONNECT' then
  begin
    Result := 'http2: CONNECT is not offered';
    Exit;
  end;
  if not ((Path = '*') or ((Path <> '') and (Path[1] = '/'))) then
  begin
    Result := 'http2: a path begins with / (or is * for OPTIONS)';
    Exit;
  end;
  for i := 1 to Length(Path) do
  begin
    c := Ord(Path[i]);
    if (c <= 32) or (c >= 127) then
    begin
      Result := 'http2: the path has an octet that goes percent-encoded';
      Exit;
    end;
  end;
  Fields := Append(Fields, Http2FieldIndexed(':authority', Authority));
  Fields := Append(Fields, Http2FieldIndexed(':method', Method));
  Fields := Append(Fields, Http2FieldIndexed(':path', Path));
  Fields := Append(Fields, Http2FieldIndexed(':scheme', Scheme));
  for i := 0 to High(Headers) do
  begin
    f := Headers[i];
    if (f.Name <> '') and (f.Name[1] = ':') then
    begin
      Result := 'http2: ' + f.Name + ' is a pseudo-header field: the call writes a request''s';
      Exit;
    end;
    if not IsToken(f.Name, True) then
    begin
      Result := 'http2: a field name is a token in lower case, and one given is not';
      Exit;
    end;
    if IsConnField(f.Name) then
    begin
      Result := 'http2: ' + f.Name + ' belongs to an HTTP/1.1 connection and has no place in HTTP/2 (RFC 9113 8.2.2)';
      Exit;
    end;
    if f.Name = 'host' then
    begin
      Result := 'http2: the host is the connection''s authority, not a field';
      Exit;
    end;
    if f.Name = 'content-length' then
    begin
      Result := 'http2: content-length is written from the content';
      Exit;
    end;
    if (f.Name = 'te') and (f.Value <> 'trailers') then
    begin
      Result := 'http2: te says trailers or is not sent (RFC 9113 8.2.2)';
      Exit;
    end;
    if not IsFieldValue(f.Value) then
    begin
      Result := 'http2: the value of ' + f.Name + ' has an octet a field value does not hold, or a space at an end';
      Exit;
    end;
    if f.Name <> 'cookie' then
    begin
      Fields := Append(Fields, f);
      Continue;
    end;
    { a cookie field goes crumb by crumb, which compresses better (8.2.3) }
    piece := f;
    p := 1;
    while p <= Length(f.Value) do
    begin
      q := p;
      while (q <= Length(f.Value)) and (f.Value[q] <> ';') do
        Inc(q);
      piece.Value := Copy(f.Value, p, q - p);
      if piece.Value <> '' then
        Fields := Append(Fields, piece);
      p := q + 1;
      while (p <= Length(f.Value)) and (f.Value[p] = ' ') do
        Inc(p);
    end;
  end;
  { as Go's shouldSendReqContentLength: when there is content, and for
    the methods that are expected to carry some }
  if (BodyLen > 0) or (Method = 'POST') or (Method = 'PUT') or (Method = 'PATCH') then
    Fields := Append(Fields, Http2FieldOnce('content-length', IntToStr(BodyLen)));
  for i := 0 to High(Fields) do
    Size := Size + FieldSize(Fields[i]);
end;

{ The fields of a response's block (8.1, 8.2, 8.3.2): its status and
  its fields without it, their size, and what content-length says (-1
  when it says nothing); or why the block is malformed. Trailers have
  no pseudo-header field at all }
function ResponseFields(const All: THpackFields; Trailers: Boolean; out Status: Integer;
  out Fields: THpackFields; out Size, ContentLength: Integer): string;
var
  i, j, n, c, v: Integer;
  regular, haveStatus: Boolean;
  s: string;
begin
  Result := '';
  Status := 0;
  Size := 0;
  ContentLength := -1;
  regular := False;
  haveStatus := False;
  SetLength(Fields, Length(All));
  n := 0;
  for i := 0 to High(All) do
  begin
    Size := Size + FieldSize(All[i]);
    s := All[i].Name;
    if (s <> '') and (s[1] = ':') then
    begin
      if Trailers then
      begin
        Result := 'a pseudo-header field among the trailers';
        Exit;
      end;
      if regular then
      begin
        Result := 'a pseudo-header field after a field';
        Exit;
      end;
      if s <> ':status' then
      begin
        Result := 'a pseudo-header field a response does not have';
        Exit;
      end;
      if haveStatus then
      begin
        Result := 'two :status fields';
        Exit;
      end;
      haveStatus := True;
      s := All[i].Value;
      if Length(s) <> 3 then
      begin
        Result := 'a status that is not three digits';
        Exit;
      end;
      for j := 1 to 3 do
      begin
        c := Ord(s[j]);
        if (c < 48) or (c > 57) then
        begin
          Result := 'a status that is not three digits';
          Exit;
        end;
        Status := Status * 10 + c - 48;
      end;
      Continue;
    end;
    regular := True;
    if not IsToken(s, True) then
    begin
      Result := 'a field name that is not a token in lower case';
      Exit;
    end;
    if IsConnField(s) then
    begin
      Result := 'the field ' + s + ', which belongs to an HTTP/1.1 connection';
      Exit;
    end;
    if not IsFieldValue(All[i].Value) then
    begin
      Result := 'a value of ' + s + ' with an octet a field value does not hold, or a space at an end';
      Exit;
    end;
    if s = 'content-length' then
    begin
      { RFC 9110 8.6: digits, and the same every time it is said }
      s := All[i].Value;
      if (s = '') or (Length(s) > 18) then
      begin
        Result := 'a content-length that is not a number';
        Exit;
      end;
      v := 0;
      for j := 1 to Length(s) do
      begin
        c := Ord(s[j]);
        if (c < 48) or (c > 57) then
        begin
          Result := 'a content-length that is not a number';
          Exit;
        end;
        v := v * 10 + c - 48;
      end;
      if (ContentLength >= 0) and (ContentLength <> v) then
      begin
        Result := 'two content-length fields that differ';
        Exit;
      end;
      ContentLength := v;
    end;
    Fields[n] := All[i];
    Inc(n);
  end;
  SetLength(Fields, n);
  if (not Trailers) and not haveStatus then
    Result := 'no :status field';
end;

{ ---- writing ---- }

{ one write to the peer, with no lock held }
function THttp2Conn.Raw(const Frames: string): Boolean;
begin
  Result := FStream.WriteAll(Frames, PasIoDeadline(FOpt.WriteTimeoutMs));
end;

{ A write failed, and nothing more can be written. What the peer sent
  before it went may say why it went (its GOAWAY and reason, an answer
  in another protocol), so the reading routine is given a second to
  come to the end of what there is and say so; after it the connection
  ends for the write's own reason. Under FMu }
procedure THttp2Conn.WriteFailed;
begin
  if FBroken or FWriteBroken then
    Exit;
  FWriteBroken := True;
  FOut.Reset;
  FFailWhy := 'http2: a write to the peer failed: it is gone, or took nothing for ' + IntToStr(FOpt.WriteTimeoutMs) +
    ' ms';
  FFailDue := PasIoDeadline(1000);
  Arm(FFailDue);
  FCond.Broadcast;
end;

{ The routine that holds the turn to write (FWBusy) has written: what
  other routines left meanwhile goes on a routine of the connection's,
  to which the turn passes; with nothing left the turn is free. Under
  FMu }
procedure THttp2Conn.WriteDone;
begin
  if (FOut.ByteLength > 0) and (not FBroken) and not FWriteBroken then
  begin
    FWg.Add(1);
    pas Self.Flusher;
    Exit;
  end;
  FOut.Reset;
  FWBusy := False;
  FCond.Broadcast;
end;

{ Frames, written by the routine that holds the turn. Under FMu, which
  is let go while the peer takes them }
procedure THttp2Conn.WriteNow(const Frames: string);
var
  ok: Boolean;
begin
  FMu.Unlock;
  ok := Raw(Frames);
  FMu.Lock;
  if not ok then
    WriteFailed;
  WriteDone;
end;

{ A DATA frame of the N octets of Body after its first Offset, written
  by the routine that holds the turn: its nine octets, then the content
  from where it is, which is not copied to be framed. Under FMu, which
  is let go while the peer takes them }
procedure THttp2Conn.WriteContent(S: TH2Stream; const Body: string; Offset, N: Integer; Last: Boolean);
var
  head: string;
  flags, due: Integer;
  ok: Boolean;
begin
  flags := 0;
  if Last then
    flags := FlEndStream;
  SetLength(head, 9);
  FrameHead(head, N, FrData, flags, S.Id);
  FMu.Unlock;
  due := PasIoDeadline(FOpt.WriteTimeoutMs);
  ok := FStream.WriteAll(head, due) and FStream.WriteFrom(@Body[Offset + 1], N, due);
  FMu.Lock;
  if not ok then
    WriteFailed;
  WriteDone;
end;

{ the routine that writes what is pending, until nothing is }
procedure THttp2Conn.Flusher;
var
  pending: string;
  ok: Boolean;
begin
  FMu.Lock;
  while (FOut.ByteLength > 0) and (not FBroken) and not FWriteBroken do
  begin
    pending := FOut.ToString;
    FOut.Reset;
    FCond.Broadcast;
    FMu.Unlock;
    ok := Raw(pending);
    FMu.Lock;
    if not ok then
      WriteFailed;
  end;
  FOut.Reset;
  FWBusy := False;
  FCond.Broadcast;
  FMu.Unlock;
  FWg.Done;
end;

{ Frames go to the peer, in the order of the calls: that is the order
  of the stream numbers and of the compression's state (5.1.1, 4.3),
  so a field block is encoded and posted without letting FMu go in
  between. Nobody waits for another's write: while a routine writes,
  the frames are left for it; otherwise the caller writes them itself
  when Direct says it may wait for the peer, and a routine of the
  connection's does when it may not. Under FMu, which a Direct call
  lets go while it writes }
procedure THttp2Conn.Post(const Frames: string; Direct: Boolean);
begin
  if FBroken or FWriteBroken or (Frames = '') then
    Exit;
  if FWBusy then
  begin
    FOut.AddText(Frames);
    Exit;
  end;
  FWBusy := True;
  if Direct then
  begin
    WriteNow(Frames);
    Exit;
  end;
  FOut.AddText(Frames);
  FWg.Add(1);
  pas Self.Flusher;
end;

{ the reading routine pays what it owes the peer (acknowledgements,
  windows, resets) before it waits for more from it }
procedure THttp2Conn.Owe;
var
  frames: string;
begin
  frames := FOwed;
  FOwed := '';
  FMu.Lock;
  Post(frames, True);
  FMu.Unlock;
end;

{ ---- the end of a stream and of the connection ---- }

function THttp2Conn.GoAwayText: string;
var
  i, c: Integer;
  shown: string;
begin
  Result := 'http2: the server is going away (' + Http2ErrorName(FGoAwayCode) + ')';
  if FGoAwayDebug = '' then
    Exit;
  { what it says of its reason, as far as it is text }
  shown := '';
  for i := 1 to Length(FGoAwayDebug) do
  begin
    if i > 200 then
      Break;
    c := Ord(FGoAwayDebug[i]);
    if (c >= 32) and (c < 127) then
      shown := shown + FGoAwayDebug[i]
    else
      shown := shown + '.';
  end;
  Result := Result + ': ' + shown;
end;

{ A request or a ping is over, whatever its outcome, which its fields
  say: it leaves the tables, its place among the streams is free, and
  its routine wakes. Under FMu }
procedure THttp2Conn.Finish(S: TH2Stream);
var
  i, last: Integer;
begin
  if S.Ended then
    Exit;
  S.Ended := True;
  if S.Id <> 0 then
    Delete(FStreams, S.Id);
  Unwatch(S);
  if S.PingData <> '' then
  begin
    last := High(FPings);
    for i := 0 to last do
      if FPings[i] = S then
      begin
        FPings[i] := FPings[last];
        SetLength(FPings, last);
        Break;
      end;
  end;
  if S.HasSlot then
  begin
    S.HasSlot := False;
    if S.TimedOut and (S.Id <> 0) and (S.ReadMark = FReadCount) and not FClosed then
    begin
      { Nothing has come from the peer since this request went, and the
        peer may be gone: the request's place stays taken until a PING
        shows the peer is there, so that a dead connection is not given
        request after request (Go's pendingResets) }
      Inc(FPendingResets);
      S.AskPeer := True;
    end
    else
      Dec(FActive);
  end;
  S.Wake.Signal;
  FCond.Broadcast;
  { a connection that is going away, or has no stream numbers left,
    ends with its last stream }
  if (not FClosed) and (Length(FStreams) = 0) then
  begin
    if FGoAway then
      Fail(GoAwayText, True)
    else if FSpent then
      Fail('http2: the connection has used all its stream numbers', True);
  end;
end;

{ The connection is over for Why: its requests fail and no new one
  begins. Broken says that nothing more is written either; the stream
  under the connection is then shut, which brings the reading routine
  back. Under FMu }
procedure THttp2Conn.Fail(const Why: string; Broken: Boolean);
var
  id: Integer;
  s: TH2Stream;
begin
  if not FClosed then
  begin
    FClosed := True;
    FErr := Why;
    for id, s in FStreams do
    begin
      if s.Err = '' then
        s.Err := Why;
      Finish(s);
    end;
    while Length(FPings) > 0 do
      Finish(FPings[0]);
    FCond.Broadcast;
  end;
  if Broken and not FBroken then
  begin
    FBroken := True;
    FOut.Reset;
    if (not FTornDown) and not FUserClosed then
      FStream.Shutdown(2);
  end;
  Poke;
end;

{ ---- deadlines ---- }

procedure THttp2Conn.Poke;
var
  one, n: Integer;
begin
  if FTimerFd < 0 then
    Exit;
  one := 1;
  n := PasIoWrite(FTimerFd, @one, 8, 0);
end;

{ the routine of the deadlines is to wake at Due at the latest }
procedure THttp2Conn.Arm(Due: Integer);
begin
  if (FTimerNext = 0) or (Due < FTimerNext) then
  begin
    FTimerNext := Due;
    Poke;
  end;
end;

procedure THttp2Conn.Watch(S: TH2Stream);
begin
  if FTimedN = Length(FTimed) then
    SetLength(FTimed, 2 * FTimedN + 8);
  FTimed[FTimedN] := S;
  S.TimedAt := FTimedN;
  Inc(FTimedN);
  Arm(S.Deadline);
end;

procedure THttp2Conn.Unwatch(S: TH2Stream);
var
  k: Integer;
begin
  k := S.TimedAt;
  if (k < 0) or (k >= FTimedN) or (FTimed[k] <> S) then
    Exit;
  Dec(FTimedN);
  FTimed[k] := FTimed[FTimedN];
  FTimed[k].TimedAt := k;
  FTimed[FTimedN] := nil;
  S.TimedAt := -1;
end;

{ a PING of the connection's own: the peer answers it within
  PingTimeoutMs or the connection is lost. It is never written by the
  caller, which may be the routine of the deadlines }
procedure THttp2Conn.HealthPing;
begin
  if (FHealthDue <> 0) or FClosed then
    Exit;
  Inc(FPingSeq);
  FHealthData := Be32(0) + Be32(FPingSeq);
  FHealthDue := PasIoDeadline(FOpt.PingTimeoutMs);
  Arm(FHealthDue);
  Post(Frame(FrPing, 0, 0, FHealthData), False);
end;

{ The routine that keeps the deadlines: it parks on its eventfd until
  the nearest of them, or until a nearer one is set and it is poked.
  It writes nothing to the peer itself, so a peer that takes nothing
  cannot hold a deadline back }
procedure THttp2Conn.TimerLoop;
var
  buf, n, tnow, next, idle, i, fd: Integer;
  s: TH2Stream;
begin
  FMu.Lock;
  while not FBroken do
  begin
    tnow := Nanotime;
    next := 0;
    i := 0;
    while i < FTimedN do
    begin
      s := FTimed[i];
      if s.Deadline <= tnow then
      begin
        { its place in the table is taken by another, looked at next }
        s.TimedOut := True;
        if s.PingData = '' then
          s.Err := 'http2: no response within ' + IntToStr(s.TimeoutMs) + ' ms';
        Finish(s);
        Continue;
      end;
      if (next = 0) or (s.Deadline < next) then
        next := s.Deadline;
      Inc(i);
    end;
    if FBroken then
      Break;
    if FFailDue <> 0 then
    begin
      if FFailDue <= tnow then
      begin
        Fail(FFailWhy, True);
        Break;
      end;
      if (next = 0) or (FFailDue < next) then
        next := FFailDue;
    end;
    if FClosed then
    begin
      { Requests may be finished while the last GOAWAY is still writing. }
      if FFailDue = 0 then
        Break;
    end
    else if FHealthDue <> 0 then
    begin
      if FHealthDue <= tnow then
      begin
        Fail('http2: the peer did not answer a PING within ' + IntToStr(FOpt.PingTimeoutMs) +
          ' ms: the connection is lost', True);
        Break;
      end;
      if (next = 0) or (FHealthDue < next) then
        next := FHealthDue;
    end
    else if FOpt.ReadIdleMs > 0 then
    begin
      idle := FLastRead + FOpt.ReadIdleMs * 1000000;
      if idle <= tnow then
      begin
        HealthPing;
        idle := FHealthDue;
      end;
      if (next = 0) or (idle < next) then
        next := idle;
    end;
    FTimerNext := next;
    FMu.Unlock;
    n := PasIoRead(FTimerFd, @buf, 8, next);
    FMu.Lock;
  end;
  fd := FTimerFd;
  FTimerFd := -1;
  FMu.Unlock;
  NetClose(fd);
  FWg.Done;
end;

{ ---- reading ---- }

{ at least Need octets are in FIn from FInPos, Need no more than FIn
  holds: 0, or H2Eof at the end of the stream, or what the read
  answered }
function THttp2Conn.Fill(Need: Integer): Integer;
var
  n, have, i: Integer;
begin
  Result := 0;
  have := FInEnd - FInPos;
  if have >= Need then
    Exit;
  if FInPos > 1 then
  begin
    { what is left, less than a frame's head, goes to the front }
    for i := 1 to have do
      FIn[i] := FIn[FInPos + i - 1];
    FInPos := 1;
    FInEnd := 1 + have;
  end;
  while FInEnd - FInPos < Need do
  begin
    if FOwed <> '' then
      Owe;
    n := FStream.ReadInto(@FIn[FInEnd], Length(FIn) - FInEnd + 1, 0);
    if n <= 0 then
    begin
      Result := n;
      if n = 0 then
        Result := H2Eof;
      Exit;
    end;
    FInEnd := FInEnd + n;
  end;
end;

{ the next N octets into Dest after its first Offset: what was read
  ahead first, the rest read from the stream straight into their place }
function THttp2Conn.ReadTo(var Dest: string; Offset, N: Integer): Integer;
var
  got, k: Integer;
begin
  Result := 0;
  got := FInEnd - FInPos;
  if got > N then
    got := N;
  if got > 0 then
  begin
    Move(FIn[FInPos], Dest[Offset + 1], got);
    FInPos := FInPos + got;
  end;
  while got < N do
  begin
    if FOwed <> '' then
      Owe;
    k := FStream.ReadInto(@Dest[Offset + got + 1], N - got, 0);
    if k <= 0 then
    begin
      Result := k;
      if k = 0 then
        Result := H2Eof;
      Exit;
    end;
    got := got + k;
  end;
end;

{ the next N octets, the payload of a frame that is not content to keep }
function THttp2Conn.ReadBytes(N: Integer; out Data: string): Integer;
begin
  Result := 0;
  Data := '';
  if N = 0 then
    Exit;
  if FInEnd - FInPos >= N then
  begin
    Data := Copy(FIn, FInPos, N);
    FInPos := FInPos + N;
    Exit;
  end;
  SetLength(Data, N);
  Result := ReadTo(Data, 0, N);
  if Result <> 0 then
    Data := '';
end;

{ the next N octets are read and let by }
function THttp2Conn.Skip(N: Integer): Integer;
var
  k: Integer;
begin
  Result := 0;
  while N > 0 do
  begin
    Result := Fill(1);
    if Result <> 0 then
      Exit;
    k := FInEnd - FInPos;
    if k > N then
      k := N;
    FInPos := FInPos + k;
    N := N - k;
  end;
end;

{ The nine octets before the next frame's payload (4.1): its type, its
  flags, its stream and the payload's length. 0; or H2Eof, or what the
  read answered; or, above 0, the code of a connection error, its
  reason in FWhy }
function THttp2Conn.ReadHead(out Typ, Flags, Id, N: Integer): Integer;
begin
  Typ := 0;
  Flags := 0;
  Id := 0;
  N := 0;
  Result := Fill(9);
  if Result <> 0 then
    Exit;
  if (not FGotFrame) and (Copy(FIn, FInPos, 5) = 'HTTP/') then
  begin
    { as Go says it of a frame header that looks like HTTP/1.1's status line }
    FWhy := 'the server answered in HTTP/1: it does not speak HTTP/2 here';
    Result := H2ProtocolError;
    Exit;
  end;
  FGotFrame := True;
  N := (Ord(FIn[FInPos]) shl 16) or (Ord(FIn[FInPos + 1]) shl 8) or Ord(FIn[FInPos + 2]);
  Typ := Ord(FIn[FInPos + 3]);
  Flags := Ord(FIn[FInPos + 4]);
  Id := U32At(FIn, FInPos + 5) and H2MaxWindow;
  FInPos := FInPos + 9;
  if N > H2ReadFrame then
  begin
    FWhy := 'a frame of ' + IntToStr(N) + ' octets, past the ' + IntToStr(H2ReadFrame) + ' this end takes';
    Result := H2FrameSizeError;
  end;
end;

{ What of a frame needs no lock, for it is the reading routine's own:
  the order of the frames of a field block (6.10), the padding (6.1,
  6.2), and the block itself, decoded when its last frame came (Whole,
  with the stream and the flags of its HEADERS in FContId and
  FContFlags). 0, or the code of a connection error, its reason in
  FWhy }
function THttp2Conn.Before(Typ, Flags, Id: Integer; const Payload: string; out Data: string; out Whole: Boolean;
  out All: THpackFields; out TooLarge: Boolean): Integer;
var
  p, pad, n, size: Integer;
  block, err: string;
begin
  Result := 0;
  Data := '';
  Whole := False;
  All := nil;
  TooLarge := False;
  if FContId <> 0 then
  begin
    if (Typ <> FrContinuation) or (Id <> FContId) then
    begin
      FWhy := 'a frame in the middle of a field block (RFC 9113 6.10)';
      Result := H2ProtocolError;
      Exit;
    end;
  end
  else if Typ = FrContinuation then
  begin
    FWhy := 'CONTINUATION with no field block open';
    Result := H2ProtocolError;
    Exit;
  end;
  n := Length(Payload);
  if Typ = FrData then
  begin
    if Id = 0 then
    begin
      FWhy := 'DATA on stream 0';
      Result := H2ProtocolError;
      Exit;
    end;
    if (Flags and FlPadded) = 0 then
    begin
      Data := Payload;
      Exit;
    end;
    if n < 1 then
    begin
      FWhy := 'a padded DATA frame with no room for its padding''s length';
      Result := H2FrameSizeError;
      Exit;
    end;
    pad := Ord(Payload[1]);
    if pad > n - 1 then
    begin
      FWhy := 'padding longer than its frame';
      Result := H2ProtocolError;
      Exit;
    end;
    Data := Copy(Payload, 2, n - 1 - pad);
    Exit;
  end;
  if (Typ <> FrHeaders) and (Typ <> FrContinuation) then
    Exit;
  if Typ = FrHeaders then
  begin
    if Id = 0 then
    begin
      FWhy := 'HEADERS on stream 0';
      Result := H2ProtocolError;
      Exit;
    end;
    p := 1;
    pad := 0;
    if (Flags and FlPadded) <> 0 then
    begin
      if n < 1 then
      begin
        FWhy := 'a padded HEADERS frame with no room for its padding''s length';
        Result := H2FrameSizeError;
        Exit;
      end;
      pad := Ord(Payload[1]);
      p := 2;
    end;
    if (Flags and FlPriority) <> 0 then
    begin
      { the priority of RFC 7540, which RFC 9113 5.3.2 no longer uses: let by }
      if n - p + 1 < 5 then
      begin
        FWhy := 'a HEADERS frame with no room for its priority';
        Result := H2FrameSizeError;
        Exit;
      end;
      p := p + 5;
    end;
    if pad > n - p + 1 then
    begin
      FWhy := 'padding longer than its frame';
      Result := H2ProtocolError;
      Exit;
    end;
    if (p = 1) and (pad = 0) then
      FContFirst := Payload
    else
      FContFirst := Copy(Payload, p, n - p + 1 - pad);
    FContId := Id;
    FContFlags := Flags;
    FContMore := nil;
    size := Length(FContFirst);
  end
  else
  begin
    if FContMore = nil then
    begin
      FContMore := TStringBuilder.Create(2 * Length(FContFirst) + n + 64);
      FContMore.AddText(FContFirst);
      FContFirst := '';
    end;
    FContMore.AddText(Payload);
    size := FContMore.ByteLength;
  end;
  { A block is kept until its last frame, so it has a bound of its own,
    twice what its fields may take: a list within the budget is not
    longer than that written out. Go bounds it the same (readMetaFrame) }
  if size > 2 * FOpt.MaxHeaderBytes then
  begin
    FWhy := 'a field block of more than ' + IntToStr(2 * FOpt.MaxHeaderBytes) + ' octets';
    Result := H2EnhanceYourCalm;
    Exit;
  end;
  if (Flags and FlEndHeaders) = 0 then
    Exit;
  if FContMore = nil then
    block := FContFirst
  else
    block := FContMore.ToString;
  FContFirst := '';
  FContMore := nil;
  { the id stays in FContId for the caller, which ends the block }
  if not HpackDecode(FDec, block, FOpt.MaxHeaderBytes, All, TooLarge, err) then
  begin
    FWhy := 'a field block that is not HPACK: ' + err;
    Result := H2CompressionError;
    Exit;
  end;
  Whole := True;
end;

{ a connection error (5.4.1), found by the reading routine under FMu:
  its loop sends GOAWAY and ends the connection }
procedure THttp2Conn.ConnError(Code: Integer; const Why: string);
begin
  if FConnErr <> 0 then
    Exit;
  FConnErr := Code;
  FWhy := Why;
end;

{ a stream error (5.4.2): RST_STREAM to the peer, and the request, when
  there is one, fails for Why }
procedure THttp2Conn.StreamError(S: TH2Stream; Id, Code: Integer; const Why: string);
begin
  FOwed := FOwed + RstFrame(Id, Code);
  if S = nil then
    Exit;
  if S.Err = '' then
    S.Err := Why;
  Finish(S);
end;

{ N octets of content were taken (6.9): the peer is told, of the
  connection and of S unless it is nil, once half a window is used up.
  Go's rule sends an update for every 4 KiB taken as well, a write for
  nearly every frame; half the window keeps the peer sending without a
  pause just the same, since what is taken here is kept, within its
  budget, and never waits for a reader }
procedure THttp2Conn.GiveBack(S: TH2Stream; N: Integer);
begin
  FRecvUnacked := FRecvUnacked + N;
  if FRecvUnacked >= H2ConnWindow div 2 then
  begin
    FOwed := FOwed + Frame(FrWindowUpdate, 0, 0, Be32(FRecvUnacked));
    FRecvWindow := FRecvWindow + FRecvUnacked;
    FRecvUnacked := 0;
  end;
  if S = nil then
    Exit;
  S.RecvUnacked := S.RecvUnacked + N;
  if S.RecvUnacked >= H2StreamWindow div 2 then
  begin
    FOwed := FOwed + Frame(FrWindowUpdate, 0, S.Id, Be32(S.RecvUnacked));
    S.RecvWindow := S.RecvWindow + S.RecvUnacked;
    S.RecvUnacked := 0;
  end;
end;

{ the peer ended the stream: the response is whole, when its content
  is as long as its content-length said (8.1.1); a response to HEAD
  and a 304 say a length and carry nothing (RFC 9110 8.6) }
procedure THttp2Conn.EndOfStream(S: TH2Stream);
begin
  if (S.WantLength >= 0) and (not S.IsHead) and (S.Status <> 304) and (S.Received <> S.WantLength) then
  begin
    StreamError(S, S.Id, H2ProtocolError, 'http2: malformed response: content of ' + IntToStr(S.Received) +
      ' octets and a content-length of ' + IntToStr(S.WantLength));
    Exit;
  end;
  S.Ok := True;
  Finish(S);
end;

{ a field block: a response's header fields, an interim response's, or
  the trailers (8.1) }
procedure THttp2Conn.OnHeaders(Id: Integer; EndStream: Boolean; const All: THpackFields; TooLarge: Boolean);
var
  s: TH2Stream;
  status, size, clen: Integer;
  fields: THpackFields;
  why: string;
begin
  if not TryGet(FStreams, Id, s) then
  begin
    { a stream this end gave up is closed, and what was on its way is
      let by (5.1); one that was never opened is the peer's error }
    if ((Id and 1) = 0) or (Id >= FNextId) then
      ConnError(H2ProtocolError, 'a field block on a stream that was never opened');
    Exit;
  end;
  if TooLarge then
  begin
    { not a fault of the protocol's, for the limit is advice (6.5.2):
      this end gives the request up, which CANCEL says, where Go says
      PROTOCOL_ERROR }
    StreamError(s, Id, H2Cancel, 'http2: the response''s header fields are past their budget of ' +
      IntToStr(FOpt.MaxHeaderBytes) + ' octets');
    Exit;
  end;
  why := ResponseFields(All, s.GotHeaders, status, fields, size, clen);
  if why <> '' then
  begin
    StreamError(s, Id, H2ProtocolError, 'http2: malformed response: ' + why);
    Exit;
  end;
  if s.GotHeaders then
  begin
    if not EndStream then
    begin
      StreamError(s, Id, H2ProtocolError, 'http2: malformed response: a second field block that does not end it');
      Exit;
    end;
    s.Trailers := fields;
    EndOfStream(s);
    Exit;
  end;
  if (status >= 100) and (status <= 199) then
  begin
    { an interim response: let by, its size counted so that there is
      an end to them. 101 is not of HTTP/2 (8.6) }
    if EndStream or (status = 101) then
    begin
      StreamError(s, Id, H2ProtocolError, 'http2: malformed response: an interim response of status ' +
        IntToStr(status) + ' that HTTP/2 does not have, or that ends the stream');
      Exit;
    end;
    s.InterimBytes := s.InterimBytes + size;
    if s.InterimBytes > FOpt.MaxHeaderBytes then
      StreamError(s, Id, H2Cancel, 'http2: the interim responses are past the budget of ' +
        IntToStr(FOpt.MaxHeaderBytes) + ' octets');
    Exit;
  end;
  s.GotHeaders := True;
  s.Status := status;
  s.Fields := fields;
  s.WantLength := clen;
  { content that its own content-length puts past the budget is not
    waited for; a response to HEAD and a 304 say a length and carry none }
  if (clen > s.MaxBody) and (not s.IsHead) and (status <> 304) then
  begin
    StreamError(s, Id, H2Cancel, 'http2: the response''s content is past its budget of ' + IntToStr(s.MaxBody) +
      ' octets');
    Exit;
  end;
  if EndStream then
    EndOfStream(s);
end;

{ Content of N octets comes on stream Id, in a frame of Counted with
  its padding, which is what the windows count (6.1, 6.9.1). All that
  does not depend on the content itself is settled here: the windows,
  the state of the stream, its budget and what content-length said.
  The stream, with room made in its Buf, when the content is to be
  kept; nil when it is to be let by, the connection's window given
  back and the fault, when it is one, answered. Under FMu }
function THttp2Conn.DataBegin(Id, N, Counted: Integer): TH2Stream;
var
  s: TH2Stream;
  need, room: Integer;
begin
  Result := nil;
  { Neither window can be overrun while a frame is no larger than half
    of each (H2ReadFrame, H2StreamWindow, H2ConnWindow): the windows are
    given back at half. The two checks stand for when those constants
    change, and scripts/check_http2_variants.py changes them }
  if Counted > FRecvWindow then
  begin
    ConnError(H2FlowControlError, 'more content than the connection''s window let');
    Exit;
  end;
  FRecvWindow := FRecvWindow - Counted;
  if not TryGet(FStreams, Id, s) then
  begin
    if ((Id and 1) = 0) or (Id >= FNextId) then
      ConnError(H2ProtocolError, 'content on a stream that was never opened')
    else
      GiveBack(nil, Counted);
    Exit;
  end;
  if Counted > s.RecvWindow then
  begin
    ConnError(H2FlowControlError, 'more content than the stream''s window let');
    Exit;
  end;
  s.RecvWindow := s.RecvWindow - Counted;
  if not s.GotHeaders then
  begin
    GiveBack(nil, Counted);
    StreamError(s, Id, H2ProtocolError, 'http2: malformed response: content before its header fields');
    Exit;
  end;
  if s.IsHead and (N > 0) then
  begin
    GiveBack(nil, Counted);
    StreamError(s, Id, H2ProtocolError, 'http2: malformed response: content in answer to HEAD');
    Exit;
  end;
  need := s.Received + N;
  if need > s.MaxBody then
  begin
    GiveBack(nil, Counted);
    StreamError(s, Id, H2Cancel, 'http2: the response''s content is past its budget of ' + IntToStr(s.MaxBody) +
      ' octets');
    Exit;
  end;
  if (s.WantLength >= 0) and (need > s.WantLength) then
  begin
    GiveBack(nil, Counted);
    StreamError(s, Id, H2ProtocolError, 'http2: malformed response: more content than its content-length of ' +
      IntToStr(s.WantLength));
    Exit;
  end;
  if Length(s.Buf) < need then
  begin
    { room: what content-length promises, once; without it twice what
      there is, the budget at most. A response of one frame gets its size }
    room := need;
    if (s.WantLength >= need) and (s.WantLength <= s.MaxBody) then
      room := s.WantLength
    else if s.Received > 0 then
    begin
      room := 2 * Length(s.Buf);
      if room < need then
        room := need;
      if room > s.MaxBody then
        room := s.MaxBody;
    end;
    SetLength(s.Buf, room);
  end;
  Result := s;
end;

{ the N octets DataBegin made room for are in S.Buf: they count, the
  windows are given back, and the response ends when the frame said so.
  A request that was given up while its content was read has only the
  connection's window given back. Under FMu }
procedure THttp2Conn.DataEnd(S: TH2Stream; N, Counted: Integer; EndStream: Boolean);
begin
  if S.Ended then
  begin
    GiveBack(nil, Counted);
    Exit;
  end;
  S.Received := S.Received + N;
  if EndStream then
  begin
    GiveBack(nil, Counted);
    EndOfStream(S);
  end
  else
    GiveBack(S, Counted);
end;

{ content that was read with its frame: padded, empty, or come in the
  middle of what the read loop does not take the short way for }
procedure THttp2Conn.OnData(Id: Integer; EndStream: Boolean; const Data: string; Counted: Integer);
var
  s: TH2Stream;
  n: Integer;
begin
  n := Length(Data);
  s := DataBegin(Id, n, Counted);
  if s = nil then
    Exit;
  if n > 0 then
    Move(Data[1], s.Buf[s.Received + 1], n);
  DataEnd(s, n, Counted, EndStream);
end;

{ SETTINGS (6.5): the peer's limits, taken in the order they come, and
  acknowledged }
procedure THttp2Conn.OnSettings(Flags, Id: Integer; const Payload: string);
var
  p, sid, v, delta, k: Integer;
  s: TH2Stream;
  sawStreams: Boolean;
begin
  if Id <> 0 then
  begin
    ConnError(H2ProtocolError, 'SETTINGS on a stream');
    Exit;
  end;
  if (Flags and FlAck) <> 0 then
  begin
    if Payload <> '' then
      ConnError(H2FrameSizeError, 'a SETTINGS acknowledgement with content')
    else if FSettingsAcked then
      ConnError(H2ProtocolError, 'a SETTINGS acknowledgement nobody asked for')
    else
      FSettingsAcked := True;
    Exit;
  end;
  if Length(Payload) mod 6 <> 0 then
  begin
    ConnError(H2FrameSizeError, 'SETTINGS whose size is not a number of settings');
    Exit;
  end;
  sawStreams := False;
  p := 1;
  while p <= Length(Payload) do
  begin
    sid := (Ord(Payload[p]) shl 8) or Ord(Payload[p + 1]);
    v := U32At(Payload, p + 2);
    p := p + 6;
    case sid of
      1:
        { the table the peer decodes with: this end's encoder follows,
          and says so at the head of its next block (RFC 7541 4.2). To
          follow before the acknowledgement is written is right too: the
          encoder never uses more than the smaller of the old size and
          the new }
        HpackEncoderLimit(FEnc, v);
      2:
        if v <> 0 then
        begin
          ConnError(H2ProtocolError, 'a server that turns server push on (RFC 9113 6.5.2)');
          Exit;
        end;
      3:
        begin
          FPeerMaxStreams := v;
          sawStreams := True;
        end;
      4:
        begin
          if v > H2MaxWindow then
          begin
            ConnError(H2FlowControlError, 'an initial window past 2^31 - 1');
            Exit;
          end;
          { every open stream's window moves by the difference (6.9.2) }
          delta := v - FPeerInitialWindow;
          FPeerInitialWindow := v;
          for k, s in FStreams do
          begin
            s.SendWindow := s.SendWindow + delta;
            if s.SendWindow > H2MaxWindow then
            begin
              ConnError(H2FlowControlError, 'an initial window that takes a stream''s past 2^31 - 1');
              Exit;
            end;
          end;
        end;
      5:
        begin
          if (v < 16384) or (v > 16777215) then
          begin
            ConnError(H2ProtocolError, 'a largest frame size out of its range');
            Exit;
          end;
          FPeerMaxFrame := v;
        end;
      6:
        FPeerMaxHeaderList := v;
    end;
  end;
  if not FGotSettings then
  begin
    FGotSettings := True;
    { a peer that sets no limit to its streams gets Go's
      (defaultMaxConcurrentStreams) }
    if not sawStreams then
      FPeerMaxStreams := 1000;
  end;
  FOwed := FOwed + Frame(FrSettings, FlAck, 0, '');
  FCond.Broadcast;
end;

{ RST_STREAM (6.4): the peer ended the stream }
procedure THttp2Conn.OnRst(Id: Integer; const Payload: string);
var
  s: TH2Stream;
  code: Integer;
begin
  if Length(Payload) <> 4 then
  begin
    ConnError(H2FrameSizeError, 'RST_STREAM that is not four octets');
    Exit;
  end;
  if (Id = 0) or ((Id and 1) = 0) or (Id >= FNextId) then
  begin
    ConnError(H2ProtocolError, 'RST_STREAM for a stream that was never opened');
    Exit;
  end;
  if not TryGet(FStreams, Id, s) then
    Exit;
  code := U32At(Payload, 1);
  s.ErrorCode := code;
  { REFUSED_STREAM says that nothing was done with the request (8.7) }
  s.Refused := code = H2RefusedStream;
  s.Err := 'http2: the server reset the stream (' + Http2ErrorName(code) + ')';
  Finish(s);
end;

{ PING (6.7): the peer's is answered; an answer ends the ping it is to }
procedure THttp2Conn.OnPing(Flags, Id: Integer; const Payload: string);
var
  i: Integer;
  s: TH2Stream;
begin
  if Length(Payload) <> 8 then
  begin
    ConnError(H2FrameSizeError, 'PING that is not eight octets');
    Exit;
  end;
  if Id <> 0 then
  begin
    ConnError(H2ProtocolError, 'PING on a stream');
    Exit;
  end;
  if (Flags and FlAck) = 0 then
  begin
    FOwed := FOwed + Frame(FrPing, FlAck, 0, Payload);
    Exit;
  end;
  if (FHealthDue <> 0) and (Payload = FHealthData) then
  begin
    { the peer is there: the places kept for requests it had not
      answered are free again }
    FHealthDue := 0;
    FHealthData := '';
    FActive := FActive - FPendingResets;
    FPendingResets := 0;
    FCond.Broadcast;
    { the routine of the deadlines is parked until this PING's; the next
      idle time comes sooner }
    if FOpt.ReadIdleMs > 0 then
      Arm(FLastRead + FOpt.ReadIdleMs * 1000000);
    Exit;
  end;
  for i := 0 to High(FPings) do
    if FPings[i].PingData = Payload then
    begin
      s := FPings[i];
      s.Ok := True;
      Finish(s);
      Exit;
    end;
end;

{ GOAWAY (6.8): the peer takes no stream above the one it names. Those
  it did not take fail as not processed and can be sent again (8.7);
  the others go on, and the connection ends with the last of them }
procedure THttp2Conn.OnGoAway(Id: Integer; const Payload: string);
var
  last, code, k: Integer;
  s: TH2Stream;
begin
  if Id <> 0 then
  begin
    ConnError(H2ProtocolError, 'GOAWAY on a stream');
    Exit;
  end;
  if Length(Payload) < 8 then
  begin
    ConnError(H2FrameSizeError, 'GOAWAY shorter than eight octets');
    Exit;
  end;
  last := U32At(Payload, 1) and H2MaxWindow;
  code := U32At(Payload, 5);
  { a second one may only lower the stream; the first error and the
    first reason are kept, as Go keeps them }
  if (not FGoAway) or (last < FGoAwayLast) then
    FGoAwayLast := last;
  if (not FGoAway) or (FGoAwayCode = H2NoError) then
    FGoAwayCode := code;
  if FGoAwayDebug = '' then
    FGoAwayDebug := Copy(Payload, 9, 1024);
  FGoAway := True;
  for k, s in FStreams do
    if s.Id > FGoAwayLast then
    begin
      s.Refused := True;
      s.ErrorCode := FGoAwayCode;
      s.Err := GoAwayText + ', before it took the request';
      Finish(s);
    end;
  FCond.Broadcast;
  if (not FClosed) and (Length(FStreams) = 0) then
    Fail(GoAwayText, True);
end;

{ WINDOW_UPDATE (6.9): the peer takes more content }
procedure THttp2Conn.OnWindowUpdate(Id: Integer; const Payload: string);
var
  s: TH2Stream;
  more: Integer;
begin
  if Length(Payload) <> 4 then
  begin
    ConnError(H2FrameSizeError, 'WINDOW_UPDATE that is not four octets');
    Exit;
  end;
  more := U32At(Payload, 1) and H2MaxWindow;
  if Id = 0 then
  begin
    if more = 0 then
      ConnError(H2ProtocolError, 'a window update of nothing')
    else if FSendWindow + more > H2MaxWindow then
      ConnError(H2FlowControlError, 'a connection window past 2^31 - 1')
    else
    begin
      FSendWindow := FSendWindow + more;
      FCond.Broadcast;
    end;
    Exit;
  end;
  if ((Id and 1) = 0) or (Id >= FNextId) then
  begin
    ConnError(H2ProtocolError, 'WINDOW_UPDATE for a stream that was never opened');
    Exit;
  end;
  if not TryGet(FStreams, Id, s) then
    Exit;
  if more = 0 then
  begin
    StreamError(s, Id, H2ProtocolError, 'http2: the server sent a window update of nothing');
    Exit;
  end;
  if s.SendWindow + more > H2MaxWindow then
  begin
    StreamError(s, Id, H2FlowControlError, 'http2: the server opened the stream''s window past 2^31 - 1');
    Exit;
  end;
  s.SendWindow := s.SendWindow + more;
  FCond.Broadcast;
end;

{ PRIORITY (6.3): of RFC 7540's priorities, which RFC 9113 no longer
  uses, only the frame's shape is still checked }
procedure THttp2Conn.OnPriority(Id: Integer; const Payload: string);
var
  s: TH2Stream;
begin
  if Id = 0 then
  begin
    ConnError(H2ProtocolError, 'PRIORITY on stream 0');
    Exit;
  end;
  if Length(Payload) = 5 then
    Exit;
  { 6.3: a stream error; of the connection when the stream is not one
    this end opened, for RST_STREAM is not sent for an idle stream (6.4) }
  if ((Id and 1) = 0) or (Id >= FNextId) then
  begin
    ConnError(H2FrameSizeError, 'PRIORITY that is not five octets');
    Exit;
  end;
  s := nil;
  if not TryGet(FStreams, Id, s) then
    s := nil;
  StreamError(s, Id, H2FrameSizeError, 'http2: the server sent PRIORITY that is not five octets');
end;

function THttp2Conn.ReadWhy(R: Integer): string;
var
  why: string;
begin
  if FGoAway then
  begin
    Result := GoAwayText;
    Exit;
  end;
  if R = H2Eof then
  begin
    Result := 'http2: the server closed the connection';
    Exit;
  end;
  why := '';
  if FStream is TTlsStream then
    why := (FStream as TTlsStream).LastError;
  if why = '' then
    why := 'error ' + IntToStr(-R);
  Result := 'http2: reading from the server failed: ' + why;
end;

{ Finish requests, then send the connection error (RFC 9113 5.4.1).
  Keep the timer active until the last write succeeds or must be
  interrupted. True means the reader can half-close and drain. Under FMu. }
function THttp2Conn.SendErrorGoAway: Boolean;
var
  frames, why: string;
begin
  Result := False;
  if (FConnErr = 0) or FBroken then
    Exit;
  why := 'http2: ' + FWhy + ' (' + Http2ErrorName(FConnErr) + ')';
  if FWriteBroken then
  begin
    Fail(why, True);
    Exit;
  end;
  FFailWhy := why;
  FFailDue := PasIoDeadline(H2CloseMs);
  Arm(FFailDue);
  Fail(why, False);
  frames := FOwed + GoAwayFrame(FConnErr);
  FOwed := '';
  Post(frames, True);
  while FWBusy and not FBroken and not FWriteBroken do
    FCond.Wait(FMu);
  if FWriteBroken then
    Fail(why, True);
  if FBroken then
    Exit;
  { Writes are over. The reader closes the transport without aborting it. }
  FBroken := True;
  Poke;
  Result := True;
end;

{ One frame, read and handed to its stream under FMu. False when the
  connection is over, FMu then held }
function THttp2Conn.Step: Boolean;
var
  typ, flags, id, n, r: Integer;
  payload, data: string;
  whole, tooLarge: Boolean;
  all: THpackFields;
  s: TH2Stream;
begin
  Result := False;
  r := ReadHead(typ, flags, id, n);
  if (r = 0) and (typ = FrData) and (n > 0) and (id <> 0) and (FContId = 0) and ((flags and FlPadded) = 0) then
  begin
    { Content, the short way: where it goes is settled before it is
      read, and it is read into its place, FMu let go meanwhile. Only
      this routine touches a stream's Buf until the stream has ended }
    FMu.Lock;
    if FBroken then
      Exit;
    s := nil;
    if not FGotSettings then
      ConnError(H2ProtocolError, 'the server did not begin with SETTINGS')
    else
    begin
      Inc(FReadCount);
      if FOpt.ReadIdleMs > 0 then
        FLastRead := Nanotime;
      s := DataBegin(id, n, n);
    end;
    if FConnErr <> 0 then
      Exit;
    FMu.Unlock;
    if s <> nil then
      r := ReadTo(s.Buf, s.Received, n)
    else
      r := Skip(n);
    FMu.Lock;
    if FBroken then
      Exit;
    if r <> 0 then
      Fail(ReadWhy(r), True)
    else if s <> nil then
      DataEnd(s, n, n, (flags and FlEndStream) <> 0);
    Result := (FConnErr = 0) and not FBroken;
    if Result then
      FMu.Unlock;
    Exit;
  end;
  payload := '';
  whole := False;
  if r = 0 then
    r := ReadBytes(n, payload);
  if r = 0 then
    r := Before(typ, flags, id, payload, data, whole, all, tooLarge);
  FMu.Lock;
  if FBroken then
    Exit;
  if r > 0 then
    FConnErr := r
  else if r < 0 then
    Fail(ReadWhy(r), True)
  else if (not FGotSettings) and ((typ <> FrSettings) or ((flags and FlAck) <> 0)) then
    { 3.4: the server's preface is a SETTINGS frame, its first }
    ConnError(H2ProtocolError, 'the server did not begin with SETTINGS')
  else
  begin
    Inc(FReadCount);
    if FOpt.ReadIdleMs > 0 then
      FLastRead := Nanotime;
    case typ of
      FrData:
        OnData(id, (flags and FlEndStream) <> 0, data, Length(payload));
      FrHeaders, FrContinuation:
        if whole then
        begin
          id := FContId;
          flags := FContFlags;
          FContId := 0;
          OnHeaders(id, (flags and FlEndStream) <> 0, all, tooLarge);
        end;
      FrPriority:
        OnPriority(id, payload);
      FrRstStream:
        OnRst(id, payload);
      FrSettings:
        OnSettings(flags, id, payload);
      FrPushPromise:
        ConnError(H2ProtocolError, 'PUSH_PROMISE, which this end turned off (6.6)');
      FrPing:
        OnPing(flags, id, payload);
      FrGoAway:
        OnGoAway(id, payload);
      FrWindowUpdate:
        OnWindowUpdate(id, payload);
    end;
    { a frame of a type this end does not know is let by (4.1) }
  end;
  Result := (FConnErr = 0) and not FBroken;
  if Result then
    FMu.Unlock;
end;

{ The routine that reads (Go's clientConnReadLoop.run): frame after
  frame. When the connection is over it waits for the last write, gives
  the stream back and ends }
procedure THttp2Conn.ReadLoop;
var
  linger: Boolean;
begin
  while Step do
    ;
  linger := SendErrorGoAway;
  while FWBusy do
    FCond.Wait(FMu);
  FTornDown := True;
  FMu.Unlock;
  if linger then
    FStream.LingerClose(H2DrainBytes, PasIoDeadline(H2CloseMs))
  else
    FStream.Dispose;
  FWg.Done;
end;

{ ---- the calls ---- }

constructor THttp2Conn.Create(Stream: TNetStream; const AScheme, AAuthority: string; const Options: THttp2Options);
var
  hello: string;
begin
  inherited Create;
  FStream := Stream;
  FScheme := AScheme;
  FAuthority := AAuthority;
  FOpt := Options;
  if FOpt.MaxHeaderBytes <= 0 then
    FOpt.MaxHeaderBytes := 1048576;
  if FOpt.MaxBodyBytes <= 0 then
    FOpt.MaxBodyBytes := 67108864;
  if FOpt.WriteTimeoutMs <= 0 then
    FOpt.WriteTimeoutMs := 30000;
  if FOpt.PingTimeoutMs <= 0 then
    FOpt.PingTimeoutMs := 15000;
  if FOpt.ReadIdleMs < 0 then
    FOpt.ReadIdleMs := 0;
  New(FStreams);
  FOut := TStringBuilder.Create(1024);
  SetLength(FIn, H2InBuf);
  FInPos := 1;
  FInEnd := 1;
  FNextId := 1;
  FSendWindow := H2InitialWindow;
  FPeerInitialWindow := H2InitialWindow;
  FPeerMaxFrame := 16384;
  { before the peer's SETTINGS, Go's initialMaxConcurrentStreams }
  FPeerMaxStreams := 100;
  FPeerMaxHeaderList := -1;
  FRecvWindow := H2InitialWindow + H2ConnWindow;
  FGoAwayLast := H2MaxWindow;
  FGoAwayCode := -1;
  FTimerFd := -1;
  HpackEncoderInit(FEnc);
  HpackDecoderInit(FDec, 4096);
  if Stream = nil then
    FErr := 'http2: no stream to speak on'
  else
  begin
    { eventfd2(2): 290 on amd64, 19 on arm64; EFD_CLOEXEC and
      EFD_NONBLOCK, as passignal makes its own }
    if Amd64 = 1 then
      FTimerFd := Syscall(290, 0, 526336)
    else
      FTimerFd := Syscall(19, 0, 526336);
    { 3.4: the preface, then SETTINGS; and the connection's window, which
      SETTINGS cannot say (6.9.2). Push is off, the rest are the limits
      of this end }
    hello := H2Preface + Frame(FrSettings, 0, 0, Setting(2, 0) + Setting(4, H2StreamWindow) +
      Setting(5, H2ReadFrame) + Setting(6, FOpt.MaxHeaderBytes)) + Frame(FrWindowUpdate, 0, 0, Be32(H2ConnWindow));
    if FTimerFd < 0 then
      FErr := 'http2: no descriptor for the connection''s deadlines'
    else if not FStream.WriteAll(hello, PasIoDeadline(FOpt.WriteTimeoutMs)) then
      FErr := 'http2: the connection preface could not be written';
  end;
  if FErr <> '' then
  begin
    FClosed := True;
    FBroken := True;
    FTornDown := True;
    if FTimerFd >= 0 then
      NetClose(FTimerFd);
    FTimerFd := -1;
    if FStream <> nil then
      FStream.Dispose;
    Exit;
  end;
  FLastRead := Nanotime;
  FWg.Add(2);
  pas Self.ReadLoop;
  pas Self.TimerLoop;
end;

{ as much of Want octets of content as the windows and the peer's
  frame size let go now, taken from the windows (6.9.1; Go's
  awaitFlowControl) }
function THttp2Conn.Credit(S: TH2Stream; Want: Integer): Integer;
begin
  Result := Want;
  if Result > S.SendWindow then
    Result := S.SendWindow;
  if Result > FSendWindow then
    Result := FSendWindow;
  if Result > FPeerMaxFrame then
    Result := FPeerMaxFrame;
  if FActive > 1 then
  begin
    if Result > H2DataChunk then
      Result := H2DataChunk;
  end
  else if Result > H2DataAlone then
    Result := H2DataAlone;
  if Result <= 0 then
  begin
    Result := 0;
    Exit;
  end;
  S.SendWindow := S.SendWindow - Result;
  FSendWindow := FSendWindow - Result;
end;

function THttp2Conn.Request(const Method, Path: string; const Headers: THpackFields; const Body: string;
  TimeoutMs, MaxBody: Integer; out Resp: THttp2Response; out Err: string): Boolean;
var
  s: TH2Stream;
  fields: THpackFields;
  size, n, sent, take: Integer;
  frames: string;
begin
  Result := False;
  Resp := Default(THttp2Response);
  Resp.ErrorCode := -1;
  Err := RequestFields(FScheme, FAuthority, Method, Path, Headers, Length(Body), fields, size);
  if Err <> '' then
    Exit;
  s := TH2Stream.Create;
  s.IsHead := Method = 'HEAD';
  s.MaxBody := MaxBody;
  if s.MaxBody <= 0 then
    s.MaxBody := FOpt.MaxBodyBytes;
  s.WantLength := -1;
  s.ErrorCode := -1;
  s.TimedAt := -1;
  s.TimeoutMs := TimeoutMs;
  n := Length(Body);
  FMu.Lock;
  if TimeoutMs > 0 then
  begin
    s.Deadline := PasIoDeadline(TimeoutMs);
    Watch(s);
  end;
  { a place among the streams the peer lets be open at once (5.1.2) }
  while (not s.Ended) and (not FClosed) and (not FGoAway) and (not FWriteBroken) and (FActive >= FPeerMaxStreams) do
    FCond.Wait(FMu);
  if s.Ended or FClosed or FGoAway or FWriteBroken or (FNextId > H2MaxWindow) or
    ((FPeerMaxHeaderList >= 0) and (size > FPeerMaxHeaderList)) then
  begin
    { the request does not leave }
    Resp.NotProcessed := True;
    if s.Ended then
    begin
      Err := s.Err;
      Resp.TimedOut := True;
    end
    else if FClosed then
      Err := FErr
    else if FGoAway then
      Err := GoAwayText
    else if FWriteBroken then
      Err := FFailWhy
    else if FNextId > H2MaxWindow then
      Err := 'http2: the connection has used all its stream numbers'
    else
    begin
      Err := 'http2: the request''s header fields take ' + IntToStr(size) + ' octets and the server takes ' +
        IntToStr(FPeerMaxHeaderList);
      Resp.NotProcessed := False;
    end;
    Finish(s);
    FMu.Unlock;
    Exit;
  end;
  Inc(FActive);
  s.HasSlot := True;
  s.Id := FNextId;
  FNextId := FNextId + 2;
  { 5.1.1: a connection that has used its stream numbers takes no more
    requests; those on their way go on, and it ends with the last }
  if FNextId > H2MaxWindow then
    FSpent := True;
  FStreams[s.Id] := s;
  s.SendWindow := FPeerInitialWindow;
  s.RecvWindow := H2StreamWindow;
  s.ReadMark := FReadCount;
  { A path enters the compression's table when the request before it
    had the same one, as with an API of one address, and not when each
    request has its own, as with a push to a device, which would only
    push the fields worth keeping out of the table. Go's encoder puts
    every path in; nghttp2's none }
  fields[2].Once := Path <> FLastPath;
  FLastPath := Path;
  { the first of the content goes with the field block, in one write,
    when the windows let it }
  take := Credit(s, n);
  frames := HeaderFrames(s.Id, HpackEncode(FEnc, fields), n = 0, FPeerMaxFrame);
  if take > 0 then
    frames := frames + DataFrame(s.Id, take = n, Body, 1, take);
  sent := take;
  Post(frames, True);
  { the rest as the windows open (6.9) }
  while (sent < n) and (not s.Ended) and not FWriteBroken do
  begin
    if FOut.ByteLength > H2OutMax then
    begin
      FCond.Wait(FMu);
      Continue;
    end;
    take := Credit(s, n - sent);
    if take = 0 then
    begin
      FCond.Wait(FMu);
      Continue;
    end;
    if (take >= H2Unframed) and (not FWBusy) and (not FBroken) and not FWriteBroken then
    begin
      { much content and nobody writing: it goes from where it is }
      FWBusy := True;
      WriteContent(s, Body, sent, take, sent + take = n);
    end
    else
      Post(DataFrame(s.Id, sent + take = n, Body, sent + 1, take), True);
    sent := sent + take;
  end;
  while not s.Ended do
    s.Wake.Wait(FMu);
  if s.Ok then
  begin
    { 8.1: a response that came whole before the request's content had
      all gone ends the request too; the peer is told to expect no more }
    if sent < n then
      Post(RstFrame(s.Id, H2NoError), False);
    Resp.Status := s.Status;
    Resp.Fields := s.Fields;
    Resp.Trailers := s.Trailers;
    if Length(s.Buf) <> s.Received then
      SetLength(s.Buf, s.Received);
    Resp.Body := s.Buf;
    Result := True;
  end
  else
  begin
    Err := s.Err;
    Resp.NotProcessed := s.Refused;
    Resp.TimedOut := s.TimedOut;
    Resp.ErrorCode := s.ErrorCode;
    if s.GotHeaders then
    begin
      Resp.Status := s.Status;
      Resp.Fields := s.Fields;
    end;
    if s.TimedOut then
    begin
      { the peer is told that the request was given up; neither frame
        is waited for, the deadline has passed }
      Post(RstFrame(s.Id, H2Cancel), False);
      if s.AskPeer then
        HealthPing;
    end;
  end;
  FMu.Unlock;
end;

function THttp2Conn.Ping(TimeoutMs: Integer): Boolean;
var
  s: TH2Stream;
begin
  Result := False;
  s := TH2Stream.Create;
  s.TimedAt := -1;
  s.ErrorCode := -1;
  FMu.Lock;
  if FClosed or FWriteBroken then
  begin
    FMu.Unlock;
    Exit;
  end;
  Inc(FPingSeq);
  s.PingData := Be32(0) + Be32(FPingSeq);
  if TimeoutMs > 0 then
  begin
    s.Deadline := PasIoDeadline(TimeoutMs);
    Watch(s);
  end;
  FPings := Append(FPings, s);
  Post(Frame(FrPing, 0, 0, s.PingData), True);
  while not s.Ended do
    s.Wake.Wait(FMu);
  Result := s.Ok;
  FMu.Unlock;
end;

procedure THttp2Conn.Dispose;
begin
  FMu.Lock;
  if not FClosed then
  begin
    FUserClosed := True;
    Fail('http2: the connection was disposed of', False);
    Post(GoAwayFrame(H2NoError), True);
    while FWBusy and not FBroken do
      FCond.Wait(FMu);
    { no more is read: the reading routine comes back, and ends the
      connection in order }
    if not FTornDown then
      FStream.Shutdown(0);
  end;
  FMu.Unlock;
  FWg.Wait;
end;

function THttp2Conn.Alive: Boolean;
begin
  FMu.Lock;
  Result := (not FClosed) and (not FGoAway) and (not FSpent) and not FWriteBroken;
  FMu.Unlock;
end;

function THttp2Conn.LastError: string;
begin
  FMu.Lock;
  Result := FErr;
  FMu.Unlock;
end;

function THttp2Conn.GoAwayData: string;
begin
  FMu.Lock;
  Result := FGoAwayDebug;
  FMu.Unlock;
end;

function THttp2Conn.Streams: Integer;
begin
  FMu.Lock;
  Result := Length(FStreams);
  FMu.Unlock;
end;

function THttp2Conn.PeerMaxStreams: Integer;
begin
  FMu.Lock;
  Result := FPeerMaxStreams;
  FMu.Unlock;
end;

{ ---- making a connection ---- }

function Http2Authority(const Host: string; Port: Integer; Tls: Boolean): string;
var
  i, own: Integer;
  v6: Boolean;
begin
  own := 80;
  if Tls then
    own := 443;
  v6 := False;
  for i := 1 to Length(Host) do
    if Host[i] = ':' then
      v6 := True;
  Result := Host;
  if v6 and (Host[1] <> '[') then
    Result := '[' + Host + ']';
  if Port <> own then
    Result := Result + ':' + IntToStr(Port);
end;

function Http2Dial(const Host: string; Port, ConnectMs: Integer; Config: TTlsConfig; const Options: THttp2Options;
  out Err: string): THttp2Conn;
var
  cfg: TTlsConfig;
  tls: TTlsStream;
  chosen: string;
begin
  Result := nil;
  Err := '';
  { the caller's configuration with h2 as the one protocol offered
    (3.2); its own is left as it was }
  cfg := TTlsConfig.Create;
  if Config <> nil then
  begin
    cfg.ServerName := Config.ServerName;
    cfg.MinVersion := Config.MinVersion;
    cfg.MaxVersion := Config.MaxVersion;
    cfg.RootsPem := Config.RootsPem;
    cfg.InsecureSkipVerify := Config.InsecureSkipVerify;
    cfg.NowUnix := Config.NowUnix;
  end;
  SetLength(cfg.Alpn, 1);
  cfg.Alpn[0] := 'h2';
  tls := TlsDial(Host, Port, ConnectMs, cfg, Err);
  if tls = nil then
    Exit;
  chosen := tls.Protocol;
  if chosen <> 'h2' then
  begin
    if chosen = '' then
      Err := 'http2: the server chose no protocol: it does not speak HTTP/2 here'
    else
      Err := 'http2: the server chose ' + chosen + ', not h2';
    tls.Dispose;
    Exit;
  end;
  Result := THttp2Conn.Create(tls, 'https', Http2Authority(Host, Port, True), Options);
  if not Result.Alive then
  begin
    Err := Result.LastError;
    Result := nil;
  end;
end;

function Http2DialPlain(const Host: string; Port, ConnectMs: Integer; const Options: THttp2Options;
  out Err: string): THttp2Conn;
var
  raw: TNetStream;
begin
  Result := nil;
  Err := '';
  raw := DialTcp(Host, Port, ConnectMs);
  if raw = nil then
  begin
    Err := 'dial tcp ' + Host + ':' + IntToStr(Port) + ': connection failed';
    Exit;
  end;
  Result := THttp2Conn.Create(raw, 'http', Http2Authority(Host, Port, False), Options);
  if not Result.Alive then
  begin
    Err := Result.LastError;
    Result := nil;
  end;
end;

constructor THttp2Client.Create(const Host: string; Port: Integer; Config: TTlsConfig; const Options: THttp2Options);
begin
  inherited Create;
  FHost := Host;
  FPort := Port;
  FConfig := Config;
  FOptions := Options;
  ConnectTimeoutMs := 10000;
end;

{ the routine that makes a connection: what comes of it is in D for
  every request that waits for it, and in the client when the client
  was not disposed of meanwhile }
procedure THttp2Client.Dialer(D: TH2Dial; Epoch: Integer);
var
  c, stale: THttp2Conn;
  err: string;
begin
  if Plain then
    c := Http2DialPlain(FHost, FPort, ConnectTimeoutMs, FOptions, err)
  else
    c := Http2Dial(FHost, FPort, ConnectTimeoutMs, FConfig, FOptions, err);
  stale := nil;
  FMu.Lock;
  if FDial = D then
    FDial := nil;
  if c <> nil then
  begin
    if Epoch = FEpoch then
    begin
      FConn := c;
      Inc(FDials);
    end
    else
    begin
      stale := c;
      c := nil;
      err := 'http2: the client was disposed of while its connection was being made';
    end;
  end;
  D.Conn := c;
  D.Err := err;
  Close(D.Finished);
  FMu.Unlock;
  if stale <> nil then
    stale.Dispose;
end;

{ The connection to use: the one held while it takes requests, else
  the one a routine of the client's is making, waited for until Due (a
  Nanotime, 0 none); Late says the wait ended at Due. A connection that
  is going away is let go and not disposed of: the requests it still
  carries end on it, and it ends itself with the last of them }
function THttp2Client.Conn(Due: Integer; out Err: string; out Late: Boolean): THttp2Conn;
var
  d: TH2Dial;
  fin: chan of Integer;
  v: Integer;
  got: Boolean;
begin
  Result := nil;
  Err := '';
  Late := False;
  FMu.Lock;
  if (FConn <> nil) and not FConn.Alive then
    FConn := nil;
  if FConn <> nil then
  begin
    Result := FConn;
    FMu.Unlock;
    Exit;
  end;
  if FDial = nil then
  begin
    d := TH2Dial.Create;
    d.Finished := MakeChan();
    FDial := d;
    pas Self.Dialer(d, FEpoch);
  end;
  d := FDial;
  FMu.Unlock;
  fin := d.Finished;
  if Due = 0 then
    v := Recv(fin)
  else
  begin
    { no wait on a channel has a deadline of its own: the channel is
      looked at every two milliseconds until it is closed or Due passes }
    got := False;
    while (not got) and not Late do
    begin
      select
        Recv(fin, v): got := True;
      else
        Late := Nanotime >= Due;
      end;
      if (not got) and not Late then
        Sleep(2);
    end;
    if Late then
    begin
      Err := 'http2: no connection within the request''s deadline';
      Exit;
    end;
  end;
  Result := d.Conn;
  Err := d.Err;
end;

function THttp2Client.Request(const Method, Path: string; const Headers: THpackFields; const Body: string;
  TimeoutMs, MaxBody: Integer; out Resp: THttp2Response; out Err: string): Boolean;
var
  c: THttp2Conn;
  attempt, due, left: Integer;
  late: Boolean;
begin
  Result := False;
  due := 0;
  if TimeoutMs > 0 then
    due := PasIoDeadline(TimeoutMs);
  for attempt := 1 to 2 do
  begin
    c := Conn(due, Err, late);
    left := 0;
    if due <> 0 then
    begin
      left := (due - Nanotime) div 1000000;
      if (left <= 0) and (c <> nil) then
      begin
        c := nil;
        late := True;
        Err := 'http2: no response within ' + IntToStr(TimeoutMs) + ' ms';
      end;
    end;
    if c = nil then
    begin
      { the request did not leave }
      Resp := Default(THttp2Response);
      Resp.ErrorCode := -1;
      Resp.NotProcessed := True;
      Resp.TimedOut := late;
      Exit;
    end;
    Result := c.Request(Method, Path, Headers, Body, left, MaxBody, Resp, Err);
    { 8.7: what the server did not act on is sent again, once }
    if Result or (not Resp.NotProcessed) or Resp.TimedOut then
      Exit;
  end;
end;

function THttp2Client.Dials: Integer;
begin
  FMu.Lock;
  Result := FDials;
  FMu.Unlock;
end;

procedure THttp2Client.Dispose;
var
  c: THttp2Conn;
begin
  FMu.Lock;
  Inc(FEpoch);
  FDial := nil;
  c := FConn;
  FConn := nil;
  FMu.Unlock;
  if c <> nil then
    c.Dispose;
end;

end.
