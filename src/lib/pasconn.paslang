{ Connections (P432): the stream a protocol client reads and writes, as one
  object whatever carries it. A TNetStream gives the bytes in and out with a
  deadline on each wait (the routine that waits parks), TTcpStream is a TCP
  or Unix socket, and a TLS unit gives another kind through TlsDialer (RFC
  8446 on top of a TcpStream). HTTP, IMAP and SMTP clients are written
  against TNetStream, so each is TLS-ready when TlsDialer is set. Free of
  units but sysutils and pasnet, and of state (Regla 11); a stream belongs
  to the routine that uses it. }
unit pasconn;

interface

uses
  sysutils, pasnet;

type
  { an open connection to a server }
  TNetStream = class
  public
    { up to MaxN bytes before Deadline (a Nanotime, 0 none): the count, 0
      at the end of the stream, -110 at the deadline, -errno }
    function ReadSome(MaxN, Deadline: Integer; out Data: string): Integer; virtual;
    { the same into memory of the caller's, MaxN octets at P: nothing is
      made for the read, which is what a reader of much data wants }
    function ReadInto(P: Pointer; MaxN, Deadline: Integer): Integer; virtual;
    { all of Data before Deadline; False when the peer is gone or time ran out }
    function WriteAll(const Data: string; Deadline: Integer): Boolean; virtual;
    { the same from memory of the caller's, N octets at P: nothing is
      copied to be written }
    function WriteFrom(P: Pointer; N, Deadline: Integer): Boolean; virtual;
    { the connection is shut without being given back: How 0 ends the
      reading, 1 the writing, 2 both. A routine parked in ReadSome or
      WriteAll on it comes back, which Dispose from another routine does
      not bring about. It never waits }
    procedure Shutdown(How: Integer); virtual;
    { Half-close the writing side, discard up to MaxBytes before the
      absolute Nanotime deadline or transport EOF, then dispose.
      Used by the owner once all other I/O on the stream has stopped. }
    procedure LingerClose(MaxBytes, Deadline: Integer); virtual;
    procedure Dispose; virtual;
  end;

  TTcpStream = class(TNetStream)
  private
    FFd: Integer;
    FReadScratch: string;
    FBorrowed: Boolean;
  public
    constructor Create(AFd: Integer; Borrowed: Boolean = False);
    function ReadSome(MaxN, Deadline: Integer; out Data: string): Integer; override;
    function ReadInto(P: Pointer; MaxN, Deadline: Integer): Integer; override;
    function WriteAll(const Data: string; Deadline: Integer): Boolean; override;
    function WriteFrom(P: Pointer; N, Deadline: Integer): Boolean; override;
    procedure Shutdown(How: Integer); override;
    procedure Dispose; override;
  end;

  { A reader's owned buffer. Reads advance its position and only compact
    storage when a refill needs room. A zero-initialized buffer is empty. }
  TNetReadBuffer = record
  private
    FStorage: string;
    FFirst, FEnd: Integer;
  public
    procedure Reset(const Data: string = '');
    function Pending: Integer;
    function TakePending: string;
  end;

  { dials a TLS connection to Host:Port within ConnectMs; the TLS unit sets
    TlsDialer. Dial gives nil when it could not. }
  TNetDialer = class
  public
    function Dial(const Host: string; Port, ConnectMs: Integer): TNetStream; virtual;
  end;

  { Upgrades a server-side stream. Accept takes ownership of Raw,
    including on failure. Protocol restricts negotiation when nonempty. }
  TNetAcceptor = class
  public
    function Accept(Raw: TNetStream; Deadline: Integer; const Protocol: string;
      out Err: string): TNetStream; virtual;
  end;

  { turns a connection already open into a TLS one, for STARTTLS (SMTP, IMAP):
    Host is the server name to check. The TLS unit sets TlsUpgrader. Upgrade
    gives nil when the handshake failed (the connection is then of no use). }
  TNetUpgrader = class
  public
    function Upgrade(S: TNetStream; const Host: string; ConnectMs: Integer): TNetStream; virtual;
  end;

var
  { nil until a TLS unit sets one }
  TlsDialer: TNetDialer;
  { nil until a TLS unit sets one }
  TlsUpgrader: TNetUpgrader;

{ A TCP connection to Host:Port within Ms milliseconds (0 none), the name's
  resolution included; nil when it fails }
function DialTcp(const Host: string; Port, Ms: Integer): TNetStream;
{ A Unix socket }
function DialUnix(const Path: string): TNetStream;
{ A line of the stream (to LF, the CR before it dropped) from Buf and the
  stream, more read into Buf as needed; False at the end of the stream or the
  deadline (Err says which: 0 end, -110 deadline, else -errno), and for a
  line longer than MaxLine (Err is -90) }
function ReadLineFrom(S: TNetStream; var Buf: string; out Line: string; MaxLine, Deadline: Integer; out Err: Integer): Boolean; overload;
function ReadLineFrom(S: TNetStream; var Buf: TNetReadBuffer; out Line: string; MaxLine, Deadline: Integer; out Err: Integer): Boolean; overload;
{ N bytes from Buf and the stream. A failed read leaves pending bytes in Buf. }
function ReadExactFrom(S: TNetStream; var Buf: string; N: Integer; out Data: string; Deadline: Integer; out Err: Integer): Boolean; overload;
function ReadExactFrom(S: TNetStream; var Buf: TNetReadBuffer; N: Integer; out Data: string; Deadline: Integer; out Err: Integer): Boolean; overload;

implementation

function TNetStream.ReadSome(MaxN, Deadline: Integer; out Data: string): Integer;
begin
  Data := '';
  Result := 0;
end;

{ a stream that has only ReadSome reads through it }
function TNetStream.ReadInto(P: Pointer; MaxN, Deadline: Integer): Integer;
var
  data: string;
begin
  Result := ReadSome(MaxN, Deadline, data);
  if Result > 0 then
    Move(data[1], PByte(P)^, Result);
end;

function TNetStream.WriteAll(const Data: string; Deadline: Integer): Boolean;
begin
  Result := False;
end;

{ a stream that has only WriteAll writes through it }
function TNetStream.WriteFrom(P: Pointer; N, Deadline: Integer): Boolean;
var
  data: string;
begin
  Result := True;
  if N <= 0 then
    Exit;
  SetLength(data, N);
  Move(PByte(P)^, data[1], N);
  Result := WriteAll(data, Deadline);
end;

procedure TNetStream.Shutdown(How: Integer);
begin
end;

procedure TNetStream.LingerClose(MaxBytes, Deadline: Integer);
var
  discard: array[0..4095] of Byte;
  want, got: Integer;
begin
  Shutdown(1);
  while (MaxBytes > 0) and (Nanotime < Deadline) do
  begin
    want := SizeOf(discard);
    if want > MaxBytes then
      want := MaxBytes;
    got := ReadInto(@discard[0], want, Deadline);
    if got <= 0 then
      Break;
    MaxBytes := MaxBytes - got;
  end;
  Dispose;
end;

procedure TNetStream.Dispose;
begin
end;

constructor TTcpStream.Create(AFd: Integer; Borrowed: Boolean);
begin
  inherited Create;
  FFd := AFd;
  FBorrowed := Borrowed;
end;

function TTcpStream.ReadSome(MaxN, Deadline: Integer; out Data: string): Integer;
const
  MaxReadScratch = 65536;
begin
  Data := '';
  if FFd < 0 then
    Exit(-9);
  if MaxN <= 0 then
    Exit(0);
  if MaxN > MaxReadScratch then
  begin
    { Keep unusually large reads out of the connection's retained scratch.
      Read into the result itself as TcpRead does. }
    SetLength(Data, MaxN);
    Result := PasIoRead(FFd, @Data[1], MaxN, Deadline);
    if Result > 0 then
      SetLength(Data, Result)
    else
      Data := '';
    Exit;
  end;
  { Reuse private storage as in Go's bufio.Reader and Rust's BufReader.
    The string that leaves this method owns only the bytes actually read. }
  if Length(FReadScratch) < MaxN then
  begin
    FReadScratch := '';
    SetLength(FReadScratch, MaxN);
  end;
  Result := PasIoRead(FFd, @FReadScratch[1], MaxN, Deadline);
  if Result > 0 then
    Data := Copy(FReadScratch, 1, Result);
end;

function TTcpStream.ReadInto(P: Pointer; MaxN, Deadline: Integer): Integer;
begin
  if FFd < 0 then
    Result := -9
  else
    Result := PasIoRead(FFd, P, MaxN, Deadline);
end;

function TTcpStream.WriteAll(const Data: string; Deadline: Integer): Boolean;
var
  p, n: Integer;
begin
  Result := False;
  if FFd < 0 then
    Exit;
  p := 1;
  while p <= Length(Data) do
  begin
    n := PasIoWrite(FFd, @Data[p], Length(Data) - p + 1, Deadline);
    if n <= 0 then
      Exit;
    p := p + n;
  end;
  Result := True;
end;

function TTcpStream.WriteFrom(P: Pointer; N, Deadline: Integer): Boolean;
var
  done, k: Integer;
begin
  Result := False;
  if FFd < 0 then
    Exit;
  done := 0;
  while done < N do
  begin
    k := PasIoWrite(FFd, P + done, N - done, Deadline);
    if k <= 0 then
      Exit;
    done := done + k;
  end;
  Result := True;
end;

procedure TTcpStream.Shutdown(How: Integer);
begin
  if FFd >= 0 then
    TcpShutdown(FFd, How);
end;

procedure TTcpStream.Dispose;
begin
  if FFd >= 0 then
  begin
    if not FBorrowed then TcpClose(FFd);
    FFd := -1;
    FReadScratch := '';
  end;
end;

function TNetAcceptor.Accept(Raw: TNetStream; Deadline: Integer; const Protocol: string;
  out Err: string): TNetStream;
begin
  if Raw <> nil then Raw.Dispose;
  Err := 'no server transport configured';
  Result := nil;
end;

function TNetDialer.Dial(const Host: string; Port, ConnectMs: Integer): TNetStream;
begin
  Result := nil;
end;

function TNetUpgrader.Upgrade(S: TNetStream; const Host: string; ConnectMs: Integer): TNetStream;
begin
  Result := nil;
end;


function DialTcp(const Host: string; Port, Ms: Integer): TNetStream;
var
  fd: Integer;
begin
  Result := nil;
  if Ms > 0 then
    fd := TcpConnectToMs(Host, Port, Ms)
  else
    fd := TcpConnectTo(Host, Port);
  if fd < 0 then
    Exit;
  TcpKeepAlive(fd, True);
  Result := TTcpStream.Create(fd);
end;

function DialUnix(const Path: string): TNetStream;
var
  fd: Integer;
begin
  Result := nil;
  fd := UnixConnect(Path);
  if fd < 0 then
    Exit;
  Result := TTcpStream.Create(fd);
end;

procedure TNetReadBuffer.Reset(const Data: string);
begin
  FStorage := Data;
  FFirst := 0;
  FEnd := Length(Data);
end;

function TNetReadBuffer.Pending: Integer;
begin
  Result := FEnd - FFirst;
end;

procedure Consume(var Buf: TNetReadBuffer; N: Integer);
begin
  Buf.FFirst := Buf.FFirst + N;
  if Buf.FFirst = Buf.FEnd then
  begin
    Buf.FFirst := 0;
    Buf.FEnd := 0;
    if Length(Buf.FStorage) > 65536 then
      Buf.FStorage := '';
  end;
end;

function TNetReadBuffer.TakePending: string;
begin
  Result := Copy(FStorage, FFirst + 1, FEnd - FFirst);
  Consume(Self, FEnd - FFirst);
end;

{ Like Go bufio.Reader.fill, reuse free space or move the unconsumed bytes
  down before admitting a new read. Rust BufReader also reads into its
  spare capacity and advances the initialized length by the actual count. }
function Refill(S: TNetStream; var Buf: TNetReadBuffer; Deadline: Integer): Integer;
const
  Chunk = 16384;
var
  pending, capacity: Integer;
begin
  capacity := Length(Buf.FStorage);
  if capacity - Buf.FEnd < Chunk then
  begin
    pending := Buf.FEnd - Buf.FFirst;
    if Buf.FFirst > 0 then
    begin
      if pending > 0 then
        Move(Buf.FStorage[Buf.FFirst + 1], Buf.FStorage[1], pending);
      Buf.FFirst := 0;
      Buf.FEnd := pending;
    end;
    if capacity - pending < Chunk then
      SetLength(Buf.FStorage, Max(2 * capacity, pending + Chunk));
  end;
  Result := S.ReadInto(@Buf.FStorage[Buf.FEnd + 1], Chunk, Deadline);
  if Result > 0 then
    Buf.FEnd := Buf.FEnd + Result;
end;

function ReadLineFrom(S: TNetStream; var Buf: TNetReadBuffer; out Line: string; MaxLine, Deadline: Integer; out Err: Integer): Boolean;
var
  scanned, pending, rest, lf, lineLen, n: Integer;
begin
  Result := False;
  Err := 0;
  Line := '';
  scanned := 0;
  while True do
  begin
    pending := Buf.FEnd - Buf.FFirst;
    rest := pending - scanned;
    if rest > 0 then
    begin
      lf := IndexByte(Buf.FStorage[Buf.FFirst + scanned + 1], rest, 10);
      if lf >= 0 then
      begin
        lf := lf + scanned;
        lineLen := lf;
        if (lf > 0) and (Buf.FStorage[Buf.FFirst + lf] = #13) then
          lineLen := lineLen - 1;
        Line := Copy(Buf.FStorage, Buf.FFirst + 1, lineLen);
        Consume(Buf, lf + 1);
        if (MaxLine > 0) and (lineLen > MaxLine) then
        begin
          Err := -90;
          Exit;
        end;
        Exit(True);
      end;
    end;
    if (MaxLine > 0) and (pending > MaxLine) and
      ((pending - MaxLine > 1) or (Buf.FStorage[Buf.FEnd] <> #13)) then
    begin
      Err := -90;
      Exit;
    end;
    scanned := pending;
    n := Refill(S, Buf, Deadline);
    if n <= 0 then
    begin
      Err := n;
      Exit;
    end;
  end;
end;

function ReadExactFrom(S: TNetStream; var Buf: TNetReadBuffer; N: Integer; out Data: string; Deadline: Integer; out Err: Integer): Boolean;
var
  nread: Integer;
begin
  Err := 0;
  Data := '';
  if N <= 0 then
    Exit(True);
  while Buf.FEnd - Buf.FFirst < N do
  begin
    nread := Refill(S, Buf, Deadline);
    if nread <= 0 then
    begin
      Err := nread;
      Exit(False);
    end;
  end;
  Data := Copy(Buf.FStorage, Buf.FFirst + 1, N);
  Consume(Buf, N);
  Result := True;
end;

{ The string overloads continue to return the unread bytes as a string. }
function ReadLineFrom(S: TNetStream; var Buf: string; out Line: string; MaxLine, Deadline: Integer; out Err: Integer): Boolean;
var
  reader: TNetReadBuffer;
begin
  reader.Reset(Buf);
  Result := ReadLineFrom(S, reader, Line, MaxLine, Deadline, Err);
  Buf := reader.TakePending;
end;

function ReadExactFrom(S: TNetStream; var Buf: string; N: Integer; out Data: string; Deadline: Integer; out Err: Integer): Boolean;
var
  reader: TNetReadBuffer;
begin
  reader.Reset(Buf);
  Result := ReadExactFrom(S, reader, N, Data, Deadline, Err);
  Buf := reader.TakePending;
end;

end.
