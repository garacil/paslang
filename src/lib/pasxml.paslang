{ XML for a service (P426): a reader that refuses what XML 1.0 (Fifth
  Edition) and Namespaces in XML 1.0 (Third Edition) call not
  well-formed, with the line and column; a document tree that keeps the
  bytes of every node it read, so that a document edited and written
  back differs from the original only where it was edited; a writer;
  and escaping. Free of units but sysutils and of state, so any number of
  routines may use one document or one reader each at once (Regla 11).

  What it takes: UTF-8 (with or without a byte order mark), UTF-16 with
  a byte order mark or as <? written in either order, and ISO-8859-1
  when the declaration says so; the two later are turned into UTF-8
  and written back as UTF-8, with the declaration saying so. Entities:
  the five of XML, character references and the internal general
  entities of the DOCTYPE's internal subset, whose replacement text may
  be text and references but not markup (refused, not misread); the
  parameter entities of the internal subset where a declaration may
  stand; an external DTD is never fetched or read, and an external
  entity only through a Resolver the program gives a reader (P477), none
  by default: a reference to one is refused. With LoadSubset (P511) the
  resolver is asked for the DOCTYPE's external subset and for external
  parameter entities too, which are read with their conditional
  sections. Default attribute values and the rest of the DTD are read
  for their well-formedness and then ignored. }
unit pasxml;

interface

uses
  sysutils;

const
  XmlNamespaceXml = 'http://www.w3.org/XML/1998/namespace';
  XmlNamespaceXmlns = 'http://www.w3.org/2000/xmlns/';

type
  { a string being built: S is longer than the N bytes written }
  TXmlBufRec = record
    S: string;
    N: Integer;
  end;

  { Why a read or an edit refused, and where: Offset is the byte from 0,
    Line and Column count from 1, the column in bytes. The edits that
    refuse (a name that is no name, a second root) give Offset -1. }
  EXmlError = class(Exception)
  public
    Offset: Integer;
    Line: Integer;
    Column: Integer;
    Reason: string;
    constructor CreateAt(AOffset, ALine, ACol: Integer; const AReason: string);
  end;

  TXmlKind = (xkElement, xkText, xkCData, xkComment, xkPI, xkDoctype, xkDecl);

  { An attribute as it was read: its name as written, split at the
    colon, its value with the references expanded and the white space
    changed to spaces, the namespace its prefix is bound to (empty for an
    unprefixed one, and for a declaration), the white space before it
    and its place in the source. }
  TXmlAttr = record
    Name: string;
    Prefix: string;
    Local: string;
    URI: string;
    Value: string;
    Lead: string;
    Quote: Char;
    IsNs: Boolean;      { xmlns or xmlns:p, a declaration }
    Changed: Boolean;
    Defaulted: Boolean; { not written: the DOCTYPE gave it, the tag did not }
    RawStart: Integer;  { from 1; -1 when made here }
    RawStop: Integer;   { the byte after it }
  end;
  TXmlAttrArray = array of TXmlAttr;

  TXmlTokenKind = (xtStart, xtEnd, xtText, xtCData, xtComment, xtPI, xtDecl, xtDoctype);

  { What a reader gives: a start tag, an end tag (a tag like <a/> gives
    both, the end with Synth set), text, a CDATA section, a comment, a
    processing instruction (Name its target, Value its data), the XML
    declaration or the DOCTYPE. Start and Stop are the bytes of the
    whole construct, from 1, Stop the byte after; OpenEnd is the byte
    after a start tag's >. }
  TXmlToken = record
    Kind: TXmlTokenKind;
    Name: string;
    Prefix: string;
    Local: string;
    URI: string;
    Value: string;
    Attrs: TXmlAttrArray;
    Trail: string;      { the white space before > or /> in a start tag }
    SelfClose: Boolean;
    Synth: Boolean;
    Ent: Boolean;       { read from an entity's text: Start, Stop and OpenEnd are places in that text }
    RefName: string;    { the first token of the text of an entity referred to in the document: its name, ... }
    RefStart: Integer;  { ... and the bytes of the reference, from 1, RefStop the byte after }
    RefStop: Integer;
    Start: Integer;
    Stop: Integer;
    OpenEnd: Integer;
  end;

  { What a program gives a reader to read an external parsed entity
    (P477): the bytes of the entity that the public identifier (its white
    space made single spaces and trimmed, '' for none) and the system
    identifier, as the DOCTYPE wrote them, name. Where they are, relative
    to what, and whether they may be read at all is the program's to
    say; an exception refuses the entity, and the read with it. }
  TXmlResolver = function(const PublicId, SystemId: string): string;

  { The pull reader: Next gives the tokens of a document one by one and
    checks it is well-formed as it goes, so a part of any size is read
    in memory proportional to its depth and its longest token. Create
    reads a document; CreateFragment reads content, of any number of
    nodes, in the scope of the bindings given with Bind. }
  TXmlReader = class
  private
    FT: string;
    FN: Integer;
    FP: Integer;
    FBom: Integer;
    FTranscoded: Boolean;
    FFragment: Boolean;
    FSawRoot: Boolean;
    FSawDoctype: Boolean;
    FSynth: Boolean;
    FDepth: Integer;
    FExpanded: Integer;
    FEncoding: string;
    FStandalone: string;
    FVersion: string;
    FSName: array of string;
    FSPrefix: array of string;
    FSLocal: array of string;
    FSURI: array of string;
    FSNs: array of Integer;
    FNsP: array of string;
    FNsU: array of string;
    FNsN: Integer;
    FEName: array of string;
    FEVal: array of string;
    FEExt: array of Boolean;
    FEMk: array of Integer;   { 0 not asked, 1 text only, 2 holds markup, 3 being asked }
    FEPub: array of string;   { an external entity's public identifier }
    FESys: array of string;   { and its system identifier }
    FEUn: array of Boolean;   { unparsed: it has NDATA }
    FEPe: array of Boolean;   { a parameter entity }
    FEDx: array of Boolean;   { declared in a parameter entity or the external subset }
    FPeSeen: Boolean;         { the subset has a parameter entity reference, read or not }
    FBase: string;            { the system identifier of the text being read, '' for the document }
    FPD: Integer;             { how deep the text of parameter entities is being read }
    FSubDepth: Integer;       { how many texts a subset is being read from: a parameter entity, the external subset }
    FSubAt: Integer;          { where an error in them is put: the reference in the document, the DOCTYPE }
    FExtMode: Boolean;        { reading the external subset or an external parameter entity }
    FPeCnt: Integer;          { the references one declaration has had included }
    FDocAt: Integer;          { the DOCTYPE, and the identifiers of its external subset }
    FDocPub: string;
    FDocSys: string;
    FERs: array of Boolean;   { the resolver has been asked, and FEVal is its text }
    FLit: string;             { the literal ReadLiteral read last }
    FEN: Integer;
    FSrc: string;             { the document, while FT is an entity's text }
    FIT: array of string;     { the text each entity being read was reached from }
    FIP: array of Integer;    { where that text goes on, past the reference }
    FID: array of Integer;    { the depth the entity was entered at }
    FIE: array of Integer;    { the entity }
    FIC: Integer;
    FRefAt: Integer;          { the outermost reference, a byte of the document }
    FGrpNew: Boolean;         { an entity was entered and no token of it has been given yet }
    FGrpName: string;         { that entity, and the bytes of its reference }
    FGrpStart: Integer;
    FGrpStop: Integer;
    FTagAt: Integer;          { the start tag being read: where an attribute with no place of its own is }
    FPeRef: Boolean;          { the subset has referred to a parameter entity, which is not read }
    FExtSub: Boolean;         { the DOCTYPE names an external subset, which is not read }
    FAgain: Boolean;
    FAEl: array of string;    { the attributes the internal subset declares }
    FAAt: array of string;
    FADf: array of string;
    FATy: array of Boolean;   { a type other than CDATA }
    FAHas: array of Boolean;  { with a default value }
    FANx: array of Integer;
    FAHead: array of Integer;
    FATail: array of Integer;
    FAN: Integer;
    procedure Init(const AText: string);
    procedure Fail(At: Integer; const Why: string);
    function SkipS: Integer;
    function Has(const S: string): Boolean;
    function ReadName: string;
    function ReadQName: string;
    procedure ReadNotationName;
    procedure CheckChars(AFrom, ATo: Integer);
    procedure Expand(const Raw: string; At0: Integer; InAttr, Nested: Boolean; Depth: Integer; var B: TXmlBufRec);
    function EntityIndex(const Nm: string): Integer;
    function EntityMarkup(Code, Depth: Integer): Boolean;
    function MarkupRefAt(I: Integer; var Code, Semi: Integer): Boolean;
    procedure EnterEntity(Code, RefAt, After: Integer);
    procedure ResolveEntity(Code, At: Integer);
    function ExternalText(const What: string; At: Integer; const Raw: string): string;
    function PeIndex(const Nm: string): Integer;
    function EntRef(Code: Integer): string;
    function ExpandPeAt(I: Integer; Q: Char): Boolean;
    procedure ExpandDecl;
    procedure SkipSPe;
    procedure IncludePE;
    procedure ReadDecls(Mode: Integer);
    procedure ReadConditional;
    procedure ReadExternalSubset;
    function RefIndex(const Nm: string): Integer;
    procedure LeaveEntity;
    procedure DeclAttr(const El, An: string; NonCData, HasDef: Boolean; const Df: string);
    procedure ApplyAttlist(const El: string; var Attrs: TXmlAttrArray; var Na: Integer);
    function NextTok(var Tok: TXmlToken): Boolean;
    procedure ReadCharData(var Tok: TXmlToken);
    procedure ReadStartTag(var Tok: TXmlToken);
    procedure ReadEndTag(var Tok: TXmlToken);
    procedure ReadPI(var Tok: TXmlToken);
    procedure ReadDecl(var Tok: TXmlToken; St: Integer);
    procedure Quoted(const Nm: string; var V: string);
    procedure ReadBang(var Tok: TXmlToken);
    procedure ReadComment(var Tok: TXmlToken);
    procedure ReadCData(var Tok: TXmlToken);
    procedure ReadDoctype(var Tok: TXmlToken);
    procedure ReadSubset;
    procedure ReadEntityDecl;
    procedure ReadLiteral(Pubid: Boolean);
    procedure ReadCp(Lv: Integer);
    procedure ReadGroup(Lv: Integer);
    procedure ReadElementDecl;
    procedure ReadAttlistDecl;
    procedure ReadNotationDecl;
    procedure ReadAttDefault(var HasDef: Boolean; var Df: string);
    function ReadNmtoken: string;
    procedure ScanComment(var VFrom, VTo: Integer);
    procedure ScanPI(var Tgt: string; var VFrom, VTo: Integer);
    procedure BindNs(const Prefix, URI: string);
    function LookupNs(const Prefix: string; var URI: string): Boolean;
    procedure PushElem(const Nm, Pfx, Loc, Uri: string; Mark: Integer);
    procedure PopElem;
    procedure MakeEnd(var Tok: TXmlToken; Synth: Boolean);
  public
    Namespaces: Boolean;     { resolve prefixes (the default), else a name is a name }
    MaxDepth: Integer;       { the deepest nesting a read takes: 10000 }
    MaxExpansion: Integer;   { the most bytes the entities of a document may expand to: 16 MiB }
    Resolver: TXmlResolver;  { reads an external parsed entity; nil, the default, refuses a reference to one }
    LoadSubset: Boolean;     { with a Resolver, also asks it for the DOCTYPE's external subset and the external parameter entities (P511) }
    constructor Create(const AText: string);
    constructor CreateFragment(const AText: string);
    { binds Prefix ('' the default namespace) to URI for a fragment }
    procedure Bind(const Prefix, URI: string);
    { the next token; False at the end of a document that is well-formed;
      EXmlError for what is not }
    function Next(var Tok: TXmlToken): Boolean;
    { after a start token, reads on to its end tag, whatever lies between }
    procedure SkipElement;
    { the open elements }
    function OpenCount: Integer;
    { the line and column of the byte at offset Off (from 0) }
    procedure LineColumn(Off: Integer; var ALine, ACol: Integer);
    { the text as it is read: UTF-8, as it is when the source was UTF-8 }
    function Source: string;
    function BomLength: Integer;
    { the declaration's encoding and standalone, as written, and whether
      the source was turned into UTF-8 }
    property Encoding: string read FEncoding;
    property Standalone: string read FStandalone;
    property Version: string read FVersion;
    property Transcoded: Boolean read FTranscoded;
  end;

  TXmlDoc = class;
  TXmlNode = class;
  TXmlNodeArray = array of TXmlNode;

  { A node of a document: an element, text, CDATA, a comment, a
    processing instruction, the DOCTYPE or the declaration. A node that
    was read knows its bytes; one that is changed, and every element
    above it, is written again as far as it changed, and the rest is
    copied as it was. Z-fields are the tree's own and are not written. }
  TXmlNode = class
  public
    Kind: TXmlKind;
    Name: string;       { as written: a:b; a PI's target; a DOCTYPE's root }
    Prefix: string;
    Local: string;
    URI: string;
    Parent: TXmlNode;
    Doc: TXmlDoc;
    ZValue: string;
    ZAttrs: TXmlAttrArray;
    ZKids: TXmlNodeArray;
    ZCount: Integer;
    ZSrc: string;
    ZStart: Integer;
    ZStop: Integer;
    ZOpenEnd: Integer;
    ZCloseStart: Integer;
    ZTrail: string;
    ZDirty: Boolean;
    ZHead: Boolean;
    ZChanged: Boolean;
    ZNew: Boolean;
    ZRefId: Integer;    { a top-level node of the text of an entity: the reference it came from (0 for none) ... }
    ZRefIdx: Integer;   { ... its place among the nodes the entity gave ... }
    ZRefLen: Integer;   { ... for the first, how many it gave ... }
    ZRefHead: Boolean;
    ZRefName: string;
    ZRefStart: Integer; { ... and, for the first, the bytes of the reference in ZSrc }
    ZRefStop: Integer;
    ZRefDoc: TXmlDoc;
    function GetValue: string;
    procedure SetValue(const S: string);
    { text, CDATA, a comment, a PI's data: the text; changing it writes the
      node again, escaped }
    property Value: string read GetValue write SetValue;
    { all the text of an element's descendants, as DOM's textContent;
      SetText replaces them by one text node (none for '') }
    function Text: string;
    procedure SetText(const S: string);
    { the children, all kinds }
    function Count: Integer;
    function Item(I: Integer): TXmlNode;
    function IndexInParent: Integer;
    { the first element child with that local name (or, with a colon in
      it, that qualified name), and with that namespace and local name;
      nil when none }
    function Elem(const Nm: string): TXmlNode;
    function ElemNS(const AUri, ALocal: string): TXmlNode;
    function Elems(const Nm: string): TXmlNodeArray;
    function ElemsNS(const AUri, ALocal: string): TXmlNodeArray;
    { the element reached by names joined with /, each the first child
      of that name; Self for ''; nil when one is missing }
    function Find(const Path: string): TXmlNode;
    { attributes; a name with a colon is the qualified name }
    function AttrCount: Integer;
    function AttrAt(I: Integer): TXmlAttr;
    function AttrIndex(const Nm: string): Integer;
    function HasAttr(const Nm: string): Boolean;
    function Attr(const Nm: string): string;
    function AttrNS(const AUri, ALocal: string): string;
    procedure SetAttr(const Nm, AValue: string);
    procedure RemoveAttr(const Nm: string);
    { changes to the tree; a node has one parent }
    procedure AddChild(N: TXmlNode);
    procedure InsertChild(Index: Integer; N: TXmlNode);
    procedure RemoveAt(Index: Integer);
    procedure Detach;
    procedure AppendText(const S: string);
    function AddElem(const Nm: string): TXmlNode;
    { content in XML text, read in this element's scope and put in as it
      is written: AppendXml('<c r="A1"><v>1</v></c>') }
    procedure AppendXml(const Fragment: string);
    procedure InsertXml(Index: Integer; const Fragment: string);
    { the node written: its outer XML, and an element's content }
    function OuterXml: string;
    function InnerXml: string;
    { where the node began in the source it was read from (from 0, -1 for
      one made here) and how many bytes it took }
    function Offset: Integer;
    function ByteLength: Integer;
    { the entity this node, or the node it is in, was read from, when the
      text of an entity gave it ('' for any other): a document written
      after an edit writes the reference `&name;` where nothing of the
      entity's nodes was touched, and their text otherwise (P478) }
    function FromEntity: string;
  end;

  { A document: what was read, in order, the root among them. }
  TXmlDoc = class
  public
    Root: TXmlNode;
    ZKids: TXmlNodeArray;
    ZCount: Integer;
    ZSrc: string;
    ZBom: Integer;
    ZDirty: Boolean;
    ZNamespaces: Boolean;
    FEncoding: string;
    FStandalone: string;
    FVersion: string;
    constructor Create;
    function CreateElement(const Nm: string): TXmlNode;
    function CreateText(const S: string): TXmlNode;
    function CreateCData(const S: string): TXmlNode;
    function CreateComment(const S: string): TXmlNode;
    function CreatePI(const ATarget, AData: string): TXmlNode;
    { puts a node at the end of the top level: the root of a document made
      here, a comment before or after it }
    procedure AddTop(N: TXmlNode);
    { the top level nodes: the declaration, comments, the DOCTYPE, the
      root and the white space between them }
    function Count: Integer;
    function Item(I: Integer): TXmlNode;
    { the document written; as it was read when nothing changed }
    function Xml: string;
    { whether writing the document now would write a reference to an entity
      as the nodes it gave, since an edit has changed one of them or the
      way they stand (P478) }
    function EntitiesExpanded: Boolean;
    property Encoding: string read FEncoding;
    property Standalone: string read FStandalone;
    property Version: string read FVersion;
  end;

{ A document read, or EXmlError. XmlParse takes names with prefixes as
  Namespaces in XML does; XmlParseFlat leaves them alone. }
function XmlParse(const S: string): TXmlDoc;
function XmlParseFlat(const S: string): TXmlDoc;
{ False and the reason (with line and column) instead of an exception }
function XmlTryParse(const S: string; out Doc: TXmlDoc; out Err: string): Boolean;
{ A document read with the resolver giving its external entities (P477),
  with prefixes as Namespaces in XML takes them or left alone }
function XmlParseWith(const S: string; AResolver: TXmlResolver; ANamespaces: Boolean): TXmlDoc;
{ and, with the resolver, the external subset the DOCTYPE names and the
  external parameter entities (P511) }
function XmlParseDtd(const S: string; AResolver: TXmlResolver; ANamespaces: Boolean): TXmlDoc;

{ Escaping: text keeps its quotes, an attribute value is for double
  quotes; the characters XML does not allow become U+FFFD, as Go's
  EscapeText makes them; a CR is written as a reference so a reader
  gives it back. }
function XmlEscapeText(const S: string): string;
function XmlEscapeAttr(const S: string): string;
{ Whether Nm is an XML Name (and, with NCName, has no colon) }
function XmlIsName(const Nm: string): Boolean;
function XmlIsNCName(const Nm: string): Boolean;

type
  { A document written as it is made, to a string. Start leaves the tag
    open for Attr until something else is written; an element with
    nothing in it is written <a/>. With Indent set, each element and
    comment goes on a line of its own, Indent as many times as it is
    deep, where no text has been written in its parent. }
  TXmlWriter = class
  private
    FS: string;
    FN: Integer;
    FOpen: Boolean;
    FNames: array of string;
    FKids: array of Integer;   { 0 nothing, 1 elements, 2 text }
    FD: Integer;
    FWritten: Boolean;
    procedure Put(const S: string);
    procedure CloseOpen;
    procedure Newline(Level: Integer);
  public
    Indent: string;
    constructor Create;
    { <?xml version="1.0" encoding="UTF-8"?> and a line feed; Standalone '' leaves it out }
    procedure Decl(const AStandalone: string);
    procedure Start(const Nm: string);
    procedure Attr(const Nm, AValue: string);
    procedure Text(const S: string);
    procedure CData(const S: string);
    procedure Comment(const S: string);
    procedure ProcInst(const ATarget, AData: string);
    { already XML, put in as it is }
    procedure Raw(const S: string);
    procedure EndElement;
    { an element with only text: Start, Text, EndElement }
    procedure Element(const Nm, AText: string);
    { the text so far; every element must be ended }
    function Output: string;
  end;

implementation

procedure BufGrow(var B: TXmlBufRec; Need: Integer);
var
  c: Integer;
begin
  if B.N + Need > Length(B.S) then
  begin
    c := Length(B.S) * 2;
    if c < B.N + Need then
      c := B.N + Need;
    if c < 64 then
      c := 64;
    SetLength(B.S, c);
  end;
end;

procedure BufChar(var B: TXmlBufRec; C: Integer);
begin
  BufGrow(B, 1);
  B.N := B.N + 1;
  B.S[B.N] := Chr(C);
end;

procedure BufStr(var B: TXmlBufRec; const X: string);
var
  k: Integer;
begin
  k := Length(X);
  if k = 0 then
    Exit;
  BufGrow(B, k);
  Move(X[1], B.S[B.N + 1], k);
  B.N := B.N + k;
end;

{ Count bytes of X from index From (1-based) }
procedure BufRange(var B: TXmlBufRec; const X: string; From, Count: Integer);
begin
  if Count <= 0 then
    Exit;
  BufGrow(B, Count);
  Move(X[From], B.S[B.N + 1], Count);
  B.N := B.N + Count;
end;

procedure BufUtf8(var B: TXmlBufRec; CP: Integer);
begin
  if CP < $80 then
    BufChar(B, CP)
  else if CP < $800 then
  begin
    BufChar(B, $C0 or (CP shr 6));
    BufChar(B, $80 or (CP and $3F));
  end
  else if CP < $10000 then
  begin
    BufChar(B, $E0 or (CP shr 12));
    BufChar(B, $80 or ((CP shr 6) and $3F));
    BufChar(B, $80 or (CP and $3F));
  end
  else
  begin
    BufChar(B, $F0 or (CP shr 18));
    BufChar(B, $80 or ((CP shr 12) and $3F));
    BufChar(B, $80 or ((CP shr 6) and $3F));
    BufChar(B, $80 or (CP and $3F));
  end;
end;

function BufResult(var B: TXmlBufRec): string;
begin
  Result := Copy(B.S, 1, B.N);
end;

{ ---- characters ---- }

function XmlIsSpace(C: Integer): Boolean;
begin
  Result := (C = 32) or (C = 9) or (C = 10) or (C = 13);
end;

{ XML 1.0 (Fifth Edition) 2.2: the characters a document may hold }
function XmlIsChar(C: Integer): Boolean;
begin
  Result := (C = 9) or (C = 10) or (C = 13) or ((C >= $20) and (C <= $D7FF)) or
    ((C >= $E000) and (C <= $FFFD)) or ((C >= $10000) and (C <= $10FFFF));
end;

{ 2.3: NameStartChar, the colon among them }
function XmlNameStart(C: Integer): Boolean;
begin
  if C < $80 then
    Result := ((C >= 97) and (C <= 122)) or ((C >= 65) and (C <= 90)) or (C = 95) or (C = 58)
  else
    Result := ((C >= $C0) and (C <= $D6)) or ((C >= $D8) and (C <= $F6)) or ((C >= $F8) and (C <= $2FF)) or
      ((C >= $370) and (C <= $37D)) or ((C >= $37F) and (C <= $1FFF)) or ((C >= $200C) and (C <= $200D)) or
      ((C >= $2070) and (C <= $218F)) or ((C >= $2C00) and (C <= $2FEF)) or ((C >= $3001) and (C <= $D7FF)) or
      ((C >= $F900) and (C <= $FDCF)) or ((C >= $FDF0) and (C <= $FFFD)) or ((C >= $10000) and (C <= $EFFFF));
end;

function XmlNameChar(C: Integer): Boolean;
begin
  if C < $80 then
    Result := XmlNameStart(C) or ((C >= 48) and (C <= 57)) or (C = 45) or (C = 46)
  else
    Result := XmlNameStart(C) or (C = $B7) or ((C >= $300) and (C <= $36F)) or ((C >= $203F) and (C <= $2040));
end;

{ The code point at index I of T (N bytes) and its length; False for
  what is not UTF-8 (a lead byte alone, overlong, a surrogate, past
  U+10FFFF) }
function XmlDecode(const T: string; I, N: Integer; var CP, L: Integer): Boolean;
var
  b0, b1, b2, b3: Integer;
begin
  b0 := Ord(T[I]);
  CP := b0;
  L := 1;
  Result := False;
  if b0 < $80 then
  begin
    Result := True;
    Exit;
  end;
  if b0 < $C2 then
    Exit;
  if b0 < $E0 then
  begin
    if I + 1 > N then
      Exit;
    b1 := Ord(T[I + 1]);
    if (b1 and $C0) <> $80 then
      Exit;
    CP := ((b0 and $1F) shl 6) or (b1 and $3F);
    L := 2;
    Result := True;
    Exit;
  end;
  if b0 < $F0 then
  begin
    if I + 2 > N then
      Exit;
    b1 := Ord(T[I + 1]);
    b2 := Ord(T[I + 2]);
    if ((b1 and $C0) <> $80) or ((b2 and $C0) <> $80) then
      Exit;
    CP := ((b0 and $0F) shl 12) or ((b1 and $3F) shl 6) or (b2 and $3F);
    if (CP < $800) or ((CP >= $D800) and (CP <= $DFFF)) then
      Exit;
    L := 3;
    Result := True;
    Exit;
  end;
  if b0 < $F5 then
  begin
    if I + 3 > N then
      Exit;
    b1 := Ord(T[I + 1]);
    b2 := Ord(T[I + 2]);
    b3 := Ord(T[I + 3]);
    if ((b1 and $C0) <> $80) or ((b2 and $C0) <> $80) or ((b3 and $C0) <> $80) then
      Exit;
    CP := ((b0 and $07) shl 18) or ((b1 and $3F) shl 12) or ((b2 and $3F) shl 6) or (b3 and $3F);
    if (CP < $10000) or (CP > $10FFFF) then
      Exit;
    L := 4;
    Result := True;
  end;
end;

function XmlHexVal(C: Integer): Integer;
begin
  if (C >= 48) and (C <= 57) then
    Result := C - 48
  else if (C >= 97) and (C <= 102) then
    Result := C - 87
  else if (C >= 65) and (C <= 70) then
    Result := C - 55
  else
    Result := -1;
end;

{ ---- the error ---- }

constructor EXmlError.CreateAt(AOffset, ALine, ACol: Integer; const AReason: string);
begin
  if AOffset >= 0 then
    inherited Create('XML syntax error on line ' + IntToStr(ALine) + ', column ' + IntToStr(ACol) + ': ' + AReason)
  else
    inherited Create('XML: ' + AReason);
  Offset := AOffset;
  Line := ALine;
  Column := ACol;
  Reason := AReason;
end;

function XmlLower(const S: string): string;
var
  i, c: Integer;
begin
  Result := S;
  for i := 1 to Length(S) do
  begin
    c := Ord(S[i]);
    if (c >= 65) and (c <= 90) then
      Result[i] := Chr(c + 32);
  end;
end;

function XmlNameOk(const Nm: string; NoColon: Boolean): Boolean;
var
  i, c, l, n: Integer;
begin
  Result := False;
  n := Length(Nm);
  if n = 0 then
    Exit;
  i := 1;
  while i <= n do
  begin
    if not XmlDecode(Nm, i, n, c, l) then
      Exit;
    if NoColon and (c = 58) then
      Exit;
    if i = 1 then
    begin
      if not XmlNameStart(c) then
        Exit;
    end
    else if not XmlNameChar(c) then
      Exit;
    i := i + l;
  end;
  Result := True;
end;

function XmlIsName(const Nm: string): Boolean;
begin
  Result := XmlNameOk(Nm, False);
end;

function XmlIsNCName(const Nm: string): Boolean;
begin
  Result := XmlNameOk(Nm, True);
end;

{ ---- UTF-16 and ISO-8859-1 into UTF-8 ---- }

function XmlFromUtf16(const T: string; From: Integer; Big: Boolean): string;
var
  n, i, u, u2: Integer;
  B: TXmlBufRec;
begin
  n := Length(T);
  i := From;
  B.N := 0;
  SetLength(B.S, 0);
  while i + 1 <= n do
  begin
    if Big then
      u := (Ord(T[i]) shl 8) or Ord(T[i + 1])
    else
      u := Ord(T[i]) or (Ord(T[i + 1]) shl 8);
    i := i + 2;
    if (u >= $D800) and (u <= $DBFF) then
    begin
      if i + 1 > n then
        raise EXmlError.CreateAt(i - 3, 1, 1, 'UTF-16 text ends inside a surrogate pair');
      if Big then
        u2 := (Ord(T[i]) shl 8) or Ord(T[i + 1])
      else
        u2 := Ord(T[i]) or (Ord(T[i + 1]) shl 8);
      if (u2 < $DC00) or (u2 > $DFFF) then
        raise EXmlError.CreateAt(i - 3, 1, 1, 'UTF-16 text has a lone surrogate');
      i := i + 2;
      u := $10000 + ((u - $D800) shl 10) + (u2 - $DC00);
    end
    else if (u >= $DC00) and (u <= $DFFF) then
      raise EXmlError.CreateAt(i - 3, 1, 1, 'UTF-16 text has a lone surrogate');
    BufUtf8(B, u);
  end;
  if i <= n then
    raise EXmlError.CreateAt(i - 1, 1, 1, 'UTF-16 text has an odd number of bytes');
  Result := BufResult(B);
end;

function XmlFromLatin1(const T: string): string;
var
  i, c: Integer;
  B: TXmlBufRec;
begin
  B.N := 0;
  SetLength(B.S, Length(T) + Length(T) div 8 + 16);
  for i := 1 to Length(T) do
  begin
    c := Ord(T[i]);
    if c < $80 then
      BufChar(B, c)
    else
      BufUtf8(B, c);
  end;
  Result := BufResult(B);
end;

{ A public identifier with each run of white space one space and none at
  either end (XML 4.2.2) }
function XmlNormPublic(const S: string): string;
var
  i: Integer;
  B: TXmlBufRec;
  sp: Boolean;
begin
  B.N := 0;
  SetLength(B.S, Length(S) + 1);
  sp := False;
  for i := 1 to Length(S) do
    if XmlIsSpace(Ord(S[i])) then
      sp := True
    else
    begin
      if sp and (B.N > 0) then
        BufChar(B, 32);
      sp := False;
      BufChar(B, Ord(S[i]));
    end;
  Result := BufResult(B);
end;

{ ---- the reader ---- }

constructor TXmlReader.Create(const AText: string);
begin
  Namespaces := True;
  MaxDepth := 10000;
  MaxExpansion := 16 * 1024 * 1024;
  FFragment := False;
  Init(AText);
end;

constructor TXmlReader.CreateFragment(const AText: string);
begin
  Namespaces := True;
  MaxDepth := 10000;
  MaxExpansion := 16 * 1024 * 1024;
  FFragment := True;
  FT := AText;
  FSrc := FT;
  FN := Length(FT);
  FP := 1;
  FBom := 0;
  FNsN := 0;
  FDepth := 0;
  FEN := 0;
  FIC := 0;
  FAN := 0;
  FPeRef := False;
  FExtSub := False;
  FGrpNew := False;
  FPD := 0;
  FSubDepth := 0;
  FExtMode := False;
  FPeSeen := False;
  FBase := '';
  FDocPub := '';
  FDocSys := '';
end;

{ The text of a document or of an external entity as UTF-8: Bom the bytes
  of a UTF-8 byte order mark left in it, Transcoded whether it was UTF-16
  or ISO-8859-1, Enc 'UTF-16' when it was }
function XmlTranscode(const AText: string; var Bom: Integer; var Transcoded: Boolean; var Enc: string): string;
var
  t, enc2: string;
  n, i, j, q: Integer;
begin
  t := AText;
  n := Length(t);
  Bom := 0;
  Transcoded := False;
  if (n >= 3) and (Ord(t[1]) = $EF) and (Ord(t[2]) = $BB) and (Ord(t[3]) = $BF) then
    Bom := 3
  else if (n >= 2) and (Ord(t[1]) = $FF) and (Ord(t[2]) = $FE) then
  begin
    t := XmlFromUtf16(t, 3, False);
    Transcoded := True;
    Enc := 'UTF-16';
  end
  else if (n >= 2) and (Ord(t[1]) = $FE) and (Ord(t[2]) = $FF) then
  begin
    t := XmlFromUtf16(t, 3, True);
    Transcoded := True;
    Enc := 'UTF-16';
  end
  else if (n >= 4) and (t[1] = '<') and (Ord(t[2]) = 0) and (t[3] = '?') and (Ord(t[4]) = 0) then
  begin
    t := XmlFromUtf16(t, 1, False);
    Transcoded := True;
  end
  else if (n >= 4) and (Ord(t[1]) = 0) and (t[2] = '<') and (Ord(t[3]) = 0) and (t[4] = '?') then
  begin
    t := XmlFromUtf16(t, 1, True);
    Transcoded := True;
  end
  else if (n >= 5) and (Copy(t, 1, 5) = '<?xml') then
  begin
    { an ISO-8859-1 declaration: the bytes above 127 are letters, not UTF-8 }
    i := Pos('?>', t);
    if i > 0 then
    begin
      j := Pos('encoding', Copy(t, 1, i));
      if j > 0 then
      begin
        j := j + 8;
        while (j < i) and XmlIsSpace(Ord(t[j])) do
          j := j + 1;
        if (j < i) and (t[j] = '=') then
        begin
          j := j + 1;
          while (j < i) and XmlIsSpace(Ord(t[j])) do
            j := j + 1;
          if (j < i) and ((t[j] = '"') or (t[j] = '''')) then
          begin
            q := j + 1;
            while (q < i) and (t[q] <> t[j]) do
              q := q + 1;
            enc2 := XmlLower(Copy(t, j + 1, q - j - 1));
            if (enc2 = 'iso-8859-1') or (enc2 = 'latin1') or (enc2 = 'iso_8859-1') or (enc2 = 'l1') then
            begin
              t := XmlFromLatin1(t);
              Transcoded := True;
            end;
          end;
        end;
      end;
    end;
  end;
  Result := t;
end;

procedure TXmlReader.Init(const AText: string);
var
  t: string;
begin
  t := XmlTranscode(AText, FBom, FTranscoded, FEncoding);
  FT := t;
  FSrc := t;
  FN := Length(t);
  FP := FBom + 1;
  FNsN := 0;
  FDepth := 0;
  FEN := 0;
  FIC := 0;
  FAN := 0;
  FPeRef := False;
  FExtSub := False;
  FGrpNew := False;
  FPD := 0;
  FSubDepth := 0;
  FExtMode := False;
  FPeSeen := False;
  FBase := '';
  FDocPub := '';
  FDocSys := '';
end;

procedure TXmlReader.LineColumn(Off: Integer; var ALine, ACol: Integer);
var
  i, ls: Integer;
begin
  ALine := 1;
  ls := 0;
  i := 0;
  while (i < Off) and (i < Length(FSrc)) do
  begin
    if FSrc[i + 1] = #10 then
    begin
      ALine := ALine + 1;
      ls := i + 1;
    end
    else if (FSrc[i + 1] = #13) and ((i + 2 > Length(FSrc)) or (FSrc[i + 2] <> #10)) then
    begin
      ALine := ALine + 1;
      ls := i + 1;
    end;
    i := i + 1;
  end;
  ACol := Off - ls + 1;
end;

{ At is a byte from 1 }
procedure TXmlReader.Fail(At: Integer; const Why: string);
var
  l, c: Integer;
  w: string;
begin
  w := Why;
  if FIC > 0 then
  begin
    { in an entity's text: the place is the reference in the document }
    At := FRefAt;
    w := w + ', in the text of &' + FEName[FIE[0]] + ';';
  end;
  if FSubDepth > 0 then
  begin
    { in a parameter entity or the external subset: the place is the reference, or the DOCTYPE }
    At := FSubAt;
    w := w + ', in a parameter entity or the external subset';
  end;
  if At < 1 then
    At := FTagAt;
  if At < 1 then
    At := 1;
  if At > Length(FSrc) + 1 then
    At := Length(FSrc) + 1;
  LineColumn(At - 1, l, c);
  raise EXmlError.CreateAt(At - 1, l, c, w);
end;

function TXmlReader.Source: string;
begin
  Result := FSrc;
end;

function TXmlReader.BomLength: Integer;
begin
  Result := FBom;
end;

function TXmlReader.OpenCount: Integer;
begin
  Result := FDepth;
end;

function TXmlReader.SkipS: Integer;
var
  st: Integer;
begin
  st := FP;
  while (FP <= FN) and XmlIsSpace(Ord(FT[FP])) do
    FP := FP + 1;
  Result := FP - st;
end;

function TXmlReader.Has(const S: string): Boolean;
var
  k: Integer;
begin
  k := Length(S);
  Result := (FP + k - 1 <= FN) and (Copy(FT, FP, k) = S);
end;

function TXmlReader.ReadName: string;
var
  st, i, c, l: Integer;
  first, stop: Boolean;
begin
  st := FP;
  i := FP;
  first := True;
  stop := False;
  while (i <= FN) and (not stop) do
  begin
    c := Ord(FT[i]);
    l := 1;
    if c < 128 then
    begin
      if ((c >= 97) and (c <= 122)) or ((c >= 65) and (c <= 90)) or (c = 95) or (c = 58) then
        l := 1
      else if (not first) and (((c >= 48) and (c <= 57)) or (c = 45) or (c = 46)) then
        l := 1
      else
        stop := True;
    end
    else
    begin
      if not XmlDecode(FT, i, FN, c, l) then
        Fail(i, 'invalid UTF-8');
      if first then
        stop := not XmlNameStart(c)
      else
        stop := not XmlNameChar(c);
    end;
    if not stop then
    begin
      i := i + l;
      first := False;
    end;
  end;
  if i = st then
    Fail(st, 'expected a name');
  Result := Copy(FT, st, i - st);
  FP := i;
end;

{ every character of bytes AFrom to ATo - 1 is one XML allows }
procedure TXmlReader.CheckChars(AFrom, ATo: Integer);
var
  i, c, l: Integer;
begin
  i := AFrom;
  while i < ATo do
  begin
    c := Ord(FT[i]);
    if c < 128 then
    begin
      if (c < 32) and (c <> 9) and (c <> 10) and (c <> 13) then
        Fail(i, 'illegal character code ' + IntToStr(c));
      i := i + 1;
    end
    else
    begin
      if not XmlDecode(FT, i, FN, c, l) then
        Fail(i, 'invalid UTF-8');
      if not XmlIsChar(c) then
        Fail(i, 'illegal character code U+' + IntToStr(c));
      i := i + l;
    end;
  end;
end;

function TXmlReader.EntityIndex(const Nm: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to FEN - 1 do
    if (FEName[i] = Nm) and (not FEPe[i]) then
    begin
      Result := i;
      Exit;
    end;
end;

{ the general entity a reference names: one that was declared in a parameter
  entity or the external subset is not there in a standalone document }
{ A system identifier Ref met in the text of the entity Base (the document's
  when empty): an absolute one, with a scheme or from the root, stays; any
  other is relative to the directory of Base, its . and .. segments gone }
function XmlJoinSystemId(const Base, Ref: string): string;
var
  i, c: Integer;
  r, d, seg: string;
  segs: array of string;
  n: Integer;
begin
  Result := Ref;
  if (Base = '') or (Ref = '') or (Ref[1] = '/') then
    Exit;
  c := Pos(':', Ref);
  i := Pos('/', Ref);
  if (c > 1) and ((i = 0) or (c < i)) then
    Exit;
  i := Length(Base);
  while (i > 0) and (Base[i] <> '/') do
    i := i - 1;
  d := Copy(Base, 1, i);
  r := d + Ref;
  n := 0;
  segs := nil;
  seg := '';
  i := 1;
  while i <= Length(r) + 1 do
  begin
    if (i > Length(r)) or (r[i] = '/') then
    begin
      if seg = '..' then
      begin
        if (n > 0) and (segs[n - 1] <> '..') then
          n := n - 1
        else
        begin
          SetLength(segs, n + 1);
          segs[n] := seg;
          n := n + 1;
        end;
      end
      else if (seg <> '.') and ((seg <> '') or (i > Length(r))) then
      begin
        SetLength(segs, n + 1);
        segs[n] := seg;
        n := n + 1;
      end;
      seg := '';
    end
    else
      seg := seg + r[i];
    i := i + 1;
  end;
  Result := '';
  for i := 0 to n - 1 do
  begin
    if i > 0 then
      Result := Result + '/';
    Result := Result + segs[i];
  end;
end;

function TXmlReader.RefIndex(const Nm: string): Integer;
begin
  Result := EntityIndex(Nm);
  if (Result >= 0) and (FStandalone = 'yes') and FEDx[Result] then
    Result := -1;
end;

function TXmlReader.PeIndex(const Nm: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to FEN - 1 do
    if (FEName[i] = Nm) and FEPe[i] then
    begin
      Result := i;
      Exit;
    end;
end;

{ the entity as a reference is written }
function TXmlReader.EntRef(Code: Integer): string;
begin
  if FEPe[Code] then
    Result := '%' + FEName[Code] + ';'
  else
    Result := '&' + FEName[Code] + ';';
end;

function XmlNormLines(const S: string): string; forward;

{ Whether the replacement text of entity Code holds markup, in itself or
  in an entity it refers to, which has to be read as content and not
  spliced into the text of a run. A loop answers no here and is refused
  where it is expanded. }
function TXmlReader.EntityMarkup(Code, Depth: Integer): Boolean;
var
  v, nm: string;
  i, j, k, n, e: Integer;
begin
  Result := False;
  if FEMk[Code] = 2 then
  begin
    Result := True;
    Exit;
  end;
  if (FEMk[Code] <> 0) or (Depth >= 20) then
    Exit;
  FEMk[Code] := 3;
  v := FEVal[Code];
  if Pos('<', v) > 0 then
    Result := True
  else
  begin
    n := Length(v);
    i := 1;
    while (i <= n) and (not Result) do
    begin
      if v[i] = '&' then
      begin
        j := i + 1;
        if (j <= n) and (v[j] <> '#') then
        begin
          k := j;
          while (k <= n) and (v[k] <> ';') do
            k := k + 1;
          nm := Copy(v, j, k - j);
          e := RefIndex(nm);
          if e >= 0 then
          begin
            if FEExt[e] then
            begin
              if (not FEUn[e]) and (Resolver <> nil) then
                Result := True;
            end
            else if EntityMarkup(e, Depth + 1) then
              Result := True;
          end;
          i := k;
        end;
      end;
      i := i + 1;
    end;
  end;
  if Result then
    FEMk[Code] := 2
  else
    FEMk[Code] := 1;
end;

{ Whether the text at I, a &, is a reference to an entity that holds
  markup: its place in the table and the byte of its ; }
function TXmlReader.MarkupRefAt(I: Integer; var Code, Semi: Integer): Boolean;
var
  k, c: Integer;
  nm: string;
begin
  Result := False;
  if FEN = 0 then
    Exit;
  k := I + 1;
  if (k > FN) or (FT[k] = '#') then
    Exit;
  while k <= FN do
  begin
    c := Ord(FT[k]);
    if (c = 59) or (c = 38) or (c = 60) or XmlIsSpace(c) then
      Break;
    k := k + 1;
  end;
  if (k > FN) or (FT[k] <> ';') then
    Exit;
  nm := Copy(FT, I + 1, k - I - 1);
  if (nm = 'lt') or (nm = 'gt') or (nm = 'amp') or (nm = 'apos') or (nm = 'quot') then
    Exit;
  Code := RefIndex(nm);
  if Code < 0 then
    Exit;
  if FEExt[Code] then
  begin
    { an external parsed entity is read through the resolver, once, and entered as content }
    if FEUn[Code] or (Resolver = nil) then
      Exit;
    ResolveEntity(Code, I);
    Semi := k;
    Result := True;
    Exit;
  end;
  if EntityMarkup(Code, FIC) then
  begin
    Semi := k;
    Result := True;
  end;
end;

{ The text goes on in the replacement text of entity Code, whose reference
  is at RefAt and ends before After; LeaveEntity comes back there. }
procedure TXmlReader.EnterEntity(Code, RefAt, After: Integer);
begin
  if FIC >= 20 then
    Fail(RefAt, 'entities nested too deep (a loop?) at &' + FEName[Code] + ';');
  FExpanded := FExpanded + Length(FEVal[Code]);
  if FExpanded > MaxExpansion then
    Fail(RefAt, 'the entities expand to more than MaxExpansion bytes');
  if FIC >= Length(FIT) then
  begin
    SetLength(FIT, FIC * 2 + 4);
    SetLength(FIP, FIC * 2 + 4);
    SetLength(FID, FIC * 2 + 4);
    SetLength(FIE, FIC * 2 + 4);
  end;
  if FIC = 0 then
  begin
    FRefAt := RefAt;
    FGrpNew := True;
    FGrpName := FEName[Code];
    FGrpStart := RefAt;
    FGrpStop := After;
  end;
  FIT[FIC] := FT;
  FIP[FIC] := After;
  FID[FIC] := FDepth;
  FIE[FIC] := Code;
  FIC := FIC + 1;
  FT := XmlNormLines(FEVal[Code]);
  FN := Length(FT);
  FP := 1;
  FAgain := True;
end;

{ The text declaration of an external entity, XML 4.3.1, and the text without
  it as UTF-8: Raw the bytes the resolver gave, Code the entity and At where
  it was referred to, where an error is put }
function TXmlReader.ExternalText(const What: string; At: Integer; const Raw: string): string;
var
  t, v, enc, why: string;
  bom, p, n, c, q, sx: Integer;
  tr: Boolean;
  e16: string;
begin
  bom := 0;
  tr := False;
  e16 := '';
  try
    t := XmlTranscode(Raw, bom, tr, e16);
  except
    on E: EXmlError do
      Fail(At, 'the text of ' + What + ' is not read: ' + E.Reason);
  end;
  if bom > 0 then
    t := Copy(t, bom + 1, Length(t) - bom);
  n := Length(t);
  if (n >= 6) and (Copy(t, 1, 5) = '<?xml') and XmlIsSpace(Ord(t[6])) then
  begin
    why := '';
    p := 6;
    while (p <= n) and XmlIsSpace(Ord(t[p])) do
      p := p + 1;
    enc := '';
    { VersionInfo?, then EncodingDecl: S, the name, Eq and a quoted value each }
    sx := 0;
    while (sx < 2) and (why = '') do
    begin
      if Copy(t, p, 7) = 'version' then
        v := 'version'
      else if Copy(t, p, 8) = 'encoding' then
        v := 'encoding'
      else
      begin
        if sx = 0 then
          why := 'expected encoding'
        else
          why := 'expected ?>';
        Break;
      end;
      if (v = 'version') and (sx = 1) then
      begin
        why := 'expected ?>';
        Break;
      end;
      p := p + Length(v);
      while (p <= n) and XmlIsSpace(Ord(t[p])) do
        p := p + 1;
      if (p > n) or (t[p] <> '=') then
      begin
        why := 'expected = after ' + v;
        Break;
      end;
      p := p + 1;
      while (p <= n) and XmlIsSpace(Ord(t[p])) do
        p := p + 1;
      if (p > n) or ((t[p] <> '"') and (t[p] <> '''')) then
      begin
        why := 'expected a quoted value after ' + v;
        Break;
      end;
      q := p + 1;
      while (q <= n) and (t[q] <> t[p]) do
        q := q + 1;
      if q > n then
      begin
        why := 'unterminated value of ' + v;
        Break;
      end;
      if v = 'encoding' then
        enc := Copy(t, p + 1, q - p - 1)
      else if (Length(Copy(t, p + 1, q - p - 1)) < 3) or (Copy(t, p + 1, 2) <> '1.') then
      begin
        why := 'unsupported XML version';
        Break;
      end;
      p := q + 1;
      c := p;
      while (p <= n) and XmlIsSpace(Ord(t[p])) do
        p := p + 1;
      if v = 'encoding' then
        sx := 2
      else
      begin
        sx := 1;
        if p = c then
          why := 'expected white space before encoding';
      end;
    end;
    if (why = '') and (enc = '') then
      why := 'a text declaration has an encoding';
    if why = '' then
    begin
      for c := 1 to Length(enc) do
        if not (((enc[c] >= 'A') and (enc[c] <= 'Z')) or ((enc[c] >= 'a') and (enc[c] <= 'z')) or
          ((c > 1) and (((enc[c] >= '0') and (enc[c] <= '9')) or (enc[c] = '.') or (enc[c] = '_') or (enc[c] = '-')))) then
          why := 'invalid encoding name ' + enc;
    end;
    if why = '' then
    begin
      v := XmlLower(enc);
      if (v = 'utf-16') or (v = 'utf16') then
      begin
        if not tr then
          why := 'the declaration says UTF-16 but the text is not';
      end
      else if (v = 'utf-8') or (v = 'utf8') or (v = 'us-ascii') or (v = 'ascii') then
      begin
        if tr and (e16 = 'UTF-16') then
          why := 'the declaration says ' + enc + ' but the text is UTF-16';
      end
      else if (v = 'iso-8859-1') or (v = 'latin1') or (v = 'iso_8859-1') or (v = 'l1') then
      begin
        if not tr then
          why := 'the declaration says ' + enc + ' but the text was not read as it';
      end
      else
        why := 'unsupported encoding ' + enc;
    end;
    if (why = '') and (Copy(t, p, 2) <> '?>') then
      why := 'expected ?> at the end of the text declaration';
    if why <> '' then
      Fail(At, 'the text declaration of ' + What + ' is wrong: ' + why);
    t := Copy(t, p + 2, n - p - 1);
  end;
  Result := t;
end;

{ Asks the resolver for the text of external entity Code, once; the
  reference to it is at byte At of the text being read }
procedure TXmlReader.ResolveEntity(Code, At: Integer);
var
  raw: string;
begin
  if FERs[Code] then
    Exit;
  FERs[Code] := True;
  try
    raw := Resolver(FEPub[Code], FESys[Code]);
  except
    on E: EXmlError do
      raise;
    on E: Exception do
      Fail(At, 'the resolver refused ' + EntRef(Code) + ' (' + E.Message + ')');
  end;
  FEVal[Code] := ExternalText(EntRef(Code), At, raw);
  FEMk[Code] := 2;
end;

procedure TXmlReader.LeaveEntity;
begin
  if FDepth <> FID[FIC - 1] then
    Fail(FP, 'the text of an entity does not close what it opens');
  FIC := FIC - 1;
  if FIC = 0 then
    FGrpNew := False;
  FT := FIT[FIC];
  FIT[FIC] := '';
  FN := Length(FT);
  FP := FIP[FIC];
  FAgain := True;
end;

{ Raw with its references expanded and its line ends made one (in an
  attribute value, its white space made spaces): Raw begins at byte At0
  of the text, or is the replacement text of an entity (Nested), where
  an error is put at the reference. }
procedure TXmlReader.Expand(const Raw: string; At0: Integer; InAttr, Nested: Boolean; Depth: Integer;
  var B: TXmlBufRec);
var
  i, n, j, k, c, code, st, errAt: Integer;
  nm: string;
  ishex: Boolean;
begin
  n := Length(Raw);
  i := 1;
  while i <= n do
  begin
    if Nested then
      errAt := At0
    else
      errAt := At0 + i - 1;
    c := Ord(Raw[i]);
    if c = 38 then
    begin
      j := i + 1;
      if (j <= n) and (Raw[j] = '#') then
      begin
        j := j + 1;
        code := 0;
        ishex := (j <= n) and (Raw[j] = 'x');
        if ishex then
          j := j + 1;
        st := j;
        while j <= n do
        begin
          if ishex then
            k := XmlHexVal(Ord(Raw[j]))
          else if (Raw[j] >= '0') and (Raw[j] <= '9') then
            k := Ord(Raw[j]) - 48
          else
            k := -1;
          if k < 0 then
            Break;
          if ishex then
            code := code * 16 + k
          else
            code := code * 10 + k;
          if code > $110000 then
            code := $110000;
          j := j + 1;
        end;
        if (j = st) or (j > n) or (Raw[j] <> ';') then
          Fail(errAt, 'invalid character reference');
        if not XmlIsChar(code) then
          Fail(errAt, 'illegal character code U+' + IntToStr(code) + ' in a reference');
        BufUtf8(B, code);
        i := j + 1;
      end
      else
      begin
        k := j;
        while (k <= n) and (Raw[k] <> ';') and (Raw[k] <> '&') and (Raw[k] <> '<') and (not XmlIsSpace(Ord(Raw[k]))) do
          k := k + 1;
        if (k > n) or (Raw[k] <> ';') then
          Fail(errAt, 'invalid entity reference: expected ;');
        nm := Copy(Raw, j, k - j);
        if not XmlIsName(nm) then
          Fail(errAt, 'invalid entity name');
        if Namespaces and (Pos(':', nm) > 0) then
          Fail(errAt, 'the entity name ' + nm + ' has a colon');
        if nm = 'lt' then
          BufChar(B, 60)
        else if nm = 'gt' then
          BufChar(B, 62)
        else if nm = 'amp' then
          BufChar(B, 38)
        else if nm = 'apos' then
          BufChar(B, 39)
        else if nm = 'quot' then
          BufChar(B, 34)
        else
        begin
          code := RefIndex(nm);
          if code < 0 then
          begin
            { XML 1.0 4.1, Entity Declared: with an external subset or a
              parameter entity reference that is not read the entity may be
              declared there, and the reference is skipped, as 5.1 lets a
              processor that does not read it }
            if not ((FPeRef or FPeSeen or FExtSub) and (FStandalone <> 'yes')) then
              Fail(errAt, 'undeclared entity &' + nm + ';');
          end
          else
          begin
            if FEExt[code] then
            begin
              if FEUn[code] then
                Fail(errAt, 'reference to the unparsed entity &' + nm + ';')
              else if InAttr and (Resolver <> nil) then
                Fail(errAt, 'reference to the external entity &' + nm + '; in an attribute value')
              else
                Fail(errAt, 'reference to the external entity &' + nm + ';');
            end;
            if Depth >= 20 then
              Fail(errAt, 'entities nested too deep (a loop?) at &' + nm + ';');
            FExpanded := FExpanded + Length(FEVal[code]);
            if FExpanded > MaxExpansion then
              Fail(errAt, 'the entities expand to more than MaxExpansion bytes');
            if Pos('<', FEVal[code]) > 0 then
            begin
              if InAttr then
                Fail(errAt, '< in the value of an attribute, through &' + nm + ';')
              else
                Fail(errAt, 'the entity &' + nm + '; holds markup, which is not read');
            end;
            if (not InAttr) and (Pos(']]>', FEVal[code]) > 0) then
              Fail(errAt, '"]]>" is not allowed in character data, through &' + nm + ';');
            Expand(FEVal[code], errAt, InAttr, True, Depth + 1, B);
          end;
        end;
        i := k + 1;
      end;
    end
    else if c = 13 then
    begin
      if (i < n) and (Raw[i + 1] = #10) then
        i := i + 1;
      if InAttr then
        BufChar(B, 32)
      else
        BufChar(B, 10);
      i := i + 1;
    end
    else if InAttr and ((c = 9) or (c = 10)) then
    begin
      BufChar(B, 32);
      i := i + 1;
    end
    else
    begin
      j := i;
      while (j <= n) and (Raw[j] <> '&') and (Raw[j] <> #13) and ((not InAttr) or ((Raw[j] <> #9) and (Raw[j] <> #10))) do
        j := j + 1;
      BufRange(B, Raw, i, j - i);
      i := j;
    end;
  end;
end;

procedure TXmlReader.ReadCharData(var Tok: TXmlToken);
var
  st, i, c, l, j, ecode, esemi: Integer;
  amp, cr, hit: Boolean;
  raw: string;
  B: TXmlBufRec;
begin
  st := FP;
  i := FP;
  amp := False;
  cr := False;
  hit := False;
  while i <= FN do
  begin
    c := Ord(FT[i]);
    if c = 60 then
      Break;
    if c < 128 then
    begin
      if c = 38 then
      begin
        amp := True;
        if MarkupRefAt(i, ecode, esemi) then
        begin
          hit := True;
          Break;
        end;
      end
      else if c = 13 then
        cr := True
      else if c = 93 then
      begin
        if (i + 2 <= FN) and (FT[i + 1] = ']') and (FT[i + 2] = '>') then
          Fail(i, '"]]>" is not allowed in character data');
      end
      else if (c < 32) and (c <> 9) and (c <> 10) then
        Fail(i, 'illegal character code ' + IntToStr(c));
      i := i + 1;
    end
    else
    begin
      if not XmlDecode(FT, i, FN, c, l) then
        Fail(i, 'invalid UTF-8');
      if not XmlIsChar(c) then
        Fail(i, 'illegal character code U+' + IntToStr(c));
      i := i + l;
    end;
  end;
  if (FDepth = 0) and (not FFragment) then
  begin
    for j := st to i - 1 do
      if not XmlIsSpace(Ord(FT[j])) then
      begin
        if FSawRoot then
          Fail(j, 'junk after the document element')
        else
          Fail(j, 'text before the root element');
      end;
  end;
  if hit and (i = st) then
  begin
    { the text goes on in the entity: read its markup, not a token of this run }
    if (FDepth = 0) and (not FFragment) then
      Fail(i, 'text outside the root element');
    EnterEntity(ecode, i, esemi + 1);
    { an entity with no text gives an empty text token, so that its reference has a node to be kept by (P478) }
    if FN = 0 then
    begin
      FAgain := False;
      Tok.Kind := xtText;
      Tok.Ent := True;
      Tok.Start := 1;
      Tok.Stop := 1;
    end;
    Exit;
  end;
  Tok.Kind := xtText;
  Tok.Start := st;
  Tok.Stop := i;
  if amp or cr then
  begin
    raw := Copy(FT, st, i - st);
    B.N := 0;
    SetLength(B.S, Length(raw) + 16);
    Expand(raw, st, False, False, 0, B);
    Tok.Value := BufResult(B);
  end
  else
    Tok.Value := Copy(FT, st, i - st);
  FP := i;
end;

{ ---- namespaces ---- }

procedure TXmlReader.BindNs(const Prefix, URI: string);
begin
  if FNsN >= Length(FNsP) then
  begin
    SetLength(FNsP, FNsN * 2 + 8);
    SetLength(FNsU, FNsN * 2 + 8);
  end;
  FNsP[FNsN] := Prefix;
  FNsU[FNsN] := URI;
  FNsN := FNsN + 1;
end;

procedure TXmlReader.Bind(const Prefix, URI: string);
begin
  BindNs(Prefix, URI);
end;

function TXmlReader.LookupNs(const Prefix: string; var URI: string): Boolean;
var
  i: Integer;
begin
  Result := True;
  if Prefix = 'xml' then
  begin
    URI := XmlNamespaceXml;
    Exit;
  end;
  for i := FNsN - 1 downto 0 do
    if FNsP[i] = Prefix then
    begin
      URI := FNsU[i];
      Exit;
    end;
  URI := '';
  Result := (Prefix = '');
end;

procedure TXmlReader.PushElem(const Nm, Pfx, Loc, Uri: string; Mark: Integer);
begin
  if FDepth >= Length(FSName) then
  begin
    SetLength(FSName, FDepth * 2 + 16);
    SetLength(FSPrefix, FDepth * 2 + 16);
    SetLength(FSLocal, FDepth * 2 + 16);
    SetLength(FSURI, FDepth * 2 + 16);
    SetLength(FSNs, FDepth * 2 + 16);
  end;
  FSName[FDepth] := Nm;
  FSPrefix[FDepth] := Pfx;
  FSLocal[FDepth] := Loc;
  FSURI[FDepth] := Uri;
  FSNs[FDepth] := Mark;
  FDepth := FDepth + 1;
end;

procedure TXmlReader.PopElem;
begin
  FDepth := FDepth - 1;
  FNsN := FSNs[FDepth];
end;

procedure TXmlReader.MakeEnd(var Tok: TXmlToken; Synth: Boolean);
var
  d: Integer;
begin
  d := FDepth - 1;
  Tok.Kind := xtEnd;
  Tok.Name := FSName[d];
  Tok.Prefix := FSPrefix[d];
  Tok.Local := FSLocal[d];
  Tok.URI := FSURI[d];
  Tok.Synth := Synth;
end;

{ splits a name at its colon, for Namespaces in XML: at most one, and a
  name on each side }
procedure XmlSplit(const Nm: string; var Pfx, Loc: string; var Bad: Boolean);
var
  i, c: Integer;
begin
  Bad := False;
  Pfx := '';
  Loc := Nm;
  c := 0;
  for i := 1 to Length(Nm) do
    if Nm[i] = ':' then
      c := c + 1;
  if c = 0 then
    Exit;
  if c > 1 then
  begin
    Bad := True;
    Exit;
  end;
  i := Pos(':', Nm);
  if (i = 1) or (i = Length(Nm)) then
  begin
    Bad := True;
    Exit;
  end;
  Pfx := Copy(Nm, 1, i - 1);
  Loc := Copy(Nm, i + 1, Length(Nm) - i);
  { the part after the colon must start as a name does, without a colon }
  Bad := not XmlIsNCName(Pfx) or not XmlIsNCName(Loc);
end;

{ a name in a declaration: for Namespaces in XML 1.0 a qualified name
  (its Qualified Names in Declarations: the DOCTYPE, ELEMENT and ATTLIST
  declarations and the content models) }
function TXmlReader.ReadQName: string;
var
  st: Integer;
  pfx, loc: string;
  bad: Boolean;
begin
  st := FP;
  Result := ReadName;
  if Namespaces then
  begin
    XmlSplit(Result, pfx, loc, bad);
    if bad then
      Fail(st, 'invalid qualified name ' + Result + ' in a declaration');
  end;
end;

{ a notation's name in an attribute's type: no colon for Namespaces in XML 1.0 }
procedure TXmlReader.ReadNotationName;
var
  st: Integer;
  nm: string;
begin
  st := FP;
  nm := ReadName;
  if Namespaces and (Pos(':', nm) > 0) then
    Fail(st, 'the notation name ' + nm + ' has a colon');
end;

procedure TXmlReader.ReadStartTag(var Tok: TXmlToken);
var
  st, ws, i, j, q, na, mark, c, l, as_, k: Integer;
  nm, pfx, loc, uri, an, raw, trail, lead: string;
  quote: Char;
  bad, amp, ctl: Boolean;
  B: TXmlBufRec;
  a: TXmlAttr;
begin
  if FSawRoot and (FDepth = 0) and (not FFragment) then
    Fail(FP, 'junk after the document element');
  if FDepth >= MaxDepth then
    Fail(FP, 'elements nested deeper than MaxDepth');
  st := FP;
  FTagAt := st;
  FP := FP + 1;
  nm := ReadName;
  SetLength(Tok.Attrs, 0);
  na := 0;
  trail := '';
  while True do
  begin
    as_ := FP;
    ws := SkipS;
    if FP > FN then
      Fail(FN, 'unexpected end of input in a start tag');
    if FT[FP] = '>' then
    begin
      trail := Copy(FT, as_, FP - as_);
      Tok.SelfClose := False;
      FP := FP + 1;
      Break;
    end;
    if (FT[FP] = '/') then
    begin
      if (FP + 1 <= FN) and (FT[FP + 1] = '>') then
      begin
        trail := Copy(FT, as_, FP - as_);
        Tok.SelfClose := True;
        FP := FP + 2;
        Break;
      end;
      Fail(FP, 'expected > after / in a start tag');
    end;
    if ws = 0 then
      Fail(FP, 'expected white space, > or /> in a start tag');
    lead := Copy(FT, as_, ws);
    a.RawStart := FP;
    an := ReadName;
    SkipS;
    if (FP > FN) or (FT[FP] <> '=') then
      Fail(FP, 'attribute ' + an + ' has no value');
    FP := FP + 1;
    SkipS;
    if (FP > FN) or ((FT[FP] <> '"') and (FT[FP] <> '''')) then
      Fail(FP, 'unquoted or missing attribute value');
    quote := FT[FP];
    FP := FP + 1;
    i := FP;
    amp := False;
    ctl := False;
    while True do
    begin
      if i > FN then
        Fail(FN, 'unexpected end of input in an attribute value');
      c := Ord(FT[i]);
      if FT[i] = quote then
        Break;
      if c = 60 then
        Fail(i, '< in the value of an attribute');
      if c < 128 then
      begin
        if c = 38 then
          amp := True
        else if (c = 9) or (c = 10) or (c = 13) then
          ctl := True
        else if c < 32 then
          Fail(i, 'illegal character code ' + IntToStr(c));
        i := i + 1;
      end
      else
      begin
        if not XmlDecode(FT, i, FN, c, l) then
          Fail(i, 'invalid UTF-8');
        if not XmlIsChar(c) then
          Fail(i, 'illegal character code U+' + IntToStr(c));
        i := i + l;
      end;
    end;
    a.Name := an;
    a.Lead := lead;
    a.Quote := quote;
    a.Changed := False;
    a.URI := '';
    if amp or ctl then
    begin
      raw := Copy(FT, FP, i - FP);
      B.N := 0;
      SetLength(B.S, Length(raw) + 16);
      Expand(raw, FP, True, False, 0, B);
      a.Value := BufResult(B);
    end
    else
      a.Value := Copy(FT, FP, i - FP);
    FP := i + 1;
    a.RawStop := FP;
    a.IsNs := Namespaces and ((an = 'xmlns') or (Copy(an, 1, 6) = 'xmlns:'));
    for k := 0 to na - 1 do
      if Tok.Attrs[k].Name = an then
        Fail(a.RawStart, 'duplicate attribute ' + an);
    if na >= Length(Tok.Attrs) then
      SetLength(Tok.Attrs, na * 2 + 4);
    Tok.Attrs[na] := a;
    na := na + 1;
  end;
  if FAN > 0 then
    ApplyAttlist(nm, Tok.Attrs, na);
  SetLength(Tok.Attrs, na);
  Tok.Trail := trail;
  { the namespaces }
  mark := FNsN;
  pfx := '';
  loc := nm;
  uri := '';
  if Namespaces then
  begin
    XmlSplit(nm, pfx, loc, bad);
    if bad then
      Fail(st + 1, 'invalid qualified name ' + nm);
    for i := 0 to na - 1 do
    begin
      a := Tok.Attrs[i];
      XmlSplit(a.Name, a.Prefix, a.Local, bad);
      if bad then
        Fail(a.RawStart, 'invalid qualified name ' + a.Name);
      Tok.Attrs[i] := a;
    end;
    for i := 0 to na - 1 do
    begin
      a := Tok.Attrs[i];
      if a.Name = 'xmlns' then
      begin
        if (a.Value = XmlNamespaceXml) or (a.Value = XmlNamespaceXmlns) then
          Fail(a.RawStart, 'the default namespace cannot be ' + a.Value);
        BindNs('', a.Value);
      end
      else if a.Prefix = 'xmlns' then
      begin
        if a.Local = 'xmlns' then
          Fail(a.RawStart, 'the prefix xmlns cannot be declared');
        if a.Local = 'xml' then
        begin
          if a.Value <> XmlNamespaceXml then
            Fail(a.RawStart, 'the prefix xml is bound to ' + XmlNamespaceXml);
        end
        else
        begin
          if a.Value = XmlNamespaceXml then
            Fail(a.RawStart, 'only the prefix xml is bound to ' + XmlNamespaceXml);
          if a.Value = XmlNamespaceXmlns then
            Fail(a.RawStart, 'no prefix is bound to ' + XmlNamespaceXmlns);
          if a.Value = '' then
            Fail(a.RawStart, 'the prefix ' + a.Local + ' is bound to an empty namespace');
          BindNs(a.Local, a.Value);
        end;
      end;
    end;
    if not LookupNs(pfx, uri) then
      Fail(st + 1, 'the prefix ' + pfx + ' is not bound to a namespace');
    for i := 0 to na - 1 do
    begin
      a := Tok.Attrs[i];
      if (not a.IsNs) and (a.Prefix <> '') then
      begin
        if not LookupNs(a.Prefix, a.URI) then
          Fail(a.RawStart, 'the prefix ' + a.Prefix + ' is not bound to a namespace');
        Tok.Attrs[i] := a;
      end;
    end;
    for i := 0 to na - 1 do
      if (not Tok.Attrs[i].IsNs) and (Tok.Attrs[i].URI <> '') then
        for j := 0 to i - 1 do
          if (Tok.Attrs[j].URI = Tok.Attrs[i].URI) and (Tok.Attrs[j].Local = Tok.Attrs[i].Local) then
            Fail(Tok.Attrs[i].RawStart, 'attributes ' + Tok.Attrs[j].Name + ' and ' + Tok.Attrs[i].Name +
              ' are the same name in the namespace ' + Tok.Attrs[i].URI);
  end
  else
    for i := 0 to na - 1 do
    begin
      Tok.Attrs[i].Local := Tok.Attrs[i].Name;
      Tok.Attrs[i].Prefix := '';
    end;
  Tok.Kind := xtStart;
  Tok.Name := nm;
  Tok.Prefix := pfx;
  Tok.Local := loc;
  Tok.URI := uri;
  Tok.Start := st;
  Tok.Stop := FP;
  Tok.OpenEnd := FP;
  Tok.Synth := False;
  PushElem(nm, pfx, loc, uri, mark);
  FSawRoot := True;
  FSynth := Tok.SelfClose;
end;

procedure TXmlReader.ReadEndTag(var Tok: TXmlToken);
var
  st: Integer;
  nm: string;
begin
  st := FP;
  FP := FP + 2;
  nm := ReadName;
  SkipS;
  if (FP > FN) or (FT[FP] <> '>') then
    Fail(FP, 'invalid characters in the end tag </' + nm + '>');
  FP := FP + 1;
  if FDepth = 0 then
    Fail(st, 'unexpected end tag </' + nm + '>');
  if (FIC > 0) and (FDepth <= FID[FIC - 1]) then
    Fail(st, 'the end tag </' + nm + '> closes an element opened outside the entity');
  if nm <> FSName[FDepth - 1] then
    Fail(st, 'element <' + FSName[FDepth - 1] + '> closed by </' + nm + '>');
  MakeEnd(Tok, False);
  Tok.Start := st;
  Tok.Stop := FP;
  PopElem;
end;

{ ---- comments, CDATA, processing instructions ---- }

{ CRLF and a CR alone as LF, the line ends of XML 1.0 2.11 }
function XmlNormLines(const S: string): string;
var
  i, n: Integer;
  B: TXmlBufRec;
begin
  n := Length(S);
  B.N := 0;
  SetLength(B.S, n);
  i := 1;
  while i <= n do
  begin
    if S[i] = #13 then
    begin
      if (i < n) and (S[i + 1] = #10) then
        i := i + 1;
      BufChar(B, 10);
    end
    else
      BufChar(B, Ord(S[i]));
    i := i + 1;
  end;
  Result := BufResult(B);
end;

procedure TXmlReader.ScanComment(var VFrom, VTo: Integer);
var
  i: Integer;
begin
  VFrom := FP + 4;
  i := VFrom;
  while True do
  begin
    if i + 1 > FN then
      Fail(FN, 'unterminated comment');
    if (FT[i] = '-') and (FT[i + 1] = '-') then
    begin
      if (i + 2 <= FN) and (FT[i + 2] = '>') then
        Break;
      Fail(i, '-- is not allowed inside a comment');
    end;
    i := i + 1;
  end;
  CheckChars(VFrom, i);
  VTo := i;
  FP := i + 3;
end;

procedure TXmlReader.ReadComment(var Tok: TXmlToken);
var
  st, a, b: Integer;
begin
  st := FP;
  ScanComment(a, b);
  Tok.Kind := xtComment;
  Tok.Start := st;
  Tok.Stop := FP;
  Tok.Value := Copy(FT, a, b - a);
  if Pos(#13, Tok.Value) > 0 then
    Tok.Value := XmlNormLines(Tok.Value);
end;

procedure TXmlReader.ReadCData(var Tok: TXmlToken);
var
  st, a, i: Integer;
  v: string;
begin
  if (FDepth = 0) and (not FFragment) then
    Fail(FP, 'CDATA outside the root element');
  st := FP;
  a := FP + 9;
  i := a;
  while True do
  begin
    if i + 2 > FN then
      Fail(FN, 'unterminated CDATA section');
    if (FT[i] = ']') and (FT[i + 1] = ']') and (FT[i + 2] = '>') then
      Break;
    i := i + 1;
  end;
  CheckChars(a, i);
  v := Copy(FT, a, i - a);
  if Pos(#13, v) > 0 then
    v := XmlNormLines(v);
  Tok.Kind := xtCData;
  Tok.Start := st;
  Tok.Stop := i + 3;
  Tok.Value := v;
  FP := i + 3;
end;

procedure TXmlReader.ScanPI(var Tgt: string; var VFrom, VTo: Integer);
var
  i: Integer;
begin
  FP := FP + 2;
  Tgt := ReadName;
  if (FP + 1 <= FN) and (FT[FP] = '?') and (FT[FP + 1] = '>') then
  begin
    VFrom := FP;
    VTo := FP;
    FP := FP + 2;
    Exit;
  end;
  if SkipS = 0 then
    Fail(FP, 'expected white space or ?> after the target of a processing instruction');
  VFrom := FP;
  i := FP;
  while True do
  begin
    if i + 1 > FN then
      Fail(FN, 'unterminated processing instruction');
    if (FT[i] = '?') and (FT[i + 1] = '>') then
      Break;
    i := i + 1;
  end;
  CheckChars(VFrom, i);
  VTo := i;
  FP := i + 2;
end;

procedure TXmlReader.ReadPI(var Tok: TXmlToken);
var
  st, a, b: Integer;
  tgt: string;
begin
  st := FP;
  if (Copy(FT, FP, 5) = '<?xml') and (FP + 5 <= FN) and (XmlIsSpace(Ord(FT[FP + 5])) or (FT[FP + 5] = '?')) then
  begin
    if FFragment or (FP <> FBom + 1) or (FIC > 0) then
      Fail(FP, 'the XML declaration is allowed only at the start of a document');
    ReadDecl(Tok, st);
    Exit;
  end;
  ScanPI(tgt, a, b);
  if XmlLower(tgt) = 'xml' then
    Fail(st + 2, 'the processing instruction target ' + tgt + ' is reserved');
  if Namespaces and (Pos(':', tgt) > 0) then
    Fail(st + 2, 'the processing instruction target ' + tgt + ' has a colon');
  Tok.Kind := xtPI;
  Tok.Start := st;
  Tok.Stop := FP;
  Tok.Name := tgt;
  Tok.Value := Copy(FT, a, b - a);
  if Pos(#13, Tok.Value) > 0 then
    Tok.Value := XmlNormLines(Tok.Value);
end;

{ the pseudo attribute Nm of the XML declaration at FP: its = and quoted value }
procedure TXmlReader.Quoted(const Nm: string; var V: string);
var
  k: Integer;
  q: Char;
begin
  FP := FP + Length(Nm);
  SkipS;
  if (FP > FN) or (FT[FP] <> '=') then
    Fail(FP, 'expected = after ' + Nm + ' in the XML declaration');
  FP := FP + 1;
  SkipS;
  if (FP > FN) or ((FT[FP] <> '"') and (FT[FP] <> '''')) then
    Fail(FP, 'the value of ' + Nm + ' in the XML declaration must be quoted');
  q := FT[FP];
  k := FP + 1;
  while (k <= FN) and (FT[k] <> q) do
    k := k + 1;
  if k > FN then
    Fail(FN, 'unterminated value in the XML declaration');
  V := Copy(FT, FP + 1, k - FP - 1);
  FP := k + 1;
end;

procedure TXmlReader.ReadDecl(var Tok: TXmlToken; St: Integer);
var
  a, i, c: Integer;
  v, enc, ver, sa: string;
  ws: Integer;
begin
  FP := FP + 5;
  ws := SkipS;
  if not Has('version') then
    Fail(FP, 'the XML declaration must begin with version');
  Quoted('version', ver);
  if (Length(ver) < 3) or (Copy(ver, 1, 2) <> '1.') then
    Fail(FP, 'unsupported XML version ' + ver);
  for i := 3 to Length(ver) do
    if (ver[i] < '0') or (ver[i] > '9') then
      Fail(FP, 'invalid XML version ' + ver);
  enc := '';
  sa := '';
  ws := SkipS;
  if Has('encoding') then
  begin
    if ws = 0 then
      Fail(FP, 'expected white space before encoding');
    Quoted('encoding', enc);
    if enc = '' then
      Fail(FP, 'empty encoding name');
    for i := 1 to Length(enc) do
    begin
      c := Ord(enc[i]);
      if not (((c >= 65) and (c <= 90)) or ((c >= 97) and (c <= 122)) or
        ((i > 1) and (((c >= 48) and (c <= 57)) or (c = 46) or (c = 95) or (c = 45)))) then
        Fail(FP, 'invalid encoding name ' + enc);
    end;
    v := XmlLower(enc);
    if (v = 'utf-16') or (v = 'utf16') then
    begin
      if not FTranscoded then
        Fail(FP, 'the declaration says UTF-16 but the text is not');
    end
    else if (v = 'utf-8') or (v = 'utf8') or (v = 'us-ascii') or (v = 'ascii') then
    begin
      if FTranscoded and (FEncoding = 'UTF-16') then
        Fail(FP, 'the declaration says ' + enc + ' but the text is UTF-16');
    end
    else if (v = 'iso-8859-1') or (v = 'latin1') or (v = 'iso_8859-1') or (v = 'l1') then
    begin
      if not FTranscoded then
        Fail(FP, 'the declaration says ' + enc + ' but the text was not read as it');
    end
    else
      Fail(FP, 'unsupported encoding ' + enc);
    ws := SkipS;
  end;
  if Has('standalone') then
  begin
    if ws = 0 then
      Fail(FP, 'expected white space before standalone');
    Quoted('standalone', sa);
    if (sa <> 'yes') and (sa <> 'no') then
      Fail(FP, 'standalone must be yes or no');
    SkipS;
  end;
  if not Has('?>') then
    Fail(FP, 'invalid XML declaration: expected ?>');
  a := St + 5;
  FEncoding := enc;
  FStandalone := sa;
  FVersion := ver;
  Tok.Kind := xtDecl;
  Tok.Start := St;
  FP := FP + 2;
  Tok.Stop := FP;
  Tok.Value := Copy(FT, a, FP - 2 - a);
  Tok.Name := 'xml';
end;

procedure TXmlReader.ReadBang(var Tok: TXmlToken);
begin
  if Has('<!--') then
    ReadComment(Tok)
  else if Has('<![CDATA[') then
    ReadCData(Tok)
  else if Has('<!DOCTYPE') then
    ReadDoctype(Tok)
  else
    Fail(FP, 'invalid <! construct');
end;

{ ---- the DOCTYPE ---- }

{ a quoted literal; of a public identifier when Pubid }
procedure TXmlReader.ReadLiteral(Pubid: Boolean);
var
  q: Char;
  i, c: Integer;
begin
  if (FP > FN) or ((FT[FP] <> '"') and (FT[FP] <> '''')) then
    Fail(FP, 'expected a quoted literal');
  q := FT[FP];
  i := FP + 1;
  while (i <= FN) and (FT[i] <> q) do
  begin
    c := Ord(FT[i]);
    if Pubid and (not (((c >= 65) and (c <= 90)) or ((c >= 97) and (c <= 122)) or ((c >= 48) and (c <= 57)) or
      (c = 32) or (c = 13) or (c = 10) or (c = 45) or (c = 39) or (c = 40) or (c = 41) or (c = 43) or (c = 44) or
      (c = 46) or (c = 47) or (c = 58) or (c = 61) or (c = 63) or (c = 59) or (c = 33) or (c = 42) or (c = 35) or
      (c = 64) or (c = 36) or (c = 95) or (c = 37))) then
      Fail(i, 'a character a public identifier does not have');
    i := i + 1;
  end;
  if i > FN then
    Fail(FN, 'unterminated literal');
  CheckChars(FP + 1, i);
  FLit := Copy(FT, FP + 1, i - FP - 1);
  FP := i + 1;
end;

function TXmlReader.ReadNmtoken: string;
var
  st, i, c, l: Integer;
begin
  st := FP;
  i := FP;
  while i <= FN do
  begin
    if not XmlDecode(FT, i, FN, c, l) then
      Fail(i, 'invalid UTF-8');
    if not XmlNameChar(c) then
      Break;
    i := i + l;
  end;
  if i = st then
    Fail(st, 'expected a name token');
  Result := Copy(FT, st, i - st);
  FP := i;
end;

{ cp ::= (Name | choice | seq) ('?' | '*' | '+')? (3.2.1) }
procedure TXmlReader.ReadCp(Lv: Integer);
begin
  if FP > FN then
    Fail(FN, 'unterminated content model');
  if FT[FP] = '(' then
    ReadGroup(Lv + 1)
  else
    ReadQName;
  if (FP <= FN) and ((FT[FP] = '?') or (FT[FP] = '*') or (FT[FP] = '+')) then
    FP := FP + 1;
end;

{ a choice or a sequence: ( cp (| cp)+ ) or ( cp (, cp)* ) }
procedure TXmlReader.ReadGroup(Lv: Integer);
var
  sep: Char;
begin
  if Lv > MaxDepth then
    Fail(FP, 'content model nested deeper than MaxDepth');
  FP := FP + 1;
  SkipS;
  ReadCp(Lv);
  SkipS;
  sep := #0;
  while (FP <= FN) and ((FT[FP] = '|') or (FT[FP] = ',')) do
  begin
    if sep = #0 then
      sep := FT[FP]
    else if sep <> FT[FP] then
      Fail(FP, 'a content model cannot mix | and ,');
    FP := FP + 1;
    SkipS;
    ReadCp(Lv);
    SkipS;
  end;
  if (FP > FN) or (FT[FP] <> ')') then
    Fail(FP, 'expected ) in a content model');
  FP := FP + 1;
end;

procedure TXmlReader.ReadElementDecl;
var
  p, names: Integer;
begin
  FP := FP + 9;
  if SkipS = 0 then
    Fail(FP, 'expected white space after <!ELEMENT');
  ReadQName;
  if SkipS = 0 then
    Fail(FP, 'expected white space after the element name');
  if Has('EMPTY') then
    FP := FP + 5
  else if Has('ANY') then
    FP := FP + 3
  else if (FP <= FN) and (FT[FP] = '(') then
  begin
    p := FP;
    FP := FP + 1;
    SkipS;
    if Has('#PCDATA') then
    begin
      FP := FP + 7;
      names := 0;
      SkipS;
      while (FP <= FN) and (FT[FP] = '|') do
      begin
        FP := FP + 1;
        SkipS;
        ReadQName;
        SkipS;
        names := names + 1;
      end;
      if (FP > FN) or (FT[FP] <> ')') then
        Fail(FP, 'expected ) in a mixed content declaration');
      FP := FP + 1;
      if (FP <= FN) and (FT[FP] = '*') then
        FP := FP + 1
      else if names > 0 then
        Fail(FP, 'a mixed content declaration with names ends in )*');
    end
    else
    begin
      FP := p;
      ReadGroup(1);
      if (FP <= FN) and ((FT[FP] = '?') or (FT[FP] = '*') or (FT[FP] = '+')) then
        FP := FP + 1;
    end;
  end
  else
    Fail(FP, 'expected EMPTY, ANY or a content model');
  SkipS;
  if (FP > FN) or (FT[FP] <> '>') then
    Fail(FP, 'expected > at the end of <!ELEMENT');
  FP := FP + 1;
end;

{ the default of an attribute: #REQUIRED, #IMPLIED or #FIXED and a value }
procedure TXmlReader.ReadAttDefault(var HasDef: Boolean; var Df: string);
var
  q: Char;
  i, j: Integer;
  B: TXmlBufRec;
begin
  HasDef := False;
  Df := '';
  if Has('#REQUIRED') then
    FP := FP + 9
  else if Has('#IMPLIED') then
    FP := FP + 8
  else
  begin
    if Has('#FIXED') then
    begin
      FP := FP + 6;
      if SkipS = 0 then
        Fail(FP, 'expected white space after #FIXED');
    end;
    if (FP > FN) or ((FT[FP] <> '"') and (FT[FP] <> '''')) then
      Fail(FP, 'expected a quoted default value, #REQUIRED, #IMPLIED or #FIXED');
    q := FT[FP];
    i := FP + 1;
    while True do
    begin
      if i > FN then
        Fail(FN, 'unterminated default value');
      if FT[i] = q then
        Break;
      if FT[i] = '<' then
        Fail(i, '< in the default value of an attribute');
      i := i + 1;
    end;
    { its references must be to entities declared before, as a value's are }
    B.N := 0;
    SetLength(B.S, i - FP + 16);
    j := FExpanded;
    Expand(Copy(FT, FP + 1, i - FP - 1), FP + 1, True, False, 0, B);
    FExpanded := j;
    CheckChars(FP + 1, i);
    HasDef := True;
    Df := BufResult(B);
    FP := i + 1;
  end;
end;

{ The attribute An of element El is declared: the first declaration of
  one stands (XML 1.0 3.3). }
procedure TXmlReader.DeclAttr(const El, An: string; NonCData, HasDef: Boolean; const Df: string);
var
  h, i, k: Integer;
begin
  if Length(FAHead) = 0 then
  begin
    SetLength(FAHead, 256);
    SetLength(FATail, 256);
    for i := 0 to 255 do
    begin
      FAHead[i] := -1;
      FATail[i] := -1;
    end;
  end;
  h := 0;
  for i := 1 to Length(El) do
    h := (h * 31 + Ord(El[i])) and 255;
  i := FAHead[h];
  while i >= 0 do
  begin
    if (FAEl[i] = El) and (FAAt[i] = An) then
      Exit;
    i := FANx[i];
  end;
  if FAN >= Length(FAEl) then
  begin
    k := FAN * 2 + 8;
    SetLength(FAEl, k);
    SetLength(FAAt, k);
    SetLength(FADf, k);
    SetLength(FATy, k);
    SetLength(FAHas, k);
    SetLength(FANx, k);
  end;
  FAEl[FAN] := El;
  FAAt[FAN] := An;
  FATy[FAN] := NonCData;
  FAHas[FAN] := HasDef;
  FADf[FAN] := Df;
  FANx[FAN] := -1;
  if FATail[h] >= 0 then
    FANx[FATail[h]] := FAN
  else
    FAHead[h] := FAN;
  FATail[h] := FAN;
  FAN := FAN + 1;
end;

{ An attribute whose declared type is not CDATA has its leading and
  trailing spaces taken off and each run of spaces made one (XML 1.0
  3.3.3). }
function XmlTokenValue(const V: string): string;
var
  i, n: Integer;
  B: TXmlBufRec;
  sp: Boolean;
begin
  n := Length(V);
  B.N := 0;
  SetLength(B.S, n);
  sp := False;
  for i := 1 to n do
    if V[i] = ' ' then
      sp := B.N > 0
    else
    begin
      if sp then
        BufChar(B, 32);
      sp := False;
      BufChar(B, Ord(V[i]));
    end;
  Result := BufResult(B);
end;

{ The tag of El has the attributes the internal subset declares for it:
  those declared with a type other than CDATA are normalized, and those
  with a default value that the tag did not give are added, marked
  Defaulted (XML 1.0 5.1: a processor that reads the declarations applies
  them). }
procedure TXmlReader.ApplyAttlist(const El: string; var Attrs: TXmlAttrArray; var Na: Integer);
var
  h, i, j, n0: Integer;
  a: TXmlAttr;
  found: Boolean;
begin
  if Length(FAHead) = 0 then
    Exit;
  h := 0;
  for i := 1 to Length(El) do
    h := (h * 31 + Ord(El[i])) and 255;
  n0 := Na;
  i := FAHead[h];
  while i >= 0 do
  begin
    if FAEl[i] = El then
    begin
      found := False;
      for j := 0 to n0 - 1 do
        if Attrs[j].Name = FAAt[i] then
        begin
          found := True;
          if FATy[i] then
            Attrs[j].Value := XmlTokenValue(Attrs[j].Value);
          Break;
        end;
      if (not found) and FAHas[i] then
      begin
        a.Name := FAAt[i];
        a.Prefix := '';
        a.Local := '';
        a.URI := '';
        a.Value := FADf[i];
        a.Lead := ' ';
        a.Quote := '"';
        a.Changed := False;
        a.Defaulted := True;
        a.IsNs := Namespaces and ((a.Name = 'xmlns') or (Copy(a.Name, 1, 6) = 'xmlns:'));
        a.RawStart := -1;
        a.RawStop := -1;
        if Na >= Length(Attrs) then
          SetLength(Attrs, Na * 2 + 4);
        Attrs[Na] := a;
        Na := Na + 1;
      end;
    end;
    i := FANx[i];
  end;
end;

procedure TXmlReader.ReadAttlistDecl;
var
  ws: Integer;
  el, an, df: string;
  nonc, hasdef: Boolean;
begin
  FP := FP + 9;
  if SkipS = 0 then
    Fail(FP, 'expected white space after <!ATTLIST');
  el := ReadQName;
  while True do
  begin
    ws := SkipS;
    if FP > FN then
      Fail(FN, 'unterminated <!ATTLIST');
    if FT[FP] = '>' then
    begin
      FP := FP + 1;
      Exit;
    end;
    if ws = 0 then
      Fail(FP, 'expected white space before an attribute definition');
    an := ReadQName;
    if SkipS = 0 then
      Fail(FP, 'expected white space after the attribute name');
    nonc := not Has('CDATA');
    if Has('CDATA') then
      FP := FP + 5
    else if Has('NMTOKENS') then
      FP := FP + 8
    else if Has('NMTOKEN') then
      FP := FP + 7
    else if Has('IDREFS') then
      FP := FP + 6
    else if Has('IDREF') then
      FP := FP + 5
    else if Has('ID') then
      FP := FP + 2
    else if Has('ENTITIES') then
      FP := FP + 8
    else if Has('ENTITY') then
      FP := FP + 6
    else if Has('NOTATION') then
    begin
      FP := FP + 8;
      if SkipS = 0 then
        Fail(FP, 'expected white space after NOTATION');
      if (FP > FN) or (FT[FP] <> '(') then
        Fail(FP, 'expected ( after NOTATION');
      FP := FP + 1;
      SkipS;
      ReadNotationName;
      SkipS;
      while (FP <= FN) and (FT[FP] = '|') do
      begin
        FP := FP + 1;
        SkipS;
        ReadNotationName;
        SkipS;
      end;
      if (FP > FN) or (FT[FP] <> ')') then
        Fail(FP, 'expected ) in a NOTATION type');
      FP := FP + 1;
    end
    else if (FP <= FN) and (FT[FP] = '(') then
    begin
      FP := FP + 1;
      SkipS;
      ReadNmtoken;
      SkipS;
      while (FP <= FN) and (FT[FP] = '|') do
      begin
        FP := FP + 1;
        SkipS;
        ReadNmtoken;
        SkipS;
      end;
      if (FP > FN) or (FT[FP] <> ')') then
        Fail(FP, 'expected ) in an enumeration');
      FP := FP + 1;
    end
    else
      Fail(FP, 'invalid attribute type');
    if SkipS = 0 then
      Fail(FP, 'expected white space after the attribute type');
    ReadAttDefault(hasdef, df);
    if hasdef and nonc then
      df := XmlTokenValue(df);
    { XML 1.0 5.1: past a reference to a parameter entity that is not read,
      the declarations may have been overridden, and are not used unless
      the document is standalone }
    if (not FPeRef) or (FStandalone = 'yes') then
      DeclAttr(el, an, nonc, hasdef, df);
  end;
end;

procedure TXmlReader.ReadNotationDecl;
var
  nm: string;
begin
  FP := FP + 10;
  if SkipS = 0 then
    Fail(FP, 'expected white space after <!NOTATION');
  nm := ReadName;
  if Namespaces and (Pos(':', nm) > 0) then
    Fail(FP, 'the notation name has a colon');
  if SkipS = 0 then
    Fail(FP, 'expected white space after the notation name');
  if Has('SYSTEM') then
  begin
    FP := FP + 6;
    if SkipS = 0 then
      Fail(FP, 'expected white space after SYSTEM');
    ReadLiteral(False);
  end
  else if Has('PUBLIC') then
  begin
    FP := FP + 6;
    if SkipS = 0 then
      Fail(FP, 'expected white space after PUBLIC');
    ReadLiteral(True);
    if SkipS > 0 then
      if (FP <= FN) and ((FT[FP] = '"') or (FT[FP] = '''')) then
        ReadLiteral(False);
  end
  else
    Fail(FP, 'expected SYSTEM or PUBLIC in a notation declaration');
  SkipS;
  if (FP > FN) or (FT[FP] <> '>') then
    Fail(FP, 'expected > at the end of <!NOTATION');
  FP := FP + 1;
end;

procedure TXmlReader.ReadEntityDecl;
var
  nm: string;
  isPE, ext, nd: Boolean;
  q: Char;
  i, st, k, code, c: Integer;
  B: TXmlBufRec;
  v, raw, pub, sys: string;
  ishex: Boolean;
begin
  FP := FP + 8;
  nd := False;
  pub := '';
  sys := '';
  if SkipS = 0 then
    Fail(FP, 'expected white space after <!ENTITY');
  isPE := False;
  if (FP <= FN) and (FT[FP] = '%') then
  begin
    isPE := True;
    FP := FP + 1;
    if SkipS = 0 then
      Fail(FP, 'expected white space after % in an entity declaration');
  end;
  nm := ReadName;
  if Namespaces and (Pos(':', nm) > 0) then
    Fail(FP, 'the entity name ' + nm + ' has a colon');
  if SkipS = 0 then
    Fail(FP, 'expected white space after the entity name');
  ext := False;
  v := '';
  if (FP <= FN) and ((FT[FP] = '"') or (FT[FP] = '''')) then
  begin
    q := FT[FP];
    i := FP + 1;
    while (i <= FN) and (FT[i] <> q) do
    begin
      if FT[i] = '%' then
        Fail(i, 'a parameter entity reference in an entity value');
      i := i + 1;
    end;
    if i > FN then
      Fail(FN, 'unterminated entity value');
    CheckChars(FP + 1, i);
    raw := Copy(FT, FP + 1, i - FP - 1);
    { character references are expanded now, entity references when used }
    B.N := 0;
    SetLength(B.S, Length(raw) + 8);
    k := 1;
    while k <= Length(raw) do
    begin
      if (raw[k] = '&') and (k < Length(raw)) and (raw[k + 1] = '#') then
      begin
        st := k + 2;
        ishex := (st <= Length(raw)) and (raw[st] = 'x');
        if ishex then
          st := st + 1;
        code := 0;
        c := st;
        while c <= Length(raw) do
        begin
          if ishex then
            i := XmlHexVal(Ord(raw[c]))
          else if (raw[c] >= '0') and (raw[c] <= '9') then
            i := Ord(raw[c]) - 48
          else
            i := -1;
          if i < 0 then
            Break;
          if ishex then
            code := code * 16 + i
          else
            code := code * 10 + i;
          if code > $110000 then
            code := $110000;
          c := c + 1;
        end;
        if (c = st) or (c > Length(raw)) or (raw[c] <> ';') or (not XmlIsChar(code)) then
          Fail(FP, 'invalid character reference in an entity value');
        BufUtf8(B, code);
        k := c + 1;
      end
      else
      begin
        if raw[k] = '&' then
        begin
          c := k + 1;
          while (c <= Length(raw)) and (raw[c] <> ';') do
            c := c + 1;
          if (c > Length(raw)) or (not XmlIsName(Copy(raw, k + 1, c - k - 1))) then
            Fail(FP, 'invalid reference in an entity value: & must begin &name; or &#n;');
          if Namespaces and (Pos(':', Copy(raw, k + 1, c - k - 1)) > 0) then
            Fail(FP, 'the entity name in an entity value has a colon');
        end;
        BufChar(B, Ord(raw[k]));
        k := k + 1;
      end;
    end;
    v := BufResult(B);
    FP := FP + Length(raw) + 2;
  end
  else
  begin
    ext := True;
    if Has('SYSTEM') then
    begin
      FP := FP + 6;
      if SkipS = 0 then
        Fail(FP, 'expected white space after SYSTEM');
      ReadLiteral(False);
      sys := XmlJoinSystemId(FBase, FLit);
    end
    else if Has('PUBLIC') then
    begin
      FP := FP + 6;
      if SkipS = 0 then
        Fail(FP, 'expected white space after PUBLIC');
      ReadLiteral(True);
      pub := XmlNormPublic(FLit);
      if SkipS = 0 then
        Fail(FP, 'expected white space after the public identifier');
      ReadLiteral(False);
      sys := XmlJoinSystemId(FBase, FLit);
    end
    else
      Fail(FP, 'expected an entity value, SYSTEM or PUBLIC');
    if SkipS > 0 then
    begin
      if Has('NDATA') then
      begin
        if isPE then
          Fail(FP, 'NDATA in a parameter entity');
        nd := True;
        FP := FP + 5;
        if SkipS = 0 then
          Fail(FP, 'expected white space after NDATA');
        ReadNotationName;
      end;
    end;
  end;
  SkipS;
  if (FP > FN) or (FT[FP] <> '>') then
    Fail(FP, 'expected > at the end of an entity declaration');
  FP := FP + 1;
  if ((not isPE) and (EntityIndex(nm) < 0) and ((not FPeRef) or (FStandalone = 'yes'))) or
    (isPE and (PeIndex(nm) < 0)) then
  begin
    if FEN >= Length(FEName) then
    begin
      SetLength(FEName, FEN * 2 + 8);
      SetLength(FEVal, FEN * 2 + 8);
      SetLength(FEExt, FEN * 2 + 8);
      SetLength(FEMk, FEN * 2 + 8);
      SetLength(FEPub, FEN * 2 + 8);
      SetLength(FESys, FEN * 2 + 8);
      SetLength(FEUn, FEN * 2 + 8);
      SetLength(FERs, FEN * 2 + 8);
      SetLength(FEPe, FEN * 2 + 8);
      SetLength(FEDx, FEN * 2 + 8);
    end;
    FEName[FEN] := nm;
    FEVal[FEN] := v;
    FEExt[FEN] := ext;
    FEMk[FEN] := 0;
    FEPub[FEN] := pub;
    FESys[FEN] := sys;
    FEUn[FEN] := nd;
    FERs[FEN] := False;
    FEPe[FEN] := isPE;
    FEDx[FEN] := FSubDepth > 0;
    FEN := FEN + 1;
  end;
end;

{ In the external subset a parameter entity reference may stand inside a markup
  declaration (XML 1.0 4.4.8): the reference at FT[I] is replaced by the text of its entity,
  between two spaces outside a literal, and as it is inside an entity value (4.4.5), where
  the quote, the % and the & that the text could end or begin something with are written as
  references so that they stay data. False when it is no reference. An entity that is not
  there is skipped, as a processor that does not read it may (5.1), unless the document is
  standalone. Q is the quote of the literal, or #0 }
function TXmlReader.ExpandPeAt(I: Integer; Q: Char): Boolean;
var
  k, code: Integer;
  nm, txt, o: string;
  j: Integer;
begin
  Result := False;
  k := I + 1;
  while (k <= FN) and (FT[k] <> ';') and (FT[k] <> '%') and (FT[k] <> '>') and (FT[k] <> '"') and
    (FT[k] <> '''') and (FT[k] <> '<') and (not XmlIsSpace(Ord(FT[k]))) do
    k := k + 1;
  if (k > FN) or (FT[k] <> ';') then
    Exit;
  nm := Copy(FT, I + 1, k - I - 1);
  if not XmlIsName(nm) then
    Exit;
  if Namespaces and (Pos(':', nm) > 0) then
    Fail(I, 'the entity name ' + nm + ' has a colon');
  FPeSeen := True;
  FPeCnt := FPeCnt + 1;
  if FPeCnt > 10000 then
    Fail(I, 'parameter entities nested too deep (a loop?) at %' + nm + ';');
  code := PeIndex(nm);
  txt := '';
  if code < 0 then
  begin
    if FStandalone = 'yes' then
      Fail(I, 'undeclared parameter entity %' + nm + ';');
    FPeRef := True;
  end
  else if FEExt[code] then
  begin
    if LoadSubset and (Resolver <> nil) then
    begin
      ResolveEntity(code, I);
      txt := XmlNormLines(FEVal[code]);
    end
    else
      FPeRef := True;
  end
  else
    txt := XmlNormLines(FEVal[code]);
  FExpanded := FExpanded + Length(txt);
  if FExpanded > MaxExpansion then
    Fail(I, 'the entities expand to more than MaxExpansion bytes');
  if Q <> #0 then
  begin
    o := '';
    for j := 1 to Length(txt) do
      if txt[j] = Q then
      begin
        if Q = '"' then
          o := o + '&#34;'
        else
          o := o + '&#39;';
      end
      else if txt[j] = '%' then
        o := o + '&#37;'
      else
        o := o + txt[j];
    FT := Copy(FT, 1, I - 1) + o + Copy(FT, k + 1, FN - k);
  end
  else if code < 0 then
    FT := Copy(FT, 1, I - 1) + ' ' + Copy(FT, k + 1, FN - k)
  else
    FT := Copy(FT, 1, I - 1) + ' ' + txt + ' ' + Copy(FT, k + 1, FN - k);
  FN := Length(FT);
  Result := True;
end;

{ The markup declaration at FP of the external subset, its parameter entity references
  included (ExpandPeAt): those outside a literal and in the entity value of an <!ENTITY,
  not in the other literals, a comment or a processing instruction }
procedure TXmlReader.ExpandDecl;
var
  i: Integer;
  q: Char;
  isEnt, kw, lit: Boolean;
begin
  FPeCnt := 0;
  isEnt := Has('<!ENTITY');
  kw := False;
  lit := False;
  q := #0;
  i := FP + 2;
  while i <= FN do
  begin
    if q <> #0 then
    begin
      if FT[i] = q then
        q := #0
      else if lit and (FT[i] = '%') then
      begin
        if ExpandPeAt(i, q) then
          Continue;
      end;
      i := i + 1;
    end
    else if (FT[i] = '"') or (FT[i] = '''') then
    begin
      q := FT[i];
      lit := isEnt and (not kw);
      i := i + 1;
    end
    else if FT[i] = '>' then
      Exit
    else if FT[i] = '%' then
    begin
      if ExpandPeAt(i, #0) then
        Continue;
      i := i + 1;
    end
    else if isEnt and ((Copy(FT, i, 6) = 'SYSTEM') or (Copy(FT, i, 6) = 'PUBLIC')) and
      XmlIsSpace(Ord(FT[i - 1])) and ((i + 6 > FN) or XmlIsSpace(Ord(FT[i + 6])) or (FT[i + 6] = '"') or (FT[i + 6] = '''')) then
    begin
      kw := True;
      i := i + 6;
    end
    else
      i := i + 1;
  end;
end;

{ white space, and parameter entity references that stand for it, at FP }
procedure TXmlReader.SkipSPe;
begin
  while True do
  begin
    SkipS;
    if (FP <= FN) and (FT[FP] = '%') then
    begin
      FPeCnt := 0;
      if ExpandPeAt(FP, #0) then
        Continue;
    end;
    Exit;
  end;
end;

{ A parameter entity reference where a declaration may stand: the entity's text is read as
  declarations (XML 1.0 4.4.8). One that is not there is skipped, as 5.1 lets a processor that
  does not read it (a validity constraint is all that Entity Declared makes of it) unless the
  document stands alone (the well-formedness constraint) }
procedure TXmlReader.IncludePE;
var
  a, code, sP, sN: Integer;
  nm, txt, sT, sB: string;
  sExt: Boolean;
begin
  a := FP;
  FP := FP + 1;
  nm := ReadName;
  if Namespaces and (Pos(':', nm) > 0) then
    Fail(a + 1, 'the entity name ' + nm + ' has a colon');
  if (FP > FN) or (FT[FP] <> ';') then
    Fail(FP, 'expected ; after a parameter entity reference');
  FP := FP + 1;
  FPeSeen := True;
  code := PeIndex(nm);
  if code < 0 then
  begin
    if FStandalone = 'yes' then
      Fail(a, 'undeclared parameter entity %' + nm + ';');
    FPeRef := True;
    Exit;
  end;
  if FEExt[code] then
  begin
    if (not LoadSubset) or (Resolver = nil) then
    begin
      FPeRef := True;
      Exit;
    end;
    ResolveEntity(code, a);
  end;
  txt := XmlNormLines(FEVal[code]);
  if FPD >= 20 then
    Fail(a, 'parameter entities nested too deep (a loop?) at %' + nm + ';');
  FExpanded := FExpanded + Length(txt);
  if FExpanded > MaxExpansion then
    Fail(a, 'the entities expand to more than MaxExpansion bytes');
  sT := FT;
  sP := FP;
  sN := FN;
  sExt := FExtMode;
  sB := FBase;
  if FEExt[code] then
    FBase := FESys[code];
  if FSubDepth = 0 then
    FSubAt := a;
  FT := ' ' + txt + ' ';
  FN := Length(FT);
  FP := 1;
  FExtMode := FExtMode or FEExt[code];
  FPD := FPD + 1;
  FSubDepth := FSubDepth + 1;
  ReadDecls(1);
  FSubDepth := FSubDepth - 1;
  FPD := FPD - 1;
  FBase := sB;
  FExtMode := sExt;
  FT := sT;
  FP := sP;
  FN := sN;
end;

{ A conditional section of the external subset, XML 1.0 3.4: INCLUDE reads its declarations,
  IGNORE skips to the end of it, nested sections counted. FP is at its <![ }
procedure TXmlReader.ReadConditional;
var
  lvl, i: Integer;
  incl: Boolean;
begin
  FP := FP + 3;
  SkipSPe;
  if Has('INCLUDE') then
  begin
    incl := True;
    FP := FP + 7;
  end
  else if Has('IGNORE') then
  begin
    incl := False;
    FP := FP + 6;
  end
  else
  begin
    incl := False;
    Fail(FP, 'expected INCLUDE or IGNORE in a conditional section');
  end;
  SkipSPe;
  if (FP > FN) or (FT[FP] <> '[') then
    Fail(FP, 'expected [ in a conditional section');
  FP := FP + 1;
  if incl then
    ReadDecls(2)
  else
  begin
    lvl := 1;
    i := FP;
    while (i <= FN) and (lvl > 0) do
    begin
      if Copy(FT, i, 3) = '<![' then
      begin
        lvl := lvl + 1;
        i := i + 3;
      end
      else if Copy(FT, i, 3) = ']]>' then
      begin
        lvl := lvl - 1;
        i := i + 3;
      end
      else
        i := i + 1;
    end;
    if lvl > 0 then
      Fail(FN, 'unterminated conditional section');
    FP := i;
  end;
end;

{ The declarations of a subset, comments, processing instructions and parameter entity
  references among them. Mode 0: the internal subset, to its ]; 1: the text of the external
  subset or of a parameter entity, to its end; 2: a conditional section, to its ]]> }
procedure TXmlReader.ReadDecls(Mode: Integer);
var
  tgt: string;
  a, b: Integer;
begin
  while True do
  begin
    SkipS;
    if FP > FN then
    begin
      if Mode = 1 then
        Exit;
      if Mode = 2 then
        Fail(FN, 'unterminated conditional section');
      Fail(FN, 'unterminated DOCTYPE internal subset');
    end;
    if (Mode = 0) and (FT[FP] = ']') then
    begin
      FP := FP + 1;
      Exit;
    end;
    if (Mode = 2) and Has(']]>') then
    begin
      FP := FP + 3;
      Exit;
    end;
    if FT[FP] = '%' then
      IncludePE
    else if Has('<!--') then
      ScanComment(a, b)
    else if Has('<?') then
    begin
      ScanPI(tgt, a, b);
      if XmlLower(tgt) = 'xml' then
        Fail(FP, 'the processing instruction target ' + tgt + ' is reserved');
    end
    else if Has('<!ENTITY') then
    begin
      if FExtMode then
        ExpandDecl;
      ReadEntityDecl;
    end
    else if Has('<!ELEMENT') then
    begin
      if FExtMode then
        ExpandDecl;
      ReadElementDecl;
    end
    else if Has('<!ATTLIST') then
    begin
      if FExtMode then
        ExpandDecl;
      ReadAttlistDecl;
    end
    else if Has('<!NOTATION') then
    begin
      if FExtMode then
        ExpandDecl;
      ReadNotationDecl;
    end
    else if FExtMode and Has('<![') then
      ReadConditional
    else
      Fail(FP, 'invalid markup in the DOCTYPE internal subset');
  end;
end;

procedure TXmlReader.ReadSubset;
begin
  ReadDecls(0);
end;

{ The external subset the DOCTYPE names, asked of the resolver and read after the internal
  subset (XML 1.0 2.8: the internal subset's declarations come first and bind first) }
procedure TXmlReader.ReadExternalSubset;
var
  raw, txt, sT, sB: string;
  sP, sN: Integer;
  sExt: Boolean;
begin
  try
    raw := Resolver(FDocPub, FDocSys);
  except
    on E: EXmlError do
      raise;
    on E: Exception do
      Fail(FDocAt, 'the resolver refused the external subset (' + E.Message + ')');
  end;
  txt := ExternalText('the external subset', FDocAt, raw);
  sT := FT;
  sP := FP;
  sN := FN;
  sExt := FExtMode;
  sB := FBase;
  FBase := FDocSys;
  FT := XmlNormLines(txt);
  FN := Length(FT);
  FP := 1;
  FExtMode := True;
  FSubAt := FDocAt;
  FSubDepth := FSubDepth + 1;
  ReadDecls(1);
  FSubDepth := FSubDepth - 1;
  FBase := sB;
  FExtMode := sExt;
  FT := sT;
  FP := sP;
  FN := sN;
end;

procedure TXmlReader.ReadDoctype(var Tok: TXmlToken);
var
  st: Integer;
begin
  if FFragment or FSawRoot or FSawDoctype or (FDepth > 0) then
    Fail(FP, 'a DOCTYPE is allowed once, before the root element');
  FSawDoctype := True;
  st := FP;
  FDocAt := st;
  FP := FP + 9;
  if SkipS = 0 then
    Fail(FP, 'expected white space after <!DOCTYPE');
  Tok.Name := ReadQName;
  SkipS;
  if Has('SYSTEM') then
  begin
    FP := FP + 6;
    if SkipS = 0 then
      Fail(FP, 'expected white space after SYSTEM');
    ReadLiteral(False);
    FDocSys := FLit;
    FExtSub := True;
  end
  else if Has('PUBLIC') then
  begin
    FP := FP + 6;
    if SkipS = 0 then
      Fail(FP, 'expected white space after PUBLIC');
    ReadLiteral(True);
    FDocPub := XmlNormPublic(FLit);
    if SkipS = 0 then
      Fail(FP, 'expected white space after the public identifier');
    ReadLiteral(False);
    FDocSys := FLit;
    FExtSub := True;
  end;
  SkipS;
  if (FP <= FN) and (FT[FP] = '[') then
  begin
    FP := FP + 1;
    ReadSubset;
    SkipS;
  end;
  if (FP > FN) or (FT[FP] <> '>') then
    Fail(FP, 'expected > at the end of the DOCTYPE');
  FP := FP + 1;
  Tok.Kind := xtDoctype;
  Tok.Start := st;
  Tok.Stop := FP;
  Tok.Value := Copy(FT, st, FP - st);
  if FExtSub and LoadSubset and (Resolver <> nil) then
    ReadExternalSubset;
end;

{ ---- the next token ---- }

function TXmlReader.Next(var Tok: TXmlToken): Boolean;
begin
  repeat
    FAgain := False;
    Result := NextTok(Tok);
  until not FAgain;
  Tok.RefName := '';
  Tok.RefStart := 0;
  Tok.RefStop := 0;
  if Result and Tok.Ent and FGrpNew then
  begin
    Tok.RefName := FGrpName;
    Tok.RefStart := FGrpStart;
    Tok.RefStop := FGrpStop;
    FGrpNew := False;
  end;
end;

function TXmlReader.NextTok(var Tok: TXmlToken): Boolean;
var
  c: Integer;
begin
  Tok.Name := '';
  Tok.Prefix := '';
  Tok.Local := '';
  Tok.URI := '';
  Tok.Value := '';
  Tok.Trail := '';
  Tok.SelfClose := False;
  Tok.Synth := False;
  Tok.Ent := FIC > 0;
  Tok.Start := 0;
  Tok.Stop := 0;
  Tok.OpenEnd := 0;
  SetLength(Tok.Attrs, 0);
  if FSynth then
  begin
    FSynth := False;
    MakeEnd(Tok, True);
    Tok.Start := FP;
    Tok.Stop := FP;
    Tok.OpenEnd := FP;
    PopElem;
    Result := True;
    Exit;
  end;
  if FP > FN then
  begin
    if FIC > 0 then
    begin
      LeaveEntity;
      Result := True;
      Exit;
    end;
    if FDepth > 0 then
      Fail(FN, 'unexpected end of input: <' + FSName[FDepth - 1] + '> is not closed');
    if (not FFragment) and (not FSawRoot) then
      Fail(FN, 'no root element');
    Result := False;
    Exit;
  end;
  Result := True;
  if FT[FP] = '<' then
  begin
    if FP < FN then
      c := Ord(FT[FP + 1])
    else
      c := 0;
    if c = 47 then
      ReadEndTag(Tok)
    else if c = 63 then
      ReadPI(Tok)
    else if c = 33 then
      ReadBang(Tok)
    else
      ReadStartTag(Tok);
  end
  else
    ReadCharData(Tok);
end;

procedure TXmlReader.SkipElement;
var
  tok: TXmlToken;
  d: Integer;
begin
  d := FDepth - 1;
  while FDepth > d do
    if not Next(tok) then
      Exit;
end;

{ ---- escaping ---- }

{ Mode 0 text, 1 an attribute in double quotes, 2 in single quotes }
function XmlEscapeMode(const S: string; Mode: Integer): string;
var
  i, n, c, l, st: Integer;
  B: TXmlBufRec;
  plain: Boolean;
begin
  n := Length(S);
  plain := True;
  i := 1;
  while i <= n do
  begin
    c := Ord(S[i]);
    if (c = 38) or (c = 60) or (c = 62) or (c = 13) or (c < 32) or (c >= 128) or
      ((Mode = 1) and (c = 34)) or ((Mode = 2) and (c = 39)) then
    begin
      plain := False;
      Break;
    end;
    i := i + 1;
  end;
  if plain then
  begin
    Result := S;
    Exit;
  end;
  B.N := 0;
  SetLength(B.S, n + n div 4 + 16);
  i := 1;
  while i <= n do
  begin
    c := Ord(S[i]);
    if c < 128 then
    begin
      if c = 38 then
        BufStr(B, '&amp;')
      else if c = 60 then
        BufStr(B, '&lt;')
      else if c = 62 then
        BufStr(B, '&gt;')
      else if c = 13 then
        BufStr(B, '&#xD;')
      else if (c = 34) and (Mode = 1) then
        BufStr(B, '&quot;')
      else if (c = 39) and (Mode = 2) then
        BufStr(B, '&apos;')
      else if (c = 9) and (Mode <> 0) then
        BufStr(B, '&#x9;')
      else if (c = 10) and (Mode <> 0) then
        BufStr(B, '&#xA;')
      else if (c < 32) and (c <> 9) and (c <> 10) then
        BufStr(B, '�')
      else
        BufChar(B, c);
      i := i + 1;
    end
    else
    begin
      st := i;
      if XmlDecode(S, i, n, c, l) and XmlIsChar(c) then
      begin
        BufRange(B, S, st, l);
        i := i + l;
      end
      else
      begin
        BufStr(B, '�');
        i := i + 1;
      end;
    end;
  end;
  Result := BufResult(B);
end;

function XmlEscapeText(const S: string): string;
begin
  Result := XmlEscapeMode(S, 0);
end;

function XmlEscapeAttr(const S: string): string;
begin
  Result := XmlEscapeMode(S, 1);
end;

{ ---- the tree ---- }

function XmlMake(AKind: TXmlKind; D: TXmlDoc): TXmlNode;
begin
  Result := TXmlNode.Create;
  Result.Kind := AKind;
  Result.Doc := D;
  Result.ZStart := -1;
  Result.ZStop := -1;
  Result.ZOpenEnd := -1;
  Result.ZCloseStart := -1;
end;

procedure XmlBad(const Why: string);
begin
  raise EXmlError.CreateAt(-1, 0, 0, Why);
end;

{ N and what holds it have changed }
procedure XmlTouch(N: TXmlNode);
var
  p: TXmlNode;
begin
  p := N;
  while p <> nil do
  begin
    p.ZDirty := True;
    p := p.Parent;
  end;
  if N.Doc <> nil then
    N.Doc.ZDirty := True;
end;

procedure XmlAddKid(var Arr: TXmlNodeArray; var Cnt: Integer; N: TXmlNode);
begin
  if Cnt >= Length(Arr) then
    SetLength(Arr, Cnt * 2 + 4);
  Arr[Cnt] := N;
  Cnt := Cnt + 1;
end;

{ the namespace Prefix is bound to at N, going up: False if it is bound nowhere }
function XmlScopeLookup(N: TXmlNode; const Prefix: string; var Uri: string): Boolean;
var
  p: TXmlNode;
  i: Integer;
  want: string;
begin
  Result := True;
  if Prefix = 'xml' then
  begin
    Uri := XmlNamespaceXml;
    Exit;
  end;
  if Prefix = '' then
    want := 'xmlns'
  else
    want := 'xmlns:' + Prefix;
  p := N;
  while p <> nil do
  begin
    for i := 0 to High(p.ZAttrs) do
      if p.ZAttrs[i].Name = want then
      begin
        Uri := p.ZAttrs[i].Value;
        Exit;
      end;
    p := p.Parent;
  end;
  Uri := '';
  Result := Prefix = '';
end;

{ the elements a document made here has not yet put a namespace on:
  now they have a place }
procedure XmlResolve(N: TXmlNode);
var
  i: Integer;
  u: string;
begin
  if N.Kind <> xkElement then
    Exit;
  if N.ZNew then
  begin
    if (N.Doc <> nil) and (not N.Doc.ZNamespaces) then
      u := ''
    else if not XmlScopeLookup(N, N.Prefix, u) then
      XmlBad('the prefix ' + N.Prefix + ' of <' + N.Name + '> is not bound to a namespace');
    N.URI := u;
    N.ZNew := False;
  end;
  for i := 0 to High(N.ZAttrs) do
    if (N.ZAttrs[i].Prefix <> '') and (not N.ZAttrs[i].IsNs) and (N.ZAttrs[i].URI = '') and
      ((N.Doc = nil) or N.Doc.ZNamespaces) then
    begin
      if not XmlScopeLookup(N, N.ZAttrs[i].Prefix, u) then
        XmlBad('the prefix ' + N.ZAttrs[i].Prefix + ' of ' + N.ZAttrs[i].Name + ' is not bound to a namespace');
      N.ZAttrs[i].URI := u;
    end;
  for i := 0 to N.ZCount - 1 do
    XmlResolve(N.ZKids[i]);
end;

procedure XmlSetDoc(N: TXmlNode; D: TXmlDoc);
var
  i: Integer;
begin
  N.Doc := D;
  for i := 0 to N.ZCount - 1 do
    XmlSetDoc(N.ZKids[i], D);
end;

function TXmlNode.GetValue: string;
begin
  Result := ZValue;
end;

procedure TXmlNode.SetValue(const S: string);
begin
  if Kind = xkElement then
    XmlBad('an element has no value; use SetText');
  ZValue := S;
  ZChanged := True;
  XmlTouch(Self);
end;

procedure XmlCollect(N: TXmlNode; var B: TXmlBufRec);
var
  i: Integer;
  k: TXmlNode;
begin
  for i := 0 to N.ZCount - 1 do
  begin
    k := N.ZKids[i];
    if (k.Kind = xkText) or (k.Kind = xkCData) then
      BufStr(B, k.ZValue)
    else if k.Kind = xkElement then
      XmlCollect(k, B);
  end;
end;

function TXmlNode.Text: string;
var
  B: TXmlBufRec;
begin
  if Kind <> xkElement then
  begin
    Result := ZValue;
    Exit;
  end;
  B.N := 0;
  XmlCollect(Self, B);
  Result := BufResult(B);
end;

procedure TXmlNode.SetText(const S: string);
var
  t: TXmlNode;
  i: Integer;
begin
  if Kind <> xkElement then
  begin
    SetValue(S);
    Exit;
  end;
  for i := 0 to ZCount - 1 do
    ZKids[i].Parent := nil;
  ZKids := nil;
  ZCount := 0;
  if S <> '' then
  begin
    t := XmlMake(xkText, Doc);
    t.ZValue := S;
    t.ZChanged := True;
    t.Parent := Self;
    SetLength(ZKids, 1);
    ZKids[0] := t;
    ZCount := 1;
  end;
  XmlTouch(Self);
end;

function TXmlNode.Count: Integer;
begin
  Result := ZCount;
end;

function TXmlNode.Item(I: Integer): TXmlNode;
begin
  if (I < 0) or (I >= ZCount) then
    XmlBad('child ' + IntToStr(I) + ' of ' + IntToStr(ZCount));
  Result := ZKids[I];
end;

function TXmlNode.IndexInParent: Integer;
var
  i: Integer;
  p: TXmlNode;
begin
  Result := -1;
  p := Parent;
  if p <> nil then
  begin
    for i := 0 to p.ZCount - 1 do
      if p.ZKids[i] = Self then
      begin
        Result := i;
        Exit;
      end;
  end
  else if Doc <> nil then
    for i := 0 to Doc.ZCount - 1 do
      if Doc.ZKids[i] = Self then
      begin
        Result := i;
        Exit;
      end;
end;

function XmlMatchName(K: TXmlNode; const Nm: string; Qualified: Boolean): Boolean;
begin
  if K.Kind <> xkElement then
    Result := False
  else if Qualified then
    Result := K.Name = Nm
  else
    Result := K.Local = Nm;
end;

function TXmlNode.Elem(const Nm: string): TXmlNode;
var
  i: Integer;
  q: Boolean;
begin
  Result := nil;
  q := Pos(':', Nm) > 0;
  for i := 0 to ZCount - 1 do
    if XmlMatchName(ZKids[i], Nm, q) then
    begin
      Result := ZKids[i];
      Exit;
    end;
end;

function TXmlNode.ElemNS(const AUri, ALocal: string): TXmlNode;
var
  i: Integer;
  k: TXmlNode;
begin
  Result := nil;
  for i := 0 to ZCount - 1 do
  begin
    k := ZKids[i];
    if (k.Kind = xkElement) and (k.Local = ALocal) and (k.URI = AUri) then
    begin
      Result := k;
      Exit;
    end;
  end;
end;

function TXmlNode.Elems(const Nm: string): TXmlNodeArray;
var
  i, n: Integer;
  q: Boolean;
begin
  Result := nil;
  n := 0;
  q := Pos(':', Nm) > 0;
  for i := 0 to ZCount - 1 do
    if XmlMatchName(ZKids[i], Nm, q) then
      XmlAddKid(Result, n, ZKids[i]);
  SetLength(Result, n);
end;

function TXmlNode.ElemsNS(const AUri, ALocal: string): TXmlNodeArray;
var
  i, n: Integer;
  k: TXmlNode;
begin
  Result := nil;
  n := 0;
  for i := 0 to ZCount - 1 do
  begin
    k := ZKids[i];
    if (k.Kind = xkElement) and (k.Local = ALocal) and (k.URI = AUri) then
      XmlAddKid(Result, n, k);
  end;
  SetLength(Result, n);
end;

function TXmlNode.Find(const Path: string): TXmlNode;
var
  i, j, n: Integer;
  cur: TXmlNode;
begin
  Result := Self;
  if Path = '' then
    Exit;
  cur := Self;
  n := Length(Path);
  i := 1;
  while i <= n do
  begin
    j := i;
    while (j <= n) and (Path[j] <> '/') do
      j := j + 1;
    cur := cur.Elem(Copy(Path, i, j - i));
    if cur = nil then
    begin
      Result := nil;
      Exit;
    end;
    i := j + 1;
  end;
  Result := cur;
end;

function TXmlNode.AttrCount: Integer;
begin
  Result := Length(ZAttrs);
end;

function TXmlNode.AttrAt(I: Integer): TXmlAttr;
begin
  if (I < 0) or (I > High(ZAttrs)) then
    XmlBad('attribute ' + IntToStr(I) + ' of ' + IntToStr(Length(ZAttrs)));
  Result := ZAttrs[I];
end;

function TXmlNode.AttrIndex(const Nm: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to High(ZAttrs) do
    if ZAttrs[i].Name = Nm then
    begin
      Result := i;
      Exit;
    end;
end;

function TXmlNode.HasAttr(const Nm: string): Boolean;
begin
  Result := AttrIndex(Nm) >= 0;
end;

function TXmlNode.Attr(const Nm: string): string;
var
  i: Integer;
begin
  i := AttrIndex(Nm);
  if i >= 0 then
    Result := ZAttrs[i].Value
  else
    Result := '';
end;

function TXmlNode.AttrNS(const AUri, ALocal: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to High(ZAttrs) do
    if (not ZAttrs[i].IsNs) and (ZAttrs[i].Local = ALocal) and (ZAttrs[i].URI = AUri) then
    begin
      Result := ZAttrs[i].Value;
      Exit;
    end;
end;

procedure TXmlNode.SetAttr(const Nm, AValue: string);
var
  i, c: Integer;
  a: TXmlAttr;
  u: string;
begin
  if Kind <> xkElement then
    XmlBad('only an element has attributes');
  i := AttrIndex(Nm);
  if i >= 0 then
  begin
    if ZAttrs[i].Value = AValue then
      Exit;
    ZAttrs[i].Value := AValue;
    ZAttrs[i].Changed := True;
    ZAttrs[i].Defaulted := False;
    ZHead := True;
    XmlTouch(Self);
    Exit;
  end;
  if not XmlIsName(Nm) then
    XmlBad('invalid attribute name ' + Nm);
  a.Name := Nm;
  a.Prefix := '';
  a.Local := Nm;
  a.URI := '';
  a.Value := AValue;
  a.Lead := ' ';
  a.Quote := '"';
  a.Changed := True;
  a.RawStart := -1;
  a.RawStop := -1;
  a.IsNs := (Nm = 'xmlns') or (Copy(Nm, 1, 6) = 'xmlns:');
  c := Pos(':', Nm);
  if (c > 1) and (c < Length(Nm)) and ((Doc = nil) or Doc.ZNamespaces) then
  begin
    a.Prefix := Copy(Nm, 1, c - 1);
    a.Local := Copy(Nm, c + 1, Length(Nm) - c);
    if (not a.IsNs) and (Parent <> nil) then
    begin
      if not XmlScopeLookup(Self, a.Prefix, u) then
        XmlBad('the prefix ' + a.Prefix + ' is not bound to a namespace');
      a.URI := u;
    end;
  end;
  SetLength(ZAttrs, Length(ZAttrs) + 1);
  ZAttrs[High(ZAttrs)] := a;
  ZHead := True;
  XmlTouch(Self);
end;

procedure TXmlNode.RemoveAttr(const Nm: string);
var
  i, j: Integer;
begin
  i := AttrIndex(Nm);
  if i < 0 then
    Exit;
  for j := i to High(ZAttrs) - 1 do
    ZAttrs[j] := ZAttrs[j + 1];
  SetLength(ZAttrs, Length(ZAttrs) - 1);
  ZHead := True;
  XmlTouch(Self);
end;

procedure TXmlNode.InsertChild(Index: Integer; N: TXmlNode);
var
  i: Integer;
  p: TXmlNode;
begin
  if Kind <> xkElement then
    XmlBad('only an element has children');
  if (Index < 0) or (Index > ZCount) then
    XmlBad('child place ' + IntToStr(Index) + ' of ' + IntToStr(ZCount));
  if (N.Kind = xkDecl) or (N.Kind = xkDoctype) then
    XmlBad('a declaration or a DOCTYPE is not content');
  if (N.Parent <> nil) or ((N.Doc <> nil) and (N.Doc.Root = N)) then
    XmlBad('the node already has a place; Detach it first');
  p := Self;
  while p <> nil do
  begin
    if p = N then
      XmlBad('a node cannot hold its own ancestor');
    p := p.Parent;
  end;
  if ZCount >= Length(ZKids) then
    SetLength(ZKids, ZCount * 2 + 4);
  for i := ZCount downto Index + 1 do
    ZKids[i] := ZKids[i - 1];
  ZKids[Index] := N;
  ZCount := ZCount + 1;
  N.Parent := Self;
  XmlSetDoc(N, Doc);
  XmlResolve(N);
  XmlTouch(Self);
end;

procedure TXmlNode.AddChild(N: TXmlNode);
begin
  InsertChild(ZCount, N);
end;

procedure TXmlNode.RemoveAt(Index: Integer);
var
  i: Integer;
begin
  if (Index < 0) or (Index >= ZCount) then
    XmlBad('child ' + IntToStr(Index) + ' of ' + IntToStr(ZCount));
  ZKids[Index].Parent := nil;
  for i := Index to ZCount - 2 do
    ZKids[i] := ZKids[i + 1];
  ZKids[ZCount - 1] := nil;
  ZCount := ZCount - 1;
  XmlTouch(Self);
end;

procedure TXmlNode.Detach;
var
  i: Integer;
  d: TXmlDoc;
begin
  if Parent <> nil then
  begin
    Parent.RemoveAt(IndexInParent);
    Exit;
  end;
  d := Doc;
  if d = nil then
    Exit;
  for i := 0 to d.ZCount - 1 do
    if d.ZKids[i] = Self then
    begin
      d.ZKids[i] := nil;
      Break;
    end;
  { close the gap }
  i := 0;
  while i < d.ZCount do
  begin
    if d.ZKids[i] = nil then
    begin
      while i < d.ZCount - 1 do
      begin
        d.ZKids[i] := d.ZKids[i + 1];
        i := i + 1;
      end;
      d.ZKids[d.ZCount - 1] := nil;
      d.ZCount := d.ZCount - 1;
      Break;
    end;
    i := i + 1;
  end;
  if d.Root = Self then
    d.Root := nil;
  d.ZDirty := True;
end;

procedure TXmlNode.AppendText(const S: string);
var
  t: TXmlNode;
begin
  t := XmlMake(xkText, Doc);
  t.ZValue := S;
  t.ZChanged := True;
  AddChild(t);
end;

function TXmlNode.AddElem(const Nm: string): TXmlNode;
var
  c: Integer;
begin
  if not XmlIsName(Nm) then
    XmlBad('invalid element name ' + Nm);
  Result := XmlMake(xkElement, Doc);
  Result.Name := Nm;
  Result.Local := Nm;
  Result.ZNew := True;
  c := Pos(':', Nm);
  if (c > 1) and (c < Length(Nm)) and ((Doc = nil) or Doc.ZNamespaces) then
  begin
    Result.Prefix := Copy(Nm, 1, c - 1);
    Result.Local := Copy(Nm, c + 1, Length(Nm) - c);
  end;
  AddChild(Result);
end;

{ ---- building from a reader ---- }

{ N, a node of the text of an entity, joins its reference's group: the
  first node is its head }
procedure XmlJoinGroup(N: TXmlNode; var Head: TXmlNode; var Count: Integer; Id: Integer; const Name: string;
  Start, Stop: Integer; D: TXmlDoc);
begin
  N.ZRefId := Id;
  N.ZRefIdx := Count;
  N.ZRefName := Name;
  N.ZRefDoc := D;
  Count := Count + 1;
  if Head = nil then
  begin
    Head := N;
    N.ZRefHead := True;
    N.ZRefStart := Start;
    N.ZRefStop := Stop;
  end;
end;

procedure XmlBuildInto(R: TXmlReader; D: TXmlDoc; Holder: TXmlNode);
var
  tok: TXmlToken;
  cur, n, grphead: TXmlNode;
  src, grpname: string;
  k, i, lvl, grpid, grpbase, grpn, grpstart, grpstop: Integer;
  ingroup: Boolean;
begin
  src := R.Source;
  cur := Holder;
  lvl := 0;
  grpid := 0;
  grpbase := 0;
  grpn := 0;
  grpstart := 0;
  grpstop := 0;
  grpname := '';
  grphead := nil;
  ingroup := False;
  while R.Next(tok) do
  begin
    { the nodes an entity gave at the level it was referred to are a group,
      the first knowing the bytes of the reference }
    if ingroup and ((not tok.Ent) or (tok.RefName <> '')) then
    begin
      if grphead <> nil then
        grphead.ZRefLen := grpn;
      ingroup := False;
      grphead := nil;
    end;
    if tok.Ent and (tok.RefName <> '') then
    begin
      grpid := grpid + 1;
      ingroup := True;
      grpbase := lvl;
      grpn := 0;
      grphead := nil;
      grpname := tok.RefName;
      grpstart := tok.RefStart;
      grpstop := tok.RefStop;
    end;
    case tok.Kind of
      xtStart:
        begin
          n := XmlMake(xkElement, D);
          n.Name := tok.Name;
          n.Prefix := tok.Prefix;
          n.Local := tok.Local;
          n.URI := tok.URI;
          n.ZAttrs := tok.Attrs;
          n.ZTrail := tok.Trail;
          n.ZSrc := src;
          n.ZStart := tok.Start;
          n.ZOpenEnd := tok.OpenEnd;
          if tok.Ent then
          begin
            { read from an entity's text: no bytes of the document, written from its parts }
            n.ZStart := -1;
            n.ZOpenEnd := -1;
            for i := 0 to High(n.ZAttrs) do
              n.ZAttrs[i].RawStart := -1;
          end;
          n.Parent := cur;
          XmlAddKid(cur.ZKids, cur.ZCount, n);
          if ingroup and (lvl = grpbase) then
            XmlJoinGroup(n, grphead, grpn, grpid, grpname, grpstart, grpstop, D);
          lvl := lvl + 1;
          cur := n;
        end;
      xtEnd:
        begin
          lvl := lvl - 1;
          cur.ZStop := tok.Stop;
          if tok.Synth or tok.Ent then
            cur.ZCloseStart := -1
          else
            cur.ZCloseStart := tok.Start;
          if tok.Ent then
            cur.ZStop := -1;
          if Length(cur.ZKids) <> cur.ZCount then
            SetLength(cur.ZKids, cur.ZCount);
          cur := cur.Parent;
        end;
    else
      begin
        case tok.Kind of
          xtText: k := Ord(xkText);
          xtCData: k := Ord(xkCData);
          xtComment: k := Ord(xkComment);
          xtPI: k := Ord(xkPI);
          xtDoctype: k := Ord(xkDoctype);
        else
          k := Ord(xkDecl);
        end;
        n := XmlMake(TXmlKind(k), D);
        n.Name := tok.Name;
        n.ZValue := tok.Value;
        n.ZSrc := src;
        n.ZStart := tok.Start;
        n.ZStop := tok.Stop;
        if tok.Ent then
        begin
          n.ZStart := -1;
          n.ZStop := -1;
        end;
        n.Parent := cur;
        XmlAddKid(cur.ZKids, cur.ZCount, n);
        if ingroup and (lvl = grpbase) then
          XmlJoinGroup(n, grphead, grpn, grpid, grpname, grpstart, grpstop, D);
      end;
    end;
  end;
  if ingroup and (grphead <> nil) then
    grphead.ZRefLen := grpn;
  i := 0;
  while i < Holder.ZCount do
  begin
    Holder.ZKids[i].Parent := nil;
    i := i + 1;
  end;
  if Length(Holder.ZKids) <> Holder.ZCount then
    SetLength(Holder.ZKids, Holder.ZCount);
end;

function XmlBuild(R: TXmlReader): TXmlDoc;
var
  d: TXmlDoc;
  h: TXmlNode;
  i: Integer;
  n: TXmlNode;
begin
  d := TXmlDoc.Create;
  d.ZSrc := R.Source;
  d.ZBom := R.BomLength;
  d.ZNamespaces := R.Namespaces;
  d.ZDirty := False;
  h := XmlMake(xkElement, d);
  XmlBuildInto(R, d, h);
  d.ZKids := h.ZKids;
  d.ZCount := h.ZCount;
  d.FEncoding := R.Encoding;
  d.FStandalone := R.Standalone;
  d.FVersion := R.Version;
  for i := 0 to d.ZCount - 1 do
  begin
    n := d.ZKids[i];
    if n.Kind = xkElement then
      d.Root := n;
    if (n.Kind = xkDecl) and R.Transcoded then
    begin
      { the text is UTF-8 now: the declaration says so }
      n.ZValue := '<?xml version="' + R.Version + '" encoding="UTF-8"';
      if R.Standalone <> '' then
        n.ZValue := n.ZValue + ' standalone="' + R.Standalone + '"';
      n.ZValue := n.ZValue + '?>';
      n.ZChanged := True;
      d.ZDirty := True;
      d.FEncoding := 'UTF-8';
    end;
  end;
  Result := d;
end;

function XmlParse(const S: string): TXmlDoc;
var
  r: TXmlReader;
begin
  r := TXmlReader.Create(S);
  Result := XmlBuild(r);
end;

function XmlParseFlat(const S: string): TXmlDoc;
var
  r: TXmlReader;
begin
  r := TXmlReader.Create(S);
  r.Namespaces := False;
  Result := XmlBuild(r);
end;

function XmlParseWith(const S: string; AResolver: TXmlResolver; ANamespaces: Boolean): TXmlDoc;
var
  r: TXmlReader;
begin
  r := TXmlReader.Create(S);
  r.Namespaces := ANamespaces;
  r.Resolver := AResolver;
  Result := XmlBuild(r);
end;

function XmlParseDtd(const S: string; AResolver: TXmlResolver; ANamespaces: Boolean): TXmlDoc;
var
  r: TXmlReader;
begin
  r := TXmlReader.Create(S);
  r.Namespaces := ANamespaces;
  r.Resolver := AResolver;
  r.LoadSubset := True;
  Result := XmlBuild(r);
end;

function XmlTryParse(const S: string; out Doc: TXmlDoc; out Err: string): Boolean;
begin
  Doc := nil;
  Err := '';
  Result := False;
  try
    Doc := XmlParse(S);
    Result := True;
  except
    on E: EXmlError do
      Err := E.Message;
  end;
end;

{ content in XML text, read in the scope of this element }
procedure XmlParseContent(N: TXmlNode; const Fragment: string; Holder: TXmlNode);
var
  r: TXmlReader;
  chain: array of TXmlNode;
  p: TXmlNode;
  i, j, k: Integer;
begin
  r := TXmlReader.CreateFragment(Fragment);
  if (N.Doc <> nil) and (not N.Doc.ZNamespaces) then
    r.Namespaces := False;
  { the bindings in scope, the outermost first }
  chain := nil;
  p := N;
  k := 0;
  while p <> nil do
  begin
    SetLength(chain, k + 1);
    chain[k] := p;
    k := k + 1;
    p := p.Parent;
  end;
  for i := k - 1 downto 0 do
    for j := 0 to High(chain[i].ZAttrs) do
      if chain[i].ZAttrs[j].Name = 'xmlns' then
        r.Bind('', chain[i].ZAttrs[j].Value)
      else if chain[i].ZAttrs[j].Prefix = 'xmlns' then
        r.Bind(chain[i].ZAttrs[j].Local, chain[i].ZAttrs[j].Value);
  XmlBuildInto(r, N.Doc, Holder);
end;

procedure TXmlNode.InsertXml(Index: Integer; const Fragment: string);
var
  h: TXmlNode;
  i: Integer;
  kids: TXmlNodeArray;
  n: Integer;
begin
  if Kind <> xkElement then
    XmlBad('only an element has children');
  if (Index < 0) or (Index > ZCount) then
    XmlBad('child place ' + IntToStr(Index) + ' of ' + IntToStr(ZCount));
  h := XmlMake(xkElement, Doc);
  XmlParseContent(Self, Fragment, h);
  kids := h.ZKids;
  n := h.ZCount;
  for i := 0 to n - 1 do
    InsertChild(Index + i, kids[i]);
end;

procedure TXmlNode.AppendXml(const Fragment: string);
begin
  InsertXml(ZCount, Fragment);
end;

{ ---- writing a tree ---- }

procedure XmlEmit(N: TXmlNode; var B: TXmlBufRec); forward;

procedure XmlEmitAttr(N: TXmlNode; I: Integer; var B: TXmlBufRec);
var
  a: TXmlAttr;
  q: Char;
begin
  a := N.ZAttrs[I];
  BufStr(B, a.Lead);
  if (a.RawStart >= 1) and (not a.Changed) then
    BufRange(B, N.ZSrc, a.RawStart, a.RawStop - a.RawStart)
  else
  begin
    q := a.Quote;
    if q = #0 then
      q := '"';
    BufStr(B, a.Name);
    BufChar(B, 61);
    BufChar(B, Ord(q));
    if q = '"' then
      BufStr(B, XmlEscapeMode(a.Value, 1))
    else
      BufStr(B, XmlEscapeMode(a.Value, 2));
    BufChar(B, Ord(q));
  end;
end;

{ Whether the group that begins at kid I of N is all there, in its order,
  untouched and in the document that declares its entity: then it is
  written as its reference (P478) }
function XmlGroupIntact(N: TXmlNode; I: Integer): Boolean;
var
  k, m: TXmlNode;
  j: Integer;
begin
  Result := False;
  k := N.ZKids[I];
  if (not k.ZRefHead) or (k.ZRefLen < 1) or (I + k.ZRefLen > N.ZCount) or (k.Doc <> k.ZRefDoc) then
    Exit;
  for j := 0 to k.ZRefLen - 1 do
  begin
    m := N.ZKids[I + j];
    if (m.ZRefId <> k.ZRefId) or (m.ZRefIdx <> j) or m.ZChanged or m.ZDirty or (m.Doc <> m.ZRefDoc) then
      Exit;
  end;
  Result := True;
end;

procedure XmlEmitKids(N: TXmlNode; var B: TXmlBufRec);
var
  i: Integer;
  k: TXmlNode;
begin
  i := 0;
  while i < N.ZCount do
  begin
    k := N.ZKids[i];
    if k.ZRefHead and XmlGroupIntact(N, i) then
    begin
      BufRange(B, k.ZSrc, k.ZRefStart, k.ZRefStop - k.ZRefStart);
      i := i + k.ZRefLen;
    end
    else
    begin
      XmlEmit(k, B);
      i := i + 1;
    end;
  end;
end;

procedure XmlEmitElement(N: TXmlNode; var B: TXmlBufRec);
var
  i: Integer;
  ended: Boolean;
begin
  ended := N.ZCloseStart >= 1;
  if (N.ZStart >= 1) and (not N.ZDirty) then
  begin
    BufRange(B, N.ZSrc, N.ZStart, N.ZStop - N.ZStart);
    Exit;
  end;
  if (N.ZStart >= 1) and (not N.ZHead) and (ended or (N.ZCount = 0)) then
    BufRange(B, N.ZSrc, N.ZStart, N.ZOpenEnd - N.ZStart)
  else
  begin
    BufChar(B, 60);
    BufStr(B, N.Name);
    for i := 0 to High(N.ZAttrs) do
      if not N.ZAttrs[i].Defaulted then
        XmlEmitAttr(N, i, B);
    BufStr(B, N.ZTrail);
    if (N.ZCount = 0) and (not ended) then
      BufStr(B, '/>')
    else
      BufChar(B, 62);
  end;
  if (N.ZCount = 0) and (not ended) then
    Exit;
  XmlEmitKids(N, B);
  if ended then
    BufRange(B, N.ZSrc, N.ZCloseStart, N.ZStop - N.ZCloseStart)
  else
  begin
    BufStr(B, '</');
    BufStr(B, N.Name);
    BufChar(B, 62);
  end;
end;

procedure XmlEmit(N: TXmlNode; var B: TXmlBufRec);
var
  v: string;
  p: Integer;
begin
  if (N.ZStart >= 1) and (not N.ZChanged) and (N.Kind <> xkElement) then
  begin
    BufRange(B, N.ZSrc, N.ZStart, N.ZStop - N.ZStart);
    Exit;
  end;
  case N.Kind of
    xkElement:
      XmlEmitElement(N, B);
    xkText:
      BufStr(B, XmlEscapeMode(N.ZValue, 0));
    xkCData:
      begin
        BufStr(B, '<![CDATA[');
        v := N.ZValue;
        p := Pos(']]>', v);
        while p > 0 do
        begin
          BufStr(B, Copy(v, 1, p + 1));
          BufStr(B, ']]><![CDATA[');
          v := Copy(v, p + 2, Length(v) - p - 1);
          p := Pos(']]>', v);
        end;
        BufStr(B, v);
        BufStr(B, ']]>');
      end;
    xkComment:
      begin
        v := N.ZValue;
        if (Pos('--', v) > 0) or ((v <> '') and (v[Length(v)] = '-')) then
          XmlBad('a comment cannot hold -- or end with -');
        BufStr(B, '<!--');
        BufStr(B, v);
        BufStr(B, '-->');
      end;
    xkPI:
      begin
        if Pos('?>', N.ZValue) > 0 then
          XmlBad('a processing instruction cannot hold ?>');
        BufStr(B, '<?');
        BufStr(B, N.Name);
        if N.ZValue <> '' then
        begin
          BufChar(B, 32);
          BufStr(B, N.ZValue);
        end;
        BufStr(B, '?>');
      end;
  else
    BufStr(B, N.ZValue);
  end;
end;

function TXmlNode.OuterXml: string;
var
  B: TXmlBufRec;
begin
  B.N := 0;
  XmlEmit(Self, B);
  Result := BufResult(B);
end;

function TXmlNode.InnerXml: string;
var
  B: TXmlBufRec;
  i: Integer;
begin
  B.N := 0;
  XmlEmitKids(Self, B);
  Result := BufResult(B);
end;

function TXmlNode.FromEntity: string;
var
  p: TXmlNode;
begin
  Result := '';
  p := Self;
  while p <> nil do
  begin
    if p.ZRefId <> 0 then
    begin
      Result := p.ZRefName;
      Exit;
    end;
    p := p.Parent;
  end;
end;

function TXmlNode.Offset: Integer;
begin
  if ZStart >= 1 then
    Result := ZStart - 1
  else
    Result := -1;
end;

function TXmlNode.ByteLength: Integer;
begin
  if ZStart >= 1 then
    Result := ZStop - ZStart
  else
    Result := 0;
end;

{ ---- the document ---- }

constructor TXmlDoc.Create;
begin
  ZNamespaces := True;
  ZDirty := True;
  FVersion := '1.0';
end;

function TXmlDoc.CreateElement(const Nm: string): TXmlNode;
var
  c: Integer;
begin
  if not XmlIsName(Nm) then
    XmlBad('invalid element name ' + Nm);
  Result := XmlMake(xkElement, Self);
  Result.Name := Nm;
  Result.Local := Nm;
  Result.ZNew := True;
  c := Pos(':', Nm);
  if (c > 1) and (c < Length(Nm)) and ZNamespaces then
  begin
    Result.Prefix := Copy(Nm, 1, c - 1);
    Result.Local := Copy(Nm, c + 1, Length(Nm) - c);
  end;
end;

function TXmlDoc.CreateText(const S: string): TXmlNode;
begin
  Result := XmlMake(xkText, Self);
  Result.ZValue := S;
  Result.ZChanged := True;
end;

function TXmlDoc.CreateCData(const S: string): TXmlNode;
begin
  Result := XmlMake(xkCData, Self);
  Result.ZValue := S;
  Result.ZChanged := True;
end;

function TXmlDoc.CreateComment(const S: string): TXmlNode;
begin
  Result := XmlMake(xkComment, Self);
  Result.ZValue := S;
  Result.ZChanged := True;
end;

function TXmlDoc.CreatePI(const ATarget, AData: string): TXmlNode;
begin
  if (not XmlIsName(ATarget)) or (XmlLower(ATarget) = 'xml') then
    XmlBad('invalid processing instruction target ' + ATarget);
  Result := XmlMake(xkPI, Self);
  Result.Name := ATarget;
  Result.ZValue := AData;
  Result.ZChanged := True;
end;

procedure TXmlDoc.AddTop(N: TXmlNode);
begin
  if (N.Parent <> nil) or ((N.Doc <> nil) and (N.Doc <> Self)) then
    XmlBad('the node already has a place; Detach it first');
  if N.Kind = xkElement then
  begin
    if Root <> nil then
      XmlBad('the document already has a root element');
    Root := N;
  end
  else if (N.Kind = xkText) and (Trim(N.ZValue) <> '') then
    XmlBad('text is not allowed outside the root element');
  XmlSetDoc(N, Self);
  XmlAddKid(ZKids, ZCount, N);
  XmlResolve(N);
  ZDirty := True;
end;

function TXmlDoc.Count: Integer;
begin
  Result := ZCount;
end;

function TXmlDoc.Item(I: Integer): TXmlNode;
begin
  if (I < 0) or (I >= ZCount) then
    XmlBad('top level node ' + IntToStr(I) + ' of ' + IntToStr(ZCount));
  Result := ZKids[I];
end;

{ Whether writing the children of N would write a reference as its nodes }
function XmlExpandedIn(N: TXmlNode): Boolean;
var
  i: Integer;
  k: TXmlNode;
begin
  Result := False;
  i := 0;
  while i < N.ZCount do
  begin
    k := N.ZKids[i];
    if k.ZRefId <> 0 then
    begin
      if k.ZRefHead and XmlGroupIntact(N, i) then
      begin
        i := i + k.ZRefLen;
        Continue;
      end;
      Result := True;
      Exit;
    end;
    if (k.Kind = xkElement) and XmlExpandedIn(k) then
    begin
      Result := True;
      Exit;
    end;
    i := i + 1;
  end;
end;

function TXmlDoc.EntitiesExpanded: Boolean;
var
  i: Integer;
begin
  Result := False;
  for i := 0 to ZCount - 1 do
    if (ZKids[i].Kind = xkElement) and XmlExpandedIn(ZKids[i]) then
    begin
      Result := True;
      Exit;
    end;
end;

function TXmlDoc.Xml: string;
var
  B: TXmlBufRec;
  i: Integer;
begin
  if not ZDirty then
  begin
    Result := ZSrc;
    Exit;
  end;
  B.N := 0;
  if ZBom > 0 then
    BufRange(B, ZSrc, 1, ZBom);
  for i := 0 to ZCount - 1 do
    XmlEmit(ZKids[i], B);
  Result := BufResult(B);
end;

{ ---- the writer ---- }

constructor TXmlWriter.Create;
begin
  Indent := '';
  FN := 0;
  FD := 0;
  FOpen := False;
  FWritten := False;
end;

procedure TXmlWriter.Put(const S: string);
var
  k, c: Integer;
begin
  k := Length(S);
  if k = 0 then
    Exit;
  if FN + k > Length(FS) then
  begin
    c := Length(FS) * 2;
    if c < FN + k then
      c := FN + k;
    if c < 256 then
      c := 256;
    SetLength(FS, c);
  end;
  Move(S[1], FS[FN + 1], k);
  FN := FN + k;
end;

procedure TXmlWriter.CloseOpen;
begin
  if FOpen then
  begin
    Put('>');
    FOpen := False;
  end;
end;

procedure TXmlWriter.Newline(Level: Integer);
var
  i: Integer;
begin
  if (FN > 0) and (FS[FN] = #10) then
  begin
    { already at the start of a line }
  end
  else if FN > 0 then
    Put(#10);
  for i := 1 to Level do
    Put(Indent);
end;

procedure TXmlWriter.Decl(const AStandalone: string);
begin
  if FN > 0 then
    XmlBad('the declaration comes first');
  Put('<?xml version="1.0" encoding="UTF-8"');
  if AStandalone <> '' then
    Put(' standalone="' + AStandalone + '"');
  Put('?>' + #10);
end;

procedure TXmlWriter.Start(const Nm: string);
begin
  if not XmlIsName(Nm) then
    XmlBad('invalid element name ' + Nm);
  if (FD = 0) and FWritten and (FN > 0) and (Indent = '') and False then
    XmlBad('a second root element');
  CloseOpen;
  if (Indent <> '') and ((FD = 0) or (FKids[FD - 1] <> 2)) then
    Newline(FD);
  if FD > 0 then
  begin
    if FKids[FD - 1] = 0 then
      FKids[FD - 1] := 1;
  end;
  Put('<' + Nm);
  FOpen := True;
  FWritten := True;
  if FD >= Length(FNames) then
  begin
    SetLength(FNames, FD * 2 + 8);
    SetLength(FKids, FD * 2 + 8);
  end;
  FNames[FD] := Nm;
  FKids[FD] := 0;
  FD := FD + 1;
end;

procedure TXmlWriter.Attr(const Nm, AValue: string);
begin
  if not FOpen then
    XmlBad('Attr comes right after Start');
  if not XmlIsName(Nm) then
    XmlBad('invalid attribute name ' + Nm);
  Put(' ' + Nm + '="' + XmlEscapeMode(AValue, 1) + '"');
end;

procedure TXmlWriter.Text(const S: string);
begin
  if FD = 0 then
    XmlBad('text is not allowed outside the root element');
  CloseOpen;
  FKids[FD - 1] := 2;
  Put(XmlEscapeMode(S, 0));
end;

procedure TXmlWriter.CData(const S: string);
var
  v: string;
  p: Integer;
begin
  if FD = 0 then
    XmlBad('CDATA is not allowed outside the root element');
  CloseOpen;
  FKids[FD - 1] := 2;
  Put('<![CDATA[');
  v := S;
  p := Pos(']]>', v);
  while p > 0 do
  begin
    Put(Copy(v, 1, p + 1));
    Put(']]><![CDATA[');
    v := Copy(v, p + 2, Length(v) - p - 1);
    p := Pos(']]>', v);
  end;
  Put(v);
  Put(']]>');
end;

procedure TXmlWriter.Comment(const S: string);
begin
  if (Pos('--', S) > 0) or ((S <> '') and (S[Length(S)] = '-')) then
    XmlBad('a comment cannot hold -- or end with -');
  CloseOpen;
  if (Indent <> '') and ((FD = 0) or (FKids[FD - 1] <> 2)) then
    Newline(FD);
  if (FD > 0) and (FKids[FD - 1] = 0) then
    FKids[FD - 1] := 1;
  Put('<!--' + S + '-->');
end;

procedure TXmlWriter.ProcInst(const ATarget, AData: string);
begin
  if (not XmlIsName(ATarget)) or (XmlLower(ATarget) = 'xml') then
    XmlBad('invalid processing instruction target ' + ATarget);
  if Pos('?>', AData) > 0 then
    XmlBad('a processing instruction cannot hold ?>');
  CloseOpen;
  if (Indent <> '') and ((FD = 0) or (FKids[FD - 1] <> 2)) then
    Newline(FD);
  if (FD > 0) and (FKids[FD - 1] = 0) then
    FKids[FD - 1] := 1;
  if AData = '' then
    Put('<?' + ATarget + '?>')
  else
    Put('<?' + ATarget + ' ' + AData + '?>');
end;

procedure TXmlWriter.Raw(const S: string);
begin
  CloseOpen;
  if FD > 0 then
    FKids[FD - 1] := 2;
  Put(S);
end;

procedure TXmlWriter.EndElement;
begin
  if FD = 0 then
    XmlBad('EndElement without Start');
  FD := FD - 1;
  if FOpen then
  begin
    Put('/>');
    FOpen := False;
  end
  else
  begin
    if (Indent <> '') and (FKids[FD] = 1) then
      Newline(FD);
    Put('</' + FNames[FD] + '>');
  end;
end;

procedure TXmlWriter.Element(const Nm, AText: string);
begin
  Start(Nm);
  if AText <> '' then
    Text(AText);
  EndElement;
end;

function TXmlWriter.Output: string;
begin
  if FD > 0 then
    XmlBad('<' + FNames[FD - 1] + '> is not ended');
  Result := Copy(FS, 1, FN);
end;

end.
