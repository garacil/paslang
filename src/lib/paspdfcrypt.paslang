{ The standard security handler of PDF, to read what it protects (P494).

  A PDF whose /Encrypt entry names the Standard handler is encrypted with a
  key made from a password and the file's own values; TPdfCrypt is made from
  those values and the password that is empty, which is the one that opens
  nearly every file that readers open without asking (the file's author set
  an owner password to forbid printing or copying and no user password).
  It gives the key of each object and decrypts a string or a stream with it.

  What it handles, as ISO 32000-1 7.6 defines it for R2, R3 and R4 (RC4 with
  a key of 40 to 128 bits, V1 and V2; the crypt filters of V4: RC4, AES-128 in
  CBC mode with the padding of PKCS #5, or none) and as Adobe's extension
  levels 3 and 8 and ISO 32000-2 define it for R5 and R6 (AES-256 in CBC
  mode, the key held in the file encrypted with a key made from the
  password by SHA-256, or by the hardened hash of Algorithm 2.B). What it does
  not: a file that needs a password, the public-key handlers, the owner
  password (which only gives the same key). Setup says why it refused. }
unit paspdfcrypt;

interface

uses
  sysutils, pascipher;

const
  { how a string or a stream is protected }
  cmNone = 0;
  cmRc4 = 1;
  cmAesV2 = 2;
  cmAesV3 = 3;

type
  { the values of an encryption dictionary, as Setup takes them: V, R, the
    key length in bytes, P, whether the metadata is encrypted, how strings
    and streams are protected, and O, U, OE and UE (the last two only for
    V5) and the first string of the trailer's ID }
  TPdfCryptParams = record
    V: Integer;
    R: Integer;
    KeyBytes: Integer;
    P: Integer;
    EncMeta: Boolean;
    StrMethod: Integer;
    StmMethod: Integer;
    O: string;
    U: string;
    OE: string;
    UE: string;
    ID0: string;
  end;

  TPdfCrypt = class
  private
    FKey: string;
    FV: Integer;
    FR: Integer;
    FStr: Integer;
    FStm: Integer;
    FMeta: Boolean;
    function ObjectKey(Num, Gen: Integer; Aes: Boolean): string;
    function Hash5(const Password, Salt, UData: string): string;
  public
    { the key for these values and the password that is empty: '' when it
      was made, else the reason: the file needs a password, or is not one
      this can read }
    function Setup(const Prm: TPdfCryptParams): string;
    { Data as the object Num Gen holds it, with the method, decrypted }
    function Decrypt(Num, Gen: Integer; const Data: string; Method: Integer): string;
    property StringMethod: Integer read FStr;
    property StreamMethod: Integer read FStm;
    property EncryptMetadata: Boolean read FMeta;
  end;

{ RC4 (the key of 1 to 256 bytes) }
function PdfRc4(const Key, Data: string): string;

implementation

const
  { the padding string of Algorithm 2, in hexadecimal }
  PaddingHex = '28BF4E5E4E758A4164004E56FFFA01082E2E00B6D0683E802F0CA9FE6453697A';

function HexDecode(const H: string): string;
var
  i, a, b: Integer;

  function V(C: Integer): Integer;
  begin
    if (C >= 48) and (C <= 57) then
      Result := C - 48
    else if (C >= 65) and (C <= 70) then
      Result := C - 55
    else
      Result := C - 87;
  end;

begin
  SetLength(Result, Length(H) div 2);
  for i := 1 to Length(H) div 2 do
  begin
    a := V(Ord(H[i * 2 - 1]));
    b := V(Ord(H[i * 2]));
    Result[i] := Chr(a * 16 + b);
  end;
end;

function PdfRc4(const Key, Data: string): string;
var
  s: array[0..255] of Integer;
  i, j, k, t, n: Integer;
begin
  n := Length(Key);
  Result := Data;
  if n = 0 then
    Exit;
  for i := 0 to 255 do
    s[i] := i;
  j := 0;
  for i := 0 to 255 do
  begin
    j := (j + s[i] + Ord(Key[(i mod n) + 1])) and 255;
    t := s[i];
    s[i] := s[j];
    s[j] := t;
  end;
  i := 0;
  j := 0;
  for k := 1 to Length(Data) do
  begin
    i := (i + 1) and 255;
    j := (j + s[i]) and 255;
    t := s[i];
    s[i] := s[j];
    s[j] := t;
    Result[k] := Chr(Ord(Data[k]) xor s[(s[i] + s[j]) and 255]);
  end;
end;

{ AES in CBC mode: Iv is the block before the first }
function CbcDecrypt(const Key, Iv, Data: string): string;
var
  a: TAes;
  i, j, n: Integer;
  prev, blk, dcb: string;
begin
  Result := '';
  if not AesInit(a, Key) then
    Exit;
  n := Length(Data) div 16;
  SetLength(Result, n * 16);
  prev := Iv;
  for i := 0 to n - 1 do
  begin
    blk := Copy(Data, i * 16 + 1, 16);
    dcb := AesDecrypt(a, blk);
    for j := 1 to 16 do
      Result[i * 16 + j] := Chr(Ord(dcb[j]) xor Ord(prev[j]));
    prev := blk;
  end;
end;

function CbcEncrypt(const Key, Iv, Data: string): string;
var
  a: TAes;
  i, j, n: Integer;
  prev, blk, x: string;
begin
  Result := '';
  if not AesInit(a, Key) then
    Exit;
  n := Length(Data) div 16;
  SetLength(Result, n * 16);
  prev := Iv;
  for i := 0 to n - 1 do
  begin
    SetLength(x, 16);
    for j := 1 to 16 do
      x[j] := Chr(Ord(Data[i * 16 + j]) xor Ord(prev[j]));
    blk := AesEncrypt(a, x);
    for j := 1 to 16 do
      Result[i * 16 + j] := blk[j];
    prev := blk;
  end;
end;

function Pad32(const Password: string): string;
begin
  Result := Copy(Password + HexDecode(PaddingHex), 1, 32);
end;

function Le32(V: Integer): string;
begin
  Result := Chr(V and 255) + Chr((V shr 8) and 255) + Chr((V shr 16) and 255) + Chr((V shr 24) and 255);
end;

{ the key of a file with R2 to R4 for a password (Algorithm 2) }
function KeyR4(R, KeyBytes: Integer; const Password, O: string; P: Integer; const ID0: string; EncMeta: Boolean): string;
var
  h: string;
  i: Integer;
begin
  h := Pad32(Password) + Copy(O, 1, 32) + Le32(P) + ID0;
  if (R >= 4) and not EncMeta then
    h := h + Chr(255) + Chr(255) + Chr(255) + Chr(255);
  h := Md5(h);
  if R >= 3 then
    for i := 1 to 50 do
      h := Md5(Copy(h, 1, KeyBytes));
  Result := Copy(h, 1, KeyBytes);
end;

{ the hash of Algorithms 2.A and 2.B for R5 (one SHA-256) and R6 (the
  hardened hash: rounds of AES-128 and SHA-2 until the last byte allows) }
function TPdfCrypt.Hash5(const Password, Salt, UData: string): string;
var
  k, k1, e, rep: string;
  rnd, i, m: Integer;
  done: Boolean;
begin
  k := Sha256(Password + Salt + UData);
  if FR < 6 then
  begin
    Result := k;
    Exit;
  end;
  rnd := 0;
  done := False;
  while not done do
  begin
    rnd := rnd + 1;
    k1 := Password + k + UData;
    rep := '';
    for i := 1 to 64 do
      rep := rep + k1;
    e := CbcEncrypt(Copy(k, 1, 16), Copy(k, 17, 16), rep);
    m := 0;
    for i := 1 to 16 do
      m := m + Ord(e[i]);
    m := m mod 3;
    if m = 0 then
      k := Sha256(e)
    else if m = 1 then
      k := Sha384(e)
    else
      k := Sha512(e);
    if (rnd >= 64) and (Ord(e[Length(e)]) <= rnd - 32) then
      done := True;
  end;
  Result := Copy(k, 1, 32);
end;

function TPdfCrypt.Setup(const Prm: TPdfCryptParams): string;
var
  key, h, x, inter: string;
  i, j, V, R, KeyBytes: Integer;
begin
  V := Prm.V;
  R := Prm.R;
  KeyBytes := Prm.KeyBytes;
  FV := V;
  FR := R;
  FStr := Prm.StrMethod;
  FStm := Prm.StmMethod;
  FMeta := Prm.EncMeta;
  Result := '';
  if (R < 2) or (R > 6) or not ((V = 1) or (V = 2) or (V = 4) or (V = 5)) then
  begin
    Result := 'the encryption has V ' + IntToStr(V) + ' and R ' + IntToStr(R) + ', which are not read';
    Exit;
  end;
  if V < 5 then
  begin
    if (KeyBytes < 5) or (KeyBytes > 16) then
      KeyBytes := 5;
    if R = 2 then
      KeyBytes := 5;
    key := KeyR4(R, KeyBytes, '', Prm.O, Prm.P, Prm.ID0, Prm.EncMeta);
    { the password is the user's when the U value is what it would be }
    if R = 2 then
    begin
      x := PdfRc4(key, HexDecode(PaddingHex));
      if Copy(Prm.U, 1, 32) <> x then
      begin
        Result := 'the document is protected by a password to open it';
        Exit;
      end;
    end
    else
    begin
      h := Md5(HexDecode(PaddingHex) + Prm.ID0);
      x := PdfRc4(key, h);
      for i := 1 to 19 do
      begin
        h := '';
        for j := 1 to Length(key) do
          h := h + Chr(Ord(key[j]) xor i);
        x := PdfRc4(h, x);
      end;
      if Copy(Prm.U, 1, 16) <> x then
      begin
        Result := 'the document is protected by a password to open it';
        Exit;
      end;
    end;
    FKey := key;
  end
  else
  begin
    if (Length(Prm.U) < 48) or (Length(Prm.UE) < 32) then
    begin
      Result := 'the encryption dictionary is damaged';
      Exit;
    end;
    if Hash5('', Copy(Prm.U, 33, 8), '') <> Copy(Prm.U, 1, 32) then
    begin
      Result := 'the document is protected by a password to open it';
      Exit;
    end;
    inter := Hash5('', Copy(Prm.U, 41, 8), '');
    FKey := CbcDecrypt(inter, StringOfChar(Chr(0), 16), Copy(Prm.UE, 1, 32));
    if Length(FKey) <> 32 then
    begin
      Result := 'the file key could not be read';
      Exit;
    end;
  end;
end;

function TPdfCrypt.ObjectKey(Num, Gen: Integer; Aes: Boolean): string;
var
  s: string;
  n: Integer;
begin
  if FV >= 5 then
  begin
    Result := FKey;
    Exit;
  end;
  s := FKey + Chr(Num and 255) + Chr((Num shr 8) and 255) + Chr((Num shr 16) and 255) + Chr(Gen and 255) + Chr((Gen shr 8) and 255);
  if Aes then
    s := s + 'sAlT';
  n := Length(FKey) + 5;
  if n > 16 then
    n := 16;
  Result := Copy(Md5(s), 1, n);
end;

function TPdfCrypt.Decrypt(Num, Gen: Integer; const Data: string; Method: Integer): string;
var
  key, plain: string;
  n, pad: Integer;
begin
  if Method = cmNone then
  begin
    Result := Data;
    Exit;
  end;
  if Method = cmRc4 then
  begin
    Result := PdfRc4(ObjectKey(Num, Gen, False), Data);
    Exit;
  end;
  { AES: the first 16 bytes are the vector, the rest the blocks, the last
    byte the count of the padding }
  if Length(Data) < 32 then
  begin
    Result := '';
    Exit;
  end;
  key := ObjectKey(Num, Gen, Method = cmAesV2);
  plain := CbcDecrypt(key, Copy(Data, 1, 16), Copy(Data, 17, Length(Data)));
  n := Length(plain);
  if n > 0 then
  begin
    pad := Ord(plain[n]);
    if (pad >= 1) and (pad <= 16) and (pad <= n) then
      plain := Copy(plain, 1, n - pad);
  end;
  Result := plain;
end;

end.
