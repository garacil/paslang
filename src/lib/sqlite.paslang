function SqlMAcoshOne(X, SH, SL: Double): Double;
var
  y2, y1, y0: Double;
begin
  y2 := X * ((SqlMAcOCl[0] as Double) + X * ((SqlMAcOCl[1] as Double) + X * ((SqlMAcOCl[2] as Double) +
    X * ((SqlMAcOCl[3] as Double) + X * ((SqlMAcOCl[4] as Double) + X * (SqlMAcOCl[5] as Double))))));
  y1 := SqlMPolyDD3(X, 0, 10, SqlMAcOCh[0..19], y2);
  y1 := SqlMMulDDD(y1, y2, X, y2);
  y0 := SqlMFastTwoSum(1, y1, y1);
  y1 := y1 + y2;
  y0 := SqlMMulDDAcc2(y0, y1, SH, SL, y1);
  Result := y0 + y1;
end;

function SqlMAcoshDatabase(X, F: Double): Double;
var
  a, b, m: Integer;
  d: Double;
begin
  a := 0;
  b := 6;
  m := (a + b) div 2;
  while a <= b do
  begin
    d := SqlMAcDB[3 * m] as Double;
    if d < X then
      a := m + 1
    else if d = X then
    begin
      F := (SqlMAcDB[3 * m + 1] as Double) + (SqlMAcDB[3 * m + 2] as Double);
      Break;
    end
    else
      b := m - 1;
    m := (a + b) div 2;
  end;
  Result := F;
end;

{ SqlMAcoshRefine: e_acosh.c's as_acosh_refine, as SqlMAsinhRefine with
  x + sqrt(x^2-1) and the sums of adddd2, polydd3 and muldd_acc2. }
function SqlMAcoshRefine(X, A: Double): Double;
const
  L20: Integer = $3FD62E42FEFA3800;
  L21: Integer = $3D1EF35793C76800;
  L22: Integer = $BA49FF0342542FC3;
var
  ix, huge, t, ex, e, v, i, i1, i2, i3, i4, w, t0, er, de: Integer;
  x2h, x2l, wh, wl, sh, sl, zh, zl, ed, el2, el1, el0, L0, L1, L2, t12, t34, th, tl, tf, dh, dl, xh, xl,
    v0, v1, v2, res: Double;
begin
  ix := X as Integer;
  huge := 0;
  if ix < $4190000000000000 then
  begin
    x2h := X * X;
    x2l := Fma(X, X, -x2h);
    wh := x2h - 1;
    wh := SqlMFastTwoSum(wh, x2l, wl);
    sh := SqlMSqrt(wh);
    sl := (wl - Fma(sh, sh, -wh)) / (2.0 * sh);
    zh := SqlMFastTwoSum(X, sh, zl);
    zl := zl + sl;
    zh := SqlMFastTwoSum(zh, zl, zl);
  end
  else if ix < $4330000000000000 then
  begin
    zh := 2 * X;
    zl := -0.5 / X;
  end
  else
  begin
    zh := X;
    zl := 0;
    huge := 1;
  end;
  t := zh as Integer;
  ex := t shr 52;
  e := ex - $3FF + huge;
  t := t and $000FFFFFFFFFFFFF;
  t := t or ($3FF shl 52);
  ed := Double(e);
  v := (A - ed + (Integer($3FF0000800000000) as Double)) as Integer;
  i := (v - ($3FF shl 52)) shr 36;
  i1 := (i shr 12) and $1F;
  i2 := (i shr 8) and $F;
  i3 := (i shr 4) and $F;
  i4 := i and $F;
  el2 := (L22 as Double) * ed;
  el1 := (L21 as Double) * ed;
  el0 := (L20 as Double) * ed;
  L0 := (SqlMAcLL[3 * i1] as Double) + (SqlMAcLL[3 * (17 + i2)] as Double) +
    ((SqlMAcLL[3 * (34 + i3)] as Double) + (SqlMAcLL[3 * (51 + i4)] as Double));
  L1 := (SqlMAcLL[3 * i1 + 1] as Double) + (SqlMAcLL[3 * (17 + i2) + 1] as Double) +
    ((SqlMAcLL[3 * (34 + i3) + 1] as Double) + (SqlMAcLL[3 * (51 + i4) + 1] as Double));
  L2 := (SqlMAcLL[3 * i1 + 2] as Double) + (SqlMAcLL[3 * (17 + i2) + 2] as Double) +
    ((SqlMAcLL[3 * (34 + i3) + 2] as Double) + (SqlMAcLL[3 * (51 + i4) + 2] as Double));
  L0 := L0 + el0;
  t12 := (SqlMAcT1[i1] as Double) * (SqlMAcT2[i2] as Double);
  t34 := (SqlMAcT3[i3] as Double) * (SqlMAcT4[i4] as Double);
  th := t12 * t34;
  tl := Fma(t12, t34, -th);
  tf := t as Double;
  dh := th * tf;
  dl := Fma(th, tf, -dh);
  sh := tl * tf;
  sl := Fma(tl, tf, -sh);
  xh := SqlMFastTwoSum(dh - 1, dl, xl);
  if zl <> 0.0 then
  begin
    t := zl as Integer;
    t := t - (e shl 52);
    xl := xl + th * (t as Double);
  end;
  xh := SqlMAddDD2(xh, xl, sh, sl, xl);
  sl := xh * ((SqlMAcRCl[0] as Double) + xh * ((SqlMAcRCl[1] as Double) + xh * (SqlMAcRCl[2] as Double)));
  sh := SqlMPolyDD3(xh, xl, 3, SqlMAcRCh[0..5], sl);
  sh := SqlMMulDDAcc2(xh, xl, sh, sl, sl);
  sh := SqlMAddDD2(sh, sl, el1, el2, sl);
  sh := SqlMAddDD2(sh, sl, L1, L2, sl);
  v0 := SqlMFastTwoSum(L0, sh, v2);
  v1 := SqlMFastTwoSum(v2, sl, v2);
  v0 := v0 * 2;
  v1 := v1 * 2;
  v2 := v2 * 2;
  t := v1 as Integer;
  if (t and $000FFFFFFFFFFFFF) = 0 then
  begin
    w := v2 as Integer;
    if ((w xor t) shr 63) <> 0 then
      Dec(t)
    else
      Inc(t);
    v1 := t as Double;
