const
  SqlMInRoot: array[0..127] of Integer = (
    $3FF68A1F80D71820, $3FF65DE82AF9631F, $3FF632B1201D39E5, $3FF60870D91BF3C2,
    $3FF5DF1E4BE5E7A2, $3FF5B6B0E361668B, $3FF58F2077ECA742, $3FF568654873C1E3,
    $3FF54277F40D6CB8, $3FF51D51741283A0, $3FF4F8EB16A59835, $3FF4D53E79A0E15C,
    $3FF4B24585E1CA16, $3FF48FFA6AEA45FE, $3FF46E579AD0C47A, $3FF44D57C6785455,
    $3FF42CF5DA0B1DA2, $3FF40D2CF9B1E1CB, $3FF3EDF87E83B18E, $3FF3CF53F3A97317,
    $3FF3B13B13B13B10, $3FF393A9C60DD0E1, $3FF3769C1CBF0B05, $3FF35A0E521FF992,
    $3FF33DFCC6D81367, $3FF32263FFECDBDD, $3FF30740A4F1A8E0, $3FF2EC8F7E53640D,
    $3FF2D24D73BE4EC9, $3FF2B8778A9BF8EC, $3FF29F0AE4A7BD6F, $3FF28604BE983E91,
    $3FF26D626EDC7332, $3FF25521646AF854, $3FF23D3F25A271BC, $3FF225B94F39DA5B,
    $3FF20E8D933FBC46, $3FF1F7B9B8275CCE, $3FF1E13B97E2F7F2, $3FF1CB111F0A37D1,
    $3FF1B5384C0C28BC, $3FF19FAF2E6BEFF6, $3FF18A73E6079EE1, $3FF17584A268851E,
    $3FF160DFA21C700D, $3FF14C8332174F8C, $3FF1386DAD1CC065, $3FF1249D7B3107FB,
    $3FF1111111111120, $3FF0FDC6EFB1043E, $3FF0EABDA3C11A68, $3FF0D7F3C53851C1,
    $3FF0C567F6E4ACEF, $3FF0B318E600B285, $3FF0A10549CDDF4F, $3FF08F2BE333C85C,
    $3FF07D8B7C63AADF, $3FF06C22E8802D59, $3FF05AF103491A22, $3FF049F4B0CADB27,
    $3FF0392CDD118774, $3FF028987BDF5125, $3FF0183688662733, $3FF00806050463F7,
    $3FEFE02FB08B05A2, $3FEFA1A7BB61D36F, $3FEF648A3A321FB7, $3FEF28C9B380EBA0,
    $3FEEEE595EBA94C0, $3FEEB52D18B3D37D, $3FEE7D3959112457, $3FEE4673287F9DC5,
    $3FEE10D017AC51A6, $3FEDDC4636E9573E, $3FEDA8CC0E7149EE, $3FED7658973B887C,
    $3FED44E33454E185, $3FED1463ACB186AD, $3FECE4D2256E352E, $3FECB6271C77707C,
    $3FEC885B638E9087, $3FEC5B681BA51D60, $3FEC2F46B087A5E7, $3FEC03F0D4D1E1B0,
    $3FEBD9607E2670D9, $3FEBAF8FE1A51499, $3FEB8679709AAAC2, $3FEB5E17D566A055,
    $3FEB3665F091E62B, $3FEB0F5ED613D3F1, $3FEAE8FDCAC1A25D, $3FEAC33E41E57A2D,
    $3FEA9E1BDAFA4BE1, $3FEA79925F89DEF6, $3FEA559DC12ABD3A, $3FEA323A179BCDE9,
    $3FEA0F639EFB9E4B, $3FE9ED16B6197FD7, $3FE9CB4FDCDEC59D, $3FE9AA0BB2CE89C8,
    $3FE98946F59A8BEB, $3FE968FE7FCBC524, $3FE9492F477D78D4, $3FE929D65D2990A8,
    $3FE90AF0EA853815, $3FE8EC7C316CAE0F, $3FE8CE758ADD6570, $3FE8B0DA65FD9394,
    $3FE893A847305AC9, $3FE876DCC735D942, $3FE85A75925660F9, $3FE83E706798349D,
    $3FE822CB17FF2EB2, $3FE8078385D5C0DE, $3FE7EC97A3FEC010, $3FE7D205754F8264,
    $3FE7B7CB0BF1D70F, $3FE79DE688CD6672, $3FE784561AF81485, $3FE76B17FF2D032C,
    $3FE7522A7F49D736, $3FE7398BF1D1EE54, $3FE7213AB9772EE3, $3FE7093544A82BC7,
    $3FE6F17A0D23510E, $3FE6DA07978EDA76, $3FE6C2DC73154E64, $3FE6ABF7390648FE);

const
  SqlMAsF: array[0..5] of Integer = (
    $3FC55555555554F9, $3FB333333336127D, $3FA6DB6DAE42C0E4, $3F9F1C7E04F4AD99, $3F96E442C822D419,
    $3F9292D80F453C72);
  SqlMAsRt: array[0..3] of Integer = ($3FEFFFFFFFECC1DD, $3FDFFFFFFF757304, $3FD800496769C91A, $3FD4006318D1DAB9);

{ SqlMAsncsT: e_asin.c's table steps between 0.125 and 0.96875: asin(x)
  near the table's point c[N] as c[N+Hi+2] + T, with T = c[N+1]*xx +
  xx^2 * poly + c[N+Hi+1], the polynomial's coefficients c[N+2..N+Hi]. }
function SqlMAsncsT(XX: Double; N, Hi: Integer): Double;
var
  q: Double;
  k: Integer;
begin
  q := Fma(XX, SqlMAsncs[N + Hi] as Double, SqlMAsncs[N + Hi - 1] as Double);
  for k := Hi - 2 downto 2 do
    q := Fma(XX, q, SqlMAsncs[N + k] as Double);
  Result := Fma(SqlMAsncs[N + 1] as Double, XX, Fma(XX * XX, q, SqlMAsncs[N + Hi + 1] as Double));
end;

{ SqlMAsncsRegion: the table's region of |x| (high word K): its index N
  and the last coefficient's offset Hi; False below 0.125 or from
  0.96875 on. }
function SqlMAsncsRegion(K: Integer; out N, Hi: Integer): Boolean;
begin
  Result := True;
  if (K < $3FC00000) or (K >= $3FEF0000) then
    Exit(False);
  if K < $3FE00000 then
  begin
    if K < $3FD00000 then
      N := 11 * ((K and $000FFFFF) shr 15)
    else
      N := 11 * ((K and $000FFFFF) shr 14) + 352;
    Hi := 6;
  end
  else if K < $3FE80000 then
  begin
    N := 1056 + ((K and $000FE000) shr 11) * 3;
    Hi := 7;
  end
  else if K < $3FED8000 then
  begin
    N := 992 + ((K and $000FE000) shr 13) * 13;
    Hi := 8;
  end
  else if K < $3FEE8000 then
  begin
    N := 884 + ((K and $000FE000) shr 13) * 14;
    Hi := 9;
  end
  else
  begin
    N := 768 + ((K and $000FE000) shr 13) * 15;
    Hi := 10;
  end;
end;

{ SqlMAsinSmallPoly: the Taylor polynomial f1..f6 of asin at X2. }
function SqlMAsinSmallPoly(X2: Double): Double;
begin
  Result := Fma(Fma(Fma(Fma(Fma(SqlMAsF[5] as Double, X2, SqlMAsF[4] as Double), X2,
    SqlMAsF[3] as Double), X2, SqlMAsF[2] as Double), X2, SqlMAsF[1] as Double), X2, SqlMAsF[0] as Double);
end;

{ SqlMAsinNear1: from 0.96875 on, z = (1-|x|)/2, sqrt(z) by the inverse
  root table and Newton's step, y its first 28 bits (T24 for asin), cc
  the rest; P the series in z. }
procedure SqlMAsinNear1(Z: Double; Acos: Boolean; out Y, CC, P: Double);
var
  k: Integer;
  t, r, c, m, s: Double;
begin
  k := ((Z as Integer) shr 32) and $FFFFFFFF;
  t := (SqlMInRoot[(k and $001FFFFF) shr 14] as Double) * (((1023 + 511 - (k shr 21)) shl 52) as Double);
  r := Fma(-(t * t), Z, 1.0);
  t := t * Fma(r, Fma(r, Fma(r, SqlMAsRt[3] as Double, SqlMAsRt[2] as Double), SqlMAsRt[1] as Double),
    SqlMAsRt[0] as Double);
  c := t * Z;
  s := Fma(-(0.5 * t), c, 1.5);
  if Acos then
  begin
    m := Integer($41A0000000000000) as Double;
    Y := Fma(-m, c, Fma(m, c, c));
  end
  else
    Y := (c + (Integer($4170000000000000) as Double)) - (Integer($4170000000000000) as Double);
  { t = c*s is used only in t + y, so GCC fused them }
  CC := Fma(-Y, Y, Z) / Fma(c, s, Y);
  P := SqlMAsinSmallPoly(Z) * Z;
end;

{ SqlMAsin, SqlMAcos: glibc's asin and acos (e_asin.c, IBM's Accurate
  Mathematical Library) as __ieee754_asin_fma and __ieee754_acos_fma
  compute them: a Taylor series below 0.125, the table asncs of 2568
  coefficients up to 0.96875, a square root of (1-|x|)/2 above. }
function SqlMAsin(X: Double): Double;
var
  bx, m, k, n, hi: Integer;
  xx, res, z, y, cc, p, t, cor, res1: Double;
begin
  bx := X as Integer;
  m := bx sar 32;
  k := m and $7FFFFFFF;
  if k < $3E500000 then
    Exit(X);
  if k < $3FC00000 then
  begin
    xx := X * X;
    Exit(Fma(SqlMAsinSmallPoly(xx), xx * X, X));
  end;
  if SqlMAsncsRegion(k, n, hi) then
  begin
    if m > 0 then
      xx := X - (SqlMAsncs[n] as Double)
    else
      xx := -X - (SqlMAsncs[n] as Double);
    res := (SqlMAsncs[n + hi + 2] as Double) + SqlMAsncsT(xx, n, hi);
    if m > 0 then
      Exit(res);
    Exit(-res);
  end;
  if k < $3FF00000 then
  begin
    if m > 0 then
      z := 0.5 * (1.0 - X)
    else
      z := 0.5 * (1.0 + X);
    SqlMAsinNear1(z, False, y, cc, p);
    cor := Fma(-(2.0 * (y + cc)), p, Fma(-2.0, cc, SqlMHp1 as Double));
    res1 := Fma(-2.0, y, SqlMHp0 as Double);
    res := res1 + cor;
    if m > 0 then
      Exit(res);
    Exit(-res);
  end;
  if (k = $3FF00000) and ((bx and $FFFFFFFF) = 0) then
  begin
    if m > 0 then
      Exit(SqlMHp0 as Double);
    Exit(-(SqlMHp0 as Double));
  end;
  { the wrapper (w_asin.c): |x| > 1 answered by __kernel_standard, a NaN
    of sign 0 }
  if X <> X then
    Exit(X + X);
  Result := Integer($7FF8000000000000) as Double;
end;

function SqlMAcos(X: Double): Double;
var
  bx, m, k, n, hi: Integer;
  x2, t, r, cor, xx, y, res, z, cc, p, res1: Double;
begin
  bx := X as Integer;
  m := bx sar 32;
  k := m and $7FFFFFFF;
  if k < $3C880000 then
    Exit(SqlMHp0 as Double);
  if k < $3FC00000 then
  begin
    x2 := X * X;
    r := (SqlMHp0 as Double) - X;
    cor := Fma(-SqlMAsinSmallPoly(x2), x2 * X, (((SqlMHp0 as Double) - r) - X) + (SqlMHp1 as Double));
    Exit(r + cor);
  end;
  if SqlMAsncsRegion(k, n, hi) then
  begin
    if m > 0 then
      xx := X - (SqlMAsncs[n] as Double)
    else
      xx := -X - (SqlMAsncs[n] as Double);
    t := SqlMAsncsT(xx, n, hi);
    if m > 0 then
    begin
      y := (SqlMHp0 as Double) - (SqlMAsncs[n + hi + 2] as Double);
      t := (SqlMHp1 as Double) - t;
    end
    else
    begin
      y := (SqlMHp0 as Double) + (SqlMAsncs[n + hi + 2] as Double);
      t := (SqlMHp1 as Double) + t;
    end;
    Exit(y + t);
  end;
  if k < $3FF00000 then
  begin
    if m > 0 then
      z := 0.5 * (1.0 - X)
    else
      z := 0.5 * (1.0 + X);
    SqlMAsinNear1(z, True, y, cc, p);
    { both branches' product p*(y+cc), hoisted above the test on m by
      GCC, is apart from its sums: no fusion }
    t := p * (y + cc);
    if m < 0 then
    begin
      cor := ((SqlMHp1 as Double) - cc) - t;
      res1 := (SqlMHp0 as Double) - y;
      res := res1 + cor;
      Exit(res + res);
    end;
    cor := cc + t;
    res := y + cor;
    Exit(res + res);
  end;
  if (k = $3FF00000) and ((bx and $FFFFFFFF) = 0) then
  begin
    if m > 0 then
      Exit(0.0);
    Exit(2.0 * (SqlMHp0 as Double));
  end;
  if X <> X then
    Exit(X + X);
  Result := Integer($7FF8000000000000) as Double;
end;

{ ---- SQL's math functions (func.c under SQLITE_ENABLE_MATH_FUNCTIONS,
  lang_mathfunc.html), on the port of glibc's libm above: each answer
  the bits SQLite on glibc 2.44 with FMA gives. The user data, a pointer
  to the libm function in C, is the function's number here. }

const
  SQLM_CEIL = 1;
  SQLM_FLOOR = 2;
  SQLM_TRUNC = 3;
  SQLM_EXP = 4;
  SQLM_POW = 5;
  SQLM_FMOD = 6;
  SQLM_ACOS = 7;
  SQLM_ASIN = 8;
  SQLM_ATAN = 9;
  SQLM_ATAN2 = 10;
  SQLM_COS = 11;
  SQLM_SIN = 12;
  SQLM_TAN = 13;
  SQLM_COSH = 14;
  SQLM_SINH = 15;
  SQLM_TANH = 16;
  SQLM_ACOSH = 17;
  SQLM_ASINH = 18;
  SQLM_ATANH = 19;
  SQLM_SQRT = 20;
  SQLM_RADIANS = 21;
  SQLM_DEGREES = 22;

{ SqlMOne: the libm function of one argument numbered F }
function SqlMOne(F: Integer; X: Double): Double;
begin
  case F of
    SQLM_CEIL: Result := SqlMCeil(X);
    SQLM_FLOOR: Result := SqlMFloor(X);
    SQLM_TRUNC: Result := SqlMTrunc(X);
    SQLM_EXP: Result := SqlMExp(X);
    SQLM_ACOS: Result := SqlMAcos(X);
    SQLM_ASIN: Result := SqlMAsin(X);
    SQLM_ATAN: Result := SqlMAtan(X);
    SQLM_COS: Result := SqlMCos(X);
    SQLM_SIN: Result := SqlMSin(X);
    SQLM_TAN: Result := SqlMTan(X);
    SQLM_COSH: Result := SqlMCosh(X);
    SQLM_SINH: Result := SqlMSinh(X);
    SQLM_TANH: Result := SqlMTanh(X);
    SQLM_ACOSH: Result := SqlMAcosh(X);
    SQLM_ASINH: Result := SqlMAsinh(X);
    SQLM_ATANH: Result := SqlMAtanh(X);
    SQLM_SQRT: Result := SqlMSqrt(X);
    { degToRad, radToDeg: x*(M_PI/180.0) and x*(180.0/M_PI), the
      quotients folded when SQLite is compiled }
    SQLM_RADIANS: Result := X * (Integer($3F91DF46A2529D39) as Double);
  else
    Result := X * (Integer($404CA5DC1A63C1F8) as Double);
  end;
end;

{ ceilingFunc: ceil, ceiling, floor and trunc; an integer stays itself }
procedure SqlFnMCeiling(Ctx: TSqlContext);
begin
  case SqlValNumericType(Ctx.Argv[0]) of
    SQLITE_INTEGER: SqlResultInt64(Ctx, SqlValInt64(Ctx.Argv[0]));
    SQLITE_FLOAT: SqlResultDouble(Ctx, SqlMOne(Ctx.Func.UserData, SqlValDouble(Ctx.Argv[0])));
  end;
end;

{ logFunc: ln(X), log(X) and log10(X), log2(X), log(B,X) = ln(X)/ln(B);
  NULL for an argument not above 0. As SQLite's, the two-argument form
  asks argv[0]'s type twice, never argv[1]'s }
procedure SqlFnMLog(Ctx: TSqlContext);
var
  t: Integer;
  x, b, ans: Double;
begin
  t := SqlValNumericType(Ctx.Argv[0]);
  if (t <> SQLITE_INTEGER) and (t <> SQLITE_FLOAT) then
    Exit;
  x := SqlValDouble(Ctx.Argv[0]);
  if x <= 0.0 then
    Exit;
  if Ctx.Argc = 2 then
  begin
    t := SqlValNumericType(Ctx.Argv[0]);
    if (t <> SQLITE_INTEGER) and (t <> SQLITE_FLOAT) then
      Exit;
    b := SqlMLog(x);
    if b <= 0.0 then
      Exit;
    x := SqlValDouble(Ctx.Argv[1]);
    if x <= 0.0 then
      Exit;
    ans := SqlMLog(x) / b;
  end
  else
    case Ctx.Func.UserData of
      1: ans := SqlMLog10(x);
      2: ans := SqlMLog2(x);
    else
      ans := SqlMLog(x);
    end;
  SqlResultDouble(Ctx, ans);
end;

{ math1Func: exp and the trigonometric and hyperbolic functions, sqrt,
  radians, degrees }
procedure SqlFnMOne(Ctx: TSqlContext);
var
  t: Integer;
begin
  t := SqlValNumericType(Ctx.Argv[0]);
  if (t <> SQLITE_INTEGER) and (t <> SQLITE_FLOAT) then
    Exit;
  SqlResultDouble(Ctx, SqlMOne(Ctx.Func.UserData, SqlValDouble(Ctx.Argv[0])));
end;

{ math2Func: pow, power, mod, atan2 }
procedure SqlFnMTwo(Ctx: TSqlContext);
var
  t: Integer;
  v0, v1: Double;
begin
  t := SqlValNumericType(Ctx.Argv[0]);
  if (t <> SQLITE_INTEGER) and (t <> SQLITE_FLOAT) then
    Exit;
  t := SqlValNumericType(Ctx.Argv[1]);
  if (t <> SQLITE_INTEGER) and (t <> SQLITE_FLOAT) then
    Exit;
  v0 := SqlValDouble(Ctx.Argv[0]);
  v1 := SqlValDouble(Ctx.Argv[1]);
  case Ctx.Func.UserData of
    SQLM_POW: SqlResultDouble(Ctx, SqlMPow(v0, v1));
    SQLM_FMOD: SqlResultDouble(Ctx, SqlMFmod(v0, v1));
  else
    SqlResultDouble(Ctx, SqlMAtan2(v0, v1));
  end;
end;

{ piFunc: M_PI }
procedure SqlFnMPi(Ctx: TSqlContext);
begin
  SqlResultDouble(Ctx, Integer($400921FB54442D18) as Double);
end;

procedure SqlFnSign(Ctx: TSqlContext);
var
  t: Integer;
  x: Double;
begin
  t := SqlValNumericType(Ctx.Argv[0]);
  if (t <> SQLITE_INTEGER) and (t <> SQLITE_FLOAT) then
    Exit;
  x := SqlValDouble(Ctx.Argv[0]);
  if x < 0.0 then
    SqlResultInt64(Ctx, -1)
  else if x > 0.0 then
    SqlResultInt64(Ctx, 1)
  else
    SqlResultInt64(Ctx, 0);
end;

{ ---- the aggregates ---- }

type
  { SumCtx }
  TSqlSumCtx = class
    RSum: Double;
    RErr: Double;
    ISum: Integer;
    Cnt: Integer;
    Approx: Boolean;
    Ovrfl: Boolean;
  end;

  TSqlCountCtx = class
    N: Integer;
  end;

  { the best value so far of min() and max() }
  TSqlMinMaxCtx = class
    Best: TSqlMem;
  end;

  { GroupConcatCtx }
  TSqlGroupConcatCtx = class
    Acc: TSqlStrAccum;
    NAccum: Integer;
    NFirstSepLength: Integer;
    SepLengths: array of Integer;
    HasSepLengths: Boolean;
  end;

procedure SqlMakeSum(Ctx: TSqlContext);
begin
  Ctx.PMem.M.Obj := TSqlSumCtx.Create;
end;

procedure SqlMakeCount(Ctx: TSqlContext);
begin
  Ctx.PMem.M.Obj := TSqlCountCtx.Create;
end;

procedure SqlMakeMinMax(Ctx: TSqlContext);
begin
  Ctx.PMem.M.Obj := TSqlMinMaxCtx.Create;
end;

procedure SqlMakeGroupConcat(Ctx: TSqlContext);
var
  g: TSqlGroupConcatCtx;
begin
  g := TSqlGroupConcatCtx.Create;
  g.Acc := SqlStrNew(0);
  Ctx.PMem.M.Obj := g;
end;

{ sqlite3IsOverflow: an infinity or a NaN }
function SqlIsOverflow(R: Double): Boolean;
begin
  Result := (SqlRealToBits(R) and $7ff0000000000000) = $7ff0000000000000;
end;

{ kahanBabuskaNeumaierStep }
procedure SqlKbnStep(P: TSqlSumCtx; R: Double);
var
  s, t: Double;
begin
  s := P.RSum;
  t := s + R;
  if Abs(s) > Abs(R) then
    P.RErr := P.RErr + ((s - t) + R)
  else
    P.RErr := P.RErr + ((R - t) + s);
  P.RSum := t;
end;

procedure SqlKbnStepInt64(P: TSqlSumCtx; V: Integer);
var
  big, sm: Integer;
begin
  if (V <= -4503599627370496) or (V >= 4503599627370496) then
  begin
    sm := V mod 16384;
    big := V - sm;
    SqlKbnStep(P, big);
    SqlKbnStep(P, sm);
  end
  else
    SqlKbnStep(P, V);
end;

procedure SqlKbnInit(P: TSqlSumCtx; V: Integer);
var
  sm: Integer;
begin
  if (V <= -4503599627370496) or (V >= 4503599627370496) then
  begin
    sm := V mod 16384;
    P.RSum := V - sm;
    P.RErr := sm;
  end
  else
  begin
    P.RSum := V;
    P.RErr := 0.0;
  end;
end;

procedure SqlFnSumStep(Ctx: TSqlContext);
var
  p: TSqlSumCtx;
  t, x: Integer;
begin
  p := SqlAggContext(Ctx, @SqlMakeSum) as TSqlSumCtx;
  t := SqlValNumericType(Ctx.Argv[0]);
  if (p <> nil) and (t <> SQLITE_NULL) then
  begin
    Inc(p.Cnt);
    if not p.Approx then
    begin
      if t <> SQLITE_INTEGER then
      begin
        SqlKbnInit(p, p.ISum);
        p.Approx := True;
        SqlKbnStep(p, SqlValDouble(Ctx.Argv[0]));
      end
      else
      begin
        x := p.ISum;
        if SqlAddInt64(x, SqlValInt64(Ctx.Argv[0])) then
          p.ISum := x
        else
        begin
          p.Ovrfl := True;
          SqlKbnInit(p, p.ISum);
          p.Approx := True;
          SqlKbnStepInt64(p, SqlValInt64(Ctx.Argv[0]));
        end;
      end;
    end
    else if t = SQLITE_INTEGER then
      SqlKbnStepInt64(p, SqlValInt64(Ctx.Argv[0]))
    else
    begin
      p.Ovrfl := False;
      SqlKbnStep(p, SqlValDouble(Ctx.Argv[0]));
    end;
  end;
end;

procedure SqlFnSumInverse(Ctx: TSqlContext);
var
  p: TSqlSumCtx;
  t, x, iv: Integer;
begin
  p := SqlAggContext(Ctx, @SqlMakeSum) as TSqlSumCtx;
  t := SqlValNumericType(Ctx.Argv[0]);
  if (p <> nil) and (t <> SQLITE_NULL) then
  begin
    Dec(p.Cnt);
    if not p.Approx then
    begin
      x := p.ISum;
      if SqlSubInt64(x, SqlValInt64(Ctx.Argv[0])) then
      begin
        p.ISum := x;
        Exit;
      end;
      p.Ovrfl := True;
      p.Approx := True;
      SqlKbnInit(p, p.ISum);
    end;
    if t = SQLITE_INTEGER then
    begin
      iv := SqlValInt64(Ctx.Argv[0]);
      if iv <> SqlSmallestInt64 then
        SqlKbnStepInt64(p, -iv)
      else
      begin
        SqlKbnStepInt64(p, SqlLargestInt64);
        SqlKbnStepInt64(p, 1);
      end;
    end
    else
      SqlKbnStep(p, -SqlValDouble(Ctx.Argv[0]));
  end;
end;

procedure SqlFnSumFinal(Ctx: TSqlContext);
var
  p: TSqlSumCtx;
begin
  p := SqlAggContext(Ctx, nil) as TSqlSumCtx;
  if (p <> nil) and (p.Cnt > 0) then
  begin
    if p.Approx then
    begin
      if p.Ovrfl then
        SqlResultError(Ctx, 'integer overflow')
      else if not SqlIsOverflow(p.RErr) then
        SqlResultDouble(Ctx, p.RSum + p.RErr)
      else
        SqlResultDouble(Ctx, p.RSum);
    end
    else
      SqlResultInt64(Ctx, p.ISum);
  end;
end;

procedure SqlFnAvgFinal(Ctx: TSqlContext);
var
  p: TSqlSumCtx;
  r: Double;
begin
  p := SqlAggContext(Ctx, nil) as TSqlSumCtx;
  if (p <> nil) and (p.Cnt > 0) then
  begin
    if p.Approx then
    begin
      r := p.RSum;
      if not SqlIsOverflow(p.RErr) then
        r := r + p.RErr;
    end
    else
      r := p.ISum;
    SqlResultDouble(Ctx, r / p.Cnt);
  end;
end;

procedure SqlFnTotalFinal(Ctx: TSqlContext);
var
  p: TSqlSumCtx;
  r: Double;
begin
  r := 0.0;
  p := SqlAggContext(Ctx, nil) as TSqlSumCtx;
  if p <> nil then
  begin
    if p.Approx then
    begin
      r := p.RSum;
      if not SqlIsOverflow(p.RErr) then
        r := r + p.RErr;
    end
    else
      r := p.ISum;
  end;
  SqlResultDouble(Ctx, r);
end;

procedure SqlFnCountStep(Ctx: TSqlContext);
var
  p: TSqlCountCtx;
begin
  p := SqlAggContext(Ctx, @SqlMakeCount) as TSqlCountCtx;
  if ((Ctx.Argc = 0) or (SqlValType(Ctx.Argv[0]) <> SQLITE_NULL)) and (p <> nil) then
    Inc(p.N);
end;

procedure SqlFnCountFinal(Ctx: TSqlContext);
var
  p: TSqlCountCtx;
begin
  p := SqlAggContext(Ctx, nil) as TSqlCountCtx;
  if p <> nil then
    SqlResultInt64(Ctx, p.N)
  else
    SqlResultInt64(Ctx, 0);
end;

procedure SqlFnCountInverse(Ctx: TSqlContext);
var
  p: TSqlCountCtx;
begin
  p := SqlAggContext(Ctx, @SqlMakeCount) as TSqlCountCtx;
  if ((Ctx.Argc = 0) or (SqlValType(Ctx.Argv[0]) <> SQLITE_NULL)) and (p <> nil) then
    Dec(p.N);
end;

procedure SqlFnMinMaxStep(Ctx: TSqlContext);
var
  p: TSqlMinMaxCtx;
  cmp: Integer;
  isMax: Boolean;
begin
  p := SqlAggContext(Ctx, @SqlMakeMinMax) as TSqlMinMaxCtx;
  if p = nil then
    Exit;
  if SqlValType(Ctx.Argv[0]) = SQLITE_NULL then
  begin
    if p.Best.Flags <> 0 then
      SqlSkipAccumulatorLoad(Ctx);
  end
  else if p.Best.Flags <> 0 then
  begin
    isMax := Ctx.Func.UserData <> 0;
    cmp := SqlMemCompare(p.Best, Ctx.Argv[0].M, SqlGetFuncColl(Ctx));
    if (isMax and (cmp < 0)) or ((not isMax) and (cmp > 0)) then
      SqlMemCopy(p.Best, Ctx.Argv[0].M)
    else
      SqlSkipAccumulatorLoad(Ctx);
  end
  else
    SqlMemCopy(p.Best, Ctx.Argv[0].M);
end;

procedure SqlMinMaxValueFinal(Ctx: TSqlContext; Value: Boolean);
var
  p: TSqlMinMaxCtx;
  r: TSqlReg;
begin
  p := SqlAggContext(Ctx, nil) as TSqlMinMaxCtx;
  if p <> nil then
  begin
    if p.Best.Flags <> 0 then
    begin
      r := TSqlReg.Create;
      r.M := p.Best;
      SqlResultValue(Ctx, r);
    end;
    if not Value then
      SqlMemSetNull(p.Best);
  end;
end;

procedure SqlFnMinMaxValue(Ctx: TSqlContext);
begin
  SqlMinMaxValueFinal(Ctx, True);
end;

procedure SqlFnMinMaxFinal(Ctx: TSqlContext);
begin
  SqlMinMaxValueFinal(Ctx, False);
end;

procedure SqlFnGroupConcatStep(Ctx: TSqlContext);
var
  g: TSqlGroupConcatCtx;
  zval, zsep: string;
  nval, nsep, i, na: Integer;
  firstTerm, hasSep: Boolean;
begin
  if SqlValType(Ctx.Argv[0]) = SQLITE_NULL then
    Exit;
  g := SqlAggContext(Ctx, @SqlMakeGroupConcat) as TSqlGroupConcatCtx;
  if g = nil then
    Exit;
  firstTerm := g.Acc.MxAlloc = 0;
  g.Acc.MxAlloc := SqlMaxLength;
  if Ctx.Argc = 1 then
  begin
    if not firstTerm then
      SqlStrAppendChar(g.Acc, 1, ',')
    else
      g.NFirstSepLength := 1;
  end
  else if not firstTerm then
  begin
    hasSep := SqlValText(Ctx.Argv[1], zsep);
    nsep := SqlValBytes(Ctx.Argv[1]);
    if hasSep then
      SqlStrAppend(g.Acc, zsep, 1, nsep)
    else
      nsep := 0;
    if (nsep <> g.NFirstSepLength) or g.HasSepLengths then
    begin
      if not g.HasSepLengths then
      begin
        SetLength(g.SepLengths, g.NAccum + 1);
        na := g.NAccum - 1;
        for i := 0 to na - 1 do
          g.SepLengths[i] := g.NFirstSepLength;
        g.HasSepLengths := True;
      end
      else
        SetLength(g.SepLengths, g.NAccum);
      if g.NAccum > 0 then
        g.SepLengths[g.NAccum - 1] := nsep;
    end;
  end
  else
    g.NFirstSepLength := SqlValBytes(Ctx.Argv[1]);
  g.NAccum := g.NAccum + 1;
  if SqlValText(Ctx.Argv[0], zval) then
  begin
    nval := SqlValBytes(Ctx.Argv[0]);
    SqlStrAppend(g.Acc, zval, 1, nval);
  end;
end;

procedure SqlFnGroupConcatInverse(Ctx: TSqlContext);
var
  g: TSqlGroupConcatCtx;
  z: string;
  nvs, i: Integer;
begin
  if SqlValType(Ctx.Argv[0]) = SQLITE_NULL then
    Exit;
  g := SqlAggContext(Ctx, @SqlMakeGroupConcat) as TSqlGroupConcatCtx;
  if g = nil then
    Exit;
  SqlValText(Ctx.Argv[0], z);
  nvs := SqlValBytes(Ctx.Argv[0]);
  g.NAccum := g.NAccum - 1;
  if g.HasSepLengths then
  begin
    if g.NAccum > 0 then
    begin
      nvs := nvs + g.SepLengths[0];
      for i := 0 to g.NAccum - 2 do
        g.SepLengths[i] := g.SepLengths[i + 1];
    end;
  end
  else
    nvs := nvs + g.NFirstSepLength;
  if nvs >= g.Acc.NChar then
    g.Acc.NChar := 0
  else
  begin
    g.Acc.NChar := g.Acc.NChar - nvs;
    g.Acc.Text := Copy(g.Acc.Text, nvs + 1, Length(g.Acc.Text) - nvs);
  end;
  if g.Acc.NChar = 0 then
  begin
    g.Acc.MxAlloc := 0;
    SetLength(g.SepLengths, 0);
    g.HasSepLengths := False;
  end;
end;

procedure SqlFnGroupConcatFinal(Ctx: TSqlContext);
var
  g: TSqlGroupConcatCtx;
begin
  g := SqlAggContext(Ctx, nil) as TSqlGroupConcatCtx;
  if g <> nil then
    SqlResultStr(Ctx, g.Acc);
end;

procedure SqlFnGroupConcatValue(Ctx: TSqlContext);
var
  g: TSqlGroupConcatCtx;
begin
  g := SqlAggContext(Ctx, nil) as TSqlGroupConcatCtx;
  if (g <> nil) and (g.NAccum > 0) then
    SqlResultStr(Ctx, g.Acc);
end;

{ ---- the table of built-in functions ---- }

{ sqlite3FunctionSearch }
function SqlFunctionSearch(H: Integer; const Name: string): TSqlFuncDef;
begin
  Result := SqlBuiltinFuncs[H];
  while (Result <> nil) and not SqlStrIEq(Result.Name, Name) do
    Result := Result.HashNext;
end;

{ sqlite3InsertBuiltinFuncs of one FuncDef }
procedure SqlInsertBuiltin(F: TSqlFuncDef);
var
  h: Integer;
  other: TSqlFuncDef;
begin
  h := (Ord(F.Name[1]) + Length(F.Name)) mod SQLITE_FUNC_HASH_SZ;
  other := SqlFunctionSearch(h, F.Name);
  if other <> nil then
  begin
    F.NextDef := other.NextDef;
    other.NextDef := F;
  end
  else
  begin
    F.NextDef := nil;
    F.HashNext := SqlBuiltinFuncs[h];
    SqlBuiltinFuncs[h] := F;
  end;
end;

{ one FuncDef: SQLite's FUNCTION, VFUNCTION, ... macros give Flags }
procedure SqlAddFunc(const Name: string; NArg, Flags, UserData: Integer; S, F, V, I: TSqlXFunc);
var
  d: TSqlFuncDef;
begin
  d := TSqlFuncDef.Create;
  d.Name := Name;
  d.NArg := NArg;
  d.Flags := Flags or SQLITE_FUNC_BUILTIN or SQLITE_UTF8;
  d.UserData := UserData;
  d.XSFunc := S;
  d.XFinal := F;
  d.XValue := V;
  d.XInverse := I;
  SqlInsertBuiltin(d);
end;

procedure SqlFnNoop(Ctx: TSqlContext);
begin
end;

{ FUNCTION(zName, nArg, iArg, bNC, xFunc) }
procedure SqlFunction(const Name: string; NArg, Arg, NC: Integer; X: TSqlXFunc);
begin
  SqlAddFunc(Name, NArg, SQLITE_FUNC_CONSTANT or (NC * SQLITE_FUNC_NEEDCOLL), Arg, X, nil, nil, nil);
end;

{ sqlite3StrICmp: the order of A and B without the case of their ASCII
  letters, the shorter's zero byte against the other's letter }
function SqlStrICmp(const A, B: string): Integer;
var
  i, n, c, x: Integer;
begin
  n := Length(A);
  if Length(B) < n then
    n := Length(B);
  for i := 1 to n do
  begin
    c := Ord(A[i]);
    x := Ord(B[i]);
    if c <> x then
    begin
      c := SqlToLower(c) - SqlToLower(x);
      if c <> 0 then
      begin
        Result := c;
        Exit;
      end;
    end;
  end;
  if Length(A) > n then
    Result := SqlToLower(Ord(A[n + 1]))
  else if Length(B) > n then
    Result := -SqlToLower(Ord(B[n + 1]))
  else
    Result := 0;
end;

{ sqlite3StrNICmp: the same over the first N bytes }
function SqlStrNICmp(const A, B: string; N: Integer): Integer;
var
  i, ca, cb: Integer;
begin
  i := 1;
  while True do
  begin
    if N <= 0 then
    begin
      Result := 0;
      Exit;
    end;
    Dec(N);
    if i <= Length(A) then
      ca := Ord(A[i])
    else
      ca := 0;
    if i <= Length(B) then
      cb := Ord(B[i])
    else
      cb := 0;
    if (ca = 0) or (SqlToLower(ca) <> SqlToLower(cb)) then
    begin
      Result := SqlToLower(ca) - SqlToLower(cb);
      Exit;
    end;
    Inc(i);
  end;
end;

const
  { sqlite3CompileOptions (ctime.c): the options of this build, sorted;
    those of SQLite's own mutex and allocator are not this build's }
  SqlCompileOpts: array[0..36] of string = ('ATOMIC_INTRINSICS=1', 'COMPILER=paslang', 'DEFAULT_AUTOVACUUM',
    'DEFAULT_CACHE_SIZE=-2000', 'DEFAULT_FILE_FORMAT=4', 'DEFAULT_JOURNAL_SIZE_LIMIT=-1',
    'DEFAULT_MMAP_SIZE=0', 'DEFAULT_PAGE_SIZE=4096', 'DEFAULT_PCACHE_INITSZ=20', 'DEFAULT_RECURSIVE_TRIGGERS',
    'DEFAULT_SECTOR_SIZE=4096', 'DEFAULT_SYNCHRONOUS=2', 'DEFAULT_WAL_AUTOCHECKPOINT=1000',
    'DEFAULT_WAL_SYNCHRONOUS=2', 'DEFAULT_WORKER_THREADS=0', 'DIRECT_OVERFLOW_READ', 'ENABLE_MATH_FUNCTIONS',
    'MALLOC_SOFT_LIMIT=1024',
    'MAX_ATTACHED=10', 'MAX_COLUMN=2000', 'MAX_COMPOUND_SELECT=500', 'MAX_DEFAULT_PAGE_SIZE=8192',
    'MAX_EXPR_DEPTH=1000', 'MAX_FUNCTION_ARG=1000', 'MAX_LENGTH=1000000000', 'MAX_LIKE_PATTERN_LENGTH=50000',
    'MAX_MMAP_SIZE=0x7fff0000', 'MAX_PAGE_COUNT=0xfffffffe', 'MAX_PAGE_SIZE=65536', 'MAX_SCHEMA=10000000',
    'MAX_SQL_LENGTH=1000000000', 'MAX_TRIGGER_DEPTH=1000', 'MAX_VARIABLE_NUMBER=32766',
    'MAX_VDBE_OP=250000000', 'MAX_WORKER_THREADS=8', 'TEMP_STORE=1', 'THREADSAFE=1');

{ sqlite3_compileoption_get: option N of the build, False past the last }
function SqlCompileOptionGet(N: Integer; out Opt: string): Boolean;
begin
  Result := (N >= 0) and (N <= High(SqlCompileOpts));
  if Result then
    Opt := SqlCompileOpts[N]
  else
    Opt := '';
end;

{ sqlite3_compileoption_used: the build has the option ZOpt (SQLITE_ before
  it left out), a value after it or none }
function SqlCompileOptionUsed(const ZOpt: string): Boolean;
var
  z: string;
  i, n, c: Integer;
begin
  z := ZOpt;
  if SqlStrNICmp(z, 'SQLITE_', 7) = 0 then
    z := Copy(z, 8, Length(z));
  n := Length(z);
  Result := False;
  for i := 0 to High(SqlCompileOpts) do
    if SqlStrNICmp(z, SqlCompileOpts[i], n) = 0 then
    begin
      { sqlite3IsIdChar of the byte after the name }
      if n < Length(SqlCompileOpts[i]) then
        c := Ord(SqlCompileOpts[i][n + 1])
      else
        c := 0;
      if not ((c >= $80) or (c = Ord('_')) or ((c >= Ord('0')) and (c <= Ord('9'))) or
        ((c >= Ord('a')) and (c <= Ord('z'))) or ((c >= Ord('A')) and (c <= Ord('Z')))) then
      begin
        Result := True;
        Exit;
      end;
    end;
end;

{ sqlite3LoadExtension (loadext.c): this build loads no shared library, so
  a file named is one it could not open }
function SqlLoadExtension(Db: TSqlDb; const ZFile: string; out ZErrMsg: string): Integer;
begin
  Result := SQLITE_ERROR;
  if (Db.Flags and SQLITE_LoadExtension) = 0 then
    ZErrMsg := 'not authorized'
  else
    ZErrMsg := 'unable to open shared library [' + Copy(ZFile, 1, 4096 { SQLITE_MAX_PATHLEN }) + ']';
end;

{ loadExt: load_extension(X) and load_extension(X, Y), allowed only by
  sqlite3_enable_load_extension }
procedure SqlFnLoadExt(Ctx: TSqlContext);
var
  zFile, zErr: string;
begin
  if (Ctx.V.Db.Flags and SQLITE_LoadExtFunc) = 0 then
  begin
    SqlResultError(Ctx, 'not authorized');
    Exit;
  end;
  if SqlValText(Ctx.Argv[0], zFile) and (SqlLoadExtension(Ctx.V.Db, zFile, zErr) <> SQLITE_OK) then
    SqlResultError(Ctx, zErr);
end;

{ compileoptionusedFunc: sqlite_compileoption_used(X) }
procedure SqlFnCompileOptionUsed(Ctx: TSqlContext);
var
  z: string;
begin
  if SqlValText(Ctx.Argv[0], z) then
    SqlResultInt64(Ctx, Ord(SqlCompileOptionUsed(z)));
end;

{ compileoptiongetFunc: sqlite_compileoption_get(N), NULL past the last }
procedure SqlFnCompileOptionGet(Ctx: TSqlContext);
var
  z: string;
begin
  if SqlCompileOptionGet(SqlValInt(Ctx.Argv[0]), z) then
  begin
    SqlResultText(Ctx, z);
    Ctx.POut.M.Flags := Ctx.POut.M.Flags or MEM_Term;
  end
  else
    SqlResultNull(Ctx);
end;

{ the built-in functions of func.c in SQLite's order }
procedure SqlWindowFunctions; forward;
procedure SqlAlterFunctions; forward;
procedure SqlRegisterDateTimeFunctions; forward;
procedure SqlRegisterJsonFunctions; forward;

procedure SqlRegisterBuiltinFunctions;
begin
  if SqlFuncsReady then
    Exit;
  SqlFuncsReady := True;
  { sqlite3AlterFunctions (with alter.c), sqlite3WindowFunctions,
    sqlite3RegisterDateTimeFunctions and sqlite3RegisterJsonFunctions
    (with date.c and json.c) before func.c's own }
  SqlAlterFunctions;
  SqlWindowFunctions;
  SqlRegisterDateTimeFunctions;
  SqlRegisterJsonFunctions;
  SqlAddFunc('implies_nonnull_row', 2, SQLITE_FUNC_INTERNAL or SQLITE_FUNC_TEST or SQLITE_FUNC_INLINE or
    SQLITE_FUNC_CONSTANT, INLINEFUNC_implies_nonnull_row, @SqlFnNoop, nil, nil, nil);
  SqlAddFunc('expr_compare', 2, SQLITE_FUNC_INTERNAL or SQLITE_FUNC_TEST or SQLITE_FUNC_INLINE or
    SQLITE_FUNC_CONSTANT, INLINEFUNC_expr_compare, @SqlFnNoop, nil, nil, nil);
  SqlAddFunc('expr_implies_expr', 2, SQLITE_FUNC_INTERNAL or SQLITE_FUNC_TEST or SQLITE_FUNC_INLINE or
    SQLITE_FUNC_CONSTANT, INLINEFUNC_expr_implies_expr, @SqlFnNoop, nil, nil, nil);
  SqlAddFunc('affinity', 1, SQLITE_FUNC_INTERNAL or SQLITE_FUNC_TEST or SQLITE_FUNC_INLINE or
    SQLITE_FUNC_CONSTANT, INLINEFUNC_affinity, @SqlFnNoop, nil, nil, nil);
  SqlAddFunc('load_extension', 1, SQLITE_DIRECTONLY or SQLITE_FUNC_UNSAFE, 0, @SqlFnLoadExt, nil, nil, nil);
  SqlAddFunc('load_extension', 2, SQLITE_DIRECTONLY or SQLITE_FUNC_UNSAFE, 0, @SqlFnLoadExt, nil, nil, nil);
  SqlAddFunc('sqlite_compileoption_used', 1, SQLITE_FUNC_SLOCHNG, 0, @SqlFnCompileOptionUsed, nil, nil, nil);
  SqlAddFunc('sqlite_compileoption_get', 1, SQLITE_FUNC_SLOCHNG, 0, @SqlFnCompileOptionGet, nil, nil, nil);
  SqlAddFunc('unlikely', 1, SQLITE_FUNC_INLINE or SQLITE_FUNC_CONSTANT or SQLITE_FUNC_UNLIKELY,
    INLINEFUNC_unlikely, @SqlFnNoop, nil, nil, nil);
  SqlAddFunc('likelihood', 2, SQLITE_FUNC_INLINE or SQLITE_FUNC_CONSTANT or SQLITE_FUNC_UNLIKELY,
    INLINEFUNC_unlikely, @SqlFnNoop, nil, nil, nil);
  SqlAddFunc('likely', 1, SQLITE_FUNC_INLINE or SQLITE_FUNC_CONSTANT or SQLITE_FUNC_UNLIKELY,
    INLINEFUNC_unlikely, @SqlFnNoop, nil, nil, nil);
  SqlFunction('ltrim', 1, 1, 0, @SqlFnTrim);
  SqlFunction('ltrim', 2, 1, 0, @SqlFnTrim);
  SqlFunction('rtrim', 1, 2, 0, @SqlFnTrim);
  SqlFunction('rtrim', 2, 2, 0, @SqlFnTrim);
  SqlFunction('trim', 1, 3, 0, @SqlFnTrim);
  SqlFunction('trim', 2, 3, 0, @SqlFnTrim);
  SqlFunction('min', -3, 0, 1, @SqlFnMinMax);
