  isNull: Boolean;
begin
  Result := sqlite3_bind_parameter_name(Stmt, I, isNull);
end;

{ IsNull: C's NULL, which the answer '' alone does not tell from an empty text }
function sqlite3_bind_parameter_name(Stmt: TSqlite3Stmt; I: Integer; out IsNull: Boolean): string; overload;
var
  has: Boolean;
begin
  has := False;
  if Stmt = nil then
    Result := ''
  else
    Result := SqlBindParameterName(Stmt as TSqlVdbe, I, has);
  IsNull := not has;
end;

function sqlite3_bind_parameter_index(Stmt: TSqlite3Stmt; const Name: string): Integer;
begin
  if Stmt = nil then
    Result := 0
  else
    Result := SqlBindParameterIndex(Stmt as TSqlVdbe, Name);
end;

{ ---- values (vdbeapi.c's sqlite3_value_*) ---- }

function sqlite3_value_type(Value: TSqlite3Value): Integer;
begin
  Result := SqlValType(Value);
end;

function sqlite3_value_int(Value: TSqlite3Value): Integer;
begin
  Result := SqlValInt(Value);
end;

function sqlite3_value_int64(Value: TSqlite3Value): Int64;
begin
  Result := SqlValInt64(Value);
end;

function sqlite3_value_double(Value: TSqlite3Value): Double;
begin
  Result := SqlValDouble(Value);
end;

function sqlite3_value_text(Value: TSqlite3Value): string;
begin
  if not SqlValText(Value, Result) then
    Result := '';
end;

function sqlite3_value_text16(Value: TSqlite3Value): string;
begin
  if not SqlValueTextEnc(Value.M, SQLITE_UTF16NATIVE, Result, SqlRegDigits(Value)) then
    Result := '';
end;

function sqlite3_value_text16le(Value: TSqlite3Value): string;
begin
  if not SqlValueTextEnc(Value.M, SQLITE_UTF16LE, Result, SqlRegDigits(Value)) then
    Result := '';
end;

function sqlite3_value_text16be(Value: TSqlite3Value): string;
begin
  if not SqlValueTextEnc(Value.M, SQLITE_UTF16BE, Result, SqlRegDigits(Value)) then
    Result := '';
end;

function sqlite3_value_blob(Value: TSqlite3Value): string;
begin
  if not SqlValBlob(Value, Result) then
    Result := '';
end;

function sqlite3_value_bytes(Value: TSqlite3Value): Integer;
begin
  Result := SqlValBytes(Value);
end;

function sqlite3_value_bytes16(Value: TSqlite3Value): Integer;
begin
  Result := SqlValueBytesEnc(Value.M, SQLITE_UTF16NATIVE, SqlRegDigits(Value));
end;

function sqlite3_value_numeric_type(Value: TSqlite3Value): Integer;
begin
  Result := SqlValNumericType(Value);
end;

function sqlite3_value_subtype(Value: TSqlite3Value): Integer;
begin
  Result := SqlValSubtype(Value);
end;

{ the encoding of a text value as it is held (0 for another type) }
function sqlite3_value_encoding(Value: TSqlite3Value): Integer;
begin
  if (Value.M.Flags and MEM_Str) <> 0 then
    Result := Value.M.Enc
  else
    Result := 0;
end;

{ sqlite3_value_nochange: inside xUpdate, the column the UPDATE leaves }
function sqlite3_value_nochange(Value: TSqlite3Value): Integer;
begin
  Result := Ord((Value.M.Flags and (MEM_Null or MEM_Zero)) = (MEM_Null or MEM_Zero));
end;

{ sqlite3_value_frombind: the value came from a bound parameter }
function sqlite3_value_frombind(Value: TSqlite3Value): Integer;
begin
  Result := Ord((Value.M.Flags and MEM_FromBind) <> 0);
end;

function sqlite3_value_pointer(Value: TSqlite3Value; const PType: string): TObject;
begin
  Result := SqlValuePointer(Value.M, PType);
end;

{ sqlite3_value_dup: a copy that outlives the call; sqlite3_value_free
  lets go of it (the collector takes it) }
function sqlite3_value_dup(Value: TSqlite3Value): TSqlite3Value;
begin
  if Value = nil then
    Result := nil
  else
    Result := SqlValueDup(Value);
end;

procedure sqlite3_value_free(Value: TSqlite3Value);
begin
end;

{ ---- a function's call: its results and its context ---- }

procedure sqlite3_result_null(Ctx: TSqlite3Context);
begin
  SqlResultNull(Ctx as TSqlContext);
end;

procedure sqlite3_result_int(Ctx: TSqlite3Context; Value: Integer);
begin
  SqlResultInt64(Ctx as TSqlContext, Value);
end;

procedure sqlite3_result_int64(Ctx: TSqlite3Context; Value: Int64);
begin
  SqlResultInt64(Ctx as TSqlContext, Value);
end;

procedure sqlite3_result_double(Ctx: TSqlite3Context; Value: Double);
begin
  SqlResultDouble(Ctx as TSqlContext, Value);
end;

procedure sqlite3_result_text(Ctx: TSqlite3Context; const Value: string);
begin
  SqlResultText(Ctx as TSqlContext, Value);
end;

{ a text of encoding Enc as sqlite3_result_text64 takes it }
procedure sqlite3_result_text64(Ctx: TSqlite3Context; const Value: string; Enc: Integer);
var
  c: TSqlContext;
  e: Integer;
begin
  c := Ctx as TSqlContext;
  e := Enc;
  if e = SQLITE_UTF16 then
    e := SQLITE_UTF16NATIVE;
  if e = SQLITE_UTF8 then
  begin
    SqlResultText(c, Value);
    Exit;
  end;
  SqlResultText(c, SqlUtf16To8(Value, e));
end;

procedure sqlite3_result_text16(Ctx: TSqlite3Context; const Value16: string);
begin
  sqlite3_result_text64(Ctx, Value16, SQLITE_UTF16NATIVE);
end;

procedure sqlite3_result_text16le(Ctx: TSqlite3Context; const Value16: string);
begin
  sqlite3_result_text64(Ctx, Value16, SQLITE_UTF16LE);
end;

procedure sqlite3_result_text16be(Ctx: TSqlite3Context; const Value16: string);
begin
  sqlite3_result_text64(Ctx, Value16, SQLITE_UTF16BE);
end;

procedure sqlite3_result_blob(Ctx: TSqlite3Context; const Value: string);
begin
  SqlResultBlob(Ctx as TSqlContext, Value);
end;

procedure sqlite3_result_blob64(Ctx: TSqlite3Context; const Value: string);
begin
  SqlResultBlob(Ctx as TSqlContext, Value);
end;

procedure sqlite3_result_zeroblob(Ctx: TSqlite3Context; N: Integer);
var
  c: TSqlContext;
begin
  c := Ctx as TSqlContext;
  if N < 0 then
    N := 0;
  if SqlResultZeroblob(c, N) <> SQLITE_OK then
    SqlResultErrorToobig(c);
end;

function sqlite3_result_zeroblob64(Ctx: TSqlite3Context; N: Int64): Integer;
begin
  Result := SqlResultZeroblob(Ctx as TSqlContext, N);
end;

procedure sqlite3_result_value(Ctx: TSqlite3Context; Value: TSqlite3Value);
begin
  SqlResultValue(Ctx as TSqlContext, Value);
end;

procedure sqlite3_result_error(Ctx: TSqlite3Context; const Msg: string);
begin
  SqlResultError(Ctx as TSqlContext, Msg);
end;

procedure sqlite3_result_error16(Ctx: TSqlite3Context; const Msg16: string);
begin
  SqlResultError(Ctx as TSqlContext, SqlUtf16To8(Msg16, SQLITE_UTF16NATIVE));
end;

procedure sqlite3_result_error_code(Ctx: TSqlite3Context; Code: Integer);
begin
  SqlResultErrorCode(Ctx as TSqlContext, Code);
end;

procedure sqlite3_result_error_toobig(Ctx: TSqlite3Context);
begin
  SqlResultErrorToobig(Ctx as TSqlContext);
end;

procedure sqlite3_result_error_nomem(Ctx: TSqlite3Context);
begin
  SqlResultErrorCode(Ctx as TSqlContext, SQLITE_NOMEM);
end;

procedure sqlite3_result_subtype(Ctx: TSqlite3Context; T: Integer);
begin
  SqlResultSubtype(Ctx as TSqlContext, T);
end;

procedure sqlite3_result_pointer(Ctx: TSqlite3Context; P: TObject; const PType: string; XDestroy: TSqlite3Destroy);
var
  c: TSqlContext;
begin
  c := Ctx as TSqlContext;
  SqlMemSetNull(c.POut.M);
  SqlMemSetPointer(c.POut.M, P, PType);
end;

function sqlite3_user_data(Ctx: TSqlite3Context): TObject;
var
  p: TObject;
begin
  p := SqlUserData(Ctx as TSqlContext);
  if p is TSqlApiFunc then
    Result := (p as TSqlApiFunc).App
  else
    Result := p;
end;

function sqlite3_context_db_handle(Ctx: TSqlite3Context): TSqlite3;
begin
  Result := SqlContextDbHandle(Ctx as TSqlContext);
end;

{ sqlite3_aggregate_context: the aggregate's state for its group, an
  object of class Cls made at the first call (C's zeroed nByte bytes);
  nil when none was made and Cls is nil }
function sqlite3_aggregate_context(Ctx: TSqlite3Context; Cls: TClass): TObject;
var
  c: TSqlContext;
begin
  c := Ctx as TSqlContext;
  if (c.PMem.M.Flags and MEM_Agg) = 0 then
  begin
    SqlMemSetNull(c.PMem.M);
    c.PMem.M.Obj := nil;
    if Cls <> nil then
    begin
      c.PMem.M.Flags := MEM_Agg;
      c.PMem.M.Obj := Cls.Create;
    end;
  end;
  Result := c.PMem.M.Obj;
end;

function sqlite3_get_auxdata(Ctx: TSqlite3Context; N: Integer): TObject;
begin
  Result := SqlGetAuxdata(Ctx as TSqlContext, N);
end;

procedure sqlite3_set_auxdata(Ctx: TSqlite3Context; N: Integer; P: TObject; XDelete: TSqlite3Destroy);
begin
  SqlSetAuxdata(Ctx as TSqlContext, N, P, XDelete);
end;

{ ---- backups (backup.c) ---- }

function sqlite3_backup_init(Dest: TSqlite3; const DestName: string; Source: TSqlite3;
  const SourceName: string): TSqlite3Backup;
var
  dd, sd: TSqlDb;
begin
  dd := Dest as TSqlDb;
  sd := Source as TSqlDb;
  SqlDbEnter(sd);
  SqlDbEnter(dd);
  Result := SqlBackupInit(dd, DestName, sd, SourceName);
  SqlDbLeave(dd);
  SqlDbLeave(sd);
end;

function sqlite3_backup_step(P: TSqlite3Backup; NPage: Integer): Integer;
var
  b: TSqlBackup;
begin
  b := P as TSqlBackup;
  SqlDbEnter(b.SrcDb);
  Result := SqlBackupStep(b, NPage);
  SqlDbLeave(b.SrcDb);
end;

function sqlite3_backup_finish(P: TSqlite3Backup): Integer;
var
  b: TSqlBackup;
  s: TSqlDb;
begin
  if P = nil then
  begin
    Result := SQLITE_OK;
    Exit;
  end;
  b := P as TSqlBackup;
  s := b.SrcDb;
  SqlDbEnter(s);
  Result := SqlBackupFinish(b);
  SqlDbLeave(s);
end;

function sqlite3_backup_remaining(P: TSqlite3Backup): Integer;
begin
  Result := SqlBackupRemaining(P as TSqlBackup);
end;

function sqlite3_backup_pagecount(P: TSqlite3Backup): Integer;
begin
  Result := SqlBackupPagecount(P as TSqlBackup);
end;

{ ---- a database as bytes (memdb.c) ---- }

{ sqlite3_serialize: database Schema ('' main) as the bytes of its
  file; Size their number, -1 with '' when it cannot be read }
function sqlite3_serialize(Db: TSqlite3; const Schema: string; out Size: Int64; MFlags: Integer): string;
var
  d: TSqlDb;
  n: Integer;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  if not SqlSerialize(d, Schema, Schema <> '', n, MFlags, Result) then
  begin
    Result := '';
    n := -1;
  end;
  SqlDbLeave(d);
  Size := n;
end;

{ sqlite3_deserialize: database Schema ('' main) made of Data, an
  in-memory database of SzDb bytes in a buffer of SzBuf }
function sqlite3_deserialize(Db: TSqlite3; const Schema: string; const Data: string; SzDb, SzBuf: Int64;
  MFlags: Integer): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDeserialize(d, Schema, Schema <> '', Data, SzDb, SzBuf, MFlags);
  SqlDbLeave(d);
end;

{ ---- virtual tables (vtab.c) ---- }

function sqlite3_create_module_v2(Db: TSqlite3; const Name: string; Module: TSqlite3Module; Aux: TObject;
  XDestroy: TSqlite3ModuleDestroy): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlCreateModuleV2(d, Name, Module, Aux, XDestroy);
  SqlDbLeave(d);
end;

function sqlite3_create_module(Db: TSqlite3; const Name: string; Module: TSqlite3Module; Aux: TObject): Integer;
begin
  Result := sqlite3_create_module_v2(Db, Name, Module, Aux, nil);
end;

function sqlite3_declare_vtab(Db: TSqlite3; const CreateTable: string): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDeclareVtab(d, CreateTable);
  SqlDbLeave(d);
end;

{ sqlite3_vtab_config: SQLITE_VTAB_CONSTRAINT_SUPPORT takes Arg, the
  others none }
function sqlite3_vtab_config(Db: TSqlite3; Op, Arg: Integer): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlVtabConfig(d, Op, Arg);
  SqlDbLeave(d);
end;

function sqlite3_vtab_on_conflict(Db: TSqlite3): Integer;
begin
  Result := SqlVtabOnConflict(Db as TSqlDb);
end;

function sqlite3_vtab_nochange(Ctx: TSqlite3Context): Integer;
begin
  Result := Ord(SqlVtabNochange(Ctx as TSqlContext));
end;

{ the collation of constraint ICons of xBestIndex, '' for none }
function sqlite3_vtab_collation(Info: TSqlite3IndexInfo; ICons: Integer): string; overload;
var
  isNull: Boolean;
begin
  Result := sqlite3_vtab_collation(Info, ICons, isNull);
end;

{ IsNull: C's NULL, which the answer '' alone does not tell from an empty text }
function sqlite3_vtab_collation(Info: TSqlite3IndexInfo; ICons: Integer; out IsNull: Boolean): string; overload;
var
  has: Boolean;
begin
  Result := SqlVtabCollation(Info as TSqlIndexInfo, ICons, has);
  IsNull := not has;
end;

function sqlite3_vtab_in(Info: TSqlite3IndexInfo; ICons, BHandle: Integer): Integer;
begin
  Result := Ord(SqlVtabIn(Info as TSqlIndexInfo, ICons, BHandle));
end;

function sqlite3_vtab_in_first(ValueList: TSqlite3Value; out Value: TSqlite3Value): Integer;
var
  r: TSqlReg;
begin
  Result := SqlVtabInFirst(ValueList, r);
  Value := r;
end;

function sqlite3_vtab_in_next(ValueList: TSqlite3Value; out Value: TSqlite3Value): Integer;
var
  r: TSqlReg;
begin
  Result := SqlVtabInNext(ValueList, r);
  Value := r;
end;

function sqlite3_vtab_rhs_value(Info: TSqlite3IndexInfo; ICons: Integer; out Value: TSqlite3Value): Integer;
var
  r: TSqlReg;
begin
  Result := SqlVtabRhsValue(Info as TSqlIndexInfo, ICons, r);
  Value := r;
end;

function sqlite3_vtab_distinct(Info: TSqlite3IndexInfo): Integer;
begin
  Result := SqlVtabDistinct(Info as TSqlIndexInfo);
end;

{ ---- TSqlite and TSqliteRows: the connection as a class, over the C
  interface; every error an ESqliteError with SQLite's code and words ---- }

{ a value of a blob for TSqlite's argument lists: an object, which the
  binding of an array of const takes as the blob's bytes }
function SqliteBlob(const Bytes: string): TSqlite3Value;
var
  r: TSqlReg;
begin
  r := TSqlReg.Create;
  r.M.Flags := MEM_Blob;
  r.M.Z := Bytes;
  r.M.Enc := SQLITE_UTF8;
  Result := r;
end;

{ the column ICol of the statement's row as TSqliteValue }
function SqlRowValue(Stmt: TSqlite3Stmt; ICol: Integer): TSqliteValue;
begin
  Result.Kind := sqlite3_column_type(Stmt, ICol);
  Result.I := 0;
  Result.R := 0;
  Result.S := '';
  case Result.Kind of
    SQLITE_INTEGER:
      Result.I := sqlite3_column_int64(Stmt, ICol);
    SQLITE_FLOAT:
      Result.R := sqlite3_column_double(Stmt, ICol);
    SQLITE_TEXT:
      Result.S := sqlite3_column_text(Stmt, ICol);
    SQLITE_BLOB:
      Result.S := sqlite3_column_blob(Stmt, ICol);
  end;
end;

procedure TSqlite.Check(Rc: Integer);
begin
  if (Rc <> SQLITE_OK) and (Rc <> SQLITE_ROW) and (Rc <> SQLITE_DONE) then
    raise ESqliteError.Create(sqlite3_extended_errcode(FDb), sqlite3_errmsg(FDb));
end;

procedure TSqlite.Live;
begin
  if FDb = nil then
    raise ESqliteError.Create(SQLITE_MISUSE, SqliteErrStr(SQLITE_MISUSE));
end;

constructor TSqlite.Open(const APath: string);
begin
  Open(APath, 0);
end;

constructor TSqlite.Open(const APath: string; Flags: Integer);
var
  rc: Integer;
  msg: string;
  ext: Integer;
begin
  FPath := APath;
  FFlags := Flags;
  if (FFlags and (SQLITE_OPEN_READONLY or SQLITE_OPEN_READWRITE)) = 0 then
    FFlags := FFlags or SQLITE_OPEN_READWRITE or SQLITE_OPEN_CREATE;
  rc := sqlite3_open_v2(APath, FDb, FFlags, '');
  if rc <> SQLITE_OK then
  begin
    ext := rc;
    if FDb <> nil then
    begin
      ext := sqlite3_extended_errcode(FDb);
      msg := sqlite3_errmsg(FDb);
      sqlite3_close(FDb);
      FDb := nil;
    end
    else
      msg := SqliteErrStr(rc);
    raise ESqliteError.Create(ext, msg);
  end;
  sqlite3_extended_result_codes(FDb, 1);
end;

destructor TSqlite.Destroy;
begin
  Disconnect;
  inherited Destroy;
end;

procedure TSqlite.Disconnect;
begin
  if FDb <> nil then
  begin
    sqlite3_close_v2(FDb);
    FDb := nil;
  end;
end;

procedure TSqlite.Exec(const Sql: string);
var
  rc: Integer;
  msg: string;
begin
  Live;
  rc := sqlite3_exec(FDb, Sql, nil, nil, msg);
  if rc <> SQLITE_OK then
    raise ESqliteError.Create(sqlite3_extended_errcode(FDb), msg);
end;

{ the arguments bound to the statement's parameters in order }
procedure SqlBindArgs(Db: TSqlite; Stmt: TSqlite3Stmt; const Args: array of const);
var
  i, rc: Integer;
begin
  for i := 0 to High(Args) do
  begin
    case Args[i].VType of
      vtInteger:
        rc := sqlite3_bind_int64(Stmt, i + 1, Args[i].VInteger);
      vtBoolean:
        rc := sqlite3_bind_int64(Stmt, i + 1, Ord(Args[i].VBoolean));
      vtChar:
        rc := sqlite3_bind_text(Stmt, i + 1, Args[i].VChar);
      vtExtended:
        rc := sqlite3_bind_double(Stmt, i + 1, Args[i].VExtended);
      vtAnsiString:
        rc := sqlite3_bind_text(Stmt, i + 1, Args[i].VAnsiString);
      vtPointer:
        if Args[i].VPointer = nil then
          rc := sqlite3_bind_null(Stmt, i + 1)
        else
          rc := SQLITE_MISMATCH;
      vtObject:
        if Args[i].VObject is TSqlite3Value then
          rc := sqlite3_bind_value(Stmt, i + 1, Args[i].VObject as TSqlite3Value)
        else if Args[i].VObject = nil then
          rc := sqlite3_bind_null(Stmt, i + 1)
        else
          rc := SQLITE_MISMATCH;
    else
      rc := SQLITE_MISMATCH;
    end;
    if rc = SQLITE_MISMATCH then
    begin
      sqlite3_finalize(Stmt);
      raise ESqliteError.Create(SQLITE_MISMATCH, 'argument ' + IStr(i + 1) + ' cannot be bound');
    end;
    if rc <> SQLITE_OK then
    begin
      sqlite3_finalize(Stmt);
      Db.Check(rc);
    end;
  end;
end;

function TSqlite.Exec(const Sql: string; const Args: array of const): Integer;
var
  st: TSqlite3Stmt;
  rc: Integer;
begin
  Live;
  Check(sqlite3_prepare_v2(FDb, Sql, st));
  if st = nil then
  begin
    Result := 0;
    Exit;
  end;
  SqlBindArgs(Self, st, Args);
  repeat
    rc := sqlite3_step(st);
  until rc <> SQLITE_ROW;
  if rc <> SQLITE_DONE then
  begin
    rc := sqlite3_finalize(st);
    Check(rc);
  end;
  sqlite3_finalize(st);
  Result := sqlite3_changes64(FDb);
end;

function TSqlite.Query(const Sql: string): TSqliteRows;
begin
  Result := Query(Sql, []);
end;

function TSqlite.Query(const Sql: string; const Args: array of const): TSqliteRows;
var
  st: TSqlite3Stmt;
begin
  Live;
  Check(sqlite3_prepare_v2(FDb, Sql, st));
  if st <> nil then
    SqlBindArgs(Self, st, Args);
  Result := TSqliteRows.Create;
  Result.FDb := Self;
  Result.FStmt := st;
  Result.FQuery := True;
  Result.FOpen := st <> nil;
end;

function TSqlite.QueryValue(const Sql: string; const Args: array of const): TSqliteValue;
var
  r: TSqliteRows;
begin
  r := Query(Sql, Args);
  if r.Next and (r.ColumnCount > 0) then
    Result := r.Column(0)
  else
  begin
    Result.Kind := SQLITE_NULL;
    Result.I := 0;
    Result.R := 0;
    Result.S := '';
  end;
  r.Finish;
end;

function TSqlite.LastInsertRowId: Int64;
begin
  Live;
  Result := sqlite3_last_insert_rowid(FDb);
end;

function TSqlite.Changes: Int64;
begin
  Live;
  Result := sqlite3_changes64(FDb);
end;

{ the value of PRAGMA Name }
function TSqlite.Pragma(const Name: string): TSqliteValue;
begin
  Result := QueryValue('PRAGMA ' + Name, []);
end;

function TSqlite.Schema: TSqliteObjects;
var
  r: TSqliteRows;
  n: Integer;
begin
  SetLength(Result, 0);
  r := Query('SELECT type, name, tbl_name, rootpage, sql FROM main.sqlite_schema');
  n := 0;
  while r.Next do
  begin
    SetLength(Result, n + 1);
    Result[n].Kind := r.Column(0).S;
    Result[n].Name := r.Column(1).S;
    Result[n].TblName := r.Column(2).S;
    Result[n].RootPage := r.Column(3).I;
    Result[n].Sql := r.Column(4).S;
    Inc(n);
  end;
end;

function TSqlite.Rows(const Name: string): TSqliteRows;
var
  objs: TSqliteObjects;
  i: Integer;
begin
  objs := Schema;
  for i := 0 to High(objs) do
    if (AsciiLower(objs[i].Name) = AsciiLower(Name)) and (objs[i].RootPage > 0) then
    begin
      Result := RowsAt(objs[i].RootPage);
      Exit;
    end;
  raise ESqliteError.Create(SQLITE_ERROR, 'no such table: ' + Name);
end;

{ the rows of the b-tree whose root is RootPage, read as SQLite's
  btree.c walks it: an index's (or a WITHOUT ROWID table's) keys, a
  table's records by rowid; a read transaction from the first row to
  the last, unless one is open already }
function TSqlite.RowsAt(RootPage: Integer): TSqliteRows;
var
  d: TSqlDb;
  bt: TSqlBtree;
  c: TSqlBtCursor;
  ki: TSqlKeyInfo;
  rc, i: Integer;
  isIdx, own: Boolean;
  objs: TSqliteObjects;
  t: TSqlTable;
begin
  objs := Schema;
  isIdx := False;
  for i := 0 to High(objs) do
    if objs[i].RootPage = RootPage then
    begin
      if objs[i].Kind = 'index' then
        isIdx := True
      else if objs[i].Kind = 'table' then
      begin
        d := FDb as TSqlDb;
        SqlDbEnter(d);
        t := SqlFindTable(d, objs[i].Name, 'main', True);
        isIdx := (t <> nil) and not SqlHasRowid(t);
        SqlDbLeave(d);
      end;
    end;
  d := FDb as TSqlDb;
  SqlDbEnter(d);
  bt := d.ADb[0].Bt as TSqlBtree;
  SqlBtreeEnter(bt);
  own := SqlBtreeTxnState(bt) = SQLITE_TXN_NONE;
  rc := SqlBtreeBeginTrans(bt, 0, nil);
  c := nil;
  if rc = SQLITE_OK then
  begin
    c := TSqlBtCursor.Create;
    SqlBtreeCursorZero(c);
    ki := nil;
    if isIdx then
      ki := SqlKeyInfoAlloc(d, 1, 0);
    rc := SqlBtreeCursor(bt, RootPage, 0, ki, c);
    if (rc <> SQLITE_OK) and own then
      SqlBtreeCommit(bt);
  end;
  SqlBtreeLeave(bt);
  SqlDbLeave(d);
  if rc <> SQLITE_OK then
    raise ESqliteError.Create(rc, SqliteErrStr(rc));
  Result := TSqliteRows.Create;
  Result.FDb := Self;
  Result.FCur := c;
  Result.FBt := bt;
  Result.FIndex := isIdx;
  Result.FOwnTxn := own;
  Result.FOpen := True;
end;

function TSqlite.PageSize: Integer;
begin
  Result := Pragma('page_size').I;
end;

function TSqlite.PageCount: Integer;
begin
  Result := Pragma('page_count').I;
end;

function TSqlite.Encoding: Integer;
var
  e: string;
begin
  e := Pragma('encoding').S;
  if e = 'UTF-16le' then
    Result := SQLITE_UTF16LE
  else if e = 'UTF-16be' then
    Result := SQLITE_UTF16BE
  else
    Result := SQLITE_UTF8;
end;

function TSqlite.UserVersion: Integer;
begin
  Result := Pragma('user_version').I;
end;

function TSqlite.SchemaCookie: Integer;
begin
  Result := Pragma('schema_version').I;
end;

function TSqliteRows.Next: Boolean;
var
  rc, res, n, i: Integer;
  d: TSqlDb;
  c: TSqlBtCursor;
  bt: TSqlBtree;
  rec: string;
begin
  Result := False;
  if not FOpen then
    Exit;
  if FQuery then
  begin
    rc := sqlite3_step(FStmt);
    if rc = SQLITE_ROW then
    begin
      n := sqlite3_column_count(FStmt);
      SetLength(FVals, n);
      for i := 0 to n - 1 do
        FVals[i] := SqlRowValue(FStmt, i);
      Result := True;
      Exit;
    end;
    FOpen := False;
    if rc <> SQLITE_DONE then
    begin
      rc := sqlite3_finalize(FStmt);
      FStmt := nil;
      FDb.Check(rc);
    end;
    sqlite3_finalize(FStmt);
    FStmt := nil;
    Exit;
  end;
  d := FDb.FDb as TSqlDb;
  c := FCur as TSqlBtCursor;
  bt := FBt as TSqlBtree;
  SqlDbEnter(d);
  SqlBtreeEnter(bt);
  if not FStarted then
  begin
    FStarted := True;
    rc := SqlBtreeFirst(c, res);
    if (rc = SQLITE_OK) and (res <> 0) then
      rc := SQLITE_DONE;
  end
  else
    rc := SqlBtreeNext(c, 0);
  if rc = SQLITE_OK then
  begin
    if not FIndex then
      FRowId := SqlBtreeIntegerKey(c);
    n := SqlBtreePayloadSize(c);
    SetLength(rec, n);
    if n > 0 then
      rc := SqlBtreePayload(c, 0, n, @rec[1]);
  end;
  SqlBtreeLeave(bt);
  SqlDbLeave(d);
  if rc = SQLITE_OK then
  begin
    FVals := SqliteRecord(rec, d.Enc);
    Result := True;
    Exit;
  end;
  Finish;
  if rc <> SQLITE_DONE then
    raise ESqliteError.Create(rc, SqliteErrStr(rc));
end;

procedure TSqliteRows.Finish;
var
  d: TSqlDb;
  bt: TSqlBtree;
begin
  if not FOpen then
    Exit;
  FOpen := False;
  if FQuery then
  begin
    sqlite3_finalize(FStmt);
    FStmt := nil;
    Exit;
  end;
  d := FDb.FDb as TSqlDb;
  bt := FBt as TSqlBtree;
  SqlDbEnter(d);
  SqlBtreeEnter(bt);
  SqlBtreeCloseCursor(FCur as TSqlBtCursor);
  if FOwnTxn then
    SqlBtreeCommit(bt);
  SqlBtreeLeave(bt);
  SqlDbLeave(d);
  FCur := nil;
end;

function TSqliteRows.RowId: Int64;
begin
  Result := FRowId;
end;

function TSqliteRows.ColumnCount: Integer;
begin
  Result := Length(FVals);
end;

function TSqliteRows.Column(I: Integer): TSqliteValue;
begin
  if (I < 0) or (I >= Length(FVals)) then
  begin
    Result.Kind := SQLITE_NULL;
    Result.I := 0;
    Result.R := 0;
    Result.S := '';
  end
  else
    Result := FVals[I];
end;

function TSqliteRows.Values: TSqliteValues;
begin
  Result := FVals;
end;

function TSqliteRows.IsIndex: Boolean;
begin
  Result := FIndex;
end;

function TSqliteRows.ColumnName(I: Integer): string;
begin
  if FQuery and (FStmt <> nil) then
    Result := sqlite3_column_name(FStmt, I)
  else
    Result := '';
end;

{ ---- the rest of the C interface: complete.c, table.c, vdbeblob.c,
  vdbetrace.c, the trace hooks, status.c and the rest of main.c ---- }

{ sqlite3_complete: 1 when Sql ends a statement, 0 when not }
function sqlite3_complete(const Sql: string): Integer;
begin
  Result := SqlComplete(Sql);
end;

function sqlite3_complete16(const Sql16: string): Integer;
begin
  Result := SqlComplete16(Sql16);
end;

{ sqlite3_incomplete: SQLITE_OK when Sql is whole statements, otherwise
  what is still open (complete.c) }
function sqlite3_incomplete(const Sql: string): Int64;
begin
  Result := SqlIncomplete(Sql);
end;

{ sqlite3_get_table: Cells the columns' names, then the rows' values,
  IsNull beside them; NRow rows of NCol columns }
function sqlite3_get_table(Db: TSqlite3; const Sql: string; out Cells: TSqlite3StrArray; out IsNull: TSqlite3BoolArray;
  out NRow, NCol: Integer; out ErrMsg: string): Integer;
var
  d: TSqlDb;
  has: Boolean;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlGetTable(d, Sql, Cells, IsNull, NRow, NCol, ErrMsg, has);
  if not has then
    ErrMsg := '';
  SqlDbLeave(d);
end;

{ ---- incremental blob I/O ---- }

{ sqlite3_blob_open: column Column of row Row of table Table in database
  DbName ('' main); Flags 0 to read, 1 to write too }
function sqlite3_blob_open(Db: TSqlite3; const DbName, Table, Column: string; Row: Int64; Flags: Integer;
  out Blob: TSqlite3Blob): Integer;
var
  d: TSqlDb;
  b: TSqlIncrblob;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlBlobOpen(d, DbName, DbName <> '', Table, Column, Row, Flags <> 0, b);
  SqlDbLeave(d);
  Blob := b;
end;

function sqlite3_blob_close(Blob: TSqlite3Blob): Integer;
var
  b: TSqlIncrblob;
  d: TSqlDb;
begin
  if Blob = nil then
  begin
    Result := SQLITE_OK;
    Exit;
  end;
  b := Blob as TSqlIncrblob;
  d := b.Db;
  SqlDbEnter(d);
  Result := SqlBlobClose(b);
  SqlDbLeave(d);
end;

{ sqlite3_blob_read: N bytes from Offset into Buf }
function sqlite3_blob_read(Blob: TSqlite3Blob; var Buf: string; N, Offset: Integer): Integer;
var
  b: TSqlIncrblob;
begin
  b := Blob as TSqlIncrblob;
  SqlDbEnter(b.Db);
  Result := SqlBlobRead(b, Buf, N, Offset);
  SqlDbLeave(b.Db);
end;

{ sqlite3_blob_write: the first N bytes of Buf at Offset }
function sqlite3_blob_write(Blob: TSqlite3Blob; const Buf: string; N, Offset: Integer): Integer;
var
  b: TSqlIncrblob;
begin
  b := Blob as TSqlIncrblob;
  SqlDbEnter(b.Db);
  Result := SqlBlobWrite(b, Buf, N, Offset);
  SqlDbLeave(b.Db);
end;

function sqlite3_blob_bytes(Blob: TSqlite3Blob): Integer;
begin
  if Blob = nil then
    Result := 0
  else
    Result := SqlBlobBytes(Blob as TSqlIncrblob);
end;

function sqlite3_blob_reopen(Blob: TSqlite3Blob; Row: Int64): Integer;
var
  b: TSqlIncrblob;
begin
  b := Blob as TSqlIncrblob;
  SqlDbEnter(b.Db);
  Result := SqlBlobReopen(b, Row);
  SqlDbLeave(b.Db);
end;

{ ---- what a statement ran ---- }

{ sqlite3_expanded_sql: the statement's text with its parameters'
  values in place }
function sqlite3_expanded_sql(Stmt: TSqlite3Stmt): string;
var
  v: TSqlVdbe;
begin
  if Stmt = nil then
  begin
    Result := '';
    Exit;
  end;
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlVdbeExpandSql(v, SqlSql(v));
  SqlDbLeave(v.Db);
end;

{ sqlite3_trace_v2: the events of Mask (SQLITE_TRACE_*) reported to
  XCallback; Mask 0 or XCallback nil for none }
function sqlite3_trace_v2(Db: TSqlite3; Mask: Integer; XCallback: TSqlite3TraceV2; Arg: TObject): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlTraceV2(d, Mask, XCallback, Arg);
  SqlDbLeave(d);
end;

function sqlite3_trace(Db: TSqlite3; XTrace: TSqlite3TraceLegacy; Arg: TObject): TObject;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlTraceLegacy(d, XTrace, Arg);
  SqlDbLeave(d);
end;

function sqlite3_profile(Db: TSqlite3; XProfile: TSqlite3Profile; Arg: TObject): TObject;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlProfile(d, XProfile, Arg);
  SqlDbLeave(d);
end;

{ ---- the write-ahead log ---- }

{ sqlite3_wal_checkpoint_v2: database DbName ('' all of them), Mode
  SQLITE_CHECKPOINT_*; Log the frames in the log, Ckpt those copied }
function sqlite3_wal_checkpoint_v2(Db: TSqlite3; const DbName: string; Mode: Integer; out Log, Ckpt: Integer): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlWalCheckpointV2(d, DbName, DbName <> '', Mode, Log, Ckpt);
  SqlDbLeave(d);
end;

function sqlite3_wal_checkpoint(Db: TSqlite3; const DbName: string): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlWalCheckpointDb(d, DbName, DbName <> '');
  SqlDbLeave(d);
end;

{ ---- the schema, the configuration and the counters of a connection ---- }

{ sqlite3_table_column_metadata: Column '' asks whether the table is
  there; DataType and CollSeq '' when NULL }
function sqlite3_table_column_metadata(Db: TSqlite3; const DbName, TableName, ColumnName: string;
  out DataType, CollSeq: string; out NotNull, PrimaryKey, Autoinc: Integer): Integer;
var
  d: TSqlDb;
  hd, hc, nn, pk, ai: Boolean;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlTableColumnMetadata(d, DbName, DbName <> '', TableName, ColumnName, ColumnName <> '', DataType, hd,
    CollSeq, hc, nn, pk, ai);
  SqlDbLeave(d);
  NotNull := Ord(nn);
  PrimaryKey := Ord(pk);
  Autoinc := Ord(ai);
end;

{ sqlite3_db_config of an option on or off (SQLITE_DBCONFIG_ENABLE_FKEY
  and the others of an int and an int*): OnOff 1 on, 0 off, -1 leave it;
  Res its state after }
function sqlite3_db_config(Db: TSqlite3; Op, OnOff: Integer; out Res: Integer): Integer; overload;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  if Op = SQLITE_DBCONFIG_FP_DIGITS then
    Result := SqlDbConfigFpDigits(d, OnOff, Res)
  else if Op = SQLITE_DBCONFIG_LOOKASIDE then
  begin
    Result := SqlDbConfigLookaside(d, OnOff, 0);
    Res := 0;
  end
  else
    Result := SqlDbConfigFlag(d, Op, OnOff, Res);
  SqlDbLeave(d);
end;

{ SQLITE_DBCONFIG_MAINDBNAME: the main database's schema name }
function sqlite3_db_config(Db: TSqlite3; Op: Integer; const Name: string): Integer; overload;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  if Op = SQLITE_DBCONFIG_MAINDBNAME then
    Result := SqlDbConfigMainDbName(d, Name)
  else
    Result := SQLITE_ERROR;
  SqlDbLeave(d);
end;

function sqlite3_db_cacheflush(Db: TSqlite3): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDbCacheflush(d);
  SqlDbLeave(d);
end;

{ sqlite3_drop_modules: every module but those of Keep (C's NULL list:
  KeepAny False drops them all) }
function sqlite3_drop_modules(Db: TSqlite3; const Keep: array of string; KeepAny: Boolean): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDropModules(d, Keep, KeepAny);
  SqlDbLeave(d);
end;

function sqlite3_status64(Op: Integer; out Current, Highwater: Int64; ResetFlag: Integer): Integer;
var
  c, h: Integer;
begin
  Result := SqlStatus64(Op, c, h, ResetFlag <> 0);
  Current := c;
  Highwater := h;
end;

function sqlite3_status(Op: Integer; out Current, Highwater: Integer; ResetFlag: Integer): Integer;
begin
  Result := SqlStatus(Op, Current, Highwater, ResetFlag <> 0);
end;

function sqlite3_db_status64(Db: TSqlite3; Op: Integer; out Current, Highwater: Int64; ResetFlag: Integer): Integer;
var
  d: TSqlDb;
  c, h: Integer;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDbStatus64(d, Op, c, h, ResetFlag <> 0);
  SqlDbLeave(d);
  Current := c;
  Highwater := h;
end;

function sqlite3_db_status(Db: TSqlite3; Op: Integer; out Current, Highwater: Integer; ResetFlag: Integer): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDbStatus(d, Op, Current, Highwater, ResetFlag <> 0);
  SqlDbLeave(d);
end;

{ ---- SQL's words and the string helpers ---- }

function sqlite3_keyword_count: Integer;
begin
  Result := SqlKeywordCount;
end;

{ sqlite3_keyword_name: keyword I (from 0) in Name; SQLITE_ERROR past the
  last }
function sqlite3_keyword_name(I: Integer; out Name: string): Integer;
begin
  Result := SqlKeywordName(I, Name);
end;

function sqlite3_keyword_check(const Name: string): Integer;
begin
  Result := SqlKeywordCheck(Name, Length(Name));
end;

{ sqlite3_strglob, sqlite3_strlike: 0 when Subj matches Pat }
function sqlite3_strglob(const Pat, Subj: string): Integer;
begin
  Result := SqlStrGlob(Pat, True, Subj, True);
end;

function sqlite3_strlike(const Pat, Subj: string; Esc: Integer): Integer;
begin
  Result := SqlStrLike(Pat, True, Subj, True, Esc);
end;

function sqlite3_stricmp(const A, B: string): Integer;
begin
  Result := SqlStrICmpApi(A, True, B, True);
end;

function sqlite3_strnicmp(const A, B: string; N: Integer): Integer;
begin
  Result := SqlStrNICmpApi(A, True, B, True, N);
end;

{ sqlite3_sleep: Ms milliseconds, the routine parked (the VFS's xSleep) }
function sqlite3_sleep(Ms: Integer): Integer;
begin
  Result := SqlSleep(Ms);
end;

end.
