function SqlMAsinhZero(X, X2H, X2L: Double): Double;
var
  y2, y1, y0: Double;
  t, w: Integer;
begin
  y2 := X2H * ((SqlMAsZCl[0] as Double) + X2H * ((SqlMAsZCl[1] as Double) + X2H * ((SqlMAsZCl[2] as Double) +
    X2H * ((SqlMAsZCl[3] as Double) + X2H * (SqlMAsZCl[4] as Double)))));
  y1 := SqlMPolyDD(X2H, X2L, 12, SqlMAsZCh[0..23], y2);
  y1 := SqlMMulDDAcc(y1, y2, X2H, X2L, y2);
  y1 := SqlMMulDDD(y1, y2, X, y2);
  y0 := SqlMFastTwoSum(X, y1, y1);
  y1 := SqlMFastTwoSum(y1, y2, y2);
  t := y1 as Integer;
  if (t and $000FFFFFFFFFFFFF) = 0 then
  begin
    w := y2 as Integer;
    if ((w xor t) shr 63) <> 0 then
      Dec(t)
    else
      Inc(t);
    y1 := t as Double;
  end;
  Result := y0 + y1;
end;

function SqlMAsinhDatabase(X, F: Double): Double;
var
  a, b, m: Integer;
  ax, d, sg: Double;
begin
  ax := Abs(X);
  a := 0;
  b := 34;
  m := (a + b) div 2;
  while a <= b do
  begin
    d := SqlMAsDB[3 * m] as Double;
    if d < ax then
      a := m + 1
    else if d = ax then
    begin
      sg := SqlMCopySign(1, X);
      F := sg * (SqlMAsDB[3 * m + 1] as Double) + sg * (SqlMAsDB[3 * m + 2] as Double);
      Break;
    end
    else
      b := m - 1;
    m := (a + b) div 2;
  end;
  Result := F;
end;

{ SqlMAsinhRefine: s_asinh.c's as_asinh_refine, 2*log(ZH + ZL)-ish in
  triple-double for the hard cases: the argument cut by four tables of
  2^(-k/2^n) and their logs in three parts. }
function SqlMAsinhRefine(X, ZH, ZL, A: Double): Double;
const
  L20: Integer = $3FD62E42FEFA3800;
  L21: Integer = $3D1EF35793C76800;
  L22: Integer = $BA49FF0342542FC3;
var
  t, ex, e, v, i, i1, i2, i3, i4, w, t0, er, de: Integer;
  ed, el2, el1, el0, L0, L1, L2, t12, t34, th, tl, tf, dh, dl, sh, sl, xh, xl, v0, v1, v2, sg, res: Double;
begin
  t := ZH as Integer;
  ex := t shr 52;
  e := ex - $3FF + Ord(ZL = 0.0);
  t := t and $000FFFFFFFFFFFFF;
  t := t or ($3FF shl 52);
  ed := Double(e);
  v := (A - ed + (Integer($3FF0000800000000) as Double)) as Integer;
  i := (v - ($3FF shl 52)) shr 36;
  i1 := (i shr 12) and $1F;
  i2 := (i shr 8) and $F;
  i3 := (i shr 4) and $F;
  i4 := i and $F;
  el2 := (L22 as Double) * ed;
  el1 := (L21 as Double) * ed;
  el0 := (L20 as Double) * ed;
  L0 := (SqlMAsLL[3 * i1] as Double) + (SqlMAsLL[3 * (17 + i2)] as Double) +
    ((SqlMAsLL[3 * (34 + i3)] as Double) + (SqlMAsLL[3 * (51 + i4)] as Double));
  L1 := (SqlMAsLL[3 * i1 + 1] as Double) + (SqlMAsLL[3 * (17 + i2) + 1] as Double) +
    ((SqlMAsLL[3 * (34 + i3) + 1] as Double) + (SqlMAsLL[3 * (51 + i4) + 1] as Double));
  L2 := (SqlMAsLL[3 * i1 + 2] as Double) + (SqlMAsLL[3 * (17 + i2) + 2] as Double) +
    ((SqlMAsLL[3 * (34 + i3) + 2] as Double) + (SqlMAsLL[3 * (51 + i4) + 2] as Double));
  L0 := L0 + el0;
  t12 := (SqlMAsT1[i1] as Double) * (SqlMAsT2[i2] as Double);
  t34 := (SqlMAsT3[i3] as Double) * (SqlMAsT4[i4] as Double);
  th := t12 * t34;
  tl := Fma(t12, t34, -th);
  tf := t as Double;
  dh := th * tf;
  dl := Fma(th, tf, -dh);
  sh := tl * tf;
  sl := Fma(tl, tf, -sh);
  xh := SqlMFastTwoSum(dh - 1, dl, xl);
  if ZL <> 0.0 then
  begin
    t := ZL as Integer;
    t := t - (e shl 52);
    xl := xl + th * (t as Double);
  end;
  xh := SqlMAddDD(xh, xl, sh, sl, xl);
  sl := xh * ((SqlMAsRCl[0] as Double) + xh * ((SqlMAsRCl[1] as Double) + xh * (SqlMAsRCl[2] as Double)));
  sh := SqlMPolyDD(xh, xl, 3, SqlMAsRCh[0..5], sl);
  sh := SqlMMulDDAcc(xh, xl, sh, sl, sl);
  sh := SqlMAddDD(sh, sl, el1, el2, sl);
  sh := SqlMAddDD(sh, sl, L1, L2, sl);
  v0 := SqlMFastTwoSum(L0, sh, v2);
  v1 := SqlMFastTwoSum(v2, sl, v2);
  v0 := SqlMFastTwoSum(v0, v1, v1);
  v1 := SqlMFastTwoSum(v1, v2, v2);
  sg := SqlMCopySign(2, X);
  v0 := v0 * sg;
  v1 := v1 * sg;
  v2 := v2 * sg;
  t := v1 as Integer;
  if (t and $000FFFFFFFFFFFFF) = 0 then
  begin
    w := v2 as Integer;
    if ((w xor t) shr 63) <> 0 then
      Dec(t)
    else
      Inc(t);
    v1 := t as Double;
  end;
  t0 := v0 as Integer;
  er := (t + 41) and $000FFFFFFFFFFFFF;
  de := ((t0 shr 52) and $7FF) - ((t shr 52) and $7FF);
  res := v0 + v1;
  if SqlMUlt(99, de) or (er < 80) then
    Exit(SqlMAsinhDatabase(X, res));
  Result := res;
end;

{ SqlMAsinhLog: the part of asinh and acosh past the small arguments
  (s_asinh.c, e_acosh.c): log(AH + AL) by B's correction of the
  mantissa's first bits, the tables r1, r2 of 1/c and l1, l2 of log(c),
  and a polynomial of degree 6 at r*m - 1; Off the exponent's bias (one
  less where AH is x, not 2x). The result is lh + ll, Lb the fast
  path's verdict. }
procedure SqlMAsinhLog(AH, AL: Double; Off: Integer; out LH, LL: Double);
const
  L2h: Integer = $3FE62E42FEFA3800;
  L2l: Integer = $3D2EF35793C76730;
var
  t, ex, e, i, d, j, i1, i2: Integer;
  ed, r, dx, dx2, f: Double;
begin
  t := AH as Integer;
  ex := t shr 52;
  e := ex - Off;
  t := t and $000FFFFFFFFFFFFF;
  ed := Double(e);
  i := t shr 47;
  d := t and $00007FFFFFFFFFFF;
  j := (t + (SqlMAscBInt[2 * i] shl 33) + SqlMAscBInt[2 * i + 1] * (d sar 16)) shr 42;
  t := t or ($3FF shl 52);
  i1 := j shr 5;
  i2 := j and $1F;
  r := (SqlMAscR1[i1] as Double) * (SqlMAscR2[i2] as Double);
  dx := Fma(r, t as Double, -1);
  dx2 := dx * dx;
  f := dx2 * (((SqlMAscC[0] as Double) + dx * (SqlMAscC[1] as Double)) + dx2 * (((SqlMAscC[2] as Double) +
    dx * (SqlMAscC[3] as Double)) + dx2 * (SqlMAscC[4] as Double)));
  LH := (L2h as Double) * ed + ((SqlMAscL1[2 * i1 + 1] as Double) + (SqlMAscL2[2 * i2 + 1] as Double));
  LL := (L2l as Double) * ed + (SqlMAscL1[2 * i1] as Double) + (SqlMAscL2[2 * i2] as Double) + AL / AH + f;
  LL := LL + dx;
end;

{ SqlMAsinh: glibc's asinh (s_asinh.c, CORE-MATH, Paul Zimmermann and
  Tom Hubrecht), correctly rounded: odd polynomials below 0x1.bp-4,
  log(|x| + sqrt(x^2+1)) above with x^2+1 and its root in two parts. }
function SqlMAsinh(X: Double): Double;
const
  Cl1: array[0..1] of Integer = ($BFC5555555555555, $3FB3333327C57C60);
  Cl2: array[0..3] of Integer = ($BFC5555555555555, $3FB333333332F2FF, $BFA6DB6D9A665159, $3F9F186866D775F0);
  Cl3: array[0..6] of Integer = (
    $BFC5555555555555, $3FB3333333333310, $BFA6DB6DB6DA466C, $3F9F1C71C2EA7BE4,
    $BF96E8B651B09D72, $3F91C309FC0E69C2, $BF8BAB7833C1E000);
var
  ax, x2h, x2l, x3h, sl, c1, c3, c5, x4, eps, lb, ub, ah, al, th, tl, rs, lh, ll, sg: Double;
  u, off: Integer;
begin
  ax := Abs(X);
  u := ax as Integer;
  if u < $3FBB000000000000 then
  begin
    if u < $3E57137449123EF7 then
    begin
      if u = 0 then
        Exit(X);
      Exit(Fma(Integer($BC30000000000000) as Double, X, X));
    end;
    x2h := X * X;
    x2l := Fma(X, X, -x2h);
    x3h := x2h * X;
    if u < $3F93000000000000 then
    begin
      if u < $3F30000000000000 then
      begin
        if u < $3E5A000000000000 then
          sl := x3h * (Cl1[0] as Double)
        else
          sl := x3h * ((Cl1[0] as Double) + x2h * (Cl1[1] as Double));
      end
      else
        sl := x3h * ((Cl2[0] as Double) + x2h * ((Cl2[1] as Double) + x2h * ((Cl2[2] as Double) +
          x2h * (Cl2[3] as Double))));
    end
    else
    begin
      c1 := (Cl3[1] as Double) + x2h * (Cl3[2] as Double);
      c3 := (Cl3[3] as Double) + x2h * (Cl3[4] as Double);
      c5 := (Cl3[5] as Double) + x2h * (Cl3[6] as Double);
      x4 := x2h * x2h;
      sl := x3h * ((Cl3[0] as Double) + x2h * (c1 + x4 * (c3 + x4 * c5)));
    end;
    eps := (Integer($3CA7900000000000) as Double) * x3h;
    lb := X + (sl - eps);
    ub := X + (sl + eps);
    if lb = ub then
      Exit(lb);
    Exit(SqlMAsinhZero(X, x2h, x2l));
  end;
  x2h := 0;
  x2l := 0;
  off := $3FF;
  if u < $4190000000000000 then
  begin
    x2h := X * X;
    x2l := Fma(X, X, -x2h);
    if u < $3FF0000000000000 then
      th := SqlMFastTwoSum(1, x2h, tl)
    else
      th := SqlMFastTwoSum(x2h, 1, tl);
    tl := tl + x2l;
    ah := SqlMSqrt(th);
    rs := 0.5 / th;
    al := (tl - Fma(ah, ah, -th)) * (rs * ah);
    ah := SqlMFastTwoSum(ah, ax, tl);
    al := al + tl;
  end
  else if u < $4330000000000000 then
  begin
    ah := 2 * ax;
    al := 0.5 / ax;
  end
  else
  begin
    if u >= $7FF0000000000000 then
      Exit(X + X);
    off := $3FE;
    ah := ax;
    al := 0;
  end;
  SqlMAsinhLog(ah, al, off, lh, ll);
  sg := SqlMCopySign(1, X);
  lh := lh * sg;
  ll := ll * sg;
  eps := Integer($3C080DF744CE99C7) as Double;
  lb := lh + (ll - eps);
  ub := lh + (ll + eps);
  if lb = ub then
    Exit(lb);
  if ax < 0.25 then
    Exit(SqlMAsinhZero(X, x2h, x2l));
  Result := SqlMAsinhRefine(X, ah, al, (Integer($3FF71547652B82FE) as Double) * Abs(lb));
end;

