          p := PExpr(TK_IN, FStk[b - 4].E, nil);
          PExprAddSelect(p, r.Sel);
          FStk[b - 4].E := p;
        end
        else
        begin
          p := PExpr(TK_IN, FStk[b - 4].E, nil);
          if (p.Left <> nil) and (p.Left.Op = TK_VECTOR) then
          begin
            sel := ExprListToValues(ListLen(p.Left.List), pl);
            if sel <> nil then
            begin
              DoubleLink(sel);
              PExprAddSelect(p, sel);
            end;
          end
          else
          begin
            p.List := pl;
            SetHeightAndFlags(p);
          end;
          FStk[b - 4].E := p;
        end;
        if FStk[b - 3].I <> 0 then
          FStk[b - 4].E := PExpr(TK_NOT, FStk[b - 4].E, nil);
      end;
    224:
      begin
        p := PExpr(TK_SELECT, nil, nil);
        PExprAddSelect(p, FStk[b - 1].S);
        FStk[b - 2].E := p;
      end;
    225:
      begin
        p := PExpr(TK_IN, FStk[b - 4].E, nil);
        PExprAddSelect(p, FStk[b - 1].S);
        if FStk[b - 3].I <> 0 then
          p := PExpr(TK_NOT, p, nil);
        FStk[b - 4].E := p;
      end;
    226:
      begin
        src := SrcAppend(nil, FStk[b - 2].Tok, FStk[b - 1].Tok);
        sel := SelectNew(nil, src, nil, nil, nil, nil, 0, nil);
        if FStk[b].L <> nil then
          SrcFuncArgs(src, FStk[b].L);
        p := PExpr(TK_IN, FStk[b - 4].E, nil);
        PExprAddSelect(p, sel);
        if FStk[b - 3].I <> 0 then
          p := PExpr(TK_NOT, p, nil);
        FStk[b - 4].E := p;
      end;
    227:
      begin
        p := PExpr(TK_EXISTS, nil, nil);
        PExprAddSelect(p, FStk[b - 1].S);
        FStk[b - 3].E := p;
      end;
    228:
      begin
        p := PExpr(TK_CASE, FStk[b - 3].E, nil);
        if FStk[b - 1].E <> nil then
          p.List := ListAppend(FStk[b - 2].L, FStk[b - 1].E)
        else
          p.List := FStk[b - 2].L;
        SetHeightAndFlags(p);
        FStk[b - 4].E := p;
      end;
    229:
      begin
        FStk[b - 4].L := ListAppend(FStk[b - 4].L, FStk[b - 2].E);
        FStk[b - 4].L := ListAppend(FStk[b - 4].L, FStk[b].E);
      end;
    230:
      begin
        pl := ListAppend(nil, FStk[b - 2].E);
        FStk[b - 3].L := ListAppend(pl, FStk[b].E);
      end;
    235: FStk[b - 2].L := ListAppend(FStk[b - 2].L, FStk[b].E);
    236: FStk[b].L := ListAppend(nil, FStk[b].E);
    238, 243: FStk[b - 2].L := FStk[b - 1].L;
    239:
      begin
        { sqlite3CreateIndex: its text from CREATE to the last token }
        src := SrcAppend(nil, FStk[b - 4].Tok, z);
        st := NewStmt(stCreateIndex);
        st.Name1 := FStk[b - 7].Tok;
        st.Name2 := FStk[b - 6].Tok;
        st.Src := src;
        st.ExprCols := FStk[b - 2].L;
        st.OnError := FStk[b - 10].I;
        st.StartTok := FStk[b - 11].Tok;
        st.Where := FStk[b].E;
        st.NoErr := FStk[b - 8].I <> 0;
        st.LastTok := FLast;
      end;
    240, 281: FStk[b].I := OE_Abort;
    241: FStk[b + 1].I := OE_None;
    244: FStk[b - 4].L := AddExprIdListTerm(FStk[b - 4].L, FStk[b - 2].Tok, FStk[b - 1].I, FStk[b].I);
    245: FStk[b - 2].L := AddExprIdListTerm(nil, FStk[b - 2].Tok, FStk[b - 1].I, FStk[b].I);
    248:
      begin
        st := NewStmt(stDropIndex);
        st.Src := FStk[b].Src;
        st.NoErr := FStk[b - 1].I <> 0;
      end;
    249, 250:
      begin
        { sqlite3Vacuum(schema or none, INTO) }
        st := NewStmt(stVacuum);
        if Rule = 250 then
          st.Name1 := FStk[b - 1].Tok;
        st.E1 := FStk[b].E;
      end;
    253, 254, 255, 256, 257:
      begin
        { sqlite3Pragma(name, schema, value, minus) }
        st := NewStmt(stPragma);
        case Rule of
          253:
            begin
              st.Name1 := FStk[b - 1].Tok;
              st.Name2 := FStk[b].Tok;
            end;
          254, 256:
            begin
              st.Name1 := FStk[b - 3].Tok;
              st.Name2 := FStk[b - 2].Tok;
              st.Name3 := FStk[b].Tok;
            end;
        else
          begin
            st.Name1 := FStk[b - 4].Tok;
            st.Name2 := FStk[b - 3].Tok;
            st.Name3 := FStk[b - 1].Tok;
          end;
        end;
        st.Minus := Rule >= 256;
      end;
    260:
      begin
        { sqlite3FinishTrigger(steps, the text from the name to END) }
        t.Z := FStk[b - 3].Tok.Z;
        t.N := FStk[b].Tok.Z - FStk[b - 3].Tok.Z + FStk[b].Tok.N;
        if FStmt <> nil then
        begin
          FStmt.Steps := FStk[b - 1].Step;
          FStmt.EndTok := t;
        end;
      end;
    261:
      begin
        { sqlite3BeginTrigger: the trigger being made from here on, in
          temp when TEMP or temp.name says so (and, with a schema, when its
          table is in temp: P409) }
        st := NewStmt(stCreateTrigger);
        st.Name1 := FStk[b - 7].Tok;
        st.Name2 := FStk[b - 6].Tok;
        st.TrigTime := FStk[b - 5].I;
        st.TrigEvent := FStk[b - 4].I;
        st.TrigCols := FStk[b - 4].Id;
        st.Src := FStk[b - 2].Src;
        st.E1 := FStk[b].E;
        st.Temp := FStk[b - 10].I <> 0;
        st.NoErr := FStk[b - 8].I <> 0;
        FNewTrigger := True;
        FNewTrigTemp := st.Temp or ((FStk[b - 6].Tok.N > 0) and SqlStrIEq(NameOf(FStk[b - 7].Tok), 'temp'));
        if FStk[b - 6].Tok.N = 0 then
          FStk[b - 10].Tok := FStk[b - 7].Tok
        else
          FStk[b - 10].Tok := FStk[b - 6].Tok;
      end;
    262: FStk[b].I := FStk[b].Major;
    263: FStk[b - 1].I := TK_INSTEAD;
    264: FStk[b + 1].I := TK_BEFORE;
    265, 266:
      begin
        FStk[b].I := FStk[b].Major;
        FStk[b].Id := nil;
      end;
    267:
      begin
        FStk[b - 2].I := TK_UPDATE;
        FStk[b - 2].Id := FStk[b].Id;
      end;
    268, 286: FStk[b + 1].E := nil;
    269, 287: FStk[b - 1].E := FStk[b].E;
    270:
      begin
        FStk[b - 2].Step.Last.NextStep := FStk[b - 1].Step;
        FStk[b - 2].Step.Last := FStk[b - 1].Step;
      end;
    271: FStk[b - 1].Step.Last := FStk[b - 1].Step;
    272: Error('the INDEXED BY clause is not allowed on UPDATE or DELETE statements within triggers');
    273: Error('the NOT INDEXED clause is not allowed on UPDATE or DELETE statements within triggers');
    274:
      FStk[b - 8].Step := TriggerUpdateStep(FStk[b - 6].Src, FStk[b - 2].Src, FStk[b - 3].L,
        FStk[b - 1].E, FStk[b - 7].I, FStk[b - 8].Tok.Z, FStk[b].I);
    275:
      FStk[b - 7].Step := TriggerInsertStep(FStk[b - 4].Src, FStk[b - 3].Id, FStk[b - 2].S,
        FStk[b - 6].I, FStk[b - 1].Up, FStk[b - 7].I, FStk[b].I);
    276:
      FStk[b - 5].Step := TriggerDeleteStep(FStk[b - 3].Src, FStk[b - 1].E, FStk[b - 5].Tok.Z, FStk[b].I);
    277: FStk[b - 2].Step := TriggerSelectStep(FStk[b - 1].S, FStk[b - 2].I, FStk[b].I);
    278:
      begin
        p := PExpr(TK_RAISE, nil, nil);
        p.Aff := OE_Ignore;
        FStk[b - 3].E := p;
      end;
    279:
      begin
        p := PExpr(TK_RAISE, FStk[b - 1].E, nil);
        p.Aff := FStk[b - 3].I;
        FStk[b - 5].E := p;
      end;
    280: FStk[b].I := OE_Rollback;
    282: FStk[b].I := OE_Fail;
    283:
      begin
        st := NewStmt(stDropTrigger);
        st.Src := FStk[b].Src;
        st.NoErr := FStk[b - 1].I <> 0;
      end;
    284:
      begin
        st := NewStmt(stAttach);
        st.E1 := FStk[b - 3].E;
        st.E2 := FStk[b - 1].E;
        st.E3 := FStk[b].E;
      end;
    285:
      begin
        st := NewStmt(stDetach);
        st.E1 := FStk[b].E;
      end;
    288: NewStmt(stReindex);
    289:
      begin
        st := NewStmt(stReindex);
        st.Name1 := FStk[b - 1].Tok;
        st.Name2 := FStk[b].Tok;
      end;
    290: NewStmt(stAnalyze);
    291:
      begin
        st := NewStmt(stAnalyze);
        st.Name1 := FStk[b - 1].Tok;
        st.Name2 := FStk[b].Tok;
      end;
    292:
      begin
        st := NewStmt(stAlterRename);
        st.Src := FStk[b - 3].Src;
        st.Name1 := FStk[b].Tok;
      end;
    293:
      begin
        { sqlite3AlterFinishAddColumn: the column's text to the last token }
        FStk[b - 1].Tok.N := FLast.Z - FStk[b - 1].Tok.Z + FLast.N;
        if FStmt <> nil then
          FStmt.EndTok := FStk[b - 1].Tok;
      end;
    294:
      begin
        FConsName := Default(TSqlTok);
        st := NewStmt(stAlterAddColumn);
        st.Src := FStk[b - 4].Src;
        FNewTable := True;
        AddColumn(FStk[b - 1].Tok, FStk[b].Tok);
        FStk[b - 6].Tok := FStk[b - 1].Tok;
      end;
    295:
      begin
        st := NewStmt(stAlterDropColumn);
        st.Src := FStk[b - 3].Src;
        st.Name1 := FStk[b].Tok;
      end;
    296:
      begin
        st := NewStmt(stAlterRenameColumn);
        st.Src := FStk[b - 5].Src;
        st.Name1 := FStk[b - 2].Tok;
        st.Name2 := FStk[b].Tok;
      end;
    297:
      begin
        { sqlite3AlterDropConstraint(constraint name, no column) }
        st := NewStmt(stAlterDropConstraint);
        st.Src := FStk[b - 3].Src;
        st.Name1 := FStk[b].Tok;
      end;
    298:
      begin
        { sqlite3AlterDropConstraint(no name, the column of NOT NULL) }
        st := NewStmt(stAlterDropConstraint);
        st.Src := FStk[b - 6].Src;
        st.Name2 := FStk[b - 3].Tok;
      end;
    299:
      begin
        { sqlite3AlterSetNotNull(column, the NOT token) }
        st := NewStmt(stAlterSetNotNull);
        st.Src := FStk[b - 7].Src;
        st.Name1 := FStk[b - 4].Tok;
        st.Name2 := FStk[b - 2].Tok;
      end;
    300, 301:
      begin
        { sqlite3AlterAddConstraint(the first token, the name, the CHECK
          text inside its parentheses, the expression) }
        st := NewStmt(stAlterAddConstraint);
        if Rule = 300 then
        begin
          st.Src := FStk[b - 8].Src;
          st.Name1 := FStk[b - 6].Tok;
          st.Name2 := FStk[b - 5].Tok;
        end
        else
        begin
          st.Src := FStk[b - 6].Src;
          st.Name1 := FStk[b - 4].Tok;
        end;
        st.Name3.Z := FStk[b - 3].Tok.Z + 1;
        st.Name3.N := FStk[b - 1].Tok.Z - FStk[b - 3].Tok.Z - 1;
        st.E1 := FStk[b - 2].E;
      end;
    302, 303:
      begin
        { sqlite3VtabFinishParse: the last argument }
        if (FArg.Z <> 0) and FNewTable and (FStmt <> nil) then
        begin
          SetLength(FStmt.VArgs, Length(FStmt.VArgs) + 1);
          FStmt.VArgs[High(FStmt.VArgs)] := Txt(FArg);
        end;
        FArg.Z := 0;
        if (Rule = 303) and (FStmt <> nil) then
          FStmt.EndTok := FStk[b].Tok;
      end;
    304:
      begin
        { sqlite3VtabBeginParse: the module's name, the schema's (none
          yet) and the table's as its first arguments }
        StartTable(FStk[b - 3].Tok, FStk[b - 2].Tok, False, False, True, FStk[b - 4].I <> 0);
        SetLength(FStmt.VArgs, 3);
        FStmt.VArgs[0] := NameOf(FStk[b].Tok);
        FStmt.VArgs[1] := '';
        if FStk[b - 2].Tok.N > 0 then
          FStmt.VArgs[2] := NameOf(FStk[b - 2].Tok)
        else
          FStmt.VArgs[2] := NameOf(FStk[b - 3].Tok);
        FStmt.StartTok := FStk[b - 7].Tok;
        FStmt.Name3 := FStk[b].Tok;
      end;
    305:
      begin
        { sqlite3VtabArgInit }
        if (FArg.Z <> 0) and FNewTable and (FStmt <> nil) then
        begin
          SetLength(FStmt.VArgs, Length(FStmt.VArgs) + 1);
          FStmt.VArgs[High(FStmt.VArgs)] := Txt(FArg);
        end;
        FArg.Z := 0;
        FArg.N := 0;
      end;
    306, 307, 308:
      { sqlite3VtabArgExtend }
      if FArg.Z = 0 then
        FArg := FStk[b].Tok
      else
        FArg.N := FStk[b].Tok.Z + FStk[b].Tok.N - FArg.Z;
    309, 310: WithPush(FStk[b].Wi);
    311: FStk[b].I := M10d_Any;
    312: FStk[b - 1].I := M10d_Yes;
    313: FStk[b - 2].I := M10d_No;
    314: FStk[b - 5].Cte := CteNew(FStk[b - 5].Tok, FStk[b - 4].L, FStk[b - 1].S, FStk[b - 3].I);
    315: FHasWith := True;
    316: FStk[b].Wi := WithAdd(nil, FStk[b].Cte);
    317: FStk[b - 2].Wi := WithAdd(FStk[b - 2].Wi, FStk[b].Cte);
    318:
      begin
        WindowChain(FStk[b].W, FStk[b - 2].W);
        FStk[b].W.NextWin := FStk[b - 2].W;
        FStk[b - 2].W := FStk[b].W;
      end;
    319:
      begin
        if FStk[b - 1].W <> nil then
          FStk[b - 1].W.Name := Txt(FStk[b - 4].Tok);
        FStk[b - 4].W := FStk[b - 1].W;
      end;
    320: FStk[b - 4].W := WindowAssemble(FStk[b].W, FStk[b - 2].L, FStk[b - 1].L, z, False);
    321: FStk[b - 5].W := WindowAssemble(FStk[b].W, FStk[b - 2].L, FStk[b - 1].L, FStk[b - 5].Tok, True);
    322: FStk[b - 3].W := WindowAssemble(FStk[b].W, nil, FStk[b - 1].L, z, False);
    323: FStk[b - 4].W := WindowAssemble(FStk[b].W, nil, FStk[b - 1].L, FStk[b - 4].Tok, True);
    324: FStk[b - 1].W := WindowAssemble(FStk[b].W, nil, nil, FStk[b - 1].Tok, True);
    325: FStk[b + 1].W := WindowAlloc(0, TK_UNBOUNDED, nil, TK_CURRENT, nil, 0);
    326:
      FStk[b - 2].W := WindowAlloc(FStk[b - 2].I, FStk[b - 1].I2, FStk[b - 1].E, TK_CURRENT, nil,
        FStk[b].I);
    327:
      FStk[b - 5].W := WindowAlloc(FStk[b - 5].I, FStk[b - 3].I2, FStk[b - 3].E, FStk[b - 1].I2,
        FStk[b - 1].E, FStk[b].I);
    329, 331: ;
    330, 332, 334:
      begin
        FStk[b - 1].I2 := FStk[b - 1].Major;
        FStk[b - 1].E := nil;
      end;
    333: FStk[b - 1].I2 := FStk[b].Major;
    335: FStk[b + 1].I := 0;
    336: FStk[b - 1].I := FStk[b].I;
    337, 338: FStk[b - 1].I := FStk[b - 1].Major;
    339: FStk[b].I := FStk[b].Major;
    340: FStk[b - 1].W := FStk[b].W;
    341:
      begin
        if FStk[b].W <> nil then
          FStk[b].W.Filter := FStk[b - 1].E;
        FStk[b - 1].W := FStk[b].W;
      end;
    342: ;
    343:
      begin
        w := TSqlWindow.Create;
        w.FrmType := TK_FILTER;
        w.Filter := FStk[b].E;
        FStk[b].W := w;
      end;
    344: FStk[b - 3].W := FStk[b - 1].W;
    345:
      begin
        w := TSqlWindow.Create;
        w.Name := Txt(FStk[b].Tok);
        FStk[b - 1].W := w;
      end;
    346: FStk[b - 4].E := FStk[b - 1].E;
    347:
      begin
        p := TokExpr(FStk[b].Major, FStk[b].Tok);
        DequoteNumber(p);
        FStk[b].E := p;
      end;
  end;
end;

{ ---- P404's test entry ---- }

{ Whether the statement's first keyword, after EXPLAIN [QUERY PLAN], is
  one of a statement that prints its tree: SELECT, VALUES, WITH, INSERT,
  REPLACE, UPDATE or DELETE }
function SqlTracedKind(const Sql: string): Boolean;
var
  k, t: Integer;

  { the next token's type, past spaces and comments }
  function NextTok: Integer;
  var
    n, ty: Integer;
  begin
    repeat
      n := SqlGetToken(Sql, k, ty);
      k := k + n;
    until ((ty <> TK_SPACE) and (ty <> TK_COMMENT)) or (n = 0);
    Result := ty;
  end;

begin
  k := 1;
  t := NextTok;
  if t = TK_EXPLAIN then
  begin
    t := NextTok;
    if t = TK_QUERY then
    begin
      t := NextTok;
      if t = TK_PLAN then
        t := NextTok;
    end;
  end;
  Result := (t = TK_SELECT) or (t = TK_VALUES) or (t = TK_WITH) or (t = TK_INSERT) or (t = TK_REPLACE) or
    (t = TK_UPDATE) or (t = TK_DELETE);
end;

function TSqlParser.Trace(const Sql: string; At: Integer; out Tail: Integer): string;
begin
  FTraceOn := True;
  try
    Parse(Sql, At, Tail);
    Result := 'ok';
  except
    on e: ESqliteError do
      Result := 'error: ' + e.Message;
  end;
  if SqlTracedKind(Copy(Sql, At, Length(Sql))) then
    Result := FTrace + Result;
  Result := Result + #10;
end;

{ the trace of the first statement of Sql, then "ok" or "error: " and
  SQLite's words }
function SqliteParseTrace(const Sql: string): string;
var
  p: TSqlParser;
  tail: Integer;
begin
  p := TSqlParser.Create;
  Result := p.Trace(Sql, 1, tail);
end;

end.
