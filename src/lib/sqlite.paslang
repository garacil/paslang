{ SqlMScalbn: Z * 2^N for an N that keeps 2^N a normal double (glibc's
  __scalbn where kernel_rem_pio2 calls it, exact there). }
function SqlMScalbn(Z: Double; N: Integer): Double;
begin
  Result := Z * (((N + 1023) shl 52) as Double);
end;

{ SqlMKernelRemPio2: fdlibm's __kernel_rem_pio2 (glibc k_rem_pio2.c,
  built without FMA) for PREC 2: X[0..NX-1], 24-bit chunks of |x|*2^-E0,
  times 2/pi from TwoOverPi as long as the bits it needs, the quadrant
  in N mod 8 and the remainder in Y0 + Y1. }
function SqlMKernelRemPio2(const X: array of Double; out Y0, Y1: Double; E0, NX: Integer): Integer;
const
  TwoOverPi: array[0..65] of Integer = (
    $A2F983, $6E4E44, $1529FC, $2757D1, $F534DD, $C0DB62,
    $95993C, $439041, $FE5163, $ABDEBB, $C561B7, $246E3A,
    $424DD2, $E00649, $2EEA09, $D1921C, $FE1DEB, $1CB129,
    $A73EE8, $8235F5, $2EBB44, $84E99C, $7026B4, $5F7E41,
    $3991D6, $398353, $39F49C, $845F8B, $BDF928, $3B1FF8,
    $97FFDE, $05980F, $EF2F11, $8B5A0A, $6D1F6D, $367ECF,
    $27CB09, $B74F46, $3F669E, $5FEA2D, $7527BA, $C7EBE5,
    $F17B3D, $0739F7, $8A5292, $EA6BFB, $5FB11F, $8D5D08,
    $560330, $46FC7B, $6BABF0, $CFBC20, $9AF436, $1DA9E3,
    $91615E, $E61B08, $659985, $5F14A0, $68408D, $FFD880,
    $4D7327, $310606, $1556CA, $73A8C9, $60E27B, $C08C6B);
  PIo2: array[0..7] of Integer = (
    $3FF921FB40000000, $3E74442D00000000, $3CF8469880000000, $3B78CC5160000000,
    $39F01B8380000000, $387A252040000000, $36E3822280000000, $3569F31D00000000);
  Two24: Integer = $4170000000000000;
  TwoN24: Integer = $3E70000000000000;
var
  jz, jx, jv, jp, jk, cy, n, i, j, k, m, q0, ih: Integer;
  iq: array[0..19] of Integer;
  f, fq, q: array[0..19] of Double;
  z, fw, fv: Double;
begin
  jk := 4;
  jp := jk;
  jx := NX - 1;
  jv := (E0 - 3) div 24;
  if jv < 0 then
    jv := 0;
  q0 := E0 - 24 * (jv + 1);
  j := jv - jx;
  m := jx + jk;
  for i := 0 to m do
  begin
    if j < 0 then
      f[i] := 0.0
    else
      f[i] := Double(TwoOverPi[j]);
    Inc(j);
  end;
  for i := 0 to jk do
  begin
    fw := 0.0;
    for j := 0 to jx do
      fw := fw + X[j] * f[jx + i - j];
    q[i] := fw;
  end;
  jz := jk;
  while True do
  begin
    i := 0;
    j := jz;
    z := q[jz];
    while j > 0 do
    begin
      fw := Double(Trunc((TwoN24 as Double) * z));
      iq[i] := Trunc(z - (Two24 as Double) * fw);
      z := q[j - 1] + fw;
      Inc(i);
      Dec(j);
    end;
    z := SqlMScalbn(z, q0);
    z := z - 8.0 * SqlMFloor(z * 0.125);
    n := Trunc(z);
    z := z - Double(n);
    ih := 0;
    if q0 > 0 then
    begin
      i := iq[jz - 1] shr (24 - q0);
      n := n + i;
      iq[jz - 1] := iq[jz - 1] - (i shl (24 - q0));
      ih := iq[jz - 1] shr (23 - q0);
    end
    else if q0 = 0 then
      ih := iq[jz - 1] shr 23
    else if z >= 0.5 then
      ih := 2;
    if ih > 0 then
    begin
      n := n + 1;
      cy := 0;
      for i := 0 to jz - 1 do
      begin
        j := iq[i];
        if cy = 0 then
        begin
          if j <> 0 then
          begin
            cy := 1;
            iq[i] := $1000000 - j;
          end;
        end
        else
          iq[i] := $FFFFFF - j;
      end;
      if q0 = 1 then
        iq[jz - 1] := iq[jz - 1] and $7FFFFF
      else if q0 = 2 then
        iq[jz - 1] := iq[jz - 1] and $3FFFFF;
      if ih = 2 then
      begin
        z := 1.0 - z;
        if cy <> 0 then
          z := z - SqlMScalbn(1.0, q0);
      end;
    end;
    if z = 0.0 then
    begin
      j := 0;
      for i := jz - 1 downto jk do
        j := j or iq[i];
      if j = 0 then
      begin
        k := 1;
        while iq[jk - k] = 0 do
          Inc(k);
        for i := jz + 1 to jz + k do
        begin
          f[jx + i] := Double(TwoOverPi[jv + i]);
          fw := 0.0;
          for j := 0 to jx do
            fw := fw + X[j] * f[jx + i - j];
          q[i] := fw;
        end;
        jz := jz + k;
        Continue;
      end;
    end;
    Break;
  end;
  if z = 0.0 then
  begin
    jz := jz - 1;
    q0 := q0 - 24;
    while iq[jz] = 0 do
    begin
      jz := jz - 1;
      q0 := q0 - 24;
    end;
  end
  else
  begin
    z := SqlMScalbn(z, -q0);
    if z >= (Two24 as Double) then
    begin
      fw := Double(Trunc((TwoN24 as Double) * z));
      iq[jz] := Trunc(z - (Two24 as Double) * fw);
      jz := jz + 1;
      q0 := q0 + 24;
      iq[jz] := Trunc(fw);
    end
    else
      iq[jz] := Trunc(z);
  end;
  fw := SqlMScalbn(1.0, q0);
  for i := jz downto 0 do
  begin
    q[i] := fw * Double(iq[i]);
    fw := fw * (TwoN24 as Double);
  end;
  for i := jz downto 0 do
  begin
    fw := 0.0;
    k := 0;
    while (k <= jp) and (k <= jz - i) do
    begin
      fw := fw + (PIo2[k] as Double) * q[i + k];
      Inc(k);
    end;
    fq[jz - i] := fw;
  end;
  fv := 0.0;
  for i := jz downto 0 do
    fv := fv + fq[i];
  if ih = 0 then
    Y0 := fv
  else
    Y0 := -fv;
  fv := fq[0] - fv;
  for i := 1 to jz do
    fv := fv + fq[i];
  if ih = 0 then
    Y1 := fv
  else
    Y1 := -fv;
  Result := n and 7;
end;

{ SqlMRemPio2: glibc's __ieee754_rem_pio2 (dbl-64/e_rem_pio2.c) for
  |x| past 105414350: x = n*pi/2 + Y0 + Y1, |x| cut into three 24-bit
  chunks for SqlMKernelRemPio2. }
function SqlMRemPio2(X: Double; out Y0, Y1: Double): Integer;
const
  Two24: Integer = $4170000000000000;
var
  tx: array[0..2] of Double;
  bx, hx, ix, e0, i, nx, n: Integer;
  z: Double;
begin
  bx := X as Integer;
  hx := bx sar 32;
  ix := hx and $7FFFFFFF;
  e0 := (ix shr 20) - 1046;
  z := (((ix - (e0 shl 20)) shl 32) or (bx and $FFFFFFFF)) as Double;
  for i := 0 to 1 do
  begin
    tx[i] := Double(Trunc(z));
    z := (z - tx[i]) * (Two24 as Double);
  end;
  tx[2] := z;
  nx := 3;
  while tx[nx - 1] = 0.0 do
    Dec(nx);
  n := SqlMKernelRemPio2(tx[0..2], Y0, Y1, e0, nx);
  if hx < 0 then
  begin
    Y0 := -Y0;
    Y1 := -Y1;
    Exit(-n);
  end;
  Result := n;
end;

const
  SqlMSn3: Integer = $BFC5555555555515;
  SqlMSn5: Integer = $3F811110E829872F;
  SqlMCs2: Integer = $3FE0000000000000;
  SqlMCs4: Integer = $BFA5555555555535;
  SqlMCs6: Integer = $3F56C16BEDD9E239;
  SqlMBig: Integer = $42C8000000000000;
  SqlMHp0: Integer = $3FF921FB54442D18;
  SqlMHp1: Integer = $3C91A62633145C07;

{ SqlMDoCos, SqlMDoSin: s_sin.c's do_cos and do_sin, cos and sin of
  X + DX by the table's sin and cos of the nearest multiple of 1/128 and
  short series for the rest, fused as __sin_fma and __cos_fma fuse them;
  below 0.126 do_sin is a Taylor series of degree 11. }
function SqlMDoCos(X, DX: Double): Double;
var
  u, xx, s, c, sn, ssn, cs, ccs, cor: Double;
  k: Integer;
begin
  if X < 0 then
    DX := -DX;
  u := (SqlMBig as Double) + Abs(X);
  X := (Abs(X) - (u - (SqlMBig as Double))) + DX;
  xx := X * X;
  s := Fma(X * xx, Fma(xx, SqlMSn5 as Double, SqlMSn3 as Double), X);
  c := xx * Fma(xx, Fma(xx, SqlMCs6 as Double, SqlMCs4 as Double), SqlMCs2 as Double);
  k := ((u as Integer) and $FFFFFFFF) shl 2;
  sn := SqlMSinCosTab[k] as Double;
  ssn := SqlMSinCosTab[k + 1] as Double;
  cs := SqlMSinCosTab[k + 2] as Double;
  ccs := SqlMSinCosTab[k + 3] as Double;
  cor := Fma(-sn, s, Fma(-cs, c, Fma(-s, ssn, ccs)));
  Result := cs + cor;
end;

function SqlMDoSin(X, DX: Double): Double;
const
  S1: Integer = $BFC5555555555555;
  S2: Integer = $3F81111111110ECE;
  S3: Integer = $BF2A01A019DB08B8;
  S4: Integer = $3EC71DE27B9A7ED9;
  S5: Integer = $BE5ADDFFC2FCDF59;
  P126: Integer = $3FC020C49BA5E354;
var
  xold, u, xx, s, c, sn, ssn, cs, ccs, cor, p: Double;
  k: Integer;
begin
  xold := X;
  if Abs(X) < (P126 as Double) then
  begin
    xx := X * X;
    p := Fma(Fma(Fma(S5 as Double, xx, S4 as Double), xx, S3 as Double), xx, S2 as Double);
    p := Fma(p, xx, S1 as Double);
    Exit(X + Fma(Fma(p, X, -(0.5 * DX)), xx, DX));
  end;
  if X <= 0 then
    DX := -DX;
  u := (SqlMBig as Double) + Abs(X);
  X := Abs(X) - (u - (SqlMBig as Double));
  xx := X * X;
  s := Fma(X * xx, Fma(xx, SqlMSn5 as Double, SqlMSn3 as Double), DX) + X;
  c := Fma(X, DX, xx * Fma(xx, Fma(xx, SqlMCs6 as Double, SqlMCs4 as Double), SqlMCs2 as Double));
  k := ((u as Integer) and $FFFFFFFF) shl 2;
  sn := SqlMSinCosTab[k] as Double;
  ssn := SqlMSinCosTab[k + 1] as Double;
  cs := SqlMSinCosTab[k + 2] as Double;
  ccs := SqlMSinCosTab[k + 3] as Double;
  cor := Fma(cs, s, Fma(-sn, c, Fma(s, ccs, ssn)));
  Result := (((sn + cor) as Integer) and $7FFFFFFFFFFFFFFF or ((xold as Integer) and Integer($8000000000000000))) as Double;
end;

{ SqlMReduceSinCos: s_sin.c's reduce_sincos, x = n*pi/2 + A + DA for
  |x| < 105414350, pi/2 in four parts. }
function SqlMReduceSinCos(X: Double; out A, DA: Double): Integer;
const
  HpInv: Integer = $3FE45F306DC9C883;
  ToInt: Integer = $4338000000000000;
  Mp1: Integer = $3FF921FB58000000;
  Mp2: Integer = $BE4DDE973C000000;
  Pp3: Integer = $BC8CB3B398000000;
  Pp4: Integer = $BACD747F23E32ED7;
var
  t, xn, y, t2, b, db: Double;
begin
  t := Fma(X, HpInv as Double, ToInt as Double);
  xn := t - (ToInt as Double);
  y := Fma(-xn, Mp2 as Double, Fma(-xn, Mp1 as Double, X));
  Result := (t as Integer) and 3;
  t2 := Fma(-xn, Pp3 as Double, y);
  db := Fma(-xn, Pp3 as Double, y - t2);
  b := Fma(-xn, Pp4 as Double, t2);
  db := db + Fma(-xn, Pp4 as Double, t2 - b);
  A := b;
  DA := db;
end;

function SqlMDoSinCos(A, DA: Double; N: Integer): Double;
begin
  if (N and 1) <> 0 then
    Result := SqlMDoCos(A, DA)
  else
    Result := SqlMDoSin(A, DA);
  if (N and 2) <> 0 then
    Result := -Result;
end;

{ SqlMSin, SqlMCos: glibc's sin and cos (s_sin.c, IBM's Accurate
  Mathematical Library) as __sin_fma and __cos_fma compute them. }
function SqlMSin(X: Double): Double;
var
  k, n: Integer;
  a, da: Double;
begin
  k := ((X as Integer) shr 32) and $7FFFFFFF;
  if k < $3E500000 then
    Exit(X);
  if k < $3FEB6000 then
    Exit(SqlMDoSin(X, 0.0));
  if k < $400368FD then
  begin
    a := SqlMDoCos((SqlMHp0 as Double) - Abs(X), SqlMHp1 as Double);
    Exit(((a as Integer) and $7FFFFFFFFFFFFFFF or ((X as Integer) and Integer($8000000000000000))) as Double);
  end;
  if k < $419921FB then
  begin
    n := SqlMReduceSinCos(X, a, da);
    Exit(SqlMDoSinCos(a, da, n));
  end;
  if k < $7FF00000 then
  begin
    n := SqlMRemPio2(X, a, da);
    Exit(SqlMDoSinCos(a, da, n));
  end;
  Result := SqlMInvalid(X);
end;

function SqlMCos(X: Double): Double;
var
  k, n: Integer;
  a, da, y: Double;
begin
  k := ((X as Integer) shr 32) and $7FFFFFFF;
  if k < $3E400000 then
    Exit(1.0);
  if k < $3FEB6000 then
    Exit(SqlMDoCos(X, 0.0));
  if k < $400368FD then
  begin
    y := (SqlMHp0 as Double) - Abs(X);
    a := y + (SqlMHp1 as Double);
    da := (y - a) + (SqlMHp1 as Double);
    Exit(SqlMDoSin(a, da));
  end;
  if k < $419921FB then
  begin
    n := SqlMReduceSinCos(X, a, da);
    Exit(SqlMDoSinCos(a, da, n + 1));
  end;
  if k < $7FF00000 then
  begin
    n := SqlMRemPio2(X, a, da);
    Exit(SqlMDoSinCos(a, da, n + 1));
  end;
  Result := SqlMInvalid(X);
end;

