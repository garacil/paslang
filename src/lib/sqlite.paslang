  SQLITE_STMTSTATUS_FULLSCAN_STEP = 1;
  SQLITE_STMTSTATUS_SORT = 2;
  SQLITE_STMTSTATUS_AUTOINDEX = 3;
  SQLITE_STMTSTATUS_VM_STEP = 4;
  SQLITE_STMTSTATUS_REPREPARE = 5;
  SQLITE_STMTSTATUS_RUN = 6;
  SQLITE_STMTSTATUS_FILTER_MISS = 7;
  SQLITE_STMTSTATUS_FILTER_HIT = 8;
  SQLITE_STMTSTATUS_MEMUSED = 99;
  SQLITE_CHECKPOINT_NOOP = -1;
  SQLITE_CHECKPOINT_PASSIVE = 0;
  SQLITE_CHECKPOINT_FULL = 1;
  SQLITE_CHECKPOINT_RESTART = 2;
  SQLITE_CHECKPOINT_TRUNCATE = 3;
  SQLITE_VTAB_CONSTRAINT_SUPPORT = 1;
  SQLITE_VTAB_INNOCUOUS = 2;
  SQLITE_VTAB_DIRECTONLY = 3;
  SQLITE_VTAB_USES_ALL_SCHEMAS = 4;
  SQLITE_ROLLBACK = 1;
  SQLITE_FAIL = 3;
  SQLITE_REPLACE = 5;
  SQLITE_SCANSTAT_NLOOP = 0;
  SQLITE_SCANSTAT_NVISIT = 1;
  SQLITE_SCANSTAT_EST = 2;
  SQLITE_SCANSTAT_NAME = 3;
  SQLITE_SCANSTAT_EXPLAIN = 4;
  SQLITE_SCANSTAT_SELECTID = 5;
  SQLITE_SCANSTAT_PARENTID = 6;
  SQLITE_SCANSTAT_NCYCLE = 7;
  SQLITE_SCANSTAT_COMPLEX = 1;
  SQLITE_SERIALIZE_NOCOPY = 1;
  SQLITE_DESERIALIZE_FREEONCLOSE = 1;
  SQLITE_DESERIALIZE_RESIZEABLE = 2;
  SQLITE_DESERIALIZE_READONLY = 4;
  SQLITE_CARRAY_INT32 = 0;
  SQLITE_CARRAY_INT64 = 1;
  SQLITE_CARRAY_DOUBLE = 2;
  SQLITE_CARRAY_TEXT = 3;
  SQLITE_CARRAY_BLOB = 4;
  SQLITE_WASI = 1;
  SQLITE_THREADSAFE = 0;
  SQLITE_SESSION_OBJCONFIG_SIZE = 1;
  SQLITE_SESSION_OBJCONFIG_ROWID = 2;
  SQLITE_CHANGESETSTART_INVERT = 2;
  SQLITE_CHANGESETAPPLY_NOSAVEPOINT = 1;
  SQLITE_CHANGESETAPPLY_INVERT = 2;
  SQLITE_CHANGESETAPPLY_IGNORENOOP = 4;
  SQLITE_CHANGESETAPPLY_FKNOACTION = 8;
  SQLITE_CHANGESETAPPLY_NOUPDATELOOP = 16;
  SQLITE_CHANGESET_DATA = 1;
  SQLITE_CHANGESET_NOTFOUND = 2;
  SQLITE_CHANGESET_CONFLICT = 3;
  SQLITE_CHANGESET_CONSTRAINT = 4;
  SQLITE_CHANGESET_FOREIGN_KEY = 5;
  SQLITE_CHANGESET_OMIT = 0;
  SQLITE_CHANGESET_REPLACE = 1;
  SQLITE_CHANGESET_ABORT = 2;
  SQLITE_SESSION_CONFIG_STRMSIZE = 1;
  SQLITE_CHANGEGROUP_CONFIG_PATCHSET = 1;

type
  { An error of SQLite's: its extended result code, its primary code
    (the low byte, sqlite3_errcode's) and the message sqlite3_errmsg
    would give. Like every raised object, it belongs to the routine
    that raised it. }
  ESqliteError = class(TObject)
  private
    FExtended: Integer;
    FMessage: string;
  public
    constructor Create(AExtended: Integer; const AMessage: string);
    function ToString: string; override;
    function Code: Integer;
    property ExtendedCode: Integer read FExtended;
    property Message: string read FMessage;
  end;

  { A value as SQLite keeps it: Kind is SQLITE_INTEGER (I), SQLITE_FLOAT
    (R), SQLITE_TEXT (S, UTF-8), SQLITE_BLOB (S, its bytes) or
    SQLITE_NULL. }
  TSqliteValue = record
    Kind: Integer;
    I: Int64;
    R: Double;
    S: string;
  end;
  TSqliteValues = array of TSqliteValue;

  { A row of sqlite_schema: 'table', 'index', 'view' or 'trigger', its
    name, its table's, its root page (0 for a view or a trigger) and the
    SQL that made it (empty for an index a constraint made). }
  TSqliteObject = record
    Kind, Name, TblName: string;
    RootPage: Int64;
    Sql: string;
  end;
  TSqliteObjects = array of TSqliteObject;


  { sqlite3_value's storage, SQLite's Mem (vdbeInt.h): Flags the MEM_
    bits, I the integer, R the real, Z the bytes of a text or a blob,
    Enc a text's encoding, Subtype sqlite3_value_subtype's, Obj an
    aggregate's state or a pointer value. A program reads a value
    through the sqlite3_value_* routines, not through these fields. }
  TSqlMem = record
    Flags: Integer;
    I: Integer;
    R: Double;
    Z: string;
    Enc: Integer;
    Subtype: Integer;
    Obj: TObject;
  end;

  { The objects of SQLite's C interface, each a class whose fields
    belong to the unit: sqlite3 (a connection), sqlite3_stmt (a
    prepared statement), sqlite3_context (a function's call),
    sqlite3_value (a value), sqlite3_backup, sqlite3_blob. }
  TSqlite3 = class
  private
    { db->nFpDigit: the digits of a real made text }
    NFpDigit: Integer;
  end;
  TSqlite3Stmt = class
  end;
  TSqlite3Context = class
  end;
  TSqlite3Value = class
  private
    M: TSqlMem;
    { pMem->db: the connection whose statement holds the value, nil for
      none (a value of its own, as sqlite3_value_dup makes) }
    Db: TSqlite3;
  end;
  TSqlite3ValueArray = array of TSqlite3Value;
  TSqlite3StrArray = array of string;
  TSqlite3BoolArray = array of Boolean;
  TSqlite3Backup = class
  end;
  TSqlite3Blob = class
  end;

  { sqlite3_create_function's xFunc and xStep, and a window function's
    xInverse: the call's context and its Argc arguments }
  TSqlite3Func = procedure(Ctx: TSqlite3Context; Argc: Integer; const Argv: array of TSqlite3Value);
  { an aggregate's xFinal and a window function's xValue }
  TSqlite3FinalFunc = procedure(Ctx: TSqlite3Context);
  { the destructor of an application's object SQLite holds (xDestroy) }
  TSqlite3Destroy = procedure(P: TObject);
  { sqlite3_exec's callback: the row (none when HasRow is False: a
    statement without rows under SQLITE_NullCallback), each value with
    HasVal False for NULL, the columns' names; not 0 stops the
    statement with SQLITE_ABORT }
  TSqlite3ExecCallback = function(Arg: TObject; NCol: Integer; HasRow: Boolean; const Vals: array of string;
    const HasVal: array of Boolean; const Cols: array of string): Integer;
  { a collation's comparison of two texts in its encoding: below 0, 0
    or above 0 }
  TSqlite3Compare = function(Arg: TObject; const A, B: string): Integer;
  { sqlite3_collation_needed's callback: the name UTF-8, or UTF-16 in
    the machine's order for sqlite3_collation_needed16 }
  TSqlite3CollNeeded = procedure(Arg: TObject; Db: TSqlite3; Enc: Integer; const Name: string);
  { sqlite3_busy_handler's callback: not 0 to try again }
  TSqlite3BusyHandler = function(Arg: TObject; Count: Integer): Integer;
  { sqlite3_progress_handler's and sqlite3_commit_hook's callback: not 0
    to interrupt the statement, or to turn the commit into a rollback }
  TSqlite3Progress = function(Arg: TObject): Integer;
  { sqlite3_rollback_hook's callback }
  TSqlite3Hook = procedure(Arg: TObject);
  { sqlite3_update_hook's callback: SQLITE_INSERT, SQLITE_DELETE or
    SQLITE_UPDATE of the row Rowid of table ZTab in database ZDb }
  TSqlite3UpdateHook = procedure(Arg: TObject; Op: Integer; const ZDb, ZTab: string; Rowid: Integer);
  { sqlite3_wal_hook's callback: the frames in the log of database ZDb }
  TSqlite3WalHook = function(Arg: TObject; Db: TSqlite3; const ZDb: string; NEntry: Integer): Integer;
  { an authorizer's four strings: Z[k] when Has[k], NULL when not }
  TSqlite3AuthArgs = record
    Z: array[0..3] of string;
    Has: array[0..3] of Boolean;
  end;
  { sqlite3_set_authorizer's callback: SQLITE_OK, SQLITE_DENY or
    SQLITE_IGNORE for the action Code }
  TSqlite3Authorizer = function(Arg: TObject; Code: Integer; const A: TSqlite3AuthArgs): Integer;
  { sqlite3_autovacuum_pages' callback: how many of NFree pages to free }
  TSqlite3AutovacPages = function(Arg: TObject; const Schema: string; NOrig, NFree, PageSize: Integer): Integer;
  { SQLITE_CONFIG_LOG's callback (sqlite3_config_log) }
  TSqlite3Log = procedure(Arg: TObject; Code: Integer; const Msg: string);
  { sqlite3_trace_v2's callback: event T (SQLITE_TRACE_*), P the
    statement (a TSqlite3Stmt; the connection, a TSqlite3, for
    SQLITE_TRACE_CLOSE), X the statement's text (SQLITE_TRACE_STMT),
    Nanos the nanoseconds it ran (SQLITE_TRACE_PROFILE) }
  TSqlite3TraceV2 = function(T: Integer; Arg: TObject; P: TObject; const X: string; Nanos: Integer): Integer;
  { sqlite3_trace's: the statement with its parameters' values }
  TSqlite3TraceLegacy = procedure(Arg: TObject; const Z: string);
  { sqlite3_profile's: the statement's text and the nanoseconds it ran }
  TSqlite3Profile = procedure(Arg: TObject; const ZSql: string; Nanos: Integer);

  { The virtual table interface (sqlite3.h): a module's table and cursor
    are its own classes derived from TSqlite3Vtab and TSqlite3VtabCursor;
    every routine of TSqlite3Module that the module has not is nil. }
  TSqlite3Vtab = class;
  TSqlite3VtabCursor = class;
  TSqlite3IndexInfo = class;
  { a message a module leaves for SQLite: Has tells an empty one from
    none }
  TSqlite3ErrOut = record
    Msg: string;
    Has: Boolean;
  end;
  { xCreate and xConnect: Argv the module's name, the schema's, the
    table's, then CREATE VIRTUAL TABLE's arguments }
  TSqlite3VtabCreate = function(Db: TSqlite3; Aux: TObject; const Argv: TSqlite3StrArray; out Vtab: TSqlite3Vtab;
    var Err: TSqlite3ErrOut): Integer;
  TSqlite3VtabBestIndex = function(Vtab: TSqlite3Vtab; Info: TSqlite3IndexInfo): Integer;
  { xDisconnect, xDestroy, xBegin, xSync, xCommit and xRollback }
  TSqlite3VtabOp = function(Vtab: TSqlite3Vtab): Integer;
  TSqlite3VtabOpen = function(Vtab: TSqlite3Vtab; out Cur: TSqlite3VtabCursor): Integer;
  { xClose, xNext and xEof }
  TSqlite3VtabCursorOp = function(Cur: TSqlite3VtabCursor): Integer;
  { xFilter: IdxStr as xBestIndex left it, HasIdxStr False for NULL }
  TSqlite3VtabFilter = function(Cur: TSqlite3VtabCursor; IdxNum: Integer; const IdxStr: string; HasIdxStr: Boolean;
    const Argv: TSqlite3ValueArray): Integer;
  TSqlite3VtabColumn = function(Cur: TSqlite3VtabCursor; Ctx: TSqlite3Context; I: Integer): Integer;
  TSqlite3VtabRowid = function(Cur: TSqlite3VtabCursor; out Rowid: Integer): Integer;
  TSqlite3VtabUpdate = function(Vtab: TSqlite3Vtab; const Argv: TSqlite3ValueArray; var Rowid: Integer): Integer;
  TSqlite3VtabFindFunction = function(Vtab: TSqlite3Vtab; NArg: Integer; const Name: string;
    out XFunc: TSqlite3Func; out Arg: TObject): Integer;
  TSqlite3VtabRename = function(Vtab: TSqlite3Vtab; const NewName: string): Integer;
  { xSavepoint, xRelease and xRollbackTo }
  TSqlite3VtabSavepoint = function(Vtab: TSqlite3Vtab; N: Integer): Integer;
  TSqlite3VtabShadowName = function(const Name: string): Boolean;
  TSqlite3VtabIntegrity = function(Vtab: TSqlite3Vtab; const Schema, TabName: string; MFlags: Integer;
    var Err: TSqlite3ErrOut): Integer;
  { sqlite3_create_module_v2's xDestroy of the module's Aux }
  TSqlite3ModuleDestroy = procedure(Aux: TObject);

  { sqlite3_module }
  TSqlite3Module = class
    IVersion: Integer;
    XCreate, XConnect: TSqlite3VtabCreate;
    XBestIndex: TSqlite3VtabBestIndex;
    XDisconnect, XDestroy: TSqlite3VtabOp;
    XOpen: TSqlite3VtabOpen;
    XClose: TSqlite3VtabCursorOp;
    XFilter: TSqlite3VtabFilter;
    XNext, XEof: TSqlite3VtabCursorOp;
    XColumn: TSqlite3VtabColumn;
    XRowid: TSqlite3VtabRowid;
    XUpdate: TSqlite3VtabUpdate;
    XBegin, XSync, XCommit, XRollback: TSqlite3VtabOp;
    XFindFunction: TSqlite3VtabFindFunction;
    XRename: TSqlite3VtabRename;
    XSavepoint, XRelease, XRollbackTo: TSqlite3VtabSavepoint;
    XShadowName: TSqlite3VtabShadowName;
    XIntegrity: TSqlite3VtabIntegrity;
  end;

  { sqlite3_vtab: NRef its open cursors, ErrMsg a message for SQLite }
  TSqlite3Vtab = class
    Module: TSqlite3Module;
    NRef: Integer;
    ErrMsg: string;
    HasErrMsg: Boolean;
  end;

  { sqlite3_vtab_cursor }
  TSqlite3VtabCursor = class
    Vtab: TSqlite3Vtab;
  end;

  { sqlite3_index_constraint, sqlite3_index_orderby and
    sqlite3_index_constraint_usage }
  TSqlite3IndexConstraint = record
    IColumn: Integer;
    Op: Integer;
    Usable: Boolean;
    ITermOffset: Integer;
  end;

  TSqlite3IndexOrderBy = record
    IColumn: Integer;
    Desc: Boolean;
  end;

  TSqlite3IndexConstraintUsage = record
    ArgvIndex: Integer;
    Omit: Boolean;
  end;

  { sqlite3_index_info: the constraints and the order SQLite asks
    about, and what xBestIndex answers }
  TSqlite3IndexInfo = class
    NConstraint: Integer;
    AConstraint: array of TSqlite3IndexConstraint;
    NOrderBy: Integer;
    AOrderBy: array of TSqlite3IndexOrderBy;
    AConstraintUsage: array of TSqlite3IndexConstraintUsage;
    IdxNum: Integer;
    IdxStr: string;
    HasIdxStr: Boolean;
    NeedToFreeIdxStr: Boolean;
    OrderByConsumed: Boolean;
    EstimatedCost: Double;
    EstimatedRows: Integer;
    IdxFlags: Integer;
    ColUsed: Integer;
  end;

  TSqlite = class;

  { The rows of a table in rowid order or the keys of an index in key
    order, each a record's values as the file keeps them (RowsAt); or
    the rows of a query, each its columns' values (Query). The read
    lasts until the last row or Finish. }
  TSqliteRows = class
  private
    FDb: TSqlite;
    FStmt: TSqlite3Stmt;
    FCur, FBt: TObject;
    FVals: TSqliteValues;
    FRowId: Int64;
    FStarted, FOpen, FIndex, FQuery, FOwnTxn: Boolean;
  public
    function Next: Boolean;
    procedure Finish;
    function RowId: Int64;
    function ColumnCount: Integer;
    function Column(I: Integer): TSqliteValue;
    function Values: TSqliteValues;
    { the rows are an index b-tree's keys: an index's or a WITHOUT ROWID
      table's, with no rowid }
    function IsIndex: Boolean;
    { a query's column names }
    function ColumnName(I: Integer): string;
  end;

  { A connection to a database file, or to one in memory (':memory:',
    or SQLITE_OPEN_MEMORY): sqlite3_open_v2's flags, READWRITE and
    CREATE when none are given. Every error raises ESqliteError. }
  TSqlite = class
  private
    FDb: TSqlite3;
    FPath: string;
    FFlags: Integer;
    procedure Check(Rc: Integer);
    { ESqliteError SQLITE_MISUSE when the connection was closed (Disconnect) }
    procedure Live;
    function Pragma(const Name: string): TSqliteValue;
  public
    constructor Open(const APath: string); overload;
    constructor Open(const APath: string; Flags: Integer); overload;
    destructor Destroy; override;
    procedure Disconnect;
    { every statement of Sql, run to its end }
    procedure Exec(const Sql: string); overload;
    { one statement with its parameters bound in order (?, ?NNN, :name,
      @name, $name): an Integer, a Boolean (0 or 1), a real, a string
      (text), nil (NULL); the rows it changed }
    function Exec(const Sql: string; const Args: array of const): Integer; overload;
    { the rows of a query, with its parameters as Exec binds them }
    function Query(const Sql: string): TSqliteRows; overload;
    function Query(const Sql: string; const Args: array of const): TSqliteRows; overload;
    { the first column of the first row of a query, NULL when no row }
    function QueryValue(const Sql: string; const Args: array of const): TSqliteValue;
    function LastInsertRowId: Int64;
    function Changes: Int64;
    function Schema: TSqliteObjects;
    function Rows(const Name: string): TSqliteRows;
    function RowsAt(RootPage: Integer): TSqliteRows;
    function PageSize: Integer;
    function PageCount: Integer;
    function Encoding: Integer;
    function UserVersion: Integer;
    function SchemaCookie: Integer;
    { the connection for the sqlite3_* routines }
    property Handle: TSqlite3 read FDb;
    property Path: string read FPath;
  end;

{ sqlite3_errstr: the English of a result code. }
function SqliteErrStr(Code: Integer): string;
{ A record's values (fileformat2.html 2.1), its text in Encoding. }
function SqliteRecord(const Rec: string; Encoding: Integer): TSqliteValues;
{ The value as the CLI's quote() writes it for an integer, a text, a
  blob and NULL; a real as the hexadecimal of its 64 bits. }
function SqliteQuote(const V: TSqliteValue): string;

{ P404: the first statement of Sql parsed as SQLite parses it: the trees
  SQLite's debug build traces for it (treeview.c, .treetrace 0x10000)
  when it begins with SELECT, VALUES, WITH, INSERT, REPLACE, UPDATE or
  DELETE, then "ok", or "error: " and SQLite's words. }
function SqliteParseTrace(const Sql: string): string;

{ ---- the C interface (sqlite3.h) ---- }

function sqlite3_libversion: string;
function sqlite3_sourceid: string;
function sqlite3_libversion_number: Integer;
function sqlite3_threadsafe: Integer;
function sqlite3_initialize: Integer;
function sqlite3_shutdown: Integer;
function sqlite3_errstr(Rc: Integer): string;
function sqlite3_compileoption_used(const OptName: string): Integer;
function sqlite3_compileoption_get(N: Integer): string;
procedure sqlite3_config_log(XLog: TSqlite3Log; Arg: TObject);
procedure sqlite3_log(ErrCode: Integer; const Msg: string);
function sqlite3_enable_shared_cache(Enable: Integer): Integer;
function sqlite3_soft_heap_limit64(N: Int64): Int64;
function sqlite3_hard_heap_limit64(N: Int64): Int64;
{ this build keeps no count of its memory (the collector's heap is the
  program's): 0, as SQLITE_DEFAULT_MEMSTATUS=0 gives }
function sqlite3_memory_used: Int64;
function sqlite3_memory_highwater(ResetFlag: Integer): Int64;
function sqlite3_release_memory(N: Integer): Integer;
{ sqlite3_randomness: N bytes of SQLite's generator }
function sqlite3_randomness(N: Integer): string;
function sqlite3_mprintf(const Fmt: string; const Args: array of const): string;
function sqlite3_open(const Filename: string; out Db: TSqlite3): Integer;
{ Vfs '' is the default VFS (NULL) }
function sqlite3_open_v2(const Filename: string; out Db: TSqlite3; Flags: Integer; const Vfs: string): Integer;
{ sqlite3_open16: the file's name UTF-16 in the machine's order; the
  database made UTF-16 in that order when it is new }
function sqlite3_open16(const Filename16: string; out Db: TSqlite3): Integer;
function sqlite3_close(Db: TSqlite3): Integer;
function sqlite3_close_v2(Db: TSqlite3): Integer;
function sqlite3_errmsg(Db: TSqlite3): string;
{ sqlite3_errmsg16: the message UTF-16 in the machine's order }
function sqlite3_errmsg16(Db: TSqlite3): string;
function sqlite3_errcode(Db: TSqlite3): Integer;
function sqlite3_extended_errcode(Db: TSqlite3): Integer;
function sqlite3_extended_result_codes(Db: TSqlite3; OnOff: Integer): Integer;
function sqlite3_error_offset(Db: TSqlite3): Integer;
function sqlite3_system_errno(Db: TSqlite3): Integer;
{ sqlite3_exec (legacy.c): Callback nil for none; ErrMsg the message,
  '' when none }
function sqlite3_exec(Db: TSqlite3; const Sql: string; Callback: TSqlite3ExecCallback; Arg: TObject;
  out ErrMsg: string): Integer;
function sqlite3_changes(Db: TSqlite3): Integer;
function sqlite3_changes64(Db: TSqlite3): Int64;
function sqlite3_total_changes(Db: TSqlite3): Integer;
function sqlite3_total_changes64(Db: TSqlite3): Int64;
function sqlite3_last_insert_rowid(Db: TSqlite3): Int64;
procedure sqlite3_set_last_insert_rowid(Db: TSqlite3; Rowid: Int64);
function sqlite3_busy_timeout(Db: TSqlite3; Ms: Integer): Integer;
function sqlite3_busy_handler(Db: TSqlite3; XBusy: TSqlite3BusyHandler; Arg: TObject): Integer;
procedure sqlite3_progress_handler(Db: TSqlite3; NOps: Integer; XProgress: TSqlite3Progress; Arg: TObject);
{ sqlite3_interrupt: from any routine, without the mutex, as in C }
procedure sqlite3_interrupt(Db: TSqlite3);
function sqlite3_is_interrupted(Db: TSqlite3): Integer;
function sqlite3_get_autocommit(Db: TSqlite3): Integer;
{ sqlite3_txn_state: Schema '' asks about every database (NULL) }
function sqlite3_txn_state(Db: TSqlite3; const Schema: string): Integer;
{ the hooks: each gives the argument of the hook it replaces }
function sqlite3_commit_hook(Db: TSqlite3; XCallback: TSqlite3Progress; Arg: TObject): TObject;
function sqlite3_rollback_hook(Db: TSqlite3; XCallback: TSqlite3Hook; Arg: TObject): TObject;
function sqlite3_update_hook(Db: TSqlite3; XCallback: TSqlite3UpdateHook; Arg: TObject): TObject;
function sqlite3_wal_hook(Db: TSqlite3; XCallback: TSqlite3WalHook; Arg: TObject): TObject;
function sqlite3_wal_autocheckpoint(Db: TSqlite3; N: Integer): Integer;
{ sqlite3_set_authorizer (auth.c): XAuth nil for none; the prepared
  statements made under another authorizer are prepared again }
function sqlite3_set_authorizer(Db: TSqlite3; XAuth: TSqlite3Authorizer; Arg: TObject): Integer;
function sqlite3_autovacuum_pages(Db: TSqlite3; XCallback: TSqlite3AutovacPages; Arg: TObject;
  XDestructor: TSqlite3Destroy): Integer;
function sqlite3_limit(Db: TSqlite3; Id, NewVal: Integer): Integer;
{ the file of database DbName ('' for a temporary or in-memory one) }
function sqlite3_db_filename(Db: TSqlite3; const DbName: string): string;
{ 1 read-only, 0 not, -1 no such database }
function sqlite3_db_readonly(Db: TSqlite3; const DbName: string): Integer;
{ the schema name of database N, '' past the last }
function sqlite3_db_name(Db: TSqlite3; N: Integer): string;
function sqlite3_db_release_memory(Db: TSqlite3): Integer;
{ sqlite3_file_control: Arg the operation's argument (nil when none) }
function sqlite3_file_control(Db: TSqlite3; const DbName: string; Op: Integer; Arg: Pointer): Integer;
{ sqlite3_create_function_v2: XFunc for a scalar function, XStep and
  XFinal for an aggregate, all nil to delete the function; XDestroy
  lets go of App when the function goes }
function sqlite3_create_function_v2(Db: TSqlite3; const Name: string; NArg, ETextRep: Integer; App: TObject;
  XFunc, XStep: TSqlite3Func; XFinal: TSqlite3FinalFunc; XDestroy: TSqlite3Destroy): Integer;
function sqlite3_create_function(Db: TSqlite3; const Name: string; NArg, ETextRep: Integer; App: TObject;
  XFunc, XStep: TSqlite3Func; XFinal: TSqlite3FinalFunc): Integer;
{ sqlite3_create_function16: the name UTF-16 in the machine's order }
function sqlite3_create_function16(Db: TSqlite3; const Name16: string; NArg, ETextRep: Integer; App: TObject;
  XFunc, XStep: TSqlite3Func; XFinal: TSqlite3FinalFunc): Integer;
function sqlite3_create_window_function(Db: TSqlite3; const Name: string; NArg, ETextRep: Integer; App: TObject;
  XStep: TSqlite3Func; XFinal, XValue: TSqlite3FinalFunc; XInverse: TSqlite3Func;
  XDestroy: TSqlite3Destroy): Integer;
function sqlite3_overload_function(Db: TSqlite3; const Name: string; NArg: Integer): Integer;
function sqlite3_create_collation_v2(Db: TSqlite3; const Name: string; ETextRep: Integer; Arg: TObject;
  XCompare: TSqlite3Compare; XDestroy: TSqlite3Destroy): Integer;
function sqlite3_create_collation(Db: TSqlite3; const Name: string; ETextRep: Integer; Arg: TObject;
  XCompare: TSqlite3Compare): Integer;
function sqlite3_create_collation16(Db: TSqlite3; const Name16: string; ETextRep: Integer; Arg: TObject;
  XCompare: TSqlite3Compare): Integer;
function sqlite3_collation_needed(Db: TSqlite3; Arg: TObject; X: TSqlite3CollNeeded): Integer;
function sqlite3_collation_needed16(Db: TSqlite3; Arg: TObject; X: TSqlite3CollNeeded): Integer;
{ sqlite3_prepare_v2: the first statement of Sql; Tail the text after
  it; Stmt nil for an empty statement or a comment. The engine counts
  Sql's bytes from 1, and gives the tail's first byte. }
function sqlite3_prepare_v2(Db: TSqlite3; const Sql: string; out Stmt: TSqlite3Stmt; out Tail: string): Integer;
  overload;
