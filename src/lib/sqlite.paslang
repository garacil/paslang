    @SqlFnCountInverse);
  SqlAddFunc('group_concat', 1, 0, 0, @SqlFnGroupConcatStep, @SqlFnGroupConcatFinal, @SqlFnGroupConcatValue,
    @SqlFnGroupConcatInverse);
