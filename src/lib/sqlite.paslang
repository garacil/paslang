  SqlMHpi1: Integer = $3C91A62633145C07;

{ SqlMAtanPoly: atnat.h's polynomial I of degree 13 at V = x^2 (the
  last product left for the caller to fuse). }
function SqlMAtanPoly(V: Double): Double;
begin
  Result := Fma(V, SqlMAtD13 as Double, SqlMAtD11 as Double);
  Result := Fma(V, Result, SqlMAtD9 as Double);
  Result := Fma(V, Result, SqlMAtD7 as Double);
  Result := Fma(V, Result, SqlMAtD5 as Double);
  Result := Fma(V, Result, SqlMAtD3 as Double);
end;

{ SqlMCopySign: Y with X's sign. }
function SqlMCopySign(Y, X: Double): Double;
begin
  Result := (((Y as Integer) and $7FFFFFFFFFFFFFFF) or ((X as Integer) and Integer($8000000000000000))) as Double;
end;

{ SqlMAtan: glibc's atan (s_atan.c, IBM's Accurate Mathematical Library)
  as __atan_fma computes it: a Taylor polynomial below 1/16, the table
  cij of 241 points with a polynomial of degree 5 up to 1 and for 1/u up
  to 16, pi/2 - atan(1/u) with a polynomial beyond. }
function SqlMAtan(X: Double): Double;
const
  A: Integer = $3E4BB67A00000000;
  B: Integer = $3FB0000000000000;
  C: Integer = $3FF0000000000000;
  D: Integer = $4030000000000000;
  E: Integer = $43349FF200000000;
  T52: Integer = $4330000000000000;
var
  bx, i: Integer;
  u, v, yy, z, w, t1, t2, ww, t3, cor: Double;
begin
  bx := X as Integer;
  if (bx and $7FFFFFFFFFFFFFFF) > $7FF0000000000000 then
    Exit(X + X);
  if X < 0 then
    u := -X
  else
    u := X;
  if u < (C as Double) then
  begin
    if u < (B as Double) then
    begin
      if u < (A as Double) then
        Exit(X);
      v := X * X;
      Exit(Fma(SqlMAtanPoly(v), X * v, X));
    end;
    i := Trunc(Fma(256, u, T52 as Double) - (T52 as Double)) - 16;
    z := u - (SqlMAtanCij[7 * i] as Double);
    yy := Fma(z, SqlMAtanCij[7 * i + 6] as Double, SqlMAtanCij[7 * i + 5] as Double);
    yy := Fma(z, yy, SqlMAtanCij[7 * i + 4] as Double);
    yy := Fma(z, yy, SqlMAtanCij[7 * i + 3] as Double);
    yy := Fma(z, yy, SqlMAtanCij[7 * i + 2] as Double);
    Exit(SqlMCopySign(Fma(yy, z, SqlMAtanCij[7 * i + 1] as Double), X));
  end;
  if u < (D as Double) then
  begin
    w := 1 / u;
    t1 := w * u;
    t2 := Fma(w, u, -t1);
    i := Trunc(Fma(256, w, T52 as Double) - (T52 as Double)) - 16;
    z := Fma(w, (1 - t1) - t2, w - (SqlMAtanCij[7 * i] as Double));
    yy := Fma(z, SqlMAtanCij[7 * i + 6] as Double, SqlMAtanCij[7 * i + 5] as Double);
    yy := Fma(z, yy, SqlMAtanCij[7 * i + 4] as Double);
    yy := Fma(z, yy, SqlMAtanCij[7 * i + 3] as Double);
    yy := Fma(z, yy, SqlMAtanCij[7 * i + 2] as Double);
    yy := Fma(-z, yy, SqlMHpi1 as Double);
    t1 := (SqlMHpi as Double) - (SqlMAtanCij[7 * i + 1] as Double);
    Exit(SqlMCopySign(t1 + yy, X));
  end;
  if u < (E as Double) then
  begin
    w := 1 / u;
    v := w * w;
    t1 := w * u;
    t2 := Fma(w, u, -t1);
    yy := SqlMAtanPoly(v);
    t3 := (SqlMHpi as Double) - w;
    if Abs(SqlMHpi as Double) > Abs(w) then
      cor := ((SqlMHpi as Double) - t3) - w
    else
      cor := (SqlMHpi as Double) - (w + t3);
    yy := Fma(-yy, w * v, Fma(-w, (1 - t1) - t2, (SqlMHpi1 as Double) + cor));
    Exit(SqlMCopySign(t3 + yy, X));
  end;
  if X > 0 then
    Result := SqlMHpi as Double
  else
    Result := Integer($BFF921FB54442D18) as Double;
end;

{ SqlMAtan2: glibc's atan2 (e_atan2.c, IBM's Accurate Mathematical
  Library) as __ieee754_atan2_fma computes it: the special cases of
  C99's F.9.1.4, then u = min/max of |x|, |y| with its error du, atan(u)
  as in SqlMAtan and the quadrant from pi/2 and pi in two parts. Where
  EADD or ESUB's comparison stays a branch between a product and its
  sum, GCC does not fuse them (one basic block only): zz of the small
  cases of (ii) to (iv) is a product. }
function SqlMAtan2(Y, X: Double): Double;
const
  Inv16: Integer = $3FB0000000000000;
  Opi: Integer = $400921FB54442D18;
  Opi1: Integer = $3CA1A62633145C07;
  Mopi: Integer = $C00921FB54442D18;
  Mhpi: Integer = $BFF921FB54442D18;
  Qpi: Integer = $3FE921FB54442D18;
  Mqpi: Integer = $BFE921FB54442D18;
  Tqpi: Integer = $4002D97C7F3321D2;
  Mtqpi: Integer = $C002D97C7F3321D2;
  Two500: Integer = $5F30000000000000;
  TwoM500: Integer = $20B0000000000000;
  T52: Integer = $4330000000000000;
  Ep = 59768832;
  Em = -59768832;
var
  bx, by, ux, dx, uy, dy, de, i: Integer;
  ax, ay, u, du, v, vv, dv, t1, t2, t3, z, zz, cor, q: Double;
begin
  bx := X as Integer;
  by := Y as Integer;
  ux := (bx shr 32) and $FFFFFFFF;
  dx := bx and $FFFFFFFF;
  uy := (by shr 32) and $FFFFFFFF;
  dy := by and $FFFFFFFF;
  if ((ux and $7FF00000) = $7FF00000) and (((ux and $000FFFFF) or dx) <> 0) then
    Exit(SqlMNaN2(X, Y));
  if ((uy and $7FF00000) = $7FF00000) and (((uy and $000FFFFF) or dy) <> 0) then
    Exit(Y + Y);
  if (uy = 0) and (dy = 0) then
  begin
    if (ux and $80000000) = 0 then
      Exit(0.0);
    Exit(Opi as Double);
  end;
  if (uy = $80000000) and (dy = 0) then
  begin
    if (ux and $80000000) = 0 then
      Exit(Integer($8000000000000000) as Double);
    Exit(Mopi as Double);
  end;
  if X = 0 then
  begin
    if (uy and $80000000) = 0 then
      Exit(SqlMHpi as Double);
    Exit(Mhpi as Double);
  end;
  if (ux = $7FF00000) and (dx = 0) then
  begin
    if uy = $7FF00000 then
    begin
      if dy = 0 then
        Exit(Qpi as Double);
    end
    else if uy = $FFF00000 then
    begin
      if dy = 0 then
        Exit(Mqpi as Double);
    end
    else
    begin
      if (uy and $80000000) = 0 then
        Exit(0.0);
      Exit(Integer($8000000000000000) as Double);
    end;
  end
  else if (ux = $FFF00000) and (dx = 0) then
  begin
    if uy = $7FF00000 then
    begin
      if dy = 0 then
        Exit(Tqpi as Double);
    end
    else if uy = $FFF00000 then
    begin
      if dy = 0 then
        Exit(Mtqpi as Double);
    end
    else
    begin
      if (uy and $80000000) = 0 then
        Exit(Opi as Double);
      Exit(Mopi as Double);
    end;
  end;
  if (uy = $7FF00000) and (dy = 0) then
    Exit(SqlMHpi as Double);
  if (uy = $FFF00000) and (dy = 0) then
    Exit(Mhpi as Double);
  if X < 0 then
    ax := -X
  else
    ax := X;
  if Y < 0 then
    ay := -Y
  else
    ay := Y;
  de := (uy and $7FF00000) - (ux and $7FF00000);
  if de >= Ep then
  begin
    if Y > 0 then
      Exit(SqlMHpi as Double);
    Exit(Mhpi as Double);
  end
  else if de <= Em then
  begin
    if X > 0 then
      Exit(SqlMCopySign(ay / ax, Y));
    if Y > 0 then
      Exit(Opi as Double);
    Exit(Mopi as Double);
  end;
  if (ax < (TwoM500 as Double)) or (ay < (TwoM500 as Double)) then
  begin
    ax := ax * (Two500 as Double);
    ay := ay * (Two500 as Double);
  end;
  if (ax > (Two500 as Double)) or (ay > (Two500 as Double)) then
  begin
    ax := ax * (TwoM500 as Double);
    ay := ay * (TwoM500 as Double);
  end;
  if ay < ax then
  begin
    u := ay / ax;
    v := ax * u;
    vv := Fma(ax, u, -v);
    du := ((ay - v) - vv) / ax;
  end
  else
  begin
    u := ax / ay;
    v := ay * u;
    vv := Fma(ay, u, -v);
    du := ((ax - v) - vv) / ay;
  end;
  if X > 0 then
  begin
    if ay < ax then
    begin
      if u < (Inv16 as Double) then
      begin
        v := u * u;
        zz := Fma(u * v, SqlMAtanPoly(v), du);
        Exit(SqlMCopySign(u + zz, Y));
      end;
      i := Trunc(Fma(256, u, T52 as Double) - (T52 as Double)) - 16;
      t3 := u - (SqlMAtanCij[7 * i] as Double);
      v := t3 + du;
      if Abs(t3) > Abs(du) then
        dv := (t3 - v) + du
      else
        dv := (du - v) + t3;
      t1 := SqlMAtanCij[7 * i + 1] as Double;
      t2 := SqlMAtanCij[7 * i + 2] as Double;
      q := Fma(v, SqlMAtanCij[7 * i + 6] as Double, SqlMAtanCij[7 * i + 5] as Double);
      q := Fma(v, q, SqlMAtanCij[7 * i + 4] as Double);
      q := Fma(v, q, SqlMAtanCij[7 * i + 3] as Double);
      zz := Fma(v, t2, Fma(dv, t2, (v * v) * q));
      Exit(SqlMCopySign(t1 + zz, Y));
    end;
    if u < (Inv16 as Double) then
    begin
      v := u * u;
      t2 := (SqlMHpi as Double) - u;
      if Abs(SqlMHpi as Double) > Abs(u) then
        cor := ((SqlMHpi as Double) - t2) - u
      else
        cor := (SqlMHpi as Double) - (u + t2);
      t3 := (((SqlMHpi1 as Double) + cor) - du) - (u * v) * SqlMAtanPoly(v);
      Exit(SqlMCopySign(t2 + t3, Y));
    end;
    i := Trunc(Fma(256, u, T52 as Double) - (T52 as Double)) - 16;
    v := (u - (SqlMAtanCij[7 * i] as Double)) + du;
    q := Fma(v, SqlMAtanCij[7 * i + 6] as Double, SqlMAtanCij[7 * i + 5] as Double);
    q := Fma(v, q, SqlMAtanCij[7 * i + 4] as Double);
    q := Fma(v, q, SqlMAtanCij[7 * i + 3] as Double);
    q := Fma(v, q, SqlMAtanCij[7 * i + 2] as Double);
    zz := Fma(-v, q, SqlMHpi1 as Double);
    t1 := (SqlMHpi as Double) - (SqlMAtanCij[7 * i + 1] as Double);
    Exit(SqlMCopySign(t1 + zz, Y));
  end;
  if ax < ay then
  begin
    if u < (Inv16 as Double) then
    begin
      v := u * u;
      t2 := (SqlMHpi as Double) + u;
      if Abs(SqlMHpi as Double) > Abs(u) then
        cor := ((SqlMHpi as Double) - t2) + u
      else
        cor := (u - t2) + (SqlMHpi as Double);
      t3 := (((SqlMHpi1 as Double) + cor) + du) + (u * v) * SqlMAtanPoly(v);
      Exit(SqlMCopySign(t2 + t3, Y));
    end;
    i := Trunc(Fma(256, u, T52 as Double) - (T52 as Double)) - 16;
    v := (u - (SqlMAtanCij[7 * i] as Double)) + du;
    q := Fma(v, SqlMAtanCij[7 * i + 6] as Double, SqlMAtanCij[7 * i + 5] as Double);
    q := Fma(v, q, SqlMAtanCij[7 * i + 4] as Double);
    q := Fma(v, q, SqlMAtanCij[7 * i + 3] as Double);
    q := Fma(v, q, SqlMAtanCij[7 * i + 2] as Double);
    zz := Fma(v, q, SqlMHpi1 as Double);
    t1 := (SqlMHpi as Double) + (SqlMAtanCij[7 * i + 1] as Double);
    Exit(SqlMCopySign(t1 + zz, Y));
  end;
  if u < (Inv16 as Double) then
  begin
    v := u * u;
    t2 := (Opi as Double) - u;
    if Abs(Opi as Double) > Abs(u) then
      cor := ((Opi as Double) - t2) - u
    else
      cor := (Opi as Double) - (u + t2);
    t3 := (((Opi1 as Double) + cor) - du) - (u * v) * SqlMAtanPoly(v);
    Exit(SqlMCopySign(t2 + t3, Y));
  end;
  i := Trunc(Fma(256, u, T52 as Double) - (T52 as Double)) - 16;
  v := (u - (SqlMAtanCij[7 * i] as Double)) + du;
  q := Fma(v, SqlMAtanCij[7 * i + 6] as Double, SqlMAtanCij[7 * i + 5] as Double);
  q := Fma(v, q, SqlMAtanCij[7 * i + 4] as Double);
  q := Fma(v, q, SqlMAtanCij[7 * i + 3] as Double);
  q := Fma(v, q, SqlMAtanCij[7 * i + 2] as Double);
  zz := Fma(-v, q, Opi1 as Double);
  t1 := (Opi as Double) - (SqlMAtanCij[7 * i + 1] as Double);
  Result := SqlMCopySign(t1 + zz, Y);
end;

{ The double-double steps of CORE-MATH's functions (glibc's
  ddcoremath.h), each as its C: a value hi + lo kept as two doubles,
  the error of a sum or a product caught exactly (Joldes, Muller and
  Popescu, ACM TOMS 44(2), 2017). A table of pairs is a slice of the
  Integer words, c[i][0] at 2i and c[i][1] at 2i+1. }
function SqlMFastTwoSum(X, Y: Double; out E: Double): Double;
var
  z: Double;
begin
  Result := X + Y;
  z := Result - X;
  E := Y - z;
end;

function SqlMFastTwoSub(X, Y: Double; out E: Double): Double;
var
  z: Double;
begin
  Result := X - Y;
  z := X - Result;
  E := z - Y;
end;

function SqlMTwoSum(X, Y: Double; out E: Double): Double;
begin
  if Abs(X) > Abs(Y) then
    Result := SqlMFastTwoSum(X, Y, E)
  else
    Result := SqlMFastTwoSum(Y, X, E);
end;

function SqlMFastSum(XH, XL, YH, YL: Double; out E: Double): Double;
var
  sl: Double;
begin
  Result := SqlMFastTwoSum(XH, YH, sl);
  E := (XL + YL) + sl;
end;

function SqlMSumDD(XH, XL, YH, YL: Double; out E: Double): Double;
var
  sl: Double;
begin
  if Abs(XH) > Abs(YH) then
    Result := SqlMFastTwoSum(XH, YH, sl)
  else
    Result := SqlMFastTwoSum(YH, XH, sl);
  E := (XL + YL) + sl;
end;

function SqlMAddDD(XH, XL, CH, CL: Double; out L: Double): Double;
var
  d: Double;
begin
  Result := XH + CH;
  d := Result - XH;
  L := ((CH - d) + (XH + (d - Result))) + (XL + CL);
end;

function SqlMAddDD2(XH, XL, CH, CL: Double; out L: Double): Double;
begin
  Result := SqlMTwoSum(XH, CH, L);
  L := L + (XL + CL);
end;

function SqlMMulDDAcc(XH, XL, CH, CL: Double; out L: Double): Double;
var
  ahlh, alhh, ahhh, ahhl: Double;
begin
  ahlh := CH * XL;
  alhh := CL * XH;
  ahhh := CH * XH;
  ahhl := Fma(CH, XH, -ahhh);
  ahhl := ahhl + (alhh + ahlh);
  Result := ahhh + ahhl;
  L := (ahhh - Result) + ahhl;
end;

function SqlMMulDDAcc2(XH, XL, CH, CL: Double; out L: Double): Double;
var
  ahlh, alhh, ahhh, ahhl: Double;
begin
  ahlh := CH * XL;
  alhh := CL * XH;
  ahhh := CH * XH;
  ahhl := Fma(CH, XH, -ahhh);
  ahhl := ahhl + (alhh + ahlh);
  Result := SqlMFastTwoSum(ahhh, ahhl, L);
end;

function SqlMMulDD2(XH, XL, CH, CL: Double; out L: Double): Double;
begin
  Result := CH * XH;
  L := (CH * XL + CL * XH) + Fma(CH, XH, -Result);
end;

function SqlMMulDD3(XH, XL, YH, YL: Double; out L: Double): Double;
var
  ch, cl1, tl0, tl1, cl2: Double;
begin
  ch := XH * YH;
  cl1 := Fma(XH, YH, -ch);
  tl0 := XL * YL;
  tl1 := tl0 + XH * YL;
  cl2 := tl1 + XL * YH;
  Result := SqlMFastTwoSum(ch, cl1 + cl2, L);
end;

function SqlMMulDDD(XH, XL, CH: Double; out L: Double): Double;
var
  ahlh, ahhh, ahhl: Double;
begin
  ahlh := CH * XL;
  ahhh := CH * XH;
  ahhl := Fma(CH, XH, -ahhh);
  ahhl := ahhl + ahlh;
  Result := ahhh + ahhl;
  L := (ahhh - Result) + ahhl;
end;

function SqlMMulDDDAcc(XH, XL, CH: Double; out L: Double): Double;
var
  ahlh, ahhh, ahhl: Double;
begin
  ahlh := CH * XL;
  ahhh := CH * XH;
  ahhl := Fma(CH, XH, -ahhh);
  ahhl := ahhl + ahlh;
  Result := SqlMFastTwoSum(ahhh, ahhl, L);
end;

function SqlMMulDDD2(X, CH, CL: Double; out L: Double): Double;
begin
  Result := CH * X;
  L := CL * X + Fma(CH, X, -Result);
end;

function SqlMMulDDD3(XH, XL, CH: Double; out L: Double): Double;
begin
  Result := XH * CH;
  L := Fma(CH, XH, -Result) + XL * CH;
end;

function SqlMPolyDD(XH, XL: Double; N: Integer; const C: array of Integer; var L: Double): Double;
var
  i: Integer;
  ch, cl, th, tl: Double;
begin
  i := N - 1;
  ch := SqlMFastTwoSum(C[2 * i] as Double, L, cl);
  cl := cl + (C[2 * i + 1] as Double);
  Dec(i);
  while i >= 0 do
  begin
    ch := SqlMMulDDAcc(XH, XL, ch, cl, cl);
    th := ch + (C[2 * i] as Double);
    tl := ((C[2 * i] as Double) - th) + ch;
    ch := th;
    cl := cl + (tl + (C[2 * i + 1] as Double));
    Dec(i);
  end;
  L := cl;
  Result := ch;
end;

function SqlMPolyDD2(XH, XL: Double; N: Integer; const C: array of Integer; var L: Double): Double;
var
  i: Integer;
  ch, cl: Double;
begin
  i := N - 1;
  ch := SqlMFastTwoSum(C[2 * i] as Double, L, cl);
  cl := cl + (C[2 * i + 1] as Double);
  Dec(i);
  while i >= 0 do
  begin
    ch := SqlMMulDD2(XH, XL, ch, cl, cl);
    ch := SqlMFastSum(C[2 * i] as Double, C[2 * i + 1] as Double, ch, cl, cl);
    Dec(i);
  end;
  L := cl;
  Result := ch;
end;

function SqlMPolyDD3(XH, XL: Double; N: Integer; const C: array of Integer; var L: Double): Double;
var
  i: Integer;
  ch, cl, th, tl: Double;
begin
  i := N - 1;
  ch := SqlMFastTwoSum(C[2 * i] as Double, L, cl);
  cl := cl + (C[2 * i + 1] as Double);
  Dec(i);
  while i >= 0 do
  begin
    ch := SqlMMulDDAcc2(XH, XL, ch, cl, cl);
    th := SqlMFastTwoSum(C[2 * i] as Double, ch, tl);
    ch := th;
    cl := cl + (tl + (C[2 * i + 1] as Double));
    Dec(i);
  end;
  L := cl;
  Result := ch;
end;

function SqlMPolyDDD(X: Double; N: Integer; const C: array of Integer; var L: Double): Double;
var
  i: Integer;
  ch, cl: Double;
begin
  i := N - 1;
  ch := SqlMFastTwoSum(C[2 * i] as Double, L, cl);
  cl := cl + (C[2 * i + 1] as Double);
  Dec(i);
  while i >= 0 do
  begin
    ch := SqlMMulDDD2(X, ch, cl, cl);
    ch := SqlMSumDD(C[2 * i] as Double, C[2 * i + 1] as Double, ch, cl, cl);
    Dec(i);
  end;
  L := cl;
  Result := ch;
end;

function SqlMPolyDDDFst(X: Double; N: Integer; const C: array of Integer; var L: Double): Double;
var
  i: Integer;
  ch, cl: Double;
begin
  i := N - 1;
  ch := SqlMFastTwoSum(C[2 * i] as Double, L, cl);
  cl := cl + (C[2 * i + 1] as Double);
  Dec(i);
  while i >= 0 do
  begin
    ch := SqlMMulDDD2(X, ch, cl, cl);
    ch := SqlMFastSum(C[2 * i] as Double, C[2 * i + 1] as Double, ch, cl, cl);
    Dec(i);
  end;
  L := cl;
  Result := ch;
end;

{ SqlMDatabase: CORE-MATH's as_*_database, the exact answer for an x in
  a table of the hard cases (x, hi, lo sorted by x), F otherwise. }
function SqlMDatabase(const DB: array of Integer; X, F: Double): Double;
var
  a, b, m: Integer;
  ax, d: Double;
begin
  a := 0;
  b := Length(DB) div 3 - 1;
  m := (a + b) div 2;
  ax := Abs(X);
  while a <= b do
  begin
    d := DB[3 * m] as Double;
    if d < ax then
      a := m + 1
    else if d = ax then
    begin
      F := (DB[3 * m + 1] as Double) + (DB[3 * m + 2] as Double);
      Break;
    end
    else
      b := m - 1;
    m := (a + b) div 2;
  end;
  Result := F;
end;

