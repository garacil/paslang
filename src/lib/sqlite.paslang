  SqlAddFunc('count', 0, SQLITE_FUNC_COUNT or SQLITE_FUNC_ANYORDER, 0, @SqlFnCountStep, @SqlFnCountFinal,
    @SqlFnCountFinal, @SqlFnCountInverse);
