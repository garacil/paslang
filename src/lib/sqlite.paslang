{ ---- SQL: the tree a statement parses into (P404) ----

  SQLite's own structures (sqliteInt.h): Expr, ExprList, IdList,
  SrcList, Select, With, Window, Upsert, TriggerStep, field for field
  where the parser sets them; and a statement object that records what
  SQLite's parser hands to its code generator while it reduces (build.c,
  insert.c, update.c, delete.c, trigger.c, alter.c, pragma.c, vtab.c,
  attach.c, vacuum.c): the calls in their order, with their arguments,
  for the code generator of P405 onwards. }

const
  SQLITE_SO_ASC = 0;
  SQLITE_SO_DESC = 1;
  SQLITE_SO_UNDEFINED = -1;
  KEYINFO_ORDER_DESC = 1;
  KEYINFO_ORDER_BIGNULL = 2;
  OE_None = 0;
  OE_Rollback = 1;
  OE_Abort = 2;
  OE_Fail = 3;
  OE_Ignore = 4;
  OE_Replace = 5;
  OE_Update = 6;
  OE_Restrict = 7;
  OE_SetNull = 8;
  OE_SetDflt = 9;
  OE_Cascade = 10;
  OE_Default = 11;
  SF_Distinct = 1;
  SF_All = 2;
  SF_Compound = 256;
  SF_Values = 512;
  SF_MultiValue = 1024;
  SF_NestedFrom = 2048;
  JT_INNER = 1;
  JT_CROSS = 2;
  JT_NATURAL = 4;
  JT_LEFT = 8;
  JT_RIGHT = 16;
  JT_OUTER = 32;
  JT_LTORJ = 64;
  JT_ERROR = 128;
  TF_WithoutRowid = 128;
  TF_NoVisibleRowid = 512;
  TF_Strict = 65536;
  M10d_Yes = 0;
  M10d_Any = 1;
  M10d_No = 2;
  EP_OuterON = 1;
  EP_InnerON = 2;
  EP_Distinct = 4;
  EP_HasFunc = 8;
  EP_DblQuoted = 128;
  EP_InfixFunc = 256;
  EP_Collate = 512;
  EP_IntValue = 2048;
  EP_xIsSelect = 4096;
  EP_Skip = 8192;
  EP_FullSize = 131072;
  EP_Subquery = 4194304;
  EP_Leaf = 8388608;
  EP_WinFunc = 16777216;
  EP_Quoted = 67108864;
  EP_IsTrue = 268435456;
  EP_IsFalse = 536870912;
  EP_Propagate = EP_Collate or EP_Subquery or EP_HasFunc;
  ENAME_NAME = 0;
  ENAME_SPAN = 1;
  SQLITE_IDXTYPE_APPDEF = 0;
  SQLITE_IDXTYPE_UNIQUE = 1;
  SAVEPOINT_BEGIN = 0;
  SAVEPOINT_RELEASE = 1;
  SAVEPOINT_ROLLBACK = 2;

  { the limits of sqliteLimit.h, SQLite's own defaults }
  SqlMaxColumn = 2000;
  SqlMaxExprDepth = 1000;
  SqlMaxCompoundSelect = 500;
  SqlMaxFunctionArg = 1000;
  SqlMaxVariableNumber = 32766;
  SqlMaxParserDepth = 2500;
  SqlMaxSrcList = 200;
  SqlMaxSqlLength = 1000000000;

  { the kinds of statement: the call of SQLite's code generator the
    statement ends in }
  stNone = 0;
  stSelect = 1;
  stInsert = 2;
  stUpdate = 3;
  stDelete = 4;
  stBegin = 5;
  stCommit = 6;
  stRollback = 7;
  stSavepoint = 8;
  stCreateTable = 11;
  stDropTable = 12;
  stCreateView = 13;
  stDropView = 14;
  stCreateIndex = 15;
  stDropIndex = 16;
  stVacuum = 17;
  stPragma = 18;
  stCreateTrigger = 19;
  stDropTrigger = 20;
  stAttach = 21;
  stDetach = 22;
  stReindex = 23;
  stAnalyze = 24;
  stAlterRename = 25;
  stAlterAddColumn = 26;
  stAlterDropColumn = 27;
  stAlterRenameColumn = 28;
  stAlterDropConstraint = 29;
  stAlterSetNotNull = 31;
  stAlterAddConstraint = 32;
  stCreateVtab = 33;

  { the kinds of column and table constraint, as the calls that make
    them: sqlite3AddDefaultValue, sqlite3AddNotNull, sqlite3AddPrimaryKey,
    sqlite3CreateIndex (UNIQUE), sqlite3AddCheckConstraint,
    sqlite3CreateForeignKey, sqlite3DeferForeignKey, sqlite3AddCollateType,
    sqlite3AddGenerated }
  ccDefault = 1;
  ccNotNull = 2;
  ccPrimaryKey = 3;
  ccUnique = 4;
  ccCheck = 5;
  ccForeignKey = 6;
  ccDefer = 7;
  ccCollate = 8;
  ccGenerated = 9;

type
  { A token: its first byte's place in the SQL text, from 1, and its
    length; Z = 0 for none (Token.z = 0). }
  TSqlTok = record
    Z, N: Integer;
  end;

  TSqlExpr = class;
  TSqlExprList = class;
  TSqlSelect = class;
  TSqlSrcList = class;
  TSqlIdList = class;
  TSqlWindow = class;
  TSqlWith = class;
  TSqlUpsert = class;
  TSqlStep = class;

  { Expr: Op a TK_ code; Flags EP_; Tok u.zToken (unquoted when the
    token was quoted), IVal u.iValue with EP_IntValue; Aff affExpr (a
    RAISE's type); Left and Right; List x.pList, Sel x.pSelect
    (EP_xIsSelect); Win y.pWin (EP_WinFunc); Ofst w.iOfst, the token's
    byte from the statement's start; ITable and IColumn as SQLite uses
    them at parse time (a variable's number, TK_SELECT_COLUMN's place);
    Height nHeight. }
  TSqlExpr = class
    Op: Integer;
    Flags: Integer;
    Tok: string;
    IVal: Integer;
    Aff: Integer;
    Left, Right: TSqlExpr;
    List: TSqlExprList;
    Sel: TSqlSelect;
    Win: TSqlWindow;
    Ofst: Integer;
    ITable, IColumn: Integer;
    Height: Integer;
    { the code generator's (P405): op2; iAgg; pAggInfo; y.pTab, y.nReg,
      y.sub.iAddr and y.sub.regReturn }
    Op2: Integer;
    IAgg: Integer;
    AggInfo: TObject;
    YTab: TObject;
    NReg: Integer;
    SubAddr, SubReturn: Integer;
  end;

  { ExprList_item: the expression, its zEName (HasName for one set) of
    kind eEName, and fg.sortFlags and fg.bNulls. }
  TSqlExprItem = record
    E: TSqlExpr;
    Name: string;
    HasName: Boolean;
    NameKind: Integer;
    SortFlags: Integer;
    BNulls: Boolean;
    { the code generator's (P405): fg.done, fg.reusable, fg.bSorterRef,
      fg.bUsed, fg.bUsingTerm, fg.bNoExpand; u.x.iOrderByCol,
      u.x.iAlias; u.iConstExprReg }
    Done, Reusable, BSorterRef, BUsed, BUsingTerm, BNoExpand: Boolean;
    IOrderByCol, IAlias: Integer;
    IConstExprReg: Integer;
  end;

  TSqlExprList = class
    A: array of TSqlExprItem;
  end;

  TSqlIdList = class
    A: array of string;
  end;

  { SrcItem: a table (Db.Name) or a subquery (Sel), its alias, a
    table-valued function's arguments, its join type, its ON or USING,
    INDEXED BY or NOT INDEXED; a VALUES list read through a co-routine
    (sqlite3MultiValues) keeps the rows after the first in Rows. }
  TSqlSrcItem = record
    Db, Name, Alias: string;
    HasDb, HasName, HasAlias: Boolean;
    Sel: TSqlSelect;
    IsSubquery: Boolean;
    FuncArgs: TSqlExprList;
    IsTabFunc: Boolean;
    JoinType: Integer;
    OnE: TSqlExpr;
    Using: TSqlIdList;
    IsUsing: Boolean;
    IndexedBy: string;
    IsIndexedBy, NotIndexed, NestedFrom, ViaCoroutine: Boolean;
    NRow: Integer;
    Rows: array of TSqlExprList;
    { the code generator's (P405): pSTab, iCursor, colUsed, the fg bits
      the parser does not set, the Subquery's addrFillSub, regReturn and
      regResult, u2.pIBIndex, u2.pCteUse and u4.pSchema }
    STab: TObject;
    ICursor: Integer;
    ColUsed: Integer;
    IsCorrelated, IsMaterialized, IsRecursive, FromDDL, IsCte, NotCte: Boolean;
    IsOn, IsSynthUsing, RowidUsed, FixedSchema, HadSchema, FromExists: Boolean;
    AddrFillSub, RegReturn, RegResult: Integer;
    IBIndex, CteUse, SchemaObj: TObject;
  end;

  TSqlSrcList = class
    A: array of TSqlSrcItem;
    NAlloc: Integer;
  end;

  { Select: Op TK_SELECT, or TK_UNION, TK_ALL, TK_EXCEPT or TK_INTERSECT
    joining it to Prior; Flags SF_; SelId selId; the clauses; Limit a
    TK_LIMIT whose Left is the limit and Right the offset. }
  TSqlSelect = class
    Op: Integer;
    Flags: Integer;
    SelId: Integer;
    Cols: TSqlExprList;
    From: TSqlSrcList;
    Where, Having, Limit: TSqlExpr;
    GroupBy, OrderBy: TSqlExprList;
    Prior, NextSel: TSqlSelect;
    WithC: TSqlWith;
    WinDefn: TSqlWindow;
    { the code generator's (P405): nSelectRow, iLimit, iOffset,
      addrOpenEphm, pWin }
    NSelectRow: Integer;
    ILimit, IOffset: Integer;
    AddrOpenEphm: array[0..1] of Integer;
    WinList: TSqlWindow;
  end;

  TSqlCte = record
    Name: string;
    Cols: TSqlExprList;
    Sel: TSqlSelect;
    Mat: Integer;
    { the code generator's (P405): zCteErr, the message of a circular
      reference while the CTE is expanded (HasCteErr), and pUse }
    CteErr: string;
    HasCteErr: Boolean;
    Use: TObject;
  end;

  TSqlWith = class
    A: array of TSqlCte;
    Outer: TSqlWith;
    { bView: it belongs to the outermost SELECT of a view }
    BView: Boolean;
  end;

  TSqlWindow = class
    Name, Base: string;
    Partition, OrderBy: TSqlExprList;
    FrmType, StartT, EndT, Excl: Integer;
    ImplicitFrame: Boolean;
    StartE, EndE, Filter: TSqlExpr;
    NextWin: TSqlWindow;
    { the code generator's (P405): pWFunc, iEphCsr, regAccum,
      regResult, csrApp, regApp, regPart, pOwner, nBufferCol, iArgCol,
      regOne, regStartRowid, regEndRowid, bExprArgs }
    WFunc: TObject;
    IEphCsr, RegAccum, RegResult, CsrApp, RegApp, RegPart: Integer;
    Owner: TSqlExpr;
    NBufferCol, IArgCol, RegOne, RegStartRowid, RegEndRowid: Integer;
    BExprArgs: Boolean;
    { ppThis: the window is in OwnerSel's pWin list (Linked), after
      PrevWin, or first when PrevWin is nil }
    Linked: Boolean;
    OwnerSel: TSqlSelect;
    PrevWin: TSqlWindow;
  end;

  TSqlUpsert = class
    Target: TSqlExprList;
    TargetWhere: TSqlExpr;
    SetL: TSqlExprList;
    Where: TSqlExpr;
    IsDoUpdate: Boolean;
    NextUp: TSqlUpsert;
    { the code generator's (P405): isDup, pUpsertIdx, pUpsertSrc,
      regData, iDataCur, iIdxCur }
    IsDup: Boolean;
    UpsertIdx: TObject;
    UpsertSrc: TSqlSrcList;
    RegData, IDataCur, IIdxCur: Integer;
  end;

  { A column's or a table's constraint as its call made it: Kind cc*;
    Name the CONSTRAINT name in force (u1.cr.constraintName); E its
    expression; StartZ and EndZ the text it was written as; the rest as
    each call takes it. }
  TSqlCons = record
    Kind: Integer;
    Name: string;
    HasName: Boolean;
    E: TSqlExpr;
    StartZ, EndZ: Integer;
    OnConf, Sort, AutoInc, Flags, Deferred: Integer;
    Coll, RefTable, GenType: string;
    HasGenType: Boolean;
    Cols, RefCols: TSqlExprList;
  end;

  { sqlite3AddColumn's arguments and the constraints that follow it. }
  TSqlColumn = record
    NameTok, TypeTok: TSqlTok;
    Name, Typ: string;
    Cons: array of TSqlCons;
  end;

  { TriggerStep: Op TK_INSERT, TK_UPDATE, TK_DELETE or TK_SELECT, the
    step's parts and its text (zSpan). }
  TSqlStep = class
    Op: Integer;
    OrConf: Integer;
    Src: TSqlSrcList;
    Sel: TSqlSelect;
    Where: TSqlExpr;
    ExprList: TSqlExprList;
    IdList: TSqlIdList;
    Upsert: TSqlUpsert;
    Span: string;
    NextStep, Last: TSqlStep;
    { the code generator's (P405): pTrig, the trigger of the step }
    Trig: TObject;
  end;

  { A statement: Kind st*, Explain 0, 1 (EXPLAIN) or 2 (EXPLAIN QUERY
    PLAN), and what its calls received; names and tokens as the calls
    received them (Name1 and Name2 the two parts of a name, StartTok the
    statement's first token, EndTok and ConsTok sqlite3EndTable's, LastTok
    the token the parser looked at when the statement ended). }
  TSqlStmt = class
    Kind, Explain: Integer;
    Sel: TSqlSelect;
    Src: TSqlSrcList;
    Where: TSqlExpr;
    SetL: TSqlExprList;
    IdCols: TSqlIdList;
    Upsert: TSqlUpsert;
    Returning: TSqlExprList;
    WithC: TSqlWith;
    OrConf, OnError: Integer;
    NoErr, Temp, IsView: Boolean;
    Name1, Name2, Name3: TSqlTok;
    StartTok, EndTok, ConsTok, LastTok: TSqlTok;
    Cols: array of TSqlColumn;
    Cons: array of TSqlCons;
    TabOpts: Integer;
    ExprCols: TSqlExprList;
    E1, E2, E3: TSqlExpr;
    TransType, SavepointOp: Integer;
    TrigTime, TrigEvent: Integer;
    TrigCols: TSqlIdList;
    Steps: TSqlStep;
    Minus: Boolean;
    VArgs: array of string;
    HasCompound: Boolean;
    NVar: Integer;
    VarNames: array of string;
  end;

{ ---- the tree's plain builders ---- }

function NewExpr(Op: Integer; const Tok: string): TSqlExpr;
begin
  Result := TSqlExpr.Create;
  Result.Op := Op;
  Result.Tok := Tok;
  Result.Height := 1;
  Result.IAgg := -1;
end;

{ sqlite3ExprListAppend: one more item, its fields zero. }
function ListAppend(L: TSqlExprList; E: TSqlExpr): TSqlExprList;
var
  n: Integer;
begin
  Result := L;
  if Result = nil then
    Result := TSqlExprList.Create;
  n := Length(Result.A);
  SetLength(Result.A, n + 1);
  Result.A[n].E := E;
end;

function ListLen(L: TSqlExprList): Integer;
begin
  if L = nil then
    Result := 0
  else
    Result := Length(L.A);
end;

{ sqlite3ExprListFlags: the flags of every item together. }
function ListFlags(L: TSqlExprList): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(L.A) do
    if L.A[i].E <> nil then
      Result := Result or L.A[i].E.Flags;
end;

{ sqlite3SelectOpName }
function SelectOpName(Op: Integer): string;
begin
  case Op of
    TK_ALL: Result := 'UNION ALL';
    TK_INTERSECT: Result := 'INTERSECT';
    TK_EXCEPT: Result := 'EXCEPT';
  else
    Result := 'UNION';
  end;
end;

{ ---- the tokenizer (tokenize.c) ---- }

