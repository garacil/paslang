  SqlDbLeave(v.Db);
end;

{ sqlite3_bind_pointer: an object only sqlite3_value_pointer with the
  same PType gives back; XDestroy lets go of it when the parameter does }
function sqlite3_bind_pointer(Stmt: TSqlite3Stmt; I: Integer; P: TObject; const PType: string;
  XDestroy: TSqlite3Destroy): Integer;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlVdbeUnbind(v, I - 1);
  if Result = SQLITE_OK then
    SqlMemSetPointer(v.Vars[I - 1].M, P, PType)
  else if Assigned(XDestroy) then
    XDestroy(P);
  SqlDbLeave(v.Db);
end;

function sqlite3_bind_parameter_count(Stmt: TSqlite3Stmt): Integer;
begin
  if Stmt = nil then
    Result := 0
  else
    Result := SqlBindParameterCount(Stmt as TSqlVdbe);
end;

