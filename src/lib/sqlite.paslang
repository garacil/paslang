    q := Fma(q, r3, Fma(r2, SqlMLogB[3] as Double, Fma(r, SqlMLogB[2] as Double, SqlMLogB[1] as Double)));
    w := Fma(r, P27 as Double, r);
    rhi := Fma(-r, P27 as Double, w);
    rlo := r - rhi;
    b0 := SqlMLogB[0] as Double;
    w := rhi * rhi;
    hi := Fma(w, b0, r);
    lo := Fma(w, b0, r - hi);
    lo := Fma(b0 * rlo, rhi + r, lo);
    y := Fma(q, r3, lo);
    Exit(hi + y);
  end;
  top := ix shr 48;
  if (top - $10 < 0) or (top - $10 >= $7FE0) then
  begin
    if ix shl 1 = 0 then
      Exit(Integer($FFF0000000000000) as Double);
    if ix = $7FF0000000000000 then
      Exit(X);
    if ((top and $8000) <> 0) or ((top and $7FF0) = $7FF0) then
      Exit((X - X) / (X - X));
