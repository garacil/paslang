  SqlMAtD5: Integer = $3FC99999999997FD;
  SqlMAtD7: Integer = $BFC24924923F7603;
  SqlMAtD9: Integer = $3FBC71C6E5129A3B;
  SqlMAtD11: Integer = $BFB7458022B13C25;
