function sqlite3_wal_hook(Db: TSqlite3; XCallback: TSqlite3WalHook; Arg: TObject): TObject;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := d.WalArg;
  SqlWalHook(d, XCallback, Arg);
  SqlDbLeave(d);
end;

function sqlite3_wal_autocheckpoint(Db: TSqlite3; N: Integer): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlWalAutocheckpoint(d, N);
  SqlDbLeave(d);
end;

{ sqlite3_set_authorizer (auth.c): XAuth nil for none; the prepared
  statements made under another authorizer are prepared again }
function sqlite3_set_authorizer(Db: TSqlite3; XAuth: TSqlite3Authorizer; Arg: TObject): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  d.XAuth := XAuth;
  d.PAuthArg := Arg;
  if Assigned(XAuth) then
    SqlExpirePreparedStatements(d, 1);
  SqlDbLeave(d);
  Result := SQLITE_OK;
end;

function sqlite3_autovacuum_pages(Db: TSqlite3; XCallback: TSqlite3AutovacPages; Arg: TObject;
  XDestructor: TSqlite3Destroy): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  if Assigned(d.XAutovacDestr) then
    d.XAutovacDestr(d.AutovacPagesArg);
  d.XAutovacPages := XCallback;
  d.AutovacPagesArg := Arg;
  d.XAutovacDestr := XDestructor;
  SqlDbLeave(d);
  Result := SQLITE_OK;
end;

function sqlite3_limit(Db: TSqlite3; Id, NewVal: Integer): Integer;
begin
  Result := SqlLimit(Db as TSqlDb, Id, NewVal);
end;

{ the file of database DbName ('' for a temporary or in-memory one) }
function sqlite3_db_filename(Db: TSqlite3; const DbName: string): string;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDbFilename(d, DbName);
  SqlDbLeave(d);
end;

{ 1 read-only, 0 not, -1 no such database }
function sqlite3_db_readonly(Db: TSqlite3; const DbName: string): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDbReadonly(d, DbName);
  SqlDbLeave(d);
end;

{ the schema name of database N, '' past the last }
function sqlite3_db_name(Db: TSqlite3; N: Integer): string;
var
  d: TSqlDb;
  has: Boolean;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDbName(d, N, has);
  SqlDbLeave(d);
end;

function sqlite3_db_release_memory(Db: TSqlite3): Integer;
