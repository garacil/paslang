  y1 := SqlMMulDDD3(y1, y2, X, y2);
  y1 := SqlMMulDD2(y1, y2, x2, x2l, y2);
  y0 := SqlMFastTwoSum(X, y1, y1);
  y1 := SqlMFastTwoSum(y1, y2, y2);
