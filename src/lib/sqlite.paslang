{ SqlMTanCot: s_tan.c's last steps once x = n*pi/2 + A + DA (cases VI
  to XI): a Taylor polynomial for |A| <= 0.0608, the table's tan at the
  nearest point xi and tan's addition formula above it; for an odd N
  -cot instead, by DIV2 (dla.h) for the small case. }
function SqlMTanCot(A, DA: Double; N: Integer): Double;
const
  D3: Integer = $3FD5555555555555;
  D5: Integer = $3FC11111111107C6;
  D7: Integer = $3FABA1BA1CDB8745;
  D9: Integer = $3F9664ED49CFC666;
  D11: Integer = $3F82385A3CF2E4EA;
  E0: Integer = $3FD5555555554DBD;
  E1: Integer = $3FC11112E0A6B45F;
  MFftnHf: Integer = $C02F000000000000;
  Gy2: Integer = $3FAF212D00000000;
var
  ya, yya, sy, a2, t2, b, db, c, dc, t1, t3, t4, z, z2, pz, fi, gi, y: Double;
  i: Integer;
begin
  if A < 0.0 then
  begin
    ya := -A;
    yya := -DA;
    sy := -1;
  end
  else
  begin
    ya := A;
    yya := DA;
    sy := 1;
  end;
  if ya <= (Gy2 as Double) then
  begin
    a2 := A * A;
    t2 := Fma(a2, D11 as Double, D9 as Double);
    t2 := Fma(a2, t2, D7 as Double);
    t2 := Fma(a2, t2, D5 as Double);
    t2 := Fma(a2, t2, D3 as Double);
    t2 := Fma(A * a2, t2, DA);
    if N <> 0 then
    begin
      b := A + t2;
      if Abs(A) > Abs(t2) then
        db := (A - b) + t2
      else
        db := (t2 - b) + A;
      t1 := 1.0 / b;
      t3 := t1 * b;
      t4 := Fma(t1, b, -t3);
      t2 := Fma(-t1, db, ((1.0 - t3) - t4) + 0.0) / b;
      c := t1 + t2;
      dc := (t1 - c) + t2;
      y := c + dc;
      Exit(-y);
    end;
    Exit(A + t2);
  end;
  i := Trunc(Fma(256, ya, MFftnHf as Double));
  z := (ya - (SqlMTanXfg[4 * i] as Double)) + yya;
  z2 := z * z;
  pz := Fma(z * z2, Fma(z2, E1 as Double, E0 as Double), z);
  fi := SqlMTanXfg[4 * i + 1] as Double;
  gi := SqlMTanXfg[4 * i + 2] as Double;
  if N <> 0 then
  begin
    t2 := pz * (fi + gi) / (fi + pz);
    y := gi - t2;
    Exit(-sy * y);
  end;
  t2 := pz * (gi + fi) / (gi - pz);
  y := fi + t2;
  Result := sy * y;
end;

{ SqlMTan: glibc's tan (s_tan.c, IBM's Accurate Mathematical Library)
  as __tan_fma computes it. }
function SqlMTan(X: Double): Double;
const
  D3: Integer = $3FD5555555555555;
  D5: Integer = $3FC11111111107C6;
  D7: Integer = $3FABA1BA1CDB8745;
  D9: Integer = $3F9664ED49CFC666;
  D11: Integer = $3F82385A3CF2E4EA;
  E0: Integer = $3FD5555555554DBD;
  E1: Integer = $3FC11112E0A6B45F;
  MFftnHf: Integer = $C02F000000000000;
  G1: Integer = $3E4B096C00000000;
  G2: Integer = $3FAF212D00000000;
  G3: Integer = $3FE92F1A00000000;
  G4: Integer = $4039000000000000;
  G5: Integer = $4197D78400000000;
  Mp1: Integer = $3FF921FB58000000;
  Mp2: Integer = $BE4DDE973C000000;
  Mp3: Integer = $BC8CB3B399D747F2;
  Pp3: Integer = $BC8CB3B398000000;
  Pp4: Integer = $BACD747F23E32ED7;
  HpInv: Integer = $3FE45F306DC9C883;
  ToInt: Integer = $4338000000000000;
var
  ux, i, n: Integer;
  w, x2, t2, z, z2, s, pz, fi, gi, y, t, xn, t1, da, a, ta, tda: Double;
begin
  ux := ((X as Integer) shr 32) and $FFFFFFFF;
  if (ux and $7FF00000) = $7FF00000 then
    Exit(SqlMInvalid(X));
  if X < 0.0 then
    w := -X
  else
    w := X;
  if w <= (G1 as Double) then
    Exit(X);
  if w <= (G2 as Double) then
  begin
    x2 := X * X;
    t2 := Fma(x2, D11 as Double, D9 as Double);
    t2 := Fma(x2, t2, D7 as Double);
    t2 := Fma(x2, t2, D5 as Double);
    t2 := Fma(x2, t2, D3 as Double);
    Exit(Fma(t2, X * x2, X));
  end;
  if w <= (G3 as Double) then
  begin
    i := Trunc(Fma(256, w, MFftnHf as Double));
    z := w - (SqlMTanXfg[4 * i] as Double);
    z2 := z * z;
    if X < 0.0 then
      s := -1
    else
      s := 1;
    pz := Fma(z * z2, Fma(z2, E1 as Double, E0 as Double), z);
    fi := SqlMTanXfg[4 * i + 1] as Double;
    gi := SqlMTanXfg[4 * i + 2] as Double;
    t2 := pz * (gi + fi) / (gi - pz);
    y := fi + t2;
    Exit(s * y);
  end;
  if w <= (G4 as Double) then
  begin
    t := Fma(X, HpInv as Double, ToInt as Double);
    xn := t - (ToInt as Double);
    t1 := Fma(-xn, Mp2 as Double, Fma(-xn, Mp1 as Double, X));
    n := (t as Integer) and 1;
    a := Fma(-xn, Mp3 as Double, t1);
    da := Fma(-xn, Mp3 as Double, t1 - a);
    Exit(SqlMTanCot(a, da, n));
  end;
  if w <= (G5 as Double) then
  begin
    t := Fma(X, HpInv as Double, ToInt as Double);
    xn := t - (ToInt as Double);
    t1 := Fma(-xn, Mp2 as Double, Fma(-xn, Mp1 as Double, X));
    n := (t as Integer) and 1;
    t := Fma(-xn, Pp3 as Double, t1);
    da := Fma(-xn, Pp3 as Double, t1 - t);
    a := Fma(-xn, Pp4 as Double, t);
    da := Fma(-xn, Pp4 as Double, t - a) + da;
    ta := a + da;
    if Abs(a) > Abs(da) then
      tda := (a - ta) + da
    else
      tda := (da - ta) + a;
    Exit(SqlMTanCot(ta, tda, n));
  end;
  n := SqlMRemPio2(X, a, da) and 1;
  ta := a + da;
  if Abs(a) > Abs(da) then
    tda := (a - ta) + da
  else
    tda := (da - ta) + a;
  Result := SqlMTanCot(ta, tda, n);
end;

const
  SqlMAtanCij: array[0..1686] of Integer = (
    $3FB0400665E0244E, $3FB03A737B53DD20, $3FEFDF1FCF5CFB72, $BFB01EB3CE2AE4C2,
    $BFD4D29EDD58A40D, $3FAFDA4AD907A18A, $3FC814DF4DF65B18, $3FB0FFFDB9B88CD8,
