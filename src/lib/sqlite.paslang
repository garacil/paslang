begin
  ix := X as Integer;
  if SqlMUlt(ix - $3FEE000000000000, $3FF1090000000000 - $3FEE000000000000) then
  begin
    if ix = $3FF0000000000000 then
      Exit(0.0);
    r := X - 1.0;
    r2 := r * r;
