  { pragCName: the result columns of the pragmas that have more than one,
    or a name other than the pragma's }
  SqlPragCName: array[0..56] of string = ('id', 'seq', 'table', 'from', 'to', 'on_update', 'on_delete',
    'match', 'cid', 'name', 'type', 'notnull', 'dflt_value', 'pk', 'hidden', 'name', 'builtin', 'type',
    'enc', 'narg', 'flags', 'schema', 'name', 'type', 'ncol', 'wr', 'strict', 'seqno', 'cid', 'name', 'desc',
    'coll', 'key', 'seq', 'name', 'unique', 'origin', 'partial', 'tbl', 'idx', 'wdth', 'hght', 'flgs',
    'table', 'rowid', 'parent', 'fkid', 'busy', 'log', 'checkpointed', 'seq', 'name', 'file', 'database',
    'status', 'cache_size', 'timeout');

  { aPragmaName of the default build (no SQLITE_DEBUG, SQLITE_ENABLE_CEROD
    or locking styles), sorted for pragmaLocate: each pragma's name,
    ePragTyp, mPragFlg, iPragCName, nPragCName and iArg }
