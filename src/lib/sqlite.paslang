begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlColumnDouble(v, ICol);
  SqlDbLeave(v.Db);
end;

{ the column's text, UTF-8 ('' for NULL) }
function sqlite3_column_text(Stmt: TSqlite3Stmt; ICol: Integer): string;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlColumnText(v, ICol);
  SqlDbLeave(v.Db);
end;

{ the column's text, UTF-16 in the machine's order }
function sqlite3_column_text16(Stmt: TSqlite3Stmt; ICol: Integer): string;
var
  v: TSqlVdbe;
  r: TSqlReg;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  r := SqlColumnMem(v, ICol);
  if (r = nil) or not SqlValueTextEnc(r.M, SQLITE_UTF16NATIVE, Result, SqlRegDigits(r)) then
    Result := '';
  SqlColumnMallocFailure(v);
  SqlDbLeave(v.Db);
end;

function sqlite3_column_blob(Stmt: TSqlite3Stmt; ICol: Integer): string;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlColumnBlob(v, ICol);
  SqlDbLeave(v.Db);
end;

function sqlite3_column_bytes(Stmt: TSqlite3Stmt; ICol: Integer): Integer;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlColumnBytes(v, ICol);
  SqlDbLeave(v.Db);
end;

function sqlite3_column_bytes16(Stmt: TSqlite3Stmt; ICol: Integer): Integer;
var
  v: TSqlVdbe;
  r: TSqlReg;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  r := SqlColumnMem(v, ICol);
  if r = nil then
    Result := 0
  else
    Result := SqlValueBytesEnc(r.M, SQLITE_UTF16NATIVE, SqlRegDigits(r));
  SqlColumnMallocFailure(v);
  SqlDbLeave(v.Db);
end;

{ the column's value, a copy the program owns (sqlite3_value_dup's) }
function sqlite3_column_value(Stmt: TSqlite3Stmt; ICol: Integer): TSqlite3Value;
var
  v: TSqlVdbe;
  r: TSqlReg;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  r := TSqlReg.Create;
  r.M := SqlColumnValue(v, ICol);
  if (r.M.Flags and MEM_Static) <> 0 then
    r.M.Flags := (r.M.Flags and not MEM_Static) or MEM_Ephem;
  SqlDbLeave(v.Db);
  Result := r;
end;

function sqlite3_column_name(Stmt: TSqlite3Stmt; N: Integer): string;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlColumnName(v, N);
  SqlDbLeave(v.Db);
end;

function sqlite3_column_name16(Stmt: TSqlite3Stmt; N: Integer): string;
begin
  Result := SqlUtfTranslate(sqlite3_column_name(Stmt, N), SQLITE_UTF8, SQLITE_UTF16NATIVE);
end;

