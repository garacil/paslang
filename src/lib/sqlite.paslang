  logc := SqlMLogTab[2 * i + 1] as Double;
  z := iz as Double;
  r := Fma(z, invc, -1.0);
  kd := Double(k);
  w := Fma(kd, Ln2hi as Double, logc);
  hi := r + w;
  lo := Fma(kd, Ln2lo as Double, (w - hi) + r);
  r2 := r * r;
  r3 := r * r2;
  q := Fma(Fma(r, SqlMLogA[4] as Double, SqlMLogA[3] as Double), r2,
    Fma(r, SqlMLogA[2] as Double, SqlMLogA[1] as Double));
  y := Fma(r3, q, Fma(r2, SqlMLogA[0] as Double, lo));
  Result := y + hi;
end;

