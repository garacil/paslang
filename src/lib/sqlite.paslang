{ SqlMExp: glibc's exp (sysdeps/ieee754/dbl-64/e_exp.c, ARM's
  optimized-routines), as its build for a processor with FMA computes
  it (__exp_fma; the products fused where GCC fused them, read from
  libm.so.6): exp(x) = 2^(k/128) * exp(r), r = x - k*ln2/128, the
  2^(k/128) from the table and exp(r)-1 from a polynomial of degree 5. }
function SqlMExpSpecial(Tmp: Double; SBits, Ki: Integer): Double;
var
  scale, y, hi, lo, one: Double;
  b: Integer;
begin
  if (Ki and $80000000) = 0 then
  begin
    SBits := SBits - (1009 shl 52);
    scale := SBits as Double;
    b := $7F00000000000000;
    Exit((b as Double) * Fma(scale, Tmp, scale));
  end;
  SBits := SBits + (1022 shl 52);
  scale := SBits as Double;
  lo := scale * Tmp;
  y := scale + lo;
  one := 1.0;
  if y < one then
  begin
    hi := one + y;
    lo := (scale - y) + lo;
    lo := ((one - hi) + y) + lo;
    y := (lo + hi) - one;
    if y = 0.0 then
      y := 0.0;
  end;
  b := $0010000000000000;
  Result := (b as Double) * y;
end;

function SqlMExp(X: Double): Double;
const
  InvLn2N: Integer = $40671547652B82FE;
  NegLn2hiN: Integer = $BF762E42FEFA0000;
  NegLn2loN: Integer = $BD0CF79ABC9E3B3A;
  Shift: Integer = $4338000000000000;
  C2: Integer = $3FDFFFFFFFFFFDBD;
  C3: Integer = $3FC555555555543C;
  C4: Integer = $3FA55555CF172B91;
  C5: Integer = $3F81111167A4D017;
var
  abstop, ki, idx, top, sbits, bx: Integer;
  kd, r, r2, scale, tail, tmp, p23, p45: Double;
begin
  bx := X as Integer;
  abstop := (bx shr 52) and $7FF;
  if (abstop - $3C9 < 0) or (abstop - $3C9 >= $408 - $3C9) then
  begin
    if abstop - $3C9 < 0 then
      Exit(1.0 + X);
    if abstop >= $409 then
    begin
      if bx = Integer($FFF0000000000000) then
        Exit(0.0);
      if abstop >= $7FF then
        Exit(1.0 + X);
      if bx < 0 then
        Exit(0.0)
      else
        Exit(Integer($7FF0000000000000) as Double);
    end;
    abstop := 0;
  end;
  kd := Fma(X, InvLn2N as Double, Shift as Double);
  ki := kd as Integer;
  kd := kd - (Shift as Double);
  r := Fma(kd, NegLn2hiN as Double, X);
  r := Fma(kd, NegLn2loN as Double, r);
  idx := 2 * (ki and 127);
  top := ki shl 45;
  tail := SqlMExpTab[idx] as Double;
  sbits := SqlMExpTab[idx + 1] + top;
  r2 := r * r;
  p23 := Fma(r, C3 as Double, C2 as Double);
  p45 := Fma(r, C5 as Double, C4 as Double);
  tmp := Fma(p23, r2, r + tail);
  tmp := Fma(r2 * r2, p45, tmp);
  if abstop = 0 then
    Exit(SqlMExpSpecial(tmp, sbits, ki));
  scale := sbits as Double;
  Result := Fma(scale, tmp, scale);
end;

const
  SqlMLogA: array[0..4] of Integer = (
    $BFE0000000000001, $3FD555555551305B, $BFCFFFFFFFEB4590, $3FC999B324F10111,
    $BFC55575E506C89F);
  SqlMLogB: array[0..10] of Integer = (
    $BFE0000000000000, $3FD5555555555577, $BFCFFFFFFFFFFDCB, $3FC999999995DD0C,
    $BFC55555556745A7, $3FC24924A344DE30, $BFBFFFFFA4423D65, $3FBC7184282AD6CA,
    $BFB999EB43B068FF, $3FB78182F7AFD085, $BFB5521375D145CD);
