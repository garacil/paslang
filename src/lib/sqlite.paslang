const
  SqlMPowA: array[0..6] of Integer = (
    $BFE0000000000000, $BFE5555555555560, $3FE0000000000006, $3FE999999959554E,
    $BFE555555529A47A, $BFF2495B9B4845E9, $3FF0002B8B263FC3);

{ SqlMInvalid: glibc's __math_invalid, (x-x)/(x-x): a NaN given stays
  that NaN made quiet; for any other x the NaN amd64 makes of 0/0, sign
  1, on both machines (arm64's own has sign 0). }
function SqlMInvalid(X: Double): Double;
begin
  if X <> X then
    Result := X + X
  else
    Result := Integer($FFF8000000000000) as Double;
end;

{ SqlMIsSignaling: a NaN whose quiet bit is clear (glibc's issignaling). }
function SqlMIsSignaling(B: Integer): Boolean;
begin
  Result := ((B xor $0008000000000000) and $7FFFFFFFFFFFFFFF) > $7FF8000000000000;
end;

{ SqlMCheckInt: 0 when the bits IY (a finite double not 0) are no
  integer, 1 an odd one, 2 an even one. }
function SqlMCheckInt(IY: Integer): Integer;
var
  e: Integer;
begin
  e := (IY shr 52) and $7FF;
  if e < $3FF then
    Exit(0);
  if e > $3FF + 52 then
    Exit(2);
  if (IY and ((1 shl ($3FF + 52 - e)) - 1)) <> 0 then
    Exit(0);
  if (IY and (1 shl ($3FF + 52 - e))) <> 0 then
    Exit(1);
  Result := 2;
end;

{ SqlMPowLog: pow's log_inline, log(x) as Y + Tail with some 15 bits more
  than a double holds, IX x's bits (a subnormal's normalized with the
  exponent below 0). }
function SqlMPowLog(IX: Integer; out Tail: Double): Double;
const
  Ln2hi: Integer = $3FE62E42FEFA3800;
  Ln2lo: Integer = $3D2EF35793C76730;
var
  tmp, i, k, iz: Integer;
  z, r, kd, invc, logc, logctail, t1, t2, lo1, lo2, lo3, lo4, ar, ar2, ar3, hi, q, lo, y: Double;
begin
  tmp := IX - $3FE6955500000000;
  i := (tmp shr 45) and 127;
  k := tmp sar 52;
  iz := IX - (tmp and Integer($FFF0000000000000));
  z := iz as Double;
  kd := Double(k);
  invc := SqlMPowTab[3 * i] as Double;
  logc := SqlMPowTab[3 * i + 1] as Double;
  logctail := SqlMPowTab[3 * i + 2] as Double;
  r := Fma(z, invc, -1.0);
  t1 := Fma(kd, Ln2hi as Double, logc);
  t2 := r + t1;
  lo1 := Fma(kd, Ln2lo as Double, logctail);
  lo2 := (t1 - t2) + r;
  ar := r * (SqlMPowA[0] as Double);
  ar2 := r * ar;
  ar3 := r * ar2;
  hi := t2 + ar2;
  lo3 := Fma(ar, r, -ar2);
  lo4 := (t2 - hi) + ar2;
  q := Fma(r, SqlMPowA[6] as Double, SqlMPowA[5] as Double);
  q := Fma(q, ar2, Fma(r, SqlMPowA[4] as Double, SqlMPowA[3] as Double));
  q := Fma(ar2, q, Fma(r, SqlMPowA[2] as Double, SqlMPowA[1] as Double));
  lo := Fma(ar3, q, ((lo1 + lo2) + lo3) + lo4);
  y := hi + lo;
  Tail := (hi - y) + lo;
  Result := y;
end;

{ SqlMPowExp: pow's exp_inline, sign*exp(X+XTail), SignBias $40000 for a
  negative result; as SqlMExp with the tail added to r. }
function SqlMPowExp(X, XTail: Double; SignBias: Integer): Double;
const
  InvLn2N: Integer = $40671547652B82FE;
  NegLn2hiN: Integer = $BF762E42FEFA0000;
  NegLn2loN: Integer = $BD0CF79ABC9E3B3A;
  Shift: Integer = $4338000000000000;
  C2: Integer = $3FDFFFFFFFFFFDBD;
  C3: Integer = $3FC555555555543C;
  C4: Integer = $3FA55555CF172B91;
  C5: Integer = $3F81111167A4D017;
var
  abstop, ki, idx, top, sbits, b: Integer;
  kd, r, r2, scale, tail, tmp, y, one, hi, lo, t: Double;
begin
  abstop := ((X as Integer) shr 52) and $7FF;
  if (abstop - $3C9 < 0) or (abstop - $3C9 >= $408 - $3C9) then
  begin
    if abstop - $3C9 < 0 then
    begin
      one := 1.0 + X;
      if SignBias <> 0 then
        Exit(-one);
      Exit(one);
    end;
    if abstop >= $409 then
    begin
      if (X as Integer) < 0 then
        b := 0
      else
        b := $7FF0000000000000;
      if SignBias <> 0 then
        b := b or Integer($8000000000000000);
      Exit(b as Double);
    end;
    abstop := 0;
  end;
  kd := Fma(X, InvLn2N as Double, Shift as Double);
  ki := kd as Integer;
  kd := kd - (Shift as Double);
  r := Fma(kd, NegLn2hiN as Double, X);
  r := Fma(kd, NegLn2loN as Double, r);
  r := XTail + r;
  idx := 2 * (ki and 127);
  top := (ki + SignBias) shl 45;
  tail := SqlMExpTab[idx] as Double;
  sbits := SqlMExpTab[idx + 1] + top;
  r2 := r * r;
  tmp := Fma(Fma(r, C3 as Double, C2 as Double), r2, r + tail);
  tmp := Fma(Fma(r, C5 as Double, C4 as Double), r2 * r2, tmp);
  if abstop <> 0 then
  begin
    scale := sbits as Double;
    Exit(Fma(scale, tmp, scale));
  end;
  if (ki and $80000000) = 0 then
  begin
    sbits := sbits - (1009 shl 52);
    scale := sbits as Double;
    b := $7F00000000000000;
    Exit(Fma(scale, tmp, scale) * (b as Double));
  end;
  sbits := sbits + (1022 shl 52);
  scale := sbits as Double;
  t := tmp * scale;
  y := scale + t;
  if Abs(y) < 1.0 then
  begin
    if y < 0.0 then
      one := -1.0
    else
      one := 1.0;
    lo := (scale - y) + t;
    hi := one + y;
    lo := ((one - hi) + y) + lo;
    y := (lo + hi) - one;
    if y = 0.0 then
      y := (sbits and Integer($8000000000000000)) as Double;
  end;
  b := $0010000000000000;
  Result := y * (b as Double);
end;

{ SqlMPow: glibc's pow (e_pow.c, ARM's optimized-routines) as
  __pow_fma computes it: x^y = exp(y*log(x)), the log with 68 bits and
  the product y*log(x) in two parts; the special cases of C99's F.10.4.4
  first. }
function SqlMPow(X, Y: Double): Double;
var
  ix, iy, topx, topy, signbias, yint: Integer;
  x2, hi, lo, ehi, elo: Double;
begin
  signbias := 0;
  ix := X as Integer;
  iy := Y as Integer;
  topx := ix shr 52;
  topy := iy shr 52;
  if (topx - 1 < 0) or (topx - 1 >= $7FE) or ((topy and $7FF) - $3BE < 0) or
    ((topy and $7FF) - $3BE >= $80) then
  begin
    if not SqlMUlt(2 * iy - 1, Integer($FFDFFFFFFFFFFFFF)) then
    begin
      if 2 * iy = 0 then
      begin
        if SqlMIsSignaling(ix) then
          Exit(X + Y);
        Exit(1.0);
      end;
      if ix = $3FF0000000000000 then
      begin
        if SqlMIsSignaling(iy) then
          Exit(X + Y);
        Exit(1.0);
      end;
      if SqlMUlt(Integer($FFE0000000000000), 2 * ix) or SqlMUlt(Integer($FFE0000000000000), 2 * iy) then
        Exit(X + Y);
      if 2 * ix = $7FE0000000000000 then
        Exit(1.0);
      if SqlMUlt(2 * ix, $7FE0000000000000) = (iy >= 0) then
        Exit(0.0);
      Exit(Y * Y);
    end;
    if not SqlMUlt(2 * ix - 1, Integer($FFDFFFFFFFFFFFFF)) then
    begin
      x2 := X * X;
      if (ix < 0) and (SqlMCheckInt(iy) = 1) then
      begin
        x2 := -x2;
        signbias := 1;
      end;
      if (2 * ix = 0) and (iy < 0) then
      begin
        if signbias <> 0 then
          Exit(Integer($FFF0000000000000) as Double);
        Exit(Integer($7FF0000000000000) as Double);
      end;
      if iy < 0 then
        Exit(1 / x2);
      Exit(x2);
    end;
    if ix < 0 then
    begin
      yint := SqlMCheckInt(iy);
      if yint = 0 then
        Exit(SqlMInvalid(X));
      if yint = 1 then
        signbias := $40000;
      ix := ix and $7FFFFFFFFFFFFFFF;
      topx := topx and $7FF;
    end;
    if ((topy and $7FF) - $3BE < 0) or ((topy and $7FF) - $3BE >= $80) then
    begin
      if ix = $3FF0000000000000 then
        Exit(1.0);
      if (topy and $7FF) < $3BE then
      begin
        if SqlMUlt($3FF0000000000000, ix) then
          Exit(1.0 + Y);
        Exit(1.0 - Y);
      end;
      if SqlMUlt($3FF0000000000000, ix) = (topy < $800) then
        Exit(Integer($7FF0000000000000) as Double);
      Exit(0.0);
    end;
    if topx = 0 then
    begin
      ix := (X * (Integer($4330000000000000) as Double)) as Integer;
      ix := ix and $7FFFFFFFFFFFFFFF;
      ix := ix - (52 shl 52);
    end;
  end;
  hi := SqlMPowLog(ix, lo);
  ehi := Y * hi;
  elo := Fma(Y, lo, Fma(Y, hi, -ehi));
  Result := SqlMPowExp(ehi, elo, signbias);
end;

{ SqlMUDiv: A div B as unsigned 64-bit integers (B not 0): DIV, UDIV. }
function SqlMUDiv(A, B: Integer): Integer;
begin
  asm amd64 (A: in rax; B: in rcx; Result: out rax)
    xorl %edx, %edx
    divq %rcx
  end;
  asm arm64 (A: in x0; B: in x1; Result: out x0)
    udiv x0, x0, x1
  end;
end;

function SqlMUMod(A, B: Integer): Integer;
begin
  Result := A - SqlMUDiv(A, B) * B;
end;

{ SqlMSqrt: the square root rounded once (IEEE 754's squareRoot,
  SQRTSD, FSQRT), as glibc's sqrt is; below 0 the NaN amd64 gives. }
function SqlMSqrt(X: Double): Double;
begin
  if X < 0.0 then
    Exit(Integer($FFF8000000000000) as Double);
  asm amd64 (X: in xmm0; Result: out xmm0)
    sqrtsd %xmm0, %xmm0
  end;
  asm arm64 (X: in d0; Result: out d0)
    fsqrt d0, d0
  end;
end;

{ SqlMTrunc, SqlMFloor, SqlMCeil: the integer toward 0, below, above, as
  a double, from the bits (glibc's are ROUNDSD where the processor has
  SSE4.1 and s_trunc.c, s_floor.c, s_ceil.c elsewhere; all give these
  bits): a NaN made quiet, an infinity and a double past 2^52 as they
  are, the sign of 0 kept. }
function SqlMTrunc(X: Double): Double;
var
  ix, e: Integer;
begin
  ix := X as Integer;
  e := ((ix shr 52) and $7FF) - $3FF;
  if e >= 52 then
  begin
    if e = $400 then
      Exit(X + X);
    Exit(X);
  end;
  if e < 0 then
    Exit((ix and Integer($8000000000000000)) as Double);
  Result := (ix and not ($000FFFFFFFFFFFFF shr e)) as Double;
end;

function SqlMFloor(X: Double): Double;
var
  ix, e, m: Integer;
begin
  ix := X as Integer;
  e := ((ix shr 52) and $7FF) - $3FF;
  if e >= 52 then
  begin
    if e = $400 then
      Exit(X + X);
    Exit(X);
  end;
  if e < 0 then
  begin
    if ix >= 0 then
      Exit(0.0);
    if (ix and $7FFFFFFFFFFFFFFF) = 0 then
      Exit(X);
    Exit(-1.0);
  end;
  m := $000FFFFFFFFFFFFF shr e;
  if (ix and m) = 0 then
    Exit(X);
  if ix < 0 then
    ix := ix + ($0010000000000000 shr e);
  Result := (ix and not m) as Double;
end;

function SqlMCeil(X: Double): Double;
var
  ix, e, m: Integer;
begin
  ix := X as Integer;
  e := ((ix shr 52) and $7FF) - $3FF;
  if e >= 52 then
  begin
    if e = $400 then
      Exit(X + X);
    Exit(X);
  end;
  if e < 0 then
  begin
    if ix < 0 then
      Exit(Integer($8000000000000000) as Double);
    if ix = 0 then
      Exit(X);
    Exit(1.0);
  end;
  m := $000FFFFFFFFFFFFF shr e;
  if (ix and m) = 0 then
    Exit(X);
  if ix >= 0 then
    ix := ix + ($0010000000000000 shr e);
  Result := (ix and not m) as Double;
end;

{ SqlMNaN2: X*Y's NaN as amd64 makes it when X or Y is one: X's made
  quiet if X is a NaN, else Y's (arm64 would take a signaling Y first). }
function SqlMNaN2(X, Y: Double): Double;
begin
  if X <> X then
    Result := X + X
  else
    Result := Y + Y;
end;

{ SqlMMakeDouble: glibc's make_double, X * 2^(EP+1-1023) with sign S. }
function SqlMMakeDouble(X, EP, S: Integer): Double;
var
  lz: Integer;
begin
  lz := LeadingZeros(X) - 11;
  X := X shl lz;
  EP := EP - lz;
  if (EP < 0) or (X = 0) then
  begin
    X := X shr (-EP);
    EP := 0;
  end;
  Result := (S + X + (EP shl 52)) as Double;
end;

{ SqlMFmod: glibc's fmod (e_fmod.c), x - n*y with n x/y toward 0,
  exact: the mantissas' remainder taken 11 bits at a time, or by the
  inverse of y's mantissa for a far exponent. A NaN given comes back
  quiet (x's first); an infinite x or a y of 0 gives amd64's NaN. }
function SqlMFmod(X, Y: Double): Double;
var
  hx, hy, sx, ex, ey, expdiff, mx, my, sh, lzmy, tzmy, sides, rs, ls, invhy, hd: Integer;
begin
  hx := X as Integer;
  hy := Y as Integer;
  sx := hx and Integer($8000000000000000);
  hx := hx xor sx;
  hy := hy and $7FFFFFFFFFFFFFFF;
  if hx < hy then
  begin
    if hy > $7FF0000000000000 then
      Exit(SqlMNaN2(X, Y));
    Exit(X);
  end;
  ex := hx shr 52;
  ey := hy shr 52;
  expdiff := ex - ey;
  if (ey < $7FF - 11) and (ey > 52) and (expdiff <= 11) then
  begin
    mx := (hx shl 11) or Integer($8000000000000000);
    my := (hy shl 11) or Integer($8000000000000000);
    mx := SqlMUMod(mx, my shr expdiff);
    if mx = 0 then
      Exit(sx as Double);
    sh := LeadingZeros(mx);
    ex := ex - (sh + 1);
    mx := mx shl sh;
    mx := sx or (mx shr 11);
    Exit((mx + (ex shl 52)) as Double);
  end;
  if (hy = 0) or (hx >= $7FF0000000000000) then
  begin
    if hx > $7FF0000000000000 then
      Exit(X + X);
    Exit(Integer($FFF8000000000000) as Double);
  end;
  if ex = 0 then
    Exit((sx or SqlMUMod(hx, hy)) as Double);
  mx := (hx and $000FFFFFFFFFFFFF) or $0010000000000000;
  my := (hy and $000FFFFFFFFFFFFF) or $0010000000000000;
  lzmy := 11;
  ey := ey - 1;
  if ey < 0 then
  begin
    my := hy;
    ey := 0;
    expdiff := expdiff - 1;
    lzmy := LeadingZeros(my);
  end;
  tzmy := TrailingZeros(my);
  sides := lzmy + tzmy;
  if expdiff < tzmy then
    rs := expdiff
  else
    rs := tzmy;
  my := my shr rs;
  expdiff := expdiff - rs;
  ey := ey + rs;
  if expdiff < 11 then
    ls := expdiff
  else
    ls := 11;
  mx := mx shl ls;
  expdiff := expdiff - ls;
  mx := SqlMUMod(mx, my);
  if mx = 0 then
    Exit(sx as Double);
  if expdiff = 0 then
    Exit(SqlMMakeDouble(mx, ey, sx));
  invhy := SqlMUDiv(-1, my);
  while expdiff > sides do
  begin
    expdiff := expdiff - sides;
    hd := (mx * invhy) shr (64 - sides);
    mx := mx shl sides;
    mx := mx - hd * my;
    while SqlMUlt(my, mx) do
      mx := mx - my;
  end;
  hd := (mx * invhy) shr (64 - expdiff);
  mx := mx shl expdiff;
  mx := mx - hd * my;
  while SqlMUlt(my, mx) do
    mx := mx - my;
  Result := SqlMMakeDouble(mx, ey, sx);
end;

