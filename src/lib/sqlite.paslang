{ SqlMSinhDatabase: as_sinh_database, the table's answer with x's sign. }
function SqlMSinhDatabase(X, F: Double): Double;
var
  a, b, m: Integer;
  ax, d, sg: Double;
begin
  a := 0;
  b := 50;
  m := (a + b) div 2;
  ax := Abs(X);
  sg := SqlMCopySign(1.0, X);
  while a <= b do
  begin
    d := SqlMShDB[3 * m] as Double;
    if d < ax then
      a := m + 1
    else if d = ax then
    begin
      F := sg * (SqlMShDB[3 * m + 1] as Double) + sg * (SqlMShDB[3 * m + 2] as Double);
      Break;
    end
    else
      b := m - 1;
    m := (a + b) div 2;
  end;
  Result := F;
end;

