{ SqlMLog2: glibc's log2 (e_log2.c) as __log2_fma computes it: near 1
  (1-0x1.5b51p-5 to 1+0x1.6ab2p-5) r/ln2 in two parts and a polynomial
  of degree 11; elsewhere x = 2^k z, log2(x) = k + log2(c) + r/ln2 +
  r^2*poly(r), r = z/c-1 one fused multiply-add. }
function SqlMLog2(X: Double): Double;
const
  InvLn2hi: Integer = $3FF7154765200000;
  InvLn2lo: Integer = $3DE705FC2EEFA200;
  P52: Integer = $4330000000000000;
var
  ix, top, tmp, i, k, iz: Integer;
  r, r2, r4, y, hi, lo, p, q, kd, z, invc, logc, t1, t2, t3: Double;
begin
  ix := X as Integer;
  if SqlMUlt(ix - $3FEEA4AF00000000, $3FF0B55900000000 - $3FEEA4AF00000000) then
  begin
    if ix = $3FF0000000000000 then
      Exit(0.0);
    r := X - 1.0;
    hi := r * (InvLn2hi as Double);
    lo := Fma(r, InvLn2lo as Double, Fma(r, InvLn2hi as Double, -hi));
    r2 := r * r;
    r4 := r2 * r2;
    p := Fma(r, SqlMLog2B[1] as Double, SqlMLog2B[0] as Double);
    y := Fma(p, r2, hi);
    lo := Fma(p, r2, hi - y) + lo;
    q := Fma(Fma(r, SqlMLog2B[9] as Double, SqlMLog2B[8] as Double), r2,
      Fma(r, SqlMLog2B[7] as Double, SqlMLog2B[6] as Double));
    q := Fma(q, r4, Fma(Fma(r, SqlMLog2B[5] as Double, SqlMLog2B[4] as Double), r2,
      Fma(r, SqlMLog2B[3] as Double, SqlMLog2B[2] as Double)));
    Exit(Fma(q, r4, lo) + y);
  end;
  top := ix shr 48;
  if (top - $10 < 0) or (top - $10 >= $7FE0) then
  begin
    if ix shl 1 = 0 then
      Exit(Integer($FFF0000000000000) as Double);
    if ix = $7FF0000000000000 then
      Exit(X);
    if ((top and $8000) <> 0) or ((top and $7FF0) = $7FF0) then
      Exit((X - X) / (X - X));
    ix := (X * (P52 as Double)) as Integer;
    ix := ix - (52 shl 52);
  end;
  tmp := ix - $3FE6000000000000;
  i := (tmp shr 46) and 63;
  k := tmp sar 52;
  iz := ix - (tmp and Integer($FFF0000000000000));
  invc := SqlMLog2Tab[2 * i] as Double;
  logc := SqlMLog2Tab[2 * i + 1] as Double;
  z := iz as Double;
  kd := Double(k);
  r := Fma(z, invc, -1.0);
  t1 := r * (InvLn2hi as Double);
  t2 := Fma(r, InvLn2lo as Double, Fma(r, InvLn2hi as Double, -t1));
  t3 := kd + logc;
  hi := t3 + t1;
  lo := ((t3 - hi) + t1) + t2;
  r2 := r * r;
  r4 := r2 * r2;
  p := Fma(Fma(r, SqlMLog2A[3] as Double, SqlMLog2A[2] as Double), r2,
    Fma(r, SqlMLog2A[1] as Double, SqlMLog2A[0] as Double));
  p := Fma(Fma(r, SqlMLog2A[5] as Double, SqlMLog2A[4] as Double), r4, p);
  Result := Fma(r2, p, lo) + hi;
end;

{ SqlMLog10: glibc's log10 (e_log10.c, from fdlibm), built without FMA:
  x = 2^n y with y in [1,2) or for n < 0 in [0.5,1), log10(x) =
  n*log10(2) + log(y)/ln(10), log10(2) in two parts; log is SqlMLog,
  the library's own call. }
function SqlMLog10(X: Double): Double;
const
  Two54: Integer = $4350000000000000;
  IvLn10: Integer = $3FDBCB7B1526E50E;
  Log10_2hi: Integer = $3FD34413509F6000;
  Log10_2lo: Integer = $3D59FEF311F12B36;
var
  hx, i, k: Integer;
  y, z: Double;
begin
  { the wrapper (w_log10.c): x <= 0 answered by __kernel_standard,
    -HUGE_VAL for 0 and a NaN of sign 0 below }
  if X = 0.0 then
    Exit(Integer($FFF0000000000000) as Double);
  if X < 0.0 then
    Exit(Integer($7FF8000000000000) as Double);
  hx := X as Integer;
  k := 0;
  if hx < $0010000000000000 then
  begin
    if (hx and $7FFFFFFFFFFFFFFF) = 0 then
      Exit(-(Two54 as Double) / Abs(X));
    if hx < 0 then
      Exit((X - X) / (X - X));
    k := k - 54;
    X := X * (Two54 as Double);
    hx := X as Integer;
  end;
  if hx >= $7FF0000000000000 then
    Exit(X + X);
  k := k + (hx sar 52) - 1023;
  i := (k and Integer($8000000000000000)) shr 63;
  hx := (hx and $000FFFFFFFFFFFFF) or (($3FF - i) shl 52);
  y := Double(k + i);
  z := (IvLn10 as Double) * SqlMLog(hx as Double) + y * (Log10_2lo as Double);
  Result := z + y * (Log10_2hi as Double);
end;

