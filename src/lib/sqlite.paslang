begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlDbReleaseMemory(d);
  SqlDbLeave(d);
end;

{ sqlite3_file_control: Arg the operation's argument (nil when none) }
function sqlite3_file_control(Db: TSqlite3; const DbName: string; Op: Integer; Arg: Pointer): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlFileControl(d, DbName, DbName <> '', Op, Arg);
  SqlDbLeave(d);
end;

{ ---- functions and collations of a connection ---- }

{ sqlite3_create_function_v2: XFunc for a scalar function, XStep and
  XFinal for an aggregate, all nil to delete the function; XDestroy
  lets go of App when the function goes }
function sqlite3_create_function_v2(Db: TSqlite3; const Name: string; NArg, ETextRep: Integer; App: TObject;
  XFunc, XStep: TSqlite3Func; XFinal: TSqlite3FinalFunc; XDestroy: TSqlite3Destroy): Integer;
var
  d: TSqlDb;
  f: TSqlApiFunc;
  xs, xst, xfi: TSqlXFunc;
  xd: TSqlXDestroy;
begin
  d := Db as TSqlDb;
  f := TSqlApiFunc.Create;
  f.App := App;
  f.XFunc := XFunc;
  f.XStep := XStep;
  f.XFinal := XFinal;
  f.XDestroy := XDestroy;
  xs := nil;
  xst := nil;
  xfi := nil;
  if Assigned(XFunc) then
    xs := @SqlApiFuncCall;
  if Assigned(XStep) then
    xst := @SqlApiStepCall;
  if Assigned(XFinal) then
    xfi := @SqlApiFinalCall;
  xd := nil;
  if Assigned(XDestroy) then
    xd := @SqlApiFuncDestroy;
  SqlDbEnter(d);
  Result := SqlCreateFunctionApi(d, Name, True, NArg, ETextRep, f, xs, xst, xfi, nil, nil, xd);
  SqlDbLeave(d);
end;

function sqlite3_create_function(Db: TSqlite3; const Name: string; NArg, ETextRep: Integer; App: TObject;
  XFunc, XStep: TSqlite3Func; XFinal: TSqlite3FinalFunc): Integer;
begin
  Result := sqlite3_create_function_v2(Db, Name, NArg, ETextRep, App, XFunc, XStep, XFinal, nil);
end;

{ sqlite3_create_function16: the name UTF-16 in the machine's order }
function sqlite3_create_function16(Db: TSqlite3; const Name16: string; NArg, ETextRep: Integer; App: TObject;
  XFunc, XStep: TSqlite3Func; XFinal: TSqlite3FinalFunc): Integer;
begin
  Result := sqlite3_create_function_v2(Db, SqlUtf16To8(Name16, SQLITE_UTF16NATIVE), NArg, ETextRep, App, XFunc,
    XStep, XFinal, nil);
end;

function sqlite3_create_window_function(Db: TSqlite3; const Name: string; NArg, ETextRep: Integer; App: TObject;
  XStep: TSqlite3Func; XFinal, XValue: TSqlite3FinalFunc; XInverse: TSqlite3Func;
  XDestroy: TSqlite3Destroy): Integer;
var
  d: TSqlDb;
  f: TSqlApiFunc;
  xst, xfi, xva, xin: TSqlXFunc;
  xd: TSqlXDestroy;
begin
  d := Db as TSqlDb;
  f := TSqlApiFunc.Create;
  f.App := App;
  f.XStep := XStep;
  f.XFinal := XFinal;
  f.XValue := XValue;
  f.XInverse := XInverse;
  f.XDestroy := XDestroy;
  xst := nil;
  xfi := nil;
  xva := nil;
  xin := nil;
  if Assigned(XStep) then
    xst := @SqlApiStepCall;
  if Assigned(XFinal) then
    xfi := @SqlApiFinalCall;
  if Assigned(XValue) then
    xva := @SqlApiValueCall;
  if Assigned(XInverse) then
    xin := @SqlApiInverseCall;
  xd := nil;
  if Assigned(XDestroy) then
    xd := @SqlApiFuncDestroy;
  SqlDbEnter(d);
  Result := SqlCreateFunctionApi(d, Name, True, NArg, ETextRep, f, nil, xst, xfi, xva, xin, xd);
  SqlDbLeave(d);
end;

function sqlite3_overload_function(Db: TSqlite3; const Name: string; NArg: Integer): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlOverloadFunction(d, Name, NArg);
  SqlDbLeave(d);
end;

function sqlite3_create_collation_v2(Db: TSqlite3; const Name: string; ETextRep: Integer; Arg: TObject;
  XCompare: TSqlite3Compare; XDestroy: TSqlite3Destroy): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlCreateCollationV2(d, Name, ETextRep, Arg, XCompare, XDestroy);
  SqlDbLeave(d);
end;

function sqlite3_create_collation(Db: TSqlite3; const Name: string; ETextRep: Integer; Arg: TObject;
  XCompare: TSqlite3Compare): Integer;
begin
  Result := sqlite3_create_collation_v2(Db, Name, ETextRep, Arg, XCompare, nil);
end;

function sqlite3_create_collation16(Db: TSqlite3; const Name16: string; ETextRep: Integer; Arg: TObject;
  XCompare: TSqlite3Compare): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlCreateCollation16(d, Name16, ETextRep, Arg, XCompare);
  SqlDbLeave(d);
end;

function sqlite3_collation_needed(Db: TSqlite3; Arg: TObject; X: TSqlite3CollNeeded): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlCollationNeeded(d, Arg, X);
  SqlDbLeave(d);
end;

function sqlite3_collation_needed16(Db: TSqlite3; Arg: TObject; X: TSqlite3CollNeeded): Integer;
var
  d: TSqlDb;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlCollationNeeded16(d, Arg, X);
  SqlDbLeave(d);
end;

{ ---- prepared statements (prepare.c, vdbeapi.c) ---- }

{ sqlite3_prepare_v2: the first statement of Sql; Tail the text after
  it; Stmt nil for an empty statement or a comment. The engine counts
  Sql's bytes from 1, and gives the tail's first byte. }
function sqlite3_prepare_v2(Db: TSqlite3; const Sql: string; out Stmt: TSqlite3Stmt; out Tail: string): Integer;
  overload;
var
  d: TSqlDb;
  v: TSqlVdbe;
  t: Integer;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlPrepareV2(d, Sql, 1, -1, v, t);
  SqlDbLeave(d);
  Stmt := v;
  Tail := Copy(Sql, t, Length(Sql) - t + 1);
end;

function sqlite3_prepare_v2(Db: TSqlite3; const Sql: string; out Stmt: TSqlite3Stmt): Integer; overload;
var
  tail: string;
begin
  Result := sqlite3_prepare_v2(Db, Sql, Stmt, tail);
end;

function sqlite3_prepare_v3(Db: TSqlite3; const Sql: string; PrepFlags: Integer; out Stmt: TSqlite3Stmt;
  out Tail: string): Integer; overload;
var
  d: TSqlDb;
  v: TSqlVdbe;
  t: Integer;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlPrepareV3(d, Sql, 1, -1, PrepFlags, v, t);
  SqlDbLeave(d);
  Stmt := v;
  Tail := Copy(Sql, t, Length(Sql) - t + 1);
end;

function sqlite3_prepare_v3(Db: TSqlite3; const Sql: string; PrepFlags: Integer; out Stmt: TSqlite3Stmt): Integer;
  overload;
var
  tail: string;
begin
  Result := sqlite3_prepare_v3(Db, Sql, PrepFlags, Stmt, tail);
end;

{ sqlite3_prepare: the legacy interface, whose statement reports
  SQLITE_SCHEMA rather than preparing itself again }
function sqlite3_prepare(Db: TSqlite3; const Sql: string; out Stmt: TSqlite3Stmt; out Tail: string): Integer;
var
  d: TSqlDb;
  v: TSqlVdbe;
  t: Integer;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  Result := SqlPrepareV1(d, Sql, 1, -1, v, t);
  SqlDbLeave(d);
  Stmt := v;
  Tail := Copy(Sql, t, Length(Sql) - t + 1);
end;

{ sqlite3_prepare16_v2 and _v3 (sqlite3Prepare16): Sql UTF-16 in the
  machine's order, Tail the UTF-16 text after the statement }
function sqlite3_prepare16_v3(Db: TSqlite3; const Sql16: string; PrepFlags: Integer; out Stmt: TSqlite3Stmt;
  out Tail16: string): Integer;
var
  d: TSqlDb;
  v: TSqlVdbe;
  sql8: string;
  t, chars, k: Integer;
begin
  d := Db as TSqlDb;
  SqlDbEnter(d);
  sql8 := SqlUtf16To8(Sql16, SQLITE_UTF16NATIVE);
  Result := SqlPrepareV3(d, sql8, 1, -1, PrepFlags, v, t);
  SqlDbLeave(d);
  Stmt := v;
  { the tail's place in the UTF-16 text: as many characters as the
    UTF-8 text before it has (sqlite3Utf16ByteLen) }
  chars := SqlUtf8CharLen(Copy(sql8, 1, t - 1));
  k := SqlUtf16ByteLen(Sql16, Length(Sql16), chars);
  Tail16 := Copy(Sql16, k + 1, Length(Sql16) - k);
end;

function sqlite3_prepare16_v2(Db: TSqlite3; const Sql16: string; out Stmt: TSqlite3Stmt;
  out Tail16: string): Integer;
begin
  Result := sqlite3_prepare16_v3(Db, Sql16, 0, Stmt, Tail16);
end;

function sqlite3_step(Stmt: TSqlite3Stmt): Integer;
var
  v: TSqlVdbe;
begin
  if Stmt = nil then
  begin
    Result := SqlMisuseError(0);
    Exit;
  end;
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlStep(v);
  SqlDbLeave(v.Db);
end;

function sqlite3_reset(Stmt: TSqlite3Stmt): Integer;
var
  v: TSqlVdbe;
begin
  if Stmt = nil then
  begin
    Result := SQLITE_OK;
    Exit;
  end;
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlReset(v);
  SqlDbLeave(v.Db);
end;

function sqlite3_finalize(Stmt: TSqlite3Stmt): Integer;
var
  v: TSqlVdbe;
  d: TSqlDb;
begin
  if Stmt = nil then
  begin
    Result := SQLITE_OK;
    Exit;
  end;
  v := Stmt as TSqlVdbe;
  d := v.Db;
  SqlDbEnter(d);
  Result := SqlFinalize(v);
  SqlDbLeave(d);
end;

function sqlite3_clear_bindings(Stmt: TSqlite3Stmt): Integer;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlClearBindings(v);
  SqlDbLeave(v.Db);
end;

function sqlite3_sql(Stmt: TSqlite3Stmt): string;
begin
  if Stmt = nil then
    Result := ''
  else
    Result := SqlSql(Stmt as TSqlVdbe);
end;

function sqlite3_stmt_readonly(Stmt: TSqlite3Stmt): Integer;
begin
  if Stmt = nil then
    Result := 1
  else
    Result := Ord(SqlStmtReadonly(Stmt as TSqlVdbe));
end;

function sqlite3_stmt_isexplain(Stmt: TSqlite3Stmt): Integer;
begin
  if Stmt = nil then
    Result := 0
  else
    Result := SqlStmtIsExplain(Stmt as TSqlVdbe);
end;

function sqlite3_stmt_explain(Stmt: TSqlite3Stmt; EMode: Integer): Integer;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlStmtExplain(v, EMode);
  SqlDbLeave(v.Db);
end;

function sqlite3_stmt_busy(Stmt: TSqlite3Stmt): Integer;
begin
  if Stmt = nil then
    Result := 0
  else
    Result := Ord(SqlStmtBusy(Stmt as TSqlVdbe));
end;

function sqlite3_stmt_status(Stmt: TSqlite3Stmt; Op, ResetFlg: Integer): Integer;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlStmtStatus(v, Op, ResetFlg <> 0);
  SqlDbLeave(v.Db);
end;

function sqlite3_db_handle(Stmt: TSqlite3Stmt): TSqlite3;
begin
  if Stmt = nil then
    Result := nil
  else
    Result := SqlDbHandle(Stmt as TSqlVdbe);
end;

{ the connection's prepared statement after Stmt (nil: its first) }
function sqlite3_next_stmt(Db: TSqlite3; Stmt: TSqlite3Stmt): TSqlite3Stmt;
var
  d: TSqlDb;
  v: TSqlVdbe;
begin
  d := Db as TSqlDb;
  v := nil;
  if Stmt <> nil then
    v := Stmt as TSqlVdbe;
  SqlDbEnter(d);
  Result := SqlNextStmt(d, v);
  SqlDbLeave(d);
end;

{ ---- the columns of a row ---- }

function sqlite3_data_count(Stmt: TSqlite3Stmt): Integer;
begin
  if Stmt = nil then
    Result := 0
  else
    Result := SqlDataCount(Stmt as TSqlVdbe);
end;

function sqlite3_column_count(Stmt: TSqlite3Stmt): Integer;
begin
  if Stmt = nil then
    Result := 0
  else
    Result := SqlColumnCount(Stmt as TSqlVdbe);
end;

function sqlite3_column_type(Stmt: TSqlite3Stmt; ICol: Integer): Integer;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlColumnType(v, ICol);
  SqlDbLeave(v.Db);
end;

function sqlite3_column_int(Stmt: TSqlite3Stmt; ICol: Integer): Integer;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlColumnInt(v, ICol);
  SqlDbLeave(v.Db);
end;

function sqlite3_column_int64(Stmt: TSqlite3Stmt; ICol: Integer): Int64;
var
  v: TSqlVdbe;
begin
  v := Stmt as TSqlVdbe;
  SqlDbEnter(v.Db);
  Result := SqlColumnInt64(v, ICol);
  SqlDbLeave(v.Db);
end;

function sqlite3_column_double(Stmt: TSqlite3Stmt; ICol: Integer): Double;
var
