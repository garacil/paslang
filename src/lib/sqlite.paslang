{ SqlMPolyDDCosh: e_cosh.c's polydd_cosh, a polynomial of N double-double
  coefficients at XH + XL by Horner's rule, L the low part of the sum. }
function SqlMPolyDDCosh(XH, XL: Double; N: Integer; const C: array of Integer; var L: Double): Double;
var
  i: Integer;
  ch, cl, e: Double;
begin
  i := N - 1;
  ch := SqlMFastTwoSum(C[2 * i] as Double, L, cl);
  cl := cl + (C[2 * i + 1] as Double);
  Dec(i);
  while i >= 0 do
  begin
    ch := SqlMMulDD2(XH, XL, ch, cl, cl);
    ch := SqlMFastTwoSum(C[2 * i] as Double, ch, e);
    cl := (cl + (C[2 * i + 1] as Double)) + e;
    Dec(i);
  end;
  L := cl;
  Result := ch;
end;

{ SqlMExpAccurate: e_cosh.c's as_exp_accurate, exp(x) for x = t*ln2/2^12
  + dx with 2^(t/2^12) = TH + TL, as a double-double. }
function SqlMExpAccurate(X, T, TH, TL: Double; out L: Double): Double;
const
  Ch: array[0..5] of Integer = (
    $3FF0000000000000, $3A16C16BD194535D, $3FE0000000000000, $BA28259D904FD34F,
    $3FC5555555555555, $3C653E93E9F26E62);
  L2h: Integer = $3F262E42FF000000;
  L2l: Integer = $3D0718432A1B0E26;
  L2ll: Integer = $3999FF0342542FC3;
  F1: Integer = $3FA5555555555555;
  F2: Integer = $3F811111113E93E9;
  F3: Integer = $3F56C16C169400A7;
var
  dx, dxl, dxll, dxh, fl, fh, zh, zl, uh, ul, vh, vl: Double;
begin
  dx := X - (L2h as Double) * T;
  dxl := (L2l as Double) * T;
  dxll := (L2ll as Double) * T + Fma(L2l as Double, T, -dxl);
  dxh := dx + dxl;
  dxl := ((dx - dxh) + dxl) + dxll;
  fl := dxh * ((F1 as Double) + dxh * ((F2 as Double) + dxh * (F3 as Double)));
  fh := SqlMPolyDDCosh(dxh, dxl, 3, Ch[0..5], fl);
  fh := SqlMMulDD2(dxh, dxl, fh, fl, fl);
  fh := SqlMMulDD2(TH, TL, fh, fl, fl);
  zh := TH + fh;
  zl := (TH - zh) + fh;
  uh := zh + TL;
  ul := ((zh - uh) + TL) + zl;
  vh := uh + fl;
  vl := ((uh - vh) + fl) + ul;
  L := vl;
  Result := vh;
end;

function SqlMCoshZero(X: Double): Double;
var
  x2, x2l, y2, y1, y0: Double;
