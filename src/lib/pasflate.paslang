    $C006, $10007, $18007, $20008, $30008, $40009, $60009, $8000A, $C000A, $10000B, $18000B, $20000C, $30000C, $40000D, $60000D, $0, $0);
  FlCodegenOrder: array[0..18] of Integer = (16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15);

