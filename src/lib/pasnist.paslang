{ The NIST curves P-256 and P-384 (FIPS 186-5, SP 800-186; SEC 1 v2) in
  pure paslang, as Go 1.27.3's crypto/internal/fips140 computes them:
  the field arithmetic is fiat-crypto's Montgomery code of
  nistec/fiat/p256_fiat64.go and p384_fiat64.go, translated statement by
  statement by fiat2pas.py (bits.Mul64 is MulHi and the product, Add64
  and Sub64 the carry formulas of math/bits.go, fiat's values x1, x2...
  held in a few words r0, r1... with the Go name beside each line),
  with the wrappers of fiat/p256.go and p384.go
  and the addition chains of p256_invert.go and p384_invert.go; the
  points are projective with the complete formulas of Renes, Costello
  and Batina (eprint 2015/1060), P-384 as nistec/p384.go (a 4-bit window
  read in constant time, 96 tables of the generator) and P-256 as the
  generic path of nistec/p256.go (signed Booth windows of 5 bits, and
  43 affine tables of the generator with windows of 6 bits, which this
  unit works out the first time it needs them instead of embedding
  p256_table.go). ECDH follows fips140/ecdh/ecdh.go and the signature
  check fips140/ecdsa/ecdsa.go verifyGeneric with crypto/ecdsa's
  VerifyASN1 and the DER rules of golang.org/x/crypto/cryptobyte.

  Nothing that touches a private scalar branches on it or indexes
  memory with it: the windows are read from every entry of a table,
  the inversion is an addition chain, and a selection is a mask. The
  arithmetic modulo the order n, which the signature check alone uses
  on public values, is a plain Montgomery multiplication in variable
  time with Fermat's inverse, where Go uses bigmod.

  Keys, points, hashes and signatures are strings of their bytes. A
  point is SEC 1's encoding (2.3.3): 04 x y, or 02 x / 03 x compressed;
  a private key is the scalar's big-endian bytes, 32 or 48 of them. }
unit pasnist;

interface

const
  NistP256 = 0;
  NistP384 = 1;

{ the uncompressed public point (04 x y) of the private scalar Priv,
  as Go's ecdh.NewPrivateKey: '' when Priv is not 32 (P-256) or 48
  (P-384) bytes or not in [1, n-1] }
function NistPublicKey(Curve: Integer; const Priv: string): string;

{ the shared secret of ECDH (SP 800-56A 5.7.1.2), the x-coordinate of
  Priv times PeerPublic, as Go's ecdh.ECDH: False, Shared '', for a
  private scalar NistPublicKey refuses, a peer point that is not
  uncompressed, not on the curve or the infinity, or a result at the
  infinity }
function NistEcdh(Curve: Integer; const Priv, PeerPublic: string; out Shared: string): Boolean;

{ whether (R, S), big-endian, is a signature of Hash under PublicKey
  (uncompressed or compressed), as Go's ecdsa.Verify (FIPS 186-5
  6.4.2): R and S in [1, n-1], at most the order's size in bytes, Hash
  not empty and cut to the order's bit length }
function NistEcdsaVerify(Curve: Integer; const PublicKey, Hash, R, S: string): Boolean;

{ the same with the signature in DER, SEQUENCE (INTEGER r, INTEGER s),
  read as strictly as Go's crypto/ecdsa VerifyASN1: minimal lengths and
  integers, no negative, nothing after it }
function NistEcdsaVerifyAsn1(Curve: Integer; const PublicKey, Hash, Sig: string): Boolean;

{ whether Point is the encoding of a point of the curve other than the
  infinity, uncompressed or compressed, as Go's ecdsa.NewPublicKey
  accepts it }
function NistPointValid(Curve: Integer; const Point: string): Boolean;

implementation

const
  P256Len = 32;
  P256Limbs = 4;
  P384Len = 48;
  P384Limbs = 6;

type
  { a field element, little-endian limbs, in the Montgomery domain
    (fiat's MontgomeryDomainFieldElement) or not, as each routine says }
  TP256Fe = array[0..3] of Integer;
  TP384Fe = array[0..5] of Integer;
  { the little-endian bytes fiat's ToBytes and FromBytes take }
  TP256Raw = array[0..31] of Byte;
  TP384Raw = array[0..47] of Byte;

  { a projective point (X:Y:Z), x = X/Z and y = Y/Z, the infinity
    (0:1:0) }
  TP256Point = record
    X, Y, Z: TP256Fe;
  end;
  TP384Point = record
    X, Y, Z: TP384Fe;
  end;
  { an affine point of p256.go, never the infinity }
  TP256Affine = record
    X, Y: TP256Fe;
  end;
  { P and its multiples up to [16]P (p256.go p256Table) or [15]P
    (p384.go p384Table), at index k - 1 }
  TP256Table = array[0..15] of TP256Point;
  TP384Table = array[0..14] of TP384Point;
  { [1]G to [32]G of a base, affine (p256.go p256AffineTable) }
  TP256AffineTable = array[0..31] of TP256Affine;
  { a P-256 scalar in [0, n-1], little-endian limbs (p256OrdElement) }
  TP256Ord = array[0..3] of Integer;

  { a number modulo the order n, little-endian limbs, L of them used }
  TNat = array[0..5] of Integer;
  TNatWide = array[0..7] of Integer;
  { the order n of a curve and what its Montgomery arithmetic needs }
  TOrder = record
    L: Integer;            { limbs: 4 or 6 }
    N: TNat;               { n }
    NMinus2: TNat;         { n - 2, Fermat's exponent }
    RR: TNat;              { R^2 mod n, R = 2^(64 L) }
    N0: Integer;           { -1/n mod 2^64 }
  end;

var
  { b of y^2 = x^3 - 3x + b, Montgomery domain }
  P256B: TP256Fe;
  P384B: TP384Fe;
  { the generators }
  P256G: TP256Point;
  P384G: TP384Point;
  { the precomputed multiples of G, made the first time they are
    needed (p256.go p256GeneratorTables, p384.go generatorTable) }
  P256GenTables: array[0..42] of TP256AffineTable;
  P384GenTables: array[0..95] of TP384Table;
  P256TablesOnce, P384TablesOnce: once;
  { the orders }
  Ord256, Ord384: TOrder;
  NistInitOk: Boolean;

{ ---- generated by fiat2pas.py from p256_fiat64.go: begin ---- }

{ P256Mul, as fiat-crypto's p256Mul in Go's fiat/p256_fiat64.go }
procedure P256Mul(var Out1: TP256Fe; const Arg1, Arg2: TP256Fe);
var
