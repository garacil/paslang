  r15: Integer;
begin
  r0 := arg1[1];  { x1 }
  r1 := arg1[2];  { x2 }
  r2 := arg1[3];  { x3 }
  r3 := arg1[0];  { x4 }
  r4 := MulHi(r3, arg2[3]);  { x6 }
  r5 := r3 * arg2[3];  { x5 }
  r6 := MulHi(r3, arg2[2]);  { x8 }
