  P256Mul(t1, P1.Y, P2.Y);       { t1 := Y1 * Y2 }
  P256Mul(t2, P1.Z, P2.Z);       { t2 := Z1 * Z2 }
  P256Add(t3, P1.X, P1.Y);       { t3 := X1 + Y1 }
  P256Add(t4, P2.X, P2.Y);       { t4 := X2 + Y2 }
  P256Mul(t3, t3, t4);           { t3 := t3 * t4 }
  P256Add(t4, t0, t1);           { t4 := t0 + t1 }
  P256Sub(t3, t3, t4);           { t3 := t3 - t4 }
  P256Add(t4, P1.Y, P1.Z);       { t4 := Y1 + Z1 }
  P256Add(x3, P2.Y, P2.Z);       { X3 := Y2 + Z2 }
  P256Mul(t4, t4, x3);           { t4 := t4 * X3 }
  P256Add(x3, t1, t2);           { X3 := t1 + t2 }
  P256Sub(t4, t4, x3);           { t4 := t4 - X3 }
  P256Add(x3, P1.X, P1.Z);       { X3 := X1 + Z1 }
  P256Add(y3, P2.X, P2.Z);       { Y3 := X2 + Z2 }
  P256Mul(x3, x3, y3);           { X3 := X3 * Y3 }
  P256Add(y3, t0, t2);           { Y3 := t0 + t2 }
  P256Sub(y3, x3, y3);           { Y3 := X3 - Y3 }
  P256Mul(z3, P256B, t2);        { Z3 := b * t2 }
  P256Sub(x3, y3, z3);           { X3 := Y3 - Z3 }
  P256Add(z3, x3, x3);           { Z3 := X3 + X3 }
  P256Add(x3, x3, z3);           { X3 := X3 + Z3 }
  P256Sub(z3, t1, x3);           { Z3 := t1 - X3 }
  P256Add(x3, t1, x3);           { X3 := t1 + X3 }
  P256Mul(y3, P256B, y3);        { Y3 := b * Y3 }
  P256Add(t1, t2, t2);           { t1 := t2 + t2 }
  P256Add(t2, t1, t2);           { t2 := t1 + t2 }
  P256Sub(y3, y3, t2);           { Y3 := Y3 - t2 }
  P256Sub(y3, y3, t0);           { Y3 := Y3 - t0 }
  P256Add(t1, y3, y3);           { t1 := Y3 + Y3 }
  P256Add(y3, t1, y3);           { Y3 := t1 + Y3 }
  P256Add(t1, t0, t0);           { t1 := t0 + t0 }
  P256Add(t0, t1, t0);           { t0 := t1 + t0 }
  P256Sub(t0, t0, t2);           { t0 := t0 - t2 }
  P256Mul(t1, t4, y3);           { t1 := t4 * Y3 }
  P256Mul(t2, t0, y3);           { t2 := t0 * Y3 }
  P256Mul(y3, x3, z3);           { Y3 := X3 * Z3 }
  P256Add(y3, y3, t2);           { Y3 := Y3 + t2 }
  P256Mul(x3, t3, x3);           { X3 := t3 * X3 }
  P256Sub(x3, x3, t1);           { X3 := X3 - t1 }
  P256Mul(z3, t4, z3);           { Z3 := t4 * Z3 }
  P256Mul(t1, t3, t0);           { t1 := t3 * t0 }
  P256Add(z3, z3, t1);           { Z3 := Z3 + t1 }
  Q.X := x3;
  Q.Y := y3;
  Q.Z := z3;
end;

{ Q = P + P by the complete doubling formula for a = -3 of the same
  paper, A.2, as Go's p256.go Double; Q may be P }
procedure P256PointDouble(var Q: TP256Point; const P: TP256Point);
var
  t0, t1, t2, t3, x3, y3, z3: TP256Fe;
begin
  P256Square(t0, P.X);           { t0 := X ^ 2 }
  P256Square(t1, P.Y);           { t1 := Y ^ 2 }
  P256Square(t2, P.Z);           { t2 := Z ^ 2 }
  P256Mul(t3, P.X, P.Y);         { t3 := X * Y }
  P256Add(t3, t3, t3);           { t3 := t3 + t3 }
  P256Mul(z3, P.X, P.Z);         { Z3 := X * Z }
  P256Add(z3, z3, z3);           { Z3 := Z3 + Z3 }
  P256Mul(y3, P256B, t2);        { Y3 := b * t2 }
  P256Sub(y3, y3, z3);           { Y3 := Y3 - Z3 }
  P256Add(x3, y3, y3);           { X3 := Y3 + Y3 }
  P256Add(y3, x3, y3);           { Y3 := X3 + Y3 }
  P256Sub(x3, t1, y3);           { X3 := t1 - Y3 }
  P256Add(y3, t1, y3);           { Y3 := t1 + Y3 }
  P256Mul(y3, x3, y3);           { Y3 := X3 * Y3 }
  P256Mul(x3, x3, t3);           { X3 := X3 * t3 }
  P256Add(t3, t2, t2);           { t3 := t2 + t2 }
  P256Add(t2, t2, t3);           { t2 := t2 + t3 }
  P256Mul(z3, P256B, z3);        { Z3 := b * Z3 }
  P256Sub(z3, z3, t2);           { Z3 := Z3 - t2 }
  P256Sub(z3, z3, t0);           { Z3 := Z3 - t0 }
  P256Add(t3, z3, z3);           { t3 := Z3 + Z3 }
  P256Add(z3, z3, t3);           { Z3 := Z3 + t3 }
  P256Add(t3, t0, t0);           { t3 := t0 + t0 }
  P256Add(t0, t3, t0);           { t0 := t3 + t0 }
  P256Sub(t0, t0, t2);           { t0 := t0 - t2 }
  P256Mul(t0, t0, z3);           { t0 := t0 * Z3 }
  P256Add(y3, y3, t0);           { Y3 := Y3 + t0 }
  P256Mul(t0, P.Y, P.Z);         { t0 := Y * Z }
  P256Add(t0, t0, t0);           { t0 := t0 + t0 }
  P256Mul(z3, t0, z3);           { Z3 := t0 * Z3 }
  P256Sub(x3, x3, z3);           { X3 := X3 - Z3 }
  P256Mul(z3, t0, t1);           { Z3 := t0 * t1 }
  P256Add(z3, z3, z3);           { Z3 := Z3 + Z3 }
  P256Add(z3, z3, z3);           { Z3 := Z3 + Z3 }
  Q.X := x3;
  Q.Y := y3;
  Q.Z := z3;
end;

{ Q = P1 when Choice = 1, P2 when Choice = 0, as Go's p256.go Select }
procedure P256PointSelect(var Q: TP256Point; const P1, P2: TP256Point; Choice: Integer);
begin
  P256FeSelect(Q.X, P1.X, P2.X, Choice);
  P256FeSelect(Q.Y, P1.Y, P2.Y, Choice);
  P256FeSelect(Q.Z, P1.Z, P2.Z, Choice);
end;


{ ---- P-384 field elements: Go's fiat/p384.go ---- }

{ the 48-byte big-endian encoding of E, as Go's fiat/p384.go bytes: out
  of the Montgomery domain, to little-endian bytes, the order reversed
  (p384InvertEndianness) }
procedure P384FeBytes(const E: TP384Fe; var B: TP384Raw);
var
  tmp: TP384Fe;
  i: Integer;
  t: Byte;
begin
  P384FromMontgomery(tmp, E);
  P384ToBytes(B, tmp);
  for i := 0 to P384Len div 2 - 1 do
  begin
    t := B[i];
    B[i] := B[P384Len - 1 - i];
    B[P384Len - 1 - i] := t;
  end;
end;

{ 1 when E = T, else 0, as Go's fiat/p384.go Equal: the encodings
  compared in constant time }
function P384FeEqual(const E, T: TP384Fe): Integer;
var
  a, b: TP384Raw;
  i, v: Integer;
begin
  P384FeBytes(E, a);
  P384FeBytes(T, b);
  v := 0;
  for i := 0 to P384Len - 1 do
    v := v or (a[i] xor b[i]);
  Result := CtByteEq(v, 0);
end;

{ 1 when E = 0, else 0, as Go's fiat/p384.go IsZero }
function P384FeIsZero(const E: TP384Fe): Integer;
var
  a: TP384Raw;
  i, v: Integer;
begin
  P384FeBytes(E, a);
  v := 0;
  for i := 0 to P384Len - 1 do
    v := v or a[i];
  Result := CtByteEq(v, 0);
end;

{ E from the 48 big-endian bytes of S from position At, as Go's
  fiat/p384.go SetBytes: False, E unchanged, when they are short or
  encode p or more (compared with the encoding of -1 in constant
  time) }
function P384FeSetBytes(var E: TP384Fe; const S: string; At: Integer): Boolean;
var
  zero, one, minusOne, tmp: TP384Fe;
  minusOneEncoding, inb: TP384Raw;
  i: Integer;
  t: Byte;
begin
  Result := False;
  if (At < 1) or (Length(S) - At + 1 < P384Len) then
    Exit;
  for i := 0 to P384Limbs - 1 do
    zero[i] := 0;
  P384SetOne(one);
  P384Sub(minusOne, zero, one);
  P384FeBytes(minusOne, minusOneEncoding);
  for i := 0 to P384Len - 1 do
    inb[i] := Byte(Ord(S[At + i]));
  if CtLessOrEqBytes(@inb[0], @minusOneEncoding[0], P384Len) = 0 then
    Exit;
  for i := 0 to P384Len div 2 - 1 do
  begin
    t := inb[i];
    inb[i] := inb[P384Len - 1 - i];
    inb[P384Len - 1 - i] := t;
  end;
  P384FromBytes(tmp, inb);
  P384ToMontgomery(E, tmp);
  Result := True;
end;

{ V = A when Choice = 1, B when Choice = 0, as Go's fiat/p384.go Select }
procedure P384FeSelect(var V: TP384Fe; const A, B: TP384Fe; Choice: Integer);
begin
  P384Selectznz(V, Choice, B, A);
end;

{ E = 0 }
procedure P384FeZero(var E: TP384Fe);
var
  i: Integer;
begin
  for i := 0 to P384Limbs - 1 do
    E[i] := 0;
end;

{ ---- P-384 points: Go's p384.go ---- }

{ the point at infinity (0:1:0), as Go's p384.go NewP384Point }
procedure P384SetInfinity(var P: TP384Point);
begin
  P384FeZero(P.X);
  P384SetOne(P.Y);
  P384FeZero(P.Z);
end;

{ Y2 = X^3 - 3X + b, as Go's p384.go p384Polynomial; Y2 and X are not
  the same variable }
procedure P384Polynomial(var Y2: TP384Fe; const X: TP384Fe);
var
  threeX: TP384Fe;
begin
  P384Square(Y2, X);
  P384Mul(Y2, Y2, X);
  P384Add(threeX, X, X);
  P384Add(threeX, threeX, X);
  P384Sub(Y2, Y2, threeX);
  P384Add(Y2, Y2, P384B);
end;

{ whether y^2 = x^3 - 3x + b, as Go's p384.go p384CheckOnCurve }
function P384CheckOnCurve(const X, Y: TP384Fe): Boolean;
var
  rhs, lhs: TP384Fe;
begin
  P384Polynomial(rhs, X);
  P384Square(lhs, Y);
  Result := P384FeEqual(rhs, lhs) = 1;
end;

{ E = a square root of X, as Go's p384.go p384Sqrt: False, E unchanged,
  when X is not a square; E and X may be the same variable }
function P384Sqrt(var E: TP384Fe; const X: TP384Fe): Boolean;
var
  candidate, square: TP384Fe;
begin
  P384SqrtCandidate(candidate, X);
  P384Square(square, candidate);
  if P384FeEqual(square, X) <> 1 then
    Exit(False);
  E := candidate;
  Result := True;
end;

{ P from its SEC 1 (2.3.4) encoding, as Go's p384.go SetBytes: the
  infinity 00, the uncompressed 04 x y and the compressed 02 x or 03 x,
  the coordinates below p and the point on the curve; False, P
  unchanged, for anything else }
function P384PointSetBytes(var P: TP384Point; const B: string): Boolean;
var
  x, y, otherRoot: TP384Fe;
  yb: TP384Raw;
  choice: Integer;
begin
  Result := False;
  if (Length(B) = 1) and (B[1] = #0) then
  begin
    P384SetInfinity(P);
    Exit(True);
  end;
  if (Length(B) = 1 + 2 * P384Len) and (B[1] = #4) then
  begin
    if not P384FeSetBytes(x, B, 2) then
      Exit;
    if not P384FeSetBytes(y, B, 2 + P384Len) then
      Exit;
    if not P384CheckOnCurve(x, y) then
      Exit;
    P.X := x;
    P.Y := y;
    P384SetOne(P.Z);
    Exit(True);
  end;
  if (Length(B) = 1 + P384Len) and ((B[1] = #2) or (B[1] = #3)) then
  begin
    if not P384FeSetBytes(x, B, 2) then
      Exit;
    { y^2 = x^3 - 3x + b }
    P384Polynomial(y, x);
    if not P384Sqrt(y, y) then
      Exit;
    { the root whose least significant bit the type byte names }
    P384FeZero(otherRoot);
    P384Sub(otherRoot, otherRoot, y);
    P384FeBytes(y, yb);
    choice := (yb[P384Len - 1] and 1) xor (Ord(B[1]) and 1);
    P384FeSelect(y, otherRoot, y, choice);
    P.X := x;
    P.Y := y;
    P384SetOne(P.Z);
    Exit(True);
  end;
end;

{ the uncompressed SEC 1 (2.3.3) encoding of P, 04 x y, or 00 for the
  infinity, as Go's p384.go Bytes }
function P384PointBytes(const P: TP384Point): string;
var
  zinv, x, y: TP384Fe;
  xb, yb: TP384Raw;
  i: Integer;
begin
  if P384FeIsZero(P.Z) = 1 then
  begin
    Result := #0;
    Exit;
  end;
  P384FeInvert(zinv, P.Z);
  P384Mul(x, P.X, zinv);
  P384Mul(y, P.Y, zinv);
  P384FeBytes(x, xb);
  P384FeBytes(y, yb);
  SetLength(Result, 1 + 2 * P384Len);
  Result[1] := #4;
  for i := 0 to P384Len - 1 do
  begin
    Result[2 + i] := Chr(xb[i]);
    Result[2 + P384Len + i] := Chr(yb[i]);
  end;
end;

{ the x-coordinate of P (SEC 1 2.3.5), as Go's p384.go BytesX: False
  for the infinity }
function P384PointBytesX(const P: TP384Point; out X: string): Boolean;
var
  zinv, x1: TP384Fe;
  xb: TP384Raw;
  i: Integer;
begin
  X := '';
  if P384FeIsZero(P.Z) = 1 then
    Exit(False);
  P384FeInvert(zinv, P.Z);
  P384Mul(x1, P.X, zinv);
  P384FeBytes(x1, xb);
  SetLength(X, P384Len);
  for i := 0 to P384Len - 1 do
    X[1 + i] := Chr(xb[i]);
  Result := True;
end;

{ Q = P1 + P2 by the complete addition formula for a = -3 of Renes,
  Costello and Batina, "Complete addition formulas for prime order
  elliptic curves" (eprint 2015/1060) A.2, as Go's p384.go Add; Q may be
  P1 or P2 }
procedure P384PointAdd(var Q: TP384Point; const P1, P2: TP384Point);
var
  t0, t1, t2, t3, t4, x3, y3, z3: TP384Fe;
begin
  P384Mul(t0, P1.X, P2.X);       { t0 := X1 * X2 }
  P384Mul(t1, P1.Y, P2.Y);       { t1 := Y1 * Y2 }
  P384Mul(t2, P1.Z, P2.Z);       { t2 := Z1 * Z2 }
  P384Add(t3, P1.X, P1.Y);       { t3 := X1 + Y1 }
  P384Add(t4, P2.X, P2.Y);       { t4 := X2 + Y2 }
  P384Mul(t3, t3, t4);           { t3 := t3 * t4 }
  P384Add(t4, t0, t1);           { t4 := t0 + t1 }
  P384Sub(t3, t3, t4);           { t3 := t3 - t4 }
  P384Add(t4, P1.Y, P1.Z);       { t4 := Y1 + Z1 }
  P384Add(x3, P2.Y, P2.Z);       { X3 := Y2 + Z2 }
  P384Mul(t4, t4, x3);           { t4 := t4 * X3 }
  P384Add(x3, t1, t2);           { X3 := t1 + t2 }
  P384Sub(t4, t4, x3);           { t4 := t4 - X3 }
  P384Add(x3, P1.X, P1.Z);       { X3 := X1 + Z1 }
  P384Add(y3, P2.X, P2.Z);       { Y3 := X2 + Z2 }
  P384Mul(x3, x3, y3);           { X3 := X3 * Y3 }
  P384Add(y3, t0, t2);           { Y3 := t0 + t2 }
  P384Sub(y3, x3, y3);           { Y3 := X3 - Y3 }
  P384Mul(z3, P384B, t2);        { Z3 := b * t2 }
  P384Sub(x3, y3, z3);           { X3 := Y3 - Z3 }
  P384Add(z3, x3, x3);           { Z3 := X3 + X3 }
  P384Add(x3, x3, z3);           { X3 := X3 + Z3 }
  P384Sub(z3, t1, x3);           { Z3 := t1 - X3 }
  P384Add(x3, t1, x3);           { X3 := t1 + X3 }
  P384Mul(y3, P384B, y3);        { Y3 := b * Y3 }
  P384Add(t1, t2, t2);           { t1 := t2 + t2 }
  P384Add(t2, t1, t2);           { t2 := t1 + t2 }
  P384Sub(y3, y3, t2);           { Y3 := Y3 - t2 }
  P384Sub(y3, y3, t0);           { Y3 := Y3 - t0 }
  P384Add(t1, y3, y3);           { t1 := Y3 + Y3 }
  P384Add(y3, t1, y3);           { Y3 := t1 + Y3 }
  P384Add(t1, t0, t0);           { t1 := t0 + t0 }
  P384Add(t0, t1, t0);           { t0 := t1 + t0 }
  P384Sub(t0, t0, t2);           { t0 := t0 - t2 }
  P384Mul(t1, t4, y3);           { t1 := t4 * Y3 }
  P384Mul(t2, t0, y3);           { t2 := t0 * Y3 }
  P384Mul(y3, x3, z3);           { Y3 := X3 * Z3 }
  P384Add(y3, y3, t2);           { Y3 := Y3 + t2 }
  P384Mul(x3, t3, x3);           { X3 := t3 * X3 }
  P384Sub(x3, x3, t1);           { X3 := X3 - t1 }
  P384Mul(z3, t4, z3);           { Z3 := t4 * Z3 }
  P384Mul(t1, t3, t0);           { t1 := t3 * t0 }
  P384Add(z3, z3, t1);           { Z3 := Z3 + t1 }
  Q.X := x3;
  Q.Y := y3;
  Q.Z := z3;
end;

{ Q = P + P by the complete doubling formula for a = -3 of the same
  paper, A.2, as Go's p384.go Double; Q may be P }
procedure P384PointDouble(var Q: TP384Point; const P: TP384Point);
var
  t0, t1, t2, t3, x3, y3, z3: TP384Fe;
begin
  P384Square(t0, P.X);           { t0 := X ^ 2 }
  P384Square(t1, P.Y);           { t1 := Y ^ 2 }
  P384Square(t2, P.Z);           { t2 := Z ^ 2 }
  P384Mul(t3, P.X, P.Y);         { t3 := X * Y }
  P384Add(t3, t3, t3);           { t3 := t3 + t3 }
  P384Mul(z3, P.X, P.Z);         { Z3 := X * Z }
  P384Add(z3, z3, z3);           { Z3 := Z3 + Z3 }
  P384Mul(y3, P384B, t2);        { Y3 := b * t2 }
  P384Sub(y3, y3, z3);           { Y3 := Y3 - Z3 }
  P384Add(x3, y3, y3);           { X3 := Y3 + Y3 }
  P384Add(y3, x3, y3);           { Y3 := X3 + Y3 }
  P384Sub(x3, t1, y3);           { X3 := t1 - Y3 }
  P384Add(y3, t1, y3);           { Y3 := t1 + Y3 }
  P384Mul(y3, x3, y3);           { Y3 := X3 * Y3 }
  P384Mul(x3, x3, t3);           { X3 := X3 * t3 }
  P384Add(t3, t2, t2);           { t3 := t2 + t2 }
  P384Add(t2, t2, t3);           { t2 := t2 + t3 }
  P384Mul(z3, P384B, z3);        { Z3 := b * Z3 }
  P384Sub(z3, z3, t2);           { Z3 := Z3 - t2 }
  P384Sub(z3, z3, t0);           { Z3 := Z3 - t0 }
  P384Add(t3, z3, z3);           { t3 := Z3 + Z3 }
  P384Add(z3, z3, t3);           { Z3 := Z3 + t3 }
  P384Add(t3, t0, t0);           { t3 := t0 + t0 }
  P384Add(t0, t3, t0);           { t0 := t3 + t0 }
  P384Sub(t0, t0, t2);           { t0 := t0 - t2 }
  P384Mul(t0, t0, z3);           { t0 := t0 * Z3 }
  P384Add(y3, y3, t0);           { Y3 := Y3 + t0 }
  P384Mul(t0, P.Y, P.Z);         { t0 := Y * Z }
  P384Add(t0, t0, t0);           { t0 := t0 + t0 }
  P384Mul(z3, t0, z3);           { Z3 := t0 * Z3 }
  P384Sub(x3, x3, z3);           { X3 := X3 - Z3 }
  P384Mul(z3, t0, t1);           { Z3 := t0 * t1 }
  P384Add(z3, z3, z3);           { Z3 := Z3 + Z3 }
  P384Add(z3, z3, z3);           { Z3 := Z3 + Z3 }
  Q.X := x3;
  Q.Y := y3;
  Q.Z := z3;
end;

{ Q = P1 when Choice = 1, P2 when Choice = 0, as Go's p384.go Select }
procedure P384PointSelect(var Q: TP384Point; const P1, P2: TP384Point; Choice: Integer);
begin
  P384FeSelect(Q.X, P1.X, P2.X, Choice);
  P384FeSelect(Q.Y, P1.Y, P2.Y, Choice);
  P384FeSelect(Q.Z, P1.Z, P2.Z, Choice);
end;


{ ---- P-384 scalar multiplication: Go's p384.go ---- }

{ P = [N]P of the table, N in [0, 15], as Go's p384.go p384Table.Select:
  every entry is read, the one wanted kept by a mask }
procedure P384TableSelect(const Table: TP384Table; var P: TP384Point; N: Integer);
var
  i, choice: Integer;
begin
  P384SetInfinity(P);
  for i := 1 to 15 do
  begin
    choice := CtByteEq(i, N);
    P384PointSelect(P, Table[i - 1], P, choice);
  end;
end;

{ P = Scalar * Q, Scalar big-endian of any length, as Go's p384.go
  ScalarMult: a table of [1]Q to [15]Q and a window of four bits, four
  doublings and one addition of a selected entry a window; P may be Q }
procedure P384ScalarMult(var P: TP384Point; const Q: TP384Point; const Scalar: string);
var
  table: TP384Table;
  t: TP384Point;
  i, b, windowValue: Integer;
begin
  table[0] := Q;
  i := 1;
  while i < 15 do
  begin
    P384PointDouble(table[i], table[i div 2]);
    P384PointAdd(table[i + 1], table[i], Q);
    i := i + 2;
  end;
  P384SetInfinity(t);
  P384SetInfinity(P);
  for i := 1 to Length(Scalar) do
  begin
    b := Ord(Scalar[i]);
    { no doubling the first time: P is the infinity }
    if i <> 1 then
    begin
      P384PointDouble(P, P);
      P384PointDouble(P, P);
      P384PointDouble(P, P);
      P384PointDouble(P, P);
    end;
    windowValue := b shr 4;
    P384TableSelect(table, t, windowValue);
    P384PointAdd(P, P, t);
    P384PointDouble(P, P);
    P384PointDouble(P, P);
    P384PointDouble(P, P);
    P384PointDouble(P, P);
    windowValue := b and 15;
    P384TableSelect(table, t, windowValue);
    P384PointAdd(P, P, t);
  end;
end;

{ the tables of p384.go generatorTable: table i holds [1]B to [15]B for
  B = [2^(4 i)]G }
procedure P384GenTablesInit;
var
  base: TP384Point;
  i, j: Integer;
begin
  base := P384G;
  for i := 0 to P384Len * 2 - 1 do
  begin
    P384GenTables[i][0] := base;
    for j := 1 to 14 do
      P384PointAdd(P384GenTables[i][j], P384GenTables[i][j - 1], base);
    P384PointDouble(base, base);
    P384PointDouble(base, base);
    P384PointDouble(base, base);
    P384PointDouble(base, base);
  end;
end;

{ P = Scalar * G, Scalar 48 big-endian bytes (the caller checks), as
  Go's p384.go ScalarBaseMult: the window of four bits with the
  doublings taken by the tables, one addition a window }
procedure P384ScalarBaseMult(var P: TP384Point; const Scalar: string);
var
  t: TP384Point;
  i, b, tableIndex, windowValue: Integer;
begin
  once P384TablesOnce do
    P384GenTablesInit;
  P384SetInfinity(t);
  P384SetInfinity(P);
  tableIndex := P384Len * 2 - 1;
  for i := 1 to Length(Scalar) do
  begin
    b := Ord(Scalar[i]);
    windowValue := b shr 4;
    P384TableSelect(P384GenTables[tableIndex], t, windowValue);
    P384PointAdd(P, P, t);
    tableIndex := tableIndex - 1;
    windowValue := b and 15;
    P384TableSelect(P384GenTables[tableIndex], t, windowValue);
    P384PointAdd(P, P, t);
    tableIndex := tableIndex - 1;
  end;
end;

{ ---- P-256 scalar multiplication: Go's p256.go, the generic path ---- }

{ Q = P1 + P2 for an affine P2 when Infinity = 0, Q = P1 when
  Infinity = 1, by the complete mixed addition for a = -3 of Renes,
  Costello and Batina, Algorithm 5, as Go's p256.go AddAffine; Q may
  be P1 }
procedure P256PointAddAffine(var Q: TP256Point; const P1: TP256Point; const P2: TP256Affine; Infinity: Integer);
var
  t0, t1, t2, t3, t4, x3, y3, z3: TP256Fe;
begin
  P256Mul(t0, P1.X, P2.X);       { t0 <- X1 * X2 }
  P256Mul(t1, P1.Y, P2.Y);       { t1 <- Y1 * Y2 }
  P256Add(t3, P2.X, P2.Y);       { t3 <- X2 + Y2 }
  P256Add(t4, P1.X, P1.Y);       { t4 <- X1 + Y1 }
  P256Mul(t3, t3, t4);           { t3 <- t3 * t4 }
  P256Add(t4, t0, t1);           { t4 <- t0 + t1 }
  P256Sub(t3, t3, t4);           { t3 <- t3 - t4 }
  P256Mul(t4, P2.Y, P1.Z);       { t4 <- Y2 * Z1 }
  P256Add(t4, t4, P1.Y);         { t4 <- t4 + Y1 }
  P256Mul(y3, P2.X, P1.Z);       { Y3 <- X2 * Z1 }
  P256Add(y3, y3, P1.X);         { Y3 <- Y3 + X1 }
  P256Mul(z3, P256B, P1.Z);      { Z3 <- b * Z1 }
  P256Sub(x3, y3, z3);           { X3 <- Y3 - Z3 }
  P256Add(z3, x3, x3);           { Z3 <- X3 + X3 }
  P256Add(x3, x3, z3);           { X3 <- X3 + Z3 }
  P256Sub(z3, t1, x3);           { Z3 <- t1 - X3 }
  P256Add(x3, t1, x3);           { X3 <- t1 + X3 }
  P256Mul(y3, P256B, y3);        { Y3 <- b * Y3 }
  P256Add(t1, P1.Z, P1.Z);       { t1 <- Z1 + Z1 }
  P256Add(t2, t1, P1.Z);         { t2 <- t1 + Z1 }
  P256Sub(y3, y3, t2);           { Y3 <- Y3 - t2 }
  P256Sub(y3, y3, t0);           { Y3 <- Y3 - t0 }
  P256Add(t1, y3, y3);           { t1 <- Y3 + Y3 }
  P256Add(y3, t1, y3);           { Y3 <- t1 + Y3 }
  P256Add(t1, t0, t0);           { t1 <- t0 + t0 }
  P256Add(t0, t1, t0);           { t0 <- t1 + t0 }
  P256Sub(t0, t0, t2);           { t0 <- t0 - t2 }
  P256Mul(t1, t4, y3);           { t1 <- t4 * Y3 }
  P256Mul(t2, t0, y3);           { t2 <- t0 * Y3 }
  P256Mul(y3, x3, z3);           { Y3 <- X3 * Z3 }
  P256Add(y3, y3, t2);           { Y3 <- Y3 + t2 }
  P256Mul(x3, t3, x3);           { X3 <- t3 * X3 }
  P256Sub(x3, x3, t1);           { X3 <- X3 - t1 }
  P256Mul(z3, t4, z3);           { Z3 <- t4 * Z3 }
  P256Mul(t1, t3, t0);           { t1 <- t3 * t0 }
  P256Add(z3, z3, t1);           { Z3 <- Z3 + t1 }
  P256FeSelect(Q.X, P1.X, x3, Infinity);
  P256FeSelect(Q.Y, P1.Y, y3, Infinity);
  P256FeSelect(Q.Z, P1.Z, z3, Infinity);
end;

{ S from the 32 big-endian bytes of X, reduced below n by one
  subtraction kept or dropped by a mask, as Go's p256.go
  p256OrdElement.SetBytes (2n > 2^256) }
procedure P256OrdSetBytes(var S: TP256Ord; const X: string);
var
  t0, t1, t2, t3, b, tMask: Integer;
begin
  S[0] := LoadBE64(@X[25]);
  S[1] := LoadBE64(@X[17]);
  S[2] := LoadBE64(@X[9]);
  S[3] := LoadBE64(@X[1]);
  t0 := SubBorrow(S[0], $F3B9CAC2FC632551, 0, b);
  t1 := SubBorrow(S[1], $BCE6FAADA7179E84, b, b);
  t2 := SubBorrow(S[2], $FFFFFFFFFFFFFFFF, b, b);
  t3 := SubBorrow(S[3], $FFFFFFFF00000000, b, b);
  tMask := b - 1;    { zero when the subtraction underflowed }
  S[0] := S[0] xor ((t0 xor S[0]) and tMask);
  S[1] := S[1] xor ((t1 xor S[1]) and tMask);
  S[2] := S[2] xor ((t2 xor S[2]) and tMask);
  S[3] := S[3] xor ((t3 xor S[3]) and tMask);
end;

{ the 64 least significant bits of S shr N, N in [0, 255], as Go's
  p256.go p256OrdElement.Rsh; N is public (the window's place). Go's
  shift by 64 gives 0, so the limb above is shifted in only when N is
  not a multiple of 64 }
function P256OrdRsh(const S: TP256Ord; N: Integer): Integer;
var
  i: Integer;
begin
  i := N div 64;
  N := N mod 64;
  Result := S[i] shr N;
  if (i + 1 < 4) and (N <> 0) then
    Result := Result or (S[i + 1] shl (64 - N));
end;

{ the signed digit of a window of 5 bits and the bit below it, as Go's
  p256.go boothW5: Sel in [0, 16], Sign 1 for a negative digit }
procedure P256BoothW5(V: Integer; var Sel, Sign: Integer);
var
  s, d: Integer;
begin
  s := not ((V shr 5) - 1);
  d := (1 shl 6) - V - 1;
  d := (d and s) or (V and (not s));
  d := (d shr 1) + (d and 1);
  Sel := d and $FF;
  Sign := s and 1;
end;

{ the same for a window of 6 bits, as Go's p256.go boothW6: Sel in
  [0, 32] }
procedure P256BoothW6(V: Integer; var Sel, Sign: Integer);
var
  s, d: Integer;
begin
  s := not ((V shr 6) - 1);
  d := (1 shl 7) - V - 1;
  d := (d and s) or (V and (not s));
  d := (d shr 1) + (d and 1);
  Sel := d and $FF;
  Sign := s and 1;
end;

{ P = [N]P of the table, N in [0, 16], the infinity for 0, as Go's
  p256.go p256Table.Select: every entry read }
procedure P256TableSelect(const Table: TP256Table; var P: TP256Point; N: Integer);
var
  i, choice: Integer;
begin
  P256SetInfinity(P);
  for i := 1 to 16 do
  begin
    choice := CtByteEq(i, N);
    P256PointSelect(P, Table[i - 1], P, choice);
  end;
end;

{ the table of [1]Q to [16]Q, as Go's p256.go p256Table.Compute }
procedure P256TableCompute(var Table: TP256Table; const Q: TP256Point);
var
  i: Integer;
begin
  Table[0] := Q;
  i := 1;
  while i < 16 do
  begin
    P256PointDouble(Table[i], Table[i div 2]);
    if i + 1 < 16 then
      P256PointAdd(Table[i + 1], Table[i], Q);
    i := i + 2;
  end;
end;

{ P = -P when Choice = 1, P when Choice = 0, as Go's p256.go Negate }
procedure P256PointNegate(var P: TP256Point; Choice: Integer);
var
  negY: TP256Fe;
begin
  P256FeZero(negY);
  P256Sub(negY, negY, P.Y);
  P256FeSelect(P.Y, negY, P.Y, Choice);
end;

{ the same for an affine point, as Go's p256.go p256AffinePoint.Negate }
procedure P256AffineNegate(var P: TP256Affine; Choice: Integer);
var
  negY: TP256Fe;
begin
  P256FeZero(negY);
  P256Sub(negY, negY, P.Y);
  P256FeSelect(P.Y, negY, P.Y, Choice);
end;

{ P = Scalar * Q, Scalar 32 big-endian bytes (the caller checks),
  reduced modulo n, as Go's p256.go ScalarMult: signed windows of 5
  bits from the top (Booth), five doublings and one addition of a
  selected, conditionally negated entry a window; P may be Q }
procedure P256ScalarMult(var P: TP256Point; const Q: TP256Point; const Scalar: string);
var
  s: TP256Ord;
  table: TP256Table;
  t: TP256Point;
  index, sel, sign, wvalue: Integer;
begin
  P256OrdSetBytes(s, Scalar);
  { from the top bits by 5, ending at -1: -1 + 5 * 51 = 254 }
  index := 254;
  P256BoothW5(P256OrdRsh(s, index), sel, sign);
  { sign is 0 here: the window has two bits }
  P256TableCompute(table, Q);
  P256TableSelect(table, P, sel);
  P256SetInfinity(t);
  while index >= 4 do
  begin
    index := index - 5;
    P256PointDouble(P, P);
    P256PointDouble(P, P);
    P256PointDouble(P, P);
    P256PointDouble(P, P);
    P256PointDouble(P, P);
    if index >= 0 then
      P256BoothW5(P256OrdRsh(s, index) and $3F, sel, sign)
    else
    begin
      { Booth's virtual zero bit at index -1 }
      wvalue := (s[0] shl 1) and $3F;
      P256BoothW5(wvalue, sel, sign);
    end;
    P256TableSelect(table, t, sel);
    P256PointNegate(t, sign);
    P256PointAdd(P, P, t);
  end;
end;

{ P = [N]P of an affine table, N in [1, 32] (for 0 P is left as it
  was, any value), as Go's p256.go p256AffineTable.Select }
procedure P256AffineTableSelect(const Table: TP256AffineTable; var P: TP256Affine; N: Integer);
var
  i, choice: Integer;
begin
  for i := 1 to 32 do
  begin
    choice := CtByteEq(i, N);
    P256FeSelect(P.X, Table[i - 1].X, P.X, choice);
    P256FeSelect(P.Y, Table[i - 1].Y, P.Y, choice);
  end;
end;

{ the 43 affine tables of p256.go p256GeneratorTables: table i holds
  [1]B to [32]B for B = [2^(6 i)]G, each made affine by one inversion
  as Go's p256_table_test.go builds them to check the embedded ones }
procedure P256GenTablesInit;
var
  base, p: TP256Point;
  zInv: TP256Fe;
  i, j, k: Integer;
begin
  base := P256G;
  for i := 0 to 42 do
  begin
    P256SetInfinity(p);
    for j := 0 to 31 do
    begin
      P256PointAdd(p, p, base);
      P256FeInvert(zInv, p.Z);
      P256Mul(P256GenTables[i][j].X, p.X, zInv);
      P256Mul(P256GenTables[i][j].Y, p.Y, zInv);
    end;
    for k := 0 to 5 do
      P256PointDouble(base, base);
  end;
end;

{ P = Scalar * G, Scalar 32 big-endian bytes (the caller checks),
  reduced modulo n, as Go's p256.go ScalarBaseMult: signed windows of
  6 bits, each added from its own pre-doubled table, so no doubling }
procedure P256ScalarBaseMult(var P: TP256Point; const Scalar: string);
var
  s: TP256Ord;
  t: TP256Affine;
  inf, proj: TP256Point;
  index, sel, sign, wvalue, selIsZero: Integer;
begin
  once P256TablesOnce do
    P256GenTablesInit;
  P256OrdSetBytes(s, Scalar);
  { from the top bits by 6, ending at -1: -1 + 6 * 42 = 251 }
  index := 251;
  P256BoothW6(P256OrdRsh(s, index), sel, sign);
  { sign is 0 here: the window has five bits }
  P256FeZero(t.X);
  P256FeZero(t.Y);
  P256AffineTableSelect(P256GenTables[(index + 1) div 6], t, sel);
  { the selection is undefined for 0, which must be the infinity }
  selIsZero := CtByteEq(sel, 0);
  P256SetInfinity(inf);
  proj.X := t.X;
  proj.Y := t.Y;
  P256SetOne(proj.Z);
  P256PointSelect(P, inf, proj, selIsZero);
  while index >= 5 do
  begin
    index := index - 6;
    if index >= 0 then
      P256BoothW6(P256OrdRsh(s, index) and $7F, sel, sign)
    else
    begin
      { Booth's virtual zero bit at index -1 }
      wvalue := (s[0] shl 1) and $7F;
      P256BoothW6(wvalue, sel, sign);
    end;
    P256AffineTableSelect(P256GenTables[(index + 1) div 6], t, sel);
    P256AffineNegate(t, sign);
    selIsZero := CtByteEq(sel, 0);
    P256PointAddAffine(P, P, t, selIsZero);
  end;
end;

{ ---- arithmetic modulo the order n (public values only) ---- }

{ C for the order whose big-endian bytes are NBytes (8 L of them):
  -1/n mod 2^64 by Newton's iteration, R^2 mod n by doubling }
procedure OrderInit(var C: TOrder; const NBytes: string);
var
  i, k, inv, cy, borrow, d: Integer;
  t, u: TNat;
begin
  C.L := Length(NBytes) div 8;
  for i := 0 to 5 do
  begin
    C.N[i] := 0;
    C.RR[i] := 0;
    t[i] := 0;
  end;
  for i := 0 to C.L - 1 do
    C.N[i] := LoadBE64(@NBytes[Length(NBytes) - 8 * i - 7]);
  inv := C.N[0];
  for k := 1 to 6 do
    inv := inv * (2 - C.N[0] * inv);
  C.N0 := -inv;
  C.NMinus2 := C.N;
  C.NMinus2[0] := C.N[0] - 2;
  { 1 doubled 128 L times, n subtracted whenever it is reached }
  t[0] := 1;
  for k := 1 to 128 * C.L do
  begin
    cy := 0;
    for i := 0 to C.L - 1 do
      t[i] := AddCarry(t[i], t[i], cy, cy);
    borrow := 0;
    for i := 0 to C.L - 1 do
      u[i] := SubBorrow(t[i], C.N[i], borrow, borrow);
    if (cy = 1) or (borrow = 0) then
      for i := 0 to C.L - 1 do
        t[i] := u[i];
  end;
  C.RR := t;
end;

{ Z = A B / R mod n, for A, B below n: the Montgomery product, word by
  word (CIOS), and one subtraction of n when the result reaches it }
procedure OrderMontMul(const C: TOrder; var Z: TNat; const A, B: TNat);
var
  t: TNatWide;
  d: TNat;
  i, j, L, cc, hi, lo, m, k, bw: Integer;
begin
  L := C.L;
  for j := 0 to L + 1 do
    t[j] := 0;
  for i := 0 to L - 1 do
  begin
    { t += A[i] * B }
    cc := 0;
    for j := 0 to L - 1 do
    begin
      Mul128(A[i], B[j], hi, lo);
      lo := AddCarry(lo, t[j], 0, k);
      hi := hi + k;
      lo := AddCarry(lo, cc, 0, k);
      hi := hi + k;
      t[j] := lo;
      cc := hi;
    end;
    t[L] := AddCarry(t[L], cc, 0, k);
    t[L + 1] := k;
    { t = (t + m n) / 2^64, m making the low word zero }
    m := t[0] * C.N0;
    Mul128(m, C.N[0], hi, lo);
    lo := AddCarry(lo, t[0], 0, k);
    cc := hi + k;
    for j := 1 to L - 1 do
    begin
      Mul128(m, C.N[j], hi, lo);
      lo := AddCarry(lo, t[j], 0, k);
      hi := hi + k;
      lo := AddCarry(lo, cc, 0, k);
      hi := hi + k;
      t[j - 1] := lo;
      cc := hi;
    end;
    t[L - 1] := AddCarry(t[L], cc, 0, k);
    t[L] := t[L + 1] + k;
  end;
  bw := 0;
  for j := 0 to L - 1 do
    d[j] := SubBorrow(t[j], C.N[j], bw, bw);
  for j := 0 to 5 do
    Z[j] := 0;
  if (t[L] <> 0) or (bw = 0) then
    for j := 0 to L - 1 do
      Z[j] := d[j]
  else
    for j := 0 to L - 1 do
      Z[j] := t[j];
end;

{ Z = A B mod n }
procedure OrderMul(const C: TOrder; var Z: TNat; const A, B: TNat);
var
  t: TNat;
begin
  OrderMontMul(C, t, A, B);
  OrderMontMul(C, Z, t, C.RR);
end;

{ Z = A^(n-2) = 1/A mod n by Fermat's little theorem, as Go's ecdsa.go
  inverse does with bigmod's Exp when it has no special routine }
procedure OrderInverse(const C: TOrder; var Z: TNat; const A: TNat);
var
  am, acc, one: TNat;
  i: Integer;
begin
  for i := 0 to 5 do
    one[i] := 0;
  one[0] := 1;
  OrderMontMul(C, am, A, C.RR);          { A R }
  OrderMontMul(C, acc, C.RR, one);       { R }
  for i := 64 * C.L - 1 downto 0 do
  begin
    OrderMontMul(C, acc, acc, acc);
    if ((C.NMinus2[i div 64] shr (i mod 64)) and 1) = 1 then
      OrderMontMul(C, acc, acc, am);
  end;
  OrderMontMul(C, Z, acc, one);
end;

{ Z from the big-endian bytes B, as bigmod's setBytes: False when they
  are more than the limbs hold (8 L bytes, leading zeros too) }
function OrderSetRaw(const C: TOrder; var Z: TNat; const B: string): Boolean;
var
  i, k, n: Integer;
begin
  for i := 0 to 5 do
    Z[i] := 0;
  n := Length(B);
  if n > 8 * C.L then
    Exit(False);
  for i := 0 to n - 1 do
  begin
    k := i div 8;
    Z[k] := Z[k] or (Ord(B[n - i]) shl (8 * (i mod 8)));
  end;
  Result := True;
end;

{ whether Z >= n }
function OrderGeq(const C: TOrder; const Z: TNat): Boolean;
var
  i, b, d: Integer;
begin
  b := 0;
  for i := 0 to C.L - 1 do
    d := SubBorrow(Z[i], C.N[i], b, b);
  Result := b = 0;
end;

{ Z = Z - n }
procedure OrderSubN(const C: TOrder; var Z: TNat);
var
  i, b: Integer;
begin
  b := 0;
  for i := 0 to C.L - 1 do
    Z[i] := SubBorrow(Z[i], C.N[i], b, b);
end;

{ bigmod's SetBytes: Z from B, False when B overflows the limbs or is
  n or more }
function OrderSetBytes(const C: TOrder; var Z: TNat; const B: string): Boolean;
begin
  if not OrderSetRaw(C, Z, B) then
    Exit(False);
  Result := not OrderGeq(C, Z);
end;

{ bigmod's SetOverflowingBytes: Z from B reduced by one subtraction;
  the bit-length check of its top limb never fails for these orders,
  whose top limb is full }
function OrderSetOverflowingBytes(const C: TOrder; var Z: TNat; const B: string): Boolean;
begin
  if not OrderSetRaw(C, Z, B) then
    Exit(False);
  if OrderGeq(C, Z) then
    OrderSubN(C, Z);
  Result := True;
end;

function OrderIsZero(const C: TOrder; const Z: TNat): Boolean;
var
  i, acc: Integer;
begin
  acc := 0;
  for i := 0 to C.L - 1 do
    acc := acc or Z[i];
  Result := acc = 0;
end;

function OrderEqual(const C: TOrder; const A, B: TNat): Boolean;
var
  i, acc: Integer;
begin
  acc := 0;
  for i := 0 to C.L - 1 do
    acc := acc or (A[i] xor B[i]);
  Result := acc = 0;
end;

{ bigmod's Bytes: the 8 L big-endian bytes of Z }
function OrderBytes(const C: TOrder; const Z: TNat): string;
var
  i: Integer;
begin
  SetLength(Result, 8 * C.L);
  for i := 0 to C.L - 1 do
    StoreBE64(@Result[8 * (C.L - 1 - i) + 1], Z[i]);
end;

{ hashToNat of Go's ecdsa.go: the left-most bits of the hash, as many as
  the order has (FIPS 186-5 6.4.1 2, 6.4.2 3), reduced once; both
  orders here are a whole number of bytes, so no shift is needed }
procedure OrderHashToNat(const C: TOrder; var E: TNat; const Hash: string);
var
  h: string;
  ok: Boolean;
begin
  h := Hash;
  if Length(h) >= 8 * C.L then
    h := Copy(h, 1, 8 * C.L);
  ok := OrderSetOverflowingBytes(C, E, h);
end;

{ ---- DER signatures: Go's crypto/ecdsa parseSignature with
  golang.org/x/crypto/cryptobyte (asn1.go) ---- }

{ readASN1 of cryptobyte with the header skipped, then ReadASN1's tag
  check: one element of tag Tag from S[At], the input ending before
  Lim; its contents at CStart, CLen bytes, and At past it. Only
  low-tag-number tags; a long length must be minimal (DER, X.690
  10.1) and at most 4 bytes }
function Asn1Read(const S: string; var At: Integer; Lim, Tag: Integer; var CStart, CLen: Integer): Boolean;
var
  avail, t, lenByte, lenLen, len32, headerLen, total, i: Integer;
begin
  Result := False;
  avail := Lim - At;
  if avail < 2 then
    Exit;
  t := Ord(S[At]);
  lenByte := Ord(S[At + 1]);
  if (t and $1F) = $1F then
    Exit;
  if (lenByte and $80) = 0 then
  begin
    total := lenByte + 2;
    headerLen := 2;
  end
  else
  begin
    lenLen := lenByte and $7F;
    if (lenLen = 0) or (lenLen > 4) or (avail < 2 + lenLen) then
      Exit;
    len32 := 0;
    for i := 0 to lenLen - 1 do
      len32 := (len32 shl 8) or Ord(S[At + 2 + i]);
    if len32 < 128 then
      Exit;
    if (len32 shr ((lenLen - 1) * 8)) = 0 then
      Exit;
    headerLen := 2 + lenLen;
    total := headerLen + len32;
    { Go's uint32 sum overflows past 2^32 - 1 and is refused }
    if total > $FFFFFFFF then
      Exit;
  end;
  if total > avail then
    Exit;
  if t <> Tag then
    Exit;
  CStart := At + headerLen;
  CLen := total - headerLen;
  At := At + total;
  Result := True;
end;

{ readASN1Bytes of cryptobyte: an INTEGER, minimally encoded
  (checkASN1Integer), not negative, its leading zeros dropped }
function Asn1ReadInteger(const S: string; var At: Integer; Lim: Integer; var V: string): Boolean;
var
  cs, cl: Integer;
begin
  Result := False;
  if not Asn1Read(S, At, Lim, $02, cs, cl) then
    Exit;
  if cl = 0 then
    Exit;
  if cl > 1 then
  begin
    if (Ord(S[cs]) = 0) and ((Ord(S[cs + 1]) and $80) = 0) then
      Exit;
    if (Ord(S[cs]) = $FF) and ((Ord(S[cs + 1]) and $80) = $80) then
      Exit;
  end;
  if (Ord(S[cs]) and $80) = $80 then
    Exit;
  while (cl > 1) and (Ord(S[cs]) = 0) do
  begin
    cs := cs + 1;
    cl := cl - 1;
  end;
  V := Copy(S, cs, cl);
  Result := True;
end;

{ parseSignature of Go's crypto/ecdsa: SEQUENCE (INTEGER r, INTEGER s)
  and nothing after either }
function ParseSignature(const Sig: string; var R, S: string): Boolean;
var
  at, ipos, cs, cl, lim: Integer;
begin
  Result := False;
  at := 1;
  if not Asn1Read(Sig, at, Length(Sig) + 1, $30, cs, cl) then
    Exit;
  if at <> Length(Sig) + 1 then
    Exit;
  ipos := cs;
  lim := cs + cl;
  if not Asn1ReadInteger(Sig, ipos, lim, R) then
    Exit;
  if not Asn1ReadInteger(Sig, ipos, lim, S) then
    Exit;
  Result := ipos = lim;
end;

{ ---- ECDSA verification: Go's fips140/ecdsa/ecdsa.go Verify and
  verifyGeneric (FIPS 186-5 6.4.2) ---- }

{ the public key as ecdsa.NewPublicKey takes it: not empty, not the
  infinity's 00, a point of the curve }
function P256EcdsaVerify(const Pub, Hash, R, S: string): Boolean;
var
  q, p1, p2: TP256Point;
  rn, sn, e, w, u1, u2, v: TNat;
  rx: string;
begin
  Result := False;
  if Length(Hash) = 0 then
    Exit;
  if (Length(Pub) < 1) or (Pub[1] = #0) then
    Exit;
  if not P256PointSetBytes(q, Pub) then
    Exit;
  if not OrderSetBytes(Ord256, rn, R) then
    Exit;
  if OrderIsZero(Ord256, rn) then
    Exit;
  if not OrderSetBytes(Ord256, sn, S) then
    Exit;
  if OrderIsZero(Ord256, sn) then
    Exit;
  OrderHashToNat(Ord256, e, Hash);
  { w = 1/s }
  OrderInverse(Ord256, w, sn);
  { p1 = [e w]G }
  OrderMul(Ord256, u1, e, w);
  P256ScalarBaseMult(p1, OrderBytes(Ord256, u1));
  { p2 = [r w]Q }
  OrderMul(Ord256, u2, w, rn);
  P256ScalarMult(p2, q, OrderBytes(Ord256, u2));
  { BytesX refuses the infinity }
  P256PointAdd(p1, p1, p2);
  if not P256PointBytesX(p1, rx) then
    Exit;
  if not OrderSetOverflowingBytes(Ord256, v, rx) then
    Exit;
  Result := OrderEqual(Ord256, v, rn);
end;

function P384EcdsaVerify(const Pub, Hash, R, S: string): Boolean;
var
  q, p1, p2: TP384Point;
  rn, sn, e, w, u1, u2, v: TNat;
  rx: string;
begin
  Result := False;
  if Length(Hash) = 0 then
    Exit;
  if (Length(Pub) < 1) or (Pub[1] = #0) then
    Exit;
  if not P384PointSetBytes(q, Pub) then
    Exit;
  if not OrderSetBytes(Ord384, rn, R) then
    Exit;
  if OrderIsZero(Ord384, rn) then
    Exit;
  if not OrderSetBytes(Ord384, sn, S) then
    Exit;
  if OrderIsZero(Ord384, sn) then
    Exit;
  OrderHashToNat(Ord384, e, Hash);
  OrderInverse(Ord384, w, sn);
  OrderMul(Ord384, u1, e, w);
  P384ScalarBaseMult(p1, OrderBytes(Ord384, u1));
  OrderMul(Ord384, u2, w, rn);
  P384ScalarMult(p2, q, OrderBytes(Ord384, u2));
  P384PointAdd(p1, p1, p2);
  if not P384PointBytesX(p1, rx) then
    Exit;
  if not OrderSetOverflowingBytes(Ord384, v, rx) then
    Exit;
  Result := OrderEqual(Ord384, v, rn);
end;

{ ---- the API ---- }

{ ecdh.go NewPrivateKey's check: the order's size, not zero, below n }
function PrivValid(Curve: Integer; const Priv: string): Boolean;
var
  n: string;
begin
  Result := False;
  if Curve = NistP256 then
    n := OrderBytes(Ord256, Ord256.N)
  else if Curve = NistP384 then
    n := OrderBytes(Ord384, Ord384.N)
  else
    Exit;
  if Length(Priv) <> Length(n) then
    Exit;
  if CtIsZero(@Priv[1], Length(Priv)) then
    Exit;
  Result := CtIsLess(@Priv[1], @n[1], Length(Priv));
end;

function NistPublicKey(Curve: Integer; const Priv: string): string;
var
  p256: TP256Point;
  p384: TP384Point;
begin
  Result := '';
  if not PrivValid(Curve, Priv) then
    Exit;
  if Curve = NistP256 then
  begin
    P256ScalarBaseMult(p256, Priv);
    Result := P256PointBytes(p256);
  end
  else
  begin
    P384ScalarBaseMult(p384, Priv);
    Result := P384PointBytes(p384);
  end;
  { the infinity's single byte cannot come from a scalar in [1, n-1] }
  if Length(Result) = 1 then
    Result := '';
end;

function NistEcdh(Curve: Integer; const Priv, PeerPublic: string; out Shared: string): Boolean;
var
  p256: TP256Point;
  p384: TP384Point;
begin
  Shared := '';
  Result := False;
  if not PrivValid(Curve, Priv) then
    Exit;
  { ecdh.go NewPublicKey: no infinity, no compressed encoding }
  if (Length(PeerPublic) = 0) or (PeerPublic[1] <> #4) then
    Exit;
  if Curve = NistP256 then
  begin
    { SetBytes checks the coordinates below p and the curve equation
      (SP 800-56A 5.6.2.3.4) }
    if not P256PointSetBytes(p256, PeerPublic) then
      Exit;
    P256ScalarMult(p256, p256, Priv);
    { BytesX refuses the infinity (5.7.1.2) }
    Result := P256PointBytesX(p256, Shared);
  end
  else
  begin
    if not P384PointSetBytes(p384, PeerPublic) then
      Exit;
    P384ScalarMult(p384, p384, Priv);
    Result := P384PointBytesX(p384, Shared);
  end;
end;

function NistEcdsaVerify(Curve: Integer; const PublicKey, Hash, R, S: string): Boolean;
begin
  if Curve = NistP256 then
    Result := P256EcdsaVerify(PublicKey, Hash, R, S)
  else if Curve = NistP384 then
    Result := P384EcdsaVerify(PublicKey, Hash, R, S)
  else
    Result := False;
end;

function NistEcdsaVerifyAsn1(Curve: Integer; const PublicKey, Hash, Sig: string): Boolean;
var
  r, s: string;
begin
  Result := False;
  if Length(Hash) = 0 then
    Exit;
  if not ParseSignature(Sig, r, s) then
    Exit;
  Result := NistEcdsaVerify(Curve, PublicKey, Hash, r, s);
end;

function NistPointValid(Curve: Integer; const Point: string): Boolean;
var
  p256: TP256Point;
  p384: TP384Point;
begin
  Result := False;
  if (Length(Point) < 1) or (Point[1] = #0) then
    Exit;
  if Curve = NistP256 then
    Result := P256PointSetBytes(p256, Point)
  else if Curve = NistP384 then
    Result := P384PointSetBytes(p384, Point);
end;

initialization
  { p256.go SetGenerator and p256B, p384.go SetGenerator and p384B }
  NistInitOk := P256FeSetBytes(P256B, NistUnHex('5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b'), 1);
  NistInitOk := P256FeSetBytes(P256G.X, NistUnHex('6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296'), 1) and NistInitOk;
  NistInitOk := P256FeSetBytes(P256G.Y, NistUnHex('4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5'), 1) and NistInitOk;
  P256SetOne(P256G.Z);
  NistInitOk := P384FeSetBytes(P384B, NistUnHex('b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef'), 1) and NistInitOk;
  NistInitOk := P384FeSetBytes(P384G.X, NistUnHex('aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7'), 1) and NistInitOk;
  NistInitOk := P384FeSetBytes(P384G.Y, NistUnHex('3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f'), 1) and NistInitOk;
  P384SetOne(P384G.Z);
  { ecdh.go p256Order and p384Order }
