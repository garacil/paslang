{ ByteEq of Go's crypto/internal/constanttime: 1 when the bytes X and Y
  are equal, else 0, worked out with no branch }
function CtByteEq(X, Y: Integer): Integer;
begin
  Result := ((((X xor Y) and $FF) - 1) shr 63) and 1;
end;

{ ConstantTimeLessOrEqBytes of Go's fips140/subtle/constant_time.go: 1
  when the N big-endian bytes at X are at most those at Y, else 0, by a
  subtraction chain y - x in constant time; N is a multiple of 8 here,
  so Go's tail of fewer than 8 bytes never comes }
function CtLessOrEqBytes(X, Y: Pointer; N: Integer): Integer;
var
  b, x0, y0, d: Integer;
begin
  b := 0;
  while N > 0 do
  begin
    x0 := LoadBE64(X + (N - 8));
    y0 := LoadBE64(Y + (N - 8));
    d := SubBorrow(y0, x0, b, b);
    N := N - 8;
  end;
  Result := b xor 1;
end;

{ isZero of Go's ecdh.go: whether the N bytes at X are all zero, in
  constant time }
function CtIsZero(X: Pointer; N: Integer): Boolean;
var
  acc, i: Integer;
begin
  acc := 0;
  for i := 0 to N - 1 do
    acc := acc or PByte(X + i)^;
  Result := acc = 0;
end;

{ isLess of Go's ecdh.go: whether the N big-endian bytes at A are less
  than those at B, by a subtraction chain with borrow in constant time
  (N a multiple of 8) }
function CtIsLess(A, B: Pointer; N: Integer): Boolean;
var
  borrow, d: Integer;
begin
  borrow := 0;
  while N > 0 do
  begin
    d := SubBorrow(LoadBE64(A + (N - 8)), LoadBE64(B + (N - 8)), borrow, borrow);
    N := N - 8;
  end;
  Result := borrow = 1;
end;

{ the bytes of a string of hexadecimal digits (the constants) }
function NistUnHex(const H: string): string;
var
  i, d, v: Integer;
  c: Char;
begin
  SetLength(Result, Length(H) div 2);
  v := 0;
  for i := 1 to Length(H) do
  begin
    c := H[i];
    if (c >= '0') and (c <= '9') then
      d := Ord(c) - 48
    else if (c >= 'a') and (c <= 'f') then
      d := Ord(c) - 87
    else
      d := Ord(c) - 55;
    if Odd(i) then
      v := d shl 4
    else
      Result[i div 2] := Chr(v or d);
  end;
end;

