  Result := acc = 0;
end;

{ isLess of Go's ecdh.go: whether the N big-endian bytes at A are less
  than those at B, by a subtraction chain with borrow in constant time
  (N a multiple of 8) }
function CtIsLess(A, B: Pointer; N: Integer): Boolean;
var
  borrow, d: Integer;
begin
  borrow := 0;
  while N > 0 do
  begin
    d := SubBorrow(LoadBE64(A + (N - 8)), LoadBE64(B + (N - 8)), borrow, borrow);
    N := N - 8;
  end;
  Result := borrow = 1;
end;

{ the bytes of a string of hexadecimal digits (the constants) }
function NistUnHex(const H: string): string;
var
  i, d, v: Integer;
  c: Char;
begin
  SetLength(Result, Length(H) div 2);
  v := 0;
  for i := 1 to Length(H) do
  begin
    c := H[i];
    if (c >= '0') and (c <= '9') then
      d := Ord(c) - 48
    else if (c >= 'a') and (c <= 'f') then
      d := Ord(c) - 87
    else
      d := Ord(c) - 55;
    if Odd(i) then
      v := d shl 4
    else
      Result[i div 2] := Chr(v or d);
  end;
end;

