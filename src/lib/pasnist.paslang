end;

{ ConstantTimeLessOrEqBytes of Go's fips140/subtle/constant_time.go: 1
  when the N big-endian bytes at X are at most those at Y, else 0, by a
  subtraction chain y - x in constant time; N is a multiple of 8 here,
  so Go's tail of fewer than 8 bytes never comes }
function CtLessOrEqBytes(X, Y: Pointer; N: Integer): Integer;
var
  b, x0, y0, d: Integer;
begin
  b := 0;
  while N > 0 do
  begin
    x0 := LoadBE64(X + (N - 8));
    y0 := LoadBE64(Y + (N - 8));
    d := SubBorrow(y0, x0, b, b);
    N := N - 8;
  end;
  Result := b xor 1;
end;

{ isZero of Go's ecdh.go: whether the N bytes at X are all zero, in
  constant time }
function CtIsZero(X: Pointer; N: Integer): Boolean;
var
  acc, i: Integer;
begin
  acc := 0;
  for i := 0 to N - 1 do
