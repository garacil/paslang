{ Core hash map behind map[K] of V: Swiss tables, the design Go ships
  since 1.24 and Abseil before it, split as Go splits them: a directory
  of tables indexed by bits of the upper half of the hash, each table
  at most MaxTableCap slots; a table doubles until it reaches that size
  and then splits in two, so a growing map never holds an old and a new
  copy of all of itself at once (P96: at its last doubling b5map held
  18 MB and 36 MB together). Groups of eight slots share an eight-byte
  control word: one byte per slot, 128 for empty, 254 for deleted, else
  the low seven bits of the hash. A lookup probes the groups
  quadratically and stops at the first group with an empty slot, so a
  delete leaves a tombstone only when its group is full. A map of up to
  eight keys is one group and nothing else, as Go's small map: no
  directory, no table, the group read whole with no probe, so it holds
  eight keys and never a tombstone, and it comes with the first key
  (P285: an empty map is its 32-byte header, one of up to eight keys 240
  bytes, Go's 48 and 256). The compiler
  calls these routines; user code writes m[k], m[k] := v, k in m,
  Delete, TryGet, Clear, Length and for k, v in m. }
unit pasmap;

interface

function PasMapNew(Desc: Pointer; Hint: Integer): Pointer;
function PasMapGet(M, Key, Desc: Pointer): Pointer;
function PasMapPut(M, Key, Desc: Pointer): Pointer;
function PasMapGetInt(M: Pointer; Key: Integer): Pointer;
function PasMapPutInt(M: Pointer; Key: Integer; Desc: Pointer): Pointer;
function PasMapGetStr(M, Key, Desc: Pointer): Pointer;
function PasMapPutStr(M, Key, Desc: Pointer): Pointer;
function PasMapDelete(M, Key, Desc: Pointer): Boolean;
function PasMapNext(M, It, Desc: Pointer): Pointer;
procedure PasMapClear(M, Desc: Pointer);

implementation

const
  CtrlEmpty = 128;
  CtrlDeleted = 254;
  WordEmpty = -9187201950435737472;   { eight bytes of 128 }
  LSB = 72340172838076673;            { one in every byte }
  MSB = -9187201950435737472;         { 128 in every byte }
  P1 = -7046029254386353131;          { the xxHash primes }
  P2 = -4417276706812531889;
  P3 = 1609587929392839161;
  { The slot of the lowest match: the match has bit 7 of byte j set, so
    shifting its lowest bit right by 7 gives 2^(8j), and multiplying
    this constant by it leaves j in the top byte (P96). }
  SlotIndex = 283686952306183;        { $0001020304050607 }
  { XXH3's path for 4 to 8 bytes, which an eight-byte key takes (1.0.64):
    words 1 and 2 of the reference's secret xored, and the multiplier
    of its rrmxmx. }
  X3Flip = -4090762196417718878;      { $c73ab174c5ecd5a2 }
  X3Mul = -6939452855193903323;         { $9fb21c651e98df25 }
  { Go's maxTableCapacity. }
  MaxTableCap = 1024;
  { A table is one block: this header (TTable), then its groups. }
  TableHdr = 16;
  { A directory is one block: Gen and DirMask, then its entries. }
  DirHdr = 16;
  { The keys of a small map, its one group's slots (Go's
    abi.MapGroupSlots), and the slots of the table it grows into (Go's
    growToTable, 2 * abi.MapGroupSlots), the fewest any table has. }
  SmallMax = 8;
  TableMin = 16;
{$if PASLANG_FULLVERSION >= 1001139}
  SmallOn = True;
  { Dir is the directory block's start: Gen at 0, DirMask at 8, the
    entries from DirHdr }
  DirEnt = DirHdr;
  DirGenOff = 0;
  DirMaskOff = 8;
{$else}
  SmallOn = False;
  { for an older host's rt_mapgetstr (TMap below) Dir is the entries,
    Gen and DirMask the two words before them }
  DirEnt = 0;
  DirGenOff = -16;
  DirMaskOff = -8;
{$endif}

type
  PInt = ^Integer;
  PStr = ^string;

  { The compiler writes one of these per map type as .LdescMap_<n>:
    KeyKind 0 is an eight-byte ordinal or pointer, 1 a string. }
  { SlotPtr: 1 when a key or a value holds a pointer, so the groups are
    scanned; 0 for a map of plain values, whose groups never are (P95a). }
  TMapDesc = record
    KeyKind: Integer;
    KeySize: Integer;
    ValSize: Integer;
    SlotPtr: Integer;
  end;
  PMapDesc = ^TMapDesc;

  { A table's header, at the start of the block that holds its groups
    (they start TableHdr bytes further; Mask + 1 of them, 8 slots each),
    and its local depth: the lowest LocalDepth bits of the upper half of
    the hash (h shr 32) are the same for every key in it. Its slots are
    the map's SlotSize (P285: the header was 64 bytes with the groups'
    address, the capacity and both sizes, which are all known). }
  TTable = record
    Used: Int32;
    GrowthLeft: Int32;
    Mask: Int32;
    LocalDepth: Int32;
  end;
  PTable = ^TTable;

  { Used comes first: Length(m) reads that word. A small map (TabMask
    0) has its one group at Dir, EmptyGroup before its first key. Else Dir
    holds 2^Depth entries, each the groups of a table (its header is
    TableHdr bytes before), the one for a hash at (h shr 32) and DirMask
    (2^Depth - 1, so the only one when Depth is 0); Dir is the start of
    the directory's block, which keeps Gen, the tables replaced (Grow),
    and DirMask in its first two words, then the entries. A lookup reads the entry and the group
    and never the table's header, and finds the entry with a fixed
    shift and an and, not with a shift by Depth, which cost a third of
    b5map. A table of local depth d with those d bits p is at entries p,
    p + 2^d, p + 2*2^d and so on. TabMask is every table's groups less
    one: when Depth is 0 there is one table, and above it every table
    has MaxTableCap slots; a table has TableMin slots or more, so 0 is
    the small map's. Seed is XXH3's seed for string keys, and for the
    others the bitflip XXH3 makes of it for eight bytes (Reseed). The
    map is 32 bytes, Go's 48 (P285: it was 88, with the groups' size,
    the masks, Gen and the bitflip as words of their own). }
  { rt_mapgetstr (pasemit, 1.0.69) reads these by their offsets: Used
    0, Seed 8, Dir 16, Writing 24 (a byte), TabMask 26 (two bytes),
    SlotSize 28 (four bytes), and in the directory DirMask at 8 and the
    entries from 16.
    Move one and change it there. }
{$if PASLANG_FULLVERSION >= 1001139}
  TMap = record
    Used: Integer;
    Seed: Integer;
    Dir: Pointer;
    Writing: Byte;
    Depth: Byte;
    TabMask: Word;
    SlotSize: Int32;
  end;
{$else}
  { An older paslangc, the host that builds the stage compiler (Regla
    15), writes its own rt_mapgetstr, which reads the map 1.1.138 had:
    Used 0, Seed 8, Dir 16, Writing 24, SlotSize 48, GroupSize 56,
    DirMask 64 and TabMask 72, whole words. The stage compiler's maps
    keep those words too, and none is small (SmallOn), since that
    rt_mapgetstr would probe a full group for ever; the stage compiler
    writes the new rt_mapgetstr and compiles this unit again. }
  TMap = record
    Used: Integer;
    Seed: Integer;
    Dir: Pointer;
    Writing: Integer;
    Depth: Integer;
    Spare: Integer;
    SlotSize: Integer;
    GroupSize: Integer;
    DirMask: Integer;
    TabMask: Integer;
  end;
{$endif}
  PMap = ^TMap;

  { The 32 bytes a for loop keeps on its own stack: a copy of the
    directory it started on (the table itself when there was one), its
    place (entry * MaxTableCap + slot), a random start, and the map's Gen
    then, times 256, plus the depth + 1 (0 before the first call). }
  TIter = record
    Dir: Pointer;
    Probe: Integer;
    Start: Integer;
    Live: Integer;
  end;
  PIter = ^TIter;

const
  { The group of a small map with no key yet: every slot empty, shared
    and never written. A lookup leaves at the map's count before it reads
    a group; an insertion that would fill a slot of it makes the map its
    own group first (SmallGroup), so the probe has a group to read and
    no check of its own on the way in. }
  EmptyGroup: Integer = WordEmpty;

var
  ProcKey: Integer;    { the process's secret key: 0 until the first map }
  MapCount: Integer;   { the maps seeded so far }

procedure Fatal(const Msg: string);
begin
  WriteLn(ErrOutput, Msg);
  Halt(1);
end;

{ One secret key per process from the kernel, set once by whichever
  routine gets there first, then one seed per map: the key mixed with a
  count that AtomicAdd makes unique (P197, 1.1.92). The old code read and
  wrote two globals with plain loads and stores, so two routines making
  maps at once raced on both and could take the same seed. Go seeds each
  map with rand() (golang src/internal/runtime/maps/map.go:288), the M's
  own ChaCha8 state, with no lock on its fast path (src/runtime/rand.go
  rand, mrandinit); paslang has no state per M, and a map's seed needs
  only to be unique and unknown without the key: a bijective mix of the
  key xor a unique count gives both, with no lock and no wait. Without
  getrandom the key comes from the cycle counter, as Go's readTimeRandom
  stretches nanotime. }
function NextSeed: Integer;
var
  k, buf, r, x: Integer;
begin
  k := AtomicLoad(ProcKey);
  if k = 0 then
  begin
    buf := 0;
    if Amd64 = 1 then
      r := Syscall(318, @buf, 8, 0)
    else
      r := Syscall(278, @buf, 8, 0);
    if r <> 8 then
      buf := (CycleCount xor 88172645463325252) * P1;
    if buf = 0 then
      buf := P2;
    if AtomicCas(@ProcKey, 0, buf) then
      k := buf
    else
      k := AtomicLoad(ProcKey);
  end;
  x := AtomicAdd(@MapCount, 1) xor k;
  x := (x xor (x shr 33)) * P1;
  x := (x xor (x shr 29)) * P2;
  Result := x xor (x shr 32);
end;

{ A new seed for M: for string keys the seed itself, for the others
  the bitflip XXH3 derives from it for 4 to 8 bytes, (secret word 1 xor
  word 2) - (seed xor its low half's bytes reversed, shifted up 32),
  which is all their hash reads. }
procedure Reseed(M: PMap; D: PMapDesc);
var
  s, w: Integer;
begin
  s := NextSeed;
  if D^.KeyKind = 1 then
    M^.Seed := s
  else
  begin
    w := s and 4294967295;
    w := ((w and 255) shl 24) or (((w shr 8) and 255) shl 16) or
      (((w shr 16) and 255) shl 8) or ((w shr 24) and 255);
    M^.Seed := X3Flip - (s xor (w shl 32));
  end;
end;

{ The hash of a key: XXH3 with the map's seed (1.0.64). A string's bytes
  go to XxHash3; an eight-byte key is XXH3 of its eight bytes, written
  out: the halves swapped, xor the map's bitflip, rrmxmx. The fast paths
  repeat these lines. }
function HashOf(M: PMap; Key: Pointer; D: PMapDesc): Integer;
var
  h: Integer;
begin
  if D^.KeyKind = 1 then
    Result := XxHash3(PStr(Key)^, M^.Seed)
  else
  begin
    h := PInt(Key)^;
    h := (h rol 32) xor M^.Seed;
    h := h xor (h rol 49) xor (h rol 24);
    h := h * X3Mul;
    h := h xor ((h shr 35) + 8);
    h := h * X3Mul;
    Result := h xor (h shr 28);
  end;
end;

function KeyEq(A, B: Pointer; D: PMapDesc): Boolean;
begin
  if D^.KeyKind = 1 then
    Result := PStr(A)^ = PStr(B)^
  else
    Result := PInt(A)^ = PInt(B)^;
end;

{ Bit 7 of every byte whose control byte equals H2. }
function MatchH2(Ctrl, H2: Integer): Integer;
var
  x: Integer;
begin
  x := Ctrl xor (H2 * LSB);
  Result := (x - LSB) and (x xor (-1)) and MSB;
end;

{ Bit 7 of every empty byte: bit 7 set and bit 1 clear. }
function MatchEmpty(Ctrl: Integer): Integer;
begin
  Result := Ctrl and ((Ctrl shl 6) xor (-1)) and MSB;
end;

{ Bit 7 of every empty or deleted byte. }
function MatchFree(Ctrl: Integer): Integer;
begin
  Result := Ctrl and MSB;
end;

{ The lowest slot in a match. }
function FirstSlot(Bits: Integer): Integer;
begin
  Result := (((Bits and (-Bits)) shr 7) * SlotIndex) shr 56;
end;

{ Group G of T, whose groups are GS bytes. }
function GroupAt(T: PTable; G, GS: Integer): Pointer;
begin
  Result := Pointer(Integer(T) + TableHdr + G * GS);
end;

{ Slot I of group G, whose slots are SS bytes. }
function SlotAt(G: Pointer; I, SS: Integer): Pointer;
begin
  Result := Pointer(Integer(G) + 8 + I * SS);
end;

function Capacity(T: PTable): Integer;
begin
  Result := (T^.Mask + 1) * 8;
end;

{ The directory's Gen and DirMask, the two words before its entries
  (DirHdr): Dir is the block's start, so both are read at a positive
  offset, one load each. }
function GenAt(M: PMap): PInt;
begin
  Result := PInt(Integer(M^.Dir) + DirGenOff);
end;

function DirMaskOf(M: PMap): Integer;
begin
  Result := PInt(Integer(M^.Dir) + DirMaskOff)^;
end;

function MaxGrowth(Slots: Integer): Integer;
begin
  if Slots <= 8 then
    Result := Slots - 1
  else
    Result := (Slots * 7) div 8;
end;

{ The bytes of a slot: the key, then the value in whole words. }
function SlotBytes(D: PMapDesc): Integer;
begin
  Result := D^.KeySize + ((D^.ValSize + 7) and (-8));
end;

function NewTable(Slots: Integer; D: PMapDesc): PTable;
var
  t: PTable;
  n, i, gs, a: Integer;
  p: Pointer;
begin
  gs := (SlotBytes(D) + 1) shl 3;
  n := Slots div 8;
  GetMem(p, TableHdr + n * gs, D^.SlotPtr);
  t := PTable(p);
  t^.Mask := Int32(n - 1);
  t^.Used := Int32(0);
  t^.GrowthLeft := Int32(MaxGrowth(Slots));
  t^.LocalDepth := Int32(0);
  a := Integer(p) + TableHdr;
  for i := 0 to n - 1 do
    PInt(a + i * gs)^ := WordEmpty;
  Result := t;
end;

{ Eight-byte keys (KeyKind 0) have their own paths, as Go's
  mapaccess2_fast64 and mapassign_fast64: the key is compared in place,
  the hash is computed without a call, and the probe loops call nothing,
  so they run in registers (P96). Addresses are Integers there. }

{ Insert a slot of SS bytes copied from elsewhere; the key is known to
  be new and the table has room. }
procedure PutFresh(T: PTable; Src: Pointer; H, SS: Integer);
var
  probe, step, bits, i: Integer;
  g, k: Pointer;
  pb: PChar;
begin
  probe := (H shr 7) and T^.Mask;
  step := 0;
  while True do
  begin
    g := GroupAt(T, probe, (SS + 1) shl 3);
    bits := MatchFree(PInt(g)^);
    if bits <> 0 then
    begin
      i := FirstSlot(bits);
      k := SlotAt(g, i, SS);
      Move(Src^, k^, SS);
      pb := PChar(Integer(g) + i);
      pb^ := Char(H and 127);
      Exit;
    end;
    step := step + 1;
    probe := (probe + step) and T^.Mask;
  end;
end;

{ The table for hash H. }
function TableFor(M: PMap; H: Integer): PTable;
begin
  Result := PTable(PInt(Integer(M^.Dir) + DirEnt + ((H shr 32) and DirMaskOf(M)) * 8)^ - TableHdr);
end;

{ Directory entry I names table T, by its groups. }
procedure SetEntry(M: PMap; I: Integer; T: PTable);
begin
  PInt(Integer(M^.Dir) + DirEnt + I * 8)^ := Integer(T) + TableHdr;
  M^.TabMask := Word(T^.Mask);
end;

{ A directory of 2^Depth entries, every one T, its Gen at Gen. }
procedure NewDir(M: PMap; Depth: Integer; T: PTable; Gen: Integer);
var
  p: Pointer;
  i: Integer;
begin
  GetMem(p, DirHdr + (1 shl Depth) * 8);
  PInt(p)^ := Gen;
  PInt(Integer(p) + 8)^ := (1 shl Depth) - 1;
  M^.Dir := Pointer(Integer(p) + DirHdr - DirEnt);
  M^.Depth := Byte(Depth);
{$if PASLANG_FULLVERSION < 1001139}
  M^.DirMask := (1 shl Depth) - 1;
{$endif}
  if T <> nil then
    for i := 0 to (1 shl Depth) - 1 do
      SetEntry(M, i, T);
end;

{ Twice the entries: the new bit is the top one of the index, so the
  directory is its old self twice. A loop that started on the old
  directory keeps it. }
procedure DoubleDir(M: PMap);
var
  p: Pointer;
  n: Integer;
begin
  n := 1 shl M^.Depth;
  GetMem(p, DirHdr + n * 16);
  PInt(p)^ := GenAt(M)^;
  PInt(Integer(p) + 8)^ := n * 2 - 1;
  Move(Pointer(Integer(M^.Dir) + DirEnt)^, Pointer(Integer(p) + DirHdr)^, n * 8);
  Move(Pointer(Integer(M^.Dir) + DirEnt)^, Pointer(Integer(p) + DirHdr + n * 8)^, n * 8);
  M^.Dir := Pointer(Integer(p) + DirHdr - DirEnt);
  M^.Depth := Byte(M^.Depth + 1);
{$if PASLANG_FULLVERSION < 1001139}
  M^.DirMask := n * 2 - 1;
{$endif}
end;

{ Every live entry of Old into A, or, when B is not nil, into A or B by
  bit Bit of its hash (0 to A). Eight-byte keys move without a call:
  the hash, the probe for a free slot and the copy of the slot in one
  loop (P96). The counts of A and B follow. }
procedure MoveEntries(M: PMap; Old, A, B: PTable; Bit: Integer; D: PMapDesc);
var
  gi, i, ctrl: Integer;
  g, k: Pointer;
  flip, ssz, gsz, src, og, bits, ok, h, probe, step, ng, fb, slot, nk, j, diff, mask, na, gb, seed: Integer;
  t: PTable;
begin
  flip := M^.Seed;
  ssz := M^.SlotSize;
  gsz := (ssz + 1) shl 3;
  src := Integer(Old) + TableHdr;
  if D^.KeyKind = 0 then
  begin
    { A and B have the same size; the half is chosen without a branch,
      as distance from A's groups times the bit (half of the keys would
      mispredict it). A's count is kept here, B's is the rest. }
    diff := 0;
    if B <> nil then
      diff := Integer(B) - Integer(A);
    mask := A^.Mask;
    na := 0;
    for gi := 0 to Old^.Mask do
    begin
      og := src + gi * gsz;
      bits := (PInt(og)^ xor (-1)) and MSB;
      while bits <> 0 do
      begin
        ok := og + 8 + ((((bits and (-bits)) shr 7) * SlotIndex) shr 56) * ssz;
        h := PInt(ok)^;
        h := (h rol 32) xor flip;
        h := h xor (h rol 49) xor (h rol 24);
        h := h * X3Mul;
        h := h xor ((h shr 35) + 8);
        h := h * X3Mul;
        h := h xor (h shr 28);
        j := (h shr Bit) and 1;
        if diff = 0 then
          j := 0;
        na := na + 1 - j;
        probe := (h shr 7) and mask;
        gb := Integer(A) + TableHdr + j * diff;
        step := 0;
        ng := gb + probe * gsz;
        while (PInt(ng)^ and MSB) = 0 do
        begin
          step := step + 1;
          probe := (probe + step) and mask;
          ng := gb + probe * gsz;
        end;
        fb := PInt(ng)^ and MSB;
        slot := (((fb and (-fb)) shr 7) * SlotIndex) shr 56;
        nk := ng + 8 + slot * ssz;
        j := 0;
        while j < ssz do
        begin
          PInt(nk + j)^ := PInt(ok + j)^;
          j := j + 8;
        end;
        PChar(ng + slot)^ := Char(h and 127);
        bits := bits and (bits - 1);
      end;
    end;
    A^.Used := Int32(A^.Used + na);
    if B <> nil then
      B^.Used := Int32(B^.Used + Old^.Used - na);
  end
  else if D^.KeyKind = 1 then
  begin
    { String keys the same way, the hash by XxHash3 of the key's bytes:
      no call but rt_xxh3's for each entry (1.0.67; it was four, and a
      Move, per entry, a split of a map of strings was a third of the
      time its inserts took). }
    seed := M^.Seed;
    diff := 0;
    if B <> nil then
      diff := Integer(B) - Integer(A);
    mask := A^.Mask;
    na := 0;
    for gi := 0 to Old^.Mask do
    begin
      og := src + gi * gsz;
      bits := (PInt(og)^ xor (-1)) and MSB;
      while bits <> 0 do
      begin
        ok := og + 8 + ((((bits and (-bits)) shr 7) * SlotIndex) shr 56) * ssz;
        h := XxHash3(PStr(ok)^, seed);
        j := (h shr Bit) and 1;
        if diff = 0 then
          j := 0;
        na := na + 1 - j;
        probe := (h shr 7) and mask;
        gb := Integer(A) + TableHdr + j * diff;
        step := 0;
        ng := gb + probe * gsz;
        while (PInt(ng)^ and MSB) = 0 do
        begin
          step := step + 1;
          probe := (probe + step) and mask;
          ng := gb + probe * gsz;
        end;
        fb := PInt(ng)^ and MSB;
        slot := (((fb and (-fb)) shr 7) * SlotIndex) shr 56;
        nk := ng + 8 + slot * ssz;
        j := 0;
        while j < ssz do
        begin
          PInt(nk + j)^ := PInt(ok + j)^;
          j := j + 8;
        end;
        PChar(ng + slot)^ := Char(h and 127);
        bits := bits and (bits - 1);
      end;
    end;
    A^.Used := Int32(A^.Used + na);
    if B <> nil then
      B^.Used := Int32(B^.Used + Old^.Used - na);
  end
  else
    for gi := 0 to Old^.Mask do
    begin
      g := GroupAt(Old, gi, gsz);
      ctrl := PInt(g)^;
      for i := 0 to 7 do
        if ((ctrl shr (8 * i)) and 128) = 0 then
        begin
          k := SlotAt(g, i, ssz);
          h := HashOf(M, k, D);
          t := A;
          if B <> nil then
            if ((h shr Bit) and 1) = 1 then
              t := B;
          PutFresh(t, k, h, ssz);
          t^.Used := Int32(t^.Used + 1);
        end;
    end;
  A^.GrowthLeft := Int32(A^.GrowthLeft - A^.Used);
  if B <> nil then
    B^.GrowthLeft := Int32(B^.GrowthLeft - B^.Used);
end;

{ Table T, found for hash H, is full: a fresh table of the same size
  when it is mostly tombstones, twice the size below MaxTableCap, else
  two tables that split it by the next bit of the hash (bit 32 + its
  local depth), each on the entries of T with that bit (the directory
  doubles first when T already uses every bit of it). The old tables
  stay for loops that started on them. }
procedure Grow(M: PMap; T: PTable; H: Integer; D: PMapDesc);
var
  nt, left, right: PTable;
  slots, n, start, i, ld: Integer;
begin
  GenAt(M)^ := GenAt(M)^ + 1;
  if (T^.Used * 2 < Capacity(T)) or (Capacity(T) < MaxTableCap) then
  begin
    if T^.Used * 2 < Capacity(T) then
      slots := Capacity(T)
    else
      slots := Capacity(T) * 2;
    nt := NewTable(slots, D);
    nt^.LocalDepth := Int32(T^.LocalDepth);
    MoveEntries(M, T, nt, nil, 0, D);
    left := nt;
    right := nt;
  end
  else
  begin
    if T^.LocalDepth = M^.Depth then
      DoubleDir(M);
    left := NewTable(MaxTableCap, D);
    right := NewTable(MaxTableCap, D);
    left^.LocalDepth := Int32(T^.LocalDepth + 1);
    right^.LocalDepth := Int32(T^.LocalDepth + 1);
    MoveEntries(M, T, left, right, 32 + T^.LocalDepth, D);
  end;
  { T's entries: start + i * 2^LocalDepth for its LocalDepth bits start;
    bit LocalDepth of the entry picks the half. }
  ld := T^.LocalDepth;
  start := (H shr 32) and ((1 shl ld) - 1);
  n := 1 shl (M^.Depth - ld);
  for i := 0 to n - 1 do
    if (i and 1) = 0 then
      SetEntry(M, start + (i shl ld), left)
    else
      SetEntry(M, start + (i shl ld), right);
end;

{ The key slot in T, whose slots are SS bytes, or nil. }
function FindSlot(T: PTable; Key: Pointer; D: PMapDesc; H, SS: Integer): Pointer;
var
  h2, probe, step, bits, i, ctrl: Integer;
  g, k: Pointer;
begin
  Result := nil;
  h2 := H and 127;
  probe := (H shr 7) and T^.Mask;
  step := 0;
  while True do
  begin
    g := GroupAt(T, probe, (SS + 1) shl 3);
    ctrl := PInt(g)^;
    bits := MatchH2(ctrl, h2);
    while bits <> 0 do
    begin
      i := FirstSlot(bits);
      k := SlotAt(g, i, SS);
      if KeyEq(k, Key, D) then
      begin
        Result := k;
        Exit;
      end;
      bits := bits and (bits - 1);
    end;
    if MatchEmpty(ctrl) <> 0 then
      Exit;
    step := step + 1;
    probe := (probe + step) and T^.Mask;
  end;
end;

{ A small map's slot of Key, or nil: every slot of its one group whose
  control byte is H2 is compared, and there is no probe (Go's
  getWithKeySmall): eight keys fit and none was ever deleted to a
  tombstone. }
function SmallFind(M: PMap; Key: Pointer; D: PMapDesc; H: Integer): Pointer;
var
  g, bits: Integer;
  k: Pointer;
begin
  Result := nil;
  g := Integer(M^.Dir);
  if g = 0 then
    Exit;
  bits := MatchH2(PInt(g)^, H and 127);
  while bits <> 0 do
  begin
    k := SlotAt(Pointer(g), FirstSlot(bits), M^.SlotSize);
    if KeyEq(k, Key, D) then
    begin
      Result := k;
      Exit;
    end;
    bits := bits and (bits - 1);
  end;
end;

{ The key slot of Key wherever the map keeps it, or nil. }
function FindAny(M: PMap; Key: Pointer; D: PMapDesc): Pointer;
var
  h: Integer;
begin
  h := HashOf(M, Key, D);
  if M^.TabMask = 0 then
    Result := SmallFind(M, Key, D, h)
  else
    Result := FindSlot(TableFor(M, h), Key, D, h, M^.SlotSize);
end;

{ A small map's group, made at its first key in place of EmptyGroup:
  every slot empty. }
procedure SmallGroup(M: PMap; D: PMapDesc);
var
  p: Pointer;
begin
  GetMem(p, (M^.SlotSize + 1) shl 3, D^.SlotPtr);
  PInt(p)^ := WordEmpty;
  M^.Dir := p;
end;

{ A free slot of a small map's group for a key of hash H, its control
  byte set and the map's count up: the key's slot, the caller fills
  it; nil when the eight are taken. }
function SmallSlot(M: PMap; H: Integer): Pointer;
var
  g, bits, i: Integer;
begin
  Result := nil;
  g := Integer(M^.Dir);
  bits := MatchFree(PInt(g)^);
  if bits = 0 then
    Exit;
  i := FirstSlot(bits);
  PChar(g + i)^ := Char(H and 127);
  M^.Used := M^.Used + 1;
  Result := SlotAt(Pointer(g), i, M^.SlotSize);
end;

{ A small map's eight keys go into a table of TableMin slots under a
  directory of one entry, as Go's growToTable. The group stays as it
  is for a loop that started on it. }
procedure GrowToTable(M: PMap; D: PMapDesc);
var
  t: PTable;
  g, ss, ctrl, i: Integer;
  k: Pointer;
begin
  ss := M^.SlotSize;
  t := NewTable(TableMin, D);
  g := Integer(M^.Dir);
  ctrl := PInt(g)^;
  for i := 0 to 7 do
    if ((ctrl shr (8 * i)) and 128) = 0 then
    begin
      k := SlotAt(Pointer(g), i, ss);
      PutFresh(t, k, HashOf(M, k, D), ss);
      t^.Used := Int32(t^.Used + 1);
    end;
  t^.GrowthLeft := Int32(t^.GrowthLeft - t^.Used);
  NewDir(M, 0, t, 1);
end;

{ A map for about Hint entries: a small map up to eight, with no group
  until its first key, as Go's (NewMap allocates nothing for those);
  one table while they fit in one, else 2^k tables of MaxTableCap, each
  half full. }
function PasMapNew(Desc: Pointer; Hint: Integer): Pointer;
var
  mp: PMap;
  slots, k, i: Integer;
  t: PTable;
begin
  New(mp);
  mp^.Used := 0;
  mp^.Writing := 0;
  Reseed(mp, PMapDesc(Desc));
  mp^.SlotSize := Int32(SlotBytes(PMapDesc(Desc)));
  mp^.Dir := nil;
  mp^.Depth := 0;
  mp^.TabMask := 0;
{$if PASLANG_FULLVERSION < 1001139}
  mp^.GroupSize := (mp^.SlotSize + 1) shl 3;
{$endif}
  if SmallOn and (Hint <= SmallMax) then
  begin
    mp^.Dir := @EmptyGroup;
    Result := mp;
    Exit;
  end;
  if Hint <= MaxGrowth(MaxTableCap) then
  begin
    slots := TableMin;
    while MaxGrowth(slots) < Hint do
      slots := slots * 2;
    NewDir(mp, 0, NewTable(slots, PMapDesc(Desc)), 0);
  end
  else
  begin
    k := 1;
    while (1 shl k) * (MaxGrowth(MaxTableCap) div 2) < Hint do
      k := k + 1;
    NewDir(mp, k, nil, 0);
    for i := 0 to (1 shl k) - 1 do
    begin
      t := NewTable(MaxTableCap, PMapDesc(Desc));
      t^.LocalDepth := Int32(k);
      SetEntry(mp, i, t);
    end;
  end;
  Result := mp;
end;

{ The value slot of the eight-byte Key, or nil: Go's mapaccess1_fast64.
  The compiler calls it with the key in a register. After the checks
  nothing here calls, so the hash and the probe run in registers; few
  variables live across the loop, so they all fit (P96). }
function PasMapGetInt(M: Pointer; Key: Integer): Pointer;
var
  h, probe, g, bits, k, step, base: Integer;
begin
  Result := nil;
  if M = nil then
    Exit;
  if PMap(M)^.Used = 0 then
    Exit;
  if PMap(M)^.Writing <> 0 then
    Fatal('paslang: concurrent map read and map write');
  h := (Key rol 32) xor PMap(M)^.Seed;
  h := h xor (h rol 49) xor (h rol 24);
  h := h * X3Mul;
  h := h xor ((h shr 35) + 8);
  h := h * X3Mul;
  h := h xor (h shr 28);
  { a small map's one group is the base, and its probe stays there
    (TabMask 0); a table's is its directory entry }
  if PMap(M)^.TabMask = 0 then
    base := Integer(PMap(M)^.Dir)
  else
    base := PInt(Integer(PMap(M)^.Dir) + DirEnt +
      ((h shr 32) and PInt(Integer(PMap(M)^.Dir) + DirMaskOff)^) * 8)^;
  probe := (h shr 7) and PMap(M)^.TabMask;
  h := (h and 127) * LSB;
  step := 0;
  k := 0;
  while True do
  begin
    g := base + probe * ((PMap(M)^.SlotSize + 1) shl 3);
    bits := PInt(g)^ xor h;
    bits := (bits - LSB) and (bits xor (-1)) and MSB;
    while bits <> 0 do
    begin
      k := g + 8 + ((((bits and (-bits)) shr 7) * SlotIndex) shr 56) * PMap(M)^.SlotSize;
      if PInt(k)^ = Key then
        bits := 0
      else
      begin
        k := 0;
        bits := bits and (bits - 1);
      end;
    end;
    if k <> 0 then
      Break;
    { a small map's group is all of it; a table's probe ends at a group
      with an empty slot }
    if (PMap(M)^.TabMask = 0) or ((PInt(g)^ and ((PInt(g)^ shl 6) xor (-1)) and MSB) <> 0) then
      Break;
    step := step + 1;
    probe := (probe + step) and PMap(M)^.TabMask;
  end;
  if k <> 0 then
    Result := Pointer(k + 8);
end;

{ The value slot of the eight-byte Key, inserted if it was missing:
  Go's mapassign_fast64. The probe calls nothing; a full table is
  rehashed and the probe runs again. Few variables live across the
  probe, so they fit in registers (P96). }
function PasMapPutInt(M: Pointer; Key: Integer; Desc: Pointer): Pointer;
var
  t: PTable;
  h, probe, g, bits, k, step, dg, j, base: Integer;
begin
  if M = nil then
    Fatal('paslang: nil map');
  if PMap(M)^.Writing <> 0 then
    Fatal('paslang: concurrent map writes');
  h := (Key rol 32) xor PMap(M)^.Seed;
  h := h xor (h rol 49) xor (h rol 24);
  h := h * X3Mul;
  h := h xor ((h shr 35) + 8);
  h := h * X3Mul;
  h := h xor (h shr 28);
  PMap(M)^.Writing := PMap(M)^.Writing xor 1;
  Result := nil;
  while Result = nil do
  begin
    { a small map's one group is the base, and its probe stays there
      (TabMask 0); a table's is its directory entry }
    if PMap(M)^.TabMask <> 0 then
      base := PInt(Integer(PMap(M)^.Dir) + DirEnt +
        ((h shr 32) and PInt(Integer(PMap(M)^.Dir) + DirMaskOff)^) * 8)^
    else
      base := Integer(PMap(M)^.Dir);
    probe := (h shr 7) and PMap(M)^.TabMask;
    step := 0;
    k := 0;
    dg := 0;
    while True do
    begin
      g := base + probe * ((PMap(M)^.SlotSize + 1) shl 3);
      bits := PInt(g)^ xor ((h and 127) * LSB);
      bits := (bits - LSB) and (bits xor (-1)) and MSB;
      while bits <> 0 do
      begin
        k := g + 8 + ((((bits and (-bits)) shr 7) * SlotIndex) shr 56) * PMap(M)^.SlotSize;
        if PInt(k)^ = Key then
          bits := 0
        else
        begin
          k := 0;
          bits := bits and (bits - 1);
        end;
      end;
      if k <> 0 then
        Break;
      { The first free slot on the way, empty or deleted, as the address
        of its control byte (a group is 8-aligned, so the low three bits
        are the slot); an empty slot ends the probe, and so does a small
        map's one group. }
      if dg = 0 then
      begin
        bits := PInt(g)^ and MSB;
        if bits <> 0 then
          dg := g + ((((bits and (-bits)) shr 7) * SlotIndex) shr 56);
      end;
      if (PMap(M)^.TabMask = 0) or ((PInt(g)^ and ((PInt(g)^ shl 6) xor (-1)) and MSB) <> 0) then
        Break;
      step := step + 1;
      probe := (probe + step) and PMap(M)^.TabMask;
    end;
    if k <> 0 then
      Result := Pointer(k + 8)
    else if (PMap(M)^.TabMask = 0) and (PMap(M)^.Dir = @EmptyGroup) then
      { a small map's first key: a group of its own, and the probe again }
      SmallGroup(PMap(M), PMapDesc(Desc))
    else if (PMap(M)^.TabMask = 0) and (dg = 0) then
      { a small map's eight slots are taken: a table, and the probe again }
      GrowToTable(PMap(M), PMapDesc(Desc))
    else
    begin
      { A deleted slot is reused without spending growth; an empty one
        needs growth left, or the table grows and the probe runs again.
        A small map has neither: a free slot is taken. }
      t := PTable(base - TableHdr);
      j := (PInt(dg and (-8))^ shr ((dg and 7) * 8)) and 255;
      if (PMap(M)^.TabMask <> 0) and (j <> CtrlDeleted) and (t^.GrowthLeft = 0) then
        Grow(PMap(M), t, h, PMapDesc(Desc))
      else
      begin
        if (PMap(M)^.TabMask <> 0) and (j <> CtrlDeleted) then
          t^.GrowthLeft := Int32(t^.GrowthLeft - 1);
        k := (dg and (-8)) + 8 + (dg and 7) * PMap(M)^.SlotSize;
        PInt(k)^ := Key;
        j := 8;
        while j < PMap(M)^.SlotSize do
        begin
          PInt(k + j)^ := 0;
          j := j + 8;
        end;
        PChar(dg)^ := Char(h and 127);
        if PMap(M)^.TabMask <> 0 then
          t^.Used := Int32(t^.Used + 1);
        PMap(M)^.Used := PMap(M)^.Used + 1;
        Result := Pointer(k + 8);
      end;
    end;
  end;
  PMap(M)^.Writing := PMap(M)^.Writing xor 1;
end;

{ The value slot of the string at Key, or nil: Go's mapaccess1_faststr
  (1.0.65). The hash is XxHash3 of its bytes; the probe is
  PasMapGetInt's, and a candidate's bytes are compared only when its
  length is the key's and its bytes are not the key's own. }
function PasMapGetStr(M, Key, Desc: Pointer): Pointer;
var
  h, probe, g, bits, k, step, base, kp, kn, h2: Integer;
begin
  Result := nil;
  if M = nil then
    Exit;
  if PMap(M)^.Used = 0 then
    Exit;
  if PMap(M)^.Writing <> 0 then
    Fatal('paslang: concurrent map read and map write');
  h := XxHash3(PStr(Key)^, PMap(M)^.Seed);
  kp := PInt(Key)^;
  kn := PInt(Integer(Key) + 8)^;
  { a small map's one group is the base, and its probe stays there
    (TabMask 0); a table's is its directory entry }
  if PMap(M)^.TabMask = 0 then
    base := Integer(PMap(M)^.Dir)
  else
    base := PInt(Integer(PMap(M)^.Dir) + DirEnt +
      ((h shr 32) and PInt(Integer(PMap(M)^.Dir) + DirMaskOff)^) * 8)^;
  probe := (h shr 7) and PMap(M)^.TabMask;
  h2 := (h and 127) * LSB;
  step := 0;
  while True do
  begin
    g := base + probe * ((PMap(M)^.SlotSize + 1) shl 3);
    bits := PInt(g)^ xor h2;
    bits := (bits - LSB) and (bits xor (-1)) and MSB;
    while bits <> 0 do
    begin
      k := g + 8 + ((((bits and (-bits)) shr 7) * SlotIndex) shr 56) * PMap(M)^.SlotSize;
      if PInt(k + 8)^ = kn then
        if (PInt(k)^ = kp) or (PStr(Pointer(k))^ = PStr(Key)^) then
        begin
          Result := Pointer(k + 16);
          Exit;
        end;
      bits := bits and (bits - 1);
    end;
    if (PMap(M)^.TabMask = 0) or ((PInt(g)^ and ((PInt(g)^ shl 6) xor (-1)) and MSB) <> 0) then
      Exit;
    step := step + 1;
    probe := (probe + step) and PMap(M)^.TabMask;
  end;
end;

{ The value slot of the string at Key, inserted if it was missing: Go's
  mapassign_faststr (1.0.65), PasMapPutInt's probe with the comparison
  of PasMapGetStr. The key is stored as its two words, the value as
  zero, as PasMapPut does. }
function PasMapPutStr(M, Key, Desc: Pointer): Pointer;
var
  t: PTable;
  h, probe, g, bits, k, step, dg, j, base, kp, kn: Integer;
begin
  if M = nil then
    Fatal('paslang: nil map');
  if PMap(M)^.Writing <> 0 then
    Fatal('paslang: concurrent map writes');
  h := XxHash3(PStr(Key)^, PMap(M)^.Seed);
  kp := PInt(Key)^;
  kn := PInt(Integer(Key) + 8)^;
  PMap(M)^.Writing := PMap(M)^.Writing xor 1;
  Result := nil;
  while Result = nil do
  begin
    { a small map's one group is the base, and its probe stays there
      (TabMask 0); a table's is its directory entry }
    if PMap(M)^.TabMask <> 0 then
      base := PInt(Integer(PMap(M)^.Dir) + DirEnt +
        ((h shr 32) and PInt(Integer(PMap(M)^.Dir) + DirMaskOff)^) * 8)^
    else
      base := Integer(PMap(M)^.Dir);
    probe := (h shr 7) and PMap(M)^.TabMask;
    step := 0;
    k := 0;
    dg := 0;
    while True do
    begin
      g := base + probe * ((PMap(M)^.SlotSize + 1) shl 3);
      bits := PInt(g)^ xor ((h and 127) * LSB);
      bits := (bits - LSB) and (bits xor (-1)) and MSB;
      while bits <> 0 do
      begin
        k := g + 8 + ((((bits and (-bits)) shr 7) * SlotIndex) shr 56) * PMap(M)^.SlotSize;
        if (PInt(k + 8)^ = kn) and ((PInt(k)^ = kp) or
          (PStr(Pointer(k))^ = PStr(Key)^)) then
          bits := 0
        else
        begin
          k := 0;
          bits := bits and (bits - 1);
        end;
      end;
      if k <> 0 then
        Break;
      if dg = 0 then
      begin
        bits := PInt(g)^ and MSB;
        if bits <> 0 then
          dg := g + ((((bits and (-bits)) shr 7) * SlotIndex) shr 56);
      end;
      if (PMap(M)^.TabMask = 0) or ((PInt(g)^ and ((PInt(g)^ shl 6) xor (-1)) and MSB) <> 0) then
        Break;
      step := step + 1;
      probe := (probe + step) and PMap(M)^.TabMask;
    end;
    if k <> 0 then
      Result := Pointer(k + 16)
    else if (PMap(M)^.TabMask = 0) and (PMap(M)^.Dir = @EmptyGroup) then
      { a small map's first key: a group of its own, and the probe again }
      SmallGroup(PMap(M), PMapDesc(Desc))
    else if (PMap(M)^.TabMask = 0) and (dg = 0) then
      { a small map's eight slots are taken: a table, and the probe again }
      GrowToTable(PMap(M), PMapDesc(Desc))
    else
    begin
      t := PTable(base - TableHdr);
      j := (PInt(dg and (-8))^ shr ((dg and 7) * 8)) and 255;
      if (PMap(M)^.TabMask <> 0) and (j <> CtrlDeleted) and (t^.GrowthLeft = 0) then
        Grow(PMap(M), t, h, PMapDesc(Desc))
      else
      begin
        if (PMap(M)^.TabMask <> 0) and (j <> CtrlDeleted) then
          t^.GrowthLeft := Int32(t^.GrowthLeft - 1);
        k := (dg and (-8)) + 8 + (dg and 7) * PMap(M)^.SlotSize;
        PInt(k)^ := kp;
        PInt(k + 8)^ := kn;
        j := 16;
        while j < PMap(M)^.SlotSize do
        begin
          PInt(k + j)^ := 0;
          j := j + 8;
        end;
        PChar(dg)^ := Char(h and 127);
        if PMap(M)^.TabMask <> 0 then
          t^.Used := Int32(t^.Used + 1);
        PMap(M)^.Used := PMap(M)^.Used + 1;
        Result := Pointer(k + 16);
      end;
    end;
  end;
  PMap(M)^.Writing := PMap(M)^.Writing xor 1;
end;

{ The value slot of Key, or nil. A nil map has no entries. }
function PasMapGet(M, Key, Desc: Pointer): Pointer;
var
  mp: PMap;
  d: PMapDesc;
  k: Pointer;
  h: Integer;
begin
  Result := nil;
  if M = nil then
    Exit;
  mp := PMap(M);
  if mp^.Used = 0 then
    Exit;
  if mp^.Writing <> 0 then
    Fatal('paslang: concurrent map read and map write');
  d := PMapDesc(Desc);
  if d^.KeyKind = 0 then
  begin
    Result := PasMapGetInt(M, PInt(Key)^);
    Exit;
  end;
  h := HashOf(mp, Key, d);
  if mp^.TabMask = 0 then
    k := SmallFind(mp, Key, d, h)
  else
    k := FindSlot(TableFor(mp, h), Key, d, h, mp^.SlotSize);
  if k <> nil then
    Result := Pointer(Integer(k) + d^.KeySize);
end;

{ The key's new slot: the key copied in, the value zero. }
procedure FillSlot(K, Key: Pointer; D: PMapDesc; SS: Integer);
var
  j: Integer;
begin
  Move(Key^, K^, D^.KeySize);
  j := D^.KeySize;
  while j < SS do
  begin
    PInt(Integer(K) + j)^ := 0;
    j := j + 8;
  end;
end;

{ The value slot of Key, inserted if it was missing. The caller stores
  the value there. }
function PasMapPut(M, Key, Desc: Pointer): Pointer;
var
  mp: PMap;
  d: PMapDesc;
  t: PTable;
  h, h2, probe, step, bits, i, ctrl, di, ss, gs: Integer;
  g, k, dg: Pointer;
  pb: PChar;
begin
  if M = nil then
    Fatal('paslang: nil map');
  mp := PMap(M);
  if mp^.Writing <> 0 then
    Fatal('paslang: concurrent map writes');
  d := PMapDesc(Desc);
  if d^.KeyKind = 0 then
  begin
    Result := PasMapPutInt(M, PInt(Key)^, Desc);
    Exit;
  end;
  h := HashOf(mp, Key, d);
  h2 := h and 127;
  ss := mp^.SlotSize;
  gs := (ss + 1) shl 3;
  mp^.Writing := mp^.Writing xor 1;
  Result := nil;
  if mp^.TabMask = 0 then
  begin
    { a small map: the key's slot in its group, else a free one, else
      the eight go into a table and the probe below runs }
    if mp^.Dir = @EmptyGroup then
      SmallGroup(mp, d);
    k := SmallFind(mp, Key, d, h);
    if k <> nil then
      Result := Pointer(Integer(k) + d^.KeySize)
    else
    begin
      k := SmallSlot(mp, h);
      if k <> nil then
      begin
        FillSlot(k, Key, d, ss);
        Result := Pointer(Integer(k) + d^.KeySize);
      end
      else
        GrowToTable(mp, d);
    end;
  end;
  while Result = nil do
  begin
    t := TableFor(mp, h);
    probe := (h shr 7) and t^.Mask;
    step := 0;
    dg := nil;
    di := 0;
    while Result = nil do
    begin
      g := GroupAt(t, probe, gs);
      ctrl := PInt(g)^;
      bits := MatchH2(ctrl, h2);
      while (bits <> 0) and (Result = nil) do
      begin
        i := FirstSlot(bits);
        k := SlotAt(g, i, ss);
        if KeyEq(k, Key, d) then
          Result := Pointer(Integer(k) + d^.KeySize);
        bits := bits and (bits - 1);
      end;
      if Result <> nil then
        Break;
      bits := MatchEmpty(ctrl);
      if bits <> 0 then
      begin
        { End of the probe sequence: the key is new. It goes into the
          first tombstone seen on the way, else into this empty slot. }
        if dg <> nil then
        begin
          g := dg;
          i := di;
        end
        else if t^.GrowthLeft = 0 then
        begin
          Grow(mp, t, h, d);
          Break;
        end
        else
        begin
          i := FirstSlot(bits);
          t^.GrowthLeft := Int32(t^.GrowthLeft - 1);
        end;
        k := SlotAt(g, i, ss);
        FillSlot(k, Key, d, ss);
        pb := PChar(Integer(g) + i);
        pb^ := Char(h2);
        t^.Used := Int32(t^.Used + 1);
        mp^.Used := mp^.Used + 1;
        Result := Pointer(Integer(k) + d^.KeySize);
        Break;
      end;
      if dg = nil then
      begin
        bits := MatchFree(ctrl);
        if bits <> 0 then
        begin
          dg := g;
          di := FirstSlot(bits);
        end;
      end;
      step := step + 1;
      probe := (probe + step) and t^.Mask;
    end;
  end;
  mp^.Writing := mp^.Writing xor 1;
end;

{ Every word of a slot of SS bytes zero: a deleted key or value that
  held a pointer kept its block alive, in a table the collector scans,
  until the slot was used again (1.0.140). }
procedure ZeroSlot(K: Pointer; SS: Integer);
var
  j: Integer;
begin
  j := 0;
  while j < SS do
  begin
    PInt(Integer(K) + j)^ := 0;
    j := j + 8;
  end;
end;

{ True when the key was there. A small map's slot is empty again, as
  Go's deleteSmall: no probe passes through its one group. }
function PasMapDelete(M, Key, Desc: Pointer): Boolean;
var
  mp: PMap;
  d: PMapDesc;
  t: PTable;
  h, h2, probe, step, bits, i, ctrl, ss, gs: Integer;
  g, k: Pointer;
  pb: PChar;
begin
  Result := False;
  if M = nil then
    Exit;
  mp := PMap(M);
  if mp^.Used = 0 then
    Exit;
  if mp^.Writing <> 0 then
    Fatal('paslang: concurrent map writes');
  d := PMapDesc(Desc);
  h := HashOf(mp, Key, d);
  h2 := h and 127;
  ss := mp^.SlotSize;
  gs := (ss + 1) shl 3;
  mp^.Writing := mp^.Writing xor 1;
  if mp^.TabMask = 0 then
  begin
    k := SmallFind(mp, Key, d, h);
    if k <> nil then
    begin
      i := (Integer(k) - Integer(mp^.Dir) - 8) div ss;
      PChar(Integer(mp^.Dir) + i)^ := Char(CtrlEmpty);
      ZeroSlot(k, ss);
      mp^.Used := mp^.Used - 1;
      if mp^.Used = 0 then
        Reseed(mp, d);
      Result := True;
    end;
    mp^.Writing := mp^.Writing xor 1;
    Exit;
  end;
  t := TableFor(mp, h);
  probe := (h shr 7) and t^.Mask;
  step := 0;
  while not Result do
  begin
    g := GroupAt(t, probe, gs);
    ctrl := PInt(g)^;
    bits := MatchH2(ctrl, h2);
    while (bits <> 0) and (not Result) do
    begin
      i := FirstSlot(bits);
      k := SlotAt(g, i, ss);
      if KeyEq(k, Key, d) then
      begin
        t^.Used := Int32(t^.Used - 1);
        mp^.Used := mp^.Used - 1;
        pb := PChar(Integer(g) + i);
        if MatchEmpty(ctrl) <> 0 then
        begin
          { A group with an empty slot ends every probe that reaches
            it, so this slot can be empty again. }
          pb^ := Char(CtrlEmpty);
          t^.GrowthLeft := Int32(t^.GrowthLeft + 1);
        end
        else
          pb^ := Char(CtrlDeleted);
        ZeroSlot(k, ss);
        if mp^.Used = 0 then
          Reseed(mp, d);
        Result := True;
      end;
      bits := bits and (bits - 1);
    end;
    if Result then
      Break;
    if MatchEmpty(ctrl) <> 0 then
      Break;
    step := step + 1;
    probe := (probe + step) and t^.Mask;
  end;
  mp^.Writing := mp^.Writing xor 1;
end;

{ The next key slot for a for loop, or nil at the end. The loop walks
  a copy of the directory it started on (so a table that grows or splits
  meanwhile does not move under it), each table once, at its first entry
  (the one below 2^LocalDepth), from a random entry and a random slot.
  When a table has been replaced since (Gen moved), a key is looked up
  again in the map, so an entry deleted during the loop is not returned,
  an updated value is the current one, and no key comes twice. A loop
  over a small map walks its group (Live 255) from a random slot; when
  the map is no longer that group (it grew into a table), a key is
  looked up again in the same way. }
function PasMapNext(M, It, Desc: Pointer): Pointer;
var
  mp: PMap;
  d: PMapDesc;
  ip: PIter;
  t, ct: PTable;
  depth, dir, e, i, de, dd, s, h, n, ss, gs, mk, lim, pr: Integer;
  g, k, p: Pointer;
begin
  Result := nil;
  if M = nil then
    Exit;
  mp := PMap(M);
  d := PMapDesc(Desc);
  ip := PIter(It);
  ss := mp^.SlotSize;
  if ip^.Live = 0 then
  begin
    if mp^.Used = 0 then
      Exit;
    if mp^.TabMask = 0 then
    begin
      ip^.Dir := mp^.Dir;
      ip^.Live := 255;
    end
    else
    begin
      if mp^.Depth = 0 then
        ip^.Dir := Pointer(PInt(Integer(mp^.Dir) + DirEnt)^ - TableHdr)
      else
      begin
        n := 1 shl mp^.Depth;
        GetMem(p, n * 8);
        Move(Pointer(Integer(mp^.Dir) + DirEnt)^, p^, n * 8);
        ip^.Dir := p;
      end;
      ip^.Live := GenAt(mp)^ * 256 + mp^.Depth + 1;
    end;
    ip^.Probe := 0;
    ip^.Start := (mp^.Seed shr 13) and 1073741823;
  end;
  if mp^.Writing <> 0 then
    Fatal('paslang: concurrent map iteration and map write');
  if ip^.Live = 255 then
  begin
    while ip^.Probe < SmallMax do
    begin
      i := (ip^.Probe + ip^.Start) and 7;
      ip^.Probe := ip^.Probe + 1;
      g := ip^.Dir;
      if ((PInt(g)^ shr (8 * i)) and 128) = 0 then
      begin
        k := SlotAt(g, i, ss);
        if mp^.Dir <> ip^.Dir then
          k := FindAny(mp, k, d);
        if k <> nil then
        begin
          Result := k;
          Exit;
        end;
      end;
    end;
    Exit;
  end;
  { the probe in a register, written back as the call leaves; Probe and
    Start are never negative, so a division by MaxTableCap is a shift }
  depth := (ip^.Live and 255) - 1;
  lim := MaxTableCap shl depth;
  dir := Integer(ip^.Dir);
  gs := (ss + 1) shl 3;
  pr := ip^.Probe;
  while pr < lim do
  begin
    de := pr shr 10;
    s := pr and (MaxTableCap - 1);
    if depth = 0 then
    begin
      dd := 0;
      t := PTable(dir);
    end
    else
    begin
      dd := (de + (ip^.Start shr 10)) and ((1 shl depth) - 1);
      t := PTable(PInt(dir + dd * 8)^ - TableHdr);
    end;
    mk := t^.Mask;
    if ((dd shr t^.LocalDepth) <> 0) or ((s shr 3) > mk) then
    begin
      pr := (de + 1) shl 10;
      Continue;
    end;
    pr := pr + 1;
    { the slot of the run's offset in this table: its capacity is
      (mk + 1) * 8, a power of two }
    e := (s + ip^.Start) and ((mk shl 3) + 7);
    g := Pointer(Integer(t) + TableHdr + (e shr 3) * gs);
    i := e and 7;
    if ((PInt(g)^ shr (8 * i)) and 128) = 0 then
    begin
      k := SlotAt(g, i, ss);
      if GenAt(mp)^ <> (ip^.Live shr 8) then
      begin
        h := HashOf(mp, k, d);
        ct := TableFor(mp, h);
        if ct <> t then
          k := FindSlot(ct, k, d, h, ss);
      end;
      if k <> nil then
      begin
        ip^.Probe := pr;
        Result := k;
        Exit;
      end;
    end;
  end;
  ip^.Probe := pr;
end;

{ Empty the map in place, every table kept at its size (as Go's clear
  keeps them), a small map's group too, and draw a new seed. The slots
  are zeroed too (1.0.140): only the control words were, and every
  pointer the cleared entries held stayed alive for the collector. }
procedure PasMapClear(M, Desc: Pointer);
var
  mp: PMap;
  t: PTable;
  i, j, n, b, gs: Integer;
  w: PInt;
begin
  if M = nil then
    Exit;
  mp := PMap(M);
  if mp^.Writing <> 0 then
    Fatal('paslang: concurrent map writes');
  mp^.Writing := mp^.Writing xor 1;
  gs := (mp^.SlotSize + 1) shl 3;
  if mp^.TabMask = 0 then
  begin
    if mp^.Dir <> @EmptyGroup then
    begin
      w := PInt(mp^.Dir);
      ZeroSlot(Pointer(Integer(w) + 8), gs - 8);
      w^ := WordEmpty;
    end;
  end
  else
  begin
    n := 1 shl mp^.Depth;
    for j := 0 to n - 1 do
    begin
      t := PTable(PInt(Integer(mp^.Dir) + DirEnt + j * 8)^ - TableHdr);
      if (j shr t^.LocalDepth) = 0 then
      begin
        for i := 0 to t^.Mask do
        begin
          w := PInt(GroupAt(t, i, gs));
          b := 8;
          while b < gs do
          begin
            PInt(Integer(w) + b)^ := 0;
            b := b + 8;
          end;
          w^ := WordEmpty;
        end;
        t^.Used := Int32(0);
        t^.GrowthLeft := Int32(MaxGrowth(Capacity(t)));
      end;
    end;
  end;
  mp^.Used := 0;
  Reseed(mp, PMapDesc(Desc));
  mp^.Writing := mp^.Writing xor 1;
end;

end.
