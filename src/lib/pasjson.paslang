    orq %rbx, %rbp
    movq %rax, %rcx
    notq %rcx
    andq %rcx, %rbp
    movq 64(%rsp), %r14
    orq 32(%rsp), %r14
    andq %rax, %r14
    orq %r14, %rbp
    orq %rdi, %rbp
    movq %rbp, %rbx
    movq %rbx, %rcx
    shrq $1, %rcx
    andq 72(%rsp), %rcx
    subq %rcx, %rbx
    movq %rbx, %rcx
    shrq $2, %rcx
    andq 80(%rsp), %rcx
    andq 80(%rsp), %rbx
    addq %rcx, %rbx
    movq %rbx, %rcx
    shrq $4, %rcx
    addq %rcx, %rbx
    andq 88(%rsp), %rbx
    imulq 96(%rsp), %rbx
    shrq $56, %rbx
    testq %rbp, %rbp
    jz 4f
    .p2align 5
    2:
    bsfq %rbp, %rax
    addl %r8d, %eax
    movl %eax, (%rdx)
    leaq -1(%rbp), %rcx
    andq %rcx, %rbp
    bsfq %rbp, %rax
    addl %r8d, %eax
    movl %eax, 4(%rdx)
    leaq -1(%rbp), %rcx
    andq %rcx, %rbp
    bsfq %rbp, %rax
    addl %r8d, %eax
    movl %eax, 8(%rdx)
    leaq -1(%rbp), %rcx
    andq %rcx, %rbp
    bsfq %rbp, %rax
    addl %r8d, %eax
    movl %eax, 12(%rdx)
    leaq -1(%rbp), %rcx
    andq %rcx, %rbp
    bsfq %rbp, %rax
    addl %r8d, %eax
    movl %eax, 16(%rdx)
    leaq -1(%rbp), %rcx
    andq %rcx, %rbp
    bsfq %rbp, %rax
    addl %r8d, %eax
    movl %eax, 20(%rdx)
    leaq -1(%rbp), %rcx
    andq %rcx, %rbp
    bsfq %rbp, %rax
    addl %r8d, %eax
    movl %eax, 24(%rdx)
    leaq -1(%rbp), %rcx
    andq %rcx, %rbp
    bsfq %rbp, %rax
    addl %r8d, %eax
    movl %eax, 28(%rdx)
    leaq -1(%rbp), %rcx
    andq %rcx, %rbp
    addq $32, %rdx
    subq $8, %rbx
    ja 2b
    leaq (%rdx,%rbx,4), %rdx
    4:
    addq $64, %rsi
    addq $64, %r8
    jmp 1b
    9:
    movq 16(%rsp), %rdi
    movq %r9, (%rdi)
    movq %r10, 8(%rdi)
    movq %r11, 16(%rdi)
    addq %r12, 24(%rdi)
    addq %r13, 32(%rdi)
    addq %r15, 40(%rdi)
    movq %rdx, %rax
    subq 24(%rsp), %rax
    shrq $2, %rax
    addq $104, %rsp
    popq %r14
    popq %rbp
  end;
{$endif}
end;

{ The kernel of the processor the unit is compiled for (P148): AVX2's
  in the build for x86-64-v3 (P143), the base's in the base build. }
function JsonBlocks(P: Pointer; NBlocks: Int64; var S: TPasJsonScan; Idx: Pointer; Off: Int64): Int64;
begin
{$if defined(CPU_AVX2) and defined(CPU_BMI1) and defined(CPU_POPCNT)}
  Result := PasJsonIndexCpu(P, NBlocks, S, Idx, Off);
{$else}
  Result := PasJsonIndexBase(P, NBlocks, S, Idx, Off);
{$endif}
end;

{ NBlocks whole blocks of 64 bytes from P, through the kernel of the
  build in calls of at most JsonMaxBlocks: the scan of a text that goes
  on (a stream, P208). Idx has room for 64 * NBlocks + 8 places. }
function PasJsonIndexBlocks(P: Pointer; NBlocks: Int64; var S: TPasJsonScan; Idx: Pointer; Off: Int64): Int64;
var
  done, take: Int64;
begin
  Result := 0;
  done := 0;
  while done < NBlocks do
  begin
    take := NBlocks - done;
    if take > JsonMaxBlocks then
      take := JsonMaxBlocks;
    Result := Result + JsonBlocks(@PByte(P)[done shl 6], take, S, @PUInt32(Idx)[Result],
      Off + (done shl 6));
    done := done + take;
  end;
end;

{ The scan of the whole text P[0..N-1], whose first byte is at Off:
  its whole blocks through the kernel, the rest copied into a local
  block of spaces, so nothing past P[N-1] is read; the text then ends
  as if spaces followed it (S.InStr says whether a string is left
  open). Idx has room for N + 8 places. }
function PasJsonIndex(P: Pointer; N: Int64; var S: TPasJsonScan; Idx: Pointer; Off: Int64): Int64;
var
  blk: array[0..63] of Byte;
  nb, t: Int64;
begin
  Result := 0;
  if N <= 0 then
    Exit;
  nb := N shr 6;
  Result := PasJsonIndexBlocks(P, nb, S, Idx, Off);
  t := N - (nb shl 6);
  if t > 0 then
  begin
    FillChar(blk, 64, 32);
    Move(PByte(P)[nb shl 6], blk[0], t);
    Result := Result + JsonBlocks(@blk[0], 1, S, @PUInt32(Idx)[Result], Off + (nb shl 6));
  end;
end;

{ ---- The escape finder ---- }

{ The place from 0 of the first byte of P[0..N-1] that JSON writes
  escaped (a quote, a backslash, a byte below 20h; and the ampersand
  and the angle brackets when Html says), -1 when there is none: the
  reference the kernels are held to. }
function PasJsonEscIndexPlain(P: Pointer; N: Int64; Html: Boolean): Int64;
var
  i, b, c: Int64;
begin
  Result := -1;
  for i := 0 to N - 1 do
  begin
    b := PByte(P)[i];
    if Html then
      c := JsonEscHiHtml[b shr 4] and JsonEscLo[b and 15]
    else
      c := JsonEscHi[b shr 4] and JsonEscLo[b and 15];
    if c <> 0 then
    begin
      Result := i;
      Exit;
    end;
  end;
end;

{ AVX2 with BMI1, 32 bytes a step from P rounded down to 32: VPSHUFB of
  the two tables (SDM vol. 2B 4-423), VPTEST (4-498) to tell a block
  with a byte to escape, VPCMPEQB and VPMOVMSKB for its mask, from which
  the bytes before P are shifted out, TZCNT for the first; a block that
  begins past P[N-1] is never read, and a byte found past it is none.
  An aligned block of 32 never crosses a page, so every block read has
  a byte of the string in it and is mapped. NEON, 16 bytes a step from
  P rounded down to 16: TBL of the tables, UMAXV (C7.2.421) to tell a
  byte to escape, CMTST and SHRN by 4 (C7.2.300: four bits a byte), RBIT
  and CLZ for the first. }
function PasJsonEscIndexCpu(P: Pointer; N: Int64; Html: Boolean): Int64;
begin
  asm amd64 (P: in rsi; N: in rbx; Html: in rcx; Result: out rax)
    testq %rbx, %rbx
    jle 8f
    movabsq $0x0109010101030101, %rax
    vmovq %rax, %xmm8
    movabsq $0x0121011501010101, %rax
    vpinsrq $1, %rax, %xmm8, %xmm8
    vinserti128 $1, %xmm8, %ymm8, %ymm8
    movabsq $0x00000400300A0101, %rax
    movabsq $0x0000040000020101, %rdx
    testq %rcx, %rcx
    cmovzq %rdx, %rax
    vmovq %rax, %xmm9
    vinserti128 $1, %xmm9, %ymm9, %ymm9
    movl $0x0F, %eax
    vmovd %eax, %xmm10
    vpbroadcastb %xmm10, %ymm10
    vpxor %ymm11, %ymm11, %ymm11
    leaq (%rsi,%rbx), %rdx
    movq %rsi, %rdi
    andq $-32, %rdi
    .p2align 5
    1:
    vmovdqa (%rdi), %ymm0
    vpsrlw $4, %ymm0, %ymm1
    vpand %ymm10, %ymm1, %ymm1
    vpshufb %ymm1, %ymm9, %ymm1
    vpshufb %ymm0, %ymm8, %ymm2
    vpand %ymm2, %ymm1, %ymm1
    vptest %ymm1, %ymm1
    jnz 3f
    .p2align 5
    2:
    addq $32, %rdi
    cmpq %rdx, %rdi
    jb 1b
    jmp 8f
    3:
    vpcmpeqb %ymm11, %ymm1, %ymm1
    vpmovmskb %ymm1, %eax
    notl %eax
    cmpq %rsi, %rdi
    jae 4f
    movl %esi, %ecx
    subl %edi, %ecx
    shrl %cl, %eax
    shll %cl, %eax
    4:
    testl %eax, %eax
    jz 2b
    tzcntl %eax, %eax
    addq %rdi, %rax
    subq %rsi, %rax
    cmpq %rbx, %rax
    jb 9f
    8:
    movq $-1, %rax
    9:
  end;
  asm arm64 (P: in x0; N: in x1; Html: in x2; Result: out x0)
    cmp x1, #0
    b.le 8f
    movz x6, #0x0101
    movk x6, #0x0103, lsl #16
    movk x6, #0x0101, lsl #32
    movk x6, #0x0109, lsl #48
    mov v16.d[0], x6
    movz x6, #0x0101
    movk x6, #0x0101, lsl #16
    movk x6, #0x0115, lsl #32
    movk x6, #0x0121, lsl #48
    mov v16.d[1], x6
    movz x6, #0x0101
    movk x6, #0x300A, lsl #16
    movk x6, #0x0400, lsl #32
    movz x7, #0x0101
    movk x7, #0x0002, lsl #16
    movk x7, #0x0400, lsl #32
    cmp x2, #0
    csel x6, x7, x6, eq
    fmov d17, x6
    movi v18.16b, #0x0F
    add x3, x0, x1
    bic x4, x0, #15
    .p2align 5
    1:
    ldr q0, [x4]
    and v1.16b, v0.16b, v18.16b
    ushr v2.16b, v0.16b, #4
    tbl v1.16b, {v16.16b}, v1.16b
    tbl v2.16b, {v17.16b}, v2.16b
    and v1.16b, v1.16b, v2.16b
    umaxv b2, v1.16b
    umov w5, v2.b[0]
    cbnz w5, 3f
    .p2align 5
    2:
    add x4, x4, #16
    cmp x4, x3
    b.lo 1b
    b 8f
    3:
    cmtst v1.16b, v1.16b, v1.16b
    shrn v1.8b, v1.8h, #4
    fmov x5, d1
    cmp x4, x0
    b.hs 4f
    sub x6, x0, x4
    lsl x6, x6, #2
    lsr x5, x5, x6
    lsl x5, x5, x6
    4:
    cbz x5, 2b
    rbit x5, x5
    clz x5, x5
    add x5, x4, x5, lsr #2
    sub x5, x5, x0
    cmp x5, x1
    b.lo 9f
    .p2align 5
    8:
    mov x0, #-1
    b 10f
    9:
    mov x0, x5
    10:
  end;
end;

{ The base processor's: SSE2 alone on amd64, 16 bytes a step from P
  rounded down to 16, PCMPEQB for the quote, the backslash and the HTML
  bytes (ANDed with a mask of Html), a control byte as one whose
  minimum with 20h (PMINUB) is not 20h, BSF for the first; the same
  NEON on arm64. }
function PasJsonEscIndexBase(P: Pointer; N: Int64; Html: Boolean): Int64;
begin
{$ifdef CPUAARCH64}
  Result := PasJsonEscIndexCpu(P, N, Html);
{$else}
  asm amd64 (P: in rsi; N: in rbx; Html: in rcx; Result: out rax)
    testq %rbx, %rbx
    jle 8f
    movl $0x22222222, %eax
    movd %eax, %xmm8
    pshufd $0, %xmm8, %xmm8
    movl $0x5C5C5C5C, %eax
    movd %eax, %xmm9
    pshufd $0, %xmm9, %xmm9
    movl $0x20202020, %eax
    movd %eax, %xmm10
    pshufd $0, %xmm10, %xmm10
    movl $0x26262626, %eax
    movd %eax, %xmm11
    pshufd $0, %xmm11, %xmm11
    movl $0x3C3C3C3C, %eax
    movd %eax, %xmm12
    pshufd $0, %xmm12, %xmm12
    movl $0x3E3E3E3E, %eax
    movd %eax, %xmm13
    pshufd $0, %xmm13, %xmm13
    movq %rcx, %rax
    negq %rax
    movq %rax, %xmm14
    punpcklqdq %xmm14, %xmm14
    leaq (%rsi,%rbx), %rdx
    movq %rsi, %rdi
    andq $-16, %rdi
    .p2align 5
    1:
    movdqa (%rdi), %xmm0
    movdqa %xmm0, %xmm1
    pminub %xmm10, %xmm1
    pcmpeqb %xmm10, %xmm1
    movdqa %xmm0, %xmm2
    pcmpeqb %xmm8, %xmm2
    movdqa %xmm0, %xmm3
    pcmpeqb %xmm9, %xmm3
    por %xmm3, %xmm2
    movdqa %xmm0, %xmm3
    pcmpeqb %xmm11, %xmm3
    movdqa %xmm0, %xmm4
    pcmpeqb %xmm12, %xmm4
    por %xmm4, %xmm3
    movdqa %xmm0, %xmm4
    pcmpeqb %xmm13, %xmm4
    por %xmm4, %xmm3
    pand %xmm14, %xmm3
    por %xmm3, %xmm2
    pmovmskb %xmm1, %eax
    xorl $0xFFFF, %eax
    pmovmskb %xmm2, %ecx
    orl %ecx, %eax
    jnz 3f
    .p2align 5
    2:
    addq $16, %rdi
    cmpq %rdx, %rdi
    jb 1b
    jmp 8f
    3:
    cmpq %rsi, %rdi
    jae 4f
    movl %esi, %ecx
    subl %edi, %ecx
    shrl %cl, %eax
    shll %cl, %eax
    4:
    testl %eax, %eax
    jz 2b
    bsfl %eax, %eax
    addq %rdi, %rax
    subq %rsi, %rax
    cmpq %rbx, %rax
    jb 9f
    8:
    movq $-1, %rax
    9:
  end;
{$endif}
end;

{ The kernel of the build over a text longer than JsonMaxBlocks blocks
  of 64 bytes: that much a call (P270), the loop head between two where
  the routine can be stopped; a slice holding none, the next. }
function JsonEscIndexLong(P: Pointer; N: Int64; Html: Boolean): Int64;
var
  done, take, r: Int64;
begin
  Result := -1;
  done := 0;
  while done < N do
  begin
    take := N - done;
    if take > JsonMaxBlocks shl 6 then
      take := JsonMaxBlocks shl 6;
{$if defined(CPU_AVX2) and defined(CPU_BMI1)}
    r := PasJsonEscIndexCpu(@PByte(P)[done], take, Html);
{$else}
    r := PasJsonEscIndexBase(@PByte(P)[done], take, Html);
{$endif}
    if r >= 0 then
    begin
      Result := done + r;
      Exit;
    end;
    done := done + take;
  end;
end;

{ The first byte of P[0..N-1] to write escaped, -1 for none, by the
  kernel of the build: AVX2's in the build for x86-64-v3, the base's
  in the base build; a text longer than JsonMaxBlocks blocks a slice
  at a time (P270). }
function PasJsonEscIndex(P: Pointer; N: Int64; Html: Boolean): Int64;
begin
  if N > JsonMaxBlocks shl 6 then
    Result := JsonEscIndexLong(P, N, Html)
  else
{$if defined(CPU_AVX2) and defined(CPU_BMI1)}
    Result := PasJsonEscIndexCpu(P, N, Html);
{$else}
    Result := PasJsonEscIndexBase(P, N, Html);
{$endif}
end;


{$if PASLANG_FULLVERSION >= 1001124}
{ ---- The document (P203) ---- }

const
  JsonHead = 32;      { the document's header: its mark, its nodes, the end of its arena, its text's length }
  JsonMagic = $4E4F534A53415001;
  JtNull = 0;
  JtFalse = 1;
  JtTrue = 2;
  JtNum = 3;
  JtStr = 4;
  JtArr = 5;
  JtObj = 6;
  JfNoEsc = 8;
  JfFlat = 8;
  JnInt = 0;
  JnUint = 8;
  JnFloat = 16;
  JnHuge = 24;
  JnIntLit = 32;
  JsonWin = 65536;
  { an object's names are checked for twins one by one up to this many,
    then through a set: Go's objectNamespace switches to its map past 64 }
  JsonLinear = 64;
  JsonMaxDoc = 4294967295;
  JsonDepthMax = 10000;
  { U+2026, the horizontal ellipsis of a pointer cut short }
  Ellipsis = #226#128#166;

  { the parser's states }
  SValue = 0;     { a value: the top level, after a colon, after a comma in an array }
  SArrFirst = 1;  { after an opening bracket: a value or the closing one }
  SObjFirst = 2;  { after an opening brace: a name or the closing one }
  SObjName = 3;   { after a comma in an object: a name }
  SColon = 4;     { after a name: a colon }
  SAfter = 5;     { after a value }

  { where an error is, for its pointer (Go's appendStackPointer) }
  WhereNext = 1;      { in the value that comes, or in the name: the member or the element }
  WhereAt = 0;      { between two tokens: the container, or the member after its name }

type
  PJNode = ^TJNode;
  TJNode = record
    W0, W1: Int64;
  end;

  PJFrame = ^TJFrame;
  TJFrame = record
    Node: Int64;      { the container's node, from the first node }
    Count: Int64;     { its elements or members done }
    Name: Int64;      { an object: the node of its last name }
    Obj: Boolean;
    Flat: Boolean;
    NSet: Int64;      { past JsonLinear members: the names in Names }
    Names: array of Int64;
    Mark: Int64;      { stream: where its names begin in the arena (P280) }
  end;

  TJErr = record
    Kind: Integer;    { 0 syntax, 1 encoding, 2 duplicate, 3 depth, 4 too large }
    Offset: Int64;
    Path: string;
    Reason: string;
  end;

  TJParse = record
    T: PByte;
    N: Int64;
    Doc: array of Byte;
    D: PByte;          { @Doc[0] }
    Nodes: Int64;      { nodes written }
    NodeCap: Int64;
    Arena: Int64;      { the arena's next byte, from D }
    ArenaEnd: Int64;
    Idx: TJsonPlaces;
    NIdx, I, Done0: Int64;
    Scan: TPasJsonScan;
    St: array of TJFrame;
    Depth: Int64;
    MaxDepth: Int64;
    State: Integer;
    Bad: Int64;        { the first byte that is not UTF-8, -1 none }
    Seed: Int64;
    Plain: Boolean;    { the Plain parser: a byte at a time, no index }
    Cur: Int64;        { its next byte }
    Failed: Boolean;
    Err: TJErr;
    Stream: Boolean;   { read a token at a time for a decode, no document (P280) }
    NTop: Int64;       { stream: the end of the open objects' names in the arena }
    ValAt: Int64;      { stream: where the last value read starts }
    NameAt: Int64;     { stream: where the last name read starts }
    Top: PJFrame;      { stream: the innermost open container's frame }
    IdxP: PUInt32;     { stream: the index's first entry }
    Idx2: array of UInt32;  { stream: the window StCount reads ahead with }
    Ahead: Int64;      { stream: the bytes StCount may still read ahead }
  end;
  PJParse = ^TJParse;

var
  JSeedKey: Integer;     { the process's secret key for the name sets: 0 until the first }
  JSeedCount: Integer;   { the sets seeded so far }

{ ---- errors ---- }

function HexDigit(V: Integer): Char;
begin
  if V < 10 then
    Result := Chr(48 + V)
  else
    Result := Chr(87 + V);
end;

{ The character at T[Off] (RFC 3629 3), its bytes in N: -1 when they
  are not UTF-8 (an overlong form, a surrogate, past U+10FFFF, cut). }
function DecodeAt(var P: TJParse; Off: Int64; out N: Int64): Integer;
var
  b, k, c, lo: Integer;
begin
  Result := -1;
  N := 1;
  b := P.T[Off];
  if b < $80 then
  begin
    Result := b;
    Exit;
  end;
  if (b >= $C2) and (b <= $DF) then
  begin
    N := 2;
    c := b and $1F;
    lo := $80;
  end
  else if (b >= $E0) and (b <= $EF) then
  begin
    N := 3;
    c := b and $0F;
    lo := $800;
  end
  else if (b >= $F0) and (b <= $F4) then
  begin
    N := 4;
    c := b and $07;
    lo := $10000;
  end
  else
    Exit;
  if Off + N > P.N then
  begin
    N := 1;
    Exit;
  end;
  for k := 1 to N - 1 do
  begin
    if (P.T[Off + k] and $C0) <> $80 then
    begin
      N := 1;
      Exit;
    end;
    c := (c shl 6) or (P.T[Off + k] and $3F);
  end;
  if (c < lo) or (c > $10FFFF) or ((c >= $D800) and (c <= $DFFF)) then
  begin
    N := 1;
    Exit;
  end;
  Result := c;
end;

function Hex4Text(V: Integer; Digits: Integer): string;
var
  k: Integer;
begin
  Result := '';
  for k := Digits - 1 downto 0 do
    Result := Result + HexDigit((V shr (4 * k)) and 15);
end;

function TextAt(var P: TJParse; Off, N: Int64): string;
var
  k: Int64;
begin
  if Off + N > P.N then
    N := P.N - Off;
  SetLength(Result, N);
  for k := 1 to N do
    Result[k] := Chr(P.T[Off + k - 1]);
end;

const
  { Go's strconv.IsPrint tables (src/strconv/isprint.go, from Go's
    unicode tables by its makeisprint.go): ranges of printable
    characters in pairs, and the ones inside them that are not }
  JsonPrint16: array[0..411] of Word = (
    $0020, $007E, $00A1, $0377, $037A, $037F, $0384, $0556,
    $0559, $058A, $058D, $05C7, $05D0, $05EA, $05EF, $05F4,
    $0606, $070D, $0710, $074A, $074D, $07B1, $07C0, $07FA,
    $07FD, $082D, $0830, $085B, $085E, $086A, $0870, $088F,
    $0897, $098C, $098F, $0990, $0993, $09B2, $09B6, $09B9,
    $09BC, $09C4, $09C7, $09C8, $09CB, $09CE, $09D7, $09D7,
    $09DC, $09E3, $09E6, $09FE, $0A01, $0A0A, $0A0F, $0A10,
    $0A13, $0A39, $0A3C, $0A42, $0A47, $0A48, $0A4B, $0A4D,
    $0A51, $0A51, $0A59, $0A5E, $0A66, $0A76, $0A81, $0AB9,
    $0ABC, $0ACD, $0AD0, $0AD0, $0AE0, $0AE3, $0AE6, $0AF1,
