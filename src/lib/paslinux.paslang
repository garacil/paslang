{$mode objfpc}{$H+}

{ GNU/Linux system calls. No libc and no assembler: Syscall is the compiler. }
unit paslinux;

interface

const
  SysRead   = 0;
  SysWrite  = 1;
  SysOpen   = 2;
  SysClose  = 3;
  SysPoll   = 7;
  SysPipe   = 22;
  SysDup2   = 33;
  SysSocket = 41;
  SysConnect = 42;
  SysFork   = 57;
  SysExecve = 59;
  SysExit   = 60;
  SysWait4  = 61;
  SysAccess = 21;
  SysMkdir  = 83;
  SysFstat  = 5;
  SysGetdents64 = 217;

  AfUnix = 1;
  SockStream = 1;

  ORdonly = 0;
  OWronly = 1;
  ORdwr   = 2;
  OAppend = 1024;
  OCreat  = 64;
  OExcl   = 128;
  OTrunc  = 512;
  ONonblock = 2048;
  ODirectory = 65536;

function Sys0(Nr: Int64): Int64;
function Sys1(Nr, A: Int64): Int64;
function Sys2(Nr, A, B: Int64): Int64;
function Sys3(Nr, A, B, C: Int64): Int64;
function Sys4(Nr, A, B, C, D: Int64): Int64;

{ Portable file and process calls. The constants above stay the amd64
  numbers so existing call sites keep working there. arm64 has no
  open, mkdir, access, pipe, dup2, poll, or fork. }
function OsOpen(Path, Flags, Mode: Int64): Int64;
function OsOpenAt(DirFd, Path, Flags, Mode: Int64): Int64;
function OsClose(Fd: Int64): Int64;
function OsRead(Fd, Buf, N: Int64): Int64;
function OsWrite(Fd, Buf, N: Int64): Int64;
function OsMkdir(Path, Mode: Int64): Int64;
function OsAccess(Path, Mode: Int64): Int64;
function OsFork: Int64;
function OsExec(Path, Argv, Env: Int64): Int64;
function OsExit(Code: Int64): Int64;
function OsWait(Pid, Status, Opts, Rusage: Int64): Int64;
function OsPipe(Buf: Int64): Int64;
function OsDup2(OldFd, NewFd: Int64): Int64;
function OsGetdents(Fd, Buf, N: Int64): Int64;
function OsFstat(Fd, Buf: Int64): Int64;
function OsPoll(Fds, Nfds, TimeoutMs: Int64): Int64;
function OsReadlink(Path, Buf, N: Int64): Int64;

{ Read-only initial process environment, copied before user code.
  Entry indexes are 1-based; out-of-range entries are empty. }
function ProcessEnvironmentCount: Integer;
function ProcessEnvironmentEntry(Index: Integer): string;
function LookupProcessEnvironment(const Name: string; out Value: string): Boolean;

{ System call numbers for the child of a fork, which may only run raw
  Sys1..Sys4 calls: no prologue and no stack check between fork and
  execve. Read them before the fork. NrDup2 is dup2 on amd64 and dup3 on
  arm64; both take the old and the new descriptor first. }
function NrExecve: Int64;
function NrExit: Int64;
function NrClose: Int64;
function NrDup2: Int64;

implementation

{$WARN 4055 OFF}

type PInitialEnv = ^PChar;
var
  InitialEnvironment: array of string;
{$ifndef FPC}
  EnvironmentNames: map[string] of Integer;
{$endif}

{ Current Go runtime/runtime1.go goenvs_unix: envp follows argv's
  terminating pointer, at argc+1. Linux's exec ABI owns/validates these
  NUL-terminated objects, unlike arbitrary user PChar buffers. No raw
  pointer escapes this unit. Debugger DropArgs preserves this location.
  Intel SDM MOV/LEA and ARM ARM ADRP/LDR/ADD were read for these stubs. }
function InitialEnvironmentStart: Pointer;
begin
{$ifdef FPC}
  Result := Pointer(Envp);
{$else}
  asm amd64 (Result: out rax)
    movq rt_argv(%rip), %rax
    movq rt_argc(%rip), %rcx
    leaq 8(%rax,%rcx,8), %rax
  end;
  asm arm64 (Result: out x0)
    adrp x0, rt_argv
    ldr x0, [x0, :lo12:rt_argv]
    adrp x1, rt_argc
    ldr x1, [x1, :lo12:rt_argc]
    add x1, x1, #1
    add x0, x0, x1, lsl #3
  end;
{$endif}
end;

procedure CopyInitialEnvironment;
var entries: PInitialEnv; bytes: PChar; count, i, size: Integer;
{$ifndef FPC}
  separator: Integer;
  key: string;
{$endif}
begin
  entries := PInitialEnv(InitialEnvironmentStart);
  count := 0;
  if entries <> nil then while entries[count] <> nil do Inc(count);
  SetLength(InitialEnvironment, count);
{$ifndef FPC}
  New(EnvironmentNames, count);
{$endif}
  for i := 0 to count - 1 do
  begin
    bytes := entries[i];
    size := 0;
    while bytes[size] <> #0 do Inc(size);
    SetLength(InitialEnvironment[i], size);
    if size > 0 then Move(bytes^, InitialEnvironment[i][1], size);
{$ifndef FPC}
    separator := Pos('=', InitialEnvironment[i]);
    if separator > 1 then
    begin
      key := Copy(InitialEnvironment[i], 1, separator - 1);
      if not (key in EnvironmentNames) then EnvironmentNames[key] := i + 1;
    end;
{$endif}
  end;
end;

function ProcessEnvironmentCount: Integer;
begin
  Result := Length(InitialEnvironment);
end;

function ProcessEnvironmentEntry(Index: Integer): string;
begin
  Result := '';
  if (Index > 0) and (Index <= Length(InitialEnvironment)) then
    Result := InitialEnvironment[Index - 1];
end;

function LookupProcessEnvironment(const Name: string; out Value: string): Boolean;
var index: Integer;
{$ifndef FPC}
  separator: Integer;
{$endif}
begin
  Result := False;
  Value := '';
  if (Name = '') or (Pos('=', Name) > 0) or (Pos(#0, Name) > 0) then Exit;
{$ifdef FPC}
  for index := 0 to High(InitialEnvironment) do
    if (Copy(InitialEnvironment[index], 1, Length(Name)) = Name) and
      (Length(InitialEnvironment[index]) > Length(Name)) and
      (InitialEnvironment[index][Length(Name) + 1] = '=') then
    begin
      Value := Copy(InitialEnvironment[index], Length(Name) + 2);
      Result := True;
      Exit;
    end;
{$else}
  if TryGet(EnvironmentNames, Name, index) then
  begin
    separator := Length(Name) + 1;
    Value := Copy(InitialEnvironment[index - 1], separator + 1);
    Result := True;
  end;
{$endif}
end;

function Sys0(Nr: Int64): Int64;
begin
  Result := Syscall(Nr);
end;

function Sys1(Nr, A: Int64): Int64;
begin
  Result := Syscall(Nr, A);
end;

function Sys2(Nr, A, B: Int64): Int64;
begin
  Result := Syscall(Nr, A, B);
end;

function Sys3(Nr, A, B, C: Int64): Int64;
begin
  Result := Syscall(Nr, A, B, C);
end;

function Sys4(Nr, A, B, C, D: Int64): Int64;
begin
  Result := Syscall(Nr, A, B, C, D);
end;

function Sys5(Nr, A, B, C, D, E: Int64): Int64;
begin
  Result := Syscall(Nr, A, B, C, D, E);
end;

function NrExecve: Int64;
begin
  if Amd64 = 0 then
    Result := 221
  else
    Result := SysExecve;
end;

function NrExit: Int64;
begin
  if Amd64 = 0 then
    Result := 93
  else
    Result := SysExit;
end;

function NrClose: Int64;
begin
  if Amd64 = 0 then
    Result := 57
  else
    Result := SysClose;
end;

function NrDup2: Int64;
begin
  if Amd64 = 0 then
    Result := 24
  else
    Result := SysDup2;
end;

{ The open flags above are amd64's; arm64 has O_DIRECTORY and O_DIRECT
  the other way round (040000 and 0200000), O_NOFOLLOW at 0100000 and
  O_LARGEFILE at 0400000. Untranslated, ListDir opened its directory
  with O_DIRECT on arm64, the open failed and it listed nothing (P91,
  1.0.70; dirlist runs on both machines now). }
function ArmOpenFlags(F: Int64): Int64;
var
  r: Int64;
begin
  r := F and ((16384 or 65536 or 131072 or 32768) xor (-1));
  if (F and 65536) <> 0 then
    r := r or 16384;
  if (F and 16384) <> 0 then
    r := r or 65536;
  if (F and 131072) <> 0 then
    r := r or 32768;
  if (F and 32768) <> 0 then
    r := r or 131072;
  Result := r;
end;

function OsOpen(Path, Flags, Mode: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys4(56, -100, Path, ArmOpenFlags(Flags), Mode)
  else
    Result := Sys3(SysOpen, Path, Flags, Mode);
end;

{ DirFd stabilizes the base directory across process-wide chdir.
  Use -100 for the process current directory. The flag vocabulary is
  still amd64's; the existing translation is shared, not duplicated. }
function OsOpenAt(DirFd, Path, Flags, Mode: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys4(56, DirFd, Path, ArmOpenFlags(Flags), Mode)
  else
    Result := Sys4(257, DirFd, Path, Flags, Mode);
end;

function OsClose(Fd: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys1(57, Fd)
  else
    Result := Sys1(SysClose, Fd);
end;

function OsRead(Fd, Buf, N: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys3(63, Fd, Buf, N)
  else
    Result := Sys3(SysRead, Fd, Buf, N);
end;

function OsWrite(Fd, Buf, N: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys3(64, Fd, Buf, N)
  else
    Result := Sys3(SysWrite, Fd, Buf, N);
end;

function OsMkdir(Path, Mode: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys3(34, -100, Path, Mode)
  else
    Result := Sys2(SysMkdir, Path, Mode);
end;

function OsAccess(Path, Mode: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys3(48, -100, Path, Mode)
  else
    Result := Sys2(SysAccess, Path, Mode);
end;

function OsFork: Int64;
begin
  if Amd64 = 0 then
    Result := Sys5(220, 17, 0, 0, 0, 0)
  else
    Result := Sys0(SysFork);
end;

function OsExec(Path, Argv, Env: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys3(221, Path, Argv, Env)
  else
    Result := Sys3(SysExecve, Path, Argv, Env);
end;

function OsExit(Code: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys1(93, Code)
  else
    Result := Sys1(SysExit, Code);
end;

function OsWait(Pid, Status, Opts, Rusage: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys4(260, Pid, Status, Opts, Rusage)
  else
    Result := Sys4(SysWait4, Pid, Status, Opts, Rusage);
end;

function OsPipe(Buf: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys2(59, Buf, 0)
  else
    Result := Sys1(SysPipe, Buf);
end;

function OsDup2(OldFd, NewFd: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys3(24, OldFd, NewFd, 0)
  else
    Result := Sys2(SysDup2, OldFd, NewFd);
end;

function OsGetdents(Fd, Buf, N: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys3(61, Fd, Buf, N)
  else
    Result := Sys3(SysGetdents64, Fd, Buf, N);
end;

function OsFstat(Fd, Buf: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys2(80, Fd, Buf)
  else
    Result := Sys2(SysFstat, Fd, Buf);
end;

function OsReadlink(Path, Buf, N: Int64): Int64;
begin
  if Amd64 = 0 then
    Result := Sys4(78, -100, Path, Buf, N)
  else
    Result := Sys3(89, Path, Buf, N);
end;

function OsPoll(Fds, Nfds, TimeoutMs: Int64): Int64;
var
  secs, nsecs: Int64;
  ts: array[0..1] of Int64;
begin
  secs := 0;
  nsecs := 0;
  ts[0] := 0;
  ts[1] := 0;
  if Amd64 = 0 then
  begin
    if TimeoutMs < 0 then
      Result := Sys5(73, Fds, Nfds, 0, 0, 0)
    else
    begin
      secs := TimeoutMs div 1000;
      nsecs := (TimeoutMs mod 1000) * 1000000;
      ts[0] := secs;
      ts[1] := nsecs;
      Result := Sys5(73, Fds, Nfds, Int64(@ts[0]), 0, 0);
    end;
  end
  else
    Result := Sys3(SysPoll, Fds, Nfds, TimeoutMs);
end;

initialization
  CopyInitialEnvironment;

end.
