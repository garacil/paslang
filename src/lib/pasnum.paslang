  { eight bytes as one word, the first in its low byte: the masks of
    the digit check and of the value (numberparsing.h) }
  SwarHigh = $F0F0F0F0F0F0F0F0;
  SwarSix = $0606060606060606;
  SwarThrees = $3333333333333333;
  SwarZeros = $3030303030303030;
  { decimal.go's 800 digits, and the longest shift whose work fits an
    Int64 (maxShift is 60 there, with unsigned words) }
  DecDigits = 800;
  DecMaxShift = 59;

type
  { the scaling constants of an e, p pair (uscale.go's scaler) }
  TScaler = record
    PmHi, PmLo, S: Int64;
  end;

  { a decimal of up to 800 digits (decimal.go): the digits as ASCII, how
    many, where the point is, the sign, and whether nonzero digits past
    the 800th were dropped }
  TDecimal = record
    D: array[0..799] of Byte;
    Nd, Dp: Int64;
    Neg, Dropped: Boolean;
  end;

{ A below B as 64-bit unsigned numbers. }
function ULt(A, B: Int64): Boolean;
begin
  Result := (A xor Low(Int64)) < (B xor Low(Int64));
end;

{ floor(x * log10 2) and floor(x * log2 10) (uscale.go's log10Pow2,
  log2Pow10) }
function Log10Pow2(X: Int64): Int64;
begin
  Result := (X * 78913) sar 18;
end;

function Log2Pow10(X: Int64): Int64;
begin
  Result := (X * 108853) sar 15;
end;

{ An unrounded value (uscale.go): the value times 4, its low bit set
  when anything below was lost. }
function UFloor(U: Int64): Int64;
begin
  Result := U shr 2;
end;

function URound(U: Int64): Int64;
begin
  Result := (U + 1 + ((U shr 2) and 1)) shr 2;
end;

function UCeil(U: Int64): Int64;
begin
  Result := (U + 3) shr 2;
end;

{ U divided by 10 as an unsigned number, the lost part in the low bit. }
function UDiv10(U: Int64): Int64;
var
  q: Int64;
begin
  q := (U shr 1) div 5;
  Result := q or (U and 1);
  if U - q * 10 <> 0 then
    Result := Result or 1;
end;

{ the least unrounded value that rounds to X }
function UnMin(X: Int64): Int64;
begin
  Result := (X shl 2) - 2;
end;

procedure Prescale(var Pre: TScaler; E, P, Lp: Int64);
begin
  Pre.PmHi := Pow10Tab[2 * (P - Pow10Min)];
  Pre.PmLo := Pow10Tab[2 * (P - Pow10Min) + 1];
  Pre.S := -(E + Lp + 3);
end;

{ unround(X * 2^e * 10^p) for the Pre of e, p; X left-justified. }
function UScale(X: Int64; const Pre: TScaler): Int64;
var
  hi, mid, mid2, s: Int64;
begin
  hi := MulHi(X, Pre.PmHi);
  mid := X * Pre.PmHi;
  s := Pre.S and 63;
  if ((hi shr s) shl s) <> hi then
  begin
    Result := (hi shr s) or 1;
    Exit;
  end;
  mid2 := MulHi(X, Pre.PmLo);
  if ULt(mid, mid2) then
    hi := hi - 1;
  Result := hi shr s;
  if ULt(1, mid - mid2) then
    Result := Result or 1;
end;

{ The N-digit (18 at most) decimal form of M * 2^E as D * 10^P
  (fixedWidthFloat); with Decs >= 0, the 'f' form: N an estimate, digits
  dropped until Decs are left after the point. }
procedure FixedWidth(M, E, N, Decs: Int64; out D, P: Int64);
var
  pre: TScaler;
  u, q: Int64;
begin
  q := N - 1 - Log10Pow2(E + 63);
  Prescale(pre, E, q, Log2Pow10(q));
  u := UScale(M, pre);
  if not ULt(u, UnMin(Pow10U[N])) then
  begin
    u := UDiv10(u);
    q := q - 1;
  end;
  if Decs >= 0 then
    while q > Decs do
    begin
      u := UDiv10(u);
      q := q - 1;
    end;
  D := URound(u);
  P := -q;
end;

{ floor(log10(3/4 * 2^e)) (skewed) }
function Skewed(E: Int64): Int64;
begin
  Result := (E * 631305 - 261663) sar 21;
end;

{ The fewest digits of M * 2^E that read back as the same real
  (shortFloat) of MantBits bits (52 a Double, 23 a Single): D * 10^P. }
procedure ShortFloat(M, E: Int64; MantBits, MinExp: Integer; out D, P: Int64);
var
  z, oddm, mn, mx, dmin, dmax, dd, q: Int64;
  pre: TScaler;
begin
  z := 63 - MantBits;
  if (M = Low(Int64)) and (E > MinExp) then
  begin
    q := -Skewed(E + z);
    mn := M - (Int64(1) shl (z - 2));
    mx := M + (Int64(1) shl (z - 1));
  end
  else if E >= MinExp then
  begin
    q := -Log10Pow2(E + z);
    mn := M - (Int64(1) shl (z - 1));
    mx := M + (Int64(1) shl (z - 1));
  end
  else
  begin
    z := z + (MinExp - E);
    q := -Log10Pow2(E + z);
    mn := M - (Int64(1) shl (z - 1));
    mx := M + (Int64(1) shl (z - 1));
  end;
  oddm := (M shr z) and 1;
  Prescale(pre, E, q, Log2Pow10(q));
  dmin := UCeil(UScale(mn, pre) + oddm);
  dmax := UFloor(UScale(mx, pre) - oddm);
  dd := dmax div 10;
  if not ULt(dd * 10, dmin) then
  begin
    D := dd;
    P := -(q - 1);
    Exit;
  end;
  dd := dmin;
  if ULt(dd, dmax) then
    dd := URound(UScale(M, pre));
  D := dd;
  P := -q;
end;

{ ---- reading ---- }

{ Whether the eight bytes of W, the first in its low byte, are all
  digits (simdjson's is_made_of_eight_digits_fast): a byte is one when
  its high nibble is 3 and stays 3 once 6 is added to it. }
function EightDigits(W: Int64): Boolean;
begin
  Result := ((W and SwarHigh) or (((W + SwarSix) and SwarHigh) shr 4)) = SwarThrees;
end;

{ The value of the eight digits in W, the first the most significant
  (parse_eight_digits_unrolled, after Johnny Lee's "Fast numeric
  string to int"): the bytes joined into pairs, the pairs into fours,
  the fours into the eight, one multiply a step, the products wrapping
  as unsigned ones do. }
function EightValue(W: Int64): Int64;
var
  v: Int64;
begin
  v := ((W and $0F0F0F0F0F0F0F0F) * 2561) shr 8;
  v := ((v and $00FF00FF00FF00FF) * 6553601) shr 16;
  Result := ((v and $0000FFFF0000FFFF) * 42949672960001) shr 32;
end;

function PasNumScan(P: Pointer; N: Int64; Json: Boolean; out Sc: TPasNumScan): Boolean;
var
  b: PByte;
  i, c, w, mant, nd, ndm, dp, dot, e, esign: Int64;
  sawdot, sawdigits, dropped, intlit: Boolean;
begin
  b := PByte(P);
  Sc.Mant := 0;
  Sc.Exp10 := 0;
  Sc.Digits := 0;
  Sc.Len := 0;
  Sc.Neg := False;
  Sc.Dropped := False;
  Sc.IntLit := False;
  Result := False;
  i := 0;
  if N > 0 then
  begin
    c := b[0];
    if c = 45 then
    begin
      Sc.Neg := True;
      i := 1;
    end
    else if (c = 43) and not Json then
      i := 1;
  end;
  if Json then
  begin
    { a digit first, and a 0 there the whole integer part }
    if (i >= N) or (b[i] < 48) or (b[i] > 57) then
    begin
      Sc.Len := i;
      Exit;
    end;
    if (b[i] = 48) and (i + 1 < N) and (b[i + 1] >= 48) and (b[i + 1] <= 57) then
    begin
      Sc.Len := i + 1;
      Exit;
    end;
  end;
  { the digits and the point, readFloat's loop: a digit at a time, or
    eight, while all eight go into the mantissa or all of them past it }
  mant := 0;
  nd := 0;
  ndm := 0;
  dp := 0;
  dot := -1;
  sawdot := False;
  sawdigits := False;
  dropped := False;
  while i < N do
  begin
    c := b[i];
    if (c >= 48) and (c <= 57) then
    begin
      sawdigits := True;
      if (c = 48) and (nd = 0) then
      begin
        { a zero before the first other digit only moves the point }
        dp := dp - 1;
        i := i + 1;
        Continue;
      end;
      if (i + 8 <= N) and ((ndm <= 11) or (ndm >= 19)) then
      begin
        w := PInt64(Int64(P) + i)^;
        if EightDigits(w) then
        begin
          if ndm <= 11 then
          begin
            mant := mant * 100000000 + EightValue(w);
            ndm := ndm + 8;
          end
          else if w <> SwarZeros then
            dropped := True;
          nd := nd + 8;
          i := i + 8;
          Continue;
        end;
      end;
      nd := nd + 1;
      if ndm < 19 then
      begin
        mant := mant * 10 + (c - 48);
        ndm := ndm + 1;
      end
      else if c <> 48 then
        dropped := True;
      i := i + 1;
      Continue;
    end;
    if c = 46 then
    begin
      if sawdot then
        Break;
      sawdot := True;
      dp := nd;
      dot := i;
      i := i + 1;
      Continue;
    end;
    Break;
  end;
  if not sawdigits or (Json and sawdot and (i = dot + 1)) then
  begin
    Sc.Len := i;
    Exit;
  end;
  if not sawdot then
    dp := nd;
  intlit := not sawdot;
  if (i < N) and ((b[i] = 101) or (b[i] = 69)) then
  begin
    intlit := False;
    i := i + 1;
    if i >= N then
    begin
      Sc.Len := i;
      Exit;
    end;
    esign := 1;
    if b[i] = 43 then
      i := i + 1
    else if b[i] = 45 then
    begin
      esign := -1;
      i := i + 1;
    end;
    if (i >= N) or (b[i] < 48) or (b[i] > 57) then
    begin
      Sc.Len := i;
      Exit;
    end;
    { a long exponent only has to move the point far enough }
    e := 0;
    while (i < N) and (b[i] >= 48) and (b[i] <= 57) do
    begin
      if e < 10000 then
        e := e * 10 + (b[i] - 48);
      i := i + 1;
    end;
    dp := dp + e * esign;
  end;
  Sc.Mant := mant;
  if mant <> 0 then
    Sc.Exp10 := dp - ndm;
  Sc.Digits := nd;
  Sc.Dropped := dropped;
  Sc.IntLit := intlit;
  Sc.Len := i;
  Result := True;
end;

{ ---- the slow path: decimal.go ---- }

{ the trailing zeros gone (trim) }
procedure DecTrim(var A: TDecimal);
begin
  while (A.Nd > 0) and (A.D[A.Nd - 1] = 48) do
    A.Nd := A.Nd - 1;
  if A.Nd = 0 then
    A.Dp := 0;
end;

{ The number in the N bytes at P, which PasNumScan read, into A (set):
  its first 800 significant digits, the point and the sign. }
procedure DecSet(var A: TDecimal; P: Pointer; N: Int64);
var
  b: PByte;
  i, c, e, esign: Int64;
  sawdot: Boolean;
begin
  b := PByte(P);
  A.Nd := 0;
  A.Dp := 0;
  A.Neg := False;
  A.Dropped := False;
  i := 0;
  if (N > 0) and (b[0] = 43) then
    i := 1
  else if (N > 0) and (b[0] = 45) then
  begin
    A.Neg := True;
    i := 1;
  end;
  sawdot := False;
  while i < N do
  begin
    c := b[i];
    if c = 46 then
    begin
      sawdot := True;
      A.Dp := A.Nd;
    end
    else if (c >= 48) and (c <= 57) then
    begin
      if (c = 48) and (A.Nd = 0) then
        A.Dp := A.Dp - 1
      else if A.Nd < DecDigits then
      begin
        A.D[A.Nd] := Byte(c);
        A.Nd := A.Nd + 1;
      end
      else if c <> 48 then
        A.Dropped := True;
    end
    else
      Break;
    i := i + 1;
  end;
  if not sawdot then
    A.Dp := A.Nd;
  if (i < N) and ((b[i] = 101) or (b[i] = 69)) then
  begin
    i := i + 1;
    esign := 1;
    if b[i] = 43 then
      i := i + 1
    else if b[i] = 45 then
    begin
      esign := -1;
      i := i + 1;
    end;
    e := 0;
    while (i < N) and (b[i] >= 48) and (b[i] <= 57) do
    begin
      if e < 10000 then
        e := e * 10 + (b[i] - 48);
      i := i + 1;
    end;
    A.Dp := A.Dp + e * esign;
  end;
end;

{ A divided by 2^K, K at most 59 (rightShift) }
procedure DecRightShift(var A: TDecimal; K: Int64);
var
  r, w, n, c, dig, mask: Int64;
begin
  r := 0;
  w := 0;
  n := 0;
  { enough leading digits for the first quotient digit }
  while (n shr K) = 0 do
  begin
    if r >= A.Nd then
    begin
      if n = 0 then
      begin
        A.Nd := 0;
        Exit;
      end;
      while (n shr K) = 0 do
      begin
        n := n * 10;
        r := r + 1;
      end;
      Break;
    end;
    c := A.D[r];
    n := n * 10 + c - 48;
    r := r + 1;
  end;
  A.Dp := A.Dp - (r - 1);
  mask := (Int64(1) shl K) - 1;
  { a digit picked up, a digit put down }
  while r < A.Nd do
  begin
    c := A.D[r];
    dig := n shr K;
    n := n and mask;
    A.D[w] := Byte(dig + 48);
    w := w + 1;
    n := n * 10 + c - 48;
    r := r + 1;
  end;
  { the digits left in n }
  while n <> 0 do
  begin
    dig := n shr K;
    n := n and mask;
    if w < DecDigits then
    begin
      A.D[w] := Byte(dig + 48);
      w := w + 1;
    end
    else if dig > 0 then
      A.Dropped := True;
    n := n * 10;
  end;
  A.Nd := w;
  DecTrim(A);
end;

{ whether the digits of A begin below S (prefixIsLessThan) }
function DecPrefixLess(var A: TDecimal; const S: string): Boolean;
var
  i, c: Int64;
begin
  Result := False;
  for i := 0 to Length(S) - 1 do
  begin
    if i >= A.Nd then
    begin
      Result := True;
      Exit;
    end;
    c := Ord(S[i + 1]);
    if A.D[i] <> c then
    begin
      Result := A.D[i] < c;
      Exit;
    end;
  end;
end;

{ A times 2^K, K at most 59 (leftShift) }
procedure DecLeftShift(var A: TDecimal; K: Int64);
var
  delta, r, w, n, c, quo, rem: Int64;
begin
  delta := LeftCheatDelta[K];
  if DecPrefixLess(A, LeftCheatCut[K]) then
    delta := delta - 1;
  r := A.Nd - 1;
  w := A.Nd + delta;
  n := 0;
  while r >= 0 do
  begin
    c := A.D[r];
    n := n + ((c - 48) shl K);
    quo := n div 10;
    rem := n - 10 * quo;
    w := w - 1;
    if w < DecDigits then
      A.D[w] := Byte(rem + 48)
    else if rem <> 0 then
      A.Dropped := True;
    n := quo;
    r := r - 1;
  end;
  while n > 0 do
  begin
    quo := n div 10;
    rem := n - 10 * quo;
    w := w - 1;
    if w < DecDigits then
      A.D[w] := Byte(rem + 48)
    else if rem <> 0 then
      A.Dropped := True;
    n := quo;
  end;
  A.Nd := A.Nd + delta;
  if A.Nd >= DecDigits then
    A.Nd := DecDigits;
  A.Dp := A.Dp + delta;
  DecTrim(A);
end;

{ A times 2^K, or divided by 2^-K (Shift) }
procedure DecShift(var A: TDecimal; K: Int64);
begin
  if A.Nd = 0 then
  else if K > 0 then
  begin
    while K > DecMaxShift do
    begin
      DecLeftShift(A, DecMaxShift);
      K := K - DecMaxShift;
    end;
    DecLeftShift(A, K);
  end
  else if K < 0 then
  begin
    while K < -DecMaxShift do
    begin
      DecRightShift(A, DecMaxShift);
      K := K + DecMaxShift;
    end;
    DecRightShift(A, -K);
  end;
end;

{ whether A cut to Nd digits rounds up, a tie to even unless digits
  were dropped (shouldRoundUp) }
function DecRoundsUp(var A: TDecimal; Nd: Int64): Boolean;
begin
  if (Nd < 0) or (Nd >= A.Nd) then
    Result := False
  else if (A.D[Nd] = 53) and (Nd + 1 = A.Nd) then
    Result := A.Dropped or ((Nd > 0) and (((A.D[Nd - 1] - 48) and 1) <> 0))
  else
    Result := A.D[Nd] >= 53;
end;

{ the integer part of A, rounded (RoundedInteger) }
function DecRoundedInteger(var A: TDecimal): Int64;
var
  i, n: Int64;
begin
  if A.Dp > 20 then
  begin
    Result := -1;
    Exit;
  end;
  n := 0;
  i := 0;
  while (i < A.Dp) and (i < A.Nd) do
  begin
    n := n * 10 + (A.D[i] - 48);
    i := i + 1;
  end;
  while i < A.Dp do
  begin
    n := n * 10;
    i := i + 1;
  end;
  if DecRoundsUp(A, A.Dp) then
    n := n + 1;
  Result := n;
end;

{ A as the bits of the nearest binary float of MantBits, ExpBits and
  Bias (floatBits); False when it is past the largest, Bits then the
  infinity }
function DecFloatBits(var A: TDecimal; MantBits, ExpBits, Bias: Int64; out Bits: Int64): Boolean;
var
  ex, mant, n, top: Int64;
  over: Boolean;
begin
  over := False;
  mant := 0;
  ex := Bias;
  top := (Int64(1) shl ExpBits) - 1;
  if A.Nd = 0 then
  else if A.Dp > 310 then
    over := True
  else if A.Dp < -330 then
  else
  begin
    { into [0.5, 1) by powers of two }
    ex := 0;
    while A.Dp > 0 do
    begin
      if A.Dp >= 9 then
        n := 27
      else
        n := PowTab[A.Dp];
      DecShift(A, -n);
      ex := ex + n;
    end;
    while (A.Dp < 0) or ((A.Dp = 0) and (A.D[0] < 53)) do
    begin
      if -A.Dp >= 9 then
        n := 27
      else
        n := PowTab[-A.Dp];
      DecShift(A, n);
      ex := ex - n;
    end;
    { [0.5, 1) is [1, 2) one power lower }
    ex := ex - 1;
    if ex < Bias + 1 then
    begin
      n := Bias + 1 - ex;
      DecShift(A, -n);
      ex := ex + n;
    end;
    if ex - Bias >= top then
      over := True
    else
    begin
      DecShift(A, 1 + MantBits);
      mant := DecRoundedInteger(A);
      if mant = (Int64(2) shl MantBits) then
      begin
        mant := mant shr 1;
        ex := ex + 1;
        if ex - Bias >= top then
          over := True;
      end;
      if (mant and (Int64(1) shl MantBits)) = 0 then
        ex := Bias;
    end;
  end;
  if over then
  begin
    mant := 0;
    ex := top + Bias;
  end;
  Bits := mant and ((Int64(1) shl MantBits) - 1);
  Bits := Bits or (((ex - Bias) and top) shl MantBits);
  if A.Neg then
    Bits := Bits or ((Int64(1) shl MantBits) shl ExpBits);
  Result := not over;
end;

{ The text of N bytes at P as the nearest Double, or Single, by the
  800-digit decimal: the case the scaling leaves, more than 19 digits
  that a last one up would round elsewhere. }
function SlowFloat(P: Pointer; N: Int64; IsSingle: Boolean; out Bits: Int64): Boolean;
var
  a: TDecimal;
begin
  DecSet(a, P, N);
  if IsSingle then
    Result := DecFloatBits(a, 23, 8, -127, Bits)
  else
    Result := DecFloatBits(a, 52, 11, -1023, Bits);
end;

{ ---- the fast path: uscale.go and atof.go ---- }

{ M * 2^E with M of 53 bits, its sign in bit 63 (pack64); False and the
  infinity when it is past the largest Double }
function Pack64(M, E: Int64; out Bits: Int64): Boolean;
begin
  Result := True;
  if (M and (Int64(1) shl 52)) = 0 then
    Bits := M
  else if E >= $7FF - 1075 then
  begin
    Bits := (M and Low(Int64)) or (Int64($7FF) shl 52);
    Result := False;
  end
  else
    Bits := (M andnot (Int64(1) shl 52)) or ((1075 + E) shl 52);
end;

{ M * 2^E with M of 24 bits, its sign in bit 31 (pack32) }
function Pack32(M, E: Int64; out Bits: Int64): Boolean;
begin
  Result := True;
  if (M and (Int64(1) shl 23)) = 0 then
    Bits := M
  else if E >= $FF - 150 then
  begin
    Bits := (M and (Int64(1) shl 31)) or (Int64($FF) shl 23);
    Result := False;
  end
  else
    Bits := (M andnot (Int64(1) shl 23)) or ((150 + E) shl 23);
end;

{ D * 10^P (D unsigned, not 0, of 19 digits at most) rounded to the
  nearest Double, Sign its sign bit (parseFloat64) }
function ParseF64(D, P, Sign: Int64; out Bits: Int64): Boolean;
var
  b, lp, e, s, u: Int64;
  pre: TScaler;
begin
  b := 64 - LeadingZeros(D);
  lp := Log2Pow10(P);
  e := 53 - b - lp;
  if e > 1074 then
    e := 1074;
  Prescale(pre, e - (64 - b), P, lp);
  if pre.S >= 64 then
  begin
    Bits := Sign;
    Result := True;
    Exit;
  end;
  u := UScale(D shl (64 - b), pre);
  { one bit too many when it rounds to 2^53 or more }
  if ULt(u, UnMin(Int64(1) shl 53)) then
    s := 0
  else
    s := 1;
  u := (u shr s) or (u and 1);
  e := e - s;
  Result := Pack64(Sign or URound(u), -e, Bits);
end;

{ the same to the nearest Single (parseFloat32) }
function ParseF32(D, P, Sign: Int64; out Bits: Int64): Boolean;
var
  b, lp, e, s, u: Int64;
  pre: TScaler;
begin
  b := 64 - LeadingZeros(D);
  lp := Log2Pow10(P);
  e := 24 - b - lp;
  if e > 149 then
    e := 149;
  Prescale(pre, e - (64 - b), P, lp);
  if pre.S >= 64 then
  begin
    Bits := Sign;
    Result := True;
    Exit;
  end;
  u := UScale(D shl (64 - b), pre);
  if ULt(u, UnMin(Int64(1) shl 24)) then
    s := 0
  else
    s := 1;
  u := (u shr s) or (u and 1);
  e := e - s;
  Result := Pack32(Sign or URound(u), -e, Bits);
end;

{ Mant * 10^Exp10 in one Double operation when both are exact
  (atof64exact): an integer below 2^52 times or over a power of ten
  up to 10^22, a few zeros of a large exponent moved into the integer
  first. The product or quotient of two exact values is rounded once. }
function Exact64(Mant, Exp10: Int64; Neg: Boolean; out Bits: Int64): Boolean;
var
  f: Double;
  x: Int64;
begin
  Result := False;
  Bits := 0;
  if (Mant shr 52) <> 0 then
    Exit;
  f := Mant;
  if Neg then
    f := -f;
  x := Exp10;
  if x = 0 then
  else if (x > 0) and (x <= 15 + 22) then
  begin
    if x > 22 then
    begin
      f := f * Float64Pow10[x - 22];
      x := 22;
    end;
    if (f > 1e15) or (f < -1e15) then
      Exit;
    f := f * Float64Pow10[x];
  end
  else if (x < 0) and (x >= -22) then
    f := f / Float64Pow10[-x]
  else
    Exit;
  Bits := f as Int64;
  Result := True;
end;

{ atof64's way: 0, the ends, the exact case, the scaling, and when
  digits past the 19th were dropped, the scaling of one more in the
  last digit kept: the same Double means the dropped ones do not
  matter; another, the decimal. }
function PasNumF64(P: Pointer; const Sc: TPasNumScan; out Bits: Int64): Boolean;
var
  sgn, up: Int64;
begin
  Result := True;
  if Sc.Neg then
    sgn := Low(Int64)
  else
    sgn := 0;
  if Sc.Mant = 0 then
  begin
    Bits := sgn;
    Exit;
  end;
  if Sc.Exp10 > 310 then
  begin
    Bits := sgn or (Int64($7FF) shl 52);
    Result := False;
    Exit;
  end;
  if Sc.Exp10 < -345 then
  begin
    Bits := sgn;
    Exit;
  end;
  if not Sc.Dropped and Exact64(Sc.Mant, Sc.Exp10, Sc.Neg, Bits) then
    Exit;
  Result := ParseF64(Sc.Mant, Sc.Exp10, sgn, Bits);
  if not Sc.Dropped then
    Exit;
  ParseF64(Sc.Mant + 1, Sc.Exp10, sgn, up);
  if up = Bits then
    Exit;
  Result := SlowFloat(P, Sc.Len, False, Bits);
end;

{ atof32's way, without atof32exact: paslang works a Single's product
  in a Double, which could round twice, and the scaling is exact by
  itself. }
function PasNumF32(P: Pointer; const Sc: TPasNumScan; out Bits: Int64): Boolean;
var
  sgn, up: Int64;
begin
  Result := True;
  if Sc.Neg then
    sgn := Int64(1) shl 31
  else
    sgn := 0;
  if Sc.Mant = 0 then
  begin
    Bits := sgn;
    Exit;
  end;
  if Sc.Exp10 > 40 then
  begin
    Bits := sgn or (Int64($FF) shl 23);
    Result := False;
    Exit;
  end;
  if Sc.Exp10 < -70 then
  begin
    Bits := sgn;
    Exit;
  end;
  Result := ParseF32(Sc.Mant, Sc.Exp10, sgn, Bits);
  if not Sc.Dropped then
    Exit;
  ParseF32(Sc.Mant + 1, Sc.Exp10, sgn, up);
  if up = Bits then
    Exit;
  Result := SlowFloat(P, Sc.Len, True, Bits);
end;

function PasNumI64(P: Pointer; const Sc: TPasNumScan; out V: Int64): Boolean;
begin
  V := 0;
  Result := False;
  { 19 digits at most: Mant is the number, Exp 0 }
  if not Sc.IntLit or (Sc.Digits > 19) then
    Exit;
  if Sc.Neg then
  begin
    { down to -2^63, whose magnitude is Low(Int64)'s bits }
    if (Sc.Mant < 0) and (Sc.Mant <> Low(Int64)) then
      Exit;
    V := -Sc.Mant;
  end
  else
  begin
    if Sc.Mant < 0 then
      Exit;
    V := Sc.Mant;
  end;
  Result := True;
end;

function PasNumU64(P: Pointer; const Sc: TPasNumScan; out V: Int64): Boolean;
var
  last: Int64;
begin
  V := 0;
  Result := False;
  if not Sc.IntLit or (Sc.Digits > 20) then
    Exit;
  if Sc.Digits = 20 then
  begin
    { the 20th digit is the number's last byte: Mant * 10 + it, below
      2^64 = 18446744073709551616 }
    last := PByte(P)[Sc.Len - 1] - 48;
    if not (ULt(Sc.Mant, 1844674407370955161) or
      ((Sc.Mant = 1844674407370955161) and (last <= 5))) then
      Exit;
    V := Sc.Mant * 10 + last;
  end
  else
    V := Sc.Mant;
  if Sc.Neg and (V <> 0) then
  begin
    V := 0;
    Exit;
  end;
  Result := True;
end;

{ ---- writing ---- }

function PasNumLog10Pow2(X: Int64): Int64;
begin
  Result := Log10Pow2(X);
end;

{ numDigits: from the bits, one compare }
function PasNumDigitCount(D: Int64): Int64;
begin
  if D = 0 then
    Result := 1
  else
  begin
    Result := Log10Pow2(64 - LeadingZeros(D));
    if not ULt(D, Pow10U[Result]) then
      Result := Result + 1;
  end;
end;

{ The digits from the end, two a step from PasNumDigitPairs, one division by
  100 for each pair (itoa.go's formatBase10 takes eight a step in 32-bit
  words; here, in Int64 words, that costs more divisions than it saves);
  a D past High(Int64), whose quotient a signed division would get
  wrong, has its first pair taken as (D shr 2) div 25, the unsigned
  quotient. }
procedure PasNumWriteDigits(P: Pointer; D, N: Int64);
var
  b, dp: PChar;
  nd, q, r: Int64;
begin
  b := PChar(P);
  dp := @PasNumDigitPairs[1];
  nd := N;
  if (D < 0) and (nd >= 2) then
  begin
    q := (D shr 2) div 25;
    r := D - q * 100;
    b[nd - 1] := dp[r * 2 + 1];
    b[nd - 2] := dp[r * 2];
    nd := nd - 2;
    D := q;
  end;
  while nd >= 2 do
  begin
    q := D div 100;
    r := D - q * 100;
    b[nd - 1] := dp[r * 2 + 1];
    b[nd - 2] := dp[r * 2];
    nd := nd - 2;
    D := q;
  end;
  if nd > 0 then
    b[0] := Char(48 + D);
end;

{ V from its last digit, two a step, into a buffer of its own, the
  value never counted first (the loop of pasfmt's PasFmtInt, P129),
  then copied to P. }
function PasNumAppendUint(P: Pointer; V: Int64): Int64;
var
  buf: array[0..23] of Char;
  b, dp, d: PChar;
  i, q, r: Int64;
begin
  b := @buf[0];
  dp := @PasNumDigitPairs[1];
  i := 24;
  if V < 0 then
  begin
    { past High(Int64): the first pair by the unsigned quotient }
    q := (V shr 2) div 25;
    r := V - q * 100;
    i := i - 2;
    b[i] := dp[r * 2];
    b[i + 1] := dp[r * 2 + 1];
    V := q;
  end;
  while V >= 100 do
  begin
    q := V div 100;
    r := V - q * 100;
    i := i - 2;
    b[i] := dp[r * 2];
    b[i + 1] := dp[r * 2 + 1];
    V := q;
  end;
  if V >= 10 then
  begin
    i := i - 2;
    b[i] := dp[V * 2];
    b[i + 1] := dp[V * 2 + 1];
  end
  else
  begin
    i := i - 1;
    b[i] := Char(48 + V);
  end;
  Result := 24 - i;
  d := PChar(P);
  Move(buf[i], d[0], Result);
end;

function PasNumAppendInt(P: Pointer; V: Int64): Int64;
var
  b: PChar;
begin
  if V < 0 then
  begin
    b := PChar(P);
    b[0] := '-';
    { -Low(Int64) is Low(Int64), 2^63 as an unsigned number }
    Result := 1 + PasNumAppendUint(Pointer(Int64(P) + 1), -V);
  end
  else
    Result := PasNumAppendUint(P, V);
end;

{ A real's parts from its bits (a Single's in the low 32 when IsSingle),
  as PasNumSplitReal gives them }
procedure SplitBits(Bits: Int64; IsSingle: Boolean; out Neg: Boolean; out M, E: Int64;
  out Kind: Integer);
var
  ex, mant, s: Int64;
  mbits, bias, emax: Integer;
begin
  if IsSingle then
  begin
    Bits := Bits and 4294967295;
    Neg := (Bits shr 31) <> 0;
    ex := (Bits shr 23) and 255;
    mant := Bits and 8388607;
    mbits := 23;
    bias := -127;
    emax := 255;
  end
  else
  begin
    Neg := Bits < 0;
    ex := (Bits shr 52) and 2047;
    mant := Bits and 4503599627370495;
    mbits := 52;
    bias := -1023;
    emax := 2047;
  end;
  if ex = emax then
  begin
    if mant <> 0 then
      Kind := 3
    else
      Kind := 2;
    M := 0;
    E := 0;
    Exit;
  end;
  if ex = 0 then
    ex := 1
  else
    mant := mant or (Int64(1) shl mbits);
  if mant = 0 then
  begin
    Kind := 1;
    M := 0;
    E := 0;
    Exit;
  end;
  Kind := 0;
  ex := ex + bias;
  s := LeadingZeros(mant);
  M := mant shl s;
  E := ex - s - mbits;
end;

procedure PasNumSplitReal(X: Double; IsSingle: Boolean; out Neg: Boolean; out M, E: Int64;
  out Kind: Integer);
var
  sg: Single;
  sb: Int32;
begin
  if IsSingle then
  begin
    sg := Single(X);
    sb := 0;
    Move(sg, sb, 4);
    SplitBits(Int64(sb), True, Neg, M, E, Kind);
  end
  else
    SplitBits(X as Int64, False, Neg, M, E, Kind);
end;

procedure PasNumShortFloat(M, E: Int64; MantBits, MinExp: Integer; out D, P: Int64);
begin
  ShortFloat(M, E, MantBits, MinExp, D, P);
end;

procedure PasNumFixedWidth(M, E, N, Decs: Int64; out D, P: Int64);
begin
  FixedWidth(M, E, N, Decs, D, P);
end;

{ The shortest digits of the real with the bits given, laid out as
  ECMAScript lays them (jsonwire's AppendFloat over ftoa's %e and %f
  with precision -1): with dp the place of the point after the first
  of the nd digits, positional from dp -5 to 21, an exponent of at
  least one digit outside it. }
function AppendShort(P: Pointer; Bits: Int64; IsSingle: Boolean): Int64;
var
  b: PChar;
  digs: array[0..23] of Char;
  neg: Boolean;
  m, e, dv, q, nd, dp, i, k, x: Int64;
  kind: Integer;
begin
  b := PChar(P);
  SplitBits(Bits, IsSingle, neg, m, e, kind);
  if kind = 3 then
  begin
    b[0] := 'N';
    b[1] := 'a';
    b[2] := 'N';
    Result := 3;
    Exit;
  end;
  i := 0;
  if kind = 2 then
  begin
    if neg then
      b[0] := '-'
    else
      b[0] := '+';
    b[1] := 'I';
    b[2] := 'n';
    b[3] := 'f';
    Result := 4;
    Exit;
  end;
  if neg then
  begin
    b[0] := '-';
    i := 1;
  end;
  if kind = 1 then
  begin
    b[i] := '0';
    Result := i + 1;
    Exit;
  end;
  if IsSingle then
    ShortFloat(m, e, 23, -189, dv, q)
  else
    ShortFloat(m, e, 52, -1085, dv, q);
  nd := PasNumDigitCount(dv);
  PasNumWriteDigits(@digs[0], dv, nd);
  dp := nd + q;
  while digs[nd - 1] = '0' do
    nd := nd - 1;
  if (dp >= 22) or (dp <= -6) then
  begin
    b[i] := digs[0];
    i := i + 1;
    if nd > 1 then
    begin
      b[i] := '.';
      i := i + 1;
      for k := 1 to nd - 1 do
      begin
        b[i] := digs[k];
        i := i + 1;
      end;
    end;
    b[i] := 'e';
    x := dp - 1;
    if x < 0 then
    begin
      b[i + 1] := '-';
      x := -x;
    end
    else
      b[i + 1] := '+';
    i := i + 2;
    i := i + PasNumAppendUint(Pointer(Int64(P) + i), x);
  end
  else if dp <= 0 then
  begin
    b[i] := '0';
    b[i + 1] := '.';
    i := i + 2;
    for k := 1 to -dp do
    begin
      b[i] := '0';
      i := i + 1;
    end;
    for k := 0 to nd - 1 do
    begin
      b[i] := digs[k];
      i := i + 1;
    end;
  end
  else if dp >= nd then
  begin
    for k := 0 to nd - 1 do
    begin
      b[i] := digs[k];
      i := i + 1;
    end;
    for k := nd to dp - 1 do
    begin
      b[i] := '0';
      i := i + 1;
    end;
  end
  else
  begin
    for k := 0 to dp - 1 do
    begin
      b[i] := digs[k];
      i := i + 1;
    end;
    b[i] := '.';
    i := i + 1;
    for k := dp to nd - 1 do
    begin
      b[i] := digs[k];
      i := i + 1;
    end;
  end;
  Result := i;
end;

function PasNumAppendF64(P: Pointer; Bits: Int64): Int64;
begin
  Result := AppendShort(P, Bits, False);
end;

function PasNumAppendF32(P: Pointer; Bits: Int64): Int64;
begin
  Result := AppendShort(P, Bits, True);
end;

end.
