unit pasnum;

{ Numbers as text, exactly and fast (P200), a core unit. A decimal
  number is read once by one scanner, with Pascal's grammar or JSON's,
  eight digits at a time where eight are there; its value is the
  nearest Double or Single, rounded once, a tie to even, or an integer
  of 64 bits, exact or refused. A real is written with the fewest
  digits that read back as it, in the form of ECMAScript and JSON, and
  an integer two digits at a time, into a buffer the caller gives.
  Nothing is read past the text given and nothing is allocated, so any
  number of pasroutines call it at once.

  The reading is Go's (src/internal/strconv/atof.go: readFloat, atof64,
  atof32, atof64exact, the decimal of decimal.go as the slow path) over
  the unrounded scaling of uscale.go (Russ Cox, "Floating-Point
  Printing and Parsing Can Be Simple And Fast", research.swtch.com/fp),
  which SysUtils' forms of a real use too; the eight digits at a time
  are simdjson's (include/simdjson/generic/numberparsing.h); the
  writing is Go's ftoa.go, itoa.go's formatBase10 and
  encoding/json/internal/jsonwire's AppendFloat. Go's license covers
  the port (LICENSE-GO). }

interface

type
  { What PasNumScan read: the first 19 significant digits as an
    unsigned integer (Mant) and the power of ten that scales them
    (Exp10); how many significant digits the number has (Digits, the
    zeros before the first other digit not counted) and whether one of
    them past the 19th was not 0 (Dropped); its sign (Neg); whether it has
    neither a point nor an exponent (IntLit); and the bytes it takes
    (Len), or, when the scan fails, the offset of the byte that stops
    it, the length when the text ends too soon. }
  TPasNumScan = record
    Mant, Exp10, Digits, Len: Int64;
    Neg, Dropped, IntLit: Boolean;
  end;

const
  { the most bytes PasNumAppendF64, F32, Int and Uint write }
  PasNumTextMax = 32;
  { the hundred pairs of digits, 00 to 99, for two digits a step (Go's
    smalls, itoa.go), here and in pasfmt's PasFmtInt }
  PasNumDigitPairs = '00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899';

{ Reads the number at the start of the N bytes at P. Pascal's grammar
  ([+|-]digits[.digits][(e|E)[+|-]digits], the digits on either side of
  the point, not both, may be missing) or, with Json, RFC 8259's (no +,
  digits before the point, after it and in the exponent, no 0 before
  another digit). The number may be followed by anything: Len says
  where it ends. False when the text does not start with a number. }
function PasNumScan(P: Pointer; N: Int64; Json: Boolean; out Sc: TPasNumScan): Boolean;
{ The Double or Single (its bits, a Single's in the low 32) nearest the
  number Sc read from the text at P, rounded once, a tie to even,
  below the smallest subnormal 0 with the number's sign. False when it
  is past the largest finite one: Bits is then the infinity of its
  sign. }
function PasNumF64(P: Pointer; const Sc: TPasNumScan; out Bits: Int64): Boolean;
function PasNumF32(P: Pointer; const Sc: TPasNumScan; out Bits: Int64): Boolean;
{ The integer the number Sc read from the text at P is, when it is an
  integer literal (IntLit) whose value fits: an Int64, or with U64 a
  QWord, 0 to 2^64 - 1, in the Int64's bits. False otherwise (1.0, 1e2
  and 1e400 are no integers here, as in Go's encoding/json v2), V 0. }
function PasNumI64(P: Pointer; const Sc: TPasNumScan; out V: Int64): Boolean;
function PasNumU64(P: Pointer; const Sc: TPasNumScan; out V: Int64): Boolean;
{ Writes at P the Double or the Single (in the low 32 bits) with the
  bits given, in the fewest digits that read back as it, the way
  ECMAScript writes a number (ECMA-262, Number::toString) and RFC
  8785 a JSON one: in positional notation from 1e-6 to below 1e21, an
  exponent outside (1e+21, 1.5e-7), -0 kept; NaN, +Inf and -Inf as Go
  writes them. Returns the bytes written, PasNumTextMax at most. }
function PasNumAppendF64(P: Pointer; Bits: Int64): Int64;
function PasNumAppendF32(P: Pointer; Bits: Int64): Int64;
{ V in decimal at P, as an Int64 or as a QWord: the bytes written. }
function PasNumAppendInt(P: Pointer; V: Int64): Int64;
function PasNumAppendUint(P: Pointer; V: Int64): Int64;

{ The scaling the forms of SysUtils share (P129): a real's sign, its
  mantissa left-justified in 64 bits and the power of two of that
  mantissa, Kind 0 a number, 1 a zero, 2 an infinity, 3 a NaN, of a
  Single when IsSingle; its fewest digits that read back (MantBits 52
  and MinExp -1085 for a Double, 23 and -189 for a Single) and its N
  digits (at most 18; with Decs at 0 or more, N an estimate and digits
  dropped until Decs are left after the point), as D * 10^P;
  floor(X * log10 2); the decimal digits of D, unsigned and not 0; and
  the N digits of D, unsigned, written at P, 0s before it when N is
  more than it has. }
procedure PasNumSplitReal(X: Double; IsSingle: Boolean; out Neg: Boolean; out M, E: Int64;
  out Kind: Integer);
procedure PasNumShortFloat(M, E: Int64; MantBits, MinExp: Integer; out D, P: Int64);
procedure PasNumFixedWidth(M, E, N, Decs: Int64; out D, P: Int64);
function PasNumLog10Pow2(X: Int64): Int64;
function PasNumDigitCount(D: Int64): Int64;
procedure PasNumWriteDigits(P: Pointer; D, N: Int64);

implementation

