{$mode objfpc}{$H+}

{ Order. Go keeps this in sort; here it is a unit of its own, over the
  open arrays of the language, so an array of any length is sorted in
  place without copying it anywhere.

  Quicksort with the middle of three for the pivot, and insertion sort
  under sixteen elements, which is where quicksort stops paying. The
  pivot choice keeps an array that is already sorted, or sorted the
  wrong way round, from falling into the slow case, which is the one
  mistake this algorithm is known for.

  Strings compare by what they say (P74), so names sort the way a
  person expects. }
unit passort;

interface

type
  { The order, handed in: True when A must come before B. This is what
    Go's sort.Slice takes, and paslang has routine values since P81. }
  TIntLess = function(A, B: Int64): Boolean;
  TRealLess = function(A, B: Real): Boolean;
  TStrLess = function(const A, B: string): Boolean;

  TIntArray = array of Int64;
  TRealArray = array of Real;
  TStrArray = array of string;

{ In place, smallest first. }
procedure SortInts(var A: array of Int64);
procedure SortReals(var A: array of Real);
procedure SortStrings(var A: array of string);

{ In place, in the order handed in. }
procedure SortIntsBy(var A: array of Int64; Less: TIntLess);
procedure SortRealsBy(var A: array of Real; Less: TRealLess);
procedure SortStringsBy(var A: array of string; Less: TStrLess);

{ True when it is in order, which is what a test asks after sorting. }
function IntsSorted(const A: array of Int64): Boolean;
function RealsSorted(const A: array of Real): Boolean;
function StringsSorted(const A: array of string): Boolean;

{ Where a value is in a sorted array, or -1. }
function FindInt(const A: array of Int64; V: Int64): Integer;
function FindStr(const A: array of string; const V: string): Integer;

{ Where a value would go in a sorted array: the first place whose value
  is not smaller. Length(A) when it goes at the end. }
function PlaceInt(const A: array of Int64; V: Int64): Integer;
function PlaceStr(const A: array of string; const V: string): Integer;

implementation

const
  Small = 16;

{ ---- integers ---- }

procedure InsInts(var A: array of Int64; Lo, Hi: Integer);
var
  i, j: Integer;
  v: Int64;
begin
  for i := Lo + 1 to Hi do
  begin
    v := A[i];
    j := i - 1;
    while (j >= Lo) and (A[j] > v) do
    begin
      A[j + 1] := A[j];
      j := j - 1;
    end;
    A[j + 1] := v;
  end;
end;

procedure QInts(var A: array of Int64; Lo, Hi: Integer);
var
  i, j, mid: Integer;
  p, t: Int64;
begin
  while Hi - Lo >= Small do
  begin
    mid := Lo + (Hi - Lo) div 2;
    { The middle of the three, so a sorted array is not the worst case. }
    if A[mid] < A[Lo] then
    begin
      t := A[mid];
      A[mid] := A[Lo];
      A[Lo] := t;
    end;
    if A[Hi] < A[Lo] then
    begin
      t := A[Hi];
      A[Hi] := A[Lo];
      A[Lo] := t;
    end;
    if A[Hi] < A[mid] then
    begin
      t := A[Hi];
      A[Hi] := A[mid];
      A[mid] := t;
    end;
    p := A[mid];
    i := Lo;
    j := Hi;
    while i <= j do
    begin
      while A[i] < p do
        i := i + 1;
      while A[j] > p do
        j := j - 1;
      if i <= j then
      begin
        t := A[i];
        A[i] := A[j];
        A[j] := t;
        i := i + 1;
        j := j - 1;
      end;
    end;
    { The smaller half first, so the recursion cannot go deep. }
    if (j - Lo) < (Hi - i) then
    begin
      QInts(A, Lo, j);
      Lo := i;
    end
    else
    begin
      QInts(A, i, Hi);
      Hi := j;
    end;
  end;
  InsInts(A, Lo, Hi);
end;

procedure SortInts(var A: array of Int64);
begin
  if Length(A) > 1 then
    QInts(A, 0, High(A));
end;

{ ---- reals ---- }

procedure InsReals(var A: array of Real; Lo, Hi: Integer);
var
  i, j: Integer;
  v: Real;
begin
  for i := Lo + 1 to Hi do
  begin
    v := A[i];
    j := i - 1;
    while (j >= Lo) and (A[j] > v) do
    begin
      A[j + 1] := A[j];
      j := j - 1;
    end;
    A[j + 1] := v;
  end;
end;

procedure QReals(var A: array of Real; Lo, Hi: Integer);
var
  i, j, mid: Integer;
  p, t: Real;
begin
  while Hi - Lo >= Small do
  begin
    mid := Lo + (Hi - Lo) div 2;
    if A[mid] < A[Lo] then
    begin
      t := A[mid];
      A[mid] := A[Lo];
      A[Lo] := t;
    end;
    if A[Hi] < A[Lo] then
    begin
      t := A[Hi];
      A[Hi] := A[Lo];
      A[Lo] := t;
    end;
    if A[Hi] < A[mid] then
    begin
      t := A[Hi];
      A[Hi] := A[mid];
      A[mid] := t;
    end;
    p := A[mid];
    i := Lo;
    j := Hi;
    while i <= j do
    begin
      while A[i] < p do
        i := i + 1;
      while A[j] > p do
        j := j - 1;
      if i <= j then
      begin
        t := A[i];
        A[i] := A[j];
        A[j] := t;
        i := i + 1;
        j := j - 1;
      end;
    end;
    if (j - Lo) < (Hi - i) then
    begin
      QReals(A, Lo, j);
      Lo := i;
    end
    else
    begin
      QReals(A, i, Hi);
      Hi := j;
    end;
  end;
  InsReals(A, Lo, Hi);
end;

procedure SortReals(var A: array of Real);
begin
  if Length(A) > 1 then
    QReals(A, 0, High(A));
end;

{ ---- strings ---- }

procedure InsStrs(var A: array of string; Lo, Hi: Integer);
var
  i, j: Integer;
  v: string;
begin
  for i := Lo + 1 to Hi do
  begin
    v := A[i];
    j := i - 1;
    while (j >= Lo) and (A[j] > v) do
    begin
      A[j + 1] := A[j];
      j := j - 1;
    end;
    A[j + 1] := v;
  end;
end;

procedure QStrs(var A: array of string; Lo, Hi: Integer);
var
  i, j, mid: Integer;
  p, t: string;
begin
  while Hi - Lo >= Small do
  begin
    mid := Lo + (Hi - Lo) div 2;
    if A[mid] < A[Lo] then
    begin
      t := A[mid];
      A[mid] := A[Lo];
      A[Lo] := t;
    end;
    if A[Hi] < A[Lo] then
    begin
      t := A[Hi];
      A[Hi] := A[Lo];
      A[Lo] := t;
    end;
    if A[Hi] < A[mid] then
    begin
      t := A[Hi];
      A[Hi] := A[mid];
      A[mid] := t;
    end;
    p := A[mid];
    i := Lo;
    j := Hi;
    while i <= j do
    begin
      while A[i] < p do
        i := i + 1;
      while A[j] > p do
        j := j - 1;
      if i <= j then
      begin
        t := A[i];
        A[i] := A[j];
        A[j] := t;
        i := i + 1;
        j := j - 1;
      end;
    end;
    if (j - Lo) < (Hi - i) then
    begin
      QStrs(A, Lo, j);
      Lo := i;
    end
    else
    begin
      QStrs(A, i, Hi);
      Hi := j;
    end;
  end;
  InsStrs(A, Lo, Hi);
end;

procedure SortStrings(var A: array of string);
begin
  if Length(A) > 1 then
    QStrs(A, 0, High(A));
end;

{ ---- with the order handed in ----

  Quicksort again, asking the routine instead of the operator. The
  routine must answer the same way every time it is asked about the
  same two values, or no sort can do anything sensible. }

procedure QIntsBy(var A: array of Int64; Lo, Hi: Integer; Less: TIntLess);
var
  i, j, mid: Integer;
  p, t: Int64;
begin
  while Lo < Hi do
  begin
    mid := Lo + (Hi - Lo) div 2;
    if Less(A[mid], A[Lo]) then
    begin
      t := A[mid];
      A[mid] := A[Lo];
      A[Lo] := t;
    end;
    if Less(A[Hi], A[Lo]) then
    begin
      t := A[Hi];
      A[Hi] := A[Lo];
      A[Lo] := t;
    end;
    if Less(A[Hi], A[mid]) then
    begin
      t := A[Hi];
      A[Hi] := A[mid];
      A[mid] := t;
    end;
    p := A[mid];
    i := Lo;
    j := Hi;
    while i <= j do
    begin
      while Less(A[i], p) do
        i := i + 1;
      while Less(p, A[j]) do
        j := j - 1;
      if i <= j then
      begin
        t := A[i];
        A[i] := A[j];
        A[j] := t;
        i := i + 1;
        j := j - 1;
      end;
    end;
    if (j - Lo) < (Hi - i) then
    begin
      QIntsBy(A, Lo, j, Less);
      Lo := i;
    end
    else
    begin
      QIntsBy(A, i, Hi, Less);
      Hi := j;
    end;
  end;
end;

procedure SortIntsBy(var A: array of Int64; Less: TIntLess);
begin
  if (Length(A) > 1) and (Less <> nil) then
    QIntsBy(A, 0, High(A), Less);
end;

procedure QRealsBy(var A: array of Real; Lo, Hi: Integer; Less: TRealLess);
var
  i, j, mid: Integer;
  p, t: Real;
begin
  while Lo < Hi do
  begin
    mid := Lo + (Hi - Lo) div 2;
    if Less(A[mid], A[Lo]) then
    begin
      t := A[mid];
      A[mid] := A[Lo];
      A[Lo] := t;
    end;
    if Less(A[Hi], A[Lo]) then
    begin
      t := A[Hi];
      A[Hi] := A[Lo];
      A[Lo] := t;
    end;
    if Less(A[Hi], A[mid]) then
    begin
      t := A[Hi];
      A[Hi] := A[mid];
      A[mid] := t;
    end;
    p := A[mid];
    i := Lo;
    j := Hi;
    while i <= j do
    begin
      while Less(A[i], p) do
        i := i + 1;
      while Less(p, A[j]) do
        j := j - 1;
      if i <= j then
      begin
        t := A[i];
        A[i] := A[j];
        A[j] := t;
        i := i + 1;
        j := j - 1;
      end;
    end;
    if (j - Lo) < (Hi - i) then
    begin
      QRealsBy(A, Lo, j, Less);
      Lo := i;
    end
    else
    begin
      QRealsBy(A, i, Hi, Less);
      Hi := j;
    end;
  end;
end;

procedure SortRealsBy(var A: array of Real; Less: TRealLess);
begin
  if (Length(A) > 1) and (Less <> nil) then
    QRealsBy(A, 0, High(A), Less);
end;

procedure QStrsBy(var A: array of string; Lo, Hi: Integer; Less: TStrLess);
var
  i, j, mid: Integer;
  p, t: string;
begin
  while Lo < Hi do
  begin
    mid := Lo + (Hi - Lo) div 2;
    if Less(A[mid], A[Lo]) then
    begin
      t := A[mid];
      A[mid] := A[Lo];
      A[Lo] := t;
    end;
    if Less(A[Hi], A[Lo]) then
    begin
      t := A[Hi];
      A[Hi] := A[Lo];
      A[Lo] := t;
    end;
    if Less(A[Hi], A[mid]) then
    begin
      t := A[Hi];
      A[Hi] := A[mid];
      A[mid] := t;
    end;
    p := A[mid];
    i := Lo;
    j := Hi;
    while i <= j do
    begin
      while Less(A[i], p) do
        i := i + 1;
      while Less(p, A[j]) do
        j := j - 1;
      if i <= j then
      begin
        t := A[i];
        A[i] := A[j];
        A[j] := t;
        i := i + 1;
        j := j - 1;
      end;
    end;
    if (j - Lo) < (Hi - i) then
    begin
      QStrsBy(A, Lo, j, Less);
      Lo := i;
    end
    else
    begin
      QStrsBy(A, i, Hi, Less);
      Hi := j;
    end;
  end;
end;

procedure SortStringsBy(var A: array of string; Less: TStrLess);
begin
  if (Length(A) > 1) and (Less <> nil) then
    QStrsBy(A, 0, High(A), Less);
end;

{ ---- in order, and looking things up ---- }

function IntsSorted(const A: array of Int64): Boolean;
var
  i: Integer;
begin
  Result := True;
  for i := 1 to High(A) do
    if A[i] < A[i - 1] then
    begin
      Result := False;
      Exit;
    end;
end;

function RealsSorted(const A: array of Real): Boolean;
var
  i: Integer;
begin
  Result := True;
  for i := 1 to High(A) do
    if A[i] < A[i - 1] then
    begin
      Result := False;
      Exit;
    end;
end;

function StringsSorted(const A: array of string): Boolean;
var
  i: Integer;
begin
  Result := True;
  for i := 1 to High(A) do
    if A[i] < A[i - 1] then
    begin
      Result := False;
      Exit;
    end;
end;

function PlaceInt(const A: array of Int64; V: Int64): Integer;
var
  lo, hi, mid: Integer;
begin
  lo := 0;
  hi := Length(A);
  while lo < hi do
  begin
    mid := lo + (hi - lo) div 2;
    if A[mid] < V then
      lo := mid + 1
    else
      hi := mid;
  end;
  Result := lo;
end;

function PlaceStr(const A: array of string; const V: string): Integer;
var
  lo, hi, mid: Integer;
begin
  lo := 0;
  hi := Length(A);
  while lo < hi do
  begin
    mid := lo + (hi - lo) div 2;
    if A[mid] < V then
      lo := mid + 1
    else
      hi := mid;
  end;
  Result := lo;
end;

function FindInt(const A: array of Int64; V: Int64): Integer;
var
  i: Integer;
begin
  Result := -1;
  i := PlaceInt(A, V);
  if (i < Length(A)) and (A[i] = V) then
    Result := i;
end;

function FindStr(const A: array of string; const V: string): Integer;
var
  i: Integer;
begin
  Result := -1;
  i := PlaceStr(A, V);
  if (i < Length(A)) and (A[i] = V) then
    Result := i;
end;

end.
