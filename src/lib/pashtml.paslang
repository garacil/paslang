const
  { the code points of &#x80; to &#x9F; (13.2.5.80): what Windows-1252 has
    there, the five undefined ones themselves }
  NumRef80: array[0..31] of Integer = ($20AC, $81, $201A, $0192, $201E, $2026, $2020, $2021, $02C6, $2030, $0160, $2039, $0152,
    $8D, $017D, $8F, $90, $2018, $2019, $201C, $201D, $2022, $2013, $2014, $02DC, $2122, $0161, $203A, $0153, $9D, $017E, $0178);
  { no legacy name is longer than this (13.2.5.78's table) }
  LongestLegacy = 6;

function IsAlpha(C: Char): Boolean;
begin
  Result := ((C >= 'a') and (C <= 'z')) or ((C >= 'A') and (C <= 'Z'));
end;

function IsDigit(C: Char): Boolean;
begin
  Result := (C >= '0') and (C <= '9');
end;

function IsAlnum(C: Char): Boolean;
begin
  Result := IsAlpha(C) or IsDigit(C);
end;

{ the ASCII whitespace of the standard: TAB, LF, FF and SPACE (CR is gone
  after the normalization) }
function IsSpace(C: Char): Boolean;
begin
  Result := (C = ' ') or (C = #9) or (C = #10) or (C = #12);
end;

function Lower(C: Char): Char;
begin
  if (C >= 'A') and (C <= 'Z') then
    Result := Chr(Ord(C) + 32)
  else
    Result := C;
end;

function LowerAscii(const S: string): string;
var
  i: Integer;
begin
  Result := S;
  for i := 1 to Length(Result) do
    Result[i] := Lower(Result[i]);
end;

procedure AddRune(B: TStringBuilder; R: Integer);
begin
  if R < $80 then
    B.AddChar(Chr(R))
  else if R < $800 then
  begin
    B.AddChar(Chr($C0 or (R shr 6)));
    B.AddChar(Chr($80 or (R and $3F)));
  end
  else if R < $10000 then
  begin
    B.AddChar(Chr($E0 or (R shr 12)));
    B.AddChar(Chr($80 or ((R shr 6) and $3F)));
    B.AddChar(Chr($80 or (R and $3F)));
  end
  else
  begin
    B.AddChar(Chr($F0 or (R shr 18)));
    B.AddChar(Chr($80 or ((R shr 12) and $3F)));
    B.AddChar(Chr($80 or ((R shr 6) and $3F)));
    B.AddChar(Chr($80 or (R and $3F)));
  end;
end;

{ the index of the name in the table, -1 when it is not there }
function EntityIndex(const Nm: string): Integer;
var
  lo, hi, mid, c: Integer;
begin
  Result := -1;
  lo := 0;
  hi := HtmlEntCount - 1;
  while lo <= hi do
  begin
    mid := (lo + hi) div 2;
    c := CompareStr(HtmlEntName[mid], Nm);
    if c = 0 then
    begin
      Result := mid;
      Exit;
    end;
    if c < 0 then
      lo := mid + 1
    else
      hi := mid - 1;
  end;
end;

procedure AddEntity(B: TStringBuilder; Idx: Integer);
begin
  AddRune(B, HtmlEntCode[Idx]);
  if HtmlEntCode2[Idx] <> 0 then
    AddRune(B, HtmlEntCode2[Idx]);
end;

{ the reference at S[I] (an ampersand) written to B as the standard decodes
  it; I moves past what was consumed. InAttr: the rules of an attribute
  value. NulToFffd: a U+0000 in the text itself becomes U+FFFD (the states
  that say so) instead of being dropped. }
procedure Unescape(const S: string; InAttr: Boolean; B: TStringBuilder);
var
  i, j, k, n, code, d, L, idx: Integer;
  isHex, semi: Boolean;
  nm: string;
begin
  n := Length(S);
  i := 1;
  while i <= n do
  begin
    if S[i] <> '&' then
    begin
      B.AddChar(S[i]);
      i := i + 1;
      Continue;
    end;
    j := i + 1;
    if (j <= n) and (S[j] = '#') then
    begin
      k := j + 1;
      isHex := (k <= n) and ((S[k] = 'x') or (S[k] = 'X'));
      if isHex then
        k := k + 1;
      code := 0;
      d := k;
      while k <= n do
      begin
        if IsDigit(S[k]) then
          L := Ord(S[k]) - 48
        else if isHex and (S[k] >= 'a') and (S[k] <= 'f') then
          L := Ord(S[k]) - 87
        else if isHex and (S[k] >= 'A') and (S[k] <= 'F') then
          L := Ord(S[k]) - 55
        else
          Break;
        if code < $110000 then
          if isHex then
            code := code * 16 + L
          else
            code := code * 10 + L;
        k := k + 1;
      end;
      if k = d then
      begin
        { no digits: &# or &#x stay as they are }
        B.AddText(Copy(S, i, k - i));
        i := k;
        Continue;
      end;
      if (k <= n) and (S[k] = ';') then
        k := k + 1;
      if (code = 0) or (code > $10FFFF) or ((code >= $D800) and (code <= $DFFF)) then
        code := $FFFD
      else if (code >= $80) and (code <= $9F) then
        code := NumRef80[code - $80];
      AddRune(B, code);
      i := k;
      Continue;
    end;
    if (j <= n) and IsAlnum(S[j]) then
    begin
      k := j;
      while (k <= n) and IsAlnum(S[k]) do
        k := k + 1;
      nm := Copy(S, j, k - j);
      semi := (k <= n) and (S[k] = ';');
      if semi then
      begin
        idx := EntityIndex(nm + ';');
        if idx >= 0 then
        begin
          AddEntity(B, idx);
          i := k + 1;
          Continue;
        end;
      end;
      { a legacy name without its semicolon: the whole run, or in text its longest prefix }
      idx := EntityIndex(nm);
      if (idx >= 0) and InAttr and (k <= n) and (S[k] = '=') then
        idx := -1;
      if idx >= 0 then
      begin
        AddEntity(B, idx);
        i := k;
        Continue;
      end;
      if not InAttr then
      begin
        L := Length(nm);
        if L > LongestLegacy then
          L := LongestLegacy;
        while L >= 2 do
        begin
          idx := EntityIndex(Copy(nm, 1, L));
          if idx >= 0 then
            Break;
          L := L - 1;
        end;
        if idx >= 0 then
        begin
          AddEntity(B, idx);
          i := j + L;
          Continue;
        end;
      end;
    end;
    { an ampersand that starts no reference }
    B.AddChar('&');
    i := j;
  end;
end;

function HtmlUnescape(const S: string): string;
var
  b: TStringBuilder;
begin
  if Pos('&', S) = 0 then
  begin
    Result := S;
    Exit;
  end;
  b := TStringBuilder.Create(Length(S));
  Unescape(S, False, b);
  Result := b.ToString;
end;

function HtmlUnescapeAttr(const S: string): string;
var
  b: TStringBuilder;
begin
  if Pos('&', S) = 0 then
  begin
    Result := S;
    Exit;
  end;
  b := TStringBuilder.Create(Length(S));
  Unescape(S, True, b);
  Result := b.ToString;
end;

function HtmlEscape(const S: string): string;
var
  b: TStringBuilder;
  i: Integer;
begin
  b := TStringBuilder.Create(Length(S) + 16);
  for i := 1 to Length(S) do
    case S[i] of
      '&': b.AddText('&amp;');
      '<': b.AddText('&lt;');
      '>': b.AddText('&gt;');
      '"': b.AddText('&#34;');
      '''': b.AddText('&#39;');
    else
      b.AddChar(S[i]);
    end;
  Result := b.ToString;
end;

function HtmlNormalizeNewlines(const S: string): string;
var
  b: TStringBuilder;
  i, n: Integer;
begin
  if Pos(#13, S) = 0 then
  begin
    Result := S;
    Exit;
  end;
  n := Length(S);
  b := TStringBuilder.Create(n);
  i := 1;
  while i <= n do
  begin
    if S[i] = #13 then
    begin
      b.AddChar(#10);
      if (i < n) and (S[i + 1] = #10) then
        i := i + 1;
    end
    else
      b.AddChar(S[i]);
    i := i + 1;
  end;
  Result := b.ToString;
end;

{ a U+0000 of a tag name, an attribute, a comment or raw text is U+FFFD }
function NulToFffd(const S: string): string;
var
  b: TStringBuilder;
  i: Integer;
begin
  if Pos(#0, S) = 0 then
  begin
    Result := S;
    Exit;
  end;
  b := TStringBuilder.Create(Length(S) + 8);
  for i := 1 to Length(S) do
    if S[i] = #0 then
      AddRune(b, $FFFD)
    else
      b.AddChar(S[i]);
  Result := b.ToString;
end;

{ a U+0000 of the data state is dropped (the tree builder ignores it) }
function DropNul(const S: string): string;
var
  b: TStringBuilder;
  i: Integer;
begin
  if Pos(#0, S) = 0 then
  begin
    Result := S;
    Exit;
  end;
  b := TStringBuilder.Create(Length(S));
  for i := 1 to Length(S) do
    if S[i] <> #0 then
      b.AddChar(S[i]);
  Result := b.ToString;
end;

{ ---- the tokenizer ---- }

constructor THtmlTokenizer.Create(const AText: string);
begin
  inherited Create;
  SetText(AText);
end;

procedure THtmlTokenizer.SetText(const Value: string);
begin
  FText := HtmlNormalizeNewlines(Value);
  FPos := 1;
  FRaw := 0;
  FRawName := '';
end;

function THtmlTokenizer.AttrCount: Integer;
begin
  Result := Length(Attrs);
end;

function THtmlTokenizer.Attr(const AName: string): string;
var
  i: Integer;
  lname: string;
begin
  Result := '';
  lname := LowerAscii(AName);
  for i := 0 to Length(Attrs) - 1 do
    if Attrs[i].Name = lname then
    begin
      Result := Attrs[i].Value;
      Exit;
    end;
end;

function THtmlTokenizer.HasAttr(const AName: string): Boolean;
var
  i: Integer;
  lname: string;
begin
  Result := False;
  lname := LowerAscii(AName);
  for i := 0 to Length(Attrs) - 1 do
    if Attrs[i].Name = lname then
    begin
      Result := True;
      Exit;
    end;
end;

{ whether a < at I opens a tag, a comment, a declaration or an end tag }
function TagOpens(const S: string; I: Integer): Boolean;
var
  c: Char;
begin
  Result := False;
  if (I >= Length(S)) or (S[I] <> '<') then
    Exit;
  c := S[I + 1];
  Result := IsAlpha(c) or (c = '!') or (c = '/') or (c = '?');
end;

{ a run of text up to the next tag or the end }
function THtmlTokenizer.TextRun: Boolean;
var
  n, i: Integer;
begin
  n := Length(FText);
  i := FPos;
  repeat
    i := i + 1;
  until (i > n) or ((FText[i] = '<') and TagOpens(FText, i));
  Kind := hkText;
  Name := '';
  SetLength(Attrs, 0);
  SelfClosing := False;
  Start := FPos;
  Stop := i;
  Data := HtmlUnescape(DropNul(Copy(FText, FPos, i - FPos)));
  FPos := i;
  Result := True;
end;

{ inside a raw text element: the text up to the appropriate end tag, then
  the end tag itself }
function THtmlTokenizer.RawTextToken: Boolean;
var
  n, i, k, m: Integer;
  found: Boolean;
  c: Char;
begin
  n := Length(FText);
  if FRaw = 3 then
  begin
    { plaintext: everything to the end }
    Kind := hkText;
    Name := '';
    SetLength(Attrs, 0);
    SelfClosing := False;
    Start := FPos;
    Stop := n + 1;
    Data := NulToFffd(Copy(FText, FPos, n - FPos + 1));
    FPos := n + 1;
    Result := True;
    Exit;
  end;
  m := Length(FRawName);
  i := FPos;
  found := False;
  while i <= n do
  begin
    if (FText[i] = '<') and (i + 1 <= n) and (FText[i + 1] = '/') and (i + 1 + m <= n) and
      (LowerAscii(Copy(FText, i + 2, m)) = FRawName) then
    begin
      { the appropriate end tag: its name and then white space, / or >; at the end of the text it is text, as
        13.2.5.14's anything-else says (Python reads it so too) }
      k := i + 2 + m;
      if k <= n then
      begin
        c := FText[k];
        if IsSpace(c) or (c = '/') or (c = '>') then
        begin
          found := True;
          Break;
        end;
      end;
    end;
    i := i + 1;
  end;
  if not found then
    i := n + 1;
  if i > FPos then
  begin
    Kind := hkText;
    Name := '';
    SetLength(Attrs, 0);
    SelfClosing := False;
    Start := FPos;
    Stop := i;
    Data := NulToFffd(Copy(FText, FPos, i - FPos));
    if FRaw = 1 then
      Data := HtmlUnescape(Data);
    FPos := i;
    Result := True;
    Exit;
  end;
  { at the end tag (i = FPos <= n, since the loop above stopped on it) }
  FRaw := 0;
  FRawName := '';
  Result := ReadTag;
end;

{ the attributes of a tag, from FPos (after the name) to past its >; Keep
  False for an end tag, whose attributes are read and dropped. False when
  the end of the text comes first (the tag is dropped). }
procedure THtmlTokenizer.ReadAttributes(Keep: Boolean);
var
  n, i, k: Integer;
  nm, v: string;
  q: Char;
  dup: Boolean;
begin
  n := Length(FText);
  while True do
  begin
    while (FPos <= n) and IsSpace(FText[FPos]) do
      FPos := FPos + 1;
    if FPos > n then
      Exit;
    if FText[FPos] = '>' then
    begin
      FPos := FPos + 1;
      Exit;
    end;
    if FText[FPos] = '/' then
    begin
      if (FPos < n) and (FText[FPos + 1] = '>') then
      begin
        SelfClosing := Keep;
        FPos := FPos + 2;
        Exit;
      end;
      FPos := FPos + 1;
      Continue;
    end;
    { the name: an = first is part of it (13.2.5.32) }
    i := FPos;
    if FText[i] = '=' then
      i := i + 1;
    while (i <= n) and not (IsSpace(FText[i]) or (FText[i] = '/') or (FText[i] = '>') or (FText[i] = '=')) do
      i := i + 1;
    nm := LowerAscii(NulToFffd(Copy(FText, FPos, i - FPos)));
    FPos := i;
    while (FPos <= n) and IsSpace(FText[FPos]) do
      FPos := FPos + 1;
    v := '';
    if (FPos <= n) and (FText[FPos] = '=') then
    begin
      FPos := FPos + 1;
      while (FPos <= n) and IsSpace(FText[FPos]) do
        FPos := FPos + 1;
      if FPos > n then
        Exit;
      if (FText[FPos] = '"') or (FText[FPos] = '''') then
      begin
        q := FText[FPos];
        k := FPos + 1;
        while (k <= n) and (FText[k] <> q) do
          k := k + 1;
        if k > n then
        begin
          FPos := k;
          Exit;
        end;
        v := HtmlUnescapeAttr(NulToFffd(Copy(FText, FPos + 1, k - FPos - 1)));
        FPos := k + 1;
      end
      else
      begin
        k := FPos;
        while (k <= n) and not (IsSpace(FText[k]) or (FText[k] = '>')) do
          k := k + 1;
        v := HtmlUnescapeAttr(NulToFffd(Copy(FText, FPos, k - FPos)));
        FPos := k;
      end;
    end;
    if Keep then
    begin
      dup := False;
      for k := 0 to Length(Attrs) - 1 do
        if Attrs[k].Name = nm then
          dup := True;
      if not dup then
      begin
        SetLength(Attrs, Length(Attrs) + 1);
        Attrs[Length(Attrs) - 1].Name := nm;
        Attrs[Length(Attrs) - 1].Value := v;
      end;
    end;
  end;
end;

{ a start or an end tag at FPos (a < then a letter, or </ then a letter);
  False when the text ends inside it }
function THtmlTokenizer.ReadTag: Boolean;
var
  n, i, at0: Integer;
  ending: Boolean;
begin
  n := Length(FText);
  at0 := FPos;
  ending := FText[FPos + 1] = '/';
  if ending then
    FPos := FPos + 2
  else
    FPos := FPos + 1;
  i := FPos;
  while (i <= n) and not (IsSpace(FText[i]) or (FText[i] = '/') or (FText[i] = '>')) do
    i := i + 1;
  Name := LowerAscii(NulToFffd(Copy(FText, FPos, i - FPos)));
  FPos := i;
  SetLength(Attrs, 0);
  SelfClosing := False;
  Data := '';
  ReadAttributes(not ending);
  if (FPos > n) and ((n = 0) or (FText[n] <> '>')) then
  begin
    { the text ended inside the tag: the tag is dropped, as 13.2.5.8 says (eof-in-tag) }
    Result := False;
    Exit;
  end;
  if ending then
    Kind := hkEndTag
  else
    Kind := hkStartTag;
  Start := at0;
  Stop := FPos;
  if not ending then
  begin
    if (Name = 'title') or (Name = 'textarea') then
    begin
      FRaw := 1;
      FRawName := Name;
    end
    else if (Name = 'script') or (Name = 'style') or (Name = 'xmp') or (Name = 'iframe') or (Name = 'noembed') or
      (Name = 'noframes') then
    begin
      FRaw := 2;
      FRawName := Name;
    end
    else if Name = 'plaintext' then
      FRaw := 3;
  end;
  Result := True;
end;

{ a bogus comment: the data from From to the first >, or to the end }
procedure THtmlTokenizer.BogusComment(From: Integer);
var
  n, i: Integer;
begin
  n := Length(FText);
  i := From;
  while (i <= n) and (FText[i] <> '>') do
    i := i + 1;
  Kind := hkComment;
  Name := '';
  SetLength(Attrs, 0);
  SelfClosing := False;
  Data := NulToFffd(Copy(FText, From, i - From));
  Stop := i + 1;
  if i > n then
    Stop := n + 1;
  FPos := Stop;
end;

{ <! at FPos: a comment, a doctype, or a bogus comment }
function THtmlTokenizer.ReadMarkupDeclaration: Boolean;
var
  n, i, k, from: Integer;
  w: string;
begin
  n := Length(FText);
  Start := FPos;
  Result := True;
  if Copy(FText, FPos + 2, 2) = '--' then
  begin
    from := FPos + 4;
    Kind := hkComment;
    Name := '';
    SetLength(Attrs, 0);
    SelfClosing := False;
    { <!--> and <!---> are empty comments (abrupt-closing-of-empty-comment) }
    if (from <= n) and (FText[from] = '>') then
    begin
      Data := '';
      FPos := from + 1;
      Stop := FPos;
      Exit;
    end;
    if (from < n) and (FText[from] = '-') and (FText[from + 1] = '>') then
    begin
      Data := '';
      FPos := from + 2;
      Stop := FPos;
      Exit;
    end;
    i := from;
    while i <= n do
    begin
      if (FText[i] = '-') and (i + 2 <= n) and (FText[i + 1] = '-') then
      begin
        if FText[i + 2] = '>' then
        begin
          k := i + 3;
          Break;
        end;
        if (FText[i + 2] = '!') and (i + 3 <= n) and (FText[i + 3] = '>') then
        begin
          k := i + 4;
          Break;
        end;
      end;
      i := i + 1;
    end;
    if i > n then
    begin
      i := n + 1;
      k := n + 1;
    end;
    Data := NulToFffd(Copy(FText, from, i - from));
    FPos := k;
    Stop := k;
    Exit;
  end;
  w := LowerAscii(Copy(FText, FPos + 2, 7));
  if w = 'doctype' then
  begin
    Kind := hkDoctype;
    SetLength(Attrs, 0);
    SelfClosing := False;
    i := FPos + 9;
    while (i <= n) and IsSpace(FText[i]) do
      i := i + 1;
    k := i;
    while (k <= n) and not (IsSpace(FText[k]) or (FText[k] = '>')) do
      k := k + 1;
    Name := LowerAscii(NulToFffd(Copy(FText, i, k - i)));
    i := k;
    while (i <= n) and (FText[i] <> '>') do
      i := i + 1;
    Data := Trim(NulToFffd(Copy(FText, k, i - k)));
    if i > n then
      FPos := n + 1
    else
      FPos := i + 1;
    Stop := FPos;
    Exit;
  end;
  { [CDATA[ in HTML content, and anything else: a bogus comment from after the <! }
  BogusComment(FPos + 2);
  Start := Start;
end;

function THtmlTokenizer.Next: Boolean;
var
  n: Integer;
  c: Char;
begin
  Result := False;
  n := Length(FText);
  while FPos <= n do
  begin
    if FRaw <> 0 then
    begin
      Result := RawTextToken;
      Exit;
    end;
    if (FText[FPos] <> '<') or not TagOpens(FText, FPos) then
    begin
      Result := TextRun;
      Exit;
    end;
    c := FText[FPos + 1];
    if c = '!' then
    begin
      Result := ReadMarkupDeclaration;
      Exit;
    end;
    if c = '?' then
    begin
      Start := FPos;
      BogusComment(FPos + 1);
      Result := True;
      Exit;
    end;
    if c = '/' then
    begin
      if FPos + 2 > n then
      begin
        { </ at the very end is text }
        Kind := hkText;
        Name := '';
        SetLength(Attrs, 0);
        SelfClosing := False;
        Start := FPos;
        Stop := n + 1;
        Data := Copy(FText, FPos, n - FPos + 1);
        FPos := n + 1;
        Result := True;
        Exit;
      end;
      if IsAlpha(FText[FPos + 2]) then
      begin
        Result := ReadTag;
        Exit;
      end;
      if FText[FPos + 2] = '>' then
      begin
        { </> is nothing (missing-end-tag-name) }
        FPos := FPos + 3;
        Continue;
      end;
      Start := FPos;
      BogusComment(FPos + 2);
      Result := True;
      Exit;
    end;
    { a letter: a start tag }
    Result := ReadTag;
    Exit;
  end;
end;

{ ---- the text of an HTML document ---- }

{ the elements a reader lays out as blocks: a line break before and after }
function IsBlock(const Nm: string): Boolean;
begin
  Result := (Nm = 'div') or (Nm = 'tr') or (Nm = 'li') or (Nm = 'dd') or (Nm = 'dt') or (Nm = 'section') or (Nm = 'article') or
    (Nm = 'header') or (Nm = 'footer') or (Nm = 'nav') or (Nm = 'aside') or (Nm = 'main') or (Nm = 'form') or
    (Nm = 'fieldset') or (Nm = 'address') or (Nm = 'figure') or (Nm = 'figcaption') or (Nm = 'details') or
    (Nm = 'summary') or (Nm = 'center') or (Nm = 'dir') or (Nm = 'menu') or (Nm = 'tbody') or (Nm = 'thead') or
    (Nm = 'tfoot') or (Nm = 'caption') or (Nm = 'legend') or (Nm = 'option') or (Nm = 'body') or (Nm = 'html') or
    (Nm = 'dl') or (Nm = 'colgroup');
end;

{ the blocks a blank line surrounds }
function IsParagraph(const Nm: string): Boolean;
begin
  Result := (Nm = 'p') or (Nm = 'h1') or (Nm = 'h2') or (Nm = 'h3') or (Nm = 'h4') or (Nm = 'h5') or (Nm = 'h6') or
    (Nm = 'table') or (Nm = 'ul') or (Nm = 'ol') or (Nm = 'blockquote') or (Nm = 'pre') or (Nm = 'hr');
end;

function HtmlToText(const S: string): string;
var
  tk: THtmlTokenizer;
  b: TStringBuilder;
  i, n, pre, skip, lineStart, blank, lf: Integer;
  pending, inHead, dropLf: Boolean;
  d, r: string;

  { a line break, when something is on the line; Two asks for a blank line too }
  procedure LineBreak(Two: Boolean);
  begin
    if b.ByteLength = 0 then
      Exit;
    if lf = 0 then
    begin
      b.AddChar(#10);
      lf := 1;
    end;
    if Two and (lf = 1) then
    begin
      b.AddChar(#10);
      lf := 2;
    end;
    pending := False;
  end;

begin
  tk := THtmlTokenizer.Create(S);
  b := TStringBuilder.Create(Length(S));
  pre := 0;
  skip := 0;
  lf := 0;
  pending := False;
  inHead := False;
  dropLf := False;
  while tk.Next do
  begin
    case tk.Kind of
      hkText:
        begin
          if inHead or (skip > 0) then
            Continue;
          d := tk.Data;
          if dropLf then
          begin
            dropLf := False;
            if (d <> '') and (d[1] = #10) then
              d := Copy(d, 2, Length(d) - 1);
          end;
          n := Length(d);
          i := 1;
          while i <= n do
          begin
            if (d[i] = #194) and (i < n) and (d[i + 1] = #160) then
            begin
              { a no-break space is a space }
              d[i] := ' ';
              d[i + 1] := ' ';
              i := i + 1;
              if pre > 0 then
                b.AddChar(' ')
              else
                pending := True;
            end
            else if pre > 0 then
            begin
              b.AddChar(d[i]);
              if d[i] = #10 then
                lf := 1
              else
                lf := 0;
            end
            else if IsSpace(d[i]) then
              pending := True
            else
            begin
              if pending and (lf = 0) and (b.ByteLength > 0) then
                b.AddChar(' ');
              pending := False;
              b.AddChar(d[i]);
              lf := 0;
            end;
            i := i + 1;
          end;
        end;
      hkStartTag:
        begin
          d := tk.Name;
          if d = 'head' then
            inHead := True
          else if d = 'body' then
            inHead := False
          else if d = 'template' then
            skip := skip + 1
          else if d = 'br' then
          begin
            if b.ByteLength > 0 then
            begin
              b.AddChar(#10);
              lf := lf + 1;
              pending := False;
            end;
          end
          else if (d = 'td') or (d = 'th') then
          begin
            if (lf = 0) and (b.ByteLength > 0) then
              b.AddChar(#9);
            pending := False;
          end
          else if IsParagraph(d) then
          begin
            LineBreak(True);
            if d = 'pre' then
            begin
              pre := pre + 1;
              dropLf := True;
            end;
          end
          else if IsBlock(d) then
            LineBreak(False)
          else if d = 'textarea' then
            dropLf := True;
        end;
      hkEndTag:
        begin
          d := tk.Name;
          if d = 'head' then
            inHead := False
          else if d = 'template' then
          begin
            if skip > 0 then
              skip := skip - 1;
          end
          else if IsParagraph(d) then
          begin
            if (d = 'pre') and (pre > 0) then
              pre := pre - 1;
            LineBreak(True);
          end
          else if IsBlock(d) then
            LineBreak(False);
        end;
    end;
  end;
  r := b.ToString;
  { no line break at the end }
  n := Length(r);
  while (n > 0) and ((r[n] = #10) or (r[n] = ' ') or (r[n] = #9)) do
    n := n - 1;
  Result := Copy(r, 1, n);
end;

end.
