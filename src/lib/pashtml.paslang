{ HTML as the HTML Standard of the WHATWG tokenizes it (P565): a tokenizer
  that gives start tags with their attributes decoded, end tags, text with
  its character references decoded, comments and the doctype, one at a
  time, with the elements whose content is raw text (script, style, xmp,
  iframe, noembed, noframes), escapable raw text (title, textarea) and
  plain text (plaintext) read as the standard says; the character
  references of the standard, all 2231 names (the 106 legacy ones without
  their semicolon too, matched by the longest prefix in text and left alone
  before = or a letter in an attribute, as 13.2.5.78 says), and the numeric
  ones with the replacements of 0x80 to 0x9F; HtmlEscape as Go's
  html.EscapeString; and HtmlToText, the text a reader shows: tags gone,
  the block elements and br as line breaks, a tab between cells, the
  contents of script, style, head and template dropped, white space
  collapsed outside pre. No tree is built: a program that wants a DOM reads
  the tokens itself. Free of state (Regla 11); a tokenizer belongs to the
  routine that reads it. }
unit pashtml;

interface

uses
  sysutils;

type
  THtmlKind = (hkText, hkStartTag, hkEndTag, hkComment, hkDoctype);

  THtmlAttr = record
    Name: string;
    Value: string;
  end;

  { The tokenizer. Create it on the text (its line ends are normalized as
    the standard's input stream is: CR LF and CR become LF), then Next until
    it says False; after each True the fields say what the token is. }
  THtmlTokenizer = class
  private
    FText: string;
    FPos: Integer;
    FRaw: Integer;
    FRawName: string;
    procedure SetText(const Value: string);
    procedure ReadAttributes(Keep: Boolean);
    function ReadTag: Boolean;
    function ReadMarkupDeclaration: Boolean;
    procedure BogusComment(From: Integer);
    function RawTextToken: Boolean;
    function TextRun: Boolean;
  public
    { what the last Next gave }
    Kind: THtmlKind;
    { the tag's name in lower case, or the doctype's; '' for text and comments }
    Name: string;
    { the text with its references decoded, the comment's data, or what
      follows the doctype's name }
    Data: string;
    { a start tag written <br/> }
    SelfClosing: Boolean;
    { the attributes in order, names in lower case, values decoded; a
      repeated name keeps its first value }
    Attrs: array of THtmlAttr;
    { the token's bytes in Source, from Start to Stop - 1 }
    Start, Stop: Integer;
    constructor Create(const AText: string);
    function Next: Boolean;
    function AttrCount: Integer;
    { the value of the attribute, '' when it is not there; HasAttr tells the two apart }
    function Attr(const AName: string): string;
    function HasAttr(const AName: string): Boolean;
    { the text as the tokenizer reads it, line ends normalized }
    property Source: string read FText;
  end;

{ The character references of S decoded as in text (13.2.5.72 to 13.2.5.80):
  a named reference with its semicolon, a legacy name without it by the
  longest match (&notit; is ¬it;), a numeric one in decimal or hex with or
  without the semicolon (0 and what is past U+10FFFF or a surrogate become
  U+FFFD, 0x80 to 0x9F the characters Windows-1252 has there); an ampersand
  that starts no reference stays. HtmlUnescapeAttr decodes as inside an
  attribute value: a legacy name without its semicolon is left alone when =
  or a letter or digit follows it, and there is no prefix match. }
function HtmlUnescape(const S: string): string;
function HtmlUnescapeAttr(const S: string): string;
{ & < > " ' written &amp; &lt; &gt; &#34; &#39;, as Go's html.EscapeString }
function HtmlEscape(const S: string): string;
{ The text a reader shows for the HTML S: the references decoded; br and the
  block elements (p, div, tr, li, headings, table, ul, ol, pre, blockquote,
  hr, address, section and the rest) as line breaks, a blank line around
  paragraphs, headings, tables and lists, never more than one; a tab between
  the cells of a row; the contents of script, style, head and template
  dropped; white space runs made one space and lines trimmed outside pre, a
  no-break space a space; the line feed that follows <pre> or <textarea>
  dropped. No line break at the start or the end. }
function HtmlToText(const S: string): string;
{ the input stream's normalization: CR LF and CR become LF }
function HtmlNormalizeNewlines(const S: string): string;

implementation

