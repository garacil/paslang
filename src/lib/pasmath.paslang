unit pasmath;

{ The real functions Sin, Cos, Exp, Ln, ArcTan, and (P539) Tan, Sinh, Cosh, Tanh, ArcSinh, ArcCosh,
  ArcTanh, LnXP1 and Power, a core unit (P538).

  They are Go's: math.Sin and math.Cos (sin.go, trig_reduce.go), math.Exp
  (exp.go), math.Log (log.go) and math.Atan (atan.go), written out in
  Pascal in the same order of operations, so that the results are the
  bits Go's pure code gives and are within one ulp of the correctly
  rounded value (Exp within one on the test sets of the manual; Go's own
  amd64 Exp, written in assembly, is within two). The argument comes in
  and the result goes out as the Double it is; the entry points of the
  runtime (rt_sin, rt_cos, rt_exp, rt_ln, rt_atan) check the domain and
  jump here.

  Sin and Cos reduce an argument below 2^29 by Pi/4 in three parts (the
  Cody and Waite reduction of Cephes) and a larger one by Payne and
  Hanek's, with the 1.2 kilobytes of 2/Pi that Go carries (MPi4). Exp
  and Ln are the FreeBSD kernels: an argument reduction by ln 2 in two
  parts, a polynomial in r*r. ArcTan is Cephes's rational function after
  the reduction of the argument to [0, tan(Pi/8)].

  P539 added Go's math.Tan (tan.go, after Cephes: the octant of the sine routines and a rational
  function of the square of the remainder), Sinh and Cosh (sinh.go: Hart and Cheney's rational
  function below 0.5, Exp above), Tanh (tanh.go, after Cephes), Asinh, Acosh and Atanh (asinh.go,
  acosh.go, atanh.go, FreeBSD's s_asinh.c, e_acosh.c and e_atanh.c), Log1p (log1p.go, s_log1p.c),
  which LnXP1 is, and Pow (pow.go), which Power is: the integer part of the exponent by squarings
  of the mantissa, the fraction by Exp(f * Log(x)). Where Go's function is its own code they give
  Go's bits (Tan, ArcSinh, ArcCosh, ArcTanh, LnXP1); the others call Exp, and Go's Exp on amd64 is
  assembly, so they are within a unit in the last place of Go's. The entries of the runtime keep
  the domain checks (an argument for which the function stops) and jump here.

  The notices that came with the sources:

  from Go's math package: Copyright 2009, 2011 The Go Authors. All rights
  reserved. Use of this source code is governed by a BSD-style license
  (the file LICENSE-GO).

  from FreeBSD's /usr/src/lib/msun/src/e_exp.c and e_log.c: Copyright (C)
  2004 (e_exp.c) and (C) 1993 (e_log.c) by Sun Microsystems, Inc. All
  rights reserved. Developed at SunPro, a Sun Microsystems, Inc. business.
  Permission to use, copy, modify, and distribute this software is freely
  granted, provided that this notice is preserved.

  from FreeBSD's /usr/src/lib/msun/src/s_asinh.c, e_acosh.c, e_atanh.c and s_log1p.c: Copyright
  (C) 1993 by Sun Microsystems, Inc. All rights reserved. Developed at SunPro, a Sun Microsystems,
  Inc. business. Permission to use, copy, modify, and distribute this software is freely granted,
  provided that this notice is preserved.

  from the Cephes Math Library Release 2.8: June, 2000. Copyright 1984,
  1987, 1989, 1992, 2000 by Stephen L. Moshier. What you see here may be
  used freely but it comes with no support or guarantee. }

interface

function PasSin(X: Double): Double;
function PasCos(X: Double): Double;
function PasSinBig(X: Double): Double;
function PasCosBig(X: Double): Double;
function PasExp(X: Double): Double;
function PasLn(X: Double): Double;
function PasAtan(X: Double): Double;
function PasTan(X: Double): Double;
function PasTanBig(X: Double): Double;
function PasSinh(X: Double): Double;
function PasCosh(X: Double): Double;
function PasTanh(X: Double): Double;
function PasAsinh(X: Double): Double;
function PasAcosh(X: Double): Double;
function PasAtanh(X: Double): Double;
function PasLog1p(X: Double): Double;
function PasPow(X, Y: Double): Double;

implementation

const
  { Pi/4 in three parts (Go's sin.go: PI4A, PI4B, PI4C) }
  Pi4A = 7.85398125648498535156e-1;
  Pi4B = 3.77489470793079817668e-8;
  Pi4C = 2.69515142907905952645e-15;
  ReduceThreshold = 536870912.0;
  FourOverPi = 1.2732395447351628;
  Pi4 = 0.78539816339744830961566084581987572104929234984378;

  { the coefficients of the sine and cosine kernels on [-Pi/4, Pi/4] (Go's sin.go, after Cephes) }
  S0 = 1.58962301576546568060e-10;
  S1 = -2.50507477628578072866e-8;
  S2 = 2.75573136213857245213e-6;
  S3 = -1.98412698295895385996e-4;
  S4 = 8.33333333332211858878e-3;
  S5 = -1.66666666666666307295e-1;
  C0 = -1.13585365213876817300e-11;
  C1 = 2.08757008419747316778e-9;
  C2 = -2.75573141792967388112e-7;
  C3 = 2.48015872888517045348e-5;
  C4 = -1.38888888888730564116e-3;
  C5 = 4.16666666666665929218e-2;

var
  MPi4: array[0..19] of Int64;
  MPi4Ready: Boolean;

procedure InitMPi4;
begin
  MPi4[0] := $0000000000000001;
  MPi4[1] := $45f306dc9c882a53;
  MPi4[2] := $f84eafa3ea69bb81;
  MPi4[3] := $b6c52b3278872083;
  MPi4[4] := $fca2c757bd778ac3;
  MPi4[5] := $6e48dc74849ba5c0;
  MPi4[6] := $0c925dd413a32439;
  MPi4[7] := $fc3bd63962534e7d;
  MPi4[8] := $d1046bea5d768909;
  MPi4[9] := $d338e04d68befc82;
  MPi4[10] := $7323ac7306a673e9;
  MPi4[11] := $3908bf177bf25076;
  MPi4[12] := $3ff12fffbc0b301f;
  MPi4[13] := $de5e2316b414da3e;
  MPi4[14] := $da6cfd9e4f96136e;
  MPi4[15] := $9e8c7ecd3cbfd45a;
  MPi4[16] := $ea4f758fd7cbe2f6;
  MPi4[17] := $7a0e73ef14a525d4;
  MPi4[18] := $d7f6bf623f1aba10;
  MPi4[19] := $ac06608df8f6d757;
  MPi4Ready := True;
end;

{ Payne and Hanek's reduction of a large argument (Go's trig_reduce.go): J is the octant
  and Z the remainder times Pi/4. }
procedure TrigReduce(X: Double; out J: Int64; out Z: Double);
var
  ix, ex, digit, bsh, z0, z1, z2, z2hi, z1hi, z1lo, z0lo, lo, hi, e: Int64;
  lz: Integer;
  c: Int64;
begin
  if not MPi4Ready then
    InitMPi4;
  if X < Pi4 then
  begin
    J := 0;
    Z := X;
    Exit;
  end;
  ix := X as Int64;
  ex := ((ix shr 52) and 2047) - 1023 - 52;
  ix := (ix and $000FFFFFFFFFFFFF) or $0010000000000000;
  digit := (ex + 61) div 64;
  bsh := (ex + 61) mod 64;
  if bsh = 0 then
  begin
    z0 := MPi4[digit];
    z1 := MPi4[digit + 1];
    z2 := MPi4[digit + 2];
  end
  else
  begin
    z0 := (MPi4[digit] shl bsh) or (MPi4[digit + 1] shr (64 - bsh));
    z1 := (MPi4[digit + 1] shl bsh) or (MPi4[digit + 2] shr (64 - bsh));
    z2 := (MPi4[digit + 2] shl bsh) or (MPi4[digit + 3] shr (64 - bsh));
  end;
  z2hi := MulHi(z2, ix);
  z1hi := MulHi(z1, ix);
  z1lo := z1 * ix;
  z0lo := z0 * ix;
  lo := AddCarry(z1lo, z2hi, 0, c);
  hi := AddCarry(z0lo, z1hi, c, c);
  J := hi shr 61;
  hi := (hi shl 3) or (lo shr 61);
  lz := LeadingZeros(hi);
  e := 1023 - (lz + 1);
  hi := (hi shl (lz + 1)) or (lo shr (64 - (lz + 1)));
  hi := hi shr 12;
  hi := hi or (e shl 52);
  Z := hi as Double;
  if (J and 1) = 1 then
  begin
    J := (J + 1) and 7;
    Z := Z - 1.0;
  end;
  Z := Z * Pi4;
end;

{ The sine of X, 0 <= |X| < 2^29 (a zero, a denormal or a number the reduction by Pi/4 in
  three parts takes): the runtime's rt_sin sends the other arguments, an infinity, a NaN
  and the large, to PasSinBig. No call: the routine is a leaf. }
function PasSin(X: Double): Double;
var
  j, sg: Int64;
  y, z, zz: Double;
begin
  sg := (X as Int64) and $8000000000000000;
  X := Abs(X);
  j := Trunc(X * FourOverPi);
  { an odd octant is mapped to the even one after it, so that the zero of the series is the origin
    (Go's j++ and y++); j is now even, and its bit 2 is the sign (the second half of the circle
    is the first with the sign turned), its bit 1 the choice of series }
  j := j + (j and 1);
  y := j;
  sg := sg xor ((j and 4) shl 61);
  z := ((X - y * Pi4A) - y * Pi4B) - y * Pi4C;
  zz := z * z;
  if (j and 2) <> 0 then
    y := 1.0 - 0.5 * zz + zz * zz * ((((((C0 * zz) + C1) * zz + C2) * zz + C3) * zz + C4) * zz + C5)
  else
    y := z + z * zz * ((((((S0 * zz) + S1) * zz + S2) * zz + S3) * zz + S4) * zz + S5);
  Result := ((y as Int64) xor sg) as Double;
end;

{ The cosine of X, 0 <= |X| < 2^29, as PasSin. }
function PasCos(X: Double): Double;
var
  j, sg: Int64;
  y, z, zz: Double;
begin
  X := Abs(X);
  j := Trunc(X * FourOverPi);
  j := j + (j and 1);
  y := j;
  { Go's two reflections, 4 to 7 and then 2 and 3, are the exclusive or of bits 1 and 2 of j }
  sg := (((j shr 1) xor (j shr 2)) and 1) shl 63;
  z := ((X - y * Pi4A) - y * Pi4B) - y * Pi4C;
  zz := z * z;
  if (j and 2) <> 0 then
    y := z + z * zz * ((((((S0 * zz) + S1) * zz + S2) * zz + S3) * zz + S4) * zz + S5)
  else
    y := 1.0 - 0.5 * zz + zz * zz * ((((((C0 * zz) + C1) * zz + C2) * zz + C3) * zz + C4) * zz + C5);
  Result := ((y as Int64) xor sg) as Double;
end;

{ Any argument: a NaN or an infinity has no sine, a small one is PasSin's, a large one
  is reduced by Payne and Hanek's method (TrigReduce). }
function PasSinBig(X: Double): Double;
var
  b, j, sg: Int64;
  y, z, zz: Double;
begin
  b := X as Int64;
  if ((b shr 52) and 2047) = 2047 then
  begin
    Result := $7FF8000000000000 as Double;
    Exit;
  end;
  if (b and $7FFFFFFFFFFFFFFF) < $41C0000000000000 then
  begin
    Result := PasSin(X);
    Exit;
  end;
  sg := b and $8000000000000000;
  TrigReduce((b and $7FFFFFFFFFFFFFFF) as Double, j, z);
  if j > 3 then
  begin
    sg := sg xor $8000000000000000;
    j := j - 4;
  end;
  zz := z * z;
  if (j = 1) or (j = 2) then
    y := 1.0 - 0.5 * zz + zz * zz * ((((((C0 * zz) + C1) * zz + C2) * zz + C3) * zz + C4) * zz + C5)
  else
    y := z + z * zz * ((((((S0 * zz) + S1) * zz + S2) * zz + S3) * zz + S4) * zz + S5);
  Result := ((y as Int64) xor sg) as Double;
end;

function PasCosBig(X: Double): Double;
var
  b, j, sg: Int64;
  y, z, zz: Double;
begin
  b := X as Int64;
  if ((b shr 52) and 2047) = 2047 then
  begin
    Result := $7FF8000000000000 as Double;
    Exit;
  end;
  if (b and $7FFFFFFFFFFFFFFF) < $41C0000000000000 then
  begin
    Result := PasCos(X);
    Exit;
  end;
  sg := 0;
  TrigReduce((b and $7FFFFFFFFFFFFFFF) as Double, j, z);
  if j > 3 then
  begin
    j := j - 4;
    sg := sg xor $8000000000000000;
  end;
  if j > 1 then
    sg := sg xor $8000000000000000;
  zz := z * z;
  if (j = 1) or (j = 2) then
    y := z + z * zz * ((((((S0 * zz) + S1) * zz + S2) * zz + S3) * zz + S4) * zz + S5)
  else
    y := 1.0 - 0.5 * zz + zz * zz * ((((((C0 * zz) + C1) * zz + C2) * zz + C3) * zz + C4) * zz + C5);
  Result := ((y as Int64) xor sg) as Double;
end;

{ Go's math.Exp, the FreeBSD e_exp.c (exp.go, expmulti); the scaling by 2^k (Go's Ldexp) is
  written out, so that the routine calls nothing. }
function PasExp(X: Double): Double;
const
  Ln2Hi = 6.93147180369123816490e-01;
  Ln2Lo = 1.90821492927058770002e-10;
  Log2e = 1.44269504088896338700e+00;
  Overflow = 7.09782712893383973096e+02;
  Underflow = -7.45133219101941108420e+02;
  NearZero = 3.7252902984619140625e-09;
  P1 = 1.66666666666666657415e-01;
  P2 = -2.77777777770155933842e-03;
  P3 = 6.61375632143793436117e-05;
  P4 = -1.65339022054652515390e-06;
  P5 = 4.13813679705723846039e-08;
var
  k, b, e: Int64;
  hi, lo, r, t, y: Double;
begin
  if X <> X then
  begin
    Result := X;
    Exit;
  end;
  if X > Overflow then
  begin
    Result := $7FF0000000000000 as Double;
    Exit;
  end;
  if X < Underflow then
  begin
    Result := 0.0;
    Exit;
  end;
  if (X > -NearZero) and (X < NearZero) then
  begin
    Result := 1.0 + X;
    Exit;
  end;
  if X < 0 then
    k := Trunc(Log2e * X - 0.5)
  else
    k := Trunc(Log2e * X + 0.5);
  hi := X - k * Ln2Hi;
  lo := k * Ln2Lo;
  r := hi - lo;
  t := r * r;
  { c of the original, in t }
  t := r - t * (P1 + t * (P2 + t * (P3 + t * (P4 + t * P5))));
  y := 1.0 - ((lo - (r * t) / (2.0 - t)) - hi);
  { Ldexp(y, k): y is between 0.5 and 2 }
  b := y as Int64;
  e := ((b shr 52) and 2047) - 1023 + k;
  if e < -1075 then
  begin
    Result := 0.0;
    Exit;
  end;
  if e > 1023 then
  begin
    Result := $7FF0000000000000 as Double;
    Exit;
  end;
  r := 1.0;
  if e < -1022 then
  begin
    e := e + 53;
    r := 1.1102230246251565404e-16;
  end;
  b := (b and $800FFFFFFFFFFFFF) or ((e + 1023) shl 52);
  Result := r * (b as Double);
end;

{ Go's math.Log, the FreeBSD e_log.c (log.go); X is positive (the caller's domain check) }
function PasLn(X: Double): Double;
const
  Ln2Hi = 6.93147180369123816490e-01;
  Ln2Lo = 1.90821492927058770002e-10;
  L1 = 6.666666666666735130e-01;
  L2 = 3.999999999940941908e-01;
  L3 = 2.857142874366239149e-01;
  L4 = 2.222219843214978396e-01;
  L5 = 1.818357216161805012e-01;
  L6 = 1.531383769920937332e-01;
  L7 = 1.479819860511658591e-01;
  HalfSqrt2 = 0.70710678118654752440;
var
  b, ki: Int64;
  f, s, s2, s4, t1, t2: Double;
begin
  b := X as Int64;
  if ((b shr 52) and 2047) = 2047 then
  begin
    Result := X;
    Exit;
  end;
  if X <= 0 then
  begin
    if X = 0 then
      Result := $FFF0000000000000 as Double
    else
      Result := $7FF8000000000000 as Double;
    Exit;
  end;
  ki := 0;
  if (b shr 52) = 0 then
  begin
    X := X * 4503599627370496.0;
    b := X as Int64;
    ki := -52;
  end;
  ki := ki + ((b shr 52) and 2047) - 1023 + 1;
  b := (b and $800FFFFFFFFFFFFF) or $3FE0000000000000;
  f := b as Double;
  if f < HalfSqrt2 then
  begin
    f := f * 2.0;
    ki := ki - 1;
  end;
  f := f - 1.0;
  s := f / (2.0 + f);
  s2 := s * s;
  s4 := s2 * s2;
  t1 := s2 * (L1 + s4 * (L3 + s4 * (L5 + s4 * L7)));
  t2 := s4 * (L2 + s4 * (L4 + s4 * L6));
  { Go's R in t1, hfsq in t2 and k in s2: a routine of eight Doubles keeps them all in registers }
  t1 := t1 + t2;
  t2 := 0.5 * f * f;
  s2 := ki;
  Result := s2 * Ln2Hi - ((t2 - (s * (t2 + t1) + s2 * Ln2Lo)) - f);
end;

{ Go's math.Atan (atan.go, after Cephes): the reduction of the argument to [0, tan(Pi/8)]
  and the rational function, in one routine that calls nothing }
function PasAtan(X: Double): Double;
const
  P0 = -8.750608600031904122785e-01;
  P1 = -1.615753718733365076637e+01;
  P2 = -7.500855792314704667340e+01;
  P3 = -1.228866684490136173410e+02;
  P4 = -6.485021904942025371773e+01;
  Q0 = 2.485846490142306297962e+01;
  Q1 = 1.650270098316988542046e+02;
  Q2 = 4.328810604912902668951e+02;
  Q3 = 4.853903996359136964868e+02;
  Q4 = 1.945506571482613964425e+02;
  Morebits = 6.123233995736765886130e-17;
  Tan3pio8 = 2.41421356237309504880;
  PiO2 = 1.57079632679489661923132169163975144209858469968755;
  PiO4 = 0.78539816339744830961566084581987572104929234984378;
var
  a, z, w: Double;
  mode: Integer;
begin
  if X = 0 then
  begin
    Result := X;
    Exit;
  end;
  a := Abs(X);
  if a <= 0.66 then
  begin
    w := a;
    mode := 0;
  end
  else if a > Tan3pio8 then
  begin
    w := 1.0 / a;
    mode := 1;
  end
  else
  begin
    w := (a - 1.0) / (a + 1.0);
    mode := 2;
  end;
  z := w * w;
  z := z * ((((P0 * z + P1) * z + P2) * z + P3) * z + P4) / (((((z + Q0) * z + Q1) * z + Q2) * z + Q3) * z + Q4);
  z := w * z + w;
  if mode = 1 then
    z := PiO2 - z + Morebits
  else if mode = 2 then
    z := PiO4 + z + 0.5 * Morebits;
  if X < 0 then
    Result := -z
  else
    Result := z;
end;

{ Go's math.Tan (tan.go, after Cephes): the octant and the remainder by Pi/4 in three parts, then a
  rational function of the remainder's square. For 0 <= |X| < 2^29 (a zero, a denormal or a number
  the reduction by Pi/4 in three parts takes), a leaf routine as PasSin is; the runtime's rt_tan
  sends the others, an infinity, a NaN and the large, to PasTanBig. }
function PasTan(X: Double): Double;
const
  TanP0 = -1.30936939181383777646e4;
  TanP1 = 1.15351664838587416140e6;
  TanP2 = -1.79565251976484877988e7;
  TanQ1 = 1.36812963470692954678e4;
  TanQ2 = -1.32089234440210967447e6;
  TanQ3 = 2.50083801823357915839e7;
  TanQ4 = -5.38695755929454629881e7;
var
  j, sg: Int64;
  y, z, zz: Double;
begin
  if X = 0 then
  begin
    Result := X;
    Exit;
  end;
  sg := (X as Int64) and $8000000000000000;
  X := Abs(X);
  j := Trunc(X * FourOverPi);
  y := j;
  if (j and 1) = 1 then
  begin
    j := j + 1;
    y := y + 1.0;
  end;
  z := ((X - y * Pi4A) - y * Pi4B) - y * Pi4C;
  zz := z * z;
  if zz > 1e-14 then
    y := z + z * (zz * (((TanP0 * zz) + TanP1) * zz + TanP2) / ((((zz + TanQ1) * zz + TanQ2) * zz + TanQ3) * zz + TanQ4))
  else
    y := z;
  if (j and 2) = 2 then
    y := -1.0 / y;
  Result := ((y as Int64) xor sg) as Double;
end;

{ The tangent of an infinity (a NaN), a NaN (itself) and a number from 2^29 up (Payne and Hanek's
  reduction), as Go's. }
function PasTanBig(X: Double): Double;
const
  TanP0 = -1.30936939181383777646e4;
  TanP1 = 1.15351664838587416140e6;
  TanP2 = -1.79565251976484877988e7;
  TanQ1 = 1.36812963470692954678e4;
  TanQ2 = -1.32089234440210967447e6;
  TanQ3 = 2.50083801823357915839e7;
  TanQ4 = -5.38695755929454629881e7;
var
  b, j, sg: Int64;
  y, z, zz: Double;
begin
  b := X as Int64;
  if ((b shr 52) and 2047) = 2047 then
  begin
    if X <> X then
      Result := X
    else
      Result := $7FF8000000000000 as Double;
    Exit;
  end;
  if (b and $7FFFFFFFFFFFFFFF) < $41C0000000000000 then
  begin
    Result := PasTan(X);
    Exit;
  end;
  sg := b and $8000000000000000;
  TrigReduce((b and $7FFFFFFFFFFFFFFF) as Double, j, z);
  zz := z * z;
  if zz > 1e-14 then
    y := z + z * (zz * (((TanP0 * zz) + TanP1) * zz + TanP2) / ((((zz + TanQ1) * zz + TanQ2) * zz + TanQ3) * zz + TanQ4))
  else
    y := z;
  if (j and 2) = 2 then
    y := -1.0 / y;
  Result := ((y as Int64) xor sg) as Double;
end;

{ Go's math.Sinh (sinh.go): Hart and Cheney's rational function below 0.5, Exp above. }
function PasSinh(X: Double): Double;
const
  P0 = -0.6307673640497716991184787251e+6;
  P1 = -0.8991272022039509355398013511e+5;
  P2 = -0.2894211355989563807284660366e+4;
  P3 = -0.2630563213397497062819489e+2;
  Q0 = -0.6307673640497716991212077277e+6;
  Q1 = 0.1521517378790019070696485176e+5;
  Q2 = -0.173678953558233699533450911e+3;
var
  neg: Boolean;
  temp, ex, sq: Double;
begin
  neg := False;
  if X < 0 then
  begin
    X := -X;
    neg := True;
  end;
  if X > 21 then
    temp := PasExp(X) * 0.5
  else if X > 0.5 then
  begin
    ex := PasExp(X);
    temp := (ex - 1 / ex) * 0.5;
  end
  else
  begin
    sq := X * X;
    temp := (((P3 * sq + P2) * sq + P1) * sq + P0) * X;
    temp := temp / (((sq + Q2) * sq + Q1) * sq + Q0);
  end;
  if neg then
    temp := -temp;
  Result := temp;
end;

{ Go's math.Cosh (sinh.go). }
function PasCosh(X: Double): Double;
var
  ex: Double;
begin
  X := Abs(X);
  if X > 21 then
    Result := PasExp(X) * 0.5
  else
  begin
    ex := PasExp(X);
    Result := (ex + 1 / ex) * 0.5;
  end;
end;

{ Go's math.Tanh (tanh.go, after Cephes). }
function PasTanh(X: Double): Double;
const
  TanhP0 = -9.64399179425052238628e-1;
  TanhP1 = -9.92877231001918586564e1;
  TanhP2 = -1.61468768441708447952e3;
  TanhQ0 = 1.12811678491632931402e2;
  TanhQ1 = 2.23548839060100448583e3;
  TanhQ2 = 4.84406305325125486048e3;
  MaxLog = 8.8029691931113054295988e+01;
var
  z, s: Double;
begin
  z := Abs(X);
  if z > 0.5 * MaxLog then
  begin
    if X < 0 then
      Result := -1.0
    else
      Result := 1.0;
    Exit;
  end;
  if z >= 0.625 then
  begin
    s := PasExp(2 * z);
    z := 1 - 2 / (s + 1);
    if X < 0 then
      z := -z;
  end
  else
  begin
    if X = 0 then
    begin
      Result := X;
      Exit;
    end;
    s := X * X;
    z := X + X * s * ((TanhP0 * s + TanhP1) * s + TanhP2) / (((s + TanhQ0) * s + TanhQ1) * s + TanhQ2);
  end;
  Result := z;
end;

{ Go's math.Log1p (log1p.go, FreeBSD's s_log1p.c): the logarithm of 1 + X without the sum, so that a
  small X keeps its digits. An argument below -1 and a NaN give a NaN, -1 gives -Inf. A routine of
  eight Doubles (X is the square of the quotient at the end, A the number of the exponent), so that
  all of them live in registers. }
function PasLog1p(X: Double): Double;
const
  Sqrt2M1 = 4.142135623730950488017e-01;
  Sqrt2HalfM1 = -2.928932188134524755992e-01;
  Small = 1.862645149230957031250e-09;
  Tiny = 5.551115123125782702118e-17;
  Two53 = 9007199254740992.0;
  Ln2Hi = 6.93147180369123816490e-01;
  Ln2Lo = 1.90821492927058770002e-10;
  Lp1 = 6.666666666666735130e-01;
  Lp2 = 3.999999999940941908e-01;
  Lp3 = 2.857142874366239149e-01;
  Lp4 = 2.222219843214978396e-01;
  Lp5 = 1.818357216161805012e-01;
  Lp6 = 1.531383769920937332e-01;
  Lp7 = 1.479819860511658591e-01;
var
  a, f, c, r, hfsq, ss: Double;
  iu, k: Int64;
begin
  if (X < -1) or (X <> X) then
  begin
    Result := $7FF8000000000000 as Double;
    Exit;
  end;
  if X = -1 then
  begin
    Result := $FFF0000000000000 as Double;
    Exit;
  end;
  if X > 1.7976931348623157e308 then
  begin
    Result := X;
    Exit;
  end;
  a := Abs(X);
  f := 0;
  iu := 0;
  k := 1;
  if a < Sqrt2M1 then
  begin
    if a < Small then
    begin
      if a < Tiny then
        Result := X
      else
        Result := X - X * X * 0.5;
      Exit;
    end;
    if X > Sqrt2HalfM1 then
    begin
      k := 0;
      f := X;
      iu := 1;
    end;
  end;
  c := 0;
  if k <> 0 then
  begin
    if a < Two53 then
    begin
      r := 1.0 + X;
      iu := r as Int64;
      k := (iu shr 52) - 1023;
      if k > 0 then
        c := 1.0 - (r - X)
      else
        c := X - (r - 1.0);
      c := c / r;
    end
    else
    begin
      r := X;
      iu := r as Int64;
      k := (iu shr 52) - 1023;
      c := 0;
    end;
    iu := iu and $000FFFFFFFFFFFFF;
    if iu < $0006A09E667F3BCD then
      r := (iu or $3FF0000000000000) as Double
    else
    begin
      k := k + 1;
      r := (iu or $3FE0000000000000) as Double;
      iu := ($0010000000000000 - iu) shr 2;
    end;
    f := r - 1.0;
  end;
  hfsq := 0.5 * f * f;
  a := k;
  if iu = 0 then
  begin
    if f = 0 then
    begin
      if k = 0 then
        Result := 0.0
      else
      begin
        c := c + a * Ln2Lo;
        Result := a * Ln2Hi + c;
      end;
      Exit;
    end;
    r := hfsq * (1.0 - 0.66666666666666666 * f);
    if k = 0 then
      Result := f - r
    else
      Result := a * Ln2Hi - ((r - (a * Ln2Lo + c)) - f);
    Exit;
  end;
  ss := f / (2.0 + f);
  X := ss * ss;
  r := X * (Lp1 + X * (Lp2 + X * (Lp3 + X * (Lp4 + X * (Lp5 + X * (Lp6 + X * Lp7))))));
  if k = 0 then
    Result := f - (hfsq - ss * (hfsq + r))
  else
    Result := a * Ln2Hi - ((hfsq - (ss * (hfsq + r) + (a * Ln2Lo + c))) - f);
end;

{ Go's math.Asinh (asinh.go, FreeBSD's s_asinh.c). }
function PasAsinh(X: Double): Double;
const
  Ln2 = 6.93147180559945286227e-01;
  NearZero = 3.7252902984619140625e-09;
  Large = 268435456.0;
var
  neg: Boolean;
  temp: Double;
begin
  if (X <> X) or (X > 1.7976931348623157e308) or (X < -1.7976931348623157e308) then
  begin
    Result := X;
    Exit;
  end;
  neg := False;
  if X < 0 then
  begin
    X := -X;
    neg := True;
  end;
  if X > Large then
    temp := PasLn(X) + Ln2
  else if X > 2 then
    temp := PasLn(2 * X + 1 / (Sqrt(X * X + 1) + X))
  else if X < NearZero then
    temp := X
  else
    temp := PasLog1p(X + X * X / (1 + Sqrt(1 + X * X)));
  if neg then
    temp := -temp;
  Result := temp;
end;

{ Go's math.Acosh (acosh.go). An argument below 1 and a NaN give a NaN. }
function PasAcosh(X: Double): Double;
const
  Ln2 = 6.93147180559945286227e-01;
  Large = 268435456.0;
var
  t: Double;
begin
  if (X < 1) or (X <> X) then
    Result := $7FF8000000000000 as Double
  else if X = 1 then
    Result := 0.0
  else if X >= Large then
    Result := PasLn(X) + Ln2
  else if X > 2 then
    Result := PasLn(2 * X - 1 / (X + Sqrt(X * X - 1)))
  else
  begin
    t := X - 1;
    Result := PasLog1p(t + Sqrt(2 * t + t * t));
  end;
end;

{ Go's math.Atanh (atanh.go). An argument outside [-1, 1] and a NaN give a NaN, 1 and -1 the
  infinities. }
function PasAtanh(X: Double): Double;
const
  NearZero = 3.7252902984619140625e-09;
var
  neg: Boolean;
  temp: Double;
begin
  if (X < -1) or (X > 1) or (X <> X) then
  begin
    Result := $7FF8000000000000 as Double;
    Exit;
  end;
  if X = 1 then
  begin
    Result := $7FF0000000000000 as Double;
    Exit;
  end;
  if X = -1 then
  begin
    Result := $FFF0000000000000 as Double;
    Exit;
  end;
  neg := False;
  if X < 0 then
  begin
    X := -X;
    neg := True;
  end;
  if X < NearZero then
    temp := X
  else if X < 0.5 then
  begin
    temp := X + X;
    temp := 0.5 * PasLog1p(temp + temp * X / (1 - X));
  end
  else
    temp := 0.5 * PasLog1p((X + X) / (1 - X));
  if neg then
    temp := -temp;
  Result := temp;
end;

{ Go's math.Frexp: F = Frac * 2^E with Frac in [0.5, 1), for a finite F other than zero. }
function PowFrexp(F: Double; out E: Int64): Double;
var
  b: Int64;
begin
  E := 0;
  if Abs(F) < 2.2250738585072014e-308 then
  begin
    F := F * 4503599627370496.0;
    E := -52;
  end;
  b := F as Int64;
  E := E + ((b shr 52) and 2047) - 1023 + 1;
  b := (b and $800FFFFFFFFFFFFF) or $3FE0000000000000;
  Result := b as Double;
end;

{ Go's math.Ldexp: Fr * 2^E, for a finite Fr. }
function PowLdexp(Fr: Double; E: Int64): Double;
var
  b: Int64;
  m: Double;
begin
  if (Fr = 0) or (Fr <> Fr) or (((Fr as Int64) shr 52) and 2047) = 2047 then
  begin
    Result := Fr;
    Exit;
  end;
  if Abs(Fr) < 2.2250738585072014e-308 then
  begin
    Fr := Fr * 4503599627370496.0;
    E := E - 52;
  end;
  b := Fr as Int64;
  E := E + ((b shr 52) and 2047) - 1023;
  if E < -1075 then
  begin
    Result := (b and $8000000000000000) as Double;
    Exit;
  end;
  if E > 1023 then
  begin
    Result := ((b and $8000000000000000) or $7FF0000000000000) as Double;
    Exit;
  end;
  m := 1.0;
  if E < -1022 then
  begin
    E := E + 53;
    m := 1.0 / 9007199254740992.0;
  end;
  b := (b and $800FFFFFFFFFFFFF) or ((E + 1023) shl 52);
  Result := m * (b as Double);
end;

{ Go's isOddInt (pow.go). }
function PowOddInt(X: Double): Boolean;
var
  n: Int64;
  t: Double;
begin
  if Abs(X) >= 9007199254740992.0 then
  begin
    Result := False;
    Exit;
  end;
  n := Trunc(X);
  t := n;
  Result := (X - t = 0) and ((n and 1) = 1);
end;

{ Go's pow for the arguments that are not a normal positive base and a finite exponent, or that are
  one of the special exponents 0, 1, 0.5 and -0.5 or a base of 1 (the switch of pow.go, then the
  rest of it written out for a zero, a denormal, a negative base and the large exponents). }
function PowSpecial(X, Y: Double): Double;
var
  ay, yi, yf, a1, x1: Double;
  i, n, ae, xe: Int64;
  yinf, xinf: Boolean;
begin
  yinf := (((Y as Int64) shr 52) and 2047) = 2047;
  xinf := (((X as Int64) shr 52) and 2047) = 2047;
  if (Y = 0) or (X = 1) then
  begin
    Result := 1.0;
    Exit;
  end;
  if Y = 1 then
  begin
    Result := X;
    Exit;
  end;
  if (X <> X) or (Y <> Y) then
  begin
    Result := $7FF8000000000000 as Double;
    Exit;
  end;
  if X = 0 then
  begin
    if Y < 0 then
    begin
      if ((X as Int64) < 0) and PowOddInt(Y) then
        Result := $FFF0000000000000 as Double
      else
        Result := $7FF0000000000000 as Double;
    end
    else
    begin
      if ((X as Int64) < 0) and PowOddInt(Y) then
        Result := X
      else
        Result := 0.0;
    end;
    Exit;
  end;
  if yinf then
  begin
    if X = -1 then
      Result := 1.0
    else if (Abs(X) < 1) = (Y > 0) then
      Result := 0.0
    else
      Result := $7FF0000000000000 as Double;
    Exit;
  end;
  if xinf then
  begin
    if X < 0 then
    begin
      Result := PasPow(1 / X, -Y);
      Exit;
    end;
    if Y < 0 then
      Result := 0.0
    else
      Result := $7FF0000000000000 as Double;
    Exit;
  end;
  if Y = 0.5 then
  begin
    Result := Sqrt(X);
    Exit;
  end;
  if Y = -0.5 then
  begin
    Result := 1 / Sqrt(X);
    Exit;
  end;
  ay := Abs(Y);
  if ay >= 9223372036854775808.0 then
  begin
    yi := ay;
    yf := 0;
  end
  else
  begin
    n := Trunc(ay);
    yi := n;
    yf := ay - yi;
  end;
  if (yf <> 0) and (X < 0) then
  begin
    Result := $7FF8000000000000 as Double;
    Exit;
  end;
  if yi >= 9223372036854775808.0 then
  begin
    if X = -1 then
      Result := 1.0
    else if (Abs(X) < 1) = (Y > 0) then
      Result := 0.0
    else
      Result := $7FF0000000000000 as Double;
    Exit;
  end;
  a1 := 1.0;
  ae := 0;
  if yf <> 0 then
  begin
    if yf > 0.5 then
    begin
      yf := yf - 1;
      yi := yi + 1;
    end;
    a1 := PasExp(yf * PasLn(X));
  end;
  x1 := PowFrexp(X, xe);
  i := Trunc(yi);
  while i <> 0 do
  begin
    if (xe < -4096) or (4096 < xe) then
    begin
      ae := ae + xe;
      Break;
    end;
    if (i and 1) = 1 then
    begin
      a1 := a1 * x1;
      ae := ae + xe;
    end;
    x1 := x1 * x1;
    xe := xe shl 1;
    if x1 < 0.5 then
    begin
      x1 := x1 + x1;
      xe := xe - 1;
    end;
    i := i shr 1;
  end;
  if Y < 0 then
  begin
    a1 := 1 / a1;
    ae := -ae;
  end;
  Result := PowLdexp(a1, ae);
end;

{ Go's math.Pow (pow.go): the special cases, then X to the integer part of Y by squarings of the
  mantissa (the powers of two gathered apart), and to the fraction by Exp(f * Log(X)). The scaling
  by 2^k at the end is Go's Ldexp, written out for a result in the normal range (PowLdexp does the
  rest), and the last squaring of the loop, which nothing reads, is not done. }
function PasPow(X, Y: Double): Double;
var
  bx, by, ba, i, n, ae, xe: Int64;
  ay, yi, yf, a1, x1: Double;
begin
  bx := X as Int64;
  by := Y as Int64;
  xe := (bx shr 52) and 2047;
  if (xe >= 1) and (xe < 2047) and (((by shr 52) and 2047) < 2047) and (bx > 0) and
    (Y <> 0) and (X <> 1) and (Y <> 1) and (Y <> 0.5) and (Y <> -0.5) then
  begin
    { a normal positive base and a finite exponent: the common case, no special value }
    ay := Abs(Y);
    if ay >= 9223372036854775808.0 then
    begin
      if (X < 1) = (Y > 0) then
        Result := 0.0
      else
        Result := $7FF0000000000000 as Double;
      Exit;
    end;
    n := Trunc(ay);
    yi := n;
    yf := ay - yi;
    a1 := 1.0;
    ae := 0;
    if yf <> 0 then
    begin
      if yf > 0.5 then
      begin
        yf := yf - 1;
        n := n + 1;
      end;
      a1 := PasExp(yf * PasLn(X));
    end;
    xe := xe - 1022;
    x1 := ((bx and $000FFFFFFFFFFFFF) or $3FE0000000000000) as Double;
    i := n;
    while i <> 0 do
    begin
      if (xe < -4096) or (4096 < xe) then
      begin
        ae := ae + xe;
        Break;
      end;
      if (i and 1) = 1 then
      begin
        a1 := a1 * x1;
        ae := ae + xe;
      end;
      i := i shr 1;
      if i = 0 then
        Break;
      x1 := x1 * x1;
      xe := xe shl 1;
      if x1 < 0.5 then
      begin
        x1 := x1 + x1;
        xe := xe - 1;
      end;
    end;
    if Y < 0 then
    begin
      a1 := 1 / a1;
      ae := -ae;
    end;
    ba := a1 as Int64;
    i := (ba shr 52) and 2047;
    n := i + ae;
    if (i >= 1) and (i < 2047) and (n > 0) and (n < 2047) then
      Result := ((ba and $800FFFFFFFFFFFFF) or (n shl 52)) as Double
    else
      Result := PowLdexp(a1, ae);
    Exit;
  end;
  Result := PowSpecial(X, Y);
end;

end.
