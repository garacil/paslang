          else
          begin
            args := nil;
            SetLength(args, 1);
            args[0] := ParseExpr;
            Eat(tkRParen);
            { of a value (1.0.136): an array's, a slice's or a string's
              bounds (a string's from 1, as its first index; Low gave 0),
              an ordinal's type's bounds (they gave whatever rdx held),
              nothing else (High of a map was garbage) }
            CheckTyped(args[0]);
            k := TypeOf(args[0]^.Typ).Kind;
            if (k = tykArray) or IsDynTyp(args[0]^.Typ) then
            begin
              if SameId(name, 'High') then
                Result := NewCall('rt_high', args, TyInteger)
              else
                Result := NewCall('rt_low', args, TyInteger);
            end
            else if IsStrTyp(args[0]^.Typ) then
            begin
              if SameId(name, 'High') then
                Result := NewCall('rt_high', args, TyInteger)
              else
                Result := NewInt(1);
            end
            else if (k = tykInteger) or (k = tykSubrange) or (k = tykEnum) or
              (k = tykBoolean) or (k = tykCurrency) or (args[0]^.Typ = TyChar) then
              Result := TypeBound(args[0]^.Typ, SameId(name, 'High'))
            else if k = tykTree then
            begin
              { the first and the last key of a tree (P110); an empty
                tree stops the program }
              SetLength(args, 3);
              args[1] := NewNil;
              if SameId(name, 'High') then
                args[2] := NewInt(1)
              else
                args[2] := NewInt(0);
              Result := NewCall('rt_treebound', args, TypeOf(args[0]^.Typ).Elem);
            end
            else if (k = tykHeap) and SameId(name, 'Low') then
              { the top of a heap, its least element, left in place }
              Result := NewCall('rt_heaplow', args, TypeOf(args[0]^.Typ).Elem)
            else
              Refuse(name + ' takes an array, a slice, a string, an ordinal or a tree, not ' +
                TypName(args[0]^.Typ) + PosOf(args[0]));
          end;
        end
        else if SameId(name, 'SizeOf') then
        begin
          Eat(tkLParen);
          { Integer, string and Boolean are keywords: SizeOf(Integer) was a
            syntax error (1.0.74). Integer(x) has the size of Integer. }
          if (FTok.Kind = tkInteger) or (FTok.Kind = tkStringKw) or
