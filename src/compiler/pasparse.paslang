        else if (Length(name) > 1) and ((name[1] = 'V') or (name[1] = 'v')) and
          (VecShape(ToLower(Copy(name, 2, Length(name) - 1))) <> ' ') and
          (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
          Result := VecCall(name, ParseArgList)
        else if (SameId(name, 'CpuHas') or SameId(name, 'CpuFeatures') or
          SameId(name, 'CycleCount') or SameId(name, 'CycleFreq')) and (not FindProc(name, pe)) then
          Result := CpuCall(name)
        else if SameId(name, 'CacheLine') and (not FindProc(name, pe)) then
        begin
          { the cache line of both machines, 64 bytes (1.0.123) }
          Result := NewInt(64);
          Result^.Flags := 1;
        end
        else if (SameId(name, 'AtomicSetBit') or SameId(name, 'AtomicClearBit')) and
          (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Refuse(name + ' takes 2 arguments' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := BitAtomic(name, args[0], args[1]);
        end
        else if SameId(name, 'Odd') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Odd takes 1 argument' + MethAt(nline, ncol));
          NoReal(args[0], 'Odd');
          Result := NewCall('rt_odd', args, TyBoolean);
        end
        else if SameId(name, 'IsNan') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('IsNan takes 1 argument' + MethAt(nline, ncol));
          Result := NewCall('rt_isnan', args, TyBoolean);
        end
        else if SameId(name, 'IsInfinite') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('IsInfinite takes 1 argument' + MethAt(nline, ncol));
          Result := NewCall('rt_isinf', args, TyBoolean);
        end
        else if (SameId(name, 'Min') or SameId(name, 'Max')) and
          (FTok.Kind = tkLParen) then
        begin
          mname := name;
          args := ParseArgList;
          if Length(args) <> 2 then
            Refuse(mname + ' takes 2 arguments');
          if (TypeOf(args[0]^.Typ).Kind = tykCurrency) or
            (TypeOf(args[1]^.Typ).Kind = tykCurrency) then
          begin
            if ((TypeOf(args[0]^.Typ).Kind = tykReal) and not UntypedReal(args[0])) or
              ((TypeOf(args[1]^.Typ).Kind = tykReal) and not UntypedReal(args[1])) or
              IsQuadTyp(args[0]^.Typ) or IsQuadTyp(args[1]^.Typ) then
              Refuse('mixed Currency arithmetic needs an explicit Currency(x) or Double(x)' + HerePos);
            if SameId(mname, 'Max') then name := 'PasCurrMax' else name := 'PasCurrMin';
            Result := CurrCall(name, CurrOf(args[0]), CurrOf(args[1]), TyCurrency);
          end
          else if IsQuadTyp(args[0]^.Typ) or IsQuadTyp(args[1]^.Typ) then
          begin
            if SameId(mname, 'Max') then
              Result := QCall('rtq_max', QuadOf(args[0]), QuadOf(args[1]), TyQuad)
            else
              Result := QCall('rtq_min', QuadOf(args[0]), QuadOf(args[1]), TyQuad);
          end
          else if (TypeOf(args[0]^.Typ).Kind = tykReal) or
            (TypeOf(args[1]^.Typ).Kind = tykReal) then
          begin
            if (TypeOf(args[0]^.Typ).Kind <> tykReal) or
              (TypeOf(args[1]^.Typ).Kind <> tykReal) then
              Refuse(mname + ' takes two integers or two reals');
            if RealJoin(args[0], args[1]) = TySingle then
            begin
              args[0] := RStamp(args[0], TySingle);
              args[1] := RStamp(args[1], TySingle);
              if SameId(mname, 'Max') then
                Result := NewCall('rt_maxsingle', args, TySingle)
              else
                Result := NewCall('rt_minsingle', args, TySingle);
            end
            else if SameId(mname, 'Max') then
              Result := NewCall('rt_maxreal', args, TyReal)
            else
              Result := NewCall('rt_minreal', args, TyReal);
          end
          else
          begin
            if SameId(mname, 'Max') then
              Result := NewCall('rt_maxint', args, TyInteger)
            else
              Result := NewCall('rt_minint', args, TyInteger);
          end;
        end
        else if SameId(name, 'Poly') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Refuse('Poly takes 2 arguments' + MethAt(nline, ncol));
          if (not IsDynTyp(args[1]^.Typ)) or
            (TypeOf(TypeOf(args[1]^.Typ).Elem).Kind <> tykReal) or
            (TypeOf(args[1]^.Typ).Elem = TySingle) then
            Refuse('Poly takes an array of Real' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := NewCall('rt_poly', args, TyReal);
        end
        else if SameId(name, 'Pi') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 0 then
            Refuse('Pi takes no arguments' + MethAt(nline, ncol));
          Result := NewPi;
        end
        else if (HashPieceAlg(name) >= 0) and (FTok.Kind = tkLParen) then
          Result := ParseHashPiece(name, nline, ncol)
        else if (HmacPieceAlg(name) >= 0) and (FTok.Kind = tkLParen) then
          Result := ParseHmacPiece(name, nline, ncol)
        else if (Sha3PieceBits(name) > 0) and (FTok.Kind = tkLParen) then
          Result := ParseSha3Piece(name, nline, ncol)
        else if (SameId(name, 'Hex') or SameId(name, 'Md5') or SameId(name, 'Sha1') or
          SameId(name, 'Sha224') or SameId(name, 'Sha256') or SameId(name, 'Sha384') or
          SameId(name, 'Sha512') or SameId(name, 'Fnv1a32') or SameId(name, 'Fnv1a64')) and
          (FTok.Kind = tkLParen) then
        begin
          { the hash words of one string (P111): a digest is the string
            of its bytes, Hex writes one out, the FNV words give an
            Integer }
          args := ParseArgList;
          if Length(args) = 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) <> 1) or (not IsStrTyp(args[0]^.Typ)) then
            Refuse(name + ' takes a string' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          if SameId(name, 'Fnv1a32') or SameId(name, 'Fnv1a64') then
            Result := CoreProc('Pas' + name, args, TyInteger)
          else if SameId(name, 'Sha1') then
            Result := CoreProc('PasSha1' + ShaSuffix('sha1'), args, TyString)
          else if SameId(name, 'Sha224') or SameId(name, 'Sha256') then
            Result := CoreProc('Pas' + name + ShaSuffix('sha2'), args, TyString)
          else if SameId(name, 'Sha384') or SameId(name, 'Sha512') then
            Result := CoreProc('Pas' + name + CpuSuffix('sha512'), args, TyString)
          else
            Result := CoreProc('Pas' + name, args, TyString);
        end
        else if (SameId(name, 'Sha3_224') or SameId(name, 'Sha3_256') or
          SameId(name, 'Sha3_384') or SameId(name, 'Sha3_512')) and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) <> 1) or (not IsStrTyp(args[0]^.Typ)) then
            Refuse(name + ' takes a string' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          SetLength(args, 2);
          if SameId(name, 'Sha3_224') then
            args[1] := NewInt(224)
          else if SameId(name, 'Sha3_256') then
            args[1] := NewInt(256)
          else if SameId(name, 'Sha3_384') then
            args[1] := NewInt(384)
          else
            args[1] := NewInt(512);
          Result := CoreProc('PasSha3', args, TyString);
        end
        else if (SameId(name, 'HmacMd5') or SameId(name, 'HmacSha1') or
          SameId(name, 'HmacSha224') or SameId(name, 'HmacSha256') or
          SameId(name, 'HmacSha384') or SameId(name, 'HmacSha512')) and (FTok.Kind = tkLParen) then
        begin
          { HmacSha256(key, msg) and its kin (RFC 2104) }
          args := ParseArgList;
          if Length(args) = 2 then
          begin
            args[0] := StrArg(TyString, args[0]);
            args[1] := StrArg(TyString, args[1]);
          end;
          if (Length(args) <> 2) or (not IsStrTyp(args[0]^.Typ)) or
            (not IsStrTyp(args[1]^.Typ)) then
            Refuse(name + ' takes a key and a message, both strings' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          SetLength(args, 3);
          args[2] := args[1];
          args[1] := args[0];
          if SameId(name, 'HmacMd5') then
          begin
            args[0] := NewInt(0);
            Result := CoreProc('PasHmacBase', args, TyString);
          end
          else if SameId(name, 'HmacSha1') then
          begin
            args[0] := NewInt(1);
            Result := CoreProc('PasHmac' + ShaSuffix('sha1'), args, TyString);
          end
          else if SameId(name, 'HmacSha224') or SameId(name, 'HmacSha256') then
          begin
            if SameId(name, 'HmacSha224') then
              args[0] := NewInt(2)
            else
              args[0] := NewInt(3);
            Result := CoreProc('PasHmac' + ShaSuffix('sha2'), args, TyString);
          end
          else
          begin
            if SameId(name, 'HmacSha384') then
              args[0] := NewInt(4)
            else
              args[0] := NewInt(5);
            Result := CoreProc('PasHmac' + CpuSuffix('sha512'), args, TyString);
          end;
        end
        else if (SameId(name, 'Crc32') or SameId(name, 'Crc32c') or SameId(name, 'Adler32') or
          SameId(name, 'Murmur3')) and (FTok.Kind = tkLParen) then
        begin
          { Crc32(s), Crc32(s, crc) to go on from a value, Adler32 the
            same from 1, Murmur3(s, seed) }
          args := ParseArgList;
          if Length(args) >= 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) < 1) or (Length(args) > 2) or (not IsStrTyp(args[0]^.Typ)) then
            Refuse(name + ' takes a string and, to go on from one, the value so far' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          if Length(args) = 2 then
          begin
            NoReal(args[1], 'Integer');
            args[1] := ValArg(TyInteger, args[1]);
          end
          else
          begin
            SetLength(args, 2);
            if SameId(name, 'Adler32') then
              args[1] := NewInt(1)
            else
              args[1] := NewInt(0);
          end;
          if SameId(name, 'Crc32') then
          begin
            if FArm then
              Result := CoreProc('PasCrc32' + CpuSuffix('crc32'), args, TyInteger)
            else
              Result := CoreProc('PasCrc32' + CpuSuffix('pclmul sse41'), args, TyInteger);
          end
          else if SameId(name, 'Crc32c') then
          begin
            if FArm then
              Result := CoreProc('PasCrc32c' + CpuSuffix('crc32'), args, TyInteger)
            else
              Result := CoreProc('PasCrc32c' + CpuSuffix('sse42'), args, TyInteger);
          end
          else
            Result := CoreProc('Pas' + name, args, TyInteger);
        end
        else if SameId(name, 'SipHash') and (FTok.Kind = tkLParen) then
        begin
          { SipHash(s, k0, k1): SipHash-2-4 under a 128-bit key }
          args := ParseArgList;
          if Length(args) >= 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) <> 3) or (not IsStrTyp(args[0]^.Typ)) then
            Refuse('SipHash takes a string and the two words of its key' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          NoReal(args[1], 'Integer');
          NoReal(args[2], 'Integer');
          args[1] := ValArg(TyInteger, args[1]);
          args[2] := ValArg(TyInteger, args[2]);
          Result := CoreProc('PasSipHash', args, TyInteger);
        end
        else if SameId(name, 'MerkleRoot') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('MerkleRoot takes the leaves' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckLeaves(args[0], 'MerkleRoot');
          Result := CoreProc('PasMerkleRoot' + ShaSuffix('sha2'), args, TyString);
        end
        else if SameId(name, 'MerkleProof') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Refuse('MerkleProof takes the leaves and an index' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckLeaves(args[0], 'MerkleProof');
          NoReal(args[1], 'Integer');
          Result := CoreProc('PasMerkleProof' + ShaSuffix('sha2'), args, TyString);
        end
        else if SameId(name, 'MerkleCheck') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 5 then
          begin
            args[0] := StrArg(TyString, args[0]);
            args[3] := StrArg(TyString, args[3]);
            args[4] := StrArg(TyString, args[4]);
          end;
          if (Length(args) <> 5) or (not IsStrTyp(args[0]^.Typ)) or
            (not IsStrTyp(args[3]^.Typ)) or (not IsStrTyp(args[4]^.Typ)) then
            Refuse('MerkleCheck takes a leaf, its index, the count, the proof and the root' +
              ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          NoReal(args[1], 'Integer');
          NoReal(args[2], 'Integer');
          Result := CoreProc('PasMerkleCheck' + ShaSuffix('sha2'), args, TyBoolean);
        end
        else if SameId(name, 'Rank') and (FTok.Kind = tkLParen) then
        begin
          { Rank(t, k): how many keys of t are below k }
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Refuse('Rank takes a tree and a key' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          args[1] := MapKeyArg(args[0], args[1]);
          Result := NewCall('rt_treerank', args, TyInteger);
        end
        else if SameId(name, 'KeyAt') and (FTok.Kind = tkLParen) then
        begin
          { KeyAt(t, i): the key at rank i, the first at 0 }
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Refuse('KeyAt takes a tree and an index' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          NoReal(args[1], 'Integer');
          args[1] := ValArg(TyInteger, args[1]);
          Result := NewCall('rt_treekeyat', args, TypeOf(args[0]^.Typ).Elem);
        end
        else if SameId(name, 'Split') and (FTok.Kind = tkLParen) then
        begin
          { Split(t, k): the keys from k up go into a new tree }
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Refuse('Split takes a tree and a key' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          args[1] := MapKeyArg(args[0], args[1]);
          Result := NewCall('rt_treesplit', args, args[0]^.Typ);
        end
        else if SameId(name, 'Join') and (FTok.Kind = tkLParen) then
        begin
          { Join(a, b): every entry of b goes into a and b is left empty }
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) or
            (not ((args[1]^.Typ = args[0]^.Typ) or SameTyp(args[1]^.Typ, args[0]^.Typ))) then
            Refuse('Join takes two trees of one type' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := NewCall('rt_treejoin', args, TyNone);
        end
        else if (SameId(name, 'Include') or SameId(name, 'Exclude')) and
          (FTok.Kind = tkLParen) then
        begin
          { Include(t, k) puts k into a tree, Exclude(t, k) takes it out
            (P110); Include(s, x) and Exclude(s, x) set and clear x's bit
            of the set variable s (P126), x in s's range }
          args := ParseArgList;
          if (Length(args) = 2) and IsSetTyp(args[0]^.Typ) then
          begin
            CheckOutVar(args[0], args[0]^.Typ, name + '(s, x): s');
            e := args[1];
            SetElemFits(e, args[0]^.Typ);
            args[1] := e;
            args[0] := NewAddr(MapPutPlace(args[0]));
            args[0]^.Flags := args[0]^.Flags or 16;
            SetLength(args, 3);
            args[2] := NewInt(Ord(SameId(name, 'Include')));
            Result := NewCall('rt_setincl', args, TyNone);
          end
          else
          begin
            if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) then
              Refuse(name + ' takes a tree and a key, or a set and an element' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
            args[1] := MapKeyArg(args[0], args[1]);
            if SameId(name, 'Include') then
              Result := NewCall('rt_treeadd', args, TyNone)
            else
              Result := NewCall('rt_treedel', args, TyBoolean);
          end;
        end
        else if (SameId(name, 'PopLow') or SameId(name, 'PopHigh')) and
          (FTok.Kind = tkLParen) then
        begin
          { PopLow(t, k) and PopLow(t, k, v) take the least key out of t,
            into k and v, and say whether there was one; PopHigh the
            greatest }
          args := ParseArgList;
          if (Length(args) < 2) or (Length(args) > 3) or
            (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Refuse(name + ' takes a tree, a key variable and, of a tree with values, a value variable' +
              ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckOutVar(args[1], TypeOf(args[0]^.Typ).Elem, name + '(t, k): k');
          if Length(args) = 3 then
          begin
            if TypeOf(args[0]^.Typ).Elem2 < 0 then
              Refuse(name + ' of a tree of K takes the key alone' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
            CheckOutVar(args[2], TypeOf(args[0]^.Typ).Elem2, name + '(t, k, v): v');
            args[2] := NewAddr(MapPutPlace(args[2]));
          end
          else
          begin
            SetLength(args, 3);
            args[2] := NewNil;
          end;
          args[1] := NewAddr(MapPutPlace(args[1]));
          SetLength(args, 4);
          if SameId(name, 'PopHigh') then
            args[3] := NewInt(1)
          else
            args[3] := NewInt(0);
          Result := NewCall('rt_treepop', args, TyBoolean);
        end
        else if SameId(name, 'Push') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykHeap) then
            Refuse('Push takes a heap and a value' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          args[1] := MapKeyArg(args[0], args[1]);
          Result := NewCall('rt_heappush', args, TyNone);
        end
        else if SameId(name, 'Pop') and (FTok.Kind = tkLParen) then
        begin
          { Pop(h, v) takes the least element into v and says whether
            there was one; Pop(h) gives it, and an empty heap stops the
            program }
          args := ParseArgList;
          if (Length(args) < 1) or (Length(args) > 2) or
            (TypeOf(args[0]^.Typ).Kind <> tykHeap) then
            Refuse('Pop takes a heap, and a variable for the element' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          if Length(args) = 2 then
          begin
            CheckOutVar(args[1], TypeOf(args[0]^.Typ).Elem, 'Pop(h, v): v');
            args[1] := NewAddr(MapPutPlace(args[1]));
            Result := NewCall('rt_heappop', args, TyBoolean);
          end
          else
            Result := NewCall('rt_heappop1', args, TypeOf(args[0]^.Typ).Elem);
        end
        else if SameId(name, 'StoreOpen') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) <> 1) or (not IsStrTyp(args[0]^.Typ)) then
            Refuse('StoreOpen takes a path' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := CoreProc('PasStoreOpen', args, InternStore);
        end
        else if SameId(name, 'StorePut') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 3 then
          begin
            args[1] := StrArg(TyString, args[1]);
            args[2] := StrArg(TyString, args[2]);
          end;
          if (Length(args) <> 3) or (TypeOf(args[0]^.Typ).Kind <> tykStore) or
            (not IsStrTyp(args[1]^.Typ)) or (not IsStrTyp(args[2]^.Typ)) then
            Refuse('StorePut takes a store, a key and a value, both strings' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := CoreProc('PasStorePut', args, TyNone);
        end
        else if SameId(name, 'StoreGet') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 2 then
            args[1] := StrArg(TyString, args[1]);
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykStore) or
            (not IsStrTyp(args[1]^.Typ)) then
            Refuse('StoreGet takes a store and a key' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := CoreProc('PasStoreGet', args, TyString);
        end
        else if SameId(name, 'StoreDelete') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 2 then
            args[1] := StrArg(TyString, args[1]);
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykStore) or
            (not IsStrTyp(args[1]^.Typ)) then
            Refuse('StoreDelete takes a store and a key' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := CoreProc('PasStoreDelete', args, TyNone);
        end
        else if (SameId(name, 'StoreSync') or SameId(name, 'StoreClose') or
          SameId(name, 'StoreAbandon')) and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) <> 1) or (TypeOf(args[0]^.Typ).Kind <> tykStore) then
            Refuse(name + ' takes a store' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := CoreProc('Pas' + name, args, TyNone);
        end
        else if (SameId(name, 'XxHash32') or SameId(name, 'XxHash64') or
          SameId(name, 'XxHash3')) and (FTok.Kind = tkLParen) then
        begin
          mname := name;
          args := ParseArgList;
          if (Length(args) < 1) or (Length(args) > 2) then
            Refuse(mname + ' takes 1 or 2 arguments');
          if not IsStrTyp(args[0]^.Typ) then
            Refuse(mname + ' hashes a string');
          if Length(args) = 2 then
          begin
            if TypeOf(args[1]^.Typ).Kind = tykReal then
              Refuse(mname + ' seed is an Integer');
          end
          else
          begin
            SetLength(args, 2);
            args[1] := NewInt(0);
          end;
          if SameId(mname, 'XxHash64') then
            Result := NewCall('rt_xxh64', args, TyInteger)
          else if SameId(mname, 'XxHash3') then
            Result := NewCall('rt_xxh3', args, TyInteger)
          else
            Result := NewCall('rt_xxh32', args, TyInteger);
        end
        else if SameId(name, 'Clear') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) = 1) and (TypeOf(args[0]^.Typ).Kind = tykMap) then
            Result := NewCall('rt_mapclear', args, TyNone)
          else if (Length(args) = 1) and (TypeOf(args[0]^.Typ).Kind = tykTree) then
            Result := NewCall('rt_treeclear', args, TyNone)
          else if FindProc(name, pe) then
          begin
            FCallAt := ' at ' + IntToStr(nline) + ':' + IntToStr(ncol);
            if not ResolveProc(name, args, pe) then
              Refuse('wrong number of arguments for ' + name + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
            FillDefaults(pe, args);
            Result := NewCall(pe.Sym, args, pe.RetTyp);
          end
          else
            Refuse('Clear takes a map' + MethAt(nline, ncol));
        end
        else if SameId(name, 'Delete') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) = 2) and (TypeOf(args[0]^.Typ).Kind = tykMap) then
          begin
            args[1] := MapKeyArg(args[0], args[1]);
            Result := NewCall('rt_mapdel', args, TyBoolean);
          end
          else if (Length(args) = 2) and (TypeOf(args[0]^.Typ).Kind = tykTree) then
          begin
            args[1] := MapKeyArg(args[0], args[1]);
            Result := NewCall('rt_treedel', args, TyBoolean);
          end
          else if (Length(args) = 3) and IsDynTyp(args[0]^.Typ) then
          begin
            { Delete(a, i, n) of a slice (P136): the statement makes it }
            CheckOutVar(args[0], args[0]^.Typ, 'Delete(a, i, n): a');
            args[1] := ValArg(TyInteger, args[1]);
            args[2] := ValArg(TyInteger, args[2]);
            Result := NewCall('rt_slicedel', args, TyNone);
          end
          else if (Length(args) = 3) and IsStrTyp(args[0]^.Typ) then
          begin
            { Delete(s, i, n) of a string (P134) }
            CheckOutVar(args[0], args[0]^.Typ, 'Delete(s, i, n): s');
            args[1] := ValArg(TyInteger, args[1]);
            args[2] := ValArg(TyInteger, args[2]);
            Result := CoreProc('PasDeleteStr', args, TyNone);
          end
          else
            Refuse('Delete takes a map and a key, or a string variable, an index and a count' +
              ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
        end
        else if (SameId(name, 'JsonRead') or SameId(name, 'TryJsonRead') or
          SameId(name, 'JsonWrite')) and (FTok.Kind = tkLParen) and
          FindProc('PasJsonReadBegin', pe) then
        begin
          { JsonRead(r, x), TryJsonRead(r, x, err) and JsonWrite(w, x):
            of a json pasjson's, of any other x the functions the
            compiler writes for its type (P208) }
          args := ParseArgList;
          Result := JsonStreamCall(name, args, nline, ncol);
        end
        else if SameId(name, 'JsonParse') and (FTok.Kind = tkLParen) and not FGenMode and
          FindProc('JsonParse', pe) then
        begin
          { JsonParse('...') of a constant text (P209): parsed now, an
            error stopping the compile at its place, and made once when
            the unit starts; with options, or of a text that varies, the
            call }
          args := ParseArgList;
          if (Length(args) = 1) and (args[0]^.Kind = ekStr) then
            Result := JsonConstRef(args[0]^.Txt, args[0]^.PosLine, args[0]^.PosCol)
          else
          begin
            FCallAt := ' at ' + IntToStr(nline) + ':' + IntToStr(ncol);
            if not ResolveProc(name, args, pe) then
              Refuse('wrong arguments for ' + name + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
            FillDefaults(pe, args);
            Result := NewCall(pe.Sym, args, pe.RetTyp);
          end;
        end
        else if (SameId(name, 'JsonDecode') or SameId(name, 'TryJsonDecode')) and
          (FTok.Kind = tkLParen) and FindProc('JsonParse', pe) then
        begin
          { JsonDecode(src, x[, opts]) and TryJsonDecode(src, x, err[,
            opts]): the functions the compiler writes for x's type (P206) }
          args := ParseArgList;
          Result := JsonDecodeCall(SameId(name, 'TryJsonDecode'), args);
        end
        else if (SameId(name, 'JsonObject') or SameId(name, 'JsonArray')) and
          (FTok.Kind = tkLParen) and FindProc('PasJsonOfConsts', pe) then
        begin
          { JsonObject([name, value, ...]) and JsonArray([value, ...])
            (P207): the list an array of const, built as any call builds
            it, for pasjson's PasJsonOfConsts }
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse(name + ' takes a list in brackets or an array of const' + ' at ' + IntToStr(nline) +
              ':' + IntToStr(ncol));
          Result := JsonListCall(SameId(name, 'JsonObject'), args[0], pe, nline, ncol);
        end
        else if (SameId(name, 'JsonEncode') or SameId(name, 'JsonOf')) and
          (FTok.Kind = tkLParen) and FindProc('JsonParse', pe) then
        begin
          { JsonEncode(j) of a json is pasjson's; of any other value, and
            JsonOf, the functions the compiler writes for its type (P205) }
          args := ParseArgList;
          if (Length(args) < 1) or (Length(args) > 2) or
            (SameId(name, 'JsonOf') and (Length(args) <> 1)) then
            Refuse(name + ' takes a value' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckTyped(args[0]);
          { a list in brackets that is no set has no type to be written
            as: [a, b] of strings is a slice only where one goes (P474) }
          if (args[0]^.Kind = ekSet) and ((args[0]^.Flags and 64) <> 0) then
            Refuse(name + ' takes a value with a JSON form, and a list in brackets of what no set holds ' +
              'has no type of its own: write it into a variable of an array type, or make the json of ' +
              'it with JsonArray([...]) at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          if (args[0]^.Kind = ekNil) or (TypeOf(args[0]^.Typ).Kind = tykJson) then
          begin
            if SameId(name, 'JsonOf') then
            begin
              if args[0]^.Kind = ekNil then
                args[0]^.Typ := InternJson;
              Result := args[0];
            end
            else
            begin
              FCallAt := ' at ' + IntToStr(nline) + ':' + IntToStr(ncol);
              if not FindProc(name, pe) or not ResolveProc(name, args, pe) then
                Refuse('wrong arguments for ' + name + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
              FillDefaults(pe, args);
              Result := NewCall(pe.Sym, args, pe.RetTyp);
            end;
          end
          else
          begin
            if Length(args) = 2 then
            begin
              if not NamedType('TJsonOptions', t2) then
                Refuse('JsonEncode needs pasjson' + HerePos);
              args[1] := ValArg(t2, args[1]);
            end;
            if SameId(name, 'JsonOf') then
              Result := JsonTypedCall(2, args)
            else
              Result := JsonTypedCall(1, args);
          end;
        end
        else if SameId(name, 'TryGet') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 3 then
            Refuse('TryGet takes 3 arguments' + MethAt(nline, ncol));
          CheckTyped(args[0]);
          if TypeOf(args[0]^.Typ).Kind = tykJson then
          begin
            { TryGet(j, 'k', v) and TryGet(j, i, v) (P203): whether j has
              that member or element, into v; never an error }
            CheckTyped(args[1]);
            CheckTyped(args[2]);
            if TypeOf(args[2]^.Typ).Kind <> tykJson then
              { a typed v (P206): the member or the element decoded into it }
              Result := JsonTypedGet(args)
            else
            begin
              CheckOutVar(args[2], InternJson, 'TryGet(j, k, v): v');
              if IsStrTyp(args[1]^.Typ) or IsCharT(args[1]^.Typ) then
              begin
                args[1] := StrArg(TyString, args[1]);
                Result := CoreProc('PasJsonTryGet', args, TyBoolean);
              end
              else if (TypeOf(args[1]^.Typ).Kind = tykInteger) or
                (TypeOf(args[1]^.Typ).Kind = tykSubrange) then
              begin
                args[1] := ValArg(TyInteger, args[1]);
                Result := CoreProc('PasJsonTryItem', args, TyBoolean);
              end
              else
                Refuse('TryGet of a json takes a name, a string, or a place, an Integer' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
            end;
          end
          else
          begin
          if (TypeOf(args[0]^.Typ).Kind <> tykMap) and
            (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Refuse('TryGet takes a map' + MethAt(nline, ncol));
          if (TypeOf(args[0]^.Typ).Kind = tykTree) and (TypeOf(args[0]^.Typ).Elem2 < 0) then
            Refuse('TryGet needs a tree with values: k in t says whether k is there' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          args[1] := MapKeyArg(args[0], args[1]);
          CheckTryGetVar(args[0], args[2]);
          args[2] := NewAddr(MapPutPlace(args[2]));
          if TypeOf(args[0]^.Typ).Kind = tykTree then
            Result := NewCall('rt_treetry', args, TyBoolean)
          else
            Result := NewCall('rt_maptry', args, TyBoolean);
          end;
        end
        else if SameId(name, 'Copy') then
        begin
          { Copy(s, i, n), and Copy(s, i) to the end (P134) }
          args := ParseArgList;
          if (Length(args) < 2) or (Length(args) > 3) then
            Refuse('Copy takes a string, an index and a count, or a string and an index' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckTyped(args[0]);
          if Length(args) = 2 then
          begin
            SetLength(args, 3);
            args[2] := NewInt(High(Int64));
          end;
          args[1] := ValArg(TyInteger, args[1]);
          args[2] := ValArg(TyInteger, args[2]);
          if IsDynTyp(args[0]^.Typ) then
          begin
            { Copy(a, i, n) and Copy(a, i) of a slice (P136): a new one
              of the elements from a[i], Free Pascal's clamps; the cut is
              a view, appended to nil }
            e := NewNil;
            e^.Typ := args[0]^.Typ;
            e2 := NewCall('rt_slicecut', args, args[0]^.Typ);
            args := nil;
            SetLength(args, 2);
            args[0] := e;
            args[1] := e2;
            Result := NewCall('rt_appendslice', args, e^.Typ);
          end
          else
          begin
            if not (IsStrTyp(args[0]^.Typ) or IsCharT(args[0]^.Typ) or (args[0]^.Kind = ekStr)) then
              Refuse('Copy takes a string or a slice, not ' + TypName(args[0]^.Typ) + PosOf(args[0]));
            args[0] := AsStr(args[0]);
            Result := NewCall('rt_copy', args, TyString);
          end;
        end
        else if SameId(name, 'Pos') and (FTok.Kind = tkLParen) then
        begin
          { Pos(sub, s[, from]) (P134): the place from 1 of sub in s, 0
            when it is not there; a Char's search is IndexByte's }
          args := ParseArgList;
          if (Length(args) < 2) or (Length(args) > 3) then
            Refuse('Pos takes what to find, a string, and where to start' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckTyped(args[0]);
          if Length(args) = 2 then
          begin
            SetLength(args, 3);
            args[2] := NewInt(1);
          end;
          args[1] := AsStr(args[1]);
          args[2] := ValArg(TyInteger, args[2]);
          if IsCharT(args[0]^.Typ) or ((args[0]^.Kind = ekStr) and (Length(args[0]^.Txt) = 1)) then
          begin
            args[0] := AsChar(StrArg(TyChar, args[0]));
            Result := CoreProc('PasPosChar' + CpuSuffix('avx2'), args, TyInteger);
          end
          else
          begin
            args[0] := AsStr(args[0]);
            Result := CoreProc('PasPos' + CpuSuffix('avx2'), args, TyInteger);
          end;
        end
        else if (SameId(name, 'CompareByte') or SameId(name, 'IndexByte')) and
          (FTok.Kind = tkLParen) then
        begin
          { Free Pascal's memory words (P147): CompareByte(a, b, n), the
            difference of the first bytes of a and b that differ, 0 when
            their n bytes are equal; IndexByte(buf, n, b), the place from
            0 of byte b among buf's first n, -1 when it is not there. a, b
            and buf are variables read where they are, as Move's; a count
            not above 0 reads nothing. Each on the -cpu's kernel, at most
            64 KiB a call (passtr's PasCompareByte and PasFindByte, P270). }
          args := ParseArgList;
          if Length(args) <> 3 then
            Refuse(name + ' takes three arguments' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          args[0] := NewAddr(args[0]);
          args[0]^.Num := 1;
          args[0]^.Typ := TyPointer;
          if SameId(name, 'CompareByte') then
          begin
            args[1] := NewAddr(args[1]);
            args[1]^.Num := 1;
            args[1]^.Typ := TyPointer;
            args[2] := ValArg(TyInteger, args[2]);
            Result := CoreProc('PasCompareByte' + CpuSuffix('avx2'), args, TyInteger);
          end
          else
          begin
            args[1] := ValArg(TyInteger, args[1]);
            args[2] := ValArg(TyInteger, args[2]);
            Result := CoreProc('PasFindByte' + CpuSuffix('avx2'), args, TyInteger);
          end;
        end
        else if SameId(name, 'Insert') and (FTok.Kind = tkLParen) then
        begin
          { Insert(src, s, i) (P134): src into s before s[i] }
          args := ParseArgList;
          if Length(args) <> 3 then
            Refuse('Insert takes what to insert, a string variable and a place' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckTyped(args[1]);
          if IsDynTyp(args[1]^.Typ) then
          begin
            { Insert(x, a, i) of a slice (P136): the statement makes it }
            CheckOutVar(args[1], args[1]^.Typ, 'Insert(x, a, i): a');
            args[2] := ValArg(TyInteger, args[2]);
            Result := NewCall('rt_sliceins', args, TyNone);
            Exit;
          end;
          if not IsStrTyp(args[1]^.Typ) then
            Refuse('Insert takes a string or a slice variable, not ' + TypName(args[1]^.Typ) + PosOf(args[1]));
          CheckOutVar(args[1], args[1]^.Typ, 'Insert(src, s, i): s');
          args[0] := AsStr(args[0]);
          args[2] := ValArg(TyInteger, args[2]);
          Result := CoreProc('PasInsertStr', args, TyNone);
        end
        else if SameId(name, 'Concat') and (FTok.Kind = tkLParen) then
        begin
          { Concat(a, b, ...) is a + b + ... of strings and Chars (P134) }
          args := ParseArgList;
          if Length(args) < 1 then
            Refuse('Concat takes one string or more' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := AsStr(args[0]);
          for i := 1 to High(args) do
            Result := ApplyOp(boAdd, Result, AsStr(args[i]));
        end
        else if (SameId(name, 'UpCase') or SameId(name, 'LowerCase')) and (FTok.Kind = tkLParen) then
        begin
          { UpCase and LowerCase of a Char, and of a string, its ASCII
            letters (P134) }
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse(name + ' takes a Char or a string' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckTyped(args[0]);
          if IsCharT(args[0]^.Typ) or ((args[0]^.Kind = ekStr) and (Length(args[0]^.Txt) = 1)) then
          begin
            e := AsChar(StrArg(TyChar, args[0]));
            if e^.Kind = ekInt then
            begin
              if SameId(name, 'UpCase') and (e^.Num >= 97) and (e^.Num <= 122) then
                e := NewInt(e^.Num - 32)
              else if SameId(name, 'LowerCase') and (e^.Num >= 65) and (e^.Num <= 90) then
                e := NewInt(e^.Num + 32)
              else
                e := NewInt(e^.Num);
              e^.Typ := TyChar;
              Result := e;
            end
            else
            begin
              args[0] := e;
              if SameId(name, 'UpCase') then
                Result := NewCall('rt_upcase', args, TyChar)
              else
                Result := NewCall('rt_lowcase', args, TyChar);
