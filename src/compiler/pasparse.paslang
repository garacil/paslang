              Result := NewCall('rt_fmas', args, TySingle)
            else
              Result := NewCall('rt_fma', args, TyReal);
          end
          else
          begin
            SetLength(mfa, 2);
            mfa[0] := args[1];
            mfa[1] := args[2];
            if lst then
              Result := CoreCall('PasFmaS', args[0], mfa)
            else
              Result := CoreCall('PasFma', args[0], mfa);
          end;
        end
