          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Chr takes 1 argument' + MethAt(nline, ncol));
          if TypeOf(args[0]^.Typ).Kind = tykReal then
            Refuse('Chr takes an integer' + MethAt(nline, ncol));
          Result := args[0];
          Result^.Typ := TyChar;
