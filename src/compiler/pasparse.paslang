            Result := NewCall('rt_propkind', args, TyInteger)
          else if SameId(mname, 'GetPropInt') then
            Result := NewCall('rt_getpropint', args, TyInteger)
          else if SameId(mname, 'SetPropInt') then
            Result := NewCall('rt_setpropint', args, TyInteger)
          else if SameId(mname, 'SetPropStr') then
            Result := NewCall('rt_setpropstr', args, TyInteger)
          else if SameId(mname, 'SetPropMeth') then
            Result := NewCall('rt_setpropmeth', args, TyInteger)
