          args := ParseArgList;
          if Length(args) <> 3 then
            Refuse('Fma takes 3 arguments' + MethAt(nline, ncol));
          for i := 0 to 2 do
            if not (IsIntId(args[i]^.Typ) or (TypeOf(args[i]^.Typ).Kind = tykReal)) then
              Refuse('Fma takes numbers' + MethAt(nline, ncol));
          lst := (args[0]^.Typ = TySingle) and (args[1]^.Typ = TySingle) and
            (args[2]^.Typ = TySingle);
          if FArm or HasCpu('fma') then
          begin
