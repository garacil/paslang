          if FTok.Kind = tkLParen then
          begin
            FTok := FLex.Next;
            Eat(tkRParen);
          end;
          Result := NewCall('rt_gid', nil, TyInteger);
        end
        else if SameId(name, 'Gosched') then
        begin
          if FTok.Kind = tkLParen then
          begin
            FTok := FLex.Next;
            Eat(tkRParen);
          end;
          Result := NewCall('rt_yield', nil, TyNone);
        end
        else if SameId(name, 'SpinLock') or SameId(name, 'SpinUnlock') or
          SameId(name, 'ParkUnlock') or SameId(name, 'QWait') or
