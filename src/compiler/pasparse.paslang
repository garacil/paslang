        else if (SameId(name, 'CarryOn') or SameId(name, 'CarryOff') or SameId(name, 'CarryFlip')) and
          (not IsVarName(name)) and (not FindProc(name, pe)) then
        begin
          if FTok.Kind = tkLParen then
            if Length(ParseArgList) <> 0 then
              Refuse(name + ' takes no argument' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := NewCall('rt_' + ToLower(name), nil, TyNone);
        end
        else if (RotKind(name) > 0) and (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
          Result := RotCall(name)
        else if SameId(name, 'Append') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) < 1 then
            Refuse('Append takes a slice and what goes after it' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          CheckTyped(args[0]);
          if not IsDynTyp(args[0]^.Typ) then
            Refuse('Append takes a slice first, not ' + TypName(args[0]^.Typ) + PosOf(args[0]));
          if Length(args) = 2 then
            CheckTyped(args[1]);
          etyp := TypeOf(args[0]^.Typ).Elem;
          if (Length(args) = 2) and (args[1]^.Kind = ekSet) and
            (TypeOf(etyp).Kind <> tykSet) and (not IsDynTyp(etyp)) then
            { Append(s, [a, b]) appends a and b (1.0.136): the list went
              as one element, its set's bitmask }
            Result := AppendCall(args[0], args[1]^.Args, 0)
          else if (Length(args) = 2) and SameTyp(args[1]^.Typ, args[0]^.Typ) then
            Result := NewCall('rt_appendslice', args, args[0]^.Typ)
          else
            Result := AppendCall(args[0], args, 1);
        end
        else if SameId(name, 'Assigned') and (FTok.Kind = tkLParen) and
          (not FindProc(name, pe)) then
        begin
          { FPC's Assigned (1.0.133): x <> nil for a pointer, an object,
