          SameId(name, 'SetPropStr') or SameId(name, 'SetPropMeth') or
          SameId(name, 'CallProp') then
        begin
          mname := name;
          args := ParseArgList;
          if SameId(mname, 'SetPropInt') or SameId(mname, 'SetPropStr') or
            SameId(mname, 'SetPropMeth') then
          begin
            if Length(args) <> 3 then
              Die(mname + ' takes 3 arguments');
