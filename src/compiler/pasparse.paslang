          args := ParseArgList;
          if Length(args) <> 1 then
            Die('ArcCot takes 1 argument');
          Result := NewCall('rt_arccot', args, TyReal);
        end
        else if SameId(name, 'ArcSec') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('ArcSec takes 1 argument');
          Result := NewCall('rt_arcsec', args, TyReal);
        end
        else if SameId(name, 'ArcCsc') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('ArcCsc takes 1 argument');
          Result := NewCall('rt_arccsc', args, TyReal);
        end
        else if SameId(name, 'Sinh') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('Sinh takes 1 argument');
          Result := NewCall('rt_sinh', args, TyReal);
        end
        else if SameId(name, 'Cosh') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('Cosh takes 1 argument');
          Result := NewCall('rt_cosh', args, TyReal);
        end
        else if SameId(name, 'Tanh') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('Tanh takes 1 argument');
          Result := NewCall('rt_tanh', args, TyReal);
        end
        else if SameId(name, 'ArcSinh') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('ArcSinh takes 1 argument');
          Result := NewCall('rt_arcsinh', args, TyReal);
        end
        else if SameId(name, 'ArcCosh') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('ArcCosh takes 1 argument');
          Result := NewCall('rt_arccosh', args, TyReal);
        end
        else if SameId(name, 'ArcTanh') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('ArcTanh takes 1 argument');
          Result := NewCall('rt_arctanh', args, TyReal);
        end
        else if SameId(name, 'LnXP1') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('LnXP1 takes 1 argument');
          Result := NewCall('rt_lnxp1', args, TyReal);
        end
        else if SameId(name, 'ArcTan2') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('ArcTan2 takes 2 arguments');
          Result := NewCall('rt_arctan2', args, TyReal);
        end
        else if SameId(name, 'LogN') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('LogN takes 2 arguments');
          Result := NewCall('rt_logn', args, TyReal);
        end
        else if SameId(name, 'Ldexp') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('Ldexp takes 2 arguments');
          if TypeOf(args[1]^.Typ).Kind = tykReal then
            Die('Ldexp exponent is an Integer');
          Result := NewCall('rt_ldexp', args, TyReal);
        end
        else if SameId(name, 'Floor') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) = 2) and (TypeOf(args[0]^.Typ).Kind = tykTree) then
          begin
            args[1] := MapKeyArg(args[0], args[1]);
            SetLength(args, 3);
            args[2] := NewInt(4);
            Result := NewCall('rt_treebound', args, TypeOf(args[0]^.Typ).Elem);
          end
          else if Length(args) <> 1 then
            Die('Floor takes 1 argument')
          else if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_toint', args[0], NewInt(2), TyInteger)
          else
            Result := NewCall('rt_floor', args, TyInteger);
        end
        else if SameId(name, 'Ceil') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) = 2) and (TypeOf(args[0]^.Typ).Kind = tykTree) then
          begin
            args[1] := MapKeyArg(args[0], args[1]);
            SetLength(args, 3);
            args[2] := NewInt(5);
            Result := NewCall('rt_treebound', args, TypeOf(args[0]^.Typ).Elem);
          end
          else if Length(args) <> 1 then
            Die('Ceil takes 1 argument')
          else if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_toint', args[0], NewInt(3), TyInteger)
          else
            Result := NewCall('rt_ceil', args, TyInteger);
        end
        else if SameId(name, 'Chr') and (FTok.Kind = tkLParen) then
        begin
          { Chr(n) is the character with code n, as in every Pascal; it
            was missing (1.0.53). }
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('Chr takes 1 argument');
          if TypeOf(args[0]^.Typ).Kind = tykReal then
            Die('Chr takes an integer');
          Result := args[0];
          Result^.Typ := TyChar;
        end
        else if SameId(name, 'HeapCheck') and (not IsVarName(name)) then
        begin
          { HeapCheck walks every span of the heap and counts what does
            not hold (0 is sound); HeapMaskOf(p) is the pointer bits the
            heap keeps for the block that holds p, first 64 words, -1 off
            the heap. For tests (P95a). }
          if FTok.Kind = tkLParen then
          begin
            FTok := FLex.Next;
            Eat(tkRParen);
          end;
          Result := NewCall('rt_heapcheck', nil, TyInteger);
        end
        else if SameId(name, 'GcCollect') and (not IsVarName(name)) then
        begin
          { GcCollect runs a cycle of the collector now: 1, or 0 when it
            cannot (the caller holds a runtime lock). HeapStat(k) reads
            the heap's numbers (pasheap's PasHeapStat: 0 cycles, 1 bytes
            alive, 2 goal, 3 mapped, 4 given back, 5 in use, 6 free, 7
            handed out, 8 and 9 pause ns, 11 blocks PASLANG_GCVERIFY
            poisoned, 12 frames whose stack map did not fit, 13 stacks
            moved). P95b, P95c. }
          if FTok.Kind = tkLParen then
          begin
            FTok := FLex.Next;
            Eat(tkRParen);
          end;
          Result := NewCall('rt_gccollect', nil, TyInteger);
        end
        else if SameId(name, 'HeapStat') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('HeapStat takes 1 argument');
          Result := NewCall('rt_heapstat', args, TyInteger);
        end
        else if SameId(name, 'View') and (FTok.Kind = tkLParen) and
          not FindProc(name, pe) then
        begin
          { View(p, n) (P104): the n elements p points at, as a slice of
            capacity 0, like Go's unsafe.Slice; a Pointer's are bytes. }
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('View takes a pointer and a length' + HerePos);
          if TypeOf(args[0]^.Typ).Kind <> tykPointer then
            Die('View takes a pointer' + HerePos);
          NotSafe('see memory as an array');
          id := TypeOf(args[0]^.Typ).Elem;
          if id = TyNone then
            id := TyByte;
          args[1] := ValArg(TyInteger, args[1]);
          Result := NewCall('rt_view', args, InternArray(id, 0, -1));
        end
        else if (SameId(name, 'MemBase') or SameId(name, 'MemSize') or
          SameId(name, 'MemEnd')) and (FTok.Kind = tkLParen) and not FindProc(name, pe) then
        begin
          { The object that holds an address (P104): a heap block, the
            routine's stack or the globals; 0 when none. }
          mname := name;
          args := ParseArgList;
          if Length(args) <> 1 then
            Die(mname + ' takes an address' + HerePos);
          if (TypeOf(args[0]^.Typ).Kind <> tykPointer) and
            (TypeOf(args[0]^.Typ).Kind <> tykClass) and
            (TypeOf(args[0]^.Typ).Kind <> tykInteger) and (args[0]^.Kind <> ekNil) then
            Die(mname + ' takes a pointer, an object or an address' + HerePos);
          if SameId(mname, 'MemBase') then
            Result := NewCall('rt_membase', args, TyInteger)
          else if SameId(mname, 'MemSize') then
            Result := NewCall('rt_memsize', args, TyInteger)
          else
            Result := NewCall('rt_memend', args, TyInteger);
        end
        else if SameId(name, 'HeapMaskOf') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('HeapMaskOf takes 1 argument');
          Result := NewCall('rt_heapmask', args, TyInteger);
        end
        else if (SameId(name, 'Succ') or SameId(name, 'Pred')) and
          (FTok.Kind = tkLParen) then
        begin
          { The next and the previous value of an ordinal, of its type
            (1.0.74). }
          args := ParseArgList;
          if (Length(args) = 2) and (TypeOf(args[0]^.Typ).Kind = tykTree) then
          begin
            { the key after and the key before k in a tree (P110), k
              itself in the tree or not; none stops the program }
            args[1] := MapKeyArg(args[0], args[1]);
            SetLength(args, 3);
            if SameId(name, 'Succ') then
              args[2] := NewInt(2)
            else
              args[2] := NewInt(3);
            Result := NewCall('rt_treebound', args, TypeOf(args[0]^.Typ).Elem);
          end
          else
          begin
            if Length(args) <> 1 then
              Die(name + ' takes 1 argument, or a tree and a key' + HerePos);
            e := StrArg(TyChar, args[0]);
            CheckTyped(e);
            if not ((TypeOf(e^.Typ).Kind = tykInteger) or (TypeOf(e^.Typ).Kind = tykSubrange) or
              (TypeOf(e^.Typ).Kind = tykEnum) or (TypeOf(e^.Typ).Kind = tykBoolean) or
              (e^.Typ = TyChar)) then
              Die(name + ' takes an ordinal, or a tree and a key, not ' + TypName(e^.Typ) +
                HerePos);
            { A constant at the end of its type (1.0.136): Succ(Blue) was
              3, no value of TColor, and Pred(Red) -1. }
            if ((TypeOf(e^.Typ).Kind = tykEnum) or (e^.Typ = TyBoolean) or (e^.Typ = TyChar)) and
              ConstFold(e, cv, cft, cfs) then
            begin
              if SameId(name, 'Succ') and (cv >= TypeBound(e^.Typ, True)^.Num) then
                Die('Succ past the last value of ' + TypName(e^.Typ) + HerePos);
              if SameId(name, 'Pred') and (cv <= TypeBound(e^.Typ, False)^.Num) then
                Die('Pred before the first value of ' + TypName(e^.Typ) + HerePos);
            end;
            if SameId(name, 'Succ') then
              Result := NewBin(boAdd, e, NewInt(1))
            else
              Result := NewBin(boSub, e, NewInt(1));
            Result^.Typ := e^.Typ;
          end;
        end
        else if (SameId(name, 'PopCount') or SameId(name, 'LeadingZeros') or
          SameId(name, 'TrailingZeros') or SameId(name, 'ReverseBits') or
          SameId(name, 'ByteSwap')) and (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
        begin
          { The bit words of P105 (1.0.117), in the operand's width. }
          args := ParseArgList;
          if Length(args) <> 1 then
            Die(name + ' takes 1 argument' + HerePos);
          Result := BitUn(name, args[0]);
        end
        else if SameId(name, 'Carry') and (not IsVarName(name)) and (not FindProc(name, pe)) then
          Result := NewCall('rt_carry', nil, TyBoolean)
        else if (SameId(name, 'CarryOn') or SameId(name, 'CarryOff') or SameId(name, 'CarryFlip')) and
          (not IsVarName(name)) and (not FindProc(name, pe)) then
        begin
          if FTok.Kind = tkLParen then
            if Length(ParseArgList) <> 0 then
              Die(name + ' takes no argument' + HerePos);
          Result := NewCall('rt_' + ToLower(name), nil, TyNone);
        end
        else if (RotKind(name) > 0) and (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
          Result := RotCall(name)
        else if SameId(name, 'Append') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) < 1 then
            Die('Append takes a slice and what goes after it' + HerePos);
          CheckTyped(args[0]);
          if not IsDynTyp(args[0]^.Typ) then
            Die('Append takes a slice first, not ' + TypName(args[0]^.Typ) + HerePos);
          if Length(args) = 2 then
            CheckTyped(args[1]);
          etyp := TypeOf(args[0]^.Typ).Elem;
          if (Length(args) = 2) and (args[1]^.Kind = ekSet) and
            (TypeOf(etyp).Kind <> tykSet) and (not IsDynTyp(etyp)) then
            { Append(s, [a, b]) appends a and b (1.0.136): the list went
              as one element, its set's bitmask }
            Result := AppendCall(args[0], args[1]^.Args, 0)
          else if (Length(args) = 2) and SameTyp(args[1]^.Typ, args[0]^.Typ) then
            Result := NewCall('rt_appendslice', args, args[0]^.Typ)
          else
            Result := AppendCall(args[0], args, 1);
        end
        else if SameId(name, 'Assigned') and (FTok.Kind = tkLParen) and
          (not FindProc(name, pe)) then
        begin
          { FPC's Assigned (1.0.133): x <> nil for a pointer, an object,
            a routine or method value, an interface or a slice }
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('Assigned takes 1 argument' + HerePos);
          CheckTyped(args[0]);
          k := TypeOf(args[0]^.Typ).Kind;
          if not ((k = tykPointer) or (k = tykClass) or (k = tykProc) or (k = tykMethod) or
            (k = tykInterface) or IsDynTyp(args[0]^.Typ)) then
            Die('Assigned takes a pointer, an object, a routine value or a slice, not ' +
              TypName(args[0]^.Typ) + HerePos);
          Result := ApplyOp(boNe, args[0], NewNil);
        end
        else if SameId(name, 'Cap') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('Cap takes a slice' + HerePos);
          CheckTyped(args[0]);
          if not IsDynTyp(args[0]^.Typ) then
            Die('Cap takes a slice, not ' + TypName(args[0]^.Typ) + HerePos);
          Result := NewCall('rt_cap', args, TyInteger);
        end
        else if (SameId(name, 'RotateLeft') or SameId(name, 'RotateRight')) and
          (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
        begin
          { rol and ror as functions: the operand's width whatever the
            context, as a function's type is its own. }
          args := ParseArgList;
          if (Length(args) < 1) or (Length(args) > 2) then
            Die(name + ' takes 1 or 2 arguments' + HerePos);
          CheckTyped(args[0]);
          { the count is 1 when left out, as for the other rotation
            words (1.0.130) }
          if Length(args) = 1 then
          begin
            SetLength(args, 2);
            args[1] := NewInt(1);
          end;
          if RotMemOK(name, args[0]) then
          begin
            if SameId(name, 'RotateLeft') then
              Result := RotMem(args[0], RotCount(name, args[1]), 11)
            else
              Result := RotMem(args[0], RotCount(name, args[1]), 12);
          end
          else
          begin
            id := BitKind(args[0]);
            e2 := args[0];
            if id = 1 then
              e2 := BitBitsOf(e2);
            if SameId(name, 'RotateLeft') then
              e := MakeBin('rol', BitOperand(name, e2), args[1])
            else
              e := MakeBin('ror', BitOperand(name, e2), args[1]);
            Result := NewUn(uoConv, e);
            Result^.Typ := e^.Typ;
            if id = 1 then
              Result^.Typ := args[0]^.Typ;
          end;
        end
        else if SameId(name, 'IsBitSet') and (FTok.Kind = tkLParen) and
          (not FindProc(name, pe)) then
        begin
          { The Integer 0 or 1 (P105), for if IsBitSet(x, 3) then too. }
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('IsBitSet takes 2 arguments' + HerePos);
          Result := BitTest(args[0], args[1]);
        end
        else if SameId(name, 'GetBits') and (FTok.Kind = tkLParen) and
          (not FindProc(name, pe)) then
        begin
          { The field of width bits at pos, an Integer from 0 up. }
          args := ParseArgList;
          if Length(args) <> 3 then
            Die('GetBits takes 3 arguments' + HerePos);
          Result := BitGet(args[0], args[1], args[2]);
        end
        else if (SameId(name, 'MulHi') or SameId(name, 'MulHiS') or SameId(name, 'AddCarry') or
          SameId(name, 'SubBorrow') or SameId(name, 'AddOverflow') or
          SameId(name, 'SubOverflow') or SameId(name, 'MulOverflow') or SameId(name, 'AddSat') or
          SameId(name, 'SubSat')) and (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
          Result := WideCall(name, ParseArgList)
        else if (SameId(name, 'AtomicLoad') or SameId(name, 'AtomicExchange') or
          SameId(name, 'AtomicAnd') or SameId(name, 'AtomicOr') or SameId(name, 'AtomicXor') or
          SameId(name, 'LoadBE16') or SameId(name, 'LoadBE32') or SameId(name, 'LoadBE64') or
          SameId(name, 'LoadLE16') or SameId(name, 'LoadLE32') or SameId(name, 'LoadLE64')) and
          (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
          Result := MemCall(name, ParseArgList)
        else if (Length(name) > 1) and ((name[1] = 'V') or (name[1] = 'v')) and
          (VecShape(ToLower(Copy(name, 2, Length(name) - 1))) <> ' ') and
          (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
          Result := VecCall(name, ParseArgList)
        else if (SameId(name, 'CpuHas') or SameId(name, 'CpuFeatures') or
          SameId(name, 'CycleCount') or SameId(name, 'CycleFreq')) and (not FindProc(name, pe)) then
          Result := CpuCall(name)
        else if SameId(name, 'CacheLine') and (not FindProc(name, pe)) then
        begin
          { the cache line of both machines, 64 bytes (1.0.123) }
          Result := NewInt(64);
          Result^.Flags := 1;
        end
        else if (SameId(name, 'AtomicSetBit') or SameId(name, 'AtomicClearBit')) and
          (FTok.Kind = tkLParen) and (not FindProc(name, pe)) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die(name + ' takes 2 arguments' + HerePos);
          Result := BitAtomic(name, args[0], args[1]);
        end
        else if SameId(name, 'Odd') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('Odd takes 1 argument');
          if TypeOf(args[0]^.Typ).Kind = tykReal then
            Die('Odd takes an integer');
          Result := NewCall('rt_odd', args, TyBoolean);
        end
        else if SameId(name, 'IsNan') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('IsNan takes 1 argument');
          Result := NewCall('rt_isnan', args, TyBoolean);
        end
        else if SameId(name, 'IsInfinite') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('IsInfinite takes 1 argument');
          Result := NewCall('rt_isinf', args, TyBoolean);
        end
        else if (SameId(name, 'Min') or SameId(name, 'Max')) and
          (FTok.Kind = tkLParen) then
        begin
          mname := name;
          args := ParseArgList;
          if Length(args) <> 2 then
            Die(mname + ' takes 2 arguments');
          if IsQuadTyp(args[0]^.Typ) or IsQuadTyp(args[1]^.Typ) then
          begin
            if SameId(mname, 'Max') then
              Result := QCall('rtq_max', QuadOf(args[0]), QuadOf(args[1]), TyQuad)
            else
              Result := QCall('rtq_min', QuadOf(args[0]), QuadOf(args[1]), TyQuad);
          end
          else if (TypeOf(args[0]^.Typ).Kind = tykReal) or
            (TypeOf(args[1]^.Typ).Kind = tykReal) then
          begin
            if (TypeOf(args[0]^.Typ).Kind <> tykReal) or
              (TypeOf(args[1]^.Typ).Kind <> tykReal) then
              Die(mname + ' takes two integers or two reals');
            if RealJoin(args[0], args[1]) = TySingle then
            begin
              args[0] := RStamp(args[0], TySingle);
              args[1] := RStamp(args[1], TySingle);
              if SameId(mname, 'Max') then
                Result := NewCall('rt_maxsingle', args, TySingle)
              else
                Result := NewCall('rt_minsingle', args, TySingle);
            end
            else if SameId(mname, 'Max') then
              Result := NewCall('rt_maxreal', args, TyReal)
            else
              Result := NewCall('rt_minreal', args, TyReal);
          end
          else
          begin
            if SameId(mname, 'Max') then
              Result := NewCall('rt_maxint', args, TyInteger)
            else
              Result := NewCall('rt_minint', args, TyInteger);
          end;
        end
        else if SameId(name, 'Poly') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('Poly takes 2 arguments');
          if (not IsDynTyp(args[1]^.Typ)) or
            (TypeOf(TypeOf(args[1]^.Typ).Elem).Kind <> tykReal) or
            (TypeOf(args[1]^.Typ).Elem = TySingle) then
            Die('Poly takes an array of Real' + HerePos);
          Result := NewCall('rt_poly', args, TyReal);
        end
        else if SameId(name, 'Pi') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 0 then
            Die('Pi takes no arguments');
          Result := NewPi;
        end
        else if (SameId(name, 'Hex') or SameId(name, 'Md5') or SameId(name, 'Sha1') or
          SameId(name, 'Sha224') or SameId(name, 'Sha256') or SameId(name, 'Sha384') or
          SameId(name, 'Sha512') or SameId(name, 'Fnv1a32') or SameId(name, 'Fnv1a64')) and
          (FTok.Kind = tkLParen) then
        begin
          { the hash words of one string (P111): a digest is the string
            of its bytes, Hex writes one out, the FNV words give an
            Integer }
          args := ParseArgList;
          if Length(args) = 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) <> 1) or (not IsStrTyp(args[0]^.Typ)) then
            Die(name + ' takes a string' + HerePos);
          if SameId(name, 'Fnv1a32') or SameId(name, 'Fnv1a64') then
            Result := CoreProc('Pas' + name, args, TyInteger)
          else if SameId(name, 'Sha1') then
            Result := CoreProc('PasSha1' + CpuSuffix('sha1'), args, TyString)
          else if SameId(name, 'Sha224') or SameId(name, 'Sha256') then
            Result := CoreProc('Pas' + name + CpuSuffix('sha2'), args, TyString)
          else if SameId(name, 'Sha384') or SameId(name, 'Sha512') then
            Result := CoreProc('Pas' + name + CpuSuffix('sha512'), args, TyString)
          else
            Result := CoreProc('Pas' + name, args, TyString);
        end
        else if (SameId(name, 'Sha3_224') or SameId(name, 'Sha3_256') or
          SameId(name, 'Sha3_384') or SameId(name, 'Sha3_512')) and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) <> 1) or (not IsStrTyp(args[0]^.Typ)) then
            Die(name + ' takes a string' + HerePos);
          SetLength(args, 2);
          if SameId(name, 'Sha3_224') then
            args[1] := NewInt(224)
          else if SameId(name, 'Sha3_256') then
            args[1] := NewInt(256)
          else if SameId(name, 'Sha3_384') then
            args[1] := NewInt(384)
          else
            args[1] := NewInt(512);
          Result := CoreProc('PasSha3', args, TyString);
        end
        else if (SameId(name, 'HmacMd5') or SameId(name, 'HmacSha1') or
          SameId(name, 'HmacSha224') or SameId(name, 'HmacSha256') or
          SameId(name, 'HmacSha384') or SameId(name, 'HmacSha512')) and (FTok.Kind = tkLParen) then
        begin
          { HmacSha256(key, msg) and its kin (RFC 2104) }
          args := ParseArgList;
          if Length(args) = 2 then
          begin
            args[0] := StrArg(TyString, args[0]);
            args[1] := StrArg(TyString, args[1]);
          end;
          if (Length(args) <> 2) or (not IsStrTyp(args[0]^.Typ)) or
            (not IsStrTyp(args[1]^.Typ)) then
            Die(name + ' takes a key and a message, both strings' + HerePos);
          SetLength(args, 3);
          args[2] := args[1];
          args[1] := args[0];
          if SameId(name, 'HmacMd5') then
          begin
            args[0] := NewInt(0);
            Result := CoreProc('PasHmacBase', args, TyString);
          end
          else if SameId(name, 'HmacSha1') then
          begin
            args[0] := NewInt(1);
            Result := CoreProc('PasHmac' + CpuSuffix('sha1'), args, TyString);
          end
          else if SameId(name, 'HmacSha224') or SameId(name, 'HmacSha256') then
          begin
            if SameId(name, 'HmacSha224') then
              args[0] := NewInt(2)
            else
              args[0] := NewInt(3);
            Result := CoreProc('PasHmac' + CpuSuffix('sha2'), args, TyString);
          end
          else
          begin
            if SameId(name, 'HmacSha384') then
              args[0] := NewInt(4)
            else
              args[0] := NewInt(5);
            Result := CoreProc('PasHmac' + CpuSuffix('sha512'), args, TyString);
          end;
        end
        else if (SameId(name, 'Crc32') or SameId(name, 'Crc32c') or SameId(name, 'Adler32') or
          SameId(name, 'Murmur3')) and (FTok.Kind = tkLParen) then
        begin
          { Crc32(s), Crc32(s, crc) to go on from a value, Adler32 the
            same from 1, Murmur3(s, seed) }
          args := ParseArgList;
          if Length(args) >= 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) < 1) or (Length(args) > 2) or (not IsStrTyp(args[0]^.Typ)) then
            Die(name + ' takes a string and, to go on from one, the value so far' + HerePos);
          if Length(args) = 2 then
          begin
            NoReal(args[1], 'Integer');
            args[1] := ValArg(TyInteger, args[1]);
          end
          else
          begin
            SetLength(args, 2);
            if SameId(name, 'Adler32') then
              args[1] := NewInt(1)
            else
              args[1] := NewInt(0);
          end;
          if SameId(name, 'Crc32') then
          begin
            if FArm then
              Result := CoreProc('PasCrc32' + CpuSuffix('crc32'), args, TyInteger)
            else
              Result := CoreProc('PasCrc32' + CpuSuffix('pclmul sse41'), args, TyInteger);
          end
          else if SameId(name, 'Crc32c') then
          begin
            if FArm then
              Result := CoreProc('PasCrc32c' + CpuSuffix('crc32'), args, TyInteger)
            else
              Result := CoreProc('PasCrc32c' + CpuSuffix('sse42'), args, TyInteger);
          end
          else
            Result := CoreProc('Pas' + name, args, TyInteger);
        end
        else if SameId(name, 'SipHash') and (FTok.Kind = tkLParen) then
        begin
          { SipHash(s, k0, k1): SipHash-2-4 under a 128-bit key }
          args := ParseArgList;
          if Length(args) >= 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) <> 3) or (not IsStrTyp(args[0]^.Typ)) then
            Die('SipHash takes a string and the two words of its key' + HerePos);
          NoReal(args[1], 'Integer');
          NoReal(args[2], 'Integer');
          args[1] := ValArg(TyInteger, args[1]);
          args[2] := ValArg(TyInteger, args[2]);
          Result := CoreProc('PasSipHash', args, TyInteger);
        end
        else if SameId(name, 'MerkleRoot') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('MerkleRoot takes the leaves' + HerePos);
          CheckLeaves(args[0], 'MerkleRoot');
          Result := CoreProc('PasMerkleRoot' + CpuSuffix('sha2'), args, TyString);
        end
        else if SameId(name, 'MerkleProof') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('MerkleProof takes the leaves and an index' + HerePos);
          CheckLeaves(args[0], 'MerkleProof');
          NoReal(args[1], 'Integer');
          Result := CoreProc('PasMerkleProof' + CpuSuffix('sha2'), args, TyString);
        end
        else if SameId(name, 'MerkleCheck') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 5 then
          begin
            args[0] := StrArg(TyString, args[0]);
            args[3] := StrArg(TyString, args[3]);
            args[4] := StrArg(TyString, args[4]);
          end;
          if (Length(args) <> 5) or (not IsStrTyp(args[0]^.Typ)) or
            (not IsStrTyp(args[3]^.Typ)) or (not IsStrTyp(args[4]^.Typ)) then
            Die('MerkleCheck takes a leaf, its index, the count, the proof and the root' +
              HerePos);
          NoReal(args[1], 'Integer');
          NoReal(args[2], 'Integer');
          Result := CoreProc('PasMerkleCheck' + CpuSuffix('sha2'), args, TyBoolean);
        end
        else if SameId(name, 'Rank') and (FTok.Kind = tkLParen) then
        begin
          { Rank(t, k): how many keys of t are below k }
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Die('Rank takes a tree and a key' + HerePos);
          args[1] := MapKeyArg(args[0], args[1]);
          Result := NewCall('rt_treerank', args, TyInteger);
        end
        else if SameId(name, 'KeyAt') and (FTok.Kind = tkLParen) then
        begin
          { KeyAt(t, i): the key at rank i, the first at 0 }
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Die('KeyAt takes a tree and an index' + HerePos);
          NoReal(args[1], 'Integer');
          args[1] := ValArg(TyInteger, args[1]);
          Result := NewCall('rt_treekeyat', args, TypeOf(args[0]^.Typ).Elem);
        end
        else if SameId(name, 'Split') and (FTok.Kind = tkLParen) then
        begin
          { Split(t, k): the keys from k up go into a new tree }
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Die('Split takes a tree and a key' + HerePos);
          args[1] := MapKeyArg(args[0], args[1]);
          Result := NewCall('rt_treesplit', args, args[0]^.Typ);
        end
        else if SameId(name, 'Join') and (FTok.Kind = tkLParen) then
        begin
          { Join(a, b): every entry of b goes into a and b is left empty }
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) or
            (not ((args[1]^.Typ = args[0]^.Typ) or SameTyp(args[1]^.Typ, args[0]^.Typ))) then
            Die('Join takes two trees of one type' + HerePos);
          Result := NewCall('rt_treejoin', args, TyNone);
        end
        else if (SameId(name, 'Include') or SameId(name, 'Exclude')) and
          (FTok.Kind = tkLParen) then
        begin
          { Include(t, k) puts k into a tree, Exclude(t, k) takes it out
            (P110); Include(s, x) and Exclude(s, x) set and clear x's bit
            of the set variable s (P126), x in s's range }
          args := ParseArgList;
          if (Length(args) = 2) and IsSetTyp(args[0]^.Typ) then
          begin
            CheckOutVar(args[0], args[0]^.Typ, name + '(s, x): s');
            e := args[1];
            SetElemFits(e, args[0]^.Typ);
            args[1] := e;
            args[0] := NewAddr(MapPutPlace(args[0]));
            args[0]^.Flags := args[0]^.Flags or 16;
            SetLength(args, 3);
            args[2] := NewInt(Ord(SameId(name, 'Include')));
            Result := NewCall('rt_setincl', args, TyNone);
          end
          else
          begin
            if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykTree) then
              Die(name + ' takes a tree and a key, or a set and an element' + HerePos);
            args[1] := MapKeyArg(args[0], args[1]);
            if SameId(name, 'Include') then
              Result := NewCall('rt_treeadd', args, TyNone)
            else
              Result := NewCall('rt_treedel', args, TyBoolean);
          end;
        end
        else if (SameId(name, 'PopLow') or SameId(name, 'PopHigh')) and
          (FTok.Kind = tkLParen) then
        begin
          { PopLow(t, k) and PopLow(t, k, v) take the least key out of t,
            into k and v, and say whether there was one; PopHigh the
            greatest }
          args := ParseArgList;
          if (Length(args) < 2) or (Length(args) > 3) or
            (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Die(name + ' takes a tree, a key variable and, of a tree with values, a value variable' +
              HerePos);
          CheckOutVar(args[1], TypeOf(args[0]^.Typ).Elem, name + '(t, k): k');
          if Length(args) = 3 then
          begin
            if TypeOf(args[0]^.Typ).Elem2 < 0 then
              Die(name + ' of a tree of K takes the key alone' + HerePos);
            CheckOutVar(args[2], TypeOf(args[0]^.Typ).Elem2, name + '(t, k, v): v');
            args[2] := NewAddr(MapPutPlace(args[2]));
          end
          else
          begin
            SetLength(args, 3);
            args[2] := NewNil;
          end;
          args[1] := NewAddr(MapPutPlace(args[1]));
          SetLength(args, 4);
          if SameId(name, 'PopHigh') then
            args[3] := NewInt(1)
          else
            args[3] := NewInt(0);
          Result := NewCall('rt_treepop', args, TyBoolean);
        end
        else if SameId(name, 'Push') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykHeap) then
            Die('Push takes a heap and a value' + HerePos);
          args[1] := MapKeyArg(args[0], args[1]);
          Result := NewCall('rt_heappush', args, TyNone);
        end
        else if SameId(name, 'Pop') and (FTok.Kind = tkLParen) then
        begin
          { Pop(h, v) takes the least element into v and says whether
            there was one; Pop(h) gives it, and an empty heap stops the
            program }
          args := ParseArgList;
          if (Length(args) < 1) or (Length(args) > 2) or
            (TypeOf(args[0]^.Typ).Kind <> tykHeap) then
            Die('Pop takes a heap, and a variable for the element' + HerePos);
          if Length(args) = 2 then
          begin
            CheckOutVar(args[1], TypeOf(args[0]^.Typ).Elem, 'Pop(h, v): v');
            args[1] := NewAddr(MapPutPlace(args[1]));
            Result := NewCall('rt_heappop', args, TyBoolean);
          end
          else
            Result := NewCall('rt_heappop1', args, TypeOf(args[0]^.Typ).Elem);
        end
        else if SameId(name, 'StoreOpen') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 1 then
            args[0] := StrArg(TyString, args[0]);
          if (Length(args) <> 1) or (not IsStrTyp(args[0]^.Typ)) then
            Die('StoreOpen takes a path' + HerePos);
          Result := CoreProc('PasStoreOpen', args, InternStore);
        end
        else if SameId(name, 'StorePut') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 3 then
          begin
            args[1] := StrArg(TyString, args[1]);
            args[2] := StrArg(TyString, args[2]);
          end;
          if (Length(args) <> 3) or (TypeOf(args[0]^.Typ).Kind <> tykStore) or
            (not IsStrTyp(args[1]^.Typ)) or (not IsStrTyp(args[2]^.Typ)) then
            Die('StorePut takes a store, a key and a value, both strings' + HerePos);
          Result := CoreProc('PasStorePut', args, TyNone);
        end
        else if SameId(name, 'StoreGet') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 2 then
            args[1] := StrArg(TyString, args[1]);
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykStore) or
            (not IsStrTyp(args[1]^.Typ)) then
            Die('StoreGet takes a store and a key' + HerePos);
          Result := CoreProc('PasStoreGet', args, TyString);
        end
        else if SameId(name, 'StoreDelete') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) = 2 then
            args[1] := StrArg(TyString, args[1]);
          if (Length(args) <> 2) or (TypeOf(args[0]^.Typ).Kind <> tykStore) or
            (not IsStrTyp(args[1]^.Typ)) then
            Die('StoreDelete takes a store and a key' + HerePos);
          Result := CoreProc('PasStoreDelete', args, TyNone);
        end
        else if (SameId(name, 'StoreSync') or SameId(name, 'StoreClose') or
          SameId(name, 'StoreAbandon')) and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) <> 1) or (TypeOf(args[0]^.Typ).Kind <> tykStore) then
            Die(name + ' takes a store' + HerePos);
          Result := CoreProc('Pas' + name, args, TyNone);
        end
        else if (SameId(name, 'XxHash32') or SameId(name, 'XxHash64') or
          SameId(name, 'XxHash3')) and (FTok.Kind = tkLParen) then
        begin
          mname := name;
          args := ParseArgList;
          if (Length(args) < 1) or (Length(args) > 2) then
            Die(mname + ' takes 1 or 2 arguments');
          if not IsStrTyp(args[0]^.Typ) then
            Die(mname + ' hashes a string');
          if Length(args) = 2 then
          begin
            if TypeOf(args[1]^.Typ).Kind = tykReal then
              Die(mname + ' seed is an Integer');
          end
          else
          begin
            SetLength(args, 2);
            args[1] := NewInt(0);
          end;
          if SameId(mname, 'XxHash64') then
            Result := NewCall('rt_xxh64', args, TyInteger)
          else if SameId(mname, 'XxHash3') then
            Result := NewCall('rt_xxh3', args, TyInteger)
          else
            Result := NewCall('rt_xxh32', args, TyInteger);
        end
        else if SameId(name, 'Clear') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) = 1) and (TypeOf(args[0]^.Typ).Kind = tykMap) then
            Result := NewCall('rt_mapclear', args, TyNone)
          else if (Length(args) = 1) and (TypeOf(args[0]^.Typ).Kind = tykTree) then
            Result := NewCall('rt_treeclear', args, TyNone)
          else if FindProc(name, pe) then
          begin
            if not ResolveProc(name, args, pe) then
              Die('wrong number of arguments for ' + name);
            FillDefaults(pe, args);
            Result := NewCall(pe.Sym, args, pe.RetTyp);
          end
          else
            Die('Clear takes a map');
        end
        else if SameId(name, 'Delete') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if (Length(args) = 2) and (TypeOf(args[0]^.Typ).Kind = tykMap) then
          begin
            args[1] := MapKeyArg(args[0], args[1]);
            Result := NewCall('rt_mapdel', args, TyBoolean);
          end
          else if (Length(args) = 2) and (TypeOf(args[0]^.Typ).Kind = tykTree) then
          begin
            args[1] := MapKeyArg(args[0], args[1]);
            Result := NewCall('rt_treedel', args, TyBoolean);
          end
          else if (Length(args) = 3) and IsDynTyp(args[0]^.Typ) then
          begin
            { Delete(a, i, n) of a slice (P136): the statement makes it }
            CheckOutVar(args[0], args[0]^.Typ, 'Delete(a, i, n): a');
            args[1] := ValArg(TyInteger, args[1]);
            args[2] := ValArg(TyInteger, args[2]);
            Result := NewCall('rt_slicedel', args, TyNone);
          end
          else if (Length(args) = 3) and IsStrTyp(args[0]^.Typ) then
          begin
            { Delete(s, i, n) of a string (P134) }
            CheckOutVar(args[0], args[0]^.Typ, 'Delete(s, i, n): s');
            args[1] := ValArg(TyInteger, args[1]);
            args[2] := ValArg(TyInteger, args[2]);
            Result := CoreProc('PasDeleteStr', args, TyNone);
          end
          else
            Die('Delete takes a map and a key, or a string variable, an index and a count' +
              HerePos);
        end
        else if SameId(name, 'TryGet') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 3 then
            Die('TryGet takes 3 arguments');
          if (TypeOf(args[0]^.Typ).Kind <> tykMap) and
            (TypeOf(args[0]^.Typ).Kind <> tykTree) then
            Die('TryGet takes a map');
          if (TypeOf(args[0]^.Typ).Kind = tykTree) and (TypeOf(args[0]^.Typ).Elem2 < 0) then
            Die('TryGet needs a tree with values: k in t says whether k is there' + HerePos);
          args[1] := MapKeyArg(args[0], args[1]);
          CheckTryGetVar(args[0], args[2]);
          args[2] := NewAddr(MapPutPlace(args[2]));
          if TypeOf(args[0]^.Typ).Kind = tykTree then
            Result := NewCall('rt_treetry', args, TyBoolean)
          else
            Result := NewCall('rt_maptry', args, TyBoolean);
        end
        else if SameId(name, 'Copy') then
        begin
          { Copy(s, i, n), and Copy(s, i) to the end (P134) }
          args := ParseArgList;
          if (Length(args) < 2) or (Length(args) > 3) then
            Die('Copy takes a string, an index and a count, or a string and an index' + HerePos);
          CheckTyped(args[0]);
          if Length(args) = 2 then
          begin
            SetLength(args, 3);
            args[2] := NewInt(High(Int64));
          end;
          args[1] := ValArg(TyInteger, args[1]);
          args[2] := ValArg(TyInteger, args[2]);
          if IsDynTyp(args[0]^.Typ) then
          begin
            { Copy(a, i, n) and Copy(a, i) of a slice (P136): a new one
              of the elements from a[i], Free Pascal's clamps; the cut is
              a view, appended to nil }
            e := NewNil;
            e^.Typ := args[0]^.Typ;
            e2 := NewCall('rt_slicecut', args, args[0]^.Typ);
            args := nil;
            SetLength(args, 2);
            args[0] := e;
            args[1] := e2;
            Result := NewCall('rt_appendslice', args, e^.Typ);
          end
          else
          begin
            if not (IsStrTyp(args[0]^.Typ) or IsCharT(args[0]^.Typ) or (args[0]^.Kind = ekStr)) then
              Die('Copy takes a string or a slice, not ' + TypName(args[0]^.Typ) + HerePos);
            args[0] := AsStr(args[0]);
            Result := NewCall('rt_copy', args, TyString);
          end;
        end
        else if SameId(name, 'Pos') and (FTok.Kind = tkLParen) then
        begin
          { Pos(sub, s[, from]) (P134): the place from 1 of sub in s, 0
            when it is not there; a Char's search is IndexByte's }
          args := ParseArgList;
          if (Length(args) < 2) or (Length(args) > 3) then
            Die('Pos takes what to find, a string, and where to start' + HerePos);
          CheckTyped(args[0]);
          if Length(args) = 2 then
          begin
            SetLength(args, 3);
            args[2] := NewInt(1);
          end;
          args[1] := AsStr(args[1]);
          args[2] := ValArg(TyInteger, args[2]);
          if IsCharT(args[0]^.Typ) or ((args[0]^.Kind = ekStr) and (Length(args[0]^.Txt) = 1)) then
          begin
            args[0] := AsChar(StrArg(TyChar, args[0]));
            Result := CoreProc('PasPosChar' + CpuSuffix('avx2'), args, TyInteger);
          end
          else
          begin
            args[0] := AsStr(args[0]);
            Result := CoreProc('PasPos' + CpuSuffix('avx2'), args, TyInteger);
          end;
        end
        else if SameId(name, 'Insert') and (FTok.Kind = tkLParen) then
        begin
          { Insert(src, s, i) (P134): src into s before s[i] }
          args := ParseArgList;
          if Length(args) <> 3 then
            Die('Insert takes what to insert, a string variable and a place' + HerePos);
          CheckTyped(args[1]);
          if IsDynTyp(args[1]^.Typ) then
          begin
            { Insert(x, a, i) of a slice (P136): the statement makes it }
            CheckOutVar(args[1], args[1]^.Typ, 'Insert(x, a, i): a');
            args[2] := ValArg(TyInteger, args[2]);
            Result := NewCall('rt_sliceins', args, TyNone);
            Exit;
          end;
          if not IsStrTyp(args[1]^.Typ) then
            Die('Insert takes a string or a slice variable, not ' + TypName(args[1]^.Typ) + HerePos);
          CheckOutVar(args[1], args[1]^.Typ, 'Insert(src, s, i): s');
          args[0] := AsStr(args[0]);
          args[2] := ValArg(TyInteger, args[2]);
          Result := CoreProc('PasInsertStr', args, TyNone);
        end
        else if SameId(name, 'Concat') and (FTok.Kind = tkLParen) then
        begin
          { Concat(a, b, ...) is a + b + ... of strings and Chars (P134) }
          args := ParseArgList;
          if Length(args) < 1 then
            Die('Concat takes one string or more' + HerePos);
          Result := AsStr(args[0]);
          for i := 1 to High(args) do
            Result := ApplyOp(boAdd, Result, AsStr(args[i]));
        end
        else if (SameId(name, 'UpCase') or SameId(name, 'LowerCase')) and (FTok.Kind = tkLParen) then
        begin
          { UpCase and LowerCase of a Char, and of a string, its ASCII
            letters (P134) }
          args := ParseArgList;
          if Length(args) <> 1 then
            Die(name + ' takes a Char or a string' + HerePos);
          CheckTyped(args[0]);
          if IsCharT(args[0]^.Typ) or ((args[0]^.Kind = ekStr) and (Length(args[0]^.Txt) = 1)) then
          begin
            e := AsChar(StrArg(TyChar, args[0]));
            if e^.Kind = ekInt then
            begin
              if SameId(name, 'UpCase') and (e^.Num >= 97) and (e^.Num <= 122) then
                e := NewInt(e^.Num - 32)
              else if SameId(name, 'LowerCase') and (e^.Num >= 65) and (e^.Num <= 90) then
                e := NewInt(e^.Num + 32)
              else
                e := NewInt(e^.Num);
              e^.Typ := TyChar;
              Result := e;
            end
            else
            begin
              args[0] := e;
              if SameId(name, 'UpCase') then
                Result := NewCall('rt_upcase', args, TyChar)
              else
                Result := NewCall('rt_lowcase', args, TyChar);
            end;
          end
          else
          begin
            args[0] := AsStr(args[0]);
            if SameId(name, 'UpCase') then
              Result := CoreProc('PasUpper' + CpuSuffix('avx2'), args, TyString)
            else
              Result := CoreProc('PasLower' + CpuSuffix('avx2'), args, TyString);
          end;
        end
        else if SameId(name, 'StringOfChar') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('StringOfChar takes a Char and a count' + HerePos);
          CheckTyped(args[0]);
          if not (IsCharT(args[0]^.Typ) or ((args[0]^.Kind = ekStr) and (Length(args[0]^.Txt) = 1))) then
            Die('StringOfChar takes a Char, not ' + TypName(args[0]^.Typ) + HerePos);
          args[0] := AsChar(StrArg(TyChar, args[0]));
          args[1] := ValArg(TyInteger, args[1]);
          Result := CoreProc('PasStringOfChar', args, TyString);
        end
        else if (SameId(name, 'High') or SameId(name, 'Low')) and
          (FTok.Kind = tkLParen) then
        begin
          { High(T) and Low(T) of a type are constants of that type (P99):
            High(Byte) is 255, Low(Int8) -128, High(Char) #255, and an
            enumeration's, a subrange's and a static array's bounds; of a
            value, what they were. }
          FTok := FLex.Next;
          have := False;
          if FTok.Kind = tkInteger then
          begin
            id := TyInteger;
            have := True;
          end
          else if FTok.Kind = tkBoolean then
          begin
            id := TyBoolean;
            have := True;
          end
          else if IsName and (not IsVarName(FTok.Lexeme)) and
            (not FindConst(FTok.Lexeme, cv)) and NamedType(FTok.Lexeme, id) then
            have := True;
          if have then
          begin
            FTok := FLex.Next;
            Eat(tkRParen);
            Result := TypeBound(id, SameId(name, 'High'));
          end
          else
          begin
            args := nil;
            SetLength(args, 1);
            args[0] := ParseExpr;
            Eat(tkRParen);
            { of a value (1.0.136): an array's, a slice's or a string's
              bounds (a string's from 1, as its first index; Low gave 0),
              an ordinal's type's bounds (they gave whatever rdx held),
              nothing else (High of a map was garbage) }
            CheckTyped(args[0]);
            k := TypeOf(args[0]^.Typ).Kind;
            if (k = tykArray) or IsDynTyp(args[0]^.Typ) then
            begin
              if SameId(name, 'High') then
                Result := NewCall('rt_high', args, TyInteger)
              else
                Result := NewCall('rt_low', args, TyInteger);
            end
            else if IsStrTyp(args[0]^.Typ) then
            begin
              if SameId(name, 'High') then
                Result := NewCall('rt_high', args, TyInteger)
              else
                Result := NewInt(1);
            end
            else if (k = tykInteger) or (k = tykSubrange) or (k = tykEnum) or
              (k = tykBoolean) or (args[0]^.Typ = TyChar) then
              Result := TypeBound(args[0]^.Typ, SameId(name, 'High'))
            else if k = tykTree then
            begin
              { the first and the last key of a tree (P110); an empty
                tree stops the program }
              SetLength(args, 3);
              args[1] := NewNil;
              if SameId(name, 'High') then
                args[2] := NewInt(1)
              else
                args[2] := NewInt(0);
              Result := NewCall('rt_treebound', args, TypeOf(args[0]^.Typ).Elem);
            end
            else if (k = tykHeap) and SameId(name, 'Low') then
              { the top of a heap, its least element, left in place }
              Result := NewCall('rt_heaplow', args, TypeOf(args[0]^.Typ).Elem)
            else
              Die(name + ' takes an array, a slice, a string, an ordinal or a tree, not ' +
                TypName(args[0]^.Typ) + HerePos);
          end;
        end
        else if SameId(name, 'SizeOf') then
        begin
          Eat(tkLParen);
          { Integer, string and Boolean are keywords: SizeOf(Integer) was a
            syntax error (1.0.74). Integer(x) has the size of Integer. }
          if (FTok.Kind = tkInteger) or (FTok.Kind = tkStringKw) or
            (FTok.Kind = tkBoolean) then
          begin
            id := Self.ParseType;
            if FTok.Kind = tkLParen then
            begin
              FTok := FLex.Next;
              e := ParseExpr;
              Eat(tkRParen);
            end;
            Result := NewInt(TypeOf(id).Size);
          end
          else if (FTok.Kind = tkIdent) and NamedType(FTok.Lexeme, id) then
          begin
            name := FTok.Lexeme;
            FTok := FLex.Next;
            if FTok.Kind = tkRParen then
              Result := NewInt(TypeOf(id).Size)
            else if IsVarName(name) then
            begin
              e := ParsePostfix(NewVar(VarSym(name), VarTyp(name)));
              Result := NewInt(TypeOf(e^.Typ).Size);
            end
            else
              Result := NewInt(TypeOf(id).Size);
          end
          else
          begin
            e := ParseExpr;
            Result := NewInt(TypeOf(e^.Typ).Size);
          end;
          Eat(tkRParen);
        end
        else if SameId(name, 'Default') then
        begin
          { any type (1.0.136): Default(Integer), Default(string) and
            Default(Boolean) stopped on "Default type", their names
            being words of the lexer }
          Eat(tkLParen);
          id := Self.ParseType;
          Eat(tkRParen);
          Result := NewCall('rt_default', nil, id);
        end
        else if SameId(name, 'GetMem') then
        begin
          { GetMem(n) or GetMem(n, 0): the second argument 0 says the
            block holds no pointer, so the collector never scans it
            (P95a). }
          args := ParseArgList;
          if (Length(args) < 1) or (Length(args) > 2) then
            Die('GetMem takes 1 or 2 arguments');
          Result := NewCall('rt_getmem', args, InternPtr(TyInteger));
        end
        else if SameId(name, 'Syscall') then
        begin
          args := ParseArgList;
          if (Length(args) < 1) or (Length(args) > 7) then
            Die('Syscall takes 1..7 arguments');
          Result := NewCall('rt_syscall', args, TyInteger);
        end
        else if SameId(name, 'Amd64') then
        begin
          if FTok.Kind = tkLParen then
          begin
            FTok := FLex.Next;
            Eat(tkRParen);
          end;
          if FArm then
            Result := NewInt(0)
          else
            Result := NewInt(1);
        end
        else if SameId(name, 'ParamStr') then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('ParamStr takes 1 argument');
          Result := NewCall('rt_paramstr', args, TyString);
        end
        else if SameId(name, 'WaitFd') then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Die('WaitFd takes 1 argument');
          Result := NewCall('rt_waitfd', args, TyInteger);
        end
        else if SameId(name, 'WaitIo') then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('WaitIo takes 2 arguments');
          Result := NewCall('rt_waitio', args, TyInteger);
        end
        else if SameId(name, 'WaitMs') then
        begin
          args := ParseArgList;
          if Length(args) <> 3 then
            Die('WaitMs takes 3 arguments');
          Result := NewCall('rt_waitms', args, TyInteger);
        end
        else if SameId(name, 'NetListen') or SameId(name, 'NetPort') or
          SameId(name, 'NetAccept') or SameId(name, 'NetClose') then
        begin
          mname := name;
          args := ParseArgList;
          if Length(args) <> 1 then
            Die(mname + ' takes 1 argument');
          if SameId(mname, 'NetListen') then
            Result := NewCall('rt_tcplisten', args, TyInteger)
          else if SameId(mname, 'NetPort') then
            Result := NewCall('rt_tcpport', args, TyInteger)
          else if SameId(mname, 'NetAccept') then
            Result := NewCall('rt_tcpaccept', args, TyInteger)
          else
            Result := NewCall('rt_tcpclose', args, TyNone);
        end
        else if SameId(name, 'NetConnect') then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('NetConnect takes 2 arguments');
          Result := NewCall('rt_tcpconnect', args, TyInteger);
        end
        else if SameId(name, 'NetRead') then
        begin
          args := ParseArgList;
          if Length(args) <> 3 then
            Die('NetRead takes 3 arguments');
          args[2] := NewAddr(args[2]);
          Result := NewCall('rt_tcpread', args, TyNone);
        end
        else if SameId(name, 'NetWrite') then
        begin
          args := ParseArgList;
          if Length(args) <> 2 then
            Die('NetWrite takes 2 arguments');
          Result := NewCall('rt_tcpwrite', args, TyInteger);
        end
        else if SameId(name, 'PropKind') or SameId(name, 'GetPropInt') or
