        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('HeapStat takes 1 argument' + MethAt(nline, ncol));
          Result := NewCall('rt_heapstat', args, TyInteger);
        end
        else if SameId(name, 'View') and (FTok.Kind = tkLParen) and
          not FindProc(name, pe) then
        begin
          { View(p, n) (P104): the n elements p points at, as a slice of
            capacity 0, like Go's unsafe.Slice; a Pointer's are bytes. }
          args := ParseArgList;
          if Length(args) <> 2 then
            Refuse('View takes a pointer and a length' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          if TypeOf(args[0]^.Typ).Kind <> tykPointer then
            Refuse('View takes a pointer' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          NotSafeAt('see memory as an array', ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          id := TypeOf(args[0]^.Typ).Elem;
          if id = TyNone then
            id := TyByte;
          args[1] := ValArg(TyInteger, args[1]);
          Result := NewCall('rt_view', args, InternArray(id, 0, -1));
        end
        else if (SameId(name, 'MemBase') or SameId(name, 'MemSize') or
          SameId(name, 'MemEnd')) and (FTok.Kind = tkLParen) and not FindProc(name, pe) then
