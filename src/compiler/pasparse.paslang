    function ClassHasIface(Cls, Iface: LongInt): Boolean;
    function IfaceBind(E: PExpr; Want: LongInt): PExpr;
    function PtrName(const AName: string; out Id: LongInt): Boolean;
    function SliceOf(E, Lo, Hi: PExpr): PExpr;
    procedure NotSafe(const What: string);
    procedure NotSafeAt(const What, At: string);
    function PtrStep(T: LongInt): Int64;
    function IsQuadTyp(T: LongInt): Boolean;
    function QCall(const N: string; A, B: PExpr; T: LongInt): PExpr;
    function QuadLit(const S: string): PExpr;
