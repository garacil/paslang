constructor TParser.Create(Lex: TLexer; const UPath: array of string; Arm: Boolean);
var
  i: LongInt;
begin
  inherited Create;
  FLex := Lex;
  FTok := FLex.Next;
  FConsts := nil;
  FVars := nil;
  FLocals := nil;
  FProcs := nil;
  FTypeNames := nil;
  FFuncName := '';
  FFuncSym := '';
  FIsFunc := False;
  FRetTyp := TyInteger;
  FNest := 0;
  FScopes := nil;
  FClassTyp := 0;
  FWith := nil;
  FUnitName := '';
  FIsUnit := False;
  FInImpl := False;
  FLoaded := nil;
  FLoadedSum := nil;
  FLinkOnly := nil;
  FLoading := nil;
  FLinkObjs := nil;
  FUsesNames := nil;
  FCoreNames := nil;
  InitReserved;
  FArm := Arm;
  FStoreTyp := 0;
  FJsonTyp := 0;
  FCoreTree := False;
  FPendingPtr := nil;
  FPendingId := nil;
  FPendingAt := nil;
  FInTypes := False;
  FConstAt := '';
  FProg := Default(TProgram);
  SetLength(FUPath, Length(UPath));
  for i := 0 to High(UPath) do
    FUPath[i] := UPath[i];
  SetLength(FTypes, TyLastBuiltin + 1);
  for i := 0 to TyLastBuiltin do
    FTypes[i] := Default(TTypeDef);
  FTypeOrig := nil;
  FOrigHead.Keys := nil;
  FOrigHead.Vals := nil;
  FOrigHead.Used := 0;
  FTypes[TyNone].Kind := tykNone;
  FTypes[TyInteger].Name := 'Integer';
  FTypes[TyInteger].Kind := tykInteger;
  FTypes[TyInteger].Size := 8;
  FTypes[TyBoolean].Name := 'Boolean';
  FTypes[TyBoolean].Kind := tykBoolean;
  FTypes[TyBoolean].Size := 8;
  FTypes[TyString].Name := 'string';
  FTypes[TyString].Kind := tykString;
  FTypes[TyString].Size := 16;
  FTypes[TyChar].Name := 'Char';
  FTypes[TyChar].Kind := tykInteger;
  FTypes[TyChar].Size := 1;
  FTypes[TyReal].Name := 'Real';
  FTypes[TyReal].Kind := tykReal;
  FTypes[TyReal].Size := 8;
  SetNarrow(TyByte, 'Byte', 0, 255);
  SetNarrow(TyInt8, 'Int8', -128, 127);
  SetNarrow(TyWord, 'Word', 0, 65535);
  SetNarrow(TyInt16, 'Int16', -32768, 32767);
  SetNarrow(TyUInt32, 'UInt32', 0, 4294967295);
  SetNarrow(TyInt32, 'Int32', -2147483648, 2147483647);
  FTypes[TySingle].Name := 'Single';
  FTypes[TySingle].Kind := tykReal;
  FTypes[TySingle].Size := 4;
  FTypes[TyPointer].Name := 'Pointer';
  FTypes[TyPointer].Kind := tykPointer;
  FTypes[TyPointer].Size := 8;
  FTypes[TyPointer].Elem := TyNone;
  FTypes[TyQuad].Name := 'Quad';
  FTypes[TyQuad].Kind := tykQuad;
  FTypes[TyQuad].Size := 16;
  FTypes[TyV128].Name := 'V128';
  FTypes[TyV128].Kind := tykRecord;
  FTypes[TyV128].Size := 16;
  FTypes[TyV256].Name := 'V256';
  FTypes[TyV256].Kind := tykRecord;
  FTypes[TyV256].Size := 32;
  FTypes[TyCurrency].Name := 'Currency';
  FTypes[TyCurrency].Kind := tykCurrency;
  FTypes[TyCurrency].Size := 8;
end;

{ A narrow integer (P99): its own id, its range and its width (1.0.91;
  a word held it). }
procedure TParser.SetNarrow(Id: LongInt; const AName: string; ALo, AHi: Int64);
begin
  FTypes[Id].Name := AName;
  FTypes[Id].Kind := tykInteger;
  if (ALo >= -128) and (AHi <= 255) then
    FTypes[Id].Size := 1
  else if (ALo >= -32768) and (AHi <= 65535) then
    FTypes[Id].Size := 2
  else
    FTypes[Id].Size := 4;
  FTypes[Id].Lo := ALo;
  FTypes[Id].Hi := AHi;
end;

{ Pi, a real constant with no type (P101): a Single takes its nearest. }
function NewPi: PExpr;
begin
  Result := NewReal(4614256656552045848);
  Result^.Flags := 1;
  { Its digits, so a Quad takes all 113 bits of it (P103); a Double and a
    Single round from them to what the bits already are. }
  Result^.Txt := '3.14159265358979323846264338327950288419716939937510';
end;

{ The range of an integer type: Integer's is Int64's. }
function TParser.IntLo(T: LongInt): Int64;
begin
  if T = TyInteger then
  begin
    Result := 1;
    Result := Result shl 63;
  end
  else
    Result := FTypes[T].Lo;
end;

function TParser.IntHi(T: LongInt): Int64;
begin
  if T = TyInteger then
  begin
    Result := 1;
    Result := (Result shl 63) - 1;
  end
  else
    Result := FTypes[T].Hi;
end;

{ 0 for a byte, 1 two, 2 four, 3 eight. }
function TParser.IntRank(T: LongInt): LongInt;
begin
  if (T = TyByte) or (T = TyInt8) then
    Result := 0
  else if (T = TyWord) or (T = TyInt16) then
    Result := 1
  else if (T = TyUInt32) or (T = TyInt32) then
    Result := 2
  else
    Result := 3;
end;

{ A literal, a plain constant, or an expression of them alone (P99). }
function TParser.UntypedInt(E: PExpr): Boolean;
begin
  Result := False;
  if E = nil then
    Exit;
  if E^.Kind = ekInt then
    Result := (E^.Typ = TyInteger) and ((E^.Flags and 1) <> 0)
  else if E^.Kind = ekUn then
    Result := ((E^.Un = uoNeg) or (E^.Un = uoNot)) and UntypedInt(E^.L)
  else if E^.Kind = ekBin then
    Result := ((E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or
      (E^.Bin = boDiv) or (E^.Bin = boMod) or ShiftOp(E^.Bin) or
      (E^.Bin = boAnd) or (E^.Bin = boOr) or
      (E^.Bin = boXor)) and UntypedInt(E^.L) and UntypedInt(E^.R);
end;

{ The steps from class (or interface) A up its parents to B; -1 when B
  is not among them. Two units' .pi may each carry a type, as one name. }
function TParser.TypeSteps(A, B: LongInt): LongInt;
var
  k, n: LongInt;
begin
  Result := -1;
  k := A;
  n := 0;
  while (k > 0) and (k <= High(FTypes)) and (n < 10000) do
  begin
    if (k = B) or (TypeStemOf(FTypes[k]) = TypeStemOf(FTypes[B])) then
    begin
      Result := n;
      Exit;
    end;
    k := FTypes[k].Parent;
    Inc(n);
  end;
end;

{ What a call converts when it passes E for a value parameter of type T,
  priced among overloads (P141): a subrange as its host 5; a list in
  brackets for a set of its kind 5, an empty one for a set 6, for a
  slice 7, for an array of const 8; a set of another type of its kind 5;
  nil 10; a pointer for Pointer and Pointer for a pointer 20; an object
  or an interface for an ancestor 20 and one more a step; a class
  reference for another 20 and one more a step; a Char for a string 30;
  an object for an interface it implements 30, for Pointer 31; -1 what a
  call does not convert. It took the exact types, the integers and the
  reals alone: F(c) with a Char for F(const S: string), F(k) with a TKid
  for F(B: TBase) and F(nil) found no overload. P150: where Free Pascal
  3.2.2 ties two of these (a list for a set and for an array of const,
  a class reference for two ancestors, an object for an interface and
  for Pointer), the more specific wins: the nearer ancestor, the typed
  set or slice, the interface; a true tie, the same price on two
  routines, stays an error. }
function TParser.ConvCost(E: PExpr; T: LongInt): LongInt;
var
  ek, tk: TTypeKind;
  d: LongInt;
  i: SizeInt;
  a: PExpr;
begin
  Result := -1;
  if (E^.Typ < 0) or (T <= TyNone) then
    Exit;
  { the integers, the reals and Quad keep MatchCost's own prices }
  if IsIntId(E^.Typ) or IsIntId(T) or IsQuadTyp(T) or (TypeOf(T).Kind = tykReal) then
    Exit;
  ek := TypeOf(E^.Typ).Kind;
  tk := TypeOf(T).Kind;
  if (E^.Kind <> ekSet) and (E^.Typ <> TyNone) and SameTyp(E^.Typ, T) then
  begin
    Result := 0;
    Exit;
  end;
  { nil where a reference goes }
  if E^.Kind = ekNil then
  begin
    if (tk = tykClass) or (tk = tykInterface) or (tk = tykPointer) or (tk = tykProc) or
      (tk = tykMethod) or (tk = tykClassRef) or (IsDynTyp(T) and not IsConstArr(T)) then
      Result := 10;
    Exit;
  end;
  { a list in brackets: a set of its kind, a slice of what its elements
    go into, an array of const }
  if E^.Kind = ekSet then
  begin
    if IsConstArr(T) then
      Result := 8
    else if (tk = tykSet) and ((E^.Flags and 64) = 0) and (Length(E^.Args) = 0) then
      Result := 6
    else if (tk = tykSet) and ((E^.Flags and 64) = 0) and
      (SetFamily(TypeOf(E^.Typ).Elem) = SetFamily(TypeOf(T).Elem)) then
      Result := 5
    else if IsDynTyp(T) then
    begin
      Result := 7;
      for i := 0 to High(E^.Args) do
      begin
        a := E^.Args[i];
        if (a^.Kind = ekRange) or (MatchCost(a, TypeOf(T).Elem, False) < 0) then
          Result := -1;
      end;
    end;
    Exit;
  end;
  { a set of another type of its kind }
  if (ek = tykSet) and (tk = tykSet) then
  begin
    if SetFamily(TypeOf(E^.Typ).Elem) = SetFamily(TypeOf(T).Elem) then
      Result := 5;
    Exit;
  end;
  { a subrange as its host, and the host into the subrange }
  if (ek = tykSubrange) and (TypeOf(E^.Typ).Elem = T) then
  begin
    Result := 5;
    Exit;
  end;
  if (tk = tykSubrange) and (TypeOf(T).Elem = E^.Typ) and not IsIntId(T) then
  begin
    Result := 10;
    Exit;
  end;
  if (ek = tykSubrange) and (tk = tykSubrange) and (TypeOf(E^.Typ).Elem = TypeOf(T).Elem) and
    not IsIntId(T) then
  begin
    Result := 10;
    Exit;
  end;
  { a Char where a string goes }
  if IsCharT(E^.Typ) and (T = TyString) then
  begin
    Result := 30;
    Exit;
  end;
  { an object where its ancestor, an interface its class lists or an
    untyped pointer goes }
  if ek = tykClass then
  begin
    if tk = tykClass then
    begin
      d := TypeSteps(E^.Typ, T);
      if d >= 0 then
        Result := 20 + d;
    end
    else if (tk = tykInterface) and ClassHasIface(E^.Typ, T) then
      Result := 30
    else if T = TyPointer then
      Result := 31;
    Exit;
  end;
  { an interface where its parent goes }
  if (ek = tykInterface) and (tk = tykInterface) then
  begin
    d := TypeSteps(E^.Typ, T);
    if d >= 0 then
      Result := 20 + d;
    Exit;
  end;
  { class of TKid where class of TBase goes }
  if (ek = tykClassRef) and (tk = tykClassRef) then
  begin
    d := TypeSteps(TypeOf(E^.Typ).Elem, TypeOf(T).Elem);
    if d >= 0 then
      Result := 20 + d;
    Exit;
  end;
  { a pointer where Pointer goes, and Pointer where a pointer goes }
  if (ek = tykPointer) and (tk = tykPointer) and ((T = TyPointer) or (E^.Typ = TyPointer)) then
  begin
    Result := 20;
    Exit;
  end;
end;

{ How well argument E fits a parameter of type T, among overloads (P99):
  0 the same type; 10 and up an integer that widens without losing a
  value, or a constant with no type that fits, 2 more for each step of
  width and 1 more when the sign changes (a constant is an Integer, so
  its steps count down from eight bytes and a type without a sign is the
  change); 100 an integer for a Double, 101 for a Single, the nearer of
  the two (P150: they tied, and FormatFloat('0', 5) found its Single and
  its Double overloads ambiguous); -1 none. A var parameter takes its own type alone. The least total wins,
  and a tie is ambiguous, so a call that found its routine by the exact
  types finds the same one. What a call converts besides, ConvCost
  prices (P141). }
function TParser.MatchCost(E: PExpr; T: LongInt; ByRef: Boolean): LongInt;
var
  v: Int64;
  vt, from: LongInt;
  vs: string;
begin
  Result := -1;
  if E = nil then
    Exit;
  { a one-character literal is a Char first, a string after, as in Free
    Pascal: F('x') takes F(C: Char) before F(const S: string) (P141) }
  if (not ByRef) and (E^.Kind = ekStr) and (Length(E^.Txt) = 1) and
    ((T = TyChar) or (T = TyString)) then
  begin
    if T = TyChar then
      Result := 0
    else
      Result := 1;
    Exit;
  end;
  { a list in brackets is of no type yet: the set it may be ties with an
    array of const, as in Free Pascal (P141) }
  if (E^.Kind = ekSet) and not ByRef then
  begin
    Result := ConvCost(E, T);
    Exit;
  end;
  { the same type, whichever .pi brought it in: a class of a core unit
    that sysutils' .pi carries too is one class (P203: TryJsonParse's
    out EJsonError matched no overload in a program with uses sysutils) }
  if (E^.Typ = T) or SameTyp(E^.Typ, T) then
  begin
    Result := 0;
    Exit;
  end;
  if ByRef then
    Exit;
  if TypeOf(T).Kind = tykCurrency then
  begin
    if IntOperand(E) and not IsCharT(E^.Typ) then Result := 120
    else if UntypedReal(E) then Result := 4;
    Exit;
  end;
  if TypeOf(E^.Typ).Kind = tykCurrency then Exit;
  Result := ConvCost(E, T);
  if Result >= 0 then
    Exit;
  if IsIntId(E^.Typ) and IsIntId(T) then
  begin
    from := E^.Typ;
    if UntypedInt(E) then
    begin
      if not ConstFold(E, v, vt, vs) then
        Exit;
      if (v < IntLo(T)) or (v > IntHi(T)) then
        Exit;
      Result := 10 + 2 * (3 - IntRank(T));
      if IntLo(T) >= 0 then
        Result := Result + 1;
      Exit;
    end;
    if (IntLo(T) > IntLo(from)) or (IntHi(T) < IntHi(from)) then
      Exit;
    Result := 10 + 2 * (IntRank(T) - IntRank(from));
    if (IntLo(T) < 0) <> (IntLo(from) < 0) then
      Result := Result + 1;
    Exit;
  end;
  { Reals (P101): a constant with no type fits a Double best, then a
    Single; a Single widens to a Double; a Double never narrows. }
  if (TypeOf(E^.Typ).Kind = tykReal) and (TypeOf(T).Kind = tykReal) then
  begin
    if UntypedReal(E) then
    begin
      if T = TySingle then
        Result := 2
      else
        Result := 1;
    end
    else if (E^.Typ = TySingle) and (T <> TySingle) then
      Result := 10;
    Exit;
  end;
  if IsIntId(E^.Typ) and (TypeOf(T).Kind = tykReal) then
  begin
    if T = TySingle then
      Result := 101
    else
      Result := 100;
  end;
  { A Quad takes every real exactly, after the reals' own types (P103). }
  if IsQuadTyp(T) then
  begin
    if UntypedReal(E) then
      Result := 3
    else if TypeOf(E^.Typ).Kind = tykReal then
      Result := 20
    else if IsIntId(E^.Typ) then
      Result := 110;
  end;
end;

{ Every value of F is one of T (P99): Byte to Int16, not Int8 to Word. }
function TParser.IntWidens(F, T: LongInt): Boolean;
begin
  Result := (IntLo(T) <= IntLo(F)) and (IntHi(F) <= IntHi(T));
end;

function TParser.FitsInt(V: Int64; T: LongInt): Boolean;
begin
  Result := (V >= IntLo(T)) and (V <= IntHi(T));
end;

function TParser.IntArith(Op: TBinOp): Boolean;
begin
  Result := (Op = boAdd) or (Op = boSub) or (Op = boMul) or (Op = boDiv) or
    (Op = boMod) or (Op = boAnd) or (Op = boOr) or (Op = boXor) or
    ShiftOp(Op);
end;

{ sar, rol and ror of constants in T's width (P105), as the machines
  do them: sar counts modulo 64 and fills with the top bit of the width,
  a rotation counts modulo the width. }
function TParser.FoldRot(Op: TBinOp; LV, RV: Int64; T: LongInt): Int64;
var
  w, n: LongInt;
  mask, u, r: Int64;
  signed: Boolean;
begin
  w := 64;
  if IsNarrowId(T) then
    w := TypeOf(T).Size * 8;
  if w = 64 then
    mask := -1
  else
    mask := (Int64(1) shl w) - 1;
  signed := IntLo(T) < 0;
  u := LV and mask;
  if Op = boSar then
  begin
    r := u;
    if (w < 64) and (((u shr (w - 1)) and 1) = 1) then
      r := u or (not mask);
    n := LongInt(RV and 63);
    if r < 0 then
      r := ((r xor -1) shr n) xor -1
    else
      r := r shr n;
  end
  else
  begin
    n := LongInt(RV and (w - 1));
    if n = 0 then
      r := u
    else if Op = boRol then
      r := (u shl n) or (u shr (w - n))
    else
      r := (u shr n) or (u shl (w - n));
  end;
  r := r and mask;
  if signed and (w < 64) and (((r shr (w - 1)) and 1) = 1) then
    r := r or (not mask);
  Result := r;
end;

{ A shift or a rotation: its type is its left operand's (P105). }
function TParser.ShiftOp(Op: TBinOp): Boolean;
begin
  Result := (Op = boShl) or (Op = boShr) or (Op = boSar) or (Op = boRol) or (Op = boRor);
end;

{ An integer, a Char or a subrange: what integer arithmetic takes. }
function TParser.IntOperand(E: PExpr): Boolean;
var
  k: TTypeKind;
begin
  Result := False;
  if E = nil then
    Exit;
  k := TypeOf(E^.Typ).Kind;
  Result := (k = tykInteger) or (k = tykSubrange);
end;

{ An operand that the arithmetic or logic operator K does not take
  (1.0.116): a string (+ joins it, nothing else), an array, a record, an
  object, a map, a channel, a routine or an interface. They compiled and
  worked on the hidden address: s + 1 dropped the 1, -s crashed, a + a
  added two addresses, s xor s gave garbage. }
procedure TParser.CheckOperand(const K: string; E: PExpr);
var
  kd: TTypeKind;
  what: string;
begin
  if E = nil then
    Exit;
  kd := TypeOf(E^.Typ).Kind;
  what := '';
  if kd = tykString then
    what := 'a string'
  else if kd = tykRecord then
    what := 'a record'
  else if kd = tykArray then
    what := 'an array'
  else if kd = tykClass then
    what := 'an object'
  else if kd = tykMap then
    what := 'a map'
  else if kd = tykChan then
    what := 'a channel'
  else if (kd = tykProc) or (kd = tykMethod) then
    what := 'a routine'
  else if kd = tykInterface then
    what := 'an interface';
  if what <> '' then
    Refuse(K + ' does not take ' + what + PosOf(E));
end;

{ A type's name for a message; an anonymous one is this value. }
function TParser.TypName(T: LongInt): string;
var
  k: TTypeKind;
  i: SizeInt;
begin
  Result := FTypes[T].Name;
  if Result <> '' then
    Exit;
  { A type a type section named, a subrange or an alias of a type with
    no name of its own, is known by that name (1.0.136): sr := r said
    "a real does not go into : Trunc or Round says how". }
  for i := 0 to High(FTypeNames) do
    if FTypeNames[i].Id = T then
    begin
      Result := FTypeNames[i].Name;
      Exit;
    end;
  k := TypeOf(T).Kind;
  if k = tykSubrange then
    Result := IntToStr(TypeOf(T).Lo) + '..' + IntToStr(TypeOf(T).Hi)
  else if k = tykEnum then
    Result := 'an enumeration'
  else if k = tykRecord then
    Result := 'a record'
  else if (k = tykArray) and (TypeOf(T).Elem2 = ConstArrMark) then
    Result := 'array of const'
  else if (k = tykArray) and IsDynTyp(T) then
    Result := 'array of ' + TypName(TypeOf(T).Elem)
  else if k = tykArray then
    Result := 'array[' + IntToStr(TypeOf(T).Lo) + '..' + IntToStr(TypeOf(T).Hi) + '] of ' +
      TypName(TypeOf(T).Elem)
  else if k = tykPointer then
    Result := 'a pointer'
  else if k = tykSet then
    Result := 'set of ' + TypName(TypeOf(T).Elem)
  else if k = tykMap then
    { by its key and value (1.0.140): two maps in one message were both
      "a map" }
    Result := 'map[' + TypName(TypeOf(T).Elem) + '] of ' + TypName(TypeOf(T).Elem2)
  else if k = tykTree then
  begin
    if TypeOf(T).Elem2 < 0 then
      Result := 'tree of ' + TypName(TypeOf(T).Elem)
    else
      Result := 'tree[' + TypName(TypeOf(T).Elem) + '] of ' +
        TypName(TypeOf(T).Elem2);
  end
  else if k = tykHeap then
    Result := 'heap of ' + TypName(TypeOf(T).Elem)
  else if k = tykStore then
    Result := 'store'
  else if k = tykJson then
    Result := 'json'
  else if k = tykChan then
    Result := 'a channel'
  else if (k = tykProc) or (k = tykMethod) then
    Result := 'a routine value'
  else if k = tykInterface then
    Result := 'an interface'
  else if k = tykClass then
    Result := 'an object'
  else if k = tykClassRef then
    Result := 'class of ' + TypName(TypeOf(T).Elem)
  else
    Result := 'this value';
end;

{ A real where an ordinal goes (1.0.136): Inc(i, r), a[r], for i := 1
  to r, SetLength(s, r) and case r of took the real's bits as the
  integer, as i := r did before 1.0.103. }
procedure TParser.NoReal(E: PExpr; const Into: string);
var
  k: TTypeKind;
begin
  if E = nil then
    Exit;
  k := TypeOf(E^.Typ).Kind;
  if k = tykReal then
    Refuse('a real does not go into ' + Into + ': Trunc or Round says how' + PosOf(E));
  if k = tykQuad then
    Refuse('a Quad does not go into ' + Into + ': Trunc or Round says how' + PosOf(E));
  if k = tykCurrency then
    Refuse('a Currency does not go into ' + Into + ': Trunc or Round says how' + PosOf(E));
end;

{ A real as a condition (1.0.136): if r and while r compared its bits
  with zero, so 0.0 and -0.0 differed. }
procedure TParser.NoRealCond(E: PExpr);
var
  k: TTypeKind;
begin
  if E = nil then
    Exit;
  k := TypeOf(E^.Typ).Kind;
  if (k = tykReal) or (k = tykQuad) or (k = tykCurrency) then
    Refuse('a real does not go into Boolean: compare it' + PosOf(E));
  if k = tykJson then
    Refuse('a json is no condition: j.AsBoolean reads one, j.IsNull says null' + PosOf(E));
end;

{ A global of a var or a const section may not take the name of another
  (1.0.136): two of the program's own met only in the assembler. A
  program's Counter hid the Counter of a unit it used in silence, and
  was refused from 1.0.136; from P158 it hides it, as in Free Pascal,
  and the unit's is uv.Counter. }
procedure TParser.CheckGlobalName(const AName, At: string);
var
  i: SizeInt;
begin
  HideUnitNames(AName, 'v', nil, '');
  for i := 0 to High(FVars) do
    if SameId(FVars[i].Name, AName) then
      Refuse('duplicate identifier ' + AName + At);
end;

{ The word of a binary operator, for messages. }
function TParser.BinWord(Op: TBinOp): string;
begin
  case Op of
    boAdd: Result := '+';
    boSub: Result := '-';
    boMul: Result := '*';
    boSlash: Result := '/';
    boDiv: Result := 'div';
    boMod: Result := 'mod';
    boShl: Result := 'shl';
    boShr: Result := 'shr';
    boSar: Result := 'sar';
    boRol: Result := 'rol';
    boRor: Result := 'ror';
    boAnd: Result := 'and';
    boOr: Result := 'or';
    boXor: Result := 'xor';
    boIn: Result := 'in';
    boEq: Result := '=';
    boNe: Result := '<>';
    boLt: Result := '<';
    boLe: Result := '<=';
    boGt: Result := '>';
    boGe: Result := '>=';
  else
    Result := 'this operator';
  end;
end;

{ Boolean(x) (1.0.116): an ordinal, a Char or a pointer is True when it
  is not zero (nil), as a condition takes it; a constant now. The word
  was not an expression at all. }
function TParser.BoolOf(E: PExpr): PExpr;
var
  k: TTypeKind;
begin
  CheckTyped(E);
  k := TypeOf(E^.Typ).Kind;
  Result := E;
  if k = tykBoolean then
    Exit;
  if (k = tykReal) or IsQuadTyp(E^.Typ) then
    Refuse('a real does not go into Boolean: compare it' + PosOf(E));
  if k = tykJson then
    Refuse('a json is no Boolean: j.AsBoolean reads one, j.IsNull says null' + PosOf(E));
  if not ((k = tykInteger) or (k = tykSubrange) or (k = tykEnum) or
    (k = tykPointer) or (k = tykClass) or (k = tykMap) or (k = tykTree) or
    (k = tykHeap) or (k = tykStore) or (k = tykChan)) then
    Refuse('Boolean() takes an ordinal or a pointer' + PosOf(E));
  if E^.Kind = ekInt then
  begin
    Result := NewInt(Ord(E^.Num <> 0));
    Result^.Typ := TyBoolean;
    Exit;
  end;
  Result := NewBin(boNe, AsInt(E, TyInteger), NewInt(0));
end;

{ E as the integer type T with no code: a conversion node over a Boolean,
  whose operations depend on its type (not t flips one bit, not of an
  integer every bit), the node relabelled otherwise. Ord(not t) and
  Integer(not t) relabelled the not and gave -2 (1.0.116). }
function TParser.AsInt(E: PExpr; T: LongInt): PExpr;
begin
  if TypeOf(E^.Typ).Kind = tykBoolean then
    Result := NewUn(uoConv, E)
  else
    Result := E;
  Result^.Typ := T;
end;

{ The type two integer operands are worked out in (P99): a constant with
  no type takes the other's; else the narrowest of Int8, Byte, Int16,
  Word, Int32, UInt32 and Integer that holds both, so Byte and Int8 join
  in Int16, Word and Int16 in Int32, UInt32 and Int32 in Integer. A Char
  or a subrange works as Integer, as it did. }
function TParser.JoinInt(L, R: PExpr): LongInt;
var
  a, b, t, k: LongInt;
  lo, hi: Int64;
begin
  a := L^.Typ;
  b := R^.Typ;
  if not IsIntId(a) then
    a := TyInteger;
  if not IsIntId(b) then
    b := TyInteger;
  if UntypedInt(L) and UntypedInt(R) then
  begin
    Result := TyInteger;
    Exit;
  end;
  if UntypedInt(L) then
  begin
    Result := b;
    Exit;
  end;
  if UntypedInt(R) or (a = b) then
  begin
    Result := a;
    Exit;
  end;
  lo := IntLo(a);
  if IntLo(b) < lo then
    lo := IntLo(b);
  hi := IntHi(a);
  if IntHi(b) > hi then
    hi := IntHi(b);
  Result := TyInteger;
  for k := 0 to 5 do
  begin
    if k = 0 then
      t := TyInt8
    else if k = 1 then
      t := TyByte
    else if k = 2 then
      t := TyInt16
    else if k = 3 then
      t := TyWord
    else if k = 4 then
      t := TyInt32
    else
      t := TyUInt32;
    if (IntLo(t) <= lo) and (IntHi(t) >= hi) then
    begin
      Result := t;
      Exit;
    end;
  end;
end;

{ The indicated type rules (P99): the operations of an integer tree are
  worked out in T, down to its leaves, which widen with no code; a
  conversion is a leaf, and so is a shift's count. }
procedure TParser.Stamp(E: PExpr; T: LongInt);
begin
  if (E = nil) or (not IsIntId(T)) then
    Exit;
  if (E^.Kind = ekBin) and IntArith(E^.Bin) and IsIntId(E^.Typ) then
  begin
    E^.Typ := T;
    Stamp(E^.L, T);
    if not ShiftOp(E^.Bin) then
      Stamp(E^.R, T);
  end
  else if (E^.Kind = ekUn) and WidthUn(E^.Un) and IsIntId(E^.Typ) then
  begin
    E^.Typ := T;
    Stamp(E^.L, T);
  end;
end;

{ A constant with no type that holds a not, taken in the unsigned
  narrow T (1.0.116): not flips the bits of T's width, so not 2 is 253
  in a Byte; worked out in Integer it was -3, and b and not 2, the mask
  that clears a bit, did not compile. A value that not of a constant
  that fits cannot give still does not fit (not 2 - 300). }
function TParser.NotWrap(E: PExpr; V: Int64; T: LongInt): Int64;
var
  w: Int64;

  function HasNot(X: PExpr): Boolean;
  begin
    Result := False;
    if X = nil then
      Exit;
    if X^.Kind = ekUn then
      Result := (X^.Un = uoNot) or HasNot(X^.L)
    else if X^.Kind = ekBin then
      Result := HasNot(X^.L) or HasNot(X^.R);
  end;

begin
  Result := V;
  if (V >= 0) or (not IsNarrowId(T)) or (IntLo(T) < 0) or (not HasNot(E)) then
    Exit;
  w := Int64(1) shl (TypeOf(T).Size * 8);
  if V >= -w then
    Result := V + w;
end;

{ Each constant with no type in the tree E, worked out in T, fits T. }
procedure TParser.CheckFit(E: PExpr; T: LongInt; const Where: string);
var
  v: Int64;
  vt: LongInt;
  vs: string;
begin
  if (E = nil) or (not IsNarrowId(T)) then
    Exit;
  if UntypedInt(E) then
  begin
    if ConstFold(E, v, vt, vs) and (not FitsInt(NotWrap(E, v, T), T)) then
      { TypName (1.0.136): a subrange's Name is empty. }
    begin
      { at the constant (P340), the caller's place for one the compiler made }
      if E^.PosLine > 0 then
        Refuse('constant ' + IntToStr(v) + ' does not fit ' + TypName(T) + PosOf(E));
      Refuse('constant ' + IntToStr(v) + ' does not fit ' + TypName(T) + Where);
    end;
    Exit;
  end;
  if (E^.Kind = ekBin) and IntArith(E^.Bin) and (E^.Typ = T) then
  begin
    CheckFit(E^.L, T, Where);
    if not ShiftOp(E^.Bin) then
      CheckFit(E^.R, T, Where);
  end
  else if (E^.Kind = ekUn) and WidthUn(E^.Un) and (E^.Typ = T) then
    CheckFit(E^.L, T, Where);
end;

{ An integer operation's type: a shift keeps its left operand's, the
  others join both; the whole tree then works in it. }
procedure TParser.TypeIntBin(E: PExpr);
var
  t: LongInt;
begin
  if ShiftOp(E^.Bin) then
  begin
    t := E^.L^.Typ;
    if UntypedInt(E^.L) or (not IsIntId(t)) then
      t := TyInteger;
    E^.Typ := t;
    Stamp(E^.L, t);
    Exit;
  end;
  t := JoinInt(E^.L, E^.R);
  E^.Typ := t;
  Stamp(E^.L, t);
  Stamp(E^.R, t);
end;

function TParser.HerePos: string;
begin
  Result := ' at ' + IntToStr(FTok.Line) + ':' + IntToStr(FTok.Col);
end;

{ The stem a class, an interface or a helper named AName declared here
  keeps in its TTypeDef.Sym (P154): the unit's name and its own, as a
  unit's routine is p_unit_name, so that two units may each declare a
  TFoo; '' in a program and in a core unit, whose types keep their name
  alone (TObject's vmt_tobject is the language's). }
function TParser.UnitStem(const AName: string): string;
begin
  if FIsUnit and not IsCoreUnit(FUnitName) then
    Result := ToLower(FUnitName) + '_' + ToLower(AName)
  else
    Result := '';
end;

{ The stem the symbols of a type named AName declared here take:
  UnitStem's, or the name. }
function TParser.StemOfName(const AName: string): string;
begin
  Result := UnitStem(AName);
  if Result = '' then
    Result := ToLower(AName);
end;

{ Where a duplicate name is told (P151): the place of the name being
  declared when a declaration set it, else the token read now. A
  message without a place sent the reader searching a unit of thousands
  of lines. }
function TParser.DupAt: string;
begin
  if FDeclAt <> '' then
    Result := FDeclAt
  else
    Result := HerePos;
end;

{ E where an integer of type Want is wanted (P99): an assignment, a
  value parameter, Result and Exit, a for, Send. E is worked out in Want
  when every value of its type is one of Want's, and a constant with no
  type must fit; a wider E needs a conversion. }
function TParser.CoerceInt(E: PExpr; Want: LongInt): PExpr;
begin
  Result := E;
  if (E = nil) or (not IsIntId(Want)) or (not IsIntId(E^.Typ)) then
    Exit;
  if UntypedInt(E) then
  begin
    CheckFit(E, Want, HerePos);
    Stamp(E, Want);
    Exit;
  end;
  if not IntWidens(E^.Typ, Want) then
    Refuse(TypName(E^.Typ) + ' needs a conversion to ' + TypName(Want) +
      PosOf(E));
  Stamp(E, Want);
  CheckFit(E, Want, HerePos);
end;

{ T(e) for an integer type T (P99): a constant must fit; an e whose
  values are all T's is worked out in T (Integer(b + 1) is 256); else
  the value is converted, keeping its low bits (uoConv). }
function TParser.ConvertInt(E: PExpr; T: LongInt): PExpr;
var
  v: Int64;
  vt: LongInt;
  vs: string;
begin
  Result := E;
  if E = nil then
    Exit;
  { A real becomes an integer through Trunc or Round; its bits are seen
    by a view. UInt64(d) and Byte(d) relabelled the bits (1.0.119). }
  if (TypeOf(E^.Typ).Kind = tykReal) or (TypeOf(E^.Typ).Kind = tykCurrency) then
    Refuse('a real becomes ' + TypName(T) + ' through Trunc or Round; x as ' + TypName(T) +
      ' sees its bits' + PosOf(E));
  if TypeOf(E^.Typ).Kind = tykBoolean then
  begin
    Result := AsInt(E, T);
    Exit;
  end;
  if UntypedInt(E) and ConstFold(E, v, vt, vs) then
  begin
    v := NotWrap(E, v, T);
    if not FitsInt(v, T) then
      Refuse('constant ' + IntToStr(v) + ' does not fit ' + TypName(T) +
        PosOf(E));
    Result := NewInt(v);
    Result^.Typ := T;
    Exit;
  end;
  if IsIntId(E^.Typ) and IntWidens(E^.Typ, T) then
  begin
    { A conversion is a boundary: the work inside is done in T, and a
      conversion around it does not reach in. Integer(Byte(i)) relabelled
      the Byte conversion, which then did nothing (300 for 300), and
      Integer(Byte(b + 1)) worked b + 1 out in Integer again (256 for 0)
      (1.0.116). The node costs no code when it widens. }
    if ((E^.Kind = ekBin) and IntArith(E^.Bin)) or
      ((E^.Kind = ekUn) and WidthUn(E^.Un)) then
      Stamp(E, T);
    if (E^.Kind = ekBin) or (E^.Kind = ekUn) then
    begin
      Result := NewUn(uoConv, E);
      Result^.Typ := T;
    end
    else
      E^.Typ := T;
    Exit;
  end;
  if IsNarrowId(T) then
  begin
    Result := NewUn(uoConv, E);
    Result^.Typ := T;
    Exit;
  end;
  E^.Typ := T;
end;

{ After a body is read (P99): every narrow integer operation's constants
  fit its type, wherever no context gave it one (WriteLn(b + 300)). }
procedure TParser.CheckNarrowE(E: PExpr; Line: LongInt);
var
  i: SizeInt;
begin
  if E = nil then
    Exit;
  if IsNarrowId(E^.Typ) and
    (((E^.Kind = ekBin) and IntArith(E^.Bin)) or
    ((E^.Kind = ekUn) and WidthUn(E^.Un))) then
    CheckFit(E, E^.Typ, ' at line ' + IntToStr(Line));
  CheckNarrowE(E^.L, Line);
  CheckNarrowE(E^.R, Line);
  for i := 0 to High(E^.Args) do
    CheckNarrowE(E^.Args[i], Line);
end;

procedure TParser.CheckNarrowS(S: PStmt);
var
  i: SizeInt;
begin
  if S = nil then
    Exit;
  CheckNarrowE(S^.E, S^.Line);
  CheckNarrowE(S^.E2, S^.Line);
  CheckNarrowE(S^.Dest, S^.Line);
  for i := 0 to High(S^.Args) do
    CheckNarrowE(S^.Args[i], S^.Line);
  CheckNarrowS(S^.ThenSt);
  CheckNarrowS(S^.ElseSt);
  CheckNarrowS(S^.Body);
  for i := 0 to High(S^.Stmts) do
    CheckNarrowS(S^.Stmts[i]);
  for i := 0 to High(S^.Arms) do
    CheckNarrowS(S^.Arms[i].Body);
  for i := 0 to High(S^.Sels) do
  begin
    CheckNarrowE(S^.Sels[i].Chan, S^.Line);
    CheckNarrowE(S^.Sels[i].ValX, S^.Line);
    CheckNarrowS(S^.Sels[i].Body);
  end;
end;

{ A for loop's limit is worked out once, before the loop, as in every
  Pascal (1.0.93): a limit that is not a constant goes to a hidden
  variable first. The loop worked it out again after each pass, a push
  and a pop each, and a body that changed n changed the loop. }
function TParser.HoistLimit(F: PStmt; T: LongInt): PStmt;
var
  hid: string;
  n: SizeInt;
  asg: PStmt;
begin
  Inc(FLimitN);
  hid := 'for.lim' + IntToStr(FLimitN);
  if FInBody then
  begin
    n := Length(FLimits);
    SetLength(FLimits, n + 1);
    FLimits[n] := Default(TVarDecl);
    FLimits[n].Name := hid;
    FLimits[n].Typ := T;
  end
  else
  begin
    AddVar(hid, T, False);
    if FUnitName <> '' then
    begin
      FVars[High(FVars)].Sym := FUnitName + '.' + hid;
      FVars[High(FVars)].Pub := False;
    end;
  end;
  asg := NewStmt(skAssign);
  asg^.Line := F^.Line;
  asg^.Dest := NewVar(VarSym(hid), T);
  asg^.E := F^.E2;
  F^.E2 := NewVar(VarSym(hid), T);
  Result := NewStmt(skBlock);
  Result^.Line := F^.Line;
  SetLength(Result^.Stmts, 2);
  Result^.Stmts[0] := asg;
  Result^.Stmts[1] := F;
end;

{ High(T) or Low(T) of type Id, a constant of that type (P99). }
function TParser.TypeBound(Id: LongInt; Hi: Boolean): PExpr;
var
  td: TTypeDef;
  v, blo, bhi: Int64;
  t: LongInt;
begin
  td := TypeOf(Id);
  t := Id;
  if td.Kind = tykCurrency then
  begin
    if Hi then v := High(Int64) else v := Low(Int64);
  end
  else if OrdBounds(Id, blo, bhi) then
  begin
    if Hi then
      v := bhi
    else
      v := blo;
  end
  else if (td.Kind = tykArray) and (td.Hi >= td.Lo) then
  begin
    if Hi then
      v := td.Hi
    else
      v := td.Lo;
    { of the index's type (P161): High of an array[TColor] is a TColor }
    if (td.Elem2 > 0) and (td.Elem2 <> ConstArrMark) then
      t := td.Elem2
    else
      t := TyInteger;
  end
  else
  begin
    Refuse('no bounds for type ' + td.Name + HerePos);
    v := 0;
  end;
  Result := NewInt(v);
  Result^.Typ := t;
  if td.Kind = tykCurrency then Result^.Flags := 0;
end;

{ The atomics work on a whole word (lock xadd, cmpxchg, ldaxr): through a
  pointer to a narrower integer they wrote its neighbours too (P99). }
procedure TParser.CheckAtomicTarget(E: PExpr; const What: string);
var
  t: LongInt;
begin
  if E = nil then
    Exit;
  CheckTyped(E);
  if TypeOf(E^.Typ).Kind <> tykPointer then
    { a plain variable compiled and died at run time on a nil pointer (1.0.147) }
    Refuse(What + ' takes the address of an Integer, as ' + What + '(@v, ...), not the ' +
      TypName(E^.Typ) + ' itself' + PosOf(E));
  t := TypeOf(E^.Typ).Elem;
  if (TypeOf(t).Kind = tykInteger) and (ValSize(t) <> 8) then
    Refuse(What + ' needs an 8-byte integer, not a ' + TypeOf(t).Name + PosOf(E));
end;

procedure TParser.CheckNarrowProg;
var
  i: SizeInt;
begin
  for i := 0 to High(FProg.Procs) do
    CheckNarrowS(FProg.Procs[i].Body);
  CheckNarrowS(FProg.Body);
  CheckNarrowS(FProg.InitBody);
  CheckNarrowS(FProg.FiniBody);
end;

procedure TParser.Fail(const Msg: string);
begin
  Die(Msg + ' at ' + IntToStr(FTok.Line) + ':' + IntToStr(FTok.Col) +
    ' [' + FTok.Lexeme + ']');
end;

{ A refusal with the place of the token at hand when Msg names none of
  its own (P383): every message of the parser says where, as Go's
  compiler puts each error at a position (cmd/compile/internal/syntax:
  the parser's syntaxErrorAt; base.ErrorfAt). }
procedure TParser.Refuse(const Msg: string);
begin
  if HasPlace(Msg) then
    Die(Msg)
  else
    Die(Msg + HerePos);
end;

{ The token at hand where What goes (P383): a reserved word says it is
  one, anything else what was looked for, and Fail adds the place and
  the token met, as Go's parser says unexpected X, expected Y (syntax/
  parser.go, syntaxErrorAt). }
procedure TParser.Expected(const What: string);
begin
  if ((FTok.Kind <> tkIdent) and IsName) or TypeWord then
    Fail(FTok.Lexeme + ' is a reserved word, not ' + What)
  else
    Fail(What + ' expected');
end;

procedure TParser.Eat(K: TTokKind);
begin
  { A reserved word where a name goes says so (1.0.131): var sleep: was
    a bare syntax error. }
  if (K = tkIdent) and (FTok.Kind <> tkIdent) and (IsName or TypeWord) then
    Fail(FTok.Lexeme + ' is a reserved word, not a name');
  if FTok.Kind <> K then
    Fail('syntax error');
  FTok := FLex.Next;
end;

{ tree, heap, store and json: words of the language outside the range
  IsName takes, which a declaration names by mistake (1.1.1: var heap:
  gave a bare syntax error). Only the reserved-word messages ask it. }
function TParser.TypeWord: Boolean;
begin
  Result := (FTok.Kind = tkTree) or (FTok.Kind = tkHeap) or (FTok.Kind = tkStore) or
    (FTok.Kind = tkJson);
end;

function TParser.IsName: Boolean;
begin
  Result := (FTok.Kind = tkIdent) or
    ((Ord(FTok.Kind) >= Ord(tkProgram)) and (Ord(FTok.Kind) <= Ord(tkFalse)));
end;

{ ---- Names found in a table (P376) ----

  Compiling src/rtl/sysutils.paslang, SameId ran 0.43G instructions of
  2.96G (P375's figures), CoreName, ConstIdx, AddVar, ParsePrimary0,
  NamedType and ResolveProc walking every constant, routine and core name
  and comparing each with the one looked for. Go's types2 keeps a scope's
  objects in a map (Scope, elems map[string]Object). The constants, the
  routines and the core names are found by a head table now, FNV-1a of
  the name's letters as SameId compares them (A to Z as a to z), and a
  chain through the entries of a name, the last first, as the walks from
  the end found them. }
function NameHash(const S: string): Int64;
var
  i: SizeInt;
  c: Char;
begin
  Result := 2166136261;
  for i := 1 to Length(S) do
  begin
    c := S[i];
    if (c >= 'A') and (c <= 'Z') then
      c := Char(Ord(c) + 32);
    Result := ((Result xor Int64(Ord(c))) * 16777619) and 4294967295;
  end;
end;

function NameEq(const A, B: string): Boolean;
var
  i: SizeInt;
  ca, cb: Char;
begin
  Result := False;
  if Length(A) <> Length(B) then
    Exit;
  for i := 1 to Length(A) do
  begin
    ca := A[i];
    cb := B[i];
    if (ca >= 'A') and (ca <= 'Z') then
      ca := Char(Ord(ca) + 32);
    if (cb >= 'A') and (cb <= 'Z') then
      cb := Char(Ord(cb) + 32);
    if ca <> cb then
      Exit;
  end;
  Result := True;
end;

{ The slot of S in T, or the empty one where it would go. }
function NameSlot(const T: TNameHead; const S: string): SizeInt;
var
  m: SizeInt;
begin
  m := Length(T.Keys);
  Result := SizeInt(NameHash(S) and Int64(m - 1));
  while (T.Vals[Result] <> -2) and not NameEq(T.Keys[Result], S) do
    Result := (Result + 1) and (m - 1);
end;

{ The last entry of the name S, -1 none. }
function NameGet(const T: TNameHead; const S: string): LongInt;
var
  k: SizeInt;
begin
  Result := -1;
  if Length(T.Keys) = 0 then
    Exit;
  k := NameSlot(T, S);
  if T.Vals[k] <> -2 then
    Result := T.Vals[k];
end;

procedure NameSet(var T: TNameHead; const S: string; V: LongInt);
var
  k, i, m: SizeInt;
  ok: TStrArray;
  ov: array of LongInt;
begin
  if 2 * (T.Used + 1) > Length(T.Keys) then
  begin
    ok := T.Keys;
    ov := T.Vals;
    m := 64;
    while m < 4 * (T.Used + 1) do
      m := m * 2;
    T.Keys := nil;
    T.Vals := nil;
    SetLength(T.Keys, m);
    SetLength(T.Vals, m);
    for i := 0 to m - 1 do
      T.Vals[i] := -2;
    T.Used := 0;
    for i := 0 to High(ok) do
      if ov[i] <> -2 then
      begin
        k := NameSlot(T, ok[i]);
        T.Keys[k] := ok[i];
        T.Vals[k] := ov[i];
        Inc(T.Used);
      end;
  end;
  k := NameSlot(T, S);
  if T.Vals[k] = -2 then
  begin
    T.Keys[k] := S;
    Inc(T.Used);
  end;
  T.Vals[k] := V;
end;

procedure NameClear(var T: TNameHead);
begin
  T.Keys := nil;
  T.Vals := nil;
  T.Used := 0;
end;

{ Constant I goes on its name's chain. }
procedure TParser.ConstChainAdd(I: SizeInt);
begin
  FConsts[I].Prev := NameGet(FConstHead, FConsts[I].Name);
  NameSet(FConstHead, FConsts[I].Name, LongInt(I));
end;

{ The constants from N on leave their chains, the last first. }
procedure TParser.ConstChainDrop(N: SizeInt);
var
  i: SizeInt;
begin
  for i := High(FConsts) downto N do
    NameSet(FConstHead, FConsts[i].Name, FConsts[i].Prev);
end;

procedure TParser.ProcChainAdd(I: SizeInt);
begin
  FProcs[I].Prev := NameGet(FProcHead, FProcs[I].Name);
  NameSet(FProcHead, FProcs[I].Name, LongInt(I));
end;

procedure TParser.ProcChainDrop(N: SizeInt);
var
  i: SizeInt;
begin
  for i := High(FProcs) downto N do
    NameSet(FProcHead, FProcs[i].Name, FProcs[i].Prev);
end;

{ After names were changed in place (HideUnitNames): every chain again. }
procedure TParser.ChainsRebuild;
var
  i: SizeInt;
begin
  NameClear(FConstHead);
  for i := 0 to High(FConsts) do
    ConstChainAdd(i);
  NameClear(FProcHead);
  for i := 0 to High(FProcs) do
    ProcChainAdd(i);
end;

function TParser.SameId(const A, B: string): Boolean;
var
  i: SizeInt;
  ca, cb: Char;
begin
  Result := False;
  if Length(A) <> Length(B) then
    Exit;
  for i := 1 to Length(A) do
  begin
    ca := A[i];
    cb := B[i];
    if (ca >= 'A') and (ca <= 'Z') then
      ca := Char(Ord(ca) + 32);
    if (cb >= 'A') and (cb <= 'Z') then
      cb := Char(Ord(cb) + 32);
    if ca <> cb then
      Exit;
  end;
  Result := True;
end;

function TParser.TypeOf(Id: LongInt): TTypeDef;
begin
  if (Id < 0) or (Id > High(FTypes)) then
    Refuse('an unknown type, an error of the compiler itself');
  Result := FTypes[Id];
end;

function TParser.ClassAbstract(Id: LongInt): Boolean;
var
  st: TTypeDef;
  i: SizeInt;
begin
  Result := False;
  st := TypeOf(Id);
  if st.Kind <> tykClass then
    Exit;
  for i := 0 to High(st.Meths) do
    if st.Meths[i].IsAbs then
    begin
      Result := True;
      Exit;
    end;
end;

function TParser.IsStrTyp(Id: LongInt): Boolean;
begin
  Result := TypeOf(Id).Kind = tykString;
end;

function TParser.IsDynTyp(Id: LongInt): Boolean;
begin
  Result := (TypeOf(Id).Kind = tykArray) and (TypeOf(Id).Hi < TypeOf(Id).Lo);
end;

function TParser.IsFatTyp(Id: LongInt): Boolean;
begin
  Result := IsStrTyp(Id) or IsDynTyp(Id) or (TypeOf(Id).Kind = tykMethod) or
    (TypeOf(Id).Kind = tykInterface) or (TypeOf(Id).Kind = tykQuad) or
    (TypeOf(Id).Kind = tykProc);
end;

function TParser.IsBlobTyp(Id: LongInt): Boolean;
begin
  Result := (TypeOf(Id).Kind = tykRecord) or
    ((TypeOf(Id).Kind = tykArray) and (TypeOf(Id).Hi >= TypeOf(Id).Lo)) or IsWideSet(Id);
end;

{ Does a value of type Id hold a pointer the collector must see: a
  string, pointer, class, channel, map, interface, method value or
  dynamic array, or an array or record with one inside. }
function TParser.TypHasPtr(Id, Depth: LongInt): Boolean;
var
  st: TTypeDef;
  i: SizeInt;
begin
  Result := False;
  if (Id < 0) or (Depth > 32) then
    Exit;
  st := TypeOf(Id);
  case st.Kind of
    tykString, tykPointer, tykClass, tykChan, tykMap, tykTree, tykHeap, tykStore,
    tykJson, tykInterface, tykMethod, tykProc,
    tykGeneric, tykParam:
      Result := True;
    tykArray:
      if st.Hi < st.Lo then
        Result := True
      else
        Result := TypHasPtr(st.Elem, Depth + 1);
    tykRecord:
      for i := 0 to High(st.Fields) do
        if TypHasPtr(st.Fields[i].Typ, Depth + 1) then
        begin
          Result := True;
          Exit;
        end;
  end;
end;

{ Where a field of type T goes when the fields before end at Off: a
  field that holds a pointer starts on a word, since the collector
  reads words (1.0.58). After array[0..9] of Char a pointer sat at
  offset 10, where neither a type's bits nor a word-by-word scan could
  find it, so its block was taken while in use. }
{ A field's place: at its natural alignment (P99, 1.0.91; every field
  took a word), and on a word when it holds a pointer, so the collector's
  maps stay as they are. }
function TParser.FieldAt(Off, T: LongInt): LongInt;
var
  a: LongInt;
begin
  if TypHasPtr(T, 0) then
    a := 8
  else
    a := AlignOf(T);
  Result := (Off + a - 1) and (-a);
end;

{ The alignment of a value of type T: its size up to a word; a record's
  is its most aligned field's, a static array's its element's, and
  anything that holds a pointer's a word. }
function TParser.AlignOf(T: LongInt): LongInt;
var
  i: SizeInt;
  a: LongInt;
  td: TTypeDef;
begin
  td := TypeOf(T);
  { A Quad lies on 16, as C's _Float128 does (1.0.115); a V128 and a V256
    too, as __m128i and the NEON registers' memory do (1.0.125). }
  if (td.Kind = tykQuad) or (T = TyV128) or (T = TyV256) then
  begin
    Result := 16;
    Exit;
  end;
  if (td.Kind = tykClass) or TypHasPtr(T, 0) then
  begin
    Result := 8;
    Exit;
  end;
  if td.Kind = tykRecord then
  begin
    Result := 1;
    for i := 0 to High(td.Fields) do
    begin
      a := AlignOf(td.Fields[i].Typ);
      if a > Result then
        Result := a;
    end;
    Exit;
  end;
  if (td.Kind = tykArray) and (td.Hi >= td.Lo) then
  begin
    Result := AlignOf(td.Elem);
    Exit;
  end;
  if td.Size >= 8 then
    Result := 8
  else if td.Size >= 4 then
    Result := 4
  else if td.Size >= 2 then
    Result := 2
  else
    Result := 1;
end;

{ The size of a record or instance whose fields end at Off: rounded to
  its most aligned field, so an array of it keeps every field aligned
  (a pointer on a word). }
function TParser.RecEnd(const Td: TTypeDef; Off: LongInt): LongInt;
var
  i: SizeInt;
  a, m: LongInt;
begin
  m := 1;
  for i := 0 to High(Td.Fields) do
  begin
    if TypHasPtr(Td.Fields[i].Typ, 0) then
      a := 8
    else
      a := AlignOf(Td.Fields[i].Typ);
    if a > m then
      m := a;
  end;
  Result := (Off + m - 1) and (-m);
end;

function TParser.ValSize(Id: LongInt): LongInt;
begin
  if TypeOf(Id).Kind = tykClass then
    Result := 8
  else
    Result := TypeOf(Id).Size;
end;

{ Go's current go/types/scope.go keeps ownership separate from the
  type denoted by an alias. Pascal's member namespaces do the same:
  TOuter.TNumber belongs to TOuter even when it denotes Integer. }
function TParser.MemberContext: LongInt;
begin
  Result := FMemberScope;
  if Result <> 0 then Exit;
  if FHelperTyp <> 0 then Result := FHelperTyp
  else Result := FClassTyp;
end;

function TParser.ScopedIndex(T: LongInt; const N: string; out Owner: LongInt): SizeInt;
var
  h, cur: LongInt;
  i: SizeInt;
begin
  Result := -1;
  Owner := 0;
  if T <= 0 then Exit;
  { A helper's own names hide those of its target, as its methods do. }
  if FTypes[T].Kind = tykHelper then h := T
  else h := HelperFor(T);
  while h > 0 do
  begin
    for i := 0 to High(FTypes[h].Nested) do
      if SameId(FTypes[h].Nested[i].Name, N) then
      begin Owner := h; Result := i; Exit end;
    h := FTypes[h].Parent;
  end;
  cur := T;
  if FTypes[cur].Kind = tykHelper then cur := FTypes[cur].Elem;
  while cur > 0 do
  begin
    for i := 0 to High(FTypes[cur].Nested) do
      if SameId(FTypes[cur].Nested[i].Name, N) then
      begin Owner := cur; Result := i; Exit end;
    if FTypes[cur].Kind <> tykClass then Break;
    cur := FTypes[cur].Parent;
  end;
end;

function TParser.ContextIndex(const N: string; out Owner: LongInt): SizeInt;
var
  cur: LongInt;
begin
  cur := MemberContext;
  Result := -1;
  Owner := 0;
  while cur > 0 do
  begin
    Result := ScopedIndex(cur, N, Owner);
    if Result >= 0 then Exit;
    cur := FTypes[cur].ScopeOwner;
  end;
end;

procedure TParser.ScopedVis(Owner: LongInt; I: SizeInt);
var
  cur: LongInt;
  v: Byte;
  ok: Boolean;
  what: string;
begin
  v := FTypes[Owner].Nested[I].Vis;
  if v = VisPublic then Exit;
  ok := False;
  cur := MemberContext;
  while cur > 0 do
  begin
    if SameTyp(cur, Owner) then ok := True;
    if (v = VisProtected) or (v = VisStrictProtected) then
      if (FTypes[cur].Kind = tykClass) and ClassUnder(cur, Owner) then ok := True;
    cur := FTypes[cur].ScopeOwner;
  end;
  if ((v = VisPrivate) or (v = VisProtected)) and not FTypes[Owner].Imported then ok := True;
  if v = VisPrivate then what := 'private'
  else if v = VisProtected then what := 'protected'
  else if v = VisStrictProtected then what := 'strict protected'
  else what := 'strict private';
  if not ok then
    Refuse(FTypes[Owner].Nested[I].Name + ' is ' + what + ' to ' +
      FTypes[Owner].Name + HerePos);
end;

function TParser.DeclMemberName(const N: string): string;
begin
  Result := N;
  if FMemberScope > 0 then Result := FTypes[FMemberScope].Name + '.' + N;
end;

procedure TParser.AddScoped(const Full: string; T: LongInt; Kind: Byte; const Ref: string);
var
  prefix, leaf: string;
  i, n: SizeInt;
begin
  if FMemberScope = 0 then Exit;
  prefix := FTypes[FMemberScope].Name + '.';
  if not SameId(Copy(Full, 1, Length(prefix)), prefix) then Exit;
  leaf := Copy(Full, Length(prefix) + 1, Length(Full) - Length(prefix));
  if Pos('.', leaf) > 0 then Exit;
  for i := 0 to High(FTypes[FMemberScope].Nested) do
    if SameId(FTypes[FMemberScope].Nested[i].Name, leaf) then
    begin
      { A forward class/interface is completed with the same identity. }
      if (Kind = 0) and (FTypes[FMemberScope].Nested[i].Kind = 0) and
        (FTypes[FMemberScope].Nested[i].Typ = T) then Exit;
      Refuse('duplicate member ' + leaf + ' of ' + FTypes[FMemberScope].Name + DupAt);
    end;
  n := Length(FTypes[FMemberScope].Nested);
  SetLength(FTypes[FMemberScope].Nested, n + 1);
  FTypes[FMemberScope].Nested[n].Name := leaf;
  FTypes[FMemberScope].Nested[n].Typ := T;
  FTypes[FMemberScope].Nested[n].Kind := Kind;
  FTypes[FMemberScope].Nested[n].Vis := FMemberVis;
  FTypes[FMemberScope].Nested[n].Ref := Ref;
end;

procedure TParser.ParseMemberSection(T: LongInt; Vis: Byte; const Members: TTypeDef);
var
  save: Byte;
begin
  save := FMemberVis;
  FMemberVis := Vis;
  if FTok.Kind = tkConst then ParseConstSection else ParseTypeSection;
  CheckScopeMembers(T, Members);
  FMemberVis := save;
end;

{ Check both declaration orders against the same namespace. A later
  field or method must not silently hide an earlier type or constant. }
procedure TParser.CheckScopeMembers(T: LongInt; const Members: TTypeDef);
var
  i, j: SizeInt;
  nm: string;
begin
  for i := 0 to High(FTypes[T].Nested) do
  begin
    nm := FTypes[T].Nested[i].Name;
    for j := 0 to High(Members.Fields) do
      if SameId(Members.Fields[j].Name, nm) then Refuse(nm + ' is a field already' + HerePos);
    for j := 0 to High(Members.CVars) do
      if SameId(Members.CVars[j].Name, nm) then Refuse(nm + ' is a class variable already' + HerePos);
    for j := 0 to High(Members.Meths) do
      if SameId(Members.Meths[j].Name, nm) then Refuse(nm + ' is a method already' + HerePos);
    for j := 0 to High(Members.Props) do
      if SameId(Members.Props[j].Name, nm) then Refuse(nm + ' is a property already' + PlaceOr(Members.Props[j].At));
  end;
end;

function TParser.ConstRefIndex(const N: string): SizeInt;
var
  own: string;
begin
  Result := High(FConsts);
  own := N;
  if FUnitName <> '' then
    if SameId(Copy(N, 1, Length(FUnitName) + 1), FUnitName + '.') then
      own := Copy(N, Length(FUnitName) + 2, Length(N) - Length(FUnitName) - 1);
  while Result >= 0 do
  begin
    if SameId(FConsts[Result].Name, N) or SameId(FConsts[Result].Name, own) then Exit;
    Dec(Result);
  end;
end;

function TParser.ConstExpr(I: SizeInt): PExpr;
begin
  if IsWideSet(FConsts[I].Typ) then Result := SetFromImage(FConsts[I].Txt, FConsts[I].Typ)
  else if FConsts[I].Typ = TyString then Result := NewStr(FConsts[I].Txt)
  else if FConsts[I].Typ = TyReal then
  begin
    Result := NewReal(FConsts[I].Value);
    Result^.Flags := 1;
    Result^.Txt := FConsts[I].Txt;
    if FConsts[I].HasQ then
    begin
      Result^.Flags := 3;
      Result^.QLo := FConsts[I].QLo;
      Result^.Hi := FConsts[I].QHi;
    end;
  end
  else
  begin
    Result := NewInt(FConsts[I].Value);
    Result^.Typ := FConsts[I].Typ;
    Result^.Flags := 1;
    if TypeOf(Result^.Typ).Kind = tykCurrency then Result^.Flags := 0;
  end;
end;

function TParser.ScopedValue(T: LongInt; const N: string; out E: PExpr): Boolean;
var
  owner: LongInt;
  i, ci: SizeInt;
begin
  Result := False;
  E := nil;
  i := ScopedIndex(T, N, owner);
  if i < 0 then Exit;
  if FTypes[owner].Nested[i].Kind = 0 then Exit;
  ScopedVis(owner, i);
  if FTypes[owner].Nested[i].Kind = 2 then
    E := NewVar(FTypes[owner].Nested[i].Ref, FTypes[owner].Nested[i].Typ)
  else
  begin
    ci := ConstRefIndex(FTypes[owner].Nested[i].Ref);
    if ci < 0 then Refuse('missing member constant ' + FTypes[owner].Nested[i].Ref);
    E := ConstExpr(ci);
  end;
  Result := True;
end;

function TParser.NamedType(const AName: string; out Id: LongInt): Boolean;
var
  i: SizeInt;
  owner: LongInt;
  prefix, leaf: string;
  v: Int64;
begin
  Result := False;
  Id := TyNone;
  { the type the compiler names by its number in the text it writes (P205) }
  if FGenMode and (Copy(AName, 1, 6) = 'json.t') and
    StrToInt64(Copy(AName, 7, Length(AName) - 6), v) then
  begin
    Id := LongInt(v);
    Result := True;
    Exit;
  end;
  i := Length(AName);
  while (i > 0) and (AName[i] <> '.') do Dec(i);
  if i > 0 then
  begin
    prefix := Copy(AName, 1, i - 1);
    leaf := Copy(AName, i + 1, Length(AName) - i);
    if NamedType(prefix, owner) then
    begin
      i := ScopedIndex(owner, leaf, owner);
      if (i >= 0) and (FTypes[owner].Nested[i].Kind = 0) then
      begin
        ScopedVis(owner, i);
        Id := FTypes[owner].Nested[i].Typ;
        Result := True;
      end;
      Exit;
    end;
  end
  else if not HiddenAbove(AName, 0) then
  begin
    { A generic's temporary type parameter is its innermost binding,
      even when an enclosing member type has the same spelling. }
    for i := High(FTypeNames) downto 0 do
      if SameId(FTypeNames[i].Name, AName) and
        (FTypes[FTypeNames[i].Id].Kind = tykParam) then
      begin Id := FTypeNames[i].Id; Result := True; Exit end;
    i := ContextIndex(AName, owner);
    if i >= 0 then
    begin
      if FTypes[owner].Nested[i].Kind = 0 then
      begin
        ScopedVis(owner, i);
        Id := FTypes[owner].Nested[i].Typ;
        Result := True;
      end;
      Exit;
    end;
  end;
  { the innermost first: a routine's type hides the program's (P137),
    and a deeper name of any kind the type (P158, P159) }
  for i := High(FTypeNames) downto 0 do
    if SameId(FTypeNames[i].Name, AName) and not HiddenAbove(AName, FTypeNames[i].Nest) then
    begin
      Id := FTypeNames[i].Id;
      Result := True;
      Exit;
    end;
  { The integer names TYPES.md lists (P88, 1.0.72). From P99 (1.0.87)
    each row of narrow ones is a type of its own; the names of a row are
    the same type. }
  if SameId(AName, 'Integer') or SameId(AName, 'SizeInt') or
    SameId(AName, 'LongInt') or SameId(AName, 'NativeInt') or
    SameId(AName, 'PtrInt') or SameId(AName, 'Int64') or
    SameId(AName, 'Cardinal') or SameId(AName, 'QWord') or
    SameId(AName, 'UInt64') or SameId(AName, 'Rune') then
  begin
    Id := TyInteger;
    Result := True;
  end
  else if SameId(AName, 'Byte') or SameId(AName, 'UInt8') then
  begin
    Id := TyByte;
    Result := True;
  end
  else if SameId(AName, 'Int8') or SameId(AName, 'ShortInt') then
  begin
    Id := TyInt8;
    Result := True;
  end
  else if SameId(AName, 'Word') or SameId(AName, 'UInt16') then
  begin
    Id := TyWord;
    Result := True;
  end
  else if SameId(AName, 'Int16') or SameId(AName, 'SmallInt') then
  begin
    Id := TyInt16;
    Result := True;
  end
  else if SameId(AName, 'UInt32') or SameId(AName, 'LongWord') or
    SameId(AName, 'DWord') then
  begin
    Id := TyUInt32;
    Result := True;
  end
  else if SameId(AName, 'Int32') then
  begin
    Id := TyInt32;
    Result := True;
  end
  else if SameId(AName, 'Char') or SameId(AName, 'AnsiChar') then
  begin
    Id := TyChar;
    Result := True;
  end
  else if SameId(AName, 'Boolean') then
  begin
    Id := TyBoolean;
    Result := True;
  end
  else if SameId(AName, 'Real') or SameId(AName, 'Double') or SameId(AName, 'Extended') then
  begin
    { Extended is Double, as in Free Pascal on arm64 and Win64 (P145) }
    Id := TyReal;
    Result := True;
  end
  else if SameId(AName, 'Single') then
  begin
    { IEEE binary32 (P101): it was binary64 under another name. }
    Id := TySingle;
    Result := True;
  end
  else if SameId(AName, 'Currency') then
  begin
    Id := TyCurrency;
    Result := True;
  end
  else if SameId(AName, 'V128') then
  begin
    Id := TyV128;
    Result := True;
  end
  else if SameId(AName, 'V256') then
  begin
    Id := TyV256;
    Result := True;
  end
  else if SameId(AName, 'Quad') then
  begin
    { IEEE binary128 in software (P103). }
    Id := TyQuad;
    Result := True;
  end
  else if SameId(AName, 'PChar') then
  begin
    Id := InternPtr(TyChar);
    Result := True;
  end
  else if SameId(AName, 'Pointer') then
  begin
    { An address and nothing more (P102): it was ^Integer. Its target
      has a type only through a view, T(p^) or PT(p)^. }
    Id := TyPointer;
    Result := True;
  end
  else
    Result := PtrName(AName, Id);
end;

{ The bytes one step of a pointer of type T covers (P102): its target's
  size, 1 for an untyped Pointer. }
function TParser.PtrStep(T: LongInt): Int64;
var
  e: LongInt;
begin
  Result := 1;
  e := TypeOf(T).Elem;
  if (e = TyNone) or (e <= 0) then
    Exit;
  Result := TypeOf(e).Size;
  if Result <= 0 then
    Result := 1;
end;

{ N steps of a pointer of type T, in bytes. }
function TParser.PtrScale(N: PExpr; T: LongInt): PExpr;
var
  esz: Int64;
begin
  if IsIntId(N^.Typ) then
    Stamp(N, TyInteger);
  Result := N;
  esz := PtrStep(T);
  if esz = 1 then
    Exit;
  if N^.Kind = ekInt then
    Result := NewInt(N^.Num * esz)
  else
  begin
    Result := NewBin(boMul, N, NewInt(esz));
    Result^.Typ := TyInteger;
  end;
end;

{ Pointer arithmetic (P102), scaled by the size of what the pointer
  sees: p + n and p - n are pointers of p's type n elements on (a
  Pointer's in bytes), q - r the distance in elements of two pointers of
  one type. It added bytes to an Integer. }
function TParser.PtrArith(Op: TBinOp; L, R: PExpr; out Res: PExpr): Boolean;
var
  lp, rp: Boolean;
  p, n: PExpr;
  esz: Int64;
begin
  Result := False;
  Res := nil;
  lp := TypeOf(L^.Typ).Kind = tykPointer;
  rp := TypeOf(R^.Typ).Kind = tykPointer;
  if not (lp or rp) then
    Exit;
  NotSafeAt('do pointer arithmetic', PosOf(L));
  if lp and rp then
  begin
    if Op <> boSub then
      Refuse('two pointers do not add' + PosOf(L));
    if L^.Typ <> R^.Typ then
      Refuse('pointers of two types: see both through one view, PT(p) - PT(q)' + PosOf(L));
    esz := PtrStep(L^.Typ);
    Res := NewBin(boSub, L, R);
    Res^.Typ := TyInteger;
    if esz <> 1 then
    begin
      Res := NewBin(boDiv, Res, NewInt(esz));
      Res^.Typ := TyInteger;
    end;
    Result := True;
    Exit;
  end;
  if lp then
  begin
    p := L;
    n := R;
  end
  else
  begin
    if Op = boSub then
      Refuse('an integer minus a pointer' + PosOf(L));
    p := R;
    n := L;
  end;
  if not IntOperand(n) then
    Exit;
  Res := NewBin(Op, p, PtrScale(n, p^.Typ));
  Res^.Typ := p^.Typ;
  Result := True;
end;

{ In safe code (P102) raw pointer work is an error: arithmetic, views,
  conversions between pointer types, Pointer(n), an untyped p^, p[i]. }
procedure TParser.NotSafe(const What: string);
begin
  NotSafeAt(What, HerePos);
end;

{ NotSafe, refused at At, the construct that does it (P340). }
procedure TParser.NotSafeAt(const What, At: string);
begin
  if FSafe then
    Refuse('safe code does not ' + What + At);
end;

{ A variable of the routine's or the program's own (P104): a local that
  is not a parameter or Result, or a global. A var parameter may be one
  element of a bigger array, and an outer routine's may too. }
function TParser.OwnVar(const N: string): Boolean;
var
  i, s: SizeInt;
begin
  Result := False;
  if FIsFunc and (SameId(N, 'result') or SameId(N, FFuncName)) then
    Exit;
  for i := 0 to High(FLocals) do
    if SameId(FLocals[i].Name, N) or ((FLocals[i].Sym <> '') and SameId(FLocals[i].Sym, N)) then
    begin
      Result := i >= FParamN;
      Exit;
    end;
  for s := 0 to High(FScopes) do
    for i := 0 to High(FScopes[s]) do
      if SameId(FScopes[s][i].Name, N) then
        Exit;
  for i := 0 to High(FVars) do
    if SameId(FVars[i].Name, N) or ((FVars[i].Sym <> '') and SameId(FVars[i].Sym, N)) then
    begin
      Result := True;
      Exit;
    end;
end;

{ The object E is in when the code says so (P104): a variable of its own
  that holds its value (not a string, a dynamic array or a class, whose
  value is elsewhere), a field or a constant element of one, or what a
  pointer KnownObj knows points at. Off is E's first byte in it, Size
  its bytes. }
function TParser.ObjAt(E: PExpr; out Obj: string; out Size, Off: Int64): Boolean;
var
  st: TTypeDef;
begin
  Result := False;
  Obj := '';
  Size := 0;
  Off := 0;
  if E = nil then
    Exit;
  if E^.Kind = ekVar then
  begin
    st := TypeOf(E^.Typ);
    if not ((st.Kind = tykInteger) or (st.Kind = tykReal) or (st.Kind = tykBoolean) or
      (st.Kind = tykEnum) or (st.Kind = tykSubrange) or
      (st.Kind = tykRecord) or (st.Kind = tykPointer) or
      ((st.Kind = tykArray) and not IsDynTyp(E^.Typ))) then
      Exit;
    if not OwnVar(E^.Name) then
      Exit;
    Obj := E^.Name;
    Size := st.Size;
    Result := Size > 0;
  end
  else if E^.Kind = ekField then
  begin
    if (E^.L = nil) or (TypeOf(E^.L^.Typ).Kind <> tykRecord) then
      Exit;
    Result := ObjAt(E^.L, Obj, Size, Off);
    Off := Off + E^.Off;
  end
  else if E^.Kind = ekIndex then
  begin
    if (E^.L = nil) or (E^.R = nil) or (E^.R^.Kind <> ekInt) then
      Exit;
    st := TypeOf(E^.L^.Typ);
    if (st.Kind = tykArray) and (st.Hi >= st.Lo) and not IsDynTyp(E^.L^.Typ) then
    begin
      Result := ObjAt(E^.L, Obj, Size, Off);
      Off := Off + (E^.R^.Num - st.Lo) * ValSize(st.Elem);
    end
    else if st.Kind = tykPointer then
    begin
      Result := KnownObj(E^.L, Obj, Size, Off);
      Off := Off + E^.R^.Num * PtrStep(E^.L^.Typ);
    end;
  end
  else if E^.Kind = ekDeref then
    Result := KnownObj(E^.L, Obj, Size, Off);
end;

{ The object pointer E points into when the expression says so (P104):
  @v of what ObjAt knows, moved on a constant number of bytes. }
function TParser.KnownObj(E: PExpr; out Obj: string; out Size, Off: Int64): Boolean;
begin
  Result := False;
  Obj := '';
  Size := 0;
  Off := 0;
  if E = nil then
    Exit;
  if E^.Kind = ekAddr then
    Result := ObjAt(E^.L, Obj, Size, Off)
  else if (E^.Kind = ekBin) and ((E^.Bin = boAdd) or (E^.Bin = boSub)) and
    (TypeOf(E^.Typ).Kind = tykPointer) and (E^.R <> nil) and (E^.R^.Kind = ekInt) then
  begin
    Result := KnownObj(E^.L, Obj, Size, Off);
    if E^.Bin = boAdd then
      Off := Off + E^.R^.Num
    else
      Off := Off - E^.R^.Num;
  end;
end;

{ An access of N bytes at P + Extra (P104). Where the code says which
  object P is in and how far on, bytes outside it are an error when
  compiling, with or without -checkptr. A step alone never is. }
procedure TParser.CheckReach(P: PExpr; Extra, N: Int64);
var
  obj: string;
  size, off: Int64;
  i: SizeInt;
begin
  if (N <= 0) or not KnownObj(P, obj, size, off) then
    Exit;
  off := off + Extra;
  if (off >= 0) and (off + N <= size) then
    Exit;
  i := Length(obj);
  while (i > 0) and (obj[i] <> '.') do
    Dec(i);
  obj := Copy(obj, i + 1, Length(obj) - i);
  if size = 1 then
    obj := obj + ' has 1 byte'
  else
    obj := obj + ' has ' + IntToStr(size) + ' bytes';
  Refuse('pointer outside its object: ' + obj + ' and this reaches bytes ' +
    IntToStr(off) + ' to ' + IntToStr(off + N - 1) + PosOf(P));
end;

{ The predefined pointer types (P102), each ^ of its row's type. }
function TParser.PtrName(const AName: string; out Id: LongInt): Boolean;
var
  e: LongInt;
  n: string;
begin
  Result := False;
  Id := TyNone;
  n := ToLower(AName);
  if (n = 'pbyte') or (n = 'puint8') then
    e := TyByte
  else if (n = 'pint8') or (n = 'pshortint') then
    e := TyInt8
  else if (n = 'pword') or (n = 'puint16') then
    e := TyWord
  else if (n = 'pint16') or (n = 'psmallint') then
    e := TyInt16
  else if (n = 'pdword') or (n = 'plongword') or (n = 'puint32') then
    e := TyUInt32
  else if n = 'pint32' then
    e := TyInt32
  else if (n = 'pinteger') or (n = 'pint64') then
    e := TyInteger
  else if n = 'psingle' then
    e := TySingle
  else if n = 'pdouble' then
    e := TyReal
  else if n = 'pquad' then
    e := TyQuad
  else if n = 'pboolean' then
    e := TyBoolean
  else if n = 'ppointer' then
    e := TyPointer
  else
    Exit;
  Id := InternPtr(e);
  Result := True;
end;

{ p^ of an untyped Pointer reaches Move and FillChar, which take any
  place, and a view T(p^); anywhere else its target has no type. }
procedure TParser.CheckTyped(E: PExpr);
begin
  if (E <> nil) and (E^.Kind = ekDeref) and (E^.Typ = TyNone) then
    Refuse('the target of an untyped Pointer needs a type: T(p^) or PT(p)^' + PosOf(E));
end;

function TParser.InternMethod: LongInt;
var
  i, n: SizeInt;
begin
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykMethod) and (Length(FTypes[i].Meths) = 0) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykMethod;
  FTypes[n].Size := 16;
  FTypes[n].Name := 'method';
  Result := LongInt(n);
end;

{ P325: the place given for a var or out parameter, by its address: a
  variable, a field, an element, a pointer's target, a map's or tree's
  slot or a record a call gives, what EmitAddr takes. A constant or an
  expression has none: Bump(5) reached the emitter and stopped it with
  not an address and no line. }
function TParser.VarArgOf(E: PExpr): PExpr;
begin
  if (E = nil) or not ((E^.Kind = ekVar) or (E^.Kind = ekField) or (E^.Kind = ekIndex) or
    (E^.Kind = ekDeref) or (E^.Kind = ekAddr) or
    (((E^.Kind = ekCall) or (E^.Kind = ekMethod) or (E^.Kind = ekCtor)) and
    (IsBlobTyp(E^.Typ) or (E^.Name = 'rt_mapput') or (E^.Name = 'rt_treeput')))) then
    Refuse('a var or out parameter needs a variable, not a value' + PosOf(E));
  Result := NewAddr(E);
  Result^.Flags := Result^.Flags or 16;   { a var or out argument (1.1.1) }
end;

{ P325: the arguments of a call through a value of signature M (What
  says which kind) as a direct call's: as many as its parameters, each
  converted, a var or out one by its place. The routine value's call
  took any number, and gave a var one its value: the routine wrote
  through 5. }
procedure TParser.ValArgs(const M: TMethInfo; var Args: TExprArray; const What, At: string);
var
  k: SizeInt;
begin
  { At: where the value called is (P340) }
  if Length(Args) <> M.NParams then
    Refuse('wrong number of arguments for the ' + What + At);
  CoerceArgs(M.ParamTyps, M.ByRef, Args);
  for k := 0 to High(Args) do
    if (k <= High(M.ByRef)) and M.ByRef[k] then
      Args[k] := VarArgOf(Args[k]);
end;

{ A call through a method value (1.0.135): with the signature in its
  type, the arguments as a routine's and what it gives back; a value of
  the old untyped kind takes them as they are. }
function TParser.MethValCall(E: PExpr; var Args: TExprArray): PExpr;
var
  td: TTypeDef;
begin
  td := TypeOf(E^.Typ);
  if Length(td.Meths) = 1 then
  begin
    ValArgs(td.Meths[0], Args, 'method value', PosOf(E));
    Result := NewMethod(E, '', Args, td.Meths[0].RetTyp, -3);
  end
  else
    Result := NewMethod(E, '', Args, TyNone, -3);
end;

{ A call written with no ( through a routine value, a method value or
  obj.M (1.0.135): one whose type says it takes parameters ran on
  whatever the registers held. }
procedure TParser.NoArgsCall(E: PExpr);
var
  td: TTypeDef;
begin
  td := TypeOf(E^.Typ);
  if ((td.Kind = tykProc) or (td.Kind = tykMethod)) and (Length(td.Meths) = 1) and
    (td.Meths[0].NParams > 0) then
    Refuse('this routine takes ' + IntToStr(td.Meths[0].NParams) +
      ' arguments and none are written' + PosOf(E));
end;

{ The arguments a call of M must give: those before the first with a
  default (P125). }
function MinArgs(const M: TMethInfo): LongInt;
var
  i: LongInt;
begin
  Result := M.NParams;
  for i := M.NParams - 1 downto 0 do
    if (i <= High(M.HasDef)) and M.HasDef[i] then
      Result := i
    else
      Exit;
end;

{ M takes an argument that has no default: a use of it with no ( cannot
  be a call. }
function TParser.NeedsArgs(const M: TMethInfo): Boolean;
begin
  Result := MinArgs(M) > 0;
end;

{ A method value's type with its signature (1.0.135): code and Self,
  sixteen bytes, what it takes and gives back in Meths[0], so a call
  through it knows them and function ... of object is one. Any method
  value still goes into any other. }
function TParser.InternMethodSig(IsFn: Boolean; Ret: LongInt;
  const Typs: array of LongInt; const Refs: array of Boolean): LongInt;
var
  i, j, n: SizeInt;
  same: Boolean;
begin
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykMethod) and (Length(FTypes[i].Meths) = 1) then
    begin
      same := (FTypes[i].Meths[0].IsFunc = IsFn) and
        (FTypes[i].Meths[0].RetTyp = Ret) and
        (FTypes[i].Meths[0].NParams = LongInt(Length(Typs)));
      if same then
        for j := 0 to High(Typs) do
          if (FTypes[i].Meths[0].ParamTyps[j] <> Typs[j]) or
            (FTypes[i].Meths[0].ByRef[j] <> Refs[j]) then
            same := False;
      if same then
      begin
        Result := LongInt(i);
        Exit;
      end;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykMethod;
  FTypes[n].Size := 16;
  FTypes[n].Name := 'method';
  SetLength(FTypes[n].Meths, 1);
  FTypes[n].Meths[0].Name := '';
  FTypes[n].Meths[0].Sym := '';
  FTypes[n].Meths[0].IsFunc := IsFn;
  FTypes[n].Meths[0].Slot := -1;
  FTypes[n].Meths[0].RetTyp := Ret;
  FTypes[n].Meths[0].NParams := LongInt(Length(Typs));
  SetLength(FTypes[n].Meths[0].ParamTyps, Length(Typs));
  SetLength(FTypes[n].Meths[0].ByRef, Length(Refs));
  for j := 0 to High(Typs) do
    FTypes[n].Meths[0].ParamTyps[j] := Typs[j];
  for j := 0 to High(Refs) do
    FTypes[n].Meths[0].ByRef[j] := Refs[j];
  Result := LongInt(n);
end;

{ A routine value: the address of a routine, eight bytes, with the
  signature kept in Meths[0] so a call through it knows what it takes
  and what it gives back, and so two types with the same signature are
  the same type. A method value (procedure of object) is another thing
  and stays as it was: sixteen bytes, code and Self. }
function TParser.InternProc(IsFn: Boolean; Ret: LongInt;
  const Typs: array of LongInt; const Refs: array of Boolean): LongInt;
var
  i, j, n: SizeInt;
  same: Boolean;
begin
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykProc) and (Length(FTypes[i].Meths) = 1) then
    begin
      same := (FTypes[i].Meths[0].IsFunc = IsFn) and
        (FTypes[i].Meths[0].RetTyp = Ret) and
        (FTypes[i].Meths[0].NParams = LongInt(Length(Typs)));
      if same then
        for j := 0 to High(Typs) do
          if (FTypes[i].Meths[0].ParamTyps[j] <> Typs[j]) or
            (FTypes[i].Meths[0].ByRef[j] <> Refs[j]) then
            same := False;
      if same then
      begin
        Result := LongInt(i);
        Exit;
      end;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykProc;
  { the code and an environment, 16 bytes (P109, 1.0.133): a routine's
    value has nil there, a closure its captured variables }
  FTypes[n].Size := 16;
  FTypes[n].Name := 'routine';
  SetLength(FTypes[n].Meths, 1);
  FTypes[n].Meths[0].Name := '';
  FTypes[n].Meths[0].Sym := '';
  FTypes[n].Meths[0].IsFunc := IsFn;
  FTypes[n].Meths[0].Slot := -1;
  FTypes[n].Meths[0].RetTyp := Ret;
  FTypes[n].Meths[0].NParams := LongInt(Length(Typs));
  SetLength(FTypes[n].Meths[0].ParamTyps, Length(Typs));
  SetLength(FTypes[n].Meths[0].ByRef, Length(Refs));
  for j := 0 to High(Typs) do
    FTypes[n].Meths[0].ParamTyps[j] := Typs[j];
  for j := 0 to High(Refs) do
    FTypes[n].Meths[0].ByRef[j] := Refs[j];
  Result := LongInt(n);
end;

function TParser.InternChan(Elem: LongInt): LongInt;
var
  i, n: SizeInt;
begin
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykChan) and (FTypes[i].Elem = Elem) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykChan;
  FTypes[n].Size := 8;
  FTypes[n].Elem := Elem;
  Result := LongInt(n);
end;

function TParser.InternMap(Key, valx: LongInt): LongInt;
var
  i, n: SizeInt;
  kk: TTypeKind;
begin
  if not FCoreMap then
    Refuse('map needs the core unit pasmap (build/pasmap.pi)');
  kk := TypeOf(Key).Kind;
  if not ((kk = tykInteger) or (kk = tykBoolean) or (kk = tykString) or
    (kk = tykEnum) or (kk = tykSubrange) or (kk = tykPointer) or
    (kk = tykClass)) then
  begin
    if kk = tykJson then
      Refuse('a json is no map key: its text in RFC 8785''s form, JsonEncode(j, JsonCanonical), ' +
        'is one' + SubAt);
    Refuse('map key must be an ordinal, string or pointer type' + SubAt);
  end;
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykMap) and (FTypes[i].Elem = Key) and
      (FTypes[i].Elem2 = valx) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykMap;
  FTypes[n].Size := 8;
  FTypes[n].Elem := Key;
  FTypes[n].Elem2 := valx;
  Result := LongInt(n);
end;

function TParser.InternTree(Key, valx: LongInt): LongInt;
var
  i, n: SizeInt;
  kk: TTypeKind;
begin
  if not FCoreTree then
    Refuse('tree needs the core unit pastree (build/pastree.pi)');
  kk := TypeOf(Key).Kind;
  if not ((kk = tykInteger) or (kk = tykBoolean) or (kk = tykString) or
    (kk = tykEnum) or (kk = tykSubrange) or (kk = tykPointer) or
    (kk = tykClass)) then
  begin
    if kk = tykJson then
      Refuse('a json is no tree key: its text in RFC 8785''s form, JsonEncode(j, JsonCanonical), ' +
        'is one' + SubAt);
    Refuse('tree key must be an ordinal, string or pointer type' + SubAt);
  end;
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykTree) and (FTypes[i].Elem = Key) and
      (FTypes[i].Elem2 = valx) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykTree;
  FTypes[n].Size := 8;
  FTypes[n].Elem := Key;
  FTypes[n].Elem2 := valx;
  Result := LongInt(n);
end;

function TParser.InternHeap(Elem: LongInt): LongInt;
var
  i, n: SizeInt;
  kk: TTypeKind;
begin
  if not FCoreTree then
    Refuse('heap needs the core unit pastree (build/pastree.pi)');
  kk := TypeOf(Elem).Kind;
  if not ((kk = tykInteger) or (kk = tykBoolean) or (kk = tykString) or
    (kk = tykEnum) or (kk = tykSubrange) or (kk = tykReal)) then
  begin
    { a heap orders its elements, and json values have no order (P204) }
    if kk = tykJson then
      Refuse('a json is no heap element: json values have no order, = and <> only; ' +
        'a heap of its text, JsonEncode(j, JsonCanonical), has one' + SubAt);
    Refuse('heap element must be an ordinal, a string or a real' + SubAt);
  end;
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykHeap) and (FTypes[i].Elem = Elem) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykHeap;
  FTypes[n].Size := 8;
  FTypes[n].Elem := Elem;
  Result := LongInt(n);
end;

function TParser.InternStore: LongInt;
var
  n: SizeInt;
begin
  if FStoreTyp <> 0 then
  begin
    Result := FStoreTyp;
    Exit;
  end;
  if not FCoreTree then
    Refuse('store needs the core unit pastree (build/pastree.pi)');
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykStore;
  FTypes[n].Size := 8;
  FTypes[n].Name := 'store';
  FStoreTyp := LongInt(n);
  Result := FStoreTyp;
end;

{ json (P203): one word, the address of a value inside a document that
  never changes (pasjson), nil for null; the core unit pasjson is its
  runtime, so the type itself needs nothing loaded. }
function TParser.InternJson: LongInt;
var
  n: SizeInt;
begin
  if FJsonTyp <> 0 then
  begin
    Result := FJsonTyp;
    Exit;
  end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykJson;
  FTypes[n].Size := 8;
  FTypes[n].Name := 'json';
  FJsonTyp := LongInt(n);
  Result := FJsonTyp;
end;

{ The key of m[k], k in m, Delete(m, k) and TryGet(m, k, v) as the
  map's key type K (1.0.140): the conversion a call's argument gets
  (StrArg, then ValArg), so a Char where a string key goes becomes a
  string and 'x' where a Char key goes a Char, a constant into a Byte
  key must fit and a wider integer variable needs a conversion, as in
  b := i; then a kind that is not K's is refused. The key was taken as
  written and the emitter chose the string path by the key's own type:
  m[c] with a Char c looked the code up as an eight-byte key and found
  nothing, TryGet(m, c, v) read the code as a string's words and
  crashed, and m[3] on a map of string keys compiled. }
function TParser.MapKeyArg(M, Key: PExpr): PExpr;
var
  k: LongInt;
  kk, ek: TTypeKind;
  ok: Boolean;
begin
  k := TypeOf(M^.Typ).Elem;
  CheckTyped(Key);
  Result := StrArg(k, Key);
  kk := TypeOf(k).Kind;
  ek := TypeOf(Result^.Typ).Kind;
  if (Result^.Typ = k) or SameTyp(Result^.Typ, k) then
    ok := True
  else if kk = tykString then
    ok := IsStrTyp(Result^.Typ)
  else if (kk = tykPointer) or (kk = tykClass) then
    ok := (Result^.Kind = ekNil) or (ek = tykPointer) or (ek = tykClass)
  else if kk = tykBoolean then
    ok := ek = tykBoolean
  else
    { an ordinal: an integer of any width (a Char is one), an
      enumeration or a subrange of its kind; ValArg checks the constant
      and the width }
    ok := (ek = tykInteger) or (ek = tykSubrange) or ((ek = tykEnum) and (kk = tykEnum));
  if not ok then
  begin
    if TypeOf(M^.Typ).Kind = tykHeap then
      Refuse(TypName(Key^.Typ) + ' does not go into ' + TypName(k) + ', the elements of ' +
        TypName(M^.Typ) + PosOf(Key));
    Refuse(TypName(Key^.Typ) + ' does not go into ' + TypName(k) + ', the key of ' +
      TypName(M^.Typ) + PosOf(Key));
  end;
  Result := ValArg(k, Result);
end;

function TParser.InternPtr(Elem: LongInt): LongInt;
var
  i, n: SizeInt;
begin
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykPointer) and (FTypes[i].Elem = Elem) and
      not PendingSlot(LongInt(i)) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykPointer;
  FTypes[n].Size := 8;
  FTypes[n].Elem := Elem;
  Result := LongInt(n);
end;

{ class of Cls (P123): one type for each class, as a pointer type is. }
function TParser.InternClassRef(Cls: LongInt): LongInt;
var
  i, n: SizeInt;
begin
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykClassRef) and (FTypes[i].Elem = Cls) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykClassRef;
  FTypes[n].Size := 8;
  FTypes[n].Elem := Cls;
  Result := LongInt(n);
end;

{ The class Cls as a value (P123): the address of its method table, of
  type class of Cls. }
function TParser.ClassValue(Cls: LongInt): PExpr;
begin
  Result := NewCall('rt_classref', nil, InternClassRef(Cls));
  Result^.Txt := 'vmt_' + TypeStemOf(TypeOf(Cls));
end;

{ array of const (P124): a slice of TVarRec, marked, one type. }
function TParser.InternConstArr: LongInt;
var
  i, n: SizeInt;
  vr: LongInt;
begin
  if (not NamedType('TVarRec', vr)) or (TypeOf(vr).Kind <> tykRecord) then
    Refuse('array of const needs TVarRec, which pasobject brings' + HerePos);
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykArray) and (FTypes[i].Elem2 = ConstArrMark) and
      (FTypes[i].Elem = vr) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykArray;
  FTypes[n].Elem := vr;
  FTypes[n].Elem2 := ConstArrMark;
  FTypes[n].Lo := 0;
  FTypes[n].Hi := -1;
  FTypes[n].Size := 24;
  Result := LongInt(n);
end;

function TParser.IsConstArr(T: LongInt): Boolean;
begin
  Result := (TypeOf(T).Kind = tykArray) and (TypeOf(T).Elem2 = ConstArrMark);
end;

{ A parameter's type, where array of const may go, given and never a
  var or out parameter (P124). }
function TParser.ParamType(ByRef: Boolean): LongInt;
var
  was: Boolean;
  at: string;
begin
  was := FParamType;
  FParamType := True;
  at := HerePos;
  Result := Self.ParseType;
  FParamType := was;
  { refused where the type starts (P340) }
  if ByRef and IsConstArr(Result) then
    Refuse('an array of const is given to a routine, not a var or out parameter' + at);
end;

{ The list [a, b, ...] where an array of const goes (P124): each value
  with its kind, in a TVarRec of the caller's frame, which the emitter
  fills (rt_constarr); the kinds in Str, one byte each, and the frame's
  array type in Num. An integer of any width is a 64-bit vtInteger, a
  Single a Double (vtExtended), a one-character literal a vtChar, as in
  Free Pascal; a record, an array, a set or a map is no such value. }
function TParser.ConstArrOf(E: PExpr): PExpr;
var
  i: SizeInt;
  v: PExpr;
  k: TTypeKind;
  kinds: string;
  vals: TExprArray;
  vr: LongInt;
  kd: LongInt;
begin
  vals := nil;
  kinds := '';
  SetLength(vals, Length(E^.Args));
  for i := 0 to High(E^.Args) do
  begin
    v := E^.Args[i];
    if v^.Kind = ekRange then
      Refuse('an array of const takes values, not a range' + PosOf(v));
    CheckTyped(v);
    k := TypeOf(v^.Typ).Kind;
    if (v^.Kind = ekStr) and (Length(v^.Txt) = 1) then
    begin
      kd := VrChar;
      v := NewInt(Ord(v^.Txt[1]));
      v^.Typ := TyChar;
    end
    else if v^.Kind = ekNil then
      kd := VrPointer
    else if IsCharT(v^.Typ) then
      kd := VrChar
    else if (v^.Typ = TyBoolean) or (k = tykBoolean) then
      kd := VrBoolean
    else if IsIntId(v^.Typ) or (k = tykInteger) then
    begin
      { a narrow integer widens to the 64 bits of VInteger }
      kd := VrInteger;
      v := CoerceInt(v, TyInteger);
    end
    else if (k = tykSubrange) or (k = tykEnum) then
      kd := VrInteger
    else if k = tykQuad then
      kd := VrQuad
    else if k = tykCurrency then
      kd := VrCurrency
    else if k = tykReal then
    begin
      kd := VrExtended;
      v := ValArg(TyReal, v);
    end
    else if k = tykString then
      kd := VrAnsiString
    else if (k = tykPointer) and (TypeOf(v^.Typ).Elem = TyChar) then
      kd := VrPChar
    else if k = tykPointer then
      kd := VrPointer
    else if k = tykClass then
      kd := VrObject
    else if k = tykClassRef then
      kd := VrClass
    else if k = tykInterface then
      kd := VrInterface
    else if k = tykProc then
      kd := VrPointer
    else if k = tykJson then
      kd := VrJson
    else
    begin
      Refuse('an array of const takes ordinals, reals, strings, pointers, objects, classes, ' +
        'interfaces and json, not ' + TypName(v^.Typ) + PosOf(v));
      kd := 0;
    end;
    vals[i] := v;
    kinds := kinds + Char(kd);
  end;
  Result := NewCall('rt_constarr', vals, InternConstArr);
  Result^.Txt := kinds;
  PosFrom(Result, E);
  vr := TypeOf(InternConstArr).Elem;
  if Length(vals) > 0 then
    Result^.Num := InternArray(vr, 0, Length(vals) - 1)
  else
    Result^.Num := 0;
end;

{ No argument of Args is an array of const (P124): Where runs the call
  after the frame that built the list may be gone. }
procedure TParser.NoConstArr(const Args: TExprArray; const Where: string);
var
  i: SizeInt;
begin
  for i := 0 to High(Args) do
    if (Args[i] <> nil) and IsConstArr(Args[i]^.Typ) then
      Refuse(Where + ' passes values, and an array of const lives for the call it is given to' +
        PosOf(Args[i]));
end;

{ A pointer to a type not declared yet (PNode = ^TNode before TNode) gets
  a type of its own, shared only by the uses of that same name, until
  AddNamedType patches its Elem. It was the interned ^Integer until
  1.0.73, so patching it turned Pointer, PInteger and every other
  ^Integer into ^TNode. An unresolved placeholder is never interned. }
function TParser.PendingSlot(Id: LongInt): Boolean;
var
  m: SizeInt;
begin
  Result := False;
  for m := 0 to High(FPendingId) do
    if (FPendingId[m] = Id) and (FPendingPtr[m] <> '') then
    begin
      Result := True;
      Exit;
    end;
end;

function TParser.ForwardPtr(const AName, At: string): LongInt;
var
  m, n: SizeInt;
begin
  for m := 0 to High(FPendingPtr) do
    if SameId(FPendingPtr[m], AName) then
    begin
      Result := FPendingId[m];
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykPointer;
  FTypes[n].Size := 8;
  FTypes[n].Elem := TyInteger;
  Result := LongInt(n);
  m := Length(FPendingPtr);
  SetLength(FPendingPtr, m + 1);
  SetLength(FPendingId, m + 1);
  SetLength(FPendingAt, m + 1);
  FPendingPtr[m] := AName;
  FPendingId[m] := Result;
  FPendingAt[m] := At;
end;

procedure TParser.ResolvePending(const AName: string; Id: LongInt);
var
  m: SizeInt;
begin
  for m := 0 to High(FPendingPtr) do
    if (FPendingPtr[m] <> '') and SameId(FPendingPtr[m], AName) then
    begin
      FTypes[FPendingId[m]].Elem := Id;
      FPendingPtr[m] := '';
    end;
end;

{ Pascal resolves a forward pointer within its own type section. }
procedure TParser.CheckPending;
var
  m: SizeInt;
begin
  for m := 0 to High(FPendingPtr) do
    if FPendingPtr[m] <> '' then
      Refuse('unknown type ' + FPendingPtr[m] + ' at ' + FPendingAt[m]);
end;

{ The classes and interfaces declared forward (P139): TFoo = class; and
  IFoo = interface; name a type that the same declarations (a unit's
  interface part, a program's or a routine's) declare whole later, as
  Object Pascal's. Until then it is a type to name, for a field, a
  parameter, a class of or a pointer, and not yet a parent or an
  interface to implement. The forward type and the whole one are the
  same type. }
function TParser.FwdIdx(const AName: string): SizeInt;
var
  i: SizeInt;
begin
  Result := -1;
  for i := FFwdScope to High(FFwdTypes) do
    if SameId(FTypes[FFwdTypes[i]].Name, AName) then
    begin
      Result := i;
      Exit;
    end;
end;

function TParser.IsFwdType(Id: LongInt): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  for i := 0 to High(FFwdTypes) do
    if FFwdTypes[i] = Id then
      Result := True;
end;

procedure TParser.DeclareFwd(const AName: string; Kind: TTypeKind; const At: string);
var
  td: TTypeDef;
  t: LongInt;
  n: SizeInt;
begin
  if (FwdIdx(AName) >= 0) or ((FNest = 0) and NamedType(AName, t)) then
    Refuse('duplicate type ' + AName + ' at ' + At);
  td := Default(TTypeDef);
  td.Kind := Kind;
  td.Name := AName;
  if Kind = tykInterface then
    td.Size := 16
  else
    td.Size := 8;
  n := Length(FFwdTypes);
  SetLength(FFwdTypes, n + 1);
  FFwdTypes[n] := AddNamedType(AName, td);
  AppendStr(FFwdAt, At);
end;

{ The whole declaration of a forward type is of its kind; At is where
  its type begins. }
procedure TParser.FwdKindIs(Fwd: SizeInt; Kind: TTypeKind; const AName, At: string);
begin
  if (Fwd < 0) or (FTypes[FFwdTypes[Fwd]].Kind = Kind) then
    Exit;
  if FTypes[FFwdTypes[Fwd]].Kind = tykClass then
    Refuse(AName + ' was declared forward as a class' + At)
  else
    Refuse(AName + ' was declared forward as an interface' + At);
end;

{ The forward type AName is declared whole now: its id, out of the
  list; -1 when it was not declared forward. }
function TParser.TakeFwd(const AName: string): LongInt;
var
  i, j: SizeInt;
begin
  Result := -1;
  i := FwdIdx(AName);
  if i < 0 then
    Exit;
  Result := FFwdTypes[i];
  for j := i to High(FFwdTypes) - 1 do
  begin
    FFwdTypes[j] := FFwdTypes[j + 1];
    FFwdAt[j] := FFwdAt[j + 1];
  end;
  SetLength(FFwdTypes, Length(FFwdTypes) - 1);
  SetLength(FFwdAt, Length(FFwdAt) - 1);
end;

{ At the end of the declarations every forward type of theirs is whole. }
procedure TParser.CheckFwdTypes;
begin
  if Length(FFwdTypes) > FFwdScope then
    Refuse('forward type ' + FTypes[FFwdTypes[FFwdScope]].Name + ' not resolved at ' +
      FFwdAt[FFwdScope]);
end;

function TParser.InternArray(Elem: LongInt; Lo, Hi: Int64): LongInt;
begin
  Result := InternArrayIdx(Elem, Lo, Hi, 0);
end;

{ A static array of Elem from Lo to Hi whose index is of type Idx, 0 for
  the integers (P161: array[Boolean], array[TColor], array[Char] keep
  their index type, which Low and High are of, in Elem2); Hi below Lo
  is a dynamic array. }
function TParser.InternArrayIdx(Elem: LongInt; Lo, Hi: Int64; Idx: LongInt): LongInt;
var
  i, n: SizeInt;
  count: Int64;
begin
  for i := 0 to High(FTypes) do
    { An anonymous array must not acquire a named imported type merely
      because its bounds match (P193). Go types/fmt.go likewise preserves
      a named type's identity separately from an anonymous array shape. }
    if (FTypes[i].Kind = tykArray) and (FTypes[i].Name = '') and (FTypes[i].Elem = Elem) and
      (FTypes[i].Lo = Lo) and (FTypes[i].Hi = Hi) and (FTypes[i].Elem2 = Idx) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  if Hi < Lo then
  begin
    n := Length(FTypes);
    SetLength(FTypes, n + 1);
    FTypes[n] := Default(TTypeDef);
    FTypes[n].Kind := tykArray;
    FTypes[n].Elem := Elem;
    FTypes[n].Lo := 0;
    FTypes[n].Hi := -1;
    FTypes[n].Size := 24;
    Result := LongInt(n);
    Exit;
  end;
  count := Hi - Lo + 1;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykArray;
  FTypes[n].Elem := Elem;
  FTypes[n].Elem2 := Idx;
  FTypes[n].Lo := Lo;
  FTypes[n].Hi := Hi;
  FTypes[n].Size := LongInt(count) * ValSize(Elem);
  Result := LongInt(n);
end;

{ The values of an ordinal type Id, for an array's index and High and
  Low (P161): an integer type's, Char's, Boolean's, an enumeration's or
  a subrange's. }
function TParser.OrdBounds(Id: LongInt; out Lo, Hi: Int64): Boolean;
var
  td: TTypeDef;
begin
  Result := True;
  td := TypeOf(Id);
  if IsIntId(Id) then
  begin
    Lo := IntLo(Id);
    Hi := IntHi(Id);
  end
  else if Id = TyChar then
  begin
    Lo := 0;
    Hi := 255;
  end
  else if Id = TyBoolean then
  begin
    Lo := 0;
    Hi := 1;
  end
  else if (td.Kind = tykEnum) or (td.Kind = tykSubrange) then
  begin
    Lo := td.Lo;
    Hi := td.Hi;
  end
  else
  begin
    Lo := 0;
    Hi := -1;
    Result := False;
  end;
end;

function TParser.InternSubrange(Lo, Hi: Int64): LongInt;
begin
  Result := InternSubOf(TyInteger, Lo, Hi);
end;

{ The subrange Lo..Hi of host type Host (P135): the integers', Char's
  ('0'..'9') or an enumeration's (Mon..Fri). Its values are its host's;
  it is 8 bytes, as every subrange. }
function TParser.InternSubOf(Host: LongInt; Lo, Hi: Int64): LongInt;
var
  i, n: SizeInt;
begin
  if Hi < Lo then
    Refuse('bad subrange: ' + IntToStr(Lo) + ' is above ' + IntToStr(Hi) + SubAt);
  if (Host = TyChar) and ((Lo < 0) or (Hi > 255)) then
    Refuse('a subrange of Char lies in #0..#255' + SubAt);
  if (TypeOf(Host).Kind = tykEnum) and ((Lo < TypeOf(Host).Lo) or (Hi > TypeOf(Host).Hi)) then
    Refuse('a subrange of ' + TypName(Host) + ' lies in its members' + SubAt);
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykSubrange) and (FTypes[i].Lo = Lo) and
      (FTypes[i].Hi = Hi) and (FTypes[i].Elem = Host) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykSubrange;
  FTypes[n].Lo := Lo;
  FTypes[n].Hi := Hi;
  FTypes[n].Size := 8;
  FTypes[n].Elem := Host;
  Result := LongInt(n);
end;

function TParser.InternSet(Elem: LongInt): LongInt;
var
  i, n: SizeInt;
  td: TTypeDef;
  lo, hi: Int64;
begin
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykSet) and (FTypes[i].Elem = Elem) then
    begin
      Result := LongInt(i);
      Exit;
    end;
  td := TypeOf(Elem);
  lo := 0;
  hi := 0;
  if td.Kind = tykBoolean then
  begin
    lo := 0;
    hi := 1;
  end
  else if (Elem = TyChar) or (Elem = TyByte) then
  begin
    { set of Char and set of Byte (P126) }
    lo := 0;
    hi := 255;
  end
  else if (td.Kind = tykEnum) or (td.Kind = tykSubrange) then
  begin
    lo := td.Lo;
    hi := td.Hi;
  end
  else
    Refuse('a set is of Char, Byte, Boolean, an enumeration or a subrange, not ' + TypName(Elem) +
      SubAt);
  if (lo < 0) or (hi > 255) then
    Refuse('a set holds elements 0 to 255, not ' + IntToStr(lo) + '..' + IntToStr(hi) + SubAt);
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykSet;
  FTypes[n].Elem := Elem;
  FTypes[n].Lo := lo;
  FTypes[n].Hi := hi;
  { one word up to element 63; 32 bytes, the 256 bits, past it (P126) }
  if hi <= 63 then
    FTypes[n].Size := 8
  else
    FTypes[n].Size := 32;
  Result := LongInt(n);
end;

{ A set of 32 bytes (P126): a block, as a record is. }
function TParser.IsWideSet(Id: LongInt): Boolean;
begin
  Result := (TypeOf(Id).Kind = tykSet) and (TypeOf(Id).Size = 32);
end;

{ The ordinal set element E is, a one-character literal its Char, and
  the type its set is of (P126): Char, Byte, an enumeration, a
  subrange, a Boolean; an integer of another type is 0..255, or 0..63
  for a constant that fits. }
function TParser.SetElem(var E: PExpr): LongInt;
var
  k: TTypeKind;
begin
  if (E^.Kind = ekStr) and (Length(E^.Txt) = 1) then
  begin
    E := NewInt(Ord(E^.Txt[1]));
    E^.Typ := TyChar;
  end;
  CheckTyped(E);
  k := TypeOf(E^.Typ).Kind;
  if (E^.Typ = TyChar) or (E^.Typ = TyByte) or (k = tykEnum) or (k = tykSubrange) or
    (k = tykBoolean) then
    Result := E^.Typ
  else if IsIntId(E^.Typ) or (k = tykInteger) then
  begin
    if (E^.Kind = ekInt) and (E^.Num >= 0) and (E^.Num <= 63) then
      Result := InternSubrange(0, 63)
    else
      Result := InternSubrange(0, 255);
  end
  else
  begin
    Refuse('a set holds ordinals, not ' + TypName(E^.Typ) + PosOf(E));
    Result := TyInteger;
  end;
end;

{ E could be a set's element (P126): an ordinal, a one-character
  literal, a constant of 0..255; SetElem says why another is not. }
function TParser.SetElemOk(E: PExpr): Boolean;
var
  k: TTypeKind;
begin
  if E^.Kind = ekRange then
  begin
    Result := SetElemOk(E^.L) and SetElemOk(E^.R);
    Exit;
  end;
  if (E^.Kind = ekStr) and (Length(E^.Txt) = 1) then
  begin
    Result := True;
    Exit;
  end;
  if (E^.Kind = ekInt) and ((E^.Num < 0) or (E^.Num > 255)) then
  begin
    Result := False;
    Exit;
  end;
  k := TypeOf(E^.Typ).Kind;
  Result := (E^.Typ = TyChar) or (E^.Typ = TyByte) or (k = tykEnum) or (k = tykSubrange) or
    (k = tykBoolean) or IsIntId(E^.Typ) or (k = tykInteger);
end;

{ A list in brackets of what no set holds (Flags bit 64, P126) is a list
  only: a slice, an open array, an array of const or for x in take it.
  Where a set goes it stops, and the first element no set holds says
  why. }
{ The elements a set could hold are of more than one kind (P141): of
  more than one SetFamily, a range's ends counted. }
function TParser.ListMixed(const Args: TExprArray): Boolean;
var
  i: SizeInt;
  f, g: LongInt;
  a: PExpr;
  have: Boolean;
begin
  Result := False;
  have := False;
  f := 0;
  for i := 0 to High(Args) do
  begin
    a := Args[i];
    if a^.Kind = ekRange then
      a := a^.L;
    g := SetFamily(a^.Typ);
    if (a^.Kind = ekStr) and (Length(a^.Txt) = 1) then
      g := TyChar;
    if have and (g <> f) then
    begin
      Result := True;
      Exit;
    end;
    f := g;
    have := True;
  end;
end;

procedure TParser.NoList(E: PExpr);
var
  i: SizeInt;
  a: PExpr;
  et: LongInt;
begin
  if (E = nil) or (E^.Kind <> ekSet) or ((E^.Flags and 64) = 0) then
    Exit;
  { elements of more than one kind: SetJoin names them }
  if ListMixed(E^.Args) then
  begin
    et := 0;
    for i := 0 to High(E^.Args) do
    begin
      if E^.Args[i]^.Kind = ekRange then
        a := E^.Args[i]^.L
      else
        a := E^.Args[i];
      FElemAt := PosOf(a);
      et := SetJoin(et, SetElem(a));
      FElemAt := '';
    end;
  end;
  for i := 0 to High(E^.Args) do
  begin
    if E^.Args[i]^.Kind = ekRange then
      a := E^.Args[i]^.L
    else
      a := E^.Args[i];
    if not SetElemOk(a) and (a^.Kind <> ekInt) then
      SetElem(a);
    if (E^.Args[i]^.Kind = ekRange) and not SetElemOk(E^.Args[i]^.R) and
      (E^.Args[i]^.R^.Kind <> ekInt) then
    begin
      a := E^.Args[i]^.R;
      SetElem(a);
    end;
  end;
  Refuse('set element out of 0..255' + PosOf(E));
end;

{ The bytes of constant set E, 8 or 32 as its type (P126); False when
  an element is not constant. }
function TParser.SetImage(E: PExpr; out Img: string): Boolean;
var
  i: SizeInt;
  lo, hi, v, one, w: Int64;
  vt: LongInt;
  txt: string;
  sz, lo0, hi0: LongInt;
  bits: array[0..3] of Int64;
  k: SizeInt;
begin
  NoList(E);
  Result := False;
  Img := '';
  sz := TypeOf(E^.Typ).Size;
  lo0 := LongInt(TypeOf(E^.Typ).Lo);
  hi0 := LongInt(TypeOf(E^.Typ).Hi);
  for k := 0 to 3 do
    bits[k] := 0;
  one := 1;
  for i := 0 to High(E^.Args) do
  begin
    if E^.Args[i]^.Kind = ekRange then
    begin
      if not (ConstFold(E^.Args[i]^.L, lo, vt, txt) and ConstFold(E^.Args[i]^.R, hi, vt, txt)) then
        Exit;
    end
    else
    begin
      if not ConstFold(E^.Args[i], lo, vt, txt) then
        Exit;
      hi := lo;
    end;
    if (lo < lo0) or (hi > hi0) then
      Refuse('set element out of ' + IntToStr(lo0) + '..' + IntToStr(hi0) + ' at ' + FConstAt);
    v := lo;
    while v <= hi do
    begin
      w := v shr 6;
      bits[w] := bits[w] or (one shl (v and 63));
      v := v + 1;
    end;
  end;
  SetLength(Img, sz);
  for k := 0 to sz - 1 do
    Img[k + 1] := Char((bits[k div 8] shr (8 * (k mod 8))) and 255);
  Result := True;
end;

{ The constant set of type T whose bytes are Img (P126): a list of its
  elements, runs as ranges. }
function TParser.SetFromImage(const Img: string; T: LongInt): PExpr;
var
  args: TExprArray;
  v, st: LongInt;
  n: SizeInt;
  a, b: PExpr;
  et: LongInt;

  function Has(X: LongInt): Boolean;
  begin
    Result := (X div 8 < Length(Img)) and (((Ord(Img[X div 8 + 1]) shr (X mod 8)) and 1) = 1);
  end;

begin
  args := nil;
  et := TypeOf(T).Elem;
  v := 0;
  while v < Length(Img) * 8 do
  begin
    if Has(v) then
    begin
      st := v;
      while (v + 1 < Length(Img) * 8) and Has(v + 1) do
        v := v + 1;
      a := NewInt(st);
      a^.Typ := et;
      n := Length(args);
      SetLength(args, n + 1);
      if v > st then
      begin
        b := NewInt(v);
        b^.Typ := et;
        args[n] := NewRange(a, b);
      end
      else
        args[n] := a;
    end;
    v := v + 1;
  end;
  Result := NewSet(args, T);
end;

{ The element type of a list whose elements so far are of type A (0 for
  none) and B (P126): a typed element (Char, Byte, an enumeration)
  decides; integers take the wider range. }
function TParser.SetJoin(A, B: LongInt): LongInt;

  function KindWord(T: LongInt): string;
  begin
    if TypeOf(T).Kind = tykEnum then
      Result := TypName(T)
    else if SetFamily(T) = TyChar then
      Result := 'a Char'
    else if SetFamily(T) = TyBoolean then
      Result := 'a Boolean'
    else
      Result := 'an integer';
  end;

begin
  if (A <> 0) and (SetFamily(A) <> SetFamily(B)) then
  begin
    { at the element of the other kind (P340), when the caller named it }
    if FElemAt <> '' then
      Refuse('a list in brackets holds elements of one kind, not ' + KindWord(A) + ' and ' +
        KindWord(B) + FElemAt);
    Refuse('a list in brackets holds elements of one kind, not ' + KindWord(A) + ' and ' +
      KindWord(B) + HerePos);
  end;
  if A = 0 then
    Result := B
  else if (A <> B) and (SetFamily(A) <> 0) and not SameTyp(A, B) then
    { 'a' and a '0'..'9', Red and a Green..Blue: of their host (P135) }
    Result := SetFamily(A)
  else if (TypeOf(A).Kind = tykSubrange) and (TypeOf(A).Elem = TyInteger) then
  begin
    if (TypeOf(B).Kind = tykSubrange) and (TypeOf(B).Elem = TyInteger) and
      (TypeOf(B).Hi > TypeOf(A).Hi) then
      Result := B
    else if (TypeOf(B).Kind = tykSubrange) and (TypeOf(B).Elem = TyInteger) then
      Result := A
    else
      Result := B;
  end
  else
    Result := A;
end;

{ An element of set type T (P126): of its element's kind, a constant in
  its range. }
procedure TParser.SetElemFits(var E: PExpr; T: LongInt);
var
  et, want: LongInt;
begin
  et := SetElem(E);
  want := TypeOf(T).Elem;
  { of the set's kind of element (P135: an enumeration's subrange is of
    the enumeration, '0'..'9' of Char) }
  if SetFamily(E^.Typ) <> SetFamily(want) then
  begin
    if (SetFamily(E^.Typ) = TyChar) and (SetFamily(want) = 0) then
      Refuse('a Char is no element of a set of ' + TypName(want) + ': Ord(c) is' + PosOf(E));
    Refuse(TypName(E^.Typ) + ' is no element of a set of ' + TypName(want) + PosOf(E));
  end;
  if (E^.Kind = ekInt) and ((E^.Num < TypeOf(T).Lo) or (E^.Num > TypeOf(T).Hi)) then
    Refuse('set element out of ' + IntToStr(TypeOf(T).Lo) + '..' + IntToStr(TypeOf(T).Hi) + PosOf(E));
  if et = 0 then
    Exit;
end;

{ The list in brackets E made a set of type T (P126), each element
  checked. }
function TParser.SetLitTo(E: PExpr; T: LongInt): PExpr;
var
  i: SizeInt;
  a, b: PExpr;
begin
  NoList(E);
  for i := 0 to High(E^.Args) do
    if E^.Args[i]^.Kind = ekRange then
    begin
      a := E^.Args[i]^.L;
      b := E^.Args[i]^.R;
      SetElemFits(a, T);
      SetElemFits(b, T);
      E^.Args[i]^.L := a;
      E^.Args[i]^.R := b;
    end
    else
    begin
      a := E^.Args[i];
      SetElemFits(a, T);
      E^.Args[i] := a;
    end;
  E^.Typ := T;
  Result := E;
end;

{ Two set operands of one kind (P126): a list takes the other side's
  type; two sets are of one element type. }
procedure TParser.SetPair(var L, R: PExpr);
var
  u: LongInt;
begin
  NoList(L);
  NoList(R);
  if (L^.Kind = ekSet) and IsSetTyp(R^.Typ) and (R^.Kind <> ekSet) then
    L := SetLitTo(L, SetHome(L, R^.Typ))
  else if (R^.Kind = ekSet) and IsSetTyp(L^.Typ) and (L^.Kind <> ekSet) then
    R := SetLitTo(R, SetHome(R, L^.Typ));
  if not (IsSetTyp(L^.Typ) and IsSetTyp(R^.Typ)) then
    Refuse('a set goes with a set' + HerePos);
  if L^.Typ = R^.Typ then
    Exit;
  if SetFamily(TypeOf(L^.Typ).Elem) <> SetFamily(TypeOf(R^.Typ).Elem) then
    Refuse(TypName(L^.Typ) + ' and ' + TypName(R^.Typ) + ' are sets of other elements' + PosOf(L));
  { two ranges of one kind: both as the set that covers them }
  u := SetUnion(L^.Typ, R^.Typ);
  L := SetConvTo(L, u);
  R := SetConvTo(R, u);
end;

{ Set type T holds every element of set type U (P126). }
function TParser.SetCovers(T, U: LongInt): Boolean;
begin
  Result := (TypeOf(T).Lo <= TypeOf(U).Lo) and (TypeOf(T).Hi >= TypeOf(U).Hi);
end;

{ The set type two sets of one kind of element meet in (P126): the one
  that covers the other, else of both ranges: of the integers from the
  lower low to the higher high, of Char, of the whole enumeration. }
function TParser.SetUnion(A, B: LongInt): LongInt;
var
  f: LongInt;
  lo, hi: Int64;
begin
  if SetCovers(A, B) then
    Result := A
  else if SetCovers(B, A) then
    Result := B
  else
  begin
    f := SetFamily(TypeOf(A).Elem);
    if f <> 0 then
      Result := InternSet(f)
    else
    begin
      lo := TypeOf(A).Lo;
      if TypeOf(B).Lo < lo then
        lo := TypeOf(B).Lo;
      hi := TypeOf(A).Hi;
      if TypeOf(B).Hi > hi then
        hi := TypeOf(B).Hi;
      Result := InternSet(InternSubrange(lo, hi));
    end;
  end;
end;

{ The set type list E takes beside a set of type T (P126): T when every
  element is a constant in T's range, or when T holds every element of
  its kind; else the type that covers both, as FPC's s + [x] holds an x
  that s cannot. }
function TParser.SetHome(E: PExpr; T: LongInt): LongInt;
var
  i: SizeInt;
  fits: Boolean;

  procedure Fit(A: PExpr);
  begin
    if not ((A^.Kind = ekInt) and (A^.Num >= TypeOf(T).Lo) and (A^.Num <= TypeOf(T).Hi)) then
      fits := False;
  end;

begin
  fits := True;
  for i := 0 to High(E^.Args) do
    if E^.Args[i]^.Kind = ekRange then
    begin
      Fit(E^.Args[i]^.L);
      Fit(E^.Args[i]^.R);
    end
    else
      Fit(E^.Args[i]);
  if fits or (SetFamily(TypeOf(E^.Typ).Elem) <> SetFamily(TypeOf(T).Elem)) or
    SetCovers(T, E^.Typ) then
    Result := T
  else
    Result := SetUnion(T, E^.Typ);
end;

{ E, a set, made one of set type T of its kind of element (P126): a list
  typed as T; another set with the elements outside T's range dropped,
  as FPC does, its word widened to 32 bytes or 32 narrowed to a word
  (rt_setconv). }
function TParser.SetConvTo(E: PExpr; T: LongInt): PExpr;
var
  a: TExprArray;
begin
  if E^.Kind = ekSet then
  begin
    Result := SetLitTo(E, T);
    Exit;
  end;
  Result := E;
  if E^.Typ = T then
    Exit;
  if SetFamily(TypeOf(E^.Typ).Elem) <> SetFamily(TypeOf(T).Elem) then
    Refuse(TypName(E^.Typ) + ' and ' + TypName(T) + ' are sets of other elements' + PosOf(E));
  a := nil;
  SetLength(a, 1);
  a[0] := E;
  Result := NewCall('rt_setconv', a, T);
end;

{ The kind of ordinal T is, for a set's element (P126): Char's,
  Boolean's, an enumeration's (the enumeration, whose subranges are of
  it since P135), or an integer's (0). }
function TParser.SetFamily(T: LongInt): LongInt;
begin
  if (TypeOf(T).Kind = tykSubrange) and (TypeOf(T).Elem > 0) then
    T := TypeOf(T).Elem;
  if (T = TyChar) or (TypeOf(T).Kind = tykEnum) then
    Result := T
  else if TypeOf(T).Kind = tykBoolean then
    Result := TyBoolean
  else
    Result := 0;
end;

{ E, a value of a subrange of Char, as a Char (P135): the code the same,
  the type the one the string words know. }
function TParser.AsChar(E: PExpr): PExpr;
begin
  Result := E;
  if (E <> nil) and (E^.Typ <> TyChar) and IsCharT(E^.Typ) then
  begin
    Result := NewUn(uoConv, E);
    Result^.Typ := TyChar;
  end;
end;

{ A value of type T is a Char: Char itself or a subrange of it, '0'..'9'
  (P135). }
function TParser.IsCharT(T: LongInt): Boolean;
begin
  Result := (T = TyChar) or ((TypeOf(T).Kind = tykSubrange) and (TypeOf(T).Elem = TyChar));
end;

{ for x in E, E a set (P126): a list is of x's kind, and x holds the
  set's elements. }
function TParser.SetForVar(E: PExpr; VT: LongInt): PExpr;
begin
  Result := E;
  if (E^.Kind = ekSet) and ((VT = TyByte) or (SetFamily(VT) <> 0)) then
    Result := SetLitTo(E, InternSet(VT));
  if SetFamily(TypeOf(Result^.Typ).Elem) <> SetFamily(VT) then
    Refuse('for x in ' + TypName(Result^.Typ) + ': x is a ' + TypName(VT) +
      ', not an element of it' + PosOf(E));
end;

function TParser.IsSetTyp(Id: LongInt): Boolean;
begin
  Result := TypeOf(Id).Kind = tykSet;
end;

procedure TParser.ParseEnumType(const AName: string);
var
  td: TTypeDef;
  id, n: LongInt;
  ni: SizeInt;
  ename, ref: string;
begin
  Eat(tkLParen);
  td := Default(TTypeDef);
  td.Kind := tykEnum;
  td.Size := 8;
  td.Lo := 0;
  td.Hi := 0;
  id := AddNamedType(AName, td);
  n := 0;
  while True do
  begin
    if FTok.Kind <> tkIdent then
      Expected('an enumeration''s member');
    CheckName(FTok.Lexeme);
    FDeclAt := HerePos;
    ename := FTok.Lexeme;
    FTok := FLex.Next;
    AddConst(ename, n, id);
    { TEnum.Member is explicit even for an enumeration nested in a
      record. Its textual name remains the leaf, not Outer.Member. }
    ni := Length(FTypes[id].Nested);
    SetLength(FTypes[id].Nested, ni + 1);
    FTypes[id].Nested[ni].Name := ename;
    FTypes[id].Nested[ni].Kind := 1;
    FTypes[id].Nested[ni].Typ := id;
    FTypes[id].Nested[ni].Vis := VisPublic;
    ref := FConsts[High(FConsts)].Name;
    if FUnitName <> '' then ref := FUnitName + '.' + ref;
    FTypes[id].Nested[ni].Ref := ref;
    Inc(n);
    if FTok.Kind <> tkComma then
      Break;
    FTok := FLex.Next;
  end;
  Eat(tkRParen);
  Eat(tkSemi);
  if n = 0 then
    Refuse('an enumeration names one member at least');
  FTypes[id].Hi := n - 1;
end;

function TParser.InternParam(const AName: string): LongInt;
var
  n: SizeInt;
begin
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Default(TTypeDef);
  FTypes[n].Kind := tykParam;
  FTypes[n].Name := AName;
  FTypes[n].Size := 8;
  Result := LongInt(n);
end;

function TParser.SubstType(Id, ParamId, ArgId: LongInt): LongInt;
var
  td: TTypeDef;
  elem: LongInt;
begin
  if Id = ParamId then
  begin
    Result := ArgId;
    Exit;
  end;
  td := TypeOf(Id);
  if td.Kind = tykArray then
  begin
    elem := Self.SubstType(td.Elem, ParamId, ArgId);
    Result := InternArray(elem, td.Lo, td.Hi);
  end
  else if td.Kind = tykPointer then
  begin
    elem := Self.SubstType(td.Elem, ParamId, ArgId);
    Result := InternPtr(elem);
  end
  else if td.Kind = tykChan then
  begin
    elem := Self.SubstType(td.Elem, ParamId, ArgId);
    Result := InternChan(elem);
  end
  else
    Result := Id;
end;

function TParser.SpecType(GenId, Arg: LongInt): LongInt;
var
  g, td: TTypeDef;
  i, n: SizeInt;
  off, sz, t: LongInt;
begin
  g := TypeOf(GenId);
  if g.Kind <> tykGeneric then
    Refuse('not a generic type');
  { Go's current go/types/instantiate.go keys instances by origin and
    type arguments. A displayed name is neither a cache key nor a
    declaration: units can declare different types of one spelling. }
  for i := High(FTypes) downto 0 do
    if (FTypes[i].SpecOrigin > 0) and SameTyp(FTypes[i].SpecOrigin, GenId) and
      SameTyp(FTypes[i].SpecArg, Arg) then
    begin Result := LongInt(i); Exit end;
  td := Default(TTypeDef);
  td.Kind := tykRecord;
  td.Name := g.Name + '<' + TypeOf(Arg).Name + '>';
  td.SpecOrigin := GenId;
  td.SpecArg := Arg;
  td.Fields := nil;
  off := 0;
  for i := 0 to High(g.Fields) do
  begin
    t := Self.SubstType(g.Fields[i].Typ, g.Elem, Arg);
    sz := ValSize(t);
    n := Length(td.Fields);
    SetLength(td.Fields, n + 1);
    td.Fields[n].Name := g.Fields[i].Name;
    td.Fields[n].Typ := t;
    td.Fields[n].JName := g.Fields[i].JName;
    td.Fields[n].JFlags := g.Fields[i].JFlags;
    { the json directive of a field of type T, checked with T known (P205) }
    if g.Fields[i].JFlags <> 0 then
      CheckJsonTyp(t, g.Fields[i].JFlags, HerePos);
    off := FieldAt(off, t);
    td.Fields[n].Off := off;
    off := off + sz;
  end;
  td.Size := RecEnd(td, off);
  if td.Size < 1 then
    td.Size := 1;
  { Only a source alias names the instance. Never insert a synthetic
    TCell_TItem into the enclosing namespace. }
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := td;
  Result := LongInt(n);
  CheckJsonNames(Result);
end;

function TParser.AddNamedType(const AName: string; const Td: TTypeDef): LongInt;
var
  n, m: SizeInt;
begin
  CheckName(AName);
  if FNest > 0 then
    LocalDup(AName, 't')
  else if OwnTypeNamed(AName) then
    Refuse('duplicate type ' + AName + DupAt);
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := Td;
  FTypes[n].Name := AName;
  { a unit's type is the unit's (P154): its stem is its identity where a
    .pi brings it in again, and two units' TBox of one size are two; a
    type the source declares, not one the compiler makes (TVarRec, in
    every unit, is the language's) }
  if (FTypes[n].Sym = '') and (FNest = 0) and FInTypes then
    FTypes[n].Sym := UnitStem(AName);
  m := Length(FTypeNames);
  SetLength(FTypeNames, m + 1);
  FTypeNames[m].Name := AName;
  FTypeNames[m].Id := LongInt(n);
  FTypeNames[m].Nest := FNest;
  if FMemberScope > 0 then
    if SameId(Copy(AName, 1, Length(FTypes[FMemberScope].Name) + 1),
      FTypes[FMemberScope].Name + '.') then
    begin
      FTypes[n].ScopeOwner := FMemberScope;
      AddScoped(AName, LongInt(n), 0, '');
    end;
  ResolvePending(AName, LongInt(n));
  Result := LongInt(n);
end;

function TParser.FindConst(const AName: string; out V: Int64): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  V := 0;
  { the innermost first: a routine's constant hides the program's (P137);
    a deeper name of any kind hides the constant (P158, P159), and the
    constants around it with it }
  i := ConstIdx(AName);
  if i < 0 then Exit;
  if HiddenAbove(AName, FConsts[i].Nest) then Exit;
  V := FConsts[i].Value;
  Result := True;
end;

function TParser.IsVarName(const AName: string): Boolean;
var
  i, s: SizeInt;
  td: TTypeDef;
begin
  Result := False;
  if FIsFunc then
  begin
    if SameId(AName, 'result') or SameId(AName, FFuncName) then
    begin
      Result := True;
      Exit;
    end;
  end;
  for i := 0 to High(FLocals) do
    if SameId(FLocals[i].Name, AName) then
    begin
      Result := True;
      Exit;
    end;
  if FClassTyp <> 0 then
  begin
    td := TypeOf(FClassTyp);
    for i := 0 to High(td.Fields) do
      if SameId(td.Fields[i].Name, AName) then
      begin
        Result := True;
        Exit;
      end;
  end;
  { a variable of a routine around, or a global, that a deeper name of
    another kind does not hide (P159) }
  for s := High(FScopes) downto 0 do
    for i := 0 to High(FScopes[s]) do
      if SameId(FScopes[s][i].Name, AName) then
      begin
        Result := not HiddenAbove(AName, ScopeLevel(s));
        Exit;
      end;
  for i := High(FVars) downto 0 do
    if SameId(FVars[i].Name, AName) then
    begin
      Result := not HiddenAbove(AName, 0);
      Exit;
    end;
end;

{ The depth of the variables FScopes[S] holds (P159). }
function TParser.ScopeLevel(S: SizeInt): LongInt;
begin
  if S <= High(FScopeLevels) then
    Result := FScopeLevels[S]
  else
    Result := 1;
end;

function TParser.VarTyp(const AName: string): LongInt;
var
  i, s: SizeInt;
  td: TTypeDef;
begin
  Result := TyInteger;
  if FIsFunc then
  begin
    if SameId(AName, 'result') or SameId(AName, FFuncName) then
    begin
      Result := FRetTyp;
      Exit;
    end;
  end;
  for i := 0 to High(FLocals) do
    if SameId(FLocals[i].Name, AName) then
    begin
      Result := FLocals[i].Typ;
      Exit;
    end;
  if FClassTyp <> 0 then
  begin
    td := TypeOf(FClassTyp);
    for i := 0 to High(td.Fields) do
      if SameId(td.Fields[i].Name, AName) then
      begin
        Result := td.Fields[i].Typ;
        Exit;
      end;
  end;
  for s := High(FScopes) downto 0 do
    for i := 0 to High(FScopes[s]) do
      if SameId(FScopes[s][i].Name, AName) then
      begin
        if not HiddenAbove(AName, ScopeLevel(s)) then
          Result := FScopes[s][i].Typ;
        Exit;
      end;
  for i := High(FVars) downto 0 do
    if SameId(FVars[i].Name, AName) then
    begin
      if not HiddenAbove(AName, 0) then
        Result := FVars[i].Typ;
      Exit;
    end;
end;

{ The name the code uses for a variable: its own, or the assembly name
  of a unit's global (unit.Name, 1.0.76), in the order VarTyp looks. }
function TParser.VarSym(const AName: string): string;
var
  i, s: SizeInt;
  td: TTypeDef;
begin
  Result := AName;
  if FIsFunc and (SameId(AName, 'result') or SameId(AName, FFuncName)) then
    Exit;
  for i := 0 to High(FLocals) do
    if SameId(FLocals[i].Name, AName) then
    begin
      if FLocals[i].Sym <> '' then
        Result := FLocals[i].Sym;
      Exit;
    end;
  if FClassTyp <> 0 then
  begin
    td := TypeOf(FClassTyp);
    for i := 0 to High(td.Fields) do
      if SameId(td.Fields[i].Name, AName) then
        Exit;
  end;
  for s := High(FScopes) downto 0 do
    for i := 0 to High(FScopes[s]) do
      if SameId(FScopes[s][i].Name, AName) then
      begin
        if (FScopes[s][i].Sym <> '') and not HiddenAbove(AName, ScopeLevel(s)) then
          Result := FScopes[s][i].Sym;
        Exit;
      end;
  for i := High(FVars) downto 0 do
    if SameId(FVars[i].Name, AName) then
    begin
      if (FVars[i].Sym <> '') and not HiddenAbove(AName, 0) then
        Result := FVars[i].Sym;
      Exit;
    end;
end;

function TParser.FindProc(const AName: string; out P: TProcEnt): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  P := Default(TProcEnt);
  { the innermost first: a nested routine hides the program's (P137),
    and a deeper name of any kind the routine (P158, P159) }
  for i := High(FProcs) downto 0 do
    if SameId(FProcs[i].Name, AName) and not HiddenBy(AName, FProcs[i].Nest, False) then
    begin
      P := FProcs[i];
      Result := True;
      Exit;
    end;
end;

function TParser.SigEq(const A, B: TParamArray): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if Length(A) <> Length(B) then
    Exit;
  for i := 0 to High(A) do
    if (A[i].Typ <> B[i].Typ) or (A[i].ByRef <> B[i].ByRef) then
      Exit;
  Result := True;
end;

function TParser.OwnMeth(const Sym, Base: string): Boolean;
var
  i: SizeInt;
  p: string;
begin
  Result := False;
  if SameId(Sym, Base) then
  begin
    Result := True;
    Exit;
  end;
  p := Base + '_o';
  if Length(Sym) < Length(p) then
    Exit;
  for i := 1 to Length(p) do
    if Sym[i] <> p[i] then
      Exit;
  Result := True;
end;

{ The two ways a character and a string meet, as in every Pascal.
  A Char where a string is wanted becomes a one-byte string: s := c,
  Take(c) and Take(#10). The byte is allocated, so the string outlives
  the frame that made it. A one-character literal where a Char is
  wanted is that character: Take('z') with Take(C: Char). }
function TParser.StrArg(Want: LongInt; E: PExpr): PExpr;
var
  a: TExprArray;
begin
  Result := E;
  if E = nil then
    Exit;
  if IsCharT(Want) and (E^.Kind = ekStr) and (Length(E^.Txt) = 1) then
  begin
    { a character where a Char goes, of '0'..'9' too, in its range (P135) }
    if (Ord(E^.Txt[1]) < TypeOf(Want).Lo) or ((Want <> TyChar) and (Ord(E^.Txt[1]) > TypeOf(Want).Hi)) then
      Refuse('constant #' + IntToStr(Ord(E^.Txt[1])) + ' does not fit ' + TypName(Want) + PosOf(E));
    Result := NewInt(Ord(E^.Txt[1]));
    Result^.Typ := Want;
    Exit;
  end;
  if (not IsCharT(E^.Typ)) or (not IsStrTyp(Want)) then
    Exit;
  a := nil;
  SetLength(a, 1);
  a[0] := AsChar(E);
  Result := NewCall('rt_chstr', a, TyString);
end;

{ A real constant's binary64 bits as a Double and back (1.0.74). }
function BitsReal(V: Int64): Double;
var
  d: Double;
begin
  d := 0;
  Move(V, d, 8);
  Result := d;
end;

function RealBits(D: Double): Int64;
var
  v: Int64;
begin
  v := 0;
  Move(D, v, 8);
  Result := v;
end;

{ A value where Want is expected (1.0.75): an integer becomes a real for
  a real, a constant one at compile time, as an assignment always did;
  a Char or a one-character string fits the other (StrArg). An argument
  for a real parameter, Exit(e), Result := e and Send passed the
  integer's bits, so the real was a denormal: H(5) gave 0.0. }
{ Class Cls implements Iface: it or an ancestor lists it. An interface
  two units' .pi both carry is two types of one name here, as its
  table's symbol has one (1.0.137). A parent of a listed interface is
  not implemented, as in Free Pascal. }
function TParser.ClassHasIface(Cls, Iface: LongInt): Boolean;
var
  i: SizeInt;
  p: LongInt;
begin
  Result := False;
  for i := 0 to High(TypeOf(Cls).Ifaces) do
  begin
    p := TypeOf(Cls).Ifaces[i];
    if (p = Iface) or (TypeStemOf(TypeOf(p)) = TypeStemOf(TypeOf(Iface))) then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

{ An object where an interface goes (P140): the object and its class's
  table for the interface, the two words of an interface value. Only an
  assignment made one before; an argument, a result and an element took
  the object alone, and a call through it read no table. }
function TParser.IfaceBind(E: PExpr; Want: LongInt): PExpr;
var
  a: TExprArray;
begin
  if not ClassHasIface(E^.Typ, Want) then
    Refuse(TypName(E^.Typ) + ' does not implement ' + TypName(Want) + PosOf(E));
  a := nil;
  SetLength(a, 1);
  a[0] := E;
  Result := NewCall('rt_ifacebind', a, Want);
end;

function TParser.ValArg(Want: LongInt; E: PExpr): PExpr;
var
  k: TTypeKind;
  nl, cv: PExpr;
begin
  Result := StrArg(Want, E);
  if E = nil then
    Exit;
  CheckTyped(E);
  { a record's class operator Implicit (P171): a value where the record
    goes, or the record where another type goes }
  if (Length(FConvs) > 0) and ConvFor(E, Want, False, cv) then
  begin
    Result := cv;
    Exit;
  end;
  { json (P203): only a json or nil goes into one, and a json only where
    a json goes: text becomes a json through JsonParse, a json's value
    comes out through j.AsString, j.AsInteger and the other members }
  if (TypeOf(Want).Kind = tykJson) and (E^.Kind <> ekNil) and
    (TypeOf(E^.Typ).Kind <> tykJson) and (TypeOf(E^.Typ).Kind <> tykParam) and
    (TypeOf(E^.Typ).Kind <> tykGeneric) then
    Refuse(TypName(E^.Typ) + ' does not go into json: JsonParse reads JSON text' + PosOf(E));
  if (TypeOf(E^.Typ).Kind = tykJson) and (Want <> TyNone) and (TypeOf(Want).Kind <> tykJson) and
    (TypeOf(Want).Kind <> tykParam) and (TypeOf(Want).Kind <> tykGeneric) then
    Refuse('a json does not go into ' + TypName(Want) +
      ': j.AsString, j.AsInteger and the other members read its value' + PosOf(E));
  if TypeOf(Want).Kind = tykCurrency then
  begin
    if ((TypeOf(E^.Typ).Kind = tykReal) and not UntypedReal(E)) or IsQuadTyp(E^.Typ) then
      Refuse('a real becomes Currency only through Currency(x)' + PosOf(E));
    Result := CurrOf(E);
    Exit;
  end;
  if (TypeOf(E^.Typ).Kind = tykCurrency) and (Want <> TyNone) and
    (TypeOf(Want).Kind <> tykParam) and (TypeOf(Want).Kind <> tykGeneric) then
    Refuse('a Currency needs an explicit conversion to ' + TypName(Want) + PosOf(E));
  if (Want > TyNone) and (TypeOf(Want).Kind = tykInterface) and
    (TypeOf(E^.Typ).Kind = tykClass) then
  begin
    Result := IfaceBind(E, Want);
    Exit;
  end;
  { P338: a routine value, a method value and an interface take only
    nil or a value of their kind (a class goes into an interface above):
    f := 5, m := 5 and v := 7 compiled, and m := b.Get, Get a function
    of no parameters, called it and kept its Integer as the code }
  if (Want > TyNone) and ((TypeOf(Want).Kind = tykProc) or (TypeOf(Want).Kind = tykMethod) or
    (TypeOf(Want).Kind = tykInterface)) and (E^.Kind <> ekNil) and (E^.Typ <> TyNone) and
    (TypeOf(E^.Typ).Kind <> tykParam) and (TypeOf(E^.Typ).Kind <> tykGeneric) and
    (TypeOf(E^.Typ).Kind <> TypeOf(Want).Kind) then
  begin
    if (TypeOf(Want).Kind = tykMethod) and (E^.Kind = ekMethod) and (E^.Name <> '') then
      Refuse(TypName(E^.Typ) + ' does not go into ' + TypName(Want) + ': this calls the method; ' +
        '@ before it gives the method value' + PosOf(E));
    Refuse(TypName(E^.Typ) + ' does not go into ' + TypName(Want) + PosOf(E));
  end;
  { VSplat8(1) where a V256 goes is a V256 (1.0.125). }
  if IsVecTyp(Want) and VecFlex(E) then
    VecFit(E, Want);
  { array of const (P124): a list in brackets is built for the call;
    another array of const passes on, and a slice of TVarRec goes too.
    Given, one is read, indexed, measured, walked, or passed on: it
    goes nowhere else, so nothing keeps it past the call. }
  if IsConstArr(Want) then
  begin
    if E^.Kind = ekSet then
    begin
      Result := ConstArrOf(E);
      Exit;
    end;
    if not (IsConstArr(E^.Typ) or (IsDynTyp(E^.Typ) and SameTyp(TypeOf(E^.Typ).Elem,
      TypeOf(Want).Elem))) then
      Refuse(TypName(E^.Typ) + ' does not go into an array of const: [a, b, ...] does' + PosOf(E));
    Exit;
  end;
  if IsConstArr(E^.Typ) and (Want <> TyNone) then
    Refuse('an array of const is read, indexed, measured, walked or passed on to another, ' +
      'not kept in ' + TypName(Want) + PosOf(E));
  { [a, b] where a slice goes is a slice (1.0.132), not a set. }
  if IsDynTyp(Want) and (E^.Kind = ekSet) then
  begin
    nl := NewNil;
    nl^.Typ := Want;
    Result := AppendCall(nl, E^.Args, 0);
    Exit;
  end;
  { RotateLeftToCarry($81) where a Byte goes rotates 8 bits (1.0.129). }
  if (E^.Kind = ekCall) and (E^.Name = 'rt_rot') and ((E^.Flags and 8) <> 0) and IsIntId(Want) then
  begin
    E^.Args[0] := ValArg(Want, E^.Args[0]);
    E^.Args[3]^.Num := IntBits(Want);
    E^.Typ := Want;
    E^.Flags := E^.Flags and not 8;
  end;
  { A real where an ordinal goes says how it rounds (1.0.103): i := r
    stored the real's bits, i := 2.5 gave 4612811918334230528. }
  if (TypeOf(E^.Typ).Kind = tykReal) and ((TypeOf(Want).Kind = tykInteger) or
    (TypeOf(Want).Kind = tykSubrange)) then
    { TypName, not the Name (1.0.136): a subrange's is empty. }
    Refuse('a real does not go into ' + TypName(Want) + ': Trunc or Round says how' +
      PosOf(E));
  if (TypeOf(E^.Typ).Kind = tykReal) and ((TypeOf(Want).Kind = tykEnum) or
    (TypeOf(Want).Kind = tykBoolean)) then
    Refuse('a real does not go into ' + TypName(Want) + PosOf(E));
  { A Quad (P103) widens every number; it becomes a narrower real only
    through a written conversion, and an integer through Trunc or Round. }
  if IsQuadTyp(E^.Typ) and not IsQuadTyp(Want) then
  begin
    if Want = TySingle then
      Refuse('a Quad becomes a Single only through Single(x)' + PosOf(E));
    if TypeOf(Want).Kind = tykReal then
      Refuse('a Quad becomes a Double only through Double(x)' + PosOf(E));
    if (TypeOf(Want).Kind = tykInteger) or (TypeOf(Want).Kind = tykSubrange) then
      Refuse('a Quad does not go into ' + TypName(Want) + ': Trunc or Round says how' +
        PosOf(E));
    if (TypeOf(Want).Kind = tykEnum) or (TypeOf(Want).Kind = tykBoolean) then
      Refuse('a Quad does not go into ' + TypName(Want) + PosOf(E));
  end;
  { A record, a static array, a string and a slice go only where their
    own type goes (1.0.120): i := r, r := i, s := r and r := r2 of
    another record compiled and moved words that did not belong. A Char
    still becomes a string (StrArg above), nil any slice; x as T sees
    the bytes of one as another. }
  if (TypeOf(Want).Kind <> tykParam) and (TypeOf(Want).Kind <> tykGeneric) and
    (TypeOf(E^.Typ).Kind <> tykParam) and (TypeOf(E^.Typ).Kind <> tykGeneric) and
    (E^.Typ <> TyNone) and (Want <> TyNone) and (Result^.Typ <> Want) and
    (not IsQuadTyp(Want)) and (not IsQuadTyp(E^.Typ)) then
  begin
    if (IsBlockTyp(Want) or IsBlockTyp(E^.Typ) or IsDynTyp(Want) or IsDynTyp(E^.Typ) or
      (TypeOf(Want).Kind = tykString) or (TypeOf(E^.Typ).Kind = tykString)) and
      not ((E^.Kind = ekNil) and IsDynTyp(Want)) and
      not ((TypeOf(Want).Kind = tykString) and (TypeOf(Result^.Typ).Kind = tykString)) and
      not SameTyp(Want, Result^.Typ) then
      Refuse(TypName(E^.Typ) + ' does not go into ' + TypName(Want) + '; x as T sees its bytes' +
        PosOf(E));
  end;
  { A class reference goes where a reference to its class or to an
    ancestor goes, and only there (P123): TClass takes any. }
  if (TypeOf(Want).Kind = tykClassRef) and (E^.Kind <> ekNil) then
  begin
    if TypeOf(E^.Typ).Kind <> tykClassRef then
      Refuse(TypName(E^.Typ) + ' does not go into ' + TypName(Want) + PosOf(E));
    if not ClassUnder(TypeOf(E^.Typ).Elem, TypeOf(Want).Elem) then
      Refuse(TypName(E^.Typ) + ' does not go into ' + TypName(Want) + ': ' +
        TypeOf(TypeOf(E^.Typ).Elem).Name + ' does not descend from ' +
        TypeOf(TypeOf(Want).Elem).Name + PosOf(E));
  end;
  if (TypeOf(E^.Typ).Kind = tykClassRef) and (Want <> TyNone) and
    (TypeOf(Want).Kind <> tykClassRef) and (TypeOf(Want).Kind <> tykParam) and
    (TypeOf(Want).Kind <> tykGeneric) then
    Refuse(TypName(E^.Typ) + ' does not go into ' + TypName(Want) + PosOf(E));
  { a list in brackets where a set goes is of that set's type, and a set
    goes where a set of its elements goes (P126) }
  if IsSetTyp(Want) and (E^.Kind = ekSet) then
  begin
    Result := SetLitTo(E, Want);
    Exit;
  end;
  if IsSetTyp(Want) and IsSetTyp(E^.Typ) and (E^.Typ <> Want) then
  begin
    Result := SetConvTo(Result, Want);
    Exit;
  end;
  { A set goes only where a set goes (1.0.136): i := [1, 2] stored its
    bitmask, 6, and P([3]) passed 8. }
  if (TypeOf(E^.Typ).Kind = tykSet) and (Want <> TyNone) and
    (TypeOf(Want).Kind <> tykSet) and (TypeOf(Want).Kind <> tykParam) and
    (TypeOf(Want).Kind <> tykGeneric) and (not IsDynTyp(Want)) then
    Refuse('a set does not go into ' + TypName(Want) + PosOf(E));
  { A map goes only where its own map type goes (1.0.140): a map[string]
    of Integer went into a map[Integer] of string parameter, and an
    integer into a map variable, in silence. }
  if ((TypeOf(Want).Kind = tykMap) or (TypeOf(Want).Kind = tykTree) or
    (TypeOf(Want).Kind = tykHeap)) and (E^.Kind <> ekNil) and (E^.Typ <> TyNone) and
    (TypeOf(E^.Typ).Kind <> tykParam) and (TypeOf(E^.Typ).Kind <> tykGeneric) and
    (not SameTyp(Want, Result^.Typ)) then
    Refuse(TypName(E^.Typ) + ' does not go into ' + TypName(Want) + PosOf(E));
  { Only a Boolean goes into a Boolean (1.0.116): t := i and t := t + t
    stored 5 or 2, printed as such, and t = True was then False. }
  k := TypeOf(E^.Typ).Kind;
  if (TypeOf(Want).Kind = tykBoolean) and (k <> tykBoolean) and (k <> tykNone) and
    (k <> tykParam) and (k <> tykGeneric) then
  begin
    if (k = tykInteger) or (k = tykSubrange) or (k = tykEnum) or (k = tykPointer) then
      Refuse(TypName(E^.Typ) + ' does not go into Boolean: Boolean(x) is x <> 0' + PosOf(E));
    Refuse(TypName(E^.Typ) + ' does not go into Boolean' + PosOf(E));
  end;
  if IsQuadTyp(Want) then
  begin
    Result := QuadOf(Result);
    Exit;
  end;
  if IsIntId(Want) then
  begin
    Result := CoerceInt(Result, Want);
    Exit;
  end;
  if TypeOf(Want).Kind <> tykReal then
    Exit;
  k := TypeOf(E^.Typ).Kind;
  { A real is worked out in the real type wanted (P101). }
  if k = tykReal then
  begin
    Result := RStamp(Result, Want);
    Exit;
  end;
  if (k <> tykInteger) and (k <> tykSubrange) then
    Exit;
  { A narrow integer's work is done in Integer before it becomes a real
    (P99). }
  if IsIntId(E^.Typ) then
    Stamp(E, TyInteger);
  Result := IntToRealT(E, Want);
end;

{ The integer E as the real type T: a constant now, rounded once to T;
  else rt_int2real or rt_i2s at run time. }
function TParser.IntToRealT(E: PExpr; T: LongInt): PExpr;
var
  a: TExprArray;
  d: Double;
  b: Int64;
begin
  if E^.Kind = ekInt then
  begin
    if T = TySingle then
    begin
      if not PasParseSingle(IntToStr(E^.Num), b) then
        b := 0;
      Result := NewReal(b);
      Result^.Typ := TySingle;
    end
    else
    begin
      d := E^.Num;
      Result := NewReal(RealBits(d));
    end;
    Exit;
  end;
  a := nil;
  SetLength(a, 1);
  a[0] := E;
  if T = TySingle then
    Result := NewCall('rt_i2s', a, TySingle)
  else
    Result := NewCall('rt_int2real', a, TyReal);
end;

{ Quad (P103, 1.0.114): IEEE binary128, worked out by the core unit
  pasquad through the rtq_ calls the emitter knows. }
function TParser.IsQuadTyp(T: LongInt): Boolean;
begin
  Result := TypeOf(T).Kind = tykQuad;
end;

{ A call of the Quad runtime on one argument, or two. }
function TParser.QCall(const N: string; A, B: PExpr; T: LongInt): PExpr;
var
  args: TExprArray;
begin
  args := nil;
  if B = nil then
    SetLength(args, 1)
  else
  begin
    SetLength(args, 2);
    args[1] := B;
  end;
  args[0] := A;
  Result := NewCall(N, args, T);
end;

{ The binary128 nearest to the number S says, rounded once from its
  digits (pasfmt's PasParseQuad): a Quad literal, its low word in Num
  and its high word in Hi. }
function TParser.QuadLit(const S: string): PExpr;
var
  lo, hi: Int64;
begin
  lo := 0;
  hi := 0;
  if not PasParseQuad(S, lo, hi) then
    Refuse('not a number: ' + S + BuiltinAt);
  if hi = Int64(32767) shl 48 then
    Refuse('constant ' + S + ' does not fit Quad' + BuiltinAt);
  Result := NewReal(lo);
  Result^.Hi := hi;
  Result^.Typ := TyQuad;
end;

{ A Quad literal of the words Lo and Hi; past the range an error. }
function TParser.QuadLitW(Lo, Hi: Int64): PExpr;
begin
  if ((Hi shr 48) and 32767) = 32767 then
    Refuse('a constant that does not fit Quad' + BuiltinAt);
  Result := NewReal(Lo);
  Result^.Hi := Hi;
  Result^.Typ := TyQuad;
end;

{ The 16 bytes of a Quad, low word first: a default value's image. }
function TParser.QuadBytes(Lo, Hi: Int64): string;
var
  i: LongInt;
begin
  Result := '';
  for i := 0 to 7 do
    Result := Result + Chr((Lo shr (8 * i)) and 255);
  for i := 0 to 7 do
    Result := Result + Chr((Hi shr (8 * i)) and 255);
end;

{ The little-endian word at byte At of S (a Quad default's image). }
function TParser.BytesWord(const S: string; At: LongInt): Int64;
var
  i: LongInt;
begin
  Result := 0;
  for i := 7 downto 0 do
    Result := (Result shl 8) or Ord(S[At + i + 1]);
end;

{ E worked out at compile time in binary128 (1.0.115), when it is made
  of constants: a literal from its digits, a named real constant from
  the binary128 value it was given, an integer exactly, + - * / and
  unary minus by pasquad, the same routines the program runs, so a
  constant is what the running program would have computed. }
function TParser.QFold(E: PExpr; out Lo, Hi: Int64): Boolean;
var
  al, ah, bl, bh: Int64;
begin
  Result := False;
  Lo := 0;
  Hi := 0;
  if E = nil then
    Exit;
  if (E^.Kind = ekReal) and IsQuadTyp(E^.Typ) then
  begin
    Lo := E^.Num;
    Hi := E^.Hi;
    Result := True;
  end
  else if (E^.Kind = ekReal) and ((E^.Flags and 2) <> 0) then
  begin
    Lo := E^.QLo;
    Hi := E^.Hi;
    Result := True;
  end
  else if E^.Kind = ekReal then
  begin
    if (E^.Txt <> '') and PasParseQuad(E^.Txt, Lo, Hi) then
      Result := True
    else if E^.Typ = TySingle then
    begin
      PasQFromDouble(PasF32ToF64(E^.Num), Lo, Hi);
      Result := True;
    end
    else
    begin
      PasQFromDouble(E^.Num, Lo, Hi);
      Result := True;
    end;
  end
  else if E^.Kind = ekInt then
  begin
    PasQFromInt(E^.Num, Lo, Hi);
    if TypeOf(E^.Typ).Kind = tykCurrency then
    begin
      PasQFromInt(10000, bl, bh);
      PasQDiv(Lo, Hi, bl, bh, al, ah);
      Lo := al; Hi := ah;
    end;
    Result := True;
  end
  else if (E^.Kind = ekUn) and (E^.Un = uoNeg) then
  begin
    Result := QFold(E^.L, Lo, Hi);
    Hi := Hi xor (Int64(1) shl 63);
  end
  else if (E^.Kind = ekBin) and ((E^.Bin = boAdd) or (E^.Bin = boSub) or
    (E^.Bin = boMul) or (E^.Bin = boSlash)) then
  begin
    if not (QFold(E^.L, al, ah) and QFold(E^.R, bl, bh)) then
      Exit;
    if E^.Bin = boAdd then
      PasQAdd(al, ah, bl, bh, Lo, Hi)
    else if E^.Bin = boSub then
      PasQSub(al, ah, bl, bh, Lo, Hi)
    else if E^.Bin = boMul then
      PasQMul(al, ah, bl, bh, Lo, Hi)
    else
      PasQDiv(al, ah, bl, bh, Lo, Hi);
    Result := True;
  end
  else if (E^.Kind = ekCall) and (Length(E^.Args) >= 1) and (Copy(E^.Name, 1, 4) = 'rtq_') then
  begin
    if not QFold(E^.Args[0], al, ah) then
      Exit;
    if (E^.Name = 'rtq_neg') or (E^.Name = 'rtq_i2q') or (E^.Name = 'rtq_d2q') then
    begin
      Lo := al;
      Hi := ah;
      if E^.Name = 'rtq_neg' then
        Hi := Hi xor (Int64(1) shl 63);
      Result := True;
      Exit;
    end;
    if (Length(E^.Args) < 2) or not QFold(E^.Args[1], bl, bh) then
      Exit;
    if E^.Name = 'rtq_add' then
      PasQAdd(al, ah, bl, bh, Lo, Hi)
    else if E^.Name = 'rtq_sub' then
      PasQSub(al, ah, bl, bh, Lo, Hi)
    else if E^.Name = 'rtq_mul' then
      PasQMul(al, ah, bl, bh, Lo, Hi)
    else if E^.Name = 'rtq_div' then
      PasQDiv(al, ah, bl, bh, Lo, Hi)
    else
      Exit;
    Result := True;
  end;
end;

{ E worked out as a Quad, as RStamp does for a Double or a Single: a
  Quad context takes an operation of reals down to its leaves; a
  constant with no type is read from its digits; an Integer, a Double
  and a Single widen exactly. An operation of integers is worked out in
  Integer first, as for a Double. }
function TParser.QuadOf(E: PExpr): PExpr;
var
  k: TTypeKind;
  op: string;
  lo, hi: Int64;
begin
  Result := E;
  if (E = nil) or IsQuadTyp(E^.Typ) then
    Exit;
  k := TypeOf(E^.Typ).Kind;
  if k = tykCurrency then
  begin
    Result := QCall('rtq_div', QCall('rtq_i2q', CurrRaw(E), nil, TyQuad),
      QuadLit('10000'), TyQuad);
    Exit;
  end;
  { A constant, a literal or an expression of them alone, is folded now,
    in binary128 (1.0.115): 1.1 + 2.2 and a named 1/3 keep 113 bits. }
  if (UntypedReal(E) or (E^.Kind = ekInt)) and QFold(E, lo, hi) then
  begin
    { A literal past the range is named: constant 1e5000 does not fit. }
    if (E^.Kind = ekReal) and (E^.Txt <> '') then
      Result := QuadLit(E^.Txt)
    else
      Result := QuadLitW(lo, hi);
    Exit;
  end;
  if (E^.Kind = ekReal) and ((E^.Flags and 1) <> 0) then
  begin
    if E^.Txt <> '' then
      Result := QuadLit(E^.Txt)
    else
      Result := QCall('rtq_d2q', E, nil, TyQuad);
    Exit;
  end;
  if E^.Kind = ekInt then
  begin
    Result := QuadLit(IntToStr(E^.Num));
    Exit;
  end;
  if (E^.Kind = ekBin) and ((k = tykReal) or UntypedReal(E)) and
    ((E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or (E^.Bin = boSlash)) then
  begin
    if E^.Bin = boAdd then
      op := 'rtq_add'
    else if E^.Bin = boSub then
      op := 'rtq_sub'
    else if E^.Bin = boMul then
      op := 'rtq_mul'
    else
      op := 'rtq_div';
    Result := QCall(op, QuadOf(E^.L), QuadOf(E^.R), TyQuad);
    Exit;
  end;
  if (E^.Kind = ekUn) and (E^.Un = uoNeg) and ((k = tykReal) or UntypedReal(E)) then
  begin
    Result := QuadNeg(QuadOf(E^.L));
    Exit;
  end;
  if (k = tykInteger) or (k = tykSubrange) then
  begin
    if IsIntId(E^.Typ) then
      Stamp(E, TyInteger);
    Result := QCall('rtq_i2q', E, nil, TyQuad);
    Exit;
  end;
  if k = tykReal then
  begin
    if E^.Typ = TySingle then
      E := QCall('rt_s2d', E, nil, TyReal);
    Result := QCall('rtq_d2q', E, nil, TyQuad);
    Exit;
  end;
  Refuse('a ' + FTypes[E^.Typ].Name + ' does not become a Quad' + PosOf(E));
end;

{ -E of a Quad: a literal's sign now, else the sign bit at run time. }
function TParser.QuadNeg(E: PExpr): PExpr;
begin
  if (E^.Kind = ekReal) and IsQuadTyp(E^.Typ) then
  begin
    Result := NewReal(E^.Num);
    Result^.Hi := E^.Hi xor (Int64(1) shl 63);
    Result^.Typ := TyQuad;
  end
  else
    Result := QCall('rtq_neg', E, nil, TyQuad);
end;

{ L Op R with a Quad side: both worked out as Quads; a comparison asks
  PasQCmp (-1, 0, 1, or 2 for a NaN, which no order holds), a >= b as
  b <= a. }
function TParser.QuadBin(Op: TBinOp; L, R: PExpr): PExpr;
var
  a, b, c: PExpr;
begin
  a := QuadOf(L);
  b := QuadOf(R);
  if Op = boAdd then
    Result := QCall('rtq_add', a, b, TyQuad)
  else if Op = boSub then
    Result := QCall('rtq_sub', a, b, TyQuad)
  else if Op = boMul then
    Result := QCall('rtq_mul', a, b, TyQuad)
  else if Op = boSlash then
    Result := QCall('rtq_div', a, b, TyQuad)
  else if (Op = boEq) or (Op = boNe) or (Op = boLt) or (Op = boLe) or (Op = boGt) or
    (Op = boGe) then
  begin
    if Op = boGe then
      c := QCall('rtq_cmp', b, a, TyInteger)
    else
      c := QCall('rtq_cmp', a, b, TyInteger);
    if Op = boEq then
      Result := NewBin(boEq, c, NewInt(0))
    else if Op = boNe then
      Result := NewBin(boNe, c, NewInt(0))
    else if Op = boLt then
      Result := NewBin(boEq, c, NewInt(-1))
    else if Op = boGt then
      Result := NewBin(boEq, c, NewInt(1))
    else
      Result := NewBin(boLe, c, NewInt(0));
    Result^.Typ := TyBoolean;
  end
  else
    Refuse('a Quad takes +, -, *, / and the comparisons' + PosOf(L));
end;

{ A routine of the calculation set that has no Quad form yet, given a
  Quad: an error that says to write Double(x), not code that would read
  the Quad's first word as a Double. }
function TParser.QuadGuard(E: PExpr): PExpr;
var
  i: SizeInt;
begin
  Result := E;
  if (E = nil) or (E^.Kind <> ekCall) or (Copy(E^.Name, 1, 3) <> 'rt_') then
    Exit;
  { the rotation words take a Quad's 128 bits (1.0.130) }
  if (E^.Name = 'rt_rotm') or (E^.Name = 'rt_funnelm') then
    Exit;
  for i := 0 to High(E^.Args) do
    if (E^.Args[i] <> nil) and (TypeOf(E^.Args[i]^.Typ).Kind = tykCurrency) then
      Refuse(Copy(E^.Name, 4, Length(E^.Name) - 3) +
        ' has no Currency form: write Double(x) for it' + PosOf(E));
  for i := 0 to High(E^.Args) do
    if (E^.Args[i] <> nil) and IsQuadTyp(E^.Args[i]^.Typ) then
      Refuse(Copy(E^.Name, 4, Length(E^.Name) - 3) + ' has no Quad form: write Double(x) for it' +
        PosOf(E));
end;

{ A real literal, a named real constant or an expression of them alone,
  with no type yet (P101). }
function TParser.UntypedReal(E: PExpr): Boolean;
begin
  Result := False;
  if E = nil then
    Exit;
  if E^.Kind = ekReal then
    Result := (E^.Flags and 1) <> 0
  else if E^.Kind = ekUn then
    Result := (E^.Un = uoNeg) and UntypedReal(E^.L)
  else if E^.Kind = ekBin then
    Result := ((E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or
      (E^.Bin = boSlash)) and (UntypedReal(E^.L) or UntypedInt(E^.L)) and
      (UntypedReal(E^.R) or UntypedInt(E^.R)) and
      (UntypedReal(E^.L) or UntypedReal(E^.R) or (E^.Bin = boSlash));
end;

{ The real type of an operation on L and R (P101): Single when a Single
  meets a Single, an integer or a constant with no type; else Double. }
function TParser.RealJoin(L, R: PExpr): LongInt;
var
  lr, rr: Boolean;
begin
  lr := TypeOf(L^.Typ).Kind = tykReal;
  rr := TypeOf(R^.Typ).Kind = tykReal;
  Result := TyReal;
  if lr and rr then
  begin
    if ((L^.Typ = TySingle) or UntypedReal(L)) and ((R^.Typ = TySingle) or UntypedReal(R)) and
      ((L^.Typ = TySingle) or (R^.Typ = TySingle)) then
      Result := TySingle;
  end
  else if lr then
  begin
    if L^.Typ = TySingle then
      Result := TySingle;
  end
  else if rr then
  begin
    if R^.Typ = TySingle then
      Result := TySingle;
  end;
end;

{ A constant with no type, in Single: from its digits, rounded once; out
  of Single's range, an error. }
function TParser.SingleOf(E: PExpr): Int64;
var
  b: Int64;
begin
  b := 0;
  if (E^.Txt <> '') and PasParseSingle(E^.Txt, b) then
    Result := b
  else
    Result := PasF64ToF32(E^.Num);
  if ((Result and $7FFFFFFF) = $7F800000) and
    ((E^.Num and $7FFFFFFFFFFFFFFF) <> $7FF0000000000000) then
    Refuse('constant ' + E^.Txt + ' does not fit Single' + PosOf(E));
end;

{ E worked out in the real type T (P101), as P99 does for integers: an
  operation of reals takes T down to its leaves; a constant with no type
  becomes T's nearest; a Single leaf under a Double widens, exactly; a
  Double leaf under a Single is an error, Single(x) says to round it.
  Integer leaves stay: the emitter converts them to T. }
function TParser.RStamp(E: PExpr; T: LongInt): PExpr;
var
  b: Int64;
begin
  Result := E;
  if (E = nil) or (TypeOf(T).Kind <> tykReal) or (TypeOf(E^.Typ).Kind <> tykReal) then
    Exit;
  if (E^.Typ = T) and not UntypedReal(E) then
    Exit;
  if E^.Kind = ekReal then
  begin
    if (E^.Flags and 1) = 0 then
    begin
      if E^.Typ <> T then
        Result := WidenLeaf(E, T);
      Exit;
    end;
    if (T = TySingle) and (E^.Typ <> TySingle) then
    begin
      E^.Num := SingleOf(E);
      E^.Typ := TySingle;
    end
    else if (T <> TySingle) and (E^.Typ = TySingle) then
    begin
      if not ((E^.Txt <> '') and PasParseReal(E^.Txt, b)) then
        b := PasF32ToF64(E^.Num);
      E^.Num := b;
      E^.Typ := T;
    end;
    Exit;
  end;
  if ((E^.Kind = ekBin) and ((E^.Bin = boAdd) or (E^.Bin = boSub) or
    (E^.Bin = boMul) or (E^.Bin = boSlash))) then
  begin
    E^.Typ := T;
    E^.L := RStamp(E^.L, T);
    E^.R := RStamp(E^.R, T);
    Exit;
  end;
  if (E^.Kind = ekUn) and (E^.Un = uoNeg) then
  begin
    E^.Typ := T;
    E^.L := RStamp(E^.L, T);
    Exit;
  end;
  if E^.Typ <> T then
    Result := WidenLeaf(E, T);
end;

{ A real leaf of one type where the other is wanted: a Single widens to
  a Double exactly; a Double does not become a Single by itself. }
function TParser.WidenLeaf(E: PExpr; T: LongInt): PExpr;
var
  a: TExprArray;
begin
  Result := E;
  if (E^.Typ = TySingle) and (T <> TySingle) then
  begin
    a := nil;
    SetLength(a, 1);
    a[0] := E;
    Result := NewCall('rt_s2d', a, T);
    PosFrom(Result, E);
  end
  else if (E^.Typ <> TySingle) and (T = TySingle) then
    Refuse('Double needs Single(x) to become a Single' + PosOf(E));
end;

{ Every real leaf of E is a Single, an integer or a constant with no
  type: Single(E) can be worked out in Single. }
function TParser.AllSingle(E: PExpr): Boolean;
begin
  Result := True;
  if E = nil then
    Exit;
  if TypeOf(E^.Typ).Kind <> tykReal then
    Exit;
  if UntypedReal(E) or (E^.Typ = TySingle) and not ((E^.Kind = ekBin) or (E^.Kind = ekUn)) then
    Exit;
  if (E^.Kind = ekBin) and ((E^.Bin = boAdd) or (E^.Bin = boSub) or
    (E^.Bin = boMul) or (E^.Bin = boSlash)) then
    Result := AllSingle(E^.L) and AllSingle(E^.R)
  else if (E^.Kind = ekUn) and (E^.Un = uoNeg) then
    Result := AllSingle(E^.L)
  else
    Result := E^.Typ = TySingle;
end;

{ T(E) for a real T and a real E (P101): Double(e) works e out in Double;
  Single(e) works it out in Single when all its leaves are Singles, else
  rounds the Double it gives, to the nearest, as Go's float32(x). }
function TParser.ConvertReal(E: PExpr; T: LongInt): PExpr;
var
  a: TExprArray;
begin
  Result := E;
  if T <> TySingle then
  begin
    Result := RStamp(E, T);
    Exit;
  end;
  if AllSingle(E) then
  begin
    Result := RStamp(E, TySingle);
    Exit;
  end;
  a := nil;
  SetLength(a, 1);
  a[0] := E;
  Result := NewCall('rt_d2s', a, TySingle);
end;

{ P422: a variable of type A fits a var or out parameter of type P: the
  same type, or for an open array an array of the same element; a
  generic's parameter is checked when it is specialized. }
function TParser.VarArgFits(P, A: LongInt): Boolean;
var
  kp, ka: TTypeKind;
begin
  kp := TypeOf(P).Kind;
  ka := TypeOf(A).Kind;
  if (kp = tykParam) or (kp = tykGeneric) or (ka = tykParam) or (ka = tykGeneric) then
    Result := True
  else if IsDynTyp(P) and IsDynTyp(A) then
    Result := VarArgFits(TypeOf(P).Elem, TypeOf(A).Elem)
  else
    Result := (P = A) or SameTyp(P, A);
end;

{ A var parameter takes the variable itself: no conversion there. }
procedure TParser.CoerceArgs(const Typs: array of LongInt; const ByRef: array of Boolean;
  var Args: TExprArray);
var
  i: SizeInt;
begin
  for i := 0 to High(Args) do
    if i <= High(Typs) then
    begin
      if (i <= High(ByRef)) and ByRef[i] then
      begin
        { A var integer takes its own type, the names of its row too
          (P99): a Byte passed for a var Integer would take 300. }
        if (Args[i] <> nil) and IsIntId(Typs[i]) and IsIntId(Args[i]^.Typ) and
          (Args[i]^.Typ <> Typs[i]) then
          Refuse('var parameter of type ' + FTypes[Typs[i]].Name + ' given a ' +
            FTypes[Args[i]^.Typ].Name + PosOf(Args[i]));
        { A static array is not a slice (1.0.144): one given for a var
          array of T arrived as an empty slice, and a slice for a var
          static array as its three words. }
        if (Args[i] <> nil) and (Args[i]^.Typ <> TyNone) and
          ((IsDynTyp(Typs[i]) and (TypeOf(Args[i]^.Typ).Kind = tykArray) and
          (not IsDynTyp(Args[i]^.Typ))) or
          ((TypeOf(Typs[i]).Kind = tykArray) and (not IsDynTyp(Typs[i])) and
          IsDynTyp(Args[i]^.Typ))) then
          Refuse(TypName(Args[i]^.Typ) + ' does not go into a var ' + TypName(Typs[i]) +
            ' parameter: a slice does' + PosOf(Args[i]));
        { P422: a var or out parameter takes a variable of its own type
          alone, as Pascal's reference says ("the actual parameter must
          be of exactly the same type as the formal parameter"): a Single
          given for a var Double had eight bytes written into its four, a
          TDer variable for a var TBase was given a TBase, an array of
          class references for a var array of records had its references
          read as records. An open array parameter takes any array of its
          element type, a named one too. }
        if (Args[i] <> nil) and (Args[i]^.Typ <> TyNone) and (Typs[i] <> TyNone) and
          not VarArgFits(Typs[i], Args[i]^.Typ) then
          Refuse('var parameter of type ' + TypName(Typs[i]) + ' given a ' + TypName(Args[i]^.Typ) +
            PosOf(Args[i]));
        { m[k] or m[k].X for a var parameter is the slot, inserted when
          the key was missing (1.0.140) }
        Args[i] := MapPutPlace(StrArg(Typs[i], Args[i]));
      end
      else
        Args[i] := ValArg(Typs[i], Args[i]);
    end;
end;

{ A method a call may name: all but a class constructor or destructor
  (P123), which only the program's start and end run. }
function CallableMeth(const M: TMethInfo): Boolean;
begin
  Result := not (M.IsClassMeth and (M.IsCtor or M.IsDtor));
end;

function TParser.PickMeth(const Meths: TMethArray; const AName: string;
  var Args: TExprArray; HaveArgs: Boolean; out Idx: SizeInt): Boolean;
begin
  Result := PickMethAt(Meths, AName, Args, HaveArgs, Idx, 0, 0);
end;

{ PickMeth, the method named at ALine:ACol (P340): a call with the wrong
  number of arguments is refused there; 0 for no place, the token's. }
function TParser.PickMethAt(const Meths: TMethArray; const AName: string;
  var Args: TExprArray; HaveArgs: Boolean; out Idx: SizeInt; ALine, ACol: LongInt): Boolean;
var
  i, j, nseen, nmatch, only: SizeInt;
  ok: Boolean;
  c, cost, best: LongInt;
begin
  Result := False;
  Idx := -1;
  nseen := 0;
  only := -1;
  for i := 0 to High(Meths) do
    if SameId(Meths[i].Name, AName) and CallableMeth(Meths[i]) then
    begin
      Inc(nseen);
      only := i;
    end;
  if nseen = 0 then
    Exit;
  if nseen = 1 then
  begin
    Idx := only;
    CoerceArgs(Meths[Idx].ParamTyps, Meths[Idx].ByRef, Args);
    if HaveArgs or not NeedsArgs(Meths[Idx]) then
      FillMethDefs(Meths[Idx], Args);
    { a call gives every argument that has no default, and no more (P125;
      a method called with too few took whatever the registers held) }
    if HaveArgs and (Length(Args) <> Meths[Idx].NParams) then
    begin
      if ALine > 0 then
        Refuse('wrong number of arguments for ' + AName + ' at ' + IntToStr(ALine) + ':' +
          IntToStr(ACol));
      Refuse('wrong number of arguments for ' + AName + HerePos);
    end;
    Result := True;
    Exit;
  end;
  nmatch := 0;
  best := -1;
  for i := 0 to High(Meths) do
    if SameId(Meths[i].Name, AName) and CallableMeth(Meths[i]) then
    begin
      ok := False;
      cost := 0;
      if not HaveArgs then
        ok := MinArgs(Meths[i]) = 0
      else if (Length(Args) >= MinArgs(Meths[i])) and (Length(Args) <= Meths[i].NParams) then
      begin
        ok := True;
        for j := 0 to High(Args) do
        begin
          if j > High(Meths[i].ParamTyps) then
            c := -1
          else
            c := MatchCost(Args[j], Meths[i].ParamTyps[j],
              (j <= High(Meths[i].ByRef)) and Meths[i].ByRef[j]);
          if c < 0 then
            ok := False
          else
            cost := cost + c;
        end;
      end;
      if ok then
      begin
        if (best < 0) or (cost < best) then
        begin
          best := cost;
          nmatch := 1;
          Idx := i;
        end
        else if cost = best then
          Inc(nmatch);
      end;
    end;
  if nmatch > 1 then
    Fail('ambiguous method ' + AName);
  if nmatch = 1 then
  begin
    CoerceArgs(Meths[Idx].ParamTyps, Meths[Idx].ByRef, Args);
    FillMethDefs(Meths[Idx], Args);
    Result := True;
    Exit;
  end;
  { at the method named (P340) }
  if ALine > 0 then
    Refuse('no matching overload for ' + AName + MethAt(ALine, ACol));
  Fail('no matching overload for ' + AName);
end;

function TParser.ListedProc(const Pr: TProc): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  { a used unit's routine of the name and parameters is another, which
    this one hides (P158) }
  for i := 0 to High(FProg.Procs) do
    if (FProg.Procs[i].ClassTyp = 0) and (not FProg.Procs[i].IsExt) and
      SameId(FProg.Procs[i].Name, Pr.Name) and
      (FProg.Procs[i].Nest = Pr.Nest) and SigEq(FProg.Procs[i].Params, Pr.Params) then
    begin
      Result := True;
      Exit;
    end;
end;

function TParser.SameProc(const AName: string; const Params: TParamArray): Boolean;
var
  i, j: SizeInt;
  same: Boolean;
begin
  Result := False;
  { a routine of the scope being read (P137): a nested one may take a
    name the program's routines have; a used unit's it hides (P158) }
  for i := FProcScope to High(FProcs) do
    if SameId(FProcs[i].Name, AName) and (FProcs[i].NParams = Length(Params)) and
      (FProcs[i].Owner = '') then
    begin
      same := True;
      for j := 0 to High(Params) do
        if (j > High(FProcs[i].ParamTyp)) or (FProcs[i].ParamTyp[j] <> Params[j].Typ) or
          ((j <= High(FProcs[i].ByRef)) and (FProcs[i].ByRef[j] <> Params[j].ByRef)) then
          same := False;
      if same then
      begin
        Result := True;
        Exit;
      end;
    end;
end;

function TParser.ResolveProc(const AName: string; const Args: TExprArray;
  out P: TProcEnt): Boolean;
var
  i, j, nseen, nmatch, need: SizeInt;
  top, next: LongInt;
  ok, more: Boolean;
  hit: TProcEnt;
  c, cost, best: LongInt;
  cand: array of Boolean;
  ranks: array of LongInt;
  at: string;
begin
  { the place its caller named, for this call alone (P340) }
  at := FCallAt;
  FCallAt := '';
  cand := nil;
  ranks := nil;
  Result := False;
  P := Default(TProcEnt);
  { the routines of the name a call sees, as in Free Pascal (P160): those
    of the innermost scope that has one, a nested routine's, the
    routine's around it, the program's or the unit's own, a later unit's
    before an earlier one's (P137, P138), and the next scope's too while
    one of them is declared overload; none a deeper name of another kind
    hides (P158, P159). A program's routine hid a unit's of its name only
    when their parameters were the same. }
  SetLength(cand, Length(FProcs));
  SetLength(ranks, Length(FProcs));
  for i := 0 to High(FProcs) do
  begin
    cand[i] := False;
    ranks[i] := -1;
  end;
  { the routines of the name, by their chain (P376) }
  i := NameGet(FProcHead, AName);
  while i >= 0 do
  begin
    if not HiddenBy(AName, FProcs[i].Nest, False) then
      ranks[i] := ProcRank(FProcs[i]);
    i := FProcs[i].Prev;
  end;
  top := High(LongInt);
  repeat
    next := -1;
    for i := 0 to High(FProcs) do
      if (ranks[i] >= 0) and (ranks[i] < top) and (ranks[i] > next) then
        next := ranks[i];
    more := False;
    if next >= 0 then
      for i := 0 to High(FProcs) do
        if ranks[i] = next then
        begin
          cand[i] := True;
          if FProcs[i].IsOver then
            more := True;
        end;
    top := next;
  until not more;
  nseen := 0;
  for i := 0 to High(FProcs) do
    if cand[i] then
      Inc(nseen);
  nmatch := 0;
  best := -1;
  hit := Default(TProcEnt);
  for i := 0 to High(FProcs) do
    if cand[i] then
    begin
      if Length(Args) > FProcs[i].NParams then
        Continue;
      need := 0;
      for j := 0 to FProcs[i].NParams - 1 do
        if (j > High(FProcs[i].HasDef)) or (not FProcs[i].HasDef[j]) then
          need := j + 1;
      if Length(Args) < need then
        Continue;
      ok := True;
      cost := 0;
      if nseen > 1 then
        for j := 0 to High(Args) do
        begin
          if j > High(FProcs[i].ParamTyp) then
            c := -1
          else
            c := MatchCost(Args[j], FProcs[i].ParamTyp[j],
              (j <= High(FProcs[i].ByRef)) and FProcs[i].ByRef[j]);
          if c < 0 then
            ok := False
          else
            cost := cost + c;
        end;
      if ok then
      begin
        if (best < 0) or (cost < best) then
        begin
          best := cost;
          nmatch := 1;
          hit := FProcs[i];
        end
        else if cost = best then
          Inc(nmatch);
      end;
    end;
  if nmatch > 1 then
  begin
    if at <> '' then
      Refuse('ambiguous call ' + AName + at);
    Fail('ambiguous call ' + AName);
  end;
  if nmatch = 1 then
  begin
    P := hit;
    Result := True;
    Exit;
  end;
  if nseen > 1 then
  begin
    { at the routine named (P340) }
    if at <> '' then
      Refuse('no matching overload for ' + AName + at);
    Fail('no matching overload for ' + AName);
  end;
end;

{ How far in a routine's scope is (P160): a routine of the program's or
  the unit's own, nested ones deeper, before every unit's, and a unit
  loaded later before one loaded earlier, as a uses clause is searched
  from its end. }
function TParser.ProcRank(const P: TProcEnt): LongInt;
var
  i: SizeInt;
begin
  if P.Owner = '' then
  begin
    Result := 1000000 + P.Nest;
    Exit;
  end;
  Result := 0;
  for i := 0 to High(FLoaded) do
    if SameId(FLoaded[i], P.Owner) then
      Result := LongInt(i) + 1;
end;

{ P75. A local written in a var section may not take a name the
  routine already uses: a parameter, the function itself, self, another
  local, or a field or a method of the class the method belongs to.
  Pascal lets some of those hide the outer name; paslangc resolved such
  a name to the outer one while the write went to the local, so the
  routine read what nobody had written, and nothing was said. Refusing
  it says so at the line where the mistake is. }
procedure TParser.CheckLocalName(const AName: string);
var
  i: SizeInt;
begin
  { self, result and the parameters are already locals by this point. }
  for i := 0 to High(FLocals) do
    if SameId(FLocals[i].Name, AName) then
    begin
      if SameId(AName, 'result') or SameId(AName, 'self') then
        Refuse('duplicate identifier ' + AName + DupAt);
      if i < FParamN then
        Refuse('duplicate identifier ' + AName + ' (it is a parameter)' + DupAt);
      Refuse('duplicate identifier ' + AName +
        ' (the routine already has one)' + DupAt);
    end;
  if FIsFunc and SameId(AName, FFuncName) then
    Refuse('duplicate identifier ' + AName + ' (it is the function)' + DupAt);
  if FNest > 0 then
    LocalDup(AName, 'v');
  CheckMemberName(AName);
end;

{ AName is a unit this one uses, not a core unit (P138): its name
  qualifies its names, ua.Twice. }
function TParser.IsUsedUnit(const AName: string): Boolean;
begin
  Result := HasStr(FLoaded, ToLower(AName)) and not IsCoreUnit(AName);
end;

{ The index of the routine AName of these parameters, -1 when there is
  none (P138). }
function TParser.SameProcIdx(const AName: string; const Params: TParamArray): SizeInt;
var
  i, j: SizeInt;
  same: Boolean;
begin
  Result := -1;
  for i := 0 to High(FProcs) do
    if SameId(FProcs[i].Name, AName) and (FProcs[i].NParams = Length(Params)) then
    begin
      same := True;
      for j := 0 to High(Params) do
        if (j > High(FProcs[i].ParamTyp)) or (FProcs[i].ParamTyp[j] <> Params[j].Typ) or
          ((j <= High(FProcs[i].ByRef)) and (FProcs[i].ByRef[j] <> Params[j].ByRef)) then
          same := False;
      if same then
      begin
        Result := i;
        Exit;
      end;
    end;
end;

{ The index of constant AName, the innermost, -1 when there is none
  (P137). }
function TParser.ConstIdx(const AName: string): SizeInt;
var
  owner: LongInt;
  i: SizeInt;
begin
  if (Pos('.', AName) = 0) and not HiddenAbove(AName, 0) then
  begin
    i := ContextIndex(AName, owner);
    if i >= 0 then
    begin
      Result := -1;
      if FTypes[owner].Nested[i].Kind = 1 then
      begin
        ScopedVis(owner, i);
        Result := ConstRefIndex(FTypes[owner].Nested[i].Ref);
      end;
      Exit;
    end;
  end;
  { the last constant of the name (P376) }
  Result := NameGet(FConstHead, AName);
end;

{ A name with a dot: a class variable's global (Class.Name, P123), a
  unit's name reached through the unit (ua.Name, P138). }
function HasDotName(const S: string): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  for i := 1 to Length(S) do
    if S[i] = '.' then
      Result := True;
end;

{ A type of this program's or unit's own (or the language's, a core
  unit's) is named AName (P155): a second declaration of it is a
  duplicate, where one a used unit declares is hidden by it, as in Free
  Pascal. NamedType, which this was, sees the imported names too, so a
  record could not hide a unit's type, and the other kinds checked
  nothing: an alias took a type's name in silence. }
function TParser.OwnTypeNamed(const AName: string): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  for i := High(FTypeNames) downto 0 do
    if SameId(FTypeNames[i].Name, AName) and (FTypeNames[i].Owner = '') then
    begin
      Result := True;
      Exit;
    end;
end;

{ What the program or the unit itself declares at its top level by the
  name AName (P158): 'p' a routine, 'c' a constant, 'v' a variable, 't'
  a type, ' ' nothing. A used unit's names are not its own; the
  language's and the core units' are. }
function TParser.OwnKind(const AName: string): Char;
var
  i: SizeInt;
begin
  Result := 'p';
  for i := 0 to High(FProcs) do
    if (FProcs[i].Owner = '') and (FProcs[i].Nest = 0) and SameId(FProcs[i].Name, AName) then
      Exit;
  Result := 'c';
  for i := 0 to High(FConsts) do
    if (FConsts[i].Owner = '') and SameId(FConsts[i].Name, AName) then
      Exit;
  Result := 'v';
  for i := 0 to High(FVars) do
    if ((not FVars[i].Ext) or FVars[i].Alias) and SameId(FVars[i].Name, AName) then
      Exit;
  Result := 't';
  if OwnTypeNamed(AName) then
    Exit;
  Result := ' ';
end;

{ AName, declared at the top level as a Kind ('p' a routine, 'c' a
  constant, 'v' a variable, 't' a type), is no name of another kind
  that the program or the unit declares (P158), as Free Pascal says
  duplicate identifier: a routine took a variable's name, a type a
  variable's or a routine's, in silence. The same kind twice is told
  where each kind is declared (P151, P155). }
procedure TParser.OwnDup(const AName: string; Kind: Char);
var
  k: Char;
begin
  if HasDotName(AName) then
    Exit;
  k := OwnKind(AName);
  if (k = ' ') or (k = Kind) then
    Exit;
  if k = 'p' then
    Refuse('duplicate identifier ' + AName + ' (a routine of the name)' + DupAt);
  if k = 'c' then
    Refuse('duplicate identifier ' + AName + ' (a constant of the name)' + DupAt);
  if k = 'v' then
    Refuse('duplicate identifier ' + AName + ' (a variable of the name)' + DupAt);
  Refuse('duplicate identifier ' + AName + ' (a type of the name)' + DupAt);
end;

{ A name the program or the unit declares at its top level hides the
  names of it that the units it uses declare, of every kind, and a
  later unit's name hides an earlier unit's, as in Free Pascal (P158):
  the plain name goes, the unit's name still reaches it (ua.Now). P138
  hid a unit's name only by one of its own kind, and a name of the
  program's that a unit had was a duplicate: a program could not call a
  variable Date with SysUtils in its uses. A routine (Kind 'p') hides
  the routines of its parameters; the others stay its overloads. Keep
  is the unit being read, whose own names stay. }
procedure TParser.HideUnitNames(const AName: string; Kind: Char; const Params: TParamArray;
  const Keep: string);
var
  i, j: SizeInt;
  hide, renamed: Boolean;
  u: string;
begin
  renamed := False;
  if HasDotName(AName) then
    Exit;
  for i := 0 to High(FProcs) do
    if (FProcs[i].Owner <> '') and (not SameId(FProcs[i].Owner, Keep)) and
      SameId(FProcs[i].Name, AName) then
    begin
      hide := True;
      if Kind = 'p' then
      begin
        hide := FProcs[i].NParams = Length(Params);
        for j := 0 to High(Params) do
          if hide and ((j > High(FProcs[i].ParamTyp)) or (FProcs[i].ParamTyp[j] <> Params[j].Typ) or
            ((j <= High(FProcs[i].ByRef)) and (FProcs[i].ByRef[j] <> Params[j].ByRef))) then
            hide := False;
      end;
      if hide then
      begin
        FProcs[i].Name := '.' + FProcs[i].Name;
        renamed := True;
      end;
    end;
  for i := 0 to High(FConsts) do
    if (FConsts[i].Owner <> '') and (not SameId(FConsts[i].Owner, Keep)) and
      SameId(FConsts[i].Name, AName) then
    begin
      FConsts[i].Name := '.' + FConsts[i].Name;
      renamed := True;
    end;
  if renamed then
    ChainsRebuild;
  { a unit's variable is named unit.Name in its symbol }
  for i := 0 to High(FVars) do
    if FVars[i].Ext and (not FVars[i].Alias) and SameId(FVars[i].Name, AName) then
    begin
      u := FVars[i].Sym;
      j := 1;
      while (j <= Length(u)) and (u[j] <> '.') do
        j := j + 1;
      if not SameId(Copy(u, 1, j - 1), Keep) then
        FVars[i].Name := '.' + FVars[i].Sym;
    end;
  i := 0;
  while i <= High(FTypeNames) do
    if (FTypeNames[i].Owner <> '') and (not SameId(FTypeNames[i].Owner, Keep)) and
      SameId(FTypeNames[i].Name, AName) then
    begin
      for j := i to High(FTypeNames) - 1 do
        FTypeNames[j] := FTypeNames[j + 1];
      SetLength(FTypeNames, Length(FTypeNames) - 1);
    end
    else
      i := i + 1;
end;

{ A declaration of AName inside a routine deeper than depth L (P159):
  a variable or a parameter of the routine being read (depth FNest) or of
  one around it, and a constant, a type or a nested routine of them,
  which the tables keep after the outermost routine's base while it is
  read. It hides what is declared at L and around it, whatever its kind,
  as in Free Pascal: a nested function X beside a global variable X is
  the function inside, where the global's value was read. }
function TParser.HiddenAbove(const AName: string; L: LongInt): Boolean;
begin
  Result := HiddenBy(AName, L, True);
end;

{ HiddenAbove, the deeper routines left out when Procs is False: a
  routine hides the routines around it unless it is declared overload,
  which the lookup of a routine sees for itself (P160). }
function TParser.HiddenBy(const AName: string; L: LongInt; Procs: Boolean): Boolean;
var
  i, s: SizeInt;
begin
  Result := False;
  if FNest <= L then
    Exit;
  Result := True;
  for i := 0 to High(FLocals) do
    if SameId(FLocals[i].Name, AName) then
      Exit;
  for s := 0 to High(FScopes) do
    if (s <= High(FScopeLevels)) and (FScopeLevels[s] > L) then
      for i := 0 to High(FScopes[s]) do
        if SameId(FScopes[s][i].Name, AName) then
          Exit;
  for i := FConstBase to High(FConsts) do
    if (FConsts[i].Nest > L) and SameId(FConsts[i].Name, AName) then
      Exit;
  for i := FTypeBase to High(FTypeNames) do
    if (FTypeNames[i].Nest > L) and SameId(FTypeNames[i].Name, AName) then
      Exit;
  if Procs then
    for i := FProcBase to High(FProcs) do
      if (FProcs[i].Nest > L) and SameId(FProcs[i].Name, AName) then
        Exit;
  Result := False;
end;

{ AName is a variable or a parameter of the routine being read, or the
  function itself (its result): no constant, type or nested routine of
  the routine may take it (P75, P137). Those of a routine around it an
  inner name hides (P159). }
function TParser.OwnLocalName(const AName: string): Boolean;
var
  i: SizeInt;
begin
  Result := True;
  if FIsFunc and (SameId(AName, 'result') or SameId(AName, FFuncName)) then
    Exit;
  for i := 0 to High(FLocals) do
    if SameId(FLocals[i].Name, AName) then
      Exit;
  Result := False;
end;

{ The tokens from here name a type, T or a used unit's ua.T, in Id
  (P158: SizeOf(ua.T), High(ua.TColor), class(ua.TBase), on E: ua.EFoo
  said unknown); nothing is read. }
function TParser.TypeAhead(out Id: LongInt): Boolean;
var
  nm: string;
begin
  Id := TyNone;
  nm := ReadTypePath;
  Result := NamedType(nm, Id);
end;

{ The longest token prefix that names a type, not its subsequent
  method/property. Each component follows ownership, not a flat alias. }
function TParser.ReadTypePath: string;
var
  dots, candidate: string;
  i, start: SizeInt;
  id: LongInt;
begin
  Result := FTok.Lexeme;
  if IsVarName(Result) then Exit;
  candidate := Result;
  dots := FLex.PeekDots;
  i := 1;
  while i <= Length(dots) do
  begin
    start := i;
    Inc(i);
    while (i <= Length(dots)) and (dots[i] <> '.') do Inc(i);
    candidate := candidate + Copy(dots, start, i - start);
    if NamedType(candidate, id) then Result := candidate;
  end;
end;

{ The type name from here as it is written, for a message: T or ua.T. }
function TParser.AheadName: string;
begin
  Result := ReadTypePath;
end;

{ Past the type name TypeAhead saw: T, or ua.T. }
procedure TParser.SkipTypeName;
var
  name: string;
  i: SizeInt;
begin
  name := ReadTypePath;
  { json.t and a number, the compiler's own name of a type, is one token (P205) }
  if not (FGenMode and (Copy(name, 1, 5) = 'json.')) then
    for i := 1 to Length(name) do
      if name[i] = '.' then
      begin FTok := FLex.Next; Eat(tkDot) end;
  FTok := FLex.Next;
end;

function TParser.TypeNameIdx(const AName: string): SizeInt;
begin
  Result := High(FTypeNames);
  while (Result >= 0) and not SameId(FTypeNames[Result].Name, AName) do
    Result := Result - 1;
end;

{ The routine being read has a nested routine AName (P137). }
function TParser.LocalProcNamed(const AName: string): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  for i := FProcScope to High(FProcs) do
    if SameId(FProcs[i].Name, AName) and (FProcs[i].Nest = FNest) then
      Result := True;
end;

{ AName, declared in the routine being read as a constant (Skip c), a
  type (t), a variable (v) or a nested routine (p), is no other name of
  that routine: a variable, a parameter, a constant, a type or a nested
  routine of it (P137). A name of the program's may be hidden. }
procedure TParser.LocalDup(const AName: string; Skip: Char);
begin
  { the routine's own variables and parameters; those of a routine
    around it the name hides (P159) }
  if (Skip <> 'v') and OwnLocalName(AName) then
    Refuse('duplicate identifier ' + AName + ' (the routine has a variable or a parameter of the name)' +
      DupAt);
  if (Skip <> 'c') and (ConstIdx(AName) >= FConstScope) then
    Refuse('duplicate identifier ' + AName + ' (the routine has a constant of the name)' + DupAt);
  if (Skip <> 'c') and (Skip <> 't') and (TypeNameIdx(AName) >= FTypeScope) then
    Refuse('duplicate identifier ' + AName + ' (the routine has a type of the name)' + DupAt);
  if (Skip = 'c') and (ConstIdx(AName) >= FConstScope) then
    Refuse('duplicate identifier ' + AName + DupAt);
  if (Skip = 't') and (TypeNameIdx(AName) >= FTypeScope) then
    Refuse('duplicate type ' + AName + DupAt);
  if (Skip <> 'p') and LocalProcNamed(AName) then
    Refuse('duplicate identifier ' + AName + ' (the routine has a nested routine of the name)' +
      DupAt);
end;

{ A local or a parameter of a method may not take the name of a field
  or a method of its class. A parameter was not checked, and a name that
  was both resolved to the method: Show(const Lab: string) printed what
  the method Lab returned, not its argument (1.0.53). FPC refuses both. }
procedure TParser.CheckMemberName(const AName: string);
var
  i: SizeInt;
  td: TTypeDef;
begin
  if FClassTyp <> 0 then
  begin
    td := TypeOf(FClassTyp);
    for i := 0 to High(td.Fields) do
      if SameId(td.Fields[i].Name, AName) then
        Refuse('duplicate identifier ' + AName + ' (it is a field of ' +
          td.Name + ')' + DupAt);
    for i := 0 to High(td.Meths) do
      if SameId(td.Meths[i].Name, AName) then
        Refuse('duplicate identifier ' + AName + ' (it is a method of ' +
          td.Name + ')' + DupAt);
  end;
end;

{ Visibility (1.0.137). The class that declared member Idx of class Cls
  (Kind 0 a field, 1 a method, 2 a property): a class starts with a copy
  of its parent's members, so the member is the parent's while the parent
  has it at the same place (a method the class overrode is its own). }
function TParser.MemberOwner(Cls, Kind: LongInt; Idx: SizeInt): LongInt;
var
  par: LongInt;
  up: Boolean;
begin
  Result := Cls;
  while True do
  begin
    par := FTypes[Result].Parent;
    if (par <= 0) or (par > High(FTypes)) or (par = Result) then
      Exit;
    if Kind = 0 then
      up := (Idx <= High(FTypes[par].Fields)) and
        SameId(FTypes[par].Fields[Idx].Name, FTypes[Result].Fields[Idx].Name)
    else if Kind = 1 then
      up := (Idx <= High(FTypes[par].Meths)) and
        (FTypes[par].Meths[Idx].Sym = FTypes[Result].Meths[Idx].Sym)
    else if Kind = 3 then
      up := (Idx <= High(FTypes[par].CVars)) and
        (FTypes[par].CVars[Idx].Sym = FTypes[Result].CVars[Idx].Sym)
    else
      up := (Idx <= High(FTypes[par].Props)) and
        SameId(FTypes[par].Props[Idx].Name, FTypes[Result].Props[Idx].Name);
    if not up then
      Exit;
    Result := par;
  end;
end;

{ A is class B or one of its descendants (1.0.137). A class that two
  units' .pi both carry is two types here with one stem: the stem
  decides, as it does for the VMT's symbol, and two units' classes of
  one name are two (P154; the name decided). }
function TParser.ClassUnder(A, B: LongInt): Boolean;
var
  k, n: LongInt;
begin
  Result := False;
  k := A;
  n := 0;
  while (k > 0) and (k <= High(FTypes)) and (n < 10000) do
  begin
    if (k = B) or (TypeStemOf(FTypes[k]) = TypeStemOf(FTypes[B])) then
    begin
      Result := True;
      Exit;
    end;
    k := FTypes[k].Parent;
    Inc(n);
  end;
end;

{ May the code being read use member Idx of class Cls (Kind as for
  MemberOwner)? As FPC (1.0.137): a private member in the unit or program
  that declared its class; a protected one there and in the methods of
  the class's descendants, in any unit; a strict private one in the
  methods of its class only; a strict protected one in the methods of its
  class and of its descendants. An imported class (from a .pi) was
  declared in another unit. The routines nested in a method and its
  closures are the method's code (FClassTyp stays). }
procedure TParser.CheckVis(Cls, Kind: LongInt; Idx: SizeInt; ALine, ACol: LongInt);
var
  v: Byte;
  owner: LongInt;
  ok: Boolean;
  nm, what: string;
begin
  { the encoders the compiler writes read every member (P205) }
  if FGenMode then
    Exit;
  if Kind = 0 then
  begin
    v := FTypes[Cls].Fields[Idx].Vis;
    nm := FTypes[Cls].Fields[Idx].Name;
  end
  else if Kind = 1 then
  begin
    v := FTypes[Cls].Meths[Idx].Vis;
    nm := FTypes[Cls].Meths[Idx].Name;
  end
  else if Kind = 3 then
  begin
    v := FTypes[Cls].CVars[Idx].Vis;
    nm := FTypes[Cls].CVars[Idx].Name;
  end
  else
  begin
    v := FTypes[Cls].Props[Idx].Vis;
    nm := FTypes[Cls].Props[Idx].Name;
  end;
  if v = VisPublic then
    Exit;
  owner := MemberOwner(Cls, Kind, Idx);
  if v = VisPrivate then
  begin
    ok := not FTypes[owner].Imported;
    what := 'private';
  end
  else if v = VisProtected then
  begin
    ok := (not FTypes[owner].Imported) or
      ((FClassTyp <> 0) and ClassUnder(FClassTyp, owner));
    what := 'protected';
  end
  else if v = VisStrictProtected then
  begin
    ok := (FClassTyp <> 0) and ClassUnder(FClassTyp, owner);
    what := 'strict protected';
  end
  else
  begin
    if FTypes[owner].Kind = tykHelper then
      ok := FHelperTyp = owner
    else
      ok := (FClassTyp <> 0) and ((FClassTyp = owner) or
        (TypeStemOf(FTypes[FClassTyp]) = TypeStemOf(FTypes[owner])));
    what := 'strict private';
  end;
  if not ok then
    Refuse(nm + ' is ' + what + ' to ' + FTypes[owner].Name + ' at ' +
      IntToStr(ALine) + ':' + IntToStr(ACol));
end;

{ AName is Result, the function's name, or a local or a parameter of the
  routine being read or of one around it: a name a member of Self does
  not hide. }
{ Str(x, s), Str(x:w, s), Str(x:w:d, s) (P134): s := x as Write writes
  it, padded to w and with d decimals; an enumeration's member by its
  name, as Free Pascal. }
function TParser.ParseStrStmt: PStmt;
var
  x, w, d, v: PExpr;
  a: TExprArray;
begin
  FTok := FLex.Next;
  Eat(tkLParen);
  x := ParseExpr;
  CheckTyped(x);
  w := nil;
  d := nil;
  if FTok.Kind = tkColon then
  begin
    FTok := FLex.Next;
    w := ParseExpr;
    if FTok.Kind = tkColon then
    begin
      FTok := FLex.Next;
      d := ParseExpr;
    end;
  end;
  Eat(tkComma);
  v := ParsePrimary;
  Eat(tkRParen);
  CheckOutVar(v, TyString, 'Str(x, s): s');
  a := nil;
  SetLength(a, 2);
  if (TypeOf(x^.Typ).Kind = tykEnum) or ((TypeOf(x^.Typ).Kind = tykSubrange) and
    (TypeOf(TypeOf(x^.Typ).Elem).Kind = tykEnum)) then
  begin
    if d <> nil then
      Refuse('decimals are for a real' + PosOf(d));
    SetLength(a, 3);
    a[1] := NewStr(EnumNames(x^.Typ));
    a[0] := AsInt(x, TyInteger);
    if w = nil then
      a[2] := NewInt(0)
    else
      a[2] := ValArg(TyInteger, w);
    x := CoreProc('PasEnumName', a, TyString);
  end
  else if (TypeOf(x^.Typ).Kind = tykReal) or IsQuadTyp(x^.Typ) or
    (TypeOf(x^.Typ).Kind = tykCurrency) then
  begin
    if w = nil then
      w := NewInt(0);
    x := FmtArg(x, w, d);
  end
  else if IntOperand(x) and not IsCharT(x^.Typ) then
  begin
    if d <> nil then
      Refuse('decimals are for a real' + PosOf(d));
    if w = nil then
      w := NewInt(0);
    x := FmtArg(ValArg(TyInteger, x), ValArg(TyInteger, w), nil);
  end
  else
    Refuse('Str takes a number or an enumeration''s member, not ' + TypName(x^.Typ) + PosOf(x));
  Result := NewStmt(skAssign);
  Result^.Dest := v;
  Result^.E := x;
end;

{ Val(s, v, code) (P134): v := the number, real or enumeration's member
  s writes, as Free Pascal's Val reads it; code 0, or the place of the
  first character that is none of it. An integer is read into its own
  type's range (P149, passtr's PasValRange, as Free Pascal 3.3.1's Val
  checks the destination's size): a number past it is an error at the
  digit that goes past, where the low bits were kept. }
function TParser.ParseValStmt: PStmt;
var
  src, v, code, tc, call, hq: PExpr;
  a: TExprArray;
  pre: TStmtArray;
  k: TTypeKind;
  vt, hqt: LongInt;
  asg, asc, asq: PStmt;
begin
  FTok := FLex.Next;
  Eat(tkLParen);
  src := AsStr(ParseExpr);
  Eat(tkComma);
  v := ParsePrimary;
  Eat(tkComma);
  code := ParsePrimary;
  Eat(tkRParen);
  CheckTyped(v);
  CheckTyped(code);
  vt := v^.Typ;
  k := TypeOf(vt).Kind;
  CheckOutVar(v, vt, 'Val(s, v, code): v');
  if not IntOperand(code) or IsCharT(code^.Typ) then
    Refuse('Val(s, v, code): code is an integer variable, not ' + TypName(code^.Typ) + PosOf(code));
  CheckOutVar(code, code^.Typ, 'Val(s, v, code): code');
  pre := nil;
  tc := HiddenVar(TyInteger, pre, nil);
  a := nil;
  if (k = tykEnum) or ((k = tykSubrange) and (TypeOf(TypeOf(vt).Elem).Kind = tykEnum)) then
  begin
    SetLength(a, 3);
    a[0] := src;
    a[1] := NewStr(EnumNames(vt));
    a[2] := tc;
    call := CoreProc('PasValEnum', a, TyInteger);
    call := AsInt(call, vt);
    call^.Typ := vt;
  end
  else if vt = TySingle then
  begin
    { a Single rounded once from the digits (P146): through the Double
      it was refused, Double needs Single(x) }
    SetLength(a, 2);
    a[0] := src;
    a[1] := tc;
    call := CoreProc('PasValSingle', a, TySingle);
  end
  else if IsQuadTyp(vt) then
  begin
    { a Quad rounded once from the digits (P146), its two words in a
      hidden pair seen as the Quad; through a Double it kept 53 bits }
    hqt := InternArray(TyInteger, 0, 1);
    hq := HiddenVar(hqt, pre, nil);
    SetLength(a, 3);
    a[0] := src;
    a[1] := tc;
    a[2] := NewIndex(NewVar(hq^.Name, hqt), NewInt(1), TyInteger);
    asq := NewStmt(skAssign);
    asq^.Dest := NewIndex(NewVar(hq^.Name, hqt), NewInt(0), TyInteger);
    asq^.E := CoreProc('PasValQuadLo', a, TyInteger);
    call := ViewOf(NewVar(hq^.Name, hqt), vt);
  end
  else if k = tykCurrency then
  begin
    SetLength(a, 2); a[0] := src; a[1] := tc;
    call := CoreProc('PasValCurrency', a, TyCurrency);
  end
  else if k = tykReal then
  begin
    SetLength(a, 2);
    a[0] := src;
    a[1] := tc;
    call := ValArg(vt, CoreProc('PasValReal', a, TyReal));
  end
  else if IntOperand(v) and not IsCharT(vt) then
  begin
    { the type's range, whether it is unsigned, and its width for the
      pattern a hexadecimal, octal or binary number may fill (0 for a
      subrange, whose bounds hold in every base) }
    SetLength(a, 6);
    a[0] := src;
    a[1] := NewInt(IntLo(vt));
    a[2] := NewInt(IntHi(vt));
    a[3] := NewInt(Ord(IntLo(vt) >= 0));
    a[3]^.Typ := TyBoolean;
    if IsIntId(vt) then
      a[4] := NewInt(IntBits(vt))
    else
      a[4] := NewInt(0);
    a[5] := tc;
    call := CoreProc('PasValRange', a, TyInteger);
    if IsIntId(vt) and (vt <> TyInteger) then
      call := ConvertInt(call, vt);
  end
  else
  begin
    Refuse('Val reads a number, a real or an enumeration''s member, not ' + TypName(vt) + PosOf(v));
    call := nil;
  end;
  asg := NewStmt(skAssign);
  asg^.Dest := v;
  asg^.E := call;
  asc := NewStmt(skAssign);
  asc^.Dest := code;
  if IsIntId(code^.Typ) and (code^.Typ <> TyInteger) then
    asc^.E := ConvertInt(NewVar(tc^.Name, TyInteger), code^.Typ)
  else
    asc^.E := NewVar(tc^.Name, TyInteger);
  Result := NewStmt(skBlock);
  if IsQuadTyp(vt) then
  begin
    SetLength(Result^.Stmts, 3);
    Result^.Stmts[0] := asq;
    Result^.Stmts[1] := asg;
    Result^.Stmts[2] := asc;
    Exit;
  end;
  SetLength(Result^.Stmts, 2);
  Result^.Stmts[0] := asg;
  Result^.Stmts[1] := asc;
end;

{ Enumeration T's members' names, each followed by a NUL (P134): what
  Str writes and Val reads; T may be a subrange of one. }
function TParser.EnumNames(T: LongInt): string;
var
  i, leaf: SizeInt;
  v: Int64;
  found: Boolean;
begin
  if (TypeOf(T).Kind = tykSubrange) and (TypeOf(T).Elem > 0) then
    T := TypeOf(T).Elem;
  Result := '';
  for v := 0 to TypeOf(T).Hi do
  begin
    found := False;
    for i := 0 to High(FConsts) do
      if (not found) and (FConsts[i].Value = v) and ((FConsts[i].Typ = T) or
        SameTyp(FConsts[i].Typ, T)) then
      begin
        { Strip unit and member qualification, including a hidden
          unit name's leading dot (P158). Str/Val use the leaf. }
        leaf := Length(FConsts[i].Name);
        while (leaf > 0) and (FConsts[i].Name[leaf] <> '.') do Dec(leaf);
        Result := Result + Copy(FConsts[i].Name, leaf + 1,
          Length(FConsts[i].Name) - leaf) + #0;
        found := True;
      end;
    if not found then
      Result := Result + IntToStr(v) + #0;
  end;
end;

{ A string word's argument as a string (P134): a Char becomes one. }
function TParser.AsStr(E: PExpr): PExpr;
begin
  CheckTyped(E);
  Result := StrArg(TyString, E);
  if not IsStrTyp(Result^.Typ) then
    Refuse('a string or a Char goes here, not ' + TypName(E^.Typ) + PosOf(E));
end;

{ T.Member after a type's name, FTok on the dot (P127): a static method
  of the helper for T. }
function TParser.TypeDot(T: LongInt): PExpr;
var
  mname: string;
  ml, mc: LongInt;
begin
  Eat(tkDot);
  if FTok.Lexeme = '' then
    Fail('member name');
  mname := FTok.Lexeme;
  ml := FTok.Line;
  mc := FTok.Col;
  FTok := FLex.Next;
  if ScopedValue(T, mname, Result) then Exit;
  if (HelperFor(T) = 0) or not HelperHas(HelperFor(T), mname) then
    Refuse('unknown member ' + mname + ' of ' + TypName(T) + ': no helper for it has one' +
      HerePos);
  Result := HelperMember(nil, HelperFor(T), mname, ml, mc);
end;

{ The index of record type T's field AName, -1 when it has none (P127). }
function TParser.RecFieldIdx(T: LongInt; const AName: string): SizeInt;
var
  i: SizeInt;
begin
  Result := -1;
  if TypeOf(T).Kind <> tykRecord then
    Exit;
  for i := 0 to High(FTypes[T].Fields) do
    if SameId(FTypes[T].Fields[i].Name, AName) then
    begin
      Result := i;
      Exit;
    end;
end;

{ Field I of record T named at ALine:ACol (P165): a strict private one
  only in the record's own methods, a private one only in its unit. }
procedure TParser.CheckRecField(T: LongInt; I: SizeInt; ALine, ACol: LongInt);
var
  f: TField;
begin
  if FGenMode then
    Exit;
  f := FTypes[T].Fields[I];
  if (f.Vis = VisStrictPrivate) and ((FHelperTyp = 0) or (FHelperTyp <> RecordHelper(T))) then
    Refuse(f.Name + ' is strict private to ' + FTypes[T].Name + ' at ' + IntToStr(ALine) + ':' +
      IntToStr(ACol));
  if (f.Vis = VisPrivate) and FTypes[T].Imported then
    Refuse(f.Name + ' is private to ' + FTypes[T].Name + '''s unit at ' + IntToStr(ALine) + ':' +
      IntToStr(ACol));
end;

{ Class T's object has member AName, as obj.AName reaches it (P172): a
  property, a field or a method of the class or of an ancestor, a class
  variable or property, ClassName and its kin, or Free. Its visibility
  is checked where it is used, as after a dot. }
function TParser.ClassHas(T: LongInt; const AName: string): Boolean;
var
  i: SizeInt;
begin
  Result := True;
  for i := 0 to High(FTypes[T].Props) do
    if SameId(FTypes[T].Props[i].Name, AName) then
      Exit;
  for i := 0 to High(FTypes[T].Fields) do
    if SameId(FTypes[T].Fields[i].Name, AName) then
      Exit;
  for i := 0 to High(FTypes[T].Meths) do
    if SameId(FTypes[T].Meths[i].Name, AName) then
      Exit;
  Result := (CVarIndex(T, AName) >= 0) or ClassPropNamed(T, AName) or IsClassWord(AName) or
    SameId(AName, 'Free');
end;

{ The innermost with whose record or object has member AName (P165): a
  field, or a method or a property of the record or of a helper for it;
  an object's member (P172); -1 when none has. }
function TParser.WithIdx(const AName: string): SizeInt;
var
  i: SizeInt;
  t, owner: LongInt;
  ni: SizeInt;
begin
  for i := High(FWith) downto 0 do
  begin
    t := FWith[i]^.Typ;
    ni := ScopedIndex(t, AName, owner);
    if (RecFieldIdx(t, AName) >= 0) or ((TypeOf(t).Kind = tykClass) and ClassHas(t, AName)) or
      ((ni >= 0) and (FTypes[owner].Nested[ni].Kind <> 0)) or
      (MemberHelper(t, AName) <> 0) then
    begin
      Result := i;
      Exit;
    end;
  end;
  Result := -1;
end;

function TParser.IsLocalName(const AName: string): Boolean;
var
  i, k: SizeInt;
begin
  Result := True;
  if FIsFunc and (SameId(AName, 'result') or SameId(AName, FFuncName)) then
    Exit;
  for i := 0 to High(FLocals) do
    if SameId(FLocals[i].Name, AName) then
      Exit;
  for k := 0 to High(FScopes) do
    for i := 0 to High(FScopes[k]) do
      if SameId(FScopes[k][i].Name, AName) then
        Exit;
  Result := False;
end;

{ A name read as a variable (1.0.137): Self's field when it is a field of
  the class whose method is being read, its visibility checked; else the
  variable. A field read inside a with, or called as a routine value,
  was an unknown identifier. }
function TParser.NameVar(const AName: string; ALine, ACol: LongInt): PExpr;
var
  i: SizeInt;
begin
  if (FClassTyp <> 0) and not IsLocalName(AName) then
    for i := 0 to High(FTypes[FClassTyp].Fields) do
      if SameId(FTypes[FClassTyp].Fields[i].Name, AName) then
      begin
        CheckVis(FClassTyp, 0, i, ALine, ACol);
        Result := NewField(NewVar('self', FClassTyp), FTypes[FClassTyp].Fields[i].Name,
          FTypes[FClassTyp].Fields[i].Typ, FTypes[FClassTyp].Fields[i].Off);
        Result^.PosLine := ALine;
        Result^.PosCol := ACol;
        Exit;
      end;
  Result := NewVar(VarSym(AName), VarTyp(AName));
  { where the name is (P340) }
  Result^.PosLine := ALine;
  Result^.PosCol := ACol;
end;

{ The destructor Free calls (1.0.137): the method Destroy of class Cls or
  of an ancestor, with no parameters; -1 when there is none. }
function TParser.DestroyOf(Cls: LongInt): SizeInt;
var
  i: SizeInt;
begin
  Result := -1;
  for i := 0 to High(FTypes[Cls].Meths) do
    if SameId(FTypes[Cls].Meths[i].Name, 'Destroy') and
      (FTypes[Cls].Meths[i].NParams = 0) and not FTypes[Cls].Meths[i].IsCtor then
      Result := i;
end;

{ The predefined names (1.0.138, German's decision): every name the
  parser knows as a word or as a type is reserved, and no declaration of
  a program or of a unit may take it: a variable, a constant, a type, a
  routine, a method, a parameter, a field, a property or an enumeration
  member of one of them is an error, as for program or begin. Until
  1.0.137 only the words added since 1.0.131 were; the older ones
  (Length, Sin, Min, Clear, PByte, Pi, ...) could be declared and hid
  the builtin, at times in silence and wrongly: a function Length was
  ignored and Length(5) gave an address. The table is filled once by
  InitReserved, in the constructor, from the families below, in
  lowercase, and sorted; ReservedName looks a name up by halving. The
  vector words are a rule (V and a shape VecShape knows), and what the
  core units export is a second list (CoreName), filled as they load.
  The lexer's keywords are not here: they never reach a name. }
procedure TParser.AddReserved(const Words: string);
var
  i, n, start: SizeInt;
begin
  i := 1;
  while i <= Length(Words) do
  begin
    while (i <= Length(Words)) and (Words[i] = ' ') do
      i := i + 1;
    start := i;
    while (i <= Length(Words)) and (Words[i] <> ' ') do
      i := i + 1;
    if i > start then
    begin
      n := Length(FReserved);
      SetLength(FReserved, n + 1);
      FReserved[n] := Copy(Words, start, i - start);
    end;
  end;
end;

{ Byte by byte, so the table's order is the search's on any host. }
function TParser.CmpName(const A, B: string): LongInt;
var
  i, n: SizeInt;
begin
  n := Length(A);
  if Length(B) < n then
    n := Length(B);
  for i := 1 to n do
    if A[i] <> B[i] then
    begin
      if A[i] < B[i] then
        Result := -1
      else
        Result := 1;
      Exit;
    end;
  if Length(A) < Length(B) then
    Result := -1
  else if Length(A) > Length(B) then
    Result := 1
  else
    Result := 0;
end;

procedure TParser.InitReserved;
var
  i, j: SizeInt;
  s: string;
begin
  FReserved := nil;
  { the operators and the declaration words (1.0.131) }
  AddReserved('nand nor xnor andnot sar rol ror forward overload override abstract');
  AddReserved('public private published protected strict operator inline cdecl');
  AddReserved('nostackframe packed');
  { the slice words (P109) }
  AddReserved('append cap');
  { Carry, the rotations and the shifts (P108) }
  AddReserved('carry carryon carryoff carryflip rotateleft rotateright');
  AddReserved('rotatelefttocarry rotaterighttocarry rotateleftthroughcarry');
  AddReserved('rotaterightthroughcarry shiftleft shiftright shiftrightsigned');
  AddReserved('shiftlefttocarry shiftrighttocarry shiftrightsignedtocarry');
  AddReserved('funnelleft funnelright');
  { the bit words (P105) }
  AddReserved('isbitset setbit togglebit getbits setbits popcount leadingzeros');
  AddReserved('trailingzeros reversebits byteswap atomicsetbit atomicclearbit');
  { the wide arithmetic (P106) }
  AddReserved('mulhi mulhis mul128 divmod128 addcarry subborrow addoverflow');
  AddReserved('suboverflow muloverflow addsat subsat');
  { the memory words (P106) and the atomics }
  AddReserved('loadfence storefence fullfence prefetch prefetchwrite cacheline');
  AddReserved('storent atomicload atomicstore atomicexchange atomicand atomicor');
  AddReserved('atomicxor atomicadd atomiccas loadbe16 loadbe32 loadbe64 loadle16');
  AddReserved('loadle32 loadle64 storebe16 storebe32 storebe64 storele16 storele32');
  AddReserved('storele64');
  { the processor's (P106) }
  AddReserved('cyclecount cyclefreq cpuhas cpufeatures amd64');
  { the ordinal, size, string, slice, map and memory words }
  AddReserved('ord chr succ pred low high odd sizeof length copy delete clear');
  AddReserved('pos insert concat upcase lowercase stringofchar str val');
  AddReserved('comparebyte indexbyte');
  AddReserved('rank keyat poplow pophigh sha256 merkleroot merkleproof merklecheck');
  AddReserved('push pop split join storeopen storeput storeget storedelete');
  AddReserved('storesync storeclose storeabandon include exclude');
  { the hash words (P111) }
  AddReserved('hex md5 sha1 sha224 sha384 sha512 sha3_224 sha3_256 sha3_384');
  { the digests in pieces (P440) }
  AddReserved('md5begin md5update md5final sha1begin sha1update sha1final');
  AddReserved('sha224begin sha224update sha224final sha256begin sha256update sha256final');
  AddReserved('sha384begin sha384update sha384final sha512begin sha512update sha512final');
  { the HMAC and SHA-3 in pieces (P443) }
  AddReserved('hmacmd5begin hmacmd5update hmacmd5final hmacsha1begin hmacsha1update');
  AddReserved('hmacsha1final hmacsha224begin hmacsha224update hmacsha224final');
  AddReserved('hmacsha256begin hmacsha256update hmacsha256final hmacsha384begin');
  AddReserved('hmacsha384update hmacsha384final hmacsha512begin hmacsha512update');
  AddReserved('hmacsha512final sha3_224begin sha3_224update sha3_224final');
  AddReserved('sha3_256begin sha3_256update sha3_256final sha3_384begin sha3_384update');
  AddReserved('sha3_384final sha3_512begin sha3_512update sha3_512final');
  AddReserved('sha3_512 hmacmd5 hmacsha1 hmacsha224 hmacsha256 hmacsha384');
  AddReserved('hmacsha512 crc32 crc32c adler32 fnv1a32 fnv1a64 murmur3 siphash');
  AddReserved('tryget default assigned setlength inc dec getmem freemem move jsonof jsondecode');
  AddReserved('tryjsondecode');
  AddReserved('fillchar view membase memsize memend');
  { the calculation set }
  AddReserved('abs sqr sqrt trunc round int frac floor ceil min max pi exp ln');
  AddReserved('lnxp1 log10 log2 logn power hypot ldexp poly sin cos tan cot sec');
  AddReserved('csc arcsin arccos arctan arctan2 arccot arcsec arccsc sinh cosh');
  AddReserved('tanh arcsinh arccosh arctanh isnan isinfinite fma');
  { the program's, the debugger's and the runtime's words }
  AddReserved('paramstr paramcount srcline erroutput syscall gccollect heapstat');
  AddReserved('heapcheck heapmaskof dumplocals breakpoint breakcount breakpc');
  AddReserved('continuebreak xxhash32 xxhash64 xxhash3 nanotime pause gid gcount');
  AddReserved('gosched goyield readyg canspin spinlock spinunlock parkmarked');
  AddReserved('parkunlock qsplice qwait qwaitback qwaitfront qwake1 qwakefirst');
  AddReserved('waitfd waitio waitms waitfront waitpush waittake');
  { the network words }
  AddReserved('netlisten netaccept netconnect netclose netread netwrite netport');
  { the RTTI words }
  AddReserved('propkind getpropint getpropstr setpropint setpropstr setpropmeth');
  AddReserved('callprop');
  { the predefined types and their pointers (Integer, Boolean and string
    are the lexer's) }
  AddReserved('byte uint8 int8 shortint word uint16 int16 smallint uint32');
  AddReserved('longword dword int32 int64 longint sizeint nativeint ptrint');
  AddReserved('cardinal qword uint64 rune char ansichar real double extended single quad currency');
  AddReserved('pointer pchar v128 v256 pbyte puint8 pint8 pshortint pword puint16');
  AddReserved('pint16 psmallint pdword plongword puint32 pint32 pinteger pint64');
  AddReserved('psingle pdouble pquad pboolean ppointer');
  { sorted once: a few hundred names }
  for i := 1 to High(FReserved) do
  begin
    s := FReserved[i];
    j := i;
    while (j > 0) and (CmpName(FReserved[j - 1], s) > 0) do
    begin
      FReserved[j] := FReserved[j - 1];
      j := j - 1;
    end;
    FReserved[j] := s;
  end;
end;

function TParser.ReservedName(const N: string): Boolean;
var
  l: string;
  lo, hi, mid: SizeInt;
  c: LongInt;
begin
  Result := True;
  l := ToLower(N);
  lo := 0;
  hi := High(FReserved);
  while lo <= hi do
  begin
    mid := (lo + hi) div 2;
    c := CmpName(FReserved[mid], l);
    if c = 0 then
      Exit;
    if c < 0 then
      lo := mid + 1
    else
      hi := mid - 1;
  end;
  { the vectors (P106): every V word }
  if (Length(l) > 1) and (l[1] = 'v') and (VecShape(Copy(l, 2, Length(l) - 1)) <> ' ') then
    Exit;
  Result := CoreName(N);
end;

{ What the core units export (1.0.138): Goid, Yield, TPasMutex,
  PasFmtReal and the rest are predefined in every program and unit, so
  they are reserved names there. The list fills as LoadUnitBody reads a
  core unit; it is empty while a core unit itself is compiled (LoadCore
  loads nothing into one), so a core unit declares its own exports and
  nothing else may. }
function TParser.CoreName(const N: string): Boolean;
begin
  { by the head table (P376) }
  Result := NameGet(FCoreHead, N) >= 0;
end;

procedure TParser.AddCoreName(const N: string);
var
  k: SizeInt;
begin
  if (N = '') or (N = '_') or CoreName(N) then
    Exit;
  k := Length(FCoreNames);
  SetLength(FCoreNames, k + 1);
  FCoreNames[k] := N;
  NameSet(FCoreHead, N, LongInt(k));
end;

{ The eleven units the language is built on: LoadCore links them into
  every program and unit without a uses clause. SQLite is the library
  unit sqlite, which a program names in its uses clause (P418). }
function TParser.IsCoreUnit(const AName: string): Boolean;
begin
  Result := SameId(AName, 'pasobject') or SameId(AName, 'pasroutines') or SameId(AName, 'pasmap') or
    SameId(AName, 'pashash') or SameId(AName, 'pastree') or
    SameId(AName, 'pasheap') or SameId(AName, 'pasfmt') or SameId(AName, 'pasquad') or
    SameId(AName, 'passtr') or SameId(AName, 'pasnum') or SameId(AName, 'pasjson');
end;

procedure TParser.CheckName(const N: string);
begin
  if FNameCheck and ReservedName(N) then
    Refuse(N + ' is a reserved word, not a name' + HerePos);
end;

{ A reserved word where a declaration's name goes, followed by one of
  the characters in Next: says so, where a section would otherwise just
  end and the next statement fail (var sleep: Integer). }
function TParser.ReservedHere(const Next: string): Boolean;
var
  c: Char;
  i: SizeInt;
begin
  Result := False;
  if (FTok.Kind = tkIdent) or not (IsName or TypeWord) then
    Exit;
  c := FLex.NextSolid;
  for i := 1 to Length(Next) do
    if Next[i] = c then
      Result := True;
  if Result then
    Fail(FTok.Lexeme + ' is a reserved word, not a name');
end;

procedure TParser.AddVar(const AName: string; Typ: LongInt; Local: Boolean);
var
  len, i: SizeInt;
begin
  CheckName(AName);
  { the program's global hides a used unit's names (P158); a local or a
    parameter hides them where it is (HiddenAbove) }
  if (not Local) and (FImporting = 0) then
  begin
    HideUnitNames(AName, 'v', nil, '');
    OwnDup(AName, 'v');
  end;
  { a constant of its own depth; one around it a routine's variable
    hides, as in Free Pascal (P159) }
  i := NameGet(FConstHead, AName);
  while i >= 0 do
  begin
    if (FConsts[i].Owner = '') and ((not Local) or (FConsts[i].Nest = FNest)) then
      Refuse('duplicate identifier ' + AName + ' (a constant of the name)' + DupAt);
    i := FConsts[i].Prev;
  end;
  { a routine of the program's or around it, at any depth: inside, a call
    of it would find the variable (P151) }
  i := NameGet(FProcHead, AName);
  while i >= 0 do
  begin
    if FProcs[i].Owner = '' then
      Refuse('duplicate identifier ' + AName + ' (a routine of the name)' + DupAt);
    i := FProcs[i].Prev;
  end;
  if Local then
  begin
    len := Length(FLocals);
    SetLength(FLocals, len + 1);
    FLocals[len].Name := AName;
    FLocals[len].Typ := Typ;
    FLocals[len].Init := '';
  end
  else
  begin
    len := Length(FVars);
    SetLength(FVars, len + 1);
    FVars[len].Name := AName;
    FVars[len].Typ := Typ;
    FVars[len].Init := '';
  end;
end;

procedure TParser.AddConst(const AName: string; V: Int64; Typ: LongInt);
begin
  AddConstEnt(DeclMemberName(AName), V, Typ, '');
end;

procedure TParser.AddConstEnt(const AName: string; V: Int64; Typ: LongInt; const S: string);
var
  len: SizeInt;
  dummy: TProcEnt;
  cv: Int64;
begin
  CheckName(AName);
  { the program's constant hides a used unit's names (P158) }
  if (FNest = 0) and (FImporting = 0) then
  begin
    HideUnitNames(AName, 'c', nil, '');
    OwnDup(AName, 'c');
  end;
  if FNest > 0 then
    { a routine's constant: of it alone (P137) }
    LocalDup(AName, 'c')
  else if FindConst(AName, cv) then
    Refuse('duplicate identifier ' + AName + ' (a constant of the name)' + DupAt)
  else if IsVarName(AName) then
    Refuse('duplicate identifier ' + AName + ' (a variable of the name)' + DupAt)
  else if FindProc(AName, dummy) then
    Refuse('duplicate identifier ' + AName + ' (a routine of the name)' + DupAt);
  len := Length(FConsts);
  SetLength(FConsts, len + 1);
  FConsts[len].Name := AName;
  FConsts[len].Value := V;
  FConsts[len].Typ := Typ;
  FConsts[len].Txt := S;
  FConsts[len].Nest := FNest;
  ConstChainAdd(len);
  if FUnitName <> '' then
    AddScoped(AName, Typ, 1, FUnitName + '.' + AName)
  else AddScoped(AName, Typ, 1, AName);
end;

{ The value of an untyped constant: an integer, a real, a string (with
  the #nn pieces a literal allows; a lone #nn is a Char), True, False,
  or the name of another constant, each with a leading minus where it
  makes sense (P97). }
{ The value of a constant expression (1.0.74): literals and named
  constants joined by the operators, with Ord, Chr, Succ, Pred, Abs, Sqr,
  Odd, SizeOf and the Length of a string; False when E is not constant.
  An integer result outside Int64 and a division by zero are errors, as
  in Go. Reals fold in binary64, the arithmetic the program would do.
  x xor -1 and not not x: 1.0.73, which builds this file, read not of an
  integer as a Boolean not. }
function TParser.ConstFold(E: PExpr; out V: Int64; out T: LongInt; out S: string): Boolean;
var
  lv, rv, mn, one: Int64;
  si: SizeInt;
  lt, rt: LongInt;
  ls, rs: string;
  ld, rd, d: Double;
  lk, rk: TTypeKind;
  c: LongInt;
begin
  Result := False;
  V := 0;
  T := TyInteger;
  S := '';
  if E = nil then
    Exit;
  mn := 1;
  mn := mn shl 63;
  lv := 0;
  rv := 0;
  lt := TyInteger;
  rt := TyInteger;
  ls := '';
  rs := '';
  case E^.Kind of
    ekInt:
      begin
        V := E^.Num;
        T := E^.Typ;
        Result := True;
      end;
    ekReal:
      begin
        { A Single's value, as the Double it is exactly (P101). }
        if E^.Typ = TySingle then
          V := PasF32ToF64(E^.Num)
        else
          V := E^.Num;
        T := TyReal;
        Result := True;
      end;
    ekStr:
      begin
        S := E^.Txt;
        T := TyString;
        Result := True;
      end;
    ekSet:
      begin
        { [1, 3, 5..7]: a word set's bits in V (1.0.77); a set of 32
          bytes its bytes in S (P126) }
        if not SetImage(E, ls) then
          Exit;
        if Length(ls) = 32 then
          S := ls
        else
        begin
          one := 0;
          for si := 8 downto 1 do
            one := (one shl 8) or Ord(ls[si]);
          V := one;
        end;
        T := E^.Typ;
        Result := True;
      end;
    ekUn:
      begin
        if not ConstFold(E^.L, lv, lt, ls) then
          Exit;
        lk := TypeOf(lt).Kind;
        if lk = tykString then
          Exit;
        if E^.Un = uoConv then
        begin
          V := WrapInt(lv, E^.Typ);
          T := E^.Typ;
        end
        else if BitUnOp(E^.Un) then
        begin
          V := FoldBitUn(E^.Un, lv, lt);
          T := E^.Typ;
        end
        else if E^.Un = uoNeg then
        begin
          if lk = tykReal then
          begin
            V := lv xor mn;
            T := TyReal;
          end
          else
          begin
            if lv = mn then
              Refuse('constant out of Integer range at ' + FConstAt);
            V := -lv;
            T := TyInteger;
          end;
        end
        else if lk = tykBoolean then
        begin
          V := lv xor 1;
          T := lt;
        end
        else
        begin
          V := lv xor -1;
          T := E^.Typ;
        end;
        Result := True;
      end;
    ekBin:
      begin
        if (E^.Bin = boIn) or (E^.Bin = boIs) or (E^.Bin = boAs) then
          Exit;
        if not ConstFold(E^.L, lv, lt, ls) then
          Exit;
        if not ConstFold(E^.R, rv, rt, rs) then
          Exit;
        lk := TypeOf(lt).Kind;
        rk := TypeOf(rt).Kind;
        if (E^.Bin = boConcat) or (lk = tykString) or (rk = tykString) then
        begin
          if lt = TyChar then
            ls := Char(lv)
          else if lk <> tykString then
            Exit;
          if rt = TyChar then
            rs := Char(rv)
          else if rk <> tykString then
            Exit;
          T := TyBoolean;
          case E^.Bin of
            boConcat, boAdd:
              begin
                S := ls + rs;
                T := TyString;
              end;
            boEq: if ls = rs then V := 1;
            boNe: if ls <> rs then V := 1;
            boLt: if ls < rs then V := 1;
            boLe: if ls <= rs then V := 1;
            boGt: if ls > rs then V := 1;
            boGe: if ls >= rs then V := 1;
          else
            Exit;
          end;
          Result := True;
          Exit;
        end;
        if (lk = tykReal) or (rk = tykReal) or (E^.Bin = boSlash) then
        begin
          if lk = tykReal then
            ld := BitsReal(lv)
          else
            ld := lv;
          if rk = tykReal then
            rd := BitsReal(rv)
          else
            rd := rv;
          d := 0;
          T := TyBoolean;
          case E^.Bin of
            boAdd: d := ld + rd;
            boSub: d := ld - rd;
            boMul: d := ld * rd;
            boSlash:
              begin
                if rd = 0 then
                  Refuse('division by zero in a constant at ' + FConstAt);
                d := ld / rd;
              end;
            boEq: if ld = rd then V := 1;
            boNe: if ld <> rd then V := 1;
            boLt: if ld < rd then V := 1;
            boLe: if ld <= rd then V := 1;
            boGt: if ld > rd then V := 1;
            boGe: if ld >= rd then V := 1;
          else
            Exit;
          end;
          if (E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or
            (E^.Bin = boSlash) then
          begin
            V := RealBits(d);
            T := TyReal;
          end;
          Result := True;
          Exit;
        end;
        T := E^.Typ;
        case E^.Bin of
          boAdd:
            begin
              V := lv + rv;
              if ((lv xor V) and (rv xor V)) < 0 then
                Refuse('constant out of Integer range at ' + FConstAt);
            end;
          boSub:
            begin
              V := lv - rv;
              if ((lv xor rv) and (lv xor V)) < 0 then
                Refuse('constant out of Integer range at ' + FConstAt);
            end;
          boMul:
            begin
              if ((lv = -1) and (rv = mn)) or ((rv = -1) and (lv = mn)) then
                Refuse('constant out of Integer range at ' + FConstAt);
              V := lv * rv;
              if (lv <> 0) and (V div lv <> rv) then
                Refuse('constant out of Integer range at ' + FConstAt);
            end;
          boDiv, boMod:
            begin
              if rv = 0 then
                Refuse('division by zero in a constant at ' + FConstAt);
              if (lv = mn) and (rv = -1) then
              begin
                if E^.Bin = boDiv then
                  Refuse('constant out of Integer range at ' + FConstAt);
                V := 0;
              end
              else if E^.Bin = boDiv then
                V := lv div rv
              else
                V := lv mod rv;
            end;
          boShl: V := lv shl (rv and 63);
          boShr:
            { Arithmetic in Int8, Int16 and Int32 (P99). }
            if IsNarrowId(T) and (IntLo(T) < 0) and (lv < 0) then
              V := ((lv xor -1) shr (rv and 63)) xor -1
            else
              V := lv shr (rv and 63);
          boSar, boRol, boRor:
            V := FoldRot(E^.Bin, lv, rv, T);
          boMulHi: V := FoldMulHi(lv, rv, False);
          boMulHiS: V := FoldMulHi(lv, rv, True);
          boAnd: V := lv and rv;
          boOr: V := lv or rv;
          boXor: V := lv xor rv;
          boEq: if lv = rv then V := 1;
          boNe: if lv <> rv then V := 1;
          boLt: if lv < rv then V := 1;
          boLe: if lv <= rv then V := 1;
          boGt: if lv > rv then V := 1;
          boGe: if lv >= rv then V := 1;
        else
          Exit;
        end;
        { A narrow operation keeps the low bits (P99). }
        if IsNarrowId(T) then
          V := WrapInt(V, T);
        Result := True;
      end;
    ekCall:
      begin
        if Length(E^.Args) <> 1 then
          Exit;
        if not ConstFold(E^.Args[0], lv, lt, ls) then
          Exit;
        lk := TypeOf(lt).Kind;
        if E^.Name = 'rt_length' then
        begin
          if lk = tykString then
            V := Length(ls)
          else if lt = TyChar then
            V := 1
          else
            Exit;
        end
        else if E^.Name = 'rt_chstr' then
        begin
          if lt <> TyChar then
            Exit;
          S := Char(lv);
          T := TyString;
        end
        else if (E^.Name = 'rt_absint') or (E^.Name = 'rt_sqrint') then
        begin
          if (lk = tykReal) or (lk = tykString) then
            Exit;
          if E^.Name = 'rt_absint' then
          begin
            if lv = mn then
              Refuse('constant out of Integer range at ' + FConstAt);
            V := lv;
            if lv < 0 then
              V := -lv;
          end
          else
          begin
            if (lv > 3037000499) or (lv < -3037000499) then
              Refuse('constant out of Integer range at ' + FConstAt);
            V := lv * lv;
          end;
        end
        else if E^.Name = 'rt_absreal' then
        begin
          if lk <> tykReal then
            Exit;
          V := lv and (mn xor -1);
          T := TyReal;
        end
        else if E^.Name = 'rt_sqrreal' then
        begin
          if lk <> tykReal then
            Exit;
          ld := BitsReal(lv);
          V := RealBits(ld * ld);
          T := TyReal;
        end
        else if E^.Name = 'rt_int2real' then
        begin
          if (lk = tykReal) or (lk = tykString) then
            Exit;
          ld := lv;
          V := RealBits(ld);
          T := TyReal;
        end
        else if E^.Name = 'rt_odd' then
        begin
          if (lk = tykReal) or (lk = tykString) then
            Exit;
          V := lv and 1;
          T := TyBoolean;
        end
        else if (E^.Name = 'rt_trunc') or (E^.Name = 'rt_round') or
          (E^.Name = 'rt_intpart') or (E^.Name = 'rt_fracpart') then
        begin
          { Trunc, Round, Int and Frac of a constant (P163), as Free
            Pascal's reference lists them, the values the program would
            work out: Trunc and Round in Integer's range (a tie of Round
            to even, cvtsd2si's and fcvtns'), Int an integral real (+0.0
            in -1..0, as rt_intpart), Frac what is left (0 from 2^63 on,
            a NaN of an infinity, one NaN on both machines) }
          if lk = tykString then
            Exit;
          if lk = tykReal then
            ld := BitsReal(lv)
          else
            ld := lv;
          if (E^.Name = 'rt_trunc') or (E^.Name = 'rt_round') then
          begin
            if not ((ld >= -9223372036854775808.0) and (ld < 9223372036854775808.0)) then
              Refuse('constant out of Integer range at ' + FConstAt);
            if E^.Name = 'rt_trunc' then
              V := Trunc(ld)
            else
              V := Round(ld);
            T := TyInteger;
          end
          else
          begin
            one := ((RealBits(ld) shr 52) and 2047);
            if E^.Name = 'rt_intpart' then
            begin
              if one >= 1086 then
                V := RealBits(ld)
              else
                V := RealBits(Trunc(ld));
            end
            else if one = 2047 then
              V := $7FF8000000000000
            else if one >= 1086 then
              V := 0
            else
              V := RealBits(ld - Trunc(ld));
            T := TyReal;
          end;
        end
        else
          Exit;
        Result := True;
      end;
  else
    Exit;
  end;
  c := T;
  if (c = TyChar) and ((V < 0) or (V > 255)) then
    Refuse('char code ' + IntToStr(V) + ' out of range at ' + FConstAt);
end;

{ A constant: any constant expression (1.0.74; one literal or name
  before), for a const declaration or a default value. }
procedure TParser.ParseConstValue(out V: Int64; out T: LongInt; out S: string);
var
  at, near: string;
  e: PExpr;
begin
  at := IntToStr(FTok.Line) + ':' + IntToStr(FTok.Col);
  near := FTok.Lexeme;
  FConstAt := at;
  e := ParseExpr;
  FConstAt := at;
  if not ConstFold(e, V, T, S) then
    Refuse('constant at ' + at + ' near ' + near);
  { A real constant's binary128 value, for a Quad to take (1.0.115). }
  FConstHasQ := False;
  if T = TyReal then
    FConstHasQ := QFold(e, FConstQLo, FConstQHi);
  { A real literal's digits, for a Single to round from once (P101). }
  if (T = TyReal) and (e^.Kind = ekReal) then
    S := e^.Txt
  else if (T = TyReal) and (e^.Kind = ekUn) and (e^.Un = uoNeg) and (e^.L <> nil) and
    (e^.L^.Kind = ekReal) and (e^.L^.Txt <> '') then
    S := '-' + e^.L^.Txt;
end;

procedure TParser.AppendStr(var A: TStrArray; const S: string);
var
  n: SizeInt;
begin
  n := Length(A);
  SetLength(A, n + 1);
  A[n] := S;
end;

procedure TParser.DelStr(var A: TStrArray; const S: string);
var
  i, j: SizeInt;
begin
  j := 0;
  for i := 0 to High(A) do
    if not SameId(A[i], S) then
    begin
      A[j] := A[i];
      j := j + 1;
    end;
  SetLength(A, j);
end;

function TParser.HasStr(const A: TStrArray; const S: string): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  for i := 0 to High(A) do
    if SameId(A[i], S) then
    begin
      Result := True;
      Exit;
    end;
end;

procedure TParser.AddProcEnt(const AName, ASym: string; IsFunc: Boolean; NParams, RetTyp: LongInt);
var
  len, i: SizeInt;
  cv: Int64;
begin
  { a method's own name, after its class's }
  i := Length(AName);
  while (i > 0) and (AName[i] <> '.') do
    Dec(i);
  CheckName(Copy(AName, i + 1, Length(AName) - i));
  { a constant of the top level; a nested routine hides the constants
    around it, its own routine's LocalDup tells (P159) }
  if (FNest = 0) and FindConst(AName, cv) then
    Refuse('duplicate identifier ' + AName + ' (a constant of the name)' + DupAt);
  { a routine of the top level may not take the name of a variable of
    the program's (P158); one of a used unit's it hides, which the
    routine's head did before (and a later unit's routine, LoadUnit). A
    nested routine hides the variables around it, a global or a unit's
    too, as in Free Pascal (P159; 1.0.136 refused a unit's, as its name
    read the variable in silence) }
  if (i = 0) and (FNest = 0) then
    for len := 0 to High(FVars) do
      if SameId(FVars[len].Name, AName) then
        Refuse('duplicate identifier ' + AName + ' (a variable of the name)' + DupAt);
  len := Length(FProcs);
  SetLength(FProcs, len + 1);
  FProcs[len].Name := AName;
  ProcChainAdd(len);
  FProcs[len].Sym := ASym;
  FProcs[len].IsFunc := IsFunc;
  FProcs[len].NParams := NParams;
  FProcs[len].RetTyp := RetTyp;
  FProcs[len].ParamTyp := nil;
  FProcs[len].ByRef := nil;
  FProcs[len].HasDef := nil;
  FProcs[len].Def := nil;
  FProcs[len].DefStr := nil;
  SetLength(FProcs[len].ParamTyp, NParams);
  SetLength(FProcs[len].ByRef, NParams);
  SetLength(FProcs[len].HasDef, NParams);
  SetLength(FProcs[len].Def, NParams);
  SetLength(FProcs[len].DefStr, NParams);
end;

procedure TParser.ApplyParams(const AName: string; const Params: TParamArray);
var
  i, j, nold, hit, fresh: SizeInt;
  oldHas: array[0..31] of Boolean;
  oldDef: array[0..31] of Int64;
  oldStr: array[0..31] of string;
  typed, zero: Boolean;
begin
  hit := -1;
  fresh := -1;
  for i := 0 to High(FProcs) do
    if SameId(FProcs[i].Name, AName) and (FProcs[i].NParams = Length(Params)) then
    begin
      typed := True;
      zero := True;
      for j := 0 to High(Params) do
      begin
        if (j > High(FProcs[i].ParamTyp)) or (FProcs[i].ParamTyp[j] <> Params[j].Typ) or
          ((j <= High(FProcs[i].ByRef)) and (FProcs[i].ByRef[j] <> Params[j].ByRef)) then
          typed := False;
        if (j <= High(FProcs[i].ParamTyp)) and (FProcs[i].ParamTyp[j] <> 0) then
          zero := False;
      end;
      if typed then
        hit := i
      else if zero then
        fresh := i;
    end;
  if hit < 0 then
    hit := fresh;
  if hit < 0 then
    Exit;
  i := hit;
  begin
      nold := Length(FProcs[i].HasDef);
      if nold > 32 then
        nold := 32;
      for j := 0 to nold - 1 do
      begin
        oldHas[j] := FProcs[i].HasDef[j];
        oldDef[j] := FProcs[i].Def[j];
        if j <= High(FProcs[i].DefStr) then
          oldStr[j] := FProcs[i].DefStr[j]
        else
          oldStr[j] := '';
      end;
      FProcs[i].NParams := Length(Params);
      SetLength(FProcs[i].ParamTyp, Length(Params));
      SetLength(FProcs[i].ByRef, Length(Params));
      SetLength(FProcs[i].HasDef, Length(Params));
      SetLength(FProcs[i].Def, Length(Params));
      SetLength(FProcs[i].DefStr, Length(Params));
      for j := 0 to High(Params) do
      begin
        FProcs[i].ParamTyp[j] := Params[j].Typ;
        FProcs[i].ByRef[j] := Params[j].ByRef;
        if Params[j].HasDef then
        begin
          FProcs[i].HasDef[j] := True;
          FProcs[i].Def[j] := Params[j].Def;
          FProcs[i].DefStr[j] := Params[j].DefStr;
        end
        else if j < nold then
        begin
          FProcs[i].HasDef[j] := oldHas[j];
          FProcs[i].Def[j] := oldDef[j];
          FProcs[i].DefStr[j] := oldStr[j];
        end
        else
        begin
          FProcs[i].HasDef[j] := False;
          FProcs[i].DefStr[j] := '';
        end;
      end;
      Exit;
    end;
end;

procedure TParser.FillDefaults(const P: TProcEnt; var Args: TExprArray);
var
  i, n: SizeInt;
  e: PExpr;
begin
  n := Length(Args);
  if n > P.NParams then
    Refuse('wrong number of arguments for ' + P.Name);
  CoerceArgs(P.ParamTyp, P.ByRef, Args);
  for i := n to P.NParams - 1 do
  begin
    if (i > High(P.HasDef)) or (not P.HasDef[i]) or (i > High(P.ParamTyp)) then
      Refuse('wrong number of arguments for ' + P.Name);
    if i <= High(P.DefStr) then
      e := DefaultArg(P.ParamTyp[i], P.Def[i], P.DefStr[i])
    else
      e := DefaultArg(P.ParamTyp[i], P.Def[i], '');
    SetLength(Args, i + 1);
    Args[i] := e;
  end;
end;

{ The argument a default value stands for, of parameter type Typ
  (P125: nil for a pointer's kin, a set's bits). }
function TParser.DefaultArg(Typ: LongInt; Def: Int64; const DefStr: string): PExpr;
var
  k: TTypeKind;
begin
  k := TypeOf(Typ).Kind;
  if Typ = TyString then
    Result := NewStr(DefStr)
  else if k = tykReal then
  begin
    Result := NewReal(Def);
    Result^.Typ := Typ;
  end
  else if IsQuadTyp(Typ) and (Length(DefStr) = 16) then
    Result := QuadLitW(BytesWord(DefStr, 0), BytesWord(DefStr, 8))
  else if IsWideSet(Typ) then
    Result := SetFromImage(DefStr, Typ)
  else if (k = tykPointer) or (k = tykClass) or (k = tykClassRef) or (k = tykProc) or
    (k = tykMethod) or (k = tykInterface) or IsDynTyp(Typ) then
  begin
    Result := NewNil;
    Result^.Typ := Typ;
  end
  else
  begin
    Result := NewInt(Def);
    Result^.Typ := Typ;
  end;
end;

{ A method's missing arguments, when each has a default (P125); left as
  they are otherwise, for the caller to say what is wrong. }
procedure TParser.FillMethDefs(const M: TMethInfo; var Args: TExprArray);
var
  i, n: SizeInt;
begin
  n := Length(Args);
  if n >= M.NParams then
    Exit;
  for i := n to M.NParams - 1 do
    if (i > High(M.HasDef)) or (not M.HasDef[i]) then
      Exit;
  for i := n to M.NParams - 1 do
  begin
    SetLength(Args, i + 1);
    if i <= High(M.DefStr) then
      Args[i] := DefaultArg(M.ParamTyps[i], M.Def[i], M.DefStr[i])
    else
      Args[i] := DefaultArg(M.ParamTyps[i], M.Def[i], '');
  end;
end;

{ = value after a method's parameter of type T (P125), the last NNames
  of M's parameters read: one parameter, not var or out. }
procedure TParser.MethParamDefault(var M: TMethInfo; NNames: SizeInt; ByRef: Boolean; T: LongInt);
var
  n, i: SizeInt;
  dv: Int64;
  ds: string;
begin
  n := Length(M.ParamTyps);
  SetLength(M.HasDef, n);
  SetLength(M.Def, n);
  SetLength(M.DefStr, n);
  if FTok.Kind <> tkEq then
  begin
    { no default after one: refused at this group's first name (P340);
      DefaultsLast, after the heading, had only the token after it }
    for i := 0 to n - NNames - 1 do
      if M.HasDef[i] then
        Refuse('default parameters must be last' + FGroupAt);
    Exit;
  end;
  if NNames <> 1 then
    Refuse('default value can only be assigned to one parameter' + HerePos);
  if ByRef then
    Refuse('default on var parameter' + HerePos);
  FTok := FLex.Next;
  ParseDefault(T, dv, ds);
  M.HasDef[n - 1] := True;
  M.Def[n - 1] := dv;
  M.DefStr[n - 1] := ds;
end;

procedure TParser.DefaultsLast(const M: TMethInfo);
var
  i: SizeInt;
  seen: Boolean;
begin
  seen := False;
  for i := 0 to High(M.HasDef) do
    if M.HasDef[i] then
      seen := True
    else if seen then
      Refuse('default parameters must be last' + HerePos);
end;

{ An ordinal constant expression: array bounds, subranges, case labels.
  A one-character string is its code. }
function TParser.ParseIntConst: Int64;
var
  at, near: string;
  e: PExpr;
  t: LongInt;
  v: Int64;
  txt: string;
begin
  at := IntToStr(FTok.Line) + ':' + IntToStr(FTok.Col);
  near := FTok.Lexeme;
  FConstAt := at;
  e := ParseExpr;
  FConstAt := at;
  if not ConstFold(e, v, t, txt) then
    Refuse('integer constant at ' + at + ' near ' + near);
  if TypeOf(t).Kind = tykString then
  begin
    if Length(txt) <> 1 then
      Refuse('integer constant at ' + at + ' near ' + near + ', which is not an integer');
    v := Ord(txt[1]);
  end
  else if (TypeOf(t).Kind = tykReal) or (TypeOf(t).Kind = tykCurrency) or IsQuadTyp(t) then
    Refuse('integer constant at ' + at + ' near ' + near + ', which is not an integer');
  Result := v;
end;

{ A subrange's bound (P126): a constant that ends before =, which is
  the declaration's (const S: set of 0..63 = [1]). }
function TParser.ParseBound(out T: LongInt): Int64;
var
  noeq: Boolean;
  at, near, txt: string;
  e: PExpr;
begin
  noeq := FNoEq;
  FNoEq := True;
  at := IntToStr(FTok.Line) + ':' + IntToStr(FTok.Col);
  near := FTok.Lexeme;
  FConstAt := at;
  e := ParseExpr;
  FConstAt := at;
  FNoEq := noeq;
  if not ConstFold(e, Result, T, txt) then
    Refuse('integer constant at ' + at + ' near ' + near);
  if TypeOf(T).Kind = tykString then
  begin
    if Length(txt) <> 1 then
      Refuse('integer constant at ' + at + ' near ' + near + ', which is not an integer');
    Result := Ord(txt[1]);
    T := TyChar;
  end
  else if (TypeOf(T).Kind = tykReal) or (TypeOf(T).Kind = tykCurrency) or IsQuadTyp(T) then
    Refuse('integer constant at ' + at + ' near ' + near + ', which is not an integer');
end;

{ The type a subrange's bounds of types A and B are values of (P135):
  Char, an enumeration, Boolean, or the integers. A subrange of one is
  its host's too: Mon..Fri's bounds may be another subrange's. }
function TParser.SubHost(A, B: LongInt): LongInt;

  function Host(T: LongInt): LongInt;
  begin
    if (TypeOf(T).Kind = tykSubrange) and (TypeOf(T).Elem > 0) then
      T := TypeOf(T).Elem;
    if (T = TyChar) or (TypeOf(T).Kind = tykEnum) then
      Result := T
    else if TypeOf(T).Kind = tykBoolean then
      Result := TyBoolean
    else
      Result := TyInteger;
  end;

begin
  Result := Host(A);
  if (Host(B) <> Result) and not SameTyp(Host(B), Result) then
    Refuse('a subrange''s bounds are of one type, not ' + TypName(Host(A)) + ' and ' +
      TypName(Host(B)) + SubAt);
end;

{ The subrange Lo..Hi of the constants of lo's type LT and hi's HT
  (P135): a subrange of Char, of an enumeration or of the integers. }
function TParser.ParseSubrange: LongInt;
var
  lo, hi: Int64;
  lt, ht: LongInt;
  at: string;
begin
  { refused where the subrange starts (P340), not at what follows it }
  at := HerePos;
  lo := ParseBound(lt);
  Eat(tkDotDot);
  hi := ParseBound(ht);
  FSubAt := at;
  Result := InternSubOf(SubHost(lt, ht), lo, hi);
  FSubAt := '';
end;

{ Where a refusal of the subrange being made goes (P340). }
function TParser.SubAt: string;
begin
  if FSubAt <> '' then
    Result := FSubAt
  else
    Result := HerePos;
end;

function TParser.ParseType: LongInt;
var
  id, elem, t: LongInt;
  lo, hi: Int64;
  k: TTokKind;
  isFn, pref, outerParam: Boolean;
  ptyps: array of LongInt;
  prefs: array of Boolean;
  pret, pt: LongInt;
  pn, pidx: SizeInt;
  rtd: TTypeDef;
  roff: LongInt;
  ilos, ihis: array of Int64;
  iidx: array of LongInt;
  iats: array of string;
  at: string;
begin
  k := FTok.Kind;
  t := TyInteger;
  if k = tkRecord then
  begin
    { A record with no name, where a type goes (1.0.116): r: record X:
      Integer end, as in FPC. It was "type expected got 38". }
    FTok := FLex.Next;
    rtd := Default(TTypeDef);
    rtd.Kind := tykRecord;
    rtd.Fields := nil;
    roff := ParseRecPart(rtd, 0, tkEnd);
    Eat(tkEnd);
    rtd.Size := RecEnd(rtd, roff);
    if rtd.Size < 1 then
      rtd.Size := 1;
    pn := Length(FTypes);
    SetLength(FTypes, pn + 1);
    FTypes[pn] := rtd;
    FTypes[pn].Name := '';
    Result := LongInt(pn);
    CheckJsonNames(Result);
    Exit;
  end;
  if k = tkClass then
  begin
    { class of T where a type goes (P123) }
    FTok := FLex.Next;
    Eat(tkOf);
    Result := ClassOfTarget;
    Exit;
  end;
  if (k = tkInteger) or ((k = tkIdent) and SameId(FTok.Lexeme, 'Integer')) then
  begin
    FTok := FLex.Next;
    t := TyInteger;
  end
  else if k = tkBoolean then
  begin
    FTok := FLex.Next;
    t := TyBoolean;
  end
  else if k = tkStringKw then
  begin
    FTok := FLex.Next;
    t := TyString;
  end
  else if (k = tkProcedure) or (k = tkFunction) then
  begin
    { A routine as a type: procedure(a, b: Integer) is a value that
      holds the address of one, and function(a: Integer): string is the
      same with an answer. With of object after it, it is a method
      value, which is a different animal: code and Self, and untyped,
      as it always was. }
    isFn := k = tkFunction;
    ptyps := nil;
    prefs := nil;
    FTok := FLex.Next;
    if FTok.Kind = tkLParen then
    begin
      FTok := FLex.Next;
      if FTok.Kind <> tkRParen then
      begin
        while True do
        begin
          pref := False;
          if (FTok.Kind = tkVar) or (FTok.Kind = tkOut) then
          begin
            pref := True;
            FTok := FLex.Next;
          end
          else if FTok.Kind = tkConst then
            FTok := FLex.Next;
          pn := 0;
          if not IsName then
            Fail('parameter name');
          while IsName do
          begin
            pn := pn + 1;
            FTok := FLex.Next;
            if FTok.Kind <> tkComma then
              Break;
            FTok := FLex.Next;
          end;
          Eat(tkColon);
          pt := ParamType(pref);
          for pidx := 1 to pn do
          begin
            SetLength(ptyps, Length(ptyps) + 1);
            SetLength(prefs, Length(prefs) + 1);
            ptyps[High(ptyps)] := pt;
            prefs[High(prefs)] := pref;
          end;
          if FTok.Kind <> tkSemi then
            Break;
          FTok := FLex.Next;
        end;
      end;
      Eat(tkRParen);
    end;
    pret := TyNone;
    if isFn then
    begin
      Eat(tkColon);
      pret := Self.ParseType;
    end;
    if FTok.Kind = tkOf then
    begin
      FTok := FLex.Next;
      Eat(tkObject);
      t := InternMethodSig(isFn, pret, ptyps, prefs);
    end
    else
      t := InternProc(isFn, pret, ptyps, prefs);
  end
  else if k = tkChan then
  begin
    FTok := FLex.Next;
    Eat(tkOf);
    elem := Self.ParseType;
    t := InternChan(elem);
  end
  else if k = tkMap then
  begin
    { map[K] of V, the associative cousin of array[..] of V. }
    FTok := FLex.Next;
    Eat(tkLBrack);
    at := HerePos;
    elem := Self.ParseType;
    Eat(tkRBrack);
    Eat(tkOf);
    lo := Self.ParseType;
    FSubAt := at;
    t := InternMap(elem, LongInt(lo));
    FSubAt := '';
  end
  else if k = tkTree then
  begin
    FTok := FLex.Next;
    if FTok.Kind = tkOf then
    begin
      FTok := FLex.Next;
      at := HerePos;
      elem := Self.ParseType;
      FSubAt := at;
      t := InternTree(elem, -1);
      FSubAt := '';
    end
    else
    begin
      Eat(tkLBrack);
      at := HerePos;
      elem := Self.ParseType;
      Eat(tkRBrack);
      Eat(tkOf);
      lo := Self.ParseType;
      FSubAt := at;
      t := InternTree(elem, LongInt(lo));
      FSubAt := '';
    end;
  end
  else if k = tkHeap then
  begin
    FTok := FLex.Next;
    Eat(tkOf);
    at := HerePos;
    elem := Self.ParseType;
    FSubAt := at;
    t := InternHeap(elem);
    FSubAt := '';
  end
  else if k = tkStore then
  begin
    FTok := FLex.Next;
    t := InternStore;
  end
  else if k = tkJson then
  begin
    FTok := FLex.Next;
    t := InternJson;
  end
  else if (k = tkMutex) or (k = tkRWMutex) or (k = tkWaitGroup) or
    (k = tkCond) or (k = tkOnce) then
  begin
    FTok := FLex.Next;
    t := CoreType(k);
  end
  else if k = tkCaret then
  begin
    FTok := FLex.Next;
    if (FTok.Kind = tkIdent) and (not TypeAhead(id)) and
      not (IsUsedUnit(FTok.Lexeme) and (FLex.NextSolid = '.')) then
    begin
      if not FInTypes then
        Refuse('unknown type ' + FTok.Lexeme + ' at ' + IntToStr(FTok.Line) +
          ':' + IntToStr(FTok.Col));
      t := ForwardPtr(DeclMemberName(FTok.Lexeme), IntToStr(FTok.Line) + ':' +
        IntToStr(FTok.Col));
      FTok := FLex.Next;
    end
    else
    begin
      elem := Self.ParseType;
      t := InternPtr(elem);
    end;
  end
  else if k = tkArray then
  begin
    FTok := FLex.Next;
    if FTok.Kind = tkLBrack then
    begin
      { each index a range or an ordinal type, array[Boolean],
        array[TColor], array[Char] (P161); several are an array of
        arrays, the first the outermost: array[1..3, 1..4] of T is
        array[1..3] of array[1..4] of T }
      pn := 0;
      ilos := nil;
      ihis := nil;
      iidx := nil;
      iats := nil;
      repeat
        FTok := FLex.Next;
        SetLength(iats, pn + 1);
        iats[pn] := HerePos;
        if (FTok.Kind = tkInteger) or (FTok.Kind = tkBoolean) or TypeAhead(id) then
          id := Self.ParseType
        else
          id := ParseSubrange;
        if not OrdBounds(id, lo, hi) then
          Refuse('an array''s index is an ordinal type or a range, not ' + TypName(id) + iats[pn]);
        SetLength(ilos, pn + 1);
        SetLength(ihis, pn + 1);
        SetLength(iidx, pn + 1);
        ilos[pn] := lo;
        ihis[pn] := hi;
        { a range of the integers keeps Integer as its index's type }
        if (id = TyInteger) or ((TypeOf(id).Kind = tykSubrange) and
          (TypeOf(id).Elem = TyInteger)) then
          iidx[pn] := 0
        else
          iidx[pn] := id;
        pn := pn + 1;
      until FTok.Kind <> tkComma;
      Eat(tkRBrack);
      Eat(tkOf);
      elem := Self.ParseType;
      for pidx := pn - 1 downto 0 do
      begin
        { hi - lo + 1 elements in 2^31 - 1 bytes at most: an index of the
          integers, or of a width that fills memory, is refused, where
          its size wrapped in silence }
        if (ihis[pidx] - ilos[pidx] < 0) or (ihis[pidx] - ilos[pidx] >= 2147483647) or
          ((ihis[pidx] - ilos[pidx] + 1) * Int64(ValSize(elem)) > 2147483647) then
          Refuse('an array from ' + IntToStr(ilos[pidx]) + ' to ' + IntToStr(ihis[pidx]) + ' of ' +
            TypName(elem) + ' does not fit in 2147483647 bytes' + iats[pidx]);
        elem := InternArrayIdx(elem, ilos[pidx], ihis[pidx], iidx[pidx]);
      end;
      t := elem;
    end
    else
    begin
      Eat(tkOf);
      if FTok.Kind = tkConst then
      begin
        { array of const (P124), a parameter's type }
        if not FParamType then
          Refuse('array of const is the type of a parameter' + HerePos);
        FTok := FLex.Next;
        t := InternConstArr;
      end
      else
      begin
        outerParam := FParamType;
        FParamType := False;
        elem := Self.ParseType;
        FParamType := outerParam;
        t := InternArray(elem, 0, -1);
      end;
    end;
  end
  else if k = tkSet then
  begin
    FTok := FLex.Next;
    Eat(tkOf);
    { refused at the element's type (P340) }
    at := HerePos;
    elem := Self.ParseType;
    FSubAt := at;
    t := InternSet(elem);
    FSubAt := '';
  end
  else if (k = tkInt) or (k = tkMinus) or (k = tkString) or (k = tkChar) then
    { 1..10, '0'..'9', #0..#31 (P135) }
    t := ParseSubrange
  else if k = tkSpecialize then
  begin
    FTok := FLex.Next;
    if FTok.Kind <> tkIdent then
      Expected('a generic type''s name after specialize');
    if not TypeAhead(id) then
      Refuse('unknown type ' + AheadName);
    SkipTypeName;
    Eat(tkLt);
    elem := Self.ParseType;
    Eat(tkGt);
    t := SpecType(id, elem);
  end
  else if k = tkIdent then
  begin
    if TypeAhead(id) then
    begin
      SkipTypeName;
      if TypeOf(id).Kind = tykGeneric then
        Refuse('specialize required for ' + TypeOf(id).Name);
      t := id;
    end
    else
    begin
      { A name that is neither a type nor a constant (a subrange's low
        bound): say so, not "integer constant ... k=1" (P88). }
      if not FindConst(FTok.Lexeme, lo) then
        Refuse('unknown type ' + FTok.Lexeme + ' at ' + IntToStr(FTok.Line) + ':' +
          IntToStr(FTok.Col));
      { Mon..Fri, a subrange of the enumeration (P135) }
      t := ParseSubrange;
    end;
  end
  else
    Refuse('a type is expected, not ' + FTok.Lexeme + HerePos);
  Result := t;
end;

function TParser.ParseIfaceType(const AName: string): LongInt;
var
  td, par: TTypeDef;
  names: array of string;
  nn, i, n, npar: SizeInt;
  slot, t, parent: LongInt;
  mname: string;
  isFunc, byref: Boolean;
begin
  td := Default(TTypeDef);
  td.Kind := tykInterface;
  td.Name := AName;
  td.Sym := UnitStem(AName);
  td.Size := 16;
  { an interface declared forward is the same type (P139) }
  Result := TakeFwd(AName);
  if Result < 0 then
    Result := AddNamedType(AName, td);
  td.Meths := nil;
  slot := 0;
  parent := 0;
  if FTok.Kind = tkLParen then
  begin
    FTok := FLex.Next;
    if FTok.Kind <> tkIdent then
      Expected('the parent interface''s name');
    { ua.IBase too (P158) }
    if not TypeAhead(parent) then
      Refuse('unknown identifier ' + AheadName);
    { one declared forward, or this one, is not whole yet (P139) }
    if (parent = Result) or IsFwdType(parent) then
      Refuse(AheadName + ' is not declared whole yet: a parent interface is declared before ' +
        'the interfaces that descend from it' + HerePos);
    par := TypeOf(parent);
    if par.Kind <> tykInterface then
      Refuse('an interface descends from an interface');
    SkipTypeName;
    Eat(tkRParen);
    n := Length(par.Meths);
    SetLength(td.Meths, n);
    for i := 0 to n - 1 do
      td.Meths[i] := par.Meths[i];
    slot := n;
    td.Parent := parent;
  end;
  while FTok.Kind <> tkEnd do
  begin
    if (FTok.Kind <> tkProcedure) and (FTok.Kind <> tkFunction) then
      Fail('procedure or function expected in an interface');
    isFunc := FTok.Kind = tkFunction;
    FTok := FLex.Next;
    if FTok.Kind <> tkIdent then
      Expected('a method''s name');
    mname := FTok.Lexeme;
    CheckName(mname);
    FTok := FLex.Next;
    n := Length(td.Meths);
    SetLength(td.Meths, n + 1);
    td.Meths[n].Name := mname;
    td.Meths[n].Sym := mname;
    td.Meths[n].IsFunc := isFunc;
    td.Meths[n].Slot := slot;
    td.Meths[n].NParams := 0;
    Inc(slot);
    npar := 0;
    if FTok.Kind = tkLParen then
    begin
      FTok := FLex.Next;
      if FTok.Kind <> tkRParen then
      begin
        while True do
        begin
          { an interface's method takes var, out and const parameters as a
            class's does (1.0.136: const was a syntax error) }
          byref := False;
          if (FTok.Kind = tkVar) or (FTok.Kind = tkOut) then
          begin
            byref := True;
            FTok := FLex.Next;
          end
          else if FTok.Kind = tkConst then
            FTok := FLex.Next;
          FGroupAt := HerePos;
          names := nil;
          nn := 0;
          while True do
          begin
            if not IsName then
              Expected('a parameter''s name');
            SetLength(names, nn + 1);
            CheckName(FTok.Lexeme);
            names[nn] := FTok.Lexeme;
            Inc(nn);
            FTok := FLex.Next;
            if FTok.Kind <> tkComma then
              Break;
            FTok := FLex.Next;
          end;
          Eat(tkColon);
          t := ParamType(byref);
          for i := 0 to nn - 1 do
          begin
            SetLength(td.Meths[n].ParamTyps, npar + 1);
            SetLength(td.Meths[n].ByRef, npar + 1);
            td.Meths[n].ParamTyps[npar] := t;
            td.Meths[n].ByRef[npar] := byref;
            Inc(npar);
          end;
          MethParamDefault(td.Meths[n], nn, byref, t);
          if FTok.Kind <> tkSemi then
            Break;
          FTok := FLex.Next;
        end;
      end;
      Eat(tkRParen);
    end;
    td.Meths[n].NParams := npar;
    td.Meths[n].RetTyp := TyNone;
    if isFunc then
    begin
      Eat(tkColon);
      td.Meths[n].RetTyp := Self.ParseType;
    end;
    Eat(tkSemi);
  end;
  Eat(tkEnd);
  td.VmtN := slot;
  FTypes[Result] := td;
end;

{ The symbol's end of a class constructor or destructor (P123), which
  keeps it apart from an object's Create and Destroy. }
function ClassLifeTag(IsCtor: Boolean): string;
begin
  if IsCtor then
    Result := '_cc'
  else
    Result := '_cd';
end;

function LifeWord(IsCtor: Boolean): string;
begin
  if IsCtor then
    Result := 'constructor'
  else
    Result := 'destructor';
end;

function ClassMethWord(IsClass: Boolean): string;
begin
  if IsClass then
    Result := ' class method'
  else
    Result := 'n object''s method';
end;

{ The class after class of (P123), its reference type the result. }
function TParser.ClassOfTarget: LongInt;
var
  t: LongInt;
begin
  if not IsName then
    Refuse('class of takes a class' + HerePos);
  { class of ua.TShape too (P158) }
  if (not TypeAhead(t)) or (TypeOf(t).Kind <> tykClass) then
    Refuse('class of takes a class, not ' + AheadName + HerePos);
  SkipTypeName;
  Result := InternClassRef(t);
end;

{ A class, read after its word class (the caller took it, to tell it
  from class of). }
{ The word helper after type, record or class (P127): helper, then for
  or the parent in parentheses; a record's first field may still be
  named helper. }
function TParser.IsHelperWord: Boolean;
var
  c: Char;
begin
  Result := False;
  if (FTok.Kind <> tkIdent) or not SameId(FTok.Lexeme, 'helper') then
    Exit;
  c := FLex.NextSolid;
  Result := (c = '(') or (c = 'f') or (c = 'F');
end;

{ The helper that holds record Rec's own methods and properties
  (P165): a record helper for it marked Hi 1, the first helper in scope
  for it, which a later helper for it descends from; named AName.rec in
  the .pi, where no program may name it, and its methods' symbols are
  the record's stem and their names, as a class's are. }
procedure TParser.MakeRecordHelper(Rec: LongInt; const AName: string; const Members: TTypeDef);
var
  td: TTypeDef;
  n, m, k: SizeInt;
begin
  td := Default(TTypeDef);
  td.Kind := tykHelper;
  td.Name := AName;
  td.Sym := UnitStem(AName);
  td.Elem := Rec;
  td.Lo := 1;
  td.Hi := 1;
  td.Size := 0;
  td.Meths := Members.Meths;
  td.Props := Members.Props;
  td.CVars := Members.CVars;
  td.ScopeOwner := Rec;
  n := Length(FTypes);
  SetLength(FTypes, n + 1);
  FTypes[n] := td;
  m := Length(FTypeNames);
  SetLength(FTypeNames, m + 1);
  FTypeNames[m].Name := AName + '.rec';
  FTypeNames[m].Id := LongInt(n);
  FTypeNames[m].Nest := FNest;
  k := Length(FHelpers);
  SetLength(FHelpers, k + 1);
  FHelpers[k] := LongInt(n);
  { a property reads and writes a field of the record or a method of it }
  for k := 0 to High(td.Props) do
  begin
    if (td.Props[k].ReadName <> '') and (td.Props[k].ReadOff < 0) and
      not HelperHas(LongInt(n), td.Props[k].ReadName) then
      Refuse(AName + '.' + td.Props[k].Name + ' reads ' + td.Props[k].ReadName +
        ', which is no field or method of the record');
    if (td.Props[k].WriteName <> '') and (td.Props[k].WriteOff < 0) and
      not HelperHas(LongInt(n), td.Props[k].WriteName) then
      Refuse(AName + '.' + td.Props[k].Name + ' writes ' + td.Props[k].WriteName +
        ', which is no field or method of the record');
  end;
  CheckRecordClassProps(LongInt(n));
end;

{ Static accessors must implement the declared property's type and
  arity, even if the property is never used (P168). Class storage is
  checked here too; it is not an instance field with a similar name. }
procedure TParser.CheckRecordClassProps(H: LongInt);
var
  i, j, side, ci: SizeInt;
  td: TTypeDef;
  pr: TPropInfo;
  acc, role: string;
  good: Boolean;
begin
  td := TypeOf(H);
  for i := 0 to High(td.Props) do
  begin
    pr := td.Props[i];
    if not pr.IsClass then Continue;
    for side := 0 to 1 do
    begin
      if side = 0 then begin acc := pr.ReadName; role := 'getter' end
      else begin acc := pr.WriteName; role := 'setter' end;
      if acc = '' then Continue;
      ci := CVarIndex(H, acc);
      if ci >= 0 then
      begin
        if not SameTyp(td.CVars[ci].Typ, pr.Typ) then
        begin
          { at the property (P340), not where the check runs }
          if pr.At <> '' then
            Refuse(td.Name + '.' + pr.Name + ': class variable ' + acc + ' has type ' +
              TypName(td.CVars[ci].Typ) + ', not ' + TypName(pr.Typ) + pr.At);
          Refuse(td.Name + '.' + pr.Name + ': class variable ' + acc + ' has type ' +
            TypName(td.CVars[ci].Typ) + ', not ' + TypName(pr.Typ) + HerePos);
        end;
        Continue;
      end;
      good := False;
      for j := 0 to High(td.Meths) do
        if SameId(td.Meths[j].Name, acc) and td.Meths[j].IsStatic and
          CallableMeth(td.Meths[j]) and (td.Meths[j].NParams = side) and
          (td.Meths[j].IsFunc = (side = 0)) then
        begin
          if side = 0 then
            good := SameTyp(td.Meths[j].RetTyp, pr.Typ)
          else
            good := not td.Meths[j].ByRef[0] and SameTyp(td.Meths[j].ParamTyps[0], pr.Typ);
          if good then Break;
        end;
      if not good then
        Refuse(td.Name + '.' + pr.Name + ' requires a static ' + role + ' of ' +
          TypName(pr.Typ) + HerePos);
    end;
  end;
end;

{ A record's member begins here (P165): a method, a constructor, a
  class method, a property, or a visibility section. }
function TParser.RecMemberAhead: Boolean;
begin
  Result := (FTok.Kind = tkProcedure) or (FTok.Kind = tkFunction) or
    (FTok.Kind = tkConstructor) or (FTok.Kind = tkDestructor) or (FTok.Kind = tkClass) or
    (FTok.Kind = tkProperty) or (FTok.Kind = tkVar) or (FTok.Kind = tkConst) or
    (FTok.Kind = tkType) or ((FTok.Kind = tkIdent) and (SameId(FTok.Lexeme, 'private') or
    SameId(FTok.Lexeme, 'public') or SameId(FTok.Lexeme, 'protected') or
    SameId(FTok.Lexeme, 'published') or SameId(FTok.Lexeme, 'strict')));
end;

{ The helper that holds record Rec's own methods and properties (P165):
  a record helper for it marked Hi 1, the first of its helpers; 0 when
  the record has none. }
function TParser.RecordHelper(Rec: LongInt): LongInt;
var
  i: SizeInt;
begin
  Result := 0;
  for i := 0 to High(FHelpers) do
    if (FTypes[FHelpers[i]].Lo = 1) and (FTypes[FHelpers[i]].Hi = 1) and
      ((FTypes[FHelpers[i]].Elem = Rec) or SameTyp(FTypes[FHelpers[i]].Elem, Rec)) then
    begin
      Result := FHelpers[i];
      Exit;
    end;
end;

{ One member of a helper (P127) or of a record Rec (P165; 0 for a
  helper), after its visibility Vis: a property, or a method, a class
  one static; a record's may be a constructor, a static class function
  whose value is the new record, and its properties may read and write
  its Fields, which the record's type has only when it is whole. }
procedure TParser.ParseHelperMember(var Td: TTypeDef; const AName: string; Vis: Byte;
  Rec: LongInt; const Fields: TFieldArray);
var
  pt, npar, t: LongInt;
  n, i, nn, ov: SizeInt;
  names: array of string;
  nats: array of string;   { where each name is (P340) }
  mname, rname, wname, baseSym, mpos, Who, gname: string;
  isFunc, isClassM, isStat, byref, eq, isCtor, isDtor: Boolean;
  check: TTypeDef;
  nindex: LongInt;
  jname: string;
  jflags: LongInt;
begin
  if (FTok.Kind = tkConst) or (FTok.Kind = tkType) then
  begin
    check := Td;
    check.Fields := Fields;
    ParseMemberSection(FMemberScope, Vis, check);
    Exit;
  end;
  if Rec <> 0 then
    Who := 'a record'
  else
    Who := 'a helper';
  isClassM := False;
  if FTok.Kind = tkClass then
  begin
    FTok := FLex.Next;
    isClassM := True;
  end;
  { a record's class operator (P171) }
  if isClassM and (Rec <> 0) and (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'operator') then
  begin
    ParseRecOperator(Rec, AName, True);
    Exit;
  end;
  if isClassM and (FTok.Kind = tkVar) and (Rec <> 0) then
  begin
    FTok := FLex.Next;
    while (FTok.Kind = tkIdent) and not RecMemberAhead do
    begin
      names := nil;
      nats := nil;
      repeat
        CheckName(FTok.Lexeme);
        AppendStr(names, FTok.Lexeme);
        AppendStr(nats, HerePos);
        FTok := FLex.Next;
        if FTok.Kind <> tkComma then Break;
        FTok := FLex.Next;
      until False;
      Eat(tkColon);
      t := Self.ParseType;
      Eat(tkSemi);
      check := Td;
      check.Fields := Fields;
      for i := 0 to High(names) do
      begin
        FieldDupAt(check, names[i], nats[i]);
        for n := 0 to High(Td.Meths) do
          if SameId(Td.Meths[n].Name, names[i]) then
            Refuse(names[i] + ' is a method already' + HerePos);
        for n := 0 to High(Td.Props) do
          if SameId(Td.Props[n].Name, names[i]) then
            Refuse(names[i] + ' is a property already' + HerePos);
        gname := AName + '.' + names[i];
        AddVar(gname, t, False);
        if FUnitName <> '' then
        begin
          FVars[High(FVars)].Sym := FUnitName + '.' + gname;
          FVars[High(FVars)].Pub := not FInImpl;
        end;
        n := Length(Td.CVars);
        SetLength(Td.CVars, n + 1);
        Td.CVars[n] := Default(TField);
        Td.CVars[n].Name := names[i];
        if i <= High(nats) then
          Td.CVars[n].At := nats[i];
        Td.CVars[n].Typ := t;
        Td.CVars[n].Vis := Vis;
        Td.CVars[n].Off := -1;
        Td.CVars[n].Sym := VarSym(gname);
        check.CVars := Td.CVars;
      end;
    end;
    Exit;
  end;
  if isClassM and (Rec <> 0) and
    ((FTok.Kind = tkConstructor) or (FTok.Kind = tkDestructor)) then
  begin
    isCtor := FTok.Kind = tkConstructor;
    isDtor := not isCtor;
    FTok := FLex.Next;
    if FTok.Kind <> tkIdent then Expected('a method''s name');
    mname := FTok.Lexeme;
    mpos := HerePos;
    CheckName(mname);
    FTok := FLex.Next;
    if FTok.Kind = tkLParen then
      Refuse('a class ' + LifeWord(isCtor) + ' takes no parameters' + mpos);
    Eat(tkSemi);
    for i := 0 to High(Td.Meths) do
      if Td.Meths[i].IsClassMeth and ((isCtor and Td.Meths[i].IsCtor) or
        (isDtor and Td.Meths[i].IsDtor)) then
        Refuse('a record has one class ' + LifeWord(isCtor) + mpos);
    n := Length(Td.Meths);
    SetLength(Td.Meths, n + 1);
    Td.Meths[n] := Default(TMethInfo);
    Td.Meths[n].Name := mname;
    Td.Meths[n].Sym := ProcSym('', StemOfName(AName) + '_' + mname) + ClassLifeTag(isCtor);
    Td.Meths[n].IsCtor := isCtor;
    Td.Meths[n].IsDtor := isDtor;
    Td.Meths[n].IsClassMeth := True;
    Td.Meths[n].IsStatic := True;
    Td.Meths[n].RetTyp := TyNone;
    Td.Meths[n].Slot := -1;
    Td.Meths[n].Vis := Vis;
    RememberMethod(Td.Meths[n].Sym, AName + '.' + mname, mpos);
    AddProcEnt(Td.Meths[n].Sym, Td.Meths[n].Sym, False, 0, TyNone);
    if isCtor then AppendStr(FClassCtors, Td.Meths[n].Sym)
    else AppendStr(FClassDtors, Td.Meths[n].Sym);
    Exit;
  end;
  if FTok.Kind = tkProperty then
  begin
    if isClassM and (Rec = 0) then
      Refuse(Who + '''s property is read from a value' + HerePos);
    FTok := FLex.Next;
    if FTok.Kind <> tkIdent then
      Expected('a property''s name');
    mname := FTok.Lexeme;
    FPropAt := HerePos;
    CheckName(mname);
    FTok := FLex.Next;
    nindex := 0;
    if FTok.Kind = tkLBrack then
    begin
      FTok := FLex.Next;
      while FTok.Kind <> tkRBrack do
      begin
        if (FTok.Kind = tkConst) or (FTok.Kind = tkVar) then
          FTok := FLex.Next;
        nn := 0;
        while FTok.Kind = tkIdent do
        begin
          Inc(nn);
          FTok := FLex.Next;
          if FTok.Kind = tkComma then
            FTok := FLex.Next
          else
            Break;
        end;
        if nn = 0 then
          Refuse('an indexed property names its index in its brackets');
        Eat(tkColon);
        Self.ParseType;
        nindex := nindex + LongInt(nn);
        if FTok.Kind = tkSemi then
          FTok := FLex.Next;
      end;
      Eat(tkRBrack);
    end;
    Eat(tkColon);
    t := Self.ParseType;
    rname := '';
    wname := '';
    jname := '';
    jflags := 0;
    while FTok.Kind <> tkSemi do
    begin
      if FTok.Kind = tkRead then
      begin
        FTok := FLex.Next;
        rname := FTok.Lexeme;
        FTok := FLex.Next;
      end
      else if FTok.Kind = tkWrite then
      begin
        FTok := FLex.Next;
        wname := FTok.Lexeme;
        FTok := FLex.Next;
      end
      else if (FTok.Kind = tkJson) and (Rec <> 0) then
        Refuse('a record is its fields in JSON, not its properties: json goes after a field' +
          HerePos)
      else
        Fail('read or write expected in a property, or its semicolon');
    end;
    Eat(tkSemi);
    if (rname = '') and (wname = '') then
      Refuse('a property reads or writes through a method' + HerePos);
    n := Length(td.Props);
    SetLength(td.Props, n + 1);
    td.Props[n].Name := mname;
    td.Props[n].At := FPropAt;
    td.Props[n].Typ := t;
    td.Props[n].JName := jname;
    td.Props[n].JFlags := jflags;
    td.Props[n].ReadOff := -1;
    td.Props[n].WriteOff := -1;
    td.Props[n].ReadName := rname;
    td.Props[n].WriteName := wname;
    td.Props[n].NIndex := nindex;
    td.Props[n].Vis := vis;
    td.Props[n].IsClass := isClassM;
    if isClassM and (nindex <> 0) then
      Refuse('a class property has no index' + HerePos);
    { a record's property may read and write a field of it (P165) }
    if (Rec <> 0) and (nindex = 0) and not isClassM then
    begin
      for i := 0 to High(Fields) do
      begin
        if SameId(Fields[i].Name, rname) then
          td.Props[n].ReadOff := Fields[i].Off;
        if SameId(Fields[i].Name, wname) then
          td.Props[n].WriteOff := Fields[i].Off;
      end;
    end;
    Exit;
  end;
  isCtor := False;
  if (FTok.Kind = tkConstructor) and not isClassM then
    { a record's constructor, or a record or type helper's (P165): a
      method on Self, which v.Create runs on v and T.Create on a new
      value, its value; a class helper's (P170), a constructor of the
      class: T.Create runs it on a new object of T, obj.Create on obj }
    isCtor := True
  else if FTok.Kind = tkDestructor then
    Refuse(Who + ' has no destructor' + HerePos)
  else if FTok.Kind = tkConstructor then
    Refuse(Who + ' has no class constructor' + HerePos);
  if (FTok.Kind <> tkProcedure) and (FTok.Kind <> tkFunction) and not isCtor then
  begin
    if isClassM then
      Refuse('class goes before ' + Who + '''s method' + HerePos);
    if Rec <> 0 then
      Refuse('a record''s fields come before its methods and properties, or after private ' +
        'or public' + HerePos);
    Refuse('a helper has methods and properties, no fields' + HerePos);
  end;
  isFunc := FTok.Kind = tkFunction;
  FTok := FLex.Next;
  if FTok.Kind <> tkIdent then
    Expected('a method''s name');
  mname := FTok.Lexeme;
  mpos := HerePos;
  CheckName(mname);
  FTok := FLex.Next;
  npar := 0;
  n := Length(td.Meths);
  SetLength(td.Meths, n + 1);
  td.Meths[n] := Default(TMethInfo);
  td.Meths[n].Slot := -1;
  td.Meths[n].ParamTyps := nil;
  td.Meths[n].ByRef := nil;
  if FTok.Kind = tkLParen then
  begin
    FTok := FLex.Next;
    if FTok.Kind <> tkRParen then
    begin
      while True do
      begin
        byref := False;
        if (FTok.Kind = tkVar) or (FTok.Kind = tkOut) then
        begin
          byref := True;
          FTok := FLex.Next;
        end
        else if FTok.Kind = tkConst then
          FTok := FLex.Next;
        FGroupAt := HerePos;
        names := nil;
        nn := 0;
        while True do
        begin
          if not IsName then
            Expected('a parameter''s name');
          SetLength(names, nn + 1);
          CheckName(FTok.Lexeme);
          if SameId(FTok.Lexeme, 'self') then
            Refuse('duplicate identifier Self' + HerePos);
          names[nn] := FTok.Lexeme;
          Inc(nn);
          FTok := FLex.Next;
          if FTok.Kind <> tkComma then
            Break;
          FTok := FLex.Next;
        end;
        Eat(tkColon);
        pt := ParamType(byref);
        for i := 0 to nn - 1 do
        begin
          if npar >= 31 then
            Refuse('at most 31 parameters and Self');
          SetLength(td.Meths[n].ParamTyps, npar + 1);
          SetLength(td.Meths[n].ByRef, npar + 1);
          td.Meths[n].ParamTyps[npar] := pt;
          td.Meths[n].ByRef[npar] := byref;
          Inc(npar);
        end;
        MethParamDefault(td.Meths[n], nn, byref, pt);
        if FTok.Kind <> tkSemi then
          Break;
        FTok := FLex.Next;
      end;
    end;
    Eat(tkRParen);
  end;
  DefaultsLast(td.Meths[n]);
  t := TyNone;
  if isFunc then
  begin
    Eat(tkColon);
    t := Self.ParseType;
  end;
  Eat(tkSemi);
  isStat := False;
  while True do
  begin
    if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'overload') then
    begin
    end
    else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'inline') then
    begin
    end
    else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'static') then
    begin
      if not isClassM then
        Refuse('static goes after a class method' + HerePos);
      isStat := True;
    end
    else if (FTok.Kind = tkVirtual) or ((FTok.Kind = tkIdent) and
      (SameId(FTok.Lexeme, 'override') or SameId(FTok.Lexeme, 'abstract'))) then
      Refuse(Who + '''s method is not virtual: ' + Who + ' has no method table' + HerePos)
    else
      Break;
    FTok := FLex.Next;
    if FTok.Kind = tkSemi then
      FTok := FLex.Next;
  end;
  if isClassM and not isStat then
    Refuse(Who + '''s class method is static: class function F: T; static;' + mpos);
  baseSym := ProcSym('', StemOfName(AName) + '_' + mname);
  ov := -1;
  for i := 0 to n - 1 do
    if SameId(td.Meths[i].Name, mname) then
    begin
      ov := i;
      eq := td.Meths[i].NParams = npar;
      if eq then
        for nn := 0 to npar - 1 do
          if (td.Meths[i].ParamTyps[nn] <> td.Meths[n].ParamTyps[nn]) or
            (td.Meths[i].ByRef[nn] <> td.Meths[n].ByRef[nn]) then
            eq := False;
      if eq then
        Refuse('duplicate identifier ' + mname + mpos);
    end;
  if ov >= 0 then
  begin
    baseSym := baseSym + '_o';
    for nn := 0 to npar - 1 do
      baseSym := baseSym + '_' + IntToStr(td.Meths[n].ParamTyps[nn]);
  end;
  td.Meths[n].Name := mname;
  td.Meths[n].Sym := baseSym;
  td.Meths[n].IsFunc := isFunc;
  td.Meths[n].NParams := npar;
  td.Meths[n].RetTyp := t;
  td.Meths[n].IsClassMeth := isClassM;
  td.Meths[n].IsStatic := isStat;
  td.Meths[n].IsCtor := isCtor;
  td.Meths[n].Vis := vis;
  RememberMethod(baseSym, AName + '.' + mname, mpos);
end;

{ A helper (P127): type helper for a simple type, record helper for a
  record, class helper for a class (HKind 0, 1, 2, kept in Lo), with a
  helper it descends from in parentheses. Its members are methods, a
  class one static, and properties read and written through them; it
  has no fields. Each method is a routine named Helper.Method whose
  first parameter is Self: the value, by reference, for a type or a
  record helper, the object for a class helper; a static one has none.
  The last helper declared for a type is the one in scope, as in FPC;
  one that descends from another has that one's members too. }
function TParser.ParseHelperType(const AName: string; HKind: LongInt): LongInt;
var
  td: TTypeDef;
  parent, target, saveScope: LongInt;
  n: SizeInt;
  tk: TTypeKind;
  vis: Byte;
begin
  FTok := FLex.Next;
  parent := 0;
  if FTok.Kind = tkLParen then
  begin
    FTok := FLex.Next;
    if (FTok.Kind <> tkIdent) or (not TypeAhead(parent)) or
      (TypeOf(parent).Kind <> tykHelper) then
      Refuse('a helper descends from a helper' + HerePos);
    if TypeOf(parent).Lo <> HKind then
      Refuse('a helper descends from a helper of its kind' + HerePos);
    SkipTypeName;
    Eat(tkRParen);
  end;
  Eat(tkFor);
  target := Self.ParseType;
  tk := TypeOf(target).Kind;
  if (HKind = 2) and (tk <> tykClass) then
    Refuse('a class helper is for a class, not ' + TypName(target) + HerePos);
  if (HKind = 1) and (tk <> tykRecord) then
    Refuse('a record helper is for a record, not ' + TypName(target) + HerePos);
  if (HKind = 0) and ((tk = tykRecord) or (tk = tykClass) or (tk = tykInterface) or
    (tk = tykProc) or (tk = tykMethod) or (tk = tykClassRef) or (tk = tykHelper) or
    (tk = tykGeneric) or (tk = tykParam)) then
    Refuse('a type helper is for a simple type: record helper for a record, class helper ' +
      'for a class, not ' + TypName(target) + HerePos);
  if (parent <> 0) and (HKind <> 2) and not SameTyp(TypeOf(parent).Elem, target) then
    Refuse('a helper descends from a helper for its type, ' + TypName(target) + HerePos);
  { a record's own methods stay: its helper descends from them (P165) }
  if (parent = 0) and (HKind = 1) then
    parent := RecordHelper(target);
  td := Default(TTypeDef);
  td.Kind := tykHelper;
  td.Sym := UnitStem(AName);
  td.Elem := target;
  td.Parent := parent;
  td.Lo := HKind;
  td.Size := 0;
  Result := AddNamedType(AName, td);
  saveScope := FMemberScope;
  FMemberScope := Result;
  td.Meths := nil;
  td.Props := nil;
  vis := VisPublic;
  while FTok.Kind <> tkEnd do
  begin
    if (FTok.Kind = tkIdent) and (SameId(FTok.Lexeme, 'public') or
      SameId(FTok.Lexeme, 'private') or SameId(FTok.Lexeme, 'published') or
      SameId(FTok.Lexeme, 'protected') or SameId(FTok.Lexeme, 'strict')) then
    begin
      if SameId(FTok.Lexeme, 'strict') then
      begin
        FTok := FLex.Next;
        if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'private') then
          vis := VisStrictPrivate
        else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'protected') then
          vis := VisStrictProtected
        else
          Refuse('strict goes before private or protected' + HerePos);
      end
      else if SameId(FTok.Lexeme, 'private') then
        vis := VisPrivate
      else if SameId(FTok.Lexeme, 'protected') then
        vis := VisProtected
      else
        vis := VisPublic;
      FTok := FLex.Next;
      Continue;
    end;
    ParseHelperMember(td, AName, vis, 0, nil);
  end;
  Eat(tkEnd);
  { a property's methods are the helper's or its parent's }
  FTypes[Result].Meths := td.Meths;
  FTypes[Result].Props := td.Props;
  CheckScopeMembers(Result, td);
  for n := 0 to High(td.Props) do
  begin
    if (td.Props[n].ReadName <> '') and not HelperHas(Result, td.Props[n].ReadName) then
      Refuse(AName + '.' + td.Props[n].Name + ' reads through ' + td.Props[n].ReadName +
        ', which is no method of the helper');
    if (td.Props[n].WriteName <> '') and not HelperHas(Result, td.Props[n].WriteName) then
      Refuse(AName + '.' + td.Props[n].Name + ' writes through ' + td.Props[n].WriteName +
        ', which is no method of the helper');
  end;
  n := Length(FHelpers);
  SetLength(FHelpers, n + 1);
  FHelpers[n] := Result;
  FMemberScope := saveScope;
end;

{ The helper declared last for class C itself (P380): Free Pascal keys a
  class's helper by the class (search_last_objectpascal_helper), and a
  helper for C's parent is reached at the parent. A class two units'
  .pi both carry is one class, by its stem, as ClassUnder says. }
function TParser.HelperOfClass(C: LongInt): LongInt;
var
  i: SizeInt;
  h, tg: LongInt;
begin
  Result := 0;
  for i := High(FHelpers) downto 0 do
  begin
    h := FHelpers[i];
    tg := FTypes[h].Elem;
    if (FTypes[h].Lo = 2) and (tg > 0) and
      ((tg = C) or (TypeStemOf(FTypes[tg]) = TypeStemOf(FTypes[C]))) then
    begin
      Result := h;
      Exit;
    end;
  end;
end;

{ Class C declares a member AName itself (P380): a field, a method, an
  override among them, a property or a class variable of its own, not
  the copy of its parent's it starts with (MemberOwner). }
function TParser.ClassOwnHas(C: LongInt; const AName: string): Boolean;
var
  i: SizeInt;
begin
  Result := True;
  for i := 0 to High(FTypes[C].Fields) do
    if SameId(FTypes[C].Fields[i].Name, AName) and (MemberOwner(C, 0, i) = C) then
      Exit;
  for i := 0 to High(FTypes[C].Meths) do
    if SameId(FTypes[C].Meths[i].Name, AName) and (MemberOwner(C, 1, i) = C) then
      Exit;
  for i := 0 to High(FTypes[C].Props) do
    if SameId(FTypes[C].Props[i].Name, AName) and (MemberOwner(C, 2, i) = C) then
      Exit;
  for i := 0 to High(FTypes[C].CVars) do
    if SameId(FTypes[C].CVars[i].Name, AName) and (MemberOwner(C, 3, i) = C) then
      Exit;
  Result := False;
end;

{ The helper whose member AName a value or the name of class Cls reaches
  (P380), 0 when the class's own comes first or none has it: from Cls to
  its parents, at each class the helper for that class first and then
  the class's own members, as Free Pascal's searchsym_in_class walks
  them. A helper for TFoo hid TBar's own method of its name, and a helper
  for TBar TFoo's helper. }
function TParser.ClassHelperFor(Cls: LongInt; const AName: string): LongInt;
var
  c, h, n: LongInt;
begin
  Result := 0;
  c := Cls;
  n := 0;
  while (c > 0) and (c <= High(FTypes)) and (n < 10000) do
  begin
    h := HelperOfClass(c);
    if (h <> 0) and HelperHas(h, AName) then
    begin
      Result := h;
      Exit;
    end;
    if ClassOwnHas(c, AName) or (FTypes[c].Parent = c) then
      Exit;
    c := FTypes[c].Parent;
    Inc(n);
  end;
end;

{ The helper whose member AName a value of type T reaches, 0 for none: a
  class's by its levels (ClassHelperFor), any other type's the one in
  scope for it (P127), before the type's own members. }
function TParser.MemberHelper(T: LongInt; const AName: string): LongInt;
begin
  Result := 0;
  if T <= 0 then
    Exit;
  if TypeOf(T).Kind = tykClass then
    Result := ClassHelperFor(T, AName)
  else if (HelperFor(T) <> 0) and HelperHas(HelperFor(T), AName) then
    Result := HelperFor(T);
end;

{ The helper in scope for type T (P127): the last declared or loaded for
  it, a class helper for T or an ancestor; 0 when there is none. A
  class's member is looked up through ClassHelperFor (P380). }
function TParser.HelperFor(T: LongInt): LongInt;
var
  i: SizeInt;
  h, tg: LongInt;
begin
  Result := 0;
  if T <= 0 then
    Exit;
  for i := High(FHelpers) downto 0 do
  begin
    h := FHelpers[i];
    tg := FTypes[h].Elem;
    if FTypes[h].Lo = 2 then
    begin
      if (TypeOf(T).Kind = tykClass) and ClassUnder(T, tg) then
      begin
        Result := h;
        Exit;
      end;
    end
    else if (T = tg) or SameTyp(T, tg) then
    begin
      Result := h;
      Exit;
    end;
  end;
end;

{ Helper H, or one it descends from, has a method or a property named
  AName (P127). }
function TParser.HelperHas(H: LongInt; const AName: string): Boolean;
var
  i: SizeInt;
  owner: LongInt;
begin
  Result := False;
  i := ScopedIndex(H, AName, owner);
  if (i >= 0) and (FTypes[owner].Nested[i].Kind <> 0) then
  begin Result := True; Exit end;
  while H > 0 do
  begin
    for i := 0 to High(FTypes[H].CVars) do
      if SameId(FTypes[H].CVars[i].Name, AName) then
      begin
        Result := True;
        Exit;
      end;
    for i := 0 to High(FTypes[H].Meths) do
      if SameId(FTypes[H].Meths[i].Name, AName) then
      begin
        Result := True;
        Exit;
      end;
    for i := 0 to High(FTypes[H].Props) do
      if SameId(FTypes[H].Props[i].Name, AName) then
      begin
        Result := True;
        Exit;
      end;
    H := FTypes[H].Parent;
  end;
end;

{ The Self argument of a call of helper H's method on Obj (P127): the
  object for a class helper; else the value's address, a var argument,
  when Obj is a variable the routine may change, and a hidden copy's
  when it is a value, a constant or a const parameter (rt_tmpaddr). }
function TParser.HelperSelf(Obj: PExpr; H: LongInt): PExpr;
var
  a: TExprArray;
  pre: TStmtArray;
  tv: PExpr;
  root: string;
  i: SizeInt;
  place: Boolean;
begin
  if FTypes[H].Lo = 2 then
  begin
    Result := Obj;
    Exit;
  end;
  place := (Obj^.Kind = ekVar) or (Obj^.Kind = ekField) or (Obj^.Kind = ekIndex) or
    (Obj^.Kind = ekDeref);
  if place then
  begin
    root := RootName(Obj);
    for i := 0 to High(FConstNames) do
      if (root <> '') and SameId(root, FConstNames[i]) then
        place := False;
  end;
  if place then
  begin
    Result := NewAddr(Obj);
    Result^.Flags := Result^.Flags or 16;
    Exit;
  end;
  pre := nil;
  tv := HiddenVar(Obj^.Typ, pre, nil);
  a := nil;
  SetLength(a, 2);
  a[0] := NewAddr(tv);
  a[1] := Obj;
  Result := NewCall('rt_tmpaddr', a, InternPtr(Obj^.Typ));
end;

{ A call of method M of helper Owner on Obj, nil for a static one reached
  through the type (P127): Self first, then the arguments, a var one by
  its address. }
function TParser.HelperCall(Obj: PExpr; Owner: LongInt; const M: TMethInfo;
  var Args: TExprArray; const AName: string): PExpr;
var
  all: TExprArray;
  k, first: SizeInt;
begin
  for k := 0 to High(Args) do
    if (k <= High(M.ByRef)) and M.ByRef[k] then
      Args[k] := VarArgOf(Args[k]);
  { a record's constructor through the type (P165), TRec.Create: its
    maker, which runs it on a new record and gives that }
  if M.IsCtor and (Obj = nil) then
  begin
    Result := NewCall(M.Sym + '.new', Args, TypeOf(Owner).Elem);
    Exit;
  end;
  all := nil;
  first := 0;
  if not M.IsStatic then
  begin
    if Obj = nil then
    begin
      if FMemberAt <> '' then
        Refuse(TypeOf(Owner).Name + '.' + AName + ' is a method of a value, not of the type' +
          FMemberAt);
      Refuse(TypeOf(Owner).Name + '.' + AName + ' is a method of a value, not of the type' +
        HerePos);
    end;
    first := 1;
    SetLength(all, Length(Args) + 1);
    all[0] := HelperSelf(Obj, Owner);
  end
  else
    SetLength(all, Length(Args));
  for k := 0 to High(Args) do
    all[k + first] := Args[k];
  Result := NewCall(M.Sym, all, M.RetTyp);
end;

{ The maker of record constructor Pr (P165): a function of Pr's
  parameters but Self that runs Pr on its Result, a new record, zeroed,
  and gives it. TRec.Create(...) calls the maker; v.Create(...), and
  Create(...) in a method of the record, run Pr on v and on Self, as
  Delphi says (Free Pascal 3.2.2 loses a string field there). }
function TParser.CtorMaker(const Pr: TProc): TProc;
var
  st: PStmt;
  args: TExprArray;
  k: SizeInt;
  rec: LongInt;
begin
  rec := Pr.Params[0].Typ;
  Result := Default(TProc);
  Result.Name := Pr.Name;
  Result.Sym := Pr.Sym + '.new';
  Result.IsFunc := True;
  Result.RetTyp := rec;
  Result.Nest := Pr.Nest;
  Result.Params := nil;
  SetLength(Result.Params, Length(Pr.Params) - 1);
  args := nil;
  SetLength(args, Length(Pr.Params));
  args[0] := NewAddr(NewVar('result', rec));
  args[0]^.Flags := args[0]^.Flags or 16;
  for k := 1 to High(Pr.Params) do
  begin
    Result.Params[k - 1] := Pr.Params[k];
    args[k] := NewVar(Pr.Params[k].Name, Pr.Params[k].Typ);
    if Pr.Params[k].ByRef then
    begin
      args[k] := NewAddr(args[k]);
      args[k]^.Flags := args[k]^.Flags or 16;
    end;
  end;
  st := NewStmt(skCall);
  st^.Name := Pr.Sym;
  st^.Args := args;
  Result.Body := NewStmt(skBlock);
  SetLength(Result.Body^.Stmts, 1);
  Result.Body^.Stmts[0] := st;
  Result.CpuOwn := Pr.CpuOwn;
  Result.CpuSet := Pr.CpuSet;
  Result.CpuTune := Pr.CpuTune;
end;

{ Obj.AName through helper H (P127): a method with its arguments, or a
  property read through its method, the index in brackets; a property
  written, Obj.P := x, is a call of its write method that the
  assignment makes (Flags 128, the value's type in Typ). Obj is
  nil for a static method named through the type (Integer.Parse). }
function TParser.HelperMember(Obj: PExpr; H: LongInt; const AName: string;
  ALine, ACol: LongInt): PExpr;
var
  owner, hh: LongInt;
  mi, px, k: SizeInt;
  args: TExprArray;
  have: Boolean;
  pr: TPropInfo;
  rname: string;
begin
  if ScopedValue(H, AName, Result) then Exit;
  hh := H;
  while hh > 0 do
  begin
    k := CVarIndex(hh, AName);
    if k >= 0 then
    begin
      CheckVis(hh, 3, k, ALine, ACol);
      Result := NewVar(FTypes[hh].CVars[k].Sym, FTypes[hh].CVars[k].Typ);
      Exit;
    end;
    hh := FTypes[hh].Parent;
  end;
  { a property of the helper or of one it descends from }
  mi := -1;
  hh := H;
  owner := 0;
  px := -1;
  while (hh > 0) and (owner = 0) do
  begin
    for k := 0 to High(FTypes[hh].Props) do
      if SameId(FTypes[hh].Props[k].Name, AName) then
      begin
        owner := hh;
        px := k;
      end;
    hh := FTypes[hh].Parent;
  end;
  if owner <> 0 then
  begin
    pr := FTypes[owner].Props[px];
    if pr.IsClass then
    begin
      Result := ClassPropRead(owner, px, ALine, ACol);
      Exit;
    end;
    if (pr.Vis = VisStrictPrivate) and (FHelperTyp <> owner) and not FGenMode then
      Refuse(pr.Name + ' is strict private to ' + FTypes[owner].Name + HerePos);
    if (pr.Vis = VisPrivate) and FTypes[owner].Imported and not FGenMode then
      Refuse(pr.Name + ' is private to ' + FTypes[owner].Name + '''s unit' + HerePos);
    { a record's property of a field (P165): the field itself, read or
      assigned }
    if (pr.NIndex = 0) and (((FTok.Kind = tkAssign) and (pr.WriteOff >= 0)) or
      ((FTok.Kind <> tkAssign) and (pr.ReadOff >= 0))) then
    begin
      if Obj = nil then
        Refuse(pr.Name + ' is a field of a record, which a static method has none of' + HerePos);
      if FTok.Kind = tkAssign then
        Result := NewField(Obj, pr.WriteName, pr.Typ, pr.WriteOff)
      else
        Result := NewField(Obj, pr.ReadName, pr.Typ, pr.ReadOff);
      Exit;
    end;
    args := nil;
    if pr.NIndex > 0 then
    begin
      Eat(tkLBrack);
      while True do
      begin
        SetLength(args, Length(args) + 1);
        args[High(args)] := ParseExpr;
        if FTok.Kind <> tkComma then
          Break;
        FTok := FLex.Next;
      end;
      Eat(tkRBrack);
      if Length(args) <> pr.NIndex then
        Refuse(pr.Name + ' takes ' + IntToStr(pr.NIndex) + ' index' + HerePos);
    end;
    if (FTok.Kind = tkAssign) and (pr.WriteName <> '') then
    begin
      { the write: its method takes the index and the value, which the
        assignment adds (Flags 128) }
      hh := owner;
      mi := -1;
      while (hh > 0) and (mi < 0) do
      begin
        for k := 0 to High(FTypes[hh].Meths) do
          if SameId(FTypes[hh].Meths[k].Name, pr.WriteName) and
            (FTypes[hh].Meths[k].NParams = pr.NIndex + 1) and not FTypes[hh].Meths[k].IsFunc then
            mi := k;
        if mi < 0 then
          hh := FTypes[hh].Parent;
      end;
      if mi < 0 then
        Refuse(pr.Name + ' writes through ' + pr.WriteName + ', which is no procedure of the ' +
          'index and the value' + HerePos);
      if FTypes[hh].Meths[mi].ByRef[pr.NIndex] then
        Refuse(pr.WriteName + ' takes the value, not a var parameter' + HerePos);
      for k := 0 to High(args) do
        args[k] := ValArg(FTypes[hh].Meths[mi].ParamTyps[k], args[k]);
      FMemberAt := ' at ' + IntToStr(ALine) + ':' + IntToStr(ACol);
      Result := HelperCall(Obj, hh, FTypes[hh].Meths[mi], args, pr.WriteName);
      Result^.Flags := Result^.Flags or 128;
      Result^.Typ := FTypes[hh].Meths[mi].ParamTyps[pr.NIndex];
      Exit;
    end;
    if pr.ReadName = '' then
      Refuse(pr.Name + ' is written, not read: it has no read method' + HerePos);
    rname := pr.ReadName;
    hh := owner;
    if not PickMethAt(FTypes[hh].Meths, rname, args, True, mi, ALine, ACol) then
    begin
      hh := FTypes[owner].Parent;
      while (hh > 0) and not PickMethAt(FTypes[hh].Meths, rname, args, True, mi, ALine, ACol) do
        hh := FTypes[hh].Parent;
      if hh = 0 then
        Refuse(pr.Name + ' reads through ' + rname + ', which takes other arguments' + HerePos);
    end;
    FMemberAt := ' at ' + IntToStr(ALine) + ':' + IntToStr(ACol);
    Result := HelperCall(Obj, hh, FTypes[hh].Meths[mi], args, rname);
    Result^.Typ := pr.Typ;
    Exit;
  end;
  args := nil;
  have := False;
  if FTok.Kind = tkLParen then
  begin
    args := ParseArgList;
    have := True;
  end;
  hh := H;
  mi := -1;
  while hh > 0 do
  begin
    if PickMethAt(FTypes[hh].Meths, AName, args, have, mi, ALine, ACol) then
      Break;
    hh := FTypes[hh].Parent;
  end;
  if hh = 0 then
    Refuse('unknown member ' + AName + ' of ' + FTypes[H].Name + ' at ' + IntToStr(ALine) + ':' +
      IntToStr(ACol));
  if (FTypes[hh].Meths[mi].Vis = VisStrictPrivate) and (FHelperTyp <> hh) and not FGenMode then
    Refuse(AName + ' is strict private to ' + FTypes[hh].Name + ' at ' + IntToStr(ALine) + ':' +
      IntToStr(ACol));
  if (FTypes[hh].Meths[mi].Vis = VisPrivate) and FTypes[hh].Imported and not FGenMode then
    Refuse(AName + ' is private to ' + FTypes[hh].Name + '''s unit at ' + IntToStr(ALine) + ':' +
      IntToStr(ACol));
  if (not have) and NeedsArgs(FTypes[hh].Meths[mi]) then
    Refuse(AName + ' takes arguments at ' + IntToStr(ALine) + ':' + IntToStr(ACol));
  FMemberAt := ' at ' + IntToStr(ALine) + ':' + IntToStr(ACol);
  Result := HelperCall(Obj, hh, FTypes[hh].Meths[mi], args, AName);
end;

function TParser.ParseClassType(const AName: string): LongInt;
var
  td: TTypeDef;
  names: array of string;
  nats: array of string;   { where each name is (P340) }
  nn, i, n: SizeInt;
  off, sz, t, slot, nindex, keepSlot: LongInt;
  mname, rname, wname, baseSym, gname, mpos: string;
  isVirt, isAbs, isFunc, isCtor, isDtor, byref, pub, eq, msafe: Boolean;
  isClassM, isStat, cvarMode, isStatField, short: Boolean;
  npar: LongInt;
  pt: LongInt;
  parent, ov, saveScope: LongInt;
  par: TTypeDef;
  vis: Byte;
  jname: string;
  jflags: LongInt;
begin
  td := Default(TTypeDef);
  td.Kind := tykClass;
  td.Name := AName;
  td.Sym := UnitStem(AName);
  td.Size := 8;
  { a class declared forward is the same type (P139) }
  Result := TakeFwd(AName);
  if Result < 0 then
    Result := AddNamedType(AName, td);
  td.Fields := nil;
  td.Meths := nil;
  td.Props := nil;
  off := 8;
  slot := 0;
  parent := 0;
  pub := True;
  vis := VisPublic;
  short := False;
  if FTok.Kind = tkLParen then
  begin
    FTok := FLex.Next;
    while True do
    begin
      if FTok.Kind <> tkIdent then
        Expected('a class''s or an interface''s name');
      { ua.TBase too (P158) }
      if not TypeAhead(t) then
        Refuse('unknown identifier ' + AheadName);
      { one declared forward, or this one, is not whole yet (P139) }
      if (t = Result) or IsFwdType(t) then
      begin
        if TypeOf(t).Kind = tykInterface then
          Refuse(AheadName + ' is not declared whole yet: an interface is declared before ' +
            'the classes that implement it' + HerePos);
        Refuse(AheadName + ' is not declared whole yet: a parent class is declared before ' +
          'the classes that descend from it' + HerePos);
      end;
      SkipTypeName;
      if TypeOf(t).Kind = tykClass then
      begin
        if (parent <> 0) or (Length(td.Ifaces) > 0) then
          Refuse('the parent class comes first, before the interfaces');
        parent := t;
        par := TypeOf(parent);
        n := Length(par.Fields);
        SetLength(td.Fields, n);
        for i := 0 to n - 1 do
          td.Fields[i] := par.Fields[i];
        n := Length(par.Meths);
        SetLength(td.Meths, n);
        for i := 0 to n - 1 do
          td.Meths[i] := par.Meths[i];
        n := Length(par.Props);
        SetLength(td.Props, n);
        for i := 0 to n - 1 do
          td.Props[i] := par.Props[i];
        { a parent's class variables are the descendant's too (P123) }
        n := Length(par.CVars);
        SetLength(td.CVars, n);
        for i := 0 to n - 1 do
          td.CVars[i] := par.CVars[i];
        n := Length(par.Ifaces);
        SetLength(td.Ifaces, n);
        for i := 0 to n - 1 do
          td.Ifaces[i] := par.Ifaces[i];
        off := par.Size;
        slot := par.VmtN;
        td.Parent := parent;
      end
      else if TypeOf(t).Kind = tykInterface then
      begin
        n := Length(td.Ifaces);
        SetLength(td.Ifaces, n + 1);
        td.Ifaces[n] := t;
      end
      else
        Refuse('a class descends from a class and implements interfaces');
      if FTok.Kind <> tkComma then
        Break;
      FTok := FLex.Next;
    end;
    Eat(tkRParen);
    { TFoo = class(TParent); is a class with nothing of its own (P139) }
    short := FTok.Kind = tkSemi;
  end;
  { A class with no parent descends from TObject (P121), as in Object
    Pascal: TObject's virtual methods take the first slots, Free and the
    class words reach every object. TObject itself, in the core unit
    pasobject, is the one class with no parent. }
  if (parent = 0) and (not SameId(AName, 'TObject')) and NamedType('TObject', t) and
    (TypeOf(t).Kind = tykClass) then
  begin
    parent := t;
    par := TypeOf(parent);
    n := Length(par.Fields);
    SetLength(td.Fields, n);
    for i := 0 to n - 1 do
      td.Fields[i] := par.Fields[i];
    n := Length(par.Meths);
    SetLength(td.Meths, n);
    for i := 0 to n - 1 do
      td.Meths[i] := par.Meths[i];
    n := Length(par.Props);
    SetLength(td.Props, n);
    for i := 0 to n - 1 do
      td.Props[i] := par.Props[i];
    n := Length(par.CVars);
    SetLength(td.CVars, n);
    for i := 0 to n - 1 do
      td.CVars[i] := par.CVars[i];
    for i := 0 to High(par.Ifaces) do
    begin
      n := Length(td.Ifaces);
      SetLength(td.Ifaces, n + 1);
      td.Ifaces[n] := par.Ifaces[i];
    end;
    off := par.Size;
    slot := par.VmtN;
    td.Parent := parent;
  end;
  { Member declarations already see the inherited namespace, not
    only bodies parsed after the class is complete. }
  FTypes[Result].Parent := parent;
  cvarMode := False;
  saveScope := FMemberScope;
  FMemberScope := Result;
  while (not short) and (FTok.Kind <> tkEnd) do
  begin
    { The sections set what code may use the members that follow
      (1.0.137, as FPC): public and published anywhere, protected, private,
      strict protected and strict private; before any section, public. }
    if (FTok.Kind = tkIdent) and (SameId(FTok.Lexeme, 'public') or
      SameId(FTok.Lexeme, 'private') or SameId(FTok.Lexeme, 'published') or
      SameId(FTok.Lexeme, 'protected') or SameId(FTok.Lexeme, 'strict')) then
    begin
      pub := SameId(FTok.Lexeme, 'public') or SameId(FTok.Lexeme, 'published');
      if SameId(FTok.Lexeme, 'strict') then
      begin
        FTok := FLex.Next;
        if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'private') then
          vis := VisStrictPrivate
        else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'protected') then
          vis := VisStrictProtected
        else
          Refuse('strict goes before private or protected' + HerePos);
      end
      else if SameId(FTok.Lexeme, 'private') then
        vis := VisPrivate
      else if SameId(FTok.Lexeme, 'protected') then
        vis := VisProtected
      else
        vis := VisPublic;
      FTok := FLex.Next;
      if FTok.Kind = tkSemi then
        FTok := FLex.Next;
      cvarMode := False;
      Continue;
    end;
    if (FTok.Kind = tkConst) or (FTok.Kind = tkType) then
    begin
      ParseMemberSection(Result, vis, td);
      cvarMode := False;
      Continue;
    end;
    { var starts fields again, class var class variables (P123): what
      follows until the next section, method or property }
    if FTok.Kind = tkVar then
    begin
      FTok := FLex.Next;
      cvarMode := False;
      Continue;
    end;
    { class before a method, a property or var (P123) }
    isClassM := False;
    if FTok.Kind = tkClass then
    begin
      FTok := FLex.Next;
      if FTok.Kind = tkVar then
      begin
        FTok := FLex.Next;
        cvarMode := True;
        Continue;
      end;
      if (FTok.Kind <> tkProperty) and (FTok.Kind <> tkProcedure) and
        (FTok.Kind <> tkFunction) and (FTok.Kind <> tkConstructor) and
        (FTok.Kind <> tkDestructor) then
        Refuse('class goes before a method, a property or var' + HerePos);
      isClassM := True;
    end;
    if (FTok.Kind = tkProperty) or (FTok.Kind = tkProcedure) or (FTok.Kind = tkFunction) or
      (FTok.Kind = tkConstructor) or (FTok.Kind = tkDestructor) or (FTok.Kind = tkSafe) then
      cvarMode := False;
    if FTok.Kind = tkProperty then
    begin
      FTok := FLex.Next;
      if FTok.Kind <> tkIdent then
        Expected('a property''s name');
      mname := FTok.Lexeme;
      FPropAt := HerePos;
      CheckName(mname);
      FTok := FLex.Next;
      nindex := 0;
      if FTok.Kind = tkLBrack then
      begin
        FTok := FLex.Next;
        while FTok.Kind <> tkRBrack do
        begin
          if FTok.Kind <> tkIdent then
            Expected('an index''s name');
          nn := 0;
          while FTok.Kind = tkIdent do
          begin
            Inc(nn);
            FTok := FLex.Next;
            if FTok.Kind = tkComma then
              FTok := FLex.Next
            else
              Break;
          end;
          Eat(tkColon);
          Self.ParseType;
          nindex := nindex + nn;
          if FTok.Kind = tkSemi then
            FTok := FLex.Next;
        end;
        Eat(tkRBrack);
      end;
      Eat(tkColon);
      t := Self.ParseType;
      rname := '';
      wname := '';
      jname := '';
      jflags := 0;
      while FTok.Kind <> tkSemi do
      begin
        if FTok.Kind = tkRead then
        begin
          FTok := FLex.Next;
          rname := FTok.Lexeme;
          FTok := FLex.Next;
        end
        else if FTok.Kind = tkWrite then
        begin
          FTok := FLex.Next;
          wname := FTok.Lexeme;
          FTok := FLex.Next;
        end
        else if (FTok.Kind = tkJson) and (jflags = 0) then
          { a property in JSON (P205): by its read accessor }
          ParseJsonDirective(t, 1, jname, jflags)
        else
          Fail('read, write or json expected in a property, or its semicolon');
      end;
      Eat(tkSemi);
      if isClassM and (jflags <> 0) then
        Refuse('a class property is no member of an object: json writes none' + HerePos);
      n := Length(td.Props);
      SetLength(td.Props, n + 1);
      td.Props[n].Name := mname;
      td.Props[n].At := FPropAt;
      td.Props[n].Typ := t;
      td.Props[n].JName := jname;
      td.Props[n].JFlags := jflags;
      td.Props[n].ReadOff := -1;
      td.Props[n].WriteOff := -1;
      td.Props[n].ReadName := rname;
      td.Props[n].WriteName := wname;
      td.Props[n].NIndex := nindex;
      for i := 0 to High(td.Fields) do
      begin
        if SameId(td.Fields[i].Name, rname) then
          td.Props[n].ReadOff := td.Fields[i].Off;
        if SameId(td.Fields[i].Name, wname) then
          td.Props[n].WriteOff := td.Fields[i].Off;
      end;
      td.Props[n].IsPublished := pub and not isClassM;
      td.Props[n].Vis := vis;
      td.Props[n].IsClass := isClassM;
      if isClassM and (nindex > 0) then
        Refuse('a class property has no index' + HerePos);
      Continue;
    end;
    msafe := False;
    if FTok.Kind = tkSafe then
    begin
      FTok := FLex.Next;
      if (FTok.Kind <> tkProcedure) and (FTok.Kind <> tkFunction) and
        (FTok.Kind <> tkConstructor) and (FTok.Kind <> tkDestructor) then
        Refuse('safe goes before a method' + HerePos);
      msafe := True;
    end;
    if (FTok.Kind = tkProcedure) or (FTok.Kind = tkFunction) or
      (FTok.Kind = tkConstructor) or (FTok.Kind = tkDestructor) then
    begin
      isCtor := FTok.Kind = tkConstructor;
      isDtor := FTok.Kind = tkDestructor;
      isFunc := FTok.Kind = tkFunction;
      if msafe and isClassM then
        Refuse('safe goes before class' + HerePos);
      FTok := FLex.Next;
      if FTok.Kind <> tkIdent then
        Expected('a method''s name');
      mname := FTok.Lexeme;
      mpos := HerePos;
      CheckName(mname);
      { A method declared safe: its body is read as safe code (P102). }
      if msafe then
        AppendStr(FSafeNames, AName + '.' + mname);
      FTok := FLex.Next;
      npar := 0;
      ov := -1;
      n := Length(td.Meths);
      SetLength(td.Meths, n + 1);
      td.Meths[n].Slot := -1;
      td.Meths[n].ParamTyps := nil;
      td.Meths[n].ByRef := nil;
      if FTok.Kind = tkLParen then
      begin
        FTok := FLex.Next;
        if FTok.Kind <> tkRParen then
        begin
          while True do
          begin
            byref := False;
            if (FTok.Kind = tkVar) or (FTok.Kind = tkOut) then
            begin
              byref := True;
              FTok := FLex.Next;
            end
            else if FTok.Kind = tkConst then
              FTok := FLex.Next;
            FGroupAt := HerePos;
            names := nil;
            nn := 0;
            while True do
            begin
              if not IsName then
                Expected('a parameter''s name');
              SetLength(names, nn + 1);
              CheckName(FTok.Lexeme);
              names[nn] := FTok.Lexeme;
              Inc(nn);
              FTok := FLex.Next;
              if FTok.Kind <> tkComma then
                Break;
              FTok := FLex.Next;
            end;
            Eat(tkColon);
            pt := ParamType(byref);
            for i := 0 to nn - 1 do
            begin
              if npar >= 32 then
                Refuse('at most 32 parameters');
              SetLength(td.Meths[n].ParamTyps, npar + 1);
              SetLength(td.Meths[n].ByRef, npar + 1);
              td.Meths[n].ParamTyps[npar] := pt;
              td.Meths[n].ByRef[npar] := byref;
              Inc(npar);
            end;
            { a default value (P125) }
            MethParamDefault(td.Meths[n], nn, byref, pt);
            if FTok.Kind <> tkSemi then
              Break;
            FTok := FLex.Next;
          end;
        end;
        Eat(tkRParen);
      end;
      DefaultsLast(td.Meths[n]);
      t := TyNone;
      if isFunc then
      begin
        Eat(tkColon);
        t := Self.ParseType;
      end;
      Eat(tkSemi);
      isVirt := False;
      isAbs := False;
      isStat := False;
      while True do
      begin
        if (FTok.Kind = tkVirtual) or
          ((FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'override')) then
          isVirt := True
        else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'overload') then
        begin
        end
        else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'abstract') then
        begin
          isVirt := True;
          isAbs := True;
        end
        else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'static') then
        begin
          { a static class method (P123): no Self, a routine in the
            class's name space }
          if not isClassM then
            Refuse('static goes after a class method' + HerePos);
          isStat := True;
        end
        else
          Break;
        FTok := FLex.Next;
        if FTok.Kind = tkSemi then
          FTok := FLex.Next;
      end;
      if isStat and isVirt then
        Refuse('a static class method is not virtual' + mpos);
      { a class constructor or destructor (P123): no parameters, run when
        the program or unit starts and ends, by no one else; a symbol of
        its own, so an object's Create is another method }
      if isClassM and (isCtor or isDtor) then
      begin
        if npar > 0 then
          Refuse('a class ' + LifeWord(isCtor) + ' takes no parameters' + mpos);
        if isVirt then
          Refuse('a class constructor or destructor is not virtual' + mpos);
        for i := 0 to n - 1 do
          if td.Meths[i].IsClassMeth and (td.Meths[i].IsCtor = isCtor) and
            (td.Meths[i].IsDtor = isDtor) and OwnMeth(td.Meths[i].Sym,
            ProcSym('', StemOfName(AName) + '_' + td.Meths[i].Name) + ClassLifeTag(isCtor)) then
            Refuse('a class has one class ' + LifeWord(isCtor) + mpos);
        td.Meths[n].Name := mname;
        td.Meths[n].Sym := ProcSym('', StemOfName(AName) + '_' + mname) + ClassLifeTag(isCtor);
        td.Meths[n].IsCtor := isCtor;
        td.Meths[n].IsDtor := isDtor;
        td.Meths[n].IsClassMeth := True;
        td.Meths[n].IsStatic := True;
        td.Meths[n].IsFunc := False;
        td.Meths[n].NParams := 0;
        td.Meths[n].RetTyp := TyNone;
        td.Meths[n].Vis := vis;
        td.Meths[n].Slot := -1;
        RememberMethod(td.Meths[n].Sym, AName + '.' + mname, mpos);
        AddProcEnt(td.Meths[n].Sym, td.Meths[n].Sym, False, 0, TyNone);
        if isCtor then
          AppendStr(FClassCtors, td.Meths[n].Sym)
        else
          AppendStr(FClassDtors, td.Meths[n].Sym);
        Continue;
      end;
      baseSym := ProcSym('', StemOfName(AName) + '_' + mname);
      for i := 0 to n - 1 do
        if SameId(td.Meths[i].Name, mname) and (td.Meths[i].NParams = npar) and
          not (td.Meths[i].IsClassMeth and (td.Meths[i].IsCtor or td.Meths[i].IsDtor)) then
        begin
          eq := True;
          for nn := 0 to npar - 1 do
            if (td.Meths[i].ParamTyps[nn] <> td.Meths[n].ParamTyps[nn]) or
              (td.Meths[i].ByRef[nn] <> td.Meths[n].ByRef[nn]) then
              eq := False;
          if eq then
            ov := i;
        end;
      if (ov >= 0) and OwnMeth(td.Meths[ov].Sym, baseSym) then
        Refuse('duplicate identifier ' + mname + ' (a method with the same parameters)' + mpos);
      if (ov >= 0) and (td.Meths[ov].IsClassMeth <> isClassM) then
        Refuse(mname + ' is declared again as a' + ClassMethWord(isClassM) + ', the parent''s is a' +
          ClassMethWord(td.Meths[ov].IsClassMeth) + mpos);
      if (ov >= 0) and td.Meths[ov].IsStatic and isVirt then
        Refuse(mname + ' is static in the parent: it has no slot to override' + mpos);
      if ov >= 0 then
      begin
        keepSlot := td.Meths[ov].Slot;
        if td.Meths[ov].IsVirt then
          isVirt := True;
        td.Meths[ov].ParamTyps := td.Meths[n].ParamTyps;
        td.Meths[ov].ByRef := td.Meths[n].ByRef;
        td.Meths[ov].HasDef := td.Meths[n].HasDef;
        td.Meths[ov].Def := td.Meths[n].Def;
        td.Meths[ov].DefStr := td.Meths[n].DefStr;
        td.Meths[ov].Slot := keepSlot;
        SetLength(td.Meths, n);
        n := ov;
      end;
      for i := 0 to High(td.Meths) do
        if (i <> n) and SameId(td.Meths[i].Name, mname) then
        begin
          baseSym := baseSym + '_o';
          for nn := 0 to npar - 1 do
            baseSym := baseSym + '_' + IntToStr(td.Meths[n].ParamTyps[nn]);
          Break;
        end;
      td.Meths[n].Name := mname;
      td.Meths[n].Sym := baseSym;
      td.Meths[n].IsCtor := isCtor;
      td.Meths[n].IsDtor := isDtor;
      td.Meths[n].IsVirt := isVirt or ((ov >= 0) and td.Meths[n].IsVirt);
      td.Meths[n].IsAbs := isAbs;
      td.Meths[n].IsFunc := isFunc;
      td.Meths[n].NParams := npar;
      td.Meths[n].RetTyp := t;
      td.Meths[n].Vis := vis;
      td.Meths[n].IsClassMeth := isClassM;
      td.Meths[n].IsStatic := isStat;
      if isVirt then
      begin
        td.Meths[n].IsVirt := True;
        if td.Meths[n].Slot < 0 then
        begin
          td.Meths[n].Slot := slot;
          Inc(slot);
        end;
      end
      else if ov < 0 then
        td.Meths[n].Slot := -1;
      if not isAbs then
        RememberMethod(td.Meths[n].Sym, AName + '.' + mname, mpos);
      AddProcEnt(td.Meths[n].Sym, td.Meths[n].Sym, isFunc, npar, t);
      Continue;
    end;
    if FTok.Kind <> tkIdent then
      Refuse('class member' + HerePos);
    names := nil;
    nats := nil;
    nn := 0;
    while True do
    begin
      SetLength(names, nn + 1);
      CheckName(FTok.Lexeme);
      SetLength(nats, nn + 1);
      nats[nn] := HerePos;
      names[nn] := FTok.Lexeme;
      Inc(nn);
      FTok := FLex.Next;
      if FTok.Kind <> tkComma then
        Break;
      FTok := FLex.Next;
    end;
    Eat(tkColon);
    t := Self.ParseType;
    jname := '';
    jflags := 0;
    if FTok.Kind = tkJson then
      ParseJsonDirective(t, nn, jname, jflags);
    Eat(tkSemi);
    { x: T; static; is a class variable as class var declares one (P123) }
    isStatField := False;
    if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'static') then
    begin
      FTok := FLex.Next;
      Eat(tkSemi);
      isStatField := True;
    end;
    if (cvarMode or isStatField) and (jflags <> 0) then
      Refuse('a class variable is no member of an object: json writes none' + nats[0]);
    sz := ValSize(t);
    for i := 0 to nn - 1 do
    begin
      FieldDupAt(td, names[i], nats[i]);
      if cvarMode or isStatField then
      begin
        { a global of the class's, Class.Name, exported with the class
          when the class is in an interface }
        gname := AName + '.' + names[i];
        AddVar(gname, t, False);
        if FUnitName <> '' then
        begin
          FVars[High(FVars)].Sym := FUnitName + '.' + gname;
          FVars[High(FVars)].Pub := not FInImpl;
        end;
        n := Length(td.CVars);
        SetLength(td.CVars, n + 1);
        td.CVars[n].Name := names[i];
        if i <= High(nats) then
          td.CVars[n].At := nats[i];
        td.CVars[n].Typ := t;
        td.CVars[n].Vis := vis;
        td.CVars[n].Off := -1;
        td.CVars[n].Sym := VarSym(gname);
        Continue;
      end;
      n := Length(td.Fields);
      SetLength(td.Fields, n + 1);
      td.Fields[n].Name := names[i];
      if i <= High(nats) then
        td.Fields[n].At := nats[i];
      td.Fields[n].Typ := t;
      td.Fields[n].Vis := vis;
      td.Fields[n].JName := jname;
      td.Fields[n].JFlags := jflags;
      off := FieldAt(off, t);
      td.Fields[n].Off := off;
      off := off + sz;
    end;
  end;
  if not short then
    Eat(tkEnd);
  for i := 0 to High(td.Props) do
  begin
    if td.Props[i].ReadName <> '' then
    begin
      td.Props[i].ReadOff := -1;
      for n := 0 to High(td.Fields) do
        if SameId(td.Fields[n].Name, td.Props[i].ReadName) then
          td.Props[i].ReadOff := td.Fields[n].Off;
    end;
    if td.Props[i].WriteName <> '' then
    begin
      td.Props[i].WriteOff := -1;
      for n := 0 to High(td.Fields) do
        if SameId(td.Fields[n].Name, td.Props[i].WriteName) then
          td.Props[i].WriteOff := td.Fields[n].Off;
    end;
  end;
  td.Size := RecEnd(td, off);
  td.VmtN := slot;
  td.Name := AName;
  td.Sym := UnitStem(AName);
  td.Kind := tykClass;
  for i := 0 to High(td.Ifaces) do
  begin
    par := TypeOf(td.Ifaces[i]);
    for n := 0 to High(par.Meths) do
    begin
      ov := -1;
      for nn := 0 to High(td.Meths) do
        if SameId(td.Meths[nn].Name, par.Meths[n].Name) then
          ov := nn;
      if ov < 0 then
        Refuse('interface method ' + par.Meths[n].Name);
      if td.Meths[ov].NParams <> par.Meths[n].NParams then
        Refuse('interface method ' + par.Meths[n].Name);
      if td.Meths[ov].IsFunc <> par.Meths[n].IsFunc then
        Refuse('interface method ' + par.Meths[n].Name);
    end;
  end;
  td.ScopeOwner := FTypes[Result].ScopeOwner;
  td.Nested := FTypes[Result].Nested;
  CheckScopeMembers(Result, td);
  FTypes[Result] := td;
  CheckJsonNames(Result);
  FMemberScope := saveScope;
end;

procedure TParser.ParseGenericType;
var
  name, param: string;
  pid, t, off, sz: LongInt;
  ntn, nn, i, n: SizeInt;
  td: TTypeDef;
  names: array of string;
  nats: array of string;   { where each name is (P340) }
  jname: string;
  jflags: LongInt;
begin
  Eat(tkGeneric);
  if FTok.Kind <> tkIdent then
    Expected('a generic type''s name');
  CheckName(FTok.Lexeme);
  name := DeclMemberName(FTok.Lexeme);
  FTok := FLex.Next;
  Eat(tkLt);
  if FTok.Kind <> tkIdent then
    Expected('a type parameter''s name');
  param := FTok.Lexeme;
  FTok := FLex.Next;
  Eat(tkGt);
  Eat(tkEq);
  if FTok.Kind <> tkRecord then
    Fail('record expected: a generic type is a record');
  FTok := FLex.Next;
  pid := InternParam(param);
  ntn := Length(FTypeNames);
  SetLength(FTypeNames, ntn + 1);
  FTypeNames[ntn].Name := param;
  FTypeNames[ntn].Id := pid;
  td := Default(TTypeDef);
  td.Kind := tykGeneric;
  td.Elem := pid;
  td.Fields := nil;
  off := 0;
  while FTok.Kind = tkIdent do
  begin
    names := nil;
    nats := nil;
    nn := 0;
    while True do
    begin
      SetLength(names, nn + 1);
      CheckName(FTok.Lexeme);
      SetLength(nats, nn + 1);
      nats[nn] := HerePos;
      names[nn] := FTok.Lexeme;
      Inc(nn);
      FTok := FLex.Next;
      if FTok.Kind <> tkComma then
        Break;
      FTok := FLex.Next;
    end;
    Eat(tkColon);
    t := Self.ParseType;
    jname := '';
    jflags := 0;
    if FTok.Kind = tkJson then
      ParseJsonDirective(t, nn, jname, jflags);
    Eat(tkSemi);
    sz := ValSize(t);
    for i := 0 to nn - 1 do
    begin
      FieldDupAt(td, names[i], nats[i]);
      n := Length(td.Fields);
      SetLength(td.Fields, n + 1);
      td.Fields[n].Name := names[i];
      if i <= High(nats) then
        td.Fields[n].At := nats[i];
      td.Fields[n].Typ := t;
      td.Fields[n].JName := jname;
      td.Fields[n].JFlags := jflags;
      off := FieldAt(off, t);
      td.Fields[n].Off := off;
      off := off + sz;
    end;
  end;
  Eat(tkEnd);
  Eat(tkSemi);
  SetLength(FTypeNames, ntn);
  td.Size := RecEnd(td, off);
  if td.Size < 1 then
    td.Size := 1;
  AddNamedType(name, td);
end;

{ A type json writes as a number (P205): an integer of any width, a
  subrange of one, a real, a Quad, a Currency; what quoted takes. }
function TParser.JsonNumberTyp(T: LongInt): Boolean;
var
  k: TTypeKind;
  b: LongInt;
begin
  k := TypeOf(T).Kind;
  b := T;
  if k = tykSubrange then
  begin
    b := TypeOf(T).Elem;
    k := TypeOf(b).Kind;
    if IsCharT(b) or (k = tykEnum) or (k = tykBoolean) then
    begin
      Result := False;
      Exit;
    end;
  end;
  Result := (IsIntId(b) or (k = tykInteger) or (k = tykReal) or (k = tykQuad) or
    (k = tykCurrency)) and (b <> TyBoolean) and not IsCharT(b);
end;

{ The json directive after a member's type (P205): json, then the name
  the member has in JSON, a string, and the options, each once, as the
  options of Go's struct tag (encoding/json/v2 doc.go): omitzero,
  omitempty, quoted (Go's string), required, ignore (Go's "-"), unknown
  (Go's embedded fallback), embed, and rfc3339 for a TDateTime. T is
  the member's type, NNames how many names its declaration gives. }
procedure TParser.ParseJsonDirective(T: LongInt; NNames: SizeInt; out JName: string;
  out JFlags: LongInt);
var
  f: LongInt;
  w, at, wat: string;
begin
  JName := '';
  JFlags := 0;
  at := HerePos;
  Eat(tkJson);
  if (FTok.Kind = tkString) or (FTok.Kind = tkChar) then
  begin
    while (FTok.Kind = tkString) or (FTok.Kind = tkChar) do
    begin
      if FTok.Kind = tkString then
        JName := JName + FTok.Lexeme
      else
      begin
        if (FTok.IntVal < 0) or (FTok.IntVal > 255) then
          Refuse('char code' + HerePos);
        JName := JName + Char(FTok.IntVal);
      end;
      FTok := FLex.Next;
    end;
    if JName = '' then
      Refuse('a json name is not empty: leave the name out for the member''s own' + at);
    if PasUtf8Valid(@JName[1], Length(JName), True) >= 0 then
      Refuse('a json name is UTF-8 with no noncharacter (RFC 7493 2.1)' + at);
    if NNames > 1 then
      Refuse('a json name names one member, and this declaration gives ' + IntToStr(NNames) + at);
    JFlags := JfName;
  end;
  while FTok.Kind = tkIdent do
  begin
    w := ToLower(FTok.Lexeme);
    wat := HerePos;
    if w = 'omitzero' then
      f := JfOmitZero
    else if w = 'omitempty' then
      f := JfOmitEmpty
    else if w = 'quoted' then
      f := JfQuoted
    else if w = 'required' then
      f := JfRequired
    else if w = 'ignore' then
      f := JfIgnore
    else if w = 'unknown' then
      f := JfUnknown
    else if w = 'embed' then
      f := JfEmbed
    else if w = 'rfc3339' then
      f := JfRfc3339
    else
    begin
      Refuse(FTok.Lexeme + ' is no json option: omitzero, omitempty, quoted, required, ignore, ' +
        'unknown, embed or rfc3339' + wat);
      f := 0;
    end;
    if (JFlags and f) <> 0 then
      Refuse('json ' + w + ' twice' + wat);
    JFlags := JFlags or f;
    FTok := FLex.Next;
  end;
  if JFlags = 0 then
    Refuse('json after a member''s type takes its name, a string, or its options' + at);
  if FInVariant and (JFlags <> JfIgnore) then
    Refuse('a member of a variant part takes json ignore alone: json writes no variant' + at);
  { a generic's T is checked in each instance, its type known there }
  if TypeOf(T).Kind <> tykParam then
    CheckJsonTyp(T, JFlags, at);
end;

{ The options of a json directive the member's type T takes (P205). }
procedure TParser.CheckJsonTyp(T: LongInt; JFlags: LongInt; const At: string);
var
  k: TTypeKind;
  pt: LongInt;
begin
  k := TypeOf(T).Kind;
  if ((JFlags and JfIgnore) <> 0) and (JFlags <> JfIgnore) then
    Refuse('json ignore leaves the member out and takes nothing else' + at);
  if (JFlags and JfEmbed) <> 0 then
  begin
    if JFlags <> JfEmbed then
      Refuse('json embed puts the record''s members in place of its own and takes nothing else' + at);
    pt := T;
    if k = tykPointer then
      pt := TypeOf(T).Elem;
    if (pt <= 0) or (TypeOf(pt).Kind <> tykRecord) then
      Refuse('json embed takes a record or a pointer to one, not ' + TypName(T) + at);
  end;
  if (JFlags and JfUnknown) <> 0 then
  begin
    if JFlags <> JfUnknown then
      Refuse('json unknown keeps the members no other takes and takes nothing else' + at);
    if k <> tykJson then
      Refuse('json unknown takes a json, which keeps the members no other takes, not ' +
        TypName(T) + at);
  end;
  if ((JFlags and JfQuoted) <> 0) and not JsonNumberTyp(T) then
    Refuse('json quoted writes a number inside a string, and ' + TypName(T) +
      ' is no number' + at);
  if ((JFlags and JfRfc3339) <> 0) and not ((k = tykReal) and (T <> TySingle)) then
    Refuse('json rfc3339 takes a TDateTime, a Double, not ' + TypName(T) + at);
  if ((JFlags and JfRfc3339) <> 0) and ((JFlags and JfQuoted) <> 0) then
    Refuse('json rfc3339 writes a string, and quoted a number in one' + at);
end;

{ The JSON names the members of record or class T give (P205), its
  embedded records' in their place, in Names. }
procedure TParser.JsonNamesOf(T: LongInt; var Names: TStrArray; Depth: LongInt);
var
  i: SizeInt;
  et: LongInt;
  td: TTypeDef;
begin
  if Depth > 32 then
    Refuse('json embed goes 32 records deep: ' + TypName(T) + ' embeds itself' + HerePos);
  td := TypeOf(T);
  for i := 0 to High(td.Fields) do
  begin
    if (td.Fields[i].JFlags and (JfIgnore or JfUnknown)) <> 0 then
      Continue;
    if (td.Fields[i].Vis <> VisPublic) and ((td.Fields[i].JFlags and not JfVariant) = 0) then
      Continue;
    if (td.Fields[i].JFlags and JfEmbed) <> 0 then
    begin
      et := td.Fields[i].Typ;
      if TypeOf(et).Kind = tykPointer then
        et := TypeOf(et).Elem;
      JsonNamesOf(et, Names, Depth + 1);
      Continue;
    end;
    if (td.Fields[i].JFlags and JfName) <> 0 then
      AppendStr(Names, td.Fields[i].JName)
    else
      AppendStr(Names, td.Fields[i].Name);
    AppendStr(FJsonNameAts, td.Fields[i].At);
  end;
  for i := 0 to High(td.Props) do
  begin
    if (td.Props[i].JFlags and (JfIgnore or JfUnknown)) <> 0 then
      Continue;
    if (not td.Props[i].IsPublished) and (td.Props[i].JFlags = 0) then
      Continue;
    if (td.Props[i].JFlags and JfName) <> 0 then
      AppendStr(Names, td.Props[i].JName)
    else
      AppendStr(Names, td.Props[i].Name);
      AppendStr(FJsonNameAts, td.Props[i].At);
  end;
end;

{ No two members of record or class T have one JSON name, and one at
  most keeps the unknown members (P205). }
procedure TParser.CheckJsonNames(T: LongInt);
var
  names: TStrArray;
  i, j, nu: SizeInt;
  td: TTypeDef;
begin
  td := TypeOf(T);
  nu := 0;
  for i := 0 to High(td.Fields) do
    if (td.Fields[i].JFlags and JfUnknown) <> 0 then
      Inc(nu);
  if nu > 1 then
    Refuse(TypName(T) + ' has ' + IntToStr(nu) + ' members json unknown, and one keeps them' +
      HerePos);
  names := nil;
  FJsonNameAts := nil;
  JsonNamesOf(T, names, 0);
  for i := 0 to High(names) do
    for j := i + 1 to High(names) do
      if names[i] = names[j] then
      begin
        { at the second (P340), when its place is known }
        if (j <= High(FJsonNameAts)) and (Length(FJsonNameAts) = Length(names)) then
          Refuse('two members of ' + TypName(T) + ' are ''' + names[i] + ''' in JSON: json ''name'' ' +
            'gives one another, json ignore leaves one out' + PlaceOr(FJsonNameAts[j]));
        Refuse('two members of ' + TypName(T) + ' are ''' + names[i] + ''' in JSON: json ''name'' ' +
          'gives one another, json ignore leaves one out' + HerePos);
      end;
end;

function TParser.ParseRecPart(var Td: TTypeDef; Start: LongInt;
  Stop: TTokKind): LongInt;
var
  cur, maxEnd, vend, sz, t: LongInt;
  n, nn, i: SizeInt;
  names: array of string;
  nats: array of string;   { where each name is (P340) }
  jname, tat: string;
  jflags: LongInt;
begin
  cur := Start;
  maxEnd := Start;
  while (FTok.Kind <> Stop) and (FTok.Kind <> tkEof) do
  begin
    { a method, a property or a visibility section of the record (P165) }
    if FRecMembers and RecMemberAhead then
      Break;
    if FTok.Kind = tkCase then
    begin
      vend := ParseVariant(Td, cur, Stop);
      if vend > maxEnd then
        maxEnd := vend;
      Break;
    end;
    if not IsName then
      Expected('a field''s name');
    names := nil;
    nats := nil;
    nn := 0;
    while True do
    begin
      if not IsName then
        Expected('a field''s name');
      SetLength(names, nn + 1);
      CheckName(FTok.Lexeme);
      SetLength(nats, nn + 1);
      nats[nn] := HerePos;
      names[nn] := FTok.Lexeme;
      Inc(nn);
      FTok := FLex.Next;
      if FTok.Kind <> tkComma then
        Break;
      FTok := FLex.Next;
    end;
    Eat(tkColon);
    tat := HerePos;
    t := Self.ParseType;
    { the record is named before its fields (P165): not one of them; at
      the type (P340) }
    if (FRecSelf <> 0) and (TypeOf(t).Kind <> tykPointer) and (t > TyLastBuiltin) and
      (TypeOf(t).Size = 0) and (TypeOf(t).Kind <> tykClass) then
      Refuse('a record holds no field of its own type: ' + TypName(t) + tat);
    jname := '';
    jflags := 0;
    if FTok.Kind = tkJson then
      ParseJsonDirective(t, nn, jname, jflags);
    sz := ValSize(t);
    for i := 0 to nn - 1 do
    begin
      FieldDupAt(Td, names[i], nats[i]);
      n := Length(Td.Fields);
      SetLength(Td.Fields, n + 1);
      Td.Fields[n].Name := names[i];
      if i <= High(nats) then
        Td.Fields[n].At := nats[i];
      Td.Fields[n].Typ := t;
      Td.Fields[n].Vis := FRecVis;
      Td.Fields[n].JName := jname;
      Td.Fields[n].JFlags := jflags;
      if FInVariant then
        Td.Fields[n].JFlags := jflags or JfVariant;
      cur := FieldAt(cur, t);
      Td.Fields[n].Off := cur;
      cur := cur + sz;
    end;
    if cur > maxEnd then
      maxEnd := cur;
    if FTok.Kind = tkSemi then
      FTok := FLex.Next;
  end;
  Result := maxEnd;
end;

function TParser.ParseVariant(var Td: TTypeDef; Start: LongInt;
  Stop: TTokKind): LongInt;
var
  base, maxEnd, vend, sz, t, n: LongInt;
  tag: string;
  saveVariant: Boolean;
begin
  Eat(tkCase);
  base := Start;
  if FTok.Kind = tkIdent then
  begin
    tag := FTok.Lexeme;
    FTok := FLex.Next;
    if FTok.Kind = tkColon then
    begin
      FTok := FLex.Next;
      t := Self.ParseType;
      sz := ValSize(t);
      FieldDup(Td, tag);
      n := Length(Td.Fields);
      SetLength(Td.Fields, n + 1);
      Td.Fields[n].Name := tag;
      Td.Fields[n].Typ := t;
      Td.Fields[n].Off := FieldAt(Start, t);
      base := Td.Fields[n].Off + sz;
    end
    else if not NamedType(tag, t) then
      Refuse('variant type ' + tag);
  end
  else
    t := Self.ParseType;
  Eat(tkOf);
  maxEnd := base;
  while (FTok.Kind <> Stop) and (FTok.Kind <> tkEof) do
  begin
    while (FTok.Kind <> tkColon) and (FTok.Kind <> tkEnd) and
      (FTok.Kind <> tkRParen) and (FTok.Kind <> tkEof) do
      FTok := FLex.Next;
    if FTok.Kind <> tkColon then
      Fail(''':'' expected after a variant''s labels');
    FTok := FLex.Next;
    Eat(tkLParen);
    { a variant has no JSON form: no json directive in it (P205) }
    saveVariant := FInVariant;
    FInVariant := True;
    vend := ParseRecPart(Td, base, tkRParen);
    FInVariant := saveVariant;
    Eat(tkRParen);
    if vend > maxEnd then
      maxEnd := vend;
    if FTok.Kind = tkSemi then
      FTok := FLex.Next
    else
      Break;
  end;
  Result := maxEnd;
end;

procedure TParser.ParseTypeSection;
var
  name, at, kat: string;
  td, htd: TTypeDef;
  n, fwd: SizeInt;
  off: LongInt;
  id, rid, savedSelf, saveScope: LongInt;
  outer, savedMembers: Boolean;
  recVis: Byte;
begin
  Eat(tkType);
  outer := FInTypes;
  FInTypes := True;
  while ((FTok.Kind = tkIdent) and not ((FMemberScope > 0) and RecMemberAhead)) or
    (FTok.Kind = tkGeneric) or ReservedHere('=') do
  begin
    if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'operator') then
      Break;
    if FTok.Kind = tkGeneric then
    begin
      ParseGenericType;
      Continue;
    end;
    CheckName(FTok.Lexeme);
    FDeclAt := HerePos;
    name := DeclMemberName(FTok.Lexeme);
    at := IntToStr(FTok.Line) + ':' + IntToStr(FTok.Col);
    { a class or an interface declared forward, declared whole now (P139) }
    fwd := FwdIdx(name);
    { the program's type hides a used unit's names, and is no name of
      another kind of the program's (P158) }
    if FNest = 0 then
    begin
      HideUnitNames(name, 't', nil, '');
      OwnDup(name, 't');
    end;
    { a routine's type is its own (P137) }
    if (FNest > 0) and (fwd < 0) then
    begin
      if TypeNameIdx(name) >= FTypeScope then
        Refuse('duplicate type ' + name + HerePos);
      LocalDup(name, 't');
      AppendStr(FScopeTypes, name);
    end
    else if (fwd < 0) and OwnTypeNamed(name) then
      { every kind, an alias and a class reference too (P155) }
      Refuse('duplicate type ' + name + DupAt);
    FTok := FLex.Next;
    Eat(tkEq);
    kat := HerePos;
    if (FTok.Kind <> tkClass) and (FTok.Kind <> tkInterface) then
      FwdKindIs(fwd, tykNone, name, kat);
    if FTok.Kind = tkLParen then
      ParseEnumType(name)
    else if FTok.Kind = tkType then
    begin
      { type helper for T (P127) }
      FTok := FLex.Next;
      if not IsHelperWord then
        Refuse('type goes before helper here: type helper for T' + HerePos);
      ParseHelperType(name, 0);
      Eat(tkSemi);
    end
    else if FTok.Kind = tkClass then
    begin
      { class of T, a class reference type (P123), or a class; class
        helper for C (P127); class; declares one forward (P139) }
      FTok := FLex.Next;
      if IsHelperWord or (FTok.Kind = tkOf) then
        FwdKindIs(fwd, tykNone, name, kat);
      if FTok.Kind = tkSemi then
      begin
        DeclareFwd(name, tykClass, at);
        Eat(tkSemi);
      end
      else if IsHelperWord then
      begin
        ParseHelperType(name, 2);
        Eat(tkSemi);
      end
      else if FTok.Kind = tkOf then
      begin
        FTok := FLex.Next;
        id := ClassOfTarget;
        Eat(tkSemi);
        n := Length(FTypeNames);
        SetLength(FTypeNames, n + 1);
        FTypeNames[n].Name := name;
        FTypeNames[n].Id := id;
        FTypeNames[n].Nest := FNest;
        AddScoped(name, id, 0, '');
      end
      else
      begin
        FwdKindIs(fwd, tykClass, name, kat);
        ParseClassType(name);
        Eat(tkSemi);
      end;
    end
    else if FTok.Kind = tkInterface then
    begin
      { interface; declares one forward (P139) }
      FwdKindIs(fwd, tykInterface, name, kat);
      FTok := FLex.Next;
      if FTok.Kind = tkSemi then
        DeclareFwd(name, tykInterface, at)
      else
        ParseIfaceType(name);
      Eat(tkSemi);
    end
    else if FTok.Kind = tkRecord then
    begin
      FTok := FLex.Next;
      if IsHelperWord then
      begin
        { record helper for R (P127) }
        ParseHelperType(name, 1);
        Eat(tkSemi);
        Continue;
      end;
      td := Default(TTypeDef);
      td.Kind := tykRecord;
      td.Fields := nil;
      { the record is named first (P165): its methods take and give it,
        and no field of it may be it }
      rid := AddNamedType(name, td);
      saveScope := FMemberScope;
      FMemberScope := rid;
      htd := Default(TTypeDef);
      recVis := VisPublic;
      savedMembers := FRecMembers;
      savedSelf := FRecSelf;
      FRecMembers := True;
      FRecSelf := rid;
      off := 0;
      repeat
        td.CVars := htd.CVars;
        FRecVis := recVis;
        off := ParseRecPart(td, off, tkEnd);
        if FTok.Kind = tkEnd then
          Break;
        if FTok.Kind = tkVar then
          FTok := FLex.Next
        else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'strict') then
        begin
          FTok := FLex.Next;
          if (FTok.Kind <> tkIdent) or not SameId(FTok.Lexeme, 'private') then
            Refuse('strict goes before private in a record' + HerePos);
          recVis := VisStrictPrivate;
          FTok := FLex.Next;
        end
        else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'private') then
        begin
          recVis := VisPrivate;
          FTok := FLex.Next;
        end
        else if (FTok.Kind = tkIdent) and (SameId(FTok.Lexeme, 'public') or
          SameId(FTok.Lexeme, 'published')) then
        begin
          recVis := VisPublic;
          FTok := FLex.Next;
        end
        else if (FTok.Kind = tkIdent) and SameId(FTok.Lexeme, 'protected') then
          Refuse('a record has no descendants: private, strict private or public' + HerePos)
        else
        begin
          { a method or a property: the record's own helper holds it }
          FRecVis := VisPublic;
          ParseHelperMember(htd, name, recVis, rid, td.Fields);
          { a field after a member needs a visibility section first }
          while RecMemberAhead and (FTok.Kind <> tkVar) and not ((FTok.Kind = tkIdent) and (SameId(FTok.Lexeme, 'private') or
            SameId(FTok.Lexeme, 'public') or SameId(FTok.Lexeme, 'protected') or
            SameId(FTok.Lexeme, 'published') or SameId(FTok.Lexeme, 'strict'))) do
            ParseHelperMember(htd, name, recVis, rid, td.Fields);
          if (FTok.Kind <> tkEnd) and not RecMemberAhead then
            Refuse('a record''s fields come before its methods and properties, or after private ' +
              'or public' + HerePos);
        end;
      until False;
      FRecMembers := savedMembers;
      FRecSelf := savedSelf;
      FRecVis := VisPublic;
      Eat(tkEnd);
      Eat(tkSemi);
      td.Size := RecEnd(td, off);
      if td.Size < 1 then
        td.Size := 1;
      FTypes[rid].Fields := td.Fields;
      FTypes[rid].Size := td.Size;
      CheckJsonNames(rid);
      htd.Fields := td.Fields;
      CheckScopeMembers(rid, htd);
      if (Length(htd.Meths) > 0) or (Length(htd.Props) > 0) or (Length(htd.CVars) > 0) then
        MakeRecordHelper(rid, name, htd);
      FMemberScope := saveScope;
    end
    else
    begin
      id := ParseType;
      Eat(tkSemi);
      n := Length(FTypeNames);
      SetLength(FTypeNames, n + 1);
      FTypeNames[n].Name := name;
      FTypeNames[n].Id := id;
      FTypeNames[n].Nest := FNest;
      AddScoped(name, id, 0, '');
      ResolvePending(name, id);
    end;
  end;
  FInTypes := outer;
  if not outer then CheckPending;
end;

{ The arguments of Write and WriteLn. The list is optional, as in every
  Pascal: a bare WriteLn ends the line and a bare Write writes nothing
  (it was a syntax error until 1.0.49). }
{ A Write argument with its format (1.0.79): x:w pads x to w columns,
  x:w:d gives a real d decimals, and every real prints through pasfmt,
  exactly at any size (it printed 1e20 as -9223372036854775808.0 and cut
  2.675 to 2.674999). }
function TParser.FmtArg(E, W, D: PExpr): PExpr;
var
  k: TTypeKind;
  extra: TExprArray;
  have: TProcEnt;
begin
  Result := E;
  CheckTyped(E);
  k := TypeOf(E^.Typ).Kind;
  { a json prints as its compact text (P203), padded as a string }
  if k = tykJson then
  begin
    extra := nil;
    SetLength(extra, 1);
    extra[0] := E;
    E := CoreProc('PasJsonText', extra, TyString);
    Result := E;
    k := tykString;
  end;
  if k = tykCurrency then
  begin
    if W = nil then W := NewInt(0);
    if D = nil then D := NewInt(-1);
    extra := nil; SetLength(extra, 3);
    extra[0] := CurrRaw(E); extra[1] := W; extra[2] := D;
    Result := CoreProc('PasFmtCurrency', extra, TyString);
    Exit;
  end;
  { A Quad prints exactly, as a Double does (P103). }
  if k = tykQuad then
  begin
    if W = nil then
      W := NewInt(0);
    if D = nil then
      D := NewInt(-1);
    extra := nil;
    SetLength(extra, 3);
    extra[0] := E;
    extra[1] := W;
    extra[2] := D;
    Result := NewCall('rtq_fmt', extra, TyString);
    Exit;
  end;
  if (W = nil) and (k <> tykReal) then
    Exit;
  if not FindProc('PasFmtReal', have) then
    Refuse('Write of a real or a width needs the core unit pasfmt');
  if W = nil then
    W := NewInt(0);
  extra := nil;
  if k = tykReal then
  begin
    if D = nil then
      D := NewInt(-1);
    SetLength(extra, 2);
    extra[0] := W;
    extra[1] := D;
    { Write is no context (P101): a Single is worked out in Single, then
      printed as the Double it is exactly. }
    if E^.Typ = TySingle then
      E := WidenLeaf(E, TyReal);
    Result := CoreCall('PasFmtReal', E, extra);
    Exit;
  end;
  if D <> nil then
    Refuse('decimals are for a real at ' + IntToStr(FTok.Line) + ':' + IntToStr(FTok.Col));
  SetLength(extra, 1);
  extra[0] := W;
  if IsCharT(E^.Typ) or (k = tykString) then
    Result := CoreCall('PasFmtStr', StrArg(TyString, E), extra)
  else if (k = tykInteger) or (k = tykBoolean) or (k = tykEnum) or
    (k = tykSubrange) then
    Result := CoreCall('PasFmtInt', E, extra)
  else
    Refuse('Write cannot pad this value at ' + IntToStr(FTok.Line) + ':' + IntToStr(FTok.Col));
end;

procedure TParser.ParseWriteArgs(St: PStmt);
var
  n: SizeInt;
  e, w, d: PExpr;
begin
  St^.Args := nil;
  if FTok.Kind <> tkLParen then
    Exit;
  FTok := FLex.Next;
  if FTok.Kind <> tkRParen then
  begin
    while True do
    begin
      n := Length(St^.Args);
      SetLength(St^.Args, n + 1);
      e := ParseExpr;
      { Write printed a record's, a static array's or a slice's address
        as a number (1.0.125): it prints values, so it says so. }
      if (e <> nil) and IsVecTyp(e^.Typ) then
        Refuse('Write does not print a ' + FTypes[e^.Typ].Name + ': view its lanes, as (v as ' +
          'array[0..' + IntToStr(FTypes[e^.Typ].Size - 1) + '] of Byte)[i]' + PosOf(e));
      if (e <> nil) and (TypeOf(e^.Typ).Kind = tykRecord) then
        Refuse('Write does not print a record: write its fields' + PosOf(e));
      if (e <> nil) and (TypeOf(e^.Typ).Kind = tykArray) then
        Refuse('Write does not print an array: write its elements' + PosOf(e));
      if (e <> nil) and (e^.Kind = ekSet) and ((e^.Flags and 64) <> 0) then
        Refuse('Write does not print a list: write its elements' + PosOf(e));
      if (e <> nil) and (TypeOf(e^.Typ).Kind = tykSet) then
        Refuse('Write does not print a set: x in s tests an element' + PosOf(e));
      w := nil;
      d := nil;
      if FTok.Kind = tkColon then
      begin
        FTok := FLex.Next;
        w := ParseExpr;
        if FTok.Kind = tkColon then
        begin
          FTok := FLex.Next;
          d := ParseExpr;
        end;
      end;
      { a subrange of Char prints as a Char (P135) }
      St^.Args[n] := FmtArg(AsChar(e), w, d);
      if FTok.Kind <> tkComma then
        Break;
      FTok := FLex.Next;
    end;
  end;
  Eat(tkRParen);
end;

function TParser.ParseArgList: TExprArray;
var
  n: SizeInt;
  args: TExprArray;
  noeq: Boolean;
begin
  args := nil;
  noeq := FNoEq;
  FNoEq := False;
  Eat(tkLParen);
  if FTok.Kind <> tkRParen then
  begin
    while True do
    begin
      n := Length(args);
      SetLength(args, n + 1);
      args[n] := ParseExpr;
      if FTok.Kind <> tkComma then
        Break;
      FTok := FLex.Next;
    end;
  end;
  Eat(tkRParen);
  FNoEq := noeq;
  Result := args;
end;

{ E[Lo..Hi] (P104): a slice's or a static array's elements Lo to Hi as a
  slice that shares their memory, its capacity 0 so that SetLength takes
  a new block and never grows into what is not its own; a string's as
  Copy(s, Lo, Hi - Lo + 1), since a string's characters are shared only
  whole. The bounds are checked where the slice is made. }
function TParser.SliceOf(E, Lo, Hi: PExpr): PExpr;
var
  st: TTypeDef;
  a: TExprArray;
begin
  st := TypeOf(E^.Typ);
  Lo := ValArg(TyInteger, Lo);
  Hi := ValArg(TyInteger, Hi);
  a := nil;
  SetLength(a, 3);
  a[0] := E;
  a[1] := Lo;
  if st.Kind = tykString then
  begin
    a[2] := ApplyOp(boAdd, ApplyOp(boSub, Hi, Lo), NewInt(1));
    Result := NewCall('rt_copy', a, TyString);
    Exit;
  end;
  a[2] := Hi;
  if IsDynTyp(E^.Typ) then
    Result := NewCall('rt_slice', a, E^.Typ)
  else if st.Kind = tykArray then
    Result := NewCall('rt_aslice', a, InternArray(st.Elem, 0, -1))
  else
    Refuse('a slice [i..j] of an array, a slice or a string' + HerePos);
end;

{ E.P, property I of E's class (moved out of ParsePostfix in 1.0.137,
  which reads a property of Self with no Self. too, as FPC does): its
  field, its accessor methods, or an indexed one's [arguments]; its
  visibility is checked at ALine:ACol. }
function TParser.PropAccess(E: PExpr; I: SizeInt; ALine, ACol: LongInt): PExpr;
var
  st: TTypeDef;
  k: SizeInt;
  roff, woff, ftyp: LongInt;
  rmeth, wmeth, fname: string;
  args: TExprArray;
begin
  st := TypeOf(E^.Typ);
  CheckVis(E^.Typ, 2, I, ALine, ACol);
  if st.Props[I].NIndex > 0 then
  begin
    Result := NewProp(E, st.Props[I].Typ, -1, -1, st.Props[I].ReadName,
      st.Props[I].WriteName);
    if FTok.Kind <> tkLBrack then
      Fail('''['' expected: an indexed property takes its index in brackets');
    FTok := FLex.Next;
    args := nil;
    if FTok.Kind <> tkRBrack then
      while True do
      begin
        k := Length(args);
        SetLength(args, k + 1);
        args[k] := ParseExpr;
        if FTok.Kind <> tkComma then
          Break;
        FTok := FLex.Next;
      end;
    Eat(tkRBrack);
    if Length(args) <> st.Props[I].NIndex then
      Refuse('the property takes ' + IntToStr(st.Props[I].NIndex) + ' index values');
    Result^.Args := args;
    Exit;
  end;
  roff := -1;
  woff := -1;
  for k := 0 to High(st.Fields) do
  begin
    if (st.Props[I].ReadName <> '') and
      SameId(st.Fields[k].Name, st.Props[I].ReadName) then
      roff := st.Fields[k].Off;
    if (st.Props[I].WriteName <> '') and
      SameId(st.Fields[k].Name, st.Props[I].WriteName) then
      woff := st.Fields[k].Off;
  end;
  rmeth := '';
  wmeth := '';
  if (st.Props[I].ReadName <> '') and (roff < 0) then
    rmeth := st.Props[I].ReadName;
  if (st.Props[I].WriteName <> '') and (woff < 0) then
    wmeth := st.Props[I].WriteName;
  if (rmeth <> '') or (wmeth <> '') then
    Result := NewProp(E, st.Props[I].Typ, roff, woff, rmeth, wmeth)
  else if roff >= 0 then
  begin
    fname := st.Props[I].Name;
    ftyp := st.Props[I].Typ;
    Result := NewField(E, fname, ftyp, roff);
  end
  else
    Refuse('unknown accessor ' + st.Props[I].Name);
end;

{ AName as a member of Self in a method (1.0.137 gathers the paths): a
  field, a property, or a method called (with the arguments that follow,
  if any); each checked for visibility at ALine:ACol. nil when the class
  has no such member or no method of that name takes the arguments. }
function TParser.SelfMember(const AName: string; ALine, ACol: LongInt): PExpr;
var
  i, mi: SizeInt;
  have, noObj: Boolean;
  args: TExprArray;
begin
  Result := nil;
  if FClassTyp = 0 then
    Exit;
  { a class method has the class and no object (P123) }
  noObj := FSelfClassRef or FNoSelf;
  for i := 0 to High(FTypes[FClassTyp].Fields) do
    if SameId(FTypes[FClassTyp].Fields[i].Name, AName) then
    begin
      if noObj then
        Refuse(AName + ' is a field of an object, and a class method has none at ' +
          IntToStr(ALine) + ':' + IntToStr(ACol));
      CheckVis(FClassTyp, 0, i, ALine, ACol);
      Result := NewField(NewVar('self', FClassTyp), FTypes[FClassTyp].Fields[i].Name,
        FTypes[FClassTyp].Fields[i].Typ, FTypes[FClassTyp].Fields[i].Off);
      Exit;
    end;
  { a class variable or a class property of the class, in any method
    (P123) }
  if (not IsLocalName(AName)) and ((CVarIndex(FClassTyp, AName) >= 0) or
    ClassPropNamed(FClassTyp, AName)) then
  begin
    ClassMember(FClassTyp, SelfVmt, AName, ALine, ACol, Result);
    Exit;
  end;
  if not IsLocalName(AName) then
    for i := 0 to High(FTypes[FClassTyp].Props) do
      if SameId(FTypes[FClassTyp].Props[i].Name, AName) then
      begin
        if noObj then
          Refuse(AName + ' is a property of an object, and a class method has none at ' +
            IntToStr(ALine) + ':' + IntToStr(ACol));
        Result := PropAccess(NewVar('self', FClassTyp), i, ALine, ACol);
        Exit;
      end;
  have := False;
  for i := 0 to High(FTypes[FClassTyp].Meths) do
    if SameId(FTypes[FClassTyp].Meths[i].Name, AName) then
      have := True;
  if not have then
  begin
    { ClassName and its kin alone in a method are Self's (P121), the
      class's in a class method (P123) }
    if IsClassWord(AName) then
    begin
      args := nil;
      if FTok.Kind = tkLParen then
        args := ParseArgList;
      Result := ClassWordVmt(SelfVmt, AName, args);
      Exit;
    end;
    { Free alone in a method is Self.Free (1.0.137) }
    if SameId(AName, 'Free') and (FTok.Kind <> tkLParen) and not noObj then
    begin
      Result := NewMethod(NewVar('self', FClassTyp), '', nil, TyNone, -1);
      Result^.Flags := 16;
    end;
    Exit;
  end;
  { a constructor alone in a class method makes an object of Self's
    class, the class it was called for (P123) }
  if noObj then
    for i := 0 to High(FTypes[FClassTyp].Meths) do
      if SameId(FTypes[FClassTyp].Meths[i].Name, AName) and
        FTypes[FClassTyp].Meths[i].IsCtor and CallableMeth(FTypes[FClassTyp].Meths[i]) then
      begin
        Result := CtorThrough(FClassTyp, SelfVmt, AName, ALine, ACol);
        Exit;
      end;
  args := nil;
  have := FTok.Kind = tkLParen;
  if have then
    args := ParseArgList;
  if PickMethAt(FTypes[FClassTyp].Meths, AName, args, have, mi, ALine, ACol) and
    FTypes[FClassTyp].Meths[mi].IsClassMeth then
  begin
    { a class method: Self's class, the class in a class method (P123) }
    CheckVis(FClassTyp, 1, mi, ALine, ACol);
    if Length(args) <> FTypes[FClassTyp].Meths[mi].NParams then
      Refuse('wrong number of arguments for ' + AName + ' at ' + IntToStr(ALine) + ':' +
        IntToStr(ACol));
    Result := ClassMethCall(FClassTyp, SelfVmt, mi, args);
  end
  else if (mi >= 0) and (mi <= High(FTypes[FClassTyp].Meths)) and
    SameId(FTypes[FClassTyp].Meths[mi].Name, AName) then
  begin
    if noObj then
      Refuse(AName + ' is an object''s method, and a class method has no object at ' +
        IntToStr(ALine) + ':' + IntToStr(ACol));
    CheckVis(FClassTyp, 1, mi, ALine, ACol);
    for i := 0 to High(args) do
      if (i <= High(FTypes[FClassTyp].Meths[mi].ByRef)) and FTypes[FClassTyp].Meths[mi].ByRef[i] then
        args[i] := VarArgOf(args[i]);
    Result := NewMethod(NewVar('self', FClassTyp), FTypes[FClassTyp].Meths[mi].Sym,
      args, FTypes[FClassTyp].Meths[mi].RetTyp, FTypes[FClassTyp].Meths[mi].Slot);
  end;
end;

{ The member AName of E, read after E's dot at ALine:ACol, with what
  follows it (a method's arguments): a scoped constant or variable of E's
  type, a member of its helper (P127), a class's property, field, method,
  class variable or property, an interface's method, a record's field or
  a sync type's method. Out of ParsePostfix for a with on an object
  (P172), whose names are its members as obj.name reaches them. }
function TParser.DotMember(E: PExpr; const AName: string; ALine, ACol: LongInt): PExpr;
var
  st: TTypeDef;
  i, k, mi: SizeInt;
  ftyp, foff, cls, hk: LongInt;
  fname: string;
  found, have: Boolean;
  args: TExprArray;
begin
  if ScopedValue(E^.Typ, AName, Result) then
    Exit;
  { a member of the value's helper (P127), before the type's own: a
    helper's method hides a class's of the name, as in FPC, the class's
    at the helper's own level (P380) }
  hk := MemberHelper(E^.Typ, AName);
  if hk <> 0 then
  begin
    Result := HelperMember(E, hk, AName, ALine, ACol);
    Exit;
  end;
  cls := E^.Typ;
  st := TypeOf(E^.Typ);
  found := False;
  if st.Kind = tykClass then
  begin
    { each member's visibility is checked where it is used (1.0.137) }
    for i := 0 to High(st.Props) do
      if SameId(st.Props[i].Name, AName) then
      begin
        E := PropAccess(E, i, ALine, ACol);
        found := True;
        Break;
      end;
    if not found then
      for i := 0 to High(st.Fields) do
        if SameId(st.Fields[i].Name, AName) then
        begin
          CheckVis(cls, 0, i, ALine, ACol);
          fname := st.Fields[i].Name;
          ftyp := st.Fields[i].Typ;
          foff := st.Fields[i].Off;
          E := NewField(E, fname, ftyp, foff);
          found := True;
          Break;
        end;
    if not found then
    begin
      args := nil;
      have := False;
      if FTok.Kind = tkLParen then
      begin
        args := ParseArgList;
        have := True;
      end;
      if PickMethAt(st.Meths, AName, args, have, mi, ALine, ACol) and st.Meths[mi].IsClassMeth then
      begin
        { a class method on an object: Self is the object's class
          (P123) }
        CheckVis(cls, 1, mi, ALine, ACol);
        if Length(args) <> st.Meths[mi].NParams then
          Refuse('wrong number of arguments for ' + st.Name + '.' + AName + ' at ' +
            IntToStr(ALine) + ':' + IntToStr(ACol));
        E := ClassMethCall(cls, VmtOf(E), mi, args);
        found := True;
      end
      else if (mi >= 0) and (mi <= High(st.Meths)) and SameId(st.Meths[mi].Name, AName) then
      begin
        CheckVis(cls, 1, mi, ALine, ACol);
        if have then
          for k := 0 to High(args) do
            if (k <= High(st.Meths[mi].ByRef)) and st.Meths[mi].ByRef[k] then
              args[k] := VarArgOf(args[k]);
        { a function with parameters and no ( is not a call: its
          method value, as a procedure's (1.0.135) }
        if have or (st.Meths[mi].IsFunc and not NeedsArgs(st.Meths[mi])) then
          E := NewMethod(E, st.Meths[mi].Sym, args, st.Meths[mi].RetTyp,
            st.Meths[mi].Slot)
        else
        begin
          E := NewMethPtr(E, st.Meths[mi].Sym, st.Meths[mi].Slot);
          E^.Typ := InternMethodSig(st.Meths[mi].IsFunc, st.Meths[mi].RetTyp,
            st.Meths[mi].ParamTyps, st.Meths[mi].ByRef);
        end;
        found := True;
      end;
    end;
    { an object's class variable or class property (P123) }
    if (not found) and ((CVarIndex(cls, AName) >= 0) or ClassPropNamed(cls, AName)) then
      found := ClassMember(cls, VmtOf(E), AName, ALine, ACol, E);
    if not found then
    begin
      if IsClassWord(AName) then
      begin
        { ClassName, InstanceSize, ClassNameIs of the object's class
          (P121), read from its method table }
        E := ClassWord(E, AName, args);
        found := True;
      end
      else if SameId(AName, 'Free') then
      begin
        { Flags 16: x.Free, which calls x's Destroy when x is not nil
          (1.0.137); the statement makes it (FreeStmt) }
        E := NewMethod(E, '', nil, TyNone, -1);
        E^.Flags := 16;
        found := True;
      end
      else
        Refuse('unknown member ' + AName);
    end;
  end
  else if st.Kind = tykClassRef then
  begin
    { a member of the class a reference holds (P123) }
    if not ClassMember(st.Elem, E, AName, ALine, ACol, E) then
      Refuse('unknown class member ' + TypeOf(st.Elem).Name + '.' + AName + ' at ' +
        IntToStr(ALine) + ':' + IntToStr(ACol));
  end
  else if st.Kind = tykInterface then
  begin
    for i := 0 to High(st.Meths) do
      if SameId(st.Meths[i].Name, AName) then
      begin
        args := nil;
        if FTok.Kind = tkLParen then
          args := ParseArgList;
        FillMethDefs(st.Meths[i], args);
        if Length(args) <> st.Meths[i].NParams then
          Refuse('wrong number of arguments');
        { converted and by address as a class's method takes them
          (1.0.136): a var or out argument went as its value, and the
          method wrote through it to address 0 }
        CoerceArgs(st.Meths[i].ParamTyps, st.Meths[i].ByRef, args);
        for k := 0 to High(args) do
          if (k <= High(st.Meths[i].ByRef)) and st.Meths[i].ByRef[k] then
            args[k] := VarArgOf(args[k]);
        E := NewMethod(E, st.Meths[i].Name, args, st.Meths[i].RetTyp,
          st.Meths[i].Slot);
        found := True;
        Break;
      end;
    if not found then
      Refuse('unknown member ' + AName);
  end
  else if st.Kind = tykRecord then
  begin
    for i := 0 to High(st.Fields) do
      if SameId(st.Fields[i].Name, AName) then
      begin
        CheckRecField(E^.Typ, i, ALine, ACol);
        fname := st.Fields[i].Name;
        ftyp := st.Fields[i].Typ;
        foff := st.Fields[i].Off;
        E := NewField(E, fname, ftyp, foff);
        found := True;
        Break;
      end;
    if not found then
      E := CoreMethod(E, AName);
  end
  else
  begin
    { a value with no members of its own: its helper's (P127) }
    if (E^.Typ > 0) and (HelperFor(E^.Typ) <> 0) then
      Refuse(AName + ' is no member of ' + TypName(E^.Typ) + ': the helper in scope, ' +
        FTypes[HelperFor(E^.Typ)].Name + ', has none' + ' at ' + IntToStr(ALine) + ':' +
        IntToStr(ACol));
    Refuse(TypName(E^.Typ) + ' has no members: ' + AName + ' needs a record, an object or a ' +
      'helper for ' + TypName(E^.Typ) + ' at ' + IntToStr(ALine) + ':' + IntToStr(ACol));
  end;
  Result := E;
end;

function TParser.ParsePostfix(E: PExpr): PExpr;
var
  st: TTypeDef;
  i, k, mi: SizeInt;
  ftyp, foff, cls, nline, ncol: LongInt;
  name, fname: string;
  ix, hi: PExpr;
  found, have: Boolean;
  args: TExprArray;
begin
  { the base starts where its primary does (P340): its place before the
    chain of fields, elements and calls after it is read }
  if (E <> nil) and (E^.PosLine = 0) and (FPrimLine > 0) then
  begin
    E^.PosLine := FPrimLine;
    E^.PosCol := FPrimCol;
  end;
  while True do
  begin
    if FTok.Kind = tkDot then
    begin
      FTok := FLex.Next;
      if FTok.Lexeme = '' then
        Fail('field name');
      name := FTok.Lexeme;
      nline := FTok.Line;
      ncol := FTok.Col;
      FTok := FLex.Next;
      E := DotMember(E, name, nline, ncol);
    end
    else if (FTok.Kind = tkLParen) and (TypeOf(E^.Typ).Kind = tykProc) then
    begin
      { A call through whatever gave us a routine value: an element of
        an array, a field of a record, or what another call gave back
        (P81). }
      st := TypeOf(E^.Typ);
      args := ParseArgList;
      ValArgs(st.Meths[0], args, 'routine value', PosOf(E));
      E := NewMethod(E, '', args, st.Meths[0].RetTyp, -4);
    end
    else if (FTok.Kind = tkLParen) and (TypeOf(E^.Typ).Kind = tykMethod) then
    begin
      { a call through a method value in a field or an element (1.0.135) }
      args := ParseArgList;
      E := MethValCall(E, args);
    end
    else if FTok.Kind = tkCaret then
    begin
      FTok := FLex.Next;
      st := TypeOf(E^.Typ);
      if st.Kind <> tykPointer then
        Refuse(TypName(E^.Typ) + ' is not a pointer: ^ reads through one' + PosOf(E));
      { An untyped Pointer's target is typed by the view around it. }
      if st.Elem = TyNone then
        NotSafeAt('reach through an untyped Pointer', PosOf(E));
      E := NewDeref(E, st.Elem);
      if st.Elem <> TyNone then
        CheckReach(E^.L, 0, ValSize(st.Elem));
    end
    else if FTok.Kind = tkLBrack then
    begin
      FTok := FLex.Next;
      ix := ParseExpr;
      if FTok.Kind = tkDotDot then
      begin
        FTok := FLex.Next;
        hi := ParseExpr;
        Eat(tkRBrack);
        if TypeOf(E^.Typ).Kind = tykTree then
        begin
          args := nil;
          SetLength(args, 3);
          args[0] := E;
          args[1] := MapKeyArg(E, ix);
          args[2] := MapKeyArg(E, hi);
          E := NewCall('rt_treerange', args, E^.Typ);
          E^.Flags := 1;
        end
        else
        begin
          NoReal(ix, 'Integer');
          NoReal(hi, 'Integer');
          E := SliceOf(E, ix, hi);
        end;
        Continue;
      end;
      { m[i, j] is m[i][j] (P161): the comma opens the next index }
      if FTok.Kind = tkComma then
        FTok.Kind := tkLBrack
      else
        Eat(tkRBrack);
      st := TypeOf(E^.Typ);
      if (st.Kind <> tykMap) and (st.Kind <> tykTree) and (st.Kind <> tykJson) then
        NoReal(ix, 'Integer');
      if st.Kind = tykJson then
      begin
        { j['k'] and j[i] (P203): a member of an object, an element of
          an array; a missing member, another kind or an index out of
          range raises EJsonError with the pointer of what was asked }
        CheckTyped(ix);
        args := nil;
        SetLength(args, 2);
        args[0] := E;
        if IsStrTyp(ix^.Typ) or IsCharT(ix^.Typ) then
        begin
          args[1] := StrArg(TyString, ix);
          E := CoreProc('PasJsonGet', args, -1);
        end
        else if (TypeOf(ix^.Typ).Kind = tykInteger) or (TypeOf(ix^.Typ).Kind = tykSubrange) then
        begin
          args[1] := ValArg(TyInteger, ix);
          E := CoreProc('PasJsonItem', args, -1);
        end
        else
          Refuse('a json is indexed by a name, a string, or a place, an Integer, not ' +
            TypName(ix^.Typ) + PosOf(ix));
      end
      else if st.Kind = tykArray then
        E := NewIndex(E, ix, st.Elem)
      else if st.Kind = tykString then
        E := NewIndex(E, ix, TyChar)
      else if st.Kind = tykPointer then
      begin
        NotSafeAt('index a pointer; an array or a slice checks its index', PosOf(E));
        if st.Elem = TyNone then
          Refuse('an untyped Pointer is indexed through a view: PByte(p)[i]' + PosOf(E));
        if ix^.Kind = ekInt then
          CheckReach(E, ix^.Num * PtrStep(E^.Typ), ValSize(st.Elem));
        E := NewIndex(E, ix, st.Elem);
      end
      else if st.Kind = tykMap then
      begin
        args := nil;
        SetLength(args, 2);
        args[0] := E;
        args[1] := MapKeyArg(E, ix);
        E := NewCall('rt_mapget', args, st.Elem2);
      end
      else if st.Kind = tykTree then
      begin
        args := nil;
        SetLength(args, 2);
        args[0] := E;
        args[1] := MapKeyArg(E, ix);
        if st.Elem2 < 0 then
          E := NewCall('rt_treeget', args, TyBoolean)
        else
          E := NewCall('rt_treeget', args, st.Elem2);
      end
      else
        Fail('not an array kind=' + IntToStr(Ord(st.Kind)) +
          ' typ=' + IntToStr(E^.Typ));
    end
    else
      Break;
  end;
  Result := E;
end;

{ ' at line:column' of statement S (P340), the token at hand for one
  the compiler made. }
function TParser.StmtAt(S: PStmt): string;
begin
  if (S <> nil) and (S^.Col > 0) then
    Result := ' at ' + IntToStr(S^.Line) + ':' + IntToStr(S^.Col)
  else
    Result := HerePos;
end;

{ ' at ALine:ACol', or the token at hand for no place (P340). }
function TParser.MethAt(ALine, ACol: LongInt): string;
begin
  if ALine > 0 then
    Result := ' at ' + IntToStr(ALine) + ':' + IntToStr(ACol)
  else
    Result := HerePos;
end;

{ At, or the token at hand when it is '' (P340). }
function TParser.PlaceOr(const At: string): string;
begin
  if At <> '' then
    Result := At
  else
    Result := HerePos;
end;

{ The place of E for a message, ' at line:column' of its first token
  (P340), or the token's at hand for an expression the compiler made. }
function TParser.PosOf(E: PExpr): string;
begin
  if (E <> nil) and (E^.PosLine > 0) then
    Result := ' at ' + IntToStr(E^.PosLine) + ':' + IntToStr(E^.PosCol)
  else
    Result := HerePos;
end;

{ A primary expression with the place of its first token, when what was
  read has none of its own (P340): a name, a literal, a call, a typecast;
  a field, an element or a method takes its base's (PosFrom). }
function TParser.ParsePrimary: PExpr;
var
  l, c, wl, wc: LongInt;
  was: string;
begin
  l := FTok.Line;
  c := FTok.Col;
  { a builtin's name for its helpers' refusals, the outer one's back after }
  was := FBuiltinAt;
  FBuiltinAt := HerePos;
  wl := FPrimLine;
  wc := FPrimCol;
  FPrimLine := l;
  FPrimCol := c;
  Result := ParsePrimary0;
  FBuiltinAt := was;
  FPrimLine := wl;
  FPrimCol := wc;
  if (Result <> nil) and (Result^.PosLine = 0) then
  begin
    Result^.PosLine := l;
    Result^.PosCol := c;
  end;
end;

function TParser.ParsePrimary0: PExpr;
var
  name, mname, buf, fname: string;
  cv: Int64;
  conv: PExpr;
  cft: LongInt;
  cfs: string;
  nstr, nchr, nline, ncol: LongInt;
  pe: TProcEnt;
  args: TExprArray;
  st: TTypeDef;
  i, mi, wi: SizeInt;
  id, ftyp, foff: LongInt;
  e, e2: PExpr;
  etyp: LongInt;
  have, ctorHere, lst, noeq: Boolean;
  k: TTypeKind;
  t2: LongInt;
  mfa: TExprArray;
begin
  Result := nil;
  { the primary's first token, a builtin's name for its refusals (P340);
    an identifier's branch sets them again to the same }
  nline := FTok.Line;
  ncol := FTok.Col;
  case FTok.Kind of
    tkFunction, tkProcedure:
      Result := ParseAnon;
    tkInherited:
      Result := ParseInherited;
    tkInt:
      begin
        { 2^63 stands only after a minus (ParseUnary, 1.0.136). }
        if FTok.Lexeme = '9223372036854775808' then
          Refuse('constant 9223372036854775808 does not fit Integer: -9223372036854775808 is the lowest' +
            HerePos);
        Result := NewInt(FTok.IntVal);
        Result^.Flags := 1;
        FTok := FLex.Next;
      end;
    tkReal:
      begin
        { A literal has no type until its context gives it one (P101): it
          keeps its digits, so a Single rounds from them once. }
        Result := NewReal(FTok.IntVal);
        Result^.Flags := 1;
        Result^.Txt := FTok.Lexeme;
        FTok := FLex.Next;
      end;
    tkString, tkChar:
      begin
        buf := '';
        nstr := 0;
        nchr := 0;
        while (FTok.Kind = tkString) or (FTok.Kind = tkChar) do
        begin
          if FTok.Kind = tkString then
          begin
            buf := buf + FTok.Lexeme;
            Inc(nstr);
          end
          else
          begin
            if (FTok.IntVal < 0) or (FTok.IntVal > 255) then
              Refuse('char code' + MethAt(nline, ncol));
            buf := buf + Char(FTok.IntVal);
            Inc(nchr);
          end;
          FTok := FLex.Next;
        end;
        if (nstr = 0) and (nchr = 1) then
        begin
          { A lone #nn is a Char: it prints as that byte. }
          Result := NewInt(Ord(buf[1]));
          Result^.Typ := TyChar;
        end
        else
          Result := NewStr(buf);
        { 'text'.Method of a string's helper (P127) }
        if (FTok.Kind = tkDot) and (HelperFor(Result^.Typ) <> 0) then
          Result := ParsePostfix(Result);
      end;
    tkTrue:
      begin
        Result := NewInt(1);
        Result^.Typ := TyBoolean;
        FTok := FLex.Next;
      end;
    tkFalse:
      begin
        Result := NewInt(0);
        Result^.Typ := TyBoolean;
        FTok := FLex.Next;
      end;
    tkNil:
      begin
        Result := NewNil;
        FTok := FLex.Next;
      end;
    tkMakeChan:
      begin
        FTok := FLex.Next;
        Eat(tkLParen);
        e := nil;
        { MakeChan(n): a buffer of n values, as Go's make(chan T, n)
          (1.0.85); MakeChan() has none. }
        if FTok.Kind <> tkRParen then
        begin
          e := ValArg(TyInteger, ParseExpr);
          { A constant capacity is checked here (1.0.136): MakeChan(-1)
            divided by zero in the heap, 2^60 followed nil and 2^61 wrote
            past the ring; one worked out at run time stops in
            rt_makechan. The buffer is a word a value, ChanCapMax of them
            at most: 512 MiB, under the heap's largest block. }
          if ConstFold(e, cv, cft, cfs) then
          begin
            if cv < 0 then
              Refuse('MakeChan takes a capacity of 0 or more' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
            if cv > ChanCapMax then
              Refuse('MakeChan takes a capacity of up to ' + IntToStr(ChanCapMax) + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          end;
        end;
        Eat(tkRParen);
        Result := NewMakeChan(InternChan(TyInteger));
        Result^.Typ := InternChan(TyInteger);
        Result^.L := e;
      end;
    tkInteger:
      begin
        { Integer(p): a pointer, class, map, chan or ordinal seen as a
          machine word. No code is generated. }
        FTok := FLex.Next;
        if FTok.Kind = tkDot then
        begin
          { Integer.Parse: a static method of Integer's helper (P127) }
          Result := ParsePostfix(TypeDot(TyInteger));
          Exit;
        end;
        Eat(tkLParen);
        e := ParseExpr;
        Eat(tkRParen);
        { Integer(p^) of an untyped Pointer: the 8 bytes at p (P102). }
        if (e^.Kind = ekDeref) and (e^.Typ = TyNone) then
        begin
          NotSafeAt('see memory as another type', ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          e^.L^.Typ := InternPtr(TyInteger);
          Result := NewDeref(e^.L, TyInteger);
          CheckReach(e^.L, 0, 8);
          Exit;
        end;
        { a record's class operator Explicit or Implicit (P171) }
        if (Length(FConvs) > 0) and ConvFor(e, TyInteger, True, Result) then
          Exit;
        st := TypeOf(e^.Typ);
        if not ((st.Kind = tykPointer) or (st.Kind = tykClass) or
          (st.Kind = tykMap) or (st.Kind = tykTree) or (st.Kind = tykHeap) or
          (st.Kind = tykStore) or (st.Kind = tykChan) or (st.Kind = tykInteger) or
          (st.Kind = tykBoolean) or (st.Kind = tykEnum) or
          (st.Kind = tykSubrange)) then
        begin
          if st.Kind = tykReal then
            Refuse('a real becomes Integer through Trunc or Round; x as Integer sees its bits' +
              HerePos);
          if st.Kind = tykCurrency then
            Refuse('a Currency becomes Integer through Trunc or Round; x as Integer sees its bits' +
              HerePos);
          if st.Kind = tykJson then
            Refuse('a json is no number: j.AsInteger reads one' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Refuse('Integer() takes a pointer or an ordinal' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
        end;
        if IsIntId(e^.Typ) then
          Result := ConvertInt(e, TyInteger)
        else
          Result := AsInt(e, TyInteger);
      end;
    tkBoolean:
      begin
        FTok := FLex.Next;
        if FTok.Kind = tkDot then
        begin
          Result := ParsePostfix(TypeDot(TyBoolean));
          Exit;
        end;
        Eat(tkLParen);
        e := ParseExpr;
        Eat(tkRParen);
        { a record's class operator Explicit or Implicit (P171) }
        if (Length(FConvs) > 0) and ConvFor(e, TyBoolean, True, Result) then
          Exit;
        Result := BoolOf(e);
      end;
    tkStringKw:
      begin
        { A bounded string/Char conversion shares StrArg's owned result;
          a bare pointer is not a string with a known extent. }
        FTok := FLex.Next;
        if FTok.Kind = tkDot then
          Result := ParsePostfix(TypeDot(TyString))
        else
        begin
          args := ParseArgList;
          if Length(args) <> 1 then Refuse('typecast takes 1 argument' + ' at ' + IntToStr(nline) + ':' + IntToStr(ncol));
          Result := ParsePostfix(AsStr(args[0]));
        end;
      end;
    tkRecv:
      begin
        FTok := FLex.Next;
        Eat(tkLParen);
        Result := NewRecv(ParseExpr);
        { A one-word element comes back as its type: Recv of a chan of
          Double was an Integer, its bits (1.0.75). }
        { Of the element's type, whatever it is: a wider one travels
          boxed (1.0.83). }
        if TypeOf(Result^.L^.Typ).Kind = tykChan then
          Result^.Typ := TypeOf(Result^.L^.Typ).Elem;
        Eat(tkRParen);
      end;
    tkIdent:
      begin
        name := FTok.Lexeme;
        nline := FTok.Line;
        ncol := FTok.Col;
        if (not IsVarName(name)) and (FLex.PeekDots <> '') and TypeAhead(id) then
        begin
          name := ReadTypePath;
          SkipTypeName;
        end
        else FTok := FLex.Next;
        { ua.Twice: a name of the unit ua, found through ua even when a
          later unit's name hides it (P138) }
        if (FTok.Kind = tkDot) and IsUsedUnit(name) and not IsVarName(name) then
        begin
          FTok := FLex.Next;
          if FTok.Lexeme = '' then
            Fail('a name of unit ' + name);
          name := ToLower(name) + '.' + FTok.Lexeme;
          FTok := FLex.Next;
        end;
        { a member of a with's record, the innermost's: a field, a method
          or a property of the record or of a helper for it (P165), or
          an object's member (P172); it hides any other name, a local's
          too, as in Pascal }
        wi := -1;
        if Length(FWith) > 0 then
          wi := WithIdx(name);
        if (wi >= 0) and (TypeOf(FWith[wi]^.Typ).Kind = tykClass) then
          { an object's member as obj.name is (P172), through the hidden
            variable that holds the reference }
          Result := DotMember(NewVar(FWith[wi]^.Name, FWith[wi]^.Typ), name, nline, ncol)
        else if wi >= 0 then
        begin
          i := RecFieldIdx(FWith[wi]^.Typ, name);
          if i >= 0 then
          begin
            CheckRecField(FWith[wi]^.Typ, i, nline, ncol);
            st := TypeOf(FWith[wi]^.Typ);
            Result := NewField(FWith[wi], st.Fields[i].Name, st.Fields[i].Typ, st.Fields[i].Off);
          end
          else if ScopedValue(FWith[wi]^.Typ, name, Result) then
          begin
          end
          else
            Result := HelperMember(FWith[wi], HelperFor(FWith[wi]^.Typ), name, nline, ncol);
        end
        { in a helper's method (P127), a member of the helper, or a field
          of the record it is for, is Self's, as a class's member is in
          a method of the class; a local or a parameter of the name
          comes first }
        else if (FHelperTyp <> 0) and (not IsLocalName(name)) and HelperHas(FHelperTyp, name) then
        begin
          if IsVarName('self') then
            Result := HelperMember(NewVar(VarSym('self'), TypeOf(FHelperTyp).Elem), FHelperTyp,
              name, nline, ncol)
          else
            Result := HelperMember(nil, FHelperTyp, name, nline, ncol);
        end
        else if (FHelperTyp <> 0) and (not IsLocalName(name)) and (TypeOf(FHelperTyp).Lo = 1) and
          IsVarName('self') and (RecFieldIdx(TypeOf(FHelperTyp).Elem, name) >= 0) then
        begin
          i := RecFieldIdx(TypeOf(FHelperTyp).Elem, name);
          CheckRecField(TypeOf(FHelperTyp).Elem, i, nline, ncol);
          st := TypeOf(TypeOf(FHelperTyp).Elem);
          Result := NewField(NewVar(VarSym('self'), TypeOf(FHelperTyp).Elem), st.Fields[i].Name,
            st.Fields[i].Typ, st.Fields[i].Off);
        end
        { Integer.Parse, TPoint.Make: a static method of the type's
          helper (P127) }
        else if (FTok.Kind = tkDot) and NamedType(name, id) and (TypeOf(id).Kind <> tykClass) and
          (not IsVarName(name)) then
          Result := TypeDot(id)
        else if SameId(name, 'SrcLine') then
        begin
          { the line where it is written, as the manual has it (P339): it
            read the pc's line table, which has its statement's line, the
            first of a statement that runs on to others }
          if FTok.Kind = tkLParen then
          begin
            FTok := FLex.Next;
            Eat(tkRParen);
          end;
          Result := NewInt(nline);
          Result^.Typ := TyInteger;
        end
        else if SameId(name, 'ParamCount') then
          Result := NewCall('rt_paramcount', nil, TyInteger)
        else if SameId(name, 'ErrOutput') then
          Result := NewVar('erroutput', TyInteger)
        else if SameId(name, 'Ord') then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Ord takes 1 argument' + MethAt(nline, ncol));
          if (args[0]^.Kind = ekStr) and (Length(args[0]^.Txt) = 1) then
            Result := NewInt(Ord(args[0]^.Txt[1]))   { Ord('A') is 65 }
          else if IsIntId(args[0]^.Typ) then
            Result := ConvertInt(args[0], TyInteger)
          else if TypeOf(args[0]^.Typ).Kind = tykReal then
            Refuse('Ord of a real: Trunc or Round says how' + PosOf(args[0]))
          else if TypeOf(args[0]^.Typ).Kind = tykCurrency then
            Refuse('Ord of a Currency: Trunc or Round says how' + HerePos)
          else
            Result := AsInt(args[0], TyInteger);
          { Ord of a constant is a constant with no type, as a literal
            is: b := Ord('X') needed a conversion to Byte (1.0.116). }
          if ConstFold(Result, cv, ftyp, buf) then
          begin
            Result := NewInt(cv);
            Result^.Flags := 1;
          end;
        end
        else if SameId(name, 'Length') then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Length takes 1 argument' + MethAt(nline, ncol));
          { of what has a length (1.0.136): Length(5) gave an address and
            Length(r) of a Real 1; a Char is a string of one }
          CheckTyped(args[0]);
          if IsCharT(args[0]^.Typ) then
            args[0] := StrArg(TyString, args[0]);
          k := TypeOf(args[0]^.Typ).Kind;
          if not (IsStrTyp(args[0]^.Typ) or IsDynTyp(args[0]^.Typ) or (k = tykArray) or
            (k = tykMap) or (k = tykTree) or (k = tykHeap) or (k = tykJson)) then
            Refuse('Length takes a string, an array, a slice or a map, not ' +
              TypName(args[0]^.Typ) + PosOf(args[0]));
          { the elements of a JSON array, the members of an object (P203) }
          if k = tykJson then
            Result := CoreProc('PasJsonLength', args, TyInteger)
          else
            Result := NewCall('rt_length', args, TyInteger);
        end
        else if SameId(name, 'Abs') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Abs takes 1 argument' + MethAt(nline, ncol));
          if TypeOf(args[0]^.Typ).Kind = tykCurrency then
            Result := CurrCall('PasCurrAbs', args[0], nil, TyCurrency)
          else if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_abs', args[0], nil, TyQuad)
          else if args[0]^.Typ = TySingle then
            Result := NewCall('rt_abssingle', args, TySingle)
          else if TypeOf(args[0]^.Typ).Kind = tykReal then
            Result := NewCall('rt_absreal', args, TyReal)
          else
            Result := NewCall('rt_absint', args, TyInteger);
        end
        else if SameId(name, 'Sqr') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Sqr takes 1 argument' + MethAt(nline, ncol));
          if TypeOf(args[0]^.Typ).Kind = tykCurrency then
            Result := CurrCall('PasCurrSqr', args[0], nil, TyCurrency)
          else if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_sqr', args[0], nil, TyQuad)
          else if args[0]^.Typ = TySingle then
            Result := NewCall('rt_sqrsingle', args, TySingle)
          else if TypeOf(args[0]^.Typ).Kind = tykReal then
            Result := NewCall('rt_sqrreal', args, TyReal)
          else
            Result := NewCall('rt_sqrint', args, TyInteger);
        end
        else if SameId(name, 'Trunc') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Trunc takes 1 argument' + MethAt(nline, ncol));
          { a record's class operator Trunc (P381) }
          if (Length(FUnOps) > 0) and UnOpFor('trunc', args[0], conv) then
            Result := conv
          else if TypeOf(args[0]^.Typ).Kind = tykCurrency then
            Result := CurrCall('PasCurrTrunc', args[0], nil, TyInteger)
          else if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_toint', args[0], NewInt(0), TyInteger)
          else
            Result := NewCall('rt_trunc', args, TyInteger);
        end
        else if SameId(name, 'Round') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Round takes 1 argument' + MethAt(nline, ncol));
          { a record's class operator Round (P381) }
          if (Length(FUnOps) > 0) and UnOpFor('round', args[0], conv) then
            Result := conv
          else if TypeOf(args[0]^.Typ).Kind = tykCurrency then
            Result := CurrCall('PasCurrRound', args[0], nil, TyInteger)
          else if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_toint', args[0], NewInt(1), TyInteger)
          else
            Result := NewCall('rt_round', args, TyInteger);
        end
        else if SameId(name, 'Sqrt') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Sqrt takes 1 argument' + MethAt(nline, ncol));
          if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_sqrt', args[0], nil, TyQuad)
          else if args[0]^.Typ = TySingle then
            Result := NewCall('rt_sqrtsingle', args, TySingle)
          else
            Result := NewCall('rt_sqrt', args, TyReal);
        end
        else if SameId(name, 'Sin') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Sin takes 1 argument' + MethAt(nline, ncol));
          Result := NewCall('rt_sin', args, TyReal);
        end
        else if SameId(name, 'Cos') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Cos takes 1 argument' + MethAt(nline, ncol));
          Result := NewCall('rt_cos', args, TyReal);
        end
        else if SameId(name, 'Ln') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Ln takes 1 argument' + MethAt(nline, ncol));
          Result := NewCall('rt_ln', args, TyReal);
        end
        else if SameId(name, 'Exp') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Exp takes 1 argument' + MethAt(nline, ncol));
          Result := NewCall('rt_exp', args, TyReal);
        end
        else if SameId(name, 'Frac') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Frac takes 1 argument' + MethAt(nline, ncol));
          if TypeOf(args[0]^.Typ).Kind = tykCurrency then
            Result := CurrCall('PasCurrFrac', args[0], nil, TyCurrency)
          else if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_frac', args[0], nil, TyQuad)
          else
            Result := NewCall('rt_fracpart', args, TyReal);
        end
        else if SameId(name, 'Int') and (FTok.Kind = tkLParen) then
        begin
          args := ParseArgList;
          if Length(args) <> 1 then
            Refuse('Int takes 1 argument' + MethAt(nline, ncol));
          if TypeOf(args[0]^.Typ).Kind = tykCurrency then
            Result := CurrCall('PasCurrInt', args[0], nil, TyCurrency)
          else if IsQuadTyp(args[0]^.Typ) then
            Result := QCall('rtq_int', args[0], nil, TyQuad)
          else
            Result := NewCall('rt_intpart', args, TyReal);
