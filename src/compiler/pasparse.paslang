            args[2] := NewInt(4);
            Result := NewCall('rt_treebound', args, TypeOf(args[0]^.Typ).Elem);
          end
          else if Length(args) <> 1 then
            Refuse('Floor takes 1 argument')
          else if TypeOf(args[0]^.Typ).Kind = tykCurrency then
            Result := CurrCall('PasCurrFloor', args[0], nil, TyInteger)
