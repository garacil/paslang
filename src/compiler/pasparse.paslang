            High(Byte) is 255, Low(Int8) -128, High(Char) #255, and an
            enumeration's, a subrange's and a static array's bounds; of a
            value, what they were. }
          FTok := FLex.Next;
          have := False;
          if FTok.Kind = tkInteger then
          begin
            id := TyInteger;
            have := True;
          end
          else if FTok.Kind = tkBoolean then
          begin
            id := TyBoolean;
            have := True;
          end
          else if IsName and (not IsVarName(FTok.Lexeme)) and
            (not FindConst(FTok.Lexeme, cv)) and TypeAhead(id) then
            have := True;
          if have then
          begin
            { T, or ua.T (P158) }
            if FTok.Kind = tkIdent then
              SkipTypeName
            else
              FTok := FLex.Next;
            Eat(tkRParen);
            Result := TypeBound(id, SameId(name, 'High'));
