    procedure AddProcEnt(const AName, ASym: string; IsFunc: Boolean; NParams, RetTyp: LongInt);
    procedure ApplyParams(const AName: string; const Params: TParamArray);
    procedure FillDefaults(const P: TProcEnt; var Args: TExprArray);
