            the heap. For tests (P95a). }
          if FTok.Kind = tkLParen then
          begin
            FTok := FLex.Next;
            Eat(tkRParen);
          end;
          Result := NewCall('rt_heapcheck', nil, TyInteger);
        end
        else if SameId(name, 'GcCollect') and (not IsVarName(name)) then
        begin
