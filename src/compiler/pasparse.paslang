            end
            else
              Result := NewInt(TypeOf(id).Size);
          end
          else
          begin
            e := ParseExpr;
            Result := NewInt(TypeOf(e^.Typ).Size);
          end;
          Eat(tkRParen);
        end
        else if SameId(name, 'Default') then
        begin
          { any type (1.0.136): Default(Integer), Default(string) and
