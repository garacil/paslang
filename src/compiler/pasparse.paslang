unit pasparse;

interface

uses
  paslex, pasast;

var
  DebugMode: Boolean;   { -debug (P118): a program gets uses pasdebug, the debugger inside it }

function ParseSource(const Src: string; const UPath: array of string;
  Arm: Boolean; CpuSet: Int64; CpuTune: LongInt): TProgram;

implementation

uses
  paslib, pasiface, pasfmt, pasquad, pashelp, pasjson;


type
  TConstEnt = record
    Name: string;
    Value: Int64;   { the integer, the code of a Char, 0/1, or the bits of a real }
    Typ: LongInt;   { TyInteger, an enum, TyReal, TyString, TyChar or TyBoolean }
    Txt: string;    { the text of a string constant }
    QLo, QHi: Int64;  { a real one worked out in binary128 too (P103, 1.0.115) }
    HasQ: Boolean;
    Owner: string;  { the unit it comes from (P138) }
    Nest: LongInt;  { the depth of the routine that declares it, 0 at the top (P159) }
    Prev: LongInt;  { the entry before of the same name, -1 none (P376) }
  end;

  TOpEnt = record
    Op: TBinOp;
    LTyp, RTyp, Ret: LongInt;
    Sym: string;
    Own: Boolean;  { declared in this program or unit, not a used unit's (P157) }
  end;

  { An operator of one operand (P381): OpW neg, pos, not, inc, dec,
    trunc or round on a Typ, giving a Ret, done by Sym. }
  TUnOpEnt = record
    OpW: string;
    Typ, Ret: LongInt;
    Sym: string;
    Own: Boolean;
  end;

  { A record's class operator Implicit or Explicit (P171): a value of
    FromTyp made a ToTyp by Sym. }
  TConvEnt = record
    FromTyp, ToTyp: LongInt;
    Sym: string;
    Explicit: Boolean;
    Own: Boolean;
  end;

  TProcEnt = record
    Name: string;
    Sym: string;
    IsFunc: Boolean;
    NParams: LongInt;
    RetTyp: LongInt;
    ParamTyp: array of LongInt;
    ByRef: array of Boolean;
    HasDef: array of Boolean;
    Def: array of Int64;
    DefStr: array of string;
    Nest: LongInt;     { a nested routine's depth: 0 at the top (1.0.133) }
    Owner: string;     { the unit it comes from, '' for the one being compiled (P138) }
    IsOver: Boolean;   { declared overload: the routines of its name around it stay visible (P160) }
    Prev: LongInt;     { the entry before of the same name, -1 none (P376) }
  end;

  { P376: a table's names, each the index of its last entry, by the
    name's spelling in any case as SameId compares; open addressing, at
    least twice as many slots as names. }
  TNameHead = record
    Keys: TStrArray;
    Vals: array of LongInt;
    Used: SizeInt;
  end;

  TTypeName = record
    Name: string;
    Id: LongInt;
    Owner: string;     { the unit it comes from (P138) }
    Nest: LongInt;     { the depth of the routine that names it, 0 at the top (P159) }
  end;

  TParser = class
  private
    FSafe: Boolean;         { the code being read is safe: no raw pointer work (P102) }
    FSafeAll: Boolean;      { the unit or program was declared safe }
    FNextSafe: Boolean;     { safe was read before the routine that follows }
    FAnonHead: Boolean;     { the next routine head has no name (1.0.134) }
    FAnonBody: Boolean;     { the next routine body ends without a semicolon }
    FAnonN: LongInt;
    FCellN: LongInt;
    FExcDepth: LongInt;    { except parts being read around the statement (P122): raise; raises their object again }
    FClassCtors: TStrArray; { the class constructors and destructors declared here (P123), run when the unit starts and ends }
    FClassDtors: TStrArray;
    FNextClassMeth: Boolean; { class was read before the routine head that follows (P123) }
    FSelfClassRef: Boolean;  { the body read is a class method's: Self is the class, no object (P123) }
    FNoSelf: Boolean;        { the body read is a static class method's: no Self at all (P123) }
    FCPropSets: array of PExpr;   { class properties read (P123): the node, and its static setter, for an assignment }
    FParamType: Boolean;     { a parameter's type is read: array of const may be it (P124) }
    FGroupAt: string;        { the first name of the parameters being read, for a refusal of them (P340) }
    FSubAt: string;          { where the subrange being made starts, for its refusals (P340) }
    FMemberAt: string;       { where the member being called is named, for its refusals (P340) }
    FElemAt: string;         { the element of a list being joined, for its refusal (P340) }
    FModAt: string;          { where StmtMod or ExprMod found the change, '' before (P340) }
    FPropAt: string;         { where the property being read is named (P340) }
    FCallAt: string;         { where the routine ResolveProc is to resolve is named, set just before (P340) }
    FBuiltinAt: string;      { the primary or statement being read, its first token: a builtin's name (P340) }
    FPrimLine, FPrimCol: LongInt;  { the first token of the primary being read (P340) }
    FNoEq: Boolean;          { a subrange's bound is read: = is the declaration's, not a comparison (P126) }
    FCPropSetSyms: TStrArray;
    FSymChain: TStrArray;  { the routines being parsed, outermost first }
    FBoxing: TStrArray;    { the routines that hold a closure inside }
    FEscapedWith: TStrArray; { Owner/name: pointer bindings a with's closures pin (P166) }
    FSafeNames: TStrArray;  { routines a header declared safe, for their bodies }
    FLex: TLexer;
    FTok: TToken;
    FConsts: array of TConstEnt;
    FVars: TVarDeclArray;
    FLocals: TVarDeclArray;
    FLimits: TVarDeclArray;   { the hidden for limits of the body being read (1.0.93) }
    FLimitN: LongInt;
    FBlockOpen: LongInt;      { block logic nodes of the statement being read that no assignment took yet (1.0.120) }
    FInBody: Boolean;         { reading a routine's body, not the program's or a unit's block }
    FConstNames: TStrArray;   { the const parameters of the routines being read, outermost first (1.1.1) }
    FHelpers: array of LongInt;  { the helpers in scope, in the order declared or loaded (P127) }
    FCoreHelpers: LongInt;  { how many of them, at the front, a core unit brought (P204) }
    FInVariant: Boolean;  { the fields of a variant part are parsed: json ignore alone (P205) }
    FGenMode: Boolean;    { the text the compiler writes is parsed (P205) }
    FJsonText: array of LongInt;  { the types JsonEncode and JsonOf take (P205) }
    FJsonEnc: array of LongInt;   { the types with an encoder }
    FJsonEncAt: TStrArray;        { where each was first asked for, for its refusals (P340) }
    FJsonZero: array of LongInt;  { the types with a zero test for omitzero }
    FJsonAt: string;              { where the first JsonEncode of a typed value is }
    FJsonDec: array of LongInt;   { the types with a decoder (P206) }
    FJsonDecAt: TStrArray;        { where each was first asked for (P340) }
    FJsonNameAts: TStrArray;      { JsonNamesOf's places, beside the names (P340) }
    FJsonChk: array of LongInt;   { the types with a check, for Merge }
    FJsonNames: array of LongInt; { the enumerations whose names a decoder reads }
    FJsonDEnt: array of LongInt;  { the types JsonDecode, TryJsonDecode, a typed for and TryGet take }
    FJsonDForm: array of LongInt; { the entries of each a unit calls, Jd* }
    FJsonCSyms: TStrArray;        { the json constants' variables (P209) }
    FJsonCTexts: TStrArray;       { and their texts, each parsed once in the initialization }
    FJsonWrite: array of LongInt; { the types a typed JsonWrite takes (P208) }
    FRecMembers: Boolean;  { a record's fields stop where its members begin (P165) }
    FRecVis: Byte;         { the visibility of the record's fields being read (P165) }
    FRecSelf: LongInt;     { the record being declared, which no field of it may be (P165) }
    FMemberScope: LongInt;  { named type whose declarations or method head are being read (P169) }
    FMemberVis: Byte;
    FHelperTyp: LongInt;      { the helper whose method is being read (P127), 0 outside one }
    FConstScope, FTypeScope, FProcScope: SizeInt;  { where the routine being read begins its constants, type names and nested routines in the tables (P137) }
    FScopeTypes: TStrArray;   { the type names the routine being read declares (P137) }
    FVarInits: array of PStmt;  { the routine being read's variables with a value, set as it starts (P144) }
    FImporting: LongInt;      { LoadUnit is bringing a unit's names in: they are not the program's own (P158) }
    FDeclAt: string;          { ' at L:C' of the name being declared, where a duplicate is told (P151) }
    FFwdTypes: array of LongInt;  { the classes and interfaces declared forward and not whole yet (P139) }
    FFwdAt: TStrArray;        { where each of them was declared forward }
    FFwdScope: SizeInt;       { where the routine being read begins its forward types (P139) }
    FModNoAddr: Boolean;      { ExprMod: an address taken is not a change (the const check, 1.1.1) }
    FProcs: array of TProcEnt;
    FOps: array of TOpEnt;
    FConvs: array of TConvEnt;
    FUnOps: array of TUnOpEnt;
    FTypes: TTypeDefArray;
    FTypeNames: array of TTypeName;
    FFuncName: string;
    FFuncSym: string;
    FIsFunc: Boolean;
    FParamN: SizeInt;   { how many locals are self, result and params }
    FRetTyp: LongInt;
    FNest: LongInt;
    FScopes: array of TVarDeclArray;
    FScopeLevels: array of LongInt;  { the depth of each routine's variables in FScopes (P159) }
    FConstBase, FTypeBase, FProcBase: SizeInt;  { where the outermost routine being read begins its names in the tables (P159) }
    FClassTyp: LongInt;
    FWith: array of PExpr;
    FMethodSyms, FMethodNames, FMethodAt: TStrArray; { concrete own declarations, not imported/inherited (P167) }
    FUnitName: string;
    FIsUnit: Boolean;
    FInImpl: Boolean;
    FNameCheck: Boolean;  { declarations of the source refuse the reserved names (1.0.131) }
    FReserved: TStrArray;   { the predefined names, lowercase and sorted (1.0.138) }
    FCoreNames: TStrArray;  { what the core units export: reserved outside them (1.0.138) }
    FConstHead, FProcHead, FCoreHead: TNameHead;  { P376: the last constant, routine and core name of each name }
    FUPath: TStrArray;
    FLoaded: TStrArray;
    FLoadedSum: TStrArray;
    FLinkOnly: TStrArray;   { units loaded to be linked, their names not read (1.0.114) }  { the interface checksum of each loaded unit }
    FLoading: TStrArray;
    FLinkObjs: TStrArray;
    FUsesNames: TStrArray;
    FCoreMap: Boolean;
    FCoreTree: Boolean;
    FStoreTyp: LongInt;
    FJsonTyp: LongInt;      { json (P203), made the first time it is named }
    FArm: Boolean;
    FPendingPtr: TStrArray;
    FPendingId: array of LongInt;
    FPendingAt: TStrArray;
    FInTypes: Boolean;
    FConstAt: string;
    FConstQLo, FConstQHi: Int64;   { ParseConstValue's real constant in binary128 (1.0.115) }
    FConstHasQ: Boolean;
    FImportMap: array of LongInt;
    FTypeOrig: TStrArray;    { for a type a .pi brought in, the unit it was made in and its id there (P460) }
    FOrigHead: TNameHead;    { from those to the type: one that comes again by another .pi is the one loaded }
    FProg: TProgram;
    procedure Eat(K: TTokKind);
    function IsName: Boolean;
    function TypeWord: Boolean;
    function SameId(const A, B: string): Boolean;
    function FindConst(const AName: string; out V: Int64): Boolean;
    function IsVarName(const AName: string): Boolean;
    function VarTyp(const AName: string): LongInt;
    function VarSym(const AName: string): string;
    function FindProc(const AName: string; out P: TProcEnt): Boolean;
    function SameProc(const AName: string; const Params: TParamArray): Boolean;
    function ResolveProc(const AName: string; const Args: TExprArray;
      out P: TProcEnt): Boolean;
    function SigEq(const A, B: TParamArray): Boolean;
    function ListedProc(const Pr: TProc): Boolean;
    function OwnMeth(const Sym, Base: string): Boolean;
    function PickMethAt(const Meths: TMethArray; const AName: string;
      var Args: TExprArray; HaveArgs: Boolean; out Idx: SizeInt; ALine, ACol: LongInt): Boolean;
    function PickMeth(const Meths: TMethArray; const AName: string;
      var Args: TExprArray; HaveArgs: Boolean; out Idx: SizeInt): Boolean;
    function StrArg(Want: LongInt; E: PExpr): PExpr;
    function VarArgFits(P, A: LongInt): Boolean;
