  Line('  cbnz w9, .lk_slow');
  Line('  stxr w10, w8, [x0]');
  Line('  cbnz w10, .lk_spin');
  Line('  b .lk_ok');
  Line('.lk_slow:');
  Line('  clrex');
  Line('  stp x1, x2, [sp, #-32]!');
  Line('  str x3, [sp, #16]');
  Line('  mov w11, w9');
