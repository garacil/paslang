  Line('  mov x20, x0');
  Line('  mov x0, x2');
  Line('  bl rt_ready');
  Line('  mov x0, x20');
  Line('.acr_bret:');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.acr_q:');
  Line('  add x0, x19, #32');
  Line('  bl rt_cqtake');
  Line('  cbz x0, .acr_empty');
  Line('  ldr x20, [x0, #16]');
  Line('  ldr x0, [x0, #8]');
  Line('  stlr wzr, [x19]');
  Line('  bl rt_ready');
  Line('  mov x0, x20');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.acr_empty:');
  Line('  ldr x9, [x19, #8]');
  Line('  cbz x9, .acr_park');
  Line('  stlr wzr, [x19]');
  Line('  mov x0, xzr');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.acr_park:');
  Line('  sub sp, sp, #48');
  Line('  str x28, [sp, #8]');
  Line('  str xzr, [sp, #16]');
  Line('  str xzr, [sp, #24]');
  Line('  mov w9, #1');
  Line('  str w9, [x28, #152]');
  Line('  add x0, x19, #16');
  Line('  mov x1, sp');
  Line('  bl rt_cqenq');
  Line('  stlr wzr, [x19]');
  Line('  bl rt_parkmarked');
  Line('  ldr x0, [sp, #16]');
  Line('  add sp, sp, #48');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('rt_chanclose:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('.acc_lock:');
  Line('  ldaxr w9, [x19]');
  Line('  cbnz w9, .acc_lock');
  Line('  mov w10, #1');
  Line('  stxr w11, w10, [x19]');
  Line('  cbnz w11, .acc_lock');
  Line('  ldr x9, [x19, #8]');
  Line('  cbnz x9, .acc_closed');
  Line('  mov x9, #1');
  Line('  str x9, [x19, #8]');
  Line('.acc_r:');
  Line('  add x0, x19, #16');
  Line('  bl rt_cqtake');
  Line('  cbz x0, .acc_s');
  Line('  str xzr, [x0, #16]');
  Line('  ldr x0, [x0, #8]');
  Line('  bl rt_ready');
  Line('  b .acc_r');
  Line('.acc_s:');
  Line('  add x0, x19, #32');
  Line('  bl rt_cqtake');
  Line('  cbnz x0, .acc_die');
  Line('  stlr wzr, [x19]');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
