  Line('  mov x2, #1');
  Line('  bl rt_rawwrite');
  Line('  neg x0, x23');
  Line('.afi_pos:');
  Line('  mov x1, #10');
  Line('  bl rt_fatalnum');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
