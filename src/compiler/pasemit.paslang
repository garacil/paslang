  LeaS('p_pasheap_pasheapgrowlarge', 'x17');
  Line('  bl rt_gocallm');
  Line('  cbz x0, .asgx_ret');
  Line('  ldr x9, [sp, #24]');
  Line('  lsl w11, w11, #1');
  Line('  sturb w11, [x9, #-1]');
  Line('.asgx_ret:');
  Line('  mov x9, x0');
  Line('  ldp x2, x30, [sp], #16');
  Line('  ldp x0, x1, [sp], #16');
  Line('  ret');
