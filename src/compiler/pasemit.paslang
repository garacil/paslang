  Line('  jae .sx_od');
  Line('  movq %r8, %rax');
  Line('  shlq $5, %rax');
  Line('  addq %rbx, %rax');
  Line('  cmpq $2, (%rax)');
  Line('  je .sx_o2');
  Line('  movq 8(%rax), %rdx');
  Line('  movq %r15, %rcx');
  Line('.sx_o3:');
  Line('  testq %rcx, %rcx');
  Line('  jz .sx_o4');
  Line('  movq 8(%r13, %rcx, 8), %r9');
  Line('  movq %r9, %rax');
  Line('  shlq $5, %rax');
  Line('  addq %rbx, %rax');
  Line('  movq 8(%rax), %rax');
  Line('  cmpq %rdx, %rax');
  Line('  jbe .sx_o4');
  Line('  movq %r9, 16(%r13, %rcx, 8)');
  Line('  decq %rcx');
  Line('  jmp .sx_o3');
  Line('.sx_o4:');
  Line('  movq %r8, 16(%r13, %rcx, 8)');
  Line('  incq %r15');
  Line('.sx_o2:');
  Line('  incq %r8');
  Line('  jmp .sx_o1');
  Line('.sx_od:');
  Line('  testq %r15, %r15');
  Line('  jz .sx_forever');
  Line('.sx_again:');
  Line('  call .sx_lockall');
  Line('  xorq %r12, %r12');
  Line('.sx_p1:');
  Line('  cmpq %r15, %r12');
  Line('  jae .sx_enq');
  Line('  movq 16(%r13, %r12, 8), %rax');
  Line('  shlq $5, %rax');
  Line('  addq %rbx, %rax');
  Line('  movq 8(%rax), %rdi');
  Line('  cmpq $0, (%rax)');
  Line('  jne .sx_pr');
  Line('  cmpq $0, 8(%rdi)');
  Line('  jne .sx_closed');
  Line('  addq $16, %rdi');
  Line('  call rt_cqtake');
  Line('  testq %rax, %rax');
  Line('  jz .sx_pb');
  Line('  movq 16(%r13, %r12, 8), %rcx');
  Line('  shlq $5, %rcx');
  Line('  addq %rbx, %rcx');
  Line('  movq 16(%rcx), %rdx');
  Line('  movq %rdx, 16(%rax)');
  Line('  movq 8(%rax), %rdx');
  Line('  movq %rdx, (%r13)');
  Line('  jmp .sx_won');
  { A send arm with no receiver waiting: the buffer, if it has room
    (1.0.85). }
  Line('.sx_pb:');
  Line('  movq 16(%r13, %r12, 8), %rcx');
  Line('  shlq $5, %rcx');
  Line('  addq %rbx, %rcx');
  Line('  movq 8(%rcx), %rdi');
  Line('  movq 16(%rcx), %rsi');
  Line('  call rt_chbput');
  Line('  testq %rax, %rax');
  Line('  jz .sx_pn');
  Line('  movq $0, (%r13)');
  Line('  jmp .sx_won');
  { A receive arm: the buffer first. }
  Line('.sx_pr:');
  Line('  pushq %rdi');
  Line('  call rt_chbget');
  Line('  popq %rdi');
  Line('  testq %rdx, %rdx');
  Line('  jz .sx_prq');
  Line('  movq 16(%r13, %r12, 8), %rsi');
  Line('  shlq $5, %rsi');
  Line('  addq %rbx, %rsi');
  Line('  movq 16(%rsi), %rsi');
  Line('  movq %rax, (%rsi)');
  Line('  movq %rcx, (%r13)');
  Line('  jmp .sx_won');
  Line('.sx_prq:');
  Line('  addq $32, %rdi');
  Line('  call rt_cqtake');
  Line('  testq %rax, %rax');
  Line('  jz .sx_pc');
  Line('  movq 16(%rax), %rdx');
  Line('  movq 16(%r13, %r12, 8), %rcx');
  Line('  shlq $5, %rcx');
  Line('  addq %rbx, %rcx');
  Line('  movq 16(%rcx), %rcx');
  Line('  movq %rdx, (%rcx)');
  Line('  movq 8(%rax), %rdx');
  Line('  movq %rdx, (%r13)');
  Line('  jmp .sx_won');
  Line('.sx_pc:');
  Line('  subq $32, %rdi');
  Line('  cmpq $0, 8(%rdi)');
  Line('  je .sx_pn');
  Line('  movq 16(%r13, %r12, 8), %rcx');
  Line('  shlq $5, %rcx');
  Line('  addq %rbx, %rcx');
  Line('  movq 16(%rcx), %rcx');
  Line('  movq $0, (%rcx)');
  Line('  movq $0, (%r13)');
  Line('  jmp .sx_won');
  Line('.sx_pn:');
  Line('  incq %r12');
  Line('  jmp .sx_p1');
  Line('.sx_won:');
  Line('  call .sx_unlockall');
  Line('  movq (%r13), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .sx_wn');
  Line('  call rt_ready');
  Line('.sx_wn:');
  Line('  movq 16(%r13, %r12, 8), %rax');
  Line('  jmp .sx_ret');
  Line('.sx_enq:');
  Line('  movq $0, (%r13)');
  Line('  movq $0, 8(%r13)');
  Line('  movl $1, 152(%r14)');
  Line('  xorq %r12, %r12');
  Line('.sx_e1:');
  Line('  cmpq %r15, %r12');
  Line('  jae .sx_park');
  Line('  leaq (%r12,%r12,2), %rax');
  Line('  shlq $4, %rax');
  Line('  leaq 144(%r13, %rax), %rsi');
  Line('  movq %r14, 8(%rsi)');
  Line('  movq %r13, 24(%rsi)');
  Line('  movq 16(%r13, %r12, 8), %rcx');
  Line('  movq %rcx, 32(%rsi)');
  Line('  shlq $5, %rcx');
  Line('  addq %rbx, %rcx');
  Line('  movq 16(%rcx), %rdx');
  Line('  movq %rdx, 16(%rsi)');
  Line('  movq 8(%rcx), %rdi');
  Line('  cmpq $0, (%rcx)');
  Line('  jne .sx_er');
  Line('  addq $32, %rdi');
  Line('  jmp .sx_eq');
  Line('.sx_er:');
  Line('  addq $16, %rdi');
  Line('.sx_eq:');
  Line('  call rt_cqenq');
  Line('  incq %r12');
  Line('  jmp .sx_e1');
  Line('.sx_park:');
  Line('  call .sx_unlockall');
  Line('  call rt_parkmarked');
  Line('  call .sx_lockall');
  Line('  xorq %r12, %r12');
  Line('.sx_r1:');
  Line('  cmpq %r15, %r12');
  Line('  jae .sx_rd');
  Line('  leaq (%r12,%r12,2), %rax');
  Line('  shlq $4, %rax');
  Line('  leaq 144(%r13, %rax), %rsi');
  Line('  movq 32(%rsi), %rcx');
  Line('  shlq $5, %rcx');
  Line('  addq %rbx, %rcx');
  Line('  movq 8(%rcx), %rdi');
  Line('  cmpq $0, (%rcx)');
  Line('  jne .sx_rr');
  Line('  addq $32, %rdi');
  Line('  jmp .sx_rq');
  Line('.sx_rr:');
  Line('  addq $16, %rdi');
  Line('.sx_rq:');
  Line('  call rt_cqremove');
  Line('  incq %r12');
  Line('  jmp .sx_r1');
  Line('.sx_rd:');
  Line('  call .sx_unlockall');
  Line('  cmpq $0, (%r13)');
  Line('  je .sx_again');
  Line('  movq 8(%r13), %rsi');
  Line('  movq 32(%rsi), %rax');
  Line('  movq %rax, %rcx');
  Line('  shlq $5, %rcx');
  Line('  addq %rbx, %rcx');
  Line('  cmpq $1, (%rcx)');
  Line('  jne .sx_ret');
  Line('  movq 16(%rcx), %rdx');
  Line('  movq 16(%rsi), %rcx');
  Line('  movq %rcx, (%rdx)');
  Line('  jmp .sx_ret');
  Line('.sx_forever:');
  Line('  call rt_park');
  Line('  jmp .sx_forever');
  Line('.sx_lockall:');
  Line('  xorq %rcx, %rcx');
  Line('  xorq %r8, %r8');
  Line('.sx_l1:');
  Line('  cmpq %r15, %rcx');
  Line('  jae .sx_l2');
  Line('  movq 16(%r13, %rcx, 8), %rax');
  Line('  shlq $5, %rax');
  Line('  addq %rbx, %rax');
  Line('  movq 8(%rax), %rdi');
  Line('  cmpq %r8, %rdi');
  Line('  je .sx_l3');
  Line('  movq %rdi, %r8');
  Line('.sx_l4:');
  Line('  movl $1, %eax');
  Line('  xchgl %eax, (%rdi)');
  Line('  testl %eax, %eax');
  Line('  jz .sx_l3');
  Line('  pause');
  Line('  jmp .sx_l4');
  Line('.sx_l3:');
  Line('  incq %rcx');
  Line('  jmp .sx_l1');
  Line('.sx_l2:');
  Line('  ret');
  Line('.sx_unlockall:');
  Line('  xorq %rcx, %rcx');
  Line('  xorq %r8, %r8');
  Line('.sx_u1:');
  Line('  cmpq %r15, %rcx');
  Line('  jae .sx_u2');
  Line('  movq 16(%r13, %rcx, 8), %rax');
  Line('  shlq $5, %rax');
  Line('  addq %rbx, %rax');
  Line('  movq 8(%rax), %rdi');
  Line('  cmpq %r8, %rdi');
  Line('  je .sx_u3');
  Line('  movq %rdi, %r8');
  Line('  movl $0, (%rdi)');
  Line('.sx_u3:');
  Line('  incq %rcx');
  Line('  jmp .sx_u1');
  Line('.sx_u2:');
  Line('  ret');
  Line('');
end;

procedure TEmitter.EmitRuntime;
begin
  Line('');
  Line('.globl rt_morestack');
  { A stack may reach 1 GiB, as in Go; stacks are counted in
    rt_stacktot with a 64 GiB ceiling of their own (P92). }
  Line('rt_mmap:');
  Line('  cmpq $1073741824, %rdi');
  Line('  ja rt_dietoobig');
  Line('  movq rt_stacktot(%rip), %rax');
  Line('  addq %rdi, %rax');
  Line('  movabs $68719476736, %rcx');
  Line('  cmpq %rcx, %rax');
  Line('  ja rt_dieoomstk');
  Line('  movq %rdi, %rsi');
  Line('  xorq %rdi, %rdi');
  Line('  movq $3, %rdx');
  Line('  movq $0x4022, %r10');
  Line('  movq $-1, %r8');
  Line('  xorq %r9, %r9');
  Line('  movq $9, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  js rt_diemmap');
  Line('  lock addq %rsi, rt_stacktot(%rip)');
  Line('  ret');
  Line('');
  Line('rt_guard:');
  Line('  movq $4096, %rsi');
  Line('  movq $102, %rdx');
  Line('  movq $28, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  jnz rt_guardfail');
  Line('  ret');
  Line('');
  Line('rt_guardfail:');
  Line('  leaq .Lguarderr(%rip), %rsi');
  Line('  movq $35, %rdx');
  Line('  call rt_rawwrite');
  Line('  movq $2, %rdi');
  Line('  jmp rt_exit');
  Line('rt_gconstack:');
  Line('  leaq .Lgconstack(%rip), %rsi');
  Line('  movq $51, %rdx');
  Line('  call rt_rawwrite');
  Line('  movq $2, %rdi');
  Line('  jmp rt_exit');
  Line('');
  { P86: a fatal runtime error says why. Everything here writes to
    standard error with raw system calls, never through rt_write, which
    may park: a fatal path runs inside a signal handler on the alternate
    stack, or on a routine that holds a lock. rt_diemsg takes the text in
    rsi and rdx and a pc in rdi (0 when there is none), prints " at line
    N" when the pc is inside the program, and exits 1 as every runtime
    error does. rt_fatalnum prints rdi in the base rsi.
    rt_rawwrite writes rsi, rdx bytes to descriptor 2, all of them: a
    short write goes on with the rest and EINTR makes the call again.
    EAGAIN is a standard error the program found nonblocking (P217) and
    full: it waits in poll for POLLOUT with no time limit, as a blocking
    descriptor waits in its write (docs/ref/linux/poll.2: a negative
    timeout is infinite), where the loop spun on the CPU. Any other
    answer gives up, as Go's writeErrData ignores the answer of its one
    write (src/runtime/runtime.go). rax, rcx, rdx, rsi, rdi and r11 are
    clobbered (SYSCALL sets RCX and R11, Intel SDM vol. 2B); 24 bytes
    of stack. }
  Line('rt_rawwrite:');
  Line('  testq %rdx, %rdx');
  Line('  jle .rw_done');
  Line('  movq $2, %rdi');
  Line('  movq $1, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  jg .rw_more');
  Line('  cmpq $-4, %rax');
  Line('  je rt_rawwrite');
  Line('  cmpq $-11, %rax');
  Line('  jne .rw_done');
  { struct pollfd: int fd, short events (POLLOUT 4), short revents }
  Line('  pushq %rsi');
  Line('  pushq %rdx');
  Line('  subq $8, %rsp');
  Line('  movl $2, (%rsp)');
  Line('  movl $4, 4(%rsp)');
  Line('  movq %rsp, %rdi');
  Line('  movq $1, %rsi');
  Line('  movq $-1, %rdx');
  Line('  movq $7, %rax');
  Line('  syscall');
  Line('  addq $8, %rsp');
  Line('  popq %rdx');
  Line('  popq %rsi');
  Line('  testq %rax, %rax');
  Line('  jns rt_rawwrite');
  Line('  cmpq $-4, %rax');
  Line('  je rt_rawwrite');
  Line('  ret');
  Line('.rw_more:');
  Line('  addq %rax, %rsi');
  Line('  subq %rax, %rdx');
  Line('  jmp rt_rawwrite');
  Line('.rw_done:');
  Line('  ret');
  Line('rt_fatalnum:');
  Line('  pushq %rbp');
  Line('  movq %rsp, %rbp');
  Line('  subq $32, %rsp');
  Line('  leaq -1(%rbp), %r8');
  Line('  movq %rdi, %rax');
  Line('  movq %rsi, %rcx');
  Line('  leaq .Lhexdig(%rip), %r9');
  Line('.fn_loop:');
  Line('  xorq %rdx, %rdx');
  Line('  divq %rcx');
  Line('  movb (%r9,%rdx), %dl');
  Line('  decq %r8');
  Line('  movb %dl, (%r8)');
  Line('  testq %rax, %rax');
  Line('  jne .fn_loop');
  Line('  leaq -1(%rbp), %rdx');
  Line('  subq %r8, %rdx');
  Line('  movq %r8, %rsi');
  Line('  call rt_rawwrite');
  Line('  leave');
  Line('  ret');
  { The line of pc rdi: the entry with the greatest address not above
    it. The table is in the order the code was written, which since the
    routines sit in sections of their own (1.1.1) is not the order of
    the addresses: the whole table is read. }
  Line('rt_pcline:');
  Line('  leaq rt_linetab(%rip), %rsi');
  Line('  xorq %rcx, %rcx');
  Line('  xorq %rdx, %rdx');
  Line('.pl_scan:');
  Line('  movq (%rsi), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .pl_done');
  Line('  cmpq %rdi, %rax');
  Line('  ja .pl_next');
  Line('  cmpq %rdx, %rax');
  Line('  jb .pl_next');
  Line('  movq %rax, %rdx');
  Line('  movq 8(%rsi), %rcx');
  Line('.pl_next:');
  Line('  addq $16, %rsi');
  Line('  jmp .pl_scan');
  Line('.pl_done:');
  Line('  movq %rcx, %rax');
  Line('  ret');
  { No line for the pc (the runtime, or a unit): print the pc itself in
    hex, as Go's signal report does, so a fault can still be placed. }
  Line('rt_fatalline:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  call rt_pcline');
  Line('  testq %rax, %rax');
  Line('  jnz .fl_line');
  Line('  testq %rbx, %rbx');
  Line('  jz .fl_none');
  Line('  leaq .Latpc(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgAtPc)) + ', %rdx');
  Line('  call rt_rawwrite');
  Line('  movq %rbx, %rdi');
  Line('  movq $16, %rsi');
  Line('  call rt_fatalnum');
  Line('  jmp .fl_none');
  Line('.fl_line:');
  Line('  movq %rax, %rbx');
  Line('  leaq .Latline(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgAtLine)) + ', %rdx');
  Line('  call rt_rawwrite');
  Line('  movq %rbx, %rdi');
  Line('  movq $10, %rsi');
  Line('  call rt_fatalnum');
  Line('.fl_none:');
  Line('  popq %rbx');
  Line('  ret');
  Line('rt_diemsg:');
  Line('  pushq %rdi');
  Line('  call rt_rawwrite');
  Line('  popq %rdi');
  Line('  call rt_fatalline');
  Line('rt_dieend:');
  Line('  leaq .Lnl(%rip), %rsi');
  Line('  movq $1, %rdx');
  Line('  call rt_rawwrite');
  Line('  movq $1, %rdi');
  Line('  jmp rt_exit');
  Line('rt_dieoomstk:');
  Line('  leaq .Loomstk(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgOomStack)) + ', %rdx');
  Line('  call rt_rawwrite');
  Line('  movq rt_stacktot(%rip), %rdi');
  Line('  shrq $20, %rdi');
  Line('  movq $10, %rsi');
  Line('  call rt_fatalnum');
  Line('  leaq .Lmib(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgMib)) + ', %rdx');
  Line('  call rt_rawwrite');
  Line('  jmp rt_dieend');
  Line('rt_dieoom:');
  Line('  leaq .Loom(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgOom)) + ', %rdx');
  Line('  call rt_rawwrite');
  Line('  movq rt_maptot(%rip), %rdi');
  Line('  shrq $20, %rdi');
  Line('  movq $10, %rsi');
  Line('  call rt_fatalnum');
  Line('  leaq .Lmib(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgMib)) + ', %rdx');
  Line('  call rt_rawwrite');
  Line('  jmp rt_dieend');
  Line('rt_die:');
  Line('  xorq %rdi, %rdi');
  Line('  leaq .Lfatal(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgFatal)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_diemmap:');
  Line('  xorq %rdi, %rdi');
  Line('  leaq .Lmmapfail(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgMmap)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_dietoobig:');
  Line('  xorq %rdi, %rdi');
  Line('  leaq .Ltoobig(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgTooBig)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_dieepoll:');
  Line('  xorq %rdi, %rdi');
  Line('  leaq .Lepollfail(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgEpoll)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_diestack:');
  Line('  leaq .Lstackovf(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgStack)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_diesendclosed:');
  Line('  leaq .Lsendclosed(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgSendClosed)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_diemaprw:');
  Line('  leaq .Lmaprw(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgMapRW)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_diecloseclosed:');
  Line('  leaq .Lcloseclosed(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgCloseClosed)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_dieclosesender:');
  Line('  leaq .Lclosesender(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgCloseSender)) + ', %rdx');
  Line('  jmp rt_diemsg');
  { No line: every routine is asleep, none is at fault (1.0.139). }
  Line('rt_diedeadlock:');
  Line('  xorq %rdi, %rdi');
  Line('  leaq .Ldeadlock(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgDeadlock)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_diethreads:');
  Line('  xorq %rdi, %rdi');
  Line('  leaq .Lthreads(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgThreads)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_divzero:');
  Line('  movq (%rsp), %rdi');
  Line('  decq %rdi');
  Line('  leaq .Ldivzero(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgDivZero)) + ', %rdx');
  Line('  jmp rt_diemsg');
  { rt_divover and rt_divmod128 (P106, 1.0.121): hi:lo in rdi:rsi over
    rdx, unsigned, the quotient to (rcx) and the remainder to (r8); a
    quotient past 64 bits stops as a zero divisor does, at the caller's
    line. }
  Line('rt_divover:');
  Line('  movq (%rsp), %rdi');
  Line('  decq %rdi');
  Line('  leaq .Ldivover(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgDivOver)) + ', %rdx');
  Line('  jmp rt_diemsg');
  Line('rt_divmod128:');
  Line('  testq %rdx, %rdx');
  Line('  jz rt_divzero');
  Line('  cmpq %rdx, %rdi');
  Line('  jae rt_divover');
  Line('  movq %rdx, %r9');
  Line('  movq %rdi, %rdx');
  Line('  movq %rsi, %rax');
  Line('  divq %r9');
  Line('  movq %rax, (%rcx)');
  Line('  movq %rdx, (%r8)');
  Line('  ret');
  { rt_boundsfail (P87): paslang: index I out of range [LO..HI] at line
    N, from an inline check (rdi the index, rsi and rdx the bounds, the
    return address the line), then exit 1. It never returns, so rbx and
    r12 to r15 hold what rt_rawwrite and rt_fatalnum would clobber.
    rt_fatalint prints rdi signed: an index may be negative. }
  { rt_bitfail (1.0.117): the same for a bit number, paslang: bit N out
    of range [0..M] at line L. }
  Line('rt_bitfail:');
  Line('  leaq .Lbbit(%rip), %rax');
  Line('  movq $' + IntToStr(Length(MsgBit)) + ', %rcx');
  Line('  jmp .bf_go');
  { rt_setfail (P126): a set's element out of its range, paslang: set
    element N out of range [LO..HI] at line L }
  Line('rt_setfail:');
  Line('  leaq .Lbset(%rip), %rax');
  Line('  movq $' + IntToStr(Length(MsgSet)) + ', %rcx');
  Line('  jmp .bf_go');
  Line('rt_boundsfail:');
  Line('  leaq .Lbidx(%rip), %rax');
  Line('  movq $' + IntToStr(Length(MsgIndex)) + ', %rcx');
  Line('.bf_go:');
  Line('  movq (%rsp), %r15');
  Line('  decq %r15');
  Line('  movq %rdi, %rbx');
  Line('  movq %rsi, %r12');
  Line('  movq %rdx, %r13');
  Line('  movq %rax, %rsi');
  Line('  movq %rcx, %rdx');
  Line('  call rt_rawwrite');
  Line('  movq %rbx, %rdi');
  Line('  call rt_fatalint');
  Line('  leaq .Lbrange(%rip), %rsi');
  Line('  movq $' + IntToStr(Length(MsgOutOfRange)) + ', %rdx');
  Line('  call rt_rawwrite');
  Line('  movq %r12, %rdi');
  Line('  call rt_fatalint');
  Line('  leaq .Lbdots(%rip), %rsi');
  Line('  movq $2, %rdx');
