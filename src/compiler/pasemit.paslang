    free (rt_strextend), else it is copied; rt_strnextcap keeps x10. }
  Line('.asp_more:');
  Line('  sub x5, x10, #1');
  Line('  add x6, x2, x4');
  Line('  str x30, [sp, #-16]!');
  Line('  bl rt_strnextcap');
  Line('  cmp x10, #8, lsl #12');
  Line('  b.ls .asp_nox');
  Line('  bl rt_strextend');
  Line('  ldr x30, [sp], #16');
  Line('  cbnz x9, .asp_place');
  Line('  b .asp_grow');
  Line('.asp_nox:');
  Line('  ldr x30, [sp], #16');
  Line('  b .asp_grow');
  Line('.asp_new:');
  Line('  add x5, x2, x4');
  Line('.asp_grow:');
  Line('  stp x0, x30, [sp, #-16]!');
  Line('  bl rt_strgrow');
  Line('  ldp x9, x30, [sp], #16');
  Line('  stp x0, x2, [x9]');
  Line('  ret');
  { rt_strappendc: x3 a character, the rest as rt_strappend; the
    character waits on the stack for rt_strgrow. The emitter writes the
    first checks in line when c calls no routine (EmitStrAppend). }
  Line('rt_strappendc:');
  Line('  ldp x9, x10, [x0]');
  Line('  cmp x9, x1');
  Line('  b.ne .aspc_new');
  Line('  cmp x10, x2');
  Line('  b.ne .aspc_new');
  Line('  cbz x2, .aspc_new');
  Line('  ldurb w9, [x1, #-1]');
  Line('  tbnz w9, #0, .aspc_new');
  Line('  lsr w9, w9, #1');
  Line('  cbz w9, .aspc_new');
  LeaS('rt_class2size', 'x10');
  Line('  ldr x10, [x10, x9, lsl #3]');
  Line('  add x11, x2, #2');
  Line('  cmp x11, x10');
  Line('  b.hi .aspc_more');
  Line('.aspc_place:');
  Line('  strb w3, [x1, x2]');
  Line('  add x2, x2, #1');
  Line('  str x2, [x0, #8]');
  Line('  mov x0, x1');
  Line('  ret');
  Line('.aspc_more:');
  Line('  sub x5, x10, #1');
  Line('  add x6, x2, #1');
  Line('  str x30, [sp, #-16]!');
  Line('  bl rt_strnextcap');
  Line('  cmp x10, #8, lsl #12');
  Line('  b.ls .aspc_nox');
  Line('  bl rt_strextend');
  Line('  ldr x30, [sp], #16');
  Line('  cbnz x9, .aspc_place');
  Line('  b .aspc_grow');
  Line('.aspc_nox:');
  Line('  ldr x30, [sp], #16');
  Line('  b .aspc_grow');
  Line('.aspc_new:');
  Line('  add x5, x2, #1');
  Line('.aspc_grow:');
  Line('  stp x0, x30, [sp, #-16]!');
  Line('  str x3, [sp, #-16]!');
  Line('  mov x3, sp');
  Line('  mov x4, #1');
  Line('  bl rt_strgrow');
  Line('  add sp, sp, #16');
  Line('  ldp x9, x30, [sp], #16');
  Line('  stp x0, x2, [x9]');
  Line('  ret');
  { rt_strnextcap as on amd64: x5 a capacity, x6 the length wanted; the
    capacity to grow to in x5. x7 and x8 change; ADD (shifted register)
    adds the quarter, LSR #2. }
  Line('rt_strnextcap:');
  Line('  add x7, x5, x5');
  Line('  cmp x6, x7');
  Line('  b.hi .asnc_len');
  Line('  cmp x5, #256');
  Line('  b.lo .asnc_dbl');
  Line('  mov x7, x5');
  Line('.asnc_q:');
  Line('  add x8, x7, #768');
  Line('  add x7, x7, x8, lsr #2');
  Line('  cmp x7, x6');
  Line('  b.lo .asnc_q');
  Line('.asnc_dbl:');
  Line('  mov x5, x7');
  Line('  ret');
  Line('.asnc_len:');
  Line('  mov x5, x6');
  Line('  ret');
  { rt_strextend as on amd64: x1 the characters, x5 the capacity
    wanted; x9 1 when the block grew where it is (its byte before says
    the new class), 0 when not; x0 to x8 kept (rt_gocall keeps every
    register but x0, so x11 holds the class across it). }
