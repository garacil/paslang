    when empty; a sender waiting for room moves its word in, its G in x2
    (else 0). x9-x13 change. }
  Line('rt_chbget:');
  Line('  mov x2, xzr');
  Line('  ldr x9, [x0, #48]');
  Line('  cbz x9, .acbg_none');
  Line('  ldr x10, [x0, #64]');
  Line('  cbz x10, .acbg_none');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  ldr x9, [x19, #48]');
  Line('  ldr x11, [x19, #72]');
  Line('  ldr x20, [x9, x11, lsl #3]');
  Line('  str xzr, [x9, x11, lsl #3]');
  Line('  add x11, x11, #1');
  Line('  ldr x12, [x19, #56]');
  Line('  cmp x11, x12');
  Line('  b.lo .acbg_h');
  Line('  mov x11, xzr');
  Line('.acbg_h:');
  Line('  str x11, [x19, #72]');
  Line('  sub x10, x10, #1');
  Line('  str x10, [x19, #64]');
  Line('  add x0, x19, #32');
  Line('  bl rt_cqtake');
  Line('  mov x2, xzr');
  Line('  cbz x0, .acbg_done');
  Line('  ldr x13, [x0, #16]');
  Line('  ldr x2, [x0, #8]');
  Line('  ldr x9, [x19, #48]');
  Line('  ldr x10, [x19, #64]');
  Line('  ldr x11, [x19, #72]');
  Line('  add x11, x11, x10');
  Line('  ldr x12, [x19, #56]');
  Line('  cmp x11, x12');
  Line('  b.lo .acbg_t');
  Line('  sub x11, x11, x12');
  Line('.acbg_t:');
  Line('  str x13, [x9, x11, lsl #3]');
  Line('  add x10, x10, #1');
  Line('  str x10, [x19, #64]');
  Line('.acbg_done:');
  Line('  mov x0, x20');
  Line('  mov x1, #1');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.acbg_none:');
  Line('  mov x1, xzr');
  Line('  ret');
  { Channels, the same design as amd64: chan 0 lock, 8 closed, 16/24
    recvq, 32/40 sendq; a 48-byte waiter on the waiting G's stack (0 next,
    8 G, 16 elem, 24 select control block or 0, 32 arm); a 16-byte select
