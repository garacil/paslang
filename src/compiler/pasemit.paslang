  Line('  mov x0, x19');
  Line('  mov x1, x20');
  Line('  bl rt_chbput');
  Line('  cbz x0, .axs_no');
  Line('  stlr wzr, [x19]');
  Line('  mov x0, #1');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.axs_no:');
  Line('  stlr wzr, [x19]');
  Line('  mov x0, xzr');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
