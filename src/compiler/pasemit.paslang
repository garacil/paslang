  Line('  pushq %r12');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .np_none');
  Line('  subq $192, %rsp');
  Line('  movq %rsp, %rsi');
  Line('  movq $16, %rdx');
  Line('  xorq %r10, %r10');
  Line('  movq $232, %rax');
  Line('  syscall');
  Line('  movq %rax, %rbx');
  Line('  call rt_now');
  Line('  movq %rax, rt_lastpoll(%rip)');
  Line('  xorq %r12, %r12');
