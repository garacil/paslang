  Line('  ldr x2, [x19, #8]');
  Line('  cmp x2, x20');
  Line('  b.ls .asl_n');
  Line('  mov x2, x20');
  Line('.asl_n:');
  Line('  mul x2, x2, x21');
  Line('  cbz x1, .asl_nodata');
  Line('  mov x0, x9');
  Line('  str x9, [sp, #-16]!');
  Line('  bl rt_memcpy');
  Line('  ldr x9, [sp], #16');
  Line('  cbz x25, .asl_nodata');
  Line('  ldr x26, [x19, #8]');
  Line('  cmp x26, x20');
  Line('  b.ls .asl_sc');
  Line('  mov x26, x20');
  Line('.asl_sc:');
  Line('  str x9, [sp, #-16]!');
  Line('  mov x0, x9');
  Line('.asl_sl:');
  Line('  cbz x26, .asl_sd');
  Line('  mov x1, x25');
  Line('  bl rt_strshare');
  Line('  add x0, x0, x21');
  Line('  sub x26, x26, #1');
  Line('  b .asl_sl');
  Line('.asl_sd:');
  Line('  ldr x9, [sp], #16');
  Line('.asl_nodata:');
  Line('  str x9, [x19]');
  Line('  str x20, [x19, #8]');
  Line('  str x24, [x19, #16]');
  Line('  mul x10, x24, x21');
  Line('  str x20, [x9, x10]');
  Line('  b .asl_ret');
  Line('.asl_str:');
  Line('  mul x0, x20, x21');
  Line('  bl rt_stralloc');
  Line('  mov x9, x0');
  Line('  ldr x1, [x19]');
  Line('  ldr x2, [x19, #8]');
  Line('  mul x2, x2, x21');
  Line('  mul x10, x20, x21');
  Line('  cmp x2, x10');
  Line('  b.ls .asl_sok');
  Line('  mov x2, x10');
  Line('.asl_sok:');
  Line('  cbz x1, .asl_snodata');
  Line('  mov x0, x9');
  Line('  str x9, [sp, #-16]!');
  Line('  bl rt_memcpy');
  Line('  ldr x9, [sp], #16');
  Line('.asl_snodata:');
  Line('  str x9, [x19]');
  Line('  str x20, [x19, #8]');
  Line('.asl_ret:');
  Line('  ldp x25, x26, [sp], #16');
  Line('  ldp x23, x24, [sp], #16');
  Line('  ldp x21, x22, [sp], #16');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  { x0 fd. epoll ADD or MOD, then park. arm64 event is 16 bytes. }
  { ReadLn is Pascal, as on amd64 (1.0.57); x0 the string. }
  Line('.weak p_pasroutines_pasreadln');
  Line('rt_readln:');
  Line('  b p_pasroutines_pasreadln');
  Line('rt_waitfd:');
  Line('  mov x1, #1');
  Line('  b rt_waitio');
  Line('  .ltorg');
end;

function EmitAmd64(const Prog: TProgram): string;
var
  em: TEmitter;
begin
  em := TEmitter.Create;
  try
    em.FArm := False;
    Result := em.Emit(Prog);
  finally
    em.Free;
  end;
end;

function EmitArm64(const Prog: TProgram): string;
var
  em: TEmitter;
begin
  em := TEmitter.Create;
  try
    em.FArm := True;
    Result := em.Emit(Prog);
  finally
    em.Free;
  end;
end;

end.