procedure TEmitter.EmitRuntime;
begin
  Line('');
  Line('.globl rt_morestack');
  { A stack may reach 1 GiB, as in Go; stacks are counted in
    rt_stacktot with a 64 GiB ceiling of their own (P92). }
  Line('rt_mmap:');
  Line('  cmpq $1073741824, %rdi');
  Line('  ja rt_dietoobig');
  Line('  movq rt_stacktot(%rip), %rax');
  Line('  addq %rdi, %rax');
  Line('  movabs $68719476736, %rcx');
  Line('  cmpq %rcx, %rax');
  Line('  ja rt_dieoomstk');
  Line('  movq %rdi, %rsi');
  Line('  xorq %rdi, %rdi');
  Line('  movq $3, %rdx');
  Line('  movq $0x4022, %r10');
  Line('  movq $-1, %r8');
  Line('  xorq %r9, %r9');
  Line('  movq $9, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  js rt_diemmap');
  Line('  lock addq %rsi, rt_stacktot(%rip)');
  Line('  ret');
  Line('');
  Line('rt_guard:');
  Line('  movq $4096, %rsi');
  Line('  movq $102, %rdx');
  Line('  movq $28, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  jnz rt_guardfail');
  Line('  ret');
  Line('');
  Line('rt_guardfail:');
  Line('  leaq .Lguarderr(%rip), %rsi');
  Line('  movq $35, %rdx');
  Line('  movq $2, %rdi');
  Line('  movq $1, %rax');
  Line('  syscall');
  Line('  movq $2, %rdi');
  Line('  jmp rt_exit');
  Line('');
  { P86: a fatal runtime error says why. Everything here writes to
    standard error with raw system calls, never through rt_write, which
    may park: a fatal path runs inside a signal handler on the alternate
    stack, or on a routine that holds a lock. rt_diemsg takes the text in
    rsi and rdx and a pc in rdi (0 when there is none), prints " at line
    N" when the pc is inside the program, and exits 1 as every runtime
    error does. rt_fatalnum prints rdi in the base rsi. }
  Line('rt_rawwrite:');
  Line('  movq $2, %rdi');
  Line('  movq $1, %rax');
  Line('  syscall');
  Line('  cmpq $-4, %rax');
  Line('  je rt_rawwrite');
  Line('  cmpq $-11, %rax');
  Line('  je rt_rawwrite');
  Line('  ret');
  Line('rt_fatalnum:');
  Line('  pushq %rbp');
  Line('  movq %rsp, %rbp');
  Line('  subq $32, %rsp');
