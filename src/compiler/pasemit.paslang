  Line('  ldaxr w6, [x9]');
  Line('  cmp w6, w2');
  Line('  b.ne .qps_clr');
  Line('  stlxr w7, w5, [x9]');
  Line('  cbnz w7, .qps_cas');
  Line('  mov w8, wzr');
