  Line('  mov x3, xzr');
  Line('  cbnz x1, .wi_loop');
  Line('  mov w9, #48');
  Line('  strb w9, [x29, #-2]');
  Line('  sub x1, x29, #2');
  Line('  mov x2, #1');
  Line('  ldr x0, [sp]');
  Line('  bl rt_write');
  Line('  mov sp, x29');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
  Line('.wi_loop:');
  Line('  mov x0, x1');
  Line('  mov x4, #10');
  Line('  udiv x5, x0, x4');
  Line('  msub x6, x5, x4, x0');
  Line('  add w6, w6, #48');
  Line('  sub x2, x2, #1');
  Line('  strb w6, [x2]');
  Line('  mov x1, x5');
  Line('  cbnz x1, .wi_loop');
  Line('  cbz x3, .wi_out');
  Line('  sub x2, x2, #1');
  Line('  mov w9, #45');
  Line('  strb w9, [x2]');
  Line('.wi_out:');
  Line('  sub x0, x29, #1');
  Line('  sub x0, x0, x2');
  Line('  mov x1, x2');
  Line('  mov x2, x0');
  Line('  ldr x0, [sp]');
  Line('  bl rt_write');
  Line('  mov sp, x29');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
  { rt_alloc as on amd64 (P95a): x0 size, x1 GC word; the block in x0. }
  Line('rt_alloc:');
  Line('  cbz x28, rt_persistentalloc');
  Line('  ldr x11, [x28, #32]');
  Line('  cbz x11, rt_persistentalloc');
  Line('  ldr x11, [x11, #8]');
  Line('  cbz x11, rt_persistentalloc');
  Line('  ldr x11, [x11, #2136]');
  Line('  cbz x11, rt_persistentalloc');
  Line('  cbz x0, .al_zero');
  Line('  cbnz x1, .al_scan');
