    empty local queue (globrunqget) (P98). }
  Line('rt_runqputslow:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  Line('.qps_retry:');
  Line('  ldr w2, [x19, #16]');
  Line('  ldr w3, [x19, #20]');
  Line('  sub w4, w3, w2');
  Line('  cmp w4, #256');
