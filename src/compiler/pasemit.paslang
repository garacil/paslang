    the sigcontext, fault_address, 31 registers, sp, pc); address at 16
    and code at 8 of the siginfo. }
  Line('rt_sighandler:');
  LeaS('rt_siglock', 'x9');
  Line('.sh_lk:');
  Line('  ldaxr x10, [x9]');
  Line('  cbnz x10, .sh_spin');
  Line('  mov x10, #1');
  Line('  stlxr w11, x10, [x9]');
  Line('  cbnz w11, .sh_lk');
  Line('  b .sh_first');
  Line('.sh_spin:');
  Line('  clrex');
  Line('  wfe');
  Line('  b .sh_spin');
  Line('.sh_first:');
  Line('  ldr x19, [x2, #440]');
  Line('  ldr x22, [x2, #432]');
  Line('  ldr x20, [x1, #16]');
  Line('  ldr w21, [x1, #8]');
  Line('  cmp x0, #8');
  Line('  b.eq .sh_fpe');
  Line('  cmp x0, #7');
  Line('  b.eq .sh_bus');
  Imm('x9', 4096);
  Line('  cmp x20, x9');
  Line('  b.lo .sh_nil');
  Imm('x9', 65536);
  Line('  sub x9, x22, x9');
  Line('  cmp x20, x9');
  Line('  b.lo .sh_bad');
  Imm('x9', 4096);
  Line('  add x9, x22, x9');
  Line('  cmp x20, x9');
  Line('  b.hs .sh_bad');
  Line('.sh_stk:');
  LeaS('.Lstackovf', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgStack)));
  Line('  bl rt_rawwrite');
  LeaS('.Laddr', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgAddr)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x20');
