  Line('  movq %r12, 8(%r15)');
  Line('  lock incq rt_nspinning(%rip)');
  Line('  movq $1, 56(%r12)');
  Line('  movq $0, 72(%r12)');
  Line('  movl $1, 48(%r12)');
  Line('  movq $8, %rax');
  Line('  xchgq %rax, 120(%rbx)');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  leaq rt_heapstate+336(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  testq %rbp, %rbp');
  Line('  jz .rk_wake');
  Line('  movq %r12, %rdi');
  Line('  call rt_newm');
  Line('  jmp .rk_done');
  Line('.rk_wake:');
  Line('  leaq 48(%r12), %rdi');
  Line('  movq $129, %rsi');
  Line('  movq $1, %rdx');
  Line('  movq $202, %rax');
  Line('  syscall');
  Line('  jmp .rk_done');
  Line('.rk_unlock:');
  Line('  leaq rt_heapstate+336(%rip), %rdi');
  Line('  call rt_unlock');
  Line('.rk_done:');
  Line('  popq %r15');
  Line('  popq %r12');
  Line('  popq %rbp');
  Line('  popq %rbx');
  Line('  ret');
  { Only a retaken syscall returns here: the G is queued with a saved
    syscall continuation; this M waits without a P until reused. }
  Line('rt_mnopwait:');
  Line('  movl $0, 48(%r13)');
  Line('  movq $1, %rax');
  Line('  xchgq %rax, 120(%r13)');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  movq rt_mnop(%rip), %rax');
  Line('  movq %rax, 64(%r13)');
  Line('  movq %r13, rt_mnop(%rip)');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  call rt_msleepin');
  Line('.mn_wait:');
  Line('  call rt_gcwork');
  Line('  cmpl $0, 48(%r13)');
  Line('  jne .mn_awake');
  Line('  leaq 48(%r13), %rdi');
  Line('  movq $128, %rsi');
  Line('  xorq %rdx, %rdx');
  Line('  xorq %r10, %r10');
  Line('  movq $202, %rax');
  Line('  syscall');
  Line('  jmp .mn_wait');
  Line('.mn_awake:');
  Line('  call rt_msleepout');
  Line('  call rt_gcidle');
  Line('  jmp rt_mloop');
  Line('');
  { rt_gcms: before a cycle, threads for the Ms it may mark with, up to
    heap state +536 (pasheap: the workers a cycle may use, the Ps at
    most, 0 without the collector): a program of one routine has no
    other M running, and marked alone. rbx kept (P91). }
  Line('rt_gcms:');
  Line('  pushq %rbx');
  Line('.gm_top:');
  Line('  movq rt_heapstate+536(%rip), %rax');
  Line('  cmpq rt_mstarted(%rip), %rax');
  Line('  jbe .gm_ret');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  movq rt_mstarted(%rip), %rbx');
  Line('  cmpq rt_heapstate+536(%rip), %rbx');
  Line('  jae .gm_unl');
  Line('  cmpq rt_nproc(%rip), %rbx');
  Line('  jae .gm_unl');
  Line('  incq rt_mstarted(%rip)');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  shlq $7, %rbx');
  Line('  leaq rt_allm(%rip), %rdi');
  Line('  addq %rbx, %rdi');
  Line('  call rt_newm');
  Line('  jmp .gm_top');
  Line('.gm_unl:');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('.gm_ret:');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
end;

procedure TEmitter.EmitIO;
begin
  { A standard stream (P212): rt_stdout and rt_stderr, one record each,
    as Go's os.Stdout and os.Stderr are two Files, each with the
    writeLock of its own poll.FD (internal/poll/fd_unix.go Write,
    fd_mutex.go), so a WriteLn stuck on a full standard output no longer
    holds a diagnostic to standard error. Record: +0 the runtime lock,
    +8 held, +16 and +24 the queue of the routines waiting (first, last:
    first come, first served, as the semaphore fdMutex sleeps on,
    runtime/sema.go with lifo false), +32 the descriptor, +40 the bytes
    in the buffer at +64 (OutBufSize). rt_printlock and rt_printunlock
    take the record in rdi. Hand-off like a mutex: a waiting G parks,
    the M runs other routines, and the unlock hands the stream to the
    first waiter. }
  Line('rt_printlock:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  call rt_lock');
  Line('  cmpq $0, 8(%rbx)');
  Line('  jne .pl_wait');
  Line('  movq $1, 8(%rbx)');
  Line('  movq %rbx, %rdi');
  Line('  call rt_unlock');
  Line('  popq %rbx');
  Line('  ret');
  Line('.pl_wait:');
  Line('  leaq 16(%rbx), %rdi');
  Line('  call rt_qwaitback');
  Line('  movq %rbx, %rdi');
  Line('  call rt_parkunlock');
  Line('  popq %rbx');
  Line('  ret');
  { The statement's bytes go out first, in one write while they fit the
    buffer, as Go's Fprintln makes one Write of its line
    (fmt/print.go), so WriteLns to two streams on one pipe do not cut
    each other's lines. }
  Line('rt_printunlock:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  movq %rdi, %rbx');
  Line('  call rt_outflush');
  Line('  movq %rbx, %rdi');
  Line('  call rt_lock');
  Line('  leaq 16(%rbx), %rdi');
  Line('  call rt_qwakefirst');
  Line('  testq %rax, %rax');
  Line('  jz .pu_free');
  Line('  movq %rax, %r12');
  Line('  movq %rbx, %rdi');
  Line('  call rt_unlock');
  Line('  movq %r12, %rdi');
  Line('  call rt_ready');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('.pu_free:');
  Line('  movq $0, 8(%rbx)');
  Line('  movq %rbx, %rdi');
  Line('  call rt_unlock');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  { One write while a wake is pending (rt_wakesig), as Go's netpollBreak:
    the M that drains the eventfd lets the next one through (P350). }
  Line('rt_poke:');
  Line('  movq rt_evfd(%rip), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .pk2_done');
  Line('  movl $1, %eax');
  Line('  xchgl %eax, rt_wakesig(%rip)');
  Line('  testl %eax, %eax');
  Line('  jnz .pk2_done');
  Line('  subq $8, %rsp');
  Line('  movq $1, (%rsp)');
  Line('  movq %rsp, %rsi');
  Line('  movq $8, %rdx');
  Line('  movq $1, %rax');
  Line('  syscall');
  Line('  addq $8, %rsp');
  Line('.pk2_done:');
  Line('  ret');
  Line('');
  { the poller and its eventfd close on exec (EPOLL_CLOEXEC,
    EFD_CLOEXEC | EFD_NONBLOCK): a program that runs itself again, as
    the debugger's run does, does not carry them into the new one.
    The standard streams keep the flags the program found (P217): it
    shares their open file descriptions with its shell and the programs
    around it, and the O_NONBLOCK this set on 0, 1 and 2 outlived it, so
    a cat writing to the same pipe after it stopped with EAGAIN. Go
    never sets it on them (src/os/file_unix.go newFileFromNewFile: a
    descriptor from NewFile is polled only when it already was
    nonblocking): a blocking stream blocks in rt_syscall, which hands
    its P over (P178), and one found nonblocking parks on the poller. }
  Line('rt_ioinit:');
  Line('  movq $524288, %rdi');
  Line('  movq $291, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  js rt_dieepoll');
  Line('  movq %rax, rt_epfd(%rip)');
  Line('  xorq %rdi, %rdi');
  Line('  movq $526336, %rsi');
  Line('  movq $290, %rax');
  Line('  syscall');
  Line('  movq %rax, rt_evfd(%rip)');
  Line('  subq $16, %rsp');
  Line('  movl $1, (%rsp)');
  Line('  movq $1, 4(%rsp)');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  movq $1, %rsi');
  Line('  movq %rax, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  Line('  addq $16, %rsp');
  Line('  ret');
  Line('');
  { rt_now: CLOCK_MONOTONIC in ns through the vDSO's clock_gettime when
    the kernel gave one (rt_vdsocgt, found by rt_vdsoinit), as Go's
    nanotime does: a tenth of the system call's cost, and the mutex
    reads the clock at every park (P98). The vDSO is C code: r8, r9 and
    r10, which the system call kept, are kept here too. }
  Line('rt_now:');
  Line('  movq rt_vdsocgt(%rip), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .now_sys');
  Line('  pushq %r8');
  Line('  pushq %r9');
  Line('  pushq %r10');
  Line('  pushq %rbp');
  Line('  movq %rsp, %rbp');
  { on a routine's own stack (r14 its record, sp within its bounds) the
    call goes on its M's stack, free while the routine runs, as Go's
    nanotime1 goes to g0: how much stack the vDSO's C code takes is not
    known, and a routine's stack keeps the red zone only (P342). r14 is 0
    on an M's own stack and in sysmon, or an M's own record (status 5,
    rt_gocallm's), and the records whose bounds are not set (rt_nsg)
    hold no sp; rbp, which the vDSO keeps, brings sp back. }
  Line('  testq %r14, %r14');
  Line('  jz .now_here');
  Line('  cmpl $5, 152(%r14)');
  Line('  je .now_here');
  Line('  cmpq 0(%r14), %rsp');
  Line('  jb .now_here');
  Line('  cmpq 8(%r14), %rsp');
  Line('  ja .now_here');
  Line('  movq 32(%r14), %r8');
  Line('  movq 32(%r8), %rsp');
  Line('.now_here:');
  Line('  subq $16, %rsp');
  Line('  andq $-16, %rsp');
  Line('  movq $1, %rdi');
  Line('  movq %rsp, %rsi');
  Line('  call *%rax');
  Line('  movq (%rsp), %rax');
  Line('  movq $1000000000, %rcx');
  Line('  mulq %rcx');
  Line('  addq 8(%rsp), %rax');
  Line('  movq %rbp, %rsp');
  Line('  popq %rbp');
  Line('  popq %r10');
  Line('  popq %r9');
  Line('  popq %r8');
  Line('  ret');
  Line('.now_sys:');
  Line('  subq $16, %rsp');
  Line('  movq $1, %rdi');
  Line('  movq %rsp, %rsi');
  Line('  movq $228, %rax');
  Line('  syscall');
  Line('  movq (%rsp), %rax');
  Line('  movq $1000000000, %rcx');
  Line('  mulq %rcx');
  Line('  addq 8(%rsp), %rax');
  Line('  addq $16, %rsp');
  Line('  ret');
  Line('');
  Line('rt_sleep:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  call rt_now');
  Line('  movq $1000000, %rcx');
  Line('  imulq %rcx, %rbx');
  Line('  addq %rax, %rbx');
  Line('  movq %rbx, 208(%r14)');
  Line('  movq $0, 264(%r14)');
  Line('  movl $1, 152(%r14)');
  { on this M's P's timers, under that P's lock (P352), as Go's
    maybeAdd takes the current P's: the routine runs runtime code, so
    neither its M nor that M's P changes meanwhile }
  Line('  movq 32(%r14), %rax');
  Line('  movq 8(%rax), %rsi');
  Line('  call rt_tadd');
  Line('  popq %rbx');
  Line('  call rt_parkmarked');
  Line('  ret');
  Line('');
  { The timers (P115, 1.1.1; P352): a binary min-heap of routines by
    wake time in each P, as Go keeps a heap of timers in each P
    (runtime/time.go timers): at P+2144 (64 MB of address space mapped
    the first time, pages touched as it grows), their count at P+2152,
    their lock at P+2160, the earliest wake time at P+2168, all ones
    with none. One heap under the global lock made every Sleep wait for
    every other: b17conc's sleepers spent most of their time in rt_lock
    on rt_glock. A routine's place is at G+216: the P's id in its high
    half and the index + 1 in its low one (0 when it is in no heap);
    its wake time at G+208 and, for a wait on a descriptor with a
    deadline, the wait's token at G+264 (0 for Sleep). Insert, delete
    and a look at the earliest are O(log n) and O(1). The P's lock is
    held for all of them.
    rt_tsift: rdi an index, rsi the P; the routine there goes up while
    its parent wakes later, then down while a child wakes earlier, and
    every routine moved gets its new place. Caller-saved registers, rsi
    among them; rbx and r12 kept. }
  Line('rt_tsift:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  movq 2152(%rsi), %rbx');
  Line('  movq (%rsi), %r12');
  Line('  shlq $32, %r12');
  Line('  movq 2144(%rsi), %r8');
  Line('  movq (%r8,%rdi,8), %r9');
  Line('  movq 208(%r9), %r10');
  Line('.ts_up:');
  Line('  testq %rdi, %rdi');
  Line('  jz .ts_dn');
  Line('  leaq -1(%rdi), %rsi');
  Line('  shrq $1, %rsi');
  Line('  movq (%r8,%rsi,8), %r11');
  Line('  cmpq 208(%r11), %r10');
  Line('  jae .ts_dn');
  Line('  movq %r11, (%r8,%rdi,8)');
  Line('  leaq 1(%r12,%rdi), %rax');
  Line('  movq %rax, 216(%r11)');
  Line('  movq %rsi, %rdi');
  Line('  jmp .ts_up');
  Line('.ts_dn:');
  Line('  leaq 1(%rdi,%rdi), %rsi');
  Line('  cmpq %rbx, %rsi');
  Line('  jae .ts_put');
  Line('  movq (%r8,%rsi,8), %r11');
  Line('  leaq 1(%rsi), %rdx');
  Line('  cmpq %rbx, %rdx');
  Line('  jae .ts_cmp');
  Line('  movq (%r8,%rdx,8), %rax');
  Line('  movq 208(%rax), %rcx');
  Line('  cmpq 208(%r11), %rcx');
  Line('  jae .ts_cmp');
  Line('  movq %rdx, %rsi');
  Line('  movq %rax, %r11');
  Line('.ts_cmp:');
  Line('  cmpq 208(%r11), %r10');
  Line('  jbe .ts_put');
  Line('  movq %r11, (%r8,%rdi,8)');
  Line('  leaq 1(%r12,%rdi), %rax');
  Line('  movq %rax, 216(%r11)');
  Line('  movq %rsi, %rdi');
  Line('  jmp .ts_dn');
  Line('.ts_put:');
  Line('  movq %r9, (%r8,%rdi,8)');
  Line('  leaq 1(%r12,%rdi), %rax');
  Line('  movq %rax, 216(%r9)');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  { rt_tins: rdi a routine with its wake time at G+208 and token at
    G+264 goes into the heap of the P at rsi, or moves where it is if it
    is there (in that P's). rsi kept. }
  Line('rt_tins:');
  Line('  cmpq $0, 2144(%rsi)');
  Line('  jne .ti_have');
  Line('  pushq %rdi');
  Line('  pushq %rsi');
  Line('  xorq %rdi, %rdi');
  Line('  movq $67108864, %rsi');
  Line('  movq $3, %rdx');
  Line('  movq $0x4022, %r10');
  Line('  movq $-1, %r8');
  Line('  xorq %r9, %r9');
  Line('  movq $9, %rax');
  Line('  syscall');
  Line('  popq %rsi');
  Line('  popq %rdi');
  Line('  testq %rax, %rax');
  Line('  jns .ti_mapped');
  Line('  jmp rt_diemmap');
  Line('.ti_mapped:');
  Line('  movq %rax, 2144(%rsi)');
  Line('.ti_have:');
  Line('  pushq %rsi');
  Line('  movq 216(%rdi), %rax');
  Line('  testq %rax, %rax');
  Line('  jnz .ti_again');
  Line('  movq 2152(%rsi), %rax');
  Line('  cmpq $8388608, %rax');
  Line('  jb .ti_room');
  Line('  jmp rt_dietoobig');
  Line('.ti_room:');
  Line('  movq 2144(%rsi), %r8');
  Line('  movq %rdi, (%r8,%rax,8)');
  Line('  leaq 1(%rax), %rcx');
  Line('  movq %rcx, 2152(%rsi)');
  Line('  movq (%rsi), %rdx');
  Line('  shlq $32, %rdx');
  Line('  addq %rdx, %rcx');
  Line('  movq %rcx, 216(%rdi)');
  Line('  movq %rax, %rdi');
  Line('  call rt_tsift');
  Line('  jmp .ti_t0');
  Line('.ti_again:');
  Line('  movl %eax, %edi');
  Line('  decq %rdi');
  Line('  call rt_tsift');
  Line('.ti_t0:');
  Line('  popq %rsi');
  Line('  movq 2144(%rsi), %r8');
  Line('  movq (%r8), %rax');
  Line('  movq 208(%rax), %rax');
  Line('  movq %rax, 2168(%rsi)');
  Line('  ret');
  Line('');
  { rt_tdel: rdi a routine, rsi the P whose heap holds it, that P's lock
    held; out of the heap if it is in it. rsi kept. }
  Line('rt_tdel:');
  Line('  movq 216(%rdi), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .td_ret');
  Line('  movq $0, 216(%rdi)');
  Line('  movl %eax, %eax');
  Line('  decq %rax');
  Line('  movq 2152(%rsi), %rcx');
  Line('  decq %rcx');
  Line('  movq %rcx, 2152(%rsi)');
  Line('  cmpq %rcx, %rax');
  Line('  je .td_t0');
  Line('  pushq %rsi');
  Line('  movq 2144(%rsi), %r8');
  Line('  movq (%r8,%rcx,8), %r9');
  Line('  movq %r9, (%r8,%rax,8)');
  Line('  movq %rax, %rdi');
  Line('  call rt_tsift');
  Line('  popq %rsi');
  Line('.td_t0:');
  Line('  movq $-1, %rax');
  Line('  cmpq $0, 2152(%rsi)');
  Line('  je .td_set');
  Line('  movq 2144(%rsi), %r8');
  Line('  movq (%r8), %rax');
  Line('  movq 208(%rax), %rax');
  Line('.td_set:');
  Line('  movq %rax, 2168(%rsi)');
  Line('.td_ret:');
  Line('  ret');
  Line('');
  { rt_tadd: the routine r14, its wake time at G+208 and token at G+264,
    onto the timers of the P at rsi under that P's lock. Then, as Go's
    maybeAdd and wakeNetPoller (runtime/time.go, proc.go): only a timer
    earlier than the P's earliest before it can come before what any M
    waits for; then with an M in the poller (rt_pollerm) it is poked
    out when the deadline it sleeps to (rt_polluntil, 0 while it is not
    known yet) is later, and with none rt_wakep sends one there.
    Callee-saved registers kept. }
  Line('rt_tadd:');
  Line('  pushq %rbx');
  Line('  movq %rsi, %rbx');
  Line('  leaq 2160(%rbx), %rdi');
  Line('  call rt_lock');
  Line('  movq 2168(%rbx), %rax');
  Line('  cmpq $0, 2152(%rbx)');
  Line('  jne .ta_t0');
  Line('  movq $-1, %rax');
  Line('.ta_t0:');
  Line('  pushq %rax');
  Line('  movq %r14, %rdi');
  Line('  movq %rbx, %rsi');
  Line('  call rt_tins');
  Line('  leaq 2160(%rbx), %rdi');
  Line('  call rt_unlock');
  Line('  popq %rax');
  Line('  movq 208(%r14), %rdi');
  Line('  popq %rbx');
  Line('  cmpq %rax, %rdi');
  Line('  jae .ta_ret');
  Line('  cmpq $0, rt_pollerm(%rip)');
  Line('  je rt_wakep');
  Line('  movq rt_polluntil(%rip), %rax');
  Line('  testq %rax, %rax');
  Line('  jz rt_poke');
  Line('  cmpq %rdi, %rax');
  Line('  ja rt_poke');
  Line('.ta_ret:');
  Line('  ret');
  Line('');
  { rt_tgone: the routine r14 off the timers it is on, through the P
    whose id G+216 holds and under its lock: a routine a descriptor
    woke before its deadline. The place is read before the lock, then
    again under it: only rt_runtimers takes it off meanwhile, and the
    routine, which runs, puts itself on no heap. }
  Line('rt_tgone:');
  Line('  movq 216(%r14), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .tg_ret');
  Line('  pushq %rbx');
  Line('  shrq $32, %rax');
  Line('  imulq $2176, %rax, %rbx');
  Line('  leaq rt_allp(%rip), %rax');
  Line('  addq %rax, %rbx');
  Line('  leaq 2160(%rbx), %rdi');
  Line('  call rt_lock');
  Line('  movq %r14, %rdi');
  Line('  movq %rbx, %rsi');
  Line('  call rt_tdel');
  Line('  leaq 2160(%rbx), %rdi');
  Line('  call rt_unlock');
  Line('  popq %rbx');
  Line('.tg_ret:');
  Line('  ret');
  Line('');
  { rt_anytimer: rax not 0 when a routine is on any P's timers. }
  Line('rt_anytimer:');
  Line('  xorq %rax, %rax');
  Line('  movq rt_nproc(%rip), %rcx');
  Line('  leaq rt_allp(%rip), %rdx');
  Line('.at_n:');
  Line('  testq %rcx, %rcx');
  Line('  jz .at_ret');
  Line('  orq 2152(%rdx), %rax');
  Line('  addq $2176, %rdx');
  Line('  decq %rcx');
  Line('  jmp .at_n');
  Line('.at_ret:');
  Line('  ret');
  Line('');
  { rt_runtimers: rdi a P, rsi the time now. The routines on its timers
    whose time has come are taken off the heap with its lock held, into
    a batch of 32 on this stack with the token each needs (read while
    the lock keeps the routine from moving on), and woken once it is
    dropped: a Sleep readied, a deadline wait through its token, which
    does nothing when the descriptor woke it first. A full batch is
    woken and the heap looked at again. Go's timers.run. rbx, r12, r13
    and r15 kept. }
  Line('rt_runtimers:');
  Line('  pushq %rbx');
