            boMod:
              begin
                Line('  movq %rax, %rcx');
                Line('  popq %rax');
                EmitDivCheck;
                Line('  cqto');
                Line('  idivq %rcx');
                Line('  movq %rdx, %rax');
              end;
            boEq: EmitCmp('sete');
            boNe: EmitCmp('setne');
            boLt: EmitCmp('setl');
            boLe: EmitCmp('setle');
            boGt: EmitCmp('setg');
            boGe: EmitCmp('setge');
            boAnd:
              begin
                PopLeft;
                if FRightOn then
                begin
                  FRightOn := False;
                  Line('  andq $' + IntToStr(FRightK) + ', %rax');
                end
                else
                  Line('  andq ' + LeftSrc + ', %rax');
              end;
            boOr:
              begin
                PopLeft;
                if FRightOn then
                begin
                  FRightOn := False;
                  Line('  orq $' + IntToStr(FRightK) + ', %rax');
                end
                else
                  Line('  orq ' + LeftSrc + ', %rax');
              end;
            boXor:
              begin
                PopLeft;
                if FRightOn then
                begin
                  FRightOn := False;
                  Line('  xorq $' + IntToStr(FRightK) + ', %rax');
                end
                else
                  Line('  xorq ' + LeftSrc + ', %rax');
              end;
            boShl:
              begin
                Line('  movq %rax, %rcx');
                Line('  popq %rax');
                Line('  shlq %cl, %rax');
              end;
            boShr:
              begin
                Line('  movq %rax, %rcx');
                Line('  popq %rax');
                { A clean Int8, Int16 or Int32 shifts by its sign (P99). }
                if (E^.Typ = TyInt8) or (E^.Typ = TyInt16) or (E^.Typ = TyInt32) then
                  Line('  sarq %cl, %rax')
                else
                  Line('  shrq %cl, %rax');
              end;
            boSar, boRol, boRor:
              begin
                Line('  movq %rax, %rcx');
                Line('  popq %rax');
                RotX86(E^.Bin, E^.Typ);
              end;
            boMulHi, boMulHiS:
              begin
                { the 128-bit product's high word, in rdx (P106) }
                Line('  movq %rax, %rcx');
                Line('  popq %rax');
                if E^.Bin = boMulHi then
                  Line('  mulq %rcx')
                else
                  Line('  imulq %rcx');
                Line('  movq %rdx, %rax');
              end;
          end;
        end;
      end;
  end;
end;

{ The tables of -debug (P118), section pasdbg, twelve words a record:
  1 a routine (start, end, name, its length, the source, its length,
  the first line, the count of locals, their table), 2 a global (its
  address, name, length, code, size), 3 the lines (count, table of pc
  and line). A local is name, length, offset from the frame pointer,
  code and size: 1 a signed integer, 2 unsigned, 3 Boolean, 4 Char, 5
  string, 6 Double, 7 Single, 8 pointer, 9 enumeration or subrange,
  10 anything else, and the offset inside its heap box when a closure
  holds it, -1 otherwise. The debugger unit reads them between
  __start_pasdbg and __stop_pasdbg. }
{ A name the tables leave out: none, Self, or a hidden one (a dot in
  it) but for an on handler's (P122). }
function DbgHidden(const N: string): Boolean;
var
  i: SizeInt;
begin
  Result := (N = '') or SameSym(N, 'self');
  if OnVarUser(N) <> '' then
    Exit;
  for i := 1 to Length(N) do
    if N[i] = '.' then
      Result := True;
end;

{ The name the tables give: an on handler's object by the handler's
  name for it (P122). }
function DbgName(const N: string): string;
begin
  Result := OnVarUser(N);
  if Result = '' then
    Result := N;
end;

{ N is a class variable's global (P123): Class.Name, of a class declared
  here that has that class variable. }
function TEmitter.IsClassVar(const N: string): Boolean;
var
  i, j, d: SizeInt;
  cls, nm: string;
begin
  Result := False;
  d := 0;
  for i := Length(N) downto 1 do
    if (d = 0) and (N[i] = '.') then
      d := i;
  if d < 2 then
    Exit;
  cls := Copy(N, 1, d - 1);
  nm := Copy(N, d + 1, Length(N) - d);
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykClass) and SameSym(FTypes[i].Name, cls) then
      for j := 0 to High(FTypes[i].CVars) do
        if SameSym(FTypes[i].CVars[j].Name, nm) then
          Result := True;
end;

procedure TEmitter.DbgCode(Typ: LongInt; out Code, Size: LongInt);
var
  k: TTypeKind;
begin
  Size := TSize(Typ);
  k := TKind(Typ);
  { a subrange of Char shows as a Char too (P135): its low byte }
  if (Typ = TyChar) or ((k = tykSubrange) and (FTypes[Typ].Elem = TyChar)) then
    Code := 4
  else if Typ = TyBoolean then
    Code := 3
  else if (Typ = TyByte) or (Typ = TyWord) or (Typ = TyUInt32) then
    Code := 2
  else if k = tykInteger then
    Code := 1
  else if k = tykBoolean then
    Code := 3
  else if IsStr(Typ) then
  begin
    Code := 5;
    Size := 16;
  end
  else if Typ = TySingle then
    Code := 7
  else if k = tykReal then
    Code := 6
  else if k = tykCurrency then
    Code := 11
  else if k = tykJson then
    { its text (P204), pasdebug's ValueText }
    Code := 12
  else if (k = tykPointer) or (k = tykClass) or (k = tykProc) or (k = tykClassRef) then
    Code := 8
  else if (k = tykEnum) or (k = tykSubrange) then
    Code := 9
  else
    Code := 10;
end;

procedure TEmitter.EmitDebugTables(const Prog: TProgram);
var
  p, v, n: SizeInt;
  code, size: LongInt;
  secn, box: string;
  src: string;
begin
  if FArm then
    secn := '.section pasdbg,"aw",%progbits'
  else
    secn := '.section pasdbg,"aw",@progbits';
  if FSrc <> '' then
    src := FSrc
  else
    src := Prog.Name;
  { the locals of each routine, and the lines, in .rodata }
  Line('.section .rodata');
  for p := 0 to High(FOwnNames) do
  begin
    Line('.balign 8');
    Line('.Ldbl' + IntToStr(p) + ':');
    for v := 0 to High(FOwnSyms[p]) do
    begin
      if FOwnSyms[p][v].Global or FOwnSyms[p][v].ByRef or (FOwnSyms[p][v].Up > 0) then
        Continue;
      if DbgHidden(FOwnSyms[p][v].Name) then
        Continue;
      DbgCode(FOwnSyms[p][v].Typ, code, size);
      if FOwnSyms[p][v].Boxed then
        box := IntToStr(FOwnSyms[p][v].BoxOff)
      else
        box := '-1';
      Line('  .quad ' + InternStr(DbgName(FOwnSyms[p][v].Name)) + ', ' +
        IntToStr(Length(DbgName(FOwnSyms[p][v].Name))) +
        ', ' + IntToStr(FOwnSyms[p][v].Off) + ', ' + IntToStr(code) + ', ' + IntToStr(size) + ', ' + box);
    end;
  end;
  Line('.balign 8');
  Line('.Ldbn:');
  for v := 0 to High(FLineLabs) do
    Line('  .quad ' + FLineLabs[v] + ', ' + IntToStr(FLineNums[v]));
  Line(secn);
  Line('.balign 8');
  for p := 0 to High(FOwnNames) do
  begin
    n := 0;
    for v := 0 to High(FOwnSyms[p]) do
    begin
      if FOwnSyms[p][v].Global or FOwnSyms[p][v].ByRef or (FOwnSyms[p][v].Up > 0) then
        Continue;
      if DbgHidden(FOwnSyms[p][v].Name) then
        Continue;
      Inc(n);
    end;
    Line('  .quad 1, ' + FOwnNames[p] + ', ' + FOwnEnds[p] + ', ' + InternStr(FOwnPas[p]) + ', ' +
      IntToStr(Length(FOwnPas[p])) + ', ' + InternStr(src) + ', ' + IntToStr(Length(src)) + ', ' +
      IntToStr(FOwnLine[p]) + ', ' + IntToStr(n) + ', .Ldbl' + IntToStr(p) + ', 0, 0');
  end;
  for v := 0 to High(Prog.Vars) do
  begin
    if Prog.Vars[v].Ext then
      Continue;
    { a class variable (P123), Class.Name, is the program's own }
    if DbgHidden(Prog.Vars[v].Name) and not IsClassVar(Prog.Vars[v].Name) then
      Continue;
    DbgCode(Prog.Vars[v].Typ, code, size);
    Line('  .quad 2, ' + VarLabel(GlobName(Prog.Vars[v])) + ', ' + InternStr(DbgName(Prog.Vars[v].Name)) +
      ', ' + IntToStr(Length(DbgName(Prog.Vars[v].Name))) + ', ' + IntToStr(code) + ', ' + IntToStr(size) + ', 0, 0, 0, 0, 0, 0');
  end;
  if not Prog.IsUnit then
    Line('  .quad 1, pas_main, .Lmainend, ' + InternStr('main') + ', 4, ' + InternStr(src) + ', ' +
      IntToStr(Length(src)) + ', ' + IntToStr(FMainLine) + ', 0, 0, 0, 0');
  Line('  .quad 3, ' + IntToStr(Length(FLineLabs)) + ', .Ldbn, 0, 0, 0, 0, 0, 0, 0, 0, 0');
  Line('.section .rodata');
end;

procedure TEmitter.EmitDumpLocals;
var
  i: SizeInt;
  nm: string;
begin
  if FArm then
  begin
    { the same on arm64 (1.0.136): it emitted nothing, and the statement
      then went out as a call of rt_dumplocs, which no runtime has, so
      the program did not link }
    LeaS('rt_stdout', 'x0');
    Line('  bl rt_printlock');
    for i := 0 to High(FSym) do
    begin
      if FSym[i].ByRef or (FSym[i].Up > 0) then
        Continue;
      if not IsIntId(FSym[i].Typ) then
        Continue;
      nm := ToLower(FSym[i].Name);
      if (nm = '') or (nm = 'result') or (nm = 'self') or
        (Copy(nm, 1, 7) = 'for.lim') or (Copy(nm, 1, 7) = 'bit.tmp') then
        Continue;
      LeaS(InternStr(FSym[i].Name + '='), 'x1');
      Imm('x2', Length(FSym[i].Name) + 1);
      LeaS('rt_stdout', 'x0');
      Line('  bl rt_write');
      if FSym[i].Global then
        LeaS(VarLabel(FSym[i].Name), 'x9')
      else
        AddFP('x9', FSym[i].Off);
      LoadTo('[x9]', FSym[i].Typ, 'x1');
      LeaS('rt_stdout', 'x0');
      Line('  bl rt_writeint');
      LeaS('rt_stdout', 'x0');
      Line('  bl rt_nl');
    end;
    LeaS('rt_stdout', 'x0');
    Line('  bl rt_printunlock');
    Exit;
  end;
  { every call takes the standard output's record in rdi (P212) }
  Line('  leaq rt_stdout(%rip), %rdi');
  Line('  call rt_printlock');
  for i := 0 to High(FSym) do
  begin
    if FSym[i].ByRef or (FSym[i].Up > 0) then
      Continue;
    if not IsIntId(FSym[i].Typ) then
      Continue;
    nm := ToLower(FSym[i].Name);
    if (nm = '') or (nm = 'result') or (nm = 'self') or
      (Copy(nm, 1, 7) = 'for.lim') or (Copy(nm, 1, 7) = 'bit.tmp') then
      Continue;
    Line('  leaq ' + InternStr(FSym[i].Name + '=') + '(%rip), %rsi');
    Line('  movq $' + IntToStr(Length(FSym[i].Name) + 1) + ', %rdx');
    Line('  leaq rt_stdout(%rip), %rdi');
    Line('  call rt_write');
    if FSym[i].Global then
      LoadTo(VarLabel(FSym[i].Name) + '(%rip)', FSym[i].Typ, 'rax')
    else
      LoadTo(IntToStr(FSym[i].Off) + '(%rbp)', FSym[i].Typ, 'rax');
    Line('  leaq rt_stdout(%rip), %rdi');
    Line('  call rt_writeint');
    Line('  leaq rt_stdout(%rip), %rdi');
    Line('  call rt_nl');
  end;
  Line('  leaq rt_stdout(%rip), %rdi');
  Line('  call rt_printunlock');
end;

procedure TEmitter.EmitForRunes(S: PStmt);
var
  head, cont, done: string;
  sym: TSym;
begin
  if (S = nil) or (S^.E = nil) then
    Die('for-in');
  sym := FindSym(S^.Name);
  if IsFat(sym.Typ) or IsBlob(sym.Typ) or (TSize(sym.Typ) < 8) then
    Die('for-in rune variable');
  head := Lab;
  cont := Lab;
  done := Lab;
  PushLoop(done, cont);
  EmitExpr(S^.E);
  if FArm then
  begin
    SpAdjArm('sub', 48);
    Line('  str x0, [sp]');
    Line('  str x2, [sp, #8]');
    Line('  str xzr, [sp, #16]');
    Line(head + ':');
    EmitStackCheck(head, '16');
    Line('  ldr x3, [sp, #16]');
    Line('  ldr x4, [sp, #8]');
    Line('  cmp x3, x4');
    Line('  b.hs ' + done);
    Line('  ldr x0, [sp]');
    Line('  mov x1, x4');
    Line('  mov x2, x3');
    Line('  bl rt_decoderune');
    Line('  str x1, [sp, #24]');
    StoreVar(S^.Name);
    EmitStmt(S^.Body);
    Line(cont + ':');
    Line('  ldr x1, [sp, #24]');
    Line('  ldr x3, [sp, #16]');
    Line('  add x3, x3, x1');
    Line('  str x3, [sp, #16]');
    Line('  b ' + head);
    Line(done + ':');
    SpAdjArm('add', 48);
  end
  else
  begin
    Line('  subq $32, %rsp');
    Line('  movq %rax, (%rsp)');
    Line('  movq %rdx, 8(%rsp)');
    Line('  movq $0, 16(%rsp)');
    Line(head + ':');
    EmitStackCheck(head, '16');
    Line('  movq 16(%rsp), %rax');
    Line('  cmpq 8(%rsp), %rax');
    Line('  jae ' + done);
    Line('  movq (%rsp), %rdi');
    Line('  movq 8(%rsp), %rsi');
    Line('  movq %rax, %rdx');
    Line('  call rt_decoderune');
    Line('  movq %rdx, 24(%rsp)');
    StoreVar(S^.Name);
    EmitStmt(S^.Body);
    Line(cont + ':');
    Line('  movq 24(%rsp), %rax');
    Line('  addq %rax, 16(%rsp)');
    Line('  jmp ' + head);
    Line(done + ':');
    Line('  addq $32, %rsp');
  end;
  PopLoop;
end;

procedure TEmitter.EmitStmtNow(S: PStmt);
var
  i, j, n, nreg, nv, ns: SizeInt;
  ist: PStmt;
  a, b, c, d, smap, op: string;
  boxoff: array of LongInt;
  td: TTypeDef;
  off, so: LongInt;
  vs: TSym;
begin
  if S = nil then
    Exit;
  FScratchCur := 0;
  SetLength(FScrOff, 0);
  SetLength(FScrK, 0);
  EmitLoc(S^.Line);
  if (S^.Kind = skAssign) and (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) then
  begin
    FLastAsgName := S^.Dest^.Name;
    FLastAsgE := S^.E;
  end;
  if FDebug and (S^.Line > 0) and (FDbgFn <> '') and (S^.Kind <> skBlock) then
  begin
    { -debug (P118): the debugger sees every statement, with its line,
      its routine and its frame; a statement starts with no value in a
      caller-saved register, so the call costs the registers nothing }
    if FArm then
    begin
      Imm('x0', S^.Line);
      LeaS(FDbgFn, 'x1');
      Line('  mov x2, x29');
      Line('  bl p_pasdebug_pasdebugline');
    end
    else
    begin
      LoadImmR('rdi', S^.Line);
      Line('  leaq ' + FDbgFn + '(%rip), %rsi');
      Line('  movq %rbp, %rdx');
      Line('  call p_pasdebug_pasdebugline');
    end;
  end;
  if (S^.Kind = skCall) and EmitInlineStmt(S) then
    Exit;
  { -checkptr: Inc and Dec of a pointer are p := p +- step, whose step is
    held to p's object (P104). }
  if FCheckPtr and ((S^.Kind = skInc) or (S^.Kind = skDec)) and (S^.Dest <> nil) and
    (TKind(S^.Dest^.Typ) = tykPointer) and (not EHasCall(S^.Dest)) then
  begin
    ist := NewStmt(skAssign);
    ist^.Line := S^.Line;
    ist^.Dest := S^.Dest;
    if S^.Kind = skInc then
      ist^.E := NewBin(boAdd, S^.Dest, S^.E)
    else
      ist^.E := NewBin(boSub, S^.Dest, S^.E);
    ist^.E^.Typ := S^.Dest^.Typ;
    EmitStmt(ist);
    Exit;
  end;
  { -debug keeps every variable in its slot (P118): the hook at each
    statement is a call, and a value lent a register would not survive it }
  if (not FPromoOn) and (not FDebug) and ((S^.Kind = skWhile) or (S^.Kind = skRepeat) or
    (S^.Kind = skFor)) then
    if EmitPromoted(S) then
      Exit;
  if FArm then
  begin
    case S^.Kind of
      skBlock:
        EmitBlockStmts(S);
      skAssign:
        begin
          if not VecAssign(S) then
          if not FastAssign(S) then
          if not OrdAssign(S) then
          if not EmitStrAppend(S) then
          if (S^.Dest <> nil) and (S^.E <> nil) and
            (TKind(S^.Dest^.Typ) = tykInterface) and
            (TKind(S^.E^.Typ) = tykClass) then
            EmitIfaceBind(S^.E, S^.Dest)
          else
          begin
          if (S^.Dest <> nil) and (S^.Dest^.Typ = TyChar) and
            (S^.E <> nil) and (S^.E^.Kind = ekStr) and (Length(S^.E^.Txt) = 1) then
            Imm('x0', Ord(S^.E^.Txt[1]))
          else
            EmitExpr(S^.E);
          PromoteReal(S^.Dest, S^.E);
          FStoreSrc := S^.E;
          if S^.Dest <> nil then
            StoreTo(S^.Dest)
          else
            StoreVar(S^.Name);
          FStoreSrc := nil;
          end;
        end;
      skCall:
        if (S^.E = nil) and (S^.Name = 'rt_syscall') then
          { a bare Syscall(...) makes the call and drops the result
            (1.0.136): the generic call put the number in x0 }
          EmitSyscall(S^.Args)
        else if (S^.E = nil) and (S^.Name = 'rt_dumplocs') then
          EmitDumpLocals
        else if S^.E <> nil then
        begin
          off := -1;
          if S^.E2 <> nil then
            off := S^.E2^.Num;
          if off = -4 then
            EmitCallVal(S^.E, S^.Args)
          else if TKind(S^.E^.Typ) = tykInterface then
            EmitIfaceCall(S^.E, S^.Args, off)
          else
          begin
          if off = -2 then
            off := -3;
          EmitArmMeth(S^.E, S^.Args, off, S^.Name);
          end;
        end
        else if S^.Name = 'rt_setlength' then
        begin
          EmitExpr(S^.Args[1]);
          PshK('x0', VCls(S^.Args[1]^.Typ, 0));
          EmitExpr(S^.Args[0]);
          Ppop('x1');
          if (S^.Args[0]^.Kind = ekAddr) and IsDyn(S^.Args[0]^.L^.Typ) then
          begin
            Imm('x2', TSize(FTypes[S^.Args[0]^.L^.Typ].Elem));
            Line('  mov x3, #1');
            GcArg(GcWord(FTypes[S^.Args[0]^.L^.Typ].Elem), 'x4');
            smap := StrMap(FTypes[S^.Args[0]^.L^.Typ].Elem);
            if smap <> '' then
              LeaS(smap, 'x5')
            else
              Line('  mov x5, xzr');
          end
          else
          begin
            Line('  mov x2, #1');
            Line('  mov x3, xzr');
            Line('  mov x4, xzr');
            Line('  mov x5, xzr');
          end;
          Line('  bl rt_setlength');
        end
        else if S^.Name = 'rt_move' then
        begin
          { a constant count up to 128 in line, fixed places with no
            push (P304) }
          if (not EmitSmallMove(S)) and (not EmitMoveArgs(S)) then
          begin
          EmitExpr(S^.Args[0]);
          PshK('x0', VCls(S^.Args[0]^.Typ, 0));
          EmitExpr(S^.Args[1]);
          PshK('x0', VCls(S^.Args[1]^.Typ, 0));
          EmitExpr(S^.Args[2]);
          Line('  mov x2, x0');
          Ppop('x0');
          Ppop('x1');
          Line('  bl rt_memcpy');
          end;
        end
        else if S^.Name = 'rt_fillchar' then
        begin
          if not EmitSmallFill(S) then
          begin
          if not EmitFillArgs(S) then
          begin
          EmitExpr(S^.Args[0]);
          PshK('x0', VCls(S^.Args[0]^.Typ, 0));
          EmitExpr(S^.Args[1]);
          PshK('x0', 0);
          EmitExpr(S^.Args[2]);
          Line('  mov x2, x0');
          Ppop('x1');
          Ppop('x0');
          end;
          a := Lab;
          b := Lab;
          Line('  cmp x1, #0');
          Line('  b.le ' + b);
          { 32 bytes a store by rt_fill (P272); past 256 KiB a piece at a
            time, the routine able to stop between two (P271) }
          Line('  cmp x1, #64, lsl #12');
          ColdBegin('  b.hi');
          Line('  bl rt_fillbig');
          Line('  b ' + b);
          ColdEnd;
          Line(a + ':');
          Line('  bl rt_fill');
          Line(b + ':');
          end;
        end
        else
          EmitCall(S^.Name, S^.Args);
      skSend:
        begin
          EmitExpr(S^.E);
          PshK('x0', VCls(S^.E^.Typ, 0));
          if ChanBoxed(S^.E^.Typ) then
            EmitBox(S^.E2, FTypes[S^.E^.Typ].Elem)
          else
            EmitExpr(S^.E2);
          Line('  mov x1, x0');
          Ppop('x0');
          Line('  bl rt_chansend');
        end;
      skClose:
        begin
          EmitExpr(S^.E);
          Line('  bl rt_chanclose');
        end;
      skSelect:
        begin
          n := Length(S^.Sels);
          boxoff := nil;
          SetLength(boxoff, n);
          if n > 16 then
            Die('select has more than 16 arms');
          { the arms and rt_select's frame under them, as on amd64 (P342) }
          SpAdjArm('sub', n * 32 + 144 + n * 48);
          for i := 0 to n - 1 do
          begin
            Imm('x9', Ord(S^.Sels[i].Kind));
            AddImmArm('x16', 'sp', i * 32);
            Line('  str x9, [x16]');
            if S^.Sels[i].Kind = selDefault then
            begin
              Line('  str xzr, [x16, #8]');
              Line('  str xzr, [x16, #16]');
            end
            else
            begin
              PshK('x16', 1);
              EmitExpr(S^.Sels[i].Chan);
              Ppop('x16');
              Line('  str x0, [x16, #8]');
              if S^.Sels[i].Kind = selSend then
              begin
                PshK('x16', 1);
                if ChanBoxed(S^.Sels[i].Chan^.Typ) then
                  EmitBox(S^.Sels[i].ValX, FTypes[S^.Sels[i].Chan^.Typ].Elem)
                else
                  EmitExpr(S^.Sels[i].ValX);
                Ppop('x16');
                Line('  str x0, [x16, #16]');
              end
              else if ChanBoxed(S^.Sels[i].Chan^.Typ) then
              begin
                { The box arrives in a word of the frame (1.0.83). }
                boxoff[i] := ScratchT(8, S^.Sels[i].Chan^.Typ);
                AddImmArmT('x9', 'x29', boxoff[i], 'x9');
                Line('  str x9, [x16, #16]');
              end
              else
              begin
                PshK('x16', 1);
                EmitAddr(NewVar(S^.Sels[i].Dest, TyInteger));
                Ppop('x16');
                Line('  str x0, [x16, #16]');
              end;
            end;
          end;
          Line('  mov x0, sp');
          Imm('x1', n);
          AddImmArm('x2', 'sp', n * 32);
          Line('  bl rt_select');
          SpAdjArm('add', n * 32 + 144 + n * 48);
          b := Lab;
          for i := 0 to n - 1 do
          begin
            a := Lab;
            CmpImmArm('x0', i, 'x9');
            Line('  b.ne ' + a);
            if (S^.Sels[i].Kind = selRecv) and ChanBoxed(S^.Sels[i].Chan^.Typ) then
            begin
              LdFP('x0', boxoff[i]);
              EmitUnbox(FTypes[S^.Sels[i].Chan^.Typ].Elem);
              StoreTo(NewVar(S^.Sels[i].Dest, FindSym(S^.Sels[i].Dest).Typ));
              Imm('x0', i);
            end;
            { The chosen arm never needs the selector again. Keeping it
              on the stack made Break/Continue skip its pop (P192), so
              subsequent safe points no longer matched their stack maps.
              Like Go walk/select.go, enter the body with no temporary
              selector storage that a control-flow exit must unwind. }
            EmitStmt(S^.Sels[i].Body);
            { the last arm falls to the end (P305) }
            if i < n - 1 then
              Line('  b ' + b);
            Line(a + ':');
          end;
          Line(b + ':');
        end;
      skPas:
        if S^.E <> nil then
        begin
          EmitExpr(S^.E);
          Line('  mov x3, x2');
          Line('  mov x1, xzr');
          Line('  mov x2, xzr');
          Line('  bl rt_pas');
        end
        else
        begin
          if Length(S^.Args) > 0 then
          begin
            EmitExpr(S^.Args[0]);
            PshK('x0', VCls(S^.Args[0]^.Typ, 0));
          end;
          if Length(S^.Args) > 1 then
          begin
            EmitExpr(S^.Args[1]);
            PshK('x0', VCls(S^.Args[1]^.Typ, 0));
          end;
          if ProcNest(S^.Name) > 0 then
          begin
            EmitLink(ProcNest(S^.Name));
            Line('  mov x3, x27');
          end
          else
            Line('  mov x3, xzr');
          LeaS(S^.Name, 'x0');
          Line('  mov x1, xzr');
          Line('  mov x2, xzr');
          if Length(S^.Args) > 1 then
            Ppop('x2');
          if Length(S^.Args) > 0 then
            Ppop('x1');
          Line('  bl rt_pas');
        end;
      skNew:
        begin
          td := FTypes[S^.Dest^.Typ];
          if td.Kind <> tykPointer then
            Die('New requires a pointer');
          Imm('x0', TSize(td.Elem));
          GcArg(GcWord(td.Elem), 'x1');
          Line('  bl rt_alloc');
          PshK('x0', 1);
          EmitAddr(S^.Dest);
          Ppop('x1');
          Line('  str x1, [x0]');
        end;
      skWrite, skWriteLn:
        begin
          n := Length(S^.Args);
          if n > 0 then
          begin
            SpAdjArm('sub', n * 16);
          end;
          for i := 0 to n - 1 do
          begin
            EmitExpr(S^.Args[i]);
            AddImmArm('x16', 'sp', i * 16);
            Line('  str x0, [x16]');
            if (S^.Args[i]^.Kind = ekStr) or IsStr(S^.Args[i]^.Typ) then
              Line('  str x2, [x16, #8]');
          end;
          { every call takes the stream's record in x0 (P212), the
            integer of rt_writeint in x1 }
          LeaS(OutStream(S^.Name), 'x0');
          Line('  bl rt_printlock');
          for i := 0 to n - 1 do
          begin
            AddImmArm('x16', 'sp', i * 16);
            if (S^.Args[i]^.Kind = ekStr) or IsStr(S^.Args[i]^.Typ) then
            begin
              Line('  ldr x1, [x16]');
              Line('  ldr x2, [x16, #8]');
              LeaS(OutStream(S^.Name), 'x0');
              Line('  bl rt_write');
            end
            else if S^.Args[i]^.Typ = TyChar then
            begin
              { A Char prints as its byte: the low byte of the slot. }
              Line('  mov x1, x16');
              Line('  mov x2, #1');
              LeaS(OutStream(S^.Name), 'x0');
              Line('  bl rt_write');
            end
            else if TKind(S^.Args[i]^.Typ) = tykReal then
              Die('a real reached Write unformatted (pasfmt formats every real)')
            else
            begin
              Line('  ldr x1, [x16]');
              LeaS(OutStream(S^.Name), 'x0');
              Line('  bl rt_writeint');
            end;
          end;
          if S^.Kind = skWriteLn then
          begin
            LeaS(OutStream(S^.Name), 'x0');
            Line('  bl rt_nl');
          end;
          LeaS(OutStream(S^.Name), 'x0');
          Line('  bl rt_printunlock');
          if n > 0 then
          begin
            SpAdjArm('add', n * 16);
          end;
        end;
      skReadLn:
        begin
          EmitAddr(NewVar(S^.Name, TyString));
          Line('  bl rt_readln');
        end;
      skSleep:
        begin
          EmitExpr(S^.E);
          Line('  bl rt_sleep');
        end;
      skRaise:
        { raise; in a handler raises G+272 again; raise alone elsewhere
          raises no object; raise X [at A] raises X from A, or from the
          call's return address (P122) }
        if S^.Name = 'reraise' then
          Line('  bl rt_raise')
        else if S^.E = nil then
        begin
          Line('  mov x0, xzr');
          Line('  mov x1, xzr');
          Line('  bl rt_raiseobj');
        end
        else
        begin
          EmitExpr(S^.E);
          if S^.E2 <> nil then
          begin
            PshK('x0', 1);
            EmitExpr(S^.E2);
            Line('  mov x1, x0');
            Ppop('x0');
          end
          else
            Line('  mov x1, xzr');
          Line('  bl rt_raiseobj');
        end;
      skTry:
        if S^.Name = 'epilogue' then
        begin
          { a handler's body (P122): ElseSt after it, and before an exit,
            break or continue out of it; no record }
          PushEpi(S^.ElseSt);
          EmitStmt(S^.ThenSt);
          PopTry;
          EmitStmt(S^.ElseSt);
        end
        else
        begin
          a := Lab;
          b := Lab;
          MapHint4(1, 1, 1, 0);
          Line('  sub sp, sp, #32');
          Line('  ldr x9, [x28, #224]');
          Line('  str x9, [sp]');
          Line('  str x29, [sp, #8]');
          Line('  add x9, sp, #32');
          Line('  str x9, [sp, #16]');
          LeaS(a, 'x9');
          Line('  str x9, [sp, #24]');
          Line('  mov x9, sp');
          Line('  str x9, [x28, #224]');
          if S^.Name = 'finally' then
            PushTry(S^.ElseSt)
          else
            PushTry(nil);
          EmitStmt(S^.ThenSt);
          PopTry;
          Line('  ldr x9, [sp]');
          Line('  str x9, [x28, #224]');
          Line('  add sp, sp, #32');
          if S^.Name = 'finally' then
            EmitStmt(S^.ElseSt);
          Line('  b ' + b);
          Line(a + ':');
          EmitStmt(S^.ElseSt);
          if S^.Name = 'finally' then
            Line('  bl rt_raise');
          Line(b + ':');
        end;
      skIf:
        { a word's assignment as a select (P307) }
        if EmitSelectIf(S) then
        else if (S^.ElseSt = nil) and DirectJump(S^.ThenSt, c) then
        begin
          if not JccTrue(S^.E, c) then
          begin
            EmitExpr(S^.E);
            Line('  cbnz x0, ' + c);
          end;
        end
        else
        begin
          a := Lab;
          b := Lab;
          if not FastJcc(S^.E, a) then
          begin
            EmitExpr(S^.E);
            Line('  cbz x0, ' + a);
          end;
          EmitStmt(S^.ThenSt);
          { no else: nothing to jump over (P305) }
          if NoStmt(S^.ElseSt) then
            Line(a + ':')
          else
          begin
            Line('  b ' + b);
            Line(a + ':');
            EmitStmt(S^.ElseSt);
            Line(b + ':');
          end;
        end;
      skWhile:
        if not EmitLoopRun(S) then
        begin
          { Rotated: the test is at the bottom and branches back while it
            holds, one branch a turn; it keeps the while's line (P93). }
          a := Lab;
          b := Lab;
          c := Lab;
          PushLoop(b, c);
          Line('  b ' + c);
          AlignLoop;
          Line(a + ':');
          EmitStmt(S^.Body);
          Line(c + ':');
          EmitLoc(S^.Line);
          EmitStackCheck(c, '16');
          if not JccTrue(S^.E, a) then
          begin
            EmitExpr(S^.E);
            Line('  cbnz x0, ' + a);
          end;
          Line(b + ':');
          PopLoop;
        end;
      skRepeat:
        if not EmitLoopRun(S) then
        begin
          a := Lab;
          b := Lab;
          PushLoop(b, a);
          AlignLoop;
          Line(a + ':');
          EmitStackCheck(a, '16');
          EmitStmt(S^.Body);
          if FDaOn and (S^.DaGen = FDaGen) then
            FCurDa := S^.Da2;
          if not FastJcc(S^.E, a) then
          begin
            EmitExpr(S^.E);
            Line('  cbz x0, ' + a);
          end;
          Line(b + ':');
          PopLoop;
        end;
      skWith:
        EmitStmt(S^.Body);
      skAsm:
        EmitAsmA(S);
      skBreak:
        begin
          if Length(FBrk) = 0 then
            Die('break not in loop');
          UnwindTry(LongInt(Length(FBrk)));
          Line('  b ' + FBrk[High(FBrk)]);
        end;
      skContinue:
        begin
          if Length(FCont) = 0 then
            Die('continue not in loop');
          UnwindTry(LongInt(Length(FBrk)));
          Line('  b ' + FCont[High(FCont)]);
        end;
      skForIn:
        begin
          if (S^.E <> nil) and IsStr(S^.E^.Typ) then
          begin
            EmitForRunes(S);
          end
          else if (S^.E <> nil) and ((TKind(S^.E^.Typ) = tykTree) or
            ((S^.E^.Kind = ekCall) and (S^.E^.Name = 'rt_treerange'))) then
            EmitTreeFor(S)
          else if (S^.E <> nil) and (TKind(S^.E^.Typ) = tykMap) then
          begin
            a := Lab;
            b := Lab;
            PushLoop(b, a);
            { The iterator lives in 32 bytes below the frame. Each step
              returns the key slot; the value follows the key. }
            MapHint4(1, 0, 0, 0);
            Line('  sub sp, sp, #32');
            Line('  str xzr, [sp]');
            Line('  str xzr, [sp, #8]');
            Line('  str xzr, [sp, #16]');
            Line('  str xzr, [sp, #24]');
            Line(a + ':');
            EmitExpr(S^.E);
            Line('  mov x1, sp');
            LeaS('.LdescMap_' + IntToStr(S^.E^.Typ), 'x2');
            Line('  bl p_pasmap_pasmapnext');
            Line('  cbz x0, ' + b);
            PshK('x0', 1);
            vs := FindSym(S^.Name);
            EmitAddr(NewVar(S^.Name, FTypes[S^.E^.Typ].Elem));
            Line('  ldr x1, [sp]');
            Imm('x2', TSize(vs.Typ));
            Line('  bl rt_memcpy');
            { The loop's key and value share the map's strings (1.0.82). }
            smap := StrMap(FTypes[S^.E^.Typ].Elem);
            if smap <> '' then
            begin
              EmitAddr(NewVar(S^.Name, FTypes[S^.E^.Typ].Elem));
              LeaS(smap, 'x1');
              Line('  bl rt_strshare');
            end;
            if S^.Dest <> nil then
            begin
              EmitAddr(S^.Dest);
              Line('  ldr x1, [sp]');
              if IsStr(FTypes[S^.E^.Typ].Elem) then
                Line('  add x1, x1, #16')
              else
                Line('  add x1, x1, #8');
              Imm('x2', TSize(FTypes[S^.E^.Typ].Elem2));
              Line('  bl rt_memcpy');
              smap := StrMap(FTypes[S^.E^.Typ].Elem2);
              if smap <> '' then
              begin
                EmitAddr(S^.Dest);
                LeaS(smap, 'x1');
                Line('  bl rt_strshare');
              end;
            end;
            Ppop('x9');
            EmitStmt(S^.Body);
            Line('  b ' + a);
            Line(b + ':');
            Line('  add sp, sp, #32');
            PopLoop;
          end
          else
          begin
          EmitSetFor(S);
          end;
        end;
      skFor:
        if FDebug or not ForAcc(S) then
          EmitFor(S);
      skCase:
        begin
          b := Lab;
          so := 0;
          if IsStr(S^.E^.Typ) then
            so := ScratchT(16, S^.E^.Typ);
          EmitExpr(S^.E);
          if IsStr(S^.E^.Typ) then
          begin
            StFP('x0', so);
            StFP('x2', so + 8);
          end;
          for i := 0 to High(S^.Arms) do
          begin
            a := Lab;
            c := Lab;
            { A string label compares the whole string; a range is two
              compares (1.0.78). }
            { the arm's last test goes past it when it fails, so a match
              falls into the arm (P305) }
            ns := Length(S^.Arms[i].Strs);
            nv := Length(S^.Arms[i].Vals);
            for j := 0 to ns - 1 do
            begin
              LdFP('x0', so);
              LdFP('x1', so + 8);
              LeaS(InternStr(S^.Arms[i].Strs[j]), 'x2');
              Imm('x3', Length(S^.Arms[i].Strs[j]));
              Line('  bl rt_streq');
              if (j = ns - 1) and (nv = 0) then
                Line('  cbz x0, ' + c)
              else
                Line('  cbnz x0, ' + a);
            end;
            for j := 0 to nv - 1 do
              if (j <= High(S^.Arms[i].His)) and (S^.Arms[i].His[j] <> S^.Arms[i].Vals[j]) then
              begin
                d := Lab;
                if j = nv - 1 then
                  d := c;
                CmpImmArm('x0', S^.Arms[i].Vals[j], 'x9');
                Line('  b.lt ' + d);
                CmpImmArm('x0', S^.Arms[i].His[j], 'x9');
                if j = nv - 1 then
                  Line('  b.gt ' + c)
                else
                begin
                  Line('  b.le ' + a);
                  Line(d + ':');
                end;
              end
              else
              begin
                CmpImmArm('x0', S^.Arms[i].Vals[j], 'x9');
                if j = nv - 1 then
                  Line('  b.ne ' + c)
                else
                  Line('  b.eq ' + a);
              end;
            if ns + nv = 0 then
              Line('  b ' + c);
            Line(a + ':');
            EmitStmt(S^.Arms[i].Body);
            { the last arm without an else falls to the end (P305) }
            if (i < High(S^.Arms)) or not NoStmt(S^.ElseSt) then
              Line('  b ' + b);
            Line(c + ':');
          end;
          EmitStmt(S^.ElseSt);
          Line(b + ':');
        end;
      skExit:
        begin
          if S^.E <> nil then
          begin
            EmitExpr(S^.E);
            if FHasRes and (FResReg <> '') then
            begin
              if FResReg <> 'x0' then
                Line('  mov ' + FResReg + ', x0');
            end
            else if FHasRes then
              StFP('x0', FResOff);
          end;
          UnwindTry(0);
          Line('  b ' + FEpi);
        end;
      skHalt:
        begin
          if S^.E <> nil then
            EmitExpr(S^.E)
          else
            Line('  mov x0, xzr');
          Line('  b rt_exit');
        end;
      skInc, skDec:
        if (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) and
          (FindSym(S^.Dest^.Name).Reg <> '') then
        begin
          vs := FindSym(S^.Dest^.Name);
          { a constant step is the add's or sub's immediate, as amd64's
            addq $k (P306) }
          if (S^.E <> nil) and (S^.E^.Kind = ekInt) and (S^.E^.Num > Low(Int64)) then
          begin
            if S^.Kind = skInc then
              AddImmArmT(vs.Reg, vs.Reg, S^.E^.Num, 'x0')
            else
              AddImmArmT(vs.Reg, vs.Reg, -S^.E^.Num, 'x0');
          end
          else
          begin
            EmitExpr(S^.E);
            if S^.Kind = skInc then
              Line('  add ' + vs.Reg + ', ' + vs.Reg + ', x0')
            else
              Line('  sub ' + vs.Reg + ', ' + vs.Reg + ', x0');
          end;
          CanonReg(vs.Reg, vs.Typ);
        end
        else
        begin
          EmitExpr(S^.E);
          PshK('x0', VCls(S^.E^.Typ, 0));
          FAddrWrite := True;
          EmitAddr(S^.Dest);
          Ppop('x1');
          { At the stored width, so a packed neighbour stays; a narrow
            integer wraps (P99). }
          LoadTo('[x0]', LoadTyp(S^.Dest), 'x2');
          if S^.Kind = skInc then
            Line('  add x2, x2, x1')
          else
            Line('  sub x2, x2, x1');
          CanonReg('x2', LoadTyp(S^.Dest));
          StoreFrom('[x0]', TSize(LoadTyp(S^.Dest)), 'x2');
        end;
    end;
    Exit;
  end;
  case S^.Kind of
    skBlock:
      EmitBlockStmts(S);
    skAssign:
      begin
        if not VecAssign(S) then
        if not FastAssign(S) then
        if not OrdAssign(S) then
        if not EmitStrAppend(S) then
        if (S^.Dest <> nil) and (S^.E <> nil) and
          (TKind(S^.Dest^.Typ) = tykInterface) and
          (TKind(S^.E^.Typ) = tykClass) then
          EmitIfaceBind(S^.E, S^.Dest)
        else
        begin
        if (S^.Dest <> nil) and (S^.Dest^.Typ = TyChar) and
          (S^.E <> nil) and (S^.E^.Kind = ekStr) and (Length(S^.E^.Txt) = 1) then
          Line('  movq $' + IntToStr(Ord(S^.E^.Txt[1])) + ', %rax')
        else
          EmitExpr(S^.E);
        PromoteReal(S^.Dest, S^.E);
        FStoreSrc := S^.E;
        if S^.Dest <> nil then
          StoreTo(S^.Dest)
        else
          StoreVar(S^.Name);
        FStoreSrc := nil;
        end;
      end;
    skCall:
      if (S^.E = nil) and (S^.Name = 'rt_syscall') then
        { a bare Syscall(...) makes the call and drops the result
          (1.0.136): the generic call put the number in rdi and ran
          whatever rax held }
        EmitSyscall(S^.Args)
      else if (S^.Name = '') and ((S^.E2 = nil) or (S^.E2^.Num = -1)) then
      begin
      end
      else if S^.E <> nil then
      begin
        if TKind(S^.E^.Typ) = tykInterface then
        begin
          off := 0;
          if S^.E2 <> nil then
            off := S^.E2^.Num;
          EmitIfaceCall(S^.E, S^.Args, off);
        end
        else if (S^.E2 <> nil) and (S^.E2^.Num = -4) then
          EmitCallVal(S^.E, S^.Args)
        else if (S^.E2 <> nil) and (S^.E2^.Num = -3) then
          EmitMethVal(S^.E, S^.Args)
        else if (S^.E2 <> nil) and (S^.E2^.Num = -2) then
        begin
          EmitExpr(S^.E);
          Line('  movq %rdx, %rdi');
          Line('  call *%rax');
        end
        else
        begin
        begin
          nreg := MethArgs(S^.E, 0, S^.Args);
          if (S^.E2 <> nil) and (S^.E2^.Num >= 0) then
          begin
            Line('  movq (%rdi), %rax');
            Line('  call *' + IntToStr(S^.E2^.Num * 8) + '(%rax)');
          end
          else if (S^.E2 <> nil) and (S^.E2^.Num <= ClsSlotBase) then
            Line('  call *' + IntToStr((ClsSlotBase - S^.E2^.Num) * 8) + '(%rdi)')
          else
            Line('  call ' + S^.Name);
          if nreg > 0 then
            Line('  addq $' + IntToStr((nreg + 1) * 8) + ', %rsp');
        end;
        end;
      end
      else if (S^.Name = 'rt_propkind') or (S^.Name = 'rt_getpropint') or
        (S^.Name = 'rt_getpropstr') or (S^.Name = 'rt_setpropint') or
        (S^.Name = 'rt_setpropstr') or (S^.Name = 'rt_setpropmeth') or
        (S^.Name = 'rt_callprop') then
      begin
        EmitExpr(S^.Args[0]);
        PushK('rax', VCls(S^.Args[0]^.Typ, 0));
        EmitExpr(S^.Args[1]);
        PushK('rdx', VCls(S^.Args[1]^.Typ, 1));
        PushK('rax', VCls(S^.Args[1]^.Typ, 0));
        if S^.Name = 'rt_setpropint' then
        begin
          EmitExpr(S^.Args[2]);
          Line('  movq %rax, %r8');
        end
        else if (S^.Name = 'rt_setpropstr') or (S^.Name = 'rt_setpropmeth') then
        begin
          EmitExpr(S^.Args[2]);
          Line('  movq %rax, %r8');
          Line('  movq %rdx, %r9');
        end;
        Line('  popq %rsi');
        Line('  popq %rdx');
        Line('  popq %rdi');
        Line('  call ' + S^.Name);
      end
      else if S^.Name = 'rt_setlength' then
      begin
        { The length waits on the stack while the address is worked out,
          which may use the register pool or call (P94). }
        EmitExpr(S^.Args[1]);
        PushK('rax', VCls(S^.Args[1]^.Typ, 0));
        EmitExpr(S^.Args[0]);
        Line('  movq %rax, %rdi');
        Line('  popq %rsi');
        if (S^.Args[0]^.Kind = ekAddr) and IsDyn(S^.Args[0]^.L^.Typ) then
        begin
          Line('  movq $' + IntToStr(TSize(FTypes[S^.Args[0]^.L^.Typ].Elem)) +
            ', %rdx');
          Line('  movq $1, %rcx');
          GcArg(GcWord(FTypes[S^.Args[0]^.L^.Typ].Elem), 'r8');
          { A grown slice's copied elements share their strings (1.0.82). }
          smap := StrMap(FTypes[S^.Args[0]^.L^.Typ].Elem);
          if smap <> '' then
            Line('  leaq ' + smap + '(%rip), %r9')
          else
            Line('  xorq %r9, %r9');
        end
        else
        begin
          Line('  movq $1, %rdx');
          Line('  xorq %rcx, %rcx');
          Line('  xorq %r8, %r8');
          Line('  xorq %r9, %r9');
        end;
        Line('  call rt_setlength');
      end
      else if S^.Name = 'rt_move' then
      begin
        { a constant count up to 128 in line, fixed places with no push
          (P304) }
        if (not EmitSmallMove(S)) and (not EmitMoveArgs(S)) then
        begin
        EmitExpr(S^.Args[0]);
        PushK('rax', VCls(S^.Args[0]^.Typ, 0));
        EmitExpr(S^.Args[1]);
        PushK('rax', VCls(S^.Args[1]^.Typ, 0));
        EmitExpr(S^.Args[2]);
        Line('  movq %rax, %rcx');
        Line('  popq %rdi');
        Line('  popq %rsi');
        Line('  call rt_memcpy');
        end;
      end
      else if S^.Name = 'rt_fillchar' then
      begin
        if not EmitSmallFill(S) then
        begin
        if not EmitFillArgs(S) then
        begin
        EmitExpr(S^.Args[0]);
        PushK('rax', VCls(S^.Args[0]^.Typ, 0));
        EmitExpr(S^.Args[1]);
        PushK('rax', 0);
        EmitExpr(S^.Args[2]);
        Line('  popq %rcx');
        Line('  popq %rdi');
        end;
        a := Lab;
        b := Lab;
        Line('  testq %rcx, %rcx');
        Line('  jle ' + a);
        { past 256 KiB a piece at a time, the routine able to stop
          between two (P271) }
        Line('  cmpq $262144, %rcx');
        ColdBegin('  ja');
        Line('  call rt_fillbig');
        Line('  jmp ' + a);
        ColdEnd;
        Line(b + ':');
        Line('  rep stosb');
        Line(a + ':');
        end;
      end
      else if S^.Name = 'rt_dumplocs' then
        EmitDumpLocals
      else
        EmitCall(S^.Name, S^.Args);
    skSend:
      begin
        EmitExpr(S^.E);
        PushK('rax', VCls(S^.E^.Typ, 0));
        if ChanBoxed(S^.E^.Typ) then
          EmitBox(S^.E2, FTypes[S^.E^.Typ].Elem)
        else
          EmitExpr(S^.E2);
        Line('  movq %rax, %rsi');
        Line('  popq %rdi');
        Line('  call rt_chansend');
      end;
    skClose:
      begin
        EmitExpr(S^.E);
        Line('  movq %rax, %rdi');
        Line('  call rt_chanclose');
      end;
    skSelect:
      begin
        n := Length(S^.Sels);
        boxoff := nil;
        SetLength(boxoff, n);
        if n > 16 then
          Die('select has more than 16 arms');
        { the arms, and under them rt_select's frame for n arms: its
          control block, 16 indexes and a waiter an arm (P342) }
        Line('  subq $' + IntToStr(n * 32 + 144 + n * 48) + ', %rsp');
        for i := 0 to n - 1 do
        begin
          Line('  movq $' + IntToStr(Ord(S^.Sels[i].Kind)) + ', ' +
            IntToStr(i * 32) + '(%rsp)');
          if S^.Sels[i].Kind = selDefault then
          begin
            Line('  movq $0, ' + IntToStr(i * 32 + 8) + '(%rsp)');
            Line('  movq $0, ' + IntToStr(i * 32 + 16) + '(%rsp)');
          end
          else
          begin
            EmitExpr(S^.Sels[i].Chan);
            Line('  movq %rax, ' + IntToStr(i * 32 + 8) + '(%rsp)');
            if S^.Sels[i].Kind = selSend then
            begin
              if ChanBoxed(S^.Sels[i].Chan^.Typ) then
                EmitBox(S^.Sels[i].ValX, FTypes[S^.Sels[i].Chan^.Typ].Elem)
              else
                EmitExpr(S^.Sels[i].ValX);
              Line('  movq %rax, ' + IntToStr(i * 32 + 16) + '(%rsp)');
            end
            else if ChanBoxed(S^.Sels[i].Chan^.Typ) then
            begin
              { The box arrives in a word of the frame; the arm copies
                it out into its variable (1.0.83). }
              boxoff[i] := ScratchT(8, S^.Sels[i].Chan^.Typ);
              Line('  leaq ' + IntToStr(boxoff[i]) + '(%rbp), %rax');
              Line('  movq %rax, ' + IntToStr(i * 32 + 16) + '(%rsp)');
            end
            else
            begin
              EmitAddr(NewVar(S^.Sels[i].Dest, TyInteger));
              Line('  movq %rax, ' + IntToStr(i * 32 + 16) + '(%rsp)');
            end;
          end;
        end;
        Line('  movq %rsp, %rdi');
        Line('  movq $' + IntToStr(n) + ', %rsi');
        Line('  leaq ' + IntToStr(n * 32) + '(%rsp), %rdx');
        Line('  call rt_select');
        Line('  addq $' + IntToStr(n * 32 + 144 + n * 48) + ', %rsp');
        b := Lab;
        for i := 0 to n - 1 do
        begin
          a := Lab;
          Line('  cmpq $' + IntToStr(i) + ', %rax');
          Line('  jne ' + a);
          if (S^.Sels[i].Kind = selRecv) and ChanBoxed(S^.Sels[i].Chan^.Typ) then
          begin
            Line('  movq ' + IntToStr(boxoff[i]) + '(%rbp), %rax');
            EmitUnbox(FTypes[S^.Sels[i].Chan^.Typ].Elem);
            StoreTo(NewVar(S^.Sels[i].Dest, FindSym(S^.Sels[i].Dest).Typ));
          end;
          EmitStmt(S^.Sels[i].Body);
          { the last arm falls to the end (P305) }
          if i < n - 1 then
            Line('  jmp ' + b);
          Line(a + ':');
        end;
        Line(b + ':');
      end;
    skPas:
      if S^.E <> nil then
      begin
        { a routine value or a closure (1.0.135): its code and its link }
        EmitExpr(S^.E);
        Line('  movq %rdx, %rcx');
        Line('  movq %rax, %rdi');
        Line('  xorq %rsi, %rsi');
        Line('  xorq %rdx, %rdx');
        Line('  call rt_pas');
      end
      else
      begin;
        if Length(S^.Args) > 0 then
        begin
          EmitExpr(S^.Args[0]);
          PushK('rax', VCls(S^.Args[0]^.Typ, 0));
        end;
        if Length(S^.Args) > 1 then
        begin
          EmitExpr(S^.Args[1]);
          PushK('rax', VCls(S^.Args[1]^.Typ, 0));
        end;
        { a nested routine starts with its parent's link (1.0.134), which
          rt_pas keeps at G+248 for rt_execute to put in r10 }
        if ProcNest(S^.Name) > 0 then
        begin
          EmitLink(ProcNest(S^.Name));
          Line('  movq %r10, %rcx');
        end
        else
          Line('  xorl %ecx, %ecx');
        Line('  leaq ' + S^.Name + '(%rip), %rdi');
        Line('  xorq %rsi, %rsi');
        Line('  xorq %rdx, %rdx');
        if Length(S^.Args) > 1 then
          Line('  popq %rdx');
        if Length(S^.Args) > 0 then
          Line('  popq %rsi');
        Line('  call rt_pas');
      end;
    skNew:
      begin
        td := FTypes[S^.Dest^.Typ];
        if td.Kind <> tykPointer then
          Die('New requires a pointer');
        Line('  movq $' + IntToStr(TSize(td.Elem)) + ', %rdi');
        GcArg(GcWord(td.Elem), 'rsi');
        Line('  call rt_alloc');
        PushK('rax', 1);
        EmitAddr(S^.Dest);
        Line('  popq %rcx');
        Line('  movq %rcx, (%rax)');
      end;
    skWrite, skWriteLn:
      begin
        n := Length(S^.Args);
        if n > 0 then
          Line('  subq $' + IntToStr(n * 16) + ', %rsp');
        for i := 0 to n - 1 do
        begin
          EmitExpr(S^.Args[i]);
          Line('  movq %rax, ' + IntToStr(i * 16) + '(%rsp)');
          if (S^.Args[i]^.Kind = ekStr) or IsStr(S^.Args[i]^.Typ) then
            Line('  movq %rdx, ' + IntToStr(i * 16 + 8) + '(%rsp)');
        end;
        { every call takes the stream's record in rdi (P212): two
          statements on two streams never share an output descriptor }
        Line('  leaq ' + OutStream(S^.Name) + '(%rip), %rdi');
        Line('  call rt_printlock');
        for i := 0 to n - 1 do
        begin
          if (S^.Args[i]^.Kind = ekStr) or IsStr(S^.Args[i]^.Typ) then
          begin
            Line('  movq ' + IntToStr(i * 16) + '(%rsp), %rsi');
            Line('  movq ' + IntToStr(i * 16 + 8) + '(%rsp), %rdx');
            Line('  leaq ' + OutStream(S^.Name) + '(%rip), %rdi');
            Line('  call rt_write');
          end
          else if S^.Args[i]^.Typ = TyChar then
          begin
            { A Char prints as its byte, the character itself; the low
              byte of the slot is that byte. Ord(c) prints the code. }
            Line('  leaq ' + IntToStr(i * 16) + '(%rsp), %rsi');
            Line('  movq $1, %rdx');
            Line('  leaq ' + OutStream(S^.Name) + '(%rip), %rdi');
            Line('  call rt_write');
          end
          else if TKind(S^.Args[i]^.Typ) = tykReal then
            Die('a real reached Write unformatted (pasfmt formats every real)')
          else
          begin
            Line('  movq ' + IntToStr(i * 16) + '(%rsp), %rax');
            Line('  leaq ' + OutStream(S^.Name) + '(%rip), %rdi');
            Line('  call rt_writeint');
          end;
        end;
        if S^.Kind = skWriteLn then
        begin
          Line('  leaq ' + OutStream(S^.Name) + '(%rip), %rdi');
          Line('  call rt_nl');
        end;
        Line('  leaq ' + OutStream(S^.Name) + '(%rip), %rdi');
        Line('  call rt_printunlock');
        if n > 0 then
          Line('  addq $' + IntToStr(n * 16) + ', %rsp');
      end;
    skReadLn:
      begin
        EmitAddr(NewVar(S^.Name, TyString));
        Line('  movq %rax, %rdi');
        Line('  call rt_readln');
      end;
    skSleep:
      begin
        EmitExpr(S^.E);
        Line('  movq %rax, %rdi');
        Line('  call rt_sleep');
      end;
    skRaise:
      { raise; in a handler raises G+272 again; raise alone elsewhere
        raises no object; raise X [at A] raises X from A, or from the
        call's return address (P122) }
      if S^.Name = 'reraise' then
        Line('  call rt_raise')
      else if S^.E = nil then
      begin
        Line('  xorl %edi, %edi');
        Line('  xorl %esi, %esi');
        Line('  call rt_raiseobj');
      end
      else
      begin
        EmitExpr(S^.E);
        if S^.E2 <> nil then
        begin
          PushK('rax', 1);
          EmitExpr(S^.E2);
          Line('  movq %rax, %rsi');
          Line('  popq %rdi');
        end
        else
        begin
          Line('  movq %rax, %rdi');
          Line('  xorl %esi, %esi');
        end;
        Line('  call rt_raiseobj');
      end;
    skTry:
      if S^.Name = 'epilogue' then
      begin
        { a handler's body (P122): ElseSt after it, and before an exit,
          break or continue out of it; no record }
        PushEpi(S^.ElseSt);
        EmitStmt(S^.ThenSt);
        PopTry;
        EmitStmt(S^.ElseSt);
      end
      else
      begin
        a := Lab;
        b := Lab;
        { The record: the previous one, rbp, the stack pointer to go back
          to (stack addresses a moved stack adjusts) and the handler. }
        MapHint4(1, 1, 1, 0);
        Line('  subq $32, %rsp');
        Line('  movq 224(%r14), %rax');
        Line('  movq %rax, (%rsp)');
        Line('  movq %rbp, 8(%rsp)');
        Line('  leaq 32(%rsp), %rax');
        Line('  movq %rax, 16(%rsp)');
        Line('  leaq ' + a + '(%rip), %rax');
        Line('  movq %rax, 24(%rsp)');
        Line('  movq %rsp, 224(%r14)');
        if S^.Name = 'finally' then
          PushTry(S^.ElseSt)
        else
          PushTry(nil);
        EmitStmt(S^.ThenSt);
        PopTry;
        Line('  movq (%rsp), %rax');
        Line('  movq %rax, 224(%r14)');
        Line('  addq $32, %rsp');
        if S^.Name = 'finally' then
          EmitStmt(S^.ElseSt);
        Line('  jmp ' + b);
        Line(a + ':');
        EmitStmt(S^.ElseSt);
        if S^.Name = 'finally' then
          Line('  call rt_raise');
        Line(b + ':');
      end;
    skIf:
      { a word's assignment as a select (P307) }
      if EmitSelectIf(S) then
      else if (S^.ElseSt = nil) and DirectJump(S^.ThenSt, c) then
      begin
        if not JccTrue(S^.E, c) then
        begin
          EmitExpr(S^.E);
          Line('  testq %rax, %rax');
          Line('  jnz ' + c);
        end;
      end
      else
      begin
        a := Lab;
        b := Lab;
        if not FastJcc(S^.E, a) then
        begin
          EmitExpr(S^.E);
          Line('  testq %rax, %rax');
          Line('  jz ' + a);
        end;
        EmitStmt(S^.ThenSt);
        { no else: nothing to jump over, where every pass through the
          then took a jump to the next instruction (P305) }
        if NoStmt(S^.ElseSt) then
          Line(a + ':')
        else
        begin
          Line('  jmp ' + b);
          Line(a + ':');
          EmitStmt(S^.ElseSt);
          Line(b + ':');
        end;
      end;
    skWhile:
      if not EmitLoopRun(S) then
      begin
        { Rotated: the test is at the bottom and branches back while it
          holds, one branch a turn; it keeps the while's line (P93). }
        a := Lab;
        b := Lab;
        c := Lab;
        PushLoop(b, c);
        Line('  jmp ' + c);
        AlignLoop;
        Line(a + ':');
        EmitStmt(S^.Body);
        Line(c + ':');
        EmitLoc(S^.Line);
        EmitStackCheck(c, '16');
        if not JccTrue(S^.E, a) then
        begin
          EmitExpr(S^.E);
          Line('  testq %rax, %rax');
          Line('  jnz ' + a);
        end;
        Line(b + ':');
        PopLoop;
      end;
    skRepeat:
      if not EmitLoopRun(S) then
      begin
        a := Lab;
        b := Lab;
        PushLoop(b, a);
        AlignLoop;
        Line(a + ':');
        EmitStackCheck(a, '16');
        EmitStmt(S^.Body);
        if FDaOn and (S^.DaGen = FDaGen) then
          FCurDa := S^.Da2;
        if not FastJcc(S^.E, a) then
        begin
          EmitExpr(S^.E);
          Line('  testq %rax, %rax');
          Line('  jz ' + a);
        end;
        Line(b + ':');
        PopLoop;
      end;
    skWith:
      EmitStmt(S^.Body);
    skForIn:
      begin
        if (S^.E <> nil) and IsStr(S^.E^.Typ) then
          EmitForRunes(S)
        else if (S^.E <> nil) and ((TKind(S^.E^.Typ) = tykTree) or
          ((S^.E^.Kind = ekCall) and (S^.E^.Name = 'rt_treerange'))) then
          EmitTreeFor(S)
        else if (S^.E <> nil) and (TKind(S^.E^.Typ) = tykMap) then
        begin
          a := Lab;
          b := Lab;
          PushLoop(b, a);
          { The iterator lives in 32 bytes below the frame. Each step
            returns the key slot; the value follows the key. }
          { Its first word is the copy of the directory (P96). }
          MapHint4(1, 0, 0, 0);
          Line('  subq $32, %rsp');
          Line('  movq $0, (%rsp)');
          Line('  movq $0, 8(%rsp)');
          Line('  movq $0, 16(%rsp)');
          Line('  movq $0, 24(%rsp)');
          Line(a + ':');
          EmitExpr(S^.E);
          Line('  movq %rax, %rdi');
          Line('  movq %rsp, %rsi');
          Line('  leaq .LdescMap_' + IntToStr(S^.E^.Typ) + '(%rip), %rdx');
          Line('  call p_pasmap_pasmapnext');
          Line('  testq %rax, %rax');
          Line('  jz ' + b);
          PushK('rax', 1);
          vs := FindSym(S^.Name);
          EmitAddr(NewVar(S^.Name, FTypes[S^.E^.Typ].Elem));
          Line('  movq %rax, %rdi');
          Line('  movq (%rsp), %rsi');
          Line('  movq $' + IntToStr(TSize(vs.Typ)) + ', %rcx');
          Line('  call rt_memcpy');
          { The loop's key and value share the map's strings (1.0.82). }
          smap := StrMap(FTypes[S^.E^.Typ].Elem);
          if smap <> '' then
          begin
            EmitAddr(NewVar(S^.Name, FTypes[S^.E^.Typ].Elem));
            Line('  movq %rax, %rdi');
            Line('  leaq ' + smap + '(%rip), %rsi');
            Line('  call rt_strshare');
          end;
          if S^.Dest <> nil then
          begin
            EmitAddr(S^.Dest);
            Line('  movq %rax, %rdi');
            Line('  movq (%rsp), %rsi');
            if IsStr(FTypes[S^.E^.Typ].Elem) then
              Line('  addq $16, %rsi')
            else
              Line('  addq $8, %rsi');
            Line('  movq $' + IntToStr(TSize(FTypes[S^.E^.Typ].Elem2)) + ', %rcx');
            Line('  call rt_memcpy');
            smap := StrMap(FTypes[S^.E^.Typ].Elem2);
            if smap <> '' then
            begin
              EmitAddr(S^.Dest);
              Line('  movq %rax, %rdi');
              Line('  leaq ' + smap + '(%rip), %rsi');
              Line('  call rt_strshare');
            end;
          end;
          Line('  addq $8, %rsp');
          EmitStmt(S^.Body);
          Line('  jmp ' + a);
          Line(b + ':');
          Line('  addq $32, %rsp');
          PopLoop;
        end
        else
        begin
        EmitSetFor(S);
        end;
      end;
    skFor:
      if FDebug or not ForAcc(S) then
        EmitFor(S);
    skCase:
      begin
        b := Lab;
        so := 0;
        if IsStr(S^.E^.Typ) then
          so := ScratchT(16, S^.E^.Typ);
        EmitExpr(S^.E);
        if IsStr(S^.E^.Typ) then
        begin
          Line('  movq %rax, ' + IntToStr(so) + '(%rbp)');
          Line('  movq %rdx, ' + IntToStr(so + 8) + '(%rbp)');
        end;
        for i := 0 to High(S^.Arms) do
        begin
          a := Lab;
          c := Lab;
          { A string label compares the whole string; a range is two
            compares; a label beyond 32 bits goes through rcx: cmpq takes
            a 32-bit immediate (1.0.78). }
          { the arm's last test goes past it when it fails, so a match
            falls into the arm, where it jumped over a jump (P305) }
          ns := Length(S^.Arms[i].Strs);
          nv := Length(S^.Arms[i].Vals);
          for j := 0 to ns - 1 do
          begin
            Line('  movq ' + IntToStr(so) + '(%rbp), %rdi');
            Line('  movq ' + IntToStr(so + 8) + '(%rbp), %rsi');
            Line('  leaq ' + InternStr(S^.Arms[i].Strs[j]) + '(%rip), %rdx');
            Line('  movq $' + IntToStr(Length(S^.Arms[i].Strs[j])) + ', %rcx');
            Line('  call rt_streq');
            Line('  testq %rax, %rax');
            if (j = ns - 1) and (nv = 0) then
              Line('  jz ' + c)
            else
              Line('  jnz ' + a);
          end;
          for j := 0 to nv - 1 do
            if (j <= High(S^.Arms[i].His)) and (S^.Arms[i].His[j] <> S^.Arms[i].Vals[j]) then
            begin
              d := Lab;
              if j = nv - 1 then
                d := c;
              CaseCmp(S^.Arms[i].Vals[j]);
              Line('  jl ' + d);
              CaseCmp(S^.Arms[i].His[j]);
              if j = nv - 1 then
                Line('  jg ' + c)
              else
              begin
                Line('  jle ' + a);
                Line(d + ':');
              end;
            end
            else
            begin
              CaseCmp(S^.Arms[i].Vals[j]);
              if j = nv - 1 then
                Line('  jne ' + c)
              else
                Line('  je ' + a);
            end;
          if ns + nv = 0 then
            Line('  jmp ' + c);
          Line(a + ':');
          EmitStmt(S^.Arms[i].Body);
          { the last arm without an else falls to the end (P305) }
          if (i < High(S^.Arms)) or not NoStmt(S^.ElseSt) then
            Line('  jmp ' + b);
          Line(c + ':');
        end;
        EmitStmt(S^.ElseSt);
        Line(b + ':');
      end;
    skExit:
      begin
        if S^.E <> nil then
        begin
          EmitExpr(S^.E);
          if FHasRes and (FResReg <> '') then
          begin
            if FResReg <> 'rax' then
              Line('  movq %rax, %' + FResReg);
          end
          else if FHasRes then
            Line('  movq %rax, ' + IntToStr(FResOff) + '(%rbp)');
        end;
        UnwindTry(0);
        Line('  jmp ' + FEpi);
      end;
    skHalt:
      begin
        if S^.E <> nil then
          EmitExpr(S^.E)
        else
          Line('  xorq %rax, %rax');
        Line('  movq %rax, %rdi');
        Line('  movq $231, %rax');
        Line('  syscall');
      end;
    skInc, skDec:
      if (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) and
        (FindSym(S^.Dest^.Name).Reg <> '') then
      begin
        vs := FindSym(S^.Dest^.Name);
        if (S^.E <> nil) and (S^.E^.Kind = ekInt) and Fits32(S^.E^.Num) then
        begin
          if S^.Kind = skInc then
            Line('  addq $' + IntToStr(S^.E^.Num) + ', %' + vs.Reg)
          else
            Line('  subq $' + IntToStr(S^.E^.Num) + ', %' + vs.Reg);
        end
        else
        begin
          EmitExpr(S^.E);
          if S^.Kind = skInc then
            Line('  addq %rax, %' + vs.Reg)
          else
            Line('  subq %rax, %' + vs.Reg);
        end;
        CanonReg(vs.Reg, vs.Typ);
      end
      else
      begin
        EmitExpr(S^.E);
        PushK('rax', VCls(S^.E^.Typ, 0));
        FAddrWrite := True;
        EmitAddr(S^.Dest);
        { the place's operand, which the pop and the sum leave (P329) }
        op := AddrOp('rcx,rdx,rsp');
        Line('  popq %rcx');
        if (TSize(LoadTyp(S^.Dest)) < 8) or IsNarrowId(LoadTyp(S^.Dest)) then
        begin
          { At the stored width, so a packed neighbour stays; a narrow
            integer wraps (P99). }
          LoadTo(op, LoadTyp(S^.Dest), 'rdx');
          if S^.Kind = skInc then
            Line('  addq %rcx, %rdx')
          else
            Line('  subq %rcx, %rdx');
          CanonReg('rdx', LoadTyp(S^.Dest));
          StoreFrom(op, TSize(LoadTyp(S^.Dest)), 'rdx');
        end
        else
        begin
          if S^.Kind = skInc then
            Line('  addq %rcx, ' + op)
          else
            Line('  subq %rcx, ' + op);
        end;
      end;
    skAsm:
      EmitAsmX(S);
    skBreak:
      begin
        if Length(FBrk) = 0 then
          Die('break not in loop');
        UnwindTry(LongInt(Length(FBrk)));
        Line('  jmp ' + FBrk[High(FBrk)]);
      end;
    skContinue:
      begin
        if Length(FCont) = 0 then
          Die('continue not in loop');
        UnwindTry(LongInt(Length(FBrk)));
        Line('  jmp ' + FCont[High(FCont)]);
      end;
  end;
end;

{ P93: a loop without calls keeps its integer variables in registers.

  A loop qualifies when nothing in it calls: no routine, no runtime
  helper, no string or real arithmetic, so the only code that can run
  between two of its instructions is rt_morestack at a loop head. That
  path keeps the callee-saved registers (rt_newstack saves them, a
  preempted routine gets them back through .pk_res), and every loop
  head spills the variables the loop writes before it calls
  rt_morestack and reloads all of them afterwards, so a growing stack
  relocates their homes as it relocates any frame word, and the frame
  is the truth whenever the runtime looks. The loop borrows rbx, r12,
  r13 and r15 (x19 to x26 on arm64), saves what they held in frame
  slots at the top of the scratch area, and restores them at its one
  exit, which every way out of the loop reaches (a break jumps to it,
  exit and raise are not allowed inside). A variable whose address is
  taken anywhere in the compilation stays in memory. A global the loop
  only reads is reloaded at every slow path, so a write by another
  routine reaches the loop within one sysmon tick (10 ms), without the
  loop writing it back. }

function TEmitter.TryFindSym(const N: string; out S: TSym): Boolean;
var
  i: SizeInt;
begin
  Result := True;
  if FHasRes then
    if SameSym(N, 'result') or SameSym(N, FResName) then
    begin
      S := FindSym(N);
      Exit;
    end;
  for i := High(FSym) downto 0 do
    if (not FSym[i].Global) and SameSym(FSym[i].Name, N) then
    begin
      S := FSym[i];
      Exit;
    end;
  for i := 0 to High(FSym) do
    if SameSym(FSym[i].Name, N) then
    begin
      S := FSym[i];
      Exit;
    end;
  Result := False;
end;

function TEmitter.AddrKept(const N: string): Boolean;
begin
  Result := InNames(FAddrKept, ToLower(N));
end;

{ N is a global of another unit (1.0.136). }
function TEmitter.ExtGlobal(const N: string): Boolean;
begin
  Result := InNames(FExtVars, ToLower(N));
end;

function TEmitter.AddrTaken(const N: string): Boolean;
var
  i: SizeInt;
  l: string;
begin
  Result := False;
  l := ToLower(N);
  for i := 0 to High(FAddrNames) do
    if FAddrNames[i] = l then
    begin
      Result := True;
      Exit;
    end;
end;

{ Whether S's address is taken where S can be reached (1.0.128): a
  global's anywhere in the compilation, a local's in its own routine and
  those nested in it. The names were one list for the whole compilation,
  so a routine that took the address of its own acc kept every other
  routine's acc out of a register. }
function TEmitter.AddrTakenSym(const S: TSym): Boolean;
begin
  if S.Global then
    Result := AddrTaken(S.Name)
  else
    Result := LocAddrTaken(S.Name);
end;

function TEmitter.LocAddrTaken(const N: string): Boolean;
var
  i: SizeInt;
  l: string;
begin
  Result := False;
  l := ToLower(N);
  for i := 0 to High(FLocAddr) do
    if FLocAddr[i] = l then
    begin
      Result := True;
      Exit;
    end;
end;

procedure TEmitter.ScanAddrE(E: PExpr);
var
  i, n: SizeInt;
begin
  if E = nil then
    Exit;
  if (E^.Kind = ekAddr) and (E^.L <> nil) and (E^.L^.Kind = ekVar) then
  begin
    if not AddrTaken(E^.L^.Name) then
    begin
      n := Length(FAddrNames);
      SetLength(FAddrNames, n + 1);
      FAddrNames[n] := ToLower(E^.L^.Name);
    end;
    if not AddrKept(E^.L^.Name) then
      AddName(FAddrKept, ToLower(E^.L^.Name));
  end;
  ScanAddrE(E^.L);
  ScanAddrE(E^.R);
  for i := 0 to High(E^.Args) do
    ScanAddrE(E^.Args[i]);
end;

procedure TEmitter.ScanAddrS(S: PStmt);
var
  i, n: SizeInt;
  a: PExpr;
begin
  if S = nil then
    Exit;
  ScanAddrE(S^.E);
  ScanAddrE(S^.E2);
  ScanAddrE(S^.Dest);
  for i := 0 to High(S^.Args) do
  begin
    a := S^.Args[i];
    { SetLength, Move and FillChar use the address and keep none: the
      variable's address is taken, not kept (P100). }
    if (S^.Kind = skCall) and ((S^.Name = 'rt_setlength') or
      (S^.Name = 'rt_move') or (S^.Name = 'rt_fillchar')) and (a <> nil) and
      (a^.Kind = ekAddr) and (a^.L <> nil) and (a^.L^.Kind = ekVar) then
    begin
      if not AddrTaken(a^.L^.Name) then
      begin
        n := Length(FAddrNames);
        SetLength(FAddrNames, n + 1);
        FAddrNames[n] := ToLower(a^.L^.Name);
      end;
      ScanAddrE(a^.L);
    end
    else
      ScanAddrE(a);
  end;
  ScanAddrS(S^.ThenSt);
  ScanAddrS(S^.ElseSt);
  ScanAddrS(S^.Body);
  for i := 0 to High(S^.Stmts) do
    ScanAddrS(S^.Stmts[i]);
  for i := 0 to High(S^.Arms) do
    ScanAddrS(S^.Arms[i].Body);
  for i := 0 to High(S^.Sels) do
  begin
    ScanAddrE(S^.Sels[i].Chan);
    ScanAddrE(S^.Sels[i].ValX);
    ScanAddrS(S^.Sels[i].Body);
  end;
end;

{ A name a body uses (P293): to FNestNames, or to the hash set FRoutTab
  when FNameSink is 1 (FNV-1a over the name in lower case, open
  addressing, doubled at half full). }
procedure TEmitter.NoteName(const N: string);
var
  l: string;
  h, i, m: SizeInt;
  hv: Int64;
  old: TStrArray;
begin
  if N = '' then
    Exit;
  l := ToLower(N);
  if FNameSink = 0 then
  begin
    if not InNames(FNestNames, l) then
      AddName(FNestNames, l);
    Exit;
  end;
  if FRoutTabN * 2 >= Length(FRoutTab) then
  begin
    old := FRoutTab;
    m := Length(old) * 2;
    if m < 1024 then
      m := 1024;
    FRoutTab := nil;
    SetLength(FRoutTab, m);
    FRoutTabN := 0;
    for i := 0 to High(old) do
      if old[i] <> '' then
        NoteName(old[i]);
  end;
  m := Length(FRoutTab);
  hv := 2166136261;
  for i := 1 to Length(l) do
    hv := ((hv xor Int64(Ord(l[i]))) * 16777619) and 4294967295;
  h := SizeInt(hv and Int64(m - 1));
  while FRoutTab[h] <> '' do
  begin
    if FRoutTab[h] = l then
      Exit;
    h := (h + 1) and (m - 1);
  end;
  FRoutTab[h] := l;
  Inc(FRoutTabN);
end;

{ N is in FRoutTab: some routine of the program uses the name. }
function TEmitter.RoutNamed(const N: string): Boolean;
var
  l: string;
  h, i, m: SizeInt;
  hv: Int64;
begin
  Result := False;
  m := Length(FRoutTab);
  if m = 0 then
    Exit;
  l := ToLower(N);
  hv := 2166136261;
  for i := 1 to Length(l) do
    hv := ((hv xor Int64(Ord(l[i]))) * 16777619) and 4294967295;
  h := SizeInt(hv and Int64(m - 1));
  while FRoutTab[h] <> '' do
  begin
    if FRoutTab[h] = l then
    begin
      Result := True;
      Exit;
    end;
    h := (h + 1) and (m - 1);
  end;
end;

procedure TEmitter.NameScanE(E: PExpr);
var
  i: SizeInt;
begin
  if E = nil then
    Exit;
  if (E^.Kind = ekVar) or (E^.Kind = ekCall) then
    NoteName(E^.Name);
  NameScanE(E^.L);
  NameScanE(E^.R);
  for i := 0 to High(E^.Args) do
    NameScanE(E^.Args[i]);
end;

procedure TEmitter.NameScanS(S: PStmt);
var
  i: SizeInt;
begin
  if S = nil then
    Exit;
  NoteName(S^.Name);
  NameScanE(S^.E);
  NameScanE(S^.E2);
  NameScanE(S^.Dest);
  for i := 0 to High(S^.Args) do
    NameScanE(S^.Args[i]);
  NameScanS(S^.ThenSt);
  NameScanS(S^.ElseSt);
  NameScanS(S^.Body);
  for i := 0 to High(S^.Stmts) do
    NameScanS(S^.Stmts[i]);
  for i := 0 to High(S^.Arms) do
    NameScanS(S^.Arms[i].Body);
  for i := 0 to High(S^.Sels) do
  begin
    NameScanE(S^.Sels[i].Chan);
    NameScanE(S^.Sels[i].ValX);
    NoteName(S^.Sels[i].Dest);
    NameScanS(S^.Sels[i].Body);
  end;
end;

{ A program's global no routine names, once: the routines' names in
  FRoutTab. A routine with asm may name anything in its text, so then
  every name counts as used. }
function TEmitter.GlobalOwnedByMain(const N: string): Boolean;
var
  i: SizeInt;
begin
  if not FRoutTabOn then
  begin
    FRoutTabOn := True;
    FRoutTab := nil;
    FRoutTabN := 0;
    FNameSink := 1;
    NoteName('$');
    for i := 0 to High(FProgProcs) do
    begin
      if HasAsm(FProgProcs[i].Body) then
        NoteName('$asm');
      NameScanS(FProgProcs[i].Body);
    end;
    FNameSink := 0;
  end;
  Result := (not RoutNamed('$asm')) and not RoutNamed(N);
end;

{ A variable a loop may keep in a register: an 8-byte integer, enum or
  subrange of this frame or a program global, passed by value, whose
  address nobody takes. A unit's globals stay home: an importer may
  hold their address. }
function TEmitter.PromoCand(const S: TSym): Boolean;
var
  k: TTypeKind;
begin
  Result := False;
  { A narrow integer too (P100): the register keeps it clean. }
  if S.ByRef or (S.Up <> 0) or ((TSize(S.Typ) <> 8) and not IsNarrowId(S.Typ)) then
    Exit;
  if IsFat(S.Typ) or IsBlob(S.Typ) then
    Exit;
  { An integer, a Boolean, a pointer or a class reference (P96): the
    slow path spills and reloads, so a pointer into a stack that moves
    is relocated in its home and comes back relocated. }
  k := TKind(S.Typ);
  if (k <> tykInteger) and (k <> tykEnum) and (k <> tykSubrange) and
    (k <> tykBoolean) and (k <> tykPointer) and (k <> tykClass) then
    Exit;
  { a unit's global stays in memory while the unit compiles, and another
    unit's global in a program too (1.0.136): that unit may have taken
    its address, which this compilation cannot see }
  if S.Global and (FIsUnit or ExtGlobal(S.Name)) then
    Exit;
  { a register no other routine's write reaches (P293): a signal that
    stops a loop keeps its registers, where the loop's test reloaded
    them from home; so a program global is kept in the main block only
    and only when no routine names it, a local not when a routine
    nested in this one names it, and nothing in a closure's box }
  if S.Global and ((not FInMain) or not GlobalOwnedByMain(S.Name)) then
    Exit;
  if (not S.Global) and InNames(FNestNames, ToLower(S.Name)) then
    Exit;
  if S.Boxed then
    Exit;
  if AddrTakenSym(S) then
    Exit;
  if (not S.Global) and FHasRes and (S.Off = FResOff) and
    (LocAddrTaken('result') or LocAddrTaken(FResName)) then
    Exit;
  Result := True;
end;

{ A value a promoted loop may store with a plain move: one byte or one
  word, not a string, a slice, a record, a real or a pair. }
function TEmitter.PromoScalar(Typ: LongInt): Boolean;
var
  k: TTypeKind;
begin
  Result := False;
  if IsFat(Typ) or IsBlob(Typ) then
    Exit;
  k := TKind(Typ);
  if (k = tykReal) or (k = tykInterface) or (k = tykMethod) then
    Exit;
  if (TSize(Typ) <> 8) and (TSize(Typ) <> 1) and (TSize(Typ) <> 2) and
    (TSize(Typ) <> 4) then
    Exit;
  Result := True;
end;

function TEmitter.PromoConst(E: PExpr): Boolean;
begin
  Result := False;
  if E = nil then
    Exit;
  if E^.Kind = ekInt then
    Result := True
  else if E^.Kind = ekStr then
    Result := Length(E^.Txt) = 1
  else if E^.Kind = ekRange then
    Result := PromoConst(E^.L) and PromoConst(E^.R);
end;

{ An expression that compiles without a call. A set constructor builds
  in rbx, r12 and r13 (x19, x20, x22), which it saves and restores, so it
  may only name constants: an element that read a promoted variable
  would read the half-built set instead. }
function TEmitter.PromoExprOK(E: PExpr): Boolean;
var
  i: SizeInt;
begin
  Result := True;
  if E = nil then
    Exit;
  Result := False;
  if PtrAccess(E) then
    Exit;
  case E^.Kind of
    ekInt, ekNil, ekStr, ekVar:
      Result := True;
    ekUn:
      Result := PromoExprOK(E^.L);
    ekBin:
      begin
        if (E^.L = nil) or (E^.R = nil) then
          Exit;
        if (E^.Bin = boConcat) or (E^.Bin = boIs) or (E^.Bin = boAs) or
          (E^.Bin = boSlash) then
          Exit;
        if RealBin(E) then
          Exit;
        if IsStr(E^.L^.Typ) and IsStr(E^.R^.Typ) then
          Exit;
        Result := PromoExprOK(E^.L) and PromoExprOK(E^.R);
      end;
    ekIndex:
      Result := PromoExprOK(E^.L) and PromoExprOK(E^.R);
    ekField, ekDeref:
      Result := PromoExprOK(E^.L);
    ekSet:
      begin
        for i := 0 to High(E^.Args) do
          if not PromoConst(E^.Args[i]) then
            Exit;
        Result := True;
      end;
    ekCall:
      if (E^.Name = 'rt_length') or (E^.Name = 'rt_high') or
        (E^.Name = 'rt_low') or (E^.Name = 'rt_odd') or
        (E^.Name = 'rt_absint') or (E^.Name = 'rt_bitchk') or (E^.Name = 'rt_rot') or
        (E^.Name = 'rt_funnel') or (E^.Name = 'rt_carry') then
      begin
        for i := 0 to High(E^.Args) do
          if not PromoExprOK(E^.Args[i]) then
            Exit;
        Result := True;
      end
      else if VecRed(E) then
        Result := VecPure(E);
  end;
end;

function TEmitter.PromoLValOK(D: PExpr): Boolean;
var
  s: TSym;
begin
  Result := False;
  if D = nil then
    Exit;
  if not PromoScalar(D^.Typ) then
    Exit;
  if PtrAccess(D) then
    Exit;
  case D^.Kind of
    ekVar:
      if TryFindSym(D^.Name, s) then
        Result := PromoScalar(s.Typ);
    ekIndex:
      Result := PromoExprOK(D^.L) and PromoExprOK(D^.R);
    ekField, ekDeref:
      Result := PromoExprOK(D^.L);
  end;
end;

{ S compiles without a call. A break or a continue must stay inside the
  region: it may only name a loop of S itself (InLoop), else it would
  leave without storing the registers back (P96). }
function TEmitter.PromoStmtOK(S: PStmt; InLoop: Boolean): Boolean;
var
  i: SizeInt;
  sy: TSym;
begin
  Result := True;
  if S = nil then
    Exit;
  Result := False;
  case S^.Kind of
    skBlock:
      begin
        for i := 0 to High(S^.Stmts) do
          if not PromoStmtOK(S^.Stmts[i], InLoop) then
            Exit;
        Result := True;
      end;
    skAssign:
      begin
        { s := s + c, its call after the ret with the registers kept
          around it (P301) }
        if PromoAppendOK(S) then
        begin
          Result := True;
          Exit;
        end;
        { a vector statement with no call in it (1.0.128) }
        if VecOp(S^.E) then
        begin
          Result := VecPure(S^.E) and (S^.Dest <> nil) and VecDestPure(S^.Dest);
          Exit;
        end;
        if VecCopy(S) then
        begin
          Result := True;
          Exit;
        end;
        if not PromoExprOK(S^.E) then
          Exit;
        if S^.Dest <> nil then
          Result := PromoLValOK(S^.Dest)
        else if TryFindSym(S^.Name, sy) then
          Result := PromoScalar(sy.Typ);
      end;
    skIf:
      Result := PromoExprOK(S^.E) and PromoStmtOK(S^.ThenSt, InLoop) and
        PromoStmtOK(S^.ElseSt, InLoop);
    skWhile, skRepeat:
      Result := PromoExprOK(S^.E) and PromoStmtOK(S^.Body, True);
    skExit:
      { a routine with no frame leaves by its epilogue, its variables in
        registers and nowhere else (P296): Exit and Exit(value); a region
        stores its variables home first, so it takes none }
      Result := FFlatCheck and ((S^.E = nil) or PromoExprOK(S^.E));
    skFor:
      begin
        if (S^.Name = '') or (S^.E = nil) or (S^.E2 = nil) then
          Exit;
        if not TryFindSym(S^.Name, sy) then
          Exit;
        if not PromoScalar(sy.Typ) then
          Exit;
        Result := PromoExprOK(S^.E) and PromoExprOK(S^.E2) and
          PromoStmtOK(S^.Body, True);
      end;
    skCase:
      begin
        if not PromoExprOK(S^.E) then
          Exit;
        for i := 0 to High(S^.Arms) do
          if not PromoStmtOK(S^.Arms[i].Body, InLoop) then
            Exit;
        Result := PromoStmtOK(S^.ElseSt, InLoop);
      end;
    skInc, skDec:
      Result := PromoExprOK(S^.E) and PromoLValOK(S^.Dest);
    skBreak, skContinue:
      Result := InLoop;
    skWith:
      Result := PromoStmtOK(S^.Body, InLoop);
    skCall:
      { FillChar, its call on a slow path or keeping the registers
        (P301) }
      if PromoFillOK(S) then
        Result := True
      { Carry's words touch no register a promoted variable holds
        (1.0.129) }
      else if (S^.E = nil) and ((S^.Name = 'rt_carryon') or (S^.Name = 'rt_carryoff') or
        (S^.Name = 'rt_carryflip') or (S^.Name = 'rt_setcarry') or (S^.Name = 'rt_rot') or
        (S^.Name = 'rt_funnel')) then
      begin
        for i := 0 to High(S^.Args) do
          if not PromoExprOK(S^.Args[i]) then
            Exit;
        Result := True;
      end;
  end;
end;

procedure TEmitter.PromoAdd(const N: string; W: Boolean; Weight: LongInt);
var
  s: TSym;
  i, k: SizeInt;
begin
  if not TryFindSym(N, s) then
    Exit;
  if not PromoCand(s) then
    Exit;
  for i := 0 to High(FPromo) do
    if (FPromo[i].Place.Global = s.Global) and SamePlace(FPromo[i].Place, s) then
    begin
      FPromo[i].Refs := FPromo[i].Refs + Weight;
      if W then
        FPromo[i].Written := True;
      Exit;
    end;
  k := Length(FPromo);
  SetLength(FPromo, k + 1);
  FPromo[k].Place := s;
  FPromo[k].Place.Reg := '';
  FPromo[k].Reg := '';
  FPromo[k].Dw := 0;
  FPromo[k].Written := W;
  FPromo[k].Refs := Weight;
  FPromo[k].Save := 0;
  FPromo[k].Keep := False;
  FPromo[k].Part := 0;
end;

{ Carry used in a region (1.0.130): Part 9, its home G+256. }
procedure TEmitter.PromoAddCarry(W: Boolean; Weight: LongInt);
var
  i, k: SizeInt;
begin
  for i := 0 to High(FPromo) do
    if FPromo[i].Part = 9 then
    begin
      FPromo[i].Refs := FPromo[i].Refs + Weight;
      if W then
        FPromo[i].Written := True;
      Exit;
    end;
  FCarrySym.Name := '$carry';
  FCarrySym.Global := True;
  k := Length(FPromo);
  SetLength(FPromo, k + 1);
  FPromo[k].Place := FCarrySym;
  FPromo[k].Reg := '';
  FPromo[k].Dw := 0;
  FPromo[k].Written := W;
  FPromo[k].Refs := Weight;
  FPromo[k].Save := 0;
  FPromo[k].Keep := False;
  FPromo[k].Part := 9;
end;

{ A slice a loop only reads (P100): its pointer word (Part 1) and its
  length (Part 2) do not change there, so a register can keep each; the
  loop reloaded them from memory at every element. A slice the region
  assigns, or whose address is taken, is dropped after the scan. }
procedure TEmitter.PromoAddPart(const N: string; Part, Weight: LongInt);
var
  s: TSym;
  i, k: SizeInt;
begin
  if not TryFindSym(N, s) then
    Exit;
  { a var parameter's address (Part 4, P282): its slot does not change
    in a region, so a register keeps it, and a field of it is read
    through that register, where every read loaded the slot first }
  if Part = 4 then
  begin
    if (not s.ByRef) or (s.Up <> 0) or s.Global or s.Boxed then
      Exit;
  end
  else if s.ByRef or (s.Up <> 0) then
    Exit;
  { arm64 forms a static array's address in two or three instructions
    (adrp and add, or the frame offset and an add); a loop keeps it. }
  if Part = 3 then
  begin
    if (not FArm) or IsDyn(s.Typ) or IsStr(s.Typ) or (TKind(s.Typ) <> tykArray) then
      Exit;
  end
  else if Part = 4 then
  else if (not IsDyn(s.Typ)) or AddrKept(s.Name) then
    Exit;
  if s.Global and (FIsUnit or ExtGlobal(s.Name)) then
    Exit;
  for i := 0 to High(FPromo) do
    if (FPromo[i].Part = Part) and (FPromo[i].Place.Global = s.Global) and
      SamePlace(FPromo[i].Place, s) then
    begin
      FPromo[i].Refs := FPromo[i].Refs + Weight;
      Exit;
    end;
  k := Length(FPromo);
  SetLength(FPromo, k + 1);
  FPromo[k].Place := s;
  FPromo[k].Place.Reg := '';
  FPromo[k].Reg := '';
  FPromo[k].Dw := 0;
  FPromo[k].Written := False;
  FPromo[k].Refs := Weight;
  FPromo[k].Save := 0;
  FPromo[k].Keep := False;
  FPromo[k].Part := Part;
end;

{ A slice's pointer word (Part 1) or length (Part 2) into Reg, or a
  static array's address (Part 3, arm64), worked out again after a slow
  path that may have moved the stack. }
procedure TEmitter.LoadHomePart(const S: TSym; Part: LongInt; const Reg: string);
var
  d: LongInt;
begin
  if Part = 9 then
  begin
    if FArm then
      Line('  ldrb w' + Copy(Reg, 2, 8) + ', [x28, #256]')
    else
      Line('  movzbl 256(%r14), %' + X86Sub(Reg, 4));
    Exit;
  end;
  if Part = 4 then
  begin
    { a var parameter's address, from its slot }
    if FArm then
      LdFP(Reg, S.Off)
    else
      Line('  movq ' + IntToStr(S.Off) + '(%rbp), %' + Reg);
    Exit;
  end;
  if Part = 3 then
  begin
    if FArm then
    begin
      if S.Global then
        LeaS(VarLabel(S.Name), Reg)
      else
      begin
        AddFP(Reg, S.Off);
      end;
    end
    else if S.Global then
      Line('  leaq ' + VarLabel(S.Name) + '(%rip), %' + Reg)
    else
      Line('  leaq ' + IntToStr(S.Off) + '(%rbp), %' + Reg);
    Exit;
  end;
  d := 8 * (Part - 1);
  if FArm then
  begin
    if S.Global then
    begin
      LeaS(VarLabel(S.Name), 'x16');
      Line('  ldr ' + Reg + ', [x16, #' + IntToStr(d) + ']');
    end
    else
      LdFP(Reg, S.Off + d);
  end
  else if S.Global then
    Line('  movq ' + VarLabel(S.Name) + '+' + IntToStr(d) + '(%rip), %' + Reg)
  else
    Line('  movq ' + IntToStr(S.Off + d) + '(%rbp), %' + Reg);
end;

{ The register a promoted region keeps part Part of slice S in, or ''. }
function TEmitter.PartReg(const S: TSym; Part: LongInt): string;
var
  i: SizeInt;
begin
  Result := '';
  if not FPromoOn then
    Exit;
  for i := 0 to High(FPromo) do
    if (FPromo[i].Part = Part) and (FPromo[i].Place.Global = S.Global) and
      SamePlace(FPromo[i].Place, S) then
    begin
      Result := FPromo[i].Reg;
      Exit;
    end;
end;

procedure TEmitter.PromoScanE(E: PExpr; Weight: LongInt);
var
  i: SizeInt;
begin
  if E = nil then
    Exit;
  if E^.Kind = ekVar then
    PromoAdd(E^.Name, False, Weight);
  if (E^.Kind = ekCall) and (E^.Name = 'rt_carry') then
    PromoAddCarry(False, Weight);
  if (E^.Kind = ekCall) and (E^.Name = 'rt_rot') and (Length(E^.Args) = 4) and
    (((E^.Args[2]^.Num >= 1) and (E^.Args[2]^.Num <= 4)) or
    ((E^.Args[2]^.Num >= 8) and (E^.Args[2]^.Num <= 10))) then
    PromoAddCarry(True, Weight);
  if (E^.Kind = ekIndex) and (E^.L <> nil) and (E^.L^.Kind = ekVar) then
  begin
    PromoAddPart(E^.L^.Name, 1, Weight);
    PromoAddPart(E^.L^.Name, 2, Weight);
    PromoAddPart(E^.L^.Name, 3, Weight);
  end;
  { a class's field is read through the object, not the variable's
    address }
  if (E^.Kind = ekField) and (E^.L <> nil) and (E^.L^.Kind = ekVar) and
    (TKind(E^.L^.Typ) <> tykClass) then
    PromoAddPart(E^.L^.Name, 4, Weight);
  PromoScanE(E^.L, Weight);
  PromoScanE(E^.R, Weight);
  for i := 0 to High(E^.Args) do
    PromoScanE(E^.Args[i], Weight);
end;

procedure TEmitter.PromoScanS(S: PStmt; Weight: LongInt);
var
  i: SizeInt;
  w: LongInt;
begin
  if S = nil then
    Exit;
  w := Weight;
  if ((S^.Kind = skWhile) or (S^.Kind = skRepeat) or (S^.Kind = skFor)) and
    (w < 100000) then
    w := w * 8;
  if S^.Kind = skAssign then
  begin
    if S^.Dest = nil then
    begin
      PromoAdd(S^.Name, True, w);
      AddName(FFatWritten, NormName(S^.Name));
    end
    else if S^.Dest^.Kind = ekVar then
    begin
      PromoAdd(S^.Dest^.Name, True, w);
      AddName(FFatWritten, NormName(S^.Dest^.Name));
    end
    else
      PromoScanE(S^.Dest, w);
  end
  else if (S^.Kind = skInc) or (S^.Kind = skDec) then
  begin
    if (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) then
      PromoAdd(S^.Dest^.Name, True, w)
    else
      PromoScanE(S^.Dest, w);
  end
  else if S^.Kind = skFor then
  begin
    { the counter of an innermost for weighs four uses (1.1.1): it is
      read and written every pass, and in a register it lets EmitFor
      strip the stack check from the run; it lost its register to
      variables used twice in the body }
    if HasLoop(S^.Body) then
      PromoAdd(S^.Name, True, w)
    else
      PromoAdd(S^.Name, True, w * 4);
  end
  else if S^.Kind = skCall then
  begin
    { a word as a statement (1.0.129): its operands, and Carry }
    if (S^.Name = 'rt_carryon') or (S^.Name = 'rt_carryoff') or
      (S^.Name = 'rt_carryflip') or (S^.Name = 'rt_setcarry') then
      PromoAddCarry(True, w);
    for i := 0 to High(S^.Args) do
      PromoScanE(S^.Args[i], w);
  end;
  PromoScanE(S^.E, w);
  { An innermost for compares with its limit once a run (EmitFor). }
  if (S^.Kind = skFor) and (not HasLoop(S^.Body)) then
    PromoScanE(S^.E2, Weight)
  else
    PromoScanE(S^.E2, w);
  PromoScanS(S^.ThenSt, w);
  PromoScanS(S^.ElseSt, w);
  PromoScanS(S^.Body, w);
  for i := 0 to High(S^.Stmts) do
    PromoScanS(S^.Stmts[i], w);
  for i := 0 to High(S^.Arms) do
    PromoScanS(S^.Arms[i].Body, w);
end;

{ Point every symbol of a promoted place at its register, or back home. }
procedure TEmitter.PromoMark(On: Boolean);
var
  i, j: SizeInt;
  r: string;
begin
  for i := 0 to High(FPromo) do
  begin
    { A slice's parts are found by PartReg, not through the symbol. }
    if FPromo[i].Part > 0 then
      Continue;
    if On then
      r := FPromo[i].Reg
    else
      r := '';
    for j := 0 to High(FSym) do
      if (FSym[j].Global = FPromo[i].Place.Global) and (FSym[j].Up = 0) and
        (not FSym[j].ByRef) and SamePlace(FSym[j], FPromo[i].Place) then
        FSym[j].Reg := r;
    if (not FPromo[i].Place.Global) and FHasRes and
      (FPromo[i].Place.Off = FResOff) then
      FResReg := r;
  end;
end;

procedure TEmitter.LoadHome(const S: TSym; const Reg: string);
begin
  { A narrow home at its width: a narrow store left its high bytes. }
  if TSize(S.Typ) < 8 then
  begin
    if FArm then
    begin
      if S.Global then
        LeaS(VarLabel(S.Name), 'x16')
      else
      begin
        AddFP('x16', S.Off);
      end;
      LoadTo('[x16]', S.Typ, Reg);
    end
    else if S.Global then
      LoadTo(VarLabel(S.Name) + '(%rip)', S.Typ, Reg)
    else
      LoadTo(IntToStr(S.Off) + '(%rbp)', S.Typ, Reg);
    Exit;
  end;
  if FArm then
  begin
    if S.Global then
      LdS(VarLabel(S.Name), Reg)
    else
      LdFP(Reg, S.Off);
  end
  else if S.Global then
    Line('  movq ' + VarLabel(S.Name) + '(%rip), %' + Reg)
  else
    Line('  movq ' + IntToStr(S.Off) + '(%rbp), %' + Reg);
end;

procedure TEmitter.StoreHome(const S: TSym; const Reg: string);
begin
  if S.Name = '$carry' then
  begin
    if FArm then
      Line('  strb w' + Copy(Reg, 2, 8) + ', [x28, #256]')
    else
      Line('  movb %' + X86Sub(Reg, 1) + ', 256(%r14)');
    Exit;
  end;
  if FArm then
  begin
    if S.Global then
      StS(Reg, VarLabel(S.Name))
    else
      StFP(Reg, S.Off);
  end
  else if S.Global then
    Line('  movq %' + Reg + ', ' + VarLabel(S.Name) + '(%rip)')
  else
    Line('  movq %' + Reg + ', ' + IntToStr(S.Off) + '(%rbp)');
end;

{ Around rt_morestack at a loop head: the homes get what the loop wrote,
  and the registers get the homes back, relocated if the stack moved. }
procedure TEmitter.PromoSpill;
var
  i: SizeInt;
begin
  if not FPromoOn then
    Exit;
  for i := 0 to High(FPromo) do
    if FPromo[i].Written then
      StoreHome(FPromo[i].Place, FPromo[i].Reg);
  VecStoreAll(True);
end;

procedure TEmitter.PromoReload;
var
  i: SizeInt;
begin
  if not FPromoOn then
    Exit;
  for i := 0 to High(FPromo) do
    if FPromo[i].Part > 0 then
      LoadHomePart(FPromo[i].Place, FPromo[i].Part, FPromo[i].Reg)
    else
      LoadHome(FPromo[i].Place, FPromo[i].Reg);
  VecLoadAll;
end;

function TEmitter.EmitPromoted(S: PStmt): Boolean;
var
  one: TStmtArray;
begin
  Result := False;
  if not PromoStmtOK(S, False) then
    Exit;
  one := nil;
  SetLength(one, 1);
  one[0] := S;
  Result := EmitRegion(one, 0, 0);
end;

{ The statements of a block, a run of statements without calls at a
  time kept in registers where that pays (P96). }
procedure TEmitter.EmitBlockStmts(S: PStmt);
var
  i, j: SizeInt;
begin
  i := 0;
  while i <= High(S^.Stmts) do
  begin
    if (not FPromoOn) and (not FDebug) and PromoStmtOK(S^.Stmts[i], False) then
    begin
      j := i;
      while (j + 1 <= High(S^.Stmts)) and PromoStmtOK(S^.Stmts[j + 1], False) do
        Inc(j);
      if (j > i) and EmitRegion(S^.Stmts, i, j) then
      begin
        i := j + 1;
        Continue;
      end;
    end;
    EmitStmt(S^.Stmts[i]);
    Inc(i);
  end;
end;

{ Statements L[A..Z], none of which calls, with their most used one-word
  variables in registers (P93 for a loop, P96 for any such run). A
  variable named in a loop counts eight times per level. amd64 lends
  r9 and r10 first, which need no saving since nothing is called, then
  rbx, r12, r13 and r15, whose values the region keeps in frame slots
  (x19 to x26 on arm64). A free register takes a variable named twice,
  a kept one a variable named three times; below that a register does
  not pay for its loads and stores. }
function TEmitter.EmitRegion(const L: TStmtArray; A, Z: SizeInt): Boolean;
var
  i, j, n, nf, nk, base, need, nfMax, nkMax: LongInt;
  k: SizeInt;
  t: TPromo;
  b, e, b2: string;
  chosen: array of TPromo;
  fw: TStrArray;
  pure: Boolean;
  inner: Boolean;
begin
  Result := False;
  FPromo := nil;
  FFatWritten := nil;
  for k := A to Z do
    PromoScanS(L[k], 1);
  { A slice the region assigns keeps its parts in memory. }
  chosen := nil;
  for i := 0 to High(FPromo) do
    if (FPromo[i].Part = 0) or
      (not InNames(FFatWritten, NormName(FPromo[i].Place.Name))) then
    begin
      j := Length(chosen);
      SetLength(chosen, j + 1);
      chosen[j] := FPromo[i];
    end;
  FPromo := chosen;
  n := Length(FPromo);
  for i := 0 to n - 2 do
    for j := i + 1 to n - 1 do
      if FPromo[j].Refs > FPromo[i].Refs then
      begin
        t := FPromo[i];
        FPromo[i] := FPromo[j];
        FPromo[j] := t;
      end;
  chosen := nil;
  nf := 0;
  nk := 0;
  base := FScratchOff - FPinned;
  { An innermost for keeps the end of its run of 1024 in a register of
    its own (EmitFor), set aside first: it saves a compare and a branch
    at every pass of the hottest loop, more than any variable's load.
    It is r11 on amd64 and x26 on arm64. }
  FChunkReg := '';
  FChunkSave := 0;
  inner := False;
  for k := A to Z do
    if HasInnerFor(L[k]) then
      inner := True;
  nfMax := 3;
  nkMax := 8;
  if inner then
  begin
    if FArm then
    begin
      FChunkReg := 'x26';
      FChunkDw := 26;
      nkMax := 7;
    end
    else
    begin
      FChunkReg := 'r11';
      FChunkDw := 11;
      nfMax := 2;
    end;
  end;
  { r8 as well in a region of integer arithmetic alone (1.1.1): a
    mixer's loop of eight live values kept two in memory }
  pure := not FArm;
  for k := A to Z do
    if pure and (not PureIntS(L[k])) then
      pure := False;
  if pure then
    Inc(nfMax);
  FR8Lent := False;
  for i := 0 to n - 1 do
  begin
    j := Length(chosen);
    if FArm then
    begin
      if (nk < nkMax) and (FPromo[i].Refs >= 3) then
      begin
        SetLength(chosen, j + 1);
        chosen[j] := FPromo[i];
        chosen[j].Reg := 'x' + IntToStr(19 + nk);
        chosen[j].Dw := 19 + nk;
        chosen[j].Keep := True;
        Inc(nk);
        chosen[j].Save := base - 8 * nk;
      end;
    end
    else if (nf < nfMax) and (FPromo[i].Refs >= 2) then
    begin
      SetLength(chosen, j + 1);
      chosen[j] := FPromo[i];
      if nf = 0 then
      begin
        chosen[j].Reg := 'r9';
        chosen[j].Dw := 9;
      end
      else if nf = 1 then
      begin
        chosen[j].Reg := 'r10';
        chosen[j].Dw := 10;
      end
      else if (nf = 2) and (FChunkReg = '') then
      begin
        chosen[j].Reg := 'r11';
        chosen[j].Dw := 11;
      end
      else
      begin
        chosen[j].Reg := 'r8';
        chosen[j].Dw := 8;
        FR8Lent := True;
      end;
      chosen[j].Keep := False;
      chosen[j].Save := 0;
      Inc(nf);
    end
    else if (nk < 4) and (FPromo[i].Refs >= 3) then
    begin
      SetLength(chosen, j + 1);
      chosen[j] := FPromo[i];
      case nk of
        0:
          begin
            chosen[j].Reg := 'rbx';
            chosen[j].Dw := 3;
          end;
        1:
          begin
            chosen[j].Reg := 'r12';
            chosen[j].Dw := 12;
          end;
        2:
          begin
            chosen[j].Reg := 'r13';
            chosen[j].Dw := 13;
          end;
      else
        begin
          chosen[j].Reg := 'r15';
          chosen[j].Dw := 15;
        end;
      end;
      chosen[j].Keep := True;
      Inc(nk);
      chosen[j].Save := base - 8 * nk;
    end;
  end;
  FPromo := chosen;
  n := Length(FPromo);
  { the vector variables' registers (P107, 1.0.128) }
  VecChoose(L, A, Z);
  if (n = 0) and (Length(FVPromo) = 0) then
  begin
    FPromo := nil;
    FChunkReg := '';
    Exit;
  end;
  { The chunk register was set aside before the choice: amd64 lends it
    free, arm64 keeps it in a frame slot after the variables' ones. }
  if FChunkReg <> '' then
  begin
    FChunkSave := 0;
    if FArm then
    begin
      Inc(nk);
      FChunkSave := base - 8 * nk;
    end;
  end;
  Result := True;
  need := 8 * nk;
  FPinned := FPinned + need;
  if FPinned > FScratchMax then
    FScratchMax := FPinned;
  { A kept register's caller value goes to its frame slot; the CFA is
    rbp+16 (x29+16), so a slot at off is CFA+(off-16). }
  for i := 0 to n - 1 do
    if FPromo[i].Keep then
    begin
      if FArm then
      begin
        StFP(FPromo[i].Reg, FPromo[i].Save);
        Line('  .cfi_offset ' + IntToStr(FPromo[i].Dw) + ', ' +
          IntToStr(FPromo[i].Save - 16));
      end
      else
      begin
        Line('  movq %' + FPromo[i].Reg + ', ' + IntToStr(FPromo[i].Save) + '(%rbp)');
        Line('  .cfi_offset %' + FPromo[i].Reg + ', ' + IntToStr(FPromo[i].Save - 16));
      end;
    end;
  if FChunkSave <> 0 then
  begin
    if FArm then
    begin
      StFP(FChunkReg, FChunkSave);
      Line('  .cfi_offset ' + IntToStr(FChunkDw) + ', ' + IntToStr(FChunkSave - 16));
    end
    else
    begin
      Line('  movq %' + FChunkReg + ', ' + IntToStr(FChunkSave) + '(%rbp)');
      Line('  .cfi_offset %' + FChunkReg + ', ' + IntToStr(FChunkSave - 16));
    end;
  end;
  { A local the region writes before it reads is not loaded; a global
    always is, since a slow path before its first write would spill the
    register over the value other routines see (P96). }
  fw := FirstWrites(L, A, Z);
  for i := 0 to n - 1 do
    if FPromo[i].Part > 0 then
      LoadHomePart(FPromo[i].Place, FPromo[i].Part, FPromo[i].Reg)
    else if FPromo[i].Place.Global or
      (not InNames(fw, NormName(FPromo[i].Place.Name))) then
      LoadHome(FPromo[i].Place, FPromo[i].Reg);
  b := Lab;
  Line(b + ':');
  PromoMark(True);
  FPromoOn := True;
  FStubs := '';
  VecRegionBody(L, A, Z);
  if FStubs <> '' then
  begin
    b2 := Lab;
    if FArm then
      Line('  b ' + b2)
    else
      Line('  jmp ' + b2);
    AppendLine(Copy(FStubs, 1, Length(FStubs) - 1));
    FStubs := '';
    Line(b2 + ':');
  end;
  FPromoOn := False;
  PromoMark(False);
  for i := 0 to n - 1 do
    if FPromo[i].Written then
      StoreHome(FPromo[i].Place, FPromo[i].Reg);
  e := Lab;
  Line(e + ':');
  for i := 0 to n - 1 do
    if (not FPromo[i].Place.Global) and (FPromo[i].Part = 0) then
    begin
      j := Length(FLocRanges);
      SetLength(FLocRanges, j + 1);
      FLocRanges[j].Proc := FCurProc;
      FLocRanges[j].Off := FPromo[i].Place.Off;
      FLocRanges[j].Dw := FPromo[i].Dw;
      FLocRanges[j].B := b;
      FLocRanges[j].E := e;
    end;
  for i := 0 to n - 1 do
    if FPromo[i].Keep then
    begin
      if FArm then
      begin
        LdFP(FPromo[i].Reg, FPromo[i].Save);
        Line('  .cfi_restore ' + IntToStr(FPromo[i].Dw));
      end
      else
      begin
        Line('  movq ' + IntToStr(FPromo[i].Save) + '(%rbp), %' + FPromo[i].Reg);
        Line('  .cfi_restore %' + FPromo[i].Reg);
      end;
    end;
  if FChunkSave <> 0 then
  begin
    if FArm then
    begin
      LdFP(FChunkReg, FChunkSave);
      Line('  .cfi_restore ' + IntToStr(FChunkDw));
    end
    else
    begin
      Line('  movq ' + IntToStr(FChunkSave) + '(%rbp), %' + FChunkReg);
      Line('  .cfi_restore %' + FChunkReg);
    end;
  end;
  FChunkReg := '';
  FChunkSave := 0;
  FPinned := FPinned - need;
  FPromo := nil;
  FVPromo := nil;
  FVecTop := 0;
end;

{ The register pool for integer expressions without calls (P93): rsi,
  rdi, r8-r11 on amd64 and x9-x15 on arm64. Nothing in the emitter keeps
  a value in them across the evaluation of another expression, since any
  expression may call; rax, rcx and rdx stay free for division, shift
  counts, flags and large constants, and x0, x1 and x17 on arm64. }
function TEmitter.OrdPool(D: LongInt): string;
begin
  if (D = 0) and (FPool0 <> '') then
  begin
    Result := FPool0;
    Exit;
  end;
  if FArm then
    Result := 'x' + IntToStr(9 + D)
  else
    case D of
      0: Result := 'rsi';
      1: Result := 'rdi';
      2: Result := 'r8';
      3: Result := 'r11';
      4: Result := 'r9';
    else
      Result := 'r10';
    end;
end;

{ E is worked out in the pool by plain steps alone: constants, word
  variables, + - * and or xor shl shr of them, a negation, a not and a
  conversion to a narrow integer; no index, field or call, no division,
  no compare, nothing that writes a failure out of line (P318). }
function TEmitter.PoolPlain(E: PExpr): Boolean;
var
  s: TSym;
begin
  Result := False;
  if (E = nil) or (E^.Typ = TyBoolean) then
    Exit;
  case E^.Kind of
    ekInt: Result := True;
    ekVar: Result := WordVar(E, s);
    ekUn:
      Result := ((E^.Un = uoNeg) or (E^.Un = uoNot) or (E^.Un = uoConv)) and PoolPlain(E^.L);
    ekBin:
      Result := ((E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or
        (E^.Bin = boAnd) or (E^.Bin = boOr) or (E^.Bin = boXor) or (E^.Bin = boShl) or
        (E^.Bin = boShr)) and PoolPlain(E^.L) and PoolPlain(E^.R);
  end;
end;

function TEmitter.OrdLeaf(E: PExpr): Boolean;
var
  s: TSym;
begin
  Result := False;
  if E = nil then
    Exit;
  if (E^.Kind = ekInt) or (E^.Kind = ekNil) then
    Result := True
  else if E^.Kind = ekStr then
    Result := Length(E^.Txt) = 1
  else if E^.Kind = ekVar then
    Result := WordVar(E, s);
end;

function TEmitter.OrdBinOp(E: PExpr): Boolean;
begin
  Result := False;
  if (E = nil) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  case E^.Bin of
    boAdd, boSub, boMul, boDiv, boMod, boXor, boShl, boShr, boSar, boRol, boRor, boMulHi, boMulHiS,
    boEq, boNe, boLt, boLe, boGt, boGe:
      Result := True;
    boAnd, boOr:
      Result := E^.Typ <> TyBoolean;
  end;
  if not Result then
    Exit;
  if RealBin(E) or (TKind(E^.Typ) = tykSet) or (TKind(E^.Typ) = tykReal) or
    IsFat(E^.Typ) or IsBlob(E^.Typ) or (TKind(E^.L^.Typ) = tykSet) or
    (TKind(E^.R^.Typ) = tykSet) then
    Result := False;
end;

{ E can be worked out into pool register D and the ones above it. }
function TEmitter.OrdSimple(E: PExpr; D: LongInt): Boolean;
var
  s: TSym;
  n: LongInt;
begin
  Result := False;
  n := PoolSize;
  if (E = nil) or (D >= n) or PtrAccess(E) then
    Exit;
  case E^.Kind of
    ekInt, ekNil:
      Result := True;
    ekStr:
      Result := Length(E^.Txt) = 1;
    ekVar:
      Result := WordVar(E, s);
    ekDeref, ekField, ekIndex:
      Result := WordScalar(E) and WordMemOK(E, D);
    ekCall:
      if (E^.Name = 'rt_length') and (Length(E^.Args) = 1) and
        (E^.Args[0] <> nil) and (IsStr(E^.Args[0]^.Typ) or IsDyn(E^.Args[0]^.Typ)) then
        Result := FatPtrOK(E^.Args[0], D)
      else if (E^.Name = 'rt_bitchk') and (Length(E^.Args) = 2) then
        Result := OrdSimple(E^.Args[0], D);
    ekUn:
      if (E^.L <> nil) and (TKind(E^.Typ) <> tykReal) and
        (TKind(E^.L^.Typ) <> tykReal) and (TKind(E^.Typ) <> tykSet) then
        Result := OrdSimple(E^.L, D);
    ekBin:
      if OrdBinOp(E) and OrdSimple(E^.L, D) then
      begin
        if OrdLeaf(E^.R) then
          Result := True
        else
          Result := OrdSimple(E^.R, D + 1);
      end;
  end;
end;

{ The right side of a node whose left side sits in pool register D: an
  immediate or a memory operand when amd64 can take one, else a
  register (pool D+1 for a subtree; rax on amd64 or x17 on arm64 for a
  constant or a variable that needs loading). }
function TEmitter.OrdOperand(E: PExpr; D: LongInt): string;
var
  s: TSym;
  ok: Boolean;
  k: Int64;
begin
  if (E^.Kind = ekInt) or (E^.Kind = ekNil) or
    ((E^.Kind = ekStr) and (Length(E^.Txt) = 1)) then
  begin
    if E^.Kind = ekInt then
      k := E^.Num
    else if E^.Kind = ekNil then
      k := 0
    else
      k := Ord(E^.Txt[1]);
    if FArm then
    begin
      Imm('x17', k);
      Result := 'x17';
    end
    else if Fits32(k) then
      Result := '$' + IntToStr(k)
    else
    begin
      Line('  movabsq $' + IntToStr(k) + ', %rax');
      Result := '%rax';
    end;
  end
  else if (E^.Kind = ekVar) and WordVar(E, s) and (TSize(s.Typ) < 8) and (s.Reg <> '') then
  begin
    { a narrow variable a region keeps is clean in its register, the whole
      word extended (P100: StoreWordVar and LoadHome keep it so), so the
      register is the operand, where it went through rax or x17 (P318) }
    if FArm then
      Result := s.Reg
    else
      Result := '%' + s.Reg;
  end
  else if (E^.Kind = ekVar) and WordVar(E, s) and (TSize(s.Typ) < 8) then
  begin
    if FArm then
    begin
      LoadWordVar(s, 'x17');
      Result := 'x17';
    end
    else
    begin
      LoadWordVar(s, 'rax');
      Result := '%rax';
    end;
  end
  else if E^.Kind = ekVar then
  begin
    ok := WordVar(E, s);
    if not ok then
      Die('internal error: operand ' + E^.Name);
    if not FArm then
      Result := MemA(s)
    else if s.Reg <> '' then
      Result := s.Reg
    else
    begin
      LoadPlain(s, 'x17');
      Result := 'x17';
    end;
  end
  else
  begin
    EmitOrdTo(E, D + 1);
    if FArm then
      Result := OrdPool(D + 1)
    else
      Result := '%' + OrdPool(D + 1);
  end;
end;

procedure TEmitter.EmitOrdTo(E: PExpr; D: LongInt);
var
  was: LongInt;
begin
  OpLineIn(E, was);
  EmitOrdTo0(E, D);
  FOpLine := was;
end;

procedure TEmitter.EmitOrdTo0(E: PExpr; D: LongInt);
var
  r, m: string;
  s: TSym;
  ok, skip: Boolean;
  k: Int64;
  t: PExpr;
  zt, fz, oz: LongInt;
begin
  r := OrdPool(D);
  skip := FSkipCanon;
  FSkipCanon := False;
  case E^.Kind of
    ekInt, ekNil, ekStr:
      begin
        if E^.Kind = ekInt then
          k := E^.Num
        else if E^.Kind = ekNil then
          k := 0
        else
          k := Ord(E^.Txt[1]);
        if FArm then
          Imm(r, k)
        else
          LoadImmR(r, k);
      end;
    ekVar:
      begin
        ok := WordVar(E, s);
        if not ok then
          Die('internal error: operand ' + E^.Name);
        LoadWordVar(s, r);
      end;
    ekDeref, ekField, ekIndex:
      begin
        m := EmitWordMem(E, D);
        WordLoad(m, LoadTyp(E), r);
      end;
    ekCall:
      if E^.Name = 'rt_bitchk' then
      begin
        EmitOrdTo(E^.Args[0], D);
        EmitBitChk(r, E^.Args[1]^.Num);
      end
      else
        EmitFatWord(E^.Args[0], D, True);
    ekUn:
      if FArm and (E^.Un = uoNot) and (E^.Typ <> TyBoolean) and (E^.L <> nil) and
        (E^.L^.Kind = ekBin) and (E^.L^.Bin = boXor) and (E^.L^.Typ <> TyBoolean) then
      begin
        { xnor, not (a xor b): one eon (1.0.131) }
        EmitOrdTo(E^.L^.L, D);
        Line('  eon ' + r + ', ' + r + ', ' + OrdOperand(E^.L^.R, D));
      end
      else
      begin
        EmitOrdTo(E^.L, D);
        { A conversion to a narrow integer: the cleanup below. }
        if E^.Un = uoConv then
        begin
        end
        else if BitUnOp(E^.Un) then
          EmitBitUn(E, r)
        else if E^.Un = uoNeg then
        begin
          if FArm then
            Line('  neg ' + r + ', ' + r)
          else
            Line('  negq %' + r);
        end
        else if E^.Typ = TyBoolean then
        begin
          if FArm then
          begin
            Line('  cmp ' + r + ', #0');
            Line('  cset ' + r + ', eq');
          end
          else
          begin
            Line('  testq %' + r + ', %' + r);
            Line('  sete %al');
            Line('  movzbq %al, %' + r);
          end;
        end
        else if FArm then
          Line('  mvn ' + r + ', ' + r)
        else
          Line('  notq %' + r);
      end;
    ekBin:
      begin
        { a constant on the left of +, *, and, or and xor goes to the
          right, where the forms below and both machines' immediates
          take it: 8 * x was a move of 8 and an imul, x * 8 is a shift
          (P294) }
        if (E^.L^.Kind = ekInt) and (E^.R^.Kind <> ekInt) and (E^.Typ <> TyBoolean) and
          ((E^.Bin = boAdd) or (E^.Bin = boMul) or (E^.Bin = boAnd) or
          (E^.Bin = boOr) or (E^.Bin = boXor)) then
        begin
          t := E^.L;
          E^.L := E^.R;
          E^.R := t;
        end;
        { the value of (x and c) = 0 or <> 0: one TEST or TST, or a BT,
          and the set (P322) }
        if (E^.Typ = TyBoolean) and AndZero(E, t) then
        begin
          ok := E^.Bin = boEq;
          zt := AndTest(t, D, True);
          if zt > 0 then
          begin
            if FArm then
            begin
              if ok then
                Line('  cset ' + r + ', eq')
              else
                Line('  cset ' + r + ', ne');
            end
            else
            begin
              if zt = 2 then
              begin
                if ok then
                  Line('  setae %al')
                else
                  Line('  setb %al');
              end
              else if ok then
                Line('  sete %al')
              else
                Line('  setne %al');
              Line('  movzbq %al, %' + r);
            end;
            Exit;
          end;
        end;
        { x and $FF, $FFFF or $FFFFFFFF is a zero extension of x's low
          byte, halfword or word: from x's register, or a load of that
          much of x at its home, else of the pool's register after x,
          where it was a move or a load and an AND, and $FFFFFFFF an AND
          of the constant in rax. Go writes MOVBQZX and MOVWQZX (AMD64.rules
          879-881, "cheaper") and MOVBUreg, MOVHUreg and MOVWUreg
          (ARM64.rules 1878-1880) (P320) }
        if (E^.Bin = boAnd) and (TSize(E^.Typ) = 8) and ConstOf(E^.R, k) and
          ((k = $FF) or (k = $FFFF) or (k = $FFFFFFFF)) then
        begin
          if k = $FF then
            zt := TyByte
          else if k = $FFFF then
            zt := TyWord
          else
            zt := TyUInt32;
          m := WordReg(E^.L);
          if m <> '' then
            CanonTo(r, m, zt)
          else if (E^.L^.Kind = ekVar) and WordVar(E^.L, s) and (s.Reg = '') and
            (TSize(s.Typ) >= TSize(zt)) then
          begin
            if FArm then
            begin
              if s.Global then
                LeaS(VarLabel(s.Name), 'x16')
              else
                AddFP('x16', s.Off);
              LoadTo('[x16]', zt, r);
            end
            else
              LoadTo(MemA(s), zt, r);
          end
          else
          begin
            EmitOrdTo(E^.L, D);
            CanonReg(r, zt);
          end;
          Exit;
        end;
        if ScaledAdd(E, D) then
          Exit;
        { a - k of a register is one lea, a two-operand one, one cycle on
          Zen 2 (AMD 56305 2.10.2), where mov and sub were two (P282) }
        if (E^.Bin = boSub) and (TSize(E^.Typ) = 8) and (E^.R^.Kind = ekInt) and
          (E^.L^.Kind = ekVar) and WordVar(E^.L, s) and (s.Reg <> '') then
        begin
          if (not FArm) and Fits32(-E^.R^.Num) then
          begin
            Line('  leaq ' + IntToStr(-E^.R^.Num) + '(%' + s.Reg + '), %' + r);
            Exit;
          end;
        end;
        { arm64 (P282, P290): an operation on a variable a register keeps
          takes that register as its first operand, the result straight
          into the pool's, the constant as the immediate where the
          instruction takes one; a mov first doubled each such step }
        if FArm and (TSize(E^.Typ) = 8) and (E^.L^.Kind = ekVar) and WordVar(E^.L, s) and
          (s.Reg <> '') and ((E^.Bin = boAdd) or (E^.Bin = boSub) or
          (E^.Bin = boAnd) or (E^.Bin = boOr) or (E^.Bin = boXor) or (E^.Bin = boMul) or
          (E^.Bin = boShl) or (E^.Bin = boShr)) then
        begin
          case E^.Bin of
            boAdd: m := 'add';
            boSub: m := 'sub';
            boAnd: m := 'and';
            boOr: m := 'orr';
            boXor: m := 'eor';
            boMul: m := 'mul';
            boShl: m := 'lsl';
          else
            m := 'lsr';
          end;
          k := 0;
          if E^.R^.Kind = ekInt then
            k := E^.R^.Num;
          if (E^.R^.Kind = ekInt) and ((E^.Bin = boShl) or (E^.Bin = boShr)) and
            (k >= 0) and (k <= 63) then
            Line('  ' + m + ' ' + r + ', ' + s.Reg + ', #' + IntToStr(k))
          else if (E^.R^.Kind = ekInt) and ((E^.Bin = boAdd) or (E^.Bin = boSub)) and
            (ArmAddImm(k) <> '') then
            Line('  ' + m + ' ' + r + ', ' + s.Reg + ', ' + ArmAddImm(k))
          else if (E^.R^.Kind = ekInt) and ((E^.Bin = boAdd) or (E^.Bin = boSub)) and
            (k < 0) and (k > Low(Int64)) and (ArmAddImm(-k) <> '') then
          begin
            if E^.Bin = boAdd then
              m := 'sub'
            else
              m := 'add';
            Line('  ' + m + ' ' + r + ', ' + s.Reg + ', ' + ArmAddImm(-k));
          end
          else if (E^.R^.Kind = ekInt) and ((E^.Bin = boAnd) or (E^.Bin = boOr) or
            (E^.Bin = boXor)) and ArmLogImm(k) then
            Line('  ' + m + ' ' + r + ', ' + s.Reg + ', #' + HexWord(k))
          { a product by a constant's recipe from the variable's register
            (P295) }
          else if (E^.Bin = boMul) and (E^.R^.Kind = ekInt) and MulByKTo(r, s.Reg, k) then
          else
            Line('  ' + m + ' ' + r + ', ' + s.Reg + ', ' + OrdOperand(E^.R, D));
          Exit;
        end;
        { a + b of two registers, or a + k, is one lea (1.1.1) }
        if (not FArm) and (E^.Bin = boAdd) and (TSize(E^.Typ) = 8) and
          (E^.L^.Kind = ekVar) and WordVar(E^.L, s) and (s.Reg <> '') then
        begin
          if (E^.R^.Kind = ekInt) and Fits32(E^.R^.Num) then
          begin
            Line('  leaq ' + IntToStr(E^.R^.Num) + '(%' + s.Reg + '), %' + r);
            Exit;
          end;
          m := s.Reg;
          if (E^.R^.Kind = ekVar) and WordVar(E^.R, s) and (s.Reg <> '') then
          begin
            { r13 as the base beside an index is Intel's slow LEA
              (248966 3.5.1.2), as the index it is not (P294) }
            if m = 'r13' then
              Line('  leaq (%' + s.Reg + ',%' + m + '), %' + r)
            else
              Line('  leaq (%' + m + ',%' + s.Reg + '), %' + r);
            Exit;
          end;
        end;
        { a product by a constant of a variable a register keeps, of any
          width, from that register into the pool's by its recipe: the
          product's low bits are the narrow type's, cleaned below as they
          were, where a move of the variable came first (P317) }
        if (not FArm) and (E^.Bin = boMul) and ConstOf(E^.R, k) and (E^.L^.Kind = ekVar) and
          WordVar(E^.L, s) and (s.Reg <> '') and MulByKTo('%' + r, '%' + s.Reg, k) then
        { no recipe: IMUL of three operands from the variable's register or
          its home of 8 bytes when no recipe takes the constant there either
          (MulRecipe), a narrow one's low bits the product's, as Go writes
          IMUL3Q $c, x, r (amd64/ssa.go, MULQconst) (P323) }
        else if (not FArm) and (E^.Bin = boMul) and ConstOf(E^.R, k) and Fits32(k) and
          (E^.L^.Kind = ekVar) and WordVar(E^.L, s) and
          ((s.Reg <> '') or ((TSize(s.Typ) = 8) and (k <> 0) and (k <> 1) and
          not MulRecipe(k, zt, fz, oz))) then
        begin
          if s.Reg <> '' then
            Line('  imulq $' + IntToStr(k) + ', %' + s.Reg + ', %' + r)
          else
            Line('  imulq $' + IntToStr(k) + ', ' + MemA(s) + ', %' + r);
        end
        else
        begin
          EmitOrdTo(E^.L, D);
          if FArm then
            EmitOrdBinArm(E, D)
          else
            EmitOrdBinAmd(E, D);
        end;
      end;
  else
    Die('internal error: not an integer expression');
  end;
  { A narrow operation in the pool (P100): cleaned in its register,
    unless a store of its own width takes it, which truncates anyway. }
  if NarrowOp(E) and not KeepsClean(E) and not skip then
    CanonReg(r, E^.Typ);
end;

procedure TEmitter.EmitOrdBinAmd(E: PExpr; D: LongInt);
var
  r, op, cc: string;
  w: LongInt;
begin
  r := '%' + OrdPool(D);
  case E^.Bin of
    boSar, boRol, boRor:
      begin
        { P105: in the width of the type, as RotX86 does }
        if (E^.R^.Kind = ekInt) and (E^.R^.Num >= 0) and (E^.R^.Num <= 63) then
          op := '$' + IntToStr(E^.R^.Num)
        else
        begin
          op := OrdOperand(E^.R, D);
          Line('  movq ' + op + ', %rcx');
          op := '%cl';
        end;
        w := 64;
        if IsNarrowId(E^.Typ) then
          w := TSize(E^.Typ) * 8;
        if E^.Bin = boSar then
        begin
          { Only an unsigned value is extended: a clean signed one is. }
          if E^.Typ = TyByte then
            Line('  movsbq %' + X86Sub(OrdPool(D), 1) + ', ' + r)
          else if E^.Typ = TyWord then
            Line('  movswq %' + X86Sub(OrdPool(D), 2) + ', ' + r)
          else if E^.Typ = TyUInt32 then
            Line('  movslq %' + X86Sub(OrdPool(D), 4) + ', ' + r);
          Line('  sarq ' + op + ', ' + r);
        end
        else
        begin
          if E^.Bin = boRol then
            cc := 'rol'
          else
            cc := 'ror';
          if w = 8 then
            Line('  ' + cc + 'b ' + op + ', %' + X86Sub(OrdPool(D), 1))
          else if w = 16 then
            Line('  ' + cc + 'w ' + op + ', %' + X86Sub(OrdPool(D), 2))
          else if w = 32 then
            Line('  ' + cc + 'l ' + op + ', %' + X86Sub(OrdPool(D), 4))
          else
            Line('  ' + cc + 'q ' + op + ', ' + r);
        end;
      end;
    boMulHi, boMulHiS:
      begin
        { mulq/imulq take rax and leave the high word in rdx, both free
          in the pool }
        op := OrdOperand(E^.R, D);
        Line('  movq ' + op + ', %rcx');
        Line('  movq ' + r + ', %rax');
        if E^.Bin = boMulHi then
          Line('  mulq %rcx')
        else
          Line('  imulq %rcx');
        Line('  movq %rdx, ' + r);
      end;
    boShl, boShr:
      begin
        if (E^.R^.Kind = ekInt) and (E^.R^.Num >= 0) and (E^.R^.Num <= 63) then
          op := '$' + IntToStr(E^.R^.Num)
        else
        begin
          op := OrdOperand(E^.R, D);
          Line('  movq ' + op + ', %rcx');
          op := '%cl';
        end;
        if E^.Bin = boShl then
          Line('  shlq ' + op + ', ' + r)
        else if (E^.Typ = TyInt8) or (E^.Typ = TyInt16) or (E^.Typ = TyInt32) then
          Line('  sarq ' + op + ', ' + r)
        else
          Line('  shrq ' + op + ', ' + r);
      end;
    boDiv, boMod:
      if DivConstOK(E) then
        EmitDivConst(r, E^.R^.Num, E^.Bin = boMod)
      else
      begin
        op := OrdOperand(E^.R, D);
        Line('  movq ' + op + ', %rcx');
        Line('  movq ' + r + ', %rax');
        EmitDivCheck;
        Line('  cqto');
        Line('  idivq %rcx');
        if E^.Bin = boDiv then
          Line('  movq %rax, ' + r)
        else
          Line('  movq %rdx, ' + r);
      end;
    boMul:
      begin
        op := OrdOperand(E^.R, D);
        if op[1] = '$' then
          MulImm(op, r)
        else
          MulImm(op, r);
      end;
    boAdd, boSub, boAnd, boOr, boXor:
      begin
        op := OrdOperand(E^.R, D);
        case E^.Bin of
          boAdd: Line('  addq ' + op + ', ' + r);
          boSub: Line('  subq ' + op + ', ' + r);
          boAnd: Line('  andq ' + op + ', ' + r);
          boOr: Line('  orq ' + op + ', ' + r);
        else
          Line('  xorq ' + op + ', ' + r);
        end;
      end;
  else
    begin
      op := OrdOperand(E^.R, D);
      Line('  cmpq ' + op + ', ' + r);
      case E^.Bin of
        boEq: cc := 'sete';
        boNe: cc := 'setne';
        boLt: cc := 'setl';
        boLe: cc := 'setle';
        boGt: cc := 'setg';
      else
        cc := 'setge';
      end;
      Line('  ' + cc + ' %al');
      Line('  movzbq %al, ' + r);
    end;
  end;
end;

procedure TEmitter.EmitOrdBinArm(E: PExpr; D: LongInt);
var
  r, op, cc: string;
  small, addop: Boolean;
  k: Int64;
begin
  r := OrdPool(D);
  small := (E^.R^.Kind = ekInt) and (E^.R^.Num >= 0) and (E^.R^.Num <= 4095);
  case E^.Bin of
    boSar, boRol, boRor:
      EmitOrdRotArm(E, D);
    boMulHi, boMulHiS:
      begin
        op := OrdOperand(E^.R, D);
        if E^.Bin = boMulHi then
          Line('  umulh ' + r + ', ' + r + ', ' + op)
        else
          Line('  smulh ' + r + ', ' + r + ', ' + op);
      end;
    boAdd, boSub:
      begin
        { the immediate of 0 to 4095, or that shifted by 12, or of the
          opposite operation for a negative one (P290) }
        addop := E^.Bin = boAdd;
        if (E^.R^.Kind = ekInt) and (ArmAddImm(E^.R^.Num) <> '') then
          op := ArmAddImm(E^.R^.Num)
        else if (E^.R^.Kind = ekInt) and (E^.R^.Num < 0) and (E^.R^.Num > Low(Int64)) and
          (ArmAddImm(-E^.R^.Num) <> '') then
        begin
          op := ArmAddImm(-E^.R^.Num);
          addop := not addop;
        end
        else
          op := OrdOperand(E^.R, D);
        if addop then
          Line('  add ' + r + ', ' + r + ', ' + op)
        else
          Line('  sub ' + r + ', ' + r + ', ' + op);
      end;
    boShl, boShr:
      begin
        if (E^.R^.Kind = ekInt) and (E^.R^.Num >= 0) and (E^.R^.Num <= 63) then
          op := '#' + IntToStr(E^.R^.Num)
        else
          op := OrdOperand(E^.R, D);
        if E^.Bin = boShl then
          Line('  lsl ' + r + ', ' + r + ', ' + op)
        else if (E^.Typ = TyInt8) or (E^.Typ = TyInt16) or (E^.Typ = TyInt32) then
          Line('  asr ' + r + ', ' + r + ', ' + op)
        else
          Line('  lsr ' + r + ', ' + r + ', ' + op);
      end;
    boDiv, boMod:
      if DivConstOK(E) then
        EmitDivConst(r, E^.R^.Num, E^.Bin = boMod)
      else
      begin
        op := OrdOperand(E^.R, D);
        Line('  mov x1, ' + op);
        Line('  mov x0, ' + r);
        EmitDivCheck;
        if E^.Bin = boDiv then
          Line('  sdiv ' + r + ', x0, x1')
        else
        begin
          Line('  sdiv x17, x0, x1');
          Line('  msub ' + r + ', x17, x1, x0');
        end;
      end;
    boMul, boAnd, boOr, boXor:
      if (E^.Bin <> boMul) and (E^.R^.Kind = ekUn) and (E^.R^.Un = uoNot) and
        (E^.R^.L <> nil) and (E^.R^.Typ <> TyBoolean) and
        ((E^.Bin = boAnd) or not IsNarrowId(E^.Typ) or (E^.Typ = TyInt8) or
        (E^.Typ = TyInt16) or (E^.Typ = TyInt32)) then
      begin
        { a and not b, a or not b, a xor not b: one instruction (bic, orn,
          eon), not an mvn before it (1.0.131); andnot is the first. orn
          and eon fill a narrow unsigned value's upper bits with ones,
          which the mvn's cleanup took away: there they keep the two. }
        op := OrdOperand(E^.R^.L, D);
        case E^.Bin of
          boAnd: Line('  bic ' + r + ', ' + r + ', ' + op);
          boOr: Line('  orn ' + r + ', ' + r + ', ' + op);
        else
          Line('  eon ' + r + ', ' + r + ', ' + op);
        end;
      end
      else
      begin
        { a constant's product by a recipe, before the constant is
          loaded (P295) }
        if (E^.Bin = boMul) and ConstOf(E^.R, k) and MulByK(r, k) then
          Exit;
        { a logical immediate where and, orr and eor take one (P290) }
        if (E^.Bin <> boMul) and (E^.R^.Kind = ekInt) and ArmLogImm(E^.R^.Num) then
          op := '#' + HexWord(E^.R^.Num)
        else
          op := OrdOperand(E^.R, D);
        case E^.Bin of
          boMul: Line('  mul ' + r + ', ' + r + ', ' + op);
          boAnd: Line('  and ' + r + ', ' + r + ', ' + op);
          boOr: Line('  orr ' + r + ', ' + r + ', ' + op);
        else
          Line('  eor ' + r + ', ' + r + ', ' + op);
        end;
      end;
  else
    begin
      { a constant CMP or CMN takes, a character's too (P306) }
      if ConstOf(E^.R, k) and ((ArmAddImm(k) <> '') or
        ((k < 0) and (k > Low(Int64)) and (ArmAddImm(-k) <> ''))) then
        CmpImmArm(r, k, 'x17')
      else
        Line('  cmp ' + r + ', ' + OrdOperand(E^.R, D));
      case E^.Bin of
        boEq: cc := 'eq';
        boNe: cc := 'ne';
        boLt: cc := 'lt';
        boLe: cc := 'le';
        boGt: cc := 'gt';
      else
        cc := 'ge';
      end;
      Line('  cset ' + r + ', ' + cc);
    end;
  end;
end;

{ Division by a constant (P94), Go's strength reduction
  (cmd/compile/internal/ssa/_gen/divmod.rules, magic.go): a divisor that
  is a power of two is a shift with a bias for negative dividends, any
  other positive divisor is a multiply by M = ceil(2^(64+s)/C), s =
  bitlen(C)-1, taking the high half: x div C = ((x*M) >> 64 >> s) - (x < 0)
  with M unsigned, done with a signed multiply high (imul, smulh) and x
  added back when M is odd; x mod C = x - (x div C)*C. The 128-bit
  division that gives M is done a bit at a time, the remainder kept
  below C so nothing overflows. }
procedure SMagic64(C: Int64; out M: Int64; out Sh: LongInt);
var
  s, posn: LongInt;
  r, t, q, b: Int64;
begin
  s := 0;
  while (C shr (s + 1)) <> 0 do
    Inc(s);
  r := 0;
  q := 0;
  for posn := 64 + s downto 0 do
  begin
    if posn = 64 + s then
      b := 1
    else if posn >= 64 then
      b := 0
    else
      b := ((C - 1) shr posn) and 1;
    t := C - r;
    q := q shl 1;
    if r + b >= t then
    begin
      r := r + b - t;
      q := q or 1;
    end
    else
      r := r + r + b;
  end;
  M := q;
  Sh := s;
end;

function TEmitter.DivConstOK(E: PExpr): Boolean;
begin
  Result := (E <> nil) and (E^.Kind = ekBin) and
    ((E^.Bin = boDiv) or (E^.Bin = boMod)) and (E^.R <> nil) and
    (E^.R^.Kind = ekInt) and (E^.R^.Num >= 1) and (not RealBin(E)) and
    (TKind(E^.Typ) <> tykReal) and (TKind(E^.Typ) <> tykSet);
end;

{ X (a register, '%rsi' or 'x9' style, rax or x0 allowed) := X div C or
  X mod C, for C >= 1. amd64 uses rax, rcx and rdx; arm64 x16 and x17. }
procedure TEmitter.EmitDivConst(const X: string; C: Int64; IsMod: Boolean);
var
  k, sh, f, i, o: LongInt;
  m: Int64;
begin
  k := Pow2Log(C);
  if FArm then
  begin
    if C = 1 then
    begin
      if IsMod then
        Line('  mov ' + X + ', xzr');
      Exit;
    end;
    if k > 0 then
    begin
      Line('  asr x16, ' + X + ', #63');
      Line('  lsr x16, x16, #' + IntToStr(64 - k));
      Line('  add x16, ' + X + ', x16');
      Line('  asr x16, x16, #' + IntToStr(k));
      if IsMod then
      begin
        Line('  lsl x16, x16, #' + IntToStr(k));
        Line('  sub ' + X + ', ' + X + ', x16');
      end
      else
        Line('  mov ' + X + ', x16');
      Exit;
    end;
    SMagic64(C, m, sh);
    if (m and 1) = 0 then
    begin
      Imm('x17', m shr 1);
      Line('  smulh x16, ' + X + ', x17');
      if sh > 1 then
        Line('  asr x16, x16, #' + IntToStr(sh - 1));
    end
    else
    begin
      Imm('x17', m);
      Line('  smulh x16, ' + X + ', x17');
      Line('  add x16, x16, ' + X);
      if sh > 0 then
        Line('  asr x16, x16, #' + IntToStr(sh));
    end;
    Line('  sub x16, x16, ' + X + ', asr #63');
    if IsMod then
      ScaleSubArm(X, X, 'x16', C, 'x17')
    else
      Line('  mov ' + X + ', x16');
    Exit;
  end;
  if C = 1 then
  begin
    if IsMod then
      Line('  movq $0, ' + X);
    Exit;
  end;
  if X <> '%rcx' then
    Line('  movq ' + X + ', %rcx');
  if k > 0 then
  begin
    Line('  movq %rcx, %rdx');
    Line('  sarq $63, %rdx');
    Line('  shrq $' + IntToStr(64 - k) + ', %rdx');
    Line('  addq %rcx, %rdx');
    Line('  sarq $' + IntToStr(k) + ', %rdx');
    if IsMod then
    begin
      Line('  shlq $' + IntToStr(k) + ', %rdx');
      Line('  subq %rdx, %rcx');
      Line('  movq %rcx, ' + X);
    end
    else
      Line('  movq %rdx, ' + X);
    Exit;
  end;
  SMagic64(C, m, sh);
  if (m and 1) = 0 then
  begin
    Line('  movabsq $' + IntToStr(m shr 1) + ', %rax');
    Line('  imulq %rcx');
    if sh > 1 then
      Line('  sarq $' + IntToStr(sh - 1) + ', %rdx');
  end
  else
  begin
    Line('  movabsq $' + IntToStr(m) + ', %rax');
    Line('  imulq %rcx');
    Line('  addq %rcx, %rdx');
    if sh > 0 then
      Line('  sarq $' + IntToStr(sh) + ', %rdx');
  end;
  Line('  movq %rcx, %rax');
  Line('  sarq $63, %rax');
  Line('  subq %rax, %rdx');
  if IsMod then
  begin
    { x - q * C with q * C the recipe ScaleTo gives it where that costs
      less than IMUL on the tune, its second value in rax, free past the
      quotient: Go rewrites x % c as x - (x / c) * c and reduces the
      product as any other (generic.rules Mod64; AMD64.rules MULQconst),
      so go1.27.2 writes x mod 7 as two leas and a sub (P312) }
    if Fits32(C) or MulRecipe(C, f, i, o) then
      ScaleTo('%rdx', '%rdx', C, '%rax')
    else
    begin
      Line('  movabsq $' + IntToStr(C) + ', %rax');
      Line('  imulq %rax, %rdx');
    end;
    Line('  subq %rdx, %rcx');
    Line('  movq %rcx, ' + X);
  end
  else
    Line('  movq %rdx, ' + X);
end;

{ Word loads and stores (P94). A value of one word or one byte (an
  integer, a pointer, a Boolean, a class reference, a Char) held in a
  variable or reached through a pointer, a record or class field or an
  index is loaded into the register pool and stored from it; the
  address is worked out in pool registers too, so none of it goes
  through the stack. What cannot be done this way (a nested routine's
  variable, a real, a string or a record value) keeps the old path. }

function TEmitter.WordVar(E: PExpr; out S: TSym): Boolean;
var
  k: TTypeKind;
  sz: LongInt;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekVar) then
    Exit;
  if not TryFindSym(E^.Name, S) then
    Exit;
  if S.ByRef or (S.Up <> 0) then
    Exit;
  if IsFat(S.Typ) or IsBlob(S.Typ) then
    Exit;
  sz := TSize(S.Typ);
  if (sz <> 8) and (sz <> 1) and (sz <> 2) and (sz <> 4) then
    Exit;
  k := TKind(S.Typ);
  if (k = tykReal) or (k = tykSet) or (k = tykInterface) or (k = tykMethod) or
    (k = tykArray) or (k = tykRecord) then
    Exit;
  Result := True;
end;

{ A load of E gives one scalar word or byte. }
function TEmitter.WordScalar(E: PExpr): Boolean;
var
  k: TTypeKind;
  sz: LongInt;
begin
  Result := False;
  if E = nil then
    Exit;
  if IsFat(E^.Typ) or IsBlob(E^.Typ) then
    Exit;
  k := TKind(E^.Typ);
  if (k = tykReal) or (k = tykSet) or (k = tykInterface) or (k = tykMethod) or
    (k = tykArray) or (k = tykRecord) then
    Exit;
  sz := LoadSize(E);
  Result := (sz = 8) or (sz = 1) or (sz = 2) or (sz = 4);
end;

{ ---- A product by a constant (P295) ----

  x * K as one or two of the instructions that compute a*x + b*y, as Go
  writes it when that costs less than a multiply (cmd/compile/internal/
  ssa/config.go BuildRecipes; rewrite.go MulStrengthReduce; ARM64.rules
  and AMD64.rules, MUL and MULQconst by a constant). The one-instruction
  combinations: on arm64 add, neg and sub (10), add, neg and sub with the
  second operand shifted left by 1 to 63 and a shift by 1 to 63, their
  costs and a multiply's those of the processor -cpu or $TUNE names
  (CpuShiftAddCostArm, CpuMulCostArm: Neoverse N1's MUL takes 4 cycles,
  N2's and V2's 2); on amd64 Go's (add and lea by 2, 4 and 8 10, neg,
  sub and a shift 11, a multiply 30: IMUL takes 3 cycles on Zen 2, AMD
  17h 30h latencies, and an add, a shift and a lea of two parts 1). A
  recipe is one of them on x and x, or two: the second on the first's
  result twice (A), on x and the first's result (B), or on the first's
  result and x (C), the cheapest under a multiply. }

procedure TEmitter.MulCombos;
var
  i: LongInt;

  procedure R(A, B: Int64; Cost, Kind, Sh: LongInt);
  var
    n: SizeInt;
  begin
    n := Length(FMulC);
    SetLength(FMulC, n + 1);
    FMulC[n].A := A;
    FMulC[n].B := B;
    FMulC[n].Cost := Cost;
    FMulC[n].Kind := Kind;
    FMulC[n].Sh := Sh;
  end;

begin
  if FArm then
  begin
    if FMulCTune = FTune then
      Exit;
    FMulCTune := FTune;
  end
  else
  begin
    if FMulCTune = 0 then
      Exit;
    FMulCTune := 0;
  end;
  FMulC := nil;
  FMulKs := nil;
  FMulForm := nil;
  FMulIn := nil;
  FMulOut := nil;
  if FArm then
  begin
    FMulCost := CpuMulCostArm(FTune);
    R(1, 1, 10, 1, 0);
    R(-1, 0, 10, 2, 0);
    R(1, -1, 10, 3, 0);
    for i := 1 to 63 do
    begin
      R(1, Int64(1) shl i, CpuShiftAddCostArm(FTune, i), 4, i);
      R(-(Int64(1) shl i), 0, CpuShiftAddCostArm(FTune, i), 5, i);
      R(1, -(Int64(1) shl i), CpuShiftAddCostArm(FTune, i), 6, i);
      if i = 1 then
        R(Int64(1) shl i, 0, 9, 7, i)
      else
        R(Int64(1) shl i, 0, 10, 7, i);
    end;
  end
  else
  begin
    FMulCost := 30;
    R(1, 1, 10, 1, 0);
    R(-1, 0, 11, 2, 0);
    R(1, -1, 11, 3, 0);
    R(1, 2, 10, 8, 1);
    R(1, 4, 10, 8, 2);
    R(1, 8, 10, 8, 3);
    for i := 2 to 63 do
      R(Int64(1) shl i, 0, 11, 7, i);
  end;
end;

{ The recipe for x * K: Form 1 one combination (Inner), 2 to 4 two (A, B,
  C above), the cheapest under a multiply, as Go builds its table; False
  when a multiply costs no more. Found once a constant. }
function TEmitter.MulRecipe(K: Int64; out Form, Inner, Outer: LongInt): Boolean;
var
  i, o, n: SizeInt;
  best, c: LongInt;
  vi: Int64;
begin
  MulCombos;
  for i := 0 to High(FMulKs) do
    if FMulKs[i] = K then
    begin
      Form := LongInt(FMulForm[i]);
      Inner := LongInt(FMulIn[i]);
      Outer := LongInt(FMulOut[i]);
      Result := Form <> 0;
      Exit;
    end;
  Form := 0;
  Inner := 0;
  Outer := 0;
  best := FMulCost;
  for i := 0 to High(FMulC) do
    if (FMulC[i].A + FMulC[i].B = K) and (FMulC[i].Cost < best) then
    begin
      best := FMulC[i].Cost;
      Form := 1;
      Inner := LongInt(i);
    end;
  for i := 0 to High(FMulC) do
  begin
    vi := FMulC[i].A + FMulC[i].B;
    for o := 0 to High(FMulC) do
    begin
      c := FMulC[i].Cost + FMulC[o].Cost;
      if c >= best then
        Continue;
      if vi * (FMulC[o].A + FMulC[o].B) = K then
      begin
        best := c;
        Form := 2;
        Inner := LongInt(i);
        Outer := LongInt(o);
      end
      else if (FMulC[o].B <> 0) and (FMulC[o].A + FMulC[o].B * vi = K) then
      begin
        best := c;
        Form := 3;
        Inner := LongInt(i);
        Outer := LongInt(o);
      end
      else if (FMulC[o].B <> 0) and (FMulC[o].A * vi + FMulC[o].B = K) then
      begin
        best := c;
        Form := 4;
        Inner := LongInt(i);
        Outer := LongInt(o);
      end;
    end;
  end;
  n := Length(FMulKs);
  SetLength(FMulKs, n + 1);
  SetLength(FMulForm, n + 1);
  SetLength(FMulIn, n + 1);
  SetLength(FMulOut, n + 1);
  FMulKs[n] := K;
  FMulForm[n] := Form;
  FMulIn[n] := Inner;
  FMulOut[n] := Outer;
  Result := Form <> 0;
end;

{ arm64: D := a*X + b*Y of the combination C (ARM DDI 0487 M.c: ADD,
  SUB and NEG of a shifted register, C6.2.6, C6.2.458, C6.2.295; LSL
  immediate, C6.2.270). }
procedure TEmitter.MulComboArm(const C: TMulCombo; const D, X, Y: string);
var
  sh: string;
begin
  sh := IntToStr(C.Sh);
  case C.Kind of
    1: Line('  add ' + D + ', ' + X + ', ' + Y);
    2: Line('  neg ' + D + ', ' + X);
    3: Line('  sub ' + D + ', ' + X + ', ' + Y);
    4: Line('  add ' + D + ', ' + X + ', ' + Y + ', lsl #' + sh);
    5: Line('  neg ' + D + ', ' + X + ', lsl #' + sh);
    6: Line('  sub ' + D + ', ' + X + ', ' + Y + ', lsl #' + sh);
  else
    Line('  lsl ' + D + ', ' + X + ', #' + sh);
  end;
end;

{ amd64: D := a*X + b*Y of the combination C, registers written with %:
  an add, sub, neg or shift works on D in place, a move first when D is
  not X; a lea of two parts with no displacement (SDM vol. 2A 3-547
  LEA). }
procedure TEmitter.MulComboX86(const C: TMulCombo; const D, X, Y: string);
begin
  case C.Kind of
    1:
      if D = X then
        Line('  addq ' + Y + ', ' + D)
      else if D = Y then
        Line('  addq ' + X + ', ' + D)
      else
        Line('  leaq (' + X + ',' + Y + '), ' + D);
    2:
      begin
        if D <> X then
          Line('  movq ' + X + ', ' + D);
        Line('  negq ' + D);
      end;
    3:
      if D = X then
        Line('  subq ' + Y + ', ' + D)
      else if D = Y then
      begin
        Line('  negq ' + D);
        Line('  addq ' + X + ', ' + D);
      end
      else
      begin
        Line('  movq ' + X + ', ' + D);
        Line('  subq ' + Y + ', ' + D);
      end;
    8: Line('  leaq (' + X + ',' + Y + ',' + IntToStr(Int64(1) shl C.Sh) + '), ' + D);
  else
    begin
      if D <> X then
        Line('  movq ' + X + ', ' + D);
      Line('  shlq $' + IntToStr(C.Sh) + ', ' + D);
    end;
  end;
end;

{ R := R * K by a recipe, R's register named as its machine writes it
  (with % on amd64), when one costs less than a multiply; the second
  value of a form B or C goes through x17 on arm64 and rax (rcx when R
  is rax) on amd64. False with nothing written when none does, and on
  amd64 for r13 and rbp, which are never a lea's base beside an index
  (P294). }
function TEmitter.MulByK(const R: string; K: Int64): Boolean;
begin
  Result := MulByKTo(R, R, K);
end;

{ D := S * K by a recipe, as MulByK: the first instruction reads S, and
  D takes the result; S stays when it is not D (P295). }
function TEmitter.MulByKTo(const D, S: string; K: Int64): Boolean;
var
  f, i, o: LongInt;
  t: string;
begin
  Result := False;
  { x * 1 is x and x * 0 is 0, as Go's rules fold them (generic.rules;
    P312); the 0 a move, which leaves the flags as they are }
  if K = 1 then
  begin
    if D <> S then
    begin
      if FArm then
        Line('  mov ' + D + ', ' + S)
      else
        Line('  movq ' + S + ', ' + D);
    end;
    Result := True;
    Exit;
  end;
  if K = 0 then
  begin
    if FArm then
      Line('  mov ' + D + ', xzr')
    else
      Line('  movl $0, %' + X86Sub(Copy(D, 2, Length(D) - 1), 4));
    Result := True;
    Exit;
  end;
  if (not FArm) and ((S = '%r13') or (S = '%rbp') or (D = '%r13') or (D = '%rbp')) then
    Exit;
  if not MulRecipe(K, f, i, o) then
    Exit;
  Result := True;
  if FArm then
    t := 'x17'
  else if (D <> '%rax') and (S <> '%rax') then
    t := '%rax'
  else if (D <> '%rcx') and (S <> '%rcx') then
    t := '%rcx'
  else
    t := '%rdx';
  MulRecipeVia(D, S, f, i, o, t);
end;

{ D := S * K by a recipe where it costs less than a multiply, the free
  registers T1 and T2 (neither D nor S, '' for none) the caller names
  (P312): a recipe's second value goes through one of them; on amd64 a
  source of r13 or rbp, no lea's base beside an index (P294), is moved
  to T1 first, and a destination of either takes a recipe whose second
  step adds it to itself in a lea through a free one and a move, each
  move counted as an add (Zen 2's MOV of a register takes 1 cycle, AMD
  17h 30h latencies), so x * 3 from r13 is a move and a lea, 2 cycles
  where IMUL takes 3. A recipe of two steps on the first's value twice
  (form 2) is the product of their values, so either step goes first:
  the lea goes where its base, the value it reads, is not r13 or rbp, so
  -3 * k into r13 is a lea of k and a neg of r13. x * 1 is x and x * 0
  is 0, as Go's rules fold them (generic.rules, Mul64 by Const64 [1] and
  [0]). False with nothing written otherwise. }
function TEmitter.MulByKVia(const D, S: string; K: Int64; const T1, T2: string): Boolean;
var
  f, i, o, c, w: LongInt;
  src, dst, ta, tb: string;
  slows, slowd, swap: Boolean;
begin
  Result := False;
  if K = 1 then
  begin
    if D <> S then
    begin
      if FArm then
        Line('  mov ' + D + ', ' + S)
      else
        Line('  movq ' + S + ', ' + D);
    end;
    Result := True;
    Exit;
  end;
  if K = 0 then
  begin
    if FArm then
      Line('  mov ' + D + ', xzr')
    else
      Line('  xorl %' + X86Sub(Copy(D, 2, Length(D) - 1), 4) + ', %' +
        X86Sub(Copy(D, 2, Length(D) - 1), 4));
    Result := True;
    Exit;
  end;
  if not MulRecipe(K, f, i, o) then
    Exit;
  if FArm then
  begin
    if (f > 2) and (T1 = '') then
      Exit;
    MulRecipeVia(D, S, f, i, o, T1);
    Result := True;
    Exit;
  end;
  slows := (S = '%r13') or (S = '%rbp');
  slowd := (D = '%r13') or (D = '%rbp');
  swap := slows and ((FMulC[i].Kind = 1) or (FMulC[i].Kind = 8)) and
    (FMulC[o].Kind <> 8) and not slowd;
  if slowd and (FMulC[o].Kind = 8) and (FMulC[i].Kind <> 8) and
    not (slows and (FMulC[i].Kind = 1)) then
    swap := True;
  if (f = 2) and swap then
  begin
    w := i;
    i := o;
    o := w;
  end;
  c := FMulC[i].Cost;
  if f > 1 then
    c := c + FMulC[o].Cost;
  src := S;
  ta := T1;
  tb := T2;
  if slows and ((f > 2) or (FMulC[i].Kind = 1) or (FMulC[i].Kind = 8)) then
  begin
    if T1 = '' then
      Exit;
    src := T1;
    ta := T2;
    tb := '';
    c := c + 10;
  end;
  dst := D;
  if ((D = '%r13') or (D = '%rbp')) and (f = 2) and (FMulC[o].Kind = 8) then
  begin
    if ta = '' then
      Exit;
    dst := ta;
    ta := tb;
    c := c + 10;
  end;
  if ((f = 3) or (f = 4)) and (ta = '') then
    Exit;
  if c >= FMulCost then
    Exit;
  if src <> S then
    Line('  movq ' + S + ', ' + src);
  MulRecipeVia(dst, src, f, i, o, ta);
  if dst <> D then
    Line('  movq ' + dst + ', ' + D);
  Result := True;
end;

{ D := S * K by the recipe F, I, O of MulRecipe, the second value of a
  form 3 or 4 through T (P295, P310). }
procedure TEmitter.MulRecipeVia(const D, S: string; F, I, O: LongInt; const T: string);
begin
  if FArm then
  begin
    case F of
      1: MulComboArm(FMulC[I], D, S, S);
      2:
        begin
          MulComboArm(FMulC[I], D, S, S);
          MulComboArm(FMulC[O], D, D, D);
        end;
      3:
        { S + (S << n) and S - (S << n) are one ADD or SUB of a shifted
          register, as Go folds an SLLconst operand into ADDshiftLL and
          SUBshiftLL after the recipe (ARM64.rules; go1.27.2 writes x * 3
          as ADD R0<<1, R0, R0): one instruction where two were (P312) }
        if (FMulC[I].Kind = 7) and (FMulC[O].Kind = 1) then
          Line('  add ' + D + ', ' + S + ', ' + S + ', lsl #' + IntToStr(FMulC[I].Sh))
        else if (FMulC[I].Kind = 7) and (FMulC[O].Kind = 3) then
          Line('  sub ' + D + ', ' + S + ', ' + S + ', lsl #' + IntToStr(FMulC[I].Sh))
        else
        begin
          MulComboArm(FMulC[I], T, S, S);
          MulComboArm(FMulC[O], D, S, T);
        end;
    else
      if (FMulC[I].Kind = 7) and (FMulC[O].Kind = 1) then
        Line('  add ' + D + ', ' + S + ', ' + S + ', lsl #' + IntToStr(FMulC[I].Sh))
      else
      begin
        MulComboArm(FMulC[I], T, S, S);
        MulComboArm(FMulC[O], D, T, S);
      end;
    end;
    Exit;
  end;
  case F of
    1: MulComboX86(FMulC[I], D, S, S);
    2:
      { the two steps on the value before twice multiply, so either goes
        first: a neg or a shift, which work in place, would move S into
        another D first, so the lea or the add reads S and the other step
        works on D, x * -3 a lea and a neg where Go's table writes a move,
        a neg and a lea (config.go BuildRecipes, A); r13 and rbp no lea's
        base beside an index (P294) (P317) }
      if (D <> S) and ((FMulC[I].Kind = 2) or (FMulC[I].Kind = 7)) and
        ((FMulC[O].Kind = 1) or (FMulC[O].Kind = 8)) and (S <> '%r13') and (S <> '%rbp') then
      begin
        MulComboX86(FMulC[O], D, S, S);
        MulComboX86(FMulC[I], D, D, D);
      end
      else
      begin
        MulComboX86(FMulC[I], D, S, S);
        MulComboX86(FMulC[O], D, D, D);
      end;
    3:
      begin
        MulComboX86(FMulC[I], T, S, S);
        MulComboX86(FMulC[O], D, S, T);
      end;
  else
    begin
      MulComboX86(FMulC[I], T, S, S);
      MulComboX86(FMulC[O], D, T, S);
    end;
  end;
end;

{ D := S * K, K the size of an element or the scale of a count (P310):
  a move for 1, a shift for a power of two, else the recipe of MulRecipe
  where it costs less than a multiply on this tune, as Go multiplies by
  a constant (cmd/compile/internal/ssa/_gen/AMD64.rules and ARM64.rules,
  MULQconst and MULconst), its second value through Tmp for a recipe of
  two (none with Tmp ''), else the multiply: IMUL of an immediate on
  amd64, the constant in Tmp (x16 with Tmp '') and MUL on arm64. A shift
  takes 1 cycle where IMUL r64 takes 3 on Zen 2 and Skylake (AMD 17h 30h
  latencies; Intel 336289-001) and MUL of X form 4 on Neoverse N1
  (arm-neoverse-n1-sog 3.6). Registers as the machine writes them, % on
  amd64; r13 and rbp take no lea of a recipe beside an index (P294). }
procedure TEmitter.ScaleTo(const D, S: string; K: Int64; const Tmp: string);
var
  f, i, o, sh: LongInt;
  t: string;
begin
  if K = 1 then
  begin
    if D <> S then
    begin
      if FArm then
        Line('  mov ' + D + ', ' + S)
      else
        Line('  movq ' + S + ', ' + D);
    end;
    Exit;
  end;
  sh := Pow2Log(K);
  if sh > 0 then
  begin
    if FArm then
      Line('  lsl ' + D + ', ' + S + ', #' + IntToStr(sh))
    else if (D <> S) and (sh = 1) and (S <> '%r13') and (S <> '%rbp') then
      Line('  leaq (' + S + ',' + S + '), ' + D)
    else if (D <> S) and (sh <= 3) then
      { one lea of the index alone where a move and a shift were two }
      Line('  leaq 0(,' + S + ',' + IntToStr(K) + '), ' + D)
    else
    begin
      if D <> S then
        Line('  movq ' + S + ', ' + D);
      Line('  shlq $' + IntToStr(sh) + ', ' + D);
    end;
    Exit;
  end;
  if MulRecipe(K, f, i, o) and ((f <= 2) or (Tmp <> '') or (D <> S)) and
    (FArm or not ((S = '%r13') or (S = '%rbp') or (D = '%r13') or (D = '%rbp'))) then
  begin
    { a recipe of two values with no Tmp takes D for the first when D is
      not S: forms 3 and 4 write D last from S and it, so x * 7 into
      another register is two leas where it was IMUL (P313) }
    t := Tmp;
    if (t = '') and (f > 2) then
      t := D;
    MulRecipeVia(D, S, f, i, o, t);
    Exit;
  end;
  if FArm then
  begin
    t := Tmp;
    if t = '' then
      t := 'x16';
    if t = S then
      t := 'x17';
    Imm(t, K);
    Line('  mul ' + D + ', ' + S + ', ' + t);
  end
  else if D = S then
    Line('  imulq $' + IntToStr(K) + ', ' + D)
  else
    Line('  imulq $' + IntToStr(K) + ', ' + S + ', ' + D);
end;

{ arm64: D := B + X * K, K an element's size (P310): one ADD with X
  shifted for a power of two (ARM DDI 0487 M.c C6.2.6, 1 cycle for a
  shift of 4 or less on Neoverse N1, 2 past it, CpuShiftAddCostArm);
  else the cheapest on this tune of K's recipe into T1 and an ADD, of
  the recipe of m into T1 and an ADD of T1 shifted by s for K = m * 2^s
  (Go's rules make 24 * x ADDshiftLL x x [1] and the shift a part of the
  add that follows), and of K in T1 and one MADD (C6.2.275); a recipe's
  second value through T2 (none with T2 ''). T1 is neither B nor X. }
procedure TEmitter.ScaleAddArm(const D, B, X: string; K: Int64; const T1, T2: string);
var
  f, i, o, sh, c, best, way, fm, im, om, s: LongInt;
  m: Int64;
begin
  if K = 1 then
  begin
    Line('  add ' + D + ', ' + B + ', ' + X);
    Exit;
  end;
  sh := Pow2Log(K);
  if (sh > 0) and (sh <= 63) then
  begin
    Line('  add ' + D + ', ' + B + ', ' + X + ', lsl #' + IntToStr(sh));
    Exit;
  end;
  MulCombos;
  best := FMulCost;
  way := 0;
  f := 0;
  i := 0;
  o := 0;
  fm := 0;
  im := 0;
  om := 0;
  if MulRecipe(K, f, i, o) and ((f <= 2) or (T2 <> '')) then
  begin
    c := FMulC[i].Cost + 10;
    if f > 1 then
      c := c + FMulC[o].Cost;
    if c < best then
    begin
      best := c;
      way := 1;
    end;
  end;
  s := 0;
  m := K;
  while (m and 1) = 0 do
  begin
    m := m shr 1;
    Inc(s);
  end;
  if (s > 0) and (m > 1) and MulRecipe(m, fm, im, om) and ((fm <= 2) or (T2 <> '')) then
  begin
    c := FMulC[im].Cost + CpuShiftAddCostArm(FTune, s);
    if fm > 1 then
      c := c + FMulC[om].Cost;
    if c < best then
    begin
      best := c;
      way := 2;
    end;
  end;
  case way of
    1:
      begin
        MulRecipeVia(T1, X, f, i, o, T2);
        Line('  add ' + D + ', ' + B + ', ' + T1);
      end;
    2:
      begin
        MulRecipeVia(T1, X, fm, im, om, T2);
        Line('  add ' + D + ', ' + B + ', ' + T1 + ', lsl #' + IntToStr(s));
      end;
  else
    begin
      Imm(T1, K);
      Line('  madd ' + D + ', ' + X + ', ' + T1 + ', ' + B);
    end;
  end;
end;

{ arm64: D := B - X * K for K past 1 and no power of two, the
  remainder's multiply back (P312); X and T may change, T is neither B
  nor X. The cheapest on this tune of: for K = 2^s - 1 an ADD of B and X
  into T and a SUB of X shifted by s from it, for K = 2^s + 1 a SUB and
  the same SUB shifted (B - X * K is B + X - (X << s), or B - X - (X <<
  s): go1.27.2 writes x mod 7 as ADD and SUB shifted by 3); K's recipe in
  X, its second value through T, and a SUB; the recipe of m in X and a
  SUB of X shifted by s for K = m * 2^s; and K in T and one MSUB (ARM DDI
  0487 M.c C6.2.291; SUB of a shifted register C6.2.458). On Neoverse N1
  MSUB of X form takes 4 cycles and keeps the multiplier 2 more, an ADD
  or SUB shifted by 4 or less 1 (arm-neoverse-n1-sog 3.6 and 3.4). }
procedure TEmitter.ScaleSubArm(const D, B, X: string; K: Int64; const T: string);
var
  f, i, o, fm, im, om, s, sp, sm, c, best, way: LongInt;
  m: Int64;
begin
  MulCombos;
  best := FMulCost;
  way := 0;
  f := 0;
  i := 0;
  o := 0;
  fm := 0;
  im := 0;
  om := 0;
  sp := -1;
  sm := -1;
  if K < High(Int64) then
    sp := Pow2Log(K + 1);
  if sp > 0 then
  begin
    c := 10 + CpuShiftAddCostArm(FTune, sp);
    if c < best then
    begin
      best := c;
      way := 1;
    end;
  end;
  sm := Pow2Log(K - 1);
  if sm > 0 then
  begin
    c := 10 + CpuShiftAddCostArm(FTune, sm);
    if c < best then
    begin
      best := c;
      way := 2;
    end;
  end;
  if MulRecipe(K, f, i, o) then
  begin
    c := FMulC[i].Cost + 10;
    if f > 1 then
      c := c + FMulC[o].Cost;
    if c < best then
    begin
      best := c;
      way := 3;
    end;
  end;
  s := 0;
  m := K;
  while (m > 1) and ((m and 1) = 0) do
  begin
    m := m shr 1;
    Inc(s);
  end;
  if (s > 0) and (m > 1) and MulRecipe(m, fm, im, om) then
  begin
    c := FMulC[im].Cost + CpuShiftAddCostArm(FTune, s);
    if fm > 1 then
      c := c + FMulC[om].Cost;
    if c < best then
    begin
      best := c;
      way := 4;
    end;
  end;
  case way of
    1:
      begin
        Line('  add ' + T + ', ' + B + ', ' + X);
        Line('  sub ' + D + ', ' + T + ', ' + X + ', lsl #' + IntToStr(sp));
      end;
    2:
      begin
        Line('  sub ' + T + ', ' + B + ', ' + X);
        Line('  sub ' + D + ', ' + T + ', ' + X + ', lsl #' + IntToStr(sm));
      end;
    3:
      begin
        MulRecipeVia(X, X, f, i, o, T);
        Line('  sub ' + D + ', ' + B + ', ' + X);
      end;
    4:
      begin
        MulRecipeVia(X, X, fm, im, om, T);
        Line('  sub ' + D + ', ' + B + ', ' + X + ', lsl #' + IntToStr(s));
      end;
  else
    begin
      Imm(T, K);
      Line('  msub ' + D + ', ' + X + ', ' + T + ', ' + B);
    end;
  end;
end;

{ amd64: D := B + X * K, X a register the scale may change (P310): X * m
  by ScaleTo for K = m * 2^s, s up to 3, then one LEA of B and X scaled
  by 2^s (SDM vol. 2A table 2-3: the SIB byte scales by 1, 2, 4 or 8),
  so 24 is a lea of X by 3 and the base's lea by 8; for s of 0 an ADD
  when D is B or X. B is neither r13 nor rbp. }
procedure TEmitter.ScaleAddX86(const D, B, X: string; K: Int64; const Tmp: string);
var
  s: LongInt;
  m: Int64;
begin
  s := 0;
  m := K;
  while (s < 3) and (m > 1) and ((m and 1) = 0) do
  begin
    m := m shr 1;
    Inc(s);
  end;
  ScaleTo(X, X, m, Tmp);
  if s > 0 then
    Line('  leaq (' + B + ',' + X + ',' + IntToStr(Int64(1) shl s) + '), ' + D)
  else if D = X then
    Line('  addq ' + B + ', ' + D)
  else if D = B then
    Line('  addq ' + X + ', ' + D)
  else
    Line('  leaq (' + B + ',' + X + '), ' + D);
end;

{ amd64 (P329): rax := Disp(B) + rax * K, B rbp and Disp a frame
  variable's offset, or B none and Disp a global's label: its absolute
  address, the programs being static as EmitWordMem's v_a-8(,%rdi,8)
  takes it (SDM vol. 2A table 2-3, mod 00 with base 101 and an index:
  disp32 plus the scaled index). rax * m by ScaleTo for K = m * 2^s, s
  up to 3, and one LEA where the base's and the element's were two. }
procedure TEmitter.ScaleAtX86(const Disp, B: string; K: Int64);
var
  s: LongInt;
  m: Int64;
begin
  s := 0;
  m := K;
  while (s < 3) and (m > 1) and ((m and 1) = 0) do
  begin
    m := m shr 1;
    Inc(s);
  end;
  ScaleTo('%rax', '%rax', m, '%rdx');
  Line('  leaq ' + Disp + '(' + B + ',%rax,' + IntToStr(Int64(1) shl s) + '), %rax');
end;

{ amd64: D := B + X * K + Disp, X kept, D not B (P310): for K = m * 2^s,
  s up to 3, X * m into D by ScaleTo and one LEA of B, D scaled by 2^s
  and Disp; for m of 1 the LEA reads X itself, one instruction where a
  multiply and a lea were two. }
procedure TEmitter.ScaleAddDispX86(const D, B, X: string; K, Disp: Int64; const Tmp: string);
var
  s: LongInt;
  m: Int64;
  xr: string;
begin
  s := 0;
  m := K;
  while (s < 3) and (m > 1) and ((m and 1) = 0) do
  begin
    m := m shr 1;
    Inc(s);
  end;
  xr := X;
  if m <> 1 then
  begin
    ScaleTo(D, X, m, Tmp);
    xr := D;
  end;
  Line('  leaq ' + IntToStr(Disp) + '(' + B + ',' + xr + ',' + IntToStr(Int64(1) shl s) + '), ' + D);
end;

{ R := R * Op with Op an immediate (or a register/memory operand),
  R written with its % (1.1.1): a multiply by 2, 4, 8 is a shift and by
  3, 5, 9 one lea, as Go writes them, one cycle where imul takes three
  in the chain of every hash mixer. }
procedure TEmitter.MulImm(const Op, R: string);
var
  k: Int64;
begin
  { a product by a constant as Go's recipes make it (P295) }
  if (Length(Op) > 1) and (Op[1] = '$') and StrToInt64(Copy(Op, 2, Length(Op) - 1), k) and
    MulByK(R, k) then
    Exit;
  if Op = '$2' then
    Line('  shlq $1, ' + R)
  else if Op = '$4' then
    Line('  shlq $2, ' + R)
  else if Op = '$8' then
    Line('  shlq $3, ' + R)
  else if Op = '$3' then
    Line('  leaq (' + R + ',' + R + ',2), ' + R)
  else if Op = '$5' then
    Line('  leaq (' + R + ',' + R + ',4), ' + R)
  else if Op = '$9' then
    Line('  leaq (' + R + ',' + R + ',8), ' + R)
  else if Op[1] = '$' then
    Line('  imulq ' + Op + ', ' + R + ', ' + R)
  else
    Line('  imulq ' + Op + ', ' + R);
end;

{ Inside a promoted region amd64 lends r9 and r10 to variables, so the
  pool is rsi, rdi, r8 and r11 there (P96). }
function TEmitter.PoolSize: LongInt;
begin
  if FArm then
    Result := 7
  else if FPromoOn then
  begin
    if FR8Lent then
      Result := 2
    else
      Result := 3;
  end
  else
    Result := 6;
  { r11 and r10 keep a call's code and second word while an argument is
    worked out (P297): rsi, rdi and r8, as inside a region }
  if (FPoolCap > 0) and (Result > FPoolCap) then
    Result := FPoolCap;
end;

function TEmitter.IndexOK(I: PExpr; D: LongInt): Boolean;
var
  s: TSym;
begin
  Result := False;
  if I = nil then
    Exit;
  { A constant or a variable a loop keeps in a register is used where it
    is (EmitWordMem): it needs no pool register, so hist[data[i]] fits
    the three amd64 lends inside a promoted loop (P100). }
  if (I^.Kind = ekInt) or ((I^.Kind = ekVar) and WordVar(I, s) and (s.Reg <> '')) then
  begin
    Result := True;
    Exit;
  end;
  Result := (D < PoolSize) and OrdSimple(I, D);
end;

{ The address of the record or array B can be put in pool register D. }
function TEmitter.WordBaseOK(B: PExpr; D: LongInt): Boolean;
var
  s: TSym;
begin
  Result := False;
  if (B = nil) or (D >= PoolSize) then
    Exit;
  if B^.Kind = ekStr then
  begin
    { A string literal: its bytes have a label (a string constant too). }
    Result := True;
    Exit;
  end;
  if B^.Kind = ekVar then
  begin
    if TryFindSym(B^.Name, s) then
      Result := (s.Up = 0) and (s.Reg = '');
    Exit;
  end;
  if (B^.Kind = ekDeref) or (B^.Kind = ekField) or (B^.Kind = ekIndex) then
    Result := WordMemOK(B, D);
end;

{ The pointer word (and so the length word) of the string or slice B can
  be put in pool register D. }
function TEmitter.FatPtrOK(B: PExpr; D: LongInt): Boolean;
begin
  Result := WordBaseOK(B, D);
end;

{ The place E (a dereference, a field or an index) can be addressed from
  pool register D, with D+1 for an index. }
function TEmitter.WordMemOK(E: PExpr; D: LongInt): Boolean;
var
  k: TTypeKind;
  esz: Int64;
begin
  Result := False;
  if (E = nil) or (E^.L = nil) or (D >= PoolSize) or PtrAccess(E) then
    Exit;
  case E^.Kind of
    ekDeref:
      Result := (TKind(E^.L^.Typ) = tykPointer) and OrdSimple(E^.L, D);
    ekField:
      if TKind(E^.L^.Typ) = tykClass then
        Result := OrdSimple(E^.L, D)
      else
        Result := WordBaseOK(E^.L, D);
    ekIndex:
      if E^.R <> nil then
      begin
        k := TKind(E^.L^.Typ);
        if IsStr(E^.L^.Typ) or IsDyn(E^.L^.Typ) then
          Result := FatPtrOK(E^.L, D) and IndexOK(E^.R, D + 1)
        else if k = tykArray then
          Result := WordBaseOK(E^.L, D) and IndexOK(E^.R, D + 1)
        else if k = tykPointer then
          Result := OrdSimple(E^.L, D) and IndexOK(E^.R, D + 1);
        { an element of 3, 5, 6, 7 or more than 8 bytes: amd64 scales the
          index in pool register D + 1 (EmitWordMem), even one a loop
          keeps in a register, which IndexOK takes as needing none; in a
          promoted region D + 1 may be past the pool, r11, the end of an
          inner for's run (P203: Shapes[sh] of 56 bytes ran a loop past
          its limit) }
        if Result and (not FArm) and (E^.R^.Kind <> ekInt) and (D + 1 >= PoolSize) then
        begin
          esz := TSize(FTypes[E^.L^.Typ].Elem);
          if IsStr(E^.L^.Typ) then
            esz := 1;
          if (esz <> 1) and (esz <> 2) and (esz <> 4) and (esz <> 8) then
            Result := False;
        end;
      end;
  end;
end;



{ One or eight bytes of the variable S into register R, zero-extended. }
procedure TEmitter.LoadWordVar(const S: TSym; const R: string);
begin
  if S.Reg <> '' then
  begin
    if FArm then
      Line('  mov ' + R + ', ' + S.Reg)
    else
      Line('  movq %' + S.Reg + ', %' + R);
    Exit;
  end;
  if TSize(S.Typ) = 8 then
  begin
    if FArm then
      LoadPlain(S, R)
    else
      Line('  movq ' + MemA(S) + ', %' + R);
    Exit;
  end;
  if FArm then
  begin
    if S.Global then
      LeaS(VarLabel(S.Name), 'x16')
    else
    begin
      AddFP('x16', S.Off);
    end;
    LoadTo('[x16]', S.Typ, R);
  end
  else
    LoadTo(MemA(S), S.Typ, R);
end;

procedure TEmitter.StoreWordVar(const S: TSym; const R: string);
begin
  { A register takes the whole clean value (P100). }
  if S.Reg <> '' then
  begin
    if FArm then
      Line('  mov ' + S.Reg + ', ' + R)
    else
      Line('  movq %' + R + ', %' + S.Reg);
    Exit;
  end;
  if TSize(S.Typ) = 8 then
  begin
    StorePlainFrom(S, R);
    Exit;
  end;
  if FArm then
  begin
    if S.Global then
      LeaS(VarLabel(S.Name), 'x16')
    else
    begin
      AddFP('x16', S.Off);
    end;
    StoreFrom('[x16]', TSize(S.Typ), R);
  end
  else
    StoreFrom(MemA(S), TSize(S.Typ), R);
end;

{ The register a region keeps var parameter B's address in (Part 4,
  P282), or ''. }
function TEmitter.ByRefReg(B: PExpr): string;
var
  s: TSym;
begin
  Result := '';
  if (B = nil) or (B^.Kind <> ekVar) or not FPromoOn then
    Exit;
  if not TryFindSym(B^.Name, s) then
    Exit;
  if s.ByRef and (s.Up = 0) and not s.Global then
    Result := PartReg(s, 4);
end;

{ The address of the record or array B into pool register D. }
procedure TEmitter.EmitWordBase(B: PExpr; D: LongInt);
var
  s: TSym;
  r, m, kr: string;
begin
  r := OrdPool(D);
  if B^.Kind = ekVar then
  begin
    if not TryFindSym(B^.Name, s) then
      Die('internal error: base ' + B^.Name);
    kr := ByRefReg(B);
    if kr <> '' then
    begin
      if FArm then
        Line('  mov ' + r + ', ' + kr)
      else
        Line('  movq %' + kr + ', %' + r);
      Exit;
    end;
    if FArm then
    begin
      if s.ByRef then
      begin
        if s.Global then
          LdS(VarLabel(s.Name), r)
        else
          LdFP(r, s.Off);
      end
      else if s.Global then
        LeaS(VarLabel(s.Name), r)
      else
      begin
        AddFP(r, s.Off);
      end;
    end
    else if s.ByRef then
    begin
      if s.Global then
        Line('  movq ' + VarLabel(s.Name) + '(%rip), %' + r)
      else
        Line('  movq ' + IntToStr(s.Off) + '(%rbp), %' + r);
    end
    else if s.Global then
      Line('  leaq ' + VarLabel(s.Name) + '(%rip), %' + r)
    else
      Line('  leaq ' + IntToStr(s.Off) + '(%rbp), %' + r);
    Exit;
  end;
  m := EmitWordMem(B, D);
  if FArm then
  begin
    { The address in r: EmitWordMem may leave it as base plus index or
      offset, or in a slice's register. }
    if FWmIdx <> '' then
      Line('  add ' + r + ', ' + FWmBase + ', ' + FWmIdx + ', lsl #' + IntToStr(FWmSh))
    else
      AddImmArm(r, FWmBase, FWmOff);
    Exit;
  end;
  if m <> '(%' + r + ')' then
    Line('  leaq ' + m + ', %' + r);
end;

{ The pointer word of the string or slice B into pool register D, or its
  length word when Len. }
procedure TEmitter.EmitFatWord(B: PExpr; D: LongInt; Len: Boolean);
var
  s: TSym;
  r, ok: string;
  o: LongInt;
begin
  r := OrdPool(D);
  if Len then
    o := 8
  else
    o := 0;
  if B^.Kind = ekStr then
  begin
    if Len then
    begin
      if FArm then
        Imm(r, Length(B^.Txt))
      else
        LoadImmR(r, Length(B^.Txt));
    end
    else if FArm then
      LeaS(InternStr(B^.Txt), r)
    else
      Line('  leaq ' + InternStr(B^.Txt) + '(%rip), %' + r);
    Exit;
  end;
  if (B^.Kind = ekVar) and TryFindSym(B^.Name, s) and (not s.ByRef) then
  begin
    if FArm then
    begin
      if s.Global then
      begin
        LeaS(VarLabel(s.Name), 'x16');
        Line('  ldr ' + r + ', [x16, #' + IntToStr(o) + ']');
      end
      else
        LdFP(r, s.Off + o);
    end
    else if s.Global then
      Line('  movq ' + VarLabel(s.Name) + '+' + IntToStr(o) + '(%rip), %' + r)
    else
      Line('  movq ' + IntToStr(s.Off + o) + '(%rbp), %' + r);
    Exit;
  end;
  if (B^.Kind = ekVar) and TryFindSym(B^.Name, s) and s.ByRef then
  begin
    { A string or slice passed by reference arrives as the address of its
      descriptor, and that address may be nil: then it is empty, as
      LoadVar has it (a nil check there since the start). }
    ok := Lab;
    EmitWordBase(B, D);
    if FArm then
    begin
      Line('  cbz ' + r + ', ' + ok);
      Line('  ldr ' + r + ', [' + r + ', #' + IntToStr(o) + ']');
    end
    else
    begin
      Line('  testq %' + r + ', %' + r);
      Line('  jz ' + ok);
      Line('  movq ' + IntToStr(o) + '(%' + r + '), %' + r);
    end;
    Line(ok + ':');
    Exit;
  end;
  EmitWordBase(B, D);
  if FArm then
    Line('  ldr ' + r + ', [' + r + ', #' + IntToStr(o) + ']')
  else
    Line('  movq ' + IntToStr(o) + '(%' + r + '), %' + r);
end;

{ The register that holds the pointer E: the register of a variable a
  region keeps there, used as it is, else pool register D after E is
  worked out into it. The caller only reads it (P96). }
function TEmitter.PtrReg(E: PExpr; D: LongInt): string;
var
  s: TSym;
begin
  if (E <> nil) and (E^.Kind = ekVar) and WordVar(E, s) and (s.Reg <> '') and
    (TSize(s.Typ) = 8) then
  begin
    Result := s.Reg;
    Exit;
  end;
  EmitOrdTo(E, D);
  Result := OrdPool(D);
end;

{ The scale a term of an address gives: i shl s (s 0..3) or i * m (m 1,
  2, 4, 8), the term and its index whole words; 0 when it is neither.
  Idx is the index (1.1.1). }
function TEmitter.ScaleOf(T: PExpr; out Idx: PExpr): Int64;
var
  a, b: PExpr;
begin
  Result := 0;
  Idx := nil;
  if (T = nil) or (T^.Kind <> ekBin) or (TSize(T^.Typ) <> 8) then
    Exit;
  a := T^.L;
  b := T^.R;
  if (a = nil) or (b = nil) then
    Exit;
  if (T^.Bin = boShl) and (b^.Kind = ekInt) and (b^.Num >= 0) and (b^.Num <= 3) and
    (TSize(a^.Typ) = 8) then
  begin
    Idx := a;
    Result := Int64(1) shl b^.Num;
    Exit;
  end;
  if T^.Bin = boMul then
  begin
    if (b^.Kind = ekInt) and (TSize(a^.Typ) = 8) and
      ((b^.Num = 1) or (b^.Num = 2) or (b^.Num = 4) or (b^.Num = 8)) then
    begin
      Idx := a;
      Result := b^.Num;
    end
    else if (a^.Kind = ekInt) and (TSize(b^.Typ) = 8) and
      ((a^.Num = 1) or (a^.Num = 2) or (a^.Num = 4) or (a^.Num = 8)) then
    begin
      Idx := b;
      Result := a^.Num;
    end;
  end;
end;

{ S writes no code: no statement, or a block of none (an else of
  nothing, P305). }
function TEmitter.NoStmt(S: PStmt): Boolean;
begin
  Result := (S = nil) or ((S^.Kind = skBlock) and (Length(S^.Stmts) = 0));
end;

{ E is a load the pool works out as one: a word through a pointer, a
  field or an index (EmitOrdTo's ekDeref, ekField and ekIndex, P303). }
function TEmitter.LoadKind(E: PExpr): Boolean;
begin
  Result := (E <> nil) and ((E^.Kind = ekDeref) or (E^.Kind = ekField) or
    (E^.Kind = ekIndex));
end;

{ The register of a word variable a region keeps there, or '': PtrReg
  without working anything out (P294); a narrow one's too, clean there,
  the whole word extended (P100), as a load of it would leave it (P318). }
function TEmitter.WordReg(E: PExpr): string;
var
  s: TSym;
begin
  Result := '';
  if (E <> nil) and (E^.Kind = ekVar) and WordVar(E, s) and (s.Reg <> '') then
    Result := s.Reg;
end;

{ P is B + k, k + B or B - k, a word and k a constant: K is the offset,
  within 32 bits (P294). }
function TEmitter.ConstAddend(P: PExpr; out B: PExpr; out K: Int64): Boolean;
begin
  Result := False;
  B := nil;
  K := 0;
  if (P = nil) or (P^.Kind <> ekBin) or (TSize(P^.Typ) <> 8) or (P^.L = nil) or
    (P^.R = nil) then
    Exit;
  if (P^.Bin = boAdd) and (P^.R^.Kind = ekInt) then
  begin
    B := P^.L;
    K := P^.R^.Num;
  end
  else if (P^.Bin = boAdd) and (P^.L^.Kind = ekInt) then
  begin
    B := P^.R;
    K := P^.L^.Num;
  end
  else if (P^.Bin = boSub) and (P^.R^.Kind = ekInt) and (P^.R^.Num > Low(Int64)) then
  begin
    B := P^.L;
    K := -P^.R^.Num;
  end
  else
    Exit;
  Result := Fits32(K);
end;

{ E = y + k * x or k * x + y, k 2, 4 or 8 as a product or a shift
  (ScaleOf), y a constant or not, in one instruction (P294). amd64: a
  lea of a base and a scaled index, or of a scaled index and a
  displacement, two sources: one cycle on Intel's cores since Sandy
  Bridge (248966 3.5.1.2) and AMD's two-operand LEA on every Zen (56305
  2.10.2; 55723, 56665, 57647 and 58455 the same), where the shift and
  the add were two instructions and two cycles, and a constant on the
  left a move and an imul. Intel's slow LEA is a base, an index and a
  displacement together, or a base of rbp or r13 with an index (three
  cycles; two on Zen 2): so a base in r13 goes to a pool register first,
  and y + k * x + c stays a lea and an add, as Go splits the slow form
  (cmd/compile/internal/amd64/ssa.go, LEAQ1 to LEAQ8). arm64: one add
  with the index shifted, one cycle with an LSL of 4 or less on every
  Neoverse (N1 SOG 3.4, N2, V2, N3 and V3 the same) where lsl and add
  were two in a chain, as Go's ADD R0<<2, R1; for c + k * x the
  constant goes to x17 first, independent of x, when one mov takes it.
  The side evaluated second takes pool D+1, as OrdSimple counted it. }
function TEmitter.ScaledAdd(E: PExpr; D: LongInt): Boolean;
var
  r, br, xr: string;
  ix, y: PExpr;
  sc, k: Int64;
  sh: LongInt;
  yfirst: Boolean;
begin
  Result := False;
  if (E^.Bin <> boAdd) or (TSize(E^.Typ) <> 8) then
    Exit;
  y := E^.L;
  yfirst := True;
  sc := ScaleOf(E^.R, ix);
  if sc = 0 then
  begin
    y := E^.R;
    yfirst := False;
    sc := ScaleOf(E^.L, ix);
  end;
  if (sc < 2) or (ix = nil) or (y = nil) then
    Exit;
  r := OrdPool(D);
  if sc = 2 then
    sh := 1
  else if sc = 4 then
    sh := 2
  else
    sh := 3;
  if y^.Kind = ekInt then
  begin
    k := y^.Num;
    if (not FArm) and not Fits32(k) then
      Exit;
    xr := WordReg(ix);
    if xr = '' then
    begin
      EmitOrdTo(ix, D);
      xr := r;
    end;
    if not FArm then
      Line('  leaq ' + IntToStr(k) + '(,%' + xr + ',' + IntToStr(sc) + '), %' + r)
    else if ((k < -65536) or (k > 65535)) and (ArmAddImm(k) <> '') then
    begin
      Line('  lsl ' + r + ', ' + xr + ', #' + IntToStr(sh));
      Line('  add ' + r + ', ' + r + ', ' + ArmAddImm(k));
    end
    else if ((k < -65536) or (k > 65535)) and (k > Low(Int64)) and (ArmAddImm(-k) <> '') then
    begin
      Line('  lsl ' + r + ', ' + xr + ', #' + IntToStr(sh));
      Line('  sub ' + r + ', ' + r + ', ' + ArmAddImm(-k));
    end
    else
    begin
      Imm('x17', k);
      Line('  add ' + r + ', x17, ' + xr + ', lsl #' + IntToStr(sh));
    end;
    Result := True;
    Exit;
  end;
  br := WordReg(y);
  if (not FArm) and (br = 'r13') then
    br := '';
  xr := WordReg(ix);
  if (br = '') and (xr = '') then
  begin
    if yfirst then
    begin
      if not OrdSimple(ix, D + 1) then
        Exit;
      EmitOrdTo(y, D);
      EmitOrdTo(ix, D + 1);
      br := r;
      xr := OrdPool(D + 1);
    end
    else
    begin
      if not OrdSimple(y, D + 1) then
        Exit;
      EmitOrdTo(ix, D);
      EmitOrdTo(y, D + 1);
      xr := r;
      br := OrdPool(D + 1);
    end;
  end
  else if br = '' then
  begin
    EmitOrdTo(y, D);
    br := r;
  end
  else if xr = '' then
  begin
    EmitOrdTo(ix, D);
    xr := r;
  end;
  if FArm then
    Line('  add ' + r + ', ' + br + ', ' + xr + ', lsl #' + IntToStr(sh))
  else
    Line('  leaq (%' + br + ',%' + xr + ',' + IntToStr(sc) + '), %' + r);
  Result := True;
end;

{ R := R + E, E k * y with k 2, 4 or 8 (ScaleOf), R a register a
  variable lives in (P294): ScaledAdd's lea of R and y on amd64, unless
  R is r13, Intel's slow base; one add with y shifted on arm64, and R -
  k * y one sub so. The shift and the add were two instructions in a
  chain, on arm64 a move of k, a mul and an add. y is used where a
  region keeps it, else worked out into pool 0, which the caller's
  OrdOperand would have taken. }
function TEmitter.InPlaceScaled(const R: string; Op: TBinOp; E: PExpr): Boolean;
var
  ix: PExpr;
  sc: Int64;
  sh: LongInt;
  xr: string;
begin
  Result := False;
  if (R = '') or (E = nil) then
    Exit;
  if not ((Op = boAdd) or (FArm and (Op = boSub))) then
    Exit;
  if (not FArm) and (R = 'r13') then
    Exit;
  sc := ScaleOf(E, ix);
  if (sc < 2) or (ix = nil) then
    Exit;
  if sc = 2 then
    sh := 1
  else if sc = 4 then
    sh := 2
  else
    sh := 3;
  xr := WordReg(ix);
  if xr = '' then
  begin
    EmitOrdTo(ix, 0);
    xr := OrdPool(0);
  end;
  if not FArm then
    Line('  leaq (%' + R + ',%' + xr + ',' + IntToStr(sc) + '), %' + R)
  else if Op = boAdd then
    Line('  add ' + R + ', ' + R + ', ' + xr + ', lsl #' + IntToStr(sh))
  else
    Line('  sub ' + R + ', ' + R + ', ' + xr + ', lsl #' + IntToStr(sh));
  Result := True;
end;

{ arm64: the operand of a load or a store of E, a pointer's target,
  without its address formed (P294): p + k, k + p and p - k are the
  offset from p's register, LDUR's and STUR's -256 to 255 or the
  unsigned offset of LDR and STR scaled by the size (ARM DDI 0487 M.c
  C6.2.259, C6.2.216; GNU as takes either written as ldr), and p +
  (i shl s) or p + i * m with the size's shift the register offset
  (C6.2.218), as DerefOperand folds them on amd64. False when E is
  none of them, with nothing written. }
function TEmitter.ArmDerefAt(E: PExpr; D: LongInt; out M: string): Boolean;
var
  b, ix, q: PExpr;
  k, sc: Int64;
  sz, sh: LongInt;
  bs, xs: string;
  yfirst: Boolean;
begin
  Result := False;
  M := '';
  q := E^.L;
  if q = nil then
    Exit;
  sz := TSize(LoadTyp(E));
  if (sz <> 1) and (sz <> 2) and (sz <> 4) and (sz <> 8) then
    Exit;
  if ConstAddend(q, b, k) then
  begin
    if not (((k >= -256) and (k <= 255)) or
      ((k >= 0) and (k mod sz = 0) and (k div sz <= 4095))) then
      Exit;
    bs := PtrReg(b, D);
    WmSet(bs, '', 0, k);
    M := '[' + bs + ', #' + IntToStr(k) + ']';
    Result := True;
    Exit;
  end;
  if (q^.Kind <> ekBin) or (q^.Bin <> boAdd) or (TSize(q^.Typ) <> 8) or
    (q^.L = nil) or (q^.R = nil) then
    Exit;
  b := q^.L;
  yfirst := True;
  sc := ScaleOf(q^.R, ix);
  if sc = 0 then
  begin
    b := q^.R;
    yfirst := False;
    sc := ScaleOf(q^.L, ix);
  end;
  if (sc <> sz) or (ix = nil) or (b = nil) then
    Exit;
  sh := 0;
  if sz = 2 then
    sh := 1
  else if sz = 4 then
    sh := 2
  else if sz = 8 then
    sh := 3;
  bs := WordReg(b);
  xs := WordReg(ix);
  if (bs = '') and (xs = '') then
  begin
    if yfirst then
    begin
      if not OrdSimple(ix, D + 1) then
        Exit;
      EmitOrdTo(b, D);
      EmitOrdTo(ix, D + 1);
      bs := OrdPool(D);
      xs := OrdPool(D + 1);
    end
    else
    begin
      if not OrdSimple(b, D + 1) then
        Exit;
      EmitOrdTo(ix, D);
      EmitOrdTo(b, D + 1);
      xs := OrdPool(D);
      bs := OrdPool(D + 1);
    end;
  end
  else if bs = '' then
  begin
    EmitOrdTo(b, D);
    bs := OrdPool(D);
  end
  else if xs = '' then
  begin
    EmitOrdTo(ix, D);
    xs := OrdPool(D);
  end;
  WmSet(bs, xs, sh, 0);
  M := '[' + bs + ', ' + xs + ', lsl #' + IntToStr(sh) + ']';
  Result := True;
end;

{ The operand for what P points to (amd64, 1.1.1): p + k is k(%p), p +
  (i shl s) and p + i * m are (%p,%i,scale), and p + k + (i shl s) is
  k(%p,%i,scale); the base and the index are the registers of variables
  a region keeps, else pool D and D+1; anything else is (%p). A tree's
  search read PInt(base + (mid shl 3))^ in five instructions. p - k
  folds as p + k does since P294 (ConstAddend), a sub and a load where
  -k(%p) is one. }
function TEmitter.DerefOperand(P: PExpr; D: LongInt): string;
var
  x, y, ix, b: PExpr;
  base, idx: string;
  sc, k: Int64;
begin
  if ConstAddend(P, x, k) then
  begin
    { (p + (i shl s)) + k or - k }
    if (x^.Kind = ekBin) and (x^.Bin = boAdd) and (TSize(x^.Typ) = 8) and
      (x^.L <> nil) and (x^.R <> nil) then
    begin
      sc := ScaleOf(x^.R, ix);
      if sc <> 0 then
      begin
        base := PtrReg(x^.L, D);
        idx := PtrReg(ix, D + 1);
        Result := IntToStr(k) + '(%' + base + ',%' + idx + ',' + IntToStr(sc) + ')';
        Exit;
      end;
    end;
    base := PtrReg(x, D);
    Result := IntToStr(k) + '(%' + base + ')';
    Exit;
  end;
  if (P <> nil) and (P^.Kind = ekBin) and (P^.Bin = boAdd) and (TSize(P^.Typ) = 8) and
    (P^.L <> nil) and (P^.R <> nil) then
  begin
    x := P^.L;
    y := P^.R;
    sc := ScaleOf(y, ix);
    if sc = 0 then
    begin
      sc := ScaleOf(x, ix);
      if sc <> 0 then
      begin
        x := P^.R;
        y := P^.L;
      end;
    end;
    if sc <> 0 then
    begin
      { (p + k) + (i shl s), (p - k) + (i shl s) }
      if ConstAddend(x, b, k) then
      begin
        base := PtrReg(b, D);
        idx := PtrReg(ix, D + 1);
        Result := IntToStr(k) + '(%' + base + ',%' + idx + ',' + IntToStr(sc) + ')';
        Exit;
      end;
      base := PtrReg(x, D);
      idx := PtrReg(ix, D + 1);
      Result := '(%' + base + ',%' + idx + ',' + IntToStr(sc) + ')';
      Exit;
    end;
  end;
  Result := '(%' + PtrReg(P, D) + ')';
end;

{ E is a field of a record in the frame, at any depth of fields (P291):
  Off is its offset from the frame pointer, the record's own slot plus
  the fields' offsets. A local (Result too) not by reference, not in a
  closure's box, not in a register; Global says it is a global record
  instead, Off then from its label (GLab). }
function TEmitter.FrameField(E: PExpr; out Off: Int64; out Global: Boolean;
  out GLab: string): Boolean;
var
  s: TSym;
  p: PExpr;
begin
  Result := False;
  Off := 0;
  Global := False;
  GLab := '';
  p := E;
  while (p <> nil) and (p^.Kind = ekField) do
  begin
    if (p^.L = nil) or (TKind(p^.L^.Typ) <> tykRecord) then
      Exit;
    Off := Off + p^.Off;
    p := p^.L;
  end;
  if (p = nil) or (p^.Kind <> ekVar) or (not TryFindSym(p^.Name, s)) then
    Exit;
  if s.ByRef or (s.Up <> 0) or (s.Reg <> '') or s.Boxed then
    Exit;
  if s.Global then
  begin
    Global := True;
    GLab := VarLabel(s.Name);
  end
  else
    Off := Off + s.Off;
  Result := Fits32(Off);
end;

{ The place E addressed from pool register D (and D+1 for an index). On
  amd64 the result is a memory operand, its base the register of a
  pointer a region keeps when there is one; on arm64 the address is left
  in the register and the operand is [xD]. }
{ Label L plus D, for an absolute or rip-relative operand. }
function GlobOff(const L: string; D: Int64): string;
begin
  if D = 0 then
    Result := L
  else if D > 0 then
    Result := L + '+' + IntToStr(D)
  else
    Result := L + IntToStr(D);
end;

{ amd64: the memory operand M with Off added to its displacement, a
  number, a label plus a number or none (P311). False when the sum
  leaves 32 bits or M is not an operand of that form. }
function TEmitter.AddDispOp(const M: string; Off: Int64; out R: string): Boolean;
var
  p, i: SizeInt;
  d, rest: string;
  v: Int64;
  neg, num: Boolean;
begin
  Result := False;
  R := M;
  p := Pos('(', M);
  if (p = 0) or (M[Length(M)] <> ')') then
    Exit;
  if Off = 0 then
  begin
    Result := True;
    Exit;
  end;
  d := Copy(M, 1, p - 1);
  rest := Copy(M, p, Length(M) - p + 1);
  if d = '' then
  begin
    if not Fits32(Off) then
      Exit;
    R := IntToStr(Off) + rest;
    Result := True;
    Exit;
  end;
  neg := d[1] = '-';
  i := 1;
  if neg then
    i := 2;
  num := i <= Length(d);
  v := 0;
  while num and (i <= Length(d)) do
  begin
    if (d[i] < '0') or (d[i] > '9') or (v > 100000000000) then
      num := False
    else
      v := v * 10 + (Ord(d[i]) - Ord('0'));
    Inc(i);
  end;
  if num then
  begin
    if neg then
      v := -v;
    v := v + Off;
    if not Fits32(v) then
      Exit;
    R := IntToStr(v) + rest;
    Result := True;
    Exit;
  end;
  { a label: the assembler adds the offsets (as.info, 5.2 expressions) }
  if Off > 0 then
    R := d + '+' + IntToStr(Off) + rest
  else
    R := d + IntToStr(Off) + rest;
  Result := True;
end;

function TEmitter.EmitWordMem(E: PExpr; D: LongInt): string;
var
  was: LongInt;
begin
  OpLineIn(E, was);
  Result := EmitWordMem0(E, D);
  FOpLine := was;
end;

function TEmitter.EmitWordMem0(E: PExpr; D: LongInt): string;
var
  r, idx, lenop, lenlab, ok, ok2, preg, lreg, lenR, glab, bs, reclab, m, ixop, lenkey: string;
  recglob: Boolean;
  td: TTypeDef;
  esz, sh, lk, asz: LongInt;
  disp, k, lenk, lenoff, fo, ixk: Int64;
  s: TSym;
  fat, desc, isc, nochk, near, frm: Boolean;
  foff: Int64;
  ib: PExpr;
  ixvar: Boolean;
  ad: string;
begin
  r := OrdPool(D);
  Result := '';
  nochk := FNoCheck;
  frm := False;
  foff := 0;
  FNoCheck := False;
  glab := '';
  lenR := 'x0';
  if not FArm then
  begin
    if E^.Kind = ekDeref then
    begin
      Result := DerefOperand(E^.L, D);
      Exit;
    end;
    if (E^.Kind = ekField) and (TKind(E^.L^.Typ) = tykClass) then
    begin
      Result := IntToStr(E^.Off) + '(%' + PtrReg(E^.L, D) + ')';
      Exit;
    end;
    if (E^.Kind = ekField) and (E^.L^.Kind = ekDeref) and
      (TKind(E^.L^.L^.Typ) = tykPointer) then
    begin
      Result := IntToStr(E^.Off) + '(%' + PtrReg(E^.L^.L, D) + ')';
      Exit;
    end;
  end;
  case E^.Kind of
    ekDeref:
      begin
        { arm64: p + k, p - k and p + (i shl s) in the load's own
          operand (P294) }
        if FArm and ArmDerefAt(E, D, Result) then
          Exit;
        { arm64: p^ with p in a register is [p], as amd64's PtrReg
          (P303): it was copied into the pool first }
        if FArm and (WordReg(E^.L) <> '') then
        begin
          WmSet(WordReg(E^.L), '', 0, 0);
          Result := '[' + WordReg(E^.L) + ']';
          Exit;
        end;
        EmitOrdTo(E^.L, D);
      end;
    ekField:
      begin
        { a field of a var parameter whose address a register keeps:
          that register is the base (P282) }
        if (TKind(E^.L^.Typ) <> tykClass) and (ByRefReg(E^.L) <> '') then
        begin
          if not FArm then
          begin
            Result := IntToStr(E^.Off) + '(%' + ByRefReg(E^.L) + ')';
            Exit;
          end;
          { arm64: the field at its natural place is the load's offset
            from that register, scaled by the size (ARM DDI 0487 M.c
            C6.2.216, LDR immediate, the unsigned offset) }
          asz := TSize(LoadTyp(E));
          if E^.Off = 0 then
          begin
            WmSet(ByRefReg(E^.L), '', 0, 0);
            Result := '[' + ByRefReg(E^.L) + ']';
            Exit;
          end;
          if (E^.Off > 0) and ((asz = 1) or (asz = 2) or (asz = 4) or (asz = 8)) and
            (E^.Off mod asz = 0) and (E^.Off div asz <= 4095) then
          begin
            WmSet(ByRefReg(E^.L), '', 0, E^.Off);
            Result := '[' + ByRefReg(E^.L) + ', #' + IntToStr(E^.Off) + ']';
            Exit;
          end;
        end;
        { a field of a record in the frame, at any depth of fields, is
          the load's or the store's own operand: an offset from rbp, or
          from x29 within LDUR's and STUR's -256 to 255 (ARM DDI 0487 M.c
          C6.2.259, C6.2.446); a global record's field is its label plus
          the offset on amd64. The record's address was formed again for
          every field (P291). }
        if FrameField(E, foff, recglob, reclab) then
        begin
          if not FArm then
          begin
            if recglob then
              Result := GlobOff(reclab, foff) + '(%rip)'
            else
              Result := IntToStr(foff) + '(%rbp)';
            Exit;
          end;
          if (not recglob) and (foff >= -256) and (foff <= 255) then
          begin
            WmSet('x29', '', 0, foff);
            Result := '[x29, #' + IntToStr(foff) + ']';
            Exit;
          end;
        end;
        { amd64: a field of an element, or of a field of one, is the
          element's own operand with the field's offset added to its
          displacement, one load or store of the base, the index and the
          displacement where a lea first formed the element's address
          for each field (P311): an address generation unit adds the
          three at no cost to the load (the slow LEA of P298 is an ALU's;
          Go folds the offset the same way, addressingmodes.go) }
        if (not FArm) and (E^.L^.Kind <> ekVar) and (TKind(E^.L^.Typ) <> tykClass) then
        begin
          m := EmitWordMem(E^.L, D);
          if AddDispOp(m, E^.Off, Result) then
            Exit;
          if m <> '(%' + r + ')' then
            Line('  leaq ' + m + ', %' + r);
          Result := IntToStr(E^.Off) + '(%' + r + ')';
          Exit;
        end;
        { an object a register keeps (a leaf's Self, a loop's variable)
          is the base where it is, as amd64's PtrReg (P288) }
        bs := r;
        fo := E^.Off;
        if TKind(E^.L^.Typ) = tykClass then
          bs := PtrReg(E^.L, D)
        else if FArm and (E^.L^.Kind = ekDeref) and (WordReg(E^.L^.L) <> '') then
          { p^.f with p in a register: p's register is the base (P303) }
          bs := WordReg(E^.L^.L)
        else if FArm and ((E^.L^.Kind = ekField) or (E^.L^.Kind = ekIndex)) then
        begin
          { arm64: a field of a field takes both offsets in the load's or
            the store's own, where the inner one was an ADD first (P311);
            a field of an element the element's operand, its displacement
            (a low bound's, a constant of the index) joining the field's
            offset where a SUB came first (P313) }
          m := EmitWordMem(E^.L, D);
          if FWmIdx <> '' then
          begin
            Line('  add ' + r + ', ' + FWmBase + ', ' + FWmIdx + ', lsl #' + IntToStr(FWmSh));
            bs := r;
          end
          else
          begin
            bs := FWmBase;
            fo := fo + FWmOff;
          end;
        end
        else
          EmitWordBase(E^.L, D);
        if not FArm then
        begin
          Result := IntToStr(E^.Off) + '(%' + r + ')';
          Exit;
        end;
        { the first field is the base itself (P303) }
        if fo = 0 then
        begin
          WmSet(bs, '', 0, 0);
          Result := '[' + bs + ']';
          Exit;
        end;
        { A field at its natural place is an offset of the load itself;
          a record's or an array's field is no load, its offset the one a
          field of it adds to its own, or EmitWordBase's ADD (P311). }
        asz := TSize(LoadTyp(E));
        if ((fo > 0) and ((((asz = 1) or (asz = 2) or (asz = 4) or (asz = 8)) and
          (fo mod asz = 0) and (fo div asz <= 4095)) or
          (((TKind(E^.Typ) = tykRecord) or (TKind(E^.Typ) = tykArray)) and (fo <= 4095)))) or
          ((fo >= -256) and (fo <= 255)) then
        begin
          WmSet(bs, '', 0, fo);
          Result := '[' + bs + ', #' + IntToStr(fo) + ']';
          Exit;
        end;
        if (fo > 0) and (fo <= 4095) then
          Line('  add ' + r + ', ' + bs + ', #' + IntToStr(fo))
        else if fo <> 0 then
        begin
          Imm('x17', fo);
          Line('  add ' + r + ', ' + bs + ', x17');
        end
        else if bs <> r then
          Line('  mov ' + r + ', ' + bs);
      end;
    ekIndex:
      begin
        td := FTypes[E^.L^.Typ];
        fat := IsStr(E^.L^.Typ) or IsDyn(E^.L^.Typ);
        desc := False;
        lk := 0;
        lenk := 0;
        lenoff := 0;
        lenop := '';
        lenlab := '';
        if fat then
        begin
          if IsStr(E^.L^.Typ) then
          begin
            esz := 1;
            disp := -1;
          end
          else
          begin
            esz := TSize(td.Elem);
            disp := 0;
          end;
          { P87: the length the index is checked against. A literal's is
            known (lk 1); a variable's is its second word (lk 2 global, 3
            local); any other string or slice (a field, an element, one
            passed by reference, which may be nil) is reached through its
            descriptor, whose address r holds until the index is known,
            and whose words are read then (desc). }
          if E^.L^.Kind = ekStr then
          begin
            EmitFatWord(E^.L, D, False);
            lk := 1;
            lenk := Length(E^.L^.Txt);
            lenop := '$' + IntToStr(lenk);
          end
          else if (E^.L^.Kind = ekVar) and TryFindSym(E^.L^.Name, s) and (not s.ByRef) then
          begin
            { A slice a loop keeps in registers (P100). }
            preg := PartReg(s, 1);
            lreg := PartReg(s, 2);
            if preg <> '' then
            begin
              { The slice's own register is the base: nothing below
                writes the base, it forms the address in the pool's. }
              r := preg;
            end
            else
              EmitFatWord(E^.L, D, False);
            if lreg <> '' then
            begin
              lk := 4;
              lenop := '%' + lreg;
            end
            else if s.Global then
            begin
              lk := 2;
              lenlab := VarLabel(s.Name);
              lenop := lenlab + '+8(%rip)';
            end
            else
            begin
              lk := 3;
              lenoff := s.Off + 8;
              lenop := IntToStr(lenoff) + '(%rbp)';
            end;
          end
          else
          begin
            EmitWordBase(E^.L, D);
            desc := True;
          end;
        end
        else if TKind(E^.L^.Typ) = tykArray then
        begin
          esz := TSize(td.Elem);
          disp := -td.Lo * esz;
          { amd64: a global array is at a link-time address below 2 GB
            (the programs are static, not position independent), so
            v_a-8(,%rdi,8) reaches an element with no leaq a pass, and a
            local one is -80(%rbp,%rdi,8); arm64 takes the address a
            loop keeps in a register (Part 3). }
          near := (disp >= -(Int64(1) shl 30)) and (disp <= Int64(1) shl 30) and
            ((E^.R^.Kind <> ekInt) or
            ((E^.R^.Num >= -(Int64(1) shl 30)) and (E^.R^.Num <= Int64(1) shl 30) and
            (disp + E^.R^.Num * esz >= -(Int64(1) shl 30)) and
            (disp + E^.R^.Num * esz <= Int64(1) shl 30)));
          if (E^.L^.Kind = ekVar) and TryFindSym(E^.L^.Name, s) and (not s.ByRef) then
          begin
            preg := PartReg(s, 3);
            if preg <> '' then
              r := preg
            else if (not FArm) and near and s.Global then
              glab := VarLabel(s.Name)
            else if (not FArm) and near and (s.Up = 0) then
            begin
              frm := True;
              foff := s.Off;
            end
            else
              EmitWordBase(E^.L, D);
          end
          else
            EmitWordBase(E^.L, D);
        end
        else
        begin
          esz := TSize(td.Elem);
          disp := 0;
          { a pointer a register keeps is the base where it is, on arm64
            too (P290): nothing below writes the base }
          r := PtrReg(E^.L, D);
        end;
        isc := (E^.R^.Kind = ekInt) and Fits32(disp + E^.R^.Num * esz);
        k := 0;
        idx := '';
        ixk := 0;
        ixvar := False;
        if isc then
          k := E^.R^.Num
        else if (E^.R^.Kind = ekVar) and WordVar(E^.R, s) and (s.Reg <> '') then
        begin
          idx := s.Reg;
          ixvar := True;
        end
        else if ConstAddend(E^.R, ib, ixk) and (ib^.Kind = ekVar) and WordVar(ib, s) and
          (s.Reg <> '') and (disp + ixk * esz >= -(Int64(1) shl 30)) and
          (disp + ixk * esz <= Int64(1) shl 30) then
          { v + c and v - c with v in a register: the index is v, and c
            times the element's size joins the displacement after the
            check, as Go folds an ADDQconst of the index into the
            offset, LEAQ8 [c] x (ADDQconst [d] y) being LEAQ8 [c+8*d] x y
            (AMD64.rules; ARM64.rules 699 takes an ADDconst into the
            load's offset): no add of the index first, and a constant c
            of a low bound's size cancels it (P313) }
        begin
          idx := s.Reg;
          ixvar := True;
        end
        else
        begin
          ixk := 0;
          EmitOrdTo(E^.R, D + 1);
          idx := OrdPool(D + 1);
        end;
        { the index's value for a failure's report: v + c }
        if FArm or (ixk = 0) then
          ixop := idx
        else
          ixop := IntToStr(ixk) + '(%' + idx + ')';
        { The check, before any address is formed (P87). The index is a
          constant k (isc) or in register idx, which may be a promoted
          variable's and is only read. }
        if fat then
        begin
          if FArm then
          begin
            ok := Lab;
            if desc then
            begin
              Line('  mov x0, #0');
              Line('  cbz ' + r + ', ' + ok);
              Line('  ldr x0, [' + r + ', #8]');
              Line('  ldr ' + r + ', [' + r + ']');
              Line(ok + ':');
              ok := Lab;
            end
            else if lk = 1 then
              Imm('x0', lenk)
            else if lk = 2 then
            begin
              { the length loaded only where a compare reads it: not for
                an index proved, unchecked or checked already against it
                (P324) }
              if isc or ((not nochk) and (not SliceProven(E)) and
                not ChkKept(idx, lenlab + '+8', 'f' + IntToStr(ixk + disp))) then
              begin
                LeaS(lenlab, 'x16');
                Line('  ldr x0, [x16, #8]');
              end;
            end
            else if lk = 4 then
              lenR := lreg
            else
              LdFP('x0', lenoff);
            lenkey := lenR;
            if lk = 2 then
              lenkey := lenlab + '+8';
            if isc then
            begin
              if (lk = 1) and (k + disp >= 0) and (k + disp < lenk) then
                ok := ''
              else if k + disp < 0 then
                BoundsFailArm('', k, -disp, lenR, 0, -1 - disp)
              else
              begin
                if k + disp <= 4095 then
                  Line('  cmp ' + lenR + ', #' + IntToStr(k + disp))
                else
                begin
                  Imm('x1', k + disp);
                  Line('  cmp ' + lenR + ', x1');
                end;
                ColdBegin('  b.ls');
                BoundsFailArm('', k, -disp, lenR, 0, -1 - disp);
                ColdEnd;
              end;
            end
            else if (not nochk) and (not SliceProven(E)) and
              not ChkKept(idx, lenkey, 'f' + IntToStr(ixk + disp)) then
            begin
              if (disp = -1) or (ixk <> 0) then
              begin
                AddImmArm('x1', idx, ixk + disp);
                Line('  cmp x1, ' + lenR);
              end
              else
                Line('  cmp ' + idx + ', ' + lenR);
              ColdBegin('  b.hs');
              if ixk <> 0 then
              begin
                AddImmArm('x17', idx, ixk);
                BoundsFailArm('x17', 0, -disp, lenR, 0, -1 - disp);
              end
              else
                BoundsFailArm(idx, 0, -disp, lenR, 0, -1 - disp);
              ColdEnd;
              ChkKeep(idx, lenkey, 'f' + IntToStr(ixk + disp),
                ixvar and ((lk <> 2) or MemLenOK(E^.L^.Name)));
            end;
            { no label after the check: nothing jumps to it since the
              failure went out of line (P299), and a label would end the
              index a field before kept scaled (P314) }
          end
          else
          begin
            ok := Lab;
            if desc then
            begin
              ok2 := Lab;
              Line('  xorl %eax, %eax');
              Line('  testq %' + r + ', %' + r);
              Line('  jz ' + ok2);
              Line('  movq 8(%' + r + '), %rax');
              Line('  movq (%' + r + '), %' + r);
              Line(ok2 + ':');
              lenop := '%rax';
            end;
            if isc then
            begin
              if (lk = 1) and (k + disp >= 0) and (k + disp < lenk) then
                ok := ''
              else if (k + disp < 0) or (lk = 1) then
                BoundsFailX86('$' + IntToStr(k), -disp, lenop, 0, -1 - disp)
              else
              begin
                Line('  cmpq $' + IntToStr(k + disp) + ', ' + lenop);
                ColdBegin('  jbe');
                BoundsFailX86('$' + IntToStr(k), -disp, lenop, 0, -1 - disp);
                ColdEnd;
              end;
            end
            else if (not nochk) and (not SliceProven(E)) and
              not ChkKept(idx, lenop, 'f' + IntToStr(ixk + disp)) then
            begin
              if (disp = -1) or (ixk <> 0) then
              begin
                Line('  leaq ' + IntToStr(ixk + disp) + '(%' + idx + '), %rcx');
                Line('  cmpq ' + lenop + ', %rcx');
              end
              else
                Line('  cmpq ' + lenop + ', %' + idx);
              ColdBegin('  jae');
              if ixk <> 0 then
                BoundsFailX86(ixop, -disp, lenop, 0, -1 - disp)
              else
                BoundsFailX86('%' + idx, -disp, lenop, 0, -1 - disp);
              ColdEnd;
              ChkKeep(idx, lenop, 'f' + IntToStr(ixk + disp),
                ixvar and ((lk <> 2) or MemLenOK(E^.L^.Name)));
            end;
          end;
        end
        else if TKind(E^.L^.Typ) = tykArray then
        begin
          if isc then
          begin
            { A constant index is known now: in range, nothing; out of
              range, the program stops there. }
            if (k < td.Lo) or (k > td.Hi) then
            begin
              if FArm then
                BoundsFailArm('', k, td.Lo, '', td.Hi, 0)
              else
                BoundsFailX86('$' + IntToStr(k), td.Lo, '', td.Hi, 0);
            end;
          end
          else if (not nochk) and not IndexInRange(E^.R, td.Lo, td.Hi) and
            not ChkKept(idx, '', 's' + IntToStr(ixk - td.Lo) + ':' + IntToStr(td.Hi - td.Lo)) then
          begin
            ok := Lab;
            if FArm then
            begin
              AddImmArm('x1', idx, ixk - td.Lo);
              CmpImmArm('x1', td.Hi - td.Lo, 'x0');
              ColdBegin('  b.hi');
              if ixk <> 0 then
              begin
                AddImmArm('x17', idx, ixk);
                BoundsFailArm('x17', 0, td.Lo, '', td.Hi, 0);
              end
              else
                BoundsFailArm(idx, 0, td.Lo, '', td.Hi, 0);
              ColdEnd;
            end
            else
            begin
              if (td.Lo = 0) and (ixk = 0) then
              begin
                if Fits32(td.Hi) then
                  Line('  cmpq $' + IntToStr(td.Hi) + ', %' + idx)
                else
                begin
                  LoadImmR('rcx', td.Hi);
                  Line('  cmpq %rcx, %' + idx);
                end;
              end
              else
              begin
                if Fits32(ixk - td.Lo) then
                  Line('  leaq ' + IntToStr(ixk - td.Lo) + '(%' + idx + '), %rcx')
                else
                begin
                  Line('  movq %' + idx + ', %rcx');
                  LoadImmR('rax', td.Lo - ixk);
                  Line('  subq %rax, %rcx');
                end;
                if Fits32(td.Hi - td.Lo) then
                  Line('  cmpq $' + IntToStr(td.Hi - td.Lo) + ', %rcx')
                else
                begin
                  LoadImmR('rax', td.Hi - td.Lo);
                  Line('  cmpq %rax, %rcx');
                end;
              end;
              ColdBegin('  ja');
              if ixk <> 0 then
                BoundsFailX86(ixop, td.Lo, '', td.Hi, 0)
              else
                BoundsFailX86('%' + idx, td.Lo, '', td.Hi, 0);
              ColdEnd;
            end;
            ChkKeep(idx, '', 's' + IntToStr(ixk - td.Lo) + ':' + IntToStr(td.Hi - td.Lo), ixvar);
          end;
        end;
        disp := disp + ixk * esz;
        if isc then
        begin
          disp := disp + k * esz;
          if not FArm then
          begin
            if glab <> '' then
              Result := GlobOff(glab, disp) + '(%rip)'
            else if frm then
              Result := IntToStr(foff + disp) + '(%rbp)'
            else
              Result := IntToStr(disp) + '(%' + r + ')';
            Exit;
          end;
          { arm64: an offset of the load itself when it is a multiple of
            the element, else added up in the pool's register (the base
            may be a slice's register, which nothing writes). }
          if (disp > 0) and ((esz = 1) or (esz = 2) or (esz = 4) or (esz = 8)) and
            (disp mod esz = 0) and (disp div esz <= 4095) then
          begin
            WmSet(r, '', 0, disp);
            Result := '[' + r + ', #' + IntToStr(disp) + ']';
            Exit;
          end;
          if disp <> 0 then
          begin
            AddImmArm(OrdPool(D), r, disp);
            r := OrdPool(D);
          end;
        end
        else
        begin
          sh := -1;
          if esz = 1 then
            sh := 0
          else if esz = 2 then
            sh := 1
          else if esz = 4 then
            sh := 2
          else if esz = 8 then
            sh := 3;
          if FArm then
          begin
            { [base, index, lsl #k]: one load, the address not formed. }
            if (sh >= 0) and (disp = 0) then
            begin
              WmSet(r, idx, sh, 0);
              Result := '[' + r + ', ' + idx + ', lsl #' + IntToStr(sh) + ']';
              Exit;
            end;
            { a variable's index: the element's address goes to pool
              register D + 1, free in the word place as a computed index
              is, so that a load into D leaves it for the next field;
              from the same base and index into this very register,
              which nothing has written since, it is no add (P314) }
            if ixvar and (r <> OrdPool(D + 1)) then
              ad := OrdPool(D + 1)
            else
              ad := OrdPool(D);
            if not (FIxOn and (FIxReg = ad) and (FIxSrc = idx) and (FIxBase = r) and
              (FIxK = esz)) then
            begin
              if sh >= 0 then
                Line('  add ' + ad + ', ' + r + ', ' + idx + ', lsl #' + IntToStr(sh))
              else
              begin
                { x16, scratch here as the checks' x1 and x17 are, takes a
                  recipe's second value (P313) }
                ScaleAddArm(ad, r, idx, esz, 'x17', 'x16');
              end;
              FIxOn := ixvar and (r <> ad) and (idx <> ad);
              FIxReg := ad;
              FIxSrc := idx;
              FIxBase := r;
              FIxK := esz;
            end;
            r := ad;
            { the displacement, a low bound's or a constant of the index,
              in the load's or store's own offset where an ADD or SUB
              came first (P313): LDUR's and STUR's -256 to 255 (ARM DDI
              0487 M.c C6.2.259 and C6.2.446), LDR's and STR's multiple
              of the element up to 4095 of them (C6.2.216, C6.2.415), and
              any for a record's or an array's element, whose field adds
              its offset and checks the sum (P311) }
            if (disp <> 0) and (((disp >= -256) and (disp <= 255)) or
              ((sh >= 0) and (disp > 0) and (disp mod esz = 0) and (disp div esz <= 4095)) or
              (sh < 0)) then
            begin
              WmSet(r, '', 0, disp);
              Result := '[' + r + ', #' + IntToStr(disp) + ']';
              Exit;
            end;
            if disp <> 0 then
              AddImmArm(r, r, disp);
          end
          else
          begin
            if sh < 0 then
            begin
              { the scale reads the index where it is and writes pool
                register D + 1: one lea where a move and a shift were
                two (P311) }
              m := idx;
              idx := OrdPool(D + 1);
              { the scale of the address takes a factor of 2, 4 or 8:
                24 is a lea by 3 and the address's scale 8 (P310); not
                beside a base of r13 or rbp with no displacement, whose
                index unscaled takes the base's place below (P298) }
              sh := 0;
              while (sh < 3) and ((esz and 1) = 0) and (frm or (glab <> '') or (disp <> 0) or
                ((r <> 'r13') and (r <> 'rbp'))) do
              begin
                esz := esz shr 1;
                Inc(sh);
              end;
              { rcx, which the checks above take as their scratch, holds
                a recipe's second value when the index is scaled in its
                own register (P313) }
              { the variable's index scaled by the same factor into this
                very register, which nothing has written since, as the
                field before took it: no instruction, as Go's CSE keeps
                one value for both (cmd/compile/internal/ssacompile/
                cse.go; P314) }
              if not (FIxOn and (FIxReg = idx) and (FIxSrc = m) and (FIxBase = '') and
                (FIxK = esz)) then
              begin
                ScaleTo('%' + idx, '%' + m, esz, '%rcx');
                FIxOn := ixvar and (m <> idx);
                FIxReg := idx;
                FIxSrc := m;
                FIxBase := '';
                FIxK := esz;
              end;
              esz := Int64(1) shl sh;
            end;
            if glab <> '' then
            begin
              Result := GlobOff(glab, disp) + '(,%' + idx + ',' + IntToStr(esz) + ')';
              Exit;
            end;
            if frm then
            begin
              Result := IntToStr(foff + disp) + '(%rbp,%' + idx + ',' + IntToStr(esz) + ')';
              Exit;
            end;
            { no displacement of 0: a base of r13 or rbp needs one
              byte for it, so an unscaled index takes the base's place
              (P298; SDM vol. 2A table 2-3, mod 00 with base 101 is
              disp32 with no base) }
            if (disp = 0) and (esz = 1) and ((r = 'r13') or (r = 'rbp')) and
              (idx <> 'r13') and (idx <> 'rbp') then
            begin
              Result := '(%' + idx + ',%' + r + ')';
              Exit;
            end;
            if disp = 0 then
            begin
              Result := '(%' + r + ',%' + idx + ',' + IntToStr(esz) + ')';
              Exit;
            end;
            if Fits32(disp) then
            begin
              Result := IntToStr(disp) + '(%' + r + ',%' + idx + ',' + IntToStr(esz) + ')';
              Exit;
            end;
            Line('  leaq (%' + r + ',%' + idx + ',' + IntToStr(esz) + '), %' + OrdPool(D));
            Line('  movabsq $' + IntToStr(disp) + ', %rax');
            Line('  addq %rax, %' + OrdPool(D));
            Result := '(%' + OrdPool(D) + ')';
            Exit;
          end;
        end;
      end;
  else
    Die('internal error: not a word place');
  end;
  if FArm then
  begin
    WmSet(r, '', 0, 0);
    Result := '[' + r + ']';
  end
  else if Result = '' then
    Result := '(%' + r + ')';
end;

{ arm64: what EmitWordMem's operand is made of, set as it returns: a
  nested EmitWordMem (the pointer of p^.f) sets them too. }
procedure TEmitter.WmSet(const Base, Idx: string; Sh: LongInt; Off: Int64);
begin
  FWmBase := Base;
  FWmIdx := Idx;
  FWmSh := Sh;
  FWmOff := Off;
end;

{ E is a constant word: an integer, a character, nil (P306). }
function TEmitter.ConstOf(E: PExpr; out K: Int64): Boolean;
begin
  Result := True;
  K := 0;
  if E^.Kind = ekInt then
    K := E^.Num
  else if (E^.Kind = ekStr) and (Length(E^.Txt) = 1) then
    K := Ord(E^.Txt[1])
  else if E^.Kind <> ekNil then
    Result := False;
end;

{ arm64: R compared with K: CMP's immediate, CMN's for a negative K
  (ARM DDI 0487 M.c C6.2.96 and C6.2.93: aliases of SUBS and ADDS with
  imm12 and its shift by 12), else K in Tmp (P306). }
procedure TEmitter.CmpImmArm(const R: string; K: Int64; const Tmp: string);
begin
  if ArmAddImm(K) <> '' then
    Line('  cmp ' + R + ', ' + ArmAddImm(K))
  else if (K < 0) and (K > Low(Int64)) and (ArmAddImm(-K) <> '') then
    Line('  cmn ' + R + ', ' + ArmAddImm(-K))
  else
  begin
    Imm(Tmp, K);
    Line('  cmp ' + R + ', ' + Tmp);
  end;
end;

{ arm64: sp := sp - K or sp + K (Op 'sub' or 'add'), the immediate for
  1 to 4095, the form MapNote counts as it counts sub sp, sp, x16 with
  x16 known; nothing for 0 (P306). }
procedure TEmitter.SpAdjArm(const Op: string; K: Int64);
begin
  if K = 0 then
    Exit;
  if (K > 0) and (K <= 4095) then
    Line('  ' + Op + ' sp, sp, #' + IntToStr(K))
  else
  begin
    Imm('x16', K);
    Line('  ' + Op + ' sp, sp, x16');
  end;
end;

{ amd64: R := R + K, ADD's sign-extended imm32 when K fits (SDM vol. 2A
  3-14 ADD, REX.W 81 /0 id and 83 /0 ib), nothing for 0, else through rcx;
  R is not rcx (P306). }
procedure TEmitter.AddKX86(const R: string; K: Int64);
begin
  if K = 0 then
    Exit;
  if Fits32(K) then
    Line('  addq $' + IntToStr(K) + ', %' + R)
  else
  begin
    Line('  movabsq $' + IntToStr(K) + ', %rcx');
    Line('  addq %rcx, %' + R);
  end;
end;

{ arm64: Dst := Src + D as AddImmArm, a constant no immediate takes in
  Tmp (P306). }
procedure TEmitter.AddImmArmT(const Dst, Src: string; D: Int64; const Tmp: string);
begin
  if (D > 0) and (ArmAddImm(D) <> '') then
    Line('  add ' + Dst + ', ' + Src + ', ' + ArmAddImm(D))
  else if (D < 0) and (D > Low(Int64)) and (ArmAddImm(-D) <> '') then
    Line('  sub ' + Dst + ', ' + Src + ', ' + ArmAddImm(-D))
  else if D <> 0 then
  begin
    Imm(Tmp, D);
    Line('  add ' + Dst + ', ' + Src + ', ' + Tmp);
  end
  else if Dst <> Src then
    Line('  mov ' + Dst + ', ' + Src);
end;

{ arm64: Dst := Src + D, the constant ADD's or SUB's immediate when it
  is 0 to 4095 or such a value shifted by 12 (ArmAddImm, P306). }
procedure TEmitter.AddImmArm(const Dst, Src: string; D: Int64);
begin
  if (D > 0) and (ArmAddImm(D) <> '') then
    Line('  add ' + Dst + ', ' + Src + ', ' + ArmAddImm(D))
  else if (D < 0) and (D > Low(Int64)) and (ArmAddImm(-D) <> '') then
    Line('  sub ' + Dst + ', ' + Src + ', ' + ArmAddImm(-D))
  else if D <> 0 then
  begin
    Imm('x17', D);
    Line('  add ' + Dst + ', ' + Src + ', x17');
  end
  else if Dst <> Src then
    Line('  mov ' + Dst + ', ' + Src);
end;

{ arm64: x16 := the word at B + Off, a slot of a method table or of an
  interface's table (P347): one ldr at the offset, a multiple of 8 up to
  32760 (ARM DDI 0487 M.c C6.2.216, LDR immediate, unsigned offset, imm12
  scaled by 8), as amd64's call *48(%rax) and Go's MOVD 48(R16), R16
  read it; the add before the ldr past that. }
procedure TEmitter.LdSlotArm(const B: string; Off: Int64);
begin
  if Off = 0 then
    Line('  ldr x16, [' + B + ']')
  else if (Off > 0) and (Off <= 32760) and (Off mod 8 = 0) then
    Line('  ldr x16, [' + B + ', #' + IntToStr(Off) + ']')
  else
  begin
    AddImmArm('x16', B, Off);
    Line('  ldr x16, [x16]');
  end;
end;

{ Load one or eight bytes from the operand M into pool register R. }
procedure TEmitter.WordLoad(const M: string; T: LongInt; const R: string);
begin
  LoadTo(M, T, R);
end;

procedure TEmitter.WordStore(const M: string; Sz: LongInt; const R: string);
begin
  StoreFrom(M, Sz, R);
end;

{ Dest := E where Dest is a one-byte or one-word variable that no loop
  keeps in a register, or a place reached through a pointer, a field or
  an index, and E can be worked out in the pool: the value in pool
  register 0, the address from pool register 1, one store (P94). }
function TEmitter.WordAssign(Dest, E: PExpr): Boolean;
var
  s, src: TSym;
  m: string;
  sz: LongInt;
  k: TTypeKind;
begin
  Result := False;
  if (Dest = nil) or (E = nil) then
    Exit;
  if not OrdSimple(E, 0) then
    Exit;
  { A write into a string makes it its own first: StoreTo (1.0.82). }
  if (Dest^.Kind = ekIndex) and (Dest^.L <> nil) and IsStr(Dest^.L^.Typ) then
    Exit;
  if InPlaceMem(Dest, E) then
  begin
    Result := True;
    Exit;
  end;
  if Dest^.Kind = ekVar then
  begin
    if not WordVar(Dest, s) then
      Exit;
    Result := True;
    { a copy between two variables of one size, one of them in a
      register, is one move, load or store, where it went through the
      pool (P303) }
    if (E^.Kind = ekVar) and WordVar(E, src) and (TSize(src.Typ) = TSize(s.Typ)) and
      ((s.Reg <> '') or (src.Reg <> '')) then
    begin
      FSkipCanon := False;
      if s.Reg = '' then
        StoreWordVar(s, src.Reg)
      else if s.Reg <> src.Reg then
        LoadWordVar(src, s.Reg);
      Exit;
    end;
    { a load into a variable a region keeps in a register goes there,
      where it went to the pool and was copied (P303): EmitOrdTo loads
      the clean value as LoadTo does, and StoreWordVar copies it whole }
    if (s.Reg <> '') and LoadKind(E) then
    begin
      FSkipCanon := False;
      m := EmitWordMem(E, 0);
      WordLoad(m, LoadTyp(E), s.Reg);
      Exit;
    end;
    { a narrow value for a variable a region keeps: the cleanup EmitOrdTo
      writes in its pool register goes into the variable's, movzwl %si,
      %ebx or uxth w21, w9 where it was that in place and a move (P318) }
    if (s.Reg <> '') and NarrowOp(E) and IsNarrowId(E^.Typ) and not KeepsClean(E) then
    begin
      FSkipCanon := True;
      EmitOrdTo(E, 0);
      CanonTo(s.Reg, OrdPool(0), E^.Typ);
      Exit;
    end;
    FSkipCanon := (TSize(E^.Typ) = TSize(s.Typ)) and (s.Reg = '');
    EmitOrdTo(E, 0);
    StoreWordVar(s, OrdPool(0));
    Exit;
  end;
  if (Dest^.Kind <> ekIndex) and (Dest^.Kind <> ekField) and
    (Dest^.Kind <> ekDeref) then
    Exit;
  if IsFat(Dest^.Typ) or IsBlob(Dest^.Typ) then
    Exit;
  k := TKind(Dest^.Typ);
  if (k = tykReal) or (k = tykSet) or (k = tykInterface) or (k = tykMethod) or
    (k = tykArray) or (k = tykRecord) then
    Exit;
  sz := TSize(LoadTyp(Dest));
  if (sz <> 8) and (sz <> 1) and (sz <> 2) and (sz <> 4) then
    Exit;
  if not WordMemOK(Dest, 1) then
    Exit;
  Result := True;
  FSkipCanon := TSize(E^.Typ) = sz;
  EmitOrdTo(E, 0);
  { data[i] := tab[data[i]]: E read the same element, checked, and a pool
    expression calls nothing, so the store needs no check again. }
  FNoCheck := (Dest^.Kind = ekIndex) and ContainsSame(E, Dest);
  m := EmitWordMem(Dest, 1);
  WordStore(m, sz, OrdPool(0));
end;

{ d := e for a plain integer d and an e without calls: e is worked out in
  the pool and stored once. When e is d op x, x is worked out first and
  d changes in place, in its register or in memory. }
function TEmitter.OrdAssign(S: PStmt): Boolean;
var
  dst, ls: TSym;
  e: PExpr;
  op, r: string;
  inplace: Boolean;
  k: Int64;
begin
  Result := False;
  if (S = nil) or (S^.Dest = nil) or (S^.E = nil) then
    Exit;
  e := S^.E;
  if not PlainOrd(S^.Dest, dst) then
  begin
    Result := WordAssign(S^.Dest, e);
    Exit;
  end;
  if (e^.Kind <> ekBin) and (e^.Kind <> ekUn) and (e^.Kind <> ekIndex) and
    (e^.Kind <> ekField) and (e^.Kind <> ekDeref) then
    Exit;
  if not OrdSimple(e, 0) then
    Exit;
  Result := True;
  inplace := False;
  if (e^.Kind = ekBin) and (e^.L^.Kind = ekVar) and PlainOrd(e^.L, ls) and
    SamePlace(dst, ls) then
  begin
    if FArm then
      inplace := (dst.Reg <> '') and ((e^.Bin = boAdd) or (e^.Bin = boSub) or
        (e^.Bin = boAnd) or (e^.Bin = boOr) or (e^.Bin = boXor) or
        (e^.Bin = boMul))
    else
      inplace := (e^.Bin = boAdd) or (e^.Bin = boSub) or (e^.Bin = boAnd) or
        (e^.Bin = boOr) or (e^.Bin = boXor) or
        ((e^.Bin = boMul) and (dst.Reg <> ''));
  end;
  if inplace then
  begin
    { x := x + k * y in one lea or one add with the shift (P294) }
    if (dst.Reg <> '') and InPlaceScaled(dst.Reg, e^.Bin, e^.R) then
      Exit;
    if FArm then
    begin
      { a constant add, sub, and, orr or eor takes (P306) }
      if ((e^.Bin = boAdd) or (e^.Bin = boSub)) and (e^.R^.Kind = ekInt) and
        (e^.R^.Num > Low(Int64)) then
      begin
        if e^.Bin = boAdd then
          AddImmArm(dst.Reg, dst.Reg, e^.R^.Num)
        else
          AddImmArm(dst.Reg, dst.Reg, -e^.R^.Num);
        Exit;
      end;
      { a product by a constant's recipe (P295) }
      if (e^.Bin = boMul) and ConstOf(e^.R, k) and MulByK(dst.Reg, k) then
        Exit;
      if ((e^.Bin = boAnd) or (e^.Bin = boOr) or (e^.Bin = boXor)) and
        (e^.R^.Kind = ekInt) and ArmLogImm(e^.R^.Num) then
        op := '#' + HexWord(e^.R^.Num)
      else
        op := OrdOperand(e^.R, -1);
      case e^.Bin of
        boAdd: Line('  add ' + dst.Reg + ', ' + dst.Reg + ', ' + op);
        boSub: Line('  sub ' + dst.Reg + ', ' + dst.Reg + ', ' + op);
        boAnd: Line('  and ' + dst.Reg + ', ' + dst.Reg + ', ' + op);
        boOr: Line('  orr ' + dst.Reg + ', ' + dst.Reg + ', ' + op);
        boXor: Line('  eor ' + dst.Reg + ', ' + dst.Reg + ', ' + op);
      else
        Line('  mul ' + dst.Reg + ', ' + dst.Reg + ', ' + op);
      end;
      Exit;
    end;
    op := OrdOperand(e^.R, -1);
    r := MemA(dst);
    { Two memory operands do not make one instruction. }
    if (dst.Reg = '') and (op[1] <> '$') and (op[1] <> '%') then
    begin
      Line('  movq ' + op + ', %rsi');
      op := '%rsi';
    end;
    case e^.Bin of
      boAdd: Line('  addq ' + op + ', ' + r);
      boSub: Line('  subq ' + op + ', ' + r);
      boAnd: Line('  andq ' + op + ', ' + r);
      boOr: Line('  orq ' + op + ', ' + r);
      boXor: Line('  xorq ' + op + ', ' + r);
    else
      if op[1] = '$' then
        MulImm(op, r)
      else
        MulImm(op, r);
    end;
    Exit;
  end;
  { d := (d op a) op b ... with d in a register and named nowhere else:
    each step changes the register (P100); x := x * K + C was worked out
    in the pool and moved back. }
  if (dst.Reg <> '') and (e^.Kind = ekBin) and (e^.L <> nil) and
    (e^.L^.Kind = ekBin) and InPlaceSpine(e, dst.Name) then
  begin
    SpineEmit(e, dst.Reg);
    Exit;
  end;
  { a load into a register variable goes there (P303) }
  if (dst.Reg <> '') and LoadKind(e) then
  begin
    WordLoad(EmitWordMem(e, 0), LoadTyp(e), dst.Reg);
    Exit;
  end;
  { a value of plain steps that does not read the variable is worked out
    in the variable's register, pool register 0 named so for it, where it
    was worked out in the pool and moved, as Go's allocator gives the value
    the variable's register (P318) }
  if (dst.Reg <> '') and PoolPlain(e) and not NamesVar(e, dst.Name) then
  begin
    FPool0 := dst.Reg;
    EmitOrdTo(e, 0);
    FPool0 := '';
    Exit;
  end;
  EmitOrdTo(e, 0);
  StorePlainFrom(dst, OrdPool(0));
end;

{ E names the variable N somewhere. }
function TEmitter.NamesVar(E: PExpr; const N: string): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  Result := True;
  if (E^.Kind = ekVar) and SameSym(E^.Name, N) then
    Exit;
  if NamesVar(E^.L, N) or NamesVar(E^.R, N) then
    Exit;
  for i := 0 to High(E^.Args) do
    if NamesVar(E^.Args[i], N) then
      Exit;
  Result := False;
end;

{ E is N op a op b ... down its left side, each op one an amd64 or arm64
  instruction does to a register, N at the bottom and nowhere else. }
function TEmitter.InPlaceSpine(E: PExpr; const N: string): Boolean;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekBin) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  if NarrowOp(E) or IsNarrowId(E^.Typ) then
    Exit;
  if (E^.Bin <> boAdd) and (E^.Bin <> boSub) and (E^.Bin <> boAnd) and
    (E^.Bin <> boOr) and (E^.Bin <> boXor) and (E^.Bin <> boMul) then
    Exit;
  if NamesVar(E^.R, N) then
    Exit;
  if not (OrdLeaf(E^.R) or OrdSimple(E^.R, 0)) then
    Exit;
  if E^.L^.Kind = ekVar then
    Result := SameSym(E^.L^.Name, N)
  else
    Result := InPlaceSpine(E^.L, N);
end;

procedure TEmitter.SpineEmit(E: PExpr; const R: string);
var
  op: string;
  k: Int64;
begin
  if E^.L^.Kind <> ekVar then
    SpineEmit(E^.L, R);
  if InPlaceScaled(R, E^.Bin, E^.R) then
    Exit;
  if FArm then
  begin
    { a constant add, sub, and, orr or eor takes (P306) }
    if ((E^.Bin = boAdd) or (E^.Bin = boSub)) and (E^.R^.Kind = ekInt) then
    begin
      if E^.Bin = boAdd then
        AddImmArm(R, R, E^.R^.Num)
      else if E^.R^.Num > Low(Int64) then
        AddImmArm(R, R, -E^.R^.Num)
      else
      begin
        Imm('x17', E^.R^.Num);
        Line('  sub ' + R + ', ' + R + ', x17');
      end;
      Exit;
    end;
    { a product by a constant's recipe (P295) }
    if (E^.Bin = boMul) and ConstOf(E^.R, k) and MulByK(R, k) then
      Exit;
    if ((E^.Bin = boAnd) or (E^.Bin = boOr) or (E^.Bin = boXor)) and
      (E^.R^.Kind = ekInt) and ArmLogImm(E^.R^.Num) then
      op := '#' + HexWord(E^.R^.Num)
    else
      op := OrdOperand(E^.R, -1);
    case E^.Bin of
      boAdd: Line('  add ' + R + ', ' + R + ', ' + op);
      boSub: Line('  sub ' + R + ', ' + R + ', ' + op);
      boAnd: Line('  and ' + R + ', ' + R + ', ' + op);
      boOr: Line('  orr ' + R + ', ' + R + ', ' + op);
      boXor: Line('  eor ' + R + ', ' + R + ', ' + op);
    else
      Line('  mul ' + R + ', ' + R + ', ' + op);
    end;
  end
  else
  begin
    op := OrdOperand(E^.R, -1);
    case E^.Bin of
      boAdd: Line('  addq ' + op + ', %' + R);
      boSub: Line('  subq ' + op + ', %' + R);
      boAnd: Line('  andq ' + op + ', %' + R);
      boOr: Line('  orq ' + op + ', %' + R);
      boXor: Line('  xorq ' + op + ', %' + R);
    else
      if op[1] = '$' then
      begin
        MulImm(op, '%' + R);
      end
      else
        Line('  imulq ' + op + ', %' + R);
    end;
  end;
end;

{ A comparison with an expression on either side: both sides in the
  pool, one compare, one branch to Target (taken when the comparison
  holds if WhenTrue, when it fails otherwise). }
function TEmitter.OrdJcc(E: PExpr; const Target: string; WhenTrue: Boolean): Boolean;
var
  op, cc: string;
  k: Int64;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekBin) then
    Exit;
  if (E^.Bin <> boEq) and (E^.Bin <> boNe) and (E^.Bin <> boLt) and
    (E^.Bin <> boLe) and (E^.Bin <> boGt) and (E^.Bin <> boGe) then
    Exit;
  { a set's comparison is EmitSetBin's (P126): <= is a subset }
  if (TKind(E^.L^.Typ) = tykSet) or (TKind(E^.R^.Typ) = tykSet) then
    Exit;
  if not OrdBinOp(E) then
    Exit;
  if not OrdSimple(E^.L, 0) then
    Exit;
  if not (OrdLeaf(E^.R) or OrdSimple(E^.R, 1)) then
    Exit;
  Result := True;
  EmitOrdTo(E^.L, 0);
  cc := CondCC(E^.Bin, WhenTrue);
  if FArm then
  begin
    { a constant CMP or CMN takes, a character's and nil's too (P306) }
    if ConstOf(E^.R, k) and ((ArmAddImm(k) <> '') or
      ((k < 0) and (k > Low(Int64)) and (ArmAddImm(-k) <> ''))) then
      CmpImmArm(OrdPool(0), k, 'x17')
    else
      Line('  cmp ' + OrdPool(0) + ', ' + OrdOperand(E^.R, 0));
    Line('  b.' + cc + ' ' + Target);
  end
  else
  begin
    op := OrdOperand(E^.R, 0);
    Line('  cmpq ' + op + ', %' + OrdPool(0));
    Line('  ' + X86Jcc(cc) + ' ' + Target);
  end;
end;

procedure TEmitter.EmitStackCheck(const Entry: string; const Frame: string);
var
  ok, slow: string;
  st: SizeInt;
  fk: Int64;
begin
  { A loop of a routine in the pasasync table tests nothing at its
    passes (P293): rt_sigurg stops the routine wherever it runs, as Go's
    loops test nothing and its signals preempt them. A routine with asm,
    or a unit's life block, keeps its loops' tests. }
  if FAsyncOK and (Frame = '16') then
    Exit;
  { A loop head inside a promoted loop: nothing in the loop calls, so the
    red zone the prologue's check left still holds and the only thing
    to ask is whether sysmon wants the routine off the M. That is Go's
    prologue test, one compare with the guard word. The slow path spills,
    calls rt_morestack, reloads and comes back to the test; it is kept
    in FStubs and placed after the loop, so the loop takes no branch for
    it (P93). }
  if FPromoOn and (Frame = '16') then
  begin
    slow := Lab;
    if FArm then
    begin
      { sp itself: CMP (extended register) takes it as its first
        operand (ARM DDI 0487 M.c C6.2.95), P290 }
      Line('  ldr x10, [x28, #16]');
      Line('  cmp sp, x10');
      Line('  b.ls ' + slow);
    end
    else
    begin
      Line('  cmpq 16(%r14), %rsp');
      Line('  jbe ' + slow);
    end;
    st := FLen;
    Line(slow + ':');
    PromoSpill;
    if FArm then
    begin
      Line('  str x30, [sp, #-16]!');
      Line('  bl rt_morestack');
      Line('  ldr x30, [sp], #16');
      PromoReload;
      Line('  b ' + Entry);
    end
    else
    begin
      Line('  call rt_morestack');
      PromoReload;
      Line('  jmp ' + Entry);
    end;
    FStubs := FStubs + Copy(FOut, st + 1, FLen - st);
    FLen := st;
    FLastIns := '';
    Exit;
  end;
  { g in r14 / x28. stackguard0 at 16(g). Stack grows down. Frame is a
    number or the .set symbol of the routine. A routine asks for its
    frame, the words it pushes under it and the red zone (RedZone, P342):
    the runtime routines a body calls push below without a check of their
    own, and on the first stack the record sits right under the guard. }
  ok := Lab;
  { Before the frame, the call is a prologue's (kind 1): the routine has
    pushed nothing and its caller's return address is just above (P95c). }
  FMapPro := not FMapOn;
  { The routine's pasasync entry starts at ok (FAsyncFrom, P293): stopped
    by a signal between its load of the guard word and rt_morestack, it
    would come back with the request cleared and still call it, and
    rt_morestack, finding a guard that asks for nothing, would double the
    stack for nothing. Go marks the same instructions an unsafe point
    (cmd/internal/obj/x86/obj6.go and arm64/obj7.go, issue 35470). }
  if FArm then
  begin
    { sp less the frame and its margin: a symbol's frame is known after
      the body, so a mark SetFrame fills with the SUBs (P308); a number
      takes them now }
    if Frame[1] = '.' then
      Line('  /* check ' + Frame + ' */')
    else
    begin
      if not StrToInt64(Frame, fk) then
        Die('internal error: frame ' + Frame);
      Line(SubImmText('x9', 'sp', fk + RedZone));
    end;
    Line('  ldr x10, [x28, #16]');
    Line('  cmp x9, x10');
    Line('  b.hs ' + ok);
    PromoSpill;
    Line('  str x30, [sp, #-16]!');
    Line('  bl rt_morestack');
    Line('  ldr x30, [sp], #16');
    PromoReload;
    Line('  b ' + Entry);
    Line(ok + ':');
    FAsyncFrom := ok;
    FMapPro := False;
    Exit;
  end;
  { a routine's frame, the words it pushes under it, and the red zone; a
    loop head's 16 and the red zone (P342) }
  if Frame[1] = '.' then
    Line('  leaq -(' + Frame + '+.Lpu' + Copy(Frame, 5, Length(Frame) - 4) + '+' + IntToStr(RedZone) +
      ')(%rsp), %r11')
  else
    Line('  leaq -(' + Frame + '+' + IntToStr(RedZone) + ')(%rsp), %r11');
  Line('  cmpq 16(%r14), %r11');
  Line('  jae ' + ok);
  PromoSpill;
  Line('  call rt_morestack');
  PromoReload;
  Line('  jmp ' + Entry);
  Line(ok + ':');
  FAsyncFrom := ok;
  FMapPro := False;
end;

{ The divisor is in rcx / x1. A zero stops the program with the line of
  the statement: on arm64 sdiv by zero gives 0 in silence, and on amd64
  the trap would arrive as SIGFPE with the same text but from the signal
  path; one check on both machines keeps the answer the same (P86). }
{ P299: a check's failure out of line, as Go puts its calls of
  panicIndex and panicBounds after the body: the check's branch, Jmp to
  the failure's label C, is not taken while the check holds, so the
  checked path falls through and takes no branch. P87 had put the call
  inline, the checked path jumping over it at every pass, so that the
  call's return address gave the statement's line; the jump's target
  then decided where the next fetch began, and b13strw's concat, one
  instruction shorter under P294, ran 10% slower when it fell 4 bytes
  before the end of a 32-byte block on Zen 2. The failure starts with a
  line label of the statement (rt_linetab and the debugger take the
  greatest label at or below a pc), its text leaves FOut at ColdEnd for
  FCold, and ColdFlush places it after the routine's ret. A captured
  failure keeps no position in FOut past its own statement. Since P300
  a slow path that comes back goes the same way, ending with its jump
  back, and Jmp '' begins a block whose branches are already written. }
procedure TEmitter.ColdBeginAt(const Jmp, C: string);
var
  locn: string;
  n: SizeInt;
  cl: LongInt;
begin
  if FColdAt >= 0 then
    Die('internal error: a check''s failure inside another');
  { the failure's text leaves FOut at ColdEnd: no rewrite before it }
  FZeroN := 0;
  { arm64's TBZ and TBNZ reach 32 KiB (C6.2.478), not a routine's end }
  if FArm and ((Copy(Jmp, 1, 6) = '  tbz ') or (Copy(Jmp, 1, 7) = '  tbnz ')) then
    Die('internal error: a test bit and branch to a block after the ret');
  if Jmp <> '' then
    Line(Jmp + ' ' + C);
  FColdAt := FLen;
  Line(C + ':');
  { the operation's line, which may be another line of the statement's
    (P341) }
  cl := FCurLine;
  if FOpLine > 0 then
    cl := FOpLine;
  if cl > 0 then
  begin
    Line('  .loc 1 ' + IntToStr(cl));
    Inc(FLab);
    locn := '.LL' + IntToStr(FLab);
    Line(locn + ':');
    n := Length(FLineLabs);
    SetLength(FLineLabs, n + 1);
    SetLength(FLineNums, n + 1);
    FLineLabs[n] := locn;
    FLineNums[n] := cl;
  end;
  { no frame (P296): the CFA is rsp's offset as the body left it, and an
    even count of pushes leaves rsp 8 off 16, which the failure's call
    (it never comes back) needs on 16 (System V psABI 3.2.2) }
  if FFlat and not FArm then
  begin
    Line('  .cfi_def_cfa_offset ' + IntToStr(FFlatCfa));
    if FFlatPad then
    begin
      Line('  subq $8, %rsp');
      Line('  .cfi_def_cfa_offset ' + IntToStr(FFlatCfa + 8));
    end;
  end;
end;

procedure TEmitter.ColdBegin(const Jmp: string);
begin
  ColdBeginAt(Jmp, Lab);
end;

procedure TEmitter.ColdEnd;
begin
  if FColdAt < 0 then
    Die('internal error: the end of a check''s failure that did not begin');
  FCold := FCold + Copy(FOut, FColdAt + 1, FLen - FColdAt);
  FLen := FColdAt;
  FColdAt := -1;
  FLastIns := '';
end;

{ The failures of the routine just emitted, after its ret: Cfa on amd64
  inside a frame, whose epilogue left the CFA at rsp + 8, gives them the
  body's rbp + 16 back. }
procedure TEmitter.ColdFlush(Cfa: Boolean);
begin
  if FCold = '' then
    Exit;
  if Cfa and not FArm then
    Line('  .cfi_def_cfa %rbp, 16');
  AppendLine(Copy(FCold, 1, Length(FCold) - 1));
  FCold := '';
  FLastIns := '';
  FIxOn := False;
  FChkOn := False;
  FZeroN := 0;
end;

{ The divisor is zero: rt_divzero, out of line (P299). }
procedure TEmitter.EmitDivCheck;
begin
  if FArm then
  begin
    ColdBegin('  cbz x1,');
    Line('  bl rt_divzero');
    ColdEnd;
  end
  else
  begin
    Line('  testq %rcx, %rcx');
    ColdBegin('  jz');
    Line('  call rt_divzero');
    ColdEnd;
  end;
end;

{ P87: an index out of range stops the program, inline where the check
  failed so the call's return address gives the statement's line, as
  EmitDivCheck does (a stub after a promoted loop would give another).
  rt_boundsfail takes the index in rdi (x0), the lower bound in rsi (x1)
  and the upper one in rdx (x2); it never returns, so every register is
  free for them. amd64: Idx is an operand (a register, or $k), Hi one
  too or '' for HiK, and HiAdj is added to it (a slice's last index is
  its length - 1); rdi is set first, since the index may sit in rsi. }
procedure TEmitter.BoundsFailX86(const Idx: string; Lo: Int64; const Hi: string; HiK: Int64; HiAdj: LongInt);
begin
  { A limit in rdi, where the index goes, moves out of it first. }
  if (Hi = '%rdi') and (Idx <> '%rdi') then
    Line('  movq %rdi, %rdx');
  { an index that is a register plus a constant, c(%r), is its sum (P313) }
  if Pos('(', Idx) > 0 then
    Line('  leaq ' + Idx + ', %rdi')
  else
    Line('  movq ' + Idx + ', %rdi');
  if Hi = '' then
    LoadImmR('rdx', HiK)
  else if (Hi <> '%rdx') and not ((Hi = '%rdi') and (Idx <> '%rdi')) then
    Line('  movq ' + Hi + ', %rdx');
  if HiAdj <> 0 then
    Line('  addq $' + IntToStr(HiAdj) + ', %rdx');
  LoadImmR('rsi', Lo);
  Line('  call rt_boundsfail');
end;

{ An index whose load touches no register but rax (x0): a constant, or
  a word variable of this routine or a global one, not passed by
  reference. The length of the string or slice it indexes then waits in
  a register (rcx, x2) instead of on the stack (P87). }
function TEmitter.SimpleIx(E: PExpr): Boolean;
var
  s: TSym;
begin
  Result := False;
  if E = nil then
    Exit;
  if E^.Kind = ekInt then
    Result := True
  else if (E^.Kind = ekVar) and TryFindSym(E^.Name, s) then
    Result := (not s.ByRef) and (s.Up <= 0) and (not IsFat(s.Typ)) and
      (not IsBlob(s.Typ)) and (TSize(s.Typ) = 8);
end;

{ arm64: Hi (a register) or HiK goes to x2 first, then the index, Idx or
  IdxK when Idx is '', to x0, then Lo to x1: the length may sit in x0,
  the index never in x2. }
procedure TEmitter.BoundsFailArm(const Idx: string; IdxK, Lo: Int64; const Hi: string; HiK: Int64; HiAdj: LongInt);
var
  ix: string;
begin
  { An index in x2, where the limit goes, moves out of it first: View's
    length below 0 was reported as the limit loaded over it (1.0.110). }
  ix := Idx;
  if (ix = 'x2') and (Hi <> 'x2') then
  begin
    Line('  mov x17, x2');
    ix := 'x17';
  end;
  if Hi = '' then
    Imm('x2', HiK)
  else if Hi <> 'x2' then
    Line('  mov x2, ' + Hi);
  if HiAdj = -1 then
    Line('  sub x2, x2, #1')
  else if HiAdj <> 0 then
  begin
    AddImmArm('x2', 'x2', HiAdj);
  end;
  if ix = '' then
    Imm('x0', IdxK)
  else if ix <> 'x0' then
    Line('  mov x0, ' + ix);
  Imm('x1', Lo);
  Line('  bl rt_boundsfail');
end;

{ The main block's code for rt_sigurg (P293), as EmitProc gives each
  routine's: in the section every object adds to, since the main block
  sits in .text with the runtime and is always linked. }
procedure TEmitter.MainAsync;
var
  e: string;
begin
  if FAsyncOK then
  begin
    e := Lab;
    Line(e + ':');
    MapOutLine('.section pasasync,"aw"');
    MapOutLine('.balign 8');
    { from after the prologue's stack check, as a routine's }
    if FAsyncFrom = '' then
      FAsyncFrom := 'pas_main';
    MapOutLine('  .quad ' + FAsyncFrom + ', ' + e);
    { the main block's call sites follow, in the maps' own section }
    MapOutLine('.section pasgcmaps,"aw"');
  end;
  FAsyncOK := False;
end;

{ A word value a register holds whole (P288): an 8-byte integer,
  enumeration, subrange, pointer or class. }
function TEmitter.LeafWord(T: LongInt): Boolean;
var
  k: TTypeKind;
begin
  k := TKind(T);
  Result := (TSize(T) = 8) and ((k = tykInteger) or (k = tykEnum) or
    (k = tykSubrange) or (k = tykPointer) or (k = tykClass));
end;

{ P288: E is what a leaf works out in registers: constants, the
  routine's own word parameters (Par), a word field of a class
  parameter, joined by the operators that call nothing and check
  nothing (+, -, *, and, or, xor, shl, shr, unary - and not). No index
  (its check calls rt_boundsfail), no division (its check), no call. }
function TEmitter.LeafE(E: PExpr; const Par: TStrArray): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  case E^.Kind of
    ekInt:
      Result := True;
    ekVar:
      for i := 0 to High(Par) do
        if SameSym(Par[i], E^.Name) then
          Result := True;
    ekField:
      Result := (E^.L <> nil) and (E^.L^.Kind = ekVar) and
        (TKind(E^.L^.Typ) = tykClass) and LeafWord(E^.Typ) and LeafE(E^.L, Par);
    ekUn:
      Result := ((E^.Un = uoNeg) or (E^.Un = uoNot)) and (TSize(E^.Typ) = 8) and
        (TKind(E^.Typ) = tykInteger) and LeafE(E^.L, Par);
    ekBin:
      Result := ((E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or
        (E^.Bin = boAnd) or (E^.Bin = boOr) or (E^.Bin = boXor) or
        (E^.Bin = boShl) or (E^.Bin = boShr)) and (TSize(E^.Typ) = 8) and
        (TKind(E^.Typ) = tykInteger) and LeafE(E^.L, Par) and LeafE(E^.R, Par);
  end;
end;

{ P288: Pr is a leaf of one statement, St, Result := E: a function of
  word parameters passed by value (Self too), at most three on amd64
  (rdi, rsi and rdx: the expression pool from r8 on does not reach
  them, and the operators of LeafE take only rax for a wide constant
  and rcx for a shift's count) and eight on arm64 (x0 to x7; the pool
  is x9 and up), with E of LeafE, no local, no nested routine, no
  closure's cell, and no -debug (whose hook is a call at every
  statement) or -checkptr. It calls nothing and keeps nothing in
  memory, so it needs no stack check (its caller's left the red zone
  below its frame, P342), no frame and no stack map, as Go makes a
  function that calls nothing and whose frame is under StackSmall
  NOSPLIT, and gives one
  without locals no base pointer (cmd/internal/obj/x86/obj6.go,
  preprocess). Called once the routine's symbols are in FSym, which
  OrdSimple reads. }
function TEmitter.LeafProc(const Pr: TProc; out St: PStmt): Boolean;
var
  i, n: SizeInt;
  s: PStmt;
  par: TStrArray;
begin
  Result := False;
  St := nil;
  if FDebug or FCheckPtr or (Pr.Nest > 0) or Pr.IsCtor or Pr.RecCtor or
    (not Pr.IsFunc) or Pr.Boxing or (Length(Pr.Shared) > 0) or
    (Length(Pr.Pins) > 0) or (Length(Pr.Locals) > 0) or (Pr.Body = nil) then
    Exit;
  for i := 0 to High(FProgProcs) do
    if FProgProcs[i].ParentSym = Pr.Sym then
      Exit;
  if not LeafWord(Pr.RetTyp) then
    Exit;
  n := Length(Pr.Params) + Ord(HasSelf(Pr));
  if (FArm and (n > 8)) or ((not FArm) and (n > 3)) then
    Exit;
  par := nil;
  if HasSelf(Pr) then
  begin
    SetLength(par, 1);
    par[0] := 'self';
  end;
  for i := 0 to High(Pr.Params) do
  begin
    if Pr.Params[i].ByRef or not LeafWord(Pr.Params[i].Typ) then
      Exit;
    SetLength(par, Length(par) + 1);
    par[High(par)] := Pr.Params[i].Name;
  end;
  s := Pr.Body;
  if s^.Kind = skBlock then
  begin
    if Length(s^.Stmts) <> 1 then
      Exit;
    s := s^.Stmts[0];
  end;
  if (s = nil) or (s^.Kind <> skAssign) or (s^.E = nil) then
    Exit;
  if s^.Dest = nil then
  begin
    if not (SameSym(s^.Name, 'result') or SameSym(s^.Name, Pr.Name)) then
      Exit;
  end
  else if (s^.Dest^.Kind <> ekVar) or not (SameSym(s^.Dest^.Name, 'result') or
    SameSym(s^.Dest^.Name, Pr.Name)) then
    Exit;
  if not LeafE(s^.E, par) then
    Exit;
  if FArm then
  begin
    if not OrdSimple(s^.E, 0) then
      Exit;
  end
  else if not OrdSimple(s^.E, 2) then
    Exit;
  St := s;
  Result := True;
end;

{ The parameter N of the routine being emitted lives in register R, DWARF
  register Dw, from the routine's label to EndLab: the whole of a leaf
  (P288). }
procedure TEmitter.LeafReg(const N, R: string; Dw: LongInt; const Proc, EndLab: string);
var
  i, j: SizeInt;
begin
  for i := High(FSym) downto 0 do
    if (not FSym[i].Global) and (FSym[i].Up = 0) and SameSym(FSym[i].Name, N) then
    begin
      FSym[i].Reg := R;
      j := Length(FLocRanges);
      SetLength(FLocRanges, j + 1);
      FLocRanges[j].Proc := Proc;
      FLocRanges[j].Off := FSym[i].Off;
      FLocRanges[j].Dw := Dw;
      FLocRanges[j].B := Proc;
      FLocRanges[j].E := EndLab;
      Exit;
    end;
end;

{ A leaf's body (P288): its parameters stay in the registers they came
  in (DWARF 5, 4 and 1 for rdi, rsi and rdx; 0 to 7 for x0 to x7), where
  the debugger reads them; the expression is worked out in the pool past
  them, a constant, a parameter or a field straight into rax or x0. The
  CFA stays the stack pointer at the call, as .cfi_startproc says. }
procedure TEmitter.EmitLeaf(const Pr: TProc; St: PStmt);
var
  i, k: SizeInt;
  e1, m: string;
  s: TSym;
  E: PExpr;
begin
  e1 := Lab;
  Line('  .cfi_startproc');
  k := 0;
  if HasSelf(Pr) then
  begin
    if FArm then
      LeafReg('self', 'x0', 0, Pr.Sym, e1)
    else
      LeafReg('self', 'rdi', 5, Pr.Sym, e1);
    k := 1;
  end;
  for i := 0 to High(Pr.Params) do
  begin
    if FArm then
      LeafReg(Pr.Params[i].Name, 'x' + IntToStr(k), LongInt(k), Pr.Sym, e1)
    else if k = 0 then
      LeafReg(Pr.Params[i].Name, 'rdi', 5, Pr.Sym, e1)
    else if k = 1 then
      LeafReg(Pr.Params[i].Name, 'rsi', 4, Pr.Sym, e1)
    else
      LeafReg(Pr.Params[i].Name, 'rdx', 1, Pr.Sym, e1);
    Inc(k);
  end;
  EmitLoc(St^.Line);
  E := St^.E;
  if E^.Kind = ekInt then
  begin
    if FArm then
      Imm('x0', E^.Num)
    else
      LoadImmR('rax', E^.Num);
  end
  else if E^.Kind = ekVar then
  begin
    if not WordVar(E, s) then
      Die('internal error: leaf operand ' + E^.Name);
    if FArm then
    begin
      if s.Reg <> 'x0' then
        Line('  mov x0, ' + s.Reg);
    end
    else
      Line('  movq %' + s.Reg + ', %rax');
  end
  else if E^.Kind = ekField then
  begin
    if FArm then
    begin
      m := EmitWordMem(E, 0);
      WordLoad(m, LoadTyp(E), 'x0');
    end
    else
    begin
      m := EmitWordMem(E, 2);
      WordLoad(m, LoadTyp(E), 'rax');
    end;
  end
  else if FArm then
  begin
    EmitOrdTo(E, 0);
    Line('  mov x0, ' + OrdPool(0));
  end
  else
  begin
    EmitOrdTo(E, 2);
    Line('  movq %' + OrdPool(2) + ', %rax');
  end;
  Line('  ret');
  Line(e1 + ':');
  Line('  .cfi_endproc');
end;

{ P296: Pr calls nothing and every one of its own variables can be kept
  in a register: no -debug or -checkptr, not nested, no nested routine,
  closure's box or pinned cell, not a constructor, no asm, a body of
  statements a region takes (PromoStmtOK: no call), word parameters by
  value in registers (six on amd64, eight on arm64, Self counted), and
  Self, the parameters, Result and the locals all PromoCand's (a word or
  a narrow integer, a Boolean, a pointer or a class, its address not
  taken). Not in the runtime's units, which take no async preemption, so
  their loops test the guard with a slow path that needs homes. Read
  once the routine's symbols are in FSym and FLocAddr is known. }
function TEmitter.FlatProc(const Pr: TProc): Boolean;
var
  i: SizeInt;
  n: LongInt;
  ok: Boolean;
begin
  Result := False;
  if FDebug or FCheckPtr or FRtUnit or (Pr.Nest > 0) or Pr.IsCtor or Pr.RecCtor or
    Pr.Boxing or (Length(Pr.Shared) > 0) or (Length(Pr.Pins) > 0) or (Pr.Body = nil) or
    HasAsm(Pr.Body) then
    Exit;
  for i := 0 to High(FProgProcs) do
    if FProgProcs[i].ParentSym = Pr.Sym then
      Exit;
  n := Length(Pr.Params) + Ord(HasSelf(Pr));
  if (FArm and (n > 8)) or ((not FArm) and (n > 6)) then
    Exit;
  for i := 0 to High(Pr.Params) do
    if Pr.Params[i].ByRef or IsFat(Pr.Params[i].Typ) or IsBlob(Pr.Params[i].Typ) then
      Exit;
  FFlatCheck := True;
  ok := True;
  if Pr.Body^.Kind = skBlock then
  begin
    for i := 0 to High(Pr.Body^.Stmts) do
      if not PromoStmtOK(Pr.Body^.Stmts[i], False) then
        ok := False;
  end
  else
    ok := PromoStmtOK(Pr.Body, False);
  FFlatCheck := False;
  if not ok then
    Exit;
  { FSym has room past the routine's own symbols, entries with no name }
  for i := 0 to High(FSym) do
    if (FSym[i].Name <> '') and (not FSym[i].Global) and (FSym[i].Up = 0) and
      not PromoCand(FSym[i]) then
      Exit;
  Result := True;
end;

{ P296: Pr's body with every variable of its own in a register and no
  frame, as Go keeps a leaf's values in registers and gives a function
  with no locals left in memory no frame (cmd/compile/internal/ssa/
  regalloc.go; cmd/internal/obj/x86/obj6.go: no BP saved for a frameless
  leaf; arm64 obj7.go: a leaf with no frame saves no LR). The registers:
  amd64 r9, r10 and r11 (r11 the run's end with an inner for, r8 too in a
  body of integer arithmetic alone), which nothing saves, then rbx, r12,
  r13 and r15, pushed and popped; arm64 x19 to x26 (x26 the run's end
  with an inner for), saved in pairs, as a region takes them: the pool
  is rsi, rdi and r8 inside a region (PoolSize) and x9 up, rax, rcx and
  rdx or x0 to x8, x16 and x17 its scratch. A parameter keeps the register it came in where that is one
  of them, else moves there; a local and Result start as zero. Every
  variable's DWARF location is its register over the routine (LeafReg).
  False with nothing written, everything as it was, when more variables
  than registers, or when the body took a frame word after all (a
  scratch slot, a reference to the frame): the routine is emitted with
  its frame then. }
function TEmitter.EmitFlat(const Pr: TProc): Boolean;
var
  avail, dregs, pushed: TStrArray;
  own: array of SizeInt;
  i, j, k, n, ai, nll, nlr, st0, sm: SizeInt;
  cl0, dl0: LongInt;
  wt: array of LongInt;
  parts: array of TPromo;
  inner, pure, used8, moved, ok, coldback: Boolean;
  r, nm, e1, txt, body, body1, body2: string;
  arrive0, force, cand, reg1: TStrArray;
  b0: SizeInt;
  changed: Boolean;
  arrive: TStrArray;

  function StrToIntSafe(const T: string): LongInt;
  var
    q: SizeInt;
  begin
    Result := 0;
    for q := 1 to Length(T) do
      if (T[q] >= '0') and (T[q] <= '9') then
        Result := Result * 10 + (Ord(T[q]) - Ord('0'));
  end;

  function DwOf(const R: string): LongInt;
  begin
    if FArm then
      Result := StrToIntSafe(Copy(R, 2, 3))
    else if R = 'rax' then
      Result := 0
    else if R = 'rdx' then
      Result := 1
    else if R = 'rcx' then
      Result := 2
    else if R = 'rbx' then
      Result := 3
    else if R = 'rsi' then
      Result := 4
    else if R = 'rdi' then
      Result := 5
    else
      Result := StrToIntSafe(Copy(R, 2, 3));
  end;

  function InFree(const R: string): SizeInt;
  var
    q: SizeInt;
  begin
    Result := -1;
    for q := 0 to High(avail) do
      if avail[q] = R then
      begin
        Result := q;
        Exit;
      end;
  end;

begin
  Result := False;
  st0 := FLen;
  { the line the last .loc named: a second emission names it again }
  cl0 := FCurLine;
  dl0 := FDbgLine;
  nll := Length(FLineLabs);
  nlr := Length(FLocRanges);
  sm := FScratchMax;
  inner := False;
  pure := not FArm;
  if Pr.Body^.Kind = skBlock then
  begin
    for i := 0 to High(Pr.Body^.Stmts) do
    begin
      if HasInnerFor(Pr.Body^.Stmts[i]) then
        inner := True;
      if pure and not PureIntS(Pr.Body^.Stmts[i]) then
        pure := False;
    end;
  end
  else
  begin
    inner := HasInnerFor(Pr.Body);
    pure := pure and PureIntS(Pr.Body);
  end;
  { the registers in the order they are handed out }
  avail := nil;
  if FArm then
  begin
    { x19 to x26, saved as a region saves them (x2 to x8 are the
      emitter's scratch, x27 the static link, x28 the routine's G); x26
      the run's end with an inner for }
    for i := 19 to 26 do
      if not (inner and (i = 26)) then
      begin
        SetLength(avail, Length(avail) + 1);
        avail[High(avail)] := 'x' + IntToStr(i);
      end;
  end
  else
  begin
    SetLength(avail, 2);
    avail[0] := 'r9';
    avail[1] := 'r10';
    if not inner then
    begin
      SetLength(avail, 3);
      avail[2] := 'r11';
    end;
    if pure then
    begin
      SetLength(avail, Length(avail) + 1);
      avail[High(avail)] := 'r8';
    end;
    SetLength(avail, Length(avail) + 4);
    avail[High(avail) - 3] := 'rbx';
    avail[High(avail) - 2] := 'r12';
    avail[High(avail) - 1] := 'r13';
    avail[High(avail)] := 'r15';
  end;
  { the routine's own variables: Self, the parameters, Result, the locals }
  own := nil;
  for i := 0 to High(FSym) do
    if (FSym[i].Name <> '') and (not FSym[i].Global) and (FSym[i].Up = 0) then
    begin
      SetLength(own, Length(own) + 1);
      own[High(own)] := i;
    end;
  if Length(own) > Length(avail) then
    Exit;
  { where each came in: '' for a local or Result }
  arrive := nil;
  SetLength(arrive, Length(own));
  SetLength(dregs, Length(own));
  for j := 0 to High(own) do
  begin
    arrive[j] := '';
    dregs[j] := '';
    nm := FSym[own[j]].Name;
    ai := -1;
    if HasSelf(Pr) and SameSym(nm, 'self') then
      ai := 0
    else
      for i := 0 to High(Pr.Params) do
        if SameSym(nm, Pr.Params[i].Name) then
          ai := i + Ord(HasSelf(Pr));
    if ai >= 0 then
    begin
      if FArm then
        arrive[j] := 'x' + IntToStr(ai)
      else
        arrive[j] := ArgReg(LongInt(ai));
    end;
  end;
  SetLength(arrive0, Length(own));
  for j := 0 to High(own) do
    arrive0[j] := arrive[j];
  { a parameter that came in one of the registers keeps it, and one that
    the second emission sets elsewhere (FFlatForce) }
  for j := 0 to High(own) do
    if (arrive[j] <> '') and (InFree(arrive[j]) >= 0) then
    begin
      dregs[j] := arrive[j];
      avail[InFree(arrive[j])] := '';
    end
    else if (FFlatTry = 1) and (FFlatForce[j] <> '') then
      dregs[j] := FFlatForce[j];
  { the second emission's choices for the others (FFlatForce) }
  if FFlatTry = 1 then
    for j := 0 to High(own) do
      if (dregs[j] = '') and (FFlatForce[j] <> '') then
        dregs[j] := FFlatForce[j];
  { a register taken so is no more to hand out }
  for j := 0 to High(own) do
    if (dregs[j] <> '') and (InFree(dregs[j]) >= 0) then
      avail[InFree(dregs[j])] := '';
  { the others by their weight, as a region counts it (PromoScanS: a use
    eight times a loop level), the heaviest into the registers nothing
    saves }
  SetLength(wt, Length(own));
  FPromo := nil;
  FFatWritten := nil;
  if Pr.Body^.Kind = skBlock then
  begin
    for i := 0 to High(Pr.Body^.Stmts) do
      PromoScanS(Pr.Body^.Stmts[i], 1);
  end
  else
    PromoScanS(Pr.Body, 1);
  for j := 0 to High(own) do
  begin
    wt[j] := 0;
    for i := 0 to High(FPromo) do
      if (FPromo[i].Part = 0) and (not FPromo[i].Place.Global) and
        SamePlace(FPromo[i].Place, FSym[own[j]]) then
        wt[j] := FPromo[i].Refs;
  end;
  { a global's part a region would keep, read twice or more: a slice's
    pointer and length the body does not assign, an arm64 static array's
    address, Carry's byte (PromoAddPart), in a register too, loaded at the
    entry as LoadHomePart loads a region's, found by PartReg in FPromo }
  parts := nil;
  for i := 0 to High(FPromo) do
    if (FPromo[i].Part > 0) and (FPromo[i].Part <> 4) and (FPromo[i].Refs >= 2) and
      (FPromo[i].Place.Global or (FPromo[i].Part = 9)) and
      ((FPromo[i].Part >= 3) or not InNames(FFatWritten, NormName(FPromo[i].Place.Name))) then
    begin
      SetLength(parts, Length(parts) + 1);
      parts[High(parts)] := FPromo[i];
      parts[High(parts)].Reg := '';
    end;
  FPromo := nil;
  FFatWritten := nil;
  k := 0;
  repeat
    n := -1;
    for j := 0 to High(own) do
      if (dregs[j] = '') and ((n < 0) or (wt[j] > wt[n])) then
        n := j;
    if n >= 0 then
    begin
      while (k <= High(avail)) and (avail[k] = '') do
        Inc(k);
      if k > High(avail) then
        Exit;
      dregs[n] := avail[k];
      avail[k] := '';
    end;
  until n < 0;
  for i := 0 to High(parts) do
  begin
    if (FFlatTry = 1) and (i <= High(FFlatParts)) then
      parts[i].Reg := FFlatParts[i]
    else
    begin
      while (k <= High(avail)) and (avail[k] = '') do
        Inc(k);
      if k <= High(avail) then
      begin
        parts[i].Reg := avail[k];
        avail[k] := '';
      end;
    end;
  end;
  used8 := False;
  for j := 0 to High(own) do
    if dregs[j] = 'r8' then
      used8 := True;
  for i := 0 to High(parts) do
    if parts[i].Reg = 'r8' then
      used8 := True;
  { the kept registers it takes are pushed: amd64 rbx, r12, r13 and r15;
    arm64 every x19 to x26, two at a time, sp on 16 (AAPCS64 5.2.2) }
  pushed := nil;
  for j := 0 to High(own) do
    if SavedReg(dregs[j]) then
    begin
      SetLength(pushed, Length(pushed) + 1);
      pushed[High(pushed)] := dregs[j];
    end;
  for i := 0 to High(parts) do
    if SavedReg(parts[i].Reg) then
    begin
      SetLength(pushed, Length(pushed) + 1);
      pushed[High(pushed)] := parts[i].Reg;
    end;
  if FArm and inner then
  begin
    SetLength(pushed, Length(pushed) + 1);
    pushed[High(pushed)] := 'x26';
  end;
  if FArm and (Length(pushed) mod 2 = 1) then
  begin
    SetLength(pushed, Length(pushed) + 1);
    pushed[High(pushed)] := 'xzr';
  end;
  e1 := Lab;
  Line('  .cfi_startproc');
  FFlatCfa := 8;
  if FArm then
  begin
    FFlatCfa := 0;
    i := 0;
    while i < Length(pushed) do
    begin
      Line('  stp ' + pushed[i] + ', ' + pushed[i + 1] + ', [sp, #-16]!');
      FFlatCfa := FFlatCfa + 16;
      Line('  .cfi_def_cfa_offset ' + IntToStr(FFlatCfa));
      Line('  .cfi_offset ' + IntToStr(DwOf(pushed[i])) + ', -' + IntToStr(FFlatCfa));
      if pushed[i + 1] <> 'xzr' then
        Line('  .cfi_offset ' + IntToStr(DwOf(pushed[i + 1])) + ', -' + IntToStr(FFlatCfa - 8));
      i := i + 2;
    end;
  end
  else
    for i := 0 to High(pushed) do
    begin
      Line('  pushq %' + pushed[i]);
      FFlatCfa := FFlatCfa + 8;
      Line('  .cfi_def_cfa_offset ' + IntToStr(FFlatCfa));
      Line('  .cfi_offset %' + pushed[i] + ', -' + IntToStr(FFlatCfa));
    end;
  FFlatPad := (not FArm) and (Length(pushed) mod 2 = 0);
  { the parameters into theirs, none moved before its own register is
    read: a destination is never a register another parameter came in
    but its own (r8 and r9 keep theirs) }
  repeat
    moved := False;
    for j := 0 to High(own) do
      if (arrive[j] <> '') and (arrive[j] <> dregs[j]) then
      begin
        ok := True;
        for i := 0 to High(own) do
          if (i <> j) and (arrive[i] = dregs[j]) then
            ok := False;
        if ok then
        begin
          if FArm then
            Line('  mov ' + dregs[j] + ', ' + arrive[j])
          else
            Line('  movq %' + arrive[j] + ', %' + dregs[j]);
          arrive[j] := dregs[j];
          moved := True;
        end;
      end;
  until not moved;
  for j := 0 to High(own) do
    if (arrive[j] <> '') and (arrive[j] <> dregs[j]) then
      Die('internal error: a parameter of ' + Pr.Sym + ' with no register');
  { a local and Result start as zero, but where every path writes them
    before it reads them (WritesFirst, DaSetup's FDaResKeep: P284) }
  DaSetup(Pr, 0);
  for j := 0 to High(own) do
  begin
    if arrive[j] <> '' then
      Continue;
    if FHasRes and (FSym[own[j]].Off = FResOff) then
    begin
      if FDaResKeep then
        Continue;
    end
    else if WritesFirst(Pr.Body, FSym[own[j]].Name, '') then
      Continue;
    if FArm then
      Line('  mov ' + dregs[j] + ', xzr')
    else
      Line('  xorl %' + X86Sub(dregs[j], 4) + ', %' + X86Sub(dregs[j], 4));
  end;
  { the symbols at their registers, with their DWARF ranges }
  for j := 0 to High(own) do
  begin
    FSym[own[j]].Reg := dregs[j];
    n := Length(FLocRanges);
    SetLength(FLocRanges, n + 1);
    FLocRanges[n].Proc := Pr.Sym;
    FLocRanges[n].Off := FSym[own[j]].Off;
    FLocRanges[n].Dw := DwOf(dregs[j]);
    FLocRanges[n].B := Pr.Sym;
    FLocRanges[n].E := e1;
    if FHasRes and (FSym[own[j]].Off = FResOff) then
      FResReg := dregs[j];
  end;
  n := 0;
  for i := 0 to High(parts) do
    if parts[i].Reg <> '' then
      LoadHomePart(parts[i].Place, parts[i].Part, parts[i].Reg);
  FPromo := nil;
  for i := 0 to High(parts) do
    if parts[i].Reg <> '' then
    begin
      SetLength(FPromo, Length(FPromo) + 1);
      FPromo[High(FPromo)] := parts[i];
    end;
  FFlat := True;
  FPromoOn := True;
  FR8Lent := used8;
  FChunkSave := 0;
  if inner then
  begin
    if FArm then
    begin
      FChunkReg := 'x26';
      FChunkDw := 26;
    end
    else
    begin
      FChunkReg := 'r11';
      FChunkDw := 11;
    end;
  end
  else
    FChunkReg := '';
  BoxSetup(Pr);
  b0 := FLen;
  EmitStmt(Pr.Body);
  body := Copy(FOut, b0 + 1, FLen - b0) + FCold;
  DropJumpTo(FEpi);
  Line(FEpi + ':');
  if Pr.IsFunc then
  begin
    r := FResReg;
    if FArm then
    begin
      if r <> 'x0' then
        Line('  mov x0, ' + r);
    end
    else if r <> 'rax' then
      Line('  movq %' + r + ', %rax');
  end;
  if Length(pushed) > 0 then
    Line('  .cfi_remember_state');
  if FArm then
  begin
    i := Length(pushed) - 2;
    while i >= 0 do
    begin
      if pushed[i + 1] = 'xzr' then
        Line('  ldr ' + pushed[i] + ', [sp], #16')
      else
        Line('  ldp ' + pushed[i] + ', ' + pushed[i + 1] + ', [sp], #16');
      Line('  .cfi_def_cfa_offset ' + IntToStr(8 * i));
      i := i - 2;
    end;
  end
  else
    for i := High(pushed) downto 0 do
    begin
      Line('  popq %' + pushed[i]);
      Line('  .cfi_def_cfa_offset ' + IntToStr(8 + 8 * i));
    end;
  Line('  ret');
  if Length(pushed) > 0 then
    Line('  .cfi_restore_state');
  coldback := (Pos('  jmp ', FCold) > 0) or (Pos('  b .', FCold) > 0) or (Pos('  b ' , FCold) > 0);
  ColdFlush(False);
  Line(e1 + ':');
  Line('  .cfi_endproc');
  FFlat := False;
  FFlatPad := False;
  FPromo := nil;
  FPromoOn := False;
  FR8Lent := False;
  FChunkReg := '';
  FResReg := '';
  for j := 0 to High(own) do
    FSym[own[j]].Reg := '';
  { a frame word after all: emitted again with its frame }
  txt := Copy(FOut, st0 + 1, FLen - st0);
  { a block out of line that jumps back (a string's append, its call's
    slow path) would come back with rsp moved and, on arm64, the return
    address in x30 overwritten: such a routine keeps its frame }
  if (FScratchMax > sm) or (FCold <> '') or coldback or
    ((not FArm) and ((Pos('(%rbp)', body) > 0) or (Pos('(%rsp)', body) > 0))) or
    (FArm and ((Pos('x29', body) > 0) or (Pos('[sp', body) > 0))) or (Pos(FFrameSym, txt) > 0) then
  begin
    FLen := st0;
    FCurLine := cl0;
    FDbgLine := dl0;
    SetLength(FLineLabs, nll);
    SetLength(FLineNums, nll);
    SetLength(FLocRanges, nlr);
    FScratchMax := sm;
    FCold := '';
    FLastIns := '';
    FIxOn := False;
    FChkOn := False;
    FZeroN := 0;
    Exit;
  end;
  Result := True;
  { second emission (P296): a variable moves into a register the body
    and its failures name nowhere and nothing there writes behind the
    text, one nothing saves: a parameter into its own arrival register,
    any into rax or x0 (Result then needs no move), rdi, rsi, rdx, rcx
    and r8, or x0 to x15, but none into another parameter's arrival
    register (the moves at the entry then have no cycle). The pool and
    the scratch do not depend on where the variables live; the second
    body, its new registers renamed to the first's, must be the first
    body, or the first is emitted again. }
  if FFlatTry = 0 then
  begin
    SetLength(force, Length(own));
    SetLength(cand, 0);
    if FArm then
    begin
      for i := 0 to 15 do
        if i <> 9 then
        begin
          SetLength(cand, Length(cand) + 1);
          cand[High(cand)] := 'x' + IntToStr(i);
        end;
    end
    else
    begin
      SetLength(cand, 6);
      cand[0] := 'rax';
      cand[1] := 'rdi';
      cand[2] := 'rsi';
      cand[3] := 'rdx';
      cand[4] := 'rcx';
      cand[5] := 'r8';
    end;
    changed := False;
    for j := 0 to High(own) do
      force[j] := '';
    { a parameter into its own arrival register }
    for j := 0 to High(own) do
      if (arrive0[j] <> '') and (arrive0[j] <> dregs[j]) and not RegNamed(body, arrive0[j]) and
        not RegTaken(dregs, arrive0[j]) then
      begin
        force[j] := arrive0[j];
        changed := True;
      end;
    { Result into rax or x0 }
    for j := 0 to High(own) do
      if FHasRes and (FSym[own[j]].Off = FResOff) and (force[j] = '') then
      begin
        if FArm then
          r := 'x0'
        else
          r := 'rax';
        if (not RegNamed(body, r)) and (not RegTaken(dregs, r)) and (not RegTaken(force, r)) and
          not ArrivesIn(arrive0, r) then
        begin
          force[j] := r;
          changed := True;
        end;
      end;
    { the rest, heaviest first, from a register that needs a save }
    repeat
      n := -1;
      for j := 0 to High(own) do
        if (force[j] = '') and SavedReg(dregs[j]) and ((n < 0) or (wt[j] > wt[n])) then
          n := j;
      if n >= 0 then
      begin
        r := '';
        for i := 0 to High(cand) do
          if (r = '') and (not RegNamed(body, cand[i])) and (not RegTaken(dregs, cand[i])) and
            (not RegTaken(force, cand[i])) and not ArrivesIn(arrive0, cand[i]) then
            r := cand[i];
        if r = '' then
          force[n] := '-'
        else
        begin
          force[n] := r;
          changed := True;
        end;
      end;
    until n < 0;
    for j := 0 to High(own) do
      if force[j] = '-' then
        force[j] := '';
    if changed then
    begin
      body1 := body;
      SetLength(reg1, Length(own));
      for j := 0 to High(own) do
        reg1[j] := dregs[j];
      FLen := st0;
      FCurLine := cl0;
      FDbgLine := dl0;
      SetLength(FLineLabs, nll);
      SetLength(FLineNums, nll);
      SetLength(FLocRanges, nlr);
      FScratchMax := sm;
      FLastIns := '';
      FIxOn := False;
      FChkOn := False;
      FZeroN := 0;
      FFlatForce := force;
      SetLength(FFlatParts, Length(parts));
      for i := 0 to High(parts) do
        FFlatParts[i] := parts[i].Reg;
      FFlatTry := 1;
      ok := EmitFlat(Pr);
      if ok then
      begin
        { the second body with its registers named as the first's }
        body2 := FFlatBody;
        for j := 0 to High(own) do
          if FFlatRegs[j] <> reg1[j] then
            body2 := RenameReg(body2, FFlatRegs[j], '@' + IntToStr(j) + '@');
        for j := 0 to High(own) do
          if FFlatRegs[j] <> reg1[j] then
            body2 := RenameRegTo(body2, '@' + IntToStr(j) + '@', reg1[j]);
        { the labels of the second count on from the first's }
        ok := NormLabels(body2) = NormLabels(body1);
      end;
      if not ok then
      begin
        FLen := st0;
        FCurLine := cl0;
        FDbgLine := dl0;
        SetLength(FLineLabs, nll);
        SetLength(FLineNums, nll);
        SetLength(FLocRanges, nlr);
        FScratchMax := sm;
        FLastIns := '';
        FIxOn := False;
        FChkOn := False;
        FZeroN := 0;
        FFlatTry := 2;
        Result := EmitFlat(Pr);
      end;
      FFlatTry := 0;
      FFlatForce := nil;
      FFlatParts := nil;
    end;
  end;
  FFlatBody := body;
  FFlatRegs := dregs;
end;

{ T with its labels .Ln and .LLn renumbered in the order they first
  appear, so two emissions of one body compare (P296). }
function TEmitter.NormLabels(const T: string): string;
var
  i, k, n, q: SizeInt;
  names: TStrArray;
  id: string;
begin
  Result := '';
  names := nil;
  n := Length(T);
  i := 1;
  while i <= n do
  begin
    if (T[i] = '.') and (i < n) and (T[i + 1] = 'L') and ((i = 1) or not (T[i - 1] in ['a'..'z', 'A'..'Z', '0'..'9', '_'])) then
    begin
      k := i + 2;
      while (k <= n) and (T[k] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
        Inc(k);
      id := Copy(T, i, k - i);
      q := 0;
      while (q <= High(names)) and (names[q] <> id) do
        Inc(q);
      if q > High(names) then
      begin
        SetLength(names, q + 1);
        names[q] := id;
      end;
      Result := Result + '.L#' + IntToStr(q);
      i := k;
      Continue;
    end;
    Result := Result + T[i];
    Inc(i);
  end;
end;

{ The registers of L include R (P296). }
function TEmitter.RegTaken(const L: TStrArray; const R: string): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  for i := 0 to High(L) do
    if L[i] = R then
      Result := True;
end;

{ R is one a parameter came in (P296). }
function TEmitter.ArrivesIn(const L: TStrArray; const R: string): Boolean;
begin
  Result := RegTaken(L, R);
end;

{ R needs a save: amd64 rbx, r12, r13, r15; arm64 x19 and up (P296). }
function TEmitter.SavedReg(const R: string): Boolean;
begin
  if FArm then
    Result := (Length(R) = 3) and (R[1] = 'x') and ((R[2] = '1') or (R[2] = '2')) and
      (((R[2] = '1') and (R[3] = '9')) or (R[2] = '2'))
  else
    Result := (R = 'rbx') or (R = 'r12') or (R = 'r13') or (R = 'r15');
end;

{ The text T names R on either machine (P296): NamesReg on amd64; on
  arm64 xN or wN as a word, or a string instruction or a call that
  returns does not count (none is left). }
function TEmitter.RegNamed(const T, R: string): Boolean;
var
  i, n, k: SizeInt;
  num: string;
begin
  if not FArm then
  begin
    Result := NamesReg(T, R);
    Exit;
  end;
  Result := True;
  num := Copy(R, 2, Length(R) - 1);
  n := Length(T);
  i := 1;
  while i <= n do
  begin
    if ((T[i] = 'x') or (T[i] = 'w')) and ((i = 1) or not (T[i - 1] in ['a'..'z', 'A'..'Z', '0'..'9', '_', '.'])) then
    begin
      k := i + 1;
      while (k <= n) and (T[k] >= '0') and (T[k] <= '9') do
        Inc(k);
      if (k > i + 1) and (Copy(T, i + 1, k - i - 1) = num) and
        ((k > n) or not (T[k] in ['a'..'z', 'A'..'Z', '0'..'9', '_'])) then
        Exit;
      i := k;
    end
    else
      Inc(i);
  end;
  Result := False;
end;

{ T with register R renamed to the marker M at every width (P296). }
function TEmitter.RenameReg(const T, R, M: string): string;
var
  i, n, k, w: SizeInt;
  num, id: string;
begin
  Result := '';
  n := Length(T);
  i := 1;
  if FArm then
  begin
    num := Copy(R, 2, Length(R) - 1);
    while i <= n do
    begin
      if ((T[i] = 'x') or (T[i] = 'w')) and ((i = 1) or not (T[i - 1] in ['a'..'z', 'A'..'Z', '0'..'9', '_', '.'])) then
      begin
        k := i + 1;
        while (k <= n) and (T[k] >= '0') and (T[k] <= '9') do
          Inc(k);
        if (k > i + 1) and (Copy(T, i + 1, k - i - 1) = num) and
          ((k > n) or not (T[k] in ['a'..'z', 'A'..'Z', '0'..'9', '_'])) then
        begin
          Result := Result + T[i] + M;
          i := k;
          Continue;
        end;
      end;
      Result := Result + T[i];
      Inc(i);
    end;
    Exit;
  end;
  while i <= n do
  begin
    if T[i] = '%' then
    begin
      k := i + 1;
      while (k <= n) and (T[k] in ['a'..'z', '0'..'9']) do
        Inc(k);
      id := Copy(T, i + 1, k - i - 1);
      w := 0;
      if id = R then
        w := 8
      else if id = X86Sub(R, 4) then
        w := 4
      else if id = X86Sub(R, 2) then
        w := 2
      else if id = X86Sub(R, 1) then
        w := 1;
      if w > 0 then
      begin
        Result := Result + '%' + M + IntToStr(w);
        i := k;
        Continue;
      end;
    end;
    Result := Result + T[i];
    Inc(i);
  end;
end;

{ T with the marker M back as register R at the width it marks (P296). }
function TEmitter.RenameRegTo(const T, M, R: string): string;
var
  i, n, w: SizeInt;
begin
  Result := '';
  n := Length(T);
  i := 1;
  while i <= n do
  begin
    if Copy(T, i, Length(M)) = M then
    begin
      if FArm then
      begin
        Result := Result + Copy(R, 2, Length(R) - 1);
        i := i + Length(M);
      end
      else
      begin
        w := Ord(T[i + Length(M)]) - Ord('0');
        Result := Result + X86Sub(R, w);
        i := i + Length(M) + 1;
      end;
      Continue;
    end;
    Result := Result + T[i];
    Inc(i);
  end;
end;

{ The text T names register R (amd64) at any width, or writes it behind
  its text: cqto, cltq, a division or a one-operand multiply rdx (and
  rax), a string instruction rcx, rsi and rdi, a syscall rcx (P296). }
function TEmitter.NamesReg(const T, R: string): Boolean;
var
  i: SizeInt;
  w: TStrArray;
  sfx: string;
begin
  Result := True;
  w := nil;
  SetLength(w, 4);
  w[0] := '%' + R;
  w[1] := '%' + X86Sub(R, 4);
  w[2] := '%' + X86Sub(R, 2);
  w[3] := '%' + X86Sub(R, 1);
  for i := 0 to 3 do
    if Pos(w[i], T) > 0 then
      Exit;
  if ((R = 'rdx') or (R = 'rax')) and ((Pos('cqto', T) > 0) or (Pos('cltd', T) > 0) or (Pos('div', T) > 0) or
    (Pos('mulq %', T) > 0) or (Pos('imulq %', T) > 0) or (Pos('rdtsc', T) > 0) or (Pos('cpuid', T) > 0)) then
    Exit;
  if ((R = 'rcx') or (R = 'rsi') or (R = 'rdi') or (R = 'rax')) and ((Pos('rep', T) > 0) or
    (Pos('syscall', T) > 0)) then
    Exit;
  if (R = 'rax') and ((Pos('cltq', T) > 0) or (Pos('cwtl', T) > 0) or (Pos('cbtw', T) > 0) or
    (Pos('cmpxchg', T) > 0)) then
    Exit;
  { a string instruction stands alone on its line }
  sfx := 'bwlq';
  for i := 1 to 4 do
    if (Pos('  movs' + sfx[i] + Char(10), T) > 0) or
      (Pos('  stos' + sfx[i] + Char(10), T) > 0) or
      (Pos('  lods' + sfx[i] + Char(10), T) > 0) or
      (Pos('  cmps' + sfx[i] + Char(10), T) > 0) or
      (Pos('  scas' + sfx[i] + Char(10), T) > 0) then
      if (R = 'rcx') or (R = 'rsi') or (R = 'rdi') or (R = 'rax') then
        Exit;
  Result := False;
end;

{ S has an asm statement somewhere: its text may call (P288). }
function TEmitter.HasAsm(S: PStmt): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if S = nil then
    Exit;
  Result := True;
  if S^.Kind = skAsm then
    Exit;
  if HasAsm(S^.ThenSt) or HasAsm(S^.ElseSt) or HasAsm(S^.Body) then
    Exit;
  for i := 0 to High(S^.Stmts) do
    if HasAsm(S^.Stmts[i]) then
      Exit;
  for i := 0 to High(S^.Arms) do
    if HasAsm(S^.Arms[i].Body) then
      Exit;
  Result := False;
end;

procedure TEmitter.EmitProc(const Pr: TProc);
var
  i, j, n, nargs, slot, parentN, own, nlim, k: SizeInt;
  pinUp: LongInt;
  savedAddr: array of string;
  ps, q: string;
  saved: array of TSym;
  dend, savedResName: string;
  savedResOff: LongInt;
  savedHas: Boolean;
  savedResTyp: LongInt;
  sz: LongInt;
  sysw: Boolean;
  savedTF: array of PStmt;
  savedTD: array of LongInt;
  savedTR: array of Boolean;
  loc0, loc1: SizeInt;
  leaf, flat: Boolean;
  lst: PStmt;
  ck0, ck1, ms0: SizeInt;
  savedSel: PStmt;
  savedLoadDone: Boolean;
  savedLoadAddr: TStrArray;
begin
  saved := FSym;
  savedSel := FSelBody;
  savedLoadDone := FLoadDone;
  savedLoadAddr := FLoadAddr;
  SelBodyIs(Pr.Body);
  savedResName := FResName;
  savedResOff := FResOff;
  savedHas := FHasRes;
  savedResTyp := FResTyp;
  savedTF := FTryFin;
  savedTD := FTryDep;
  savedTR := FTryRec;
  FTryFin := nil;
  FTryDep := nil;
  FTryRec := nil;
  { the processor of its code: its own (the $CPU and $TUNE where its body
    stands), or the program's (P261) }
  if Pr.CpuOwn then
  begin
    FCpuSet := Pr.CpuSet;
    FTune := Pr.CpuTune;
  end
  else
  begin
    FCpuSet := FProgCpu;
    FTune := FProgTune;
  end;

  FNest := Pr.Nest;
  parentN := 0;
  if Pr.Nest > 0 then
    for i := 0 to High(FOwnNames) do
      if FOwnNames[i] = Pr.ParentSym then
      begin
        parentN := Length(FOwnSyms[i]);
        Break;
      end;
  nargs := Length(Pr.Params);
  n := Length(saved) + parentN + nargs + Length(Pr.Locals) + Length(Pr.Pins) + 2;
  if Pr.IsFunc then
    Inc(n);
  SetLength(FSym, n);
  for i := 0 to High(saved) do
    FSym[i] := saved[i];
  n := Length(saved);
  { A closure that pins cells (1.0.134) is one level further: its link is
    a scope box whose -8 is its parent's link. }
  pinUp := 1;
  if Length(Pr.Pins) > 0 then
    pinUp := 2;
  if Pr.Nest > 0 then
    for i := 0 to High(FOwnNames) do
      if FOwnNames[i] = Pr.ParentSym then
      begin
        for j := 0 to High(FOwnSyms[i]) do
        begin
          FSym[n] := FOwnSyms[i][j];
          FSym[n].Up := FOwnSyms[i][j].Up + pinUp;
          FSym[n].Reg := '';
          { a variable in its routine's box is reached at its field
            through the link, which is the box (1.0.134) }
          if FSym[n].Boxed then
          begin
            FSym[n].Off := FSym[n].BoxOff;
            FSym[n].ByRef := False;
            FSym[n].Boxed := False;
          end;
          Inc(n);
        end;
        Break;
      end;
  { the pinned cells: fields of the scope box, the closure's own link }
  for i := 0 to High(Pr.Pins) do
  begin
    FSym[n] := Default(TSym);
    FSym[n].Name := Pr.Pins[i];
    FSym[n].Off := 8 * LongInt(i);
    FSym[n].Global := False;
    FSym[n].Typ := TyPointer;
    for j := 0 to n - 1 do
      if SameSym(FSym[j].Name, Pr.Pins[i]) then
        FSym[n].Typ := FSym[j].Typ;
    FSym[n].Up := 1;
    FSym[n].ByRef := False;
    FSym[n].Reg := '';
    Inc(n);
  end;
  slot := 0;
  if Pr.Nest > 0 then
    slot := 8;
  if HasSelf(Pr) then
  begin
    slot := slot + 8;
    FSym[n].Name := 'self';
    FSym[n].Off := -LongInt(slot);
    FSym[n].Global := False;
    { a class method's Self is the class, its table (P123) }
    if Pr.SelfTyp <> 0 then
      FSym[n].Typ := Pr.SelfTyp
    else
      FSym[n].Typ := Pr.ClassTyp;
    FSym[n].Up := 0;
    FSym[n].ByRef := False;
    FSym[n].Reg := '';
    Inc(n);
  end;
  for i := 0 to nargs - 1 do
  begin
    FSym[n].Name := Pr.Params[i].Name;
    FSym[n].Global := False;
    FSym[n].Typ := Pr.Params[i].Typ;
    FSym[n].Up := 0;
    FSym[n].ByRef := Pr.Params[i].ByRef or IsFat(Pr.Params[i].Typ) or
      IsBlob(Pr.Params[i].Typ);
    FSym[n].Reg := '';
    if FArm then
      nlim := 8
    else
      nlim := 6;
    if i + Ord(HasSelf(Pr)) < nlim then
    begin
      slot := slot + 8;
      FSym[n].Off := -LongInt(slot);
    end
    else
      FSym[n].Off := 16 + (i + Ord(HasSelf(Pr)) - nlim) * 8;
    Inc(n);
  end;
  FHasRes := Pr.IsFunc;
  if Pr.IsFunc then
  begin
    sz := Align8(TSize(Pr.RetTyp));
    slot := slot + sz;
    FResName := Pr.Name;
    FResOff := -LongInt(slot);
    FResTyp := Pr.RetTyp;
    FSym[n].Name := 'result';
    FSym[n].Off := FResOff;
    FSym[n].Global := False;
    FSym[n].Typ := Pr.RetTyp;
    FSym[n].Up := 0;
    FSym[n].ByRef := False;
    FSym[n].Reg := '';
    Inc(n);
  end
  else
  begin
    FResName := '';
    FResOff := 0;
    FResTyp := TyNone;
  end;
  loc0 := slot;
  for i := 0 to High(Pr.Locals) do
  begin
    sz := Align8(SlotSize(Pr.Locals[i].Typ));
    slot := slot + sz;
    FSym[n].Name := Pr.Locals[i].Name;
    FSym[n].Off := -LongInt(slot);
    FSym[n].Global := False;
    FSym[n].Typ := Pr.Locals[i].Typ;
    FSym[n].Up := 0;
    FSym[n].ByRef := False;
    FSym[n].Reg := '';
    Inc(n);
  end;
  loc1 := slot;
  sysw := (Pr.Body <> nil) and (Pr.Body^.Kind = skBlock) and
    (Length(Pr.Body^.Stmts) = 1) and (Pr.Body^.Stmts[0] <> nil) and
    (Pr.Body^.Stmts[0]^.Kind = skAssign) and
    (Pr.Body^.Stmts[0]^.E <> nil) and
    (Pr.Body^.Stmts[0]^.E^.Kind = ekCall) and
    (Pr.Body^.Stmts[0]^.E^.Name = 'rt_syscall');
  FScratchCur := 0;
  FScratchMax := 0;
  FPinned := 0;
  FPromoOn := False;
  FPromo := nil;
  FStubs := '';
  FResReg := '';
  FCurProc := Pr.Sym;
  lst := nil;
  leaf := (not sysw) and LeafProc(Pr, lst);
  FAsyncOK := (not sysw) and (not HasAsm(Pr.Body)) and not FRtUnit;
  { the names whose address this routine or one nested in it takes }
  savedAddr := FAddrNames;
  FAddrNames := nil;
  ScanAddrS(Pr.Body);
  FNestNames := nil;
  FNameSink := 0;
  for i := 0 to High(FProgProcs) do
  begin
    ps := FProgProcs[i].ParentSym;
    k := 0;
    while (ps <> '') and (ps <> Pr.Sym) and (k < 16) do
    begin
      q := ps;
      ps := '';
      for j := 0 to High(FProgProcs) do
        if FProgProcs[j].Sym = q then
          ps := FProgProcs[j].ParentSym;
      Inc(k);
    end;
    if (ps = Pr.Sym) and (FProgProcs[i].Body <> nil) then
    begin
      ScanAddrS(FProgProcs[i].Body);
      NameScanS(FProgProcs[i].Body);
    end;
  end;
  FLocAddr := FAddrNames;
  FAddrNames := savedAddr;
  FScratchOff := -LongInt(slot);
  FFrameSym := '.Lfr' + Pr.Sym;
  if sysw then
  begin
    FFrame := (LongInt(slot) + 16 + 15) and (-16);
    if FFrame < 16 then
      FFrame := 16;
  end;
  FEpi := Lab;

  Line('');
  { A section of its own for every routine (1.1.1): the linker's
    --gc-sections keeps only the ones the program reaches, so the core
    units cost a program nothing where it does not use them. Its stack
    maps go to a section linked to it (MapEnd), its DWARF entry to the
    unit's ranges. }
  if FArm then
    Line('.section .text.' + Pr.Sym + ',"ax",%progbits')
  else
    Line('.section .text.' + Pr.Sym + ',"ax",@progbits');
  CpuNote(Pr.Sym, FCpuSet, FTune);
  { arm64: every routine on 32 bytes (P267; the runtime's in Line, and
    why not amd64 there) }
  if FArm then
    Line('  .p2align 5');
  FOwnSec := Pr.Sym;
  FDbgFn := Pr.Sym;
  FDbgLine := 0;
  if (Pr.Nest = 0) and (not Pr.IsExt) then
    Line('.globl ' + Pr.Sym);
  Line(Pr.Sym + ':');
  ck0 := FLen;
  ms0 := Length(FMapSites);
  FAsyncFrom := '';
  { a routine that calls nothing, every variable in a register and no
    frame (P296) }
  flat := (not sysw) and (not leaf) and FlatProc(Pr) and EmitFlat(Pr);
  if (not sysw) and (not leaf) and (not flat) then
    EmitStackCheck(Pr.Sym, FFrameSym);
  ck1 := FLen;
  if leaf then
    EmitLeaf(Pr, lst)
  else if flat then
  else if FArm then
  begin
    Line('  .cfi_startproc');
    Line('  stp x29, x30, [sp, #-16]!');
    Line('  .cfi_def_cfa_offset 16');
    Line('  .cfi_offset 29, -16');
    Line('  .cfi_offset 30, -8');
    Line('  mov x29, sp');
    Line('  .cfi_def_cfa_register 29');
    { a frame known now and up to 4095 bytes as SUB's immediate (P306);
      one known after the body by SetFrame's (P308) }
    if sysw and (FFrame > 0) and (FFrame <= 4095) then
      Line('  sub sp, sp, #' + IntToStr(FFrame))
    else if sysw then
    begin
      Imm('x16', FFrame);
      Line('  sub sp, sp, x16');
    end
    else
      FrameMarkArm;
    MapBegin;
    if Pr.Nest > 0 then
      StFP('x27', -8);
    if HasSelf(Pr) then
      StFP('x0', -8 * LongInt(1 + Ord(Pr.Nest > 0)));
    for i := 0 to nargs - 1 do
      if i + Ord(HasSelf(Pr)) < 8 then
        StFP(ArgR(LongInt(i + Ord(HasSelf(Pr)))),
          -8 * LongInt(i + 1 + Ord(Pr.Nest > 0) + Ord(HasSelf(Pr))));
    DaSetup(Pr, LongInt(loc0));
    if loc1 > loc0 then
      ZeroLocals(Pr, LongInt(loc0));
    { The slot is whole words, so a value of 3 bytes clears one: counted
      down by 8 from its size it never reached 0 and ran on (1.0.56). }
    { Result written first on every path starts as it is (P284) }
    if Pr.IsFunc and (not FDaResKeep) and IsBlob(Pr.RetTyp) then
      ZeroFrame(FResOff, Align8(TSize(Pr.RetTyp)))
    else if Pr.IsFunc and (not FDaResKeep) and IsFat(Pr.RetTyp) then
    begin
      StFP('xzr', FResOff);
      StFP('xzr', FResOff + 8);
      if IsDyn(Pr.RetTyp) then
        StFP('xzr', FResOff + 16);
    end
    else if Pr.IsFunc and not FDaResKeep then
      StFP('xzr', FResOff);
    BoxSetup(Pr);
    EmitStmt(Pr.Body);
    if FDaOn then
      FCurDa := DaBit('result');
    DropJumpTo(FEpi);
    Line(FEpi + ':');
    if Pr.IsCtor then
      LdFP('x0', -8 * LongInt(1 + Ord(Pr.Nest > 0)))
    else if Pr.IsFunc and IsBlob(Pr.RetTyp) then
    begin
      Imm('x0', TSize(Pr.RetTyp));
      GcArg(GcWord(Pr.RetTyp), 'x1');
      Line('  bl rt_alloc');
      Line('  mov x4, x0');
      AddFP('x1', FResOff);
      Line('  mov x0, x4');
      Imm('x2', TSize(Pr.RetTyp));
      Line('  bl rt_memcpy');
      Line('  mov x0, x4');
    end
    else if Pr.IsFunc and IsFat(Pr.RetTyp) then
    begin
      LdFP('x0', FResOff);
      LdFP('x2', FResOff + 8);
      if IsDyn(Pr.RetTyp) then
        LdFP('x3', FResOff + 16);
    end
    else if Pr.IsFunc and (TSize(Pr.RetTyp) < 8) then
    begin
      { A narrow Result at its width (P99). }
      AddFP('x16', FResOff);
      LoadTo('[x16]', Pr.RetTyp, 'x0');
    end
    else if Pr.IsFunc then
      LdFP('x0', FResOff);
    Line('  mov sp, x29');
    Line('  ldp x29, x30, [sp], #16');
    Line('  ret');
    ColdFlush(False);
    Line('  .cfi_endproc');
  end
  else
  begin
    Line('  .cfi_startproc');
    Line('  pushq %rbp');
    Line('  .cfi_def_cfa_offset 16');
    Line('  .cfi_offset %rbp, -16');
    Line('  movq %rsp, %rbp');
    Line('  .cfi_def_cfa_register %rbp');
    if sysw then
      Line('  subq $' + IntToStr(FFrame) + ', %rsp')
    else
      Line('  subq $' + FFrameSym + ', %rsp');
    MapBegin;
    if Pr.Nest > 0 then
      Line('  movq %r10, -8(%rbp)');
    if HasSelf(Pr) then
      Line('  movq %rdi, -8(%rbp)');
    for i := 0 to nargs - 1 do
      if i + Ord(HasSelf(Pr)) < 6 then
        Line('  movq %' + ArgReg(LongInt(i + Ord(HasSelf(Pr)))) + ', ' +
          IntToStr(-8 * LongInt(i + 1 + Ord(Pr.Nest > 0) + Ord(HasSelf(Pr)))) + '(%rbp)');
    { Locals start as zero, so a string, a slice, a map or a sync
      record is ready to use, as in Go. So does the whole of Result: a
      string, a slice or a record the routine never assigns comes back
      empty, not with the length a previous frame left in the second
      word (only the first word was cleared on amd64, P94). }
    DaSetup(Pr, LongInt(loc0));
    if loc1 > loc0 then
      ZeroLocals(Pr, LongInt(loc0));
    if Pr.IsFunc and not FDaResKeep then
      ZeroFrame(FResOff, Align8(TSize(Pr.RetTyp)));
    BoxSetup(Pr);
    EmitStmt(Pr.Body);
    if FDaOn then
      FCurDa := DaBit('result');
    DropJumpTo(FEpi);
    Line(FEpi + ':');
    if Pr.IsCtor then
      Line('  movq -8(%rbp), %rax')
    else if Pr.IsFunc and IsBlob(Pr.RetTyp) then
    begin
      Line('  movq $' + IntToStr(TSize(Pr.RetTyp)) + ', %rdi');
      GcArg(GcWord(Pr.RetTyp), 'rsi');
      Line('  call rt_alloc');
      Line('  movq %rax, %rdi');
      Line('  leaq ' + IntToStr(FResOff) + '(%rbp), %rsi');
      Line('  movq $' + IntToStr(TSize(Pr.RetTyp)) + ', %rcx');
      PushK('rax', 1);
      Line('  call rt_memcpy');
      Line('  popq %rax');
    end
    else if Pr.IsFunc and IsFat(Pr.RetTyp) then
    begin
      Line('  movq ' + IntToStr(FResOff) + '(%rbp), %rax');
      Line('  movq ' + IntToStr(FResOff + 8) + '(%rbp), %rdx');
      if IsDyn(Pr.RetTyp) then
        Line('  movq ' + IntToStr(FResOff + 16) + '(%rbp), %r8');
    end
    else if Pr.IsFunc then
      LoadTo(IntToStr(FResOff) + '(%rbp)', Pr.RetTyp, 'rax');
    Line('  leave');
    Line('  .cfi_def_cfa %rsp, 8');
    Line('  ret');
    ColdFlush(True);
    Line('  .cfi_endproc');
  end;
  if FCold <> '' then
    Die('internal error: a check''s failure left out of ' + Pr.Sym);
  { A body that calls nothing, its one call site the check's, has no
    loop either (every loop's test calls rt_morestack): it runs to its
    end in a few instructions and keeps no more than its frame below its
    caller's, whose check left the red zone there; a frame of up to 256
    bytes needs no check of its own (P342: 1 KB while the red zone was
    2 KB), as Go makes a leaf under StackSmall NOSPLIT
    (cmd/internal/obj/x86/obj6.go, preprocess). The check's text goes,
    and its site. Not an asm statement's body, whose text may call. }
  if (not sysw) and (not leaf) and (not flat) and (Length(FMapSites) = ms0 + 1) and
    (FMapSites[ms0].Kind = 1) and
    (((LongInt(slot) + FScratchMax + 15) and (-16)) <= 256) and
    not HasAsm(Pr.Body) then
  begin
    Move(FOut[ck1 + 1], FOut[ck0 + 1], FLen - ck1);
    FLen := FLen - (ck1 - ck0);
    SetLength(FMapSites, ms0);
    FAsyncFrom := '';
  end;

  if not sysw then
    SetFrame(FFrameSym, LongInt(slot))
  else
    MapEnd(FFrame);
  if FArm and not HasAsm(Pr.Body) then
  begin
    TbzPass(ck0);
    AdrpPass(ck0);
  end;
  dend := Lab;
  Line(dend + ':');
  { the routine's code for rt_sigurg (P293): a signal may stop it at any
    instruction after its stack check (FAsyncFrom), the collector reading
    the frame it stopped in word by word; not a body with asm, whose text
    the collector cannot know }
  if FAsyncOK then
  begin
    if FAsyncFrom = '' then
      FAsyncFrom := Pr.Sym;
    if FArm then
      MapOutLine('.section pasasync.' + Pr.Sym + ',"awo",%progbits,' + Pr.Sym)
    else
      MapOutLine('.section pasasync.' + Pr.Sym + ',"awo",@progbits,' + Pr.Sym);
    MapOutLine('.balign 8');
    MapOutLine('  .quad ' + FAsyncFrom + ', ' + dend);
    { back to the maps' own section: the main block's and a unit's life
      blocks write their call sites without naming one }
    MapOutLine('.section pasgcmaps,"aw"');
  end;
  FAsyncOK := False;
  Line('.text');
  FOwnSec := '';
  FDbgFn := '';
  own := Length(FOwnNames);
  SetLength(FOwnNames, own + 1);
  SetLength(FOwnEnds, own + 1);
  SetLength(FOwnLine, own + 1);
  FOwnLine[own] := FDbgLine;
  SetLength(FOwnPas, own + 1);
  SetLength(FOwnSyms, own + 1);
  FOwnNames[own] := Pr.Sym;
  FOwnEnds[own] := dend;
  if Pr.Name <> '' then
    FOwnPas[own] := Pr.Name
  else
    FOwnPas[own] := Pr.Sym;
  FOwnSyms[own] := nil;
  { every name the routine sees but the globals, its parent's too: a
    routine nested two deep reaches its grandparent's variables through
    two links (1.0.134; it said unknown identifier) }
  for i := 0 to High(FSym) do
    if not FSym[i].Global then
    begin
      n := Length(FOwnSyms[own]);
      SetLength(FOwnSyms[own], n + 1);
      FOwnSyms[own][n] := FSym[i];
    end;

  FBoxSlot := 0;
  FSym := saved;
  FResName := savedResName;
  FResOff := savedResOff;
  FHasRes := savedHas;
  FResTyp := savedResTyp;
  FTryFin := savedTF;
  FTryDep := savedTD;
  FTryRec := savedTR;
  FLocAddr := nil;
  FSelBody := savedSel;
  FLoadDone := savedLoadDone;
  FLoadAddr := savedLoadAddr;
  FDaOn := False;
  FDaResKeep := False;
  FCurDa := 0;
end;

function TEmitter.IsDwarfInt(const S: TSym): Boolean;
var
  nm: string;
begin
  Result := False;
  if S.ByRef or S.Global or (S.Up <> 0) then
    Exit;
  if not (IsIntId(S.Typ) or (S.Typ = TyReal) or (S.Typ = TySingle) or
    (S.Typ = TyQuad) or (S.Typ = TyCurrency)) then
    Exit;
  nm := ToLower(S.Name);
  { A for loop's hidden limit (1.0.93) is not the program's. }
  if (nm = '') or (nm = 'result') or (nm = 'self') or
    (Copy(nm, 1, 7) = 'for.lim') or (Copy(nm, 1, 7) = 'bit.tmp') then
    Exit;
  Result := True;
end;

{ One DW_TAG_base_type, labelled by the type's id (1.0.92). }
procedure TEmitter.DwarfBase(T: LongInt; const N: string; Enc, Size: LongInt);
begin
  Line('.Ldt' + IntToStr(T) + ':');
  Line('  .uleb128 5');
  Line('  .asciz "' + N + '"');
  Line('  .byte ' + IntToStr(Enc));
  Line('  .byte ' + IntToStr(Size));
end;

procedure TEmitter.EmitDwarfLocals;
var
  p, v, r, nl: SizeInt;
  a, b, src, cur: string;
  any, has: Boolean;
  locs: array of string;
begin
  locs := nil;
  { Integer locals and spilled parameters. The abbrev offset is a
    label in this contribution, so a linked unit does not reuse offset 0.
    This replaces the assembler's childless compile unit. .debug_line stays. }
  any := False;
  for p := 0 to High(FOwnNames) do
    for v := 0 to High(FOwnSyms[p]) do
      if IsDwarfInt(FOwnSyms[p][v]) then
        any := True;
  if not any then
    Exit;
  Line('');
  a := Lab;
  Line('.section .debug_abbrev,"",@progbits');
  Line(a + ':');
  { 1: the compile unit, with its line table (DW_AT_stmt_list, as GCC
    writes it: a label at the start of this object's .debug_line, which
    the assembler fills from the .loc lines) and its code range. Without
    the line table gdb knew no line of a program with integer locals. }
  Line('  .uleb128 1');
  Line('  .uleb128 17');
  Line('  .byte 1');
  Line('  .uleb128 3');
  Line('  .uleb128 8');
  Line('  .uleb128 16');
  Line('  .uleb128 23');
  { DW_AT_low_pc 0 and DW_AT_ranges (0x55, sec_offset): the code is one
    section per routine and the plain text (1.1.1) }
  Line('  .uleb128 17');
  Line('  .uleb128 1');
  Line('  .uleb128 85');
  Line('  .uleb128 23');
  Line('  .byte 0');
  Line('  .byte 0');
  Line('  .uleb128 2');
  Line('  .uleb128 46');
  Line('  .byte 1');
  Line('  .uleb128 3');
  Line('  .uleb128 8');
  Line('  .uleb128 17');
  Line('  .uleb128 1');
  Line('  .uleb128 18');
  Line('  .uleb128 1');
  Line('  .uleb128 64');
  Line('  .uleb128 24');
  Line('  .byte 0');
  Line('  .byte 0');
  { 3: a local in the frame; its type (DW_AT_type, ref4) names one of
    the base types below, so a debugger reads a Byte as one byte and an
    Int8 with its sign (P99, 1.0.92). }
  Line('  .uleb128 3');
  Line('  .uleb128 52');
  Line('  .byte 0');
  Line('  .uleb128 3');
  Line('  .uleb128 8');
  Line('  .uleb128 73');
  Line('  .uleb128 19');
  Line('  .uleb128 2');
  Line('  .uleb128 24');
  Line('  .byte 0');
  Line('  .byte 0');
  { 4: a local that a loop keeps in a register for a while (P93): its
    location is a list in .debug_loc (DW_FORM_sec_offset). }
  Line('  .uleb128 4');
  Line('  .uleb128 52');
  Line('  .byte 0');
  Line('  .uleb128 3');
  Line('  .uleb128 8');
  Line('  .uleb128 73');
  Line('  .uleb128 19');
  Line('  .uleb128 2');
  Line('  .uleb128 23');
  Line('  .byte 0');
  Line('  .byte 0');
  { 5: a base type: name, encoding (5 signed, 8 unsigned), byte size. }
  Line('  .uleb128 5');
  Line('  .uleb128 36');
  Line('  .byte 0');
  Line('  .uleb128 3');
  Line('  .uleb128 8');
  Line('  .uleb128 62');
  Line('  .uleb128 11');
  Line('  .uleb128 11');
  Line('  .uleb128 11');
  Line('  .byte 0');
  Line('  .byte 0');
  { DWARF 5 sections 5.1.1.3/5.1.1.5: a signed scaled integer,
    decimal_scale -4 and digit_count 19; also valid in DWARF 4. }
  Line('  .uleb128 6');
  Line('  .uleb128 36');
  Line('  .byte 0');
  Line('  .uleb128 3');
  Line('  .uleb128 8');
  Line('  .uleb128 62');
  Line('  .uleb128 11');
  Line('  .uleb128 11');
  Line('  .uleb128 11');
  Line('  .uleb128 92');
  Line('  .uleb128 13');
  Line('  .uleb128 95');
  Line('  .uleb128 11');
  Line('  .byte 0');
  Line('  .byte 0');
  Line('  .byte 0');
  Line('.section .debug_info,"",@progbits');
  Line('.Ldi_hdr:');
  Line('  .long .Ldi_end-.Ldi_cu');
  Line('.Ldi_cu:');
  Line('  .short 4');
  Line('  .long ' + a);
  Line('  .byte 8');
  Line('  .uleb128 1');
  if FSrc <> '' then
    src := FSrc
  else
    src := 'paslang';
  Line('  .asciz "' + GasEscape(src) + '"');
  Line('  .long .Ldebug_line0');
  Line('  .quad 0');
  Line('  .long .Ldebug_ranges0');
  DwarfBase(TyInteger, 'Integer', 5, 8);
  DwarfBase(TyByte, 'Byte', 8, 1);
  DwarfBase(TyInt8, 'Int8', 5, 1);
  DwarfBase(TyWord, 'Word', 8, 2);
  DwarfBase(TyInt16, 'Int16', 5, 2);
  DwarfBase(TyUInt32, 'UInt32', 8, 4);
  DwarfBase(TyInt32, 'Int32', 5, 4);
  { DW_ATE_float: a Double in 8 bytes, a Single in 4 (P101). }
  DwarfBase(TyReal, 'Double', 4, 8);
  DwarfBase(TySingle, 'Single', 4, 4);
  { A Quad is binary128 in 16 bytes; gdb reads a 16-byte float named
    _Float128 as IEEE quad on amd64 too, where its 16-byte long double is
    x87's (1.0.115). }
  DwarfBase(TyQuad, '_Float128', 4, 16);
  Line('.Ldt' + IntToStr(TyCurrency) + ':');
  Line('  .uleb128 6');
  Line('  .asciz "Currency"');
  Line('  .byte 13');
  Line('  .byte 8');
  Line('  .sleb128 -4');
  Line('  .byte 19');
  for p := 0 to High(FOwnNames) do
  begin
    any := False;
    for v := 0 to High(FOwnSyms[p]) do
      if IsDwarfInt(FOwnSyms[p][v]) then
        any := True;
    if not any then
      Continue;
    Line('  .uleb128 2');
    Line('  .asciz "' + GasEscape(FOwnPas[p]) + '"');
    Line('  .quad ' + FOwnNames[p]);
    Line('  .quad ' + FOwnEnds[p]);
    a := Lab;
    b := Lab;
    Line('  .uleb128 ' + b + '-' + a);
    Line(a + ':');
    if FArm then
      Line('  .byte 0x6d')
    else
      Line('  .byte 0x56');
    Line(b + ':');
    for v := 0 to High(FOwnSyms[p]) do
      if IsDwarfInt(FOwnSyms[p][v]) then
      begin
        has := False;
        for r := 0 to High(FLocRanges) do
          if (FLocRanges[r].Proc = FOwnNames[p]) and
            (FLocRanges[r].Off = FOwnSyms[p][v].Off) then
            has := True;
        if has then
        begin
          { In the frame, except where a loop keeps it in a register. }
          a := Lab;
          Line('  .uleb128 4');
          Line('  .asciz "' + GasEscape(FOwnSyms[p][v].Name) + '"');
          Line('  .long .Ldt' + IntToStr(FOwnSyms[p][v].Typ) + '-.Ldi_hdr');
          Line('  .long ' + a);
          nl := Length(locs);
          SetLength(locs, nl + 3);
          locs[nl] := a + ':';
          locs[nl + 1] := '  .quad -1';
          locs[nl + 2] := '  .quad 0';
          cur := FOwnNames[p];
          for r := 0 to High(FLocRanges) do
            if (FLocRanges[r].Proc = FOwnNames[p]) and
              (FLocRanges[r].Off = FOwnSyms[p][v].Off) then
            begin
              a := Lab;
              b := Lab;
              nl := Length(locs);
              SetLength(locs, nl + 12);
              locs[nl] := '  .quad ' + cur;
              locs[nl + 1] := '  .quad ' + FLocRanges[r].B;
              locs[nl + 2] := '  .short ' + b + '-' + a;
              locs[nl + 3] := a + ':';
              locs[nl + 4] := '  .byte 0x91';
              locs[nl + 5] := '  .sleb128 ' + IntToStr(FOwnSyms[p][v].Off);
              locs[nl + 6] := b + ':';
              locs[nl + 7] := '  .quad ' + FLocRanges[r].B;
              locs[nl + 8] := '  .quad ' + FLocRanges[r].E;
              locs[nl + 9] := '  .short 1';
              locs[nl + 10] := '  .byte ' + IntToStr($50 + FLocRanges[r].Dw);
              locs[nl + 11] := '';
              cur := FLocRanges[r].E;
            end;
          a := Lab;
          b := Lab;
          nl := Length(locs);
          SetLength(locs, nl + 9);
          locs[nl] := '  .quad ' + cur;
          locs[nl + 1] := '  .quad ' + FOwnEnds[p];
          locs[nl + 2] := '  .short ' + b + '-' + a;
          locs[nl + 3] := a + ':';
          locs[nl + 4] := '  .byte 0x91';
          locs[nl + 5] := '  .sleb128 ' + IntToStr(FOwnSyms[p][v].Off);
          locs[nl + 6] := b + ':';
          locs[nl + 7] := '  .quad 0';
          locs[nl + 8] := '  .quad 0';
        end
        else
        begin
          Line('  .uleb128 3');
          Line('  .asciz "' + GasEscape(FOwnSyms[p][v].Name) + '"');
          Line('  .long .Ldt' + IntToStr(FOwnSyms[p][v].Typ) + '-.Ldi_hdr');
          a := Lab;
          b := Lab;
          Line('  .uleb128 ' + b + '-' + a);
          Line(a + ':');
          Line('  .byte 0x91');
          Line('  .sleb128 ' + IntToStr(FOwnSyms[p][v].Off));
          Line(b + ':');
        end;
      end;
    Line('  .byte 0');
  end;
  Line('  .byte 0');
  Line('.Ldi_end:');
  { the ranges: every routine's section, then the plain text }
  if FArm then
    Line('.section .debug_ranges,"",%progbits')
  else
    Line('.section .debug_ranges,"",@progbits');
  Line('.Ldebug_ranges0:');
  for p := 0 to High(FOwnNames) do
  begin
    Line('  .quad ' + FOwnNames[p]);
    Line('  .quad ' + FOwnEnds[p]);
  end;
  Line('  .quad .Ltext0');
  Line('  .quad .Lcodeend');
  Line('  .quad 0');
  Line('  .quad 0');
  Line('.section .debug_line,"",@progbits');
  Line('.Ldebug_line0:');
  if Length(locs) > 0 then
  begin
    Line('.section .debug_loc,"",@progbits');
    for r := 0 to High(locs) do
      if locs[r] <> '' then
        Line(locs[r]);
  end;
end;

procedure TEmitter.EmitScheduler;
begin
  { M: 128 bytes. 0 id, 8 p, 16 curg, 32 syssp.
    P: 2176 bytes. 0 id, 8 m, 16 head u32, 20 tail u32, 24 runnext, 40 runq[256],
    2088 gfree head, 2096 gfree count, 2104 slab next, 2112 slab end (P98),
    2120 alloc next, 2128 alloc end (P94), 2136 mcache, and its timers
    (P352): 2144 their heap, 2152 how many, 2160 their lock, 2168 the
    earliest wake time, all ones with none.
    G: 0 lo, 8 hi, 16/24 guard, 32 m, 40 sp, 48 pc, 56 bp, 64 link, 128 fn, 136/144 args. }
  Line('.globl rt_pas');
  Line('rt_ncpu:');
  Line('  subq $40, %rsp');
  Line('  xorq %rdi, %rdi');
  Line('  movq $32, %rsi');
  Line('  leaq (%rsp), %rdx');
  Line('  movq $204, %rax');
  Line('  syscall');
  Line('  movq $1, %rax');
  Line('  js .nc_done');
  Line('  movq (%rsp), %rdx');
  Line('  xorq %rax, %rax');
  Line('.nc_bits:');
  Line('  testq %rdx, %rdx');
  Line('  jz .nc_clip');
  Line('  movq %rdx, %rcx');
  Line('  andq $1, %rcx');
  Line('  addq %rcx, %rax');
  Line('  shrq $1, %rdx');
  Line('  jmp .nc_bits');
  Line('.nc_clip:');
  Line('  cmpq $2, %rax');
  Line('  jae .nc_max');
  Line('  movq $2, %rax');
  Line('.nc_max:');
  Line('  cmpq $32, %rax');
  Line('  jbe .nc_done');
  Line('  movq $32, %rax');
  Line('.nc_done:');
  Line('  addq $40, %rsp');
  Line('  ret');
  Line('');
  { rt_glocksite keeps the return address of whoever holds the global
    lock, so a hang can be read from a core or a stopped process. }
  { The runtime lock is Go's lock_futex (lock2/unlock2): 0 free, 1
    held, 2 held with sleepers. A waiter tries four rounds of thirty
    pauses and one sched_yield, reading the word and trying a CAS only
    when it is free, and then sleeps on the word with futex; unlock
    swaps in 0 and wakes one sleeper when it took a 2 out. Spinning
    without end, thirty Ms took the line from the holder that had to
    release it: 155 of 264 samples of b3spawn waited on the mutex queue's
    lock (P98). The first xchg may overwrite a 2 with a 1, so a waiter
    that saw 2 puts 2 back when it takes the lock, as Go's does. Only rax
    changes; rdi stays the lock. }
  Line('rt_lock:');
  Line('  movl $1, %eax');
  Line('  xchgl %eax, (%rdi)');
  Line('  testl %eax, %eax');
  Line('  jz .lk_ok');
  Line('  pushq %rcx');
  Line('  pushq %rdx');
  Line('  pushq %rsi');
  Line('  pushq %r10');
  Line('  pushq %r11');
  Line('  pushq %r8');
  Line('  movl %eax, %r8d');
  Line('.lk_round:');
  Line('  movl $4, %ecx');
  Line('.lk_act:');
  Line('  cmpl $0, (%rdi)');
  Line('  jne .lk_proc');
  Line('  xorl %eax, %eax');
  Line('  lock cmpxchgl %r8d, (%rdi)');
  Line('  jz .lk_got');
  Line('  jmp .lk_act');
  Line('.lk_proc:');
  Line('  movl $30, %esi');
  Line('.lk_p:');
  Line('  pause');
  Line('  decl %esi');
  Line('  jnz .lk_p');
  Line('  decl %ecx');
  Line('  jnz .lk_act');
  Line('.lk_pas:');
  Line('  cmpl $0, (%rdi)');
  Line('  jne .lk_osy');
  Line('  xorl %eax, %eax');
  Line('  lock cmpxchgl %r8d, (%rdi)');
  Line('  jz .lk_got');
  Line('  jmp .lk_pas');
  Line('.lk_osy:');
  Line('  movq $24, %rax');
  Line('  syscall');
  Line('  movl $2, %eax');
  Line('  xchgl %eax, (%rdi)');
  Line('  testl %eax, %eax');
  Line('  jz .lk_got');
  Line('  movl $2, %r8d');
  Line('  movq $128, %rsi');
  Line('  movq $2, %rdx');
  Line('  xorq %r10, %r10');
  Line('  movq $202, %rax');
  Line('  syscall');
  Line('  jmp .lk_round');
  Line('.lk_got:');
  Line('  popq %r8');
  Line('  popq %r11');
  Line('  popq %r10');
  Line('  popq %rsi');
  Line('  popq %rdx');
  Line('  popq %rcx');
  { A routine holding a runtime lock is not preempted (Go's m.locks):
    G+184 counts its locks and rt_morestack does not yield while it is
    not zero. Preempted inside SpinLock ... SpinUnlock, the holder went
    to the global queue while every M slept on its lock (P98). }
  Line('.lk_ok:');
  Line('  testq %r14, %r14');
  Line('  jz .lk_nog');
  Line('  incl 184(%r14)');
  Line('.lk_nog:');
  Line('  leaq rt_glock(%rip), %rax');
  Line('  cmpq %rax, %rdi');
  Line('  jne .lk_ret');
  Line('  movq (%rsp), %rax');
  Line('  movq %rax, rt_glocksite(%rip)');
  Line('  movq $1, %rax');
  Line('  call rt_glocklog');
  Line('.lk_ret:');
  Line('  ret');
  { The last lock let go re-arms a preemption that came meanwhile
    (G+188), as Go's unlock2 does with gp.preempt. }
  Line('rt_unlock:');
  Line('  testq %r14, %r14');
  Line('  jz .ul_nog');
  Line('  cmpl $0, 184(%r14)');
  Line('  je .ul_nog');
  Line('  decl 184(%r14)');
  Line('  jnz .ul_nog');
  Line('  cmpl $0, 188(%r14)');
  Line('  je .ul_nog');
  Line('  movl $0, 188(%r14)');
  Line('  movabs $0xfffffffffffffade, %rax');
  Line('  movq %rax, 16(%r14)');
  Line('.ul_nog:');
  Line('  leaq rt_glock(%rip), %rax');
  Line('  cmpq %rax, %rdi');
  Line('  jne .ul_do');
  Line('  cmpl $0, (%rdi)');
  Line('  je rt_glockbad');
  Line('  movq $0, rt_glocksite(%rip)');
  Line('  movq $2, %rax');
  Line('  call rt_glocklog');
  Line('.ul_do:');
  Line('  xorl %eax, %eax');
  Line('  xchgl %eax, (%rdi)');
  Line('  cmpl $2, %eax');
  Line('  je .ul_wake');
  Line('  ret');
  Line('.ul_wake:');
  Line('  pushq %rcx');
  Line('  pushq %rdx');
  Line('  pushq %rsi');
  Line('  pushq %r11');
  Line('  movq $129, %rsi');
  Line('  movq $1, %rdx');
  Line('  movq $202, %rax');
  Line('  syscall');
  Line('  popq %r11');
  Line('  popq %rsi');
  Line('  popq %rdx');
  Line('  popq %rcx');
  Line('  ret');
  { Diagnostic ring of the last 64 global-lock operations: op (1 lock,
    2 unlock), the caller of rt_lock/rt_unlock, the G and the M. Read it
    from a frozen process with gdb. rt_glockbad: unlock of a free lock. }
  Line('rt_glocklog:');
  Line('  pushq %rcx');
  Line('  pushq %rdx');
  { Only the holder of rt_glock writes the ring (after the xchg, before
    the release), so the sequence moves with plain loads and stores. }
  Line('  movq rt_glockseq(%rip), %rcx');
  Line('  leaq 1(%rcx), %rdx');
  Line('  movq %rdx, rt_glockseq(%rip)');
  Line('  andq $63, %rcx');
  Line('  shlq $5, %rcx');
  Line('  leaq rt_glockring(%rip), %rdx');
  Line('  addq %rcx, %rdx');
  Line('  movq %rax, (%rdx)');
  Line('  movq 24(%rsp), %rax');
  Line('  movq %rax, 8(%rdx)');
  Line('  movq %r14, 16(%rdx)');
  Line('  movq %r13, 24(%rdx)');
  Line('  popq %rdx');
  Line('  popq %rcx');
  Line('  ret');
  Line('rt_glockbad:');
  Line('  leaq .Lglockbad(%rip), %rsi');
  Line('  movq $29, %rdx');
  Line('  call rt_rawwrite');
  Line('  movq $111, %rdi');
  Line('  jmp rt_exit');
  Line('');
  Line('rt_globput:');
  Line('  pushq %rdi');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  popq %rdi');
  Line('  movq $0, 64(%rdi)');
  Line('  movq rt_gtail(%rip), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .gp_first');
  Line('  movq %rdi, 64(%rax)');
  Line('  jmp .gp_tail');
  Line('.gp_first:');
  Line('  movq %rdi, rt_ghead(%rip)');
  Line('.gp_tail:');
  Line('  movq %rdi, rt_gtail(%rip)');
  Line('  incq rt_gqn(%rip)');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  ret');
  Line('');
  Line('rt_globget:');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  movq rt_ghead(%rip), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .gg_out');
  Line('  movq 64(%rax), %rcx');
  Line('  movq %rcx, rt_ghead(%rip)');
  Line('  testq %rcx, %rcx');
  Line('  jnz .gg_dec');
  Line('  movq $0, rt_gtail(%rip)');
  Line('.gg_dec:');
  Line('  decq rt_gqn(%rip)');
  Line('.gg_out:');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  movq %rax, %r8');
  Line('  call rt_unlock');
  Line('  movq %r8, %rax');
  Line('  ret');
  Line('');
  Line('rt_runqput:');
  Line('  movq %rsi, %rax');
  Line('  xchgq %rax, 24(%rdi)');
  Line('  testq %rax, %rax');
  Line('  jz .qp_done');
  Line('  movq %rax, %rsi');
  { rt_runqputtail: rdi P, rsi G, to the tail and never to runnext. }
  Line('rt_runqputtail:');
  Line('.qp_q:');
  Line('  movl 16(%rdi), %eax');
  Line('  movl 20(%rdi), %ecx');
  Line('  movl %ecx, %edx');
  Line('  subl %eax, %edx');
  Line('  cmpl $256, %edx');
  Line('  jae .qp_slow');
  Line('  movl %ecx, %edx');
  Line('  andl $255, %edx');
  Line('  movq %rsi, 40(%rdi, %rdx, 8)');
  Line('  incl %ecx');
  Line('  movl %ecx, 20(%rdi)');
  Line('.qp_done:');
  Line('  ret');
  Line('.qp_slow:');
  Line('  jmp rt_runqputslow');
  Line('');
  { The local queue is full: move half of it and the new routine to the
    global list under one lock, Go's runqputslow. The head moves with a
    CAS against the stealers; the tail is ours. The batch is chained
    through G+64 first, so the lock is held for a few stores (P98). }
  Line('rt_runqputslow:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  movq %rdi, %rbx');
  Line('  movq %rsi, %r12');
  Line('.qps_retry:');
  Line('  movl 16(%rbx), %eax');
  Line('  movl 20(%rbx), %ecx');
  Line('  movl %ecx, %edx');
  Line('  subl %eax, %edx');
  Line('  cmpl $256, %edx');
  Line('  jb .qps_notfull');
  Line('  shrl $1, %edx');
  Line('  movl %eax, %r8d');
  Line('  addl %edx, %r8d');
  Line('  lock cmpxchgl %r8d, 16(%rbx)');
  Line('  jne .qps_retry');
  Line('  movl %eax, %r9d');
  Line('  xorl %r10d, %r10d');
  Line('.qps_link:');
  Line('  movl %r9d, %eax');
  Line('  addl %r10d, %eax');
  Line('  andl $255, %eax');
  Line('  movq 40(%rbx,%rax,8), %rcx');
  Line('  leal 1(%r10d), %eax');
  Line('  cmpl %edx, %eax');
  Line('  je .qps_last');
  Line('  addl %r9d, %eax');
  Line('  andl $255, %eax');
  Line('  movq 40(%rbx,%rax,8), %r8');
  Line('  movq %r8, 64(%rcx)');
  Line('  incl %r10d');
  Line('  jmp .qps_link');
  Line('.qps_last:');
  Line('  movq %r12, 64(%rcx)');
  Line('  movl %r9d, %eax');
  Line('  andl $255, %eax');
  Line('  movq 40(%rbx,%rax,8), %r8');
  Line('  pushq %r8');
  Line('  pushq %rdx');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  popq %rdx');
  Line('  popq %r8');
  Line('  movq $0, 64(%r12)');
  Line('  movq rt_gtail(%rip), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .qps_gfirst');
  Line('  movq %r8, 64(%rax)');
  Line('  jmp .qps_gtail');
  Line('.qps_gfirst:');
  Line('  movq %r8, rt_ghead(%rip)');
  Line('.qps_gtail:');
  Line('  movq %r12, rt_gtail(%rip)');
  Line('  movl %edx, %eax');
  Line('  incq %rax');
  Line('  addq %rax, rt_gqn(%rip)');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('.qps_notfull:');
  Line('  movq %rbx, %rdi');
  Line('  movq %r12, %rsi');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  jmp rt_runqput');
  Line('');
  { A batch from the global list into this P's empty local queue: n =
    length / nproc + 1, at most 128, Go's globrunqget. The first is
    returned to run, the rest are stored at the tail (ours) (P98). }
  Line('rt_globgetbatch:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  movq %rdi, %rbx');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  movq rt_gqn(%rip), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .gb_empty');
  Line('  xorq %rdx, %rdx');
  Line('  divq rt_nproc(%rip)');
  Line('  incq %rax');
  Line('  cmpq $128, %rax');
  Line('  jbe .gb_n');
  Line('  movq $128, %rax');
  Line('.gb_n:');
  Line('  cmpq rt_gqn(%rip), %rax');
  Line('  jbe .gb_n2');
  Line('  movq rt_gqn(%rip), %rax');
  Line('.gb_n2:');
  Line('  subq %rax, rt_gqn(%rip)');
  Line('  movq rt_ghead(%rip), %r8');
  Line('  movq %r8, %rcx');
  Line('  movq %rax, %rdx');
  Line('.gb_walk:');
  Line('  decq %rdx');
  Line('  jz .gb_walked');
  Line('  movq 64(%rcx), %rcx');
  Line('  jmp .gb_walk');
  Line('.gb_walked:');
  Line('  movq 64(%rcx), %rax');
  Line('  movq %rax, rt_ghead(%rip)');
  Line('  testq %rax, %rax');
  Line('  jnz .gb_more');
  Line('  movq $0, rt_gtail(%rip)');
  Line('.gb_more:');
  Line('  movq $0, 64(%rcx)');
  Line('  movq %r8, %r12');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  movq 64(%r12), %rcx');
  Line('.gb_put:');
  Line('  testq %rcx, %rcx');
  Line('  jz .gb_done');
  Line('  movl 20(%rbx), %eax');
  Line('  movl %eax, %edx');
  Line('  andl $255, %edx');
  Line('  movq %rcx, 40(%rbx,%rdx,8)');
  Line('  incl %eax');
  Line('  movl %eax, 20(%rbx)');
  Line('  movq 64(%rcx), %rcx');
  Line('  jmp .gb_put');
  Line('.gb_done:');
  Line('  movq %r12, %rax');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gb_empty:');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  xorq %rax, %rax');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('rt_runqget:');
  Line('  xorq %rax, %rax');
  Line('  xchgq %rax, 24(%rdi)');
  Line('  testq %rax, %rax');
  Line('  jnz .qg_done');
  Line('.qg_retry:');
  Line('  movl 16(%rdi), %r9d');
  Line('  movl 20(%rdi), %ecx');
  Line('  cmpl %r9d, %ecx');
  Line('  je .qg_empty');
  Line('  movl %r9d, %edx');
  Line('  andl $255, %edx');
