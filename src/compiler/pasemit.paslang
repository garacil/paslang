  Line('  ldr x13, [x0, #16]');
  Line('  ldr x2, [x0, #8]');
  Line('  ldr x9, [x19, #48]');
  Line('  ldr x10, [x19, #64]');
  Line('  ldr x11, [x19, #72]');
  Line('  add x11, x11, x10');
  Line('  ldr x12, [x19, #56]');
  Line('  cmp x11, x12');
