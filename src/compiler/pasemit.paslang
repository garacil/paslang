  Line('  str x13, [x9, x11, lsl #3]');
  Line('  add x10, x10, #1');
  Line('  str x10, [x19, #64]');
  Line('.acbg_done:');
  Line('  mov x0, x20');
  Line('  mov x1, #1');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.acbg_none:');
  Line('  mov x1, xzr');
  Line('  ret');
  { Channels, the same design as amd64: chan 0 lock, 8 closed, 16/24
    recvq, 32/40 sendq; a 48-byte waiter on the waiting G's stack (0 next,
    8 G, 16 elem, 24 select control block or 0, 32 arm); a 16-byte select
    control block (0 state, 8 winning waiter). rt_cqtake claims a select
    waiter with one CAS. Locks are ldaxr/stxr to take and stlr to drop.
    x21 is the M and is never touched; x19, x20, x22, x23, x24 hold the
    state across the park. }
