    procedure BoundsFailArm(const Idx: string; IdxK, Lo: Int64; const Hi: string; HiK: Int64; HiAdj: LongInt);
    procedure EmitClassRel(E: PExpr);
    procedure EmitInitCalls(const Prog: TProgram);
    procedure EmitUnitLife(const Prog: TProgram);
    function IsDwarfInt(const S: TSym): Boolean;
    procedure EmitDwarfLocals;
    function LeafWord(T: LongInt): Boolean;
    function LeafE(E: PExpr; const Par: TStrArray): Boolean;
    function LeafProc(const Pr: TProc; out St: PStmt): Boolean;
    procedure LeafReg(const N, R: string; Dw: LongInt; const Proc, EndLab: string);
    procedure EmitLeaf(const Pr: TProc; St: PStmt);
    function FlatProc(const Pr: TProc): Boolean;
    function NamesReg(const T, R: string): Boolean;
    function RegNamed(const T, R: string): Boolean;
    function RegTaken(const L: TStrArray; const R: string): Boolean;
    function ArrivesIn(const L: TStrArray; const R: string): Boolean;
    function SavedReg(const R: string): Boolean;
    function RenameReg(const T, R, M: string): string;
    function RenameRegTo(const T, M, R: string): string;
    function NormLabels(const T: string): string;
    function EmitFlat(const Pr: TProc): Boolean;
    function HasAsm(S: PStmt): Boolean;
    procedure MainAsync;
    procedure NoteName(const N: string);
    function RoutNamed(const N: string): Boolean;
    procedure NameScanE(E: PExpr);
    procedure NameScanS(S: PStmt);
    function GlobalOwnedByMain(const N: string): Boolean;
    function CmpConst(C: PExpr; out X: PExpr; out Op: TBinOp; out K: Int64): Boolean;
    function RangeTest(E: PExpr; out X: PExpr; out Lo, Hi: Int64; out Inside: Boolean): Boolean;
    procedure RangeCmp(X: PExpr; Lo, Hi: Int64);
    procedure EmitProc(const Pr: TProc);
    procedure LoadGlobals(const Prog: TProgram);
    procedure EmitRuntime;
    procedure EmitRuntimeArm;
    procedure EmitXxh3X86;
    procedure EmitYieldPointX86;
    procedure EmitAsyncPreemptX86;
    function ZvaMsg: string;
    procedure EmitYieldPointArm;
    procedure EmitAsyncPreemptArm;
    procedure YieldCheckX86(const Tag: string);
    procedure YieldCheckArm(const Tag, Reg: string);
    procedure EmitMapGetStrX86;
    procedure EmitXxh3Arm;
    procedure EmitMapGetStrArm;
    procedure EmitScheduler;
    procedure EmitChan;
    procedure EmitIO;
  public
    function Emit(const Prog: TProgram): string;
  end;

procedure TEmitter.AppendLine(const S: string);
var
  m, need, room: SizeInt;
begin
  m := Length(S);
  if (FLen < 0) or (m < 0) or (FLen > 134217728) then
    Die('asm buffer overflow');
  need := FLen + m + 1;
  room := Length(FOut);
  if need > room then
  begin
    if room < 4096 then
      room := 4096;
    while room < need do
    begin
      if room > 67108864 then
        Die('asm buffer overflow');
      room := room * 2;
    end;
    if room > 134217728 then
      Die('asm buffer overflow');
    SetLength(FOut, room);
  end;
  if m > 0 then
    Move(S[1], FOut[FLen + 1], m);
  FOut[FLen + m + 1] := Char(10);
  FLen := need;
end;

{ ---- arm64's frame size as immediates (P308) ----

  A routine's frame is known only after its body, so arm64 loaded it
  from a word placed after the body, ldr x16, .Lfr and sub sp, sp, x16,
  and the stack check loaded the frame and its margin the same way: a
  load on the path of every call, four cycles on Neoverse N1 and a miss
  on a routine's first call. The prologue and the check now write a
  comment that marks their place, and SetFrame, which knows the size,
  puts there the SUBs that take it as immediates (ARM DDI 0487 M.c
  C6.2.457, imm12 and its shift by 12): one for up to 4095 bytes, two
  up to 16 MiB, a literal past that. Between the two SUBs of a large
  frame the frame is half made; nothing is stored in it yet, and a stop
  by a signal there saves its registers below that sp as anywhere. Go
  makes a frame up to 0xf0 with one STP and a larger one with SUB of
  its size (cmd/internal/obj/arm64/obj7.go). }

{ The place, from 1, of the last line L of the text written so far; 0
  when there is none (P308). }
function TEmitter.FindLineBack(const L: string): SizeInt;
var
  p, n, k: SizeInt;
  ok: Boolean;
begin
  Result := 0;
  n := Length(L);
  p := FLen - n;
  while p >= 1 do
  begin
    if (FOut[p + n] = Char(10)) and ((p = 1) or (FOut[p - 1] = Char(10))) and
      (FOut[p] = L[1]) then
    begin
      ok := True;
      for k := 2 to n do
        if FOut[p + k - 1] <> L[k] then
        begin
          ok := False;
          Break;
        end;
      if ok then
      begin
        Result := p;
        Exit;
      end;
    end;
    Dec(p);
  end;
end;

{ The OldLen characters from P are NewText now, the text after moved to
  follow it (P308). }
procedure TEmitter.ReplaceLine(P, OldLen: SizeInt; const NewText: string);
var
  d, m, room: SizeInt;
begin
  m := Length(NewText);
  d := m - OldLen;
  if FLen + d + 1 > Length(FOut) then
  begin
    room := Length(FOut);
    while room < FLen + d + 1 do
      room := room * 2;
    SetLength(FOut, room);
  end;
  if FLen - (P + OldLen) + 1 > 0 then
    Move(FOut[P + OldLen], FOut[P + m], FLen - (P + OldLen) + 1);
  if m > 0 then
    Move(NewText[1], FOut[P], m);
  FLen := FLen + d;
end;

function ArmImmText(const Reg: string; V: Int64): string; forward;

{ D := S - V as text, lines joined by line ends (P308). }
function TEmitter.SubImmText(const D, S: string; V: Int64): string;
var
  lo, hi: Int64;
begin
  if (V >= 0) and (V <= 4095) then
    Result := '  sub ' + D + ', ' + S + ', #' + IntToStr(V)
  else if (V > 0) and (V <= 16777215) then
  begin
    lo := V and 4095;
    hi := V shr 12;
    if lo = 0 then
      Result := '  sub ' + D + ', ' + S + ', #' + IntToStr(hi) + ', lsl #12'
    else
      Result := '  sub ' + D + ', ' + S + ', #' + IntToStr(lo) + Char(10) +
        '  sub ' + D + ', ' + D + ', #' + IntToStr(hi) + ', lsl #12';
  end
  else
    Result := ArmImmText('x16', V) + Char(10) + '  sub ' + D + ', ' + S + ', x16';
end;

{ The prologue's mark for its frame's SUBs (P308). }
procedure TEmitter.FrameMarkArm;
begin
  Line('  /* frame ' + FFrameSym + ' */');
  FFrameMarked := True;
end;

{ The routine Sym's frame F into its prologue's mark and its check's,
  when the check stayed (P308); a leaf without a frame wrote neither. }
procedure TEmitter.FixFrameArm(const Sym: string; F: LongInt);
var
  p: SizeInt;
  m: string;
begin
  if not FFrameMarked then
    Exit;
  FFrameMarked := False;
  m := '  /* check ' + Sym + ' */';
  p := FindLineBack(m);
  if p > 0 then
    ReplaceLine(p, Length(m), SubImmText('x9', 'sp', Int64(F) + 8 * FPushMax + RedZone));
  m := '  /* frame ' + Sym + ' */';
  p := FindLineBack(m);
  if p = 0 then
    Die('internal error: no frame mark for ' + Sym);
  ReplaceLine(p, Length(m), SubImmText('sp', 'sp', F));
end;

{ The jump to L that ends the code written so far goes, when only
  labels, .loc and .cfi lines follow it: L is about to be written next,
  and an Exit that ends a routine jumped to its epilogue right after it
  (P305). The labels stay; the code reaching them falls into L. }
procedure TEmitter.DropJumpTo(const L: string);
var
  e, b: SizeInt;
  t: string;
begin
  e := FLen;
  while e > 0 do
  begin
    b := e - 1;
    while (b > 0) and (FOut[b] <> Char(10)) do
      Dec(b);
    t := Copy(FOut, b + 1, e - b - 1);
    if (t = '  jmp ' + L) or (t = '  b ' + L) then
    begin
      if FLen > e then
        Move(FOut[e + 1], FOut[b + 1], FLen - e);
      FLen := FLen - (e - b);
      Exit;
    end;
    if not (((Length(t) > 1) and (t[1] = '.') and (t[Length(t)] = ':')) or
      (Copy(t, 1, 7) = '  .loc ') or (Copy(t, 1, 6) = '  .cfi')) then
      Exit;
    e := b;
  end;
end;

{ Which section a directive Line writes moves to: code for .text and
  for a .section whose flags have x, data for every other (P267). }
procedure TEmitter.NoteSection(const S: string);
var
  code: Boolean;
begin
  if S = '.popsection' then
  begin
    FTextSec := FTextPushed;
    Exit;
  end;
  if (Copy(S, 1, 5) = '.text') or (Copy(S, 1, 18) = '.pushsection .text') then
    code := True
  else if (Copy(S, 1, 8) = '.section') or (Copy(S, 1, 12) = '.pushsection') then
    code := (Pos('"ax"', S) > 0) or (Copy(S, 1, 14) = '.section .text')
  else if (S = '.data') or (S = '.bss') then
    code := False
  else
    Exit;
  if Copy(S, 1, 12) = '.pushsection' then
    FTextPushed := FTextSec;
  FTextSec := code;
end;

procedure TEmitter.Line(const S: string);
var
  n: SizeInt;
  t: string;
  drop: Boolean;
begin
  n := Length(S);
  if (n >= 5) and (S[1] = '.') then
    NoteSection(S);
  if (n > 4) and (n < 128) and (S[1] = 'r') and (S[2] = 't') and (S[3] = '_') and
    (S[n] = ':') then
  begin
    { arm64: a routine of the runtime starts on 32 bytes, as every
      routine does there (P267), where Arm's Neoverse N1 guide (4.9)
      puts subroutine entries and branch targets (Go aligns arm64's to
      16, cmd/internal/obj/arm64/asm7.go funcAlign). In code only: a
      label of the runtime in a data section stays where its data is;
      the padding of a code section is no-op instructions (as.info
      7.75), so an entry the code before it falls into (rt_waitio2) runs
      them first. Not amd64: aligned to 32 as Go aligns them
      (cmd/link/internal/amd64/l.go funcAlign), entries moved the hot
      loops across 64-byte lines on this Zen 2 and pairs pinned to one
      CPU changed by -5.7 to +8.7 %, worse on the whole; measured, it
      stays as it was. }
    if FTextSec and FArm then
      AppendLine('  .p2align 5');
    AppendLine('.globl ' + Copy(S, 1, n - 1));
  end;
  if (not FArm) and (not FAsmText) and CpuSlowLea(FTune) and SplitLea(S) then
    Exit;
  t := S;
  drop := False;
  if (not FArm) and (FLastIns <> '') then
    t := ForwardLoad(S, drop);
  if drop then
    Exit;
  if (not FArm) and (not FAsmText) then
    t := MovConst32(t);
  AppendLine(t);
  NoteLine(t);
  if FMapOn or FMapPro then
    MapNote(t);
end;

{ S, or its MOV of 32 bits when S moves a constant from 0 to 2^32 - 1
  into a register of 64 (movq $N, or movabsq): MOV r32, imm32 zeroes the
  upper half (SDM vol. 1 3.4.1.1) in five bytes, six past r7, where movq
  takes seven and movabsq ten, as Go writes MOVL for such a constant
  (cmd/compile/internal/amd64/ssa.go: 'Use MOVL to move a small
  constant into a register when the constant is positive and fits into
  32 bits'); a store to memory keeps its width, an asm block its text
  (P321). }
function TEmitter.MovConst32(const S: string): string;
var
  n, p, q: SizeInt;
  v: Int64;
  reg: string;
begin
  Result := S;
  n := Length(S);
  if (n < 14) or (S[1] <> ' ') or (S[2] <> ' ') or (S[3] <> 'm') then
    Exit;
  if Copy(S, 1, 8) = '  movq $' then
    p := 9
  else if Copy(S, 1, 11) = '  movabsq $' then
    p := 12
  else
    Exit;
  q := p;
  v := 0;
  while (q <= n) and (S[q] >= '0') and (S[q] <= '9') do
  begin
    v := v * 10 + (Ord(S[q]) - Ord('0'));
    if v > 4294967295 then
      Exit;
    Inc(q);
  end;
  if (q = p) or (q + 2 > n) or (S[q] <> ',') or (S[q + 1] <> ' ') or (S[q + 2] <> '%') then
    Exit;
  reg := Copy(S, q + 3, n - q - 2);
  if not ((reg = 'rax') or (reg = 'rbx') or (reg = 'rcx') or (reg = 'rdx') or
    (reg = 'rsi') or (reg = 'rdi') or (reg = 'rbp') or (reg = 'r8') or (reg = 'r9') or
    (reg = 'r10') or (reg = 'r11') or (reg = 'r12') or (reg = 'r13') or (reg = 'r14') or
    (reg = 'r15')) then
    Exit;
  { the register's 32 bits: eax for rax, esi for rsi, r8d for r8 }
  if reg[2] in ['0'..'9'] then
    reg := reg + 'd'
  else
    reg := 'e' + Copy(reg, 2, 2);
  Result := '  movl $' + Copy(S, p, q - p) + ', %' + reg;
end;

{ The line S after the movl $0 waiting at FZeroAt (P321): each zero is
  xorl, three bytes fewer and a zero idiom the renamer does without an
  execution unit (AMD 56665 2.9.2, Zen 3: XOR reg, reg a 0-cycle
  operation; 57647 and 58455 the same), when an instruction that writes
  every flag and reads none comes before any that reads one and before
  a label, a jump, a call, a return or an instruction this does not
  know, as Go writes MOV $0 as XOR where the flags are not live
  (amd64/ssa.go). A directive and a line's .LL label (never a jump's
  target) are passed by; a move, a load, a lea, a push or a pop touches
  no flag. }
procedure TEmitter.ZeroNote(const S: string);
var
  n, p: SizeInt;
  i: LongInt;
  op, z: string;
begin
  n := Length(S);
  if (n >= 3) and (S[1] = ' ') and (S[2] = ' ') and (S[3] = '.') then
    Exit;
  if (n > 4) and (Copy(S, 1, 3) = '.LL') and (S[n] = ':') then
    Exit;
  if (n < 3) or (S[1] <> ' ') or (S[2] <> ' ') then
  begin
    FZeroN := 0;
    Exit;
  end;
  p := 3;
  while (p <= n) and (S[p] <> ' ') do
    Inc(p);
  op := Copy(S, 3, p - 3);
  if (op = 'cmpq') or (op = 'cmpl') or (op = 'cmpw') or (op = 'cmpb') or
    (op = 'testq') or (op = 'testl') or (op = 'testw') or (op = 'testb') or
    (op = 'addq') or (op = 'addl') or (op = 'subq') or (op = 'subl') or
    (op = 'andq') or (op = 'andl') or (op = 'orq') or (op = 'orl') or
    (op = 'xorq') or (op = 'xorl') or (op = 'negq') or (op = 'negl') or
    (op = 'ucomisd') or (op = 'ucomiss') or (op = 'comisd') or (op = 'comiss') then
  begin
    { the last first: a longer line moves only the text after it }
    for i := FZeroN - 1 downto 0 do
    begin
      z := Copy(FOut, FZeroAt[i], FZeroLen[i]);
      z := Copy(z, 12, Length(z) - 11);
      ReplaceLine(FZeroAt[i], FZeroLen[i], '  xorl ' + z + ', ' + z);
    end;
    FZeroN := 0;
    Exit;
  end;
  if (p > n) or not ((op = 'movq') or (op = 'movl') or (op = 'movw') or (op = 'movb') or
    (op = 'movabsq') or (op = 'movzbl') or (op = 'movzwl') or (op = 'movzbq') or
    (op = 'movzwq') or (op = 'movsbq') or (op = 'movswq') or (op = 'movslq') or
    (op = 'movsbl') or (op = 'movswl') or (op = 'leaq') or (op = 'leal') or
    (op = 'pushq') or (op = 'popq') or (op = 'movsd') or (op = 'movss') or
    (op = 'movd') or (op = 'movaps') or (op = 'movups') or (op = 'movdqa') or
    (op = 'movdqu')) then
    FZeroN := 0;
end;

{ A lea of a base, an index and a displacement, or of a base of rbp or
  r13 beside an index, on a processor where that lea is slow
  (CpuSlowLea, P298): two leas of two components each, as Go wrote it up
  to 1.27 (amd64/ssa.go: the base and index first, then the displacement
  on the result). With a base of rbp or r13 the halves are chosen so
  neither has one beside an index: the index becomes the base when it
  is not scaled, else the displacement goes first when the result is
  not the index; a lea no split makes faster stays. True when it wrote
  the lines for S. An asm block's lines are never split. }
function TEmitter.SplitLea(const S: string): Boolean;
var
  n, i, o, c: SizeInt;
  op, d, inner, b, x, sc, r: string;
  disp, bslow, xslow, rslow: Boolean;
  parts: TStrArray;

  function SlowBase(const Reg: string): Boolean;
  begin
    Result := (Reg = '%rbp') or (Reg = '%ebp') or (Reg = '%bp') or (Reg = '%r13') or
      (Reg = '%r13d') or (Reg = '%r13w');
  end;

begin
  Result := False;
  n := Length(S);
  if (n < 16) or (Copy(S, 1, 5) <> '  lea') or (S[7] <> ' ') then
    Exit;
  op := Copy(S, 3, 4);
  if (op <> 'leaq') and (op <> 'leal') and (op <> 'leaw') then
    Exit;
  o := 0;
  c := 0;
  for i := 8 to n do
    if S[i] = '(' then
    begin
      o := i;
      Break;
    end;
  if o = 0 then
    Exit;
  for i := o + 1 to n do
    if S[i] = ')' then
    begin
      c := i;
      Break;
    end;
  if (c = 0) or (c + 3 > n) or (Copy(S, c + 1, 3) <> ', %') then
    Exit;
  d := Copy(S, 8, o - 8);
  inner := Copy(S, o + 1, c - o - 1);
  r := Copy(S, c + 3, n - c - 2);
  if (Pos(',', r) > 0) or (Pos(' ', r) > 0) then
    Exit;
  parts := nil;
  i := 1;
  while i <= Length(inner) + 1 do
  begin
    o := i;
    while (i <= Length(inner)) and (inner[i] <> ',') do
      Inc(i);
    SetLength(parts, Length(parts) + 1);
    parts[High(parts)] := Copy(inner, o, i - o);
    Inc(i);
  end;
  if (Length(parts) < 2) or (Length(parts) > 3) then
    Exit;
  b := parts[0];
  x := parts[1];
  sc := '1';
  if Length(parts) = 3 then
    sc := parts[2];
  if (b = '') or (x = '') or (b[1] <> '%') or (x[1] <> '%') then
    Exit;
  disp := (d <> '') and (d <> '0');
  bslow := SlowBase(b);
  xslow := SlowBase(x);
  rslow := SlowBase(r);
  if not (disp or bslow) then
    Exit;
  if not bslow then
  begin
    Line('  ' + op + ' (' + b + ',' + x + ',' + sc + '), ' + r);
    Line('  ' + op + ' ' + d + '(' + r + '), ' + r);
    Result := True;
  end
  else if (sc = '1') and not xslow then
  begin
    Line('  ' + op + ' (' + x + ',' + b + '), ' + r);
    if disp then
      Line('  ' + op + ' ' + d + '(' + r + '), ' + r);
    Result := True;
  end
  else if disp and (r <> x) and not rslow then
  begin
    Line('  ' + op + ' ' + d + '(' + b + '), ' + r);
    Line('  ' + op + ' (' + r + ',' + x + ',' + sc + '), ' + r);
    Result := True;
  end;
end;

{ A store followed by a load of the same place, with nothing a jump can
  reach between them, gives the load the stored value from the register
  (P96): the value of one statement is the start of the next, and the
  round trip through memory sat on the critical path. Only the line
  labels of EmitLoc (.LL, never a jump target), .loc and .cfi lines may
  sit in between. The store stays. amd64 only. }
function TEmitter.ForwardLoad(const S: string; out Drop: Boolean): string;
var
  n, i, p: SizeInt;
  mem, dst, src, want: string;
begin
  Result := S;
  Drop := False;
  n := Length(S);
  if (n < 12) or (Copy(S, 1, 7) <> '  movq ') then
    Exit;
  p := 0;
  for i := n - 2 downto 8 do
    if (S[i] = ',') and (S[i + 1] = ' ') and (S[i + 2] = '%') then
    begin
      p := i;
      Break;
    end;
  if p = 0 then
    Exit;
  mem := Copy(S, 8, p - 8);
  dst := Copy(S, p + 3, n - p - 2);
  if (mem = '') or (mem[1] = '%') or (mem[1] = '$') then
    Exit;
  want := ', ' + mem;
  if (Length(FLastIns) <= 7 + Length(want)) or (Copy(FLastIns, 1, 7) <> '  movq ') then
    Exit;
  if Copy(FLastIns, Length(FLastIns) - Length(want) + 1, Length(want)) <> want then
    Exit;
  src := Copy(FLastIns, 8, Length(FLastIns) - 7 - Length(want));
  if (src = '') or ((src[1] <> '%') and (src[1] <> '$')) then
    Exit;
  for i := 1 to Length(src) do
    if (src[i] = ',') or (src[i] = '(') then
      Exit;
  if src = '%' + dst then
  begin
    Drop := True;
    Exit;
  end;
  Result := '  movq ' + src + ', %' + dst;
end;

procedure TEmitter.NoteLine(const S: string);
var
  n: SizeInt;
begin
  n := Length(S);
  if n = 0 then
    Exit;
  if (Copy(S, 1, 7) = '  .loc ') or (Copy(S, 1, 6) = '  .cfi') then
    Exit;
  if (n > 4) and (Copy(S, 1, 3) = '.LL') and (S[n] = ':') then
    Exit;
  if (FIxOn or FChkOn) and (FColdAt < 0) then
    IxNote(S);
  if not FArm then
  begin
    if FZeroN > 0 then
      ZeroNote(S);
    if (not FAsmText) and (FColdAt < 0) and (FZeroN < 8) and (n > 12) and
      (Copy(S, 1, 12) = '  movl $0, %') then
    begin
      FZeroAt[FZeroN] := FLen - n;
      FZeroLen[FZeroN] := n;
      Inc(FZeroN);
    end;
  end;
  if (n > 3) and (S[1] = ' ') and (S[2] = ' ') and (S[3] <> '.') then
    FLastIns := S
  else
    FLastIns := '';
end;

{ P314: whether the line S, of the routine's straight path, leaves the
  scaled index FIxReg holds (on arm64 the element's address) as it was;
  FIxOn goes off when it may not. A label goes through a jump, so it
  forgets, but a line's (.LL, never a jump's target, NoteLine skips it),
  and so does any instruction that is not one of the plain ones below,
  and one that writes FIxReg, FIxSrc or FIxBase: on amd64 its last
  operand, a register of the same name at any width; on arm64 its first,
  ldp's first two, and the base a writeback form changes. A compare, a
  test or a branch writes none. The lines of a failure out of line
  (FColdAt) are not on the path: it never comes back, or comes back to
  a label. }
procedure TEmitter.IxNote(const S: string);
var
  n, p, q: SizeInt;
  op, rest, d: string;

  function Fam(const R: string): string;
  var
    t: string;
    k: SizeInt;
  begin
    Result := '';
    t := R;
    k := Length(t);
    while (k > 0) and ((t[k] = ' ') or (t[k] = ']') or (t[k] = '!')) do
      Dec(k);
    t := Copy(t, 1, k);
    if (t <> '') and (t[1] = '%') then
      t := Copy(t, 2, Length(t) - 1);
    if t = '' then
      Exit;
    if FArm then
    begin
      if ((t[1] = 'x') or (t[1] = 'w')) and (Length(t) >= 2) and (t[2] >= '0') and (t[2] <= '9') then
        Result := 'x' + Copy(t, 2, Length(t) - 1);
      Exit;
    end;
    if (t[1] = 'r') and (Length(t) >= 2) and (t[2] >= '0') and (t[2] <= '9') then
    begin
      k := 2;
      while (k <= Length(t)) and (t[k] >= '0') and (t[k] <= '9') do
        Inc(k);
      Result := Copy(t, 1, k - 1);
      Exit;
    end;
    if (t = 'rax') or (t = 'eax') or (t = 'ax') or (t = 'al') or (t = 'ah') then
      Result := 'rax'
    else if (t = 'rbx') or (t = 'ebx') or (t = 'bx') or (t = 'bl') or (t = 'bh') then
      Result := 'rbx'
    else if (t = 'rcx') or (t = 'ecx') or (t = 'cx') or (t = 'cl') or (t = 'ch') then
      Result := 'rcx'
    else if (t = 'rdx') or (t = 'edx') or (t = 'dx') or (t = 'dl') or (t = 'dh') then
      Result := 'rdx'
    else if (t = 'rsi') or (t = 'esi') or (t = 'si') or (t = 'sil') then
      Result := 'rsi'
    else if (t = 'rdi') or (t = 'edi') or (t = 'di') or (t = 'dil') then
      Result := 'rdi'
    else if (t = 'rbp') or (t = 'ebp') or (t = 'bp') or (t = 'bpl') then
      Result := 'rbp'
    else if (t = 'rsp') or (t = 'esp') or (t = 'sp') or (t = 'spl') then
      Result := 'rsp';
  end;

  function Hit(const R: string): Boolean;
  var
    f: string;
  begin
    f := Fam(R);
    if (f <> '') and FChkOn then
      ChkDrop(f, False);
    Result := (f <> '') and ((f = FIxReg) or (f = FIxSrc) or (f = FIxBase));
  end;

  function Starts(const P: string): Boolean;
  begin
    Result := Copy(op, 1, Length(P)) = P;
  end;

begin
  n := Length(S);
  if (n < 3) or (S[1] <> ' ') or (S[2] <> ' ') then
  begin
    FIxOn := False;
    FChkOn := False;
    Exit;
  end;
  if S[3] = '.' then
  begin
    if Copy(S, 1, 10) <> '  .p2align' then
    begin
      FIxOn := False;
      FChkOn := False;
    end;
    Exit;
  end;
  p := 3;
  while (p <= n) and (S[p] <> ' ') do
    Inc(p);
  op := Copy(S, 3, p - 3);
  rest := Copy(S, p + 1, n - p);
  if not FArm then
  begin
    if op = '' then
    begin
      FIxOn := False;
      FChkOn := False;
      Exit;
    end;
    if (((Starts('cmp') and not Starts('cmpxchg')) or Starts('test')) and (rest <> '')) or
      (op = 'bt') or (op = 'btq') or (op = 'btl') or ((op[1] = 'j') and (op <> 'jmpq')) then
      Exit;
    if not ((Starts('mov') and (rest <> '')) or (Starts('lea') and (rest <> '')) or Starts('add') or Starts('sub') or
      Starts('and') or Starts('or') or Starts('xor') or Starts('inc') or Starts('dec') or
      Starts('neg') or Starts('not') or Starts('sh') or Starts('sa') or Starts('ro') or
      Starts('set') or Starts('cmov') or Starts('adc') or Starts('sbb') or Starts('bswap') or
      Starts('popcnt') or Starts('lzcnt') or Starts('tzcnt') or Starts('bsf') or Starts('bsr') or
      (Starts('imul') and (Pos(',', rest) > 0))) then
    begin
      FIxOn := False;
      FChkOn := False;
      Exit;
    end;
    q := 0;
    for p := Length(rest) - 1 downto 1 do
      if (rest[p] = ',') and (rest[p + 1] = ' ') then
      begin
        q := p;
        Break;
      end;
    if q > 0 then
      d := Copy(rest, q + 2, Length(rest) - q - 1)
    else
      d := rest;
    { a store to the global's words ends a check against its length (P324) }
    if FChkOn and (Pos('(%rip)', d) > 0) then
      ChkDrop(d, True);
    if (d <> '') and (d[1] = '%') and Hit(d) then
      FIxOn := False;
    Exit;
  end;
  if (op = 'cmp') or (op = 'cmn') or (op = 'tst') or (op = 'b') or Starts('b.') or (op = 'cbz') or
    (op = 'cbnz') or (op = 'tbz') or (op = 'tbnz') or (op = 'nop') then
    Exit;
  q := Pos(',', rest);
  if q > 0 then
    d := Copy(rest, 1, q - 1)
  else
    d := rest;
  { arm64 reaches a global by x16 or x17: a store through them may write
    its length (P324) }
  if FChkOn and ((op = 'str') or (op = 'strb') or (op = 'strh') or
    (op = 'stur') or (op = 'sturb') or (op = 'sturh') or (op = 'stp')) and
    ((Pos('[x16', rest) > 0) or (Pos('[x17', rest) > 0)) then
    ChkDrop('', True);
  if (op = 'str') or (op = 'strb') or (op = 'strh') or (op = 'stur') or (op = 'sturb') or
    (op = 'sturh') or (op = 'stp') then
  begin
    { a store writes no register but the base of its writeback form }
    if (Pos('!', rest) > 0) or (Pos('], #', rest) > 0) then
    begin
      p := Pos('[', rest);
      q := p + 1;
      while (q <= Length(rest)) and (rest[q] <> ',') and (rest[q] <> ']') do
        Inc(q);
      if Hit(Copy(rest, p + 1, q - p - 1)) then
        FIxOn := False;
    end;
    Exit;
  end;
  if not ((op = 'mov') or (op = 'movz') or (op = 'movn') or (op = 'movk') or (op = 'add') or
    (op = 'adds') or (op = 'sub') or (op = 'subs') or (op = 'and') or (op = 'ands') or
    (op = 'orr') or (op = 'eor') or (op = 'eon') or (op = 'orn') or (op = 'bic') or
    (op = 'lsl') or (op = 'lsr') or (op = 'asr') or (op = 'ror') or (op = 'mul') or
    (op = 'madd') or (op = 'msub') or (op = 'smulh') or (op = 'umulh') or (op = 'neg') or
    (op = 'mvn') or (op = 'sxtw') or (op = 'sxth') or (op = 'sxtb') or (op = 'uxth') or
    (op = 'uxtb') or (op = 'csel') or (op = 'csinc') or (op = 'csinv') or (op = 'csneg') or
    (op = 'cinc') or (op = 'cset') or (op = 'csetm') or (op = 'cneg') or (op = 'ldr') or
    (op = 'ldrb') or (op = 'ldrh') or (op = 'ldrsb') or (op = 'ldrsh') or (op = 'ldrsw') or
    (op = 'ldur') or (op = 'ldurb') or (op = 'ldurh') or (op = 'ldursb') or (op = 'ldursh') or
    (op = 'ldursw') or (op = 'ldp') or (op = 'adr') or (op = 'adrp') or (op = 'clz') or
    (op = 'rbit') or (op = 'rev') or (op = 'ubfx') or (op = 'sbfx') or (op = 'ubfiz') or
    (op = 'sbfiz') or (op = 'bfi') or (op = 'bfxil') or (op = 'extr') or (op = 'fmov') or
    (op = 'scvtf') or (op = 'ucvtf') or (op = 'fcvtzs') or (op = 'fcvtzu')) then
  begin
    FIxOn := False;
    FChkOn := False;
    Exit;
  end;
  if Hit(d) then
    FIxOn := False;
  if op = 'ldp' then
  begin
    p := Pos(',', rest);
    q := p + 1;
    while (q <= Length(rest)) and (rest[q] <> ',') do
      Inc(q);
    d := Copy(rest, p + 1, q - p - 1);
    while (d <> '') and (d[1] = ' ') do
      d := Copy(d, 2, Length(d) - 1);
    if Hit(d) then
      FIxOn := False;
  end;
  if ((Copy(op, 1, 2) = 'ld')) and ((Pos('!', rest) > 0) or (Pos('], #', rest) > 0)) then
  begin
    p := Pos('[', rest);
    q := p + 1;
    while (q <= Length(rest)) and (rest[q] <> ',') and (rest[q] <> ']') do
      Inc(q);
    if Hit(Copy(rest, p + 1, q - p - 1)) then
      FIxOn := False;
  end;
end;

{ P316: the word place's last check, of the index register I against
  the length's register L ('' for a static array's bounds) with K the
  rest of its form, holds still: the same check is no work. }
function TEmitter.ChkKept(const I, L, K: string): Boolean;
var
  l2: string;
  q: LongInt;
begin
  l2 := L;
  if (l2 <> '') and (l2[1] = '%') then
    l2 := Copy(l2, 2, Length(l2) - 1);
  Result := False;
  if not FChkOn then
    Exit;
  for q := 0 to FChkN - 1 do
    if (FChkIdx[q] = I) and (FChkLen[q] = l2) and (FChkKey[q] = K) then
      Result := True;
end;

{ P324: the kept checks a write of register family F names, as index or
  length, are no more; with Mem, those against a global's length at its
  home that the store's text F names (on arm64 every one, F empty: its
  stores reach a global through x16 or x17). }
procedure TEmitter.ChkDrop(const F: string; Mem: Boolean);
var
  q, w: LongInt;
  drop: Boolean;
begin
  w := 0;
  for q := 0 to FChkN - 1 do
  begin
    if Mem then
      drop := (FChkMem[q] <> '') and ((F = '') or (Pos(FChkMem[q] + '+', F) > 0) or
        (Pos(FChkMem[q] + '(', F) > 0))
    else
      drop := (FChkIdx[q] = F) or (FChkLen[q] = F);
    if not drop then
    begin
      FChkIdx[w] := FChkIdx[q];
      FChkLen[w] := FChkLen[q];
      FChkKey[w] := FChkKey[q];
      FChkMem[w] := FChkMem[q];
      Inc(w);
    end;
  end;
  FChkN := w;
  FChkOn := w > 0;
end;

{ P316: the check just written holds while nothing writes I or L: kept
  when I is a variable's register (Ok) and L a register or none, as Go
  keeps one IsInBounds for both and prove knows it true in the blocks it
  dominates (cmd/compile/internal/ssacompile/cse.go and prove.go). }
procedure TEmitter.ChkKeep(const I, L, K: string; Ok: Boolean);
var
  l2: string;
  q: LongInt;
begin
  l2 := L;
  if (l2 <> '') and (l2[1] = '%') then
    l2 := Copy(l2, 2, Length(l2) - 1);
  if not FChkOn then
    FChkN := 0;
  if not (Ok and ((L = '') or ((not FArm) and (L[1] = '%')) or
    (FArm and ((L[1] = 'x') or (L[1] = 'w'))) or (Copy(L, 1, 2) = 'v_'))) then
    Exit;
  { the oldest goes when eight are kept }
  if FChkN = 8 then
  begin
    for q := 0 to 6 do
    begin
      FChkIdx[q] := FChkIdx[q + 1];
      FChkLen[q] := FChkLen[q + 1];
      FChkKey[q] := FChkKey[q + 1];
      FChkMem[q] := FChkMem[q + 1];
    end;
    FChkN := 7;
  end;
  FChkIdx[FChkN] := I;
  FChkLen[FChkN] := l2;
  FChkKey[FChkN] := K;
  { a global's length at its home (P324): its label, whose stores end the
    check as a register's writes do }
  FChkMem[FChkN] := '';
  if Copy(L, 1, 2) = 'v_' then
    FChkMem[FChkN] := Copy(L, 1, Pos('+', L) - 1);
  Inc(FChkN);
  FChkOn := True;
end;

{ P324: the length of the global slice N at its home holds while no line
  writes its label and no call or label lies between: its address taken
  by nobody (AddrKept), no unit's global another unit may write, and no
  parameter of this routine a fat value reached by reference, which may
  be the same slice under another name. }
{ P297: the static array B is a variable of this frame or a global in
  place, whose address one instruction gives into rcx or x1 after its
  index is worked out, with nothing pushed: not a var parameter, an outer
  routine's, one in a heap box or a register's. }
function TEmitter.LateBase(B: PExpr; out S: TSym): Boolean;
begin
  Result := False;
  if (B = nil) or (B^.Kind <> ekVar) then
    Exit;
  S := FindSym(B^.Name);
  Result := (S.Name <> '') and (not S.ByRef) and (S.Up = 0) and (not S.Boxed) and (S.Reg = '');
  if Result and FArm and FPromoOn and (PartReg(S, 3) <> '') then
    Result := False;
end;

function TEmitter.MemLenOK(const N: string): Boolean;
var
  i: SizeInt;
  sy: TSym;
begin
  Result := False;
  if (not TryFindSym(N, sy)) or (not sy.Global) or AddrKept(sy.Name) or
    FIsUnit or ExtGlobal(sy.Name) then
    Exit;
  for i := 0 to High(FSym) do
    if (FSym[i].Name <> '') and (not FSym[i].Global) and (FSym[i].Up = 0) and FSym[i].ByRef and
      (IsFat(FSym[i].Typ) or IsDyn(FSym[i].Typ)) then
      Exit;
  Result := True;
end;

{ ---- stack maps (P95c) ----

  Every call that compiled code makes gets a label right after it, the
  return address, and a descriptor of the frame there: which words
  below the frame pointer hold a pointer, which ones nobody knows. The
  pairs go to a section pasgcmaps every object file adds to; the
  collector reads a stopped routine's frames with them, and a stack
  that moves is adjusted by them. Line sees every instruction, so the
  words a routine pushes are counted here, not at each push: a push
  says what it pushes with MapHint before it, and one that does not is
  a word nobody knows, read as a candidate, which is always safe. }
procedure TEmitter.MapNote(const S: string);
var
  n, i: SizeInt;
  v: Int64;
  t: string;
begin
  n := Length(S);
  if n < 5 then
    Exit;
  if FArm then
  begin
    if (Copy(S, 1, 5) = '  bl ') or (Copy(S, 1, 6) = '  blr ') then
    begin
      MapSite;
      Exit;
    end;
  end
  else if Copy(S, 1, 7) = '  call ' then
  begin
    MapSite;
    Exit;
  end;
  if not FMapOn then
    Exit;
  if FArm then
  begin
    if Copy(S, 1, 12) = '  ldr x16, =' then
    begin
      if not StrToInt64(Copy(S, 13, n - 12), v) then
        v := -1;
      FX16 := v;
      Exit;
    end;
    if Copy(S, 1, 12) = '  mov x16, #' then
    begin
      if not StrToInt64(Copy(S, 13, n - 12), v) then
        v := -1;
      FX16 := v;
      Exit;
    end;
    if Copy(S, 1, 8) = '  ldr x16' then
    begin
      FX16 := -1;
      Exit;
    end;
    { Any other instruction that writes x16 (its first operand). }
    i := 3;
    while (i <= n) and (S[i] <> ' ') do
      Inc(i);
    if Copy(S, i + 1, 4) = 'x16,' then
      FX16 := -1;
    if (Copy(S, 1, 6) = '  str ') and (Copy(S, n - 12, 13) = ', [sp, #-16]!') then
    begin
      MapPush(2, True);
      Exit;
    end;
    if (Copy(S, 1, 6) = '  stp ') and (Copy(S, n - 12, 13) = ', [sp, #-16]!') then
    begin
      MapPush(2, False);
      Exit;
    end;
    { The epilogue: the frame goes, and its record is no push. }
    if S = '  mov sp, x29' then
    begin
      SetLength(FPushK, 0);
      Exit;
    end;
    if S = '  ldp x29, x30, [sp], #16' then
      Exit;
    if ((Copy(S, 1, 6) = '  ldr ') or (Copy(S, 1, 6) = '  ldp ')) and
      (Copy(S, n - 10, 11) = ', [sp], #16') then
    begin
      MapPop(2);
      Exit;
    end;
    if (Copy(S, 1, 15) = '  sub sp, sp, #') or (Copy(S, 1, 15) = '  add sp, sp, #') then
    begin
      if not StrToInt64(Copy(S, 16, n - 15), v) then
        Die('stack map: ' + S);
      if S[3] = 's' then
        MapPush(LongInt(v div 8), False)
      else
        MapPop(LongInt(v div 8));
      Exit;
    end;
    if (S = '  sub sp, sp, x16') or (S = '  add sp, sp, x16') then
    begin
      if FX16 < 0 then
        Die('stack map: x16 unknown at ' + S);
      if S[3] = 's' then
        MapPush(LongInt(FX16 div 8), False)
      else
        MapPop(LongInt(FX16 div 8));
      Exit;
    end;
    if (Copy(S, 1, 8) = '  mov sp') or (Copy(S, 1, 8) = '  add sp') or
      (Copy(S, 1, 8) = '  sub sp') then
    begin
      if FMapSpOk then
      begin
        FMapSpOk := False;
        Exit;
      end;
      Die('stack map: an unknown write of sp: ' + S);
    end;
    Exit;
  end;
  if Copy(S, 1, 8) = '  pushq ' then
  begin
    MapPush(1, False);
    Exit;
  end;
  if Copy(S, 1, 7) = '  popq ' then
  begin
    MapPop(1);
    Exit;
  end;
  if (n > 14) and (Copy(S, n - 5, 6) = ', %rsp') then
  begin
    t := Copy(S, 1, 8);
    if (t = '  subq $') or (t = '  addq $') then
    begin
      if not StrToInt64(Copy(S, 9, n - 14), v) then
        Die('stack map: ' + S);
      if S[3] = 's' then
        MapPush(LongInt(v div 8), False)
      else
        MapPop(LongInt(v div 8));
      Exit;
    end;
    if (Copy(S, 1, 6) = '  cmpq') or (Copy(S, 1, 7) = '  testq') then
      Exit;
    if FMapSpOk then
    begin
      FMapSpOk := False;
      Exit;
    end;
    Die('stack map: an unknown write of %rsp: ' + S);
  end;
end;

{ The class of the words of the next push, lowest address first. }
procedure TEmitter.MapHint(K: Byte);
begin
  SetLength(FPushHint, 1);
  FPushHint[0] := K;
end;

{ The class of word W of a value of type Typ as a register holds it: a
  record or a static array is its address, a pointer (P95c). }
function TEmitter.VCls(Typ, W: LongInt): Byte;
var
  bits: TGcBits;
  tk: TTypeKind;
begin
  if IsBlob(Typ) then
  begin
    if W = 0 then
      Result := 1
    else
      Result := 0;
    Exit;
  end;
  tk := TKind(Typ);
  if (tk = tykGeneric) or (tk = tykParam) then
  begin
    Result := 2;
    Exit;
  end;
  bits := nil;
  GcMark(Typ, 0, bits, 0);
  if (W < Length(bits)) and bits[W] then
    Result := 1
  else
    Result := 0;
end;

{ The class of what EmitArgVal leaves in rax or x0: the address of a fat
  value, of a record or of @x, else the value. }
function TEmitter.ACls(E: PExpr): Byte;
begin
  if (E^.Kind = ekAddr) or IsFat(E^.Typ) or IsBlob(E^.Typ) then
    Result := 1
  else
    Result := VCls(E^.Typ, 0);
end;

{ A push that says what it pushes (amd64 and arm64). }
procedure TEmitter.PushK(const Reg: string; K: Byte);
begin
  MapHint(K);
  Line('  pushq %' + Reg);
end;

procedure TEmitter.PshK(const Reg: string; K: Byte);
begin
  MapHint(K);
  Psh(Reg);
end;

procedure TEmitter.MapHint2(K0, K1: Byte);
begin
  SetLength(FPushHint, 2);
  FPushHint[0] := K0;
  FPushHint[1] := K1;
end;

{ The processor the program is compiled for has the feature whose bit
  of rt_cpufeat is Bit (-cpu, P111): the emitter chooses the
  instructions by it and the program tests nothing at run time. }
function TEmitter.HasFeat(Bit: LongInt): Boolean;
begin
  Result := ((FCpuSet shr Bit) and 1) <> 0;
end;

{ The processor of a routine's code, when $CPU or $TUNE made it another
  than the command line's, said in the assembly before it (P261). }
procedure TEmitter.CpuNote(const Sym: string; ASet: Int64; ATune: LongInt);
var
  t: string;
begin
  if (ASet = FProgCpu) and (ATune = FProgTune) then
    Exit;
  t := CpuProcName(ATune);
  if t = '' then
    t := 'generic';
  Line('/* ' + Sym + ': cpu ' + CpuSetNames(ASet, FArm) + '; tune ' + t + ' */');
end;

{ The lowest bit set of a word that is not 0, on amd64 (P261): TZCNT
  on BMI1, which is never slower than BSF (2 ops of latency 2 against 6
  of latency 3 on Zen to Zen 3, the same on Zen 5 and Skylake: the AMD
  latency tables and Intel 336289-001), else BSF. Sfx is the width, q
  or l; on a word that is not 0 the two give the same. }
function TEmitter.Bsf(const Sfx: string): string;
begin
  if HasFeat(CpuFeatBit('bmi1', False)) then
    Result := 'tzcnt' + Sfx
  else
    Result := 'bsf' + Sfx;
end;

{ The highest bit set of a word that is not 0 into Dst, on amd64
  (P261): 63 - LZCNT (lzcnt and an xor, 2 ops of latency 2) where the
  processor tuned for has LZCNT and its table says BSR costs more (6
  ops of latency 4 on Zen to Zen 3: CpuCostLzcntBsr), else BSR (1 op
  of latency 1 on Zen 5, 3 cycles as LZCNT on Skylake). }
procedure TEmitter.BsrQ(const Src, Dst: string);
begin
  if HasFeat(CpuFeatBit('lzcnt', False)) and CpuCostLzcntBsr(FTune) then
  begin
    Line('  lzcntq %' + Src + ', %' + Dst);
    Line('  xorq $63, %' + Dst);
  end
  else
    Line('  bsrq %' + Src + ', %' + Dst);
end;

{ One G-state CAS kernel: x9 address, w1 expected, w2 new; w3 observed,
  w4 exclusive status. Current Go atomic_arm64.s Cas and ARM ARM CASAL/
  LDAXR/STLXR. CPU choice is static; failed CAS also acquires an early
  wake. Every ready/park/park-unlock/IO transition uses this body. }
procedure TEmitter.ArmGStatusCas(const RetryLabel, MissLabel: string);
begin
  Line(RetryLabel + ':');
  if HasFeat(CpuFeatBit('atomics', True)) then
  begin
    Line('  mov w3, w1');
    Line('  casal w3, w2, [x9]');
    Line('  cmp w3, w1');
    Line('  b.ne ' + MissLabel);
  end
  else
  begin
    Line('  ldaxr w3, [x9]');
    Line('  cmp w3, w1');
    Line('  b.ne ' + MissLabel);
    Line('  stlxr w4, w2, [x9]');
    Line('  cbnz w4, ' + RetryLabel);
  end;
end;

procedure TEmitter.MapHint4(K0, K1, K2, K3: Byte);
begin
  SetLength(FPushHint, 4);
  FPushHint[0] := K0;
  FPushHint[1] := K1;
  FPushHint[2] := K2;
  FPushHint[3] := K3;
end;

{ Words more below the frame, the highest first. A str of one register
  to [sp, #-16]! (Pad) is the register at sp and a word of padding over
  it. Word j of the region, from its lowest address, has class
  FPushHint[j], 2 when no hint says. }
procedure TEmitter.MapPush(Words: LongInt; Pad: Boolean);
var
  n, j: SizeInt;
  k: Byte;
begin
  n := Length(FPushK);
  SetLength(FPushK, n + Words);
  if n + Words > FPushMax then
    FPushMax := n + Words;
  for j := Words - 1 downto 0 do
  begin
    if Pad and (j = 1) then
      k := 0
    else if j < Length(FPushHint) then
      k := FPushHint[j]
    else
      k := 2;
    FPushK[n + (Words - 1 - j)] := k;
  end;
  SetLength(FPushHint, 0);
end;

procedure TEmitter.MapPop(Words: LongInt);
var
  n: SizeInt;
begin
  n := Length(FPushK) - Words;
  if n < 0 then
    Die('stack map: more words popped than pushed in ' + FCurProc);
  SetLength(FPushK, n);
end;

{ The label after a call, and the state of the frame there. }
procedure TEmitter.MapSite;
var
  n, i: SizeInt;
  gl: string;
begin
  Inc(FMapLab);
  gl := '.Lgm' + IntToStr(FMapLab);
  n := Length(FMapSites);
  SetLength(FMapSites, n + 1);
  FMapSites[n].Lab := gl;
  if FMapOn then
    FMapSites[n].Kind := 0
  else
    FMapSites[n].Kind := 1;
  SetLength(FMapSites[n].Pushed, Length(FPushK));
  for i := 0 to High(FPushK) do
    FMapSites[n].Pushed[i] := FPushK[i];
  SetLength(FMapSites[n].ScrOff, Length(FScrOff));
  SetLength(FMapSites[n].ScrK, Length(FScrOff));
  for i := 0 to High(FScrOff) do
  begin
    FMapSites[n].ScrOff[i] := FScrOff[i];
    FMapSites[n].ScrK[i] := FScrK[i];
  end;
  FMapSites[n].Pinned := FPinned;
  FMapSites[n].PinTop := FScratchOff;
  FMapSites[n].Da := FCurDa;
  AppendLine(gl + ':');
  NoteLine(gl + ':');
end;

procedure TEmitter.MapLoc(Off: LongInt; K: Byte);
var
  n: SizeInt;
begin
  n := Length(FLocOff);
  SetLength(FLocOff, n + 1);
  SetLength(FLocK, n + 1);
  FLocOff[n] := Off;
  FLocK[n] := K;
end;

{ The frame is set up: from here a call gets a map. The routine's own
  words (static link, Self, the parameters in registers, Result and the
  locals) have classes by their types for the whole routine: they start
  as zero or as the value passed. A parameter by reference, Self and the
  static link are addresses, which a moved stack adjusts. }
procedure TEmitter.MapBegin;
var
  i, j, words: SizeInt;
  bits: TGcBits;
  k: Byte;
  tk: TTypeKind;
begin
  FMapOn := True;
  FMapPro := False;
  FMapSpOk := False;
  SetLength(FPushK, 0);
  FPushMax := 0;
  SetLength(FPushHint, 0);
  SetLength(FScrOff, 0);
  SetLength(FScrK, 0);
  SetLength(FLocOff, 0);
  SetLength(FLocK, 0);
  SetLength(FTryPush, 0);
  FScrHint := 2;
  FX16 := -1;
  if FNest > 0 then
    MapLoc(-8, 1);
  for i := 0 to High(FSym) do
    if (not FSym[i].Global) and (FSym[i].Up = 0) and (FSym[i].Off < 0) then
    begin
      if FSym[i].ByRef or (FSym[i].Name = 'self') then
      begin
        MapLoc(FSym[i].Off, 1);
        Continue;
      end;
      tk := TKind(FSym[i].Typ);
      words := Align8(SlotSize(FSym[i].Typ)) div 8;
      bits := nil;
      GcMark(FSym[i].Typ, 0, bits, 0);
      for j := 0 to words - 1 do
      begin
        k := 0;
        if (j < Length(bits)) and bits[j] then
        begin
          k := 1;
          if (tk = tykGeneric) or (tk = tykParam) then
            k := 2;
        end;
        if k <> 0 then
          MapLoc(FSym[i].Off + 8 * LongInt(j), k);
      end;
    end;
end;

{ A descriptor's label, one per distinct descriptor of the object file. }
function TEmitter.MapDesc(const D: string): string;
var
  h, i, m, n: SizeInt;
  hv: Int64;
begin
  if Length(FDescHash) = 0 then
  begin
    SetLength(FDescHash, 1024);
    for i := 0 to High(FDescHash) do
      FDescHash[i] := -1;
  end;
  if FDescN * 2 >= Length(FDescHash) then
  begin
    m := Length(FDescHash) * 2;
    SetLength(FDescHash, m);
    for i := 0 to m - 1 do
      FDescHash[i] := -1;
    for n := 0 to FDescN - 1 do
    begin
      hv := 2166136261;
      for i := 1 to Length(FDescOut[n]) do
        hv := ((hv xor Int64(Ord(FDescOut[n][i]))) * 16777619) and 4294967295;
      h := SizeInt(hv and Int64(m - 1));
      while FDescHash[h] >= 0 do
        h := (h + 1) and (m - 1);
      FDescHash[h] := LongInt(n);
    end;
  end;
  m := Length(FDescHash);
  hv := 2166136261;
  for i := 1 to Length(D) do
    hv := ((hv xor Int64(Ord(D[i]))) * 16777619) and 4294967295;
  h := SizeInt(hv and Int64(m - 1));
  while FDescHash[h] >= 0 do
  begin
    if FDescOut[FDescHash[h]] = D then
    begin
      Result := '.Lgd' + IntToStr(FDescHash[h]);
      Exit;
    end;
    h := (h + 1) and (m - 1);
  end;
  if FDescN >= Length(FDescOut) then
    SetLength(FDescOut, 2 * FDescN + 64);
  FDescOut[FDescN] := D;
  FDescHash[h] := LongInt(FDescN);
  Result := '.Lgd' + IntToStr(FDescN);
  Inc(FDescN);
end;

{ The routine is done and its frame is F bytes: every site of it gets
  its descriptor. Word i of a descriptor is the word at fp - 8(i + 1);
  the first word says the kind and the number n of words, the words
  from the frame pointer down to the stack pointer at the call; then
  (n + 63) div 64 words of bits for the words to read and as many for
  the ones among them nobody knows. }
procedure TEmitter.MapEnd(F: LongInt);
var
  s, i, j, n, nb, idx: SizeInt;
  cls: array of Byte;
  d: string;
  w, u: Int64;
begin
  cls := nil;
  for s := 0 to High(FMapSites) do
  begin
    if FMapSites[s].Kind = 1 then
      d := '  .quad 1'
    else
    begin
      n := SizeInt(F div 8) + Length(FMapSites[s].Pushed);
      SetLength(cls, n);
      for i := 0 to n - 1 do
        cls[i] := 0;
      for i := 0 to High(FLocOff) do
      begin
        idx := SizeInt((-FLocOff[i]) div 8) - 1;
        if (idx >= 0) and (idx < n) then
          cls[idx] := FLocK[i];
      end;
      { a P284 candidate not written at the call: dead there, its slot
        not cleared, so not read }
      if FDaOn then
        for i := 0 to High(FDaName) do
          if (FMapSites[s].Da and (Int64(1) shl i)) = 0 then
            for j := 0 to FDaWords[i] - 1 do
            begin
              idx := SizeInt((-(FDaOff[i] + 8 * LongInt(j))) div 8) - 1;
              if (idx >= 0) and (idx < n) then
                cls[idx] := 0;
            end;
      for j := 1 to FMapSites[s].Pinned div 8 do
      begin
        idx := SizeInt((-(FMapSites[s].PinTop - 8 * LongInt(j))) div 8) - 1;
        if (idx >= 0) and (idx < n) then
          cls[idx] := 2;
      end;
      for i := 0 to High(FMapSites[s].ScrOff) do
      begin
        idx := SizeInt((-FMapSites[s].ScrOff[i]) div 8) - 1;
        if (idx >= 0) and (idx < n) then
          cls[idx] := FMapSites[s].ScrK[i];
      end;
      for j := 0 to High(FMapSites[s].Pushed) do
        cls[SizeInt(F div 8) + j] := FMapSites[s].Pushed[j];
      d := '  .quad ' + IntToStr(Int64(n) * 256);
      nb := (n + 63) div 64;
      for j := 0 to nb - 1 do
      begin
        w := 0;
        for i := 0 to 63 do
          if (j * 64 + i < n) and (cls[j * 64 + i] <> 0) then
            w := w or (Int64(1) shl i);
        d := d + ', ' + IntToStr(w);
      end;
      for j := 0 to nb - 1 do
      begin
        u := 0;
        for i := 0 to 63 do
          if (j * 64 + i < n) and (cls[j * 64 + i] = 2) then
            u := u or (Int64(1) shl i);
        d := d + ', ' + IntToStr(u);
      end;
    end;
    if (s = 0) and (FOwnSec <> '') then
    begin
      { the entries of a routine in its own section go to a section the
        linker keeps with the routine's (SHF_LINK_ORDER) and lays inside
        pasgcmaps by the script the driver writes; the runtime sorts the
        table at start }
      if FArm then
        MapOutLine('.section pasgcmaps.' + FOwnSec + ',"awo",%progbits,' + FOwnSec)
      else
        MapOutLine('.section pasgcmaps.' + FOwnSec + ',"awo",@progbits,' + FOwnSec);
      MapOutLine('.balign 8');
    end;
    MapOutLine('  .quad ' + FMapSites[s].Lab + ', ' + MapDesc(d));
  end;
  if (Length(FMapSites) > 0) and (FOwnSec <> '') then
    MapOutLine('.section pasgcmaps,"aw"');
  SetLength(FMapSites, 0);
  FMapOn := False;
  FMapPro := False;
end;

procedure TEmitter.MapOutLine(const S: string);
begin
  if FMapOutN >= Length(FMapOut) then
    SetLength(FMapOut, 2 * FMapOutN + 256);
  FMapOut[FMapOutN] := S;
  Inc(FMapOutN);
end;

{ E may stop the program where it is written (P341): an element, whose
  index is checked, a dereference, a field or a method through a pointer
  or an object, which a nil stops, a division, a conversion that checks
  its range. }
function TEmitter.MayStop(E: PExpr): Boolean;
begin
  Result := (E <> nil) and (E^.PosLine > 0) and ((E^.Kind = ekIndex) or (E^.Kind = ekDeref) or
    (E^.Kind = ekMethod) or (E^.Kind = ekUn) or
    ((E^.Kind = ekField) and (E^.L <> nil) and ((E^.L^.Kind = ekDeref) or (TKind(E^.L^.Typ) = tykClass))) or
    ((E^.Kind = ekBin) and ((E^.Bin = boDiv) or (E^.Bin = boMod))));
end;

{ Entering E's code (P341): its line is the failure's, out of line (a
  check's block takes FOpLine), until E's code ends and Saved comes
  back; a dereference, which the signal of a nil stops in line, takes a
  line of its own in the table when its statement runs on to its line.
  An inlined body's expressions have no place (CopyE): a callee's line
  is not the caller's. }
procedure TEmitter.OpLineIn(E: PExpr; out Saved: LongInt);
begin
  Saved := FOpLine;
  if not MayStop(E) then
    Exit;
  FOpLine := E^.PosLine;
  if (FCurLine > 0) and (E^.PosLine <> FCurLine) and ((E^.Kind = ekDeref) or (E^.Kind = ekField) or
    (E^.Kind = ekMethod)) then
    EmitLoc(E^.PosLine);
end;

procedure TEmitter.EmitLoc(LineNo: LongInt);
var
  n: SizeInt;
  locn: string;
begin
  if LineNo <= 0 then
    Exit;
  if LineNo = FCurLine then
    Exit;
  FCurLine := LineNo;
  if FDbgLine = 0 then
    FDbgLine := LineNo;
  Line('  .loc 1 ' + IntToStr(LineNo));
  Inc(FLab);
  locn := '.LL' + IntToStr(FLab);
  Line(locn + ':');
  n := Length(FLineLabs);
  SetLength(FLineLabs, n + 1);
  SetLength(FLineNums, n + 1);
  FLineLabs[n] := locn;
  FLineNums[n] := LineNo;
end;

{ A constant into Reg: a mov (movz or movn) when it takes one, else a
  literal the assembler places (P100, 1.0.102: every constant was a load
  from the literal pool). MapNote reads either for x16. }
procedure TEmitter.Imm(const Reg: string; V: Int64);
var
  t: string;
  p: SizeInt;
begin
  if (V >= -65536) and (V <= 65535) then
  begin
    Line('  mov ' + Reg + ', #' + IntToStr(V));
    Exit;
  end;
  { the instructions Go's assembler writes, no literal load (P315) }
  t := ArmImmText(Reg, V);
  p := Pos(Char(10), t);
  while p > 0 do
  begin
    Line(Copy(t, 1, p - 1));
    t := Copy(t, p + 1, Length(t) - p);
    p := Pos(Char(10), t);
  end;
  Line(t);
end;

{ Reg := x29 + Off, in one add or sub when Off fits twelve bits, or
  twelve bits shifted by 12 (ArmAddImm, P306). }
procedure TEmitter.AddFP(const Reg: string; Off: Int64);
begin
  if (Off >= 0) and (ArmAddImm(Off) <> '') then
    Line('  add ' + Reg + ', x29, ' + ArmAddImm(Off))
  else if (Off < 0) and (Off > Low(Int64)) and (ArmAddImm(-Off) <> '') then
    Line('  sub ' + Reg + ', x29, ' + ArmAddImm(-Off))
  else
  begin
    Imm('x16', Off);
    Line('  add ' + Reg + ', x29, x16');
  end;
end;

procedure TEmitter.LeaS(const Sym, Reg: string);
begin
  Line('  adrp ' + Reg + ', ' + Sym);
  Line('  add ' + Reg + ', ' + Reg + ', :lo12:' + Sym);
end;

procedure TEmitter.LdS(const Sym, Reg: string);
begin
  LeaS(Sym, 'x16');
  Line('  ldr ' + Reg + ', [x16]');
end;

procedure TEmitter.StS(const Reg, Sym: string);
begin
  LeaS(Sym, 'x16');
  Line('  str ' + Reg + ', [x16]');
end;

{ A frame word: one ldur or stur within 256 bytes of x29, which covers
  most locals and every parameter slot; farther, x16 = x29 + Off. }
procedure TEmitter.LdFP(const Reg: string; Off: LongInt);
begin
  if (Off >= -256) and (Off <= 255) then
    Line('  ldr ' + Reg + ', [x29, #' + IntToStr(Off) + ']')
  else
  begin
    AddFP('x16', Off);
    Line('  ldr ' + Reg + ', [x16]');
  end;
end;

procedure TEmitter.StFP(const Reg: string; Off: LongInt);
begin
  if (Off >= -256) and (Off <= 255) then
    Line('  str ' + Reg + ', [x29, #' + IntToStr(Off) + ']')
  else
  begin
    AddFP('x16', Off);
    Line('  str ' + Reg + ', [x16]');
  end;
end;

procedure TEmitter.Psh(const Reg: string);
begin
  Line('  str ' + Reg + ', [sp, #-16]!');
end;

procedure TEmitter.Ppop(const Reg: string);
begin
  Line('  ldr ' + Reg + ', [sp], #16');
end;

function TEmitter.ArgR(I: LongInt): string;
begin
  case I of
    0: Result := 'x0';
    1: Result := 'x1';
    2: Result := 'x2';
    3: Result := 'x3';
    4: Result := 'x4';
    5: Result := 'x5';
    6: Result := 'x6';
    7: Result := 'x7';
  else
    Result := 'x0';
  end;
end;

function TEmitter.Lab: string;
begin
  Inc(FLab);
  Result := '.L' + IntToStr(FLab);
end;

procedure TEmitter.EmitClassRel(E: PExpr);
var
  yes, no, done, lp, vmt: string;
begin
  yes := Lab;
  no := Lab;
  done := Lab;
  lp := Lab;
  vmt := 'vmt_' + TypeStemOf(FTypes[E^.R^.Num]);
  EmitExpr(E^.L);
  if FArm then
  begin
    if E^.Bin = boAs then
      Line('  mov x4, x0');
    Line('  cbz x0, ' + no);
    Line('  ldr x1, [x0]');
    LeaS(vmt, 'x2');
    Line(lp + ':');
    Line('  cbz x1, ' + no);
    Line('  cmp x1, x2');
    Line('  b.eq ' + yes);
    Line('  ldr x1, [x1, #-16]');
    Line('  b ' + lp);
    Line(yes + ':');
    if E^.Bin = boAs then
    begin
      { as: a miss is nil or the failure, out of line (P300) }
      Line('  mov x0, x4');
      ColdBeginAt('', no);
      Line('  cbz x4, ' + done);
      Line('  bl rt_asfail');
      ColdEnd;
    end
    else
    begin
      Line('  mov x0, #1');
      Line('  b ' + done);
      Line(no + ':');
      Line('  mov x0, xzr');
    end;
    Line(done + ':');
  end
  else
  begin
    if E^.Bin = boAs then
      Line('  movq %rax, %r8');
    Line('  testq %rax, %rax');
    Line('  jz ' + no);
    Line('  movq (%rax), %rcx');
    Line('  leaq ' + vmt + '(%rip), %rdx');
    Line(lp + ':');
    Line('  testq %rcx, %rcx');
    Line('  jz ' + no);
    Line('  cmpq %rdx, %rcx');
    Line('  je ' + yes);
    Line('  movq -16(%rcx), %rcx');
    Line('  jmp ' + lp);
    Line(yes + ':');
    if E^.Bin = boAs then
    begin
      Line('  movq %r8, %rax');
      ColdBeginAt('', no);
      Line('  testq %r8, %r8');
      Line('  jz ' + done);
      Line('  call rt_asfail');
      ColdEnd;
    end
    else
    begin
      Line('  movq $1, %rax');
      Line('  jmp ' + done);
      Line(no + ':');
      Line('  xorq %rax, %rax');
    end;
    Line(done + ':');
  end;
end;

procedure TEmitter.EmitInitCalls(const Prog: TProgram);
var
  i: SizeInt;
  sym: string;
begin
  for i := 0 to High(Prog.UsesNames) do
  begin
    sym := 'u_' + ToLower(Prog.UsesNames[i]) + '_init';
    if FArm then
      Line('  bl ' + sym)
    else
      Line('  call ' + sym);
  end;
end;

procedure TEmitter.EmitUnitLife(const Prog: TProgram);
var
  uname, onceSym, initSym, finiSym, ret: string;
  i: SizeInt;
begin
  uname := ToLower(Prog.Name);
  onceSym := 'u_' + uname + '_once';
  initSym := 'u_' + uname + '_init';
  finiSym := 'u_' + uname + '_fini';
  ret := Lab;
  LoadGlobals(Prog);
  { the processor of the initialization and the finalization (P261) }
  FCpuSet := Prog.MainCpu;
  FTune := Prog.MainTune;
  FNest := 0;
  FScratchOff := 0;
  FScratchCur := 0;
  FScratchMax := 0;
  FFrameSym := '.Lfr' + initSym;
  CpuNote(initSym, Prog.MainCpu, Prog.MainTune);
  Line('.globl ' + initSym);
  Line(initSym + ':');
  EmitStackCheck(initSym, FFrameSym);
  if FArm then
  begin
    Line('  stp x29, x30, [sp, #-16]!');
    Line('  mov x29, sp');
    FrameMarkArm;
    MapBegin;
    LdS(onceSym, 'x0');
    Line('  cbnz x0, ' + ret);
    Line('  mov x0, #1');
    StS('x0', onceSym);
    for i := 0 to High(Prog.UsesNames) do
      Line('  bl u_' + ToLower(Prog.UsesNames[i]) + '_init');
    if Prog.InitBody <> nil then
    begin
      SelBodyIs(Prog.InitBody);
      EmitStmt(Prog.InitBody);
    end;
    LeaS(finiSym, 'x0');
    Line('  bl rt_regfini');
    Line(ret + ':');
    Line('  mov x0, xzr');
    Line('  mov sp, x29');
    Line('  ldp x29, x30, [sp], #16');
    Line('  ret');
    ColdFlush(False);
    SetFrame(FFrameSym, 0);
    Line('.globl ' + finiSym);
    Line(finiSym + ':');
    if Prog.FiniBody <> nil then
    begin
      FScratchMax := 0;
      FFrameSym := '.Lfr' + finiSym;
      EmitStackCheck(finiSym, FFrameSym);
      Line('  stp x29, x30, [sp, #-16]!');
      Line('  mov x29, sp');
      FrameMarkArm;
      MapBegin;
      SelBodyIs(Prog.FiniBody);
      EmitStmt(Prog.FiniBody);
      Line('  mov x0, xzr');
      Line('  mov sp, x29');
      Line('  ldp x29, x30, [sp], #16');
      Line('  ret');
      ColdFlush(False);
      SetFrame(FFrameSym, 0);
    end
    else
      Line('  ret');
  end
  else
  begin
    Line('  pushq %rbp');
    Line('  movq %rsp, %rbp');
    Line('  subq $' + FFrameSym + ', %rsp');
    MapBegin;
    Line('  movq ' + onceSym + '(%rip), %rax');
    Line('  testq %rax, %rax');
    Line('  jnz ' + ret);
    Line('  movq $1, ' + onceSym + '(%rip)');
    for i := 0 to High(Prog.UsesNames) do
      Line('  call u_' + ToLower(Prog.UsesNames[i]) + '_init');
    if Prog.InitBody <> nil then
    begin
      SelBodyIs(Prog.InitBody);
      EmitStmt(Prog.InitBody);
    end;
    Line('  leaq ' + finiSym + '(%rip), %rdi');
    Line('  call rt_regfini');
    Line(ret + ':');
    Line('  xorq %rax, %rax');
    Line('  leave');
    Line('  ret');
    ColdFlush(False);
    SetFrame(FFrameSym, 0);
    Line('.globl ' + finiSym);
    Line(finiSym + ':');
    if Prog.FiniBody <> nil then
    begin
      FScratchMax := 0;
      FFrameSym := '.Lfr' + finiSym;
      EmitStackCheck(finiSym, FFrameSym);
      Line('  pushq %rbp');
      Line('  movq %rsp, %rbp');
      Line('  subq $' + FFrameSym + ', %rsp');
      MapBegin;
      SelBodyIs(Prog.FiniBody);
      EmitStmt(Prog.FiniBody);
      Line('  xorq %rax, %rax');
      Line('  leave');
      Line('  ret');
      ColdFlush(False);
      SetFrame(FFrameSym, 0);
    end
    else
      Line('  ret');
  end;
end;

function TEmitter.InternStr(const S: string): string;
var
  i, n: SizeInt;
begin
  n := Length(FStrs);
  for i := 0 to n - 1 do
    if FStrs[i] = S then
    begin
      Result := '.Ls' + IntToStr(i);
      Exit;
    end;
  SetLength(FStrs, n + 1);
  FStrs[n] := S;
  Result := '.Ls' + IntToStr(n);
end;

function TEmitter.InternStrFat(const S: string): string;
begin
  Result := '.Lsf' + Copy(InternStr(S), 4, 32);
end;

{ The list of an array of const (P124), in the frame; see EmitRealFn. }
procedure TEmitter.EmitConstArr(E: PExpr);
var
  n, i, kd: LongInt;
  off, base: LongInt;
begin
  n := LongInt(Length(E^.Args));
  if n = 0 then
  begin
    if FArm then
    begin
      Line('  mov x0, xzr');
      Line('  mov x2, xzr');
      Line('  mov x3, xzr');
    end
    else
    begin
      Line('  xorl %eax, %eax');
      Line('  xorl %edx, %edx');
      Line('  xorl %r8d, %r8d');
    end;
    Exit;
  end;
  off := ScratchT(n * 32, LongInt(E^.Num));
  for i := 0 to n - 1 do
  begin
    base := off + 32 * i;
    if FArm then
      StFP('xzr', base + 8)
    else
      Line('  movq $0, ' + IntToStr(base + 8) + '(%rbp)');
  end;
  for i := 0 to n - 1 do
  begin
    base := off + 32 * i;
    kd := Ord(E^.Txt[i + 1]);
    EmitExpr(E^.Args[i]);
    if FArm then
    begin
      if kd = VrAnsiString then
      begin
        StFP('x0', base + 8);
        StFP('x2', base + 16);
      end
      else if kd = VrQuad then
      begin
        StFP('x0', base + 16);
        StFP('x2', base + 24);
      end
      else
        StFP('x0', base + 8);
      Imm('x9', kd);
      StFP('x9', base);
    end
    else
    begin
      if kd = VrAnsiString then
      begin
        Line('  movq %rax, ' + IntToStr(base + 8) + '(%rbp)');
        Line('  movq %rdx, ' + IntToStr(base + 16) + '(%rbp)');
      end
      else if kd = VrQuad then
      begin
        Line('  movq %rax, ' + IntToStr(base + 16) + '(%rbp)');
        Line('  movq %rdx, ' + IntToStr(base + 24) + '(%rbp)');
      end
      else
        Line('  movq %rax, ' + IntToStr(base + 8) + '(%rbp)');
      Line('  movq $' + IntToStr(kd) + ', ' + IntToStr(base) + '(%rbp)');
    end;
  end;
  if FArm then
  begin
    AddFP('x0', off);
    Imm('x2', n);
    Imm('x3', n);
  end
  else
  begin
    Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
    Line('  movq $' + IntToStr(n) + ', %rdx');
    Line('  movq $' + IntToStr(n) + ', %r8');
  end;
end;

{ K for C = 2^K, -1 when C is not a power of two. }
function Pow2Log(C: Int64): LongInt;
var
  k: LongInt;
begin
  Result := -1;
  if (C <= 0) or ((C and (C - 1)) <> 0) then
    Exit;
  k := 0;
  while (C shr k) <> 1 do
    Inc(k);
  Result := k;
end;

{ The routine has Self, the first argument: a method, but a static class
  method (P123), which has none. }
function HasSelf(const Pr: TProc): Boolean;
begin
  Result := (Pr.ClassTyp <> 0) and not Pr.NoSelf;
end;

function TEmitter.TSize(Id: LongInt): LongInt;
begin
  if TKind(Id) = tykClass then
  begin
    Result := 8;
    Exit;
  end;
  if (Id < 0) or (Id > High(FTypes)) then
    Result := 8
  else
    Result := FTypes[Id].Size;
  if Result <= 0 then
    Result := 8;
end;

{ The size of the value E loads: its stored type's (LoadTyp), so a
  dereference loads the pointed-to size even after Ord has widened the
  node, and a ^Char reads one byte. }
function TEmitter.LoadSize(E: PExpr): LongInt;
begin
  Result := TSize(LoadTyp(E));
end;

function TEmitter.SlotSize(Id: LongInt): LongInt;
begin
  if TKind(Id) = tykClass then
    Result := 8
  else if (TKind(Id) = tykMethod) or (TKind(Id) = tykProc) then
    Result := 16
  else
    Result := TSize(Id);
end;

function TEmitter.TKind(Id: LongInt): TTypeKind;
begin
  if (Id < 0) or (Id > High(FTypes)) then
    Result := tykNone
  else
    Result := FTypes[Id].Kind;
end;

function TEmitter.IsStr(Id: LongInt): Boolean;
begin
  Result := TKind(Id) = tykString;
end;

function TEmitter.IsDyn(Id: LongInt): Boolean;
begin
  Result := (TKind(Id) = tykArray) and (FTypes[Id].Hi < FTypes[Id].Lo);
end;

function TEmitter.IsFat(Id: LongInt): Boolean;
begin
  Result := IsStr(Id) or IsDyn(Id) or (TKind(Id) = tykMethod) or
    (TKind(Id) = tykInterface) or (TKind(Id) = tykQuad) or (TKind(Id) = tykProc);
end;

{ A global's alignment: 16 when a Quad is in it, as C's _Float128
  (1.0.115); else 8. }
function TEmitter.GlobAlign(Id: LongInt): LongInt;
var
  i: SizeInt;
begin
  Result := 8;
  if TKind(Id) = tykQuad then
    Result := 16
  else if TKind(Id) = tykRecord then
  begin
    for i := 0 to High(FTypes[Id].Fields) do
      if GlobAlign(FTypes[Id].Fields[i].Typ) = 16 then
        Result := 16;
  end
  else if (TKind(Id) = tykArray) and not IsDyn(Id) then
  begin
    Result := GlobAlign(FTypes[Id].Elem);
    { a table of 16 bytes or more sits on 16 (1.1.1), so a kernel may
      take it as a vector operand (paddd K(%rax) in SHA-256) }
    if TSize(Id) >= 16 then
      Result := 16;
  end;
end;

function HexWord(V: Int64): string;
var
  i, d: LongInt;
begin
  Result := '';
  for i := 15 downto 0 do
  begin
    d := LongInt((V shr (i * 4)) and 15);
    if d < 10 then
      Result := Result + Char(48 + d)
    else
      Result := Result + Char(87 + d);
  end;
  Result := '0x' + Result;
end;

{ V is a logical immediate of arm64's and, orr, eor and tst (P290): as
  DecodeBitMasks decodes it (ARM DDI 0487 M.c J1.2.3.19), an element of
  2, 4, 8, 16, 32 or 64 bits repeated across the word, the element a run
  of ones, rotated, that neither is empty nor fills it. }
function ArmLogImm(V: Int64): Boolean;
var
  size, i: LongInt;
  mask, e, x: Int64;
begin
  Result := False;
  if (V = 0) or (V = -1) then
    Exit;
  size := 64;
  while size > 2 do
  begin
    i := size div 2;
    mask := (Int64(1) shl i) - 1;
    if (V and mask) <> ((V shr i) and mask) then
      Break;
    size := i;
  end;
  if size = 64 then
    mask := -1
  else
    mask := (Int64(1) shl size) - 1;
  e := V and mask;
  for i := 0 to size - 1 do
  begin
    if i = 0 then
      x := e
    else
      x := ((e shr i) or (e shl (size - i))) and mask;
    if (x <> 0) and (x <> mask) and ((x and (x + 1)) = 0) then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

{ arm64: the lines that put V in Reg as Go's assembler does
  (cmd/internal/obj/arm64/asm7.go: con64class and omovlconst, MOVD of a
  constant 4 to 16 bytes, never a literal), joined by line feeds (P315):
  one MOV when MOVZ, MOVN or ORR of a bitmask takes V (the assembler's
  MOV aliases, ARM DDI 0487 M.c C6.2.280, C6.2.279 and C6.2.281; ORR
  (immediate) C6.2.301); MOVZ of the first halfword that is not 0 and a
  MOVK of the other such one when two are 0, MOVN of the first that is
  not 0xffff and a MOVK when two are 0xffff (C6.2.285, C6.2.284,
  C6.2.283); ORR of a bitmask that differs from V in one halfword, the
  rest of V rotated by 16 or 32 into it, and a MOVK of that halfword;
  else MOVZ or MOVN and two MOVKs when one halfword is 0 or 0xffff, and
  MOVZ and three MOVKs. On Neoverse N1 a MOVZ, MOVN or MOVK takes 1
  cycle, 3 a cycle, and a load of a literal 4 (arm-neoverse-n1-sog 3.8
  and 3.9), and the literal waits in the pool behind the code. }
function ArmImmText(const Reg: string; V: Int64): string;
var
  h: array[0..3] of Int64;
  i, j, zc, nc, r: LongInt;
  x, mask, rv: Int64;

  function MovK(k: LongInt): string;
  begin
    Result := Char(10) + '  movk ' + Reg + ', #' + IntToStr(h[k]) + ', lsl #' + IntToStr(16 * k);
  end;

begin
  zc := 0;
  nc := 0;
  for i := 0 to 3 do
  begin
    h[i] := (V shr (16 * i)) and 65535;
    if h[i] = 0 then
      Inc(zc)
    else if h[i] = 65535 then
      Inc(nc);
  end;
  if (zc >= 3) or (nc >= 3) or ArmLogImm(V) then
  begin
    Result := '  mov ' + Reg + ', #' + IntToStr(V);
    Exit;
  end;
  if zc = 2 then
  begin
    Result := '';
    for i := 0 to 3 do
      if h[i] <> 0 then
      begin
        if Result = '' then
          Result := '  movz ' + Reg + ', #' + IntToStr(h[i]) + ', lsl #' + IntToStr(16 * i)
        else
          Result := Result + MovK(i);
      end;
    Exit;
  end;
  if nc = 2 then
  begin
    Result := '';
    for i := 0 to 3 do
      if h[i] <> 65535 then
      begin
        if Result = '' then
          Result := '  movn ' + Reg + ', #' + IntToStr(65535 - h[i]) + ', lsl #' + IntToStr(16 * i)
        else
          Result := Result + MovK(i);
      end;
    Exit;
  end;
  for i := 0 to 3 do
  begin
    mask := Int64(65535) shl (16 * i);
    for j := 0 to 1 do
    begin
      r := 16 * (j + 1);
      rv := (V shl r) or (V shr (64 - r));
      x := (V and not mask) or (rv and mask);
      if ArmLogImm(x) then
      begin
        Result := '  orr ' + Reg + ', xzr, #' + IntToStr(x) + MovK(i);
        Exit;
      end;
    end;
  end;
  if zc = 1 then
  begin
    Result := '';
    for i := 0 to 3 do
      if h[i] <> 0 then
      begin
        if Result = '' then
          Result := '  movz ' + Reg + ', #' + IntToStr(h[i]) + ', lsl #' + IntToStr(16 * i)
        else
          Result := Result + MovK(i);
      end;
    Exit;
  end;
  if nc = 1 then
  begin
    Result := '';
    for i := 0 to 3 do
      if h[i] <> 65535 then
      begin
        if Result = '' then
          Result := '  movn ' + Reg + ', #' + IntToStr(65535 - h[i]) + ', lsl #' + IntToStr(16 * i)
        else
          Result := Result + MovK(i);
      end;
    Exit;
  end;
  Result := '  movz ' + Reg + ', #' + IntToStr(h[0]) + MovK(1) + MovK(2) + MovK(3);
end;

{ ---- Sets (P126) ----

  A set of up to 64 elements is one word, bit n the element whose ordinal
  is n; one of up to 256, 32 bytes, a block as a record is, whose
  expression gives its address. Union, intersection and difference of
  two of 32 bytes are one ymm instruction on a processor with AVX2 (-cpu,
  vpor, vpand, vpandn), two SSE2 ones otherwise, two NEON ones on arm64
  (orr, and, bic); = is a compare, <= a subset (vptest's CF on AVX2 and
  SSE4.1: the second operand and not the first is empty). x in s tests
  the bit, and an x out of the set's range is in no set. }

{ The label of the constant set of 32 bytes whose words are W, one in
  .rodata for each distinct value. }
function TEmitter.SetConst(const W: TInt64Arr): string;
var
  img: string;
  i: SizeInt;
begin
  img := Copy(HexWord(W[0]), 3, 16) + Copy(HexWord(W[1]), 3, 16) +
    Copy(HexWord(W[2]), 3, 16) + Copy(HexWord(W[3]), 3, 16);
  for i := 0 to High(FSetImgs) do
    if FSetImgs[i] = img then
    begin
      Result := '.Lsetc' + IntToStr(i);
      Exit;
    end;
  i := Length(FSetImgs);
  SetLength(FSetImgs, i + 1);
  FSetImgs[i] := img;
  Result := '.Lsetc' + IntToStr(i);
end;

{ The element in rax or x0 lies in set type T's range, or the program
  stops: paslang: set element N out of range [LO..HI] at line L. }
procedure TEmitter.EmitSetCheck(T: LongInt);
var
  lo, hi: Int64;
  ok: string;
begin
  lo := FTypes[T].Lo;
  hi := FTypes[T].Hi;
  ok := Lab;
  if FArm then
  begin
    if lo = 0 then
      Line('  cmp x0, #' + IntToStr(hi))
    else
    begin
      Line('  sub x9, x0, #' + IntToStr(lo));
      Line('  cmp x9, #' + IntToStr(hi - lo));
    end;
    ColdBegin('  b.hi');
    Imm('x1', lo);
    Imm('x2', hi);
    Line('  bl rt_setfail');
    ColdEnd;
  end
  else
  begin
    if lo = 0 then
      Line('  cmpq $' + IntToStr(hi) + ', %rax')
    else
    begin
      Line('  movq %rax, %rcx');
      Line('  subq $' + IntToStr(lo) + ', %rcx');
      Line('  cmpq $' + IntToStr(hi - lo) + ', %rcx');
    end;
    ColdBegin('  ja');
    Line('  movq %rax, %rdi');
    Line('  movq $' + IntToStr(lo) + ', %rsi');
    Line('  movq $' + IntToStr(hi) + ', %rdx');
    Line('  call rt_setfail');
    ColdEnd;
  end;
  Line(ok + ':');
end;

{ [a, b..c] of a set of 32 bytes: its address. All constant, the set in
  .rodata; else a scratch region cleared and each element's bit set,
  each element checked against the set's range. }
procedure TEmitter.EmitWSetLit(E: PExpr);
var
  i: SizeInt;
  allc: Boolean;
  bits: TInt64Arr;
  lo, hi, v, one: Int64;
  off: LongInt;
  a, b, c, d: string;
begin
  allc := True;
  for i := 0 to High(E^.Args) do
    if E^.Args[i]^.Kind = ekRange then
    begin
      if (E^.Args[i]^.L^.Kind <> ekInt) or (E^.Args[i]^.R^.Kind <> ekInt) then
        allc := False;
    end
    else if E^.Args[i]^.Kind <> ekInt then
      allc := False;
  if allc then
  begin
    bits := nil;
    SetLength(bits, 4);
    for i := 0 to 3 do
      bits[i] := 0;
    one := 1;
    for i := 0 to High(E^.Args) do
    begin
      if E^.Args[i]^.Kind = ekRange then
      begin
        lo := E^.Args[i]^.L^.Num;
        hi := E^.Args[i]^.R^.Num;
      end
      else
      begin
        lo := E^.Args[i]^.Num;
        hi := lo;
      end;
      v := lo;
      while v <= hi do
      begin
        bits[v shr 6] := bits[v shr 6] or (one shl (v and 63));
        v := v + 1;
      end;
    end;
    if FArm then
      LeaS(SetConst(bits), 'x0')
    else
      Line('  leaq ' + SetConst(bits) + '(%rip), %rax');
    Exit;
  end;
  off := ScratchT(32, E^.Typ);
  if FArm then
  begin
    AddFP('x11', off);
    Line('  stp xzr, xzr, [x11]');
    Line('  stp xzr, xzr, [x11, #16]');
  end
  else
  begin
    Line('  pxor %xmm0, %xmm0');
    Line('  movdqu %xmm0, ' + IntToStr(off) + '(%rbp)');
    Line('  movdqu %xmm0, ' + IntToStr(off + 16) + '(%rbp)');
  end;
  for i := 0 to High(E^.Args) do
    if E^.Args[i]^.Kind = ekRange then
    begin
      EmitExpr(E^.Args[i]^.L);
      if E^.Args[i]^.L^.Kind <> ekInt then
        EmitSetCheck(E^.Typ);
      if FArm then
        PshK('x0', 0)
      else
        PushK('rax', 0);
      EmitExpr(E^.Args[i]^.R);
      if E^.Args[i]^.R^.Kind <> ekInt then
        EmitSetCheck(E^.Typ);
      { lo..hi a word at a time: the first word from lo's bit up,
        the whole words between, the last up to hi's bit }
      a := Lab;
      b := Lab;
      c := Lab;
      d := Lab;
      if FArm then
      begin
        Line('  mov x14, x0');
        Ppop('x15');
        Line('  cmp x15, x14');
        Line('  b.gt ' + b);
        AddFP('x11', off);
        Line('  lsr x9, x15, #6');
        Line('  lsr x10, x14, #6');
        Line('  mov x12, #-1');
        Line('  lsl x12, x12, x15');
        Line('  mov x13, #-2');
        Line('  lsl x13, x13, x14');
        Line('  mvn x13, x13');
        Line('  cmp x9, x10');
        Line('  b.ne ' + a);
        Line('  and x12, x12, x13');
        Line('  ldr x14, [x11, x9, lsl #3]');
        Line('  orr x14, x14, x12');
        Line('  str x14, [x11, x9, lsl #3]');
        Line('  b ' + b);
        Line(a + ':');
        Line('  ldr x14, [x11, x9, lsl #3]');
        Line('  orr x14, x14, x12');
        Line('  str x14, [x11, x9, lsl #3]');
        Line('  mov x12, #-1');
        Line(c + ':');
        Line('  add x9, x9, #1');
        Line('  cmp x9, x10');
        Line('  b.hs ' + d);
        Line('  str x12, [x11, x9, lsl #3]');
        Line('  b ' + c);
        Line(d + ':');
        Line('  ldr x14, [x11, x10, lsl #3]');
        Line('  orr x14, x14, x13');
        Line('  str x14, [x11, x10, lsl #3]');
        Line(b + ':');
      end
      else
      begin
        Line('  movq %rax, %r8');
        Line('  popq %rcx');
        Line('  cmpq %r8, %rcx');
        Line('  jg ' + b);
        Line('  movq %rcx, %rdx');
        Line('  shrq $6, %rdx');
        Line('  movq %r8, %r9');
        Line('  shrq $6, %r9');
        Line('  movq $-1, %rax');
        Line('  shlq %cl, %rax');
        Line('  movq %r8, %rcx');
        Line('  movq $-2, %r10');
        Line('  shlq %cl, %r10');
        Line('  notq %r10');
        Line('  cmpq %rdx, %r9');
        Line('  jne ' + a);
        Line('  andq %r10, %rax');
        Line('  orq %rax, ' + IntToStr(off) + '(%rbp,%rdx,8)');
        Line('  jmp ' + b);
        Line(a + ':');
        Line('  orq %rax, ' + IntToStr(off) + '(%rbp,%rdx,8)');
        Line(c + ':');
        Line('  incq %rdx');
        Line('  cmpq %r9, %rdx');
        Line('  jae ' + d);
        Line('  movq $-1, ' + IntToStr(off) + '(%rbp,%rdx,8)');
        Line('  jmp ' + c);
        Line(d + ':');
        Line('  orq %r10, ' + IntToStr(off) + '(%rbp,%r9,8)');
        Line(b + ':');
      end;
    end
    else
    begin
      EmitExpr(E^.Args[i]);
      if E^.Args[i]^.Kind <> ekInt then
        EmitSetCheck(E^.Typ);
      if FArm then
      begin
        AddFP('x11', off);
        Line('  lsr x9, x0, #6');
        Line('  and x10, x0, #63');
        Line('  ldr x12, [x11, x9, lsl #3]');
        Line('  mov x13, #1');
        Line('  lsl x13, x13, x10');
        Line('  orr x12, x12, x13');
        Line('  str x12, [x11, x9, lsl #3]');
      end
      else
      begin
        { bts of a register (its bit mod 64), not of memory, whose bit
          string form is the slow one }
        Line('  movq %rax, %rdx');
        Line('  shrq $6, %rdx');
        Line('  xorl %r8d, %r8d');
        Line('  btsq %rax, %r8');
        Line('  orq %r8, ' + IntToStr(off) + '(%rbp,%rdx,8)');
      end;
    end;
  if FArm then
    AddFP('x0', off)
  else
    Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
end;

{ A set's operation (EmitExpr): x in s, and s op t of two sets. }
procedure TEmitter.EmitSetBin(E: PExpr);
var
  wide, avx, sse41, bmi: Boolean;
  op: TBinOp;
  dst: LongInt;
  a, cc, sub, sup: string;
begin
  op := E^.Bin;
  avx := (not FArm) and HasFeat(CpuFeatBit('avx2', False));
  sse41 := (not FArm) and HasFeat(CpuFeatBit('sse41', False));
  bmi := (not FArm) and HasFeat(CpuFeatBit('bmi1', False));
  if op = boIn then
  begin
    { the element, unsigned against the set's last bit: an element out
      of it, negative too, is in no set }
    wide := IsWSet(E^.R^.Typ);
    EmitExpr(E^.L);
    if FArm then
      PshK('x0', 0)
    else
      PushK('rax', 0);
    EmitExpr(E^.R);
    a := Lab;
    if FArm then
    begin
      Ppop('x1');
      Line('  mov x2, xzr');
      if wide then
        Line('  cmp x1, #255')
      else
        Line('  cmp x1, #63');
      Line('  b.hi ' + a);
      if wide then
      begin
        Line('  lsr x9, x1, #6');
        Line('  ldr x0, [x0, x9, lsl #3]');
      end;
      Line('  lsr x9, x0, x1');
      Line('  and x2, x9, #1');
      Line(a + ':');
      Line('  mov x0, x2');
    end
    else
    begin
      Line('  popq %rcx');
      Line('  xorl %edx, %edx');
      if wide then
        Line('  cmpq $255, %rcx')
      else
        Line('  cmpq $63, %rcx');
      Line('  ja ' + a);
      if wide then
      begin
        Line('  movq %rcx, %r8');
        Line('  shrq $6, %r8');
        Line('  movq (%rax,%r8,8), %rax');
      end;
      Line('  btq %rcx, %rax');
      Line('  setc %dl');
      Line(a + ':');
      Line('  movq %rdx, %rax');
    end;
    Exit;
  end;
  wide := IsWSet(E^.L^.Typ);
  EmitExpr(E^.L);
  if FArm then
    PshK('x0', VCls(E^.L^.Typ, 0))
  else
    PushK('rax', VCls(E^.L^.Typ, 0));
  EmitExpr(E^.R);
  if not wide then
  begin
    { a word: L in rcx or x1, R in rax or x0 }
    if FArm then
    begin
      Ppop('x1');
      case op of
        boAdd: Line('  orr x0, x1, x0');
        boSub: Line('  bic x0, x1, x0');
        boMul: Line('  and x0, x1, x0');
        boEq, boNe:
          begin
            Line('  cmp x1, x0');
            if op = boEq then
              Line('  cset x0, eq')
            else
              Line('  cset x0, ne');
          end;
        boLe, boGe:
          begin
            if op = boLe then
              Line('  bic x9, x1, x0')
            else
              Line('  bic x9, x0, x1');
            Line('  cmp x9, #0');
            Line('  cset x0, eq');
          end;
      end;
    end
    else
    begin
      Line('  popq %rcx');
      case op of
        boAdd: Line('  orq %rcx, %rax');
        boSub:
          if bmi then
            Line('  andnq %rcx, %rax, %rax')
          else
          begin
            Line('  notq %rax');
            Line('  andq %rcx, %rax');
          end;
        boMul: Line('  andq %rcx, %rax');
        boEq, boNe:
          begin
            Line('  xorl %edx, %edx');
            Line('  cmpq %rax, %rcx');
            if op = boEq then
              Line('  sete %dl')
            else
              Line('  setne %dl');
            Line('  movq %rdx, %rax');
          end;
        boLe, boGe:
          begin
            { L <= R: L and not R is empty; L >= R: R and not L; andn
              sets ZF by what it leaves (BMI1) }
            Line('  xorl %edx, %edx');
            if bmi and (op = boLe) then
              Line('  andnq %rcx, %rax, %rax')
            else if bmi then
              Line('  andnq %rax, %rcx, %rax')
            else
            begin
              if op = boLe then
              begin
                Line('  notq %rax');
                Line('  andq %rcx, %rax');
              end
              else
              begin
                Line('  notq %rcx');
                Line('  andq %rcx, %rax');
              end;
              Line('  testq %rax, %rax');
            end;
            Line('  sete %dl');
            Line('  movq %rdx, %rax');
          end;
      end;
    end;
    Exit;
  end;
  { 32 bytes: L's address in rcx or x1, R's in rax or x0 }
  if FArm then
  begin
    Ppop('x1');
    Line('  ldp q0, q1, [x1]');
    Line('  ldp q2, q3, [x0]');
    case op of
      boAdd, boSub, boMul:
        begin
          if op = boAdd then
            cc := 'orr'
          else if op = boSub then
            cc := 'bic'
          else
            cc := 'and';
          Line('  ' + cc + ' v0.16b, v0.16b, v2.16b');
          Line('  ' + cc + ' v1.16b, v1.16b, v3.16b');
          dst := ScratchT(32, E^.Typ);
          AddFP('x9', dst);
          Line('  stp q0, q1, [x9]');
          AddFP('x0', dst);
        end;
      boEq, boNe, boLe, boGe:
        begin
          if (op = boEq) or (op = boNe) then
          begin
            Line('  eor v0.16b, v0.16b, v2.16b');
            Line('  eor v1.16b, v1.16b, v3.16b');
          end
          else if op = boLe then
          begin
            Line('  bic v0.16b, v0.16b, v2.16b');
            Line('  bic v1.16b, v1.16b, v3.16b');
          end
          else
          begin
            Line('  bic v0.16b, v2.16b, v0.16b');
            Line('  bic v1.16b, v3.16b, v1.16b');
          end;
          Line('  orr v0.16b, v0.16b, v1.16b');
          Line('  umov x9, v0.d[0]');
          Line('  umov x10, v0.d[1]');
          Line('  orr x9, x9, x10');
          Line('  cmp x9, #0');
          if op = boNe then
            Line('  cset x0, ne')
          else
            Line('  cset x0, eq');
        end;
    end;
    Exit;
  end;
  Line('  popq %rcx');
  case op of
    boAdd, boSub, boMul:
      begin
        dst := ScratchT(32, E^.Typ);
        if avx then
        begin
          if op = boSub then
          begin
            Line('  vmovdqu (%rax), %ymm1');
            Line('  vpandn (%rcx), %ymm1, %ymm0');
          end
          else
          begin
            Line('  vmovdqu (%rcx), %ymm0');
            if op = boAdd then
              Line('  vpor (%rax), %ymm0, %ymm0')
            else
              Line('  vpand (%rax), %ymm0, %ymm0');
          end;
          Line('  vmovdqu %ymm0, ' + IntToStr(dst) + '(%rbp)');
          Line('  vzeroupper');
        end
        else
        begin
          Line('  movdqu (%rcx), %xmm0');
          Line('  movdqu 16(%rcx), %xmm1');
          Line('  movdqu (%rax), %xmm2');
          Line('  movdqu 16(%rax), %xmm3');
          if op = boAdd then
          begin
            Line('  por %xmm2, %xmm0');
            Line('  por %xmm3, %xmm1');
          end
          else if op = boMul then
          begin
            Line('  pand %xmm2, %xmm0');
            Line('  pand %xmm3, %xmm1');
          end
          else
          begin
            { pandn: dst = not dst and src }
            Line('  pandn %xmm0, %xmm2');
            Line('  pandn %xmm1, %xmm3');
            Line('  movdqa %xmm2, %xmm0');
            Line('  movdqa %xmm3, %xmm1');
          end;
          Line('  movdqu %xmm0, ' + IntToStr(dst) + '(%rbp)');
          Line('  movdqu %xmm1, ' + IntToStr(dst + 16) + '(%rbp)');
        end;
        Line('  leaq ' + IntToStr(dst) + '(%rbp), %rax');
      end;
    boEq, boNe:
      begin
        if avx then
        begin
          Line('  vmovdqu (%rcx), %ymm0');
          Line('  vpxor (%rax), %ymm0, %ymm0');
          Line('  xorl %eax, %eax');
          Line('  vptest %ymm0, %ymm0');
          if op = boEq then
            Line('  setz %al')
          else
            Line('  setnz %al');
          Line('  vzeroupper');
        end
        else
        begin
          Line('  movdqu (%rcx), %xmm0');
          Line('  movdqu 16(%rcx), %xmm1');
          Line('  movdqu (%rax), %xmm2');
          Line('  movdqu 16(%rax), %xmm3');
          Line('  pcmpeqb %xmm2, %xmm0');
          Line('  pcmpeqb %xmm3, %xmm1');
          Line('  pand %xmm1, %xmm0');
          Line('  pmovmskb %xmm0, %edx');
          Line('  xorl %eax, %eax');
          Line('  cmpl $65535, %edx');
          if op = boEq then
            Line('  sete %al')
          else
            Line('  setne %al');
        end;
      end;
    boLe, boGe:
      begin
        { L <= R: (V)PTEST R, L sets CF when L and not R is empty; for
          >= the operands swap: sub the one that is in, sup the other }
        if op = boGe then
        begin
          sub := 'rax';
          sup := 'rcx';
        end
        else
        begin
          sub := 'rcx';
          sup := 'rax';
        end;
        if avx then
        begin
          Line('  vmovdqu (%' + sup + '), %ymm1');
          Line('  xorl %edx, %edx');
          Line('  vptest (%' + sub + '), %ymm1');
          Line('  setc %dl');
          Line('  vzeroupper');
          Line('  movq %rdx, %rax');
        end
        else if sse41 then
        begin
          Line('  movdqu (%' + sup + '), %xmm2');
          Line('  movdqu 16(%' + sup + '), %xmm3');
          Line('  movdqu (%' + sub + '), %xmm0');
          Line('  movdqu 16(%' + sub + '), %xmm1');
          Line('  xorl %edx, %edx');
          Line('  pandn %xmm0, %xmm2');
          Line('  pandn %xmm1, %xmm3');
          Line('  por %xmm3, %xmm2');
          Line('  ptest %xmm2, %xmm2');
          Line('  setz %dl');
          Line('  movq %rdx, %rax');
        end
        else
        begin
          Line('  movdqu (%' + sup + '), %xmm2');
          Line('  movdqu 16(%' + sup + '), %xmm3');
          Line('  movdqu (%' + sub + '), %xmm0');
          Line('  movdqu 16(%' + sub + '), %xmm1');
          Line('  pandn %xmm0, %xmm2');
          Line('  pandn %xmm1, %xmm3');
          Line('  por %xmm3, %xmm2');
          Line('  pxor %xmm4, %xmm4');
          Line('  pcmpeqb %xmm4, %xmm2');
          Line('  pmovmskb %xmm2, %edx');
          Line('  xorl %eax, %eax');
          Line('  cmpl $65535, %edx');
          Line('  sete %al');
        end;
      end;
  end;
end;

{ rax or x0 and M, the word of a set's range (P126): a run of ones, a
  logical immediate on arm64. }
procedure TEmitter.SetAndWord(M: Int64);
begin
  if M = -1 then
    Exit;
  if FArm then
  begin
    if M = 0 then
      Line('  mov x0, xzr')
    else
      Line('  and x0, x0, #' + HexWord(M));
  end
  else if M = 0 then
    Line('  xorl %eax, %eax')
  else if (M >= -2147483648) and (M <= 2147483647) then
    Line('  andq $' + IntToStr(M) + ', %rax')
  else
  begin
    Line('  movabsq $' + IntToStr(M) + ', %rcx');
    Line('  andq %rcx, %rax');
  end;
end;

{ A set made one of another range of its kind (P126, rt_setconv): the
  elements outside the new range dropped, as FPC does, the word widened
  to 32 bytes or the 32 bytes narrowed to their first word; a range
  that holds the old one keeps every bit. }
procedure TEmitter.EmitSetConv(E: PExpr);
var
  src, dst, off, i: LongInt;
  m: TInt64Arr;
  v: Int64;
  full: Boolean;
  mlab: string;
begin
  src := E^.Args[0]^.Typ;
  dst := E^.Typ;
  EmitExpr(E^.Args[0]);
  full := (FTypes[dst].Lo <= FTypes[src].Lo) and (FTypes[dst].Hi >= FTypes[src].Hi);
  m := nil;
  SetLength(m, 4);
  for i := 0 to 3 do
    m[i] := 0;
  v := FTypes[dst].Lo;
  while v <= FTypes[dst].Hi do
  begin
    m[v shr 6] := m[v shr 6] or (Int64(1) shl (v and 63));
    v := v + 1;
  end;
  if (not IsWSet(src)) and (not IsWSet(dst)) then
  begin
    if not full then
      SetAndWord(m[0]);
  end
  else if not IsWSet(dst) then
  begin
    if FArm then
      Line('  ldr x0, [x0]')
    else
      Line('  movq (%rax), %rax');
    SetAndWord(m[0]);
  end
  else if not IsWSet(src) then
  begin
    if not full then
      SetAndWord(m[0]);
    off := ScratchT(32, dst);
    if FArm then
    begin
      AddFP('x9', off);
      Line('  stp x0, xzr, [x9]');
      Line('  stp xzr, xzr, [x9, #16]');
      AddFP('x0', off);
    end
    else
    begin
      Line('  xorl %ecx, %ecx');
      Line('  movq %rax, ' + IntToStr(off) + '(%rbp)');
      Line('  movq %rcx, ' + IntToStr(off + 8) + '(%rbp)');
      Line('  movq %rcx, ' + IntToStr(off + 16) + '(%rbp)');
      Line('  movq %rcx, ' + IntToStr(off + 24) + '(%rbp)');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
    end;
  end
  else if not full then
  begin
    { 32 bytes and the range's 32, from .rodata }
    mlab := SetConst(m);
    off := ScratchT(32, dst);
    if FArm then
    begin
      Line('  ldp q0, q1, [x0]');
      LeaS(mlab, 'x9');
      Line('  ldp q2, q3, [x9]');
      Line('  and v0.16b, v0.16b, v2.16b');
      Line('  and v1.16b, v1.16b, v3.16b');
      AddFP('x0', off);
      Line('  stp q0, q1, [x0]');
    end
    else
    begin
      if HasFeat(CpuFeatBit('avx2', False)) then
      begin
        Line('  vmovdqu (%rax), %ymm0');
        Line('  vpand ' + mlab + '(%rip), %ymm0, %ymm0');
        Line('  vmovdqu %ymm0, ' + IntToStr(off) + '(%rbp)');
        Line('  vzeroupper');
      end
      else
      begin
        Line('  movdqu (%rax), %xmm0');
        Line('  movdqu 16(%rax), %xmm1');
        Line('  pand ' + mlab + '(%rip), %xmm0');
        Line('  pand ' + mlab + '+16(%rip), %xmm1');
        Line('  movdqu %xmm0, ' + IntToStr(off) + '(%rbp)');
        Line('  movdqu %xmm1, ' + IntToStr(off + 16) + '(%rbp)');
      end;
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
    end;
  end;
end;

{ Include(s, x) and Exclude(s, x) of a set (P126): x checked against
  the set's range, then its bit set or cleared in the word of s it is
  in, one load and one store (bts and btr of a register, orr and bic
  of a mask); a constant x names its word and bit. }
procedure TEmitter.EmitSetIncl(E: PExpr);
var
  incl: Boolean;
  st: LongInt;
  x: PExpr;
  w, b: Int64;
  m: string;
begin
  st := E^.Args[0]^.L^.Typ;
  x := E^.Args[1];
  incl := E^.Args[2]^.Num = 1;
  if x^.Kind = ekInt then
  begin
    w := x^.Num shr 6;
    b := x^.Num and 63;
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      if incl then
        m := HexWord(Int64(1) shl b)
      else
        m := HexWord(not (Int64(1) shl b));
      Line('  ldr x9, [x0, #' + IntToStr(w * 8) + ']');
      if incl then
        Line('  orr x9, x9, #' + m)
      else
        Line('  and x9, x9, #' + m);
      Line('  str x9, [x0, #' + IntToStr(w * 8) + ']');
    end
    else if incl then
      Line('  btsq $' + IntToStr(b) + ', ' + IntToStr(w * 8) + '(%rax)')
    else
      Line('  btrq $' + IntToStr(b) + ', ' + IntToStr(w * 8) + '(%rax)');
    Exit;
  end;
  EmitExpr(x);
  EmitSetCheck(st);
  if FArm then
    PshK('x0', 0)
  else
    PushK('rax', 0);
  EmitExpr(E^.Args[0]);
  if FArm then
  begin
    Ppop('x1');
    if IsWSet(st) then
    begin
      Line('  lsr x9, x1, #6');
      Line('  add x0, x0, x9, lsl #3');
    end;
    Line('  ldr x2, [x0]');
    Line('  mov x9, #1');
    Line('  lsl x9, x9, x1');
    if incl then
      Line('  orr x2, x2, x9')
    else
      Line('  bic x2, x2, x9');
    Line('  str x2, [x0]');
  end
  else
  begin
    Line('  popq %rcx');
    if IsWSet(st) then
    begin
      Line('  movq %rcx, %rdx');
      Line('  shrq $6, %rdx');
      Line('  leaq (%rax,%rdx,8), %rax');
    end;
    Line('  movq (%rax), %rdx');
    if incl then
      Line('  btsq %rcx, %rdx')
    else
      Line('  btrq %rcx, %rdx');
    Line('  movq %rdx, (%rax)');
  end;
end;

{ for x in s: a copy of the set on the stack with the word it is at and
  that word's bits left, so the body may change s, and break and continue
  work as in any loop: the lowest bit left is the next element (tzcnt on
  BMI1, bsf before; rbit and clz on arm64), cleared before the body. }
procedure TEmitter.EmitSetFor(S: PStmt);
var
  wide, bmi: Boolean;
  nw: LongInt;
  next, have, done: string;
begin
  wide := IsWSet(S^.E^.Typ);
  if wide then
    nw := 4
  else
    nw := 1;
  bmi := (not FArm) and HasFeat(CpuFeatBit('bmi1', False));
  next := Lab;
  have := Lab;
  done := Lab;
  EmitExpr(S^.E);
  if FArm then
  begin
    MapHint4(0, 0, 0, 0);
    Line('  sub sp, sp, #32');
    MapHint2(0, 0);
    Line('  sub sp, sp, #16');
    if wide then
    begin
      Line('  ldp q0, q1, [x0]');
      Line('  stp q0, q1, [sp]');
    end
    else
      Line('  str x0, [sp]');
    Line('  str xzr, [sp, #32]');
    Line('  ldr x9, [sp]');
    Line('  str x9, [sp, #40]');
    PushLoop(done, next);
    Line(next + ':');
    Line('  ldr x9, [sp, #40]');
    Line('  cbnz x9, ' + have);
    Line('  ldr x10, [sp, #32]');
    Line('  add x10, x10, #1');
    Line('  cmp x10, #' + IntToStr(nw));
    Line('  b.ge ' + done);
    Line('  str x10, [sp, #32]');
    Line('  ldr x9, [sp, x10, lsl #3]');
    Line('  str x9, [sp, #40]');
    Line('  b ' + next);
    Line(have + ':');
    Line('  rbit x11, x9');
    Line('  clz x11, x11');
    Line('  sub x12, x9, #1');
    Line('  and x9, x9, x12');
    Line('  str x9, [sp, #40]');
    Line('  ldr x10, [sp, #32]');
    Line('  add x0, x11, x10, lsl #6');
    StoreVar(S^.Name);
    EmitStmt(S^.Body);
    Line('  b ' + next);
    Line(done + ':');
    Line('  add sp, sp, #48');
  end
  else
  begin
    MapHint4(0, 0, 0, 0);
    Line('  subq $32, %rsp');
    MapHint2(0, 0);
    Line('  subq $16, %rsp');
    if wide then
    begin
      Line('  movdqu (%rax), %xmm0');
      Line('  movdqu 16(%rax), %xmm1');
      Line('  movdqu %xmm0, (%rsp)');
      Line('  movdqu %xmm1, 16(%rsp)');
    end
    else
      Line('  movq %rax, (%rsp)');
    Line('  movq $0, 32(%rsp)');
    Line('  movq (%rsp), %rax');
    Line('  movq %rax, 40(%rsp)');
    PushLoop(done, next);
    Line(next + ':');
    Line('  movq 40(%rsp), %rax');
    Line('  testq %rax, %rax');
    Line('  jnz ' + have);
    Line('  movq 32(%rsp), %rcx');
    Line('  incq %rcx');
    Line('  cmpq $' + IntToStr(nw) + ', %rcx');
    Line('  jge ' + done);
    Line('  movq %rcx, 32(%rsp)');
    Line('  movq (%rsp,%rcx,8), %rax');
    Line('  movq %rax, 40(%rsp)');
    Line('  jmp ' + next);
    Line(have + ':');
    if bmi then
    begin
      Line('  tzcntq %rax, %rcx');
      Line('  blsrq %rax, %rax');
    end
    else
    begin
      Line('  bsfq %rax, %rcx');
      Line('  leaq -1(%rax), %rdx');
      Line('  andq %rdx, %rax');
    end;
    Line('  movq %rax, 40(%rsp)');
    Line('  movq 32(%rsp), %rax');
    Line('  shlq $6, %rax');
    Line('  addq %rcx, %rax');
    StoreVar(S^.Name);
    EmitStmt(S^.Body);
    Line('  jmp ' + next);
    Line(done + ':');
    Line('  addq $48, %rsp');
  end;
  PopLoop;
end;

function TEmitter.IsBlob(Id: LongInt): Boolean;
begin
  Result := (TKind(Id) = tykRecord) or
    ((TKind(Id) = tykArray) and (not IsDyn(Id))) or IsWSet(Id);
end;

{ A set of 32 bytes (P126), a block: an expression of one gives its
  address. }
function TEmitter.IsWSet(Id: LongInt): Boolean;
begin
  Result := (TKind(Id) = tykSet) and (Id >= 0) and (Id <= High(FTypes)) and
    (FTypes[Id].Size = 32);
end;

{ Scratch slots for temporaries live below the locals and grow down;
  the high-water mark sizes the frame, which the prologue names by a
  symbol set after the body (P92). Before that every frame carried a
  fixed 2 KB zone, so a routine with no locals reserved 2 KB and a new
  routine's first stack (3840 bytes) could not hold two of them: every
  spawned routine grew its stack once, three system calls each. }
function TEmitter.Scratch(Sz: LongInt): LongInt;
var
  i, n: SizeInt;
begin
  Sz := Align8(Sz);
  if Sz < 8 then
    Sz := 8;
  FScratchCur := FScratchCur + Sz;
  if FPinned + FScratchCur > FScratchMax then
    FScratchMax := FPinned + FScratchCur;
  Result := FScratchOff - FPinned - FScratchCur;
  { The words the statement holds here, for the stack maps (P95c), of
    the class FScrHint says, 2 when nothing does. }
  n := Length(FScrOff);
  SetLength(FScrOff, n + Sz div 8);
  SetLength(FScrK, n + Sz div 8);
  for i := 0 to Sz div 8 - 1 do
  begin
    FScrOff[n + i] := Result + 8 * LongInt(i);
    if Length(FScrHintW) > 0 then
    begin
      if i < Length(FScrHintW) then
        FScrK[n + i] := FScrHintW[i]
      else
        FScrK[n + i] := 0;
    end
    else
      FScrK[n + i] := FScrHint;
  end;
  FScrHint := 2;
  SetLength(FScrHintW, 0);
end;

{ cmpq of rax with a constant, through rcx when it is beyond the 32-bit
  immediate cmpq takes (a case label, 1.0.78). }
procedure TEmitter.CaseCmp(V: Int64);
begin
  if (V >= -2147483648) and (V <= 2147483647) then
    Line('  cmpq $' + IntToStr(V) + ', %rax')
  else
  begin
    Line('  movabsq $' + IntToStr(V) + ', %rcx');
    Line('  cmpq %rcx, %rax');
  end;
end;

{ A string being stored (rax/rdx, x0/x2) now has two holders: its
  characters are marked shared, so a write through either copies them
  first (1.0.82). A string just made (a literal, a concatenation, Copy,
  Chr) has no other holder and is left alone. So is what a Pascal
  routine or method returns (P221): every way into Result is a store
  that marks a string another variable holds (an assignment, Exit(v), a
  var argument's store, a nested routine's store, a loop variable,
  TryGet since P227), a closure may not share it, an asm block binds no
  string, and no routine of the core units writes a string's words by
  hand. A routine put in place returns a scalar (pasopt Inlinable), so
  no string passes through its hidden Result. A call of the runtime
  (rt_mapget, rt_treeget, ...) gives what a container keeps and is
  marked. }
procedure TEmitter.ShareStr;
var
  l: string;
  e: PExpr;
begin
  e := FStoreSrc;
  if (e <> nil) and ((e^.Kind = ekStr) or ((e^.Kind = ekBin) and (e^.Bin = boConcat)) or
    ((e^.Kind = ekCall) and ((e^.Name = 'rt_copy') or (e^.Name = 'rt_chstr') or
    (e^.Name = 'rt_strcopy') or (Copy(e^.Name, 1, 2) = 'p_'))) or (e^.Kind = ekMethod)) then
    Exit;
  l := '.shm' + IntToStr(FLab);
  Inc(FLab);
  if FArm then
  begin
    Line('  cbz x2, ' + l);
    Line('  ldurb w9, [x0, #-1]');
    Line('  tbnz w9, #0, ' + l);
    Line('  orr w9, w9, #1');
    Line('  sturb w9, [x0, #-1]');
  end
  else
  begin
    Line('  testq %rdx, %rdx');
    Line('  jz ' + l);
    Line('  testb $1, -1(%rax)');
    Line('  jnz ' + l);
    Line('  orb $1, -1(%rax)');
  end;
  Line(l + ':');
end;

{ A channel carries one word. A value that is not one (a string, a
  record, an array, an interface) travels in a box: a copy on the heap,
  the channel carries its address (1.0.83; a chan of string received
  the pointer word alone, an empty string). }
function TEmitter.ChanBoxed(ChanTyp: LongInt): Boolean;
var
  el: LongInt;
begin
  Result := False;
  if TKind(ChanTyp) <> tykChan then
    Exit;
  el := FTypes[ChanTyp].Elem;
  Result := IsFat(el) or IsBlob(el);
end;

{ E's value copied into a new box of type T; the box in rax / x0. }
procedure TEmitter.EmitBox(E: PExpr; T: LongInt);
var
  smap, l: string;
begin
  EmitExpr(E);
  if IsFat(T) then
  begin
    if IsStr(T) then
      ShareStrOf(E);
    if FArm then
    begin
      if IsDyn(T) then
        PshK('x3', VCls(T, 2));
      PshK('x2', VCls(T, 1));
      PshK('x0', VCls(T, 0));
      Imm('x0', TSize(T));
      GcArg(GcWord(T), 'x1');
      Line('  bl rt_alloc');
      Ppop('x1');
      Line('  str x1, [x0]');
      Ppop('x1');
      Line('  str x1, [x0, #8]');
      if IsDyn(T) then
      begin
        Ppop('x1');
        Line('  str x1, [x0, #16]');
      end;
    end
    else
    begin
      if IsDyn(T) then
        PushK('r8', VCls(T, 2));
      PushK('rdx', VCls(T, 1));
      PushK('rax', VCls(T, 0));
      Line('  movq $' + IntToStr(TSize(T)) + ', %rdi');
      GcArg(GcWord(T), 'rsi');
      Line('  call rt_alloc');
      Line('  popq %rcx');
      Line('  movq %rcx, (%rax)');
      Line('  popq %rcx');
      Line('  movq %rcx, 8(%rax)');
      if IsDyn(T) then
      begin
        Line('  popq %rcx');
        Line('  movq %rcx, 16(%rax)');
      end;
    end;
    Exit;
  end;
  { A record or an array: its address; 0 is the zero value, which the
    new box already is. }
  smap := StrMap(T);
  l := '.bxz' + IntToStr(FLab);
  Inc(FLab);
  if FArm then
  begin
    PshK('x0', 2);
    Imm('x0', TSize(T));
    GcArg(GcWord(T), 'x1');
    Line('  bl rt_alloc');
    Ppop('x1');
    PshK('x0', 1);
    Line('  cbz x1, ' + l);
    Imm('x2', TSize(T));
    Line('  bl rt_memcpy');
    if smap <> '' then
    begin
      Line('  ldr x0, [sp]');
      LeaS(smap, 'x1');
      Line('  bl rt_strshare');
    end;
    Line(l + ':');
    Ppop('x0');
  end
  else
  begin
    PushK('rax', 2);
    Line('  movq $' + IntToStr(TSize(T)) + ', %rdi');
    GcArg(GcWord(T), 'rsi');
    Line('  call rt_alloc');
    Line('  popq %rsi');
    PushK('rax', 1);
    Line('  testq %rsi, %rsi');
    Line('  jz ' + l);
    Line('  movq %rax, %rdi');
    Line('  movq $' + IntToStr(TSize(T)) + ', %rcx');
    Line('  call rt_memcpy');
    if smap <> '' then
    begin
      Line('  movq (%rsp), %rdi');
      Line('  leaq ' + smap + '(%rip), %rsi');
      Line('  call rt_strshare');
    end;
    Line(l + ':');
    Line('  popq %rax');
  end;
end;

{ A received box (rax / x0, 0 from a closed channel) as a value of T:
  the words of a string, a record's address (the zero block for 0). }
procedure TEmitter.EmitUnbox(T: LongInt);
var
  z, d: string;
begin
  z := '.ubz' + IntToStr(FLab);
  d := '.ubd' + IntToStr(FLab);
  Inc(FLab);
  if IsFat(T) then
  begin
    if FArm then
    begin
      Line('  cbz x0, ' + z);
      if IsDyn(T) then
        Line('  ldr x3, [x0, #16]');
      Line('  ldr x2, [x0, #8]');
      Line('  ldr x0, [x0]');
      Line('  b ' + d);
      Line(z + ':');
      Line('  mov x2, xzr');
      if IsDyn(T) then
        Line('  mov x3, xzr');
    end
    else
    begin
      Line('  testq %rax, %rax');
      Line('  jz ' + z);
      if IsDyn(T) then
        Line('  movq 16(%rax), %r8');
      Line('  movq 8(%rax), %rdx');
      Line('  movq (%rax), %rax');
      Line('  jmp ' + d);
      Line(z + ':');
      Line('  xorq %rdx, %rdx');
      if IsDyn(T) then
        Line('  xorq %r8, %r8');
    end;
    Line(d + ':');
    Exit;
  end;
  if TSize(T) > FZeroMax then
    FZeroMax := TSize(T);
  if FArm then
  begin
    Line('  cbnz x0, ' + d);
    LeaS('.Lzeroblk', 'x0');
  end
  else
  begin
    Line('  testq %rax, %rax');
    Line('  jnz ' + d);
    Line('  leaq .Lzeroblk(%rip), %rax');
  end;
  Line(d + ':');
end;

procedure TEmitter.ShareStrOf(E: PExpr);
var
  keep: PExpr;
begin
  keep := FStoreSrc;
  FStoreSrc := E;
  ShareStr;
  FStoreSrc := keep;
end;

{ s + a + b without its first operand, s: a + b, the operands in their
  order (P242). }
function TEmitter.StrTail(E: PExpr): PExpr;
begin
  if (E^.L^.Kind = ekBin) and (E^.L^.Bin = boConcat) then
    Result := NewBin(boConcat, StrTail(E^.L), E^.R)
  else
    Result := E^.R;
end;

{ S is s := s + c that EmitStrAppend writes with its fast path in line,
  s a variable of the frame or a global, c a character without a call
  that a region can work out (PromoExprOK): its only call, rt_strappendc's when s's block
  is full or shared, sits after the routine's ret (P300), where the
  registers of a region are stored before it and loaded after it, so a
  loop that appends to a string keeps its variables in registers, as
  Go's placeSpills stores a value in the block that dominates all its
  loads, the slow path's when only its call needs them
  (cmd/compile/internal/ssacompile/regalloc.go) (P301). }
function TEmitter.PromoAppendOK(S: PStmt): Boolean;
var
  d, e, x: PExpr;
  sv: TSym;
begin
  Result := False;
  if (S = nil) or (S^.Kind <> skAssign) then
    Exit;
  d := S^.Dest;
  e := S^.E;
  if (d = nil) or (e = nil) or (not IsStr(d^.Typ)) or (e^.Kind <> ekBin) or
    (e^.Bin <> boConcat) or (e^.L = nil) or (e^.R = nil) then
    Exit;
  if (not SameExpr(d, e^.L)) or (not PlainStr(d, sv)) or EHasCall(d) then
    Exit;
  x := e^.R;
  if EHasCall(x) then
    Exit;
  if (x^.Kind = ekStr) and (Length(x^.Txt) = 1) then
    Result := True
  else
    Result := (not IsStr(x^.Typ)) and (TSize(x^.Typ) = 1) and PromoExprOK(x);
end;

{ S is FillChar(x, n, v) with x a variable of the frame or a global and
  n and v without a call. On amd64 its one call, rt_fillbig's past 256
  KiB, sits after the ret (P300) and keeps every register but rcx and
  rdi; on arm64 rt_fill keeps every one but x0, x1, x3 and v31, and
  rt_fillbig every one but x0, x1 and v31. A region keeps no variable
  in those, nor a vector in v31 (v8 to v15), and rt_yieldpoint, where
  rt_fillbig stops between two pieces, keeps every register on the
  routine's stack, where the collector reads them word by word: so a
  loop that clears with FillChar keeps its variables in registers, as
  rt_strunique's write keeps them (P301). }
function TEmitter.PromoFillOK(S: PStmt): Boolean;
var
  a: PExpr;
  sy: TSym;
begin
  Result := False;
  if (S = nil) or (S^.Kind <> skCall) or (S^.E <> nil) or (S^.Name <> 'rt_fillchar') or
    (Length(S^.Args) <> 3) then
    Exit;
  a := S^.Args[0];
  if (a = nil) or (a^.Kind <> ekAddr) or (a^.L = nil) or (a^.L^.Kind <> ekVar) then
    Exit;
  if (not TryFindSym(a^.L^.Name, sy)) or sy.ByRef or (sy.Up <> 0) or sy.Boxed then
    Exit;
  Result := (not EHasCall(S^.Args[1])) and (not EHasCall(S^.Args[2])) and
    PromoExprOK(S^.Args[1]) and PromoExprOK(S^.Args[2]);
end;

{ s := s + x, or s += x, for a string place s whose address calls no
  routine (P242): the whole statement, as rt_strappend makes it, which
  writes x after s's characters in their own block when it has room
  and stores only the new length, so a string built a piece at a time
  copies itself now and then, not at every piece (twenty million
  s := s + c did not end in ten minutes; Go's s += c copies too,
  concatstrings, and strings.Builder is its amortized way). s is read
  first and x worked out next, as the concatenation does; s + a + b
  appends a + b, made in their order. The place's address comes last,
  as StoreTo takes it, and rt_strappend writes in place only when the
  place still holds the string read first; the string it stores is
  s's own block or a new one, unmarked as a concatenation's. A
  character that calls no routine cannot change s, so s is read after
  it, and rt_strappendc's first checks are written here: the place
  holds characters, their mark is clear and their class known (shr
  leaves the mark in CF and the class with ZF, SDM vol. 2B SAL/SAR/
  SHL/SHR; TBNZ and LSR on arm64, ARM ARM C6.2.478 and C6.2.273), and
  the class's bytes (rt_class2size, rt_strbig after it) hold one more;
  then the byte and the length are stored, and nothing is called. }
function TEmitter.EmitStrAppend(S: PStmt): Boolean;
var
  d, e, l, x: PExpr;
  ch: Boolean;
  slow, done: string;
  sv: TSym;
begin
  Result := False;
  d := S^.Dest;
  e := S^.E;
  if (d = nil) or (e = nil) or (not IsStr(d^.Typ)) or (e^.Kind <> ekBin) or
    (e^.Bin <> boConcat) or EHasCall(d) then
    Exit;
  l := e;
  while (l^.Kind = ekBin) and (l^.Bin = boConcat) do
    l := l^.L;
  if not SameExpr(d, l) then
    Exit;
  Result := True;
  x := StrTail(e);
  ch := (x^.Kind = ekStr) and (Length(x^.Txt) = 1);
  if (not EHasCall(x)) and (ch or not IsStr(x^.Typ)) then
  begin
    slow := Lab;
    done := Lab;
    if FArm then
    begin
      if ch then
      begin
        EmitAddr(d);
        Imm('x3', Ord(x^.Txt[1]));
      end
      else if FPromoOn and OrdSimple(x, 0) then
      begin
        { c straight into x3 in a region whose pool holds it, with no
          push (P301); else EmitExpr, which reads a region's variables
          in their registers and pushes what the pool cannot hold }
        EmitOrdTo(x, 0);
        Line('  mov x3, ' + OrdPool(0));
        EmitAddr(d);
      end
      else
      begin
        EmitExpr(x);
        PshK('x0', 0);
        EmitAddr(d);
        Ppop('x3');
      end;
      Line('  ldp x1, x2, [x0]');
      Line('  cbz x2, ' + slow);
      Line('  ldurb w9, [x1, #-1]');
      { slow is after the ret since P300, past a TBNZ's 32 KiB }
      Line('  tst w9, #1');
      Line('  b.ne ' + slow);
      Line('  lsr w9, w9, #1');
      Line('  cbz w9, ' + slow);
      LeaS('rt_class2size', 'x10');
      Line('  ldr x10, [x10, x9, lsl #3]');
      Line('  add x11, x2, #2');
      Line('  cmp x11, x10');
      Line('  b.hi ' + slow);
      Line('  strb w3, [x1, x2]');
      Line('  add x2, x2, #1');
      Line('  str x2, [x0, #8]');
      { the block full or shared: out of line, back to done (P300) }
      ColdBeginAt('', slow);
      { a region's registers to their homes and back around the call;
        x19 to x26 are callee-saved (P301) }
      PromoSpill;
      Line('  bl rt_strappendc');
      PromoReload;
      Line('  b ' + done);
      ColdEnd;
      Line(done + ':');
    end
    else if PlainStr(d, sv) then
    begin
      { A variable of the frame or a global: its words are operands, so
        the character stays in eax, nothing waits on the stack and the
        length goes back from rdx. }
      if ch then
        Line('  movl $' + IntToStr(Ord(x^.Txt[1])) + ', %eax')
      else
        EmitExpr(x);
      Line('  movq ' + StrWordA(sv, 0) + ', %rsi');
      Line('  movq ' + StrWordA(sv, 8) + ', %rdx');
      Line('  testq %rdx, %rdx');
      Line('  jz ' + slow);
      { rcx, r8 and rdi, free between two statements: a region lends r9
        and r10 to variables and keeps a for's run end in r11 (P301); r8
        is lent only in a region of integer arithmetic alone }
      if FPromoOn and FR8Lent then
        Die('internal error: r8 lent in a region that appends to a string');
      Line('  movzbl -1(%rsi), %ecx');
      Line('  shrl $1, %ecx');
      Line('  jbe ' + slow);
      Line('  leaq rt_class2size(%rip), %r8');
      Line('  leaq 2(%rdx), %rdi');
      Line('  cmpq (%r8,%rcx,8), %rdi');
      Line('  ja ' + slow);
      Line('  movb %al, (%rsi,%rdx)');
      Line('  incq %rdx');
      Line('  movq %rdx, ' + StrWordA(sv, 8));
      ColdBeginAt('', slow);
      { a region's registers to their homes and back around the call,
        and the end of a for's run (r11), which the call does not keep
        (P301) }
      PromoSpill;
      if FPromoOn and (FChunkReg <> '') then
        PushK(FChunkReg, 0);
      Line('  movl %eax, %ecx');
      Line('  leaq ' + StrWordA(sv, 0) + ', %rdi');
      Line('  call rt_strappendc');
      if FPromoOn and (FChunkReg <> '') then
        Line('  popq %' + FChunkReg);
      PromoReload;
      Line('  jmp ' + done);
      ColdEnd;
      Line(done + ':');
    end
    else
    begin
      if ch then
      begin
        EmitAddr(d);
        Line('  movl $' + IntToStr(Ord(x^.Txt[1])) + ', %ecx');
      end
      else
      begin
        EmitExpr(x);
        PushK('rax', 0);
        EmitAddr(d);
        Line('  popq %rcx');
      end;
      Line('  movq (%rax), %rsi');
      Line('  movq 8(%rax), %rdx');
      Line('  testq %rdx, %rdx');
      Line('  jz ' + slow);
      Line('  movzbl -1(%rsi), %r9d');
      Line('  shrl $1, %r9d');
      Line('  jbe ' + slow);
      Line('  leaq rt_class2size(%rip), %r10');
      Line('  leaq 2(%rdx), %r11');
      Line('  cmpq (%r10,%r9,8), %r11');
      Line('  ja ' + slow);
      Line('  movb %cl, (%rsi,%rdx)');
      Line('  incq 8(%rax)');
      ColdBeginAt('', slow);
      Line('  movq %rax, %rdi');
      Line('  call rt_strappendc');
      Line('  jmp ' + done);
      ColdEnd;
      Line(done + ':');
    end;
    Exit;
  end;
  EmitExpr(d);
  if FArm then
  begin
    PshK('x2', VCls(d^.Typ, 1));
    PshK('x0', VCls(d^.Typ, 0));
    EmitExpr(x);
    if IsStr(x^.Typ) then
    begin
      PshK('x2', VCls(x^.Typ, 1));
      PshK('x0', VCls(x^.Typ, 0));
      EmitAddr(d);
      Ppop('x3');
      Ppop('x4');
      Ppop('x1');
      Ppop('x2');
      Line('  bl rt_strappend');
    end
    else
    begin
      PshK('x0', 0);
      EmitAddr(d);
      Ppop('x3');
      Ppop('x1');
      Ppop('x2');
      Line('  bl rt_strappendc');
    end;
  end
  else
  begin
    PushK('rdx', VCls(d^.Typ, 1));
    PushK('rax', VCls(d^.Typ, 0));
    EmitExpr(x);
    if IsStr(x^.Typ) then
    begin
      PushK('rdx', VCls(x^.Typ, 1));
      PushK('rax', VCls(x^.Typ, 0));
      EmitAddr(d);
      Line('  movq %rax, %rdi');
      Line('  popq %rcx');
      Line('  popq %r8');
      Line('  popq %rsi');
      Line('  popq %rdx');
      Line('  call rt_strappend');
    end
    else
    begin
      PushK('rax', 0);
      EmitAddr(d);
      Line('  movq %rax, %rdi');
      Line('  popq %rcx');
      Line('  popq %rsi');
      Line('  popq %rdx');
      Line('  call rt_strappendc');
    end;
  end;
end;

{ The strings inside a value of type T at Base: runs (offset, count,
  stride) of string descriptors (1.0.82). A string in a record's variant
  part shares its words with other fields, so they may hold anything: it
  was left out, and r2 := r1 then shared its characters unmarked, so
  r2.s[1] := 'X' changed r1 (1.0.136). Now it is a checked run, its
  count negative: rt_strshare marks it only when the words are a string
  of the heap (PasStrBlock). A field of any type that overlaps another
  is checked throughout. }
procedure TEmitter.StrRuns(T, Base: LongInt; var R: TInt64Arr);
begin
  StrRunsCk(T, Base, False, R);
end;

procedure TEmitter.StrRunsCk(T, Base: LongInt; Ck: Boolean; var R: TInt64Arr);
var
  td: TTypeDef;
  i, j, k, n, es, lo, hi: LongInt;
  inner: TInt64Arr;
  alone: Boolean;
  procedure Add(O, C, St: Int64);
  var
    m: SizeInt;
  begin
    m := Length(R);
    SetLength(R, m + 3);
    R[m] := O;
    R[m + 1] := C;
    R[m + 2] := St;
  end;
begin
  if IsStr(T) then
  begin
    if Ck then
      Add(Base, -1, 0)
    else
      Add(Base, 1, 0);
    Exit;
  end;
  td := FTypes[T];
  if td.Kind = tykRecord then
  begin
    for i := 0 to High(td.Fields) do
    begin
      alone := True;
      lo := td.Fields[i].Off;
      hi := lo + TSize(td.Fields[i].Typ);
      for k := 0 to High(td.Fields) do
        if (k <> i) and (td.Fields[k].Off < hi) and
          (td.Fields[k].Off + TSize(td.Fields[k].Typ) > lo) then
          alone := False;
      StrRunsCk(td.Fields[i].Typ, Base + td.Fields[i].Off, Ck or (not alone), R);
    end;
  end
  else if (td.Kind = tykArray) and (not IsDyn(T)) and (td.Hi >= td.Lo) then
  begin
    n := LongInt(td.Hi - td.Lo + 1);
    es := TSize(td.Elem);
    inner := nil;
    StrRunsCk(td.Elem, 0, Ck, inner);
    i := 0;
    while i + 2 <= High(inner) do
    begin
      if inner[i + 1] = 1 then
        Add(Base + inner[i], n, es)
      else if inner[i + 1] = -1 then
        Add(Base + inner[i], -n, es)
      else
        for j := 0 to n - 1 do
          Add(Base + j * es + inner[i], inner[i + 1], inner[i + 2]);
      i := i + 3;
    end;
  end;
end;

{ The label of T's string map in .rodata, '' when T holds no string. }
function TEmitter.StrMap(T: LongInt): string;
var
  r: TInt64Arr;
  i: SizeInt;
begin
  Result := '';
  r := nil;
  StrRuns(T, 0, r);
  if Length(r) = 0 then
    Exit;
  Result := '.Lsmap' + IntToStr(T);
  for i := 0 to High(FStrMaps) do
    if FStrMaps[i] = T then
      Exit;
  SetLength(FStrMaps, Length(FStrMaps) + 1);
  FStrMaps[High(FStrMaps)] := T;
end;

{ Scratch for a value of type Typ held in place (a string's pointer and
  length, a slice's three words, a method's code and data, a key): each
  word's class by the type (P95c). }
function TEmitter.ScratchT(Sz, Typ: LongInt): LongInt;
var
  bits: TGcBits;
  i, w: SizeInt;
  tk: TTypeKind;
begin
  w := Align8(Sz) div 8;
  if w < 1 then
    w := 1;
  bits := nil;
  GcMark(Typ, 0, bits, 0);
  tk := TKind(Typ);
  SetLength(FScrHintW, w);
  for i := 0 to w - 1 do
    if (i < Length(bits)) and bits[i] then
    begin
      if (tk = tykGeneric) or (tk = tykParam) then
        FScrHintW[i] := 2
      else
        FScrHintW[i] := 1;
    end
    else
      FScrHintW[i] := 0;
  Result := Scratch(Sz);
end;

{ The bytes a routine's check asks for below its frame and the words it
  pushes under the frame (P342): what the runtime code it calls adds
  without a check of its own, its deepest chain proved within them for
  every program by scripts/check_stack.py, as Go's linker proves its
  nosplit chains within stackGuard (cmd/link/internal/ld/stackcheck.go). }
function TEmitter.RedZone: LongInt;
begin
  if FArm then
    Result := 832
  else
    Result := 512;
end;

{ The bytes a stop writes below the stack pointer of the code it stops
  (P342): on amd64 the return address, the flags (rt_asyncpreempt's),
  10 general registers and the vector block's word, and .pk_res's five
  words, whose rbx, r12, r13 and r15 come back from there; on arm64 the 16 the signal handler (or rt_yieldpoint) stores,
  30 registers, the flags, FPSR and the block's word in 256, and .pk_res's
  96. rt_sigurg stops a routine and rt_yieldpoint stops only with these
  bytes above the real guard, as Go's isAsyncSafePoint asks
  asyncPreemptStack (runtime/preempt.go); scripts/check_stack.py --async
  proves that every routine of the pasasync table has them wherever it
  runs and that the two write no more. }
function TEmitter.AsyncRoom: LongInt;
begin
  if FArm then
    Result := 16 + 256 + 96
  else
    Result := 8 + 8 + 88 + 40;
end;

{ The bytes of a stop's vector block: ymm0-ymm15 with AVX, xmm0-xmm15
  else, q0-q31 on arm64. }
function TEmitter.XBlock: LongInt;
begin
  if FArm or HasFeat(CpuFeatBit('avx', False)) then
    Result := 512
  else
    Result := 256;
end;

{ The frame of the routine just emitted: locals plus the scratch high-water
  mark, rounded to 16, at least 16; its check's bytes take the words it
  pushed below it too (P342). }
procedure TEmitter.SetFrame(const Sym: string; Locals: LongInt);
var
  f: LongInt;
begin
  f := (Locals + FScratchMax + 15) and (-16);
  if f < 16 then
    f := 16;
  { The negative word is .Lfn<sym>, a prefix and not a suffix: a suffix
    n made RandRange's word collide with the routine RandRangeN. }
  if FArm then
  begin
    { the size into the prologue's and the check's SUBs (P308) }
    FixFrameArm(Sym, f);
    { The literals of this routine's ldr =imm go right after it: one
      pool at the end of the text was more than the 1 MB an ldr reaches
      once the compiler's own emitter grew past it (1.0.51). }
    Line('  .ltorg');
  end
  else
  begin
    Line('.set ' + Sym + ', ' + IntToStr(f));
    Line('.set .Lpu' + Copy(Sym, 5, Length(Sym) - 4) + ', ' + IntToStr(8 * FPushMax));
  end;
  MapEnd(f);
end;

{ Bytes (a multiple of 8) of the frame from Off up start as zero. Up to
  sixteen words are plain stores: rep stosq costs tens of cycles to
  start, the whole of a small routine (P94). }
procedure TEmitter.ZeroFrame(Off, Bytes: LongInt);
var
  k, n: LongInt;
  a, b: string;
begin
  n := Bytes div 8;
  if n <= 0 then
    Exit;
  if FArm then
  begin
    if (n <= 16) and (Off >= -256) and (Off + 8 * (n - 1) <= 255) then
    begin
      for k := 0 to n - 1 do
        Line('  stur xzr, [x29, #' + IntToStr(Off + 8 * k) + ']');
      Exit;
    end;
    AddFP('x16', Off);
    Imm('x17', n);
    { a frame past 256 KiB a piece at a time (P271), the arguments
      still in x0 to x7 kept }
    if Bytes > 262144 then
    begin
      Line('  bl rt_zerobig');
      Exit;
    end;
    { 16 bytes a store (P272), the odd word first; x16 and x17 alone, the
      arguments still in x0 to x7 }
    a := Lab;
    b := Lab;
    Line('  tbz x17, #0, ' + a);
    Line('  str xzr, [x16], #8');
    Line('  sub x17, x17, #1');
    Line(a + ':');
    Line('  cbz x17, ' + b);
    Line('  stp xzr, xzr, [x16], #16');
    Line('  sub x17, x17, #2');
    Line('  b ' + a);
    Line(b + ':');
    Exit;
  end;
  if n <= 16 then
  begin
    for k := 0 to n - 1 do
      Line('  movq $0, ' + IntToStr(Off + 8 * k) + '(%rbp)');
    Exit;
  end;
  Line('  leaq ' + IntToStr(Off) + '(%rbp), %rdi');
  if Bytes > 262144 then
  begin
    { a frame past 256 KiB a piece at a time (P271) }
    Line('  movq $' + IntToStr(Bytes) + ', %rcx');
    Line('  xorl %eax, %eax');
    Line('  call rt_fillbig');
    Exit;
  end;
  Line('  movq $' + IntToStr(n) + ', %rcx');
  Line('  xorq %rax, %rax');
  Line('  rep stosq');
end;

{ GC types (P95a, docs/GC.md). Every allocation tells the heap what the
  block holds: '0' no pointer at all, '1' any word may be one (GetMem),
  or the label of a descriptor: the element size in bytes, the number k
  of mask words, then k words where bit i of word j says that word
  64j+i of the element holds a heap pointer. The collector tiles the
  element over the block, so an array allocates with its element's
  descriptor. A variant record marks the words of every variant: a
  word the collector takes for a pointer is only a candidate, checked
  against the heap. }
procedure SetGcBit(var W: TGcBits; I: LongInt);
var
  n, k: SizeInt;
begin
  if I < 0 then
    Exit;
  n := Length(W);
  if I >= n then
  begin
    SetLength(W, I + 1);
    for k := n to I do
      W[k] := False;
  end;
  W[I] := True;
end;

procedure TEmitter.GcMark(Id, W0: LongInt; var W: TGcBits; Depth: LongInt);
var
  i, es, n: LongInt;
  e: TGcBits;
begin
  if Depth > 32 then
    Exit;
  case TKind(Id) of
    tykString, tykPointer, tykClass, tykChan, tykMap, tykTree, tykHeap,
    tykStore, tykJson, tykInterface:
      SetGcBit(W, W0);
    tykMethod, tykProc:
      SetGcBit(W, W0 + 1);
    tykArray:
      if IsDyn(Id) then
        SetGcBit(W, W0)
      else
      begin
        es := TSize(FTypes[Id].Elem);
        e := nil;
        GcMark(FTypes[Id].Elem, 0, e, Depth + 1);
        if GcAny(e) and (es mod 8 = 0) then
        begin
          n := LongInt(FTypes[Id].Hi - FTypes[Id].Lo) + 1;
          for i := 0 to n - 1 do
            GcMark(FTypes[Id].Elem, W0 + i * (es div 8), W, Depth + 1);
        end;
      end;
    tykRecord:
      for i := 0 to High(FTypes[Id].Fields) do
        if FTypes[Id].Fields[i].Off mod 8 = 0 then
          GcMark(FTypes[Id].Fields[i].Typ, W0 + FTypes[Id].Fields[i].Off div 8, W,
            Depth + 1);
    tykGeneric, tykParam:
      { Not known here: every word may hold one. }
      for i := 0 to (TSize(Id) + 7) div 8 - 1 do
        SetGcBit(W, W0 + i);
  end;
end;

function TEmitter.GcAny(const W: TGcBits): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  for i := 0 to High(W) do
    if W[i] then
    begin
      Result := True;
      Exit;
    end;
end;

{ The GC word of a block of type Id, or of an array of Id: '0' or a
  descriptor label this object file writes. }
function TEmitter.GcWord(Id: LongInt): string;
var
  w: TGcBits;
  i: SizeInt;
begin
  if (TKind(Id) = tykArray) and (not IsDyn(Id)) then
  begin
    Result := GcWord(FTypes[Id].Elem);
    Exit;
  end;
  w := nil;
  GcMark(Id, 0, w, 0);
  if not GcAny(w) then
  begin
    Result := '0';
    Exit;
  end;
  Result := '.Lgct' + IntToStr(Id);
  for i := 0 to High(FGcTypes) do
    if FGcTypes[i] = Id then
      Exit;
  i := Length(FGcTypes);
  SetLength(FGcTypes, i + 1);
  FGcTypes[i] := Id;
end;

{ The GC word of an instance of class Id: word 0 is the VMT, which is
  not on the heap; the fields, inherited ones included, start at 8. }
function TEmitter.GcWordInst(Id: LongInt): string;
var
  w: TGcBits;
  i: SizeInt;
begin
  w := nil;
  for i := 0 to High(FTypes[Id].Fields) do
    if FTypes[Id].Fields[i].Off mod 8 = 0 then
      GcMark(FTypes[Id].Fields[i].Typ, FTypes[Id].Fields[i].Off div 8, w, 1);
  if not GcAny(w) then
  begin
    Result := '0';
    Exit;
  end;
  Result := '.Lgci' + IntToStr(Id);
  for i := 0 to High(FGcInst) do
    if FGcInst[i] = Id then
      Exit;
  i := Length(FGcInst);
  SetLength(FGcInst, i + 1);
  FGcInst[i] := Id;
end;

{ Load a GC word into the argument register Reg (rsi or r8, x1 or x4). }
procedure TEmitter.GcArg(const W, Reg: string);
begin
  if W = '0' then
  begin
    if FArm then
      Line('  mov ' + Reg + ', xzr')
    else
      Line('  xorq %' + Reg + ', %' + Reg);
  end
  else if W = '1' then
  begin
    if FArm then
      Line('  mov ' + Reg + ', #1')
    else
      Line('  movq $1, %' + Reg);
  end
  else if FArm then
    LeaS(W, Reg)
  else
    Line('  leaq ' + W + '(%rip), %' + Reg);
end;

procedure TEmitter.EmitGcDesc(const Sym, Name: string; Size: LongInt; const W: TGcBits);
var
  k, j, i: LongInt;
  v: Int64;
  masks: string;
begin
  k := (LongInt(Length(W)) + 63) div 64;
  masks := '';
  Line('.balign 8');
  Line(Sym + ':');
  Line('  .quad ' + IntToStr(Size));
  Line('  .quad ' + IntToStr(k));
  for j := 0 to k - 1 do
  begin
    v := 0;
    for i := 0 to 63 do
      if (j * 64 + i <= High(W)) and W[j * 64 + i] then
        v := v or (Int64(1) shl i);
    Line('  .quad ' + HexWord(v));
    masks := masks + ' ' + HexWord(v);
  end;
  { The line a test greps: the name, the size, the mask words. }
  Line('/* gctype ' + Name + ' size ' + IntToStr(Size) + ' words ' + IntToStr(k) +
    ' mask' + masks + ' */');
end;

procedure TEmitter.EmitGcTypes;
var
  i, j: SizeInt;
  w: TGcBits;
begin
  for i := 0 to High(FGcTypes) do
  begin
    w := nil;
    GcMark(FGcTypes[i], 0, w, 0);
    EmitGcDesc('.Lgct' + IntToStr(FGcTypes[i]), FTypes[FGcTypes[i]].Name,
      TSize(FGcTypes[i]), w);
  end;
  for i := 0 to High(FGcInst) do
  begin
    w := nil;
    for j := 0 to High(FTypes[FGcInst[i]].Fields) do
      if FTypes[FGcInst[i]].Fields[j].Off mod 8 = 0 then
        GcMark(FTypes[FGcInst[i]].Fields[j].Typ,
          FTypes[FGcInst[i]].Fields[j].Off div 8, w, 1);
    EmitGcDesc('.Lgci' + IntToStr(FGcInst[i]), FTypes[FGcInst[i]].Name + ' instance',
      FTypes[FGcInst[i]].Size, w);
  end;
end;

{ No try block entered at loop depth MinDep or deeper is open, so a jump
  to a break, continue or exit label needs no finally code on the way. }
function TEmitter.NoUnwind(MinDep: LongInt): Boolean;
var
  i: SizeInt;
begin
  Result := True;
  for i := 0 to High(FTryDep) do
    if FTryDep[i] >= MinDep then
      Result := False;
end;

{ S is an Exit with no value, a Break or a Continue that leaves through
  no finally: then "if c then S" is one conditional jump (P96). }
function TEmitter.DirectJump(S: PStmt; out Target: string): Boolean;
begin
  Result := False;
  Target := '';
  if (S <> nil) and (S^.Kind = skBlock) and (Length(S^.Stmts) = 1) then
    S := S^.Stmts[0];
  if S = nil then
    Exit;
  if (S^.Kind = skExit) and (S^.E = nil) and NoUnwind(0) then
  begin
    Target := FEpi;
    Result := True;
  end
  else if (S^.Kind = skBreak) and (Length(FBrk) > 0) and
    NoUnwind(LongInt(Length(FBrk))) then
  begin
    Target := FBrk[High(FBrk)];
    Result := True;
  end
  else if (S^.Kind = skContinue) and (Length(FCont) > 0) and
    NoUnwind(LongInt(Length(FBrk))) then
  begin
    Target := FCont[High(FCont)];
    Result := True;
  end;
end;

{ Definite assignment, the plain kind (P96): walking a statement list in
  order, a variable whose first mention is the target of a top-level
  "v := e" that does not read v is written before anything can read
  it. Such a local needs no zero at entry and such a promoted variable
  no load at the start of its region. Anything else that mentions a
  name (a loop, an if, a call, an Inc) marks it touched first. A
  DumpLocals, which reads every local, makes the answer empty. }
function InNames(const L: TStrArray; const N: string): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  for i := 0 to High(L) do
    if L[i] = N then
    begin
      Result := True;
      Exit;
    end;
end;

procedure AddName(var L: TStrArray; const N: string);
var
  k: SizeInt;
begin
  if InNames(L, N) then
    Exit;
  k := Length(L);
  SetLength(L, k + 1);
  L[k] := N;
end;

{ Result and the function's own name are one place. }
function TEmitter.NormName(const N: string): string;
begin
  Result := ToLower(N);
  if FHasRes and (Result = ToLower(FResName)) then
    Result := 'result';
end;

procedure TEmitter.CollectNamesE(E: PExpr; var L: TStrArray);
var
  i: SizeInt;
begin
  if E = nil then
    Exit;
  if E^.Kind = ekVar then
    AddName(L, NormName(E^.Name));
  CollectNamesE(E^.L, L);
  CollectNamesE(E^.R, L);
  for i := 0 to High(E^.Args) do
    CollectNamesE(E^.Args[i], L);
end;

procedure TEmitter.CollectNames(S: PStmt; var L: TStrArray);
var
  i: SizeInt;
begin
  if S = nil then
    Exit;
  if (S^.Kind = skCall) and (S^.Name = 'rt_dumplocs') then
    FSawDump := True;
  if S^.Name <> '' then
    AddName(L, NormName(S^.Name));
  CollectNamesE(S^.E, L);
  CollectNamesE(S^.E2, L);
  CollectNamesE(S^.Dest, L);
  for i := 0 to High(S^.Args) do
    CollectNamesE(S^.Args[i], L);
  CollectNames(S^.ThenSt, L);
  CollectNames(S^.ElseSt, L);
  CollectNames(S^.Body, L);
  for i := 0 to High(S^.Stmts) do
    CollectNames(S^.Stmts[i], L);
  for i := 0 to High(S^.Arms) do
    CollectNames(S^.Arms[i].Body, L);
  for i := 0 to High(S^.Sels) do
  begin
    CollectNamesE(S^.Sels[i].Chan, L);
    CollectNamesE(S^.Sels[i].ValX, L);
    if S^.Sels[i].Dest <> '' then
      AddName(L, NormName(S^.Sels[i].Dest));
    CollectNames(S^.Sels[i].Body, L);
  end;
end;

function TEmitter.FirstWrites(const L: TStmtArray; A, Z: SizeInt): TStrArray;
var
  k, i: SizeInt;
  st: PStmt;
  w, t, m: TStrArray;
  v: string;
begin
  w := nil;
  t := nil;
  FSawDump := False;
  for k := A to Z do
  begin
    st := L[k];
    if st = nil then
      Continue;
    m := nil;
    if (st^.Kind = skAssign) and ((st^.Dest = nil) or (st^.Dest^.Kind = ekVar)) then
    begin
      CollectNamesE(st^.E, m);
      for i := 0 to High(m) do
        if not InNames(w, m[i]) then
          AddName(t, m[i]);
      if st^.Dest = nil then
        v := NormName(st^.Name)
      else
        v := NormName(st^.Dest^.Name);
      if (not InNames(t, v)) and (not InNames(w, v)) then
        AddName(w, v);
    end
    else
    begin
      CollectNames(st, m);
      for i := 0 to High(m) do
        if not InNames(w, m[i]) then
          AddName(t, m[i]);
    end;
  end;
  if FSawDump then
    w := nil;
  Result := w;
end;

{ The locals of Pr start as zero, except one-word scalars the body
  writes before anything reads them (P96: the leading assignments;
  P112: WritesFirst, every path). A routine with nested
  routines zeroes them all: a nested one may read its parent's local
  before the parent writes it. Adjacent ranges go out as one. }
procedure TEmitter.ZeroLocals(const Pr: TProc; Loc0: LongInt);
var
  i: SizeInt;
  slot, sz, lo, hi: LongInt;
  w: TStrArray;
  children, skip: Boolean;
  k: TTypeKind;
  bits: TGcBits;
begin
  w := nil;
  children := False;
  for i := 0 to High(FProgProcs) do
    if FProgProcs[i].ParentSym = Pr.Sym then
      children := True;
  if (not children) and (Pr.Body <> nil) then
  begin
    if Pr.Body^.Kind = skBlock then
      w := FirstWrites(Pr.Body^.Stmts, 0, High(Pr.Body^.Stmts))
    else
    begin
      SetLength(FTmpStmts, 1);
      FTmpStmts[0] := Pr.Body;
      w := FirstWrites(FTmpStmts, 0, 0);
    end;
  end;
  slot := Loc0;
  lo := 0;
  hi := 0;
  for i := 0 to High(Pr.Locals) do
  begin
    sz := Align8(SlotSize(Pr.Locals[i].Typ));
    slot := slot + sz;
    { a P284 candidate starts as it is (DaSetup) }
    if FDaOn and (DaBit(Pr.Locals[i].Name) <> 0) then
      Continue;
    k := TKind(Pr.Locals[i].Typ);
    skip := (sz = 8) and (not IsFat(Pr.Locals[i].Typ)) and
      (not IsBlob(Pr.Locals[i].Typ)) and (k <> tykReal) and (k <> tykSet) and
      (InNames(w, ToLower(Pr.Locals[i].Name)) or
       ((not children) and (not Pr.Boxing) and (Length(Pr.Shared) = 0) and
        (Pr.Body <> nil) and WritesFirst(Pr.Body, Pr.Locals[i].Name, '')));
    { A pointer starts as nil all the same: a stack map reads it at every
      call, the ones before its first write too (P95c). }
    if skip then
    begin
      bits := nil;
      GcMark(Pr.Locals[i].Typ, 0, bits, 0);
      if GcAny(bits) then
        skip := False;
    end;
    if skip then
      Continue;
    { This local is [-slot, -slot+sz). }
    if (hi > lo) and (-slot + sz = lo) then
      lo := -slot
    else
    begin
      if hi > lo then
        ZeroFrame(lo, hi - lo);
      lo := -slot;
      hi := -slot + sz;
    end;
  end;
  if hi > lo then
    ZeroFrame(lo, hi - lo);
end;

procedure TEmitter.PushLoop(const Brk, Cont: string);
var
  n: SizeInt;
begin
  n := Length(FBrk);
  SetLength(FBrk, n + 1);
  SetLength(FCont, n + 1);
  FBrk[n] := Brk;
  FCont[n] := Cont;
end;

procedure TEmitter.PopLoop;
var
  n: SizeInt;
begin
  n := Length(FBrk);
  if n > 0 then
  begin
    SetLength(FBrk, n - 1);
    SetLength(FCont, n - 1);
  end;
end;

{ A try block that is being emitted. Fin is its finally part, or nil for
  try/except. The loop depth tells Break and Continue which blocks they
  leave. }
procedure TEmitter.PushTry(Fin: PStmt);
var
  n: SizeInt;
begin
  n := Length(FTryFin);
  SetLength(FTryFin, n + 1);
  SetLength(FTryDep, n + 1);
  SetLength(FTryRec, n + 1);
  FTryRec[n] := True;
  FTryFin[n] := Fin;
  FTryDep[n] := LongInt(Length(FBrk));
  { The words pushed with its 32-byte record, for the stack maps: an
    unwind goes back to the depth before the record (P95c). }
  SetLength(FTryPush, n + 1);
  FTryPush[n] := LongInt(Length(FPushK));
end;

{ A handler's body (P122): Fin, its epilogue, runs on an exit, break or
  continue out of it as a finally part does, but there is no try record
  on the G, so a raise from inside passes it by. }
procedure TEmitter.PushEpi(Fin: PStmt);
var
  n: SizeInt;
begin
  PushTry(Fin);
  n := Length(FTryRec);
  FTryRec[n - 1] := False;
end;

procedure TEmitter.PopTry;
var
  n: SizeInt;
begin
  n := Length(FTryFin);
  if n > 0 then
  begin
    SetLength(FTryFin, n - 1);
    SetLength(FTryDep, n - 1);
    SetLength(FTryRec, n - 1);
  end;
  if Length(FTryPush) > 0 then
    SetLength(FTryPush, Length(FTryPush) - 1);
end;

{ Leave the try blocks entered at loop depth MinDep or deeper: pop each
  handler frame from the G, restore the stack pointer the block saved,
  and run its finally part. Exit passes 0, Break and Continue pass the
  depth of their loop. The finally part is emitted again for every jump
  that leaves it, so its labels are fresh each time. }
procedure TEmitter.UnwindTry(MinDep: LongInt);
var
  i, j: SizeInt;
  savedFin: array of PStmt;
  savedDep: array of LongInt;
  savedPush: array of LongInt;
  savedRec: array of Boolean;
  savedK: array of Byte;
  fin: PStmt;
begin
  { The code after the jump this unwind precedes is reached from before
    it: the words pushed then come back at the end (P95c). }
  savedK := nil;
  SetLength(savedK, Length(FPushK));
  for j := 0 to High(FPushK) do
    savedK[j] := FPushK[j];
  i := High(FTryFin);
  while (i >= 0) and (FTryDep[i] >= MinDep) do
  begin
    fin := FTryFin[i];
    { a try record comes off the G and the stack goes back to it; a
      handler's epilogue (P122) has none }
    if (i > High(FTryRec)) or FTryRec[i] then
    begin
      FMapSpOk := True;
      if FArm then
      begin
        Line('  ldr x9, [x28, #224]');
        Line('  ldr x10, [x9]');
        Line('  str x10, [x28, #224]');
        Line('  ldr x10, [x9, #16]');
        Line('  mov sp, x10');
      end
      else
      begin
        Line('  movq 224(%r14), %rax');
        Line('  movq (%rax), %rcx');
        Line('  movq %rcx, 224(%r14)');
        Line('  movq 16(%rax), %rsp');
      end;
      FMapSpOk := False;
      if (i <= High(FTryPush)) and (FTryPush[i] >= 4) and
        (FTryPush[i] - 4 <= Length(FPushK)) then
        SetLength(FPushK, FTryPush[i] - 4);
    end;
    if fin <> nil then
    begin
      savedFin := FTryFin;
      savedDep := FTryDep;
      savedPush := FTryPush;
      savedRec := FTryRec;
      FTryFin := nil;
      FTryDep := nil;
      FTryPush := nil;
      FTryRec := nil;
      SetLength(FTryFin, i);
      SetLength(FTryDep, i);
      SetLength(FTryPush, i);
      SetLength(FTryRec, i);
      for j := 0 to i - 1 do
      begin
        FTryFin[j] := savedFin[j];
        FTryDep[j] := savedDep[j];
        if j <= High(savedPush) then
          FTryPush[j] := savedPush[j];
        if j <= High(savedRec) then
          FTryRec[j] := savedRec[j];
      end;
      EmitStmt(fin);
      FTryFin := savedFin;
      FTryDep := savedDep;
      FTryPush := savedPush;
      FTryRec := savedRec;
    end;
    Dec(i);
  end;
  SetLength(FPushK, Length(savedK));
  for j := 0 to High(savedK) do
    FPushK[j] := savedK[j];
end;

procedure TEmitter.EmitSyscall(const Args: TExprArray);
var
  i, n: SizeInt;
begin
  n := Length(Args);
  if n > 7 then
    Die('syscall: at most 7 arguments');
  if FArm then
  begin
    for i := n - 1 downto 0 do
    begin
      EmitExpr(Args[i]);
      PshK('x0', VCls(Args[i]^.Typ, 0));
    end;
    if n > 0 then
      Ppop('x8');
    if n > 1 then
      Ppop('x0');
    if n > 2 then
      Ppop('x1');
    if n > 3 then
      Ppop('x2');
    if n > 4 then
      Ppop('x3');
    if n > 5 then
      Ppop('x4');
    if n > 6 then
      Ppop('x5');
    Line('  bl rt_syscall');
  end
  else
  begin
    for i := n - 1 downto 0 do
    begin
      EmitExpr(Args[i]);
      PushK('rax', VCls(Args[i]^.Typ, 0));
    end;
    if n > 0 then
      Line('  popq %rax');
    if n > 1 then
      Line('  popq %rdi');
    if n > 2 then
      Line('  popq %rsi');
    if n > 3 then
      Line('  popq %rdx');
    if n > 4 then
      Line('  popq %r10');
    if n > 5 then
      Line('  popq %r8');
    if n > 6 then
      Line('  popq %r9');
    if n = 0 then
      Line('  xorq %rax, %rax');
    { Through the runtime: a routine in a system call does not hold up
      a cycle of the collector (P95b). }
    Line('  call rt_syscall');
  end;
end;

function SameSym(const A, B: string): Boolean;
var
  i: SizeInt;
  ca, cb: Char;
begin
  Result := False;
  if Length(A) <> Length(B) then
    Exit;
  for i := 1 to Length(A) do
  begin
    ca := A[i];
    cb := B[i];
    if (ca >= 'A') and (ca <= 'Z') then
      ca := Char(Ord(ca) + 32);
    if (cb >= 'A') and (cb <= 'Z') then
      cb := Char(Ord(cb) + 32);
    if ca <> cb then
      Exit;
  end;
  Result := True;
end;

function TEmitter.FindSym(const N: string): TSym;
var
  i: SizeInt;
begin
  if FHasRes then
  begin
    if SameSym(N, 'result') or SameSym(N, FResName) then
    begin
      Result.Name := FResName;
      Result.Off := FResOff;
      Result.Global := False;
      Result.Typ := FResTyp;
      Result.Up := 0;
      Result.ByRef := False;
      Result.Reg := FResReg;
      Result.Boxed := False;
      Result.BoxOff := 0;
      Exit;
    end;
  end;
  for i := High(FSym) downto 0 do
    if (not FSym[i].Global) and SameSym(FSym[i].Name, N) then
    begin
      Result := FSym[i];
      Exit;
    end;
  for i := 0 to High(FSym) do
    if SameSym(FSym[i].Name, N) then
    begin
      Result := FSym[i];
      Exit;
    end;
  Die('unknown identifier ' + N);
  Result.Name := N;
  Result.Off := 0;
  Result.Global := False;
  Result.Typ := TyInteger;
  Result.Up := 0;
  Result.ByRef := False;
  Result.Reg := '';
  Result.Boxed := False;
  Result.BoxOff := 0;
end;

procedure TEmitter.LoadGlobals(const Prog: TProgram);
var
  i, n: SizeInt;
begin
  n := Length(Prog.Vars);
  SetLength(FSym, n);
  for i := 0 to n - 1 do
  begin
    FSym[i].Name := GlobName(Prog.Vars[i]);
    FSym[i].Off := 0;
    FSym[i].Global := True;
    FSym[i].Typ := Prog.Vars[i].Typ;
    FSym[i].ByRef := False;
    FSym[i].Up := 0;
    FSym[i].Reg := '';
  end;
end;

procedure TEmitter.EmitAddr(E: PExpr);
var
  was: LongInt;
begin
  OpLineIn(E, was);
  EmitAddr0(E);
  FOpLine := was;
end;

procedure TEmitter.EmitAddr0(E: PExpr);
var
  s: TSym;
  td: TTypeDef;
  esz: LongInt;
  i, sh: LongInt;
  off: LongInt;
  ok, ix: string;
  wr, late: Boolean;
begin
  wr := FAddrWrite;
  FAddrWrite := False;
  if E = nil then
  begin
    if FArm then
      Line('  mov x0, xzr')
    else
      Line('  xorq %rax, %rax');
    Exit;
  end;
  if FArm then
  begin
    case E^.Kind of
      ekVar:
        begin
          s := FindSym(E^.Name);
          if s.Reg <> '' then
            Die('internal error: the address of ' + E^.Name + ' while a loop keeps it in ' + s.Reg);
          if s.ByRef then
          begin
            if s.Global then
              LdS(VarLabel(s.Name), 'x0')
            else if s.Up <= 0 then
              LdFP('x0', s.Off)
            else
            begin
              LdFP('x9', -8);
              for i := 2 to s.Up do
                Line('  ldr x9, [x9, #-8]');
              AddImmArm('x9', 'x9', s.Off);
              Line('  ldr x0, [x9]');
            end;
          end
          else if s.Global then
            LeaS(VarLabel(s.Name), 'x0')
          else if s.Up <= 0 then
          begin
            AddFP('x0', s.Off);
          end
          else
          begin
            LdFP('x9', -8);
            for i := 2 to s.Up do
              Line('  ldr x9, [x9, #-8]');
            AddImmArm('x0', 'x9', s.Off);
          end;
        end;
      ekField:
        begin
          if TKind(E^.L^.Typ) = tykClass then
            EmitExpr(E^.L)
          else
            EmitAddr(E^.L);
          { the offset in the add that gave the record's address (P329) }
          if (E^.Off <> 0) and (not ArmAddPlus(E^.Off)) then
            AddImmArm('x0', 'x0', E^.Off);
        end;
      ekDeref:
        begin
          if FCheckPtr and (E^.Typ <> TyNone) and PtrStepE(E^.L) then
            EmitPtrFrom(E^.L, TSize(E^.Typ))
          else
          begin
            EmitExpr(E^.L);
            if E^.Typ <> TyNone then
              PtrCheck(TSize(E^.Typ));
          end;
        end;
      ekIndex:
        begin
          { P87: every index is checked, a string's against 1..Length
            (its length arrives in x2 with the pointer), a slice's against
            its length, a static array's against its bounds; a pointer's
            is not. }
          if IsStr(E^.L^.Typ) and (E^.L^.Kind = ekStr) and (E^.R^.Kind = ekInt) then
          begin
            { A literal's constant index is known now (P87). }
            EmitExpr(E^.L);
            if (E^.R^.Num < 1) or (E^.R^.Num > Length(E^.L^.Txt)) then
              BoundsFailArm('', E^.R^.Num, 1, '', Length(E^.L^.Txt), 0);
            AddImmArm('x0', 'x0', E^.R^.Num - 1);
          end
          else if IsStr(E^.L^.Typ) and StrFilled(E) then
          begin
            { StrFillLoop, as on amd64 }
            EmitExpr(E^.L);
            PshK('x0', VCls(E^.L^.Typ, 0));
            EmitExpr(E^.R);
            Line('  sub x0, x0, #1');
            Ppop('x1');
            Line('  add x0, x1, x0');
          end
          else if IsStr(E^.L^.Typ) then
          begin
            if wr and ((E^.L^.Kind = ekVar) or (E^.L^.Kind = ekField) or
              (E^.L^.Kind = ekIndex) or (E^.L^.Kind = ekDeref)) then
            begin
              { A write: the string's own characters first (1.0.82); the
                check in line, the call only for shared ones (1.0.84). }
              EmitAddr(E^.L);
              ok := Lab;
              Line('  ldr x9, [x0, #8]');
              Line('  cbz x9, ' + ok);
              Line('  ldr x9, [x0]');
              Line('  ldurb w9, [x9, #-1]');
              { tst and b.ne, not a test bit and branch: TBNZ reaches
                32 KiB (ARM DDI 0487 M.c C6.2.478, imm14) and the
                routine's end may lie farther; B.cond reaches 1 MiB }
              Line('  tst w9, #1');
              ColdBegin('  b.ne');
              Line('  bl rt_strunique');
              Line('  b ' + ok);
              ColdEnd;
              Line(ok + ':');
            end;
            EmitExpr(E^.L);
            PshK('x0', VCls(E^.L^.Typ, 0));
            if SimpleIx(E^.R) then
              EmitExpr(E^.R)
            else
            begin
              PshK('x2', 0);
              EmitExpr(E^.R);
              Ppop('x2');
            end;
            ok := Lab;
            Line('  sub x1, x0, #1');
            Line('  cmp x1, x2');
            ColdBegin('  b.hs');
            BoundsFailArm('x0', 0, 1, 'x2', 0, 0);
            ColdEnd;
            Line(ok + ':');
            Line('  sub x0, x0, #1');
            Ppop('x1');
            Line('  add x0, x1, x0');
          end
          else if IsDyn(E^.L^.Typ) or (TKind(E^.L^.Typ) = tykPointer) then
          begin
            esz := TSize(FTypes[E^.L^.Typ].Elem);
            EmitExpr(E^.L);
            PshK('x0', VCls(E^.L^.Typ, 0));
            if IsDyn(E^.L^.Typ) and (not SimpleIx(E^.R)) then
              PshK('x2', 0);
            EmitExpr(E^.R);
            if IsDyn(E^.L^.Typ) then
            begin
              if not SimpleIx(E^.R) then
                Ppop('x2');
              if not SliceProven(E) then
              begin
                ok := Lab;
                Line('  cmp x0, x2');
                ColdBegin('  b.hs');
                BoundsFailArm('x0', 0, 0, 'x2', 0, -1);
                ColdEnd;
                Line(ok + ':');
              end;
            end;
            if FCheckPtr and (TKind(E^.L^.Typ) = tykPointer) then
            begin
              { p[i] held to p's object (1.0.111). }
              ScaleTo('x0', 'x0', esz, 'x16');
              Line('  ldr x1, [sp]');
              Line('  add x0, x1, x0');
              Imm('x1', esz);
              Line('  bl rt_ptrfrom');
              Ppop('x1');
            end
            else
            begin
              Ppop('x1');
              ScaleAddArm('x0', 'x1', 'x0', esz, 'x16', 'x17');
            end;
          end
          else if E^.R^.Kind = ekInt then
          begin
            { A static array's constant index is known now (P87): in
              range, no check; out of range, the program stops here. }
            td := FTypes[E^.L^.Typ];
            esz := TSize(td.Elem);
            EmitAddr(E^.L);
            if (E^.R^.Num < td.Lo) or (E^.R^.Num > td.Hi) then
              BoundsFailArm('', E^.R^.Num, td.Lo, '', td.Hi, 0);
            if not ArmAddPlus((E^.R^.Num - td.Lo) * esz) then
              AddImmArm('x0', 'x0', (E^.R^.Num - td.Lo) * esz);
          end
          else
          begin
            td := FTypes[E^.L^.Typ];
            esz := TSize(td.Elem);
            late := LateBase(E^.L, s);
            if not late then
            begin
              EmitAddr(E^.L);
              PshK('x0', 1);
            end;
            EmitExpr(E^.R);
            { the index from the low bound: x0 itself when that is 0 (P289) }
            ix := 'x0';
            if td.Lo <> 0 then
            begin
              AddImmArm('x1', 'x0', -td.Lo);
              ix := 'x1';
            end;
            ok := Lab;
            if not IndexInRange(E^.R, td.Lo, td.Hi) then
            begin
              CmpImmArm(ix, td.Hi - td.Lo, 'x17');
              ColdBegin('  b.hi');
              BoundsFailArm('x0', 0, td.Lo, '', td.Hi, 0);
              ColdEnd;
            end;
            Line(ok + ':');
            { an element of a power of two is the add's shift, one cycle
              for a shift of 4 or less on Neoverse N1 where a mul of 64
              bits takes four (arm-neoverse-n1-sog 3.4, 3.6) }
            sh := Pow2Log(esz);
            { the base comes back into x1, where the index lowered by a
              low bound other than 0 is: that one goes to x0 first }
            if ix <> 'x0' then
              Line('  mov x0, ' + ix);
            { the base after the index when it is a label or the frame's
              (P297); the frame's offset after the element's add, where a
              field's offset and a pair's ldp or stp take it (P329) }
            if not late then
            begin
              Ppop('x1');
              ScaleAddArm('x0', 'x1', 'x0', esz, 'x16', 'x17');
            end
            else if s.Global then
            begin
              LeaS(VarLabel(s.Name), 'x1');
              ScaleAddArm('x0', 'x1', 'x0', esz, 'x16', 'x17');
            end
            else
            begin
              ScaleAddArm('x0', 'x29', 'x0', esz, 'x16', 'x17');
              AddImmArm('x0', 'x0', s.Off);
            end;
          end;
        end;
      ekCall, ekMethod, ekCtor:
        begin
          { rt_mapput and rt_treeput are the slot's address whatever the
            value (1.0.140, P228: a tree's string or Integer was refused) }
          if (not IsBlob(E^.Typ)) and (E^.Name <> 'rt_mapput') and (E^.Name <> 'rt_treeput') then
            Die('not an address');
          EmitExpr(E);
        end;
    else
      Die('not an address');
    end;
    Exit;
  end;
  case E^.Kind of
    ekVar:
      begin
        s := FindSym(E^.Name);
        if s.Reg <> '' then
          Die('internal error: the address of ' + E^.Name + ' while a loop keeps it in ' + s.Reg);
        if s.ByRef then
        begin
          if s.Global then
            Line('  movq ' + VarLabel(s.Name) + '(%rip), %rax')
          else if s.Up <= 0 then
            Line('  movq ' + IntToStr(s.Off) + '(%rbp), %rax')
          else
          begin
            Line('  movq -8(%rbp), %rcx');
            for i := 2 to s.Up do
              Line('  movq -8(%rcx), %rcx');
            Line('  movq ' + IntToStr(s.Off) + '(%rcx), %rax');
          end;
        end
        else if s.Global then
          Line('  leaq ' + VarLabel(s.Name) + '(%rip), %rax')
        else if s.Up <= 0 then
          Line('  leaq ' + IntToStr(s.Off) + '(%rbp), %rax')
        else
        begin
          Line('  movq -8(%rbp), %rcx');
          for i := 2 to s.Up do
            Line('  movq -8(%rcx), %rcx');
          Line('  leaq ' + IntToStr(s.Off) + '(%rcx), %rax');
        end;
      end;
    ekField:
      begin
        if TKind(E^.L^.Typ) = tykClass then
          EmitExpr(E^.L)
        else
          EmitAddr(E^.L);
        { the offset in the lea that gave the record's address (P329) }
        if (E^.Off <> 0) and (not LeaPlus(E^.Off)) then
          Line('  addq $' + IntToStr(E^.Off) + ', %rax');
      end;
    ekDeref:
      begin
        if FCheckPtr and (E^.Typ <> TyNone) and PtrStepE(E^.L) then
          EmitPtrFrom(E^.L, TSize(E^.Typ))
        else
        begin
          EmitExpr(E^.L);
          if E^.Typ <> TyNone then
            PtrCheck(TSize(E^.Typ));
        end;
      end;
    ekIndex:
      begin
        { P87: every index is checked, as on arm64: a string's against
          1..Length (its length arrives in rdx with the pointer), a
          slice's against its length, a static array's against its
          bounds; a pointer's is not. }
        if IsStr(E^.L^.Typ) and (E^.L^.Kind = ekStr) and (E^.R^.Kind = ekInt) then
        begin
          { A literal's constant index is known now (P87). }
          EmitExpr(E^.L);
          if (E^.R^.Num < 1) or (E^.R^.Num > Length(E^.L^.Txt)) then
            BoundsFailX86('$' + IntToStr(E^.R^.Num), 1, '', Length(E^.L^.Txt), 0);
          AddKX86('rax', E^.R^.Num - 1);
        end
        else if IsStr(E^.L^.Typ) and StrFilled(E) then
        begin
          { StrFillLoop: the characters are X's own since before the
            loop, and the counter lies in 1..Length(X) }
          EmitExpr(E^.L);
          PushK('rax', VCls(E^.L^.Typ, 0));
          EmitExpr(E^.R);
          Line('  decq %rax');
          Line('  popq %rcx');
          Line('  addq %rcx, %rax');
        end
        else if IsStr(E^.L^.Typ) then
        begin
          if wr and ((E^.L^.Kind = ekVar) or (E^.L^.Kind = ekField) or
            (E^.L^.Kind = ekIndex) or (E^.L^.Kind = ekDeref)) then
          begin
            { A write: the string's own characters first (1.0.82); the
              check in line, the call only for shared ones (1.0.84). }
            EmitAddr(E^.L);
            ok := Lab;
            Line('  movq 8(%rax), %rcx');
            Line('  testq %rcx, %rcx');
            Line('  jz ' + ok);
            Line('  movq (%rax), %rcx');
            Line('  testb $1, -1(%rcx)');
            ColdBegin('  jnz');
            Line('  movq %rax, %rdi');
            Line('  call rt_strunique');
            Line('  jmp ' + ok);
            ColdEnd;
            Line(ok + ':');
          end;
          EmitExpr(E^.L);
          PushK('rax', VCls(E^.L^.Typ, 0));
          ok := Lab;
          if SimpleIx(E^.R) then
          begin
            Line('  movq %rdx, %rcx');
            EmitExpr(E^.R);
            Line('  leaq -1(%rax), %rdx');
            Line('  cmpq %rcx, %rdx');
            ColdBegin('  jae');
            BoundsFailX86('%rax', 1, '%rcx', 0, 0);
            ColdEnd;
          end
          else
          begin
            PushK('rdx', 0);
            EmitExpr(E^.R);
            Line('  popq %rdx');
            Line('  leaq -1(%rax), %rcx');
            Line('  cmpq %rdx, %rcx');
            ColdBegin('  jae');
            BoundsFailX86('%rax', 1, '%rdx', 0, 0);
            ColdEnd;
          end;
          Line(ok + ':');
          Line('  decq %rax');
          Line('  popq %rcx');
          Line('  addq %rcx, %rax');
        end
        else if IsDyn(E^.L^.Typ) then
        begin
          esz := TSize(FTypes[E^.L^.Typ].Elem);
          EmitExpr(E^.L);
          PushK('rax', VCls(E^.L^.Typ, 0));
          ok := Lab;
          if SliceProven(E) then
          begin
            EmitExpr(E^.R);
            ok := '';
          end
          else if SimpleIx(E^.R) then
          begin
            Line('  movq %rdx, %rcx');
            EmitExpr(E^.R);
            Line('  cmpq %rcx, %rax');
            ColdBegin('  jae');
            BoundsFailX86('%rax', 0, '%rcx', 0, -1);
            ColdEnd;
          end
          else
          begin
            PushK('rdx', 0);
            EmitExpr(E^.R);
            Line('  popq %rdx');
            Line('  cmpq %rdx, %rax');
            ColdBegin('  jae');
            BoundsFailX86('%rax', 0, '%rdx', 0, -1);
            ColdEnd;
          end;
          if ok <> '' then
            Line(ok + ':');
          Line('  popq %rcx');
          ScaleAddX86('%rax', '%rcx', '%rax', esz, '%rdx');
        end
        else if TKind(E^.L^.Typ) = tykPointer then
        begin
          esz := TSize(FTypes[E^.L^.Typ].Elem);
          EmitExpr(E^.L);
          PushK('rax', VCls(E^.L^.Typ, 0));
          EmitExpr(E^.R);
          if FCheckPtr then
          begin
            { p[i] held to p's object (1.0.111). }
            ScaleTo('%rax', '%rax', esz, '%rcx');
            Line('  addq (%rsp), %rax');
            LoadImmR('rcx', esz);
            Line('  call rt_ptrfrom');
            Line('  popq %rcx');
          end
          else
          begin
            Line('  popq %rcx');
            ScaleAddX86('%rax', '%rcx', '%rax', esz, '%rdx');
          end;
        end
        else if E^.R^.Kind = ekInt then
        begin
          { A static array's constant index is known now (P87): in range,
            no check; out of range, the program stops here. }
          td := FTypes[E^.L^.Typ];
          esz := TSize(td.Elem);
          EmitAddr(E^.L);
          if (E^.R^.Num < td.Lo) or (E^.R^.Num > td.Hi) then
            BoundsFailX86('$' + IntToStr(E^.R^.Num), td.Lo, '', td.Hi, 0);
          if not LeaPlus((E^.R^.Num - td.Lo) * esz) then
            AddKX86('rax', (E^.R^.Num - td.Lo) * esz);
        end
        else
        begin
          td := FTypes[E^.L^.Typ];
          esz := TSize(td.Elem);
          late := LateBase(E^.L, s);
          if not late then
          begin
            EmitAddr(E^.L);
            PushK('rax', 1);
          end;
          EmitExpr(E^.R);
          ok := Lab;
          { the index from the low bound: rax itself when that is 0 (P289) }
          ix := '%rax';
          if td.Lo <> 0 then
          begin
            { the low bound in LEA's displacement (P306) }
            if Fits32(-td.Lo) then
              Line('  leaq ' + IntToStr(-td.Lo) + '(%rax), %rdx')
            else
            begin
              LoadImmR('rcx', td.Lo);
              Line('  movq %rax, %rdx');
              Line('  subq %rcx, %rdx');
            end;
            ix := '%rdx';
          end;
          if not IndexInRange(E^.R, td.Lo, td.Hi) then
          begin
            if (td.Hi - td.Lo >= 0) and (td.Hi - td.Lo <= 2147483647) then
              Line('  cmpq $' + IntToStr(td.Hi - td.Lo) + ', ' + ix)
            else
            begin
              LoadImmR('rcx', td.Hi - td.Lo);
              Line('  cmpq %rcx, ' + ix);
            end;
            ColdBegin('  ja');
            BoundsFailX86('%rax', td.Lo, '', td.Hi, 0);
            ColdEnd;
          end;
          Line(ok + ':');
          if ix <> '%rax' then
            Line('  movq %rdx, %rax');
          { an element of a power of two is a shift, one cycle where imul
            takes three on Zen 2 (AMD 17h 30h latencies: SHL 1, IMUL
            reg64 3), any other size a recipe where one is cheaper (P310);
            the base after the index when one instruction gives it (P297),
            in the element's lea itself (P329) }
          if not late then
          begin
            Line('  popq %rcx');
            ScaleAddX86('%rax', '%rcx', '%rax', esz, '%rdx');
          end
          else if s.Global then
            ScaleAtX86(VarLabel(s.Name), '', esz)
          else
            ScaleAtX86(IntToStr(s.Off), '%rbp', esz);
        end;
      end;
    ekAddr:
      EmitAddr(E^.L);
    ekCall, ekMethod, ekCtor:
      begin
        { rt_mapput and rt_treeput are the slot's address whatever the
          value (1.0.140, P228: a tree's string was taken for a returned
          one and copied to a scratch, its Integer refused) }
        if IsBlob(E^.Typ) or (E^.Name = 'rt_mapput') or (E^.Name = 'rt_treeput') then
          EmitExpr(E)
        else if IsFat(E^.Typ) then
        begin
          EmitExpr(E);
          if IsDyn(E^.Typ) then
            off := ScratchT(24, E^.Typ)
          else
            off := ScratchT(16, E^.Typ);
          Line('  movq %rax, ' + IntToStr(off) + '(%rbp)');
          Line('  movq %rdx, ' + IntToStr(off + 8) + '(%rbp)');
          if IsDyn(E^.Typ) then
            Line('  movq %r8, ' + IntToStr(off + 16) + '(%rbp)');
          Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
        end
        else
          Die('not an address kind=' + IntToStr(Ord(E^.Kind)) + ' name=' + E^.Name);
      end;
  else
    Die('not an address kind=' + IntToStr(Ord(E^.Kind)) + ' name=' + E^.Name +
      ' bin=' + IntToStr(Ord(E^.Bin)));
  end;
end;

{ ---- Move and FillChar in line (P304) ----

  A constant count up to 128 bytes is loads and stores in line, where
  every Move and FillChar pushed its address and count and called
  rt_memcpy, or rt_fill on arm64. Go zeroes and copies a constant size
  so: one to four stores up to 16 bytes, straight-line 16-byte stores
  under 192, a loop of 64 up to 1408 and REP STOSQ or MOVSQ past it on
  amd64 (AMD64.rules Zero and Move, ssa.RepZeroThreshold and
  RepMoveThreshold 1408), stores and STP up to 16 bytes and LoweredZero
  under 192 on arm64. Zen 2 stores one 256-bit word a cycle and REP MOVS
  is microcode (AMD 56305 2.12, Table 1). The chunks: 1, 2, 4, 8 and 16
  bytes one access, 3 two (2 and 1), 5 to 7 two words of 4 and 9 to 15
  two of 8 that overlap, 17 to 128 16-byte words with the last one
  ending at the end. Move reads every chunk before it writes one, so an
  overlap either way reads each byte before it is written, as Pascal's
  Move does; 16-byte words go through xmm0 to xmm7 (VEX forms with AVX,
  so no SSE-AVX transition) and q0 to q7 on arm64, which no region
  holds (they keep xmm8 and up, v8 to v15). A variable of the frame or a
  global is its own operand on amd64, with no address formed. }

{ E is @v, @a[k] or @r.f for a variable of this frame or a global at a
  fixed place (not a var parameter, not boxed, not an outer routine's),
  a static array's constant index within its bounds, or a record's field:
  K is the offset of the place from the variable's start. }
function TEmitter.FixedAddr(E: PExpr; out Sy: TSym; out K: Int64): Boolean;
var
  v: PExpr;
  td: TTypeDef;
begin
  Result := False;
  K := 0;
  if (E = nil) or (E^.Kind <> ekAddr) or (E^.L = nil) then
    Exit;
  v := E^.L;
  if (v^.Kind = ekIndex) and (v^.L <> nil) and (v^.L^.Kind = ekVar) and (v^.R <> nil) and
    (v^.R^.Kind = ekInt) and (TKind(v^.L^.Typ) = tykArray) and (not IsDyn(v^.L^.Typ)) and
    (not IsStr(v^.L^.Typ)) then
  begin
    td := FTypes[v^.L^.Typ];
    if (v^.R^.Num < td.Lo) or (v^.R^.Num > td.Hi) then
      Exit;
    K := (v^.R^.Num - td.Lo) * TSize(td.Elem);
    v := v^.L;
  end
  else if (v^.Kind = ekField) and (v^.L <> nil) and (v^.L^.Kind = ekVar) and
    (TKind(v^.L^.Typ) = tykRecord) then
  begin
    K := v^.Off;
    v := v^.L;
  end;
  if v^.Kind <> ekVar then
    Exit;
  if not TryFindSym(v^.Name, Sy) then
    Exit;
  Result := (not Sy.ByRef) and (Sy.Up = 0) and (not Sy.Boxed) and (Sy.Reg = '');
end;

{ amd64: the operand K bytes into a fixed variable. }
function TEmitter.FixedOp(const Sy: TSym; K: Int64): string;
begin
  if Sy.Global and (K = 0) then
    Result := VarLabel(Sy.Name) + '(%rip)'
  else if Sy.Global then
    Result := VarLabel(Sy.Name) + '+' + IntToStr(K) + '(%rip)'
  else
    Result := IntToStr(Sy.Off + K) + '(%rbp)';
end;

{ The address K bytes into a fixed variable into Reg. }
procedure TEmitter.FixedTo(const Sy: TSym; K: Int64; const Reg: string);
begin
  if FArm then
  begin
    if Sy.Global then
    begin
      LeaS(VarLabel(Sy.Name), Reg);
      if K <> 0 then
        AddImmArm(Reg, Reg, K);
    end
    else
      AddFP(Reg, Sy.Off + K);
  end
  else
    Line('  leaq ' + FixedOp(Sy, K) + ', %' + Reg);
end;

{ The accesses that cover N bytes, 1 to 128 (P304). }
procedure TEmitter.SmallChunks(N: Int64; var Off, Sz: TInt64Arr);
var
  m, i: Int64;
begin
  Off := nil;
  Sz := nil;
  if (N = 1) or (N = 2) or (N = 4) or (N = 8) or (N = 16) then
  begin
    SetLength(Off, 1);
    SetLength(Sz, 1);
    Off[0] := 0;
    Sz[0] := N;
    Exit;
  end;
  if N < 16 then
  begin
    SetLength(Off, 2);
    SetLength(Sz, 2);
    Off[0] := 0;
    if N = 3 then
    begin
      Sz[0] := 2;
      Off[1] := 2;
      Sz[1] := 1;
    end
    else if N < 8 then
    begin
      Sz[0] := 4;
      Off[1] := N - 4;
      Sz[1] := 4;
    end
    else
    begin
      Sz[0] := 8;
      Off[1] := N - 8;
      Sz[1] := 8;
    end;
    Exit;
  end;
  m := (N + 15) div 16;
  SetLength(Off, m);
  SetLength(Sz, m);
  for i := 0 to m - 1 do
  begin
    Off[i] := 16 * i;
    Sz[i] := 16;
  end;
  Off[m - 1] := N - 16;
end;

{ Move(a, b, n) with n a constant up to 128 in line (P304). }
function TEmitter.EmitSmallMove(S: PStmt): Boolean;
var
  n: Int64;
  i: SizeInt;
  off, sz: TInt64Arr;
  ssy, dsy: TSym;
  fs, fd, avx: Boolean;
  r, so, dop: string;
  sk, dk: Int64;
begin
  Result := False;
  if (Length(S^.Args) <> 3) or (S^.Args[2] = nil) or (S^.Args[2]^.Kind <> ekInt) then
    Exit;
  n := S^.Args[2]^.Num;
  if (n < 1) or (n > 128) then
    Exit;
  Result := True;
  fs := FixedAddr(S^.Args[0], ssy, sk);
  fd := FixedAddr(S^.Args[1], dsy, dk);
  SmallChunks(n, off, sz);
  if FArm then
  begin
    { x10 the source, x11 the destination }
    if not fs then
    begin
      EmitExpr(S^.Args[0]);
      if not fd then
      begin
        PshK('x0', VCls(S^.Args[0]^.Typ, 0));
        EmitExpr(S^.Args[1]);
        Line('  mov x11, x0');
        Ppop('x10');
      end
      else
      begin
        Line('  mov x10, x0');
        FixedTo(dsy, dk, 'x11');
      end;
    end
    else
    begin
      if not fd then
      begin
        EmitExpr(S^.Args[1]);
        Line('  mov x11, x0');
      end
      else
        FixedTo(dsy, dk, 'x11');
      FixedTo(ssy, sk, 'x10');
    end;
    for i := 0 to High(off) do
    begin
      if sz[i] = 16 then
        r := 'q' + IntToStr(i)
      else if sz[i] = 8 then
        r := 'x' + IntToStr(12 + i)
      else
        r := 'w' + IntToStr(12 + i);
      if sz[i] = 1 then
        Line('  ldrb ' + r + ', [x10, #' + IntToStr(off[i]) + ']')
      else if sz[i] = 2 then
        Line('  ldrh ' + r + ', [x10, #' + IntToStr(off[i]) + ']')
      else
        Line('  ldr ' + r + ', [x10, #' + IntToStr(off[i]) + ']');
    end;
    for i := 0 to High(off) do
    begin
      if sz[i] = 16 then
        r := 'q' + IntToStr(i)
      else if sz[i] = 8 then
        r := 'x' + IntToStr(12 + i)
      else
        r := 'w' + IntToStr(12 + i);
      if sz[i] = 1 then
        Line('  strb ' + r + ', [x11, #' + IntToStr(off[i]) + ']')
      else if sz[i] = 2 then
        Line('  strh ' + r + ', [x11, #' + IntToStr(off[i]) + ']')
      else
        Line('  str ' + r + ', [x11, #' + IntToStr(off[i]) + ']');
    end;
    Exit;
  end;
  avx := HasFeat(CpuFeatBit('avx', False));
  { rsi the source and rdi the destination when they are not fixed }
  if (not fs) and (not fd) then
  begin
    EmitExpr(S^.Args[0]);
    PushK('rax', VCls(S^.Args[0]^.Typ, 0));
    EmitExpr(S^.Args[1]);
    Line('  movq %rax, %rdi');
    Line('  popq %rsi');
  end
  else if not fs then
  begin
    EmitExpr(S^.Args[0]);
    Line('  movq %rax, %rsi');
  end
  else if not fd then
  begin
    EmitExpr(S^.Args[1]);
    Line('  movq %rax, %rdi');
  end;
  for i := 0 to High(off) do
  begin
    if fs then
      so := FixedOp(ssy, sk + off[i])
    else
      so := IntToStr(off[i]) + '(%rsi)';
    if sz[i] = 16 then
    begin
      if avx then
        Line('  vmovdqu ' + so + ', %xmm' + IntToStr(i))
      else
        Line('  movdqu ' + so + ', %xmm' + IntToStr(i));
    end
    else
    begin
      if i = 0 then
        r := 'ax'
      else
        r := 'cx';
      if sz[i] = 1 then
        Line('  movzbl ' + so + ', %e' + r)
      else if sz[i] = 2 then
        Line('  movzwl ' + so + ', %e' + r)
      else if sz[i] = 4 then
        Line('  movl ' + so + ', %e' + r)
      else
        Line('  movq ' + so + ', %r' + r);
    end;
  end;
  for i := 0 to High(off) do
  begin
    if fd then
      dop := FixedOp(dsy, dk + off[i])
    else
      dop := IntToStr(off[i]) + '(%rdi)';
    if sz[i] = 16 then
    begin
      if avx then
        Line('  vmovdqu %xmm' + IntToStr(i) + ', ' + dop)
      else
        Line('  movdqu %xmm' + IntToStr(i) + ', ' + dop);
    end
    else
    begin
      if i = 0 then
        r := 'a'
      else
        r := 'c';
      if sz[i] = 1 then
        Line('  movb %' + r + 'l, ' + dop)
      else if sz[i] = 2 then
        Line('  movw %' + r + 'x, ' + dop)
      else if sz[i] = 4 then
        Line('  movl %e' + r + 'x, ' + dop)
      else
        Line('  movq %r' + r + 'x, ' + dop);
    end;
  end;
end;

{ FillChar(x, n, v) with n a constant up to 128 in line (P304): the byte
  v in every byte of a word, rax or x12 (v times $0101010101010101, or
  three ORs of shifted copies on arm64), and in every lane of xmm0
  (MOVQ and PUNPCKLQDQ, SDM vol. 2B 4-54 and 4-512; PXOR for 0) or v0
  (DUP (general) and MOVI, ARM DDI 0487 M.c C7.2.41 and C7.2.247). }
function TEmitter.EmitSmallFill(S: PStmt): Boolean;
var
  n, v, pat: Int64;
  i: SizeInt;
  off, sz: TInt64Arr;
  dsy: TSym;
  fd, vk, avx, wide, narrow: Boolean;
  dop, r: string;
  x: PExpr;
  dk: Int64;
begin
  Result := False;
  if (Length(S^.Args) <> 3) or (S^.Args[1] = nil) or (S^.Args[1]^.Kind <> ekInt) then
    Exit;
  n := S^.Args[1]^.Num;
  if (n < 1) or (n > 128) then
    Exit;
  x := S^.Args[2];
  vk := (x^.Kind = ekInt) or ((x^.Kind = ekStr) and (Length(x^.Txt) = 1));
  v := 0;
  if x^.Kind = ekInt then
    v := x^.Num and 255
  else if vk then
    v := Ord(x^.Txt[1]);
  pat := v or (v shl 8);
  pat := pat or (pat shl 16);
  pat := pat or (pat shl 32);
  Result := True;
  fd := FixedAddr(S^.Args[0], dsy, dk);
  SmallChunks(n, off, sz);
  wide := False;
  narrow := False;
  for i := 0 to High(sz) do
    if sz[i] = 16 then
      wide := True
    else if sz[i] > 1 then
      narrow := True;
  if FArm then
  begin
    { x11 the destination, the byte in w12 }
    if not fd then
    begin
      EmitExpr(S^.Args[0]);
      if not vk then
      begin
        PshK('x0', VCls(S^.Args[0]^.Typ, 0));
        EmitExpr(x);
        Line('  and w12, w0, #255');
        Ppop('x11');
      end
      else
        Line('  mov x11, x0');
    end
    else
    begin
      if not vk then
      begin
        EmitExpr(x);
        Line('  and w12, w0, #255');
      end;
      FixedTo(dsy, dk, 'x11');
    end;
    if vk then
    begin
      if (v <> 0) and ((not wide) or narrow or (sz[0] = 1)) then
        Imm('x12', pat);
      if wide then
      begin
        if v = 0 then
          Line('  movi v0.2d, #0')
        else
          Line('  movi v0.16b, #' + IntToStr(v));
      end;
    end
    else
    begin
      if wide then
        Line('  dup v0.16b, w12');
      if narrow then
      begin
        Line('  orr x12, x12, x12, lsl #8');
        Line('  orr x12, x12, x12, lsl #16');
        Line('  orr x12, x12, x12, lsl #32');
      end;
    end;
    for i := 0 to High(off) do
    begin
      if sz[i] = 16 then
        Line('  str q0, [x11, #' + IntToStr(off[i]) + ']')
      else
      begin
        if vk and (v = 0) then
        begin
          if sz[i] = 8 then
            r := 'xzr'
          else
            r := 'wzr';
        end
        else if sz[i] = 8 then
          r := 'x12'
        else
          r := 'w12';
        if sz[i] = 1 then
          Line('  strb ' + r + ', [x11, #' + IntToStr(off[i]) + ']')
        else if sz[i] = 2 then
          Line('  strh ' + r + ', [x11, #' + IntToStr(off[i]) + ']')
        else
          Line('  str ' + r + ', [x11, #' + IntToStr(off[i]) + ']');
      end;
    end;
    Exit;
  end;
  avx := HasFeat(CpuFeatBit('avx', False));
  { rdi the destination when it is not fixed, the pattern in rax }
  if not fd then
  begin
    EmitExpr(S^.Args[0]);
    if not vk then
    begin
      PushK('rax', VCls(S^.Args[0]^.Typ, 0));
      EmitExpr(x);
      Line('  popq %rdi');
    end
    else
      Line('  movq %rax, %rdi');
  end
  else if not vk then
    EmitExpr(x);
  if not vk then
  begin
    Line('  movzbl %al, %eax');
    Line('  movabsq $72340172838076673, %rcx');
    Line('  imulq %rcx, %rax');
  end
  else if (not Fits32(pat)) and (wide or (sz[High(sz)] = 8)) and (v <> 0) then
    Line('  movabsq $' + IntToStr(pat) + ', %rax');
  if wide then
  begin
    if vk and (v = 0) then
    begin
      if avx then
        Line('  vpxor %xmm0, %xmm0, %xmm0')
      else
        Line('  pxor %xmm0, %xmm0');
    end
    else
    begin
      if vk and Fits32(pat) then
        Line('  movq $' + IntToStr(pat) + ', %rax');
      if avx then
      begin
        Line('  vmovq %rax, %xmm0');
        Line('  vpunpcklqdq %xmm0, %xmm0, %xmm0');
      end
      else
      begin
        Line('  movq %rax, %xmm0');
        Line('  punpcklqdq %xmm0, %xmm0');
      end;
    end;
  end;
  for i := 0 to High(off) do
  begin
    if fd then
      dop := FixedOp(dsy, dk + off[i])
    else
      dop := IntToStr(off[i]) + '(%rdi)';
    if sz[i] = 16 then
    begin
      if avx then
        Line('  vmovdqu %xmm0, ' + dop)
      else
        Line('  movdqu %xmm0, ' + dop);
    end
    else if vk then
    begin
      { a constant's bytes as the store's own immediate (MOV r/m,
        imm), the 8-byte one when it fits 32 bits sign extended }
      if sz[i] = 1 then
        Line('  movb $' + IntToStr(v) + ', ' + dop)
      else if sz[i] = 2 then
        Line('  movw $' + IntToStr(pat and 65535) + ', ' + dop)
      else if sz[i] = 4 then
        Line('  movl $' + IntToStr(pat and 4294967295) + ', ' + dop)
      else if Fits32(pat) then
        Line('  movq $' + IntToStr(pat) + ', ' + dop)
      else
        Line('  movq %rax, ' + dop);
    end
    else if sz[i] = 1 then
      Line('  movb %al, ' + dop)
    else if sz[i] = 2 then
      Line('  movw %ax, ' + dop)
    else if sz[i] = 4 then
      Line('  movl %eax, ' + dop)
    else
      Line('  movq %rax, ' + dop);
  end;
end;

{ Move(a, b, n) of any count with a and b fixed variables and n without
  a call: the addresses go straight to their registers, n through rax or
  x0 first, with no push (P304). }
function TEmitter.EmitMoveArgs(S: PStmt): Boolean;
var
  ssy, dsy: TSym;
  sk, dk: Int64;
begin
  Result := False;
  if (Length(S^.Args) <> 3) or EHasCall(S^.Args[2]) then
    Exit;
  if not (FixedAddr(S^.Args[0], ssy, sk) and FixedAddr(S^.Args[1], dsy, dk)) then
    Exit;
  Result := True;
  EmitExpr(S^.Args[2]);
  if FArm then
  begin
    Line('  mov x2, x0');
    FixedTo(ssy, sk, 'x1');
    FixedTo(dsy, dk, 'x0');
    Line('  bl rt_memcpy');
  end
  else
  begin
    Line('  movq %rax, %rcx');
    FixedTo(ssy, sk, 'rsi');
    FixedTo(dsy, dk, 'rdi');
    Line('  call rt_memcpy');
  end;
end;

{ FillChar(x, n, v) of any count with x a fixed variable, n without a
  call and v a constant or a word variable: n, v and the address straight
  to their registers, with no push (P304). False when it is not. }
function TEmitter.EmitFillArgs(S: PStmt): Boolean;
var
  dsy, vs: TSym;
  x: PExpr;
  v, dk: Int64;
  vk: Boolean;
begin
  Result := False;
  if (Length(S^.Args) <> 3) or EHasCall(S^.Args[1]) then
    Exit;
  if not FixedAddr(S^.Args[0], dsy, dk) then
    Exit;
  x := S^.Args[2];
  vk := (x^.Kind = ekInt) or ((x^.Kind = ekStr) and (Length(x^.Txt) = 1));
  if (not vk) and not ((x^.Kind = ekVar) and WordVar(x, vs)) then
    Exit;
  v := 0;
  if x^.Kind = ekInt then
    v := x^.Num and 255
  else if vk then
    v := Ord(x^.Txt[1]);
  Result := True;
  EmitExpr(S^.Args[1]);
  if FArm then
  begin
    Line('  mov x1, x0');
    if vk then
      Imm('x2', v)
    else
      LoadWordVar(vs, 'x2');
    FixedTo(dsy, dk, 'x0');
  end
  else
  begin
    Line('  movq %rax, %rcx');
    if vk then
      Line('  movl $' + IntToStr(v) + ', %eax')
    else
      LoadWordVar(vs, 'rax');
    FixedTo(dsy, dk, 'rdi');
  end;
end;

function X86Sub(const R: string; W: LongInt): string; forward;

function CmpHolds(Op: TBinOp; A, B: Int64): Boolean;
begin
  if Op = boEq then
    Result := A = B
  else if Op = boNe then
    Result := A <> B
  else if Op = boLt then
    Result := A < B
  else if Op = boLe then
    Result := A <= B
  else if Op = boGt then
    Result := A > B
  else if Op = boGe then
    Result := A >= B
  else
    Result := False;
end;

function TEmitter.PlainOrd(E: PExpr; out S: TSym): Boolean;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekVar) then
    Exit;
  S := FindSym(E^.Name);
  if S.ByRef or (S.Up > 0) then
    Exit;
  if TSize(S.Typ) <> 8 then
    Exit;
  if (TKind(S.Typ) <> tykInteger) and (TKind(S.Typ) <> tykEnum) and
    (TKind(S.Typ) <> tykSubrange) then
    Exit;
  Result := True;
end;

function TEmitter.DirectStore(Dest: PExpr): Boolean;
var
  s: TSym;
begin
  Result := False;
  if (Dest = nil) or (Dest^.Kind <> ekVar) then
    Exit;
  if IsFat(Dest^.Typ) or IsBlob(Dest^.Typ) then
    Exit;
  s := FindSym(Dest^.Name);
  if s.ByRef or (s.Up > 0) then
    Exit;
  { A variable a loop keeps in a register takes the value there, a Byte
    too (1.0.129): b := RotateLeftToCarry(c) asked for b's address. The
    value is its type's already unless it came from another width. }
  if s.Reg <> '' then
  begin
    StoreVar(Dest^.Name);
    if (FStoreSrc = nil) or (FStoreSrc^.Typ <> s.Typ) then
      CanonReg(s.Reg, s.Typ);
    Result := True;
    Exit;
  end;
  if TSize(Dest^.Typ) = 1 then
    Exit;
  StoreVar(Dest^.Name);
  Result := True;
end;

function MemA(const S: TSym): string;
begin
  if S.Reg <> '' then
    Result := '%' + S.Reg
  else if S.Global then
    Result := VarLabel(S.Name) + '(%rip)'
  else
    Result := IntToStr(S.Off) + '(%rbp)';
end;

{ Word W (0 or 8) of a variable in memory, as MemA gives the first (P242). }
function TEmitter.StrWordA(const S: TSym; W: LongInt): string;
begin
  if S.Global then
  begin
    Result := VarLabel(S.Name) + '(%rip)';
    if W <> 0 then
      Result := VarLabel(S.Name) + '+' + IntToStr(W) + '(%rip)';
  end
  else
    Result := IntToStr(S.Off + W) + '(%rbp)';
end;

{ E is a string variable of this frame or a global, its words in place:
  not a var parameter, an outer routine's, one in a heap box or one a
  loop keeps in a register (P242). }
function TEmitter.PlainStr(E: PExpr; out S: TSym): Boolean;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekVar) or (not IsStr(E^.Typ)) then
    Exit;
  S := FindSym(E^.Name);
  Result := (not S.ByRef) and (S.Up = 0) and (not S.Boxed) and (S.Reg = '') and IsStr(S.Typ);
end;

procedure TEmitter.LoadPlain(const S: TSym; const Reg: string);
begin
  if FArm then
  begin
    if S.Reg <> '' then
      Line('  mov ' + Reg + ', ' + S.Reg)
    else if S.Global then
      LdS(VarLabel(S.Name), Reg)
    else
      LdFP(Reg, S.Off);
  end
  else
    Line('  movq ' + MemA(S) + ', %' + Reg);
end;

procedure TEmitter.StorePlain(const S: TSym);
begin
  if FArm then
    StorePlainFrom(S, 'x0')
  else
    Line('  movq %rax, ' + MemA(S));
end;

procedure TEmitter.StorePlainFrom(const S: TSym; const Src: string);
begin
  if FArm then
  begin
    if S.Reg <> '' then
      Line('  mov ' + S.Reg + ', ' + Src)
    else if S.Global then
      StS(Src, VarLabel(S.Name))
    else
      StFP(Src, S.Off);
  end
  else
    Line('  movq %' + Src + ', ' + MemA(S));
end;

procedure TEmitter.LoadImmR(const Reg: string; K: Int64);
begin
  if FArm then
    Imm(Reg, K)
  else if Fits32(K) then
    Line('  movq $' + IntToStr(K) + ', %' + Reg)
  else
    Line('  movabsq $' + IntToStr(K) + ', %' + Reg);
end;

function TEmitter.SideOrd(E: PExpr; out S: TSym): Boolean;
begin
  Result := False;
  if E = nil then
    Exit;
  if E^.Kind = ekInt then
  begin
    Result := True;
    Exit;
  end;
  Result := PlainOrd(E, S);
end;

function SamePlace(const A, B: TSym): Boolean;
begin
  if A.Global or B.Global then
    Result := A.Global and B.Global and SameSym(A.Name, B.Name)
  else
    Result := A.Off = B.Off;
end;

function TEmitter.InPlaceImm(const D: TSym; Op: TBinOp; K: Int64): Boolean;
var
  m, ins: string;
begin
  Result := False;
  if FArm then
  begin
    { arm64 (P290): a variable a register keeps takes the operation
      there, the constant as the instruction's immediate: add and sub
      take 0 to 4095 or that shifted by 12 (ArmAddImm), a shift 0 to
      63, and, orr and eor a logical immediate (ArmLogImm). One
      instruction where k := k + 1 took four through x0 and x1. }
    if D.Reg = '' then
      Exit;
    m := D.Reg;
    if ((Op = boShl) or (Op = boShr)) and (K >= 0) and (K <= 63) then
    begin
      if Op = boShl then
        Line('  lsl ' + m + ', ' + m + ', #' + IntToStr(K))
      else
        Line('  lsr ' + m + ', ' + m + ', #' + IntToStr(K));
      Result := True;
    end
    else if (Op = boAdd) or (Op = boSub) then
    begin
      if ArmAddImm(K) <> '' then
      begin
        if Op = boAdd then
          Line('  add ' + m + ', ' + m + ', ' + ArmAddImm(K))
        else
          Line('  sub ' + m + ', ' + m + ', ' + ArmAddImm(K));
        Result := True;
      end
      else if (K < 0) and (K > Low(Int64)) and (ArmAddImm(-K) <> '') then
      begin
        if Op = boAdd then
          Line('  sub ' + m + ', ' + m + ', ' + ArmAddImm(-K))
        else
          Line('  add ' + m + ', ' + m + ', ' + ArmAddImm(-K));
        Result := True;
      end;
    end
    else if ((Op = boAnd) or (Op = boOr) or (Op = boXor)) and ArmLogImm(K) then
    begin
      if Op = boAnd then
        ins := 'and'
      else if Op = boOr then
        ins := 'orr'
      else
        ins := 'eor';
      Line('  ' + ins + ' ' + m + ', ' + m + ', #' + HexWord(K));
      Result := True;
    end;
    Exit;
  end;
  if (Op = boShl) or (Op = boShr) then
  begin
    if (K < 0) or (K > 63) then
      Exit;
    m := MemA(D);
    if Op = boShl then
      Line('  shlq $' + IntToStr(K) + ', ' + m)
    else
      Line('  shrq $' + IntToStr(K) + ', ' + m);
    Result := True;
    Exit;
  end;
  if not Fits32(K) then
    Exit;
  m := MemA(D);
  ins := '';
  if Op = boAdd then
    ins := 'addq'
  else if Op = boSub then
    ins := 'subq'
  else if Op = boAnd then
    ins := 'andq'
  else if Op = boOr then
    ins := 'orq'
  else if Op = boXor then
    ins := 'xorq'
  else
    Exit;
  Line('  ' + ins + ' $' + IntToStr(K) + ', ' + m);
  Result := True;
end;

function TEmitter.InPlaceReg(const D: TSym; Op: TBinOp; const R: TSym): Boolean;
var
  m, ins, o: string;
begin
  Result := False;
  if FArm then
  begin
    { arm64 (P290): the operation on the register the variable lives in,
      the operand's own register when it has one }
    if D.Reg = '' then
      Exit;
    ins := '';
    case Op of
      boAdd: ins := 'add';
      boSub: ins := 'sub';
      boAnd: ins := 'and';
      boOr: ins := 'orr';
      boXor: ins := 'eor';
      boMul: ins := 'mul';
      boShl: ins := 'lsl';
      boShr: ins := 'lsr';
    end;
    if ins = '' then
      Exit;
    if (R.Reg <> '') and (R.Up = 0) and (not R.ByRef) then
      o := R.Reg
    else
    begin
      LoadPlain(R, 'x17');
      o := 'x17';
    end;
    Line('  ' + ins + ' ' + D.Reg + ', ' + D.Reg + ', ' + o);
    Result := True;
    Exit;
  end;
  m := MemA(D);
  if (Op = boShl) or (Op = boShr) then
  begin
    LoadPlain(R, 'rcx');
    if Op = boShl then
      Line('  shlq %cl, ' + m)
    else
      Line('  shrq %cl, ' + m);
    Result := True;
    Exit;
  end;
  if (Op <> boAdd) and (Op <> boSub) and (Op <> boAnd) and (Op <> boOr) and
    (Op <> boXor) then
    Exit;
  if Op = boAdd then
    ins := 'addq'
  else if Op = boSub then
    ins := 'subq'
  else if Op = boAnd then
    ins := 'andq'
  else if Op = boOr then
    ins := 'orq'
  else
    ins := 'xorq';
  if (R.Reg <> '') and (R.Up = 0) and (not R.ByRef) then
    { the operand is in a pool register: one instruction, as Go writes
      it, where a move through rax doubled the loop (1.1.1) }
    Line('  ' + ins + ' %' + R.Reg + ', ' + m)
  else
  begin
    LoadPlain(R, 'rax');
    Line('  ' + ins + ' %rax, ' + m);
  end;
  Result := True;
end;

procedure TEmitter.OrdInto(const D: TSym; Op: TBinOp; L, R: PExpr);
var
  ls, rs: TSym;
  ains, dreg, lreg, rreg, ins: string;
  k: Int64;
  lvar, rvar: Boolean;
  a, b: PExpr;
begin
  if FArm then
  begin
    { arm64 (P290): three operands, so d := l op r is one instruction on
      the registers the variables live in, the result straight into d's
      (x0 and a store when d is in memory), a constant on the right the
      immediate where the instruction takes one; a constant on the left
      of an operation that commutes goes to the right. }
    ins := '';
    case Op of
      boAdd: ins := 'add';
      boSub: ins := 'sub';
      boAnd: ins := 'and';
      boOr: ins := 'orr';
      boXor: ins := 'eor';
      boMul: ins := 'mul';
      boShl: ins := 'lsl';
      boShr: ins := 'lsr';
    end;
    if ins <> '' then
    begin
      a := L;
      b := R;
      if (a^.Kind = ekInt) and (b^.Kind <> ekInt) and ((Op = boAdd) or (Op = boAnd) or
        (Op = boOr) or (Op = boXor) or (Op = boMul)) then
      begin
        a := R;
        b := L;
      end;
      if a^.Kind = ekInt then
      begin
        LoadImmR('x0', a^.Num);
        lreg := 'x0';
      end
      else
      begin
        ls := FindSym(a^.Name);
        if ls.Reg <> '' then
          lreg := ls.Reg
        else
        begin
          LoadPlain(ls, 'x0');
          lreg := 'x0';
        end;
      end;
      if (b^.Kind = ekInt) and (Op = boMul) then
      begin
        { x * K by its recipe where that costs less than MUL on the
          tune, x17 its second value (P312) }
        dreg := D.Reg;
        if dreg = '' then
          dreg := 'x0';
        if MulByKVia(dreg, lreg, b^.Num, 'x17', '') then
        begin
          if D.Reg = '' then
            StorePlain(D);
          Exit;
        end;
      end;
      if b^.Kind = ekInt then
      begin
        k := b^.Num;
        if ((Op = boShl) or (Op = boShr)) and (k >= 0) and (k <= 63) then
          rreg := '#' + IntToStr(k)
        else if ((Op = boAdd) or (Op = boSub)) and (ArmAddImm(k) <> '') then
          rreg := ArmAddImm(k)
        else if ((Op = boAdd) or (Op = boSub)) and (k < 0) and (k > Low(Int64)) and
          (ArmAddImm(-k) <> '') then
        begin
          if Op = boAdd then
            ins := 'sub'
          else
            ins := 'add';
          rreg := ArmAddImm(-k);
        end
        else if ((Op = boAnd) or (Op = boOr) or (Op = boXor)) and ArmLogImm(k) then
          rreg := '#' + HexWord(k)
        else
        begin
          LoadImmR('x1', k);
          rreg := 'x1';
        end;
      end
      else
      begin
        rs := FindSym(b^.Name);
        if rs.Reg <> '' then
          rreg := rs.Reg
        else
        begin
          LoadPlain(rs, 'x1');
          rreg := 'x1';
        end;
      end;
      dreg := D.Reg;
      if dreg = '' then
        dreg := 'x0';
      Line('  ' + ins + ' ' + dreg + ', ' + lreg + ', ' + rreg);
      if D.Reg = '' then
        StorePlain(D);
      Exit;
    end;
  end;
  if not FArm then
  begin
    { The forms a register variable takes without rax (1.1.1): d := l
      + k is lea, d := l + r is lea, an operation into d itself is one
      instruction, and a constant is the instruction's immediate. Go
      writes a binary search's pass in nine instructions; through rax
      and rcx it took seventeen. }
    dreg := D.Reg;
    lvar := (L^.Kind = ekVar) and PlainOrd(L, ls);
    rvar := (R^.Kind = ekVar) and PlainOrd(R, rs);
    lreg := '';
    rreg := '';
    if lvar then
      lreg := ls.Reg;
    if rvar then
      rreg := rs.Reg;
    ins := '';
    if Op = boAdd then
      ins := 'addq'
    else if Op = boSub then
      ins := 'subq'
    else if Op = boAnd then
      ins := 'andq'
    else if Op = boOr then
      ins := 'orq'
    else if Op = boXor then
      ins := 'xorq'
    else if Op = boMul then
      ins := 'imulq'
    else if Op = boShl then
      ins := 'shlq'
    else if Op = boShr then
      ins := 'shrq';
    if (dreg <> '') and (lreg <> '') and (R^.Kind = ekInt) and Fits32(R^.Num) and (ins <> '') then
    begin
      k := R^.Num;
      if (Op = boAdd) and (dreg <> lreg) then
        Line('  leaq ' + IntToStr(k) + '(%' + lreg + '), %' + dreg)
      else if (Op = boSub) and (dreg <> lreg) and Fits32(-k) then
        Line('  leaq ' + IntToStr(-k) + '(%' + lreg + '), %' + dreg)
      else if Op = boMul then
      begin
        { the recipe where it costs less than IMUL, rax and rcx free
          here as the path through rax below takes them (P312) }
        if not MulByKVia('%' + dreg, '%' + lreg, k, '%rax', '%rcx') then
          Line('  imulq $' + IntToStr(k) + ', %' + lreg + ', %' + dreg);
      end
      else
      begin
        if dreg <> lreg then
          Line('  movq %' + lreg + ', %' + dreg);
        Line('  ' + ins + ' $' + IntToStr(k) + ', %' + dreg);
      end;
      Exit;
    end;
    if (dreg <> '') and (rreg <> '') and (L^.Kind = ekInt) and Fits32(L^.Num) and
      ((Op = boAdd) or (Op = boAnd) or (Op = boOr) or (Op = boXor) or (Op = boMul)) then
    begin
      k := L^.Num;
      if (Op = boAdd) and (dreg <> rreg) then
        Line('  leaq ' + IntToStr(k) + '(%' + rreg + '), %' + dreg)
      else if Op = boMul then
      begin
        if not MulByKVia('%' + dreg, '%' + rreg, k, '%rax', '%rcx') then
          Line('  imulq $' + IntToStr(k) + ', %' + rreg + ', %' + dreg);
      end
      else
      begin
        if dreg <> rreg then
          Line('  movq %' + rreg + ', %' + dreg);
        Line('  ' + ins + ' $' + IntToStr(k) + ', %' + dreg);
      end;
      Exit;
    end;
    if (dreg <> '') and (lreg <> '') and (rreg <> '') and (ins <> '') and
      (Op <> boShl) and (Op <> boShr) then
    begin
      if (Op = boAdd) and (dreg <> lreg) and (dreg <> rreg) then
        Line('  leaq (%' + lreg + ',%' + rreg + '), %' + dreg)
      else if dreg = lreg then
        Line('  ' + ins + ' %' + rreg + ', %' + dreg)
      else if (dreg = rreg) and (Op <> boSub) then
        Line('  ' + ins + ' %' + lreg + ', %' + dreg)
      else if dreg <> rreg then
      begin
        Line('  movq %' + lreg + ', %' + dreg);
        Line('  ' + ins + ' %' + rreg + ', %' + dreg);
      end
      else
      begin
        { d := l - d }
        Line('  movq %' + lreg + ', %rax');
        Line('  subq %' + rreg + ', %rax');
        Line('  movq %rax, %' + dreg);
      end;
      Exit;
    end;
    { through rax, the right operand in place: a constant as the
      immediate, a variable as the memory or register operand; a
      product by a constant on the left takes it on the right, so its
      recipe follows (P312) }
    if (Op = boMul) and (L^.Kind = ekInt) and (R^.Kind = ekVar) and rvar and Fits32(L^.Num) then
    begin
      a := L;
      L := R;
      R := a;
      ls := rs;
    end;
    if L^.Kind = ekInt then
      LoadImmR('rax', L^.Num)
    else
      LoadPlain(ls, 'rax');
    if (R^.Kind = ekInt) and ((Op = boShl) or (Op = boShr)) and (R^.Num >= 0) and (R^.Num <= 63) then
      Line('  ' + ins + ' $' + IntToStr(R^.Num) + ', %rax')
    else if (R^.Kind = ekInt) and Fits32(R^.Num) and (ins <> '') and (Op <> boShl) and (Op <> boShr) then
    begin
      if Op = boMul then
      begin
        if not MulByKVia('%rax', '%rax', R^.Num, '%rcx', '') then
          Line('  imulq $' + IntToStr(R^.Num) + ', %rax, %rax');
      end
      else
        Line('  ' + ins + ' $' + IntToStr(R^.Num) + ', %rax');
    end
    else if (R^.Kind = ekInt) then
    begin
      LoadImmR('rcx', R^.Num);
      if (Op = boShl) or (Op = boShr) then
        Line('  ' + ins + ' %cl, %rax')
      else
        Line('  ' + ins + ' %rcx, %rax');
    end
    else if (Op = boShl) or (Op = boShr) then
    begin
      LoadPlain(rs, 'rcx');
      Line('  ' + ins + ' %cl, %rax');
    end
    else
      Line('  ' + ins + ' ' + MemA(rs) + ', %rax');
    StorePlain(D);
    Exit;
  end;
  if L^.Kind = ekInt then
  begin
    if FArm then
      LoadImmR('x0', L^.Num)
    else
      LoadImmR('rax', L^.Num);
  end
  else
  begin
    ls := FindSym(L^.Name);
    if FArm then
      LoadPlain(ls, 'x0')
    else
      LoadPlain(ls, 'rax');
  end;
  if (R^.Kind = ekInt) and ((Op = boShl) or (Op = boShr)) and (R^.Num >= 0) and
    (R^.Num <= 63) then
  begin
    { a constant count is the instruction's immediate (1.1.1), where a
      move into rcx and a shift by cl cost two instructions and a
      register in every hash mixer's loop }
    if FArm then
    begin
      if Op = boShl then
        Line('  lsl x0, x0, #' + IntToStr(R^.Num))
      else
        Line('  lsr x0, x0, #' + IntToStr(R^.Num));
    end
    else
    begin
      if Op = boShl then
        Line('  shlq $' + IntToStr(R^.Num) + ', %rax')
      else
        Line('  shrq $' + IntToStr(R^.Num) + ', %rax');
    end;
    StorePlain(D);
    Exit;
  end;
  if R^.Kind = ekInt then
  begin
    if FArm then
      LoadImmR('x1', R^.Num)
    else
      LoadImmR('rcx', R^.Num);
  end
  else
  begin
    rs := FindSym(R^.Name);
    if FArm then
      LoadPlain(rs, 'x1')
    else
      LoadPlain(rs, 'rcx');
  end;
  if FArm then
  begin
    if Op = boAdd then
      Line('  add x0, x0, x1')
    else if Op = boSub then
      Line('  sub x0, x0, x1')
    else if Op = boMul then
      Line('  mul x0, x0, x1')
    else if Op = boAnd then
      Line('  and x0, x0, x1')
    else if Op = boOr then
      Line('  orr x0, x0, x1')
    else if Op = boXor then
      Line('  eor x0, x0, x1')
    else if Op = boShl then
      Line('  lsl x0, x0, x1')
    else
      Line('  lsr x0, x0, x1');
  end
  else
  begin
    ains := '';
    if Op = boAdd then
      ains := 'addq %rcx, %rax'
    else if Op = boSub then
      ains := 'subq %rcx, %rax'
    else if Op = boMul then
      ains := 'imulq %rcx, %rax'
    else if Op = boAnd then
      ains := 'andq %rcx, %rax'
    else if Op = boOr then
      ains := 'orq %rcx, %rax'
    else if Op = boXor then
      ains := 'xorq %rcx, %rax'
    else if Op = boShl then
      ains := 'shlq %cl, %rax'
    else
      ains := 'shrq %cl, %rax';
    Line('  ' + ains);
  end;
  StorePlain(D);
end;

function ArithOp(Op: TBinOp): Boolean;
begin
  Result := (Op = boAdd) or (Op = boSub) or (Op = boMul) or (Op = boAnd) or
    (Op = boOr) or (Op = boXor) or (Op = boShl) or (Op = boShr);
end;

{ x := x op k for a narrow local or global x of this routine (1.0.117),
  amd64: in its slot, one instruction of its width (orb $8, v_b(%rip));
  in the register a run keeps it in, the word instruction, which leaves
  it clean for and, or and xor with a k that fits, and a cleanup after
  an add or a subtraction. SetBit(b, 3, 1) is b := b or 8: it took four
  instructions through the pool. }
function TEmitter.NarrowInPlace(S: PStmt): Boolean;
var
  d: TSym;
  e: PExpr;
  k: Int64;
  op, sfx: string;
begin
  Result := False;
  if FArm or (S = nil) or (S^.Dest = nil) or (S^.E = nil) or (S^.Dest^.Kind <> ekVar) then
    Exit;
  e := S^.E;
  if (e^.Kind <> ekBin) or (e^.L = nil) or (e^.R = nil) or (e^.L^.Kind <> ekVar) or
    (e^.R^.Kind <> ekInt) then
    Exit;
  if not TryFindSym(S^.Dest^.Name, d) then
    Exit;
  if d.ByRef or (d.Up > 0) then
    Exit;
  if (not IsNarrowId(d.Typ)) or (e^.Typ <> d.Typ) or (e^.L^.Name <> S^.Dest^.Name) then
    Exit;
  if e^.Bin = boAdd then
    op := 'add'
  else if e^.Bin = boSub then
    op := 'sub'
  else if e^.Bin = boAnd then
    op := 'and'
  else if e^.Bin = boOr then
    op := 'or'
  else if e^.Bin = boXor then
    op := 'xor'
  else
    Exit;
  k := WrapInt(e^.R^.Num, d.Typ);
  if d.Reg <> '' then
  begin
    if Fits32(k) then
      Line('  ' + op + 'q $' + IntToStr(k) + ', %' + d.Reg)
    else
      { a UInt32 constant with bit 31 set (1.0.147): no imm32 of the
        64-bit form sign-extends to it, and as refused andq $4294963199.
        The 32-bit form zero-extends into the whole register, which is
        the clean form of a UInt32 kept there. }
      Line('  ' + op + 'l $' + IntToStr(k) + ', %' + X86Sub(d.Reg, 4));
    if (e^.Bin = boAdd) or (e^.Bin = boSub) then
      CanonReg(d.Reg, d.Typ);
  end
  else
  begin
    if TSize(d.Typ) = 1 then
      sfx := 'b'
    else if TSize(d.Typ) = 2 then
      sfx := 'w'
    else
      sfx := 'l';
    Line('  ' + op + sfx + ' $' + IntToStr(k) + ', ' + MemA(d));
  end;
  Result := True;
end;

function TEmitter.FastAssign(S: PStmt): Boolean;
var
  dst, ls, rs: TSym;
  e: PExpr;
  k: Int64;
begin
  Result := False;
  if (S = nil) or (S^.Dest = nil) or (S^.E = nil) then
    Exit;
  if RotInPlace(S) or RotInPlaceMem(S) or NarrowInPlace(S) then
  begin
    Result := True;
    Exit;
  end;
  if not PlainOrd(S^.Dest, dst) then
    Exit;
  e := S^.E;
  { A narrow operation is cleaned in EmitExpr, not in place (P99). }
  if NarrowOp(e) then
    Exit;
  if e^.Kind = ekInt then
  begin
    if FArm and (dst.Reg <> '') then
      { arm64: straight into the variable's register (P290) }
      LoadImmR(dst.Reg, e^.Num)
    else if FArm then
    begin
      LoadImmR('x0', e^.Num);
      StorePlain(dst);
    end
    else if Fits32(e^.Num) then
      Line('  movq $' + IntToStr(e^.Num) + ', ' + MemA(dst))
    else
    begin
      LoadImmR('rax', e^.Num);
      StorePlain(dst);
    end;
    Result := True;
    Exit;
  end;
  if (e^.Kind = ekVar) and PlainOrd(e, rs) then
  begin
    if not SamePlace(dst, rs) then
    begin
      if FArm then
      begin
        { one move or one load or store where either has a register
          (P290) }
        if dst.Reg <> '' then
          LoadPlain(rs, dst.Reg)
        else if rs.Reg <> '' then
          StorePlainFrom(dst, rs.Reg)
        else
        begin
          LoadPlain(rs, 'x0');
          StorePlain(dst);
        end;
      end
      else if (dst.Reg <> '') or (rs.Reg <> '') then
        { one of them in a register: one move (1.1.1) }
        Line('  movq ' + MemA(rs) + ', ' + MemA(dst))
      else
      begin
        LoadPlain(rs, 'rax');
        StorePlain(dst);
      end;
    end;
    Result := True;
    Exit;
  end;
  { d := what p points to, a field or an element, d in a register
    (1.1.1; arm64 too since P290): the load goes into d's register, not
    through the pool }
  if (dst.Reg <> '') and
    ((e^.Kind = ekDeref) or (e^.Kind = ekField) or (e^.Kind = ekIndex)) and
    (not IsFat(e^.Typ)) and (not IsBlob(e^.Typ)) and (TSize(e^.Typ) <= 8) and
    WordMemOK(e, 0) then
  begin
    WordLoad(EmitWordMem(e, 0), LoadTyp(e), dst.Reg);
    if TSize(dst.Typ) < 8 then
      CanonReg(dst.Reg, dst.Typ);
    Result := True;
    Exit;
  end;
  { d := (a + b) shr k, the middle of a binary search (1.1.1): lea and
    a shift into d's register }
  if (dst.Reg <> '') and (e^.Kind = ekBin) and
    ((e^.Bin = boShr) or (e^.Bin = boShl)) and (TSize(e^.Typ) = 8) and
    (e^.R <> nil) and (e^.R^.Kind = ekInt) and (e^.R^.Num >= 0) and (e^.R^.Num <= 63) and
    (e^.L <> nil) and (e^.L^.Kind = ekBin) and (e^.L^.Bin = boAdd) and (TSize(e^.L^.Typ) = 8) and
    PlainOrd(e^.L^.L, ls) and PlainOrd(e^.L^.R, rs) and (ls.Reg <> '') and (rs.Reg <> '') then
  begin
    if FArm then
    begin
      Line('  add ' + dst.Reg + ', ' + ls.Reg + ', ' + rs.Reg);
      if e^.Bin = boShr then
        Line('  lsr ' + dst.Reg + ', ' + dst.Reg + ', #' + IntToStr(e^.R^.Num))
      else
        Line('  lsl ' + dst.Reg + ', ' + dst.Reg + ', #' + IntToStr(e^.R^.Num));
    end
    else
    begin
      Line('  leaq (%' + ls.Reg + ',%' + rs.Reg + '), %' + dst.Reg);
      if e^.Bin = boShr then
        Line('  shrq $' + IntToStr(e^.R^.Num) + ', %' + dst.Reg)
      else
        Line('  shlq $' + IntToStr(e^.R^.Num) + ', %' + dst.Reg);
    end;
    Result := True;
    Exit;
  end;
  if (e^.Kind = ekUn) and (e^.Un = uoNeg) and (e^.L <> nil) and
    PlainOrd(e^.L, rs) and SamePlace(dst, rs) then
  begin
    if FArm and (dst.Reg <> '') then
      Line('  neg ' + dst.Reg + ', ' + dst.Reg)
    else if FArm then
    begin
      LoadPlain(dst, 'x0');
      Line('  neg x0, x0');
      StorePlain(dst);
    end
    else
      Line('  negq ' + MemA(dst));
    Result := True;
    Exit;
  end;
  if (e^.Kind <> ekBin) or (not ArithOp(e^.Bin)) then
    Exit;
  if e^.Typ = TyBoolean then
    Exit;
  if (not SideOrd(e^.L, ls)) or (not SideOrd(e^.R, rs)) then
    Exit;
  if (e^.L^.Kind = ekVar) and SamePlace(dst, ls) and (e^.R^.Kind = ekInt) and
    InPlaceImm(dst, e^.Bin, e^.R^.Num) then
  begin
    Result := True;
    Exit;
  end;
  if (e^.Bin = boAdd) or (e^.Bin = boAnd) or (e^.Bin = boOr) or
    (e^.Bin = boXor) then
  begin
    if (e^.R^.Kind = ekVar) and SamePlace(dst, rs) and (e^.L^.Kind = ekInt) and
      InPlaceImm(dst, e^.Bin, e^.L^.Num) then
    begin
      Result := True;
      Exit;
    end;
  end;
  if (e^.L^.Kind = ekVar) and SamePlace(dst, ls) and (e^.R^.Kind = ekVar) and
    InPlaceReg(dst, e^.Bin, rs) then
  begin
    Result := True;
    Exit;
  end;
  if ((e^.Bin = boAdd) or (e^.Bin = boAnd) or (e^.Bin = boOr) or
    (e^.Bin = boXor)) and (e^.R^.Kind = ekVar) and SamePlace(dst, rs) and
    (e^.L^.Kind = ekVar) and InPlaceReg(dst, e^.Bin, ls) then
  begin
    Result := True;
    Exit;
  end;
  k := 0;
  if (e^.Bin = boSub) and (e^.R^.Kind = ekInt) then
  begin
    k := e^.R^.Num;
    if k < -9223372036854775807 then
    begin
      OrdInto(dst, e^.Bin, e^.L, e^.R);
      Result := True;
      Exit;
    end;
  end;
  OrdInto(dst, e^.Bin, e^.L, e^.R);
  Result := True;
end;

{ The condition codes of a comparison, arm64 spelling: the one that
  holds when WhenTrue, else its opposite. X86Jcc gives the x86 jump. }
function CondCC(Op: TBinOp; WhenTrue: Boolean): string;
begin
  if WhenTrue then
    case Op of
      boEq: Result := 'eq';
      boNe: Result := 'ne';
      boLt: Result := 'lt';
      boLe: Result := 'le';
      boGt: Result := 'gt';
    else
      Result := 'ge';
    end
  else
    case Op of
      boEq: Result := 'ne';
      boNe: Result := 'eq';
      boLt: Result := 'ge';
      boLe: Result := 'gt';
      boGt: Result := 'le';
    else
      Result := 'lt';
    end;
end;

function X86Jcc(const CC: string): string;
begin
  if CC = 'eq' then
    Result := 'je'
  else if CC = 'ne' then
    Result := 'jne'
  else if CC = 'lt' then
    Result := 'jl'
  else if CC = 'le' then
    Result := 'jle'
  else if CC = 'gt' then
    Result := 'jg'
  else
    Result := 'jge';
end;

{ ---- An if of a word assignment as a select (P307) ----

  if c then x := e, and if c then x := e else x := f, are a compare and
  a conditional select where Go's branchelim makes them one
  (cmd/compile/internal/ssacompile/branchelim.go): the arm of an if
  without an else at most two instructions that read no memory, divide
  nothing and call nothing (elimIf's maxfuseinsts 2 and
  canSpeculativelyExecute), each arm of an if with one at most one
  (elimIfElse), x a word of 64 bits (amd64's CMOV takes no byte,
  canCondSelect), one variable a side (shouldElimIfElse's one phi on
  amd64), and x a register or a local nothing else reaches (OwnLocal):
  Go's phis are SSA values, never memory. An e that is the compare's
  side, as if a[i] > m then m := a[i] or if p^.next <> nil then
  p := p^.next, is one value for Go's CSE: worked out once for the
  compare, its load done whether or not the condition holds, so any e.
  Else e and an f that is an instruction are worked out first into the
  pool, then the compare sets
  the flags, then nothing that writes them comes before the select: a
  leaf f and x go to their registers by MOV, LDR or MOVZ, never by a
  zeroing xor. On amd64 CMOVcc (SDM vol. 2A 3-157: the move happens when
  the condition holds, the flags untouched), on arm64 CSEL (ARM DDI 0487
  M.c C6.2.138), CSINC when an arm adds one to a variable and CINC when
  the other arm is that variable (C6.2.141, C6.2.86; Go's ARM64.rules
  turn a CSEL of an ADDconst [1] into them), XZR for a zero (Go's
  CSEL0); so a branch the data makes unpredictable costs nothing. Go's
  count of a list's values equal to k is CMP and CINC EQ on arm64, SETE
  and CMOVNE on amd64 (go tool objdump). }

{ A leaf a select reads with no instruction of its own or with one move:
  a constant, a character, nil, a word variable. }
function TEmitter.SpecLeaf(E: PExpr): Boolean;
var
  s: TSym;
begin
  Result := (E <> nil) and ((E^.Kind = ekInt) or (E^.Kind = ekNil) or
    ((E^.Kind = ekStr) and (Length(E^.Txt) = 1)) or
    ((E^.Kind = ekVar) and WordVar(E, s)));
end;

{ The instructions E takes when it can be worked out before its
  condition holds, as Go's canSpeculativelyExecute, -1 when it cannot:
  leaves and adds, subs, ands, ors and xors of words, no load, no
  division, no pointer arithmetic, no narrow operation that a cleanup
  follows. }
function TEmitter.SpecOps(E: PExpr): LongInt;
var
  l, r: LongInt;
begin
  Result := -1;
  if E = nil then
    Exit;
  if SpecLeaf(E) then
  begin
    Result := 0;
    Exit;
  end;
  if not ((E^.Kind = ekBin) and (E^.L <> nil) and (E^.R <> nil) and
    (TKind(E^.Typ) <> tykPointer) and ((E^.Bin = boAdd) or (E^.Bin = boSub) or
    (E^.Bin = boAnd) or (E^.Bin = boOr) or (E^.Bin = boXor)) and
    (not NarrowOp(E)) and (TSize(E^.Typ) = 8)) then
    Exit;
  l := SpecOps(E^.L);
  r := SpecOps(E^.R);
  if (l >= 0) and (r >= 0) then
    Result := l + r + 1;
end;

{ S is one assignment of a word variable X of 64 bits, X := V, or an Inc
  or a Dec of one (V then X + k or X - k). }
function TEmitter.SelTarget(S: PStmt; out X: TSym; out V: PExpr): Boolean;
var
  d: PExpr;
  k: TTypeKind;
begin
  Result := False;
  V := nil;
  if (S <> nil) and (S^.Kind = skBlock) and (Length(S^.Stmts) = 1) then
    S := S^.Stmts[0];
  if S = nil then
    Exit;
  d := S^.Dest;
  if (S^.Kind <> skAssign) and (S^.Kind <> skInc) and (S^.Kind <> skDec) then
    Exit;
  if (d = nil) or (d^.Kind <> ekVar) or (not WordVar(d, X)) or (TSize(X.Typ) <> 8) then
    Exit;
  k := TKind(X.Typ);
  if not ((k = tykInteger) or (k = tykEnum) or (k = tykSubrange) or (k = tykPointer) or
    (k = tykClass)) then
    Exit;
  if S^.Kind = skAssign then
    V := S^.E
  else
  begin
    if S^.E = nil then
      V := NewInt(1)
    else
      V := S^.E;
    if S^.Kind = skInc then
      V := NewBin(boAdd, d, V)
    else
      V := NewBin(boSub, d, V);
    V^.Typ := X.Typ;
  end;
  Result := V <> nil;
end;

{ S is a local of this routine nothing else reaches while it runs, as a
  value of Go's SSA is: not a global, not reached by reference or from a
  nested routine (which pas can start on another thread), its address
  not taken; P289's rule. A select in memory writes it back whether its
  condition held or not, which only such a variable cannot tell. }
function TEmitter.OwnLocal(const S: TSym): Boolean;
var
  k: SizeInt;
begin
  Result := (not S.Global) and (not S.ByRef) and (S.Up = 0) and (not S.Boxed) and
    (not LocAddrTaken(S.Name));
  if Result then
    for k := 0 to High(FProgProcs) do
      if FProgProcs[k].ParentSym = FCurProc then
        Result := False;
end;

{ The sides of the comparison E as CondFlags compares them, A with B by
  Op: a constant on the left goes to the right with the comparison
  turned round, as CondJmp's (P290), so it is CMP's immediate; so does
  the side Pref is when Pref is the right one, so its value is the
  register CondFlags gives back. }
procedure TEmitter.CondSides(E, Pref: PExpr; out A, B: PExpr; out Op: TBinOp);
var
  k: Int64;
begin
  A := E^.L;
  B := E^.R;
  Op := E^.Bin;
  if (ConstOf(A, k) and not ConstOf(B, k)) or
    ((Pref <> nil) and SameExpr(Pref, B) and not SameExpr(Pref, A)) then
  begin
    A := E^.R;
    B := E^.L;
    case Op of
      boLt: Op := boGt;
      boLe: Op := boGe;
      boGt: Op := boLt;
      boGe: Op := boLe;
    end;
  end;
end;

{ E is a comparison of two words CondFlags sets the flags for: its left
  side in pool register D, its right side a leaf or pool register D+1;
  with Pref, the left side is Pref. }
function TEmitter.CondFlagsOK(E: PExpr; D: LongInt; Pref: PExpr): Boolean;
var
  k: TTypeKind;
  a, b: PExpr;
  op: TBinOp;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekBin) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  if (E^.Bin <> boEq) and (E^.Bin <> boNe) and (E^.Bin <> boLt) and
    (E^.Bin <> boLe) and (E^.Bin <> boGt) and (E^.Bin <> boGe) then
    Exit;
  CondSides(E, Pref, a, b, op);
  if (Pref <> nil) and not SameExpr(Pref, a) then
    Exit;
  k := TKind(a^.Typ);
  if not ((k = tykInteger) or (k = tykEnum) or (k = tykSubrange) or (k = tykPointer) or
    (k = tykClass)) then
    Exit;
  if IsFat(a^.Typ) or IsFat(b^.Typ) or (TKind(b^.Typ) = tykSet) or
    (TKind(b^.Typ) = tykReal) then
    Exit;
  Result := OrdSimple(a, D) and (OrdLeaf(b) or OrdSimple(b, D + 1));
end;

{ arm64, the routine's text from From (P322): a TST of one bit and the
  B.EQ or B.NE after it are one TBZ or TBNZ (ARM DDI 0487 C6.2.479 and
  C6.2.478, the bit's number and a label within 32 KiB, the flags not
  written), as Go writes a test of one bit (ARM64.rules, TBZ and TBNZ),
  where the label is the routine's and within reach by a count of its
  instructions (a .p2align its most padding), which GNU as does not
  relax, and the flags the TST wrote are read neither after the branch
  nor at its label: on each path the first instruction that touches
  them writes them all, or is a call or a return. }
procedure TEmitter.TbzPass(From: SizeInt);
var
  ls: TStrArray;
  at: array of Int64;
  drop: array of Boolean;
  i, j, n, b, e, k, bit, q, st: SizeInt;
  t, op, tgt, reg, hx, out1: string;
  v, w: Int64;
  d: LongInt;
  changed: Boolean;

  function FindLab(const L: string): SizeInt;
  var
    x: SizeInt;
  begin
    Result := -1;
    for x := 0 to n - 1 do
      if ls[x] = L + ':' then
      begin
        Result := x;
        Exit;
      end;
  end;

  { the flags are dead from line x on, on this path: before any reader,
    a write of all of them, a call or a return; a B followed to its
    label, four deep }
  function Dead(x: SizeInt; Depth: LongInt): Boolean;
  var
    o: string;
    p, y: SizeInt;
  begin
    Result := False;
    while x < n do
    begin
      { a label joins other paths to this one, whose flags it does not
        read: passed, as a directive is }
      if (ls[x] = '') or (Copy(ls[x], 1, 3) = '  .') or
        ((ls[x][1] <> ' ') and (ls[x][Length(ls[x])] = ':')) then
      begin
        Inc(x);
        Continue;
      end;
      if (Length(ls[x]) < 3) or (ls[x][1] <> ' ') then
        Exit;
      p := 3;
      while (p <= Length(ls[x])) and (ls[x][p] <> ' ') do
        Inc(p);
      o := Copy(ls[x], 3, p - 3);
      if (o = 'cmp') or (o = 'cmn') or (o = 'tst') or (o = 'adds') or (o = 'subs') or
        (o = 'ands') or (o = 'bics') or (o = 'fcmp') or (o = 'fcmpe') or (o = 'bl') or
        (o = 'blr') or (o = 'ret') then
      begin
        Result := True;
        Exit;
      end;
      if (o = 'b') and (Depth < 4) and (p < Length(ls[x])) then
      begin
        y := FindLab(Copy(ls[x], p + 1, Length(ls[x]) - p));
        if y >= 0 then
          Result := Dead(y + 1, Depth + 1);
        Exit;
      end;
      if (o = 'b') or (Copy(o, 1, 2) = 'b.') or (o = 'cbz') or (o = 'cbnz') or (o = 'tbz') or
        (o = 'tbnz') or (o = 'br') or (Copy(o, 1, 2) = 'cs') or (Copy(o, 1, 2) = 'ci') or
        (Copy(o, 1, 2) = 'cn') or (Copy(o, 1, 3) = 'adc') or (Copy(o, 1, 3) = 'sbc') or
        (Copy(o, 1, 2) = 'cc') or (o = 'fcsel') or (o = 'mrs') then
        Exit;
      Inc(x);
    end;
  end;

begin
  if FLen <= From then
    Exit;
  { the routine's lines }
  ls := nil;
  n := 0;
  st := From + 1;
  for q := From + 1 to FLen do
    if FOut[q] = Char(10) then
    begin
      SetLength(ls, n + 1);
      ls[n] := Copy(FOut, st, q - st);
      Inc(n);
      st := q + 1;
    end;
  if n < 3 then
    Exit;
  { where each line starts, in bytes at most: an instruction 4, a
    .p2align its most padding }
  SetLength(at, n + 1);
  SetLength(drop, n);
  at[0] := 0;
  for i := 0 to n - 1 do
  begin
    t := ls[i];
    k := 0;
    if Copy(t, 1, 11) = '  .p2align ' then
    begin
      d := 0;
      j := 12;
      while (j <= Length(t)) and (t[j] >= '0') and (t[j] <= '9') do
      begin
        d := d * 10 + (Ord(t[j]) - Ord('0'));
        Inc(j);
      end;
      if d > 12 then
        d := 12;
      k := SizeInt(1) shl d;
    end
    else if (Length(t) > 3) and (t[1] = ' ') and (t[2] = ' ') and (t[3] <> '.') then
      k := 4;
    at[i + 1] := at[i] + k;
    drop[i] := False;
  end;
  changed := False;
  for i := 0 to n - 2 do
  begin
    t := ls[i];
    if Copy(t, 1, 6) <> '  tst ' then
      Continue;
    j := Pos(', #0x', t);
    if j = 0 then
      Continue;
    reg := Copy(t, 7, j - 7);
    hx := Copy(t, j + 5, Length(t) - j - 4);
    if (Length(reg) < 2) or (reg[1] <> 'x') or (Length(hx) <> 16) then
      Continue;
    { the immediate, one bit's }
    v := 0;
    for q := 1 to 16 do
    begin
      if (hx[q] >= '0') and (hx[q] <= '9') then
        d := Ord(hx[q]) - Ord('0')
      else if (hx[q] >= 'a') and (hx[q] <= 'f') then
        d := Ord(hx[q]) - Ord('a') + 10
      else
        d := -1;
      if d < 0 then
      begin
        v := 0;
        Break;
      end;
      v := (v shl 4) or d;
    end;
    bit := -1;
    w := 1;
    for q := 0 to 63 do
    begin
      if v = w then
        bit := q;
      w := w shl 1;
    end;
    if bit < 0 then
      Continue;
    op := ls[i + 1];
    if Copy(op, 1, 7) = '  b.eq ' then
      b := 0
    else if Copy(op, 1, 7) = '  b.ne ' then
      b := 1
    else
      Continue;
    tgt := Copy(op, 8, Length(op) - 7);
    e := FindLab(tgt);
    if e < 0 then
      Continue;
    if Abs(at[e] - at[i]) > 32000 then
      Continue;
    if not (Dead(i + 2, 0) and Dead(e + 1, 0)) then
      Continue;
    if b = 0 then
      ls[i] := '  tbz ' + reg + ', #' + IntToStr(bit) + ', ' + tgt
    else
      ls[i] := '  tbnz ' + reg + ', #' + IntToStr(bit) + ', ' + tgt;
    drop[i + 1] := True;
    changed := True;
  end;
  if not changed then
    Exit;
  out1 := '';
  for i := 0 to n - 1 do
    if not drop[i] then
      out1 := out1 + ls[i] + Char(10);
  { the text after the last line end, if any, stays after the new lines }
  out1 := out1 + Copy(FOut, st, FLen - st + 1);
  if From + Length(out1) + 1 > Length(FOut) then
    SetLength(FOut, From + Length(out1) + 4096);
  if Length(out1) > 0 then
    Move(out1[1], FOut[From + 1], Length(out1));
  FLen := From + Length(out1);
end;

{ arm64, the routine's text from From (P331): adrp x16, v; add x16, x16,
  :lo12:v and a load or a store through x16 at an offset are adrp and the
  access with the low twelve bits, adrp x16, v+8 and ldr x1, [x16,
  :lo12:v+8] (the page of the word itself, which may be the next), as Go's
  assembler writes MOVD v(SB), R1 (cmd/internal/obj/arm64, a symbol's
  load: ADRP and LDR with R_AARCH64_LDST64_ABS_LO12_NC), one instruction
  fewer, where x16 is dead after the access: before any other read of
  it, a write of it, a call or a return on that line's path, no label a
  jump reaches or branch between (a line label is the line table's, as
  its .loc is: P346). Only a program's or a unit's global, v_ whose start
  lies on 8 or more (GlobAlign), at an offset of the access's size, so
  the scaled offset the relocation needs (ARM DDI 0487 M.c C6.2.216 LDR
  immediate, unsigned offset; the ELF for the Arm 64-bit Architecture:
  LDST8, 16, 32 and 64 ABS_LO12_NC) holds. }
procedure TEmitter.AdrpPass(From: SizeInt);
var
  ls: TStrArray;
  drop: array of Boolean;
  i, j, n, q, st, p: SizeInt;
  t, sym, op, rt, mem, offs, out1: string;
  sz: LongInt;
  off: Int64;
  changed, dead, ok: Boolean;
begin
  if FLen <= From then
    Exit;
  ls := nil;
  n := 0;
  st := From + 1;
  for q := From + 1 to FLen do
    if FOut[q] = Char(10) then
    begin
      SetLength(ls, n + 1);
      ls[n] := Copy(FOut, st, q - st);
      Inc(n);
      st := q + 1;
    end;
  if n < 3 then
    Exit;
  SetLength(drop, n);
  for i := 0 to n - 1 do
    drop[i] := False;
  changed := False;
  for i := 0 to n - 3 do
  begin
    t := ls[i];
    if Copy(t, 1, 14) <> '  adrp x16, v_' then
      Continue;
    sym := Copy(t, 13, Length(t) - 12);
    if ls[i + 1] <> '  add x16, x16, :lo12:' + sym then
      Continue;
    { the access: op Rt, [x16] or [x16, #imm] }
    t := ls[i + 2];
    p := Pos(' ', Copy(t, 3, Length(t)));
    if p = 0 then
      Continue;
    op := Copy(t, 3, p - 1);
    sz := 0;
    if (op = 'ldr') or (op = 'str') then
    begin
      if Copy(t, p + 3, 1) = 'x' then
        sz := 8
      else if Copy(t, p + 3, 1) = 'w' then
        sz := 4;
    end
    else if (op = 'ldrb') or (op = 'strb') or (op = 'ldrsb') then
      sz := 1
    else if (op = 'ldrh') or (op = 'strh') or (op = 'ldrsh') then
      sz := 2
    else if op = 'ldrsw' then
      sz := 4;
    if sz = 0 then
      Continue;
    j := Pos(', [x16', t);
    if j = 0 then
      Continue;
    rt := Copy(t, p + 3, j - p - 3);
    if (rt = 'x16') or (rt = 'w16') or (Pos(' ', rt) > 0) then
      Continue;
    mem := Copy(t, j + 2, Length(t) - j - 1);
    off := 0;
    ok := True;
    if mem = '[x16]' then
      off := 0
    else if (Copy(mem, 1, 7) = '[x16, #') and (mem[Length(mem)] = ']') then
    begin
      offs := Copy(mem, 8, Length(mem) - 8);
      if not StrToInt64(offs, off) then
        ok := False;
    end
    else
      ok := False;
    if (not ok) or (off < 0) or (off >= 4096) or (off mod sz <> 0) then
      Continue;
    { x16 dead after the access }
    dead := False;
    q := i + 3;
    while q < n do
    begin
      t := ls[q];
      if (t = '') or (Copy(t, 1, 3) = '  .') or ((Length(t) > 4) and (Copy(t, 1, 3) = '.LL') and
        (t[Length(t)] = ':')) then
      begin
        Inc(q);
        Continue;
      end;
      if (t[1] <> ' ') or (Copy(t, 1, 4) = '  b ') or (Copy(t, 1, 4) = '  b.') or
        (Copy(t, 1, 5) = '  cbz') or (Copy(t, 1, 6) = '  cbnz') or (Copy(t, 1, 5) = '  tbz') or
        (Copy(t, 1, 6) = '  tbnz') or (Copy(t, 1, 5) = '  br ') then
        Break;
      if (Copy(t, 1, 5) = '  bl ') or (Copy(t, 1, 6) = '  blr ') or (t = '  ret') then
      begin
        dead := Pos('x16', t) = 0;
        Break;
      end;
      if Pos('x16', t) = 0 then
      begin
        Inc(q);
        Continue;
      end;
      { the first that names x16: a write of it alone, and no read }
      dead := ((Copy(t, 1, 12) = '  adrp x16, ') or (Copy(t, 1, 11) = '  mov x16, ') or
        (Copy(t, 1, 12) = '  movz x16, ') or (Copy(t, 1, 11) = '  ldr x16, ')) and
        (Pos('x16', Copy(t, 12, Length(t))) = 0);
      Break;
    end;
    if not dead then
      Continue;
    if off = 0 then
      ls[i + 2] := '  ' + op + ' ' + rt + ', [x16, :lo12:' + sym + ']'
    else
    begin
      { the page of the word itself: v_s+8 may lie on the next page
        (v_s at 0x43fff8 in chr), which adrp of v_s does not reach }
      ls[i] := '  adrp x16, ' + sym + '+' + IntToStr(off);
      ls[i + 2] := '  ' + op + ' ' + rt + ', [x16, :lo12:' + sym + '+' + IntToStr(off) + ']';
    end;
    drop[i + 1] := True;
    changed := True;
  end;
  if not changed then
    Exit;
  out1 := '';
  for i := 0 to n - 1 do
    if not drop[i] then
      out1 := out1 + ls[i] + Char(10);
  out1 := out1 + Copy(FOut, st, FLen - st + 1);
  if From + Length(out1) + 1 > Length(FOut) then
    SetLength(FOut, From + Length(out1) + 4096);
  if Length(out1) > 0 then
    Move(out1[1], FOut[From + 1], Length(out1));
  FLen := From + Length(out1);
end;

{ E is (x and c) = 0 or <> 0, either way round: A the and (P322). }
function TEmitter.AndZero(E: PExpr; out A: PExpr): Boolean;
var
  z: PExpr;
begin
  Result := False;
  A := nil;
  if (E = nil) or (E^.Kind <> ekBin) or ((E^.Bin <> boEq) and (E^.Bin <> boNe)) or
    (E^.L = nil) or (E^.R = nil) then
    Exit;
  A := E^.L;
  z := E^.R;
  if not ((z^.Kind = ekInt) and (z^.Num = 0)) then
  begin
    A := E^.R;
    z := E^.L;
  end;
  if not ((z^.Kind = ekInt) and (z^.Num = 0)) then
    Exit;
  Result := (A^.Kind = ekBin) and (A^.Bin = boAnd) and (A^.Typ <> TyBoolean) and
    (A^.L <> nil) and (A^.R <> nil) and (TKind(A^.Typ) = tykInteger);
end;

{ The flags of A, x and c, against 0 with no AND written (P322): Go's
  (CMPQconst (ANDQconst [c] x) [0]) => (TESTQconst [c] x) (AMD64.rules
  1398-1403), TST on arm64. 1 when ZF answers it (zero when the and is),
  2 when CF does, a BT of the one bit of c past bit 31 that TEST's imm32
  cannot name (AMD64.rules 625-636), only with AllowBit; 0 with nothing
  written when neither fits. c a constant: TEST of the narrowest that
  holds it, a byte up to 255 (testb, of the low byte), 32 bits up to
  2^32 - 1 (testl: TEST of 64 bits sign-extends its imm32), 64 for a
  negative one an imm32 holds; of x's register, of x at its home (that
  much of it, little-endian) or of the pool after x. A narrow x is clean
  in its register, extended as its type is, and c a constant of its type
  extended alike, so the test of the words answers the narrow and. A
  constant neither TEST nor BT takes goes into rax for a TEST of two
  registers. c a variable a register keeps beside one: TEST of the two
  registers.
  TEST and a jump fuse (AMD 56665 2.9.3 Branch Fusion, Intel 248966
  3.4.2.2 Table 3-2); BT is in neither list, so it is only for the bits
  TEST cannot reach. }
function TEmitter.AndTest(A: PExpr; D: LongInt; AllowBit: Boolean): LongInt;
var
  x, y, t: PExpr;
  c: Int64;
  s: TSym;
  reg, op, ry: string;
  tw, sz, k: LongInt;
begin
  Result := 0;
  x := A^.L;
  y := A^.R;
  if ConstOf(x, c) and not ConstOf(y, c) then
  begin
    t := x;
    x := y;
    y := t;
  end;
  if ConstOf(y, c) then
  begin
    if FArm then
    begin
      reg := WordReg(x);
      if reg = '' then
      begin
        if not OrdSimple(x, D) then
          Exit;
        EmitOrdTo(x, D);
        reg := OrdPool(D);
      end;
      if ArmLogImm(c) then
        Line('  tst ' + reg + ', #' + HexWord(c))
      else
      begin
        Imm('x17', c);
        Line('  tst ' + reg + ', x17');
      end;
      Result := 1;
      Exit;
    end;
    k := -1;
    if (c >= 0) and (c <= 255) then
      tw := 1
    else if (c >= 0) and (c <= 4294967295) then
      tw := 4
    else if Fits32(c) then
      tw := 8
    else if AllowBit and (c > 0) and ((c and (c - 1)) = 0) then
    begin
      tw := 0;
      k := 0;
      while (Int64(1) shl k) <> c do
        Inc(k);
    end
    else
      tw := 9;
    case tw of
      1: op := 'testb $' + IntToStr(c) + ', ';
      4: op := 'testl $' + IntToStr(c) + ', ';
      8: op := 'testq $' + IntToStr(c) + ', ';
      9: op := 'testq %rax, ';
    else
      op := 'btq $' + IntToStr(k) + ', ';
    end;
    { a constant no TEST takes and no BT names goes into rax, after x is
      worked out, which may take rax itself: TEST of the two registers,
      as Go's (TESTQ (MOVQconst [c]) x) when c is no imm32 }
    sz := tw;
    if (sz = 0) or (sz = 9) then
      sz := 8;
    reg := WordReg(x);
    if reg <> '' then
    begin
      if tw = 9 then
        Line('  movabsq $' + IntToStr(c) + ', %rax');
      Line('  ' + op + '%' + X86Sub(reg, sz));
    end
    else if (x^.Kind = ekVar) and WordVar(x, s) and (s.Reg = '') and (TSize(s.Typ) >= sz) and
      ((tw = 1) or (tw = 4) or (TSize(s.Typ) = 8)) then
    begin
      { the variable at its home: TEST of a memory operand reads it
        (SDM vol. 2B TEST), BT of a memory operand with an immediate the
        bit within it }
      if tw = 9 then
        Line('  movabsq $' + IntToStr(c) + ', %rax');
      Line('  ' + op + MemA(s));
    end
    else
    begin
      if not OrdSimple(x, D) then
        Exit;
      EmitOrdTo(x, D);
      if tw = 9 then
        Line('  movabsq $' + IntToStr(c) + ', %rax');
      Line('  ' + op + '%' + X86Sub(OrdPool(D), sz));
    end;
    if tw = 0 then
      Result := 2
    else
      Result := 1;
    Exit;
  end;
  reg := WordReg(x);
  ry := WordReg(y);
  if (reg = '') or (ry = '') then
    Exit;
  if FArm then
    Line('  tst ' + reg + ', ' + ry)
  else
    Line('  testq %' + ry + ', %' + reg);
  Result := 1;
end;

{ The flags of the comparison E, and the comparison they answer: its
  left side into pool register D, or the register a region keeps it in,
  which Side gives back, and one CMP, the right side its immediate where
  the instruction takes one (P306). }
function TEmitter.CondFlags(E: PExpr; D: LongInt; Pref: PExpr; out Side: string): TBinOp;
var
  a, b, z: PExpr;
  k: Int64;
  l: string;
  f: LongInt;
begin
  CondSides(E, Pref, a, b, Result);
  { (x and c) = 0 is one TEST or TST when the select reads no side (Pref,
    P322), or a BT whose answer is the carry (FCondCarry) }
  FCondCarry := False;
  if (Pref = nil) and AndZero(E, z) then
  begin
    f := AndTest(z, D, not FArm);
    if f > 0 then
    begin
      FCondCarry := f = 2;
      Side := '';
      Exit;
    end;
  end;
  { a variable a region keeps is compared in its register (P303) }
  l := WordReg(a);
  if l = '' then
  begin
    EmitOrdTo(a, D);
    l := OrdPool(D);
  end;
  if FArm then
  begin
    if ConstOf(b, k) and ((ArmAddImm(k) <> '') or
      ((k < 0) and (k > Low(Int64)) and (ArmAddImm(-k) <> ''))) then
      CmpImmArm(l, k, 'x17')
    else
      Line('  cmp ' + l + ', ' + OrdOperand(b, D));
  end
  else if ConstOf(b, k) and (k = 0) then
    Line('  testq %' + l + ', %' + l)
  else
    Line('  cmpq ' + OrdOperand(b, D) + ', %' + l);
  Side := l;
end;

{ The leaf F into register R with no write of the flags: MOV, MOVZ and
  MOVK, LDR, never xor's zero. }
procedure TEmitter.SelLoad(F: PExpr; const R: string);
var
  s: TSym;
  k: Int64;
begin
  if (F^.Kind = ekVar) and WordVar(F, s) then
  begin
    if s.Reg <> R then
      LoadWordVar(s, R);
    Exit;
  end;
  if not ConstOf(F, k) then
    Die('internal error: a select''s leaf');
  if FArm then
    Imm(R, k)
  else if Fits32(k) then
    Line('  movq $' + IntToStr(k) + ', %' + R)
  else
    Line('  movabsq $' + IntToStr(k) + ', %' + R);
end;

{ The register a select reads the leaf F from: the one a region keeps
  the variable in, xzr for a zero on arm64 (Go's CSEL0), else Spare
  after SelLoad. }
function TEmitter.SelReg(F: PExpr; const Spare: string): string;
var
  k: Int64;
begin
  Result := WordReg(F);
  if Result <> '' then
    Exit;
  if FArm and ConstOf(F, k) and (k = 0) then
  begin
    Result := 'xzr';
    Exit;
  end;
  SelLoad(F, Spare);
  Result := Spare;
end;

{ E is A + 1 or 1 + A, A a word variable: on arm64 CSINC adds the one
  itself, as Go's ARM64.rules turn a CSEL of an ADDconst [1] into one
  (ARM DDI 0487 M.c C6.2.141; CINC, C6.2.86, when both sources are A). }
function TEmitter.IncOne(E: PExpr; out A: PExpr): Boolean;
var
  k: Int64;
begin
  Result := False;
  A := nil;
  if (E = nil) or (E^.Kind <> ekBin) or (E^.Bin <> boAdd) or (E^.L = nil) or
    (E^.R = nil) then
    Exit;
  if (E^.L^.Kind = ekVar) and ConstOf(E^.R, k) and (k = 1) then
    A := E^.L
  else if (E^.R^.Kind = ekVar) and ConstOf(E^.L, k) and (k = 1) then
    A := E^.R;
  Result := (A <> nil) and SpecLeaf(A);
end;

{ The variables whose value goes into the address of a load in the body
  being emitted, as the loadAddr of Go's branchelim: a pointer that is
  dereferenced, a class reference whose field is read, an index, and
  what an assignment to one of them reads, to a fixed point; a store's
  address is none. A select would make such a load wait for its compare
  where a predicted branch lets it start at once (canCondSelect, Go's
  issue 26306): if p^.next <> nil then p := p^.next stays a branch. }
procedure TEmitter.SelBodyIs(B: PStmt);
begin
  FSelBody := B;
  FLoadDone := False;
  FLoadAddr := nil;
end;

procedure TEmitter.LoadAddrE(E: PExpr; InAddr: Boolean);
var
  i: SizeInt;
begin
  if E = nil then
    Exit;
  case E^.Kind of
    ekVar:
      if InAddr and not InNames(FLoadAddr, ToLower(E^.Name)) then
      begin
        AddName(FLoadAddr, ToLower(E^.Name));
        FLoadGrew := True;
      end;
    ekDeref, ekField:
      LoadAddrE(E^.L, True);
    ekIndex:
      begin
        LoadAddrE(E^.L, True);
        LoadAddrE(E^.R, True);
      end;
    ekAddr:
      LoadAddrPlace(E^.L);
  else
    begin
      LoadAddrE(E^.L, InAddr);
      LoadAddrE(E^.R, InAddr);
      for i := 0 to High(E^.Args) do
        LoadAddrE(E^.Args[i], False);
    end;
  end;
end;

{ The place D is written or its address taken: what it reads is read,
  its own address is no load's. }
procedure TEmitter.LoadAddrPlace(D: PExpr);
begin
  if D = nil then
    Exit;
  case D^.Kind of
    ekIndex:
      begin
        LoadAddrPlace(D^.L);
        LoadAddrE(D^.R, False);
      end;
    ekField:
      LoadAddrPlace(D^.L);
    ekDeref:
      LoadAddrE(D^.L, False);
  else
    LoadAddrE(D, False);
  end;
end;

procedure TEmitter.LoadAddrS(S: PStmt);
var
  i: SizeInt;
  flows: Boolean;
begin
  if S = nil then
    Exit;
  { what is assigned to a variable a load's address comes from is one
    too: Go follows a value's integer and pointer arguments }
  flows := False;
  if ((S^.Kind = skAssign) or (S^.Kind = skInc) or (S^.Kind = skDec)) and
    (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) then
    flows := InNames(FLoadAddr, ToLower(S^.Dest^.Name))
  else if (S^.Kind = skFor) or (S^.Kind = skForIn) then
    flows := InNames(FLoadAddr, ToLower(S^.Name));
  LoadAddrPlace(S^.Dest);
  LoadAddrE(S^.E, flows);
  LoadAddrE(S^.E2, flows);
  for i := 0 to High(S^.Args) do
    LoadAddrE(S^.Args[i], False);
  LoadAddrS(S^.ThenSt);
  LoadAddrS(S^.ElseSt);
  LoadAddrS(S^.Body);
  for i := 0 to High(S^.Stmts) do
    LoadAddrS(S^.Stmts[i]);
  for i := 0 to High(S^.Arms) do
    LoadAddrS(S^.Arms[i].Body);
  for i := 0 to High(S^.Sels) do
  begin
    LoadAddrE(S^.Sels[i].Chan, False);
    LoadAddrE(S^.Sels[i].ValX, False);
    LoadAddrS(S^.Sels[i].Body);
  end;
end;

{ S is one of FLoadAddr, worked out for the body the first time a select
  asks. }
function TEmitter.LoadAddrSym(const S: TSym): Boolean;
begin
  if not FLoadDone then
  begin
    FLoadAddr := nil;
    repeat
      FLoadGrew := False;
      LoadAddrS(FSelBody);
    until not FLoadGrew;
    FLoadDone := True;
  end;
  Result := InNames(FLoadAddr, ToLower(S.Name));
  if (not Result) and FHasRes and (not S.Global) and (S.Off = FResOff) then
    Result := InNames(FLoadAddr, 'result') or InNames(FLoadAddr, ToLower(FResName));
end;

{ if c then x := e [else x := f] as a select, when Go's branchelim would
  make one (above); False with nothing written when not. }
function TEmitter.EmitSelectIf(S: PStmt): Boolean;
var
  x, x2, s2: TSym;
  e, f, a, fa, pref: PExpr;
  xc, src, ev, dst, l: string;
  two, one, onef, fop, same: Boolean;
  op: TBinOp;
  k: Int64;
  d, n: LongInt;
begin
  Result := False;
  if (S = nil) or (S^.E = nil) or FDebug then
    Exit;
  if not SelTarget(S^.ThenSt, x, e) then
    Exit;
  { in memory x is written back whether the condition held or not }
  if (x.Reg = '') and not OwnLocal(x) then
    Exit;
  if LoadAddrSym(x) then
    Exit;
  two := not NoStmt(S^.ElseSt);
  n := 2;
  if two then
    n := 1;
  if (S^.E^.Kind <> ekBin) or (S^.E^.L = nil) or (S^.E^.R = nil) then
    Exit;
  { e the compare's side: its register once the compare is done }
  same := (WordReg(e) = '') and (not ConstOf(e, k)) and
    (SameExpr(e, S^.E^.L) or SameExpr(e, S^.E^.R));
  pref := nil;
  if same then
    pref := e
  else if (SpecOps(e) < 0) or (SpecOps(e) > n) or not OrdSimple(e, 0) then
    Exit;
  f := nil;
  if two then
  begin
    if not SelTarget(S^.ElseSt, x2, f) then
      Exit;
    if (x.Global <> x2.Global) or (not SamePlace(x, x2)) or (SpecOps(f) < 0) or
      (SpecOps(f) > 1) then
      Exit;
  end;
  one := FArm and (not same) and IncOne(e, a);
  onef := FArm and two and (not one) and IncOne(f, fa);
  { an f that is an instruction is worked out into pool register 1 before
    the compare, which then starts at 2 }
  fop := two and (not SpecLeaf(f)) and (not onef);
  d := 1;
  if fop then
  begin
    d := 2;
    if not OrdSimple(f, 1) then
      Exit;
  end;
  if not CondFlagsOK(S^.E, d, pref) then
    Exit;
  Result := True;
  if one then
    e := a;
  src := '';
  { the then value: a leaf in the register a region keeps it in or arm64's
    zero register as it is, else worked out into pool register 0; on
    amd64 the else value goes into x's register before CMOV reads it }
  if not same then
  begin
    src := WordReg(e);
    if FArm and (src = '') and ConstOf(e, k) and (k = 0) then
      src := 'xzr';
    if (not FArm) and two and (src = x.Reg) then
      src := '';
    if src = '' then
    begin
      EmitOrdTo(e, 0);
      src := OrdPool(0);
    end;
  end;
  if fop then
    EmitOrdTo(f, 1);
  op := CondFlags(S^.E, d, pref, l);
  if same then
    src := l;
  if FArm then
  begin
    dst := x.Reg;
    if dst = '' then
      dst := 'x17';
    if fop then
      ev := OrdPool(1)
    else if onef then
      ev := SelReg(fa, 'x17')
    else if two then
      ev := SelReg(f, 'x17')
    else if x.Reg <> '' then
      ev := x.Reg
    else if one and (e^.Kind = ekVar) and WordVar(e, s2) and SamePlace(s2, x) and
      (not s2.Global) then
      ev := src
    else
    begin
      LoadWordVar(x, 'x17');
      ev := 'x17';
    end;
    if onef then
      Line('  csinc ' + dst + ', ' + src + ', ' + ev + ', ' + CondCC(op, True))
    else if not one then
      Line('  csel ' + dst + ', ' + src + ', ' + ev + ', ' + CondCC(op, True))
    else if ev = src then
      Line('  cinc ' + dst + ', ' + src + ', ' + CondCC(op, True))
    else
      Line('  csinc ' + dst + ', ' + ev + ', ' + src + ', ' + CondCC(op, False));
    if x.Reg = '' then
      StoreWordVar(x, 'x17');
    Exit;
  end;
  xc := Copy(X86Jcc(CondCC(op, True)), 2, 3);
  { a BT's carry is the bit: the and is 0 when it is clear (P322) }
  if FCondCarry then
  begin
    if op = boEq then
      xc := 'ae'
    else
      xc := 'b';
  end;
  dst := x.Reg;
  if dst = '' then
    dst := 'rax';
  if fop then
    Line('  movq %' + OrdPool(1) + ', %' + dst)
  else if two then
    SelLoad(f, dst)
  else if x.Reg = '' then
    LoadWordVar(x, 'rax');
  Line('  cmov' + xc + 'q %' + src + ', %' + dst);
  if x.Reg = '' then
    StoreWordVar(x, 'rax');
end;

function TEmitter.FastJcc(E: PExpr; const IfFalse: string): Boolean;
begin
  Result := CondJmp(E, IfFalse, False);
end;

function TEmitter.JccTrue(E: PExpr; const Target: string): Boolean;
begin
  Result := CondJmp(E, Target, True);
end;

{ C compares an ordinal expression with a constant (P292): X op K, a
  constant on the left turned round. }
function TEmitter.CmpConst(C: PExpr; out X: PExpr; out Op: TBinOp; out K: Int64): Boolean;
var
  a, b: PExpr;
  t: LongInt;
begin
  Result := False;
  X := nil;
  Op := boEq;
  K := 0;
  if (C = nil) or (C^.Kind <> ekBin) or (C^.L = nil) or (C^.R = nil) then
    Exit;
  if (C^.Bin <> boLt) and (C^.Bin <> boLe) and (C^.Bin <> boGt) and (C^.Bin <> boGe) then
    Exit;
  a := C^.L;
  b := C^.R;
  Op := C^.Bin;
  if (a^.Kind = ekInt) or ((a^.Kind = ekStr) and (Length(a^.Txt) = 1)) then
  begin
    a := C^.R;
    b := C^.L;
    case Op of
      boLt: Op := boGt;
      boLe: Op := boGe;
      boGt: Op := boLt;
    else
      Op := boLe;
    end;
  end;
  if b^.Kind = ekInt then
    K := b^.Num
  else if (b^.Kind = ekStr) and (Length(b^.Txt) = 1) then
    K := Ord(b^.Txt[1])
  else
    Exit;
  if (a^.Kind = ekInt) or (a^.Kind = ekStr) then
    Exit;
  t := a^.Typ;
  if not (IsIntId(t) or (t = TyChar) or (TKind(t) = tykEnum) or (TKind(t) = tykSubrange)) then
    Exit;
  X := a;
  Result := True;
end;

{ E is a test of one value against both ends of a constant range (P292),
  as Go's generic.rules see it (src/cmd/compile/internal/ssa/_gen,
  "signed integer range"): c <= x and x <= d is x in Lo..Hi (Inside),
  x < c or x > d is x out of Lo..Hi; < and > take the next value in.
  The same X on both sides (SameExpr: no call in it), Lo <= Hi, and
  Hi - Lo within an Int64, so that x - Lo compared without sign with
  Hi - Lo is the whole test. }
function TEmitter.RangeTest(E: PExpr; out X: PExpr; out Lo, Hi: Int64;
  out Inside: Boolean): Boolean;
var
  xa, xb: PExpr;
  oa, ob: TBinOp;
  ka, kb: Int64;
  hasLo, hasHi: Boolean;

  { the side x op k as a bound: lower or upper end of the range inside
    (and), or the first value outside below or above (or) }
  function Bound(Op: TBinOp; K: Int64): Boolean;
  begin
    Result := False;
    if E^.Bin = boAnd then
      case Op of
        boGe: begin if hasLo then Exit; Lo := K; hasLo := True; end;
        boGt: begin if hasLo or (K = High(Int64)) then Exit; Lo := K + 1; hasLo := True; end;
        boLe: begin if hasHi then Exit; Hi := K; hasHi := True; end;
      else
        begin if hasHi or (K = Low(Int64)) then Exit; Hi := K - 1; hasHi := True; end;
      end
    else
      case Op of
        boLt: begin if hasLo then Exit; Lo := K; hasLo := True; end;
        boLe: begin if hasLo or (K = High(Int64)) then Exit; Lo := K + 1; hasLo := True; end;
        boGt: begin if hasHi then Exit; Hi := K; hasHi := True; end;
      else
        begin if hasHi or (K = Low(Int64)) then Exit; Hi := K - 1; hasHi := True; end;
      end;
    Result := True;
  end;

begin
  Result := False;
  X := nil;
  Lo := 0;
  Hi := 0;
  Inside := False;
  if (E = nil) or (E^.Kind <> ekBin) or (E^.Typ <> TyBoolean) or
    ((E^.Bin <> boAnd) and (E^.Bin <> boOr)) then
    Exit;
  if not (CmpConst(E^.L, xa, oa, ka) and CmpConst(E^.R, xb, ob, kb)) then
    Exit;
  if not SameExpr(xa, xb) then
    Exit;
  hasLo := False;
  hasHi := False;
  if not (Bound(oa, ka) and Bound(ob, kb)) then
    Exit;
  if (not hasLo) or (not hasHi) or (Lo > Hi) then
    Exit;
  if (Lo < 0) and (Hi > High(Int64) + Lo) then
    Exit;
  X := xa;
  Inside := E^.Bin = boAnd;
  Result := True;
end;

{ x - Lo, then one compare without sign with Hi - Lo (P292): the flags
  say below or same for x in Lo..Hi, above for x out of it (jbe, ja;
  b.ls, b.hi). x's register is read where it is: lea or sub from it. }
procedure TEmitter.RangeCmp(X: PExpr; Lo, Hi: Int64);
var
  s: TSym;
  op, src: string;
begin
  if FArm then
  begin
    if (X^.Kind = ekVar) and PlainOrd(X, s) and (s.Reg <> '') then
      src := s.Reg
    else if (X^.Kind = ekVar) and PlainOrd(X, s) then
    begin
      LoadPlain(s, 'x0');
      src := 'x0';
    end
    else
    begin
      EmitExpr(X);
      src := 'x0';
    end;
    if Lo <> 0 then
    begin
      if ArmAddImm(Lo) <> '' then
        Line('  sub x0, ' + src + ', ' + ArmAddImm(Lo))
      else if (Lo < 0) and (Lo > Low(Int64)) and (ArmAddImm(-Lo) <> '') then
        Line('  add x0, ' + src + ', ' + ArmAddImm(-Lo))
      else
      begin
        LoadImmR('x1', Lo);
        Line('  sub x0, ' + src + ', x1');
      end;
      src := 'x0';
    end;
    if ArmAddImm(Hi - Lo) <> '' then
      Line('  cmp ' + src + ', ' + ArmAddImm(Hi - Lo))
    else
    begin
      LoadImmR('x1', Hi - Lo);
      Line('  cmp ' + src + ', x1');
    end;
    Exit;
  end;
  if (X^.Kind = ekVar) and PlainOrd(X, s) then
  begin
    if Lo = 0 then
      op := MemA(s)
    else if (s.Reg <> '') and Fits32(-Lo) then
    begin
      Line('  leaq ' + IntToStr(-Lo) + '(%' + s.Reg + '), %rax');
      op := '%rax';
    end
    else
    begin
      LoadPlain(s, 'rax');
      op := '%rax';
    end;
  end
  else
  begin
    EmitExpr(X);
    op := '%rax';
  end;
  if (Lo <> 0) and not ((X^.Kind = ekVar) and PlainOrd(X, s) and (s.Reg <> '') and Fits32(-Lo)) then
  begin
    if Fits32(Lo) then
      Line('  subq $' + IntToStr(Lo) + ', %rax')
    else
    begin
      LoadImmR('rcx', Lo);
      Line('  subq %rcx, %rax');
    end;
  end;
  if Fits32(Hi - Lo) then
    Line('  cmpq $' + IntToStr(Hi - Lo) + ', ' + op)
  else
  begin
    LoadImmR('rcx', Hi - Lo);
    Line('  cmpq %rcx, ' + op);
  end;
end;

{ A condition as branches to Target, taken when it holds (WhenTrue) or
  when it fails: an integer comparison is one compare and one branch; a
  Boolean and, or and not are their sides' branches with short circuit
  (P265, Go's condBranch, cmd/compile/internal/ssagen/ssa.go): an and
  that jumps when false, or an or when true, sends both sides to Target;
  the other way the first side jumps past the second, to a label after
  it; not turns WhenTrue over. They never make a Boolean in a register
  for a branch, which took six to nine instructions a term. }
function TEmitter.CondJmp(E: PExpr; const Target: string; WhenTrue: Boolean): Boolean;
var
  ls, rs: TSym;
  cc, past, lr: string;
  a, b, rx: PExpr;
  op: TBinOp;
  rlo, rhi: Int64;
  rin: Boolean;
begin
  Result := False;
  if (E <> nil) and (E^.Kind = ekInt) then
  begin
    { A constant condition, while True for one: a jump or nothing. }
    if (E^.Num <> 0) = WhenTrue then
    begin
      if FArm then
        Line('  b ' + Target)
      else
        Line('  jmp ' + Target);
    end;
    Result := True;
    Exit;
  end;
  if (E <> nil) and (E^.Kind = ekUn) and (E^.Un = uoNot) and (E^.Typ = TyBoolean) and
    (E^.L <> nil) then
  begin
    CondBranch(E^.L, Target, not WhenTrue);
    Result := True;
    Exit;
  end;
  if (E <> nil) and (E^.Kind = ekBin) and ((E^.Bin = boAnd) or (E^.Bin = boOr)) and
    (E^.Typ = TyBoolean) and (E^.L <> nil) and (E^.R <> nil) then
  begin
    { a range's two ends: one compare without sign and one branch
      (P292) }
    if RangeTest(E, rx, rlo, rhi, rin) then
    begin
      RangeCmp(rx, rlo, rhi);
      if rin = WhenTrue then
      begin
        if FArm then
          Line('  b.ls ' + Target)
        else
          Line('  jbe ' + Target);
      end
      else if FArm then
        Line('  b.hi ' + Target)
      else
        Line('  ja ' + Target);
      Result := True;
      Exit;
    end;
    if (E^.Bin = boAnd) <> WhenTrue then
    begin
      CondBranch(E^.L, Target, WhenTrue);
      CondBranch(E^.R, Target, WhenTrue);
    end
    else
    begin
      past := Lab;
      CondBranch(E^.L, past, not WhenTrue);
      CondBranch(E^.R, Target, WhenTrue);
      Line(past + ':');
    end;
    Result := True;
    Exit;
  end;
  if (E = nil) or (E^.Kind <> ekBin) then
    Exit;
  if (E^.Bin <> boEq) and (E^.Bin <> boNe) and (E^.Bin <> boLt) and
    (E^.Bin <> boLe) and (E^.Bin <> boGt) and (E^.Bin <> boGe) then
    Exit;
  { a set's comparison is EmitSetBin's (P126): <= is a subset }
  if (TKind(E^.L^.Typ) = tykSet) or (TKind(E^.R^.Typ) = tykSet) then
    Exit;
  { x = 0, x <> 0, p = nil and p <> nil (P303) }
  if ZeroCmp(E, Target, WhenTrue) then
  begin
    Result := True;
    Exit;
  end;
  if not (((E^.L^.Kind = ekInt) or PlainOrd(E^.L, ls)) and
    ((E^.R^.Kind = ekInt) or PlainOrd(E^.R, rs))) then
  begin
    Result := OrdJcc(E, Target, WhenTrue);
    Exit;
  end;
  if (E^.L^.Kind <> ekInt) and (not PlainOrd(E^.L, ls)) then
    Exit;
  if (E^.R^.Kind <> ekInt) and (not PlainOrd(E^.R, rs)) then
    Exit;
  if (E^.L^.Kind = ekInt) and (E^.R^.Kind = ekInt) then
  begin
    if CmpHolds(E^.Bin, E^.L^.Num, E^.R^.Num) = WhenTrue then
    begin
      if FArm then
        Line('  b ' + Target)
      else
        Line('  jmp ' + Target);
    end;
    Result := True;
    Exit;
  end;
  cc := CondCC(E^.Bin, WhenTrue);
  if FArm then
  begin
    { arm64 (P290): a variable a register keeps is compared there; a
      constant on the left goes to the right with the comparison turned
      round, and a negative one is cmn's (ARM DDI 0487 M.c C6.2.93):
      the copies into x0 and x1 doubled a loop's test }
    a := E^.L;
    b := E^.R;
    op := E^.Bin;
    if (a^.Kind = ekInt) and (b^.Kind <> ekInt) then
    begin
      a := E^.R;
      b := E^.L;
      ls := rs;
      case op of
        boLt: op := boGt;
        boLe: op := boGe;
        boGt: op := boLt;
        boGe: op := boLe;
      end;
      cc := CondCC(op, WhenTrue);
    end;
    if a^.Kind = ekInt then
    begin
      LoadImmR('x0', a^.Num);
      lr := 'x0';
    end
    else if ls.Reg <> '' then
      lr := ls.Reg
    else
    begin
      LoadPlain(ls, 'x0');
      lr := 'x0';
    end;
    if (b^.Kind = ekInt) and (ArmAddImm(b^.Num) <> '') then
      Line('  cmp ' + lr + ', ' + ArmAddImm(b^.Num))
    else if (b^.Kind = ekInt) and (b^.Num < 0) and (b^.Num > Low(Int64)) and
      (ArmAddImm(-b^.Num) <> '') then
      Line('  cmn ' + lr + ', ' + ArmAddImm(-b^.Num))
    else if b^.Kind = ekInt then
    begin
      LoadImmR('x1', b^.Num);
      Line('  cmp ' + lr + ', x1');
    end
    else
    begin
      rs := FindSym(b^.Name);
      if rs.Reg <> '' then
        Line('  cmp ' + lr + ', ' + rs.Reg)
      else
      begin
        LoadPlain(rs, 'x1');
        Line('  cmp ' + lr + ', x1');
      end;
    end;
    Line('  b.' + cc + ' ' + Target);
  end
  else
  begin
    if (E^.L^.Kind = ekVar) and (E^.R^.Kind = ekInt) and Fits32(E^.R^.Num) then
      Line('  cmpq $' + IntToStr(E^.R^.Num) + ', ' + MemA(ls))
    else if (E^.L^.Kind = ekVar) and (E^.R^.Kind = ekVar) then
    begin
      { A register on either side takes the other side as it is. }
      if ls.Reg <> '' then
        Line('  cmpq ' + MemA(rs) + ', %' + ls.Reg)
      else if rs.Reg <> '' then
        Line('  cmpq %' + rs.Reg + ', ' + MemA(ls))
      else
      begin
        LoadPlain(rs, 'rax');
        Line('  cmpq %rax, ' + MemA(ls));
      end;
    end
    else
    begin
      if E^.L^.Kind = ekInt then
        LoadImmR('rax', E^.L^.Num)
      else
        LoadPlain(ls, 'rax');
      if E^.R^.Kind = ekInt then
        LoadImmR('rcx', E^.R^.Num)
      else
        LoadPlain(rs, 'rcx');
      Line('  cmpq %rcx, %rax');
    end;
    Line('  ' + X86Jcc(cc) + ' ' + Target);
  end;
  Result := True;
end;

{ E is x = 0, x <> 0, p = nil or p <> nil, either way round, x a word
  the pool works out (an integer, an enumeration, a character, a
  pointer, an object): on arm64 one CBZ or CBNZ on x's register (ARM
  DDI 0487 M.c C6.2.78 and C6.2.77: the label within +-1 MB as
  B.cond's, the flags untouched), on amd64 TEST of the register with
  itself and one jump, or CMP of the variable in memory with 0 (SDM
  vol. 2B 4-721 TEST: ZF is 1 when the AND is 0); Go's loop over a list
  is CBNZ R0 and TESTQ AX, AX (go tool objdump). The constant went into
  x17 or a compare took it, and a variable a region keeps was copied
  into the pool first. }
function TEmitter.ZeroCmp(E: PExpr; const Target: string; WhenTrue: Boolean): Boolean;
var
  x, z: PExpr;
  s: TSym;
  r: string;
  k: TTypeKind;
  jz: Boolean;
  f: LongInt;
begin
  Result := False;
  if (E^.Bin <> boEq) and (E^.Bin <> boNe) then
    Exit;
  { (x and c) = 0: one TEST or TST and the jump, a BT of a high bit
    and a jump on the carry (P322); TbzPass makes TST of one bit and
    its b.eq or b.ne a TBZ or TBNZ where the label is within reach }
  if AndZero(E, z) then
  begin
    jz := (E^.Bin = boEq) = WhenTrue;
    f := AndTest(z, 0, True);
    if f = 1 then
    begin
      if FArm then
      begin
        if jz then
          Line('  b.eq ' + Target)
        else
          Line('  b.ne ' + Target);
      end
      else if jz then
        Line('  je ' + Target)
      else
        Line('  jne ' + Target);
      Result := True;
      Exit;
    end
    else if f = 2 then
    begin
      { CF the bit: the and is 0 when it is clear }
      if jz then
        Line('  jae ' + Target)
      else
        Line('  jb ' + Target);
      Result := True;
      Exit;
    end;
  end;
  x := E^.L;
  z := E^.R;
  if not ((z^.Kind = ekNil) or ((z^.Kind = ekInt) and (z^.Num = 0))) then
  begin
    x := E^.R;
    z := E^.L;
  end;
  if not ((z^.Kind = ekNil) or ((z^.Kind = ekInt) and (z^.Num = 0))) then
    Exit;
  if (x = nil) or (x^.Kind = ekNil) or (x^.Kind = ekInt) or IsFat(x^.Typ) or
    IsBlob(x^.Typ) then
    Exit;
  k := TKind(x^.Typ);
  if not ((k = tykInteger) or (k = tykEnum) or (k = tykSubrange) or
    (k = tykBoolean) or (k = tykPointer) or (k = tykClass)) then
    Exit;
  { the jump is taken when x is 0: = that holds, or <> that fails }
  jz := (E^.Bin = boEq) = WhenTrue;
  if FArm then
  begin
    r := WordReg(x);
    if r = '' then
    begin
      if not OrdSimple(x, 0) then
        Exit;
      EmitOrdTo(x, 0);
      r := OrdPool(0);
    end;
    if jz then
      Line('  cbz ' + r + ', ' + Target)
    else
      Line('  cbnz ' + r + ', ' + Target);
  end
  else
  begin
    r := WordReg(x);
    if r <> '' then
      Line('  testq %' + r + ', %' + r)
    else if (x^.Kind = ekVar) and WordVar(x, s) and (TSize(s.Typ) = 8) then
      Line('  cmpq $0, ' + MemA(s))
    else
    begin
      if not OrdSimple(x, 0) then
        Exit;
      EmitOrdTo(x, 0);
      Line('  testq %' + OrdPool(0) + ', %' + OrdPool(0));
    end;
    if jz then
      Line('  je ' + Target)
    else
      Line('  jne ' + Target);
  end;
  Result := True;
end;

{ A condition's branch to Target always: CondJmp's when it has one, else
  the condition worked out as a value and tested, as before P265. }
procedure TEmitter.CondBranch(E: PExpr; const Target: string; WhenTrue: Boolean);
begin
  if CondJmp(E, Target, WhenTrue) then
    Exit;
  EmitExpr(E);
  if FArm then
  begin
    if WhenTrue then
      Line('  cbnz x0, ' + Target)
    else
      Line('  cbz x0, ' + Target);
  end
  else
  begin
    Line('  testq %rax, %rax');
    if WhenTrue then
      Line('  jnz ' + Target)
    else
      Line('  jz ' + Target);
  end;
end;

function TEmitter.CmpCounterR(Lim: PExpr; const R: string): Boolean;
var
  s: TSym;
begin
  Result := False;
  if Lim = nil then
    Exit;
  if Lim^.Kind = ekInt then
  begin
    if FArm then
    begin
      if (Lim^.Num >= 0) and (Lim^.Num <= 4095) then
        Line('  cmp ' + R + ', #' + IntToStr(Lim^.Num))
      else
      begin
        Imm('x1', Lim^.Num);
        Line('  cmp ' + R + ', x1');
      end;
    end
    else if Fits32(Lim^.Num) then
      Line('  cmpq $' + IntToStr(Lim^.Num) + ', %' + R)
    else
    begin
      Line('  movabsq $' + IntToStr(Lim^.Num) + ', %rcx');
      Line('  cmpq %rcx, %' + R);
    end;
    Result := True;
    Exit;
  end;
  if not PlainOrd(Lim, s) then
    Exit;
  if FArm then
  begin
    LoadPlain(s, 'x1');
    Line('  cmp ' + R + ', x1');
  end
  else
    Line('  cmpq ' + MemA(s) + ', %' + R);
  Result := True;
end;

{ The loop counter in rax (x0) against the limit, when the limit is a
  constant or a plain variable. }
function TEmitter.CmpCounter(Lim: PExpr): Boolean;
begin
  if FArm then
    Result := CmpCounterR(Lim, 'x0')
  else
    Result := CmpCounterR(Lim, 'rax');
end;

function TEmitter.ForAcc(S: PStmt): Boolean;
var
  body: PStmt;
  acc, ctr, ls: TSym;
  e: PExpr;
  neg, addK: Boolean;
  k: Int64;
  head, top, bodyL, brk, skip, ctrR: string;
begin
  Result := False;
  if (S = nil) or (S^.Name = '') or (S^.E = nil) or (S^.E2 = nil) then
    Exit;
  ctr := FindSym(S^.Name);
  if ctr.ByRef or (ctr.Up > 0) or (TSize(ctr.Typ) <> 8) then
    Exit;
  if IsNarrowId(ctr.Typ) then
    Exit;
  if (TKind(ctr.Typ) <> tykInteger) and (TKind(ctr.Typ) <> tykEnum) and
    (TKind(ctr.Typ) <> tykSubrange) then
    Exit;
  body := S^.Body;
  if (body <> nil) and (body^.Kind = skBlock) and (Length(body^.Stmts) = 1) then
    body := body^.Stmts[0];
  if (body = nil) or (body^.Kind <> skAssign) or (body^.E = nil) then
    Exit;
  if not PlainOrd(body^.Dest, acc) then
    Exit;
  if SamePlace(acc, ctr) then
    Exit;
  e := body^.E;
  if NarrowOp(e) or IsNarrowId(acc.Typ) then
    Exit;
  if (e^.Kind <> ekBin) or ((e^.Bin <> boAdd) and (e^.Bin <> boSub)) then
    Exit;
  if (e^.L = nil) or (not PlainOrd(e^.L, ls)) or (not SamePlace(acc, ls)) then
    Exit;
  neg := e^.Bin = boSub;
  addK := False;
  k := 0;
  if (e^.R <> nil) and (e^.R^.Kind = ekVar) and SameSym(e^.R^.Name, S^.Name) then
    neg := e^.Bin = boSub
  else if (e^.Bin = boAdd) and (e^.R <> nil) and (e^.R^.Kind = ekInt) then
  begin
    addK := True;
    k := e^.R^.Num;
    if not Fits32(k) then
      Exit;
  end
  else
    Exit;
  if (S^.E2^.Kind <> ekInt) and (not PlainOrd(S^.E2, ls)) then
    Exit;
  head := Lab;
  top := Lab;
  bodyL := Lab;
  brk := Lab;
  skip := Lab;
  EmitExpr(S^.E);
  if FArm then
  begin
    ctrR := 'x1';
    Line('  mov x1, x0');
    LoadPlain(acc, 'x0');
  end
  else
  begin
    ctrR := 'rcx';
    Line('  movq %rax, %rcx');
    LoadPlain(acc, 'rax');
  end;
  { The loop of EmitFor: stop on the limit, a preemption test a run; a
    loop that does not run changes nothing. }
  AccCmp(S, ctrR);
  if S^.Down then
    JumpCC('lt', skip)
  else
    JumpCC('gt', skip);
  JumpCC('', head);
  AlignLoop;
  Line(top + ':');
  AccStep(S, ctrR);
  Line(bodyL + ':');
  if FArm then
  begin
    if addK then
    begin
      if (k >= 0) and (k <= 4095) then
        Line('  add x0, x0, #' + IntToStr(k))
      else if (k < 0) and (k >= -4095) then
        Line('  sub x0, x0, #' + IntToStr(-k))
      else
      begin
        LoadImmR('x2', k);
        Line('  add x0, x0, x2');
      end;
    end
    else if neg then
      Line('  sub x0, x0, x1')
    else
      Line('  add x0, x0, x1');
    Line('  cmp x1, x3');
  end
  else
  begin
    if addK then
      Line('  addq $' + IntToStr(k) + ', %rax')
    else if neg then
      Line('  subq %rcx, %rax')
    else
      Line('  addq %rcx, %rax');
    Line('  cmpq %rdx, %rcx');
  end;
  if S^.Down then
    JumpCC('gt', top)
  else
    JumpCC('lt', top);
  AccCmp(S, ctrR);
  if S^.Down then
    JumpCC('le', brk)
  else
    JumpCC('ge', brk);
  AccStep(S, ctrR);
  Line(head + ':');
  EmitStackCheck(head, '16');
  if FArm then
  begin
    if S^.E2^.Kind = ekInt then
      LoadImmR('x4', S^.E2^.Num)
    else
      LoadPlain(FindSym(S^.E2^.Name), 'x4');
    ForChunk(S, 'x1', 'x3', 'x4', 'x5');
  end
  else
  begin
    if S^.E2^.Kind = ekInt then
      LoadImmR('rsi', S^.E2^.Num)
    else
      LoadPlain(FindSym(S^.E2^.Name), 'rsi');
    ForChunk(S, 'rcx', 'rdx', 'rsi', 'rdi');
  end;
  JumpCC('', bodyL);
  Line(brk + ':');
  StorePlain(acc);
  if FArm then
    StorePlainFrom(ctr, 'x1')
  else
    Line('  movq %rcx, ' + MemA(ctr));
  Line(skip + ':');
  Result := True;
end;

{ ForAcc's counter in R against the limit, a constant or a plain
  variable: the flags of counter - limit. }
procedure TEmitter.AccCmp(S: PStmt; const R: string);
begin
  if FArm then
  begin
    if (S^.E2^.Kind = ekInt) and (S^.E2^.Num >= 0) and (S^.E2^.Num <= 4095) then
      Line('  cmp ' + R + ', #' + IntToStr(S^.E2^.Num))
    else
    begin
      if S^.E2^.Kind = ekInt then
        LoadImmR('x2', S^.E2^.Num)
      else
        LoadPlain(FindSym(S^.E2^.Name), 'x2');
      Line('  cmp ' + R + ', x2');
    end;
  end
  else if S^.E2^.Kind = ekInt then
  begin
    if Fits32(S^.E2^.Num) then
      Line('  cmpq $' + IntToStr(S^.E2^.Num) + ', %' + R)
    else
    begin
      Line('  movabsq $' + IntToStr(S^.E2^.Num) + ', %rdx');
      Line('  cmpq %rdx, %' + R);
    end;
  end
  else
    Line('  cmpq ' + MemA(FindSym(S^.E2^.Name)) + ', %' + R);
end;

procedure TEmitter.AccStep(S: PStmt; const R: string);
begin
  if FArm then
  begin
    if S^.Down then
      Line('  sub ' + R + ', ' + R + ', #1')
    else
      Line('  add ' + R + ', ' + R + ', #1');
  end
  else if S^.Down then
    Line('  decq %' + R)
  else
    Line('  incq %' + R);
end;

{ -checkptr (P104): Size bytes at the address in rax (x0) are in one
  object: rt_ptrchk keeps every register, or stops the program at this
  line. }
procedure TEmitter.PtrCheck(Size: Int64);
begin
  if not FCheckPtr then
    Exit;
  if FArm then
  begin
    Imm('x1', Size);
    Line('  bl rt_ptrchk');
  end
  else
  begin
    LoadImmR('rcx', Size);
    Line('  call rt_ptrchk');
  end;
end;

{ -checkptr: p + n and p - n, the result held to p's object. }
procedure TEmitter.EmitPtrArith(E: PExpr);
begin
  EmitExpr(E^.L);
  if FArm then
    PshK('x0', 1)
  else
    PushK('rax', 1);
  EmitExpr(E^.R);
  if FArm then
  begin
    Ppop('x1');
    if E^.Bin = boAdd then
      Line('  add x2, x1, x0')
    else
      Line('  sub x2, x1, x0');
    Line('  mov x0, x1');
    Line('  mov x1, x2');
    Line('  bl rt_ptrarith');
  end
  else
  begin
    Line('  popq %rdi');
    Line('  movq %rdi, %rsi');
    if E^.Bin = boAdd then
      Line('  addq %rax, %rsi')
    else
      Line('  subq %rax, %rsi');
    Line('  call rt_ptrarith');
  end;
end;

{ A is p + n or p - n of a pointer p (P102 puts the pointer on the left). }
function TEmitter.PtrStepE(A: PExpr): Boolean;
begin
  Result := (A <> nil) and (A^.Kind = ekBin) and ((A^.Bin = boAdd) or (A^.Bin = boSub)) and
    (TKind(A^.Typ) = tykPointer) and (A^.L <> nil) and (TKind(A^.L^.Typ) = tykPointer);
end;

{ -checkptr: Size bytes at p + n or p - n (1.0.111), held to p's object
  rather than to whatever object the address lands in: (p + 2)^ just
  past a block stops even when another block follows it. p stays on the
  stack for rt_ptrfrom, which keeps every register. }
procedure TEmitter.EmitPtrFrom(A: PExpr; Size: Int64);
begin
  EmitExpr(A^.L);
  if FArm then
    PshK('x0', 1)
  else
    PushK('rax', 1);
  EmitExpr(A^.R);
  if FArm then
  begin
    Line('  ldr x1, [sp]');
    if A^.Bin = boAdd then
      Line('  add x0, x1, x0')
    else
      Line('  sub x0, x1, x0');
    Imm('x1', Size);
    Line('  bl rt_ptrfrom');
    Ppop('x1');
  end
  else
  begin
    if A^.Bin = boSub then
      Line('  negq %rax');
    Line('  addq (%rsp), %rax');
    LoadImmR('rcx', Size);
    Line('  call rt_ptrfrom');
    Line('  popq %rcx');
  end;
end;

{ E steps or reads through a pointer: under -checkptr it takes the
  checked path, not the register pool or a loop's registers. }
function TEmitter.PtrAccess(E: PExpr): Boolean;
begin
  Result := False;
  if (not FCheckPtr) or (E = nil) then
    Exit;
  Result := (E^.Kind = ekDeref) or
    ((E^.Kind = ekBin) and (TKind(E^.Typ) = tykPointer)) or
    ((E^.Kind = ekIndex) and (E^.L <> nil) and (TKind(E^.L^.Typ) = tykPointer)) or
    ((E^.Kind = ekField) and (E^.L <> nil) and (E^.L^.Kind = ekDeref));
end;

function TEmitter.EHasCall(E: PExpr): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  Result := True;
  if (E^.Kind = ekCall) or (E^.Kind = ekMethod) or (E^.Kind = ekCtor) or
    (E^.Kind = ekProp) or (E^.Kind = ekRecv) then
    Exit;
  if EHasCall(E^.L) or EHasCall(E^.R) then
    Exit;
  for i := 0 to High(E^.Args) do
    if EHasCall(E^.Args[i]) then
      Exit;
  Result := False;
end;

{ for v := c to Length(X) do X[v] := e (1.1.1): X a string variable, c
  a constant of at least 1, a body of assignments to X[v] alone whose
  values call nothing. X can neither change its length nor be shared
  while the loop runs, so one check before it makes X's characters its
  own, and every index lies in 1..Length(X): the stores go without the
  two checks of each (b9hash's fill of a MiB took three times Go's). }
function TEmitter.StrFillStore(T: PStmt; const X, Ctr: string): Boolean;
begin
  Result := (T <> nil) and (T^.Kind = skAssign) and (T^.Dest <> nil) and
    (T^.Dest^.Kind = ekIndex) and (T^.Dest^.L <> nil) and (T^.Dest^.L^.Kind = ekVar) and
    (NormName(T^.Dest^.L^.Name) = X) and (T^.Dest^.R <> nil) and
    (T^.Dest^.R^.Kind = ekVar) and SameSym(T^.Dest^.R^.Name, Ctr) and
    (T^.E <> nil) and (not EHasCall(T^.E));
end;

function TEmitter.StrFillLoop(S: PStmt; out X: string; out XE: PExpr): Boolean;
var
  i: SizeInt;
  lim: PExpr;
begin
  Result := False;
  X := '';
  XE := nil;
  if (S = nil) or S^.Down or (S^.E = nil) or (S^.E^.Kind <> ekInt) or (S^.E^.Num < 1) or
    (S^.Body = nil) then
    Exit;
  { a limit that is not a constant is a hidden variable the parser sets
    just before the loop (HoistLimit): its value is that assignment's }
  lim := S^.E2;
  if (lim <> nil) and (lim^.Kind = ekVar) and (FLastAsgName <> '') and
    SameSym(lim^.Name, FLastAsgName) then
    lim := FLastAsgE;
  if (lim = nil) or (lim^.Kind <> ekCall) or (lim^.Name <> 'rt_length') or
    (Length(lim^.Args) <> 1) then
    Exit;
  XE := lim^.Args[0];
  if (XE = nil) or (XE^.Kind <> ekVar) or (not IsStr(XE^.Typ)) then
    Exit;
  X := NormName(XE^.Name);
  if S^.Body^.Kind = skBlock then
  begin
    Result := Length(S^.Body^.Stmts) > 0;
    for i := 0 to High(S^.Body^.Stmts) do
      if not StrFillStore(S^.Body^.Stmts[i], X, S^.Name) then
        Result := False;
  end
  else
    Result := StrFillStore(S^.Body, X, S^.Name);
  if not Result then
  begin
    X := '';
    XE := nil;
  end;
end;

{ X[v] of the string and counter StrFillLoop proved }
function TEmitter.StrFilled(E: PExpr): Boolean;
begin
  Result := (FStrFill <> '') and (E <> nil) and (E^.L <> nil) and (E^.L^.Kind = ekVar) and
    (NormName(E^.L^.Name) = FStrFill) and (E^.R <> nil) and (E^.R^.Kind = ekVar) and
    SameSym(E^.R^.Name, FStrFillCtr);
end;

{ X's characters its own, as a store into it does first (1.0.84). }
procedure TEmitter.StrOwnOnce(X: PExpr);
var
  ok: string;
begin
  EmitAddr(X);
  ok := Lab;
  if FArm then
  begin
    Line('  ldr x9, [x0, #8]');
    Line('  cbz x9, ' + ok);
    Line('  ldr x9, [x0]');
    Line('  ldurb w9, [x9, #-1]');
    Line('  tst w9, #1');
    ColdBegin('  b.ne');
    Line('  bl rt_strunique');
    Line('  b ' + ok);
    ColdEnd;
  end
  else
  begin
    Line('  movq 8(%rax), %rcx');
    Line('  testq %rcx, %rcx');
    Line('  jz ' + ok);
    Line('  movq (%rax), %rcx');
    Line('  testb $1, -1(%rcx)');
    ColdBegin('  jnz');
    Line('  movq %rax, %rdi');
    Line('  call rt_strunique');
    Line('  jmp ' + ok);
    ColdEnd;
  end;
  Line(ok + ':');
end;

{ The target of a loop's back edge starts on 32 bytes (P100): a loop
  whose few instructions crossed a fetch block ran a fifth slower
  (b7narrow's histogram, 280M cycles where Go's took 198M). The padding
  lies after a jump, or runs once as the loop starts. arm64 too since
  P267: Arm's Neoverse N1 guide (4.9) aligns branch targets to 32 bytes
  and keeps a loop of 32 bytes or less within one aligned 32-byte
  region. }
procedure TEmitter.AlignLoop;
begin
  Line('  .p2align 5');
end;

procedure TEmitter.JumpCC(const CC, L: string);
begin
  if FArm then
  begin
    if CC = '' then
      Line('  b ' + L)
    else
      Line('  b.' + CC + ' ' + L);
  end
  else if CC = '' then
    Line('  jmp ' + L)
  else
    Line('  ' + X86Jcc(CC) + ' ' + L);
end;

{ The counter of S against its limit: the flags of counter - limit. }
procedure TEmitter.ForCmp(S: PStmt; const Vs: TSym);
begin
  if Vs.Reg <> '' then
  begin
    if CmpCounterR(S^.E2, Vs.Reg) then
      Exit;
    if FArm then
      Line('  mov x0, ' + Vs.Reg)
    else
      Line('  movq %' + Vs.Reg + ', %rax');
  end
  else
  begin
    LoadVar(S^.Name);
    if CmpCounter(S^.E2) then
      Exit;
  end;
  if FArm then
  begin
    PshK('x0', 0);
    EmitExpr(S^.E2);
    Ppop('x1');
    Line('  cmp x1, x0');
  end
  else
  begin
    PushK('rax', 0);
    EmitExpr(S^.E2);
    Line('  popq %rcx');
    Line('  cmpq %rax, %rcx');
  end;
end;

{ One step of the counter. It is below the limit (above, going down), so
  a narrow one stays in its type and clean. }
{ The limit is one CmpCounterR compares with the counter where it is:
  a constant or a plain variable (P327). }
function TEmitter.LimitPlain(Lim: PExpr): Boolean;
var
  s: TSym;
begin
  Result := (Lim <> nil) and ((Lim^.Kind = ekInt) or PlainOrd(Lim, s));
end;

{ Held (P327): the counter at its home is in rax or x0 already, loaded
  by the test of the pass before, the step's only way in. }
procedure TEmitter.ForStep(S: PStmt; const Vs: TSym; Held: Boolean);
begin
  if Vs.Reg <> '' then
    AccStep(S, Vs.Reg)
  else
  begin
    if not Held then
      LoadVar(S^.Name);
    if FArm then
      AccStep(S, 'x0')
    else
      AccStep(S, 'rax');
    StoreVar(S^.Name);
  end;
end;

{ The end of the run that starts at the counter R: 1023 steps on, or the
  limit (in L) when that is nearer. L - R (R - L going down) is not
  negative there, so an unsigned compare also catches a sum that wraps
  near High(Integer). T is scratch. }
procedure TEmitter.ForChunk(S: PStmt; const R, CH, L, T: string);
begin
  if FArm then
  begin
    if S^.Down then
    begin
      Line('  sub ' + CH + ', ' + R + ', #1023');
      Line('  sub ' + T + ', ' + R + ', ' + L);
    end
    else
    begin
      Line('  add ' + CH + ', ' + R + ', #1023');
      Line('  sub ' + T + ', ' + L + ', ' + R);
    end;
    Line('  cmp ' + T + ', #1023');
    Line('  csel ' + CH + ', ' + L + ', ' + CH + ', lo');
  end
  else
  begin
    if S^.Down then
    begin
      Line('  leaq -1023(%' + R + '), %' + CH);
      Line('  movq %' + R + ', %' + T);
      Line('  subq %' + L + ', %' + T);
    end
    else
    begin
      Line('  leaq 1023(%' + R + '), %' + CH);
      Line('  movq %' + L + ', %' + T);
      Line('  subq %' + R + ', %' + T);
    end;
    Line('  cmpq $1023, %' + T);
    Line('  cmovbq %' + L + ', %' + CH);
  end;
end;

{ for S: the counter is compared with the limit before it steps, so it
  stops on the limit and never passes it: a loop up to High(Integer)
  ends, and the counter holds the limit after a loop that ran to its
  end, as in FPC (P100; it held the limit plus one, and a narrow counter
  took two branches a pass). An innermost loop of a promoted region runs
  in runs of 1024 with the preemption test once a run: an element costs
  a step, a compare with the run's end and a branch, as in Go, whose
  loops sysmon preempts by signal. The run's end is in FChunkReg. }
procedure TEmitter.EmitFor(S: PStmt);
var
  vs: TSym;
  top, head, body, test, brk, ftop, fbody, ftest, fillx, oldfill, oldctr: string;
  strip, fact: Boolean;
  proofs: array of TProof;
  fille: PExpr;
  nf, k: SizeInt;
begin
  oldfill := FStrFill;
  oldctr := FStrFillCtr;
  if StrFillLoop(S, fillx, fille) then
  begin
    StrOwnOnce(fille);
    FStrFill := fillx;
    FStrFillCtr := S^.Name;
  end
  else
  begin
    FStrFill := '';
    FStrFillCtr := '';
  end;
  top := Lab;
  head := Lab;
  body := Lab;
  test := Lab;
  PushLoop(Lab, test);
  brk := FBrk[High(FBrk)];
  EmitExpr(S^.E);
  ForEnter(S, brk);
  vs := FindSym(S^.Name);
  { P289: limits that are constants bound the counter in the body, when
    nothing but the loop can write it: a local of this routine whose
    address nothing takes (a var argument takes it), which the body
    does not assign and no nested routine can reach }
  fact := (S^.E <> nil) and (S^.E2 <> nil) and (S^.E^.Kind = ekInt) and
    (S^.E2^.Kind = ekInt) and (not vs.Global) and (not vs.ByRef) and
    (vs.Up = 0) and (not vs.Boxed) and (not LocAddrTaken(S^.Name)) and
    (not WritesVar(S^.Body, S^.Name));
  if fact then
    for k := 0 to High(FProgProcs) do
      if FProgProcs[k].ParentSym = FCurProc then
        fact := False;
  nf := Length(FCtrFacts);
  if fact then
  begin
    SetLength(FCtrFacts, nf + 1);
    FCtrFacts[nf].Name := S^.Name;
    if S^.E^.Num <= S^.E2^.Num then
    begin
      FCtrFacts[nf].Lo := S^.E^.Num;
      FCtrFacts[nf].Hi := S^.E2^.Num;
    end
    else
    begin
      FCtrFacts[nf].Lo := S^.E2^.Num;
      FCtrFacts[nf].Hi := S^.E^.Num;
    end;
  end;
  strip := FPromoOn and (FChunkReg <> '') and (vs.Reg <> '') and
    (not HasLoop(S^.Body)) and (not WritesVar(S^.Body, S^.Name));
  JumpCC('', head);
  AlignLoop;
  Line(top + ':');
  { P327: the test of a counter at its home against a constant or a
    plain variable leaves it in rax or x0, and the back edge is the only
    way to the top (continue goes to the test): the step reads it there,
    one load a pass where b27call's loop had two, Go's one from its
    spill slot }
  ForStep(S, vs, (not strip) and (vs.Reg = '') and LimitPlain(S^.E2));
  if strip then
  begin
    { The indexes the body takes at counter + c whose range a run's head
      can check once: a static array's, or a slice's whose length the
      loop keeps in a register or at its home (P319). }
    FProv := nil;
    FProvCtr := S^.Name;
    FProvNarrow := IsNarrowId(vs.Typ);
    ProofScanS(S^.Body);
    proofs := FProv;
    FProv := nil;
    FProvCtr := '';
    Line(body + ':');
    EmitStmt(S^.Body);
    Line(test + ':');
    ForRunTail(S, vs, top, brk);
    Line(head + ':');
    EmitStackCheck(head, '16');
    EmitExpr(S^.E2);
    if FArm then
      ForChunk(S, vs.Reg, FChunkReg, 'x0', 'x1')
    else
      ForChunk(S, vs.Reg, FChunkReg, 'rax', 'rdx');
    if Length(proofs) = 0 then
      JumpCC('', body)
    else
    begin
      { Every such index in range from the counter to the run's end:
        the run takes a copy of the body without their checks, as Go's
        prove pass leaves them out; else the body above, checked. }
      FProv := proofs;
      FProvCtr := S^.Name;
      FProvNarrow := IsNarrowId(vs.Typ);
      ProofTests(vs.Reg, FChunkReg, body);
      ftop := Lab;
      fbody := Lab;
      ftest := Lab;
      JumpCC('', fbody);
      AlignLoop;
      Line(ftop + ':');
      ForStep(S, vs);
      Line(fbody + ':');
      FCont[High(FCont)] := ftest;
      FProvOn := True;
      EmitStmt(S^.Body);
      FProvOn := False;
      FCont[High(FCont)] := test;
      Line(ftest + ':');
      ForRunTail(S, vs, ftop, brk);
      JumpCC('', head);
      FProv := nil;
      FProvCtr := '';
    end;
  end
  else
  begin
    Line(head + ':');
    EmitStackCheck(head, '16');
    EmitStmt(S^.Body);
    Line(test + ':');
    ForCmp(S, vs);
    if S^.Down then
      JumpCC('gt', top)
    else
      JumpCC('lt', top);
  end;
  Line(brk + ':');
  PopLoop;
  SetLength(FCtrFacts, nf);
  FStrFill := oldfill;
  FStrFillCtr := oldctr;
end;

{ The start in rax (x0) against the limit, stored when the loop runs: a
  loop that does not run leaves its counter as it was, as in FPC. }
procedure TEmitter.ForEnter(S: PStmt; const Skip: string);
var
  cc: string;
begin
  if S^.Down then
    cc := 'lt'
  else
    cc := 'gt';
  if FArm then
  begin
    if CmpCounterR(S^.E2, 'x0') then
      JumpCC(cc, Skip)
    else
    begin
      PshK('x0', 0);
      EmitExpr(S^.E2);
      Ppop('x1');
      Line('  cmp x1, x0');
      JumpCC(cc, Skip);
      Line('  mov x0, x1');
    end;
  end
  else if CmpCounterR(S^.E2, 'rax') then
    JumpCC(cc, Skip)
  else
  begin
    PushK('rax', 0);
    EmitExpr(S^.E2);
    Line('  popq %rcx');
    Line('  cmpq %rax, %rcx');
    JumpCC(cc, Skip);
    Line('  movq %rcx, %rax');
  end;
  StoreVar(S^.Name);
end;

{ The end of a pass in a run: on to Top while the counter is short of
  the run's end, out to Brk at the limit, else a step towards the next
  run's head, which follows. }
procedure TEmitter.ForRunTail(S: PStmt; const Vs: TSym; const Top, Brk: string);
begin
  if FArm then
    Line('  cmp ' + Vs.Reg + ', ' + FChunkReg)
  else
    Line('  cmpq %' + FChunkReg + ', %' + Vs.Reg);
  if S^.Down then
    JumpCC('gt', Top)
  else
    JumpCC('lt', Top);
  ForCmp(S, Vs);
  if S^.Down then
    JumpCC('le', Brk)
  else
    JumpCC('ge', Brk);
  ForStep(S, Vs);
end;

{ E is the loop's counter, or counter + c or counter - c for a 64-bit
  counter (a narrow one wraps at its width, so only itself). }
function TEmitter.CounterOff(E: PExpr; out C: Int64): Boolean;
begin
  Result := False;
  C := 0;
  if (E = nil) or (FProvCtr = '') then
    Exit;
  if (E^.Kind = ekVar) and SameSym(E^.Name, FProvCtr) then
  begin
    Result := True;
    Exit;
  end;
  if FProvNarrow or (E^.Kind <> ekBin) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  if (E^.Bin = boAdd) and (E^.L^.Kind = ekVar) and SameSym(E^.L^.Name, FProvCtr) and
    (E^.R^.Kind = ekInt) then
    C := E^.R^.Num
  else if (E^.Bin = boAdd) and (E^.R^.Kind = ekVar) and SameSym(E^.R^.Name, FProvCtr) and
    (E^.L^.Kind = ekInt) then
    C := E^.L^.Num
  else if (E^.Bin = boSub) and (E^.L^.Kind = ekVar) and SameSym(E^.L^.Name, FProvCtr) and
    (E^.R^.Kind = ekInt) then
    C := -E^.R^.Num
  else
    Exit;
  Result := (C >= -(Int64(1) shl 30)) and (C <= Int64(1) shl 30);
end;

procedure TEmitter.ProofScanE(E: PExpr);
var
  i: SizeInt;
  c: Int64;
  td: TTypeDef;
  sy: TSym;
  arr, lr: string;
  p: TProof;
begin
  if E = nil then
    Exit;
  if (E^.Kind = ekIndex) and (E^.L <> nil) and CounterOff(E^.R, c) and
    (Length(FProv) < 8) then
  begin
    p.Arr := '';
    p.Len := '';
    p.LenLab := '';
    p.LenOff := 0;
    p.Lo := 0;
    p.Hi := 0;
    p.C := c;
    arr := '#';
    if IsDyn(E^.L^.Typ) then
    begin
      if (E^.L^.Kind = ekVar) and TryFindSym(E^.L^.Name, sy) and (not sy.ByRef) then
      begin
        { the proof reads the length alone (ProofTests), so a slice is
          proved by its length's register with or without its pointer in
          one, and by the length at its home when the region keeps it in
          none: a slice the region does not assign, whose address no one
          takes, of this routine, keeps its length through the region,
          which calls nothing, as a part a register holds does
          (PromoAddPart, the region's FFatWritten); the free body reads
          its pointer at home, unchanged. Go's prove reads the length's
          value wherever it lives (ssa/prove.go) (P319) }
        lr := PartReg(sy, 2);
        if lr <> '' then
        begin
          arr := NormName(E^.L^.Name);
          p.Len := lr;
        end
        else if FPromoOn and (sy.Up = 0) and (not AddrKept(sy.Name)) and
          (not InNames(FFatWritten, NormName(sy.Name))) and
          not (sy.Global and (FIsUnit or ExtGlobal(sy.Name))) then
        begin
          arr := NormName(E^.L^.Name);
          if sy.Global then
            p.LenLab := VarLabel(sy.Name)
          else
            p.LenOff := sy.Off + 8;
        end;
      end;
    end
    else if (TKind(E^.L^.Typ) = tykArray) and not IsStr(E^.L^.Typ) then
    begin
      td := FTypes[E^.L^.Typ];
      { an index proved already (P289) needs no test at the run's head }
      if (td.Hi >= td.Lo) and Fits32(td.Hi - td.Lo) and Fits32(c - td.Lo) and
        not IndexInRange(E^.R, td.Lo, td.Hi) then
      begin
        arr := '';
        p.Lo := td.Lo;
        p.Hi := td.Hi;
      end;
    end;
    if arr <> '#' then
    begin
      p.Arr := arr;
      for i := 0 to High(FProv) do
        if (FProv[i].Arr = p.Arr) and (FProv[i].Lo = p.Lo) and (FProv[i].Hi = p.Hi) and
          (FProv[i].C = p.C) then
          arr := '#';
      if arr <> '#' then
      begin
        i := Length(FProv);
        SetLength(FProv, i + 1);
        FProv[i] := p;
      end;
    end;
  end;
  ProofScanE(E^.L);
  ProofScanE(E^.R);
  for i := 0 to High(E^.Args) do
    ProofScanE(E^.Args[i]);
end;

procedure TEmitter.ProofScanS(S: PStmt);
var
  i: SizeInt;
begin
  if S = nil then
    Exit;
  ProofScanE(S^.E);
  ProofScanE(S^.E2);
  ProofScanE(S^.Dest);
  ProofScanS(S^.ThenSt);
  ProofScanS(S^.ElseSt);
  ProofScanS(S^.Body);
  for i := 0 to High(S^.Stmts) do
    ProofScanS(S^.Stmts[i]);
  for i := 0 to High(S^.Arms) do
    ProofScanS(S^.Arms[i].Body);
end;

{ E, a slice's element at counter + c, is one the run's head proved. }
function TEmitter.SliceProven(E: PExpr): Boolean;
var
  i: SizeInt;
  c: Int64;
  n: string;
begin
  Result := False;
  if (not FProvOn) or (E = nil) or (E^.L = nil) or (E^.L^.Kind <> ekVar) or
    (not IsDyn(E^.L^.Typ)) then
    Exit;
  if not CounterOff(E^.R, c) then
    Exit;
  n := NormName(E^.L^.Name);
  for i := 0 to High(FProv) do
    if (FProv[i].Arr = n) and (FProv[i].C = c) then
    begin
      Result := True;
      Exit;
    end;
end;

{ Each proof at both ends of the run, the counter R and the run's end
  CH, all values between them lying between those: out of range, to
  Fail. An unsigned compare catches a negative index too. }
procedure TEmitter.ProofTests(const R, CH, Fail: string);
var
  i, e: SizeInt;
  x, op: string;
  d, n: Int64;
begin
  for i := 0 to High(FProv) do
    for e := 0 to 1 do
    begin
      if e = 0 then
        x := R
      else
        x := CH;
      if FProv[i].Arr <> '' then
      begin
        d := FProv[i].C;
        if FArm then
        begin
          op := x;
          if d <> 0 then
          begin
            AddImmArm('x1', x, d);
            op := 'x1';
          end;
          { a length at its home into x2 first, as the word place loads
            it (P319) }
          if FProv[i].Len <> '' then
            Line('  cmp ' + op + ', ' + FProv[i].Len)
          else
          begin
            if FProv[i].LenLab <> '' then
            begin
              LeaS(FProv[i].LenLab, 'x16');
              Line('  ldr x2, [x16, #8]');
            end
            else
              LdFP('x2', FProv[i].LenOff);
            Line('  cmp ' + op + ', x2');
          end;
          JumpCC('hs', Fail);
        end
        else
        begin
          op := '%' + x;
          if d <> 0 then
          begin
            Line('  leaq ' + IntToStr(d) + '(%' + x + '), %rax');
            op := '%rax';
          end;
          { a length at its home is CMP's memory operand (P319) }
          if FProv[i].Len <> '' then
            Line('  cmpq %' + FProv[i].Len + ', ' + op)
          else if FProv[i].LenLab <> '' then
            Line('  cmpq ' + FProv[i].LenLab + '+8(%rip), ' + op)
          else
            Line('  cmpq ' + IntToStr(FProv[i].LenOff) + '(%rbp), ' + op);
          Line('  jae ' + Fail);
        end;
      end
      else
      begin
        d := FProv[i].C - FProv[i].Lo;
        n := FProv[i].Hi - FProv[i].Lo;
        if FArm then
        begin
          op := x;
          if d <> 0 then
          begin
            AddImmArm('x1', x, d);
            op := 'x1';
          end;
          if n <= 4095 then
            Line('  cmp ' + op + ', #' + IntToStr(n))
          else
          begin
            Imm('x2', n);
            Line('  cmp ' + op + ', x2');
          end;
          JumpCC('hi', Fail);
        end
        else
        begin
          op := '%' + x;
          if d <> 0 then
          begin
            Line('  leaq ' + IntToStr(d) + '(%' + x + '), %rax');
            op := '%rax';
          end;
          Line('  cmpq $' + IntToStr(n) + ', ' + op);
          Line('  ja ' + Fail);
        end;
      end;
    end;
end;

{ S holds a loop. }
{ A region of integer arithmetic alone (1.1.1): scalar integer
  variables of this routine, constants, the arithmetic, logic, shift and
  rotation operators and comparisons, in assignments, ifs and loops.
  No call, no string, slice, array, record, real, set or vector, no bit
  or wide word: nothing the emitter writes through r8, so a loop there
  may keep a variable in r8 (the expression pool then stops at rdi). }
function TEmitter.PureIntE(E: PExpr): Boolean;
var
  s: TSym;
begin
  Result := False;
  if E = nil then
    Exit;
  case E^.Kind of
    ekInt:
      Result := True;
    ekVar:
      Result := TryFindSym(E^.Name, s) and (not s.ByRef) and (s.Up = 0) and
        (TKind(s.Typ) = tykInteger) and (not s.Global or not FIsUnit);
    ekUn:
      Result := ((E^.Un = uoNeg) or (E^.Un = uoNot)) and (TKind(E^.Typ) = tykInteger) and
        PureIntE(E^.L);
    ekBin:
      begin
        Result := (TKind(E^.Typ) = tykInteger) or (E^.Typ = TyBoolean);
        if Result then
          case E^.Bin of
            boAdd, boSub, boMul, boDiv, boMod, boAnd, boOr, boXor, boShl, boShr,
            boSar, boRol, boRor, boEq, boNe, boLt, boLe, boGt, boGe:
              Result := PureIntE(E^.L) and PureIntE(E^.R) and
                (TKind(E^.L^.Typ) = tykInteger) and (TKind(E^.R^.Typ) = tykInteger);
          else
            Result := False;
          end;
      end;
  else
    Result := False;
  end;
end;

function TEmitter.PureIntS(S: PStmt): Boolean;
var
  i: SizeInt;
  sy: TSym;
begin
  Result := True;
  if S = nil then
    Exit;
  case S^.Kind of
    skBlock:
      for i := 0 to High(S^.Stmts) do
        if not PureIntS(S^.Stmts[i]) then
          Result := False;
    skAssign:
      Result := (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) and PureIntE(S^.Dest) and
        PureIntE(S^.E);
    skIf:
      Result := PureIntE(S^.E) and PureIntS(S^.ThenSt) and PureIntS(S^.ElseSt);
    skWhile, skRepeat:
      Result := PureIntE(S^.E) and PureIntS(S^.Body);
    skFor:
      Result := TryFindSym(S^.Name, sy) and (not sy.ByRef) and (sy.Up = 0) and
        (TKind(sy.Typ) = tykInteger) and PureIntE(S^.E) and PureIntE(S^.E2) and
        PureIntS(S^.Body);
  else
    Result := False;
  end;
end;

function TEmitter.HasLoop(S: PStmt): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if S = nil then
    Exit;
  Result := True;
  if (S^.Kind = skWhile) or (S^.Kind = skRepeat) or (S^.Kind = skFor) or
    (S^.Kind = skForIn) then
    Exit;
  if HasLoop(S^.ThenSt) or HasLoop(S^.ElseSt) or HasLoop(S^.Body) then
    Exit;
  for i := 0 to High(S^.Stmts) do
    if HasLoop(S^.Stmts[i]) then
      Exit;
  for i := 0 to High(S^.Arms) do
    if HasLoop(S^.Arms[i].Body) then
      Exit;
  Result := False;
end;

{ S assigns the variable N, or a field a with names like it. A body
  that sets its counter back could stay in one run for ever, never
  passing the run's preemption test (1.0.98 ran such a loop in runs). }
function TEmitter.WritesVar(S: PStmt; const N: string): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if S = nil then
    Exit;
  Result := True;
  if (S^.Kind = skAssign) or (S^.Kind = skInc) or (S^.Kind = skDec) then
  begin
    if (S^.Dest = nil) and SameSym(S^.Name, N) then
      Exit;
    if (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) and SameSym(S^.Dest^.Name, N) then
      Exit;
  end;
  if ((S^.Kind = skFor) or (S^.Kind = skForIn)) and SameSym(S^.Name, N) then
    Exit;
  if WritesVar(S^.ThenSt, N) or WritesVar(S^.ElseSt, N) or WritesVar(S^.Body, N) then
    Exit;
  for i := 0 to High(S^.Stmts) do
    if WritesVar(S^.Stmts[i], N) then
      Exit;
  for i := 0 to High(S^.Arms) do
    if WritesVar(S^.Arms[i].Body, N) then
      Exit;
  Result := False;
end;

{ S holds a for without a loop inside, which EmitFor runs in runs, or
  a while or a repeat that counts, which EmitLoopRun runs so (P283). }
function TEmitter.HasInnerFor(S: PStmt): Boolean;
var
  i: SizeInt;
  leaf: PExpr;
  up: Boolean;
begin
  Result := False;
  if S = nil then
    Exit;
  Result := True;
  if (S^.Kind = skFor) and (not HasLoop(S^.Body)) then
    Exit;
  if CountedLoop(S, leaf, up) then
    Exit;
  if HasInnerFor(S^.ThenSt) or HasInnerFor(S^.ElseSt) or HasInnerFor(S^.Body) then
    Exit;
  for i := 0 to High(S^.Stmts) do
    if HasInnerFor(S^.Stmts[i]) then
      Exit;
  for i := 0 to High(S^.Arms) do
    if HasInnerFor(S^.Arms[i].Body) then
      Exit;
  Result := False;
end;

{ S holds a continue: in a loop without a loop inside, the loop's own. }
function TEmitter.HasContinue(S: PStmt): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if S = nil then
    Exit;
  Result := True;
  if S^.Kind = skContinue then
    Exit;
  if HasContinue(S^.ThenSt) or HasContinue(S^.ElseSt) or HasContinue(S^.Body) then
    Exit;
  for i := 0 to High(S^.Stmts) do
    if HasContinue(S^.Stmts[i]) then
      Exit;
  for i := 0 to High(S^.Arms) do
    if HasContinue(S^.Arms[i].Body) then
      Exit;
  Result := False;
end;

{ E is a limit no pass of Body changes: constants, and variables a loop
  could keep in a register that Body does not write, or the length of a
  string or a slice of this frame that Body does not assign, joined by
  integer arithmetic. It is read once a run (P283). }
function TEmitter.RunLimit(E: PExpr; Body: PStmt): Boolean;
var
  s: TSym;
  a: PExpr;
begin
  Result := False;
  if E = nil then
    Exit;
  case E^.Kind of
    ekInt:
      Result := True;
    ekVar:
      Result := TryFindSym(E^.Name, s) and PromoCand(s) and
        (TKind(s.Typ) <> tykBoolean) and not WritesVar(Body, E^.Name);
    ekUn:
      Result := (E^.Un = uoNeg) and RunLimit(E^.L, Body);
    ekBin:
      Result := ((E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or
        (E^.Bin = boAnd) or (E^.Bin = boOr) or (E^.Bin = boXor) or
        (E^.Bin = boShl) or (E^.Bin = boShr)) and (TKind(E^.Typ) = tykInteger) and
        RunLimit(E^.L, Body) and RunLimit(E^.R, Body);
    ekCall:
      if (E^.Name = 'rt_length') and (Length(E^.Args) = 1) then
      begin
        a := E^.Args[0];
        Result := (a <> nil) and (a^.Kind = ekVar) and TryFindSym(a^.Name, s) and
          (IsStr(s.Typ) or IsDyn(s.Typ)) and (not s.ByRef) and (s.Up = 0) and
          (not s.Global) and (not s.Boxed) and (not AddrTakenSym(s)) and
          not WritesVar(Body, a^.Name);
      end;
  end;
end;

{ St steps the variable N by a constant: N := N + c, N := c + N,
  N := N - c, Inc(N, c) or Dec(N, c); C is the signed step. }
function TEmitter.RunStep(St: PStmt; const N: string; out C: Int64): Boolean;
var
  e: PExpr;
begin
  Result := False;
  C := 0;
  if St = nil then
    Exit;
  if (St^.Kind = skInc) or (St^.Kind = skDec) then
  begin
    if (St^.Dest = nil) or (St^.Dest^.Kind <> ekVar) or not SameSym(St^.Dest^.Name, N) then
      Exit;
    if (St^.E = nil) or (St^.E^.Kind <> ekInt) then
      Exit;
    C := St^.E^.Num;
    if St^.Kind = skDec then
      C := -C;
    Result := True;
    Exit;
  end;
  if St^.Kind <> skAssign then
    Exit;
  if St^.Dest = nil then
  begin
    if not SameSym(St^.Name, N) then
      Exit;
  end
  else if (St^.Dest^.Kind <> ekVar) or not SameSym(St^.Dest^.Name, N) then
    Exit;
  e := St^.E;
  if (e = nil) or (e^.Kind <> ekBin) or (e^.L = nil) or (e^.R = nil) then
    Exit;
  if (e^.Bin = boAdd) and (e^.L^.Kind = ekVar) and SameSym(e^.L^.Name, N) and
    (e^.R^.Kind = ekInt) then
    C := e^.R^.Num
  else if (e^.Bin = boAdd) and (e^.R^.Kind = ekVar) and SameSym(e^.R^.Name, N) and
    (e^.L^.Kind = ekInt) then
    C := e^.L^.Num
  else if (e^.Bin = boSub) and (e^.L^.Kind = ekVar) and SameSym(e^.L^.Name, N) and
    (e^.R^.Kind = ekInt) then
    C := -e^.R^.Num
  else
    Exit;
  Result := True;
end;

{ A while or a repeat that counts (P283): the test of its condition, or
  the first test of the and that is a while's condition or of the or
  that is a repeat's until, compares a 64-bit variable with a limit no
  pass changes (RunLimit), and the body, with no loop and no continue in
  it, steps the variable towards the limit once a pass by a constant of
  1 to 1023, at its top level, where nothing else writes it. Leaf is
  that test and Up says the variable counts up. }
function TEmitter.CountedLoop(S: PStmt; out Leaf: PExpr; out Up: Boolean): Boolean;
var
  e: PExpr;
  vs: TSym;
  i, steps: SizeInt;
  c: Int64;
  one: TStmtArray;
begin
  Result := False;
  Leaf := nil;
  Up := False;
  if (S = nil) or (S^.E = nil) or (S^.Body = nil) or
    ((S^.Kind <> skWhile) and (S^.Kind <> skRepeat)) then
    Exit;
  if HasLoop(S^.Body) or HasContinue(S^.Body) then
    Exit;
  e := S^.E;
  if S^.Kind = skWhile then
  begin
    while (e^.Kind = ekBin) and (e^.Bin = boAnd) and (e^.Typ = TyBoolean) and (e^.L <> nil) do
      e := e^.L;
  end
  else
    while (e^.Kind = ekBin) and (e^.Bin = boOr) and (e^.Typ = TyBoolean) and (e^.L <> nil) do
      e := e^.L;
  if (e^.Kind <> ekBin) or (e^.L = nil) or (e^.R = nil) or (e^.L^.Kind <> ekVar) then
    Exit;
  case e^.Bin of
    boLt, boLe:
      Up := S^.Kind = skWhile;
    boGt, boGe:
      Up := S^.Kind = skRepeat;
  else
    Exit;
  end;
  if not PlainOrd(e^.L, vs) then
    Exit;
  if (vs.Global and (FIsUnit or ExtGlobal(vs.Name))) or AddrTakenSym(vs) then
    Exit;
  if NamesVar(e^.R, vs.Name) or not RunLimit(e^.R, S^.Body) then
    Exit;
  if S^.Body^.Kind = skBlock then
    one := S^.Body^.Stmts
  else
  begin
    one := nil;
    SetLength(one, 1);
    one[0] := S^.Body;
  end;
  steps := 0;
  for i := 0 to High(one) do
    if RunStep(one[i], vs.Name, c) then
    begin
      if Up and ((c < 1) or (c > 1023)) then
        Exit;
      if (not Up) and ((c > -1) or (c < -1023)) then
        Exit;
      Inc(steps);
    end
    else if WritesVar(one[i], vs.Name) then
      Exit;
  if steps <> 1 then
    Exit;
  Leaf := e;
  Result := True;
end;

{ The tests of S's condition after Leaf, in order: the and's for a
  while, the or's for a repeat. }
procedure TEmitter.RunRest(E, Leaf: PExpr; var Rest: TExprArray);
var
  k: SizeInt;
begin
  if (E = nil) or (E = Leaf) then
    Exit;
  RunRest(E^.L, Leaf, Rest);
  k := Length(Rest);
  SetLength(Rest, k + 1);
  Rest[k] := E^.R;
end;

{ A while or a repeat that counts runs in runs of 1024 passes with one
  preemption test a run, as a for does (P283, P100): the test at the end
  of a pass compares the variable with the run's end in FChunkReg, then
  the rest of the condition; past the run's end the whole condition is
  tested, then the guard word, and the next run's end is worked out
  (RunEnd). The first run's end is worked out on the way in, with no
  preemption test (the next run's head has it): a loop of a few passes
  pays what it paid before, three instructions and a compare, and each
  pass after the first saves the guard's compare and branch. }
function TEmitter.EmitLoopRun(S: PStmt): Boolean;
var
  leaf: PExpr;
  rest: TExprArray;
  up, wt: Boolean;
  vs: TSym;
  a, b, c, head: string;
  i: SizeInt;
begin
  Result := False;
  if (not FPromoOn) or (FChunkReg = '') then
    Exit;
  if not CountedLoop(S, leaf, up) then
    Exit;
  vs := FindSym(leaf^.L^.Name);
  if vs.Reg = '' then
    Exit;
  Result := True;
  a := Lab;
  b := Lab;
  c := Lab;
  head := Lab;
  PushLoop(b, c);
  RunEnd(leaf^.R, vs.Reg, up);
  if S^.Kind = skWhile then
    JumpCC('', c);
  AlignLoop;
  Line(a + ':');
  EmitStmt(S^.Body);
  if (S^.Kind = skRepeat) and FDaOn and (S^.DaGen = FDaGen) then
    FCurDa := S^.Da2;
  Line(c + ':');
  EmitLoc(S^.Line);
  rest := nil;
  RunRest(S^.E, leaf, rest);
  if FArm then
    Line('  cmp ' + vs.Reg + ', ' + FChunkReg)
  else
    Line('  cmpq %' + FChunkReg + ', %' + vs.Reg);
  { the leaf over the run's end: a while goes on while it holds, a
    repeat while it fails }
  wt := S^.Kind = skWhile;
  if Length(rest) = 0 then
    JumpCC(CondCC(leaf^.Bin, wt), a)
  else
  begin
    JumpCC(CondCC(leaf^.Bin, not wt), head);
    for i := 0 to High(rest) - 1 do
      if not CondJmp(rest[i], b, not wt) then
      begin
        EmitExpr(rest[i]);
        RunBool(b, not wt);
      end;
    if not CondJmp(rest[High(rest)], a, wt) then
    begin
      EmitExpr(rest[High(rest)]);
      RunBool(a, wt);
    end;
    JumpCC('', b);
  end;
  Line(head + ':');
  if not CondJmp(S^.E, b, not wt) then
  begin
    EmitExpr(S^.E);
    RunBool(b, not wt);
  end;
  EmitStackCheck(head, '16');
  RunEnd(leaf^.R, vs.Reg, up);
  JumpCC('', a);
  Line(b + ':');
  PopLoop;
end;

{ FChunkReg := the end of the run that starts at the variable in V,
  towards the limit E: the lesser of V + 1023 and E counting up, the
  greater of V - 1023 and E counting down (P283). Each end is on the
  limit's side, so a pass the run lets go on is one the condition lets
  go on, however the variable stands to the limit on the way in; near
  High(Integer) (Low going down) the sum wraps to the other side, the
  end falls behind V, and every pass goes back to the whole test, still
  right. E is read from its register when the loop keeps it in one.
  Three instructions where ForChunk's unsigned form takes six: a for
  works out its run's end only past its limit's test, and its proofs
  (ProofTests) want an end that is never behind the counter. }
procedure TEmitter.RunEnd(E: PExpr; const V: string; Up: Boolean);
var
  s: TSym;
  l, ch: string;
begin
  if (E^.Kind = ekVar) and PlainOrd(E, s) and (s.Reg <> '') then
    l := s.Reg
  else
  begin
    EmitExpr(E);
    if FArm then
      l := 'x0'
    else
      l := 'rax';
  end;
  ch := FChunkReg;
  if FArm then
  begin
    if Up then
      Line('  add ' + ch + ', ' + V + ', #1023')
    else
      Line('  sub ' + ch + ', ' + V + ', #1023');
    Line('  cmp ' + ch + ', ' + l);
    if Up then
      Line('  csel ' + ch + ', ' + l + ', ' + ch + ', gt')
    else
      Line('  csel ' + ch + ', ' + l + ', ' + ch + ', lt');
  end
  else
  begin
    if Up then
      Line('  leaq 1023(%' + V + '), %' + ch)
    else
      Line('  leaq -1023(%' + V + '), %' + ch);
    Line('  cmpq %' + l + ', %' + ch);
    if Up then
      Line('  cmovgq %' + l + ', %' + ch)
    else
      Line('  cmovlq %' + l + ', %' + ch);
  end;
end;

{ The Boolean in rax (x0): on to Target when it is True if WhenTrue,
  when it is False otherwise. }
procedure TEmitter.RunBool(const Target: string; WhenTrue: Boolean);
begin
  if FArm then
  begin
    if WhenTrue then
      Line('  cbnz x0, ' + Target)
    else
      Line('  cbz x0, ' + Target);
  end
  else
  begin
    Line('  testq %rax, %rax');
    if WhenTrue then
      Line('  jnz ' + Target)
    else
      Line('  jz ' + Target);
  end;
end;

{ P284: the bit of the local N among the routine's candidates (the
  locals and Result whose pointer words the prologue leaves as they
  are), 0 when N is not one. Result answers to its own name too. }
function TEmitter.DaBit(const N: string): Int64;
var
  i: SizeInt;
begin
  Result := 0;
  for i := 0 to High(FDaName) do
    if SameSym(FDaName[i], N) or ((FDaName[i] = 'result') and (FDaAlias <> '') and
      SameSym(N, FDaAlias)) then
    begin
      Result := Int64(1) shl i;
      Exit;
    end;
end;

{ The candidates S starts with written, as WalkW (pasast) counts them
  (P284): an assignment of a whole variable writes it, an if and a case
  keep what every branch writes, a loop keeps what was written before
  it, and an exit, a halt, a break or a continue ends its path, so
  anything after it on that path counts as written. Any other statement
  is reached by a candidate only written (WalkW asks so), and its parts
  start with what it starts with. S^.Da is what S starts with; a
  repeat's Da2 is what its until is tested with. }
procedure TEmitter.DaWalk(S: PStmt; var M: Int64);
var
  i: SizeInt;
  m1, m2, all: Int64;
begin
  if S = nil then
    Exit;
  S^.Da := M;
  S^.DaGen := FDaGen;
  case S^.Kind of
    skAssign:
      if (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) then
        M := M or DaBit(S^.Dest^.Name)
      else if S^.Dest = nil then
        M := M or DaBit(S^.Name);
    skIf:
      begin
        m1 := M;
        DaWalk(S^.ThenSt, m1);
        m2 := M;
        DaWalk(S^.ElseSt, m2);
        M := m1 and m2;
      end;
    skWhile:
      begin
        m1 := M;
        DaWalk(S^.Body, m1);
      end;
    skRepeat:
      begin
        m1 := M;
        DaWalk(S^.Body, m1);
        S^.Da2 := m1;
      end;
    skFor:
      begin
        m1 := M or DaBit(S^.Name);
        DaWalk(S^.Body, m1);
      end;
    skBlock:
      for i := 0 to High(S^.Stmts) do
        DaWalk(S^.Stmts[i], M);
    skCase:
      begin
        all := -1;
        for i := 0 to High(S^.Arms) do
        begin
          m1 := M;
          DaWalk(S^.Arms[i].Body, m1);
          all := all and m1;
        end;
        m2 := M;
        DaWalk(S^.ElseSt, m2);
        M := all and m2;
      end;
    skExit, skHalt, skBreak, skContinue:
      M := -1;
  else
    begin
      m1 := M;
      DaWalk(S^.ThenSt, m1);
      m1 := M;
      DaWalk(S^.ElseSt, m1);
      m1 := M;
      DaWalk(S^.Body, m1);
      for i := 0 to High(S^.Stmts) do
      begin
        m1 := M;
        DaWalk(S^.Stmts[i], m1);
      end;
      for i := 0 to High(S^.Arms) do
      begin
        m1 := M;
        DaWalk(S^.Arms[i].Body, m1);
      end;
      for i := 0 to High(S^.Sels) do
      begin
        m1 := M;
        DaWalk(S^.Sels[i].Body, m1);
      end;
    end;
  end;
end;

{ The locals and Result that start unwritten (P284): those with a
  pointer word, whose address nobody takes, that every path writes
  before it reads them (WritesFirst), at most 64. The prologue leaves
  them as they are, and a call's map counts their pointer words only
  where they are written (DaWalk, MapEnd): where WalkW says one is not
  written, no path reads it before writing it again, so its value
  there is dead and its slot is not read. Result is left as it is
  whenever every path writes it before reading it and before the
  routine returns. A routine with nested routines, closures' boxes or
  -debug keeps them all zero, as P112 did. }
procedure TEmitter.DaSetup(const Pr: TProc; Loc0: LongInt);
var
  i, j, n: SizeInt;
  slot, sz: LongInt;
  bits: TGcBits;
  children, twice: Boolean;
  nm: string;
  m: Int64;
begin
  Inc(FDaGen);
  FDaOn := False;
  FDaResKeep := False;
  FDaName := nil;
  FDaOff := nil;
  FDaWords := nil;
  FDaAlias := '';
  FCurDa := 0;
  if FDebug or (Pr.Body = nil) or Pr.Boxing or (Length(Pr.Shared) > 0) then
    Exit;
  children := False;
  for i := 0 to High(FProgProcs) do
    if FProgProcs[i].ParentSym = Pr.Sym then
      children := True;
  if children then
    Exit;
  slot := Loc0;
  for i := 0 to High(Pr.Locals) do
  begin
    sz := Align8(SlotSize(Pr.Locals[i].Typ));
    slot := slot + sz;
    if Length(FDaName) >= 63 then
      Continue;
    nm := ToLower(Pr.Locals[i].Name);
    twice := False;
    for j := 0 to High(Pr.Locals) do
      if (j <> i) and SameSym(Pr.Locals[j].Name, Pr.Locals[i].Name) then
        twice := True;
    if twice or LocAddrTaken(nm) then
      Continue;
    bits := nil;
    GcMark(Pr.Locals[i].Typ, 0, bits, 0);
    if not GcAny(bits) then
      Continue;
    if not WritesFirst(Pr.Body, Pr.Locals[i].Name, '') then
      Continue;
    n := Length(FDaName);
    SetLength(FDaName, n + 1);
    SetLength(FDaOff, n + 1);
    SetLength(FDaWords, n + 1);
    FDaName[n] := nm;
    FDaOff[n] := -slot;
    FDaWords[n] := sz div 8;
  end;
  if Pr.IsFunc and FHasRes and WritesFirst(Pr.Body, 'result', Pr.Name) and
    (not LocAddrTaken('result')) and (not LocAddrTaken(FResName)) then
  begin
    FDaResKeep := True;
    bits := nil;
    GcMark(Pr.RetTyp, 0, bits, 0);
    if GcAny(bits) then
    begin
      n := Length(FDaName);
      SetLength(FDaName, n + 1);
      SetLength(FDaOff, n + 1);
      SetLength(FDaWords, n + 1);
      FDaName[n] := 'result';
      FDaOff[n] := FResOff;
      FDaWords[n] := Align8(TSize(Pr.RetTyp)) div 8;
      FDaAlias := Pr.Name;
    end;
  end;
  if Length(FDaName) = 0 then
    Exit;
  FDaOn := True;
  m := 0;
  DaWalk(Pr.Body, m);
end;

{ S emitted with what DaWalk found written at its start (P284); a
  statement of no walk of this routine leaves it as it was. }
procedure TEmitter.EmitStmt(S: PStmt);
var
  old: Int64;
begin
  old := FCurDa;
  if FDaOn and (S <> nil) and (S^.DaGen = FDaGen) then
    FCurDa := S^.Da;
  EmitStmtNow(S);
  FCurDa := old;
end;

function TEmitter.TreeKey(T: LongInt): LongInt;
begin
  if IsStr(FTypes[T].Elem) then
    Result := 16
  else
    Result := 8;
end;

function TEmitter.TreeVal(T: LongInt): LongInt;
begin
  if FTypes[T].Elem2 < 0 then
    Result := 0
  else
    Result := TSize(FTypes[T].Elem2);
end;

procedure TEmitter.LoadSlot(Sz: LongInt);
begin
  if Sz <= 0 then
    Exit;
  if FArm then
  begin
    if Sz > 8 then
    begin
      Line('  ldr x2, [x0, #8]');
      Line('  ldr x0, [x0]');
    end
    else
      Line('  ldr x0, [x0]');
  end
  else if Sz > 8 then
  begin
    Line('  movq 8(%rax), %rdx');
    Line('  movq (%rax), %rax');
  end
  else
    Line('  movq (%rax), %rax');
end;

{ Maps and trees return a slot pointer, not a string-shaped value.
  Follow the value's actual representation; a missing block points at
  a typed zero block, as Go's current maps/runtime.go mapaccess1_fat.
  Intel SDM MOV/TEST/Jcc/XOR/LEA and Arm ARM LDR/CBZ/MOV/ADRP. }
procedure TEmitter.LoadCollectionValue(T: LongInt);
var
  missing, done: string;
begin
  missing := Lab;
  done := Lab;
  if FArm then
  begin
    Line('  cbz x0, ' + missing);
    if not IsBlob(T) then
    begin
      if IsDyn(T) then
        Line('  ldr x3, [x0, #16]');
      if IsFat(T) then
        Line('  ldr x2, [x0, #8]');
      Line('  ldr x0, [x0]');
    end;
    Line('  b ' + done);
    Line(missing + ':');
    if IsBlob(T) then
    begin
      if TSize(T) > FZeroMax then
        FZeroMax := TSize(T);
      LeaS('.Lzeroblk', 'x0');
    end
    else
      Line('  mov x0, xzr');
    if IsFat(T) then
      Line('  mov x2, xzr');
    if IsDyn(T) then
      Line('  mov x3, xzr');
  end
  else
  begin
    Line('  testq %rax, %rax');
    Line('  jz ' + missing);
    if not IsBlob(T) then
    begin
      if IsDyn(T) then
        Line('  movq 16(%rax), %r8');
      if IsFat(T) then
        Line('  movq 8(%rax), %rdx');
      Line('  movq (%rax), %rax');
    end;
    Line('  jmp ' + done);
    Line(missing + ':');
    if IsBlob(T) then
    begin
      if TSize(T) > FZeroMax then
        FZeroMax := TSize(T);
      Line('  leaq .Lzeroblk(%rip), %rax');
    end
    else
      Line('  xorl %eax, %eax');
    if IsFat(T) then
      Line('  xorl %edx, %edx');
    if IsDyn(T) then
      Line('  xorl %r8d, %r8d');
  end;
  Line(done + ':');
end;

{ An insertion can grow a map or shift a tree's leaf. Freeze the value
  before evaluating the destination: t[b] := t[a] must not copy a stale
  slot, and strings must already be shared if the destination changes
  their source. ScratchT gives the copy its exact stack-map roots. }
procedure TEmitter.FreezeCollectionBlob(T: LongInt);
var
  off: LongInt;
  have, smap: string;
begin
  off := ScratchT(TSize(T), T);
  have := Lab;
  smap := StrMap(T);
  if TSize(T) > FZeroMax then
    FZeroMax := TSize(T);
  if FArm then
  begin
    Line('  cbnz x0, ' + have);
    LeaS('.Lzeroblk', 'x0');
    Line(have + ':');
    Line('  mov x1, x0');
    AddFP('x0', off);
    Imm('x2', TSize(T));
    Line('  bl rt_memcpy');
    if smap <> '' then
    begin
      AddFP('x0', off);
      LeaS(smap, 'x1');
      Line('  bl rt_strshare');
    end;
    AddFP('x0', off);
  end
  else
  begin
    Line('  testq %rax, %rax');
    Line('  jnz ' + have);
    Line('  leaq .Lzeroblk(%rip), %rax');
    Line(have + ':');
    Line('  movq %rax, %rsi');
    Line('  leaq ' + IntToStr(off) + '(%rbp), %rdi');
    Line('  movq $' + IntToStr(TSize(T)) + ', %rcx');
    Line('  call rt_memcpy');
    if smap <> '' then
    begin
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rdi');
      Line('  leaq ' + smap + '(%rip), %rsi');
      Line('  call rt_strshare');
    end;
    Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
  end;
end;

procedure TEmitter.KeyScratch(E: PExpr; out Off: LongInt);
begin
  Off := ScratchT(16, E^.Typ);
  EmitExpr(E);
  if FArm then
  begin
    if IsStr(E^.Typ) then
    begin
      ShareStrOf(E);
      StFP('x0', Off);
      StFP('x2', Off + 8);
    end
    else
      StFP('x0', Off);
  end
  else if IsStr(E^.Typ) then
  begin
    ShareStrOf(E);
    Line('  movq %rax, ' + IntToStr(Off) + '(%rbp)');
    Line('  movq %rdx, ' + IntToStr(Off + 8) + '(%rbp)');
  end
  else
    Line('  movq %rax, ' + IntToStr(Off) + '(%rbp)');
end;

{ A tree whose key compares as an integer (the descriptor's kind 0: not
  a string, not a real) and whose value takes one 8-byte slot: PasTreeGetI
  and PasTreePutI take its key by value. }
function TEmitter.TreeIntSlot(Typ: LongInt): Boolean;
var
  kk: TTypeKind;
  vs: LongInt;
begin
  Result := False;
  if (Typ < 0) or (FTypes[Typ].Kind <> tykTree) or (FTypes[Typ].Elem2 < 0) then
    Exit;
  kk := FTypes[FTypes[Typ].Elem].Kind;
  if (kk = tykString) or (kk = tykReal) then
    Exit;
  vs := TSize(FTypes[Typ].Elem2);
  Result := (vs >= 1) and (vs <= 8);
end;

{ A key or element narrower than a slot (an ordinal of 1, 2 or 4 bytes,
  or a Single): Pop and PopLow/PopHigh take it out into a scratch and
  store it at its own width, when one came out (1.1.1: the unit copied
  the whole 8-byte slot into the variable, and a Byte field took the
  fields after it with it). }
procedure TEmitter.PopNarrow(Sz, Outo: LongInt; const DestAt: string);
var
  skip: string;
begin
  skip := Lab;
  if FArm then
  begin
    Line('  and w9, w0, #255');
    Line('  cbz w9, ' + skip);
    Line('  ldr x9, ' + DestAt);
    LdFP('x10', Outo);
    if Sz = 1 then
      Line('  strb w10, [x9]')
    else if Sz = 2 then
      Line('  strh w10, [x9]')
    else
      Line('  str w10, [x9]');
  end
  else
  begin
    Line('  testb %al, %al');
    Line('  jz ' + skip);
    Line('  movq ' + DestAt + ', %rcx');
    Line('  movq ' + IntToStr(Outo) + '(%rbp), %rdx');
    if Sz = 1 then
      Line('  movb %dl, (%rcx)')
    else if Sz = 2 then
      Line('  movw %dx, (%rcx)')
    else
      Line('  movl %edx, (%rcx)');
  end;
  Line(skip + ':');
end;

function TEmitter.EmitTreeCall(E: PExpr): Boolean;
var
  off, outo, boff, ksz, vsz: LongInt;
  desc, a, b, sym, smap, smap2: string;
  ishp, bykey: Boolean;
begin
  Result := False;
  if E = nil then
    Exit;
  ishp := (E^.Name = 'rt_heapnew') or (E^.Name = 'rt_heappush') or
    (E^.Name = 'rt_heappop') or (E^.Name = 'rt_heappop1') or (E^.Name = 'rt_heaplow');
  if not (ishp or (Copy(E^.Name, 1, 7) = 'rt_tree')) then
    Exit;
  Result := True;
  if E^.Name = 'rt_treenew' then
    desc := '.LdescTree_' + IntToStr(E^.Typ)
  else if E^.Name = 'rt_heapnew' then
    desc := '.LdescHeap_' + IntToStr(E^.Typ)
  else if ishp then
    desc := '.LdescHeap_' + IntToStr(E^.Args[0]^.Typ)
  else
    desc := '.LdescTree_' + IntToStr(E^.Args[0]^.Typ);
  if (E^.Name = 'rt_treenew') or (E^.Name = 'rt_heapnew') then
  begin
    if E^.Name = 'rt_heapnew' then
      sym := 'p_pastree_pasheapnew'
    else
      sym := 'p_pastree_pastreenew';
    if FArm then
    begin
      LeaS(desc, 'x0');
      Line('  bl ' + sym);
    end
    else
    begin
      Line('  leaq ' + desc + '(%rip), %rdi');
      Line('  call ' + sym);
    end;
    Exit;
  end;
  if (E^.Name = 'rt_treeget') or (E^.Name = 'rt_treeput') or
    (E^.Name = 'rt_treein') or (E^.Name = 'rt_treedel') or
    (E^.Name = 'rt_treerank') then
  begin
    { a key that compares as an integer and a value in one 8-byte slot:
      the key by value to PasTreeGetI / PasTreePutI (1.1.1) }
    bykey := ((E^.Name = 'rt_treeget') or (E^.Name = 'rt_treeput')) and TreeIntSlot(E^.Args[0]^.Typ);
    if FArm then
    begin
      EmitExpr(E^.Args[0]);
      PshK('x0', 0);
      if bykey then
      begin
        EmitExpr(E^.Args[1]);
        Line('  mov x1, x0');
        Ppop('x0');
      end
      else
      begin
        KeyScratch(E^.Args[1], off);
        Ppop('x0');
        AddFP('x1', off);
      end;
      LeaS(desc, 'x2');
      if E^.Name = 'rt_treedel' then
        Line('  bl p_pastree_pastreedelete')
      else if E^.Name = 'rt_treerank' then
        Line('  bl p_pastree_pastreerank')
      else if bykey and (E^.Name = 'rt_treeput') then
        Line('  bl p_pastree_pastreeputi')
      else if bykey then
        Line('  bl p_pastree_pastreegeti')
      else if E^.Name = 'rt_treeput' then
        Line('  bl p_pastree_pastreeput')
      else
        Line('  bl p_pastree_pastreeget');
      if E^.Name = 'rt_treein' then
      begin
        Line('  cmp x0, #0');
        Line('  cset x0, ne');
      end
      else if E^.Name = 'rt_treeget' then
      begin
        if FTypes[E^.Args[0]^.Typ].Elem2 < 0 then
        begin
          Line('  cmp x0, #0');
          Line('  cset x0, ne');
        end
        else
          LoadCollectionValue(E^.Typ);
      end;
    end
    else
    begin
      EmitExpr(E^.Args[0]);
      PushK('rax', 0);
      if bykey then
      begin
        EmitExpr(E^.Args[1]);
        Line('  movq %rax, %rsi');
        Line('  popq %rdi');
      end
      else
      begin
        KeyScratch(E^.Args[1], off);
        Line('  popq %rdi');
        Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
      end;
      Line('  leaq ' + desc + '(%rip), %rdx');
      if E^.Name = 'rt_treedel' then
        Line('  call p_pastree_pastreedelete')
      else if E^.Name = 'rt_treerank' then
        Line('  call p_pastree_pastreerank')
      else if bykey and (E^.Name = 'rt_treeput') then
        Line('  call p_pastree_pastreeputi')
      else if bykey then
        Line('  call p_pastree_pastreegeti')
      else if E^.Name = 'rt_treeput' then
        Line('  call p_pastree_pastreeput')
      else
        Line('  call p_pastree_pastreeget');
      if E^.Name = 'rt_treein' then
      begin
        Line('  testq %rax, %rax');
        Line('  movq $0, %rax');
        Line('  setne %al');
      end
      else if E^.Name = 'rt_treeget' then
      begin
        if FTypes[E^.Args[0]^.Typ].Elem2 < 0 then
        begin
          Line('  testq %rax, %rax');
          Line('  movq $0, %rax');
          Line('  setne %al');
        end
        else
          LoadCollectionValue(E^.Typ);
      end;
    end;
    Exit;
  end;
  if E^.Name = 'rt_treeclear' then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      LeaS(desc, 'x1');
      Line('  bl p_pastree_pastreeclear');
    end
    else
    begin
      Line('  movq %rax, %rdi');
      Line('  leaq ' + desc + '(%rip), %rsi');
      Line('  call p_pastree_pastreeclear');
    end;
    Exit;
  end;
  if E^.Name = 'rt_heappush' then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      PshK('x0', 0);
      KeyScratch(E^.Args[1], off);
      Ppop('x0');
      AddFP('x1', off);
      LeaS(desc, 'x2');
      Line('  bl p_pastree_pasheappush');
    end
    else
    begin
      PushK('rax', 0);
      KeyScratch(E^.Args[1], off);
      Line('  popq %rdi');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
      Line('  leaq ' + desc + '(%rip), %rdx');
      Line('  call p_pastree_pasheappush');
    end;
    Exit;
  end;
  if E^.Name = 'rt_heappop' then
  begin
    { Pop(h, v): the least element into v, which then shares its
      strings with nobody but was copied, so they are marked shared;
      v's address stays on the stack across the call }
    smap := StrMap(FTypes[E^.Args[0]^.Typ].Elem);
    ksz := TSize(FTypes[E^.Args[0]^.Typ].Elem);
    outo := 0;
    if ksz < 8 then
      outo := ScratchT(16, FTypes[E^.Args[0]^.Typ].Elem);
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      PshK('x0', 0);
      EmitExpr(E^.Args[1]);
      PshK('x0', 2);
      if ksz < 8 then
        AddFP('x1', outo)
      else
        Line('  mov x1, x0');
      Line('  ldr x0, [sp, #16]');
      LeaS(desc, 'x2');
      Line('  bl p_pastree_pasheappop');
      if ksz < 8 then
        PopNarrow(ksz, outo, '[sp]');
      if smap <> '' then
      begin
        PshK('x0', 0);
        Line('  ldr x0, [sp, #16]');
        LeaS(smap, 'x1');
        Line('  bl rt_strshare');
        Ppop('x0');
      end;
      Line('  add sp, sp, #32');
    end
    else
    begin
      PushK('rax', 0);
      EmitExpr(E^.Args[1]);
      PushK('rax', 2);
      if ksz < 8 then
        Line('  leaq ' + IntToStr(outo) + '(%rbp), %rsi')
      else
        Line('  movq %rax, %rsi');
      Line('  movq 8(%rsp), %rdi');
      Line('  leaq ' + desc + '(%rip), %rdx');
      Line('  call p_pastree_pasheappop');
      if ksz < 8 then
        PopNarrow(ksz, outo, '(%rsp)');
      if smap <> '' then
      begin
        PushK('rax', 0);
        Line('  movq 8(%rsp), %rdi');
        Line('  leaq ' + smap + '(%rip), %rsi');
        Line('  call rt_strshare');
        Line('  popq %rax');
      end;
      Line('  addq $16, %rsp');
    end;
    Exit;
  end;
  { Pop(h) and Low(h): the least element out of a scratch; an empty
    heap stops the program (P110). }
  if (E^.Name = 'rt_heappop1') or (E^.Name = 'rt_heaplow') then
  begin
    ksz := TreeKey(E^.Args[0]^.Typ);
    outo := ScratchT(16, FTypes[E^.Args[0]^.Typ].Elem);
    if E^.Name = 'rt_heaplow' then
      sym := 'p_pastree_pasheaplow'
    else
      sym := 'p_pastree_pasheappop';
    EmitExpr(E^.Args[0]);
    a := Lab;
    if FArm then
    begin
      AddFP('x1', outo);
      LeaS(desc, 'x2');
      Line('  bl ' + sym);
      Line('  tbnz w0, #0, ' + a);
      Line('  bl p_pastree_pasheapempty');
      Line(a + ':');
      LdFP('x0', outo);
      if ksz > 8 then
        LdFP('x2', outo + 8);
    end
    else
    begin
      Line('  movq %rax, %rdi');
      Line('  leaq ' + IntToStr(outo) + '(%rbp), %rsi');
      Line('  leaq ' + desc + '(%rip), %rdx');
      Line('  call ' + sym);
      Line('  testb %al, %al');
      Line('  jnz ' + a);
      Line('  call p_pastree_pasheapempty');
      Line(a + ':');
      Line('  movq ' + IntToStr(outo) + '(%rbp), %rax');
      if ksz > 8 then
        Line('  movq ' + IntToStr(outo + 8) + '(%rbp), %rdx');
    end;
    Exit;
  end;
  { Low, High, Succ, Pred, Floor and Ceil of a tree (P110): the key into
    a scratch, the answer out of another; the unit stops the program
    when there is none. Low and High pass no key. }
  if E^.Name = 'rt_treebound' then
  begin
    ksz := TreeKey(E^.Args[0]^.Typ);
    EmitExpr(E^.Args[0]);
    if FArm then
      PshK('x0', 0)
    else
      PushK('rax', 0);
    if E^.Args[1]^.Kind = ekNil then
      off := ScratchT(16, TyInteger)
    else
      KeyScratch(E^.Args[1], off);
    outo := ScratchT(16, FTypes[E^.Args[0]^.Typ].Elem);
    if FArm then
    begin
      Ppop('x0');
      AddFP('x1', off);
      AddFP('x2', outo);
      LeaS(desc, 'x3');
      Imm('x4', E^.Args[2]^.Num);
      Line('  bl p_pastree_pastreebound');
      LdFP('x0', outo);
      if ksz > 8 then
        LdFP('x2', outo + 8);
    end
    else
    begin
      Line('  popq %rdi');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
      Line('  leaq ' + IntToStr(outo) + '(%rbp), %rdx');
      Line('  leaq ' + desc + '(%rip), %rcx');
      Line('  movq $' + IntToStr(E^.Args[2]^.Num) + ', %r8');
      Line('  call p_pastree_pastreebound');
      Line('  movq ' + IntToStr(outo) + '(%rbp), %rax');
      if ksz > 8 then
        Line('  movq ' + IntToStr(outo + 8) + '(%rbp), %rdx');
    end;
    Exit;
  end;
  { KeyAt(t, i): the key at rank i, out of a scratch. }
  if E^.Name = 'rt_treekeyat' then
  begin
    ksz := TreeKey(E^.Args[0]^.Typ);
    outo := ScratchT(16, FTypes[E^.Args[0]^.Typ].Elem);
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      PshK('x0', 0);
      EmitExpr(E^.Args[1]);
      Line('  mov x1, x0');
      Ppop('x0');
      AddFP('x2', outo);
      LeaS(desc, 'x3');
      Line('  bl p_pastree_pastreekeyat');
      LdFP('x0', outo);
      if ksz > 8 then
        LdFP('x2', outo + 8);
    end
    else
    begin
      PushK('rax', 0);
      EmitExpr(E^.Args[1]);
      Line('  movq %rax, %rsi');
      Line('  popq %rdi');
      Line('  leaq ' + IntToStr(outo) + '(%rbp), %rdx');
      Line('  leaq ' + desc + '(%rip), %rcx');
      Line('  call p_pastree_pastreekeyat');
      Line('  movq ' + IntToStr(outo) + '(%rbp), %rax');
      if ksz > 8 then
        Line('  movq ' + IntToStr(outo + 8) + '(%rbp), %rdx');
    end;
    Exit;
  end;
  { Split(t, k) gives the new tree; Include(t, k) puts k in. }
  if (E^.Name = 'rt_treesplit') or (E^.Name = 'rt_treeadd') then
  begin
    if E^.Name = 'rt_treesplit' then
      sym := 'p_pastree_pastreesplit'
    else
      sym := 'p_pastree_pastreeput';
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      PshK('x0', 0);
      KeyScratch(E^.Args[1], off);
      Ppop('x0');
      AddFP('x1', off);
      LeaS(desc, 'x2');
      Line('  bl ' + sym);
    end
    else
    begin
      PushK('rax', 0);
      KeyScratch(E^.Args[1], off);
      Line('  popq %rdi');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
      Line('  leaq ' + desc + '(%rip), %rdx');
      Line('  call ' + sym);
    end;
    Exit;
  end;
  if E^.Name = 'rt_treejoin' then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      PshK('x0', 0);
      EmitExpr(E^.Args[1]);
      Line('  mov x1, x0');
      Ppop('x0');
      LeaS(desc, 'x2');
      Line('  bl p_pastree_pastreejoin');
    end
    else
    begin
      PushK('rax', 0);
      EmitExpr(E^.Args[1]);
      Line('  movq %rax, %rsi');
      Line('  popq %rdi');
      Line('  leaq ' + desc + '(%rip), %rdx');
      Line('  call p_pastree_pastreejoin');
    end;
    Exit;
  end;
  { t[k] := b of a tree of K: True puts k in, False takes it out. }
  if E^.Name = 'rt_treeset' then
  begin
    boff := ScratchT(8, TyInteger);
    EmitExpr(E^.Args[2]);
    if FArm then
      StFP('x0', boff)
    else
      Line('  movq %rax, ' + IntToStr(boff) + '(%rbp)');
    EmitExpr(E^.Args[0]);
    a := Lab;
    b := Lab;
    if FArm then
    begin
      PshK('x0', 0);
      KeyScratch(E^.Args[1], off);
      Ppop('x0');
      AddFP('x1', off);
      LeaS(desc, 'x2');
      LdFP('x9', boff);
      Line('  tbz w9, #0, ' + a);
      Line('  bl p_pastree_pastreeput');
      Line('  b ' + b);
      Line(a + ':');
      Line('  bl p_pastree_pastreedelete');
      Line(b + ':');
    end
    else
    begin
      PushK('rax', 0);
      KeyScratch(E^.Args[1], off);
      Line('  popq %rdi');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
      Line('  leaq ' + desc + '(%rip), %rdx');
      Line('  cmpb $0, ' + IntToStr(boff) + '(%rbp)');
      Line('  je ' + a);
      Line('  call p_pastree_pastreeput');
      Line('  jmp ' + b);
      Line(a + ':');
      Line('  call p_pastree_pastreedelete');
      Line(b + ':');
    end;
    Exit;
  end;
  { TryGet(t, k, v): the slot, then the value copied into v, whose
    strings are then marked shared; v's address stays on the stack. }
  if E^.Name = 'rt_treetry' then
  begin
    vsz := TreeVal(E^.Args[0]^.Typ);
    smap := StrMap(FTypes[E^.Args[0]^.Typ].Elem2);
    EmitExpr(E^.Args[0]);
    a := Lab;
    b := Lab;
    if FArm then
    begin
      PshK('x0', 0);
      KeyScratch(E^.Args[1], off);
      Ppop('x0');
      AddFP('x1', off);
      LeaS(desc, 'x2');
      Line('  bl p_pastree_pastreeget');
      Line('  cbz x0, ' + a);
      PshK('x0', 1);
      EmitExpr(E^.Args[2]);
      PshK('x0', 2);
      Line('  ldr x1, [sp, #16]');
      Imm('x2', vsz);
      Line('  bl rt_memcpy');
      Ppop('x0');
      if smap <> '' then
      begin
        LeaS(smap, 'x1');
        Line('  bl rt_strshare');
      end;
      Line('  add sp, sp, #16');
      Line('  mov x0, #1');
      Line('  b ' + b);
      Line(a + ':');
      Line('  mov x0, xzr');
      Line(b + ':');
    end
    else
    begin
      PushK('rax', 0);
      KeyScratch(E^.Args[1], off);
      Line('  popq %rdi');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
      Line('  leaq ' + desc + '(%rip), %rdx');
      Line('  call p_pastree_pastreeget');
      Line('  testq %rax, %rax');
      Line('  jz ' + a);
      PushK('rax', 1);
      EmitExpr(E^.Args[2]);
      PushK('rax', 2);
      Line('  movq %rax, %rdi');
      Line('  movq 8(%rsp), %rsi');
      Line('  movq $' + IntToStr(vsz) + ', %rcx');
      Line('  call rt_memcpy');
      Line('  popq %rdi');
      if smap <> '' then
      begin
        Line('  leaq ' + smap + '(%rip), %rsi');
        Line('  call rt_strshare');
      end;
      Line('  addq $8, %rsp');
      Line('  movq $1, %rax');
      Line('  jmp ' + b);
      Line(a + ':');
      Line('  xorl %eax, %eax');
      Line(b + ':');
    end;
    Exit;
  end;
  { PopLow(t, k, v) and PopHigh: the tree, k's address and v's (or 0)
    on the stack, the unit copies them out; their strings are then
    marked shared. }
  if E^.Name = 'rt_treepop' then
  begin
    smap := StrMap(FTypes[E^.Args[0]^.Typ].Elem);
    smap2 := '';
    if E^.Args[2]^.Kind <> ekNil then
      smap2 := StrMap(FTypes[E^.Args[0]^.Typ].Elem2);
    ksz := TSize(FTypes[E^.Args[0]^.Typ].Elem);
    outo := 0;
    if ksz < 8 then
      outo := ScratchT(16, FTypes[E^.Args[0]^.Typ].Elem);
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      PshK('x0', 0);
      EmitExpr(E^.Args[1]);
      PshK('x0', 2);
      if E^.Args[2]^.Kind = ekNil then
        Line('  mov x0, xzr')
      else
        EmitExpr(E^.Args[2]);
      PshK('x0', 2);
      Line('  mov x2, x0');
      if ksz < 8 then
        AddFP('x1', outo)
      else
        Line('  ldr x1, [sp, #16]');
      Line('  ldr x0, [sp, #32]');
      LeaS(desc, 'x3');
      Imm('x4', E^.Args[3]^.Num);
      Line('  bl p_pastree_pastreepop');
      if ksz < 8 then
        PopNarrow(ksz, outo, '[sp, #16]');
      if (smap <> '') or (smap2 <> '') then
      begin
        PshK('x0', 0);
        if smap <> '' then
        begin
          Line('  ldr x0, [sp, #32]');
          LeaS(smap, 'x1');
          Line('  bl rt_strshare');
        end;
        if smap2 <> '' then
        begin
          Line('  ldr x0, [sp, #16]');
          LeaS(smap2, 'x1');
          Line('  bl rt_strshare');
        end;
        Ppop('x0');
      end;
      Line('  add sp, sp, #48');
    end
    else
    begin
      PushK('rax', 0);
      EmitExpr(E^.Args[1]);
      PushK('rax', 2);
      if E^.Args[2]^.Kind = ekNil then
        Line('  xorl %eax, %eax')
      else
        EmitExpr(E^.Args[2]);
      PushK('rax', 2);
      Line('  movq %rax, %rdx');
      if ksz < 8 then
        Line('  leaq ' + IntToStr(outo) + '(%rbp), %rsi')
      else
        Line('  movq 8(%rsp), %rsi');
      Line('  movq 16(%rsp), %rdi');
      Line('  leaq ' + desc + '(%rip), %rcx');
      Line('  movq $' + IntToStr(E^.Args[3]^.Num) + ', %r8');
      Line('  call p_pastree_pastreepop');
      if ksz < 8 then
        PopNarrow(ksz, outo, '8(%rsp)');
      if (smap <> '') or (smap2 <> '') then
      begin
        PushK('rax', 0);
        if smap <> '' then
        begin
          Line('  movq 16(%rsp), %rdi');
          Line('  leaq ' + smap + '(%rip), %rsi');
          Line('  call rt_strshare');
        end;
        if smap2 <> '' then
        begin
          Line('  movq 8(%rsp), %rdi');
          Line('  leaq ' + smap2 + '(%rip), %rsi');
          Line('  call rt_strshare');
        end;
        Line('  popq %rax');
      end;
      Line('  addq $24, %rsp');
    end;
    Exit;
  end;
  Result := False;
end;

procedure TEmitter.EmitTreeStore(Dest: PExpr);
begin
  EmitMapStore(Dest);
end;

{ for k, v in t, for k in t, downto, and over t[a..b] (P110): the
  bounds are worked out once into key scratches; the iterator lives in
  48 bytes below the frame (the leaf, a pointer; the index in it;
  whether a step was taken); each step gives the key slot and the value
  follows the key; the loop's key and value share the tree's strings. }
procedure TEmitter.EmitTreeFor(S: PStmt);
var
  a, b, desc, smap, slow, have, got: string;
  ksz, vsz, vstride, kt, vt, loff, hoff: LongInt;
  base, lo, hi: PExpr;
  fast: Boolean;
begin
  base := S^.E;
  lo := nil;
  hi := nil;
  if (base <> nil) and (base^.Kind = ekCall) and (base^.Name = 'rt_treerange') then
  begin
    lo := base^.Args[1];
    hi := base^.Args[2];
    base := base^.Args[0];
  end;
  desc := '.LdescTree_' + IntToStr(base^.Typ);
  kt := FTypes[base^.Typ].Elem;
  vt := FTypes[base^.Typ].Elem2;
  ksz := TreeKey(base^.Typ);
  vsz := TreeVal(base^.Typ);
  vstride := Align8(vsz);
  loff := 0;
  hoff := 0;
  if lo <> nil then
  begin
    KeyScratch(lo, loff);
    KeyScratch(hi, hoff);
  end;
  a := Lab;
  b := Lab;
  { The plain ascending walk steps in place after the first step
    (1.1.1): the next slot of the leaf, or the first of the next leaf;
    the first step, a range, a walk downwards and a tree being written
    go through PasTreeStep. The leaf's layout is pastree's: OffNext 8,
    OffCount 24, Hdr 48, MaxK 32 keys and the values after them. }
  fast := (lo = nil) and (not S^.Down);
  slow := Lab;
  have := Lab;
  got := Lab;
  PushLoop(b, a);
  if FArm then
  begin
    MapHint4(1, 0, 0, 0);
    Line('  sub sp, sp, #48');
    Line('  str xzr, [sp]');
    Line('  str xzr, [sp, #8]');
    Line('  str xzr, [sp, #16]');
    Line(a + ':');
    EmitExpr(base);
    if fast then
    begin
      Line('  ldr x1, [sp, #16]');
      Line('  cbz x1, ' + slow);
      Line('  ldr x1, [x0, #24]');
      Line('  cbnz x1, ' + slow);
      Line('  ldr x1, [sp]');
      Line('  ldr x2, [sp, #8]');
      Line('  add x2, x2, #1');
      Line('  ldr x3, [x1, #24]');
      Line('  cmp x2, x3');
      Line('  b.lt ' + have);
      Line('  ldr x1, [x1, #8]');
      Line('  mov x2, xzr');
      Line('  cbz x1, ' + b);
      Line('  ldr x3, [x1, #24]');
      Line('  cbz x3, ' + b);
      Line(have + ':');
      Line('  str x1, [sp]');
      Line('  str x2, [sp, #8]');
      if vsz > 0 then
      begin
        ScaleAddArm('x4', 'x1', 'x2', vstride, 'x3', '');
        AddImmArmT('x4', 'x4', 48 + 32 * ksz, 'x3');
        Line('  str x4, [sp, #24]');
      end;
      ScaleAddArm('x0', 'x1', 'x2', ksz, 'x3', '');
      Line('  add x0, x0, #48');
      Line('  b ' + got);
      Line(slow + ':');
    end;
    Line('  mov x1, sp');
    if lo <> nil then
    begin
      AddFP('x2', loff);
      AddFP('x3', hoff);
    end
    else
    begin
      Line('  mov x2, xzr');
      Line('  mov x3, xzr');
    end;
    if S^.Down then
      Line('  mov x4, #1')
    else
      Line('  mov x4, xzr');
    LeaS(desc, 'x5');
    Line('  bl p_pastree_pastreestep');
    Line('  cbz x0, ' + b);
    if fast then
      Line(got + ':');
    PshK('x0', 1);
    EmitAddr(NewVar(S^.Name, kt));
    Line('  ldr x1, [sp]');
    Imm('x2', TSize(kt));
    Line('  bl rt_memcpy');
    smap := StrMap(kt);
    if smap <> '' then
    begin
      EmitAddr(NewVar(S^.Name, kt));
      LeaS(smap, 'x1');
      Line('  bl rt_strshare');
    end;
    if (S^.Dest <> nil) and (vsz > 0) then
    begin
      EmitAddr(S^.Dest);
      { the iterator's fourth word, the iterator at sp + 16 after the push }
      Line('  ldr x1, [sp, #40]');
      Imm('x2', vsz);
      Line('  bl rt_memcpy');
      smap := StrMap(vt);
      if smap <> '' then
      begin
        EmitAddr(S^.Dest);
        LeaS(smap, 'x1');
        Line('  bl rt_strshare');
      end;
    end;
    Ppop('x9');
    EmitStmt(S^.Body);
    Line('  b ' + a);
    Line(b + ':');
    Line('  add sp, sp, #48');
  end
  else
  begin
    MapHint4(1, 0, 0, 0);
    Line('  subq $48, %rsp');
    Line('  movq $0, (%rsp)');
    Line('  movq $0, 8(%rsp)');
    Line('  movq $0, 16(%rsp)');
    Line(a + ':');
    EmitExpr(base);
    if fast then
    begin
      Line('  cmpq $0, 16(%rsp)');
      Line('  je ' + slow);
      Line('  cmpq $0, 24(%rax)');
      Line('  jne ' + slow);
      Line('  movq (%rsp), %rdi');
      Line('  movq 8(%rsp), %rsi');
      Line('  incq %rsi');
      Line('  cmpq 24(%rdi), %rsi');
      Line('  jl ' + have);
      Line('  movq 8(%rdi), %rdi');
      Line('  xorq %rsi, %rsi');
      Line('  testq %rdi, %rdi');
      Line('  jz ' + b);
      Line('  cmpq $0, 24(%rdi)');
      Line('  je ' + b);
      Line(have + ':');
      Line('  movq %rdi, (%rsp)');
      Line('  movq %rsi, 8(%rsp)');
      if vsz > 0 then
      begin
        ScaleAddDispX86('%rcx', '%rdi', '%rsi', vstride, 48 + 32 * ksz, '%rax');
        Line('  movq %rcx, 24(%rsp)');
      end;
      ScaleAddDispX86('%rax', '%rdi', '%rsi', ksz, 48, '%rcx');
      Line('  jmp ' + got);
      Line(slow + ':');
    end;
    Line('  movq %rax, %rdi');
    Line('  movq %rsp, %rsi');
    if lo <> nil then
    begin
      Line('  leaq ' + IntToStr(loff) + '(%rbp), %rdx');
      Line('  leaq ' + IntToStr(hoff) + '(%rbp), %rcx');
    end
    else
    begin
      Line('  xorq %rdx, %rdx');
      Line('  xorq %rcx, %rcx');
    end;
    if S^.Down then
      Line('  movq $1, %r8')
    else
      Line('  xorq %r8, %r8');
    Line('  leaq ' + desc + '(%rip), %r9');
    Line('  call p_pastree_pastreestep');
    Line('  testq %rax, %rax');
    Line('  jz ' + b);
    if fast then
      Line(got + ':');
    PushK('rax', 1);
    EmitAddr(NewVar(S^.Name, kt));
    Line('  movq %rax, %rdi');
    Line('  movq (%rsp), %rsi');
    Line('  movq $' + IntToStr(TSize(kt)) + ', %rcx');
    Line('  call rt_memcpy');
    smap := StrMap(kt);
    if smap <> '' then
    begin
      EmitAddr(NewVar(S^.Name, kt));
      Line('  movq %rax, %rdi');
      Line('  leaq ' + smap + '(%rip), %rsi');
      Line('  call rt_strshare');
    end;
    if (S^.Dest <> nil) and (vsz > 0) then
    begin
      EmitAddr(S^.Dest);
      Line('  movq %rax, %rdi');
      { the value's place is the iterator's fourth word (1.1.1: a leaf
        keeps its values after its keys), the iterator being at 8(%rsp)
        after the key's push }
      Line('  movq 32(%rsp), %rsi');
      Line('  movq $' + IntToStr(vsz) + ', %rcx');
      Line('  call rt_memcpy');
      smap := StrMap(vt);
      if smap <> '' then
      begin
        EmitAddr(S^.Dest);
        Line('  movq %rax, %rdi');
        Line('  leaq ' + smap + '(%rip), %rsi');
        Line('  call rt_strshare');
      end;
    end;
    Line('  popq %rax');
    EmitStmt(S^.Body);
    Line('  jmp ' + a);
    Line(b + ':');
    Line('  addq $48, %rsp');
  end;
  PopLoop;
end;

procedure TEmitter.EmitMapStore(Dest: PExpr);
var
  off: LongInt;
  smap, desc: string;
begin
  if IsBlob(Dest^.Typ) then
    FreezeCollectionBlob(Dest^.Typ);
  if FArm then
  begin
    if IsBlob(Dest^.Typ) then
      PshK('x0', VCls(Dest^.Typ, 0))
    else if IsDyn(Dest^.Typ) then
    begin
      PshK('x3', VCls(Dest^.Typ, 2));
      PshK('x2', VCls(Dest^.Typ, 1));
      PshK('x0', VCls(Dest^.Typ, 0));
    end
    else if IsFat(Dest^.Typ) then
    begin
      { The map keeps the string: two holders now (1.0.82). }
      if IsStr(Dest^.Typ) then
        ShareStr;
      PshK('x2', VCls(Dest^.Typ, 1));
      PshK('x0', VCls(Dest^.Typ, 0));
    end
    else
      PshK('x0', VCls(Dest^.Typ, 0));
    EmitExpr(Dest^.Args[0]);
    PshK('x0', VCls(Dest^.Args[0]^.Typ, 0));
    if Dest^.Name = 'rt_treeget' then
    begin
      desc := '.LdescTree_' + IntToStr(Dest^.Args[0]^.Typ);
      if TreeIntSlot(Dest^.Args[0]^.Typ) then
      begin
        EmitExpr(Dest^.Args[1]);
        Line('  mov x1, x0');
        Ppop('x0');
        LeaS(desc, 'x2');
        Line('  bl p_pastree_pastreeputi');
      end
      else
      begin
        KeyScratch(Dest^.Args[1], off);
        Ppop('x0');
        AddFP('x1', off);
        LeaS(desc, 'x2');
        Line('  bl p_pastree_pastreeput');
      end;
    end
    else if IsStr(Dest^.Args[1]^.Typ) then
    begin
      off := ScratchT(16, Dest^.Args[1]^.Typ);
      EmitExpr(Dest^.Args[1]);
      ShareStrOf(Dest^.Args[1]);
      StFP('x0', off);
      StFP('x2', off + 8);
      Ppop('x0');
      AddFP('x1', off);
      LeaS('.LdescMap_' + IntToStr(Dest^.Args[0]^.Typ), 'x2');
      Line('  bl p_pasmap_pasmapputstr');
    end
    else
    begin
      { An ordinal key by value to the eight-byte path (P96). }
      EmitExpr(Dest^.Args[1]);
      Line('  mov x1, x0');
      Ppop('x0');
      LeaS('.LdescMap_' + IntToStr(Dest^.Args[0]^.Typ), 'x2');
      Line('  bl p_pasmap_pasmapputint');
    end;
    if IsBlob(Dest^.Typ) then
    begin
      Ppop('x1');
      Imm('x2', TSize(Dest^.Typ));
      smap := StrMap(Dest^.Typ);
      if smap <> '' then
        PshK('x0', 0);
      Line('  bl rt_memcpy');
      if smap <> '' then
      begin
        Ppop('x0');
        LeaS(smap, 'x1');
        Line('  bl rt_strshare');
      end;
    end
    else if IsDyn(Dest^.Typ) then
    begin
      Ppop('x1');
      Ppop('x2');
      Ppop('x3');
      Line('  str x1, [x0]');
      Line('  str x2, [x0, #8]');
      Line('  str x3, [x0, #16]');
    end
    else if IsFat(Dest^.Typ) then
    begin
      Ppop('x1');
      Ppop('x2');
      Line('  str x1, [x0]');
      Line('  str x2, [x0, #8]');
    end
    else
    begin
      Ppop('x1');
      Line('  str x1, [x0]');
    end;
  end
  else
  begin
    if IsBlob(Dest^.Typ) then
      PushK('rax', VCls(Dest^.Typ, 0))
    else if IsDyn(Dest^.Typ) then
    begin
      PushK('r8', VCls(Dest^.Typ, 2));
      PushK('rdx', VCls(Dest^.Typ, 1));
      PushK('rax', VCls(Dest^.Typ, 0));
    end
    else if IsFat(Dest^.Typ) then
    begin
      { The map keeps the string: two holders now (1.0.82). }
      if IsStr(Dest^.Typ) then
        ShareStr;
      PushK('rdx', VCls(Dest^.Typ, 1));
      PushK('rax', VCls(Dest^.Typ, 0));
    end
    else
      PushK('rax', VCls(Dest^.Typ, 0));
    EmitExpr(Dest^.Args[0]);
    PushK('rax', VCls(Dest^.Args[0]^.Typ, 0));
    if Dest^.Name = 'rt_treeget' then
    begin
      desc := '.LdescTree_' + IntToStr(Dest^.Args[0]^.Typ);
      if TreeIntSlot(Dest^.Args[0]^.Typ) then
      begin
        EmitExpr(Dest^.Args[1]);
        Line('  movq %rax, %rsi');
        Line('  popq %rdi');
        Line('  leaq ' + desc + '(%rip), %rdx');
        Line('  call p_pastree_pastreeputi');
      end
      else
      begin
        KeyScratch(Dest^.Args[1], off);
        Line('  popq %rdi');
        Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
        Line('  leaq ' + desc + '(%rip), %rdx');
        Line('  call p_pastree_pastreeput');
      end;
    end
    else if IsStr(Dest^.Args[1]^.Typ) then
    begin
      off := ScratchT(16, Dest^.Args[1]^.Typ);
      EmitExpr(Dest^.Args[1]);
      ShareStrOf(Dest^.Args[1]);
      Line('  movq %rax, ' + IntToStr(off) + '(%rbp)');
      Line('  movq %rdx, ' + IntToStr(off + 8) + '(%rbp)');
      Line('  popq %rdi');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
      Line('  leaq .LdescMap_' + IntToStr(Dest^.Args[0]^.Typ) + '(%rip), %rdx');
      Line('  call p_pasmap_pasmapputstr');
    end
    else
    begin
      { An ordinal key by value to the eight-byte path (P96). }
      EmitExpr(Dest^.Args[1]);
      Line('  movq %rax, %rsi');
      Line('  popq %rdi');
      Line('  leaq .LdescMap_' + IntToStr(Dest^.Args[0]^.Typ) + '(%rip), %rdx');
      Line('  call p_pasmap_pasmapputint');
    end;
    if IsBlob(Dest^.Typ) then
    begin
      Line('  popq %rsi');
      Line('  movq %rax, %rdi');
      Line('  movq $' + IntToStr(TSize(Dest^.Typ)) + ', %rcx');
      smap := StrMap(Dest^.Typ);
      if smap <> '' then
        PushK('rdi', 0);
      Line('  call rt_memcpy');
      if smap <> '' then
      begin
        Line('  popq %rdi');
        Line('  leaq ' + smap + '(%rip), %rsi');
        Line('  call rt_strshare');
      end;
    end
    else if IsDyn(Dest^.Typ) then
    begin
      Line('  popq %rcx');
      Line('  movq %rcx, (%rax)');
      Line('  popq %rcx');
      Line('  movq %rcx, 8(%rax)');
      Line('  popq %rcx');
      Line('  movq %rcx, 16(%rax)');
    end
    else if IsFat(Dest^.Typ) then
    begin
      Line('  popq %rcx');
      Line('  popq %rdx');
      Line('  movq %rcx, (%rax)');
      Line('  movq %rdx, 8(%rax)');
    end
    else
    begin
      Line('  popq %rcx');
      Line('  movq %rcx, (%rax)');
    end;
  end;
end;

{ P330: Dest is a place whose address calls nothing (a variable, a
  field, an element, a pointer's target), stored outside a region and a
  routine with no frame, whose r9 to r11 and x19 up hold variables, and
  on arm64 no slice, whose third word has no free register: the value's
  words may wait in registers while the address is worked out. }
function TEmitter.KeptStore(Dest: PExpr): Boolean;
begin
  Result := (Dest <> nil) and ((Dest^.Kind = ekVar) or (Dest^.Kind = ekField) or
    (Dest^.Kind = ekIndex) or (Dest^.Kind = ekDeref)) and (not EHasCall(Dest)) and
    (not FPromoOn) and (not FFlat) and not (FArm and IsDyn(Dest^.Typ));
end;

procedure TEmitter.StoreTo(Dest: PExpr);
var
  sym, smap, op, ab: string;
  av: Int64;
  slot, foff, i, nu, k: LongInt;
begin
  if DirectStore(Dest) then
    Exit;
  if (Dest <> nil) and (Dest^.Kind = ekCall) and
    ((Dest^.Name = 'rt_mapget') or (Dest^.Name = 'rt_treeget')) then
  begin
    if Dest^.Name = 'rt_treeget' then
      EmitTreeStore(Dest)
    else
      EmitMapStore(Dest);
    Exit;
  end;
  if (Dest <> nil) and (Dest^.Kind = ekProp) then
  begin
    if Dest^.Txt <> '' then
    begin
      LookupMeth(Dest^.L^.Typ, Dest^.Txt, sym, slot);
      if IsFat(Dest^.Typ) then
      begin
        if IsDyn(Dest^.Typ) then
          foff := ScratchT(24, Dest^.Typ)
        else
          foff := ScratchT(16, Dest^.Typ);
        if FArm then
        begin
          AddFP('x16', foff);
          Line('  str x0, [x16]');
          Line('  str x2, [x16, #8]');
          { A slice's capacity too, as on amd64 (1.0.88). }
          if IsDyn(Dest^.Typ) then
            Line('  str x3, [x16, #16]');
          PshK('x16', 1);
          EmitExpr(Dest^.L);
          Ppop('x1');
          if slot >= 0 then
          begin
            Line('  ldr x16, [x0]');
            LdSlotArm('x16', slot * 8);
            Line('  blr x16');
          end
          else
            Line('  bl ' + sym);
        end
        else
        begin
          Line('  movq %rax, ' + IntToStr(foff) + '(%rbp)');
          Line('  movq %rdx, ' + IntToStr(foff + 8) + '(%rbp)');
          if IsDyn(Dest^.Typ) then
            Line('  movq %r8, ' + IntToStr(foff + 16) + '(%rbp)');
          Line('  leaq ' + IntToStr(foff) + '(%rbp), %rax');
          PushK('rax', 1);
          EmitExpr(Dest^.L);
          Line('  movq %rax, %rdi');
          Line('  popq %rsi');
          if slot >= 0 then
          begin
            Line('  movq (%rdi), %rax');
            Line('  call *' + IntToStr(slot * 8) + '(%rax)');
          end
          else
            Line('  call ' + sym);
        end;
        Exit;
      end;
      if Length(Dest^.Args) > 0 then
      begin
        if Length(Dest^.Args) > 4 then
          Die('property index');
        nu := Length(Dest^.Args) + 1;
        if FArm then
        begin
          FScrHint := VCls(Dest^.Typ, 0);
          foff := Scratch(8);
          AddFP('x16', foff);
          Line('  str x0, [x16]');
          EmitExpr(Dest^.L);
          PshK('x0', VCls(Dest^.L^.Typ, 0));
          for i := 0 to High(Dest^.Args) do
          begin
            EmitExpr(Dest^.Args[i]);
            PshK('x0', VCls(Dest^.Args[i]^.Typ, 0));
          end;
          LdFP('x0', foff);
          Psh('x0');
          for i := 0 to nu do
            Line('  ldr ' + ArgR(i) + ', [sp, #' + IntToStr((nu - i) * 16) + ']');
          SpAdjArm('add', (nu + 1) * 16);
          if slot >= 0 then
          begin
            Line('  ldr x16, [x0]');
            LdSlotArm('x16', slot * 8);
            Line('  blr x16');
          end
          else
            Line('  bl ' + sym);
        end
        else
        begin
          FScrHint := VCls(Dest^.Typ, 0);
          foff := Scratch(8);
          Line('  movq %rax, ' + IntToStr(foff) + '(%rbp)');
          EmitExpr(Dest^.L);
          PushK('rax', VCls(Dest^.L^.Typ, 0));
          for i := 0 to High(Dest^.Args) do
          begin
            EmitExpr(Dest^.Args[i]);
            PushK('rax', VCls(Dest^.Args[i]^.Typ, 0));
          end;
          Line('  movq ' + IntToStr(foff) + '(%rbp), %rax');
          Line('  pushq %rax');
          ShiftArgs(nu, nu, 1);
          Line('  popq %rdi');
          if slot >= 0 then
          begin
            Line('  movq (%rdi), %rax');
            Line('  call *' + IntToStr(slot * 8) + '(%rax)');
          end
          else
            Line('  call ' + sym);
        end;
        Exit;
      end;
      if FArm then
      begin
        PshK('x0', VCls(Dest^.Typ, 0));
        EmitExpr(Dest^.L);
        Ppop('x1');
        if slot >= 0 then
        begin
          Line('  ldr x16, [x0]');
          LdSlotArm('x16', slot * 8);
          Line('  blr x16');
        end
        else
          Line('  bl ' + sym);
      end
      else
      begin
        PushK('rax', VCls(Dest^.Typ, 0));
        EmitExpr(Dest^.L);
        Line('  movq %rax, %rdi');
        Line('  popq %rsi');
        if slot >= 0 then
        begin
          Line('  movq (%rdi), %rax');
          Line('  call *' + IntToStr(slot * 8) + '(%rax)');
        end
        else
          Line('  call ' + sym);
      end;
      Exit;
    end;
    foff := Dest^.Num;
    if foff < 0 then
      foff := Dest^.Off;
    if foff < 0 then
      Die('read only property');
    if FArm then
    begin
      PshK('x0', VCls(Dest^.Typ, 0));
      EmitExpr(Dest^.L);
      if foff <> 0 then
      begin
        AddImmArm('x0', 'x0', foff);
      end;
      Ppop('x1');
      { At the field's width (P99). }
      k := FieldTypAt(Dest^.L^.Typ, foff, '');
      if k < 0 then
        k := Dest^.Typ;
      StoreFrom('[x0]', TSize(k), 'x1');
    end
    else
    begin
      PushK('rax', VCls(Dest^.Typ, 0));
      EmitExpr(Dest^.L);
      Line('  popq %rcx');
      k := FieldTypAt(Dest^.L^.Typ, foff, '');
      if k < 0 then
        k := Dest^.Typ;
      { the field's offset in the store's displacement (P329) }
      if foff <> 0 then
        StoreFrom(IntToStr(foff) + '(%rax)', TSize(k), 'rcx')
      else
        StoreFrom('(%rax)', TSize(k), 'rcx');
    end;
    Exit;
  end;
  if FArm then
  begin
    if IsBlob(Dest^.Typ) then
    begin
      PshK('x0', VCls(Dest^.Typ, 0));
      EmitAddr(Dest);
      Ppop('x1');
      Imm('x2', TSize(Dest^.Typ));
      Line('  cbz x1, .azero' + IntToStr(FLab));
      smap := StrMap(Dest^.Typ);
      if smap <> '' then
        PshK('x0', 0);
      Line('  bl rt_memcpy');
      if smap <> '' then
      begin
        { The copy's strings are the source's too (1.0.82). }
        Ppop('x0');
        LeaS(smap, 'x1');
        Line('  bl rt_strshare');
      end;
      Line('  b .adone' + IntToStr(FLab));
      Line('.azero' + IntToStr(FLab) + ':');
      { a value past 256 KiB a piece at a time (P271), from 64 bytes 32
        a store by rt_fill (P272) }
      if TSize(Dest^.Typ) >= 64 then
      begin
        Line('  mov x1, x2');
        Line('  mov w2, wzr');
        if TSize(Dest^.Typ) > 262144 then
          Line('  bl rt_fillbig')
        else
          Line('  bl rt_fill');
        Line('  b .adone' + IntToStr(FLab));
      end;
      Line('  cmp x2, #8');
      Line('  b.lt .azb' + IntToStr(FLab));
      Line('  str xzr, [x0], #8');
      Line('  sub x2, x2, #8');
      Line('  b .azero' + IntToStr(FLab));
      Line('.azb' + IntToStr(FLab) + ':');
      Line('  cbz x2, .adone' + IntToStr(FLab));
      Line('  strb wzr, [x0], #1');
      Line('  sub x2, x2, #1');
      Line('  b .azb' + IntToStr(FLab));
      Line('.adone' + IntToStr(FLab) + ':');
      Inc(FLab);
    end
    else if IsDyn(Dest^.Typ) then
    begin
      PshK('x3', VCls(Dest^.Typ, 2));
      PshK('x2', VCls(Dest^.Typ, 1));
      PshK('x0', VCls(Dest^.Typ, 0));
      EmitAddr(Dest);
      Ppop('x1');
      Line('  str x1, [x0]');
      Ppop('x1');
      Line('  str x1, [x0, #8]');
      Ppop('x1');
      Line('  str x1, [x0, #16]');
    end
    else if IsStr(Dest^.Typ) or (TKind(Dest^.Typ) = tykMethod) or
      (TKind(Dest^.Typ) = tykInterface) or (TKind(Dest^.Typ) = tykQuad) or
      (TKind(Dest^.Typ) = tykProc) then
    begin
      if IsStr(Dest^.Typ) then
        ShareStr;
      if KeptStore(Dest) then
      begin
        { P330: the two words in x8 and x27, which no address's code
          touches, then one stp: nothing pushed }
        Line('  mov x8, x0');
        Line('  mov x27, x2');
        EmitAddr(Dest);
        { into the element's base and offset (P329) }
        ArmPairAt(2, ab, av);
        Line('  stp x8, x27, ' + ArmMem(ab, av));
        Exit;
      end;
      PshK('x2', VCls(Dest^.Typ, 1));
      PshK('x0', VCls(Dest^.Typ, 0));
      EmitAddr(Dest);
      Ppop('x1');
      Line('  str x1, [x0]');
      Ppop('x1');
      Line('  str x1, [x0, #8]');
    end
    else if KeptStore(Dest) and not ((Dest^.Kind = ekIndex) and (Dest^.L <> nil) and
      IsStr(Dest^.L^.Typ)) then
    begin
      { P330: a word or less in x8 while the address is worked out }
      Line('  mov x8, x0');
      EmitAddr(Dest);
      StoreFrom('[x0]', TSize(LoadTyp(Dest)), 'x8');
    end
    else
    begin
      PshK('x0', VCls(Dest^.Typ, 0));
      { A write into a string's character makes it its own first
        (1.0.82); a one-byte Byte is not one (P99). }
      FAddrWrite := (Dest^.Kind = ekIndex) and (Dest^.L <> nil) and
        IsStr(Dest^.L^.Typ);
      EmitAddr(Dest);
      Ppop('x1');
      StoreFrom('[x0]', TSize(LoadTyp(Dest)), 'x1');
    end;
    Exit;
  end;
  if IsFat(Dest^.Typ) then
  begin
    if IsStr(Dest^.Typ) then
      ShareStr;
    if KeptStore(Dest) then
    begin
      { P330: the words in r11, r10 and r9 while the place's address is
        worked out with the pool's first three registers (PoolSize's cap,
        P297), then stored: two or three stores where the pushes, the
        pops and their moves were six or nine }
      Line('  movq %rax, %r11');
      Line('  movq %rdx, %r10');
      if IsDyn(Dest^.Typ) then
        Line('  movq %r8, %r9');
      k := FPoolCap;
      FPoolCap := 3;
      EmitAddr(Dest);
      FPoolCap := k;
      { into the element's operand (P329) }
      op := AddrOp('r11,r10,r9');
      Line('  movq %r11, ' + op);
      Line('  movq %r10, ' + OpPlus(op, 8));
      if IsDyn(Dest^.Typ) then
        Line('  movq %r9, ' + OpPlus(op, 16));
      Exit;
    end;
    if IsDyn(Dest^.Typ) then
      PushK('r8', VCls(Dest^.Typ, 2));
    PushK('rdx', VCls(Dest^.Typ, 1));
    PushK('rax', VCls(Dest^.Typ, 0));
    EmitAddr(Dest);
    op := AddrOp('rcx,rsp');
    Line('  popq %rcx');
    Line('  movq %rcx, ' + op);
    Line('  popq %rcx');
    Line('  movq %rcx, ' + OpPlus(op, 8));
    if IsDyn(Dest^.Typ) then
    begin
      Line('  popq %rcx');
      Line('  movq %rcx, ' + OpPlus(op, 16));
    end;
  end
  else if IsBlob(Dest^.Typ) then
  begin
    PushK('rax', VCls(Dest^.Typ, 0));
    EmitAddr(Dest);
    Line('  movq %rax, %rdi');
    Line('  popq %rsi');
    Line('  movq $' + IntToStr(TSize(Dest^.Typ)) + ', %rcx');
    Line('  testq %rsi, %rsi');
    Line('  jnz .stblob' + IntToStr(FLab));
    Line('  xorq %rax, %rax');
    { a value past 256 KiB a piece at a time (P271) }
    if TSize(Dest^.Typ) > 262144 then
      Line('  call rt_fillbig')
    else
      Line('  rep stosb');
    Line('  jmp .stdone' + IntToStr(FLab));
    Line('.stblob' + IntToStr(FLab) + ':');
    smap := StrMap(Dest^.Typ);
    if smap <> '' then
      PushK('rdi', 0);
    Line('  call rt_memcpy');
    if smap <> '' then
    begin
      { The copy's strings are the source's too (1.0.82). }
      Line('  popq %rdi');
      Line('  leaq ' + smap + '(%rip), %rsi');
      Line('  call rt_strshare');
    end;
    Line('.stdone' + IntToStr(FLab) + ':');
    Inc(FLab);
  end
  else if KeptStore(Dest) and not ((Dest^.Kind = ekIndex) and (Dest^.L <> nil) and
    IsStr(Dest^.L^.Typ)) then
  begin
    { P330: a word or less in r11 while the address is worked out }
    Line('  movq %rax, %r11');
    k := FPoolCap;
    FPoolCap := 3;
    EmitAddr(Dest);
    FPoolCap := k;
    StoreFrom(AddrOp(''), TSize(LoadTyp(Dest)), 'r11');
  end
  else if TSize(LoadTyp(Dest)) < 8 then
  begin
    PushK('rax', VCls(Dest^.Typ, 0));
    FAddrWrite := (Dest^.Kind = ekIndex) and (Dest^.L <> nil) and
      IsStr(Dest^.L^.Typ);
    EmitAddr(Dest);
    { the element's operand, which the pop leaves (P329) }
    op := AddrOp('rcx,rsp');
    Line('  popq %rcx');
    StoreFrom(op, TSize(LoadTyp(Dest)), 'rcx');
  end
  else
  begin
    PushK('rax', VCls(Dest^.Typ, 0));
    EmitAddr(Dest);
    op := AddrOp('rcx,rsp');
    Line('  popq %rcx');
    Line('  movq %rcx, ' + op);
  end;
end;

procedure TEmitter.LoadVar(const N: string);
var
  s: TSym;
  i: LongInt;
begin
  s := FindSym(N);
  if s.Reg <> '' then
  begin
    if FArm then
      Line('  mov x0, ' + s.Reg)
    else
      Line('  movq %' + s.Reg + ', %rax');
    Exit;
  end;
  if FArm then
  begin
    if s.ByRef then
    begin
      if s.Global then
        LdS(VarLabel(s.Name), 'x9')
      else if s.Up <= 0 then
        LdFP('x9', s.Off)
      else
      begin
        LdFP('x9', -8);
        for i := 2 to s.Up do
          Line('  ldr x9, [x9, #-8]');
        AddImmArm('x16', 'x9', s.Off);
        Line('  ldr x9, [x16]');
      end;
      Line('  cbz x9, .lvnil' + IntToStr(FLab));
      LoadTo('[x9]', s.Typ, 'x0');
      if IsFat(s.Typ) then
        Line('  ldr x2, [x9, #8]');
      if IsDyn(s.Typ) then
        Line('  ldr x3, [x9, #16]');
      Line('  b .lvdone' + IntToStr(FLab));
      Line('.lvnil' + IntToStr(FLab) + ':');
      Line('  mov x0, xzr');
      if IsFat(s.Typ) then
        Line('  mov x2, xzr');
      if IsDyn(s.Typ) then
        Line('  mov x3, xzr');
      Line('.lvdone' + IntToStr(FLab) + ':');
      Inc(FLab);
      Exit;
    end;
    if s.Global then
    begin
      { A narrow global at its width: an 8-byte ldr read a Char's
        neighbours (P99). }
      if TSize(s.Typ) < 8 then
      begin
        LeaS(VarLabel(s.Name), 'x16');
        LoadTo('[x16]', s.Typ, 'x0');
      end
      else
        LdS(VarLabel(s.Name), 'x0');
      if IsFat(s.Typ) then
      begin
        LeaS(VarLabel(s.Name), 'x16');
        Line('  ldr x2, [x16, #8]');
        if IsDyn(s.Typ) then
          Line('  ldr x3, [x16, #16]');
      end;
    end
    else if s.Up <= 0 then
    begin
      if TSize(s.Typ) < 8 then
      begin
        AddFP('x16', s.Off);
        LoadTo('[x16]', s.Typ, 'x0');
      end
      else
        LdFP('x0', s.Off);
      if IsFat(s.Typ) then
        LdFP('x2', s.Off + 8);
      if IsDyn(s.Typ) then
        LdFP('x3', s.Off + 16);
    end
    else
    begin
      LdFP('x9', -8);
      for i := 2 to s.Up do
        Line('  ldr x9, [x9, #-8]');
      AddImmArm('x16', 'x9', s.Off);
      LoadTo('[x16]', s.Typ, 'x0');
      if IsFat(s.Typ) then
        Line('  ldr x2, [x16, #8]');
      if IsDyn(s.Typ) then
        Line('  ldr x3, [x16, #16]');
    end;
    Exit;
  end;
  if s.ByRef then
  begin
    if s.Global then
      Line('  movq ' + VarLabel(s.Name) + '(%rip), %rcx')
    else if s.Up <= 0 then
      Line('  movq ' + IntToStr(s.Off) + '(%rbp), %rcx')
    else
    begin
      Line('  movq -8(%rbp), %rcx');
      for i := 2 to s.Up do
        Line('  movq -8(%rcx), %rcx');
      Line('  movq ' + IntToStr(s.Off) + '(%rcx), %rcx');
    end;
    Line('  testq %rcx, %rcx');
    Line('  jz .lvnil' + IntToStr(FLab));
    if IsFat(s.Typ) then
      Line('  movq 8(%rcx), %rdx');
    if IsDyn(s.Typ) then
      Line('  movq 16(%rcx), %r8');
    LoadTo('(%rcx)', s.Typ, 'rax');
    Line('  jmp .lvdone' + IntToStr(FLab));
    Line('.lvnil' + IntToStr(FLab) + ':');
    Line('  xorq %rax, %rax');
    if IsFat(s.Typ) then
      Line('  xorq %rdx, %rdx');
    if IsDyn(s.Typ) then
      Line('  xorq %r8, %r8');
    Line('.lvdone' + IntToStr(FLab) + ':');
    Inc(FLab);
    Exit;
  end;
  if s.Global then
  begin
    LoadTo(VarLabel(s.Name) + '(%rip)', s.Typ, 'rax');
    if IsFat(s.Typ) then
      Line('  movq ' + VarLabel(s.Name) + '+8(%rip), %rdx');
    if IsDyn(s.Typ) then
      Line('  movq ' + VarLabel(s.Name) + '+16(%rip), %r8');
  end
  else if s.Up <= 0 then
  begin
    LoadTo(IntToStr(s.Off) + '(%rbp)', s.Typ, 'rax');
    if IsFat(s.Typ) then
      Line('  movq ' + IntToStr(s.Off + 8) + '(%rbp), %rdx');
    if IsDyn(s.Typ) then
      Line('  movq ' + IntToStr(s.Off + 16) + '(%rbp), %r8');
  end
  else
  begin
    Line('  movq -8(%rbp), %rcx');
    for i := 2 to s.Up do
      Line('  movq -8(%rcx), %rcx');
    LoadTo(IntToStr(s.Off) + '(%rcx)', s.Typ, 'rax');
    if IsFat(s.Typ) then
      Line('  movq ' + IntToStr(s.Off + 8) + '(%rcx), %rdx');
    if IsDyn(s.Typ) then
      Line('  movq ' + IntToStr(s.Off + 16) + '(%rcx), %r8');
  end;
end;

procedure TEmitter.StoreVar(const N: string);
var
  s: TSym;
  i, sz: LongInt;
begin
  s := FindSym(N);
  if s.Reg <> '' then
  begin
    if FArm then
      Line('  mov ' + s.Reg + ', x0')
    else
      Line('  movq %rax, %' + s.Reg);
    Exit;
  end;
  { a var parameter, or a variable a closure shares (1.0.134), holds
    the address: a for counter or a for-in element stores through it
    (1.0.135; it overwrote the address) }
  if s.ByRef then
  begin
    sz := TSize(s.Typ);
    if (sz <> 1) and (sz <> 2) and (sz <> 4) then
      sz := 8;
    if FArm then
    begin
      if s.Global then
        LdS(VarLabel(s.Name), 'x9')
      else if s.Up <= 0 then
        LdFP('x9', s.Off)
      else
      begin
        LdFP('x9', -8);
        for i := 2 to s.Up do
          Line('  ldr x9, [x9, #-8]');
        AddImmArm('x16', 'x9', s.Off);
        Line('  ldr x9, [x16]');
      end;
      StoreWidth('x0', 'x9', sz);
    end
    else
    begin
      if s.Global then
        Line('  movq ' + VarLabel(s.Name) + '(%rip), %rcx')
      else if s.Up <= 0 then
        Line('  movq ' + IntToStr(s.Off) + '(%rbp), %rcx')
      else
      begin
        Line('  movq -8(%rbp), %rcx');
        for i := 2 to s.Up do
          Line('  movq -8(%rcx), %rcx');
        Line('  movq ' + IntToStr(s.Off) + '(%rcx), %rcx');
      end;
      StoreWidth('rax', 'rcx', sz);
    end;
    Exit;
  end;
  if FArm then
  begin
    if s.Global then
      StS('x0', VarLabel(s.Name))
    else if s.Up <= 0 then
      StFP('x0', s.Off)
    else
    begin
      PshK('x0', VCls(s.Typ, 0));
      LdFP('x9', -8);
      for i := 2 to s.Up do
        Line('  ldr x9, [x9, #-8]');
      Ppop('x0');
      AddImmArm('x16', 'x9', s.Off);
      Line('  str x0, [x16]');
    end;
    Exit;
  end;
  if s.Global then
    Line('  movq %rax, ' + VarLabel(s.Name) + '(%rip)')
  else if s.Up <= 0 then
    Line('  movq %rax, ' + IntToStr(s.Off) + '(%rbp)')
  else
  begin
    Line('  movq -8(%rbp), %rcx');
    for i := 2 to s.Up do
      Line('  movq -8(%rcx), %rcx');
    Line('  movq %rax, ' + IntToStr(s.Off) + '(%rcx)');
  end;
end;

{ The left side of a binary operation into rcx or x1: popped, or there
  already (FLeftIn, P297). }
procedure TEmitter.PopLeft;
begin
  if FLeftIn then
  begin
    FLeftIn := False;
    Exit;
  end;
  if FArm then
    Ppop('x1')
  else
    Line('  popq %rcx');
end;

{ E's value is one no call can change (P297): a constant, or a word
  variable of this routine's own that no call reaches: not a global, not
  by reference, not in a closure's box, its address not taken and named
  by no routine nested in this one (a call of which reaches it by the
  static link). }
function TEmitter.CallProof(E: PExpr): Boolean;
var
  sy: TSym;
begin
  Result := False;
  if E = nil then
    Exit;
  if (E^.Kind = ekInt) or (E^.Kind = ekNil) or ((E^.Kind = ekStr) and (Length(E^.Txt) = 1)) then
  begin
    Result := True;
    Exit;
  end;
  if (E^.Kind = ekVar) and WordVar(E, sy) and (not sy.Global) and (sy.Up = 0) and
    (not sy.ByRef) and (not sy.Boxed) and (not AddrTakenSym(sy)) and
    not InNames(FNestNames, ToLower(sy.Name)) then
    Result := True;
  { a program's global in its main block that no routine names and whose
    address nobody takes (P293's GlobalOwnedByMain), as a local of the
    main block: a unit's global another unit may write, and a unit cannot
    name a program's }
  if (E^.Kind = ekVar) and WordVar(E, sy) and sy.Global and FInMain and (not FIsUnit) and
    (not ExtGlobal(sy.Name)) and (not sy.Boxed) and (not AddrTakenSym(sy)) and
    GlobalOwnedByMain(sy.Name) then
    Result := True;
end;

{ The left side of + * and or xor as amd64 reads it after PopLeft: the
  operand LeftFirst kept, a home or a constant, or rcx (P297). }
function TEmitter.LeftSrc: string;
begin
  Result := '%rcx';
  if FLeftOp <> '' then
  begin
    Result := FLeftOp;
    FLeftOp := '';
  end;
end;

{ P297: L op R with the left side kept in rcx or x1, nothing pushed, for
  the operations that take it there (+ - * and or xor and the compares):
  R a constant, into the instruction (FRightOn); R a word variable, read
  after L as before, L moved first; R with a call and L one no call
  changes (CallProof), or R with no call and L a constant or a word
  variable, which nothing R does reaches: R first and L read after it,
  the same value, so the order the program sees, left to right, holds,
  and a call stays left to right with any other. Go copies a call in an
  expression to a temporary before the rest (walk/order.go) and reads a
  variable after it. False with nothing written when none; then L is
  pushed as before. }
function TEmitter.LeftFirst(E: PExpr): Boolean;
var
  sy: TSym;
  k: Int64;
  comm: Boolean;
begin
  Result := False;
  if not ((E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or (E^.Bin = boAnd) or
    (E^.Bin = boOr) or (E^.Bin = boXor) or (E^.Bin = boEq) or (E^.Bin = boNe) or
    (E^.Bin = boLt) or (E^.Bin = boLe) or (E^.Bin = boGt) or (E^.Bin = boGe)) then
    Exit;
  { a constant right side goes into the instruction: L into rax or x0,
    then addq $3, %rax or cmp x0, #9, where moving L aside and loading the
    constant were two more; on arm64 + - * and the compares, whose
    immediates AddImmArm and CmpImmArm take whatever their size; a
    product by Go's recipes (MulByK, P295) where one is cheaper }
  if (E^.R^.Kind = ekInt) and (TKind(E^.Typ) <> tykSet) and (TKind(E^.L^.Typ) <> tykSet) and
    (TKind(E^.L^.Typ) <> tykReal) and ((FArm and ((E^.Bin = boAdd) or (E^.Bin = boSub) or
    (E^.Bin = boMul) or (E^.Bin = boEq) or (E^.Bin = boNe) or (E^.Bin = boLt) or (E^.Bin = boLe) or
    (E^.Bin = boGt) or (E^.Bin = boGe))) or ((not FArm) and Fits32(E^.R^.Num))) then
  begin
    if (E^.L^.Kind = ekStr) and (Length(E^.L^.Txt) = 1) then
    begin
      if FArm then
        Imm('x0', Ord(E^.L^.Txt[1]))
      else
        Line('  movq $' + IntToStr(Ord(E^.L^.Txt[1])) + ', %rax');
    end
    else
      EmitExpr(E^.L);
    FRightK := E^.R^.Num;
    FRightOn := True;
    FLeftIn := True;
    Result := True;
    Exit;
  end;
  if (E^.R^.Kind = ekInt) or (E^.R^.Kind = ekNil) or
    ((E^.R^.Kind = ekStr) and (Length(E^.R^.Txt) = 1)) or
    ((E^.R^.Kind = ekVar) and WordVar(E^.R, sy)) then
  begin
    { L, then R: R's load touches nothing but rax or x0 }
    if (E^.L^.Kind = ekStr) and (Length(E^.L^.Txt) = 1) then
    begin
      if FArm then
        Imm('x1', Ord(E^.L^.Txt[1]))
      else
        Line('  movq $' + IntToStr(Ord(E^.L^.Txt[1])) + ', %rcx');
    end
    else
    begin
      EmitExpr(E^.L);
      if FArm then
        Line('  mov x1, x0')
      else
        Line('  movq %rax, %rcx');
    end;
    if (E^.R^.Kind = ekStr) and (Length(E^.R^.Txt) = 1) then
    begin
      if FArm then
        Imm('x0', Ord(E^.R^.Txt[1]))
      else
        Line('  movq $' + IntToStr(Ord(E^.R^.Txt[1])) + ', %rax');
    end
    else
      EmitExpr(E^.R);
    FLeftIn := True;
    Result := True;
    Exit;
  end;
  if (EHasCall(E^.R) and CallProof(E^.L)) or ((not EHasCall(E^.R)) and
    ((E^.L^.Kind = ekInt) or (E^.L^.Kind = ekNil) or
    ((E^.L^.Kind = ekStr) and (Length(E^.L^.Txt) = 1)) or WordVar(E^.L, sy))) then
  begin
    EmitExpr(E^.R);
    { + * and or xor on amd64 take the left side where it is: addq
      v_t(%rip), %rax, one instruction where a load into rcx and the add
      are two }
    comm := (not FArm) and ((E^.Bin = boAdd) or (E^.Bin = boMul) or (E^.Bin = boAnd) or
      (E^.Bin = boOr) or (E^.Bin = boXor)) and (TKind(E^.Typ) <> tykSet);
    if ConstOf(E^.L, k) or (E^.L^.Kind = ekNil) or (E^.L^.Kind = ekStr) then
    begin
      if E^.L^.Kind = ekStr then
        k := Ord(E^.L^.Txt[1])
      else if E^.L^.Kind = ekNil then
        k := 0;
      { a constant left side of + or * (and, or, xor on amd64) goes into the
        instruction as a right one does: the same value either way }
      if (comm and Fits32(k)) or (FArm and ((E^.Bin = boAdd) or (E^.Bin = boMul)) and
        (TKind(E^.Typ) <> tykSet)) then
      begin
        FRightK := k;
        FRightOn := True;
      end
      else if FArm then
        Imm('x1', k)
      else
        LoadImmR('rcx', k);
    end
    else
    begin
      WordVar(E^.L, sy);
      if FArm then
        LoadWordVar(sy, 'x1')
      else if comm and ((sy.Reg <> '') or (TSize(sy.Typ) = 8)) then
        FLeftOp := MemA(sy)
      else
        LoadWordVar(sy, 'rcx');
    end;
    FLeftIn := True;
    Result := True;
  end;
end;

procedure TEmitter.EmitCmp(const Setcc: string);
var
  cc: string;
begin
  if FArm then
  begin
    PopLeft;
    if FRightOn then
    begin
      FRightOn := False;
      CmpImmArm('x0', FRightK, 'x17');
    end
    else
      Line('  cmp x1, x0');
    cc := 'eq';
    if Setcc = 'sete' then
      cc := 'eq'
    else if Setcc = 'setne' then
      cc := 'ne'
    else if Setcc = 'setl' then
      cc := 'lt'
    else if Setcc = 'setle' then
      cc := 'le'
    else if Setcc = 'setg' then
      cc := 'gt'
    else if Setcc = 'setge' then
      cc := 'ge';
    Line('  cset x0, ' + cc);
    Exit;
  end;
  PopLeft;
  if FRightOn then
  begin
    FRightOn := False;
    Line('  cmpq $' + IntToStr(FRightK) + ', %rax');
  end
  else
    Line('  cmpq %rax, %rcx');
  Line('  movq $0, %rax');
  Line('  ' + Setcc + ' %al');
end;

{ Argument E straight into register R, in one or two instructions that
  touch no other register but x16, when it calls nothing and moves
  nothing (P281): a constant, a string literal by its address, a
  word-sized integer, enumeration or pointer variable of this frame or
  a global, the address of a variable of this frame or a global (a
  string's or a record's, passed by it) and a var parameter's. Go's
  register ABI puts such an argument in place
  (cmd/compile/abi-internal.md); the push, the load and the add of the
  others are three more instructions. With Put False it only says
  whether it can. }
function TEmitter.DirectArg(E: PExpr; const R: string; Put: Boolean): Boolean;
var
  s: TSym;
  k: TTypeKind;
  v: PExpr;
begin
  Result := False;
  if E = nil then
    Exit;
  case E^.Kind of
    ekInt:
      begin
        k := TKind(E^.Typ);
        if (k = tykReal) or (k = tykQuad) or (k = tykCurrency) or (k = tykSet) or IsFat(E^.Typ) or
          IsBlob(E^.Typ) then
          Exit;
        if Put then
        begin
          if FArm then
            Imm(R, E^.Num)
          else
            Line('  movq $' + IntToStr(E^.Num) + ', %' + R);
        end;
        Result := True;
      end;
    ekStr:
      begin
        if not IsFat(E^.Typ) then
          Exit;
        if Put then
        begin
          if FArm then
            LeaS(InternStrFat(E^.Txt), R)
          else
            Line('  leaq ' + InternStrFat(E^.Txt) + '(%rip), %' + R);
        end;
        Result := True;
      end;
    ekVar, ekAddr:
      begin
        v := E;
        if E^.Kind = ekAddr then
          v := E^.L;
        if (v = nil) or (v^.Kind <> ekVar) then
          Exit;
        s := FindSym(v^.Name);
        if (s.Up > 0) or s.Boxed or (s.Name = '') then
          Exit;
        if (E^.Kind = ekAddr) or IsFat(v^.Typ) or IsBlob(v^.Typ) then
        begin
          { its address: a var parameter's slot holds it }
          if s.Reg <> '' then
            Exit;
          if Put then
          begin
            if s.ByRef then
            begin
              if FArm then
              begin
                if s.Global then
                  LdS(VarLabel(s.Name), R)
                else
                  LdFP(R, s.Off);
              end
              else
                Line('  movq ' + MemA(s) + ', %' + R);
            end
            else if FArm then
            begin
              if s.Global then
                LeaS(VarLabel(s.Name), R)
              else
                AddFP(R, s.Off);
            end
            else if s.Global then
              Line('  leaq ' + VarLabel(s.Name) + '(%rip), %' + R)
            else
              Line('  leaq ' + IntToStr(s.Off) + '(%rbp), %' + R);
          end;
          Result := True;
          Exit;
        end;
        { its value: a word, read where it lies }
        k := TKind(v^.Typ);
        if (TSize(v^.Typ) <> 8) or (TSize(s.Typ) <> 8) or (k = tykReal) or (k = tykQuad) or
          (k = tykSet) or s.ByRef then
          Exit;
        if Put then
          LoadPlain(s, R);
        Result := True;
      end;
  end;
end;

{ T is an integer, a Boolean, a Char, an enumeration or a pointer of at
  most a word, whose value an expression leaves in rax or x0. }
function TEmitter.WordInt(T: LongInt): Boolean;
var
  k: TTypeKind;
begin
  k := TKind(T);
  Result := (TSize(T) <= 8) and not IsFat(T) and not IsBlob(T) and (k <> tykReal) and
    (k <> tykQuad) and (k <> tykCurrency) and (k <> tykSet);
end;

{ E is worked out with no call and changes nothing (P281): integer
  arithmetic, logic, shifts and comparisons, conversions between
  integers, variables, constants, elements and fields, a word in rax or
  x0. It may use the register pool, which holds arguments, so a call
  works out one such argument first, before any is in its register. }
function TEmitter.CallFree(E: PExpr; Depth: LongInt): Boolean;
begin
  Result := False;
  if (E = nil) or (Depth > 12) or not WordInt(E^.Typ) then
    Exit;
  case E^.Kind of
    ekInt:
      Result := True;
    ekVar:
      Result := True;
    ekBin:
      Result := (E^.Bin in [boAdd, boSub, boMul, boDiv, boMod, boEq, boNe, boLt, boLe, boGt, boGe,
        boAnd, boOr, boXor, boShl, boShr, boSar]) and WordInt(E^.L^.Typ) and
        WordInt(E^.R^.Typ) and CallFree(E^.L, Depth + 1) and CallFree(E^.R, Depth + 1);
    ekUn:
      Result := (E^.Un in [uoNeg, uoNot, uoConv]) and WordInt(E^.L^.Typ) and
        CallFree(E^.L, Depth + 1);
    ekIndex:
      Result := (E^.L <> nil) and (E^.L^.Kind = ekVar) and (TKind(E^.L^.Typ) = tykArray) and
        (E^.R <> nil) and WordInt(E^.R^.Typ) and CallFree(E^.R, Depth + 1);
    ekField:
      Result := (E^.L <> nil) and (E^.L^.Kind = ekVar) and
        ((TKind(E^.L^.Typ) = tykRecord) or (TKind(E^.L^.Typ) = tykClass));
  end;
end;

{ The arguments of a call: the first Kd worked out and pushed as before;
  each of the others calls nothing, and goes straight to its register,
  one of them, Comp (-1 for none), worked out first (P281). The whole
  plan only when the arguments fit in MaxReg registers. }
procedure TEmitter.PlanArgs(const Args: TExprArray; MaxReg: LongInt; out Kd, Comp: LongInt);
var
  i: LongInt;
begin
  Kd := Length(Args);
  Comp := -1;
  if Length(Args) > MaxReg then
    Exit;
  i := High(Args);
  while i >= 0 do
  begin
    if DirectArg(Args[i], 'rax', False) then
      Kd := i
    else if (Comp < 0) and CallFree(Args[i], 0) then
    begin
      Comp := i;
      Kd := i;
    end
    else
      Break;
    i := i - 1;
  end;
end;

{ The arguments from Kd on into their registers, the one worked out
  first, Reg0 the register of argument 0 (1 for a method's, Self in the
  first). }
procedure TEmitter.PutArgs(const Args: TExprArray; Kd, Comp, Reg0: LongInt);
var
  i: LongInt;
begin
  if Comp >= 0 then
  begin
    EmitExpr(Args[Comp]);
    if FArm then
    begin
      if Reg0 + Comp <> 0 then
        Line('  mov ' + ArgR(Reg0 + Comp) + ', x0');
    end
    else
      Line('  movq %rax, %' + ArgReg(Reg0 + Comp));
  end;
  for i := Kd to High(Args) do
    if i <> Comp then
    begin
      if FArm then
        DirectArg(Args[i], ArgR(Reg0 + i), True)
      else
        DirectArg(Args[i], ArgReg(Reg0 + i), True);
    end;
end;

{ Self, Obj, in rdi and the arguments in rsi and on, for a method's call
  on amd64: the arguments after the last one that calls or moves
  anything straight to their registers, and Self too when it is a class
  variable and nothing else is pushed (P281); the others pushed and
  shifted as before, Self pushed with SelfCls. The words the call
  leaves on the stack past the registers, which the caller takes off
  with Self's after the call. }
function TEmitter.MethArgs(Obj: PExpr; SelfCls: Byte; const Args: TExprArray): LongInt;
var
  n, kd, nreg, i, comp: LongInt;
begin
  Result := 0;
  n := Length(Args);
  PlanArgs(Args, 5, kd, comp);
  if (kd = 0) and (Obj^.Kind = ekVar) and (TKind(Obj^.Typ) = tykClass) and
    DirectArg(Obj, 'rax', False) then
  begin
    PutArgs(Args, 0, comp, 1);
    DirectArg(Obj, 'rdi', True);
    Exit;
  end;
  if kd = 0 then
  begin
    { P297: Self worked out first, into rdi, or into r10 while an
      argument is worked out in the pool's first three registers }
    EmitExpr(Obj);
    if comp >= 0 then
    begin
      Line('  movq %rax, %r10');
      PutArgsKept(Args, comp, 1);
      Line('  movq %r10, %rdi');
    end
    else
    begin
      Line('  movq %rax, %rdi');
      PutArgs(Args, 0, -1, 1);
    end;
    Exit;
  end;
  EmitExpr(Obj);
  PushK('rax', SelfCls);
  for i := 0 to kd - 1 do
  begin
    { the rules of every call, P80 included: a record value is already
      an address }
    EmitArgVal(Args[i]);
    PushK('rax', ACls(Args[i]));
  end;
  if kd < n then
  begin
    PutArgs(Args, kd, comp, 1);
    ShiftArgs(kd, kd, 1);
    Line('  popq %rdi');
    Exit;
  end;
  if n > 5 then
    nreg := 5
  else
    nreg := n;
  ShiftArgs(n, nreg, 1);
  if n > nreg then
    Line('  movq ' + IntToStr((n - nreg) * 8) + '(%rsp), %rdi')
  else
    Line('  popq %rdi');
  Result := n - nreg;
end;

procedure TEmitter.EmitCall(const Name: string; const Args: TExprArray);
var
  i, n, nreg, kd: SizeInt;
  kd0, comp: LongInt;
  off: LongInt;
  te: PExpr;
  kinds: array of Byte;
  top: SizeInt;
begin
  te := NewCall(Name, Args, TyNone);
  if EmitTreeCall(te) then
    Exit;
  if (Name = 'rt_mapclear') and (Length(Args) = 1) and
    (TKind(Args[0]^.Typ) = tykMap) then
  begin
    EmitExpr(Args[0]);
    if FArm then
    begin
      LeaS('.LdescMap_' + IntToStr(Args[0]^.Typ), 'x1');
      Line('  bl p_pasmap_pasmapclear');
    end
    else
    begin
      Line('  movq %rax, %rdi');
      Line('  leaq .LdescMap_' + IntToStr(Args[0]^.Typ) + '(%rip), %rsi');
      Line('  call p_pasmap_pasmapclear');
    end;
    Exit;
  end;
  if (Name = 'rt_mapdel') and (Length(Args) = 2) and
    (TKind(Args[0]^.Typ) = tykMap) then
  begin
    if FArm then
    begin
      EmitExpr(Args[0]);
      PshK('x0', VCls(Args[0]^.Typ, 0));
      off := ScratchT(16, Args[1]^.Typ);
      if IsStr(Args[1]^.Typ) then
      begin
        EmitExpr(Args[1]);
        StFP('x0', off);
        StFP('x2', off + 8);
      end
      else
      begin
        EmitExpr(Args[1]);
        StFP('x0', off);
      end;
      Ppop('x0');
      AddFP('x1', off);
      LeaS('.LdescMap_' + IntToStr(Args[0]^.Typ), 'x2');
      Line('  bl p_pasmap_pasmapdelete');
    end
    else
    begin
      EmitExpr(Args[0]);
      PushK('rax', VCls(Args[0]^.Typ, 0));
      off := ScratchT(16, Args[1]^.Typ);
      if IsStr(Args[1]^.Typ) then
      begin
        EmitExpr(Args[1]);
        Line('  movq %rax, ' + IntToStr(off) + '(%rbp)');
        Line('  movq %rdx, ' + IntToStr(off + 8) + '(%rbp)');
      end
      else
      begin
        EmitExpr(Args[1]);
        Line('  movq %rax, ' + IntToStr(off) + '(%rbp)');
      end;
      Line('  popq %rdi');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
      Line('  leaq .LdescMap_' + IntToStr(Args[0]^.Typ) + '(%rip), %rdx');
      Line('  call p_pasmap_pasmapdelete');
    end;
    Exit;
  end;
  if Name = 'rt_tcpwrite' then
  begin
    if FArm then
    begin
      EmitExpr(Args[0]);
      PshK('x0', VCls(Args[0]^.Typ, 0));
      EmitExpr(Args[1]);
      Line('  mov x1, x0');
      Ppop('x0');
      Line('  bl rt_tcpwrite');
    end
    else
    begin
      EmitExpr(Args[0]);
      PushK('rax', VCls(Args[0]^.Typ, 0));
      EmitExpr(Args[1]);
      Line('  movq %rax, %rsi');
      Line('  popq %rdi');
      Line('  call rt_tcpwrite');
    end;
    Exit;
  end;
  n := Length(Args);
  if n > 32 then
    Die('at most 32 arguments');
  { the arguments after the last one that calls or moves anything go
    straight to their registers, after the others are worked out (P281) }
  if FArm then
    PlanArgs(Args, 8, kd0, comp)
  else
    PlanArgs(Args, 6, kd0, comp);
  kd := kd0;
  if FArm and (kd < n) then
  begin
    for i := 0 to kd - 1 do
    begin
      if Args[i]^.Kind = ekMethPtr then
      begin
        EmitExpr(Args[i]);
        off := ScratchT(16, Args[i]^.Typ);
        StFP('x0', off);
        StFP('x2', off + 8);
        AddImmArmT('x0', 'x29', off, 'x0');
      end
      else if Args[i]^.Kind = ekAddr then
        EmitExpr(Args[i])
      else if IsFat(Args[i]^.Typ) then
      begin
        if Args[i]^.Kind = ekStr then
          LeaS(InternStrFat(Args[i]^.Txt), 'x0')
        else if (Args[i]^.Kind = ekVar) or (Args[i]^.Kind = ekField) or
          (Args[i]^.Kind = ekIndex) or (Args[i]^.Kind = ekDeref) then
          EmitAddr(Args[i])
        else
        begin
          EmitExpr(Args[i]);
          if IsDyn(Args[i]^.Typ) then
            off := ScratchT(24, Args[i]^.Typ)
          else
            off := ScratchT(16, Args[i]^.Typ);
          StFP('x0', off);
          StFP('x2', off + 8);
          if IsDyn(Args[i]^.Typ) then
            StFP('x3', off + 16);
          AddImmArmT('x0', 'x29', off, 'x0');
        end;
      end
      else if IsBlob(Args[i]^.Typ) then
      begin
        if (Args[i]^.Kind = ekVar) or (Args[i]^.Kind = ekField) or
          (Args[i]^.Kind = ekIndex) or (Args[i]^.Kind = ekDeref) then
          EmitAddr(Args[i])
        else
          EmitExpr(Args[i]);
      end
      else
        EmitExpr(Args[i]);
      PshK('x0', ACls(Args[i]));
    end;
    PutArgs(Args, kd, comp, 0);
    for i := 0 to kd - 1 do
      Line('  ldr ' + ArgR(LongInt(i)) + ', [sp, #' + IntToStr((kd - 1 - i) * 16) + ']');
    if kd > 0 then
    begin
      SpAdjArm('add', kd * 16);
    end;
    EmitLink(ProcNest(Name));
    Line('  bl ' + Name);
    Exit;
  end;
  if FArm then
  begin
    for i := 0 to n - 1 do
    begin
      if Args[i]^.Kind = ekMethPtr then
      begin
        EmitExpr(Args[i]);
        off := ScratchT(16, Args[i]^.Typ);
        StFP('x0', off);
        StFP('x2', off + 8);
        AddImmArmT('x0', 'x29', off, 'x0');
      end
      else if Args[i]^.Kind = ekAddr then
        EmitExpr(Args[i])
      else if IsFat(Args[i]^.Typ) then
      begin
        if Args[i]^.Kind = ekStr then
          LeaS(InternStrFat(Args[i]^.Txt), 'x0')
        else if (Args[i]^.Kind = ekVar) or (Args[i]^.Kind = ekField) or
          (Args[i]^.Kind = ekIndex) or (Args[i]^.Kind = ekDeref) then
          EmitAddr(Args[i])
        else
        begin
          EmitExpr(Args[i]);
          if IsDyn(Args[i]^.Typ) then
            off := ScratchT(24, Args[i]^.Typ)
          else
            off := ScratchT(16, Args[i]^.Typ);
          StFP('x0', off);
          StFP('x2', off + 8);
          if IsDyn(Args[i]^.Typ) then
            StFP('x3', off + 16);
          AddImmArmT('x0', 'x29', off, 'x0');
        end;
      end
      else if IsBlob(Args[i]^.Typ) then
      begin
        { A record value is already an address (P80). }
        if (Args[i]^.Kind = ekVar) or (Args[i]^.Kind = ekField) or
          (Args[i]^.Kind = ekIndex) or (Args[i]^.Kind = ekDeref) then
          EmitAddr(Args[i])
        else
          EmitExpr(Args[i]);
      end
      else
        EmitExpr(Args[i]);
      { an address passed for a var parameter is a pointer, into the
        stack or not, whatever it points to (1.1.1: VCls of the
        pointee said no, and a seventh argument's address stayed
        behind when the stack moved) }
      PshK('x0', ACls(Args[i]));
    end;
    if n > 8 then
      nreg := 8
    else
      nreg := n;
    for i := 0 to nreg - 1 do
      Line('  ldr ' + ArgR(LongInt(i)) + ', [sp, #' +
        IntToStr((n - 1 - i) * 16) + ']');
    if n > nreg then
    begin
      off := ((n - nreg) * 8 + 15) and (-16);
      { the classes of the arguments as pushed, argument 0 first, each
        the low word of its pair (1.1.1: see ShiftArgs) }
      kinds := nil;
      SetLength(kinds, n);
      top := Length(FPushK) - 2 * n;
      for i := 0 to n - 1 do
        if (top + 2 * i + 1 >= 0) and (top + 2 * i + 1 < Length(FPushK)) then
          kinds[i] := FPushK[top + 2 * i + 1]
        else
          kinds[i] := 2;
      for i := 0 to n - nreg - 1 do
      begin
        Line('  ldr x16, [sp, #' + IntToStr((n - nreg - 1 - i) * 16) + ']');
        Line('  str x16, [sp, #' + IntToStr(n * 16 - off + i * 8) + ']');
      end;
      SpAdjArm('add', n * 16 - off);
      { the off div 8 words left: argument nreg first, a pad word last }
      if FMapOn or FMapPro then
      begin
        MapPop(off div 8);
        SetLength(FPushHint, off div 8);
        for i := 0 to off div 8 - 1 do
          if i < n - nreg then
            FPushHint[i] := kinds[nreg + i]
          else
            FPushHint[i] := 0;
        MapPush(off div 8, False);
      end;
    end
    else if n > 0 then
    begin
      SpAdjArm('add', n * 16);
    end;
    EmitLink(ProcNest(Name));
    Line('  bl ' + Name);
    if n > nreg then
    begin
      off := ((n - nreg) * 8 + 15) and (-16);
      SpAdjArm('add', off);
    end;
    Exit;
  end;
  for i := 0 to kd - 1 do
  begin
    if Args[i]^.Kind = ekMethPtr then
    begin
      EmitExpr(Args[i]);
      off := ScratchT(16, Args[i]^.Typ);
      Line('  movq %rax, ' + IntToStr(off) + '(%rbp)');
      Line('  movq %rdx, ' + IntToStr(off + 8) + '(%rbp)');
      Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
    end
    else if Args[i]^.Kind = ekAddr then
      EmitExpr(Args[i])
    else if IsBlob(Args[i]^.Typ) then
    begin
      { A record travels by address. A variable, a field, an element or
        what a pointer points at has one; anything else is a value, and
        a record value is already an address (a function that returns a
        record returns a pointer to a copy of it), so it is passed as
        it stands. Spilling it like a fat value passed the address of
        the pointer and the callee read the pointer as its first field
        (P80). }
      if (Args[i]^.Kind = ekVar) or (Args[i]^.Kind = ekField) or
        (Args[i]^.Kind = ekIndex) or (Args[i]^.Kind = ekDeref) then
        EmitAddr(Args[i])
      else
        EmitExpr(Args[i]);
    end
    else if IsFat(Args[i]^.Typ) then
    begin
      if Args[i]^.Kind = ekStr then
        Line('  leaq ' + InternStrFat(Args[i]^.Txt) + '(%rip), %rax')
      else if (Args[i]^.Kind = ekVar) or (Args[i]^.Kind = ekField) or
        (Args[i]^.Kind = ekIndex) or (Args[i]^.Kind = ekDeref) then
        EmitAddr(Args[i])
      else
      begin
        EmitExpr(Args[i]);
        if IsDyn(Args[i]^.Typ) then
          off := ScratchT(24, Args[i]^.Typ)
        else
          off := ScratchT(16, Args[i]^.Typ);
        Line('  movq %rax, ' + IntToStr(off) + '(%rbp)');
        Line('  movq %rdx, ' + IntToStr(off + 8) + '(%rbp)');
        if IsDyn(Args[i]^.Typ) then
          Line('  movq %r8, ' + IntToStr(off + 16) + '(%rbp)');
        Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
      end;
    end
    else
      EmitExpr(Args[i]);
    PushK('rax', ACls(Args[i]));
  end;
  if kd < n then
  begin
    { the direct ones first, then the worked-out ones from the stack
      into the registers before them }
    PutArgs(Args, kd, comp, 0);
    ShiftArgs(kd, kd, 0);
    EmitLink(ProcNest(Name));
    Line('  call ' + Name);
    Exit;
  end;
  if n > 6 then
    nreg := 6
  else
    nreg := n;
  ShiftArgs(n, nreg, 0);
  EmitLink(ProcNest(Name));
  Line('  call ' + Name);
  if n > nreg then
    Line('  addq $' + IntToStr((n - nreg) * 8) + ', %rsp');
end;

{ P297: the two words of a routine value, a method value or an
  interface (code and environment, code and Self, object and table)
  from where E lies into R0 and R1, as Go loads a closure's code from
  the closure where it is (cmd/compile/internal/ssagen/ssa.go: rawLoad of
  codeptr, then OpClosureLECall): a variable's from its home, an
  element's, a field's or a pointer's target's from its address, on
  arm64 in one ldp (ARM DDI 0487 M.c C6.2.214, signed offset: no
  writeback, so the base may be one of the two, K1.2.17.7; Neoverse N1
  SOG 3.9 table 14: an X-form pair 4 cycles, as one ldr, one
  instruction for two); anything else worked out into rax and rdx, or
  x0 and x2, and moved. }
{ amd64 (P329): the last line written is '  leaq OP, %rax', B where it
  begins (the newline before it); OP an operand AddDispOp moves, from a
  register or none ('(%' or '(,%' after the displacement): an element's,
  a field's, a frame variable's or a label's. Not in an asm text or a
  failure out of line. }
function TEmitter.LastLeaRax(out B: SizeInt; out Op: string): Boolean;
var
  e, p: SizeInt;
  t, r, rest: string;
begin
  Result := False;
  B := 0;
  Op := '';
  if FArm or FAsmText or (FColdAt >= 0) or (FLen < 2) or (FOut[FLen] <> Char(10)) then
    Exit;
  e := FLen;
  B := e - 1;
  while (B > 0) and (FOut[B] <> Char(10)) do
    Dec(B);
  t := Copy(FOut, B + 1, e - B - 1);
  if (Copy(t, 1, 7) <> '  leaq ') or (Copy(t, Length(t) - 5, 6) <> ', %rax') then
    Exit;
  Op := Copy(t, 8, Length(t) - 7 - 6);
  p := Pos('(', Op);
  if (p = 0) or (Pos(' ', Op) > 0) then
    Exit;
  rest := Copy(Op, p, Length(Op) - p + 1);
  Result := ((Copy(rest, 1, 2) = '(%') or (Copy(rest, 1, 3) = '(,%')) and AddDispOp(Op, 16, r);
end;

{ amd64, right after EmitAddr (P329): the operand the address came from,
  the lea of LastLeaRax taken out of the text when OP names none of the
  registers in Keep (names joined by commas): the loads and stores that
  follow read OP and OpPlus(OP, 8) themselves, one instruction fewer, as
  Go 1.27 reads a frame array's element by MOVQ main.loc+24(SP)(AX*8),
  DX and a string of a global array by MOVQ (CX)(AX*1), DX and MOVQ
  8(CX)(AX*1), BX after the array's LEAQ; '(%rax)' else. rax
  keeps what it held before: the trackers that saw the lea write it
  hold nothing of it (IxNote, the kept checks) and the last instruction
  is forgotten (ForwardLoad). }
function TEmitter.AddrOp(const Keep: string): string;
var
  b, p: SizeInt;
  op, k, r: string;
begin
  Result := '(%rax)';
  if not LastLeaRax(b, op) then
    Exit;
  k := Keep;
  while k <> '' do
  begin
    p := Pos(',', k);
    if p = 0 then
    begin
      r := k;
      k := '';
    end
    else
    begin
      r := Copy(k, 1, p - 1);
      k := Copy(k, p + 1, Length(k) - p);
    end;
    if (r <> '') and (Pos('%' + r, op) > 0) then
      Exit;
  end;
  FLen := b;
  FLastIns := '';
  Result := op;
end;

{ The operand K bytes past Op (P329), which LastLeaRax saw AddDispOp
  move by 16. }
function TEmitter.OpPlus(const Op: string; K: LongInt): string;
begin
  if not AddDispOp(Op, K, Result) then
    Die('internal error: no operand ' + IntToStr(K) + ' past ' + Op);
end;

{ amd64 (P329): rax := rax + K in the displacement of the lea of
  LastLeaRax, a field's offset or a constant index's, K within 2^30 as
  EmitWordMem's (near): one lea where the lea and an add were two, and
  AddrOp takes it after. False, nothing written, else. }
function TEmitter.LeaPlus(K: Int64): Boolean;
var
  b: SizeInt;
  op, r: string;
begin
  Result := False;
  if (K < -(Int64(1) shl 30)) or (K > Int64(1) shl 30) or (not LastLeaRax(b, op)) or
    (not AddDispOp(op, K, r)) then
    Exit;
  ReplaceLine(b + 1, FLen - b - 1, '  leaq ' + r + ', %rax');
  FLastIns := '';
  Result := True;
end;

{ arm64 (P329): the last line written is '  add x0, B, #K' or
  '  sub x0, B, #K', K 0 to 4095 unshifted and B a register or sp; Pt
  where it begins (the newline before it) and V the constant, K or -K.
  Not in an asm text or a failure out of line. }
function TEmitter.LastAddX0(out Pt: SizeInt; out B: string; out V: Int64): Boolean;
var
  e, q, i: SizeInt;
  t, ks: string;
  neg: Boolean;
begin
  Result := False;
  Pt := 0;
  B := '';
  V := 0;
  if (not FArm) or FAsmText or (FColdAt >= 0) or (FLen < 2) or (FOut[FLen] <> Char(10)) then
    Exit;
  e := FLen;
  Pt := e - 1;
  while (Pt > 0) and (FOut[Pt] <> Char(10)) do
    Dec(Pt);
  t := Copy(FOut, Pt + 1, e - Pt - 1);
  if Copy(t, 1, 10) = '  add x0, ' then
    neg := False
  else if Copy(t, 1, 10) = '  sub x0, ' then
    neg := True
  else
    Exit;
  q := Pos(', #', t);
  if q <= 11 then
    Exit;
  B := Copy(t, 11, q - 11);
  ks := Copy(t, q + 3, Length(t) - q - 2);
  if (ks = '') or (Length(ks) > 4) or ((B <> 'sp') and ((Length(B) < 2) or (B[1] <> 'x'))) then
    Exit;
  for i := 2 to Length(B) do
    if (B[i] < '0') or (B[i] > '9') then
      Exit;
  for i := 1 to Length(ks) do
    if (ks[i] < '0') or (ks[i] > '9') then
      Exit
    else
      V := V * 10 + (Ord(ks[i]) - Ord('0'));
  if neg then
    V := -V;
  Result := True;
end;

{ arm64 (P329): x0 := x0 + K in the add or sub of LastAddX0 when the sum
  is one's immediate (ArmAddImm): a field's offset or a constant index's
  with the frame's or the field's before it, one instruction where two
  were. False, nothing written, else. }
function TEmitter.ArmAddPlus(K: Int64): Boolean;
var
  pt: SizeInt;
  b, t: string;
  v: Int64;
begin
  Result := False;
  if (K < -(Int64(1) shl 30)) or (K > Int64(1) shl 30) or (not LastAddX0(pt, b, v)) then
    Exit;
  v := v + K;
  if (v >= 0) and (ArmAddImm(v) <> '') then
    t := '  add x0, ' + b + ', ' + ArmAddImm(v)
  else if (v < 0) and (ArmAddImm(-v) <> '') then
    t := '  sub x0, ' + b + ', ' + ArmAddImm(-v)
  else
    Exit;
  ReplaceLine(pt + 1, FLen - pt - 1, t);
  FLastIns := '';
  Result := True;
end;

{ arm64, right after EmitAddr (P329): the base B and offset V of an
  operand of N words, two or three, the add or sub of LastAddX0 taken
  out of the text when an ldp's or stp's offset takes V (a multiple of 8
  from -512 to 504: ARM DDI 0487 M.c C6.2.214 LDP and C6.2.414 STP, the
  signed offset form, imm7 scaled by 8) and a third word's ldr V + 16
  (LDUR's -256 to 255, C6.2.259, or LDR's positive multiple, C6.2.216),
  loaded into x3 first, so not from x3; x0 and 0 else. x0 keeps what it
  held before: the trackers that saw the add write it hold nothing of
  it. }
procedure TEmitter.ArmPairAt(N: LongInt; out B: string; out V: Int64);
var
  pt: SizeInt;
  b0: string;
  v0: Int64;
begin
  B := 'x0';
  V := 0;
  if not LastAddX0(pt, b0, v0) then
    Exit;
  if (v0 mod 8 <> 0) or (v0 < -512) or (v0 > 504) or
    ((N > 2) and ((v0 + 16 < -256) or (b0 = 'x3'))) then
    Exit;
  FLen := pt;
  FLastIns := '';
  B := b0;
  V := v0;
end;

{ The operand [B, #V], [B] for V of 0 (P329). }
function TEmitter.ArmMem(const B: string; V: Int64): string;
begin
  if V = 0 then
    Result := '[' + B + ']'
  else
    Result := '[' + B + ', #' + IntToStr(V) + ']';
end;

procedure TEmitter.ValPair(E: PExpr; const R0, R1: string);
var
  sy: TSym;
  home: Boolean;
  op, ab: string;
  av: Int64;
begin
  home := False;
  if E^.Kind = ekVar then
  begin
    sy := FindSym(E^.Name);
    home := (sy.Name <> '') and (sy.Reg = '') and (not sy.ByRef) and (sy.Up = 0) and
      (not sy.Boxed) and (TSize(sy.Typ) = 16);
  end;
  if FArm then
  begin
    if home and sy.Global then
    begin
      LeaS(VarLabel(sy.Name), 'x16');
      Line('  ldp ' + R0 + ', ' + R1 + ', [x16]');
    end
    else if home and (sy.Off >= -512) and (sy.Off <= 496) and (sy.Off mod 8 = 0) then
      Line('  ldp ' + R0 + ', ' + R1 + ', [x29, #' + IntToStr(sy.Off) + ']')
    else if home then
    begin
      AddFP('x16', sy.Off);
      Line('  ldp ' + R0 + ', ' + R1 + ', [x16]');
    end
    else if (E^.Kind = ekIndex) or (E^.Kind = ekField) or (E^.Kind = ekDeref) then
    begin
      EmitAddr(E);
      { from the element's base and offset (P329) }
      ArmPairAt(2, ab, av);
      Line('  ldp ' + R0 + ', ' + R1 + ', ' + ArmMem(ab, av));
    end
    else
    begin
      EmitExpr(E);
      if R1 = 'x0' then
      begin
        Line('  mov ' + R0 + ', x0');
        Line('  mov x0, x2');
      end
      else
      begin
        Line('  mov ' + R1 + ', x2');
        if R0 <> 'x0' then
          Line('  mov ' + R0 + ', x0');
      end;
    end;
    Exit;
  end;
  if home then
  begin
    Line('  movq ' + StrWordA(sy, 0) + ', %' + R0);
    Line('  movq ' + StrWordA(sy, 8) + ', %' + R1);
  end
  else if (E^.Kind = ekIndex) or (E^.Kind = ekField) or (E^.Kind = ekDeref) then
  begin
    EmitAddr(E);
    { from the element's operand (P329); the second word first, so the
      first may be a register the operand names }
    op := AddrOp(R1);
    Line('  movq ' + OpPlus(op, 8) + ', %' + R1);
    Line('  movq ' + op + ', %' + R0);
  end
  else
  begin
    EmitExpr(E);
    Line('  movq %rdx, %' + R1);
    Line('  movq %rax, %' + R0);
  end;
end;

{ P297: the arguments of a call PlanArgs sends straight to their
  registers (Kd 0), the one worked out first in the pool's first three,
  rsi, rdi and r8, as inside a region (PoolSize), while r11 and r10 keep
  the call's code and its second word; x8 and x27 on arm64 are no
  pool's. }
procedure TEmitter.PutArgsKept(const Args: TExprArray; Comp, Reg0: LongInt);
var
  was: LongInt;
begin
  was := FPoolCap;
  if not FArm then
    FPoolCap := 3;
  PutArgs(Args, 0, Comp, Reg0);
  FPoolCap := was;
end;

{ A call through a routine value (P81): the address is worked out
  first and kept under the arguments, and the call is indirect. Every
  argument goes the way EmitArgVal passes it, so a string or a record
  travels as it does anywhere else. There is no room here for arguments
  beyond the registers, so more than six (amd64) or eight (arm64) is
  refused rather than passed wrongly. }
procedure TEmitter.EmitCallVal(Target: PExpr; const Args: TExprArray);
var
  i, n, kd, comp: LongInt;
begin
  n := Length(Args);
  if FArm then
  begin
    if n > 8 then
      Die('at most 8 arguments through a routine value');
    { the arguments that call nothing straight to their registers (P281) }
    PlanArgs(Args, 8, kd, comp);
    if kd = 0 then
    begin
      { P297: the code and the environment from their place into x8 and
        x27, which no argument's code touches, then the arguments: Go's
        closure call (ssagen/ssa.go OpClosureLECall, the context in R26,
        cmd/compile/abi-internal.md) }
      ValPair(Target, 'x8', 'x27');
      PutArgsKept(Args, comp, 0);
      Line('  blr x8');
      Exit;
    end;
    { the code and the environment, which goes in the static link's
      register: a closure reads it as its link (1.0.133) }
    EmitExpr(Target);
    PshK('x2', 1);
    PshK('x0', 0);
    for i := 0 to kd - 1 do
    begin
      EmitArgVal(Args[i]);
      PshK('x0', ACls(Args[i]));
    end;
    PutArgs(Args, kd, comp, 0);
    Line('  ldr x9, [sp, #' + IntToStr(kd * 16) + ']');
    Line('  ldr x27, [sp, #' + IntToStr((kd + 1) * 16) + ']');
    for i := 0 to kd - 1 do
      Line('  ldr ' + ArgR(i) + ', [sp, #' + IntToStr((kd - 1 - i) * 16) + ']');
    SpAdjArm('add', (kd + 2) * 16);
    Line('  blr x9');
  end
  else
  begin
    if n > 6 then
      Die('at most 6 arguments through a routine value');
    { the arguments that call nothing straight to their registers (P281) }
    PlanArgs(Args, 6, kd, comp);
    if kd = 0 then
    begin
      { P297: the code and the environment from their place into r11 and
        r10, the arguments after them in the other registers; Go's DX is
        paslang's r10, the static link (cmd/compile/abi-internal.md) }
      ValPair(Target, 'r11', 'r10');
      PutArgsKept(Args, comp, 0);
      Line('  call *%r11');
      Exit;
    end;
    EmitExpr(Target);
    PushK('rdx', 1);
    PushK('rax', 0);
    for i := 0 to kd - 1 do
    begin
      EmitArgVal(Args[i]);
      PushK('rax', ACls(Args[i]));
    end;
    PutArgs(Args, kd, comp, 0);
    for i := 0 to kd - 1 do
      Line('  movq ' + IntToStr((kd - 1 - i) * 8) + '(%rsp), %' + ArgReg(i));
    Line('  movq ' + IntToStr(kd * 8) + '(%rsp), %r11');
    Line('  movq ' + IntToStr((kd + 1) * 8) + '(%rsp), %r10');
    Line('  addq $' + IntToStr((kd + 2) * 8) + ', %rsp');
    Line('  call *%r11');
  end;
end;

{ One argument as EmitCall passes it, in rax (amd64) or x0 (arm64): a fat
  or blob value goes by address, a string literal by its descriptor, a
  computed fat value through a scratch slot. Constructor calls use it. }
procedure TEmitter.EmitArgVal(E: PExpr);
var
  off: LongInt;
begin
  if E^.Kind = ekAddr then
  begin
    EmitExpr(E);
    Exit;
  end;
  if IsFat(E^.Typ) then
  begin
    if E^.Kind = ekStr then
    begin
      if FArm then
        LeaS(InternStrFat(E^.Txt), 'x0')
      else
        Line('  leaq ' + InternStrFat(E^.Txt) + '(%rip), %rax');
    end
    else if (E^.Kind = ekVar) or (E^.Kind = ekField) or
      (E^.Kind = ekIndex) or (E^.Kind = ekDeref) then
      EmitAddr(E)
    else
    begin
      EmitExpr(E);
      if IsDyn(E^.Typ) then
        off := ScratchT(24, E^.Typ)
      else
        off := ScratchT(16, E^.Typ);
      if FArm then
      begin
        StFP('x0', off);
        StFP('x2', off + 8);
        if IsDyn(E^.Typ) then
          StFP('x3', off + 16);
        AddImmArmT('x0', 'x29', off, 'x0');
      end
      else
      begin
        Line('  movq %rax, ' + IntToStr(off) + '(%rbp)');
        Line('  movq %rdx, ' + IntToStr(off + 8) + '(%rbp)');
        if IsDyn(E^.Typ) then
          Line('  movq %r8, ' + IntToStr(off + 16) + '(%rbp)');
        Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
      end;
    end;
  end
  else if IsBlob(E^.Typ) then
  begin
    { A record value is already an address (P80): only a place has one
      to take. }
    if (E^.Kind = ekVar) or (E^.Kind = ekField) or (E^.Kind = ekIndex) or
      (E^.Kind = ekDeref) then
      EmitAddr(E)
    else
      EmitExpr(E);
  end
  else
    EmitExpr(E);
end;

{ A method's argument A into x0 on arm64, as every call passes one: a
  string or a record by its address, a method value through a scratch
  pair (P80, 1.0.133). }
procedure TEmitter.ArmArgX0(A: PExpr);
var
  off: LongInt;
begin
  if A^.Kind = ekMethPtr then
  begin
    EmitExpr(A);
    off := ScratchT(16, A^.Typ);
    StFP('x0', off);
    StFP('x2', off + 8);
    AddImmArmT('x0', 'x29', off, 'x0');
  end
  else if A^.Kind = ekAddr then
    EmitExpr(A)
  else if IsFat(A^.Typ) then
  begin
    if A^.Kind = ekStr then
      LeaS(InternStrFat(A^.Txt), 'x0')
    else if (A^.Kind = ekVar) or (A^.Kind = ekField) or (A^.Kind = ekIndex) or
      (A^.Kind = ekDeref) then
      EmitAddr(A)
    else
    begin
      EmitExpr(A);
      if IsDyn(A^.Typ) then
        off := ScratchT(24, A^.Typ)
      else
        off := ScratchT(16, A^.Typ);
      StFP('x0', off);
      StFP('x2', off + 8);
      if IsDyn(A^.Typ) then
        StFP('x3', off + 16);
      AddImmArmT('x0', 'x29', off, 'x0');
    end;
  end
  else if IsBlob(A^.Typ) then
  begin
    { A record value is already an address (P80). }
    if (A^.Kind = ekVar) or (A^.Kind = ekField) or (A^.Kind = ekIndex) or
      (A^.Kind = ekDeref) then
      EmitAddr(A)
    else
      EmitExpr(A);
  end
  else
    EmitExpr(A);
end;

procedure TEmitter.EmitArmMeth(Obj: PExpr; const Args: TExprArray;
  Slot: LongInt; const Name: string);
var
  i, nuser, ntot, npush, nreg, ns, off, src, kd, comp: LongInt;
  direct: Boolean;
begin
  if (Slot < 0) and (Slot <> -3) and (Name = '') then
  begin
    Line('  mov x0, xzr');
    Exit;
  end;
  nuser := Length(Args);
  if nuser > 32 then
    Die('at most 32 arguments');
  { the arguments after the last one that calls or moves anything
    straight to their registers, Self too when it is a class variable
    and nothing else is pushed (P281) }
  direct := False;
  kd := nuser;
  comp := -1;
  if (Slot <> -3) and (nuser < 8) then
  begin
    PlanArgs(Args, 7, kd, comp);
    if (kd = 0) and (Obj^.Kind = ekVar) and (TKind(Obj^.Typ) = tykClass) and
      DirectArg(Obj, 'x0', False) then
    begin
      PutArgs(Args, 0, comp, 1);
      DirectArg(Obj, 'x0', True);
      direct := True;
    end
    else if kd = 0 then
    begin
      { P297: Self worked out first stays in x0, or in x27 while an
        argument is worked out, nothing pushed }
      EmitExpr(Obj);
      if comp >= 0 then
      begin
        Line('  mov x27, x0');
        PutArgs(Args, 0, comp, 1);
        Line('  mov x0, x27');
      end
      else
        PutArgs(Args, 0, -1, 1);
      direct := True;
    end
    else if kd < nuser then
    begin
      EmitExpr(Obj);
      PshK('x0', VCls(Obj^.Typ, 0));
      for i := 0 to kd - 1 do
      begin
        ArmArgX0(Args[i]);
        PshK('x0', VCls(Args[i]^.Typ, 0));
      end;
      PutArgs(Args, kd, comp, 1);
      for i := 0 to kd - 1 do
        Line('  ldr ' + ArgR(1 + i) + ', [sp, #' + IntToStr((kd - 1 - i) * 16) + ']');
      Line('  ldr x0, [sp, #' + IntToStr(kd * 16) + ']');
      SpAdjArm('add', (kd + 1) * 16);
      direct := True;
    end;
  end;
  if direct then
  begin
    if Slot >= 0 then
    begin
      Line('  ldr x16, [x0]');
      LdSlotArm('x16', Slot * 8);
      Line('  blr x16');
    end
    else if Slot <= ClsSlotBase then
    begin
      LdSlotArm('x0', (ClsSlotBase - Slot) * 8);
      Line('  blr x16');
    end
    else
      Line('  bl ' + Name);
    Exit;
  end;
  if (Slot = -3) and (not FObjReady) and (nuser < 8) then
  begin
    { P297: a method value's code into x8 and Self into x0 from their
      place, Self through x27 while an argument is worked out first }
    PlanArgs(Args, 7, kd, comp);
    if kd = 0 then
    begin
      if comp < 0 then
        ValPair(Obj, 'x8', 'x0')
      else
        ValPair(Obj, 'x8', 'x27');
      PutArgs(Args, 0, comp, 1);
      if comp >= 0 then
        Line('  mov x0, x27');
      Line('  blr x8');
      Exit;
    end;
  end;
  if Slot = -3 then
  begin
    { an interface's call has its code in x0 and Self in x2 already }
    if FObjReady then
    begin
      FObjReady := False;
      PshK('x0', 0);
    end
    else
    begin
      EmitExpr(Obj);
      PshK('x0', VCls(Obj^.Typ, 0));
    end;
    Line('  mov x0, x2');
    PshK('x0', 1);
    npush := nuser + 2;
  end
  else
  begin
    EmitExpr(Obj);
    PshK('x0', VCls(Obj^.Typ, 0));
    npush := nuser + 1;
  end;
  for i := 0 to nuser - 1 do
  begin
    ArmArgX0(Args[i]);
    PshK('x0', VCls(Args[i]^.Typ, 0));
  end;
  ntot := nuser + 1;
  if ntot > 8 then
    nreg := 8
  else
    nreg := ntot;
  if Slot = -3 then
    Line('  ldr x9, [sp, #' + IntToStr((nuser + 1) * 16) + ']');
  for i := 0 to nreg - 1 do
    Line('  ldr ' + ArgR(i) + ', [sp, #' + IntToStr((nuser - i) * 16) + ']');
  if ntot > 8 then
  begin
    ns := ntot - 8;
    off := (ns * 8 + 15) and (-16);
    for i := 0 to ns - 1 do
    begin
      src := (ns - 1 - i) * 16;
      Line('  ldr x16, [sp, #' + IntToStr(src) + ']');
      Line('  str x16, [sp, #' + IntToStr(npush * 16 - off + i * 8) + ']');
    end;
    SpAdjArm('add', npush * 16 - off);
  end
  else
  begin
    SpAdjArm('add', npush * 16);
  end;
  if Slot = -3 then
    Line('  blr x9')
  else if Slot >= 0 then
  begin
    Line('  ldr x16, [x0]');
    LdSlotArm('x16', Slot * 8);
    Line('  blr x16');
  end
  else if Slot <= ClsSlotBase then
  begin
    { a class method's virtual call (P123): x0, Self, is the table }
    LdSlotArm('x0', (ClsSlotBase - Slot) * 8);
    Line('  blr x16');
  end
  else
    Line('  bl ' + Name);
  if ntot > 8 then
  begin
    SpAdjArm('add', off);
  end;
end;

{ A call through a method value, code and Self (amd64): a statement's
  and, since 1.0.135, an expression's, which gave 0 (a function of
  object did not exist). }
procedure TEmitter.EmitMethVal(Target: PExpr; const Args: TExprArray);
var
  i, n, nreg, kd, comp: LongInt;
begin
  n := Length(Args);
  { the arguments that call nothing straight to their registers (P281) }
  PlanArgs(Args, 5, kd, comp);
  if kd = 0 then
  begin
    { P297: the code into r11 and Self into rdi from their place, Self
      through r10 when an argument is worked out in the pool first }
    if comp < 0 then
      ValPair(Target, 'r11', 'rdi')
    else
    begin
      ValPair(Target, 'r11', 'r10');
      PutArgsKept(Args, comp, 1);
      Line('  movq %r10, %rdi');
      Line('  call *%r11');
      Exit;
    end;
    PutArgs(Args, 0, -1, 1);
    Line('  call *%r11');
    Exit;
  end;
  EmitExpr(Target);
  PushK('rax', 0);
  PushK('rdx', 1);
  for i := 0 to kd - 1 do
  begin
    { a string or a record goes by address, as in every other call
      (1.0.133): its first word went, and the callee read its length
      from what came next }
    EmitArgVal(Args[i]);
    PushK('rax', ACls(Args[i]));
  end;
  if kd < n then
  begin
    PutArgs(Args, kd, comp, 1);
    ShiftArgs(kd, kd, 1);
    Line('  popq %rdi');
    Line('  popq %rax');
    Line('  call *%rax');
    Exit;
  end;
  if n > 5 then
    nreg := 5
  else
    nreg := n;
  ShiftArgs(n, nreg, 1);
  if n > nreg then
  begin
    Line('  movq ' + IntToStr((n - nreg) * 8) + '(%rsp), %rdi');
    Line('  movq ' + IntToStr((n - nreg + 1) * 8) + '(%rsp), %rax');
    Line('  call *%rax');
    Line('  addq $' + IntToStr((n - nreg + 2) * 8) + ', %rsp');
  end
  else
  begin
    Line('  popq %rdi');
    Line('  popq %rax');
    Line('  call *%rax');
  end;
end;

procedure TEmitter.EmitIfaceCall(Obj: PExpr; const Args: TExprArray;
  Slot: LongInt);
var
  i, n, nreg, kd, comp: LongInt;
begin
  { The code from the interface's table and the object as Self, then a
    call as through a method value (1.0.135): every argument by the rules
    of every other call, a string or a record by address, more than five
    on the stack. It took one word an argument, so a string lost its
    length and what followed moved, and at most five. }
  n := Length(Args);
  if n < 8 then
  begin
    if FArm then
      PlanArgs(Args, 7, kd, comp)
    else
      PlanArgs(Args, 5, kd, comp);
    if (kd = 0) and ((not FArm) or (Slot * 8 <= 32760)) then
    begin
      { P297: the object and the table from their place, the code from
        the table into r11 or x8, Self into the first register, through
        r10 or x27 when an argument is worked out first; Go loads the
        itab's word and calls it (ssagen/ssa.go, OCALLINTER: codeptr from
        the closure getClosureAndRcvr gives) }
      if FArm then
      begin
        if comp < 0 then
          ValPair(Obj, 'x0', 'x8')
        else
          ValPair(Obj, 'x27', 'x8');
        Line('  ldr x8, [x8, #' + IntToStr(Slot * 8) + ']');
        PutArgs(Args, 0, comp, 1);
        if comp >= 0 then
          Line('  mov x0, x27');
        Line('  blr x8');
        Exit;
      end;
      if comp < 0 then
      begin
        ValPair(Obj, 'rdi', 'r11');
        Line('  movq ' + IntToStr(Slot * 8) + '(%r11), %r11');
        PutArgs(Args, 0, -1, 1);
      end
      else
      begin
        ValPair(Obj, 'r10', 'r11');
        Line('  movq ' + IntToStr(Slot * 8) + '(%r11), %r11');
        PutArgsKept(Args, comp, 1);
        Line('  movq %r10, %rdi');
      end;
      Line('  call *%r11');
      Exit;
    end;
  end;
  EmitExpr(Obj);
  if FArm then
  begin
    LdSlotArm('x2', Slot * 8);
    Line('  mov x2, x0');
    Line('  mov x0, x16');
    FObjReady := True;
    EmitArmMeth(Obj, Args, -3, '');
    Exit;
  end;
  Line('  movq ' + IntToStr(Slot * 8) + '(%rdx), %rcx');
  PushK('rcx', 0);
  PushK('rax', 1);
  { the arguments that call nothing straight to their registers (P281) }
  PlanArgs(Args, 5, kd, comp);
  for i := 0 to kd - 1 do
  begin
    EmitArgVal(Args[i]);
    PushK('rax', ACls(Args[i]));
  end;
  if kd < n then
  begin
    PutArgs(Args, kd, comp, 1);
    ShiftArgs(kd, kd, 1);
    Line('  popq %rdi');
    Line('  popq %rax');
    Line('  call *%rax');
    Exit;
  end;
  if n > 5 then
    nreg := 5
  else
    nreg := n;
  ShiftArgs(n, nreg, 1);
  if n > nreg then
  begin
    Line('  movq ' + IntToStr((n - nreg) * 8) + '(%rsp), %rdi');
    Line('  movq ' + IntToStr((n - nreg + 1) * 8) + '(%rsp), %rax');
    Line('  call *%rax');
    Line('  addq $' + IntToStr((n - nreg + 2) * 8) + ', %rsp');
  end
  else
  begin
    Line('  popq %rdi');
    Line('  popq %rax');
    Line('  call *%rax');
  end;
end;

{ Class Cls's table for interface Iface, one it or an ancestor lists:
  the parser refused the others (P140). A parent of a listed interface
  has no table of its own, as in Free Pascal. An interface two units'
  .pi both carry is two types with one stem here, as its table's symbol
  has (1.0.137; the stem, P154, is the unit's and the name, so two
  interfaces of one name from two units are two). }
function TEmitter.IfaceTab(Cls, Iface: LongInt): string;
var
  i: LongInt;
  ok: Boolean;
begin
  ok := False;
  if (Cls >= 0) and (Cls <= High(FTypes)) then
    for i := 0 to High(FTypes[Cls].Ifaces) do
      if (FTypes[Cls].Ifaces[i] = Iface) or
        (TypeStemOf(FTypes[FTypes[Cls].Ifaces[i]]) = TypeStemOf(FTypes[Iface])) then
        ok := True;
  if not ok then
    Die('class does not implement interface');
  Result := 'ivmt_' + TypeStemOf(FTypes[Cls]) + '_' + TypeStemOf(FTypes[Iface]);
end;

procedure TEmitter.EmitIfaceBind(Src, Dest: PExpr);
var
  tab: string;
begin
  tab := IfaceTab(Src^.Typ, Dest^.Typ);
  EmitExpr(Src);
  if FArm then
    LeaS(tab, 'x2')
  else
    Line('  leaq ' + tab + '(%rip), %rdx');
  StoreTo(Dest);
end;

procedure TEmitter.LookupMeth(ClassId: LongInt; const Meth: string;
  out Sym: string; out Slot: LongInt);
var
  i: SizeInt;
begin
  Sym := '';
  Slot := -1;
  if (ClassId < 0) or (ClassId > High(FTypes)) then
    Die('accessor');
  for i := 0 to High(FTypes[ClassId].Meths) do
    if ToLower(FTypes[ClassId].Meths[i].Name) = ToLower(Meth) then
    begin
      Sym := FTypes[ClassId].Meths[i].Sym;
      Slot := FTypes[ClassId].Meths[i].Slot;
      Exit;
    end;
  Die('unknown accessor ' + Meth);
end;

procedure TEmitter.ShiftArgs(N, NReg, Reg0: LongInt);
var
  i, ns: LongInt;
  kinds: array of Byte;
  top: SizeInt;
begin
  { User args are one qword each, last at (%rsp). Register args are copied
    into rdi.. (or rsi.. when Reg0=1, self stays underneath). Stack args are
    packed at (%rsp) in order. Slots under the N args are preserved; after
    this, the first of them sits at (N-NReg)*8(%rsp). }
  if NReg > N then
    NReg := N;
  if NReg < 0 then
    NReg := 0;
  ns := N - NReg;
  { The classes of the N words as pushed, argument 0 first (1.1.1): the
    words that stay on the stack across the call are the last ns
    arguments, and the map must say so; Line's own count, which pops N
    words after pushing ns nobody knows, left them the classes of the
    first ns arguments, so an address into the stack passed as the
    seventh argument was not moved with the stack (the tree's InsertSep,
    found by tree2 under PASLANG_GCVERIFY). }
  kinds := nil;
  SetLength(kinds, N);
  top := Length(FPushK) - N;
  for i := 0 to N - 1 do
    if (top + i >= 0) and (top + i < Length(FPushK)) then
      kinds[i] := FPushK[top + i]
    else
      kinds[i] := 2;
  for i := 0 to NReg - 1 do
    Line('  movq ' + IntToStr((N - 1 - i) * 8) + '(%rsp), %' +
      ArgReg(Reg0 + i));
  if ns = 0 then
  begin
    if NReg > 0 then
      Line('  addq $' + IntToStr(NReg * 8) + ', %rsp');
    Exit;
  end;
  Line('  subq $' + IntToStr(ns * 8) + ', %rsp');
  for i := 0 to ns - 1 do
  begin
    Line('  movq ' + IntToStr((2 * ns - 1 - i) * 8) + '(%rsp), %rax');
    Line('  movq %rax, ' + IntToStr(i * 8) + '(%rsp)');
  end;
  for i := 0 to ns - 1 do
  begin
    Line('  movq ' + IntToStr(i * 8) + '(%rsp), %rax');
    Line('  movq %rax, ' + IntToStr((N + i) * 8) + '(%rsp)');
  end;
  Line('  addq $' + IntToStr(N * 8) + ', %rsp');
  { the ns words left: argument NReg at (%rsp), then the next }
  if FMapOn or FMapPro then
  begin
    MapPop(ns);
    SetLength(FPushHint, ns);
    for i := 0 to ns - 1 do
      FPushHint[i] := kinds[NReg + i];
    MapPush(ns, False);
  end;
end;

function TEmitter.ProcNest(const Sym: string): LongInt;
var
  i: SizeInt;
begin
  Result := 0;
  for i := 0 to High(FProcSyms) do
    if FProcSyms[i] = Sym then
    begin
      Result := FProcNests[i];
      Exit;
    end;
end;

procedure TEmitter.EmitLink(CalleeNest: LongInt);
var
  i, hops: LongInt;
begin
  if CalleeNest <= 0 then
    Exit;
  if FArm then
  begin
    if (CalleeNest = FNest + 1) and (FBoxSlot <> 0) then
      LdFP('x27', FBoxSlot)
    else if CalleeNest = FNest + 1 then
      Line('  mov x27, x29')
    else
    begin
      LdFP('x27', -8);
      hops := FNest - CalleeNest;
      for i := 1 to hops do
        Line('  ldr x27, [x27, #-8]');
    end;
    Exit;
  end;
  if (CalleeNest = FNest + 1) and (FBoxSlot <> 0) then
    Line('  movq ' + IntToStr(FBoxSlot) + '(%rbp), %r10')
  else if CalleeNest = FNest + 1 then
    Line('  movq %rbp, %r10')
  else
  begin
    Line('  movq -8(%rbp), %r10');
    hops := FNest - CalleeNest;
    for i := 1 to hops do
      Line('  movq -8(%r10), %r10');
  end;
end;

function TEmitter.RealBin(E: PExpr): Boolean;
begin
  Result := False;
  if (E = nil) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  if E^.Bin = boSlash then
  begin
    Result := True;
    Exit;
  end;
  if (E^.Bin = boAdd) or (E^.Bin = boSub) or (E^.Bin = boMul) or
    (E^.Bin = boEq) or (E^.Bin = boNe) or (E^.Bin = boLt) or
    (E^.Bin = boLe) or (E^.Bin = boGt) or (E^.Bin = boGe) then
    if (TKind(E^.L^.Typ) = tykReal) or (TKind(E^.R^.Typ) = tykReal) or
      (TKind(E^.Typ) = tykReal) then
      Result := True;
end;

procedure TEmitter.EmitRealBin(E: PExpr);
var
  sgl, isCmp: Boolean;
  f: string;
begin
  isCmp := (E^.Bin = boEq) or (E^.Bin = boNe) or (E^.Bin = boLt) or
    (E^.Bin = boLe) or (E^.Bin = boGt) or (E^.Bin = boGe);
  { Single (P101): an operation typed Single, or a comparison with a
    Single and no Double, is worked out in binary32; else in binary64, a
    Single operand widening exactly. }
  if isCmp then
    sgl := ((E^.L^.Typ = TySingle) or (E^.R^.Typ = TySingle)) and
      (not ((TKind(E^.L^.Typ) = tykReal) and (E^.L^.Typ <> TySingle))) and
      (not ((TKind(E^.R^.Typ) = tykReal) and (E^.R^.Typ <> TySingle)))
  else
    sgl := E^.Typ = TySingle;
  if FArm then
  begin
    if sgl then
      f := 's'
    else
      f := 'd';
    EmitExpr(E^.L);
    PshK('x0', VCls(E^.L^.Typ, 0));
    EmitExpr(E^.R);
    RealInto(E^.R^.Typ, sgl, f + '1');
    Ppop('x0');
    RealInto(E^.L^.Typ, sgl, f + '0');
    if isCmp then
    begin
      Line('  fcmp ' + f + '0, ' + f + '1');
      if E^.Bin = boEq then
        Line('  cset x0, eq')
      else if E^.Bin = boNe then
        Line('  cset x0, ne')
      else if E^.Bin = boLt then
        Line('  cset x0, mi')
      else if E^.Bin = boLe then
        Line('  cset x0, ls')
      else if E^.Bin = boGt then
        Line('  cset x0, gt')
      else
        Line('  cset x0, ge');
      Exit;
    end;
    if E^.Bin = boAdd then
      Line('  fadd ' + f + '0, ' + f + '0, ' + f + '1')
    else if E^.Bin = boSub then
      Line('  fsub ' + f + '0, ' + f + '0, ' + f + '1')
    else if E^.Bin = boMul then
      Line('  fmul ' + f + '0, ' + f + '0, ' + f + '1')
    else
      Line('  fdiv ' + f + '0, ' + f + '0, ' + f + '1');
    if sgl then
      Line('  fmov w0, s0')
    else
      Line('  fmov x0, d0');
  end
  else
  begin
    if sgl then
      f := 'ss'
    else
      f := 'sd';
    EmitExpr(E^.L);
    PushK('rax', VCls(E^.L^.Typ, 0));
    EmitExpr(E^.R);
    RealInto(E^.R^.Typ, sgl, 'xmm1');
    Line('  popq %rax');
    RealInto(E^.L^.Typ, sgl, 'xmm0');
    if isCmp then
    begin
      Line('  ucomi' + f + ' %xmm1, %xmm0');
      Line('  movq $0, %rax');
      if E^.Bin = boGt then
        Line('  seta %al')
      else if E^.Bin = boGe then
        Line('  setae %al')
      else if E^.Bin = boEq then
      begin
        Line('  sete %al');
        Line('  setnp %cl');
        Line('  andb %cl, %al');
      end
      else if E^.Bin = boNe then
      begin
        Line('  setne %al');
        Line('  setp %cl');
        Line('  orb %cl, %al');
      end
      else if E^.Bin = boLt then
      begin
        Line('  setb %al');
        Line('  setnp %cl');
        Line('  andb %cl, %al');
      end
      else
      begin
        Line('  setbe %al');
        Line('  setnp %cl');
        Line('  andb %cl, %al');
      end;
      Line('  movzbq %al, %rax');
      Exit;
    end;
    if E^.Bin = boAdd then
      Line('  add' + f + ' %xmm1, %xmm0')
    else if E^.Bin = boSub then
      Line('  sub' + f + ' %xmm1, %xmm0')
    else if E^.Bin = boMul then
      Line('  mul' + f + ' %xmm1, %xmm0')
    else
      Line('  div' + f + ' %xmm1, %xmm0');
    if sgl then
      Line('  movd %xmm0, %eax')
    else
      Line('  movq %xmm0, %rax');
  end;
end;

{ The value of type T in rax (x0) into float register R, as a Single
  when Sgl, else as a Double: an integer converts, a Single widens
  exactly, a real of the width moves (P101). }
procedure TEmitter.RealInto(T: LongInt; Sgl: Boolean; const R: string);
begin
  if FArm then
  begin
    if TKind(T) <> tykReal then
      Line('  scvtf ' + R + ', x0')
    else if Sgl then
      Line('  fmov ' + R + ', w0')
    else if T = TySingle then
    begin
      Line('  fmov s' + Copy(R, 2, 2) + ', w0');
      Line('  fcvt ' + R + ', s' + Copy(R, 2, 2));
    end
    else
      Line('  fmov ' + R + ', x0');
  end
  else if TKind(T) <> tykReal then
  begin
    if Sgl then
      Line('  cvtsi2ssq %rax, %' + R)
    else
      Line('  cvtsi2sdq %rax, %' + R);
  end
  else if Sgl then
    Line('  movd %eax, %' + R)
  else if T = TySingle then
  begin
    Line('  movd %eax, %' + R);
    Line('  cvtss2sd %' + R + ', %' + R);
  end
  else
    Line('  movq %rax, %' + R);
end;

{ The value of type T in rax (x0) as a Double's bits there: an integer
  converts, a Single widens exactly, a Double stays (P101). }
procedure TEmitter.ArgToDouble(T: LongInt);
begin
  if (TKind(T) = tykReal) and (T <> TySingle) then
    Exit;
  if FArm then
  begin
    RealInto(T, False, 'd0');
    Line('  fmov x0, d0');
  end
  else
  begin
    RealInto(T, False, 'xmm0');
    Line('  movq %xmm0, %rax');
  end;
end;

{ After a Double in xmm0 (d0) became an Integer in rax (x0) (1.0.112):
  a NaN, an infinity or a value out of Integer's range stops the program
  at this line, the same on both machines (amd64 gave the lowest Integer
  for all of them, arm64 the nearest end, and 0 for a NaN). Only the
  lowest Integer (amd64) or either end (arm64) is looked at twice: it is
  right only for -2^63 itself. }
procedure TEmitter.RealIntCheck;
var
  ok, bad: string;
begin
  ok := Lab;
  bad := Lab;
  if FArm then
  begin
    Line('  fcmp d0, d0');
    Line('  b.vs ' + bad);
    Line('  eor x16, x0, x0, asr #63');
    Line('  cmn x16, #1');
    { an end of the range, rare: out of line with the failure (P300) }
    ColdBegin('  b.vs');
    Line('  mov x16, #0xc3e0000000000000');
    Line('  fmov d1, x16');
    Line('  fcmp d0, d1');
    Line('  b.eq ' + ok);
    Line(bad + ':');
    Line('  bl rt_realrange');
    ColdEnd;
  end
  else
  begin
    Line('  cmpq $1, %rax');
    ColdBegin('  jo');
    Line('  ucomisd rt_dm63(%rip), %xmm0');
    Line('  jp ' + bad);
    Line('  je ' + ok);
    Line(bad + ':');
    Line('  call rt_realrange');
    ColdEnd;
  end;
  Line(ok + ':');
end;

{ A binary operation of the Quad runtime (P103): the words of both
  operands in the first four argument registers, the result's words
  through a 16-byte scratch slot whose two addresses are the fifth and
  sixth, then back into rax:rdx (x0:x2). Fn is pasquad's routine. }
procedure TEmitter.QuadCall2(E: PExpr; const Fn: string);
var
  off: LongInt;
begin
  EmitExpr(E^.Args[0]);
  if FArm then
  begin
    PshK('x2', 0);
    PshK('x0', 0);
  end
  else
  begin
    PushK('rdx', 0);
    PushK('rax', 0);
  end;
  EmitExpr(E^.Args[1]);
  off := ScratchT(16, E^.Typ);
  if FArm then
  begin
    Line('  mov x3, x2');
    Line('  mov x2, x0');
    Ppop('x0');
    Ppop('x1');
    AddFP('x4', off);
    Line('  add x5, x4, #8');
    Line('  bl ' + Fn);
    LdFP('x0', off);
    LdFP('x2', off + 8);
  end
  else
  begin
    Line('  movq %rdx, %rcx');
    Line('  movq %rax, %rdx');
    Line('  popq %rdi');
    Line('  popq %rsi');
    Line('  leaq ' + IntToStr(off) + '(%rbp), %r8');
    Line('  leaq ' + IntToStr(off + 8) + '(%rbp), %r9');
    Line('  call ' + Fn);
    Line('  movq ' + IntToStr(off) + '(%rbp), %rax');
    Line('  movq ' + IntToStr(off + 8) + '(%rbp), %rdx');
  end;
end;

{ The rtq_ calls the parser makes for Quad (P103). A Quad travels as two
  words in rax:rdx (x0:x2), no pointer in either; pasquad works it out
  and a scratch slot brings a result back. Sqrt stops below 0 and a
  conversion to an Integer out of its range stops, at the caller's line,
  as for a Double. }
function TEmitter.EmitQuadFn(E: PExpr): Boolean;
var
  n, a: string;
  off, off2: LongInt;
begin
  Result := False;
  n := E^.Name;
  if Copy(n, 1, 4) <> 'rtq_' then
    Exit;
  Result := True;
  if n = 'rtq_add' then
    QuadCall2(E, 'p_pasquad_pasqadd')
  else if n = 'rtq_sub' then
    QuadCall2(E, 'p_pasquad_pasqsub')
  else if n = 'rtq_mul' then
    QuadCall2(E, 'p_pasquad_pasqmul')
  else if n = 'rtq_div' then
    QuadCall2(E, 'p_pasquad_pasqdiv')
  else if (n = 'rtq_min') or (n = 'rtq_max') then
  begin
    { Both once, one compare: Min keeps the first unless the second is
      below it, Max unless it is above; a NaN first stays. }
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      PshK('x2', 0);
      PshK('x0', 0);
    end
    else
    begin
      PushK('rdx', 0);
      PushK('rax', 0);
    end;
    EmitExpr(E^.Args[1]);
    a := Lab;
    if FArm then
    begin
      PshK('x2', 0);
      PshK('x0', 0);
      Line('  ldr x0, [sp, #32]');
      Line('  ldr x1, [sp, #48]');
      Line('  ldr x2, [sp]');
      Line('  ldr x3, [sp, #16]');
      Line('  bl p_pasquad_pasqcmp');
      Line('  mov x9, x0');
      Ppop('x4');
      Ppop('x5');
      Ppop('x0');
      Ppop('x2');
      if n = 'rtq_min' then
        Line('  cmp x9, #1')
      else
        Line('  cmn x9, #1');
      Line('  b.ne ' + a);
      Line('  mov x0, x4');
      Line('  mov x2, x5');
    end
    else
    begin
      PushK('rdx', 0);
      PushK('rax', 0);
      Line('  movq 16(%rsp), %rdi');
      Line('  movq 24(%rsp), %rsi');
      Line('  movq (%rsp), %rdx');
      Line('  movq 8(%rsp), %rcx');
      Line('  call p_pasquad_pasqcmp');
      Line('  movq %rax, %rcx');
      Line('  popq %r8');
      Line('  popq %r9');
      Line('  popq %rax');
      Line('  popq %rdx');
      if n = 'rtq_min' then
        Line('  cmpq $1, %rcx')
      else
        Line('  cmpq $-1, %rcx');
      Line('  jne ' + a);
      Line('  movq %r8, %rax');
      Line('  movq %r9, %rdx');
    end;
    Line(a + ':');
  end
  else if n = 'rtq_cmp' then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      PshK('x2', 0);
      PshK('x0', 0);
    end
    else
    begin
      PushK('rdx', 0);
      PushK('rax', 0);
    end;
    EmitExpr(E^.Args[1]);
    if FArm then
    begin
      Line('  mov x3, x2');
      Line('  mov x2, x0');
      Ppop('x0');
      Ppop('x1');
      Line('  bl p_pasquad_pasqcmp');
    end
    else
    begin
      Line('  movq %rdx, %rcx');
      Line('  movq %rax, %rdx');
      Line('  popq %rdi');
      Line('  popq %rsi');
      Line('  call p_pasquad_pasqcmp');
    end;
  end
  else if n = 'rtq_fmt' then
  begin
    { PasFmtQuad(Lo, Hi, W, D): a string back in rax:rdx (x0:x2). }
    EmitExpr(E^.Args[2]);
    if FArm then
      PshK('x0', 0)
    else
      PushK('rax', 0);
    EmitExpr(E^.Args[1]);
    if FArm then
      PshK('x0', 0)
    else
      PushK('rax', 0);
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      Line('  mov x1, x2');
      Ppop('x2');
      Ppop('x3');
      Line('  bl p_pasfmt_pasfmtquad');
    end
    else
    begin
      Line('  movq %rax, %rdi');
      Line('  movq %rdx, %rsi');
      Line('  popq %rdx');
      Line('  popq %rcx');
      Line('  call p_pasfmt_pasfmtquad');
    end;
  end
  else
  begin
    EmitExpr(E^.Args[0]);
    off := ScratchT(16, TyQuad);
    if n = 'rtq_neg' then
    begin
      if FArm then
        Line('  eor x2, x2, #0x8000000000000000')
      else
        Line('  btcq $63, %rdx');
    end
    else if n = 'rtq_abs' then
    begin
      if FArm then
        Line('  and x2, x2, #0x7fffffffffffffff')
      else
        Line('  btrq $63, %rdx');
    end
    else if (n = 'rtq_i2q') or (n = 'rtq_d2q') then
    begin
      if n = 'rtq_i2q' then
        a := 'p_pasquad_pasqfromint'
      else
        a := 'p_pasquad_pasqfromdouble';
      if FArm then
      begin
        AddFP('x1', off);
        Line('  add x2, x1, #8');
        Line('  bl ' + a);
        LdFP('x0', off);
        LdFP('x2', off + 8);
      end
      else
      begin
        Line('  movq %rax, %rdi');
        Line('  leaq ' + IntToStr(off) + '(%rbp), %rsi');
        Line('  leaq ' + IntToStr(off + 8) + '(%rbp), %rdx');
        Line('  call ' + a);
        Line('  movq ' + IntToStr(off) + '(%rbp), %rax');
        Line('  movq ' + IntToStr(off + 8) + '(%rbp), %rdx');
      end;
    end
    else if (n = 'rtq_q2d') or (n = 'rtq_q2s') then
    begin
      if n = 'rtq_q2d' then
        a := 'p_pasquad_pasqtodouble'
      else
        a := 'p_pasquad_pasqtosingle';
      if FArm then
      begin
        Line('  mov x1, x2');
        Line('  bl ' + a);
      end
      else
      begin
        Line('  movq %rax, %rdi');
        Line('  movq %rdx, %rsi');
        Line('  call ' + a);
      end;
    end
    else if n = 'rtq_toint' then
    begin
      { PasQToInt(Lo, Hi, Mode, Ok): Ok in a scratch word; False stops. }
      a := Lab;
      if FArm then
      begin
        Line('  mov x1, x2');
        Imm('x2', E^.Args[1]^.Num);
        AddFP('x3', off);
        Line('  bl p_pasquad_pasqtoint');
        LdFP('x16', off);
        ColdBegin('  cbz x16,');
        Line('  bl rt_realrange');
        ColdEnd;
      end
      else
      begin
        Line('  movq %rax, %rdi');
        Line('  movq %rdx, %rsi');
        Line('  movq $' + IntToStr(E^.Args[1]^.Num) + ', %rdx');
        Line('  leaq ' + IntToStr(off) + '(%rbp), %rcx');
        Line('  call p_pasquad_pasqtoint');
        Line('  cmpb $0, ' + IntToStr(off) + '(%rbp)');
        ColdBegin('  je');
        Line('  call rt_realrange');
        ColdEnd;
      end;
      Line(a + ':');
    end
    else if (n = 'rtq_sqr') or (n = 'rtq_int') or (n = 'rtq_sqrt') or (n = 'rtq_frac') then
    begin
      if (n = 'rtq_sqrt') or (n = 'rtq_frac') then
      begin
        { keep the operand: Sqrt asks its sign first, Frac subtracts
          the whole part from it }
        if FArm then
        begin
          PshK('x2', 0);
          PshK('x0', 0);
        end
        else
        begin
          PushK('rdx', 0);
          PushK('rax', 0);
        end;
      end;
      if n = 'rtq_sqrt' then
      begin
        { only below 0 is outside: -0 and a NaN go on }
        a := Lab;
        if FArm then
        begin
          Line('  mov x1, x2');
          Line('  mov x2, xzr');
          Line('  mov x3, xzr');
          Line('  bl p_pasquad_pasqcmp');
          Line('  cmn x0, #1');
          ColdBegin('  b.eq');
          Line('  bl rt_sqrtneg');
          ColdEnd;
          Line(a + ':');
          Ppop('x0');
          Ppop('x2');
        end
        else
        begin
          Line('  movq %rax, %rdi');
          Line('  movq %rdx, %rsi');
          Line('  xorl %edx, %edx');
          Line('  xorl %ecx, %ecx');
          Line('  call p_pasquad_pasqcmp');
          Line('  cmpq $-1, %rax');
          ColdBegin('  je');
          Line('  call rt_sqrtneg');
          ColdEnd;
          Line(a + ':');
          Line('  popq %rax');
          Line('  popq %rdx');
        end;
      end;
      if FArm then
      begin
        Line('  mov x1, x2');
        if n = 'rtq_sqr' then
        begin
          Line('  mov x2, x0');
          Line('  mov x3, x1');
          AddFP('x4', off);
          Line('  add x5, x4, #8');
          Line('  bl p_pasquad_pasqmul');
        end
        else
        begin
          AddFP('x2', off);
          Line('  add x3, x2, #8');
          if n = 'rtq_sqrt' then
            Line('  bl p_pasquad_pasqsqrt')
          else
            Line('  bl p_pasquad_pasqint');
        end;
      end
      else
      begin
        Line('  movq %rax, %rdi');
        Line('  movq %rdx, %rsi');
        if n = 'rtq_sqr' then
        begin
          Line('  movq %rdi, %rdx');
          Line('  movq %rsi, %rcx');
          Line('  leaq ' + IntToStr(off) + '(%rbp), %r8');
          Line('  leaq ' + IntToStr(off + 8) + '(%rbp), %r9');
          Line('  call p_pasquad_pasqmul');
        end
        else
        begin
          Line('  leaq ' + IntToStr(off) + '(%rbp), %rdx');
          Line('  leaq ' + IntToStr(off + 8) + '(%rbp), %rcx');
          if n = 'rtq_sqrt' then
            Line('  call p_pasquad_pasqsqrt')
          else
            Line('  call p_pasquad_pasqint');
        end;
      end;
      if n = 'rtq_frac' then
      begin
        { the operand minus its whole part }
        off2 := ScratchT(16, TyQuad);
        if FArm then
        begin
          Ppop('x0');
          Ppop('x1');
          LdFP('x2', off);
          LdFP('x3', off + 8);
          AddFP('x4', off2);
          Line('  add x5, x4, #8');
          Line('  bl p_pasquad_pasqsub');
        end
        else
        begin
          Line('  popq %rdi');
          Line('  popq %rsi');
          Line('  movq ' + IntToStr(off) + '(%rbp), %rdx');
          Line('  movq ' + IntToStr(off + 8) + '(%rbp), %rcx');
          Line('  leaq ' + IntToStr(off2) + '(%rbp), %r8');
          Line('  leaq ' + IntToStr(off2 + 8) + '(%rbp), %r9');
          Line('  call p_pasquad_pasqsub');
        end;
        off := off2;
      end;
      if FArm then
      begin
        LdFP('x0', off);
        LdFP('x2', off + 8);
      end
      else
      begin
        Line('  movq ' + IntToStr(off) + '(%rbp), %rax');
        Line('  movq ' + IntToStr(off + 8) + '(%rbp), %rdx');
      end;
    end
    else
      Die('unknown Quad routine ' + n);
  end;
end;

function TEmitter.EmitRealFn(E: PExpr): Boolean;
var
  a, b: string;
  isreal: Boolean;
  k: LongInt;
begin
  Result := False;
  if E = nil then
    Exit;
  { [a, b, ...] where an array of const goes (P124): a TVarRec per value
    in a scratch region of the frame, typed so the stack maps see its
    pointers and a moved stack moves them; the value words cleared first,
    so the collector reads no stale word while a value is worked out;
    then each kind and value, and the slice of them. }
  if E^.Name = 'rt_constarr' then
  begin
    Result := True;
    EmitConstArr(E);
    Exit;
  end;
  { A class as a value (P123): the address of its method table, whose
    label the call's Str names. }
  if E^.Name = 'rt_classref' then
  begin
    Result := True;
    if FArm then
      LeaS(E^.Txt, 'x0')
    else
      Line('  leaq ' + E^.Txt + '(%rip), %rax');
    Exit;
  end;
  { The routine's exception object, G+272 (P122): a handler reads it
    and puts the one it replaced back when it ends. }
  if E^.Name = 'rt_excget' then
  begin
    Result := True;
    if FArm then
      Line('  ldr x0, [x28, #272]')
    else
      Line('  movq 272(%r14), %rax');
    Exit;
  end;
  if E^.Name = 'rt_excset' then
  begin
    Result := True;
    EmitExpr(E^.Args[0]);
    if FArm then
      Line('  str x0, [x28, #272]')
    else
      Line('  movq %rax, 272(%r14)');
    Exit;
  end;
  { UpCase and LowerCase of a Char (P134): a letter is one whose
    distance from 'a' (or 'A') is below 26, and its bit 32 flips, with no
    branch: sbb makes the mask on amd64, cset on arm64 }
  if (E^.Name = 'rt_upcase') or (E^.Name = 'rt_lowcase') then
  begin
    Result := True;
    EmitExpr(E^.Args[0]);
    if E^.Name = 'rt_upcase' then
      k := 97
    else
      k := 65;
    if FArm then
    begin
      Line('  sub w9, w0, #' + IntToStr(k));
      Line('  cmp w9, #26');
      Line('  cset w9, lo');
      Line('  eor w0, w0, w9, lsl #5');
    end
    else
    begin
      Line('  leal -' + IntToStr(k) + '(%rax), %ecx');
      Line('  cmpl $26, %ecx');
      Line('  sbbl %ecx, %ecx');
      Line('  andl $32, %ecx');
      Line('  xorl %ecx, %eax');
    end;
    Exit;
  end;
  if E^.Name = 'rt_setincl' then
  begin
    Result := True;
    EmitSetIncl(E);
    Exit;
  end;
  if E^.Name = 'rt_setconv' then
  begin
    Result := True;
    EmitSetConv(E);
    Exit;
  end;
  { an object bound to an interface (P140): the object, and in the
    second word its class's table for the interface }
  if E^.Name = 'rt_ifacebind' then
  begin
    Result := True;
    EmitExpr(E^.Args[0]);
    if FArm then
      LeaS(IfaceTab(E^.Args[0]^.Typ, E^.Typ), 'x2')
    else
      Line('  leaq ' + IfaceTab(E^.Args[0]^.Typ, E^.Typ) + '(%rip), %rdx');
    Exit;
  end;
  { the address of a hidden variable that holds a value (P127): Self of
    a helper's method called on a value, a constant or a const
    parameter; the value stored as an assignment stores it }
  if E^.Name = 'rt_tmpaddr' then
  begin
    Result := True;
    EmitExpr(E^.Args[1]);
    PromoteReal(E^.Args[0]^.L, E^.Args[1]);
    FStoreSrc := E^.Args[1];
    StoreTo(E^.Args[0]^.L);
    FStoreSrc := nil;
    EmitExpr(E^.Args[0]);
    Exit;
  end;
  if EmitWideFn(E) or EmitAtomicFn(E) or EmitCpuFn(E) or EmitVecFn(E) or EmitRotFn(E) then
  begin
    Result := True;
    Exit;
  end;
  if (E^.Name = 'rt_append') or (E^.Name = 'rt_appendslice') then
  begin
    Result := True;
    EmitAppend(E);
    Exit;
  end;
  { Cap(s) (1.0.132): a slice's third word }
  if E^.Name = 'rt_cap' then
  begin
    Result := True;
    EmitExpr(E^.Args[0]);
    if FArm then
      Line('  mov x0, x3')
    else
      Line('  movq %r8, %rax');
    Exit;
  end;
  { A bit number checked against a count that varies (a string's or a
    slice's bits), given back (1.0.118): an unsigned compare with the
    count, so an empty string refuses every bit. }
  if E^.Name = 'rt_bitchk2' then
  begin
    Result := True;
    EmitExpr(E^.Args[1]);
    if FArm then
      PshK('x0', 0)
    else
      PushK('rax', 0);
    EmitExpr(E^.Args[0]);
    a := Lab;
    if FArm then
    begin
      Ppop('x2');
      Line('  cmp x0, x2');
      ColdBegin('  b.hs');
      Line('  sub x2, x2, #1');
      Line('  mov x1, #0');
      Line('  bl rt_bitfail');
      ColdEnd;
    end
    else
    begin
      Line('  popq %rdx');
      Line('  cmpq %rdx, %rax');
      ColdBegin('  jae');
      Line('  movq %rax, %rdi');
      Line('  leaq -1(%rdx), %rdx');
      Line('  xorl %esi, %esi');
      Line('  call rt_bitfail');
      ColdEnd;
    end;
    Line(a + ':');
    Exit;
  end;
  { A bit number checked in line, given back (P105, 1.0.117). }
  if E^.Name = 'rt_bitchk' then
  begin
    Result := True;
    EmitExpr(E^.Args[0]);
    if FArm then
      EmitBitChk('x0', E^.Args[1]^.Num)
    else
      EmitBitChk('rax', E^.Args[1]^.Num);
    Exit;
  end;
  if (E^.Name = 'rt_power') or (E^.Name = 'rt_hypot') or
    (E^.Name = 'rt_arctan2') or (E^.Name = 'rt_logn') then
  begin
    Result := True;
    if Length(E^.Args) <> 2 then
    begin
      if E^.Name = 'rt_hypot' then
        Die('Hypot takes 2 arguments')
      else if E^.Name = 'rt_arctan2' then
        Die('ArcTan2 takes 2 arguments')
      else if E^.Name = 'rt_logn' then
        Die('LogN takes 2 arguments')
      else
        Die('Power takes 2 arguments');
    end;
    EmitExpr(E^.Args[0]);
    ArgToDouble(E^.Args[0]^.Typ);
    if FArm then
      PshK('x0', 0)
    else
      PushK('rax', 0);
    EmitExpr(E^.Args[1]);
    ArgToDouble(E^.Args[1]^.Typ);
    if FArm then
    begin
      Ppop('x1');
      Line('  bl ' + E^.Name);
    end
    else
    begin
      Line('  popq %r9');
      Line('  call ' + E^.Name);
    end;
    Exit;
  end;
  if E^.Name = 'rt_ldexp' then
  begin
    Result := True;
    if Length(E^.Args) <> 2 then
      Die('Ldexp takes 2 arguments');
    EmitExpr(E^.Args[0]);
    ArgToDouble(E^.Args[0]^.Typ);
    if FArm then
      Line('  mov x1, x0')
    else
      Line('  movq %rax, %r9');
    { The first argument waits on the stack while the second is worked
      out: that may use the register pool, x1 or call a routine (P94). }
    if FArm then
      PshK('x1', 0)
    else
      PushK('r9', 0);
    EmitExpr(E^.Args[1]);
    if FArm then
      Ppop('x1')
    else
      Line('  popq %r9');
    if FArm then
      Line('  bl rt_ldexp')
    else
      Line('  call rt_ldexp');
    Exit;
  end;
  if (E^.Name = 'rt_minsingle') or (E^.Name = 'rt_maxsingle') then
  begin
    { Both Singles (the parser stamped them), compared in binary32. }
    Result := True;
    EmitExpr(E^.Args[0]);
    if FArm then
      PshK('x0', 0)
    else
      PushK('rax', 0);
    EmitExpr(E^.Args[1]);
    if FArm then
    begin
      Ppop('x1');
      Line('  fmov s0, w0');
      Line('  fmov s1, w1');
      Line('  fcmp s1, s0');
      if E^.Name = 'rt_minsingle' then
        Line('  csel x0, x1, x0, lt')
      else
        Line('  csel x0, x1, x0, gt');
    end
    else
    begin
      Line('  popq %r9');
      Line('  movd %eax, %xmm0');
      Line('  movd %r9d, %xmm1');
      Line('  ucomiss %xmm0, %xmm1');
      if E^.Name = 'rt_minsingle' then
      begin
        Line('  movq %rax, %r8');
        Line('  movq %r9, %rax');
        Line('  cmova %r8, %rax');
      end
      else
      begin
        Line('  movq %r9, %r8');
        Line('  cmovae %r8, %rax');
      end;
    end;
    Exit;
  end;
  if (E^.Name = 'rt_s2d') or (E^.Name = 'rt_d2s') or (E^.Name = 'rt_i2s') or
    (E^.Name = 'rt_abssingle') or (E^.Name = 'rt_sqrsingle') or
    (E^.Name = 'rt_sqrtsingle') then
  begin
    { P101: a Single's conversions and its operations of one argument. }
    Result := True;
    EmitExpr(E^.Args[0]);
    if E^.Name = 'rt_s2d' then
      ArgToDouble(E^.Args[0]^.Typ)
    else if E^.Name = 'rt_d2s' then
    begin
      if FArm then
      begin
        RealInto(E^.Args[0]^.Typ, False, 'd0');
        Line('  fcvt s0, d0');
        Line('  fmov w0, s0');
      end
      else
      begin
        RealInto(E^.Args[0]^.Typ, False, 'xmm0');
        Line('  cvtsd2ss %xmm0, %xmm0');
        Line('  movd %xmm0, %eax');
      end;
    end
    else if E^.Name = 'rt_i2s' then
    begin
      if FArm then
      begin
        Line('  scvtf s0, x0');
        Line('  fmov w0, s0');
      end
      else
      begin
        Line('  cvtsi2ssq %rax, %xmm0');
        Line('  movd %xmm0, %eax');
      end;
    end
    else if E^.Name = 'rt_abssingle' then
    begin
      if FArm then
        Line('  and x0, x0, #0x7fffffff')
      else
        Line('  andl $0x7fffffff, %eax');
    end
    else if E^.Name = 'rt_sqrsingle' then
    begin
      if FArm then
      begin
        Line('  fmov s0, w0');
        Line('  fmul s0, s0, s0');
        Line('  fmov w0, s0');
      end
      else
      begin
        Line('  movd %eax, %xmm0');
        Line('  mulss %xmm0, %xmm0');
        Line('  movd %xmm0, %eax');
      end;
    end
    else
    begin
      { Sqrt of a negative Single stops the program, as a Double's. }
      if FArm then
      begin
        { Only below 0 is outside: Sqrt(-0) is -0 and a NaN stays one
          (1.0.112; the sign bit stopped both). }
        a := Lab;
        Line('  fmov s0, w0');
        Line('  fcmp s0, #0.0');
        ColdBegin('  b.mi');
        Line('  bl rt_sqrtneg');
        ColdEnd;
        Line(a + ':');
        Line('  fsqrt s0, s0');
        Line('  fmov w0, s0');
      end
      else
      begin
        a := Lab;
        Line('  movd %eax, %xmm0');
        Line('  xorps %xmm1, %xmm1');
        Line('  ucomiss %xmm1, %xmm0');
        Line('  jp ' + a);
        ColdBegin('  jb');
        Line('  call rt_sqrtneg');
        ColdEnd;
        Line(a + ':');
        Line('  sqrtss %xmm0, %xmm0');
        Line('  movd %xmm0, %eax');
      end;
    end;
    Exit;
  end;
  if (E^.Name = 'rt_minint') or (E^.Name = 'rt_maxint') or
    (E^.Name = 'rt_minreal') or (E^.Name = 'rt_maxreal') then
  begin
    Result := True;
    if Length(E^.Args) <> 2 then
      Die('Min takes 2 arguments');
    isreal := (E^.Name = 'rt_minreal') or (E^.Name = 'rt_maxreal');
    EmitExpr(E^.Args[0]);
    if isreal then
      ArgToDouble(E^.Args[0]^.Typ);
    if FArm then
      PshK('x0', 0)
    else
      PushK('rax', 0);
    EmitExpr(E^.Args[1]);
    if isreal then
      ArgToDouble(E^.Args[1]^.Typ);
    if FArm then
    begin
      Ppop('x1');
      if isreal then
      begin
        Line('  fmov d0, x0');
        Line('  fmov d1, x1');
        Line('  fcmp d1, d0');
      end
      else
        Line('  cmp x1, x0');
      if (E^.Name = 'rt_minint') or (E^.Name = 'rt_minreal') then
        Line('  csel x0, x1, x0, lt')
      else
        Line('  csel x0, x1, x0, gt');
    end
    else
    begin
      Line('  popq %r9');
      if isreal then
      begin
        Line('  movq %rax, %xmm0');
        Line('  movq %r9, %xmm1');
        Line('  ucomisd %xmm0, %xmm1');
        if (E^.Name = 'rt_minreal') then
        begin
          Line('  movq %rax, %r8');
          Line('  movq %r9, %rax');
          Line('  cmova %r8, %rax');
        end
        else
        begin
          Line('  movq %r9, %r8');
          Line('  cmovae %r8, %rax');
        end;
      end
      else
      begin
        Line('  movq %rax, %rcx');
        Line('  movq %r9, %rax');
        Line('  cmpq %rcx, %rax');
        if E^.Name = 'rt_minint' then
          Line('  cmovg %rcx, %rax')
        else
          Line('  cmovl %rcx, %rax');
      end;
    end;
    Exit;
  end;
  if E^.Name = 'rt_poly' then
  begin
    Result := True;
    if Length(E^.Args) <> 2 then
      Die('Poly takes 2 arguments');
    EmitExpr(E^.Args[0]);
    ArgToDouble(E^.Args[0]^.Typ);
    if FArm then
      Line('  mov x1, x0')
    else
      Line('  movq %rax, %r9');
    { The first argument waits on the stack while the second is worked
      out: that may use the register pool, x1 or call a routine (P94). }
    if FArm then
      PshK('x1', 0)
    else
      PushK('r9', 0);
    EmitExpr(E^.Args[1]);
    if FArm then
      Ppop('x1')
    else
      Line('  popq %r9');
    if FArm then
      Line('  bl rt_poly')
    else
      Line('  call rt_poly');
    Exit;
  end;
  if (E^.Name <> 'rt_trunc') and (E^.Name <> 'rt_round') and
    (E^.Name <> 'rt_absreal') and (E^.Name <> 'rt_absint') and
    (E^.Name <> 'rt_sqrreal') and (E^.Name <> 'rt_sqrint') and
    (E^.Name <> 'rt_int2real') and (E^.Name <> 'rt_sqrt') and
    (E^.Name <> 'rt_sin') and (E^.Name <> 'rt_cos') and
    (E^.Name <> 'rt_ln') and (E^.Name <> 'rt_exp') and
    (E^.Name <> 'rt_intpart') and (E^.Name <> 'rt_fracpart') and
    (E^.Name <> 'rt_atan') and (E^.Name <> 'rt_asin') and
    (E^.Name <> 'rt_acos') and (E^.Name <> 'rt_log10') and
    (E^.Name <> 'rt_log2') and (E^.Name <> 'rt_floor') and
    (E^.Name <> 'rt_ceil') and (E^.Name <> 'rt_odd') and
    (E^.Name <> 'rt_isnan') and (E^.Name <> 'rt_isinf') and
    (E^.Name <> 'rt_tan') and (E^.Name <> 'rt_cot') and
    (E^.Name <> 'rt_sec') and (E^.Name <> 'rt_csc') and
    (E^.Name <> 'rt_arccot') and (E^.Name <> 'rt_arcsec') and
    (E^.Name <> 'rt_arccsc') and (E^.Name <> 'rt_sinh') and
    (E^.Name <> 'rt_cosh') and (E^.Name <> 'rt_tanh') and
    (E^.Name <> 'rt_arcsinh') and (E^.Name <> 'rt_arccosh') and
    (E^.Name <> 'rt_arctanh') and (E^.Name <> 'rt_lnxp1') then
    Exit;
  Result := True;
  if Length(E^.Args) < 1 then
    Die('isreal builtin');
  EmitExpr(E^.Args[0]);
  { A Single argument of a Double routine widens exactly (P101). }
  if E^.Args[0]^.Typ = TySingle then
    ArgToDouble(TySingle);
  isreal := TKind(E^.Args[0]^.Typ) = tykReal;
  if E^.Name = 'rt_trunc' then
  begin
    if isreal then
    begin
      if FArm then
      begin
        Line('  fmov d0, x0');
        Line('  fcvtzs x0, d0');
        RealIntCheck;
      end
      else
      begin
        Line('  movq %rax, %xmm0');
        Line('  cvttsd2siq %xmm0, %rax');
        RealIntCheck;
      end;
    end;
  end
  else if E^.Name = 'rt_round' then
  begin
    if isreal then
    begin
      if FArm then
      begin
        Line('  fmov d0, x0');
        Line('  fcvtns x0, d0');
        RealIntCheck;
      end
      else
      begin
        Line('  movq %rax, %xmm0');
        Line('  cvtsd2siq %xmm0, %rax');
        RealIntCheck;
      end;
    end;
  end
  else if E^.Name = 'rt_floor' then
  begin
    if isreal then
    begin
      if FArm then
      begin
        Line('  fmov d0, x0');
        Line('  fcvtms x0, d0');
        RealIntCheck;
      end
      else
      begin
        a := Lab;
        Line('  movq %rax, %xmm0');
        Line('  cvttsd2siq %xmm0, %rax');
        RealIntCheck;
        Line('  cvtsi2sdq %rax, %xmm1');
        Line('  ucomisd %xmm1, %xmm0');
        Line('  jae ' + a);
        Line('  decq %rax');
        Line(a + ':');
      end;
    end;
  end
  else if E^.Name = 'rt_ceil' then
  begin
    if isreal then
    begin
      if FArm then
      begin
        Line('  fmov d0, x0');
        Line('  fcvtps x0, d0');
        RealIntCheck;
      end
      else
      begin
        a := Lab;
        Line('  movq %rax, %xmm0');
        Line('  cvttsd2siq %xmm0, %rax');
        RealIntCheck;
        Line('  cvtsi2sdq %rax, %xmm1');
        Line('  ucomisd %xmm1, %xmm0');
        Line('  jbe ' + a);
        Line('  incq %rax');
        Line(a + ':');
      end;
    end;
  end
  else if E^.Name = 'rt_odd' then
  begin
    if FArm then
      Line('  and x0, x0, #1')
    else
      Line('  andq $1, %rax');
  end
  else if (E^.Name = 'rt_isnan') or (E^.Name = 'rt_isinf') then
  begin
    if not isreal then
    begin
      if FArm then
        Line('  mov x0, xzr')
      else
        Line('  xorl %eax, %eax');
    end
    else
    begin
      a := Lab;
      b := Lab;
      if E^.Name = 'rt_isnan' then
      begin
        if FArm then
        begin
          Line('  lsr x1, x0, #52');
          Line('  and x1, x1, #0x7ff');
          Line('  cmp x1, #2047');
          Line('  b.ne ' + a);
          Line('  lsl x1, x0, #12');
          Line('  cmp x1, #0');
          Line('  cset x0, ne');
          Line('  b ' + b);
          Line(a + ':');
          Line('  mov x0, xzr');
          Line(b + ':');
        end
        else
        begin
          Line('  movq %rax, %rcx');
          Line('  shrq $52, %rcx');
          Line('  andl $2047, %ecx');
          Line('  cmpl $2047, %ecx');
          Line('  jne ' + a);
          Line('  movq %rax, %rcx');
          Line('  shlq $12, %rcx');
          Line('  testq %rcx, %rcx');
          Line('  setne %al');
          Line('  movzbq %al, %rax');
          Line('  jmp ' + b);
          Line(a + ':');
          Line('  xorl %eax, %eax');
          Line(b + ':');
        end;
      end
      else
      begin
        if FArm then
        begin
          Line('  lsl x1, x0, #12');
          Line('  cbnz x1, ' + a);
          Line('  lsr x1, x0, #52');
          Line('  and x1, x1, #0x7ff');
          Line('  cmp x1, #2047');
          Line('  cset x0, eq');
          Line('  b ' + b);
          Line(a + ':');
          Line('  mov x0, xzr');
          Line(b + ':');
        end
        else
        begin
          Line('  movq %rax, %rcx');
          Line('  shlq $12, %rcx');
          Line('  testq %rcx, %rcx');
          Line('  jne ' + a);
          Line('  movq %rax, %rcx');
          Line('  shrq $52, %rcx');
          Line('  andl $2047, %ecx');
          Line('  cmpl $2047, %ecx');
          Line('  sete %al');
          Line('  movzbq %al, %rax');
          Line('  jmp ' + b);
          Line(a + ':');
          Line('  xorl %eax, %eax');
          Line(b + ':');
        end;
      end;
    end;
  end
  else if E^.Name = 'rt_absreal' then
  begin
    if FArm then
    begin
      Line('  fmov d0, x0');
      Line('  fabs d0, d0');
      Line('  fmov x0, d0');
    end
    else
    begin
      Line('  shlq $1, %rax');
      Line('  shrq $1, %rax');
    end;
  end
  else if E^.Name = 'rt_absint' then
  begin
    a := Lab;
    if FArm then
    begin
      Line('  cmp x0, #0');
      Line('  b.ge ' + a);
      Line('  neg x0, x0');
      Line(a + ':');
    end
    else
    begin
      Line('  testq %rax, %rax');
      Line('  jns ' + a);
      Line('  negq %rax');
      Line(a + ':');
    end;
  end
  else if E^.Name = 'rt_int2real' then
  begin
    if not isreal then
    begin
      if FArm then
      begin
        Line('  scvtf d0, x0');
        Line('  fmov x0, d0');
      end
      else
      begin
        Line('  cvtsi2sdq %rax, %xmm0');
        Line('  movq %xmm0, %rax');
      end;
    end;
  end
  else if E^.Name = 'rt_sqrreal' then
  begin
    if FArm then
    begin
      Line('  fmov d0, x0');
      Line('  fmul d0, d0, d0');
      Line('  fmov x0, d0');
    end
    else
    begin
      Line('  movq %rax, %xmm0');
      Line('  mulsd %xmm0, %xmm0');
      Line('  movq %xmm0, %rax');
    end;
  end
  else if (E^.Name = 'rt_sqrt') or (E^.Name = 'rt_sin') or (E^.Name = 'rt_cos') or
    (E^.Name = 'rt_ln') or (E^.Name = 'rt_exp') or
    (E^.Name = 'rt_intpart') or (E^.Name = 'rt_fracpart') or
    (E^.Name = 'rt_atan') or (E^.Name = 'rt_asin') or
    (E^.Name = 'rt_acos') or (E^.Name = 'rt_log10') or
    (E^.Name = 'rt_log2') or (E^.Name = 'rt_tan') or
    (E^.Name = 'rt_cot') or (E^.Name = 'rt_sec') or
    (E^.Name = 'rt_csc') or (E^.Name = 'rt_arccot') or
    (E^.Name = 'rt_arcsec') or (E^.Name = 'rt_arccsc') or
    (E^.Name = 'rt_sinh') or (E^.Name = 'rt_cosh') or
    (E^.Name = 'rt_tanh') or (E^.Name = 'rt_arcsinh') or
    (E^.Name = 'rt_arccosh') or (E^.Name = 'rt_arctanh') or
    (E^.Name = 'rt_lnxp1') then
  begin
    if not isreal then
    begin
      if FArm then
      begin
        Line('  scvtf d0, x0');
        Line('  fmov x0, d0');
      end
      else
      begin
        Line('  cvtsi2sdq %rax, %xmm0');
        Line('  movq %xmm0, %rax');
      end;
    end;
    if E^.Name = 'rt_sqrt' then
    begin
      if FArm then
      begin
        { Only below 0 is outside: Sqrt(-0) is -0 and a NaN stays one
          (1.0.112). }
        a := Lab;
        Line('  fmov d0, x0');
        Line('  fcmp d0, #0.0');
        ColdBegin('  b.mi');
        Line('  bl rt_sqrtneg');
        ColdEnd;
        Line(a + ':');
        Line('  fsqrt d0, d0');
        Line('  fmov x0, d0');
      end
      else
      begin
        a := Lab;
        Line('  movq %rax, %xmm0');
        Line('  xorpd %xmm1, %xmm1');
        Line('  ucomisd %xmm1, %xmm0');
        Line('  jp ' + a);
        ColdBegin('  jb');
        Line('  call rt_sqrtneg');
        ColdEnd;
        Line(a + ':');
        Line('  sqrtsd %xmm0, %xmm0');
        Line('  movq %xmm0, %rax');
      end;
    end
    else if FArm then
      Line('  bl ' + E^.Name)
    else
      Line('  call ' + E^.Name);
  end
  else if FArm then
    Line('  mul x0, x0, x0')
  else
    Line('  imulq %rax, %rax');
end;

procedure TEmitter.PromoteReal(Dest, Src: PExpr);
begin
  if (Dest = nil) or (Src = nil) then
    Exit;
  if TKind(Dest^.Typ) <> tykReal then
    Exit;
  if TKind(Src^.Typ) = tykReal then
    Exit;
  if TKind(Src^.Typ) <> tykInteger then
    Exit;
  if FArm then
  begin
    Line('  scvtf d0, x0');
    Line('  fmov x0, d0');
  end
  else
  begin
    Line('  cvtsi2sdq %rax, %xmm0');
    Line('  movq %xmm0, %rax');
  end;
end;

{ A narrow integer operation or conversion (P99): its result is cleaned
  to its type, the low bits extended by the sign or by zeros. }
{ sar, rol and ror of the clean value in rax by cl, in T's width (P105):
  sar fills with the top bit of the width, so an unsigned narrow value is
  sign-extended from it first (a clean signed one already is, as shr of
  an Int8 takes it); a rotation turns within the width, one
  instruction (rolb, rolw, roll, rolq). The result may have dirty high
  bits: NarrowOp lists these operations, so it is cleaned where looked
  at. }
procedure TEmitter.RotX86(Op: TBinOp; T: LongInt);
var
  w: LongInt;
begin
  w := 64;
  if IsNarrowId(T) then
    w := TSize(T) * 8;
  if Op = boSar then
  begin
    if T = TyByte then
      Line('  movsbq %al, %rax')
    else if T = TyWord then
      Line('  movswq %ax, %rax')
    else if T = TyUInt32 then
      Line('  movslq %eax, %rax');
    Line('  sarq %cl, %rax');
    Exit;
  end;
  if Op = boRol then
  begin
    if w = 8 then
      Line('  rolb %cl, %al')
    else if w = 16 then
      Line('  rolw %cl, %ax')
    else if w = 32 then
      Line('  roll %cl, %eax')
    else
      Line('  rolq %cl, %rax');
  end
  else
  begin
    if w = 8 then
      Line('  rorb %cl, %al')
    else if w = 16 then
      Line('  rorw %cl, %ax')
    else if w = 32 then
      Line('  rorl %cl, %eax')
    else
      Line('  rorq %cl, %rax');
  end;
end;

{ The same on arm64, value in x0, count in x1: asr after a sign
  extension; ror (rol is ror by the negated count) in 32 or 64 bits; a
  byte or a halfword turns by two shifts and an orr on its zero-extended
  value, the count taken modulo the width. x9 and x10 are free here. }
procedure TEmitter.RotArm(Op: TBinOp; T: LongInt);
var
  w: LongInt;
begin
  w := 64;
  if IsNarrowId(T) then
    w := TSize(T) * 8;
  if Op = boSar then
  begin
    if T = TyByte then
      Line('  sxtb x0, w0')
    else if T = TyWord then
      Line('  sxth x0, w0')
    else if T = TyUInt32 then
      Line('  sxtw x0, w0');
    Line('  asr x0, x0, x1');
    Exit;
  end;
  if w >= 32 then
  begin
    if Op = boRol then
    begin
      if w = 32 then
        Line('  neg w1, w1')
      else
        Line('  neg x1, x1');
    end;
    if w = 32 then
      Line('  ror w0, w0, w1')
    else
      Line('  ror x0, x0, x1');
    Exit;
  end;
  if w = 8 then
    Line('  and x0, x0, #0xff')
  else
    Line('  and x0, x0, #0xffff');
  Line('  and x1, x1, #' + IntToStr(w - 1));
  Line('  mov x9, #' + IntToStr(w));
  Line('  sub x9, x9, x1');
  if Op = boRol then
  begin
    Line('  lsl x10, x0, x1');
    Line('  lsr x9, x0, x9');
  end
  else
  begin
    Line('  lsr x10, x0, x1');
    Line('  lsl x9, x0, x9');
  end;
  Line('  orr x0, x10, x9');
end;

function TEmitter.NarrowOp(E: PExpr): Boolean;
begin
  Result := (E <> nil) and IsNarrowId(E^.Typ) and
    (((E^.Kind = ekBin) and ((E^.Bin = boAdd) or (E^.Bin = boSub) or
    (E^.Bin = boMul) or (E^.Bin = boDiv) or (E^.Bin = boMod) or
    (E^.Bin = boAnd) or (E^.Bin = boOr) or (E^.Bin = boXor) or
    (E^.Bin = boShl) or (E^.Bin = boShr) or (E^.Bin = boSar) or (E^.Bin = boRol) or
    (E^.Bin = boRor))) or (E^.Kind = ekUn));
end;

{ A narrow shift whose clean operand gives a clean result (1.0.116): shr
  of any width (zeros or sign copies come in, as the value already had)
  and sar of a signed one. The operand is clean: a shift looks at it. It
  was cleaned again after the shift. }
function TEmitter.KeepsClean(E: PExpr): Boolean;
begin
  Result := False;
  if E = nil then
    Exit;
  if E^.Kind = ekBin then
    Result := (E^.Bin = boShr) or ((E^.Bin = boSar) and
      ((E^.Typ = TyInt8) or (E^.Typ = TyInt16) or (E^.Typ = TyInt32))) or
      { and, or and xor of two clean values (1.0.117): every operand is
        clean where it is used, and a constant here fits the type. }
      (((E^.Bin = boAnd) or (E^.Bin = boOr) or (E^.Bin = boXor)) and
      ((E^.L = nil) or (E^.L^.Kind <> ekInt) or (WrapInt(E^.L^.Num, E^.Typ) = E^.L^.Num)) and
      ((E^.R = nil) or (E^.R^.Kind <> ekInt) or (WrapInt(E^.R^.Num, E^.Typ) = E^.R^.Num)))
  else if E^.Kind = ekUn then
    { a bit or byte reversal of an unsigned type ends at its width }
    Result := ((E^.Un = uoRbit) or (E^.Un = uoBswap)) and
      ((E^.Typ = TyByte) or (E^.Typ = TyWord) or (E^.Typ = TyUInt32) or (E^.Typ = TyChar));
end;

function WReg(const R: string): string;
begin
  Result := 'w' + Copy(R, 2, Length(R) - 1);
end;

{ sar, rol and ror in the pool on arm64 (P105): the value in its pool
  register, the count an immediate or a register; a byte or a halfword
  turns by two shifts through x16 and x17, as the division uses them. }
procedure TEmitter.EmitOrdRotArm(E: PExpr; D: LongInt);
var
  r, op: string;
  w, n: LongInt;
  kimm: Boolean;
begin
  r := OrdPool(D);
  kimm := (E^.R^.Kind = ekInt) and (E^.R^.Num >= 0) and (E^.R^.Num <= 63);
  if kimm then
    op := '#' + IntToStr(E^.R^.Num)
  else
    op := OrdOperand(E^.R, D);
  w := 64;
  if IsNarrowId(E^.Typ) then
    w := TSize(E^.Typ) * 8;
  if E^.Bin = boSar then
  begin
    { Only an unsigned value is extended: a clean signed one is. }
    if E^.Typ = TyByte then
      Line('  sxtb ' + r + ', ' + WReg(r))
    else if E^.Typ = TyWord then
      Line('  sxth ' + r + ', ' + WReg(r))
    else if E^.Typ = TyUInt32 then
      Line('  sxtw ' + r + ', ' + WReg(r));
    Line('  asr ' + r + ', ' + r + ', ' + op);
    Exit;
  end;
  if w >= 32 then
  begin
    if kimm then
    begin
      n := LongInt(E^.R^.Num and (w - 1));
      if E^.Bin = boRol then
        n := (w - n) and (w - 1);
      if w = 32 then
        Line('  ror ' + WReg(r) + ', ' + WReg(r) + ', #' + IntToStr(n))
      else
        Line('  ror ' + r + ', ' + r + ', #' + IntToStr(n));
    end
    else
    begin
      Line('  mov x16, ' + op);
      if E^.Bin = boRol then
        Line('  neg x16, x16');
      if w = 32 then
        Line('  ror ' + WReg(r) + ', ' + WReg(r) + ', w16')
      else
        Line('  ror ' + r + ', ' + r + ', x16');
    end;
    Exit;
  end;
  if w = 8 then
    Line('  and ' + r + ', ' + r + ', #0xff')
  else
    Line('  and ' + r + ', ' + r + ', #0xffff');
  if kimm then
  begin
    n := LongInt(E^.R^.Num and (w - 1));
    if n = 0 then
      Exit;
    if E^.Bin = boRol then
    begin
      Line('  lsl x16, ' + r + ', #' + IntToStr(n));
      Line('  lsr x17, ' + r + ', #' + IntToStr(w - n));
    end
    else
    begin
      Line('  lsr x16, ' + r + ', #' + IntToStr(n));
      Line('  lsl x17, ' + r + ', #' + IntToStr(w - n));
    end;
    Line('  orr ' + r + ', x16, x17');
    Exit;
  end;
  Line('  and x16, ' + op + ', #' + IntToStr(w - 1));
  Line('  mov x17, #' + IntToStr(w));
  Line('  sub x17, x17, x16');
  if E^.Bin = boRol then
  begin
    Line('  lsr x17, ' + r + ', x17');
    Line('  lsl ' + r + ', ' + r + ', x16');
  end
  else
  begin
    Line('  lsl x17, ' + r + ', x17');
    Line('  lsr ' + r + ', ' + r + ', x16');
  end;
  Line('  orr ' + r + ', ' + r + ', x17');
end;

{ The low W bytes (1, 2 or 4) of amd64 register R, named without %. }
function X86Sub(const R: string; W: LongInt): string;
var
  base: string;
begin
  if (R = 'rax') or (R = 'rbx') or (R = 'rcx') or (R = 'rdx') then
  begin
    base := Copy(R, 2, 1);
    if W = 1 then
      Result := base + 'l'
    else if W = 2 then
      Result := base + 'x'
    else if W = 4 then
      Result := 'e' + base + 'x'
    else
      Result := R;
  end
  else if (R = 'rsi') or (R = 'rdi') or (R = 'rbp') or (R = 'rsp') then
  begin
    base := Copy(R, 2, 2);
    if W = 1 then
      Result := base + 'l'
    else if W = 2 then
      Result := base
    else if W = 4 then
      Result := 'e' + base
    else
      Result := R;
  end
  else if W = 1 then
    Result := R + 'b'
  else if W = 2 then
    Result := R + 'w'
  else if W = 4 then
    Result := R + 'd'
  else
    Result := R;
end;

{ The value in R stored at Addr's register with Sz bytes (1.0.121). }
procedure TEmitter.StoreWidth(const R, Addr: string; Sz: LongInt);
begin
  if FArm then
  begin
    if Sz = 1 then
      Line('  strb ' + WReg(R) + ', [' + Addr + ']')
    else if Sz = 2 then
      Line('  strh ' + WReg(R) + ', [' + Addr + ']')
    else if Sz = 4 then
      Line('  str ' + WReg(R) + ', [' + Addr + ']')
    else
      Line('  str ' + R + ', [' + Addr + ']');
  end
  else if Sz = 1 then
    Line('  movb %' + X86Sub(R, 1) + ', (%' + Addr + ')')
  else if Sz = 2 then
    Line('  movw %' + X86Sub(R, 2) + ', (%' + Addr + ')')
  else if Sz = 4 then
    Line('  movl %' + X86Sub(R, 4) + ', (%' + Addr + ')')
  else
    Line('  movq %' + R + ', (%' + Addr + ')');
end;

{ The statements of P106 put in line (1.0.123): the fences (lfence,
  sfence, mfence; dmb ishld, ishst, ish), prefetches (prefetcht0,
  prefetchw; prfm pldl1keep, pstl1keep), a non-temporal store (movnti;
  a plain str on arm64, which has no single one) and a releasing store
  at the variable's width (mov, which x86 orders; stlrb, stlrh, stlr). A
  statement call ends a run the pool keeps in registers, as any call. }
function TEmitter.EmitInlineStmt(S: PStmt): Boolean;
var
  sz: LongInt;
begin
  Result := True;
  if (S^.Name = 'rt_lfence') or (S^.Name = 'rt_sfence') or (S^.Name = 'rt_mfence') then
  begin
    if FArm then
    begin
      if S^.Name = 'rt_lfence' then
        Line('  dmb ishld')
      else if S^.Name = 'rt_sfence' then
        Line('  dmb ishst')
      else
        Line('  dmb ish');
    end
    else if S^.Name = 'rt_lfence' then
      Line('  lfence')
    else if S^.Name = 'rt_sfence' then
      Line('  sfence')
    else
      Line('  mfence');
    Exit;
  end;
  if (S^.Name = 'rt_prefetch') or (S^.Name = 'rt_prefetchw') then
  begin
    EmitExpr(S^.Args[0]);
    if FArm then
    begin
      if S^.Name = 'rt_prefetch' then
        Line('  prfm pldl1keep, [x0]')
      else
        Line('  prfm pstl1keep, [x0]');
    end
    else if S^.Name = 'rt_prefetch' then
      Line('  prefetcht0 (%rax)')
    else
      Line('  prefetchw (%rax)');
    Exit;
  end;
  if (S^.Name = 'rt_storent') or (S^.Name = 'rt_astore') then
  begin
    { Args: the address, the value, the variable's type }
    sz := TSize(LongInt(S^.Args[2]^.Num));
    EmitExpr(S^.Args[1]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(S^.Args[0]);
    if FArm then
    begin
      Ppop('x1');
      if S^.Name = 'rt_storent' then
        StoreWidth('x1', 'x0', sz)
      else if sz = 1 then
        Line('  stlrb w1, [x0]')
      else if sz = 2 then
        Line('  stlrh w1, [x0]')
      else if sz = 4 then
        Line('  stlr w1, [x0]')
      else
        Line('  stlr x1, [x0]');
    end
    else
    begin
      Line('  popq %rcx');
      if (S^.Name = 'rt_storent') and (sz = 8) then
        Line('  movnti %rcx, (%rax)')
      else if (S^.Name = 'rt_storent') and (sz = 4) then
        Line('  movnti %ecx, (%rax)')
      else
        StoreWidth('rcx', 'rax', sz);
    end;
    Exit;
  end;
  { A word put in line as a value, called for its effect (AtomicOr(x, m);
    AddCarry(...);): the value is worked out and dropped. }
  if (Copy(S^.Name, 1, 3) = 'rt_') and (S^.E = nil) then
    if EmitRealFn(NewCall(S^.Name, S^.Args, TyInteger)) then
      Exit;
  Result := False;
end;

{ The atomic words on any integer variable (1.0.123), the address in
  Args[0] and the variable's type last: AtomicLoad acquires (a plain
  load on x86; ldarb, ldarh, ldar), AtomicExchange swaps (xchg; ldaxr and
  stlxr), AtomicAnd, AtomicOr and AtomicXor change the variable at once
  and give what it held (a lock cmpxchg loop; ldaxr, and/orr/eor,
  stlxr), each at the variable's width and its value cleaned to its
  type. }
{ ---- inline assembly (P106, 1.0.127) ---- }

procedure TEmitter.AsmAdd(var A: TStrArray; const S: string);
var
  n: SizeInt;
begin
  n := Length(A);
  SetLength(A, n + 1);
  A[n] := S;
end;

function TEmitter.AsmWordCh(C: Char): Boolean;
begin
  Result := ((C >= 'a') and (C <= 'z')) or ((C >= 'A') and (C <= 'Z')) or
    ((C >= '0') and (C <= '9')) or (C = '_');
end;

{ One of Names (blank-separated) is a word of the block's text, or a
  register a binding names: a register the block uses. }
function TEmitter.AsmNames(S: PStmt; const Names: string): Boolean;
var
  t, w: string;
  i, j, k, n: SizeInt;
begin
  Result := False;
  t := ToLower(S^.Name);
  j := 1;
  while j <= Length(Names) do
  begin
    k := j;
    while (k <= Length(Names)) and (Names[k] <> ' ') do
      Inc(k);
    w := Copy(Names, j, k - j);
    j := k + 1;
    if w = '' then
      Continue;
    for i := 0 to High(S^.Args) do
      if S^.Args[i]^.Txt = w then
      begin
        Result := True;
        Exit;
      end;
    n := Length(w);
    i := 1;
    while i + n - 1 <= Length(t) do
    begin
      if (Copy(t, i, n) = w) and ((i = 1) or not AsmWordCh(t[i - 1])) and
        ((i + n > Length(t)) or not AsmWordCh(t[i + n])) then
      begin
        Result := True;
        Exit;
      end;
      Inc(i);
    end;
  end;
end;

{ A line of the block as Line writes one: two blanks, the first word, one
  blank, the rest; tabs are blanks. The stack maps read pushes, pops and
  calls by that shape. }
function TEmitter.AsmLine(const L: string): string;
var
  s: string;
  i, a, z: SizeInt;
begin
  s := L;
  for i := 1 to Length(s) do
    if (s[i] = #9) or (s[i] = #13) then
      s[i] := ' ';
  a := 1;
  while (a <= Length(s)) and (s[a] = ' ') do
    Inc(a);
  z := Length(s);
  while (z >= a) and (s[z] = ' ') do
    Dec(z);
  if z < a then
  begin
    Result := '';
    Exit;
  end;
  i := a;
  while (i <= z) and (s[i] <> ' ') do
    Inc(i);
  Result := '  ' + Copy(s, a, i - a);
  while (i <= z) and (s[i] = ' ') do
    Inc(i);
  if i <= z then
    Result := Result + ' ' + Copy(s, i, z - i + 1);
end;

procedure TEmitter.AsmText(S: PStmt);
var
  i, a: SizeInt;
  l: string;
begin
  a := 1;
  for i := 1 to Length(S^.Name) do
    if S^.Name[i] = #10 then
    begin
      l := AsmLine(Copy(S^.Name, a, i - a));
      if l <> '' then
      begin
        FAsmText := True;
        Line(l);
        FAsmText := False;
      end;
      a := i + 1;
    end;
end;

procedure TEmitter.EmitAsmX(S: PStmt);
var
  saved: TStrArray;
  ins, outs: array of LongInt;
  pass, i, k, n, off: LongInt;
  b: PExpr;
  reg: string;
  vec, vz: Boolean;
begin
  saved := nil;
  ins := nil;
  outs := nil;
  if AsmNames(S, 'rbx ebx bx bl bh') then
    AsmAdd(saved, 'rbx');
  if AsmNames(S, 'r12 r12d r12w r12b') then
    AsmAdd(saved, 'r12');
  if AsmNames(S, 'r13 r13d r13w r13b') then
    AsmAdd(saved, 'r13');
  if AsmNames(S, 'r14 r14d r14w r14b') then
    AsmAdd(saved, 'r14');
  if AsmNames(S, 'r15 r15d r15w r15b') then
    AsmAdd(saved, 'r15');
  for i := 0 to High(saved) do
    PushK(saved[i], 2);
  { the in values: those of integer registers pushed first, so the
    vector ones come off first, through rax, before rax takes its own }
  for pass := 0 to 1 do
    for i := 0 to High(S^.Args) do
    begin
      b := S^.Args[i];
      if (b^.Num and 1) = 0 then
        Continue;
      vec := (Copy(b^.Txt, 1, 3) = 'xmm') or (Copy(b^.Txt, 1, 3) = 'ymm');
      if vec <> (pass = 1) then
        Continue;
      if IsBlob(b^.Args[0]^.Typ) then
      begin
        EmitArgVal(b^.Args[0]);
        PushK('rax', 1);
      end
      else
      begin
        EmitExpr(b^.Args[0]);
        PushK('rax', VCls(b^.Args[0]^.Typ, 0));
      end;
      n := Length(ins);
      SetLength(ins, n + 1);
      ins[n] := i;
    end;
  for k := High(ins) downto 0 do
  begin
    b := S^.Args[ins[k]];
    reg := b^.Txt;
    if (Copy(reg, 1, 3) = 'xmm') or (Copy(reg, 1, 3) = 'ymm') then
    begin
      Line('  popq %rax');
      if b^.Args[0]^.Typ = TySingle then
        Line('  movd %eax, %' + reg)
      else if b^.Args[0]^.Typ = TyReal then
        Line('  movq %rax, %' + reg)
      else if b^.Args[0]^.Typ = TyV128 then
        Line('  movdqu (%rax), %' + reg)
      else
        Line('  vmovdqu (%rax), %' + reg);
    end
    else
      Line('  popq %' + reg);
  end;
  AsmText(S);
  { the out values: integer registers as they are, then the reals through
    rax, then the vectors through a scratch slot; stored last to first }
  vz := AsmNames(S, 'ymm0 ymm1 ymm2 ymm3 ymm4 ymm5 ymm6 ymm7 ymm8 ymm9 ymm10 ymm11 ymm12 ' +
    'ymm13 ymm14 ymm15');
  for pass := 0 to 2 do
    for i := 0 to High(S^.Args) do
    begin
      b := S^.Args[i];
      if (b^.Num and 2) = 0 then
        Continue;
      reg := b^.Txt;
      vec := (Copy(reg, 1, 3) = 'xmm') or (Copy(reg, 1, 3) = 'ymm');
      if (pass = 0) and not vec then
        PushK(reg, 2)
      else if (pass = 1) and vec and ((b^.Args[0]^.Typ = TyReal) or (b^.Args[0]^.Typ = TySingle)) then
      begin
        if b^.Args[0]^.Typ = TySingle then
          Line('  movd %' + reg + ', %eax')
        else
          Line('  movq %' + reg + ', %rax');
        PushK('rax', 0);
      end
      else if (pass = 2) and vec and IsBlob(b^.Args[0]^.Typ) then
      begin
        off := ScratchT(FTypes[b^.Args[0]^.Typ].Size, b^.Args[0]^.Typ);
        if Copy(reg, 1, 3) = 'ymm' then
          Line('  vmovdqu %' + reg + ', ' + IntToStr(off) + '(%rbp)')
        else
          Line('  movdqu %' + reg + ', ' + IntToStr(off) + '(%rbp)');
        Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
        PushK('rax', 1);
      end
      else
        Continue;
      n := Length(outs);
      SetLength(outs, n + 1);
      outs[n] := i;
    end;
  if vz then
    Line('  vzeroupper');
  for k := High(outs) downto 0 do
  begin
    Line('  popq %rax');
    StoreTo(S^.Args[outs[k]]^.Args[0]);
  end;
  for i := High(saved) downto 0 do
    Line('  popq %' + saved[i]);
end;

procedure TEmitter.EmitAsmA(S: PStmt);
var
  saved: TStrArray;
  ins, outs: array of LongInt;
  pass, i, k, n, off: LongInt;
  b: PExpr;
  reg: string;
  vec: Boolean;
begin
  saved := nil;
  ins := nil;
  outs := nil;
  for i := 19 to 28 do
    if AsmNames(S, 'x' + IntToStr(i) + ' w' + IntToStr(i)) then
      AsmAdd(saved, 'x' + IntToStr(i));
  for i := 8 to 15 do
    if AsmNames(S, 'd' + IntToStr(i) + ' s' + IntToStr(i) + ' q' + IntToStr(i) + ' v' +
      IntToStr(i) + ' b' + IntToStr(i) + ' h' + IntToStr(i)) then
      AsmAdd(saved, 'd' + IntToStr(i));
  for i := 0 to High(saved) do
  begin
    MapHint(2);
    Line('  str ' + saved[i] + ', [sp, #-16]!');
  end;
  for pass := 0 to 1 do
    for i := 0 to High(S^.Args) do
    begin
      b := S^.Args[i];
      if (b^.Num and 1) = 0 then
        Continue;
      vec := b^.Txt[1] <> 'x';
      if vec <> (pass = 1) then
        Continue;
      if IsBlob(b^.Args[0]^.Typ) then
      begin
        EmitArgVal(b^.Args[0]);
        PshK('x0', 1);
      end
      else
      begin
        EmitExpr(b^.Args[0]);
        PshK('x0', VCls(b^.Args[0]^.Typ, 0));
      end;
      n := Length(ins);
      SetLength(ins, n + 1);
      ins[n] := i;
    end;
  for k := High(ins) downto 0 do
  begin
    b := S^.Args[ins[k]];
    reg := b^.Txt;
    if reg[1] = 'x' then
      Ppop(reg)
    else
    begin
      Ppop('x9');
      if reg[1] = 's' then
        Line('  fmov ' + reg + ', w9')
      else if reg[1] = 'd' then
        Line('  fmov ' + reg + ', x9')
      else
        Line('  ldr ' + reg + ', [x9]');
    end;
  end;
  AsmText(S);
  for pass := 0 to 2 do
    for i := 0 to High(S^.Args) do
    begin
      b := S^.Args[i];
      if (b^.Num and 2) = 0 then
        Continue;
      reg := b^.Txt;
      if (pass = 0) and (reg[1] = 'x') then
        PshK(reg, 2)
      else if (pass = 1) and ((reg[1] = 's') or (reg[1] = 'd')) then
      begin
        if reg[1] = 's' then
          Line('  fmov w9, ' + reg)
        else
          Line('  fmov x9, ' + reg);
        PshK('x9', 0);
      end
      else if (pass = 2) and (reg[1] = 'q') then
      begin
        off := ScratchT(16, TyV128);
        AddFP('x9', off);
        Line('  str ' + reg + ', [x9]');
        PshK('x9', 1);
      end
      else
        Continue;
      n := Length(outs);
      SetLength(outs, n + 1);
      outs[n] := i;
    end;
  for k := High(outs) downto 0 do
  begin
    Ppop('x0');
    StoreTo(S^.Args[outs[k]]^.Args[0]);
  end;
  for i := High(saved) downto 0 do
    Line('  ldr ' + saved[i] + ', [sp], #16');
end;

{ ---- the vector words (P106, 1.0.125) ----

  A statement that works out a V128 or a V256 runs in two phases. The
  first evaluates, left to right, the address of every vector operand
  that is no word (a variable, a field, an element, p^, a function's
  result) and every integer that is no constant, and pushes each: here
  anything may happen, a call, a collection, a routine switch. The
  second loads the operands into vector registers (xmm2-xmm15, ymm with
  AVX2; v16-v31 on arm64), works the tree out in them and stores the
  result, with no call at all: nothing can take the registers away, and
  no routine switch can see them. A V256 on amd64 takes AVX2 when
  rt_cpufeat says so (bit 13, tested once for the statement, and
  vzeroupper after it, so no SSE instruction pays for dirty upper
  halves) and two SSE2 halves otherwise; on arm64 always two NEON
  halves. Every word works on each 128-bit half alone, as AVX2's do.
  What SSE2 lacks (pmulld, pminsb, pminud, pcmpeqq, an unsigned compare)
  is a short sequence of its own instructions. }
function TEmitter.VecOp(E: PExpr): Boolean;
begin
  Result := (E <> nil) and (E^.Kind = ekCall) and ((E^.Typ = TyV128) or (E^.Typ = TyV256)) and
    (Copy(E^.Name, 1, 4) = 'rt_v');
end;

function TEmitter.VecX(I: LongInt): string;
begin
  Result := '%xmm' + IntToStr(I + 2);
end;

function TEmitter.VecY(I: LongInt): string;
begin
  Result := '%ymm' + IntToStr(I + 2);
end;

function TEmitter.VecV(I: LongInt; const Arr: string): string;
begin
  Result := 'v' + IntToStr(I + 16) + '.' + Arr;
end;

{ The lane of a word, from the digits it ends in; 0 for the bitwise ones. }
function TEmitter.VecLane(const Op: string): LongInt;
var
  n: SizeInt;
begin
  n := Length(Op);
  if Copy(Op, n - 1, 2) = '16' then
    Result := 16
  else if Copy(Op, n - 1, 2) = '32' then
    Result := 32
  else if Copy(Op, n - 1, 2) = '64' then
    Result := 64
  else if Op[n] = '8' then
    Result := 8
  else
    Result := 0;
end;

function TEmitter.VecArr(Lane: LongInt): string;
begin
  if Lane = 16 then
    Result := '8h'
  else if Lane = 32 then
    Result := '4s'
  else if Lane = 64 then
    Result := '2d'
  else
    Result := '16b';
end;

{ The one instruction a word is on SSE2, '' when it has none there. }
function TEmitter.VecSse(const Op: string): string;
begin
  Result := '';
  if Op = 'add8' then
    Result := 'paddb'
  else if Op = 'add16' then
    Result := 'paddw'
  else if Op = 'add32' then
    Result := 'paddd'
  else if Op = 'add64' then
    Result := 'paddq'
  else if Op = 'sub8' then
    Result := 'psubb'
  else if Op = 'sub16' then
    Result := 'psubw'
  else if Op = 'sub32' then
    Result := 'psubd'
  else if Op = 'sub64' then
    Result := 'psubq'
  else if Op = 'addsatu8' then
    Result := 'paddusb'
  else if Op = 'addsats8' then
    Result := 'paddsb'
  else if Op = 'addsatu16' then
    Result := 'paddusw'
  else if Op = 'addsats16' then
    Result := 'paddsw'
  else if Op = 'subsatu8' then
    Result := 'psubusb'
  else if Op = 'subsats8' then
    Result := 'psubsb'
  else if Op = 'subsatu16' then
    Result := 'psubusw'
  else if Op = 'subsats16' then
    Result := 'psubsw'
  else if Op = 'mul16' then
    Result := 'pmullw'
  else if Op = 'avgu8' then
    Result := 'pavgb'
  else if Op = 'avgu16' then
    Result := 'pavgw'
  else if Op = 'minu8' then
    Result := 'pminub'
  else if Op = 'maxu8' then
    Result := 'pmaxub'
  else if Op = 'mins16' then
    Result := 'pminsw'
  else if Op = 'maxs16' then
    Result := 'pmaxsw'
  else if Op = 'cmpeq8' then
    Result := 'pcmpeqb'
  else if Op = 'cmpeq16' then
    Result := 'pcmpeqw'
  else if Op = 'cmpeq32' then
    Result := 'pcmpeqd'
  else if Op = 'cmpgts8' then
    Result := 'pcmpgtb'
  else if Op = 'cmpgts16' then
    Result := 'pcmpgtw'
  else if Op = 'cmpgts32' then
    Result := 'pcmpgtd'
  else if Op = 'and' then
    Result := 'pand'
  else if Op = 'or' then
    Result := 'por'
  else if Op = 'xor' then
    Result := 'pxor'
  else if Op = 'ziplo8' then
    Result := 'punpcklbw'
  else if Op = 'ziplo16' then
    Result := 'punpcklwd'
  else if Op = 'ziplo32' then
    Result := 'punpckldq'
  else if Op = 'ziplo64' then
    Result := 'punpcklqdq'
  else if Op = 'ziphi8' then
    Result := 'punpckhbw'
  else if Op = 'ziphi16' then
    Result := 'punpckhwd'
  else if Op = 'ziphi32' then
    Result := 'punpckhdq'
  else if Op = 'ziphi64' then
    Result := 'punpckhqdq'
  else if Op = 'packu16' then
    Result := 'packuswb'
  else if Op = 'packs16' then
    Result := 'packsswb'
  else if Op = 'packs32' then
    Result := 'packssdw'
  else if Op = 'addf32' then
    Result := 'addps'
  else if Op = 'addf64' then
    Result := 'addpd'
  else if Op = 'subf32' then
    Result := 'subps'
  else if Op = 'subf64' then
    Result := 'subpd'
  else if Op = 'mulf32' then
    Result := 'mulps'
  else if Op = 'mulf64' then
    Result := 'mulpd'
  else if Op = 'divf32' then
    Result := 'divps'
  else if Op = 'divf64' then
    Result := 'divpd'
  else if Op = 'minf32' then
    Result := 'minps'
  else if Op = 'minf64' then
    Result := 'minpd'
  else if Op = 'maxf32' then
    Result := 'maxps'
  else if Op = 'maxf64' then
    Result := 'maxpd'
  else if Op = 'cmpeqf32' then
    Result := 'cmpeqps'
  else if Op = 'cmpeqf64' then
    Result := 'cmpeqpd'
  else if Op = 'cmpltf32' then
    Result := 'cmpltps'
  else if Op = 'cmpltf64' then
    Result := 'cmpltpd'
  else if Op = 'cmplef32' then
    Result := 'cmpleps'
  else if Op = 'cmplef64' then
    Result := 'cmplepd';
end;

function TEmitter.VecAvx(const Op: string): string;
begin
  Result := '';
  if Op = 'add8' then
    Result := 'vpaddb'
  else if Op = 'add16' then
    Result := 'vpaddw'
  else if Op = 'add32' then
    Result := 'vpaddd'
  else if Op = 'add64' then
    Result := 'vpaddq'
  else if Op = 'sub8' then
    Result := 'vpsubb'
  else if Op = 'sub16' then
    Result := 'vpsubw'
  else if Op = 'sub32' then
    Result := 'vpsubd'
  else if Op = 'sub64' then
    Result := 'vpsubq'
  else if Op = 'addsatu8' then
    Result := 'vpaddusb'
  else if Op = 'addsats8' then
    Result := 'vpaddsb'
  else if Op = 'addsatu16' then
    Result := 'vpaddusw'
  else if Op = 'addsats16' then
    Result := 'vpaddsw'
  else if Op = 'subsatu8' then
    Result := 'vpsubusb'
  else if Op = 'subsats8' then
    Result := 'vpsubsb'
  else if Op = 'subsatu16' then
    Result := 'vpsubusw'
  else if Op = 'subsats16' then
    Result := 'vpsubsw'
  else if Op = 'mul16' then
    Result := 'vpmullw'
  else if Op = 'avgu8' then
    Result := 'vpavgb'
  else if Op = 'avgu16' then
    Result := 'vpavgw'
  else if Op = 'minu8' then
    Result := 'vpminub'
  else if Op = 'maxu8' then
    Result := 'vpmaxub'
  else if Op = 'mins16' then
    Result := 'vpminsw'
  else if Op = 'maxs16' then
    Result := 'vpmaxsw'
  else if Op = 'cmpeq8' then
    Result := 'vpcmpeqb'
  else if Op = 'cmpeq16' then
    Result := 'vpcmpeqw'
  else if Op = 'cmpeq32' then
    Result := 'vpcmpeqd'
  else if Op = 'cmpgts8' then
    Result := 'vpcmpgtb'
  else if Op = 'cmpgts16' then
    Result := 'vpcmpgtw'
  else if Op = 'cmpgts32' then
    Result := 'vpcmpgtd'
  else if Op = 'and' then
    Result := 'vpand'
  else if Op = 'or' then
    Result := 'vpor'
  else if Op = 'xor' then
    Result := 'vpxor'
  else if Op = 'mul32' then
    Result := 'vpmulld'
  else if Op = 'mins8' then
    Result := 'vpminsb'
  else if Op = 'maxs8' then
    Result := 'vpmaxsb'
  else if Op = 'minu16' then
    Result := 'vpminuw'
  else if Op = 'maxu16' then
    Result := 'vpmaxuw'
  else if Op = 'minu32' then
    Result := 'vpminud'
  else if Op = 'maxu32' then
    Result := 'vpmaxud'
  else if Op = 'mins32' then
    Result := 'vpminsd'
  else if Op = 'maxs32' then
    Result := 'vpmaxsd'
  else if Op = 'cmpeq64' then
    Result := 'vpcmpeqq'
  else if Op = 'ziplo8' then
    Result := 'vpunpcklbw'
  else if Op = 'ziplo16' then
    Result := 'vpunpcklwd'
  else if Op = 'ziplo32' then
    Result := 'vpunpckldq'
  else if Op = 'ziplo64' then
    Result := 'vpunpcklqdq'
  else if Op = 'ziphi8' then
    Result := 'vpunpckhbw'
  else if Op = 'ziphi16' then
    Result := 'vpunpckhwd'
  else if Op = 'ziphi32' then
    Result := 'vpunpckhdq'
  else if Op = 'ziphi64' then
    Result := 'vpunpckhqdq'
  else if Op = 'packu16' then
    Result := 'vpackuswb'
  else if Op = 'packs16' then
    Result := 'vpacksswb'
  else if Op = 'packs32' then
    Result := 'vpackssdw'
  else if Op = 'addf32' then
    Result := 'vaddps'
  else if Op = 'addf64' then
    Result := 'vaddpd'
  else if Op = 'subf32' then
    Result := 'vsubps'
  else if Op = 'subf64' then
    Result := 'vsubpd'
  else if Op = 'mulf32' then
    Result := 'vmulps'
  else if Op = 'mulf64' then
    Result := 'vmulpd'
  else if Op = 'divf32' then
    Result := 'vdivps'
  else if Op = 'divf64' then
    Result := 'vdivpd'
  else if Op = 'minf32' then
    Result := 'vminps'
  else if Op = 'minf64' then
    Result := 'vminpd'
  else if Op = 'maxf32' then
    Result := 'vmaxps'
  else if Op = 'maxf64' then
    Result := 'vmaxpd'
  else if Op = 'cmpeqf32' then
    Result := 'vcmpeqps'
  else if Op = 'cmpeqf64' then
    Result := 'vcmpeqpd'
  else if Op = 'cmpltf32' then
    Result := 'vcmpltps'
  else if Op = 'cmpltf64' then
    Result := 'vcmpltpd'
  else if Op = 'cmplef32' then
    Result := 'vcmpleps'
  else if Op = 'cmplef64' then
    Result := 'vcmplepd';
end;

{ NEON's, by the word less its lane. }
function TEmitter.VecNeon(const Op: string): string;
var
  b: string;
begin
  Result := '';
  b := Op;
  while (Length(b) > 0) and (b[Length(b)] >= '0') and (b[Length(b)] <= '9') do
    SetLength(b, Length(b) - 1);
  if b = 'add' then
    Result := 'add'
  else if b = 'sub' then
    Result := 'sub'
  else if b = 'addsatu' then
    Result := 'uqadd'
  else if b = 'addsats' then
    Result := 'sqadd'
  else if b = 'subsatu' then
    Result := 'uqsub'
  else if b = 'subsats' then
    Result := 'sqsub'
  else if b = 'mul' then
    Result := 'mul'
  else if b = 'avgu' then
    Result := 'urhadd'
  else if b = 'minu' then
    Result := 'umin'
  else if b = 'maxu' then
    Result := 'umax'
  else if b = 'mins' then
    Result := 'smin'
  else if b = 'maxs' then
    Result := 'smax'
  else if b = 'cmpeq' then
    Result := 'cmeq'
  else if b = 'cmpgts' then
    Result := 'cmgt'
  else if b = 'cmpgtu' then
    Result := 'cmhi'
  else if b = 'and' then
    Result := 'and'
  else if b = 'or' then
    Result := 'orr'
  else if b = 'xor' then
    Result := 'eor'
  else if b = 'ziplo' then
    Result := 'zip1'
  else if b = 'ziphi' then
    Result := 'zip2'
  else if b = 'addf' then
    Result := 'fadd'
  else if b = 'subf' then
    Result := 'fsub'
  else if b = 'mulf' then
    Result := 'fmul'
  else if b = 'divf' then
    Result := 'fdiv'
  else if b = 'cmpeqf' then
    Result := 'fcmeq';
end;

{ The slot of an operand the first phase pushed: its distance from the
  stack pointer. }
function TEmitter.VecSlot(E: PExpr): LongInt;
var
  j: SizeInt;
begin
  Result := -1;
  for j := 0 to High(FVecItems) do
    if FVecItems[j] = E then
    begin
      if FArm then
        Result := (FVecN - 1 - LongInt(j)) * 16
      else
        Result := (FVecN - 1 - LongInt(j)) * 8;
      Exit;
    end;
  Die('vector operand without a slot');
end;

procedure TEmitter.VecCollect(E: PExpr; var Items: TExprArray);
var
  i, n: SizeInt;
  a: PExpr;
begin
  for i := 0 to High(E^.Args) do
  begin
    a := E^.Args[i];
    if VecOp(a) then
      VecCollect(a, Items)
    else if (a^.Kind <> ekInt) and not VecHomeOK(a) then
    begin
      EmitArgVal(a);
      if FArm then
        PshK('x0', ACls(a))
      else
        PushK('rax', ACls(a));
      n := Length(Items);
      SetLength(Items, n + 1);
      Items[n] := a;
    end;
  end;
end;

{ An integer operand of the second phase into Reg: a constant, or its slot. }
procedure TEmitter.VecIntX(E: PExpr; const Reg: string);
begin
  if E^.Kind = ekInt then
  begin
    if (E^.Num >= -2147483648) and (E^.Num <= 2147483647) then
      Line('  movq $' + IntToStr(E^.Num) + ', %' + Reg)
    else
      Line('  movabsq $' + IntToStr(E^.Num) + ', %' + Reg);
  end
  else if FVecDirect then
  begin
    EmitExpr(E);
    if Reg <> 'rax' then
      Line('  movq %rax, %' + Reg);
  end
  else
    Line('  movq ' + IntToStr(VecSlot(E)) + '(%rsp), %' + Reg);
end;

procedure TEmitter.VecIntA(E: PExpr; const Reg: string);
begin
  if E^.Kind = ekInt then
    Imm(Reg, E^.Num)
  else if FVecDirect then
  begin
    EmitExpr(E);
    if Reg <> 'x0' then
      Line('  mov ' + Reg + ', x0');
  end
  else
    Line('  ldr ' + Reg + ', [sp, #' + IntToStr(VecSlot(E)) + ']');
end;

{ Mask m = a > b in R+2 (SSE2), a and b in R and R+1; then R := the
  smaller (Min) or the larger. An unsigned compare flips the top bits
  first. }
procedure TEmitter.VecMinMaxX(R: LongInt; const Cmp: string; Unsigned, IsMin: Boolean);
begin
  if Unsigned then
  begin
    Line('  pcmpeqd ' + VecX(R + 4) + ', ' + VecX(R + 4));
    Line('  pslld $31, ' + VecX(R + 4));
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  pxor ' + VecX(R + 4) + ', ' + VecX(R + 2));
    Line('  movdqa ' + VecX(R + 1) + ', ' + VecX(R + 3));
    Line('  pxor ' + VecX(R + 4) + ', ' + VecX(R + 3));
    Line('  ' + Cmp + ' ' + VecX(R + 3) + ', ' + VecX(R + 2));
  end
  else
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  ' + Cmp + ' ' + VecX(R + 1) + ', ' + VecX(R + 2));
  end;
  if IsMin then
  begin
    Line('  movdqa ' + VecX(R + 1) + ', ' + VecX(R + 3));
    Line('  pand ' + VecX(R + 2) + ', ' + VecX(R + 3));
    Line('  pandn ' + VecX(R) + ', ' + VecX(R + 2));
  end
  else
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 3));
    Line('  pand ' + VecX(R + 2) + ', ' + VecX(R + 3));
    Line('  pandn ' + VecX(R + 1) + ', ' + VecX(R + 2));
  end;
  Line('  por ' + VecX(R + 3) + ', ' + VecX(R + 2));
  Line('  movdqa ' + VecX(R + 2) + ', ' + VecX(R));
end;

{ The sign bit of every lane in register R, for the unsigned compares:
  SSE2 (Mode 0 or 2) or VEX in ymm (1) or xmm (3). }
procedure TEmitter.VecBiasX(R, Lane, Mode: LongInt);
var
  vex: Boolean;
begin
  vex := (Mode = 1) or (Mode = 3);
  if Lane = 8 then
  begin
    Line('  movl $2155905152, %ecx');
    if vex then
    begin
      Line('  vmovd %ecx, ' + VecX(R));
      Line('  vpbroadcastd ' + VecX(R) + ', ' + VecR(R, Mode));
    end
    else
    begin
      Line('  movd %ecx, ' + VecX(R));
      Line('  pshufd $0, ' + VecX(R) + ', ' + VecX(R));
    end;
  end
  else if vex then
  begin
    if Lane = 16 then
    begin
      Line('  vpcmpeqw ' + VecR(R, Mode) + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
      Line('  vpsllw $15, ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
    end
    else
    begin
      Line('  vpcmpeqd ' + VecR(R, Mode) + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
      Line('  vpslld $31, ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
    end;
  end
  else if Lane = 16 then
  begin
    Line('  pcmpeqw ' + VecX(R) + ', ' + VecX(R));
    Line('  psllw $15, ' + VecX(R));
  end
  else
  begin
    Line('  pcmpeqd ' + VecX(R) + ', ' + VecX(R));
    Line('  pslld $31, ' + VecX(R));
  end;
end;

function TEmitter.VecShiftIns(const Op: string): string;
begin
  if Copy(Op, 1, 3) = 'shl' then
    Result := 'psll'
  else if Copy(Op, 1, 4) = 'shru' then
    Result := 'psrl'
  else
    Result := 'psra';
  if VecLane(Op) = 16 then
    Result := Result + 'w'
  else if VecLane(Op) = 32 then
    Result := Result + 'd'
  else
    Result := Result + 'q';
end;

{ Register I of a tree in Mode: ymm in AVX2's 256 bits (1), xmm else. }
function TEmitter.VecR(I, Mode: LongInt): string;
begin
  if Mode = 1 then
    Result := VecY(I)
  else
    Result := VecX(I);
end;

{ A word that reduces a vector to an Integer (1.0.126). }
function TEmitter.VecRed(E: PExpr): Boolean;
begin
  Result := (E <> nil) and (E^.Kind = ekCall) and (E^.Typ = TyInteger) and
    ((E^.Name = 'rt_vmovemask8') or (E^.Name = 'rt_vsumu8') or (E^.Name = 'rt_vsums32') or
    (E^.Name = 'rt_vsum64'));
end;

function TEmitter.VecHasWord(E: PExpr): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  Result := True;
  if VecOp(E) or VecRed(E) then
    Exit;
  if VecHasWord(E^.L) or VecHasWord(E^.R) then
    Exit;
  for i := 0 to High(E^.Args) do
    if VecHasWord(E^.Args[i]) then
      Exit;
  Result := False;
end;

{ A vector word whose operands compute with no call and no other vector
  word (1.0.128): the statement needs no first phase, each operand is
  computed where it is loaded, and a region may hold it. }
function TEmitter.VecPure(E: PExpr): Boolean;
var
  i: SizeInt;
  a: PExpr;
begin
  Result := False;
  for i := 0 to High(E^.Args) do
  begin
    a := E^.Args[i];
    if VecOp(a) then
    begin
      if not VecPure(a) then
        Exit;
    end
    else if (not PromoExprOK(a)) or VecHasWord(a) then
      Exit;
  end;
  Result := True;
end;

{ The root of a vector statement: a word, a reduction, or a vector
  place copied whole (x := p[i], 1.0.128). }
function TEmitter.VecPureRoot(E: PExpr): Boolean;
begin
  if VecOp(E) or VecRed(E) then
    Result := VecPure(E)
  else
    Result := PromoExprOK(E) and not VecHasWord(E);
end;

{ v := w or v := p[i] for vectors that compute with no call: a vector
  statement of one load and one store, which a region may hold. }
function TEmitter.VecCopy(S: PStmt): Boolean;
begin
  Result := (S^.Dest <> nil) and (S^.E <> nil) and
    ((S^.Dest^.Typ = TyV128) or (S^.Dest^.Typ = TyV256)) and (S^.E^.Typ = S^.Dest^.Typ) and
    ((S^.E^.Kind = ekVar) or (S^.E^.Kind = ekIndex) or (S^.E^.Kind = ekField) or
    (S^.E^.Kind = ekDeref)) and VecPureRoot(S^.E) and VecDestPure(S^.Dest);
end;

function TEmitter.VecDestPure(D: PExpr): Boolean;
begin
  Result := (D <> nil) and ((D^.Kind = ekVar) or (D^.Kind = ekField) or (D^.Kind = ekIndex) or
    (D^.Kind = ekDeref)) and PromoExprOK(D) and not VecHasWord(D);
end;

{ A vector variable of the routine's own or a global, read and written
  at its home with no address computed first. }
function TEmitter.VecHomeOK(E: PExpr): Boolean;
var
  s: TSym;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekVar) or ((E^.Typ <> TyV128) and (E^.Typ <> TyV256)) then
    Exit;
  if not TryFindSym(E^.Name, s) then
    Exit;
  Result := (not s.ByRef) and (s.Up = 0);
end;

function TEmitter.VecHome(E: PExpr; Half: LongInt): string;
var
  s: TSym;
begin
  Result := '';
  if not VecHomeOK(E) then
    Exit;
  TryFindSym(E^.Name, s);
  if s.Global then
    Result := VarLabel(s.Name) + '+' + IntToStr(16 * Half) + '(%rip)'
  else
    Result := IntToStr(s.Off + 16 * Half) + '(%rbp)';
end;

{ x9 := the home of a vector variable (arm64). }
procedure TEmitter.VecHomeA(E: PExpr);
var
  s: TSym;
begin
  TryFindSym(E^.Name, s);
  if s.Global then
    LeaS(VarLabel(s.Name), 'x9')
  else
    AddFP('x9', s.Off);
end;

function TEmitter.VecPIdx(E: PExpr): LongInt;
var
  s: TSym;
  i: SizeInt;
begin
  Result := -1;
  if (not FPromoOn) or (Length(FVPromo) = 0) or (E = nil) or (E^.Kind <> ekVar) then
    Exit;
  if not TryFindSym(E^.Name, s) then
    Exit;
  if s.ByRef or (s.Up <> 0) then
    Exit;
  for i := 0 to High(FVPromo) do
    if (FVPromo[i].Place.Global = s.Global) and SamePlace(FVPromo[i].Place, s) then
    begin
      Result := LongInt(i);
      Exit;
    end;
end;

{ The register a promoted variable is in, for half Half in Mode: ymm for
  a V256 in AVX2's copy, the half's xmm else; 'vN' on arm64. '' when E
  is no promoted variable. }
function TEmitter.VecPReg(E: PExpr; Half, Mode: LongInt): string;
var
  i: LongInt;
begin
  Result := '';
  i := VecPIdx(E);
  if i < 0 then
    Exit;
  if FArm then
  begin
    if (Half = 1) and (FVPromo[i].R1 >= 0) then
      Result := 'v' + IntToStr(FVPromo[i].R1)
    else
      Result := 'v' + IntToStr(FVPromo[i].R0);
    Exit;
  end;
  if Mode = 1 then
    Result := '%ymm' + IntToStr(FVPromo[i].R0)
  else if (Half = 1) and (FVPromo[i].R1 >= 0) then
    Result := '%xmm' + IntToStr(FVPromo[i].R1)
  else
    Result := '%xmm' + IntToStr(FVPromo[i].R0);
end;

{ p[i] for p a pointer variable to vectors and i a variable or a constant
  (1.0.128): the operand of its half 0 (half 1 in H1), p in rcx and i
  shifted by the element's size in rax, with no stack traffic; '' when E
  has another shape. }
function TEmitter.VecIdxX(E: PExpr; out H1: string): string;
var
  sp, si: TSym;
  sh, sz: LongInt;
  k: Int64;
  b: string;
begin
  Result := '';
  H1 := '';
  if (E = nil) or (E^.Kind <> ekIndex) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  if TKind(E^.L^.Typ) <> tykPointer then
    Exit;
  if not WordVar(E^.L, sp) then
    Exit;
  sz := FTypes[E^.Typ].Size;
  if sz = 16 then
    sh := 4
  else if sz = 32 then
    sh := 5
  else
    Exit;
  if E^.R^.Kind = ekInt then
  begin
    k := E^.R^.Num * sz;
    if not Fits32(k + 16) then
      Exit;
    if sp.Reg <> '' then
      b := '%' + sp.Reg
    else
    begin
      LoadWordVar(sp, 'rax');
      b := '%rax';
    end;
    Result := IntToStr(k) + '(' + b + ')';
    H1 := IntToStr(k + 16) + '(' + b + ')';
    Exit;
  end;
  if not WordVar(E^.R, si) then
    Exit;
  if sp.Reg <> '' then
    b := '%' + sp.Reg
  else
  begin
    LoadWordVar(sp, 'rcx');
    b := '%rcx';
  end;
  LoadWordVar(si, 'rax');
  Line('  shlq $' + IntToStr(sh) + ', %rax');
  Result := '(' + b + ',%rax)';
  H1 := '16(' + b + ',%rax)';
end;

{ The same on arm64: x9 := the address of p[i]. }
function TEmitter.VecIdxA(E: PExpr): Boolean;
var
  sp, si: TSym;
  sh, sz: LongInt;
  b, x: string;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekIndex) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  if TKind(E^.L^.Typ) <> tykPointer then
    Exit;
  if not WordVar(E^.L, sp) then
    Exit;
  sz := FTypes[E^.Typ].Size;
  if sz = 16 then
    sh := 4
  else if sz = 32 then
    sh := 5
  else
    Exit;
  if E^.R^.Kind = ekInt then
  begin
    LoadWordVar(sp, 'x9');
    if E^.R^.Num <> 0 then
    begin
      AddImmArmT('x9', 'x9', E^.R^.Num * sz, 'x10');
    end;
    Result := True;
    Exit;
  end;
  if not WordVar(E^.R, si) then
    Exit;
  if sp.Reg <> '' then
    b := sp.Reg
  else
  begin
    LoadWordVar(sp, 'x9');
    b := 'x9';
  end;
  if si.Reg <> '' then
    x := si.Reg
  else
  begin
    LoadWordVar(si, 'x10');
    x := 'x10';
  end;
  Line('  add x9, ' + b + ', ' + x + ', lsl #' + IntToStr(sh));
  Result := True;
end;

{ A splat of a constant as 32 bytes in the data, aligned on 32 (1.0.128):
  one movdqa or vmovdqa loads it, where a register splat takes three. }
function TEmitter.VecConst(Lane: LongInt; V: Int64): string;
var
  i, n: SizeInt;
begin
  n := Length(FVecCLane);
  for i := 0 to n - 1 do
    if (FVecCLane[i] = Lane) and (FVecCVal[i] = V) then
    begin
      Result := '.Lvc' + IntToStr(i);
      Exit;
    end;
  SetLength(FVecCLane, n + 1);
  SetLength(FVecCVal, n + 1);
  FVecCLane[n] := Lane;
  FVecCVal[n] := V;
  Result := '.Lvc' + IntToStr(n);
end;

{ The register the tree node E writes: the promoted destination for the
  statement's root when there is one, R's else. }
function TEmitter.VecOut(E: PExpr; R, Half, Mode: LongInt): string;
begin
  Result := '';
  if (E = FVecRootE) and (FVecDestE <> nil) then
    Result := VecPReg(FVecDestE, Half, Mode);
  if Result = '' then
  begin
    if FArm then
      Result := 'v' + IntToStr(R + 16)
    else
      Result := VecR(R, Mode);
  end
  else
    FVecRootDone := True;
end;

{ The tree of E into register R on amd64. Mode 0 is SSE2 on 128-bit half
  Half, 2 the same with SSSE3's pshufb, 1 AVX2 on all 256 bits, 3 VEX on
  128 bits (a V128 in AVX2's copy of a region, where no legacy SSE
  instruction may meet ymm registers that hold values). A promoted
  variable is an operand where it lies (1.0.128). }
procedure TEmitter.VecTreeX(E: PExpr; R, Half, Mode: LongInt);
var
  op, ins, cmp, l1, l2, s, a, b, h, h1, o, cnt: string;
  lane: LongInt;
  c: Int64;
  Vex: Boolean;
begin
  Vex := (Mode = 1) or (Mode = 3);
  if R + 4 > 13 - FVecTop then
    Die('a vector expression this deep needs more vector registers than there are: ' +
      'split it into two statements');
  if not VecOp(E) then
  begin
    o := VecOut(E, R, Half, Mode);
    h := VecPReg(E, Half, Mode);
    if h <> '' then
    begin
      if h = o then
        Exit;
      if Vex then
        Line('  vmovdqa ' + h + ', ' + o)
      else
        Line('  movdqa ' + h + ', ' + o);
      Exit;
    end;
    h := VecHome(E, Half);
    if (h = '') and FVecDirect then
    begin
      h := VecIdxX(E, h1);
      if Half = 1 then
        h := h1;
    end;
    if h = '' then
    begin
      if FVecDirect then
        EmitArgVal(E)
      else
        Line('  movq ' + IntToStr(VecSlot(E)) + '(%rsp), %rax');
      h := IntToStr(16 * Half) + '(%rax)';
    end;
    if Vex then
      Line('  vmovdqu ' + h + ', ' + o)
    else
      Line('  movdqu ' + h + ', ' + o);
    Exit;
  end;
  op := Copy(E^.Name, 5, Length(E^.Name) - 4);
  lane := VecLane(op);
  if Copy(op, 1, 5) = 'splat' then
  begin
    o := VecOut(E, R, Half, Mode);
    if (E^.Args[0]^.Kind = ekInt) and (E^.Args[0]^.Num = 0) then
    begin
      if Vex then
        Line('  vpxor ' + o + ', ' + o + ', ' + o)
      else
        Line('  pxor ' + o + ', ' + o);
      Exit;
    end;
    if E^.Args[0]^.Kind = ekInt then
    begin
      if Vex then
        Line('  vmovdqa ' + VecConst(lane, E^.Args[0]^.Num) + '(%rip), ' + o)
      else
        Line('  movdqa ' + VecConst(lane, E^.Args[0]^.Num) + '(%rip), ' + o);
      Exit;
    end;
    VecIntX(E^.Args[0], 'rcx');
    { the xmm register under o }
    if Copy(o, 1, 4) = '%ymm' then
      h := '%xmm' + Copy(o, 5, Length(o) - 4)
    else
      h := o;
    if Vex then
    begin
      Line('  vmovq %rcx, ' + h);
      if lane = 8 then
        Line('  vpbroadcastb ' + h + ', ' + o)
      else if lane = 16 then
        Line('  vpbroadcastw ' + h + ', ' + o)
      else if lane = 32 then
        Line('  vpbroadcastd ' + h + ', ' + o)
      else
        Line('  vpbroadcastq ' + h + ', ' + o);
    end
    else if lane = 64 then
    begin
      Line('  movq %rcx, ' + o);
      Line('  punpcklqdq ' + o + ', ' + o);
    end
    else
    begin
      Line('  movd %ecx, ' + o);
      if lane = 8 then
        Line('  punpcklbw ' + o + ', ' + o);
      if lane <= 16 then
        Line('  punpcklwd ' + o + ', ' + o);
      Line('  pshufd $0, ' + o + ', ' + o);
    end;
    Exit;
  end;
  if op = 'not' then
  begin
    if Vex then
    begin
      a := VecPReg(E^.Args[0], Half, Mode);
      if a = '' then
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        a := VecR(R, Mode);
      end;
      Line('  vpcmpeqd ' + VecR(R + 1, Mode) + ', ' + VecR(R + 1, Mode) + ', ' + VecR(R + 1, Mode));
      Line('  vpxor ' + VecR(R + 1, Mode) + ', ' + a + ', ' + VecOut(E, R, Half, Mode));
    end
    else
    begin
      VecTreeX(E^.Args[0], R, Half, Mode);
      Line('  pcmpeqd ' + VecX(R + 1) + ', ' + VecX(R + 1));
      Line('  pxor ' + VecX(R + 1) + ', ' + VecX(R));
    end;
    Exit;
  end;
  if (Copy(op, 1, 4) = 'sqrt') or (op = 'cvts32f32') then
  begin
    if op = 'sqrtf32' then
      ins := 'sqrtps'
    else if op = 'sqrtf64' then
      ins := 'sqrtpd'
    else
      ins := 'cvtdq2ps';
    if Vex then
    begin
      a := VecPReg(E^.Args[0], Half, Mode);
      if a = '' then
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        a := VecR(R, Mode);
      end;
      Line('  v' + ins + ' ' + a + ', ' + VecOut(E, R, Half, Mode));
    end
    else
    begin
      VecTreeX(E^.Args[0], R, Half, Mode);
      Line('  ' + ins + ' ' + VecX(R) + ', ' + VecX(R));
    end;
    Exit;
  end;
  if op = 'shuffle8' then
  begin
    VecTreeX(E^.Args[0], R, Half, Mode);
    VecTreeX(E^.Args[1], R + 1, Half, Mode);
    { An index past 15 gives 0, as tbl does: 0x70 added with saturation
      keeps 0..15 in the low nibble and sets bit 7 of the others, which
      pshufb reads as zero. }
    if Vex then
    begin
      Line('  movl $1886417008, %ecx');
      Line('  vmovd %ecx, ' + VecX(R + 2));
      Line('  vpbroadcastd ' + VecX(R + 2) + ', ' + VecR(R + 2, Mode));
      Line('  vpaddusb ' + VecR(R + 2, Mode) + ', ' + VecR(R + 1, Mode) + ', ' + VecR(R + 1, Mode));
      Line('  vpshufb ' + VecR(R + 1, Mode) + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
    end
    else if Mode = 2 then
    begin
      Line('  movl $1886417008, %ecx');
      Line('  movd %ecx, ' + VecX(R + 2));
      Line('  pshufd $0, ' + VecX(R + 2) + ', ' + VecX(R + 2));
      Line('  paddusb ' + VecX(R + 2) + ', ' + VecX(R + 1));
      Line('  pshufb ' + VecX(R + 1) + ', ' + VecX(R));
    end
    else
    begin
      { SSE2 alone: the bytes through memory, one by one }
      s := IntToStr(FVecScr);
      l1 := Lab;
      l2 := Lab;
      Line('  movdqu ' + VecX(R) + ', ' + s + '(%rbp)');
      Line('  movdqu ' + VecX(R + 1) + ', ' + IntToStr(FVecScr + 16) + '(%rbp)');
      Line('  xorl %edx, %edx');
      Line(l1 + ':');
      Line('  movzbl ' + IntToStr(FVecScr + 16) + '(%rbp,%rdx), %ecx');
      Line('  xorl %eax, %eax');
      Line('  cmpl $16, %ecx');
      Line('  jae ' + l2);
      Line('  movzbl ' + s + '(%rbp,%rcx), %eax');
      Line(l2 + ':');
      Line('  movb %al, ' + IntToStr(FVecScr + 32) + '(%rbp,%rdx)');
      Line('  incl %edx');
      Line('  cmpl $16, %edx');
      Line('  jb ' + l1);
      Line('  movdqu ' + IntToStr(FVecScr + 32) + '(%rbp), ' + VecX(R));
    end;
    Exit;
  end;
  if (Copy(op, 1, 2) = 'sh') and (op <> 'shuffle8') then
  begin
    ins := VecShiftIns(op);
    a := VecPReg(E^.Args[0], Half, Mode);
    { SSE2 shifts in place: into the promoted destination when that is
      the operand, else in R }
    if not Vex then
    begin
      o := '';
      if (a <> '') and (E = FVecRootE) and (FVecDestE <> nil) and
        (a = VecPReg(FVecDestE, Half, Mode)) then
      begin
        o := a;
        FVecRootDone := True;
      end
      else
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        o := VecX(R);
      end;
    end
    else if a = '' then
    begin
      VecTreeX(E^.Args[0], R, Half, Mode);
      a := VecR(R, Mode);
    end;
    if op = 'shrs64' then
    begin
      { x86 has no arithmetic shift of 64-bit lanes before AVX-512
        (1.0.136): with m the sign bit shifted as far, ((x shr c) xor m)
        - m; a count past 63 fills with the sign, as 63 does. m comes
        from all ones, psllq 63 and the same shift, in R + 2. }
      if E^.Args[1]^.Kind = ekInt then
      begin
        c := E^.Args[1]^.Num;
        if (c < 0) or (c > 63) then
          c := 63;
        cnt := '$' + IntToStr(c);
      end
      else
      begin
        VecIntX(E^.Args[1], 'rcx');
        l1 := Lab;
        Line('  cmpq $63, %rcx');
        Line('  jbe ' + l1);
        Line('  movl $63, %ecx');
        Line(l1 + ':');
        if Vex then
          Line('  vmovq %rcx, ' + VecX(R + 1))
        else
          Line('  movq %rcx, ' + VecX(R + 1));
        cnt := VecX(R + 1);
      end;
      if Vex then
      begin
        Line('  vpcmpeqd ' + VecR(R + 2, Mode) + ', ' + VecR(R + 2, Mode) + ', ' + VecR(R + 2, Mode));
        Line('  vpsllq $63, ' + VecR(R + 2, Mode) + ', ' + VecR(R + 2, Mode));
        Line('  vpsrlq ' + cnt + ', ' + VecR(R + 2, Mode) + ', ' + VecR(R + 2, Mode));
        Line('  vpsrlq ' + cnt + ', ' + a + ', ' + VecOut(E, R, Half, Mode));
        Line('  vpxor ' + VecR(R + 2, Mode) + ', ' + VecOut(E, R, Half, Mode) + ', ' + VecOut(E, R, Half, Mode));
        Line('  vpsubq ' + VecR(R + 2, Mode) + ', ' + VecOut(E, R, Half, Mode) + ', ' + VecOut(E, R, Half, Mode));
      end
      else
      begin
        Line('  pcmpeqd ' + VecX(R + 2) + ', ' + VecX(R + 2));
        Line('  psllq $63, ' + VecX(R + 2));
        Line('  psrlq ' + cnt + ', ' + VecX(R + 2));
        Line('  psrlq ' + cnt + ', ' + o);
        Line('  pxor ' + VecX(R + 2) + ', ' + o);
        Line('  psubq ' + VecX(R + 2) + ', ' + o);
      end;
    end
    else if E^.Args[1]^.Kind = ekInt then
    begin
      c := E^.Args[1]^.Num;
      if (c < 0) or (c > 255) then
        c := 255;
      if Vex then
        Line('  v' + ins + ' $' + IntToStr(c) + ', ' + a + ', ' + VecOut(E, R, Half, Mode))
      else
        Line('  ' + ins + ' $' + IntToStr(c) + ', ' + o);
    end
    else
    begin
      VecIntX(E^.Args[1], 'rcx');
      if Vex then
      begin
        Line('  vmovq %rcx, ' + VecX(R + 1));
        Line('  v' + ins + ' ' + VecX(R + 1) + ', ' + a + ', ' + VecOut(E, R, Half, Mode));
      end
      else
      begin
        Line('  movq %rcx, ' + VecX(R + 1));
        Line('  ' + ins + ' ' + VecX(R + 1) + ', ' + o);
      end;
    end;
    Exit;
  end;
  if op = 'select' then
  begin
    VecTreeX(E^.Args[0], R, Half, Mode);
    if Vex then
    begin
      a := VecPReg(E^.Args[1], Half, Mode);
      if a = '' then
      begin
        VecTreeX(E^.Args[1], R + 1, Half, Mode);
        a := VecR(R + 1, Mode);
      end;
      b := VecPReg(E^.Args[2], Half, Mode);
      if b = '' then
      begin
        VecTreeX(E^.Args[2], R + 2, Half, Mode);
        b := VecR(R + 2, Mode);
      end;
      Line('  vpand ' + VecR(R, Mode) + ', ' + a + ', ' + VecR(R + 1, Mode));
      Line('  vpandn ' + b + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
      Line('  vpor ' + VecR(R + 1, Mode) + ', ' + VecR(R, Mode) + ', ' + VecOut(E, R, Half, Mode));
    end
    else
    begin
      VecTreeX(E^.Args[1], R + 1, Half, Mode);
      VecTreeX(E^.Args[2], R + 2, Half, Mode);
      Line('  pand ' + VecX(R) + ', ' + VecX(R + 1));
      Line('  pandn ' + VecX(R + 2) + ', ' + VecX(R));
      Line('  por ' + VecX(R + 1) + ', ' + VecX(R));
    end;
    Exit;
  end;
  { two operands: one instruction where the machine has it, a promoted
    variable read in its own register }
  if Vex then
    ins := VecAvx(op)
  else
    ins := VecSse(op);
  if ins <> '' then
  begin
    if Vex then
    begin
      a := VecPReg(E^.Args[0], Half, Mode);
      if a = '' then
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        a := VecR(R, Mode);
      end;
      b := VecPReg(E^.Args[1], Half, Mode);
      if b = '' then
      begin
        VecTreeX(E^.Args[1], R + 1, Half, Mode);
        b := VecR(R + 1, Mode);
      end;
      Line('  ' + ins + ' ' + b + ', ' + a + ', ' + VecOut(E, R, Half, Mode));
    end
    else
    begin
      { acc := word(acc, x) works on acc's register itself }
      a := VecPReg(E^.Args[0], Half, Mode);
      o := '';
      if (a <> '') and (E = FVecRootE) and (FVecDestE <> nil) and
        (a = VecPReg(FVecDestE, Half, Mode)) then
        o := a
      else
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        o := VecX(R);
      end;
      b := VecPReg(E^.Args[1], Half, Mode);
      if b = '' then
      begin
        VecTreeX(E^.Args[1], R + 1, Half, Mode);
        b := VecX(R + 1);
      end;
      Line('  ' + ins + ' ' + b + ', ' + o);
      if o = a then
        FVecRootDone := True;
    end;
    Exit;
  end;
  VecTreeX(E^.Args[0], R, Half, Mode);
  VecTreeX(E^.Args[1], R + 1, Half, Mode);
  if Vex then
  begin
    if op = 'andnot' then
      Line('  vpandn ' + VecR(R, Mode) + ', ' + VecR(R + 1, Mode) + ', ' + VecOut(E, R, Half, Mode))
    else if Copy(op, 1, 6) = 'cmpgtu' then
    begin
      VecBiasX(R + 2, lane, Mode);
      Line('  vpxor ' + VecR(R + 2, Mode) + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
      Line('  vpxor ' + VecR(R + 2, Mode) + ', ' + VecR(R + 1, Mode) + ', ' + VecR(R + 1, Mode));
      if lane = 8 then
        cmp := 'vpcmpgtb'
      else if lane = 16 then
        cmp := 'vpcmpgtw'
      else
        cmp := 'vpcmpgtd';
      Line('  ' + cmp + ' ' + VecR(R + 1, Mode) + ', ' + VecR(R, Mode) + ', ' + VecOut(E, R, Half, Mode));
    end
    else
      Die('no AVX2 form of the vector word ' + op);
    Exit;
  end;
  if op = 'andnot' then
  begin
    Line('  pandn ' + VecX(R) + ', ' + VecX(R + 1));
    Line('  movdqa ' + VecX(R + 1) + ', ' + VecX(R));
  end
  else if op = 'mul32' then
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  pmuludq ' + VecX(R + 1) + ', ' + VecX(R));
    Line('  psrlq $32, ' + VecX(R + 2));
    Line('  movdqa ' + VecX(R + 1) + ', ' + VecX(R + 3));
    Line('  psrlq $32, ' + VecX(R + 3));
    Line('  pmuludq ' + VecX(R + 3) + ', ' + VecX(R + 2));
    Line('  pshufd $8, ' + VecX(R) + ', ' + VecX(R));
    Line('  pshufd $8, ' + VecX(R + 2) + ', ' + VecX(R + 2));
    Line('  punpckldq ' + VecX(R + 2) + ', ' + VecX(R));
  end
  else if op = 'minu16' then
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  psubusw ' + VecX(R + 1) + ', ' + VecX(R + 2));
    Line('  psubw ' + VecX(R + 2) + ', ' + VecX(R));
  end
  else if op = 'maxu16' then
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  psubusw ' + VecX(R + 1) + ', ' + VecX(R + 2));
    Line('  paddw ' + VecX(R + 1) + ', ' + VecX(R + 2));
    Line('  movdqa ' + VecX(R + 2) + ', ' + VecX(R));
  end
  else if (op = 'mins8') or (op = 'maxs8') then
    VecMinMaxX(R, 'pcmpgtb', False, op = 'mins8')
  else if (op = 'mins32') or (op = 'maxs32') then
    VecMinMaxX(R, 'pcmpgtd', False, op = 'mins32')
  else if (op = 'minu32') or (op = 'maxu32') then
    VecMinMaxX(R, 'pcmpgtd', True, op = 'minu32')
  else if op = 'cmpeq64' then
  begin
    Line('  pcmpeqd ' + VecX(R + 1) + ', ' + VecX(R));
    Line('  pshufd $177, ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  pand ' + VecX(R + 2) + ', ' + VecX(R));
  end
  else if Copy(op, 1, 6) = 'cmpgtu' then
  begin
    VecBiasX(R + 2, lane, 0);
    Line('  pxor ' + VecX(R + 2) + ', ' + VecX(R));
    Line('  pxor ' + VecX(R + 2) + ', ' + VecX(R + 1));
    if lane = 8 then
      cmp := 'pcmpgtb'
    else if lane = 16 then
      cmp := 'pcmpgtw'
    else
      cmp := 'pcmpgtd';
    Line('  ' + cmp + ' ' + VecX(R + 1) + ', ' + VecX(R));
  end
  else
    Die('no SSE2 form of the vector word ' + op);
end;

{ The tree of E into register R on arm64, half Half; every instruction
  takes its operands where they lie, so a promoted variable is read in
  its own register (1.0.128). }
procedure TEmitter.VecTreeA(E: PExpr; R, Half: LongInt);
var
  op, ins, arr, sh, a, b, d, rr: string;
  lane: LongInt;
  c: Int64;
begin
  if R + 4 > 13 then
    Die('a vector expression this deep needs more vector registers than there are: ' +
      'split it into two statements');
  rr := 'v' + IntToStr(R + 16);
  if not VecOp(E) then
  begin
    d := VecOut(E, R, Half, 0);
    a := VecPReg(E, Half, 0);
    if a <> '' then
    begin
      if a <> d then
        Line('  mov ' + d + '.16b, ' + a + '.16b');
      Exit;
    end;
    if VecHomeOK(E) then
      VecHomeA(E)
    else if FVecDirect then
    begin
      if not VecIdxA(E) then
      begin
        EmitArgVal(E);
        Line('  mov x9, x0');
      end;
    end
    else
      Line('  ldr x9, [sp, #' + IntToStr(VecSlot(E)) + ']');
    Line('  ldr q' + Copy(d, 2, Length(d) - 1) + ', [x9, #' + IntToStr(16 * Half) + ']');
    Exit;
  end;
  op := Copy(E^.Name, 5, Length(E^.Name) - 4);
  lane := VecLane(op);
  arr := VecArr(lane);
  { select and the packs write their result before they read all of
    their operands: they keep R, and the sink moves it }
  if (op = 'select') or (Copy(op, 1, 4) = 'pack') then
    d := rr
  else
    d := VecOut(E, R, Half, 0);
  if Copy(op, 1, 5) = 'splat' then
  begin
    if (E^.Args[0]^.Kind = ekInt) and (E^.Args[0]^.Num = 0) then
    begin
      Line('  movi ' + d + '.2d, #0');
      Exit;
    end;
    VecIntA(E^.Args[0], 'x9');
    if lane = 64 then
      Line('  dup ' + d + '.' + arr + ', x9')
    else
      Line('  dup ' + d + '.' + arr + ', w9');
    Exit;
  end;
  if op = 'select' then
  begin
    VecTreeA(E^.Args[0], R, Half);
    a := VecPReg(E^.Args[1], Half, 0);
    if a = '' then
    begin
      VecTreeA(E^.Args[1], R + 1, Half);
      a := 'v' + IntToStr(R + 17);
    end;
    b := VecPReg(E^.Args[2], Half, 0);
    if b = '' then
    begin
      VecTreeA(E^.Args[2], R + 2, Half);
      b := 'v' + IntToStr(R + 18);
    end;
    Line('  bsl ' + d + '.16b, ' + a + '.16b, ' + b + '.16b');
    Exit;
  end;
  a := VecPReg(E^.Args[0], Half, 0);
  if a = '' then
  begin
    VecTreeA(E^.Args[0], R, Half);
    a := rr;
  end;
  if op = 'not' then
  begin
    Line('  mvn ' + d + '.16b, ' + a + '.16b');
    Exit;
  end;
  if (Copy(op, 1, 4) = 'sqrt') or (op = 'cvts32f32') then
  begin
    if op = 'cvts32f32' then
      Line('  scvtf ' + d + '.4s, ' + a + '.4s')
    else
      Line('  fsqrt ' + d + '.' + arr + ', ' + a + '.' + arr);
    Exit;
  end;
  if (Copy(op, 1, 2) = 'sh') and (op <> 'shuffle8') then
  begin
    if E^.Args[1]^.Kind = ekInt then
    begin
      c := E^.Args[1]^.Num;
      if (c < 0) or (c > lane) then
        c := lane;
      if (Copy(op, 1, 3) = 'shl') and (c = lane) then
        Line('  movi ' + d + '.2d, #0')
      else if c = 0 then
      begin
        if a <> d then
          Line('  mov ' + d + '.16b, ' + a + '.16b');
      end
      else
      begin
        if Copy(op, 1, 3) = 'shl' then
          sh := 'shl'
        else if Copy(op, 1, 4) = 'shru' then
          sh := 'ushr'
        else
          sh := 'sshr';
        Line('  ' + sh + ' ' + d + '.' + arr + ', ' + a + '.' + arr + ', #' + IntToStr(c));
      end;
    end
    else
    begin
      VecIntA(E^.Args[1], 'x9');
      Line('  mov x10, #' + IntToStr(lane));
      Line('  cmp x9, x10');
      Line('  csel x9, x10, x9, hi');
      if Copy(op, 1, 3) <> 'shl' then
        Line('  neg x9, x9');
      if lane = 64 then
        Line('  dup ' + VecV(R + 1, arr) + ', x9')
      else
        Line('  dup ' + VecV(R + 1, arr) + ', w9');
      if Copy(op, 1, 4) = 'shrs' then
        sh := 'sshl'
      else
        sh := 'ushl';
      Line('  ' + sh + ' ' + d + '.' + arr + ', ' + a + '.' + arr + ', ' + VecV(R + 1, arr));
    end;
    Exit;
  end;
  b := VecPReg(E^.Args[1], Half, 0);
  if b = '' then
  begin
    VecTreeA(E^.Args[1], R + 1, Half);
    b := 'v' + IntToStr(R + 17);
  end;
  if op = 'andnot' then
    Line('  bic ' + d + '.16b, ' + a + '.16b, ' + b + '.16b')
  else if op = 'shuffle8' then
    Line('  tbl ' + d + '.16b, {' + a + '.16b}, ' + b + '.16b')
  else if (op = 'packu16') or (op = 'packs16') then
  begin
    if op = 'packu16' then
      ins := 'sqxtun'
    else
      ins := 'sqxtn';
    Line('  ' + ins + ' ' + d + '.8b, ' + a + '.8h');
    Line('  ' + ins + '2 ' + d + '.16b, ' + b + '.8h');
  end
  else if op = 'packs32' then
  begin
    Line('  sqxtn ' + d + '.4h, ' + a + '.4s');
    Line('  sqxtn2 ' + d + '.8h, ' + b + '.4s');
  end
  { x86's minps and maxps: a < b ? a : b and a > b ? a : b, the second
    when either is a NaN; fmin would give the NaN. }
  else if (Copy(op, 1, 4) = 'minf') or (Copy(op, 1, 4) = 'maxf') then
  begin
    if Copy(op, 1, 4) = 'minf' then
      Line('  fcmgt ' + VecV(R + 2, arr) + ', ' + b + '.' + arr + ', ' + a + '.' + arr)
    else
      Line('  fcmgt ' + VecV(R + 2, arr) + ', ' + a + '.' + arr + ', ' + b + '.' + arr);
    Line('  bsl ' + VecV(R + 2, '16b') + ', ' + a + '.16b, ' + b + '.16b');
    Line('  mov ' + d + '.16b, ' + VecV(R + 2, '16b'));
  end
  else if Copy(op, 1, 6) = 'cmpltf' then
    Line('  fcmgt ' + d + '.' + arr + ', ' + b + '.' + arr + ', ' + a + '.' + arr)
  else if Copy(op, 1, 6) = 'cmplef' then
    Line('  fcmge ' + d + '.' + arr + ', ' + b + '.' + arr + ', ' + a + '.' + arr)
  else
  begin
    ins := VecNeon(op);
    if ins = '' then
      Die('no NEON form of the vector word ' + op);
    Line('  ' + ins + ' ' + d + '.' + arr + ', ' + a + '.' + arr + ', ' + b + '.' + arr);
  end;
end;

function TEmitter.VecHasShuf(E: PExpr): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekCall) or (Copy(E^.Name, 1, 4) <> 'rt_v') then
    Exit;
  if E^.Name = 'rt_vshuffle8' then
  begin
    Result := True;
    Exit;
  end;
  for i := 0 to High(E^.Args) do
    if VecHasShuf(E^.Args[i]) then
      Result := True;
end;

{ A reduction of the tree in xmm2 (and xmm3) into rax, in SSE2 or VEX. }
procedure TEmitter.VecReduceX(const Op: string; Sz: LongInt; Vex: Boolean);
var
  x, v: string;
  h: LongInt;
begin
  if Vex then
    v := 'v'
  else
    v := '';
  Line('  xorl %eax, %eax');
  if Op = 'sumu8' then
  begin
    if Vex then
      Line('  vpxor %xmm4, %xmm4, %xmm4')
    else
      Line('  pxor %xmm4, %xmm4');
  end;
  for h := 0 to Sz div 16 - 1 do
  begin
    x := VecX(h);
    if Op = 'movemask8' then
    begin
      Line('  ' + v + 'pmovmskb ' + x + ', %ecx');
      if h = 1 then
        Line('  shll $16, %ecx');
      Line('  orl %ecx, %eax');
    end
    else if Op = 'sums32' then
    begin
      Line('  ' + v + 'movq ' + x + ', %rcx');
      Line('  movslq %ecx, %rdx');
      Line('  addq %rdx, %rax');
      Line('  sarq $32, %rcx');
      Line('  addq %rcx, %rax');
      Line('  ' + v + 'pshufd $238, ' + x + ', %xmm5');
      Line('  ' + v + 'movq %xmm5, %rcx');
      Line('  movslq %ecx, %rdx');
      Line('  addq %rdx, %rax');
      Line('  sarq $32, %rcx');
      Line('  addq %rcx, %rax');
    end
    else
    begin
      if Op = 'sumu8' then
      begin
        if Vex then
          Line('  vpsadbw %xmm4, ' + x + ', ' + x)
        else
          Line('  psadbw %xmm4, ' + x);
      end;
      Line('  ' + v + 'movq ' + x + ', %rcx');
      Line('  addq %rcx, %rax');
      Line('  ' + v + 'pshufd $238, ' + x + ', %xmm5');
      Line('  ' + v + 'movq %xmm5, %rcx');
      Line('  addq %rcx, %rax');
    end;
  end;
end;

{ The end of a statement on amd64, its tree in xmm2 (and xmm3, the high
  half) or ymm2: into a promoted variable's register, stored at Dest (in
  place for a variable, else at the address the first phase pushed or
  that is computed now) or at the scratch slot Off, or reduced into rax
  for VMoveMask8, VSumU8, VSumS32 and VSum64. Inside AVX2's copy of a
  region nothing zeroes the upper halves: promoted V256s live there. }
procedure TEmitter.VecSinkX(E, Dest: PExpr; Off, Sz, Mode: LongInt);
var
  op, h0, h1: string;
  p: LongInt;
begin
  if not VecRed(E) then
  begin
    p := VecPIdx(Dest);
    if (p >= 0) and FVecRootDone then
      Exit;
    if p >= 0 then
    begin
      if Mode = 1 then
        Line('  vmovdqa %ymm2, %ymm' + IntToStr(FVPromo[p].R0))
      else if Mode = 3 then
        Line('  vmovdqa %xmm2, %xmm' + IntToStr(FVPromo[p].R0))
      else
      begin
        Line('  movdqa %xmm2, %xmm' + IntToStr(FVPromo[p].R0));
        if Sz = 32 then
          Line('  movdqa %xmm3, %xmm' + IntToStr(FVPromo[p].R1));
      end;
      Exit;
    end;
    if Dest = nil then
    begin
      h0 := IntToStr(Off) + '(%rbp)';
      h1 := IntToStr(Off + 16) + '(%rbp)';
    end
    else if VecHomeOK(Dest) then
    begin
      h0 := VecHome(Dest, 0);
      h1 := VecHome(Dest, 1);
    end
    else
    begin
      h0 := '';
      if FVecDirect then
        h0 := VecIdxX(Dest, h1);
      if h0 = '' then
      begin
        if FVecDirect then
          EmitAddr(Dest)
        else
          Line('  movq (%rsp), %rax');
        h0 := '(%rax)';
        h1 := '16(%rax)';
      end;
    end;
    if Mode = 1 then
    begin
      Line('  vmovdqu %ymm2, ' + h0);
      if FVecCopy <> 1 then
        Line('  vzeroupper');
    end
    else if Mode = 3 then
      Line('  vmovdqu %xmm2, ' + h0)
    else
    begin
      Line('  movdqu %xmm2, ' + h0);
      if Sz = 32 then
        Line('  movdqu %xmm3, ' + h1);
    end;
    Exit;
  end;
  op := Copy(E^.Name, 5, Length(E^.Name) - 4);
  if Mode = 1 then
  begin
    if op = 'movemask8' then
      Line('  vpmovmskb %ymm2, %eax')
    else
    begin
      Line('  vextracti128 $1, %ymm2, %xmm3');
      VecReduceX(op, 32, True);
    end;
    if FVecCopy <> 1 then
      Line('  vzeroupper');
    Exit;
  end;
  VecReduceX(op, Sz, Mode = 3);
end;

procedure TEmitter.VecSinkA(E, Dest: PExpr; Off, Sz: LongInt);
var
  op, v: string;
  h, p: LongInt;
begin
  if not VecRed(E) then
  begin
    p := VecPIdx(Dest);
    if (p >= 0) and FVecRootDone then
      Exit;
    if p >= 0 then
    begin
      Line('  mov v' + IntToStr(FVPromo[p].R0) + '.16b, v16.16b');
      if Sz = 32 then
        Line('  mov v' + IntToStr(FVPromo[p].R1) + '.16b, v17.16b');
      Exit;
    end;
    if Dest = nil then
      AddFP('x9', Off)
    else if VecHomeOK(Dest) then
      VecHomeA(Dest)
    else if FVecDirect then
    begin
      if not VecIdxA(Dest) then
      begin
        EmitAddr(Dest);
        Line('  mov x9, x0');
      end;
    end
    else
      Line('  ldr x9, [sp]');
    Line('  str q16, [x9]');
    if Sz = 32 then
      Line('  str q17, [x9, #16]');
    Exit;
  end;
  op := Copy(E^.Name, 5, Length(E^.Name) - 4);
  Line('  mov x0, #0');
  for h := 0 to Sz div 16 - 1 do
  begin
    v := 'v' + IntToStr(16 + h);
    if op = 'movemask8' then
    begin
      { NEON has no movemask: each byte's top bit shifted to its place in
        its half and the halves' bytes added }
      Line('  ushr v18.16b, ' + v + '.16b, #7');
      Imm('x9', 506097522914230528);
      Line('  dup v19.2d, x9');
      Line('  ushl v18.16b, v18.16b, v19.16b');
      Line('  addv b20, v18.8b');
      Line('  ext v21.16b, v18.16b, v18.16b, #8');
      Line('  addv b21, v21.8b');
      Line('  umov w10, v20.b[0]');
      Line('  umov w11, v21.b[0]');
      Line('  orr w10, w10, w11, lsl #8');
      if h = 0 then
        Line('  orr x0, x0, x10')
      else
        Line('  orr x0, x0, x10, lsl #16');
    end
    else
    begin
      if op = 'sumu8' then
      begin
        Line('  uaddlv h18, ' + v + '.16b');
        Line('  umov w10, v18.h[0]');
      end
      else if op = 'sums32' then
      begin
        Line('  saddlv d18, ' + v + '.4s');
        Line('  fmov x10, d18');
      end
      else
      begin
        Line('  addp d18, ' + v + '.2d');
        Line('  fmov x10, d18');
      end;
      Line('  add x0, x0, x10');
    end;
  end;
end;

{ E worked out and stored at Dest (a place), or in a scratch slot whose
  address is the value (rax, x0) when Dest is nil; or, for a word that
  gives an Integer, reduced into rax or x0. A statement whose operands
  call nothing has no first phase (1.0.128): each operand is computed
  where it is loaded. amd64 tries AVX2 for a V256, then SSSE3 for a tree
  that shuffles, then SSE2; in a region's copy for AVX2 or SSE2 it takes
  that path alone. }
procedure TEmitter.EmitVecStmt(E, Dest: PExpr);
var
  items: TExprArray;
  n, off, sz: LongInt;
  vroot: PExpr;
  done: string;
  direct: Boolean;
begin
  items := nil;
  off := 0;
  if VecRed(E) then
    vroot := E^.Args[0]
  else
    vroot := E;
  direct := VecPureRoot(E) and ((Dest = nil) or VecDestPure(Dest));
  if not direct then
  begin
    VecCollect(E, items);
    if (Dest <> nil) and not VecHomeOK(Dest) and (VecPIdx(Dest) < 0) then
    begin
      EmitAddr(Dest);
      if FArm then
        PshK('x0', 1)
      else
        PushK('rax', 1);
      n := Length(items);
      SetLength(items, n + 1);
      items[n] := Dest;
    end;
  end;
  if (Dest = nil) and VecOp(E) then
    off := ScratchT(FTypes[E^.Typ].Size, E^.Typ);
  if (not FArm) and VecHasShuf(vroot) then
    FVecScr := ScratchT(48, TyV128);
  FVecDirect := direct;
  FVecItems := items;
  FVecN := Length(items);
  n := FVecN;
  sz := FTypes[vroot^.Typ].Size;
  FVecRootE := vroot;
  FVecDestE := nil;
  if (Dest <> nil) and (VecPIdx(Dest) >= 0) then
    FVecDestE := Dest;
  FVecRootDone := False;
  if FArm then
  begin
    VecTreeA(vroot, 0, 0);
    if sz = 32 then
      VecTreeA(vroot, 1, 1);
    VecSinkA(E, Dest, off, sz);
    if n > 0 then
      Line('  add sp, sp, #' + IntToStr(16 * n));
    if (Dest = nil) and VecOp(E) then
      AddFP('x0', off);
    FVecDirect := False;
    FVecRootE := nil;
    FVecDestE := nil;
    Exit;
  end;
  done := Lab;
  if FVecCopy = 1 then
  begin
    if sz = 32 then
    begin
      VecTreeX(vroot, 0, 0, 1);
      VecSinkX(E, Dest, off, sz, 1);
    end
    else
    begin
      VecTreeX(vroot, 0, 0, 3);
      VecSinkX(E, Dest, off, sz, 3);
    end;
  end
  else if (sz = 32) and (FVecCopy = 0) and HasFeat(13) then
  begin
    { the processor the program is compiled for has AVX2 (-cpu, P111):
      the ymm form alone, nothing tested at run time }
    VecTreeX(vroot, 0, 0, 1);
    VecSinkX(E, Dest, off, sz, 1);
  end
  else if VecHasShuf(vroot) and HasFeat(2) then
  begin
    VecTreeX(vroot, 0, 0, 2);
    if sz = 32 then
      VecTreeX(vroot, 1, 1, 2);
    VecSinkX(E, Dest, off, sz, 2);
  end
  else
  begin
    VecTreeX(vroot, 0, 0, 0);
    if sz = 32 then
      VecTreeX(vroot, 1, 1, 0);
    VecSinkX(E, Dest, off, sz, 0);
  end;
  Line(done + ':');
  if n > 0 then
    Line('  addq $' + IntToStr(8 * n) + ', %rsp');
  if (Dest = nil) and VecOp(E) then
    Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
  FVecDirect := False;
  FVecRootE := nil;
  FVecDestE := nil;
end;

{ v := a vector word, stored straight into v (a variable, a field, an
  element or p^) with no copy through a scratch slot. }
function TEmitter.VecAssign(S: PStmt): Boolean;
begin
  Result := ((S^.Dest <> nil) and VecOp(S^.E) and ((S^.Dest^.Kind = ekVar) or
    (S^.Dest^.Kind = ekField) or (S^.Dest^.Kind = ekIndex) or (S^.Dest^.Kind = ekDeref))) or
    VecCopy(S);
  if Result then
    EmitVecStmt(S^.E, S^.Dest);
end;

function TEmitter.EmitVecFn(E: PExpr): Boolean;
begin
  Result := VecOp(E) or VecRed(E);
  if Result then
    EmitVecStmt(E, nil);
end;

{ ---- the vector registers of a region (P107, 1.0.128) ----

  A region (EmitRegion: statements with no call, a loop's body and all)
  keeps its most used V128 and V256 variables in vector registers, as it
  keeps integers in rbx or x19: loaded before it, stored after, spilled
  and reloaded around rt_morestack in a loop's slow path. A variable is
  a candidate when every use in the region is an operand of a vector
  word or the variable a vector statement assigns, and its address is
  never taken. amd64 gives xmm15 down (at most 8 registers, fewer when a
  statement's tree needs them: the budget is 13 less the deepest tree),
  arm64 v8 to v15, which no tree uses. A V256 on arm64 or in SSE2 takes
  two registers; on amd64 a region that keeps a V256 is emitted twice,
  once for AVX2 with the V256 in a ymm register and every vector
  instruction VEX-encoded, once for SSE2 with it in two xmm registers,
  one bt of rt_cpufeat choosing at its entry. }
function TEmitter.VBase(E: PExpr; B: LongInt): LongInt;
var
  i: SizeInt;
  m: LongInt;
begin
  Result := B;
  if not VecOp(E) then
    Exit;
  for i := 0 to High(E^.Args) do
  begin
    m := VBase(E^.Args[i], B + LongInt(i));
    if m > Result then
      Result := m;
  end;
end;

procedure TEmitter.VNeedE(E: PExpr; var Need: LongInt);
var
  i: SizeInt;
  t: PExpr;
  m: LongInt;
begin
  if E = nil then
    Exit;
  if VecOp(E) or VecRed(E) then
  begin
    if VecOp(E) then
      t := E
    else
      t := E^.Args[0];
    m := VBase(t, 0) + 4;
    if FTypes[t^.Typ].Size = 32 then
      Inc(m);
    if m > Need then
      Need := m;
    Exit;
  end;
  VNeedE(E^.L, Need);
  VNeedE(E^.R, Need);
  for i := 0 to High(E^.Args) do
    VNeedE(E^.Args[i], Need);
end;

procedure TEmitter.VNeedS(S: PStmt; var Need: LongInt);
var
  i: SizeInt;
begin
  if S = nil then
    Exit;
  if (S^.Kind = skAssign) and VecCopy(S) then
  begin
    if Need < 4 + Ord(FTypes[S^.E^.Typ].Size = 32) then
      Need := 4 + Ord(FTypes[S^.E^.Typ].Size = 32);
    Exit;
  end;
  VNeedE(S^.E, Need);
  VNeedE(S^.E2, Need);
  VNeedE(S^.Dest, Need);
  VNeedS(S^.ThenSt, Need);
  VNeedS(S^.ElseSt, Need);
  VNeedS(S^.Body, Need);
  for i := 0 to High(S^.Stmts) do
    VNeedS(S^.Stmts[i], Need);
  for i := 0 to High(S^.Arms) do
    VNeedS(S^.Arms[i].Body, Need);
end;

{ A use of the vector variable N: written or read, weighted by the loops
  around it; Bad when the use is none of a vector word's. }
procedure TEmitter.VAdd(const N: string; W: Boolean; Weight: LongInt; Bad: Boolean);
var
  s: TSym;
  i, k: SizeInt;
begin
  if not TryFindSym(N, s) then
    Exit;
  if (s.Typ <> TyV128) and (s.Typ <> TyV256) then
    Exit;
  if s.ByRef or (s.Up <> 0) or (s.Global and FIsUnit) or AddrTakenSym(s) then
    Bad := True;
  if (not s.Global) and FHasRes and (s.Off = FResOff) then
    Bad := True;
  for i := 0 to High(FVCand) do
    if (FVCand[i].Place.Global = s.Global) and SamePlace(FVCand[i].Place, s) then
    begin
      FVCand[i].Refs := FVCand[i].Refs + Weight;
      if W then
        FVCand[i].Written := True;
      if Bad then
        FVCand[i].Bad := True;
      Exit;
    end;
  k := Length(FVCand);
  SetLength(FVCand, k + 1);
  FVCand[k].Place := s;
  FVCand[k].Typ := s.Typ;
  FVCand[k].R0 := -1;
  FVCand[k].R1 := -1;
  FVCand[k].Written := W;
  FVCand[k].Bad := Bad;
  FVCand[k].Refs := Weight;
end;

procedure TEmitter.VScanTree(E: PExpr; Weight: LongInt);
var
  i: SizeInt;
  a: PExpr;
begin
  for i := 0 to High(E^.Args) do
  begin
    a := E^.Args[i];
    if VecOp(a) then
      VScanTree(a, Weight)
    else if a^.Kind = ekVar then
      VAdd(a^.Name, False, Weight, False)
    else
      VScanE(a, Weight);
  end;
end;

procedure TEmitter.VScanE(E: PExpr; Weight: LongInt);
var
  i: SizeInt;
begin
  if E = nil then
    Exit;
  if VecOp(E) or VecRed(E) then
  begin
    VScanTree(E, Weight);
    Exit;
  end;
  if E^.Kind = ekVar then
    VAdd(E^.Name, False, Weight, True);
  VScanE(E^.L, Weight);
  VScanE(E^.R, Weight);
  for i := 0 to High(E^.Args) do
    VScanE(E^.Args[i], Weight);
end;

procedure TEmitter.VScanS(S: PStmt; Weight: LongInt);
var
  i: SizeInt;
  w: LongInt;
begin
  if S = nil then
    Exit;
  w := Weight;
  if ((S^.Kind = skWhile) or (S^.Kind = skRepeat) or (S^.Kind = skFor)) and
    (w < 100000) then
    w := w * 8;
  if (S^.Kind = skAssign) and VecOp(S^.E) and (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) then
  begin
    VAdd(S^.Dest^.Name, True, w, False);
    VScanTree(S^.E, w);
  end
  else if (S^.Kind = skAssign) and VecCopy(S) and (S^.Dest^.Kind = ekVar) then
  begin
    VAdd(S^.Dest^.Name, True, w, False);
    if S^.E^.Kind = ekVar then
      VAdd(S^.E^.Name, False, w, False)
    else
      VScanE(S^.E, w);
  end
  else
  begin
    if (S^.Kind = skAssign) and (S^.Dest = nil) then
      VAdd(S^.Name, True, w, True);
    VScanE(S^.Dest, w);
    VScanE(S^.E, w);
  end;
  VScanE(S^.E2, w);
  VScanS(S^.ThenSt, w);
  VScanS(S^.ElseSt, w);
  VScanS(S^.Body, w);
  for i := 0 to High(S^.Stmts) do
    VScanS(S^.Stmts[i], w);
  for i := 0 to High(S^.Arms) do
    VScanS(S^.Arms[i].Body, w);
end;

procedure TEmitter.VecChoose(const L: TStmtArray; A, Z: SizeInt);
var
  k, i, j: SizeInt;
  need, avail, used, cost, nx: LongInt;
  t: TVPromo;
begin
  FVPromo := nil;
  FVCand := nil;
  FVecTop := 0;
  for k := A to Z do
    VScanS(L[k], 1);
  need := 0;
  for k := A to Z do
    VNeedS(L[k], need);
  FVecNeed := need;
  for i := 0 to High(FVCand) - 1 do
    for j := i + 1 to High(FVCand) do
      if FVCand[j].Refs > FVCand[i].Refs then
      begin
        t := FVCand[i];
        FVCand[i] := FVCand[j];
        FVCand[j] := t;
      end;
  avail := 8;
  if (not FArm) and (13 - need < avail) then
    avail := 13 - need;
  used := 0;
  if FArm then
    nx := 8
  else
    nx := 15;
  for i := 0 to High(FVCand) do
  begin
    if FVCand[i].Bad or (FVCand[i].Refs < 2) then
      Continue;
    if FVCand[i].Typ = TyV256 then
      cost := 2
    else
      cost := 1;
    if used + cost > avail then
      Continue;
    t := FVCand[i];
    if FArm then
    begin
      t.R0 := nx;
      if cost = 2 then
        t.R1 := nx + 1
      else
        t.R1 := -1;
      nx := nx + cost;
    end
    else if cost = 2 then
    begin
      t.R0 := nx - 1;
      t.R1 := nx;
      nx := nx - 2;
    end
    else
    begin
      t.R0 := nx;
      t.R1 := -1;
      nx := nx - 1;
    end;
    j := Length(FVPromo);
    SetLength(FVPromo, j + 1);
    FVPromo[j] := t;
    used := used + cost;
  end;
  FVCand := nil;
  if not FArm then
    FVecTop := used;
end;

{ Variable I between its home and its registers. }
procedure TEmitter.VecMove(I: SizeInt; Load: Boolean);
var
  s: TSym;
  h0, h1, r0, r1: string;
begin
  s := FVPromo[I].Place;
  if FArm then
  begin
    if s.Global then
      LeaS(VarLabel(s.Name), 'x9')
    else
      AddFP('x9', s.Off);
    if Load then
    begin
      Line('  ldr q' + IntToStr(FVPromo[I].R0) + ', [x9]');
      if FVPromo[I].R1 >= 0 then
        Line('  ldr q' + IntToStr(FVPromo[I].R1) + ', [x9, #16]');
    end
    else
    begin
      Line('  str q' + IntToStr(FVPromo[I].R0) + ', [x9]');
      if FVPromo[I].R1 >= 0 then
        Line('  str q' + IntToStr(FVPromo[I].R1) + ', [x9, #16]');
    end;
    Exit;
  end;
  if s.Global then
  begin
    h0 := VarLabel(s.Name) + '+0(%rip)';
    h1 := VarLabel(s.Name) + '+16(%rip)';
  end
  else
  begin
    h0 := IntToStr(s.Off) + '(%rbp)';
    h1 := IntToStr(s.Off + 16) + '(%rbp)';
  end;
  if FVecCopy = 1 then
  begin
    if FVPromo[I].Typ = TyV256 then
      r0 := '%ymm' + IntToStr(FVPromo[I].R0)
    else
      r0 := '%xmm' + IntToStr(FVPromo[I].R0);
    if Load then
      Line('  vmovdqu ' + h0 + ', ' + r0)
    else
      Line('  vmovdqu ' + r0 + ', ' + h0);
    Exit;
  end;
  r0 := '%xmm' + IntToStr(FVPromo[I].R0);
  r1 := '%xmm' + IntToStr(FVPromo[I].R1);
  if Load then
  begin
    Line('  movdqu ' + h0 + ', ' + r0);
    if FVPromo[I].R1 >= 0 then
      Line('  movdqu ' + h1 + ', ' + r1);
  end
  else
  begin
    Line('  movdqu ' + r0 + ', ' + h0);
    if FVPromo[I].R1 >= 0 then
      Line('  movdqu ' + r1 + ', ' + h1);
  end;
end;

procedure TEmitter.VecLoadAll;
var
  i: SizeInt;
begin
  for i := 0 to High(FVPromo) do
    VecMove(i, True);
end;

{ The written ones back home; before rt_morestack in AVX2's copy the
  upper halves go too (vzeroupper), so the routine that runs next pays
  no SSE-AVX transition. }
procedure TEmitter.VecStoreAll(Spill: Boolean);
var
  i: SizeInt;
begin
  for i := 0 to High(FVPromo) do
    if FVPromo[i].Written then
      VecMove(i, False);
  if Spill and (FVecCopy = 1) and (Length(FVPromo) > 0) then
    Line('  vzeroupper');
end;

procedure TEmitter.VecRegionBody(const L: TStmtArray; A, Z: SizeInt);
var
  k, i: SizeInt;
  wide: Boolean;
begin
  { every region with vector statements has a copy for AVX2: V256 in ymm,
    and V128 in VEX's three operands with SSE4.1's instructions (pmulld,
    pminsb, pcmpeqq), which SSE2 only emulates }
  wide := FVecNeed > 0;
  for i := 0 to High(FVPromo) do
    if FVPromo[i].Typ = TyV256 then
      wide := True;
  if (not FArm) and wide then
  begin
    { the copy the processor the program is compiled for takes (-cpu,
      P111): AVX2's, or SSE's; the other is not written }
    if HasFeat(13) then
      FVecCopy := 1
    else
      FVecCopy := 2;
    VecLoadAll;
    for k := A to Z do
      EmitStmt(L[k]);
    VecStoreAll(False);
    if FVecCopy = 1 then
      Line('  vzeroupper');
    FVecCopy := 0;
  end
  else
  begin
    VecLoadAll;
    for k := A to Z do
      EmitStmt(L[k]);
    VecStoreAll(False);
  end;
end;

{ CpuHas, CpuFeatures, CycleCount and CycleFreq (P106, 1.0.124): one
  bit of rt_cpufeat; the word; rdtsc (edx:eax) or cntvct_el0; cntfrq_el0,
  or rt_cyclefreq on amd64, whose counter has no register for its rate. }
{ Carry and the rotation and shift family (P108, 1.0.129). Carry is the
  byte at G+256 of the running routine (r14 on amd64, x28 on arm64), so
  each routine has its own, kept across calls, 0 when it starts.

  rt_rot(x, n, kind, N) works on N bits of x (8, 16, 32 or 64), n times:
    1 RotateLeftToCarry, 2 RotateRightToCarry: circular, the bit that
      came round last copied to Carry (bit 0, or bit N-1, of the result);
    3 RotateLeftThroughCarry, 4 RotateRightThroughCarry: Carry is bit N
      of a ring of N+1 bits, turned n mod (N+1) places;
    5 ShiftLeft, 6 ShiftRight, 7 ShiftRightSigned: Carry untouched;
    8 ShiftLeftToCarry, 9 ShiftRightToCarry, 10 ShiftRightSignedToCarry:
      the last bit out goes to Carry.
  rt_funnel(hi, lo, n, 20 or 21, N) is the top N bits of hi:lo shifted
  left n, or the low N bits of hi:lo shifted right n.

  n <= 0 changes nothing, value or Carry; a count past the width is
  exact (a shift gives 0 or the sign, 0 goes to Carry once the bits
  run out), never the processor's count taken modulo 32 or 64.

  amd64 works in the value's own width (rolb on al, rclw on ax), so the
  bits above N never matter; the result is then made its type's again.
  rax, rcx, rdx, rsi and r8 only: r9-r13 and r15 may hold promoted
  variables. arm64 keeps the value zero-extended in x0 (sign-extended
  for the Signed words), x9-x14 as scratch. }

function RotSfx(N: LongInt): string;
begin
  if N = 8 then
    Result := 'b'
  else if N = 16 then
    Result := 'w'
  else if N = 32 then
    Result := 'l'
  else
    Result := 'q';
end;

{ The constant forms on amd64, on Opnd (a register of width N or a
  memory operand of N bits); Cn >= 1. }
procedure TEmitter.RotX86K(Kind, N: LongInt; Cn: Int64; const Opnd: string);
var
  s: string;
  k: Int64;
  left: Boolean;
begin
  s := RotSfx(N);
  case Kind of
    1, 2:
      begin
        k := Cn mod N;
        if k <> 0 then
        begin
          { rol leaves the bit that came round in CF: bit 0 of the
            result; ror bit N-1. }
          if Kind = 1 then
            Line('  rol' + s + ' $' + IntToStr(k) + ', ' + Opnd)
          else
            Line('  ror' + s + ' $' + IntToStr(k) + ', ' + Opnd);
          Line('  setc ' + CarryM(1));
        end
        else
          RotBitX86(N, Kind = 1, Opnd);
      end;
    3, 4:
      begin
        k := Cn mod (N + 1);
        if k = 0 then
          Exit;
        left := Kind = 3;
        { N places round a ring of N+1 is one the other way: rcl and
          rcr by 1 are fast, by more they are microcode. }
        if k = N then
        begin
          left := not left;
          k := 1;
        end;
        Line('  btl $0, ' + CarryM(4));
        if left then
          Line('  rcl' + s + ' $' + IntToStr(k) + ', ' + Opnd)
        else
          Line('  rcr' + s + ' $' + IntToStr(k) + ', ' + Opnd);
        Line('  setc ' + CarryM(1));
      end;
    5, 6:
      if Cn >= N then
        Line('  mov' + s + ' $0, ' + Opnd)
      else if Kind = 5 then
        Line('  shl' + s + ' $' + IntToStr(Cn) + ', ' + Opnd)
      else
        Line('  shr' + s + ' $' + IntToStr(Cn) + ', ' + Opnd);
    7:
      begin
        k := Cn;
        if k > N - 1 then
          k := N - 1;
        Line('  sar' + s + ' $' + IntToStr(k) + ', ' + Opnd);
      end;
    8, 9:
      if Cn > N then
      begin
        Line('  mov' + s + ' $0, ' + Opnd);
        Line('  movb $0, ' + CarryM(1));
      end
      else
      begin
        { n-1 places, then the last one alone: its bit is CF, and a
          count of N (64) never reaches the processor. }
        if Kind = 8 then
        begin
          if Cn > 1 then
            Line('  shl' + s + ' $' + IntToStr(Cn - 1) + ', ' + Opnd);
          Line('  shl' + s + ' $1, ' + Opnd);
        end
        else
        begin
          if Cn > 1 then
            Line('  shr' + s + ' $' + IntToStr(Cn - 1) + ', ' + Opnd);
          Line('  shr' + s + ' $1, ' + Opnd);
        end;
        Line('  setc ' + CarryM(1));
      end;
    10:
      begin
        k := Cn;
        if k > N then
          k := N;
        if k > 1 then
          Line('  sar' + s + ' $' + IntToStr(k - 1) + ', ' + Opnd);
        Line('  sar' + s + ' $1, ' + Opnd);
        Line('  setc ' + CarryM(1));
      end;
  end;
end;

{ Carry := bit 0 (Low) or bit N-1 of Opnd. }
procedure TEmitter.RotBitX86(N: LongInt; LowHalf: Boolean; const Opnd: string);
begin
  if N = 8 then
  begin
    if LowHalf then
      Line('  testb $1, ' + Opnd)
    else
      Line('  testb $128, ' + Opnd);
    Line('  setne ' + CarryM(1));
    Exit;
  end;
  if LowHalf then
    Line('  bt' + RotSfx(N) + ' $0, ' + Opnd)
  else
    Line('  bt' + RotSfx(N) + ' $' + IntToStr(N - 1) + ', ' + Opnd);
  Line('  setc ' + CarryM(1));
end;

{ The forms with a count in rcx, on the value in rax. }
procedure TEmitter.RotX86V(Kind, N: LongInt);
var
  s, r, done, lk, one: string;
begin
  s := RotSfx(N);
  r := '%' + X86Sub('rax', N div 8);
  done := Lab;
  Line('  testq %rcx, %rcx');
  Line('  jle ' + done);
  case Kind of
    1, 2:
      begin
        { The processor takes the count modulo 32 or 64 and a rotation
          of 8 or 16 bits modulo 8 or 16: n mod N in every width. }
        if Kind = 1 then
          Line('  rol' + s + ' %cl, ' + r)
        else
          Line('  ror' + s + ' %cl, ' + r);
        RotBitX86(N, Kind = 1, r);
      end;
    3, 4:
      begin
        lk := Lab;
        Line('  cmpq $' + IntToStr(N) + ', %rcx');
        Line('  jbe ' + lk);
        Line('  movq %rax, %r8');
        Line('  movq %rcx, %rax');
        Line('  xorl %edx, %edx');
        Line('  movl $' + IntToStr(N + 1) + ', %esi');
        Line('  divq %rsi');
        Line('  movq %rdx, %rcx');
        Line('  movq %r8, %rax');
        Line(lk + ':');
        one := '';
        if N >= 32 then
        begin
          { N places (32 or 64) are past the processor's count. }
          one := Lab;
          Line('  cmpl $' + IntToStr(N) + ', %ecx');
          Line('  je ' + one);
        end;
        Line('  btl $0, ' + CarryM(4));
        if Kind = 3 then
          Line('  rcl' + s + ' %cl, ' + r)
        else
          Line('  rcr' + s + ' %cl, ' + r);
        Line('  setc ' + CarryM(1));
        if one <> '' then
        begin
          Line('  jmp ' + done);
          Line(one + ':');
          Line('  btl $0, ' + CarryM(4));
          if Kind = 3 then
            Line('  rcr' + s + ' $1, ' + r)
          else
            Line('  rcl' + s + ' $1, ' + r);
          Line('  setc ' + CarryM(1));
        end;
      end;
    5, 6:
      begin
        Line('  xorl %edx, %edx');
        if Kind = 5 then
          Line('  shl' + s + ' %cl, ' + r)
        else
          Line('  shr' + s + ' %cl, ' + r);
        Line('  cmpq $' + IntToStr(N) + ', %rcx');
        Line('  cmovaeq %rdx, %rax');
      end;
    7:
      begin
        Line('  movl $' + IntToStr(N - 1) + ', %edx');
        Line('  cmpq %rdx, %rcx');
        Line('  cmovaq %rdx, %rcx');
        Line('  sar' + s + ' %cl, ' + r);
      end;
    8, 9:
      begin
        lk := Lab;
        Line('  cmpq $' + IntToStr(N) + ', %rcx');
        Line('  ja ' + lk);
        Line('  decl %ecx');
        if Kind = 8 then
        begin
          Line('  shl' + s + ' %cl, ' + r);
          Line('  shl' + s + ' $1, ' + r);
        end
        else
        begin
          Line('  shr' + s + ' %cl, ' + r);
          Line('  shr' + s + ' $1, ' + r);
        end;
        Line('  setc ' + CarryM(1));
        Line('  jmp ' + done);
        Line(lk + ':');
        Line('  xorl %eax, %eax');
        Line('  movb $0, ' + CarryM(1));
      end;
    10:
      begin
        Line('  movl $' + IntToStr(N) + ', %edx');
        Line('  cmpq %rdx, %rcx');
        Line('  cmovaq %rdx, %rcx');
        Line('  decl %ecx');
        Line('  sar' + s + ' %cl, ' + r);
        Line('  sar' + s + ' $1, ' + r);
        Line('  setc ' + CarryM(1));
      end;
  end;
  Line(done + ':');
end;

{ x0 from its low N bits: zero-extended, or sign-extended (Sgn). }
procedure TEmitter.RotExtArm(const R: string; N: LongInt; Sgn: Boolean);
var
  w: string;
begin
  if N >= 64 then
    Exit;
  w := 'w' + Copy(R, 2, 8);
  if Sgn then
  begin
    if N = 8 then
      Line('  sxtb ' + R + ', ' + w)
    else if N = 16 then
      Line('  sxth ' + R + ', ' + w)
    else
      Line('  sxtw ' + R + ', ' + w);
  end
  else if N = 8 then
    Line('  uxtb ' + w + ', ' + w)
  else if N = 16 then
    Line('  uxth ' + w + ', ' + w)
  else
    Line('  mov ' + w + ', ' + w);
end;

{ A rotation of N bits right by R places, R a register or '#k'; a byte
  or a halfword is repeated through w0 first, so a 32-bit ror turns it
  modulo its own width. }
procedure TEmitter.RorArm(N: LongInt; const R: string);
begin
  if N = 64 then
    Line('  ror x0, x0, ' + R)
  else
  begin
    if N = 8 then
      Line('  orr w0, w0, w0, lsl #8');
    if N <= 16 then
      Line('  orr w0, w0, w0, lsl #16');
    Line('  ror w0, w0, ' + R);
    if N = 8 then
      Line('  and w0, w0, #0xff')
    else if N = 16 then
      Line('  and w0, w0, #0xffff');
  end;
end;

{ Carry := bit 0 (Low) or bit N-1 of x0. }
procedure TEmitter.RotBitArm(N: LongInt; LowHalf: Boolean);
begin
  if LowHalf then
    Line('  and w9, w0, #1')
  else
    Line('  ubfx x9, x0, #' + IntToStr(N - 1) + ', #1');
  CarrySt('w9');
end;

{ The ring of N+1 bits turned left Kl places (x1, or the constant when
  Kl > 0), 1 <= places <= N. }
procedure TEmitter.RingArm(N: LongInt; Kl: Int64);
begin
  if N < 64 then
  begin
    CarryLd('w9');
    Line('  orr x0, x0, x9, lsl #' + IntToStr(N));
    if Kl > 0 then
    begin
      Line('  lsl x10, x0, #' + IntToStr(Kl));
      Line('  lsr x11, x0, #' + IntToStr(N + 1 - Kl));
    end
    else
    begin
      Line('  lsl x10, x0, x1');
      Line('  mov x11, #' + IntToStr(N + 1));
      Line('  sub x11, x11, x1');
      Line('  lsr x11, x0, x11');
    end;
    Line('  orr x0, x10, x11');
    Line('  ubfx x9, x0, #' + IntToStr(N) + ', #1');
    CarrySt('w9');
    Exit;
  end;
  { 65 bits: v << k, Carry << (k-1) and v >> (65-k), the new Carry bit
    64-k of v; each shift below 64. }
  CarryLd('w9');
  if Kl = 1 then
  begin
    Line('  lsr x10, x0, #63');
    Line('  orr x0, x9, x0, lsl #1');
  end
  else if Kl = 64 then
  begin
    Line('  and x10, x0, #1');
    Line('  lsr x0, x0, #1');
    Line('  orr x0, x0, x9, lsl #63');
  end
  else if Kl > 0 then
  begin
    Line('  ubfx x10, x0, #' + IntToStr(64 - Kl) + ', #1');
    Line('  lsr x11, x0, #' + IntToStr(65 - Kl));
    Line('  lsl x0, x0, #' + IntToStr(Kl));
    Line('  orr x0, x0, x11');
    Line('  orr x0, x0, x9, lsl #' + IntToStr(Kl - 1));
  end
  else
  begin
    Line('  sub x12, x1, #1');
    Line('  mov x11, #64');
    Line('  sub x11, x11, x1');
    Line('  lsr x13, x0, x11');
    Line('  and x10, x13, #1');
    Line('  lsr x13, x13, #1');
    Line('  lsl x14, x0, x12');
    Line('  lsl x14, x14, #1');
    Line('  lsl x9, x9, x12');
    Line('  orr x0, x14, x13');
    Line('  orr x0, x0, x9');
  end;
  CarrySt('w10');
end;

{ The constant forms on arm64, on x0; Cn >= 1. }
procedure TEmitter.RotArmK(Kind, N: LongInt; Cn: Int64);
var
  k: Int64;
begin
  case Kind of
    1, 2:
      begin
        k := Cn mod N;
        if k <> 0 then
          if Kind = 1 then
            RorArm(N, '#' + IntToStr(N - k))
          else
            RorArm(N, '#' + IntToStr(k));
        RotBitArm(N, Kind = 1);
      end;
    3, 4:
      begin
        k := Cn mod (N + 1);
        if k = 0 then
          Exit;
        if Kind = 4 then
          k := N + 1 - k;
        RingArm(N, k);
      end;
    5, 6:
      if Cn >= N then
        Line('  mov x0, xzr')
      else if Kind = 5 then
        Line('  lsl x0, x0, #' + IntToStr(Cn))
      else
        Line('  lsr x0, x0, #' + IntToStr(Cn));
    7:
      begin
        k := Cn;
        if k > 63 then
          k := 63;
        Line('  asr x0, x0, #' + IntToStr(k));
      end;
    8, 9:
      if Cn > N then
      begin
        Line('  mov x0, xzr');
        CarrySt('wzr');
      end
      else
      begin
        if Kind = 8 then
          Line('  ubfx x9, x0, #' + IntToStr(N - Cn) + ', #1')
        else
          Line('  ubfx x9, x0, #' + IntToStr(Cn - 1) + ', #1');
        if Cn >= 64 then
          Line('  mov x0, xzr')
        else if Kind = 8 then
          Line('  lsl x0, x0, #' + IntToStr(Cn))
        else
          Line('  lsr x0, x0, #' + IntToStr(Cn));
        CarrySt('w9');
      end;
    10:
      begin
        k := Cn;
        if k > N then
          k := N;
        Line('  ubfx x9, x0, #' + IntToStr(k - 1) + ', #1');
        if k > 63 then
          k := 63;
        Line('  asr x0, x0, #' + IntToStr(k));
        CarrySt('w9');
      end;
  end;
end;

{ The forms with a count in x1, on x0. }
procedure TEmitter.RotArmV(Kind, N: LongInt);
var
  done, lk: string;
begin
  done := Lab;
  Line('  cmp x1, #0');
  Line('  b.le ' + done);
  case Kind of
    1, 2:
      begin
        if Kind = 1 then
        begin
          if N = 64 then
          begin
            Line('  neg x9, x1');
            RorArm(N, 'x9');
          end
          else
          begin
            Line('  neg w9, w1');
            RorArm(N, 'w9');
          end;
        end
        else if N = 64 then
          RorArm(N, 'x1')
        else
          RorArm(N, 'w1');
        RotBitArm(N, Kind = 1);
      end;
    3, 4:
      begin
        lk := Lab;
        Line('  cmp x1, #' + IntToStr(N));
        Line('  b.ls ' + lk);
        Line('  mov x9, #' + IntToStr(N + 1));
        Line('  udiv x10, x1, x9');
        Line('  msub x1, x10, x9, x1');
        Line(lk + ':');
        Line('  cbz x1, ' + done);
        if Kind = 4 then
        begin
          Line('  mov x9, #' + IntToStr(N + 1));
          Line('  sub x1, x9, x1');
        end;
        RingArm(N, 0);
      end;
    5, 6:
      begin
        if Kind = 5 then
          Line('  lsl x9, x0, x1')
        else
          Line('  lsr x9, x0, x1');
        Line('  cmp x1, #64');
        Line('  csel x0, x9, xzr, lo');
      end;
    7:
      begin
        Line('  mov x9, #63');
        Line('  cmp x1, x9');
        Line('  csel x1, x9, x1, hi');
        Line('  asr x0, x0, x1');
      end;
    8, 9:
      begin
        Line('  sub x11, x1, #1');
        if Kind = 8 then
        begin
          Line('  mov x9, #' + IntToStr(N));
          Line('  sub x9, x9, x1');
          Line('  lsr x10, x0, x9');
          Line('  and x10, x10, #1');
          Line('  lsl x0, x0, x11');
          Line('  lsl x0, x0, #1');
        end
        else
        begin
          Line('  lsr x0, x0, x11');
          Line('  and x10, x0, #1');
          Line('  lsr x0, x0, #1');
        end;
        Line('  cmp x1, #' + IntToStr(N));
        Line('  csel x0, x0, xzr, ls');
        Line('  csel x10, x10, xzr, ls');
        CarrySt('w10');
      end;
    10:
      begin
        Line('  mov x9, #' + IntToStr(N));
        Line('  cmp x1, x9');
        Line('  csel x1, x9, x1, hi');
        Line('  sub x11, x1, #1');
        Line('  asr x0, x0, x11');
        Line('  and x10, x0, #1');
        Line('  asr x0, x0, #1');
        CarrySt('w10');
      end;
  end;
  Line(done + ':');
end;

{ The funnels on amd64: hi in rax, lo in rdx, the count in rcx unless
  Known (then Cn). }
procedure TEmitter.FunnelX86(Kind, N: LongInt; Known: Boolean; Cn: Int64);
var
  done, big, l1: string;
begin
  done := Lab;
  if N = 64 then
  begin
    if Known then
    begin
      if Cn <= 0 then
      begin
        if Kind = 21 then
          Line('  movq %rdx, %rax');
      end
      else if Cn < 64 then
      begin
        if Kind = 20 then
          Line('  shldq $' + IntToStr(Cn) + ', %rdx, %rax')
        else
        begin
          Line('  shrdq $' + IntToStr(Cn) + ', %rax, %rdx');
          Line('  movq %rdx, %rax');
        end;
      end
      else if Cn < 128 then
      begin
        if Kind = 20 then
        begin
          Line('  movq %rdx, %rax');
          if Cn > 64 then
            Line('  shlq $' + IntToStr(Cn - 64) + ', %rax');
        end
        else if Cn > 64 then
          Line('  shrq $' + IntToStr(Cn - 64) + ', %rax');
      end
      else
        Line('  xorl %eax, %eax');
      Exit;
    end;
    big := Lab;
    Line('  testq %rcx, %rcx');
    if Kind = 20 then
      Line('  jle ' + done)
    else
    begin
      l1 := Lab;
      Line('  jg ' + l1);
      Line('  movq %rdx, %rax');
      Line('  jmp ' + done);
      Line(l1 + ':');
    end;
    Line('  cmpq $64, %rcx');
    Line('  jae ' + big);
    if Kind = 20 then
      Line('  shldq %cl, %rdx, %rax')
    else
    begin
      Line('  shrdq %cl, %rax, %rdx');
      Line('  movq %rdx, %rax');
    end;
    Line('  jmp ' + done);
    Line(big + ':');
    if Kind = 20 then
    begin
      Line('  movq %rdx, %rax');
      Line('  shlq %cl, %rax');
    end
    else
      Line('  shrq %cl, %rax');
    Line('  xorl %edx, %edx');
    Line('  cmpq $128, %rcx');
    Line('  cmovaeq %rdx, %rax');
    Line(done + ':');
    Exit;
  end;
  { N <= 32: hi:lo is one 64-bit number, shifted once. }
  if Known then
  begin
    if Cn <= 0 then
    begin
      if Kind = 21 then
        Line('  movq %rdx, %rax');
    end
    else if Cn >= 2 * N then
      Line('  xorl %eax, %eax')
    else
    begin
      RotZExtX86('rax', N);
      RotZExtX86('rdx', N);
      Line('  shlq $' + IntToStr(N) + ', %rax');
      Line('  orq %rdx, %rax');
      if Kind = 20 then
      begin
        Line('  shlq $' + IntToStr(Cn) + ', %rax');
        Line('  shrq $' + IntToStr(N) + ', %rax');
      end
      else
        Line('  shrq $' + IntToStr(Cn) + ', %rax');
    end;
    Exit;
  end;
  Line('  testq %rcx, %rcx');
  if Kind = 20 then
    Line('  jle ' + done)
  else
  begin
    l1 := Lab;
    Line('  jg ' + l1);
    Line('  movq %rdx, %rax');
    Line('  jmp ' + done);
    Line(l1 + ':');
  end;
  RotZExtX86('rax', N);
  RotZExtX86('rdx', N);
  Line('  shlq $' + IntToStr(N) + ', %rax');
  Line('  orq %rdx, %rax');
  Line('  xorl %edx, %edx');
  if Kind = 20 then
  begin
    Line('  shlq %cl, %rax');
    Line('  shrq $' + IntToStr(N) + ', %rax');
  end
  else
    Line('  shrq %cl, %rax');
  Line('  cmpq $64, %rcx');
  Line('  cmovaeq %rdx, %rax');
  Line(done + ':');
end;

procedure TEmitter.RotZExtX86(const R: string; N: LongInt);
begin
  if N = 8 then
    Line('  movzbl %' + X86Sub(R, 1) + ', %' + X86Sub(R, 4))
  else if N = 16 then
    Line('  movzwl %' + X86Sub(R, 2) + ', %' + X86Sub(R, 4))
  else if N = 32 then
    Line('  movl %' + X86Sub(R, 4) + ', %' + X86Sub(R, 4));
end;

{ The funnels on arm64: hi in x0, lo in x2, the count in x1 unless
  Known. }
procedure TEmitter.FunnelArm(Kind, N: LongInt; Known: Boolean; Cn: Int64);
var
  done, big, l1: string;
begin
  done := Lab;
  if N = 64 then
  begin
    if Known then
    begin
      if Cn <= 0 then
      begin
        if Kind = 21 then
          Line('  mov x0, x2');
      end
      else if Cn < 64 then
      begin
        { extr is hi:lo shifted right, 64 bits of it }
        if Kind = 20 then
          Line('  extr x0, x0, x2, #' + IntToStr(64 - Cn))
        else
          Line('  extr x0, x0, x2, #' + IntToStr(Cn));
      end
      else if Cn < 128 then
      begin
        if Kind = 20 then
          Line('  lsl x0, x2, #' + IntToStr(Cn - 64))
        else
          Line('  lsr x0, x0, #' + IntToStr(Cn - 64));
      end
      else
        Line('  mov x0, xzr');
      Exit;
    end;
    big := Lab;
    Line('  cmp x1, #0');
    if Kind = 20 then
      Line('  b.le ' + done)
    else
    begin
      l1 := Lab;
      Line('  b.gt ' + l1);
      Line('  mov x0, x2');
      Line('  b ' + done);
      Line(l1 + ':');
    end;
    Line('  cmp x1, #64');
    Line('  b.hs ' + big);
    if Kind = 20 then
    begin
      Line('  lsl x0, x0, x1');
      Line('  neg x9, x1');
      Line('  lsr x9, x2, x9');
    end
    else
    begin
      Line('  lsr x9, x2, x1');
      Line('  neg x10, x1');
      Line('  lsl x0, x0, x10');
    end;
    Line('  orr x0, x0, x9');
    Line('  b ' + done);
    Line(big + ':');
    if Kind = 20 then
      Line('  lsl x0, x2, x1')
    else
      Line('  lsr x0, x0, x1');
    Line('  cmp x1, #128');
    Line('  csel x0, x0, xzr, lo');
    Line(done + ':');
    Exit;
  end;
  if Known then
  begin
    if Cn <= 0 then
    begin
      if Kind = 21 then
        Line('  mov x0, x2');
    end
    else if Cn >= 2 * N then
      Line('  mov x0, xzr')
    else
    begin
      RotExtArm('x0', N, False);
      RotExtArm('x2', N, False);
      Line('  orr x0, x2, x0, lsl #' + IntToStr(N));
      if Kind = 20 then
      begin
        Line('  lsl x0, x0, #' + IntToStr(Cn));
        Line('  lsr x0, x0, #' + IntToStr(N));
      end
      else
        Line('  lsr x0, x0, #' + IntToStr(Cn));
    end;
    Exit;
  end;
  Line('  cmp x1, #0');
  if Kind = 20 then
    Line('  b.le ' + done)
  else
  begin
    l1 := Lab;
    Line('  b.gt ' + l1);
    Line('  mov x0, x2');
    Line('  b ' + done);
    Line(l1 + ':');
  end;
  RotExtArm('x0', N, False);
  RotExtArm('x2', N, False);
  Line('  orr x0, x2, x0, lsl #' + IntToStr(N));
  if Kind = 20 then
  begin
    Line('  lsl x0, x0, x1');
    Line('  lsr x0, x0, #' + IntToStr(N));
  end
  else
    Line('  lsr x0, x0, x1');
  Line('  cmp x1, #64');
  Line('  csel x0, x0, xzr, lo');
  Line(done + ':');
end;

function IsSgnNarrow(T: LongInt): Boolean;
begin
  Result := (T = TyInt8) or (T = TyInt16) or (T = TyInt32);
end;

{ The result as its type holds it: N bits, sign-extended for Int8,
  Int16 and Int32, else zero-extended. }
procedure TEmitter.RotTail(T, N: LongInt);
var
  r: string;
begin
  if N >= 64 then
    Exit;
  if FArm then
    r := 'x0'
  else
    r := 'rax';
  if IsNarrowId(T) then
    CanonReg(r, T)
  else if FArm then
    RotExtArm(r, N, False)
  else
    RotZExtX86(r, N);
end;

function TEmitter.EmitRotFn(E: PExpr): Boolean;
var
  kind, n: LongInt;
  cn: Int64;
  known: Boolean;
  c: PExpr;
begin
  Result := False;
  if (E^.Name <> 'rt_rot') and (E^.Name <> 'rt_funnel') and (E^.Name <> 'rt_carry') and
    (E^.Name <> 'rt_carryon') and (E^.Name <> 'rt_carryoff') and
    (E^.Name <> 'rt_carryflip') and (E^.Name <> 'rt_setcarry') and
    (E^.Name <> 'rt_rotm') and (E^.Name <> 'rt_funnelm') then
    Exit;
  Result := True;
  if (E^.Name = 'rt_rotm') or (E^.Name = 'rt_funnelm') then
  begin
    EmitRotMem(E);
    Exit;
  end;
  if E^.Name = 'rt_carry' then
  begin
    if FArm then
      CarryLd('w0')
    else
      Line('  movzbl ' + CarryM(1) + ', %eax');
    Exit;
  end;
  if E^.Name = 'rt_carryon' then
  begin
    if FArm then
    begin
      Line('  mov w9, #1');
      CarrySt('w9');
    end
    else
      Line('  movb $1, ' + CarryM(1));
    Exit;
  end;
  if E^.Name = 'rt_carryoff' then
  begin
    if FArm then
      CarrySt('wzr')
    else
      Line('  movb $0, ' + CarryM(1));
    Exit;
  end;
  if E^.Name = 'rt_carryflip' then
  begin
    if FArm then
    begin
      CarryLd('w9');
      Line('  eor w9, w9, #1');
      CarrySt('w9');
    end
    else
      Line('  xorb $1, ' + CarryM(1));
    Exit;
  end;
  if E^.Name = 'rt_setcarry' then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      Line('  tst w0, #0xff');
      Line('  cset w9, ne');
      CarrySt('w9');
    end
    else
    begin
      Line('  testb %al, %al');
      Line('  setne ' + CarryM(1));
    end;
    Exit;
  end;
  if E^.Name = 'rt_funnel' then
  begin
    c := E^.Args[2];
    kind := LongInt(E^.Args[3]^.Num);
    n := LongInt(E^.Args[4]^.Num);
    known := c^.Kind = ekInt;
    cn := c^.Num;
    if not known then
    begin
      EmitExpr(c);
      if FArm then PshK('x0', 0) else PushK('rax', 0);
    end;
    EmitExpr(E^.Args[1]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      Ppop('x2');
      if not known then
        Ppop('x1');
      FunnelArm(kind, n, known, cn);
    end
    else
    begin
      Line('  popq %rdx');
      if not known then
        Line('  popq %rcx');
      FunnelX86(kind, n, known, cn);
    end;
    RotTail(E^.Typ, n);
    Exit;
  end;
  c := E^.Args[1];
  kind := LongInt(E^.Args[2]^.Num);
  n := LongInt(E^.Args[3]^.Num);
  known := c^.Kind = ekInt;
  cn := c^.Num;
  if known and (cn <= 0) then
  begin
    EmitExpr(E^.Args[0]);
    Exit;
  end;
  if not known then
  begin
    EmitExpr(c);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
  end;
  EmitExpr(E^.Args[0]);
  if FArm then
  begin
    if not known then
      Ppop('x1');
    RotExtArm('x0', n, (kind = 7) or (kind = 10));
    if known then
      RotArmK(kind, n, cn)
    else
      RotArmV(kind, n);
  end
  else
  begin
    if not known then
      Line('  popq %rcx');
    if known then
      RotX86K(kind, n, cn, '%' + X86Sub('rax', n div 8))
    else
      RotX86V(kind, n);
  end;
  { amd64 worked in the value's own width: only a signed one needs its
    upper bits again. }
  if FArm or IsSgnNarrow(E^.Typ) then
    RotTail(E^.Typ, n);
end;

{ The rotation words on a value bigger than a register, a string or a
  slice (P108, 1.0.130). Each operand waits in a scratch slot of its own
  type, where the collector sees a string's characters; the result gets
  a block of its own (a scratch slot, a new string, a new slice); and
  pasheap's PasRotMem does the work: rdi/x0 the result, rsi/x1 the
  operand, rdx/x2 a funnel's lo, rcx/x3 the bytes, r8/x4 the word plus
  256 times Carry, r9/x5 the count; the new Carry comes back in al/w0.
  Cls: 0 a record, an array or a vector (its address), 1 a Quad (two
  words), 2 a string, 3 a slice. }
procedure TEmitter.EmitRotMem(E: PExpr);
var
  fun, known: Boolean;
  t, cls, esz, kind, nsrc, i, slot, s0, s1, sn, sd: LongInt;
  cnt: PExpr;
  cn: Int64;
  ok: string;
begin
  fun := E^.Name = 'rt_funnelm';
  t := E^.Args[0]^.Typ;
  if fun then
  begin
    cnt := E^.Args[2];
    kind := LongInt(E^.Args[3]^.Num);
    nsrc := 2;
  end
  else
  begin
    cnt := E^.Args[1];
    kind := LongInt(E^.Args[2]^.Num);
    nsrc := 1;
  end;
  if TKind(t) = tykQuad then
    cls := 1
  else if IsStr(t) then
    cls := 2
  else if IsDyn(t) then
    cls := 3
  else
    cls := 0;
  esz := 1;
  if cls = 3 then
    esz := TSize(FTypes[t].Elem);
  known := cnt^.Kind = ekInt;
  cn := cnt^.Num;
  sn := 0;
  s0 := 0;
  s1 := 0;
  if not known then
  begin
    EmitExpr(cnt);
    sn := ScratchT(8, TyInteger);
    if FArm then
      StFP('x0', sn)
    else
      Line('  movq %rax, ' + IntToStr(sn) + '(%rbp)');
  end;
  for i := 0 to nsrc - 1 do
  begin
    EmitExpr(E^.Args[i]);
    if cls = 0 then
      slot := ScratchT(8, TyPointer)
    else if cls = 3 then
      slot := ScratchT(24, t)
    else
      slot := ScratchT(16, t);
    if FArm then
    begin
      StFP('x0', slot);
      if cls > 0 then
        StFP('x2', slot + 8);
      if cls = 3 then
        StFP('x3', slot + 16);
    end
    else
    begin
      Line('  movq %rax, ' + IntToStr(slot) + '(%rbp)');
      if cls > 0 then
        Line('  movq %rdx, ' + IntToStr(slot + 8) + '(%rbp)');
      if cls = 3 then
        Line('  movq %r8, ' + IntToStr(slot + 16) + '(%rbp)');
    end;
    if i = 0 then
      s0 := slot
    else
      s1 := slot;
  end;
  { a funnel's two strings or slices have one length }
  if fun and (cls >= 2) then
  begin
    ok := Lab;
    if FArm then
    begin
      LdFP('x0', s0 + 8);
      LdFP('x1', s1 + 8);
      Line('  cmp x0, x1');
      ColdBegin('  b.ne');
      ScaleTo('x0', 'x0', esz, 'x9');
      ScaleTo('x1', 'x1', esz, 'x9');
      Line('  bl rt_funnelfail');
      ColdEnd;
    end
    else
    begin
      Line('  movq ' + IntToStr(s0 + 8) + '(%rbp), %rdi');
      Line('  movq ' + IntToStr(s1 + 8) + '(%rbp), %rsi');
      Line('  cmpq %rsi, %rdi');
      ColdBegin('  jne');
      ScaleTo('%rdi', '%rdi', esz, '');
      ScaleTo('%rsi', '%rsi', esz, '');
      Line('  call rt_funnelfail');
      ColdEnd;
    end;
    Line(ok + ':');
  end;
  { the result's own block }
  if cls = 0 then
    sd := ScratchT(TSize(t), t)
  else if cls = 1 then
    sd := ScratchT(16, t)
  else
  begin
    if FArm then
    begin
      LdFP('x0', s0 + 8);
      if cls = 2 then
        Line('  bl rt_stralloc')
      else
      begin
        ScaleTo('x0', 'x0', esz, 'x9');
        Line('  mov x1, xzr');
        Line('  bl rt_alloc');
      end;
    end
    else
    begin
      Line('  movq ' + IntToStr(s0 + 8) + '(%rbp), %rdi');
      if cls = 2 then
        Line('  call rt_stralloc')
      else
      begin
        ScaleTo('%rdi', '%rdi', esz, '%rsi');
        Line('  xorl %esi, %esi');
        Line('  call rt_alloc');
      end;
    end;
    if cls = 2 then
      sd := ScratchT(16, t)
    else
      sd := ScratchT(24, t);
    if FArm then
    begin
      StFP('x0', sd);
      LdFP('x9', s0 + 8);
      StFP('x9', sd + 8);
      if cls = 3 then
        StFP('x9', sd + 16);
    end
    else
    begin
      Line('  movq %rax, ' + IntToStr(sd) + '(%rbp)');
      Line('  movq ' + IntToStr(s0 + 8) + '(%rbp), %rcx');
      Line('  movq %rcx, ' + IntToStr(sd + 8) + '(%rbp)');
      if cls = 3 then
        Line('  movq %rcx, ' + IntToStr(sd + 16) + '(%rbp)');
    end;
  end;
  if FArm then
  begin
    if cls <= 1 then
      AddFP('x0', sd)
    else
      LdFP('x0', sd);
    if cls = 0 then
      LdFP('x1', s0)
    else if cls = 1 then
      AddFP('x1', s0)
    else
      LdFP('x1', s0);
    if not fun then
      Line('  mov x2, xzr')
    else if cls = 0 then
      LdFP('x2', s1)
    else if cls = 1 then
      AddFP('x2', s1)
    else
      LdFP('x2', s1);
    if cls = 0 then
      Imm('x3', TSize(t))
    else if cls = 1 then
      Imm('x3', 16)
    else
    begin
      LdFP('x3', s0 + 8);
      ScaleTo('x3', 'x3', esz, 'x9');
    end;
    CarryLd('w4');
    Imm('x9', kind);
    Line('  orr x4, x9, x4, lsl #8');
    if known then
      Imm('x5', cn)
    else
      LdFP('x5', sn);
    Line('  bl p_pasheap_pasrotmem');
    if (kind <= 4) or ((kind >= 8) and (kind <= 10)) then
      CarrySt('w0');
    if cls = 0 then
      AddFP('x0', sd)
    else
    begin
      LdFP('x0', sd);
      LdFP('x2', sd + 8);
      if cls = 3 then
        LdFP('x3', sd + 16);
    end;
    Exit;
  end;
  if cls <= 1 then
    Line('  leaq ' + IntToStr(sd) + '(%rbp), %rdi')
  else
    Line('  movq ' + IntToStr(sd) + '(%rbp), %rdi');
  if cls = 1 then
    Line('  leaq ' + IntToStr(s0) + '(%rbp), %rsi')
  else
    Line('  movq ' + IntToStr(s0) + '(%rbp), %rsi');
  if not fun then
    Line('  xorl %edx, %edx')
  else if cls = 1 then
    Line('  leaq ' + IntToStr(s1) + '(%rbp), %rdx')
  else
    Line('  movq ' + IntToStr(s1) + '(%rbp), %rdx');
  if cls = 0 then
    Line('  movq $' + IntToStr(TSize(t)) + ', %rcx')
  else if cls = 1 then
    Line('  movq $16, %rcx')
  else
  begin
    Line('  movq ' + IntToStr(s0 + 8) + '(%rbp), %rcx');
    ScaleTo('%rcx', '%rcx', esz, '%r8');
  end;
  Line('  movzbl ' + CarryM(1) + ', %r8d');
  Line('  shll $8, %r8d');
  Line('  orl $' + IntToStr(kind) + ', %r8d');
  if not known then
    Line('  movq ' + IntToStr(sn) + '(%rbp), %r9')
  else if (cn >= -2147483647) and (cn <= 2147483647) then
    Line('  movq $' + IntToStr(cn) + ', %r9')
  else
    Line('  movabsq $' + IntToStr(cn) + ', %r9');
  Line('  call p_pasheap_pasrotmem');
  if (kind <= 4) or ((kind >= 8) and (kind <= 10)) then
    Line('  movb %al, ' + CarryM(1));
  if cls = 0 then
    Line('  leaq ' + IntToStr(sd) + '(%rbp), %rax')
  else
  begin
    Line('  movq ' + IntToStr(sd) + '(%rbp), %rax');
    Line('  movq ' + IntToStr(sd + 8) + '(%rbp), %rdx');
    if cls = 3 then
      Line('  movq ' + IntToStr(sd + 16) + '(%rbp), %r8');
  end;
end;

{ Carry in a promoted region (1.0.130): a loop that uses it keeps it in
  a register, 0 or 1, as it keeps a variable (PromoAddCarry, Part 9);
  the words then set, test and read that register. CarryReg is it, or
  '' outside such a region; CarryM is Carry as an amd64 operand of W
  bytes, the register or G+256; CarryLd and CarrySt move it on arm64. }
function TEmitter.CarryReg: string;
var
  i: SizeInt;
begin
  Result := '';
  if not FPromoOn then
    Exit;
  for i := 0 to High(FPromo) do
    if FPromo[i].Part = 9 then
    begin
      Result := FPromo[i].Reg;
      Exit;
    end;
end;

function TEmitter.CarryM(W: LongInt): string;
var
  r: string;
begin
  r := CarryReg;
  if r = '' then
    Result := '256(%r14)'
  else
    Result := '%' + X86Sub(r, W);
end;

procedure TEmitter.CarryLd(const W: string);
var
  r: string;
begin
  r := CarryReg;
  if r = '' then
    Line('  ldrb ' + W + ', [x28, #256]')
  else
    Line('  mov ' + W + ', w' + Copy(r, 2, 8));
end;

procedure TEmitter.CarrySt(const W: string);
var
  r: string;
begin
  r := CarryReg;
  if r = '' then
    Line('  strb ' + W + ', [x28, #256]')
  else
    Line('  mov w' + Copy(r, 2, 8) + ', ' + W);
end;

{ d := word(d, k) on amd64 for d an element, a field or a dereference:
  its address once, the word on the memory there (rclq $1 on a[i]),
  as InPlaceMem does for d := d + k. }
function TEmitter.RotInPlaceMem(S: PStmt): Boolean;
var
  d, e, c: PExpr;
  t, n: LongInt;
  m: string;
begin
  Result := False;
  if FArm or (S = nil) or (S^.Dest = nil) or (S^.E = nil) then
    Exit;
  d := S^.Dest;
  e := S^.E;
  if (d^.Kind <> ekIndex) and (d^.Kind <> ekField) and (d^.Kind <> ekDeref) then
    Exit;
  if (d^.Kind = ekIndex) and (d^.L <> nil) and IsStr(d^.L^.Typ) then
    Exit;
  if (e^.Kind <> ekCall) or (e^.Name <> 'rt_rot') or (Length(e^.Args) <> 4) then
    Exit;
  c := e^.Args[1];
  if c^.Kind <> ekInt then
    Exit;
  if not SameExpr(d, e^.Args[0]) then
    Exit;
  t := LoadTyp(d);
  if not (IsIntId(t) or (t = TyChar)) or (e^.Typ <> t) then
    Exit;
  n := LongInt(e^.Args[3]^.Num);
  if n <> TSize(t) * 8 then
    Exit;
  if not WordMemOK(d, 1) then
    Exit;
  Result := True;
  m := EmitWordMem(d, 1);
  if c^.Num > 0 then
    RotX86K(LongInt(e^.Args[2]^.Num), n, c^.Num, m);
end;

{ Append (P109, 1.0.132): s := Append(s, a, b) or Append(s, u) for a
  slice u of s's type, and a slice literal [a, b] (Append of nil). The
  elements are stored one by one into the hidden array the parser gave
  (Args[1]) with the assignment's own code, so a string, a record or a
  narrow value goes as it would by :=; the slice waits in a scratch slot
  of its type and rt_append grows it as SetLength does, in place only
  from its block's frontier, so no other slice of the block sees the new
  elements, then copies them after the old ones. }
procedure TEmitter.EmitAppend(E: PExpr);
var
  t, et, esz, k, i, slot, su: LongInt;
  isSlice: Boolean;
  smap: string;
begin
  t := E^.Typ;
  et := FTypes[t].Elem;
  esz := TSize(et);
  isSlice := E^.Name = 'rt_appendslice';
  su := 0;
  k := 0;
  if isSlice then
  begin
    EmitExpr(E^.Args[1]);
    su := ScratchT(24, t);
    if FArm then
    begin
      StFP('x0', su);
      StFP('x2', su + 8);
      StFP('x3', su + 16);
    end
    else
    begin
      Line('  movq %rax, ' + IntToStr(su) + '(%rbp)');
      Line('  movq %rdx, ' + IntToStr(su + 8) + '(%rbp)');
      Line('  movq %r8, ' + IntToStr(su + 16) + '(%rbp)');
    end;
  end
  else
  begin
    k := Length(E^.Args) - 2;
    for i := 0 to k - 1 do
    begin
      EmitExpr(E^.Args[i + 2]);
      FStoreSrc := E^.Args[i + 2];
      StoreTo(NewIndex(E^.Args[1], NewInt(i), et));
      FStoreSrc := nil;
    end;
  end;
  slot := ScratchT(24, t);
  if E^.Args[0]^.Kind = ekNil then
  begin
    if FArm then
    begin
      StFP('xzr', slot);
      StFP('xzr', slot + 8);
      StFP('xzr', slot + 16);
    end
    else
    begin
      Line('  movq $0, ' + IntToStr(slot) + '(%rbp)');
      Line('  movq $0, ' + IntToStr(slot + 8) + '(%rbp)');
      Line('  movq $0, ' + IntToStr(slot + 16) + '(%rbp)');
    end;
  end
  else
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      StFP('x0', slot);
      StFP('x2', slot + 8);
      StFP('x3', slot + 16);
    end
    else
    begin
      Line('  movq %rax, ' + IntToStr(slot) + '(%rbp)');
      Line('  movq %rdx, ' + IntToStr(slot + 8) + '(%rbp)');
      Line('  movq %r8, ' + IntToStr(slot + 16) + '(%rbp)');
    end;
  end;
  { the source: the hidden array, or u }
  if (not isSlice) and (k > 0) then
    EmitAddr(E^.Args[1]);
  smap := StrMap(et);
  if FArm then
  begin
    if isSlice then
    begin
      LdFP('x1', su);
      LdFP('x2', su + 8);
    end
    else
    begin
      if k > 0 then
        Line('  mov x1, x0')
      else
        Line('  mov x1, xzr');
      Imm('x2', k);
    end;
    AddFP('x0', slot);
    Imm('x3', esz);
    GcArg(GcWord(et), 'x4');
    if smap <> '' then
      LeaS(smap, 'x5')
    else
      Line('  mov x5, xzr');
    Line('  bl rt_append');
    LdFP('x0', slot);
    LdFP('x2', slot + 8);
    LdFP('x3', slot + 16);
    Exit;
  end;
  if isSlice then
  begin
    Line('  movq ' + IntToStr(su) + '(%rbp), %rsi');
    Line('  movq ' + IntToStr(su + 8) + '(%rbp), %rdx');
  end
  else
  begin
    if k > 0 then
      Line('  movq %rax, %rsi')
    else
      Line('  xorl %esi, %esi');
    Line('  movq $' + IntToStr(k) + ', %rdx');
  end;
  Line('  leaq ' + IntToStr(slot) + '(%rbp), %rdi');
  Line('  movq $' + IntToStr(esz) + ', %rcx');
  GcArg(GcWord(et), 'r8');
  if smap <> '' then
    Line('  leaq ' + smap + '(%rip), %r9')
  else
    Line('  xorq %r9, %r9');
  Line('  call rt_append');
  Line('  movq ' + IntToStr(slot) + '(%rbp), %rax');
  Line('  movq ' + IntToStr(slot + 8) + '(%rbp), %rdx');
  Line('  movq ' + IntToStr(slot + 16) + '(%rbp), %r8');
end;

{ The box of a routine with a closure inside (P109, 1.0.134): a heap
  block whose first word is the routine's own link and whose fields are
  the variables its nested routines use (Pr.Shared), each 8-byte
  aligned. The box's address is the block's plus 8, so -8 of it is the
  link and a nested routine walks boxes and frames alike. A parameter's
  value is copied in; every shared variable's slot then holds its
  field's address and the routine reaches it as it reaches a var
  parameter's, so no other code changes. Its nested routines get the
  box as their link (EmitLink), and see the variable at its field. The
  collector scans the block conservatively. }
procedure TEmitter.BoxSetup(const Pr: TProc);
var
  i, j, off, box: LongInt;
  isPar: Boolean;
  offs: array of LongInt;
  idx: array of SizeInt;
begin
  FBoxSlot := 0;
  if not Pr.Boxing then
    Exit;
  box := FindSym('$box').Off;
  offs := nil;
  idx := nil;
  off := 0;
  for i := 0 to High(Pr.Shared) do
    for j := High(FSym) downto 0 do
      if (not FSym[j].Global) and (FSym[j].Up = 0) and SameSym(FSym[j].Name, Pr.Shared[i]) then
      begin
        SetLength(offs, Length(offs) + 1);
        SetLength(idx, Length(idx) + 1);
        offs[High(offs)] := off;
        idx[High(idx)] := j;
        off := off + Align8(SlotSize(FSym[j].Typ));
        Break;
      end;
  { a box with no field (a routine whose closures share none of its own
    variables) still needs a word after the link (1.0.136): $box is the
    block's address plus 8, and one past an 8-byte block is no pointer
    into it, so the collector freed the box under the closure }
  if off = 0 then
    off := 8;
  if FArm then
  begin
    Imm('x0', off + 8);
    GcArg('1', 'x1');
    Line('  bl rt_alloc');
    if Pr.Nest > 0 then
    begin
      LdFP('x9', -8);
      Line('  str x9, [x0]');
    end;
    Line('  add x0, x0, #8');
    StFP('x0', box);
  end
  else
  begin
    Line('  movq $' + IntToStr(off + 8) + ', %rdi');
    GcArg('1', 'rsi');
    Line('  call rt_alloc');
    if Pr.Nest > 0 then
    begin
      Line('  movq -8(%rbp), %rcx');
      Line('  movq %rcx, (%rax)');
    end;
    Line('  leaq 8(%rax), %rax');
    Line('  movq %rax, ' + IntToStr(box) + '(%rbp)');
  end;
  for i := 0 to High(idx) do
  begin
    j := idx[i];
    isPar := SameSym(FSym[j].Name, 'self');
    for off := 0 to High(Pr.Params) do
      if SameSym(Pr.Params[off].Name, FSym[j].Name) then
        isPar := True;
    if FArm then
    begin
      if isPar then
      begin
        LdFP('x9', FSym[j].Off);
        Imm('x10', offs[i]);
        Line('  str x9, [x0, x10]');
      end;
      AddImmArmT('x9', 'x0', offs[i], 'x10');
      StFP('x9', FSym[j].Off);
    end
    else
    begin
      if isPar then
      begin
        Line('  movq ' + IntToStr(FSym[j].Off) + '(%rbp), %rdx');
        Line('  movq %rdx, ' + IntToStr(offs[i]) + '(%rax)');
      end;
      Line('  leaq ' + IntToStr(offs[i]) + '(%rax), %rdx');
      Line('  movq %rdx, ' + IntToStr(FSym[j].Off) + '(%rbp)');
    end;
    FSym[j].ByRef := True;
    FSym[j].Boxed := True;
    FSym[j].BoxOff := offs[i];
  end;
  FBoxSlot := box;
end;

{ A closure's value (1.0.134): its code and the link its parent gives
  its nested routines (the parent's box). One that pins cells gets a
  scope box of its own: the parent's link at -8, then each pinned cell's
  address as it is now, so each pass's closure keeps its pass's cell. }
procedure TEmitter.EmitClosure(E: PExpr);
var
  i, k: SizeInt;
  pr: TProc;
  found: Boolean;
begin
  found := False;
  pr := Default(TProc);
  for i := 0 to High(FProgProcs) do
    if FProgProcs[i].Sym = E^.Name then
    begin
      pr := FProgProcs[i];
      found := True;
      Break;
    end;
  if not found then
    pr.Nest := ProcNest(E^.Name);
  if Length(pr.Pins) = 0 then
  begin
    if FArm then
    begin
      if pr.Nest > 0 then
      begin
        EmitLink(pr.Nest);
        Line('  mov x2, x27');
      end
      else
        Line('  mov x2, xzr');
      LeaS(E^.Name, 'x0');
    end
    else
    begin
      if pr.Nest > 0 then
      begin
        EmitLink(pr.Nest);
        Line('  movq %r10, %rdx');
      end
      else
        Line('  xorl %edx, %edx');
      Line('  leaq ' + E^.Name + '(%rip), %rax');
    end;
    Exit;
  end;
  k := Length(pr.Pins);
  if FArm then
  begin
    Imm('x0', 8 + 8 * k);
    GcArg('1', 'x1');
    Line('  bl rt_alloc');
    PshK('x0', 1);
    if pr.Nest > 1 then
    begin
      EmitLink(pr.Nest - 1);
      Line('  ldr x0, [sp]');
      Line('  str x27, [x0]');
    end;
    for i := 0 to k - 1 do
    begin
      LoadVar(pr.Pins[i]);
      Line('  ldr x9, [sp]');
      Imm('x10', 8 + 8 * i);
      Line('  str x0, [x9, x10]');
    end;
    Ppop('x2');
    Line('  add x2, x2, #8');
    LeaS(E^.Name, 'x0');
    Exit;
  end;
  Line('  movq $' + IntToStr(8 + 8 * k) + ', %rdi');
  GcArg('1', 'rsi');
  Line('  call rt_alloc');
  PushK('rax', 1);
  if pr.Nest > 1 then
  begin
    EmitLink(pr.Nest - 1);
    Line('  movq (%rsp), %rax');
    Line('  movq %r10, (%rax)');
  end;
  for i := 0 to k - 1 do
  begin
    LoadVar(pr.Pins[i]);
    Line('  movq (%rsp), %rcx');
    Line('  movq %rax, ' + IntToStr(8 + 8 * i) + '(%rcx)');
  end;
  Line('  popq %rdx');
  Line('  leaq 8(%rdx), %rdx');
  Line('  leaq ' + E^.Name + '(%rip), %rax');
end;

{ x := word(x, k) on amd64 with k a constant, x a variable of this
  routine or a global: the instruction works on x where it is (rclb $1
  on its byte, shlq $3 on its register). }
function TEmitter.RotInPlace(S: PStmt): Boolean;
var
  d: TSym;
  e, c: PExpr;
  n, kind: LongInt;
  k: Int64;
  op, sfx: string;
begin
  Result := False;
  if FArm or (S = nil) or (S^.Dest = nil) or (S^.E = nil) or (S^.Dest^.Kind <> ekVar) then
    Exit;
  e := S^.E;
  { x := x rol k and x := x ror k with a constant count (1.1.1): the
    rotation on x where it is, as the words below; it was a move to a
    temporary, the turn and a move back in every hash loop }
  if (e^.Kind = ekBin) and ((e^.Bin = boRol) or (e^.Bin = boRor)) and (e^.L <> nil) and
    (e^.R <> nil) and (e^.L^.Kind = ekVar) and (e^.L^.Name = S^.Dest^.Name) and
    (e^.R^.Kind = ekInt) then
  begin
    if not TryFindSym(S^.Dest^.Name, d) then
      Exit;
    if d.ByRef or (d.Up > 0) or (not IsIntId(d.Typ)) or (e^.Typ <> d.Typ) or
      (e^.L^.Typ <> d.Typ) then
      Exit;
    n := IntBits(d.Typ);
    k := e^.R^.Num mod n;
    if k < 0 then
      k := k + n;
    Result := True;
    if k = 0 then
      Exit;
    if e^.Bin = boRol then
      op := 'rol'
    else
      op := 'ror';
    if n = 8 then
      sfx := 'b'
    else if n = 16 then
      sfx := 'w'
    else if n = 32 then
      sfx := 'l'
    else
      sfx := 'q';
    if d.Reg <> '' then
    begin
      Line('  ' + op + sfx + ' $' + IntToStr(k) + ', %' + X86Sub(d.Reg, n div 8));
      CanonReg(d.Reg, d.Typ);
    end
    else
      Line('  ' + op + sfx + ' $' + IntToStr(k) + ', ' + MemA(d));
    Exit;
  end;
  if (e^.Kind <> ekCall) or (e^.Name <> 'rt_rot') or (Length(e^.Args) <> 4) then
    Exit;
  if (e^.Args[0]^.Kind <> ekVar) or (e^.Args[0]^.Name <> S^.Dest^.Name) then
    Exit;
  c := e^.Args[1];
  if c^.Kind <> ekInt then
    Exit;
  if not TryFindSym(S^.Dest^.Name, d) then
    Exit;
  if d.ByRef or (d.Up > 0) then
    Exit;
  if not (IsIntId(d.Typ) or (d.Typ = TyChar)) or (e^.Typ <> d.Typ) or
    (e^.Args[0]^.Typ <> d.Typ) then
    Exit;
  kind := LongInt(e^.Args[2]^.Num);
  n := LongInt(e^.Args[3]^.Num);
  if n <> IntBits(d.Typ) then
    Exit;
  Result := True;
  if c^.Num <= 0 then
    Exit;
  if d.Reg <> '' then
  begin
    RotX86K(kind, n, c^.Num, '%' + X86Sub(d.Reg, n div 8));
    if IsSgnNarrow(d.Typ) then
      CanonReg(d.Reg, d.Typ);
  end
  else
    RotX86K(kind, n, c^.Num, MemA(d));
end;

function TEmitter.EmitCpuFn(E: PExpr): Boolean;
begin
  Result := False;
  if (E^.Name <> 'rt_cpuhas') and (E^.Name <> 'rt_cpufeatures') and
    (E^.Name <> 'rt_cyclecount') and (E^.Name <> 'rt_cyclefreq') then
    Exit;
  Result := True;
  if E^.Name = 'rt_cyclecount' then
  begin
    if FArm then
      Line('  mrs x0, cntvct_el0')
    else
    begin
      Line('  rdtsc');
      Line('  shlq $32, %rdx');
      Line('  orq %rdx, %rax');
    end;
    Exit;
  end;
  if E^.Name = 'rt_cyclefreq' then
  begin
    if FArm then
      Line('  mrs x0, cntfrq_el0')
    else
      Line('  call rt_cyclefreq');
    Exit;
  end;
  if FArm then
    LdS('rt_cpufeat', 'x0')
  else
    Line('  movq rt_cpufeat(%rip), %rax');
  if E^.Name = 'rt_cpuhas' then
    if FArm then
      Line('  ubfx x0, x0, #' + IntToStr(E^.Args[0]^.Num) + ', #1')
    else
    begin
      Line('  shrq $' + IntToStr(E^.Args[0]^.Num) + ', %rax');
      Line('  andl $1, %eax');
    end;
end;

{ One of rt_cpuinit's bits on amd64: bit Src of cpuid's register R into
  bit Dst of r8, and-ed with a gate register (0 or 1) when the feature
  needs what the kernel saves. r10 is the scratch. }
procedure TEmitter.CpuBitX(const R: string; Src, Dst: LongInt; const Gate: string);
begin
  Line('  movl %' + R + ', %r10d');
  Line('  shrl $' + IntToStr(Src) + ', %r10d');
  if Gate = '' then
    Line('  andl $1, %r10d')
  else
    Line('  andl %' + Gate + ', %r10d');
  Line('  shlq $' + IntToStr(Dst) + ', %r10');
  Line('  orq %r10, %r8');
end;

function TEmitter.EmitAtomicFn(E: PExpr): Boolean;
var
  t, sz: LongInt;
  lp, sfx, ra, rc, r8, op: string;
begin
  Result := False;
  if (E^.Name <> 'rt_aload') and (E^.Name <> 'rt_axchg') and (E^.Name <> 'rt_aand') and
    (E^.Name <> 'rt_aor') and (E^.Name <> 'rt_axor') then
    Exit;
  Result := True;
  t := LongInt(E^.Args[High(E^.Args)]^.Num);
  sz := TSize(t);
  if E^.Name = 'rt_aload' then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      if sz = 1 then
        Line('  ldarb w0, [x0]')
      else if sz = 2 then
        Line('  ldarh w0, [x0]')
      else if sz = 4 then
        Line('  ldar w0, [x0]')
      else
        Line('  ldar x0, [x0]');
      CanonReg('x0', t);
    end
    else
    begin
      if sz = 1 then
        Line('  movzbl (%rax), %eax')
      else if sz = 2 then
        Line('  movzwl (%rax), %eax')
      else if sz = 4 then
        Line('  movl (%rax), %eax')
      else
        Line('  movq (%rax), %rax');
      CanonReg('rax', t);
    end;
    Exit;
  end;
  EmitExpr(E^.Args[1]);
  if FArm then PshK('x0', 0) else PushK('rax', 0);
  EmitExpr(E^.Args[0]);
  if FArm then
  begin
    Ppop('x1');
    if sz = 1 then
      sfx := 'b'
    else if sz = 2 then
      sfx := 'h'
    else
      sfx := '';
    if sz = 8 then
    begin
      ra := 'x2';
      rc := 'x4';
      r8 := 'x1';
    end
    else
    begin
      ra := 'w2';
      rc := 'w4';
      r8 := 'w1';
    end;
    lp := Lab;
    Line(lp + ':');
    Line('  ldaxr' + sfx + ' ' + ra + ', [x0]');
    if E^.Name = 'rt_axchg' then
      op := r8
    else
    begin
      if E^.Name = 'rt_aand' then
        Line('  and ' + rc + ', ' + ra + ', ' + r8)
      else if E^.Name = 'rt_aor' then
        Line('  orr ' + rc + ', ' + ra + ', ' + r8)
      else
        Line('  eor ' + rc + ', ' + ra + ', ' + r8);
      op := rc;
    end;
    Line('  stlxr' + sfx + ' w3, ' + op + ', [x0]');
    Line('  cbnz w3, ' + lp);
    Line('  mov x0, x2');
    if sz < 8 then
      Line('  and x0, x0, #' + IntToStr((Int64(1) shl (8 * sz)) - 1));
    CanonReg('x0', t);
    Exit;
  end;
  Line('  movq %rax, %rcx');
  Line('  popq %rdx');
  if sz = 1 then
    sfx := 'b'
  else if sz = 2 then
    sfx := 'w'
  else if sz = 4 then
    sfx := 'l'
  else
    sfx := 'q';
  if E^.Name = 'rt_axchg' then
  begin
    Line('  xchg' + sfx + ' %' + X86Sub('rdx', sz) + ', (%rcx)');
    Line('  movq %rdx, %rax');
  end
  else
  begin
    if sz = 1 then
      Line('  movzbl (%rcx), %eax')
    else if sz = 2 then
      Line('  movzwl (%rcx), %eax')
    else if sz = 4 then
      Line('  movl (%rcx), %eax')
    else
      Line('  movq (%rcx), %rax');
    lp := Lab;
    Line(lp + ':');
    Line('  movq %rax, %r8');
    if E^.Name = 'rt_aand' then
      op := 'and'
    else if E^.Name = 'rt_aor' then
      op := 'or'
    else
      op := 'xor';
    Line('  ' + op + 'q %rdx, %r8');
    Line('  lock cmpxchg' + sfx + ' %' + X86Sub('r8', sz) + ', (%rcx)');
    Line('  jne ' + lp);
  end;
  if sz = 1 then
    Line('  movzbl %al, %eax')
  else if sz = 2 then
    Line('  movzwl %ax, %eax')
  else if sz = 4 then
    Line('  movl %eax, %eax');
  CanonReg('rax', t);
end;

{ The words of P106 put in line (1.0.121): AddCarry and SubBorrow with
  the carry in the flag (adc/sbb after neg sets it; adcs/sbcs after a
  compare), the carry out stored at the width of its variable; the
  overflow checks, true when the 64-bit operation overflowed or its
  result does not fit the variable's type; AddSat and SubSat, clamped
  to the type's range (a 64-bit overflow gives the end on the side of
  the first operand). The operands are pushed and taken back in rax,
  rdx, rcx (x0, x1, x2); the last is an address, never pushed. }
function TEmitter.EmitWideFn(E: PExpr): Boolean;
var
  ok, op: string;
  t, sz: LongInt;
  lo, hi: Int64;
begin
  Result := False;
  if (E^.Name <> 'rt_addc') and (E^.Name <> 'rt_subb') and (E^.Name <> 'rt_addo') and
    (E^.Name <> 'rt_subo') and (E^.Name <> 'rt_mulo') and (E^.Name <> 'rt_addsat') and
    (E^.Name <> 'rt_subsat') then
    Exit;
  Result := True;
  if (E^.Name = 'rt_addc') or (E^.Name = 'rt_subb') then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(E^.Args[1]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(E^.Args[2]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(E^.Args[3]);
    sz := LongInt(E^.Args[4]^.Num);
    if FArm then
    begin
      Line('  mov x3, x0');
      Ppop('x2');
      Ppop('x1');
      Ppop('x0');
      if E^.Name = 'rt_addc' then
      begin
        Line('  cmp x2, #1');
        Line('  adcs x0, x0, x1');
        Line('  cset x9, cs');
      end
      else
      begin
        Line('  cmp xzr, x2');
        Line('  sbcs x0, x0, x1');
        Line('  cset x9, cc');
      end;
      StoreWidth('x9', 'x3', sz);
    end
    else
    begin
      Line('  movq %rax, %r8');
      Line('  popq %rcx');
      Line('  popq %rdx');
      Line('  popq %rax');
      Line('  negq %rcx');
      if E^.Name = 'rt_addc' then
        Line('  adcq %rdx, %rax')
      else
        Line('  sbbq %rdx, %rax');
      Line('  setc %cl');
      Line('  movzbl %cl, %ecx');
      StoreWidth('rcx', 'r8', sz);
    end;
    Exit;
  end;
  EmitExpr(E^.Args[0]);
  if FArm then PshK('x0', 0) else PushK('rax', 0);
  EmitExpr(E^.Args[1]);
  t := LongInt(E^.Args[2]^.Num);
  if (E^.Name = 'rt_addsat') or (E^.Name = 'rt_subsat') then
  begin
    ok := Lab;
    if FArm then
    begin
      Line('  mov x1, x0');
      Ppop('x0');
      if IsNarrowId(t) then
      begin
        if E^.Name = 'rt_addsat' then
          Line('  add x0, x0, x1')
        else
          Line('  sub x0, x0, x1');
      end
      else
      begin
        Line('  mov x9, x0');
        if E^.Name = 'rt_addsat' then
          Line('  adds x0, x0, x1')
        else
          Line('  subs x0, x0, x1');
        Line('  b.vc ' + ok);
        Line('  asr x9, x9, #63');
        Line('  eor x0, x9, #0x7fffffffffffffff');
        Line(ok + ':');
      end;
    end
    else
    begin
      Line('  movq %rax, %rdx');
      Line('  popq %rax');
      if IsNarrowId(t) then
      begin
        if E^.Name = 'rt_addsat' then
          Line('  addq %rdx, %rax')
        else
          Line('  subq %rdx, %rax');
      end
      else
      begin
        Line('  movq %rax, %rcx');
        if E^.Name = 'rt_addsat' then
          Line('  addq %rdx, %rax')
        else
          Line('  subq %rdx, %rax');
        Line('  jno ' + ok);
        Line('  sarq $63, %rcx');
        Line('  btcq $63, %rcx');
        Line('  notq %rcx');
        Line('  movq %rcx, %rax');
        Line(ok + ':');
      end;
    end;
    if IsNarrowId(t) then
    begin
      { in the narrow type's range: the 64-bit sum is exact }
      sz := TSize(t) * 8;
      if (t = TyInt8) or (t = TyInt16) or (t = TyInt32) then
      begin
        lo := -(Int64(1) shl (sz - 1));
        hi := (Int64(1) shl (sz - 1)) - 1;
      end
      else
      begin
        lo := 0;
        hi := (Int64(1) shl sz) - 1;
      end;
      if FArm then
      begin
        Imm('x9', hi);
        Line('  cmp x0, x9');
        Line('  csel x0, x9, x0, gt');
        Imm('x9', lo);
        Line('  cmp x0, x9');
        Line('  csel x0, x9, x0, lt');
      end
      else
      begin
        LoadImmR('rcx', hi);
        Line('  cmpq %rcx, %rax');
        Line('  cmovgq %rcx, %rax');
        LoadImmR('rcx', lo);
        Line('  cmpq %rcx, %rax');
        Line('  cmovlq %rcx, %rax');
      end;
    end;
    Exit;
  end;
  { AddOverflow, SubOverflow, MulOverflow: Args[2] is the address. }
  if FArm then PshK('x0', 0) else PushK('rax', 0);
  EmitExpr(E^.Args[2]);
  t := LongInt(E^.Args[3]^.Num);
  if FArm then
  begin
    Line('  mov x3, x0');
    Ppop('x1');
    Ppop('x0');
    if E^.Name = 'rt_mulo' then
    begin
      Line('  mul x10, x0, x1');
      Line('  smulh x11, x0, x1');
      Line('  cmp x11, x10, asr #63');
      Line('  cset x9, ne');
      Line('  mov x0, x10');
    end
    else
    begin
      if E^.Name = 'rt_addo' then
        Line('  adds x0, x0, x1')
      else
        Line('  subs x0, x0, x1');
      Line('  cset x9, vs');
    end;
    if IsNarrowId(t) then
    begin
      Line('  mov x10, x0');
      CanonReg('x10', t);
      Line('  cmp x10, x0');
      Line('  cset x11, ne');
      Line('  orr x9, x9, x11');
    end;
    StoreWidth('x0', 'x3', TSize(t));
    Line('  mov x0, x9');
  end
  else
  begin
    Line('  movq %rax, %r8');
    Line('  popq %rdx');
    Line('  popq %rax');
    if E^.Name = 'rt_addo' then
      op := 'addq'
    else if E^.Name = 'rt_subo' then
      op := 'subq'
    else
      op := 'imulq';
    Line('  ' + op + ' %rdx, %rax');
    Line('  seto %sil');
    if IsNarrowId(t) then
    begin
      Line('  movq %rax, %rcx');
      CanonReg('rcx', t);
      Line('  cmpq %rax, %rcx');
      Line('  setne %dil');
      Line('  orb %dil, %sil');
    end;
    StoreWidth('rax', 'r8', TSize(t));
    Line('  movzbl %sil, %eax');
  end;
end;

{ A bit number in R (rax or a pool register on amd64, x0 or one on
  arm64), checked against 0..Hi with one unsigned compare, so a negative
  one fails too; out of range, rt_bitfail stops the program with the
  line this call returns to (P105, 1.0.117). }
procedure TEmitter.EmitBitChk(const R: string; Hi: Int64);
var
  ok: string;
begin
  ok := Lab;
  if FArm then
  begin
    Line('  cmp ' + R + ', #' + IntToStr(Hi));
    ColdBegin('  b.hi');
    if R <> 'x0' then
      Line('  mov x0, ' + R);
    Line('  mov x1, #0');
    Line('  mov x2, #' + IntToStr(Hi));
    Line('  bl rt_bitfail');
    ColdEnd;
  end
  else
  begin
    Line('  cmpq $' + IntToStr(Hi) + ', %' + R);
    ColdBegin('  ja');
    if R <> 'rdi' then
      Line('  movq %' + R + ', %rdi');
    Line('  xorl %esi, %esi');
    Line('  movq $' + IntToStr(Hi) + ', %rdx');
    Line('  call rt_bitfail');
    ColdEnd;
  end;
  Line(ok + ':');
end;

{ A bit word of P105 on the clean value in R, in the width of its
  operand's type (1.0.117). A signed narrow value is zero-extended
  first. amd64 (R rax or a pool register; rax, rcx and rdx are free,
  the two not R the temporaries): popcnt when -cpu says the
  processor has it, else the SWAR count; trailing zeros are tzcnt on
  BMI1 and leading zeros lzcnt on LZCNT (P261), which give the width
  for 0 themselves, else bsf over a sentinel bit at the width (bsf +
  cmovz for 64 bits) and bsr of 2x + 1 taken from the width (bsr +
  cmovz + xor for 64 bits);
  bswap (rolw for 16 bits); a bit reversal is a bswap and three SWAR
  swaps, then a shift down to the width. arm64: cnt through v16, rbit +
  clz over the sentinel, clz, rev16/rev/rev, rbit and a shift. A result
  of a signed narrow type is cleaned where it is looked at (NarrowOp). }
procedure TEmitter.EmitBitUn(E: PExpr; const R: string);
var
  t, w: LongInt;
  t1, t2, x: string;
begin
  t := E^.L^.Typ;
  w := IntBits(t);
  if FArm then
  begin
    x := WReg(R);
    if t = TyInt8 then
      Line('  and ' + R + ', ' + R + ', #0xff')
    else if t = TyInt16 then
      Line('  and ' + R + ', ' + R + ', #0xffff')
    else if t = TyInt32 then
      Line('  mov ' + x + ', ' + x);
    case E^.Un of
      uoPopCnt:
        begin
          Line('  fmov d16, ' + R);
          Line('  cnt v16.8b, v16.8b');
          Line('  addv b16, v16.8b');
          Line('  fmov ' + R + ', d16');
        end;
      uoCtz:
        begin
          if w < 64 then
            Line('  orr ' + R + ', ' + R + ', #' + IntToStr(Int64(1) shl w));
          Line('  rbit ' + R + ', ' + R);
          Line('  clz ' + R + ', ' + R);
        end;
      uoClz:
        begin
          if w = 64 then
            Line('  clz ' + R + ', ' + R)
          else
          begin
            Line('  clz ' + x + ', ' + x);
            if w < 32 then
              Line('  sub ' + R + ', ' + R + ', #' + IntToStr(32 - w));
          end;
        end;
      uoBswap:
        if w = 64 then
          Line('  rev ' + R + ', ' + R)
        else if w = 32 then
          Line('  rev ' + x + ', ' + x)
        else if w = 16 then
          Line('  rev16 ' + x + ', ' + x);
      uoRbit:
        if w = 64 then
          Line('  rbit ' + R + ', ' + R)
        else
        begin
          Line('  rbit ' + x + ', ' + x);
          if w < 32 then
            Line('  lsr ' + x + ', ' + x + ', #' + IntToStr(32 - w));
        end;
    end;
    Exit;
  end;
  if R = 'rax' then
  begin
    t1 := 'rcx';
    t2 := 'rdx';
  end
  else
  begin
    t1 := 'rax';
    t2 := 'rcx';
  end;
  if t = TyInt8 then
    Line('  movzbl %' + X86Sub(R, 1) + ', %' + X86Sub(R, 4))
  else if t = TyInt16 then
    Line('  movzwl %' + X86Sub(R, 2) + ', %' + X86Sub(R, 4))
  else if t = TyInt32 then
    Line('  movl %' + X86Sub(R, 4) + ', %' + X86Sub(R, 4));
  case E^.Un of
    uoPopCnt:
      if HasFeat(5) then
        Line('  popcntq %' + R + ', %' + R)
      else
      begin
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $1, %' + t1);
        Line('  movabsq $6148914691236517205, %' + t2);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  subq %' + t1 + ', %' + R);
        Line('  movabsq $3689348814741910323, %' + t2);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $2, %' + t1);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  andq %' + t2 + ', %' + R);
        Line('  addq %' + t1 + ', %' + R);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $4, %' + t1);
        Line('  addq %' + t1 + ', %' + R);
        Line('  movabsq $1085102592571150095, %' + t2);
        Line('  andq %' + t2 + ', %' + R);
        Line('  movabsq $72340172838076673, %' + t2);
        Line('  imulq %' + t2 + ', %' + R);
        Line('  shrq $56, %' + R);
      end;
    uoCtz:
      if HasFeat(CpuFeatBit('bmi1', False)) then
      begin
        { TZCNT (SDM vol. 2B) is 2 ops of latency 2 where BSF is 6 of
          latency 3 on Zen to Zen 3 (amd-family17h, -17h-30h- and
          -family19h-latencies), 1 of latency 1 as BSF on Zen 5 and 3
          cycles as BSF on Skylake (Intel 336289-001), and it counts the
          width of a zero itself: never slower, and the sentinel or the
          cmovz is not written. A narrow width takes its sentinel bit by
          an or (1 op of latency 1). }
        if w = 64 then
          Line('  tzcntq %' + R + ', %' + R)
        else
        begin
          if w < 32 then
            Line('  orl $' + IntToStr(Int64(1) shl w) + ', %' + X86Sub(R, 4));
          Line('  tzcntl %' + X86Sub(R, 4) + ', %' + X86Sub(R, 4));
        end;
      end
      else if w < 64 then
      begin
        Line('  btsq $' + IntToStr(w) + ', %' + R);
        Line('  bsfq %' + R + ', %' + R);
      end
      else
      begin
        Line('  movl $64, %' + X86Sub(t1, 4));
        Line('  bsfq %' + R + ', %' + R);
        Line('  cmovzq %' + t1 + ', %' + R);
      end;
    uoClz:
      if HasFeat(CpuFeatBit('lzcnt', False)) then
      begin
        { LZCNT (SDM vol. 2A) is 1 op of latency 1 where BSR is 6 of
          latency 4 on Zen to Zen 3, 1 of latency 1 as BSR on Zen 5 and
          3 cycles as BSR on Skylake, and it counts the width of a zero
          itself: one instruction for the four of bsr, cmovz and the
          xor. A narrow width counts in 32 bits, less the bits above it. }
        if w = 64 then
          Line('  lzcntq %' + R + ', %' + R)
        else
        begin
          Line('  lzcntl %' + X86Sub(R, 4) + ', %' + X86Sub(R, 4));
          if w < 32 then
            Line('  subl $' + IntToStr(32 - w) + ', %' + X86Sub(R, 4));
        end;
      end
      else if w < 64 then
      begin
        Line('  leaq 1(%' + R + ',%' + R + '), %' + R);
        Line('  bsrq %' + R + ', %' + R);
        Line('  negq %' + R);
        Line('  addq $' + IntToStr(w) + ', %' + R);
      end
      else
      begin
        Line('  movl $127, %' + X86Sub(t1, 4));
        Line('  bsrq %' + R + ', %' + R);
        Line('  cmovzq %' + t1 + ', %' + R);
        Line('  xorq $63, %' + R);
      end;
    uoBswap:
      if w = 64 then
        Line('  bswapq %' + R)
      else if w = 32 then
        Line('  bswapl %' + X86Sub(R, 4))
      else if w = 16 then
        Line('  rolw $8, %' + X86Sub(R, 2));
    uoRbit:
      begin
        Line('  bswapq %' + R);
        Line('  movabsq $1085102592571150095, %' + t2);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $4, %' + t1);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  andq %' + t2 + ', %' + R);
        Line('  shlq $4, %' + R);
        Line('  orq %' + t1 + ', %' + R);
        Line('  movabsq $3689348814741910323, %' + t2);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $2, %' + t1);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  andq %' + t2 + ', %' + R);
        Line('  shlq $2, %' + R);
        Line('  orq %' + t1 + ', %' + R);
        Line('  movabsq $6148914691236517205, %' + t2);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $1, %' + t1);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  andq %' + t2 + ', %' + R);
        Line('  addq %' + R + ', %' + R);
        Line('  orq %' + t1 + ', %' + R);
        if w < 64 then
          Line('  shrq $' + IntToStr(64 - w) + ', %' + R);
      end;
  end;
end;


{ Register R (rax, rcx, r8 ... on amd64; x0 ... on arm64) holds a value
  of type T with only its low bits right: extend them (P99). A value in
  a register or a word of memory is always clean, so a load of a word
  needs nothing and a comparison works on the whole register. }
procedure TEmitter.CanonReg(const R: string; T: LongInt);
begin
  CanonTo(R, R, T);
end;

{ The low bits of R, of type T, extended into D, as CanonReg in place:
  one MOVZX, MOVSX or MOV of 32 bits on amd64, one UXT, SXT or MOV of a
  W register on arm64, which write the whole of D (SDM vol. 2B MOVZX and
  MOVSX; ARM DDI 0487 UXTB C6.2.500, SXTB C6.2.472, MOV register C6.2.282
  of a W register zeroing the top) (P318). }
procedure TEmitter.CanonTo(const D, R: string; T: LongInt);
var
  w, wd, b8, b16, b32, d32: string;
begin
  if not IsNarrowId(T) then
  begin
    if D <> R then
    begin
      if FArm then
        Line('  mov ' + D + ', ' + R)
      else
        Line('  movq %' + R + ', %' + D);
    end;
    Exit;
  end;
  if FArm then
  begin
    w := 'w' + Copy(R, 2, 8);
    wd := 'w' + Copy(D, 2, 8);
    case T of
      TyByte: Line('  uxtb ' + wd + ', ' + w);
      TyInt8: Line('  sxtb ' + D + ', ' + w);
      TyWord: Line('  uxth ' + wd + ', ' + w);
      TyInt16: Line('  sxth ' + D + ', ' + w);
      TyUInt32: Line('  mov ' + wd + ', ' + w);
    else
      Line('  sxtw ' + D + ', ' + w);
    end;
    Exit;
  end;
  b8 := X86Sub(R, 1);
  b16 := X86Sub(R, 2);
  b32 := X86Sub(R, 4);
  d32 := X86Sub(D, 4);
  case T of
    TyByte: Line('  movzbl %' + b8 + ', %' + d32);
    TyInt8: Line('  movsbq %' + b8 + ', %' + D);
    TyWord: Line('  movzwl %' + b16 + ', %' + d32);
    TyInt16: Line('  movswq %' + b16 + ', %' + D);
    TyUInt32: Line('  movl %' + b32 + ', %' + d32);
  else
    Line('  movslq %' + b32 + ', %' + D);
  end;
end;

{ The type field Off (named N, or any at Off when N is empty) of record
  or class T has, a pointer to one taken through; -1 when none. }
function TEmitter.FieldTypAt(T, Off: LongInt; const N: string): LongInt;
var
  k: LongInt;
  i: SizeInt;
begin
  Result := -1;
  k := T;
  if TKind(k) = tykPointer then
    k := FTypes[k].Elem;
  while (k > 0) and (k <= High(FTypes)) do
  begin
    for i := 0 to High(FTypes[k].Fields) do
      if (FTypes[k].Fields[i].Off = Off) and
        ((N = '') or (ToLower(FTypes[k].Fields[i].Name) = ToLower(N))) then
      begin
        Result := FTypes[k].Fields[i].Typ;
        Exit;
      end;
    if TKind(k) <> tykClass then
      Break;
    k := FTypes[k].Parent;
  end;
end;

{ The type a value is stored as (P99): the field's, the element's, the
  variable's, whatever type the parser gave the node since (Integer(b),
  Ord(c) and T(x) retype a leaf in place). The load takes its width and
  its sign from it. }
function TEmitter.LoadTyp(E: PExpr): LongInt;
var
  t: LongInt;
  s: TSym;
begin
  Result := TyNone;
  if E = nil then
    Exit;
  Result := E^.Typ;
  if (E^.Kind = ekDeref) and (E^.L <> nil) and (TKind(E^.L^.Typ) = tykPointer) then
    Result := FTypes[E^.L^.Typ].Elem
  else if (E^.Kind = ekIndex) and (E^.L <> nil) then
  begin
    if IsStr(E^.L^.Typ) then
      Result := TyChar
    else if IsDyn(E^.L^.Typ) or (TKind(E^.L^.Typ) = tykArray) or
      (TKind(E^.L^.Typ) = tykPointer) then
      Result := FTypes[E^.L^.Typ].Elem;
  end
  else if (E^.Kind = ekField) and (E^.L <> nil) then
  begin
    t := FieldTypAt(E^.L^.Typ, E^.Off, E^.Name);
    if t >= 0 then
      Result := t;
  end
  else if (E^.Kind = ekProp) and (E^.L <> nil) and (E^.Off >= 0) and
    (E^.Name = '') then
  begin
    t := FieldTypAt(E^.L^.Typ, E^.Off, '');
    if t >= 0 then
      Result := t;
  end
  else if E^.Kind = ekVar then
  begin
    if TryFindSym(E^.Name, s) then
      Result := s.Typ;
  end;
end;

{ P289: every value E can take lies in Lo..Hi, as Go's prove pass bounds
  a value by its operation (cmd/compile/internal/ssacompile/prove.go:
  flowLimit, modLimit, the facts of And). Only what holds however
  anything else runs: a value worked out into a register (x and K with K
  not negative, x mod K, x shr K), the width of a narrow type, a
  constant, and a for's counter that nothing but its loop can write
  (FCtrFacts). A subrange or an enumeration may hold any value, so its
  type gives no range. }
function TEmitter.IntRange(E: PExpr; out Lo, Hi: Int64): Boolean;
var
  t: LongInt;
  a, b, c, d, k, tl, th: Int64;
  i: SizeInt;
  ok, ty: Boolean;
begin
  Result := False;
  Lo := 0;
  Hi := 0;
  if E = nil then
    Exit;
  if E^.Kind = ekInt then
  begin
    Lo := E^.Num;
    Hi := E^.Num;
    Result := True;
    Exit;
  end;
  if E^.Kind = ekVar then
    for i := High(FCtrFacts) downto 0 do
      if SameSym(FCtrFacts[i].Name, E^.Name) then
      begin
        Lo := FCtrFacts[i].Lo;
        Hi := FCtrFacts[i].Hi;
        Result := True;
        Exit;
      end;
  { the type's width: a narrow value is always clean (P100) }
  ty := False;
  tl := 0;
  th := 0;
  t := LoadTyp(E);
  if IsNarrowId(t) then
  begin
    ty := True;
    tl := FTypes[t].Lo;
    th := FTypes[t].Hi;
  end
  else if t = TyChar then
  begin
    ty := True;
    tl := 0;
    th := 255;
  end;
  { the operation's, in 64 bits: a narrow one wraps in its width, which
    the type's range already bounds }
  ok := False;
  if (TSize(E^.Typ) = 8) and (TKind(E^.Typ) = tykInteger) and (E^.Kind = ekBin) and
    (E^.L <> nil) and (E^.R <> nil) then
    case E^.Bin of
      boAnd:
        begin
          { x and y lies in 0..y for a y not negative, whatever x is }
          if IntRange(E^.L, a, b) and (a >= 0) then
          begin
            ok := True;
            Lo := 0;
            Hi := b;
          end;
          if IntRange(E^.R, c, d) and (c >= 0) then
          begin
            if (not ok) or (d < Hi) then
              Hi := d;
            ok := True;
            Lo := 0;
          end;
        end;
      boMod:
        if (E^.R^.Kind = ekInt) and (E^.R^.Num <> 0) and (E^.R^.Num <> Low(Int64)) then
        begin
          k := Abs(E^.R^.Num);
          { the sign of the dividend, as Go's %: modLimit }
          ok := True;
          if IntRange(E^.L, a, b) and (a >= 0) then
          begin
            Lo := 0;
            Hi := k - 1;
            if b < Hi then
              Hi := b;
          end
          else
          begin
            Lo := -(k - 1);
            Hi := k - 1;
          end;
        end;
      boShr:
        { a logical shift of 64 bits (shrq, lsr): EmitOrdBinAmd and Arm }
        if (E^.R^.Kind = ekInt) and (E^.R^.Num >= 1) and (E^.R^.Num <= 63) then
        begin
          ok := True;
          if IntRange(E^.L, a, b) and (a >= 0) then
          begin
            Lo := a shr E^.R^.Num;
            Hi := b shr E^.R^.Num;
          end
          else
          begin
            Lo := 0;
            Hi := High(Int64) shr (E^.R^.Num - 1);
          end;
        end;
      boAdd, boSub:
        if IntRange(E^.L, a, b) and IntRange(E^.R, c, d) and
          (a >= -(Int64(1) shl 61)) and (b <= Int64(1) shl 61) and
          (c >= -(Int64(1) shl 61)) and (d <= Int64(1) shl 61) then
        begin
          ok := True;
          if E^.Bin = boAdd then
          begin
            Lo := a + c;
            Hi := b + d;
          end
          else
          begin
            Lo := a - d;
            Hi := b - c;
          end;
        end;
    end;
  if ok and ty then
  begin
    if tl > Lo then
      Lo := tl;
    if th < Hi then
      Hi := th;
  end
  else if ty then
  begin
    Lo := tl;
    Hi := th;
  end;
  Result := ok or ty;
end;

{ Every value E can take lies in Lo..Hi, so a static array's index check
  cannot fail (P100): E of a narrow integer type, whose values are always
  clean, or a Char, and since P289 any range IntRange proves. A subrange
  or an enumeration may hold any value, so they keep the check. }
function TEmitter.IndexInRange(E: PExpr; Lo, Hi: Int64): Boolean;
var
  c, a, b: Int64;
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  { counter + c, which the run's head found in Lo..Hi (EmitFor). }
  if FProvOn and CounterOff(E, c) then
    for i := 0 to High(FProv) do
      if (FProv[i].Arr = '') and (FProv[i].Lo = Lo) and (FProv[i].Hi = Hi) and
        (FProv[i].C = c) then
      begin
        Result := True;
        Exit;
      end;
  { The stored type (Ord(c) of a Char still loads a byte), an operation
    that bounds its value, a constant, a counter (P289). }
  if IntRange(E, a, b) then
    Result := (a >= Lo) and (b <= Hi);
end;

{ A and B name the same place or value, with no call in them, so working
  either out gives the same (P100). }
function TEmitter.SameExpr(A, B: PExpr): Boolean;
begin
  Result := False;
  if (A = nil) or (B = nil) then
  begin
    Result := A = B;
    Exit;
  end;
  if A^.Kind <> B^.Kind then
    Exit;
  case A^.Kind of
    ekInt:
      Result := A^.Num = B^.Num;
    ekVar:
      Result := ToLower(A^.Name) = ToLower(B^.Name);
    ekField:
      Result := (A^.Off = B^.Off) and SameExpr(A^.L, B^.L);
    ekDeref:
      Result := SameExpr(A^.L, B^.L);
    ekIndex:
      Result := SameExpr(A^.L, B^.L) and SameExpr(A^.R, B^.R);
    ekBin:
      Result := (A^.Bin = B^.Bin) and (A^.Typ = B^.Typ) and
        SameExpr(A^.L, B^.L) and SameExpr(A^.R, B^.R);
    ekUn:
      Result := (A^.Un = B^.Un) and (A^.Typ = B^.Typ) and SameExpr(A^.L, B^.L);
  end;
end;

{ X, the same place, is read somewhere in E (P100). }
function TEmitter.ContainsSame(E, X: PExpr): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  if SameExpr(E, X) then
  begin
    Result := True;
    Exit;
  end;
  if ContainsSame(E^.L, X) or ContainsSame(E^.R, X) then
  begin
    Result := True;
    Exit;
  end;
  for i := 0 to High(E^.Args) do
    if ContainsSame(E^.Args[i], X) then
    begin
      Result := True;
      Exit;
    end;
end;

{ d := d op x for d an element, a field or a dereference (P100): its
  address is worked out once and amd64 changes the memory in place at
  its width, addb for a Byte, which wraps as the Byte does. hist[b] :=
  hist[b] + 1 worked out the address twice and went through the stack. }
function TEmitter.InPlaceMem(Dest, E: PExpr): Boolean;
var
  m, op, ins: string;
  sz, t: LongInt;
begin
  Result := False;
  if FArm or (E = nil) or (Dest = nil) or (E^.Kind <> ekBin) or (E^.R = nil) then
    Exit;
  if (E^.Bin <> boAdd) and (E^.Bin <> boSub) and (E^.Bin <> boAnd) and
    (E^.Bin <> boOr) and (E^.Bin <> boXor) then
    Exit;
  if (Dest^.Kind <> ekIndex) and (Dest^.Kind <> ekField) and (Dest^.Kind <> ekDeref) then
    Exit;
  if (Dest^.Kind = ekIndex) and (Dest^.L <> nil) and IsStr(Dest^.L^.Typ) then
    Exit;
  if not SameExpr(Dest, E^.L) then
    Exit;
  t := LoadTyp(Dest);
  if not IsIntId(t) then
    Exit;
  sz := TSize(t);
  if IsIntId(E^.Typ) and (TSize(E^.Typ) <> sz) then
    Exit;
  if not WordMemOK(Dest, 1) then
    Exit;
  if (E^.R^.Kind = ekInt) and Fits32(E^.R^.Num) then
    op := '$' + IntToStr(E^.R^.Num)
  else
  begin
    if not OrdSimple(E^.R, 0) then
      Exit;
    EmitOrdTo(E^.R, 0);
    op := '%' + X86Sub(OrdPool(0), sz);
  end;
  m := EmitWordMem(Dest, 1);
  case E^.Bin of
    boAdd: ins := 'add';
    boSub: ins := 'sub';
    boAnd: ins := 'and';
    boOr: ins := 'or';
  else
    ins := 'xor';
  end;
  if sz = 1 then
    ins := ins + 'b'
  else if sz = 2 then
    ins := ins + 'w'
  else if sz = 4 then
    ins := ins + 'l'
  else
    ins := ins + 'q';
  Line('  ' + ins + ' ' + op + ', ' + m);
  Result := True;
end;

{ Load a value of type T at M into register R (x0.. / rax.., named
  without %), extended to a clean word: by the sign for Int8, Int16 and
  Int32, by zeros for the others (P99). }
procedure TEmitter.LoadTo(const M: string; T: LongInt; const R: string);
var
  sz: LongInt;
begin
  sz := TSize(T);
  if FArm then
  begin
    if sz = 1 then
    begin
      if T = TyInt8 then
        Line('  ldrsb ' + R + ', ' + M)
      else
        Line('  ldrb ' + WReg(R) + ', ' + M);
    end
    else if sz = 2 then
    begin
      if T = TyInt16 then
        Line('  ldrsh ' + R + ', ' + M)
      else
        Line('  ldrh ' + WReg(R) + ', ' + M);
    end
    else if sz = 4 then
    begin
      if T = TyInt32 then
        Line('  ldrsw ' + R + ', ' + M)
      else
        Line('  ldr ' + WReg(R) + ', ' + M);
    end
    else
      Line('  ldr ' + R + ', ' + M);
    Exit;
  end;
  if sz = 1 then
  begin
    if T = TyInt8 then
      Line('  movsbq ' + M + ', %' + R)
    else
      Line('  movzbq ' + M + ', %' + R);
  end
  else if sz = 2 then
  begin
    if T = TyInt16 then
      Line('  movswq ' + M + ', %' + R)
    else
      Line('  movzwq ' + M + ', %' + R);
  end
  else if sz = 4 then
  begin
    if T = TyInt32 then
      Line('  movslq ' + M + ', %' + R)
    else
      Line('  movl ' + M + ', %' + X86Sub(R, 4));
  end
  else
    Line('  movq ' + M + ', %' + R);
end;

{ Store the low Sz bytes (1, 2, 4 or 8) of register R at M. }
procedure TEmitter.StoreFrom(const M: string; Sz: LongInt; const R: string);
begin
  if FArm then
  begin
    if Sz = 1 then
      Line('  strb ' + WReg(R) + ', ' + M)
    else if Sz = 2 then
      Line('  strh ' + WReg(R) + ', ' + M)
    else if Sz = 4 then
      Line('  str ' + WReg(R) + ', ' + M)
    else
      Line('  str ' + R + ', ' + M);
    Exit;
  end;
  if Sz = 1 then
    Line('  movb %' + X86Sub(R, 1) + ', ' + M)
  else if Sz = 2 then
    Line('  movw %' + X86Sub(R, 2) + ', ' + M)
  else if Sz = 4 then
    Line('  movl %' + X86Sub(R, 4) + ', ' + M)
  else
    Line('  movq %' + R + ', ' + M);
end;

{ Every expression goes through here: a narrow operation's result is
  cleaned once it is worked out (P99; P100 leaves it to the consumer). }
procedure TEmitter.EmitExpr(E: PExpr);
var
  was: LongInt;
begin
  OpLineIn(E, was);
  EmitExpr0(E);
  FOpLine := was;
end;

procedure TEmitter.EmitExpr0(E: PExpr);
begin
  EmitExprRaw(E);
  { The pool cleaned it already when EmitExprRaw worked it out there. }
  if NarrowOp(E) and not KeepsClean(E) and not OrdSimple(E, 0) then
  begin
    if FArm then
      CanonReg('x0', E^.Typ)
    else
      CanonReg('rax', E^.Typ);
  end;
end;

procedure TEmitter.EmitExprRaw(E: PExpr);
var
  i, nreg, nuser, ntot, ns: SizeInt;
  a, b, op, ab: string;
  av: Int64;
  off, soff: LongInt;
  rx: PExpr;
  rlo, rhi: Int64;
  rin: Boolean;
begin
  if E = nil then
  begin
    if FArm then
      Line('  mov x0, xzr')
    else
      Line('  xorq %rax, %rax');
    Exit;
  end;
  { a set's operation (P126) }
  if (E^.Kind = ekBin) and (((E^.Bin = boIn) and (TKind(E^.R^.Typ) = tykSet)) or
    ((E^.Bin <> boIn) and (E^.L <> nil) and (TKind(E^.L^.Typ) = tykSet))) then
  begin
    EmitSetBin(E);
    Exit;
  end;
  if (E^.Kind = ekSet) and IsWSet(E^.Typ) then
  begin
    EmitWSetLit(E);
    Exit;
  end;
  { An integer expression without calls is worked out in the register
    pool, with no stack traffic (P93). }
  if ((E^.Kind = ekBin) or (E^.Kind = ekUn) or (E^.Kind = ekIndex) or
    (E^.Kind = ekField) or (E^.Kind = ekDeref)) and OrdSimple(E, 0) then
  begin
    { a load straight into rax or x0, where it went to the pool and was
      copied (P303) }
    if LoadKind(E) then
    begin
      FSkipCanon := False;
      if FArm then
        WordLoad(EmitWordMem(E, 0), LoadTyp(E), 'x0')
      else
        WordLoad(EmitWordMem(E, 0), LoadTyp(E), 'rax');
      Exit;
    end;
    EmitOrdTo(E, 0);
    if FArm then
      Line('  mov x0, ' + OrdPool(0))
    else
      Line('  movq %' + OrdPool(0) + ', %rax');
    Exit;
  end;
  if FArm then
  begin
    case E^.Kind of
      ekInt:
        Imm('x0', E^.Num);
      ekReal:
        begin
          Imm('x0', E^.Num);
          if TKind(E^.Typ) = tykQuad then
            Imm('x2', E^.Hi);
        end;
      ekNil:
        begin
          Line('  mov x0, xzr');
          Line('  mov x2, xzr');
          Line('  mov x3, xzr');
        end;
      ekStr:
        begin
          LeaS(InternStr(E^.Txt), 'x0');
          Imm('x2', Length(E^.Txt));
        end;
      ekVar:
        if IsBlob(FindSym(E^.Name).Typ) then
          EmitAddr(E)
        else
          LoadVar(E^.Name);
      ekAddr:
        begin
          FAddrWrite := E^.Num = 0;
          EmitAddr(E^.L);
        end;
      ekField, ekDeref, ekIndex:
        begin
          if IsBlob(E^.Typ) then
            EmitAddr(E)
          else
          begin
            EmitAddr(E);
            { one ldp, from the element's base and offset (P329; Neoverse
              N1 SOG 3.9 table 14: an X-form pair 4 cycles, as one ldr) }
            if IsFat(E^.Typ) then
            begin
              if IsDyn(E^.Typ) then
              begin
                ArmPairAt(3, ab, av);
                Line('  ldr x3, ' + ArmMem(ab, av + 16));
              end
              else
                ArmPairAt(2, ab, av);
              Line('  ldp x0, x2, ' + ArmMem(ab, av));
            end
            else
              LoadTo('[x0]', LoadTyp(E), 'x0');
          end;
        end;
      ekMakeChan:
        begin
          if E^.L <> nil then
            EmitExpr(E^.L)
          else
            Line('  mov x0, xzr');
          Line('  bl rt_makechan');
        end;
      ekRecv:
        begin
          EmitExpr(E^.L);
          Line('  bl rt_chanrecv');
          if ChanBoxed(E^.L^.Typ) then
            EmitUnbox(FTypes[E^.L^.Typ].Elem);
        end;
      ekCtor:
        begin
          if E^.L <> nil then
          begin
            { through a class reference (P123): the class it holds says
              the size, the descriptor and the table }
            EmitExpr(E^.L);
            PshK('x0', 0);
            Line('  ldr x1, [x0, #-48]');
            Line('  ldr x0, [x0, #-24]');
            Line('  bl rt_alloc');
            Ppop('x1');
            Line('  str x1, [x0]');
          end
          else
          begin
            Imm('x0', E^.Off);
            GcArg(GcWordInst(E^.Typ), 'x1');
            Line('  bl rt_alloc');
            LeaS('vmt_' + TypeStemOf(FTypes[E^.Typ]), 'x1');
            Line('  str x1, [x0]');
          end;
          { the object twice: one kept for the result, one Self; then the
            arguments, the ninth word on in the stack as EmitArmMeth
            passes them (a constructor took seven arguments at most) }
          PshK('x0', 1);
          PshK('x0', 1);
          nuser := Length(E^.Args);
          if nuser > 32 then
            Die('at most 32 arguments');
          for i := 0 to nuser - 1 do
          begin
            EmitArgVal(E^.Args[i]);
            PshK('x0', ACls(E^.Args[i]));
          end;
          ntot := nuser + 1;
          if ntot > 8 then
            nreg := 8
          else
            nreg := ntot;
          for i := 0 to nreg - 1 do
            Line('  ldr ' + ArgR(LongInt(i)) + ', [sp, #' + IntToStr((nuser - i) * 16) + ']');
          soff := 0;
          if ntot > 8 then
          begin
            ns := ntot - 8;
            soff := (ns * 8 + 15) and (-16);
            for i := 0 to ns - 1 do
            begin
              Line('  ldr x16, [sp, #' + IntToStr((ns - 1 - i) * 16) + ']');
              Line('  str x16, [sp, #' + IntToStr(ntot * 16 - soff + i * 8) + ']');
            end;
            SpAdjArm('add', ntot * 16 - soff);
          end
          else
          begin
            SpAdjArm('add', ntot * 16);
          end;
          if (E^.L <> nil) and (E^.Num >= 0) then
          begin
            { a virtual constructor, the held class's own (P123) }
            Line('  ldr x16, [x0]');
            LdSlotArm('x16', E^.Num * 8);
            Line('  blr x16');
          end
          else if E^.Name <> '' then
            Line('  bl ' + E^.Name);
          if soff > 0 then
          begin
            SpAdjArm('add', soff);
          end;
          { the class's AfterConstruction on the new object (P121); through
            its slot when the class is the one a reference held (P123) }
          if E^.R <> nil then
          begin
            Line('  ldr x0, [sp]');
            Line('  ldr x16, [x0]');
            LdSlotArm('x16', E^.R^.Num * 8);
            Line('  blr x16');
          end
          else if E^.Txt <> '' then
          begin
            Line('  ldr x0, [sp]');
            Line('  bl ' + E^.Txt);
          end;
          Ppop('x0');
        end;
      ekProp:
        begin
          if E^.Name <> '' then
          begin
            LookupMeth(E^.L^.Typ, E^.Name, a, off);
            EmitArmMeth(E^.L, E^.Args, off, a);
          end
          else
          begin
            EmitExpr(E^.L);
            if E^.Off <> 0 then
            begin
              AddImmArm('x0', 'x0', E^.Off);
            end;
            if not IsBlob(E^.Typ) then
            begin
              if IsFat(E^.Typ) then
              begin
                { one ldp, the field's offset in it (P329) }
                if IsDyn(E^.Typ) then
                begin
                  ArmPairAt(3, ab, av);
                  Line('  ldr x3, ' + ArmMem(ab, av + 16));
                end
                else
                  ArmPairAt(2, ab, av);
                Line('  ldp x0, x2, ' + ArmMem(ab, av));
              end
              else
                LoadTo('[x0]', LoadTyp(E), 'x0');
            end;
          end;
        end;
      ekMethod:
        if E^.Off = -4 then
          EmitCallVal(E^.L, E^.Args)
        else if (E^.L <> nil) and (TKind(E^.L^.Typ) = tykInterface) then
          EmitIfaceCall(E^.L, E^.Args, E^.Off)
        else
          EmitArmMeth(E^.L, E^.Args, E^.Off, E^.Name);
      ekMethPtr:
        begin
          EmitExpr(E^.L);
          Line('  mov x2, x0');
          LeaS(E^.Name, 'x0');
        end;
      ekProcPtr:
        if (E^.Flags and 2) <> 0 then
          EmitClosure(E)
        else
        begin
          LeaS(E^.Name, 'x0');
          Line('  mov x2, xzr');
        end;
      ekCall:
        if EmitTreeCall(E) then
        begin
        end
        else if E^.Name = 'rt_syscall' then
          EmitSyscall(E^.Args)
        else if EmitQuadFn(E) then
        begin
        end
        else if EmitRealFn(E) then
        begin
        end
        else if E^.Name = 'rt_chstr' then
        begin
          { A Char where a string belongs: one heap byte, so the string
            outlives the frame it was made in. }
          EmitExpr(E^.Args[0]);
          Line('  bl rt_chstr');
        end
        else if E^.Name = 'rt_length' then
        begin
          EmitExpr(E^.Args[0]);
          if (TKind(E^.Args[0]^.Typ) = tykMap) or
            (TKind(E^.Args[0]^.Typ) = tykTree) or
            (TKind(E^.Args[0]^.Typ) = tykHeap) then
          begin
            { Length of a nil map is 0. }
            a := Lab;
            Line('  cbz x0, ' + a);
            Line('  ldr x0, [x0]');
            Line(a + ':');
          end
          else if IsStr(E^.Args[0]^.Typ) or IsDyn(E^.Args[0]^.Typ) then
            Line('  mov x0, x2')
          else if TKind(E^.Args[0]^.Typ) = tykArray then
            Imm('x0', FTypes[E^.Args[0]^.Typ].Hi - FTypes[E^.Args[0]^.Typ].Lo + 1)
           else
             Line('  mov x0, x2');
        end
        else if (E^.Name = 'rt_xxh32') or (E^.Name = 'rt_xxh64') or
          (E^.Name = 'rt_xxh3') then
        begin
          EmitExpr(E^.Args[1]);
          PshK('x0', VCls(E^.Args[1]^.Typ, 0));
          EmitExpr(E^.Args[0]);
          Ppop('x1');
          Line('  bl ' + E^.Name);
        end
        else if E^.Name = 'rt_mapnew' then
        begin
          EmitExpr(E^.Args[0]);
          Line('  mov x1, x0');
          LeaS('.LdescMap_' + IntToStr(E^.Typ), 'x0');
          Line('  bl p_pasmap_pasmapnew');
        end
        else if E^.Name = 'rt_mapput' then
        begin
          { m[k] written through a field, a var argument or op= (1.0.140):
            the value's slot, inserted with a zero value when the key was
            missing, as EmitMapStore finds it; a string key is shared,
            since the map keeps it. }
          EmitExpr(E^.Args[0]);
          PshK('x0', VCls(E^.Args[0]^.Typ, 0));
          if IsStr(E^.Args[1]^.Typ) then
          begin
            off := ScratchT(16, E^.Args[1]^.Typ);
            EmitExpr(E^.Args[1]);
            ShareStrOf(E^.Args[1]);
            StFP('x0', off);
            StFP('x2', off + 8);
            Ppop('x0');
            AddFP('x1', off);
            LeaS('.LdescMap_' + IntToStr(E^.Args[0]^.Typ), 'x2');
            Line('  bl p_pasmap_pasmapputstr');
          end
          else
          begin
            EmitExpr(E^.Args[1]);
            Line('  mov x1, x0');
            Ppop('x0');
            LeaS('.LdescMap_' + IntToStr(E^.Args[0]^.Typ), 'x2');
            Line('  bl p_pasmap_pasmapputint');
          end;
        end
        else if (E^.Name = 'rt_mapget') or (E^.Name = 'rt_mapin') or
          (E^.Name = 'rt_mapdel') then
        begin
          EmitExpr(E^.Args[0]);
          PshK('x0', VCls(E^.Args[0]^.Typ, 0));
          { An ordinal key by value to the eight-byte path (P96). }
          if (not IsStr(E^.Args[1]^.Typ)) and (E^.Name <> 'rt_mapdel') then
          begin
            EmitExpr(E^.Args[1]);
            Line('  mov x1, x0');
            Ppop('x0');
            a := 'p_pasmap_pasmapgetint';
          end
          else
          begin
            off := ScratchT(16, E^.Args[1]^.Typ);
            if IsStr(E^.Args[1]^.Typ) then
            begin
              EmitExpr(E^.Args[1]);
              StFP('x0', off);
              StFP('x2', off + 8);
            end
            else
            begin
              EmitExpr(E^.Args[1]);
              StFP('x0', off);
            end;
            Ppop('x0');
            AddFP('x1', off);
            LeaS('.LdescMap_' + IntToStr(E^.Args[0]^.Typ), 'x2');
            if IsStr(E^.Args[1]^.Typ) and ((E^.Name = 'rt_mapget') or (E^.Name = 'rt_mapin')) then
              a := 'rt_mapgetstr'
            else if IsStr(E^.Args[1]^.Typ) and (E^.Name <> 'rt_mapdel') then
              a := 'p_pasmap_pasmapgetstr'
            else
              a := 'p_pasmap_pasmapget';
          end;
          if E^.Name = 'rt_mapget' then
          begin
            Line('  bl ' + a);
            LoadCollectionValue(E^.Typ);
          end
          else if E^.Name = 'rt_mapin' then
          begin
            Line('  bl ' + a);
            Line('  cmp x0, #0');
            Line('  cset x0, ne');
          end
          else
            Line('  bl p_pasmap_pasmapdelete');
        end
        else if E^.Name = 'rt_maptry' then
        begin
          { TryGet(m, k, v): look the key up, then copy the value out. }
          EmitExpr(E^.Args[0]);
          PshK('x0', VCls(E^.Args[0]^.Typ, 0));
          off := ScratchT(16, E^.Args[1]^.Typ);
          if IsStr(E^.Args[1]^.Typ) then
          begin
            EmitExpr(E^.Args[1]);
            StFP('x0', off);
            StFP('x2', off + 8);
          end
          else
          begin
            EmitExpr(E^.Args[1]);
            StFP('x0', off);
          end;
          Ppop('x0');
          AddFP('x1', off);
          LeaS('.LdescMap_' + IntToStr(E^.Args[0]^.Typ), 'x2');
          Line('  bl p_pasmap_pasmapget');
          a := Lab;
          b := Lab;
          Line('  cbz x0, ' + a);
          PshK('x0', 1);
          EmitExpr(E^.Args[2]);
          if StrMap(FTypes[E^.Args[0]^.Typ].Elem2) <> '' then
          begin
            { v and the map hold the value's strings now: marked, as
              rt_treetry marks them (P227; a write to v changed the map) }
            PshK('x0', 2);
            Line('  ldr x1, [sp, #16]');
            Imm('x2', TSize(FTypes[E^.Args[0]^.Typ].Elem2));
            Line('  bl rt_memcpy');
            Ppop('x0');
            LeaS(StrMap(FTypes[E^.Args[0]^.Typ].Elem2), 'x1');
            Line('  bl rt_strshare');
            Line('  add sp, sp, #16');
          end
          else
          begin
            Ppop('x1');
            Imm('x2', TSize(FTypes[E^.Args[0]^.Typ].Elem2));
            Line('  bl rt_memcpy');
          end;
          Line('  mov x0, #1');
          Line('  b ' + b);
          Line(a + ':');
          Line('  mov x0, xzr');
          Line(b + ':');
        end
else if E^.Name = 'rt_high' then
        begin
          EmitExpr(E^.Args[0]);
          if IsDyn(E^.Args[0]^.Typ) then
          begin
            Line('  mov x0, x2');
            Line('  sub x0, x0, #1');
          end
          else if TKind(E^.Args[0]^.Typ) = tykArray then
            Imm('x0', FTypes[E^.Args[0]^.Typ].Hi)
          else
            Line('  mov x0, x2');
        end
        else if E^.Name = 'rt_low' then
        begin
          if TKind(E^.Args[0]^.Typ) = tykArray then
            Imm('x0', FTypes[E^.Args[0]^.Typ].Lo)
          else
            Line('  mov x0, xzr');
        end
        else if E^.Name = 'rt_default' then
        begin
          Line('  mov x0, xzr');
          Line('  mov x2, xzr');
          Line('  mov x3, xzr');
        end
        else if E^.Name = 'rt_getmem' then
        begin
          if Length(E^.Args) > 1 then
          begin
            EmitExpr(E^.Args[1]);
            PshK('x0', VCls(E^.Args[1]^.Typ, 0));
            EmitExpr(E^.Args[0]);
            Ppop('x1');
            Line('  cmp x1, #0');
            Line('  cset x1, ne');
          end
          else
          begin
            EmitExpr(E^.Args[0]);
            Line('  mov x1, #1');
          end;
          Line('  bl rt_alloc');
        end
        else if E^.Name = 'rt_copy' then
        begin
          EmitExpr(E^.Args[0]);
          PshK('x2', VCls(E^.Args[0]^.Typ, 1));
          PshK('x0', VCls(E^.Args[0]^.Typ, 0));
          EmitExpr(E^.Args[1]);
          PshK('x0', VCls(E^.Args[1]^.Typ, 0));
          EmitExpr(E^.Args[2]);
          Line('  mov x3, x0');
          Ppop('x1');
          Ppop('x0');
          Ppop('x2');
          Line('  bl rt_strcopy');
        end
        else if E^.Name = 'rt_view' then
        begin
          EmitExpr(E^.Args[1]);
          PshK('x0', 0);
          EmitExpr(E^.Args[0]);
          Ppop('x2');
          a := Lab;
          Line('  cmp x2, #0');
          ColdBegin('  b.lt');
          BoundsFailArm('x2', 0, 0, '', High(Int64), 0);
          ColdEnd;
          Line(a + ':');
          Line('  mov x3, #0');
        end
        else if E^.Name = 'rt_slice' then
        begin
          EmitExpr(E^.Args[2]);
          PshK('x0', 0);
          EmitExpr(E^.Args[1]);
          PshK('x0', 0);
          EmitExpr(E^.Args[0]);
          Ppop('x4');
          Ppop('x5');
          a := Lab;
          Line('  cmp x4, x2');
          ColdBegin('  b.hi');
          BoundsFailArm('x4', 0, 0, 'x2', 0, 0);
          ColdEnd;
          Line(a + ':');
          a := Lab;
          b := Lab;
          Line('  add x6, x5, #1');
          Line('  cmp x6, x4');
          Line('  b.lt ' + b);
          Line('  cmp x6, x2');
          ColdBeginAt('  b.gt', b);
          BoundsFailArm('x5', 0, 0, 'x2', 0, -1);
          ColdEnd;
          Line(a + ':');
          Line('  sub x2, x6, x4');
          ScaleAddArm('x0', 'x0', 'x4', TSize(FTypes[E^.Typ].Elem), 'x7', '');
          Line('  mov x3, #0');
        end
        else if E^.Name = 'rt_slicecut' then
        begin
          { Copy(d, i, n) of a slice (P136), Free Pascal's clamps and no
            check: an i below 0 takes itself off n and starts at 0, an i
            past the end gives nothing, n is cut to what is left; the
            elements, capacity 0 }
          EmitExpr(E^.Args[2]);
          PshK('x0', 0);
          EmitExpr(E^.Args[1]);
          PshK('x0', 0);
          EmitExpr(E^.Args[0]);
          Ppop('x4');
          Ppop('x5');
          Line('  cmp x4, #0');
          Line('  csel x6, x4, xzr, lt');
          Line('  add x5, x5, x6');
          Line('  csel x4, xzr, x4, lt');
          Line('  cmp x4, x2');
          Line('  csel x4, x4, x2, lt');
          Line('  sub x6, x2, x4');
          Line('  cmp x5, #0');
          Line('  csel x5, x5, xzr, gt');
          Line('  cmp x5, x6');
          Line('  csel x2, x5, x6, lt');
          ScaleAddArm('x0', 'x0', 'x4', TSize(FTypes[E^.Typ].Elem), 'x7', '');
          Line('  mov x3, #0');
        end
        else if E^.Name = 'rt_aslice' then
        begin
          EmitExpr(E^.Args[2]);
          PshK('x0', 0);
          EmitExpr(E^.Args[1]);
          PshK('x0', 0);
          EmitAddr(E^.Args[0]);
          Ppop('x4');
          Ppop('x5');
          AddImmArmT('x6', 'x4', -(FTypes[E^.Args[0]^.Typ].Lo), 'x7');
          { x7 keeps the view's length for the check of the count below }
          Imm('x7', FTypes[E^.Args[0]^.Typ].Hi - FTypes[E^.Args[0]^.Typ].Lo + 1);
          a := Lab;
          Line('  cmp x6, x7');
          ColdBegin('  b.hi');
          BoundsFailArm('x4', 0, FTypes[E^.Args[0]^.Typ].Lo, '', FTypes[E^.Args[0]^.Typ].Hi + 1, 0);
          ColdEnd;
          Line(a + ':');
          a := Lab;
          b := Lab;
          Line('  add x2, x5, #1');
          Line('  sub x2, x2, x4');
          Line('  cmp x2, #0');
          Line('  b.lt ' + b);
          Line('  add x8, x6, x2');
          Line('  cmp x8, x7');
          ColdBeginAt('  b.gt', b);
          BoundsFailArm('x5', 0, FTypes[E^.Args[0]^.Typ].Lo, '', FTypes[E^.Args[0]^.Typ].Hi, 0);
          ColdEnd;
          Line(a + ':');
          ScaleAddArm('x0', 'x0', 'x6', TSize(FTypes[E^.Typ].Elem), 'x7', '');
          Line('  mov x3, #0');
        end
        else if E^.Name = 'rt_paramcount' then
          Line('  bl rt_paramcount')
        else if E^.Name = 'rt_paramstr' then
        begin
          EmitExpr(E^.Args[0]);
          Line('  bl rt_paramstr');
        end
        else
          EmitCall(E^.Name, E^.Args);
      ekSet:
        begin
          Psh('x19');
          Line('  mov x19, xzr');
          for i := 0 to High(E^.Args) do
            if E^.Args[i]^.Kind = ekRange then
            begin
              Psh('x20');
              Psh('x22');
              EmitExpr(E^.Args[i]^.L);
              if E^.Args[i]^.L^.Kind <> ekInt then
                EmitSetCheck(E^.Typ);
              Line('  mov x20, x0');
              EmitExpr(E^.Args[i]^.R);
              if E^.Args[i]^.R^.Kind <> ekInt then
                EmitSetCheck(E^.Typ);
              Line('  mov x22, x0');
              a := Lab;
              b := Lab;
              Line(a + ':');
              Line('  cmp x20, x22');
              Line('  b.gt ' + b);
              Line('  mov x9, #1');
              Line('  lsl x9, x9, x20');
              Line('  orr x19, x19, x9');
              Line('  add x20, x20, #1');
              Line('  b ' + a);
              Line(b + ':');
              Ppop('x22');
              Ppop('x20');
            end
            else
            begin
              EmitExpr(E^.Args[i]);
              if E^.Args[i]^.Kind <> ekInt then
                EmitSetCheck(E^.Typ);
              Line('  mov x9, #1');
              Line('  lsl x9, x9, x0');
              Line('  orr x19, x19, x9');
            end;
          Line('  mov x0, x19');
          Ppop('x19');
        end;
      ekUn:
        begin
          EmitExpr(E^.L);
          { A conversion to a narrow integer: EmitExpr cleans x0 (P99). }
          if E^.Un = uoConv then
          begin
          end
          else if BitUnOp(E^.Un) then
            EmitBitUn(E, 'x0')
          else if E^.Un = uoNeg then
          begin
            if (E^.L <> nil) and (E^.L^.Typ = TySingle) then
              Line('  eor x0, x0, #0x80000000')
            else if (E^.L <> nil) and (TKind(E^.L^.Typ) = tykReal) then
            begin
              Line('  mov x9, #1');
              Line('  lsl x9, x9, #63');
              Line('  eor x0, x0, x9');
            end
            else
              Line('  neg x0, x0');
          end
          else if E^.Typ = TyBoolean then
          begin
            Line('  cmp x0, #0');
            Line('  cset x0, eq');
          end
          else
            Line('  mvn x0, x0');
        end;
      ekBin:
        begin
          if FCheckPtr and (TKind(E^.Typ) = tykPointer) and
            ((E^.Bin = boAdd) or (E^.Bin = boSub)) then
            EmitPtrArith(E)
          else if RangeTest(E, rx, rlo, rhi, rin) then
          begin
            { a range's two ends as a value: one compare and a cset (P292) }
            RangeCmp(rx, rlo, rhi);
            if rin then
              Line('  cset x0, ls')
            else
              Line('  cset x0, hi');
          end
          else if ((E^.Bin = boAnd) or (E^.Bin = boOr)) and (E^.Typ = TyBoolean) then
          begin
            a := Lab;
            b := Lab;
            EmitExpr(E^.L);
            if E^.Bin = boAnd then
              Line('  cbz x0, ' + a)
            else
              Line('  cbnz x0, ' + a);
            EmitExpr(E^.R);
            Line('  cmp x0, #0');
            Line('  cset x0, ne');
            Line('  b ' + b);
            Line(a + ':');
            if E^.Bin = boAnd then
              Line('  mov x0, xzr')
            else
              Line('  mov x0, #1');
            Line(b + ':');
          end
          else if ((E^.Bin = boEq) or (E^.Bin = boNe)) and
            IsStr(E^.L^.Typ) and IsStr(E^.R^.Typ) then
          begin
            EmitExpr(E^.L);
            PshK('x2', VCls(E^.L^.Typ, 1));
            PshK('x0', VCls(E^.L^.Typ, 0));
            EmitExpr(E^.R);
            Line('  mov x3, x2');
            Line('  mov x2, x0');
            Ppop('x0');
            Ppop('x1');
            Line('  bl rt_streq');
            if E^.Bin = boNe then
            begin
              Line('  cmp x0, #0');
              Line('  cset x0, eq');
            end;
          end
          else if ((E^.Bin = boLt) or (E^.Bin = boLe) or (E^.Bin = boGt) or
            (E^.Bin = boGe)) and IsStr(E^.L^.Typ) and IsStr(E^.R^.Typ) then
          begin
            { P74, on arm64: the letters, not the addresses. }
            EmitExpr(E^.L);
            PshK('x2', VCls(E^.L^.Typ, 1));
            PshK('x0', VCls(E^.L^.Typ, 0));
            EmitExpr(E^.R);
            Line('  mov x3, x2');
            Line('  mov x2, x0');
            Ppop('x0');
            Ppop('x1');
            Line('  bl rt_strcmp');
            Line('  cmp x0, #0');
            if E^.Bin = boLt then
              Line('  cset x0, lt')
            else if E^.Bin = boLe then
              Line('  cset x0, le')
            else if E^.Bin = boGt then
              Line('  cset x0, gt')
            else
              Line('  cset x0, ge');
          end
          else if E^.Bin = boConcat then
          begin
            EmitExpr(E^.L);
            if not IsStr(E^.L^.Typ) then
            begin
              FScrHint := 0;
              off := Scratch(8);
              AddFP('x16', off);
              Line('  strb w0, [x16]');
              Line('  mov x0, x16');
              Line('  mov x2, #1');
            end;
            PshK('x2', 0);
            PshK('x0', 1);
            EmitExpr(E^.R);
            if not IsStr(E^.R^.Typ) then
            begin
              FScrHint := 0;
              off := Scratch(8);
              AddFP('x16', off);
              Line('  strb w0, [x16]');
              Line('  mov x0, x16');
              Line('  mov x2, #1');
            end;
            Line('  mov x3, x2');
            Line('  mov x2, x0');
            Ppop('x0');
            Ppop('x1');
            Line('  bl rt_concat');
          end
          else if (E^.Bin = boIs) or (E^.Bin = boAs) then
            EmitClassRel(E)
          else if RealBin(E) then
            EmitRealBin(E)
          else if DivConstOK(E) then
          begin
            EmitExpr(E^.L);
            EmitDivConst('x0', E^.R^.Num, E^.Bin = boMod);
          end
          else
          begin
            if not LeftFirst(E) then
            begin
              if (E^.L^.Kind = ekStr) and (Length(E^.L^.Txt) = 1) then
                Imm('x0', Ord(E^.L^.Txt[1]))
              else
                EmitExpr(E^.L);
              PshK('x0', VCls(E^.L^.Typ, 0));
              if (E^.R^.Kind = ekStr) and (Length(E^.R^.Txt) = 1) then
                Imm('x0', Ord(E^.R^.Txt[1]))
              else
                EmitExpr(E^.R);
            end;
            case E^.Bin of
              boAdd:
                begin
                  PopLeft;
                  if FRightOn then
                  begin
                    FRightOn := False;
                    AddImmArm('x0', 'x0', FRightK);
                  end
                  else if TKind(E^.Typ) = tykSet then
                    Line('  orr x0, x1, x0')
                  else
                    Line('  add x0, x1, x0');
                end;
              boSub:
                begin
                  PopLeft;
                  if FRightOn then
                  begin
                    FRightOn := False;
                    AddImmArm('x0', 'x0', -FRightK);
                  end
                  else if TKind(E^.Typ) = tykSet then
                  begin
                    Line('  mvn x0, x0');
                    Line('  and x0, x1, x0');
                  end
                  else
                    Line('  sub x0, x1, x0');
                end;
              boMul:
                begin
                  PopLeft;
                  if FRightOn then
                  begin
                    FRightOn := False;
                    if not MulByK('x0', FRightK) then
                    begin
                      Imm('x1', FRightK);
                      Line('  mul x0, x0, x1');
                    end;
                  end
                  else if TKind(E^.Typ) = tykSet then
                    Line('  and x0, x1, x0')
                  else
                    Line('  mul x0, x1, x0');
                end;
              boIn:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  Line('  lsr x9, x1, x0');
                  Line('  and x0, x9, #1');
                end;
              boDiv:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  EmitDivCheck;
                  Line('  sdiv x0, x0, x1');
                end;
              boMod:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  EmitDivCheck;
                  Line('  sdiv x9, x0, x1');
                  Line('  msub x0, x9, x1, x0');
                end;
              boEq: EmitCmp('sete');
              boNe: EmitCmp('setne');
              boLt: EmitCmp('setl');
              boLe: EmitCmp('setle');
              boGt: EmitCmp('setg');
              boGe: EmitCmp('setge');
              boAnd:
                begin
                  PopLeft;
                  Line('  and x0, x1, x0');
                end;
              boOr:
                begin
                  PopLeft;
                  Line('  orr x0, x1, x0');
                end;
              boXor:
                begin
                  PopLeft;
                  Line('  eor x0, x1, x0');
                end;
              boShl:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  Line('  lsl x0, x0, x1');
                end;
              boShr:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  { A clean Int8, Int16 or Int32 shifts by its sign (P99). }
                  if (E^.Typ = TyInt8) or (E^.Typ = TyInt16) or (E^.Typ = TyInt32) then
                    Line('  asr x0, x0, x1')
                  else
                    Line('  lsr x0, x0, x1');
                end;
              boSar, boRol, boRor:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  RotArm(E^.Bin, E^.Typ);
                end;
              boMulHi, boMulHiS:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  if E^.Bin = boMulHi then
                    Line('  umulh x0, x0, x1')
                  else
                    Line('  smulh x0, x0, x1');
                end;
            end;
          end;
        end;
    end;
    Exit;
  end;
  case E^.Kind of
    ekInt:
      Line('  movq $' + IntToStr(E^.Num) + ', %rax');
    ekReal:
      begin
        Line('  movabsq $' + IntToStr(E^.Num) + ', %rax');
        if TKind(E^.Typ) = tykQuad then
          Line('  movabsq $' + IntToStr(E^.Hi) + ', %rdx');
      end;
    ekNil:
      begin
        Line('  xorq %rax, %rax');
        Line('  xorq %rdx, %rdx');
        Line('  xorq %r8, %r8');
      end;
    ekStr:
      begin
        Line('  leaq ' + InternStr(E^.Txt) + '(%rip), %rax');
        Line('  movq $' + IntToStr(Length(E^.Txt)) + ', %rdx');
      end;
    ekVar:
      if IsBlob(FindSym(E^.Name).Typ) then
        EmitAddr(E)
      else
        LoadVar(E^.Name);
    ekField, ekDeref, ekIndex:
      begin
        if IsBlob(E^.Typ) then
          EmitAddr(E)
        else
        begin
          EmitAddr(E);
          { from the element's operand (P329), the word into rax last }
          if IsFat(E^.Typ) then
          begin
            op := AddrOp('rdx,r8');
            if IsDyn(E^.Typ) then
              Line('  movq ' + OpPlus(op, 16) + ', %r8');
            Line('  movq ' + OpPlus(op, 8) + ', %rdx');
            Line('  movq ' + op + ', %rax');
          end
          else
            LoadTo(AddrOp(''), LoadTyp(E), 'rax');
        end;
      end;
    ekMakeChan:
      begin
        if E^.L <> nil then
        begin
          EmitExpr(E^.L);
          Line('  movq %rax, %rdi');
        end
        else
          Line('  xorq %rdi, %rdi');
        Line('  call rt_makechan');
      end;
    ekRecv:
      begin
        EmitExpr(E^.L);
        Line('  movq %rax, %rdi');
        Line('  call rt_chanrecv');
        if ChanBoxed(E^.L^.Typ) then
          EmitUnbox(FTypes[E^.L^.Typ].Elem);
      end;
    ekCtor:
      begin
        if E^.L <> nil then
        begin
          { through a class reference (P123): the class it holds says the
            size, the descriptor and the table }
          EmitExpr(E^.L);
          PushK('rax', 0);
          Line('  movq -24(%rax), %rdi');
          Line('  movq -48(%rax), %rsi');
          Line('  call rt_alloc');
          Line('  popq %rcx');
          PushK('rax', 1);
          Line('  movq %rcx, (%rax)');
        end
        else
        begin
          Line('  movq $' + IntToStr(E^.Off) + ', %rdi');
          GcArg(GcWordInst(E^.Typ), 'rsi');
          Line('  call rt_alloc');
          PushK('rax', 1);
          Line('  leaq vmt_' + TypeStemOf(FTypes[E^.Typ]) + '(%rip), %rcx');
          Line('  movq %rcx, (%rax)');
        end;
        for i := 0 to High(E^.Args) do
        begin
          EmitArgVal(E^.Args[i]);
          PushK('rax', ACls(E^.Args[i]));
        end;
        if Length(E^.Args) > 5 then
          nreg := 5
        else
          nreg := Length(E^.Args);
        ShiftArgs(Length(E^.Args), nreg, 1);
        if Length(E^.Args) > nreg then
          Line('  movq ' + IntToStr((Length(E^.Args) - nreg) * 8) + '(%rsp), %rdi')
        else
          Line('  movq (%rsp), %rdi');
        if (E^.L <> nil) and (E^.Num >= 0) then
        begin
          { a virtual constructor, the held class's own (P123) }
          Line('  movq (%rdi), %rax');
          Line('  call *' + IntToStr(E^.Num * 8) + '(%rax)');
        end
        else if E^.Name <> '' then
          Line('  call ' + E^.Name);
        if Length(E^.Args) > nreg then
          Line('  addq $' + IntToStr((Length(E^.Args) - nreg) * 8) + ', %rsp');
        { the class's AfterConstruction on the new object (P121); through
          its slot when the class is the one a reference held (P123) }
        if E^.R <> nil then
        begin
          Line('  movq (%rsp), %rdi');
          Line('  movq (%rdi), %rax');
          Line('  call *' + IntToStr(E^.R^.Num * 8) + '(%rax)');
        end
        else if E^.Txt <> '' then
        begin
          Line('  movq (%rsp), %rdi');
          Line('  call ' + E^.Txt);
        end;
        Line('  popq %rax');
      end;
    ekProp:
      begin
        if E^.Name <> '' then
        begin
          LookupMeth(E^.L^.Typ, E^.Name, a, off);
          if Length(E^.Args) = 0 then
          begin
            EmitExpr(E^.L);
            Line('  movq %rax, %rdi');
            if off >= 0 then
            begin
              Line('  movq (%rdi), %rax');
              Line('  call *' + IntToStr(off * 8) + '(%rax)');
            end
            else
              Line('  call ' + a);
          end
          else
          begin
            EmitExpr(E^.L);
            PushK('rax', VCls(E^.L^.Typ, 0));
            for i := 0 to High(E^.Args) do
            begin
              EmitExpr(E^.Args[i]);
              PushK('rax', VCls(E^.Args[i]^.Typ, 0));
            end;
            if Length(E^.Args) > 5 then
              Die('property index');
            ShiftArgs(Length(E^.Args), Length(E^.Args), 1);
            Line('  popq %rdi');
            if off >= 0 then
            begin
              Line('  movq (%rdi), %rax');
              Line('  call *' + IntToStr(off * 8) + '(%rax)');
            end
            else
              Line('  call ' + a);
          end;
        end
        else
        begin
          EmitExpr(E^.L);
          { the field's offset in the loads' displacement (P329) }
          op := '(%rax)';
          if E^.Off <> 0 then
            op := IntToStr(E^.Off) + '(%rax)';
          if IsFat(E^.Typ) then
          begin
            if IsDyn(E^.Typ) then
              Line('  movq ' + OpPlus(op, 16) + ', %r8');
            Line('  movq ' + OpPlus(op, 8) + ', %rdx');
            Line('  movq ' + op + ', %rax');
          end
          else
            LoadTo(op, LoadTyp(E), 'rax');
        end;
      end;
    ekMethod:
      begin
        if E^.Off = -4 then
          EmitCallVal(E^.L, E^.Args)
        else if (E^.L <> nil) and (TKind(E^.L^.Typ) = tykInterface) then
          EmitIfaceCall(E^.L, E^.Args, E^.Off)
        else if E^.Off = -3 then
          EmitMethVal(E^.L, E^.Args)
        else if E^.Name = '' then
        begin
          Line('  xorq %rax, %rax');
        end
        else
        begin
          nreg := MethArgs(E^.L, VCls(E^.L^.Typ, 0), E^.Args);
          if E^.Off >= 0 then
          begin
            Line('  movq (%rdi), %rax');
            Line('  call *' + IntToStr(E^.Off * 8) + '(%rax)');
          end
          else if E^.Off <= ClsSlotBase then
            { a class method's virtual call (P123): Self is the table }
            Line('  call *' + IntToStr((ClsSlotBase - E^.Off) * 8) + '(%rdi)')
          else
            Line('  call ' + E^.Name);
          if nreg > 0 then
            Line('  addq $' + IntToStr((nreg + 1) * 8) + ', %rsp');
        end;
      end;
    ekMethPtr:
      begin
        EmitExpr(E^.L);
        Line('  movq %rax, %rdx');
        Line('  leaq ' + E^.Name + '(%rip), %rax');
      end;
    ekProcPtr:
      if (E^.Flags and 2) <> 0 then
        EmitClosure(E)
      else
      begin
        Line('  leaq ' + E^.Name + '(%rip), %rax');
        Line('  xorl %edx, %edx');
      end;
    ekCall:
      begin
        if EmitTreeCall(E) then
        begin
        end
        else if E^.Name = 'rt_syscall' then
          EmitSyscall(E^.Args)
        else if EmitQuadFn(E) then
        begin
        end
        else if EmitRealFn(E) then
        begin
        end
        else if E^.Name = 'rt_chstr' then
        begin
          { A Char where a string belongs: one heap byte, so the string
            outlives the frame it was made in. }
          EmitExpr(E^.Args[0]);
          Line('  movq %rax, %rdi');
          Line('  call rt_chstr');
        end
        else if E^.Name = 'rt_length' then
        begin
          EmitExpr(E^.Args[0]);
          if (TKind(E^.Args[0]^.Typ) = tykMap) or
            (TKind(E^.Args[0]^.Typ) = tykTree) or
            (TKind(E^.Args[0]^.Typ) = tykHeap) then
          begin
            { Length of a nil map is 0. }
            a := Lab;
            Line('  testq %rax, %rax');
            Line('  jz ' + a);
            Line('  movq (%rax), %rax');
            Line(a + ':');
          end
          else if IsStr(E^.Args[0]^.Typ) or IsDyn(E^.Args[0]^.Typ) then
            Line('  movq %rdx, %rax')
          else if TKind(E^.Args[0]^.Typ) = tykArray then
            Line('  movq $' + IntToStr(FTypes[E^.Args[0]^.Typ].Hi -
              FTypes[E^.Args[0]^.Typ].Lo + 1) + ', %rax')
          else if IsStr(E^.Args[0]^.Typ) then
            Line('  movq %rdx, %rax')
           else
             Line('  movq %rdx, %rax');
        end
        else if (E^.Name = 'rt_xxh32') or (E^.Name = 'rt_xxh64') or
          (E^.Name = 'rt_xxh3') then
        begin
          EmitExpr(E^.Args[1]);
          PushK('rax', VCls(E^.Args[1]^.Typ, 0));
          EmitExpr(E^.Args[0]);
          Line('  popq %r9');
          Line('  call ' + E^.Name);
        end
        else if E^.Name = 'rt_mapnew' then
        begin
          EmitExpr(E^.Args[0]);
          Line('  movq %rax, %rsi');
          Line('  leaq .LdescMap_' + IntToStr(E^.Typ) + '(%rip), %rdi');
          Line('  call p_pasmap_pasmapnew');
        end
        else if E^.Name = 'rt_mapput' then
        begin
          { m[k] written through a field, a var argument or op= (1.0.140):
            the value's slot, inserted with a zero value when the key was
            missing, as EmitMapStore finds it; a string key is shared,
            since the map keeps it. }
          EmitExpr(E^.Args[0]);
          PushK('rax', VCls(E^.Args[0]^.Typ, 0));
          if IsStr(E^.Args[1]^.Typ) then
          begin
            off := ScratchT(16, E^.Args[1]^.Typ);
