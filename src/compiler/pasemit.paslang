  Line('  xorq %rdx, %rdx');
  Line('  movq $41, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  js .tl_out');
  Line('  movq %rax, %r12');
  Line('  subq $16, %rsp');
  Line('  movl $1, (%rsp)');
  Line('  movq %r12, %rdi');
  Line('  movq $1, %rsi');
  Line('  movq $2, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $4, %r8');
  Line('  movq $54, %rax');
  Line('  syscall');
  Line('  movq %r12, %rdi');
  Line('  movq $6, %rsi');
  Line('  movq $1, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $4, %r8');
  Line('  movq $54, %rax');
  Line('  syscall');
  Line('  xorq %rax, %rax');
  Line('  movq %rax, (%rsp)');
  Line('  movq %rax, 8(%rsp)');
  Line('  movw $2, (%rsp)');
  Line('  movw %bx, %ax');
  Line('  xchg %al, %ah');
  Line('  movw %ax, 2(%rsp)');
  Line('  movq %r12, %rdi');
  Line('  movq %rsp, %rsi');
  Line('  movq $16, %rdx');
  Line('  movq $49, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  js .tl_fail');
  Line('  movq %r12, %rdi');
  { the backlog of 4096, the kernel's cap (somaxconn), where 128 filled
    under two hundred connections at once and the kernel dropped the
    rest's SYN for a second, the retransmit (1.1.1) }
  Line('  movq $4096, %rsi');
  Line('  movq $50, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  js .tl_fail');
  Line('  addq $16, %rsp');
  Line('  movq %r12, %rax');
  Line('  jmp .tl_out');
  Line('.tl_fail:');
  Line('  movq %r12, %rdi');
  Line('  movq $3, %rax');
  Line('  syscall');
  Line('  movq $-1, %rax');
  Line('  addq $16, %rsp');
  Line('.tl_out:');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('rt_tcpport:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  subq $24, %rsp');
  Line('  movq $0, (%rsp)');
  Line('  movq $0, 8(%rsp)');
  Line('  movq $16, 16(%rsp)');
  Line('  movq %rbx, %rdi');
  Line('  movq %rsp, %rsi');
  Line('  leaq 16(%rsp), %rdx');
  Line('  movq $51, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  js .tp_fail');
  Line('  movzwl 2(%rsp), %eax');
  Line('  xchg %al, %ah');
  Line('  movzwl %ax, %eax');
  Line('  jmp .tp_out');
  Line('.tp_fail:');
  Line('  xorq %rax, %rax');
  Line('.tp_out:');
  Line('  addq $24, %rsp');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('rt_acslot:');
  Line('  leaq rt_iotab(%rip), %r12');
  Line('  xorq %r13, %r13');
  Line('  xorq %r15, %r15');
  Line('.as_n:');
  Line('  cmpq $32, %r13');
  Line('  jae .as_done');
  Line('  movq %r13, %rax');
  Line('  shlq $5, %rax');
  Line('  leaq (%r12, %rax), %rax');
  Line('  cmpq $0, (%rax)');
  Line('  jne .as_cmp');
  Line('  testq %r15, %r15');
  Line('  jnz .as_nx');
  Line('  movq %rax, %r15');
  Line('  jmp .as_nx');
  Line('.as_cmp:');
  Line('  cmpq %rbx, (%rax)');
  Line('  jne .as_nx');
  Line('  movq %rax, %r15');
  Line('  jmp .as_done');
  Line('.as_nx:');
  Line('  incq %r13');
  Line('  jmp .as_n');
  Line('.as_done:');
  Line('  ret');
  Line('');
  { Wake the other accept waiter and point the edge registration at it.
    If nobody else is waiting, the hot latch stays set so the next waiter
    tries again instead of missing a connection already queued. }
  Line('rt_acpoke:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  movq %rdi, %rbx');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  call rt_acslot');
  Line('  xorq %r12, %r12');
  Line('  testq %r15, %r15');
  Line('  jz .ap_unlock');
  Line('  cmpq %r14, 8(%r15)');
  Line('  jne .ap_s1');
  Line('  movq $0, 8(%r15)');
  Line('  movq 16(%r15), %r12');
  Line('  jmp .ap_hot');
  Line('.ap_s1:');
  Line('  cmpq %r14, 16(%r15)');
  Line('  jne .ap_unlock');
  Line('  movq $0, 16(%r15)');
  Line('  movq 8(%r15), %r12');
  Line('.ap_hot:');
  Line('  testq %r12, %r12');
  Line('  jnz .ap_unlock');
  Line('  movq $1, 24(%r15)');
  Line('.ap_unlock:');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  testq %r12, %r12');
  Line('  jz .ap_out');
  { The other waiter's token: its record and the number it armed. }
  Line('  movl 200(%r12), %eax');
  Line('  shlq $48, %rax');
  Line('  orq %r12, %rax');
  Line('  movq %rax, %r13');
  Line('  subq $16, %rsp');
  Line('  movq $0, 8(%rsp)');
  Line('  movl $0x80000001, (%rsp)');
  Line('  movq %r13, 4(%rsp)');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  movq $3, %rsi');
  Line('  movq %rbx, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  Line('  addq $16, %rsp');
  Line('  movq %r13, %rdi');
  Line('  call rt_pollwake');
  Line('.ap_out:');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  { r13: 0 park, 1 register this G then return, 2 return without parking. }
  Line('rt_acwait:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  movq %rdi, %rbx');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  call rt_acslot');
  Line('  xorq %r13, %r13');
  Line('  testq %r15, %r15');
  Line('  jz .aw_ul');
  Line('  cmpq $0, (%r15)');
  Line('  jne .aw_have');
  Line('  movq %rbx, (%r15)');
  Line('  movq %r14, 8(%r15)');
  Line('  movq $0, 16(%r15)');
  Line('  movq $0, 24(%r15)');
  Line('  movq $1, %r13');
  Line('  jmp .aw_ul');
  Line('.aw_have:');
  Line('  cmpq $0, 24(%r15)');
  Line('  je .aw_mine');
  Line('  movq $0, 24(%r15)');
  Line('  movq $2, %r13');
  Line('  jmp .aw_ul');
  Line('.aw_mine:');
  Line('  cmpq %r14, 8(%r15)');
  Line('  je .aw_ul');
  Line('  cmpq %r14, 16(%r15)');
  Line('  je .aw_ul');
  Line('  cmpq $0, 8(%r15)');
  Line('  jne .aw_w1');
  Line('  movq %r14, 8(%r15)');
  Line('  movq $1, %r13');
  Line('  jmp .aw_ul');
  Line('.aw_w1:');
  Line('  cmpq $0, 16(%r15)');
  Line('  jne .aw_ul');
  Line('  movq %r14, 16(%r15)');
  Line('.aw_ul:');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  cmpq $2, %r13');
  Line('  je .aw_ret');
  { Every wait arms a fresh token and points the edge registration at it
    (MOD re-reads the socket, so a connection already queued raises the
    event); 1 returns to try accept once more, 0 parks. }
  Line('  call rt_pollarm');
  Line('  subq $16, %rsp');
  Line('  movq $0, 8(%rsp)');
  Line('  movl $0x80000001, (%rsp)');
  Line('  movq %rax, 4(%rsp)');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  movq $3, %rsi');
  Line('  movq %rbx, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  jns .aw_added');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  movq $1, %rsi');
  Line('  movq %rbx, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  Line('.aw_added:');
  Line('  addq $16, %rsp');
  Line('  cmpq $1, %r13');
  Line('  je .aw_ret');
  Line('  lock incq rt_npollwait(%rip)');
  Line('  call rt_parkmarked');
  Line('  movq $0, 192(%r14)');
  Line('  lock decq rt_npollwait(%rip)');
  Line('.aw_ret:');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  { The listening socket is registered edge-triggered, so a connection
    raises one event. The G sets status 1 before each accept try; a wake
    that lands between the try and the park then marks status 3 and
    rt_parkmarked returns instead of sleeping. Marking after the try
    would let that wake fall on status 0 and be lost for good. }
  Line('rt_tcpaccept:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('.ta_loop:');
  Line('  movl $1, 152(%r14)');
  Line('  movq %rbx, %rdi');
  Line('  xorq %rsi, %rsi');
  Line('  xorq %rdx, %rdx');
  Line('  movq $526336, %r10');
  Line('  movq $288, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  jns .ta_ok');
  Line('  cmpq $-11, %rax');
  Line('  jne .ta_ok');
  Line('  movq %rbx, %rdi');
  Line('  call rt_acwait');
  Line('  jmp .ta_loop');
  Line('.ta_ok:');
  Line('  movl $0, 152(%r14)');
  Line('  pushq %rax');
  Line('  movq %rbx, %rdi');
  Line('  call rt_acpoke');
  Line('  popq %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  { NetConnect is Pascal (PasNetConnect in pasroutines, P216), on the
    wait Go's netFD.connect makes: this waited once, took SO_ERROR 0 for
    a connection and EINTR from connect for a failure. rdi and rsi are
    already the routine's two arguments; a jmp leaves the caller's
    return address for its ret (Intel SDM vol. 2A, JMP). }
  Line('.weak p_pasroutines_pasnetconnect');
  Line('rt_tcpconnect:');
  Line('  jmp p_pasroutines_pasnetconnect');
  Line('');
  { NetRead and NetWrite are Pascal (PasNetRead and PasNetWrite in
    pasroutines, P199), on the one loop of I/O that parks: EINTR made
    NetRead end the stream, and a wait whose registration failed was
    tried again for ever. rdi, rsi and rdx are already the routine's
    three arguments; a jmp leaves the caller's return address for its
    ret (Intel SDM vol. 2A, JMP: no return information is recorded). }
  Line('.weak p_pasroutines_pasnetread');
  Line('rt_tcpread:');
  Line('  jmp p_pasroutines_pasnetread');
  Line('');
  Line('.weak p_pasroutines_pasnetwrite');
  Line('rt_tcpwrite:');
  Line('  jmp p_pasroutines_pasnetwrite');
  Line('');
  Line('rt_tcpclose:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  subq $16, %rsp');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  movq $2, %rsi');
  Line('  movq %rbx, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  Line('  addq $16, %rsp');
  Line('  movq %rbx, %rdi');
  Line('  movq $3, %rax');
  Line('  syscall');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('.globl rt_gcount');
  Line('rt_gcount:');
  Line('  movq rt_nlive(%rip), %rax');
  Line('  ret');
  Line('.globl rt_nbreak');
  Line('rt_nbreak:');
  Line('  movq rt_nbreakv(%rip), %rax');
  Line('  ret');
  Line('.globl rt_breakpc');
  Line('rt_breakpc:');
  Line('  movq rt_breakpcv(%rip), %rax');
  Line('  ret');
  Line('.globl rt_break');
  Line('rt_break:');
  Line('  movq %r14, rt_breakg(%rip)');
  Line('  movq (%rsp), %rax');
  Line('  movq %rax, rt_breakpcv(%rip)');
  Line('  lock incq rt_nbreakv(%rip)');
  Line('  call rt_park');
  Line('  ret');
  Line('.globl rt_continue');
  Line('rt_continue:');
  Line('  movq rt_breakg(%rip), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .cb_done');
  Line('  call rt_ready');
  Line('.cb_done:');
  Line('  ret');
  Line('');
end;

procedure TEmitter.EmitChan;
begin
  { Chan: 0 lock, 8 closed, 16 recvq first/last, 32 sendq first/last.
    G+152 status (0 run,1 park,2 wait,3 ready), G+192 qnext, G+200 elem. }
  { rt_raiseobj (P122): rdi the object, rsi where it was raised (0: the
    caller's return address) into G+272 and G+280, then the unwinding of
    rt_raise, which raises the object G+272 holds again }
  Line('.globl rt_raiseobj');
  Line('rt_raiseobj:');
  Line('  movq %rdi, 272(%r14)');
  Line('  testq %rsi, %rsi');
  Line('  jnz .ro_at');
  Line('  movq (%rsp), %rsi');
  Line('.ro_at:');
  Line('  movq %rsi, 280(%r14)');
  Line('.globl rt_raise');
  Line('rt_raise:');
  Line('  movq 224(%r14), %rax');
  Line('  testq %rax, %rax');
  Line('  jz rt_uncaught');
  Line('  movq (%rax), %rcx');
  Line('  movq %rcx, 224(%r14)');
  Line('  movq 8(%rax), %rbp');
  Line('  movq 16(%rax), %rsp');
  Line('  jmpq *24(%rax)');
  { No handler (1.0.147): a routine ends alone, as the manual says; the
    main routine ends the program with a line on stderr and status 1,
    where it left the scheduler with nothing to run and the deadlock
    message. }
  Line('.weak p_pasobject_pasuncaught');
  Line('rt_uncaught:');
  Line('  cmpq rt_maing(%rip), %r14');
  Line('  jne rt_goexit');
  { an object (P122): pasobject's PasUncaught names its class on stderr,
    on a stack aligned as a call wants it; weak, so a program without
    pasobject still links }
  Line('  movq 272(%r14), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .uc_plain');
  Line('  movabsq $p_pasobject_pasuncaught, %rax');
  Line('  testq %rax, %rax');
  Line('  jz .uc_plain');
  Line('  andq $-16, %rsp');
  Line('  call *%rax');
  Line('  jmp .uc_exit');
  Line('.uc_plain:');
  Line('  leaq .Luncaught(%rip), %rsi');
  Line('  movq $44, %rdx');
  Line('  call rt_rawwrite');
  Line('.uc_exit:');
  Line('  movq $1, %rdi');
  Line('  call rt_exit');
  Line('');
  Line('.globl rt_makechan');
  { rt_makechan: rdi the buffer's capacity, 0 for none. A buffered
    channel (1.0.85) is 80 bytes: 48 the buffer, 56 its capacity, 64 the
    words in it, 72 the oldest one's index; it and the buffer are scanned
    word by word (GC word 1), the words being boxes, pointers or plain
    values. }
  Line('rt_makechan:');
  { A capacity below 0 or above ChanCapMax stops (1.0.136): -1 divided
    by zero in the heap, 2^60 followed nil, 2^61 wrote past the ring.
    Unsigned, one compare takes both. }
  Line('  cmpq $' + IntToStr(ChanCapMax) + ', %rdi');
  Line('  ja rt_diechancap');
  Line('  testq %rdi, %rdi');
  Line('  jnz .mc_buf');
  Line('  movq $64, %rdi');
  Line('  xorq %rsi, %rsi');
  Line('  call rt_alloc');
  Line('  ret');
  Line('.mc_buf:');
  Line('  pushq %rdi');
  Line('  movq $80, %rdi');
  Line('  movq $1, %rsi');
  Line('  call rt_alloc');
  Line('  popq %rcx');
  Line('  pushq %rax');
  Line('  pushq %rcx');
  Line('  leaq (,%rcx,8), %rdi');
  Line('  movq $1, %rsi');
  Line('  call rt_alloc');
  Line('  popq %rcx');
  Line('  popq %rdx');
  Line('  movq %rax, 48(%rdx)');
  Line('  movq %rcx, 56(%rdx)');
  Line('  movq $0, 64(%rdx)');
  Line('  movq $0, 72(%rdx)');
  Line('  movq %rdx, %rax');
  Line('  ret');
  Line('');
  { rt_chbput: rdi a locked channel, rsi a word. rax 1 when its buffer
    took the word, 0 when it has none or it is full. rcx, rdx, r8
    change. }
  Line('rt_chbput:');
  Line('  movq 48(%rdi), %r8');
  Line('  testq %r8, %r8');
  Line('  jz .cbp_no');
  Line('  movq 64(%rdi), %rcx');
  Line('  cmpq 56(%rdi), %rcx');
  Line('  jae .cbp_no');
  Line('  movq 72(%rdi), %rdx');
  Line('  addq %rcx, %rdx');
  Line('  cmpq 56(%rdi), %rdx');
  Line('  jb .cbp_in');
  Line('  subq 56(%rdi), %rdx');
  Line('.cbp_in:');
  Line('  movq %rsi, (%r8,%rdx,8)');
  Line('  incq %rcx');
  Line('  movq %rcx, 64(%rdi)');
  Line('  movq $1, %rax');
  Line('  ret');
  Line('.cbp_no:');
  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('');
  { rt_chbget: rdi a locked channel. rdx 1 and rax the oldest buffered
    word, or rdx 0 when the buffer is empty. A sender waiting for room
    moves its word in; its G comes back in rcx to ready once the lock is
    dropped (else 0). rsi, r8 change; rdi is kept. }
  Line('rt_chbget:');
  Line('  xorq %rcx, %rcx');
  Line('  xorq %rdx, %rdx');
  { The buffer first: an unbuffered channel is 64 bytes, its word 64
    belongs to the next block. }
  Line('  movq 48(%rdi), %r8');
  Line('  testq %r8, %r8');
  Line('  jz .cbg_none');
  Line('  movq 64(%rdi), %rdx');
  Line('  testq %rdx, %rdx');
  Line('  jz .cbg_none');
  Line('  movq 72(%rdi), %rsi');
  Line('  movq (%r8,%rsi,8), %rax');
  Line('  movq $0, (%r8,%rsi,8)');
  Line('  incq %rsi');
  Line('  cmpq 56(%rdi), %rsi');
  Line('  jb .cbg_h');
  Line('  xorq %rsi, %rsi');
  Line('.cbg_h:');
  Line('  movq %rsi, 72(%rdi)');
  Line('  decq 64(%rdi)');
  Line('  pushq %rax');
  Line('  pushq %rdi');
  Line('  addq $32, %rdi');
  Line('  call rt_cqtake');
  Line('  popq %rdi');
  Line('  xorq %rcx, %rcx');
  Line('  testq %rax, %rax');
  Line('  jz .cbg_done');
  Line('  movq 16(%rax), %rsi');
  Line('  movq 8(%rax), %rcx');
  Line('  movq 48(%rdi), %r8');
  Line('  movq 64(%rdi), %rdx');
  Line('  addq 72(%rdi), %rdx');
  Line('  cmpq 56(%rdi), %rdx');
  Line('  jb .cbg_t');
  Line('  subq 56(%rdi), %rdx');
  Line('.cbg_t:');
  Line('  movq %rsi, (%r8,%rdx,8)');
  Line('  incq 64(%rdi)');
  Line('.cbg_done:');
  Line('  popq %rax');
  Line('  movq $1, %rdx');
  Line('  ret');
  Line('.cbg_none:');
  Line('  ret');
  Line('');
  { Chan: 0 lock, 8 closed, 16/24 recvq first/last, 32/40 sendq first/last.
    A waiter is a 48-byte record on the waiting G's stack: 0 next, 8 G,
    16 elem (the value sent, or the value received), 24 sel (the select
    control block, or 0 for a plain send or recv), 32 arm. A select
    control block is 16 bytes on the selecting G's stack: 0 state (0 open,
    1 taken), 8 the waiter that won. rt_cqtake pops waiters and claims a
    select waiter with one CAS on its control block, so exactly one arm of
    a select fires, as in Go. Every park sets status 1 before the queue
    can see the waiter and parks through rt_parkmarked, so a wake that
    lands in between is kept. }
  { Chan: 0 lock, 8 closed, 16/24 recvq first/last, 32/40 sendq first/last.
    A waiter is a 48-byte record on the waiting G's stack: 0 next, 8 G,
    16 elem (the value sent, or the value received), 24 sel (the select
    control block, or 0 for a plain send or recv), 32 arm. A select
    control block is 16 bytes on the selecting G's stack: 0 state (0 open,
    1 taken), 8 the waiter that won. rt_cqtake pops waiters and claims a
    select waiter with one CAS on its control block, so exactly one arm of
    a select fires, as in Go. Every park sets status 1 before the queue
    can see the waiter and parks through rt_parkmarked, so a wake that
    lands in between is kept. }
  Line('rt_cqenq:');
  Line('  movq $0, (%rsi)');
  Line('  movq 8(%rdi), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .qe_empty');
  Line('  movq %rsi, (%rax)');
  Line('  movq %rsi, 8(%rdi)');
  Line('  ret');
  Line('.qe_empty:');
  Line('  movq %rsi, (%rdi)');
  Line('  movq %rsi, 8(%rdi)');
  Line('  ret');
  Line('');
  { rdi queue. rax: a claimed waiter, or 0. Clobbers rcx, rdx, r8. }
  Line('rt_cqtake:');
  Line('.qt_n:');
  Line('  movq (%rdi), %r8');
  Line('  testq %r8, %r8');
  Line('  jz .qt_none');
  Line('  movq (%r8), %rcx');
  Line('  movq %rcx, (%rdi)');
  Line('  testq %rcx, %rcx');
  Line('  jnz .qt_1');
  Line('  movq $0, 8(%rdi)');
