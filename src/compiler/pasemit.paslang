  Line('.axs_die:');
  Line('  ldr x0, [sp, #16]');
  Line('  sub x0, x0, #1');
  Line('  b rt_diesendclosed');
  Line('rt_tryrecv:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  Line('.axr_lock:');
  Line('  ldaxr w9, [x19]');
  Line('  cbnz w9, .axr_lock');
  Line('  mov w10, #1');
  Line('  stxr w11, w10, [x19]');
  Line('  cbnz w11, .axr_lock');
