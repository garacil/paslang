  Line('  add x9, x5, #1');
  LeaS('rt_strbig', 'x10');
  Line('  mov x11, #68');
  Line('.asgx_l:');
  Line('  ldr x12, [x10]');
  Line('  cmp x9, x12');
  Line('  b.ls .asgx_f');
  Line('  add x10, x10, #8');
  Line('  add x11, x11, #1');
  Line('  cmp x11, #128');
  Line('  b.lo .asgx_l');
  Line('  mov x0, xzr');
  Line('  b .asgx_ret');
  Line('.asgx_f:');
  Line('  mov x2, x12');
  Line('  sub x1, x1, #1');
