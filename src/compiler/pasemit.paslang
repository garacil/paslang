  Line('  movq %rdi, %rax');
  Line('  shrq $48, %rax');
  Line('  incq %rax');
  Line('  shlq $16, %rdi');
  Line('  shrq $16, %rdi');
  Line('  xorl %ecx, %ecx');
  Line('  lock cmpxchgq %rcx, 192(%rdi)');
  Line('  jne .pw_out');
  Line('  jmp rt_ready');
  Line('.pw_out:');
  Line('  ret');
  Line('');
  Line('.globl rt_waitfd');
  Line('rt_waitfd:');
  Line('  movq $1, %rsi');
