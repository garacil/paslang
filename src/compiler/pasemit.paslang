  Line('  movabsq $1099511627776, %rax');
  Line('  cmpq %rax, %rdx');
  Line('  jbe .wm_ms');
  Line('  movq %rax, %rdx');
  Line('.wm_ms:');
  Line('  pushq %rdi');
  Line('  pushq %rsi');
  Line('  pushq %rdx');
  Line('  call rt_now');
  Line('  popq %rdx');
  Line('  popq %rsi');
  Line('  popq %rdi');
  Line('  imulq $1000000, %rdx, %rdx');
  Line('  addq %rax, %rdx');
  Line('  jmp rt_waitio2');
  Line('.wm_ret:');
  Line('  xorl %eax, %eax');
  Line('  ret');
