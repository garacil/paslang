  Line('  b.ls .asl_sc');
  Line('  mov x26, x20');
  Line('.asl_sc:');
  Line('  str x9, [sp, #-16]!');
  Line('  mov x0, x9');
  Line('.asl_sl:');
  Line('  cbz x26, .asl_sd');
  Line('  mov x1, x25');
  Line('  bl rt_strshare');
  Line('  add x0, x0, x21');
  Line('  sub x26, x26, #1');
  Line('  b .asl_sl');
  Line('.asl_sd:');
  Line('  ldr x9, [sp], #16');
  Line('.asl_nodata:');
  Line('  str x9, [x19]');
  Line('  str x20, [x19, #8]');
  Line('  str x24, [x19, #16]');
  Line('  cmp x24, x20');
  Line('  b.ls .asl_ret');
  Line('  mul x10, x24, x21');
  Line('  str x20, [x9, x10]');
  Line('  b .asl_ret');
  { As on amd64 (P214, P222): a string whose mark is clear keeps its
    block when it gets shorter or keeps its length, while the block is
    32 bytes or less or the new size (the mark and the characters) more
    than half of it (rt_memsize; rt_gocall keeps every register but x0,
    the stack and globals paths change x9 and x10). b.hi is unsigned
    higher (C == 1 && Z == 0) and b.ls unsigned lower or same (ARM ARM
    C1.2.4), ldurb loads the mark below the characters (C6.2.260), tbnz
    tests its bit 0 (C6.2.478), cmp is subs to the zero register
    (C6.2.96), lsr by 1 halves unsigned (C6.2.273). }
  Line('.asl_str:');
  Line('  ldr x9, [x19, #8]');
  Line('  cmp x20, x9');
  Line('  b.hi .asl_snew');
  Line('  cbz x20, .asl_snew');
  Line('  ldr x10, [x19]');
  Line('  ldurb w11, [x10, #-1]');
  Line('  tbnz w11, #0, .asl_snew');
  Line('  sub x0, x10, #1');
  Line('  bl rt_memsize');
  Line('  cmp x0, #32');
  Line('  b.ls .asl_skeep');
  Line('  lsr x0, x0, #1');
  Line('  mul x9, x20, x21');
  Line('  add x9, x9, #1');
  Line('  cmp x9, x0');
  Line('  b.ls .asl_snew');
  Line('.asl_skeep:');
  Line('  str x20, [x19, #8]');
  Line('  b .asl_ret');
  Line('.asl_snew:');
  Line('  mul x0, x20, x21');
  Line('  bl rt_stralloc');
  Line('  mov x9, x0');
  Line('  ldr x1, [x19]');
  Line('  ldr x2, [x19, #8]');
  Line('  mul x2, x2, x21');
  Line('  mul x10, x20, x21');
  Line('  cmp x2, x10');
  Line('  b.ls .asl_sok');
  Line('  mov x2, x10');
  Line('.asl_sok:');
  Line('  cbz x1, .asl_snodata');
  Line('  mov x0, x9');
  Line('  str x9, [sp, #-16]!');
  Line('  bl rt_memcpy');
  Line('  ldr x9, [sp], #16');
  Line('.asl_snodata:');
  Line('  str x9, [x19]');
  Line('  str x20, [x19, #8]');
  Line('.asl_ret:');
  Line('  ldp x25, x26, [sp], #16');
  Line('  ldp x23, x24, [sp], #16');
  Line('  ldp x21, x22, [sp], #16');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  { x0 fd. epoll ADD or MOD, then park. arm64 event is 16 bytes. }
  { ReadLn is Pascal, as on amd64 (1.0.57); x0 the string. }
  Line('.weak p_pasroutines_pasreadln');
  Line('rt_readln:');
  Line('  b p_pasroutines_pasreadln');
  Line('rt_waitfd:');
  Line('  mov x1, #1');
  Line('  b rt_waitio');
  Line('  .ltorg');
end;

function EmitAmd64(const Prog: TProgram): string;
var
  em: TEmitter;
begin
  em := TEmitter.Create;
  try
    em.FArm := False;
    em.FMulCTune := -1;
    Result := em.Emit(Prog);
  finally
    em.Free;
  end;
end;

function EmitArm64(const Prog: TProgram): string;
var
  em: TEmitter;
begin
  em := TEmitter.Create;
  try
    em.FArm := True;
    em.FMulCTune := -1;
    Result := em.Emit(Prog);
  finally
    em.Free;
  end;
end;

end.
