    the milliseconds until the earliest left on any P, or -1 when there
    is none, and rdx that earliest wake time (all ones with none), as
    Go's poller sleeps to checkTimersNoP's pollUntil. }
  Line('rt_checktimers:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  call rt_now');
  Line('  movq %rax, %r12');
  Line('  xorq %r15, %r15');
