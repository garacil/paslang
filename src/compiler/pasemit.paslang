  Line('  call rt_unlock');
  Line('.gm_ret:');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
end;

procedure TEmitter.EmitIO;
begin
  { Hand-off like a mutex. A waiting G parks; the M runs other routines. }
  Line('rt_printlock:');
  Line('  leaq rt_printlk(%rip), %rdi');
  Line('  call rt_lock');
  Line('  cmpl $0, rt_printheld(%rip)');
  Line('  jne .pl_wait');
  Line('  movl $1, rt_printheld(%rip)');
  Line('  leaq rt_printlk(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  ret');
  Line('.pl_wait:');
  Line('  leaq rt_printq(%rip), %rdi');
  Line('  call rt_qwait');
  Line('  leaq rt_printlk(%rip), %rdi');
  Line('  call rt_parkunlock');
  Line('  ret');
  Line('rt_printunlock:');
  Line('  pushq %rbx');
  Line('  leaq rt_printlk(%rip), %rdi');
  Line('  call rt_lock');
  Line('  leaq rt_printq(%rip), %rdi');
  Line('  call rt_qwake1');
  Line('  testq %rax, %rax');
  Line('  jz .pu_free');
  Line('  movq %rax, %rbx');
  Line('  leaq rt_printlk(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  movq %rbx, %rdi');
  Line('  call rt_ready');
  Line('  popq %rbx');
  Line('  ret');
  Line('.pu_free:');
  Line('  movl $0, rt_printheld(%rip)');
  Line('  leaq rt_printlk(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('rt_poke:');
  Line('  movq rt_evfd(%rip), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .pk2_done');
  Line('  subq $8, %rsp');
  Line('  movq $1, (%rsp)');
  Line('  movq %rsp, %rsi');
  Line('  movq $8, %rdx');
  Line('  movq $1, %rax');
  Line('  syscall');
  Line('  addq $8, %rsp');
  Line('.pk2_done:');
  Line('  ret');
  Line('');
  Line('rt_ioinit:');
  Line('  xorq %rdi, %rdi');
  Line('  movq $291, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  js rt_dieepoll');
  Line('  movq %rax, rt_epfd(%rip)');
  Line('  xorq %rdi, %rdi');
  Line('  movq $2048, %rsi');
  Line('  movq $290, %rax');
  Line('  syscall');
  Line('  movq %rax, rt_evfd(%rip)');
  Line('  subq $16, %rsp');
  Line('  movl $1, (%rsp)');
  Line('  movq $1, 4(%rsp)');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  movq $1, %rsi');
  Line('  movq %rax, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  Line('  addq $16, %rsp');
  Line('  movq $0, %rdi');
  Line('  movq $3, %rsi');
  Line('  movq $72, %rax');
  Line('  syscall');
  Line('  orq $2048, %rax');
  Line('  movq %rax, %rdx');
  Line('  movq $0, %rdi');
  Line('  movq $4, %rsi');
  Line('  movq $72, %rax');
  Line('  syscall');
  Line('  movq $1, %rdi');
  Line('  movq $3, %rsi');
  Line('  movq $72, %rax');
  Line('  syscall');
  Line('  orq $2048, %rax');
  Line('  movq %rax, %rdx');
  Line('  movq $1, %rdi');
  Line('  movq $4, %rsi');
  Line('  movq $72, %rax');
  Line('  syscall');
  Line('  movq $2, %rdi');
  Line('  movq $3, %rsi');
  Line('  movq $72, %rax');
  Line('  syscall');
  Line('  orq $2048, %rax');
  Line('  movq %rax, %rdx');
  Line('  movq $2, %rdi');
  Line('  movq $4, %rsi');
  Line('  movq $72, %rax');
  Line('  syscall');
  Line('  ret');
  Line('');
  { rt_now: CLOCK_MONOTONIC in ns through the vDSO's clock_gettime when
    the kernel gave one (rt_vdsocgt, found by rt_vdsoinit), as Go's
    nanotime does: a tenth of the system call's cost, and the mutex
    reads the clock at every park (P98). The vDSO is C code: r8, r9 and
    r10, which the system call kept, are kept here too. }
  Line('rt_now:');
  Line('  movq rt_vdsocgt(%rip), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .now_sys');
  Line('  pushq %r8');
  Line('  pushq %r9');
  Line('  pushq %r10');
  Line('  pushq %rbp');
  Line('  movq %rsp, %rbp');
  Line('  subq $16, %rsp');
  Line('  andq $-16, %rsp');
  Line('  movq $1, %rdi');
  Line('  movq %rsp, %rsi');
  Line('  call *%rax');
  Line('  movq (%rsp), %rax');
  Line('  movq $1000000000, %rcx');
  Line('  mulq %rcx');
  Line('  addq 8(%rsp), %rax');
  Line('  movq %rbp, %rsp');
  Line('  popq %rbp');
  Line('  popq %r10');
  Line('  popq %r9');
  Line('  popq %r8');
  Line('  ret');
  Line('.now_sys:');
  Line('  subq $16, %rsp');
  Line('  movq $1, %rdi');
  Line('  movq %rsp, %rsi');
  Line('  movq $228, %rax');
  Line('  syscall');
  Line('  movq (%rsp), %rax');
  Line('  movq $1000000000, %rcx');
  Line('  mulq %rcx');
  Line('  addq 8(%rsp), %rax');
  Line('  addq $16, %rsp');
  Line('  ret');
  Line('');
  Line('rt_sleep:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  call rt_now');
  Line('  movq $1000000, %rcx');
  Line('  imulq %rcx, %rbx');
  Line('  addq %rax, %rbx');
  Line('  movq %rbx, 208(%r14)');
  Line('  movq $0, 264(%r14)');
  Line('  movl $1, 152(%r14)');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  movq %r14, %rdi');
  Line('  call rt_tins');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  { A new timer may be earlier than the deadline the poller sleeps on:
    poke it out of epoll_wait so it recomputes (Go's wakeNetPoller). }
  Line('  call rt_poke');
  Line('  popq %rbx');
  Line('  call rt_parkmarked');
  Line('  ret');
  Line('');
  { The timers (P115, 1.1.1): a binary min-heap of routines by wake time,
    at rt_theap (64 MB of address space mapped the first time, pages
    touched as it grows), its count in rt_sleeph, a routine's index + 1
    at G+216 (0 when it is in no heap), its wake time at G+208 and, for
    a wait on a descriptor with a deadline, the wait's token at G+264
    (0 for Sleep). Insert, delete and a look at the earliest are
    O(log n) and O(1), as Go's timer heaps; the list it replaces was
    walked whole at every look. rt_timer0 is the earliest wake time, all
    ones when there is none. rt_glock is held for all of them.
    rt_tsift: rdi an index; the routine there goes up while its parent
    wakes later, then down while a child wakes earlier, and every
    routine moved gets its new index. Caller-saved registers only. }
  Line('rt_tsift:');
  Line('  movq rt_theap(%rip), %r8');
  Line('  movq (%r8,%rdi,8), %r9');
  Line('  movq 208(%r9), %r10');
  Line('.ts_up:');
  Line('  testq %rdi, %rdi');
  Line('  jz .ts_dn');
  Line('  leaq -1(%rdi), %rsi');
  Line('  shrq $1, %rsi');
  Line('  movq (%r8,%rsi,8), %r11');
  Line('  cmpq 208(%r11), %r10');
  Line('  jae .ts_dn');
  Line('  movq %r11, (%r8,%rdi,8)');
  Line('  leaq 1(%rdi), %rax');
  Line('  movq %rax, 216(%r11)');
  Line('  movq %rsi, %rdi');
  Line('  jmp .ts_up');
  Line('.ts_dn:');
  Line('  leaq 1(%rdi,%rdi), %rsi');
  Line('  cmpq rt_sleeph(%rip), %rsi');
  Line('  jae .ts_put');
  Line('  movq (%r8,%rsi,8), %r11');
  Line('  leaq 1(%rsi), %rdx');
  Line('  cmpq rt_sleeph(%rip), %rdx');
  Line('  jae .ts_cmp');
  Line('  movq (%r8,%rdx,8), %rax');
  Line('  movq 208(%rax), %rcx');
  Line('  cmpq 208(%r11), %rcx');
  Line('  jae .ts_cmp');
  Line('  movq %rdx, %rsi');
  Line('  movq %rax, %r11');
  Line('.ts_cmp:');
  Line('  cmpq 208(%r11), %r10');
  Line('  jbe .ts_put');
  Line('  movq %r11, (%r8,%rdi,8)');
  Line('  leaq 1(%rdi), %rax');
  Line('  movq %rax, 216(%r11)');
  Line('  movq %rsi, %rdi');
  Line('  jmp .ts_dn');
  Line('.ts_put:');
  Line('  movq %r9, (%r8,%rdi,8)');
  Line('  leaq 1(%rdi), %rax');
  Line('  movq %rax, 216(%r9)');
  Line('  ret');
  Line('');
  { rt_tins: rdi a routine with its wake time at G+208 and token at
    G+264 goes into the heap, or moves where it is if it is there. }
  Line('rt_tins:');
  Line('  cmpq $0, rt_theap(%rip)');
  Line('  jne .ti_have');
  Line('  pushq %rdi');
  Line('  xorq %rdi, %rdi');
  Line('  movq $67108864, %rsi');
  Line('  movq $3, %rdx');
  Line('  movq $0x4022, %r10');
  Line('  movq $-1, %r8');
  Line('  xorq %r9, %r9');
  Line('  movq $9, %rax');
  Line('  syscall');
  Line('  popq %rdi');
  Line('  testq %rax, %rax');
  Line('  jns .ti_mapped');
  Line('  jmp rt_diemmap');
  Line('.ti_mapped:');
  Line('  movq %rax, rt_theap(%rip)');
  Line('.ti_have:');
  Line('  movq 216(%rdi), %rax');
  Line('  testq %rax, %rax');
  Line('  jnz .ti_again');
  Line('  movq rt_sleeph(%rip), %rax');
  Line('  cmpq $8388608, %rax');
  Line('  jb .ti_room');
  Line('  jmp rt_dietoobig');
  Line('.ti_room:');
  Line('  movq rt_theap(%rip), %r8');
  Line('  movq %rdi, (%r8,%rax,8)');
  Line('  leaq 1(%rax), %rcx');
  Line('  movq %rcx, 216(%rdi)');
  Line('  movq %rcx, rt_sleeph(%rip)');
  Line('  movq %rax, %rdi');
  Line('  call rt_tsift');
  Line('  jmp .ti_t0');
  Line('.ti_again:');
  Line('  leaq -1(%rax), %rdi');
  Line('  call rt_tsift');
  Line('.ti_t0:');
  Line('  movq rt_theap(%rip), %r8');
  Line('  movq (%r8), %rax');
  Line('  movq 208(%rax), %rax');
  Line('  movq %rax, rt_timer0(%rip)');
  Line('  ret');
  Line('');
  { rt_tdel: rdi a routine; out of the heap if it is in it. }
  Line('rt_tdel:');
  Line('  movq 216(%rdi), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .td_ret');
  Line('  movq $0, 216(%rdi)');
  Line('  decq %rax');
  Line('  movq rt_sleeph(%rip), %rcx');
  Line('  decq %rcx');
  Line('  movq %rcx, rt_sleeph(%rip)');
  Line('  cmpq %rcx, %rax');
  Line('  je .td_t0');
  Line('  movq rt_theap(%rip), %r8');
  Line('  movq (%r8,%rcx,8), %r9');
  Line('  movq %r9, (%r8,%rax,8)');
  Line('  leaq 1(%rax), %rdx');
  Line('  movq %rdx, 216(%r9)');
  Line('  movq %rax, %rdi');
  Line('  call rt_tsift');
  Line('.td_t0:');
  Line('  movq $-1, %rax');
  Line('  cmpq $0, rt_sleeph(%rip)');
  Line('  je .td_set');
  Line('  movq rt_theap(%rip), %r8');
  Line('  movq (%r8), %rax');
  Line('  movq 208(%rax), %rax');
  Line('.td_set:');
  Line('  movq %rax, rt_timer0(%rip)');
  Line('.td_ret:');
  Line('  ret');
  Line('');
  { rt_checktimers: the routines whose time has come are taken off the
    heap with the lock held, into a batch of 32 on this stack with the
    token each needs (read while the lock keeps the routine from moving
    on), and woken once it is dropped: a Sleep readied, a deadline wait
    through its token, which does nothing when the descriptor woke it
    first. A full batch is woken and the heap looked at again. rax: the
    milliseconds until the next one, or -1 when there is none. }
  Line('rt_checktimers:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  subq $520, %rsp');
  Line('  call rt_now');
  Line('  movq %rax, %r12');
  Line('.ct_batch:');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_lock');
  Line('  xorq %rbx, %rbx');
  Line('  movq $-1, %r13');
  Line('.ct_n:');
  Line('  cmpq $0, rt_sleeph(%rip)');
  Line('  je .ct_unl');
  Line('  movq rt_theap(%rip), %rax');
  Line('  movq (%rax), %r15');
  Line('  movq 208(%r15), %rcx');
  Line('  cmpq %r12, %rcx');
  Line('  ja .ct_later');
  Line('  cmpq $32, %rbx');
  Line('  jae .ct_more');
  Line('  movq %r15, %rdi');
  Line('  call rt_tdel');
  Line('  movq %rbx, %rcx');
  Line('  shlq $4, %rcx');
  Line('  movq %r15, (%rsp,%rcx)');
  Line('  movq 264(%r15), %rax');
  Line('  movq %rax, 8(%rsp,%rcx)');
  Line('  incq %rbx');
  Line('  jmp .ct_n');
  Line('.ct_more:');
  Line('  movq $-2, %r13');
  Line('  jmp .ct_unl');
  Line('.ct_later:');
  Line('  movq %rcx, %rax');
  Line('  subq %r12, %rax');
  Line('  xorq %rdx, %rdx');
  Line('  movq $1000000, %rcx');
  Line('  divq %rcx');
  Line('  incq %rax');
  Line('  movq %rax, %r13');
  Line('.ct_unl:');
  Line('  leaq rt_glock(%rip), %rdi');
  Line('  call rt_unlock');
  Line('  xorq %r15, %r15');
  Line('.ct_rd:');
  Line('  cmpq %rbx, %r15');
  Line('  jae .ct_bd');
  Line('  movq %r15, %rcx');
  Line('  shlq $4, %rcx');
  Line('  movq 8(%rsp,%rcx), %rax');
  Line('  testq %rax, %rax');
  Line('  jnz .ct_tok');
  Line('  movq (%rsp,%rcx), %rdi');
  Line('  call rt_ready');
  Line('  jmp .ct_nx');
  Line('.ct_tok:');
  Line('  movq %rax, %rdi');
  Line('  call rt_pollwake');
  Line('.ct_nx:');
  Line('  incq %r15');
  Line('  jmp .ct_rd');
  Line('.ct_bd:');
  Line('  cmpq $-2, %r13');
  Line('  je .ct_batch');
  Line('  movq %r13, %rax');
  Line('  addq $520, %rsp');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('rt_idlepoll:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  call rt_checktimers');
  Line('  movq %rax, %rbx');
  Line('  call rt_findrunnable');
  Line('  testq %rax, %rax');
  Line('  jnz .ip_g');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .ip_none');
  { The last look found nothing: this M sleeps (rt_msleep), and when it
    is the last one to, checks for a deadlock (1.0.139). }
  Line('  call rt_msleepin');
  { epoll_wait(epfd, events, 16, timeout): the fourth argument of a
    system call travels in r10, never rcx (SYSCALL clobbers rcx). With
    rcx the timeout was whatever r10 held, usually 0, and every idle M
    spun at full speed. -1 from rt_checktimers blocks until an event. }
  Line('  subq $192, %rsp');
  Line('  movq %rsp, %rsi');
  Line('  movq $16, %rdx');
  Line('  movq %rbx, %r10');
  Line('  movq $232, %rax');
  Line('  syscall');
  Line('  movq %rax, %rbx');
  Line('  call rt_msleepout');
  Line('  call rt_now');
  Line('  movq %rax, rt_lastpoll(%rip)');
  Line('  xorq %r12, %r12');
  Line('.ip_ev:');
  Line('  cmpq %rbx, %r12');
  Line('  jge .ip_ed');
  Line('  movq %r12, %rax');
  Line('  movq $12, %rcx');
  Line('  mulq %rcx');
  Line('  leaq (%rsp, %rax), %r8');
  Line('  movq 4(%r8), %rdi');
  Line('  cmpq $1, %rdi');
  Line('  je .ip_drain');
  Line('  call rt_pollwake');
  Line('  jmp .ip_nx');
  Line('.ip_drain:');
  Line('  subq $8, %rsp');
  Line('  movq rt_evfd(%rip), %rdi');
  Line('  movq %rsp, %rsi');
  Line('  movq $8, %rdx');
  Line('  xorq %rax, %rax');
  Line('  syscall');
  Line('  addq $8, %rsp');
  Line('.ip_nx:');
  Line('  incq %r12');
  Line('  jmp .ip_ev');
  Line('.ip_ed:');
  Line('  addq $192, %rsp');
  Line('.ip_none:');
  Line('  xorq %rax, %rax');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('.ip_g:');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  { A look at the poller without waiting (1.1.1): from an M whose
    queues ran dry, before it steals, and from sysmon when no M has
    looked for 10 ms, as Go's findrunnable and sysmon do. Under a burst
    that kept every M busy with runnable routines nobody polled, the
    routines the descriptors woke stayed parked, and a datagram
    server's socket overflowed (the kernel's RcvbufErrors counted
    1262 of 10,000 queries). Every event readies its routine, onto this
    M's P or the global queue; rt_lastpoll notes the time. }
  Line('rt_netpoll0:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .np_none');
  Line('  subq $192, %rsp');
  Line('  movq %rsp, %rsi');
  Line('  movq $16, %rdx');
  Line('  xorq %r10, %r10');
  Line('  movq $232, %rax');
  Line('  syscall');
  Line('  movq %rax, %rbx');
  Line('  call rt_now');
  Line('  movq %rax, rt_lastpoll(%rip)');
  Line('  xorq %r12, %r12');
  Line('.np_ev:');
  Line('  cmpq %rbx, %r12');
  Line('  jge .np_ed');
  Line('  movq %r12, %rax');
  Line('  movq $12, %rcx');
  Line('  mulq %rcx');
  Line('  leaq (%rsp, %rax), %r8');
  Line('  movq 4(%r8), %rdi');
  { the poke (token 1) is for the M asleep in the idle poller: left
    alone, since the eventfd is level-triggered and that M drains it;
    reading it here lost its wake and sync1 hung }
  Line('  cmpq $1, %rdi');
  Line('  je .np_nx');
  Line('  call rt_pollwake');
  Line('.np_nx:');
  Line('  incq %r12');
  Line('  jmp .np_ev');
  Line('.np_ed:');
  Line('  addq $192, %rsp');
  Line('.np_none:');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('rt_sysmon:');
  Line('  subq $16, %rsp');
  Line('.sm_sleep:');
  Line('  movq $0, (%rsp)');
  Line('  movq $10000000, 8(%rsp)');
  Line('  movq %rsp, %rdi');
  Line('  xorq %rsi, %rsi');
  Line('  movq $35, %rax');
  Line('  syscall');
  { The poller when no M has looked at it for 10 ms (1.1.1): sysmon
    looks, on a dummy M with no P so the routines go to the global
    queue and an M is woken for them. }
  Line('  cmpq $0, rt_epfd(%rip)');
  Line('  je .sm_chk');
  Line('  call rt_now');
  Line('  subq rt_lastpoll(%rip), %rax');
  Line('  cmpq $10000000, %rax');
  Line('  jb .sm_chk');
  Line('  leaq rt_sysm(%rip), %r13');
  Line('  xorq %r14, %r14');
  Line('  call rt_netpoll0');
  Line('.sm_chk:');
  { No M idle, none spinning, one not started yet, and a routine besides
    main or one asleep: the timers and the descriptors have no poller
    while every M runs or waits in a system call (P91: before, 31 idle
    Ms kept one). rt_wakep starts one, which polls when it finds nothing
    to run, as Go's sysmon starts an M for a P a system call holds. }
  Line('  cmpq $0, rt_nidle(%rip)');
  Line('  jne .sm_scan0');
  Line('  cmpq $0, rt_nspinning(%rip)');
  Line('  jne .sm_scan0');
  Line('  movq rt_mstarted(%rip), %rax');
  Line('  cmpq rt_nproc(%rip), %rax');
  Line('  jae .sm_scan0');
  Line('  cmpq $1, rt_nlive(%rip)');
  Line('  ja .sm_wake');
  Line('  cmpq $0, rt_sleeph(%rip)');
  Line('  je .sm_scan0');
  Line('.sm_wake:');
  Line('  call rt_wakep');
  Line('.sm_scan0:');
  Line('  movq rt_nproc(%rip), %r12');
  Line('  xorq %r15, %r15');
  Line('.sm_scan:');
  Line('  cmpq %r12, %r15');
  Line('  jae .sm_sleep');
  Line('  movq %r15, %rax');
  Line('  shlq $7, %rax');
  Line('  leaq rt_allm(%rip), %rbx');
  Line('  addq %rax, %rbx');
  Line('  movq 16(%rbx), %rax');
  Line('  testq %rax, %rax');
