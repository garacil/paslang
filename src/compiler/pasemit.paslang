  Line('  leaq rt_allm(%rip), %rax');
  Line('  movq rt_mstarted(%rip), %rcx');
  Line('.cm_n:');
  Line('  testq %rcx, %rcx');
  Line('  jz .cm_r13');
  Line('  movq 32(%rax), %rdx');
  Line('  cmpq %rdx, %rsp');
  Line('  ja .cm_nx');
  Line('  subq $32768, %rdx');
  Line('  cmpq %rdx, %rsp');
  Line('  jb .cm_nx');
  Line('  ret');
  Line('.cm_nx:');
  Line('  addq $128, %rax');
