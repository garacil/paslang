  Line('  movl 16(%rbx), %eax');
  Line('  movl 20(%rbx), %ecx');
  Line('  movl %ecx, %edx');
  Line('  subl %eax, %edx');
  Line('  cmpl $256, %edx');
  Line('  jb .qps_notfull');
  Line('  shrl $1, %edx');
  Line('  movl %eax, %r8d');
  Line('  addl %edx, %r8d');
  Line('  lock cmpxchgl %r8d, 16(%rbx)');
