  Line('  ldaxr w9, [x19]');
  Line('  cbnz w9, .axs_lock');
  Line('  mov w10, #1');
  Line('  stxr w11, w10, [x19]');
  Line('  cbnz w11, .axs_lock');
  Line('  ldr x9, [x19, #8]');
  Line('  cbnz x9, .axs_die');
  Line('  add x0, x19, #16');
  Line('  bl rt_cqtake');
  Line('  cbz x0, .axs_buf');
  Line('  str x20, [x0, #16]');
  Line('  ldr x0, [x0, #8]');
  Line('  stlr wzr, [x19]');
  Line('  bl rt_ready');
  Line('  mov x0, #1');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
