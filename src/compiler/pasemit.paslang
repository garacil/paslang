  Line('  movq %r14, 8(%rdi)');
  Line('  ret');
  Line('.qwb_first:');
  Line('  movq %r14, (%rdi)');
  Line('  movq %r14, 8(%rdi)');
  Line('  ret');
  Line('rt_qwaitfront:');
  Line('  movq (%rdi), %rax');
  Line('  movq %rax, 232(%r14)');
  Line('  movq %r14, (%rdi)');
  Line('  testq %rax, %rax');
  Line('  jnz .qwf_ret');
  Line('  movq %r14, 8(%rdi)');
