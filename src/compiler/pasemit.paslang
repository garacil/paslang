  Line('  mov x11, xzr');
  Line('.acbg_h:');
  Line('  str x11, [x19, #72]');
  Line('  sub x10, x10, #1');
  Line('  str x10, [x19, #64]');
  Line('  add x0, x19, #32');
  Line('  bl rt_cqtake');
  Line('  mov x2, xzr');
