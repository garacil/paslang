  Line('  movq $3, %rsi');
  Line('  movq %rbx, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  Line('  testq %rax, %rax');
  Line('  jns .wi_success');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  movq $1, %rsi');
  Line('  movq %rbx, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  { P180: current Go netpoll_epoll.go netpollopen reports EpollCtl
    errors. Never park on a registration that failed. Self-wake through
    the SAME token/status protocol as an event or deadline; a deadline
    racing this failure can win the token without queuing a running G.
    A slot on G's saved stack keeps the result across park, stack
    movement and timer cleanup; no live register survives a park. }
