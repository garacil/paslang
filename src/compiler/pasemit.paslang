  Line('  mov x0, xzr');
  Line('  ret');
  { rt_chbget: x0 a locked channel; x1 1 and x0 the oldest word, or x1 0
    when empty; a sender waiting for room moves its word in, its G in x2
    (else 0). x9-x13 change. }
  Line('rt_chbget:');
  Line('  mov x2, xzr');
  Line('  ldr x9, [x0, #48]');
  Line('  cbz x9, .acbg_none');
  Line('  ldr x10, [x0, #64]');
  Line('  cbz x10, .acbg_none');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  ldr x9, [x19, #48]');
  Line('  ldr x11, [x19, #72]');
  Line('  ldr x20, [x9, x11, lsl #3]');
  Line('  str xzr, [x9, x11, lsl #3]');
