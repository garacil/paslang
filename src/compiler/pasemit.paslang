function TEmitter.Emit(const Prog: TProgram): string;
var
  i, j, k, mi: SizeInt;
  sz, rp: LongInt;
  sruns: TInt64Arr;
  msym: string;
  gw: TGcBits;
begin
  FOut := '';
  FLen := 0;
  FLab := 0;
  FCheckPtr := Prog.CheckPtr;
  FCpuSet := Prog.CpuSet;
  FDebug := Prog.Debug;
  FDbgFn := '';
  FLastIns := '';
  FStrs := nil;
  FGcTypes := nil;
  FGcInst := nil;
  FRootWords := nil;
  FMapOn := False;
  FMapPro := False;
  FMapSpOk := False;
  FMapSites := nil;
  FMapOut := nil;
  FMapOutN := 0;
  FDescOut := nil;
  FDescN := 0;
  FDescHash := nil;
  FMapLab := 0;
  FPushK := nil;
  FPushHint := nil;
  FScrOff := nil;
  FScrK := nil;
  FScrHint := 2;
  FScrHintW := nil;
  FTryPush := nil;
  FBrk := nil;
  FCont := nil;
  FEpi := '.Lepi0';
  FScratchOff := 0;
  FScratchCur := 0;
  FTypes := Prog.Types;
  FResName := '';
  FResOff := 0;
  FHasRes := False;
  FResTyp := TyNone;
  LoadGlobals(Prog);
  FNest := 0;
  FProgProcs := Prog.Procs;
