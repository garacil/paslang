  else if Op = 'cmpltf32' then
    Result := 'vcmpltps'
  else if Op = 'cmpltf64' then
    Result := 'vcmpltpd'
  else if Op = 'cmplef32' then
    Result := 'vcmpleps'
  else if Op = 'cmplef64' then
    Result := 'vcmplepd';
end;

{ NEON's, by the word less its lane. }
function TEmitter.VecNeon(const Op: string): string;
var
  b: string;
begin
  Result := '';
  b := Op;
  while (Length(b) > 0) and (b[Length(b)] >= '0') and (b[Length(b)] <= '9') do
    SetLength(b, Length(b) - 1);
  if b = 'add' then
    Result := 'add'
  else if b = 'sub' then
    Result := 'sub'
  else if b = 'addsatu' then
    Result := 'uqadd'
  else if b = 'addsats' then
    Result := 'sqadd'
  else if b = 'subsatu' then
    Result := 'uqsub'
  else if b = 'subsats' then
    Result := 'sqsub'
  else if b = 'mul' then
    Result := 'mul'
  else if b = 'avgu' then
    Result := 'urhadd'
  else if b = 'minu' then
    Result := 'umin'
  else if b = 'maxu' then
    Result := 'umax'
  else if b = 'mins' then
    Result := 'smin'
  else if b = 'maxs' then
    Result := 'smax'
  else if b = 'cmpeq' then
    Result := 'cmeq'
  else if b = 'cmpgts' then
    Result := 'cmgt'
  else if b = 'cmpgtu' then
    Result := 'cmhi'
  else if b = 'and' then
    Result := 'and'
  else if b = 'or' then
    Result := 'orr'
  else if b = 'xor' then
    Result := 'eor'
  else if b = 'ziplo' then
    Result := 'zip1'
  else if b = 'ziphi' then
    Result := 'zip2'
  else if b = 'addf' then
    Result := 'fadd'
  else if b = 'subf' then
    Result := 'fsub'
  else if b = 'mulf' then
    Result := 'fmul'
  else if b = 'divf' then
    Result := 'fdiv'
  else if b = 'cmpeqf' then
    Result := 'fcmeq';
end;

{ The slot of an operand the first phase pushed: its distance from the
  stack pointer. }
function TEmitter.VecSlot(E: PExpr): LongInt;
var
  j: SizeInt;
begin
  Result := -1;
  for j := 0 to High(FVecItems) do
    if FVecItems[j] = E then
    begin
      if FArm then
        Result := (FVecN - 1 - LongInt(j)) * 16
      else
        Result := (FVecN - 1 - LongInt(j)) * 8;
      Exit;
    end;
  Die('vector operand without a slot');
end;

procedure TEmitter.VecCollect(E: PExpr; var Items: TExprArray);
var
  i, n: SizeInt;
  a: PExpr;
begin
  for i := 0 to High(E^.Args) do
  begin
    a := E^.Args[i];
    if VecOp(a) then
      VecCollect(a, Items)
    else if (a^.Kind <> ekInt) and not VecHomeOK(a) then
    begin
      EmitArgVal(a);
      if FArm then
        PshK('x0', ACls(a))
      else
        PushK('rax', ACls(a));
      n := Length(Items);
      SetLength(Items, n + 1);
      Items[n] := a;
    end;
  end;
end;

{ An integer operand of the second phase into Reg: a constant, or its slot. }
procedure TEmitter.VecIntX(E: PExpr; const Reg: string);
begin
  if E^.Kind = ekInt then
  begin
    if (E^.Num >= -2147483648) and (E^.Num <= 2147483647) then
      Line('  movq $' + IntToStr(E^.Num) + ', %' + Reg)
    else
      Line('  movabsq $' + IntToStr(E^.Num) + ', %' + Reg);
  end
  else if FVecDirect then
  begin
    EmitExpr(E);
    if Reg <> 'rax' then
      Line('  movq %rax, %' + Reg);
  end
  else
    Line('  movq ' + IntToStr(VecSlot(E)) + '(%rsp), %' + Reg);
end;

procedure TEmitter.VecIntA(E: PExpr; const Reg: string);
begin
  if E^.Kind = ekInt then
    Imm(Reg, E^.Num)
  else if FVecDirect then
  begin
    EmitExpr(E);
    if Reg <> 'x0' then
      Line('  mov ' + Reg + ', x0');
  end
  else
    Line('  ldr ' + Reg + ', [sp, #' + IntToStr(VecSlot(E)) + ']');
end;

{ Mask m = a > b in R+2 (SSE2), a and b in R and R+1; then R := the
  smaller (Min) or the larger. An unsigned compare flips the top bits
  first. }
procedure TEmitter.VecMinMaxX(R: LongInt; const Cmp: string; Unsigned, IsMin: Boolean);
begin
  if Unsigned then
  begin
    Line('  pcmpeqd ' + VecX(R + 4) + ', ' + VecX(R + 4));
    Line('  pslld $31, ' + VecX(R + 4));
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  pxor ' + VecX(R + 4) + ', ' + VecX(R + 2));
    Line('  movdqa ' + VecX(R + 1) + ', ' + VecX(R + 3));
    Line('  pxor ' + VecX(R + 4) + ', ' + VecX(R + 3));
    Line('  ' + Cmp + ' ' + VecX(R + 3) + ', ' + VecX(R + 2));
  end
  else
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  ' + Cmp + ' ' + VecX(R + 1) + ', ' + VecX(R + 2));
  end;
  if IsMin then
  begin
    Line('  movdqa ' + VecX(R + 1) + ', ' + VecX(R + 3));
    Line('  pand ' + VecX(R + 2) + ', ' + VecX(R + 3));
    Line('  pandn ' + VecX(R) + ', ' + VecX(R + 2));
  end
  else
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 3));
    Line('  pand ' + VecX(R + 2) + ', ' + VecX(R + 3));
    Line('  pandn ' + VecX(R + 1) + ', ' + VecX(R + 2));
  end;
  Line('  por ' + VecX(R + 3) + ', ' + VecX(R + 2));
  Line('  movdqa ' + VecX(R + 2) + ', ' + VecX(R));
end;

{ The sign bit of every lane in register R, for the unsigned compares:
  SSE2 (Mode 0 or 2) or VEX in ymm (1) or xmm (3). }
procedure TEmitter.VecBiasX(R, Lane, Mode: LongInt);
var
  vex: Boolean;
begin
  vex := (Mode = 1) or (Mode = 3);
  if Lane = 8 then
  begin
    Line('  movl $2155905152, %ecx');
    if vex then
    begin
      Line('  vmovd %ecx, ' + VecX(R));
      Line('  vpbroadcastd ' + VecX(R) + ', ' + VecR(R, Mode));
    end
    else
    begin
      Line('  movd %ecx, ' + VecX(R));
      Line('  pshufd $0, ' + VecX(R) + ', ' + VecX(R));
    end;
  end
  else if vex then
  begin
    if Lane = 16 then
    begin
      Line('  vpcmpeqw ' + VecR(R, Mode) + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
      Line('  vpsllw $15, ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
    end
    else
    begin
      Line('  vpcmpeqd ' + VecR(R, Mode) + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
      Line('  vpslld $31, ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
    end;
  end
  else if Lane = 16 then
  begin
    Line('  pcmpeqw ' + VecX(R) + ', ' + VecX(R));
    Line('  psllw $15, ' + VecX(R));
  end
  else
  begin
    Line('  pcmpeqd ' + VecX(R) + ', ' + VecX(R));
    Line('  pslld $31, ' + VecX(R));
  end;
end;

function TEmitter.VecShiftIns(const Op: string): string;
begin
  if Copy(Op, 1, 3) = 'shl' then
    Result := 'psll'
  else if Copy(Op, 1, 4) = 'shru' then
    Result := 'psrl'
  else
    Result := 'psra';
  if VecLane(Op) = 16 then
    Result := Result + 'w'
  else if VecLane(Op) = 32 then
    Result := Result + 'd'
  else
    Result := Result + 'q';
end;

{ Register I of a tree in Mode: ymm in AVX2's 256 bits (1), xmm else. }
function TEmitter.VecR(I, Mode: LongInt): string;
begin
  if Mode = 1 then
    Result := VecY(I)
  else
    Result := VecX(I);
end;

{ A word that reduces a vector to an Integer (1.0.126). }
function TEmitter.VecRed(E: PExpr): Boolean;
begin
  Result := (E <> nil) and (E^.Kind = ekCall) and (E^.Typ = TyInteger) and
    ((E^.Name = 'rt_vmovemask8') or (E^.Name = 'rt_vsumu8') or (E^.Name = 'rt_vsums32') or
    (E^.Name = 'rt_vsum64'));
end;

function TEmitter.VecHasWord(E: PExpr): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  Result := True;
  if VecOp(E) or VecRed(E) then
    Exit;
  if VecHasWord(E^.L) or VecHasWord(E^.R) then
    Exit;
  for i := 0 to High(E^.Args) do
    if VecHasWord(E^.Args[i]) then
      Exit;
  Result := False;
end;

{ A vector word whose operands compute with no call and no other vector
  word (1.0.128): the statement needs no first phase, each operand is
  computed where it is loaded, and a region may hold it. }
function TEmitter.VecPure(E: PExpr): Boolean;
var
  i: SizeInt;
  a: PExpr;
begin
  Result := False;
  for i := 0 to High(E^.Args) do
  begin
    a := E^.Args[i];
    if VecOp(a) then
    begin
      if not VecPure(a) then
        Exit;
    end
    else if (not PromoExprOK(a)) or VecHasWord(a) then
      Exit;
  end;
  Result := True;
end;

{ The root of a vector statement: a word, a reduction, or a vector
  place copied whole (x := p[i], 1.0.128). }
function TEmitter.VecPureRoot(E: PExpr): Boolean;
begin
  if VecOp(E) or VecRed(E) then
    Result := VecPure(E)
  else
    Result := PromoExprOK(E) and not VecHasWord(E);
end;

{ v := w or v := p[i] for vectors that compute with no call: a vector
  statement of one load and one store, which a region may hold. }
function TEmitter.VecCopy(S: PStmt): Boolean;
begin
  Result := (S^.Dest <> nil) and (S^.E <> nil) and
    ((S^.Dest^.Typ = TyV128) or (S^.Dest^.Typ = TyV256)) and (S^.E^.Typ = S^.Dest^.Typ) and
    ((S^.E^.Kind = ekVar) or (S^.E^.Kind = ekIndex) or (S^.E^.Kind = ekField) or
    (S^.E^.Kind = ekDeref)) and VecPureRoot(S^.E) and VecDestPure(S^.Dest);
end;

function TEmitter.VecDestPure(D: PExpr): Boolean;
begin
  Result := (D <> nil) and ((D^.Kind = ekVar) or (D^.Kind = ekField) or (D^.Kind = ekIndex) or
    (D^.Kind = ekDeref)) and PromoExprOK(D) and not VecHasWord(D);
end;

{ A vector variable of the routine's own or a global, read and written
  at its home with no address computed first. }
function TEmitter.VecHomeOK(E: PExpr): Boolean;
var
  s: TSym;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekVar) or ((E^.Typ <> TyV128) and (E^.Typ <> TyV256)) then
    Exit;
  if not TryFindSym(E^.Name, s) then
    Exit;
  Result := (not s.ByRef) and (s.Up = 0);
end;

function TEmitter.VecHome(E: PExpr; Half: LongInt): string;
var
  s: TSym;
begin
  Result := '';
  if not VecHomeOK(E) then
    Exit;
  TryFindSym(E^.Name, s);
  if s.Global then
    Result := VarLabel(s.Name) + '+' + IntToStr(16 * Half) + '(%rip)'
  else
    Result := IntToStr(s.Off + 16 * Half) + '(%rbp)';
end;

{ x9 := the home of a vector variable (arm64). }
procedure TEmitter.VecHomeA(E: PExpr);
var
  s: TSym;
begin
  TryFindSym(E^.Name, s);
  if s.Global then
    LeaS(VarLabel(s.Name), 'x9')
  else
    AddFP('x9', s.Off);
end;

function TEmitter.VecPIdx(E: PExpr): LongInt;
var
  s: TSym;
  i: SizeInt;
begin
  Result := -1;
  if (not FPromoOn) or (Length(FVPromo) = 0) or (E = nil) or (E^.Kind <> ekVar) then
    Exit;
  if not TryFindSym(E^.Name, s) then
    Exit;
  if s.ByRef or (s.Up <> 0) then
    Exit;
  for i := 0 to High(FVPromo) do
    if (FVPromo[i].Place.Global = s.Global) and SamePlace(FVPromo[i].Place, s) then
    begin
      Result := LongInt(i);
      Exit;
    end;
end;

{ The register a promoted variable is in, for half Half in Mode: ymm for
  a V256 in AVX2's copy, the half's xmm else; 'vN' on arm64. '' when E
  is no promoted variable. }
function TEmitter.VecPReg(E: PExpr; Half, Mode: LongInt): string;
var
  i: LongInt;
begin
  Result := '';
  i := VecPIdx(E);
  if i < 0 then
    Exit;
  if FArm then
  begin
    if (Half = 1) and (FVPromo[i].R1 >= 0) then
      Result := 'v' + IntToStr(FVPromo[i].R1)
    else
      Result := 'v' + IntToStr(FVPromo[i].R0);
    Exit;
  end;
  if Mode = 1 then
    Result := '%ymm' + IntToStr(FVPromo[i].R0)
  else if (Half = 1) and (FVPromo[i].R1 >= 0) then
    Result := '%xmm' + IntToStr(FVPromo[i].R1)
  else
    Result := '%xmm' + IntToStr(FVPromo[i].R0);
end;

{ p[i] for p a pointer variable to vectors and i a variable or a constant
  (1.0.128): the operand of its half 0 (half 1 in H1), p in rcx and i
  shifted by the element's size in rax, with no stack traffic; '' when E
  has another shape. }
function TEmitter.VecIdxX(E: PExpr; out H1: string): string;
var
  sp, si: TSym;
  sh, sz: LongInt;
  k: Int64;
  b: string;
begin
  Result := '';
  H1 := '';
  if (E = nil) or (E^.Kind <> ekIndex) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  if TKind(E^.L^.Typ) <> tykPointer then
    Exit;
  if not WordVar(E^.L, sp) then
    Exit;
  sz := FTypes[E^.Typ].Size;
  if sz = 16 then
    sh := 4
  else if sz = 32 then
    sh := 5
  else
    Exit;
  if E^.R^.Kind = ekInt then
  begin
    k := E^.R^.Num * sz;
    if not Fits32(k + 16) then
      Exit;
    if sp.Reg <> '' then
      b := '%' + sp.Reg
    else
    begin
      LoadWordVar(sp, 'rax');
      b := '%rax';
    end;
    Result := IntToStr(k) + '(' + b + ')';
    H1 := IntToStr(k + 16) + '(' + b + ')';
    Exit;
  end;
  if not WordVar(E^.R, si) then
    Exit;
  if sp.Reg <> '' then
    b := '%' + sp.Reg
  else
  begin
    LoadWordVar(sp, 'rcx');
    b := '%rcx';
  end;
  LoadWordVar(si, 'rax');
  Line('  shlq $' + IntToStr(sh) + ', %rax');
  Result := '(' + b + ',%rax)';
  H1 := '16(' + b + ',%rax)';
end;

{ The same on arm64: x9 := the address of p[i]. }
function TEmitter.VecIdxA(E: PExpr): Boolean;
var
  sp, si: TSym;
  sh, sz: LongInt;
  b, x: string;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekIndex) or (E^.L = nil) or (E^.R = nil) then
    Exit;
  if TKind(E^.L^.Typ) <> tykPointer then
    Exit;
  if not WordVar(E^.L, sp) then
    Exit;
  sz := FTypes[E^.Typ].Size;
  if sz = 16 then
    sh := 4
  else if sz = 32 then
    sh := 5
  else
    Exit;
  if E^.R^.Kind = ekInt then
  begin
    LoadWordVar(sp, 'x9');
    if E^.R^.Num <> 0 then
    begin
      Imm('x10', E^.R^.Num * sz);
      Line('  add x9, x9, x10');
    end;
    Result := True;
    Exit;
  end;
  if not WordVar(E^.R, si) then
    Exit;
  if sp.Reg <> '' then
    b := sp.Reg
  else
  begin
    LoadWordVar(sp, 'x9');
    b := 'x9';
  end;
  if si.Reg <> '' then
    x := si.Reg
  else
  begin
    LoadWordVar(si, 'x10');
    x := 'x10';
  end;
  Line('  add x9, ' + b + ', ' + x + ', lsl #' + IntToStr(sh));
  Result := True;
end;

{ A splat of a constant as 32 bytes in the data, aligned on 32 (1.0.128):
  one movdqa or vmovdqa loads it, where a register splat takes three. }
function TEmitter.VecConst(Lane: LongInt; V: Int64): string;
var
  i, n: SizeInt;
begin
  n := Length(FVecCLane);
  for i := 0 to n - 1 do
    if (FVecCLane[i] = Lane) and (FVecCVal[i] = V) then
    begin
      Result := '.Lvc' + IntToStr(i);
      Exit;
    end;
  SetLength(FVecCLane, n + 1);
  SetLength(FVecCVal, n + 1);
  FVecCLane[n] := Lane;
  FVecCVal[n] := V;
  Result := '.Lvc' + IntToStr(n);
end;

{ The register the tree node E writes: the promoted destination for the
  statement's root when there is one, R's else. }
function TEmitter.VecOut(E: PExpr; R, Half, Mode: LongInt): string;
begin
  Result := '';
  if (E = FVecRootE) and (FVecDestE <> nil) then
    Result := VecPReg(FVecDestE, Half, Mode);
  if Result = '' then
  begin
    if FArm then
      Result := 'v' + IntToStr(R + 16)
    else
      Result := VecR(R, Mode);
  end
  else
    FVecRootDone := True;
end;

{ The tree of E into register R on amd64. Mode 0 is SSE2 on 128-bit half
  Half, 2 the same with SSSE3's pshufb, 1 AVX2 on all 256 bits, 3 VEX on
  128 bits (a V128 in AVX2's copy of a region, where no legacy SSE
  instruction may meet ymm registers that hold values). A promoted
  variable is an operand where it lies (1.0.128). }
procedure TEmitter.VecTreeX(E: PExpr; R, Half, Mode: LongInt);
var
  op, ins, cmp, l1, l2, s, a, b, h, h1, o, cnt: string;
  lane: LongInt;
  c: Int64;
  Vex: Boolean;
begin
  Vex := (Mode = 1) or (Mode = 3);
  if R + 4 > 13 - FVecTop then
    Die('a vector expression this deep needs more vector registers than there are: ' +
      'split it into two statements');
  if not VecOp(E) then
  begin
    o := VecOut(E, R, Half, Mode);
    h := VecPReg(E, Half, Mode);
    if h <> '' then
    begin
      if h = o then
        Exit;
      if Vex then
        Line('  vmovdqa ' + h + ', ' + o)
      else
        Line('  movdqa ' + h + ', ' + o);
      Exit;
    end;
    h := VecHome(E, Half);
    if (h = '') and FVecDirect then
    begin
      h := VecIdxX(E, h1);
      if Half = 1 then
        h := h1;
    end;
    if h = '' then
    begin
      if FVecDirect then
        EmitArgVal(E)
      else
        Line('  movq ' + IntToStr(VecSlot(E)) + '(%rsp), %rax');
      h := IntToStr(16 * Half) + '(%rax)';
    end;
    if Vex then
      Line('  vmovdqu ' + h + ', ' + o)
    else
      Line('  movdqu ' + h + ', ' + o);
    Exit;
  end;
  op := Copy(E^.Name, 5, Length(E^.Name) - 4);
  lane := VecLane(op);
  if Copy(op, 1, 5) = 'splat' then
  begin
    o := VecOut(E, R, Half, Mode);
    if (E^.Args[0]^.Kind = ekInt) and (E^.Args[0]^.Num = 0) then
    begin
      if Vex then
        Line('  vpxor ' + o + ', ' + o + ', ' + o)
      else
        Line('  pxor ' + o + ', ' + o);
      Exit;
    end;
    if E^.Args[0]^.Kind = ekInt then
    begin
      if Vex then
        Line('  vmovdqa ' + VecConst(lane, E^.Args[0]^.Num) + '(%rip), ' + o)
      else
        Line('  movdqa ' + VecConst(lane, E^.Args[0]^.Num) + '(%rip), ' + o);
      Exit;
    end;
    VecIntX(E^.Args[0], 'rcx');
    { the xmm register under o }
    if Copy(o, 1, 4) = '%ymm' then
      h := '%xmm' + Copy(o, 5, Length(o) - 4)
    else
      h := o;
    if Vex then
    begin
      Line('  vmovq %rcx, ' + h);
      if lane = 8 then
        Line('  vpbroadcastb ' + h + ', ' + o)
      else if lane = 16 then
        Line('  vpbroadcastw ' + h + ', ' + o)
      else if lane = 32 then
        Line('  vpbroadcastd ' + h + ', ' + o)
      else
        Line('  vpbroadcastq ' + h + ', ' + o);
    end
    else if lane = 64 then
    begin
      Line('  movq %rcx, ' + o);
      Line('  punpcklqdq ' + o + ', ' + o);
    end
    else
    begin
      Line('  movd %ecx, ' + o);
      if lane = 8 then
        Line('  punpcklbw ' + o + ', ' + o);
      if lane <= 16 then
        Line('  punpcklwd ' + o + ', ' + o);
      Line('  pshufd $0, ' + o + ', ' + o);
    end;
    Exit;
  end;
  if op = 'not' then
  begin
    if Vex then
    begin
      a := VecPReg(E^.Args[0], Half, Mode);
      if a = '' then
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        a := VecR(R, Mode);
      end;
      Line('  vpcmpeqd ' + VecR(R + 1, Mode) + ', ' + VecR(R + 1, Mode) + ', ' + VecR(R + 1, Mode));
      Line('  vpxor ' + VecR(R + 1, Mode) + ', ' + a + ', ' + VecOut(E, R, Half, Mode));
    end
    else
    begin
      VecTreeX(E^.Args[0], R, Half, Mode);
      Line('  pcmpeqd ' + VecX(R + 1) + ', ' + VecX(R + 1));
      Line('  pxor ' + VecX(R + 1) + ', ' + VecX(R));
    end;
    Exit;
  end;
  if (Copy(op, 1, 4) = 'sqrt') or (op = 'cvts32f32') then
  begin
    if op = 'sqrtf32' then
      ins := 'sqrtps'
    else if op = 'sqrtf64' then
      ins := 'sqrtpd'
    else
      ins := 'cvtdq2ps';
    if Vex then
    begin
      a := VecPReg(E^.Args[0], Half, Mode);
      if a = '' then
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        a := VecR(R, Mode);
      end;
      Line('  v' + ins + ' ' + a + ', ' + VecOut(E, R, Half, Mode));
    end
    else
    begin
      VecTreeX(E^.Args[0], R, Half, Mode);
      Line('  ' + ins + ' ' + VecX(R) + ', ' + VecX(R));
    end;
    Exit;
  end;
  if op = 'shuffle8' then
  begin
    VecTreeX(E^.Args[0], R, Half, Mode);
    VecTreeX(E^.Args[1], R + 1, Half, Mode);
    { An index past 15 gives 0, as tbl does: 0x70 added with saturation
      keeps 0..15 in the low nibble and sets bit 7 of the others, which
      pshufb reads as zero. }
    if Vex then
    begin
      Line('  movl $1886417008, %ecx');
      Line('  vmovd %ecx, ' + VecX(R + 2));
      Line('  vpbroadcastd ' + VecX(R + 2) + ', ' + VecR(R + 2, Mode));
      Line('  vpaddusb ' + VecR(R + 2, Mode) + ', ' + VecR(R + 1, Mode) + ', ' + VecR(R + 1, Mode));
      Line('  vpshufb ' + VecR(R + 1, Mode) + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
    end
    else if Mode = 2 then
    begin
      Line('  movl $1886417008, %ecx');
      Line('  movd %ecx, ' + VecX(R + 2));
      Line('  pshufd $0, ' + VecX(R + 2) + ', ' + VecX(R + 2));
      Line('  paddusb ' + VecX(R + 2) + ', ' + VecX(R + 1));
      Line('  pshufb ' + VecX(R + 1) + ', ' + VecX(R));
    end
    else
    begin
      { SSE2 alone: the bytes through memory, one by one }
      s := IntToStr(FVecScr);
      l1 := Lab;
      l2 := Lab;
      Line('  movdqu ' + VecX(R) + ', ' + s + '(%rbp)');
      Line('  movdqu ' + VecX(R + 1) + ', ' + IntToStr(FVecScr + 16) + '(%rbp)');
      Line('  xorl %edx, %edx');
      Line(l1 + ':');
      Line('  movzbl ' + IntToStr(FVecScr + 16) + '(%rbp,%rdx), %ecx');
      Line('  xorl %eax, %eax');
      Line('  cmpl $16, %ecx');
      Line('  jae ' + l2);
      Line('  movzbl ' + s + '(%rbp,%rcx), %eax');
      Line(l2 + ':');
      Line('  movb %al, ' + IntToStr(FVecScr + 32) + '(%rbp,%rdx)');
      Line('  incl %edx');
      Line('  cmpl $16, %edx');
      Line('  jb ' + l1);
      Line('  movdqu ' + IntToStr(FVecScr + 32) + '(%rbp), ' + VecX(R));
    end;
    Exit;
  end;
  if (Copy(op, 1, 2) = 'sh') and (op <> 'shuffle8') then
  begin
    ins := VecShiftIns(op);
    a := VecPReg(E^.Args[0], Half, Mode);
    { SSE2 shifts in place: into the promoted destination when that is
      the operand, else in R }
    if not Vex then
    begin
      o := '';
      if (a <> '') and (E = FVecRootE) and (FVecDestE <> nil) and
        (a = VecPReg(FVecDestE, Half, Mode)) then
      begin
        o := a;
        FVecRootDone := True;
      end
      else
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        o := VecX(R);
      end;
    end
    else if a = '' then
    begin
      VecTreeX(E^.Args[0], R, Half, Mode);
      a := VecR(R, Mode);
    end;
    if op = 'shrs64' then
    begin
      { x86 has no arithmetic shift of 64-bit lanes before AVX-512
        (1.0.136): with m the sign bit shifted as far, ((x shr c) xor m)
        - m; a count past 63 fills with the sign, as 63 does. m comes
        from all ones, psllq 63 and the same shift, in R + 2. }
      if E^.Args[1]^.Kind = ekInt then
      begin
        c := E^.Args[1]^.Num;
        if (c < 0) or (c > 63) then
          c := 63;
        cnt := '$' + IntToStr(c);
      end
      else
      begin
        VecIntX(E^.Args[1], 'rcx');
        l1 := Lab;
        Line('  cmpq $63, %rcx');
        Line('  jbe ' + l1);
        Line('  movl $63, %ecx');
        Line(l1 + ':');
        if Vex then
          Line('  vmovq %rcx, ' + VecX(R + 1))
        else
          Line('  movq %rcx, ' + VecX(R + 1));
        cnt := VecX(R + 1);
      end;
      if Vex then
      begin
        Line('  vpcmpeqd ' + VecR(R + 2, Mode) + ', ' + VecR(R + 2, Mode) + ', ' + VecR(R + 2, Mode));
        Line('  vpsllq $63, ' + VecR(R + 2, Mode) + ', ' + VecR(R + 2, Mode));
        Line('  vpsrlq ' + cnt + ', ' + VecR(R + 2, Mode) + ', ' + VecR(R + 2, Mode));
        Line('  vpsrlq ' + cnt + ', ' + a + ', ' + VecOut(E, R, Half, Mode));
        Line('  vpxor ' + VecR(R + 2, Mode) + ', ' + VecOut(E, R, Half, Mode) + ', ' + VecOut(E, R, Half, Mode));
        Line('  vpsubq ' + VecR(R + 2, Mode) + ', ' + VecOut(E, R, Half, Mode) + ', ' + VecOut(E, R, Half, Mode));
      end
      else
      begin
        Line('  pcmpeqd ' + VecX(R + 2) + ', ' + VecX(R + 2));
        Line('  psllq $63, ' + VecX(R + 2));
        Line('  psrlq ' + cnt + ', ' + VecX(R + 2));
        Line('  psrlq ' + cnt + ', ' + o);
        Line('  pxor ' + VecX(R + 2) + ', ' + o);
        Line('  psubq ' + VecX(R + 2) + ', ' + o);
      end;
    end
    else if E^.Args[1]^.Kind = ekInt then
    begin
      c := E^.Args[1]^.Num;
      if (c < 0) or (c > 255) then
        c := 255;
      if Vex then
        Line('  v' + ins + ' $' + IntToStr(c) + ', ' + a + ', ' + VecOut(E, R, Half, Mode))
      else
        Line('  ' + ins + ' $' + IntToStr(c) + ', ' + o);
    end
    else
    begin
      VecIntX(E^.Args[1], 'rcx');
      if Vex then
      begin
        Line('  vmovq %rcx, ' + VecX(R + 1));
        Line('  v' + ins + ' ' + VecX(R + 1) + ', ' + a + ', ' + VecOut(E, R, Half, Mode));
      end
      else
      begin
        Line('  movq %rcx, ' + VecX(R + 1));
        Line('  ' + ins + ' ' + VecX(R + 1) + ', ' + o);
      end;
    end;
    Exit;
  end;
  if op = 'select' then
  begin
    VecTreeX(E^.Args[0], R, Half, Mode);
    if Vex then
    begin
      a := VecPReg(E^.Args[1], Half, Mode);
      if a = '' then
      begin
        VecTreeX(E^.Args[1], R + 1, Half, Mode);
        a := VecR(R + 1, Mode);
      end;
      b := VecPReg(E^.Args[2], Half, Mode);
      if b = '' then
      begin
        VecTreeX(E^.Args[2], R + 2, Half, Mode);
        b := VecR(R + 2, Mode);
      end;
      Line('  vpand ' + VecR(R, Mode) + ', ' + a + ', ' + VecR(R + 1, Mode));
      Line('  vpandn ' + b + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
      Line('  vpor ' + VecR(R + 1, Mode) + ', ' + VecR(R, Mode) + ', ' + VecOut(E, R, Half, Mode));
    end
    else
    begin
      VecTreeX(E^.Args[1], R + 1, Half, Mode);
      VecTreeX(E^.Args[2], R + 2, Half, Mode);
      Line('  pand ' + VecX(R) + ', ' + VecX(R + 1));
      Line('  pandn ' + VecX(R + 2) + ', ' + VecX(R));
      Line('  por ' + VecX(R + 1) + ', ' + VecX(R));
    end;
    Exit;
  end;
  { two operands: one instruction where the machine has it, a promoted
    variable read in its own register }
  if Vex then
    ins := VecAvx(op)
  else
    ins := VecSse(op);
  if ins <> '' then
  begin
    if Vex then
    begin
      a := VecPReg(E^.Args[0], Half, Mode);
      if a = '' then
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        a := VecR(R, Mode);
      end;
      b := VecPReg(E^.Args[1], Half, Mode);
      if b = '' then
      begin
        VecTreeX(E^.Args[1], R + 1, Half, Mode);
        b := VecR(R + 1, Mode);
      end;
      Line('  ' + ins + ' ' + b + ', ' + a + ', ' + VecOut(E, R, Half, Mode));
    end
    else
    begin
      { acc := word(acc, x) works on acc's register itself }
      a := VecPReg(E^.Args[0], Half, Mode);
      o := '';
      if (a <> '') and (E = FVecRootE) and (FVecDestE <> nil) and
        (a = VecPReg(FVecDestE, Half, Mode)) then
        o := a
      else
      begin
        VecTreeX(E^.Args[0], R, Half, Mode);
        o := VecX(R);
      end;
      b := VecPReg(E^.Args[1], Half, Mode);
      if b = '' then
      begin
        VecTreeX(E^.Args[1], R + 1, Half, Mode);
        b := VecX(R + 1);
      end;
      Line('  ' + ins + ' ' + b + ', ' + o);
      if o = a then
        FVecRootDone := True;
    end;
    Exit;
  end;
  VecTreeX(E^.Args[0], R, Half, Mode);
  VecTreeX(E^.Args[1], R + 1, Half, Mode);
  if Vex then
  begin
    if op = 'andnot' then
      Line('  vpandn ' + VecR(R, Mode) + ', ' + VecR(R + 1, Mode) + ', ' + VecOut(E, R, Half, Mode))
    else if Copy(op, 1, 6) = 'cmpgtu' then
    begin
      VecBiasX(R + 2, lane, Mode);
      Line('  vpxor ' + VecR(R + 2, Mode) + ', ' + VecR(R, Mode) + ', ' + VecR(R, Mode));
      Line('  vpxor ' + VecR(R + 2, Mode) + ', ' + VecR(R + 1, Mode) + ', ' + VecR(R + 1, Mode));
      if lane = 8 then
        cmp := 'vpcmpgtb'
      else if lane = 16 then
        cmp := 'vpcmpgtw'
      else
        cmp := 'vpcmpgtd';
      Line('  ' + cmp + ' ' + VecR(R + 1, Mode) + ', ' + VecR(R, Mode) + ', ' + VecOut(E, R, Half, Mode));
    end
    else
      Die('no AVX2 form of the vector word ' + op);
    Exit;
  end;
  if op = 'andnot' then
  begin
    Line('  pandn ' + VecX(R) + ', ' + VecX(R + 1));
    Line('  movdqa ' + VecX(R + 1) + ', ' + VecX(R));
  end
  else if op = 'mul32' then
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  pmuludq ' + VecX(R + 1) + ', ' + VecX(R));
    Line('  psrlq $32, ' + VecX(R + 2));
    Line('  movdqa ' + VecX(R + 1) + ', ' + VecX(R + 3));
    Line('  psrlq $32, ' + VecX(R + 3));
    Line('  pmuludq ' + VecX(R + 3) + ', ' + VecX(R + 2));
    Line('  pshufd $8, ' + VecX(R) + ', ' + VecX(R));
    Line('  pshufd $8, ' + VecX(R + 2) + ', ' + VecX(R + 2));
    Line('  punpckldq ' + VecX(R + 2) + ', ' + VecX(R));
  end
  else if op = 'minu16' then
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  psubusw ' + VecX(R + 1) + ', ' + VecX(R + 2));
    Line('  psubw ' + VecX(R + 2) + ', ' + VecX(R));
  end
  else if op = 'maxu16' then
  begin
    Line('  movdqa ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  psubusw ' + VecX(R + 1) + ', ' + VecX(R + 2));
    Line('  paddw ' + VecX(R + 1) + ', ' + VecX(R + 2));
    Line('  movdqa ' + VecX(R + 2) + ', ' + VecX(R));
  end
  else if (op = 'mins8') or (op = 'maxs8') then
    VecMinMaxX(R, 'pcmpgtb', False, op = 'mins8')
  else if (op = 'mins32') or (op = 'maxs32') then
    VecMinMaxX(R, 'pcmpgtd', False, op = 'mins32')
  else if (op = 'minu32') or (op = 'maxu32') then
    VecMinMaxX(R, 'pcmpgtd', True, op = 'minu32')
  else if op = 'cmpeq64' then
  begin
    Line('  pcmpeqd ' + VecX(R + 1) + ', ' + VecX(R));
    Line('  pshufd $177, ' + VecX(R) + ', ' + VecX(R + 2));
    Line('  pand ' + VecX(R + 2) + ', ' + VecX(R));
  end
  else if Copy(op, 1, 6) = 'cmpgtu' then
  begin
    VecBiasX(R + 2, lane, 0);
    Line('  pxor ' + VecX(R + 2) + ', ' + VecX(R));
    Line('  pxor ' + VecX(R + 2) + ', ' + VecX(R + 1));
    if lane = 8 then
      cmp := 'pcmpgtb'
    else if lane = 16 then
      cmp := 'pcmpgtw'
    else
      cmp := 'pcmpgtd';
    Line('  ' + cmp + ' ' + VecX(R + 1) + ', ' + VecX(R));
  end
  else
    Die('no SSE2 form of the vector word ' + op);
end;

{ The tree of E into register R on arm64, half Half; every instruction
  takes its operands where they lie, so a promoted variable is read in
  its own register (1.0.128). }
procedure TEmitter.VecTreeA(E: PExpr; R, Half: LongInt);
var
  op, ins, arr, sh, a, b, d, rr: string;
  lane: LongInt;
  c: Int64;
begin
  if R + 4 > 13 then
    Die('a vector expression this deep needs more vector registers than there are: ' +
      'split it into two statements');
  rr := 'v' + IntToStr(R + 16);
  if not VecOp(E) then
  begin
    d := VecOut(E, R, Half, 0);
    a := VecPReg(E, Half, 0);
    if a <> '' then
    begin
      if a <> d then
        Line('  mov ' + d + '.16b, ' + a + '.16b');
      Exit;
    end;
    if VecHomeOK(E) then
      VecHomeA(E)
    else if FVecDirect then
    begin
      if not VecIdxA(E) then
      begin
        EmitArgVal(E);
        Line('  mov x9, x0');
      end;
    end
    else
      Line('  ldr x9, [sp, #' + IntToStr(VecSlot(E)) + ']');
    Line('  ldr q' + Copy(d, 2, Length(d) - 1) + ', [x9, #' + IntToStr(16 * Half) + ']');
    Exit;
  end;
  op := Copy(E^.Name, 5, Length(E^.Name) - 4);
  lane := VecLane(op);
  arr := VecArr(lane);
  { select and the packs write their result before they read all of
    their operands: they keep R, and the sink moves it }
  if (op = 'select') or (Copy(op, 1, 4) = 'pack') then
    d := rr
  else
    d := VecOut(E, R, Half, 0);
  if Copy(op, 1, 5) = 'splat' then
  begin
    if (E^.Args[0]^.Kind = ekInt) and (E^.Args[0]^.Num = 0) then
    begin
      Line('  movi ' + d + '.2d, #0');
      Exit;
    end;
    VecIntA(E^.Args[0], 'x9');
    if lane = 64 then
      Line('  dup ' + d + '.' + arr + ', x9')
    else
      Line('  dup ' + d + '.' + arr + ', w9');
    Exit;
  end;
  if op = 'select' then
  begin
    VecTreeA(E^.Args[0], R, Half);
    a := VecPReg(E^.Args[1], Half, 0);
    if a = '' then
    begin
      VecTreeA(E^.Args[1], R + 1, Half);
      a := 'v' + IntToStr(R + 17);
    end;
    b := VecPReg(E^.Args[2], Half, 0);
    if b = '' then
    begin
      VecTreeA(E^.Args[2], R + 2, Half);
      b := 'v' + IntToStr(R + 18);
    end;
    Line('  bsl ' + d + '.16b, ' + a + '.16b, ' + b + '.16b');
    Exit;
  end;
  a := VecPReg(E^.Args[0], Half, 0);
  if a = '' then
  begin
    VecTreeA(E^.Args[0], R, Half);
    a := rr;
  end;
  if op = 'not' then
  begin
    Line('  mvn ' + d + '.16b, ' + a + '.16b');
    Exit;
  end;
  if (Copy(op, 1, 4) = 'sqrt') or (op = 'cvts32f32') then
  begin
    if op = 'cvts32f32' then
      Line('  scvtf ' + d + '.4s, ' + a + '.4s')
    else
      Line('  fsqrt ' + d + '.' + arr + ', ' + a + '.' + arr);
    Exit;
  end;
  if (Copy(op, 1, 2) = 'sh') and (op <> 'shuffle8') then
  begin
    if E^.Args[1]^.Kind = ekInt then
    begin
      c := E^.Args[1]^.Num;
      if (c < 0) or (c > lane) then
        c := lane;
      if (Copy(op, 1, 3) = 'shl') and (c = lane) then
        Line('  movi ' + d + '.2d, #0')
      else if c = 0 then
      begin
        if a <> d then
          Line('  mov ' + d + '.16b, ' + a + '.16b');
      end
      else
      begin
        if Copy(op, 1, 3) = 'shl' then
          sh := 'shl'
        else if Copy(op, 1, 4) = 'shru' then
          sh := 'ushr'
        else
          sh := 'sshr';
        Line('  ' + sh + ' ' + d + '.' + arr + ', ' + a + '.' + arr + ', #' + IntToStr(c));
      end;
    end
    else
    begin
      VecIntA(E^.Args[1], 'x9');
      Line('  mov x10, #' + IntToStr(lane));
      Line('  cmp x9, x10');
      Line('  csel x9, x10, x9, hi');
      if Copy(op, 1, 3) <> 'shl' then
        Line('  neg x9, x9');
      if lane = 64 then
        Line('  dup ' + VecV(R + 1, arr) + ', x9')
      else
        Line('  dup ' + VecV(R + 1, arr) + ', w9');
      if Copy(op, 1, 4) = 'shrs' then
        sh := 'sshl'
      else
        sh := 'ushl';
      Line('  ' + sh + ' ' + d + '.' + arr + ', ' + a + '.' + arr + ', ' + VecV(R + 1, arr));
    end;
    Exit;
  end;
  b := VecPReg(E^.Args[1], Half, 0);
  if b = '' then
  begin
    VecTreeA(E^.Args[1], R + 1, Half);
    b := 'v' + IntToStr(R + 17);
  end;
  if op = 'andnot' then
    Line('  bic ' + d + '.16b, ' + a + '.16b, ' + b + '.16b')
  else if op = 'shuffle8' then
    Line('  tbl ' + d + '.16b, {' + a + '.16b}, ' + b + '.16b')
  else if (op = 'packu16') or (op = 'packs16') then
  begin
    if op = 'packu16' then
      ins := 'sqxtun'
    else
      ins := 'sqxtn';
    Line('  ' + ins + ' ' + d + '.8b, ' + a + '.8h');
    Line('  ' + ins + '2 ' + d + '.16b, ' + b + '.8h');
  end
  else if op = 'packs32' then
  begin
    Line('  sqxtn ' + d + '.4h, ' + a + '.4s');
    Line('  sqxtn2 ' + d + '.8h, ' + b + '.4s');
  end
  { x86's minps and maxps: a < b ? a : b and a > b ? a : b, the second
    when either is a NaN; fmin would give the NaN. }
  else if (Copy(op, 1, 4) = 'minf') or (Copy(op, 1, 4) = 'maxf') then
  begin
    if Copy(op, 1, 4) = 'minf' then
      Line('  fcmgt ' + VecV(R + 2, arr) + ', ' + b + '.' + arr + ', ' + a + '.' + arr)
    else
      Line('  fcmgt ' + VecV(R + 2, arr) + ', ' + a + '.' + arr + ', ' + b + '.' + arr);
    Line('  bsl ' + VecV(R + 2, '16b') + ', ' + a + '.16b, ' + b + '.16b');
    Line('  mov ' + d + '.16b, ' + VecV(R + 2, '16b'));
  end
  else if Copy(op, 1, 6) = 'cmpltf' then
    Line('  fcmgt ' + d + '.' + arr + ', ' + b + '.' + arr + ', ' + a + '.' + arr)
  else if Copy(op, 1, 6) = 'cmplef' then
    Line('  fcmge ' + d + '.' + arr + ', ' + b + '.' + arr + ', ' + a + '.' + arr)
  else
  begin
    ins := VecNeon(op);
    if ins = '' then
      Die('no NEON form of the vector word ' + op);
    Line('  ' + ins + ' ' + d + '.' + arr + ', ' + a + '.' + arr + ', ' + b + '.' + arr);
  end;
end;

function TEmitter.VecHasShuf(E: PExpr): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if (E = nil) or (E^.Kind <> ekCall) or (Copy(E^.Name, 1, 4) <> 'rt_v') then
    Exit;
  if E^.Name = 'rt_vshuffle8' then
  begin
    Result := True;
    Exit;
  end;
  for i := 0 to High(E^.Args) do
    if VecHasShuf(E^.Args[i]) then
      Result := True;
end;

{ A reduction of the tree in xmm2 (and xmm3) into rax, in SSE2 or VEX. }
procedure TEmitter.VecReduceX(const Op: string; Sz: LongInt; Vex: Boolean);
var
  x, v: string;
  h: LongInt;
begin
  if Vex then
    v := 'v'
  else
    v := '';
  Line('  xorl %eax, %eax');
  if Op = 'sumu8' then
  begin
    if Vex then
      Line('  vpxor %xmm4, %xmm4, %xmm4')
    else
      Line('  pxor %xmm4, %xmm4');
  end;
  for h := 0 to Sz div 16 - 1 do
  begin
    x := VecX(h);
    if Op = 'movemask8' then
    begin
      Line('  ' + v + 'pmovmskb ' + x + ', %ecx');
      if h = 1 then
        Line('  shll $16, %ecx');
      Line('  orl %ecx, %eax');
    end
    else if Op = 'sums32' then
    begin
      Line('  ' + v + 'movq ' + x + ', %rcx');
      Line('  movslq %ecx, %rdx');
      Line('  addq %rdx, %rax');
      Line('  sarq $32, %rcx');
      Line('  addq %rcx, %rax');
      Line('  ' + v + 'pshufd $238, ' + x + ', %xmm5');
      Line('  ' + v + 'movq %xmm5, %rcx');
      Line('  movslq %ecx, %rdx');
      Line('  addq %rdx, %rax');
      Line('  sarq $32, %rcx');
      Line('  addq %rcx, %rax');
    end
    else
    begin
      if Op = 'sumu8' then
      begin
        if Vex then
          Line('  vpsadbw %xmm4, ' + x + ', ' + x)
        else
          Line('  psadbw %xmm4, ' + x);
      end;
      Line('  ' + v + 'movq ' + x + ', %rcx');
      Line('  addq %rcx, %rax');
      Line('  ' + v + 'pshufd $238, ' + x + ', %xmm5');
      Line('  ' + v + 'movq %xmm5, %rcx');
      Line('  addq %rcx, %rax');
    end;
  end;
end;

{ The end of a statement on amd64, its tree in xmm2 (and xmm3, the high
  half) or ymm2: into a promoted variable's register, stored at Dest (in
  place for a variable, else at the address the first phase pushed or
  that is computed now) or at the scratch slot Off, or reduced into rax
  for VMoveMask8, VSumU8, VSumS32 and VSum64. Inside AVX2's copy of a
  region nothing zeroes the upper halves: promoted V256s live there. }
procedure TEmitter.VecSinkX(E, Dest: PExpr; Off, Sz, Mode: LongInt);
var
  op, h0, h1: string;
  p: LongInt;
begin
  if not VecRed(E) then
  begin
    p := VecPIdx(Dest);
    if (p >= 0) and FVecRootDone then
      Exit;
    if p >= 0 then
    begin
      if Mode = 1 then
        Line('  vmovdqa %ymm2, %ymm' + IntToStr(FVPromo[p].R0))
      else if Mode = 3 then
        Line('  vmovdqa %xmm2, %xmm' + IntToStr(FVPromo[p].R0))
      else
      begin
        Line('  movdqa %xmm2, %xmm' + IntToStr(FVPromo[p].R0));
        if Sz = 32 then
          Line('  movdqa %xmm3, %xmm' + IntToStr(FVPromo[p].R1));
      end;
      Exit;
    end;
    if Dest = nil then
    begin
      h0 := IntToStr(Off) + '(%rbp)';
      h1 := IntToStr(Off + 16) + '(%rbp)';
    end
    else if VecHomeOK(Dest) then
    begin
      h0 := VecHome(Dest, 0);
      h1 := VecHome(Dest, 1);
    end
    else
    begin
      h0 := '';
      if FVecDirect then
        h0 := VecIdxX(Dest, h1);
      if h0 = '' then
      begin
        if FVecDirect then
          EmitAddr(Dest)
        else
          Line('  movq (%rsp), %rax');
        h0 := '(%rax)';
        h1 := '16(%rax)';
      end;
    end;
    if Mode = 1 then
    begin
      Line('  vmovdqu %ymm2, ' + h0);
      if FVecCopy <> 1 then
        Line('  vzeroupper');
    end
    else if Mode = 3 then
      Line('  vmovdqu %xmm2, ' + h0)
    else
    begin
      Line('  movdqu %xmm2, ' + h0);
      if Sz = 32 then
        Line('  movdqu %xmm3, ' + h1);
    end;
    Exit;
  end;
  op := Copy(E^.Name, 5, Length(E^.Name) - 4);
  if Mode = 1 then
  begin
    if op = 'movemask8' then
      Line('  vpmovmskb %ymm2, %eax')
    else
    begin
      Line('  vextracti128 $1, %ymm2, %xmm3');
      VecReduceX(op, 32, True);
    end;
    if FVecCopy <> 1 then
      Line('  vzeroupper');
    Exit;
  end;
  VecReduceX(op, Sz, Mode = 3);
end;

procedure TEmitter.VecSinkA(E, Dest: PExpr; Off, Sz: LongInt);
var
  op, v: string;
  h, p: LongInt;
begin
  if not VecRed(E) then
  begin
    p := VecPIdx(Dest);
    if (p >= 0) and FVecRootDone then
      Exit;
    if p >= 0 then
    begin
      Line('  mov v' + IntToStr(FVPromo[p].R0) + '.16b, v16.16b');
      if Sz = 32 then
        Line('  mov v' + IntToStr(FVPromo[p].R1) + '.16b, v17.16b');
      Exit;
    end;
    if Dest = nil then
      AddFP('x9', Off)
    else if VecHomeOK(Dest) then
      VecHomeA(Dest)
    else if FVecDirect then
    begin
      if not VecIdxA(Dest) then
      begin
        EmitAddr(Dest);
        Line('  mov x9, x0');
      end;
    end
    else
      Line('  ldr x9, [sp]');
    Line('  str q16, [x9]');
    if Sz = 32 then
      Line('  str q17, [x9, #16]');
    Exit;
  end;
  op := Copy(E^.Name, 5, Length(E^.Name) - 4);
  Line('  mov x0, #0');
  for h := 0 to Sz div 16 - 1 do
  begin
    v := 'v' + IntToStr(16 + h);
    if op = 'movemask8' then
    begin
      { NEON has no movemask: each byte's top bit shifted to its place in
        its half and the halves' bytes added }
      Line('  ushr v18.16b, ' + v + '.16b, #7');
      Imm('x9', 506097522914230528);
      Line('  dup v19.2d, x9');
      Line('  ushl v18.16b, v18.16b, v19.16b');
      Line('  addv b20, v18.8b');
      Line('  ext v21.16b, v18.16b, v18.16b, #8');
      Line('  addv b21, v21.8b');
      Line('  umov w10, v20.b[0]');
      Line('  umov w11, v21.b[0]');
      Line('  orr w10, w10, w11, lsl #8');
      if h = 0 then
        Line('  orr x0, x0, x10')
      else
        Line('  orr x0, x0, x10, lsl #16');
    end
    else
    begin
      if op = 'sumu8' then
      begin
        Line('  uaddlv h18, ' + v + '.16b');
        Line('  umov w10, v18.h[0]');
      end
      else if op = 'sums32' then
      begin
        Line('  saddlv d18, ' + v + '.4s');
        Line('  fmov x10, d18');
      end
      else
      begin
        Line('  addp d18, ' + v + '.2d');
        Line('  fmov x10, d18');
      end;
      Line('  add x0, x0, x10');
    end;
  end;
end;

{ E worked out and stored at Dest (a place), or in a scratch slot whose
  address is the value (rax, x0) when Dest is nil; or, for a word that
  gives an Integer, reduced into rax or x0. A statement whose operands
  call nothing has no first phase (1.0.128): each operand is computed
  where it is loaded. amd64 tries AVX2 for a V256, then SSSE3 for a tree
  that shuffles, then SSE2; in a region's copy for AVX2 or SSE2 it takes
  that path alone. }
procedure TEmitter.EmitVecStmt(E, Dest: PExpr);
var
  items: TExprArray;
  n, off, sz: LongInt;
  vroot: PExpr;
  alt, done: string;
  direct: Boolean;
begin
  items := nil;
  off := 0;
  if VecRed(E) then
    vroot := E^.Args[0]
  else
    vroot := E;
  direct := VecPureRoot(E) and ((Dest = nil) or VecDestPure(Dest));
  if not direct then
  begin
    VecCollect(E, items);
    if (Dest <> nil) and not VecHomeOK(Dest) and (VecPIdx(Dest) < 0) then
    begin
      EmitAddr(Dest);
      if FArm then
        PshK('x0', 1)
      else
        PushK('rax', 1);
      n := Length(items);
      SetLength(items, n + 1);
      items[n] := Dest;
    end;
  end;
  if (Dest = nil) and VecOp(E) then
    off := ScratchT(FTypes[E^.Typ].Size, E^.Typ);
  if (not FArm) and VecHasShuf(vroot) then
    FVecScr := ScratchT(48, TyV128);
  FVecDirect := direct;
  FVecItems := items;
  FVecN := Length(items);
  n := FVecN;
  sz := FTypes[vroot^.Typ].Size;
  FVecRootE := vroot;
  FVecDestE := nil;
  if (Dest <> nil) and (VecPIdx(Dest) >= 0) then
    FVecDestE := Dest;
  FVecRootDone := False;
  if FArm then
  begin
    VecTreeA(vroot, 0, 0);
    if sz = 32 then
      VecTreeA(vroot, 1, 1);
    VecSinkA(E, Dest, off, sz);
    if n > 0 then
      Line('  add sp, sp, #' + IntToStr(16 * n));
    if (Dest = nil) and VecOp(E) then
      AddFP('x0', off);
    FVecDirect := False;
    FVecRootE := nil;
    FVecDestE := nil;
    Exit;
  end;
  done := Lab;
  if FVecCopy = 1 then
  begin
    if sz = 32 then
    begin
      VecTreeX(vroot, 0, 0, 1);
      VecSinkX(E, Dest, off, sz, 1);
    end
    else
    begin
      VecTreeX(vroot, 0, 0, 3);
      VecSinkX(E, Dest, off, sz, 3);
    end;
  end
  else if (sz = 32) and (FVecCopy = 0) and HasFeat(13) then
  begin
    { the processor the program is compiled for has AVX2 (-cpu, P111):
      the ymm form alone, nothing tested at run time }
    VecTreeX(vroot, 0, 0, 1);
    VecSinkX(E, Dest, off, sz, 1);
  end
  else if VecHasShuf(vroot) and HasFeat(2) then
  begin
    VecTreeX(vroot, 0, 0, 2);
    if sz = 32 then
      VecTreeX(vroot, 1, 1, 2);
    VecSinkX(E, Dest, off, sz, 2);
  end
  else
  begin
    VecTreeX(vroot, 0, 0, 0);
    if sz = 32 then
      VecTreeX(vroot, 1, 1, 0);
    VecSinkX(E, Dest, off, sz, 0);
  end;
  Line(done + ':');
  if n > 0 then
    Line('  addq $' + IntToStr(8 * n) + ', %rsp');
  if (Dest = nil) and VecOp(E) then
    Line('  leaq ' + IntToStr(off) + '(%rbp), %rax');
  FVecDirect := False;
  FVecRootE := nil;
  FVecDestE := nil;
end;

{ v := a vector word, stored straight into v (a variable, a field, an
  element or p^) with no copy through a scratch slot. }
function TEmitter.VecAssign(S: PStmt): Boolean;
begin
  Result := ((S^.Dest <> nil) and VecOp(S^.E) and ((S^.Dest^.Kind = ekVar) or
    (S^.Dest^.Kind = ekField) or (S^.Dest^.Kind = ekIndex) or (S^.Dest^.Kind = ekDeref))) or
    VecCopy(S);
  if Result then
    EmitVecStmt(S^.E, S^.Dest);
end;

function TEmitter.EmitVecFn(E: PExpr): Boolean;
begin
  Result := VecOp(E) or VecRed(E);
  if Result then
    EmitVecStmt(E, nil);
end;

{ ---- the vector registers of a region (P107, 1.0.128) ----

  A region (EmitRegion: statements with no call, a loop's body and all)
  keeps its most used V128 and V256 variables in vector registers, as it
  keeps integers in rbx or x19: loaded before it, stored after, spilled
  and reloaded around rt_morestack in a loop's slow path. A variable is
  a candidate when every use in the region is an operand of a vector
  word or the variable a vector statement assigns, and its address is
  never taken. amd64 gives xmm15 down (at most 8 registers, fewer when a
  statement's tree needs them: the budget is 13 less the deepest tree),
  arm64 v8 to v15, which no tree uses. A V256 on arm64 or in SSE2 takes
  two registers; on amd64 a region that keeps a V256 is emitted twice,
  once for AVX2 with the V256 in a ymm register and every vector
  instruction VEX-encoded, once for SSE2 with it in two xmm registers,
  one bt of rt_cpufeat choosing at its entry. }
function TEmitter.VBase(E: PExpr; B: LongInt): LongInt;
var
  i: SizeInt;
  m: LongInt;
begin
  Result := B;
  if not VecOp(E) then
    Exit;
  for i := 0 to High(E^.Args) do
  begin
    m := VBase(E^.Args[i], B + LongInt(i));
    if m > Result then
      Result := m;
  end;
end;

procedure TEmitter.VNeedE(E: PExpr; var Need: LongInt);
var
  i: SizeInt;
  t: PExpr;
  m: LongInt;
begin
  if E = nil then
    Exit;
  if VecOp(E) or VecRed(E) then
  begin
    if VecOp(E) then
      t := E
    else
      t := E^.Args[0];
    m := VBase(t, 0) + 4;
    if FTypes[t^.Typ].Size = 32 then
      Inc(m);
    if m > Need then
      Need := m;
    Exit;
  end;
  VNeedE(E^.L, Need);
  VNeedE(E^.R, Need);
  for i := 0 to High(E^.Args) do
    VNeedE(E^.Args[i], Need);
end;

procedure TEmitter.VNeedS(S: PStmt; var Need: LongInt);
var
  i: SizeInt;
begin
  if S = nil then
    Exit;
  if (S^.Kind = skAssign) and VecCopy(S) then
  begin
    if Need < 4 + Ord(FTypes[S^.E^.Typ].Size = 32) then
      Need := 4 + Ord(FTypes[S^.E^.Typ].Size = 32);
    Exit;
  end;
  VNeedE(S^.E, Need);
  VNeedE(S^.E2, Need);
  VNeedE(S^.Dest, Need);
  VNeedS(S^.ThenSt, Need);
  VNeedS(S^.ElseSt, Need);
  VNeedS(S^.Body, Need);
  for i := 0 to High(S^.Stmts) do
    VNeedS(S^.Stmts[i], Need);
  for i := 0 to High(S^.Arms) do
    VNeedS(S^.Arms[i].Body, Need);
end;

{ A use of the vector variable N: written or read, weighted by the loops
  around it; Bad when the use is none of a vector word's. }
procedure TEmitter.VAdd(const N: string; W: Boolean; Weight: LongInt; Bad: Boolean);
var
  s: TSym;
  i, k: SizeInt;
begin
  if not TryFindSym(N, s) then
    Exit;
  if (s.Typ <> TyV128) and (s.Typ <> TyV256) then
    Exit;
  if s.ByRef or (s.Up <> 0) or (s.Global and FIsUnit) or AddrTakenSym(s) then
    Bad := True;
  if (not s.Global) and FHasRes and (s.Off = FResOff) then
    Bad := True;
  for i := 0 to High(FVCand) do
    if (FVCand[i].Place.Global = s.Global) and SamePlace(FVCand[i].Place, s) then
    begin
      FVCand[i].Refs := FVCand[i].Refs + Weight;
      if W then
        FVCand[i].Written := True;
      if Bad then
        FVCand[i].Bad := True;
      Exit;
    end;
  k := Length(FVCand);
  SetLength(FVCand, k + 1);
  FVCand[k].Place := s;
  FVCand[k].Typ := s.Typ;
  FVCand[k].R0 := -1;
  FVCand[k].R1 := -1;
  FVCand[k].Written := W;
  FVCand[k].Bad := Bad;
  FVCand[k].Refs := Weight;
end;

procedure TEmitter.VScanTree(E: PExpr; Weight: LongInt);
var
  i: SizeInt;
  a: PExpr;
begin
  for i := 0 to High(E^.Args) do
  begin
    a := E^.Args[i];
    if VecOp(a) then
      VScanTree(a, Weight)
    else if a^.Kind = ekVar then
      VAdd(a^.Name, False, Weight, False)
    else
      VScanE(a, Weight);
  end;
end;

procedure TEmitter.VScanE(E: PExpr; Weight: LongInt);
var
  i: SizeInt;
begin
  if E = nil then
    Exit;
  if VecOp(E) or VecRed(E) then
  begin
    VScanTree(E, Weight);
    Exit;
  end;
  if E^.Kind = ekVar then
    VAdd(E^.Name, False, Weight, True);
  VScanE(E^.L, Weight);
  VScanE(E^.R, Weight);
  for i := 0 to High(E^.Args) do
    VScanE(E^.Args[i], Weight);
end;

procedure TEmitter.VScanS(S: PStmt; Weight: LongInt);
var
  i: SizeInt;
  w: LongInt;
begin
  if S = nil then
    Exit;
  w := Weight;
  if ((S^.Kind = skWhile) or (S^.Kind = skRepeat) or (S^.Kind = skFor)) and
    (w < 100000) then
    w := w * 8;
  if (S^.Kind = skAssign) and VecOp(S^.E) and (S^.Dest <> nil) and (S^.Dest^.Kind = ekVar) then
  begin
    VAdd(S^.Dest^.Name, True, w, False);
    VScanTree(S^.E, w);
  end
  else if (S^.Kind = skAssign) and VecCopy(S) and (S^.Dest^.Kind = ekVar) then
  begin
    VAdd(S^.Dest^.Name, True, w, False);
    if S^.E^.Kind = ekVar then
      VAdd(S^.E^.Name, False, w, False)
    else
      VScanE(S^.E, w);
  end
  else
  begin
    if (S^.Kind = skAssign) and (S^.Dest = nil) then
      VAdd(S^.Name, True, w, True);
    VScanE(S^.Dest, w);
    VScanE(S^.E, w);
  end;
  VScanE(S^.E2, w);
  VScanS(S^.ThenSt, w);
  VScanS(S^.ElseSt, w);
  VScanS(S^.Body, w);
  for i := 0 to High(S^.Stmts) do
    VScanS(S^.Stmts[i], w);
  for i := 0 to High(S^.Arms) do
    VScanS(S^.Arms[i].Body, w);
end;

procedure TEmitter.VecChoose(const L: TStmtArray; A, Z: SizeInt);
var
  k, i, j: SizeInt;
  need, avail, used, cost, nx: LongInt;
  t: TVPromo;
begin
  FVPromo := nil;
  FVCand := nil;
  FVecTop := 0;
  for k := A to Z do
    VScanS(L[k], 1);
  need := 0;
  for k := A to Z do
    VNeedS(L[k], need);
  FVecNeed := need;
  for i := 0 to High(FVCand) - 1 do
    for j := i + 1 to High(FVCand) do
      if FVCand[j].Refs > FVCand[i].Refs then
      begin
        t := FVCand[i];
        FVCand[i] := FVCand[j];
        FVCand[j] := t;
      end;
  avail := 8;
  if (not FArm) and (13 - need < avail) then
    avail := 13 - need;
  used := 0;
  if FArm then
    nx := 8
  else
    nx := 15;
  for i := 0 to High(FVCand) do
  begin
    if FVCand[i].Bad or (FVCand[i].Refs < 2) then
      Continue;
    if FVCand[i].Typ = TyV256 then
      cost := 2
    else
      cost := 1;
    if used + cost > avail then
      Continue;
    t := FVCand[i];
    if FArm then
    begin
      t.R0 := nx;
      if cost = 2 then
        t.R1 := nx + 1
      else
        t.R1 := -1;
      nx := nx + cost;
    end
    else if cost = 2 then
    begin
      t.R0 := nx - 1;
      t.R1 := nx;
      nx := nx - 2;
    end
    else
    begin
      t.R0 := nx;
      t.R1 := -1;
      nx := nx - 1;
    end;
    j := Length(FVPromo);
    SetLength(FVPromo, j + 1);
    FVPromo[j] := t;
    used := used + cost;
  end;
  FVCand := nil;
  if not FArm then
    FVecTop := used;
end;

{ Variable I between its home and its registers. }
procedure TEmitter.VecMove(I: SizeInt; Load: Boolean);
var
  s: TSym;
  h0, h1, r0, r1: string;
begin
  s := FVPromo[I].Place;
  if FArm then
  begin
    if s.Global then
      LeaS(VarLabel(s.Name), 'x9')
    else
      AddFP('x9', s.Off);
    if Load then
    begin
      Line('  ldr q' + IntToStr(FVPromo[I].R0) + ', [x9]');
      if FVPromo[I].R1 >= 0 then
        Line('  ldr q' + IntToStr(FVPromo[I].R1) + ', [x9, #16]');
    end
    else
    begin
      Line('  str q' + IntToStr(FVPromo[I].R0) + ', [x9]');
      if FVPromo[I].R1 >= 0 then
        Line('  str q' + IntToStr(FVPromo[I].R1) + ', [x9, #16]');
    end;
    Exit;
  end;
  if s.Global then
  begin
    h0 := VarLabel(s.Name) + '+0(%rip)';
    h1 := VarLabel(s.Name) + '+16(%rip)';
  end
  else
  begin
    h0 := IntToStr(s.Off) + '(%rbp)';
    h1 := IntToStr(s.Off + 16) + '(%rbp)';
  end;
  if FVecCopy = 1 then
  begin
    if FVPromo[I].Typ = TyV256 then
      r0 := '%ymm' + IntToStr(FVPromo[I].R0)
    else
      r0 := '%xmm' + IntToStr(FVPromo[I].R0);
    if Load then
      Line('  vmovdqu ' + h0 + ', ' + r0)
    else
      Line('  vmovdqu ' + r0 + ', ' + h0);
    Exit;
  end;
  r0 := '%xmm' + IntToStr(FVPromo[I].R0);
  r1 := '%xmm' + IntToStr(FVPromo[I].R1);
  if Load then
  begin
    Line('  movdqu ' + h0 + ', ' + r0);
    if FVPromo[I].R1 >= 0 then
      Line('  movdqu ' + h1 + ', ' + r1);
  end
  else
  begin
    Line('  movdqu ' + r0 + ', ' + h0);
    if FVPromo[I].R1 >= 0 then
      Line('  movdqu ' + r1 + ', ' + h1);
  end;
end;

procedure TEmitter.VecLoadAll;
var
  i: SizeInt;
begin
  for i := 0 to High(FVPromo) do
    VecMove(i, True);
end;

{ The written ones back home; before rt_morestack in AVX2's copy the
  upper halves go too (vzeroupper), so the routine that runs next pays
  no SSE-AVX transition. }
procedure TEmitter.VecStoreAll(Spill: Boolean);
var
  i: SizeInt;
begin
  for i := 0 to High(FVPromo) do
    if FVPromo[i].Written then
      VecMove(i, False);
  if Spill and (FVecCopy = 1) and (Length(FVPromo) > 0) then
    Line('  vzeroupper');
end;

procedure TEmitter.VecRegionBody(const L: TStmtArray; A, Z: SizeInt);
var
  k, i: SizeInt;
  wide: Boolean;
  sse, done: string;
begin
  { every region with vector statements has a copy for AVX2: V256 in ymm,
    and V128 in VEX's three operands with SSE4.1's instructions (pmulld,
    pminsb, pcmpeqq), which SSE2 only emulates }
  wide := FVecNeed > 0;
  for i := 0 to High(FVPromo) do
    if FVPromo[i].Typ = TyV256 then
      wide := True;
  if (not FArm) and wide then
  begin
    { the copy the processor the program is compiled for takes (-cpu,
      P111): AVX2's, or SSE's; the other is not written }
    if HasFeat(13) then
      FVecCopy := 1
    else
      FVecCopy := 2;
    VecLoadAll;
    for k := A to Z do
      EmitStmt(L[k]);
    VecStoreAll(False);
    if FVecCopy = 1 then
      Line('  vzeroupper');
    FVecCopy := 0;
  end
  else
  begin
    VecLoadAll;
    for k := A to Z do
      EmitStmt(L[k]);
    VecStoreAll(False);
  end;
end;

{ CpuHas, CpuFeatures, CycleCount and CycleFreq (P106, 1.0.124): one
  bit of rt_cpufeat; the word; rdtsc (edx:eax) or cntvct_el0; cntfrq_el0,
  or rt_cyclefreq on amd64, whose counter has no register for its rate. }
{ Carry and the rotation and shift family (P108, 1.0.129). Carry is the
  byte at G+256 of the running routine (r14 on amd64, x28 on arm64), so
  each routine has its own, kept across calls, 0 when it starts.

  rt_rot(x, n, kind, N) works on N bits of x (8, 16, 32 or 64), n times:
    1 RotateLeftToCarry, 2 RotateRightToCarry: circular, the bit that
      came round last copied to Carry (bit 0, or bit N-1, of the result);
    3 RotateLeftThroughCarry, 4 RotateRightThroughCarry: Carry is bit N
      of a ring of N+1 bits, turned n mod (N+1) places;
    5 ShiftLeft, 6 ShiftRight, 7 ShiftRightSigned: Carry untouched;
    8 ShiftLeftToCarry, 9 ShiftRightToCarry, 10 ShiftRightSignedToCarry:
      the last bit out goes to Carry.
  rt_funnel(hi, lo, n, 20 or 21, N) is the top N bits of hi:lo shifted
  left n, or the low N bits of hi:lo shifted right n.

  n <= 0 changes nothing, value or Carry; a count past the width is
  exact (a shift gives 0 or the sign, 0 goes to Carry once the bits
  run out), never the processor's count taken modulo 32 or 64.

  amd64 works in the value's own width (rolb on al, rclw on ax), so the
  bits above N never matter; the result is then made its type's again.
  rax, rcx, rdx, rsi and r8 only: r9-r13 and r15 may hold promoted
  variables. arm64 keeps the value zero-extended in x0 (sign-extended
  for the Signed words), x9-x14 as scratch. }

function RotSfx(N: LongInt): string;
begin
  if N = 8 then
    Result := 'b'
  else if N = 16 then
    Result := 'w'
  else if N = 32 then
    Result := 'l'
  else
    Result := 'q';
end;

{ The constant forms on amd64, on Opnd (a register of width N or a
  memory operand of N bits); Cn >= 1. }
procedure TEmitter.RotX86K(Kind, N: LongInt; Cn: Int64; const Opnd: string);
var
  s: string;
  k: Int64;
  left: Boolean;
begin
  s := RotSfx(N);
  case Kind of
    1, 2:
      begin
        k := Cn mod N;
        if k <> 0 then
        begin
          { rol leaves the bit that came round in CF: bit 0 of the
            result; ror bit N-1. }
          if Kind = 1 then
            Line('  rol' + s + ' $' + IntToStr(k) + ', ' + Opnd)
          else
            Line('  ror' + s + ' $' + IntToStr(k) + ', ' + Opnd);
          Line('  setc ' + CarryM(1));
        end
        else
          RotBitX86(N, Kind = 1, Opnd);
      end;
    3, 4:
      begin
        k := Cn mod (N + 1);
        if k = 0 then
          Exit;
        left := Kind = 3;
        { N places round a ring of N+1 is one the other way: rcl and
          rcr by 1 are fast, by more they are microcode. }
        if k = N then
        begin
          left := not left;
          k := 1;
        end;
        Line('  btl $0, ' + CarryM(4));
        if left then
          Line('  rcl' + s + ' $' + IntToStr(k) + ', ' + Opnd)
        else
          Line('  rcr' + s + ' $' + IntToStr(k) + ', ' + Opnd);
        Line('  setc ' + CarryM(1));
      end;
    5, 6:
      if Cn >= N then
        Line('  mov' + s + ' $0, ' + Opnd)
      else if Kind = 5 then
        Line('  shl' + s + ' $' + IntToStr(Cn) + ', ' + Opnd)
      else
        Line('  shr' + s + ' $' + IntToStr(Cn) + ', ' + Opnd);
    7:
      begin
        k := Cn;
        if k > N - 1 then
          k := N - 1;
        Line('  sar' + s + ' $' + IntToStr(k) + ', ' + Opnd);
      end;
    8, 9:
      if Cn > N then
      begin
        Line('  mov' + s + ' $0, ' + Opnd);
        Line('  movb $0, ' + CarryM(1));
      end
      else
      begin
        { n-1 places, then the last one alone: its bit is CF, and a
          count of N (64) never reaches the processor. }
        if Kind = 8 then
        begin
          if Cn > 1 then
            Line('  shl' + s + ' $' + IntToStr(Cn - 1) + ', ' + Opnd);
          Line('  shl' + s + ' $1, ' + Opnd);
        end
        else
        begin
          if Cn > 1 then
            Line('  shr' + s + ' $' + IntToStr(Cn - 1) + ', ' + Opnd);
          Line('  shr' + s + ' $1, ' + Opnd);
        end;
        Line('  setc ' + CarryM(1));
      end;
    10:
      begin
        k := Cn;
        if k > N then
          k := N;
        if k > 1 then
          Line('  sar' + s + ' $' + IntToStr(k - 1) + ', ' + Opnd);
        Line('  sar' + s + ' $1, ' + Opnd);
        Line('  setc ' + CarryM(1));
      end;
  end;
end;

{ Carry := bit 0 (Low) or bit N-1 of Opnd. }
procedure TEmitter.RotBitX86(N: LongInt; LowHalf: Boolean; const Opnd: string);
begin
  if N = 8 then
  begin
    if LowHalf then
      Line('  testb $1, ' + Opnd)
    else
      Line('  testb $128, ' + Opnd);
    Line('  setne ' + CarryM(1));
    Exit;
  end;
  if LowHalf then
    Line('  bt' + RotSfx(N) + ' $0, ' + Opnd)
  else
    Line('  bt' + RotSfx(N) + ' $' + IntToStr(N - 1) + ', ' + Opnd);
  Line('  setc ' + CarryM(1));
end;

{ The forms with a count in rcx, on the value in rax. }
procedure TEmitter.RotX86V(Kind, N: LongInt);
var
  s, r, done, lk, one: string;
begin
  s := RotSfx(N);
  r := '%' + X86Sub('rax', N div 8);
  done := Lab;
  Line('  testq %rcx, %rcx');
  Line('  jle ' + done);
  case Kind of
    1, 2:
      begin
        { The processor takes the count modulo 32 or 64 and a rotation
          of 8 or 16 bits modulo 8 or 16: n mod N in every width. }
        if Kind = 1 then
          Line('  rol' + s + ' %cl, ' + r)
        else
          Line('  ror' + s + ' %cl, ' + r);
        RotBitX86(N, Kind = 1, r);
      end;
    3, 4:
      begin
        lk := Lab;
        Line('  cmpq $' + IntToStr(N) + ', %rcx');
        Line('  jbe ' + lk);
        Line('  movq %rax, %r8');
        Line('  movq %rcx, %rax');
        Line('  xorl %edx, %edx');
        Line('  movl $' + IntToStr(N + 1) + ', %esi');
        Line('  divq %rsi');
        Line('  movq %rdx, %rcx');
        Line('  movq %r8, %rax');
        Line(lk + ':');
        one := '';
        if N >= 32 then
        begin
          { N places (32 or 64) are past the processor's count. }
          one := Lab;
          Line('  cmpl $' + IntToStr(N) + ', %ecx');
          Line('  je ' + one);
        end;
        Line('  btl $0, ' + CarryM(4));
        if Kind = 3 then
          Line('  rcl' + s + ' %cl, ' + r)
        else
          Line('  rcr' + s + ' %cl, ' + r);
        Line('  setc ' + CarryM(1));
        if one <> '' then
        begin
          Line('  jmp ' + done);
          Line(one + ':');
          Line('  btl $0, ' + CarryM(4));
          if Kind = 3 then
            Line('  rcr' + s + ' $1, ' + r)
          else
            Line('  rcl' + s + ' $1, ' + r);
          Line('  setc ' + CarryM(1));
        end;
      end;
    5, 6:
      begin
        Line('  xorl %edx, %edx');
        if Kind = 5 then
          Line('  shl' + s + ' %cl, ' + r)
        else
          Line('  shr' + s + ' %cl, ' + r);
        Line('  cmpq $' + IntToStr(N) + ', %rcx');
        Line('  cmovaeq %rdx, %rax');
      end;
    7:
      begin
        Line('  movl $' + IntToStr(N - 1) + ', %edx');
        Line('  cmpq %rdx, %rcx');
        Line('  cmovaq %rdx, %rcx');
        Line('  sar' + s + ' %cl, ' + r);
      end;
    8, 9:
      begin
        lk := Lab;
        Line('  cmpq $' + IntToStr(N) + ', %rcx');
        Line('  ja ' + lk);
        Line('  decl %ecx');
        if Kind = 8 then
        begin
          Line('  shl' + s + ' %cl, ' + r);
          Line('  shl' + s + ' $1, ' + r);
        end
        else
        begin
          Line('  shr' + s + ' %cl, ' + r);
          Line('  shr' + s + ' $1, ' + r);
        end;
        Line('  setc ' + CarryM(1));
        Line('  jmp ' + done);
        Line(lk + ':');
        Line('  xorl %eax, %eax');
        Line('  movb $0, ' + CarryM(1));
      end;
    10:
      begin
        Line('  movl $' + IntToStr(N) + ', %edx');
        Line('  cmpq %rdx, %rcx');
        Line('  cmovaq %rdx, %rcx');
        Line('  decl %ecx');
        Line('  sar' + s + ' %cl, ' + r);
        Line('  sar' + s + ' $1, ' + r);
        Line('  setc ' + CarryM(1));
      end;
  end;
  Line(done + ':');
end;

{ x0 from its low N bits: zero-extended, or sign-extended (Sgn). }
procedure TEmitter.RotExtArm(const R: string; N: LongInt; Sgn: Boolean);
var
  w: string;
begin
  if N >= 64 then
    Exit;
  w := 'w' + Copy(R, 2, 8);
  if Sgn then
  begin
    if N = 8 then
      Line('  sxtb ' + R + ', ' + w)
    else if N = 16 then
      Line('  sxth ' + R + ', ' + w)
    else
      Line('  sxtw ' + R + ', ' + w);
  end
  else if N = 8 then
    Line('  uxtb ' + w + ', ' + w)
  else if N = 16 then
    Line('  uxth ' + w + ', ' + w)
  else
    Line('  mov ' + w + ', ' + w);
end;

{ A rotation of N bits right by R places, R a register or '#k'; a byte
  or a halfword is repeated through w0 first, so a 32-bit ror turns it
  modulo its own width. }
procedure TEmitter.RorArm(N: LongInt; const R: string);
begin
  if N = 64 then
    Line('  ror x0, x0, ' + R)
  else
  begin
    if N = 8 then
      Line('  orr w0, w0, w0, lsl #8');
    if N <= 16 then
      Line('  orr w0, w0, w0, lsl #16');
    Line('  ror w0, w0, ' + R);
    if N = 8 then
      Line('  and w0, w0, #0xff')
    else if N = 16 then
      Line('  and w0, w0, #0xffff');
  end;
end;

{ Carry := bit 0 (Low) or bit N-1 of x0. }
procedure TEmitter.RotBitArm(N: LongInt; LowHalf: Boolean);
begin
  if LowHalf then
    Line('  and w9, w0, #1')
  else
    Line('  ubfx x9, x0, #' + IntToStr(N - 1) + ', #1');
  CarrySt('w9');
end;

{ The ring of N+1 bits turned left Kl places (x1, or the constant when
  Kl > 0), 1 <= places <= N. }
procedure TEmitter.RingArm(N: LongInt; Kl: Int64);
begin
  if N < 64 then
  begin
    CarryLd('w9');
    Line('  orr x0, x0, x9, lsl #' + IntToStr(N));
    if Kl > 0 then
    begin
      Line('  lsl x10, x0, #' + IntToStr(Kl));
      Line('  lsr x11, x0, #' + IntToStr(N + 1 - Kl));
    end
    else
    begin
      Line('  lsl x10, x0, x1');
      Line('  mov x11, #' + IntToStr(N + 1));
      Line('  sub x11, x11, x1');
      Line('  lsr x11, x0, x11');
    end;
    Line('  orr x0, x10, x11');
    Line('  ubfx x9, x0, #' + IntToStr(N) + ', #1');
    CarrySt('w9');
    Exit;
  end;
  { 65 bits: v << k, Carry << (k-1) and v >> (65-k), the new Carry bit
    64-k of v; each shift below 64. }
  CarryLd('w9');
  if Kl = 1 then
  begin
    Line('  lsr x10, x0, #63');
    Line('  orr x0, x9, x0, lsl #1');
  end
  else if Kl = 64 then
  begin
    Line('  and x10, x0, #1');
    Line('  lsr x0, x0, #1');
    Line('  orr x0, x0, x9, lsl #63');
  end
  else if Kl > 0 then
  begin
    Line('  ubfx x10, x0, #' + IntToStr(64 - Kl) + ', #1');
    Line('  lsr x11, x0, #' + IntToStr(65 - Kl));
    Line('  lsl x0, x0, #' + IntToStr(Kl));
    Line('  orr x0, x0, x11');
    Line('  orr x0, x0, x9, lsl #' + IntToStr(Kl - 1));
  end
  else
  begin
    Line('  sub x12, x1, #1');
    Line('  mov x11, #64');
    Line('  sub x11, x11, x1');
    Line('  lsr x13, x0, x11');
    Line('  and x10, x13, #1');
    Line('  lsr x13, x13, #1');
    Line('  lsl x14, x0, x12');
    Line('  lsl x14, x14, #1');
    Line('  lsl x9, x9, x12');
    Line('  orr x0, x14, x13');
    Line('  orr x0, x0, x9');
  end;
  CarrySt('w10');
end;

{ The constant forms on arm64, on x0; Cn >= 1. }
procedure TEmitter.RotArmK(Kind, N: LongInt; Cn: Int64);
var
  k: Int64;
begin
  case Kind of
    1, 2:
      begin
        k := Cn mod N;
        if k <> 0 then
          if Kind = 1 then
            RorArm(N, '#' + IntToStr(N - k))
          else
            RorArm(N, '#' + IntToStr(k));
        RotBitArm(N, Kind = 1);
      end;
    3, 4:
      begin
        k := Cn mod (N + 1);
        if k = 0 then
          Exit;
        if Kind = 4 then
          k := N + 1 - k;
        RingArm(N, k);
      end;
    5, 6:
      if Cn >= N then
        Line('  mov x0, xzr')
      else if Kind = 5 then
        Line('  lsl x0, x0, #' + IntToStr(Cn))
      else
        Line('  lsr x0, x0, #' + IntToStr(Cn));
    7:
      begin
        k := Cn;
        if k > 63 then
          k := 63;
        Line('  asr x0, x0, #' + IntToStr(k));
      end;
    8, 9:
      if Cn > N then
      begin
        Line('  mov x0, xzr');
        CarrySt('wzr');
      end
      else
      begin
        if Kind = 8 then
          Line('  ubfx x9, x0, #' + IntToStr(N - Cn) + ', #1')
        else
          Line('  ubfx x9, x0, #' + IntToStr(Cn - 1) + ', #1');
        if Cn >= 64 then
          Line('  mov x0, xzr')
        else if Kind = 8 then
          Line('  lsl x0, x0, #' + IntToStr(Cn))
        else
          Line('  lsr x0, x0, #' + IntToStr(Cn));
        CarrySt('w9');
      end;
    10:
      begin
        k := Cn;
        if k > N then
          k := N;
        Line('  ubfx x9, x0, #' + IntToStr(k - 1) + ', #1');
        if k > 63 then
          k := 63;
        Line('  asr x0, x0, #' + IntToStr(k));
        CarrySt('w9');
      end;
  end;
end;

{ The forms with a count in x1, on x0. }
procedure TEmitter.RotArmV(Kind, N: LongInt);
var
  done, lk: string;
begin
  done := Lab;
  Line('  cmp x1, #0');
  Line('  b.le ' + done);
  case Kind of
    1, 2:
      begin
        if Kind = 1 then
        begin
          if N = 64 then
          begin
            Line('  neg x9, x1');
            RorArm(N, 'x9');
          end
          else
          begin
            Line('  neg w9, w1');
            RorArm(N, 'w9');
          end;
        end
        else if N = 64 then
          RorArm(N, 'x1')
        else
          RorArm(N, 'w1');
        RotBitArm(N, Kind = 1);
      end;
    3, 4:
      begin
        lk := Lab;
        Line('  cmp x1, #' + IntToStr(N));
        Line('  b.ls ' + lk);
        Line('  mov x9, #' + IntToStr(N + 1));
        Line('  udiv x10, x1, x9');
        Line('  msub x1, x10, x9, x1');
        Line(lk + ':');
        Line('  cbz x1, ' + done);
        if Kind = 4 then
        begin
          Line('  mov x9, #' + IntToStr(N + 1));
          Line('  sub x1, x9, x1');
        end;
        RingArm(N, 0);
      end;
    5, 6:
      begin
        if Kind = 5 then
          Line('  lsl x9, x0, x1')
        else
          Line('  lsr x9, x0, x1');
        Line('  cmp x1, #64');
        Line('  csel x0, x9, xzr, lo');
      end;
    7:
      begin
        Line('  mov x9, #63');
        Line('  cmp x1, x9');
        Line('  csel x1, x9, x1, hi');
        Line('  asr x0, x0, x1');
      end;
    8, 9:
      begin
        Line('  sub x11, x1, #1');
        if Kind = 8 then
        begin
          Line('  mov x9, #' + IntToStr(N));
          Line('  sub x9, x9, x1');
          Line('  lsr x10, x0, x9');
          Line('  and x10, x10, #1');
          Line('  lsl x0, x0, x11');
          Line('  lsl x0, x0, #1');
        end
        else
        begin
          Line('  lsr x0, x0, x11');
          Line('  and x10, x0, #1');
          Line('  lsr x0, x0, #1');
        end;
        Line('  cmp x1, #' + IntToStr(N));
        Line('  csel x0, x0, xzr, ls');
        Line('  csel x10, x10, xzr, ls');
        CarrySt('w10');
      end;
    10:
      begin
        Line('  mov x9, #' + IntToStr(N));
        Line('  cmp x1, x9');
        Line('  csel x1, x9, x1, hi');
        Line('  sub x11, x1, #1');
        Line('  asr x0, x0, x11');
        Line('  and x10, x0, #1');
        Line('  asr x0, x0, #1');
        CarrySt('w10');
      end;
  end;
  Line(done + ':');
end;

{ The funnels on amd64: hi in rax, lo in rdx, the count in rcx unless
  Known (then Cn). }
procedure TEmitter.FunnelX86(Kind, N: LongInt; Known: Boolean; Cn: Int64);
var
  done, big, l1: string;
begin
  done := Lab;
  if N = 64 then
  begin
    if Known then
    begin
      if Cn <= 0 then
      begin
        if Kind = 21 then
          Line('  movq %rdx, %rax');
      end
      else if Cn < 64 then
      begin
        if Kind = 20 then
          Line('  shldq $' + IntToStr(Cn) + ', %rdx, %rax')
        else
        begin
          Line('  shrdq $' + IntToStr(Cn) + ', %rax, %rdx');
          Line('  movq %rdx, %rax');
        end;
      end
      else if Cn < 128 then
      begin
        if Kind = 20 then
        begin
          Line('  movq %rdx, %rax');
          if Cn > 64 then
            Line('  shlq $' + IntToStr(Cn - 64) + ', %rax');
        end
        else if Cn > 64 then
          Line('  shrq $' + IntToStr(Cn - 64) + ', %rax');
      end
      else
        Line('  xorl %eax, %eax');
      Exit;
    end;
    big := Lab;
    Line('  testq %rcx, %rcx');
    if Kind = 20 then
      Line('  jle ' + done)
    else
    begin
      l1 := Lab;
      Line('  jg ' + l1);
      Line('  movq %rdx, %rax');
      Line('  jmp ' + done);
      Line(l1 + ':');
    end;
    Line('  cmpq $64, %rcx');
    Line('  jae ' + big);
    if Kind = 20 then
      Line('  shldq %cl, %rdx, %rax')
    else
    begin
      Line('  shrdq %cl, %rax, %rdx');
      Line('  movq %rdx, %rax');
    end;
    Line('  jmp ' + done);
    Line(big + ':');
    if Kind = 20 then
    begin
      Line('  movq %rdx, %rax');
      Line('  shlq %cl, %rax');
    end
    else
      Line('  shrq %cl, %rax');
    Line('  xorl %edx, %edx');
    Line('  cmpq $128, %rcx');
    Line('  cmovaeq %rdx, %rax');
    Line(done + ':');
    Exit;
  end;
  { N <= 32: hi:lo is one 64-bit number, shifted once. }
  if Known then
  begin
    if Cn <= 0 then
    begin
      if Kind = 21 then
        Line('  movq %rdx, %rax');
    end
    else if Cn >= 2 * N then
      Line('  xorl %eax, %eax')
    else
    begin
      RotZExtX86('rax', N);
      RotZExtX86('rdx', N);
      Line('  shlq $' + IntToStr(N) + ', %rax');
      Line('  orq %rdx, %rax');
      if Kind = 20 then
      begin
        Line('  shlq $' + IntToStr(Cn) + ', %rax');
        Line('  shrq $' + IntToStr(N) + ', %rax');
      end
      else
        Line('  shrq $' + IntToStr(Cn) + ', %rax');
    end;
    Exit;
  end;
  Line('  testq %rcx, %rcx');
  if Kind = 20 then
    Line('  jle ' + done)
  else
  begin
    l1 := Lab;
    Line('  jg ' + l1);
    Line('  movq %rdx, %rax');
    Line('  jmp ' + done);
    Line(l1 + ':');
  end;
  RotZExtX86('rax', N);
  RotZExtX86('rdx', N);
  Line('  shlq $' + IntToStr(N) + ', %rax');
  Line('  orq %rdx, %rax');
  Line('  xorl %edx, %edx');
  if Kind = 20 then
  begin
    Line('  shlq %cl, %rax');
    Line('  shrq $' + IntToStr(N) + ', %rax');
  end
  else
    Line('  shrq %cl, %rax');
  Line('  cmpq $64, %rcx');
  Line('  cmovaeq %rdx, %rax');
  Line(done + ':');
end;

procedure TEmitter.RotZExtX86(const R: string; N: LongInt);
begin
  if N = 8 then
    Line('  movzbl %' + X86Sub(R, 1) + ', %' + X86Sub(R, 4))
  else if N = 16 then
    Line('  movzwl %' + X86Sub(R, 2) + ', %' + X86Sub(R, 4))
  else if N = 32 then
    Line('  movl %' + X86Sub(R, 4) + ', %' + X86Sub(R, 4));
end;

{ The funnels on arm64: hi in x0, lo in x2, the count in x1 unless
  Known. }
procedure TEmitter.FunnelArm(Kind, N: LongInt; Known: Boolean; Cn: Int64);
var
  done, big, l1: string;
begin
  done := Lab;
  if N = 64 then
  begin
    if Known then
    begin
      if Cn <= 0 then
      begin
        if Kind = 21 then
          Line('  mov x0, x2');
      end
      else if Cn < 64 then
      begin
        { extr is hi:lo shifted right, 64 bits of it }
        if Kind = 20 then
          Line('  extr x0, x0, x2, #' + IntToStr(64 - Cn))
        else
          Line('  extr x0, x0, x2, #' + IntToStr(Cn));
      end
      else if Cn < 128 then
      begin
        if Kind = 20 then
          Line('  lsl x0, x2, #' + IntToStr(Cn - 64))
        else
          Line('  lsr x0, x0, #' + IntToStr(Cn - 64));
      end
      else
        Line('  mov x0, xzr');
      Exit;
    end;
    big := Lab;
    Line('  cmp x1, #0');
    if Kind = 20 then
      Line('  b.le ' + done)
    else
    begin
      l1 := Lab;
      Line('  b.gt ' + l1);
      Line('  mov x0, x2');
      Line('  b ' + done);
      Line(l1 + ':');
    end;
    Line('  cmp x1, #64');
    Line('  b.hs ' + big);
    if Kind = 20 then
    begin
      Line('  lsl x0, x0, x1');
      Line('  neg x9, x1');
      Line('  lsr x9, x2, x9');
    end
    else
    begin
      Line('  lsr x9, x2, x1');
      Line('  neg x10, x1');
      Line('  lsl x0, x0, x10');
    end;
    Line('  orr x0, x0, x9');
    Line('  b ' + done);
    Line(big + ':');
    if Kind = 20 then
      Line('  lsl x0, x2, x1')
    else
      Line('  lsr x0, x0, x1');
    Line('  cmp x1, #128');
    Line('  csel x0, x0, xzr, lo');
    Line(done + ':');
    Exit;
  end;
  if Known then
  begin
    if Cn <= 0 then
    begin
      if Kind = 21 then
        Line('  mov x0, x2');
    end
    else if Cn >= 2 * N then
      Line('  mov x0, xzr')
    else
    begin
      RotExtArm('x0', N, False);
      RotExtArm('x2', N, False);
      Line('  orr x0, x2, x0, lsl #' + IntToStr(N));
      if Kind = 20 then
      begin
        Line('  lsl x0, x0, #' + IntToStr(Cn));
        Line('  lsr x0, x0, #' + IntToStr(N));
      end
      else
        Line('  lsr x0, x0, #' + IntToStr(Cn));
    end;
    Exit;
  end;
  Line('  cmp x1, #0');
  if Kind = 20 then
    Line('  b.le ' + done)
  else
  begin
    l1 := Lab;
    Line('  b.gt ' + l1);
    Line('  mov x0, x2');
    Line('  b ' + done);
    Line(l1 + ':');
  end;
  RotExtArm('x0', N, False);
  RotExtArm('x2', N, False);
  Line('  orr x0, x2, x0, lsl #' + IntToStr(N));
  if Kind = 20 then
  begin
    Line('  lsl x0, x0, x1');
    Line('  lsr x0, x0, #' + IntToStr(N));
  end
  else
    Line('  lsr x0, x0, x1');
  Line('  cmp x1, #64');
  Line('  csel x0, x0, xzr, lo');
  Line(done + ':');
end;

function IsSgnNarrow(T: LongInt): Boolean;
begin
  Result := (T = TyInt8) or (T = TyInt16) or (T = TyInt32);
end;

{ The result as its type holds it: N bits, sign-extended for Int8,
  Int16 and Int32, else zero-extended. }
procedure TEmitter.RotTail(T, N: LongInt);
var
  r: string;
begin
  if N >= 64 then
    Exit;
  if FArm then
    r := 'x0'
  else
    r := 'rax';
  if IsNarrowId(T) then
    CanonReg(r, T)
  else if FArm then
    RotExtArm(r, N, False)
  else
    RotZExtX86(r, N);
end;

function TEmitter.EmitRotFn(E: PExpr): Boolean;
var
  kind, n: LongInt;
  cn: Int64;
  known: Boolean;
  c: PExpr;
begin
  Result := False;
  if (E^.Name <> 'rt_rot') and (E^.Name <> 'rt_funnel') and (E^.Name <> 'rt_carry') and
    (E^.Name <> 'rt_carryon') and (E^.Name <> 'rt_carryoff') and
    (E^.Name <> 'rt_carryflip') and (E^.Name <> 'rt_setcarry') and
    (E^.Name <> 'rt_rotm') and (E^.Name <> 'rt_funnelm') then
    Exit;
  Result := True;
  if (E^.Name = 'rt_rotm') or (E^.Name = 'rt_funnelm') then
  begin
    EmitRotMem(E);
    Exit;
  end;
  if E^.Name = 'rt_carry' then
  begin
    if FArm then
      CarryLd('w0')
    else
      Line('  movzbl ' + CarryM(1) + ', %eax');
    Exit;
  end;
  if E^.Name = 'rt_carryon' then
  begin
    if FArm then
    begin
      Line('  mov w9, #1');
      CarrySt('w9');
    end
    else
      Line('  movb $1, ' + CarryM(1));
    Exit;
  end;
  if E^.Name = 'rt_carryoff' then
  begin
    if FArm then
      CarrySt('wzr')
    else
      Line('  movb $0, ' + CarryM(1));
    Exit;
  end;
  if E^.Name = 'rt_carryflip' then
  begin
    if FArm then
    begin
      CarryLd('w9');
      Line('  eor w9, w9, #1');
      CarrySt('w9');
    end
    else
      Line('  xorb $1, ' + CarryM(1));
    Exit;
  end;
  if E^.Name = 'rt_setcarry' then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      Line('  tst w0, #0xff');
      Line('  cset w9, ne');
      CarrySt('w9');
    end
    else
    begin
      Line('  testb %al, %al');
      Line('  setne ' + CarryM(1));
    end;
    Exit;
  end;
  if E^.Name = 'rt_funnel' then
  begin
    c := E^.Args[2];
    kind := LongInt(E^.Args[3]^.Num);
    n := LongInt(E^.Args[4]^.Num);
    known := c^.Kind = ekInt;
    cn := c^.Num;
    if not known then
    begin
      EmitExpr(c);
      if FArm then PshK('x0', 0) else PushK('rax', 0);
    end;
    EmitExpr(E^.Args[1]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      Ppop('x2');
      if not known then
        Ppop('x1');
      FunnelArm(kind, n, known, cn);
    end
    else
    begin
      Line('  popq %rdx');
      if not known then
        Line('  popq %rcx');
      FunnelX86(kind, n, known, cn);
    end;
    RotTail(E^.Typ, n);
    Exit;
  end;
  c := E^.Args[1];
  kind := LongInt(E^.Args[2]^.Num);
  n := LongInt(E^.Args[3]^.Num);
  known := c^.Kind = ekInt;
  cn := c^.Num;
  if known and (cn <= 0) then
  begin
    EmitExpr(E^.Args[0]);
    Exit;
  end;
  if not known then
  begin
    EmitExpr(c);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
  end;
  EmitExpr(E^.Args[0]);
  if FArm then
  begin
    if not known then
      Ppop('x1');
    RotExtArm('x0', n, (kind = 7) or (kind = 10));
    if known then
      RotArmK(kind, n, cn)
    else
      RotArmV(kind, n);
  end
  else
  begin
    if not known then
      Line('  popq %rcx');
    if known then
      RotX86K(kind, n, cn, '%' + X86Sub('rax', n div 8))
    else
      RotX86V(kind, n);
  end;
  { amd64 worked in the value's own width: only a signed one needs its
    upper bits again. }
  if FArm or IsSgnNarrow(E^.Typ) then
    RotTail(E^.Typ, n);
end;

{ The rotation words on a value bigger than a register, a string or a
  slice (P108, 1.0.130). Each operand waits in a scratch slot of its own
  type, where the collector sees a string's characters; the result gets
  a block of its own (a scratch slot, a new string, a new slice); and
  pasheap's PasRotMem does the work: rdi/x0 the result, rsi/x1 the
  operand, rdx/x2 a funnel's lo, rcx/x3 the bytes, r8/x4 the word plus
  256 times Carry, r9/x5 the count; the new Carry comes back in al/w0.
  Cls: 0 a record, an array or a vector (its address), 1 a Quad (two
  words), 2 a string, 3 a slice. }
procedure TEmitter.EmitRotMem(E: PExpr);
var
  fun, known: Boolean;
  t, cls, esz, kind, nsrc, i, slot, s0, s1, sn, sd: LongInt;
  cnt: PExpr;
  cn: Int64;
  ok: string;
begin
  fun := E^.Name = 'rt_funnelm';
  t := E^.Args[0]^.Typ;
  if fun then
  begin
    cnt := E^.Args[2];
    kind := LongInt(E^.Args[3]^.Num);
    nsrc := 2;
  end
  else
  begin
    cnt := E^.Args[1];
    kind := LongInt(E^.Args[2]^.Num);
    nsrc := 1;
  end;
  if TKind(t) = tykQuad then
    cls := 1
  else if IsStr(t) then
    cls := 2
  else if IsDyn(t) then
    cls := 3
  else
    cls := 0;
  esz := 1;
  if cls = 3 then
    esz := TSize(FTypes[t].Elem);
  known := cnt^.Kind = ekInt;
  cn := cnt^.Num;
  sn := 0;
  s0 := 0;
  s1 := 0;
  if not known then
  begin
    EmitExpr(cnt);
    sn := ScratchT(8, TyInteger);
    if FArm then
      StFP('x0', sn)
    else
      Line('  movq %rax, ' + IntToStr(sn) + '(%rbp)');
  end;
  for i := 0 to nsrc - 1 do
  begin
    EmitExpr(E^.Args[i]);
    if cls = 0 then
      slot := ScratchT(8, TyPointer)
    else if cls = 3 then
      slot := ScratchT(24, t)
    else
      slot := ScratchT(16, t);
    if FArm then
    begin
      StFP('x0', slot);
      if cls > 0 then
        StFP('x2', slot + 8);
      if cls = 3 then
        StFP('x3', slot + 16);
    end
    else
    begin
      Line('  movq %rax, ' + IntToStr(slot) + '(%rbp)');
      if cls > 0 then
        Line('  movq %rdx, ' + IntToStr(slot + 8) + '(%rbp)');
      if cls = 3 then
        Line('  movq %r8, ' + IntToStr(slot + 16) + '(%rbp)');
    end;
    if i = 0 then
      s0 := slot
    else
      s1 := slot;
  end;
  { a funnel's two strings or slices have one length }
  if fun and (cls >= 2) then
  begin
    ok := Lab;
    if FArm then
    begin
      LdFP('x0', s0 + 8);
      LdFP('x1', s1 + 8);
      Line('  cmp x0, x1');
      Line('  b.eq ' + ok);
      if esz > 1 then
      begin
        Imm('x9', esz);
        Line('  mul x0, x0, x9');
        Line('  mul x1, x1, x9');
      end;
      Line('  bl rt_funnelfail');
    end
    else
    begin
      Line('  movq ' + IntToStr(s0 + 8) + '(%rbp), %rdi');
      Line('  movq ' + IntToStr(s1 + 8) + '(%rbp), %rsi');
      Line('  cmpq %rsi, %rdi');
      Line('  je ' + ok);
      if esz > 1 then
      begin
        Line('  imulq $' + IntToStr(esz) + ', %rdi');
        Line('  imulq $' + IntToStr(esz) + ', %rsi');
      end;
      Line('  call rt_funnelfail');
    end;
    Line(ok + ':');
  end;
  { the result's own block }
  if cls = 0 then
    sd := ScratchT(TSize(t), t)
  else if cls = 1 then
    sd := ScratchT(16, t)
  else
  begin
    if FArm then
    begin
      LdFP('x0', s0 + 8);
      if cls = 2 then
        Line('  bl rt_stralloc')
      else
      begin
        if esz > 1 then
        begin
          Imm('x9', esz);
          Line('  mul x0, x0, x9');
        end;
        Line('  mov x1, xzr');
        Line('  bl rt_alloc');
      end;
    end
    else
    begin
      Line('  movq ' + IntToStr(s0 + 8) + '(%rbp), %rdi');
      if cls = 2 then
        Line('  call rt_stralloc')
      else
      begin
        if esz > 1 then
          Line('  imulq $' + IntToStr(esz) + ', %rdi');
        Line('  xorl %esi, %esi');
        Line('  call rt_alloc');
      end;
    end;
    if cls = 2 then
      sd := ScratchT(16, t)
    else
      sd := ScratchT(24, t);
    if FArm then
    begin
      StFP('x0', sd);
      LdFP('x9', s0 + 8);
      StFP('x9', sd + 8);
      if cls = 3 then
        StFP('x9', sd + 16);
    end
    else
    begin
      Line('  movq %rax, ' + IntToStr(sd) + '(%rbp)');
      Line('  movq ' + IntToStr(s0 + 8) + '(%rbp), %rcx');
      Line('  movq %rcx, ' + IntToStr(sd + 8) + '(%rbp)');
      if cls = 3 then
        Line('  movq %rcx, ' + IntToStr(sd + 16) + '(%rbp)');
    end;
  end;
  if FArm then
  begin
    if cls <= 1 then
      AddFP('x0', sd)
    else
      LdFP('x0', sd);
    if cls = 0 then
      LdFP('x1', s0)
    else if cls = 1 then
      AddFP('x1', s0)
    else
      LdFP('x1', s0);
    if not fun then
      Line('  mov x2, xzr')
    else if cls = 0 then
      LdFP('x2', s1)
    else if cls = 1 then
      AddFP('x2', s1)
    else
      LdFP('x2', s1);
    if cls = 0 then
      Imm('x3', TSize(t))
    else if cls = 1 then
      Imm('x3', 16)
    else
    begin
      LdFP('x3', s0 + 8);
      if esz > 1 then
      begin
        Imm('x9', esz);
        Line('  mul x3, x3, x9');
      end;
    end;
    CarryLd('w4');
    Imm('x9', kind);
    Line('  orr x4, x9, x4, lsl #8');
    if known then
      Imm('x5', cn)
    else
      LdFP('x5', sn);
    Line('  bl p_pasheap_pasrotmem');
    if (kind <= 4) or ((kind >= 8) and (kind <= 10)) then
      CarrySt('w0');
    if cls = 0 then
      AddFP('x0', sd)
    else
    begin
      LdFP('x0', sd);
      LdFP('x2', sd + 8);
      if cls = 3 then
        LdFP('x3', sd + 16);
    end;
    Exit;
  end;
  if cls <= 1 then
    Line('  leaq ' + IntToStr(sd) + '(%rbp), %rdi')
  else
    Line('  movq ' + IntToStr(sd) + '(%rbp), %rdi');
  if cls = 1 then
    Line('  leaq ' + IntToStr(s0) + '(%rbp), %rsi')
  else
    Line('  movq ' + IntToStr(s0) + '(%rbp), %rsi');
  if not fun then
    Line('  xorl %edx, %edx')
  else if cls = 1 then
    Line('  leaq ' + IntToStr(s1) + '(%rbp), %rdx')
  else
    Line('  movq ' + IntToStr(s1) + '(%rbp), %rdx');
  if cls = 0 then
    Line('  movq $' + IntToStr(TSize(t)) + ', %rcx')
  else if cls = 1 then
    Line('  movq $16, %rcx')
  else
  begin
    Line('  movq ' + IntToStr(s0 + 8) + '(%rbp), %rcx');
    if esz > 1 then
      Line('  imulq $' + IntToStr(esz) + ', %rcx');
  end;
  Line('  movzbl ' + CarryM(1) + ', %r8d');
  Line('  shll $8, %r8d');
  Line('  orl $' + IntToStr(kind) + ', %r8d');
  if not known then
    Line('  movq ' + IntToStr(sn) + '(%rbp), %r9')
  else if (cn >= -2147483647) and (cn <= 2147483647) then
    Line('  movq $' + IntToStr(cn) + ', %r9')
  else
    Line('  movabsq $' + IntToStr(cn) + ', %r9');
  Line('  call p_pasheap_pasrotmem');
  if (kind <= 4) or ((kind >= 8) and (kind <= 10)) then
    Line('  movb %al, ' + CarryM(1));
  if cls = 0 then
    Line('  leaq ' + IntToStr(sd) + '(%rbp), %rax')
  else
  begin
    Line('  movq ' + IntToStr(sd) + '(%rbp), %rax');
    Line('  movq ' + IntToStr(sd + 8) + '(%rbp), %rdx');
    if cls = 3 then
      Line('  movq ' + IntToStr(sd + 16) + '(%rbp), %r8');
  end;
end;

{ Carry in a promoted region (1.0.130): a loop that uses it keeps it in
  a register, 0 or 1, as it keeps a variable (PromoAddCarry, Part 9);
  the words then set, test and read that register. CarryReg is it, or
  '' outside such a region; CarryM is Carry as an amd64 operand of W
  bytes, the register or G+256; CarryLd and CarrySt move it on arm64. }
function TEmitter.CarryReg: string;
var
  i: SizeInt;
begin
  Result := '';
  if not FPromoOn then
    Exit;
  for i := 0 to High(FPromo) do
    if FPromo[i].Part = 9 then
    begin
      Result := FPromo[i].Reg;
      Exit;
    end;
end;

function TEmitter.CarryM(W: LongInt): string;
var
  r: string;
begin
  r := CarryReg;
  if r = '' then
    Result := '256(%r14)'
  else
    Result := '%' + X86Sub(r, W);
end;

procedure TEmitter.CarryLd(const W: string);
var
  r: string;
begin
  r := CarryReg;
  if r = '' then
    Line('  ldrb ' + W + ', [x28, #256]')
  else
    Line('  mov ' + W + ', w' + Copy(r, 2, 8));
end;

procedure TEmitter.CarrySt(const W: string);
var
  r: string;
begin
  r := CarryReg;
  if r = '' then
    Line('  strb ' + W + ', [x28, #256]')
  else
    Line('  mov w' + Copy(r, 2, 8) + ', ' + W);
end;

{ d := word(d, k) on amd64 for d an element, a field or a dereference:
  its address once, the word on the memory there (rclq $1 on a[i]),
  as InPlaceMem does for d := d + k. }
function TEmitter.RotInPlaceMem(S: PStmt): Boolean;
var
  d, e, c: PExpr;
  t, n: LongInt;
  m: string;
begin
  Result := False;
  if FArm or (S = nil) or (S^.Dest = nil) or (S^.E = nil) then
    Exit;
  d := S^.Dest;
  e := S^.E;
  if (d^.Kind <> ekIndex) and (d^.Kind <> ekField) and (d^.Kind <> ekDeref) then
    Exit;
  if (d^.Kind = ekIndex) and (d^.L <> nil) and IsStr(d^.L^.Typ) then
    Exit;
  if (e^.Kind <> ekCall) or (e^.Name <> 'rt_rot') or (Length(e^.Args) <> 4) then
    Exit;
  c := e^.Args[1];
  if c^.Kind <> ekInt then
    Exit;
  if not SameExpr(d, e^.Args[0]) then
    Exit;
  t := LoadTyp(d);
  if not (IsIntId(t) or (t = TyChar)) or (e^.Typ <> t) then
    Exit;
  n := LongInt(e^.Args[3]^.Num);
  if n <> TSize(t) * 8 then
    Exit;
  if not WordMemOK(d, 1) then
    Exit;
  Result := True;
  m := EmitWordMem(d, 1);
  if c^.Num > 0 then
    RotX86K(LongInt(e^.Args[2]^.Num), n, c^.Num, m);
end;

{ Append (P109, 1.0.132): s := Append(s, a, b) or Append(s, u) for a
  slice u of s's type, and a slice literal [a, b] (Append of nil). The
  elements are stored one by one into the hidden array the parser gave
  (Args[1]) with the assignment's own code, so a string, a record or a
  narrow value goes as it would by :=; the slice waits in a scratch slot
  of its type and rt_append grows it as SetLength does, in place only
  from its block's frontier, so no other slice of the block sees the new
  elements, then copies them after the old ones. }
procedure TEmitter.EmitAppend(E: PExpr);
var
  t, et, esz, k, i, slot, su: LongInt;
  isSlice: Boolean;
  smap: string;
begin
  t := E^.Typ;
  et := FTypes[t].Elem;
  esz := TSize(et);
  isSlice := E^.Name = 'rt_appendslice';
  su := 0;
  k := 0;
  if isSlice then
  begin
    EmitExpr(E^.Args[1]);
    su := ScratchT(24, t);
    if FArm then
    begin
      StFP('x0', su);
      StFP('x2', su + 8);
      StFP('x3', su + 16);
    end
    else
    begin
      Line('  movq %rax, ' + IntToStr(su) + '(%rbp)');
      Line('  movq %rdx, ' + IntToStr(su + 8) + '(%rbp)');
      Line('  movq %r8, ' + IntToStr(su + 16) + '(%rbp)');
    end;
  end
  else
  begin
    k := Length(E^.Args) - 2;
    for i := 0 to k - 1 do
    begin
      EmitExpr(E^.Args[i + 2]);
      FStoreSrc := E^.Args[i + 2];
      StoreTo(NewIndex(E^.Args[1], NewInt(i), et));
      FStoreSrc := nil;
    end;
  end;
  slot := ScratchT(24, t);
  if E^.Args[0]^.Kind = ekNil then
  begin
    if FArm then
    begin
      StFP('xzr', slot);
      StFP('xzr', slot + 8);
      StFP('xzr', slot + 16);
    end
    else
    begin
      Line('  movq $0, ' + IntToStr(slot) + '(%rbp)');
      Line('  movq $0, ' + IntToStr(slot + 8) + '(%rbp)');
      Line('  movq $0, ' + IntToStr(slot + 16) + '(%rbp)');
    end;
  end
  else
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      StFP('x0', slot);
      StFP('x2', slot + 8);
      StFP('x3', slot + 16);
    end
    else
    begin
      Line('  movq %rax, ' + IntToStr(slot) + '(%rbp)');
      Line('  movq %rdx, ' + IntToStr(slot + 8) + '(%rbp)');
      Line('  movq %r8, ' + IntToStr(slot + 16) + '(%rbp)');
    end;
  end;
  { the source: the hidden array, or u }
  if (not isSlice) and (k > 0) then
    EmitAddr(E^.Args[1]);
  smap := StrMap(et);
  if FArm then
  begin
    if isSlice then
    begin
      LdFP('x1', su);
      LdFP('x2', su + 8);
    end
    else
    begin
      if k > 0 then
        Line('  mov x1, x0')
      else
        Line('  mov x1, xzr');
      Imm('x2', k);
    end;
    AddFP('x0', slot);
    Imm('x3', esz);
    GcArg(GcWord(et), 'x4');
    if smap <> '' then
      LeaS(smap, 'x5')
    else
      Line('  mov x5, xzr');
    Line('  bl rt_append');
    LdFP('x0', slot);
    LdFP('x2', slot + 8);
    LdFP('x3', slot + 16);
    Exit;
  end;
  if isSlice then
  begin
    Line('  movq ' + IntToStr(su) + '(%rbp), %rsi');
    Line('  movq ' + IntToStr(su + 8) + '(%rbp), %rdx');
  end
  else
  begin
    if k > 0 then
      Line('  movq %rax, %rsi')
    else
      Line('  xorl %esi, %esi');
    Line('  movq $' + IntToStr(k) + ', %rdx');
  end;
  Line('  leaq ' + IntToStr(slot) + '(%rbp), %rdi');
  Line('  movq $' + IntToStr(esz) + ', %rcx');
  GcArg(GcWord(et), 'r8');
  if smap <> '' then
    Line('  leaq ' + smap + '(%rip), %r9')
  else
    Line('  xorq %r9, %r9');
  Line('  call rt_append');
  Line('  movq ' + IntToStr(slot) + '(%rbp), %rax');
  Line('  movq ' + IntToStr(slot + 8) + '(%rbp), %rdx');
  Line('  movq ' + IntToStr(slot + 16) + '(%rbp), %r8');
end;

{ The box of a routine with a closure inside (P109, 1.0.134): a heap
  block whose first word is the routine's own link and whose fields are
  the variables its nested routines use (Pr.Shared), each 8-byte
  aligned. The box's address is the block's plus 8, so -8 of it is the
  link and a nested routine walks boxes and frames alike. A parameter's
  value is copied in; every shared variable's slot then holds its
  field's address and the routine reaches it as it reaches a var
  parameter's, so no other code changes. Its nested routines get the
  box as their link (EmitLink), and see the variable at its field. The
  collector scans the block conservatively. }
procedure TEmitter.BoxSetup(const Pr: TProc);
var
  i, j, off, box: LongInt;
  isPar: Boolean;
  offs: array of LongInt;
  idx: array of SizeInt;
begin
  FBoxSlot := 0;
  if not Pr.Boxing then
    Exit;
  box := FindSym('$box').Off;
  offs := nil;
  idx := nil;
  off := 0;
  for i := 0 to High(Pr.Shared) do
    for j := High(FSym) downto 0 do
      if (not FSym[j].Global) and (FSym[j].Up = 0) and SameSym(FSym[j].Name, Pr.Shared[i]) then
      begin
        SetLength(offs, Length(offs) + 1);
        SetLength(idx, Length(idx) + 1);
        offs[High(offs)] := off;
        idx[High(idx)] := j;
        off := off + Align8(SlotSize(FSym[j].Typ));
        Break;
      end;
  { a box with no field (a routine whose closures share none of its own
    variables) still needs a word after the link (1.0.136): $box is the
    block's address plus 8, and one past an 8-byte block is no pointer
    into it, so the collector freed the box under the closure }
  if off = 0 then
    off := 8;
  if FArm then
  begin
    Imm('x0', off + 8);
    GcArg('1', 'x1');
    Line('  bl rt_alloc');
    if Pr.Nest > 0 then
    begin
      LdFP('x9', -8);
      Line('  str x9, [x0]');
    end;
    Line('  add x0, x0, #8');
    StFP('x0', box);
  end
  else
  begin
    Line('  movq $' + IntToStr(off + 8) + ', %rdi');
    GcArg('1', 'rsi');
    Line('  call rt_alloc');
    if Pr.Nest > 0 then
    begin
      Line('  movq -8(%rbp), %rcx');
      Line('  movq %rcx, (%rax)');
    end;
    Line('  leaq 8(%rax), %rax');
    Line('  movq %rax, ' + IntToStr(box) + '(%rbp)');
  end;
  for i := 0 to High(idx) do
  begin
    j := idx[i];
    isPar := SameSym(FSym[j].Name, 'self');
    for off := 0 to High(Pr.Params) do
      if SameSym(Pr.Params[off].Name, FSym[j].Name) then
        isPar := True;
    if FArm then
    begin
      if isPar then
      begin
        LdFP('x9', FSym[j].Off);
        Imm('x10', offs[i]);
        Line('  str x9, [x0, x10]');
      end;
      Imm('x10', offs[i]);
      Line('  add x9, x0, x10');
      StFP('x9', FSym[j].Off);
    end
    else
    begin
      if isPar then
      begin
        Line('  movq ' + IntToStr(FSym[j].Off) + '(%rbp), %rdx');
        Line('  movq %rdx, ' + IntToStr(offs[i]) + '(%rax)');
      end;
      Line('  leaq ' + IntToStr(offs[i]) + '(%rax), %rdx');
      Line('  movq %rdx, ' + IntToStr(FSym[j].Off) + '(%rbp)');
    end;
    FSym[j].ByRef := True;
    FSym[j].Boxed := True;
    FSym[j].BoxOff := offs[i];
  end;
  FBoxSlot := box;
end;

{ A closure's value (1.0.134): its code and the link its parent gives
  its nested routines (the parent's box). One that pins cells gets a
  scope box of its own: the parent's link at -8, then each pinned cell's
  address as it is now, so each pass's closure keeps its pass's cell. }
procedure TEmitter.EmitClosure(E: PExpr);
var
  i, k: SizeInt;
  pr: TProc;
  found: Boolean;
begin
  found := False;
  pr := Default(TProc);
  for i := 0 to High(FProgProcs) do
    if FProgProcs[i].Sym = E^.Name then
    begin
      pr := FProgProcs[i];
      found := True;
      Break;
    end;
  if not found then
    pr.Nest := ProcNest(E^.Name);
  if Length(pr.Pins) = 0 then
  begin
    if FArm then
    begin
      if pr.Nest > 0 then
      begin
        EmitLink(pr.Nest);
        Line('  mov x2, x27');
      end
      else
        Line('  mov x2, xzr');
      LeaS(E^.Name, 'x0');
    end
    else
    begin
      if pr.Nest > 0 then
      begin
        EmitLink(pr.Nest);
        Line('  movq %r10, %rdx');
      end
      else
        Line('  xorl %edx, %edx');
      Line('  leaq ' + E^.Name + '(%rip), %rax');
    end;
    Exit;
  end;
  k := Length(pr.Pins);
  if FArm then
  begin
    Imm('x0', 8 + 8 * k);
    GcArg('1', 'x1');
    Line('  bl rt_alloc');
    PshK('x0', 1);
    if pr.Nest > 1 then
    begin
      EmitLink(pr.Nest - 1);
      Line('  ldr x0, [sp]');
      Line('  str x27, [x0]');
    end;
    for i := 0 to k - 1 do
    begin
      LoadVar(pr.Pins[i]);
      Line('  ldr x9, [sp]');
      Imm('x10', 8 + 8 * i);
      Line('  str x0, [x9, x10]');
    end;
    Ppop('x2');
    Line('  add x2, x2, #8');
    LeaS(E^.Name, 'x0');
    Exit;
  end;
  Line('  movq $' + IntToStr(8 + 8 * k) + ', %rdi');
  GcArg('1', 'rsi');
  Line('  call rt_alloc');
  PushK('rax', 1);
  if pr.Nest > 1 then
  begin
    EmitLink(pr.Nest - 1);
    Line('  movq (%rsp), %rax');
    Line('  movq %r10, (%rax)');
  end;
  for i := 0 to k - 1 do
  begin
    LoadVar(pr.Pins[i]);
    Line('  movq (%rsp), %rcx');
    Line('  movq %rax, ' + IntToStr(8 + 8 * i) + '(%rcx)');
  end;
  Line('  popq %rdx');
  Line('  leaq 8(%rdx), %rdx');
  Line('  leaq ' + E^.Name + '(%rip), %rax');
end;

{ x := word(x, k) on amd64 with k a constant, x a variable of this
  routine or a global: the instruction works on x where it is (rclb $1
  on its byte, shlq $3 on its register). }
function TEmitter.RotInPlace(S: PStmt): Boolean;
var
  d: TSym;
  e, c: PExpr;
  n, kind: LongInt;
  k: Int64;
  op, sfx: string;
begin
  Result := False;
  if FArm or (S = nil) or (S^.Dest = nil) or (S^.E = nil) or (S^.Dest^.Kind <> ekVar) then
    Exit;
  e := S^.E;
  { x := x rol k and x := x ror k with a constant count (1.1.1): the
    rotation on x where it is, as the words below; it was a move to a
    temporary, the turn and a move back in every hash loop }
  if (e^.Kind = ekBin) and ((e^.Bin = boRol) or (e^.Bin = boRor)) and (e^.L <> nil) and
    (e^.R <> nil) and (e^.L^.Kind = ekVar) and (e^.L^.Name = S^.Dest^.Name) and
    (e^.R^.Kind = ekInt) then
  begin
    if not TryFindSym(S^.Dest^.Name, d) then
      Exit;
    if d.ByRef or (d.Up > 0) or (not IsIntId(d.Typ)) or (e^.Typ <> d.Typ) or
      (e^.L^.Typ <> d.Typ) then
      Exit;
    n := IntBits(d.Typ);
    k := e^.R^.Num mod n;
    if k < 0 then
      k := k + n;
    Result := True;
    if k = 0 then
      Exit;
    if e^.Bin = boRol then
      op := 'rol'
    else
      op := 'ror';
    if n = 8 then
      sfx := 'b'
    else if n = 16 then
      sfx := 'w'
    else if n = 32 then
      sfx := 'l'
    else
      sfx := 'q';
    if d.Reg <> '' then
    begin
      Line('  ' + op + sfx + ' $' + IntToStr(k) + ', %' + X86Sub(d.Reg, n div 8));
      CanonReg(d.Reg, d.Typ);
    end
    else
      Line('  ' + op + sfx + ' $' + IntToStr(k) + ', ' + MemA(d));
    Exit;
  end;
  if (e^.Kind <> ekCall) or (e^.Name <> 'rt_rot') or (Length(e^.Args) <> 4) then
    Exit;
  if (e^.Args[0]^.Kind <> ekVar) or (e^.Args[0]^.Name <> S^.Dest^.Name) then
    Exit;
  c := e^.Args[1];
  if c^.Kind <> ekInt then
    Exit;
  if not TryFindSym(S^.Dest^.Name, d) then
    Exit;
  if d.ByRef or (d.Up > 0) then
    Exit;
  if not (IsIntId(d.Typ) or (d.Typ = TyChar)) or (e^.Typ <> d.Typ) or
    (e^.Args[0]^.Typ <> d.Typ) then
    Exit;
  kind := LongInt(e^.Args[2]^.Num);
  n := LongInt(e^.Args[3]^.Num);
  if n <> IntBits(d.Typ) then
    Exit;
  Result := True;
  if c^.Num <= 0 then
    Exit;
  if d.Reg <> '' then
  begin
    RotX86K(kind, n, c^.Num, '%' + X86Sub(d.Reg, n div 8));
    if IsSgnNarrow(d.Typ) then
      CanonReg(d.Reg, d.Typ);
  end
  else
    RotX86K(kind, n, c^.Num, MemA(d));
end;

function TEmitter.EmitCpuFn(E: PExpr): Boolean;
begin
  Result := False;
  if (E^.Name <> 'rt_cpuhas') and (E^.Name <> 'rt_cpufeatures') and
    (E^.Name <> 'rt_cyclecount') and (E^.Name <> 'rt_cyclefreq') then
    Exit;
  Result := True;
  if E^.Name = 'rt_cyclecount' then
  begin
    if FArm then
      Line('  mrs x0, cntvct_el0')
    else
    begin
      Line('  rdtsc');
      Line('  shlq $32, %rdx');
      Line('  orq %rdx, %rax');
    end;
    Exit;
  end;
  if E^.Name = 'rt_cyclefreq' then
  begin
    if FArm then
      Line('  mrs x0, cntfrq_el0')
    else
      Line('  call rt_cyclefreq');
    Exit;
  end;
  if FArm then
    LdS('rt_cpufeat', 'x0')
  else
    Line('  movq rt_cpufeat(%rip), %rax');
  if E^.Name = 'rt_cpuhas' then
    if FArm then
      Line('  ubfx x0, x0, #' + IntToStr(E^.Args[0]^.Num) + ', #1')
    else
    begin
      Line('  shrq $' + IntToStr(E^.Args[0]^.Num) + ', %rax');
      Line('  andl $1, %eax');
    end;
end;

{ One of rt_cpuinit's bits on amd64: bit Src of cpuid's register R into
  bit Dst of r8, and-ed with a gate register (0 or 1) when the feature
  needs what the kernel saves. r10 is the scratch. }
procedure TEmitter.CpuBitX(const R: string; Src, Dst: LongInt; const Gate: string);
begin
  Line('  movl %' + R + ', %r10d');
  Line('  shrl $' + IntToStr(Src) + ', %r10d');
  if Gate = '' then
    Line('  andl $1, %r10d')
  else
    Line('  andl %' + Gate + ', %r10d');
  Line('  shlq $' + IntToStr(Dst) + ', %r10');
  Line('  orq %r10, %r8');
end;

function TEmitter.EmitAtomicFn(E: PExpr): Boolean;
var
  t, sz: LongInt;
  lp, sfx, ra, rc, r8, op: string;
begin
  Result := False;
  if (E^.Name <> 'rt_aload') and (E^.Name <> 'rt_axchg') and (E^.Name <> 'rt_aand') and
    (E^.Name <> 'rt_aor') and (E^.Name <> 'rt_axor') then
    Exit;
  Result := True;
  t := LongInt(E^.Args[High(E^.Args)]^.Num);
  sz := TSize(t);
  if E^.Name = 'rt_aload' then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then
    begin
      if sz = 1 then
        Line('  ldarb w0, [x0]')
      else if sz = 2 then
        Line('  ldarh w0, [x0]')
      else if sz = 4 then
        Line('  ldar w0, [x0]')
      else
        Line('  ldar x0, [x0]');
      CanonReg('x0', t);
    end
    else
    begin
      if sz = 1 then
        Line('  movzbl (%rax), %eax')
      else if sz = 2 then
        Line('  movzwl (%rax), %eax')
      else if sz = 4 then
        Line('  movl (%rax), %eax')
      else
        Line('  movq (%rax), %rax');
      CanonReg('rax', t);
    end;
    Exit;
  end;
  EmitExpr(E^.Args[1]);
  if FArm then PshK('x0', 0) else PushK('rax', 0);
  EmitExpr(E^.Args[0]);
  if FArm then
  begin
    Ppop('x1');
    if sz = 1 then
      sfx := 'b'
    else if sz = 2 then
      sfx := 'h'
    else
      sfx := '';
    if sz = 8 then
    begin
      ra := 'x2';
      rc := 'x4';
      r8 := 'x1';
    end
    else
    begin
      ra := 'w2';
      rc := 'w4';
      r8 := 'w1';
    end;
    lp := Lab;
    Line(lp + ':');
    Line('  ldaxr' + sfx + ' ' + ra + ', [x0]');
    if E^.Name = 'rt_axchg' then
      op := r8
    else
    begin
      if E^.Name = 'rt_aand' then
        Line('  and ' + rc + ', ' + ra + ', ' + r8)
      else if E^.Name = 'rt_aor' then
        Line('  orr ' + rc + ', ' + ra + ', ' + r8)
      else
        Line('  eor ' + rc + ', ' + ra + ', ' + r8);
      op := rc;
    end;
    Line('  stlxr' + sfx + ' w3, ' + op + ', [x0]');
    Line('  cbnz w3, ' + lp);
    Line('  mov x0, x2');
    if sz < 8 then
      Line('  and x0, x0, #' + IntToStr((Int64(1) shl (8 * sz)) - 1));
    CanonReg('x0', t);
    Exit;
  end;
  Line('  movq %rax, %rcx');
  Line('  popq %rdx');
  if sz = 1 then
    sfx := 'b'
  else if sz = 2 then
    sfx := 'w'
  else if sz = 4 then
    sfx := 'l'
  else
    sfx := 'q';
  if E^.Name = 'rt_axchg' then
  begin
    Line('  xchg' + sfx + ' %' + X86Sub('rdx', sz) + ', (%rcx)');
    Line('  movq %rdx, %rax');
  end
  else
  begin
    if sz = 1 then
      Line('  movzbl (%rcx), %eax')
    else if sz = 2 then
      Line('  movzwl (%rcx), %eax')
    else if sz = 4 then
      Line('  movl (%rcx), %eax')
    else
      Line('  movq (%rcx), %rax');
    lp := Lab;
    Line(lp + ':');
    Line('  movq %rax, %r8');
    if E^.Name = 'rt_aand' then
      op := 'and'
    else if E^.Name = 'rt_aor' then
      op := 'or'
    else
      op := 'xor';
    Line('  ' + op + 'q %rdx, %r8');
    Line('  lock cmpxchg' + sfx + ' %' + X86Sub('r8', sz) + ', (%rcx)');
    Line('  jne ' + lp);
  end;
  if sz = 1 then
    Line('  movzbl %al, %eax')
  else if sz = 2 then
    Line('  movzwl %ax, %eax')
  else if sz = 4 then
    Line('  movl %eax, %eax');
  CanonReg('rax', t);
end;

{ The words of P106 put in line (1.0.121): AddCarry and SubBorrow with
  the carry in the flag (adc/sbb after neg sets it; adcs/sbcs after a
  compare), the carry out stored at the width of its variable; the
  overflow checks, true when the 64-bit operation overflowed or its
  result does not fit the variable's type; AddSat and SubSat, clamped
  to the type's range (a 64-bit overflow gives the end on the side of
  the first operand). The operands are pushed and taken back in rax,
  rdx, rcx (x0, x1, x2); the last is an address, never pushed. }
function TEmitter.EmitWideFn(E: PExpr): Boolean;
var
  ok, op: string;
  t, sz: LongInt;
  lo, hi: Int64;
begin
  Result := False;
  if (E^.Name <> 'rt_addc') and (E^.Name <> 'rt_subb') and (E^.Name <> 'rt_addo') and
    (E^.Name <> 'rt_subo') and (E^.Name <> 'rt_mulo') and (E^.Name <> 'rt_addsat') and
    (E^.Name <> 'rt_subsat') then
    Exit;
  Result := True;
  if (E^.Name = 'rt_addc') or (E^.Name = 'rt_subb') then
  begin
    EmitExpr(E^.Args[0]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(E^.Args[1]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(E^.Args[2]);
    if FArm then PshK('x0', 0) else PushK('rax', 0);
    EmitExpr(E^.Args[3]);
    sz := LongInt(E^.Args[4]^.Num);
    if FArm then
    begin
      Line('  mov x3, x0');
      Ppop('x2');
      Ppop('x1');
      Ppop('x0');
      if E^.Name = 'rt_addc' then
      begin
        Line('  cmp x2, #1');
        Line('  adcs x0, x0, x1');
        Line('  cset x9, cs');
      end
      else
      begin
        Line('  cmp xzr, x2');
        Line('  sbcs x0, x0, x1');
        Line('  cset x9, cc');
      end;
      StoreWidth('x9', 'x3', sz);
    end
    else
    begin
      Line('  movq %rax, %r8');
      Line('  popq %rcx');
      Line('  popq %rdx');
      Line('  popq %rax');
      Line('  negq %rcx');
      if E^.Name = 'rt_addc' then
        Line('  adcq %rdx, %rax')
      else
        Line('  sbbq %rdx, %rax');
      Line('  setc %cl');
      Line('  movzbl %cl, %ecx');
      StoreWidth('rcx', 'r8', sz);
    end;
    Exit;
  end;
  EmitExpr(E^.Args[0]);
  if FArm then PshK('x0', 0) else PushK('rax', 0);
  EmitExpr(E^.Args[1]);
  t := LongInt(E^.Args[2]^.Num);
  if (E^.Name = 'rt_addsat') or (E^.Name = 'rt_subsat') then
  begin
    ok := Lab;
    if FArm then
    begin
      Line('  mov x1, x0');
      Ppop('x0');
      if IsNarrowId(t) then
      begin
        if E^.Name = 'rt_addsat' then
          Line('  add x0, x0, x1')
        else
          Line('  sub x0, x0, x1');
      end
      else
      begin
        Line('  mov x9, x0');
        if E^.Name = 'rt_addsat' then
          Line('  adds x0, x0, x1')
        else
          Line('  subs x0, x0, x1');
        Line('  b.vc ' + ok);
        Line('  asr x9, x9, #63');
        Line('  eor x0, x9, #0x7fffffffffffffff');
        Line(ok + ':');
      end;
    end
    else
    begin
      Line('  movq %rax, %rdx');
      Line('  popq %rax');
      if IsNarrowId(t) then
      begin
        if E^.Name = 'rt_addsat' then
          Line('  addq %rdx, %rax')
        else
          Line('  subq %rdx, %rax');
      end
      else
      begin
        Line('  movq %rax, %rcx');
        if E^.Name = 'rt_addsat' then
          Line('  addq %rdx, %rax')
        else
          Line('  subq %rdx, %rax');
        Line('  jno ' + ok);
        Line('  sarq $63, %rcx');
        Line('  btcq $63, %rcx');
        Line('  notq %rcx');
        Line('  movq %rcx, %rax');
        Line(ok + ':');
      end;
    end;
    if IsNarrowId(t) then
    begin
      { in the narrow type's range: the 64-bit sum is exact }
      sz := TSize(t) * 8;
      if (t = TyInt8) or (t = TyInt16) or (t = TyInt32) then
      begin
        lo := -(Int64(1) shl (sz - 1));
        hi := (Int64(1) shl (sz - 1)) - 1;
      end
      else
      begin
        lo := 0;
        hi := (Int64(1) shl sz) - 1;
      end;
      if FArm then
      begin
        Imm('x9', hi);
        Line('  cmp x0, x9');
        Line('  csel x0, x9, x0, gt');
        Imm('x9', lo);
        Line('  cmp x0, x9');
        Line('  csel x0, x9, x0, lt');
      end
      else
      begin
        LoadImmR('rcx', hi);
        Line('  cmpq %rcx, %rax');
        Line('  cmovgq %rcx, %rax');
        LoadImmR('rcx', lo);
        Line('  cmpq %rcx, %rax');
        Line('  cmovlq %rcx, %rax');
      end;
    end;
    Exit;
  end;
  { AddOverflow, SubOverflow, MulOverflow: Args[2] is the address. }
  if FArm then PshK('x0', 0) else PushK('rax', 0);
  EmitExpr(E^.Args[2]);
  t := LongInt(E^.Args[3]^.Num);
  if FArm then
  begin
    Line('  mov x3, x0');
    Ppop('x1');
    Ppop('x0');
    if E^.Name = 'rt_mulo' then
    begin
      Line('  mul x10, x0, x1');
      Line('  smulh x11, x0, x1');
      Line('  cmp x11, x10, asr #63');
      Line('  cset x9, ne');
      Line('  mov x0, x10');
    end
    else
    begin
      if E^.Name = 'rt_addo' then
        Line('  adds x0, x0, x1')
      else
        Line('  subs x0, x0, x1');
      Line('  cset x9, vs');
    end;
    if IsNarrowId(t) then
    begin
      Line('  mov x10, x0');
      CanonReg('x10', t);
      Line('  cmp x10, x0');
      Line('  cset x11, ne');
      Line('  orr x9, x9, x11');
    end;
    StoreWidth('x0', 'x3', TSize(t));
    Line('  mov x0, x9');
  end
  else
  begin
    Line('  movq %rax, %r8');
    Line('  popq %rdx');
    Line('  popq %rax');
    if E^.Name = 'rt_addo' then
      op := 'addq'
    else if E^.Name = 'rt_subo' then
      op := 'subq'
    else
      op := 'imulq';
    Line('  ' + op + ' %rdx, %rax');
    Line('  seto %sil');
    if IsNarrowId(t) then
    begin
      Line('  movq %rax, %rcx');
      CanonReg('rcx', t);
      Line('  cmpq %rax, %rcx');
      Line('  setne %dil');
      Line('  orb %dil, %sil');
    end;
    StoreWidth('rax', 'r8', TSize(t));
    Line('  movzbl %sil, %eax');
  end;
end;

{ A bit number in R (rax or a pool register on amd64, x0 or one on
  arm64), checked against 0..Hi with one unsigned compare, so a negative
  one fails too; out of range, rt_bitfail stops the program with the
  line this call returns to (P105, 1.0.117). }
procedure TEmitter.EmitBitChk(const R: string; Hi: Int64);
var
  ok: string;
begin
  ok := Lab;
  if FArm then
  begin
    Line('  cmp ' + R + ', #' + IntToStr(Hi));
    Line('  b.ls ' + ok);
    if R <> 'x0' then
      Line('  mov x0, ' + R);
    Line('  mov x1, #0');
    Line('  mov x2, #' + IntToStr(Hi));
    Line('  bl rt_bitfail');
  end
  else
  begin
    Line('  cmpq $' + IntToStr(Hi) + ', %' + R);
    Line('  jbe ' + ok);
    if R <> 'rdi' then
      Line('  movq %' + R + ', %rdi');
    Line('  xorl %esi, %esi');
    Line('  movq $' + IntToStr(Hi) + ', %rdx');
    Line('  call rt_bitfail');
  end;
  Line(ok + ':');
end;

{ A bit word of P105 on the clean value in R, in the width of its
  operand's type (1.0.117). A signed narrow value is zero-extended
  first. amd64 (R rax or a pool register; rax, rcx and rdx are free,
  the two not R the temporaries): popcnt when -cpu says the
  processor has it, else the SWAR count; trailing zeros are bsf over a
  sentinel bit at the width (bsf + cmovz for 64 bits); leading zeros
  bsr of 2x + 1 taken from the width (bsr + cmovz + xor for 64 bits);
  bswap (rolw for 16 bits); a bit reversal is a bswap and three SWAR
  swaps, then a shift down to the width. arm64: cnt through v16, rbit +
  clz over the sentinel, clz, rev16/rev/rev, rbit and a shift. A result
  of a signed narrow type is cleaned where it is looked at (NarrowOp). }
procedure TEmitter.EmitBitUn(E: PExpr; const R: string);
var
  t, w: LongInt;
  t1, t2, x, a, b: string;
begin
  t := E^.L^.Typ;
  w := IntBits(t);
  if FArm then
  begin
    x := WReg(R);
    if t = TyInt8 then
      Line('  and ' + R + ', ' + R + ', #0xff')
    else if t = TyInt16 then
      Line('  and ' + R + ', ' + R + ', #0xffff')
    else if t = TyInt32 then
      Line('  mov ' + x + ', ' + x);
    case E^.Un of
      uoPopCnt:
        begin
          Line('  fmov d16, ' + R);
          Line('  cnt v16.8b, v16.8b');
          Line('  addv b16, v16.8b');
          Line('  fmov ' + R + ', d16');
        end;
      uoCtz:
        begin
          if w < 64 then
            Line('  orr ' + R + ', ' + R + ', #' + IntToStr(Int64(1) shl w));
          Line('  rbit ' + R + ', ' + R);
          Line('  clz ' + R + ', ' + R);
        end;
      uoClz:
        begin
          if w = 64 then
            Line('  clz ' + R + ', ' + R)
          else
          begin
            Line('  clz ' + x + ', ' + x);
            if w < 32 then
              Line('  sub ' + R + ', ' + R + ', #' + IntToStr(32 - w));
          end;
        end;
      uoBswap:
        if w = 64 then
          Line('  rev ' + R + ', ' + R)
        else if w = 32 then
          Line('  rev ' + x + ', ' + x)
        else if w = 16 then
          Line('  rev16 ' + x + ', ' + x);
      uoRbit:
        if w = 64 then
          Line('  rbit ' + R + ', ' + R)
        else
        begin
          Line('  rbit ' + x + ', ' + x);
          if w < 32 then
            Line('  lsr ' + x + ', ' + x + ', #' + IntToStr(32 - w));
        end;
    end;
    Exit;
  end;
  if R = 'rax' then
  begin
    t1 := 'rcx';
    t2 := 'rdx';
  end
  else
  begin
    t1 := 'rax';
    t2 := 'rcx';
  end;
  if t = TyInt8 then
    Line('  movzbl %' + X86Sub(R, 1) + ', %' + X86Sub(R, 4))
  else if t = TyInt16 then
    Line('  movzwl %' + X86Sub(R, 2) + ', %' + X86Sub(R, 4))
  else if t = TyInt32 then
    Line('  movl %' + X86Sub(R, 4) + ', %' + X86Sub(R, 4));
  case E^.Un of
    uoPopCnt:
      if HasFeat(5) then
        Line('  popcntq %' + R + ', %' + R)
      else
      begin
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $1, %' + t1);
        Line('  movabsq $6148914691236517205, %' + t2);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  subq %' + t1 + ', %' + R);
        Line('  movabsq $3689348814741910323, %' + t2);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $2, %' + t1);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  andq %' + t2 + ', %' + R);
        Line('  addq %' + t1 + ', %' + R);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $4, %' + t1);
        Line('  addq %' + t1 + ', %' + R);
        Line('  movabsq $1085102592571150095, %' + t2);
        Line('  andq %' + t2 + ', %' + R);
        Line('  movabsq $72340172838076673, %' + t2);
        Line('  imulq %' + t2 + ', %' + R);
        Line('  shrq $56, %' + R);
      end;
    uoCtz:
      if w < 64 then
      begin
        Line('  btsq $' + IntToStr(w) + ', %' + R);
        Line('  bsfq %' + R + ', %' + R);
      end
      else
      begin
        Line('  movl $64, %' + X86Sub(t1, 4));
        Line('  bsfq %' + R + ', %' + R);
        Line('  cmovzq %' + t1 + ', %' + R);
      end;
    uoClz:
      if w < 64 then
      begin
        Line('  leaq 1(%' + R + ',%' + R + '), %' + R);
        Line('  bsrq %' + R + ', %' + R);
        Line('  negq %' + R);
        Line('  addq $' + IntToStr(w) + ', %' + R);
      end
      else
      begin
        Line('  movl $127, %' + X86Sub(t1, 4));
        Line('  bsrq %' + R + ', %' + R);
        Line('  cmovzq %' + t1 + ', %' + R);
        Line('  xorq $63, %' + R);
      end;
    uoBswap:
      if w = 64 then
        Line('  bswapq %' + R)
      else if w = 32 then
        Line('  bswapl %' + X86Sub(R, 4))
      else if w = 16 then
        Line('  rolw $8, %' + X86Sub(R, 2));
    uoRbit:
      begin
        Line('  bswapq %' + R);
        Line('  movabsq $1085102592571150095, %' + t2);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $4, %' + t1);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  andq %' + t2 + ', %' + R);
        Line('  shlq $4, %' + R);
        Line('  orq %' + t1 + ', %' + R);
        Line('  movabsq $3689348814741910323, %' + t2);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $2, %' + t1);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  andq %' + t2 + ', %' + R);
        Line('  shlq $2, %' + R);
        Line('  orq %' + t1 + ', %' + R);
        Line('  movabsq $6148914691236517205, %' + t2);
        Line('  movq %' + R + ', %' + t1);
        Line('  shrq $1, %' + t1);
        Line('  andq %' + t2 + ', %' + t1);
        Line('  andq %' + t2 + ', %' + R);
        Line('  addq %' + R + ', %' + R);
        Line('  orq %' + t1 + ', %' + R);
        if w < 64 then
          Line('  shrq $' + IntToStr(64 - w) + ', %' + R);
      end;
  end;
end;


{ Register R (rax, rcx, r8 ... on amd64; x0 ... on arm64) holds a value
  of type T with only its low bits right: extend them (P99). A value in
  a register or a word of memory is always clean, so a load of a word
  needs nothing and a comparison works on the whole register. }
procedure TEmitter.CanonReg(const R: string; T: LongInt);
var
  w, b8, b16, b32: string;
begin
  if not IsNarrowId(T) then
    Exit;
  if FArm then
  begin
    w := 'w' + Copy(R, 2, 8);
    case T of
      TyByte: Line('  uxtb ' + w + ', ' + w);
      TyInt8: Line('  sxtb ' + R + ', ' + w);
      TyWord: Line('  uxth ' + w + ', ' + w);
      TyInt16: Line('  sxth ' + R + ', ' + w);
      TyUInt32: Line('  mov ' + w + ', ' + w);
    else
      Line('  sxtw ' + R + ', ' + w);
    end;
    Exit;
  end;
  b8 := X86Sub(R, 1);
  b16 := X86Sub(R, 2);
  b32 := X86Sub(R, 4);
  case T of
    TyByte: Line('  movzbl %' + b8 + ', %' + b32);
    TyInt8: Line('  movsbq %' + b8 + ', %' + R);
    TyWord: Line('  movzwl %' + b16 + ', %' + b32);
    TyInt16: Line('  movswq %' + b16 + ', %' + R);
    TyUInt32: Line('  movl %' + b32 + ', %' + b32);
  else
    Line('  movslq %' + b32 + ', %' + R);
  end;
end;

{ The type field Off (named N, or any at Off when N is empty) of record
  or class T has, a pointer to one taken through; -1 when none. }
function TEmitter.FieldTypAt(T, Off: LongInt; const N: string): LongInt;
var
  k: LongInt;
  i: SizeInt;
begin
  Result := -1;
  k := T;
  if TKind(k) = tykPointer then
    k := FTypes[k].Elem;
  while (k > 0) and (k <= High(FTypes)) do
  begin
    for i := 0 to High(FTypes[k].Fields) do
      if (FTypes[k].Fields[i].Off = Off) and
        ((N = '') or (ToLower(FTypes[k].Fields[i].Name) = ToLower(N))) then
      begin
        Result := FTypes[k].Fields[i].Typ;
        Exit;
      end;
    if TKind(k) <> tykClass then
      Break;
    k := FTypes[k].Parent;
  end;
end;

{ The type a value is stored as (P99): the field's, the element's, the
  variable's, whatever type the parser gave the node since (Integer(b),
  Ord(c) and T(x) retype a leaf in place). The load takes its width and
  its sign from it. }
function TEmitter.LoadTyp(E: PExpr): LongInt;
var
  t: LongInt;
  s: TSym;
begin
  Result := TyNone;
  if E = nil then
    Exit;
  Result := E^.Typ;
  if (E^.Kind = ekDeref) and (E^.L <> nil) and (TKind(E^.L^.Typ) = tykPointer) then
    Result := FTypes[E^.L^.Typ].Elem
  else if (E^.Kind = ekIndex) and (E^.L <> nil) then
  begin
    if IsStr(E^.L^.Typ) then
      Result := TyChar
    else if IsDyn(E^.L^.Typ) or (TKind(E^.L^.Typ) = tykArray) or
      (TKind(E^.L^.Typ) = tykPointer) then
      Result := FTypes[E^.L^.Typ].Elem;
  end
  else if (E^.Kind = ekField) and (E^.L <> nil) then
  begin
    t := FieldTypAt(E^.L^.Typ, E^.Off, E^.Name);
    if t >= 0 then
      Result := t;
  end
  else if (E^.Kind = ekProp) and (E^.L <> nil) and (E^.Off >= 0) and
    (E^.Name = '') then
  begin
    t := FieldTypAt(E^.L^.Typ, E^.Off, '');
    if t >= 0 then
      Result := t;
  end
  else if E^.Kind = ekVar then
  begin
    if TryFindSym(E^.Name, s) then
      Result := s.Typ;
  end;
end;

{ Every value E can take lies in Lo..Hi, so a static array's index check
  cannot fail (P100): E of a narrow integer type, whose values are always
  clean, or a Char. A subrange or an enumeration may hold any value, so
  they keep the check. }
function TEmitter.IndexInRange(E: PExpr; Lo, Hi: Int64): Boolean;
var
  t: LongInt;
  c: Int64;
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  { counter + c, which the run's head found in Lo..Hi (EmitFor). }
  if FProvOn and CounterOff(E, c) then
    for i := 0 to High(FProv) do
      if (FProv[i].Arr = '') and (FProv[i].Lo = Lo) and (FProv[i].Hi = Hi) and
        (FProv[i].C = c) then
      begin
        Result := True;
        Exit;
      end;
  { The stored type: Ord(c) of a Char still loads a byte. }
  t := LoadTyp(E);
  if IsNarrowId(t) then
    Result := (FTypes[t].Lo >= Lo) and (FTypes[t].Hi <= Hi)
  else if t = TyChar then
    Result := (Lo <= 0) and (Hi >= 255);
end;

{ A and B name the same place or value, with no call in them, so working
  either out gives the same (P100). }
function TEmitter.SameExpr(A, B: PExpr): Boolean;
begin
  Result := False;
  if (A = nil) or (B = nil) then
  begin
    Result := A = B;
    Exit;
  end;
  if A^.Kind <> B^.Kind then
    Exit;
  case A^.Kind of
    ekInt:
      Result := A^.Num = B^.Num;
    ekVar:
      Result := ToLower(A^.Name) = ToLower(B^.Name);
    ekField:
      Result := (A^.Off = B^.Off) and SameExpr(A^.L, B^.L);
    ekDeref:
      Result := SameExpr(A^.L, B^.L);
    ekIndex:
      Result := SameExpr(A^.L, B^.L) and SameExpr(A^.R, B^.R);
    ekBin:
      Result := (A^.Bin = B^.Bin) and (A^.Typ = B^.Typ) and
        SameExpr(A^.L, B^.L) and SameExpr(A^.R, B^.R);
    ekUn:
      Result := (A^.Un = B^.Un) and (A^.Typ = B^.Typ) and SameExpr(A^.L, B^.L);
  end;
end;

{ X, the same place, is read somewhere in E (P100). }
function TEmitter.ContainsSame(E, X: PExpr): Boolean;
var
  i: SizeInt;
begin
  Result := False;
  if E = nil then
    Exit;
  if SameExpr(E, X) then
  begin
    Result := True;
    Exit;
  end;
  if ContainsSame(E^.L, X) or ContainsSame(E^.R, X) then
  begin
    Result := True;
    Exit;
  end;
  for i := 0 to High(E^.Args) do
    if ContainsSame(E^.Args[i], X) then
    begin
      Result := True;
      Exit;
    end;
end;

{ d := d op x for d an element, a field or a dereference (P100): its
  address is worked out once and amd64 changes the memory in place at
  its width, addb for a Byte, which wraps as the Byte does. hist[b] :=
  hist[b] + 1 worked out the address twice and went through the stack. }
function TEmitter.InPlaceMem(Dest, E: PExpr): Boolean;
var
  m, op, ins: string;
  sz, t: LongInt;
begin
  Result := False;
  if FArm or (E = nil) or (Dest = nil) or (E^.Kind <> ekBin) or (E^.R = nil) then
    Exit;
  if (E^.Bin <> boAdd) and (E^.Bin <> boSub) and (E^.Bin <> boAnd) and
    (E^.Bin <> boOr) and (E^.Bin <> boXor) then
    Exit;
  if (Dest^.Kind <> ekIndex) and (Dest^.Kind <> ekField) and (Dest^.Kind <> ekDeref) then
    Exit;
  if (Dest^.Kind = ekIndex) and (Dest^.L <> nil) and IsStr(Dest^.L^.Typ) then
    Exit;
  if not SameExpr(Dest, E^.L) then
    Exit;
  t := LoadTyp(Dest);
  if not IsIntId(t) then
    Exit;
  sz := TSize(t);
  if IsIntId(E^.Typ) and (TSize(E^.Typ) <> sz) then
    Exit;
  if not WordMemOK(Dest, 1) then
    Exit;
  if (E^.R^.Kind = ekInt) and Fits32(E^.R^.Num) then
    op := '$' + IntToStr(E^.R^.Num)
  else
  begin
    if not OrdSimple(E^.R, 0) then
      Exit;
    EmitOrdTo(E^.R, 0);
    op := '%' + X86Sub(OrdPool(0), sz);
  end;
  m := EmitWordMem(Dest, 1);
  case E^.Bin of
    boAdd: ins := 'add';
    boSub: ins := 'sub';
    boAnd: ins := 'and';
    boOr: ins := 'or';
  else
    ins := 'xor';
  end;
  if sz = 1 then
    ins := ins + 'b'
  else if sz = 2 then
    ins := ins + 'w'
  else if sz = 4 then
    ins := ins + 'l'
  else
    ins := ins + 'q';
  Line('  ' + ins + ' ' + op + ', ' + m);
  Result := True;
end;

{ Load a value of type T at M into register R (x0.. / rax.., named
  without %), extended to a clean word: by the sign for Int8, Int16 and
  Int32, by zeros for the others (P99). }
procedure TEmitter.LoadTo(const M: string; T: LongInt; const R: string);
var
  sz: LongInt;
begin
  sz := TSize(T);
  if FArm then
  begin
    if sz = 1 then
    begin
      if T = TyInt8 then
        Line('  ldrsb ' + R + ', ' + M)
      else
        Line('  ldrb ' + WReg(R) + ', ' + M);
    end
    else if sz = 2 then
    begin
      if T = TyInt16 then
        Line('  ldrsh ' + R + ', ' + M)
      else
        Line('  ldrh ' + WReg(R) + ', ' + M);
    end
    else if sz = 4 then
    begin
      if T = TyInt32 then
        Line('  ldrsw ' + R + ', ' + M)
      else
        Line('  ldr ' + WReg(R) + ', ' + M);
    end
    else
      Line('  ldr ' + R + ', ' + M);
    Exit;
  end;
  if sz = 1 then
  begin
    if T = TyInt8 then
      Line('  movsbq ' + M + ', %' + R)
    else
      Line('  movzbq ' + M + ', %' + R);
  end
  else if sz = 2 then
  begin
    if T = TyInt16 then
      Line('  movswq ' + M + ', %' + R)
    else
      Line('  movzwq ' + M + ', %' + R);
  end
  else if sz = 4 then
  begin
    if T = TyInt32 then
      Line('  movslq ' + M + ', %' + R)
    else
      Line('  movl ' + M + ', %' + X86Sub(R, 4));
  end
  else
    Line('  movq ' + M + ', %' + R);
end;

{ Store the low Sz bytes (1, 2, 4 or 8) of register R at M. }
procedure TEmitter.StoreFrom(const M: string; Sz: LongInt; const R: string);
begin
  if FArm then
  begin
    if Sz = 1 then
      Line('  strb ' + WReg(R) + ', ' + M)
    else if Sz = 2 then
      Line('  strh ' + WReg(R) + ', ' + M)
    else if Sz = 4 then
      Line('  str ' + WReg(R) + ', ' + M)
    else
      Line('  str ' + R + ', ' + M);
    Exit;
  end;
  if Sz = 1 then
    Line('  movb %' + X86Sub(R, 1) + ', ' + M)
  else if Sz = 2 then
    Line('  movw %' + X86Sub(R, 2) + ', ' + M)
  else if Sz = 4 then
    Line('  movl %' + X86Sub(R, 4) + ', ' + M)
  else
    Line('  movq %' + R + ', ' + M);
end;

{ Every expression goes through here: a narrow operation's result is
  cleaned once it is worked out (P99; P100 leaves it to the consumer). }
procedure TEmitter.EmitExpr(E: PExpr);
begin
  EmitExprRaw(E);
  { The pool cleaned it already when EmitExprRaw worked it out there. }
  if NarrowOp(E) and not KeepsClean(E) and not OrdSimple(E, 0) then
  begin
    if FArm then
      CanonReg('x0', E^.Typ)
    else
      CanonReg('rax', E^.Typ);
  end;
end;

procedure TEmitter.EmitExprRaw(E: PExpr);
var
  i, nreg: SizeInt;
  a, b: string;
  off: LongInt;
begin
  if E = nil then
  begin
    if FArm then
      Line('  mov x0, xzr')
    else
      Line('  xorq %rax, %rax');
    Exit;
  end;
  { An integer expression without calls is worked out in the register
    pool, with no stack traffic (P93). }
  if ((E^.Kind = ekBin) or (E^.Kind = ekUn) or (E^.Kind = ekIndex) or
    (E^.Kind = ekField) or (E^.Kind = ekDeref)) and OrdSimple(E, 0) then
  begin
    EmitOrdTo(E, 0);
    if FArm then
      Line('  mov x0, ' + OrdPool(0))
    else
      Line('  movq %' + OrdPool(0) + ', %rax');
    Exit;
  end;
  if FArm then
  begin
    case E^.Kind of
      ekInt:
        Imm('x0', E^.Num);
      ekReal:
        begin
          Imm('x0', E^.Num);
          if TKind(E^.Typ) = tykQuad then
            Imm('x2', E^.Hi);
        end;
      ekNil:
        begin
          Line('  mov x0, xzr');
          Line('  mov x2, xzr');
          Line('  mov x3, xzr');
        end;
      ekStr:
        begin
          LeaS(InternStr(E^.Str), 'x0');
          Imm('x2', Length(E^.Str));
        end;
      ekVar:
        if IsBlob(FindSym(E^.Name).Typ) then
          EmitAddr(E)
        else
          LoadVar(E^.Name);
      ekAddr:
        begin
          FAddrWrite := E^.Num = 0;
          EmitAddr(E^.L);
        end;
      ekField, ekDeref, ekIndex:
        begin
          if IsBlob(E^.Typ) then
            EmitAddr(E)
          else
          begin
            EmitAddr(E);
            if IsFat(E^.Typ) then
            begin
              if IsDyn(E^.Typ) then
                Line('  ldr x3, [x0, #16]');
              Line('  ldr x2, [x0, #8]');
              Line('  ldr x0, [x0]');
            end
            else
              LoadTo('[x0]', LoadTyp(E), 'x0');
          end;
        end;
      ekMakeChan:
        begin
          if E^.L <> nil then
            EmitExpr(E^.L)
          else
            Line('  mov x0, xzr');
          Line('  bl rt_makechan');
        end;
      ekRecv:
        begin
          EmitExpr(E^.L);
          Line('  bl rt_chanrecv');
          if ChanBoxed(E^.L^.Typ) then
            EmitUnbox(FTypes[E^.L^.Typ].Elem);
        end;
      ekCtor:
        begin
          Imm('x0', E^.Off);
          GcArg(GcWordInst(E^.Typ), 'x1');
          Line('  bl rt_alloc');
          PshK('x0', 1);
          LeaS('vmt_' + ToLower(FTypes[E^.Typ].Name), 'x1');
          Line('  str x1, [x0]');
          nreg := Length(E^.Args);
          if nreg > 7 then
            Die('constructor arguments');
          for i := 0 to nreg - 1 do
          begin
            EmitArgVal(E^.Args[i]);
            PshK('x0', ACls(E^.Args[i]));
          end;
          if nreg = 0 then
            Line('  ldr x0, [sp]')
          else
            Line('  ldr x0, [sp, #' + IntToStr(nreg * 16) + ']');
          for i := 0 to nreg - 1 do
            Line('  ldr ' + ArgR(LongInt(i + 1)) + ', [sp, #' +
              IntToStr((nreg - 1 - i) * 16) + ']');
          if E^.Name <> '' then
            Line('  bl ' + E^.Name);
          if nreg > 0 then
          begin
            Imm('x16', nreg * 16);
            Line('  add sp, sp, x16');
          end;
          Ppop('x0');
        end;
      ekProp:
        begin
          if E^.Name <> '' then
          begin
            LookupMeth(E^.L^.Typ, E^.Name, a, off);
            EmitArmMeth(E^.L, E^.Args, off, a);
          end
          else
          begin
            EmitExpr(E^.L);
            if E^.Off <> 0 then
            begin
              Imm('x16', E^.Off);
              Line('  add x0, x0, x16');
            end;
            if not IsBlob(E^.Typ) then
            begin
              if IsFat(E^.Typ) then
              begin
                if IsDyn(E^.Typ) then
                  Line('  ldr x3, [x0, #16]');
                Line('  ldr x2, [x0, #8]');
                Line('  ldr x0, [x0]');
              end
              else
                LoadTo('[x0]', LoadTyp(E), 'x0');
            end;
          end;
        end;
      ekMethod:
        if E^.Off = -4 then
          EmitCallVal(E^.L, E^.Args)
        else if (E^.L <> nil) and (TKind(E^.L^.Typ) = tykInterface) then
          EmitIfaceCall(E^.L, E^.Args, E^.Off)
        else
          EmitArmMeth(E^.L, E^.Args, E^.Off, E^.Name);
      ekMethPtr:
        begin
          EmitExpr(E^.L);
          Line('  mov x2, x0');
          LeaS(E^.Name, 'x0');
        end;
      ekProcPtr:
        if (E^.Flags and 2) <> 0 then
          EmitClosure(E)
        else
        begin
          LeaS(E^.Name, 'x0');
          Line('  mov x2, xzr');
        end;
      ekCall:
        if EmitTreeCall(E) then
        begin
        end
        else if E^.Name = 'rt_syscall' then
          EmitSyscall(E^.Args)
        else if EmitQuadFn(E) then
        begin
        end
        else if EmitRealFn(E) then
        begin
        end
        else if E^.Name = 'rt_chstr' then
        begin
          { A Char where a string belongs: one heap byte, so the string
            outlives the frame it was made in. }
          EmitExpr(E^.Args[0]);
          Line('  bl rt_chstr');
        end
        else if E^.Name = 'rt_length' then
        begin
          EmitExpr(E^.Args[0]);
          if (TKind(E^.Args[0]^.Typ) = tykMap) or
            (TKind(E^.Args[0]^.Typ) = tykTree) or
            (TKind(E^.Args[0]^.Typ) = tykHeap) then
          begin
            { Length of a nil map is 0. }
            a := Lab;
            Line('  cbz x0, ' + a);
            Line('  ldr x0, [x0]');
            Line(a + ':');
          end
          else if IsStr(E^.Args[0]^.Typ) or IsDyn(E^.Args[0]^.Typ) then
            Line('  mov x0, x2')
          else if TKind(E^.Args[0]^.Typ) = tykArray then
            Imm('x0', FTypes[E^.Args[0]^.Typ].Hi - FTypes[E^.Args[0]^.Typ].Lo + 1)
           else
             Line('  mov x0, x2');
        end
        else if (E^.Name = 'rt_xxh32') or (E^.Name = 'rt_xxh64') or
          (E^.Name = 'rt_xxh3') then
        begin
          EmitExpr(E^.Args[1]);
          PshK('x0', VCls(E^.Args[1]^.Typ, 0));
          EmitExpr(E^.Args[0]);
          Ppop('x1');
          Line('  bl ' + E^.Name);
        end
        else if E^.Name = 'rt_mapnew' then
        begin
          EmitExpr(E^.Args[0]);
          Line('  mov x1, x0');
          LeaS('.LdescMap_' + IntToStr(E^.Typ), 'x0');
          Line('  bl p_pasmap_pasmapnew');
        end
        else if E^.Name = 'rt_mapput' then
        begin
          { m[k] written through a field, a var argument or op= (1.0.140):
            the value's slot, inserted with a zero value when the key was
            missing, as EmitMapStore finds it; a string key is shared,
            since the map keeps it. }
          EmitExpr(E^.Args[0]);
          PshK('x0', VCls(E^.Args[0]^.Typ, 0));
          if IsStr(E^.Args[1]^.Typ) then
          begin
            off := ScratchT(16, E^.Args[1]^.Typ);
            EmitExpr(E^.Args[1]);
            ShareStrOf(E^.Args[1]);
            StFP('x0', off);
            StFP('x2', off + 8);
            Ppop('x0');
            Imm('x1', off);
            Line('  add x1, x29, x1');
            LeaS('.LdescMap_' + IntToStr(E^.Args[0]^.Typ), 'x2');
            Line('  bl p_pasmap_pasmapputstr');
          end
          else
          begin
            EmitExpr(E^.Args[1]);
            Line('  mov x1, x0');
            Ppop('x0');
            LeaS('.LdescMap_' + IntToStr(E^.Args[0]^.Typ), 'x2');
            Line('  bl p_pasmap_pasmapputint');
          end;
        end
        else if (E^.Name = 'rt_mapget') or (E^.Name = 'rt_mapin') or
          (E^.Name = 'rt_mapdel') then
        begin
          EmitExpr(E^.Args[0]);
          PshK('x0', VCls(E^.Args[0]^.Typ, 0));
          { An ordinal key by value to the eight-byte path (P96). }
          if (not IsStr(E^.Args[1]^.Typ)) and (E^.Name <> 'rt_mapdel') then
          begin
            EmitExpr(E^.Args[1]);
            Line('  mov x1, x0');
            Ppop('x0');
            a := 'p_pasmap_pasmapgetint';
          end
          else
          begin
            off := ScratchT(16, E^.Args[1]^.Typ);
            if IsStr(E^.Args[1]^.Typ) then
            begin
              EmitExpr(E^.Args[1]);
              StFP('x0', off);
              StFP('x2', off + 8);
            end
            else
            begin
              EmitExpr(E^.Args[1]);
              StFP('x0', off);
            end;
            Ppop('x0');
            Imm('x1', off);
            Line('  add x1, x29, x1');
            LeaS('.LdescMap_' + IntToStr(E^.Args[0]^.Typ), 'x2');
            if IsStr(E^.Args[1]^.Typ) and ((E^.Name = 'rt_mapget') or (E^.Name = 'rt_mapin')) then
              a := 'rt_mapgetstr'
            else if IsStr(E^.Args[1]^.Typ) and (E^.Name <> 'rt_mapdel') then
              a := 'p_pasmap_pasmapgetstr'
            else
              a := 'p_pasmap_pasmapget';
          end;
          if E^.Name = 'rt_mapget' then
          begin
            Line('  bl ' + a);
            a := Lab;
            b := Lab;
            Line('  cbz x0, ' + a);
            if IsBlob(E^.Typ) then
            begin
            end
            else if IsDyn(E^.Typ) then
            begin
              Line('  ldr x3, [x0, #16]');
              Line('  ldr x2, [x0, #8]');
              Line('  ldr x0, [x0]');
            end
            else if IsFat(E^.Typ) then
            begin
              Line('  ldr x2, [x0, #8]');
              Line('  ldr x0, [x0]');
            end
            else
              Line('  ldr x0, [x0]');
            Line('  b ' + b);
            Line(a + ':');
            if IsBlob(E^.Typ) then
            begin
              { a missing record reads from the zero block (1.0.140):
                m[k].X went through a nil slot pointer }
              if TSize(E^.Typ) > FZeroMax then
                FZeroMax := TSize(E^.Typ);
              LeaS('.Lzeroblk', 'x0');
            end
            else
              Line('  mov x0, xzr');
            if IsDyn(E^.Typ) then
            begin
              Line('  mov x2, xzr');
              Line('  mov x3, xzr');
            end
            else if IsFat(E^.Typ) then
              Line('  mov x2, xzr');
            Line(b + ':');
          end
          else if E^.Name = 'rt_mapin' then
          begin
            Line('  bl ' + a);
            Line('  cmp x0, #0');
            Line('  cset x0, ne');
          end
          else
            Line('  bl p_pasmap_pasmapdelete');
        end
        else if E^.Name = 'rt_maptry' then
        begin
          { TryGet(m, k, v): look the key up, then copy the value out. }
          EmitExpr(E^.Args[0]);
          PshK('x0', VCls(E^.Args[0]^.Typ, 0));
          off := ScratchT(16, E^.Args[1]^.Typ);
          if IsStr(E^.Args[1]^.Typ) then
          begin
            EmitExpr(E^.Args[1]);
            StFP('x0', off);
            StFP('x2', off + 8);
          end
          else
          begin
            EmitExpr(E^.Args[1]);
            StFP('x0', off);
          end;
          Ppop('x0');
          Imm('x1', off);
          Line('  add x1, x29, x1');
          LeaS('.LdescMap_' + IntToStr(E^.Args[0]^.Typ), 'x2');
          Line('  bl p_pasmap_pasmapget');
          a := Lab;
          b := Lab;
          Line('  cbz x0, ' + a);
          PshK('x0', 1);
          EmitExpr(E^.Args[2]);
          Ppop('x1');
          Imm('x2', TSize(FTypes[E^.Args[0]^.Typ].Elem2));
          Line('  bl rt_memcpy');
          Line('  mov x0, #1');
          Line('  b ' + b);
          Line(a + ':');
          Line('  mov x0, xzr');
          Line(b + ':');
        end
else if E^.Name = 'rt_high' then
        begin
          EmitExpr(E^.Args[0]);
          if IsDyn(E^.Args[0]^.Typ) then
          begin
            Line('  mov x0, x2');
            Line('  sub x0, x0, #1');
          end
          else if TKind(E^.Args[0]^.Typ) = tykArray then
            Imm('x0', FTypes[E^.Args[0]^.Typ].Hi)
          else
            Line('  mov x0, x2');
        end
        else if E^.Name = 'rt_low' then
        begin
          if TKind(E^.Args[0]^.Typ) = tykArray then
            Imm('x0', FTypes[E^.Args[0]^.Typ].Lo)
          else
            Line('  mov x0, xzr');
        end
        else if E^.Name = 'rt_default' then
        begin
          Line('  mov x0, xzr');
          Line('  mov x2, xzr');
          Line('  mov x3, xzr');
        end
        else if E^.Name = 'rt_getmem' then
        begin
          if Length(E^.Args) > 1 then
          begin
            EmitExpr(E^.Args[1]);
            PshK('x0', VCls(E^.Args[1]^.Typ, 0));
            EmitExpr(E^.Args[0]);
            Ppop('x1');
            Line('  cmp x1, #0');
            Line('  cset x1, ne');
          end
          else
          begin
            EmitExpr(E^.Args[0]);
            Line('  mov x1, #1');
          end;
          Line('  bl rt_alloc');
        end
        else if E^.Name = 'rt_copy' then
        begin
          EmitExpr(E^.Args[0]);
          PshK('x2', VCls(E^.Args[0]^.Typ, 1));
          PshK('x0', VCls(E^.Args[0]^.Typ, 0));
          EmitExpr(E^.Args[1]);
          PshK('x0', VCls(E^.Args[1]^.Typ, 0));
          EmitExpr(E^.Args[2]);
          Line('  mov x3, x0');
          Ppop('x1');
          Ppop('x0');
          Ppop('x2');
          Line('  bl rt_strcopy');
        end
        else if E^.Name = 'rt_view' then
        begin
          EmitExpr(E^.Args[1]);
          PshK('x0', 0);
          EmitExpr(E^.Args[0]);
          Ppop('x2');
          a := Lab;
          Line('  cmp x2, #0');
          Line('  b.ge ' + a);
          BoundsFailArm('x2', 0, 0, '', High(Int64), 0);
          Line(a + ':');
          Line('  mov x3, #0');
        end
        else if E^.Name = 'rt_slice' then
        begin
          EmitExpr(E^.Args[2]);
          PshK('x0', 0);
          EmitExpr(E^.Args[1]);
          PshK('x0', 0);
          EmitExpr(E^.Args[0]);
          Ppop('x4');
          Ppop('x5');
          a := Lab;
          Line('  cmp x4, x2');
          Line('  b.ls ' + a);
          BoundsFailArm('x4', 0, 0, 'x2', 0, 0);
          Line(a + ':');
          a := Lab;
          b := Lab;
          Line('  add x6, x5, #1');
          Line('  cmp x6, x4');
          Line('  b.lt ' + b);
          Line('  cmp x6, x2');
          Line('  b.le ' + a);
          Line(b + ':');
          BoundsFailArm('x5', 0, 0, 'x2', 0, -1);
          Line(a + ':');
          Line('  sub x2, x6, x4');
          Imm('x7', TSize(FTypes[E^.Typ].Elem));
          Line('  madd x0, x4, x7, x0');
          Line('  mov x3, #0');
        end
        else if E^.Name = 'rt_aslice' then
        begin
          EmitExpr(E^.Args[2]);
          PshK('x0', 0);
          EmitExpr(E^.Args[1]);
          PshK('x0', 0);
          EmitAddr(E^.Args[0]);
          Ppop('x4');
          Ppop('x5');
          Imm('x7', FTypes[E^.Args[0]^.Typ].Lo);
          Line('  sub x6, x4, x7');
          Imm('x7', FTypes[E^.Args[0]^.Typ].Hi - FTypes[E^.Args[0]^.Typ].Lo + 1);
          a := Lab;
          Line('  cmp x6, x7');
          Line('  b.ls ' + a);
          BoundsFailArm('x4', 0, FTypes[E^.Args[0]^.Typ].Lo, '', FTypes[E^.Args[0]^.Typ].Hi + 1, 0);
          Line(a + ':');
          a := Lab;
          b := Lab;
          Line('  add x2, x5, #1');
          Line('  sub x2, x2, x4');
          Line('  cmp x2, #0');
          Line('  b.lt ' + b);
          Line('  add x8, x6, x2');
          Line('  cmp x8, x7');
          Line('  b.le ' + a);
          Line(b + ':');
          BoundsFailArm('x5', 0, FTypes[E^.Args[0]^.Typ].Lo, '', FTypes[E^.Args[0]^.Typ].Hi, 0);
          Line(a + ':');
          Imm('x7', TSize(FTypes[E^.Typ].Elem));
          Line('  madd x0, x6, x7, x0');
          Line('  mov x3, #0');
        end
        else if E^.Name = 'rt_paramcount' then
          Line('  bl rt_paramcount')
        else if E^.Name = 'rt_paramstr' then
        begin
          EmitExpr(E^.Args[0]);
          Line('  bl rt_paramstr');
        end
        else
          EmitCall(E^.Name, E^.Args);
      ekSet:
        begin
          Psh('x19');
          Line('  mov x19, xzr');
          for i := 0 to High(E^.Args) do
            if E^.Args[i]^.Kind = ekRange then
            begin
              Psh('x20');
              Psh('x22');
              EmitExpr(E^.Args[i]^.L);
              Line('  mov x20, x0');
              EmitExpr(E^.Args[i]^.R);
              Line('  mov x22, x0');
              a := Lab;
              b := Lab;
              Line(a + ':');
              Line('  cmp x20, x22');
              Line('  b.gt ' + b);
              Line('  mov x9, #1');
              Line('  lsl x9, x9, x20');
              Line('  orr x19, x19, x9');
              Line('  add x20, x20, #1');
              Line('  b ' + a);
              Line(b + ':');
              Ppop('x22');
              Ppop('x20');
            end
            else
            begin
              EmitExpr(E^.Args[i]);
              Line('  mov x9, #1');
              Line('  lsl x9, x9, x0');
              Line('  orr x19, x19, x9');
            end;
          Line('  mov x0, x19');
          Ppop('x19');
        end;
      ekUn:
        begin
          EmitExpr(E^.L);
          { A conversion to a narrow integer: EmitExpr cleans x0 (P99). }
          if E^.Un = uoConv then
          begin
          end
          else if BitUnOp(E^.Un) then
            EmitBitUn(E, 'x0')
          else if E^.Un = uoNeg then
          begin
            if (E^.L <> nil) and (E^.L^.Typ = TySingle) then
              Line('  eor x0, x0, #0x80000000')
            else if (E^.L <> nil) and (TKind(E^.L^.Typ) = tykReal) then
            begin
              Line('  mov x9, #1');
              Line('  lsl x9, x9, #63');
              Line('  eor x0, x0, x9');
            end
            else
              Line('  neg x0, x0');
          end
          else if E^.Typ = TyBoolean then
          begin
            Line('  cmp x0, #0');
            Line('  cset x0, eq');
          end
          else
            Line('  mvn x0, x0');
        end;
      ekBin:
        begin
          if FCheckPtr and (TKind(E^.Typ) = tykPointer) and
            ((E^.Bin = boAdd) or (E^.Bin = boSub)) then
            EmitPtrArith(E)
          else if ((E^.Bin = boAnd) or (E^.Bin = boOr)) and (E^.Typ = TyBoolean) then
          begin
            a := Lab;
            b := Lab;
            EmitExpr(E^.L);
            if E^.Bin = boAnd then
              Line('  cbz x0, ' + a)
            else
              Line('  cbnz x0, ' + a);
            EmitExpr(E^.R);
            Line('  cmp x0, #0');
            Line('  cset x0, ne');
            Line('  b ' + b);
            Line(a + ':');
            if E^.Bin = boAnd then
              Line('  mov x0, xzr')
            else
              Line('  mov x0, #1');
            Line(b + ':');
          end
          else if ((E^.Bin = boEq) or (E^.Bin = boNe)) and
            IsStr(E^.L^.Typ) and IsStr(E^.R^.Typ) then
          begin
            EmitExpr(E^.L);
            PshK('x2', VCls(E^.L^.Typ, 1));
            PshK('x0', VCls(E^.L^.Typ, 0));
            EmitExpr(E^.R);
            Line('  mov x3, x2');
            Line('  mov x2, x0');
            Ppop('x0');
            Ppop('x1');
            Line('  bl rt_streq');
            if E^.Bin = boNe then
            begin
              Line('  cmp x0, #0');
              Line('  cset x0, eq');
            end;
          end
          else if ((E^.Bin = boLt) or (E^.Bin = boLe) or (E^.Bin = boGt) or
            (E^.Bin = boGe)) and IsStr(E^.L^.Typ) and IsStr(E^.R^.Typ) then
          begin
            { P74, on arm64: the letters, not the addresses. }
            EmitExpr(E^.L);
            PshK('x2', VCls(E^.L^.Typ, 1));
            PshK('x0', VCls(E^.L^.Typ, 0));
            EmitExpr(E^.R);
            Line('  mov x3, x2');
            Line('  mov x2, x0');
            Ppop('x0');
            Ppop('x1');
            Line('  bl rt_strcmp');
            Line('  cmp x0, #0');
            if E^.Bin = boLt then
              Line('  cset x0, lt')
            else if E^.Bin = boLe then
              Line('  cset x0, le')
            else if E^.Bin = boGt then
              Line('  cset x0, gt')
            else
              Line('  cset x0, ge');
          end
          else if E^.Bin = boConcat then
          begin
            EmitExpr(E^.L);
            if not IsStr(E^.L^.Typ) then
            begin
              FScrHint := 0;
              off := Scratch(8);
              AddFP('x16', off);
              Line('  strb w0, [x16]');
              Line('  mov x0, x16');
              Line('  mov x2, #1');
            end;
            PshK('x2', 0);
            PshK('x0', 1);
            EmitExpr(E^.R);
            if not IsStr(E^.R^.Typ) then
            begin
              FScrHint := 0;
              off := Scratch(8);
              AddFP('x16', off);
              Line('  strb w0, [x16]');
              Line('  mov x0, x16');
              Line('  mov x2, #1');
            end;
            Line('  mov x3, x2');
            Line('  mov x2, x0');
            Ppop('x0');
            Ppop('x1');
            Line('  bl rt_concat');
          end
          else if (E^.Bin = boIs) or (E^.Bin = boAs) then
            EmitClassRel(E)
          else if RealBin(E) then
            EmitRealBin(E)
          else if DivConstOK(E) then
          begin
            EmitExpr(E^.L);
            EmitDivConst('x0', E^.R^.Num, E^.Bin = boMod);
          end
          else
          begin
            if (E^.L^.Kind = ekStr) and (Length(E^.L^.Str) = 1) then
              Imm('x0', Ord(E^.L^.Str[1]))
            else
              EmitExpr(E^.L);
            PshK('x0', VCls(E^.L^.Typ, 0));
            if (E^.R^.Kind = ekStr) and (Length(E^.R^.Str) = 1) then
              Imm('x0', Ord(E^.R^.Str[1]))
            else
              EmitExpr(E^.R);
            case E^.Bin of
              boAdd:
                begin
                  Ppop('x1');
                  if TKind(E^.Typ) = tykSet then
                    Line('  orr x0, x1, x0')
                  else
                    Line('  add x0, x1, x0');
                end;
              boSub:
                begin
                  Ppop('x1');
                  if TKind(E^.Typ) = tykSet then
                  begin
                    Line('  mvn x0, x0');
                    Line('  and x0, x1, x0');
                  end
                  else
                    Line('  sub x0, x1, x0');
                end;
              boMul:
                begin
                  Ppop('x1');
                  if TKind(E^.Typ) = tykSet then
                    Line('  and x0, x1, x0')
                  else
                    Line('  mul x0, x1, x0');
                end;
              boIn:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  Line('  lsr x9, x1, x0');
                  Line('  and x0, x9, #1');
                end;
              boDiv:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  EmitDivCheck;
                  Line('  sdiv x0, x0, x1');
                end;
              boMod:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  EmitDivCheck;
                  Line('  sdiv x9, x0, x1');
                  Line('  msub x0, x9, x1, x0');
                end;
              boEq: EmitCmp('sete');
              boNe: EmitCmp('setne');
              boLt: EmitCmp('setl');
              boLe: EmitCmp('setle');
              boGt: EmitCmp('setg');
              boGe: EmitCmp('setge');
              boAnd:
                begin
                  Ppop('x1');
                  Line('  and x0, x1, x0');
                end;
              boOr:
                begin
                  Ppop('x1');
                  Line('  orr x0, x1, x0');
                end;
              boXor:
                begin
                  Ppop('x1');
                  Line('  eor x0, x1, x0');
                end;
              boShl:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  Line('  lsl x0, x0, x1');
                end;
              boShr:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  { A clean Int8, Int16 or Int32 shifts by its sign (P99). }
                  if (E^.Typ = TyInt8) or (E^.Typ = TyInt16) or (E^.Typ = TyInt32) then
                    Line('  asr x0, x0, x1')
                  else
                    Line('  lsr x0, x0, x1');
                end;
              boSar, boRol, boRor:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  RotArm(E^.Bin, E^.Typ);
                end;
              boMulHi, boMulHiS:
                begin
                  Line('  mov x1, x0');
                  Ppop('x0');
                  if E^.Bin = boMulHi then
                    Line('  umulh x0, x0, x1')
                  else
                    Line('  smulh x0, x0, x1');
                end;
            end;
          end;
        end;
    end;
    Exit;
  end;
  case E^.Kind of
    ekInt:
      Line('  movq $' + IntToStr(E^.Num) + ', %rax');
    ekReal:
      begin
        Line('  movabsq $' + IntToStr(E^.Num) + ', %rax');
        if TKind(E^.Typ) = tykQuad then
          Line('  movabsq $' + IntToStr(E^.Hi) + ', %rdx');
      end;
    ekNil:
      begin
        Line('  xorq %rax, %rax');
        Line('  xorq %rdx, %rdx');
        Line('  xorq %r8, %r8');
      end;
    ekStr:
      begin
        Line('  leaq ' + InternStr(E^.Str) + '(%rip), %rax');
        Line('  movq $' + IntToStr(Length(E^.Str)) + ', %rdx');
      end;
    ekVar:
      if IsBlob(FindSym(E^.Name).Typ) then
        EmitAddr(E)
      else
        LoadVar(E^.Name);
    ekField, ekDeref, ekIndex:
      begin
        if IsBlob(E^.Typ) then
          EmitAddr(E)
        else
        begin
