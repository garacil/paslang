  Line('  b.hs .adr_z');
  Line('  ldrb w3, [x0, x2]');
  Line('  cmp w3, #127');
  Line('  b.hi .adr_m');
  Line('  mov x0, x3');
  Line('  mov x1, #1');
  Line('  ret');
  Line('.adr_z:');
  Line('  mov x0, xzr');
  Line('  mov x1, xzr');
  Line('  ret');
  Line('.adr_bad:');
  Imm('x0', 65533);
  Line('  mov x1, #1');
  Line('  ret');
  Line('.adr_m:');
  Line('  cmp w3, #194');
  Line('  b.lo .adr_bad');
  Line('  cmp w3, #244');
  Line('  b.hi .adr_bad');
  Line('  cmp w3, #223');
  Line('  b.ls .adr_2');
  Line('  cmp w3, #239');
  Line('  b.ls .adr_3');
  Line('  b .adr_4');
  Line('.adr_2:');
  Line('  add x4, x2, #1');
  Line('  cmp x4, x1');
  Line('  b.hs .adr_bad');
  Line('  ldrb w4, [x0, x4]');
  Line('  cmp w4, #128');
  Line('  b.lo .adr_bad');
  Line('  cmp w4, #191');
  Line('  b.hi .adr_bad');
  Line('  and w3, w3, #31');
  Line('  lsl w3, w3, #6');
  Line('  and w4, w4, #63');
  Line('  orr w0, w3, w4');
  Line('  mov x1, #2');
  Line('  ret');
  Line('.adr_3:');
  Line('  add x4, x2, #2');
  Line('  cmp x4, x1');
  Line('  b.hs .adr_bad');
  Line('  add x4, x2, #1');
  Line('  ldrb w5, [x0, x4]');
  Line('  add x4, x2, #2');
  Line('  ldrb w6, [x0, x4]');
  Line('  cmp w3, #224');
  Line('  b.eq .adr_e0');
  Line('  cmp w3, #237');
  Line('  b.eq .adr_ed');
  Line('  cmp w5, #128');
  Line('  b.lo .adr_bad');
  Line('  cmp w5, #191');
  Line('  b.hi .adr_bad');
  Line('  b .adr_3b');
  Line('.adr_e0:');
  Line('  cmp w5, #160');
  Line('  b.lo .adr_bad');
  Line('  cmp w5, #191');
  Line('  b.hi .adr_bad');
  Line('  b .adr_3b');
  Line('.adr_ed:');
  Line('  cmp w5, #128');
  Line('  b.lo .adr_bad');
  Line('  cmp w5, #159');
  Line('  b.hi .adr_bad');
  Line('.adr_3b:');
  Line('  cmp w6, #128');
  Line('  b.lo .adr_bad');
  Line('  cmp w6, #191');
  Line('  b.hi .adr_bad');
  Line('  and w3, w3, #15');
  Line('  lsl w3, w3, #12');
  Line('  and w5, w5, #63');
  Line('  lsl w5, w5, #6');
  Line('  orr w3, w3, w5');
  Line('  and w6, w6, #63');
  Line('  orr w0, w3, w6');
  Line('  mov x1, #3');
  Line('  ret');
  Line('.adr_4:');
  Line('  add x4, x2, #3');
  Line('  cmp x4, x1');
  Line('  b.hs .adr_bad');
  Line('  add x4, x2, #1');
  Line('  ldrb w5, [x0, x4]');
  Line('  add x4, x2, #2');
  Line('  ldrb w6, [x0, x4]');
  Line('  add x4, x2, #3');
  Line('  ldrb w7, [x0, x4]');
  Line('  cmp w3, #240');
  Line('  b.eq .adr_f0');
  Line('  cmp w3, #244');
  Line('  b.eq .adr_f4');
  Line('  cmp w5, #128');
  Line('  b.lo .adr_bad');
  Line('  cmp w5, #191');
  Line('  b.hi .adr_bad');
  Line('  b .adr_4b');
  Line('.adr_f0:');
  Line('  cmp w5, #144');
  Line('  b.lo .adr_bad');
  Line('  cmp w5, #191');
  Line('  b.hi .adr_bad');
  Line('  b .adr_4b');
  Line('.adr_f4:');
  Line('  cmp w5, #128');
  Line('  b.lo .adr_bad');
  Line('  cmp w5, #143');
  Line('  b.hi .adr_bad');
  Line('.adr_4b:');
  Line('  cmp w6, #128');
  Line('  b.lo .adr_bad');
  Line('  cmp w6, #191');
  Line('  b.hi .adr_bad');
  Line('  cmp w7, #128');
  Line('  b.lo .adr_bad');
  Line('  cmp w7, #191');
  Line('  b.hi .adr_bad');
  Line('  and w3, w3, #7');
  Line('  lsl w3, w3, #18');
  Line('  and w5, w5, #63');
  Line('  lsl w5, w5, #12');
  Line('  orr w3, w3, w5');
  Line('  and w6, w6, #63');
  Line('  lsl w6, w6, #6');
  Line('  orr w3, w3, w6');
  Line('  and w7, w7, #63');
  Line('  orr w0, w3, w7');
  Line('  mov x1, #4');
  Line('  ret');
  { rt_write as on amd64 (P212): x0 a stream record its caller holds,
    x1 and x2 the bytes, into the buffer while they fit, or the buffer
    out first. CMP (immediate) takes 0 to 4095 and LSL #12 (Arm ARM
    C6.2.96), so 4096 is #1, lsl #12; HI is C==1 and Z==0, HS C==1
    (Table C1-1). }
  Line('rt_write:');
  Line('  cmp x2, #0');
  Line('  b.le .aow_ret');
  Line('  ldr x9, [x0, #40]');
  Line('  add x10, x9, x2');
  Line('  cmp x10, #' + IntToStr(OutBufSize shr 12) + ', lsl #12');
  Line('  b.hi .aow_full');
  Line('  str x10, [x0, #40]');
  Line('  add x0, x0, #64');
  Line('  add x0, x0, x9');
  Line('  b rt_memcpy');
  Line('.aow_full:');
  Line('  stp x30, x19, [sp, #-16]!');
  Line('  stp x20, x21, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  Line('  mov x21, x2');
  Line('  bl rt_outflush');
  Line('  cmp x21, #' + IntToStr(OutBufSize shr 12) + ', lsl #12');
  Line('  b.hs .aow_direct');
  Line('  str x21, [x19, #40]');
  Line('  add x0, x19, #64');
  Line('  mov x1, x20');
  Line('  mov x2, x21');
  Line('  bl rt_memcpy');
  Line('  b .aow_out');
  Line('.aow_direct:');
  Line('  ldr x0, [x19, #32]');
  Line('  mov x1, x20');
  Line('  mov x2, x21');
  Line('  bl rt_writefd');
  Line('.aow_out:');
  Line('  ldp x20, x21, [sp], #16');
  Line('  ldp x30, x19, [sp], #16');
  Line('.aow_ret:');
  Line('  ret');
  Line('rt_outflush:');
  Line('  ldr x2, [x0, #40]');
  Line('  cbz x2, .aof_ret');
  Line('  str xzr, [x0, #40]');
  Line('  add x1, x0, #64');
  Line('  ldr x0, [x0, #32]');
  Line('  b rt_writefd');
  Line('.aof_ret:');
  Line('  ret');
  { rt_writefd as on amd64: x0 the descriptor, x1 and x2 the bytes, all
    written through rt_syscall; EINTR again, EAGAIN waits, a failed wait
    or any other error gives up. x19 to x21 kept. }
  Line('rt_writefd:');
  Line('  stp x30, x19, [sp, #-16]!');
  Line('  stp x20, x21, [sp, #-16]!');
  Line('  mov x21, x0');
  Line('  mov x19, x1');
  Line('  mov x20, x2');
  Line('.awf:');
  Line('  cmp x20, #0');
  Line('  b.le .awf_done');
  Line('  mov x0, x21');
  Line('  mov x1, x19');
  Line('  mov x2, x20');
  Line('  mov x8, #64');
  Line('  bl rt_syscall');
  Line('  cmp x0, #0');
  Line('  b.gt .awf_more');
  Line('  cmn x0, #4');
  Line('  b.eq .awf');
  Line('  cmn x0, #11');
  Line('  b.ne .awf_done');
  Line('  mov x0, x21');
  Line('  mov x1, #4');
  Line('  bl rt_waitio');
  Line('  cbz x0, .awf');
  Line('  b .awf_done');
  Line('.awf_more:');
  Line('  add x19, x19, x0');
  Line('  sub x20, x20, x0');
  Line('  b .awf');
  Line('.awf_done:');
  Line('  ldp x20, x21, [sp], #16');
  Line('  ldp x30, x19, [sp], #16');
  Line('  ret');
  { rt_nl: x0 the stream }
  Line('rt_nl:');
  LeaS('.Lnl', 'x1');
  Line('  mov x2, #1');
  Line('  b rt_write');
  Line('rt_exit:');
  Line('  mov x8, #94');
  Line('  svc #0');
