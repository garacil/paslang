  Line('.axr_b1:');
  Line('  mov x0, #1');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.axr_q:');
  Line('  add x0, x19, #32');
  Line('  bl rt_cqtake');
  Line('  cbz x0, .axr_cl');
  Line('  ldr x9, [x0, #16]');
  Line('  str x9, [x20]');
  Line('  ldr x0, [x0, #8]');
  Line('  stlr wzr, [x19]');
  Line('  bl rt_ready');
  Line('  mov x0, #1');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.axr_cl:');
  Line('  ldr x9, [x19, #8]');
  Line('  cbz x9, .axr_no');
  Line('  str xzr, [x20]');
  Line('  stlr wzr, [x19]');
  Line('  mov x0, #1');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.axr_no:');
  Line('  stlr wzr, [x19]');
  Line('  mov x0, xzr');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  { x0 arms (32 bytes each: kind, chan, value or dest), x1 count, at most
    16. Same phases as amd64. Frame: 0 control block, 16 ordered arm
    indexes, 144 waiters. x19 arms, x20 loop index, x22 frame, x23 the
    number of channel arms, x24 the current arm entry. }
  Line('rt_select:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  stp x22, x23, [sp, #-16]!');
  Line('  stp x24, x25, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  { its frame in the caller's, x2 (P342) }
  Line('  mov x22, x2');
  Line('  mov x23, xzr');
  Line('.asx_try:');
  Line('  cmp x23, x20');
  Line('  b.hs .asx_deflt');
  Line('  lsl x9, x23, #5');
  Line('  add x9, x19, x9');
  Line('  ldr x10, [x9]');
  Line('  cmp x10, #2');
  Line('  b.eq .asx_next');
  Line('  ldr x0, [x9, #8]');
  Line('  ldr x1, [x9, #16]');
  Line('  cbnz x10, .asx_tr');
  Line('  bl rt_trysend');
  Line('  b .asx_chk');
  Line('.asx_tr:');
  Line('  bl rt_tryrecv');
  Line('.asx_chk:');
  Line('  cbnz x0, .asx_hit');
  Line('.asx_next:');
  Line('  add x23, x23, #1');
  Line('  b .asx_try');
  Line('.asx_deflt:');
  Line('  mov x23, xzr');
  Line('.asx_df:');
  Line('  cmp x23, x20');
  Line('  b.hs .asx_order');
  Line('  lsl x9, x23, #5');
  Line('  add x9, x19, x9');
  Line('  ldr x10, [x9]');
  Line('  cmp x10, #2');
  Line('  b.eq .asx_hit');
  Line('  add x23, x23, #1');
  Line('  b .asx_df');
  Line('.asx_hit:');
  Line('  mov x0, x23');
  Line('.asx_ret:');
  Line('  ldp x24, x25, [sp], #16');
  Line('  ldp x22, x23, [sp], #16');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.asx_order:');
  Line('  mov x23, xzr');
  Line('  mov x24, xzr');
  Line('.asx_o1:');
  Line('  cmp x24, x20');
  Line('  b.hs .asx_od');
  Line('  lsl x9, x24, #5');
  Line('  add x9, x19, x9');
  Line('  ldr x10, [x9]');
  Line('  cmp x10, #2');
  Line('  b.eq .asx_o2');
  Line('  ldr x11, [x9, #8]');
  Line('  mov x12, x23');
  Line('.asx_o3:');
  Line('  cbz x12, .asx_o4');
  Line('  sub x13, x12, #1');
  Line('  add x14, x22, x13, lsl #3');
  Line('  ldr x15, [x14, #16]');
  Line('  lsl x16, x15, #5');
  Line('  add x16, x19, x16');
  Line('  ldr x16, [x16, #8]');
  Line('  cmp x16, x11');
  Line('  b.ls .asx_o4');
  Line('  add x14, x22, x12, lsl #3');
  Line('  str x15, [x14, #16]');
  Line('  mov x12, x13');
  Line('  b .asx_o3');
  Line('.asx_o4:');
  Line('  add x14, x22, x12, lsl #3');
  Line('  str x24, [x14, #16]');
  Line('  add x23, x23, #1');
  Line('.asx_o2:');
  Line('  add x24, x24, #1');
  Line('  b .asx_o1');
  Line('.asx_od:');
  Line('  cbz x23, .asx_forever');
  Line('.asx_again:');
  Line('  bl .asx_lockall');
  Line('  mov x20, xzr');
  Line('.asx_p1:');
  Line('  cmp x20, x23');
  Line('  b.hs .asx_enq');
  Line('  add x9, x22, x20, lsl #3');
  Line('  ldr x9, [x9, #16]');
  Line('  lsl x9, x9, #5');
  Line('  add x24, x19, x9');
  Line('  ldr x0, [x24, #8]');
  Line('  ldr x9, [x24]');
  Line('  cbnz x9, .asx_pr');
  Line('  ldr x9, [x0, #8]');
  Line('  cbnz x9, .asx_die');
  Line('  add x0, x0, #16');
  Line('  bl rt_cqtake');
  Line('  cbz x0, .asx_pb');
  Line('  ldr x9, [x24, #16]');
  Line('  str x9, [x0, #16]');
  Line('  ldr x9, [x0, #8]');
  Line('  str x9, [x22]');
  Line('  b .asx_won');
  Line('.asx_pb:');
  Line('  ldr x0, [x24, #8]');
  Line('  ldr x1, [x24, #16]');
  Line('  bl rt_chbput');
  Line('  cbz x0, .asx_pn');
  Line('  str xzr, [x22]');
  Line('  b .asx_won');
  Line('.asx_pr:');
  Line('  bl rt_chbget');
  Line('  cbz x1, .asx_prq');
  Line('  ldr x10, [x24, #16]');
  Line('  str x0, [x10]');
  Line('  str x2, [x22]');
  Line('  b .asx_won');
  Line('.asx_prq:');
  Line('  ldr x0, [x24, #8]');
  Line('  add x0, x0, #32');
  Line('  bl rt_cqtake');
  Line('  cbz x0, .asx_pc');
  Line('  ldr x9, [x0, #16]');
  Line('  ldr x10, [x24, #16]');
  Line('  str x9, [x10]');
  Line('  ldr x9, [x0, #8]');
  Line('  str x9, [x22]');
  Line('  b .asx_won');
  Line('.asx_pc:');
  Line('  ldr x0, [x24, #8]');
  Line('  ldr x9, [x0, #8]');
  Line('  cbz x9, .asx_pn');
  Line('  ldr x10, [x24, #16]');
  Line('  str xzr, [x10]');
  Line('  str xzr, [x22]');
  Line('  b .asx_won');
  Line('.asx_pn:');
  Line('  add x20, x20, #1');
  Line('  b .asx_p1');
  Line('.asx_won:');
  Line('  bl .asx_unlockall');
  Line('  ldr x0, [x22]');
  Line('  cbz x0, .asx_wn');
  Line('  bl rt_ready');
  Line('.asx_wn:');
  Line('  add x9, x22, x20, lsl #3');
  Line('  ldr x0, [x9, #16]');
  Line('  b .asx_ret');
  Line('.asx_enq:');
  Line('  str xzr, [x22]');
  Line('  str xzr, [x22, #8]');
  Line('  mov w9, #1');
  Line('  str w9, [x28, #152]');
  Line('  mov x20, xzr');
  Line('.asx_e1:');
  Line('  cmp x20, x23');
  Line('  b.hs .asx_park');
  Line('  mov x9, #48');
  Line('  mul x9, x20, x9');
  Line('  add x1, x22, x9');
  Line('  add x1, x1, #144');
  Line('  str x28, [x1, #8]');
  Line('  str x22, [x1, #24]');
  Line('  add x9, x22, x20, lsl #3');
  Line('  ldr x9, [x9, #16]');
  Line('  str x9, [x1, #32]');
  Line('  lsl x9, x9, #5');
  Line('  add x24, x19, x9');
  Line('  ldr x9, [x24, #16]');
  Line('  str x9, [x1, #16]');
  Line('  ldr x0, [x24, #8]');
  Line('  ldr x9, [x24]');
  Line('  cbnz x9, .asx_er');
  Line('  add x0, x0, #32');
  Line('  b .asx_eq');
  Line('.asx_er:');
  Line('  add x0, x0, #16');
  Line('.asx_eq:');
  Line('  bl rt_cqenq');
  Line('  add x20, x20, #1');
  Line('  b .asx_e1');
  Line('.asx_park:');
  Line('  bl .asx_unlockall');
  Line('  bl rt_parkmarked');
  Line('  bl .asx_lockall');
  Line('  mov x20, xzr');
  Line('.asx_r1:');
  Line('  cmp x20, x23');
  Line('  b.hs .asx_rd');
  Line('  mov x9, #48');
  Line('  mul x9, x20, x9');
  Line('  add x1, x22, x9');
  Line('  add x1, x1, #144');
  Line('  ldr x9, [x1, #32]');
  Line('  lsl x9, x9, #5');
  Line('  add x24, x19, x9');
  Line('  ldr x0, [x24, #8]');
  Line('  ldr x9, [x24]');
  Line('  cbnz x9, .asx_rr');
  Line('  add x0, x0, #32');
  Line('  b .asx_rq');
  Line('.asx_rr:');
  Line('  add x0, x0, #16');
  Line('.asx_rq:');
  Line('  bl rt_cqremove');
  Line('  add x20, x20, #1');
  Line('  b .asx_r1');
  Line('.asx_rd:');
  Line('  bl .asx_unlockall');
  Line('  ldr x9, [x22]');
  Line('  cbz x9, .asx_again');
  Line('  ldr x1, [x22, #8]');
  Line('  ldr x0, [x1, #32]');
  Line('  lsl x9, x0, #5');
  Line('  add x9, x19, x9');
  Line('  ldr x10, [x9]');
  Line('  cmp x10, #1');
  Line('  b.ne .asx_ret');
  Line('  ldr x10, [x9, #16]');
  Line('  ldr x11, [x1, #16]');
  Line('  str x11, [x10]');
  Line('  b .asx_ret');
  Line('.asx_die:');
  Line('  mov x0, xzr');
  Line('  b rt_diesendclosed');
  Line('.asx_forever:');
  Line('  bl rt_park');
  Line('  b .asx_forever');
  Line('.asx_lockall:');
  Line('  mov x9, xzr');
  Line('  mov x10, xzr');
  Line('.asx_l1:');
  Line('  cmp x9, x23');
  Line('  b.hs .asx_l2');
  Line('  add x11, x22, x9, lsl #3');
  Line('  ldr x11, [x11, #16]');
  Line('  lsl x11, x11, #5');
  Line('  add x11, x19, x11');
  Line('  ldr x11, [x11, #8]');
  Line('  cmp x11, x10');
  Line('  b.eq .asx_l3');
  Line('  mov x10, x11');
  Line('.asx_l4:');
  Line('  ldaxr w12, [x11]');
  Line('  cbnz w12, .asx_l4');
  Line('  mov w13, #1');
  Line('  stxr w12, w13, [x11]');
  Line('  cbnz w12, .asx_l4');
  Line('.asx_l3:');
  Line('  add x9, x9, #1');
  Line('  b .asx_l1');
  Line('.asx_l2:');
  Line('  ret');
  Line('.asx_unlockall:');
  Line('  mov x9, xzr');
  Line('  mov x10, xzr');
  Line('.asx_u1:');
  Line('  cmp x9, x23');
  Line('  b.hs .asx_u2');
  Line('  add x11, x22, x9, lsl #3');
  Line('  ldr x11, [x11, #16]');
  Line('  lsl x11, x11, #5');
  Line('  add x11, x19, x11');
  Line('  ldr x11, [x11, #8]');
  Line('  cmp x11, x10');
  Line('  b.eq .asx_u3');
  Line('  mov x10, x11');
  Line('  stlr wzr, [x11]');
  Line('.asx_u3:');
  Line('  add x9, x9, #1');
  Line('  b .asx_u1');
  Line('.asx_u2:');
  Line('  ret');
  { x0 fd, x1 events. Mark the G waiting before epoll_ctl.
    arm64 epoll_event is 16 bytes, data at 8. Save x30: park resumes with br. }
  { The poller's token, as on amd64 (1.0.57): the record in the low 48
    bits, a number of 16 bits in the top ones, G+192 that number + 1 while
    the routine waits. rt_pollarm: the token in x0; x9, x10 clobbered. }
  Line('rt_pollarm:');
  Line('  ldr w9, [x28, #200]');
  Line('  add w9, w9, #1');
  Line('  and w9, w9, #65535');
  Line('  str w9, [x28, #200]');
  Line('  add x10, x9, #1');
  Line('  str x10, [x28, #192]');
  Line('  dmb ish');
  Line('  lsl x0, x9, #48');
  Line('  orr x0, x0, x28');
  Line('  ret');
  { rt_pollwake: x0 a token from an event; its routine is readied only
    while that wait is still armed. }
  Line('rt_pollwake:');
  Line('  lsr x9, x0, #48');
  Line('  add x9, x9, #1');
  Line('  ubfx x0, x0, #0, #48');
  Line('  add x10, x0, #192');
  Line('.apw_cas:');
  Line('  ldaxr x11, [x10]');
  Line('  cmp x11, x9');
  Line('  b.ne .apw_out');
  Line('  stlxr w12, xzr, [x10]');
  Line('  cbnz w12, .apw_cas');
  Line('  b rt_ready');
  Line('.apw_out:');
  Line('  clrex');
  Line('  ret');
  { x0 fd, x1 events; rt_waitio2 also x2, a deadline in nanoseconds on
    the runtime's timers with the same token (rt_waitms), or -1.
    One-shot registrations. }
  Line('rt_waitio:');
  Line('  mov x2, #-1');
  Line('rt_waitio2:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  stp x21, x22, [sp, #-16]!');
  Line('  stp x23, x24, [sp, #-16]!');
  Line('  stp x25, x26, [sp, #-16]!');
  Line('  stp x27, xzr, [sp, #-16]!');
  Line('  sub sp, sp, #16'); { result survives actual park/migration }
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  Line('  mov x23, x2');
  Line('  mov w9, #1');
  Line('  str w9, [x28, #152]');
  Line('  adr x9, .awi_resume');
  Line('  str x9, [x28, #48]');
  Line('  mov x9, sp');
  Line('  str x9, [x28, #40]');
  Line('  str x29, [x28, #56]');
  Line('  bl rt_pollarm');
  Line('  mov x24, x0');
  Line('  sub sp, sp, #16');
  Line('  str xzr, [sp]');
  Line('  str xzr, [sp, #8]');
  Line('  cmp x23, #0');
  Line('  b.lt .awi_one');
  Line('  str x23, [x28, #208]');
  Line('  str x24, [x28, #264]');
  { on this M's P's timers, as a Sleep (P352) }
  Line('  ldr x9, [x28, #32]');
  Line('  ldr x1, [x9, #8]');
  Line('  bl rt_tadd');
  Line('.awi_one:');
  { MOD first (P115, 1.1.1): after its first wait a descriptor stays
    in the set, one-shot and disarmed, so ADD failed with EEXIST on
    every later wait and MOD followed: two system calls a wait. MOD
    re-arms it in one; ADD only when it is not in the set yet. }
  Line('  orr w9, w20, #0x40000000');
  Line('  str w9, [sp]');
  Line('  str x24, [sp, #8]');
  LdS('rt_epfd', 'x0');
  Line('  mov x1, #3');
  Line('  mov x2, x19');
  Line('  mov x3, sp');
  Line('  mov x8, #21');
  Line('  svc #0');
  Line('  cmp x0, #0');
  Line('  b.ge .awi_success');
  LdS('rt_epfd', 'x0');
  Line('  mov x1, #1');
  Line('  mov x2, x19');
  Line('  mov x3, sp');
  Line('  mov x8, #21');
  Line('  svc #0');
  { P180: failed epoll registration takes its own token through the
    normal wake protocol, including any racing deadline. }
  Line('  cmp x0, #0');
  Line('  b.ge .awi_success');
  Line('  str x0, [sp, #16]');
  Line('  mov x0, x24');
  Line('  bl rt_pollwake');
  Line('  b .awi_cas');
  Line('.awi_success:');
  Line('  str xzr, [sp, #16]');
  Line('.awi_cas:');
  Line('  add sp, sp, #16');
  Line('  bl rt_pollwaitinc');
