  Line('');
  { rdi: arms, 32 bytes each (0 kind: 0 send, 1 recv, 2 default; 8 chan;
    16 value or dest). rsi: count, at most 16. rax: the arm that fired.
    Phase 1 tries every arm with the try operations. Phase 2 takes a
    default arm. Otherwise the channel arms are ordered by address, every
    channel is locked, each arm is polled again under the locks (a value
    that arrived after phase 1 is seen here, not lost), and if none is
    ready one waiter per arm is queued before the locks drop and the G
    parks. On wake the locks are taken again, every waiter is removed,
    and the control block names the winner. rdx: its frame, in the
    caller's (P342), as Go's selectgo takes its arrays from its caller's
    (cmd/compile/internal/walk/select.go): 0 control block (16), 16 the
    ordered arm indexes (16 x 8), 144 the waiters (48 an arm). }
  Line('rt_select:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  movq %rdi, %rbx');
  Line('  movq %rsi, %r12');
  Line('  movq %rdx, %r13');
  Line('  xorq %r15, %r15');
  Line('.sx_try:');
  Line('  cmpq %r12, %r15');
  Line('  jae .sx_deflt');
  Line('  movq %r15, %rax');
  Line('  shlq $5, %rax');
  Line('  addq %rbx, %rax');
  Line('  movq (%rax), %rcx');
  Line('  cmpq $2, %rcx');
  Line('  je .sx_next');
  Line('  movq 8(%rax), %rdi');
  Line('  movq 16(%rax), %rsi');
  Line('  testq %rcx, %rcx');
  Line('  jnz .sx_tr');
  Line('  call rt_trysend');
  Line('  jmp .sx_chk');
  Line('.sx_tr:');
  Line('  call rt_tryrecv');
  Line('.sx_chk:');
  Line('  testq %rax, %rax');
  Line('  jnz .sx_hit');
  Line('.sx_next:');
  Line('  incq %r15');
  Line('  jmp .sx_try');
  Line('.sx_deflt:');
  Line('  xorq %r15, %r15');
  Line('.sx_df:');
  Line('  cmpq %r12, %r15');
  Line('  jae .sx_order');
  Line('  movq %r15, %rax');
  Line('  shlq $5, %rax');
  Line('  addq %rbx, %rax');
  Line('  cmpq $2, (%rax)');
  Line('  je .sx_hit');
  Line('  incq %r15');
  Line('  jmp .sx_df');
  Line('.sx_hit:');
  Line('  movq %r15, %rax');
  Line('.sx_ret:');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('.sx_order:');
  Line('  xorq %r15, %r15');
  Line('  xorq %r8, %r8');
  Line('.sx_o1:');
