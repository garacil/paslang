  Line('  bl rt_rawwrite');
  Line('  mov x0, #1');
  Line('  b rt_exit');
  Line('rt_dieoomstk:');
  LeaS('.Loomstk', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgOomStack)));
  Line('  bl rt_rawwrite');
  LdS('rt_stacktot', 'x0');
  Line('  lsr x0, x0, #20');
  Line('  mov x1, #10');
  Line('  bl rt_fatalnum');
  LeaS('.Lmib', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgMib)));
  Line('  bl rt_rawwrite');
  Line('  b rt_dieend');
  Line('rt_dieoom:');
  LeaS('.Loom', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgOom)));
  Line('  bl rt_rawwrite');
  LdS('rt_maptot', 'x0');
  Line('  lsr x0, x0, #20');
  Line('  mov x1, #10');
  Line('  bl rt_fatalnum');
  LeaS('.Lmib', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgMib)));
  Line('  bl rt_rawwrite');
  Line('  b rt_dieend');
  Line('rt_die:');
  Line('  mov x0, xzr');
  LeaS('.Lfatal', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgFatal)));
  Line('  b rt_diemsg');
  Line('rt_diemmap:');
  Line('  mov x0, xzr');
  LeaS('.Lmmapfail', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgMmap)));
  Line('  b rt_diemsg');
  Line('rt_dietoobig:');
  Line('  mov x0, xzr');
  LeaS('.Ltoobig', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgTooBig)));
  Line('  b rt_diemsg');
  Line('rt_dieepoll:');
  Line('  mov x0, xzr');
  LeaS('.Lepollfail', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgEpoll)));
  Line('  b rt_diemsg');
  Line('rt_diestack:');
  LeaS('.Lstackovf', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgStack)));
  Line('  b rt_diemsg');
  Line('rt_diesendclosed:');
  LeaS('.Lsendclosed', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgSendClosed)));
  Line('  b rt_diemsg');
  Line('rt_diecloseclosed:');
  LeaS('.Lcloseclosed', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgCloseClosed)));
  Line('  b rt_diemsg');
  Line('rt_diemaprw:');
  LeaS('.Lmaprw', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgMapRW)));
  Line('  b rt_diemsg');
  Line('rt_dieclosesender:');
  LeaS('.Lclosesender', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgCloseSender)));
  Line('  b rt_diemsg');
  Line('rt_diedeadlock:');
  Line('  mov x0, xzr');
  LeaS('.Ldeadlock', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgDeadlock)));
  Line('  b rt_diemsg');
  Line('rt_divzero:');
  Line('  sub x0, x30, #1');
  LeaS('.Ldivzero', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgDivZero)));
  Line('  b rt_diemsg');
  { rt_divover and rt_divmod128 as on amd64 (1.0.121): arm64 has no
    128-by-64 division, so 64 shifts and subtractions, the quotient
    coming in at the low end of the dividend. }
  Line('rt_divover:');
  Line('  sub x0, x30, #1');
  LeaS('.Ldivover', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgDivOver)));
  Line('  b rt_diemsg');
  Line('rt_divmod128:');
  Line('  cbnz x2, .adm_nz');
  Line('  b rt_divzero');
  Line('.adm_nz:');
  Line('  cmp x0, x2');
  Line('  b.lo .adm_ok');
  Line('  b rt_divover');
  Line('.adm_ok:');
  Line('  mov x9, #64');
  Line('.adm_l:');
  Line('  lsr x10, x0, #63');
  Line('  extr x0, x0, x1, #63');
  Line('  lsl x1, x1, #1');
  Line('  cmp x0, x2');
  Line('  cset x11, hs');
  Line('  orr x11, x11, x10');
  Line('  cbz x11, .adm_s');
  Line('  sub x0, x0, x2');
  Line('  orr x1, x1, #1');
  Line('.adm_s:');
  Line('  subs x9, x9, #1');
  Line('  b.ne .adm_l');
  Line('  str x1, [x3]');
  Line('  str x0, [x4]');
  Line('  ret');
  { rt_boundsfail and rt_fatalint as on amd64 (P87): x0 the index, x1
    and x2 the bounds, x30 the line; x19 to x23 hold what the writes
    clobber. }
  Line('rt_bitfail:');
  LeaS('.Lbbit', 'x9');
  Line('  mov x10, #' + IntToStr(Length(MsgBit)));
  Line('  b .abf_go');
  Line('rt_boundsfail:');
  LeaS('.Lbidx', 'x9');
  Line('  mov x10, #' + IntToStr(Length(MsgIndex)));
  Line('.abf_go:');
  Line('  sub x22, x30, #1');
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  Line('  mov x21, x2');
  Line('  mov x1, x9');
  Line('  mov x2, x10');
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  bl rt_fatalint');
  LeaS('.Lbrange', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgOutOfRange)));
