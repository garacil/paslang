  Line('  cmpq $0, rt_heapstate+200(%rip)');
  Line('  je .ml_go2');
  Line('  pushq %rax');
  Line('  call rt_gcstopm');
  Line('  popq %rax');
  Line('.ml_go2:');
  Line('  movq %rax, %rdi');
