  Line('rt_yield:');
  Line('  popq %rax');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  pushq %rax');
  Line('  leaq .pk_res(%rip), %rax');
  Line('  movq %rax, 48(%r14)');
  Line('  movq %rsp, 40(%r14)');
  Line('  movq %rbp, 56(%r14)');
  Line('  movq 32(%r14), %r13');
  Line('  movq 32(%r13), %rsp');
  Line('  xorq %rbp, %rbp');
  { r14 no longer names the queued routine (see .ms_preempt). }
  Line('  movq %r14, %rdi');
  Line('  xorq %r14, %r14');
  Line('  call rt_globput');
  Line('  jmp rt_yieldwake');
  { rt_yieldwake: a routine that yielded or was preempted is on the
    global queue and this M (r13, on its system stack) schedules. Another
    M is woken, or started, only when this one has other work to run
    first (the global queue held more, or its P a runnext or a local
    queue): alone, the routine is taken back at once by this M, and a
    second M woke for nothing. Since P91 that nothing was a new thread
    every 10 ms a routine ran without parking (lazym under qemu). }
  Line('rt_yieldwake:');
  Line('  cmpq $1, rt_gqn(%rip)');
  Line('  ja .yw_wake');
  Line('  movq 8(%r13), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .yw_wake');
  Line('  cmpq $0, 24(%rax)');
  Line('  jne .yw_wake');
  Line('  movl 16(%rax), %ecx');
  Line('  cmpl 20(%rax), %ecx');
  Line('  je rt_mloop');
  Line('.yw_wake:');
  Line('  call rt_wakep');
  Line('  jmp rt_mloop');
  { Goyield, Go's goyield (P98): the current routine goes to the tail of
    its P's local queue, not the global one, and the M schedules; a
    routine just readied into runnext runs next, on this M. The mutex
    hands itself over this way in starvation mode, as Go's semrelease
    does, so the chain of owners runs at the cost of a routine switch.
    An M without a P uses the global queue. }
  Line('rt_goyield:');
  Line('  popq %rax');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  pushq %rax');
  Line('  leaq .pk_res(%rip), %rax');
  Line('  movq %rax, 48(%r14)');
  Line('  movq %rsp, 40(%r14)');
  Line('  movq %rbp, 56(%r14)');
  Line('  movq 32(%r14), %r13');
  Line('  movq 32(%r13), %rsp');
  Line('  xorq %rbp, %rbp');
  Line('  movq %r14, %rsi');
  Line('  xorq %r14, %r14');
