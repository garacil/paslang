  Line('  mov x0, #1');
  Line('.nc_clip:');
  Line('  cmp x0, #2');
  Line('  b.hs .nc_max');
  Line('  mov x0, #2');
  Line('.nc_max:');
  Line('  cmp x0, #32');
  Line('  b.ls .nc_done');
  Line('  mov x0, #32');
