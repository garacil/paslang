  Line('  bl rt_unlock');
  Line('  mov x0, xzr');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('rt_runqget:');
  Line('  mov x2, x0');
  Line('  add x9, x2, #24');
  Line('.qg_x:');
  Line('  ldaxr x0, [x9]');
  Line('  stlxr w10, xzr, [x9]');
  Line('  cbnz w10, .qg_x');
