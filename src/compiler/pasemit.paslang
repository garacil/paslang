  Line('  movq 32(%r13), %rsp');
  Line('  xorq %rbp, %rbp');
  Line('  jmp rt_mloop');
  Line('.wi_run:');
  Line('  movl $0, 152(%r14)');
  Line('.wi_resume:');
  Line('  movq $0, 192(%r14)');
