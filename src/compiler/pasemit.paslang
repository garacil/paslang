  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('');
  Line('.globl rt_strcmp');
  Line('rt_strcmp:');
  Line('  movq %rcx, %r10');
  Line('  cmpq %rdi, %rdx');
  Line('  je .sm_same');
  Line('  movq %r10, %r8');
  Line('  cmpq %r10, %rsi');
  Line('  cmovlq %rsi, %r8');
  Line('  cmpq $8, %r8');
  Line('  jb .sm_small');
  Line('  cmpq $63, %r8');
  Line('  jbe .sm_loop');
  Line('  leaq 262144(%rdi), %r9');
  Line('  jmp .sm_bigloop');
  Line('.sm_loop:');
  Line('  cmpq $16, %r8');
  Line('  jbe .sm_0to16');
  Line('  movdqu (%rdi), %xmm0');
  Line('  movdqu (%rdx), %xmm1');
  Line('  pcmpeqb %xmm0, %xmm1');
  Line('  pmovmskb %xmm1, %eax');
  Line('  xorq $0xffff, %rax');
  Line('  jne .sm_diff16');
  Line('  addq $16, %rdi');
  Line('  addq $16, %rdx');
  Line('  subq $16, %r8');
  Line('  jmp .sm_loop');
  Line('.sm_diff64:');
  Line('  addq $48, %rdi');
  Line('  addq $48, %rdx');
  Line('  jmp .sm_diff16');
  Line('.sm_diff48:');
  Line('  addq $32, %rdi');
  Line('  addq $32, %rdx');
  Line('  jmp .sm_diff16');
  Line('.sm_diff32:');
  Line('  addq $16, %rdi');
  Line('  addq $16, %rdx');
  Line('.sm_diff16:');
  Line('  ' + Bsf('q') + ' %rax, %r9');
  Line('  xorq %rax, %rax');
  Line('  movb (%rdi,%r9), %cl');
  Line('  cmpb (%rdx,%r9), %cl');
  Line('  seta %al');
  Line('  leaq -1(%rax,%rax), %rax');
  Line('  ret');
  Line('.sm_0to16:');
  Line('  cmpq $8, %r8');
  Line('  jbe .sm_0to8');
  Line('  movq (%rdi), %rax');
  Line('  movq (%rdx), %rcx');
  Line('  cmpq %rcx, %rax');
  Line('  jne .sm_diff8');
  Line('.sm_0to8:');
  Line('  movq -8(%rdi,%r8), %rax');
  Line('  movq -8(%rdx,%r8), %rcx');
  Line('  cmpq %rcx, %rax');
  Line('  je .sm_same');
  Line('.sm_diff8:');
  Line('  bswapq %rax');
  Line('  bswapq %rcx');
  Line('  xorq %rax, %rcx');
  BsrQ('rcx', 'rcx');
  Line('  shrq %cl, %rax');
  Line('  andq $1, %rax');
  Line('  leaq -1(%rax,%rax), %rax');
  Line('  ret');
  Line('.sm_small:');
  Line('  leaq 0(,%r8,8), %rcx');
  Line('  negq %rcx');
  Line('  je .sm_same');
  Line('  cmpb $0xf8, %dil');
  Line('  ja .sm_ahi');
  Line('  movq (%rdi), %rdi');
  Line('  jmp .sm_afin');
  Line('.sm_ahi:');
  Line('  movq -8(%rdi,%r8), %rdi');
  Line('  shrq %cl, %rdi');
  Line('.sm_afin:');
  Line('  shlq %cl, %rdi');
  Line('  cmpb $0xf8, %dl');
  Line('  ja .sm_bhi');
  Line('  movq (%rdx), %rdx');
  Line('  jmp .sm_bfin');
  Line('.sm_bhi:');
  Line('  movq -8(%rdx,%r8), %rdx');
  Line('  shrq %cl, %rdx');
  Line('.sm_bfin:');
  Line('  shlq %cl, %rdx');
  Line('  bswapq %rdi');
  Line('  bswapq %rdx');
  Line('  xorq %rdi, %rdx');
  Line('  je .sm_same');
  BsrQ('rdx', 'rcx');
  Line('  shrq %cl, %rdi');
  Line('  andq $1, %rdi');
  Line('  leaq -1(%rdi,%rdi), %rax');
  Line('  ret');
  Line('.sm_same:');
  Line('  xorq %rax, %rax');
  Line('  xorq %rcx, %rcx');
  Line('  cmpq %r10, %rsi');
  Line('  setg %al');
  Line('  sete %cl');
  Line('  leaq -1(%rcx,%rax,2), %rax');
  Line('  ret');
  if HasFeat(CpuFeatBit('avx2', False)) then
  begin
    Line('.sm_bigloop:');
    Line('  vmovdqu (%rdi), %ymm2');
    Line('  vmovdqu (%rdx), %ymm3');
    Line('  vmovdqu 32(%rdi), %ymm4');
    Line('  vmovdqu 32(%rdx), %ymm5');
    Line('  vpcmpeqb %ymm2, %ymm3, %ymm0');
    Line('  vpmovmskb %ymm0, %eax');
    Line('  xorl $0xffffffff, %eax');
    Line('  jne .sm_d32v');
    Line('  vpcmpeqb %ymm4, %ymm5, %ymm6');
    Line('  vpmovmskb %ymm6, %eax');
    Line('  xorl $0xffffffff, %eax');
    Line('  jne .sm_d64v');
    Line('  addq $64, %rdi');
    Line('  addq $64, %rdx');
    Line('  subq $64, %r8');
    Line('  cmpq $64, %r8');
    Line('  jb .sm_bigexit');
    Line('  cmpq %r9, %rdi');
    Line('  jb .sm_bigloop');
    Line('  addq $262144, %r9');
    YieldCheckX86('.sm_by');
    Line('  jmp .sm_bigloop');
    Line('.sm_d32v:');
    Line('  vzeroupper');
    Line('  jmp .sm_diff16');
    Line('.sm_d64v:');
    Line('  vzeroupper');
    Line('  jmp .sm_diff48');
    Line('.sm_bigexit:');
    Line('  vzeroupper');
    Line('  jmp .sm_loop');
  end
  else
  begin
    Line('.sm_bigloop:');
    Line('  movdqu (%rdi), %xmm0');
    Line('  movdqu (%rdx), %xmm1');
    Line('  pcmpeqb %xmm0, %xmm1');
    Line('  pmovmskb %xmm1, %eax');
    Line('  xorq $0xffff, %rax');
    Line('  jne .sm_diff16');
    Line('  movdqu 16(%rdi), %xmm0');
    Line('  movdqu 16(%rdx), %xmm1');
    Line('  pcmpeqb %xmm0, %xmm1');
    Line('  pmovmskb %xmm1, %eax');
    Line('  xorq $0xffff, %rax');
    Line('  jne .sm_diff32');
    Line('  movdqu 32(%rdi), %xmm0');
    Line('  movdqu 32(%rdx), %xmm1');
    Line('  pcmpeqb %xmm0, %xmm1');
    Line('  pmovmskb %xmm1, %eax');
    Line('  xorq $0xffff, %rax');
    Line('  jne .sm_diff48');
    Line('  movdqu 48(%rdi), %xmm0');
    Line('  movdqu 48(%rdx), %xmm1');
    Line('  pcmpeqb %xmm0, %xmm1');
    Line('  pmovmskb %xmm1, %eax');
    Line('  xorq $0xffff, %rax');
    Line('  jne .sm_diff64');
    Line('  addq $64, %rdi');
    Line('  addq $64, %rdx');
    Line('  subq $64, %r8');
    Line('  cmpq $64, %r8');
    Line('  jbe .sm_loop');
    Line('  cmpq %r9, %rdi');
    Line('  jb .sm_bigloop');
    Line('  addq $262144, %r9');
    YieldCheckX86('.sm_by');
    Line('  jmp .sm_bigloop');
  end;
  Line('');
  Line('.globl rt_strcopy');
  Line('rt_strcopy:');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %rbx');
  Line('  movq %rdi, %r12');
  Line('  movq %rdx, %r13');
  Line('  movq %rcx, %rbx');
  Line('  testq %rbx, %rbx');
  Line('  jns .sc_n');
  Line('  xorq %rbx, %rbx');
  Line('.sc_n:');
  Line('  cmpq $1, %rsi');
  Line('  jge .sc_i');
  Line('  movq $1, %rsi');
  Line('.sc_i:');
  Line('  decq %rsi');
  Line('  addq %rsi, %r12');
  Line('  movq %r13, %rax');
  Line('  subq %rsi, %rax');
  Line('  cmpq %rax, %rbx');
  Line('  jle .sc_ok');
  Line('  movq %rax, %rbx');
  Line('.sc_ok:');
  Line('  testq %rbx, %rbx');
  Line('  jns .sc_n2');
  Line('  xorq %rbx, %rbx');
  Line('.sc_n2:');
  { one character: its entry of rt_onechar (P286) }
  Line('  cmpq $1, %rbx');
  Line('  jne .sc_alloc');
  Line('  movzbl (%r12), %eax');
  Line('  leaq rt_onechar+1(%rip), %rdx');
  Line('  leaq (%rdx,%rax,2), %rax');
  Line('  movl $1, %edx');
  Line('  popq %rbx');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  ret');
  Line('.sc_alloc:');
  Line('  movq %rbx, %rdi');
  Line('  call rt_stralloc');
  Line('  movq %rax, %rdi');
  Line('  movq %r12, %rsi');
  Line('  movq %rbx, %rcx');
  Line('  pushq %rax');
  Line('  call rt_memcpy');
  Line('  popq %rax');
  Line('  movq %rbx, %rdx');
  Line('  popq %rbx');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  ret');
  Line('');
  Line('.globl rt_paramcount');
  Line('rt_paramcount:');
  Line('  movq rt_argc(%rip), %rax');
  Line('  decq %rax');
  Line('  ret');
  Line('');
  Line('.globl rt_paramstr');
  { A copy with a header: argv's bytes are not a string's (1.0.82). }
  Line('rt_paramstr:');
  { an index past the arguments, or negative, gives the empty string
    (1.0.136: it read past argv and crashed with no line) }
  Line('  xorq %rdx, %rdx');
  Line('  cmpq rt_argc(%rip), %rdi');
  Line('  jae .ps_done');
  Line('  movq rt_argv(%rip), %rsi');
  Line('  movq (%rsi, %rdi, 8), %rsi');
  Line('.ps_len:');
  Line('  cmpb $0, (%rsi, %rdx)');
  Line('  je .ps_done');
  Line('  incq %rdx');
  Line('  jmp .ps_len');
  Line('.ps_done:');
  Line('  pushq %rsi');
  Line('  pushq %rdx');
  Line('  movq %rdx, %rdi');
  Line('  call rt_stralloc');
  Line('  popq %rcx');
  Line('  popq %rsi');
  Line('  pushq %rax');
  Line('  pushq %rcx');
  Line('  movq %rax, %rdi');
  Line('  call rt_memcpy');
  Line('  popq %rdx');
  Line('  popq %rax');
  Line('  ret');
  Line('');
  Line('rt_propfind:');
  Line('  testq %rdi, %rdi');
  Line('  jz .pf_no');
  Line('  movq (%rdi), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .pf_no');
  Line('  movq -8(%rax), %rax');
  Line('.pf_lp:');
  Line('  movq (%rax), %rcx');
  Line('  testq %rcx, %rcx');
  Line('  jz .pf_no');
  Line('  movq 8(%rax), %r8');
  Line('  cmpq %rdx, %r8');
  Line('  jne .pf_nx');
  Line('  xorq %r9, %r9');
  Line('.pf_c:');
  Line('  cmpq %r8, %r9');
  Line('  jae .pf_ok');
  Line('  movzbq (%rcx,%r9), %r10');
  Line('  movzbq (%rsi,%r9), %r11');
  Line('  cmpb $65, %r10b');
  Line('  jb .pf_a');
  Line('  cmpb $90, %r10b');
  Line('  ja .pf_a');
  Line('  addb $32, %r10b');
  Line('.pf_a:');
  Line('  cmpb $65, %r11b');
  Line('  jb .pf_b');
  Line('  cmpb $90, %r11b');
  Line('  ja .pf_b');
  Line('  addb $32, %r11b');
  Line('.pf_b:');
  Line('  cmpb %r10b, %r11b');
  Line('  jne .pf_nx');
  Line('  incq %r9');
  Line('  jmp .pf_c');
  Line('.pf_ok:');
  Line('  ret');
  Line('.pf_nx:');
  Line('  addq $32, %rax');
  Line('  jmp .pf_lp');
  Line('.pf_no:');
  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('rt_propkind:');
  Line('  call rt_propfind');
  Line('  testq %rax, %rax');
  Line('  jz .pk_z');
  Line('  movzbq 16(%rax), %rax');
  Line('  ret');
  Line('.pk_z:');
  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('rt_getpropint:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  call rt_propfind');
  Line('  testq %rax, %rax');
  Line('  jz .gi_z');
  Line('  movq 16(%rax), %rdx');
  Line('  shrq $8, %rdx');
  Line('  addq 24(%rax), %rbx');
  Line('  cmpq $1, %rdx');
  Line('  jne .gi_n1');
  Line('  movzbq (%rbx), %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gi_n1:');
  Line('  cmpq $257, %rdx');
  Line('  jne .gi_n2');
  Line('  movsbq (%rbx), %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gi_n2:');
  Line('  cmpq $2, %rdx');
  Line('  jne .gi_n3');
  Line('  movzwq (%rbx), %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gi_n3:');
  Line('  cmpq $258, %rdx');
  Line('  jne .gi_n4');
  Line('  movswq (%rbx), %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gi_n4:');
  Line('  cmpq $4, %rdx');
  Line('  jne .gi_n5');
  Line('  movl (%rbx), %eax');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gi_n5:');
  Line('  cmpq $260, %rdx');
  Line('  jne .gi_n8');
  Line('  movslq (%rbx), %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gi_n8:');
  Line('  movq (%rbx), %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gi_z:');
  Line('  xorq %rax, %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('rt_setpropint:');
  Line('  pushq %rbx');
  Line('  pushq %r8');
  Line('  movq %rdi, %rbx');
  Line('  call rt_propfind');
  Line('  popq %r8');
  Line('  testq %rax, %rax');
  Line('  jz .si_z');
  Line('  cmpb $1, 16(%rax)');
  Line('  jne .si_z');
  Line('  movzbq 17(%rax), %rdx');
  Line('  addq 24(%rax), %rbx');
  Line('  cmpq $1, %rdx');
  Line('  jne .si_n1');
  Line('  movb %r8b, (%rbx)');
  Line('  jmp .si_z');
  Line('.si_n1:');
  Line('  cmpq $2, %rdx');
  Line('  jne .si_n2');
  Line('  movw %r8w, (%rbx)');
  Line('  jmp .si_z');
  Line('.si_n2:');
  Line('  cmpq $4, %rdx');
  Line('  jne .si_n8');
  Line('  movl %r8d, (%rbx)');
  Line('  jmp .si_z');
  Line('.si_n8:');
  Line('  movq %r8, (%rbx)');
  Line('.si_z:');
  Line('  popq %rbx');
  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('rt_getpropstr:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  call rt_propfind');
  Line('  testq %rax, %rax');
  Line('  jz .gs_z');
  Line('  movq 24(%rax), %rcx');
  Line('  movq 8(%rbx,%rcx), %rdx');
  Line('  movq (%rbx,%rcx), %rax');
  Line('  popq %rbx');
  Line('  ret');
  Line('.gs_z:');
  Line('  xorq %rax, %rax');
  Line('  xorq %rdx, %rdx');
  Line('  popq %rbx');
  Line('  ret');
  Line('rt_setpropstr:');
  { The object keeps the string: two holders now (1.0.82). }
  Line('  testq %r9, %r9');
  Line('  jz .sps_k');
  Line('  testb $1, -1(%r8)');
  Line('  jnz .sps_k');
  Line('  orb $1, -1(%r8)');
  Line('.sps_k:');
  Line('  pushq %rbx');
  Line('  pushq %r9');
  Line('  pushq %r8');
  Line('  movq %rdi, %rbx');
  Line('  call rt_propfind');
  Line('  popq %r8');
  Line('  popq %r9');
  Line('  testq %rax, %rax');
  Line('  jz .ss_z');
  Line('  cmpq $2, 16(%rax)');
  Line('  jne .ss_z');
  Line('  movq 24(%rax), %rcx');
  Line('  movq %r8, (%rbx,%rcx)');
  Line('  movq %r9, 8(%rbx,%rcx)');
  Line('.ss_z:');
  Line('  popq %rbx');
  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('rt_setpropmeth:');
  Line('  pushq %rbx');
  Line('  pushq %r9');
  Line('  pushq %r8');
  Line('  movq %rdi, %rbx');
  Line('  call rt_propfind');
  Line('  popq %r8');
  Line('  popq %r9');
  Line('  testq %rax, %rax');
  Line('  jz .sm_z');
  Line('  cmpq $3, 16(%rax)');
  Line('  jne .sm_z');
  Line('  movq 24(%rax), %rcx');
  Line('  movq %r8, (%rbx,%rcx)');
  Line('  movq %r9, 8(%rbx,%rcx)');
  Line('.sm_z:');
  Line('  popq %rbx');
  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('rt_callprop:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  call rt_propfind');
  Line('  testq %rax, %rax');
  Line('  jz .cp_z');
  Line('  cmpq $3, 16(%rax)');
  Line('  jne .cp_z');
  Line('  movq 24(%rax), %rcx');
  Line('  movq 8(%rbx,%rcx), %rdi');
  Line('  movq (%rbx,%rcx), %rax');
  Line('  popq %rbx');
  Line('  call *%rax');
  Line('  ret');
  Line('.cp_z:');
  Line('  popq %rbx');
  Line('  xorq %rax, %rax');
  Line('  ret');
end;

function TEmitter.Emit(const Prog: TProgram): string;
var
  i, j, k, mi, mb0: SizeInt;
  sz, rp, slot: LongInt;
  big: Int64;
  sruns: TInt64Arr;
  msym: string;
  gw: TGcBits;
begin
  FOut := '';
  FLen := 0;
  FLab := 0;
  FCold := '';
  FColdAt := -1;
  FCheckPtr := Prog.CheckPtr;
  FCpuSet := Prog.CpuSet;
  FTune := Prog.CpuTune;
  FProgCpu := Prog.CpuSet;
  FProgTune := Prog.CpuTune;
  FProgProc := Prog.CpuProc;
  FDebug := Prog.Debug;
  FDbgFn := '';
  FLastIns := '';
  FStrs := nil;
  FGcTypes := nil;
  FGcInst := nil;
  FRootWords := nil;
  FMapOn := False;
  FMapPro := False;
  FMapSpOk := False;
  FMapSites := nil;
  FMapOut := nil;
  FMapOutN := 0;
  FDescOut := nil;
  FDescN := 0;
  FDescHash := nil;
  FMapLab := 0;
  FPushK := nil;
  FPushHint := nil;
  FScrOff := nil;
  FScrK := nil;
  FScrHint := 2;
  FScrHintW := nil;
  FTryPush := nil;
  FBrk := nil;
  FCont := nil;
  FEpi := '.Lepi0';
  FScratchOff := 0;
  FScratchCur := 0;
  FTypes := Prog.Types;
  FResName := '';
  FResOff := 0;
  FHasRes := False;
  FResTyp := TyNone;
  LoadGlobals(Prog);
  FNest := 0;
  FProgProcs := Prog.Procs;
  SetLength(FProcSyms, Length(Prog.Procs));
  SetLength(FProcNests, Length(Prog.Procs));
  for i := 0 to High(Prog.Procs) do
  begin
    FProcSyms[i] := Prog.Procs[i].Sym;
    FProcNests[i] := Prog.Procs[i].Nest;
  end;
  FScratchOff := 0;
  FScratchCur := 0;
  FScratchMax := 0;
  FPinned := 0;
  FPromoOn := False;
  FPromo := nil;
  FStubs := '';
  FResReg := '';
  FCurProc := 'pas_main';
  FIsUnit := Prog.IsUnit;
  { the units that are the runtime's (P293): the collector, the
    scheduler's primitives and the debugger keep their state across
    instructions no signal may stop between, as Go never stops its
    runtime package asynchronously }
  FRtUnit := Prog.IsUnit and ((ToLower(Prog.Name) = 'pasheap') or
    (ToLower(Prog.Name) = 'pasroutines') or (ToLower(Prog.Name) = 'pasdebug'));
  FExtVars := nil;
  for i := 0 to High(Prog.Vars) do
    if Prog.Vars[i].Ext then
    begin
      SetLength(FExtVars, Length(FExtVars) + 1);
      FExtVars[High(FExtVars)] := ToLower(GlobName(Prog.Vars[i]));
    end;
  FLocRanges := nil;
  FCtrFacts := nil;
  FAsyncOK := False;
  FInMain := False;
  FRtUnit := False;
  FNestNames := nil;
  FRoutTab := nil;
  FRoutTabN := 0;
  FRoutTabOn := False;
  FNameSink := 0;
  FAddrNames := nil;
  FAddrKept := nil;
  FLocAddr := nil;
  for i := 0 to High(Prog.Procs) do
    ScanAddrS(Prog.Procs[i].Body);
  ScanAddrS(Prog.Body);
  ScanAddrS(Prog.InitBody);
  ScanAddrS(Prog.FiniBody);
  FFrameSym := '.Lfrpas_main';
  FSrc := Prog.SrcName;
  FCurLine := 0;
  FLineLabs := nil;
  FLineNums := nil;
  FOwnNames := nil;
  FOwnEnds := nil;
  FOwnPas := nil;
  FOwnSyms := nil;
  if FArm then
  begin
    Line('/* generated by paslangc — linux arm64 */');
    { the assembler takes the SHA-1, SHA-2, SHA-512, SHA-3 and CRC32
      instructions of the runtime and of inline asm (P110); a program
      runs them only where rt_cpufeat says the processor has them }
    Line('.arch armv8-a+crypto+sha3+crc');
    { LSE when any code of the file is for a processor with it: the
