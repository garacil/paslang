procedure TEmitter.EmitRuntimeArm;
begin
  Line('');
  { As on amd64: 1 GiB per stack, stacks counted in rt_stacktot with a
    64 GiB ceiling, the add atomic because many Ms map stacks (P92). }
  Line('rt_mmap:');
  Imm('x9', 1073741824);
  Line('  cmp x0, x9');
  Line('  b.hi rt_dietoobig');
  LdS('rt_stacktot', 'x9');
  Line('  add x9, x9, x0');
  Imm('x10', 68719476736);
  Line('  cmp x9, x10');
  Line('  b.hi rt_dieoomstk');
  Line('  mov x1, x0');
  Line('  mov x0, xzr');
  Line('  mov x2, #3');
  Imm('x3', $4022);
  Line('  mov x4, #-1');
  Line('  mov x5, xzr');
  Line('  mov x8, #222');
  Line('  svc #0');
  Line('  cmp x0, #0');
  Line('  b.lt rt_diemmap');
  LeaS('rt_stacktot', 'x16');
  Line('.mm_add:');
  Line('  ldaxr x9, [x16]');
  Line('  add x9, x9, x1');
  Line('  stlxr w10, x9, [x16]');
  Line('  cbnz w10, .mm_add');
  Line('  ret');
  Line('rt_guard:');
  Line('  str x30, [sp, #-16]!');
  Line('  mov x1, #4096');
  Line('  mov x2, #102');
  Line('  mov x8, #233');
  Line('  svc #0');
  Line('  ldr x30, [sp], #16');
  Line('  cbnz x0, rt_guardfail');
  Line('  ret');
  Line('rt_guardfail:');
  LeaS('.Lguarderr', 'x1');
  Line('  mov x2, #35');
  Line('  mov x0, #2');
  Line('  mov x8, #64');
  Line('  svc #0');
  Line('  mov x0, #2');
  Line('  b rt_exit');
  { P86 on arm64, the same shape as amd64: raw writes to standard error,
    rt_diemsg with the text in x1 and x2 and a pc in x0, " at line N"
    when the pc is inside the program, exit 1. }
  Line('rt_rawwrite:');
  Line('  mov x0, #2');
  Line('  mov x8, #64');
  Line('  svc #0');
  Line('  cmn x0, #4');
  Line('  b.eq rt_rawwrite');
  Line('  cmn x0, #11');
  Line('  b.eq rt_rawwrite');
  Line('  ret');
  Line('rt_fatalnum:');
  Line('  stp x29, x30, [sp, #-16]!');
