  Line('  add x9, x2, x5, lsl #3');
  Line('  ldr x6, [x9, #40]');
  Line('  add w7, w3, #1');
  Line('.qg_cas:');
  Line('  add x9, x2, #16');
  Line('  ldxr w8, [x9]');
  Line('  cmp w8, w3');
  Line('  b.ne .qg_retry');
