  Line('  msub x7, x6, x4, x5');
  Line('  ldrb w7, [x3, x7]');
  Line('  sub x2, x2, #1');
  Line('  strb w7, [x2]');
  Line('  mov x5, x6');
  Line('  cbnz x5, .fn_loop');
  Line('  mov x1, x2');
  Line('  sub x2, x29, #1');
  Line('  sub x2, x2, x1');
  Line('  bl rt_rawwrite');
  Line('  mov sp, x29');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
  Line('rt_pcline:');
  Line('  mov x1, x0');
  LeaS('rt_linetab', 'x2');
  Line('  mov x0, xzr');
  Line('  mov x4, xzr');
  Line('.pl_scan:');
  Line('  ldr x3, [x2]');
  Line('  cbz x3, .pl_done');
  Line('  cmp x3, x1');
  Line('  b.hi .pl_next');
  Line('  cmp x3, x4');
  Line('  b.lo .pl_next');
  Line('  mov x4, x3');
  Line('  ldr x0, [x2, #8]');
  Line('.pl_next:');
  Line('  add x2, x2, #16');
  Line('  b .pl_scan');
  Line('.pl_done:');
  Line('  ret');
  Line('rt_fatalline:');
  Line('  stp x29, x30, [sp, #-16]!');
  Line('  str x19, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  bl rt_pcline');
  Line('  cbnz x0, .fl_line');
  Line('  cbz x19, .fl_none');
  LeaS('.Latpc', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgAtPc)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  mov x1, #16');
  Line('  bl rt_fatalnum');
  Line('  b .fl_none');
  Line('.fl_line:');
  Line('  mov x19, x0');
  LeaS('.Latline', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgAtLine)));
