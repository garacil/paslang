  Line('  str x9, [x28, #16]');
  Line('.ul_nog:');
  LeaS('rt_glock', 'x9');
  Line('  cmp x9, x0');
  Line('  b.ne .ul_do');
  StS('xzr', 'rt_glocksite');
  Line('.ul_do:');
  Line('  ldxr w9, [x0]');
  Line('  stlxr w10, wzr, [x0]');
  Line('  cbnz w10, .ul_do');
  Line('  cmp w9, #2');
  Line('  b.eq .ul_wake');
  Line('  ret');
  Line('.ul_wake:');
  Line('  stp x0, x1, [sp, #-32]!');
