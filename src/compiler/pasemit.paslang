  Line('  movq 32(%r14), %rcx');
  Line('  movq 8(%rcx), %rcx');
  Line('  testq %rcx, %rcx');
  Line('  jz .csp_no');
  Line('  cmpq $0, 24(%rcx)');
  Line('  jne .csp_no');
  Line('  movl 16(%rcx), %eax');
  Line('  cmpl 20(%rcx), %eax');
  Line('  jne .csp_no');
  Line('  movq $1, %rax');
  Line('  ret');
  Line('.csp_no:');
  Line('  xorq %rax, %rax');
  Line('  ret');
