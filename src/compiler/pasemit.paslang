  Line('  cmpq %rbx, %r12');
  Line('  jge .np_ed');
  Line('  movq %r12, %rax');
  Line('  movq $12, %rcx');
  Line('  mulq %rcx');
  Line('  leaq (%rsp, %rax), %r8');
  Line('  movq 4(%r8), %rdi');
