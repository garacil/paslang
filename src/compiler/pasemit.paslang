  Line('  mov x2, #1');
  Line('  bl rt_rawwrite');
  Line('  mov x0, x22');
  Line('  bl rt_fatalline');
  Line('  b rt_dieend');
  { rt_diechancap as on amd64 (1.0.136): x0 the capacity, x30 the line. }
  Line('rt_diechancap:');
  Line('  sub x22, x30, #1');
  Line('  mov x19, x0');
  LeaS('.Lchancap', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgChanCap)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  bl rt_fatalint');
  LeaS('.Lchancap2', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgChanCap2)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x22');
  Line('  bl rt_fatalline');
  Line('  b rt_dieend');
  Line('rt_fatalint:');
  Line('  stp x29, x30, [sp, #-16]!');
  Line('  tbz x0, #63, .afi_pos');
