  Line('  ldr q4, [x3, #0]');
  Line('  ldur q5, [x7, #0]');
  Line('  eor v5.16b, v4.16b, v5.16b');
  Line('  xtn v6.2s, v5.2d');
  Line('  shrn v5.2s, v5.2d, #32');
  Line('  umlal v0.2d, v6.2s, v5.2s');
  Line('  ext v4.16b, v4.16b, v4.16b, #8');
  Line('  add v0.2d, v0.2d, v4.2d');
  Line('  ldr q4, [x3, #16]');
  Line('  ldur q5, [x7, #16]');
  Line('  eor v5.16b, v4.16b, v5.16b');
  Line('  xtn v6.2s, v5.2d');
  Line('  shrn v5.2s, v5.2d, #32');
  Line('  umlal v1.2d, v6.2s, v5.2s');
  Line('  ext v4.16b, v4.16b, v4.16b, #8');
  Line('  add v1.2d, v1.2d, v4.2d');
  Line('  ldr q4, [x3, #32]');
  Line('  ldur q5, [x7, #32]');
  Line('  eor v5.16b, v4.16b, v5.16b');
  Line('  xtn v6.2s, v5.2d');
  Line('  shrn v5.2s, v5.2d, #32');
  Line('  umlal v2.2d, v6.2s, v5.2s');
  Line('  ext v4.16b, v4.16b, v4.16b, #8');
  Line('  add v2.2d, v2.2d, v4.2d');
  Line('  ldr q4, [x3, #48]');
  Line('  ldur q5, [x7, #48]');
  Line('  eor v5.16b, v4.16b, v5.16b');
  Line('  xtn v6.2s, v5.2d');
  Line('  shrn v5.2s, v5.2d, #32');
  Line('  umlal v3.2d, v6.2s, v5.2s');
  Line('  ext v4.16b, v4.16b, v4.16b, #8');
  Line('  add v3.2d, v3.2d, v4.2d');
  Line('  add x3, x3, #64');
  Line('  add x7, x7, #8');
  Line('  subs x6, x6, #1');
  Line('  b.ne .x3_st');
  Line('.x3_last:');
  Line('  sub x3, x5, #64');
  Line('  ldr q4, [x3, #0]');
  Line('  ldur q5, [x10, #121]');
  Line('  eor v5.16b, v4.16b, v5.16b');
  Line('  xtn v6.2s, v5.2d');
  Line('  shrn v5.2s, v5.2d, #32');
  Line('  umlal v0.2d, v6.2s, v5.2s');
  Line('  ext v4.16b, v4.16b, v4.16b, #8');
  Line('  add v0.2d, v0.2d, v4.2d');
  Line('  ldr q4, [x3, #16]');
  Line('  ldur q5, [x10, #137]');
  Line('  eor v5.16b, v4.16b, v5.16b');
  Line('  xtn v6.2s, v5.2d');
  Line('  shrn v5.2s, v5.2d, #32');
  Line('  umlal v1.2d, v6.2s, v5.2s');
  Line('  ext v4.16b, v4.16b, v4.16b, #8');
  Line('  add v1.2d, v1.2d, v4.2d');
  Line('  ldr q4, [x3, #32]');
  Line('  ldur q5, [x10, #153]');
  Line('  eor v5.16b, v4.16b, v5.16b');
  Line('  xtn v6.2s, v5.2d');
  Line('  shrn v5.2s, v5.2d, #32');
  Line('  umlal v2.2d, v6.2s, v5.2s');
  Line('  ext v4.16b, v4.16b, v4.16b, #8');
  Line('  add v2.2d, v2.2d, v4.2d');
  Line('  ldr q4, [x3, #48]');
  Line('  ldur q5, [x10, #169]');
  Line('  eor v5.16b, v4.16b, v5.16b');
  Line('  xtn v6.2s, v5.2d');
  Line('  shrn v5.2s, v5.2d, #32');
  Line('  umlal v3.2d, v6.2s, v5.2s');
  Line('  ext v4.16b, v4.16b, v4.16b, #8');
  Line('  add v3.2d, v3.2d, v4.2d');
  Line('  add x6, sp, #192');
  Line('  stp q0, q1, [x6]');
  Line('  stp q2, q3, [x6, #32]');
  Imm('x15', Int64(-7046029288634856825));
  Line('  mul x15, x15, x2');
  Line('  ldr x11, [x6, #0]');
  Line('  ldur x12, [x10, #11]');
  Line('  eor x11, x11, x12');
  Line('  ldr x13, [x6, #8]');
  Line('  ldur x12, [x10, #19]');
  Line('  eor x13, x13, x12');
  Line('  mul x12, x11, x13');
  Line('  umulh x14, x11, x13');
  Line('  eor x12, x12, x14');
  Line('  add x15, x15, x12');
  Line('  ldr x11, [x6, #16]');
  Line('  ldur x12, [x10, #27]');
  Line('  eor x11, x11, x12');
  Line('  ldr x13, [x6, #24]');
  Line('  ldur x12, [x10, #35]');
  Line('  eor x13, x13, x12');
  Line('  mul x12, x11, x13');
  Line('  umulh x14, x11, x13');
  Line('  eor x12, x12, x14');
  Line('  add x15, x15, x12');
  Line('  ldr x11, [x6, #32]');
  Line('  ldur x12, [x10, #43]');
  Line('  eor x11, x11, x12');
  Line('  ldr x13, [x6, #40]');
  Line('  ldur x12, [x10, #51]');
  Line('  eor x13, x13, x12');
  Line('  mul x12, x11, x13');
  Line('  umulh x14, x11, x13');
  Line('  eor x12, x12, x14');
  Line('  add x15, x15, x12');
  Line('  ldr x11, [x6, #48]');
  Line('  ldur x12, [x10, #59]');
  Line('  eor x11, x11, x12');
  Line('  ldr x13, [x6, #56]');
  Line('  ldur x12, [x10, #67]');
  Line('  eor x13, x13, x12');
  Line('  mul x12, x11, x13');
  Line('  umulh x14, x11, x13');
  Line('  eor x12, x12, x14');
  Line('  add x15, x15, x12');
  Line('  mov x3, x15');
  Line('  eor x3, x3, x3, lsr #37');
  Imm('x14', Int64(1609587791953885689));
  Line('  mul x3, x3, x14');
  Line('  eor x3, x3, x3, lsr #32');
  Line('  mov x0, x3');
  Line('  mov sp, x29');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
end;

procedure TEmitter.EmitRuntimeArm;
begin
  Line('');
  { As on amd64: 1 GiB per stack, stacks counted in rt_stacktot with a
    64 GiB ceiling, the add atomic because many Ms map stacks (P92). }
  Line('rt_mmap:');
  Imm('x9', 1073741824);
  Line('  cmp x0, x9');
  Line('  b.hi rt_dietoobig');
  LdS('rt_stacktot', 'x9');
  Line('  add x9, x9, x0');
  Imm('x10', 68719476736);
  Line('  cmp x9, x10');
  Line('  b.hi rt_dieoomstk');
  Line('  mov x1, x0');
  Line('  mov x0, xzr');
  Line('  mov x2, #3');
  Imm('x3', $4022);
  Line('  mov x4, #-1');
  Line('  mov x5, xzr');
  Line('  mov x8, #222');
  Line('  svc #0');
  Line('  cmp x0, #0');
  Line('  b.lt rt_diemmap');
  LeaS('rt_stacktot', 'x16');
  Line('.mm_add:');
  Line('  ldaxr x9, [x16]');
  Line('  add x9, x9, x1');
  Line('  stlxr w10, x9, [x16]');
  Line('  cbnz w10, .mm_add');
  Line('  ret');
  Line('rt_guard:');
  Line('  str x30, [sp, #-16]!');
  Line('  mov x1, #4096');
  Line('  mov x2, #102');
  Line('  mov x8, #233');
  Line('  svc #0');
  Line('  ldr x30, [sp], #16');
  Line('  cbnz x0, rt_guardfail');
  Line('  ret');
  Line('rt_guardfail:');
  LeaS('.Lguarderr', 'x1');
  Line('  mov x2, #35');
  Line('  bl rt_rawwrite');
  Line('  mov x0, #2');
  Line('  b rt_exit');
  Line('rt_gconstack:');
  LeaS('.Lgconstack', 'x1');
  Line('  mov x2, #51');
  Line('  bl rt_rawwrite');
  Line('  mov x0, #2');
  Line('  b rt_exit');
  { P86 on arm64, the same shape as amd64: raw writes to standard error,
    rt_diemsg with the text in x1 and x2 and a pc in x0, " at line N"
    when the pc is inside the program, exit 1. rt_rawwrite as on amd64
    (P217): all of x1, x2 bytes, EINTR again, EAGAIN waits in ppoll
    (73; arm64 has no poll) with tmo_p and sigmask NULL, which waits
    with no limit and leaves the mask alone (docs/ref/linux/poll.2),
    any other answer gives up. x0 to x4, x8 and x9 are clobbered; 32
    bytes of stack in one pre-indexed STP and one post-indexed LDP,
    which keep sp 16-byte aligned (Arm ARM C6.2.414, C6.2.214: a
    multiple of 8 from -512 to 504), the pollfd at sp + 16 (STR
    unsigned offset, C6.2.415: a multiple of 4). }
  Line('rt_rawwrite:');
  Line('  cmp x2, #0');
  Line('  b.le .arw_done');
  Line('  mov x0, #2');
  Line('  mov x8, #64');
  Line('  svc #0');
  Line('  cmp x0, #0');
  Line('  b.gt .arw_more');
  Line('  cmn x0, #4');
  Line('  b.eq rt_rawwrite');
  Line('  cmn x0, #11');
  Line('  b.ne .arw_done');
  Line('  stp x1, x2, [sp, #-32]!');
  Line('  mov w9, #2');
  Line('  str w9, [sp, #16]');
  Line('  mov w9, #4');
  Line('  str w9, [sp, #20]');
  Line('  add x0, sp, #16');
  Line('  mov x1, #1');
  Line('  mov x2, xzr');
  Line('  mov x3, xzr');
  Line('  mov x4, #8');
  Line('  mov x8, #73');
  Line('  svc #0');
  Line('  ldp x1, x2, [sp], #32');
  Line('  cmp x0, #0');
  Line('  b.ge rt_rawwrite');
  Line('  cmn x0, #4');
  Line('  b.eq rt_rawwrite');
  Line('  ret');
  Line('.arw_more:');
  Line('  add x1, x1, x0');
  Line('  sub x2, x2, x0');
  Line('  b rt_rawwrite');
  Line('.arw_done:');
  Line('  ret');
  Line('rt_fatalnum:');
  Line('  stp x29, x30, [sp, #-16]!');
  Line('  mov x29, sp');
  Line('  sub sp, sp, #32');
  Line('  sub x2, x29, #1');
  LeaS('.Lhexdig', 'x3');
  Line('  mov x4, x1');
  Line('  mov x5, x0');
  Line('.fn_loop:');
  Line('  udiv x6, x5, x4');
  Line('  msub x7, x6, x4, x5');
  Line('  ldrb w7, [x3, x7]');
  Line('  sub x2, x2, #1');
  Line('  strb w7, [x2]');
  Line('  mov x5, x6');
  Line('  cbnz x5, .fn_loop');
  Line('  mov x1, x2');
  Line('  sub x2, x29, #1');
  Line('  sub x2, x2, x1');
  Line('  bl rt_rawwrite');
  Line('  mov sp, x29');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
  Line('rt_pcline:');
  Line('  mov x1, x0');
  LeaS('rt_linetab', 'x2');
  Line('  mov x0, xzr');
  Line('  mov x4, xzr');
  Line('.pl_scan:');
  Line('  ldr x3, [x2]');
  Line('  cbz x3, .pl_done');
  Line('  cmp x3, x1');
  Line('  b.hi .pl_next');
  Line('  cmp x3, x4');
  Line('  b.lo .pl_next');
  Line('  mov x4, x3');
  Line('  ldr x0, [x2, #8]');
  Line('.pl_next:');
  Line('  add x2, x2, #16');
  Line('  b .pl_scan');
  Line('.pl_done:');
  Line('  ret');
  Line('rt_fatalline:');
  Line('  stp x29, x30, [sp, #-16]!');
  Line('  str x19, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  bl rt_pcline');
  Line('  cbnz x0, .fl_line');
  Line('  cbz x19, .fl_none');
  LeaS('.Latpc', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgAtPc)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  mov x1, #16');
  Line('  bl rt_fatalnum');
  Line('  b .fl_none');
  Line('.fl_line:');
  Line('  mov x19, x0');
  LeaS('.Latline', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgAtLine)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  mov x1, #10');
  Line('  bl rt_fatalnum');
  Line('.fl_none:');
  Line('  ldr x19, [sp], #16');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
  Line('rt_diemsg:');
  Line('  mov x19, x0');
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  bl rt_fatalline');
  Line('rt_dieend:');
  LeaS('.Lnl', 'x1');
  Line('  mov x2, #1');
  Line('  bl rt_rawwrite');
  Line('  mov x0, #1');
  Line('  b rt_exit');
  Line('rt_dieoomstk:');
  LeaS('.Loomstk', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgOomStack)));
  Line('  bl rt_rawwrite');
  LdS('rt_stacktot', 'x0');
  Line('  lsr x0, x0, #20');
  Line('  mov x1, #10');
  Line('  bl rt_fatalnum');
  LeaS('.Lmib', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgMib)));
  Line('  bl rt_rawwrite');
  Line('  b rt_dieend');
  if CpuZvaBlock(FProgProc) = 64 then
  begin
    { rt_boot found another DC ZVA than the processor -cpu named (P273):
      the message, DCZID_EL0 as it reads, and exit 1 }
    Line('rt_diezva:');
    Line('  mov x19, x9');
    LeaS('.Lzva', 'x1');
    Line('  mov x2, #' + IntToStr(Length(ZvaMsg)));
    Line('  bl rt_rawwrite');
    Line('  mov x0, x19');
    Line('  mov x1, #10');
    Line('  bl rt_fatalnum');
    Line('  b rt_dieend');
  end;
  Line('rt_dieoom:');
  LeaS('.Loom', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgOom)));
  Line('  bl rt_rawwrite');
  LdS('rt_maptot', 'x0');
  Line('  lsr x0, x0, #20');
  Line('  mov x1, #10');
  Line('  bl rt_fatalnum');
  LeaS('.Lmib', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgMib)));
  Line('  bl rt_rawwrite');
  Line('  b rt_dieend');
  Line('rt_die:');
  Line('  mov x0, xzr');
  LeaS('.Lfatal', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgFatal)));
  Line('  b rt_diemsg');
  Line('rt_diemmap:');
  Line('  mov x0, xzr');
  LeaS('.Lmmapfail', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgMmap)));
  Line('  b rt_diemsg');
  Line('rt_dietoobig:');
  Line('  mov x0, xzr');
  LeaS('.Ltoobig', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgTooBig)));
  Line('  b rt_diemsg');
  Line('rt_dieepoll:');
  Line('  mov x0, xzr');
  LeaS('.Lepollfail', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgEpoll)));
  Line('  b rt_diemsg');
  Line('rt_diestack:');
  LeaS('.Lstackovf', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgStack)));
  Line('  b rt_diemsg');
  Line('rt_diesendclosed:');
  LeaS('.Lsendclosed', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgSendClosed)));
  Line('  b rt_diemsg');
  Line('rt_diecloseclosed:');
  LeaS('.Lcloseclosed', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgCloseClosed)));
  Line('  b rt_diemsg');
  Line('rt_diemaprw:');
  LeaS('.Lmaprw', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgMapRW)));
  Line('  b rt_diemsg');
  Line('rt_dieclosesender:');
  LeaS('.Lclosesender', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgCloseSender)));
  Line('  b rt_diemsg');
  Line('rt_diedeadlock:');
  Line('  mov x0, xzr');
  LeaS('.Ldeadlock', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgDeadlock)));
  Line('  b rt_diemsg');
  Line('rt_diethreads:');
  Line('  mov x0, xzr');
  LeaS('.Lthreads', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgThreads)));
  Line('  b rt_diemsg');
  Line('rt_divzero:');
  Line('  sub x0, x30, #1');
  LeaS('.Ldivzero', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgDivZero)));
  Line('  b rt_diemsg');
  { rt_divover and rt_divmod128 as on amd64 (1.0.121): arm64 has no
    128-by-64 division, so 64 shifts and subtractions, the quotient
    coming in at the low end of the dividend. }
  Line('rt_divover:');
  Line('  sub x0, x30, #1');
  LeaS('.Ldivover', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgDivOver)));
  Line('  b rt_diemsg');
  Line('rt_divmod128:');
  Line('  cbnz x2, .adm_nz');
  Line('  b rt_divzero');
  Line('.adm_nz:');
  Line('  cmp x0, x2');
  Line('  b.lo .adm_ok');
  Line('  b rt_divover');
  Line('.adm_ok:');
  Line('  mov x9, #64');
  Line('.adm_l:');
  Line('  lsr x10, x0, #63');
  Line('  extr x0, x0, x1, #63');
  Line('  lsl x1, x1, #1');
  Line('  cmp x0, x2');
  Line('  cset x11, hs');
  Line('  orr x11, x11, x10');
  Line('  cbz x11, .adm_s');
  Line('  sub x0, x0, x2');
  Line('  orr x1, x1, #1');
  Line('.adm_s:');
  Line('  subs x9, x9, #1');
  Line('  b.ne .adm_l');
  Line('  str x1, [x3]');
  Line('  str x0, [x4]');
  Line('  ret');
  { rt_boundsfail and rt_fatalint as on amd64 (P87): x0 the index, x1
    and x2 the bounds, x30 the line; x19 to x23 hold what the writes
    clobber. }
  Line('rt_bitfail:');
  LeaS('.Lbbit', 'x9');
  Line('  mov x10, #' + IntToStr(Length(MsgBit)));
  Line('  b .abf_go');
  Line('rt_setfail:');
  LeaS('.Lbset', 'x9');
  Line('  mov x10, #' + IntToStr(Length(MsgSet)));
  Line('  b .abf_go');
  Line('rt_boundsfail:');
  LeaS('.Lbidx', 'x9');
  Line('  mov x10, #' + IntToStr(Length(MsgIndex)));
  Line('.abf_go:');
  Line('  sub x22, x30, #1');
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  Line('  mov x21, x2');
  Line('  mov x1, x9');
  Line('  mov x2, x10');
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  bl rt_fatalint');
  LeaS('.Lbrange', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgOutOfRange)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x20');
  Line('  bl rt_fatalint');
  LeaS('.Lbdots', 'x1');
  Line('  mov x2, #2');
  Line('  bl rt_rawwrite');
  Line('  mov x0, x21');
  Line('  bl rt_fatalint');
  LeaS('.Lbclose', 'x1');
  Line('  mov x2, #1');
  Line('  bl rt_rawwrite');
  Line('  mov x0, x22');
  Line('  bl rt_fatalline');
  Line('  b rt_dieend');
  { rt_diechancap as on amd64 (1.0.136): x0 the capacity, x30 the line. }
  Line('rt_diechancap:');
  Line('  sub x22, x30, #1');
  Line('  mov x19, x0');
  LeaS('.Lchancap', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgChanCap)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  bl rt_fatalint');
  LeaS('.Lchancap2', 'x1');
  Line('  mov x2, #' + IntToStr(Length(MsgChanCap2)));
  Line('  bl rt_rawwrite');
  Line('  mov x0, x22');
  Line('  bl rt_fatalline');
  Line('  b rt_dieend');
  Line('rt_fatalint:');
  Line('  stp x29, x30, [sp, #-16]!');
  Line('  tbz x0, #63, .afi_pos');
  Line('  mov x23, x0');
  LeaS('.Lminus', 'x1');
  Line('  mov x2, #1');
  Line('  bl rt_rawwrite');
  Line('  neg x0, x23');
  Line('.afi_pos:');
  Line('  mov x1, #10');
  Line('  bl rt_fatalnum');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
  { The signal handler: pc at 440 and sp at 432 of the ucontext (176 to
    the sigcontext, fault_address, 31 registers, sp, pc); address at 16
    and code at 8 of the siginfo. }
  Line('rt_sighandler:');
  LeaS('rt_siglock', 'x9');
  Line('.sh_lk:');
  Line('  ldaxr x10, [x9]');
