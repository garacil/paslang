  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  stp x21, x22, [sp, #-16]!');
  Line('  stp x23, x24, [sp, #-16]!');
  Line('  mov x19, x1');
  Line('  mov x20, x2');
  Line('  mov x21, x3');
  Line('  mov x22, x4');
  Line('  add x0, x5, #1');
  Line('  mov x23, xzr');
  Line('  cmp x0, #16');
  Line('  b.lo .asg_alloc');
  Line('  cmp x0, #8, lsl #12');
  Line('  b.hi .asg_big');
  Line('  cmp x0, #1016');
  Line('  b.hi .asg_c128');
  Line('  add x9, x0, #7');
  Line('  lsr x9, x9, #3');
  LeaS('rt_s2c8', 'x10');
  Line('  ldrb w23, [x10, x9]');
  Line('  b .asg_cls');
  Line('.asg_c128:');
  Line('  sub x9, x0, #897');
  Line('  lsr x9, x9, #7');
  LeaS('rt_s2c128', 'x10');
  Line('  ldrb w23, [x10, x9]');
  Line('.asg_cls:');
  LeaS('rt_class2size', 'x10');
  Line('  ldr x0, [x10, x23, lsl #3]');
  Line('  b .asg_alloc');
  Line('.asg_big:');
  LeaS('rt_strbig', 'x10');
  Line('  mov x9, #68');
  Line('.asg_bl:');
  Line('  ldr x11, [x10]');
  Line('  cmp x0, x11');
  Line('  b.ls .asg_bf');
  Line('  add x10, x10, #8');
  Line('  add x9, x9, #1');
  Line('  cmp x9, #128');
  Line('  b.lo .asg_bl');
  Line('  b .asg_alloc');
  Line('.asg_bf:');
  Line('  mov x0, x11');
  Line('  mov x23, x9');
  Line('.asg_alloc:');
  Line('  mov x1, xzr');
  Line('  bl rt_alloc');
  Line('  lsl w9, w23, #1');
  Line('  strb w9, [x0]');
  Line('  add x23, x0, #1');
  Line('  mov x0, x23');
  Line('  mov x1, x19');
  Line('  mov x2, x20');
  Line('  bl rt_memcpy');
  Line('  add x0, x23, x20');
  Line('  mov x1, x21');
  Line('  mov x2, x22');
  Line('  bl rt_memcpy');
  Line('  mov x0, x23');
  Line('  add x2, x20, x22');
  Line('  ldp x23, x24, [sp], #16');
  Line('  ldp x21, x22, [sp], #16');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('rt_makechan:');
  { The capacity check of amd64 (1.0.136). }
  Imm('x9', ChanCapMax);
  Line('  cmp x0, x9');
  Line('  b.hi rt_diechancap');
  Line('  cbnz x0, .amc_buf');
  Line('  mov x0, #64');
  Line('  mov x1, xzr');
  Line('  b rt_alloc');
  { A buffered channel as on amd64 (1.0.85). }
  Line('.amc_buf:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  mov x0, #80');
  Line('  mov x1, #1');
  Line('  bl rt_alloc');
  Line('  mov x20, x0');
  Line('  lsl x0, x19, #3');
  Line('  mov x1, #1');
  Line('  bl rt_alloc');
  Line('  str x0, [x20, #48]');
  Line('  str x19, [x20, #56]');
  Line('  str xzr, [x20, #64]');
  Line('  str xzr, [x20, #72]');
  Line('  mov x0, x20');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
