  Line('.amcp_f:');
  Line('  ldr q30, [x1], #16');
  Line('  str q30, [x0], #16');
  Line('  sub x2, x2, #16');
  Line('  cmp x2, #16');
  Line('  b.hi .amcp_f');
  Line('  stur q31, [x3, #-16]');
  Line('  ret');
  Line('.amcp_back:');
  Line('  cbz x3, .amc_done');
  Line('  ldr q31, [x1]');
  Line('.amcp_bl:');
  Line('  sub x2, x2, #16');
  Line('  ldr q30, [x1, x2]');
  Line('  str q30, [x0, x2]');
  Line('  cmp x2, #16');
  Line('  b.hi .amcp_bl');
  Line('  str q31, [x0]');
  Line('  ret');
  { Past 256 KiB: x4 what is left, x5 the source and x6 the destination
    of the next piece (their ends going backwards), x7 the piece, kept
    with x30 on the stack for the caller; each piece is a call of
    rt_memcpy, which keeps them. }
  Line('.amcp_big:');
  Line('  stp x4, x5, [sp, #-48]!');
  Line('  stp x6, x7, [sp, #16]');
  Line('  str x30, [sp, #32]');
  Line('  mov x4, x2');
  Line('  mov x5, x1');
  Line('  mov x6, x0');
  Line('  movz x7, #4, lsl #16');
  Line('  sub x3, x0, x1');
  Line('  cmp x3, x2');
  Line('  b.lo .amcb_back');
  Line('.amcb_f:');
  Line('  cmp x4, x7');
  Line('  csel x2, x4, x7, lo');
  Line('  mov x1, x5');
  Line('  mov x0, x6');
  Line('  add x5, x5, x2');
  Line('  add x6, x6, x2');
  Line('  sub x4, x4, x2');
  Line('  bl rt_memcpy');
  Line('  cbz x4, .amcb_done');
  YieldCheckArm('.amcb_f', 'x3');
  Line('  b .amcb_f');
  Line('.amcb_back:');
  Line('  add x5, x5, x4');
  Line('  add x6, x6, x4');
  Line('.amcb_b:');
  Line('  cmp x4, x7');
  Line('  csel x2, x4, x7, lo');
  Line('  sub x5, x5, x2');
  Line('  sub x6, x6, x2');
  Line('  sub x4, x4, x2');
  Line('  mov x1, x5');
  Line('  mov x0, x6');
  Line('  bl rt_memcpy');
  Line('  cbz x4, .amcb_done');
  YieldCheckArm('.amcb_b', 'x3');
  Line('  b .amcb_b');
  Line('.amcb_done:');
  Line('  ldr x30, [sp, #32]');
  Line('  ldp x6, x7, [sp, #16]');
  Line('  ldp x4, x5, [sp], #48');
  Line('  ret');
  { rt_fill (P272): FillChar and a zero value, x0 the bytes, x1 how many
    (above 0), w2 the byte; x0, x1, x3 and v31 used up, every other
    register kept. DUP puts the byte in every lane of v31 (Arm ARM
    C7.2.41); up to 32 bytes two stores that may overlap, the first
    bytes and the last ones (STUR, C7.2.391, from the end); longer, STP
    of two Q registers 32 bytes a store (C7.2.386, offsets multiples of
    16 up to 1008), four a loop over 128 bytes as the Neoverse V2 and N2
    guides write memset, from the start rounded up to 16 after the first
    64, and the last 128 by stores that end at the end, so nothing past
    the request is written. It was one byte a step (strb). }
  Line('rt_fill:');
  Line('  dup v31.16b, w2');
  Line('  add x3, x0, x1');
  Line('  cmp x1, #32');
  Line('  b.hi .afl_32');
  Line('  cmp x1, #16');
  Line('  b.lo .afl_lt16');
  Line('  str q31, [x0]');
  Line('  stur q31, [x3, #-16]');
  Line('  ret');
  Line('.afl_lt16:');
  Line('  cmp x1, #8');
  Line('  b.lo .afl_lt8');
  Line('  str d31, [x0]');
  Line('  stur d31, [x3, #-8]');
  Line('  ret');
  Line('.afl_lt8:');
  Line('  cmp x1, #4');
  Line('  b.lo .afl_lt4');
  Line('  str s31, [x0]');
  Line('  stur s31, [x3, #-4]');
  Line('  ret');
  Line('.afl_lt4:');
  Line('  strb w2, [x0]');
  Line('  cmp x1, #2');
  Line('  b.lo .afl_ret');
  Line('  stur h31, [x3, #-2]');
  Line('.afl_ret:');
  Line('  ret');
  Line('.afl_32:');
  if CpuZvaBlock(FProgProc) = 64 then
  begin
    { zeros of 256 bytes and more on a processor -cpu names whose DC ZVA
      zeroes 64 bytes (P273): the first 64 and the last 64 by STP, the
      aligned blocks between by DC ZVA (Arm ARM C5.3.38: a naturally
      aligned block of the size DCZID_EL0 gives, which rt_boot checked),
      two a loop, as the Neoverse V2 and N2 guides write memset to zero }
    Line('  cbnz w2, .afl_nz');
    Line('  cmp x1, #256');
    Line('  b.lo .afl_nz');
    Line('  stp q31, q31, [x0]');
    Line('  stp q31, q31, [x0, #32]');
    Line('  add x0, x0, #64');
    Line('  bic x0, x0, #63');
    Line('  sub x1, x3, #64');
    Line('.afl_zl:');
    Line('  cmp x0, x1');
    Line('  b.hi .afl_zt');
    Line('  dc zva, x0');
    Line('  add x0, x0, #64');
    Line('  cmp x0, x1');
    Line('  b.hi .afl_zt');
    Line('  dc zva, x0');
    Line('  add x0, x0, #64');
    Line('  b .afl_zl');
    Line('.afl_zt:');
    Line('  stp q31, q31, [x3, #-64]');
    Line('  stp q31, q31, [x3, #-32]');
    Line('  ret');
    Line('.afl_nz:');
  end;
  Line('  stp q31, q31, [x0]');
  Line('  stp q31, q31, [x3, #-32]');
  Line('  cmp x1, #64');
  Line('  b.ls .afl_ret');
  Line('  stp q31, q31, [x0, #32]');
  Line('  stp q31, q31, [x3, #-64]');
  Line('  cmp x1, #128');
  Line('  b.ls .afl_ret');
  Line('  add x0, x0, #64');
  Line('  bic x0, x0, #15');
  Line('  sub x1, x3, #128');
  Line('.afl_loop:');
  Line('  cmp x0, x1');
  Line('  b.hi .afl_tail');
  Line('  stp q31, q31, [x0]');
  Line('  stp q31, q31, [x0, #32]');
  Line('  stp q31, q31, [x0, #64]');
  Line('  stp q31, q31, [x0, #96]');
  Line('  add x0, x0, #128');
  Line('  b .afl_loop');
  Line('.afl_tail:');
  Line('  stp q31, q31, [x1]');
  Line('  stp q31, q31, [x1, #32]');
  Line('  stp q31, q31, [x1, #64]');
  Line('  stp q31, q31, [x1, #96]');
  Line('  ret');
  { rt_fillbig (P271): FillChar and a zero value past 256 KiB, x0 the
    bytes, x1 how many, w2 the byte, a piece of 256 KiB at a time through
    rt_fill (P272) with rt_yieldpoint between two; x0, x1 and v31 used
    up, every other register kept. }
  Line('rt_fillbig:');
  Line('  stp x3, x30, [sp, #-32]!');
  Line('  stp x4, x5, [sp, #16]');
  Line('.afb_l:');
  Line('  cmp x1, #64, lsl #12');
  Line('  b.ls .afb_last');
  Line('  mov x4, x0');
  Line('  mov x5, x1');
  Line('  movz x1, #4, lsl #16');
  Line('  bl rt_fill');
  Line('  add x0, x4, #64, lsl #12');
  Line('  sub x1, x5, #64, lsl #12');
  YieldCheckArm('.afb_l', 'x3');
  Line('  b .afb_l');
  Line('.afb_last:');
  Line('  cbz x1, .afb_done');
  Line('  bl rt_fill');
  Line('.afb_done:');
  Line('  ldp x4, x5, [sp, #16]');
  Line('  ldp x3, x30, [sp], #32');
  Line('  ret');
