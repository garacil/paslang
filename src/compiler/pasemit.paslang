    it, 0 when none or full. x9-x12 change. }
  Line('rt_chbput:');
  Line('  ldr x9, [x0, #48]');
  Line('  cbz x9, .acbp_no');
  Line('  ldr x10, [x0, #64]');
  Line('  ldr x11, [x0, #56]');
  Line('  cmp x10, x11');
  Line('  b.hs .acbp_no');
  Line('  ldr x12, [x0, #72]');
  Line('  add x12, x12, x10');
  Line('  cmp x12, x11');
  Line('  b.lo .acbp_in');
  Line('  sub x12, x12, x11');
  Line('.acbp_in:');
  Line('  str x1, [x9, x12, lsl #3]');
  Line('  add x10, x10, #1');
  Line('  str x10, [x0, #64]');
  Line('  mov x0, #1');
  Line('  ret');
  Line('.acbp_no:');
  Line('  mov x0, xzr');
  Line('  ret');
