  Line('rt_runqget:');
  Line('  xorq %rax, %rax');
  Line('  xchgq %rax, 24(%rdi)');
  Line('  testq %rax, %rax');
  Line('  jnz .qg_done');
  Line('.qg_retry:');
  Line('  movl 16(%rdi), %r9d');
  Line('  movl 20(%rdi), %ecx');
  Line('  cmpl %r9d, %ecx');
  Line('  je .qg_empty');
  Line('  movl %r9d, %edx');
  Line('  andl $255, %edx');
  Line('  movq 40(%rdi, %rdx, 8), %r8');
  { cmpxchg compares %eax with the memory and stores the *other*
    operand. Both were the same register, head + 1, so the compare
