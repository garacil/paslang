  Line('  movl %eax, %ecx');
  Line('  cmpq rt_mstarted(%rip), %rcx');
  Line('  jne .msi_ret');
  Line('  cmpq $0, rt_nspinning(%rip)');
  Line('  jne .msi_ret');
  Line('  pushq %rax');
  Line('  call rt_anytimer');
  Line('  testq %rax, %rax');
  Line('  popq %rax');
  Line('  jnz .msi_ret');
  Line('  cmpq $0, rt_npollwait(%rip)');
  Line('  jne .msi_ret');
  Line('  cmpq $0, rt_maindone(%rip)');
  Line('  je .msi_live');
  Line('  cmpq $1, rt_nlive(%rip)');
  Line('  jbe .msi_ret');
  Line('.msi_live:');
  Line('  cmpq rt_msleep(%rip), %rax');
  Line('  jne .msi_ret');
  Line('  jmp rt_diedeadlock');
  Line('.msi_ret:');
  Line('  ret');
  Line('rt_msleepout:');
  Line('  movl $-1, %eax');
  Line('  lock xaddq %rax, rt_msleep(%rip)');
  Line('  ret');
  Line('');
