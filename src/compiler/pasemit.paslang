  Line('  ret');
  Line('.qg_empty:');
  Line('  mov x0, xzr');
  Line('  ret');
  { As on amd64: n - n/2, and the victim's runnext on the last spin
    round (M+72) after a short wait (P90). }
  { As on amd64: the batch is copied first and the victim's head moves
    after, with a CAS; head and tail are read with acquire and our tail
    is stored with release, as Go's runqgrab and runqput do (P98). }
  Line('rt_runqsteal:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  Line('  sub sp, sp, #1024');
  Line('.qs_retry:');
  Line('  add x9, x20, #16');
