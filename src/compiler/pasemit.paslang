  Line('  mov x0, x19');
  Line('  mov x1, #10');
  Line('  bl rt_fatalnum');
  Line('.fl_none:');
  Line('  ldr x19, [sp], #16');
  Line('  ldp x29, x30, [sp], #16');
  Line('  ret');
  Line('rt_diemsg:');
  Line('  mov x19, x0');
  Line('  bl rt_rawwrite');
  Line('  mov x0, x19');
  Line('  bl rt_fatalline');
  Line('rt_dieend:');
  LeaS('.Lnl', 'x1');
