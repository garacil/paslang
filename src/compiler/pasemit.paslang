  Line('  testq %rax, %rax');
  Line('  jg .tr_got');
  Line('  jz .tr_eof');
  Line('  cmpq $-11, %rax');
  Line('  jne .tr_eof');
  Line('  movq %rbx, %rdi');
  Line('  movq $1, %rsi');
  Line('  call rt_waitio');
  Line('  jmp .tr_loop');
  Line('.tr_got:');
  Line('  movq %r15, (%r13)');
  Line('  movq %rax, 8(%r13)');
  Line('  jmp .tr_out');
  Line('.tr_eof:');
  Line('  movq $0, (%r13)');
  Line('  movq $0, 8(%r13)');
  Line('.tr_out:');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('rt_tcpwrite:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  movq %rdi, %rbx');
  Line('  movq %rsi, %r12');
  Line('  movq %rdx, %r13');
  Line('  xorq %r15, %r15');
  Line('.tw_loop:');
  Line('  cmpq %r13, %r15');
  Line('  jae .tw_ok');
  { A socket write asks for no SIGPIPE (MSG_NOSIGNAL, 1.1.1): a peer that
    went away made the kernel raise it and the signal ended the whole
    program, where Go's net gets EPIPE back. A descriptor that is not a
    socket says ENOTSOCK to sendto and gets a plain write. }
  Line('  movq %rbx, %rdi');
  Line('  leaq (%r12, %r15), %rsi');
  Line('  movq %r13, %rdx');
  Line('  subq %r15, %rdx');
  Line('  movq $0x4000, %r10');
  Line('  xorq %r8, %r8');
  Line('  xorq %r9, %r9');
  Line('  movq $44, %rax');
  Line('  syscall');
  Line('  cmpq $-88, %rax');
  Line('  jne .tw_sent');
  Line('  movq %rbx, %rdi');
  Line('  leaq (%r12, %r15), %rsi');
  Line('  movq %r13, %rdx');
  Line('  subq %r15, %rdx');
  Line('  movq $1, %rax');
  Line('  syscall');
  Line('.tw_sent:');
  Line('  testq %rax, %rax');
  Line('  jg .tw_more');
  Line('  cmpq $-11, %rax');
  Line('  jne .tw_out');
  Line('  movq %rbx, %rdi');
  Line('  movq $4, %rsi');
  Line('  call rt_waitio');
  Line('  jmp .tw_loop');
  Line('.tw_more:');
  Line('  addq %rax, %r15');
  Line('  jmp .tw_loop');
  Line('.tw_ok:');
  Line('  movq %r15, %rax');
  Line('.tw_out:');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('rt_tcpclose:');
  Line('  pushq %rbx');
  Line('  movq %rdi, %rbx');
  Line('  subq $16, %rsp');
  Line('  movq rt_epfd(%rip), %rdi');
  Line('  movq $2, %rsi');
  Line('  movq %rbx, %rdx');
  Line('  movq %rsp, %r10');
  Line('  movq $233, %rax');
  Line('  syscall');
  Line('  addq $16, %rsp');
  Line('  movq %rbx, %rdi');
  Line('  movq $3, %rax');
  Line('  syscall');
  Line('  popq %rbx');
  Line('  ret');
  Line('');
  Line('.globl rt_gcount');
  Line('rt_gcount:');
  Line('  movq rt_nlive(%rip), %rax');
  Line('  ret');
  Line('.globl rt_nbreak');
  Line('rt_nbreak:');
  Line('  movq rt_nbreakv(%rip), %rax');
  Line('  ret');
  Line('.globl rt_breakpc');
  Line('rt_breakpc:');
  Line('  movq rt_breakpcv(%rip), %rax');
  Line('  ret');
  Line('.globl rt_break');
  Line('rt_break:');
  Line('  movq %r14, rt_breakg(%rip)');
  Line('  movq (%rsp), %rax');
  Line('  movq %rax, rt_breakpcv(%rip)');
  Line('  lock incq rt_nbreakv(%rip)');
  Line('  call rt_park');
  Line('  ret');
  Line('.globl rt_continue');
  Line('rt_continue:');
  Line('  movq rt_breakg(%rip), %rdi');
  Line('  testq %rdi, %rdi');
  Line('  jz .cb_done');
  Line('  call rt_ready');
  Line('.cb_done:');
  Line('  ret');
  Line('');
end;

procedure TEmitter.EmitChan;
begin
  { Chan: 0 lock, 8 closed, 16 recvq first/last, 32 sendq first/last.
    G+152 status (0 run,1 park,2 wait,3 ready), G+192 qnext, G+200 elem. }
  Line('.globl rt_raise');
  Line('rt_raise:');
  Line('  movq 224(%r14), %rax');
  Line('  testq %rax, %rax');
  Line('  jz rt_uncaught');
  Line('  movq (%rax), %rcx');
  Line('  movq %rcx, 224(%r14)');
  Line('  movq 8(%rax), %rbp');
  Line('  movq 16(%rax), %rsp');
  Line('  jmpq *24(%rax)');
  { No handler (1.0.147): a routine ends alone, as the manual says; the
    main routine ends the program with a line on stderr and status 1,
    where it left the scheduler with nothing to run and the deadlock
    message. }
  Line('rt_uncaught:');
  Line('  cmpq rt_maing(%rip), %r14');
  Line('  jne rt_goexit');
  Line('  leaq .Luncaught(%rip), %rsi');
  Line('  movq $44, %rdx');
  Line('  movq $2, %rdi');
  Line('  movq $1, %rax');
  Line('  syscall');
  Line('  movq $1, %rdi');
  Line('  call rt_exit');
  Line('');
  Line('.globl rt_makechan');
  { rt_makechan: rdi the buffer's capacity, 0 for none. A buffered
    channel (1.0.85) is 80 bytes: 48 the buffer, 56 its capacity, 64 the
    words in it, 72 the oldest one's index; it and the buffer are scanned
    word by word (GC word 1), the words being boxes, pointers or plain
    values. }
  Line('rt_makechan:');
  { A capacity below 0 or above ChanCapMax stops (1.0.136): -1 divided
    by zero in the heap, 2^60 followed nil, 2^61 wrote past the ring.
    Unsigned, one compare takes both. }
  Line('  cmpq $' + IntToStr(ChanCapMax) + ', %rdi');
  Line('  ja rt_diechancap');
  Line('  testq %rdi, %rdi');
  Line('  jnz .mc_buf');
  Line('  movq $64, %rdi');
  Line('  xorq %rsi, %rsi');
  Line('  call rt_alloc');
  Line('  ret');
  Line('.mc_buf:');
  Line('  pushq %rdi');
  Line('  movq $80, %rdi');
  Line('  movq $1, %rsi');
  Line('  call rt_alloc');
  Line('  popq %rcx');
  Line('  pushq %rax');
  Line('  pushq %rcx');
  Line('  leaq (,%rcx,8), %rdi');
  Line('  movq $1, %rsi');
  Line('  call rt_alloc');
  Line('  popq %rcx');
  Line('  popq %rdx');
  Line('  movq %rax, 48(%rdx)');
  Line('  movq %rcx, 56(%rdx)');
  Line('  movq $0, 64(%rdx)');
  Line('  movq $0, 72(%rdx)');
  Line('  movq %rdx, %rax');
  Line('  ret');
  Line('');
  { rt_chbput: rdi a locked channel, rsi a word. rax 1 when its buffer
    took the word, 0 when it has none or it is full. rcx, rdx, r8
    change. }
  Line('rt_chbput:');
  Line('  movq 48(%rdi), %r8');
  Line('  testq %r8, %r8');
  Line('  jz .cbp_no');
  Line('  movq 64(%rdi), %rcx');
  Line('  cmpq 56(%rdi), %rcx');
  Line('  jae .cbp_no');
  Line('  movq 72(%rdi), %rdx');
  Line('  addq %rcx, %rdx');
  Line('  cmpq 56(%rdi), %rdx');
  Line('  jb .cbp_in');
  Line('  subq 56(%rdi), %rdx');
  Line('.cbp_in:');
  Line('  movq %rsi, (%r8,%rdx,8)');
  Line('  incq %rcx');
  Line('  movq %rcx, 64(%rdi)');
  Line('  movq $1, %rax');
  Line('  ret');
  Line('.cbp_no:');
  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('');
  { rt_chbget: rdi a locked channel. rdx 1 and rax the oldest buffered
    word, or rdx 0 when the buffer is empty. A sender waiting for room
    moves its word in; its G comes back in rcx to ready once the lock is
    dropped (else 0). rsi, r8 change; rdi is kept. }
  Line('rt_chbget:');
  Line('  xorq %rcx, %rcx');
  Line('  xorq %rdx, %rdx');
  { The buffer first: an unbuffered channel is 64 bytes, its word 64
    belongs to the next block. }
  Line('  movq 48(%rdi), %r8');
  Line('  testq %r8, %r8');
  Line('  jz .cbg_none');
  Line('  movq 64(%rdi), %rdx');
  Line('  testq %rdx, %rdx');
  Line('  jz .cbg_none');
  Line('  movq 72(%rdi), %rsi');
  Line('  movq (%r8,%rsi,8), %rax');
  Line('  movq $0, (%r8,%rsi,8)');
  Line('  incq %rsi');
  Line('  cmpq 56(%rdi), %rsi');
  Line('  jb .cbg_h');
  Line('  xorq %rsi, %rsi');
  Line('.cbg_h:');
  Line('  movq %rsi, 72(%rdi)');
  Line('  decq 64(%rdi)');
  Line('  pushq %rax');
  Line('  pushq %rdi');
  Line('  addq $32, %rdi');
  Line('  call rt_cqtake');
  Line('  popq %rdi');
  Line('  xorq %rcx, %rcx');
  Line('  testq %rax, %rax');
  Line('  jz .cbg_done');
  Line('  movq 16(%rax), %rsi');
  Line('  movq 8(%rax), %rcx');
  Line('  movq 48(%rdi), %r8');
  Line('  movq 64(%rdi), %rdx');
  Line('  addq 72(%rdi), %rdx');
  Line('  cmpq 56(%rdi), %rdx');
  Line('  jb .cbg_t');
  Line('  subq 56(%rdi), %rdx');
  Line('.cbg_t:');
  Line('  movq %rsi, (%r8,%rdx,8)');
  Line('  incq 64(%rdi)');
  Line('.cbg_done:');
  Line('  popq %rax');
  Line('  movq $1, %rdx');
  Line('  ret');
  Line('.cbg_none:');
  Line('  ret');
  Line('');
  { Chan: 0 lock, 8 closed, 16/24 recvq first/last, 32/40 sendq first/last.
    A waiter is a 48-byte record on the waiting G's stack: 0 next, 8 G,
    16 elem (the value sent, or the value received), 24 sel (the select
    control block, or 0 for a plain send or recv), 32 arm. A select
    control block is 16 bytes on the selecting G's stack: 0 state (0 open,
    1 taken), 8 the waiter that won. rt_cqtake pops waiters and claims a
    select waiter with one CAS on its control block, so exactly one arm of
    a select fires, as in Go. Every park sets status 1 before the queue
    can see the waiter and parks through rt_parkmarked, so a wake that
    lands in between is kept. }
  { Chan: 0 lock, 8 closed, 16/24 recvq first/last, 32/40 sendq first/last.
    A waiter is a 48-byte record on the waiting G's stack: 0 next, 8 G,
    16 elem (the value sent, or the value received), 24 sel (the select
    control block, or 0 for a plain send or recv), 32 arm. A select
    control block is 16 bytes on the selecting G's stack: 0 state (0 open,
    1 taken), 8 the waiter that won. rt_cqtake pops waiters and claims a
    select waiter with one CAS on its control block, so exactly one arm of
    a select fires, as in Go. Every park sets status 1 before the queue
    can see the waiter and parks through rt_parkmarked, so a wake that
    lands in between is kept. }
  Line('rt_cqenq:');
  Line('  movq $0, (%rsi)');
  Line('  movq 8(%rdi), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .qe_empty');
  Line('  movq %rsi, (%rax)');
  Line('  movq %rsi, 8(%rdi)');
  Line('  ret');
  Line('.qe_empty:');
  Line('  movq %rsi, (%rdi)');
  Line('  movq %rsi, 8(%rdi)');
  Line('  ret');
  Line('');
  { rdi queue. rax: a claimed waiter, or 0. Clobbers rcx, rdx, r8. }
  Line('rt_cqtake:');
  Line('.qt_n:');
  Line('  movq (%rdi), %r8');
  Line('  testq %r8, %r8');
  Line('  jz .qt_none');
  Line('  movq (%r8), %rcx');
  Line('  movq %rcx, (%rdi)');
  Line('  testq %rcx, %rcx');
  Line('  jnz .qt_1');
  Line('  movq $0, 8(%rdi)');
  Line('.qt_1:');
  Line('  movq $0, (%r8)');
  Line('  movq 24(%r8), %rcx');
  Line('  testq %rcx, %rcx');
  Line('  jz .qt_ok');
  Line('  xorq %rax, %rax');
  Line('  movq $1, %rdx');
  Line('  lock cmpxchgq %rdx, (%rcx)');
  Line('  jne .qt_n');
  Line('  movq %r8, 8(%rcx)');
  Line('.qt_ok:');
  Line('  movq %r8, %rax');
  Line('  ret');
  Line('.qt_none:');
  Line('  xorq %rax, %rax');
  Line('  ret');
  Line('');
  { rdi queue, rsi waiter: unlink it if it is still queued. }
  Line('rt_cqremove:');
  Line('  xorq %rcx, %rcx');
  Line('  movq (%rdi), %rax');
  Line('.qr_n:');
  Line('  testq %rax, %rax');
  Line('  jz .qr_ret');
  Line('  cmpq %rsi, %rax');
  Line('  je .qr_hit');
  Line('  movq %rax, %rcx');
  Line('  movq (%rax), %rax');
  Line('  jmp .qr_n');
  Line('.qr_hit:');
  Line('  movq (%rsi), %rdx');
  Line('  testq %rcx, %rcx');
  Line('  jz .qr_first');
  Line('  movq %rdx, (%rcx)');
  Line('  jmp .qr_last');
  Line('.qr_first:');
  Line('  movq %rdx, (%rdi)');
  Line('.qr_last:');
  Line('  cmpq %rsi, 8(%rdi)');
  Line('  jne .qr_ret');
  Line('  movq %rcx, 8(%rdi)');
  Line('.qr_ret:');
  Line('  ret');
  Line('');
  { A readied routine goes to the runnext of the P of the M that readied
    it, so the M that parks next runs it without a thread switch, as
    Go's ready(next=true) does; an M without a P (inside a system call)
    uses the global queue (P90). }
  Line('rt_ready:');
  Line('  movl $1, %eax');
  Line('  movl $3, %ecx');
  Line('  lock cmpxchgl %ecx, 152(%rdi)');
  Line('  je .rd_done');
  Line('  movl $2, %eax');
  Line('  movl $3, %ecx');
  Line('  lock cmpxchgl %ecx, 152(%rdi)');
  Line('  jne .rd_done');
  Line('  pushq %rdi');
  Line('  call rt_curm');
  Line('  movq 8(%rax), %rax');
  Line('  popq %rsi');
  Line('  testq %rax, %rax');
  Line('  jz .rd_glob');
  Line('  movq %rax, %rdi');
  Line('  pushq %rsi');
  Line('  call rt_runqput');
  Line('  call rt_wakep');
  Line('  popq %rdi');
  Line('  ret');
  Line('.rd_glob:');
  Line('  pushq %rsi');
  Line('  movq %rsi, %rdi');
  Line('  call rt_globput');
  Line('  call rt_wakep');
  Line('  popq %rdi');
  Line('.rd_done:');
  Line('  ret');
  Line('');
  { A parked G may be resumed by another M, whose callee-saved registers
    hold that M's values. Every park therefore keeps rbx, r12, r13 and r15
    on the G stack and resumes through .pk_res, which pops them back.
    rt_waitio does the same on its own. }
  Line('rt_park:');
  Line('  movl $1, 152(%r14)');
  { rt_parkmarked: the caller already set status 1 before it checked its
    condition, so a wake that arrived meanwhile (status 3) is kept. }
  Line('rt_parkmarked:');
  Line('  popq %rax');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  pushq %rax');
  Line('  leaq .pk_res(%rip), %rax');
  Line('  movq %rax, 48(%r14)');
  Line('  movq %rsp, 40(%r14)');
  Line('  movq %rbp, 56(%r14)');
  Line('  movq 32(%r14), %r11');
  Line('  movl $1, %eax');
  Line('  movl $2, %ecx');
  Line('  lock cmpxchgl %ecx, 152(%r14)');
  Line('  jne .pk_run');
  Line('  movq %r11, %r13');
  Line('  movq 32(%r13), %rsp');
  Line('  xorq %rbp, %rbp');
  Line('  jmp rt_mloop');
  Line('.pk_run:');
  Line('  movl $0, 152(%r14)');
  Line('.pk_res:');
  Line('  popq %rax');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  jmpq *%rax');
  Line('');
  { G+176 is the id. G+232 is the sync-queue link. ParkUnlock marks the
    G waiting before it drops the lock, so a waker cannot lose the wake. }
  Line('rt_gid:');
  Line('  movq 176(%r14), %rax');
  Line('  ret');
  Line('rt_qwait:');
  Line('  movq (%rdi), %rax');
  Line('  movq %rax, 232(%r14)');
  Line('  movq %r14, (%rdi)');
  Line('  ret');
  { AtomicAdd, AtomicCas and Pause (P98): lock xadd, lock cmpxchg, pause. }
  Line('rt_xadd:');
  Line('  movq %rsi, %rax');
  Line('  lock xaddq %rax, (%rdi)');
  Line('  addq %rsi, %rax');
  Line('  ret');
  Line('rt_cas:');
  Line('  movq %rsi, %rax');
  Line('  lock cmpxchgq %rdx, (%rdi)');
  Line('  sete %al');
  Line('  movzbq %al, %rax');
  Line('  ret');
  { The bit words on memory (P105, 1.0.118): rt_bitget reads bit rsi
    of the rdx bits at rdi, or goes to rt_bitfail with the caller's
    return address still on top; rt_popcntmem, rt_ctzmem and rt_clzmem
    count over rsi bytes (the lowest bit is bit 0 of the first byte, the
    highest bit 7 of the last); rt_getbits and rt_setbits move rdx bits
    from bit rsi one at a time; rt_abitset and rt_abitclr change one bit
    with lock cmpxchgb on its byte alone and give the bit it had. }
  { Logic on whole blocks (P105, 1.0.120). rt_blockop: rdi the result,
    rsi and rdx the two blocks (or rdx a word repeated, op bit 5), rcx
    bytes, r8 the operation: bits 0-1 and, or, xor; bit 2 not after;
    bit 3 not of the second first (andnot); bit 4 not of the first
    alone. Eight bytes a step, then one. rt_strblock: two strings of one
    length (rt_blockfail says logic on N and M bytes at line L
    otherwise) into a new one. }
  Line('rt_blockop:');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  movq %rcx, %rbx');
  Line('  movq %r8, %r12');
  Line('  xorl %r9d, %r9d');
  Line('.bo_q:');
  Line('  leaq 8(%r9), %rax');
  Line('  cmpq %rbx, %rax');
  Line('  ja .bo_b');
  Line('  movq (%rsi,%r9), %r10');
  Line('  movq %rdx, %r11');
  Line('  testl $32, %r12d');
  Line('  jnz .bo_qp');
  Line('  movq (%rdx,%r9), %r11');
  Line('.bo_qp:');
  Line('  call .bo_op');
  Line('  movq %r10, (%rdi,%r9)');
  Line('  addq $8, %r9');
  Line('  jmp .bo_q');
  Line('.bo_b:');
  Line('  cmpq %rbx, %r9');
  Line('  jae .bo_d');
  Line('  movzbl (%rsi,%r9), %r10d');
  Line('  testl $32, %r12d');
  Line('  jnz .bo_bp');
  Line('  movzbl (%rdx,%r9), %r11d');
  Line('  jmp .bo_bb');
  Line('.bo_bp:');
  Line('  movl %r9d, %ecx');
  Line('  andl $7, %ecx');
  Line('  shll $3, %ecx');
  Line('  movq %rdx, %r11');
  Line('  shrq %cl, %r11');
  Line('  andl $255, %r11d');
  Line('.bo_bb:');
  Line('  call .bo_op');
  Line('  movb %r10b, (%rdi,%r9)');
  Line('  incq %r9');
  Line('  jmp .bo_b');
  Line('.bo_d:');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('.bo_op:');
  Line('  testl $16, %r12d');
  Line('  jz .bo_o1');
  Line('  notq %r10');
  Line('  ret');
  Line('.bo_o1:');
  Line('  testl $8, %r12d');
  Line('  jz .bo_o2');
  Line('  notq %r11');
  Line('.bo_o2:');
  Line('  movl %r12d, %eax');
  Line('  andl $3, %eax');
  Line('  cmpl $1, %eax');
  Line('  je .bo_or');
  Line('  cmpl $2, %eax');
  Line('  je .bo_xor');
  Line('  andq %r11, %r10');
  Line('  jmp .bo_inv');
  Line('.bo_or:');
  Line('  orq %r11, %r10');
  Line('  jmp .bo_inv');
  Line('.bo_xor:');
  Line('  xorq %r11, %r10');
  Line('.bo_inv:');
  Line('  testl $4, %r12d');
  Line('  jz .bo_r');
  Line('  notq %r10');
  Line('.bo_r:');
  Line('  ret');
  Line('rt_strblock:');
  Line('  movq 8(%rdi), %rax');
  Line('  movq 8(%rsi), %rcx');
  Line('  cmpq %rcx, %rax');
  Line('  je .sbk_ok');
  Line('  movq %rax, %rdi');
  Line('  movq %rcx, %rsi');
  Line('  jmp rt_blockfail');
  Line('.sbk_ok:');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %rbx');
  Line('  pushq %r15');
  Line('  movq (%rdi), %r12');
  Line('  movq (%rsi), %r13');
  Line('  movq %rax, %rbx');
  Line('  movq %rdx, %r15');
  Line('  movq %rbx, %rdi');
  Line('  call rt_stralloc');
  Line('  pushq %rax');
  Line('  movq %rax, %rdi');
  Line('  movq %r12, %rsi');
  Line('  movq %r13, %rdx');
  Line('  movq %rbx, %rcx');
  Line('  movq %r15, %r8');
  Line('  call rt_blockop');
  Line('  popq %rax');
  Line('  movq %rbx, %rdx');
