  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  { rt_strappend as on amd64 (P242): x0 the place's address, x1 and x2
    the string read from it, x3 and x4 x; the new string is stored in
    the place and left in x0 and x2. The byte before the characters:
    TBNZ tests the mark, bit 0, without the flags (ARM ARM C6.2.478),
    LSR by 1 (UBFM, C6.2.273) leaves the class, which CBZ sends to a new
    block when it is 0; the class's bytes by LDR (register) scaled by 8
    (C6.2.218) from rt_class2size, rt_strbig right after it. rt_memcpy
    keeps x4 and up. }
  Line('rt_strappend:');
  Line('  cbz x4, .asp_same');
  Line('  ldp x9, x10, [x0]');
  Line('  cmp x9, x1');
  Line('  b.ne .asp_new');
  Line('  cmp x10, x2');
  Line('  b.ne .asp_new');
  Line('  cbz x2, .asp_new');
  Line('  ldurb w9, [x1, #-1]');
  Line('  tbnz w9, #0, .asp_new');
  Line('  lsr w9, w9, #1');
  Line('  cbz w9, .asp_new');
  LeaS('rt_class2size', 'x10');
  Line('  ldr x10, [x10, x9, lsl #3]');
  Line('  add x11, x2, x4');
  Line('  add x11, x11, #1');
  Line('  cmp x11, x10');
  Line('  b.hi .asp_more');
  Line('.asp_place:');
  Line('  stp x1, x30, [sp, #-16]!');
  Line('  mov x12, x0');
  Line('  add x9, x2, x4');
  Line('  add x0, x1, x2');
  Line('  mov x1, x3');
  Line('  mov x2, x4');
  Line('  bl rt_memcpy');
  Line('  ldp x0, x30, [sp], #16');
  Line('  mov x2, x9');
  Line('  str x2, [x12, #8]');
  Line('  ret');
  Line('.asp_same:');
  Line('  stp x1, x2, [x0]');
  Line('  mov x0, x1');
  Line('  ret');
