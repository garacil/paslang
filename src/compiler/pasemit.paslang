{$mode objfpc}{$H+}

unit pasemit;

interface

uses
  pasast;

function EmitAmd64(const Prog: TProgram): string;
function EmitArm64(const Prog: TProgram): string;

implementation

uses
  paslib;

const
  { Texts of the fatal runtime errors (P86). The runtime writes them to
    standard error with raw system calls, adds " at line N" when the
    faulting or calling pc is inside the program, and exits 1 as every
    runtime error does. The sites take their lengths from these strings,
    so a text and its count cannot drift apart. }
  MsgFatal = 'paslang: fatal runtime error';
  MsgOom = 'paslang: out of memory: ';
  MsgMib = ' MiB mapped';
  MsgMmap = 'paslang: mmap failed';
  MsgTooBig = 'paslang: allocation too large';
  MsgEpoll = 'paslang: epoll_create failed';
  MsgStack = 'paslang: stack overflow';
  MsgSendClosed = 'paslang: send on closed channel';
  MsgCloseClosed = 'paslang: close of closed channel';
  MsgCloseSender = 'paslang: close of a channel with a waiting sender';
  MsgMapRW = 'paslang: concurrent map read and map write';
  MsgClone = 'paslang: clone failed';
  MsgIndex = 'paslang: index ';
  MsgBit = 'paslang: bit ';
  MsgBlk1 = 'paslang: logic on ';
  MsgBlk2 = ' and ';
  MsgBlk3 = ' bytes';
  MsgFun1 = 'paslang: a funnel of ';
  MsgDivOver = 'paslang: 128-bit division overflow';
  MsgOutOfRange = ' out of range [';
  MsgNil = 'paslang: nil pointer dereference';
  MsgBadAddr = 'paslang: invalid memory address 0x';
  MsgDivZero = 'paslang: integer divide by zero';
  MsgPtrOut = 'paslang: pointer outside its object';
  MsgRealRange = 'paslang: real out of integer range';
  MsgIntOvf = 'paslang: integer overflow';
  MsgBus = 'paslang: bus error';
  MsgDeadlock = 'paslang: all routines are asleep: deadlock';
  MsgAtLine = ' at line ';
  MsgAtPc = ' at pc 0x';
  MsgOomStack = 'paslang: out of stack memory: ';
  MsgChanCap = 'paslang: channel capacity ';
  MsgChanCap2 = ' out of range';
  MsgAddr = ' addr 0x';
  MsgSp = ' sp 0x';

function GasEscape(const S: string): string;
var
  i: SizeInt;
  c: Byte;
begin
  Result := '';
  for i := 1 to Length(S) do
  begin
    c := Byte(S[i]);
    if (c >= 32) and (c <= 126) and (c <> Ord('\')) and (c <> Ord('"')) then
      Result := Result + S[i]
    else
      Result := Result + '\' + Char(Ord('0') + (c shr 6)) +
        Char(Ord('0') + ((c shr 3) and 7)) + Char(Ord('0') + (c and 7));
  end;
end;

function ArgReg(I: LongInt): string;
begin
  case I of
    0: Result := 'rdi';
    1: Result := 'rsi';
    2: Result := 'rdx';
    3: Result := 'rcx';
    4: Result := 'r8';
    5: Result := 'r9';
  else
    Result := 'rdi';
  end;
end;

function ProcLabel(const N: string): string;
begin
  Result := 'p_' + ToLower(N);
end;

function VarLabel(const N: string): string;
begin
  Result := 'v_' + ToLower(N);
end;

{ The name a global goes by in the assembly: a unit's global is
  unit.Name, the same in every object that names it (1.0.76). }
function GlobName(const V: TVarDecl): string;
begin
  if V.Sym <> '' then
    Result := V.Sym
  else
    Result := V.Name;
end;

function Align8(N: LongInt): LongInt;
begin
  Result := (N + 7) and (-8);
  if Result < 8 then
    Result := 8;
end;

type
  TSym = record
    Name: string;
    Off: LongInt;
    Global: Boolean;
    Typ: LongInt;
    Up: LongInt;
    ByRef: Boolean;
    Reg: string;      { the register a loop keeps the variable in (P93), '' in memory }
    Boxed: Boolean;   { in its routine's heap box at BoxOff; its slot holds the field's address (1.0.134) }
    BoxOff: LongInt;
  end;

  { A variable a loop keeps in a register (P93): its home in memory, the
    register, whether the loop writes it, how often the loop names it
    (weighted by depth) and the frame slot that keeps the register's
    previous value. }
  { A V128 or V256 variable a region keeps in vector registers (P107,
    1.0.128): R0, and R1 for a V256's high half where it takes two; on
    amd64 a V256 in AVX2's copy of the region is ymm R0. }
  TVPromo = record
    Place: TSym;
    Typ: LongInt;
    R0, R1: LongInt;
    Written: Boolean;
    Bad: Boolean;
    Refs: LongInt;
  end;

  TPromo = record
    Place: TSym;
    Reg: string;
    Dw: LongInt;
    Written: Boolean;
    Refs: LongInt;
    Save: LongInt;
    Keep: Boolean;    { a callee-saved register: its caller's value is kept in Save }
    Part: LongInt;    { 0 the variable; 1 a slice's pointer word, 2 its length (P100) }
  end;

  { An index EmitFor proved in range for a whole run of a for (P100):
    counter + C into a static array Lo..Hi (Arr empty) or into the slice
    Arr, whose length the loop keeps in register Len. }
  TProof = record
    Arr: string;
    Len: string;
    Lo, Hi, C: Int64;
  end;

  { One flag per word of a type: the word holds a heap pointer (P95a). }
  TGcBits = array of Boolean;

  { Where a local lives in a register, for its DWARF location list. }
  TLocRange = record
    Proc: string;
    Off: LongInt;
    Dw: LongInt;
    B, E: string;
  end;

  { A call site of compiled code (P95c): the label after the call and
    what the frame holds there besides the routine's own typed words: the
    words pushed below the frame (a class per word, the first pushed
    first), the scratch words the statement took (offset from the frame
    pointer, class), and the bytes of register save slots a promoted
    region keeps under ScratchOff. A class is 0 for a word without a
    pointer, 1 for a pointer, 2 for a word nobody knows, which the
    collector reads as a candidate. Kind 1 is a prologue's stack check,
    before the routine has a frame. }
  TInt64Arr = array of Int64;

  TMapSite = record
    Lab: string;
    Kind: LongInt;
    Pushed: array of Byte;
    ScrOff: array of LongInt;
    ScrK: array of Byte;
    Pinned: LongInt;
    PinTop: LongInt;
  end;

  TEmitter = class
  private
    FOut: string;
    FLen: SizeInt;
    FLab: LongInt;
    FAddrWrite: Boolean;  { the next EmitAddr is for a write: a string's characters become its own (1.0.82) }
    FStoreSrc: PExpr;     { the value StoreTo stores, when the statement knows it (1.0.82) }
    FStrMaps: array of LongInt;  { the types whose string maps .rodata carries (1.0.82) }
    FZeroMax: LongInt;    { the biggest record a closed channel gives as zero (.Lzeroblk, 1.0.83) }
    FSym: array of TSym;
    FFrame: LongInt;
    FStrs: array of string;
    FTypes: TTypeDefArray;
    FResName: string;
    FResOff: LongInt;
    FHasRes: Boolean;
    FResTyp: LongInt;
    FNest: LongInt;
    FBoxSlot: LongInt;
    FObjReady: Boolean;  { EmitArmMeth: an interface's code and Self in x0, x2 (1.0.135) }  { the frame slot of the routine's box, 0 when it has none (1.0.134) }
    FProcSyms: array of string;
    FProcNests: array of LongInt;
    FOwnNames: array of string;
    FOwnEnds: array of string;
    FOwnPas: array of string;
    FOwnSyms: array of array of TSym;
    FArm: Boolean;
    FSrc: string;
    FCurLine: LongInt;
    FLineLabs: array of string;
    FLineNums: array of LongInt;
    FBrk: array of string;
    FCont: array of string;
    FTryFin: array of PStmt;
    FTryDep: array of LongInt;
    FEpi: string;
    FScratchOff: LongInt;
    FScratchCur: LongInt;
    FVecItems: TExprArray;    { the operands the first phase of a vector statement pushed (1.0.125) }
    FVecN: LongInt;
    FVecScr: LongInt;         { 48 bytes for VShuffle8 on a processor without SSSE3 (1.0.126) }
    FVecDirect: Boolean;      { the statement has no first phase: its operands are computed where they are loaded (1.0.128) }
    FVecRootE: PExpr;         { the statement's tree, whose last instruction may write the promoted destination }
    FVecDestE: PExpr;         { that destination, a promoted variable, or nil }
    FVecRootDone: Boolean;    { the tree wrote it: no move after }
    FVPromo: array of TVPromo; { the vector variables the region keeps in registers (1.0.128) }
    FVCand: array of TVPromo;
    FVecTop: LongInt;         { amd64: xmm registers the region's variables take from xmm15 down }
    FVecCopy: LongInt;        { amd64: 0, or the region's copy for AVX2 (1) or for SSE2 (2) }
    FVecNeed: LongInt;        { the registers the region's deepest vector tree needs; 0 when it has none }
    FVecCLane: array of LongInt;  { the vector constants of VSplat on amd64: 32 bytes each (1.0.128) }
    FVecCVal: array of Int64;
    FScratchMax: LongInt;   { the high-water mark of the scratch area of this routine }
    FFrameSym: string;      { the .set symbol that carries the frame size, defined after the body }
    FSkipCanon: Boolean;    { EmitOrdTo's top node feeds a store of its own width: no cleanup (P100) }
    FNoCheck: Boolean;      { EmitWordMem's element was just checked by the same statement (P100) }
    FChunkReg: string;
    FR8Lent: Boolean;   { a region of integer arithmetic keeps a variable in r8 (1.1.1) }
    FCarrySym: TSym;    { the place Carry's register is loaded from and stored to (1.0.130) }      { the end of an innermost for's run of 1024, in a promoted region (P100) }
    FChunkSave: LongInt;    { its caller value's frame slot when the register is a kept one, else 0 }
    FChunkDw: LongInt;      { its DWARF number, for the CFI of that slot }
    FWmBase: string;        { arm64: EmitWordMem's operand is [FWmBase, FWmIdx, lsl #FWmSh] }
    FCheckPtr: Boolean;     { -checkptr: pointer steps and accesses held to their object (P104) }
    FCpuSet: Int64;         { -cpu: the processor the code is compiled for (P111): its bits choose the instructions, nothing is tested at run time }
    FProvOn: Boolean;       { EmitFor emits a run's body whose indexes FProv proved (P100) }
    FStrFill: string;       { StrFillLoop: the string whose characters the loop owns, '' for none (1.1.1) }
    FStrFillCtr: string;    { and the loop's counter }
    FLastAsgName: string;   { the variable the last assignment emitted wrote: a for's hidden limit comes just before it }
    FLastAsgE: PExpr;       { and its value }
    FProvCtr: string;       { that loop's counter }
    FProvNarrow: Boolean;   { a narrow counter: only the counter itself, i + c wraps }
    FProv: array of TProof;
    FWmIdx: string;         { or [FWmBase, #FWmOff]; EmitWordBase adds them up (P100) }
    FWmSh: LongInt;
    FWmOff: Int64;
    FFatWritten: TStrArray; { the slices a region being scanned assigns (P100) }
    FPinned: LongInt;       { scratch bytes a promoted loop keeps for the registers it saves (P93) }
    FPromoOn: Boolean;      { a loop is being emitted with variables in registers (P93) }
    FPromo: array of TPromo;
    FResReg: string;        { the register Result lives in while a loop keeps it there }
    FAddrNames: array of string; { lower-case names whose address is taken in this compilation }
    FLocAddr: array of string; { those taken in the routine being emitted and the routines nested in it (1.0.128) }
    FAddrKept: TStrArray;   { of those, the addresses that may be kept: not only passed to SetLength, Move or FillChar (P100) }
    FIsUnit: Boolean;
    FExtVars: TStrArray;    { the globals of other units, lowered (1.0.136) }
    FCurProc: string;
    FOwnSec: string;        { the routine whose own text section is open (1.1.1: a section per routine, so the linker drops the ones no program uses) }
    FDebug: Boolean;        { -debug (P118): a call of the debugger at every statement, the tables of section pasdbg }
    FDbgFn: string;         { the routine the statements belong to, for the hook: its start label }
    FDbgLine: LongInt;      { the first line the routine being emitted has seen }
    FMainLine: LongInt;
    FOwnLine: array of LongInt;
    FLocRanges: array of TLocRange;
    FStubs: string;         { the slow paths of a promoted loop's checks, placed after it }
    FLastIns: string;       { the last instruction emitted, when nothing that a jump reaches came after it (P96) }
    FProgProcs: TProcArray; { every routine of the compilation, to find a routine's nested ones }
    FTmpStmts: TStmtArray;
    FSawDump: Boolean;      { CollectNames met a DumpLocals, which reads every local }
    FGcTypes: array of LongInt;  { types whose GC descriptor this object file writes (P95a) }
    FGcInst: array of LongInt;   { classes whose instance descriptor it writes }
    FRootWords: array of string; { the GC word of each global, '0' without a pointer (P95b) }
    { Stack maps (P95c). }
    FMapOn: Boolean;          { a compiled routine's frame is set up: a call gets a map }
    FMapPro: Boolean;         { a prologue's stack check: a call is a site of kind 1 }
    FMapSpOk: Boolean;        { the next write of the stack pointer is accounted for by the caller }
    FMapSites: array of TMapSite;
    FPushK: array of Byte;    { the words below the frame, the first pushed first }
    FPushHint: array of Byte; { classes of the words of the next push, lowest address first }
    FScrOff: array of LongInt; { the scratch words the statement took, from the frame pointer }
    FScrK: array of Byte;
    FScrHint: Byte;           { the class of the words of the next Scratch }
    FScrHintW: array of Byte; { or the class of each of them (ScratchT) }
    FLocOff: array of LongInt; { the routine's typed words: locals, parameters, Result, link }
    FLocK: array of Byte;
    FX16: Int64;              { arm64: x16 as the last ldr =imm set it, -1 when unknown }
    FTryPush: array of LongInt; { the words pushed when each open try began }
    FMapOut: array of string; { the entries of section pasgcmaps }
    FMapOutN: SizeInt;
    FDescOut: array of string; { the descriptors, one string each }
    FDescN: SizeInt;
    FDescHash: array of LongInt; { open addressing over FDescOut, -1 empty }
    FMapLab: LongInt;
    procedure Line(const S: string);
    function ForwardLoad(const S: string; out Drop: Boolean): string;
    procedure NoteLine(const S: string);
    procedure MapNote(const S: string);
    procedure MapSite;
    procedure MapPush(Words: LongInt; Pad: Boolean);
