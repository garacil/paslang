  Line('  sub x0, x0, #1');
  Line('  b rt_diecloseclosed');
  Line('rt_trysend:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
