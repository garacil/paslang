    waiter with one CAS. Locks are ldaxr/stxr to take and stlr to drop.
    x21 is the M and is never touched; x19, x20, x22, x23, x24 hold the
    state across the park. }
  Line('rt_cqenq:');
  Line('  str xzr, [x1]');
  Line('  ldr x9, [x0, #8]');
  Line('  cbz x9, .aqe_empty');
  Line('  str x1, [x9]');
  Line('  str x1, [x0, #8]');
  Line('  ret');
  Line('.aqe_empty:');
  Line('  str x1, [x0]');
  Line('  str x1, [x0, #8]');
  Line('  ret');
  Line('rt_cqtake:');
  Line('.aqt_n:');
  Line('  ldr x9, [x0]');
  Line('  cbz x9, .aqt_none');
  Line('  ldr x10, [x9]');
  Line('  str x10, [x0]');
  Line('  cbnz x10, .aqt_1');
  Line('  str xzr, [x0, #8]');
  Line('.aqt_1:');
  Line('  str xzr, [x9]');
  Line('  ldr x10, [x9, #24]');
  Line('  cbz x10, .aqt_ok');
  Line('.aqt_cas:');
  Line('  ldaxr x11, [x10]');
  Line('  cbnz x11, .aqt_lost');
  Line('  mov x12, #1');
  Line('  stxr w11, x12, [x10]');
  Line('  cbnz w11, .aqt_cas');
  Line('  str x9, [x10, #8]');
  Line('  b .aqt_ok');
  Line('.aqt_lost:');
  Line('  clrex');
  Line('  b .aqt_n');
  Line('.aqt_ok:');
  Line('  mov x0, x9');
  Line('  ret');
  Line('.aqt_none:');
  Line('  mov x0, xzr');
  Line('  ret');
  Line('rt_cqremove:');
  Line('  mov x9, xzr');
  Line('  ldr x10, [x0]');
  Line('.aqr_n:');
  Line('  cbz x10, .aqr_ret');
  Line('  cmp x10, x1');
  Line('  b.eq .aqr_hit');
  Line('  mov x9, x10');
  Line('  ldr x10, [x10]');
  Line('  b .aqr_n');
  Line('.aqr_hit:');
  Line('  ldr x11, [x1]');
  Line('  cbz x9, .aqr_first');
  Line('  str x11, [x9]');
  Line('  b .aqr_last');
  Line('.aqr_first:');
  Line('  str x11, [x0]');
  Line('.aqr_last:');
  Line('  ldr x10, [x0, #8]');
  Line('  cmp x10, x1');
  Line('  b.ne .aqr_ret');
  Line('  str x9, [x0, #8]');
  Line('.aqr_ret:');
  Line('  ret');
  Line('rt_chansend:');
  Line('  str x30, [sp, #-16]!');
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  mov x19, x0');
  Line('  mov x20, x1');
  Line('.acs_lock:');
  Line('  ldaxr w9, [x19]');
  Line('  cbnz w9, .acs_lock');
  Line('  mov w10, #1');
  Line('  stxr w11, w10, [x19]');
  Line('  cbnz w11, .acs_lock');
  Line('  ldr x9, [x19, #8]');
  Line('  cbnz x9, .acs_die');
  Line('  add x0, x19, #16');
  Line('  bl rt_cqtake');
  Line('  cbz x0, .acs_buf');
  Line('  str x20, [x0, #16]');
  Line('  ldr x0, [x0, #8]');
  Line('  stlr wzr, [x19]');
  Line('  bl rt_ready');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.acs_buf:');
  Line('  mov x0, x19');
  Line('  mov x1, x20');
  Line('  bl rt_chbput');
  Line('  cbz x0, .acs_park');
  Line('  stlr wzr, [x19]');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
  Line('.acs_park:');
  Line('  sub sp, sp, #48');
  Line('  str x28, [sp, #8]');
  Line('  str x20, [sp, #16]');
  Line('  str xzr, [sp, #24]');
  Line('  mov w9, #1');
