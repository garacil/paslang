  Line('  add w10, w2, w8');
  Line('  and w10, w10, #255');
  Line('  add x11, x19, x10, lsl #3');
  Line('  ldr x12, [x11, #40]');
  Line('  add w13, w8, #1');
  Line('  cmp w13, w4');
  Line('  b.eq .qps_last');
  Line('  add w10, w2, w13');
  Line('  and w10, w10, #255');
  Line('  add x11, x19, x10, lsl #3');
  Line('  ldr x14, [x11, #40]');
  Line('  str x14, [x12, #64]');
  Line('  mov w8, w13');
  Line('  b .qps_link');
  Line('.qps_last:');
  Line('  str x20, [x12, #64]');
