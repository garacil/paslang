  Line('  movq (%rcx), %rax');
  Line('  movq %rax, 232(%r14)');
  Line('  movq %r14, (%rcx)');
  Line('  testq %rax, %rax');
  Line('  jnz .wfr_cas');
  Line('  movq %r14, 8(%rcx)');
  Line('.wfr_cas:');
  Line('  movq %rsi, %rax');
  Line('  lock cmpxchgq %rdx, (%rdi)');
  Line('  jne .wfr_undo');
  Line('  movq $1, %rax');
  Line('  ret');
  Line('.wfr_undo:');
