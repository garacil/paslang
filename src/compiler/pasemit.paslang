  { rt_qsplice: rdi and rsi two-word queues; everything in rsi goes to
    the end of rdi, and rsi is left empty. }
  { The parking of the mutex without a lock (P98). A new waiter counts
    itself in the state word and pushes itself on a stack of arrivals
    with one CAS each (rt_waitpush); only one routine at a time takes
    waiters out (the one holding the mutex's woken bit, or the owner in
    starvation mode), so the queue it serves from is its own: when that
    queue is empty it takes the whole stack with one xchg and turns it
    into arrival order (rt_waittake). A woken waiter that lost the race
    still holds that right and goes back to the front itself before it
    counts itself again (rt_waitfront). Each routine is marked about to
    park (status 1) before anyone can find it, and parks with
    rt_parkmarked, so a wake that comes first is kept.
    rt_waitpush: rdi state, rsi old, rdx new, rcx stack; CAS the state
    and push the current routine, or 0 when the state had changed. }
  Line('rt_waitpush:');
  Line('  movq %rsi, %rax');
  Line('  lock cmpxchgq %rdx, (%rdi)');
  Line('  jne .wpu_no');
  Line('  movl $1, 152(%r14)');
  Line('.wpu_push:');
  Line('  movq (%rcx), %rax');
  Line('  movq %rax, 232(%r14)');
  Line('  lock cmpxchgq %r14, (%rcx)');
  Line('  jne .wpu_push');
  Line('  movq $1, %rax');
  Line('  ret');
  Line('.wpu_no:');
  Line('  xorq %rax, %rax');
  Line('  ret');
  { rt_waitfront: rdi state, rsi old, rdx new, rcx queue (first, last);
    the current routine to the front, then the CAS; undone if it fails. }
  Line('rt_waitfront:');
  Line('  movl $1, 152(%r14)');
  Line('  movq (%rcx), %rax');
  Line('  movq %rax, 232(%r14)');
  Line('  movq %r14, (%rcx)');
  Line('  testq %rax, %rax');
  Line('  jnz .wfr_cas');
  Line('  movq %r14, 8(%rcx)');
  Line('.wfr_cas:');
  Line('  movq %rsi, %rax');
  Line('  lock cmpxchgq %rdx, (%rdi)');
  Line('  jne .wfr_undo');
  Line('  movq $1, %rax');
  Line('  ret');
  Line('.wfr_undo:');
  Line('  movq 232(%r14), %rax');
  Line('  movq %rax, (%rcx)');
  Line('  testq %rax, %rax');
  Line('  jnz .wfr_u2');
  Line('  movq $0, 8(%rcx)');
  Line('.wfr_u2:');
  Line('  movq $0, 232(%r14)');
  Line('  movl $0, 152(%r14)');
  Line('  xorq %rax, %rax');
  Line('  ret');
