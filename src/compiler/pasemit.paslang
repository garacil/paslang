  else if Op = 'maxs8' then
    Result := 'vpmaxsb'
  else if Op = 'minu16' then
    Result := 'vpminuw'
  else if Op = 'maxu16' then
    Result := 'vpmaxuw'
  else if Op = 'minu32' then
    Result := 'vpminud'
  else if Op = 'maxu32' then
    Result := 'vpmaxud'
  else if Op = 'mins32' then
