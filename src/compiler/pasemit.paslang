  Line('  movl 16(%r12), %r9d');
  Line('  movl 20(%r12), %ecx');
  Line('  movl %ecx, %edx');
  Line('  subl %r9d, %edx');
  Line('  movl %edx, %r8d');
  Line('  shrl $1, %r8d');
  Line('  subl %r8d, %edx');
  Line('  testl %edx, %edx');
  Line('  jz .qs_next');
  Line('  cmpl $128, %edx');
  Line('  ja .qs_retry');
  Line('  xorl %r10d, %r10d');
