  Line('  cmp w10, w5');
  Line('  b.hs .qs_got');
  Line('  ldr x12, [sp, x10, lsl #3]');
  Line('  ldr w13, [x19, #20]');
  Line('  and w14, w13, #255');
  Line('  add x9, x19, x14, lsl #3');
  Line('  str x12, [x9, #40]');
  Line('  add w13, w13, #1');
  Line('  add x9, x19, #20');
  Line('  stlr w13, [x9]');
  Line('  add w10, w10, #1');
  Line('  b .qs_put');
  Line('.qs_got:');
  Line('  mov x0, x7');
  Line('  add sp, sp, #1024');
  Line('  ldp x19, x20, [sp], #16');
  Line('  ldr x30, [sp], #16');
