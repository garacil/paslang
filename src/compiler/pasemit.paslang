  Line('  cmpq $0, 264(%r14)');
  Line('  je .wi_nt');
  Line('  call rt_tgone');
  Line('  movq $0, 264(%r14)');
  Line('.wi_nt:');
  Line('  lock decq rt_npollwait(%rip)');
  Line('  movq (%rsp), %rax');
  Line('  addq $16, %rsp');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
