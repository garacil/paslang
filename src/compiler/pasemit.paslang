  Line('  sub x2, x29, #1');
  Line('  strb wzr, [x2]');
  Line('  cmp x1, #0');
  Line('  b.ge .wi_pos');
  Line('  neg x1, x1');
  Line('  mov x3, #1');
  Line('  b .wi_loop');
