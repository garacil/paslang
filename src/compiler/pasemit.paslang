  Line('  add x9, x20, #20');
  Line('  ldar w4, [x9]');
  Line('  sub w5, w4, w3');
  Line('  lsr w6, w5, #1');
  Line('  sub w5, w5, w6');
  Line('  cbz w5, .qs_next');
  Line('  cmp w5, #128');
  Line('  b.hi .qs_retry');
  Line('  mov w10, wzr');
  Line('.qs_copy:');
  Line('  add w11, w3, w10');
  Line('  and w11, w11, #255');
  Line('  add x9, x20, x11, lsl #3');
  Line('  ldr x12, [x9, #40]');
  Line('  str x12, [sp, x10, lsl #3]');
  Line('  add w10, w10, #1');
  Line('  cmp w10, w5');
  Line('  b.lo .qs_copy');
  Line('  add w8, w3, w5');
  Line('  add x9, x20, #16');
  Line('.qs_cas:');
  Line('  ldaxr w11, [x9]');
  Line('  cmp w11, w3');
  Line('  b.ne .qs_clr');
  Line('  stlxr w12, w8, [x9]');
  Line('  cbnz w12, .qs_cas');
  Line('  ldr x7, [sp]');
  Line('  mov w10, #1');
