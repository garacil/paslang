  Line('  mov x19, x2');
  Line('  mov x20, x0');
  LeaS('rt_gflock', 'x0');
  Line('  bl rt_unlock');
  Line('  add x9, x20, #288');
  Line('  str x9, [x20]');
  Line('  str x19, [x20, #8]');
  Line('  str x9, [x20, #16]');
  Line('  str x9, [x20, #24]');
  Line('  mov x0, x20');
  Line('  bl rt_allgadd');
  Ppop('x20');
  Ppop('x19');
  Line('  ldr x30, [sp], #16');
