  else if Op = 'subf64' then
    Result := 'vsubpd'
  else if Op = 'mulf32' then
    Result := 'vmulps'
  else if Op = 'mulf64' then
    Result := 'vmulpd'
  else if Op = 'divf32' then
    Result := 'vdivps'
  else if Op = 'divf64' then
