    Line('  .ascii "paslang: arccos domain"');
    Line('.Lpndom:');
    Line('  .ascii "paslang: power domain"');
    Line('.Llogdom:');
    Line('  .ascii "paslang: log domain"');
    Line('  .balign 8');
    Line('.Linv2pi:');
    Line('  .quad 4594902181429758083');
    Line('.Ltwopi:');
    Line('  .quad 4618760256179416344');
    Line('.Ltiny:');
    Line('  .quad 4512825593480736141');
    Line('.Lln2:');
    Line('  .quad 4604418534313441775');
    Line('.Linvln2:');
    Line('  .quad 4609176140021203710');
    Line('.Linvln10:');
    Line('  .quad 4601495173785380109');
    Line('.Lsnap:');
    Line('  .quad 4472406533629990549');
    Line('.Lexpbig:');
    Line('  .quad 4650248090236747776');
    Line('.Lpi2:');
    Line('  .quad 4609753056924675352');
    Line('.Lpi4:');
    Line('  .quad 4605249457297304856');
    Line('.Lhalf:');
    Line('  .quad 4602678819172646912');
    Line('.Lpi:');
    Line('  .quad 4614256656552045848');
    { -2^63 as a Double: the one real whose conversion gives the lowest
      Integer rightly (1.0.112); global, units convert too. }
    Line('rt_dm63:');
    Line('  .quad -4332462841530417152');
    Line('.Lrealrange:');
    Line('  .ascii "' + MsgRealRange + '"');
    Line('.Lasecdom:');
    Line('  .ascii "paslang: arcsec domain"');
    Line('.Lacscdom:');
    Line('  .ascii "paslang: arccsc domain"');
    Line('.Lachdom:');
    Line('  .ascii "paslang: arccosh domain"');
    Line('.Lathdom:');
    Line('  .ascii "paslang: arctanh domain"');
    Line('.Llnxp1dom:');
    Line('  .ascii "paslang: lnxp1 domain"');
    Line('.balign 8');
    Line('.Lxxh32p1:');
    Line('  .quad 2654435761');
    Line('.Lxxh32p2:');
    Line('  .quad 2246822519');
    Line('.Lxxh32p3:');
    Line('  .quad 3266489917');
    Line('.Lxxh32p4:');
    Line('  .quad 668265263');
    Line('.Lxxh32p5:');
    Line('  .quad 374761393');
    Line('.Lxxh64p1:');
    Line('  .quad 0x9e3779b185ebca87');
    Line('.Lxxh64p2:');
    Line('  .quad 0xc2b2ae3d27d4eb4f');
    Line('.Lxxh64p3:');
    Line('  .quad 0x165667b19e3779f9');
    Line('.Lxxh64p4:');
    Line('  .quad 0x85ebca77c2b2ae63');
    Line('.Lxxh64p5:');
    Line('  .quad 0x27d4eb2f165667c5');
    { XXH3 (1.0.63): the reference's default secret, 192 bytes, the
      eight accumulators it starts from, and its 32-bit prime twice. }
    Line('.balign 64');
    Line('.Lxxh3ks:');
    Line('  .byte 184, 254, 108, 57, 35, 164, 75, 190, 124, 1, 129, 44, 247, 33, 173, 28');
    Line('  .byte 222, 212, 109, 233, 131, 144, 151, 219, 114, 64, 164, 164, 183, 179, 103, 31');
    Line('  .byte 203, 121, 230, 78, 204, 192, 229, 120, 130, 90, 208, 125, 204, 255, 114, 33');
    Line('  .byte 184, 8, 70, 116, 247, 67, 36, 142, 224, 53, 144, 230, 129, 58, 38, 76');
    Line('  .byte 60, 40, 82, 187, 145, 195, 0, 203, 136, 208, 101, 139, 27, 83, 46, 163');
    Line('  .byte 113, 100, 72, 151, 162, 13, 249, 78, 56, 25, 239, 70, 169, 222, 172, 216');
    Line('  .byte 168, 250, 118, 63, 227, 156, 52, 63, 249, 220, 187, 199, 199, 11, 79, 29');
    Line('  .byte 138, 81, 224, 75, 205, 180, 89, 49, 200, 159, 126, 201, 217, 120, 115, 100');
    Line('  .byte 234, 197, 172, 131, 52, 211, 235, 195, 197, 129, 160, 255, 250, 19, 99, 235');
    Line('  .byte 23, 13, 221, 81, 183, 240, 218, 73, 211, 22, 85, 38, 41, 212, 104, 158');
    Line('  .byte 43, 22, 190, 88, 125, 71, 161, 252, 143, 248, 184, 209, 122, 208, 49, 206');
    Line('  .byte 69, 203, 58, 143, 149, 22, 4, 40, 175, 215, 251, 202, 187, 75, 64, 126');
    Line('.Lxxh3acc:');
    Line('  .quad 0xc2b2ae3d');
    Line('  .quad 0x9e3779b185ebca87');
    Line('  .quad 0xc2b2ae3d27d4eb4f');
    Line('  .quad 0x165667b19e3779f9');
    Line('  .quad 0x85ebca77c2b2ae63');
    Line('  .quad 0x85ebca77');
    Line('  .quad 0x27d4eb2f165667c5');
    Line('  .quad 0x9e3779b1');
    Line('.Lxxh3p32:');
    Line('  .quad 0x9e3779b1, 0x9e3779b1');
  end;
  for i := 0 to High(FTypes) do
    if FTypes[i].Kind = tykMap then
    begin
      Line('.balign 8');
      Line('.LdescMap_' + IntToStr(i) + ':');
      if FTypes[FTypes[i].Elem].Kind = tykString then
      begin
        Line('  .quad 1');
        Line('  .quad 16');
      end
      else
      begin
        Line('  .quad 0');
        Line('  .quad 8');
      end;
      Line('  .quad ' + IntToStr(TSize(FTypes[i].Elem2)));
      { Does a slot hold a pointer: the key or the value (P95a). pasmap
        allocates its groups with it, so a map of integers is never
        scanned. }
      gw := nil;
      GcMark(FTypes[i].Elem, 0, gw, 0);
      GcMark(FTypes[i].Elem2, 1, gw, 0);
      if GcAny(gw) then
        Line('  .quad 1')
      else
        Line('  .quad 0');
    end
    else if (FTypes[i].Kind = tykTree) or (FTypes[i].Kind = tykHeap) then
    begin
      Line('.balign 8');
      if FTypes[i].Kind = tykTree then
        Line('.LdescTree_' + IntToStr(i) + ':')
      else
        Line('.LdescHeap_' + IntToStr(i) + ':');
      if FTypes[FTypes[i].Elem].Kind = tykString then
      begin
        Line('  .quad 1');
        Line('  .quad 16');
      end
      else if FTypes[i].Elem = TySingle then
      begin
        { a Single compares as a Single (1.1.1: its bits were read as a
          Double's, and a negative came after the positives) }
        Line('  .quad 3');
        Line('  .quad 8');
      end
      else if FTypes[FTypes[i].Elem].Kind = tykReal then
      begin
        Line('  .quad 2');
        Line('  .quad 8');
      end
      else
      begin
        Line('  .quad 0');
        Line('  .quad 8');
      end;
      if (FTypes[i].Kind = tykTree) and (FTypes[i].Elem2 >= 0) then
        Line('  .quad ' + IntToStr(TSize(FTypes[i].Elem2)))
      else
        Line('  .quad 0');
      gw := nil;
      GcMark(FTypes[i].Elem, 0, gw, 0);
      if (FTypes[i].Kind = tykTree) and (FTypes[i].Elem2 >= 0) then
        GcMark(FTypes[i].Elem2, 1, gw, 0);
      if GcAny(gw) then
        Line('  .quad 1')
      else
        Line('  .quad 0');
    end;
  SetLength(FRootWords, Length(Prog.Vars));
  sz := 0;
  for i := 0 to High(Prog.Vars) do
  begin
    FRootWords[i] := GcWord(Prog.Vars[i].Typ);
    { Another unit's global is a root of that unit. }
    if Prog.Vars[i].Ext then
      FRootWords[i] := '0';
    if FRootWords[i] <> '0' then
      sz := sz + 1;
  end;
  if sz = 0 then
    FRootWords := nil;
  { every class declared here: its method table carries its instance's
    descriptor (P123), for an object made through a class reference }
  for i := 0 to High(FTypes) do
    if (FTypes[i].Kind = tykClass) and (not FTypes[i].Imported) then
      GcWordInst(LongInt(i));
  EmitGcTypes;
  { The strings of the typed constants, before the table is written. }
  for i := 0 to High(Prog.Vars) do
    for j := 0 to High(Prog.Vars[i].RelStr) do
      InternStr(Prog.Vars[i].RelStr[j]);
  if FZeroMax > 0 then
  begin
    Line('.balign 16');
    Line('.Lzeroblk:');
    Line('  .space ' + IntToStr(FZeroMax));
  end;
  for i := 0 to High(FStrMaps) do
  begin
    sruns := nil;
    StrRuns(FStrMaps[i], 0, sruns);
    Line('.balign 8');
    Line('.Lsmap' + IntToStr(FStrMaps[i]) + ':');
    Line('  .quad ' + IntToStr(Length(sruns) div 3));
    for j := 0 to High(sruns) do
      Line('  .quad ' + IntToStr(sruns[j]));
  end;
  { the tables of -debug intern their names, so before the pool (P118) }
  if FDebug then
    EmitDebugTables(Prog);
  for i := 0 to High(FStrs) do
  begin
    { A literal's header says shared: a write copies it first (1.0.82). }
    Line('  .byte 1');
    Line('.Ls' + IntToStr(i) + ':');
    Line('  .ascii "' + GasEscape(FStrs[i]) + '"');
    Line('.balign 8');
    Line('.Lsf' + IntToStr(i) + ':');
    Line('  .quad .Ls' + IntToStr(i));
    Line('  .quad ' + IntToStr(Length(FStrs[i])));
  end;
  { the vector constants (1.0.128): each lane's low bits, 32 bytes }
  for i := 0 to High(FVecCLane) do
  begin
    Line('.balign 32');
    Line('.Lvc' + IntToStr(i) + ':');
    for j := 1 to 32 div (FVecCLane[i] div 8) do
      if FVecCLane[i] = 8 then
        Line('  .byte ' + IntToStr(FVecCVal[i] and 255))
      else if FVecCLane[i] = 16 then
        Line('  .short ' + IntToStr(FVecCVal[i] and 65535))
      else if FVecCLane[i] = 32 then
        Line('  .long ' + IntToStr(FVecCVal[i] and 4294967295))
      else
        Line('  .quad ' + IntToStr(FVecCVal[i]));
  end;
  for i := 0 to High(FTypes) do
    if FTypes[i].Kind = tykClass then
    begin
      { A class declared here gets its RTTI and VMT, even with no methods;
        an imported class has them in the unit that declared it. }
      if FTypes[i].Imported then
        Continue;
      for k := 0 to High(FTypes[i].Props) do
        if FTypes[i].Props[k].IsPublished and
          ((FTypes[i].Props[k].ReadOff >= 0) or (FTypes[i].Props[k].WriteOff >= 0)) then
        begin
          Line('.Lp' + IntToStr(i) + '_' + IntToStr(k) + ':');
          Line('  .ascii "' + GasEscape(FTypes[i].Props[k].Name) + '"');
          Line('.balign 8');
        end;
      { the class's name (P121), as a string literal lies, with its header
        before the bytes, so ClassName gives it back without a copy }
      Line('  .byte 1');
      Line('.Lcn' + IntToStr(i) + ':');
      Line('  .ascii "' + GasEscape(FTypes[i].Name) + '"');
      Line('.balign 8');
      Line('rtti_' + TypeStemOf(FTypes[i]) + ':');
      for k := 0 to High(FTypes[i].Props) do
        if FTypes[i].Props[k].IsPublished and
          ((FTypes[i].Props[k].ReadOff >= 0) or (FTypes[i].Props[k].WriteOff >= 0)) then
        begin
          { The kind in the low byte (1 an ordinal, 2 a string, 3 a
            method); an ordinal narrower than a word keeps its width in
            bits 8 to 15 and its sign in bit 16, so GetPropInt and
            SetPropInt read and write that much (P99, 1.0.91). }
          if IsStr(FTypes[i].Props[k].Typ) then
            sz := 2
          else if (TKind(FTypes[i].Props[k].Typ) = tykMethod) or
            (TKind(FTypes[i].Props[k].Typ) = tykProc) then
            sz := 3
          else
          begin
            sz := 1;
            if TSize(FTypes[i].Props[k].Typ) < 8 then
              sz := 1 + TSize(FTypes[i].Props[k].Typ) * 256;
            if (FTypes[i].Props[k].Typ = TyInt8) or
              (FTypes[i].Props[k].Typ = TyInt16) or
              (FTypes[i].Props[k].Typ = TyInt32) then
              sz := sz + 65536;
          end;
          if FTypes[i].Props[k].WriteOff >= 0 then
            j := FTypes[i].Props[k].WriteOff
          else
            j := FTypes[i].Props[k].ReadOff;
          Line('  .quad .Lp' + IntToStr(i) + '_' + IntToStr(k));
          Line('  .quad ' + IntToStr(Length(FTypes[i].Props[k].Name)));
          Line('  .quad ' + IntToStr(sz));
          Line('  .quad ' + IntToStr(j));
        end;
      Line('  .quad 0');
      { before the slots (P121): -48 an instance's GC word (P123, for
        an object made through a class reference), -40 the name's
        address, -32 its length, -24 an instance's size, -16 the
        parent's table, -8 the RTTI }
      Line('  .quad ' + GcWordInst(LongInt(i)));
      Line('  .quad .Lcn' + IntToStr(i));
      Line('  .quad ' + IntToStr(Length(FTypes[i].Name)));
      Line('  .quad ' + IntToStr(FTypes[i].Size));
      if FTypes[i].Parent <> 0 then
        Line('  .quad vmt_' + TypeStemOf(FTypes[FTypes[i].Parent]))
      else
        Line('  .quad 0');
      Line('  .quad rtti_' + TypeStemOf(FTypes[i]));
      Line('.globl vmt_' + TypeStemOf(FTypes[i]));
      Line('vmt_' + TypeStemOf(FTypes[i]) + ':');
      if FTypes[i].VmtN <= 0 then
        Line('  .quad 0')
      else
        for j := 0 to FTypes[i].VmtN - 1 do
          for k := 0 to High(FTypes[i].Meths) do
            if FTypes[i].Meths[k].IsVirt and (FTypes[i].Meths[k].Slot = j) then
            begin
              if FTypes[i].Meths[k].IsAbs then
                Line('  .quad rt_abstract')
              else
                Line('  .quad ' + FTypes[i].Meths[k].Sym);
            end;
      for j := 0 to High(FTypes[i].Ifaces) do
      begin
        Line('.globl ivmt_' + TypeStemOf(FTypes[i]) + '_' +
          TypeStemOf(FTypes[FTypes[i].Ifaces[j]]));
        Line('ivmt_' + TypeStemOf(FTypes[i]) + '_' +
          TypeStemOf(FTypes[FTypes[i].Ifaces[j]]) + ':');
        if Length(FTypes[FTypes[i].Ifaces[j]].Meths) = 0 then
          Line('  .quad 0')
        else
          for k := 0 to High(FTypes[FTypes[i].Ifaces[j]].Meths) do
          begin
            msym := '';
            slot := -1;
            for mi := 0 to High(FTypes[i].Meths) do
              if ToLower(FTypes[i].Meths[mi].Name) =
                ToLower(FTypes[FTypes[i].Ifaces[j]].Meths[k].Name) then
              begin
                msym := FTypes[i].Meths[mi].Sym;
                slot := -1;
                if FTypes[i].Meths[mi].IsVirt and (not FTypes[i].Meths[mi].IsClassMeth) then
                  slot := FTypes[i].Meths[mi].Slot;
              end;
            if msym = '' then
              Die('interface method ' +
                FTypes[FTypes[i].Ifaces[j]].Meths[k].Name);
            if slot < 0 then
              Line('  .quad ' + msym)
            else
            begin
              { a virtual method through the interface is the object's
                own, an override too (P140), as in Free Pascal: a thunk
                reads it from the object's table, Self in rdi or x0, and
                jumps there. The entry held the class's method, so a
                descendant's override was never called. }
              Line('  .quad .Lith' + IntToStr(i) + '_' + IntToStr(j) + '_' + IntToStr(k));
              Line('.pushsection .text');
              Line('.Lith' + IntToStr(i) + '_' + IntToStr(j) + '_' + IntToStr(k) + ':');
              if FArm then
              begin
                Line('  ldr x16, [x0]');
                if slot * 8 <= 32760 then
                  Line('  ldr x16, [x16, #' + IntToStr(slot * 8) + ']')
                else
                begin
                  Imm('x17', slot * 8);
                  Line('  ldr x16, [x16, x17]');
                end;
                Line('  br x16');
              end
              else
              begin
                Line('  movq (%rdi), %rax');
                Line('  jmpq *' + IntToStr(slot * 8) + '(%rax)');
              end;
              Line('.popsection');
            end;
          end;
      end;
    end;
  if not Prog.IsUnit then
  begin
    Line('.balign 8');
    Line('rt_linetab:');
    for i := 0 to High(FLineLabs) do
    begin
      Line('  .quad ' + FLineLabs[i]);
      Line('  .quad ' + IntToStr(FLineNums[i]));
    end;
    Line('  .quad .Lprogend');
    Line('  .quad 0');
    Line('  .quad 0');
    Line('  .quad 0');
  end;
  Line('');
  Line('.bss');
  if Prog.IsUnit then
  begin
    Line('.balign 8');
    Line('u_' + ToLower(Prog.Name) + '_once:');
    Line('  .quad 0');
  end;
  if not Prog.IsUnit then
  begin
    { The record rt_nsadjust points r14 (x28) at while pasheap adjusts a
      stack that moved, on the M's system stack, and its lock (P95c). }
    Line('.balign 8');
    Line('rt_nslock:');
    Line('  .quad 0');
    Line('rt_nsg:');
    Line('  .space 288');
    Line('.balign 8');
    Line('rt_heapp:');
    Line('  .quad 0');
    Line('rt_heape:');
    Line('  .quad 0');
    { The heap state pasheap and rt_alloc share (P95a): lock, base,
      limit, mapped (rt_maptot), cursor, end of the mapping, table, span
      pool and its end, spans, class tables, cap, mcaches, Ps, mcache
      size, span list. }
    Line('.balign 8');
    Line('rt_heapstate:');
    Line('  .quad 0');
    Line('  .quad 0');
    Line('  .quad 0');
    Line('rt_maptot:');
    Line('  .quad 0');
    { From +192 the collector's fields (pasheap: HGcOn to HXSize, the
      last at +576, P342). }
    Line('  .space 552');
    Line('rt_zerobase:');
    Line('  .quad 0');
    Line('rt_syssp:');
    Line('  .quad 0');
    Line('rt_nproc:');
    Line('  .quad 0');
    { what the processor has, CpuHas's bits, set by rt_cpuinit; on amd64
      the time-stamp counter and the monotonic clock at start, and the
      counter's rate once CycleFreq has worked it out (1.0.124) }
    Line('rt_cpufeat:');
    Line('  .quad 0');
    Line('rt_boottsc:');
    Line('  .quad 0');
    Line('rt_bootns:');
    Line('  .quad 0');
    Line('rt_tscfreq:');
    Line('  .quad 0');
    Line('rt_nlive:');
    Line('  .quad 0');
    Line('rt_maing:');
    Line('  .quad 0');
    Line('rt_goidseq:');
    Line('  .quad 0');
    Line('rt_nbreakv:');
    Line('  .quad 0');
    Line('rt_breakg:');
    Line('  .quad 0');
    Line('rt_breakpcv:');
    Line('  .quad 0');
    Line('rt_glock:');
    Line('  .quad 0');
    Line('rt_gflock:');
    Line('  .quad 0');
    { P333: the exec lock, Go's execLock: bit 32 an execve of the process
      in progress, the low word the threads being made }
    Line('rt_execlk:');
    Line('  .quad 0');
    Line('rt_heaplock:');
    Line('  .quad 0');
    Line('rt_glocksite:');
    Line('  .quad 0');
    Line('rt_glockseq:');
    Line('  .quad 0');
    Line('rt_glockring:');
    Line('  .zero 2048');
    Line('rt_ghead:');
    Line('  .quad 0');
    { The global queue is first in, first out, as Go's sched.runq: the
      last routine at rt_gtail (1.0.71). As a stack, a routine preempted
      while every M ran others sank under the ones preempted after it
      and never ran again (lazym, main under 64 spinners). }
    Line('rt_gtail:');
    Line('  .quad 0');
    Line('rt_gfree:');
    Line('  .quad 0');
    Line('rt_slabnext:');
    Line('  .quad 0');
    Line('rt_slabend:');
    Line('  .quad 0');
    Line('rt_nidle:');
    Line('  .quad 0');
    { The deadlock detector's words (1.0.139): the low half of rt_msleep
      counts the Ms asleep after their final look for work, the high half
      how many times one woke; rt_npollwait the routines parked on the
      poller (rt_waitio, rt_acwait). }
    Line('rt_msleep:');
    Line('  .quad 0');
    Line('rt_npollwait:');
    Line('  .quad 0');
    { rt_lastpoll: when an M last looked at the poller; rt_sysm: the M
      record sysmon polls on, no P (1.1.1). }
    Line('rt_lastpoll:');
    Line('  .quad 0');
    Line('rt_sysm:');
    for i := 1 to 16 do
      Line('  .quad 0');
    { The Ms whose threads run: M0 and those rt_wakep or a cycle started,
      in the order of rt_allm (P91). }
    Line('rt_mstarted:');
    Line('  .quad 0');
    Line('rt_mnop:');
    Line('  .quad 0');
    Line('rt_idlenote:');
    Line('  .quad 0');
    { P90: the Ms looking for work, the stack of Ms asleep on their own
      futex (linked through M+64), and the one M blocked in epoll_wait. }
    Line('rt_nspinning:');
    Line('  .quad 0');
    Line('rt_midle:');
    Line('  .quad 0');
    Line('rt_pollerm:');
    Line('  .quad 0');
    Line('rt_maindone:');
    Line('  .quad 0');
    Line('rt_gqn:');
    Line('  .quad 0');
    { Stack memory (routine slabs, grown stacks, M stacks) is counted
      here, apart from the heap's rt_maptot (P92). }
    Line('rt_stacktot:');
    Line('  .quad 0');
    { The first thread to take a fatal signal reports; the others wait
      for its exit, so two reports never interleave (P86). }
    Line('rt_siglock:');
    Line('  .quad 0');
    { the table of code a signal may stop a routine at (P293): its
      bounds once rt_asyncinit has sorted it, 0 while there is none }
    Line('rt_asynclo:');
    Line('  .quad 0');
    Line('rt_asynchi:');
    Line('  .quad 0');
    { the free vector blocks of stops and the lock rt_xget takes them
      under (P342) }
    Line('rt_xfree:');
    Line('  .quad 0');
    Line('rt_xlock:');
    Line('  .quad 0');
    { The two standard streams (P212): a record each, the layout at
      EmitIO; a cache line apart, so the two locks share none. }
    Line('.balign 64');
    Line('rt_stdout:');
    Line('  .zero ' + IntToStr(OutRecSize));
    Line('rt_stderr:');
    Line('  .zero ' + IntToStr(OutRecSize));
    Line('rt_epfd:');
    Line('  .quad 0');
    Line('rt_evfd:');
    Line('  .quad 0');
    { 1 while a wake written to rt_evfd waits to be read, as Go's
      netpollWakeSig (runtime/netpoll_epoll.go): rt_poke writes once
      until an M drains it (P350) }
    Line('rt_wakesig:');
    Line('  .quad 0');
    { The deadline the M in the poller sleeps to, all ones for none, 0
      while it is not known (P352, Go's sched.pollUntil); the timers are
      each P's. }
    Line('rt_polluntil:');
    Line('  .quad 0');
    Line('rt_iotab:');
    Line('  .zero 1024');
    Line('rt_argc:');
    Line('  .quad 0');
    Line('rt_argv:');
    Line('  .quad 0');
    Line('rt_vdsocgt:');
    Line('  .quad 0');
    Line('rt_finin:');
    Line('  .quad 0');
    Line('rt_finitab:');
    Line('  .space 512');
    Line('.balign 8');
    Line('rt_g:');
    { a routine's record: 288 bytes from 1.1.3, G+256 its Carry (P108), G+272
      the object being raised and G+280 where (P122) }
    Line('  .space 288');
    Line('rt_allm:');
    Line('  .space 1280000');
    { a record for each M's own stack (P342), as Go's g0: rt_gocallm runs
      the heap's slow paths on it }
    Line('rt_allg0:');
    Line('  .space 2880000');
    Line('rt_allp:');
    Line('  .space 69632');
    Line('.balign 16');
    Line('rt_heap:');
    Line('  .space 1048576');
  end;
  Line('');
  Line('.data');
  { The program's globals start the data section, the units' follow:
    MemBase of a global's address is here, its end at _edata (P104). }
  if not Prog.IsUnit then
  begin
    Line('.globl rt_datastart');
    Line('rt_datastart:');
  end;
  for i := 0 to High(Prog.Vars) do
    if (Prog.Vars[i].Init <> '') and (not Prog.Vars[i].Ext) then
    begin
      Line('.balign ' + IntToStr(GlobAlign(Prog.Vars[i].Typ)));
      if Prog.Vars[i].Pub then
        Line('.globl ' + VarLabel(GlobName(Prog.Vars[i])));
      Line(VarLabel(GlobName(Prog.Vars[i])) + ':');
      { A typed constant's image, with the address of each string's
        characters where the string starts (1.0.77). }
      rp := 0;
      for j := 0 to High(Prog.Vars[i].Rel) do
      begin
        if Prog.Vars[i].Rel[j] > rp then
          Line('  .ascii "' + GasEscape(Copy(Prog.Vars[i].Init, rp + 1,
            Prog.Vars[i].Rel[j] - rp)) + '"');
        Line('  .quad ' + InternStr(Prog.Vars[i].RelStr[j]));
        rp := Prog.Vars[i].Rel[j] + 8;
      end;
      if rp < Length(Prog.Vars[i].Init) then
        Line('  .ascii "' + GasEscape(Copy(Prog.Vars[i].Init, rp + 1,
          Length(Prog.Vars[i].Init) - rp)) + '"');
      sz := Align8(SlotSize(Prog.Vars[i].Typ)) - Length(Prog.Vars[i].Init);
      if sz > 0 then
        Line('  .space ' + IntToStr(sz));
    end;
  for i := 0 to High(Prog.Vars) do
    if (Prog.Vars[i].Init = '') and (not Prog.Vars[i].Ext) then
    begin
      Line('.balign ' + IntToStr(GlobAlign(Prog.Vars[i].Typ)));
      if Prog.Vars[i].Pub then
        Line('.globl ' + VarLabel(GlobName(Prog.Vars[i])));
      Line(VarLabel(GlobName(Prog.Vars[i])) + ':');
      Line('  .space ' + IntToStr(Align8(SlotSize(Prog.Vars[i].Typ))));
    end;
  { The globals that hold a pointer, for the collector (P95b): address,
    size and GC word, in a section the linker gathers from every object
    file; the runtime reads it between __start_pasgcroots and
    __stop_pasgcroots. }
  if Length(FRootWords) > 0 then
  begin
    Line('.section pasgcroots,"aw"');
    { Every file adds a multiple of 24 bytes, so the aligned pieces meet
      without a gap and the runtime walks them with one stride. }
    Line('.balign 8');
    for i := 0 to High(Prog.Vars) do
      if (i <= High(FRootWords)) and (FRootWords[i] <> '0') then
      begin
        Line('  .quad ' + VarLabel(GlobName(Prog.Vars[i])));
        Line('  .quad ' + IntToStr(Align8(SlotSize(Prog.Vars[i].Typ))));
        Line('  .quad ' + FRootWords[i]);
      end;
  end;
  { The stack maps (P95c): a pair per call site, the return address and
    its descriptor, in a section the linker gathers from every object
    file (writable: the runtime sorts it once); the descriptors after. }
  if FMapOutN > 0 then
  begin
    Line('.section pasgcmaps,"aw"');
    Line('.balign 8');
    for i := 0 to FMapOutN - 1 do
      Line(FMapOut[i]);
    Line('.section .rodata');
    Line('.balign 8');
    for i := 0 to FDescN - 1 do
    begin
      Line('.Lgd' + IntToStr(i) + ':');
      Line(FDescOut[i]);
    end;
  end;
  { the constant sets of 32 bytes (P126), aligned for a vector load }
  if Length(FSetImgs) > 0 then
  begin
    Line('.section .rodata');
    Line('.balign 32');
    for i := 0 to High(FSetImgs) do
    begin
      Line('.Lsetc' + IntToStr(i) + ':');
      Line('  .quad 0x' + Copy(FSetImgs[i], 1, 16) + ', 0x' + Copy(FSetImgs[i], 17, 16) +
        ', 0x' + Copy(FSetImgs[i], 33, 16) + ', 0x' + Copy(FSetImgs[i], 49, 16));
    end;
  end;
  EmitDwarfLocals;
  SetLength(FOut, FLen);
  Result := FOut;
end;

{ rt_mapgetstr: m[s] for a string key, pasmap's PasMapGetStr (Go's
  mapaccess1_faststr) without its frame: rdi the map, rsi the key's two
  words, rdx the descriptor (not read); the value's slot in rax, or nil.
  The map's fields by pasmap's TMap: Used 0, Seed 8, Dir 16, Writing 24
  (a byte), TabMask 26 (two bytes), SlotSize 28 (four bytes), and in the
  directory's block DirMask at 8 and the entries from 16; TabMask 0 is a
  small map, whose
  one group is at Dir and is read whole with no probe (P285); a group is
  8 * (SlotSize + 1) bytes, and a slot is the key's pointer and length,
  then the value. The hash by rt_xxh3 (which keeps
  rbx, r12, r13 and r15, where the map, the key and H2 wait); a
  candidate's bytes are compared, eight at a time, only when its length
  is the key's and its pointer is not. The Pascal routine ran 118
  instructions a lookup to this one's 60, and its two loads waited for
  memory with fewer lookups in flight (1.0.69). }
procedure TEmitter.EmitMapGetStrX86;
begin
  Line('rt_mapgetstr:');
  Line('  testq %rdi, %rdi');
  Line('  jz .mgs_nil');
  Line('  cmpq $0, (%rdi)');
  Line('  je .mgs_nil');
  Line('  cmpb $0, 24(%rdi)');
  Line('  jne rt_diemaprw');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  movq %rdi, %rbx');
  Line('  movq %rsi, %r12');
  Line('  movq (%rsi), %rax');
  Line('  movq 8(%rsi), %rdx');
  Line('  movq 8(%rdi), %r9');
  Line('  call rt_xxh3');
  Line('  movq %rax, %r9');
  Line('  andq $127, %rax');
  Line('  movabsq $72340172838076673, %r13');
  Line('  imulq %rax, %r13');
  Line('  movzwl 26(%rbx), %r10d');
  Line('  testl %r10d, %r10d');
  Line('  jnz .mgs_table');
  Line('  movq 16(%rbx), %rax');
  Line('  jmp .mgs_match');
  Line('.mgs_table:');
  Line('  movq 16(%rbx), %r8');
  Line('  movq %r9, %rcx');
  Line('  shrq $32, %rcx');
  Line('  andq 8(%r8), %rcx');
  Line('  movq 16(%r8,%rcx,8), %r8');
  Line('  shrq $7, %r9');
  Line('  andq %r10, %r9');
  Line('  xorl %ecx, %ecx');
  Line('.mgs_group:');
  Line('  movslq 28(%rbx), %rax');
  Line('  incq %rax');
  Line('  imulq %r9, %rax');
  Line('  leaq (%r8,%rax,8), %rax');
  Line('.mgs_match:');
  Line('  movq (%rax), %r10');
  Line('  xorq %r13, %r10');
  Line('  movabsq $72340172838076673, %r11');
  Line('  movq %r10, %rsi');
  Line('  subq %r11, %rsi');
  Line('  notq %r10');
  Line('  andq %r10, %rsi');
  Line('  movabsq $-9187201950435737472, %r11');
  Line('  andq %r11, %rsi');
  Line('  jz .mgs_miss');
  Line('.mgs_bit:');
  Line('  ' + Bsf('q') + ' %rsi, %rdi');
  Line('  shrq $3, %rdi');
  Line('  imull 28(%rbx), %edi');
  Line('  leaq 8(%rax,%rdi), %rdi');
  Line('  movq 8(%rdi), %r10');
  Line('  cmpq 8(%r12), %r10');
  Line('  jne .mgs_next');
  Line('  movq (%rdi), %r11');
  Line('  cmpq (%r12), %r11');
  Line('  je .mgs_found');
  Line('  movq (%r12), %r15');
  Line('.mgs_c8:');
  Line('  cmpq $8, %r10');
  Line('  jb .mgs_c1');
  Line('  movq (%r11), %rdx');
  Line('  cmpq (%r15), %rdx');
  Line('  jne .mgs_next');
  Line('  addq $8, %r11');
  Line('  addq $8, %r15');
  Line('  subq $8, %r10');
  Line('  jmp .mgs_c8');
  Line('.mgs_c1:');
  Line('  testq %r10, %r10');
  Line('  jz .mgs_found');
  Line('  movb (%r11), %dl');
  Line('  cmpb (%r15), %dl');
  Line('  jne .mgs_next');
  Line('  incq %r11');
  Line('  incq %r15');
  Line('  decq %r10');
  Line('  jmp .mgs_c1');
  Line('.mgs_found:');
  Line('  leaq 16(%rdi), %rax');
  Line('  jmp .mgs_ret');
  Line('.mgs_next:');
  Line('  leaq -1(%rsi), %r10');
  Line('  andq %r10, %rsi');
  Line('  jnz .mgs_bit');
  Line('.mgs_miss:');
  Line('  cmpw $0, 26(%rbx)');
  Line('  je .mgs_none');
  Line('  movq (%rax), %rdx');
  Line('  movq %rdx, %r10');
  Line('  shlq $6, %r10');
  Line('  notq %r10');
  Line('  andq %rdx, %r10');
  Line('  movabsq $-9187201950435737472, %r11');
  Line('  testq %r11, %r10');
  Line('  jnz .mgs_none');
  Line('  incq %rcx');
  Line('  addq %rcx, %r9');
  Line('  movzwl 26(%rbx), %r10d');
  Line('  andq %r10, %r9');
  Line('  jmp .mgs_group');
  Line('.mgs_none:');
  Line('  xorl %eax, %eax');
  Line('.mgs_ret:');
  Line('  popq %r15');
  Line('  popq %r13');
  Line('  popq %r12');
  Line('  popq %rbx');
  Line('  ret');
  Line('.mgs_nil:');
  Line('  xorl %eax, %eax');
  Line('  ret');
end;

{ The message of a program whose fills use DC ZVA when the processor it
  runs on zeroes another block or forbids it (P273); DCZID_EL0 follows. }
function TEmitter.ZvaMsg: string;
begin
  Result := 'paslang: compiled for ' + CpuProcName(FProgProc) +
    ', whose DC ZVA zeroes 64 bytes; this processor reads DCZID_EL0 ';
end;

{ rt_yieldpoint (P271): a long copy, clear, comparison or hash of the
  runtime calls it between two pieces when its routine has been asked
  to stop (G+16 holds Poisoned, which sysmon writes every 10 ms and the
  collector's stop of the world too). It keeps every register, as Go's
  asyncPreempt does (preempt_amd64.s and preempt_arm64.s, written by
  mkpreempt.go): the general ones on the routine's stack, the vector
  ones (ymm0-ymm15 when the processor compiled for has AVX, since a
  promoted V256 may live in one; xmm0-xmm15 else; q0-q31 on arm64) in a
  block of their own (rt_xget, P342), as Go keeps them in p.xRegs
  and gp.xRegs and not on the goroutine's stack (runtime/
  preempt_xreg.go), and it parks as a preempted prologue does
  (.ms_preempt), on the global queue, coming back through .pk_res. The
  collector reads that stack word by word up to the caller's frame
  pointer, as it reads any runtime frame, and the block word by word too,
  as Go's xRegScan (ScanStack). The flags are not kept: a call leaves
  them undefined. With AVX the restore leaves the upper halves in use
  until the next vzeroupper, which on Intel's cores costs the SSE code
  between (only after a stop, some every 10 ms). It does nothing on
  another stack than the routine's own (rt_newstack copies on the M's)
  or while the routine holds a runtime lock (G+184, the collector's own
  records among them), nor where AsyncRoom bytes below its caller's
  stack pointer would not fit above the routine's real guard (G+24,
  P342): the request then waits for the next check. It counts its own
  room, as Go's asyncPreempt is entered only with asyncPreemptStack
  bytes (runtime/preempt.go isAsyncSafePoint), and adds nothing to a
  chain of unchecked runtime code (scripts/check_stack.py --room). }
procedure TEmitter.EmitYieldPointX86;
const
  Gpr: array[0..9] of string = ('rax', 'rcx', 'rdx', 'rsi', 'rdi', 'r8', 'r9',
    'r10', 'r11', 'rbp');
var
  i: LongInt;
begin
  Line('rt_yieldpoint:');
  Line('  cmpl $0, 184(%r14)');
  Line('  jne .yp_no');
  { the room: sp less what it writes below its return address against
    the real guard, sp given back by a lea, which keeps the flags (SDM
    vol. 2A, LEA: no flags affected) }
  Line('  subq $' + IntToStr(AsyncRoom - 8) + ', %rsp');
  Line('  cmpq 24(%r14), %rsp');
  Line('  leaq ' + IntToStr(AsyncRoom - 8) + '(%rsp), %rsp');
  Line('  jb .yp_no');
  Line('  cmpq 8(%r14), %rsp');
  Line('  ja .yp_no');
  { 10 general registers, then the vector block's word at 80: .pk_res's
    layout below keeps rbx, r12, r13 and r15 and gives them back }
  Line('  subq $88, %rsp');
  for i := 0 to 9 do
    Line('  movq %' + Gpr[i] + ', ' + IntToStr(8 * i) + '(%rsp)');
  { the .pk_res layout: the callee-saved registers, then where to go on }
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  leaq .yp_res(%rip), %rax');
  Line('  pushq %rax');
  XStopX86;
  Line('.yp_res:');
  XBackX86('.yp_put');
  for i := 0 to 9 do
    Line('  movq ' + IntToStr(8 * i) + '(%rsp), %' + Gpr[i]);
  Line('  addq $88, %rsp');
  Line('.yp_no:');
  Line('  ret');
  Line('');
  { rt_xget (P342): a block of XBlock bytes for the vector registers of a
    stop, in rdx: the first of the free list rt_xfree, taken under
    rt_xlock as Go takes one from xRegAlloc under its lock, or a fresh
    one of 16 KB from the kernel (Go's fixalloc chunk, _FixAllocChunk),
    the others onto the list. A resumed routine gives its block back
    with a CAS and no lock: only the holder of rt_xlock takes from the
    list, so the head it read is still the head unless a block was
    given meanwhile (no ABA). On the M's stack with r14 0, so the lock
    counts in no routine; rax, rcx, rsi, rdi and r8 to r11 change. }
  Line('rt_xget:');
  Line('  leaq rt_xlock(%rip), %rdi');
  Line('  call rt_lock');
  Line('.xg_pop:');
  Line('  movq rt_xfree(%rip), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .xg_map');
  Line('  movq (%rax), %rcx');
  Line('  movq %rax, %rdx');
  Line('  lock cmpxchgq %rcx, rt_xfree(%rip)');
  Line('  jne .xg_pop');
  Line('  jmp rt_unlock');
  Line('.xg_map:');
  Line('  movl $9, %eax');
  Line('  xorl %edi, %edi');
  Line('  movl $16384, %esi');
  Line('  movl $3, %edx');
  Line('  movl $34, %r10d');
  Line('  movq $-1, %r8');
  Line('  xorl %r9d, %r9d');
  Line('  syscall');
  Line('  cmpq $-4095, %rax');
  Line('  jae rt_diemmap');
  { the first block is the stop's; the others in a chain, the last of
    them at rsi linked to the list as it is now }
  Line('  movq %rax, %rdx');
  Line('  leaq ' + IntToStr(XBlock) + '(%rax), %rcx');
  Line('  leaq ' + IntToStr(16384 - XBlock) + '(%rax), %rsi');
  Line('  movq %rcx, %rdi');
  Line('.xg_link:');
  Line('  cmpq %rsi, %rdi');
  Line('  jae .xg_end');
  Line('  leaq ' + IntToStr(XBlock) + '(%rdi), %r8');
  Line('  movq %r8, (%rdi)');
  Line('  movq %r8, %rdi');
  Line('  jmp .xg_link');
  Line('.xg_end:');
  Line('  movq rt_xfree(%rip), %rax');
  Line('.xg_cas:');
  Line('  movq %rax, (%rsi)');
  Line('  lock cmpxchgq %rcx, rt_xfree(%rip)');
  Line('  jne .xg_cas');
  Line('  leaq rt_xlock(%rip), %rdi');
  Line('  jmp rt_unlock');
  Line('');
end;

{ The end of a stop on amd64, once the registers are on the routine's
  stack and .pk_res's layout under them (P342): the guard back to the
  real one, where the routine resumes (G+40 its stack pointer, G+48
  .pk_res, G+56 its frame pointer), then on the M's stack the vector
  registers into a block of rt_xget and its address into the save
  area's word at 80, before the routine is queued and a cycle may read
  it. r14 no longer names the queued routine, as in .ms_preempt. }
procedure TEmitter.XStopX86;
var
  i: LongInt;
begin
  Line('  movq 24(%r14), %rax');
  Line('  movq %rax, 16(%r14)');
  Line('  leaq .pk_res(%rip), %rax');
  Line('  movq %rax, 48(%r14)');
  Line('  movq %rsp, 40(%r14)');
  Line('  movq %rbp, 56(%r14)');
  Line('  movq 32(%r14), %r13');
  Line('  movq 32(%r13), %rsp');
  Line('  xorq %rbp, %rbp');
  Line('  movq %r14, %r12');
  Line('  xorq %r14, %r14');
  Line('  call rt_xget');
  Line('  movq 40(%r12), %rax');
  Line('  movq %rdx, 120(%rax)');
  for i := 0 to 15 do
    if XBlock = 512 then
      Line('  vmovdqu %ymm' + IntToStr(i) + ', ' + IntToStr(32 * i) + '(%rdx)')
    else
      Line('  movdqu %xmm' + IntToStr(i) + ', ' + IntToStr(16 * i) + '(%rdx)');
  Line('  movq %r12, %rdi');
  Line('  call rt_globput');
  Line('  jmp rt_yieldwake');
end;

{ Its return, at the resume label L names, the stack pointer at the
  save area: the vector registers from the block, and the block back on
  rt_xfree with a CAS (rt_xget says why no lock), rax and rdx changed.
  A register is loaded no wider than its saved bits ask (P344): with
  every bit from 64 on zero by movq (vmovq with AVX, which clears bits
  64 to 255), with the bits from 128 on zero by the 128-bit vmovdqu
  (VEX.128 clears the upper half), whole only else. Zen keeps track of
  the XMM registers whose upper bits were cleared and lets CVTSI2SD,
  MOVSD between registers and SQRTSD skip the merge with the old value
  while it knows them clear (AMD 56305, 2.11.5, XMM Register Merge
  Optimization); a full load of the same zeros lost that, and every such
  instruction after a stop waited for its register's last writer: exp
  and atan ran up to twice as slow until the next signal's XRSTOR. }
procedure TEmitter.XBackX86(const L: string);
var
  i, o: LongInt;
  n: string;
begin
  Line('  movq 80(%rsp), %rdx');
  for i := 0 to 15 do
  begin
    n := L + 'v' + IntToStr(i);
    if XBlock = 512 then
    begin
      o := 32 * i;
      Line('  movq ' + IntToStr(o + 8) + '(%rdx), %rax');
      Line('  orq ' + IntToStr(o + 16) + '(%rdx), %rax');
      Line('  orq ' + IntToStr(o + 24) + '(%rdx), %rax');
      Line('  jnz ' + n + 'a');
      Line('  vmovq ' + IntToStr(o) + '(%rdx), %xmm' + IntToStr(i));
      Line('  jmp ' + n + 'z');
      Line(n + 'a:');
      Line('  movq ' + IntToStr(o + 16) + '(%rdx), %rax');
      Line('  orq ' + IntToStr(o + 24) + '(%rdx), %rax');
      Line('  jnz ' + n + 'b');
      Line('  vmovdqu ' + IntToStr(o) + '(%rdx), %xmm' + IntToStr(i));
      Line('  jmp ' + n + 'z');
      Line(n + 'b:');
      Line('  vmovdqu ' + IntToStr(o) + '(%rdx), %ymm' + IntToStr(i));
      Line(n + 'z:');
    end
    else
    begin
      o := 16 * i;
      Line('  cmpq $0, ' + IntToStr(o + 8) + '(%rdx)');
      Line('  jne ' + n + 'a');
      Line('  movq ' + IntToStr(o) + '(%rdx), %xmm' + IntToStr(i));
      Line('  jmp ' + n + 'z');
      Line(n + 'a:');
      Line('  movdqu ' + IntToStr(o) + '(%rdx), %xmm' + IntToStr(i));
      Line(n + 'z:');
    end;
  end;
  Line('  movq rt_xfree(%rip), %rax');
  Line(L + ':');
  Line('  movq %rax, (%rdx)');
  Line('  lock cmpxchgq %rdx, rt_xfree(%rip)');
  Line('  jne ' + L);
end;

{ rt_asyncpreempt (P293): rt_sigurg makes the routine it stopped call
  this from the instruction it was at, as Go's pushCall does
  (runtime/signal_amd64.go), the interrupted pc pushed as the return
  address. It keeps every register as rt_yieldpoint does and the flags
  too, since the instruction after may read them (Go's asyncPreempt
  pushes them first, preempt_amd64.s), parks the routine on the global
  queue with the layout .pk_res pops, and comes back with everything as
  it was. The collector reads this stack word by word up to the frame
  pointer kept at G+56 (ScanStack): the save area, the interrupted pc
  and the interrupted frame, which has no map at such a pc; and the
  vector block the save area's word at 80 names (P342). }
procedure TEmitter.EmitAsyncPreemptX86;
const
  Gpr: array[0..9] of string = ('rax', 'rcx', 'rdx', 'rsi', 'rdi', 'r8', 'r9',
    'r10', 'r11', 'rbp');
var
  i: LongInt;
begin
  Line('rt_asyncpreempt:');
  Line('  pushfq');
  Line('  subq $88, %rsp');
  for i := 0 to 9 do
    Line('  movq %' + Gpr[i] + ', ' + IntToStr(8 * i) + '(%rsp)');
  Line('  pushq %rbx');
  Line('  pushq %r12');
  Line('  pushq %r13');
  Line('  pushq %r15');
  Line('  leaq .apx_res(%rip), %rax');
  Line('  pushq %rax');
  XStopX86;
  Line('.apx_res:');
  XBackX86('.apx_put');
  for i := 0 to 9 do
    Line('  movq ' + IntToStr(8 * i) + '(%rsp), %' + Gpr[i]);
  Line('  addq $88, %rsp');
  Line('  popfq');
  Line('  ret');
  Line('');
  { rt_sigurg: SIGURG, on the M's alternate stack (rdi the signal, rsi
    the siginfo, rdx the ucontext: gregs from 40, r14 at 88, rsp at 160,
    rip at 168). It stops the routine only where Go's isAsyncSafePoint
    would (runtime/preempt.go), and looks at the pc first, since only in
    code paslangc compiled is r14 the routine (an asm kernel or the
    runtime may hold anything there; reading through it first faulted
    under jsonshare's stress): r14 a routine that runs (G+152 0, Go's
    _Grunning: one that marked itself parking, 1, goes on to its CAS of
    1 to 2, and stopped there it would come back as 0 and lose the wake
    its waker gives by that CAS), whose guard says Poisoned (it was
    asked to stop and has not), that holds no runtime lock
    (G+184), whose stack pointer is inside its stack and AsyncRoom above
    its real guard (G+24) for what rt_asyncpreempt writes, 144 bytes (as
    Go's asyncPreemptStack, P342: its vector registers go to a block of
    their own, and the red zone holds the rest in every routine of the
    table), and whose pc is in code paslangc compiled with no asm in it
    (the pasasync table,
    the last entry that starts at or before the pc, by halves). Anywhere
    else the request waits for the next check or the next signal. }
  Line('rt_sigurg:');
  { PASLANG_ASYNCPREEMPTOFF stops nothing (pasheap's HAsyncOff) }
  Line('  cmpq $0, rt_heapstate+544(%rip)');
  Line('  jne .sgu_ret');
  { the pc first: only in code paslangc compiled is r14 the routine (an
    asm kernel or the runtime may hold anything there) }
  Line('  movq 168(%rdx), %r9');
  Line('  movq rt_asynclo(%rip), %rsi');
  Line('  testq %rsi, %rsi');
  Line('  jz .sgu_ret');
  Line('  movq rt_asynchi(%rip), %r11');
  Line('  subq %rsi, %r11');
  Line('  shrq $4, %r11');
  Line('  xorq %r10, %r10');
  Line('.sgu_bs:');
  Line('  cmpq %r11, %r10');
  Line('  jae .sgu_bd');
  Line('  leaq (%r10,%r11), %rdi');
  Line('  shrq $1, %rdi');
  Line('  movq %rdi, %r8');
  Line('  shlq $4, %r8');
  Line('  cmpq (%rsi,%r8), %r9');
  Line('  jb .sgu_lo');
  Line('  leaq 1(%rdi), %r10');
  Line('  jmp .sgu_bs');
  Line('.sgu_lo:');
  Line('  movq %rdi, %r11');
  Line('  jmp .sgu_bs');
  Line('.sgu_bd:');
  Line('  testq %r10, %r10');
  Line('  jz .sgu_ret');
  Line('  decq %r10');
  Line('  shlq $4, %r10');
  Line('  cmpq 8(%rsi,%r10), %r9');
  Line('  jae .sgu_ret');
  Line('  movq 88(%rdx), %rax');
  Line('  testq %rax, %rax');
  Line('  jz .sgu_ret');
  Line('  cmpl $0, 152(%rax)');
  Line('  jne .sgu_ret');
  Line('  cmpq $-1314, 16(%rax)');
  Line('  jne .sgu_ret');
  Line('  cmpl $0, 184(%rax)');
  Line('  jne .sgu_ret');
  Line('  movq 160(%rdx), %rcx');
  Line('  cmpq 8(%rax), %rcx');
  Line('  ja .sgu_ret');
  Line('  movq 24(%rax), %r8');
  Line('  addq $' + IntToStr(AsyncRoom) + ', %r8');
  Line('  cmpq %r8, %rcx');
  Line('  jb .sgu_ret');
  Line('  subq $8, %rcx');
  Line('  movq %r9, (%rcx)');
  Line('  movq %rcx, 160(%rdx)');
  Line('  leaq rt_asyncpreempt(%rip), %r9');
  Line('  movq %r9, 168(%rdx)');
  Line('.sgu_ret:');
  Line('  ret');
  Line('');
  { rt_asyncinit, at the start: the pasasync table by its starts. The
    linker lays the pieces in the order of their code, so it is sorted
    already and the walk is all it costs; else an insertion sort. }
  Line('rt_asyncinit:');
  Line('  movabsq $__start_pasasync, %rsi');
  Line('  movabsq $__stop_pasasync, %rdi');
  Line('  testq %rsi, %rsi');
  Line('  jz .aix_none');
  Line('  cmpq %rsi, %rdi');
  Line('  jbe .aix_none');
  Line('  leaq 16(%rsi), %rcx');
  Line('.aix_out:');
  Line('  cmpq %rdi, %rcx');
  Line('  jae .aix_done');
  Line('  movq (%rcx), %r8');
  Line('  movq 8(%rcx), %r9');
  Line('  movq %rcx, %rdx');
  Line('.aix_in:');
  Line('  cmpq %rsi, %rdx');
  Line('  jbe .aix_put');
  Line('  movq -16(%rdx), %rax');
  Line('  cmpq %r8, %rax');
  Line('  jbe .aix_put');
  Line('  movq %rax, (%rdx)');
  Line('  movq -8(%rdx), %rax');
  Line('  movq %rax, 8(%rdx)');
  Line('  subq $16, %rdx');
  Line('  jmp .aix_in');
  Line('.aix_put:');
  Line('  movq %r8, (%rdx)');
  Line('  movq %r9, 8(%rdx)');
  Line('  addq $16, %rcx');
  Line('  jmp .aix_out');
  Line('.aix_done:');
  Line('  movq %rsi, rt_asynclo(%rip)');
  Line('  movq %rdi, rt_asynchi(%rip)');
  Line('.aix_none:');
  Line('  ret');
  Line('');
end;

{ Between two pieces of a long copy, clear, comparison or hash of the
  runtime (P271): rt_yieldpoint when the routine (r14, 0 on an M's own
  stack) has been asked to stop, Poisoned (-1314) in its guard; the
  compare takes no register. Tag names the place, so its label is
  unique. }
procedure TEmitter.YieldCheckX86(const Tag: string);
begin
  Line('  testq %r14, %r14');
  Line('  jz ' + Tag + '_ny');
  Line('  cmpq $-1314, 16(%r14)');
  Line('  jne ' + Tag + '_ny');
  Line('  call rt_yieldpoint');
  Line(Tag + '_ny:');
end;

{ The same on arm64, x28 the routine; Reg is a register the place may
  lose, and x30 is lost to the bl, so the place has saved it. }
procedure TEmitter.YieldCheckArm(const Tag, Reg: string);
begin
  Line('  cbz x28, ' + Tag + '_ny');
  Line('  ldr ' + Reg + ', [x28, #16]');
  Line('  cmn ' + Reg + ', #1314');
  Line('  b.ne ' + Tag + '_ny');
  Line('  bl rt_yieldpoint');
  Line(Tag + '_ny:');
end;

{ rt_yieldpoint on arm64, as above: x0-x17, x19-x27, x29 and x30 on
  the routine's stack and q0-q31 in a block of rt_xget (P342), x28 the
  routine; .pk_res gives back x19-x27 and returns to .yp_res. x9 and x10
  are the only registers it uses before it saves them, so they are
  saved first, the 16 bytes of AsyncRoom that its check counts. }
procedure TEmitter.EmitYieldPointArm;
var
  i: LongInt;
begin
  Line('rt_yieldpoint:');
  Line('  stp x9, x10, [sp, #-16]!');
  Line('  ldr w9, [x28, #184]');
  Line('  cbnz w9, .yp_no');
  { the room, as on amd64 (P342): what it writes below its caller's
    stack pointer above the real guard }
  Line('  sub x9, sp, #' + IntToStr(AsyncRoom - 16));
  Line('  ldr x10, [x28, #24]');
  Line('  cmp x9, x10');
  Line('  b.lo .yp_no');
  Line('  mov x9, sp');
  Line('  ldr x10, [x28, #8]');
  Line('  cmp x9, x10');
  Line('  b.hi .yp_no');
  { 30 general registers (x9 and x10 already above), the vector block's
    word at 248 }
  Line('  sub sp, sp, #256');
  i := 0;
  while i <= 8 do
  begin
    Line('  stp x' + IntToStr(i) + ', x' + IntToStr(i + 1) + ', [sp, #' + IntToStr(8 * i) + ']');
    i := i + 2;
  end;
  Line('  stp x11, x12, [sp, #88]');
  Line('  stp x13, x14, [sp, #104]');
  Line('  stp x15, x16, [sp, #120]');
  Line('  str x17, [sp, #136]');
  Line('  stp x19, x20, [sp, #144]');
  Line('  stp x21, x22, [sp, #160]');
  Line('  stp x23, x24, [sp, #176]');
  Line('  stp x25, x26, [sp, #192]');
  Line('  stp x27, x29, [sp, #208]');
  Line('  str x30, [sp, #224]');
  { the .pk_res layout, as .ms_preempt writes it }
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  stp x21, x22, [sp, #-16]!');
  Line('  stp x23, x24, [sp, #-16]!');
  Line('  stp x25, x26, [sp, #-16]!');
  Line('  stp x27, xzr, [sp, #-16]!');
  Line('  adr x10, .yp_res');
  Line('  str x10, [sp, #-16]!');
  XStopArm;
  Line('.yp_res:');
  XBackArm('.yp_put');
  i := 0;
  while i <= 8 do
  begin
    Line('  ldp x' + IntToStr(i) + ', x' + IntToStr(i + 1) + ', [sp, #' + IntToStr(8 * i) + ']');
    i := i + 2;
  end;
  Line('  ldp x11, x12, [sp, #88]');
  Line('  ldp x13, x14, [sp, #104]');
  Line('  ldp x15, x16, [sp, #120]');
  Line('  ldr x17, [sp, #136]');
  Line('  ldp x19, x20, [sp, #144]');
  Line('  ldp x21, x22, [sp, #160]');
  Line('  ldp x23, x24, [sp, #176]');
  Line('  ldp x25, x26, [sp, #192]');
  Line('  ldp x27, x29, [sp, #208]');
  Line('  ldr x30, [sp, #224]');
  Line('  add sp, sp, #256');
  Line('.yp_no:');
  Line('  ldp x9, x10, [sp], #16');
  Line('  ret');
  { rt_xget on arm64, as on amd64 (P342): the block in x3, on the M's
    stack with x28 0; x0, x4 to x12 and x30 change. The take compares
    the head it read with a load-exclusive pair and no access between. }
  Line('rt_xget:');
  Line('  str x30, [sp, #-16]!');
  LeaS('rt_xlock', 'x0');
  Line('  bl rt_lock');
  LeaS('rt_xfree', 'x4');
  Line('.xg_pop:');
  Line('  ldr x3, [x4]');
  Line('  cbz x3, .xg_map');
  Line('  ldr x5, [x3]');
  Line('.xg_try:');
  Line('  ldaxr x6, [x4]');
  Line('  cmp x6, x3');
  Line('  b.ne .xg_again');
  Line('  stxr w7, x5, [x4]');
  Line('  cbnz w7, .xg_try');
  Line('  b .xg_got');
  Line('.xg_again:');
  Line('  clrex');
  Line('  b .xg_pop');
  Line('.xg_map:');
  Line('  mov x0, xzr');
  Line('  mov x1, #16384');
  Line('  mov x2, #3');
  Line('  mov x3, #34');
  Line('  mov x4, #-1');
  Line('  mov x5, xzr');
  Line('  mov x8, #222');
  Line('  svc #0');
  Line('  cmn x0, #4095');
  Line('  b.hs rt_diemmap');
  Line('  mov x3, x0');
  Line('  add x5, x0, #' + IntToStr(XBlock));
  Line('  mov x7, #' + IntToStr(16384 - XBlock));
  Line('  add x6, x0, x7');
  Line('  mov x7, x5');
  Line('.xg_link:');
  Line('  cmp x7, x6');
  Line('  b.hs .xg_end');
  Line('  add x8, x7, #' + IntToStr(XBlock));
  Line('  str x8, [x7]');
  Line('  mov x7, x8');
  Line('  b .xg_link');
  Line('.xg_end:');
  LeaS('rt_xfree', 'x4');
  Line('.xg_put:');
  Line('  ldr x9, [x4]');
  Line('  str x9, [x6]');
  Line('.xg_putx:');
  Line('  ldxr x10, [x4]');
  Line('  cmp x10, x9');
  Line('  b.ne .xg_putc');
  Line('  stlxr w11, x5, [x4]');
  Line('  cbnz w11, .xg_putx');
  Line('  b .xg_got');
  Line('.xg_putc:');
  Line('  clrex');
  Line('  b .xg_put');
  Line('.xg_got:');
  LeaS('rt_xlock', 'x0');
  Line('  bl rt_unlock');
  Line('  ldr x30, [sp], #16');
  Line('  ret');
end;

{ The end of a stop on arm64, as XStopX86 (P342): the guard back, where
  the routine resumes, then on the M's stack q0-q31 into a block of
  rt_xget and its address into the save area's word at 248, before the
  routine is queued. }
procedure TEmitter.XStopArm;
var
  i: LongInt;
begin
  Line('  ldr x9, [x28, #24]');
  Line('  str x9, [x28, #16]');
  Line('  mov x9, sp');
  Line('  str x9, [x28, #40]');
  Line('  str x29, [x28, #56]');
  Line('  adr x10, .pk_res');
  Line('  str x10, [x28, #48]');
  Line('  ldr x21, [x28, #32]');
  Line('  ldr x9, [x21, #32]');
  Line('  mov sp, x9');
  Line('  mov x29, xzr');
  Line('  mov x19, x28');
  Line('  mov x28, xzr');
  Line('  bl rt_xget');
  Line('  ldr x9, [x19, #40]');
  Line('  str x3, [x9, #344]');
  i := 0;
  while i <= 30 do
  begin
    Line('  stp q' + IntToStr(i) + ', q' + IntToStr(i + 1) + ', [x3, #' + IntToStr(16 * i) + ']');
    i := i + 2;
  end;
  Line('  mov x0, x19');
  Line('  bl rt_globput');
  Line('  b rt_yieldwake');
end;

{ Its return at L, sp at the save area: q0-q31 from the block and the
  block back on rt_xfree by a load-exclusive pair with no access between
  (rt_xget says why no lock); x9 to x13 and the flags change. }
procedure TEmitter.XBackArm(const L: string);
var
  i: LongInt;
begin
  Line('  ldr x9, [sp, #248]');
  i := 0;
  while i <= 30 do
  begin
    Line('  ldp q' + IntToStr(i) + ', q' + IntToStr(i + 1) + ', [x9, #' + IntToStr(16 * i) + ']');
    i := i + 2;
  end;
  LeaS('rt_xfree', 'x10');
  Line(L + ':');
  Line('  ldr x11, [x10]');
  Line('  str x11, [x9]');
  Line(L + 'x:');
  Line('  ldxr x12, [x10]');
  Line('  cmp x12, x11');
  Line('  b.ne ' + L + 'c');
  Line('  stlxr w13, x9, [x10]');
  Line('  cbnz w13, ' + L + 'x');
  Line('  b ' + L + 'd');
  Line(L + 'c:');
  Line('  clrex');
  Line('  b ' + L);
  Line(L + 'd:');
end;

{ rt_asyncpreempt on arm64 (P293): rt_sigurg left the interrupted
  link register on the stack in 16 bytes of its own and made the link
  register the interrupted pc, as Go's pushCall does (signal_arm64.go).
  Every general register but x18, the flags (NZCV) and FPSR go on the
  routine's stack and q0 to q31 in a block of rt_xget (P342; Go's
  preempt_arm64.s keeps the same, the vector ones in p.xRegs), the
  routine parks as rt_yieldpoint parks, and it comes back by x18, which
  paslang's code never holds a value in: Go comes back by R27, which is
  paslang's static link. }
procedure TEmitter.EmitAsyncPreemptArm;
var
  i: LongInt;
begin
  Line('rt_asyncpreempt:');
  Line('  sub sp, sp, #256');
  i := 0;
  while i <= 16 do
  begin
    Line('  stp x' + IntToStr(i) + ', x' + IntToStr(i + 1) + ', [sp, #' + IntToStr(8 * i) + ']');
    i := i + 2;
  end;
  Line('  stp x19, x20, [sp, #144]');
  Line('  stp x21, x22, [sp, #160]');
  Line('  stp x23, x24, [sp, #176]');
  Line('  stp x25, x26, [sp, #192]');
  Line('  stp x27, x29, [sp, #208]');
  Line('  str x30, [sp, #224]');
  Line('  mrs x9, nzcv');
  Line('  str x9, [sp, #232]');
  Line('  mrs x9, fpsr');
  Line('  str x9, [sp, #240]');
  { the .pk_res layout, as rt_yieldpoint writes it }
  Line('  stp x19, x20, [sp, #-16]!');
  Line('  stp x21, x22, [sp, #-16]!');
  Line('  stp x23, x24, [sp, #-16]!');
  Line('  stp x25, x26, [sp, #-16]!');
  Line('  stp x27, xzr, [sp, #-16]!');
  Line('  adr x10, .apx_ares');
  Line('  str x10, [sp, #-16]!');
  XStopArm;
  Line('.apx_ares:');
  XBackArm('.apx_put');
  Line('  ldr x9, [sp, #240]');
  Line('  msr fpsr, x9');
  Line('  ldr x9, [sp, #232]');
  Line('  msr nzcv, x9');
  i := 0;
  while i <= 16 do
  begin
    Line('  ldp x' + IntToStr(i) + ', x' + IntToStr(i + 1) + ', [sp, #' + IntToStr(8 * i) + ']');
    i := i + 2;
  end;
  Line('  ldp x19, x20, [sp, #144]');
  Line('  ldp x21, x22, [sp, #160]');
  Line('  ldp x23, x24, [sp, #176]');
  Line('  ldp x25, x26, [sp, #192]');
  Line('  ldp x27, x29, [sp, #208]');
  Line('  ldr x18, [sp, #224]');
  Line('  add sp, sp, #256');
  Line('  ldr x30, [sp], #16');
  Line('  br x18');
  { rt_sigurg: SIGURG on the M's alternate stack (x0 the signal, x1 the
    siginfo, x2 the ucontext: the registers from 184, x28 at 408, x30 at
    424, sp at 432, pc at 440), with the conditions of the amd64 one }
  Line('rt_sigurg:');
  { PASLANG_ASYNCPREEMPTOFF stops nothing (pasheap's HAsyncOff) }
  LeaS('rt_heapstate', 'x14');
  Line('  ldr x14, [x14, #544]');
  Line('  cbnz x14, .asgu_ret');
  { the pc first, as on amd64: only in compiled code is x28 the routine }
  Line('  ldr x13, [x2, #440]');
  LeaS('rt_asynclo', 'x14');
  Line('  ldr x14, [x14]');
  Line('  cbz x14, .asgu_ret');
  LeaS('rt_asynchi', 'x15');
  Line('  ldr x15, [x15]');
  Line('  sub x15, x15, x14');
  Line('  lsr x15, x15, #4');
  Line('  mov x16, xzr');
  Line('.asgu_bs:');
  Line('  cmp x16, x15');
  Line('  b.hs .asgu_bd');
  Line('  add x17, x16, x15');
  Line('  lsr x17, x17, #1');
  Line('  lsl x10, x17, #4');
  Line('  ldr x10, [x14, x10]');
  Line('  cmp x13, x10');
  Line('  b.lo .asgu_lo');
  Line('  add x16, x17, #1');
  Line('  b .asgu_bs');
  Line('.asgu_lo:');
  Line('  mov x15, x17');
  Line('  b .asgu_bs');
  Line('.asgu_bd:');
  Line('  cbz x16, .asgu_ret');
  Line('  sub x16, x16, #1');
  Line('  lsl x16, x16, #4');
  Line('  add x16, x16, #8');
  Line('  ldr x10, [x14, x16]');
  Line('  cmp x13, x10');
  Line('  b.hs .asgu_ret');
  Line('  ldr x9, [x2, #408]');
  Line('  cbz x9, .asgu_ret');
  Line('  ldr w10, [x9, #152]');
  Line('  cbnz w10, .asgu_ret');
  Line('  ldr x10, [x9, #16]');
  Imm('x11', -1314);
  Line('  cmp x10, x11');
  Line('  b.ne .asgu_ret');
  Line('  ldr w10, [x9, #184]');
  Line('  cbnz w10, .asgu_ret');
  Line('  ldr x12, [x2, #432]');
  Line('  ldr x10, [x9, #8]');
  Line('  cmp x12, x10');
  Line('  b.hi .asgu_ret');
  Line('  ldr x10, [x9, #24]');
  Line('  add x10, x10, #' + IntToStr(AsyncRoom));
  Line('  cmp x12, x10');
  Line('  b.lo .asgu_ret');
  Line('  ldr x10, [x2, #424]');
  Line('  sub x12, x12, #16');
  Line('  str x10, [x12]');
  Line('  str xzr, [x12, #8]');
  Line('  str x12, [x2, #432]');
  Line('  str x13, [x2, #424]');
  LeaS('rt_asyncpreempt', 'x10');
  Line('  str x10, [x2, #440]');
  Line('.asgu_ret:');
  Line('  ret');
  { rt_asyncinit, at the start: the pasasync table by its starts, as on
    amd64 }
  Line('rt_asyncinit:');
  LeaS('__start_pasasync', 'x9');
  LeaS('__stop_pasasync', 'x10');
  Line('  cbz x9, .aaix_none');
  Line('  cmp x10, x9');
  Line('  b.ls .aaix_none');
  Line('  add x11, x9, #16');
  Line('.aaix_out:');
  Line('  cmp x11, x10');
  Line('  b.hs .aaix_done');
  Line('  ldp x12, x13, [x11]');
  Line('  mov x14, x11');
  Line('.aaix_in:');
  Line('  cmp x14, x9');
  Line('  b.ls .aaix_put');
  Line('  ldp x15, x16, [x14, #-16]');
  Line('  cmp x15, x12');
  Line('  b.ls .aaix_put');
  Line('  stp x15, x16, [x14]');
  Line('  sub x14, x14, #16');
  Line('  b .aaix_in');
  Line('.aaix_put:');
  Line('  stp x12, x13, [x14]');
  Line('  add x11, x11, #16');
  Line('  b .aaix_out');
  Line('.aaix_done:');
  LeaS('rt_asynclo', 'x11');
  Line('  str x9, [x11]');
  LeaS('rt_asynchi', 'x11');
  Line('  str x10, [x11]');
  Line('.aaix_none:');
  Line('  ret');
  Line('  .ltorg');
end;

procedure TEmitter.EmitXxh3X86;
begin
{ rt_xxh3: XXH3, 64 bits, with a seed, as the reference's
  XXH3_64bits_withSeed (xxhash 0.8): rax the bytes, rdx how many, r9 the
  seed; the hash in rax. Up to 16 bytes one read or two and a multiply,
  up to 240 folded 128-bit products of 16-byte pieces, beyond that the
  eight accumulators of 64-byte stripes in vector registers, AVX2 when
  rt_heapinit found it (heap state +512) and SSE2 otherwise, with the secret the
  seed derives on the stack. Keeps rbx, rbp, r12 to r15 (P97, 1.0.63). }
