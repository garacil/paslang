    in its prologue, x16 the first word and x17 how many, as the loop it
    takes the place of; every other register kept, the arguments in x0
    to x7 among them. }
  Line('rt_zerobig:');
  Line('  stp x0, x1, [sp, #-32]!');
  Line('  stp x2, x30, [sp, #16]');
  Line('  mov x0, x16');
  Line('  lsl x1, x17, #3');
  Line('  mov w2, wzr');
  Line('  bl rt_fillbig');
  Line('  ldp x2, x30, [sp, #16]');
  Line('  ldp x0, x1, [sp], #32');
  Line('  ret');
  Line('rt_decoderune:');
