  Line('  cbnz w9, .lk_proc');
  Line('  stxr w10, w11, [x0]');
  Line('  cbnz w10, .lk_act');
  Line('  b .lk_got');
  Line('.lk_proc:');
  Line('  clrex');
  Line('  mov w9, #30');
