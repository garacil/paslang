  Line('  cmpq $1, %rbx');
  Line('  jne .ml_sp1');
  Line('  movq $1, 72(%r13)');
  Line('.ml_sp1:');
  Line('  call rt_findrunnable');
  Line('  movq $0, 72(%r13)');
  Line('  testq %rax, %rax');
  Line('  jnz .ml_run');
  Line('  pause');
  Line('  pause');
  Line('  pause');
  Line('  pause');
  Line('  decq %rbx');
  Line('  jnz .ml_sp');
  Line('  movq $0, 56(%r13)');
  Line('  lock decq rt_nspinning(%rip)');
  Line('  call rt_findrunnable');
  Line('  testq %rax, %rax');
  Line('  jz .ml_idle');
  Line('  lock incq rt_nspinning(%rip)');
  Line('  movq $1, 56(%r13)');
