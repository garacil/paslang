  Line('  xorq %rax, %rax');
  Line('  xchgq %rax, (%rdi)');
  Line('  testq %rax, %rax');
  Line('  jz .wtk_ret');
  Line('  xorq %rdx, %rdx');
  Line('  movq %rax, %r8');
