function NewRange(A, B: PExpr): PExpr;
begin
  New(Result);
  Result^ := Default(TExpr);
  Result^.Kind := ekRange;
  Result^.L := A;
  Result^.R := B;
  Result^.Typ := A^.Typ;
end;

function NewAddr(E: PExpr): PExpr;
begin
  New(Result);
  Result^ := Default(TExpr);
  Result^.Kind := ekAddr;
  Result^.L := E;
  if E <> nil then
    Result^.Typ := E^.Typ
  else
    Result^.Typ := TyInteger;
end;

function NewStmt(K: TStmtKind): PStmt;
begin
  New(Result);
  Result^ := Default(TStmt);
  Result^.Kind := K;
end;

{ The name an on handler gives the object it takes (P122) is a hidden
  variable of the routine, Name.onN: the program's own, which a closure
  keeps as it keeps any other and the debugger shows as Name, where the
  other hidden names (a dot in them) are the compiler's. Its Name, or ''
  for any other name. }
function OnVarUser(const N: string): string;
var
  i, d: SizeInt;
begin
  Result := '';
  d := 0;
  for i := Length(N) downto 1 do
    if N[i] = '.' then
    begin
      d := i;
      Break;
    end;
  if (d < 2) or (Length(N) < d + 3) or (N[d + 1] <> 'o') or (N[d + 2] <> 'n') then
    Exit;
  for i := d + 3 to Length(N) do
    if (N[i] < '0') or (N[i] > '9') then
      Exit;
  for i := 1 to d - 1 do
    if N[i] = '.' then
      Exit;
  Result := Copy(N, 1, d - 1);
end;

end.
