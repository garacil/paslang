unit pasast;

interface

const
  TyNone = 0;
  TyInteger = 1;
  TyBoolean = 2;
  TyString = 3;
  TyChar = 4;
  TyReal = 5;
  { P99 (1.0.87): one id for each row of the integers in TYPES.md, and two
    kept for Single (P101) and the untyped Pointer (P102). Every builtin
    has the same id in every compilation and every .pi (PASLANGI5). }
  TyByte = 6;
  TyInt8 = 7;
  TyWord = 8;
  TyInt16 = 9;
  TyUInt32 = 10;
  TyInt32 = 11;
  TySingle = 12;
  TyPointer = 13;
  { IEEE binary128 in software (P103, 1.0.114): two words, no pointer. }
  TyQuad = 14;
  { V128 and V256 (P106, 1.0.125): 16 and 32 bytes the vector words take
    as lanes of 8, 16, 32 or 64 bits; a record of no fields to the rest
    of the compiler, so assignment, parameters, fields, arrays and views
    work as for any record. }
  TyV128 = 15;
  TyV256 = 16;
  { A checked signed integer of ten-thousandths (P152). }
  TyCurrency = 17;
  TyLastBuiltin = 17;
  { A class member's visibility (1.0.137), as FPC enforces it. }
  VisPublic = 0;
  VisProtected = 1;
  VisPrivate = 2;
  VisStrictProtected = 3;
  VisStrictPrivate = 4;
  { A method call's slot (TExpr.Off, a call statement's E2) at or below
    this one is a class method's virtual call (P123): Self is the class's
    method table and the code is in its slot ClsSlotBase - Off. -1 is a
    call by name, -2 to -4 the method, interface and routine values. }
  ClsSlotBase = -16;
  { array of const (P124): a slice of TVarRec whose Elem2 is this mark,
    a parameter's type only; the list a call gives is built in the
    caller's frame and lives for the call. }
  ConstArrMark = -7;
  { TVarRec's kinds (P124), Free Pascal's numbers; vtQuad is paslang's.
    An integer of any width is vtInteger, its VInteger 64 bits. }
  VrInteger = 0;
  VrBoolean = 1;
  VrChar = 2;
  VrExtended = 3;
  VrPointer = 5;
  VrPChar = 6;
  VrObject = 7;
  VrClass = 8;
  VrAnsiString = 11;
  VrCurrency = 12;
  VrInterface = 14;
  VrQuad = 19;

  { MakeChan(n) buffers up to this many values (1.0.136): a word each,
    512 MiB, under the heap's largest block of 1 GiB; -1 divided by zero
    in the heap and 2^61 wrote past the ring. }
  ChanCapMax = 67108864;

type
  TBinOp = (
    boAdd, boSub, boMul, boDiv, boMod,
    boEq, boNe, boLt, boLe, boGt, boGe,
    boAnd, boOr, boXor, boConcat, boIn, boIs, boAs, boShl, boShr,
    boSlash
  , boSar, boRol, boRor, boMulHi, boMulHiS);

  { uoConv: L converted to the node's type, a narrow integer, keeping
    the low bits (P99); a conversion that widens needs no node. The bit
    words of P105 (1.0.117) work in L's width: uoPopCnt, uoClz and uoCtz
    give an Integer, uoRbit and uoBswap L's type. }
  TUnOp = (uoNeg, uoNot, uoConv, uoPopCnt, uoClz, uoCtz, uoRbit, uoBswap);

  TExprKind = (
    ekInt, ekStr, ekVar, ekBin, ekUn, ekCall,
    ekField, ekDeref, ekIndex, ekNil, ekMakeChan, ekRecv,
    ekMethod, ekMethPtr, ekCtor, ekSet, ekRange, ekAddr, ekProp, ekReal,
    ekProcPtr
  );

  PExpr = ^TExpr;
  TExprArray = array of PExpr;
  TExpr = record
    Kind: TExprKind;
    Num: Int64;
    Txt: string;
    Name: string;
    Bin: TBinOp;
    Un: TUnOp;
    L, R: PExpr;
    Args: TExprArray;
    Typ: LongInt;
    Off: LongInt;
    Flags: LongInt;   { bit 0: an integer constant with no type of its own, a literal or a plain const, that takes the type an integer context wants (P99); bit 4: an address that is a var or out argument (1.1.1) }
    Hi: Int64;        { a Quad literal's high word; Num holds the low one (P103) }
    QLo: Int64;       { with Hi, a real constant's binary128 value when Flags bit 1 is set (1.0.115) }
  end;

  TStmtKind = (
    skAssign, skWrite, skWriteLn, skIf, skWhile, skFor, skRepeat,
    skBlock, skCase, skCall, skNew, skPas, skSend, skClose, skSelect,
    skReadLn, skSleep, skTry, skRaise, skWith, skForIn, skExit, skHalt, skInc, skDec,
    skBreak, skContinue, skAsm
  );

  PStmt = ^TStmt;
  TStmtArray = array of PStmt;

  TCaseArm = record
    Vals: array of Int64;     { each label, or the low end of a range }
    His: array of Int64;      { its high end: Vals[i]..His[i] (1.0.78) }
    Strs: array of string;    { the labels of a case of a string (1.0.78) }
    Body: PStmt;
  end;
  TCaseArmArray = array of TCaseArm;

  TSelKind = (selSend, selRecv, selDefault);
  TSelArm = record
    Kind: TSelKind;
    Chan: PExpr;
    ValX: PExpr;
    Dest: string;
    Body: PStmt;
  end;
  TSelArmArray = array of TSelArm;

  TStmt = record
    Kind: TStmtKind;
    Line: LongInt;
    Name: string;
    E, E2: PExpr;
    Dest: PExpr;
    Args: TExprArray;
    ThenSt, ElseSt, Body: PStmt;
    Down: Boolean;
    Stmts: TStmtArray;
    Arms: TCaseArmArray;
    Sels: TSelArmArray;
  end;

  { tykHelper (P127): a type, record or class helper; Elem the type it
    is for, Parent the helper it descends from, Meths and Props its
    members, each method a routine whose first parameter is Self. }
  { tykClassRef (P123): class of T, a value that holds a class, the
    address of its method table; Elem is T. }
  TTypeKind = (tykNone, tykInteger, tykBoolean, tykString, tykRecord, tykPointer, tykArray, tykChan, tykClass, tykMethod, tykGeneric, tykParam, tykEnum, tykSubrange, tykSet, tykInterface, tykReal, tykMap, tykProc, tykQuad, tykTree, tykHeap, tykStore, tykClassRef, tykHelper, tykCurrency, tykJson);

  { Vis of a class's member (1.0.137): 0 public or published, 1
    protected, 2 private, 3 strict protected, 4 strict private (VisPublic
    and on); a record's fields and an interface's methods are 0. }
  TField = record
    Name: string;
    Off: LongInt;
    Typ: LongInt;
    Vis: Byte;
    Sym: string;   { a class variable's global (P123), in TTypeDef.CVars; '' for a field }
  end;
  TFieldArray = array of TField;

  TMethInfo = record
    Name: string;
    Sym: string;
    IsCtor: Boolean;
    IsVirt: Boolean;
    IsFunc: Boolean;
    Slot: LongInt;
    NParams: LongInt;
    RetTyp: LongInt;
    ParamTyps: array of LongInt;
    ByRef: array of Boolean;
    IsAbs: Boolean;
    Vis: Byte;
    IsDtor: Boolean;       { a destructor: an outermost call runs BeforeDestruction first (P121) }
    IsClassMeth: Boolean;  { class function or class procedure: Self is the class (P121) }
    IsStatic: Boolean;     { a class method declared static: no Self at all (P121) }
    HasDef: array of Boolean;  { a parameter's default value (P125), as a routine's: }
    Def: array of Int64;       { the value, or a set's bits; 0 is nil for a pointer's kin }
    DefStr: array of string;   { a string's, a Quad's 16 bytes }
  end;
  TMethArray = array of TMethInfo;

  TPropInfo = record
    Name: string;
    Typ: LongInt;
    ReadOff: LongInt;
    WriteOff: LongInt;
    ReadName: string;
    WriteName: string;
    NIndex: LongInt;
    IsPublished: Boolean;
    Vis: Byte;
    IsClass: Boolean;   { a class property (P123): its accessors are class variables or static class methods }
  end;
  TPropArray = array of TPropInfo;

  { A name owned by a class, record or helper (P169). Kind 0 is a
    type, 1 an untyped constant, 2 a typed constant's global storage.
    Ref is the unit-qualified constant name or global symbol. }
  TScopedName = record
    Name: string;
    Kind, Vis: Byte;
    Typ: LongInt;
    Ref: string;
  end;
  TScopedNames = array of TScopedName;

  TTypeDef = record
    Name: string;
    Kind: TTypeKind;
    Size: LongInt;
    Fields: TFieldArray;
    Meths: TMethArray;
    Props: TPropArray;
    VmtN: LongInt;
    Parent: LongInt;
    Elem: LongInt;
    Elem2: LongInt;
    Lo, Hi: Int64;
    Ifaces: array of LongInt;
    Imported: Boolean;    { came from a unit's .pi: its VMT lives there }
    CVars: TFieldArray;   { a class's class variables (P123): globals, a descendant's the same ones }
    Sym: string;          { the stem of a class's, an interface's or a helper's symbols (P154):
                            unit_name for a unit's, '' for a program's (its name) }
    ScopeOwner: LongInt;   { enclosing named type, independent of inheritance (P169) }
    Nested: TScopedNames;
    SpecOrigin, SpecArg: LongInt; { generic instance identity, not its spelling (P176) }
  end;
  TTypeDefArray = array of TTypeDef;

  TStrArray = array of string;

  TVarDecl = record
    Name: string;
    Typ: LongInt;
    Init: string;
    Sym: string;      { the name in the assembly when not Name: unit.Name for a unit's global (1.0.76) }
    Ext: Boolean;     { another unit's global: its storage is there }
    Pub: Boolean;     { in a unit's interface: exported }
    Alias: Boolean;   { absolute (P144): another name for the global Sym names; no storage of its own }
    Rel: array of LongInt;   { a typed constant: the offsets in Init that hold a string's data address (1.0.77) }
    RelStr: TStrArray;       { and those strings }
  end;
  TVarDeclArray = array of TVarDecl;

  TParam = record
    Name: string;
    Typ: LongInt;
    ByRef: Boolean;
    IsConst: Boolean;   { const: the caller's value itself, never changed nor copied in (1.1.1) }
    HasDef: Boolean;
    Def: Int64;
    DefStr: string;
    At: string;         { ' at L:C' of its name, where a duplicate is told (P151) }
  end;
  TParamArray = array of TParam;

  TProc = record
    Name: string;
    Sym: string;
    IsFunc: Boolean;
    IsExt: Boolean;
    InIface: Boolean;
    Params: TParamArray;
    Locals: TVarDeclArray;
    RetTyp: LongInt;
    Nest: LongInt;
    ParentSym: string;
    ClassTyp: LongInt;
    SelfTyp: LongInt;  { a class method's Self (P123): class of ClassTyp, the table; 0 an object of ClassTyp }
    NoSelf: Boolean;   { a static class method (P123): ClassTyp's name space, and no Self at all }
    RecCtor: Boolean;  { a record's constructor (P165): a method on Self; TRec.Create calls its maker, Sym.new }
    HelperTyp: LongInt; { a helper's method (P127): the helper; Self is Params[0], none for a static one }
    IsCtor: Boolean;
    IsFwd: Boolean;
    IsOver: Boolean;
    InPlace: Boolean;  { declared inline: put in place where it is called whatever its size (P112) }
    Safe: Boolean;   { declared safe: no raw pointer work in its body (P102) }
    Body: PStmt;
    { Closures (P109, 1.0.134): a routine with a closure anywhere inside
      keeps the variables its nested routines use (Shared) in a heap
      box, so they outlive its frame; a closure made in a loop whose
      counter it uses copies that pass's cells (Pins) when it is made. }
    Boxing: Boolean;
    IsAnon: Boolean;
    Shared: TStrArray;
    Pins: TStrArray;
    { The processor its code is compiled for (P261): the $CPU and
      $TUNE in force where its body stands, over -cpu and -tune; when
      CpuOwn is False, the program's (a routine the compiler makes). }
    CpuOwn: Boolean;
    CpuSet: Int64;
    CpuTune: LongInt;
  end;
  TProcArray = array of TProc;


  TConstDecl = record
    Name: string;
    Value: Int64;
    Typ: LongInt;   { TyInteger (also an enum), TyReal, TyString, TyChar, TyBoolean }
    Txt: string;
    QLo, QHi: Int64;  { a real one worked out in binary128 too (P103, 1.0.115) }
    HasQ: Boolean;
  end;
  TConstDeclArray = array of TConstDecl;

  TProgram = record
    IsUnit: Boolean;
    IsPackage: Boolean;
    Safe: Boolean;       { declared safe unit or program (P102) }
    CheckPtr: Boolean;   { compiled with -checkptr (P104) }
    InlineMax: LongInt;  { -inline: the largest body put in place where it is called, 0 none (P112) }
    Debug: Boolean;      { compiled with -debug (P118): a hook at every statement, the tables of section pasdbg, the debugger unit }
    Name: string;
    SrcName: string;
    UsesNames: TStrArray;
    LinkObjs: TStrArray;
    Checksum: string;
    DepNames: TStrArray;    { every unit loaded while this one compiled }
    DepSums: TStrArray;     { and the interface checksum each one had }
    Types: TTypeDefArray;
    TypeNames: array of string;
    IfaceTypes: LongInt;   { how many types a unit's interface had declared: a named type past them is the implementation's, and its .pi does not name it (P110) }
    CpuSet: Int64;         { the processor the code is compiled for (-cpu, P111): the bits CpuFeatBit names }
    CpuTune: LongInt;      { the processor whose costs choose between forms that do the same (-tune, P261): its place in the table of CpuProcName, 0 none }
    MainCpu: Int64;        { the processor of the main block, and of a unit's initialization and finalization: the directives in force there (P261) }
    CpuProc: LongInt;      { the processor -cpu names, its place in CpuProcName's table, 0 when it names none (base, max, a level, a feature); -tune does not change it (P273) }
    MainTune: LongInt;
    TypeIds: array of LongInt;
    Vars: TVarDeclArray;
    Procs: TProcArray;
    Consts: TConstDeclArray;
    Body: PStmt;
    InitBody: PStmt;
    FiniBody: PStmt;
  end;

function ProcSym(const UnitName, ProcName: string): string;
function TypeStemOf(const Td: TTypeDef): string;
function IsIntId(T: LongInt): Boolean;
function IsNarrowId(T: LongInt): Boolean;
function WrapInt(V: Int64; T: LongInt): Int64;
function IntBits(T: LongInt): LongInt;
function FoldBitUn(Op: TUnOp; V: Int64; T: LongInt): Int64;
function WidthUn(Op: TUnOp): Boolean;
function BitUnOp(Op: TUnOp): Boolean;
function FoldMulHi(A, B: Int64; Signed: Boolean): Int64;
function CpuFeatBit(const Name: string; Arm: Boolean): LongInt;
function CpuSetOf(const Spec: string; Arm: Boolean; Native: Int64; out Err: string): Int64;
function CpuFeatNames(Arm: Boolean): string;
function CpuProcIndex(const Name: string; Arm: Boolean): LongInt;
function CpuProcName(Idx: LongInt): string;
function CpuProcNames(Arm: Boolean): string;
function CpuSpecTune(const Spec: string; Arm: Boolean): LongInt;
function CpuIdentX86(const Vendor: string; Family, Model: LongInt): LongInt;
function CpuIdentArm(Midr: Int64): LongInt;
function CpuCostLzcntBsr(Tune: LongInt): Boolean;
function CpuZvaBlock(Proc: LongInt): LongInt;
function CpuSetNames(ASet: Int64; Arm: Boolean): string;

var
  { The machine compiling (P261): whether the target is that machine,
    its features and the table's name for it ('' when the table does not
    have it), what native says. }
  CpuHostTarget: Boolean;
  CpuHostSet: Int64;
  CpuHostProc: string;

function WritesFirst(S: PStmt; const N, Alias: string): Boolean;
function NewInt(V: Int64): PExpr;
function NewReal(V: Int64): PExpr;
function NewStr(const S: string): PExpr;
function NewVar(const N: string; Typ: LongInt): PExpr;
function NewBin(Op: TBinOp; A, B: PExpr): PExpr;
function NewUn(Op: TUnOp; A: PExpr): PExpr;
function NewCall(const N: string; const Args: TExprArray; Typ: LongInt): PExpr;
function NewNil: PExpr;
function NewMakeChan(Elem: LongInt): PExpr;
function NewRecv(C: PExpr): PExpr;
function NewMethod(SelfE: PExpr; const Sym: string; const Args: TExprArray; Typ, Slot: LongInt): PExpr;
function NewProcPtr(const Sym: string; Typ: LongInt): PExpr;
function NewMethPtr(SelfE: PExpr; const Sym: string; Slot: LongInt): PExpr;
function NewCtor(const Sym: string; Typ, Sz: LongInt): PExpr;
function NewField(Base: PExpr; const N: string; Typ, Off: LongInt): PExpr;
function NewProp(Base: PExpr; Typ, ReadOff, WriteOff: LongInt;
  const ReadMeth, WriteMeth: string): PExpr;
function NewDeref(Base: PExpr; Typ: LongInt): PExpr;
function NewIndex(Base, Ix: PExpr; Typ: LongInt): PExpr;
function NewSet(const Elems: TExprArray; Typ: LongInt): PExpr;
function NewRange(A, B: PExpr): PExpr;
function NewAddr(E: PExpr): PExpr;
function NewStmt(K: TStmtKind): PStmt;
function OnVarUser(const N: string): string;

implementation

function ProcSym(const UnitName, ProcName: string): string;
var
  u, n: string;
  i: SizeInt;
begin
  u := '';
  n := '';
  for i := 1 to Length(UnitName) do
    if (UnitName[i] >= 'A') and (UnitName[i] <= 'Z') then
      u := u + Char(Ord(UnitName[i]) + 32)
    else
      u := u + UnitName[i];
  for i := 1 to Length(ProcName) do
    if (ProcName[i] >= 'A') and (ProcName[i] <= 'Z') then
      n := n + Char(Ord(ProcName[i]) + 32)
    else
      n := n + ProcName[i];
  if u = '' then
    Result := 'p_' + n
  else
    Result := 'p_' + u + '_' + n;
end;

{ The stem of a type's symbols (P154): vmt_<stem>, rtti_<stem>,
  ivmt_<stem>_<iface stem>, p_<stem>_<method>. A unit's class carries
  the unit's name, as its routines do (p_unit_name), so two units may
  each declare a TFoo and a program use both; a program's and a core
  unit's keep the name alone, as before. }
function TypeStemOf(const Td: TTypeDef): string;
var
  i: SizeInt;
begin
  if Td.Sym <> '' then
  begin
    Result := Td.Sym;
    Exit;
  end;
  Result := '';
  for i := 1 to Length(Td.Name) do
    if (Td.Name[i] >= 'A') and (Td.Name[i] <= 'Z') then
      Result := Result + Char(Ord(Td.Name[i]) + 32)
    else
      Result := Result + Td.Name[i];
end;

{ Integer or one of the narrow integers (P99); Char is not one. }
function IsIntId(T: LongInt): Boolean;
begin
  Result := (T = TyInteger) or ((T >= TyByte) and (T <= TyInt32));
end;

{ Byte to Int32: the integers narrower than a word (P99). }
function IsNarrowId(T: LongInt): Boolean;
begin
  Result := (T >= TyByte) and (T <= TyInt32);
end;

{ A unary operation worked out in the width the context gives (P99):
  - and not. A conversion and the bit words keep their operand's. }
function WidthUn(Op: TUnOp): Boolean;
begin
  Result := (Op = uoNeg) or (Op = uoNot);
end;

{ The bit words of P105 (1.0.117). }
function BitUnOp(Op: TUnOp): Boolean;
begin
  Result := (Op = uoPopCnt) or (Op = uoClz) or (Op = uoCtz) or (Op = uoRbit) or
    (Op = uoBswap);
end;

{ CpuHas's names (P106, 1.0.124): the bit of rt_cpufeat that says a
  feature is there, on arm64 when Arm says so and on amd64 if not; 64
  when that machine always has it, -1 when it never does, -2 for a name
  neither machine knows. amd64's bits are cpuid's, gated by what the
  kernel saves (xgetbv); arm64's are AT_HWCAP's low 32 bits with
  AT_HWCAP2's low 32 above them. A few names are both machines' (aes,
  pclmul/pmull, crc32, sha1, sha2, rng, fma, lzcnt, popcnt, simd128). }
function CpuFeatBit(const Name: string; Arm: Boolean): LongInt;
var
  n: string;
  i: SizeInt;
  x, a: LongInt;
begin
  n := Name;
  for i := 1 to Length(n) do
    if (n[i] >= 'A') and (n[i] <= 'Z') then
      n[i] := Chr(Ord(n[i]) + 32);
  x := -2;
  a := -2;
  if n = 'sse2' then
  begin
    x := 64;
    a := -1;
  end
  else if n = 'sse3' then
  begin
    x := 1;
    a := -1;
  end
  else if n = 'ssse3' then
  begin
    x := 2;
    a := -1;
  end
  else if n = 'sse41' then
  begin
    x := 3;
    a := -1;
  end
  else if n = 'sse42' then
  begin
    x := 4;
    a := -1;
  end
  else if n = 'popcnt' then
  begin
    x := 5;
    a := 1;
  end
  else if n = 'aes' then
  begin
    x := 6;
    a := 3;
  end
  else if n = 'pclmul' then
  begin
    x := 7;
    a := 4;
  end
  else if n = 'pmull' then
  begin
    x := 7;
    a := 4;
  end
  else if n = 'avx' then
  begin
    x := 8;
    a := -1;
  end
  else if n = 'fma' then
  begin
    x := 9;
    a := 64;
  end
  else if n = 'f16c' then
  begin
    x := 10;
    a := -1;
  end
  else if n = 'movbe' then
  begin
    x := 11;
    a := -1;
  end
  else if n = 'rdrand' then
  begin
    x := 12;
    a := 48;
  end
  else if n = 'rng' then
  begin
    x := 12;
    a := 48;
  end
  else if n = 'avx2' then
  begin
    x := 13;
    a := -1;
  end
  else if n = 'bmi1' then
  begin
    x := 14;
    a := -1;
  end
  else if n = 'bmi2' then
  begin
    x := 15;
    a := -1;
  end
  else if n = 'adx' then
  begin
    x := 16;
    a := -1;
  end
  else if n = 'rdseed' then
  begin
    x := 17;
    a := -1;
  end
  else if n = 'sha' then
  begin
    x := 18;
    a := -1;
  end
  else if n = 'sha1' then
  begin
    x := 18;
    a := 5;
  end
  else if n = 'sha2' then
  begin
    x := 18;
    a := 6;
  end
  else if n = 'erms' then
  begin
    x := 19;
    a := -1;
  end
  else if n = 'avx512f' then
  begin
    x := 20;
    a := -1;
  end
  else if n = 'avx512bw' then
  begin
    x := 21;
    a := -1;
  end
  else if n = 'avx512vl' then
  begin
    x := 22;
    a := -1;
  end
  else if n = 'avx512dq' then
  begin
    x := 23;
    a := -1;
  end
  else if n = 'vaes' then
  begin
    x := 24;
    a := -1;
  end
  else if n = 'vpclmulqdq' then
  begin
    x := 25;
    a := -1;
  end
  else if n = 'gfni' then
  begin
    x := 26;
    a := -1;
  end
  else if n = 'lzcnt' then
  begin
    x := 27;
    a := 64;
  end
  else if n = 'avx512vbmi' then
  begin
    x := 28;
    a := -1;
  end
  else if n = 'avx512vnni' then
  begin
    x := 29;
    a := -1;
  end
  else if n = 'cx16' then
  begin
    x := 30;
    a := 64;
  end
  else if n = 'crc32' then
  begin
    x := 4;
    a := 7;
  end
  else if n = 'simd128' then
  begin
    x := 64;
    a := 1;
  end
  else if n = 'simd256' then
  begin
    x := 13;
    a := -1;
  end
  else if n = 'fp' then
  begin
    x := -1;
    a := 0;
  end
  else if n = 'neon' then
  begin
    x := -1;
    a := 1;
  end
  else if n = 'asimd' then
  begin
    x := -1;
    a := 1;
  end
  else if n = 'atomics' then
  begin
    x := -1;
    a := 8;
  end
  else if n = 'lse' then
  begin
    x := -1;
    a := 8;
  end
  else if n = 'fphp' then
  begin
    x := -1;
    a := 9;
  end
  else if n = 'asimdhp' then
  begin
    x := -1;
    a := 10;
  end
  else if n = 'rdm' then
  begin
    x := -1;
    a := 12;
  end
  else if n = 'jscvt' then
  begin
    x := -1;
    a := 13;
  end
  else if n = 'fcma' then
  begin
    x := -1;
    a := 14;
  end
  else if n = 'lrcpc' then
  begin
    x := -1;
    a := 15;
  end
  else if n = 'dcpop' then
  begin
    x := -1;
    a := 16;
  end
  else if n = 'sha3' then
  begin
    x := -1;
    a := 17;
  end
  else if n = 'sm3' then
  begin
    x := -1;
    a := 18;
  end
  else if n = 'sm4' then
  begin
    x := -1;
    a := 19;
  end
  else if n = 'dotprod' then
  begin
    x := -1;
    a := 20;
  end
  else if n = 'sha512' then
  begin
    x := -1;
    a := 21;
  end
  else if n = 'sve' then
  begin
    x := -1;
    a := 22;
  end
  else if n = 'fhm' then
  begin
    x := -1;
    a := 23;
  end
  else if n = 'dit' then
  begin
    x := -1;
    a := 24;
  end
  else if n = 'uscat' then
  begin
    x := -1;
    a := 25;
  end
  else if n = 'ilrcpc' then
  begin
    x := -1;
    a := 26;
  end
  else if n = 'flagm' then
  begin
    x := -1;
    a := 27;
  end
  else if n = 'ssbs' then
  begin
    x := -1;
    a := 28;
  end
  else if n = 'sb' then
  begin
    x := -1;
    a := 29;
  end
  else if n = 'paca' then
  begin
    x := -1;
    a := 30;
  end
  else if n = 'pacg' then
  begin
    x := -1;
    a := 31;
  end
  else if n = 'dcpodp' then
  begin
    x := -1;
    a := 32;
  end
  else if n = 'sve2' then
  begin
    x := -1;
    a := 33;
  end
  else if n = 'sveaes' then
  begin
    x := -1;
    a := 34;
  end
  else if n = 'svepmull' then
  begin
    x := -1;
    a := 35;
  end
  else if n = 'svebitperm' then
  begin
    x := -1;
    a := 36;
  end
  else if n = 'svesha3' then
  begin
    x := -1;
    a := 37;
  end
  else if n = 'svesm4' then
  begin
    x := -1;
    a := 38;
  end
  else if n = 'flagm2' then
  begin
    x := -1;
    a := 39;
  end
  else if n = 'frint' then
  begin
    x := -1;
    a := 40;
  end
  else if n = 'svei8mm' then
  begin
    x := -1;
    a := 41;
  end
  else if n = 'svef32mm' then
  begin
    x := -1;
