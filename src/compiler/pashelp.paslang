{$mode objfpc}{$H+}

{ Manual printed by paslangc -h and paslangc --help.
  Spellings, sizes, and examples are exact. }
unit pashelp;

interface

function PaslangVersion: string;
procedure PrintBanner;
procedure PrintLicense;
procedure PrintHelp(const Topic: string);

implementation

{ Every change raises this. 1.0.1 map core (P63),
  1.0.2 map delete and iteration (P64), 1.0.3 core sync (P65), 1.0.4
  runtime hardening (P66), 1.0.5 manual and constructor fixes (P67),
  1.0.6 select and arm64 channels (P68), 1.0.7 Char prints as a
  character (P69), 1.0.8 test coverage audit (P70), 1.0.9 every
  runtime fatal error exits 1 (the sync unit exited 2), 1.0.10 RTTI
  helpers on arm64 (P71), 1.0.11 make install also installs
  paslangc-arm64 when it was built, 1.0.12 the help frames measure
  themselves instead of breaking at a fixed 56 characters, 1.0.13 the
  debugger builtins on arm64 (P72), 1.0.14 the MDI frame, every digit
  of DISPLAY in pasx11 and in lazlang, and text that carries its own
  background (L33), 1.0.15 a Char where a string is wanted becomes a
  one-byte string instead of a wild pointer, 1.0.16 LookPath so a tool
  finds paslangc on the PATH, the library units are installed, and the
  IDE moved to its own project, 1.0.17 pasx11 reads the shifted keysym
  of a key, 1.0.18 a window made by pasx11 is an ordinary top-level
  one, so the window manager frames it, it can carry a title, and the
  screen size is readable, 1.0.19 strings compare by what they say and
  not by where they sit (P74), and a local may not take the name of a
  parameter, a field or a method (P75), 1.0.20 the manual, the types
  page and the limits page say both of those, 1.0.21 the xcanvas test
  runs on Xvfb :99 like the rest: it was drawing on whatever DISPLAY
  the shell had, which is the desktop in front of you, 1.0.22 pasx11
  can set WM_CLASS and raise a window, so a desktop treats it as an
  application and it opens in front, 1.0.23 a record a function returns
  can be passed straight on (P80), and pastime reads the clock (P76),
  1.0.24 paslib opens a file and reads and writes it a piece at a time
  (P77), 1.0.25 pasrand draws numbers and passort puts them in order
  (P78, P79), 1.0.26 the statement path passes a record the same way the
  rest do, so P80 holds there too, 1.0.27 a routine is a value:
  function(a: Integer): string as a type, @Routine as a value, and a
  call through it (P81), and passort sorts with the order handed in,
  1.0.28 the manual says all of that, 1.0.29 a routine parking on a
  file descriptor reads its m before it marks itself parked, so two
  threads can no longer end up on one stack (P82), 1.0.30 rt_alloc moves
  its bump pointer with a compare and swap, so two threads never get the
  same block (P83, P84), and the work queue on amd64 compares the head
  it read instead of the head it wants (P85), 1.0.31 a fatal runtime
  error says why: out of memory with the MiB mapped, stack overflow, nil
  pointer dereference, integer divide by zero and the channel misuses
  print paslang: <reason> at line N and exit 1, on both machines, and a
  close of a closed channel is one of them (P86), 1.0.32 a const section
  takes every constant kind, a real, a string, a Char, True or False, and
  another constant, in a program and in a unit, and a unit interface
  exports them (P97), 1.0.33 pasemit names its fatal texts as string
  constants, the detour through a function gone now that the installed
  compiler accepts them (P97), 1.0.34 a readied routine runs on
  the M that readied it: runnext on the local queue, one spinning M gates
  the wakes, idle Ms sleep on their own futex and one polls, main joins
  the scheduler when it returns, a lone routine in a local queue can be
  stolen, and on arm64 rt_runqsteal keeps its return address and the
  scheduler's atomics take and release like Go's (P90), 1.0.35 a routine
  record is recycled and allocated on the spawner's P without a lock,
  Go's gfget and gfput, the global queue moves in batches of half a
  local queue, and AtomicAdd, AtomicCas and Pause exist (P98), 1.0.36 the
  mutex takes with one compare and swap and spins a moment before
  parking, and the waitgroup counts with one atomic add, as Go's do
  (P98), 1.0.37 a frame is the size of its locals and temporaries, named
  by a symbol set after the body, with 2 KB of margin for the runtime
  below it; a stack may grow to 1 GiB; stacks are counted apart from the
  heap (P92); rt_runqsteal copies its batch before it moves the victim's
  head, on both machines, so the owner can no longer refill the slots
  the thief has not read yet, and one fatal report at a time reaches
  standard error (P98), 1.0.38 a loop without calls keeps its integer
  variables in callee-saved registers, saved and restored around it,
  spilled and reloaded around rt_morestack, an integer expression
  without calls is worked out in a pool of registers instead of on the
  stack, and gdb follows a local into its register through a DWARF
  location list (P93), 1.0.39 a division or remainder by a constant is a
  multiply and shifts, Go's magic numbers; a small allocation takes a
  bump region of the running P with no lock prefix and no zeroing;
  rt_memcpy moves eight bytes a step and copies an overlapping range
  backwards; IntToStr takes two digits a step and allocates once, and
  prints Low(Int64) whole; rt_concat, rt_setlength and rt_strcopy keep g
  in r14 (P94), 1.0.40 a word or a byte reached through a pointer, a
  field or an index is loaded into and stored from the register pool,
  its address worked out there too, and a Char, a Boolean, a pointer or
  a class reference is a pool operand like an integer (P94), 1.0.41 the
  map has Go's fast paths for eight-byte keys: the hash without a call,
  the key compared in place, probe loops that call nothing, the first
  match found with a multiply instead of a loop (P96), 1.0.42 SetLength,
  Ldexp and Poly keep their first argument on the stack while the next
  is worked out, since the register pool may be used there (1.0.40
  miscompiled SetLength(p^.f, n + 1)), and make check proves the
  compiler reproduces itself (P94), 1.0.43 a run of statements without
  calls keeps its most used one-word variables in registers, not only a
  loop; pointers, class references and Booleans may live there too, and
  amd64 lends r9 and r10 to a region before the callee-saved ones (P96),
  1.0.44 a map with an ordinal key is read and written through
  PasMapGetInt and PasMapPutInt with the key in a register, the probe
  inside them (P96), 1.0.45 a load right after a store of the same
  place takes the stored register instead of memory, and "if c then
  Exit", Break or Continue is one conditional jump when no finally is in
  the way (P96), 1.0.46 a one-word local the body writes before anything
  reads it is not cleared at entry, and a region does not load a local
  it writes before it reads (P96), 1.0.47 the static link is walked in rcx,
  so a region lends r9, r10 and r11 to its variables and keeps rsi, rdi
  and r8 for expressions; a constant condition is a jump or nothing; the
  map lookup keeps few variables live (P96), 1.0.48 a pointer a region
  keeps in a register is the base of its loads and stores as it is; the
  map's insert keeps few variables live, a rehash of eight-byte keys and
  a new table call nothing per entry (P96), 1.0.49 the runtime lock is Go's
  lock_futex (spin a little, then sleep on the word; Goyield exists), and CanSpin,
  Nanotime, QWaitBack, QWaitFront and QWakeFirst exist for the core
  mutex (P98), a bare WriteLn or Write needs no parentheses, and a
  compiled interface (PASLANGI2) names the checksum of every unit it was
  compiled against, so a stale one is refused; rt_wakep marks the M it
  wakes before it lets the lock go (a late mark closed the idle list on
  itself), and arm64 reads that mark with an acquire and releases a
  parked routine's lock with a release (P98), 1.0.50 the mutex is Go's
  sync.Mutex: a waiter spins only while CanSpin says so and otherwise
  parks in a first-come queue, Unlock wakes one waiter without handing
  the mutex over, and a waiter kept out for a millisecond turns it to
  starvation mode, where Unlock hands it to the first in the queue and
  yields to it (P98), 1.0.51 a routine that holds a runtime lock is
  not preempted until it lets the last one go (Go's m.locks), QSplice
  moves a whole queue, the clock is read through the vDSO when the
  kernel gives one, the global list of free routine records has its own
  lock, and WaitPush, WaitFront, WaitTake and ParkMarked let the mutex
  park without a lock (P98); on arm64 each routine's literal pool
  follows it, so a unit may pass 1 MB of code, 1.0.52 the mutex parks
  without a lock: a new waiter pushes itself with one CAS and the one
  routine that may wake serves them from its own queue (P98), 1.0.53
  every allocation passes what the block holds (no pointer, a
  descriptor of its pointer words, or every word for GetMem, and
  GetMem(p, n, 0) for none), and a map descriptor says whether a slot
  holds a pointer (P95a); Chr(n) exists, and a parameter of a method
  named like a field or a method of its class is refused (it read the
  method), and Char + Char is a string, 1.0.54 the heap is Go's: spans
  of 68 size classes, an mcache per P, a tiny allocator, pointer bits
  in the span or a header word, a span of its own past 32 KiB, the slow
  paths in the core unit pasheap; HeapCheck and HeapMaskOf exist
  (P95a), 1.0.55 Copy with an index below 1 starts at the first
  character, as FPC's (it read before the string); arm64 zeroes a value
  whose size is not a multiple of 8 byte by byte at its end (it ran on
  and faulted); the collector's roots: every unit lists its globals in
  the section pasgcroots, the runtime keeps every routine record on a
  list (allgs), a record stays where its first stack was, and a spawned
  routine is runnable (3) from the start; a .pi is PASLANGI3 and one
  from before is refused (P95b), 1.0.56 arm64 clears the Result of a
  function returning a value whose size is not a multiple of 8 by whole
  words (it counted down by 8 past zero and ran off the stack), 1.0.57
  ReadLn keeps one buffer for the whole program (pasroutines' PasReadLn,
  on both machines; arm64 had no ReadLn at all): the second of two
  lines read at once was lost and a line was cut at 256 bytes; a wait
  on the poller is armed with a token (the record and a number) and the
  registration is one-shot, so a descriptor read long ago no longer
  wakes a routine that waits for something else (it made Recv return 0
  and die on nil), 1.0.58 the collector (P95b): a cycle stops the world
  (an idle M or one in a system call counts as stopped, a running one
  stops at its next safe point), marks from the globals by their types,
  every routine's record and stack and the Ms word by word, sweeps span
  by span (the mark bits become the alloc bits, an empty span's pages a
  free run), hands free slots out again in runs, gives free runs back to
  the kernel past an eighth of the goal, and runs again when what was
  handed out reaches twice what was alive (PASLANG_GC=100, off,
  PASLANG_GCSTRESS=n, PASLANG_GCPOISON=1); GcCollect and HeapStat
  exist; the 256 MiB cap is gone; Syscall goes through rt_syscall; a
  field that holds a pointer starts on a word (after array[0..9] of Char
  it sat where no scan finds it) and a .pi is PASLANGI4; the FPC
  bootstrap builds again (1.0.56 left two locals unused); a preempted
  or yielding routine no longer has its lock count (G+184) touched by
  the M that queued it (rt_wakep counted there after another M had
  taken the routine, and a lost update let it be preempted holding a
  runtime lock or inside rt_gocall); the cycle's M lets the cycle go
  only once off the collector's stack; an empty span stays on its
  central list a cycle and rt_alloc clears a reused run with rep stosq,
  so b2str runs faster with the collector than without it, 1.0.59 a map
  is a directory of tables of at most 1024 slots, as Go's: a table
  doubles up to that size and then splits in two, so a growing map
  never holds an old and a new copy of all of itself (b5map held 18 and
  36 MB together at its last doubling); a for loop over a map walks a
  copy of the directory it started on; the directory is found by
  (h shr 32) and DirMask, not by a shift by its depth (the shift by cl
  made the compiler keep values on the stack and cost a third of the
  lookups), its entries are the tables' groups, one word each, and a
  split picks the half of each key without a branch (half of them
  mispredicted): b5map 0.81 of Go's time in 48 MB against Go's 52 (P96),
  1.0.60 stack maps: every call of compiled code has a label after it
  and a descriptor of the frame there (which words hold a pointer, which
  ones nobody knows), in a section pasgcmaps; the collector reads a
  stopped routine's frames with them, up the chain of frame pointers,
  and the runtime's own code and the frame that called it word by word;
  PASLANG_GCVERIFY=1 reads the stacks again word by word and poisons
  what only that keeps; a pointer local starts as nil; rt_syscall and
  rt_gccollect keep the frame pointer; PASLANG_GCSTRESS=1 no longer
  asks for a cycle again on the refill that follows one; the manual and
  the help no longer say there is no collector (P95c), 1.0.61 a stack
  that grows is adjusted by the stack maps (pasheap's PasStackAdjust,
  run on the system stack with r14 or x28 at a record of its own): a
  frame's pointers by its map, the runtime's frames and the one that
  called them word by word, every frame link; the head of the try
  records (G+224) moves too, so a raise after the stack grew in a try
  no longer reads an unmapped stack; on arm64 the copy was not adjusted
  at all, a return past it went back to the old stack and every later
  allocation went to the persistent heap, never collected, and the old
  stack was never unmapped; PASLANG_GCVERIFY moves every stack after
  each cycle and poisons the old copy, if the runtime says it can
  (heap state +504: a stage links the new pasheap with the runtime of
  the compiler installed before, which took the move for a growth and
  doubled the stack every cycle); an unmapped stack leaves rt_stacktot,
  which only grew, so moves reached the 64 GiB ceiling (P95c), 1.0.62
  MapEnd's array starts as nil, which FPC's -Sewnh bootstrap demands,
  1.0.63 XxHash3(s [, seed]): XXH3, 64 bits, the reference's
  XXH3_64bits_withSeed, in the runtime of both machines: short inputs
  in a read or two and a 128-bit multiply, long ones in 64-byte
  stripes over vector registers (AVX2 when the processor and the kernel
  allow it, SSE2 otherwise, PASLANG_AVX2=off; NEON on arm64), 1.0.64
  maps hash with XXH3: a string key with XxHash3, an eight-byte key with
  XXH3's path for 4 to 8 bytes written out in pasmap (the halves swapped,
  xor a bitflip each map derives from its seed, rrmxmx), 1.0.65 a map
  with string keys has fast paths, as Go's mapaccess1_faststr: the
  probe written out and a candidate's bytes compared only when its
  length is the key's and they are not the key's own, 1.0.66 every M
  marks (P95d): the roots are jobs taken in turn, each worker has its
  own grey stack and gives the oldest half of it to a shared one when
  another waits and the shared one is empty, a waiter claims half of
  that before it locks, mark bits are set by compare and swap, a large
  object is marked in slices of 128 KB put on the shared stack, the
  words of the marking sit on cache lines by who writes them, and the
  Ms stopped or idle during a cycle join it through rt_gcwork on their
  system stack, at most 16 of them (PASLANG_GCWORKERS=n, 0 every M;
  HeapStat 14 to 18; parmark on both machines), 1.0.67 a split of a
  map with string keys moves them as one with eight-byte keys: the
  loop written out, the half chosen without a branch, rt_xxh3 the one
  call per entry (it was four calls and a Move), 1.0.68 rt_alloc takes
  the next run of a swept span from a bitmap of the 64 slots after the
  current one (entry word 24, heap state +504 bit 2, Go's allocCache)
  instead of calling pasheap once per run: a span with every other slot
  free called it once per slot; allocbits on both machines), 1.0.69
  m[s] with a string key is rt_mapgetstr, PasMapGetStr in the runtime's
  own assembly without a frame (60 instructions a lookup, not 118),
  1.0.70 an M starts when there is work for it (P91): rt_initsched runs
  M0 alone, rt_wakep gives the next M a thread when none sleeps idle,
  and a cycle first starts as many as it may mark with; hello is two
  threads, main and sysmon, not the Ps + 1; sysmon starts one when every
  M runs or waits in a system call and something may need a poller; and
  a due timer fires on any M that schedules (rt_timer0, Go's
  timer0When), not only on the idle M that polls: with every M busy a
  routine asleep never woke (lazym on both machines), 1.0.71 every index
  is checked (P87): a[i] of a static array against its bounds, d[i] of a
  slice against its length, s[i] against 1..Length, on every read and
  write, by one compare and one branch to rt_boundsfail, which prints
  paslang: index I out of range [LO..HI] and the line; always on, as in
  Go; and a routine preempted or yielding wakes another M only when its
  own has other work first (rt_yieldwake): since 1.0.70 each preemption
  of a lone routine started a thread for nothing; and the global queue
  is first in, first out, with one round in 61 taking from it first, as
  Go's: as a stack, a routine preempted while every M ran others sank
  under those preempted after it and never ran again, 1.0.72 the integer
  names TYPES.md lists all parse (P88: Word, Int8, UInt8, Int16, UInt16,
  Int32, UInt32, and FPC's LongWord, ShortInt, SmallInt, DWord), each the
  8-byte Integer, and an unknown type says so, 1.0.73 a pointer to a type
  declared later in the section (PNode = ^TNode) has a type of its own
  until TNode resolves it: it was the shared ^Integer, so resolving it
  turned Pointer, PInteger and every ^Integer into ^TNode; an alias
  (TNode = TOther) resolves it too, and one left unresolved at the end of
  the section, or used outside a type section, is an unknown type, 1.0.74
  a constant is any constant expression (A = 3 * 4 + 1, S + #33,
  Chr(Ord('A') + 2), 1 / 2, SizeOf(Integer) * 4), and so are an array
  bound, a subrange, a case label and a default value: they took one
  literal or name; an integer constant outside Int64 and a division by
  zero are errors; Succ and Pred are there; not of an integer flips its
  bits (not 5 is -6, it was 0); True and False are Booleans, and
  init.Done of a once is the Boolean, no longer an Integer field of the
  same name; SizeOf(Integer), SizeOf(string) and SizeOf(Boolean) parse,
  1.0.75 an integer where a real is expected becomes that real: an
  argument of a routine, a method, a constructor or a routine value,
  Exit(e), Result := e and Send passed the integer's bits, a denormal
  that printed 0.0; Double(3) is a constant, 1.0.76 a variable in a
  unit's interface is the program's too: it was an unknown identifier;
  a unit's global is unit.Name in the assembly, so a program's global
  of the same name is its own, 1.0.77 a typed constant starts with its
  value, which was read and dropped: a scalar, a string, a real, an
  array (a, b), a record (X: 1; Y: 2), a set [1, 3..5], nil; one of a
  routine keeps its value from call to call; a set is a constant,
  1.0.78 a case label may be a range lo..hi (it was a syntax error), a
  label beyond 32 bits assembles (cmpq took it as an immediate), a case
  may be of a string, and two labels that meet are an error; the empty
  statement parses (if c then ;, 1: ;, do ;); and an M that stopped for
  a cycle just as it ended is running again: it kept the stopped state,
  so the next cycle neither counted nor stopped it and waited for ever
  (gcbasic hung once in a few hundred runs under GC stress), 1.0.79 a real
  prints exactly: rounded once at the sixth decimal, a tie to even, at
  any size (1e20 printed -9223372036854775808.0, 2.675 2.674999, 1/0
  garbage: now 100000000000000000000.0, 2.675, +Inf, -Inf, NaN); x:w pads
  any value to w columns and x:w:d gives a real d decimals (a syntax
  error before); a real literal is the nearest double (a subnormal was 0,
  more than 18 digits were rounded twice); the core unit pasfmt does
  both, PasFmtReal and PasParseReal, 1.0.80 make builds and installs the
  library units for arm64 too: the installed compiler could not build an
  arm64 program that uses paslib, 1.0.81 a value parameter is a copy: a
  string, a record, an array, an interface or a method value went by
  address, so a routine that changed its parameter changed the caller's
  variable; one that changes it now starts from its own copy, and one
  that only reads it still costs nothing, 1.0.82 strings are values: a
  write through one never shows through another; t := s then s[1] := 'j'
  changed t too, and a literal's characters crashed the program. Every
  string's characters have a byte before them that says they are shared
  (a copy of the string was stored somewhere, or it is a literal); a
  write copies them once first (copy on write), 1.0.83 a channel carries
  any type: a value wider than a word (a string, a record, an array, an
  interface) travels in a box, a copy on the heap; a chan of string
  received the pointer word alone, an empty string; a closed channel
  gives the zero value, 1.0.84 a write into a string checks in line
  whether its characters are shared and calls to copy them only then:
  the call for every write cost string building 13%, 1.0.85 buffered
  channels: MakeChan(n) keeps up to n values, as Go's make(chan T, n); a
  send parks only when the buffer is full, a receive takes the oldest
  value, a closed channel still gives what it holds and then zero values,
  and select sees the buffer. MakeChan took no size, 1.0.86 rt_memcpy
  copies up to 32 bytes with two loads that may overlap and two stores,
  longer ranges 16 bytes a step with the last 16 loaded first, and 2048
  bytes and more with rep movsb: a tail under 8 bytes went a byte at a
  time, a fifth of string building; a new string's header byte is no
  longer written, rt_alloc's blocks being zero. b2str beats Go again,
  1.0.87 the narrow integers are types of their own (P99): Byte, Int8,
  Word, Int16, UInt32 and Int32, each row of TYPES.md one type, still
  a word wide; a call among overloads takes the same type first, then
  an integer that widens (the nearer width, the same sign), then an
  integer for a real, and a constant with no type the widest it fits;
  only the same types matched, so Put(5) found neither Put(Byte) nor
  Put(Word). A .pi is PASLANGI5 and its builtin types are checked,
  1.0.88 a slice's block keeps its frontier, the length the furthest
  slice of it reached: SetLength grows in place only from there, else
  it takes a new block, so the elements a grow adds are zero and another
  slice of the block never changes under it, as FPC's SetLength answers.
  A grow within the capacity showed what a shrink or another slice had
  left, and the compiler's own symbol table, grown after a routine with
  more symbols, found a stale local and laid out a frame too small (the
  P99 check routine crashed the stage compiler). Exit(v) of a string, a
  slice or a record returns all of v (only its first word went), a slice
  property's setter gets its capacity on arm64 and Default of a slice
  has capacity 0 on amd64. make builds the compiler a second time with
  itself, so bin/paslangc and the installed compiler run their own
  version's runtime: they ran the previous one's,
  1.0.89 the narrow integers keep their width in their values (P99,
  still a word in memory): the indicated type rules, so i := b + 1 is
  256 while b := b + 1 wraps to 0 and WriteLn(b + 1) is 0; an integer
  tree works in its widest operand's type, a constant with no type
  adapting; widening is implicit, narrowing needs a conversion (b := i
  and b := b + i do not compile, Byte(i) keeps the low bits); a constant
  that does not fit is a compile error (b := 300, Byte(300), a case
  label, a typed constant, a default value, WriteLn(b + 300)); signed
  and unsigned join in the signed type that holds both; shr keeps the
  sign in Int8, Int16 and Int32; a narrow for counter stops on its limit
  (0 to 255 in a Byte ends); Inc and Dec wrap. Byte(300) was 300 and
  255 + 1 in a Byte was 256, 1.0.90 a compile error names its source
  file after the message (paslangc: ... at 5:11 in dir/x.paslang): a
  build of many units said where but not in which file, 1.0.91 the
  narrow integers take their width in memory (P99): Byte and Int8 one
  byte, Word and Int16 two, UInt32 and Int32 four, in arrays, fields,
  through pointers and var parameters, loaded with the sign for Int8,
  Int16 and Int32 and stored at their width, so a packed neighbour stays;
  a record's fields lie at their natural alignment (a pointer on a word,
  the collector's maps unchanged) and it rounds to its most aligned field
  (a record of Byte, Word, Int32 is 8, a Char field one byte); SizeOf gives the
  real size; High(T) and Low(T) of a type are constants of that type;
  published narrow properties go through RTTI at their width; FillChar
  exists; AtomicAdd and AtomicCas refuse a narrower target; .pi is
  PASLANGI6, and one from a newer paslang says so (it was a bad compiled
  interface). Every field took at least a word, 1.0.92 the debug
  information types every integer local (DW_TAG_base_type: Integer, Byte,
  Int8, Word, Int16, UInt32, Int32 with their size and sign), so gdb shows
  an Int8 of -1 as -1 and a Byte as one byte; a local had no type.
  testdata/narrowgo has a Go twin that make check runs: the lines of the
  narrow integers where the rules are Go's print the same. P99 closes,
  1.0.93 a for loop's limit is worked out once, before the loop, as in
  every Pascal: it was worked out again after each pass, so a body that
  changed n changed the loop, a limit that called a function called it
  every pass, and a loop to High(a) that grew a never ended. A limit that
  is not a constant goes to a hidden variable, which a register keeps,
  1.0.94 narrow integer operations are worked out in the register pool
  (P100): cleaned in their register, not at all when a store of their own
  width takes them, and shr keeps the sign there too; they went through
  the stack, so data[i] := Byte(x shr 16) took a push and a pop each.
  An index whose every value lies in a static array's bounds (a Byte
  into array[0..255], a Char, Ord of a Char, an Int8 into -128..127) has
  no check: it cannot fail, 1.0.95 d := d + x for d an element, a
  field or a dereference changes the memory in place on amd64 at its
  width (addb for a Byte, wrapping as the Byte does), the address worked
  out once: hist[b] := hist[b] + 1 worked it out twice and went through
  the stack. An index a loop keeps in a register takes no pool register,
  so hist[data[i]] fits the three amd64 lends inside such a loop,
  1.0.96 a loop keeps narrow integer locals in registers too, clean, and
  loads their homes at their width (only 8-byte ones could be kept), and
  d[i] := f(d[i]) checks the index once: the store's check repeated the
  load's in the same statement, which calls nothing; a for counter a
  register keeps steps and compares there, not through rax (x0); a
  narrow expression the pool worked out is not cleaned twice.
  testdata/narrowasm checks where the cleanups are, and b7narrow (64 MiB
  of Byte, a table and a histogram) joins make bench against Go,
  1.0.97 a loop that only reads a slice keeps its pointer and length in
  registers, as it keeps variables (P100): they were read from memory at
  every element; a loop that assigns the slice, or a slice whose address
  may be kept, reads them from memory as before. SetLength, Move and
  FillChar take a variable's address without keeping it. On amd64 an
  element's address uses the pointer's register as its base, with no
  copy. 1.0.96 was not installed: make check found the double cleanup
  its note describes as gone, which this version removes,
  1.0.98 every for stops on its limit instead of passing it: a loop up
  to High(Integer) or down to Low(Integer) never ended, and now it does;
  the counter holds the limit after a loop that ran to its end and keeps
  its value when the loop does not run, as in FPC (it held the limit
  plus one, or the start). An innermost loop of a run of statements kept
  in registers runs in runs of 1024 with one preemption test a run, as
  HotSpot does: an element costs a step, a compare and a branch, the
  test and the compare with the limit went at every one (P100).
  testdata/forrun,
  1.0.99 an element's address is part of its load or store (P100): on
  amd64 a global array is at its link-time address, v_a-10(,%rdi,2), with
  no leaq at every element (the programs are static, not position
  independent); on arm64 a load takes [base, index, lsl #k] or
  [base, #offset], a field at its natural place is an offset of the load,
  and a slice a loop keeps in registers is the base itself, compared with
  its length register where it is: the address was added up first, and
  the slice's pointer and length were copied at every element.
  testdata/addrform. A for whose body sets its counter (paslang allows
  it) is not run in runs: set back below the run's end it never reached
  the preemption test, and the collector waited for it for ever (1.0.98);
  testdata/forrun has such a loop,
  1.0.100 a run of a for (1.0.98) checks at its head, once, that every
  index at counter + c of a static array, or of a slice the loop keeps in
  registers, stays in range to the run's end, and then takes a copy of
  the body without those checks; a run it cannot prove takes the checked
  body, which stops at the first index out of range as before (P100).
  A narrow counter proves only itself: i + 1 wraps at its width.
  d := d * a + b and every chain of +, -, and, or, xor and * down its
  left side, for a d the loop keeps in a register and names nowhere else
  in it, changes the register at each step: it was worked out in the
  pool and moved back. b7narrow's loops run the instructions Go's do.
  testdata/bcerun, testdata/fatal/bversion, testdata/inspine,
  1.0.101 a static array's address costs nothing a pass either (P100):
  on amd64 a routine's own array is -80(%rbp,%rdi,8), not a leaq and an
  index; on arm64 a loop keeps a global or local array's address in a
  register (adrp and add, or the frame offset and an add, at every
  element before), worked out again after the loop's slow path, which may
  have moved the stack. testdata/framearr spins over local arrays while
  the collector moves the stacks,
  1.0.102 arm64: a constant that a mov takes (-65536..65535) is a mov,
  not a load from the literal pool; a frame word within 256 bytes of
  x29 is one ldur or stur, not a literal, an add and the access; a
  frame address is one add or sub (P100),
  1.0.103 a real where an integer, a Boolean or an enum goes is an error
  that says Trunc or Round: i := r stored the real's bits (2.5 became
  4612811918334230528), in an assignment, an argument, Exit or Send;
  Ord of a real is one too. Inc and Dec of a real add or take away the
  step, 1.0 unless one is given: they stepped the bits. testdata/realstep
  and testdata/realbad,
  1.0.104 Single is IEEE binary32 (P101): 4 bytes, worked out in 32 bits
  (addss, fadd s), as Go's float32; it was binary64 under another name.
  Single with Single stays Single, with a Double it widens exactly; the
  context gives the width, as for integers (d := s * t in Double,
  WriteLn(s * t) in Single); a Double becomes a Single only through
  Single(x), which rounds to the nearest; a constant with no type rounds
  once from its digits (pasfmt's PasParseSingle; read as a double first,
  one in five of testdata/f32conv's hard cases rounded to another
  single); Abs, Sqr, Sqrt, Min and Max of Singles are Singles, the other
  routines widen them; DWARF types Single and Double locals; a .pi is
  PASLANGI7. testdata/single against the same program in C,
  testdata/f32conv against glibc, testdata/dwarfreal, testdata/singlebad.
  The compiler's make rule lists the core units it links: an edit of
  pasfmt alone (the lexer reads reals with it) left the old compiler in
  place, which a sabotage of its rounding showed,
  1.0.105 amd64: the target of a loop's back edge starts on 32 bytes
  (P100): b7narrow's histogram loop, the few instructions Go's has,
  crossed a fetch block and took 280M cycles where Go's took 198M; with
  every loop aligned b7narrow takes 0.82 of Go's cycles (1.15 before),
  1.0.106 Pointer is an address and nothing more (P102): it was ^Integer.
  Its target has a type only through a view: T(p^) is the T at that
  address, a variable (Word(p^) := 7 writes two bytes), PT(p)^ another
  way; p^ alone goes only to Move and FillChar, and an untyped Pointer is
  indexed through a view. PByte, PWord, PDWord, PInt8, PInt16, PInt32,
  PUInt8, PUInt16, PUInt32, PShortInt, PSmallInt, PLongWord, PInteger,
  PInt64, PSingle, PDouble, PBoolean and PPointer are predefined; a name
  the program declares hides them. testdata/ptrtyped against FPC,
  testdata/ptrbad,
  1.0.107 pointer arithmetic counts in elements of what the pointer sees
  (P102): PDWord(p) + 1 is 4 bytes on, a Pointer counts bytes, q - r is
  the elements between two pointers of one type; Inc and Dec step the
  same way; p + n was an Integer n bytes on. ^T(q) sees q as a pointer to
  any type in line (^TRec(X)^.W, Inc(^TRec(X))), and TRec(X) of a Pointer
  is TRec(X^). testdata/ptrarith walks the plan's tables,
  1.0.108 safe, a reserved word, before program, unit, procedure,
  function, constructor or destructor (a method's declaration too)
  forbids raw pointer work there (P102): arithmetic, Inc and Dec of a
  pointer, p[i], views, Pointer(n), an untyped p^; a routine inside a
  safe one is safe, and a safe unit's .pi says SAFE (PASLANGI8). No code
  changes: it costs nothing. testdata/ptrsafe, testdata/safebad, the
  unit testdata/units/safeu. The help and the docs say GNU/Linux,
  1.0.109 the tools of pointer bounds (P104): View(p, n) is n elements
  at p as a slice, as Go's unsafe.Slice; d[i..j] is a slice of a slice or
  a static array that shares its elements, checked where it is made, and
  s[i..j] of a string a copy; such a slice has capacity 0, so SetLength
  gives it a block of its own and never grows into memory that is not
  its own. MemBase, MemSize and MemEnd give the object an address is in:
  a heap block (pasheap's span table), the routine's stack, the globals
  (rt_datastart to _edata); 0 when none. testdata/memview,
  fatal/bslicehi, fatal/bviewneg; View is not safe code,
  1.0.110 paslangc -checkptr (P104): every pointer step (p + n, p - n,
  Inc, Dec) must stay in the object the pointer is in, one past its end
  outside as in Go, and every access (p^, p[i], a view, a field through
  a pointer) must lie in one object: a heap block found in line from its
  span, the routine's stack, the globals. One that does not stops the
  program: pointer outside its object at line N. Checked code takes no
  register pool or loop registers; the check keeps every register. A
  loop that only walks a pointer runs 12.6 times the cycles (it was 200
  through pasheap in Pascal, before the check went in line). A unit's .pi
  says CHECKPTR (PASLANGI9), and a newer .pi's message names its whole
  version. testdata/checkptr runs both ways, fatal/cparith and
  fatal/cpderef on both machines, and seven goldens under -checkptr must
  print what they print without it (all 144 do, and 110 on arm64). On
  arm64 a View's length below 0 names its value: BoundsFailArm loaded the
  limit into x2 over it (make check's fatal arm64 found it; 1.0.109 was
  not installed),
  1.0.111 an access outside an object the code names is an error when
  compiling (P104), with or without -checkptr: a pointer made of @v, of
  a field or a constant element of v, of a pointer to it indexed or moved
  on a constant number of bytes, read or written through p^, p[k], a
  view T(p^) or TRec(p), or with FillChar and Move of a constant count.
  v is a local or a global holding its own value; a var parameter may be
  one element of a bigger array and never counts. A step alone is not an
  access. testdata/ptrbad/reach* on each form, ptrreach on what compiles
  (also under -checkptr). And -checkptr's rules: a step may reach one
  past the end of its object, as in C (1.0.110 stopped it, like Go, and
  so every walk p^ := x; Inc(p) over a heap block); an access there is
  outside, and p[i] and (p + n)^ go through rt_ptrfrom, held to p's own
  object (the old pointer on the stack), so (p + 2)^ just past a block
  stops though another block follows. rt_ptrobj finds every object for
  the checks; a step from a pointer at an end is also tried against the
  object that ends there exactly. It checks that the span of a page
  holds the address (the page table keeps entries of spans gone, and a
  reused span record told another span's slots) and caches the heap
  object or the globals it finds in the G (+160/+168 on amd64, +120 and
  32 bits at +156 on arm64, cleared when a routine starts; the collector
  scans the whole G, so the cached object lives and keeps its layout).
  b8ptr (a new bench pair: 0.93 of Go's cycles) takes 8.1 times the
  cycles under -checkptr, a byte walk 11.4 (25.6 before the cache), a
  list walk 5.0; run.py holds it to 10. cpwalk (walks that end at an
  end and come back) runs under -checkptr on both machines,
  fatal/cpindex stops, and without -checkptr no rt_ptr call is emitted
  (make check greps both machines' .s),
  1.0.112 reals at their edges, the same on both machines: Trunc, Round,
  Floor and Ceil of a NaN, an infinity or a value out of Integer's range
  stop the program: real out of integer range at line N (amd64 gave the
  lowest Integer for all of them, arm64 the nearest end and 0 for a NaN;
  RealIntCheck looks twice only at a result at an end, right only for
  -2^63 itself, rt_dm63). Sqrt(-0) is -0 and Sqrt of a NaN a NaN (the
  sign-bit test stopped both); only below 0 is outside. Every domain
  error (sqrt, ln, arcsin, arccos, power, log, arcsec, arccsc, arccosh,
  arctanh, lnxp1) names its line through rt_diemsg, from the return
  address the routine was called with. testdata/realint, fatal/rrtrunc,
  rrround, rrfloor, rrceil, and thirteen domain tests, all on both
  machines (the domain tests ran on amd64 only). The documentation of
  P99 to P104 audited and completed: the help said Pointer is ^Integer,
  shr is logical, overloads must match exactly, a record is its largest
  end offset; the manual gave the narrow types 8 bytes, Char as the only
  1-byte type, FreeMem as freeing, and numbered its sections wrong; the
  engineering notes had Single as binary64 and the .pi as PASLANGI2.
  Now the manual has the narrow rules, pointers and views, View, slices,
  MemBase, the compile-time reach errors, -checkptr, the end-pointer
  rule of the collector and Single, with three new checked examples
  (narrow, pointers, single, on both machines); TYPES has a pointers
  section and the narrow rules in detail; ENGINEERING has P99 to P104
  inside (widths and cleaning, the P100 optimisations, Single's
  registers, views and scaling, the -checkptr runtime and its cache with
  the measured costs, the .pi versions); GC.md the end-pointer and cache
  rules; the version card and the docs say GNU/Linux. P104 closes,
  1.0.113 IEEE binary128 in software, the first step of Quad (P103): the
  core unit pasquad adds, subtracts, multiplies, divides, takes the
  square root, compares and converts binary128 values held in two words
  (Integer, Double and Single both ways, Trunc, Round, Floor, Ceil and
  Int), with integer instructions only, so the bits are the same on both
  machines; one RoundPack rounds every result to the nearest, a tie to
  even, subnormals kept. pasfmt reads a decimal number as the nearest
  binary128 (PasParseQuad) and writes one exactly (PasFmtQuad), sharing
  ScanReal and FmtExact with the double and the single. quadcore and
  quadfmt compare both with what GCC's __float128 and libquadmath print,
  on both machines (200,000 random cases matched while it was built,
  FPC's build of the unit too). docs/QUAD.md tells how it works,
  1.0.114 Quad is a type (P103): IEEE binary128, 16 bytes, builtin id 14
  of a kind of its own (tykQuad), .pi PASLANGI10. Everything widens to
  it exactly and a Quad context works its expression out in Quad
  (QuadOf, as RStamp for the other reals); a literal is read from its
  digits and Pi has 113 bits; Double(q) and Single(q) round once, and an
  Integer comes through Trunc, Round, Floor or Ceil, which stop out of
  range. + - * / and the comparisons (a NaN compares with nothing), unary
  minus, Abs, Sqr, Sqrt (below 0 it stops), Int, Frac, Min, Max, Inc,
  Dec and WriteLn take it; the other routines refuse it (write Double).
  Each operation is an rtq_ call the emitter makes into pasquad: the
  words in registers, a 16-byte scratch slot for the result, a value in
  rax:rdx (x0:x2), no pointer in it; pasquad is linked into every
  program. testdata/quad against the same program in C with __float128,
  quadmore (Inc, Dec, a map, a channel, a class, the unit quadu),
  quadbad (ten refusals), fatal/qtrunc and fatal/qsqrt, examples/quad,
  all on both machines. Left for 1.0.115: typed constants and defaults
  of Quad, constant expressions folded in Quad, DWARF, 16-byte fields.
  make check needs the arm64 core and qemu before its first arm64 test
  (the checkptr section ran one on a tree whose build had no qemu yet).
  A unit linked without its names (pasquad, by every compilation) that a
  uses clause then asks for is read again for them: LoadUnit left it for
  loaded, and FLoading, which keeps every unit that began, made the
  second request a circle and dropped it silently (units/quadimpl),
  1.0.115 Quad completed (P103): the compiler links pasquad and folds
  constants in binary128 (QFold), so const Third = 1 / 3 has 113 bits in
  a Quad, in its unit or another (the .pi writes CONST name bits r lo hi,
  which an older reader ignores); typed constants and default values of
  Quad; a Single typed constant or default rounds once from its digits
  (it rounded the Double); a Quad lies on 16 in a record and a global,
  as C's _Float128; DWARF names its type _Float128, which gdb reads as
  binary128 on amd64 too. pasquad divides by Knuth's algorithm D in base
  2^30 (7,700 cycles to 626) and takes square roots with constant shifts
  (11,250 to 1,690). docs/QUAD.md has the cost against Double and GCC's
  __float128. testdata/quadconst, dwarfquad (gdb), units/quadcu. P103
  closes. A literal past Quad's range names itself again (constant
  1e5000 does not fit Quad): the folding path had lost the text.
  1.0.116 bits and operands (P105 begins): nand, nor, xnor and andnot on
  Booleans and integers, sar, rol and ror in the width of the type (a
  count modulo 64 for sar, modulo the width for a rotation, as both
  machines take it; one instruction each, rolb/rorw/sarq, ror/asr, a
  byte or halfword rotation two shifts and an orr on arm64), all seven
  words operators only where an operator goes; x op= e for every binary
  operator. A comparison binds before and/or, so a Boolean mixed with an
  integer in the logic family (x and 4 = 4) is refused. Holes the tests
  found, all old: Ord(not t), Integer(not t) and Byte(not t) gave -2
  (the Boolean relabelled; AsInt gives a conversion node); t := i stored
  5 in a Boolean (only a Boolean goes into one now) and Boolean(x) did
  not parse (it is x <> 0); s + 1 dropped the 1, -s stopped the program,
  a + a added two slice addresses and s xor s gave garbage (CheckOperand
  refuses them); real operand and type expected got 38 had no position;
  b and not 2 did not compile (not of a constant takes the width); a
  record with no name (r: record X: Integer end) was a syntax error; a
  var after a nested routine was one too; a conversion inside a wider
  one lost its work (Integer(Byte(i)) gave 300 for 300, Integer(Byte(b +
  1)) 256 for 0): a conversion is now a boundary (convchain); Ord of a
  constant is a constant with no type (b := Ord('X') needed Byte()). sar of a signed narrow value
  and shr lost a needless cleanup (KeepsClean). testdata/bitops (the
  pool loop against a Python model), bitbad (23 rejects), declorder,
  anonrec with its unit, examples/bits, the ok bitasm greps; all on
  both machines.
  1.0.117 the bit words (P105): IsBitSet (the Integer 0 or 1), SetBit,
  ToggleBit, GetBits, SetBits, PopCount, LeadingZeros, TrailingZeros,
  ReverseBits, ByteSwap, RotateLeft and RotateRight on every integer
  width; a constant bit out of range is a compile error, a varying one
  one compare and rt_bitfail (bit N out of range [0..M] at line L).
  popcnt behind a flag rt_heapinit sets from cpuid, bsf, bsr, bswap;
  cnt, clz, rbit, rev on arm64. x := x op k on a narrow variable is one
  instruction (orb $8, the byte; orq on its register) and and, or and
  xor of clean values need no cleanup. testdata/bitwords against a
  Python model, bitmem, fatal/bitchk, bitneg, bitpool, bitfield, nine
  rejects; all on both machines.
  1.0.118 the bit words on anything (P105): a real, a Boolean, a
  pointer, an enumeration or a set as its bits (a Double stays one); the
  bytes of a record, a static array, a Quad, an object's instance, a
  string (made its own first) or a slice, bit n being bit n mod 8 of
  byte n div 8, checked against the length it has then; raw memory at an
  untyped Pointer; AtomicSetBit and AtomicClearBit giving the old bit
  (lock cmpxchgb, ldaxrb/stlxrb on the byte alone). rt_bitget,
  rt_bitchk2, rt_popcntmem, rt_clzmem, rt_ctzmem, rt_getbits and
  rt_setbits in the runtime of both machines. testdata/bitany, five
  fatal tests, seven rejects, examples/bitmap.
  1.0.119 views (P105): x as T sees x's bytes as T, not converted, read
  and written; a value of one register is reinterpreted in it and an
  assignment goes back into x's low bytes, anything else is T at x's
  address (a string's characters made its own by rt_strview, a string
  or a slice checked at run time). A statement may begin with a
  parenthesized place; Inc and Dec take a view. Anonymous types have a
  name in messages (a record, an array). UInt64(d), Int32(d), Byte(d)
  and Pointer(d) of a real relabelled or cut its bits: a real becomes an
  integer through Trunc or Round, and x as T sees its bits.
  testdata/views, fatal/viewstr, nine rejects.
  1.0.120 logic on whole blocks (P105): records and static arrays of one
  size, an array of integers with one integer, strings of one length
  (a new string, logic on N and M bytes at line L otherwise), byte by
  byte by rt_blockop, eight bytes a step; a record's goes into a
  variable, nested and compound too; a block that holds addresses is
  refused. A record, a static array, a string and a slice go only where
  their own type goes (i := r, s := r, r := r2 compiled). ParseStmt
  checks a statement whole. testdata/blocks, fatal/blkstr, seven
  rejects. P105 closes.
  1.0.121 wide arithmetic (P106 begins, design approved by German with
  inline assembly per machine, V128/V256, features found at start):
  MulHi and MulHiS as operators the pool keeps (mulq/imulq, umulh/smulh,
  folded), Mul128, DivMod128 (divq; shifts and subtractions on arm64;
  128-bit division overflow at line L), AddCarry and SubBorrow with the
  carry in the flag, AddOverflow/SubOverflow/MulOverflow at the width of
  their result, AddSat/SubSat clamped to the type. testdata/wide
  against Python, fatal/divover, fatal/divzero128, four rejects.
  Conditional compilation: the ifdef family with PASLANG and FPC's
  processor names, so the core units can take the new words and still
  build with FPC (testdata/ifdef).
  1.0.122 pasquad on the wide words: MulHi, LeadingZeros, AddCarry,
  SubBorrow in its helpers and fast paths for two normal operands (sum,
  difference, product; the quotient by divq on amd64), behind ifdef
  PASLANG so FPC still builds it. + 69 cycles (253 before), * 61 (468),
  / 201 (626): 1.6, 1.3 and 2.6 times GCC's __float128; Sqrt unchanged.
  120,000 pairs against an exact oracle, testdata/quadfast.
  1.0.123 memory words (P106): fences, prefetches, CacheLine, StoreNT,
  AtomicLoad/AtomicStore (acquire, release), AtomicExchange and
  AtomicAnd/Or/Xor giving the old value, on integers of any width, and
  the byte-order loads and stores at a pointer; a value word called for
  its effect is emitted in line (it became a call to nothing).
  testdata/memwords, four rejects, the asm greps.
  1.0.124 the machine's words (P106): CycleCount, CycleFreq, CpuHas and
  CpuFeatures, read by rt_cpuinit at start (cpuid and xgetbv; AT_HWCAP
  and AT_HWCAP2), a feature the target never or always has a constant;
  testdata/cpuwords against the kernel on both machines, cpufold, three
  rejects; pasopt folds a Boolean and/or with a constant side (both
  short-circuit), so a foreign feature's branch leaves the program;
  make check's eleven '! grep' lines could never fail under set -e: now
  each fails with its reason.
  1.0.125 V128 and V256 (P106): builtin ids 15 and 16 (.pi PASLANGI11),
  records to the rest of the language; 60 vector words (add, sub,
  saturating, mul, avg, min, max, compares, logic, select, shifts,
  splat) worked out per statement in xmm2-15/ymm (AVX2 when the
  processor has it) or v16-v29, with no call inside; the logic operators
  on vectors; PASLANG_AVX2=off turns AVX2 off for CpuHas and V256 too;
  testdata/vectors from a Python model (scripts/vecmodel.py), eleven
  rejects. Write of a record, an array or a slice printed an address:
  now refused.
  1.0.126 more vector words (P106): VShuffle8 (pshufb with SSSE3, a
  byte loop without; tbl), the zips, the packs, Single and Double lanes
  (min and max as x86's on both machines), VCvtS32F32, VSplatF32/F64 and
  the reductions VMoveMask8, VSumU8, VSumS32, VSum64; PASLANG_CPU=base
  shows the program the baseline processor, and rt_heapinit takes popcnt
  and XXH3's AVX2 from rt_cpufeat; testdata/vecmore from the model,
  three rejects.
  1.0.127 inline assembly per machine (P106): asm amd64 (x: in rax; y:
  out rdx) ... end beside asm arm64 ... end, one statement of which the
  target's block runs; values bound in, out and inout to integer, xmm,
  ymm, d, s and q registers; the block is a call to the rest of the
  compiler and the callee-saved registers it names are saved around it;
  testdata/inlineasm on both machines, nine rejects.
  1.0.128 vectors in registers (P107): a vector statement whose
  operands call nothing has no first phase (p[i] addressed as
  (%r10,%rax)); a loop keeps its vector variables in xmm15 down or
  v8-v15 across statements, spilled around rt_morestack; on amd64 a
  region with vectors is compiled for AVX2 (VEX throughout, V256 in ymm,
  pmulld native) and for SSE2; constant splats are 32-byte constants;
  address-taken names per routine for locals, so another routine's @acc
  no longer keeps this one's acc in memory. testdata/vecpool from the
  model, testdata/addrlocal; the Dot loop 1862 to 99 ticks a KB. A
  record or a class refuses a field name twice, a parent's too, as Free
  Pascal does: the second one hid the first in silence.
  1.0.129 Carry and the rotation words (P108): each routine has a
  Carry bit of its own at G+256 (the record grew to 272 bytes), 0 when
  it starts, kept across calls: Carry, Carry := b, CarryOn, CarryOff,
  CarryFlip. RotateLeftToCarry/RotateRightToCarry,
  RotateLeftThroughCarry/RotateRightThroughCarry, ShiftLeft,
  ShiftRight, ShiftRightSigned, ShiftLeftToCarry, ShiftRightToCarry,
  ShiftRightSignedToCarry and FunnelLeft/FunnelRight(hi, lo, n) in the
  operand's width, the count 1 when left out, 0 or less changing
  nothing, past the width exact; an untyped constant takes the width of
  where it goes. rol, rcl, shl, setc on the value's own width (in place
  on x's memory or register for x := W(x, k)), rcr by 1 for a turn of
  the width, shld/shrd; arm64 ror, a ring in one register, extr. A
  one-byte variable a loop keeps in a register took a call's value
  through its address and stopped the compiler: it takes it in the
  register now. testdata/rotwords from scripts/rotmodel.py on both
  machines, seven rejects.
  1.0.130 the rotation words on any value (P108): a record, a static
  array, a Quad, V128, V256, a string's characters and a slice's
  elements turn and shift whole, one number of all their bits, into a
  new value of their type; RotateLeft and RotateRight too, their count
  1 when left out. pasheap's PasRotMem does the work, 8 bytes a step;
  the emitter keeps the operands and the result where the collector
  sees them. A record or a slice that holds strings, pointers or
  objects is refused, as is an object; two strings or slices of
  different lengths stop a funnel (a funnel of N and M bytes at line
  L). A loop keeps Carry in a register as it keeps a variable (Part 9
  of the promotion, CarryM/CarryLd/CarrySt), a[i] := RotateLeftThroughCarry(a[i])
  is rclq $1 on the element, and PasRotMem's inside is inline assembly
  (shrdq; ldp): a 128-word carry chain 2800 to 330 ticks a KB, a whole
  KB turned 8500 to 680. testdata/rotmem from the model on both
  machines, two fatal tests, five rejects. P108 closed.
  1.0.131 the audit's corrections: the manual's reserved words are the
  lexer's (forward, overload, override, packed and published are not
  reserved; WriteLn, New, Sleep, MakeChan, Send, Recv and Close are),
  an asm statement is assembled and only an assembler body discarded,
  the lexer's second write entry and its dead token went, and arm64
  does a and not b, a or not b and not (a xor b) in one bic, orn or eon
  (not for a narrow unsigned or and xor, whose upper bits the mvn's
  cleanup keeps). German's decision: the bit operators, the declaration
  words (forward, override, published...) and paslang's predefined
  words (Carry's, the bit words, the wide, memory and processor words,
  V128, V256 and every V word) are reserved as names: CheckName at
  every declaration's name, off while a .pi loads; a reserved word
  where a name goes says so (sleep is a reserved word, not a name). The
  sources renamed what they used: pasast's Published field, pasheap's
  PopCount, carry in pasquad and pasfmt.
  1.0.132 slices grow (P109): Append(s, a, b), Append(s, u) for a slice
  of s's type, Cap(s), and [a, b] where a slice goes is a new slice
  ([] empty), for a variable, an argument or an element. The elements
  go into a hidden array as := would store them and rt_append grows a
  copy of s through rt_setlength (in place from the frontier alone,
  twice the length as capacity), copies them after the old ones and
  marks their strings shared. Append and Cap are reserved; pasemit's
  cap and pasmap's Cap became room and Slots. testdata/append on both
  machines and under the collector's stress, five rejects.
  1.0.133 routine values are 16 bytes (P109): the code and an
  environment, which a call through the value puts in the static link's
  register (r10, x27) for the closures of 1.0.134; @Routine has nil
  there; the environment is a pointer to the collector; .pi PASLANGI12.
  Two old faults went: a call through a method value on amd64 passed a
  string's first word alone (its length came from the next word), and
  @ of a nested routine, and pas of one, gave a value without the link
  to its parent's variables and crashed; until closures they are
  refused. FPC's Assigned. testdata/funcval2 on both machines.
  1.0.134 closures (P109): function(x: T): R begin ... end and
  procedure ... begin ... end as values, keeping the variables around
  them by reference: a routine with a closure inside keeps the ones its
  nested routines use in a heap box (its first word the routine's own
  link, the box's address 8 past it so the link walk is the frame's),
  each variable's slot pointing at its field; nested routines get the
  box as their link; a closure's value is its code and that link.
  @Nested and pas Nested work (the link rides in r10/x27 and G+248). A
  loop counter a closure made in the pass keeps is the pass's own: a new
  cell each pass, the body and the closures use it, a closure pins its
  address in a scope box when it is made, and the cell goes back to the
  counter at the pass's end and before continue and break. Two old
  faults went: a routine nested two deep could not name its
  grandparent's variables, and for x in a slice or an array ran over it
  as over a set (nothing, or garbage); now it walks the elements.
  testdata/closures on both machines and under the collector's stress,
  four rejects.
  1.0.135 pas takes any call (P109): pas F(a, b, c) with any number of
  arguments of any type, pas f and pas f(a) of a routine value, pas
  obj.M(a) of a class's or an interface's method, pas m(a) of a method
  value, pas procedure begin ... end. What follows pas is parsed as a
  call statement; up to two one-word arguments go the old way, in
  registers; anything else runs through a closure the parser makes: the
  routine value or the object and each argument go into a heap cell of
  its own when pas runs (as in Go), the closure pins the cells and makes
  the call. A var parameter is refused. The old way passed a string's or
  a record's first word alone. function ... of object: a method value's
  type keeps its signature (InternMethodSig), so a call through one
  converts its arguments and gives back the answer, in an expression
  too (amd64's expression path gave 0), on a field or an element as
  well; obj.M of a method with parameters is its value, @obj.F that of
  a function with none (@ of a method stopped the compiler). Four old
  faults went: a call written with no ( through a routine value, a
  method value or obj.M whose type takes parameters ran on whatever the
  registers held (now refused); a for counter or a for-in variable that
  is a var parameter or shared by a closure had its address overwritten
  (a nil dereference); a call through an interface took one word an
  argument (a string lost its length and what followed moved; at most
  five); both machines now call as through a method value.
  testdata/pasargs and ifaceargs on both machines and under the
  collector's stress, eight rejects.
  1.0.136 the documentation audit: three audits of 1.0.135 checked every
  keyword, type and predefined routine against the manual, the types
  document and this help, every internal document against the code,
  and every flag; the manual, TYPES, HELP and the internal documents
  were corrected and completed (the words that had no description, the
  claims that no longer held, the how-it-works of 1.0.73 to 1.0.103).
  The code faults the audit found went: VShrS64 existed in the help and
  not in the compiler (arm64 sshr; amd64, which has no such instruction
  before AVX-512, ((x shr c) xor m) - m); Append(s, [a, b]) appended the
  list as one element, its set's bitmask, and a set went anywhere an
  integer goes (i := [1, 2] stored 6), now refused; Default of Integer,
  string or Boolean stopped the compiler; a bare Syscall statement put
  the number in the first argument's register and ran whatever rax
  held; an interface's method refused const and out parameters, and a
  call through an interface passed a var or out argument by value (the
  method wrote to address 0); DumpLocals did not link on arm64; Length
  of an Integer or a Real, and High or Low of a map or of an ordinal
  value, gave garbage (an ordinal value now gives its type's bounds,
  Low of a string 1); ParamStr past the arguments crashed (now the
  empty string); assembler arm64 beside assembler amd64 did not pair; a
  parameter could be named Self. Two miscompilations from reading the
  code: a routine whose closures share none of its variables got an
  8-byte box whose $box pointer sat one past the block, so the collector
  freed the box under the closure (now at least 16 bytes); and a
  program kept another unit's global in a register while that unit held
  its address, losing the writes through the pointer (another unit's
  global stays in memory). From the same reading: MakeChan(n) had no
  check (a negative or huge n broke the allocator or wrapped the ring):
  a constant outside 0..2^26 is refused and rt_makechan stops with
  channel capacity N out of range; V128(1) compiled and crashed; a real
  went as its bits into an Inc step, an index, a for limit, a
  condition, SetLength and a case; a decimal literal past 2^63 wrapped
  and a hex one past 16 digits dropped bits; Succ past an
  enumeration's last value was not checked in a constant; a subrange's
  name was empty in messages (TypName looks the type section up); a
  program's variable or routine hid a unit's variable in silence; Sin
  and Cos of an infinity gave 0.0 (rt_trig now gives NaN); the shared
  mark of copy on write missed strings in a record's variant part
  (StrRuns walks them, checked through pasheap's PasStrBlock); and a
  value parameter only read followed a change the routine made to the
  caller's variable through a global, a pointer or a call
  (CopyValueParams copies unless the body writes nothing outside and
  calls nothing of the program). testdata/vshrs64 against a Python
  model, testdata/auditfix, audit2, closurebox and units/reguse on both
  machines, 23 rejects.
  1.0.137 visibility and Free: public, published, protected, private,
  strict protected and strict private sections are held to (private in
  the declaring unit, strict private in the class's methods, protected
  there and in descendants' methods in any unit, strict protected in
  those methods only), for fields, methods, constructors, properties
  and method values, through Self written or not, other instances,
  nested routines, closures and with; the .pi is PASLANGI13 with each
  member's section, the properties and the class's parent, slot count
  and interfaces, which also repairs a descendant declared in another
  unit (it lost its parent's virtual slots and reused them) and an
  interface carried in two .pi files. x.Free calls Destroy when x is
  not nil (the class's or an ancestor's, through the table when
  virtual), x worked out once; pas x.Free too; inherited with no
  ancestor's method is an empty statement; inside a method Self's
  members come before a global of the same name. testdata/visibility,
  freedestroy and units/visuse on both machines and under the
  collector's stress, thirteen rejects.
  1.0.138 every predefined name reserved: no declaration in a program
  or a unit may take the name of a predefined routine, statement word
  or type (Length, Sin, Min, Clear, Copy, Pi, PByte, Goid, ...); from
  1.0.131 to 1.0.137 only the words added since 1.0.131 were reserved
  and the older ones hid the builtin, at times in silence and wrongly
  (a function Length was ignored). The table is filled once from the
  parser's families (270 names) and sorted, the lookup halves it; the
  vector words are a rule, and what the core units export (Goid,
  Yield, TPasMutex, PasFmtReal, ...) is collected as they load and
  reserved everywhere but in the core unit that declares it. The
  message is the 1.0.131 one, at the name: Length is a reserved word,
  not a name at 5:3. The compiler's own clashes were renamed (TExpr.Int
  is Num, pastime's TDate.Min and Sec are Minute and Second, pasnet's
  Max parameters MaxN; pasmap's PChar and paslib's WaitFd, both the
  builtin already, are gone). testdata/reservedall on both machines,
  nine rejects.
  1.0.139 the deadlock detector, Go's checkdead: when every started M
  has made its final look for work and sleeps, none spins, no timer is
  pending, no routine is parked on the poller and a routine is still
  alive (main, or another after main ended), the program stops with
  paslang: all routines are asleep: deadlock, exit 1, instead of waiting
  for ever. rt_msleep counts the sleeping Ms in its low half and their
  wakes in its high half, so a checker that reads the same word twice
  knows nobody woke in between; rt_npollwait counts the routines parked
  by rt_waitio and rt_acwait. The arm64 poller now looks for work once
  more after the timers, as amd64 did. Six testdata/fatal/dl* programs
  and testdata/nodeadlock on both machines.
  1.0.140 map checks and stores: the key of m[k], k in m, Delete and
  TryGet is converted as a call's argument is (a Char into a string
  key becomes a string, a constant must fit a Byte key, a wrong kind is
  refused; m[c] with a Char c found nothing and TryGet(m, c, v)
  crashed); TryGet's v is a variable of the value type; for k, v in m
  checks k against the key type (or a wider integer, or Integer for an
  ordinal) and v against the value type (a Byte v took the low byte of
  an Integer value); the map of a for loop is worked out once (a call
  ran once per entry); Delete and Clear zero the slots, so the values
  they drop are freed by the collector (they stayed alive until the slot
  was reused); m[k].X of a missing key reads zero (it went through a nil
  slot pointer) and m[k].X := e, m[k] += e, Inc(m[k]), Dec(m[k]),
  m[k].X += e, a var argument of m[k], SetLength(m[k], n) and with
  m[k] do write the entry, inserted with a zero value when the key was
  missing, the map and the key worked out once (they were refused:
  needs a variable); @m[k] is refused (the slot moves when the map
  grows); a map goes only into its own map type, across units too
  (any map went into any map); a map is named by its key and value in
  messages; Inc and Dec of a string are refused (they left garbage).
  testdata/mapfix on both machines and under the collector's stress,
  nine rejects.
  1.0.141 ordered trees. tree[K] of V is a B+ tree: at most 32 keys in
  a node, the value only in a leaf, the leaves linked in key order.
  tree of K is that tree with no value. The map's words, a range
  t[a..b], downto, Low, High, Succ, Pred, Floor, Ceil, Rank, KeyAt,
  Split and Join. heap of T is a binary min-heap, Push and Pop, the
  root the smallest, as Go's container/heap. Sha256 is FIPS 180-4.
  MerkleRoot, MerkleProof and MerkleCheck are RFC 9162: a leaf hashes
  0x00 and the entry, an internal node hashes 0x01 and its two
  children. StoreOpen keeps a memtable, a log and, on StoreClose, a
  B+ tree on disk.
  1.0.142 the words are the compiler's and their runtime is the core
  unit pastree, linked into every program without a uses clause as
  pasmap is (German, 2026-09-28: in the language means no uses file).
  1.0.143 the tree words whole, with testdata/tree2 against the model
  in scripts/treemodel.py on both machines and under the collector's
  stress: Low(t), High(t), Succ(t, k), Pred(t, k), KeyAt, Split, Join
  (a merge, b's value winning), TryGet, PopLow(t, k[, v]) and
  PopHigh, Include(t, k), Exclude(t, k) and t[k] := True or False on
  a tree of K, for k, v in t[a..b] and downto (the range was dropped),
  Pop(h) and Low(h) of a heap (an empty one stops the program), the
  strings a walk, TryGet or a Pop copies out marked shared. The nodes
  and the headers are scanned by the collector (an integer tree's
  nodes were not, and held the child pointers). A leaf split left the
  new leaf's count out of the ranks (KeyAt walked off the tree); Join
  and Split wrote the value one key past its place. A unit's
  implementation types are its own: its .pi no longer names them, so
  they are neither importable nor reserved (TDesc of pastree was).
  Push, Pop, Split, Join, Include and Exclude are reserved words:
  the manual's routines example, ifaceargs and parmark renamed
  theirs, and the emitter its own. Fifteen rejects in
  testdata/treebad.
  1.0.144 the hash words (P111) in the core unit pashash: Md5, Sha1,
  Sha224, Sha256, Sha384, Sha512, Sha3_224/256/384/512, HmacMd5,
  HmacSha1/224/256/384/512, Crc32, Crc32c, Adler32, Fnv1a32, Fnv1a64,
  Murmur3, SipHash and Hex, the Merkle words moved there; each
  algorithm in Pascal with its rounds written out, and a second body
  on the processor's instructions after Go's assembly (SHA-NI and
  FEAT_SHA1/SHA256/SHA512, SSE4.2 crc32 and FEAT_CRC32, PCLMULQDQ),
  tested against Python's hashlib in testdata/hash1 both ways. The
  processor is chosen when the program is compiled (-cpu):
  the parser calls the Cpu or the Base body, the emitter writes
  popcnt, the AVX2 vectors and XXH3's AVX2 path without a test, and
  rt_cpufeat serves CpuHas alone; PASLANG_AVX2 and rt_haspopcnt are
  gone. A static array where a var array of T goes is refused (it
  arrived empty).
  1.0.145 the store is a log-structured merge store (P110, after
  LevelDB): a log with CRC32C records replayed on open and cut at a
  torn tail, a memtable on the native tree, runs of data blocks with
  an index kept in memory, a flush at 1 MiB of log or on StoreClose,
  a merge of every run into one past four (written to <path>.new and
  renamed over <path>), tombstones until then, keys and values of any
  length, k in db; the old one held 16 entries of 40 bytes. A unit's
  interface may name another unit (pastree uses pashash for the CRC).
  testdata/store1 on both machines, under the collector's stress and
  for the base processor. The optimization manuals of Intel, AMD
  (family 19h) and Arm (Neoverse N2) are in docs/ref/asm, and
  docs/KERNELS.md catalogues the kernels.
  1.0.146 pasx11 is in --help lib. make check's assembly checks follow
  the processor chosen at compile time: bitwords, vectors, vecmore and
  vecpool are compiled once more with -cpu base and their base paths
  (the SWAR count, the SSE2 halves, the table shuffle) are looked for
  there, while popcnt, ymm and a run-time test of rt_cpufeat must be
  absent; the native build must hold none of the old rt_haspopcnt or
  btq rt_cpufeat tests: the choice is made when the program is
  compiled.
  1.0.147 RotateLeft and RotateRight of a whole value (a record, an
  array, a Quad, a vector, a string, a slice) turn the other way for a
  negative count, as rol and ror do and as the two words already did in
  a register; the other words of the family still change nothing for a
  count of 0 or less (rotmem regenerated). The manual gains programs on
  the rotations, Carry and whole values (examples/rotations, carry,
  bigrot) and sixteen more worked examples in every chapter, each run
  on both machines by make check. Found by writing them and fixed: a
  UInt32 kept in a register and a constant with bit 31 set (SetBit(u,
  12, 0), u andnot= $1000) gave andq $4294963199, which as refuses;
  the 32-bit form is written, which zero-extends as the register's
  clean form is (testdata/immwide, from scripts/immmodel.py: every
  operator and comparison with a constant at the edge of every width,
  in a register, in memory, out of place and by reference). AtomicAdd
  and AtomicCas with a plain variable where @v goes compiled and died
  on a nil pointer: refused with the words. MerkleRoot and MerkleProof
  with a static array of strings were refused with the words of a
  conversion: the message says to SetLength a slice. An uncaught raise
  in the main routine left the scheduler with nothing to run and the
  deadlock message: the program now ends with paslang: uncaught raise
  in the main routine and status 1 (testdata/fatal/mainraise); another
  routine's still ends that routine alone. The help said a statement
  Syscall does not call the runtime; it makes the call. A const
  parameter is the caller's value itself: nothing is copied in and
  nothing is marked shared (every call with a const string marked it,
  and the caller's next write copied the whole string: the hash of a
  megabyte took a copy per call); the compiler refuses a routine that
  changes a const parameter or passes it as var, and the address taken
  inside one is for reading. The hash words reach a string's bytes as
  Pointer(S). CRC-32C runs three crc32q chains at once and joins them
  by shift tables, as Go does (the PCLMULQDQ fold was tried and put
  aside); a constant shift is an immediate, x := x rol k turns x in place, an
  in-place operation takes a loop register directly; the unit's tables
  of 16 bytes or more are aligned on 16 and SHA-256 adds its constants
  from memory; the tree's node searches are binary and without a call
  per key, an insert adds one to the totals, a leaf keeps its keys
  together and its values after them (the loop's v comes from the
  iterator's fourth word). The counter of an innermost for weighs four
  uses in the register choice; a region of integer arithmetic alone
  lends r8 to a loop variable; a multiply by 2, 4, 8 is a shift and by
  3, 5, 9 a lea. b10rot at Go's time, b9hash at Go's time, b11tree at
  1.3 to 1.5 of the same B+ tree in Go (docs/BENCH-2026-09-29.md).
  Inline by measure (P112): a plain routine of the unit whose body
  counts -inline n nodes or fewer (40 by default), or one declared
  inline, is put in place where it is called, at a call statement, an
  assignment whose right side is the call and an if on it; its
  parameters and locals become hidden variables of the caller (inl.N.name),
  a var parameter the place given, a constant given to a const
  parameter the constant itself; -inline 0 keeps one copy of every
  routine (testdata/inline1, which make check also builds with -inline
  0 and compares, and reads the assembly for the calls that must be
  gone and the ones that must stay). A call evaluated first in an if,
  a case, an assignment's value or place, or the arguments of a call
  or Write goes through a hidden variable; a while or repeat whose
  condition makes such a call is rewritten so the if takes it; an
  unwritten value parameter given a constant or a caller's own
  variable is that itself; a local every path writes before reading
  is not zeroed, in a routine put in place nor in any prologue
  (WritesFirst); a for of a constant count of four or fewer with a
  small body is written out once per pass; -inline-trace says why a
  routine stays a call. The tree: for k, v in t steps in place after
  the first step (30 ms to 4 for a million), a split no longer sums
  every child up to the root (the halves on the new leaf's path are
  summed once the leaf is in), the shifts are one Move each, a
  one-word key or value a store: b11tree at 1.13 of Go's time. Found
  by tree2 under PASLANG_GCVERIFY once InsertSep took eight
  parameters: the words a call leaves on the stack for its arguments
  past the registers carried the classes of the first arguments, and
  an address passed for a var parameter carried the class of what it
  points to, so an address into the stack passed as the seventh
  argument stayed behind when the stack moved (testdata/stackargs on
  both machines, under the poison too). Only the code the program
  uses is linked: every routine in a section of its own, its stack
  maps in a section linked to it, laid inside pasgcmaps by a script
  the driver writes, --gc-sections at the link, the DWARF unit as
  ranges; hello is 118 KB of code where it was 374 (arm64 153); the
  debugging goldens are built with -inline 0. P114, the network:
  pasnet gains both address families and names, the peer of a
  datagram, the options a server sets, one direction shut, lines and
  counted reads over a buffer, the descriptor limit, a resolver and
  the DNS messages, and three servers with self-tests under make
  check (examples/httpd, dnsd, termd with its client: 10,000 clients
  and 30,000 requests in 1.2 s in one process). Found on the way: a
  Byte shifted or multiplied wraps in its byte (the unit casts to
  Integer), SO_REUSEADDR on a datagram socket bound to port 0 let two
  sockets share a port and cross their answers (set only for a port
  asked for), the listen backlog of 128 filled under two hundred
  connections at once and the kernel dropped the rest's SYN for a
  second (4096 now, the kernel's cap), Exit in a program's body
  jumped to a label never written (testdata/mainexit), and a string
  compared with a Char compared its pointer with the character's
  code: s = #0 was never True, nor s = c (testdata/charcmp). P115, the
  servers against Go: the runtime polls the network without waiting
  from a thread whose queues ran dry, before it steals, and from the
  monitor when nobody has for 10 ms, as Go does; under a burst that
  kept every thread busy the routines the descriptors woke stayed
  parked and a datagram server's socket overflowed (1262 of 10,000
  queries dropped by the kernel; none now, 0.16 s for the burst). A
  datagram send that meets a full buffer parks until it drains. The
  poll must leave the runtime's poke (the eventfd) to the idle poller
  that waits for it: draining it there lost that thread's wake and
  sync1 hung. P117: Unix-domain sockets in pasnet, stream and datagram
  over a path or an abstract name, a pair, the peer's credentials, a
  descriptor passed with a message, a wait on several descriptors
  (testdata/unixsock on both machines; termd -unix path). P118: the
  debugger inside the executable: -debug adds uses pasdebug, a call at
  every statement (line, routine, frame) and tables of the routines,
  their variables and the lines in a section pasdbg; the unit serves a
  line protocol on the Unix socket PASLANG_DEBUG names (break, step,
  next, continue, where, vars, globals, functions, run again, quit);
  promotion and inlining off under the flag, since the hook is a call;
  the serving routine leaves rt_nlive so the program ends when its main
  routine does; testdata/debug1 on both machines; bin/pasdbg. P119:
  five more servers with self-tests, examples/ftpd (with its client),
  ntpd (with its query), wsd, chat and proxy; paslib's ListDir gathers
  the names and joins them once (it appended to a growing string).
  P115, the servers at Go's time: the timers are a heap and a deadline
  wait is one of them, not a timerfd (dnsd 1.14 of Go's time to 1.00);
  the timer walk no longer drops its lock in the middle (thousands of
  routines in Sleep spun on a cycle in the list); socket writes never
  raise SIGPIPE; a wait re-arms its descriptor with MOD first; termd,
  ftpd and chat read the greeting with a deadline, since a burst past
  the SYN backlog leaves cookie connections the server never had. P113,
  the last core pairs at Go's time: t[k] and t[k] := v of a tree with a
  key that compares as an integer and an 8-byte value take the key by
  value (PasTreeGetI, PasTreePutI), a split no longer descends again, a
  new node is not cleared twice (b11tree 1.11 of Go's time to 0.95); a
  for from a constant to Length(s) whose body only stores s[i] from
  values that call nothing checks s once before the loop and its stores
  none (b9hash 1.03 to 1.00).

  Before the publication, in 1.1.1 too: the license, GPL version 3 or
  later, the runtime library with the paslang Runtime Library Exception
  and the documentation under the GFDL, with a notice in every source
  and -v saying so; the bootstrap
  from Free Pascal builds again (no hint under -Sewnh) and then builds
  itself. P120, the debugger's console: a program compiled with -debug
  takes --debug-mode (a console on its terminal), --debug-listen socket
  or --debug-attach socket as its first argument, the words taken out
  of its command line (argv moves up, so the environment stays where
  the runtime finds it); it stops before its first statement; the
  console has gdb's short words, the source around a stop (the request
  list), one variable, an empty line that repeats a step, Ctrl-C that
  stops every routine (a SIGINT handler that sets a flag), and run that
  keeps the breaks (PASLANG_DEBUG_BREAKS); pasdbg is the same console.
  wait no longer reports a stop someone already let go on, a client
  that leaves takes its breaks with it, and the poller and its eventfd
  close on exec, so a run does not carry them into the new program.

  1.1.2, P121: TObject, the root of every class, in the new core unit
  pasobject; a class with no parent descends from it. Its virtual
  methods (Destroy, AfterConstruction, BeforeDestruction, Equals,
  GetHashCode, ToString) take slots 0 to 5; the method table carries,
  before them, the class's name as a string literal lies, its length
  and an instance's size, which ClassName (no copy), ClassNameIs and
  InstanceSize read. AfterConstruction is called after a constructor
  only when the class overrides it, directly; BeforeDestruction before
  Free's Destroy and an outermost x.Destroy, never an inherited one
  (inherited calls are marked). Free goes through pasobject's
  PasObjFree. A Destroy with TObject's signature overrides it even
  without the word, as any method redeclared with an inherited
  virtual's signature does.

  1.1.3, P122: exceptions carry objects. raise X raises an object of a
  class, raise X at A says where; an except part takes on E: T do and
  on T do handlers, the first whose class the object is or descends
  from, E seen by that handler alone, then else, or the object goes on
  out; raise; in an except part raises its object again, elsewhere no
  object, as before. The routine record grows to 288 bytes: G+272 the
  object, G+280 where it was raised; an except part puts back the
  object it replaced when it ends, so an outer handler's raise; and a
  finally part a raise went through see theirs. An object nobody
  handles in the main routine ends the program with pasobject's
  PasUncaught: the line says what its ToString says.

  1.1.4, P123: class methods and class references. class function and
  class procedure take the class as Self (virtual, overridden, abstract
  or static); class of T and TClass hold a class, whose class methods,
  class words and constructors are reached through them, a virtual
  constructor running the held class's own and the object made of its
  size (the table's word -48 is the instance's descriptor); class var
  and x: T; static; are globals named Class.Name, class property reads
  them or a static method; class constructors and destructors run at
  the start and the end. The arm64 constructor passes a ninth argument
  on as a method does (it stopped at seven). .pi PASLANGI15 (CVAR, a
  PROP line's class flag).

  1.1.5, P124: array of const. A parameter's type, a slice of TVarRec
  (the compiler's, with its kinds vtInteger ... vtQuad, Free Pascal's
  numbers); a list in brackets where one goes is built in a scratch
  region of the caller's frame (rt_constarr, EmitConstArr), each value
  with its kind and in the record itself, and lives for the call: the
  callee reads, indexes, measures, walks and passes it on, and keeping
  it, its address, a closure over it, pas with it and a var one are
  compile errors.

  1.1.6, P125: default parameters on methods, constructors, class
  methods and interfaces' methods (TMethInfo.HasDef, Def, DefStr; the
  .pi METH line says them, PASLANGI16), and nil and a constant set as
  defaults of any routine; a method's body repeats its declaration's
  defaults or none. A method call with too few arguments or too many is
  an error: it took whatever the registers held.

  1.1.7, P126: sets up to 256 elements. set of Char, of Byte and of a
  subrange past 63 are 32 bytes, a block as a record is; + - * are one
  AVX2 instruction (two SSE2 ones, two NEON ones), = <> <= >= vptest
  or ptest, for x in walks the set with tzcnt and blsr (rbit and clz);
  a list in brackets is typed by its elements and by where it goes, an
  element known at run time checked against the set's range
  (rt_setfail); sets of one kind and other ranges meet in the set that
  holds both, and one goes into another dropping what the other cannot
  hold (rt_setconv), as FPC does; Include and Exclude of a set; a list
  of what no set holds (['ab', 'cd'], [1.5]) is a list, walked in its
  order by for x in; x in [..] with x as a set of 0..63 is false past
  63, not bit x mod 64; [1] <= [0, 2] was true. .pi PASLANGI17 (a set
  constant's type and bytes).

  1.1.8, P135: a subrange is of its bounds' type, its host (TTypeDef.Elem
  of a tykSubrange, InternSubOf): '0'..'9' and #0..#31 of Char, which was
  refused, Mon..Fri of the enumeration, which was a subrange of the
  integers. A value of a subrange of Char prints, joins, compares and
  converts as a Char (IsCharT, AsChar); a character constant goes into
  one in its range; for d := '3' to '6' takes characters. Sets know an
  enumeration's kind from the integers' (SetFamily), so [Red] is no
  element of a set of TDay. A Char against a one-character literal
  compares the codes, not two strings. .pi PASLANGI18: an enumeration's
  members say their type (they crossed a unit as Integers).

  1.1.9, P127: helpers. type helper for T, record helper for R and class
  helper for C (tykHelper, Elem the type, Lo the kind) add methods and
  properties to a type; each method is a routine Helper.Method whose
  first parameter is Self, by reference for a value (HelperSelf: the
  variable's address, or rt_tmpaddr's hidden copy of a value, a
  constant or a const parameter), the object for a class helper. A
  member of the helper in scope (HelperFor: the last declared or loaded
  for the type) is found before the type's own; Integer.Max3 and
  string.Join name a static method through the type; a property reads
  and writes through the helper's methods (a write is Flags 128, whose
  statement adds the value); a helper descends from another; private
  and strict private hold. .pi PASLANGI19 (a helper is a TYPE of kind
  24).

  1.1.10, P134: Pascal's string words. Pos (with a start, of a Char),
  Insert, Delete of a string, Copy of the rest, Concat, UpCase and
  LowerCase of a Char (inline, no branch) and of a string, StringOfChar,
  Str (a member by its name) and Val (every base, a real, a member, the
  code) as Free Pascal has them, in the new core unit passtr, its hot
  cores kernels after Go's internal/bytealg: IndexByte, MemEq and the
  ASCII case map on AVX2, SSE2 and NEON (-cpu picks). The words are
  reserved; the compiler's and the core units' own str, val and pos
  were renamed.

  1.1.11, P136: Copy(a, i, n) and Copy(a, i) of a slice, Insert(x, a, i)
  and Delete(a, i, n) of one, as Free Pascal's: 0-based and clamped,
  each a new slice made of views (rt_slicecut, with cmov and no branch)
  appended to nil; before, Copy of a slice compiled and gave garbage.
  String = and the order of strings on Go's memequal and cmpbody: AVX2
  or SSE2 64 bytes a step (-cpu), NEON on arm64; they were a byte a
  step.

  1.1.12, P137: a routine's constants, types and nested routines are its
  own: seen in it and in what it nests, gone at its end (FConstScope,
  FTypeScope, FProcScope), the innermost found first, so two routines
  may each have a nested Sub or a constant K and a local name hides the
  program's; a local variable, constant, type and nested routine of one
  routine may not share a name (LocalDup). Two routines with a nested
  routine or a constant of one name were refused as duplicates.

  1.1.13, P138: the last unit in uses hides the names the earlier ones
  share with it, as in Free Pascal (a routine of the same parameters, a
  constant, a variable, a type that differs); it took the first unit's.
  A unit's name reaches its own names, hidden or not: ua.Twice, ua.Count,
  ua.TBox (TProcEnt, TConstEnt and TTypeName say their Owner; each name
  of a unit has its qualified twin).

  1.1.14, P139: the short class forms. TFoo = class(TParent); is a class
  with nothing of its own (it was 'class member'); TFoo = class; and
  IFoo = interface; declare a class or an interface forward, declared
  whole later in the same declarations, the same type (FFwdTypes,
  DeclareFwd, TakeFwd, CheckFwdTypes); one not whole yet is refused as a
  parent and as an interface a class implements, and TA = class(TA),
  which compiled, is refused.

  1.1.15, P140: an object goes where an interface goes, not only into an
  interface variable: an argument, a result, Exit, an element, a field
  (ValArg binds it, rt_ifacebind: the object and its class's table);
  they took the object alone and a call through them read no table. A
  call through an interface runs the object's own virtual method, an
  override too (a two-instruction thunk in the table); the class's own
  ran. A parent of a listed interface is not implemented, as in Free
  Pascal: it failed at the link.

  1.1.16, P141: overloads take what a call takes, priced as Free Pascal
  3.2.2 ranks them (ConvCost): a Char for a string, an object for its
  ancestor (the closest first) and for an interface it implements, a
  pointer for Pointer, a subrange for its host, nil, a list for a set,
  a slice or an array of const, a one-character literal for a Char
  before a string; Free Pascal's ties are ambiguous here too. Only the
  exact types, the integers and the reals matched: F(c) for F(const S:
  string) found no overload. A list of an integer and a Char is a list
  for an array of const (Format('%d%s', [n, 'x'])); it was refused as a
  set of two kinds.

  1.1.17, P142: Val into an unsigned type reads a decimal number to
  2^64 - 1, as Free Pascal's (PasValInt's unsigned path counts up, not
  below zero); 18446744073709551615 was an error, and StrToQWord of it
  failed.

  1.1.18, P143: every unit is built twice, for the base processor and
  for a level beside it (v3 on amd64, v8.2+crypto on arm64); a program
  whose -cpu has every feature of the level links the level's objects
  (UnitObj), when not older than the base's. A unit's words that choose
  a kernel by -cpu took the base kernels whatever the program's -cpu:
  a unit's UpCase of a string called the SSE2 body under -cpu native.

  1.1.19, P144: var x: T = value, as Free Pascal: a global starts with
  the value (a typed constant's image, writable), a routine's variable
  takes it at every call (a hidden constant of the routine's copied as
  it starts, FVarInits); and var y: T absolute x, another name for the
  variable x of the same type, global, local or a parameter (its Sym;
  a global alias has no storage and is exported with x's symbol). Both
  were syntax errors.

  1.1.20, P145: Extended is Double, as Free Pascal has it on arm64 and
  Win64, and a reserved name as Real and Double are; Free Pascal's
  SysUtils declares its reals Extended, and it was an unknown type.
  examples/ftpd's parameter Extended is Epsv.

  1.1.21, P146: Val into a Single rounds once from the digits (passtr's
  PasValSingle, pasfmt's PasParseSingle), as Go's ParseFloat(s, 32);
  it was refused, 'Double needs Single(x)'. Val into a Quad keeps its
  113 bits (PasValQuadLo, the words seen as the Quad); it kept 53
  through a Double.

  1.1.22, P147: CompareByte(a, b, n) and IndexByte(x, n, v), Free
  Pascal's System words, on kernels chosen by -cpu: passtr's
  PasCmpByteCpu (AVX2, after Go's cmpbody with the place of the first
  difference kept) and Base (SSE2; NEON on arm64), and PasIndexByte's; a
  count not above 0 reads nothing (IndexByte's kernels read on below 0).
  Reserved names. PasCaseCmpCpu and Base: the same comparison with the
  ASCII letters of both runs as capitals, CompareText's.

  1.1.23, P148: the ifdef words of the processor compiled for:
  CPU_<NAME> for every feature -cpu has (CPU_AVX2, CPU_SSE42, CPU_CRC32,
  CPU_SHA2...; CpuFeatNames, TLexer.SetFeature), so a unit or a program
  chooses its bodies by -cpu when it is compiled, as the language's
  words do; a unit's level build (P143) takes its level's.

  1.1.24, P128: uses sysutils, Free Pascal's SysUtils in src/rtl, built
  and installed as the other library units (for both machines, at the
  base and at a level): its exceptions, its string, integer, Boolean
  and real conversions and the format settings; --help lib names it.

  1.1.25, P129: SysUtils' Format, FmtStr, FloatToStr, FloatToStrF,
  FormatFloat, FloatToDecimal and Exception.CreateFmt: Free Pascal's
  forms, Go's digits (the unrounded scaling of its strconv, uscale.go,
  for a Double and a Single), rounded once, a tie to even, the fewest
  that read back when no precision is asked; a Quad's digits exact in
  all 113 bits (pasfmt's PasQuadDigits, shortFloat's way with exact
  arithmetic, in place of the whole expansion: an extreme Quad took
  25 to 100 ms, now 1.5 at most). pasfmt's BigShrRound shifts through
  the new BigShrTrunc; PasFmtInt makes its string once, two digits a
  step (paslib's IntToStr's body, moved to the core, which IntToStr
  calls: it put one digit before the string at a time, a string made for
  each), and Pad too. Each form of SysUtils works out its length and
  makes its string once: FloatToStr went from 450 ns to under 200.

  1.1.26, P151: every duplicate-name message says where, and what the
  other name is: a constant, a variable, a routine, a routine with the
  same parameters (FDeclAt, DupAt: the place of the name being declared,
  a parameter's own from TParam.At), as the local ones said since P75
  and P137; so do 'duplicate forward' and 'implementation does not
  match'. 'duplicate identifier Format in sysutils.paslang' named no line
  in a unit of thousands.

  1.1.27, P149: Val into an integer reads it into its own type's range
  (passtr's PasValRange, the range, the sign and the width from the
  parser): past it an error at the digit that goes past, a minus into an
  unsigned type at its place, another base filling the width's pattern
  ($FF into an Int8 is -1), a subrange held to its bounds; on an error 0,
  or the type's lowest value when 0 is not one of it. Free Pascal 3.3.1's
  Val; its 3.2.2 kept the low bits, and so did this ('300' into a Byte
  was 44). SysUtils' StrToDWord family reads 0 to 2^32 - 1 (it masked).
  The QWord reading's test of 2^64 is unsigned: a 21st digit went
  through it once the number passed 2^63, and wrapped (P142's).

  1.1.28, P154: a unit's type carries the unit's name, its stem
  (TTypeDef.Sym, CSYM in the .pi, PASLANGI20): a class's, an
  interface's and a helper's symbols are vmt_unit_name, rtti_unit_name,
  ivmt_..., p_unit_name_method, and an operator of a unit's is
  p_unit_op_...; the stem is the type's identity where a .pi brings it
  in again (SameTyp, ClassUnder, TypeSteps, ClassHasIface, CheckVis
  compared names). Two units' TShape did not link (vmt_tshape twice)
  and were taken for one. x is ua.T and x as ua.T read T as a type.

  1.1.29, P155: a type is declared once where it is, whatever its kind
  (OwnTypeNamed: a type of the program's or the unit's own, or the
  language's): an alias T = U and a class reference took a type's name
  in silence; and a program's type hides one a used unit declares, as in
  Free Pascal, where a record of that name was 'duplicate type'.

  1.1.30, P158: a name the program or the unit declares at its top level
  hides the names of it that the units it uses declare, of every kind,
  and a later unit's name hides an earlier unit's of every kind
  (HideUnitNames: the plain name goes, ua.Name stays); a routine's
  variable or parameter hides a used unit's routine, constant or type
  inside it (LocalHides, in FindProc, ResolveProc, FindConst and
  NamedType). They were duplicates: with SysUtils in its uses a program
  could not call a variable Date or a parameter Format, and a unit's
  names were a used unit's in its implementation. At the top level a
  name is declared once whatever its kinds (OwnDup): a variable and a
  routine, a type and a constant of one name compiled in silence. ua.T
  names a type wherever a type goes (TypeAhead, PeekDotName): SizeOf,
  High and Low, a class's, an interface's and a helper's parent, class
  of, ^ua.T, on E: ua.EFail and on ua.EFail; they said unknown. }
function PaslangVersion: string;
begin
  Result := '1.1.30';
end;

function Eq(const A, B: string): Boolean;
var
  i: SizeInt;
  ca, cb: Char;
begin
  Result := False;
  if Length(A) <> Length(B) then
    Exit;
  for i := 1 to Length(A) do
  begin
    ca := A[i];
    cb := B[i];
    if (ca >= 'A') and (ca <= 'Z') then
      ca := Char(Ord(ca) + 32);
    if (cb >= 'A') and (cb <= 'Z') then
      cb := Char(Ord(cb) + 32);
    if ca <> cb then
      Exit;
  end;
  Result := True;
end;

function Dashes(N: SizeInt): string;
var
  i: SizeInt;
begin
  Result := '';
  for i := 1 to N do
    Result := Result + '─';
end;

{ The frame measures itself. FrameTop opens a box, FrameLine and
  FrameRow collect its lines, FrameBot writes the whole box as wide as
  its longest line and never narrower than BoxMin. A fixed width broke
  the right edge as soon as one line grew past it, as the lib row of
  the index did. The corner and dash characters are three bytes each,
  so the width is counted in characters and never with Length. }
const
  BoxMin = 60;    { every box is at least this wide }
  BoxPad = 2;     { blanks kept after the longest line }
  BoxCol = 34;    { where the right column of a row starts }

var
  BoxTitle: string;
  BoxText: array of string;

procedure FrameTop(const Title: string);
begin
  BoxTitle := Title;
  BoxText := nil;
end;

procedure FrameLine(const S: string);
var
  n: SizeInt;
begin
  n := Length(BoxText);
  SetLength(BoxText, n + 1);
  BoxText[n] := S;
end;

procedure FrameRow(const Left, Right: string);
var
  line: string;
begin
  line := Left;
  while Length(line) < BoxCol do
    line := line + ' ';
  FrameLine(line + Right);
end;

procedure FrameBot;
var
  i, w, used: SizeInt;
  line: string;
begin
  w := BoxMin;
  for i := 0 to High(BoxText) do
    if Length(BoxText[i]) + BoxPad > w then
      w := Length(BoxText[i]) + BoxPad;
  used := 0;
  if BoxTitle <> '' then
  begin
    used := 1 + 1 + Length(BoxTitle) + 1;
    if used + BoxPad > w then
      w := used + BoxPad;
  end;
  if BoxTitle = '' then
    line := Dashes(w)
  else
  begin
    line := '─ ' + BoxTitle + ' ';
    for i := used + 1 to w do
      line := line + '─';
  end;
  WriteLn('  ╭' + line + '╮');
  for i := 0 to High(BoxText) do
  begin
    line := BoxText[i];
    while Length(line) < w do
      line := line + ' ';
    WriteLn('  │' + line + '│');
  end;
  WriteLn('  ╰' + Dashes(w) + '╯');
  BoxText := nil;
  BoxTitle := '';
end;

procedure PrintBanner;
var
  host: string;
begin
  if Amd64 = 0 then
    host := 'GNU/Linux arm64'
  else
    host := 'GNU/Linux amd64';
  FrameTop('');
  FrameLine('  paslangc  ' + PaslangVersion());
  FrameLine('  living modern pascal');
  FrameLine('');
  FrameLine('  Pascal spelling. 64-bit Integer. UTF-8 string.');
  FrameLine('  / divides reals. div divides integers.');
  FrameLine('  A routine is a G. It parks; the thread stays free.');
  FrameLine('  ' + host + '. The program does not link libc.');
  FrameBot;
end;

{ What paslangc -v says under the card, as the GNU coding standards
  ask of --version. }
procedure PrintLicense;
begin
  WriteLn('Copyright (C) 2026 Germán Luis Aracil Boned');
  WriteLn('License GPLv3+: GNU GPL version 3 or later <https://gnu.org/licenses/gpl.html>;');
  WriteLn('the runtime library with the paslang Runtime Library Exception.');
  WriteLn('This is free software: you are free to change and redistribute it.');
  WriteLn('There is NO WARRANTY, to the extent permitted by law.');
end;

procedure HelpIndex;
begin
  FrameTop('index');
  FrameRow('  paslangc file.paslang', 'compile a program');
  FrameRow('  paslangc -h', 'this page');
  FrameRow('  paslangc -v', 'the card above');
  FrameRow('  paslangc --help', 'every section');
  FrameRow('  paslangc --help flags', 'every compiler option');
  FrameRow('  paslangc --help types', 'sizes, reals, pointers');
  FrameRow('  paslangc --help lang', 'Pascal you can write');
  FrameRow('  paslangc --help runtime', 'Gs, Syscall, park');
  FrameRow('  paslangc --help lib', 'core sync, maps, pasnet');
  FrameRow('  paslangc --help limits', 'what is refused');
  FrameRow('  paslangc --help examples', 'commands that work');
  FrameLine('');
  FrameLine('  intel64 is amd64. The default target is this binary.');
  FrameBot;
end;

procedure HelpFlags;
begin
  WriteLn('## flags');
  WriteLn('What you type. One .paslang file becomes one program, one unit, or one package.');
  WriteLn('paslangc [options] file.paslang');
  WriteLn('The source path must end in .paslang. One source file is one program, one unit, or one package.');
  WriteLn('-h');
  WriteLn('  Print the short index and stop.');
  WriteLn('-v');
  WriteLn('--version');
  WriteLn('  Print the version banner and stop. The version is ' + PaslangVersion() + '.');
  WriteLn('--help');
  WriteLn('  Print the whole manual and stop.');
  WriteLn('--help <topic>');
  WriteLn('  Print one section. Topic is flags, types, lang, runtime, lib, limits, examples, or all;');
  WriteLn('  index and short print the index. An unknown topic prints the index.');
  WriteLn('-o <path>');
  WriteLn('  Output file. A program with no -o is named a.out in the current directory.');
  WriteLn('  A unit with no -o is build/<unitname> (the object is build/<unitname>.o and the interface is build/<unitname>.pi);');
  WriteLn('  with -target arm64 it is build/a64/<unitname>, beside the arm64 core units.');
  WriteLn('  Assembly is written beside the object as .s when -o has a directory, otherwise under build/.');
  WriteLn('-c');
  WriteLn('  Compile and assemble. Do not link. Use this for units. A program built with -c is only an object file.');
  WriteLn('-checkptr');
  WriteLn('  Hold every pointer step and access to its object: p + n, Inc, Dec, p^, p[i] and every view. One that');
  WriteLn('  leaves it stops the program: paslang: pointer outside its object at line N. The object is a heap block,');
  WriteLn('  the routine''s stack or the globals. A step may reach one past its end, as in C, so a walk may end');
  WriteLn('  there; an access there is outside, and p[i] and (p + n)^ are held to p''s own object. Per unit (its');
  WriteLn('  .pi says CHECKPTR); a loop that only walks a pointer takes about 11 times the time, a list walk 5,');
  WriteLn('  code without pointers the same.');
  WriteLn('-Fu <dir>');
  WriteLn('  Directory of compiled units (.pi and .o). Repeat the flag for several directories.');
  WriteLn('  Search order: each -Fu, then PASLANG_LIB if set, then <prefix>/lib/paslang next to the compiler');
  WriteLn('  (lib/paslang/aarch64 instead for -target arm64), then build/a64 for -target arm64, then build,');
  WriteLn('  then ., then the source file''s directory.');
  WriteLn('-install <dir>');
  WriteLn('  Required for a package. Compiles each contained unit and copies its .pi and .o into <dir>,');
  WriteLn('  plus <name>.pkg. A program or a unit ignores it.');
  WriteLn('-cpu base | native | max | v2 | v3 | v4 | v8.1 | v8.2 | crypto | <features joined by +>');
  WriteLn('  The processor the code is compiled for (P111). The compiler chooses the instructions by it and');
  WriteLn('  the program tests nothing at run time: PopCount, the vectors, XXH3 and the words that have a body');
  WriteLn('  on the processor''s instructions (Sha1, Sha256, Sha512, Crc32, Crc32c, the HMAC and Merkle words)');
  WriteLn('  take it when the set has the feature, the base path when not. base is SSE2 (fp and asimd on');
  WriteLn('  arm64) and runs anywhere; native is what this machine has, the default when the target is this');
  WriteLn('  machine; base is the default across (amd64 to arm64); max is every feature the target names;');
  WriteLn('  v2, v3 and v4 are the x86-64 psABI levels; v8.1, v8.2 and crypto the arm64 steps; any name of');
  WriteLn('  CpuHas may be joined: -cpu v3+sha+pclmul. A program compiled for a processor the machine is not');
  WriteLn('  dies with an illegal instruction. The core units and the compiler are built for base.');
  WriteLn('-inline <n>');
  WriteLn('  Inline by measure (P112). A routine of the unit whose body counts n statements and expression');
  WriteLn('  nodes or fewer is put in place where it is called, when it is plain: no nested routine, closure,');
  WriteLn('  method or constructor; parameters, locals and result of an integer, Boolean, enumeration, subrange');
  WriteLn('  or pointer type; a body of assignments, ifs, loops, cases, calls, Write, Inc, Dec, Halt, Break and');
  WriteLn('  Continue in its own loops, and nothing else; never itself. The sites are a call statement, an');
  WriteLn('  assignment whose right side is the call (alone, under not or a conversion, or the left operand');
  WriteLn('  of an operator whose other operand makes no call) and an if on such a condition. A routine');
  WriteLn('  declared inline goes in whatever its size; -inline 0 keeps one copy of every routine. 40 by default.');
  WriteLn('  At the same level a for of a constant count of four or fewer with a small body is written out');
  WriteLn('  once per pass. -inline-trace says on the error output why each routine stays a call.');
  WriteLn('-debug');
  WriteLn('  The debugger inside the executable (P118). The program gets uses pasdebug, a call of the debugger');
  WriteLn('  at every statement, and tables of its routines, variables and lines; -inline 0 and no variable');
  WriteLn('  in a register. Run with PASLANG_DEBUG=<socket> (a path, or @name for an abstract one) it listens');
  WriteLn('  there and answers a line protocol: routines, stopped, wait, where g, vars g [frame], globals,');
  WriteLn('  functions, break line|file:line|routine, breaks, delete n, step g, next g, continue g, stop [g],');
  WriteLn('  run [args], list file:line [n], quit. Or the program''s first argument asks for a console (P120):');
  WriteLn('  ./prog --debug-mode args runs it with a console on its terminal, stopped before its first');
  WriteLn('  statement; --debug-listen <socket> args serves the socket and waits there for a client;');
  WriteLn('  --debug-attach <socket> makes the executable the console of the program listening there. The');
  WriteLn('  console: b, d, c, s, n, bt, f, p, l, vars, globals, routines, stop, run [args], q; Ctrl-C stops');
  WriteLn('  every routine. bin/pasdbg <socket> is the same console; pasdbg <socket> <request> sends one');
  WriteLn('  request. Without the variable or a word the program runs as it is; without the flag it');
  WriteLn('  carries none of it.');
  WriteLn('-target amd64 | -target intel64 | -target arm64');
  WriteLn('  Code to emit. intel64 is the same machine as amd64.');
  WriteLn('  The amd64 compiler cross-assembles arm64 with aarch64-linux-gnu-as and aarch64-linux-gnu-ld.');
  WriteLn('  An arm64 compiler uses /usr/bin/as and /usr/bin/ld when those binaries are AArch64, otherwise the cross tools.');
  WriteLn('--lex');
  WriteLn('  Print tokens of the source and stop. Does not compile.');
  WriteLn('There is no -O, -g switch, or define flag. DWARF line numbers are always emitted, and every integer local');
  WriteLn('  at its width and sign, and every Single and Double local, with its type.');
  WriteLn('Exit status: 0 after a finished compile or after -h, -v, --version, --help, or --lex.');
  WriteLn('A missing file, a syntax error, or a failed assemble or link calls Halt with a message on stderr.');
end;

procedure HelpTypes;
begin
  WriteLn('## types');
  WriteLn('How big each value is. Read this before assuming a size from another Pascal.');
  WriteLn('Integer is signed 64-bit. These names are the same 8-byte integer:');
  WriteLn('  Integer LongInt SizeInt NativeInt PtrInt Int64 Cardinal QWord UInt64 Rune');
  WriteLn('Six narrow types keep their width in their values (names between dots are one type):');
  WriteLn('  Byte UInt8 . Int8 ShortInt . Word UInt16 . Int16 SmallInt . UInt32 LongWord DWord . Int32');
  WriteLn('They take 1, 2 or 4 bytes in arrays, fields and through pointers; a record lays its fields at natural alignment.');
  WriteLn('The indicated type rules: with b = 255, i := b + 1 is 256, b := b + 1 is 0, WriteLn(b + 1) is 0.');
  WriteLn('Widening is implicit, narrowing needs a conversion (Byte(i) keeps the low bits); a constant that does not fit is an error.');
  WriteLn('Boolean is 8 bytes. False is 0, True is 1.');
  WriteLn('Char and AnsiChar are 1 byte. A string index s[i] is a Char, and i is 1-based: s[1] is the first byte.');
  WriteLn('Rune is an integer holding a Unicode scalar. for r in s do walks scalars, not bytes. Length(s) is bytes.');
  WriteLn('string is a 16-byte value: pointer at offset 0, Int64 byte length at offset 8.');
  WriteLn('  No 255 cap, no length byte in front of the data, no required trailing zero.');
  WriteLn('  Assignment copies the pointer and the length. Concatenation allocates a new buffer.');
  WriteLn('  ''ab''#10''c'' is one string. A lone #10 is a Char, not a string; WriteLn(#10) writes that byte.');
  WriteLn('  = <> < <= > >= all compare the bytes. A prefix comes before the longer string.');
  WriteLn('Real, Double and Extended are one IEEE binary64 value, 8 bytes. Single is IEEE binary32, 4 bytes, in 32 bits;');
  WriteLn('  with a Double it widens, a Double becomes a Single only through Single(x), and a constant rounds once to it.');
  WriteLn('  Quad is IEEE binary128, 16 bytes, 34 digits, worked out in software: the same bits on both machines.');
  WriteLn('  Everything widens to a Quad; a Quad becomes a Double only through Double(q), an Integer through Trunc');
  WriteLn('  or Round. + - * / compare Abs Sqr Sqrt Int Frac Min Max Inc Dec WriteLn take it (docs/QUAD.md).');
  WriteLn('  A routine named Double or Single is a call. Double(n) converts only when no such routine exists.');
  WriteLn('  Real(n) converts an integer to binary64.');
  WriteLn('  / is real division, including 10 / 4. div and mod stay integer.');
  WriteLn('  + - * are real when either operand is real. A comparison promotes an integer operand.');
  WriteLn('  WriteLn of a real prints a sign, the integer part, and up to 6 fractional digits,');
  WriteLn('  dropping trailing zeros but keeping one digit: 4.0, 2.5, -1.5.');
  WriteLn('  A real where an integer, a Boolean or an enum goes is an error: write Trunc or Round. Trunc, Round,');
  WriteLn('  Floor and Ceil of a NaN, an infinity or a real out of Integer''s range stop the program.');
  WriteLn('array of T is a slice: pointer, length, capacity, 24 bytes. Index 0 is the first element.');
  WriteLn('array[Low..High] of T is a fixed block with those bounds. No hidden header.');
  WriteLn('record fields are in source order, naturally aligned. A trailing case overlays variants.');
  WriteLn('  case Kind: Integer of stores Kind, then the overlay. A field lies at its natural alignment (a pointer');
  WriteLn('  field on 8, for the collector) and the size rounds up to the most aligned field: Byte; Word; Int32 is 8.');
  WriteLn('^T is one machine word. nil is the zero pointer. New(P) allocates SizeOf the target type.');
  WriteLn('set of T is a bitset: one word for elements 0..63, 32 bytes up to 255 (set of Char, of Byte).');
  WriteLn('  in tests a bit; + - * = <> <= >= and Include, Exclude; [1..3] is a range of elements.');
  WriteLn('An enum and a subrange are 8-byte integers; a subrange is of its bounds'' type: ''0''..''9'' of Char, Mon..Fri of the enum.');
  WriteLn('type helper for T, record helper for R, class helper for C add methods to a type: s.Trim, Integer.Parse.');
  WriteLn('Pos, Insert, Delete, Copy, Concat, UpCase, LowerCase, StringOfChar, Str and Val are Pascal''s string words.');
  WriteLn('chan of T is a channel. MakeChan() creates one, MakeChan(n) one that buffers n values. send, recv, and close are statements.');
  WriteLn('map[K] of V is a hash map: one pointer, nil until New(m) or New(m, hint).');
  WriteLn('  K is an ordinal, a string, a pointer, or a class. V is any type.');
  WriteLn('  m[k] reads (zero value when absent), m[k] := v writes, k in m tests, Delete(m, k) removes,');
  WriteLn('  TryGet(m, k, v) reads with a Boolean into a v of type V, Clear(m) empties, Length(m) counts.');
  WriteLn('  The key is converted as an argument is: a Char goes into a string key, a constant must fit a Byte key.');
  WriteLn('  m[k] += e, Inc(m[k]), m[k].X := e, with m[k] do and a var argument of m[k] write the entry, inserted');
  WriteLn('  with a zero value when the key is missing; m[k].X of a missing key reads zero. @m[k] is refused.');
  WriteLn('  for k in m do and for k, v in m do walk the entries in no particular order: k is of type K (or a wider');
  WriteLn('  integer), v of type V. The map is worked out once. Delete and Clear free what the entries held.');
  WriteLn('  A nil map reads as empty; writing to one stops the program with paslang: nil map.');
  WriteLn('tree[K] of V is an ordered map, a B+ tree in memory: one pointer, nil until New(t). K is an ordinal,');
  WriteLn('  a string, a pointer or a class; V any type. tree of K is a set. The map''s words work: t[k], t[k] := v,');
  WriteLn('  k in t, TryGet, Delete, Clear, Length, for k in t, for k, v in t, in key order; downto walks it backwards;');
  WriteLn('  for k, v in t[a..b] walks the keys from a to b, both in. Low(t) and High(t) are the first and the last');
  WriteLn('  key, Succ(t, k) and Pred(t, k) the key after and before k, Floor(t, k) the greatest key <= k, Ceil(t, k)');
  WriteLn('  the least >= k (none stops the program: paslang: empty tree, tree succ, ...). Rank(t, k) counts the keys');
  WriteLn('  below k; KeyAt(t, i) is the key of rank i. PopLow(t, k, v) and PopHigh take the least or the greatest');
  WriteLn('  entry out and say whether there was one; PopLow(t, k) of a tree of K. u := Split(t, k) moves the keys');
  WriteLn('  from k up into a new tree; Join(t, u) moves every entry of u into t, u''s value winning, and empties u.');
  WriteLn('  A tree of K: t[k] reads True or False, t[k] := True, Include(t, k) and Exclude(t, k) change it.');
  WriteLn('heap of T is a binary min-heap: New(h), Push(h, x), Pop(h, x) with a Boolean, Pop(h) and Low(h) (an');
  WriteLn('  empty heap stops the program: paslang: empty heap), Length(h). T is an ordinal, a string or a real.');
  WriteLn('store is a key-value store on disk (P110), a log-structured merge store on the tree: db := StoreOpen(path)');
  WriteLn('  makes or opens path and path.wal; StorePut(db, k, v), StoreGet(db, k) ('''' when absent), k in db,');
  WriteLn('  StoreDelete(db, k), StoreSync(db) (the log to disk), StoreClose(db) (the memtable to a run, the files');
  WriteLn('  closed), StoreAbandon(db) (closed as a crash would: the log recovers it). Keys and values are strings');
  WriteLn('  of any length; each write is logged first, a torn log is cut at the last whole record.');
  WriteLn('mutex, rwmutex, waitgroup, cond, and once are sync types. Their zero value is ready.');
  WriteLn('  mutex 32 bytes, rwmutex 48, waitgroup 24, cond 16, once 32. They live where declared.');
  WriteLn('procedure(Args) of object and function(Args): T of object are 16-byte method values: code and Self.');
  WriteLn('interface value is 16 bytes: object pointer and method table. No reference count.');
  WriteLn('A class value is a pointer. The VMT sits beside the instance. Published properties have an RTTI table at vmt-8.');
  WriteLn('Pointer is an untyped address: its target has a type only through a view. These pointer types are');
  WriteLn('  predefined (a program''s own declaration of one of the names hides it): PByte PUInt8 PWord PUInt16');
  WriteLn('  PDWord PInt8 PInt16 PInt32 PUInt32 PShortInt PSmallInt PLongWord PInteger PInt64 PSingle PDouble PQuad');
  WriteLn('  PBoolean PPointer PChar.');
  WriteLn('  PT(q) sees any pointer as a PT, ^T(q) does the same in line for any T, T(q^) is the T at q (a variable),');
  WriteLn('  and TRec(q) is TRec(q^). With pb: PByte, Integer(pb^) converts the byte; PInteger(pb)^ reads 8 bytes.');
  WriteLn('  p + n and Inc(p, n) step n elements of the view (PDWord(X) + 1 is 4 bytes on, a Pointer steps bytes);');
  WriteLn('  q - r of one pointer type is the distance in elements; = <> < > compare addresses.');
  WriteLn('  View(p, n) sees memory as an array of n elements, its index checked. d[i..j] is a slice sharing d''s');
  WriteLn('  elements (capacity 0: growing it copies); s[i..j] of a string is a copy. MemBase(p), MemSize(p) and');
  WriteLn('  MemEnd(p) give the object p is in: a heap block, the routine''s stack, the globals; 0 when none.');
  WriteLn('  An access through @v, a field or a constant element of v, moved a constant number of bytes, that leaves');
  WriteLn('  v is a compile error: pointer outside its object: x has 8 bytes and this reaches bytes 8 to 8.');
  WriteLn('  A pointer one past the end of a heap block does not keep the block alive: keep a pointer to the block.');
  WriteLn('  safe code refuses all of this but New, p^ of a typed pointer, @x and nil; -checkptr checks it (flags).');
end;

procedure HelpLang;
begin
  WriteLn('## lang');
  WriteLn('The Pascal this compiler accepts. A form that is missing here is not a promise.');
  WriteLn('A program:');
  WriteLn('  program hello;');
  WriteLn('  begin');
  WriteLn('    WriteLn(''hello world'');');
  WriteLn('  end.');
  WriteLn('Statements: assignment, begin/end, if/then/else, while/do, repeat/until, for/to/downto,');
  WriteLn('  case/of/else, with, try/except, try/finally, raise, break, continue, exit, halt,');
  WriteLn('  procedure call, pas, send, recv, close, select, lock, once.');
  WriteLn('for i := 1 to N do and for i := N downto 1 do stop on the limit: after the loop i = N (1 going down),');
  WriteLn('  and a loop that does not run leaves i as it was. for r in s do walks Unicode scalars when s is a string.');
  WriteLn('for c in someSet do walks set bits. for k in m do and for k, v in m do walk a map.');
  WriteLn('lock mu do statement holds a mutex for the statement and releases it on every exit,');
  WriteLn('  including exit, break, continue, and an exception. lock rw do is the exclusive side of an');
  WriteLn('  rwmutex and lock rw read do the shared side. mu.Lock, mu.Unlock, and mu.TryLock also exist.');
  WriteLn('once o do statement runs the statement one time per once variable. Routines that arrive');
  WriteLn('  while it runs wait for it. o.Done tells whether it has run.');
  WriteLn('wg.Add(n), wg.Done, and wg.Wait count routines. c.Wait(mu), c.Signal, and c.Broadcast');
  WriteLn('  are the condition variable. Goid, NumGoroutine, and Yield look at the scheduler.');
  WriteLn('finally runs when its block is left by exit, break, or continue, not only at the end.');
  WriteLn('class function and class procedure take the class as Self, virtual or static; class of T holds a');
  WriteLn('  class (TClass any), and C.Create through it makes an object of the class it holds. class var,');
  WriteLn('  x: T; static, class property, class constructor and class destructor are the class''s own.');
  WriteLn('A parameter of type array of const takes [a, ''b'', 2.5, obj]: a TVarRec per value (VType, and');
  WriteLn('  VInteger, VAnsiString, VExtended, VObject...), built in the caller''s frame for the call alone.');
  WriteLn('raise X raises an object of any class; raise X at A says where. An except part takes on E: T do and');
  WriteLn('  on T do handlers, the first whose class fits, then else; with no else the object goes on out.');
  WriteLn('  raise; in an except part raises its object again, and raise alone elsewhere raises none.');
  WriteLn('  A handled object is not freed: the collector takes it back when nothing points to it.');
  WriteLn('Locals start as zero: an Integer is 0, a string is empty, a slice and a map are nil.');
  WriteLn('New(m) creates an empty map; New(m, 1000) sizes it for a thousand entries. Clear(m) empties it.');
  WriteLn('Integer(p) reads a pointer, class, map, chan, or ordinal as an Integer. Pointer(n) is the way back.');
  WriteLn('A routine is a value: type TLess = function(A, B: Int64): Boolean; f := @Up; f(3, 7).');
  WriteLn('  Sixteen bytes, the code and a closure''s variables. It can be a parameter, a field, an element,');
  WriteLn('  an answer, and it can be nil. At most six arguments through one on amd64, eight on arm64.');
  WriteLn('  procedure(x: Integer) of object is a method value: code and Self, with its signature;');
  WriteLn('  function(x: Integer): T of object too. m := obj.M takes one, @obj.F that of a function with no');
  WriteLn('  parameters; m(1) and obj.OnX(1) call through one.');
  WriteLn('pas starts a routine from a call: pas Name(a, b, c), pas f(a) of a routine value, pas obj.M(a),');
  WriteLn('  pas m(a) of a method value, pas procedure begin ... end. The arguments are worked out when pas');
  WriteLn('  runs, as in Go; a var parameter is refused.');
  WriteLn('  The name is not a string. Sleep(ms) parks the current routine. Gosched yields.');
  WriteLn('select');
  WriteLn('  Send(ch, value): statement;');
  WriteLn('  Recv(ch, dest): statement;');
  WriteLn('  else statement;');
  WriteLn('end;');
  WriteLn('  Without else the select parks with a waiter on every channel and exactly one arm fires,');
  WriteLn('  as in Go. With else it never parks. Send(c, v), x := Recv(c), Close(c), MakeChan(), MakeChan(n).');
  WriteLn('WriteLn and Write take integers, reals, strings, booleans (1 or 0), and characters.');
  WriteLn('  x:w pads any value to w columns; x:w:d prints a real with d decimals. A real prints exactly,');
  WriteLn('  rounded once at the sixth decimal (a tie to even): 1e20, +Inf, -Inf and NaN print as themselves.');
  WriteLn('  A Char prints as the character, its byte; Ord(c) prints the code. A Rune is an integer and prints as one.');
  WriteLn('  WriteLn(ErrOutput, ...) writes stderr.');
  WriteLn('ReadLn(s) reads a line into a string.');
  WriteLn('Inc(v) Inc(v, n) Dec(v) Dec(v, n). On a pointer they step elements of its view; on a real they add the step.');
  WriteLn('  A narrow integer wraps at its width: with b: Byte = 255, Inc(b) makes it 0.');
  WriteLn('Operators, the tightest first: unary + - not @; * / div mod shl shr sar rol ror; + -;');
  WriteLn('  = <> < <= > >= in is as; and nand andnot; or xor nor xnor. A comparison binds before and/or,');
  WriteLn('  as in C and Go: x and 4 = 4 mixes a Boolean with an integer and is refused; write (x and 4) = 4.');
  WriteLn('  and/or on booleans are short-circuit. xor is bitwise on integers and exclusive on booleans.');
  WriteLn('  nand, nor and xnor are not and, not or and not xor; a andnot b is a and not b; on both kinds.');
  WriteLn('  shl is a left shift. shr keeps the sign in Int8, Int16 and Int32 and is logical in every other type,');
  WriteLn('  Integer included. sar brings in copies of the top bit of the width; rol and ror turn within it.');
  WriteLn('  shl, shr and sar count modulo 64, rol and ror modulo the width, which is the indicated type''s:');
  WriteLn('  i := b rol 1 turns 64 bits, Byte(b rol 1) the byte. not of a constant takes the width: b and not 2.');
  WriteLn('  x op= e is x := x op e for every binary operator: i += 1, s += ''a'', m xor= k, x rol= 3.');
  WriteLn('  A Boolean in arithmetic is its Ord; only a Boolean goes into a Boolean; Boolean(x) is x <> 0.');
  WriteLn('  A string takes + (with a string or a Char) and the comparisons; an array, an object, a map, a');
  WriteLn('  channel or a routine no arithmetic or logic operator, a record only those it declares.');
  WriteLn('  Mixing signed and unsigned joins to the signed type that holds both: Byte and Int8 give Int16;');
  WriteLn('  an Int8 into a Word needs Word(x).');
  WriteLn('Bit words on any variable: IsBitSet(x, n) (the Integer 0 or 1), SetBit(x, n, v),');
  WriteLn('  ToggleBit(x, n), GetBits(x, pos, width), SetBits(x, pos, width, v), PopCount, LeadingZeros,');
  WriteLn('  TrailingZeros, ReverseBits, ByteSwap, RotateLeft, RotateRight, AtomicSetBit, AtomicClearBit.');
  WriteLn('  An integer in its width, a real or a pointer as its bits, a record, a string or a slice as its');
  WriteLn('  bytes (bit n is bit n mod 8 of byte n div 8). A constant bit out of the value is a compile');
  WriteLn('  error; a varying one stops: bit N out of range [0..M] at line L.');
  WriteLn('Carry: each routine has its own bit, 0 when it starts, kept across calls: Carry (a Boolean),');
  WriteLn('  Carry := b, CarryOn, CarryOff, CarryFlip. rol, ror, shl, shr and sar never touch it.');
  WriteLn('Rotations and shifts, in the width of x''s type, n 1 when left out, 0 or less changing nothing:');
  WriteLn('  RotateLeftToCarry(x, n), RotateRightToCarry: circular, the last bit copied to Carry;');
  WriteLn('  RotateLeftThroughCarry, RotateRightThroughCarry: a ring of the width + 1 bits, Carry the extra;');
  WriteLn('  ShiftLeft, ShiftRight, ShiftRightSigned: Carry untouched; ShiftLeftToCarry, ShiftRightToCarry,');
  WriteLn('  ShiftRightSignedToCarry: the last bit out to Carry; FunnelLeft(hi, lo, n), FunnelRight: hi:lo');
  WriteLn('  shifted, one half kept. A count past the width is exact; x := RotateLeftThroughCarry(x) works in');
  WriteLn('  place, and b := RotateLeftToCarry($81) turns a Byte''s 8 bits. A record, an array, a Quad, a vector,');
  WriteLn('  a string or a slice turns whole, as one number of all its bits (none that holds pointers).');
  WriteLn('  RotateLeft and RotateRight are rol and ror: a negative count turns the other way.');
  WriteLn('Closures: f := function(x: Integer): Integer begin Result := x + n end; keeps n by reference, and');
  WriteLn('  outlives the routine; @Nested and pas Nested too; a loop counter it keeps is each pass''s own.');
  WriteLn('  pas procedure begin ... end runs one; pas F(s, r, x) takes any arguments, worked out at once.');
  WriteLn('Slices: s := Append(s, a, b), Append(s, u) (a slice of s''s type), Cap(s), and [a, b] where a slice');
  WriteLn('  goes is a new slice. Growth is in place only from the block''s end, so no other slice sees it.');
  WriteLn('Views: x as T is the bytes of x seen as T, not converted, read and written: (d as UInt64) xor= m,');
  WriteLn('  (r as TPair).Hi := 7, (s as array[0..3] of Char)[0] := ''Z''. T(x) converts; obj as TClass is');
  WriteLn('  the checked cast. A view bigger than its variable is a compile error.');
  WriteLn('Blocks: and, or, xor, not, nand, nor, xnor, andnot of two records or static arrays of one size,');
  WriteLn('  an array of integers and one integer, or two strings of one length, byte by byte: r := a xor b,');
  WriteLn('  r xor= b, s := s xor t. A record, an array, a string or a slice goes only where its type goes.');
  WriteLn('Wide words: MulHi(a, b), MulHiS, Mul128(a, b, hi, lo), DivMod128(hi, lo, d, q, r), AddCarry(a, b,');
  WriteLn('  cin, cout), SubBorrow, AddOverflow(a, b, r), SubOverflow, MulOverflow, AddSat, SubSat: one or two');
  WriteLn('  instructions on both machines (mulq/umulh, adc/adcs, sbb/sbcs, seto, cmov/csel; divq).');
  WriteLn('Memory words: LoadFence, StoreFence, FullFence, Prefetch(p), PrefetchWrite(p), CacheLine, StoreNT,');
  WriteLn('  AtomicLoad, AtomicStore, AtomicExchange, AtomicAnd, AtomicOr, AtomicXor (any integer width),');
  WriteLn('  LoadBE16/32/64(p), LoadLE16/32/64(p), StoreBE16/32/64(p, v), StoreLE16/32/64(p, v).');
  WriteLn('Vectors: V128, V256; VAdd8..64, VSub, VAddSat/VSubSat U/S 8/16, VMul16/32, VAvgU8/16,');
  WriteLn('  VMin/VMax U/S 8/16/32, VCmpEq, VCmpGtS/U, VAnd, VOr, VXor, VAndNot, VNot, VSelect(m,a,b),');
  WriteLn('  VShl/VShrU/VShrS 16/32/64 by a count, VSplat8..64(x); lanes through v as array[..] of T;');
  WriteLn('  VShuffle8, VZipLo/Hi 8..64, VPackU16/S16/S32, VAdd/Sub/Mul/Div/Min/Max/Sqrt F32/F64,');
  WriteLn('  VCmpEq/Lt/Le F32/F64, VCvtS32F32, VSplatF32/F64; to an Integer: VMoveMask8, VSumU8/S32/64.');
  WriteLn('  -cpu base compiles the paths of the base processor; PASLANG_CPU=base makes CpuHas see it.');
  WriteLn('  A loop keeps its vector variables in registers when only vector words and copies use them.');
  WriteLn('asm amd64 (x: in rax; y: out rdx) <lines> end; asm arm64 (x: in x0; y: out x2) <lines> end;');
  WriteLn('  the target''s block runs; bindings in, out, inout; callee-saved registers kept.');
  WriteLn('The machine: CycleCount (rdtsc, cntvct_el0), CycleFreq (ticks a second), CpuHas(''avx2''),');
  WriteLn('  CpuFeatures; a feature the target never or always has is a constant.');
  WriteLn('Conditional compilation: {$ifdef NAME} {$ifndef} {$else} {$endif} {$define} {$undef}; paslang');
  WriteLn('  defines PASLANG, LINUX, UNIX, CPU64 and CPUX86_64/CPUAMD64 or CPUAARCH64, as FPC names them,');
  WriteLn('  and CPU_<FEATURE> for each feature -cpu has: CPU_AVX2, CPU_SSE42, CPU_CRC32, CPU_SHA2...');
  WriteLn('  operator + (and the other arithmetic and compare spellings) on a record is a function you declare.');
  WriteLn('Comments are // to end of line and { brace comments }.');
  WriteLn('A unit has interface, implementation, and optional initialization and finalization.');
  WriteLn('  uses names other units. The compiler loads their .pi and links their .o. It does not reparse them.');
  WriteLn('  Their interface constants, types, routines and variables are the user''s.');
  WriteLn('  A .pi names the interface checksum of every unit it was compiled against; when one of them has changed,');
  WriteLn('  or the .pi is of an older format (only PASLANGI13, 1.0.137 on, loads), the compiler stops and says');
  WriteLn('  which unit to compile again.');
  WriteLn('A package file lists contains units. Compile it with -install <dir>.');
  WriteLn('Routines: procedure and function, nested routines, var and out parameters, up to 32 parameters.');
  WriteLn('  A routine''s var, const and type sections and its nested routines come in any order.');
  WriteLn('  Result is the function result. exit leaves the routine.');
  WriteLn('  procedure Later(N: Integer); forward; declares Later so earlier code can call it.');
  WriteLn('  The later header must match the forward. The body is that later routine, not the forward line.');
  WriteLn('  A forward inside a nested routine is finished in that same routine. A method cannot be forward.');
  WriteLn('A const section takes every constant kind: N = 3, Ratio = -1.5, Name = ''paslang'', Nl = #10, Yes = True,');
  WriteLn('  and Alias = Name; in a program, in a unit interface (exported) and in a unit implementation.');
  WriteLn('  A constant is any expression of constants: Size = N * 4 + 1, Last = Chr(Ord(''A'') + 25), Half = 1 / 2.');
  WriteLn('  Array bounds, subranges and case labels take the same: array[0..N - 1] of Integer.');
  WriteLn('A typed constant is a variable with a start value: Limit: Integer = 10; A: array[0..2] of Integer = (1, 2, 3);');
  WriteLn('  P: TPoint = (X: 1; Y: 2). In a routine it is static: it keeps its value between calls.');
  WriteLn('A value parameter may end with = and a constant expression of its type; an integer one converts');
  WriteLn('  for a real parameter.');
  WriteLn('  procedure Greet(N: Integer; Extra: Integer = 10);');
  WriteLn('  Greet(3) passes 10 for Extra. Greet(3, 4) passes 4. Show; calls Show when every parameter has a default.');
  WriteLn('  Once a parameter has a default, every parameter after it needs one. var and out have no default.');
  WriteLn('  The default is written on the first declaration. The later body may omit it. A method has no default.');
  WriteLn('procedure Show(N: Integer); overload; and procedure Show(S: string); overload; are two routines.');
  WriteLn('  The call Show(3) picks the integer one. Show(''ab'') picks the string. The call ranks what fits: the same');
  WriteLn('  types first, then an integer that widens without losing a value (the nearer width, the same sign');
  WriteLn('  first; an Int8 never goes to a Word), then an integer for a real. A constant with no type is an');
  WriteLn('  Integer. A var parameter takes its own type alone. Two that fit equally well are an ambiguous call.');
  WriteLn('A method can be overloaded the same way: function Hit(N: Integer) and function Hit(S: string).');
  WriteLn('  b.Hit(3) and b.Hit(''ab'') pick different bodies. override still matches one signature.');
  WriteLn('Classes: class, class(Parent), class(Parent, Interface), constructor, destructor, virtual, override,');
  WriteLn('  inherited, property Name: Type read FieldOrMethod write FieldOrMethod, published properties,');
  WriteLn('  indexed properties. is and as test and cast classes.');
  WriteLn('  Sections public, published, protected, private, strict protected and strict private limit');
  WriteLn('  who uses a member, as in FPC: private in its unit, strict private in its class''s methods,');
  WriteLn('  protected also in descendants'' methods, strict protected there and in its class''s methods.');
  WriteLn('  procedure Draw; virtual; abstract; has no body. A descendant writes procedure Draw; override;');
  WriteLn('  TChild.Create is accepted after the override. TBase.Create is an error while Draw is abstract.');
  WriteLn('Generics: generic Name<T> = ... end; then specialize Name<Integer>.');
  WriteLn('New(P) allocates. x.Free calls x''s Destroy when x is not nil; the collector frees the memory.');
  WriteLn('asm amd64 (bindings) ... end beside asm arm64 (bindings) ... end: inline assembly per machine.');
end;

procedure HelpRuntime;
begin
  WriteLn('## runtime');
  WriteLn('What a running program does. A routine parks instead of blocking the thread.');
  WriteLn('Each pas routine is a G. Gs run on Ms. The current G is r14 on amd64 and x28 on arm64.');
  WriteLn('Every routine checks its stack on entry. A loop can be preempted at its back edge; a for whose body calls');
  WriteLn('  nothing and holds no other loop asks once every 1024 passes.');
  WriteLn('A routine readied by another runs on the thread that readied it, as soon as that thread parks; idle threads');
  WriteLn('  sleep on a futex, one waits in epoll_wait, and at most two spin briefly looking for work.');
  WriteLn('Plain integer locals and globals are updated in place (addq, shlq, or the arm load/op/store).');
  WriteLn('In a loop that calls nothing, integer and narrow locals, and a read-only slice''s pointer and length,');
  WriteLn('  live in registers; an index proved in range at the head of a run is not checked again inside it.');
  WriteLn('Memory is collected: a cycle when what was handed out reaches twice what the last left alive,');
  WriteLn('  PASLANG_GC=100 (the default), another number, or off. GcCollect runs one; HeapStat(k) reads the');
  WriteLn('  figures (0 cycles, 1 alive, 3 mapped, 5 in use, 14 workers that marked the last cycle). The Ms');
  WriteLn('  mark together, at most 16 of them, PASLANG_GCWORKERS=n (0 every M, 1 one). FreeMem does nothing.');
  WriteLn('  An Integer holding an address keeps nothing alive. PASLANG_GCSTRESS=n, PASLANG_GCPOISON=1 and');
  WriteLn('  PASLANG_GCVERIFY=1 test the runtime: a cycle every n-th refill, freed blocks filled with $de,');
  WriteLn('  stacks checked against their maps.');
  WriteLn('A fatal runtime error prints paslang: <reason> at line N on standard error and exits 1:');
  WriteLn('  out of memory: N MiB mapped, stack overflow, nil pointer dereference, invalid memory address 0x...,');
  WriteLn('  integer divide by zero, index I out of range [LO..HI] (every index of a static array, a slice,');
  WriteLn('  a View or a string is checked, always), send on closed channel, close of closed channel,');
  WriteLn('  real out of integer range, sqrt domain (and ln, log, power, arcsin, arccos, arcsec, arccsc, arccosh,');
  WriteLn('  arctanh, lnxp1 domain), pointer outside its object (under -checkptr), nil map (a write),');
  WriteLn('  concurrent map writes (and map read and map write, map iteration and map write), bit N out of range,');
  WriteLn('  128-bit division overflow, logic on N and M bytes, a funnel of ... (lengths that differ),');
  WriteLn('  integer overflow, all routines are asleep: deadlock (no line: every routine waits and nothing can');
  WriteLn('  wake one, 1.0.139; a pending Sleep, a wait on a descriptor or a system call keeps it running). The line is the statement');
  WriteLn('  in the program file; a fault inside a unit or the runtime prints no line. There is no core dump to read first.');
  WriteLn('A successful program returns from pas_main into rt_waitall, which exits 0 when only the main G remains,');
  WriteLn('  or joins the scheduler until the others end; the last M to sleep checks for a deadlock (1.0.139).');
  WriteLn('Halt(n) is for a non-zero status. Halt(0) also stops, but normal success is falling off the end.');
  WriteLn('Syscall(n, a, ...) is an expression, 1 to 7 arguments, and must be assigned: n := Syscall(...).');
  WriteLn('  A statement Syscall(...) makes the call and drops its result. Pass a fixed array as @A, not the array value.');
  WriteLn('WaitFd(fd) parks until the fd is readable. WaitIo(fd, events) and WaitMs(fd, events, ms) park on epoll.');
  WriteLn('  events: 1 is readable, 4 is writable. WaitMs returns when the timer fires first.');
  WriteLn('Amd64 is 1 on an amd64 compile and 0 on an arm64 compile. Use it to pick a syscall number.');
  WriteLn('  The numeric constants in Pascal source should be the amd64 numbers; choose the arm64 number when Amd64 = 0.');
  WriteLn('GId is the current G id (main is 1) when GId is not a variable. GCount is the live G count.');
  WriteLn('AtomicAdd(@v, d) adds d to the Integer v atomically and gives the new value; AtomicCas(@v, old, new) swaps');
  WriteLn('  when v = old and says whether it did; Pause is the spin hint. These are what the core sync unit is built on.');
  WriteLn('CanSpin says whether a lock waiter should spin (other Ps run, this one has nothing queued); Nanotime is');
  WriteLn('  the monotonic clock in ns; QWaitBack(@q), QWaitFront(@q) and QWakeFirst(@q) keep a first-come queue,');
  WriteLn('  QSplice(@dst, @src) moves all of src to the end of dst. A routine holding a SpinLock is not preempted.');
  WriteLn('SrcLine is the current source line. ParamCount and ParamStr(i) read the program arguments.');
  WriteLn('SizeOf(T) or SizeOf(expr). Ord(x) and Chr(n). Succ(x) and Pred(x) are the next and the previous');
  WriteLn('  ordinal. High and Low of a type, or of an array, a slice, a string (Low is 1) or an ordinal value');
  WriteLn('  (its type''s bounds): High(Byte) is 255, Low(Int8) is -128. Length of a string, an array, a slice');
  WriteLn('  or a map. Copy(s, i, n). Assigned(x) is x <> nil. FillChar(x, n, v) writes the byte v n times.');
  WriteLn('Abs, Sqr, Sqrt, Sin, Cos, ArcTan, ArcTan2, ArcSin, ArcCos, ArcCot, ArcSec, ArcCsc,');
  WriteLn('  Ln, LnXP1, Log10, Log2, LogN, Exp, Power, Hypot, Frac, Int, Trunc, Round,');
  WriteLn('  Tan, Cot, Sec, Csc, Sinh, Cosh, Tanh, ArcSinh, ArcCosh, ArcTanh, Ldexp, Poly,');
  WriteLn('  Floor, Ceil, Min, Max, Odd, IsNan, IsInfinite, Pi.');
  WriteLn('  Round uses round-to-nearest, ties to even. Abs and Sqr also accept integers.');
  WriteLn('  Sqrt, Sin, Cos, ArcTan, ArcSin, ArcCos, Ln, Log10, Log2, Exp, Frac, and Int take one number and return a real.');
  WriteLn('  Tan, Cot, Sec, Csc, ArcCot, ArcSec, ArcCsc, Sinh, Cosh, Tanh, ArcSinh, ArcCosh,');
  WriteLn('  ArcTanh, and LnXP1 take one number and return a real. They are the Math family.');
  WriteLn('  Power(base, exponent) and Hypot(x, y) return a real. An exponent of 0 returns 1.');
  WriteLn('  ArcTan2(y, x) covers the four quadrants. ArcTan2(0, 0) is 0.');
  WriteLn('  ArcCot(x) is Pi/2 - ArcTan(x). ArcSec and ArcCsc stop outside -1..1 and 1..infinity.');
  WriteLn('  LogN(base, x) stops when base or x is non-positive and when base is 1.');
  WriteLn('  LnXP1(x) computes Ln(1+x) and stops when 1+x is non-positive.');
  WriteLn('  Ldexp(x, p) returns x times 2 to the p. The exponent is an Integer.');
  WriteLn('  Poly(x, a) evaluates a[0] + a[1]*x + ... by Horner over an array of Real.');
  WriteLn('  Floor and Ceil round toward minus and plus infinity and return an Integer.');
  WriteLn('  Min and Max take two integers or two reals. Odd(n) tests the low bit.');
  WriteLn('  IsNan and IsInfinite test the bits of a real. Pi is the constant; Pi() also works.');
  WriteLn('  Sqrt below 0 stops the program; Sqrt(-0) is -0 and Sqrt of a NaN a NaN. Ln, Log10, and Log2 of a');
  WriteLn('  non-positive value stop the program. Each of these stops names its line.');
  WriteLn('  ArcSin and ArcCos stop when the value is outside -1..1.');
  WriteLn('  ArcCosh stops below 1 and ArcTanh stops outside -1..1. Tanh saturates at +-1.');
  WriteLn('  Power stops when the base is negative and the exponent is not an integer.');
  WriteLn('  Sin, Cos, ArcTan, ArcSin, and ArcCos use radians. Int truncates toward zero. Frac keeps the sign.');
  WriteLn('  Their names are reserved: no variable takes one. The call needs parentheses.');
  WriteLn('XxHash32(s), XxHash64(s) and XxHash3(s) hash the bytes of a string with xxHash; XxHash3 is');
  WriteLn('  XXH3 (64 bits), the fastest: a read or two for short strings, vector registers for long ones.');
  WriteLn('  An optional second Integer argument is the seed. XxHash64 returns the 64 bits in');
  WriteLn('  an Integer, so a hash with the top bit set prints negative. The five prime');
  WriteLn('  constants of each width live in .rodata. A map hashes its keys with XXH3: string keys');
  WriteLn('  with XxHash3, eight-byte keys with its 8-byte path inline; seeds come from getrandom.');
  WriteLn('Default(T) is the zero value of any type T.');
  WriteLn('GetMem(p, n) allocates n bytes the collector scans word by word; GetMem(p, n, 0) allocates n bytes');
  WriteLn('  that hold no pointer; GetMem(n) and GetMem(n, 0) are the same as functions (a ^Integer).');
  WriteLn('  SetLength(a, n) resizes a dynamic array.');
  WriteLn('Move(src, dst, n) copies n bytes between two variables. To copy through pointers write Move(p^, q^, n).');
  WriteLn('DumpLocals prints the integer variables the routine sees, name=value, on both machines.');
  WriteLn('Breakpoint parks the current G for the debugger and records it and its return PC; BreakCount and');
  WriteLn('  BreakPC read how many and the last PC; ContinueBreak makes the parked G run again.');
  WriteLn('HeapCheck counts inconsistent heap spans (0 is sound). HeapMaskOf(p) is the pointer bitmap of the');
  WriteLn('  block holding p (its first 64 words), -1 off the heap.');
  WriteLn('RTTI of published properties, by name, case ignored: PropKind(o, name) is 0 none, 1 integer,');
  WriteLn('  2 string, 3 method; GetPropInt, SetPropInt(o, name, v), GetPropStr, SetPropStr, SetPropMeth(o,');
  WriteLn('  name, m), CallProp(o, name). A property outside a private or protected section is published when its');
  WriteLn('  accessor is a field.');
end;

procedure HelpLib;
begin
  WriteLn('## lib');
  WriteLn('The core is part of the language. Packages park the current routine; none is a second runtime.');
  WriteLn('Core units, seen by every program without a uses clause:');
  WriteLn('  pasobject: TObject, the root of every class (P121): Create, Destroy, AfterConstruction,');
  WriteLn('    BeforeDestruction, Equals, GetHashCode, ToString; the class words ClassName, ClassNameIs,');
  WriteLn('    InstanceSize read the name and the size its method table carries. PasUncaught writes the');
  WriteLn('    line of an exception object nobody handled in the main routine.');
  WriteLn('  pasroutines: mutex, rwmutex, waitgroup, cond, once, lock ... do, once ... do,');
  WriteLn('    Goid, NumGoroutine, Yield. Pascal over the park primitives of the scheduler.');
  WriteLn('  pasmap: the hash map behind map[K] of V. A Swiss table in Pascal: a directory of tables of at');
  WriteLn('    most 1024 slots that split, keys hashed with XXH3.');
  WriteLn('  pashash: Md5, Sha1, Sha224, Sha256, Sha384, Sha512, Sha3_*, the HMAC words, Crc32, Crc32c, Adler32,');
  WriteLn('    Fnv1a32, Fnv1a64, Murmur3, SipHash, Hex and the Merkle words; each with a Pascal body and, for');
  WriteLn('    SHA-1, SHA-256, SHA-512 and the CRCs, a body on the processor (-cpu chooses, docs/KERNELS.md).');
  WriteLn('  pastree: the B+ tree behind tree[K] of V, the heap behind heap of T and the store.');
  WriteLn('    PasTreeRank and its kin are visible, as the sync routines are.');
  WriteLn('  pasfmt: reals as exact text, read and written (PasFmtReal, PasFmtInt, PasFmtStr, PasParseReal,');
  WriteLn('    PasParseSingle, PasF64ToF32, PasF32ToF64, PasParseQuad, PasFmtQuad, PasQuadDigits are visible too).');
  WriteLn('  pasheap: the heap and the collector.');
  WriteLn('  pasquad: IEEE binary128 in software, the same bits on both machines (docs/QUAD.md).');
  WriteLn('  make builds them into build/; make install puts them in lib/paslang beside the compiler,');
  WriteLn('  and lib/paslang/aarch64 for the arm64 target. PASLANG_LIB names another directory.');
  WriteLn('Spawn with pas. Print with WriteLn. Delay with Sleep. Do not rename those.');
  WriteLn('uses pastime for the clock: NowUnix NowNanos read the wall clock, Monotonic and Since measure');
  WriteLn('  (that one never goes back), UnixToDate and DateToUnix turn a moment into a UTC date and back,');
  WriteLn('  DateStr TimeStr StampStr write it, Duration says a length of time the way a person would.');
  WriteLn('uses pasrand for random numbers: RandInit gives you a TRand of your own, RandNext RandBelow');
  WriteLn('  RandRange RandReal RandBool draw from it; RandSeed Randomize RandInt RandN RandFloat use the');
  WriteLn('  global one, which is behind a mutex. xoshiro256**, seeded through splitmix64. Not for secrets.');
  WriteLn('uses passort for order: SortInts SortReals SortStrings sort in place, SortIntsBy SortRealsBy');
  WriteLn('  SortStringsBy take the order as a routine value, IntsSorted and its kin say');
  WriteLn('  whether an array is in order, FindInt FindStr look a value up and PlaceInt PlaceStr say where');
  WriteLn('  one would go.');
  WriteLn('uses sysutils for Free Pascal''s SysUtils: Exception and its classes, UpperCase CompareText Trim');
  WriteLn('  StringReplace QuotedStr WrapText, IntToStr StrToInt IntToHex BoolToStr StrToFloat and their Def and');
  WriteLn('  Try forms, Format FmtStr FloatToStr FloatToStrF FormatFloat FloatToDecimal (Go''s digits, rounded');
  WriteLn('  once), TFormatSettings, FormatSettings; Free Pascal''s names on paslang''s words (manual, 17).');
  WriteLn('uses paslib for files and processes: ReadFile WriteFile for the whole of one, FileOpen FileCreate');
  WriteLn('  FileAppend FileEdit FileRead FileWrite FileSeek FileTell FileEnd FileClose for a piece at a time.');
  WriteLn('uses pasnet for sockets. The unit is Pascal over Syscall and WaitIo, not a second runtime.');
  WriteLn('  TcpListen(port) TcpPort(fd) TcpAccept(fd) TcpConnect(host, port)');
  WriteLn('  TcpRead(fd, max) TcpWrite(fd, data) TcpClose(fd)');
  WriteLn('  UdpBind UdpPort UdpSend UdpRecv UdpClose');
  WriteLn('  TcpListen6 TcpConnect6 (to ::1) TcpAccept6 TcpReadDeadline(fd, max, ms)');
  WriteLn('  Servers (P114): TcpListenAt(host, port, backlog) TcpConnectTo(host, port) for a dotted quad, an');
  WriteLn('  IPv6 literal or a name; TcpPeer(fd) TcpLocal(fd) as host:port; TcpShutdown(fd, how) TcpKeepAlive');
  WriteLn('  SockBuffers(fd, recv, send); TcpReadLine(fd, buf, line) TcpReadN(fd, n, buf, data) over a buffer');
  WriteLn('  the caller keeps; UdpBindAt(host, port) UdpSendTo(fd, host, port, data) UdpRecvFrom(fd, max, host,');
  WriteLn('  port) UdpRecvFromMs(fd, max, ms, host, port) with the sender; RaiseFdLimit for tens of thousands');
  WriteLn('  of connections; HostToV4 HostToV6 V4ToStr V6ToStr IsV6Text Resolve(name) (/etc/hosts, then the');
  WriteLn('  nameserver of /etc/resolv.conf over UDP); DnsQueryA DnsAnswerA DnsQuestionName DnsReplyA DnsReplyNx');
  WriteLn('  for a resolver or a server. examples/httpd, dnsd, termd, ftpd, ntpd, wsd, chat and proxy are');
  WriteLn('  servers on these (HTTP, DNS, a terminal, FTP, NTP, WebSocket, a chat, a reverse proxy), each with');
  WriteLn('  its self-test and, where the protocol has one, its client in the same program.');
  WriteLn('  Unix-domain sockets (P117): UnixListen(path) UnixConnect(path) UnixAccept(fd), a path or @name for');
  WriteLn('  an abstract one, then NetRead/NetWrite/TcpReadLine as for TCP; UnixBind UnixSendTo UnixRecvFrom for');
  WriteLn('  datagrams with the sender; UnixPair(a, b); UnixPeer(fd, pid, uid, group); UnixSendFd/UnixRecvFd pass');
  WriteLn('  a descriptor with a message; UnixClose UnixUnlink; WaitAny(fds, ev, ms) parks on several at once.');
  WriteLn('uses pasdebug is written by paslangc -debug (P118): PasDebugStart and PasDebugLine are the hooks the');
  WriteLn('  compiler calls; the unit serves the debugger on the socket PASLANG_DEBUG or --debug-listen names,');
  WriteLn('  and PasDebugConsole(socket, owned) is the console (P120) that --debug-mode, --debug-attach and');
  WriteLn('  pasdbg run. Not for a program.');
  WriteLn('  Port 0 asks the kernel for a port. TcpReadDeadline returns an empty string on timeout.');
  WriteLn('  Accept is edge-triggered and can have two waiters. Do not name a procedure Send; send is a keyword.');
  WriteLn('  A socket address parameter is a fixed array, for example var Sa: array[0..15] of Char.');
  WriteLn('uses pasx11 for a window: raw X11 over the display socket, no Xlib. A TX11 object with Connect,');
  WriteLn('  CreateWin CreateGc MapWin SetTitle, FillRect DrawLine DrawText (LoadFont), NextEvent Queued CanRead');
  WriteLn('  (the drawing routine parks on the socket with WaitFd), IsCloseEvent, Keysym, SendClick SendKey and');
  WriteLn('  PixelAt for a test. make check opens its windows on an Xvfb display, never on the desktop.');
  WriteLn('Low-level compiler builtins: NetListen(port) and NetAccept(fd) give an fd, NetPort(fd) the bound port,');
  WriteLn('  NetConnect(ip4, port) an fd (the IPv4 address as an Integer), NetRead(fd, max, s) reads up to max');
  WriteLn('  bytes into the string s, NetWrite(fd, s) the count written, NetClose(fd).');
  WriteLn('Prefer the pasnet names in new programs.');
end;

procedure HelpLimits;
begin
  WriteLn('## limits');
  WriteLn('Refused, or different from another Pascal. Do not write these and expect them to work.');
  WriteLn('No Text, no file, no file of. No C ffi and no libc in the generated program.');
  WriteLn('cdecl and nostackframe are skipped; a routine declared inline goes in place whatever its size');
  WriteLn('  (-inline). overload is accepted on routines and methods.');
  WriteLn('var a: array of T is a slice by reference; a static array does not go into any array of T parameter.');
  WriteLn('No default value on a method, on var or out, or on a record.');
  WriteLn('No Random. The calculation set is the FPC Math family: trigonometric, inverse, hyperbolic,');
  WriteLn('  logarithm, exponential, Power, Hypot, Ldexp, Poly, Floor, Ceil, Min, Max, IsNan, IsInfinite, Pi.');
  WriteLn('An assembler routine body is discarded; asm amd64 (...) ... end beside asm arm64 is assembled.');
  WriteLn('/ is never integer division. Write div for a quotient.');
  WriteLn('At most 32 parameters. pas refuses a var parameter. A select has at most 16 arms.');
  WriteLn('A bare Syscall(n, ...) statement makes the call and drops the result (1.0.136).');
  WriteLn('A constant is any expression of constants.');
  WriteLn('GNU/Linux only, kernel 6.13 or newer, amd64 and arm64. No Windows and no macOS target.');
  WriteLn('The compiler that compiles these sources must already accept the syntax you write.');
  WriteLn('  A new language form is unavailable inside the compiler until that compiler has been rebuilt.');
  WriteLn('A map key is an ordinal, a string, a pointer, or a class. A record, a real, a slice,');
  WriteLn('  a map, or a method value is refused as a key. A map is not safe for two routines');
  WriteLn('  writing at once; the runtime stops the program when it sees that.');
  WriteLn('Reserved: every keyword, the operator words (nand nor xnor andnot sar rol ror), the declaration words');
  WriteLn('  and every predefined name (Length, Sin, Min, Clear, Pi, PByte, Goid, the bit, wide, memory, CPU and');
  WriteLn('  V words, ...): none can be a name (docs/MANUAL.md section 19 lists them). safe before program,');
  WriteLn('  unit, procedure, function, constructor or destructor forbids raw pointer work in that code.');
  WriteLn('packed is reserved and refused: a record lies at its fields'' natural alignment.');
  WriteLn('private, strict private, protected and strict protected are held to; x.Free calls Destroy.');
  WriteLn('A local cannot take a name the routine already uses: a parameter, another local, self,');
  WriteLn('  the function itself, or a field or a method of its class. It is duplicate identifier.');
end;

procedure HelpExamples;
begin
  WriteLn('## examples');
  WriteLn('Commands that compile and run. Copy one, then change the path.');
  WriteLn('Compile and run:');
  WriteLn('  paslangc -o hello testdata/hello.paslang');
  WriteLn('  ./hello');
  WriteLn('Unit then program:');
  WriteLn('  paslangc -c src/lib/pasnet.paslang');
  WriteLn('  paslangc -Fu build -o prog prog.paslang');
  WriteLn('A server and its self-test (httpd, dnsd, termd, ftpd, ntpd, wsd, chat, proxy):');
  WriteLn('  paslangc -Fu build -o httpd examples/httpd.paslang');
  WriteLn('  ./httpd -selftest 2000');
  WriteLn('Arm64 object from an amd64 compiler, then run under qemu:');
  WriteLn('  paslangc -target arm64 -o prog-arm prog.paslang');
  WriteLn('Integer loop that the compiler keeps in registers when the body is only the add:');
  WriteLn('  s := 0;');
  WriteLn('  for i := 1 to n do');
  WriteLn('    s := s + i;');
  WriteLn('Real:');
  WriteLn('  r := 1.5 + 2.5;');
  WriteLn('  WriteLn(r);');
  WriteLn('  r := 10 / 4;');
  WriteLn('  WriteLn(10 div 4);');
  WriteLn('A map:');
  WriteLn('  var age: map[string] of Integer;');
  WriteLn('  New(age);');
  WriteLn('  age[''ana''] := 41;');
  WriteLn('  if ''ana'' in age then WriteLn(age[''ana'']);');
  WriteLn('  for name, years in age do WriteLn(name, '' '', years);');
  WriteLn('Routines sharing a counter:');
  WriteLn('  var mu: mutex; wg: waitgroup; n: Integer;');
  WriteLn('  procedure Work(K: Integer); begin lock mu do n := n + K; wg.Done; end;');
  WriteLn('  wg.Add(2); pas Work(1); pas Work(2); wg.Wait; WriteLn(n);');
  WriteLn('Tokens, for a tool that wants the lexer:');
  WriteLn('  paslangc --lex file.paslang');
  WriteLn('Golden programs live in testdata/. make check compares them with testdata/*.out.');
end;

procedure PrintHelp(const Topic: string);
var
  all: Boolean;
begin
  if (Topic = '') or Eq(Topic, 'all') then
  begin
    HelpIndex;
    WriteLn('');
    HelpFlags;
    WriteLn('');
    HelpTypes;
    WriteLn('');
    HelpLang;
    WriteLn('');
    HelpRuntime;
    WriteLn('');
    HelpLib;
    WriteLn('');
    HelpLimits;
    WriteLn('');
    HelpExamples;
    Exit;
  end;
  if Eq(Topic, 'short') or Eq(Topic, 'index') then
  begin
    HelpIndex;
    Exit;
  end;
  all := False;
  if Eq(Topic, 'flags') then
    HelpFlags
  else if Eq(Topic, 'types') then
    HelpTypes
  else if Eq(Topic, 'lang') then
    HelpLang
  else if Eq(Topic, 'runtime') then
    HelpRuntime
  else if Eq(Topic, 'lib') then
    HelpLib
  else if Eq(Topic, 'limits') then
    HelpLimits
  else if Eq(Topic, 'examples') then
    HelpExamples
  else
  begin
    WriteLn('unknown help topic: ' + Topic);
    HelpIndex;
    all := True;
  end;
  if all then
    Exit;
end;

end.
