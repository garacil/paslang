# paslang is distributed in the hope that it will be useful, but
# WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
# General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with paslang.  If not, see <https://www.gnu.org/licenses/>.

# Configure paslang. The interface follows the GNU coding standards
# (configuration and installation directory variables). This script is
# the configure program; it does not need Autoconf to run.

set -e

package=paslang
version=snapshot

usage() {
  cat <<EOF
Usage: ./configure [OPTION]... [VAR=VALUE]...

Defaults for the options are specified in brackets.

Configuration:
  -h, --help              display this help and exit
      --version           display version information and exit
      --srcdir=DIR        find the sources in DIR [. or ..]

Installation directories:
  --prefix=PREFIX         install architecture-independent files in PREFIX
                          [/usr/local]
  --exec-prefix=EPREFIX   install architecture-dependent files in EPREFIX
                          [PREFIX]
  --bindir=DIR            user executables [EPREFIX/bin]
  --sbindir=DIR           system admin executables [EPREFIX/sbin]
  --libexecdir=DIR        program executables [EPREFIX/libexec]
  --sysconfdir=DIR        read-only single-machine data [PREFIX/etc]
  --sharedstatedir=DIR    modifiable architecture-independent data [PREFIX/com]
  --localstatedir=DIR     modifiable single-machine data [PREFIX/var]
  --runstatedir=DIR       modifiable per-process data [LOCALSTATEDIR/run]
  --libdir=DIR            object code libraries [EPREFIX/lib]
  --includedir=DIR        C header files [PREFIX/include]
  --oldincludedir=DIR     C header files for non-GCC [/usr/include]
  --datarootdir=DIR       read-only arch-independent data root [PREFIX/share]
  --datadir=DIR           read-only architecture-independent data [DATAROOTDIR]
  --infodir=DIR           info documentation [DATAROOTDIR/info]
  --localedir=DIR         locale-dependent data [DATAROOTDIR/locale]
  --mandir=DIR            man documentation [DATAROOTDIR/man]
  --docdir=DIR            documentation root [DATAROOTDIR/doc/paslang]
  --htmldir=DIR           html documentation [DOCDIR]
  --pdfdir=DIR            pdf documentation [DOCDIR]
  --psdir=DIR             ps documentation [DOCDIR]

System types:
  --build=BUILD           configure for building on BUILD [guessed]
  --host=HOST             cross-compile to build programs to run on HOST [BUILD]
  --target=TARGET         configure for building compilers for TARGET [HOST]

Optional features:
  --enable-arm64          also build and install the arm64 units, which
                          needs the arm64 binutils on amd64; make check
                          needs it [no: the units of this machine alone]

Other optional features and packages are accepted and ignored, so one set
of options can configure a whole source tree. Unknown options are an error.
EOF
}

prefix=/usr/local
exec_prefix='${prefix}'
bindir='${exec_prefix}/bin'
sbindir='${exec_prefix}/sbin'
libexecdir='${exec_prefix}/libexec'
sysconfdir='${prefix}/etc'
sharedstatedir='${prefix}/com'
localstatedir='${prefix}/var'
runstatedir='${localstatedir}/run'
libdir='${exec_prefix}/lib'
includedir='${prefix}/include'
oldincludedir=/usr/include
datarootdir='${prefix}/share'
datadir='${datarootdir}'
infodir='${datarootdir}/info'
localedir='${datarootdir}/locale'
mandir='${datarootdir}/man'
docdir='${datarootdir}/doc/paslang'
htmldir='${docdir}'
pdfdir='${docdir}'
psdir='${docdir}'
srcdir=
build=
host=
target=
saved=
arm64=

log() {
  printf '%s\n' "$*" >> config.log
}

die() {
  printf 'configure: %s\n' "$*" >&2
  log "error: $*"
  exit 1
}

# Relative path of this script's directory, used when --srcdir is omitted.
here=$(dirname "$0")
case $here in
  /*) ;;
  *) here=$(pwd)/$here ;;
esac

for arg in "$@"; do
  case $arg in
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      printf '%s %s\n' "$package" "$version"
      exit 0
      ;;
    --srcdir=*)
      srcdir=${arg#--srcdir=}
      ;;
    --prefix=*)
      prefix=${arg#--prefix=}
      ;;
    --exec-prefix=*)
      exec_prefix=${arg#--exec-prefix=}
      ;;
    --bindir=*)
      bindir=${arg#--bindir=}
      ;;
    --sbindir=*)
      sbindir=${arg#--sbindir=}
      ;;
    --libexecdir=*)
      libexecdir=${arg#--libexecdir=}
      ;;
    --sysconfdir=*)
      sysconfdir=${arg#--sysconfdir=}
      ;;
    --sharedstatedir=*)
      sharedstatedir=${arg#--sharedstatedir=}
      ;;
    --localstatedir=*)
      localstatedir=${arg#--localstatedir=}
      ;;
    --runstatedir=*)
      runstatedir=${arg#--runstatedir=}
      ;;
    --libdir=*)
      libdir=${arg#--libdir=}
      ;;
    --includedir=*)
      includedir=${arg#--includedir=}
      ;;
    --oldincludedir=*)
      oldincludedir=${arg#--oldincludedir=}
      ;;
    --datarootdir=*)
      datarootdir=${arg#--datarootdir=}
      ;;
    --datadir=*)
      datadir=${arg#--datadir=}
      ;;
    --infodir=*)
      infodir=${arg#--infodir=}
      ;;
    --localedir=*)
      localedir=${arg#--localedir=}
      ;;
    --mandir=*)
      mandir=${arg#--mandir=}
      ;;
    --docdir=*)
      docdir=${arg#--docdir=}
      ;;
    --htmldir=*)
      htmldir=${arg#--htmldir=}
      ;;
    --pdfdir=*)
      pdfdir=${arg#--pdfdir=}
      ;;
    --psdir=*)
      psdir=${arg#--psdir=}
      ;;
    --build=*)
      build=${arg#--build=}
      ;;
    --host=*)
      host=${arg#--host=}
      ;;
    --target=*)
      target=${arg#--target=}
      ;;
    --enable-arm64|--enable-arm64=yes)
      arm64=yes
      ;;
    --disable-arm64|--enable-arm64=no)
      arm64=
      ;;
    --enable-*|--disable-*|--with-*|--without-*)
      ;;
    --*)
      die "unrecognized option: $arg"
      ;;
    *=*)
      ;;
    *-*-*)
      build=$arg
      ;;
    *)
      die "unrecognized argument: $arg"
      ;;
  esac
done

: > config.log
log "command: $0 $*"
log "date: $(date)"

if [ -z "$srcdir" ]; then
  if [ -f ./cmd/paslangc/paslangc.paslang ]; then
    srcdir=.
  elif [ -f ../cmd/paslangc/paslangc.paslang ]; then
    srcdir=..
  else
    die "cannot find sources in . or .. (pass --srcdir=DIR)"
  fi
fi
if [ ! -f "$srcdir/cmd/paslangc/paslangc.paslang" ]; then
  die "no paslang sources in $srcdir"
fi
log "srcdir: $srcdir"

guess=$(uname -m)-$(uname -s | tr '[:upper:]' '[:lower:]')
case $(uname -m) in
  x86_64|amd64) guess_cpu=x86_64 ;;
  aarch64|arm64) guess_cpu=aarch64 ;;
  *) guess_cpu=$(uname -m) ;;
esac
case $(uname -s) in
  Linux) guess_os=linux-gnu ;;
  *) guess_os=$(uname -s | tr '[:upper:]' '[:lower:]') ;;
esac
if [ -z "$build" ]; then
  build=${guess_cpu}-unknown-${guess_os}
fi
if [ -z "$host" ]; then
  host=$build
fi
if [ -z "$target" ]; then
  target=$host
fi
log "build: $build"
log "host: $host"
log "target: $target"

case $host in
  x86_64-*-linux-*|amd64-*-linux-*|aarch64-*-linux-*|arm64-*-linux-*)
    ;;
  *)
    die "paslang builds only on linux/amd64 and linux/arm64 (host $host)"
    ;;
esac
case $build in
  ${host}) ;;
  *)
    die "the bootstrap compiler is built for the machine running configure (build $build, host $host). paslangc-arm64 is produced beside it."
    ;;
esac

# User assignments (VAR=value) override, whether passed as arguments or
# already present in the environment.
for arg in "$@"; do
  case $arg in
    [A-Za-z_]*=*)
      eval "$arg"
      log "assign: $arg"
      ;;
  esac
done

# What building and installing need, and nothing more: Go, a C compiler,
# gdb and qemu serve make check alone.
#
# paslangc builds itself. With one in BINDIR, or one already in bin/, make
# needs no other compiler (the Makefile's rule for bin/paslangc); only the
# very first build, with neither, starts from Free Pascal, whose copy of
# the sources a Python script prepares (make hostsrc).
expand() {
  v=$1
  n=0
  while [ $n -lt 10 ]; do
    case $v in
      *'$'*) eval "v=\"$v\"" ;;
      *) break ;;
    esac
    n=$((n + 1))
  done
  printf '%s' "$v"
}

# The machine the build runs on: make builds and installs its units
# (the Makefile's MACHINE).
case $host in
  aarch64-*|arm64-*) machine=arm64 ;;
  *) machine=amd64 ;;
esac
printf 'checking the machine to build for... %s\n' "$machine"
log "machine: $machine"

boot=
if [ -x "$(expand "$bindir")/paslangc" ]; then
  boot=$(expand "$bindir")/paslangc
elif [ -x ./bin/paslangc ]; then
  boot=./bin/paslangc
fi
printf 'checking for paslangc... '
if [ -n "$boot" ]; then
  printf '%s\n' "$boot"
  log "boot compiler: $boot"
elif [ "$machine" != amd64 ]; then
  printf 'no\n'
  die "the first build on arm64 needs a paslangc (the arm64 package) in $(expand "$bindir") or bin/: the bootstrap from Free Pascal is written for amd64 (scripts/host_syscall.py)"
else
  printf 'no: the first build starts from Free Pascal\n'
  log "boot compiler: none"
  printf 'checking for fpc... '
  if command -v fpc >/dev/null 2>&1; then
    fpc_path=$(command -v fpc)
    printf '%s\n' "$fpc_path"
    log "fpc: $fpc_path"
  else
    printf 'no\n'
    die "fpc is required to bootstrap paslangc"
  fi
  printf 'checking for python3... '
  if command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "$(command -v python3)"
    log "python3: $(command -v python3)"
  else
    printf 'no\n'
    die "python3 is required for the host syscall bootstrap"
  fi
fi

# paslangc runs GNU binutils by these paths, not through PATH (Assemble
# and the link in cmd/paslangc/paslangc.paslang).
for tool in /usr/bin/as /usr/bin/ld; do
  printf 'checking for %s... ' "$tool"
  if [ -x "$tool" ]; then
    printf 'yes\n'
    log "$tool: present"
  else
    printf 'no\n'
    die "$tool is required (GNU binutils)"
  fi
done

# The arm64 units: on arm64 they are this machine's; on amd64 they are
# built only when asked for (--enable-arm64, the Makefile's ARM64), and
# then need the arm64 binutils, by the paths paslangc runs them.
printf 'checking whether to build the arm64 units... '
if [ "$machine" = arm64 ]; then
  arm64=yes
  printf 'yes: this machine\n'
  log "arm64 units: this machine"
elif [ -n "$arm64" ]; then
  printf 'yes\n'
  log "arm64 units: yes"
  for tool in /usr/bin/aarch64-linux-gnu-as /usr/bin/aarch64-linux-gnu-ld; do
    printf 'checking for %s... ' "$tool"
    if [ -x "$tool" ]; then
      printf 'yes\n'
      log "$tool: present"
    else
      printf 'no\n'
      die "$tool is required by --enable-arm64 (binutils-aarch64-linux-gnu on Debian, aarch64-linux-gnu-binutils on Arch)"
    fi
  done
else
  printf 'no (--enable-arm64 builds them)\n'
  log "arm64 units: no"
fi

{
  printf '%s\n' '# Generated by configure. Do not edit.'
  printf 'prefix = %s\n' "$prefix"
  printf 'exec_prefix = %s\n' "$exec_prefix"
  printf 'bindir = %s\n' "$bindir"
  printf 'sbindir = %s\n' "$sbindir"
  printf 'libexecdir = %s\n' "$libexecdir"
  printf 'sysconfdir = %s\n' "$sysconfdir"
  printf 'sharedstatedir = %s\n' "$sharedstatedir"
  printf 'localstatedir = %s\n' "$localstatedir"
  printf 'runstatedir = %s\n' "$runstatedir"
  printf 'libdir = %s\n' "$libdir"
  printf 'includedir = %s\n' "$includedir"
  printf 'oldincludedir = %s\n' "$oldincludedir"
  printf 'datarootdir = %s\n' "$datarootdir"
  printf 'datadir = %s\n' "$datadir"
  printf 'infodir = %s\n' "$infodir"
  printf 'localedir = %s\n' "$localedir"
  printf 'mandir = %s\n' "$mandir"
  printf 'docdir = %s\n' "$docdir"
  printf 'htmldir = %s\n' "$htmldir"
  printf 'pdfdir = %s\n' "$pdfdir"
  printf 'psdir = %s\n' "$psdir"
  printf 'srcdir = %s\n' "$srcdir"
  printf 'build_triplet = %s\n' "$build"
  printf 'host_triplet = %s\n' "$host"
  printf 'target_triplet = %s\n' "$target"
  printf 'MACHINE = %s\n' "$machine"
  printf 'ARM64 = %s\n' "$arm64"
} > config.mk

{
  printf '%s\n' '#!/bin/sh'
  printf '%s\n' '# Generated by configure. Do not edit.'
  printf 'cd %s\n' "'$(pwd)'"
  printf 'exec ./configure'
  for arg in "$@"; do
    printf ' %s' "'$arg'"
  done
  printf '\n'
} > config.status
chmod +x config.status

printf 'configure: creating config.mk\n'
printf 'paslang configured for %s, prefix %s\n' "$host" "$prefix"
