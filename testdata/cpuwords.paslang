program cpuwords;

{ The machine's words of P106 (1.0.124): CycleCount goes forward, as a
  value and as a statement, and is read again at every use, in a loop
  too; CycleFreq is a sane rate, the same at every call, and measures a
  Sleep; CpuHas agrees with what the kernel says, the flags of
  /proc/cpuinfo on amd64 and AT_HWCAP and AT_HWCAP2 in /proc/self/auxv
  on arm64 (read with LoadLE64), and a feature the target never has, or
  always has, is a constant. The output is the same on both machines. }

uses paslib;

var
  text, flags, aux: string;
  bad, i, c0, c1, c2, f, back, hw, hw2, key: Integer;
  secs: Double;

function HasWord(const W: string): Boolean;
var
  i, j: Integer;
begin
  Result := False;
  i := 1;
  while i <= Length(flags) do
  begin
    while (i <= Length(flags)) and (flags[i] = ' ') do
      Inc(i);
    j := i;
    while (j <= Length(flags)) and (flags[j] <> ' ') do
      Inc(j);
    if Copy(flags, i, j - i) = W then
      Result := True;
    i := j;
  end;
end;

procedure FindFlags;
var
  i, j, k: Integer;
  line: string;
begin
  flags := '';
  i := 1;
  while i <= Length(text) do
  begin
    j := i;
    while (j <= Length(text)) and (text[j] <> #10) do
      Inc(j);
    line := Copy(text, i, j - i);
    if (flags = '') and (Copy(line, 1, 5) = 'flags') then
    begin
      k := 1;
      while (k <= Length(line)) and (line[k] <> ':') do
        Inc(k);
      flags := Copy(line, k + 1, Length(line) - k);
    end;
    i := j + 1;
  end;
end;

procedure Agree(const Name: string; Has, Want: Boolean);
begin
  if Has <> Want then
  begin
    WriteLn('CpuHas(''', Name, ''') is ', Has, ' but the kernel says ', Want);
    Inc(bad);
  end;
end;

begin
  bad := 0;
  c0 := CycleCount;
  CycleCount;
  c1 := CycleCount();
  back := 0;
  for i := 1 to 1000 do
  begin
    c2 := CycleCount;
    if c2 < c1 then
      Inc(back);
    c1 := c2;
  end;
  WriteLn('counter goes forward: ', (back = 0) and (c2 >= c0));
  f := CycleFreq;
  WriteLn('rate is sane: ', (f >= 1000000) and (f <= 100000000000));
  WriteLn('rate is kept: ', CycleFreq() = f);
  c1 := CycleCount;
  Sleep(20);
  c2 := CycleCount;
  secs := (c2 - c1) / f;
  WriteLn('a sleep of 20 ms measured: ', (secs >= 0.018) and (secs < 5.0));
  back := 0;
  for i := 1 to 3 do
  begin
    c1 := CycleCount;
    Sleep(5);
    c2 := CycleCount;
    if c2 - c1 < f div 1000 then
      Inc(back);
  end;
  WriteLn('every read in a loop is a new one: ', back = 0);
  WriteLn('simd128: ', CpuHas('simd128'), ' ', Ord(CpuHas('SIMD128')));
  WriteLn('one machine: ', CpuHas('sse2') <> CpuHas('neon'));
  WriteLn('implications: ', ((not CpuHas('avx2')) or CpuHas('avx')) and
    ((not CpuHas('avx512bw')) or CpuHas('avx512f')) and
    ((not CpuHas('sve2')) or CpuHas('sve')) and
    ((not CpuHas('simd256')) or CpuHas('simd128')));
{$ifdef CPUX86_64}
  if not ReadFile('/proc/cpuinfo', text) then
    Inc(bad);
  FindFlags;
  Agree('sse3', CpuHas('sse3'), HasWord('pni'));
  Agree('ssse3', CpuHas('ssse3'), HasWord('ssse3'));
  Agree('sse41', CpuHas('sse41'), HasWord('sse4_1'));
  Agree('sse42', CpuHas('sse42'), HasWord('sse4_2'));
  Agree('popcnt', CpuHas('popcnt'), HasWord('popcnt'));
  Agree('aes', CpuHas('aes'), HasWord('aes'));
  Agree('pclmul', CpuHas('pclmul'), HasWord('pclmulqdq'));
  Agree('avx', CpuHas('avx'), HasWord('avx'));
  Agree('fma', CpuHas('fma'), HasWord('fma'));
  Agree('f16c', CpuHas('f16c'), HasWord('f16c'));
  Agree('movbe', CpuHas('movbe'), HasWord('movbe'));
  Agree('rdrand', CpuHas('rdrand'), HasWord('rdrand'));
  Agree('avx2', CpuHas('avx2'), HasWord('avx2'));
  Agree('bmi1', CpuHas('bmi1'), HasWord('bmi1'));
  Agree('bmi2', CpuHas('bmi2'), HasWord('bmi2'));
  Agree('adx', CpuHas('adx'), HasWord('adx'));
  Agree('rdseed', CpuHas('rdseed'), HasWord('rdseed'));
  Agree('sha', CpuHas('sha'), HasWord('sha_ni'));
  Agree('erms', CpuHas('erms'), HasWord('erms'));
  Agree('avx512f', CpuHas('avx512f'), HasWord('avx512f'));
  Agree('avx512bw', CpuHas('avx512bw'), HasWord('avx512bw'));
  Agree('avx512vl', CpuHas('avx512vl'), HasWord('avx512vl'));
  Agree('avx512dq', CpuHas('avx512dq'), HasWord('avx512dq'));
  Agree('vaes', CpuHas('vaes'), HasWord('vaes'));
  Agree('vpclmulqdq', CpuHas('vpclmulqdq'), HasWord('vpclmulqdq'));
  Agree('gfni', CpuHas('gfni'), HasWord('gfni'));
  Agree('lzcnt', CpuHas('lzcnt'), HasWord('abm'));
  Agree('avx512vbmi', CpuHas('avx512vbmi'), HasWord('avx512vbmi'));
  Agree('avx512vnni', CpuHas('avx512vnni'), HasWord('avx512_vnni'));
  Agree('cx16', CpuHas('cx16'), HasWord('cx16'));
  Agree('crc32', CpuHas('crc32'), CpuHas('sse42'));
  Agree('sha2', CpuHas('sha2'), CpuHas('sha'));
  Agree('rng', CpuHas('rng'), CpuHas('rdrand'));
  Agree('simd256', CpuHas('simd256'), CpuHas('avx2'));
  if IsBitSet(CpuFeatures, 0) = 0 then
    Inc(bad);
{$endif}
{$ifdef CPUAARCH64}
  hw := 0;
  hw2 := 0;
  if not ReadFile('/proc/self/auxv', aux) then
    Inc(bad);
  i := 1;
  while i + 15 <= Length(aux) do
  begin
    key := LoadLE64(@aux[i]);
    if key = 16 then
      hw := LoadLE64(@aux[i + 8]);
    if key = 26 then
      hw2 := LoadLE64(@aux[i + 8]);
    Inc(i, 16);
  end;
  Agree('fp', CpuHas('fp'), IsBitSet(hw, 0) = 1);
  Agree('neon', CpuHas('neon'), IsBitSet(hw, 1) = 1);
  Agree('aes', CpuHas('aes'), IsBitSet(hw, 3) = 1);
  Agree('pmull', CpuHas('pmull'), IsBitSet(hw, 4) = 1);
  Agree('sha1', CpuHas('sha1'), IsBitSet(hw, 5) = 1);
  Agree('sha2', CpuHas('sha2'), IsBitSet(hw, 6) = 1);
  Agree('crc32', CpuHas('crc32'), IsBitSet(hw, 7) = 1);
  Agree('atomics', CpuHas('atomics'), IsBitSet(hw, 8) = 1);
  Agree('fphp', CpuHas('fphp'), IsBitSet(hw, 9) = 1);
  Agree('asimdhp', CpuHas('asimdhp'), IsBitSet(hw, 10) = 1);
  Agree('rdm', CpuHas('rdm'), IsBitSet(hw, 12) = 1);
  Agree('jscvt', CpuHas('jscvt'), IsBitSet(hw, 13) = 1);
  Agree('fcma', CpuHas('fcma'), IsBitSet(hw, 14) = 1);
  Agree('lrcpc', CpuHas('lrcpc'), IsBitSet(hw, 15) = 1);
  Agree('dcpop', CpuHas('dcpop'), IsBitSet(hw, 16) = 1);
  Agree('sha3', CpuHas('sha3'), IsBitSet(hw, 17) = 1);
  Agree('sm3', CpuHas('sm3'), IsBitSet(hw, 18) = 1);
  Agree('sm4', CpuHas('sm4'), IsBitSet(hw, 19) = 1);
  Agree('dotprod', CpuHas('dotprod'), IsBitSet(hw, 20) = 1);
  Agree('sha512', CpuHas('sha512'), IsBitSet(hw, 21) = 1);
  Agree('sve', CpuHas('sve'), IsBitSet(hw, 22) = 1);
  Agree('fhm', CpuHas('fhm'), IsBitSet(hw, 23) = 1);
  Agree('dit', CpuHas('dit'), IsBitSet(hw, 24) = 1);
  Agree('uscat', CpuHas('uscat'), IsBitSet(hw, 25) = 1);
  Agree('ilrcpc', CpuHas('ilrcpc'), IsBitSet(hw, 26) = 1);
  Agree('flagm', CpuHas('flagm'), IsBitSet(hw, 27) = 1);
  Agree('ssbs', CpuHas('ssbs'), IsBitSet(hw, 28) = 1);
  Agree('sb', CpuHas('sb'), IsBitSet(hw, 29) = 1);
  Agree('paca', CpuHas('paca'), IsBitSet(hw, 30) = 1);
  Agree('pacg', CpuHas('pacg'), IsBitSet(hw, 31) = 1);
  Agree('dcpodp', CpuHas('dcpodp'), IsBitSet(hw2, 0) = 1);
  Agree('sve2', CpuHas('sve2'), IsBitSet(hw2, 1) = 1);
  Agree('sveaes', CpuHas('sveaes'), IsBitSet(hw2, 2) = 1);
  Agree('svepmull', CpuHas('svepmull'), IsBitSet(hw2, 3) = 1);
  Agree('svebitperm', CpuHas('svebitperm'), IsBitSet(hw2, 4) = 1);
  Agree('svesha3', CpuHas('svesha3'), IsBitSet(hw2, 5) = 1);
  Agree('svesm4', CpuHas('svesm4'), IsBitSet(hw2, 6) = 1);
  Agree('flagm2', CpuHas('flagm2'), IsBitSet(hw2, 7) = 1);
  Agree('frint', CpuHas('frint'), IsBitSet(hw2, 8) = 1);
  Agree('svei8mm', CpuHas('svei8mm'), IsBitSet(hw2, 9) = 1);
  Agree('svef32mm', CpuHas('svef32mm'), IsBitSet(hw2, 10) = 1);
  Agree('svef64mm', CpuHas('svef64mm'), IsBitSet(hw2, 11) = 1);
  Agree('svebf16', CpuHas('svebf16'), IsBitSet(hw2, 12) = 1);
  Agree('i8mm', CpuHas('i8mm'), IsBitSet(hw2, 13) = 1);
  Agree('bf16', CpuHas('bf16'), IsBitSet(hw2, 14) = 1);
  Agree('dgh', CpuHas('dgh'), IsBitSet(hw2, 15) = 1);
  Agree('rng', CpuHas('rng'), IsBitSet(hw2, 16) = 1);
  Agree('bti', CpuHas('bti'), IsBitSet(hw2, 17) = 1);
  Agree('mte', CpuHas('mte'), IsBitSet(hw2, 18) = 1);
  Agree('popcnt', CpuHas('popcnt'), CpuHas('neon'));
  if CpuFeatures <> ((hw and $FFFFFFFF) or ((hw2 and $FFFFFFFF) shl 32)) then
    Inc(bad);
{$endif}
  WriteLn('features word: ', CpuFeatures <> 0);
  WriteLn('the kernel agrees: ', bad = 0);
end.
