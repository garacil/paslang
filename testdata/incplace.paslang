{ P402: Inc and Dec of a place no register holds, by a constant or a
  word variable's value, push nothing: on amd64 they are one add or sub
  at the place's width with the place as its operand, on arm64 its
  load, add and store. Globals of every width, fields of Self, of a
  parameter and of a record in an object, a record in the frame,
  elements of arrays, pointer targets; steps constant, negative, at the
  limits of 32 bits, in a register and in memory; every width wraps.
  check_incplace reads the forms. }
program incplace;

type
  TColor = (cRed, cGreen, cBlue, cGray);

  TPair = record
    A: Integer;
    B: LongInt;
  end;

  TC = class
    N: Integer;
    W: Word;
    S8: ShortInt;
    P: TPair;
    procedure Bump(K: Integer);
    procedure Other(O: TC);
  end;

var
  g: Integer;
  g32: LongInt;
  g16: SmallInt;
  g8: ShortInt;
  gb: Byte;
  gw: Word;
  gu: LongWord;
  gc: Char;
  ge: TColor;
  arr: array[0..7] of Integer;
  barr: array[0..7] of Byte;
  step: Integer;

procedure TC.Bump(K: Integer);
begin
  Inc(N);
  Inc(N, 5);
  Dec(N, 2);
  Inc(N, K);
  Inc(W, 65535);
  Inc(S8, 100);
  Inc(P.A, 3);
  Dec(P.B, K);
end;

procedure TC.Other(O: TC);
begin
  Inc(O.N, N);
  Dec(O.W);
  Inc(O.P.A, 1000);
end;

procedure Globals(K: Integer);
begin
  Inc(g);
  Inc(g, 7);
  Dec(g);
  Inc(g, K);
  Dec(g, step);
  Inc(g32, 2147483647);
  Inc(g16, 30000);
  Inc(g16, 30000);
  Inc(g8, 100);
  Inc(g8, 100);
  Inc(gb, 250);
  Inc(gb, 10);
  Dec(gw, 3);
  Inc(gu, -1);
  Inc(gc);
  Inc(ge);
  Inc(g, -2147483648);
  Dec(g, -2147483647);
end;

procedure Frame(K: Integer);
var
  r: TPair;
  i: Integer;
  p: ^Integer;
begin
  r.A := 1;
  r.B := -1;
  Inc(r.A, K);
  Dec(r.B, 2147483647);
  Dec(r.B, 2);
  WriteLn('frame ', r.A, ' ', r.B);
  for i := 0 to 7 do
  begin
    arr[i] := i;
    barr[i] := Byte(250 + i);
  end;
  for i := 0 to 7 do
  begin
    Inc(arr[i], i * 10);
    Inc(barr[i], 3);
    Dec(arr[(i + 1) and 7]);
  end;
  p := @arr[3];
  Inc(p^, 100);
  Dec(p^, K);
  for i := 0 to 7 do
    Write(arr[i], ' ', barr[i], ' ');
  WriteLn;
end;

var
  c, d: TC;

begin
  step := 11;
  g8 := 0;
  gb := 0;
  gw := 1;
  gu := 0;
  gc := 'a';
  ge := cRed;
  Globals(3);
  WriteLn('globals ', g, ' ', g32, ' ', g16, ' ', g8, ' ', gb, ' ', gw, ' ', gu, ' ', gc, ' ', Ord(ge));
  Globals(-50);
  WriteLn('globals ', g, ' ', g32, ' ', g16, ' ', g8, ' ', gb, ' ', gw, ' ', gu, ' ', gc, ' ', Ord(ge));
  c := TC.Create;
  d := TC.Create;
  c.W := 7;
  c.S8 := 100;
  c.Bump(9);
  WriteLn('bump ', c.N, ' ', c.W, ' ', c.S8, ' ', c.P.A, ' ', c.P.B);
  c.Bump(-4);
  WriteLn('bump ', c.N, ' ', c.W, ' ', c.S8, ' ', c.P.A, ' ', c.P.B);
  d.Other(c);
  c.Other(d);
  WriteLn('other ', c.N, ' ', c.W, ' ', c.P.A, ' ', d.N, ' ', d.W, ' ', d.P.A);
  Frame(5);
end.
