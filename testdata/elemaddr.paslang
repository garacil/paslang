{ P373: the address of an element goes straight into the register that
  reads it: records copied between elements of static arrays at
  variable indexes, a global's and a frame's, from 0 and from 1, of a
  slice, and through Move and FillChar, each copy checked against the
  same copy made field by field. Every line is the same at -inline 0. }
program elemaddr;

type
  TW = record
    A, B, C, D, E: Integer;
  end;

var
  g0, r0: array[0..7] of TW;
  g1, r1: array[1..8] of TW;
  dyn, rd: array of TW;
  i, j, s, bad: Integer;
  t, rt: TW;

procedure Put(var D: TW; const S: TW);
begin
  D.A := S.A;
  D.B := S.B;
  D.C := S.C;
  D.D := S.D;
  D.E := S.E;
end;

function Same(const X, Y: TW): Boolean;
begin
  Result := (X.A = Y.A) and (X.B = Y.B) and (X.C = Y.C) and (X.D = Y.D) and (X.E = Y.E);
end;

function RunLocal(N: Integer): Integer;
var
  l0, lr: array[0..7] of TW;
  u, ur: TW;
  k: Integer;
begin
  for k := 0 to 7 do
  begin
    l0[k].A := k;
    l0[k].B := k * 3;
    l0[k].C := 0;
    l0[k].D := 0;
    l0[k].E := k * 10;
    Put(lr[k], l0[k]);
  end;
  Result := 0;
  for k := 0 to N - 1 do
  begin
    u := l0[k and 7];
    Put(ur, lr[k and 7]);
    l0[(k + 1) and 7] := u;
    Put(lr[(k + 1) and 7], ur);
    Result := Result + l0[(k + 3) and 7].E + u.A;
  end;
  for k := 0 to 7 do
    if not Same(l0[k], lr[k]) then
      Inc(bad);
end;

begin
  bad := 0;
  for i := 0 to 7 do
  begin
    g0[i].A := i;
    g0[i].B := 0;
    g0[i].C := i * i;
    g0[i].D := 0;
    g0[i].E := 100 + i;
    Put(r0[i], g0[i]);
    g1[i + 1].A := 0;
    g1[i + 1].B := i * 2;
    g1[i + 1].C := 0;
    g1[i + 1].D := -i;
    g1[i + 1].E := 0;
    Put(r1[i + 1], g1[i + 1]);
  end;
  SetLength(dyn, 8);
  SetLength(rd, 8);
  s := 0;
  for i := 0 to 99 do
  begin
    t := g0[i and 7];
    Put(rt, r0[i and 7]);
    g0[(i + 1) and 7] := t;
    Put(r0[(i + 1) and 7], rt);
    dyn[i and 7] := g0[(i * 3) and 7];
    Put(rd[i and 7], r0[(i * 3) and 7]);
    g1[(i and 7) + 1] := dyn[(i + 5) and 7];
    Put(r1[(i and 7) + 1], rd[(i + 5) and 7]);
    s := s + t.A + dyn[i and 7].E + g1[(i and 7) + 1].B;
  end;
  for i := 0 to 7 do
    if not (Same(g0[i], r0[i]) and Same(g1[i + 1], r1[i + 1]) and Same(dyn[i], rd[i])) then
      Inc(bad);
  WriteLn('globals ', s);
  WriteLn('locals ', RunLocal(100));
  j := 3;
  FillChar(g0[j], SizeOf(TW), 0);
  Move(g0[j + 2], g0[j - 1], SizeOf(TW));
  WriteLn('fill ', g0[3].A, ' ', g0[3].E, ' ', g0[2].A, ' ', g0[2].E, ' ', g0[5].E);
  WriteLn('bad ', bad);
end.

