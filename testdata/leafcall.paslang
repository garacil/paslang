{ P288: a function of one statement, Result := E over its word
  parameters, is a leaf: no stack check, no frame, its parameters in the
  registers they came in, the expression in the pool past them; a
  routine that calls nothing keeps its frame and has no stack check.
  Each line is what the same routine gives with a frame and a check;
  the program calls them directly, through routine values, through a
  class's virtual methods and from pasroutines. }
program leafcall;

type
  TShape = class
    W, H: Integer;
    Next: TShape;
    function Area: Integer; virtual;
    function AreaK(K: Integer): Integer; virtual;
    function Link: TShape;
  end;
  TFn = function(K: Integer): Integer;
  TFn2 = function(A, B: Integer): Integer;

var
  done: chan of Integer;

function TShape.Area: Integer;
begin
  Result := W * H;
end;

function TShape.AreaK(K: Integer): Integer;
begin
  Result := W * H - K;
end;

function TShape.Link: TShape;
begin
  Result := Next;
end;

function Twice(K: Integer): Integer;
begin
  Twice := K * 2;
end;

function Thrice(K: Integer): Integer;
begin
  Result := K * 3;
end;

function Mix(A, B: Integer): Integer;
begin
  Result := ((A xor B) shl 3) + (not A) - (-B);
end;

function Rot(A, N: Integer): Integer;
begin
  Result := (A shl N) or (A shr (64 - N));
end;

function Big(A: Integer): Integer;
begin
  Result := (A + 81985529216486895) and 1152921504606846975;
end;

function Three(A, B, C: Integer): Integer;
begin
  Result := A * B + C;
end;

function Same(P: Pointer): Pointer;
begin
  Result := P;
end;

function Konst: Integer;
begin
  Result := 42;
end;

{ Calls nothing but has a local and ifs: a frame, and no stack check. }
function Clamp(X, Lo, Hi: Integer): Integer;
var
  r: Integer;
begin
  r := X;
  if r < Lo then
    r := Lo;
  if r > Hi then
    r := Hi;
  Result := r;
end;

procedure Worker(N: Integer);
var
  f: TFn;
  i, t: Integer;
begin
  t := 0;
  for i := 1 to 100000 do
  begin
    if (i + N) mod 2 = 0 then
      f := @Twice
    else
      f := @Thrice;
    t := t + f(i);
  end;
  Send(done, t);
end;

var
  s: TShape;
  f: TFn;
  g: TFn2;
  i, t: Integer;
  p: Pointer;

begin
  s := TShape.Create;
  s.W := 6;
  s.H := 7;
  s.Next := s;
  WriteLn(s.Area);
  WriteLn(s.AreaK(2));
  WriteLn(s.Link = s);
  WriteLn(Twice(21));
  WriteLn(Thrice(-7));
  WriteLn(Mix(5, 3));
  WriteLn(Mix(-1234567, 89));
  WriteLn(Rot(1, 63));
  WriteLn(Rot(-2, 1));
  WriteLn(Big(1));
  WriteLn(Big(-81985529216486896));
  WriteLn(Three(2, 3, 4));
  p := @t;
  WriteLn(Same(p) = p);
  WriteLn(Same(nil) = nil);
  WriteLn(Konst);
  WriteLn(Clamp(15, 0, 10));
  WriteLn(Clamp(-5, 0, 10));
  WriteLn(Clamp(7, 0, 10));
  f := @Twice;
  t := 0;
  for i := 1 to 1000 do
    t := t + f(i);
  WriteLn(t);
  g := @Mix;
  WriteLn(g(5, 3));
  g := @Rot;
  WriteLn(g(1, 1));
  done := MakeChan();
  for i := 0 to 3 do
    pas Worker(i);
  t := 0;
  for i := 0 to 3 do
    t := t + Recv(done);
  WriteLn(t);
end.

