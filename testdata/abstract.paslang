program abstractp;

type
  TBase = class
    function Value(N: Integer): Integer; virtual; abstract;
  end;

  TChild = class(TBase)
    function Value(N: Integer): Integer; override;
  end;

  TMid = class(TBase)
    function Other: Integer;
  end;

function TChild.Value(N: Integer): Integer;
begin
  Result := N + 10;
end;

function TMid.Other: Integer;
begin
  Result := 1;
end;

var
  b: TBase;
  c: TChild;

begin
  c := TChild.Create;
  b := c;
  WriteLn(c.Value(3));
  WriteLn(b.Value(4));
end.
