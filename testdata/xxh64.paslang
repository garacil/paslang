program xxh64;

var
  s31, s32, s33, lng: string;

begin
  s31 := 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
  s32 := 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
  s33 := 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
  lng := 'The xxHash algorithm is fast because it reads the input in wide stripes and mixes four accumulators in parallel; paslang implements XXH32 and XXH64 in its own emitted runtime for both amd64 and arm64.';
  WriteLn(XxHash64(''));
  WriteLn(XxHash64('a'));
  WriteLn(XxHash64('abc'));
  WriteLn(XxHash64('The quick brown fox jumps over the lazy dog'));
  WriteLn(XxHash64('The quick brown fox jumps over the lazy dog', 1));
  WriteLn(XxHash64(s31));
  WriteLn(XxHash64(s32));
  WriteLn(XxHash64(s33));
  WriteLn(XxHash64(lng));
  WriteLn(XxHash64(lng, 305419896));
end.

