{ Wycheproof's x25519_test.json (XdhComp, curve25519) against
  pasx25519 (P429), testdata/wycheproof/x25519_test.json. Every case is held to what
  Go's crypto/ecdh does: a result that is all zeros (the flag
  ZeroSharedSecret, a low-order public point) must be refused by
  X25519Shared while X25519 itself gives the zeros; every other case,
  valid or acceptable (twist points, non-canonical u, small or special
  public keys), must be accepted with the expected shared secret. An
  invalid case would have to be refused. }
program x25519wyche;

uses pasx25519, paslib;

function UnHex(const h: string): string;
var
  i, d, v: Integer;
  c: Char;
begin
  SetLength(Result, Length(h) div 2);
  v := 0;
  for i := 1 to Length(h) do
  begin
    c := h[i];
    if (c >= '0') and (c <= '9') then d := Ord(c) - 48
    else if (c >= 'a') and (c <= 'f') then d := Ord(c) - 87
    else d := Ord(c) - 55;
    if Odd(i) then v := d shl 4
    else Result[i div 2] := Chr(v or d);
  end;
end;

var
  text, res, priv, pub, want, raw, sh: string;
  doc, grp, tc, f: json;
  pass, fail, nvalid, nacc, naccrefused, ninvalid: Integer;
  ok, zero, good: Boolean;
begin
  if not ReadFile('testdata/wycheproof/x25519_test.json', text) then
  begin
    WriteLn('cannot read ', 'testdata/wycheproof/x25519_test.json');
    Halt(1);
  end;
  doc := JsonParse(text);
  pass := 0; fail := 0; nvalid := 0; nacc := 0; naccrefused := 0; ninvalid := 0;
  for grp in doc['testGroups'] do
    for tc in grp['tests'] do
    begin
      res := tc['result'].AsString;
      priv := UnHex(tc['private'].AsString);
      pub := UnHex(tc['public'].AsString);
      want := UnHex(tc['shared'].AsString);
      zero := False;
      for f in tc['flags'] do
        if f.AsString = 'ZeroSharedSecret' then
          zero := True;
      raw := X25519(priv, pub);
      ok := X25519Shared(priv, pub, sh);
      if res = 'invalid' then
      begin
        Inc(ninvalid);
        good := not ok;
      end
      else if zero then
      begin
        { refused as Go's ecdh, the raw function giving the zeros }
        good := (not ok) and (sh = '') and (raw = want) and (raw = StringOfChar(#0, 32));
        if res = 'acceptable' then Inc(naccrefused) else Inc(nvalid);
      end
      else
      begin
        good := ok and (sh = want) and (raw = want);
        if res = 'acceptable' then Inc(nacc) else Inc(nvalid);
      end;
      if good then
        Inc(pass)
      else
      begin
        Inc(fail);
        WriteLn('FAIL ', tc['tcId'].AsInteger, ' ', res, ' got ', Hex(raw), ' ', ok);
      end;
    end;
  WriteLn('x25519_test.json: ', pass + fail, ' tests, ', pass, ' pass, ', fail, ' fail, 0 skipped');
  WriteLn('  valid ', nvalid, ', acceptable accepted ', nacc,
    ', acceptable refused (all-zero result) ', naccrefused, ', invalid ', ninvalid);
  if fail > 0 then
    Halt(1);
end.
