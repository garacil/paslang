{ P399: Move whose arguments call nothing puts each in rt_memcpy's
  register with no push: a word variable, a fixed variable's address,
  p^, @p[i] of a pointer and an index in registers, a field of an object
  a register holds go straight there, and one argument that is none of
  these is worked out first. Arguments already in each other's
  registers (Src in rdi, Dst in rsi) still copy the right way. Counts of
  every size, overlaps either way; check_moveregs reads the forms. }
program moveregs;

type
  TBuf = class
    Data: PByte;
    Len: Integer;
    procedure Fill(Src: PByte);
    procedure Take(Dst: PByte; At: Integer);
  end;

var
  src, dst: array[0..399] of Byte;
  sum: Integer;

procedure TBuf.Fill(Src: PByte);
begin
  Move(Src^, Data^, Len);
end;

procedure TBuf.Take(Dst: PByte; At: Integer);
begin
  Move(Data[At], Dst^, Len);
end;

{ arguments that sit in each other's registers }
procedure CopyOn(Src, Dst: PByte; N: Integer);
begin
  Move(Src^, Dst^, N);
end;

procedure Swapped(Dst, Src: PByte; N: Integer);
begin
  Move(Src^, Dst^, N);
end;

{ a pointer and an index a loop keeps in registers }
procedure Chunks(P, Q: PByte; N, Step: Integer);
var
  i: Integer;
begin
  i := 0;
  while i + Step <= N do
  begin
    Move(P[i], Q[i], Step);
    i := i + Step;
  end;
end;

{ one argument worked out first: an index sum }
procedure Shifted(P: PByte; A, B, N: Integer);
begin
  Move(P[A + B], dst[0], N);
end;

function Check(N: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to N - 1 do
    Result := Result * 31 + dst[i] + i;
  Result := Result and $FFFFFF;
end;

procedure Wipe;
var
  i: Integer;
begin
  for i := 0 to 399 do
    dst[i] := 0;
end;

var
  b: TBuf;
  i, n: Integer;
  sizes: array[0..9] of Integer;
  over: array[0..63] of Byte;

begin
  for i := 0 to 399 do
    src[i] := Byte(i * 7 + 3);
  sizes[0] := 0;
  sizes[1] := 1;
  sizes[2] := 7;
  sizes[3] := 8;
  sizes[4] := 15;
  sizes[5] := 16;
  sizes[6] := 17;
  sizes[7] := 100;
  sizes[8] := 255;
  sizes[9] := 400;
  for i := 0 to 9 do
  begin
    n := sizes[i];
    Wipe;
    CopyOn(@src[0], @dst[0], n);
    Write(Check(n), ' ');
    Wipe;
    Swapped(@dst[0], @src[0], n);
    Write(Check(n), ' ');
  end;
  WriteLn;
  b := TBuf.Create;
  b.Data := @dst[0];
  b.Len := 33;
  Wipe;
  b.Fill(@src[5]);
  WriteLn('fill ', Check(40));
  b.Data := @src[0];
  b.Len := 20;
  Wipe;
  b.Take(@dst[10], 30);
  WriteLn('take ', Check(40));
  Wipe;
  Chunks(@src[0], @dst[0], 120, 24);
  WriteLn('chunks ', Check(130));
  Wipe;
  Shifted(@src[0], 50, 7, 60);
  WriteLn('shifted ', Check(64));
  for i := 0 to 63 do
    over[i] := Byte(i);
  Move(over[0], over[3], 20);
  Move(over[40], over[30], 20);
  sum := 0;
  for i := 0 to 63 do
    sum := sum * 3 + over[i];
  WriteLn('overlap ', sum and $FFFFFF, ' ', over[3], over[22], over[30], over[49]);
end.
