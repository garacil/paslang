program typecall;
{$modeswitch advancedrecords}
type
  TR = record
    X: Int64;
    function Twice: Int64;
  end;
function TR.Twice: Int64;
begin
  Result := X * 2;
end;
begin
  WriteLn(TR.Twice);
end.

