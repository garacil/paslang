program strictf;
{$modeswitch advancedrecords}
type
  TR = record
  strict private
    FN: Int64;
  public
    function N: Int64;
  end;
function TR.N: Int64;
begin
  Result := FN;
end;
var
  r: TR;
begin
  r.FN := 1;
end.

