program strictm;
{$modeswitch advancedrecords}
type
  TR = record
  strict private
    procedure Hidden;
  public
    X: Int64;
  end;
procedure TR.Hidden;
begin
  X := 1;
end;
var
  r: TR;
begin
  r.Hidden;
end.

