{ P203: the numbers of a json. Each keeps its text (AsNumber) and is
  read as an Integer only from an integer literal that fits (Go's v2:
  1.0 and 1e2 are no integers), as a Double rounded once, as a Quad
  rounded once from the text, as a Currency only when it is exact; -0
  keeps its sign as a Double; equal by decimal value; written in RFC
  8785's form, an integer of fewer than 16 digits as it is. A Double
  and a Quad are shown by their bits too, the Doubles' those Python's
  float() gives the text (checked when this test was written). }
program jsonnum;

uses sysutils;

procedure Show(const T: string);
var
  j: json;
  d: Double;
  q: Quad;
  w: array[0..1] of Int64;
begin
  j := JsonParse(T);
  Write(T, ': text ', j.AsNumber);
  try Write(' int ', j.AsInteger) except on e: EJsonError do Write(' int (', e.Reason, ')') end;
  try
    d := j.AsFloat;
    Write(' float ', FloatToStr(d), ' ', LowerCase(IntToHex(d as Int64, 16)));
  except
    on e: EJsonError do
      Write(' float (', e.Reason, ')');
  end;
  try
    q := j.AsQuad;
    Move(q, w, 16);
    Write(' quad ', LowerCase(IntToHex(w[1], 16)), LowerCase(IntToHex(w[0], 16)));
  except
    on e: EJsonError do
      Write(' quad (', e.Reason, ')');
  end;
  try Write(' cur ', j.AsCurrency) except on e: EJsonError do Write(' cur (', e.Reason, ')') end;
  WriteLn(' canonical ', JsonEncode(j, JsonCanonical));
end;

const
  Nums: array[0..27] of string = ('0', '-0', '1', '-1', '9223372036854775807',
    '-9223372036854775808', '9223372036854775808', '18446744073709551615',
    '18446744073709551616', '1.0', '1e2', '1E+2', '0.1', '-0.0', '1.5e-7', '123456789012345',
    '1234567890123456', '12345678901234567890123', '1e21', '1e-6', '2.5e-324', '1e-400',
    '1.7976931348623157e308', '1.7976931348623159e308', '1e400', '922337203685477.5807',
    '922337203685477.5808', '0.00005');

var
  i: Integer;
  a, b: json;

begin
  for i := 0 to High(Nums) do
    Show(Nums[i]);
  a := JsonParse('[1, 1.0, 10e-1, 0.1e1, 100e-2]');
  b := JsonParse('[1, 1, 1, 1, 1]');
  WriteLn(a = b, ' ', JsonParse('0.1') = JsonParse('0.10000000000000001'),
    ' ', JsonParse('-0') = JsonParse('0'), ' ', JsonParse('1e400') = JsonParse('10e399'));
  WriteLn(JsonEncode(JsonParse('[1E400,-1e400,0.000001,1e-7,100,1e2,-0,5e-324]'), JsonCanonical));
end.
