{ P585: a waitgroup used again. The call that brings the count to zero
  wakes whoever is parked in Wait, and it took the lock for that after
  the add: stopped between the two, it found a routine that had gone on
  and was parked in the next Wait of the same waitgroup, and woke it
  with routines still to come.

  Each round uses the waitgroup twice. The first use ends before anyone
  waits: the main routine looks at the count until it is zero, so its
  Wait comes back at once and the Done that reached zero has nobody to
  wake. The second use counts a routine that does not end until another
  one, five milliseconds later, tells it to: the main routine is parked
  in Wait meanwhile, and when it comes back the count must be zero.

  With the unit as it is the first Done has long ended when the second
  Wait parks. scripts/check_wgreuse.py compiles this program against a
  copy of the unit whose call that reaches zero sleeps a millisecond
  before it takes the lock, which is what a stop there does.

  At the end three routines wait on the waitgroup at once, and the call
  that reaches zero wakes the three. }
program wgagain;

const
  Rounds = 40;

var
  wg, all: waitgroup;
  gate: chan of Integer;
  mu: mutex;
  r, early, back: Int64;

procedure Quick;
begin
  wg.Done;
end;

procedure Slow;
var
  x: Integer;
begin
  x := Recv(gate);
  wg.Done;
end;

procedure Opener;
begin
  Sleep(5);
  Send(gate, 1);
end;

procedure Waiter;
begin
  wg.Wait;
  lock mu do
    back := back + 1;
  all.Done;
end;

begin
  gate := MakeChan();
  early := 0;
  for r := 1 to Rounds do
  begin
    wg.Add(1);
    pas Quick;
    while PInt64(@wg)^ <> 0 do
      Yield;
    wg.Wait;
    wg.Add(1);
    pas Slow;
    pas Opener;
    wg.Wait;
    if PInt64(@wg)^ <> 0 then
    begin
      early := early + 1;
      { let the round end before the next one begins }
      while PInt64(@wg)^ <> 0 do
        Sleep(1);
    end;
  end;
  if early = 0 then
    WriteLn(Rounds, ' rounds, two uses each: no Wait came back with a routine still to come')
  else
    WriteLn(Rounds, ' rounds: ', early, ' waits came back with a routine still to come');
  { several routines parked in one Wait }
  back := 0;
  wg.Add(1);
  all.Add(3);
  for r := 1 to 3 do
    pas Waiter;
  Sleep(5);
  wg.Done;
  all.Wait;
  WriteLn('three routines waited at once: ', back, ' came back');
end.

