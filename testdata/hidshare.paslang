{ P378: the hidden variables of bodies put in place share the frame's
  slots when their lives do not meet: sixteen sites in one routine, a
  pointer parameter's copy among them (a pointer slot, shared with
  pointers only, which the collector reads), sites in a loop, and a body
  put in place inside another. make check runs it under the collector's
  verify and stress modes too and reads Many's frame. The sums by hand:
  Tri(5..8) 15 21 28 36, Tri(2), Tri(3) 3 6: 109; Wrap adds 1 2 3 4 to
  the box, giving 1 3 6 10: 129; the loop Tri(i) + Tri(i + 1) for i 1 to
  3, 4 9 16: 158; TriTwice(4) 20: 178. }
program hidshare;

type
  TBox = class
    V: Integer;
  end;

var
  r: Integer;

function Tri(N: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 1 to N do
    t := t + k;
  Result := t;
end;

function Wrap(B: TBox; K: Integer): Integer;
var
  u: Integer;
begin
  u := K * 2;
  B.V := B.V + u div 2;
  Result := B.V;
end;

function TriTwice(N: Integer): Integer;
begin
  Result := Tri(N) + Tri(N);
end;

function Many(N: Integer): Integer;
var
  b: TBox;
  s, i: Integer;
begin
  b := TBox.Create;
  s := 0;
  s := s + Tri(N);
  s := s + Tri(N + 1);
  s := s + Tri(N + 2);
  s := s + Tri(N + 3);
  s := s + Tri(2);
  s := s + Tri(3);
  s := s + Wrap(b, 1);
  s := s + Wrap(b, 2);
  s := s + Wrap(b, 3);
  s := s + Wrap(b, 4);
  for i := 1 to 3 do
    s := s + Tri(i) + Tri(i + 1);
  s := s + TriTwice(4);
  WriteLn('box ', b.V);
  b.Free;
  Result := s;
end;

begin
  r := Many(5);
  WriteLn('many ', r);
end.

