program syscurrency;
uses sysutils;
var value: Currency; fs: TFormatSettings; text: string; realValue: Double;
  bits: Integer; code, i, completed: Integer; joined: waitgroup;

procedure Require(Condition: Boolean; Error: Integer);
begin if not Condition then Halt(Error) end;

procedure Arg(Value: Currency; const Args: array of const);
begin
  Require((Length(Args) = 1) and (Args[0].VType = vtCurrency), 2);
  Require(Args[0].VCurrency = Value, 3);
end;

procedure Worker(Index: Integer);
var settings: TFormatSettings; price, zero: Currency; expected, held: string; k: Integer;
begin
  settings := DefaultFormatSettings;
  settings.DecimalSeparator := '.'; settings.ThousandSeparator := ',';
  if Odd(Index) then
  begin settings.DecimalSeparator := ','; settings.ThousandSeparator := '.' end;
  expected := '2' + settings.DecimalSeparator + '675';
  held := 'price-' + IntToStr(Index);
  price := 2.675; zero := 0;
  for k := 1 to 16 do
  begin
    Require(CurrToStr(price, settings) = expected, 4);
    Require(Currency.Parse(expected, settings) = price, 5);
    Require(Format('%.2f', [price], settings) = '2' + settings.DecimalSeparator + '68', 6);
    Require(FormatCurr('0.0000', price, settings) = '2' + settings.DecimalSeparator + '6750', 7);
    Require(price.ToString(settings) = expected, 8);
    try price := price / zero; Halt(9)
    except
      on error: ECurrencyError do
        Require((error.Kind = cfDivideByZero) and (ExceptObject = error), 10);
    end;
    Require((ExceptObject = nil) and (held = 'price-' + IntToStr(Index)), 11);
  end;
  AtomicAdd(@completed, 1);
  joined.Done;
end;

begin
  fs := DefaultFormatSettings;
  fs.DecimalSeparator := '.'; fs.ThousandSeparator := ',';
  value := 2.675;
  Require(CurrToStr(value, fs) = '2.675', 12);
  Require(FloatToStr(value, fs) = '2.675', 13);
  Require(CurrToStrF(value, ffFixed, 2, fs) = '2.68', 14);
  Require(FloatToStrF(value, ffFixed, 0, 3, fs) = '2.675', 15);
  Require(FormatFloat('0.00', value, fs) = '2.68', 16);
  Require(FormatCurr('0.00', value, fs) = '2.68', 17);
  Require(Format('%f %.2f %.4g', [value, value, value], fs) = '2.68 2.68 2.675', 18);
  Arg(value, [value]);
  Require(CurrToStr(High(Currency), fs) = '922337203685477.5807', 19);
  Require((MinCurrency = Low(Currency)) and (MaxCurrency = High(Currency)), 47);
  Require(CurrToStr(Low(Currency), fs) = '-922337203685477.5808', 20);
  Require(Format('%.4f', [High(Currency)], fs) = '922337203685477.5807', 21);
  Require(FormatCurr('0.0000', Low(Currency), fs) = '-922337203685477.5808', 22);
  Require(StrToCurr(' 1.23445 ', fs) = 1.2344, 23);
  Require(StrToCurr('-1.23455', fs) = -1.2346, 24);
  Require(not TryStrToCurr('922337203685477.58075', value, fs), 25);
  Require(value = 0, 26);
  Require(not TryStrToCurr('1,000.5', value, fs), 27);
  Require(not TryStrToCurr('1'#0'5', value, fs), 28);
  Require(not TryStrToCurr('1'#0, value, fs), 45);
  Require(not TryStrToCurr(#0'1', value, fs), 46);
  Require(StrToCurrDef('bad', 1.25, fs) = 1.25, 29);
  try value := StrToCurr('bad', fs); Halt(30)
  except on error: EConvertError do Require(Pos('bad', error.Message) <> 0, 31) end;
  Require(CurrencyToScaled(CurrencyFromScaled(Low(Integer))) = Low(Integer), 32);
  Require(CurrencyToScaled(Currency.FromScaled(High(Integer))) = High(Integer), 33);
  value := Currency.FromScaled(26750);
  Require((value.ToScaled = 26750) and (value.ScaledValue = 26750), 34);
  Require(Currency.TryParse('2.675', value, fs) and (value = 2.675), 35);
  realValue := 1.25; Require(FloatToCurr(realValue) = 1.25, 36);
  bits := $7ff8000000000001; realValue := bits as Double;
  Require(not TryFloatToCurr(realValue, value) and (value = 0), 37);
  try value := FloatToCurr(realValue); Halt(38)
  except on error: EConvertError do Require(error.Message <> '', 39) end;
  Str(2.675:0:4, text); { binary Double remains a different type }
  value := 2.675; Str(value:0:2, text); Require(text = '2.68', 40);
  Val('2.675', value, code); Require((code = 0) and (value = 2.675), 41);
  fs.DecimalSeparator := ','; fs.ThousandSeparator := '.';
  Require(StrToCurr('2,675', fs) = 2.675, 42);
  Require(not TryStrToCurr('2.675', value, fs), 43);
  joined.Add(128);
  for i := 0 to 127 do pas Worker(i);
  joined.Wait;
  Require(completed = 128, 44);
  WriteLn('SysUtils exact Currency formatting, parsing, helpers and 128 pasroutines');
end.
