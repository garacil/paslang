{ P367: a record Result, and a record local, written field by field
  before anything reads it starts as it is, and one any path reads first
  or leaves a field of unwritten starts as zero: each routine below runs
  after Dirty has left its frame full of 77s, so a field that should be
  0 and is not shows. Records with narrow fields, of more than three
  words, with padding and with a pointer word. }
program fieldfirst;

type
  TPacked = record
    B1, B2: Byte;
    W: Word;
    L: Int32;
    Q: Integer;
  end;
  TWide = record
    A, B, C, D, E: Integer;
  end;
  TGap = record
    B: Byte;
    Q: Integer;
  end;
  TPtr = record
    P: PInteger;
    N: Integer;
  end;

var
  pk: TPacked;
  wd: TWide;
  gp: TGap;
  pt: TPtr;
  x: Integer;

procedure Dirty;
var
  junk: array[0..63] of Integer;
  i: Integer;
begin
  for i := 0 to 63 do
    junk[i] := 77;
  x := junk[5];
end;

function Full(K: Integer): TPacked;
begin
  Result.B1 := Byte(K);
  Result.B2 := Byte(K + 1);
  Result.W := Word(K * 10);
  Result.L := Int32(K * 100);
  Result.Q := K * 1000;
end;

function Part(K: Integer): TPacked;
begin
  Result.B1 := Byte(K);
  Result.Q := K;
end;

function ReadFirst(K: Integer): TWide;
begin
  Result.A := Result.B + K;
  Result.B := K;
  Result.C := K;
  Result.D := K;
  Result.E := K;
end;

function Branch(K: Integer): TWide;
begin
  Result.A := K;
  Result.B := K;
  Result.C := K;
  if K > 5 then
  begin
    Result.D := K;
    Result.E := K;
  end
  else
    Result.D := -K;
end;

function Both(K: Integer): TWide;
begin
  if K > 5 then
  begin
    Result.A := 1;
    Result.B := 2;
  end
  else
  begin
    Result.B := 3;
    Result.A := 4;
  end;
  Result.C := 5;
  Result.D := 6;
  Result.E := 7;
end;

function Early(K: Integer): TWide;
begin
  Result.A := K;
  if K < 0 then
    Exit;
  Result.B := K;
  Result.C := K;
  Result.D := K;
  Result.E := K;
end;

function Gap(K: Integer): TGap;
begin
  Result.B := Byte(K);
  Result.Q := K;
end;

function Ptr(K: Integer): TPtr;
begin
  Result.N := K;
end;

function LocalSum(K: Integer): Integer;
var
  w: TWide;
  v: TWide;
begin
  w.A := K;
  w.B := K + 1;
  w.C := K + 2;
  w.D := K + 3;
  w.E := K + 4;
  v.A := K;
  Result := w.A + w.B + w.C + w.D + w.E + v.A + v.B + v.C + v.D + v.E;
end;

procedure ShowW(const W: TWide);
begin
  WriteLn(W.A, ' ', W.B, ' ', W.C, ' ', W.D, ' ', W.E);
end;

begin
  Dirty;
  pk := Full(3);
  WriteLn(pk.B1, ' ', pk.B2, ' ', pk.W, ' ', pk.L, ' ', pk.Q);
  Dirty;
  pk := Part(4);
  WriteLn(pk.B1, ' ', pk.B2, ' ', pk.W, ' ', pk.L, ' ', pk.Q);
  Dirty;
  ShowW(ReadFirst(2));
  Dirty;
  ShowW(Branch(9));
  Dirty;
  ShowW(Branch(2));
  Dirty;
  ShowW(Both(9));
  Dirty;
  ShowW(Both(1));
  Dirty;
  ShowW(Early(-1));
  Dirty;
  ShowW(Early(8));
  Dirty;
  gp := Gap(6);
  WriteLn(gp.B, ' ', gp.Q);
  Dirty;
  pt := Ptr(5);
  WriteLn(pt.P = nil, ' ', pt.N);
  Dirty;
  WriteLn(LocalSum(10));
end.

