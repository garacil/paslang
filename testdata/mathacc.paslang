var
  i, Bad: Integer;
  Worst, d: Int64;
  x, y, r: Double;

function Ordered(b: Int64): Int64;
begin
  if b < 0 then
    Result := -(b and $7FFFFFFFFFFFFFFF)
  else
    Result := b;
end;

function Dist(a, b: Int64): Int64;
begin
  Result := Ordered(a) - Ordered(b);
  if Result < 0 then
    Result := -Result;
end;

procedure Report(const Name: string; W, Bound: Int64; BadBits: Integer);
begin
  if W <= Bound then
    WriteLn(Name, ' ok')
  else
    WriteLn(Name, ' FAIL ', W, ' units, bound ', Bound);
  if BadBits = 0 then
    WriteLn(Name, ' go ok')
  else
    WriteLn(Name, ' go FAIL ', BadBits, ' results differ from the model of Go');
end;

begin
  Worst := 0;
  Bad := 0;
  for i := 0 to 177 do
  begin
    r := Tan(TanA[i] as Double);
    if i <= 99 then
    begin
      d := Dist(r as Int64, TanE[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> TanG[i] then
      Inc(Bad);
  end;
  Report('tan', Worst, 1, Bad);
  Worst := 0;
  Bad := 0;
  for i := 0 to 129 do
  begin
    r := Sinh(SinhA[i] as Double);
    if i <= 99 then
    begin
      d := Dist(r as Int64, SinhE[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> SinhG[i] then
      Inc(Bad);
  end;
  Report('sinh', Worst, 1, Bad);
  Worst := 0;
  Bad := 0;
  for i := 0 to 98 do
  begin
    r := Cosh(CoshA[i] as Double);
    if i <= 74 then
    begin
      d := Dist(r as Int64, CoshE[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> CoshG[i] then
      Inc(Bad);
  end;
  Report('cosh', Worst, 1, Bad);
  Worst := 0;
  Bad := 0;
  for i := 0 to 125 do
  begin
    r := Tanh(TanhA[i] as Double);
    if i <= 89 then
    begin
      d := Dist(r as Int64, TanhE[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> TanhG[i] then
      Inc(Bad);
  end;
  Report('tanh', Worst, 1, Bad);
  Worst := 0;
  Bad := 0;
  for i := 0 to 129 do
  begin
    r := ArcSinh(ArcSinhA[i] as Double);
    if i <= 99 then
    begin
      d := Dist(r as Int64, ArcSinhE[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> ArcSinhG[i] then
      Inc(Bad);
  end;
  Report('arcsinh', Worst, 1, Bad);
  Worst := 0;
  Bad := 0;
  for i := 0 to 116 do
  begin
    r := ArcCosh(ArcCoshA[i] as Double);
    if i <= 99 then
    begin
      d := Dist(r as Int64, ArcCoshE[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> ArcCoshG[i] then
      Inc(Bad);
  end;
  Report('arccosh', Worst, 1, Bad);
  Worst := 0;
  Bad := 0;
  for i := 0 to 113 do
  begin
    r := ArcTanh(ArcTanhA[i] as Double);
    if i <= 89 then
    begin
      d := Dist(r as Int64, ArcTanhE[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> ArcTanhG[i] then
      Inc(Bad);
  end;
  Report('arctanh', Worst, 1, Bad);
  Worst := 0;
  Bad := 0;
  for i := 0 to 160 do
  begin
    r := LnXP1(LnXP1A[i] as Double);
    if i <= 99 then
    begin
      d := Dist(r as Int64, LnXP1E[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> LnXP1G[i] then
      Inc(Bad);
  end;
  Report('lnxp1', Worst, 1, Bad);
  Worst := 0;
  Bad := 0;
  for i := 0 to 169 do
  begin
    r := Power(PowA[i] as Double, PowB[i] as Double);
    if i <= 119 then
    begin
      d := Dist(r as Int64, PowE[i]);
      if d > Worst then
        Worst := d;
    end;
    if (r as Int64) <> PowG[i] then
      Inc(Bad);
  end;
  Report('power', Worst, 7, Bad);
  Bad := 0;
  for i := 0 to 95 do
  begin
    x := SpA[i] as Double;
    y := SpB[i] as Double;
    case SpFn[i] of
      0: r := Tan(x);
      1: r := Sinh(x);
      2: r := Cosh(x);
      3: r := Tanh(x);
      4: r := ArcSinh(x);
      5: r := ArcCosh(x);
      6: r := ArcTanh(x);
      7: r := LnXP1(x);
      8: r := Power(x, y);
    end;
    if SpNaN[i] = 1 then
    begin
      if r = r then
        Inc(Bad);
    end
    else if (r as Int64) <> SpE[i] then
      Inc(Bad);
  end;
  if Bad = 0 then
    WriteLn('special ok')
  else
    WriteLn('special FAIL ', Bad);
end.
