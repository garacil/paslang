program dloop;

{ Small leaf routines whose Doubles a loop works on (P531): each had no
  frame and kept its Doubles in general registers; with a loop in it each
  has a frame and its Doubles in xmm registers. The 64 bits of every result
  are what scripts/gen_dloop.py works out with Python floats. }

function Bits(d: Double): Int64;
begin
  Result := d as Int64;
end;

function HornerPlain(x, y: Double): Double;
var
  r: Double; i: Integer;
begin
  r := 0.0;
  for i := 1 to 16 do
    r := r * x + i;
  Result := r;
end;

function HornerFma(x, y: Double): Double;
var
  r: Double; i: Integer;
begin
  r := 0.0;
  for i := 1 to 16 do
    r := Fma(r, x, i);
  Result := r;
end;

function ResultLoop(x, y: Double): Double;
var
  i: Integer;
begin
  Result := 1.0;
  for i := 1 to 8 do
    Result := Result * x + y;
end;

function SumLoop(x, y: Double): Double;
var
  s: Double; i: Integer;
begin
  s := 0.0;
  for i := 1 to 100 do
    s := s + x * i;
  Result := s;
end;

function Newton(x, y: Double): Double;
var
  z: Double; k: Integer;
begin
  if x > 1.0 then
    z := x
  else
    z := 1.0;
  for k := 1 to 12 do
    z := (z + x / z) / 2.0;
  Result := z;
end;

function Halve(x, y: Double): Double;
var
  z, n: Double;
begin
  z := Abs(x) + 1.0;
  n := 0.0;
  while z > 1.0 do
  begin
    z := z * 0.5;
    n := n + 1.0;
  end;
  Result := z + n;
end;

function Logistic(x, y: Double): Double;
var
  a, b, r: Double; k: Integer;
begin
  a := 0.3;
  b := 0.0;
  r := 3.7;
  for k := 1 to 40 do
  begin
    a := r * a * (1.0 - a);
    b := b + a;
  end;
  Result := a + b * 0.001 + x * 0.0;
end;

function Mixed(x, y: Double): Double;
var
  t: Double; i: Integer;
begin
  t := 0.0;
  for i := 1 to 60 do
  begin
    t := t + i / 7.0;
    if t > 50.0 then
      t := t - 50.0;
  end;
  Result := t + x;
end;

function Seven(x, y: Double): Double;
var
  a, b, c, d, e, f, g: Double; k: Integer;
begin
  a := 1.0; b := 2.0; c := 3.0; d := 4.0; e := 5.0; f := 6.0; g := 7.0;
  for k := 1 to 20 do
  begin
    a := a * 0.5 + b * 0.25;
    b := b + c * 0.125;
    c := c - d * 0.0625;
    d := d * 0.75 + e;
    e := e + f * 0.5 - g * 0.125;
    f := f * 0.9 + a;
    g := g + (a - b) * 0.01 + x * 0.001;
  end;
  Result := a + b + c + d + e + f + g;
end;

function ParamLoop(x, y: Double): Double;
var
  k: Integer;
begin
  for k := 1 to 10 do
  begin
    x := x * y + 1.0;
    if x > 1000.0 then
      x := x / 1000.0;
  end;
  Result := x;
end;

function TwoStates(x, y: Double): Double;
var
  p, q: Double; i: Integer;
begin
  p := 1.0;
  q := 0.0;
  for i := 1 to 30 do
  begin
    p := p * (1.0 + x / (i + 10.0));
    q := q + p / (i + y * 0.0 + 1.0);
  end;
  Result := q;
end;

function RepeatLoop(x, y: Double): Double;
var
  z: Double; n: Integer;
begin
  z := x * x;
  n := 0;
  repeat
    z := z * 0.9 + 0.1;
    n := n + 1;
  until (z < 0.2) or (n >= 50);
  Result := z + n;
end;

function DoubleCount(x, y: Double): Double;
var
  s, t: Double;
begin
  s := 0.0;
  t := x;
  while t < y do
  begin
    s := s + t;
    t := t + 0.5;
  end;
  Result := s;
end;

function NoLoop(x, y: Double): Double;
var
  z: Double;
begin
  z := x * y;
  Result := z + 1.0;
end;

begin
  WriteLn('HornerPlain 0.5 1.25 ', Bits(HornerPlain(0.5, 1.25)));
  WriteLn('HornerPlain 1.0 1.0 ', Bits(HornerPlain(1.0, 1.0)));
  WriteLn('HornerPlain 1.5 -0.75 ', Bits(HornerPlain(1.5, (-0.75))));
  WriteLn('HornerPlain -2.25 0.5 ', Bits(HornerPlain((-2.25), 0.5)));
  WriteLn('HornerPlain 3.1415926 2.7182818 ', Bits(HornerPlain(3.1415926, 2.7182818)));
  WriteLn('HornerPlain 0.001 100.0 ', Bits(HornerPlain(0.001, 100.0)));
  WriteLn('HornerPlain 123456.789 0.0001 ', Bits(HornerPlain(123456.789, 0.0001)));
  WriteLn('HornerPlain 0.0 0.0 ', Bits(HornerPlain(0.0, 0.0)));
  WriteLn('HornerPlain -0.0 3.0 ', Bits(HornerPlain((-0.0), 3.0)));
  WriteLn('HornerPlain 2.0 1.0001 ', Bits(HornerPlain(2.0, 1.0001)));
  WriteLn('HornerPlain 10.0 0.5 ', Bits(HornerPlain(10.0, 0.5)));
  WriteLn('HornerPlain 0.75 -1.5 ', Bits(HornerPlain(0.75, (-1.5))));
  WriteLn('HornerFma 0.5 1.25 ', Bits(HornerFma(0.5, 1.25)));
  WriteLn('HornerFma 1.0 1.0 ', Bits(HornerFma(1.0, 1.0)));
  WriteLn('HornerFma 1.5 -0.75 ', Bits(HornerFma(1.5, (-0.75))));
  WriteLn('HornerFma -2.25 0.5 ', Bits(HornerFma((-2.25), 0.5)));
  WriteLn('HornerFma 3.1415926 2.7182818 ', Bits(HornerFma(3.1415926, 2.7182818)));
  WriteLn('HornerFma 0.001 100.0 ', Bits(HornerFma(0.001, 100.0)));
  WriteLn('HornerFma 123456.789 0.0001 ', Bits(HornerFma(123456.789, 0.0001)));
  WriteLn('HornerFma 0.0 0.0 ', Bits(HornerFma(0.0, 0.0)));
  WriteLn('HornerFma -0.0 3.0 ', Bits(HornerFma((-0.0), 3.0)));
  WriteLn('HornerFma 2.0 1.0001 ', Bits(HornerFma(2.0, 1.0001)));
  WriteLn('HornerFma 10.0 0.5 ', Bits(HornerFma(10.0, 0.5)));
  WriteLn('HornerFma 0.75 -1.5 ', Bits(HornerFma(0.75, (-1.5))));
  WriteLn('ResultLoop 0.5 1.25 ', Bits(ResultLoop(0.5, 1.25)));
  WriteLn('ResultLoop 1.0 1.0 ', Bits(ResultLoop(1.0, 1.0)));
  WriteLn('ResultLoop 1.5 -0.75 ', Bits(ResultLoop(1.5, (-0.75))));
  WriteLn('ResultLoop -2.25 0.5 ', Bits(ResultLoop((-2.25), 0.5)));
  WriteLn('ResultLoop 3.1415926 2.7182818 ', Bits(ResultLoop(3.1415926, 2.7182818)));
  WriteLn('ResultLoop 0.001 100.0 ', Bits(ResultLoop(0.001, 100.0)));
  WriteLn('ResultLoop 123456.789 0.0001 ', Bits(ResultLoop(123456.789, 0.0001)));
  WriteLn('ResultLoop 0.0 0.0 ', Bits(ResultLoop(0.0, 0.0)));
  WriteLn('ResultLoop -0.0 3.0 ', Bits(ResultLoop((-0.0), 3.0)));
  WriteLn('ResultLoop 2.0 1.0001 ', Bits(ResultLoop(2.0, 1.0001)));
  WriteLn('ResultLoop 10.0 0.5 ', Bits(ResultLoop(10.0, 0.5)));
  WriteLn('ResultLoop 0.75 -1.5 ', Bits(ResultLoop(0.75, (-1.5))));
  WriteLn('SumLoop 0.5 1.25 ', Bits(SumLoop(0.5, 1.25)));
