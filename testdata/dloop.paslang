  WriteLn('Halve 3.1415926 2.7182818 ', Bits(Halve(3.1415926, 2.7182818)));
  WriteLn('Halve 0.001 100.0 ', Bits(Halve(0.001, 100.0)));
  WriteLn('Halve 123456.789 0.0001 ', Bits(Halve(123456.789, 0.0001)));
  WriteLn('Halve 0.0 0.0 ', Bits(Halve(0.0, 0.0)));
  WriteLn('Halve -0.0 3.0 ', Bits(Halve((-0.0), 3.0)));
  WriteLn('Halve 2.0 1.0001 ', Bits(Halve(2.0, 1.0001)));
  WriteLn('Halve 10.0 0.5 ', Bits(Halve(10.0, 0.5)));
