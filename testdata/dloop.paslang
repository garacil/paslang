  WriteLn('Logistic 123456.789 0.0001 ', Bits(Logistic(123456.789, 0.0001)));
  WriteLn('Logistic 0.0 0.0 ', Bits(Logistic(0.0, 0.0)));
  WriteLn('Logistic -0.0 3.0 ', Bits(Logistic((-0.0), 3.0)));
  WriteLn('Logistic 2.0 1.0001 ', Bits(Logistic(2.0, 1.0001)));
  WriteLn('Logistic 10.0 0.5 ', Bits(Logistic(10.0, 0.5)));
  WriteLn('Logistic 0.75 -1.5 ', Bits(Logistic(0.75, (-1.5))));
  WriteLn('Mixed 0.5 1.25 ', Bits(Mixed(0.5, 1.25)));
  WriteLn('Mixed 1.0 1.0 ', Bits(Mixed(1.0, 1.0)));
  WriteLn('Mixed 1.5 -0.75 ', Bits(Mixed(1.5, (-0.75))));
  WriteLn('Mixed -2.25 0.5 ', Bits(Mixed((-2.25), 0.5)));
  WriteLn('Mixed 3.1415926 2.7182818 ', Bits(Mixed(3.1415926, 2.7182818)));
  WriteLn('Mixed 0.001 100.0 ', Bits(Mixed(0.001, 100.0)));
  WriteLn('Mixed 123456.789 0.0001 ', Bits(Mixed(123456.789, 0.0001)));
  WriteLn('Mixed 0.0 0.0 ', Bits(Mixed(0.0, 0.0)));
  WriteLn('Mixed -0.0 3.0 ', Bits(Mixed((-0.0), 3.0)));
  WriteLn('Mixed 2.0 1.0001 ', Bits(Mixed(2.0, 1.0001)));
  WriteLn('Mixed 10.0 0.5 ', Bits(Mixed(10.0, 0.5)));
  WriteLn('Mixed 0.75 -1.5 ', Bits(Mixed(0.75, (-1.5))));
