  WriteLn('SumLoop -2.25 0.5 ', Bits(SumLoop((-2.25), 0.5)));
  WriteLn('SumLoop 3.1415926 2.7182818 ', Bits(SumLoop(3.1415926, 2.7182818)));
  WriteLn('SumLoop 0.001 100.0 ', Bits(SumLoop(0.001, 100.0)));
  WriteLn('SumLoop 123456.789 0.0001 ', Bits(SumLoop(123456.789, 0.0001)));
  WriteLn('SumLoop 0.0 0.0 ', Bits(SumLoop(0.0, 0.0)));
  WriteLn('SumLoop -0.0 3.0 ', Bits(SumLoop((-0.0), 3.0)));
  WriteLn('SumLoop 2.0 1.0001 ', Bits(SumLoop(2.0, 1.0001)));
  WriteLn('SumLoop 10.0 0.5 ', Bits(SumLoop(10.0, 0.5)));
  WriteLn('SumLoop 0.75 -1.5 ', Bits(SumLoop(0.75, (-1.5))));
  WriteLn('Newton 0.5 1.25 ', Bits(Newton(0.5, 1.25)));
  WriteLn('Newton 1.0 1.0 ', Bits(Newton(1.0, 1.0)));
  WriteLn('Newton 1.5 -0.75 ', Bits(Newton(1.5, (-0.75))));
  WriteLn('Newton -2.25 0.5 ', Bits(Newton((-2.25), 0.5)));
  WriteLn('Newton 3.1415926 2.7182818 ', Bits(Newton(3.1415926, 2.7182818)));
  WriteLn('Newton 0.001 100.0 ', Bits(Newton(0.001, 100.0)));
  WriteLn('Newton 123456.789 0.0001 ', Bits(Newton(123456.789, 0.0001)));
  WriteLn('Newton 0.0 0.0 ', Bits(Newton(0.0, 0.0)));
  WriteLn('Newton -0.0 3.0 ', Bits(Newton((-0.0), 3.0)));
  WriteLn('Newton 2.0 1.0001 ', Bits(Newton(2.0, 1.0001)));
  WriteLn('Newton 10.0 0.5 ', Bits(Newton(10.0, 0.5)));
  WriteLn('Newton 0.75 -1.5 ', Bits(Newton(0.75, (-1.5))));
  WriteLn('Halve 0.5 1.25 ', Bits(Halve(0.5, 1.25)));
