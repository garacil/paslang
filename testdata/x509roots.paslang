{ P430: the system roots pasx509 loads, printed as
  scripts/x509oracle/rootcheck prints Go's: the count and the SHA-256 of
  each subject in the pool's order. make check compares the two when Go
  is there; the roots are the machine's, so there is no .out. }
program x509roots;

uses
  pasx509;

var
  p: TX509Pool;
  err: string;
  i: Integer;
begin
  p := X509SystemRoots(err);
  if p = nil then
  begin
    WriteLn('error ', err);
    Halt(0);
  end;
  WriteLn('count ', p.Count);
  for i := 0 to p.Count - 1 do
    WriteLn(Hex(Sha256(p.Certs[i].RawSubject)));
end.
