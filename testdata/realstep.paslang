program realstep;

{ Inc and Dec of a real add or take away the step, 1.0 unless one is
  given, an integer step becoming a real (1.0.103; they stepped the
  real's bits). A real where an ordinal goes is an error: testdata/realbad. }

type
  TPoint = record
    X, Y: Double;
  end;

var
  r: Real;
  a: array[0..3] of Real;
  p: TPoint;
  i, n: Integer;

begin
  r := 2.5;
  Inc(r);
  Inc(r, 0.25);
  Dec(r, 2);
  WriteLn(r);
  n := 3;
  for i := 0 to 3 do
    a[i] := i / 2;
  for i := 0 to 3 do
    Inc(a[i], i * n);
  Dec(a[2]);
  WriteLn(a[0], ' ', a[1], ' ', a[2], ' ', a[3]);
  p.X := -1.5;
  p.Y := 0.1;
  Inc(p.X, p.Y);
  Dec(p.Y, 1e-1);
  WriteLn(p.X, ' ', p.Y);
  WriteLn(Trunc(r), ' ', Round(a[3]));
end.

