program recalign;

uses
  paslib;

{ Records at their natural alignment (P99, 1.0.91) keep every pointer on
  a word, so the collector's maps read them as before: strings and
  pointers between one-, two- and four-byte fields survive collections
  in records, arrays of records, classes and the heap. }

type
  PNode = ^TNode;
  TNode = record
    Tag: Byte;
    Name: string;
    Level: Int16;
    Next: PNode;
    Flags: Word;
    Id: Int32;
  end;
  TCell = record
    A: Byte;
    B: Int8;
    Text: string;
    C: Word;
  end;
  TItem = class
    K: Byte;
    Label: string;
    W: Int16;
    Items: array of TCell;
    Z: Int32;
  end;

var
  head, n: PNode;
  cells: array of TCell;
  fixed: array[0..3] of TCell;
  obj: TItem;
  i, j, sum: Integer;
  s: string;

begin
  WriteLn(SizeOf(TNode), ' ', SizeOf(TCell), ' ', Integer(@fixed[1]) - Integer(@fixed[0]));
  head := nil;
  for i := 1 to 2000 do
  begin
    New(n);
    n^.Tag := Byte(i);
    n^.Name := 'node' + IntToStr(i);
    n^.Level := Int16(-i);
    n^.Flags := Word(i * 7);
    n^.Id := Int32(i * 100000);
    n^.Next := head;
    head := n;
    if i mod 100 = 0 then
      GcCollect;
  end;
  SetLength(cells, 0);
  for i := 1 to 3000 do
  begin
    SetLength(cells, i);
    cells[i - 1].A := Byte(i);
    cells[i - 1].B := Int8(-i);
    cells[i - 1].Text := 'cell' + IntToStr(i);
    cells[i - 1].C := Word(i * 3);
    if i mod 250 = 0 then
      GcCollect;
  end;
  for i := 0 to 3 do
  begin
    fixed[i].A := Byte(200 + i);
    fixed[i].Text := 'fixed' + IntToStr(i);
  end;
  obj := TItem.Create;
  obj.K := 7;
  obj.Label := 'item';
  obj.W := -2;
  obj.Z := -99;
  SetLength(obj.Items, 50);
  for i := 0 to 49 do
    obj.Items[i].Text := 'in' + IntToStr(i);
  for j := 1 to 20 do
  begin
    s := '';
    for i := 1 to 200 do
      s := s + 'x';
    GcCollect;
  end;
  sum := 0;
  n := head;
  while n <> nil do
  begin
    sum := sum + n^.Tag + n^.Level + n^.Flags + n^.Id mod 7 + Length(n^.Name);
    n := n^.Next;
  end;
  WriteLn(sum);
  sum := 0;
  for i := 0 to High(cells) do
    sum := sum + cells[i].A + cells[i].B + cells[i].C + Length(cells[i].Text);
  WriteLn(sum, ' ', cells[2999].Text, ' ', cells[0].Text);
  WriteLn(fixed[3].A, ' ', fixed[3].Text, ' ', obj.K, ' ', obj.Label, ' ', obj.W, ' ', obj.Z, ' ',
    obj.Items[49].Text, ' ', head^.Name, ' ', head^.Tag);
end.

