{ P217 (1.1.96): a program keeps the flags of the standard streams it
  was given. It shares their open file descriptions with its shell and
  the programs around it, and before 1.1.96 the runtime set O_NONBLOCK
  on 0, 1 and 2 for good, so a cat writing to the same pipe after it
  stopped with EAGAIN. Go never sets it on them (src/os/file_unix.go
  newFileFromNewFile): a blocking stream blocks in its system call and
  hands the P over, one found nonblocking parks on the poller.
  scripts/check_stdstreams.py runs it on pipes it makes blocking or
  nonblocking, on one CPU and on all, and reads their flags after:

    flags  the flags of 0, 1 and 2 as main found them
    read   a routine reads a line that comes a second late while main
           ticks and collects
    write  a routine writes lines to a standard output nobody reads for
           a second while main ticks and collects; the report goes to
           standard error
    fatal  a nil pointer dereference whose message waits for a full
           standard error without spinning }
program stdflags;

uses
  paslinux;

const
  Ticks = 10;
  Lines = 200;
  Width = 1000;

var
  wg: waitgroup;
  line: string;
  got, written: Integer;
  p: ^Integer;

{ The flags of Fd as fcntl's F_GETFL reads them. }
function Mode(Fd: Integer): string;
var
  flags: Integer;
begin
  if Amd64 = 1 then
    flags := Syscall(72, Fd, 3)
  else
    flags := Syscall(25, Fd, 3);
  if flags < 0 then
    Result := 'closed'
  else if (flags and ONonblock) <> 0 then
    Result := 'nonblocking'
  else
    Result := 'blocking';
end;

function Flags: string;
begin
  Result := 'standard input ' + Mode(0) + ', standard output ' + Mode(1) + ', standard error ' + Mode(2);
end;

procedure Reader;
begin
  ReadLn(line);
  got := Nanotime;
  wg.Done;
end;

procedure Writer;
var
  s: string;
  j: Integer;
begin
  s := StringOfChar('w', Width);
  for j := 1 to Lines do
  begin
    WriteLn(s);
    AtomicAdd(@written, 1);
  end;
  wg.Done;
end;

{ Main goes on while the routine waits: Ticks sleeps and a collection,
  each done before the routine's wait ends. }
function GoOn: Integer;
var
  i: Integer;
begin
  for i := 1 to Ticks do
    Sleep(10);
  GcCollect;
  Result := Nanotime;
end;

procedure ReadLate;
var
  done: Integer;
begin
  WriteLn(Flags);
  wg.Add(1);
  pas Reader;
  done := GoOn;
  wg.Wait;
  WriteLn('read ', line, ', ', Ticks, ' ticks and a collection before it came ', done < got);
end;

{ The writer is still stuck when main has ticked and collected. }
procedure WriteStuck;
var
  at, done: Integer;
begin
  WriteLn(ErrOutput, Flags);
  wg.Add(1);
  pas Writer;
  while AtomicAdd(@written, 0) = 0 do
    Sleep(1);
  done := GoOn;
  at := AtomicAdd(@written, 0);
  wg.Wait;
  WriteLn(ErrOutput, Ticks, ' ticks and a collection while the writer was stuck ', at < Lines, ', ',
    AtomicAdd(@written, 0), ' lines written');
end;

begin
  if ParamStr(1) = 'read' then
    ReadLate
  else if ParamStr(1) = 'write' then
    WriteStuck
  else if ParamStr(1) = 'fatal' then
  begin
    WriteLn(Flags);
    p := nil;
    p^ := 7;
  end
  else
    WriteLn(Flags);
end.

