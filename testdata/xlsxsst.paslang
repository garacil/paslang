{ P454: pasxlsx writes shared strings. testdata/xlsxtpl.txt's tpl1 has a table
  (nine references to seven items: plain texts, one with runs, one with a
  phonetic run) and tpl2 has none and writes its text inline. SetSharedText
  and the book's TextAsShared put a text at the end of the table as
  <si><t xml:space="preserve">text</t></si> (an item with the same text that
  is a plain one is used again, the one with runs and the one with a phonetic
  run are not), keep the indices of the items that are there, and leave count
  and uniqueCount exact (the cells that are shared strings are counted again
  when the book is saved, a sheet that was not read from its text); a book with no table gets the part, its
  relationship and its content type. CopyRowAttrs gives a row the height and
  the style of another. Then 2,000 references to 500 texts. With the
  argument dump the books are written as `NAME BASE64` for
  scripts/xlsx_sst_verify.py (openpyxl and LibreOffice). }
program xlsxsst;

uses
  sysutils, pascodec, pasflate, paszip, pasxml, pasxlsx;

var
  Dump: Boolean;

procedure Say(const S: string);
begin
  if not Dump then
    WriteLn(S);
end;

function Template(const Name: string): string;
var
  corpus, line: string;
  p, nl, q: Integer;
begin
  Result := '';
  if not ReadFile('testdata/xlsxtpl.txt', corpus) then
  begin
    WriteLn('no testdata/xlsxtpl.txt');
    Halt(2);
  end;
  p := 1;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    q := Pos(' ', line);
    if Copy(line, 1, q - 1) = Name then
    begin
      if not Base64Decode(Copy(line, q + 1, Length(line)), False, True, Result) then
      begin
        WriteLn('bad base64');
        Halt(2);
      end;
      Exit;
    end;
  end;
  WriteLn('no template ', Name);
  Halt(2);
end;

function Quote(const S: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
    if S[i] = #10 then
      Result := Result + '\n'
    else
      Result := Result + S[i];
end;

procedure Compare(const OldData, NewData: string; const Changed: array of string);
var
  a, b: TZipReader;
  i, j, k, kept, gone: Integer;
  ea, eb: TZipEntry;
  isChanged: Boolean;
begin
  a := TZipReader.Create(OldData);
  b := TZipReader.Create(NewData);
  kept := 0;
  gone := 0;
  for i := 0 to a.Count - 1 do
  begin
    ea := a.Entry(i);
    isChanged := False;
    for k := 0 to High(Changed) do
      if Changed[k] = ea.Name then
        isChanged := True;
    j := b.Find(ea.Name);
    if j < 0 then
    begin
      Say('  gone: ' + ea.Name);
      gone := gone + 1;
      Continue;
    end;
    eb := b.Entry(j);
    if isChanged then
    begin
      if (eb.DosDate <> ea.DosDate) or (eb.DosTime <> ea.DosTime) or (eb.ExternalAttr <> ea.ExternalAttr) or (j <> i - gone) then
        Say('  CHANGED ENTRY LOST ITS TIMES, ATTRIBUTES OR PLACE: ' + ea.Name);
      Say('  rewritten: ' + ea.Name);
      Continue;
    end;
    if (b.Raw(j) <> a.Raw(i)) or (eb.Crc <> ea.Crc) or (eb.Method <> ea.Method) or (eb.DosDate <> ea.DosDate) or
      (eb.DosTime <> ea.DosTime) or (eb.ExternalAttr <> ea.ExternalAttr) or (eb.Flags <> ea.Flags) or (j <> i - gone) then
      Say('  NOT AS IT WAS: ' + ea.Name)
    else
      kept := kept + 1;
  end;
  Say('  kept as they were: ' + IntToStr(kept) + ', gone: ' + IntToStr(gone) + ', now ' + IntToStr(b.Count));
end;

procedure PartOf(const Data, Name: string);
var
  b: TXlsxBook;
begin
  b := TXlsxBook.Open(Data);
  Say('--- ' + Name);
  Say(b.ReadPart(Name));
end;

{ the start tags of the rows of a sheet part }
procedure RowTags(const Data, Name: string);
var
  b: TXlsxBook;
  x: string;
  p, q: Integer;
begin
  b := TXlsxBook.Open(Data);
  x := b.ReadPart(Name);
  Say('--- rows of ' + Name);
  p := Pos('<row ', x);
  while p > 0 do
  begin
    q := p;
    while (q <= Length(x)) and (x[q] <> '>') do
      q := q + 1;
    Say(Copy(x, p, q - p + 1));
    x := Copy(x, q + 1, Length(x));
    p := Pos('<row ', x);
  end;
end;

procedure Show(Sh: TXlsxSheet; const Ref: string);
begin
  if Sh.HasCell(Ref) then
    Say('  ' + Ref + ' type ' + Sh.CellType(Ref) + ' style ' + IntToStr(Sh.StyleOf(Ref)) + ' [' + Quote(Sh.GetText(Ref)) + ']')
  else
    Say('  ' + Ref + ' none');
end;

procedure Emit(const Name, Data: string);
begin
  if Dump then
    WriteLn(Name, ' ', Base64Encode(Data, False, True));
end;

var
  src, out1, out2, out3, out4, out5: string;
  b, b2: TXlsxBook;
  s, s2: TXlsxSheet;
  i: Integer;
  ok: Boolean;
begin
  Dump := (ParamCount > 0) and (ParamStr(1) = 'dump');
  { the book with a table }
  src := Template('tpl1');
  b := TXlsxBook.Open(src);
  s := b.Sheet(0);
  Say('tpl1: ' + IntToStr(b.SharedCount) + ' shared strings, sheet ' + s.Name);
  s.SetSharedText('G1', 'Nombre');
  s.SetSharedText('G2', 'Total general');
  s.SetSharedText('G3', 'Ana & Luis');
  s.SetSharedText('G4', #230 + #188 + #162 + #229 + #173 + #151);
  s.SetSharedText('G5', '  con espacios  ');
  s.SetSharedText('G6', 'nuevo <b> & "q" ' + #10 + 'l' + #195 + #173 + 'nea');
  s.SetSharedText('G7', #195 + #145 + 'and' + #195 + #186 + ' ' + #194 + #186);
  s.SetSharedText('G8', '');
  s.SetSharedText('G6', 'nuevo <b> & "q" ' + #10 + 'l' + #195 + #173 + 'nea');
  { a shared string written over gives its unit back }
  s.SetNumber('A1', '5');
  s.Blank('B1');
  s.SetText('C1', 'inline now');
  { a cell that was not one takes a unit, and keeps its style }
  s.SetSharedText('A2', 'Nombre');
  b.TextAsShared := True;
  s.SetText('H1', 'via the option');
  s.SetText('H2', 'via the option');
  b.TextAsShared := False;
  s.SetText('H3', 'inline again');
  for i := 1 to 3 do
    Show(s, 'G' + IntToStr(i));
  Show(s, 'A1');
  Show(s, 'B1');
  Show(s, 'C1');
  Show(s, 'A2');
  Show(s, 'H1');
  Show(s, 'H2');
  Show(s, 'H3');
  out1 := b.Save;
  PartOf(out1, 'xl/sharedStrings.xml');
  Compare(src, out1, ['xl/sharedStrings.xml', 'xl/worksheets/sheet1.xml']);
  b2 := TXlsxBook.Open(out1);
  s2 := b2.Sheet(0);
  Say('reopened: ' + IntToStr(b2.SharedCount) + ' shared strings');
  for i := 1 to 8 do
    Show(s2, 'G' + IntToStr(i));
  Show(s2, 'A2');
  Show(s2, 'H2');
  { saved again with nothing new: the same table }
  Say('saved twice the same: ' + BoolToStr(b.Save = out1, True));
  Emit('sst1', out1);
  { the book with no table }
  src := Template('tpl2');
  b := TXlsxBook.Open(src);
  Say('tpl2: ' + IntToStr(b.SharedCount) + ' shared strings');
  s := b.Sheet(0);
  s.SetSharedText('A1', 'uno');
  s.SetSharedText('B1', 'dos');
  s.SetSharedText('C1', 'uno');
  s.SetSharedText('D1', 'tres' + #38);
  out2 := b.Save;
  Compare(src, out2, ['[Content_Types].xml', 'xl/_rels/workbook.xml.rels', 'xl/worksheets/hoja.xml']);
  PartOf(out2, 'xl/sharedStrings.xml');
  PartOf(out2, 'xl/_rels/workbook.xml.rels');
  PartOf(out2, '[Content_Types].xml');
  b2 := TXlsxBook.Open(out2);
  s2 := b2.Sheet(0);
  Say('reopened: ' + IntToStr(b2.SharedCount) + ' shared strings');
  Show(s2, 'A1');
  Show(s2, 'B1');
  Show(s2, 'C1');
  Show(s2, 'D1');
  Emit('sst2', out2);
  { a sheet that was not read is counted from its text }
  b := TXlsxBook.Open(Template('tpl1'));
  b.Sheet(1).SetSharedText('B1', 'solo en la otra hoja');
  out5 := b.Save;
  b2 := TXlsxBook.Open(out5);
  s2 := b2.Sheet(1);
  Say('other sheet only: ' + IntToStr(b2.SharedCount) + ' items');
  Show(s2, 'B1');
  Say(Copy(b2.ReadPart('xl/sharedStrings.xml'), 1, 130));
  Emit('sst5', out5);
  { the attributes of a row }
  b := TXlsxBook.Open(Template('tpl1'));
  s := b.Sheet(0);
  ok := s.CopyRowAttrs(4, 9);
  Say('copy 4 to 9 (a new row): ' + BoolToStr(ok, True));
  ok := s.CopyRowAttrs(4, 2);
  Say('copy 4 to 2: ' + BoolToStr(ok, True));
  ok := s.CopyRowAttrs(1, 4);
  Say('copy 1 to 4 (a row with none takes them off): ' + BoolToStr(ok, True));
  ok := s.CopyRowAttrs(50, 3);
  Say('copy 50 to 3 (no such row): ' + BoolToStr(ok, True));
  out3 := b.Save;
  RowTags(out3, 'xl/worksheets/sheet1.xml');
  Emit('sst3', out3);
  { 2,000 references to 500 texts }
  b := TXlsxBook.Open(Template('tpl2'));
  s := b.Sheet(0);
  for i := 1 to 2000 do
    s.SetSharedText('A' + IntToStr(i + 5), 'texto ' + IntToStr(i mod 500) + ' de la tabla');
  out4 := b.Save;
  b2 := TXlsxBook.Open(out4);
  s2 := b2.Sheet(0);
  Say('volume: ' + IntToStr(b2.SharedCount) + ' items');
  Say(Copy(b2.ReadPart('xl/sharedStrings.xml'), 1, 200));
  Show(s2, 'A6');
  Show(s2, 'A506');
  Show(s2, 'A2005');
  Emit('sst4', out4);
end.
