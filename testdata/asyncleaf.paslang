{ P342: a leaf, a routine that calls nothing, has no stack check of its
  own and a frame of up to 256 bytes. Spin loops in one with Double and
  V256 values in vector registers while the main routine makes garbage:
  every cycle of the collector stops it there by a signal, which takes
  144 bytes under its stack pointer (368 on arm64; its vector registers
  go to a block of their own, as Go keeps them off the goroutine's
  stack) within what its caller's check left, and they come back as
  they were. Each of 16 routines calls Spin from a depth of its own in
  a chain of Down, so that for some the leaf sits within a few words of
  the least room the checks leave: with the vector registers on the
  stack the stop did not fit there, and the cycle waited for ever. }
program asyncleaf;

uses sysutils;

const
  NWalk = 16;

var
  done: Integer;
  started: array[0..15] of Integer;
  res: chan of Integer;

function Spin(seed: Integer): Integer;
var
  w: array[0..15] of Integer;
  i, k: Integer;
  a, b: Double;
  acc: V256;
begin
  for i := 0 to 15 do
    w[i] := seed + i;
  a := 0.0;
  b := 1000000000.0;
  acc := VSplat64(0);
  k := 0;
  started[seed and 15] := 1;
  repeat
    w[k and 15] := w[k and 15] + 1;
    a := a + 1.0;
    b := b - 1.0;
    acc := VAdd64(acc, VSplat64(1));
    k := k + 1;
  until done <> 0;
  Result := 0;
  for i := 0 to 15 do
    Result := Result + w[i];
  if (a <> k) or (a + b <> 1000000000.0) or (VSum64(acc) <> 4 * k) or
    (Result <> 16 * seed + 120 + k) then
    Result := -1
  else
    Result := 1;
end;

function Down(d, seed: Integer): Integer;
begin
  if d = 0 then
    Result := Spin(seed)
  else
    Result := Down(d - 1, seed);
end;

procedure Walker(d: Integer);
begin
  Send(res, Down(d, d + 16));
end;

var
  i, k, ok: Integer;
  junk: array of Integer;
  t: string;

begin
  done := 0;
  res := MakeChan();
  for i := 0 to NWalk - 1 do
    pas Walker(i);
  { every Spin in its loop, which only a signal stops }
  repeat
    Sleep(1);
    ok := 0;
    for i := 0 to NWalk - 1 do
      ok := ok + started[i];
  until ok = NWalk;
  for i := 1 to 300 do
  begin
    SetLength(junk, 0);
    SetLength(junk, 200);
    for k := 0 to 199 do
      junk[k] := i + k;
    t := IntToStr(i) + IntToStr(junk[7]);
  end;
  done := 1;
  ok := 0;
  for i := 1 to NWalk do
    if Recv(res) = 1 then
      ok := ok + 1;
  if ok = NWalk then
    WriteLn('Spin stopped in its leaf at every depth, its vector registers kept')
  else
    WriteLn(NWalk - ok, ' of ', NWalk, ' lost a register');
end.
