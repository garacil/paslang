{ P206: what JsonDecode refuses, each error with its kind, the JSON
  Pointer of the value and, from text, its line, column and byte: a
  kind the type does not take, an integer that is no integer literal or
  is past its type's range, a real past its own, Currency with a fifth
  place, a Char of more than one byte, an enumeration's unknown name,
  a set's member twice, a static array of another length, bytes that
  are not base64, RFC 3339 that is not, a map's key that is not its
  type's, an unknown member with RejectUnknown, a required one missing,
  json quoted given a number; a parse's own error; nothing changed by
  a decode that fails. A list 5000 deep decoded in a new routine, whose
  stack grows, and one document decoded by 16 routines at once. }
program jsonbind3;

uses
  sysutils;

type
  TColor = (Red, Green, Blue);
  TColors = set of TColor;

  PNode = ^TNode;
  TNode = record
    V: Integer json 'v';
    Next: PNode json 'next' omitempty;
  end;

  TPoint = record
    X, Y: Integer;
  end;

  TRec = record
    I: Integer;
    B: Byte;
    S: Single;
    D: Double;
    Q: Quad;
    C: Currency;
    Ch: Char;
    Col: TColor;
    Cols: TColors;
    Fix: array[0..1] of Integer;
    Raw: array of Byte;
    Four: array[0..3] of Byte;
    When: TDateTime json rfc3339;
    MI: map[Integer] of Integer;
    ME: map[TColor] of Integer;
    MB: map[Boolean] of Integer;
    MC: map[Char] of Integer;
    P: TPoint;
    Name: string;
    Big: Integer json quoted;
  end;

  TNeed = record
    A: Integer json 'a' required;
    B: TPoint json 'b' required;
  end;

  TOpen = record
    X: Integer;
    Rest: json json unknown;
  end;

var
  r, r0: TRec;
  need: TNeed;
  op: TOpen;
  opts: TJsonOptions;
  n: TNode;
  pts: array of TPoint;
  wg: waitgroup;
  res: array[0..15] of Integer;
  doc: json;
  i, deepRes: Integer;

procedure Check(const S: string);
var
  e: EJsonError;
begin
  r := r0;
  if TryJsonDecode(S, r, e) then
    WriteLn('ok')
  else
  begin
    WriteLn(e.Message, ' | ', Ord(e.Kind), ' ', e.Offset, ' ', e.Line, ':', e.Column, ' ', e.Path);
    if JsonEncode(r) <> JsonEncode(r0) then
      WriteLn('changed!');
  end;
end;

procedure Deep(N: Integer; var Res: Integer);
var
  s: string;
  i: Integer;
  m: TNode;
  p: PNode;
begin
  s := '';
  for i := 1 to N do
    s := s + '{"v":' + IntToStr(i) + ',"next":';
  s := s + 'null';
  for i := 1 to N do
    s := s + '}';
  JsonDecode(s, m);
  Res := 0;
  p := @m;
  while p <> nil do
  begin
    Res := Res + 1;
    p := p^.Next;
  end;
  if JsonEncode(m) <> Copy(s, 1, Length(s) - N - 12) + StringOfChar('}', N) then
    Res := -Res;
end;

procedure DeepDone;
begin
  Deep(5000, deepRes);
  wg.Done;
end;

procedure Many(K: Integer);
var
  t: array of TPoint;
  i, sum: Integer;
begin
  for i := 1 to 50 do
  begin
    t := nil;
    JsonDecode(doc, t);
  end;
  sum := 0;
  for i := 0 to High(t) do
    sum := sum + t[i].X + t[i].Y;
  res[K] := sum;
  wg.Done;
end;

begin
  r0.I := 1;
  r0.Name := 'kept';
  Check('{"I": "1"}');
  Check('{"I": 1.0}');
  Check('{"I": 1e2}');
  Check('{"I": 99999999999999999999}');
  Check('{"B": -1}');
  Check('{"B": 256}');
  Check('{"S": 1e39}');
  Check('{"D": 1e400}');
  Check('{"Q": 1e5000}');
  Check('{"C": 1.23456}');
  Check('{"C": 1e15}');
  Check('{"Ch": "ab"}');
  Check('{"Ch": "é"}');
  Check('{"Col": "Purple"}');
  Check('{"Col": 1}');
  Check('{"Cols": ["Red", "Red"]}');
  Check('{"Cols": [null]}');
  Check('{"Fix": [1, 2, 3]}');
  Check('{"Raw": "aGk"}');
  Check('{"Raw": "aG=k"}');
  Check('{"Raw": "aGk=\n"}');
  Check('{"Four": "aGk="}');
  Check('{"When": "2023-02-29T00:00:00Z"}');
  Check('{"When": "2026-10-14 13:05:09Z"}');
  Check('{"When": "2026-10-14T13:05:09"}');
  Check('{"When": "2026-10-14T24:00:00Z"}');
  Check('{"When": "2026-10-14T23:59:60Z"}');
  Check('{"When": "2026-10-14t13:05:09z"}');
  Check('{"When": "2026-10-14T13:05:09.Z"}');
  Check('{"When": "2026-10-14T13:05:09+24:00"}');
  Check('{"When": "0000-12-31T23:59:59Z"}');
  Check('{"When": "9999-12-31T23:59:59-01:00"}');
  Check('{"When": 0}');
  Check('{"MI": {"01": 1}}');
  Check('{"MI": {"-0": 1}}');
  Check('{"MI": {"1.5": 1}}');
  Check('{"MI": {"99999999999999999999": 1}}');
  Check('{"ME": {"Pink": 1}}');
  Check('{"MB": {"yes": 1}}');
  Check('{"MC": {"xy": 1}}');
  Check('{"P": [1, 2]}');
  Check('{"P": {"X": true}}');
  Check('{"Name": 5}');
  Check('{"Big": 5}');
  Check('{"Big": "5 "}');
  Check('{"Big": "0x10"}');
  Check('{"Big": "-0"}');
  Check('[]');
  Check('{"I": 1,}');
  Check('{"I": 1, "I": 2}');
  Check('{' + #10 + '  "P": {' + #10 + '    "Y": "deep"}}');

  { RejectUnknown, unless json unknown takes them; required }
  opts := JsonDefaults;
  opts.RejectUnknown := True;
  JsonDecode('{"I": 1, "Other": 2}', r);
  WriteLn(r.I);
  try
    JsonDecode('{"P": {"X": 1, "Z": 2}}', r, opts);
  except
    on e: EJsonError do
      WriteLn(e.Message, ' | ', Ord(e.Kind), ' ', e.Path);
  end;
  JsonDecode('{"X": 1, "Z": 2}', op, opts);
  WriteLn(op.X, ' ', op.Rest);
  JsonDecode('{"a": 1, "b": {}}', need);
  WriteLn(need.A);
  try
    JsonDecode('{"a": 1}', need);
  except
    on e: EJsonError do
      WriteLn(e.Message, ' | ', Ord(e.Kind), ' ', e.Path, ' ', need.A);
  end;
  try
    JsonDecode(JsonParse('{"a": 1, "b": {"X": "1"}}'), need);
  except
    on e: EJsonError do
      WriteLn(e.Message, ' | ', e.Offset, ' ', e.Line, ' ', e.Path);
  end;
  { Merge checks it all before it writes }
  opts := JsonDefaults;
  opts.Merge := True;
  r := r0;
  try
    JsonDecode('{"Name": "new", "I": 5, "B": 999}', r, opts);
  except
    on e: EJsonError do
      WriteLn(e.Message, ' | ', r.Name, ' ', r.I);
  end;

  { a list 5000 deep in a new routine, one document read by 16 at once }
  wg.Add(1);
  pas DeepDone;
  wg.Wait;
  WriteLn(deepRes);
  doc := JsonParse('[{"X": 1, "Y": 2}, {"X": 3, "Y": 4}, {"X": 5}]');
  for i := 0 to 15 do
  begin
    wg.Add(1);
    pas Many(i);
  end;
  wg.Wait;
  for i := 0 to 15 do
    Write(res[i], ' ');
  WriteLn;
end.

