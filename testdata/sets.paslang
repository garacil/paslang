program sets;

type
  TColor = (Red, Green, Blue);
  TColorSet = set of TColor;

var
  s, t, u: TColorSet;
  c: TColor;
  n: Integer;

begin
  s := [Red, Blue];
  t := [Green, Blue];
  u := s + t;
  n := 0;
  if Red in u then
    n := n + 1;
  if Green in u then
    n := n + 2;
  if Blue in u then
    n := n + 4;
  WriteLn(n);
  u := s * t;
  n := 0;
  if Red in u then
    n := n + 1;
  if Green in u then
    n := n + 2;
  if Blue in u then
    n := n + 4;
  WriteLn(n);
  u := s - t;
  n := 0;
  if Red in u then
    n := n + 1;
  if Green in u then
    n := n + 2;
  if Blue in u then
    n := n + 4;
  WriteLn(n);
  n := 0;
  for c in s do
    n := n + 1;
  WriteLn(n);
  u := [Red..Blue];
  n := 0;
  if Red in u then
    n := n + 1;
  if Green in u then
    n := n + 2;
  if Blue in u then
    n := n + 4;
  WriteLn(n);
end.
