{ Val into a Single and into a Quad rounds once from the digits (P146),
  as Go's ParseFloat and paslang's literals do. Free Pascal reads an
  Extended and rounds that again to a Single, so for the first line,
  just below the midpoint of two Singles, it gives 1.000000238419; the
  once-rounded value is 1.000000119209. A Quad kept 53 bits through a
  Double; it keeps its 113. }
program valround2;
var
  s: Single;
  d: Double;
  q, r: Quad;
  code: Int64;
begin
  Val('1.00000017881393432617187499', s, code);
  d := s;
  WriteLn(d:0:12, ' ', code);
  Val('1.00000017881393432617187501', s, code);
  d := s;
  WriteLn(d:0:12, ' ', code);
  s := 1.00000017881393432617187499;
  d := s;
  WriteLn(d:0:12);
  Val('3.14159265358979323846264338327950288', q, code);
  r := 3.14159265358979323846264338327950288;
  WriteLn(q:0:33, ' ', code, ' ', Ord(q = r));
  Val('0.1', q, code);
  WriteLn(q:0:36, ' ', code);
  Val('12x', q, code);
  WriteLn(code);
end.

