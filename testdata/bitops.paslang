program bitops;

{ P105 (1.0.116): nand, nor, xnor, andnot, sar, rol and ror in every
  width, on Booleans where they are logical, and every operator as a
  compound assignment. Each line is worked out at run time (variables)
  and at compile time (constants), and both must agree. }

var
  i, j, n: Integer;
  b: Byte;
  s8: Int8;
  w: Word;
  s16: Int16;
  u32: UInt32;
  s32: Int32;
  t, f: Boolean;
  str: string;
  d: Double;
  q: Quad;
  c: Char;
  pt: record X, Y: Int32; Z: Byte end;

{ The same operations in a call-free loop, where the pool keeps the
  variables in registers; counts run from negative to past every width. }
procedure Pool;
var
  k, x, n: Integer;
  b: Byte;
  w: Word;
  u32: UInt32;
  s32: Int32;
  s8: Int8;
begin
  k := 0;
  x := $0123456789ABCDEF;
  b := $C8;
  w := $8421;
  u32 := $80000001;
  s32 := -3;
  for n := -3 to 70 do
  begin
    k := k * 31 + (x rol n);
    k := k * 31 + (x ror n);
    k := k * 31 + (x sar n);
    k := k * 31 + (x rol 13) + (x ror 3) + (x sar 5);
    b := b rol n;
    k := k * 31 + b;
    w := w ror n;
    k := k * 31 + w;
    u32 := u32 rol n;
    k := k * 31 + u32;
    s32 := s32 ror n;
    k := k * 31 + s32;
    s8 := Int8(k) sar 2;
    k := k * 31 + s8;
    k := k * 31 + (x nand n) + (x nor n) + (x xnor n) + (x andnot n);
    b := b sar 1;
    k := k * 31 + b;
    s8 := (s8 + 100) sar 2;
    k := k * 31 + s8;
    k := k * 31 + (b rol 3) + (w ror 5) + (u32 sar 7) + (s32 rol 9);
  end;
  WriteLn(k, ' ', b, ' ', w, ' ', u32, ' ', s32);
end;

begin
  i := $F0F0;
  j := $FF00;
  WriteLn(i nand j, ' ', i nor j, ' ', i xnor j, ' ', i andnot j);
  WriteLn($F0F0 nand $FF00, ' ', $F0F0 nor $FF00, ' ', $F0F0 xnor $FF00, ' ', $F0F0 andnot $FF00);
  i := -40;
  n := 3;
  WriteLn(i sar n, ' ', i shr 60, ' ', -40 sar 3);
  i := $123456789ABCDEF0;
  for n := 0 to 3 do
    Write(i rol (n * 20), ' ', i ror (n * 20), ' ');
  WriteLn;
  WriteLn($123456789ABCDEF0 rol 4, ' ', $123456789ABCDEF0 ror 68);
  b := $C8;
  n := 1;
  WriteLn(b sar n, ' ', b sar 3, ' ', b sar 9, ' ', b rol n, ' ', b ror n, ' ', b rol 11, ' ', b ror 8);
  WriteLn(Byte($C8) rol 1, ' ', Byte($C8) ror 1);
  s8 := -56;
  WriteLn(s8 sar 2, ' ', s8 rol 1, ' ', s8 ror 1, ' ', s8 rol 4);
  w := $8421;
  WriteLn(w rol 4, ' ', w ror 4, ' ', w sar 4, ' ', w rol 20);
  s16 := -2;
  WriteLn(s16 rol 1, ' ', s16 ror 1, ' ', s16 sar 15);
  u32 := $80000001;
  WriteLn(u32 rol 1, ' ', u32 ror 1, ' ', u32 sar 1);
  s32 := -3;
  WriteLn(s32 rol 1, ' ', s32 ror 1, ' ', s32 sar 1);
  WriteLn(b nand $0F, ' ', b nor $0F, ' ', b xnor $0F, ' ', b andnot $0F);
  for n := 0 to 3 do
  begin
    t := (n and 2) <> 0;
    f := (n and 1) <> 0;
    Write(Ord(t nand f), Ord(t nor f), Ord(t xnor f), Ord(t andnot f), ' ');
  end;
  WriteLn;
  t := True;
  f := False;
  WriteLn(Ord(not t), ' ', Ord(not f), ' ', Ord(not (t and f)), ' ', Ord(t xor f));
  WriteLn(1 or 2 and 3, ' ', 6 xor 3 nand 5, ' ', 12 nor 3 xnor 1, ' ', 1 shl 4 rol 60);
  i := 10;
  i += 5;
  i -= 2;
  i *= 3;
  i div= 2;
  i mod= 7;
  Write(i, ' ');
  i := $F0;
  i and= $3C;
  i or= $101;
  i xor= $FF;
  i shl= 4;
  i shr= 2;
  Write(i, ' ');
  i := -64;
  i sar= 2;
  i rol= 60;
  i ror= 60;
  i nand= 7;
  i nor= 8;
  i xnor= 9;
  i andnot= 1;
  WriteLn(i);
  b := 200;
  b += 100;
  b rol= 1;
  WriteLn(b);
  str := 'pas';
  str += 'lang';
  d := 10;
  d /= 4;
  q := Quad(1) / 3;
  q *= 3;
  WriteLn(str, ' ', d, ' ', q:0:34);
  { Counts past the width and below zero: sar counts modulo 64 and fills
    with the top bit of the width, a rotation counts modulo its width. }
  b := $C8;
  n := 9;
  WriteLn(b sar n, ' ', b rol n, ' ', b ror n);
  n := 64;
  i := -40;
  WriteLn(i sar n, ' ', i rol n, ' ', b sar n, ' ', b rol n);
  n := -1;
  WriteLn(i sar n, ' ', i rol n, ' ', i ror n, ' ', b sar n, ' ', b rol n, ' ', b ror n);
  { The indicated type gives the width, as for b + 1: i := b rol 1 turns
    64 bits; Byte(b rol 1) turns the byte. }
  i := b rol 1;
  WriteLn(i, ' ', Integer(b rol 1), ' ', b rol 1, ' ', Byte(b rol 1), ' ', Integer(b shl 1));
  { A Boolean in arithmetic is its Ord, as a Char is its code (and, or
    and xor take two Booleans or two integers); an integer becomes a
    Boolean through Boolean(x), which is x <> 0. }
  t := True;
  f := False;
  i := 5;
  c := 'a';
  WriteLn(Integer(not t), ' ', Byte(not f), ' ', Ord(t nand f), ' ', t + 1, ' ', Ord(t) nor 1, ' ', -t, ' ', i and Ord(t));
  WriteLn(Boolean(i), ' ', Boolean(0), ' ', Boolean(i - 5), ' ', Boolean(@i), ' ', Boolean(c), ' ', Boolean(#0));
  t := Boolean(i) and not Boolean(i - 5);
  WriteLn(t, ' ', Ord(t), ' ', t = True);
  { A signed operand that wrapped is clean before sar looks at it. }
  s8 := 100;
  s16 := 30000;
  s32 := 2000000000;
  n := 1;
  WriteLn((s8 + 100) sar 2, ' ', Int8(s8 * 3) sar 1, ' ', (s8 + s8) sar n, ' ',
    (s16 + s16) sar 3, ' ', (s32 + s32) sar n);
  { A record with no name. }
  pt.X := 3;
  pt.Y := 4;
  pt.Z := 250;
  pt.Z += 10;
  WriteLn(pt.X * pt.Y, ' ', pt.Z, ' ', SizeOf(pt));
  Pool;
end.
