{ P203: RFC 8785's canonical form (JCS) through JsonEncode with
  JsonCanonical: the sample of section 3.2.2 to the text of section
  3.2.3, the names of section 3.2.3 in the order of their UTF-16 code
  units, and the numbers of Appendix B written as ECMAScript writes
  them; with JsonPretty and EscapeHtml as Go's encoder writes them. }
program jsoncanon;

var
  d: json;
  o: TJsonOptions;
  k: string;
  v: json;

begin
  d := JsonParse('{' + #10 +
    '  "numbers": [333333333.33333329, 1E30, 4.50,' + #10 +
    '              2e-3, 0.000000000000000000000000001],' + #10 +
    '  "string": "\u20ac$\u000F\u000aA''\u0042\u0022\u005c\\\"\/",' + #10 +
    '  "literals": [null, true, false]' + #10 + '}');
  WriteLn(JsonEncode(d, JsonCanonical));
  d := JsonParse('{"\u20ac": "Euro Sign", "\r": "Carriage Return", ' +
    '"\ufb33": "Hebrew Letter Dalet With Dagesh", "1": "One", ' +
    '"\ud83d\ude00": "Emoji: Grinning Face", "\u0080": "Control", ' +
    '"\u00f6": "Latin Small Letter O With Diaeresis"}');
  d := JsonParse(JsonEncode(d, JsonCanonical));
  for k, v in d do
    WriteLn(v.AsString);
  { Appendix B, each Double by its bits through its shortest text }
  d := JsonParse('[0, -0, 5e-324, -5e-324, 1.7976931348623157e308, -1.7976931348623157e308,' +
    ' 9007199254740992, -9007199254740992, 295147905179352825856, 9.999999999999997e22,' +
    ' 1e23, 1.0000000000000001e23, 999999999999999700000, 999999999999999900000, 1e21,' +
    ' 9.999999999999997e-7, 0.000001, 333333333.3333332, 333333333.33333325,' +
    ' 333333333.3333333, 333333333.3333334, 333333333.33333343, -0.0000033333333333333333,' +
    ' 1424953923781206.25]');
  for v in d do
    WriteLn(JsonEncode(v, JsonCanonical));
  d := JsonParse('{"b":[],"a":{"z":"<tag>&","y":[1,{"x":null}]},"c":{}}');
  WriteLn(JsonEncode(d, JsonPretty));
  o := JsonDefaults;
  o.EscapeHtml := True;
  WriteLn(JsonEncode(d, o));
  o.Indent := #9;
  WriteLn(JsonEncode(d, o));
end.
