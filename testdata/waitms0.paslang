{ P213 (1.1.98): WaitMs with no time left answers 0 at once, the
  answer of a deadline that came, on both machines. Before, rt_waitms
  returned at once without setting its answer: amd64 gave back the ms
  it was given (-7 for -7, which reads as an errno) and arm64 the
  descriptor. Each line is the answer and whether the wait took the
  time it should: none for 0 ms and less, at least the ms on an empty
  pipe or socket, none with a byte waiting whatever the ms, until the
  byte comes when it comes later. Main runs the cases, then a routine
  while main ticks. The byte that comes later is timed from before the
  routine that writes it is spawned (P200): that routine may begin its
  20 ms before the waiter reads the clock, as a Go routine may run on
  another P before its spawner goes on, and under qemu it did, 1 to 2 ms
  before, so the wait measured from the waiter took 18 ms. }
program waitms0;

uses
  paslinux, pasnet;

var
  wg: waitgroup;
  ticks, done: Integer;

{ The answer of WaitMs and whether it took Least ms or more from T0,
  and less than a second. }
procedure ProbeFrom(const What: string; Fd, Ev, Ms, Least, T0: Integer);
var
  took, r: Integer;
begin
  r := WaitMs(Fd, Ev, Ms);
  took := (Nanotime - T0) div 1000000;
  WriteLn('  ', What, ': ', r, ', ', (took >= Least) and (took < 1000));
end;

procedure Probe(const What: string; Fd, Ev, Ms, Least: Integer);
begin
  ProbeFrom(What, Fd, Ev, Ms, Least, Nanotime);
end;

procedure Late(Fd: Integer);
var
  one: Byte;
begin
  Sleep(20);
  one := 7;
  if OsWrite(Fd, Integer(@one), 1) <> 1 then
    Halt(3);
  wg.Done;
end;

procedure Cases(const Where: string);
var
  fds: array[0..1] of Int32;
  a, b, t0: Integer;
  one: Byte;
begin
  WriteLn(Where);
  if OsPipe(Integer(@fds[0])) <> 0 then
    Halt(1);
  Probe('pipe, 0 ms', fds[0], 1, 0, 0);
  Probe('pipe, -7 ms', fds[0], 1, -7, 0);
  Probe('pipe, the lowest ms', fds[0], 1, Low(Integer), 0);
  Probe('pipe, 5 ms with nothing to read', fds[0], 1, 5, 5);
  Probe('pipe, 0 ms to write', fds[1], 4, 0, 0);
  one := 1;
  if OsWrite(fds[1], Integer(@one), 1) <> 1 then
    Halt(2);
  Probe('pipe, the highest ms with a byte to read', fds[0], 1, High(Integer), 0);
  if OsRead(fds[0], Integer(@one), 1) <> 1 then
    Halt(4);
  t0 := Nanotime;
  wg.Add(1);
  pas Late(fds[1]);
  ProbeFrom('pipe, the highest ms with a byte 20 ms later', fds[0], 1, High(Integer), 20, t0);
  wg.Wait;
  NetClose(fds[0]);
  NetClose(fds[1]);
  if not UnixPair(a, b) then
    Halt(5);
  Probe('socket, 0 ms', a, 1, 0, 0);
  Probe('socket, -1 ms', a, 1, -1, 0);
  Probe('socket, 5 ms with nothing to read', a, 1, 5, 5);
  Probe('socket, 0 ms to write', b, 4, 0, 0);
  UnixClose(a);
  UnixClose(b);
end;

procedure InRoutine;
begin
  Cases('in a routine');
  AtomicAdd(@done, 1);
end;

begin
  Cases('in main');
  pas InRoutine;
  while AtomicAdd(@done, 0) = 0 do
  begin
    Sleep(1);
    Inc(ticks);
  end;
  WriteLn('main ticked while the routine waited ', ticks > 0);
end.

