program constfoldtypes;
type TStep = (FirstStep, MiddleStep, LastStep);
var Seen: Integer;
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('constant type ', Stage, ': ', Actual, ' <> ', Expected); Halt(92); end;
end;
function Yes: Boolean;
begin Result := True; end;
function No: Boolean;
begin Result := False; end;
function Touch: Boolean;
begin Seen := Seen + 1; Result := True; end;
function TopByte: Byte;
begin Result := Byte(255); end;
function NegativeByte: Int8;
begin Result := $FF as Int8; end;
function Letter: Char;
begin Result := Char(90); end;
function Middle: TStep;
begin Result := MiddleStep; end;
function Nothing: Pointer;
begin Result := nil; end;
function IntLetter: Integer;
begin Result := 65; end;
function IntZero: Integer;
begin Result := 0; end;
var I, N: Integer; B: Byte; S8: Int8; W: Word; S16: Int16; U: UInt32; S32: Int32; Flag: Boolean;
begin
  I := 7 + 5 * 3; Equal(1, I, 22);
  I := 13 div 5; Equal(2, I, 2);
  I := 13 mod 5; Equal(3, I, 3);
  I := -7; Equal(4, I, -7);
  I := (5 shl 3) or 2; Equal(5, I, 42);
  I := 47 and 15; Equal(6, I, 15);
  I := 42 xor 15; Equal(7, I, 37);
  I := -9223372036854775807 - 1; Equal(8, I, -9223372036854775807 - 1);
  I := 9223372036854775807 - 1; Equal(9, I, 9223372036854775806);
  I := IntZero; Equal(10, I, 0);

  B := Byte(255) + Byte(1); Equal(20, B, 0);
  N := 257; B := Byte(N); Equal(21, B, 1);
  N := 255; S8 := Int8(N); Equal(22, S8, -1);
  S8 := -Int8(-128); Equal(23, S8, -128);
  N := 65538; W := Word(N); Equal(24, W, 2);
  N := 32768; S16 := Int16(N); Equal(25, S16, -32768);
  N := $100000001; U := UInt32(N); Equal(26, U, 1);
  N := $FFFFFFFF; S32 := Int32(N); Equal(27, S32, -1);
  B := not Byte(0); Equal(28, B, 255);
  S8 := Int8(-8) shr 1; Equal(29, S8, -4);
  B := TopByte; Equal(30, B, 255);
  S8 := NegativeByte; Equal(31, S8, -1);
  Equal(32, Ord(Letter), 90); Equal(33, Ord(Middle), 1);
  Flag := Nothing = nil; Equal(34, Ord(Flag), 1);

  Flag := Yes; Equal(40, Ord(Flag), 1);
  Flag := No; Equal(41, Ord(Flag), 0);
  Flag := not No; Equal(42, Ord(Flag), 1);
  Seen := 0; Flag := No and Touch; Equal(43, Seen, 0); Equal(44, Ord(Flag), 0);
  Seen := 0; Flag := Yes or Touch; Equal(45, Seen, 0); Equal(46, Ord(Flag), 1);
  Seen := 0; Flag := Yes and Touch; Equal(47, Seen, 1); Equal(48, Ord(Flag), 1);
  { Parser-applied call type casts survive nilary constant replacement. }
  WriteLn(Letter);
  WriteLn(Integer(Letter));
  WriteLn(Integer(Middle));
  WriteLn(Integer(TopByte));
  WriteLn(Char(IntLetter));
  WriteLn('ok constant type controls');
end.
