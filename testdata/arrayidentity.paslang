program arrayidentity;
uses sysutils;
var a, b: array[0..1] of Integer; pair: TCurrencyQuadWords;
  bytes: array[0..3] of Byte; q: Quad; amount: Currency;
begin
  a[0] := 7; a[1] := 11; b := a;
  b := b and 3;
  if (b[0] <> 3) or (b[1] <> 3) then Halt(1);
  bytes[0] := 255; bytes := bytes and 15;
  if bytes[0] <> 15 then Halt(2);
  q := 1.25; Move(q, pair, SizeOf(pair));
  amount := Currency.FromScaled(PasCurrFromQuadWords(pair));
  if amount <> 1.25 then Halt(3);
  Move(pair, a, SizeOf(a));
  if (a[0] <> pair[0]) or (a[1] <> pair[1]) then Halt(4);
  WriteLn('anonymous arrays retain their shape beside imported named arrays');
end.
