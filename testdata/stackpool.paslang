program stackpool;

uses
  sysutils;

var
  wg: waitgroup;
  gate: chan of Integer;
  res: array[0..179] of Integer;
  junk: array[0..179] of Integer;
  deepres: Integer;

function Down(N, T: Integer): Integer;
var
  s: string;
begin
  if N = 0 then
    Result := T
  else if (N and 15) = 0 then
  begin
    s := IntToStr(N);
    Result := Down(N - 1, T) + ((N + T) and 3) + Ord(s[Length(s)]) - 48 - (N mod 10);
  end
  else
    Result := Down(N - 1, T) + ((N + T) and 3);
end;

procedure Deep;
begin
  deepres := Down(900000, 5);
  wg.Done;
end;

procedure Worker(Id: Integer);
var
  i, r, k: Integer;
  t: string;
begin
  r := Down(200 + (Id * 7919) mod 30000, Id mod 7);
  { the garbage a cycle of the collector runs for, with the stack grown }
  t := '';
  for i := 1 to 400 do
    t := IntToStr(i) + Copy(t, 1, 100);
  k := Length(t);
  if Id mod 5 = 0 then
    k := k + Recv(gate) - 1;
  res[Id] := r;
  junk[Id] := k;
  wg.Done;
end;

var
  w, i, id, s, parked: Integer;
begin
  { a stack that grows past what the cache keeps (8 MiB), in a routine of its own }
  wg.Add(1);
  pas Deep;
  wg.Wait;
  WriteLn('deep ', deepres);
  gate := MakeChan();
  for w := 0 to 3 - 1 do
  begin
    wg.Add(60);
    parked := 0;
    for i := 0 to 60 - 1 do
    begin
      id := w * 60 + i;
      if id mod 5 = 0 then
        parked := parked + 1;
      pas Worker(id);
    end;
    for i := 1 to parked do
      Send(gate, 1);
    wg.Wait;
    s := 0;
    for i := 0 to 60 - 1 do
      s := s + res[w * 60 + i];
    WriteLn('wave ', w, ' ', s);
  end;
  s := 0;
  for i := 0 to 179 do
    s := s + junk[i];
  WriteLn('garbage ', s);
end.
