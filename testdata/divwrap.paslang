{ P359: the lowest Int64 divided by -1 wraps on both machines, as div
  and mod wrap like the rest and as Go gives them: the quotient is the
  lowest again and the remainder 0, where amd64's idivq faulted and the
  program stopped with 'integer divide by zero', and the compiler itself
  on the folded constant. In the pool, outside it (an operand that
  calls), from elements, folded, by the constant -1, narrow, in a
  condition and in a table of dividends and divisors; the answers are
  worked out by hand in the comments, the quotient truncated towards 0
  and the remainder with the dividend's sign. }
program divwrap;

var
  k, t, i, j, x, d, m: Integer;
  n32, d32: Int32;
  by: Byte;
  a: array[0..3] of Integer;
  xs: array[0..3] of Integer;
  ds: array[0..5] of Integer;

function Id(X: Integer): Integer;
begin
  Result := X;
end;

begin
  k := Low(Int64);
  t := -1;
  { -9223372036854775808 0 }
  WriteLn(k div t, ' ', k mod t);
  WriteLn(Id(k) div Id(t), ' ', Id(k) mod Id(t));
  a[1] := k;
  a[2] := t;
  WriteLn(a[1] div a[2], ' ', a[1] mod a[2]);
  WriteLn(Low(Int64) div -1, ' ', Low(Int64) mod -1);
  WriteLn(k div -1, ' ', k mod -1);
  i := k div t;
  j := k mod t;
  WriteLn(i, ' ', j);
  if k div t = k then
    WriteLn('the lowest');
  { Int32's lowest by -1: 2147483648, which an Int32 wraps to itself;
    by an Integer -1 the Integer 2147483648 }
  n32 := Low(Int32);
  d32 := -1;
  n32 := n32 div d32;
  WriteLn(n32, ' ', Low(Int32) div t, ' ', Low(Int32) mod d32);
  { a Byte divisor cannot be -1: -3074457345618258602 -2 }
  by := 3;
  WriteLn(k div by, ' ', k mod by);
  xs[0] := Low(Int64);
  xs[1] := High(Int64);
  xs[2] := -7;
  xs[3] := 7;
  ds[0] := -3;
  ds[1] := -2;
  ds[2] := -1;
  ds[3] := 1;
  ds[4] := 2;
  ds[5] := 3;
  for i := 0 to 3 do
  begin
    for j := 0 to 5 do
    begin
      x := xs[i];
      d := ds[j];
      m := x mod d;
      Write(x div d, ' ', m, ' ');
    end;
    WriteLn;
  end;
end.
