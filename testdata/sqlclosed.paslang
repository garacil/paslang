{ P506: a connection used after Disconnect. SQLite leaves a closed handle undefined; the
  unit says SQLITE_MISUSE (code 21) from every method of TSqlite, as an ESqliteError a
  program can catch, and does not stop on a nil pointer. Disconnect twice, then Free,
  stay what they were. sqlite3_exec with no connection at all gives SQLITE_MISUSE too,
  as legacy.c has it, and an empty message; errmsg, errcode, error_offset, close and the rest
  that SQLite answers for a NULL connection in its default build answer the same. }
program sqlclosed;

uses sqlite;

var
  db: TSqlite;
  rows: TSqliteRows;
  v: TSqliteValue;
  n: Int64;
  objs: TSqliteObjects;
  msg: string;
  rc: Integer;

procedure Shown(const What: string; E: ESqliteError);
begin
  WriteLn(What, ': ', E.Code, ' ', E.ExtendedCode, ' ', E.Message);
end;

begin
  db := TSqlite.Open(':memory:');
  db.Exec('CREATE TABLE t(a)');
  db.Exec('INSERT INTO t VALUES(?)', [1]);
  WriteLn('open: ', db.QueryValue('SELECT count(*) FROM t', []).I, ' row, page size ', db.PageSize);
  db.Disconnect;
  db.Disconnect;
  WriteLn('disconnected twice');
  try
    db.Exec('SELECT 1');
  except
    on E: ESqliteError do Shown('Exec', E);
  end;
  try
    n := db.Exec('INSERT INTO t VALUES(?)', [2]);
  except
    on E: ESqliteError do Shown('Exec with arguments', E);
  end;
  try
    rows := db.Query('SELECT a FROM t');
  except
    on E: ESqliteError do Shown('Query', E);
  end;
  try
    rows := db.Query('SELECT a FROM t WHERE a = ?', [1]);
  except
    on E: ESqliteError do Shown('Query with arguments', E);
  end;
  try
    v := db.QueryValue('SELECT 1', []);
  except
    on E: ESqliteError do Shown('QueryValue', E);
  end;
  try
    n := db.LastInsertRowId;
  except
    on E: ESqliteError do Shown('LastInsertRowId', E);
  end;
  try
    n := db.Changes;
  except
    on E: ESqliteError do Shown('Changes', E);
  end;
  try
    objs := db.Schema;
  except
    on E: ESqliteError do Shown('Schema', E);
  end;
  try
    rows := db.Rows('t');
  except
    on E: ESqliteError do Shown('Rows', E);
  end;
  try
    rows := db.RowsAt(2);
  except
    on E: ESqliteError do Shown('RowsAt', E);
  end;
  try
    rc := db.PageSize;
  except
    on E: ESqliteError do Shown('PageSize', E);
  end;
  try
    rc := db.PageCount;
  except
    on E: ESqliteError do Shown('PageCount', E);
  end;
  try
    rc := db.Encoding;
  except
    on E: ESqliteError do Shown('Encoding', E);
  end;
  try
    rc := db.UserVersion;
  except
    on E: ESqliteError do Shown('UserVersion', E);
  end;
  try
    rc := db.SchemaCookie;
  except
    on E: ESqliteError do Shown('SchemaCookie', E);
  end;
  db.Free;

  msg := 'untouched';
  rc := sqlite3_exec(nil, 'SELECT 1', nil, nil, msg);
  WriteLn('sqlite3_exec(nil): ', rc, ' "', msg, '"');
  WriteLn('sqlite3_errmsg(nil): ', sqlite3_errmsg(nil));
  WriteLn('sqlite3_errcode(nil): ', sqlite3_errcode(nil), ' ', sqlite3_extended_errcode(nil));
  WriteLn('sqlite3_error_offset(nil): ', sqlite3_error_offset(nil));
  WriteLn('sqlite3_close(nil): ', sqlite3_close(nil), ' ', sqlite3_close_v2(nil), ' ', sqlite3_system_errno(nil));

  db := TSqlite.Open(':memory:');
  db.Exec('CREATE TABLE t(a)');
  WriteLn('a new connection works: ', db.QueryValue('SELECT count(*) FROM sqlite_schema', []).I, ' table');
  db.Free;
end.

