{ Type helpers (P127): a type helper for string, for Integer and for an
  enumeration, a record helper, a class helper; methods and functions,
  a default, a static class function called through a value and through
  the type (Integer.Max3), a property read through its method, Self
  changed by a method, a literal, a constant and a function's result as
  the value, chained calls, a record's fields and a class's members
  seen from the helper's method. The same source compiles with Free
  Pascal, whose output is the one expected. }
program helper1;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$modeswitch typehelpers}
{$modeswitch advancedrecords}
{$endif}

type
  TStrHelper = type helper for string
    function Twice: string;
    function Has(C: Char): Boolean;
    procedure Grow(const S: string = '!');
    function CountOf(C: Char): Integer;
    class function Stars(N: Integer): string; static;
    function GetLen: Integer;
    property Len: Integer read GetLen;
  end;

  TIntHelper = type helper for Integer
    function Squared: Integer;
    function IsEven: Boolean;
    procedure Bump(N: Integer = 1);
    class function Max3(A, B, C: Integer): Integer; static;
  end;

  TPoint = record
    X, Y: Integer;
  end;

  TPointHelper = record helper for TPoint
    function Sum: Integer;
    procedure Shift(DX, DY: Integer);
    function Show: string;
    class function Make(AX, AY: Integer): TPoint; static;
  end;

  TColor = (Red, Green, Blue);

  TColorHelper = type helper for TColor
    function Next: TColor;
    function Name: string;
  end;

  TBox = class
    N: Integer;
  end;

  TBoxHelper = class helper for TBox
    function Doubled: Integer;
    procedure Reset;
  end;

function TStrHelper.Twice: string;
begin
  Result := Self + Self;
end;

function TStrHelper.Has(C: Char): Boolean;
var
  i: Integer;
begin
  Result := False;
  for i := 1 to Len do
    if Self[i] = C then
      Result := True;
end;

procedure TStrHelper.Grow(const S: string);
begin
  Self := Self + S;
end;

function TStrHelper.CountOf(C: Char): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to Length(Self) do
    if Self[i] = C then
      Result := Result + 1;
end;

class function TStrHelper.Stars(N: Integer): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to N do
    Result := Result + '*';
end;

function TStrHelper.GetLen: Integer;
begin
  Result := Length(Self);
end;

function TIntHelper.Squared: Integer;
begin
  Result := Self * Self;
end;

function TIntHelper.IsEven: Boolean;
begin
  Result := Self mod 2 = 0;
end;

procedure TIntHelper.Bump(N: Integer);
begin
  Self := Self + N;
end;

class function TIntHelper.Max3(A, B, C: Integer): Integer;
begin
  Result := A;
  if B > Result then
    Result := B;
  if C > Result then
    Result := C;
end;

function Show0(N: Integer): string;
var
  s: string;
begin
  s := '';
  Result := s.Stars(N);
end;

function TPointHelper.Sum: Integer;
begin
  Result := X + Self.Y;
end;

procedure TPointHelper.Shift(DX, DY: Integer);
begin
  X := X + DX;
  Y := Y + DY;
end;

function TPointHelper.Show: string;
begin
  Result := '(' + Show0(X.Squared) + ')';
end;

class function TPointHelper.Make(AX, AY: Integer): TPoint;
begin
  Result.X := AX;
  Result.Y := AY;
end;

function TColorHelper.Next: TColor;
begin
  if Self = High(TColor) then
    Result := Low(TColor)
  else
    Result := Succ(Self);
end;

function TColorHelper.Name: string;
begin
  case Self of
    Red: Result := 'red';
    Green: Result := 'green';
  else
    Result := 'blue';
  end;
end;

function TBoxHelper.Doubled: Integer;
begin
  Result := N * 2;
end;

procedure TBoxHelper.Reset;
begin
  N := 0;
end;

var
  s: string;
  i: Integer;
  p: TPoint;
  c: TColor;
  b: TBox;

begin
  s := 'ab';
  WriteLn(s.Twice, ' ', s.Len, ' ', Ord(s.Has('b')), Ord(s.Has('z')));
  s.Grow;
  s.Grow('?');
  WriteLn(s, ' ', s.Len);
  WriteLn('hello'.CountOf('l'), ' ', s.Twice.Twice.Len, ' ', s.Stars(3));
  i := 7;
  WriteLn(i.Squared, ' ', Ord(i.IsEven));
  i.Bump;
  i.Bump(10);
  WriteLn(i, ' ', i.Squared.Squared, ' ', Integer.Max3(1, 9, 4), ' ', i.Max3(5, 2, 3));
  p := TPoint.Make(2, 3);
  p.Shift(1, 1);
  WriteLn(p.Sum, ' ', p.Show, ' ', p.X, p.Y);
  c := Red;
  WriteLn(Ord(c.Next), ' ', c.Next.Name, ' ', Blue.Next.Name, ' ', c.Name);
  b := TBox.Create;
  b.N := 4;
  WriteLn(b.Doubled);
  b.Reset;
  WriteLn(b.N, ' ', b.Doubled);
end.

