program addrlocal;

{ The address a routine takes of its own local keeps that local in memory
  and no other (1.0.128): Take's n is read through p, Mix's n lives in a
  register for its loop. The names whose address was taken were one list
  for the whole compilation, so Mix's n stayed in memory. }

procedure Take;
var
  n: Integer;
  p: ^Integer;
begin
  n := 5;
  p := @n;
  p^ := 6;
  WriteLn(n);
end;

function Mix(k: Integer): Integer;
var
  n, i: Integer;
begin
  n := 1;
  for i := 1 to k do
    n := (n xor (i * 3)) + (n shr 3);
  Result := n;
end;

begin
  Take;
  WriteLn(Mix(1000));
end.

