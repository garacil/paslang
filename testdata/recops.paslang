{ P171: operators declared in a record. TComplex writes them as Free
  Pascal does, +, <> and the rest, and as Delphi names them, Subtract,
  Multiply, Equal, Implicit, Explicit, a const operand among them;
  TMoney uses := for Implicit, a div, a Modulus that gives an Integer and
  an Implicit to an Integer. Implicit makes a value of a record where
  it is assigned, passed and returned, and Explicit and Implicit serve a
  cast; an operand takes what a call's argument takes, a * 3 an Integer
  for a Double. The output is written by hand from Free Pascal's
  reference (9.3, table 9.1). }
program recops;

type
  TComplex = record
    Re, Im: Double;
    class operator +(a, b: TComplex): TComplex;
    class operator Subtract(const a, b: TComplex): TComplex;
    class operator Multiply(a: TComplex; k: Double): TComplex;
    class operator Equal(a, b: TComplex): Boolean;
    class operator <>(a, b: TComplex): Boolean;
    class operator Implicit(d: Double): TComplex;
    class operator Explicit(a: TComplex): Double;
  end;

  TMoney = record
    Cents: Integer;
    class operator :=(c: Integer): TMoney;
    class operator Implicit(m: TMoney): Integer;
    class operator Add(a, b: TMoney): TMoney;
    class operator LessThan(a, b: TMoney): Boolean;
    class operator >=(a, b: TMoney): Boolean;
    class operator div(a: TMoney; n: Integer): TMoney;
    class operator Modulus(a: TMoney; n: Integer): Integer;
  end;

class operator TComplex.+(a, b: TComplex): TComplex;
begin
  Result.Re := a.Re + b.Re;
  Result.Im := a.Im + b.Im;
end;

class operator TComplex.Subtract(const a, b: TComplex): TComplex;
begin
  Result.Re := a.Re - b.Re;
  Result.Im := a.Im - b.Im;
end;

class operator TComplex.Multiply(a: TComplex; k: Double): TComplex;
begin
  Result.Re := a.Re * k;
  Result.Im := a.Im * k;
end;

class operator TComplex.Equal(a, b: TComplex): Boolean;
begin
  Result := (a.Re = b.Re) and (a.Im = b.Im);
end;

class operator TComplex.<>(a, b: TComplex): Boolean;
begin
  Result := not (a = b);
end;

class operator TComplex.Implicit(d: Double): TComplex;
begin
  Result.Re := d;
  Result.Im := 0;
end;

class operator TComplex.Explicit(a: TComplex): Double;
begin
  Result := a.Re * a.Re + a.Im * a.Im;
end;

class operator TMoney.:=(c: Integer): TMoney;
begin
  Result.Cents := c;
end;

class operator TMoney.Implicit(m: TMoney): Integer;
begin
  Result := m.Cents;
end;

class operator TMoney.Add(a, b: TMoney): TMoney;
begin
  Result.Cents := a.Cents + b.Cents;
end;

class operator TMoney.LessThan(a, b: TMoney): Boolean;
begin
  Result := a.Cents < b.Cents;
end;

class operator TMoney.>=(a, b: TMoney): Boolean;
begin
  Result := a.Cents >= b.Cents;
end;

class operator TMoney.div(a: TMoney; n: Integer): TMoney;
begin
  Result.Cents := a.Cents div n;
end;

class operator TMoney.Modulus(a: TMoney; n: Integer): Integer;
begin
  Result := a.Cents mod n;
end;

procedure Show(const c: TComplex);
begin
  WriteLn(c.Re:0:2, ' ', c.Im:0:2);
end;

function Twice(m: TMoney): TMoney;
begin
  Result := m + m;
end;

function Cents(m: TMoney): Integer;
begin
  Result := m;
end;

var
  a, b, c: TComplex;
  m, n: TMoney;
  d: Double;
  i: Integer;

begin
  a.Re := 1;
  a.Im := 2;
  b := 2.5;
  Show(b);
  c := a + b;
  Show(c);
  Show(c - a);
  Show(a * 3);
  Show(a * 0.5);
  WriteLn(c - a = b, ' ', a <> b, ' ', a = a);
  d := Double(a);
  WriteLn(d:0:2);
  Show(1.5);
  m := 250;
  n := m + TMoney(125);
  i := n;
  WriteLn(i);
  WriteLn(Integer(n div 2), ' ', n mod 100);
  WriteLn(m < n, ' ', n < m, ' ', n >= m, ' ', m >= m);
  WriteLn(Cents(Twice(m)));
  WriteLn(Cents(300));
end.

