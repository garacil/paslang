{ P387: a value of 0..255 tested against a constant set is its bit in
  the set's word, nothing pushed and no range check: a Byte, a Char and
  an Integer a mask bounds, against sets below 64, sets up to 255 and
  the empty set, as a Boolean and as the condition of an if, a while and
  a repeat, negated too; every one of the 256 values. The routines
  In* are read by scripts/check_bytesetin.py: no push and no compare
  with 255 or 63, a bt (lsr and tst on arm64). }
program bytesetin;

var
  b: Byte;
  c: Char;
  i, n: Integer;
  sums: array[0..9] of Integer;

{ the blanks and the operators of JSON, a set past 64 }
function InJson(B: Byte): Boolean;
begin
  Result := B in [9, 10, 13, 32, 34, 44, 58, 91, 93, 123, 125];
end;

{ a set below 64 and a Byte that may be past it }
function InLow(B: Byte): Boolean;
begin
  Result := B in [0, 1, 7, 31, 32, 40..47, 63];
end;

{ a Char against letters and digits }
function InWord(C: Char): Boolean;
begin
  Result := C in ['a'..'z', 'A'..'Z', '0'..'9', '_'];
end;

{ an Integer a mask bounds to 0..255 }
function InMasked(X: Integer): Boolean;
begin
  Result := (X and 255) in [128..191, 255];
end;

{ an Integer a mask bounds to 0..63, against a set below 64 }
function InSmall(X: Integer): Boolean;
begin
  Result := (X and 63) in [1, 2, 3, 5, 8, 13, 21, 34, 55];
end;

{ the empty set }
function InNone(B: Byte): Boolean;
begin
  Result := B in [];
end;

{ the test as conditions: an if and a negated one }
function InCount(B: Byte): Integer;
begin
  Result := 0;
  if B in [200..255, 0] then
    Result := Result + 1;
  if not (B in [65..90]) then
    Result := Result + 2;
end;

{ a while over a text's leading blanks, and a repeat to a stop byte }
function InSkip(const S: string): Integer;
var
  k: Integer;
begin
  k := 1;
  while (k <= Length(S)) and (S[k] in [' ', #9, #10, #13]) do
    k := k + 1;
  Result := k;
  repeat
    k := k + 1;
  until (k > Length(S)) or (S[k] in [',', ']', '}']);
  Result := Result * 100 + k;
end;

begin
  for i := 0 to 9 do
    sums[i] := 0;
  for i := 0 to 255 do
  begin
    b := Byte(i);
    c := Chr(i);
    if InJson(b) then
      sums[0] := sums[0] + i;
    if InLow(b) then
      sums[1] := sums[1] + i;
    if InWord(c) then
      sums[2] := sums[2] + i;
    if InMasked(i + 512) then
      sums[3] := sums[3] + i;
    if InSmall(i) then
      sums[4] := sums[4] + i;
    if InNone(b) then
      sums[5] := sums[5] + 1;
    sums[6] := sums[6] + InCount(b) * i;
  end;
  n := 0;
  for i := 0 to 255 do
    if InJson(Byte(i)) <> ((i = 9) or (i = 10) or (i = 13) or (i = 32) or (i = 34) or (i = 44) or
      (i = 58) or (i = 91) or (i = 93) or (i = 123) or (i = 125)) then
      n := n + 1;
  WriteLn('json ', sums[0], ' low ', sums[1], ' word ', sums[2], ' masked ', sums[3]);
  WriteLn('small ', sums[4], ' none ', sums[5], ' count ', sums[6], ' apart ', n);
  WriteLn('skip ', InSkip('   '#9'abc,d'), ' ', InSkip('x]'), ' ', InSkip(''));
end.
