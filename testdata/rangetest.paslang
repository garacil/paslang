{ P292: a test of a value against both ends of a constant range, joined
  by and or or, is one subtraction, one compare without sign and one
  branch (or a set for a value), as Go's generic.rules write it. Each
  end, one past each end, and the most negative and positive values of
  every width are tested, in branches and in Boolean values, with < and
  <=, constants on either side; a range whose span does not fit an
  Integer keeps its two compares. Every line is what the code before
  P292 gives. }
program rangetest;

var
  vals: array[0..19] of Integer;

function Bits(x: Integer): Integer;
var
  r: Integer;
  ok: Boolean;
begin
  r := 0;
  if (x >= 48) and (x <= 57) then
    r := r or 1;
  if (x < 48) or (x > 57) then
    r := r or 2;
  if (x > -6) and (x < 6) then
    r := r or 4;
  if (5 >= x) and (-5 <= x) then
    r := r or 8;
  if (x >= 0) and (x <= 0) then
    r := r or 16;
  if (x >= Low(Integer)) and (x <= -1) then
    r := r or 32;
  if (x >= 0) and (x <= High(Integer)) then
    r := r or 64;
  if (x > Low(Integer)) and (x < High(Integer)) then
    r := r or 128;
  if (x <= -129) or (x >= 128) then
    r := r or 256;
  if (x >= -4096) and (x <= 4096) then
    r := r or 512;
  if (x >= 1000000000000) and (x <= 3000000000000) then
    r := r or 1024;
  ok := (x >= -32768) and (x <= 32767);
  if ok then
    r := r or 2048;
  ok := (x < 0) or (x > 255);
  if ok then
    r := r or 4096;
  ok := (x >= Low(Integer)) and (x <= High(Integer));
  if ok then
    r := r or 8192;
  ok := (x < -2147483648) or (x > 2147483647);
  if ok then
    r := r or 16384;
  Result := r;
end;

function Narrow(b: Byte; s8: Int8; w: Word; s16: Int16; u32: UInt32; s32: Int32): Integer;
var
  r: Integer;
begin
  r := 0;
  if (b >= 10) and (b <= 200) then
    r := r or 1;
  if (b < 1) or (b > 254) then
    r := r or 2;
  if (s8 >= -128) and (s8 <= -1) then
    r := r or 4;
  if (s8 > -100) and (s8 < 100) then
    r := r or 8;
  if (w >= 1000) and (w <= 65535) then
    r := r or 16;
  if (s16 < -30000) or (s16 > 30000) then
    r := r or 32;
  if (u32 >= 1) and (u32 <= 4294967294) then
    r := r or 64;
  if (s32 >= -2147483648) and (s32 <= 0) then
    r := r or 128;
  Result := r;
end;

function Letters(const s: string): Integer;
var
  i, n: Integer;
  c: Char;
begin
  n := 0;
  for i := 1 to Length(s) do
  begin
    c := s[i];
    if (c >= 'a') and (c <= 'z') then
      n := n + 1
    else if (c < '0') or (c > '9') then
      n := n + 100;
  end;
  Result := n;
end;

var
  i: Integer;

begin
  vals[0] := 47;
  vals[1] := 48;
  vals[2] := 57;
  vals[3] := 58;
  vals[4] := -6;
  vals[5] := -5;
  vals[6] := 5;
  vals[7] := 6;
  vals[8] := 0;
  vals[9] := -1;
  vals[10] := Low(Integer);
  vals[11] := High(Integer);
  vals[12] := Low(Integer) + 1;
  vals[13] := High(Integer) - 1;
  vals[14] := -129;
  vals[15] := 128;
  vals[16] := 4096;
  vals[17] := 999999999999;
  vals[18] := 3000000000000;
  vals[19] := 2147483648;
  for i := 0 to 19 do
    WriteLn(vals[i], ' ', Bits(vals[i]));
  WriteLn(Narrow(10, -128, 1000, -30001, 1, -2147483648));
  WriteLn(Narrow(9, 127, 999, 30001, 4294967295, 1));
  WriteLn(Narrow(200, -100, 65535, 30000, 4294967294, 0));
  WriteLn(Narrow(201, -99, 0, -32768, 0, 2147483647));
  WriteLn(Narrow(0, 99, 1, 32767, 2147483648, -1));
  WriteLn(Narrow(255, 100, 65534, -30000, 100, -2147483647));
  WriteLn(Letters('abz{`AZ09/:x'));
end.

