program inspine;

{ d := d op a op b ... for a d a loop keeps in a register changes the
  register at each step (P100, 1.0.100); d named on the right as well
  is worked out apart, as before. }

var
  x, y, z, k, i, big: Integer;
  m: array[0..7] of Integer;

begin
  x := 12345;
  y := 7;
  z := 1;
  k := 3;
  big := 5000000000;
  for i := 0 to 7 do
    m[i] := i * i + 1;
  for i := 1 to 100000 do
  begin
    x := x * 1103515245 + 12345;
    y := (y xor k) * 5 - 2;
    z := ((z and 255) or 256) xor i;
    k := k + m[i and 7] * 2 - big;
    y := y + y * 2;
  end;
  WriteLn(x, ' ', y, ' ', z, ' ', k);
  x := 1;
  for i := 1 to 60 do
    x := x * 3 + big mod 7 - 1;
  WriteLn(x);
end.

