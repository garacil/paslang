program lastone;
type
  TA = type helper for Integer
    function Twice: Integer;
  end;
  TB = type helper for Integer
    function Thrice: Integer;
  end;

function TA.Twice: Integer;
begin
  Result := Self * 2;
end;

function TB.Thrice: Integer;
begin
  Result := Self * 3;
end;

var
  i: Integer;
begin
  i := 2;
  WriteLn(i.Twice);
end.

