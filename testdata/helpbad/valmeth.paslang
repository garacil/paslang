program valmeth;
type
  TFoo = class
    N: Integer;
  end;
  TH = class helper for TFoo
    function Twice: Integer;
  end;
function TH.Twice: Integer;
begin
  Result := N * 2;
end;
begin
  WriteLn(TFoo.Twice);
end.

