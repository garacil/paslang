program strict;
type
  TH = type helper for Integer
  strict private
    function Hidden: Integer;
  public
    function Shown: Integer;
  end;

function TH.Hidden: Integer;
begin
  Result := Self;
end;

function TH.Shown: Integer;
begin
  Result := Hidden;
end;

var
  i: Integer;
begin
  i := 1;
  WriteLn(i.Hidden);
end.

