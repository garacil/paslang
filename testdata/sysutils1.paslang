{ SysUtils (P128): the exceptions and the routines of strings, integers
  and Booleans, against Free Pascal's. }
program sysutils1;

uses sysutils;

function B(X: Boolean): string;
begin
  Result := BoolToStr(X, True);
end;

function Shown(const S: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
    if S[i] = #10 then
      Result := Result + '\n'
    else if S[i] = #13 then
      Result := Result + '\r'
    else
      Result := Result + S[i];
end;

procedure Exceptions;
var
  e: Exception;
  n: Int64;
begin
  e := EConvertError.Create('bad');
  WriteLn(e.ClassName, ' ', e.Message, ' ', e.ToString, ' ', B(e is Exception));
  e.Message := 'worse';
  WriteLn(e.Message, ' ', e.HelpContext);
  e := Exception.CreateHelp('help', 42);
  WriteLn(e.Message, ' ', e.HelpContext);
  WriteLn(B(EDivByZero.InheritsFrom(EIntError)), ' ', B(EIntError.InheritsFrom(EExternal)),
    ' ', B(EZeroDivide.InheritsFrom(EMathError)), ' ', B(EAbort.InheritsFrom(EExternal)),
    ' ', EOutOfMemory.ClassParent.ClassName, ' ', EArgumentNilException.ClassParent.ClassName);
  try
    n := StrToInt('12x');
    WriteLn(n);
  except
    on x: EConvertError do
      WriteLn('caught ', x.ClassName, ': ', x.Message, ' ', B(ExceptObject = x));
  end;
  try
    Abort;
  except
    on x: EAbort do
      WriteLn('abort ', x.Message);
  end;
  try
    raise EInOutError.Create('disk');
  except
    on x: Exception do
      WriteLn(x.ToString);
  end;
  WriteLn(B(ExceptObject = nil));
  WriteLn(EVariantError.CreateCode(-2147352566).Message, '|',
    EVariantError.CreateCode(-2147352567).Message, '|', EVariantError.CreateCode(7).Message, '|',
    EVariantError.CreateCode(-2147467263).ErrCode, '|', EVariantError.CreateCode(0).Message);
end;

procedure Strings;
var
  bs: TBytes;
  s: string;
begin
  WriteLn(UpperCase('abc Déf'), ' ', LowerCase('ABC Déf'), ' ', AnsiUpperCase('xyz'), ' ',
    AnsiLowerCase('XYZ'));
  WriteLn(CompareStr('abc', 'abd'), ' ', CompareStr('abd', 'abc'), ' ', CompareStr('ab', 'abc'), ' ',
    CompareStr('abc', 'ab'), ' ', CompareStr('same', 'same'), ' ', CompareStr('', 'a'));
  WriteLn(CompareText('ABC', 'abd'), ' ', CompareText('hello', 'HELLO'), ' ', CompareText('a', 'ab'),
    ' ', CompareText('_', 'a'), ' ', CompareText('Zeta', 'alpha'));
  WriteLn(B(SameStr('a', 'a')), ' ', B(SameText('HeLLo', 'hello')), ' ', B(SameText('a', 'ab')),
    ' ', AnsiCompareStr('b', 'a'), ' ', AnsiCompareText('abc', 'ABD'), ' ',
    B(AnsiSameText('X', 'x')), ' ', B(AnsiSameStr('X', 'x')));
  WriteLn('[', Trim('  a b  '), '] [', TrimLeft(#9' x '), '] [', TrimRight(' y '#10), '] [',
    Trim('   '), '] [', Trim(#0'z'#0), ']');
  WriteLn(QuotedStr('it''s'), ' ', AnsiQuotedStr('a"b', '"'), ' ', AnsiDequotedStr('''x''''y''', ''''),
    ' ', AnsiDequotedStr('plain', ''''), ' ', AnsiDequotedStr('"open', '"'));
  WriteLn(AnsiPos('lo', 'hello'), ' ', LeftStr('hello', 2), ' ', RightStr('hello', 3), ' [',
    LeftStr('hi', 0), '] ', RightStr('hi', 9));
  WriteLn(StringReplace('a-b-c', '-', '+', []), ' ', StringReplace('a-b-c', '-', '+', [rfReplaceAll]),
    ' ', StringReplace('Hello hello', 'HELLO', 'bye', [rfReplaceAll, rfIgnoreCase]), ' ',
    StringReplace('abc', '', 'x', [rfReplaceAll]));
  WriteLn(B(IsDelimiter(',;', 'a,b', 2)), ' ', B(IsDelimiter(',;', 'a,b', 1)), ' ',
    LastDelimiter('/.', '/usr/lib/x.so'), ' ', LastDelimiter('!', 'none'));
  WriteLn(Shown(AdjustLineBreaks('a'#13#10'b'#13'c'#10'd')));
  WriteLn(Shown(WrapText('The quick brown fox jumps over the lazy dog', 12)));
  WriteLn(Shown(WrapText('say ''hello there'' and "go on now" then stop', 8)));
  WriteLn(Shown(WrapText('aaa bbb ccc ddd', '|', [' '], 5)));
  WriteLn(B(IsValidIdent('abc_1')), ' ', B(IsValidIdent('1abc')), ' ', B(IsValidIdent('')), ' ',
    B(IsValidIdent('a.b', True)), ' ', B(IsValidIdent('a.b')), ' ', B(IsValidIdent('a.', True, True)),
    ' ', B(IsValidIdent('a.', True)));
  WriteLn(B(CharInSet('x', ['a'..'z'])), ' ', B(CharInSet('X', ['a'..'z'])));
  s := 'ab';
  AppendStr(s, 'cd');
  bs := BytesOf(s);
  WriteLn(s, ' ', Length(bs), ' ', bs[0], ' ', bs[3], ' ', StringOf(bs), ' [', StringOf(nil), ']');
  WriteLn(B(EmptyStr = ''), ' ', PathDelim, ' ', PathSep, ' ', Length(LineEnding));
end;

procedure Numbers;
var
  i: Integer;
  i64: Int64;
  q: QWord;
  ok: Boolean;
begin
  i64 := -1;
  WriteLn(IntToStr(-42), ' ', IntToStr(9223372036854775807), ' ', UIntToStr(QWord(i64)), ' ',
    UIntToStr(QWord(1234)));
  i64 := 255;
  WriteLn(IntToHex(i64, 4), ' ', IntToHex(i64, 1), ' ', IntToHex(Int64(0), 3), ' ', IntToHex(i64));
  i64 := -1;
  WriteLn(IntToHex(i64, 2));
  WriteLn(StrToInt('123'), ' ', StrToInt('-0042'), ' ', StrToInt('$FF'), ' ', StrToInt('0x1f'), ' ',
    StrToInt64('9000000000'), ' ', StrToIntDef('zz', -7), ' ', StrToInt64Def('', 5));
  WriteLn(StrToIntDef(' 12', 0), ' ', StrToIntDef('12 ', 0), ' ', StrToIntDef('%101', 0), ' ',
    StrToIntDef('&17', 0));
  ok := TryStrToInt('77', i);
  WriteLn(B(ok), ' ', i);
  ok := TryStrToInt('7a', i);
  WriteLn(B(ok));
  ok := TryStrToInt64('-9223372036854775808', i64);
  WriteLn(B(ok), ' ', i64);
  ok := TryStrToQWord('18446744073709551615', q);
  WriteLn(B(ok), ' ', UIntToStr(QWord(q)));
  WriteLn(StrToQWordDef('-1', 3), ' ', StrToDWord('4294967295'), ' ', StrToUIntDef('x', 9));
  WriteLn(BoolToStr(True), ' ', BoolToStr(False), ' ', BoolToStr(True, True), ' ',
    BoolToStr(False, 'yes', 'no'));
  WriteLn(B(StrToBool('true')), ' ', B(StrToBool('FALSE')), ' ', B(StrToBool('0')), ' ',
    B(StrToBool('2.5')), ' ', B(StrToBoolDef('maybe', True)));
  ok := TryStrToBool('nope', ok);
  WriteLn(B(ok));
  SetLength(TrueBoolStrs, 2);
  TrueBoolStrs[0] := 'Yes';
  TrueBoolStrs[1] := 'On';
  SetLength(FalseBoolStrs, 1);
  FalseBoolStrs[0] := 'No';
  WriteLn(B(StrToBool('on')), ' ', B(StrToBool('no')), ' ', BoolToStr(True, True), ' ',
    BoolToStr(False, True));
  try
    StrToBool('perhaps');
  except
    on x: EConvertError do
      WriteLn(x.Message);
  end;
  try
    StrToInt64('');
  except
    on x: EConvertError do
      WriteLn(x.Message);
  end;
end;

procedure Reals;
var
  d: Double;
  sg: Single;
  fs: TFormatSettings;
  t: string;
begin
  WriteLn(StrToFloat('1.5'):0:4, ' ', StrToFloat(' 2.25 '):0:4, ' ', StrToFloat('1e3'):0:1, ' ',
    StrToFloat('-0.5'):0:3, ' ', StrToFloat('.5'):0:2, ' ', StrToFloat('7.'):0:2);
  WriteLn(StrToFloatDef('x', 7):0:1, ' ', StrToFloatDef('1,5', 8):0:1, ' ', B(TryStrToFloat('', d)),
    ' ', B(TryStrToFloat('1e', d)), ' ', B(TryStrToFloat('2.5', sg)), ' ', sg:0:2);
  for t in ['3.25', '+4', '1.5.2', '1 2', '0x10'] do
    if TryStrToFloat(t, d) then
      Write(d:0:3, ' ')
    else
      Write('no ');
  WriteLn;
  try
    StrToFloat('abc');
  except
    on x: EConvertError do
      WriteLn(x.Message);
  end;
  WriteLn(DefaultFormatSettings.DecimalSeparator, DefaultFormatSettings.ThousandSeparator, ' ',
    DefaultFormatSettings.ShortMonthNames[12], ' ', DefaultFormatSettings.LongDayNames[1], ' ',
    DefaultFormatSettings.CurrencyString, ' ', DefaultFormatSettings.LongDateFormat, ' ',
    DefaultFormatSettings.TwoDigitYearCenturyWindow);
  FormatSettings.DecimalSeparator := ',';
  FormatSettings.ThousandSeparator := '.';
  WriteLn(DefaultFormatSettings.DecimalSeparator, ' ', StrToFloat('1,25'):0:3, ' ',
    StrToFloatDef('1.25', -1):0:1);
  fs := DefaultFormatSettings;
  fs.DecimalSeparator := '.';
  fs.ThousandSeparator := #0;
  WriteLn(StrToFloat('9.75', fs):0:2, ' ', StrToFloatDef('9,75', -2, fs):0:1);
  FormatSettings.DecimalSeparator := '.';
  FormatSettings.ThousandSeparator := ',';
end;

begin
  Exceptions;
  Strings;
  Numbers;
  Reals;
end.

