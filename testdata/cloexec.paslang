{ P277: every descriptor paslib opens closes on exec, as Go's do
  (O_CLOEXEC, open(2)). A routine opens files four ways and holds them
  while the main routine runs a child: /proc/self/fdinfo shows the flag
  on each (proc_pid_fdinfo(5): flags is octal and holds O_CLOEXEC when
  the descriptor closes on exec), and the child, which lists its own
  descriptors, has none of them. RunCapture still reads the child's
  output: dup2 gives the child's 1 and 2 without the flag (dup(2)). }
program cloexec;

uses
  paslib;

var
  fds: chan of Int64;
  release, finished: chan of Boolean;
  over: Boolean;
  held: array[0..3] of Int64;
  names: array[0..3] of string;
  i: Integer;
  args: array of string;
  output, list: string;
  rc: LongInt;

{ Whether the octal flags line of /proc/self/fdinfo/Fd has O_CLOEXEC,
  02000000. }
function ClosesOnExec(Fd: Int64): string;
var
  text, digits: string;
  p, k: Integer;
  flags: Int64;
begin
  Result := 'unknown';
  if not ReadFile('/proc/self/fdinfo/' + IntToStr(Fd), text) then
    Exit;
  p := Pos('flags:', text);
  if p = 0 then
    Exit;
  k := p + 6;
  while (k <= Length(text)) and ((text[k] = ' ') or (text[k] = #9)) do
    Inc(k);
  digits := '';
  while (k <= Length(text)) and (text[k] >= '0') and (text[k] <= '7') do
  begin
    digits := digits + text[k];
    Inc(k);
  end;
  flags := 0;
  for p := 1 to Length(digits) do
    flags := flags * 8 + (Ord(digits[p]) - Ord('0'));
  if (flags and 524288) <> 0 then
    Result := 'closes on exec'
  else
    Result := 'INHERITED';
end;

procedure Opener;
var
  go: Boolean;
begin
  WriteFile('build/cloexec.txt', 'some bytes' + #10);
  Send(fds, FileOpen('build/cloexec.txt'));
  Send(fds, FileCreate('build/cloexec-new.txt'));
  Send(fds, FileAppend('build/cloexec.txt'));
  Send(fds, FileEdit('build/cloexec.txt'));
  go := Recv(release);
  Send(finished, go);
end;

begin
  names[0] := 'FileOpen';
  names[1] := 'FileCreate';
  names[2] := 'FileAppend';
  names[3] := 'FileEdit';
  fds := MakeChan(4);
  release := MakeChan();
  finished := MakeChan();
  pas Opener;
  for i := 0 to 3 do
    held[i] := Recv(fds);
  for i := 0 to 3 do
    WriteLn(names[i], ': ', ClosesOnExec(held[i]));
  { the child lists the descriptors it has among the routine's }
  list := '';
  for i := 0 to 3 do
    list := list + ' ' + IntToStr(held[i]);
  args := nil;
  SetLength(args, 2);
  args[0] := '-c';
  args[1] := 'n=0; for f in' + list + '; do [ -e /proc/self/fd/$f ] && n=$((n+1)); done; echo "inherited by the child: $n"';
  output := '';
  rc := RunCapture('sh', args, output);
  Write(output);
  WriteLn('status ', rc);
  Send(release, True);
  over := Recv(finished);
  for i := 0 to 3 do
    FileClose(held[i]);
end.

