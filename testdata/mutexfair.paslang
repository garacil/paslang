{ P98: Go's TestMutexFairness (sync/mutex_test.go). One routine holds
  the mutex nearly all the time and sleeps inside it; another wants it
  ten times. A routine that lets the mutex go and takes it back at once
  wins every race against a waiter that has to be woken first, so
  without the starvation mode the second one may never get it. With
  it, a waiter that waited more than a millisecond turns the mutex to
  handing over: Unlock gives it straight to the first in the queue. The
  test fails by its timeout. }
program mutexfair;

var
  mu: mutex;
  wg: waitgroup;
  stop, got: Integer;

procedure Hog;
begin
  while AtomicAdd(@stop, 0) = 0 do
  begin
    mu.Lock;
    Sleep(1);
    mu.Unlock;
  end;
  wg.Done;
end;

procedure Want;
var
  i: Integer;
begin
  for i := 1 to 10 do
  begin
    Sleep(1);
    mu.Lock;
    got := got + 1;
    mu.Unlock;
  end;
  AtomicAdd(@stop, 1);
  wg.Done;
end;

begin
  wg.Add(2);
  pas Hog;
  pas Want;
  wg.Wait;
  WriteLn(got);
end.
