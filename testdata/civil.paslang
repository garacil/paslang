program civil;

{ P534: UnixToDate, UnixToYMD, DateStr, TimeStr, StampStr and the written forms of hand-made dates }

uses
  pastime;

var
  bad: Integer;

procedure One(T: Int64);
var
  d: TDate;
  y, m, dd: Integer;
begin
  d := UnixToDate(T);
  UnixToYMD(T, y, m, dd);
  if (y <> d.Year) or (m <> d.Month) or (dd <> d.Day) then
    bad := bad + 1;
  WriteLn(T, ' ', d.Year, ' ', d.Month, ' ', d.Day, ' ', d.Hour, ' ', d.Minute, ' ', d.Second, ' ', d.Wday, ' ', d.Yday, ' ', d.Nano);
  WriteLn(DateStr(T), ' ', TimeStr(T), ' ', StampStr(T));
end;

procedure Sweep(Start, Step, Count: Int64);
var
  k, t, h: Int64;
  d: TDate;
  y, m, dd: Integer;
begin
  h := 0;
  for k := 0 to Count - 1 do
  begin
    t := Start + k * Step;
    d := UnixToDate(t);
    UnixToYMD(t, y, m, dd);
    if (y <> d.Year) or (m <> d.Month) or (dd <> d.Day) then
      bad := bad + 1;
    h := h * 31 + d.Year;
    h := h * 31 + d.Month;
    h := h * 31 + d.Day;
    h := h * 31 + d.Hour;
    h := h * 31 + d.Minute;
    h := h * 31 + d.Second;
    h := h * 31 + d.Wday;
    h := h * 31 + d.Yday;
  end;
  WriteLn('sweep ', Start, ' ', Step, ' ', Count, ' ', h);
end;

procedure Hand(Y, Mo, D, H, Mi, S: Integer);
var
  x: TDate;
begin
  x.Year := Y;
  x.Month := Mo;
  x.Day := D;
  x.Hour := H;
  x.Minute := Mi;
  x.Second := S;
  x.Nano := 0;
  x.Wday := 0;
  x.Yday := 0;
  WriteLn(DateOf(x), ' ', TimeOf(x), ' ', StampOf(x));
end;

