program sysmetadata;
uses sysutils, paslinux;
const Workers = 64;
var
  root, fileName, linkName, target, source, terminated, linkTerminated: string;
  baseHandle, handle, count, i, winners: Integer;
  info: TFileInfo;
  stamp: TFileTime;
  error: TSysError;
  data: TBytes;
  outcomes: array[0..Workers - 1] of Boolean;
  joined: waitgroup;

procedure Race(Index: Integer);
var localInfo: TFileInfo; localError: TSysError; localSource: string;
begin
  SetLastOSError(Index + 1);
  localSource := 'source-' + IntToStr(Index);
  outcomes[Index] := TryRenameFileAt(baseHandle, localSource, baseHandle,
    'winner', False, localError);
  if not outcomes[Index] and (localError.Code <> 17) then Halt(31);
  if not TryFileInfoAt(baseHandle, 'winner', True, localInfo, localError) then Halt(32);
  if not localInfo.IsRegular or (localInfo.Size <> 1) then Halt(33);
  if GetLastOSError <> Index + 1 then Halt(34);
  Yield;
  joined.Done;
end;

begin
  root := ParamStr(1) + '/metadata';
  if not CreateDir(root) then Halt(2);
  if not DirectoryExists(root) or FileExists(root) then Halt(3);
  if not TryOpenFileAt(CurrentDirectoryHandle, root, ODirectory, 0, baseHandle, error) then Halt(4);
  fileName := root + '/.data';
  handle := FileCreate(fileName, 384);
  if handle < 0 then Halt(5);
  data := BytesOf('exact metadata');
  if FileWrite(handle, data, Length(data)) <> Length(data) then Halt(6);
  stamp.Seconds := -1;
  stamp.Nanoseconds := 123456789;
  SetLastOSError(77);
  if not TrySetFileTimesAt(baseHandle, '.data', True, stamp, stamp, error) then Halt(7);
  if not TryHandleInfo(handle, info, error) then Halt(8);
  if not info.Has(fiSize or fiModified or fiAccessed or fiMode or fiType or fiInode) then Halt(9);
  if (info.Size <> Length(data)) or not info.IsRegular or info.IsDirectory then Halt(10);
  if (info.Modified.Seconds <> -1) or (info.Modified.Nanoseconds <> 123456789) then Halt(11);
  if (info.Accessed.Seconds <> -1) or (info.Accessed.Nanoseconds <> 123456789) then Halt(12);
  if info.Has(fiCreated) and ((info.Created.Nanoseconds < 0) or
    (info.Created.Nanoseconds >= 1000000000)) then Halt(13);
  if GetLastOSError <> 77 then Halt(14);
  stamp.Nanoseconds := 1000000000;
  if TrySetFileTimesAt(baseHandle, '.data', True, stamp, stamp, error) or
    (error.Code <> 22) then Halt(15);
  if FileSetDate(handle, 1700000000) <> 0 then Halt(16);
  if FileGetDate(handle) <> 1700000000 then Halt(17);
  FileClose(handle);
  if FileAge(fileName) <> 1700000000 then Halt(18);
  if not TrySetFileModeAt(baseHandle, '.data', 256, error) then Halt(19);
  if FileGetAttr(fileName) <> (faArchive or faHidden or faReadOnly) then Halt(20);
  linkName := root + '/link';
  terminated := '.data' + #0;
  linkTerminated := 'link' + #0;
  if Amd64 then count := Syscall(266, Integer(@terminated[1]), baseHandle, Integer(@linkTerminated[1]))
  else count := Syscall(36, Integer(@terminated[1]), baseHandle, Integer(@linkTerminated[1]));
  if count <> 0 then Halt(21);
  if not TryFileInfoAt(baseHandle, 'link', False, info, error) or not info.IsSymbolicLink then Halt(22);
  if not TryFileInfoAt(baseHandle, 'link', True, info, error) or not info.IsRegular then Halt(23);
  if not DeleteFile(fileName) then Halt(24);
  if FileExists(linkName) or not FileExists(linkName, False) then Halt(25);
  if DirectoryExists(linkName, False) then Halt(26); { not FPC's dangling-link-as-directory quirk }
  if (FileGetAttr(linkName) and faSymLink) = 0 then Halt(27);
  if not DeleteFile(linkName) then Halt(28);
  for i := 0 to Workers - 1 do
  begin
    source := root + '/source-' + IntToStr(i);
    handle := FileCreate(source, 384);
    data := BytesOf('x');
    data[0] := Byte(i);
    if FileWrite(handle, data, 1) <> 1 then Halt(29);
    FileClose(handle);
  end;
  joined.Add(Workers);
  for i := 0 to Workers - 1 do pas Race(i);
  joined.Wait;
  GcCollect;
  winners := 0;
  for i := 0 to Workers - 1 do
    if outcomes[i] then Inc(winners)
    else if not DeleteFile(root + '/source-' + IntToStr(i)) then Halt(35);
  if winners <> 1 then Halt(36);
  if not RenameFile(root + '/winner', root + '/renamed') then Halt(37);
  if not DeleteFile(root + '/renamed') then Halt(38);
  if TryFileInfoAt(baseHandle, 'bad' + #0, True, info, error) or (error.Code <> 22) then Halt(39);
  if TryHandleInfo(-1, info, error) or (error.Code <> 9) then Halt(40);
  FileClose(baseHandle);
  if not RemoveDir(root) then Halt(41);
  WriteLn('exact metadata, nanoseconds, symlinks');
  WriteLn('exclusive rename winners ', winners, '/', Workers);
end.
