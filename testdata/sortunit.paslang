{ P79: order. Numbers, reals and names sort in place; an array already
  sorted and one sorted backwards both come out right, and so does one
  full of the same value, which is where a careless quicksort goes
  quadratic or worse. Then the search says where a value is, and where
  a missing one would go. }
program sortunit;

uses
  paslib, pasrand, passort;

{ Orders to hand in. }
function Rising(A, B: Int64): Boolean;
begin
  Result := A < B;
end;

function Falling(A, B: Int64): Boolean;
begin
  Result := A > B;
end;

function ByLastDigitThenValue(A, B: Int64): Boolean;
begin
  if (A mod 10) <> (B mod 10) then
    Result := (A mod 10) < (B mod 10)
  else
    Result := A < B;
end;

function ShorterFirst(const A, B: string): Boolean;
begin
  if Length(A) <> Length(B) then
    Result := Length(A) < Length(B)
  else
    Result := A < B;
end;

var
  a: array of Int64;
  r: array of Real;
  s: array of string;
  i, n, bad: Integer;
  g: TRand;
  sum, sum2: Int64;
  line: string;

begin
  { A handful of numbers, by eye. }
  SetLength(a, 7);
  a[0] := 5;
  a[1] := 3;
  a[2] := 9;
  a[3] := 1;
  a[4] := 3;
  a[5] := -2;
  a[6] := 0;
  SortInts(a);
  line := '';
  for i := 0 to High(a) do
    line := line + IntToStr(a[i]) + ' ';
  WriteLn(line, IntsSorted(a));

  { Nothing, one, and two the wrong way round. }
  SetLength(a, 0);
  SortInts(a);
  WriteLn(Length(a), ' ', IntsSorted(a));
  SetLength(a, 1);
  a[0] := 42;
  SortInts(a);
  WriteLn(a[0]);
  SetLength(a, 2);
  a[0] := 2;
  a[1] := 1;
  SortInts(a);
  WriteLn(a[0], ' ', a[1]);

  { A thousand at random: sorted, and with the same numbers in it as
    before, which is what the sum says. }
  RandInit(g, 5);
  SetLength(a, 1000);
  sum := 0;
  for i := 0 to 999 do
  begin
    a[i] := RandBelow(g, 10000) - 5000;
    sum := sum + a[i];
  end;
  SortInts(a);
  sum2 := 0;
  for i := 0 to 999 do
    sum2 := sum2 + a[i];
  WriteLn(IntsSorted(a), ' ', sum = sum2, ' ', a[0] <= a[500], ' ',
    a[500] <= a[999]);

  { Already sorted, and sorted backwards: the pivot keeps both quick
    and, more to the point, right. }
  for i := 0 to 999 do
    a[i] := i;
  SortInts(a);
  WriteLn(IntsSorted(a), ' ', a[0], ' ', a[999]);
  for i := 0 to 999 do
    a[i] := 999 - i;
  SortInts(a);
  WriteLn(IntsSorted(a), ' ', a[0], ' ', a[999]);

  { A thousand of the same number. }
  for i := 0 to 999 do
    a[i] := 7;
  SortInts(a);
  WriteLn(IntsSorted(a), ' ', a[0], ' ', a[999]);

  { Looking things up in what is now sorted. }
  for i := 0 to 999 do
    a[i] := i * 2;
  WriteLn(FindInt(a, 0), ' ', FindInt(a, 1998), ' ', FindInt(a, 500), ' ',
    FindInt(a, 501), ' ', FindInt(a, -1));
  WriteLn(PlaceInt(a, 501), ' ', PlaceInt(a, -1), ' ', PlaceInt(a, 99999));

  { Reals. }
  SetLength(r, 5);
  r[0] := 2.5;
  r[1] := -1.5;
  r[2] := 0.0;
  r[3] := 10.25;
  r[4] := -1.75;
  SortReals(r);
  WriteLn(r[0], ' ', r[1], ' ', r[2], ' ', r[3], ' ', r[4], ' ',
    RealsSorted(r));

  { Names, which sort by what they say and not by where they sit. }
  SetLength(s, 8);
  s[0] := 'pear';
  s[1] := 'Apple';
  s[2] := 'fig';
  s[3] := 'apricot';
  s[4] := 'date';
  s[5] := 'fig';
  s[6] := 'ab';
  s[7] := 'abc';
  SortStrings(s);
  line := '';
  for i := 0 to High(s) do
    line := line + s[i] + ' ';
  WriteLn(line, StringsSorted(s));
  WriteLn(FindStr(s, 'date'), ' ', FindStr(s, 'fig'), ' ',
    FindStr(s, 'grape'), ' ', PlaceStr(s, 'grape'));

  { The order handed in, which is what Go's sort.Slice takes and what
    routine values (P81) made possible here. }
  SetLength(a, 9);
  for i := 0 to 8 do
    a[i] := (i * 7) mod 9;
  SortIntsBy(a, @Rising);
  line := '';
  for i := 0 to 8 do
    line := line + IntToStr(a[i]);
  Write(line, ' ');
  SortIntsBy(a, @Falling);
  line := '';
  for i := 0 to 8 do
    line := line + IntToStr(a[i]);
  Write(line, ' ');
  SortIntsBy(a, @ByLastDigitThenValue);
  line := '';
  for i := 0 to 8 do
    line := line + IntToStr(a[i]);
  WriteLn(line);

  { A nil order leaves the array alone instead of falling over. }
  SortIntsBy(a, nil);
  WriteLn(a[0], ' ', Length(a));

  { Names by length, then by what they say. }
  SetLength(s, 5);
  s[0] := 'pear';
  s[1] := 'fig';
  s[2] := 'apple';
  s[3] := 'date';
  s[4] := 'kiwi';
  SortStringsBy(s, @ShorterFirst);
  line := '';
  for i := 0 to 4 do
    line := line + s[i] + ' ';
  WriteLn(line);

  { Five hundred names made up out of numbers, to give the quicksort
    something to do. }
  SetLength(s, 500);
  RandInit(g, 11);
  for i := 0 to 499 do
    s[i] := 'n' + IntToStr(RandBelow(g, 100000));
  SortStrings(s);
  bad := 0;
  for i := 1 to 499 do
    if s[i] < s[i - 1] then
      bad := bad + 1;
  WriteLn(bad, ' ', StringsSorted(s), ' ', Length(s));
end.

