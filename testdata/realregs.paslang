    a := (b - ((d * t) * (i * 3)));
    if not (((i * 3) * 3.14159) <> (2.0 - c)) then x := x + 1;
  end;
  Result := (((i + j) - s) / (3.14159 * b)) + s + x;
end;

function F118(a, b, c, d: Double; i, j: Integer): Double;
var
  t, s: Double;
  k, x: Integer;
begin
  t := ((7.0 + 0.0) * i);
  s := 0.0;
  x := 0;
  k := 0;
  while (k < 6) and (((d * d) <> (d / s)) or (j > 3)) do
  begin
    s := s + ((((a + t) * (100.25 + a)) * ((3.14159 * j) * (t * (i + j)))) * (((t - t) / (t * j)) - ((s - b) / (c / s))));
    c := ((((2.0 - (i * 3)) + (-1.5)) * ((a * 3.14159) + (c - j))) - (((t - t) + (s + s)) * ((a / b) - 7.0)));
    if ((((t - s) + ((-1.5) + t)) - (1.0 - (a / d))) <> (((a + c) + (s + a)) + ((t + 7.0) + (t + s)))) then
      b := b
    else
      d := (((a / (a + 1.0)) + ((a / b) - (j * c))) - (2.0 + t));
    i := i + 1;
    k := k + 1;
  end;
  Result := ((1.0 * a) - (100.25 * s)) + s + x;
end;

function F119(a, b, c, d: Double; i, j: Integer): Double;
var
  t, s: Double;
  k, x: Integer;
begin
  t := i;
  s := 0.0;
  x := 0;
  k := 0;
  while (k < 9) and ((a / (-1.5)) <> (0.0 + b)) do
  begin
    i := i + 1;
    s := s + (100.25 - 3.14159);
    k := k + 1;
  end;
  Result := ((c - a) * s) + s + x;
end;

function TryLoop(a: Double; n: Integer): Double;
var
  s, t: Double;
  i, z: Integer;
begin
  s := 1.0;
  t := a;
  z := 3;
  try
    for i := 0 to n do
    begin
      s := s * 1.5 + t;
      t := t - 0.25;
      z := z - 1;
      i := i + 10 div z;
    end;
  except
    s := s + 1000.0 + t;
  end;
  Result := s + t;
end;

procedure Mix(X: Double);
var
  b: Int64;
begin
  b := 0;
  Move(X, b, 8);
  if X <> X then
    b := 7;
  h := (h * 1000003 + b) xor (h shr 29);
  calls := calls + 1;
end;

function Shapes(a, b: Double; i: Integer; f: Single): Double;
var
  s: Single;
  t: Double;
begin
  s := f;
  t := a * s + b / s - i * a;
  gd := t * 2.0 + gd;
  ga[i and 3] := ga[i and 3] + t;
  rec.p := rec.p * a + b;
  rec.q := rec.q - rec.p / 3.0;
  rec.n := rec.n + i;
  if (a < b) = (t > gd) then
    t := t + 1.0;
  Result := t + gd + ga[i and 3] + rec.p - rec.q + rec.n;
end;

