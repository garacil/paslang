{ P633: a static array goes into a const or a value array of T parameter,
  as Pascal's open array parameter takes it: the routine sees its
  elements from 0 to its length less one, and may change what it may
  through the written slice a[Low(a)..High(a)], which is what it is
  given. Arrays of any index type and element; overloads that matched
  before match the same; a method, a nested routine and a call through
  a routine value take it too. }
program openarr;

uses
  sysutils;

type
  TColor = (Red, Green, Blue);
  TRow = array[0..2] of Integer;
  TPoint = record
    X, Y: Integer;
  end;

  TBag = class
  public
    Sum: Integer;
    procedure AddAll(const V: array of Integer);
  end;

  TTotal = function(const V: array of Integer): Integer;

  TBox = record
    Cells: array[1..3] of Integer;
  end;

const
  Primes: array[0..3] of Integer = (2, 3, 5, 7);

var
  a: array[0..2] of Integer;
  b: array[1..5] of Integer;
  byColor: array[TColor] of Integer;
  letters: array['a'..'e'] of Char;
  names: array[0..1] of string;
  points: array[0..1] of TPoint;
  grid: array[0..1] of TRow;
  row: TRow;
  bag: TBag;
  f: TTotal;
  i: Integer;
  c: TColor;
  box: TBox;
  pbox: ^TBox;

function Total(const V: array of Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := Low(V) to High(V) do
    Result := Result + V[i];
end;

function Shape(const V: array of Integer): string;
begin
  Result := IntToStr(Low(V)) + '..' + IntToStr(High(V)) + ', ' + IntToStr(Length(V)) + ' elements';
end;

{ a value parameter: an element written goes to the array, as through the
  written slice; SetLength makes a block of its own }
procedure Change(V: array of Integer);
begin
  V[0] := 100;
  SetLength(V, 10);
  V[1] := 200;
end;

function Spelled(const V: array of Char): string;
var
  ch: Char;
begin
  Result := '';
  for ch in V do
    Result := Result + ch;
end;

function Joined(const V: array of string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to High(V) do
    Result := Result + V[i] + ';';
end;

function SumX(const V: array of TPoint): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(V) do
    Result := Result + V[i].X * 10 + V[i].Y;
end;

function Rows(const V: array of TRow): Integer;
var
  i, j: Integer;
begin
  Result := 0;
  for i := 0 to High(V) do
    for j := 0 to 2 do
      Result := Result + V[i][j];
end;

{ overloads: the one that matched before still does }
function Pick(const V: array of Integer): string; overload;
begin
  Result := 'array of Integer';
end;

function Pick(const V: TRow): string; overload;
begin
  Result := 'TRow';
end;

function Pick(N: Integer): string; overload;
begin
  Result := 'Integer';
end;

function Only(const V: array of Integer): string; overload;
begin
  Result := 'array of Integer, ' + IntToStr(Length(V));
end;

function Only(const S: string): string; overload;
begin
  Result := 'string';
end;

procedure TBag.AddAll(const V: array of Integer);
var
  i: Integer;
begin
  for i := 0 to High(V) do
    Sum := Sum + V[i];
end;

function MakeRow: TRow;
begin
  Result[0] := 4;
  Result[1] := 5;
  Result[2] := 6;
end;

function Outer: Integer;

  function Inner(const V: array of Integer): Integer;
  begin
    Result := Length(V) * 1000 + V[High(V)];
  end;

begin
  Result := Inner(b);
end;

begin
  for i := 0 to 2 do
    a[i] := i + 1;
  for i := 1 to 5 do
    b[i] := i * 10;
  for c := Low(TColor) to High(TColor) do
    byColor[c] := Ord(c) + 7;
  letters['a'] := 'h';
  letters['b'] := 'e';
  letters['c'] := 'l';
  letters['d'] := 'l';
  letters['e'] := 'o';
  names[0] := 'one';
  names[1] := 'two';
  points[0].X := 1;
  points[0].Y := 2;
  points[1].X := 3;
  points[1].Y := 4;
  grid[0] := a;
  grid[1][0] := 5;
  grid[1][1] := 6;
  grid[1][2] := 7;
  row := a;

  WriteLn('const, 0..2: ', Total(a), ' as the slice gives ', Total(a[Low(a)..High(a)]));
  WriteLn('1..5: ', Total(b), ', seen as ', Shape(b));
  WriteLn('by an enumeration: ', Total(byColor), ', seen as ', Shape(byColor));
  WriteLn('by characters: ', Spelled(letters));
  WriteLn('strings: ', Joined(names));
  WriteLn('records: ', SumX(points));
  WriteLn('arrays: ', Rows(grid));
  Change(a);
  WriteLn('a value parameter wrote a[0]: ', a[0], ', and its SetLength left a[1]: ', a[1]);
  a[0] := 1;
  Change(a[Low(a)..High(a)]);
  WriteLn('the written slice does the same: ', a[0], ' ', a[1]);
  WriteLn('overloads: ', Pick(row), ', ', Pick(a), ', ', Pick(b), ', ', Pick(3));
  WriteLn('one overload left: ', Only(b), ', ', Only('x'));
  bag := TBag.Create;
  bag.AddAll(b);
  bag.AddAll(a);
  WriteLn('a method: ', bag.Sum);
  WriteLn('a nested routine: ', Outer);
  f := @Total;
  WriteLn('through a routine value: ', f(b));
  box.Cells[1] := 1;
  box.Cells[2] := 2;
  box.Cells[3] := 3;
  New(pbox);
  pbox^ := box;
  WriteLn('a typed constant: ', Total(Primes), ', a field: ', Total(box.Cells), ', through a pointer: ',
    Total(pbox^.Cells), ', an element: ', Total(grid[1]), ', a result: ', Total(MakeRow));
end.

