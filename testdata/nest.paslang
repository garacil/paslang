program nest;

procedure Outer;
var
  n: Integer;
  procedure Inner;
  begin
    WriteLn(n);
  end;
  function Deep(K: Integer): Integer;
  begin
    if K <= 0 then
    begin
      Inner;
      Result := 1;
    end
    else
      Result := Deep(K - 1) + 1;
  end;
begin
  n := 7;
  WriteLn(Deep(2000));
end;

begin
  Outer;
end.
