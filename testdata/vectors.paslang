  WriteLn('Sub16 ', h);
  h := 0;
  for i := 0 to 11 do
  begin
    r := VAdd32(a[i], b[i]);
    Mix(@r, 32);
    q := VAdd32(Lo(a[i]), Lo(b[i]));
