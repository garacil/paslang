  begin
    r := VShrU64(a[i], 0);
    Mix(@r, 32);
    q := VShrU64(Lo(a[i]), 0);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrU64(a[i], 5);
    Mix(@r, 32);
    q := VShrU64(Lo(a[i]), 5);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrU64(a[i], 16);
    Mix(@r, 32);
    q := VShrU64(Lo(a[i]), 16);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrU64(a[i], 40);
    Mix(@r, 32);
    q := VShrU64(Lo(a[i]), 40);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrU64(a[i], 300);
    Mix(@r, 32);
    q := VShrU64(Lo(a[i]), 300);
    Mix(@q, 16);
  end;
  WriteLn('ShrU64 const ', h);
  h := 0;
  for i := 0 to 11 do
    for k := 0 to 15 do
    begin
      r := VShrS16(a[i], cnt[k]);
      Mix(@r, 32);
      q := VShrS16(Lo(a[i]), cnt[k]);
      Mix(@q, 16);
    end;
  WriteLn('ShrS16 ', h);
  h := 0;
  for i := 0 to 11 do
  begin
    r := VShrS16(a[i], 0);
    Mix(@r, 32);
    q := VShrS16(Lo(a[i]), 0);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrS16(a[i], 5);
    Mix(@r, 32);
    q := VShrS16(Lo(a[i]), 5);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrS16(a[i], 16);
    Mix(@r, 32);
    q := VShrS16(Lo(a[i]), 16);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrS16(a[i], 40);
    Mix(@r, 32);
    q := VShrS16(Lo(a[i]), 40);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrS16(a[i], 300);
    Mix(@r, 32);
    q := VShrS16(Lo(a[i]), 300);
    Mix(@q, 16);
  end;
  WriteLn('ShrS16 const ', h);
  h := 0;
  for i := 0 to 11 do
    for k := 0 to 15 do
    begin
      r := VShrS32(a[i], cnt[k]);
      Mix(@r, 32);
      q := VShrS32(Lo(a[i]), cnt[k]);
      Mix(@q, 16);
    end;
  WriteLn('ShrS32 ', h);
  h := 0;
  for i := 0 to 11 do
  begin
    r := VShrS32(a[i], 0);
    Mix(@r, 32);
    q := VShrS32(Lo(a[i]), 0);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrS32(a[i], 5);
    Mix(@r, 32);
    q := VShrS32(Lo(a[i]), 5);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrS32(a[i], 16);
    Mix(@r, 32);
    q := VShrS32(Lo(a[i]), 16);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrS32(a[i], 40);
    Mix(@r, 32);
    q := VShrS32(Lo(a[i]), 40);
    Mix(@q, 16);
  end;
  for i := 0 to 11 do
  begin
    r := VShrS32(a[i], 300);
    Mix(@r, 32);
    q := VShrS32(Lo(a[i]), 300);
    Mix(@q, 16);
  end;
  WriteLn('ShrS32 const ', h);
  h := 0;
  for k := 0 to 10 do
  begin
    r := VSplat8(sp[k]);
    Mix(@r, 32);
    q := VSplat8(sp[k]);
    Mix(@q, 16);
  end;
  for k := 0 to 10 do
  begin
    r := VSplat16(sp[k]);
    Mix(@r, 32);
    q := VSplat16(sp[k]);
    Mix(@q, 16);
  end;
  for k := 0 to 10 do
  begin
    r := VSplat32(sp[k]);
    Mix(@r, 32);
    q := VSplat32(sp[k]);
    Mix(@q, 16);
  end;
  for k := 0 to 10 do
  begin
    r := VSplat64(sp[k]);
    Mix(@r, 32);
    q := VSplat64(sp[k]);
    Mix(@q, 16);
  end;
  WriteLn('Splat ', h);
  h := 0;
  for i := 0 to 11 do
  begin
    r := VSelect(m[i], a[i], b[i]);
    Mix(@r, 32);
    q := VSelect(Lo(m[i]), Lo(a[i]), Lo(b[i]));
    Mix(@q, 16);
    r := VNot(a[i]);
    Mix(@r, 32);
    q := VNot(Lo(a[i]));
    Mix(@q, 16);
  end;
  WriteLn('Select Not ', h);
  h := 0;
  for i := 0 to 11 do
  begin
    r := a[i] xor b[i];
    Mix(@r, 32);
    r := a[i] nand b[i];
    Mix(@r, 32);
    r := a[i] andnot b[i];
    Mix(@r, 32);
    r := a[i] xnor b[i];
    Mix(@r, 32);
    r := not (a[i] or b[i]);
    Mix(@r, 32);
    r := a[i];
    r xor= b[i];
    r or= m[i];
    Mix(@r, 32);
    r := VAdd16(VMul16(a[i], b[i]), VSub16(VSplat16(3), VXor(a[i], m[i])));
    Mix(@r, 32);
    r := VCmpGtU16(VMaxS32(VAdd32(a[i], b[i]), VMinU32(a[i], VSplat32(1000))), VAvgU16(a[i], b[i]));
    Mix(@r, 32);
    q := Twice(Lo(a[i]));
    Mix(@q, 16);
    r := Twice256(VSub8(a[i], b[i]));
    Mix(@r, 32);
  end;
  WriteLn('Operators ', h);
end.

