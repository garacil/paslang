program slicereg;

{ A loop that only reads a slice keeps its pointer and length in
  registers (P100, 1.0.97); a loop that assigns the slice reads them from
  memory, so it sees the new one at once. }

var
  a, b: array of Integer;
  i, j, sum: Integer;

procedure Local;
var
  s: array of Byte;
  k, t: Integer;
begin
  SetLength(s, 100);
  for k := 0 to 99 do
    s[k] := Byte(k);
  t := 0;
  for k := 0 to High(s) do
    t := t + s[k];
  WriteLn(t);
end;

begin
  SetLength(a, 10);
  SetLength(b, 3);
  for i := 0 to 9 do
    a[i] := i + 1;
  for i := 0 to 2 do
    b[i] := 100;
  sum := 0;
  for i := 0 to 9 do
    sum := sum + a[i];
  WriteLn(sum);
  { The loop assigns a: the rest of it reads b's elements. }
  sum := 0;
  for i := 0 to 2 do
  begin
    sum := sum + a[i];
    if i = 0 then
      a := b;
  end;
  WriteLn(sum, ' ', Length(a));
  sum := 0;
  for i := 0 to 2 do
    for j := 0 to High(a) do
      sum := sum + a[j] * i;
  WriteLn(sum);
  Local;
end.

