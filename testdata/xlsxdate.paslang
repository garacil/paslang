{ P563: the date a cell holds. XlsxSerialToDate turns a serial of the 1900
  or the 1904 date system into a civil date and time of day (the serials
  are kept as the texts a cell would have, so scripts/xlsxdate_check.py
  reads the same decimal and checks every line with Python's datetime);
  XlsxParseIsoDate reads the ISO 8601 text of a t="d" cell. On the two
  template books of testdata/xlsxtpl.txt (tpl1 in the 1900 system, tpl2 in
  the 1904 one) GetNumber, GetDate, GetDateTime, DateText and DateTimeText
  read the cells that are there (a date, a number, a Boolean, an error, a
  string, a formula's value, an empty cell, no cell), the dates SetDateTime
  wrote come back as they went (the 28 February and the 1 March 1900 around
  the day that never was, 1 January 1904, the last day of 9999), numbers
  written as text give their dates or none, and a t="d" cell put into the
  sheet is read as its text. }
program xlsxdate;

uses
  paslib, sysutils, pascodec, pasflate, paszip, pasxml, pasxlsx;

function Template(const Name: string): string;
var
  corpus, line: string;
  p, nl, q: Integer;
begin
  Result := '';
  if not ReadFile('testdata/xlsxtpl.txt', corpus) then
  begin
    WriteLn('no testdata/xlsxtpl.txt');
    Halt(2);
  end;
  p := 1;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    q := Pos(' ', line);
    if Copy(line, 1, q - 1) = Name then
    begin
      if not Base64Decode(Copy(line, q + 1, Length(line)), False, True, Result) then
      begin
        WriteLn('bad base64');
        Halt(2);
      end;
      Exit;
    end;
  end;
  WriteLn('no template ', Name);
  Halt(2);
end;

function Two(N: Integer): string;
begin
  Result := IntToStr(N);
  if N < 10 then
    Result := '0' + Result;
end;

function Stamp(Y, M, D, H, Mi, S: Integer): string;
begin
  Result := IntToStr(Y);
  while Length(Result) < 4 do
    Result := '0' + Result;
  Result := Result + '-' + Two(M) + '-' + Two(D) + ' ' + Two(H) + ':' + Two(Mi) + ':' + Two(S);
end;

{ a serial given as the text a cell would hold }
procedure Serial(const Text: string; Date1904: Boolean);
var
  x: Double;
  y, m, d, h, mi, s: Integer;
  sys: string;
begin
  if Date1904 then
    sys := '1904'
  else
    sys := '1900';
  if not TryStrToFloat(Text, x) then
  begin
    WriteLn('serial ', sys, ' ', Text, ' -> not a number');
    Exit;
  end;
  y := 1;
  m := 2;
  d := 3;
  h := 4;
  mi := 5;
  s := 6;
  if XlsxSerialToDate(x, Date1904, y, m, d, h, mi, s) then
    WriteLn('serial ', sys, ' ', Text, ' -> ', Stamp(y, m, d, h, mi, s))
  else
    WriteLn('serial ', sys, ' ', Text, ' -> none ', y, m, d, h, mi, s);
end;

procedure Iso(const Text: string);
var
  y, m, d, h, mi, s: Integer;
begin
  y := 1;
  m := 2;
  d := 3;
  h := 4;
  mi := 5;
  s := 6;
  if XlsxParseIsoDate(Text, y, m, d, h, mi, s) then
    WriteLn('iso ', Text, ' -> ', Stamp(y, m, d, h, mi, s))
  else
    WriteLn('iso ', Text, ' -> none ', y, m, d, h, mi, s);
end;

{ every reading word on one cell }
procedure Cell(const Tag: string; S: TXlsxSheet; const Ref: string);
var
  v: Double;
  y, m, d, h, mi, sc: Integer;
  num, dt: string;
begin
  v := 7;
  if S.GetNumber(Ref, v) then
    num := FloatToStr(v)
  else
    num := 'none ' + FloatToStr(v);
  y := 1;
  m := 2;
  d := 3;
  h := 4;
  mi := 5;
  sc := 6;
  if S.GetDateTime(Ref, y, m, d, h, mi, sc) then
    dt := Stamp(y, m, d, h, mi, sc)
  else
    dt := 'none ' + IntToStr(y) + IntToStr(m) + IntToStr(d) + IntToStr(h) + IntToStr(mi) + IntToStr(sc);
  y := 1;
  m := 2;
  d := 3;
  if S.GetDate(Ref, y, m, d) then
    dt := dt + ' date ' + IntToStr(y) + '/' + IntToStr(m) + '/' + IntToStr(d)
  else
    dt := dt + ' date none ' + IntToStr(y) + IntToStr(m) + IntToStr(d);
  WriteLn(Tag, ' ', Ref, ' t=', S.CellType(Ref), ' [', S.GetText(Ref), '] number ', num, ' -> ', dt, ' | [', S.DateText(Ref), '] [',
    S.DateTimeText(Ref), ']');
end;

procedure Cells(const Tag: string; B: TXlsxBook);
var
  s: TXlsxSheet;
begin
  s := B.Sheet(0);
  WriteLn(Tag, ': date1904 ', BoolToStr(B.Date1904, True));
  Cell(Tag, s, 'A2');
  Cell(Tag, s, 'B2');
  Cell(Tag, s, 'C2');
  Cell(Tag, s, 'D2');
  Cell(Tag, s, 'E2');
  Cell(Tag, s, 'A3');
  Cell(Tag, s, 'B4');
  Cell(Tag, s, 'B5');
  Cell(Tag, s, 'D5');
  Cell(Tag, s, 'F5');
  Cell(Tag, s, 'A6');
  Cell(Tag, s, 'Z9');
  { dates written come back as they went }
  s.SetDateTime('H1', 2024, 10, 24, 13, 45, 30);
  if B.Date1904 then
  begin
    { the days around the 1900 system's day that never was lie before the 1904 epoch }
    s.SetDate('H2', 1904, 2, 29);
    s.SetDate('H3', 1904, 3, 1);
  end
  else
  begin
    s.SetDate('H2', 1900, 2, 28);
    s.SetDate('H3', 1900, 3, 1);
  end;
  s.SetDate('H4', 1904, 1, 1);
  s.SetDate('H5', 1904, 1, 2);
  s.SetDate('H6', 9999, 12, 31);
  s.SetDateTime('H7', 1970, 1, 1, 0, 0, 1);
  s.SetDateTime('H8', 2024, 2, 29, 23, 59, 59);
  s.SetDateTime('H9', 2024, 9, 9, 9, 9, 9);
  Cell(Tag, s, 'H1');
  Cell(Tag, s, 'H2');
  Cell(Tag, s, 'H3');
  Cell(Tag, s, 'H4');
  Cell(Tag, s, 'H5');
  Cell(Tag, s, 'H6');
  Cell(Tag, s, 'H7');
  Cell(Tag, s, 'H8');
  Cell(Tag, s, 'H9');
  { numbers written as text: the serials a sheet may hold }
  s.SetNumber('I1', '60');
  s.SetNumber('I2', '59');
  s.SetNumber('I3', '61');
  s.SetNumber('I4', '0');
  s.SetNumber('I5', '2958465');
  s.SetNumber('I6', '2958466');
  s.SetNumber('I7', '-1');
  s.SetNumber('I8', '4.5589E4');
  s.SetNumber('I9', '0.5');
  s.SetNumber('I10', '45589.5729166667');
  s.SetNumber('I11', '2957003');
  s.SetText('I12', '45589');
  s.SetBool('I13', True);
  Cell(Tag, s, 'I1');
  Cell(Tag, s, 'I2');
  Cell(Tag, s, 'I3');
  Cell(Tag, s, 'I4');
  Cell(Tag, s, 'I5');
  Cell(Tag, s, 'I6');
  Cell(Tag, s, 'I7');
  Cell(Tag, s, 'I8');
  Cell(Tag, s, 'I9');
  Cell(Tag, s, 'I10');
  Cell(Tag, s, 'I11');
  Cell(Tag, s, 'I12');
  Cell(Tag, s, 'I13');
end;

{ a t="d" cell, which no writing word makes: put into the sheet's part and read from the saved book }
procedure DateCells;
var
  b, b2: TXlsxBook;
  part: string;
begin
  b := TXlsxBook.Open(Template('tpl1'));
  part := b.ReadPart('xl/worksheets/sheet1.xml');
  if (Pos('<c r="A2" s="1"/>', part) = 0) or (Pos('<c r="B2" s="4"><v>1234.5</v></c>', part) = 0) then
  begin
    WriteLn('tpl1 is not the template this test knows');
    Halt(2);
  end;
  part := StringReplace(part, '<c r="A2" s="1"/>', '<c r="A2" s="1" t="d"><v>2024-10-24T13:45:30</v></c>', []);
  part := StringReplace(part, '<c r="C3" s="2"/>', '<c r="C3" s="2" t="d"><v> 1999-12-31 </v></c>', []);
  part := StringReplace(part, '<c r="F6" s="1"/>', '<c r="F6" s="1" t="d"><v>2024-13-01</v></c>', []);
  part := StringReplace(part, '<c r="B2" s="4"><v>1234.5</v></c>', '<c r="B2" s="4"><v>abc</v></c>', []);
  part := StringReplace(part, '<c r="B3" s="4"><v>10</v></c>', '<c r="B3" s="4"><v>1e400</v></c>', []);
  part := StringReplace(part, '<c r="B4" s="4"><v>20.25</v></c>', '<c r="B4" s="4" t="n"><v>  45589  </v></c>', []);
  part := StringReplace(part, '<c r="D2" t="b"><v>1</v></c>', '<c r="D2"><v></v></c>', []);
  part := StringReplace(part, '<c r="E2" t="e"><v>#DIV/0!</v></c>', '<c r="E2" t="d"><v></v></c>', []);
  part := StringReplace(part, '<c r="A3" t="s"><v>4</v></c>', '<c r="A3" t="d"><v>0999-12-31T09:09:09</v></c>', []);
  b.SetPart('xl/worksheets/sheet1.xml', part);
  b2 := TXlsxBook.Open(b.Save);
  Cell('tpl1d', b2.Sheet(0), 'A2');
  Cell('tpl1d', b2.Sheet(0), 'C3');
  Cell('tpl1d', b2.Sheet(0), 'F6');
  Cell('tpl1d', b2.Sheet(0), 'B2');
  Cell('tpl1d', b2.Sheet(0), 'B3');
  Cell('tpl1d', b2.Sheet(0), 'B4');
  Cell('tpl1d', b2.Sheet(0), 'D2');
  Cell('tpl1d', b2.Sheet(0), 'E2');
  Cell('tpl1d', b2.Sheet(0), 'A3');
end;

const
  Serials: array[0..39] of string = ('0', '1', '2', '59', '60', '61', '366', '1521', '25569', '36584', '36585', '36586', '38045',
    '38046', '38047', '45382', '45473', '45474', '45589', '45589.5729166667', '45589.99999', '45589.9999999', '73109', '73110',
    '146157', '146158', '182682', '182683', '2958101', '2958465', '2958466', '2957003', '2957004', '-1', '-0.5', '0.5', '1e300',
    '12345678901234567890', '3000000', '45544.3813541667');
  Isos: array[0..70] of string = ('2024-10-24', '2024-10-24T13:45:30', '2024-10-24 13:45', '2024-10-24T13:45:30.5Z',
    '2024-10-24T13:45:30,25+02:00', '2024-10-24T13:45:30-0500', '2024-02-29', '2023-02-29', '2000-02-29', '1900-02-29',
    '2024-13-01', '2024-00-10', '2024-10-32', '24-10-2024', '2024-10-24T24:00', '2024-10-24T23:60', '2024-10-24T23:59:60',
    '2024-10-24T13:45:30.', '2024-10-24x', '', '2024-01-31', '2024-03-31', '2024-04-30', '2024-04-31', '2024-05-31',
    '2024-06-31', '2024-07-31', '2024-08-31', '2024-09-31', '2024-10-31', '2024-11-31', '2024-12-31', '2024-02-30',
    '2023-02-28', '2100-02-29', '2024-10-01', '2024-10-02', '2024/10/24', '2024-10/24', '2024-1', '2024-10-2',
    '2024-10-24T1', '2024-10-24T13', '2024-10-24T13-45', '2024-10-24T13:4', '2024-10-24T13:45:', '2024-10-24T13:45:3',
    '2024-10-24T13:45:30.x', '2024-10-24T13:45:30.0', '2024-10-24T13:45:30.9Z', '2024-10-24T13:45:30.123Z',
    '2024-10-24T13:45:30+02', '2024-10-24T13:45:30+0200', '2024-10-24T13:45:30+02:3', '2024-10-24T23:59:59',
    '2024-10-24T00:00:00', '2024-10-24T13:45:30Z ', ' 2024-10-24', '2024-10-24T', '2024-10-24T13:45:30:00', '2024-10-24T13:45:30+',
    '2024-1/-24', '2024-10-2/', '2024-10-24T1/:00', '2009-09-09T09:09:09', '0999-12-31', '0001-01-01', '202-10-24', '2024', '2024-10-24T13:45:30.Z', '2024-10-00');

{ every whole-day serial of a system, from 0 to the last day of 9999, is the day after the one before it }
procedure Sweep(Date1904: Boolean);
var
  z, last, y, m, d, h, mi, s, ey, em, ed, days, bad: Integer;
begin
  if Date1904 then
  begin
    last := 2957003;
    ey := 1904;
    em := 1;
    ed := 1;
  end
  else
  begin
    last := 2958465;
    ey := 1899;
    em := 12;
    ed := 31;
  end;
  bad := 0;
  for z := 0 to last do
  begin
    if (not Date1904) and (z = 60) then
    begin
      if XlsxSerialToDate(z, Date1904, y, m, d, h, mi, s) then
        bad := bad + 1;
      Continue;
    end;
    if (not XlsxSerialToDate(z, Date1904, y, m, d, h, mi, s)) or (y <> ey) or (m <> em) or (d <> ed) or (h <> 0) or (mi <> 0) or
      (s <> 0) then
    begin
      bad := bad + 1;
      if bad <= 3 then
        WriteLn('sweep: serial ', z, ' gives ', y, '-', m, '-', d, ' ', h, ':', mi, ':', s, ' and not ', ey, '-', em, '-', ed);
    end;
    { the next day of the calendar }
    case em of
      1, 3, 5, 7, 8, 10, 12: days := 31;
      4, 6, 9, 11: days := 30;
    else
      if ((ey mod 4 = 0) and (ey mod 100 <> 0)) or (ey mod 400 = 0) then
        days := 29
      else
        days := 28;
    end;
    ed := ed + 1;
    if ed > days then
    begin
      ed := 1;
      em := em + 1;
      if em > 12 then
      begin
        em := 1;
        ey := ey + 1;
      end;
    end;
  end;
  if XlsxSerialToDate(last + 1, Date1904, y, m, d, h, mi, s) then
    bad := bad + 1;
  WriteLn('sweep ', BoolToStr(Date1904, True), ': ', last + 1, ' days, ', bad, ' wrong');
end;

var
  i: Integer;
begin
  for i := 0 to High(Serials) do
  begin
    Serial(Serials[i], False);
    Serial(Serials[i], True);
  end;
  for i := 0 to High(Isos) do
    Iso(Isos[i]);
  Sweep(False);
  Sweep(True);
  Cells('tpl1', TXlsxBook.Open(Template('tpl1')));
  Cells('tpl2', TXlsxBook.Open(Template('tpl2')));
  DateCells;
end.
