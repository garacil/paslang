{ P205: a value of any type with a JSON form written by JsonEncode,
  through the encoder the compiler writes for its type, and JsonOf. What
  scripts/jsonmodel.py holds to Go's v2 (integers, strings, reals,
  arrays, records, maps, pointers, bytes, json and the directives) is
  here too, with what Go has not: enumerations, sets, Char, Quad,
  Currency, Single, TDateTime as RFC 3339, static arrays indexed by an
  enumeration, trees, classes with properties and ancestors, names that
  need escapes, EscapeHtml, RFC 8785's form, the zero of a record for
  omitzero, embed through a pointer, and every error with its pointer. }
program jsonbind1;

uses
  sysutils;

type
  TColor = (Red, Green, Blue);
  TColors = set of TColor;
  TDigit = 0..9;

  PNode = ^TNode;
  TNode = record
    V: Integer json 'v';
    Next: PNode json 'next' omitempty;
  end;

  TPoint = record
    X, Y: Integer;
  end;

  TBase = record
    Id: Integer json 'id';
    Kind: string json 'kind';
  end;
  TMore = record
    Score: Integer json 'score';
    Tag: string;
  end;
  PMore = ^TMore;

  TMeta = record
    Base: TBase json embed;
    More: PMore json embed;
    Extra: json json unknown;
  end;

  TAnimal = class
  private
    FName: string;
    FLegs: Integer;
  public
    Weight: Single;
    property Name: string read FName write FName json 'name';
    property Legs: Integer read FLegs write FLegs json 'legs' omitzero;
  end;

  TDog = class(TAnimal)
  public
    Good: Boolean json 'good';
  end;

  TAll = record
    Q: Quad;
    QQ: Quad json quoted;
    C: Currency;
    CQ: Currency json quoted;
    S: Single;
    Ch: Char;
    Digit: TDigit;
    Bytes: array of Byte;
    Fixed: array[0..3] of Byte;
    Grid: array[1..2] of Integer;
    ByColor: array[TColor] of Integer;
    Colors: TColors;
    Small: set of Byte;
    Letters: set of Char;
    M: map[string] of Integer;
    MI: map[Integer] of string;
    ME: map[TColor] of Boolean;
    MC: map[Char] of Integer;
    MB: map[Boolean] of Integer;
    T: tree[string] of Boolean;
    TI: tree[Integer] of Integer;
    NoMap: map[string] of Integer;
    When: TDateTime json rfc3339;
    Pet: TAnimal;
    NoPet: TAnimal;
    Raw: json;
    Big: Int64 json quoted;
    Origin: TPoint json omitzero;
    Corner: TPoint json omitzero;
    Pair: array[0..1] of Integer json omitzero;
  end;

  TNames = record
    A: Integer json 'quote"back\slash';
    B: Integer json 'tab'#9'and'#1;
    C: Integer json '<&>';
    D: Integer json 'ünï日本';
  end;

var
  a: TAll;
  m: TMeta;
  more: TMore;
  n1, n2: TNode;
  names: TNames;
  dog: TDog;
  opts: TJsonOptions;
  j: json;

procedure Fail(const What: string);
begin
  try
    WriteLn(What, ': ', JsonEncode(a));
  except
    on e: EJsonError do
      WriteLn(What, ': ', e.Message, ' | ', e.Path, ' | ', Ord(e.Kind));
  end;
end;

begin
  a.Q := 1.5;
  a.QQ := -0.000125;
  a.C := 12.3400;
  a.CQ := -7;
  a.S := 0.1;
  a.Ch := 'z';
  a.Digit := 7;
  SetLength(a.Bytes, 5);
  a.Bytes[0] := 104;
  a.Bytes[1] := 105;
  a.Bytes[2] := 33;
  a.Bytes[3] := 0;
  a.Bytes[4] := 255;
  a.Fixed[0] := 1;
  a.Fixed[3] := 2;
  a.Grid[1] := 10;
  a.Grid[2] := 20;
  a.ByColor[Green] := 7;
  a.Colors := [Red, Blue];
  a.Small := [3, 200];
  a.Letters := ['b', 'a', '"'];
  New(a.M);
  a.M['b'] := 2;
  a.M['a'] := 1;
  a.M['c'] := 3;
  New(a.MI);
  a.MI[10] := 'ten';
  a.MI[-1] := 'minus';
  a.MI[3] := 'three';
  New(a.ME);
  a.ME[Blue] := True;
  a.ME[Red] := False;
  New(a.MC);
  a.MC['y'] := 1;
  a.MC['x'] := 2;
  New(a.MB);
  a.MB[True] := 1;
  a.MB[False] := 0;
  New(a.T);
  a.T['y'] := True;
  a.T['x'] := False;
  New(a.TI);
  a.TI[10] := 1;
  a.TI[-1] := 2;
  a.TI[3] := 3;
  a.When := EncodeDate(2026, 10, 14) + EncodeTime(13, 5, 9, 250);
  a.Pet := TAnimal.Create;
  a.Pet.Name := 'Rex';
  a.Pet.Weight := 12.5;
  a.Raw := JsonParse('{"k":[1,2]}');
  a.Big := 9007199254740993;
  a.Corner.Y := 1;
  WriteLn(JsonEncode(a));
  WriteLn(JsonEncode(a, JsonPretty) = JsonEncode(JsonParse(JsonEncode(a)), JsonPretty));
  WriteLn(JsonEncode(a, JsonCanonical) = JsonEncode(JsonParse(JsonEncode(a)), JsonCanonical));
  WriteLn(JsonOf(a)['ME']['Blue'], ' ', JsonOf(a)['When'], ' ', JsonOf(a).At('/Pet/name'));

  { embed through a record and a pointer, and the members json unknown keeps }
  m.Base.Id := 5;
  m.Base.Kind := 'x';
  WriteLn(JsonEncode(m));
  m.Extra := JsonParse('{"more":true,"n":1}');
  more.Score := 9;
  more.Tag := 't';
  m.More := @more;
  WriteLn(JsonEncode(m));
  m.Extra := JsonParse('[1]');
  try
    WriteLn(JsonEncode(m));
  except
    on e: EJsonError do
      WriteLn('unknown: ', e.Message);
  end;

  { a list through pointers, and a cycle cut by MaxDepth }
  n1.V := 1;
  n2.V := 2;
  n1.Next := @n2;
  WriteLn(JsonEncode(n1));
  n2.Next := @n1;
  opts := JsonDefaults;
  opts.MaxDepth := 50;
  try
    WriteLn(JsonEncode(n1, opts));
  except
    on e: EJsonError do
      WriteLn('cycle: ', e.Reason, ' ', Length(e.Path), ' ', Ord(e.Kind));
  end;

  { names that need escapes, and EscapeHtml }
  names.A := 1;
  WriteLn(JsonEncode(names));
  opts := JsonDefaults;
  opts.EscapeHtml := True;
  WriteLn(JsonEncode(names, opts));

  { a class with an ancestor, by its static type }
  dog := TDog.Create;
  dog.Name := 'Fido';
  dog.Legs := 4;
  dog.Good := True;
  WriteLn(JsonEncode(dog));
  WriteLn(JsonEncode(dog, JsonPretty));
  dog.Free;

  { values alone }
  WriteLn(JsonEncode(42), ' ', JsonEncode('a"b'), ' ', JsonEncode(1.5), ' ', JsonEncode(True),
    ' ', JsonEncode(Green), ' ', JsonEncode(a.Colors), ' ', JsonEncode('x'));
  j := JsonOf(a.Grid);
  WriteLn(j, ' ', JsonOf(j) = j);

  { every error says what and where }
  a.Pet.Name := 'bad'#255;
  Fail('not UTF-8');
  a.Pet.Name := 'nonchar'#239#191#190;
  Fail('noncharacter');
  a.Pet.Name := 'ok';
  a.S := 0;
  Fail('fine');
  a.Ch := #200;
  Fail('Char past 127');
  a.Ch := 'c';
  a.When := 1e300;
  Fail('TDateTime');
  a.When := 0;
  a.Q := 0;
  a.Big := 0;
  a.C := 0;
  a.CQ := 0;
  a.QQ := 0;
  a.ByColor[Green] := 0;
  a.Pet.Weight := 0;
  Fail('zeros');
end.

