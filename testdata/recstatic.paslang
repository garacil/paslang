program recstatic;
{$mode delphi}{$H+}
type
  TR = record
    class var Count: Int64;
  strict private
    class var FN: Int64;
    FName: string;
  public
    X: Int64;
    class var Cache: TR;
    class constructor Start;
    class destructor Finish;
    constructor Create(AX: Int64);
    procedure Add(K: Int64);
    class function GetN: Int64; static;
    class procedure SetN(const V: string); overload; static;
    class procedure SetN(V: Int64); overload; static;
    class property N: Int64 read GetN write SetN;
    class property Name: string read FName;
  end;
  TSmall = record
    class var V: Int64;
  var
    Unused: Byte;
    class constructor Start;
    class destructor Finish;
  end;

class constructor TR.Start;
begin
  Count := 1;
  FN := 40;
  FName := 'cache';
  Cache.X := 9;
  WriteLn('record-start ', FN);
end;

class destructor TR.Finish;
begin
  WriteLn('record-end ', FN, ' ', Count, ' ', FName);
end;

constructor TR.Create(AX: Int64);
begin
  X := AX;
end;

procedure TR.Add(K: Int64);
begin
  X := X + K;
  Count := Count + 1;
end;

class function TR.GetN: Int64;
begin
  Result := FN;
end;

class procedure TR.SetN(const V: string);
begin
  FName := V;
end;

class procedure TR.SetN(V: Int64);
begin
  FN := V;
end;

class constructor TSmall.Start;
begin
  V := TR.N + 2;
  WriteLn('small-start ', V);
end;

class destructor TSmall.Finish;
begin
  WriteLn('small-end ', V);
end;

var R, S: TR;
begin
  WriteLn('initial ', TR.Count, ' ', TR.N, ' ', TR.Name, ' ', TR.Cache.X, ' ', SizeOf(TR));
  TR.N := 50;
  R := TR.Create(7);
  R.Add(3);
  S := R;
  with S do
  begin
    N := N + 3;
    X := X + 2;
  end;
  WriteLn('values ', R.X, ' ', S.X, ' ', R.Count, ' ', S.N, ' ', S.Name, ' ', TSmall.V);
end.
