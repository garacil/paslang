program stkargs;
{ Calls that pass more arguments than the registers take, with addresses into the caller's frame
  among the words left on the stack (var parameters, strings built in the arguments), made at
  every stack depth from 0 to 150 frames so that some prologue finds the stack too small and the
  stack moves with those words on it (P497). A method call and a constructor's on arm64 told the
  maps nothing of them: the callee stored through the address the old stack had. }
uses sysutils;

type
  TPair = record
    X, Y: Integer;
  end;

  TBox = class
    N: Integer;
    Note: string;
    constructor Create(A, B, C, D, E, F, G, H, I: Integer; const S1, S2, S3: string);
    function Run(A, B, C: Integer; const S1, S2, S3, S4: string; D: Integer;
      const S5: string; F: Boolean; G, H: Integer; var Why: string): Boolean; virtual;
    function Sum(A, B, C, D, E, F, G, H, I, J: Integer; var Cnt: Integer;
      var Pr: TPair): Integer;
  end;

  TSub = class(TBox)
    function Run(A, B, C: Integer; const S1, S2, S3, S4: string; D: Integer;
      const S5: string; F: Boolean; G, H: Integer; var Why: string): Boolean; override;
  end;

constructor TBox.Create(A, B, C, D, E, F, G, H, I: Integer; const S1, S2, S3: string);
begin
  N := A + B + C + D + E + F + G + H + I;
  Note := S1 + '!' + S2 + '!' + S3 + '!' + IntToStr(N);
end;

function TBox.Run(A, B, C: Integer; const S1, S2, S3, S4: string; D: Integer;
  const S5: string; F: Boolean; G, H: Integer; var Why: string): Boolean;
begin
  Why := S1 + '/' + S2 + '/' + S3 + '/' + S4 + '/' + S5 + '/' + IntToStr(A + B + C + D + G + H + N);
  Result := F;
end;

function TBox.Sum(A, B, C, D, E, F, G, H, I, J: Integer; var Cnt: Integer;
  var Pr: TPair): Integer;
begin
  Cnt := Cnt + 1;
  Pr.X := A + B + C + D + E;
  Pr.Y := F + G + H + I + J;
  Result := Pr.X * 2 + Pr.Y + N;
end;

function TSub.Run(A, B, C: Integer; const S1, S2, S3, S4: string; D: Integer;
  const S5: string; F: Boolean; G, H: Integer; var Why: string): Boolean;
begin
  Result := inherited Run(A, B, C, S1, S2, S3, S4, D, S5, F, G, H, Why);
  Why := 'sub ' + Why;
end;

function Many(A, B, C, D, E, F, G, H, I: Integer; const S: string; var Res: string;
  var Tot: Integer): Integer;
begin
  Tot := Tot + 1;
  Res := S + IntToStr(A + B + C + D + E + F + G + H + I);
  Result := A * I;
end;

var
  checks, bad: Integer;

procedure Expect(const Got, Want: string);
begin
  Inc(checks);
  if Got <> Want then
    Inc(bad);
end;

procedure Drive(rnd: Integer);
var
  b, c: TBox;
  i, cnt, tot, r, sum: Integer;
  why, outs, w, a, e: string;
  pr: TPair;
begin
  cnt := 0;
  tot := 0;
  c := TSub.Create(1, 2, 3, 4, 5, 6, 7, 8, 9, 'sub', IntToStr(rnd), 'z' + IntToStr(rnd));
  Expect(c.Note, 'sub!' + IntToStr(rnd) + '!z' + IntToStr(rnd) + '!45');
  for i := 1 to 6 do
  begin
    b := TBox.Create(i, 2, 3, 4, 5, 6, 7, 8, 9, IntToStr(i) + 'n', 'q', IntToStr(i * 5) + 'r');
    sum := i + 44;
    Expect(b.Note, IntToStr(i) + 'n!q!' + IntToStr(i * 5) + 'r!' + IntToStr(sum));
    a := IntToStr(rnd) + 'a';
    e := a + 'e' + IntToStr(i);
    why := 'unset';
    r := Ord(b.Run(i, 2, 3, a, 'b', IntToStr(i * 3), e + 'd', 5, IntToStr(i * 7), i mod 2 = 0, 7, 8, why));
    w := a + '/b/' + IntToStr(i * 3) + '/' + e + 'd/' + IntToStr(i * 7) + '/' + IntToStr(i + 2 + 3 + 5 + 7 + 8 + sum);
    Expect(why, w);
    Expect(IntToStr(r), IntToStr(Ord(i mod 2 = 0)));
    c.N := i;
    why := 'unset';
    r := Ord(c.Run(i, 2, 3, a, 'b', IntToStr(i * 3), e + 'd', 5, IntToStr(i * 7), i mod 2 = 1, 7, 8, why));
    w := 'sub ' + a + '/b/' + IntToStr(i * 3) + '/' + e + 'd/' + IntToStr(i * 7) + '/' + IntToStr(i + 2 + 3 + 5 + 7 + 8 + i);
    Expect(why, w);
    Expect(IntToStr(r), IntToStr(Ord(i mod 2 = 1)));
    r := b.Sum(i, 2, 3, 4, 5, 6, 7, 8, 9, 10, cnt, pr);
    Expect(IntToStr(r), IntToStr((i + 14) * 2 + 40 + sum));
    Expect(IntToStr(pr.X) + ',' + IntToStr(pr.Y), IntToStr(i + 14) + ',40');
    r := Many(i, 2, 3, 4, 5, 6, 7, 8, 9, IntToStr(i) + 'm', outs, tot);
    Expect(outs, IntToStr(i) + 'm' + IntToStr(i + 44));
    Expect(IntToStr(r), IntToStr(i * 9));
  end;
  Expect(IntToStr(cnt) + ',' + IntToStr(tot), '6,6');
end;

procedure Deep(n: Integer);
var
  pad: array[0..15] of Integer;
begin
  pad[n and 15] := n;
  if n > 0 then
    Deep(n - 1)
  else
    Drive(0);
  if pad[(n + 3) and 15] = 123456789 then
    WriteLn('never');
end;

var
  d: Integer;
begin
  for d := 0 to 150 do
    Deep(d);
  WriteLn('checks=', checks, ' bad=', bad);
end.
