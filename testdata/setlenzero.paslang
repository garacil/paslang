{ P419: SetLength(a, 0) of a dynamic array leaves it nil and lets its
  block go, as Pascal's SetLength (FPC's fpc_dynarray_setlength) and Go's
  s = nil do: a block of 64 MiB set to length 0 is gone after the next
  cycle. A nil array set to length 0 stays nil, so it takes no block; an
  empty literal [] is nil; an Append of nothing gives the slice as it
  was; a shrink to a length above 0 keeps the elements; a string set to
  length 0 lets its block go too. }
program setlenzero;

uses
  paslib;

const
  MiB = 1024 * 1024;

var
  a, b, c, d: array of Integer;
  s: string;
  base: Integer;

{ the bytes alive after a cycle }
function Alive: Integer;
begin
  GcCollect;
  Result := HeapStat(1);
end;

begin
  base := Alive;
  SetLength(a, 8 * MiB);
  a[8 * MiB - 1] := 7;
  WriteLn('held ', Alive - base >= 64 * MiB, ' last ', a[8 * MiB - 1]);
  SetLength(a, 0);
  WriteLn('nil ', a = nil, ' length ', Length(a), ' cap ', Cap(a), ' freed ', Alive - base < MiB);
  SetLength(a, 2);
  a[1] := 5;
  WriteLn('again ', Length(a), ' ', a[0], ' ', a[1]);
  SetLength(b, 0);
  WriteLn('nil array to 0: nil ', b = nil, ' length ', Length(b));
  c := [];
  WriteLn('empty literal: nil ', c = nil);
  c := Append(c, 1, 2, 3);
  d := Append(c, []);
  WriteLn('append nothing: ', Length(d), ' ', d[0], ' ', d[2]);
  SetLength(c, 1);
  WriteLn('shrink keeps ', Length(c), ' ', c[0], ' nil ', c = nil);
  s := StringOfChar('x', 16 * MiB);
  WriteLn('string held ', Alive - base >= 16 * MiB, ' ', Length(s));
  SetLength(s, 0);
  WriteLn('string empty ', s = '', ' freed ', Alive - base < MiB);
end.

