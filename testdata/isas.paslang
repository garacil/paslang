program isas;

type
  TBase = class
    procedure Hi;
  end;

  TChild = class(TBase)
    procedure Hi;
  end;

  TOther = class
    procedure Hi;
  end;

procedure TBase.Hi;
begin
end;

procedure TChild.Hi;
begin
end;

procedure TOther.Hi;
begin
end;

var
  b: TBase;
  c: TChild;
  o: TOther;

begin
  c := TChild.Create;
  b := c;
  if b is TChild then
    WriteLn(1)
  else
    WriteLn(0);
  if b is TBase then
    WriteLn(1)
  else
    WriteLn(0);
  if b is TOther then
    WriteLn(1)
  else
    WriteLn(0);
  if nil is TBase then
    WriteLn(1)
  else
    WriteLn(0);
  o := TOther.Create;
  if o is TBase then
    WriteLn(1)
  else
    WriteLn(0);
  b := c as TBase;
  WriteLn(1);
  c := b as TChild;
  WriteLn(2);
end.
