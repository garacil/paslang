program placeonce;
uses sysutils;
type
  TCell = record Amount: Currency; Text: string end;
  TCells = array[0..1] of TCell;
  TReals = array[0..1] of Double;
  TQuads = array[0..1] of Quad;
var cells: TCells; reals: TReals; quads: TQuads;
  words: array[0..1] of Integer;
  entries, old: map[Integer] of TCells; ordered: tree[Integer] of TCells;
  calls, index, key: Integer; order: string;

function Next: Integer;
begin Inc(calls); order := order + 'L'; Result := 0 end;

function Value: Currency;
var held: string;
begin
  order := order + 'R'; held := 'owned value';
  GcCollect;
  if held <> 'owned value' then Halt(2);
  Result := 0.25;
end;

function ChangeIndex: Currency;
begin index := 1; Result := 0.25 end;

function ChangeKey: Currency;
begin key := 8; Result := 0.25 end;

function ChangeMap: Currency;
begin New(entries); Result := 0.25 end;

function GrowMap: Currency;
var j: Integer;
begin
  for j := 100 to 4100 do entries[j][0].Text := 'keep-' + IntToStr(j);
  GcCollect;
  Result := 0.25;
end;

begin
  cells[0].Amount := 1; cells[0].Text := 'root'; order := '';
  calls := 0; cells[Next].Amount += Value;
  if (calls <> 1) or (order <> 'LR') or (cells[0].Amount <> 1.25)
    or (cells[0].Text <> 'root') then Halt(3);
  index := 0; cells[index].Amount += ChangeIndex;
  if (cells[0].Amount <> 1.5) or (cells[1].Amount <> 0) then Halt(4);
  reals[0] := 1; Inc(reals[Next], 0.25); reals[Next] *= 2;
  if (calls <> 3) or (reals[0] <> 2.5) then Halt(5);
  quads[0] := 1; Dec(quads[Next], 0.25); quads[Next] *= 2;
  if (calls <> 5) or (quads[0] <> 1.5) then Halt(6);
  words[0] := 10; words[Next] += 5;
  if (calls <> 6) or (words[0] <> 15) then Halt(7);
  words[0] := 12500; Inc(words[Next] as Currency, 0.25);
  if (calls <> 7) or (words[0] <> 15000) then Halt(8);
  New(entries); entries[7] := cells; key := 7;
  entries[key][0].Amount += ChangeKey;
  if (entries[7][0].Amount <> 1.75) or (entries[8][0].Amount <> 0) then Halt(9);
  index := 0; entries[7][index].Amount += ChangeIndex;
  if (entries[7][0].Amount <> 2) or (entries[7][1].Amount <> 0) then Halt(10);
  entries[7][Next].Amount += GrowMap;
  if (calls <> 8) or (entries[7][0].Amount <> 2.25)
    or (entries[7][0].Text <> 'root') then Halt(11);
  old := entries; entries[7][Next].Amount += ChangeMap;
  if (calls <> 9) or (old[7][0].Amount <> 2.5) or (Length(entries) <> 0) then Halt(12);
  New(ordered); ordered[7] := cells;
  Inc(ordered[7][Next].Amount, Value);
  if (calls <> 10) or (ordered[7][0].Amount <> 1.75) then Halt(13);
  WriteLn('compound places bind once before RHS, retaining roots through map growth and GC');
end.
