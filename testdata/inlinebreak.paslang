program inlinebreak;
var grid: array[0..3] of Integer;
    value, total: Integer;
    p: ^Integer;
function Cell(I: Integer): Integer;
begin
  Result := grid[I];
end;
function Load(Q: ^Integer): Integer;
begin
  Result := Q^;
end;
begin
  grid[1] := 4;
  value := 8;
  p := @value;
  total := Cell(1) + 1;
  total := Load(p) + total;
  WriteLn(total);
end.

