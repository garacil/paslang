program ptrarith;

{ Pointer arithmetic scaled by the view (P102), the plan's tables: X
  points at bytes 01 02 03 ...; a view reads what it says at the address
  it says; p + n moves n elements of what p sees, a Pointer's in bytes,
  for the result only or for good with Inc and Dec; q - r counts the
  elements between; TRec is B: Byte; W: Word; I, J: Int32, 12 bytes. }

uses paslib;

type
  TRec = record
    B: Byte;
    W: Word;
    I: Int32;
    J: Int32;
  end;

var
  buf: array[0..47] of Byte;
  A, X, Y: Pointer;
  i, n: Integer;
  pb: PByte;

function Off(P: Pointer): Integer;
begin
  Result := Integer(P) - Integer(A);
end;

procedure HexOut(const Name: string; V: Integer);
var
  s: string;
  d: Integer;
begin
  s := '';
  repeat
    d := V and 15;
    if d < 10 then
      s := Chr(48 + d) + s
    else
      s := Chr(55 + d) + s;
    V := V shr 4;
  until V = 0;
  WriteLn(Name, ' $', s);
end;

begin
  for i := 0 to 47 do
    buf[i] := Byte(i + 1);
  A := @buf[8];
  X := A;
  HexOut('PByte(X)^', PByte(X)^);
  HexOut('PWord(X)^', PWord(X)^);
  HexOut('PDWord(X)^', PDWord(X)^);
  HexOut('PInteger(X)^', PInteger(X)^);
  HexOut('(PByte(X) + 1)^', (PByte(X) + 1)^);
  HexOut('(PWord(X) + 1)^', (PWord(X) + 1)^);
  HexOut('(PDWord(X) + 1)^', (PDWord(X) + 1)^);
  HexOut('(PInteger(X) + 1)^', (PInteger(X) + 1)^);
  HexOut('PWord(X)[3]', PWord(X)[3]);
  HexOut('PWord(PByte(X) + 1)^', PWord(PByte(X) + 1)^);
  HexOut('PDWord(PWord(X) + 3)^', PDWord(PWord(X) + 3)^);
  WriteLn('^Int16(X)^ ', ^Int16(X)^);
  HexOut('^TRec(X)^.W', ^TRec(X)^.W);
  HexOut('TRec(X^).W', TRec(X^).W);
  HexOut('TRec(X).I', TRec(X).I);
  HexOut('(^TRec(X) + 1)^.B', (^TRec(X) + 1)^.B);
  HexOut('Integer(X^)', Integer(X^));
  pb := X;
  WriteLn('Integer(pb^) ', Integer(pb^));
  { 3: for the result only, or for good. }
  Y := PDWord(X) + 1;
  WriteLn('Y := PDWord(X) + 1: ', Off(Y), ' ', Off(X));
  Y := PByte(X) - 3;
  WriteLn('Y := PByte(X) - 3: ', Off(Y));
  n := Integer(PWord(X) + 1);
  WriteLn('Integer(PWord(X) + 1): ', n - Integer(A));
  Inc(PDWord(X));
  WriteLn('Inc(PDWord(X)): ', Off(X));
  X := A;
  Inc(PWord(X), 3);
  WriteLn('Inc(PWord(X), 3): ', Off(X));
  X := A;
  Dec(PInteger(X));
  WriteLn('Dec(PInteger(X)): ', Off(X));
  X := A;
  X := PByte(X) + 1;
  WriteLn('X := PByte(X) + 1: ', Off(X));
  X := A;
  Inc(X, 5);
  WriteLn('Inc(X, 5): ', Off(X));
  X := A;
  Y := X + 5;
  WriteLn('Y := X + 5: ', Off(Y), ' ', Off(X));
  Inc(^TRec(X));
  WriteLn('Inc(^TRec(X)): ', Off(X));
  { 4: distances and comparisons. }
  X := A;
  Y := PByte(X) + 20;
  WriteLn('PDWord(Y) - PDWord(X): ', PDWord(Y) - PDWord(X));
  WriteLn('Y - X: ', Y - X);
  WriteLn('PWord(Y) - PWord(X): ', PWord(Y) - PWord(X));
  WriteLn(X < Y, ' ', Y > X, ' ', X = A, ' ', Y <> X);
  n := 0;
  pb := PByte(X);
  while pb < PByte(Y) do
  begin
    n := n + pb^;
    Inc(pb);
  end;
  WriteLn('walk ', n);
end.

