{ P602: callers use their local CPU target; public PasFma APIs use the
  target of the actual selected SDK object. Every path has independent
  exact-rational bit oracles in scripts/check_fma_target.py. The vectors
  include fused cancellation, ties, subnormals, both zeros, infinities and
  NaNs. A routine value must preserve the public API's address and ABI.
  Local-fast arithmetic runs only where CpuHas reports FMA. The runner
  may force it under a runtime mask after an independent base-compiled
  probe proved the real host capability. A base host uses the explicit
  portable counterpart for those rows; the runner records that exclusion. }
program fmatarget;

uses pasnum;

type
  TFmaD = function(A, B, C: Double): Double;
  TFmaS = function(A, B, C: Single): Single;
  TApplyD = function(F: TFmaD; A, B, C: Double): Double;
  TApplyS = function(F: TFmaS; A, B, C: Single): Single;
  TGetD = function: TFmaD;
  TGetS = function: TFmaS;
  TMixed = function(A, B: Single): Double;
  TLoop = function(X: Double): Double;

const
  DInput: array[0..47] of Integer = (
    $3FB999999999999A, $4024000000000000, $BFF0000000000000,
    $3FF0000000000001, $3FEFFFFFFFFFFFFE, $BFF0000000000000,
    $7FEFFFFFFFFFFFFF, $4000000000000000, $FFEFFFFFFFFFFFFF,
    $10000000000000, $8010000000000000, $0,
    $1, $3FE0000000000000, $0,
    $1, $3FF8000000000000, $0,
    $8000000000000001, $3FE0000000000000, $8000000000000000,
    $3FF0000000000000, $3FF0000000000000, $BFF0000000000000,
    $8000000000000000, $3FF0000000000000, $8000000000000000,
    $8000000000000000, $3FF0000000000000, $0,
    $0, $7FF0000000000000, $3FF0000000000000,
    $7FF0000000000000, $3FF0000000000000, $FFF0000000000000,
    $7FF0000000000000, $BFF0000000000000, $3FF0000000000000,
    $7FEFFFFFFFFFFFFF, $7FEFFFFFFFFFFFFF, $FFF0000000000000,
    $3FF0000000000000, $7FF8000000000001, $0,
    $10000000000000, $3FF0000000000000, $800FFFFFFFFFFFFF);
  SInput: array[0..50] of Integer = (
    $3DCCCCCD, $41200000, $BF800000,
    $3F800001, $3F7FFFFE, $BF800000,
    $7F7FFFFF, $40000000, $FF7FFFFF,
    $800000, $80800000, $0,
    $1, $3F000000, $0,
    $1, $3FC00000, $0,
    $80000001, $3F000000, $80000000,
    $3F800000, $3F800000, $BF800000,
    $80000000, $3F800000, $80000000,
    $80000000, $3F800000, $0,
    $0, $7F800000, $3F800000,
    $7F800000, $3F800000, $FF800000,
    $7F800000, $BF800000, $3F800000,
    $7F7FFFFF, $7F7FFFFF, $FF800000,
    $3F800000, $7FC00001, $0,
    $800000, $3F800000, $807FFFFF,
    { The exact sum lies just below the Single half-way point. Rounding
      the product and sum in Double first gives the wrong adjacent Single. }
    $39800001, $397FFFFE, $3F800001);

var
  Trace: Integer;
  CanFast: Boolean;

function PublicValueD: TFmaD;
begin
  Result := @PasFma;
end;

function PublicValueS: TFmaS;
begin
  Result := @PasFmaS;
end;

function DefaultD(A, B, C: Double): Double;
begin
  Result := Fma(A, B, C);
end;

function PublicD(A, B, C: Double): Double;
begin
  Result := PasFma(A, B, C);
end;

function SoftD(A, B, C: Double): Double;
begin
  Result := PasFmaSoft(A, B, C);
end;

function PointerD(F: TFmaD; A, B, C: Double): Double;
begin
  Result := F(A, B, C);
end;

function TouchD(A: Double; Tag: Integer): Double;
begin
  Trace := Trace * 10 + Tag;
  Result := A;
end;

function OrderedD(A, B, C: Double): Double;
begin
  Result := Fma(TouchD(A, 1), TouchD(B, 2), TouchD(C, 3));
end;

function DefaultS(A, B, C: Single): Single;
begin
  Result := Fma(A, B, C);
end;

function PublicS(A, B, C: Single): Single;
begin
  Result := PasFmaS(A, B, C);
end;

function SoftS(A, B, C: Single): Single;
begin
  Result := PasFmaSoftS(A, B, C);
end;

function PointerS(F: TFmaS; A, B, C: Single): Single;
begin
  Result := F(A, B, C);
end;

function TouchS(A: Single; Tag: Integer): Single;
begin
  Trace := Trace * 10 + Tag;
  Result := A;
end;

function OrderedS(A, B, C: Single): Single;
begin
  Result := Fma(TouchS(A, 1), TouchS(B, 2), TouchS(C, 3));
end;

function LoopD(X: Double): Double;
var R: Double; I: Integer;
begin
  R := 0.0;
  for I := 1 to 8 do R := Fma(R, X, I);
  Result := R;
end;

function MixedD(A, B: Single): Double;
begin
  Result := Fma(A, B, -1.0);
end;

{$CPU base}
function LocalBaseD(A, B, C: Double): Double;
begin
  Result := Fma(A, B, C);
end;

function LocalBaseS(A, B, C: Single): Single;
begin
  Result := Fma(A, B, C);
end;

{$ifdef CPUX86_64}
{$CPU v3}
{$else}
{$CPU base}
{$endif}
function LocalFastD(A, B, C: Double): Double;
begin
  Result := Fma(A, B, C);
end;

function LocalFastS(A, B, C: Single): Single;
begin
  Result := Fma(A, B, C);
end;

{$CPU DEFAULT}
function AfterD(A, B, C: Double): Double;
begin
  Result := Fma(A, B, C);
end;

function AfterS(A, B, C: Single): Single;
begin
  Result := Fma(A, B, C);
end;

procedure EmitD(const Name: string; I: Integer; V: Double);
var Bits: Integer;
begin
  Bits := V as Integer;
  if ((Bits and $7FF0000000000000) = $7FF0000000000000) and
     ((Bits and $000FFFFFFFFFFFFF) <> 0) then
    WriteLn('D ', Name, ' ', I, ' nan')
  else
    WriteLn('D ', Name, ' ', I, ' ', Bits);
end;

procedure EmitS(const Name: string; I: Integer; V: Single);
var Bits: UInt32;
begin
  Bits := V as UInt32;
  if ((Bits and $7F800000) = $7F800000) and ((Bits and $007FFFFF) <> 0) then
    WriteLn('S ', Name, ' ', I, ' nan')
  else
    WriteLn('S ', Name, ' ', I, ' ', Bits);
end;

var
  I: Integer;
  A, B, C: Double;
  X, Y, Z: Single;
  FD: TFmaD;
  FS: TFmaS;
  ApplyD: TApplyD;
  ApplyS: TApplyS;
  GetD: TGetD;
  GetS: TGetS;
  Mixed: TMixed;
  Loop: TLoop;
begin
  CanFast := CpuHas('fma');
  if (ParamCount = 1) and (ParamStr(1) = '--force-localfast') then
    CanFast := True;
  GetD := @PublicValueD;
  GetS := @PublicValueS;
  FD := GetD();
  FS := GetS();
  ApplyD := @PointerD;
  ApplyS := @PointerS;
  Mixed := @MixedD;
  Loop := @LoopD;
  for I := 0 to 15 do
  begin
    A := DInput[I * 3] as Double;
    B := DInput[I * 3 + 1] as Double;
    C := DInput[I * 3 + 2] as Double;
    EmitD('default', I, DefaultD(A, B, C));
    EmitD('public', I, PublicD(A, B, C));
    EmitD('soft', I, SoftD(A, B, C));
    EmitD('pointer', I, ApplyD(FD, A, B, C));
    EmitD('localbase', I, LocalBaseD(A, B, C));
    if CanFast then EmitD('localfast', I, LocalFastD(A, B, C))
    else EmitD('localfast', I, PasFmaSoft(A, B, C));
    EmitD('after', I, AfterD(A, B, C));
    Trace := 0;
    EmitD('ordered', I, OrderedD(A, B, C));
    WriteLn('order D ', I, ' ', Trace);
    FD := @DefaultD;
    EmitD('via-default', I, ApplyD(FD, A, B, C));
    FD := @PublicD;
    EmitD('via-public', I, ApplyD(FD, A, B, C));
    FD := @SoftD;
    EmitD('via-soft', I, ApplyD(FD, A, B, C));
    FD := @LocalBaseD;
    EmitD('via-localbase', I, ApplyD(FD, A, B, C));
    FD := @LocalFastD;
    if CanFast then EmitD('via-localfast', I, ApplyD(FD, A, B, C))
    else EmitD('via-localfast', I, PasFmaSoft(A, B, C));
    FD := @AfterD;
    EmitD('via-after', I, ApplyD(FD, A, B, C));
    Trace := 0;
    FD := @OrderedD;
    EmitD('via-ordered', I, ApplyD(FD, A, B, C));
    WriteLn('order-via D ', I, ' ', Trace);
    FD := GetD();
  end;
  for I := 0 to 16 do
  begin
    X := UInt32(SInput[I * 3]) as Single;
    Y := UInt32(SInput[I * 3 + 1]) as Single;
    Z := UInt32(SInput[I * 3 + 2]) as Single;
    EmitS('default', I, DefaultS(X, Y, Z));
    EmitS('public', I, PublicS(X, Y, Z));
    EmitS('soft', I, SoftS(X, Y, Z));
    EmitS('pointer', I, ApplyS(FS, X, Y, Z));
    EmitS('localbase', I, LocalBaseS(X, Y, Z));
    if CanFast then EmitS('localfast', I, LocalFastS(X, Y, Z))
    else EmitS('localfast', I, PasFmaSoftS(X, Y, Z));
    EmitS('after', I, AfterS(X, Y, Z));
    Trace := 0;
    EmitS('ordered', I, OrderedS(X, Y, Z));
    WriteLn('order S ', I, ' ', Trace);
    FS := @DefaultS;
    EmitS('via-default', I, ApplyS(FS, X, Y, Z));
    FS := @PublicS;
    EmitS('via-public', I, ApplyS(FS, X, Y, Z));
    FS := @SoftS;
    EmitS('via-soft', I, ApplyS(FS, X, Y, Z));
    FS := @LocalBaseS;
    EmitS('via-localbase', I, ApplyS(FS, X, Y, Z));
    FS := @LocalFastS;
    if CanFast then EmitS('via-localfast', I, ApplyS(FS, X, Y, Z))
    else EmitS('via-localfast', I, PasFmaSoftS(X, Y, Z));
    FS := @AfterS;
    EmitS('via-after', I, ApplyS(FS, X, Y, Z));
    Trace := 0;
    FS := @OrderedS;
    EmitS('via-ordered', I, ApplyS(FS, X, Y, Z));
    WriteLn('order-via S ', I, ' ', Trace);
    FS := GetS();
  end;
  EmitD('mixed', 0, Mixed(UInt32($3F800001) as Single, UInt32($3F800001) as Single));
  EmitD('integer', 0, Fma(2, 3, 4));
  EmitD('loop', 0, Loop(0.5));
end.
