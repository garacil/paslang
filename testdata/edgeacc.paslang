program edgeacc;

uses pasnet;

procedure Take(L: Integer);
var
  c: Integer;
begin
  c := TcpAccept(L);
  if c < 0 then
    Halt(1);
  WriteLn('ok');
  TcpClose(c);
end;

procedure Put(Port: Integer);
var
  c: Integer;
begin
  c := TcpConnect('127.0.0.1', Port);
  if c < 0 then
    Halt(1);
  TcpClose(c);
end;

var
  l, port, i: Integer;
begin
  l := TcpListen(0);
  if l < 0 then
    Halt(1);
  port := TcpPort(l);
  pas Take(l);
  pas Take(l);
  for i := 1 to 40 do
    Gosched;
  pas Put(port);
  pas Put(port);
end.

