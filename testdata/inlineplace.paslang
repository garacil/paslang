program inlineplace;

uses
  sysutils, InlinePlaceU;

var
  grid: array[0..3] of Integer;
  said: chan of string;

function Cell(I: Integer): Integer;
begin
  Result := grid[I];
end;

function Half(A, B: Integer): Integer;
begin
  Result := A div B;
end;

function Whole(X: Double): Integer;
begin
  Result := Trunc(X);
end;

function Load(P: ^Integer): Integer;
begin
  Result := P^;
end;

function CallCell(I: Integer): Integer;
begin
  Result := Cell(I) + 1;
end;

function CallHalf(A, B: Integer): Integer;
begin
  Result := Half(A, B) + 1;
end;

function CallWhole(X: Double): Integer;
begin
  Result := Whole(X) + 1;
end;

function CallLoad(P: ^Integer): Integer;
begin
  Result := Load(P) + 1;
end;

function Fetch(var V: Integer): Integer;
begin
  Result := V;
end;

function Ignore(I: Integer): Integer;
begin
  Result := 42;
end;

function Letter(I: Integer): Integer;
begin
  Result := Ord(('abc')[I]);
end;

procedure Worker(K: Integer);
var
  n: Integer;
begin
  try
    case K of
      1: n := CallCell(K + 5);
      2: n := CallHalf(7, K - 2);
      3: n := CallWhole(1.0e30);
      4: n := CallLoad(nil);
      5: n := UnitCell(K + 1);
      6: n := UnitHalf(7, K - 6);
      7: n := UnitWhole(1.0e30);
      8: n := UnitLoad(nil);
      9: n := Fetch(grid[K]);
      10: n := Ignore(grid[K]);
      11: n := Cell(6) + 1;
      12: n := Cell(-1) + 1;
      13: n := Half(7, 0) + 1;
      14: n := Whole(1.0e30) + 1;
      15: n := Load(nil) + 1;
      16: n := Letter(4) + 1;
      17: n := Letter(0) + 1;
      18: n := Fetch(grid[6]);
      19: n := Ignore(grid[6]);
      20..25: n := UnitConstant(K - 19);
    end;
    Send(said, 'missed failure ' + IntToStr(n));
  except
    on e: Exception do
      Send(said, e.ClassName + ': ' + e.Message);
  end;
end;

var
  k, value: Integer;
begin
  said := MakeChan(1);
  for k := 1 to 25 do
  begin
    Worker(k);
    WriteLn('main ', k, ': ', Recv(said));
    pas Worker(k);
    WriteLn('pas ', k, ': ', Recv(said));
  end;
  value := 5;
  WriteLn(CallCell(0) + CallHalf(8, 2) + CallWhole(2.5) + CallLoad(@value));
  WriteLn(UnitCell(0) + UnitHalf(8, 2) + UnitWhole(2.5) + UnitLoad(@value));
  WriteLn(Letter(1));
end.

