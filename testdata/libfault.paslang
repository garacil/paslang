{ P569: the library's own failures as exceptions. A unit of the library
  that finds the program asking for what cannot be done (a write to a
  nil map, a waitgroup counted below zero, a string view that cannot be,
  the first key of an empty tree, a key that is not there, an index
  outside a tree, a nil tree split or joined, the least of an empty
  heap, a push on a nil one, a nil store, an index outside the leaves of
  a Merkle tree, a size SHA-3 has not) wrote its line and stopped the
  program. With SysUtils in the
  program and a try on the way it is raised now in the code of the
  program that called the library, as Go panics there, its Message the
  line the library writes, without paslang: in front and with the place
  of that call after it. Every one is taken here by its class, then by
  an ancestor, by a bare except, through a finally; a handler finds the
  variables of a loop as the call found them; a lock block is left
  unlocked; a routine started with pas takes its own; and the map, the
  tree and the heap serve again after the failure.

  With two arguments it dies of kind K instead, for the recipe to compare
  the runtime's own line with the Message printed here: die K with no try
  at all, fin K inside a try with a finally and no handler, pas K the
  same in a routine started with pas. }
program libfault;

uses
  sysutils;

const
  Kinds = 28;

var
  mi: map[Integer] of Integer;
  ms: map[string] of Integer;
  mp: map[Pointer] of Integer;
  spare: waitgroup;
  tn, te, tf: tree[Integer] of Integer;
  hn, he: heap of Integer;
  dbn: store;
  leaves: array of string;
  mu: mutex;
  wg: waitgroup;
  got: string;
  dieK, zero: Int64;

{ One failure of kind K. What is nil or empty is so when the program
  runs: nothing here is worked out by the compiler. Kind 25 joins an
  empty tree into a nil one: with keys to move, the first put would
  report the nil tree in the same words. }
procedure Fail(K: Int64);
var
  p: PByte;
  s: string;
  n: Int64;
  tx: tree[Integer] of Integer;
  st: TSha3State;
begin
  case K of
    1: mi[3] := 1;
    2: ms['x'] := 1;
    3: mp[@zero] := 1;
    4: spare.Done;
    5:
      begin
        p := PByte(GetMem(16, 0));
        p[0] := 1;
        s := PasStrView(p + 1, -2 - zero);
      end;
    6: s := PasStrView(nil, 3 + zero);
    7: s := PasStrView(Pointer(-8), 16 + zero);
    8:
      begin
        p := PByte(GetMem(16, 0));
        p[1] := 104;
        s := PasStrView(p + 1, 2 + zero);
      end;
    9: tn[1] := 2;
    10: n := Low(te);
    11: n := High(te);
    12: n := Succ(tf, 99);
    13: n := Pred(tf, 1);
    14: n := Floor(tf, 0);
    15: n := Ceil(tf, 99);
    16: n := KeyAt(tf, 2 + zero);
    17: Push(hn, 1);
    18: n := Pop(he);
    19: StorePut(dbn, 'a', 'b');
    20: s := MerkleProof(leaves, 9);
    21: s := PasSha3('abc', 100 + zero);
    22: n := KeyAt(tn, zero);
    23: n := KeyAt(tf, -1 - zero);
    24: tx := Split(tn, 5);
    25: Join(tn, te);
    26: Join(tf, tn);
    27: StoreDelete(dbn, 'a');
    28: PasSha3Begin(st, 100 + zero);
  end;
end;

{ what stands beside a failure and is right: the first and the last
  index of a tree, whose count is the first index outside (kind 16), and
  a view over bytes that follow the mark }
procedure Edges;
var
  p: PByte;
  s: string;
begin
  p := PByte(GetMem(16, 0));
  p[4] := 0;
  p[5] := 1;
  p[6] := 104;
  p[7] := 104;
  s := PasStrView(p + 6, 2 + zero);
  WriteLn('beside them: keys ', KeyAt(tf, zero), ' ', KeyAt(tf, 1 + zero), ' view ', s);
end;

{ every kind by its class: the lines the recipe compares, and the class
  under each }
procedure Caught;
var
  k: Int64;
begin
  for k := 1 to Kinds do
    try
      Fail(k);
      WriteLn('not raised');
    except
      on e: Exception do
      begin
        WriteLn('paslang: ', e.Message);
        WriteLn('  ', e.ClassName);
      end;
    end;
end;

procedure ByClass;
var
  i, total: Int64;
begin
  try
    Fail(1);
  except
    on e: EAccessViolation do
      WriteLn('a nil map by its class: ', e.ClassName);
  end;
  try
    Fail(4);
  except
    on e: EExternal do
      WriteLn('a waitgroup by an ancestor: ', e.ClassName);
  end;
  try
    Fail(6);
  except
    on e: EArgumentException do
      WriteLn('a view of nil by its parent: ', e.ClassName);
  end;
  try
    Fail(16);
  except
    WriteLn('by a bare except');
  end;
  try
    try
      Fail(18);
    finally
      WriteLn('finally on the way');
    end;
  except
    on e: ERangeError do
      WriteLn('after the finally: ', e.Message);
  end;
  { the variables of a loop, as the call into the library found them }
  total := 0;
  i := 0;
  try
    for i := 1 to 10 do
    begin
      total := total + i;
      if i = 7 then
        mi[i] := total;
    end;
  except
    on e: EAccessViolation do
      WriteLn('in a loop: i ', i, ' total ', total);
  end;
  { the place is the call's own, the last instruction of its line }
  try
    Push(hn, 2);
    total := total + 1000;
  except
    on e: EAccessViolation do
      WriteLn('the line is the call''s: ', e.Message);
  end;
  { a lock block is left unlocked }
  try
    lock mu do
      ms['k'] := 1;
  except
    on e: EAccessViolation do
      WriteLn('under a lock: taken');
  end;
  lock mu do
    got := 'and the lock is free';
  WriteLn(got);
end;

{ what failed serves again }
procedure Again;
var
  n: Int64;
begin
  try
    mi[1] := 1;
  except
    on e: EAccessViolation do
      New(mi);
  end;
  mi[1] := 41;
  mi[1] := mi[1] + 1;
  try
    n := Pop(he);
  except
    on e: ERangeError do
      Push(he, 7);
  end;
  n := Pop(he);
  try
    n := n + Low(te);
  except
    on e: ERangeError do
      te[5] := 50;
  end;
  WriteLn('again: map ', mi[1], ' heap ', n, ' tree ', Low(te), ' ', te[5]);
  Delete(te, 5);
end;

procedure Worker;
begin
  try
    Fail(9);
  except
    on e: EAccessViolation do
      got := 'a routine takes its own: ' + e.Message;
  end;
  wg.Done;
end;

procedure DieWorker;
begin
  try
    Fail(dieK);
  finally
    WriteLn('finally');
  end;
  wg.Done;
end;

begin
  zero := Ord(ParamCount > 99);
  New(te);
  New(tf);
  tf[10] := 1;
  tf[20] := 2;
  New(he);
  SetLength(leaves, 3);
  leaves[0] := 'a';
  leaves[1] := 'b';
  leaves[2] := 'c';
  if ParamCount = 2 then
  begin
    dieK := StrToInt(ParamStr(2));
    if ParamStr(1) = 'die' then
      Fail(dieK)
    else if ParamStr(1) = 'fin' then
    begin
      try
        Fail(dieK);
      finally
        WriteLn('finally');
      end;
    end
    else
    begin
      wg.Add(1);
      pas DieWorker;
      wg.Wait;
    end;
    WriteLn('not reached');
    Halt(0);
  end;
  Caught;
  Edges;
  ByClass;
  Again;
  wg.Add(1);
  pas Worker;
  wg.Wait;
  WriteLn(got);
  WriteLn('done');
end.

