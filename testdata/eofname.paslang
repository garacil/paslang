{ P665: Eof is not a reserved word. It means the end of standard input
  only where nothing declared is called Eof: a variable, a parameter, a
  field, a routine or a method of the name is what the name means in its
  scope, as the library's parameters called Eof always were (pashttp's
  TryHead). This program never reads standard input: each Eof here is a
  declared one. }
program eofname;

type
  TReader = class
  public
    Data: string;
    At: Integer;
    function Eof: Boolean;
    function Next: Char;
    function Rest: string;
  end;

  TCursor = record
    Eof: Boolean;
    At: Integer;
  end;

function TReader.Eof: Boolean;
begin
  Result := At >= Length(Data);
end;

function TReader.Next: Char;
begin
  Inc(At);
  Result := Data[At];
end;

{ inside a method, Eof is Self's }
function TReader.Rest: string;
begin
  Result := '';
  while not Eof do
    Result := Result + Next;
end;

{ a nested routine called Eof, with a parameter }
procedure Nested;

  function Eof(N: Integer): Boolean;
  begin
    Result := N > 2;
  end;

begin
  WriteLn('a nested routine: ', Eof(1), ' ', Eof(3));
end;

{ a parameter called Eof }
function Cut(const S: string; Eof: Boolean): string;
begin
  if Eof then
    Result := S + '.'
  else
    Result := S + '...';
end;

{ a local called eof, in another case }
function Count(const S: string): Integer;
var
  eof: Boolean;
  i: Integer;
begin
  Result := 0;
  i := 0;
  eof := False;
  while not eof do
  begin
    Inc(i);
    if i > Length(S) then
      eof := True
    else if S[i] = ' ' then
      Inc(Result);
  end;
end;

var
  r: TReader;
  c: TCursor;
  w: string;

begin
  r := TReader.Create;
  r.Data := 'abc';
  w := '';
  while not r.Eof do
    w := w + r.Next;
  WriteLn('a method: ', w);
  r.Data := 'xyz';
  r.At := 1;
  WriteLn('Self''s inside a method: ', r.Rest);
  Nested;
  c.Eof := True;
  c.At := 3;
  WriteLn('a field: ', c.Eof, ' at ', c.At);
  WriteLn('a parameter: ', Cut('end', True), ' ', Cut('more', False));
  WriteLn('a local: ', Count('one two three four'));
  with c do
    WriteLn('a field in a with: ', Eof);
end.

