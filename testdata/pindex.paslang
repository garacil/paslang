program pindex;

type
  TBox = class
    FX: Integer;
    function Get(I: Integer): Integer;
    procedure Put(I, V: Integer);
    property Item[I: Integer]: Integer read Get write Put;
  end;

function TBox.Get(I: Integer): Integer;
begin
  Result := FX + I;
end;

procedure TBox.Put(I, V: Integer);
begin
  FX := I * 10 + V;
end;

var
  O: TBox;

begin
  O := TBox.Create;
  O.FX := 4;
  WriteLn(O.Item[3]);
  O.Item[2] := 5;
  WriteLn(O.FX);
end.
