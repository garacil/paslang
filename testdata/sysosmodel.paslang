program sysosmodel;
uses sysutils;
begin
  WriteLn(TOSVersion.Name);
  WriteLn(TOSVersion.Release);
  WriteLn(TOSVersion.Version);
  WriteLn(TOSVersion.Machine);
  WriteLn(TOSVersion.Major, ' ', TOSVersion.Minor, ' ', TOSVersion.Build);
  WriteLn(TOSVersion.ToString);
end.
