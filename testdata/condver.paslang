{ P263 (1.1.108): code chooses by the version of paslangc compiling it,
  as Free Pascal's code chooses by FPC_FULLVERSION. PASLANG_VERSION,
  PASLANG_RELEASE, PASLANG_PATCH and PASLANG_FULLVERSION are numbers in
  $if and $elseif, and names $ifdef sees; the expressions take
  numbers, those names, defined(NAME), the comparisons, not, and, or and
  xor, bound as paslang's operators bind (a comparison before and);
  $ifend ends as $endif; a branch not taken is not read, its
  expressions and messages included. Every line is the same on both
  machines and in every later version. }
program condver;

begin
{$if PASLANG_FULLVERSION >= 1001108}
  WriteLn('1.1.108 or later');
{$else}
  WriteLn('wrong: older');
{$endif}
{$if PASLANG_FULLVERSION < 1001108}
  WriteLn('wrong: older');
{$elseif PASLANG_VERSION >= 1}
  WriteLn('elseif taken');
{$else}
  WriteLn('wrong: else');
{$endif}
{$if (PASLANG_VERSION >= 1) and (PASLANG_RELEASE >= 0) and (PASLANG_PATCH >= 0)}
  WriteLn('the three parts');
{$endif}
{$if PASLANG_VERSION >= 1 and PASLANG_FULLVERSION > 1000000}
  WriteLn('a comparison binds before and');
{$endif}
{$if defined(PASLANG) and not defined(FPC)}
  WriteLn('paslang, not FPC');
{$endif}
{$if defined(CPUX86_64) xor defined(CPUAARCH64)}
  WriteLn('one machine');
{$endif}
{$if 0}
  this is not Pascal at all {$if nonsense never read} {$fatal never reached} {$endif}
{$elseif 2 > 3}
  nor this
{$else}
  WriteLn('else after if 0 and a false elseif');
{$ifend}
{$if -1 < 0}
  WriteLn('a minus');
{$endif}
{$define LOCAL}
{$if defined(LOCAL) or defined(NOWHERE)}
  WriteLn('a name the file defines');
{$endif}
{$ifdef PASLANG_FULLVERSION}
  WriteLn('the numbers are defined names too');
{$endif}
{$if not (1 = 2)}
  WriteLn('not of a parenthesis');
{$endif}
{$if 1}
{$if 0}
  WriteLn('wrong: nested if 0');
{$elseif 1}
  WriteLn('a nested elseif');
{$elseif 1}
  WriteLn('wrong: a second elseif');
{$endif}
{$endif}
{$info compiled by paslangc 1.1.108 or later}
end.
