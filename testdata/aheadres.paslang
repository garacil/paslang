{ P371: Result and the main block's own globals are operands no call
  put in place can change, so the call to their right goes in; a global
  a routine writes, or whose address is taken, keeps its place: the left
  operand is read before the call runs. Every line is the same at
  -inline 0. }
program aheadres;

type
  TPair = record
    A, B: Integer;
  end;

var
  g, s, i, w: Integer;
  pg: PInteger;

{ a loop: put in place by hoisting, ahead of the statement }
function Tri(X: Integer): Integer;
var
  k: Integer;
begin
  Result := 0;
  for k := 1 to X do
    Result := Result + k;
end;

function MkPair(A, B: Integer): TPair;
begin
  Result.A := A;
  Result.B := B;
end;

{ writes g, which it names }
function Bump: Integer;
begin
  Inc(g);
  Result := g;
end;

{ writes what P points to }
function IncVia(P: PInteger): Integer;
begin
  P^ := P^ + 1;
  Result := 1;
end;

function SumTri(N: Integer): Integer;
var
  j: Integer;
begin
  Result := 0;
  for j := 1 to N do
    Result := Result + Tri(j) + MkPair(j, 1).B;
end;

{ its own name as Result }
function Acc(N: Integer): Integer;
var
  j: Integer;
begin
  Acc := 0;
  for j := 1 to N do
    Acc := Acc + Tri(j);
end;

{ a nested routine names Result: it keeps its place }
function Nested(N: Integer): Integer;
  procedure Add;
  begin
    Result := Result + 100;
  end;
begin
  Result := N;
  Add;
  Result := Result + Tri(N);
end;

begin
  s := 0;
  for i := 1 to 10 do
    s := s + Tri(i);
  WriteLn('main ', s);
  WriteLn('sumtri ', SumTri(4), ' acc ', Acc(5), ' nested ', Nested(3));
  g := 5;
  g := g + Bump;
  WriteLn('bump ', g);
  w := 10;
  pg := @w;
  w := w + IncVia(pg);
  WriteLn('via ', w);
end.

