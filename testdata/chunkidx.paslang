{ P203: an inner for keeps the end of its run of 1024 in r11 on amd64
  (EmitFor) inside a region whose variables live in registers; an
  element of a record of 56 bytes indexed by one of those variables was
  scaled in r11 too (EmitWordMem, pool register D + 1, which IndexOK
  took as not needed), so the loop compared its counter with the scaled
  index and ran past its limit when the index was not 0: Shapes[1] gave
  index 3 out of range. Each shape's permutation sums to 30. }
program chunkidx;

type
  TShape = record
    N: Int64;
    Names: array of Int64;
    Perm: array of Int64;
    Pad: array[0..2] of Int64;
  end;
  TOut = record
    X: Int64;
    Names: array of Int64;
    Shapes: array[0..7] of TShape;
    Top: Int64;
  end;
  POut = ^TOut;

function Walk(O: POut; C, Sh: Int64): Int64;
var
  k: Int64;
begin
  Result := 0;
  for k := 0 to C - 1 do
    O^.Names[O^.Top + C + k] := O^.Names[O^.Top + O^.Shapes[Sh].Perm[k]];
  for k := 0 to C - 1 do
    Result := Result + O^.Names[O^.Top + C + k];
end;

var
  o: TOut;
  i, s: Int64;
begin
  SetLength(o.Names, 64);
  for i := 0 to 63 do
    o.Names[i] := i * 10;
  for s := 0 to 7 do
  begin
    o.Shapes[s].N := 3;
    SetLength(o.Shapes[s].Perm, 3);
    o.Shapes[s].Perm[0] := 2;
    o.Shapes[s].Perm[1] := 0;
    o.Shapes[s].Perm[2] := 1;
  end;
  for s := 0 to 7 do
    Write(Walk(@o, 3, s), ' ');
  WriteLn;
end.

