{ P629: TcpRead and TcpReadDeadline give up to MaxN bytes in one call,
  all that have come when fewer have. TcpReadDeadline stopped at 512
  bytes and TcpRead at 65536, bounds their interfaces did not say. }
program tcpreadmax;

uses
  pasnet;

var
  a, b, i, n: Integer;
  s, got: string;
begin
  if not UnixPair(a, b) then
    Halt(1);
  SockBuffers(a, 0, 4194304);
  SockBuffers(b, 4194304, 0);
  SetLength(s, 300000);
  for i := 1 to Length(s) do
    s[i] := Chr(65 + i mod 26);
  n := TcpWrite(a, s);
  got := TcpReadDeadline(b, 1048576, 5000);
  WriteLn('TcpReadDeadline, 300000 waiting, MaxN of a MiB: ', Length(got), ' ', got = s);
  n := TcpWrite(a, s);
  got := TcpReadDeadline(b, 1000, 5000);
  WriteLn('MaxN of 1000: ', Length(got));
  got := TcpRead(b, 1048576);
  WriteLn('TcpRead of the rest, MaxN of a MiB: ', Length(got), ' ', got = Copy(s, 1001, Length(s)));
  got := TcpReadDeadline(b, 4096, 50);
  WriteLn('nothing comes within the deadline: ''', got, '''');
  n := TcpWrite(a, 'abc');
  got := TcpRead(b, 1);
  WriteLn('MaxN of 1: ', got, ' ', TcpRead(b, 10));
  TcpClose(a);
  WriteLn('the end of the stream: ''', TcpRead(b, 100), '''');
  TcpClose(b);
end.
