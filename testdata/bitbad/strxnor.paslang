{ P105: xnor of a string and an integer is refused (two strings are one block, 1.0.120). }
program strxnor;

var
  i: Integer;
  b: Byte;
  d: Double;
  t: Boolean;
  s: string;
  q: Quad;
  a: array[0..1] of Integer;
  r: record X: Integer end;
  da: array of Integer;

function F: Integer;
begin
  Result := 0;
end;

begin
  i := 0;
  s := s xnor 1;
end.

