{ 1.0.137: a strict private field outside its class's methods, in the
  program that declared the class. }
program visstrictpriv;

type
  TA = class
  strict private
    FSecret: Integer;
  public
    constructor Create;
  end;

constructor TA.Create;
begin
  FSecret := 1;
end;

var
  a: TA;

begin
  a := TA.Create;
  WriteLn(a.FSecret);
end.

