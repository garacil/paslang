program caseacross;
{ A case range from $7FFFFFFFFFFFFFFF to $8000000000000000 is empty:
  Integer is signed, so the hex constant is negative (1.0.136); the
  message says so. }
var u: UInt64;
begin
  u := 5;
  case u of
    $7FFFFFFFFFFFFFFF..$8000000000000000: WriteLn('mid');
  end;
end.

