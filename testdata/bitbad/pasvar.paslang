{ 1.0.135: pas passes values, so a var parameter has nothing to point at. }
program pasvar;

procedure Bump(var X: Integer; Y: Integer);
begin
  X := X + Y;
end;

var
  n: Integer;

begin
  pas Bump(n, 1);
end.

