{ 1.0.137: a strict private field in a descendant's method: strict
  private is its class's alone. }
program visstrictdesc;

type
  TA = class
  strict private
    FSecret: Integer;
  end;

  TB = class(TA)
    function Get: Integer;
  end;

function TB.Get: Integer;
begin
  Result := Self.FSecret;
end;

begin
end.

