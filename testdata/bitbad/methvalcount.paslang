{ 1.0.135: a method value with its signature counts its arguments. }
program methvalcount;

type
  THit = procedure(A, B: Integer) of object;
  TBox = class
    procedure Hit(A, B: Integer);
  end;

procedure TBox.Hit(A, B: Integer);
begin
  WriteLn(A + B);
end;

var
  b: TBox;
  m: THit;

begin
  b := TBox.Create;
  m := b.Hit;
  m(1);
end.
