{ 1.0.135: a routine value that takes parameters, with none written,
  ran on whatever the registers held. }
program pasnoargs;

type
  TSum = procedure(A, B: Integer);

procedure Add(A, B: Integer);
begin
  WriteLn(A + B);
end;

var
  fs: array[0..1] of TSum;

begin
  fs[0] := @Add;
  pas fs[0];
end.

