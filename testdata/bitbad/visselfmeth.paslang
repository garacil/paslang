{ 1.0.137: an ancestor's private method through the implicit Self, in a
  descendant declared in another unit than the ancestor. }
program visselfmeth;

uses visu;

type
  TMine = class(TVisBase)
    procedure Show;
  end;

procedure TMine.Show;
begin
  ProtShow;
  PrivShow;
end;

begin
end.

