{ 1.0.134: Result of a routine with a closure is not shared. }
program capresult;

type
  TAct = procedure;

function F: Integer;
var
  a: TAct;
  procedure Set9;
  begin
    Result := 9;
  end;
begin
  a := procedure
  begin
  end;
  Set9;
end;

begin
  WriteLn(F);
end.

