{ 1.0.137: a strict protected field outside the methods of its class and
  its descendants, in the program that declared the class. }
program visstrictprot;

type
  TA = class
  strict protected
    FSP: Integer;
  end;

var
  a: TA;

begin
  a := TA.Create;
  a.FSP := 3;
end.

