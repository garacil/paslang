{ 1.0.134: a closure may not keep a var parameter. }
program capvar;

type
  TAct = procedure;

procedure P(var X: Integer);
var
  f: TAct;
begin
  f := procedure
  begin
    X := 1;
  end;
end;

var
  n: Integer;

begin
  P(n);
end.

