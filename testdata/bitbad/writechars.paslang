{ 1.0.125: Write printed a static array of Char's address. }
program writechars;

type
  TR = record X: Integer end;

var
  a: V128;
  x: V256;
  i: Integer;
  r: TR;
  s: array of Integer;
  c: array[0..1] of Char;

begin
  Write(c);
end.

