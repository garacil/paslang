{ 1.0.144: a static array does not go into a var array of T. }
program vararr;

procedure Fill(var A: array of Byte);
begin
  A[0] := 1;
end;

var
  b: array[0..3] of Byte;

begin
  Fill(b);
  WriteLn(b[0]);
end.

