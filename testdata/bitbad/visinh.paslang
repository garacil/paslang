{ 1.0.137: inherited reaches a parent's method as its visibility lets:
  a strict private one is the parent's alone. }
program visinh;

type
  TA = class
  strict private
    procedure Hid;
  end;

  TB = class(TA)
    procedure Hid;
  end;

procedure TA.Hid;
begin
end;

procedure TB.Hid;
begin
  inherited Hid;
end;

begin
end.
