{ 1.0.135: a method value's var parameter has nothing to point at in a
  pas either. }
program pasmethvar;

type
  TBump = procedure(var X: Integer) of object;
  TBox = class
    procedure Bump(var X: Integer);
  end;

procedure TBox.Bump(var X: Integer);
begin
  Inc(X);
end;

var
  b: TBox;
  m: TBump;
  n: Integer;

begin
  b := TBox.Create;
  m := b.Bump;
  pas m(n);
end.

