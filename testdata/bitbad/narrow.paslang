{ P105: b += i narrows an Integer into a Byte, as b := b + i does. }
program narrow;

var
  i: Integer;
  b: Byte;
  d: Double;
  t: Boolean;
  s: string;
  q: Quad;
  a: array[0..1] of Integer;
  r: record X: Integer end;
  da: array of Integer;

function F: Integer;
begin
  Result := 0;
end;

begin
  i := 0;
  b += i;
end.

