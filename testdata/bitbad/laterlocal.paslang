{ 1.0.116: a nested routine does not see a var declared after it. }
program laterlocal;

procedure Outer;

  procedure Inner;
  begin
    n := 1;
  end;

var
  n: Integer;
begin
  Inner;
  WriteLn(n);
end;

begin
  Outer;
end.

