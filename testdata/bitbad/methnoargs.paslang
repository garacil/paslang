{ 1.0.135: obj.M; of a method that takes parameters is not a call of
  it; it ran on whatever the registers held. }
program methnoargs;

type
  TBox = class
    procedure Hit(A, B: Integer);
  end;

procedure TBox.Hit(A, B: Integer);
begin
  WriteLn(A + B);
end;

var
  b: TBox;

begin
  b := TBox.Create;
  b.Hit;
end.

