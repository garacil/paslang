{ 1.0.137: an ancestor's private field through the implicit Self, in a
  descendant declared in another unit than the ancestor. }
program visselfpriv;

uses visu;

type
  TMine = class(TVisBase)
    function Get: Integer;
  end;

function TMine.Get: Integer;
begin
  Result := FProt + FPriv;
end;

begin
end.

