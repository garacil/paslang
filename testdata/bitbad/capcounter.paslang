{ 1.0.134: a counter a closure keeps is no inner loop's counter. }
program capcounter;

type
  TGen = function: Integer;

var
  i: Integer;
  f: TGen;

begin
  for i := 0 to 2 do
  begin
    f := function: Integer
    begin
      Result := i;
    end;
    for i := 0 to 1 do
      WriteLn(i);
  end;
end.

