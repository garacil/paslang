{ 1.0.137: the value of a strict private method outside its class. }
program vismethval;

type
  TIntMeth = procedure(N: Integer) of object;
  TA = class
  strict private
    procedure Bump(N: Integer);
  end;

procedure TA.Bump(N: Integer);
begin
end;

var
  a: TA;
  m: TIntMeth;

begin
  a := TA.Create;
  m := a.Bump;
end.
