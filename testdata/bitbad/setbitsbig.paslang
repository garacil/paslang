{ 1.0.117: a constant too wide for its field is a compile error. }
program setbitsbig;

var
  i: Integer;
  b: Byte;
  d: Double;
  t: Boolean;
  s: string;
  q: Quad;
  a: array[0..1] of Integer;
  r: record X: Integer end;
  da: array of Integer;

function F: Integer;
begin
  Result := 0;
end;

begin
  i := 0;
  SetBits(b, 0, 4, 20);
end.

