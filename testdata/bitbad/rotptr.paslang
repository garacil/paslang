{ P108 (1.0.130): a rotation of a record that holds a string would make
  an address up. }
program rotptr;

type
  TNamed = record
    N: Integer;
    S: string;
  end;

var
  r: TNamed;

begin
  r := RotateLeftToCarry(r, 3);
end.

