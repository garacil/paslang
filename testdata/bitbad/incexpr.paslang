{ 1.0.119: Inc needs a variable. }
program incexpr;

var
  i: Integer;
  b: Byte;
  d: Double;
  t: Boolean;
  s: string;
  q: Quad;
  a: array[0..1] of Integer;
  r: record X: Integer end;
  p: Pointer;
  da: array of Integer;

function F: Integer;
begin
  Result := 0;
end;

begin
  i := 0;
  Inc(i + 1);
end.
