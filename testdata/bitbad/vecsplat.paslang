{ 1.0.125: VSplat takes an integer. }
program vecsplat;

type
  TR = record X: Integer end;

var
  a: V128;
  x: V256;
  i: Integer;
  r: TR;
  s: array of Integer;
  c: array[0..1] of Char;

begin
  a := VSplat8(1.5);
end.

