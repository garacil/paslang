{ 1.0.120: a string does not go into an Integer. }
program strtoint;

type
  TR = record X: Integer end;

var
  i: Integer;
  s: string;
  r: TR;
  d: array of Integer;
  d2: array of Byte;

begin
  i := 0;
  i := s;
end.

