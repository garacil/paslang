program sysfamilies;
uses sysutils;
const Workers = 128;
var done: waitgroup; i: Integer;

function StackCheck(Depth, Index: Integer): Integer;
var values: array[0..255] of Integer; value: Integer;
begin
  values[0] := Index; values[255] := Depth;
  if Depth = 0 then begin GcCollect; value := Index end
  else value := StackCheck(Depth - 1, Index);
  if (values[0] <> Index) or (values[255] <> Depth) then Halt(2);
  Result := value;
end;

procedure Check(Index: Integer);
var settings: TFormatSettings; moment, parsed: TDateTime;
  text, expected, identity: string; value, k: Integer;
begin
  settings := DefaultFormatSettings;
  settings.DateSeparator := '-'; settings.ShortDateFormat := 'yyyy/mm/dd';
  settings.TimeSeparator := ':'; settings.ShortTimeFormat := 'hh:nn:ss';
  settings.LongTimeFormat := 'hh:nn:ss';
  if Odd(Index) then settings.DecimalSeparator := ','
  else settings.DecimalSeparator := '.';
  identity := IntToStr(Index);
  moment := EncodeDate(2024, 2, 29) + EncodeTime(12, 34, 56, 0);
  if StackCheck(24, Index) <> Index then Halt(3);
  for k := 1 to 16 do
  begin
    if StringReplace('ñ雪::' + identity + '::😀', '::', '/', [rfReplaceAll]) <>
      'ñ雪/' + identity + '/😀' then Halt(4);
    if CompareText(Trim('  hello '), 'HELLO') <> 0 then Halt(5);
    text := QuotedStr('ñ' + identity + '''雪');
    if AnsiDequotedStr(text, '''') <> 'ñ' + identity + '''雪' then Halt(6);
    if not TryStrToInt(identity, value) or (value <> Index) then Halt(7);
    if Odd(Index) then expected := '1,25' else expected := '1.25';
    if FloatToStr(1.25, settings) <> expected then Halt(8);
    if StrToFloat(expected, settings) <> 1.25 then Halt(9);
    if Format('%s:%.2f:%d', [identity, 1.25, Index], settings) <>
      identity + ':' + expected + ':' + identity then Halt(10);
    if FormatDateTime('yyyy/mm/dd hh:nn:ss', moment, settings) <>
      '2024-02-29 12:34:56' then Halt(11);
    if not TryStrToDate('2024-02-29', parsed, settings) or
      (parsed <> EncodeDate(2024, 2, 29)) then Halt(12);
    if not TryStrToTime('12:34:56', parsed, settings) or
      (parsed <> EncodeTime(12, 34, 56, 0)) then Halt(13);
    { Exercise the shared zone cache from competing Gs. No routine
      mutates process-wide time-zone state. }
    parsed := UniversalTimeToLocal(moment);
    if Abs(LocalTimeToUniversal(parsed) - moment) > 0.5 / SecsPerDay then Halt(14);
    if DayOfWeek(moment) <> 5 then Halt(15);
    try
      raise EConvertError.CreateFmt('routine %d', [Index]);
    except
      on error: EConvertError do
        if (error.Message <> 'routine ' + identity) or
          (ExceptObject <> error) then Halt(16);
    end;
    try text := Format('%q', [Index], settings); Halt(17)
    except on EConvertError do ; end;
    if (k mod 8) = 0 then GcCollect;
  end;
  done.Done;
end;
begin
  done.Add(Workers);
  for i := 0 to Workers - 1 do pas Check(i);
  done.Wait;
  WriteLn('strings, formatting, dates, zone cache, isolated exceptions and growing stacks 128');
end.
