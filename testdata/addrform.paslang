program addrform;

{ Every shape of element address (P100, 1.0.99): a global array at its
  link-time address on amd64 (v_a-10(,%rdi,2)), [base, index, lsl #k]
  and [base, #offset] on arm64, a slice's register as the base; fields
  near and far, arrays of records, arrays in records, two dimensions,
  a low bound above and below zero, constant indexes, strings, and a
  place whose address is needed whole (a[i].f, m[i][j]). }

type
  TRec = record
    B: Byte;
    W: Word;
    X: Int32;
    Q: Integer;
  end;
  TBig = record
    Pad: array[0..999] of Integer;
    Tail: Word;
    Pad2: array[0..100] of Integer;
    Last: Byte;
  end;
  PBig = ^TBig;
  TRow = array[0..6] of Int16;

var
  w5: array[5..40] of Word;
  neg: array[-3..3] of Int8;
  recs: array[0..9] of TRec;
  grid: array[0..4] of TRow;
  big: TBig;
  pb: PBig;
  d: array of Int32;
  dr: array of TRec;
  s: string;
  i, j, sum: Integer;

procedure Locals;
var
  la: array[2..12] of Integer;
  lr: array[0..3] of TRec;
  k, t: Integer;
begin
  for k := 2 to 12 do
    la[k] := k * k;
  for k := 0 to 3 do
  begin
    lr[k].B := Byte(k + 250);
    lr[k].W := Word(k * 1000 + 60000);
    lr[k].X := Int32(k * 70000 - 100000);
    lr[k].Q := la[k + 2];
  end;
  t := la[2] + la[12];
  for k := 0 to 3 do
    t := t + lr[k].B + lr[k].W + lr[k].X + lr[k].Q;
  WriteLn('locals ', t);
end;

begin
  for i := 5 to 40 do
    w5[i] := Word(i * 1999);
  w5[7] := w5[7] + 3;
  sum := w5[5] + w5[7] + w5[40];
  for i := 5 to 40 do
    sum := sum + w5[i];
  WriteLn('w5 ', sum);

  for i := -3 to 3 do
    neg[i] := Int8(i * 40);
  sum := neg[-3] + neg[3];
  for i := -3 to 3 do
    sum := sum * 3 + neg[i];
  WriteLn('neg ', sum);

  for i := 0 to 9 do
  begin
    recs[i].B := Byte(i * 29);
    recs[i].W := Word(i * 7001);
    recs[i].X := Int32(i * -123456);
    recs[i].Q := i * 1000000007;
  end;
  recs[3].W := recs[3].W + 1;
  sum := 0;
  for i := 0 to 9 do
    sum := sum + recs[i].B + recs[i].W + recs[i].X + recs[i].Q mod 1000;
  WriteLn('recs ', sum, ' ', recs[9].X, ' ', recs[0].B);

  for i := 0 to 4 do
    for j := 0 to 6 do
      grid[i][j] := Int16(i * 1000 - j * 7);
  sum := grid[4][6];
  for i := 0 to 4 do
    for j := 0 to 6 do
      sum := sum + grid[i][j] * (j + 1);
  WriteLn('grid ', sum);

  big.Pad[999] := 17;
  big.Tail := 65535;
  big.Last := 201;
  pb := @big;
  pb^.Pad[500] := 3;
  WriteLn('big ', big.Pad[999] + pb^.Pad[500], ' ', pb^.Tail, ' ', pb^.Last, ' ', big.Tail + big.Last);

  SetLength(d, 100);
  for i := 0 to 99 do
    d[i] := Int32(i * -30000);
  sum := d[0] + d[99];
  for i := 0 to 99 do
    sum := sum + d[i] div 7;
  WriteLn('d ', sum);

  SetLength(dr, 8);
  for i := 0 to 7 do
  begin
    dr[i].W := Word(i * 9000);
    dr[i].Q := dr[i].W * 3;
  end;
  sum := 0;
  for i := 0 to 7 do
    sum := sum + dr[i].W + dr[i].Q;
  WriteLn('dr ', sum, ' ', dr[7].W);

  s := 'address forms';
  sum := 0;
  for i := 1 to Length(s) do
    sum := sum * 7 + Ord(s[i]);
  WriteLn('s ', sum, ' ', s[1], s[Length(s)]);

  Locals;
end.
