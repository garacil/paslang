{ P326: a call the inliner puts in place goes ahead only of what it
  cannot change, so every answer is the same at every -inline: a local
  given to a var parameter, one whose address a routine writes
  through, one a nested routine writes when the call runs it through a
  routine value, and a var parameter that is a global the call writes
  are read before the call, left to right; a local nothing reaches may
  be read after it, the same value. The answers are worked out by hand
  in the comments. }
program inlineorder;

type
  PInt = ^Integer;
  TFn = function(K: Integer): Integer;

var
  g: Integer;
  gp: PInt;

function BumpVar(var X: Integer; K: Integer): Integer;
begin
  X := X + 100;
  Result := K;
end;

function BumpGp(K: Integer): Integer;
begin
  gp^ := gp^ + 100;
  Result := K;
end;

function BumpG(K: Integer): Integer;
begin
  g := g + 100;
  Result := K;
end;

function Apply(F: TFn; K: Integer): Integer;
begin
  Result := F(K);
end;

function Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

{ v given to a var parameter: 5 + 1 * 10, then v is 105 }
function GivenVar: Integer;
var
  v: Integer;
begin
  v := 5;
  Result := v + BumpVar(v, 1) * 10;
  Result := Result * 1000 + v;
end;

{ v's address in a global the call writes through: 7 + 2, then 107 }
function Addressed: Integer;
var
  v: Integer;
begin
  v := 7;
  gp := @v;
  Result := v + BumpGp(2);
  Result := Result * 1000 + v;
end;

{ v written by a nested routine the call runs: 3 + 4, then 1003 }
function Nested: Integer;
var
  v: Integer;

  function Inner(K: Integer): Integer;
  begin
    v := v + 1000;
    Result := K;
  end;

begin
  v := 3;
  Result := v + Apply(@Inner, 4);
  Result := Result * 10000 + v;
end;

{ X the global g, which the call writes: 5 + 1 }
function ViaVar(var X: Integer): Integer;
begin
  Result := X + BumpG(1);
end;

{ t nothing reaches: 11 + 10 * 2, read after the call or before }
function Plain: Integer;
var
  t: Integer;
begin
  t := 11;
  Result := t + Twice(5) * 2;
end;

begin
  WriteLn(GivenVar, ' ', Addressed, ' ', Nested);
  g := 5;
  WriteLn(ViaVar(g), ' ', g);
  WriteLn(Plain);
end.

