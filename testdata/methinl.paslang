{ P369: a small method of a class called with the dispatch the compiler
  fixes goes in where it is called, its Self the object the call gives:
  getters of one expression, a check and a place for a record result,
  procedures that write fields, a method that changes Self, called on
  Self, on a variable, on a field, on a call's value; a virtual method
  keeps its dispatch, and inherited calls the parent's. Every line is
  the same at -inline 0, where each stays a call. }
program methinl;

type
  TPair = record
    A, B: Integer;
  end;

  TBox = class
    FCount: Integer;
    FItems: array of TPair;
    FNext: TBox;
    function Count: Integer;
    function Item(K: Integer): TPair;
    function Twice(K: Integer): Integer;
    procedure Add(A, B: Integer);
    procedure Bump(K: Integer);
    function Sum: Integer;
    function Hop: Integer;
    function Kind: Integer; virtual;
    function Name: string; virtual;
  end;

  TBig = class(TBox)
    function Kind: Integer; override;
    function Name: string; override;
  end;

var
  b, c: TBox;
  big: TBox;
  p: TPair;
  i, s: Integer;

function TBox.Count: Integer;
begin
  Result := FCount;
end;

function TBox.Item(K: Integer): TPair;
begin
  if (K < 0) or (K >= FCount) then
    K := 0;
  Result := FItems[K];
end;

function TBox.Twice(K: Integer): Integer;
begin
  Result := Count * 0 + K * 2;
end;

procedure TBox.Add(A, B: Integer);
begin
  SetLength(FItems, FCount + 1);
  FItems[FCount].A := A;
  FItems[FCount].B := B;
  Inc(FCount);
end;

procedure TBox.Bump(K: Integer);
begin
  FItems[K].A := FItems[K].A + 100;
end;

function TBox.Sum: Integer;
var
  j: Integer;
begin
  Result := 0;
  for j := 0 to Count - 1 do
    Result := Result + Item(j).A + Item(j).B;
end;

{ changes Self: the call's object is a copy, the caller's variable stays }
function TBox.Hop: Integer;
begin
  Result := FCount;
  Self := FNext;
  if Self <> nil then
    Result := Result * 10 + FCount;
end;

function TBox.Kind: Integer;
begin
  Result := 1;
end;

function TBox.Name: string;
begin
  Result := 'box';
end;

function TBig.Kind: Integer;
begin
  Result := inherited Kind + 10;
end;

function TBig.Name: string;
begin
  Result := 'big ' + inherited Name;
end;

function MakeBox(N: Integer): TBox;
var
  k: Integer;
begin
  Result := TBox.Create;
  for k := 1 to N do
    Result.Add(k, k * k);
end;

begin
  b := MakeBox(3);
  c := MakeBox(5);
  b.FNext := c;
  WriteLn('count ', b.Count, ' ', c.Count, ' ', MakeBox(7).Count);
  WriteLn('item ', b.Item(1).A, ' ', b.Item(2).B, ' ', c.Item(9).B, ' ', b.Item(-1).A);
  p := c.Item(4);
  WriteLn('copy ', p.A, ' ', p.B);
  WriteLn('twice ', b.Twice(21));
  b.Bump(0);
  b.Bump(0);
  WriteLn('bump ', b.Item(0).A);
  WriteLn('sum ', b.Sum, ' ', c.Sum);
  WriteLn('hop ', b.Hop, ' ', b.Count, ' ', c.Hop);
  s := 0;
  for i := 0 to b.Count - 1 do
    s := s + b.Item(i).B;
  WriteLn('loop ', s);
  if b.FNext.Item(4).A = 5 then
    WriteLn('next ', b.FNext.Count);
  big := TBig.Create;
  WriteLn('kind ', b.Kind, ' ', big.Kind, ' ', big.Name, ' ', b.Name);
  big.Add(8, 9);
  WriteLn('big ', big.Count, ' ', big.Item(0).B);
end.

