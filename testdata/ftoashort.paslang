{ P481: FloatToStr of a Double or a Single makes its digits straight into the
  string it returns. The expected output was made by the compiler before:
  fixed values (zeros, signs, infinities, NaN, the limits, powers of ten, the
  edges of the plain form at 1E-5 and 1E15), then two hundred thousand
  Doubles from random bits and from random decimals, and as many Singles,
  folded into a hash with the length of every text, and a few written with a
  comma for the point. }
program ftoashort;

uses
  sysutils;

var
  h: Int64;
  seed: Int64;

function Next: Int64;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := seed;
end;

procedure Mix(const S: string);
var
  i: Integer;
begin
  h := h * 1000003 + Length(S);
  for i := 1 to Length(S) do
    h := (h * 31 + Ord(S[i])) xor (h shr 33);
end;

procedure Show(X: Double);
begin
  WriteLn(FloatToStr(X));
end;

var
  i, k: Integer;
  d: Double;
  f: Single;
  bits: Int64;
  fs: TFormatSettings;
begin
  Show(0.0);
  Show(-0.0);
  Show(1.0);
  Show(-1.0);
  Show(0.1);
  Show(1.0 / 3.0);
  Show(100.0);
  Show(123456789012345.0);
  Show(1234567890123456.0);
  Show(1e15);
  Show(1e16);
  Show(1e-5);
  Show(1e-6);
  Show(1.5e-6);
  Show(0.000123);
  Show(5e-324);
  Show(1.7976931348623157e308);
  Show(2.2250738585072014e-308);
  Show(123456.789);
  Show(-123456.789e10);
  Show(1.0 / 0.0);
  Show(-1.0 / 0.0);
  Show(0.0 / 0.0);
  Show(4.35);
  Show(9007199254740993.0);
  Show(0.3);
  Show(2.5e20);
  WriteLn(FloatToStr(Single(0.1)), ' ', FloatToStr(Single(16777216.0)), ' ', FloatToStr(Single(3.4028235e38)), ' ',
    FloatToStr(Single(1.0e-45)), ' ', FloatToStr(Single(-2.5)), ' ', FloatToStr(Single(1.0e10)));
  seed := 20261027;
  h := 7;
  for i := 1 to 200000 do
  begin
    bits := Next;
    Move(bits, d, 8);
    Mix(FloatToStr(d));
    k := Integer((Next shr 40) mod 2000000) - 1000000;
    d := k / 1000.0;
    Mix(FloatToStr(d));
    d := (Next shr 12) / 4503599627370496.0 * 1e15;
    Mix(FloatToStr(d));
    d := Integer(Next shr 33) * 1.0;
    Mix(FloatToStr(d));
    bits := Next and $FFFFFFFF;
    Move(bits, f, 4);
    Mix(FloatToStr(f));
    f := (Next shr 40) / 1000.0;
    Mix(FloatToStr(f));
  end;
  WriteLn('hash ', h);
  fs := DefaultFormatSettings;
  fs.DecimalSeparator := ',';
  WriteLn(FloatToStr(1234.5678, fs), ' ', FloatToStr(0.5, fs), ' ', FloatToStr(1.0e20, fs), ' ', FloatToStr(1.25e-7, fs),
    ' ', FloatToStr(Single(0.1), fs), ' ', FloatToStr(7.0, fs), ' ', FloatToStr(-0.0, fs));
end.
