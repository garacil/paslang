{ P96: a big map is a directory of tables of at most 1024 slots that
  split one at a time (Go's extendible hashing). Many splits with eight-
  byte keys, string keys and record values; string keys of every length
  XXH3 has a path for, with string values (1.0.67: a split moves string
  keys by a loop of its own, whose hash must be a lookup's); deleted
  slots reused; loops
  that see every key once while the map grows, splits and loses keys
  under them; Clear and a size hint on a split map. The order of a loop
  is not specified, so the loops count, add and check each key once. }
program mapsplit;

uses
  paslib;

type
  TPoint = record
    X, Y: Integer;
  end;

var
  m, seen, h: map[Integer] of Integer;
  s: map[string] of Integer;
  r: map[Integer] of TPoint;
  t: map[string] of string;
  k, v, i, n, sum, bad, twice: Integer;
  p: TPoint;
  key, long, sv: string;

begin
  { 200000 keys: a few hundred tables, found and missed. }
  New(m);
  for i := 1 to 200000 do
    m[i * 7919] := i;
  sum := 0;
  bad := 0;
  for i := 1 to 200000 do
  begin
    sum := sum + m[i * 7919];
    if (i * 7919 + 1) in m then
      bad := bad + 1;
  end;
  WriteLn(Length(m), ' ', sum, ' ', bad);

  { Every third key deleted, then put back: tombstones reused. }
  i := 3;
  while i <= 200000 do
  begin
    Delete(m, i * 7919);
    i := i + 3;
  end;
  WriteLn(Length(m), ' ', (3 * 7919) in m, ' ', (4 * 7919) in m);
  i := 3;
  while i <= 200000 do
  begin
    m[i * 7919] := i;
    i := i + 3;
  end;
  sum := 0;
  for i := 1 to 200000 do
    sum := sum + m[i * 7919];
  WriteLn(Length(m), ' ', sum);

  { A loop sees every key once. }
  New(seen);
  n := 0;
  twice := 0;
  for k, v in m do
  begin
    n := n + 1;
    if k in seen then
      twice := twice + 1;
    seen[k] := 1;
    if v * 7919 <> k then
      bad := bad + 1;
  end;
  WriteLn(n, ' ', twice, ' ', bad, ' ', Length(seen));

  { A loop while 300000 keys go in: tables split under it. Every old
    key comes once; no key comes twice. }
  Clear(seen);
  n := 0;
  twice := 0;
  i := 0;
  for k in m do
  begin
    if k in seen then
      twice := twice + 1;
    seen[k] := 1;
    if k mod 7919 = 0 then
      n := n + 1;
    if i < 300000 then
      for v := 1 to 100 do
      begin
        i := i + 1;
        m[i * 7919 + 5] := i;
      end;
  end;
  WriteLn(n, ' ', twice, ' ', Length(m));

  { A loop that deletes keys ahead of it: a deleted key never comes. }
  Clear(seen);
  bad := 0;
  n := 0;
  for k in m do
  begin
    if k mod 7919 <> 0 then
    begin
      if k in seen then
        bad := bad + 1;
      Delete(m, k);
      Delete(m, k + 7919);
      seen[k + 7919] := 1;
      n := n + 1;
    end;
  end;
  sum := 0;
  for k in m do
    if k mod 7919 <> 0 then
      sum := sum + 1;
  WriteLn(bad, ' ', sum, ' ', Length(m));

  { String keys through the general path. }
  New(s);
  for i := 1 to 60000 do
    s['key' + IntToStr(i)] := i;
  sum := 0;
  for i := 1 to 60000 do
    sum := sum + s['key' + IntToStr(i)];
  bad := 0;
  for i := 60001 to 61000 do
    if ('key' + IntToStr(i)) in s then
      bad := bad + 1;
  for i := 1 to 30000 do
    Delete(s, 'key' + IntToStr(i * 2));
  n := 0;
  for key, v in s do
  begin
    n := n + 1;
    if key <> 'key' + IntToStr(v) then
      bad := bad + 1;
  end;
  WriteLn(Length(s), ' ', sum, ' ', bad, ' ', n);

  { Record values: a wider slot. }
  New(r);
  for i := 1 to 30000 do
  begin
    p.X := i;
    p.Y := -i;
    r[i] := p;
  end;
  sum := 0;
  for k, p in r do
    sum := sum + p.X + p.Y + k;
  p := r[29999];
  WriteLn(Length(r), ' ', sum, ' ', p.X, ' ', p.Y);

  { Clear keeps the tables; the map fills again. }
  Clear(m);
  WriteLn(Length(m), ' ', 7919 in m);
  for i := 1 to 50000 do
    m[i] := i;
  n := 0;
  sum := 0;
  for k, v in m do
  begin
    n := n + 1;
    sum := sum + k - v;
  end;
  WriteLn(Length(m), ' ', n, ' ', sum);

  { A hint makes the tables at once. }
  New(h, 100000);
  for i := 1 to 100000 do
    h[i * 3] := i;
  sum := 0;
  for i := 1 to 100000 do
    sum := sum + h[i * 3];
  n := 0;
  for k in h do
    n := n + 1;
  WriteLn(Length(h), ' ', sum, ' ', n);

  { Keys of 0 to 305 bytes (a prefix of i mod 301 letters, then i) and
    string values: every XXH3 path, slots of 16 bytes, many splits. }
  long := '';
  for i := 1 to 300 do
    long := long + Chr(97 + i mod 26);
  New(t);
  t[''] := 'empty';
  for i := 0 to 20000 do
    t[Copy(long, 1, i mod 301) + IntToStr(i)] := IntToStr(i);
  bad := 0;
  for i := 0 to 20000 do
    if t[Copy(long, 1, i mod 301) + IntToStr(i)] <> IntToStr(i) then
      bad := bad + 1;
  n := 0;
  for key, sv in t do
  begin
    n := n + 1;
    if Copy(key, Length(key) - Length(sv) + 1, Length(sv)) <> sv then
      if key <> '' then
        bad := bad + 1;
  end;
  WriteLn(Length(t), ' ', n, ' ', bad, ' ', t['']);
end.

