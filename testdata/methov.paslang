program methov;

type
  TBase = class
    function Hit(N: Integer): Integer; virtual;
    function Hit(S: string): Integer; virtual;
  end;

  TChild = class(TBase)
    function Hit(N: Integer): Integer; override;
    function Hit(S: string): Integer; override;
    function Sum(A, B: Integer): Integer;
    procedure Go;
  end;

function TBase.Hit(N: Integer): Integer;
begin
  Result := N;
end;

function TBase.Hit(S: string): Integer;
begin
  Result := 1;
end;

function TChild.Hit(N: Integer): Integer;
begin
  Result := N + 10;
end;

function TChild.Hit(S: string): Integer;
begin
  Result := Length(S);
end;

function TChild.Sum(A, B: Integer): Integer;
begin
  Result := A + B;
end;

procedure TChild.Go;
begin
  WriteLn(Hit(4));
end;

var
  b: TBase;
  c: TChild;

begin
  c := TChild.Create;
  b := c;
  WriteLn(c.Hit(3));
  WriteLn(b.Hit(3));
  WriteLn(c.Hit('abcd'));
  WriteLn(b.Hit('abcd'));
  WriteLn(c.Sum(2, 5));
  c.Go;
end.
