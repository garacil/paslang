{ An object goes where an interface goes (P140): an argument of a
  routine or a method, among many arguments, a const parameter, a
  function's result and Exit, an element of an array, a field; a call
  through the interface runs the object's own virtual method, an
  override too; an interface goes where its parent interface goes. }
program ifacebind;

type
  IBase = interface
    function Name: string;
  end;

  IMore = interface(IBase)
    function Size: Int64;
  end;

  ICount = interface
    function Count: Int64;
  end;

  TShape = class(TObject, IMore, ICount)
    N: Int64;
    constructor Create(AN: Int64);
    function Name: string; virtual;
    function Size: Int64; virtual; abstract;
    function Count: Int64;
  end;

  TSquare = class(TShape)
    function Name: string; override;
    function Size: Int64; override;
  end;

  TCube = class(TSquare)
    function Size: Int64; override;
  end;

  THolder = record
    Tag: Int64;
    Item: IMore;
  end;

  TPrinter = class
    Lines: Int64;
    procedure Print(const What: string; Item: IMore);
    function Total(A: Int64; X: IMore; B: Int64; Y: ICount; C: Int64; Z: IMore): Int64;
  end;

constructor TShape.Create(AN: Int64);
begin
  N := AN;
end;

function TShape.Name: string;
begin
  Result := 'shape';
end;

function TShape.Count: Int64;
begin
  Result := N;
end;

function TSquare.Name: string;
begin
  Result := 'square';
end;

function TSquare.Size: Int64;
begin
  Result := N * N;
end;

function TCube.Size: Int64;
begin
  Result := N * N * N;
end;

procedure TPrinter.Print(const What: string; Item: IMore);
begin
  Inc(Lines);
  WriteLn(What, ': ', Item.Name, ' ', Item.Size);
end;

function TPrinter.Total(A: Int64; X: IMore; B: Int64; Y: ICount; C: Int64; Z: IMore): Int64;
begin
  Result := A + X.Size + B + Y.Count + C + Z.Size;
end;

function Describe(const X: IBase): string;
begin
  Result := X.Name;
end;

function Biggest(A, B: TShape): IMore;
begin
  if A.Size >= B.Size then
    Result := A
  else
    Exit(B);
end;

var
  sq: TSquare;
  cu: TCube;
  sh: TShape;
  p: TPrinter;
  m: IMore;
  b: IBase;
  items: array of IMore;
  h: THolder;
  i: Int64;
begin
  sq := TSquare.Create(3);
  cu := TCube.Create(2);
  sh := cu;
  p := TPrinter.Create;
  p.Print('square', sq);
  p.Print('cube as shape', sh);
  WriteLn('total ', p.Total(1, sq, 10, cu, 100, sh));
  m := Biggest(sq, cu);
  WriteLn('biggest ', m.Name, ' ', m.Size);
  m := Biggest(TCube.Create(4), sq);
  WriteLn('biggest ', m.Name, ' ', m.Size);
  b := m;
  WriteLn('as base ', b.Name, ' ', Describe(m), ' ', Describe(b));
  SetLength(items, 3);
  items[0] := sq;
  items[1] := cu;
  items[2] := sh;
  for i := 0 to High(items) do
    WriteLn('item ', i, ' ', items[i].Name, ' ', items[i].Size);
  h.Tag := 7;
  h.Item := TCube.Create(5);
  WriteLn('field ', h.Tag, ' ', h.Item.Size);
  WriteLn('lines ', p.Lines);
end.

