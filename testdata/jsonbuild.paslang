{ P207: documents built. JsonObject and JsonArray of every kind an
  array of const holds, and of a record and an enumeration through
  JsonOf; TJsonBuilder, its document the one JsonParse makes of its
  text, reused after Done; and every misuse, an EJsonError. }
program jsonbuild;

type
  TPoint = record
    X, Y: Integer;
  end;
  TColor = (Red, Green, Blue);

var
  b: TJsonBuilder;
  j, k: json;
  p: TPoint;
  q: Quad;
  c: Currency;
  i: Integer;
  nan: Double;

procedure Misuse(N: Integer);
var
  bb: TJsonBuilder;
  r: json;
  m: Integer;
begin
  bb := TJsonBuilder.Create;
  try
    case N of
      0: bb.Name('a');
      1:
        begin
          bb.BeginObject;
          bb.Add(1);
        end;
      2:
        begin
          bb.BeginArray;
          bb.EndObject;
        end;
      3:
        begin
          bb.BeginArray;
          r := bb.Done;
        end;
      4: r := bb.Done;
      5:
        begin
          bb.Add(1);
          bb.Add(2);
        end;
      6:
        begin
          bb.BeginObject;
          bb.Name('a');
          bb.Add(1);
          bb.Name('a');
          bb.Add(2);
          bb.EndObject;
        end;
      7: bb.AddNumber('01');
      8: bb.Add(nan);
      9: bb.Add(#255);
      10: r := JsonObject(['a']);
      11: r := JsonObject([1, 2]);
      12:
        begin
          bb.BeginObject;
          for m := 0 to 99 do
          begin
            bb.Name('m' + Char(65 + (m mod 70) div 26) + Char(65 + (m mod 70) mod 26));
            bb.Add(m);
          end;
          bb.EndObject;
        end;
      13:
        begin
          bb.BeginObject;
          bb.Name('a');
          bb.EndObject;
        end;
    end;
    WriteLn(N, ' no error');
  except
    on E: EJsonError do
      WriteLn(N, ' ', E.Message);
  end;
end;

begin
  p.X := 3;
  p.Y := 4;
  q := 1;
  c := 1.25;
  j := JsonObject(['name', 'Ana', 'age', 42, 'tall', True, 'ratio', 0.5, 'none', nil,
    'tags', JsonArray(['a', 'b', 1]), 'p', p, 'c', Green, 'q', q, 'cur', c, 'ch', 'x']);
  WriteLn(j);
  WriteLn(JsonParse(JsonEncode(j)) = j, ' ', j['tags'][2].AsInteger, ' ', j['p']['Y'].AsInteger);
  WriteLn(JsonArray([]), ' ', JsonObject([]));
  b := TJsonBuilder.Create;
  b.BeginObject;
  b.Name('list');
  b.BeginArray;
  for i := 1 to 3 do
    b.Add(i * 10);
  b.Add('x');
  b.AddNull;
  b.AddNumber('1e3');
  b.Add(2.5);
  b.Add(False);
  b.EndArray;
  b.Name('in');
  b.Add(j['p']);
  b.EndObject;
  k := b.Done;
  WriteLn(k);
  WriteLn(k['list'][5].AsNumber, ' ', k['list'][5].AsFloat:0:1, ' ', k['list'][5] = JsonParse('1000'),
    ' ', k['in']['X'].AsInteger, ' ', Length(k['list']));
  WriteLn(JsonParse(JsonEncode(k)) = k);
  b.Add(7);
  WriteLn(b.Done);
  nan := 0;
  nan := nan / nan;
  for i := 0 to 13 do
    Misuse(i);
end.

