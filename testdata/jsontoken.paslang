{ P211: a text again a token at a time, each token a reader reads
  written by a writer's Token as it was read (Go's Decoder.ReadToken
  into an Encoder's WriteToken), the reader reading in place where it
  can (NextFast) and the writer copying what it read: white space of
  every run of spaces to forty, across JsonSkipWs's steps of eight, with
  tabs, line feeds and carriage returns, and at the text's end; names
  plain and with escapes, an object past 64 names, objects and arrays a
  hundred deep; a name twice, plain, by an escape either way and past 64
  names, each refused; numbers and literals of every form; a writer
  that indents and one that writes HTML's escapes, which take the slow
  way; and the reader's errors. Each output, or the error. }
program jsontoken;

uses SysUtils;

const
  KindName: array[TJsonErrorKind] of string = ('syntax', 'encoding', 'duplicate', 'depth',
    'too large', 'missing', 'type', 'range', 'unknown', 'test', 'io');

var
  i, n, alike: Integer;
  s, want, names: string;
  opts: TJsonOptions;

{ S again by Token, with the writer's options O }
function Rebuild(const S: string; const O: TJsonOptions): string;
var
  r: TJsonReader;
  w: TJsonWriter;
begin
  r := JsonReader(S);
  w := JsonWriter;
  w.Options := O;
  try
    while r.Next <> jtkEnd do
      w.Token(r);
    Result := w.Text;
  except
    on x: EJsonError do
      Result := KindName[x.Kind] + ': ' + x.Message;
  end;
  { the line feed after the value, as Go's side trims it }
  if (Length(Result) > 0) and (Result[Length(Result)] = #10) then
    SetLength(Result, Length(Result) - 1);
end;

procedure Show(const Name, S: string);
begin
  WriteLn(Name, ': ', Rebuild(S, JsonDefaults));
end;

function Spaces(N: Integer): string;
var
  k: Integer;
begin
  Result := '';
  for k := 1 to N do
    Result := Result + ' ';
end;

begin
  { white space: runs of 0 to 40 spaces between every two tokens, a
    tab, a line feed and a carriage return among them, and at the end }
  want := '{"a":[1,true,"x",{}],"b":null}';
  alike := 0;
  for n := 0 to 40 do
  begin
    s := Spaces(n) + '{' + Spaces(n) + '"a"' + Spaces(n) + ':' + Spaces(n) + '[' + Spaces(n) + '1' +
      Spaces(n) + ',' + #10 + Spaces(n) + 'true' + #13#10 + Spaces(n) + ',' + #9 + Spaces(n) +
      '"x"' + Spaces(n) + ',' + Spaces(n) + '{' + Spaces(n) + '}' + Spaces(n) + ']' + #9#9 +
      Spaces(n) + ',' + Spaces(n) + '"b"' + #10#10 + ':' + Spaces(n) + 'null' + Spaces(n) + '}' +
      Spaces(n);
    if Rebuild(s, JsonDefaults) = want then
      alike := alike + 1
    else
      WriteLn('spaces ', n, ': ', Rebuild(s, JsonDefaults));
  end;
  WriteLn('spaces 0 to 40: ', alike, ' of 41 alike');
  Show('blanks', #9#10#13'  [ '#13#10'   1 ,'#9'2'#10#10#10'        ,        3        ]'#10'  ');

  { names }
  Show('names', '{"plain":1,"esc\u0041ped":2,"tab\t":"v\u00e9\n","nested":{"x":[{"y":null}]}}');
  names := '{';
  for i := 0 to 69 do
  begin
    if i > 0 then
      names := names + ',';
    names := names + '"n' + IntToStr(i) + '":' + IntToStr(i);
  end;
  s := names + '}';
  if Rebuild(s, JsonDefaults) = s then
    WriteLn('seventy names: alike')
  else
    WriteLn('seventy names: ', Rebuild(s, JsonDefaults));
  Show('twice', '{"a":1,"a":2}');
  Show('twice, the second escaped', '{"a":1,"\u0061":2}');
  Show('twice, the first escaped', '{"\u0062":1,"b":2}');
  Show('twice past 64', names + ',"n3":0}');
  Show('twice past 64, escaped', names + ',"\u006e5":0}');
  Show('the same name in two objects', '[{"k":1},{"k":2},{"k":{"k":3}}]');

  { a hundred deep }
  s := '';
  for i := 1 to 100 do
    s := s + '[';
  for i := 1 to 100 do
    s := s + ']';
  if Rebuild(s, JsonDefaults) = s then
    WriteLn('a hundred arrays: alike')
  else
    WriteLn('a hundred arrays: ', Rebuild(s, JsonDefaults));
  s := '';
  for i := 1 to 100 do
    s := s + '{"k' + IntToStr(i mod 3) + '":';
  s := s + '0';
  for i := 1 to 100 do
    s := s + '}';
  if Rebuild(s, JsonDefaults) = s then
    WriteLn('a hundred objects: alike')
  else
    WriteLn('a hundred objects: ', Rebuild(s, JsonDefaults));

  { numbers and literals, at the top level too }
  Show('numbers', '[0,-0,1.5,-1.5e-7,1E+10,12345678901234567890,0.000001,1e999]');
  Show('literals', '[true,false,null,"",{},[]]');
  Show('a number alone', '  -12.5e+3  ');
  Show('a string alone', '"\ud83d\ude00"');

  { writers that take the slow way }
  opts := JsonDefaults;
  opts.Indent := '  ';
  WriteLn('indented:');
  WriteLn(Rebuild('{"a":[1,{"b":"<&>"}],"c":{}}', opts));
  opts := JsonDefaults;
  opts.EscapeHtml := True;
  WriteLn('html: ', Rebuild('{"a":[1,{"b":"<&>"}],"c":{}}', opts));

  { the reader's errors (those of a literal, a number and a comma at the
    end are P395's) }
  Show('no colon', '{"a" 1}');
  Show('no comma', '[1 2]');
  Show('a control byte in a string', '["a'#1'b"]');
  Show('not closed', '{"a":[1');
end.
