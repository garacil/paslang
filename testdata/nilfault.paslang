{ P568: a nil pointer and the processor's other faults of memory as
  exceptions. With SysUtils in the program, a fault inside a try is raised
  in the routine that made it, as EAccessViolation (a nil pointer, an
  address where nothing is) or EBusError (memory whose file has ended),
  its Message the line the runtime writes without paslang: in front. Every
  shape is taken here (a nil pointer read and written, a field of a nil
  object, a virtual method of one and a method that reads Self, the second
  step of a chain of pointers, an address where nothing is read and
  written, a page of a file that was cut short, the last address that is
  a nil pointer's and the first that is not, a procedure variable, a
  function variable and a method variable that are nil, called, a
  procedure variable that points where nothing is, an address above
  every stack), by its class, by an
  ancestor, by a bare except, passed on by a handler of another class,
  raised again, with a finally on the way, and inside a handler that is
  taking another; a handler reads the variables a loop or a straight run
  kept in registers as they were at the fault, which nothing stored
  before it (the region's pad does, PadOut), a vector too, and what a
  statement with a call wrote at home before it faulted; what a region
  wrote after a call alone, which keeps its variables in registers across
  it, and the value such a call gave; a region inside an island of
  another, the fault before the island, in the region inside and after
  it; a fault with values waiting on the stack, an odd count and an even
  one; a call of nothing in a loop and with values waiting, and a
  variable called as code; a fault in a routine called
  is taken by the caller; a lock block is left unlocked; a routine started
  with pas takes its own, and four hundred of them a fault each at the
  bottom of their calls, from one call deep to four hundred, on the small
  stacks they start with, half of them a nil pointer and half a call of
  nothing: SysFault's own frame is then, at some depths,
  the one that makes the stack grow, with the frame of the fault on it,
  which has no map and is moved word by word; and the main block's loop
  as a routine's.

  With two arguments it dies of kind K instead, for the recipe to compare
  the runtime's own line with the Message printed here: die K with no try
  at all (the runtime stops the program as it always did), fin K inside a
  try with a finally and no handler (finally runs, then the line), pas K
  the same in a routine started with pas (the program ends with the line
  from that routine too). }
program nilfault;

uses
  sysutils;

type
  PNode = ^TNode;
  TNode = record
    V: Int64;
    Next: PNode;
  end;
  TShape = class
    Side: Int64;
    function Area: Int64; virtual;
    function Twice: Int64;
  end;
  TStep = procedure;
  TCalc = function(A: Int64): Int64;
  TPut = procedure(A: Int64) of object;

var
  none, wild, cut, edge, page, above: PNode;
  shape: TShape;
  step, jump, data: TStep;
  calc: TCalc;
  put: TPut;
  ticks, cell: Int64;
  mu: mutex;
  wg: waitgroup;
  got: string;
  dieK, mi, mt, dived: Int64;

function TShape.Area: Int64;
begin
  Result := Side * Side;
end;

{ P577: a method put in as its expression keeps the field's own line.
  A nil Self fails at the same operation with inlining and without;
  no recursive call is needed to keep the failure's source position. }
function TShape.Twice: Int64;
begin
  Result := Side * 2;
end;
{ This body stays eligible for expression inlining: the source-line
  regression must exercise the field directly inside its caller,
  rather than forcing this method to keep a frame. }

{ A page of a file mapped and the file then cut to nothing: the page is
  still the program's, and reading it is a bus error (mmap(2): SIGBUS for
  a page past the end of the file). The system calls by their numbers
  (asm/unistd_64.h, asm-generic/unistd.h): getpid, openat with O_CREAT,
  O_RDWR and O_TRUNC, ftruncate, mmap PROT_READ and MAP_SHARED, close,
  unlinkat. }
function CutPage: PNode;
var
  fd, r: Int64;
  name: string;
begin
  if Amd64 = 1 then
    r := Syscall(39)
  else
    r := Syscall(172);
  name := '/tmp/nilfault-' + IntToStr(r) + '.bin' + #0;
  if Amd64 = 1 then
  begin
    fd := Syscall(257, -100, @name[1], 578, 384);
    r := Syscall(77, fd, 4096);
    Result := PNode(Pointer(Syscall(9, 0, 4096, 1, 1, fd, 0)));
    r := Syscall(77, fd, 0);
    r := Syscall(3, fd);
    r := Syscall(263, -100, @name[1], 0);
  end
  else
  begin
    fd := Syscall(56, -100, @name[1], 578, 384);
    r := Syscall(46, fd, 4096);
    Result := PNode(Pointer(Syscall(222, 0, 4096, 1, 1, fd, 0)));
    r := Syscall(46, fd, 0);
    r := Syscall(57, fd);
    r := Syscall(35, -100, @name[1], 0);
  end;
end;

{ One fault of kind K. The pointers are set when the program runs, so
  nothing here is worked out by the compiler. }
procedure Fail(K: Int64);
var
  n: PNode;
begin
  case K of
    1: WriteLn(none^.V);
    2: none^.V := 5;
    3: WriteLn(shape.Side);
    4: WriteLn(shape.Area);
    5: WriteLn(shape.Twice);
    6:
      begin
        New(n);
        n^.V := 1;
        n^.Next := none;
        WriteLn(n^.Next^.V);
      end;
    7: WriteLn(wild^.V);
    8: wild^.Next := nil;
    9: WriteLn(cut^.V);
    10: WriteLn(edge^.V);
    11: WriteLn(page^.V);
    12: step();
    13: WriteLn(calc(4));
    14: put(3);
    15: jump();
    16: WriteLn(above^.V);
  end;
end;

{ every kind by its class: the lines the recipe compares }
procedure Caught;
var
  k: Int64;
begin
  for k := 1 to 16 do
    try
      Fail(k);
      WriteLn('not raised');
    except
      on e: EBusError do
        WriteLn('paslang: ', e.Message);
      on e: EAccessViolation do
        WriteLn('paslang: ', e.Message);
    end;
end;

procedure ByClass;
begin
  try
    Fail(1);
  except
    on e: EExternal do
      WriteLn('by an ancestor: ', e.ClassName);
  end;
  try
    Fail(7);
  except
    on e: Exception do
      WriteLn('by Exception: ', e.ClassName);
  end;
  try
    Fail(9);
  except
    on e: EAccessViolation do
      WriteLn('a bus error by its parent: ', e.ClassName);
  end;
  try
    Fail(2);
  except
    WriteLn('by a bare except');
  end;
  try
    try
      Fail(3);
    except
      on e: ERangeError do
        WriteLn('not this one');
    end;
  except
    on e: EAccessViolation do
      WriteLn('passed on by a handler of another class');
  end;
  try
    try
      Fail(4);
    except
      on e: EAccessViolation do
      begin
        WriteLn('taken, and raised again');
        raise;
      end;
    end;
  except
    on e: Exception do
      WriteLn('taken again: ', e.Message);
  end;
  try
    try
      Fail(6);
    finally
      WriteLn('finally on the way');
    end;
  except
    on e: EAccessViolation do
      WriteLn('after the finally');
  end;
  try
    Fail(1);
  except
    on e: Exception do
    begin
      try
        Fail(7);
      except
        on e2: Exception do
          WriteLn('inside a handler: ', e2.Message);
      end;
      WriteLn('and the first: ', e.Message);
    end;
  end;
end;

function Twice(I: Int64): Int64;
begin
  if I > 100 then
    WriteLn('never');
  Result := I * 2;
end;

function Sum3(A, B, C: Int64): Int64;
begin
  if A > 100 then
    WriteLn('never');
  Result := A + B + C;
end;

function Sum4(A, B, C, D: Int64): Int64;
begin
  if A > 100 then
    WriteLn('never');
  Result := A + B + C + D;
end;

{ what a loop or a straight run kept in registers, as the handler finds
  it: nothing stored the variables before the instruction that faulted }
procedure LoopVars;
var
  i, j, total, acc, a, b, c, d: Int64;
  n, first: PNode;
begin
  total := 0;
  i := 0;
  try
    for i := 1 to 10 do
    begin
      total := total + i;
      if i = 7 then
        total := total + none^.V;
    end;
  except
    on e: EAccessViolation do
      WriteLn('a for: i ', i, ' total ', total);
  end;
  { a chain of five whose last points nowhere }
  first := wild;
  for i := 5 downto 1 do
  begin
    New(n);
    n^.V := i * 10;
    n^.Next := first;
    first := n;
  end;
  total := 0;
  j := 0;
  n := first;
  try
    while n <> nil do
    begin
      total := total + n^.V;
      j := j + 1;
      n := n^.Next;
    end;
  except
    on e: EAccessViolation do
      WriteLn('a while: ', j, ' nodes, total ', total, ', ', e.Message);
  end;
  { a loop with a call in it, and a loop inside }
  acc := 0;
  total := 0;
  i := 0;
  j := 0;
  try
    for i := 1 to 5 do
    begin
      acc := acc + Twice(i);
      for j := 1 to 4 do
      begin
        total := total + j;
        if (i = 3) and (j = 2) then
          total := total + none^.V;
      end;
    end;
  except
    on e: EAccessViolation do
      WriteLn('a loop in a loop: i ', i, ' j ', j, ' acc ', acc, ' total ', total);
  end;
  { a store through nil in a loop }
  total := 0;
  i := 0;
  try
    for i := 1 to 6 do
    begin
      total := total * 3 + i;
      if total > 100 then
        none^.V := total;
    end;
  except
    on e: EAccessViolation do
      WriteLn('a store: i ', i, ' total ', total);
  end;
  { a statement with a call writes at home, and faults after it: what
    it wrote is what the handler finds, not what the loop's register
    still held }
  total := 0;
  acc := 0;
  i := 0;
  try
    for i := 1 to 5 do
    begin
      total := total + i;
      if i = 3 then
      begin
        total := Twice(total) + 100;
        acc := acc + none^.V;
      end;
    end;
  except
    on e: EAccessViolation do
      WriteLn('after a call wrote: i ', i, ' total ', total, ' acc ', acc);
  end;
  { values waiting on the stack when the fault comes: two, then three }
  total := 0;
  try
    total := 7;
    total := Sum3(Twice(1), Twice(2), none^.V);
  except
    on e: EAccessViolation do
      WriteLn('two values waiting: total ', total);
  end;
  try
    total := 8;
    total := Sum4(Twice(1), Twice(2), Twice(3), none^.V);
  except
    on e: EAccessViolation do
      WriteLn('three values waiting: total ', total);
  end;
  { a straight run }
  a := 0;
  b := 0;
  c := 0;
  d := 0;
  try
    a := Ord(none = nil) + 4;
    b := a * 3 + 1;
    c := b - a;
    c := c + none^.V;
    d := 99;
  except
    on e: EAccessViolation do
      WriteLn('a run: ', a, ' ', b, ' ', c, ' ', d);
  end;
end;

{ two routines that call themselves, which the compiler leaves as calls }
procedure Tick(I: Int64);
begin
  if I > 0 then
  begin
    ticks := ticks + 1;
    Tick(I - 1);
  end;
end;

function Steps(I: Int64): Int64;
begin
  if I <= 0 then
    Result := 0
  else
    Result := Steps(I - 1) + 2;
end;

{ a call alone in a region keeps the region's variables in their
  registers across it and gives its value straight to one (P400): the
  stretch of the fault's pad ends before it and another starts after
  it, and what the region wrote on both sides is what the handler finds }
procedure CallAlone;
var
  i, total, seen: Int64;
begin
  total := 0;
  seen := 0;
  i := 0;
  ticks := 0;
  try
    for i := 1 to 9 do
    begin
      total := total + i;
      Tick(i);
      seen := Steps(i);
      total := total + seen;
      if i = 6 then
        total := total + none^.V;
    end;
  except
    on e: EAccessViolation do
      WriteLn('after a call alone: i ', i, ' total ', total, ' seen ', seen, ' ticks ', ticks);
  end;
end;

{ a region inside an island of another: the while's own test calls, so
  the whole loop is an island of the outer region, and the for inside it
  a region of its own, with its own pad and its own stretches. The fault
  before the island is the outer region's, the one in the for inside the
  inner's, the one after the island the outer's again. }
procedure Inside(Where: Int64);
var
  i, j, k, total, inner: Int64;
begin
  total := 0;
  inner := 0;
  i := 0;
  j := 0;
  ticks := 0;
  try
    for i := 1 to 5 do
    begin
      total := total + i;
      if (Where = 1) and (i = 4) then
        total := total + none^.V;
      Tick(i);
      k := 0;
      while Steps(k) < 6 do
      begin
        k := k + 1;
        for j := 1 to 3 do
        begin
          inner := inner + j * k;
          if (Where = 2) and (i = 4) and (k = 2) and (j = 2) then
            inner := inner + none^.V;
        end;
      end;
      total := total + inner;
      if (Where = 3) and (i = 4) then
        total := total + none^.V;
    end;
  except
    on e: EAccessViolation do
      WriteLn('a region in an island, fault ', Where, ': i ', i, ' j ', j, ' total ', total, ' inner ', inner,
        ' ticks ', ticks);
  end;
end;

function HexOf(N: Int64): string;
const
  digits = '0123456789abcdef';
begin
  Result := '';
  while N <> 0 do
  begin
    Result := digits[(N and 15) + 1] + Result;
    N := N shr 4;
  end;
end;

{ a call of nothing: the variable is nil, or points where no code is.
  The fault is the reading of an instruction that is not there, and the
  runtime gives it to the call: its line, and the handler's variables as
  the call left them, which is at home, as before any call }
procedure Nothing;
var
  i, total: Int64;
  want: string;
begin
  total := 0;
  i := 0;
  try
    for i := 1 to 8 do
    begin
      total := total + i;
      if i = 6 then
        step();
    end;
  except
    on e: EAccessViolation do
      WriteLn('a call of nothing in a loop: i ', i, ' total ', total);
  end;
  try
    total := 7;
    total := Sum3(Twice(1), Twice(2), calc(3));
  except
    on e: EAccessViolation do
      WriteLn('and with two values waiting: total ', total);
  end;
  try
    total := 8;
    total := Sum4(Twice(1), Twice(2), Twice(3), calc(4));
  except
    on e: EAccessViolation do
      WriteLn('and with three: total ', total);
  end;
  { a variable is no code: the address in the Message is the variable's }
  try
    data();
  except
    on e: EAccessViolation do
    begin
      want := 'invalid memory address 0x' + HexOf(Int64(@cell)) + ' at line ';
      if Copy(e.Message, 1, Length(want)) = want then
        WriteLn('a variable called as code: its address, and the line of the call')
      else
        WriteLn('a variable called as code: ', e.Message);
    end;
  end;
  { the place is the call's, the last instruction of its line }
  try
    step();
    total := total + 1000;
  except
    on e: EAccessViolation do
      WriteLn('the line is the call''s: ', e.Message);
  end;
  { the routine goes on after each }
  try
    step();
  except
    on e: EAccessViolation do
      total := total + 1;
  end;
  try
    step();
  except
    on e: EAccessViolation do
      total := total + 1;
  end;
  WriteLn('and twice more: total ', total);
end;

{ a vector a loop keeps in a register }
procedure Vectors;
var
  sum, one, res: V128;
  i, n: Int64;
begin
  one := VSplat64(1);
  sum := VSplat64(0);
  n := 0;
  i := 0;
  try
    for i := 0 to 9 do
    begin
      sum := VAdd64(sum, one);
      if i = 6 then
        n := n + none^.V;
    end;
  except
    on e: EAccessViolation do
    begin
      { a vector with a view on it stays home: the lanes are read of a copy }
      res := sum;
      WriteLn('a vector: i ', i, ' lanes ', (res as array[0..1] of Int64)[0], ' ',
        (res as array[0..1] of Int64)[1]);
    end;
  end;
end;

function Deep(P: PNode; Level: Int64): Int64;
begin
  if Level = 0 then
    Result := P^.V
  else
    Result := Deep(P, Level - 1) + 1;
end;

procedure Callee;
var
  n: Int64;
begin
  n := 0;
  try
    n := 5;
    n := n + Deep(none, 3);
    n := 9;
  except
    on e: EAccessViolation do
      WriteLn('three calls down: n ', n, ', ', e.Message);
  end;
end;

procedure Locked;
begin
  try
    lock mu do
      none^.V := 1;
  except
    on e: EAccessViolation do
      WriteLn('under a lock: taken');
  end;
  lock mu do
    got := 'and the lock is free';
  WriteLn(got);
end;

procedure Worker;
begin
  try
    WriteLn(wild^.V);
  except
    on e: EAccessViolation do
      got := 'a routine takes its own: ' + e.ClassName;
  end;
  wg.Done;
end;

function Dive(P: PNode; Depth, How: Int64): Int64;
var
  pad: array[0..3] of Int64;
begin
  pad[Depth and 3] := Depth;
  if Depth > 0 then
    Result := Dive(P, Depth - 1, How) + pad[Depth and 3]
  else if How = 0 then
    Result := P^.V
  else
    Result := calc(How);
end;

procedure Diver(Depth: Int64);
var
  n: Int64;
begin
  n := 0;
  try
    n := Dive(none, Depth, Depth and 1);
  except
    on e: EAccessViolation do
      lock mu do
        dived := dived + 1;
  end;
  if n <> 0 then
    WriteLn('never');
  wg.Done;
end;

procedure DieWorker;
begin
  try
    Fail(dieK);
  finally
    WriteLn('finally');
  end;
  wg.Done;
end;

begin
  none := PNode(Pointer(Ord(ParamCount > 99)));
  wild := PNode(Pointer(123456789012 + Ord(ParamCount > 99)));
  cut := CutPage;
  edge := PNode(Pointer(4088 + Ord(ParamCount > 99)));
  page := PNode(Pointer(4096 + Ord(ParamCount > 99)));
  { the guard hole after what a program of amd64 may map (Linux 7.2,
    Documentation/arch/x86/x86_64/mm.rst: 00007ffffffff000, 4 kB), above
    every stack there; nothing is at it on arm64 either }
  above := PNode(Pointer(140737488351232 + Ord(ParamCount > 99)));
  jump := TStep(Pointer(123456789012 + Ord(ParamCount > 99)));
  data := TStep(Pointer(@cell));
  shape := TShape(Pointer(none));
  if ParamCount = 2 then
  begin
    dieK := StrToInt(ParamStr(2));
    if ParamStr(1) = 'die' then
      Fail(dieK)
    else if ParamStr(1) = 'fin' then
    begin
      try
        Fail(dieK);
      finally
        WriteLn('finally');
      end;
    end
    else
    begin
      wg.Add(1);
      pas DieWorker;
      wg.Wait;
    end;
    WriteLn('not reached');
    Halt(0);
  end;
  Caught;
  ByClass;
  LoopVars;
  CallAlone;
  Inside(1);
  Inside(2);
  Inside(3);
  Nothing;
  Vectors;
  Callee;
  Locked;
  wg.Add(1);
  pas Worker;
  wg.Wait;
  WriteLn(got);
  dived := 0;
  for mi := 1 to 400 do
  begin
    wg.Add(1);
    pas Diver(mi);
  end;
  wg.Wait;
  WriteLn('at every depth of a growing stack: ', dived);
  { the main block's own loop, its variables the program's }
  mt := 0;
  try
    for mi := 1 to 9 do
    begin
      mt := mt + mi * mi;
      if mi = 4 then
        mt := mt + none^.V;
    end;
  except
    on e: EAccessViolation do
      WriteLn('the main block: mi ', mi, ' mt ', mt);
  end;
  WriteLn('done');
end.

