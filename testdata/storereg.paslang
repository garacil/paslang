{ P386: a store whose place is registers and a constant alone keeps its
  value in a register while the place is named: a pointer's target, its
  element at an index in a register or a constant, through @ and a view
  of one pointer as another, of bytes, words, Int32 and Int64, a view
  wider and one narrower than the element, in loops that keep their
  variables in registers, in one that calls and in a routine with no
  frame. Every line is the same at -inline 0 and on the base processor. }
program storereg;

var
  bytes: array[0..63] of Byte;
  words: array[0..63] of Word;
  ints: array[0..63] of Int32;
  longs: array[0..63] of Int64;
  i: Integer;
  total: Int64;

{ no frame: an element of the pointer at an index in a register }
procedure Fill(P: PInt64; N: Integer);
var
  k: Integer;
begin
  for k := 0 to N - 1 do
    P[k] := k * 3 + 1;
end;

{ narrow elements and their views }
function Narrow(B: PByte; W: PWord; D: PInt32; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
begin
  s := 0;
  for k := 0 to N - 1 do
  begin
    B[k] := Byte(k * 5);
    W[k] := Word(k * 300);
    D[k] := Int32(k * 70000 - 1000000);
    s := s + B[k] + W[k] + D[k];
  end;
  Result := s;
end;

{ a view wider than the element (four bytes at a byte's index) and one
  narrower (a word at an Int32's index) }
function Views(B: PByte; D: PInt32; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
begin
  s := 0;
  k := 0;
  while k + 4 <= N do
  begin
    PInt32(@B[k])^ := Int32(k * 16843009);
    PWord(@D[k])^ := Word(k + 7);
    s := s + PInt32(@B[k])^ + PWord(@D[k])^;
    k := k + 4;
  end;
  Result := s;
end;

{ a pointer's target, the pointer kept in a register, and a constant
  index }
function Target(P: PInt64; N: Integer): Int64;
var
  k: Integer;
  q: PInt64;
  s: Int64;
begin
  s := 0;
  q := P;
  for k := 0 to N - 1 do
  begin
    q^ := q^ + k;
    P[0] := P[0] + 1;
    PInt64(@P[1])^ := k;
    s := s + q^ + P[1];
  end;
  Result := s;
end;

procedure Note(X: Int64);
begin
  total := total + (X and 255);
end;

{ a loop that calls: its stores still name their places at once }
function Calls(P: PInt64; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
begin
  s := 0;
  for k := 0 to N - 1 do
  begin
    P[k] := s + k;
    Note(P[k]);
    PInt64(@P[k])^ := P[k] * 2;
    s := s + P[k];
  end;
  Result := s;
end;

begin
  Fill(@longs[0], 64);
  WriteLn('fill ', longs[0], ' ', longs[1], ' ', longs[63]);
  WriteLn('narrow ', Narrow(@bytes[0], @words[0], @ints[0], 64), ' ', bytes[63], ' ', words[63], ' ', ints[63]);
  WriteLn('views ', Views(@bytes[0], @ints[0], 64), ' ', bytes[4], ' ', ints[60]);
  WriteLn('target ', Target(@longs[0], 50), ' ', longs[0], ' ', longs[1]);
  total := 0;
  WriteLn('calls ', Calls(@longs[0], 64), ' ', total, ' ', longs[63]);
  for i := 0 to 63 do
    longs[i] := 0;
  Fill(@longs[0], 10);
  WriteLn('again ', longs[9], ' ', longs[10]);
end.

