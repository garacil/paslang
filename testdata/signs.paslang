program signs;

function Sg(x: Double; k: Integer): Double;
var
  b, s: Int64;
begin
  b := x as Int64;
  s := 0;
  if k = 1 then s := 1;
  if k = 2 then s := 0;
  if k = 3 then s := 1;
  if k = 5 then s := 1;
  if k = 7 then s := 1;
  if k = 11 then s := 1;
  if k = 13 then s := 1;
  if k = 17 then s := 1;
  if k = 19 then s := 1;
  if k = 23 then s := 1;
  if k = 29 then s := 1;
  if k = 31 then s := 1;
  if k = 0 then s := 1;
  Result := ((b and $7FFFFFFFFFFFFFFF) or (s shl 63)) as Double;
end;

function Se(x: Double; k: Integer): Double;
var
  b: Int64;
begin
  b := x as Int64;
  if k = 0 then
  begin
    Result := x + x;
    Exit;
  end;
  Result := (b xor $8000000000000000) as Double;
end;

function Dv(x, y: Double): Double;
begin
  Result := 1.0 / (x * x + 1.0) + y / (2.0 + x * x) - 3.5 / (y * y + 0.25);
end;

function Ab(x, y: Double): Double;
begin
  Result := Abs(x) * y - Abs(x - y);
end;

function Ng(x, y: Double): Double;
begin
  Result := -(x * y) + -x * y;
end;

function Hr(x: Double): Double;
begin
  Result := 0.1 + x * ((-0.7) + x * (1.3 + x * (2.9 + x * ((-0.45) + x * (0.06 + x * ((-1.7) + x * (3.3 + x * (0.27 + x * ((-0.81) + x * (1.1 + x * ((-2.2) + x * 0.05)))))))))));
end;

function Hl(x: Double): Double;
begin
  Result := (((((((((((0.05 * x + (-2.2)) * x + 1.1) * x + (-0.81)) * x + 0.27) * x + 3.3) * x + (-1.7)) * x + 0.06) * x + (-0.45)) * x + 2.9) * x + 1.3) * x + (-0.7)) * x + 0.1;
end;

function Hs(x, y: Double): Double;
begin
  Result := 0.1 - x * ((-0.7) + y * (1.3 - x * (2.9 + y * ((-0.45) - x * (0.06 + y * ((-1.7) - x * 3.3))))));
end;

function Hx(x, y: Double): Double;
begin
  Result := 2.5 * x * (y + 1.5) * (3.0 - y);
end;

function Lp(x, y: Double): Double;
var
  i: Integer;
  s: Double;
begin
  s := 0.0;
  for i := 1 to 6 do
  begin
    s := s + Abs(x - i) * -y;
    y := y * 0.5;
  end;
  Result := s;
end;

function Cm(x, y: Double): Double;
begin
  if Abs(x) > Abs(y) then
    Result := -x
  else
    Result := -y;
end;

procedure P(r: Double);
var
  b: Int64;
begin
  if r <> r then
    WriteLn('nan')
  else
  begin
    b := r as Int64;
    WriteLn(b);
  end;
end;

