{ P98: a routine that holds a runtime lock is not preempted.

  The holder takes a spin lock, starts sixty-four routines that want
  the same lock (more than there are Ms) and works for a while with
  calls in its loop, each a point where sysmon's request to yield is
  served. A waiter that has spun long enough sleeps in the kernel with
  its M. When the holder could be preempted, it went to the global
  queue, its own M ran a waiter from its local queue, and every M was
  asleep on its lock: nobody was left to run the holder. Go does not
  preempt a routine that holds a runtime lock (m.locks), and neither
  does paslang since 1.0.51. The test fails by its timeout. }
program lockpreempt;

var
  x: Integer;
  wg: waitgroup;
  s: Integer;

function Step(V: Integer): Integer;
begin
  Result := (V * 7 + 3) mod 1000003;
end;

procedure Waiter;
begin
  SpinLock(@x);
  SpinUnlock(@x);
  wg.Done;
end;

procedure Holder;
var
  k, v, j: Integer;
begin
  SpinLock(@x);
  { The waiters start from here, so they sit in this routine's own
    queue: its M runs one of them the moment the holder yields. }
  for j := 1 to 64 do
    pas Waiter;
  v := 1;
  for k := 1 to 20000000 do
    v := Step(v);
  s := v;
  SpinUnlock(@x);
  wg.Done;
end;

begin
  wg.Add(65);
  pas Holder;
  wg.Wait;
  WriteLn(s > 0);
end.

