{ The ifdef words of the processor compiled for (P148): CPU_<NAME> for
  each feature -cpu has. make check compiles it with -cpu base and v3
  on amd64 and base and max on arm64; each prints its own line. }
program cpudefs;
begin
{$ifdef CPU_SSE2}
  Write(' sse2');
{$endif}
{$ifdef CPU_SSE41}
  Write(' sse41');
{$endif}
{$ifdef CPU_SSE42}
  Write(' sse42');
{$endif}
{$ifdef CPU_POPCNT}
  Write(' popcnt');
{$endif}
{$ifdef CPU_AVX2}
  Write(' avx2');
{$endif}
{$ifdef CPU_BMI1}
  Write(' bmi1');
{$endif}
{$ifdef CPU_BMI2}
  Write(' bmi2');
{$endif}
{$ifdef CPU_SHA}
  Write(' sha');
{$endif}
{$ifdef CPU_SHA2}
  Write(' sha2');
{$endif}
{$ifdef CPU_FP}
  Write(' fp');
{$endif}
{$ifdef CPU_ASIMD}
  Write(' asimd');
{$endif}
{$ifdef CPU_CRC32}
  Write(' crc32');
{$endif}
{$ifdef CPU_ATOMICS}
  Write(' atomics');
{$endif}
{$ifdef CPU_AES}
  Write(' aes');
{$endif}
{$ifdef CPU_PMULL}
  Write(' pmull');
{$endif}
{$ifdef CPU_SHA512}
  Write(' sha512');
{$endif}
  WriteLn;
end.

