{ P484: Hex writes a byte's two digits as a pair taken from a table of 256.
  The expected output was made by the compiler before, which looked each
  digit up separately: the empty string, every byte alone, all 256 together,
  the lengths 0 to 300 of bytes from a generator, and two thousand
  strings of up to five thousand bytes, each text folded into a hash. }
program hexfast;

var
  h, seed: Int64;

function Next: Int64;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := seed;
end;

procedure Mix(const S: string);
var
  i: Integer;
begin
  h := h * 1000003 + Length(S);
  for i := 1 to Length(S) do
    h := (h * 31 + Ord(S[i])) xor (h shr 33);
end;

var
  i, j, n: Integer;
  s: string;
begin
  WriteLn('[', Hex(''), ']');
  s := '';
  for i := 0 to 255 do
  begin
    s := s + Chr(i);
    Mix(Hex(Chr(i)));
  end;
  WriteLn(Hex(s));
  seed := 20261028;
  h := 3;
  for n := 0 to 300 do
  begin
    s := '';
    SetLength(s, n);
    for j := 1 to n do
      s[j] := Chr((Next shr 40) and 255);
    Mix(Hex(s));
  end;
  for i := 1 to 2000 do
  begin
    n := Integer((Next shr 40) mod 5000);
    SetLength(s, n);
    for j := 1 to n do
      s[j] := Chr((Next shr 40) and 255);
    Mix(Hex(s));
  end;
  WriteLn('hash ', h);
end.
