{ P307: an if whose arms only assign a word is a compare and a
  conditional select, CMOVcc on amd64 and CSEL, CSINC or CINC on arm64,
  as Go's branchelim makes it: the arm of an if without an else at most
  two adds, subs, ands, ors or xors of leaves, each arm of one with an
  else at most one, or the arm the compare's side worked out once (a
  load too); the variable of 64 bits, in a register or a local nothing
  else reaches, and no load's address (Go's loadAddr). Every form on
  random data, in loops whose variables are in registers and in
  routines whose are in the frame, Inc and Dec, compares with constants
  either way and of every size, with nil and between variables; and
  beside them the forms left to a branch: a load in the arm, a
  division, a call, a byte, two statements, a variable another thread
  or routine can reach (a global, one whose address is taken, one a
  nested routine reads), a pointer or an index a load then uses. The
  mark of select or branch in braces after an if is what
  scripts/check_select.py wants of its code. }
program selectif;

type
  PNode = ^TNode;
  TNode = record
    v: Integer;
    next: PNode;
  end;

var
  seed: Integer;
  a: array[0..255] of Integer;
  bytes: array[0..255] of Byte;

function Rnd: Integer;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := (seed shr 33) and 1023;
end;

{ in a loop: the variables in registers }
function CountEq(n, k: Integer): Integer;
var
  i, c, x: Integer;
begin
  c := 0;
  for i := 0 to n - 1 do
  begin
    x := a[i and 255];
    if x = k then { select }
      c := c + 1;
    if x < 100 then { select }
      c := c + 1000;
    if 500 <= x then { select }
      Dec(c, 3);
    if x <> -1 then { select }
      Inc(c);
    if 1 + x > 1000 then { select }
      c := 1 + c;
  end;
  Result := c;
end;

{ if and else, each arm one leaf or the then arm an add }
function MinMax(n: Integer): Integer;
var
  i, lo, hi, x, s, z, o, w, u: Integer;
begin
  lo := 1000000;
  hi := -1000000;
  s := 0;
  z := 0;
  o := 0;
  w := 0;
  u := 0;
  for i := 0 to n - 1 do
  begin
    x := a[i and 255] - 512;
    if x < lo then { select }
      lo := x;
    if x > hi then { select }
      hi := x
    else
      hi := hi;
    if x >= 0 then { select }
      s := s + x
    else
      s := -7;
    if x > 100 then { select }
      z := 0
    else
      z := z + 5;
    if x < 0 then { select }
      o := x + 1
    else
      o := 0;
    if x > 5000000000 then { select }
      s := 1;
    if -5000000000 > x then { select }
      s := 2;
    if x < 400 then { select }
      s := s xor 255
    else
      s := s and 4095;
    if x > 300 then { select }
      w := 0
    else
      w := w + 1;
    if x > 200 then { select }
      u := u + x - 3;
    if x < -300 then { select }
      u := u or x
    else
      u := 1 + w;
  end;
  Result := lo * 1000000 + hi * 1000 + s + z * 7 + o * 3 + w * 11 + u * 13;
end;

{ a pointer chosen, and nil compares: each is a load's address after,
  so a branch, as Go's loadAddr keeps it (issue 26306) }
function Pick(n: Integer): Integer;
var
  i, t: Integer;
  p, q, best: PNode;
begin
  best := nil;
  q := nil;
  t := 0;
  for i := 1 to n do
  begin
    New(p);
    p^.v := Rnd;
    p^.next := q;
    q := p;
  end;
  p := q;
  while p <> nil do
  begin
    if best = nil then { branch }
      best := p;
    if p^.v > 900 then { branch }
      best := p;
    if nil = q then { branch }
      best := nil;
    t := t + best^.v;
    p := p^.next;
  end;
  Result := t;
end;

{ the arm's value is the compare's side: worked out once, a load too;
  a list's walk, whose pointer is the next load's address, a branch }
function Shared(n: Integer): Integer;
var
  i, m, w, z, d, last: Integer;
  p, q: PNode;
begin
  m := -1;
  w := 1 shl 40;
  z := 0;
  d := 0;
  for i := 0 to n - 1 do
  begin
    if a[i and 255] > m then { select }
      m := a[i and 255];
    if w > a[(i * 7) and 255] then { select }
      w := a[(i * 7) and 255];
    if bytes[i and 255] > z then { select }
      z := bytes[i and 255];
    if a[i and 255] > 500 then { select }
      d := a[i and 255]
    else
      d := 0;
    if 100000 div ((a[i and 255] and 1023) + 1) > z then
      z := 100000 div ((a[i and 255] and 1023) + 1);
  end;
  q := nil;
  for i := 1 to 50 do
  begin
    New(p);
    p^.v := i;
    p^.next := q;
    q := p;
  end;
  p := q;
  last := 0;
  for i := 1 to 70 do
  begin
    if p^.next <> nil then { branch }
      p := p^.next;
    last := last + p^.v;
  end;
  Result := m * 1000000 + w * 1000 + z + d + last;
end;

{ an index chosen is a load's address, so is one an assignment makes
  from it; one that only addresses a store is a select }
function Addr(n: Integer): Integer;
var
  i, j, k, h, u, t, x: Integer;
  st: array[0..255] of Integer;
begin
  t := 0;
  j := 0;
  k := 0;
  h := 0;
  u := 0;
  for i := 0 to 255 do
    st[i] := 0;
  for i := 0 to n - 1 do
  begin
    x := a[i and 255];
    if x > 500 then { branch }
      j := i
    else
      j := 0;
    t := t + a[j and 255];
    if x > 300 then { branch }
      k := x;
    h := k + 1;
    t := t + a[h and 255];
    if x < 600 then { select }
      u := i;
    st[u and 255] := x;
  end;
  Result := t + st[7];
end;

{ no loop: the variables in the frame }
function Clamp(x, lo, hi: Integer): Integer;
var
  y: Integer;
begin
  y := x;
  if y < lo then { select }
    y := lo;
  if y > hi then { select }
    y := hi;
  if y = 7 then { select }
    Inc(y)
  else
    y := y;
  if 0 > y then { select }
    y := 0
  else
    y := y + 1;
  Result := y;
end;

{ the forms left to a branch: a load in the arm, a division, a call, a
  byte, two statements; and a global }
var
  g: Integer;
  gp: PNode;

function Keep(x: Integer): Integer;
begin
  Result := x * 2 + 1;
end;

function Others(n: Integer): Integer;
var
  i, c, d: Integer;
  b: Byte;
begin
  c := 0;
  d := 1;
  b := 0;
  for i := 0 to n - 1 do
  begin
    if a[i and 255] > 300 then { branch }
      c := c + a[(i + 1) and 255];
    if a[i and 255] > 10 then { branch }
      d := 1000000 div a[i and 255];
    if c > d then { branch }
      c := Keep(c) and 65535;
    if a[i and 255] < 200 then { branch }
      b := bytes[i and 255];
    if c < 0 then { branch }
    begin
      c := 0;
      d := 1;
    end;
    if i > g then { branch }
      g := i;
  end;
  Result := c + d + b + g;
end;

{ a global pointer, a local whose address is taken, one a nested routine
  reads: none of them a select }
function Reached(x: Integer): Integer;
var
  v, w: Integer;
  pv: ^Integer;

  function Twice: Integer;
  begin
    Result := w * 2;
  end;

begin
  v := 0;
  w := 3;
  pv := @v;
  if x > 500 then { branch }
    v := x;
  if x < 200 then { branch }
    w := x;
  if x > 900 then { branch }
    gp := nil;
  Result := pv^ + Twice;
end;

var
  i, t: Integer;
  nd: TNode;
begin
  seed := 12345;
  for i := 0 to 255 do
  begin
    a[i] := Rnd;
    bytes[i] := Byte(Rnd and 255);
  end;
  a[17] := 777;
  a[18] := -1;
  g := -5;
  t := 0;
  WriteLn(CountEq(0, 777), ' ', CountEq(1000, 777), ' ', CountEq(100000, a[3]));
  WriteLn(MinMax(1), ' ', MinMax(100000));
  WriteLn(Pick(1), ' ', Pick(5000));
  WriteLn(Shared(1), ' ', Shared(100000));
  WriteLn(Addr(1), ' ', Addr(100000));
  for i := -3 to 12 do
    t := t * 3 + Clamp(i, 0, 9);
  WriteLn(t, ' ', Clamp(Low(Integer), -5, 5), ' ', Clamp(High(Integer), -5, 5));
  WriteLn(Others(1), ' ', Others(100000));
  nd.v := 1;
  gp := @nd;
  t := 0;
  for i := 0 to 1023 do
    t := t + Reached(a[i and 255]);
  if gp = nil then
    WriteLn(t, ' nil')
  else
    WriteLn(t, ' kept');
end.
