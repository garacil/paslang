{ counts past the in-line ones: the registers with no push }
procedure Large;
var
  i, t: Integer;
begin
  FillChar(huge, 512, 7);
  FillChar(huge[3], 512, vb);
  Move(huge[1], huge[5], 512);
  t := 0;
  for i := 0 to 300099 do
    t := t * 3 + huge[i];
  h := h * 43 + t;
  FillChar(huge, 1408, 7);
  FillChar(huge[3], 1408, vb);
  Move(huge[1], huge[5], 1408);
  t := 0;
  for i := 0 to 300099 do
    t := t * 3 + huge[i];
  h := h * 43 + t;
  FillChar(huge, 1409, 7);
  FillChar(huge[3], 1409, vb);
  Move(huge[1], huge[5], 1409);
  t := 0;
  for i := 0 to 300099 do
    t := t * 3 + huge[i];
  h := h * 43 + t;
  FillChar(huge, 4096, 7);
  FillChar(huge[3], 4096, vb);
  Move(huge[1], huge[5], 4096);
  t := 0;
  for i := 0 to 300099 do
    t := t * 3 + huge[i];
  h := h * 43 + t;
  FillChar(huge, 300000, 7);
  FillChar(huge[3], 300000, vb);
  Move(huge[1], huge[5], 300000);
  t := 0;
  for i := 0 to 300099 do
    t := t * 3 + huge[i];
  h := h * 43 + t;
end;

{ whole variables: a Double's bits, records with a pointer in them }
procedure Whole;
var
  d: Double;
  q: Int64;
  r1, r2: TRec;
  x: Integer;
begin
  d := 1.5;
  Move(d, q, 8);
  WriteLn(q);
  q := 4614253070214989087;
  Move(q, d, 8);
  WriteLn(d:0:6);
  x := 77;
  FillChar(r1, SizeOf(r1), 0);
  r1.a := 5;
  r1.p := @x;
  r1.b[39] := 9;
  Move(r1, r2, SizeOf(TRec));
  WriteLn(r2.a, ' ', r2.p^, ' ', r2.b[39], ' ', r2.b[0]);
  FillChar(r2.b, SizeOf(r2.b), 3);
  WriteLn(r2.b[0] + r2.b[39], ' ', r2.a);
end;

