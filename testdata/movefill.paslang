{ P304: Move and FillChar with a constant count up to 128 bytes are
  loads and stores in line, a variable's own place, a constant index of
  a static array or a record's field their operand, and past it their
  arguments go to their registers with no push. Every constant count
  from 0 to 300 and some larger ones (1408 and 1409 Go's REP threshold,
  300000 past 256 KiB through rt_fillbig), into a global and into the
  frame, through an index and whole variables, a constant byte (0, 255
  and others) and a variable one, Move between two arrays and within
  one overlapping either way; a hash of every byte around shows that
  nothing past the count changed. Written by a script; the output is
  1.1.154's, which called rt_memcpy and rt_fill. }
program movefill;

type
  TBlk = array[0..399] of Byte;
  TRec = record
    a: Integer;
    p: ^Integer;
    b: array[0..39] of Byte;
  end;

var
  buf: array[0..699] of Byte;
  blk, blk2: array[0..399] of Byte;
  huge: array[0..300099] of Byte;
  h: Integer;
  vb: Byte;
  vi: Integer;

procedure R;
var
  i: Integer;
begin
  for i := 0 to 699 do
    buf[i] := Byte((i * 7 + 3) mod 251);
  for i := 0 to 399 do
  begin
    blk[i] := Byte((i * 11 + 5) mod 241);
    blk2[i] := Byte((i * 13 + 1) mod 239);
  end;
end;

procedure S;
var
  i: Integer;
begin
  for i := 0 to 699 do
    h := h * 31 + buf[i];
  for i := 0 to 399 do
    h := h * 37 + blk[i] + blk2[i] * 3;
end;

procedure L(const loc: TBlk);
var
  i, t: Integer;
begin
  t := 0;
  for i := 0 to 399 do
    t := t * 7 + loc[i];
  h := h * 41 + t;
end;

procedure C0;
var
  loc: TBlk;
  i: Integer;
begin
  R; FillChar(buf[3], 0, 171); S; R; FillChar(blk, 0, 0); S;
  R; FillChar(blk2, 0, 255); S; R; FillChar(buf[1], 0, vb); S;
  R; FillChar(blk, 0, vi); S; R; FillChar(buf[7], 0, 'a'); S;
  R; Move(buf[300], buf[5], 0); S; R; Move(blk, blk2, 0); S;
  R; Move(buf[10], buf[13], 0); S; R; Move(buf[13], buf[10], 0); S;
  R; Move(blk2, buf[2], 0); S;
  for i := 0 to 399 do
    loc[i] := Byte(i xor 90);
  FillChar(loc, 0, 66); Move(loc, blk, 0); L(loc); S;
end;

