var
  loc: TBlk;
  i: Integer;
begin
  R; FillChar(buf[3], 1, 171); S; R; FillChar(blk, 1, 0); S;
  R; FillChar(blk2, 1, 255); S; R; FillChar(buf[1], 1, vb); S;
  R; FillChar(blk, 1, vi); S; R; FillChar(buf[7], 1, 'a'); S;
  R; Move(buf[300], buf[5], 1); S; R; Move(blk, blk2, 1); S;
  R; Move(buf[10], buf[13], 1); S; R; Move(buf[13], buf[10], 1); S;
  R; Move(blk2, buf[2], 1); S;
  for i := 0 to 399 do
    loc[i] := Byte(i xor 90);
  FillChar(loc, 1, 66); Move(loc, blk, 1); L(loc); S;
