{ P358: a routine with nested ones zeroes only the locals a read may
  reach first. A local written on every path before any call starts as
  it is; one a nested routine may read first, through a call, still
  starts as zero, Result alike. The answers are worked out by hand in
  the comments; scripts/check_nestzero.py counts the stores of zero in
  each routine's prologue. }
program nestzero;

function Early: Integer;
var
  a, b: Integer;
  small: Int32;

  function Peek: Integer;
  begin
    Result := a * 100 + b * 10 + small;
  end;

begin
  { b and small written before any call, a read by Peek first, so it
    starts as 0: 0 * 100 + 7 * 10 + 2 = 72, then 3 * 100 + 70 + 2 = 372;
    72 * 1000 + 372 = 72372 }
  b := 7;
  small := 2;
  Result := Peek;
  a := 3;
  Result := Result * 1000 + Peek;
end;

function Late(K: Integer): Integer;
var
  x, y: Integer;

  function Twice: Integer;
  begin
    Result := x * 2 + y;
  end;

begin
  { every local and Result written before the call: 100 + 5 * 2 + 6 =
    116 }
  x := K;
  y := K + 1;
  Result := 100;
  Result := Result + Twice;
end;

function Branch(K: Integer): Integer;
var
  v: Integer;

  function Get: Integer;
  begin
    Result := v;
  end;

begin
  { v written on one path only: 4, and 0 for an odd K }
  if K mod 2 = 0 then
    v := K;
  Result := Get;
end;

procedure WriteBack;
var
  z: Integer;

  procedure SetZ;
  begin
    z := 41;
  end;

begin
  { z written by the nested routine first: 42 }
  SetZ;
  WriteLn(z + 1);
end;

begin
  WriteLn(Early);
  WriteLn(Late(5));
  WriteLn(Branch(4), ' ', Branch(3));
  WriteBack;
end.
