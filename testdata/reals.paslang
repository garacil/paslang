program reals;

var
  r: Real;
  d: Double;
  s: Single;

begin
  r := 1.5 + 2.5;
  WriteLn(r);
  r := 10 / 4;
  WriteLn(r);
  WriteLn(10 div 4);
  r := -1.5;
  WriteLn(r);
  r := 0.5;
  r := -r;
  WriteLn(r);
  d := 0.5 * 2.0;
  WriteLn(d);
  s := 2.25;
  WriteLn(s);
  r := 4;
  WriteLn(r);
  r := 2e1;
  WriteLn(r);
  r := 1.;
  WriteLn(r);
  r := -1.5;
  WriteLn(Abs(r));
  WriteLn(Trunc(r));
  WriteLn(Round(0.5));
  WriteLn(Round(1.5));
  WriteLn(Round(2.5));
  WriteLn(Sqr(1.5));
  WriteLn(Abs(-3));
  WriteLn(Sqr(4));
  r := Real(3);
  WriteLn(r);
  if 1.5 < 2 then
    WriteLn('lt');
  if 10 / 4 = 2.5 then
    WriteLn('eq');
end.

