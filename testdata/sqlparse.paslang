{ P404: SQL read as SQLite's parser reads it. Each statement of the file
  named first (the statements one to a record, records apart on a line
  "----") is parsed and printed as SQLite's debug build traces it
  (.treetrace 0x10000: treeview.c's trees at the start of sqlite3Select,
  sqlite3Insert, sqlite3Update and sqlite3DeleteFrom), then "ok", or
  "error: " and SQLite's words. scripts/sqlparse_oracle.py makes the
  expected output with SQLite's own debug build. }
program sqlparse;

uses
  paslib, sqlite;

var
  data, rec, line: string;
  i, j, n: Integer;

procedure Run(const Sql: string);
begin
  Write(SqliteParseTrace(Sql));
end;

begin
  if not ReadFile(ParamStr(1), data) then
  begin
    WriteLn('cannot read ', ParamStr(1));
    Halt(1);
  end;
  rec := '';
  n := 0;
  i := 1;
  while i <= Length(data) do
  begin
    j := i;
    while (j <= Length(data)) and (data[j] <> #10) do
      Inc(j);
    line := Copy(data, i, j - i);
    i := j + 1;
    if line = '----' then
    begin
      Inc(n);
      WriteLn('#', n);
      Run(rec);
      rec := '';
    end
    else if rec = '' then
      rec := line
    else
      rec := rec + #10 + line;
  end;
end.
