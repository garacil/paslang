program pbkdf2oracle;

function Bytes(N, Seed: Integer): string;
var I: Integer;
begin
  SetLength(Result, N);
  for I := 1 to N do Result[I] := Char((I * 131 + Seed) and 255);
end;

begin
  WriteLn(1, ' ', Hex(Pbkdf2HmacSha1(Bytes(0, 128), Bytes(0, 255), 1, 1)));
  WriteLn(2, ' ', Hex(Pbkdf2HmacSha1(Bytes(0, 128), Bytes(0, 255), 2, 65)));
  WriteLn(3, ' ', Hex(Pbkdf2HmacSha1(Bytes(64, 128), Bytes(0, 255), 3, 41)));
  WriteLn(4, ' ', Hex(Pbkdf2HmacSha1(Bytes(65, 128), Bytes(52, 255), 2, 65)));
  WriteLn(5, ' ', Hex(Pbkdf2HmacSha1(Bytes(129, 128), Bytes(60, 255), 3, 65)));
  WriteLn(6, ' ', Hex(Pbkdf2HmacSha1(Bytes(63, 128), Bytes(64, 255), 7, 41)));
  WriteLn(7, ' ', Hex(Pbkdf2HmacSha1(Bytes(64, 128), Bytes(65, 255), 2, 33)));
  WriteLn(8, ' ', Hex(Pbkdf2HmacSha1(Bytes(65, 128), Bytes(128, 255), 2, 41)));
  WriteLn(9, ' ', Hex(Pbkdf2HmacSha1(Bytes(129, 128), Bytes(129, 255), 2, 5137)));
  WriteLn(10, ' ', Hex(Pbkdf2HmacSha256(Bytes(0, 128), Bytes(0, 255), 1, 1)));
  WriteLn(11, ' ', Hex(Pbkdf2HmacSha256(Bytes(0, 128), Bytes(0, 255), 2, 65)));
  WriteLn(12, ' ', Hex(Pbkdf2HmacSha256(Bytes(64, 128), Bytes(0, 255), 3, 41)));
  WriteLn(13, ' ', Hex(Pbkdf2HmacSha256(Bytes(65, 128), Bytes(52, 255), 2, 65)));
  WriteLn(14, ' ', Hex(Pbkdf2HmacSha256(Bytes(129, 128), Bytes(60, 255), 3, 65)));
  WriteLn(15, ' ', Hex(Pbkdf2HmacSha256(Bytes(63, 128), Bytes(64, 255), 7, 41)));
  WriteLn(16, ' ', Hex(Pbkdf2HmacSha256(Bytes(64, 128), Bytes(65, 255), 2, 33)));
  WriteLn(17, ' ', Hex(Pbkdf2HmacSha256(Bytes(65, 128), Bytes(128, 255), 2, 41)));
  WriteLn(18, ' ', Hex(Pbkdf2HmacSha256(Bytes(129, 128), Bytes(129, 255), 2, 8193)));
  WriteLn(19, ' ', Hex(Pbkdf2HmacSha1(Bytes(65537, 128), Bytes(65537, 255), 2, 65)));
  WriteLn(20, ' ', Hex(Pbkdf2HmacSha256(Bytes(65537, 128), Bytes(65537, 255), 2, 65)));
end.

