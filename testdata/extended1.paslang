{ Extended is Double (P145), as Free Pascal has it on arm64: variables,
  parameters, results, arrays and mixed arithmetic. The output is Free
  Pascal's on amd64, where Extended has 64 bits of mantissa: every value
  is printed with few enough decimals to be the same. }
program extended1;

type
  TVec = array[0..2] of Extended;

function Mean(const V: TVec): Extended;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 2 do
    Result := Result + V[i];
  Result := Result / 3;
end;

procedure Scale(var X: Extended; F: Double);
begin
  X := X * F;
end;

var
  e: Extended;
  d: Double;
  s: Single;
  v: TVec;
begin
  e := 1.5;
  d := e * 2;
  s := 0.25;
  e := e + d + s;
  WriteLn(e:0:4, ' ', d:0:2);
  Scale(e, 2);
  WriteLn(e:0:4, ' ', Trunc(e), ' ', Round(e * 10));
  v[0] := 1;
  v[1] := 2.5;
  v[2] := e;
  WriteLn(Mean(v):0:6, ' ', Sqrt(v[1] * 10):0:6, ' ', Frac(e):0:3);
end.

