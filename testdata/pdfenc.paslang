{ P494: the files of testdata/pdfenc, which qpdf encrypted from two of the
  files of testdata/pdfreal (RC4 of 40 and 128 bits, AES-128, AES-256 of R5 and
  R6, with the metadata clear, with object streams), are read with the empty
  password and must give the text and the document information of the
  original; the two that need a password are refused and say so. Then every
  file is bent 12 times (the first argument changes the number, the second
  the seed) and read again: the reader returns or raises
  EPdfError and nothing else. }
program pdfenc;

uses
  sysutils, pasflate, paspdf;

var
  GS: UInt64;

function Rnd(N: Integer): Integer;
begin
  if N < 1 then
    N := 1;
  GS := GS * 6364136223846793005 + 1442695040888963407;
  Result := Integer((GS shr 33) mod UInt64(N));
end;

const
  Names: array[0..10] of string = ('e40_gs', 'e128rc4_gs', 'e128aes_gs', 'e256_gs', 'e256r5_gs', 'e128aes_clear_gs',
    'e128rc4_groff_os', 'e128aes_groff_os', 'e256_groff_os', 'needpw128_gs', 'needpw256_gs');

function Load(const Path: string): string;
begin
  if not ReadFile(Path, Result) then
  begin
    WriteLn('cannot read ', Path);
    Halt(2);
  end;
end;

var
  i, k, a, b, rounds, ok, faults, other, bad, nrounds: Integer;
  nm, base, enc, plain, want, got, mut, fault: string;
  dp, de: TPdfDoc;
begin
  bad := 0;
  for i := 0 to High(Names) do
  begin
    nm := Names[i];
    if Pos('_gs', nm) > 0 then
      base := 'ghostscript'
    else
      base := 'groff';
    enc := Load('testdata/pdfenc/' + nm + '.pdf');
    plain := Load('testdata/pdfreal/' + base + '.pdf');
    fault := '';
    got := '';
    de := nil;
    try
      de := TPdfDoc.Create(enc);
      got := de.Text;
    except
      on E: EPdfError do
        fault := E.Message;
    end;
    if Copy(nm, 1, 6) = 'needpw' then
    begin
      if (fault = '') or (Pos('password', fault) = 0) then
      begin
        bad := bad + 1;
        WriteLn('NOT REFUSED ', nm, ': ', fault);
      end
      else
        WriteLn(nm, ': refused, ', fault);
    end
    else
    begin
      dp := TPdfDoc.Create(plain);
      want := dp.Text;
      if fault <> '' then
      begin
        bad := bad + 1;
        WriteLn('FAULT ', nm, ': ', fault);
      end
      else if got <> want then
      begin
        bad := bad + 1;
        WriteLn('DIFFERS ', nm);
      end
      else if (de.Info('Producer') <> dp.Info('Producer')) or (de.Info('CreationDate') <> dp.Info('CreationDate')) then
      begin
        bad := bad + 1;
        WriteLn('INFO ', nm, ': ', de.Info('Producer'), ' / ', dp.Info('Producer'));
      end
      else if not de.Encrypted then
      begin
        bad := bad + 1;
        WriteLn('NOT ENCRYPTED ', nm);
      end
      else
        WriteLn(nm, ': ', Length(got), ' bytes of text, producer ', de.Info('Producer'));
    end;
  end;
  WriteLn('files ', Length(Names), ', wrong ', bad);
  GS := 4940;
  nrounds := 12;
  if ParamStr(1) <> '' then
    nrounds := StrToInt(ParamStr(1));
  if ParamStr(2) <> '' then
    GS := StrToInt(ParamStr(2));
  rounds := 0;
  ok := 0;
  faults := 0;
  other := 0;
  for i := 0 to High(Names) do
  begin
    enc := Load('testdata/pdfenc/' + Names[i] + '.pdf');
    for k := 1 to nrounds do
    begin
      mut := enc;
      case Rnd(5) of
        0: mut := Copy(enc, 1, Rnd(Length(enc) + 1));
        1:
          begin
            a := Rnd(Length(enc)) + 1;
            mut := Copy(enc, 1, a - 1) + Copy(enc, a + 1 + Rnd(40), Length(enc));
          end;
        2:
          for b := 1 to 1 + Rnd(8) do
          begin
            a := Rnd(Length(mut)) + 1;
            mut[a] := Chr(Rnd(256));
          end;
        3:
          begin
            a := Rnd(Length(enc)) + 1;
            b := Rnd(Length(enc)) + 1;
            mut := Copy(enc, 1, a) + Copy(enc, b, 30 + Rnd(200)) + Copy(enc, a + 1, Length(enc));
          end;
        4:
          for b := 1 to 1 + Rnd(4) do
          begin
            a := Rnd(Length(mut)) + 1;
            mut[a] := Chr(Ord(mut[a]) xor (1 shl Rnd(8)));
          end;
      end;
      rounds := rounds + 1;
      try
        got := PdfText(mut);
        ok := ok + 1;
      except
        on E: EPdfError do
          faults := faults + 1;
        on E: Exception do
        begin
          other := other + 1;
          WriteLn('OTHER ', Names[i], ' round ', k, ': ', E.ClassName, ' ', E.Message);
        end;
      end;
    end;
  end;
  WriteLn('mutations ', rounds, ': read ', ok, ', refused ', faults, ', other ', other);
end.
