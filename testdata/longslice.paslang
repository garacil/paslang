{ P270: the kernels of the core units are given at most 64 KiB a call
  by their fronts in Pascal; across the edges of those slices the answer
  must be the one call's. A text of random letters from jsonkern's
  xorshift, of 4 * 65536 + 999 bytes, with a byte, a needle or a
  difference put at every place from three before to two after each
  edge (k * 65536, k from 1 to 3) and from three starts (0, 1, 37):
  IndexByte and Pos of a character, Pos of strings (across an edge, one
  of 70 000 bytes found and the same with its last byte changed, one
  whose first byte is nowhere, one whose first byte keeps matching),
  CompareByte both ways, CompareText, the JSON escape finder in both
  modes; UpperCase and LowerCase of random bytes; the hashes on 38
  lengths around the edges, each also against its base body; rotations
  of 300 000 random bytes. Each family's answers are summed into one
  line that scripts/longslice_model.py gives from Python's own
  (bytes.find, hashlib, zlib, a table for CRC-32C, the rotation of an
  integer); the Plain bodies are checked too, and every disagreement is
  counted. }
program longslice;

uses pashash, pasjson, passtr, sysutils;

const
  NText = 4 * 65536 + 999;
  { the starts, the hash lengths' distances from an edge, the counts of
    the rotations: scripts/longslice_model.py reads these tables }
  Starts: array[0..2] of Integer = (0, 1, 37);
  Ds: array[0..18] of Integer = (-129, -128, -65, -64, -63, -17, -16, -1, 0, 1, 15, 16, 17, 63, 64, 65, 127, 128, 129);
  Rots: array[0..7] of Integer = (1, 3, 8, 13, 63, 64, 65, 524293);
  Escs: array[0..5] of Integer = (34, 92, 10, 60, 38, 62);

var
  seed, H, bad: Int64;

function Rnd: Int64;
begin
  seed := seed xor (seed shl 13);
  seed := seed xor (seed shr 7);
  seed := seed xor (seed shl 17);
  Result := seed and $7FFFFFFFFFFFFFFF;
end;

procedure Mix(V: Int64);
begin
  H := (H * 131 + (V and $FFFFFFFF) + 1) and $FFFFFFFFFFFF;
end;

procedure MixStr(const S: string);
var
  i: Int64;
begin
  Mix(Length(S));
  for i := 1 to Length(S) do
    Mix(Ord(S[i]));
end;

{ N random bytes: letters, or any byte }
function RandText(N: Int64; Letters: Boolean): string;
var
  i: Int64;
begin
  SetLength(Result, N);
  for i := 1 to N do
    if Letters then
      Result[i] := Chr(97 + Rnd mod 26)
    else
      Result[i] := Chr(Rnd and 255);
end;

procedure Disagree(const What: string; P, A, B: Int64);
begin
  bad := bad + 1;
  if bad < 10 then
    WriteLn('disagree: ', What, ' at ', P, ': ', A, ' against ', B);
end;

var
  t, u, v, w, sub, x: string;
  i, k, d, a, p, r, e, n, cnt, j, c, mode: Int64;

begin
  bad := 0;
  seed := 88172645463325252;
  t := RandText(NText, True);

  { IndexByte and Pos of a character: '#' at each place, then none }
  H := 0;
  cnt := 0;
  for i := 0 to 2 do
  begin
    a := Starts[i];
    for k := 1 to 3 do
      for d := -3 to 2 do
      begin
        p := k * 65536 + d;
        u := t;
        u[a + p + 1] := '#';
        r := IndexByte(u[a + 1], NText - a, 35);
        e := PasIndexBytePlain(@u[a + 1], NText - a, 35);
        if r <> e then
          Disagree('IndexByte', p, r, e);
        Mix(r);
        Mix(Pos('#', u, a + 1));
        cnt := cnt + 1;
      end;
    Mix(IndexByte(t[a + 1], NText - a, 35));
    Mix(Pos('#', t, a + 1));
  end;
  WriteLn('indexbyte ', cnt, ' ', H);

  { Pos of strings }
  H := 0;
  cnt := 0;
  for k := 1 to 3 do
    for d := -3 to 2 do
    begin
      p := k * 65536 + d;
      u := t;
      u[p + 1] := '#';
      u[p + 2] := '!';
      u[p + 3] := '#';
      Mix(Pos('#!#', u));
      Mix(Pos('#!#', u, 37));
      cnt := cnt + 1;
    end;
  sub := Copy(t, 100001, 70000);
  Mix(Pos(sub, t));
  sub[70000] := '#';
  Mix(Pos(sub, t));
  Mix(Pos('#z', t));
  u := t;
  u[200001] := 'a';
  u[200002] := '#';
  Mix(Pos('a#', u));
  WriteLn('pos ', cnt, ' ', H);

  { CompareByte: one byte changed at each place, both ways; equal }
  H := 0;
  cnt := 0;
  v := Copy(t, 1, NText);
  for i := 0 to 2 do
  begin
    a := Starts[i];
    for k := 1 to 3 do
      for d := -3 to 2 do
      begin
        p := k * 65536 + d;
        u := t;
        u[a + p + 1] := '#';
        r := CompareByte(t[a + 1], u[a + 1], NText - a);
        e := PasCmpBytePlain(@t[a + 1], @u[a + 1], NText - a);
        if r <> e then
          Disagree('CompareByte', p, r, e);
        Mix(r);
        Mix(CompareByte(u[a + 1], t[a + 1], NText - a));
        cnt := cnt + 1;
      end;
    Mix(CompareByte(t[a + 1], v[a + 1], NText - a));
  end;
  WriteLn('comparebyte ', cnt, ' ', H);

  { CompareText: the capitals of t, equal but for case, then changed }
  H := 0;
  cnt := 0;
  v := UpperCase(t);
  Mix(CompareText(t, v));
  for k := 1 to 3 do
    for d := -3 to 2 do
    begin
      p := k * 65536 + d;
      u := v;
      u[p + 1] := '#';
      Mix(CompareText(t, u));
      Mix(CompareText(u, t));
      cnt := cnt + 1;
    end;
  WriteLn('comparetext ', cnt, ' ', H);

  { the JSON escape finder: each byte to escape at each place, both
    modes; '<', '&' and '>' only with HTML }
  H := 0;
  cnt := 0;
  for i := 0 to 2 do
  begin
    a := Starts[i];
    for k := 1 to 3 do
      for d := -3 to 2 do
        for j := 0 to 5 do
          for mode := 0 to 1 do
          begin
            p := k * 65536 + d;
            u := t;
            u[a + p + 1] := Chr(Escs[j]);
            Mix(PasJsonEscIndex(@u[a + 1], NText - a, mode = 1));
            cnt := cnt + 1;
          end;
    Mix(PasJsonEscIndex(@t[a + 1], NText - a, True));
  end;
  WriteLn('jsonesc ', cnt, ' ', H);

  { UpperCase and LowerCase of random bytes }
  H := 0;
  w := RandText(NText, False);
  u := UpperCase(w);
  v := LowerCase(w);
  SetLength(x, NText);
  PasCaseMapPlain(@w[1], @x[1], NText, True);
  if x <> u then
    Disagree('UpperCase', 0, 0, 0);
  PasCaseMapPlain(@w[1], @x[1], NText, False);
  if x <> v then
    Disagree('LowerCase', 0, 0, 0);
  MixStr(u);
  MixStr(v);
  WriteLn('case ', NText, ' ', H);

  { the hashes on lengths around the edges, each against its base body }
  w := RandText(3 * 65536, False);
  for c := 0 to 6 do
  begin
    H := 0;
    cnt := 0;
    for k := 1 to 2 do
      for i := 0 to 18 do
      begin
        n := k * 65536 + Ds[i];
        sub := Copy(w, 1, n);
        case c of
          0:
            begin
              x := Sha1(sub);
              if x <> PasSha1Base(sub) then Disagree('Sha1', n, 0, 0);
            end;
          1:
            begin
              x := Sha224(sub);
              if x <> PasSha224Base(sub) then Disagree('Sha224', n, 0, 0);
            end;
          2:
            begin
              x := Sha256(sub);
              if x <> PasSha256Base(sub) then Disagree('Sha256', n, 0, 0);
            end;
          3:
            begin
              x := Sha384(sub);
              if x <> PasSha384Base(sub) then Disagree('Sha384', n, 0, 0);
            end;
          4:
            begin
              x := Sha512(sub);
              if x <> PasSha512Base(sub) then Disagree('Sha512', n, 0, 0);
            end;
          5:
            begin
              r := Crc32(sub);
              e := PasCrc32Base(sub, 0);
              if r <> e then Disagree('Crc32', n, r, e);
              x := IntToStr(r);
            end;
          6:
            begin
              r := Crc32c(sub);
              e := PasCrc32cBase(sub, 0);
              if r <> e then Disagree('Crc32c', n, r, e);
              x := IntToStr(r);
            end;
        end;
        MixStr(x);
        cnt := cnt + 1;
      end;
    WriteLn('hash ', c, ' ', cnt, ' ', H);
  end;

  { rotations of 300 000 random bytes, as one number: left and right,
    and back }
  H := 0;
  w := RandText(300000, False);
  for i := 0 to 7 do
  begin
    u := RotateLeft(w, Rots[i]);
    v := RotateRight(w, Rots[i]);
    MixStr(u);
    MixStr(v);
    if RotateRight(u, Rots[i]) <> w then
      Disagree('Rotate', Rots[i], 0, 0);
  end;
  WriteLn('rotate 8 ', H);
  WriteLn('disagree ', bad);
end.
