{ Copy, Insert and Delete of a slice (P136), as Free Pascal's: 0-based,
  clamped, each giving a new slice, so one that shared the elements
  keeps them; slices of Integer, of strings (whose elements the
  collector follows) and of records; Insert of an element, of a slice
  and of a list in brackets; a slice in a record's field; many edits
  in a loop. The same source compiles with Free Pascal, whose output is
  the one expected. }
program slicedit;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  TInts = array of Integer;
  TStrs = array of string;
  TPair = record
    K: string;
    V: Integer;
  end;
  TPairs = array of TPair;
  THolder = record
    Name: string;
    Items: TInts;
  end;

var
  a, b, c: TInts;
  s, t: TStrs;
  p: TPairs;
  h: THolder;
  i, sum: Integer;
  one: TPair;

procedure ShowI(const X: TInts);
var
  i: Integer;
begin
  Write('[');
  for i := 0 to High(X) do
    Write(' ', X[i]);
  WriteLn(' ]');
end;

procedure ShowS(const X: TStrs);
var
  i: Integer;
begin
  Write('<');
  for i := 0 to High(X) do
    Write(' ', X[i]);
  WriteLn(' >');
end;

function Range(N: Integer): TInts;
var
  i: Integer;
begin
  Result := nil;
  SetLength(Result, N);
  for i := 0 to N - 1 do
    Result[i] := i * 10;
end;

begin
  a := Range(6);
  b := a;
  ShowI(Copy(a, 2, 3));
  ShowI(Copy(a, 4));
  ShowI(Copy(a, -1, 3));
  ShowI(Copy(a, 7, 1));
  c := Copy(a, 1, 2);
  c[0] := -1;
  Delete(a, 1, 2);
  ShowI(a);
  ShowI(b);
  ShowI(c);
  Insert(99, a, 1);
  Insert(Range(2), a, 0);
  Insert(-5, a, 100);
  Insert(-6, a, -4);
  ShowI(a);
  Delete(a, -1, 1);
  Delete(a, 100, 1);
  Delete(a, 0, 0);
  Delete(a, 5, 100);
  ShowI(a);
  s := nil;
  for i := 1 to 5 do
    Insert('s' + Chr(48 + i), s, 0);
  t := Copy(s, 1, 3);
  Delete(s, 0, 2);
  ShowS(s);
  ShowS(t);
  Insert(t, s, 1);
  ShowS(s);
  p := nil;
  for i := 1 to 4 do
  begin
    one.K := 'k' + Chr(48 + i);
    one.V := i * i;
    Insert(one, p, Length(p) div 2);
  end;
  Delete(p, 1, 1);
  for i := 0 to High(p) do
    Write(p[i].K, '=', p[i].V, ' ');
  WriteLn;
  h.Name := 'h';
  h.Items := Range(3);
  Insert(7, h.Items, 1);
  Delete(h.Items, 0, 1);
  ShowI(h.Items);
  a := nil;
  for i := 1 to 300 do
    Insert(i, a, i mod 7);
  for i := 1 to 100 do
    Delete(a, i mod 11, 2);
  sum := 0;
  for i := 0 to High(a) do
    sum := sum + a[i] * (i + 1);
  WriteLn(Length(a), ' ', sum);
end.

