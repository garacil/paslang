{ Exit in the program's own body ends the program as reaching end. would
  (1.1.1: the emitter named the body's end label and never wrote it, so
  the link failed with an undefined .Lepi0). The routines started before
  it are waited for, and the finalisation runs. }
program mainexit;

var
  wg: WaitGroup;
  n: Integer;

procedure Work;
begin
  n := n + 1;
  wg.Done;
end;

begin
  wg.Add(1);
  pas Work;
  wg.Wait;
  WriteLn('before ', n);
  if n = 1 then
    Exit;
  WriteLn('not reached');
end.
