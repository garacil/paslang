{ P427: pasflate's reader against zlib. testdata/flate.txt holds streams
  (scripts/flate_corpus.py writes it): what zlib makes at every level and
  strategy with flushes inside, gzip files of several members, hand-made
  DEFLATE and mutants of them, each with the verdict zlib and Go's
  compress/flate give when they agree (the length and CRC-32 of the bytes
  it makes, or err; when they do not, either|ZLIB|GO and either will do).
  Each is read whole and then fed in pieces of 1 to 100000 bytes, which
  must end the same; only the lines that differ are written, then the
  counts. }
program flate;

uses
  paslib, sysutils, pascodec, pasflate;

const
  HexDigits: string = '0123456789abcdef';
  Chunks: array[0..7] of Integer = (1, 2, 3, 5, 13, 64, 1000, 100000);

{ a stream of the corpus, base64 as scripts write it }
function Unb64(const S: string): string;
begin
  if not Base64Decode(S, False, True, Result) then
  begin
    WriteLn('bad base64 in the corpus');
    Halt(2);
  end;
end;

function Hex8(V: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, 8);
  for i := 8 downto 1 do
  begin
    Result[i] := HexDigits[(V and 15) + 1];
    V := V shr 4;
  end;
end;

function Verdict(const Kind, Blob: string; Chunk: Integer): string;
var
  z: TInflater;
  k, i, n: Integer;
  outs: string;
begin
  Result := 'err';
  if Kind = 'raw' then
    k := flRaw
  else if Kind = 'zlib' then
    k := flZlib
  else
    k := flGzip;
  z := TInflater.Create(k);
  z.Multistream := Kind = 'gzipm';
  try
    i := 1;
    outs := '';
    while i <= Length(Blob) do
    begin
      n := Chunk;
      if i + n - 1 > Length(Blob) then
        n := Length(Blob) - i + 1;
      z.Feed(Copy(Blob, i, n));
      outs := outs + z.Take;
      i := i + n;
    end;
    if (not z.Done) or (z.Unused <> '') then
      Exit;
    outs := outs + z.Finish;
    Result := 'ok:' + IntToStr(Length(outs)) + ':' + Hex8(Crc32(outs));
  except
    on E: EFlateError do
      Result := 'err';
  end;
end;

{ P682: valid raw streams and a semantic output budget. No promise about
  capacity or the exact prefix retained after an error. }
procedure LimitFailure(const Name, Why: string);
begin
  WriteLn('FLATE-LIMIT ', Name, ': ', Why);
  Halt(108);
end;

procedure LimitCase(const Name, Blob, Plain: string; Budget, FeedSize: Integer; WantError: Boolean);
var
  z: TInflater;
  i, n: Integer;
  outs: string;
  raised: Boolean;
begin
  z := TInflater.Create(flRaw);
  z.MaxOutput := Budget;
  i := 1;
  outs := '';
  raised := False;
  try
    while i <= Length(Blob) do
    begin
      n := FeedSize;
      if n > Length(Blob) - i + 1 then n := Length(Blob) - i + 1;
      z.Feed(Copy(Blob, i, n));
      if (Budget > 0) and (z.Total > Budget) then LimitFailure(Name, 'made output past the budget');
      outs := outs + z.Take;
      i := i + n;
    end;
    outs := outs + z.Finish;
  except
    on E: EFlateError do
    begin
      raised := True;
      if Pos('the output is larger than the limit', E.Message) = 0 then LimitFailure(Name, 'wrong error');
    end;
  end;
  if raised <> WantError then LimitFailure(Name, 'wrong return or raise');
  if Budget > 0 then
  begin
    if z.Total > Budget then LimitFailure(Name, 'counter passed the budget');
    if Length(outs) > Budget then LimitFailure(Name, 'returned output past the budget');
  end;
  if not raised then
    if (outs <> Plain) or (not z.Done) or (z.Unused <> '') then LimitFailure(Name, 'wrong complete stream');
end;

procedure CheckOutputLimits;
var
  literalData, storedData, matchData, emptyData: string;
  i, chunk: Integer;
begin
  { RFC1951 fixed8 literals+EOB and stored8 bytes, independently checked
    against zlib. The match fixture is one literal A followed by length7,
    distance1 and EOB, using the same fixed-code alphabet. }
  literalData := Unb64('c3RydnF1c/cAAA==');
  storedData := Unb64('AQgA9/9BQkNERUZHSA==');
  matchData := Unb64('c4QCAA==');
  emptyData := Unb64('AwA=');
  for i := 0 to 1 do
  begin
    if i = 0 then chunk := 1000 else chunk := 1;
    LimitCase('literal-unlimited', literalData, 'ABCDEFGH', 0, chunk, False);
    LimitCase('literal-exact', literalData, 'ABCDEFGH', 8, chunk, False);
    LimitCase('literal-under', literalData, 'ABCDEFGH', 7, chunk, True);
    LimitCase('literal-small', literalData, 'ABCDEFGH', 1, chunk, True);
    LimitCase('literal-integer-bound', literalData, 'ABCDEFGH', High(Integer), chunk, False);
    LimitCase('stored-unlimited', storedData, 'ABCDEFGH', 0, chunk, False);
    LimitCase('stored-exact', storedData, 'ABCDEFGH', 8, chunk, False);
    LimitCase('stored-under', storedData, 'ABCDEFGH', 7, chunk, True);
    LimitCase('match-unlimited', matchData, 'AAAAAAAA', 0, chunk, False);
    LimitCase('match-exact', matchData, 'AAAAAAAA', 8, chunk, False);
    LimitCase('match-under', matchData, 'AAAAAAAA', 7, chunk, True);
    LimitCase('empty-positive-budget', emptyData, '', 1, chunk, False);
  end;
end;

var
  corpus, line, kind, id, want, hx, blob, v, v2: string;
  p, q, nl, count, bad, chunkBad, c: Integer;
begin
  CheckOutputLimits;
  if ParamStr(1) = '--limits-only' then
  begin
    WriteLn('ok flate output limits');
    Halt(0);
  end;
  if not ReadFile('testdata/flate.txt', corpus) then
  begin
    WriteLn('no testdata/flate.txt');
    Halt(2);
  end;
  p := 1;
  count := 0;
  bad := 0;
  chunkBad := 0;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    q := Pos(' ', line);
    kind := Copy(line, 1, q - 1);
    line := Copy(line, q + 1, Length(line) - q);
    q := Pos(' ', line);
    id := Copy(line, 1, q - 1);
    line := Copy(line, q + 1, Length(line) - q);
    q := Pos(' ', line);
    want := Copy(line, 1, q - 1);
    hx := Copy(line, q + 1, Length(line) - q);
    if hx = '-' then
      blob := ''
    else
      blob := Unb64(hx);
    v := Verdict(kind, blob, 100000);
    { zlib and Go agree, or they differ and a verdict of either will do }
    if Copy(want, 1, 7) = 'either|' then
      want := Copy(want, 8, Length(want)) + '|';
    if (v <> want) and (Pos('|' + v + '|', '|' + want) = 0) then
    begin
      bad := bad + 1;
      WriteLn('DIFFERS ', kind, ' ', id, ' reference ', want, ' here ', v);
    end;
    c := Chunks[StrToInt(id) mod 8];
    if (c = 1) and (Length(blob) > 3000) then
      c := 7;
    v2 := Verdict(kind, blob, c);
    if v2 <> v then
    begin
      chunkBad := chunkBad + 1;
      WriteLn('CHUNKS ', kind, ' ', id, ' whole ', v, ' pieces of ', c, ' ', v2);
    end;
    count := count + 1;
  end;
  WriteLn('streams ', count, ', differ from the references ', bad, ', differ in pieces ', chunkBad);
end.
