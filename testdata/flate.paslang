{ P427: pasflate's reader against zlib. testdata/flate.txt holds streams
  (scripts/flate_corpus.py writes it): what zlib makes at every level and
  strategy with flushes inside, gzip files of several members, hand-made
  DEFLATE and mutants of them, each with the verdict zlib and Go's
  compress/flate give when they agree (the length and CRC-32 of the bytes
  it makes, or err; when they do not, either|ZLIB|GO and either will do).
  Each is read whole and then fed in pieces of 1 to 100000 bytes, which
  must end the same; only the lines that differ are written, then the
  counts. }
program flate;

uses
  sysutils, pascodec, pasflate;

const
  HexDigits: string = '0123456789abcdef';
  Chunks: array[0..7] of Integer = (1, 2, 3, 5, 13, 64, 1000, 100000);

{ a stream of the corpus, base64 as scripts write it }
function Unb64(const S: string): string;
begin
  if not Base64Decode(S, False, True, Result) then
  begin
    WriteLn('bad base64 in the corpus');
    Halt(2);
  end;
end;

function Hex8(V: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, 8);
  for i := 8 downto 1 do
  begin
    Result[i] := HexDigits[(V and 15) + 1];
    V := V shr 4;
  end;
end;

function Verdict(const Kind, Blob: string; Chunk: Integer): string;
var
  z: TInflater;
  k, i, n: Integer;
  outs: string;
begin
  Result := 'err';
  if Kind = 'raw' then
    k := flRaw
  else if Kind = 'zlib' then
    k := flZlib
  else
    k := flGzip;
  z := TInflater.Create(k);
  z.Multistream := Kind = 'gzipm';
  try
    i := 1;
    outs := '';
    while i <= Length(Blob) do
    begin
      n := Chunk;
      if i + n - 1 > Length(Blob) then
        n := Length(Blob) - i + 1;
      z.Feed(Copy(Blob, i, n));
      outs := outs + z.Take;
      i := i + n;
    end;
    if (not z.Done) or (z.Unused <> '') then
      Exit;
    outs := outs + z.Finish;
    Result := 'ok:' + IntToStr(Length(outs)) + ':' + Hex8(Crc32(outs));
  except
    on E: EFlateError do
      Result := 'err';
  end;
end;

var
  corpus, line, kind, id, want, hx, blob, v, v2: string;
  p, q, nl, count, bad, chunkBad, c: Integer;
begin
  if not ReadFile('testdata/flate.txt', corpus) then
  begin
    WriteLn('no testdata/flate.txt');
    Halt(2);
  end;
  p := 1;
  count := 0;
  bad := 0;
  chunkBad := 0;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    q := Pos(' ', line);
    kind := Copy(line, 1, q - 1);
    line := Copy(line, q + 1, Length(line) - q);
    q := Pos(' ', line);
    id := Copy(line, 1, q - 1);
    line := Copy(line, q + 1, Length(line) - q);
    q := Pos(' ', line);
    want := Copy(line, 1, q - 1);
    hx := Copy(line, q + 1, Length(line) - q);
    if hx = '-' then
      blob := ''
    else
      blob := Unb64(hx);
    v := Verdict(kind, blob, 100000);
    { zlib and Go agree, or they differ and a verdict of either will do }
    if Copy(want, 1, 7) = 'either|' then
      want := Copy(want, 8, Length(want)) + '|';
    if (v <> want) and (Pos('|' + v + '|', '|' + want) = 0) then
    begin
      bad := bad + 1;
      WriteLn('DIFFERS ', kind, ' ', id, ' reference ', want, ' here ', v);
    end;
    c := Chunks[StrToInt(id) mod 8];
    if (c = 1) and (Length(blob) > 3000) then
      c := 7;
    v2 := Verdict(kind, blob, c);
    if v2 <> v then
    begin
      chunkBad := chunkBad + 1;
      WriteLn('CHUNKS ', kind, ' ', id, ' whole ', v, ' pieces of ', c, ' ', v2);
    end;
    count := count + 1;
  end;
  WriteLn('streams ', count, ', differ from the references ', bad, ', differ in pieces ', chunkBad);
end.
