{ P125: a method called with too few arguments is refused; it took
  whatever the registers held (1.1.1 printed 5 0). }
program mfew;
type
  TA = class
    procedure P(X: Int64; Y: Int64);
  end;
procedure TA.P(X: Int64; Y: Int64);
begin
  WriteLn(X, ' ', Y);
end;
var
  a: TA;
begin
  a := TA.Create;
  a.P(5);
end.

