{ P125: a call gives every argument that has no default. }
program mcount;
type
  TA = class
    procedure P(X: Int64; Y: Int64 = 2);
  end;
procedure TA.P(X: Int64; Y: Int64);
begin
end;
var
  a: TA;
begin
  a := TA.Create;
  a.P();
end.

