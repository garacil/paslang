{ P331: globals of every width, a record's fields and an array's
  elements at constant offsets, read and written in routines and in the
  main block, on arm64 by adrp and the access with the low twelve bits.
  The answers are worked out by hand in the comments.
  scripts/check_adrpfold.py finds no adrp, add and access left where
  the access could take the low bits. }
program globfold;

uses paslib;

type
  TRec = record
    A: Integer;
    B: Int32;
    C: Word;
    D: Byte;
    E: Int64;
  end;

var
  gi: Integer;
  g32: Int32;
  gw: Word;
  gb: Byte;
  gs8: Int8;
  gr: TRec;
  ga: array[0..7] of Integer;
  gp: ^Integer;

procedure Bump(K: Integer);
begin
  gi := gi + K;
  g32 := g32 - Int32(K);
  gw := gw + Word(K);
  gb := gb + Byte(K);
  gs8 := gs8 - Int8(K);
  gr.A := gr.A + K;
  gr.B := gr.B + Int32(K * 2);
  gr.C := gr.C + Word(K * 3);
  gr.D := gr.D + Byte(K * 4);
  gr.E := gr.E + K * 5;
  ga[3] := ga[3] + K;
  ga[7] := ga[7] - K;
end;

function Sum: Integer;
begin
  Result := gi + g32 + gw + gb + gs8 + gr.A + gr.B + gr.C + gr.D + gr.E + ga[3] + ga[7];
end;

var
  k: Integer;

begin
  gi := 100;
  g32 := -100;
  gw := 65530;
  gb := 250;
  gs8 := -120;
  gr.A := 1;
  gr.B := 2;
  gr.C := 3;
  gr.D := 4;
  gr.E := 5;
  ga[3] := 30;
  ga[7] := 70;
  for k := 1 to 3 do
    Bump(k);
  { after 1 + 2 + 3: gi 106, g32 -106, gw 65536 wraps to 0, gb 256 wraps
    to 0, gs8 -126, A 7, B 14, C 21, D 28, E 35, ga[3] 36, ga[7] 64 }
  WriteLn(gi, ' ', g32, ' ', gw, ' ', gb, ' ', gs8);
  WriteLn(gr.A, ' ', gr.B, ' ', gr.C, ' ', gr.D, ' ', gr.E, ' ', ga[3], ' ', ga[7]);
  { 106 - 106 + 0 + 0 - 126 + 7 + 14 + 21 + 28 + 35 + 36 + 64 = 79 }
  WriteLn(Sum);
  New(gp);
  gp^ := 41;
  gi := gp^ + 1;
  WriteLn(gi);
end.

