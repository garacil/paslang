program ctorvar;
{ A constructor with a var or out parameter takes the address of the place it is
  given, as a method does (P498): before, the call passed the value and the first
  store through the parameter stopped with a nil pointer. The places: a local, a
  global, a field, an element, a record's field; the types: Integer, string, a
  record, a dynamic array; a virtual constructor through a class reference, an
  inherited call that passes its own var parameter on, and twelve arguments so that
  the last three travel on the stack. }
uses sysutils;

type
  TPair = record
    X, Y: Integer;
  end;

  TBox = class
    N: Integer;
    Note: string;
    constructor Create(A: Integer; var Acc: Integer); virtual;
    constructor Make(const S: string; var Text: string; out Pr: TPair; var List: array of Integer);
    constructor Wide(A, B, C, D, E, F, G, H, I: Integer; var Total: Integer; var Said: string;
      out Last: Integer);
  end;

  TSub = class(TBox)
    constructor Create(A: Integer; var Acc: Integer); override;
  end;

  TBoxClass = class of TBox;

  THolder = class
    Count: Integer;
  end;

constructor TBox.Create(A: Integer; var Acc: Integer);
begin
  N := A;
  Acc := Acc + A;
end;

constructor TBox.Make(const S: string; var Text: string; out Pr: TPair; var List: array of Integer);
begin
  Text := Text + S;
  Pr.X := Length(Text);
  Pr.Y := High(List);
  List[0] := List[0] + Pr.X;
  Note := Text;
end;

constructor TBox.Wide(A, B, C, D, E, F, G, H, I: Integer; var Total: Integer; var Said: string;
  out Last: Integer);
begin
  N := A + B + C + D + E + F + G + H + I;
  Total := Total + N;
  Said := Said + '<' + IntToStr(N) + '>';
  Last := I;
end;

constructor TSub.Create(A: Integer; var Acc: Integer);
begin
  inherited Create(A * 10, Acc);
  Acc := Acc + 1;
end;

var
  g: Integer;
  checks, bad: Integer;

procedure Expect(const Got, Want: string);
begin
  Inc(checks);
  if Got <> Want then
  begin
    Inc(bad);
    WriteLn('want ', Want, ' got ', Got);
  end;
end;

procedure Go;
var
  b: TBox;
  h: THolder;
  cls: TBoxClass;
  loc, last: Integer;
  arr: array[0..3] of Integer;
  dyn: array of Integer;
  r: TPair;
  p: TPair;
  s, said: string;
  i: Integer;
begin
  loc := 100;
  b := TBox.Create(5, loc);
  Expect(IntToStr(loc) + ',' + IntToStr(b.N), '105,5');
  g := 7;
  b := TBox.Create(6, g);
  Expect(IntToStr(g) + ',' + IntToStr(b.N), '13,6');
  h := THolder.Create;
  h.Count := 40;
  b := TBox.Create(2, h.Count);
  Expect(IntToStr(h.Count), '42');
  for i := 0 to 3 do
    arr[i] := i * 100;
  b := TBox.Create(9, arr[2]);
  Expect(IntToStr(arr[0]) + ',' + IntToStr(arr[2]), '0,209');
  r.X := 1;
  r.Y := 2;
  b := TBox.Create(4, r.Y);
  Expect(IntToStr(r.X) + ',' + IntToStr(r.Y), '1,6');
  b := TSub.Create(3, loc);
  Expect(IntToStr(loc) + ',' + IntToStr(b.N), '136,30');
  cls := TSub;
  b := cls.Create(1, loc);
  Expect(IntToStr(loc) + ',' + IntToStr(b.N), '147,10');
  cls := TBox;
  b := cls.Create(1, loc);
  Expect(IntToStr(loc) + ',' + IntToStr(b.N), '148,1');
  s := 'ab';
  SetLength(dyn, 3);
  dyn[0] := 10;
  b := TBox.Make('cde', s, p, dyn);
  Expect(s + ',' + IntToStr(p.X) + ',' + IntToStr(p.Y) + ',' + IntToStr(dyn[0]) + ',' + b.Note, 'abcde,5,2,15,abcde');
  said := 'w';
  loc := 0;
  b := TBox.Wide(1, 2, 3, 4, 5, 6, 7, 8, 9, loc, said, last);
  Expect(IntToStr(loc) + ',' + said + ',' + IntToStr(last) + ',' + IntToStr(b.N), '45,w<45>,9,45');
  b := TBox.Wide(9, 8, 7, 6, 5, 4, 3, 2, 1, loc, said, last);
  Expect(IntToStr(loc) + ',' + said + ',' + IntToStr(last), '90,w<45><45>,1');
end;

begin
  Go;
  WriteLn('checks=', checks, ' bad=', bad);
end.
