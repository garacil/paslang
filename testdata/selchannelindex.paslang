program selchannelindex;
type
  TChan = chan of Integer;
  TAct = procedure;
procedure ChannelIndex;
var
  channels: array[0..3] of TChan;
  acts: array[0..2] of TAct;
  i, j, attempt, value, total: Integer;
begin
  for j := 0 to 3 do
    channels[j] := MakeChan(3);
  for i := 0 to 2 do
    acts[i] := procedure
      begin
        select
          Send(channels[i and 3], 1): ;
        else
          WriteLn('full');
        end;
      end;
  for j := 0 to 2 do
    acts[j]();
  for j := 0 to 3 do
  begin
    total := 0;
    for attempt := 0 to 2 do
      select
        Recv(channels[j], value): total := total + value;
      else
        ;
      end;
    WriteLn('channel ', j, ': ', total);
  end;
end;
begin
  ChannelIndex;
end.

