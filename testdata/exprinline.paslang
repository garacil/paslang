{ P266: a function of one expression goes in as its expression. The
  output is the same at -inline 0, where every routine stays a call, and
  at -inline 40: constants, variables and expressions as arguments, a
  narrow parameter, a body written Name := E, calls inside calls, calls
  on the right of an and and an or, calls with a trace that must keep
  their order, and the cases that must not go in as an expression: an
  argument of another type, one that indexes or divides, a parameter
  used twice given an expression. Branchy's condition is the compare of
  Less itself, which make check greps in the .s of both machines. }
program exprinline;

var
  trace: string;
  a: array[0..3] of Integer;
  g, i, j, k, m, n: Integer;
  bt: Byte;
  ok: Boolean;

function Less(A, B: Integer): Boolean;
begin
  Result := A < B;
end;

function Sq(X: Integer): Integer;
begin
  Result := X * X;
end;

function Twice(X: Integer): Integer;
begin
  Twice := X + X;
end;

function Next(B: Byte): Integer;
begin
  Result := B + 1;
end;

function Low8(X: Integer): Byte;
begin
  Result := Byte(X);
end;

function Ignore(X: Integer): Integer;
begin
  Result := 7;
end;

function Mark(N: Integer): Integer;
begin
  trace := trace + Chr(48 + N);
  Result := N;
end;

function Between(X, Lo, Hi: Integer): Boolean;
begin
  Result := (X >= Lo) and (X <= Hi);
end;

function Branchy(X, Y: Integer): Integer;
begin
  if Less(X, Y) then
    Result := 1
  else
    Result := 2;
end;

begin
  a[0] := 5;
  a[1] := -3;
  a[2] := 9;
  a[3] := 0;
  for i := -2 to 2 do
    for j := -2 to 2 do
    begin
      n := 0;
      if Less(i, j) then
        n := n + 1;
      if (i > 0) and Less(i, j) then
        n := n + 2;
      if (i > 0) or Less(j, i) then
        n := n + 4;
      if not Less(i + 1, j) then
        n := n + 8;
      if Less(Sq(i), j + 3) then
        n := n + 16;
      if Between(Twice(i), j, 3) then
        n := n + 32;
      k := Sq(i + j) + Twice(i * j) + Next(Low8(i + 300)) + Ignore(a[(i + 2) mod 4]);
      k := k + Sq(a[(j + 2) mod 4]) + Twice(10 div (j + 3)) + Branchy(i, j);
      trace := '';
      ok := Less(Mark(1), Mark(2)) and Less(Mark(3), i);
      write(n, ' ', k, ' ', ok, ' ', trace, '; ');
      m := i;
      while Less(m, j) and Less(Twice(m), 100) do
        m := m + 1;
      write(m, ' ');
    end;
  writeln;
  bt := 255;
  WriteLn(Next(bt), ' ', Next(254), ' ', Low8(511), ' ', Sq(-4), ' ', Twice(High(Integer) div 2));
  bt := 200;
  a[0] := -1;
  WriteLn(Sq(bt), ' ', Twice(bt), ' ', Less(bt, 201), ' ', Sq(bt) + a[0]);
  g := 3;
  WriteLn(Less(g, 4), ' ', Between(g, 1, 2), ' ', Branchy(g, 2), ' ', Branchy(2, g));
end.
