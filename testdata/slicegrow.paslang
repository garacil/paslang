program slicegrow;

{ SetLength that grows within the capacity gives zero elements, as a new
  buffer does (1.0.88): the elements a shrink left behind showed
  through, of every type, and the compiler's own symbol table, grown
  after a routine with more symbols, found a stale local there. }

type
  TSym = record
    Name: string;
    Off: Integer;
  end;

type
  TBox = record
    Items: array of Integer;
  end;

var
  a, b: array of Integer;
  s, words, ys: array of string;
  box1, box2: TBox;
  r: array of TSym;
  saved: array of TSym;
  i, sum: Integer;

procedure Show(const Title: string);
var
  k: Integer;
begin
  Write(Title, ':');
  for k := 0 to High(a) do
    Write(' ', a[k]);
  WriteLn;
end;

begin
  SetLength(a, 10);
  for i := 0 to 9 do
    a[i] := i + 1;
  Show('ten');
  SetLength(a, 3);
  SetLength(a, 8);
  Show('shrunk and grown');
  SetLength(a, 0);
  SetLength(a, 5);
  Show('emptied and grown');
  SetLength(s, 4);
  for i := 0 to 3 do
    s[i] := 'word' + Chr(Ord('0') + i);
  SetLength(s, 1);
  SetLength(s, 4);
  WriteLn(s[0], ' [', s[1], '] [', s[2], '] [', s[3], '] ', Length(s[3]));
  { The compiler's pattern: a table kept, grown, cut back, grown again. }
  SetLength(r, 2);
  r[0].Name := 'self';
  r[0].Off := -8;
  r[1].Name := 'x';
  r[1].Off := -16;
  saved := r;
  SetLength(r, 5);
  r[2].Name := 'i';
  r[2].Off := -24;
  r[3].Name := 'j';
  r[3].Off := -32;
  r := saved;
  SetLength(r, 4);
  r[2].Name := 'k';
  r[2].Off := -24;
  sum := 0;
  for i := 0 to High(r) do
  begin
    Write('[', r[i].Name, ' ', r[i].Off, ']');
    sum := sum + r[i].Off;
  end;
  WriteLn;
  WriteLn(sum);
  { Another slice of the same buffer keeps what it sees: a grow does
    not reach into it, as FPC's SetLength makes the array its own. }
  words := nil;
  SetLength(words, 3);
  words[0] := 'aa';
  words[1] := 'bb';
  words[2] := 'cc';
  ys := words;
  SetLength(ys, 2);
  SetLength(ys, 3);
  WriteLn('[', ys[2], '] ', words[2]);
  a := nil;
  SetLength(a, 2);
  b := a;
  SetLength(a, 3);
  a[2] := 1;
  SetLength(b, 3);
  b[2] := 2;
  WriteLn(a[2], ' ', b[2]);
  SetLength(box1.Items, 1);
  box1.Items[0] := 5;
  box2 := box1;
  SetLength(box1.Items, 2);
  box1.Items[1] := 6;
  SetLength(box2.Items, 2);
  box2.Items[1] := 7;
  WriteLn(box1.Items[1], ' ', box2.Items[1]);
  { A slice grown one element at a time keeps growing in place. }
  a := nil;
  for i := 1 to 100000 do
  begin
    SetLength(a, i);
    a[i - 1] := i;
  end;
  sum := 0;
  for i := 0 to High(a) do
    sum := sum + a[i];
  WriteLn(sum);
  GcCollect;
  for i := 1 to 1000 do
  begin
    SetLength(a, i mod 7);
    SetLength(a, 7);
    if a[6] <> 0 then
      WriteLn('stale at ', i);
    a[6] := i;
  end;
  WriteLn('done');
end.
