program xxh32;

var
  s15, s16, s17, s31, s32, s33, lng: string;

begin
  s15 := 'aaaaaaaaaaaaaaa';
  s16 := 'aaaaaaaaaaaaaaaa';
  s17 := 'aaaaaaaaaaaaaaaaa';
  s31 := 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
  s32 := 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
  s33 := 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb';
  lng := 'The xxHash algorithm is fast because it reads the input in wide stripes and mixes four accumulators in parallel; paslang implements XXH32 and XXH64 in its own emitted runtime for both amd64 and arm64.';
  WriteLn(XxHash32(''));
  WriteLn(XxHash32('a'));
  WriteLn(XxHash32('abc'));
  WriteLn(XxHash32('The quick brown fox jumps over the lazy dog'));
  WriteLn(XxHash32('The quick brown fox jumps over the lazy dog', 1));
  WriteLn(XxHash32(s15));
  WriteLn(XxHash32(s16));
  WriteLn(XxHash32(s17));
  WriteLn(XxHash32(s31));
  WriteLn(XxHash32(s32));
  WriteLn(XxHash32(s33));
  WriteLn(XxHash32(lng));
  WriteLn(XxHash32(lng, 305419896));
end.
