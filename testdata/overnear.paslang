{ P150: among overloads the nearest conversion wins. A class reference
  for two ancestors takes the nearer, a list in brackets the typed set
  or the slice over an array of const, an object the interface it
  implements over Pointer, an integer a Double over a Single; each
  answer is the overload named in the comment. }
program overnear;

type
  TBase = class
  end;
  TKid = class(TBase)
  end;
  TGrand = class(TKid)
  end;
  TBaseClass = class of TBase;
  TKidClass = class of TKid;
  TCS = set of Char;
  IThing = interface
    function Id: Int64;
  end;
  TThing = class(TObject, IThing)
    function Id: Int64;
  end;

function TThing.Id: Int64;
begin
  Result := 1;
end;

function H(K: TBaseClass): string; overload;
begin
  Result := 'base';
end;

function H(K: TKidClass): string; overload;
begin
  Result := 'kid';
end;

function G(S: TCS): string; overload;
begin
  Result := 'set';
end;

function G(const Xs: array of const): string; overload;
begin
  Result := 'const';
end;

function L(const A: array of Integer): string; overload;
begin
  Result := 'ints';
end;

function L(const Xs: array of const): string; overload;
begin
  Result := 'const';
end;

function F(T: IThing): string; overload;
begin
  Result := 'thing';
end;

function F(P: Pointer): string; overload;
begin
  Result := 'pointer';
end;

function R(X: Single): string; overload;
begin
  Result := 'single';
end;

function R(X: Double): string; overload;
begin
  Result := 'double';
end;

var
  n: Integer;
  b: Byte;

begin
  { kid kid base }
  WriteLn(H(TGrand), ' ', H(TKid), ' ', H(TBase));
  { set ints }
  WriteLn(G(['a', 'b']), ' ', L([1, 2, 3]));
  { thing }
  WriteLn(F(TThing.Create));
  { double double double }
  n := 5;
  b := 7;
  WriteLn(R(5), ' ', R(n), ' ', R(b));
end.
