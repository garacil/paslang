program sysguidmodel;
uses sysutils;
var line: string; value: TGUID; bytes: TBytes; count, i, k: Integer;
begin
  ReadLn(line); count := StrToInt(line);
  for i := 1 to count do
  begin
    ReadLn(line);
    if TryStringToGUID(line, value) then
    begin
      bytes := GuidToBytes(value); line := '';
      for k := 0 to 15 do line := line + IntToHex(bytes[k], 2);
      WriteLn(GUIDToString(value), ' ', line);
    end
    else
    begin
      if not value.IsEmpty then Halt(2);
      WriteLn('ERROR');
    end;
  end;
end.
