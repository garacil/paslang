{ Run with CPU affinity restricted to one CPU: rt_ncpu's floor is two
  Ps. Both original Ms block in pipe reads. Main must still run to
  write their answers, collect and join. Raw Syscall is deliberately
  used: this is a runtime contract, not a unit-specific workaround. }
program syscallprogress;

uses paslinux;

var
  pipes: array[0..1, 0..1] of Int32;
  started: chan of Integer;
  joined: waitgroup;
  i, token, answers: Integer;
  sent: Byte;

procedure Reader(Index: Integer);
var
  answer: array[0..7] of Byte;
  count: Integer;
begin
  Send(started, Index);
  repeat
    count := OsRead(pipes[Index, 0], Integer(@answer[0]), 8);
  until count <> -4;
  if (count = 1) and (answer[0] = 42) then
    AtomicAdd(@answers, 1);
  { A short read is not EOF; closing the writer supplies the next EOF. }
  repeat
    count := OsRead(pipes[Index, 0], Integer(@answer[0]), 8);
  until count <> -4;
  if count <> 0 then Halt(6);
  joined.Done;
end;

begin
  started := MakeChan();
  for i := 0 to 1 do
    if OsPipe(Integer(@pipes[i, 0])) <> 0 then Halt(2);
  joined.Add(2);
  for i := 0 to 1 do pas Reader(i);
  for i := 0 to 1 do token := Recv(started);
  Sleep(50);
  GcCollect;
  sent := 42;
  for i := 0 to 1 do
  begin
    if OsWrite(pipes[i, 1], Integer(@sent), 1) <> 1 then Halt(3);
    if OsClose(pipes[i, 1]) <> 0 then Halt(5);
  end;
  joined.Wait;
  for i := 0 to 1 do
  begin
    if OsClose(pipes[i, 0]) <> 0 then Halt(4);
  end;
  WriteLn('syscall progress ', answers);
end.
