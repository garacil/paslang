program pasargs;

{ pas with any number of arguments of any kind (P109, 1.0.135): each
  argument is worked out when pas runs, as Go does, so a later change
  of a variable or the loop's next pass does not reach the new routine;
  pas of a routine value, with or without arguments, of a closure, of a
  nested routine, and pas procedure begin ... end. }

uses paslib;

type
  TPt = record
    X, Y: Integer;
    Tag: string;
  end;
  TInts = array of Integer;
  TSum = procedure(A, B, D: Integer);
  TAct = procedure;
  ITalk = interface
    procedure Say(S: string; N: Integer);
  end;
  TBase = class(ITalk)
    Id: Integer;
    procedure Run(A: Integer; S: string; P: TPt); virtual;
    procedure Ping;
    procedure Say(S: string; N: Integer);
    procedure Spawn(N: Integer);
  end;
  TMore = class(TBase)
    procedure Run(A: Integer; S: string; P: TPt); override;
  end;
  THit = procedure(A, B: Integer) of object;
  TPinger = procedure of object;
  THitter = class
    Id: Integer;
    OnHit: THit;
    procedure Hit(A, B: Integer);
  end;

var
  c: chan of Integer;
  cs: chan of string;
  i, got: Integer;
  s: string;
  p: TPt;
  v: TInts;
  f: TSum;
  a: TAct;
  ctr: Integer;
  rn: Rune;
  bs: array[0..2] of Byte;

procedure Three(A, B, D: Integer);
begin
  Send(c, A * 100 + B * 10 + D);
end;

procedure Five(A: Integer; S: string; P: TPt; D: Double; Q: Byte);
begin
  Send(cs, IntToStr(A) + ' ' + S + ' ' + IntToStr(P.X + P.Y) + P.Tag +
    ' ' + IntToStr(Trunc(D * 4)) + ' ' + IntToStr(Q));
end;

procedure OneStr(S: string);
begin
  Send(cs, S);
end;

procedure TwoRec(P: TPt; K: Integer);
begin
  Send(cs, P.Tag + IntToStr(P.X * K));
end;

procedure Defs(A: Integer; B: Integer = 7; E: Integer = 9);
begin
  Send(c, A + B + E);
end;

procedure SumSl(V: TInts; Extra: Integer);
var
  k, t: Integer;
begin
  t := Extra;
  for k := 0 to High(V) do
    t := t + V[k];
  Send(c, t);
end;

function Sq(X: Integer): Integer;
begin
  Result := X * X;
  Send(c, Result);
end;

procedure TBase.Run(A: Integer; S: string; P: TPt);
begin
  Send(cs, 'base ' + IntToStr(Id + A) + S + P.Tag);
end;

procedure TMore.Run(A: Integer; S: string; P: TPt);
begin
  Send(cs, 'more ' + IntToStr(Id + A) + S + P.Tag);
end;

procedure TBase.Ping;
begin
  Send(c, Id);
end;

procedure TBase.Say(S: string; N: Integer);
begin
  Send(cs, S + IntToStr(N + Id));
end;

{ pas in a method: its own method with Self left out, and a routine
  nested in the method }
procedure TBase.Spawn(N: Integer);
var
  k: Integer;
  q: TPt;
  procedure Inner(S: string; K2: Integer);
  begin
    Send(cs, S + IntToStr(K2 * Id));
  end;
begin
  q.Tag := '.';
  for k := 1 to N do
    pas Run(k, 's', q);
  for k := 1 to N do
    pas Inner('i', k);
end;

procedure THitter.Hit(A, B: Integer);
begin
  Send(c, Id * 1000 + A * 10 + B);
end;

procedure Methods;
var
  o, o2: TBase;
  t: ITalk;
  h: THitter;
  m: THit;
  pg: TPinger;
  fs: array[0..1] of TSum;
  acts: array[0..1] of TAct;
  q: TPt;
  k, sum: Integer;
begin
  o := TMore.Create;
  o.Id := 10;
  o2 := TBase.Create;
  o2.Id := 20;
  q.Tag := '!';
  { the object and each argument worked out now }
  pas o.Run(1, 'x', q);
  o := o2;
  q.Tag := '?';
  WriteLn('method ', Recv(cs));
  pas o.Run(2, 'y', q);
  WriteLn('method ', Recv(cs));
  pas o.Ping;
  WriteLn('no args ', Recv(c));
  t := o;
  pas t.Say('iface ', 5);
  WriteLn(Recv(cs));
  h := THitter.Create;
  h.Id := 3;
  m := h.Hit;
  sum := 0;
  for k := 1 to 3 do
    pas m(k, k + 1);
  for k := 1 to 3 do
    sum := sum + Recv(c);
  WriteLn('of object ', sum);
  pg := o.Ping;
  pas pg;
  WriteLn('of object no args ', Recv(c));
  h.OnHit := h.Hit;
  pas h.OnHit(4, 5);
  h.OnHit := nil;
  WriteLn('field ', Recv(c));
  fs[0] := @Three;
  fs[1] := procedure(A, B, D: Integer)
  begin
    Send(c, A + B + D + 900);
  end;
  pas fs[1](1, 2, 3);
  pas fs[0](4, 5, 6);
  WriteLn('elements ', Recv(c) + Recv(c));
  acts[1] := procedure
  begin
    Send(c, 77);
  end;
  pas acts[1];
  WriteLn('element no args ', Recv(c));
  o.Spawn(3);
  sum := 0;
  for k := 1 to 6 do
  begin
    q.Tag := Recv(cs);
    sum := sum + Length(q.Tag) * 1000 + Ord(q.Tag[Length(q.Tag)]) - Ord('0');
  end;
  WriteLn('in a method ', sum);
end;

procedure Hello;
begin
  Send(cs, 'hello');
end;

{ a var parameter as a for counter, a for-in element and a narrow one
  in an array: the loop stores through the address (1.0.135; it wrote
  over the address) }
procedure VarCounters(var K: Integer; var R: Rune; var B: Byte);
var
  t: Integer;
begin
  t := 0;
  for K := 1 to 3 do
    t := t + K;
  for K in [2, 4, 6] do
    t := t + K * 10;
  for R in 'ab' do
    t := t + Integer(R) * 1000;
  for B := 250 to 255 do
    t := t + B * 100000;
  WriteLn('var counters ', t, ' ', K, ' ', Integer(R), ' ', B);
end;

procedure Outer;
var
  base: Integer;
  procedure Add3(A, B, D: Integer);
  begin
    Send(c, base + A + B + D);
  end;
  procedure Tag(S: string);
  begin
    Send(cs, S + IntToStr(base));
  end;
var
  k, t: Integer;
  w: string;
begin
  base := 1000;
  for k := 1 to 4 do
    pas Add3(k, k, k);
  t := 0;
  for k := 1 to 4 do
    t := t + Recv(c);
  w := 'b';
  pas Tag(w + '=');
  w := 'x';
  WriteLn('nested ', t, ' ', Recv(cs));
  { a closure made in a routine, with its own arguments }
  f := procedure(A, B, D: Integer)
  begin
    Send(c, base + A * B * D);
  end;
  pas f(2, 3, 4);
  WriteLn('closure args ', Recv(c));
  pas procedure
  begin
    Send(c, base * 2 + k);
  end;
  WriteLn('anon ', Recv(c));
end;

begin
  c := MakeChan(8);
  cs := MakeChan(8);
  bs[0] := 7;
  bs[2] := 9;
  { three words, each pass its own values }
  for i := 1 to 5 do
    pas Three(i, 0, i);
  got := 0;
  for i := 1 to 5 do
    got := got + Recv(c);
  WriteLn('three ', got);
  { a string worked out now: the change after pas does not reach it }
  s := 'one';
  pas OneStr(s + '!');
  s := 'two';
  WriteLn('str ', Recv(cs), ' ', s);
  { a record, a string, a Double and a Byte }
  p.X := 1;
  p.Y := 2;
  p.Tag := 'r';
  pas Five(42, 'five', p, 2.5, 255);
  p.X := 100;
  p.Tag := 'changed';
  WriteLn('five ', Recv(cs));
  pas TwoRec(p, 3);
  WriteLn('rec ', Recv(cs));
  { defaults filled in }
  pas Defs(1);
  pas Defs(1, 2);
  WriteLn('defs ', Recv(c) + Recv(c));
  { a slice: the header is copied, the elements shared }
  v := [1, 2, 3];
  pas SumSl(v, 10);
  WriteLn('slice ', Recv(c));
  { a function: its result is dropped }
  pas Sq(9);
  WriteLn('func ', Recv(c));
  { routine values }
  a := @Hello;
  pas a;
  WriteLn('value ', Recv(cs));
  f := @Three;
  pas f(7, 8, 9);
  WriteLn('value args ', Recv(c));
  { a loop of routine values, each pass its arguments }
  got := 0;
  for i := 1 to 4 do
    pas f(i, i, i);
  for i := 1 to 4 do
    got := got + Recv(c);
  WriteLn('value loop ', got);
  pas procedure
  begin
    Send(cs, 'anon main ' + s);
  end;
  WriteLn(Recv(cs));
  Outer;
  VarCounters(ctr, rn, bs[1]);
  WriteLn('after ', ctr, ' ', Integer(rn), ' ', bs[0], ' ', bs[1], ' ', bs[2]);
  Methods;
  { many at once }
  got := 0;
  for i := 1 to 2000 do
  begin
    pas Five(i, 'x', p, 1.0, 1);
    s := Recv(cs);
    if s = IntToStr(i) + ' x 102changed 4 1' then
      got := got + 1;
  end;
  WriteLn('many ', got);
end.
