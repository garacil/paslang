{ PASLANG_GC in the environment: off runs no cycle unless GcCollect asks
  for one (the heap only grows, as before 1.0.58); a number n runs the
  next cycle when what was handed out reaches (100 + n)% of what was
  alive. Run by make check with PASLANG_GC=off and without it. }
program gcoff;

uses
  paslib;

var
  i: Integer;
  s: string;

begin
  for i := 1 to 1000000 do
    s := 'item-number-' + IntToStr(i);
  if HeapStat(0) = 0 then
    WriteLn('no cycle, mapped over 16 MiB ', HeapStat(3) > 16777216)
  else
    WriteLn('cycles, mapped under 16 MiB ', HeapStat(3) <= 16777216);
  i := GcCollect;
  WriteLn('asked ', i, ' ', HeapStat(0) > 0);
end.
