{ P227 (1.1.104): TryGet of a map copies the value out and marks the
  strings in it, as TryGet of a tree does: the copy and the map hold one
  block, so a write to the copy makes it its own first. Values stored
  fresh (a concatenation, which nothing else holds, so the map keeps it
  unmarked): a string, a record with strings, an array of strings; each
  copy written, shortened, grown and appended to, and the map read again
  unchanged. The map of trees and the tree of strings for comparison. }
program trygetshare;

uses
  paslib;

type
  TRec = record
    Name: string;
    N: Integer;
    Tag: string;
  end;
  TPair = array[0..1] of string;

var
  ms: map[Integer] of string;
  mr: map[Integer] of TRec;
  ma: map[string] of TPair;
  ts: tree[Integer] of string;
  v: string;
  r: TRec;
  a: TPair;
  x, i: Integer;

begin
  x := 5;
  New(ms);
  New(mr);
  New(ma);
  New(ts);
  ms[1] := 'abc' + IntToStr(x);
  mr[1].Name := 'name' + IntToStr(x);
  mr[1].N := x;
  mr[1].Tag := 'tag' + IntToStr(x);
  ma['k'][0] := 'left' + IntToStr(x);
  ma['k'][1] := 'right' + IntToStr(x);
  ts[1] := 'def' + IntToStr(x);

  if TryGet(ms, 1, v) then
  begin
    v[1] := 'X';
    WriteLn('string written: ', v, ' map ', ms[1]);
    SetLength(v, 2);
    WriteLn('string shortened: ', v, ' map ', ms[1]);
  end;
  if TryGet(ms, 1, v) then
  begin
    SetLength(v, 12);
    for i := 5 to 12 do
      v[i] := '-';
    WriteLn('string grown: ', v, ' map ', ms[1]);
  end;
  if TryGet(ms, 1, v) then
  begin
    v := v + '+';
    v[2] := 'Y';
    WriteLn('string appended: ', v, ' map ', ms[1]);
  end;

  if TryGet(mr, 1, r) then
  begin
    r.Name[1] := 'N';
    r.Tag[1] := 'T';
    SetLength(r.Tag, 1);
    WriteLn('record written: ', r.Name, ' ', r.Tag, ' map ', mr[1].Name, ' ', mr[1].Tag);
  end;

  if TryGet(ma, 'k', a) then
  begin
    a[0][1] := 'L';
    a[1][1] := 'R';
    WriteLn('array written: ', a[0], ' ', a[1], ' map ', ma['k'][0], ' ', ma['k'][1]);
  end;

  if TryGet(ts, 1, v) then
  begin
    v[1] := 'Z';
    WriteLn('tree written: ', v, ' tree ', ts[1]);
  end;

  { the copy's first character, then the map's: the map's value whole }
  if TryGet(ms, 1, v) and (v = 'abc5') then
    WriteLn('map value whole');
end.

