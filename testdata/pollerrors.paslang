program pollerrors;
uses sysutils, paslinux;
var
  handle, i, answer: Integer;
  joined: waitgroup;
  completed: Integer;
  descriptors: array[0..1] of Int32;
  byteValue: Byte;

procedure BadWait(Index: Integer);
var k, identity: Integer;
begin
  identity := Goid;
  Carry := Odd(Index);
  for k := 1 to 25 do
  begin
    if WaitMs(-1, 1, 1) <> -9 then Halt(10);
    if WaitMs(handle, 1, 1) <> -1 then Halt(11);
    Yield;
    if (Goid <> identity) or (Carry <> Odd(Index)) then Halt(12);
  end;
  AtomicAdd(@completed, 1);
  joined.Done;
end;

procedure WakeReader;
var value: Byte;
begin
  Sleep(20);
  value := 42;
  if OsWrite(descriptors[1], Integer(@value), 1) <> 1 then Halt(13);
  joined.Done;
end;

begin
  handle := FileCreate(ParamStr(1));
  if handle < 0 then Halt(2);
  for i := 1 to 100 do
  begin
    if WaitIo(-1, 1) <> -9 then Halt(3);
    if WaitIo(handle, 1) <> -1 then Halt(4); { regular files cannot enter epoll }
    if WaitMs(-1, 1, 1) <> -9 then Halt(5);
    if WaitMs(handle, 1, 1) <> -1 then Halt(6);
    GcCollect;
  end;
  joined.Add(64);
  for i := 1 to 64 do pas BadWait(i);
  joined.Wait;
  if completed <> 64 then Halt(14);
  FileClose(handle);
  Sleep(10); { failed waits left no live timer or stale armed token }
  if OsPipe(Integer(@descriptors[0])) <> 0 then Halt(15);
  joined.Add(1);
  pas WakeReader;
  if WaitIo(descriptors[0], 1) <> 0 then Halt(16); { real park returns success }
  if OsRead(descriptors[0], Integer(@byteValue), 1) <> 1 then Halt(17);
  if byteValue <> 42 then Halt(18);
  joined.Wait;
  if OsClose(descriptors[0]) <> 0 then Halt(19);
  if OsClose(descriptors[1]) <> 0 then Halt(20);
  WriteLn('poll errors 400');
  WriteLn('concurrent failures ', completed, ', valid wake');
end.
