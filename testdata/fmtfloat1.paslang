{ SysUtils' reals as text (P129): FloatToStr, FloatToStrF in its five
  formats, FormatFloat's sections, digits, separators, exponents and
  literals, Format's %e %f %g %n %m, and FloatToDecimal's digits and
  exponent, on values Free Pascal writes with the right digits (no tie,
  nothing past 17 digits); the output is Free Pascal 3.2.2's. }
program fmtfloat1;

uses sysutils;

const
  NV = 28;
  V: array[1..NV] of Double = (0, 1, -1, 1.5, 2.75, 10, 100, 1234.5678, -1234.5678, 0.001,
    0.0001234, 0.00001, 0.0000015, 123456789, 1e14, 1e15, 3.14159, -2.5e-10, 999999.999,
    12345678.9, -0.004, 7, 0.1, 0.3, 1e-7, -273.15, 1e20, 5e-5);
  NVF = 15;
  VF: array[1..NVF] of Double = (0, 1, -1, 1.5, 2.75, 10, 100, 1234.5678, -1234.5678,
    123456789, 1e14, 3.14159, 999999.999, 12345678.9, 7);
  NF = 21;
  FF: array[1..NF] of string = ('', '0', '0.00', '#.##', '#,##0.00', '#,##0.00;(#,##0.00)',
    '0.000E+00', '#.###E-0', '00000', '#,##0', '0.0##', '"x"0.0"y"', '0.00e+000', '##0.0E+0',
    '0.00;-0.00;"zero"', '#', '000.000', '0.###E+0', '#,##0.0;-#,##0.0;"nothing"', '''L''0.0',
    '0.0 "m/s"');

procedure ShowDec(Value: Double; Precision, Decimals: Integer);
var
  r: TFloatRec;
  i: Integer;
begin
  FloatToDecimal(r, Value, Precision, Decimals);
  Write('FloatToDecimal ', FloatToStr(Value), ' ', Precision, ' ', Decimals, ': ', r.Exponent, ' ',
    BoolToStr(r.Negative, True), ' [');
  i := 0;
  while (i <= 18) and (r.Digits[i] <> #0) do
  begin
    Write(r.Digits[i]);
    i := i + 1;
  end;
  WriteLn(']');
end;

var
  i, j: Integer;
  x: Double;
begin
  ShowDec(1234.5678, 15, 2);
  ShowDec(1234.5678, 3, 2);
  ShowDec(0.00123, 15, 4);
  ShowDec(-9.96, 2, 5);
  ShowDec(-9.96, 15, 0);
  ShowDec(0, 15, 2);
  ShowDec(1e20, 15, 0);
  ShowDec(0.006, 15, 2);
  ShowDec(-0.006, 15, 2);
  ShowDec(123456789.123, 18, 3);
  for i := 1 to NV do
  begin
    x := V[i];
    WriteLn('FloatToStr ', FloatToStr(x));
    WriteLn(' G5 ', FloatToStrF(x, ffGeneral, 5, 0), ' G10 ', FloatToStrF(x, ffGeneral, 10, 0),
      ' G15 ', FloatToStrF(x, ffGeneral, 15, 0));
    WriteLn(' E5.0 ', FloatToStrF(x, ffExponent, 5, 0), ' E5.2 ', FloatToStrF(x, ffExponent, 5, 2),
      ' E7.3 ', FloatToStrF(x, ffExponent, 7, 3), ' E3.4 ', FloatToStrF(x, ffExponent, 3, 4),
      ' E3.9 ', FloatToStrF(x, ffExponent, 3, 9));
    if Abs(x) < 1e17 then
    begin
      WriteLn(' F0 ', FloatToStrF(x, ffFixed, 15, 0), ' F2 ', FloatToStrF(x, ffFixed, 15, 2),
        ' F4 ', FloatToStrF(x, ffFixed, 15, 4), ' Fd ', FloatToStrF(x, ffFixed, 15, -1));
      WriteLn(' N2 ', FloatToStrF(x, ffNumber, 15, 2), ' N0 ', FloatToStrF(x, ffNumber, 15, 0),
        ' C2 ', FloatToStrF(x, ffCurrency, 15, 2), ' Cd ', FloatToStrF(x, ffCurrency, 15, -1));
      WriteLn(' ', Format('%.3e|%.4f|%.6g|%.2n|%.2m|%10.2f|%-10.1f|%.0f|', [x, x, x, x, x, x, x, x]));
    end;
  end;
  for i := 1 to NVF do
  begin
    x := VF[i];
    Write(FloatToStr(x), ':');
    for j := 1 to NF do
      Write(' [', FF[j], ']=', FormatFloat(FF[j], x));
    WriteLn;
  end;
end.

