program trig2;

begin
  WriteLn(Tan(0.0));
  WriteLn(Tan(0.5));
  WriteLn(Tan(1.0));
  WriteLn(Tan(-1.0));
  WriteLn(Cot(1.0));
  WriteLn(Cot(0.5));
  WriteLn(Sec(0.0));
  WriteLn(Sec(1.0));
  WriteLn(Csc(1.0));
  WriteLn(Csc(0.5));
  WriteLn(ArcTan2(1, 1));
  WriteLn(ArcTan2(1, -1));
  WriteLn(ArcTan2(-1, -1));
  WriteLn(ArcTan2(-1, 1));
  WriteLn(ArcTan2(1, 0));
  WriteLn(ArcTan2(-1, 0));
  WriteLn(ArcTan2(0, -1));
  WriteLn(ArcTan2(0, 0));
  WriteLn(ArcTan2(0.5, 0.5));
  WriteLn(ArcCot(1));
  WriteLn(ArcCot(0));
  WriteLn(ArcCot(-1));
  WriteLn(ArcCot(2));
  WriteLn(ArcSec(2));
  WriteLn(ArcSec(1));
  WriteLn(ArcSec(-2));
  WriteLn(ArcCsc(2));
  WriteLn(ArcCsc(1));
  WriteLn(ArcCsc(-2));
end.

