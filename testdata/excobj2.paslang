{ Exceptions with objects (P122), the edges: an except part puts back
  the object it replaced when it ends, by its end, an Exit, a Break or a
  Continue, so raise; in the handler around it raises that handler's
  object; a finally part that handles a raise of its own while another
  goes through lets the first go on; a raise from a function called in
  the middle of an expression; a method that raises; on E: TObject
  takes every object; many raises in a loop. The same source compiles
  with Free Pascal, whose output is the one expected. }
program excobj2;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  EA = class
    Tag: string;
    Num: Int64;
    constructor Create(const T: string);
  end;

  EB = class(EA)
  end;

  TCounter = class
    N: Int64;
    procedure Step(Limit: Int64);
  end;

constructor EA.Create(const T: string);
begin
  Tag := T;
end;

procedure TCounter.Step(Limit: Int64);
begin
  N := N + 1;
  if N > Limit then
    raise EB.Create('counter past the limit');
end;

function Half(X: Int64): Int64;
var
  e: EA;
begin
  if X mod 2 <> 0 then
  begin
    e := EA.Create('odd');
    e.Num := X;
    raise e;
  end;
  Result := X div 2;
end;

{ an inner handler ends: the outer one's raise; raises the outer object }
procedure InnerEnds;
begin
  try
    try
      raise EA.Create('outer object');
    except
      on E: EA do
      begin
        try
          raise EB.Create('inner object');
        except
          on I: EB do
            WriteLn('inner: ', I.Tag);
        end;
        raise;
      end;
    end;
  except
    on E: EA do
      WriteLn('InnerEnds re-raised: ', E.Tag);
  end;
end;

function LeaveByExit: Int64;
begin
  Result := 0;
  try
    raise EB.Create('left by exit');
  except
    on E: EB do
    begin
      Result := 1;
      Exit;
    end;
  end;
  Result := 2;
end;

{ an inner handler left by Exit, Break or Continue puts the outer
  object back too }
procedure InnerLeaves;
var
  i, r: Int64;
begin
  try
    try
      raise EA.Create('kept across exit');
    except
      on E: EA do
      begin
        r := LeaveByExit;
        WriteLn('LeaveByExit gave ', r);
        for i := 1 to 3 do
        begin
          try
            raise EB.Create('in loop');
          except
            on L: EB do
            begin
              if i = 1 then
                Continue;
              Break;
            end;
          end;
        end;
        WriteLn('loop ended at ', i);
        raise;
      end;
    end;
  except
    on E: EA do
      WriteLn('InnerLeaves re-raised: ', E.Tag);
  end;
end;

{ a finally part handles a raise of its own while another goes through }
procedure FinallyHandles;
begin
  try
    try
      raise EA.Create('going through');
    finally
      try
        raise EB.Create('handled in finally');
      except
        on E: EB do
          WriteLn('finally handled: ', E.Tag);
      end;
    end;
  except
    on E: EA do
      WriteLn('after finally: ', E.Tag);
  end;
end;

procedure InExpression;
var
  s: Int64;
  i: Int64;
begin
  s := 0;
  for i := 1 to 5 do
  begin
    try
      s := s + 100 * Half(i) + 1;
    except
      on E: EA do
        WriteLn('skipped: ', E.Tag, ' ', E.Num);
    end;
  end;
  WriteLn('sum ', s);
end;

procedure MethodRaises;
var
  c: TCounter;
  i: Int64;
begin
  c := TCounter.Create;
  try
    for i := 1 to 10 do
      c.Step(3);
  except
    on E: EB do
      WriteLn('method raised: ', E.Tag, ' at ', c.N);
  end;
end;

procedure AnyObject;
begin
  try
    raise TCounter.Create;
  except
    on E: EA do
      WriteLn('not an EA');
    on E: TObject do
      WriteLn('any object: ', E.ClassName);
  end;
end;

procedure Many;
var
  i, caught: Int64;
begin
  caught := 0;
  for i := 1 to 20000 do
  begin
    try
      if i mod 3 = 0 then
        raise EB.Create('many')
      else
        raise EA.Create('many');
    except
      on E: EB do
        caught := caught + 3;
      on E: EA do
        caught := caught + 1;
    end;
  end;
  WriteLn('caught ', caught);
end;

begin
  InnerEnds;
  InnerLeaves;
  FinallyHandles;
  InExpression;
  MethodRaises;
  AnyObject;
  Many;
  WriteLn('done');
end.

