program u32baseline;
var Calls: Integer; Guard: array[0..3] of Byte;

function UAdd(a, b: UInt32): UInt32;
begin
  Result := a + b;
end;

function USub(a, b: UInt32): UInt32;
begin
  Result := a - b;
end;

function UMul(a, b: UInt32): UInt32;
begin
  Result := a * b;
end;

function UAnd(a, b: UInt32): UInt32;
begin
  Result := a and b;
end;

function UOr(a, b: UInt32): UInt32;
begin
  Result := a or b;
end;

function UXor(a, b: UInt32): UInt32;
begin
  Result := a xor b;
end;

function UNeg(a: UInt32): UInt32;
begin
  Result := -a;
end;

function UNot(a: UInt32): UInt32;
begin
  Result := not a;
end;

function URol7(a: UInt32): UInt32;
begin
  Result := a rol 7;
end;

function URor13(a: UInt32): UInt32;
begin
  Result := a ror 13;
end;

function UShl7(a: UInt32): UInt32;
begin
  Result := a shl 7;
end;

function UShr7(a: UInt32): UInt32;
begin
  Result := a shr 7;
end;

function USar7(a: UInt32): UInt32;
begin
  Result := a sar 7;
end;

function UImm(a: UInt32): UInt32;
begin
  Result := a + $F2345678;
end;

function UMix(a, b: UInt32): UInt32;
begin
  Result := ((a + b) xor (a * b)) + ($F2345678 or (a ror 11));
end;

function WideAdd(a, b: UInt32): Integer;
begin
  Result := a + b;
end;

function UShl(a: UInt32; n: Integer): UInt32;
begin Result := a shl n; end;
function UShr(a: UInt32; n: Integer): UInt32;
begin Result := a shr n; end;
function USar(a: UInt32; n: Integer): UInt32;
begin Result := a sar n; end;
function UByte(a: UInt32; p: PByte): UInt32;
begin Result := a + p^; end;
function UHalf(a: UInt32; p: PWord): UInt32;
begin Result := a + p^; end;
function Pass(a: UInt32): UInt32;
begin Calls += 1; Result := a; end;
function CallAdd(a, b: UInt32): UInt32;
begin Result := Pass(a) + Pass(b); end;
function CallNot(a: UInt32): UInt32;
begin Result := not Pass(a); end;
function SignedAdd(a, b: Int32): Int32;
begin Result := a + b; end;
function MixedAdd(a: UInt32; b: Int32): Integer;
begin Result := a + b; end;
