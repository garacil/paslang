program narrowasm;

{ The cleanup of a narrow value is emitted only where it is needed (P100):
  NoClean stores a Byte sum into a Byte, which truncates, so it has none;
  Clean prints a Byte sum, which must be 0..255, so it has exactly one;
  Bump adds in memory at the Byte's width. make check greps the three. }

var
  a: array[0..3] of Byte;

procedure NoClean;
begin
  a[2] := a[0] + a[1];
end;

procedure Clean;
begin
  WriteLn(a[0] + a[1]);
end;

procedure Bump;
begin
  a[1] := a[1] + 1;
end;

begin
  a[0] := 200;
  a[1] := 100;
  NoClean;
  Clean;
  Bump;
  WriteLn(a[2], ' ', a[1]);
end.

