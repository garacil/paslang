{ P392: an element of a slice that is no register's is worked out from
  the slice's pointer and length alone, its capacity never read: a
  field's, a global's, a local's, a var parameter's and one through a
  pointer, read, written and by its address, the index checked against
  the length. scripts/check_slicehead.py reads the routines Addr* and
  HeadGlobal, whose elements' addresses EmitAddr works out: no r8 on
  amd64, where the capacity went, and an LDP of the pointer and the
  length on arm64, no x3. }
program slicehead;

type
  TBox = record
    Name: string;
    Vals: array of Integer;
    Bytes: array of Byte;
  end;
  PBox = ^TBox;

var
  g: array of Integer;
  box: TBox;
  i, total: Integer;

{ a field's element through a pointer, read and written }
function HeadField(P: PBox; I: Integer): Integer;
begin
  P^.Vals[I] := P^.Vals[I] + I;
  Result := P^.Vals[I] + P^.Bytes[I mod 16];
end;

{ a global's element and its address }
function HeadGlobal(I: Integer): Integer;
var
  q: ^Integer;
begin
  q := @g[I];
  q^ := q^ * 2;
  Result := g[I] + g[(I + 1) mod 10];
end;

{ addresses of elements alone, of a field through a pointer and of a var
  parameter's field: EmitAddr's own way, the pool's registers below r8 }
function AddrField(P: PBox; I: Integer): Integer;
var
  q: ^Integer;
begin
  q := @P^.Vals[I];
  q^ := q^ + 1;
  Result := q^;
end;

function AddrVar(var R: TBox; I: Integer): Integer;
var
  b: ^Byte;
begin
  b := @R.Bytes[I];
  b^ := Byte(b^ xor 5);
  Result := b^;
end;

{ a var parameter's element }
function HeadVar(var R: TBox; I: Integer): Integer;
begin
  R.Bytes[I] := Byte(R.Bytes[I] + 3);
  Result := R.Bytes[I] + R.Vals[0];
end;

{ a local's element, its index checked against the length }
function HeadLocal(N, I: Integer): Integer;
var
  v: array of Integer;
  k: Integer;
begin
  SetLength(v, N);
  for k := 0 to N - 1 do
    v[k] := k * k;
  Result := v[I] + v[N - 1 - I];
end;

begin
  SetLength(g, 10);
  for i := 0 to 9 do
    g[i] := i * 3 + 1;
  SetLength(box.Vals, 20);
  SetLength(box.Bytes, 16);
  for i := 0 to 19 do
    box.Vals[i] := 100 - i;
  for i := 0 to 15 do
    box.Bytes[i] := Byte(i * 17);
  total := 0;
  for i := 0 to 19 do
    total := total + HeadField(@box, i);
  WriteLn('field ', total);
  for i := 0 to 9 do
    total := total + HeadGlobal(i);
  WriteLn('global ', total);
  for i := 0 to 15 do
    total := total + HeadVar(box, i);
  WriteLn('var ', total);
  for i := 0 to 15 do
    total := total + AddrField(@box, i) + AddrVar(box, i);
  WriteLn('addr ', total);
  WriteLn('local ', HeadLocal(5, 4), ' ', HeadLocal(9, 2), ' ', HeadLocal(1, 0));
end.
