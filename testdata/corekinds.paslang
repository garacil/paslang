program corekinds;
uses sysutils;
const Kinds: array[0..19] of Integer =
  (vtInteger, vtBoolean, vtChar, vtExtended, vtString, vtPointer,
   vtPChar, vtObject, vtClass, vtWideChar, vtPWideChar, vtAnsiString,
   vtCurrency, vtVariant, vtInterface, vtWideString, vtInt64, vtQWord,
   vtUnicodeString, vtQuad);
var i: Integer;
begin
  for i := 0 to High(Kinds) do
    if Kinds[i] <> i then Halt(1);
  WriteLn('all TVarRec kinds remain predefined after uses SysUtils');
end.
