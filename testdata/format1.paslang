{ SysUtils' Format (P129): every directive Free Pascal 3.2.2 has, with
  an index, a width, a precision, left alignment and * from the list;
  FmtStr, Exception.CreateFmt, and the errors with Free Pascal's
  messages. The output is Free Pascal 3.2.2's. }
program format1;

{$mode objfpc}{$H+}

uses sysutils;

procedure Bad(const F: string; const A: array of const);
begin
  try
    WriteLn(Format(F, A));
  except
    on e: EConvertError do
      WriteLn(e.ClassName, ': ', e.Message);
  end;
end;

var
  s, t: string;
  c: Char;
  p: PChar;
  e: Exception;
begin
  WriteLn(Format('%d|%5d|%-5d|%.4d|%.3d|%5.3d|%-6.2d|%d|', [42, 42, 42, 42, -7, 7, 3, 0]));
  WriteLn(Format('%d|%d|%.20d|', [9223372036854775807, -9223372036854775807, 12345]));
  WriteLn(Format('%u|%x|%.8x|%X|%10x|%-10x|%x|', [42, 255, 255, 48879, 4095, 4095, 0]));
  WriteLn(Format('%s|%10s|%-6s|%.2s|%5.1s|%s|', ['abc', 'abc', 'ab', 'xyz', 'hello', '']));
  c := 'Q';
  { FPC scans a PChar without a bound; paslang makes that conversion
    explicit through a typed, terminated buffer before formatting. }
  s := 'a pchar' + #0;
  p := PChar(s);
  {$ifdef FPC}
  WriteLn(Format('%s%s|%3s|%s|%-9s|%.3s|', [c, 'd', c, p, p, p]));
  {$else}
  s := StrPas(BytesOf(s));
  WriteLn(Format('%s%s|%3s|%s|%-9s|%.3s|', [c, 'd', c, s, s, s]));
  {$endif}
  WriteLn(Format('%1:s %0:s %s %s', ['a', 'b', 'c']));
  WriteLn(Format('%3:s%2:s%1:s%0:s|%0:s%s', ['a', 'b', 'c', 'd']));
  WriteLn(Format('%:s %s', ['x', 'y']));
  WriteLn(Format('%*d|%-*d|%.*f|%*.*f|%*s|', [5, 42, 4, 7, 2, 3.14159, 8, 3, 2.5, 6, 'r']));
  WriteLn(Format('100%% %s%%', ['sure']));
  WriteLn(Format('%f|%.1f|%.0f|%n|%.3n|%m|%.0m|', [1234.5678, 1234.5678, 0.4, 1234567.891, 1234567.891, 99.99, 12.3]));
  WriteLn(Format('%.3e|%.2e|%.10e|%.3g|%.10g|%.1g|', [1234.5678, 1e-10, 3.14159, 1234.5678, 1234.5678, 0.07]));
  WriteLn(Format('%8.2f|%-8.2f|%08.2f|', [3.14159, 3.14159, 3.14159]));
  WriteLn(Format('no directives', []), '|', Format('', []), '|', Format('%', [1]), '|', Format('abc%', [1]));
  FmtStr(t, '%d-%s-%.2f', [1, 'two', 3.0]);
  WriteLn(t);
  e := Exception.CreateFmt('bad %s at %d', ['thing', 7]);
  WriteLn(e.Message);
  e.Free;
  e := Exception.CreateFmtHelp('help %d', [9], 33);
  WriteLn(e.Message, ' ', e.HelpContext);
  e.Free;
  Bad('%d %d', [1]);
  Bad('%s', [1]);
  Bad('%d', ['x']);
  Bad('%f', [1]);
  Bad('%5', [1]);
  Bad('%-', [1]);
  Bad('%*d', ['x', 1]);
  Bad('%9:d', [1]);
  Bad('%.*f', [1.5, 2.0]);
end.

