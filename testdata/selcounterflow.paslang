{ A captured for-counter's changes steer the loop even when a select arm
  continues or breaks. Plain controls and default/send/receive arms; the
  former CellCopy walker never reached Sels[].Body. }
program selcounterflow;

type TGen = function: Integer;

procedure CaseContinue(Mode: Integer);
var i, value, passes: Integer; c: chan of Integer; saved: TGen;
begin
  c := MakeChan(8);
  passes := 0;
  for i := 0 to 4 do
  begin
    saved := function: Integer begin Result := i; end;
    case Mode of
      0:
        begin
          i := i + 1;
          passes := passes + 1;
          continue;
        end;
      1:
        select
        else
          begin
            i := i + 1;
            passes := passes + 1;
            continue;
          end;
        end;
      2:
        select
          Send(c, 1):
            begin
              i := i + 1;
              passes := passes + 1;
              continue;
            end;
        end;
      3:
        begin
          Send(c, 1);
          select
            Recv(c, value):
              begin
                i := i + 1;
                passes := passes + 1;
                continue;
              end;
          end;
        end;
    end;
  end;
  WriteLn('continue ', Mode, ': ', passes, ' ', saved());
end;

procedure CaseBreak(Mode: Integer);
var i, value: Integer; c: chan of Integer; saved: TGen;
begin
  c := MakeChan(8);
  for i := 0 to 4 do
  begin
    saved := function: Integer begin Result := i; end;
    case Mode of
      0:
        begin
          i := 3;
          break;
        end;
      1:
        select
        else
          begin
            i := 3;
            break;
          end;
        end;
      2:
        select
          Send(c, 1):
            begin
              i := 3;
              break;
            end;
        end;
      3:
        begin
          Send(c, 1);
          select
            Recv(c, value):
              begin
                i := 3;
                break;
              end;
          end;
        end;
    end;
  end;
  WriteLn('break ', Mode, ': ', i, ' ', saved());
end;

var mode: Integer;
begin
  for mode := 0 to 3 do CaseContinue(mode);
  for mode := 0 to 3 do CaseBreak(mode);
end.

