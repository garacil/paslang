program realint;

{ Reals into Integers at their edges (1.0.112): -2^63 is the one real
  that gives the lowest Integer; large values in range convert exactly;
  Round sends a tie to the even one; Floor and Ceil of negatives; Sqrt
  of -0 is -0 and of a NaN a NaN; the same on both machines. }

var
  m, big, x, z, nan: Double;
  s: Single;

begin
  m := -9223372036854775808.0;
  WriteLn(Trunc(m), ' ', Round(m), ' ', Floor(m), ' ', Ceil(m));
  big := 9223372036854774784.0;
  WriteLn(Trunc(big), ' ', Round(big), ' ', Floor(big), ' ', Ceil(big));
  WriteLn(Trunc(-big), ' ', Round(-big), ' ', Floor(-big), ' ', Ceil(-big));
  WriteLn(Round(0.5), ' ', Round(1.5), ' ', Round(-0.5), ' ', Round(-1.5));
  x := -2.5;
  WriteLn(Trunc(x), ' ', Round(x), ' ', Floor(x), ' ', Ceil(x));
  x := 2.5;
  WriteLn(Trunc(x), ' ', Round(x), ' ', Floor(x), ' ', Ceil(x));
  s := -3.75;
  WriteLn(Trunc(s), ' ', Round(s), ' ', Floor(s), ' ', Ceil(s));
  z := 0.0;
  z := -z;
  WriteLn(Sqrt(z));
  nan := z / z;
  WriteLn(Sqrt(nan));
  s := Single(z);
  WriteLn(Sqrt(s));
end.

