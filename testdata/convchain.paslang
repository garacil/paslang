program convchain;

{ Conversions inside conversions (1.0.116): a narrowing inside a
  widening keeps its own work. Integer(Byte(i)) relabelled the Byte
  conversion, which then did nothing: it gave 300 for 300. Ord of a
  constant is a constant with no type (b := Ord('X') was refused). }

const
  C = 'X';

var
  i: Integer;
  b: Byte;
  s8: Int8;
  w: Word;

begin
  i := 300;
  WriteLn(Integer(Byte(i)), ' ', Integer(Int8(i)), ' ', Int64(Word(i + 70000)));
  b := 72;
  WriteLn(Integer(Int8(b)), ' ', Integer(Int8(b * 2)), ' ', Ord(Int8(b * 2)), ' ', Ord(Byte(i)));
  s8 := -128;
  WriteLn(Ord(-s8), ' ', Integer(-s8), ' ', Int8(-s8), ' ', Integer(Int8(-s8)));
  w := Word(Byte(i) + 1000);
  WriteLn(w, ' ', Word(Int8(i)), ' ', UInt32(Int16(Word(i * 200))));
  b := 255;
  WriteLn(Ord(b + 1), ' ', Integer(Byte(b + 1)), ' ', Integer(b + 1));
  { Ord of a constant is a constant with no type: it fits a Byte. }
  b := Ord('X');
  w := Ord(C) + 1;
  s8 := Ord(True);
  WriteLn(b, ' ', w, ' ', s8);
end.

