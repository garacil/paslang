{ P211: strings and names with escapes undone in place by a typed decode
  (ParseStrEsc, Unesc, JHexTab), from a whole text and from a source
  that gives one byte at a time, where every escape and closing quote
  comes in a read of its own; and the errors of a bad escape, a bad \u
  digit, a lone and a reversed surrogate, an escaped noncharacter, a raw
  byte that is no UTF-8 beside an escape, a name twice by an escape, and
  an object of 70 names, plain and escaped, past JsonLinear, with a twin
  by an escape either way and without. Each decode's record written
  again, or its error; the two ways alike. }
program jsondecesc;

uses SysUtils;

type
  TItem = record
    Name: string json 'name';
    Text: string json 'text';
    Tags: array of string json 'tags';
  end;

const
  KindName: array[TJsonErrorKind] of string = ('syntax', 'encoding', 'duplicate', 'depth',
    'too large', 'missing', 'type', 'range', 'unknown', 'test', 'io');

var
  src: string;
  at, i: Integer;
  wide: string;

{ the source: a byte at a time }
function Bytes: string;
begin
  Result := '';
  if at <= Length(src) then
  begin
    Result := src[at];
    at := at + 1;
  end;
end;

function FromText(const S: string): string;
var
  it: TItem;
begin
  it := Default(TItem);
  try
    JsonDecode(S, it);
    Result := JsonEncode(it);
  except
    on x: EJsonError do
      Result := KindName[x.Kind] + ': ' + x.Message;
  end;
end;

function FromSource(const S: string): string;
var
  it: TItem;
  r: TJsonReader;
begin
  it := Default(TItem);
  src := S;
  at := 1;
  r := JsonReader(@Bytes);
  try
    if JsonRead(r, it) then
      Result := JsonEncode(it)
    else
      Result := 'nothing read';
  except
    on x: EJsonError do
      Result := KindName[x.Kind] + ': ' + x.Message;
  end;
end;

procedure Show(const Label_, S: string);
var
  a, b: string;
begin
  a := FromText(S);
  b := FromSource(S);
  Write(Label_, ': ', a);
  if b <> a then
    Write(' | from a source: ', b);
  WriteLn;
end;

begin
  Show('every escape', '{"name":"a\"b\\c\/d\b\f\n\r\t","text":"\u00e9\u4E2D\ud83d\ude00",' +
    '"tags":["x\u0041y","\u0000","plain"]}');
  Show('names escaped', '{"n\u0061me":"v","\u0074ext":"w","t\u0061g\u0073":[]}');
  Show('long', '{"name":"' + StringOfChar('a', 300) + '\u0062' + StringOfChar('c', 300) +
    '","text":"\\\\\\\\"}');
  Show('a bad escape', '{"name":"a\x"}');
  Show('a bad digit', '{"name":"\u12G4"}');
  Show('a lone surrogate', '{"name":"\ud800"}');
  Show('reversed surrogates', '{"name":"\udc00\ud800"}');
  Show('an escaped noncharacter', '{"name":"\ufdd0"}');
  Show('a raw byte beside an escape', '{"name":"\n' + #255 + '"}');
  Show('a name twice by an escape', '{"name":"a","n\u0061me":"b"}');
  wide := '{"name":"w"';
  for i := 0 to 69 do
    if i mod 3 = 0 then
      wide := wide + ',"\u006b' + IntToStr(i) + '":' + IntToStr(i)
    else
      wide := wide + ',"k' + IntToStr(i) + '":' + IntToStr(i);
  Show('seventy names', wide + '}');
  Show('seventy names and a plain twin', wide + ',"k6":0}');
  Show('seventy names and an escaped twin', wide + ',"\u006b5":0}');
end.
