{ P327: a for loop whose counter lives at its home, its body calling,
  reads the counter once a pass: the test leaves it in a register for
  the step. Its home stays current for the routines the body calls,
  continue and break leave it as before, a limit the body writes was
  read once, before the loop, and it goes down and in narrow types the
  same. The answers are worked out by hand in the comments. }
program forstep;

uses paslib;

var
  gi, seen: Integer;
  gb: Byte;

{ reads the global counter: its home holds this pass's value }
procedure Look;
begin
  seen := seen * 3 + gi;
end;

function Id(K: Integer): Integer;
begin
  Result := K;
end;

procedure Locals;
var
  i, n, s: Integer;
  b: Int8;
begin
  { 1 + 2 + 4 + 5 + 6 + 7, i 8 at the break }
  s := 0;
  for i := 1 to 10 do
  begin
    if i = 3 then
      Continue;
    if i = 8 then
      Break;
    s := s + Id(i);
  end;
  WriteLn(s, ' ', i);
  { the limit read once: 1 to 5, n 2 after }
  n := 5;
  s := 0;
  for i := 1 to n do
  begin
    n := 2;
    s := s + Id(i);
  end;
  WriteLn(s, ' ', i, ' ', n);
  { down: 10 to 1, s := s * 3 + i mod 7 }
  s := 0;
  for i := 10 downto 1 do
    s := s * 3 + Id(i) mod 7;
  WriteLn(s, ' ', i);
  { Int8 from -128 to -120: the sum -1116 }
  s := 0;
  for b := -128 to -120 do
    s := s + Id(b);
  WriteLn(s, ' ', b);
end;

begin
  Locals;
  { the global counter read by Look each pass: 0, 1, 5, 18, 58 }
  seen := 0;
  for gi := 1 to 4 do
    Look;
  WriteLn(seen, ' ', gi);
  { a Byte up to 255: 250 + ... + 255 = 1515, gb 255 at the end }
  seen := 0;
  for gb := 250 to 255 do
    seen := seen + Id(gb);
  WriteLn(seen, ' ', gb);
end.

