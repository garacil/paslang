{ String = and the order of strings (P136) held to a byte-by-byte
  reference: every length to 150, the two strings equal, one a prefix
  of the other, and differing at each byte by a byte above and below,
  the bytes 0 and 255 among them; the same bytes at other addresses
  and the same string on both sides. Run under -cpu native and -cpu
  base on both machines. }
program strcmpk;

var
  a, b: string;
  len, k, i, bad, n, r, want: Integer;
  seed: Integer;

function Next: Integer;
begin
  seed := (seed * 1103515245 + 12345) and $7fffffff;
  Result := seed shr 8;
end;

function RefCmp(const X, Y: string): Integer;
var
  i, m: Integer;
begin
  m := Length(X);
  if Length(Y) < m then
    m := Length(Y);
  for i := 1 to m do
    if X[i] <> Y[i] then
    begin
      if Ord(X[i]) < Ord(Y[i]) then
        Result := -1
      else
        Result := 1;
      Exit;
    end;
  if Length(X) < Length(Y) then
    Result := -1
  else if Length(X) > Length(Y) then
    Result := 1
  else
    Result := 0;
end;

procedure Pair(const X, Y: string);
begin
  want := RefCmp(X, Y);
  r := 0;
  if X < Y then
    r := -1
  else if X > Y then
    r := 1;
  if (r <> want) or ((X = Y) <> (want = 0)) or ((X <> Y) <> (want <> 0)) or
    ((X <= Y) <> (want <= 0)) or ((X >= Y) <> (want >= 0)) then
  begin
    bad := bad + 1;
    if bad < 5 then
      WriteLn('bad ', Length(X), ' ', Length(Y), ' ', want, ' ', r);
  end;
  n := n + 1;
end;

begin
  bad := 0;
  n := 0;
  seed := 11;
  for len := 0 to 150 do
  begin
    a := '';
    for i := 1 to len do
      a := a + Chr(Next and 255);
    b := Copy(a, 1, len);
    Pair(a, b);
    Pair(a, a);
    Pair(a, b + 'x');
    Pair(b + 'x', a);
    Pair(a + #0, b);
    for k := 1 to len do
    begin
      b := Copy(a, 1, len);
      if Ord(b[k]) < 255 then
      begin
        b[k] := Chr(Ord(b[k]) + 1);
        Pair(a, b);
        Pair(b, a);
      end;
      b := Copy(a, 1, len);
      if Ord(b[k]) > 0 then
      begin
        b[k] := Chr(Ord(b[k]) - 1);
        Pair(a, b);
        Pair(b, a);
      end;
      b := Copy(a, 1, len);
      b[k] := #0;
      Pair(a, b);
      b[k] := #255;
      Pair(b, a);
    end;
  end;
  WriteLn(bad, ' bad of ', n);
end.

