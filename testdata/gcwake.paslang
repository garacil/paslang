{ P337: with a cap on the collector's workers, every M a cycle may mark
  with marks. Eight trees of depth 13 stay alive, so each cycle has
  work for several workers; the cycles run until twenty have marked
  with every one the cap allows (HeapStat(14) against HeapStat(15)), up
  to two thousand. With PASLANG_GCWORKERS=2 none did: the first idle M
  the wake picked was the one that polls, or one with no thread yet,
  and the wake reached nobody. }
program gcwake;

uses
  paslib;

type
  PNode = ^TNode;
  TNode = record
    L, R: PNode;
    Name: string;
    V: Integer;
  end;

var
  trees: array of PNode;
  i, k, full, alive: Integer;

function MakeTree(Depth, V: Integer): PNode;
var
  p: PNode;
begin
  New(p);
  p^.V := V;
  p^.Name := 'n' + IntToStr(V);
  if Depth > 0 then
  begin
    p^.L := MakeTree(Depth - 1, V * 2);
    p^.R := MakeTree(Depth - 1, V * 2 + 1);
  end;
  Result := p;
end;

function Count(P: PNode): Integer;
begin
  Result := 0;
  if P <> nil then
    Result := 1 + Count(P^.L) + Count(P^.R);
end;

begin
  SetLength(trees, 8);
  for i := 0 to 7 do
    trees[i] := MakeTree(13, i + 1);
  full := 0;
  k := 0;
  while (full < 20) and (k < 2000) do
  begin
    k := k + 1;
    GcCollect;
    if HeapStat(14) >= HeapStat(15) then
      full := full + 1;
  end;
  alive := 0;
  for i := 0 to 7 do
    alive := alive + Count(trees[i]);
  { 8 trees of 16383 nodes }
  WriteLn('nodes ', alive);
  WriteLn('cycles with every worker ', full);
end.
