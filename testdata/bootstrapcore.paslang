{$mode objfpc}{$H+}
program bootstrapcore;
uses paslib, paslinux;
var value, item: string; i, count: Integer;
begin
  if IntToStr(-9223372036854775807 - 1) <> '-9223372036854775808' then Halt(2);
  if IntToStr(9223372036854775807) <> '9223372036854775807' then Halt(3);
  if (IntToStr(0) <> '0') or (IntToStr(-17) <> '-17') then Halt(4);
  if not LookupEnv('PASLANG_ENV_CASE', value) or (value <> 'first') then Halt(5);
  if not LookupEnv('PASLANG_ENV_EMPTY', value) or (value <> '') then Halt(6);
  if LookupEnv('missing', value) or (value <> '') then Halt(7);
  if LookupEnv('', value) or LookupEnv('a=b', value) or LookupEnv('key'#0, value) then Halt(8);
  value := GetEnv('PASLANG_ENV_LONG');
  if (Length(value) <> 65000) or (value[1] <> 'x') or (value[65000] <> 'Z') then Halt(9);
  count := ProcessEnvironmentCount;
  for i := 1 to count do
  begin
    item := ProcessEnvironmentEntry(i);
    value := item;
    if value <> '' then value[1] := '!';
    if ProcessEnvironmentEntry(i) <> item then Halt(10);
  end;
  if (ProcessEnvironmentEntry(0) <> '') or (ProcessEnvironmentEntry(count + 1) <> '') then Halt(11);
  WriteLn('bootstrap integer limits and immutable environment');
end.
