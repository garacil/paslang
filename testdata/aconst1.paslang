{ array of const (P124): a list in brackets of values of every simple
  kind, the kind and the value each; an empty list; the list passed on
  to another routine; a list built inside another list's element; a
  list given to a method; a long list; values worked out by calls that
  allocate. The same source compiles with Free Pascal, whose output is
  the one expected; the real and the string lie in the record itself in
  paslang, where Free Pascal points at them. }
program aconst1;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  TDay = (Mon, Tue, Wed);

  TA = class
    N: Integer;
    procedure Take(const Args: array of const);
  end;

  TB = class(TA)
  end;

procedure Show(const Args: array of const);
var
  i: Integer;
begin
  Write(Length(Args), ' [', Low(Args), '..', High(Args), ']');
  for i := 0 to High(Args) do
    case Args[i].VType of
      vtInteger:
        Write(' int ', Args[i].VInteger);
      vtBoolean:
        Write(' bool ', Ord(Args[i].VBoolean));
      vtChar:
        Write(' char ', Args[i].VChar);
      vtExtended:
{$ifdef PASLANG}
        Write(' real ', Args[i].VExtended:0:3);
{$else}
        Write(' real ', Args[i].VExtended^:0:3);
{$endif}
      vtAnsiString:
{$ifdef PASLANG}
        Write(' str ', Args[i].VAnsiString);
{$else}
        Write(' str ', AnsiString(Args[i].VAnsiString));
{$endif}
      vtPointer:
        Write(' ptr ', Ord(Args[i].VPointer = nil));
      vtObject:
        Write(' obj ', Args[i].VObject.ClassName);
      vtClass:
        Write(' class ', Args[i].VClass.ClassName);
    else
      Write(' kind ', Args[i].VType);
    end;
  WriteLn;
end;

function Count(const Args: array of const): Integer;
begin
  Result := Length(Args);
end;

procedure PassOn(const Args: array of const);
begin
  Write('passed on: ');
  Show(Args);
end;

procedure TA.Take(const Args: array of const);
begin
  N := Count(Args);
  Write(ClassName, ' takes ');
  Show(Args);
end;

function Nth(I: Integer): string;
begin
  Result := 'w' + Chr(Ord('a') + I);
end;

var
  b: Byte;
  i16: SmallInt;
  i: Integer;
  s: string;
  c: Char;
  d: Double;
  sg: Single;
  p: Pointer;
  o: TA;
  bo: Boolean;
  day: TDay;

begin
  b := 200;
  i16 := -300;
  i := 123456;
  s := 'text';
  c := 'q';
  d := 2.5;
  sg := 0.25;
  p := nil;
  o := TB.Create;
  bo := True;
  day := Wed;
  Show([]);
  Show([b, i16, i, 7, -8]);
  Show([s, 'literal', c, 'x', s + '!']);
  Show([d, sg, 1.125]);
  Show([bo, False, p, nil, day]);
  Show([o, TA, TB]);
  PassOn([1, 'two', 3.0]);
  Show([Count([1, 2, 3]), Count([]), Count(['a', 'b'])]);
  o.Take(['method', o.N, TA]);
  Show([Nth(0), Nth(1), Nth(2), Nth(3), Nth(4), Nth(5), Nth(6), Nth(7),
    Nth(8), Nth(9), Nth(10), Nth(11), Nth(12), Nth(13), Nth(14), Nth(15),
    Nth(16), Nth(17), Nth(18), Nth(19), Nth(20), Nth(21), Nth(22), Nth(23)]);
end.

