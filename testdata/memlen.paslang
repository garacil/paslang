{ P324: a bounds check against a slice's length at its home is kept as
  one against a register: Rotate reads and then writes an element of six
  global slices at a time, one check each in its checked body, and Pair
  reads and writes two in a row with no loop. scripts/check_chkcse.py
  counts the checks. Written by a script; the answers are Python's. }
program memlen;

type
  TArr = array of Integer;

var
  a, b, c, d, e, f: TArr;

procedure Fill(n: Integer);
var
  k: Integer;
begin
  SetLength(a, n);
  SetLength(b, n);
  SetLength(c, n);
  SetLength(d, n);
  SetLength(e, n);
  SetLength(f, n);
  for k := 0 to n - 1 do
  begin
    a[k] := k;
    b[k] := k * 3;
    c[k] := 100 - k;
    d[k] := k xor 9;
    e[k] := k and 7;
    f[k] := 2 * k + 1;
  end;
end;

function Rotate(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to n - 1 do
  begin
    a[k] := a[k] + b[k];
    b[k] := b[k] xor c[k];
    c[k] := c[k] - d[k];
    d[k] := d[k] + e[k];
    e[k] := e[k] * 3 + f[k];
    f[k] := f[k] + a[k];
    t := t + a[k] - f[k];
  end;
  Result := t;
end;

function Pair(k: Integer): Integer;
begin
  a[k] := a[k] + 1;
  b[k] := a[k] * 2;
  Result := a[k] + b[k];
end;

begin
  Fill(50);
  WriteLn(Rotate(50), ' ', Rotate(50), ' ', Pair(7), ' ', Pair(49));
  Fill(3000);
  WriteLn(Rotate(3000), ' ', Pair(0), ' ', Pair(2999));
end.
