{ P567: the runtime's checked failures as exceptions. With SysUtils in the
  program a failure inside a try is raised as the class Free Pascal gives
  it, its Message the line the runtime writes without paslang: in front.
  Every kind is caught here (an index of a static array, of a dynamic one
  and of a string, a division and a remainder by zero, a set's element, a
  bit's number, a real out of Integer's range, a square root and a
  logarithm out of their domains, as, the 128-bit quotient, logic and a
  funnel on two lengths, the Quad forms), by its
  class, by an ancestor, by a bare except, passed on by a handler of
  another class, raised again, with a finally on the way; a handler reads
  the variables a loop or a straight run kept in registers as they were at
  the failure, whichever check failed (LoopKinds has a loop for each, and
  Found the three shapes scripts/fuzz_faults.py found wrong: a run of
  statements with no call, a loop of four passes the compiler writes out
  pass by pass, and a value worked out in its variable's own register;
  and Vectors a vector); Directs calls SysFault as the
  runtime does, for each shape of Message and each class; a failure in a
  routine called is taken by the caller; a lock
  block is left unlocked; a routine started with pas takes its own.

  With two arguments it dies of kind K instead, for the recipe to compare
  the runtime's own line with the Message printed here: die K with no try
  at all (the runtime stops the program as it always did), fin K inside a
  try with a finally and no handler (finally runs, then the line), pas K
  the same in a routine started with pas (the program ends with the line
  from that routine too). }
program faults;

uses
  sysutils;

type
  TFive = array[0..4] of Int64;
  TSmall = set of 2..7;
  TShape = class
    function Area: Int64; virtual;
  end;
  TOther = class
  end;
  PNode = ^TNode;
  TNode = record
    V: Int64;
    Next: PNode;
  end;

var
  five: TFive;
  zero, big, dieK: Int64;
  mu: mutex;
  wg: waitgroup;
  got: string;
  va: array[0..3] of V128;

function TShape.Area: Int64;
begin
  Result := 1;
end;

{ One failure of kind K. zero and big are set when the program runs, so
  nothing here is worked out by the compiler. }
procedure Fail(K: Int64);
var
  d: array of Int64;
  s, t: string;
  st: TSmall;
  b: Byte;
  q, r: Int64;
  x: Double;
  qd: Quad;
  o: TObject;
  sh: TShape;
begin
  q := 0;
  case K of
    1:
      five[big] := 1;
    2:
      begin
        SetLength(d, 3);
        d[big] := 1;
      end;
    3:
      begin
        s := 'abc';
        q := Ord(s[big]);
      end;
    4:
      q := 7 div zero;
    5:
      q := 7 mod zero;
    6:
      begin
        st := [3];
        Include(st, zero + 1);
        q := Ord(3 in st);
      end;
    7:
      begin
        b := 5;
        q := Ord(IsBitSet(b, big));
      end;
    8:
      begin
        x := 1e19 + zero;
        q := Trunc(x);
      end;
    9:
      begin
        x := -1.0 - zero;
        x := Sqrt(x);
        q := Trunc(x);
      end;
    10:
      begin
        x := zero;
        x := Ln(x);
        q := Trunc(x);
      end;
    11:
      begin
        o := TOther.Create;
        sh := o as TShape;
        q := sh.Area;
      end;
    12:
      DivMod128(5 + zero, 0, 5, q, r);
    13:
      DivMod128(0, 7, zero, q, r);
    14:
      begin
        s := 'abc';
        t := 'ab' + 'cd';
        s := s xor t;
        q := Length(s);
      end;
    15:
      begin
        s := 'abc';
        t := 'ab' + 'cd';
        s := FunnelLeft(s, t, 3);
        q := Length(s);
      end;
    16:
      begin
        qd := Quad(-2) - zero;
        qd := Sqrt(qd);
        q := Trunc(qd);
      end;
    17:
      begin
        qd := Quad(1e30) + zero;
        q := Trunc(qd);
      end;
  end;
  WriteLn('kind ', K, ' did not fail: ', q);
end;

{ Kind K caught as an Exception: its class, and its Message as the runtime
  would have written it. }
procedure Caught(K: Int64);
begin
  try
    Fail(K);
  except
    on E: Exception do
    begin
      WriteLn('kind ', K, ' ', E.ClassName);
      WriteLn('paslang: ', E.Message);
    end;
  end;
end;

procedure ByClass;
begin
  try
    Fail(1);
  except
    on E: ERangeError do
      WriteLn('an index is an ERangeError');
  end;
  try
    Fail(4);
  except
    on E: EDivByZero do
      WriteLn('a division by zero is an EDivByZero');
  end;
  try
    Fail(5);
  except
    on E: EIntError do
      WriteLn('and an EIntError');
  end;
  try
    Fail(8);
  except
    on E: EMathError do
      WriteLn('a real out of range is an EMathError');
  end;
  try
    Fail(11);
  except
    on E: EInvalidCast do
      WriteLn('as is an EInvalidCast');
  end;
  try
    Fail(12);
  except
    on E: EIntOverflow do
      WriteLn('a quotient past 64 bits is an EIntOverflow');
  end;
  try
    Fail(6);
  except
    on E: EExternal do
      WriteLn('every one is an EExternal but as');
  end;
  { a bare except takes it }
  try
    Fail(1);
  except
    WriteLn('a bare except takes it');
  end;
  { a handler of another class lets it pass }
  try
    try
      Fail(1);
    except
      on E: EConvertError do
        WriteLn('not here');
    end;
  except
    on E: ERangeError do
      WriteLn('passed on to the handler outside');
  end;
  { raise; raises it again }
  try
    try
      Fail(4);
    except
      on E: EDivByZero do
      begin
        WriteLn('taken once');
        raise;
      end;
    end;
  except
    on E: Exception do
      WriteLn('and again: ', E.ClassName);
  end;
  { a finally on the way runs }
  try
    try
      Fail(1);
    finally
      WriteLn('finally runs');
    end;
  except
    on E: Exception do
      WriteLn('then the handler: ', E.ClassName);
  end;
  { the handler's own failure goes to the next one out }
  try
    try
      Fail(1);
    except
      on E: ERangeError do
        Fail(4);
    end;
  except
    on E: Exception do
      WriteLn('a failure in a handler: ', E.ClassName);
  end;
  { ExceptObject is the fault while its handler runs }
  try
    Fail(4);
  except
    WriteLn('ExceptObject: ', ExceptObject.ClassName, ' ', ExceptAddr <> nil);
  end;
end;

{ What a handler reads of the variables a loop kept in registers: their
  values at the failure. }
procedure LoopVars;
var
  i, n, sum, k: Int64;
begin
  for i := 0 to 4 do
    five[i] := 10 * (i + 1);
  n := 0;
  sum := 0;
  try
    for i := 0 to 9 do
    begin
      sum := sum + five[i];
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('for: i=', i, ' n=', n, ' sum=', sum);
  end;
  i := 0;
  n := 100;
  sum := 0;
  try
    while True do
    begin
      sum := sum + five[i] * 2;
      i := i + 1;
      n := n - 1;
    end;
  except
    on E: ERangeError do
      WriteLn('while: i=', i, ' n=', n, ' sum=', sum);
  end;
  { the divisor reaches zero in the fourth pass }
  n := 0;
  sum := 0;
  k := 3;
  try
    repeat
      sum := sum + 60 div k;
      k := k - 1;
      n := n + 1;
    until n = 10;
  except
    on E: EDivByZero do
      WriteLn('repeat: k=', k, ' n=', n, ' sum=', sum);
  end;
  { two loops, the failure in the inner one }
  n := 0;
  sum := 0;
  try
    for i := 0 to 3 do
      for k := 0 to i + 2 do
      begin
        sum := sum + five[k];
        n := n + 1;
      end;
  except
    on E: ERangeError do
      WriteLn('nested: i=', i, ' k=', k, ' n=', n, ' sum=', sum);
  end;
end;

{ And of a straight run: x and y were written before the failure, w and v
  after it, so they keep what they had. }
procedure Straight;
var
  x, y, z, w, v, k: Int64;
begin
  k := big;
  w := 1;
  v := 7;
  x := 0;
  y := 0;
  try
    x := w + 2;
    y := x * 3;
    z := five[k];
    v := 9;
    w := z + y;
  except
    on E: ERangeError do
      WriteLn('straight: x=', x, ' y=', y, ' w=', w, ' v=', v);
  end;
  { a variable the run writes first, after the failure: what it had }
  v := 7;
  try
    z := five[k];
    v := z + 1;
    w := v * 2;
  except
    on E: ERangeError do
      WriteLn('written after: v=', v, ' w=', w);
  end;
end;

{ A pointer a loop walks with: the node the failure came at. }
procedure Refs;
var
  head, p: PNode;
  i, n: Int64;
begin
  head := nil;
  for i := 7 downto 0 do
  begin
    New(p);
    p^.V := i;
    p^.Next := head;
    head := p;
  end;
  n := 0;
  p := head;
  try
    while p <> nil do
    begin
      n := n + five[p^.V];
      p := p^.Next;
    end;
  except
    on E: ERangeError do
      WriteLn('list: node ', p^.V, ' n=', n);
  end;
end;

{ Two shapes the fuzzer found (scripts/fuzz_faults.py, seeds 100 and
  175). Loops and the assignments after them, no call among them, are one
  run of statements kept in registers: its failure must store them as a
  loop's does. And a for of four passes or fewer is written out pass by
  pass, its counter dropped when nothing reads it after: inside a try the
  handler reads it. }
procedure Found;
var
  b, d, i, j, k, l: Int64;
  dd: array of Int64;
begin
  SetLength(dd, 3);
  d := 0;
  i := 0;
  j := 0;
  k := 0;
  try
    for j := 3 to 10 do
    begin
      for i := 0 to 4 do
      begin
        for k := 1 to 7 do
        begin
          dd[j] := (d and five[i - 2]);
        end;
        k := 0;
      end;
      i := 0;
    end;
    j := 0;
  except
    on E: ERangeError do
      WriteLn('run: i=', i, ' j=', j, ' k=', k);
  end;
  b := 1;
  d := 4;
  l := 0;
  try
    for l := 1 to 4 do
    begin
      b := (big - 2) mod (d and 3);
    end;
    l := 0;
  except
    on E: EDivByZero do
      WriteLn('written out: l=', l, ' b=', b);
  end;
  { the third pass is the one that fails }
  b := 0;
  l := 0;
  try
    for l := 2 to 5 do
    begin
      b := b + 60 div (4 - l);
    end;
    l := 0;
  except
    on E: EDivByZero do
      WriteLn('written out: l=', l, ' b=', b);
  end;
  { a variable a loop writes before it reads it is not loaded into its
    register outside a try; inside one it is, or the failure, here in the
    first pass and before the write, would store what the register had }
  b := 7;
  d := 3;
  try
    for l := big to big + 3 do
    begin
      b := five[l] + 1;
      d := d + b * 2;
    end;
  except
    on E: ERangeError do
      WriteLn('written first in a loop: b=', b, ' d=', d);
  end;
  { and one written first after a loop, in the same run of statements:
    the loop fails before it is written }
  b := 7;
  d := 0;
  try
    for j := 0 to 9 do
      d := d + five[j];
    b := d + 1;
    d := b * 2 + b + b;
  except
    on E: ERangeError do
      WriteLn('written first after the loop: b=', b, ' d=', d, ' j=', j);
  end;
  { a third shape the fuzzer found (seeds 221 and 229 of its second
    generator): a value worked out step by step in its variable's own
    register. When a later operand fails the variable has not changed. }
  b := 1;
  try
    for l := 0 to 4 do
      b := (b - five[4]) + five[l + big];
  except
    on E: ERangeError do
      WriteLn('step by step: b=', b);
  end;
  b := 1;
  try
    for l := 0 to 4 do
      b := (five[2] xor l) + five[l + big];
  except
    on E: ERangeError do
      WriteLn('in its register: b=', b);
  end;
  { the step that fails is the middle one of three }
  b := 1;
  try
    for l := 0 to 4 do
      b := ((b - five[4]) + five[l + big]) - 1;
  except
    on E: ERangeError do
      WriteLn('step by step, the middle one: b=', b);
  end;
  { the operand that fails is inside another }
  b := 1;
  try
    for l := 0 to 4 do
      b := ((b - five[4]) + (five[l + big] or 1099511627776));
  except
    on E: ERangeError do
      WriteLn('step by step, inside an operand: b=', b);
  end;
  b := 1;
  try
    for l := 0 to 4 do
      b := (five[2] xor l) + (3 * (five[l + big] and 255));
  except
    on E: ERangeError do
      WriteLn('in its register, inside an operand: b=', b);
  end;
  { and the last operand is a division by zero }
  b := 1;
  d := 8;
  try
    for l := 0 to 4 do
      b := ((b * 3) + l) - 60 div (d and 7);
  except
    on E: EDivByZero do
      WriteLn('step by step, a division: b=', b);
  end;
end;

{ A vector a loop keeps in a register goes home with the rest: six sums
  were done when the sixth pass failed. }
procedure Vectors;
var
  acc, one, res: V128;
  i, n: Int64;
begin
  one := VSplat64(1);
  acc := VSplat64(0);
  n := 0;
  try
    for i := 0 to 9 do
    begin
      acc := VAdd64(acc, one);
      n := n + five[i];
    end;
  except
    on E: ERangeError do
    begin
      { a vector with a view on it stays home: the lanes are read of a copy }
      res := acc;
      WriteLn('vector: i=', i, ' n=', n, ' lanes ', (res as array[0..1] of Int64)[0], ' ',
        (res as array[0..1] of Int64)[1]);
    end;
  end;
  { the failing index is the vector's own: 1 + 2 + 3 + 4 were summed }
  for i := 0 to 3 do
    va[i] := VSplat64(i + 1);
  acc := VSplat64(0);
  try
    for i := 0 to 9 do
      acc := VAdd64(acc, va[i]);
  except
    on E: ERangeError do
    begin
      res := acc;
      WriteLn('vector element: i=', i, ' lanes ', (res as array[0..1] of Int64)[0], ' ',
        (res as array[0..1] of Int64)[1]);
    end;
  end;
end;

{ SysFault as the runtime calls it, with numbers, a text, a kind and a pc of
  the test's own: the Message each shape of failure gets and the class of
  each kind. A pc below the program's code has no line and is said itself,
  in hexadecimal as the runtime writes it; nil says no place; a text that
  ends its own line loses the line feed; a kind nobody knows is an
  EExternal. }
procedure Direct(A, B, C: Int64; const Txt: string; Kind: Int64; Pc: Pointer);
begin
  try
    SysFault(A, B, C, @Txt[1], Length(Txt) + 256 * Kind, Pc);
  except
    on E: Exception do
      WriteLn('direct ', Kind, ' ', E.ClassName, ' [', E.Message, ']');
  end;
end;

procedure Directs;
begin
  Direct(-5, 0, 9, 'paslang: probe ', 1, Pointer($3a0f9c));
  Direct(7, 2, 3, 'paslang: probe ', 2, Pointer($10));
  Direct(64, 0, 63, 'paslang: probe ', 3, Pointer(1));
  Direct(0, 0, 0, 'paslang: plain', 4, Pointer($abcde));
  Direct(0, 0, 0, 'paslang: plain', 5, Pointer(10));
  Direct(0, 0, 0, 'paslang: plain', 6, nil);
  Direct(0, 0, 0, 'paslang: plain', 7, nil);
  Direct(1, 2, 3, 'paslang: no line' + #10, 8, Pointer(10));
  Direct(1, 2, 3, 'paslang: no line' + #10, 9, Pointer(10));
  Direct(3, 4, 0, 'paslang: logic on ', 10, nil);
  Direct(-3, 40, 0, 'paslang: a funnel of ', 11, Pointer(255));
  Direct(0, 0, 0, 'paslang: other', 99, nil);
  Direct(0, 0, 0, 'paslang: ', 4, nil);
end;

{ A loop for each check: the passes counted before its failure are what
  the handler reads, so the failure stored them (each check's failure is
  its own piece of code in the compiler). }
procedure LoopKinds;
var
  n, i, q, r: Int64;
  st: TSmall;
  b: Byte;
  x: Double;
  f: Single;
  qd: Quad;
  s, t, u: string;
  sh: TShape;
  d: array of Int64;
  objs: array[0..3] of TObject;
begin
  { a set's element: 2 to 7 are in }
  n := 0;
  st := [];
  try
    for i := 2 to 9 do
    begin
      Include(st, i);
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('set: i=', i, ' n=', n);
  end;
  { a bit's number: a Byte has 0 to 7, an Integer 0 to 63 }
  n := 0;
  q := 0;
  b := 255;
  try
    for i := 5 to 12 do
    begin
      q := q + Ord(IsBitSet(b, i));
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('bit: i=', i, ' n=', n, ' q=', q);
  end;
  n := 0;
  q := 0;
  r := -1;
  try
    for i := 60 to 70 do
    begin
      q := q + IsBitSet(r, i);
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('bit of an Integer: i=', i, ' n=', n, ' q=', q);
  end;
  { a real out of Integer's range: a thousand times more each pass }
  n := 0;
  x := 1e15;
  try
    for i := 1 to 10 do
    begin
      q := Trunc(x);
      x := x * 1000.0;
      n := n + 1;
    end;
  except
    on E: EInvalidOp do
      WriteLn('trunc: i=', i, ' n=', n);
  end;
  { a square root: one less each pass, below zero in the third }
  n := 0;
  q := 0;
  x := 2.5;
  try
    for i := 1 to 10 do
    begin
      x := x - 1.0;
      q := q + Trunc(Sqrt(x) * 100.0);
      n := n + 1;
    end;
  except
    on E: EInvalidOp do
      WriteLn('sqrt: i=', i, ' n=', n, ' q=', q);
  end;
  { the same of a Single and of a Quad, and a Quad out of Integer's range }
  n := 0;
  q := 0;
  f := 2.5;
  try
    for i := 1 to 10 do
    begin
      f := f - 1.0;
      q := q + Trunc(Sqrt(f) * 100.0);
      n := n + 1;
    end;
  except
    on E: EInvalidOp do
      WriteLn('sqrt of a Single: i=', i, ' n=', n, ' q=', q);
  end;
  n := 0;
  q := 0;
  qd := Quad(5) / Quad(2);
  try
    for i := 1 to 10 do
    begin
      qd := qd - Quad(1);
      q := q + Trunc(Sqrt(qd) * Quad(100));
      n := n + 1;
    end;
  except
    on E: EInvalidOp do
      WriteLn('sqrt of a Quad: i=', i, ' n=', n, ' q=', q);
  end;
  n := 0;
  qd := Quad(1000000000000000);
  try
    for i := 1 to 10 do
    begin
      q := Trunc(qd);
      qd := qd * Quad(1000);
      n := n + 1;
    end;
  except
    on E: EInvalidOp do
      WriteLn('trunc of a Quad: i=', i, ' n=', n);
  end;
  { a bit of a string: 'AB' has 0 to 15 }
  n := 0;
  q := 0;
  s := 'AB';
  try
    for i := 12 to 20 do
    begin
      q := q + Ord(IsBitSet(s, i));
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('bit of a string: i=', i, ' n=', n, ' q=', q);
  end;
  { as: the third object is of another class }
  objs[0] := TShape.Create;
  objs[1] := TShape.Create;
  objs[2] := TOther.Create;
  objs[3] := TShape.Create;
  n := 0;
  try
    for i := 0 to 3 do
    begin
      sh := objs[i] as TShape;
      n := n + sh.Area;
    end;
  except
    on E: EInvalidCast do
      WriteLn('as: i=', i, ' n=', n);
  end;
  { a dynamic array and a string }
  SetLength(d, 4);
  for i := 0 to 3 do
    d[i] := i + 1;
  n := 0;
  q := 0;
  try
    for i := 0 to 9 do
    begin
      q := q + d[i];
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('dynamic: i=', i, ' n=', n, ' q=', q);
  end;
  s := 'abcd';
  n := 0;
  q := 0;
  try
    for i := 1 to 9 do
    begin
      q := q + Ord(s[i]);
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('string: i=', i, ' n=', n, ' q=', q);
  end;
  { the 128-bit quotient: past 64 bits once the high word reaches the
    divisor }
  n := 0;
  try
    for i := 3 to 8 do
    begin
      DivMod128(i, 0, 5, q, r);
      n := n + 1;
    end;
  except
    on E: EIntOverflow do
      WriteLn('quotient: i=', i, ' n=', n);
  end;
  { logic and a funnel on two lengths: the second string a letter longer
    each pass }
  s := 'abc';
  t := 'a';
  n := 0;
  try
    for i := 1 to 5 do
    begin
      t := t + 'x';
      if i >= 2 then
        u := s xor t;
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('logic: i=', i, ' n=', n, ' ', Length(t));
  end;
  t := 'a';
  n := 0;
  try
    for i := 1 to 5 do
    begin
      t := t + 'x';
      if i >= 2 then
        u := FunnelLeft(s, t, 3);
      n := n + 1;
    end;
  except
    on E: ERangeError do
      WriteLn('funnel: i=', i, ' n=', n, ' ', Length(t));
  end;
end;

function Pick(I: Int64): Int64;
begin
  Result := five[I];
end;

function Deep(I, Level: Int64): Int64;
begin
  if Level = 0 then
    Result := Pick(I)
  else
    Result := Deep(I, Level - 1) + 1;
end;

{ A failure in a routine called, taken by the caller, whose own variables
  are as the call found them. }
procedure Callee;
var
  n, i: Int64;
begin
  n := 0;
  try
    for i := 3 to 8 do
      n := n + Pick(i);
  except
    on E: ERangeError do
      WriteLn('called: i=', i, ' n=', n);
  end;
  n := 0;
  try
    for i := 3 to 8 do
      n := n + Deep(i, 20);
  except
    on E: ERangeError do
      WriteLn('called deep: i=', i, ' n=', n);
  end;
end;

{ A lock block a failure leaves is unlocked, as by any raise. }
procedure Locked;
begin
  try
    lock mu do
      five[big] := 1;
  except
    on E: ERangeError do
      WriteLn('a failure inside a lock block');
  end;
  lock mu do
    WriteLn('and the lock is free');
end;

procedure Worker;
begin
  try
    Fail(1);
  except
    on E: Exception do
      got := E.ClassName;
  end;
  wg.Done;
end;

procedure DieWorker;
begin
  try
    Fail(dieK);
  finally
    WriteLn('finally in the routine');
  end;
  wg.Done;
end;

var
  k: Int64;
begin
  zero := Ord(ParamCount > 99);
  big := 9 + zero;
  if ParamCount = 2 then
  begin
    k := StrToInt(ParamStr(2));
    if ParamStr(1) = 'die' then
      Fail(k)
    else if ParamStr(1) = 'fin' then
    begin
      try
        Fail(k);
      finally
        WriteLn('finally');
      end;
    end
    else if ParamStr(1) = 'pas' then
    begin
      dieK := k;
      wg.Add(1);
      pas DieWorker;
      wg.Wait;
    end;
    WriteLn('not reached');
    Halt(0);
  end;
  for k := 1 to 17 do
    Caught(k);
  ByClass;
  LoopVars;
  Straight;
  Found;
  Vectors;
  Directs;
  LoopKinds;
  Refs;
  Callee;
  Locked;
  wg.Add(1);
  pas Worker;
  wg.Wait;
  WriteLn('a routine took its own: ', got);
  { and the program goes on }
  WriteLn(five[4]);
end.

