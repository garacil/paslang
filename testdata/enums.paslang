program enums;

type
  TColor = (Red, Green, Blue);
  TDigit = 0..9;
  TPoint = record
    X, Y: Integer;
  end;

var
  c: TColor;
  d: TDigit;
  p: TPoint;

begin
  c := Green;
  case c of
    Red: WriteLn(1);
    Green: WriteLn(2);
    Blue: WriteLn(3);
  end;
  d := 7;
  WriteLn(d);
  p.X := 0;
  p.Y := 0;
  with p do
  begin
    X := 3;
    Y := 4;
  end;
  WriteLn(p.X + p.Y);
end.
