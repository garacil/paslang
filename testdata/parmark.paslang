{ P95d: every M marks. A cycle's grey objects are shared by the Ms the
  world stopped: trees deep enough that a worker gives away half of what
  it holds, a pointer array of 400 KB marked in slices of 128 KB by
  whoever takes them, a map, and routines whose stacks and own lists are
  found by any worker. Everything reachable must survive cycles marked
  that way, and more than one worker must have marked some of them
  (one when PASLANG_GCWORKERS=1 or on a single P). }
program parmark;

uses
  paslib;

type
  PNode = ^TNode;
  TNode = record
    L, R: PNode;
    Name: string;
    V: Integer;
  end;

var
  trees: array of PNode;
  big: array of string;
  m: map[Integer] of string;
  wg: waitgroup;
  stop, errs, i, k, maxw, lim, bad, w, cycles: Integer;

function MakeTree(Depth, V: Integer): PNode;
var
  p: PNode;
begin
  New(p);
  p^.V := V;
  p^.Name := 'n' + IntToStr(V);
  if Depth > 0 then
  begin
    p^.L := MakeTree(Depth - 1, V * 2);
    p^.R := MakeTree(Depth - 1, V * 2 + 1);
  end;
  Result := p;
end;

function Check(P: PNode; V: Integer): Integer;
begin
  Result := 0;
  if P = nil then
    Exit;
  if (P^.V <> V) or (P^.Name <> 'n' + IntToStr(V)) then
    Result := 1;
  Result := Result + Check(P^.L, V * 2) + Check(P^.R, V * 2 + 1);
end;

function Count(P: PNode): Integer;
begin
  Result := 0;
  if P <> nil then
    Result := 1 + Count(P^.L) + Count(P^.R);
end;

{ A routine keeps a tree of its own on its stack only, and makes garbage
  until the main program says stop. }
procedure Churn(Seed: Integer);
var
  own, g: PNode;
  n, bad2: Integer;
  t: string;
begin
  own := MakeTree(10, Seed);
  n := 0;
  while stop = 0 do
  begin
    New(g);
    g^.Name := 'garbage' + IntToStr(n);
    t := g^.Name + '.';
    n := n + 1;
    if n mod 4096 = 0 then
      Yield;
  end;
  bad2 := Check(own, Seed);
  if Count(own) <> 2047 then
    bad2 := bad2 + 1;
  AtomicAdd(@errs, bad2);
  wg.Done;
end;

begin
  SetLength(trees, 8);
  for i := 0 to 7 do
    trees[i] := MakeTree(13, i + 1);
  SetLength(big, 50000);
  for i := 0 to 49999 do
    big[i] := 'b' + IntToStr(i);
  New(m);
  for i := 1 to 20000 do
    m[i] := 'm' + IntToStr(i);
  errs := 0;
  stop := 0;
  wg.Add(6);
  for i := 1 to 6 do
    pas Churn(i * 1000);
  maxw := 0;
  cycles := 0;
  for k := 1 to 20 do
  begin
    GcCollect;
    w := HeapStat(14);
    if w > maxw then
      maxw := w;
    cycles := cycles + 1;
    { the heap moves between cycles: some of it goes, some comes }
    for i := 0 to 49999 do
      if i mod 20 = k then
        big[i] := 'b' + IntToStr(i);
    trees[k mod 8] := MakeTree(13, k mod 8 + 1);
  end;
  AtomicAdd(@stop, 1);
  wg.Wait;
  GcCollect;
  bad := 0;
  k := 0;
  for i := 0 to 7 do
  begin
    bad := bad + Check(trees[i], i + 1);
    k := k + Count(trees[i]);
  end;
  WriteLn('trees ', k, ' bad ', bad);
  bad := 0;
  for i := 0 to 49999 do
    if big[i] <> 'b' + IntToStr(i) then
      bad := bad + 1;
  for i := 1 to 20000 do
    if m[i] <> 'm' + IntToStr(i) then
      bad := bad + 1;
  WriteLn('big ', Length(big), ' map ', Length(m), ' bad ', bad, ' routines ', errs);
  lim := HeapStat(15);
  if ((lim = 1) and (maxw = 1)) or ((lim > 1) and (maxw > 1) and (maxw <= lim)) then
    WriteLn('cycles ', cycles, ' workers ok')
  else
    WriteLn('cycles ', cycles, ' workers ', maxw, ' of ', lim);
  WriteLn('check ', HeapCheck);
end.

