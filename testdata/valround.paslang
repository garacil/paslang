{ Val into a Single (P146): it was refused (Double needs Single(x));
  the output is Free Pascal's. }
program valround;
var
  s: Single;
  d: Double;
  code: Int64;
  t: string;
begin
  for t in ['2.5', '0.1', '1e10', '-65504.25', '1.17549435e-38', '16777217', ' 7.25', '1.5x'] do
  begin
    Val(t, s, code);
    d := s;
    WriteLn(d:0:12, ' ', code);
  end;
end.

