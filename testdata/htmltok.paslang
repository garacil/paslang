{ P565: pashtml against the HTML Standard's tokenizer and Python's html.parser.
  Every case of testdata/htmltok.txt (one a line, with \n \t \xHH and \\
  for what a line cannot hold) is tokenized and the tokens printed, one a
  line, after the case; the text cases are printed through HtmlToText; the
  unesc, unesca and esc cases through HtmlUnescape, HtmlUnescapeAttr and
  HtmlEscape. scripts/html_oracle.py reads the output and works every html,
  text and unesc case out again with Python's html.parser and html.unescape
  where the two agree by design. }
program htmltok;

uses
  paslib, sysutils, pashtml;

{ what a line can hold: \n \t \\ and \xHH for the rest outside 32..126; \r is read too }
function Vis(const S: string): string;
const
  Digits: string = '0123456789abcdef';
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
    if S[i] = #10 then
      Result := Result + '\n'
    else if S[i] = #9 then
      Result := Result + '\t'
    else if S[i] = '\' then
      Result := Result + '\\'
    else if (Ord(S[i]) < 32) or (Ord(S[i]) > 126) then
      Result := Result + '\x' + Digits[Ord(S[i]) div 16 + 1] + Digits[Ord(S[i]) mod 16 + 1]
    else
      Result := Result + S[i];
end;

function HexVal(C: Char): Integer;
begin
  if (C >= '0') and (C <= '9') then
    Result := Ord(C) - 48
  else if (C >= 'a') and (C <= 'f') then
    Result := Ord(C) - 87
  else if (C >= 'A') and (C <= 'F') then
    Result := Ord(C) - 55
  else
    Result := 0;
end;

{ the inverse of Vis }
function Unvis(const S: string): string;
var
  i: Integer;
begin
  Result := '';
  i := 1;
  while i <= Length(S) do
  begin
    if (S[i] = '\') and (i < Length(S)) then
    begin
      case S[i + 1] of
        'n': Result := Result + #10;
        'r': Result := Result + #13;
        't': Result := Result + #9;
        '\': Result := Result + '\';
        'x':
          begin
            Result := Result + Chr(HexVal(S[i + 2]) * 16 + HexVal(S[i + 3]));
            i := i + 2;
          end;
      else
        Result := Result + S[i + 1];
      end;
      i := i + 2;
    end
    else
    begin
      Result := Result + S[i];
      i := i + 1;
    end;
  end;
end;

procedure Tokens(const Html: string);
var
  t: THtmlTokenizer;
  i, at, gaps: Integer;
  line, spans: string;
begin
  t := THtmlTokenizer.Create(Html);
  at := 1;
  gaps := 0;
  spans := '';
  while t.Next do
  begin
    case t.Kind of
      hkText: line := '  text [' + Vis(t.Data) + ']';
      hkStartTag:
        begin
          line := '  start ' + t.Name;
          for i := 0 to t.AttrCount - 1 do
            line := line + ' ' + t.Attrs[i].Name + '="' + Vis(t.Attrs[i].Value) + '"';
        end;
      hkEndTag: line := '  end ' + t.Name;
      hkComment: line := '  comment [' + Vis(t.Data) + ']';
      hkDoctype: line := '  doctype ' + t.Name + ' [' + Vis(t.Data) + ']';
    end;
    { a start tag written <br/>; anything else that says so is wrong }
    if t.SelfClosing then
      line := line + ' /';
    { what a token of this kind must not carry }
    if (t.Kind <> hkStartTag) and (t.AttrCount > 0) then
      line := line + ' attrs=' + IntToStr(t.AttrCount);
    if ((t.Kind = hkText) or (t.Kind = hkComment)) and (t.Name <> '') then
      line := line + ' name=' + t.Name;
    WriteLn(line);
    { the attributes by name, looked up without case }
    if (t.Kind = hkStartTag) and (t.HasAttr('ID') or t.HasAttr('Class')) then
      WriteLn('  has id=[', Vis(t.Attr('Id')), '] class=[', Vis(t.Attr('CLASS')), '] x=', t.HasAttr('x'), ' [', Vis(t.Attr('X')), ']');
    { the tokens' bytes in the source: each starts where the one before ended, tags between < and > }
    if t.Start <> at then
    begin
      gaps := gaps + 1;
      spans := spans + ' gap ' + IntToStr(at) + '-' + IntToStr(t.Start);
    end;
    if (t.Stop <= t.Start) or (t.Stop > Length(t.Source) + 1) then
      spans := spans + ' bad ' + IntToStr(t.Start) + '-' + IntToStr(t.Stop);
    if ((t.Kind = hkStartTag) or (t.Kind = hkEndTag)) and ((t.Source[t.Start] <> '<') or (t.Source[t.Stop - 1] <> '>')) then
      spans := spans + ' tag ' + IntToStr(t.Start) + '-' + IntToStr(t.Stop);
    at := t.Stop;
  end;
  if at <> Length(t.Source) + 1 then
    spans := spans + ' end ' + IntToStr(at) + ' of ' + IntToStr(Length(t.Source) + 1);
  if spans = '' then
    WriteLn('  spans ok')
  else
    WriteLn('  spans', spans);
end;

var
  corpus, line, kind, arg: string;
  p, nl, sp, cases: Integer;
begin
  if not ReadFile('testdata/htmltok.txt', corpus) then
  begin
    WriteLn('no testdata/htmltok.txt');
    Halt(2);
  end;
  cases := 0;
  p := 1;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    if (line = '') or (line[1] = '#') then
      Continue;
    sp := Pos(' ', line);
    if sp = 0 then
      Continue;
    kind := Copy(line, 1, sp - 1);
    arg := Unvis(Copy(line, sp + 1, Length(line) - sp));
    cases := cases + 1;
    if kind = 'html' then
    begin
      WriteLn('html ', Vis(arg));
      Tokens(arg);
    end
    else if kind = 'text' then
      WriteLn('text ', Vis(arg), ' -> ', Vis(HtmlToText(arg)))
    else if kind = 'unesc' then
      WriteLn('unesc ', Vis(arg), ' -> ', Vis(HtmlUnescape(arg)))
    else if kind = 'unesca' then
      WriteLn('unesca ', Vis(arg), ' -> ', Vis(HtmlUnescapeAttr(arg)))
    else if kind = 'esc' then
      WriteLn('esc ', Vis(arg), ' -> ', Vis(HtmlEscape(arg)))
    else
      WriteLn('? ', line);
  end;
  WriteLn(cases, ' cases');
end.
