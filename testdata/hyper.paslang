program hyper;

begin
  WriteLn(Sinh(0.0));
  WriteLn(Sinh(1.0));
  WriteLn(Sinh(-1.0));
  WriteLn(Sinh(0.5));
  WriteLn(Cosh(0.0));
  WriteLn(Cosh(1.0));
  WriteLn(Cosh(0.5));
  WriteLn(Tanh(0.0));
  WriteLn(Tanh(0.5));
  WriteLn(Tanh(1.0));
  WriteLn(Tanh(-1.0));
  WriteLn(Tanh(-2.0));
  WriteLn(Tanh(30.0));
  WriteLn(Tanh(-30.0));
  WriteLn(ArcSinh(0.0));
  WriteLn(ArcSinh(1.0));
  WriteLn(ArcSinh(-1.0));
  WriteLn(ArcSinh(-1000.0));
  WriteLn(ArcCosh(1.0));
  WriteLn(ArcCosh(2.0));
  WriteLn(ArcCosh(3.0));
  WriteLn(ArcTanh(0.0));
  WriteLn(ArcTanh(0.5));
  WriteLn(ArcTanh(-0.5));
  WriteLn(ArcTanh(0.9));
end.
