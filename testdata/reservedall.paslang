{ 1.0.138: every predefined name is a reserved word, and every one keeps
  working as itself. These are the old builtins that a declaration of
  their name could hide until 1.0.137: a user's function Length was
  ignored, a variable Min hid the builtin. Here each is called as the
  manual says, on both machines. }
program reservedall;

type
  TColor = (Red, Green, Blue);
  TPair = record
    A, B: Integer;
  end;

var
  s: string;
  a: array of Integer;
  m: map[string] of Integer;
  i, n, k: Integer;
  r: Real;
  c: TColor;
  pb: PByte;
  pw: PWord;
  b: array[0..3] of Byte;
  w: Word;
  by: Byte;
  q: Pointer;
  pr: TPair;
  mu: mutex;
  st: array of Byte;

begin
  { strings and ordinals }
  s := 'reserved';
  WriteLn(Length(s), ' ', Copy(s, 1, 3), ' ', Ord('A'), ' ', Chr(66), ' ', Ord(s[1]));
  { slices }
  SetLength(a, 4);
  for i := Low(a) to High(a) do
    a[i] := i * i;
  WriteLn(Length(a), ' ', Low(a), ' ', High(a), ' ', a[3], ' ', Assigned(a));
  { maps: TryGet, Delete, Clear, Length }
  New(m);
  m['one'] := 1;
  m['two'] := 2;
  k := 0;
  WriteLn(Length(m), ' ', TryGet(m, 'two', k), ' ', k, ' ', TryGet(m, 'six', k));
  Delete(m, 'one');
  WriteLn(Length(m), ' ', 'one' in m, ' ', 'two' in m);
  Clear(m);
  WriteLn(Length(m));
  { Inc, Dec and the integer set }
  n := 5;
  Inc(n);
  Dec(n, 2);
  WriteLn(n, ' ', Odd(n), ' ', Min(n, 2), ' ', Max(n, 2), ' ', Abs(-n), ' ', Sqr(n));
  c := Green;
  WriteLn(Ord(c), ' ', Ord(Succ(c)), ' ', Ord(Pred(c)), ' ', Ord(Low(TColor)), ' ', Ord(High(TColor)));
  WriteLn(SizeOf(w), ' ', SizeOf(b), ' ', SizeOf(pr), ' ', SizeOf(by), ' ', SizeOf(Integer));
  { the calculation set }
  r := 2.5;
  WriteLn(Floor(r), ' ', Ceil(r), ' ', Trunc(r), ' ', Round(3.5), ' ', Frac(r):0:2, ' ', Int(r):0:2);
  WriteLn(Sqrt(16.0):0:2, ' ', Exp(0.0):0:2, ' ', Ln(1.0):0:2, ' ', Power(2.0, 10.0):0:2);
  WriteLn(Sin(0.0):0:2, ' ', Cos(0.0):0:2, ' ', Tan(0.0):0:2, ' ', ArcTan(0.0):0:2);
  WriteLn(Pi:0:5, ' ', Hypot(3.0, 4.0):0:2, ' ', Log2(8.0):0:2, ' ', Log10(1000.0):0:2);
  WriteLn(IsNan(r), ' ', IsInfinite(r), ' ', Min(1.5, 2.5):0:1, ' ', Max(1.5, 2.5):0:1);
  { memory: FillChar, Move, the pointer types, GetMem, View, MemSize }
  FillChar(b, SizeOf(b), 7);
  b[0] := 1;
  b[1] := 2;
  Move(b[0], b[2], 2);
  WriteLn(b[0], ' ', b[1], ' ', b[2], ' ', b[3]);
  pb := @b[1];
  WriteLn(pb^, ' ', Assigned(pb), ' ', Assigned(q), ' ', SizeOf(pb^));
  w := 258;
  pw := @w;
  WriteLn(pw^, ' ', PByte(pw)^, ' ', SizeOf(pw^));
  q := GetMem(16, 0);
  WriteLn(Assigned(q), ' ', MemSize(q) >= 16, ' ', MemBase(q) = Integer(q));
  st := View(PByte(q), 4);
  st[0] := 9;
  WriteLn(Length(st), ' ', PByte(q)^, ' ', Default(Integer), ' ', Default(Boolean), ' ', Default(string) = '');
  FreeMem(q);
  { the program's words }
  WriteLn(ParamCount, ' ', Length(ParamStr(0)) > 0, ' ', (Amd64 = 0) or (Amd64 = 1), ' ', SrcLine > 0);
  WriteLn(XxHash64('abc') <> 0, ' ', XxHash32('abc') <> 0, ' ', XxHash3('abc') <> 0);
  { the core unit's routines }
  WriteLn(Goid, ' ', NumGoroutine >= 1);
  Yield;
  lock mu do
    WriteLn('locked');
  { the narrow types by their other names }
  WriteLn(SizeOf(Cardinal), ' ', SizeOf(QWord), ' ', SizeOf(ShortInt), ' ', SizeOf(SmallInt), ' ', SizeOf(LongWord), ' ', SizeOf(Single), ' ', SizeOf(Double), ' ', SizeOf(Quad));
end.

