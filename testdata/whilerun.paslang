program whilerun;

{ A while or a repeat whose condition counts a variable the body steps
  once a pass runs in runs of 1024 with one preemption test a run, as a
  for does (P283): the loops up to High(Integer) and down to
  Low(Integer), runs of every length near 1024 both ways and with a step
  of three, a condition joined by and or or that guards an index, break
  on and around the runs' edges, loops that do not count and run as
  before, and routines spinning in such loops while the collector stops
  the world. }

uses paslib;

var
  done, spins, finished: Integer;
  done2, spins2, finished2: Integer;
  done3, spins3, finished3: Integer;

procedure Ends;
var
  i, n: Integer;
begin
  n := 0;
  i := High(Integer) - 2;
  while i < High(Integer) do
  begin
    n := n + 1;
    i := i + 1;
  end;
  WriteLn('while up to High: ', n, ' ', i = High(Integer));
  n := 0;
  i := Low(Integer) + 2;
  while i > Low(Integer) do
  begin
    n := n + 1;
    i := i - 1;
  end;
  WriteLn('while down to Low: ', n, ' ', i = Low(Integer));
  n := 0;
  i := High(Integer) - 5;
  repeat
    n := n + 1;
    Inc(i);
  until i >= High(Integer);
  WriteLn('repeat up to High: ', n, ' ', i = High(Integer));
  n := 0;
  i := Low(Integer) + 5;
  repeat
    n := n + 1;
    Dec(i);
  until i <= Low(Integer);
  WriteLn('repeat down to Low: ', n, ' ', i = Low(Integer));
  n := 0;
  i := 10;
  while i < 5 do
  begin
    n := n + 1;
    i := i + 1;
  end;
  WriteLn('while no pass: ', n, ' ', i);
  n := 0;
  i := 10;
  repeat
    n := n + 1;
    i := i + 1;
  until i > 5;
  WriteLn('repeat past its end: ', n, ' ', i);
  n := 0;
  i := 10;
  repeat
    n := n + 1;
    i := i - 1;
  until i < 50;
  WriteLn('repeat down past its end: ', n, ' ', i);
end;

{ Runs of every length around the run size, both ways, steps 1 and 3,
  the limit in a variable and an expression of variables. }
procedure Runs;
var
  lens: array[0..8] of Integer;
  i, k, n, x, lo, hi: Integer;
begin
  lens[0] := 0;
  lens[1] := 1;
  lens[2] := 1022;
  lens[3] := 1023;
  lens[4] := 1024;
  lens[5] := 1025;
  lens[6] := 2047;
  lens[7] := 2048;
  lens[8] := 3075;
  for k := 0 to 8 do
  begin
    n := 0;
    x := 0;
    lo := 7;
    hi := 7 + lens[k];
    i := lo;
    while i < hi do
    begin
      n := n + 1;
      x := x xor (i * 31);
      i := i + 1;
    end;
    Write(n, ':', x, ' ');
    n := 0;
    i := hi - 1;
    while i >= lo do
    begin
      n := n + 1;
      x := x xor (i * 17);
      i := i - 1;
    end;
    Write(n, ':', x, ' ');
    n := 0;
    i := lo;
    while i <= lo + lens[k] - 1 do
    begin
      n := n + 1;
      x := x xor (i * 13);
      i := i + 3;
    end;
    Write(n, ':', x, ' ');
    n := 0;
    i := hi;
    while i > lo do
    begin
      i := i - 3;
      n := n + 1;
      x := x xor (i * 11);
    end;
    Write(n, ':', x, ' ');
    n := 0;
    i := lo;
    repeat
      n := n + 1;
      x := x xor (i * 7);
      i := i + 1;
    until i >= hi;
    WriteLn(n, ':', x, ' ', i);
  end;
end;

{ The counted test first, and what follows read only where it holds:
  a[i] past the end would fail its bounds check. }
procedure Guards;
var
  a: array of Byte;
  i, n, z: Integer;
begin
  SetLength(a, 3000);
  for i := 0 to 2999 do
    a[i] := Byte(i mod 251 + 1);
  a[2500] := 0;
  i := 0;
  n := 0;
  while (i < Length(a)) and (a[i] <> 0) do
  begin
    n := n + a[i];
    i := i + 1;
  end;
  WriteLn('and stops at the zero: ', i, ' ', n);
  a[2500] := 9;
  i := 0;
  n := 0;
  z := Length(a);
  while (i < z) and (a[i] <> 0) and (a[i] <> 255) do
  begin
    n := n + a[i];
    i := i + 1;
  end;
  WriteLn('and runs to the end: ', i, ' ', n);
  i := 0;
  n := 0;
  repeat
    n := n + a[i];
    i := i + 1;
  until (i >= z) or (a[i] = 7);
  WriteLn('or stops at a seven: ', i, ' ', n);
  i := 0;
  n := 0;
  repeat
    n := n + a[i];
    i := i + 1;
  until (i >= z) or (a[i] = 0);
  WriteLn('or runs to the end: ', i, ' ', n);
end;

{ break on and around the runs' edges. }
procedure Edges;
var
  i, n, k: Integer;
begin
  for k := 1022 to 1026 do
  begin
    i := 0;
    n := 0;
    while i < 5000 do
    begin
      if i = k then
        Break;
      n := n + i;
      i := i + 1;
    end;
    Write(i, ':', n, ' ');
    i := 0;
    n := 0;
    repeat
      if i = 2 * k then
        Break;
      n := n + i;
      i := i + 1;
    until i >= 5000;
    WriteLn(i, ':', n);
  end;
end;

{ Loops that do not count run as before: a continue could skip the
  step, a body that sets the variable back, a step under a condition. }
procedure Others;
var
  i, n, back: Integer;
begin
  i := 0;
  n := 0;
  while i < 3000 do
  begin
    i := i + 1;
    if i mod 7 = 0 then
      Continue;
    n := n + 1;
  end;
  Write(n, ' ');
  i := 0;
  n := 0;
  back := 0;
  while i < 3000 do
  begin
    n := n + 1;
    i := i + 1;
    if (i = 2000) and (back = 0) then
    begin
      back := 1;
      i := 10;
    end;
  end;
  Write(n, ' ');
  i := 0;
  n := 0;
  while i < 3000 do
  begin
    n := n + 1;
    if n mod 2 = 0 then
      i := i + 1;
  end;
  WriteLn(n);
end;

{ Spin in counted loops; the collector has to stop each many times. }
procedure Spin;
var
  k: Integer;
begin
  k := 0;
  while k < High(Integer) do
  begin
    if done <> 0 then
      Break;
    spins := spins + 1;
    k := k + 1;
  end;
  finished := 1;
end;

procedure Spin2;
var
  k: Integer;
begin
  k := 0;
  repeat
    if done2 <> 0 then
      Break;
    spins2 := spins2 + 1;
    k := k + 1;
  until k >= High(Integer);
  finished2 := 1;
end;

{ Steps its counter only every other pass: it does not run in runs, and
  the collector still stops it. }
procedure Spin3;
var
  k: Integer;
begin
  k := 0;
  while k < High(Integer) do
  begin
    if done3 <> 0 then
      Break;
    spins3 := spins3 + 1;
    if spins3 mod 2 = 0 then
      k := k + 1;
  end;
  finished3 := 1;
end;

procedure Churn;
var
  i: Integer;
  s: string;
begin
  s := '';
  for i := 1 to 200000 do
  begin
    s := IntToStr(i) + 'x';
    if Length(s) = 0 then
      WriteLn('never');
  end;
end;

begin
  Ends;
  Runs;
  Guards;
  Edges;
  Others;
  pas Spin;
  pas Spin2;
  pas Spin3;
  { every spinner has run before the main routine lets it go: on one CPU
    one the scheduler had not reached yet saw its flag set at once and
    never counted, 1 run in 300 since loops are stopped by a signal
    (P293), as Go's scheduler would let it happen too }
  while (spins = 0) or (spins2 = 0) or (spins3 = 0) do
    Sleep(1);
  Churn;
  done := 1;
  done2 := 1;
  done3 := 1;
  while (finished = 0) or (finished2 = 0) or (finished3 = 0) do
    Sleep(1);
  WriteLn('spins stopped: ', spins > 0, ' ', spins2 > 0, ' ', spins3 > 0);
end.

