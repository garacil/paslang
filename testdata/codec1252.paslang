{ P562: Windows-1252 and UTF-8 in pascodec, and pasmime's charset through it. Every byte through
  Windows1252ToUtf8, printed as the bytes of its UTF-8, and all 256 back
  through Utf8ToWindows1252; texts that have no byte in Windows-1252 or are
  not UTF-8 refused with what was written up to there; Utf8Valid and
  Utf8BadAt over the sequences UTF-8 forbids (overlong forms, surrogates,
  past U+10FFFF, a lead byte the end cuts, a continuation byte alone, the
  bytes C0 C1 F5 to FF) and over good ones of every length, and over a long
  text with one bad byte at every place, which the kernel finds by blocks.
  scripts/cp1252_check.py reads every byte and utf8 line again with Python's
  codecs. }
program codec1252;

uses
  pascodec, pasmime;

function HexOf(const S: string): string;
const
  Digits: string = '0123456789ABCDEF';
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
    Result := Result + Digits[Ord(S[i]) div 16 + 1] + Digits[Ord(S[i]) mod 16 + 1];
end;

procedure Back(const Tag, S: string);
var
  r: string;
begin
  r := 'junk';
  if Utf8ToWindows1252(S, r) then
    WriteLn('back ', Tag, ' ', HexOf(S), ' -> ', HexOf(r))
  else
    WriteLn('back ', Tag, ' ', HexOf(S), ' -> refused after ', HexOf(r));
end;

procedure Check(const S: string);
var
  k: Integer;
begin
  k := Utf8BadAt(S);
  if Utf8Valid(S) <> (k = 0) then
    WriteLn('utf8 ', HexOf(S), ' -> Utf8Valid and Utf8BadAt disagree');
  if k = 0 then
    WriteLn('utf8 ', HexOf(S), ' -> ok')
  else
    WriteLn('utf8 ', HexOf(S), ' -> bad ', k);
end;

var
  i, j, k: Integer;
  all, u, r, long: string;
begin
  all := '';
  for i := 0 to 255 do
  begin
    all := all + Chr(i);
    WriteLn('byte ', HexOf(Chr(i)), ' -> ', HexOf(Windows1252ToUtf8(Chr(i))));
  end;
  u := Windows1252ToUtf8(all);
  WriteLn('all 256 bytes: ', Length(u), ' bytes of UTF-8, valid ', Utf8Valid(u));
  if Utf8ToWindows1252(u, r) and (r = all) then
    WriteLn('all 256 bytes come back')
  else
    WriteLn('all 256 bytes do NOT come back');
  { pasmime decodes the charset through the same word }
  if MimeCharsetToUtf8('windows-1252', all, True, r) and (r = u) and MimeCharsetToUtf8('cp1252', all, True, r) and (r = u) and
    MimeCharsetToUtf8('x-cp1252', all, True, r) and (r = u) then
    WriteLn('pasmime windows-1252 agrees')
  else
    WriteLn('pasmime windows-1252 DIFFERS');
  Back('euro', #226#130#172 + 'uro');
  Back('spanish', 'a' + #195#177 + 'o ' + #194#191 + 'Qu' + #195#169 + '?');
  Back('nbsp', #194#160 + 'x');
  Back('c1', #194#129 + #194#157);
  Back('amacron', 'A' + #196#128 + 'B');
  Back('emoji', 'ok ' + #240#159#152#128);
  Back('cut', 'ab' + #226#130);
  Back('bare', 'ab' + #128 + 'cd');
  Back('overlong', #192#128);
  Back('empty', '');
  Back('order', #197#184#226#130#172);
  Back('u0080', #194#128);
  Back('u009f', #194#159);
  Back('yuml', #195#191);
  Back('u0100', #196#128);
  Check('');
  Check('plain ascii');
  Check(#195#177);
  Check(#226#130#172);
  Check(#240#159#152#128);
  Check(#244#143#191#191);
  Check('a' + #128);
  Check(#192#128);
  Check(#193#191);
  Check(#224#128#128);
  Check(#224#159#191);
  Check(#237#160#128);
  Check(#237#191#191);
  Check(#240#128#128#128);
  Check(#240#143#191#191);
  Check(#244#144#128#128);
  Check(#245#128#128#128);
  Check(#255);
  Check(#254);
  Check('ab' + #226#130);
  Check('ab' + #195);
  Check(#226#130#172 + #195);
  Check('x' + #195#177 + 'y' + #191);
  { a bad byte at every place of a long text: the kernel works by blocks of 64 }
  long := '';
  for i := 1 to 50 do
    long := long + 'abcdef' + #195#177 + #226#130#172 + #240#159#152#128;
  Check(long);
  { a byte of a sequence spoiled is reported at the sequence's lead: each block of 15 bytes is 6 singles, a pair, a
    triple and a quadruple }
  j := 0;
  for i := 1 to Length(long) do
  begin
    r := long;
    r[i] := #255;
    k := (i - 1) mod 15;
    if k >= 11 then
      k := 11
    else if k >= 8 then
      k := 8
    else if k >= 6 then
      k := 6;
    k := i - ((i - 1) mod 15) + k;
    if Utf8BadAt(r) <> k then
    begin
      j := j + 1;
      if j <= 3 then
        WriteLn('a bad byte at ', i, ' is found at ', Utf8BadAt(r), ' and not at ', k);
    end;
  end;
  WriteLn('long text: ', Length(long), ' bytes, ', j, ' places missed');
end.
