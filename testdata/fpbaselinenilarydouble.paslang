program fpbaselinenilarydouble;
function One: Double;
begin Result := $3FF0000000000000 as Double; end;
function Twice(X: Double): Double;
begin Result := X + X; end;
var X: Double; Expected: Integer;
begin
  if ParamCount = 0 then
  begin X := One; Expected := $3FF0000000000000; end
  else if (ParamCount = 1) and (ParamStr(1) = 'nested') then
  begin X := Twice(One); Expected := $4000000000000000; end
  else Halt(89);
  if (X as Integer) <> Expected then
  begin WriteLn('nilary Double: ', X as Integer, ' <> ', Expected); Halt(90); end;
  WriteLn('ok FP nilary Double');
end.
