program constexpr;

{ Constant expressions (1.0.74): a constant, an array bound, a case label
  and a default value take any expression of constants. Succ, Pred and
  not of an integer as well. }

type
  TColor = (Red, Green, Blue);

const
  A = 3 * 4 + 1;
  B = A shl 2;
  M = -(2 + 3) * A;
  D = 100 div 7;
  R7 = 100 mod 7;
  Big = 1 shl 62 - 1 + 1 shl 62;
  Mask = not 0 shr 1;
  Hx = $FF and not $0F;
  S = 'ab' + 'cd';
  SC = S + #33;
  Letter = Chr(Ord('A') + 2);
  L = Length(S) * 2;
  Half = 1 / 2;
  Pi2 = 3.25 * 2;
  NegR = -Pi2 + 1;
  RI = 7 / 2 + 1;
  Yes = A > 10;
  No = not Yes;
  Both = Yes and (S = 'abcd');
  Last = Succ(Green);
  Prev = Pred('c');
  AbsV = Abs(-17) + Sqr(3);
  IsOdd = Odd(A);
  Sz = SizeOf(Integer) * 4;
  N = 5;

var
  arr: array[0..N - 1] of Integer;
  grid: array[1..N * 2] of Integer;
  i, x: Integer;
  c: Char;
  k: TColor;

function Pad(const T: string; W: Integer = N * 2 - 4; F: string = '.' + '.'): string;
begin
  Result := T;
  while Length(Result) < W do
    Result := Result + F;
end;

function Scale(X: Double = 3 / 4 + 1): Double;
begin
  Result := X * 2;
end;

function Twice(X: Double = 2): Double;
begin
  Result := X * 2;
end;

function Grade(G: Char = Succ('A')): string;
begin
  Result := 'grade ' + G;
end;

begin
  WriteLn(A, ' ', B, ' ', M, ' ', D, ' ', R7);
  WriteLn(Big, ' ', Mask, ' ', Hx);
  WriteLn(S, ' ', SC, ' ', Letter, ' ', L);
  WriteLn(Half, ' ', Pi2, ' ', NegR, ' ', RI);
  WriteLn(Yes, ' ', No, ' ', Both, ' ', Ord(Last), ' ', Prev);
  WriteLn(AbsV, ' ', IsOdd, ' ', Sz);
  for i := 0 to High(arr) do
    arr[i] := i * i;
  WriteLn(Length(arr), ' ', arr[N - 1], ' ', Length(grid));
  x := 12;
  case x of
    A - 1: WriteLn('twelve');
    A: WriteLn('thirteen');
  else
    WriteLn('other');
  end;
  c := 'b';
  case c of
    'a': WriteLn('a');
    Pred('c'): WriteLn('b by Pred');
  else
    WriteLn('?');
  end;
  WriteLn(Pad('x'), ' ', Pad('y', 3), ' ', Pad('z', 4, '-'));
  WriteLn(Scale, ' ', Scale(1.5), ' ', Twice, ' ', Grade, ' ', Grade('C'));
  x := 5;
  WriteLn(not x, ' ', not (x > 3), ' ', not True, ' ', not False);
  WriteLn(Succ(x), ' ', Pred(x), ' ', Succ('y'), ' ', Pred(Blue) = Green);
  k := Red;
  k := Succ(k);
  WriteLn(Ord(k), ' ', Ord(Succ(k)));
end.

