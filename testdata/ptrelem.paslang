{ P385: the address of a pointer's element is one instruction from the
  registers that hold the pointer and the index: @p[i] of bytes, words,
  Int32 and Int64, at a variable index, a constant one and a worked-out
  one, read and written through PInt64(@p[i])^ and PInt32(@p[i])^, a
  negative constant index, records of 16 and 24 bytes, all in loops
  that keep their variables in registers. Every line is the same at
  -inline 0 and on the base processor. }
program ptrelem;

type
  TRec = record
    A, B: Int64;
  end;
  PRec = ^TRec;
  TRec3 = record
    A, B, C: Int64;
  end;
  PRec3 = ^TRec3;

var
  bytes: array[0..255] of Byte;
  dst: array[0..255] of Byte;
  words: array[0..63] of Word;
  ints: array[0..63] of Int32;
  longs: array[0..63] of Int64;
  recs: array[0..15] of TRec;
  recs3: array[0..15] of TRec3;
  i: Integer;

{ eight bytes a pass through PInt64(@d[k])^, as pasjson's CopyWords }
function CopyWords(Src, Dst: PByte; N: Int64): Int64;
var
  k: Int64;
begin
  k := 0;
  while k < N do
  begin
    PInt64(@Dst[k])^ := PInt64(@Src[k])^;
    k := k + 8;
  end;
  Result := k;
end;

function SumBytes(P: PByte; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
  q: PByte;
begin
  s := 0;
  for k := 0 to N - 1 do
  begin
    q := @P[k];
    s := s + q^ * (k and 3);
    q := @P[k + 1];
    s := s xor q^;
  end;
  Result := s;
end;

function SumWords(P: PWord; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
begin
  s := 0;
  for k := 0 to N - 1 do
    s := s + PWord(@P[k])^ * 3 + PWord(@P[2])^;
  Result := s;
end;

function RunInts(P: PInt32; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
begin
  s := 0;
  for k := 1 to N - 1 do
  begin
    PInt32(@P[k])^ := Int32(PInt32(@P[k - 1])^ + k);
    s := s + PInt32(@P[k])^;
  end;
  Result := s;
end;

function RunLongs(P: PInt64; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
  q: PInt64;
begin
  s := 0;
  q := @P[N - 1];
  for k := 0 to N - 2 do
  begin
    s := s + PInt64(@P[k])^ - PInt64(@q[-k])^;
    PInt64(@P[k])^ := s;
  end;
  Result := s + q^;
end;

function RunRecs(P: PRec; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
  r: PRec;
begin
  s := 0;
  for k := 0 to N - 1 do
  begin
    r := @P[k];
    r^.B := r^.A * 2 + k;
    s := s + r^.B;
  end;
  Result := s;
end;

function RunRecs3(P: PRec3; N: Integer): Int64;
var
  k: Integer;
  s: Int64;
  r: PRec3;
begin
  s := 0;
  for k := 0 to N - 1 do
  begin
    r := @P[k];
    r^.C := r^.A + r^.B + k;
    s := s + r^.C;
  end;
  Result := s;
end;

begin
  for i := 0 to 255 do
    bytes[i] := Byte(i * 7);
  for i := 0 to 63 do
  begin
    words[i] := Word(i * 1000);
    ints[i] := Int32(i);
    longs[i] := i * i;
  end;
  for i := 0 to 15 do
  begin
    recs[i].A := i;
    recs3[i].A := i;
    recs3[i].B := 2 * i;
  end;
  WriteLn('copy ', CopyWords(@bytes[0], @dst[0], 200), ' ', dst[0], ' ', dst[100], ' ', dst[199], ' ', dst[200]);
  WriteLn('bytes ', SumBytes(@bytes[0], 200));
  WriteLn('words ', SumWords(@words[0], 64));
  WriteLn('ints ', RunInts(@ints[0], 64), ' ', ints[63]);
  WriteLn('longs ', RunLongs(@longs[0], 64), ' ', longs[10]);
  WriteLn('recs ', RunRecs(@recs[0], 16), ' ', recs[15].B);
  WriteLn('recs3 ', RunRecs3(@recs3[0], 16), ' ', recs3[15].C);
end.

