{ P246: the rwmutex as Go's sync.RWMutex. Readers and writers on one lock:
  a writer adds one to two words with a yield between, a reader reads both
  and counts a difference as a fault; none can happen. Some readers hold the
  lock across a yield so that writers wait for them, and a writer waiting
  keeps new readers out until it has gone. }
program rwstress;

var
  rw: rwmutex;
  wg: waitgroup;
  a, b: Integer;
  faults, reads, writes, inside, maxInside, wInside: Integer;
  stat: mutex;

procedure Reader(Id, N: Integer);
var
  k, x, y: Integer;
begin
  for k := 1 to N do
  begin
    lock rw read do
    begin
      x := a;
      if (k + Id) mod 7 = 0 then
        Yield;
      y := b;
      if x <> y then
      begin
        lock stat do
          faults := faults + 1;
      end;
    end;
    lock stat do
      reads := reads + 1;
  end;
  wg.Done;
end;

procedure Writer(N: Integer);
var
  k: Integer;
begin
  for k := 1 to N do
  begin
    lock rw do
    begin
      a := a + 1;
      Yield;
      b := b + 1;
    end;
    lock stat do
      writes := writes + 1;
  end;
  wg.Done;
end;

var
  i: Integer;
begin
  wg.Add(11);
  for i := 1 to 8 do
    pas Reader(i, 4000);
  for i := 1 to 3 do
    pas Writer(400);
  wg.Wait;
  WriteLn('reads ', reads, ' writes ', writes, ' a ', a, ' b ', b, ' faults ', faults);
  lock rw read do
    lock rw read do
      WriteLn('two readers at once: ok');
  lock rw do
    a := a + 1;
  lock rw read do
    WriteLn('after a writer: ', a);
end.
