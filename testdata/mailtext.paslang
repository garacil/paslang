{ P566: the text of a message as a reader shows it. Messages written here in
  every shape the portal receives (plain only; HTML only, in UTF-8,
  ISO-8859-1 and windows-1252, in quoted-printable and base64; alternative
  with plain and HTML; mixed with an attachment and no text; related with
  an HTML and an image; an Outlook message with its tables and conditional
  comments; an attached message) go through MailParseEntity, MailTextOf and
  MailHtmlOf; the texts are printed with \n for the line ends. }
program mailtext;

uses
  sysutils, pascodec, pastextproto, pasmime;

function Vis(const S: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
    if S[i] = #10 then
      Result := Result + '\n'
    else if S[i] = #9 then
      Result := Result + '\t'
    else
      Result := Result + S[i];
end;

procedure Show(const Tag, Raw: string);
var
  e: TMailEntity;
  err: string;
begin
  if not MailParseEntity(Raw, e, err) then
  begin
    WriteLn(Tag, ': not a message: ', err);
    Exit;
  end;
  WriteLn(Tag, ' ', e.MediaType, ' kids ', e.KidCount);
  WriteLn('  text [', Vis(MailTextOf(e, True)), ']');
  WriteLn('  html [', Vis(MailHtmlOf(e, True)), ']');
end;

const
  CRLF = #13#10;
  Html1 = '<html><head><title>T</title><style>p{color:red}</style></head><body>' +
    '<p>Estimado cliente,</p><p>Su portabilidad&nbsp;ha sido <b>aceptada</b>.<br>Gracias.</p>' +
    '<table><tr><td>N&uacute;mero</td><td>600 000 000</td></tr><tr><td>Fecha</td><td>2026-11-04</td></tr></table>' +
    '</body></html>';

var
  plain, htmlOnly, latin1, cp1252, alt, mixed, related, outlook, attached, b64: string;
begin
  plain := 'From: a@example.com' + CRLF + 'To: b@example.com' + CRLF + 'Subject: plain' + CRLF +
    'Content-Type: text/plain; charset=utf-8' + CRLF + CRLF + 'Hola,' + CRLF + CRLF + 'texto llano con ' + #195#177 + '.' + CRLF;
  Show('plain', plain);

  htmlOnly := 'From: a@example.com' + CRLF + 'Subject: html' + CRLF + 'Content-Type: text/html; charset=utf-8' + CRLF +
    'Content-Transfer-Encoding: quoted-printable' + CRLF + CRLF +
    '<html><body><p>Hola <b>mundo</b>,</p><div>l=C3=ADnea dos</div><p>fin</p></body></html>' + CRLF;
  Show('htmlonly', htmlOnly);

  latin1 := 'Subject: latin1' + CRLF + 'Content-Type: text/html; charset=iso-8859-1' + CRLF + CRLF +
    '<p>a' + #241 + 'o ' + #233 + '</p>' + CRLF;
  Show('latin1', latin1);

  cp1252 := 'Subject: cp1252' + CRLF + 'Content-Type: text/html; charset=windows-1252' + CRLF +
    'Content-Transfer-Encoding: quoted-printable' + CRLF + CRLF +
    '<p>precio: 5=80 =96 =93comillas=94</p>' + CRLF;
  Show('cp1252', cp1252);

  b64 := 'Subject: b64' + CRLF + 'Content-Type: text/html; charset=utf-8' + CRLF + 'Content-Transfer-Encoding: base64' + CRLF +
    CRLF + Base64Encode('<ul><li>uno</li><li>dos &amp; tres</li></ul>', False, True) + CRLF;
  Show('base64', b64);

  alt := 'Subject: alternative' + CRLF + 'Content-Type: multipart/alternative; boundary="b1"' + CRLF + CRLF +
    '--b1' + CRLF + 'Content-Type: text/plain; charset=utf-8' + CRLF + CRLF + 'the plain part' + CRLF +
    '--b1' + CRLF + 'Content-Type: text/html; charset=utf-8' + CRLF + CRLF + '<p>the <i>html</i> part</p>' + CRLF +
    '--b1--' + CRLF;
  Show('alternative', alt);

  mixed := 'Subject: mixed' + CRLF + 'Content-Type: multipart/mixed; boundary="m1"' + CRLF + CRLF +
    '--m1' + CRLF + 'Content-Type: application/octet-stream' + CRLF + 'Content-Disposition: attachment; filename="x.csv"' +
    CRLF + CRLF + 'a;b;c' + CRLF +
    '--m1' + CRLF + 'Content-Type: text/html; charset=utf-8' + CRLF + CRLF + Html1 + CRLF +
    '--m1--' + CRLF;
  Show('mixed', mixed);

  related := 'Subject: related' + CRLF + 'Content-Type: multipart/related; boundary="r1"' + CRLF + CRLF +
    '--r1' + CRLF + 'Content-Type: text/html; charset=utf-8' + CRLF + CRLF +
    '<div>logo <img src="cid:logo"> here</div><div>second</div>' + CRLF +
    '--r1' + CRLF + 'Content-Type: image/png' + CRLF + 'Content-ID: <logo>' + CRLF +
    'Content-Transfer-Encoding: base64' + CRLF + CRLF + 'iVBORw0KGgo=' + CRLF +
    '--r1--' + CRLF;
  Show('related', related);

  outlook := 'Subject: outlook' + CRLF + 'Content-Type: text/html; charset=utf-8' + CRLF + CRLF +
    '<html xmlns:o="urn:schemas-microsoft-com:office:office"><head><!--[if gte mso 9]><xml><o:OfficeDocumentSettings>' +
    '</o:OfficeDocumentSettings></xml><![endif]--><style><!-- p.MsoNormal {margin:0cm} --></style></head>' +
    '<body lang=ES><div class=WordSection1><p class=MsoNormal>Buenos d&iacute;as,<o:p></o:p></p>' +
    '<p class=MsoNormal><o:p>&nbsp;</o:p></p><p class=MsoNormal>Adjunto el lote.<o:p></o:p></p>' +
    '<table class=MsoNormalTable border=1><tr><td>Ticket</td><td>TTPB-13589</td></tr></table></div></body></html>' + CRLF;
  Show('outlook', outlook);

  attached := 'Subject: forwarded' + CRLF + 'Content-Type: multipart/mixed; boundary="f1"' + CRLF + CRLF +
    '--f1' + CRLF + 'Content-Type: text/plain' + CRLF + CRLF + 'see below' + CRLF +
    '--f1' + CRLF + 'Content-Type: message/rfc822' + CRLF + CRLF + plain +
    '--f1--' + CRLF;
  Show('attached', attached);

  Show('noparts', 'Subject: nothing' + CRLF + 'Content-Type: multipart/mixed; boundary="n1"' + CRLF + CRLF +
    '--n1' + CRLF + 'Content-Type: image/gif' + CRLF + CRLF + 'GIF' + CRLF + '--n1--' + CRLF);
  Show('empty', 'Subject: empty' + CRLF + CRLF);
end.
