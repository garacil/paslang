program overloadp;

procedure Show(N: Integer); overload;
begin
  WriteLn(N);
end;

procedure Show(S: string); overload;
begin
  WriteLn(S);
end;

procedure Show(A, B: Integer); overload;
begin
  WriteLn(A + B);
end;

function Pick(N: Integer): Integer; overload;
begin
  Result := N + 1;
end;

function Pick: Integer; overload;
begin
  Result := 9;
end;

begin
  Show(3);
  Show('ab');
  Show(2, 5);
  WriteLn(Pick(4));
  WriteLn(Pick);
end.

