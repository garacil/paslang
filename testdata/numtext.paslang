{ pasnum against scripts/nummodel.py (P200): one case a line on the
  standard input until an empty line, one answer a line on the output,
  in the same order. p TEXT and j TEXT scan TEXT with Pascal's grammar
  or JSON's and give the bytes taken (or "bad" and where it stopped),
  the Double's bits and whether it is in range, the Single's bits and
  the same, then 1 and the Int64 or 0 0, 1 and the QWord or 0 0; a BITS
  writes the Double with those bits in its fewest digits, b BITS the
  Single; i V and u V write V as an Int64 and as a QWord. With the
  argument par, eight routines answer the cases between them, each
  every eighth one, while the collector runs, and the answers are
  printed in order: the same output. }
program numtext;

uses pasnum;

const
  Workers = 8;

var
  cases, answers: array of string;
  line: string;
  n, i: Int64;
  wg: waitgroup;

function Answer(const Line: string): string;
var
  t: string;
  kind: Char;
  sc: TPasNumScan;
  r64, r32, oki, oku: Boolean;
  b64, b32, vi, vu, code, k: Int64;
  buf: array[0..63] of Char;
  p: Pointer;
begin
  kind := Line[1];
  t := Copy(Line, 3, Length(Line) - 2);
  if Length(t) = 0 then
    p := nil
  else
    p := @t[1];
  if (kind = 'p') or (kind = 'j') then
  begin
    if not PasNumScan(p, Length(t), kind = 'j', sc) then
      Result := 'bad ' + PasFmtInt(sc.Len, 0)
    else
    begin
      r64 := PasNumF64(p, sc, b64);
      r32 := PasNumF32(p, sc, b32);
      oki := PasNumI64(p, sc, vi);
      oku := PasNumU64(p, sc, vu);
      Result := PasFmtInt(sc.Len, 0) + ' ' + PasFmtInt(b64, 0) + ' ' + PasFmtInt(Ord(r64), 0) + ' ' +
        PasFmtInt(b32, 0) + ' ' + PasFmtInt(Ord(r32), 0) + ' ' + PasFmtInt(Ord(oki), 0) + ' ' +
        PasFmtInt(vi, 0) + ' ' + PasFmtInt(Ord(oku), 0) + ' ' + PasFmtInt(vu, 0);
    end;
  end
  else
  begin
    Val(t, b64, code);
    if kind = 'a' then
      k := PasNumAppendF64(@buf[0], b64)
    else if kind = 'b' then
      k := PasNumAppendF32(@buf[0], b64)
    else if kind = 'i' then
      k := PasNumAppendInt(@buf[0], b64)
    else
      k := PasNumAppendUint(@buf[0], b64);
    Result := '';
    SetLength(Result, k);
    Move(buf[0], Result[1], k);
  end;
end;

procedure Worker(K: Int64);
var
  j: Int64;
begin
  j := K;
  while j < n do
  begin
    answers[j] := Answer(cases[j]);
    j := j + Workers;
  end;
  wg.Done;
end;

begin
  n := 0;
  while True do
  begin
    ReadLn(line);
    if line = '' then
      Break;
    if n = Length(cases) then
      SetLength(cases, 2 * n + 1024);
    cases[n] := line;
    n := n + 1;
  end;
  if ParamStr(1) = 'par' then
  begin
    SetLength(answers, n);
    wg.Add(Workers);
    for i := 0 to Workers - 1 do
      pas Worker(i);
    wg.Wait;
    for i := 0 to n - 1 do
      WriteLn(answers[i]);
  end
  else
    for i := 0 to n - 1 do
      WriteLn(Answer(cases[i]));
end.
