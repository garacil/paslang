{ Default parameters on methods (P125): an object's method, a virtual
  one and its override, a class method, a static one, a constructor, an
  interface's method, overloads told apart by what they take; nil for an
  object's or a pointer's default and a set's default, on a method and a
  routine. The same source compiles with Free Pascal, whose output is
  the one expected. }
program methdef1;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$interfaces corba}
{$endif}

type
  TColor = (Red, Green, Blue);
  TColors = set of TColor;

  ISpeak = interface
    function Speak(const Phrase: string; Times: Integer = 2): string;
  end;

  TPoint = class(ISpeak)
    X, Y: Integer;
    Tag: string;
    constructor Create(AX: Integer = 1; AY: Integer = 2; const ATag: string = 'pt');
    function Shift(DX: Integer; DY: Integer = 0): string;
    function Scaled(F: Double = 1.5): Double; virtual;
    class function UnitWord(Len: Integer = 10): string;
    class function Zero(const Name: string = 'origin'): string; static;
    function Paint(C: TColors = [Red, Blue]): Integer;
    function Other(P: TPoint = nil): string;
    function Speak(const Phrase: string; Times: Integer = 2): string;
    function Pick(A: Integer; B: Integer = 7): Integer; overload;
    function Pick(const S: string): Integer; overload;
  end;

  TPoint3 = class(TPoint)
    function Scaled(F: Double = 1.5): Double; override;
  end;

constructor TPoint.Create(AX: Integer = 1; AY: Integer = 2; const ATag: string = 'pt');
begin
  X := AX;
  Y := AY;
  Tag := ATag;
end;

function TPoint.Shift(DX: Integer; DY: Integer): string;
begin
  X := X + DX;
  Y := Y + DY;
  Result := Tag;
end;

function TPoint.Scaled(F: Double): Double;
begin
  Result := X * F;
end;

class function TPoint.UnitWord(Len: Integer): string;
begin
  Result := ClassName + ' unit ';
  if Len > 5 then
    Result := Result + 'long'
  else
    Result := Result + 'short';
end;

class function TPoint.Zero(const Name: string): string;
begin
  Result := 'zero ' + Name;
end;

function TPoint.Paint(C: TColors): Integer;
begin
  Result := 0;
  if Red in C then
    Result := Result + 1;
  if Green in C then
    Result := Result + 10;
  if Blue in C then
    Result := Result + 100;
end;

function TPoint.Other(P: TPoint): string;
begin
  if P = nil then
    Result := 'none'
  else
    Result := P.Tag;
end;

function TPoint.Speak(const Phrase: string; Times: Integer): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Times do
    Result := Result + Phrase;
end;

function TPoint.Pick(A: Integer; B: Integer): Integer;
begin
  Result := A + B;
end;

function TPoint.Pick(const S: string): Integer;
begin
  Result := Length(S);
end;

function TPoint3.Scaled(F: Double): Double;
begin
  Result := X * F * 3;
end;

function Count(C: TColors = []; P: Pointer = nil): Integer;
begin
  Result := 0;
  if C = [] then
    Result := 1;
  if P = nil then
    Result := Result + 10;
end;

var
  p, q: TPoint;
  s: ISpeak;

begin
  p := TPoint.Create;
  WriteLn(p.X, ' ', p.Y, ' ', p.Tag);
  p := TPoint.Create(5);
  WriteLn(p.X, ' ', p.Y, ' ', p.Tag);
  p := TPoint.Create(5, 6, 'named');
  WriteLn(p.Shift(1), ' ', p.X, ' ', p.Y);
  WriteLn(p.Shift(1, 1), ' ', p.X, ' ', p.Y);
  WriteLn(p.Scaled:0:2, ' ', p.Scaled(2):0:2);
  q := TPoint3.Create(2);
  WriteLn(q.Scaled:0:2, ' ', q.Scaled(1):0:2);
  WriteLn(TPoint.UnitWord, ' ', TPoint3.UnitWord(3), ' ', p.UnitWord);
  WriteLn(TPoint.Zero, ' ', TPoint.Zero('here'));
  WriteLn(p.Paint, ' ', p.Paint([Green]), ' ', p.Paint([]));
  WriteLn(p.Other, ' ', p.Other(q));
  s := p;
  WriteLn(s.Speak('ab'), ' ', s.Speak('c', 3));
  WriteLn(p.Pick(1), ' ', p.Pick(1, 2), ' ', p.Pick('four'));
  WriteLn(Count, ' ', Count([Red]), ' ', Count([], p));
end.

