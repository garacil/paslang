program fpbaselinenilarysingle;
function One: Single;
begin Result := $3F800000 as Single; end;
function Twice(X: Single): Single;
begin Result := X + X; end;
var X: Single; Expected: Integer;
begin
  if ParamCount = 0 then
  begin X := One; Expected := $3F800000; end
  else if (ParamCount = 1) and (ParamStr(1) = 'nested') then
  begin X := Twice(One); Expected := $40000000; end
  else Halt(89);
  if (X as UInt32) <> Expected then
  begin WriteLn('nilary Single: ', X as UInt32, ' <> ', Expected); Halt(90); end;
  WriteLn('ok FP nilary Single');
end.
