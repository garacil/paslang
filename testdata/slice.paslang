program slice;

function Head(xs: array of Integer): Integer;
begin
  Result := xs[0] + Length(xs);
end;

function Rest(xs: array of Integer): array of Integer;
begin
  Result := xs;
end;

procedure ShowWords(const A: array of string);
var
  i: Integer;
begin
  WriteLn(Length(A));
  for i := 0 to High(A) do
    WriteLn(A[i]);
end;

var
  a, b: array of Integer;
  s: string;
  words, ys: array of string;

begin
  SetLength(a, 2);
  a[0] := 10;
  a[1] := 20;
  SetLength(a, 4);
  WriteLn(a[0]);
  WriteLn(a[1]);
  WriteLn(Length(a));
  a[3] := 30;
  { A grow within the capacity gives zero elements, whatever a shrink or
    another slice left there (1.0.88; this printed 30, and ys[2] cc). }
  SetLength(a, 1);
  SetLength(a, 4);
  WriteLn(a[3]);
  WriteLn(Length(a));
  WriteLn(Head(a));
  b := Rest(a);
  WriteLn(b[3]);
  WriteLn(Length(b));
  s := '';
  SetLength(s, 3);
  s[1] := 'a';
  s[2] := 'b';
  s[3] := 'c';
  WriteLn(s);
  SetLength(s, 2);
  WriteLn(s);
  SetLength(words, 2);
  words[0] := 'aa';
  words[1] := 'bb';
  SetLength(words, 3);
  WriteLn(words[0]);
  WriteLn(Length(words));
  words[2] := 'cc';
  ShowWords(words);
  ys := words;
  SetLength(ys, 2);
  SetLength(ys, 3);
  WriteLn(ys[2]);
end.

