program crclens;

{ P549: the CRC-32 and the CRC-32C of data made from a seed, from two start values, for every length from 0 to 70 and for some longer ones }

uses
  sysutils;

var
  seed: Int64;

function Rnd: Integer;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := Integer((seed shr 33) and 255);
end;

function Data(n, kind: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, n);
  for i := 1 to n do
    case kind of
      0: Result[i] := Chr(Rnd);
      1: Result[i] := Chr(255);
      2: Result[i] := Chr(0);
    else
      Result[i] := Chr(97 + (i mod 7));
    end;
end;

procedure One(n, kind, start: Integer);
var
  s: string;
begin
  seed := 549 + n * 31 + kind;
  s := Data(n, kind);
  WriteLn(n, ' ', kind, ' ', start, ' ', Crc32(s, start), ' ', Crc32c(s, start));
end;

const
  Big: array[0..8] of Integer = (1000, 4093, 4094, 4095, 4096, 65535, 65536, 65537, 1048576);

var
  n, k: Integer;
begin
  for n := 0 to 70 do
    for k := 0 to 3 do
    begin
      One(n, k, 0);
      One(n, k, 3735928559);
    end;
  for k := 0 to 8 do
  begin
    One(Big[k], 0, 0);
    One(Big[k], 3, 3735928559);
  end;
end.
