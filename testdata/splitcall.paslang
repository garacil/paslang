program splitcall;

{ P400: a statement whose expression calls keeps the rest of it in the
  region: the call goes first into a hidden variable, the rest is a
  statement of the region, and a call alone takes its arguments from
  the registers that hold them and puts its value into its variable's.
  Seen records each call in order, so a call moved ahead of what it
  should follow shows in gseq. }

uses SysUtils;

type
  PInt = ^Integer;

  TNode = class
    V: Integer;
    Next: TNode;
  end;

var
  gseq, gsum: Integer;

procedure Seen(X: Integer);
begin
  gseq := gseq * 31 + X;
end;

function Twice(X: Integer): Integer;
begin
  Seen(X);
  Result := X * 2 + Ord(X < 0);
end;

function Tag(X, Y: Integer): Integer;
begin
  Seen(X * 100 + Y);
  Result := X - Y;
end;

function Pick(X: Integer): Integer;
begin
  Seen(X);
  Result := X mod 8;
end;

function Fails(X: Integer): Integer;
begin
  Seen(X);
  if X mod 3 = 2 then
    raise Exception.Create('fails ' + IntToStr(X));
  Result := X + 1;
end;

function Bump(D: Integer): Integer;
begin
  gsum := gsum + D;
  Result := gsum;
end;

function SetTo(var V: Integer; X: Integer): Integer;
begin
  V := X;
  Result := X * 3;
end;

function Step(K, N: Integer): Integer;
begin
  Result := K + 1 + K mod 3;
  if Result > N then
    Result := N;
end;

function MkNode(V: Integer; Next: TNode): TNode;
begin
  Result := TNode.Create;
  Result.V := V;
  Result.Next := Next;
end;

function Deep(N: Integer; P: PInt): PInt;
var
  pad: array[0..15] of Integer;
begin
  pad[N mod 16] := N;
  if N > 0 then
    Result := Deep(N - 1, P)
  else
    Result := P;
  if pad[N mod 16] <> N then
    Result := nil;
end;

{ calls in sums: each call first, the rest in registers }
function Sums(N: Integer): Integer;
var
  a, b, c, d, e: Integer;
begin
  a := N + 1;
  b := a * 3;
  c := Twice(a) + b;
  d := b - Twice(c) * 2 + a;
  e := Tag(a, b) + Tag(c, d) + a;
  Result := a + b + c + d + e + Twice(e);
end;

{ calls in compares, an if's, an assignment's and a case's }
function Compares(N: Integer): Integer;
var
  a, b, k: Integer;
  f: Boolean;
begin
  a := N * 7;
  b := N + 30;
  k := 0;
  if Twice(a) > b then
    k := k + 1;
  f := Twice(b) = a + 60;
  if f then
    k := k + 10;
  case Tag(a, b) mod 3 of
    0: k := k + 100;
    1: k := k + 200;
  else
    k := k + 300;
  end;
  if (a > 20) and (Twice(b) < 100) then
    k := k + 1000;
  Result := k * 1000 + a + b;
end;

{ calls in indexes, of a static array and of a dynamic one }
function Indexes(N: Integer): Integer;
var
  t: array[0..7] of Integer;
  d: array of Integer;
  i, s: Integer;
begin
  for i := 0 to 7 do
    t[i] := i * i + N;
  SetLength(d, 8);
  for i := 0 to 7 do
    d[i] := t[7 - i] * 3;
  s := 0;
  for i := 0 to 7 do
    s := s + t[Pick(i + N)] + d[Pick(i)] * 2;
  Result := s;
end;

{ nested calls, and two in one expression in their order }
function Nested(N: Integer): Integer;
var
  a, b: Integer;
begin
  a := N - 3;
  b := Twice(Twice(a) + 1) + a;
  b := b + Tag(Twice(b), a) * 2;
  b := Tag(a, 1) + Tag(b, 2) - Tag(a + b, 3);
  Result := b;
end;

{ a call that writes what the expression reads first: a global, a
  variable a nested routine writes, a var parameter's variable }
function GlobalWrite(N: Integer): Integer;
var
  x: Integer;
begin
  gsum := N;
  x := gsum + Bump(100);
  Result := x * 1000 + gsum;
end;

function NestedWrite(N: Integer): Integer;
var
  v, x: Integer;

  function Inner(D: Integer): Integer;
  begin
    v := v + D;
    Result := v * 2;
  end;

begin
  v := N;
  x := v + Inner(5);
  Result := x * 1000 + v;
end;

function VarWrite(N: Integer): Integer;
var
  v, x: Integer;
begin
  v := N;
  x := v + SetTo(v, 50);
  Result := x * 1000 + v;
end;

{ a division by a variable before the call: the call stays after it
  (testdata/fatal/divcall stops at such a division) }
function DivFirst(N, M: Integer): Integer;
var
  a, x: Integer;
begin
  a := N;
  x := a div M + Twice(a);
  Result := x * 10 + a mod M;
end;

{ a raise from the call: the handler reads the variables at home }
function RaiseMid(N: Integer): Integer;
var
  a, b, x: Integer;
begin
  a := N * 2;
  b := N + 7;
  x := 1;
  try
    x := Fails(N) + b;
    a := a + x;
  except
    on E: Exception do
      x := a * 10 + b;
  end;
  Result := a * 1000 + x;
end;

{ a call alone in a loop: its arguments from registers, its value into
  one }
function LoopCalls(N: Integer): Integer;
var
  k, s, i: Integer;
begin
  k := 0;
  s := 0;
  i := 0;
  while k < N do
  begin
    k := Step(k, N);
    s := s + k * i;
    Seen(s);
    i := i + 1;
  end;
  Result := s * 1000 + i;
end;

{ a call alone that makes objects, under the collector }
function Chain(N: Integer): Integer;
var
  head: TNode;
  i, s: Integer;
begin
  head := nil;
  for i := 1 to N do
    head := MkNode(i, head);
  s := 0;
  while head <> nil do
  begin
    s := s * 3 + head.V;
    head := head.Next;
  end;
  Result := s;
end;

{ a pointer into the stack given to a call that grows it }
function PtrDeep(N: Integer): Integer;
var
  x: Integer;
  p, q: PInt;
begin
  x := N;
  p := @x;
  q := Deep(300, p);
  q^ := q^ + 1;
  Result := x * 10 + p^ + Ord(p = q);
end;

var
  i: Integer;

begin
  for i := 0 to 9 do
  begin
    gseq := 0;
    WriteLn('sums ', i, ' ', Sums(i), ' ', gseq);
    gseq := 0;
    WriteLn('compares ', i, ' ', Compares(i), ' ', gseq);
    gseq := 0;
    WriteLn('indexes ', i, ' ', Indexes(i), ' ', gseq);
    gseq := 0;
    WriteLn('nested ', i, ' ', Nested(i), ' ', gseq);
    WriteLn('globalwrite ', i, ' ', GlobalWrite(i), ' nestedwrite ', NestedWrite(i),
      ' varwrite ', VarWrite(i));
    gseq := 0;
    WriteLn('divfirst ', i, ' ', DivFirst(i, i mod 3 + 1), ' ', gseq);
    gseq := 0;
    WriteLn('raisemid ', i, ' ', RaiseMid(i), ' ', gseq);
    gseq := 0;
    WriteLn('loopcalls ', i, ' ', LoopCalls(i * 7), ' ', gseq);
    WriteLn('chain ', i, ' ', Chain(i * 50));
    WriteLn('ptrdeep ', i, ' ', PtrDeep(i));
  end;
end.

