{ P362: a label no jump reaches stands in no fold's way. On arm64 a
  global read last before a frameless routine's return, past its
  epilogue's label, and one read last in a routine with a frame: the add
  of each adrp goes into the load (ldr x1, [x16, :lo12:v_g]), as
  scripts/check_adrpfold.py reads. The answers are worked out by hand
  in the comments. }
program adrplast;

var
  g, h: Integer;
  b: Byte;

function LastG(K: Integer): Integer;
begin
  Result := K + g;
end;

function LastByte: Integer;
begin
  Result := b + 1;
end;

function Framed(K: Integer): Integer;
begin
  Result := LastG(K) + h;
end;

begin
  g := 5;
  h := 7;
  b := 200;
  { 1 + 5 = 6, 200 + 1 = 201, 2 + 5 + 7 = 14 }
  WriteLn(LastG(1), ' ', LastByte, ' ', Framed(2));
end.
