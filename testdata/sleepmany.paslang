{ Thousands of routines asleep at once (1.1.1). The timer walk dropped
  its lock around each routine it woke and went on from a link another
  thread could take out meanwhile; a routine then stayed in the list of
  sleepers while it ran, went back to sleep, and was in the list twice:
  a cycle the walk spun on for ever. 3000 routines in Sleep(0) never
  ended. Here 4000 sleep three times each, for no time and for a
  millisecond. }
program sleepmany;

const
  N = 4000;
  Rounds = 3;

var
  woke: Integer;
  done: WaitGroup;

procedure Sleeper(Ms: Integer);
var
  k: Integer;
begin
  for k := 1 to Rounds do
  begin
    Sleep(Ms);
    AtomicAdd(@woke, 1);
  end;
  done.Done;
end;

var
  i, ms: Integer;
begin
  for ms := 0 to 1 do
  begin
    woke := 0;
    done.Add(N);
    for i := 1 to N do
      pas Sleeper(ms);
    done.Wait;
    WriteLn(N, ' routines slept ', Rounds, ' times for ', ms, ' ms: ', woke, ' wakes');
  end;
end.

