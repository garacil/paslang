{ P571: a constant index outside its array always fails, so the compiler
  writes the failure in place, with no branch to leave by. Where a call's
  value or an operand waited in a register while that index was worked
  out, the failure's own lines met the guard of those registers and the
  compiler stopped with an internal error. Each shape here compiles,
  fails at run time and is caught with its line, and the variable being
  assigned keeps what it had. }
program constidx;

uses
  sysutils;

var
  ga: array[0..7] of Int64;
  gb: array[0..4] of Int64;
  gd: array of Int64;
  gs: string;

function Rd(K: Int64): Int64;
begin
  Result := gb[K mod 5] + K;
end;

{ a call's value kept in a register while the other operand is worked
  out: past the end and before the start of a static array, before the
  start of a dynamic one, and a string's index 0 }
procedure Left(Which: Int64);
var
  mb, mk, ma: Int64;
begin
  mk := 1;
  ma := 3;
  mb := -1;
  try
    if Which = 1 then
      mb := (Rd(mk) or Rd(mk + 3)) and (gb[8] - ma)
    else if Which = 2 then
      mb := (Rd(mk) or Rd(mk + 3)) and (gb[-1] - ma)
    else if Which = 3 then
      mb := (Rd(mk) or Rd(mk + 3)) and (gd[-1] - ma)
    else
      mb := (Rd(mk) or Rd(mk + 3)) and (Ord(gs[0]) - ma);
    WriteLn('left ', Which, ' did not fail: ', mb);
  except
    on x: ERangeError do
      WriteLn('left ', Which, ': ', x.Message, ', mb=', mb);
  end;
end;

{ the same with no try around: the register is kept outside a region }
function Bare(Which: Int64): Int64;
var
  mk, ma: Int64;
begin
  mk := 1;
  ma := 3;
  if Which = 1 then
    Result := (Rd(mk) or Rd(mk + 3)) and (gb[8] - ma)
  else
    Result := (Rd(mk) or Rd(mk + 3)) and (gd[-1] - ma);
end;

{ operands that wait in the pool's registers, after a statement that
  left them taken }
procedure Waits(N: Int64);
var
  b, d, e: Int64;
begin
  b := 5 + N;
  d := 2;
  e := 1 + N;
  try
    e := (ga[d and 7] - gd[e and 7]) + (b + 1099511627776);
    e := (b - e) xor (gb[7] + gb[N]);
    WriteLn('waits did not fail: ', e);
  except
    on x: ERangeError do
      WriteLn('waits: ', x.Message, ', e=', e);
  end;
end;

var
  k: Int64;
begin
  SetLength(gd, 8);
  gs := 'abc';
  for k := 0 to 4 do
    gb[k] := k * 3;
  for k := 1 to 4 do
    Left(k);
  for k := 1 to 2 do
    try
      WriteLn('bare ', k, ' did not fail: ', Bare(k));
    except
      on x: ERangeError do
        WriteLn('bare ', k, ': ', x.Message);
    end;
  Waits(2);
end.

