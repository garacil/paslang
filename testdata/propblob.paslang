{ P365: a field, a nested field and an element of the record or the
  static array a property's getter gives, through a static getter, a
  virtual one, an indexed one and a record's own property, read where
  they are, on both machines; they stopped the compiler with not an
  address. }
program propblob;

type
  TPair = record
    A, B: Integer;
  end;
  TBox = record
    P: TPair;
    W: array[0..2] of Integer;
  end;
  TArr = array[0..2] of Integer;

  TShape = class
    K: Integer;
    function GetCorner: TPair;
    function GetArr: TArr;
    function GetAt(I: Integer): TPair;
    function GetBox: TBox; virtual;
    property Corner: TPair read GetCorner;
    property Arr: TArr read GetArr;
    property At[I: Integer]: TPair read GetAt;
    property Box: TBox read GetBox;
  end;

  TBig = class(TShape)
    function GetBox: TBox; override;
  end;

  TCell = record
    V: Integer;
    function GetTwice: TPair;
    property Twice: TPair read GetTwice;
  end;

function TShape.GetCorner: TPair;
begin
  Result.A := K + 1;
  Result.B := K + 2;
end;

function TShape.GetArr: TArr;
begin
  Result[0] := K;
  Result[1] := K * 2;
  Result[2] := K * 3;
end;

function TShape.GetAt(I: Integer): TPair;
begin
  Result.A := I;
  Result.B := I * K;
end;

function TShape.GetBox: TBox;
begin
  Result.P := GetCorner;
  Result.W := GetArr;
end;

function TBig.GetBox: TBox;
begin
  Result.P.A := 100;
  Result.P.B := 200;
  Result.W[2] := 300;
end;

function TCell.GetTwice: TPair;
begin
  Result.A := V * 2;
  Result.B := V * 4;
end;

var
  sh, big: TShape;
  c: TCell;

begin
  sh := TShape.Create;
  sh.K := 2;
  big := TBig.Create;
  WriteLn(sh.Corner.A, ' ', sh.Corner.B, ' ', sh.Corner.A + sh.Corner.B);
  WriteLn(sh.Arr[0], ' ', sh.Arr[1], ' ', sh.Arr[2]);
  WriteLn(sh.At[3].A, ' ', sh.At[3].B);
  WriteLn(sh.Box.P.B, ' ', sh.Box.W[2], ' ', big.Box.P.A, ' ', big.Box.W[2]);
  c.V := 5;
  WriteLn(c.Twice.A, ' ', c.Twice.B);
end.

