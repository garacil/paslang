{ P333: an exec and a new thread do not race. Each generation sets
  routines spinning on every processor, so the runtime makes its
  threads (rt_newm), and execs itself at once with one generation
  fewer while those threads are being made; the last generation says
  so. Before P333 a clone the kernel refused while the execve replaced
  the process (EAGAIN) ended the program, about one time in fifteen
  under load in debug2's run. }
program execrace;

uses paslib;

var
  n: Int64;
  k: Integer;
  sink: Integer;

{ the bytes of S and a zero, for the system call }
function CStr(const S: string): PChar;
var
  m: SizeInt;
begin
  m := Length(S);
  GetMem(Result, m + 1);
  if m > 0 then
    Move(S[1], Result^, m);
  Result[m] := #0;
end;

procedure Spin(K: Integer);
var
  x, i: Integer;
begin
  x := K;
  for i := 1 to 200000000 do
    x := x * 3 + i;
  sink := x;
end;

{ the words in typed variables, so the collector keeps them to the
  execve (cast to Integer, a word it does not follow, the path was taken
  back under PASLANG_GCSTRESS and the execve said EFAULT) }
procedure ExecSelf(Gen: Int64);
var
  argv: array of PChar;
  envp: array of PChar;
  path: PChar;
  r: Integer;
begin
  SetLength(argv, 3);
  SetLength(envp, 1);
  argv[0] := CStr(ParamStr(0));
  argv[1] := CStr(IntToStr(Gen));
  argv[2] := nil;
  envp[0] := nil;
  path := CStr('/proc/self/exe');
  if Amd64 = 1 then
    r := Syscall(59, path, Pointer(argv), Pointer(envp))
  else
    r := Syscall(221, path, Pointer(argv), Pointer(envp));
  WriteLn('execve failed: ', r, ' ', path[0], ' ', Length(argv), ' ', Length(envp));
  Halt(1);
end;

begin
  n := 40;
  if ParamCount >= 1 then
    if not StrToInt64(ParamStr(1), n) then
      Halt(2);
  if n = 0 then
  begin
    WriteLn('execrace: 40 generations');
    Exit;
  end;
  for k := 1 to 32 do
    pas Spin(k);
  ExecSelf(n - 1);
end.

