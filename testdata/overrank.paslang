{ Among overloads the one Free Pascal takes (P141): the closest class,
  a Char before a string for a one-character literal, the exact
  enumeration or subrange, an array of const before an open array for a
  list, a list of an integer and a Char for an array of const. The
  output is Free Pascal's. }
program overrank;
type
  TDay = (Mon, Tue, Wed);
  TWork = Mon..Tue;
  TCS = set of Char;
  TBase = class
  end;
  TKid = class(TBase)
  end;
  TGrand = class(TKid)
  end;
  TBaseClass = class of TBase;
  TKidClass = class of TKid;
function A(X: TBase): string; overload; begin Result := 'A base'; end;
function A(X: TKid): string; overload; begin Result := 'A kid'; end;
function B(C: Char): string; overload; begin Result := 'B char'; end;
function B(const S: string): string; overload; begin Result := 'B string'; end;
function C(D: TDay): string; overload; begin Result := 'C day'; end;
function C(W: TWork): string; overload; begin Result := 'C work'; end;
function D(X: Int64): string; overload; begin Result := 'D int'; end;
function D(const S: string): string; overload; begin Result := 'D string'; end;
function E(const Xs: array of Int64): string; overload; begin Result := 'E ints'; end;
function E(const Xs: array of const): string; overload; begin Result := 'E const'; end;
function G(S: TCS): string; overload; begin Result := 'G set'; end;
function G(const Xs: array of const): string; overload; begin Result := 'G const'; end;
function H(K: TBaseClass): string; overload; begin Result := 'H base'; end;
function H(K: TKidClass): string; overload; begin Result := 'H kid'; end;
function J(const Xs: array of const): string; begin Result := 'J ' + Chr(48 + Length(Xs)); end;
var
  gr: TGrand;
  k: TKid;
  c1: Char;
  w: TWork;
begin
  gr := TGrand.Create;
  k := TKid.Create;
  WriteLn(A(gr), ' ', A(k), ' ', A(TBase.Create));
  c1 := 'q';
  WriteLn(B('x'), ' ', B(c1), ' ', B('xy'), ' ', B(#10));
  w := Tue;
  WriteLn(C(w), ' ', C(Mon), ' ', C(Wed));
  WriteLn(D(c1), ' ', D(5));
  WriteLn(E([1, 2]));
  WriteLn(E([1, 'a']));
  WriteLn(E([]));
  WriteLn(G([1, 2]));
  WriteLn(G([]));
  WriteLn(H(TBase), ' ', H(TKid));
  WriteLn(J([1, 'a', 2.5, 'bc', True]), ' ', J(['x', 3]));
end.

