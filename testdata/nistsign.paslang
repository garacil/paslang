program nistsign;
{ P594: literal RFC 6979 signatures, raw encoding, strict inputs,
  aliases, kernel key generation and roots shared with pasroutines. }
uses pasnist, paslib;

const
  Priv256 = 'C9AFA9D845BA75166B5C215767B1D6934E50C3DB36E89B127B8A622B120F6721';
  Priv384 = '6B9D3DAD2E1B8C1C05B19875B6659F4DE23C3B667BF297BA9AA47740787137D896D5724E4C70A825F872C9EA60D2EDF5';
  Order256 = 'FFFFFFFF00000000FFFFFFFFFFFFFFFFBCE6FAADA7179E84F3B9CAC2FC632551';
  Order384 = 'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFC7634D81F4372DDF581A0DB248B0A77AECEC196ACCC52973';
  SampleR256 = 'EFD48B2AACB6A8FD1140DD9CD45E81D69D2C877B56AAF991C34D0EA84EAF3716';
  SampleS256 = 'F7CB1C942D657C41D436C7A1B6E29F65F3E900DBB9AFF4064DC4AB2F843ACDA8';
  TestR256 = 'F1ABB023518351CD71D881567B1EA663ED3EFCF6C5132B354F28D3B0B7D38367';
  TestS256 = '019F4113742A2B14BD25926B49C649155F267E60D3814B4C0CC84250E46F0083';
  SampleR384 = '94EDBB92A5ECB8AAD4736E56C691916B3F88140666CE9FA73D64C4EA95AD133C81A648152E44ACF96E36DD1E80FABE46';
  SampleS384 = '99EF4AEB15F178CEA1FE40DB2603138F130E740A19624526203B6351D0A3A94FA329C145786E679E7B82C71A38628AC8';
  TestR384 = '8203B63D3C853E8D77227FB377BCF7B7B772E97892A80F36AB775D509D7A5FEB0542A7F0812998DA8F1DD3CA3CF023DB';
  TestS384 = 'DDD0760448D42D8A43AF45AF836FCE4DE8BE06B485E9B61B827C2F13173923E06A739F040649A667BF3B828246BAA5A5';

var
  Done: chan of Integer;

procedure Require(Condition: Boolean; const Name: string);
begin
  if not Condition then
  begin
    WriteLn('FAIL ', Name);
    Halt(1);
  end;
end;

function UnHex(const Text: string): string;
var i, n, v: Integer; c: Char;
begin
  SetLength(Result, Length(Text) div 2);
  v := 0;
  for i := 1 to Length(Text) do
  begin
    c := Text[i];
    if (c >= '0') and (c <= '9') then n := Ord(c) - 48
    else if (c >= 'A') and (c <= 'F') then n := Ord(c) - 55
    else n := Ord(c) - 87;
    if Odd(i) then v := n shl 4 else Result[i div 2] := Chr(v or n);
  end;
end;

function Bytes(C: Char; Count: Integer): string;
var i: Integer;
begin
  SetLength(Result, Count);
  for i := 1 to Count do Result[i] := C;
end;

function Digest(Curve: Integer; const Text: string): string;
begin
  if Curve = NistP256 then Result := Sha256(Text) else Result := Sha384(Text);
end;

procedure Vector(Curve: Integer; const PrivateHex, Text, RHex, SHex: string);
var priv, hash, pub, r, s, r2, s2, changed: string; size: Integer;
begin
  priv := UnHex(PrivateHex);
  hash := Digest(Curve, Text);
  size := Length(priv);
  pub := NistPublicKey(Curve, priv);
  Require(NistEcdsaSign(Curve, priv, hash, r, s), 'vector sign');
  Require((Length(r) = size) and (Length(s) = size), 'fixed width');
  Require((r = UnHex(RHex)) and (s = UnHex(SHex)), 'RFC signature');
  Require(NistEcdsaVerify(Curve, pub, hash, r, s), 'vector verify');
  Require(NistEcdsaSign(Curve, priv, hash, r2, s2), 'repeat sign');
  Require((r = r2) and (s = s2), 'deterministic repeat');
  changed := r;
  changed[size] := Chr(Ord(changed[size]) xor 1);
  Require(not NistEcdsaVerify(Curve, pub, hash, changed, s), 'modified r');
  Require(not NistEcdsaVerify(Curve, pub, Digest(Curve, Text + '!'), r, s), 'modified digest');
end;

procedure Invalid(Curve: Integer; const Priv, Hash: string);
var r, s: string;
begin
  r := 'old r'; s := 'old s';
  Require(not NistEcdsaSign(Curve, Priv, Hash, r, s), 'invalid accepted');
  Require((r = '') and (s = ''), 'failure clears outputs');
end;

procedure InvalidInputs;
var p, h: string; curve, size: Integer;
begin
  for curve := NistP256 to NistP384 do
  begin
    if curve = NistP256 then begin size := 32; p := UnHex(Priv256); end
    else begin size := 48; p := UnHex(Priv384); end;
    h := Digest(curve, 'sample');
    Invalid(curve, '', h);
    Invalid(curve, Copy(p, 1, size - 1), h);
    Invalid(curve, #0 + p, h);
    Invalid(curve, Bytes(#0, size), h);
    Invalid(curve, Bytes(#255, size), h);
    if curve = NistP256 then Invalid(curve, UnHex(Order256), h)
    else Invalid(curve, UnHex(Order384), h);
    Invalid(curve, p, '');
    Invalid(curve, p, Copy(h, 1, size - 1));
    Invalid(curve, p, h + #0);
  end;
  Invalid(-1, UnHex(Priv256), Sha256('sample'));
  Invalid(2, UnHex(Priv256), Sha256('sample'));
  Require((NistGenerateKey(-1) = '') and (NistGenerateKey(2) = ''), 'invalid keygen curve');
end;

procedure Aliases;
var p, h, pub, shared: string;
begin
  p := UnHex(Priv256); h := Sha256('sample'); pub := NistPublicKey(NistP256, p);
  Require(NistEcdsaSign(NistP256, p, h, p, h), 'input/output alias');
  Require((p = UnHex(SampleR256)) and (h = UnHex(SampleS256)), 'aliased values');
  Require(NistEcdsaVerify(NistP256, pub, Sha256('sample'), p, h), 'aliased verify');
  p := UnHex(Priv256); h := Sha256('sample');
  Require(NistEcdsaSign(NistP256, p, h, h, p), 'reversed alias');
  Require((h = UnHex(SampleR256)) and (p = UnHex(SampleS256)), 'reversed values');
  shared := 'old';
  Require(not NistEcdsaSign(NistP256, UnHex(Priv256), Sha256('sample'), shared, shared), 'same output');
  Require(shared = '', 'same output cleared');
end;

procedure Reduction;
var p, h, n, r, s, r2, s2, pub: string; curve, size: Integer;
begin
  for curve := NistP256 to NistP384 do
  begin
    if curve = NistP256 then begin size := 32; n := UnHex(Order256); end
    else begin size := 48; n := UnHex(Order384); end;
    p := Bytes(#0, size); p[size] := #1;
    pub := NistPublicKey(curve, p);
    h := Bytes(#0, size);
    Require(NistEcdsaSign(curve, p, h, r, s), 'zero hash');
    Require(NistEcdsaVerify(curve, pub, h, r, s), 'zero hash verify');
    Require(NistEcdsaSign(curve, p, n, r2, s2), 'order hash');
    Require((r = r2) and (s = s2), 'bits2octets reduction');
    Require(NistEcdsaVerify(curve, pub, n, r2, s2), 'order hash verify');
    p := n; p[size] := Chr(Ord(p[size]) - 1);
    h := Bytes(#255, size); pub := NistPublicKey(curve, p);
    Require(NistEcdsaSign(curve, p, h, r, s), 'last scalar');
    Require(NistEcdsaVerify(curve, pub, h, r, s), 'last scalar verify');
  end;
end;

procedure GeneratedKeys;
var p, previous, pub, h, r, s: string; curve, i, size: Integer;
begin
  for curve := NistP256 to NistP384 do
  begin
    if curve = NistP256 then size := 32 else size := 48;
    previous := '';
    for i := 1 to 3 do
    begin
      p := NistGenerateKey(curve);
      Require(Length(p) = size, 'generated width');
      Require(p <> previous, 'fresh generated key');
      pub := NistPublicKey(curve, p);
      Require((Length(pub) = size * 2 + 1) and NistPointValid(curve, pub), 'generated public key');
      h := Digest(curve, 'generated key');
      Require(NistEcdsaSign(curve, p, h, r, s), 'generated sign');
      Require(NistEcdsaVerify(curve, pub, h, r, s), 'generated verify');
      previous := p;
    end;
  end;
end;

procedure OracleCorpus(const FileName: string);
var text, p, h, r, s, pub: string; doc, row: json; curve, count: Integer;
begin
  Require(ReadFile(FileName, text), 'read oracle corpus');
  doc := JsonParse(text);
  count := 0;
  for row in doc['vectors'] do
  begin
    curve := row['curve'].AsInteger;
    p := UnHex(row['private'].AsString);
    h := UnHex(row['hash'].AsString);
    pub := NistPublicKey(curve, p);
    Require(pub = UnHex(row['public'].AsString), 'oracle public key');
    Require(NistEcdsaSign(curve, p, h, r, s), 'oracle sign');
    Require(r = UnHex(row['r'].AsString), 'oracle r');
    Require(s = UnHex(row['s'].AsString), 'oracle s');
    Require(NistEcdsaVerify(curve, pub, h, r, s), 'oracle verify');
    Inc(count);
  end;
  Require(count = 90, 'complete oracle corpus');
  WriteLn('oracle signatures: ', count);
end;

procedure Worker(Id: Integer);
var i: Integer;
begin
  for i := 1 to 2 do
    if Odd(Id) then Vector(NistP256, Priv256, 'sample', SampleR256, SampleS256)
    else Vector(NistP384, Priv384, 'test', TestR384, TestS384);
  Send(Done, 1);
end;

procedure Concurrent;
var i, count: Integer;
begin
  Done := MakeChan();
  for i := 1 to 4 do pas Worker(i);
  count := 0;
  for i := 1 to 4 do count := count + Recv(Done);
  Require(count = 4, 'concurrent completion');
end;

procedure Deep(Depth: Integer);
var pad: array[0..511] of Integer; p, h, pub, r, s: string;
begin
  pad[0] := Depth; pad[511] := Depth * 3;
  if Depth = 640 then
  begin
    p := UnHex(Priv256); h := Sha256('sample'); pub := NistPublicKey(NistP256, p);
    Require(NistEcdsaSign(NistP256, p, h, r, s), 'signature before movement');
  end;
  if Depth = 0 then
  begin
    Require(GcCollect = 1, 'explicit collection');
    Vector(NistP256, Priv256, 'sample', SampleR256, SampleS256);
  end
  else Deep(Depth - 1);
  Require((pad[0] = Depth) and (pad[511] = Depth * 3), 'live frame');
  if Depth = 640 then
  begin
    Require((p = UnHex(Priv256)) and (h = Sha256('sample')), 'moved input roots');
    Require((r = UnHex(SampleR256)) and (s = UnHex(SampleS256)), 'moved output roots');
    Require(NistEcdsaVerify(NistP256, pub, h, r, s), 'signature after movement');
  end;
end;

procedure RootWorker;
begin
  Deep(640);
  Send(Done, 1);
end;

var moved: Integer;
begin
  if ParamStr(1) = 'oracle' then
  begin
    OracleCorpus(ParamStr(2));
    Halt(0);
  end;
  if ParamStr(1) = 'keys' then
  begin
    GeneratedKeys;
    WriteLn('generated keys ok');
    Halt(0);
  end;
  if ParamStr(1) = 'cold' then
  begin
    Concurrent;
    WriteLn('cold concurrent ok');
    Halt(0);
  end;
  Vector(NistP256, Priv256, 'sample', SampleR256, SampleS256);
  Vector(NistP256, Priv256, 'test', TestR256, TestS256);
  WriteLn('RFC6979 P256 ok');
  Vector(NistP384, Priv384, 'sample', SampleR384, SampleS384);
  Vector(NistP384, Priv384, 'test', TestR384, TestS384);
  WriteLn('RFC6979 P384 ok');
  InvalidInputs;
  WriteLn('invalid inputs ok');
  Aliases;
  WriteLn('aliases ok');
  Reduction;
  WriteLn('scalar boundaries ok');
  GeneratedKeys;
  WriteLn('generated keys ok');
  Concurrent;
  WriteLn('concurrent ok');
  moved := HeapStat(13);
  Done := MakeChan();
  pas RootWorker;
  Require(Recv(Done) = 1, 'root worker');
  Require(HeapStat(13) > moved, 'observed stack movement');
  WriteLn('GC and stack roots ok');
end.

