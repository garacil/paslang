{ P88: every integer name TYPES.md lists parses: Byte, Word, the Int8 to
  UInt32 row, FPC's LongWord, ShortInt, SmallInt and DWord. A local or a
  parameter of such a name is refused since 1.0.138 (they hid the type,
  as in Pascal). P99: each row is a type of its own that keeps
  its width in its values (1.0.89) and in memory (1.0.91): 255 + 1 in a
  Byte wraps to 0, Word(x) keeps the low 16 bits, SizeOf(Word) is 2 and
  SizeOf(UInt8) 1, and a sum of all of them works in Integer, the type
  that holds every one. }
program sized;

uses
  paslib;

type
  TPixel = record
    R, G, B: UInt8;
    X, Y: Int16;
  end;

var
  a: Int8;
  b: UInt8;
  c: Int16;
  d: UInt16;
  e: Word;
  f: Int32;
  g: UInt32;
  h: Byte;
  i: LongWord;
  j: ShortInt;
  k: SmallInt;
  l: DWord;
  p: TPixel;
  w: array[0..2] of Word;
  big: Integer;

function Count(const W: string): Integer;
var
  n8: Integer;
begin
  n8 := Length(W);
  Result := n8 * 2;
end;

begin
  a := -8;
  b := 8;
  c := -16;
  d := 16;
  e := 1000;
  f := -32;
  g := 32;
  h := 255;
  i := 4000000000;
  j := -1;
  k := -2;
  l := 3;
  WriteLn(a + b + c + d + e + f + g + h + i + j + k + l);
  { A Byte wraps (P99): 255 + 1 is 0. }
  h := h + 1;
  WriteLn(h, ' ', SizeOf(Word), ' ', SizeOf(UInt8));
  p.R := 200;
  p.X := -3;
  big := 70000;
  w[2] := Word(big);
  WriteLn(p.R + p.X, ' ', w[2], ' ', Int32(5) + UInt16(6));
  WriteLn(Count('abc'));
end.
