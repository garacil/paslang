{ A Char prints as the character, its byte, not as a number; Ord gives
  the code. Writing the bytes of a UTF-8 string one by one reproduces
  the string, multibyte characters included. }
program wrchar;

var
  c: Char;
  s: string;
  i: Integer;

begin
  c := 'x';
  WriteLn(c);
  Write(c);
  Write('-');
  WriteLn(Ord(c));
  s := 'año';
  for i := 1 to Length(s) do
    Write(s[i]);
  WriteLn('');
  WriteLn(Char(65), Char(66), ' ', Ord('A'));
  c := #33;
  WriteLn(c);
  WriteLn(#33, #33);
  WriteLn(s[1] = 'a', ' ', s[2] = #195);
end.

