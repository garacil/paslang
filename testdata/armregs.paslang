{ P290: arm64 works on a variable a loop keeps in a register where it
  lives: an operation into it, a compare of it, a load into it, a
  negation; every immediate at the edges of what the instruction takes
  (add and sub 0 to 4095, cmn for -4095 to -1, logical immediates and
  values that are not). Each line is the same on both machines and
  with the code before P290; Digits is StValue's loop over digits. }
program armregs;

var
  bytes: array[0..63] of Byte;
  words: array[0..63] of Word;
  ints: array[0..63] of Int32;
  small: array[0..63] of Int8;
  text: string;

function Digits(const s: string; var used: Integer): Integer;
var
  t: PByte;
  k, n, v, b: Integer;
begin
  t := PByte(@s[1]);
  n := Length(s);
  k := 0;
  v := 0;
  while k < n do
  begin
    b := t[k];
    if (b < 48) or (b > 57) then
      Break;
    v := v * 10 + (b - 48);
    k := k + 1;
  end;
  used := k;
  Result := v;
end;

function Imms(n: Integer): Integer;
var
  i, a, b, c, d: Integer;
begin
  a := 0;
  b := 0;
  c := 1;
  d := 0;
  for i := 1 to n do
  begin
    a := a + 4095;
    a := a - 4096;
    a := a + (-1);
    a := a - (-4095);
    b := i + 4095;
    b := b - 4096;
    b := -4095 + b;
    c := c xor 255;
    c := c and -16;
    c := c or $FF00FF00FF00FF00;
    c := c xor $1234;
    c := c and 5;
    d := d + (i shl 3);
    d := d shr 1;
    d := d + (i shl 63);
    d := d shr 0;
  end;
  Result := a + b + c + d;
end;

function Regs(n: Integer): Integer;
var
  i, a, b, s, m: Integer;
begin
  a := 3;
  b := 7;
  s := 0;
  for i := 1 to n do
  begin
    a := a * b;
    a := a and 1048575;
    m := (a + b) shr 1;
    b := b + i;
    b := b - a;
    s := s + m;
    s := s xor b;
    m := i shl (i and 7);
    s := s + m;
    s := s - (i shr (i and 3));
    a := -a;
    a := 17 * a;
    a := 1000 - a;
  end;
  Result := s + a + b;
end;

function Cmps(n: Integer): Integer;
var
  i, x, c: Integer;
begin
  c := 0;
  x := -5000;
  for i := 1 to n do
  begin
    x := x + 37;
    if x < -4096 then
      c := c + 1;
    if x <= -4095 then
      c := c + 2;
    if x = -1 then
      c := c + 4;
    if 5 < x then
      c := c + 8;
    if -4095 >= x then
      c := c + 16;
    if x > 4095 then
      c := c + 32;
    if x <> 4096 then
      c := c + 64;
    if x >= i then
      c := c + 128;
  end;
  Result := c;
end;

function Loads(n: Integer): Integer;
var
  i, b, w, v, t: Integer;
begin
  t := 0;
  for i := 0 to n - 1 do
  begin
    b := bytes[i and 63];
    w := words[i and 63];
    v := ints[i and 63];
    t := t + b + w + v;
    v := small[i and 63];
    t := t + v;
  end;
  Result := t;
end;

var
  i, used: Integer;

begin
  for i := 0 to 63 do
  begin
    bytes[i] := Byte(i * 7);
    words[i] := Word(i * 1031);
    ints[i] := Int32(i * 100003 - 3000000);
    small[i] := Int8(i * 5 - 160);
  end;
  text := '1234567890123456x';
  WriteLn(Digits(text, used), ' ', used);
  text := '42';
  WriteLn(Digits(text, used), ' ', used);
  WriteLn(Imms(1000));
  WriteLn(Regs(1000));
  WriteLn(Cmps(300));
  WriteLn(Loads(1000));
end.

