program mevent;

type
  TBox = class
    Seen: Integer;
    procedure Hit(X, Y: Integer);
  end;

  THit = procedure(X, Y: Integer) of object;

procedure TBox.Hit(X, Y: Integer);
begin
  Seen := X * 100 + Y;
  WriteLn(X);
  WriteLn(Y);
end;

var
  o: TBox;
  m: THit;

begin
  o := TBox.Create;
  m := o.Hit;
  m(3, 4);
  WriteLn(o.Seen);
end.
