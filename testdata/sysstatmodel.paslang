program sysstatmodel;
uses sysutils;
var info: TFileInfo; error: TSysError;
begin
  if not TryFileInfoAt(CurrentDirectoryHandle, ParamStr(1), ParamStr(2) = '1', info, error) then
  begin
    WriteLn('error ', error.Code);
    Exit;
  end;
  if not info.Has(fiType or fiMode or fiLinks or fiUser or fiGroup or
    fiAccessed or fiModified or fiChanged or fiInode or fiSize) then Halt(2);
  WriteLn(info.Mode, ' ', info.UserId, ' ', info.GroupId, ' ', info.Links,
    ' ', info.Size, ' ', UIntToStr(info.Inode), ' ', info.DeviceMajor, ' ', info.DeviceMinor);
  WriteLn(info.Accessed.Seconds, ' ', info.Accessed.Nanoseconds, ' ',
    info.Modified.Seconds, ' ', info.Modified.Nanoseconds, ' ',
    info.Changed.Seconds, ' ', info.Changed.Nanoseconds);
end.
