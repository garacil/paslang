{ P441: a close of a descriptor wakes every routine parked on it, with
  an error, whatever the wait: an accept, a read, a write, a connect, a
  datagram, WaitFd, WaitIo, WaitMs and WaitAny, closed by NetClose,
  TcpClose, UnixClose, UdpClose or a close made with Syscall. Before,
  the close took the descriptor out of the poller and the routine stayed
  parked for ever, or until the number, open again as another file, woke
  it for that file's octets.

  And any number of routines wait on one descriptor (P668's report): a
  registration with epoll holds one token, so the second routine to wait
  for a direction took the place of the first, which was never woken;
  the table of listeners held two routines a socket and 32 sockets.

  A wait that the runtime lost would park for ever, so a routine of the
  test watches the time and ends the program with its reason. }
program closewake;

uses
  sysutils, pasnet, paslib;

const
  { how long anything may take before the test says it is lost }
  LostMs = 120000;
  { how long a woken routine may take to say so }
  SoonMs = 20000;
  Ebadf = -9;

var
  good, bad: Integer;
  finished: Boolean;
  what: string;
  mu: mutex;
  big: string;
  sa: array[0..15] of Byte;
  accepted: Integer;

procedure Check(Holds: Boolean; const Words: string);
begin
  if Holds then
    Inc(good)
  else
  begin
    Inc(bad);
    WriteLn('  wrong: ', Words);
  end;
end;

procedure Group(const Name: string);
begin
  WriteLn(Name, ': ', good, ' of ', good + bad);
  good := 0;
  bad := 0;
end;

procedure Doing(const Words: string);
begin
  lock mu do
    what := Words;
end;

{ the routine that watches: a wait the runtime lost never ends, and the
  program must }
procedure Watch;
var
  due: Integer;
  over: Boolean;
  w: string;
begin
  due := PasIoDeadline(LostMs);
  repeat
    Sleep(20);
    lock mu do
    begin
      over := finished;
      w := what;
    end;
  until over or (Nanotime > due);
  if not over then
  begin
    WriteLn('  lost: a wait never ended in ', w);
    Halt(2);
  end;
end;

function SysClose(Fd: Integer): Integer;
begin
  if Amd64 = 1 then
    Result := Syscall(3, Fd)
  else
    Result := Syscall(57, Fd);
end;

function SysWrite(Fd: Integer; P: Pointer; N: Integer): Integer;
begin
  if Amd64 = 1 then
    Result := Syscall(1, Fd, P, N)
  else
    Result := Syscall(64, Fd, P, N);
end;

function SysRead(Fd: Integer; P: Pointer; N: Integer): Integer;
begin
  if Amd64 = 1 then
    Result := Syscall(0, Fd, P, N)
  else
    Result := Syscall(63, Fd, P, N);
end;

{ Is Fd in an epoll set of this process? The kernel says so in the
  set's fdinfo (proc_pid_fdinfo(5): a line "tfd: N" a member), and a
  descriptor is put there by its first wait: the routine is parked, or
  a moment from it. }
function Registered(Fd: Integer): Boolean;
var
  ep, i: Integer;
  line, target, index: string;
begin
  Result := False;
  for ep := 0 to 63 do
    if ReadLink('/proc/self/fd/' + IntToStr(ep), target) and (target = 'anon_inode:[eventpoll]') then
      if ReadFile('/proc/self/fdinfo/' + IntToStr(ep), line) then
      begin
        i := Pos('tfd:', line);
        while i > 0 do
        begin
          i := i + 4;
          while (i <= Length(line)) and (line[i] = ' ') do
            Inc(i);
          index := IntToStr(Fd) + ' ';
          if Copy(line, i, Length(index)) = index then
            Exit(True);
          i := Pos('tfd:', line, i);
        end;
      end;
end;

procedure Parked(Fd: Integer);
var
  due: Integer;
begin
  due := PasIoDeadline(SoonMs);
  while not Registered(Fd) do
  begin
    if Nanotime > due then
    begin
      WriteLn('  lost: descriptor ', Fd, ' never reached the poller in ', what);
      Halt(3);
    end;
    Sleep(1);
  end;
  { from the registration to the park: a few instructions }
  Sleep(5);
end;

{ An answer from C within Ms: False when none came. }
function Await(C: chan of Integer; Ms: Integer; out V: Integer): Boolean;
var
  due: Integer;
begin
  Result := False;
  V := 0;
  due := PasIoDeadline(Ms);
  while Nanotime < due do
  begin
    select
      Recv(C, V):
        Exit(True);
    else
      Sleep(1);
    end;
  end;
end;

{ One wait of each kind on Fd; its answer goes to C. }
procedure Waiter(Kind, Fd, Other: Integer; C: chan of Integer);
var
  a, port: Integer;
  s, host: string;
  b: Byte;
begin
  a := 0;
  case Kind of
    0: a := NetAccept(Fd);
    1: a := UnixAccept(Fd);
    2:
      begin
        s := UdpRecvFrom(Fd, 100, host, port);
        a := Length(s);
      end;
    3:
      begin
        NetRead(Fd, 100, s);
        a := Length(s);
      end;
    4: a := WaitIo(Fd, 1);
    5: a := WaitMs(Fd, 1, 100000);
    6: a := WaitFd(Fd);
    7: a := WaitAny([Other, Fd], 1, 100000);
    8: a := NetWrite(Fd, big);
    9: a := PasConnect(Fd, @sa, 16, 0);
    10: a := PasIoRead(Fd, @b, 1, PasIoDeadline(100000));
    11: a := WaitIo(Fd, 4);
    12: a := TcpAccept(Fd);
    13: a := WaitMs(Fd, 1, 150);
  end;
  Send(C, a);
end;

{ One octet read from Fd: its value, or what the read answered. }
procedure Reader(Fd: Integer; C: chan of Integer);
var
  n: Integer;
  b: Byte;
begin
  b := 0;
  n := PasIoRead(Fd, @b, 1, 0);
  if n = 1 then
    Send(C, b)
  else
    Send(C, n - 1000);
end;

procedure Closed(Kind, Fd, Other, How, Want: Integer; const Name: string);
var
  c: chan of Integer;
  v: Integer;
begin
  Doing(Name);
  c := MakeChan(1);
  pas Waiter(Kind, Fd, Other, c);
  Parked(Fd);
  case How of
    0: NetClose(Fd);
    1: TcpClose(Fd);
    2: UnixClose(Fd);
    3: UdpClose(Fd);
  else
    v := SysClose(Fd);
  end;
  if Await(c, SoonMs, v) then
    Check(v = Want, Name + ' answered ' + IntToStr(v))
  else
    Check(False, Name + ' stayed parked after the close');
end;

function Tag: string;
var
  pid: Integer;
begin
  if Amd64 = 1 then
    pid := Syscall(39)
  else
    pid := Syscall(172);
  Result := IntToStr(pid);
end;

{ A TCP socket that does not block, not connected: the number, as
  PasNetConnect makes it. }
function RawTcp: Integer;
begin
  if Amd64 = 1 then
    Result := Syscall(41, 2, 526337, 0)
  else
    Result := Syscall(198, 2, 526337, 0);
end;

procedure Closed7(Keep, Gone: Integer);
var
  c: chan of Integer;
  v: Integer;
begin
  c := MakeChan(1);
  pas Waiter(7, Gone, Keep, c);
  { WaitAny registers its members in a set of its own }
  Parked(Gone);
  Sleep(20);
  UdpClose(Gone);
  if Await(c, SoonMs, v) then
    Check(v = Ebadf, 'WaitAny answered ' + IntToStr(v))
  else
    Check(False, 'WaitAny stayed parked after the close of a member');
  { and still tells a member that is ready, and a wait that runs out }
  v := UdpSendTo(Keep, '127.0.0.1', UdpPort(Keep), 'x');
  Check(WaitAny([Keep], 1, SoonMs) = 0, 'WaitAny on a member that can be read');
  Check(WaitAny([Keep], 4, SoonMs) = 0, 'WaitAny on a member that can be written');
  UdpClose(Keep);
  Keep := UdpBindAt('127.0.0.1', 0);
  Check(WaitAny([Keep], 1, 30) = -1, 'WaitAny that runs out');
  UdpClose(Keep);
end;

procedure EveryKind;
var
  l, a, b, c, d, port, i, f1, f2, v: Integer;
begin
  l := TcpListen(0);
  Closed(0, l, -1, 0, Ebadf, 'NetAccept and NetClose');
  l := TcpListen(0);
  Closed(12, l, -1, 1, Ebadf, 'TcpAccept and TcpClose');
  l := UnixListen('@paslang-closewake-' + Tag);
  Closed(1, l, -1, 2, Ebadf, 'UnixAccept and UnixClose');
  l := UnixListen('@paslang-closewake-s-' + Tag);
  Closed(1, l, -1, 4, Ebadf, 'UnixAccept and a close by Syscall');
  a := UdpBindAt('127.0.0.1', 0);
  Closed(2, a, -1, 3, 0, 'UdpRecvFrom and UdpClose');
  if UnixPair(a, b) then
  begin
    Closed(3, a, -1, 4, 0, 'NetRead and a close by Syscall');
    v := SysClose(b);
  end;
  a := UdpBindAt('127.0.0.1', 0);
  Closed(4, a, -1, 0, Ebadf, 'WaitIo and NetClose');
  a := UdpBindAt('127.0.0.1', 0);
  Closed(5, a, -1, 4, Ebadf, 'WaitMs and a close by Syscall');
  a := UdpBindAt('127.0.0.1', 0);
  Closed(6, a, -1, 3, Ebadf, 'WaitFd and UdpClose');
  a := UdpBindAt('127.0.0.1', 0);
  if UnixPair(c, d) then
  begin
    Closed(10, c, -1, 2, Ebadf, 'a read with a deadline and UnixClose');
    v := SysClose(d);
  end;
  { a write the socket has no room for }
  if UnixPair(c, d) then
  begin
    Closed(8, c, -1, 0, Ebadf, 'NetWrite and NetClose');
    v := SysClose(d);
  end;
  { a connection on its way: a listener of backlog 1 takes two that
    nobody accepts (the queue is full once it holds more than its
    backlog, Linux's sk_acceptq_is_full) and drops the SYN of the third,
    whose connect stays in progress }
  l := TcpListenAt('127.0.0.1', 0, 1);
  port := TcpPort(l);
  f1 := TcpConnectTo('127.0.0.1', port);
  f2 := TcpConnectTo('127.0.0.1', port);
  for i := 0 to 15 do
    sa[i] := 0;
  sa[0] := 2;
  sa[2] := Byte(port shr 8);
  sa[3] := Byte(port and 255);
  sa[4] := 127;
  sa[7] := 1;
  c := RawTcp;
  Closed(9, c, -1, 4, Ebadf, 'a connect in progress and a close by Syscall');
  TcpClose(f1);
  TcpClose(f2);
  TcpClose(l);
  { WaitAny: the member that is closed is not the one it parks on }
  d := UdpBindAt('127.0.0.1', 0);
  Doing('WaitAny');
  Closed7(a, d);
end;

{ A number closed under a waiter and given out again: the waiter was
  told, and the new file's octets are the new file's. }
procedure Again;
var
  a, b, c, d, x, y, i, v, n: Integer;
  ch: chan of Integer;
  got: Boolean;
  bt: Byte;
begin
  Doing('a number given out again');
  for i := 1 to 20 do
  begin
    if not UnixPair(a, b) then
      Halt(4);
    ch := MakeChan(1);
    pas Waiter(4, a, -1, ch);
    Parked(a);
    v := SysClose(a);
    { the lowest free number is the one just closed }
    if not UnixPair(c, d) then
      Halt(4);
    x := -1;
    if c = a then
    begin
      x := c;
      y := d;
    end
    else if d = a then
    begin
      x := d;
      y := c;
    end;
    got := Await(ch, SoonMs, v);
    Check(got and (v = Ebadf), 'the old waiter answered ' + IntToStr(v));
    if x >= 0 then
    begin
      bt := Byte(65 + i);
      n := SysWrite(y, @bt, 1);
      Check(WaitMs(x, 1, SoonMs) = 0, 'a wait on the number open again');
      bt := 0;
      n := SysRead(x, @bt, 1);
      Check((n = 1) and (bt = 65 + i), 'the new file kept its octet');
    end;
    v := SysClose(b);
    v := SysClose(c);
    v := SysClose(d);
  end;
end;

procedure Taker(L: Integer; C: chan of Integer);
var
  f: Integer;
begin
  f := TcpAccept(L);
  if f >= 0 then
    TcpClose(f);
  Send(C, f);
end;

procedure Caller(Port: Integer);
var
  f: Integer;
begin
  f := TcpConnectTo('127.0.0.1', Port);
  if f >= 0 then
    TcpClose(f);
end;

procedure Many;
var
  a, b, i, v, n, sum, l, port, t0, got: Integer;
  ch, c2: chan of Integer;
  ls: array[0..39] of Integer;
  s: string;
  full: array[0..4095] of Byte;
begin
  { two readers, two octets }
  Doing('two readers of one socket');
  if not UnixPair(a, b) then
    Halt(4);
  ch := MakeChan(8);
  pas Reader(a, ch);
  Parked(a);
  pas Reader(a, ch);
  Sleep(20);
  s := 'AB';
  n := SysWrite(b, @s[1], 2);
  sum := 0;
  for i := 1 to 2 do
    if Await(ch, SoonMs, v) then
      sum := sum + v
    else
      Check(False, 'a reader of two was never served');
  Check(sum = 65 + 66, 'two readers took ' + IntToStr(sum));
  { eight readers, eight octets at once }
  Doing('eight readers of one socket');
  for i := 1 to 8 do
    pas Reader(a, ch);
  Sleep(30);
  s := 'abcdefgh';
  n := SysWrite(b, @s[1], 8);
  sum := 0;
  for i := 1 to 8 do
    if Await(ch, SoonMs, v) then
      sum := sum + v
    else
      Check(False, 'a reader of eight was never served');
  Check(sum = 97 + 98 + 99 + 100 + 101 + 102 + 103 + 104, 'eight readers took ' + IntToStr(sum));
  v := SysClose(a);
  v := SysClose(b);
  { five routines accepting on one listener }
  Doing('five routines accepting on one listener');
  l := TcpListen(0);
  port := TcpPort(l);
  ch := MakeChan(8);
  for i := 1 to 5 do
    pas Taker(l, ch);
  Parked(l);
  Sleep(30);
  for i := 1 to 5 do
    pas Caller(port);
  got := 0;
  for i := 1 to 5 do
    if Await(ch, SoonMs, v) and (v >= 0) then
      Inc(got);
  Check(got = 5, IntToStr(got) + ' of five accepted');
  TcpClose(l);
  { forty listeners }
  Doing('forty listeners');
  ch := MakeChan(64);
  for i := 0 to 39 do
  begin
    ls[i] := TcpListen(0);
    pas Taker(ls[i], ch);
  end;
  for i := 0 to 39 do
    Parked(ls[i]);
  for i := 0 to 39 do
    pas Caller(TcpPort(ls[i]));
  got := 0;
  for i := 0 to 39 do
    if Await(ch, SoonMs, v) and (v >= 0) then
      Inc(got);
  Check(got = 40, IntToStr(got) + ' of forty accepted');
  for i := 0 to 39 do
    TcpClose(ls[i]);
  { the deadline of a routine waiting its turn }
  Doing('the deadline of the second waiter');
  if not UnixPair(a, b) then
    Halt(4);
  ch := MakeChan(1);
  pas Waiter(4, a, -1, ch);
  Parked(a);
  t0 := Nanotime;
  v := WaitMs(a, 1, 100);
  t0 := (Nanotime - t0) div 1000000;
  Check((v = 0) and (t0 >= 99) and (t0 < SoonMs), 'the second waiter came back with ' + IntToStr(v));
  Check(not Await(ch, 30, v), 'the first waiter is still parked');
  s := 'x';
  n := SysWrite(b, @s[1], 1);
  Check(Await(ch, SoonMs, v) and (v = 0), 'the first waiter woke for the octet');
  v := SysClose(a);
  v := SysClose(b);
  { the turn passes when the registered routine takes its octet }
  Doing('the turn after an octet');
  if not UnixPair(a, b) then
    Halt(4);
  ch := MakeChan(1);
  c2 := MakeChan(1);
  pas Waiter(10, a, -1, ch);
  Parked(a);
  pas Waiter(4, a, -1, c2);
  Sleep(30);
  n := SysWrite(b, @s[1], 1);
  Check(Await(ch, SoonMs, v) and (v = 1), 'the first took its octet');
  { the octet is gone: the second, registered now, answers for another }
  Check(not Await(c2, 50, v), 'the second waits on');
  n := SysWrite(b, @s[1], 1);
  Check(Await(c2, SoonMs, v) and (v = 0), 'the second woke for the next octet');
  v := SysClose(a);
  v := SysClose(b);
  { the deadline of the routine that is registered }
  Doing('the deadline of the first waiter');
  if not UnixPair(a, b) then
    Halt(4);
  ch := MakeChan(1);
  c2 := MakeChan(1);
  pas Waiter(13, a, -1, ch);
  Parked(a);
  pas Waiter(4, a, -1, c2);
  Check(Await(ch, SoonMs, v) and (v = 0), 'the first waiter ran out of time');
  Check(not Await(c2, 50, v), 'the second waits on after it');
  n := SysWrite(b, @s[1], 1);
  Check(Await(c2, SoonMs, v) and (v = 0), 'the second, registered in its turn, woke for the octet');
  v := SysClose(a);
  v := SysClose(b);
  { four waits of one descriptor and its close }
  Doing('four waits and a close');
  if not UnixPair(a, b) then
    Halt(4);
  ch := MakeChan(8);
  pas Waiter(4, a, -1, ch);
  Parked(a);
  pas Waiter(5, a, -1, ch);
  pas Waiter(6, a, -1, ch);
  pas Waiter(10, a, -1, ch);
  Sleep(40);
  NetClose(a);
  got := 0;
  for i := 1 to 4 do
    if Await(ch, SoonMs, v) and (v = Ebadf) then
      Inc(got);
  Check(got = 4, IntToStr(got) + ' of four woke with EBADF');
  v := SysClose(b);
  { both directions, two routines each }
  Doing('two readers and two writers');
  if not UnixPair(a, b) then
    Halt(4);
  for i := 0 to 4095 do
    full[i] := 0;
  repeat
    n := SysWrite(a, @full, 4096);
  until n < 0;
  ch := MakeChan(4);
  c2 := MakeChan(4);
  pas Waiter(11, a, -1, ch);
  pas Waiter(4, a, -1, c2);
  Parked(a);
  Sleep(20);
  pas Waiter(11, a, -1, ch);
  pas Waiter(4, a, -1, c2);
  Sleep(40);
  Check(not Await(ch, 30, v), 'no room yet for the writers');
  repeat
    n := SysRead(b, @full, 4096);
  until n <= 0;
  got := 0;
  for i := 1 to 2 do
    if Await(ch, SoonMs, v) and (v = 0) then
      Inc(got);
  Check(got = 2, IntToStr(got) + ' of two writers woke for the room');
  Check(not Await(c2, 30, v), 'nothing yet for the readers');
  n := SysWrite(b, @s[1], 1);
  got := 0;
  for i := 1 to 2 do
    if Await(c2, SoonMs, v) and (v = 0) then
      Inc(got);
  Check(got = 2, IntToStr(got) + ' of two readers woke for the octet');
  v := SysClose(a);
  v := SysClose(b);
end;

procedure Closer(Fd: Integer; W: chan of Integer);
var
  v: Integer;
begin
  v := SysClose(Fd);
  Send(W, 0);
end;

procedure Poker(Fd: Integer; W: chan of Integer);
var
  n: Integer;
  b: Byte;
begin
  b := 7;
  n := SysWrite(Fd, @b, 1);
  Send(W, 0);
end;

procedure Loop(L: Integer; C: chan of Integer);
var
  f: Integer;
begin
  repeat
    f := NetAccept(L);
    if f >= 0 then
    begin
      AtomicAdd(@accepted, 1);
      NetClose(f);
    end;
  until f < 0;
  Send(C, f);
end;

{ A close and an octet at once, with three routines waiting: every one
  of them comes back, whichever came first, with an answer of its wait:
  0 or EBADF from a wait, an octet or EBADF from the read. }
procedure Races;
var
  a, b, i, k, v, l, port, due, got, rounds: Integer;
  ch, w: chan of Integer;
  why: string;
begin
  Doing('a close racing an octet');
  why := '';
  rounds := 150;
  if ParamCount >= 1 then
    rounds := StrToIntDef(ParamStr(1), 150);
  for i := 1 to rounds do
  begin
    if not UnixPair(a, b) then
      Halt(4);
    ch := MakeChan(4);
    w := MakeChan(2);
    pas Waiter(5, a, -1, ch);
    pas Waiter(10, a, -1, ch);
    pas Waiter(4, a, -1, ch);
    if (i and 1) = 0 then
      Parked(a);
    if (i and 2) = 0 then
    begin
      pas Closer(a, w);
      pas Poker(b, w);
    end
    else
    begin
      pas Poker(b, w);
      pas Closer(a, w);
    end;
    for k := 1 to 3 do
      if not Await(ch, SoonMs, v) then
        why := 'round ' + IntToStr(i) + ': a waiter stayed parked'
      else if (v <> 0) and (v <> 1) and (v <> Ebadf) then
        why := 'round ' + IntToStr(i) + ': a waiter answered ' + IntToStr(v);
    for k := 1 to 2 do
      if not Await(w, SoonMs, v) then
        why := 'round ' + IntToStr(i) + ': the close or the write never ended';
    v := SysClose(b);
    if why <> '' then
      Break;
  end;
  Check(why = '', 'a close racing an octet, ' + why);
  { routines that accept in a loop, and the listener closed under them }
  Doing('a listener closed under its accept loops');
  why := '';
  for i := 1 to 10 do
  begin
    l := TcpListen(0);
    port := TcpPort(l);
    accepted := 0;
    ch := MakeChan(8);
    for k := 1 to 4 do
      pas Loop(l, ch);
    for k := 1 to 12 do
      pas Caller(port);
    due := PasIoDeadline(SoonMs);
    while (AtomicAdd(@accepted, 0) < 12) and (Nanotime < due) do
      Sleep(1);
    NetClose(l);
    got := 0;
    for k := 1 to 4 do
      if Await(ch, SoonMs, v) then
      begin
        if v = Ebadf then
          Inc(got)
        else
          why := 'round ' + IntToStr(i) + ': an accept loop ended with ' + IntToStr(v);
      end
      else
        why := 'round ' + IntToStr(i) + ': an accept loop stayed parked';
    if AtomicAdd(@accepted, 0) <> 12 then
      why := 'round ' + IntToStr(i) + ': ' + IntToStr(AtomicAdd(@accepted, 0)) + ' of 12 connections taken';
    if why <> '' then
      Break;
  end;
  Check(why = '', 'a listener closed under its accept loops, ' + why);
end;

begin
  SetLength(big, 8 * 1048576);
  FillChar(big[1], Length(big), 66);
  pas Watch;
  EveryKind;
  Group('a close wakes every kind of wait');
  Again;
  Group('a number closed and given out again');
  Many;
  Group('any number of routines on one descriptor');
  Races;
  Group('a close racing an octet, and accept loops');
  lock mu do
    finished := True;
end.

