{ P602: compile only for amd64 base. No optional arithmetic is executed.
  The retained feature word distinguishes host capability from the target
  name and verifies PASLANG_CPU=base without changing public FMA kernels. }
program fmacaps;
begin
  if CpuHas('fma') then WriteLn('runtime-fma 1') else WriteLn('runtime-fma 0');
  WriteLn('runtime-features ', CpuFeatures);
end.
