{ P639: pas background F starts a routine that does not keep the program
  alive. A program waits for its routines when its main one ends (the
  manual, section 10), so nothing is cut in half; a background routine,
  a loop that serves or ticks for ever, is left out of that wait, as a
  daemon thread of Java or a background thread of .NET is, and as every
  goroutine but main's is in Go. Here background routines tick, park on
  a channel for ever and park after taking a string, a closure and a
  routine value; one starts another with plain pas, which is a
  background one too; one returns; a routine called background is started by
  pas background(5) as any other. The program ends when main has ended
  and the one counted worker has, with the background ones still there,
  and no deadlock is said. }
program bgroutine;

var
  ticks, namedArg: Integer;
  took: string;
  mu: mutex;
  forever: chan of Integer;
  started, quickwg: waitgroup;

procedure Ticker;
begin
  started.Done;
  while True do
  begin
    Sleep(2);
    lock mu do
      Inc(ticks);
  end;
end;

procedure Parked;
var
  v: Integer;
begin
  started.Done;
  v := Recv(forever);
  WriteLn('wrong: a parked background routine went on with ', v);
end;

procedure Named(const Who: string);
var
  v: Integer;
begin
  lock mu do
    took := Who;
  started.Done;
  v := Recv(forever);
end;

procedure Quick(N: Integer);
begin
  lock mu do
    WriteLn('a background routine that returns, with ', N);
  quickwg.Done;
end;

{ a routine whose name is the word: pas background(5) is a call of it }
procedure Background(N: Integer);
begin
  lock mu do
    namedArg := N;
  started.Done;
end;

{ a routine a background one starts with plain pas is a background one
  too, as a daemon thread's threads are daemons in Java: this one parks
  for ever and the program still ends }
procedure Spawner;
begin
  pas Parked;
end;

procedure Worker;
begin
  Sleep(150);
  lock mu do
    WriteLn('the counted worker ends after main, and the program with it: ticks went on ', ticks > 10);
end;

var
  f: procedure;

procedure ByValue;
var
  v: Integer;
begin
  started.Done;
  v := Recv(forever);
end;

begin
  forever := MakeChan();
  started.Add(7);
  pas background Ticker;
  pas background Parked;
  pas background Spawner;
  pas background Named('a string, through a closure');
  pas background procedure
    var
      v: Integer;
    begin
      started.Done;
      v := Recv(forever);
    end;
  f := @ByValue;
  pas background f;
  pas background(5);
  started.Wait;
  WriteLn('a background routine took its argument: ', took);
  WriteLn('the routine called background ran with ', namedArg);
  quickwg.Add(1);
  pas background Quick(7);
  quickwg.Wait;
  pas Worker;
  lock mu do
    WriteLn('main ends');
end.

