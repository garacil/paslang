program quadfmt;

{ pasfmt's exact text of a binary128 (P103) against libquadmath: 300
  values written with 6 decimals and trailing zeros dropped, 0, 3, 20
  and 40 decimals (quadmath_snprintf %.*Qf), 300 decimal strings read
  (strtoflt128), and the edges: the largest finite written whole, the
  smallest subnormal, the tie at half of it, the step past the largest
  to infinity, -0. }

var
  st: Int64;

function NextR: Int64;
var
  z: Int64;
begin
  st := st + (-7046029254386353131);
  z := st;
  z := (z xor (z shr 30)) * (-4658895280553007687);
  z := (z xor (z shr 27)) * (-7723592293110705685);
  Result := z xor (z shr 31);
end;

function UMod(X, M: Int64): Int64;
begin
  if X >= 0 then
    Result := X mod M
  else
    Result := (2 * ((X shr 1) mod M) + (X and 1)) mod M;
end;

function Hex64(X: Int64): string;
var
  i, d: Int64;
  s: string;
begin
  s := '';
  for i := 15 downto 0 do
  begin
    d := (X shr (i * 4)) and 15;
    if d < 10 then
      s := s + Chr(48 + d)
    else
      s := s + Chr(87 + d);
  end;
  Result := s;
end;

const
  ps: array[0..12] of string = ('1.18973149535723176508575932662800702e4932',
    '1.18973149535723176508575932662800703e4932', '1.1897314953572317650857593266280071e4932',
    '6.4751751194380251109244389582276466e-4966', '3.2375875597190125554622194791138233e-4966',
    '3.2375875597190125554622194791138234e-4966', '1e4933', '-0', '-0.0e5', '0.1',
    '123456789012345678901234567890123456789', '1e-4970', '2.5e-4966');
  fsl: array[0..2] of Int64 = (-1, 1, 0);
  fsh: array[0..2] of Int64 = (9223090561878065151, 0, 281474976710656);

var
  n, i, k, r1, r2, r3, e, hi, lo, q1, q2, nd, dot, ex, plo, phi: Int64;
  s: string;
  ok: Boolean;

begin
  n := 300;
  st := 777;
  for i := 0 to n - 1 do
  begin
    r1 := NextR;
    r2 := NextR;
    r3 := NextR;
    if ((r1 shr 16) mod 16) = 0 then
      e := ((r1 shr 24) mod 3) * 16383 div 2
    else
      e := 16383 - 200 + (r1 shr 24) mod 400;
    if ((r1 shr 40) mod 10) = 0 then
      e := 0;
    hi := ((r1 and 1) shl 63) or (e shl 48) or (r2 and 281474976710655);
    lo := r3;
    Write(i);
    Write(' ', PasFmtQuad(lo, hi, 0, -1));
    Write(' ', PasFmtQuad(lo, hi, 0, 0));
    Write(' ', PasFmtQuad(lo, hi, 0, 3));
    Write(' ', PasFmtQuad(lo, hi, 0, 20));
    Write(' ', PasFmtQuad(lo, hi, 0, 40));
    q1 := NextR;
    q2 := NextR;
    s := '';
    if (q1 and 1) = 1 then
      s := '-';
    nd := 1 + UMod(q1, 40);
    dot := (q1 shr 8) mod (nd + 1);
    for k := 0 to nd - 1 do
    begin
      if (k = dot) and (k > 0) then
        s := s + '.';
      s := s + Chr(48 + UMod(NextR, 10));
    end;
    ex := UMod(q2, 10001) - 5000;
    if ((q2 shr 20) mod 3) = 0 then
      ex := ((q2 shr 24) mod 81) - 40;
    s := s + 'e' + PasFmtInt(ex, 0);
    ok := PasParseQuad(s, plo, phi);
    WriteLn(' ', s, ' ', Hex64(phi), Hex64(plo));
  end;
  for i := 0 to 12 do
  begin
    ok := PasParseQuad(ps[i], plo, phi);
    WriteLn('p ', ps[i], ' ', Hex64(phi), Hex64(plo));
  end;
  for i := 0 to 2 do
    WriteLn('f', i, ' ', PasFmtQuad(fsl[i], fsh[i], 0, -1), ' ', PasFmtQuad(fsl[i], fsh[i], 0, 40));
end.

