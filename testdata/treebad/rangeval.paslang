{ P110: for k, v in t[a..b] checks v against the values. }
program rangeval;
var
  t: tree[Integer] of Integer;
  k: Integer;
  v: string;
begin
  New(t);
  t[1] := 1;
  for k, v in t[0..5] do
    WriteLn(k);
end.

