program pathsclean;
uses sysutils;
var path, header: string; i, count: Integer;
begin
  ReadLn(header);
  count := StrToInt(header);
  for i := 1 to count do
  begin
    ReadLn(path);
    WriteLn(CleanPath(path));
    WriteLn(Ord(IsAbsolutePath(path)), ' ', Ord(IsLocalPath(path)));
  end;
  if IsLocalPath('a'#0'b') then Halt(2);
  if ConcatPaths(['', 'a']) <> '/a' then Halt(3);
  if ConcatPaths(['base', '/a']) <> 'base/a' then Halt(4);
  if JoinPaths(['', 'a']) <> 'a' then Halt(5);
  if JoinPaths(['base', '/a']) <> 'base/a' then Halt(6);
  if JoinPaths(['', '']) <> '' then Halt(7);
  if JoinPaths(['a', '..', 'b']) <> 'b' then Halt(8);
  if JoinPaths(['a', '', 'b']) <> 'a/b' then Halt(9);
end.
