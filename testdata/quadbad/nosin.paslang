{ P103: d := Sin(q) is refused. }
program nosin;

var
  q: Quad;
  d: Double;
  s: Single;
  i: Integer;
  b: Boolean;
  a: array[0..1] of Quad;

function F: Integer;
begin
  Result := 0;
end;

begin
  q := 1;
  d := Sin(q);
end.

