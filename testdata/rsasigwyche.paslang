program rsasigwyche;
{ P616: Wycheproof's signature generation vectors for pasrsa
  (testdata/wycheproof rsa_pkcs1_*_sig_gen_test.json: keys of 1024,
  1536, 2048, 3072 and 4096 bits with SHA-1 to SHA-512). Each group's
  private key is read twice, from its PKCS #8 DER and from its PKCS #1
  PEM, and must load; RSASSA-PKCS1-v1_5 has one signature for a key
  and a message, so the signature made here must be the vector's, byte
  for byte, whether the vector is "valid" or "acceptable" (a 1024-bit
  key, SHA-1), and both keys must make the same. A group whose hash
  paslang has no word for is skipped and counted. }
uses pasrsa, pasx509, paslib, sysutils;

function UnHex(const h: string): string;
var
  i, d, v: Integer;
  c: Char;
begin
  Result := '';
  SetLength(Result, Length(h) div 2);
  v := 0;
  for i := 1 to Length(h) do
  begin
    c := h[i];
    if (c >= '0') and (c <= '9') then d := Ord(c) - 48
    else if (c >= 'a') and (c <= 'f') then d := Ord(c) - 87
    else d := Ord(c) - 55;
    if Odd(i) then v := d shl 4
    else Result[i div 2] := Chr(v or d);
  end;
end;

function HashId(const s: string): Integer;
begin
  if s = 'SHA-1' then Result := RsaSha1
  else if s = 'SHA-224' then Result := RsaSha224
  else if s = 'SHA-256' then Result := RsaSha256
  else if s = 'SHA-384' then Result := RsaSha384
  else if s = 'SHA-512' then Result := RsaSha512
  else if s = 'SHA3-224' then Result := RsaSha3_224
  else if s = 'SHA3-256' then Result := RsaSha3_256
  else if s = 'SHA3-384' then Result := RsaSha3_384
  else if s = 'SHA3-512' then Result := RsaSha3_512
  else Result := -1;
end;

const
  Files: array[0..4] of string = ('rsa_pkcs1_1024_sig_gen_test.json', 'rsa_pkcs1_1536_sig_gen_test.json',
    'rsa_pkcs1_2048_sig_gen_test.json', 'rsa_pkcs1_3072_sig_gen_test.json',
    'rsa_pkcs1_4096_sig_gen_test.json');

var
  text, fname, err8, err1, hashed, want, sig8, sig1: string;
  doc, grp, tc: json;
  k8, k1: TRsaPrivateKey;
  pass, fail, skip, tpass, tfail, tskip, hash, fi, ntc, groups: Integer;
  ok8, ok1: Boolean;
begin
  tpass := 0; tfail := 0; tskip := 0;
  for fi := 0 to 4 do
  begin
    fname := 'testdata/wycheproof/' + Files[fi];
    if not ReadFile(fname, text) then
    begin
      WriteLn('cannot read ', fname);
      Halt(1);
    end;
    doc := JsonParse(text);
    pass := 0; fail := 0; skip := 0; ntc := 0; groups := 0;
    for grp in doc['testGroups'] do
    begin
      Inc(groups);
      hash := HashId(grp['sha'].AsString);
      if (grp['type'].AsString <> 'RsassaPkcs1Generate') or (hash < 0) then
      begin
        for tc in grp['tests'] do
        begin
          Inc(ntc);
          Inc(skip);
        end;
        Continue;
      end;
      ok8 := X509ParsePkcs8RsaKey(UnHex(grp['privateKeyPkcs8'].AsString), k8, err8);
      ok1 := X509ParsePemRsaKey(grp['privateKeyPem'].AsString, k1, err1);
      if not (ok8 and ok1) then
      begin
        WriteLn('FAIL ', fname, ' group ', groups, ': key refused: ', err8, ' / ', err1);
        for tc in grp['tests'] do
        begin
          Inc(ntc);
          Inc(fail);
        end;
        Continue;
      end;
      for tc in grp['tests'] do
      begin
        Inc(ntc);
        hashed := RsaHash(hash, UnHex(tc['msg'].AsString));
        want := UnHex(tc['sig'].AsString);
        if RsaSignPkcs1v15(k8, hash, hashed, sig8) and RsaSignPkcs1v15(k1, hash, hashed, sig1) and
          (sig8 = want) and (sig1 = want) and (tc['result'].AsString <> 'invalid') then
          Inc(pass)
        else
        begin
          Inc(fail);
          WriteLn('FAIL ', fname, ' tcId ', tc['tcId'].AsInteger, ' ', tc['result'].AsString, ' ', tc['comment'].AsString);
        end;
      end;
    end;
    WriteLn(ExtractFileName(fname), ': ', groups, ' keys, ', ntc, ' tests, ', pass, ' signatures equal, ', fail, ' fail, ', skip, ' skipped');
    tpass := tpass + pass; tfail := tfail + fail; tskip := tskip + skip;
  end;
  WriteLn('total: ', tpass, ' signatures equal to the vectors, ', tfail, ' fail, ', tskip, ' skipped');
end.
