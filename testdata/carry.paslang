procedure F_varpar_0(ci: Int64);
var
  c: Int64;
begin
  Pz := AddCarry(-1, -1, 0, Pc);
  c := ci;
  Step(0, R[0], c, X[0], Y[0]);
  Step(0, R[1], c, X[1], Y[1]);
  Step(0, R[2], c, X[2], Y[2]);
  Step(0, R[3], c, X[3], Y[3]);
  Rc := c;
end;

