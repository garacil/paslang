program carry;

{ AddCarry and SubBorrow over four words (P508): every form of the carry
  variable, of the operands and of the carry in, with the boundary values
  of a and b and five carries in. The sums are checked against plain
  arithmetic here and their hash is the one scripts/gen_carry.py works
  out. }

type
  W4 = array[0..3] of Int64;
  P4 = record
    a0, a1, a2, a3: Int64;
  end;

const
  NV = 12;
  NC = 5;

var
  X, Y, R, KC, EX, EY: W4;
  Rc, Hh, Bad, Cases, GC, G2, Gq0, Gq1, Gq2, Gq3, Pz, Pc: Int64;
  VA: array[0..11] of Int64;
  CIS: array[0..4] of Int64;

function ULt(A, B: Int64): Boolean;
begin
  Result := (A xor Low(Int64)) < (B xor Low(Int64));
end;

procedure Fold(v: Int64);
begin
  Hh := (Hh xor v) * 1099511628211;
end;

{ the sum or the difference of two words and a carry, in plain arithmetic }
procedure RefStep(Op, a, b, c: Int64; var s, k: Int64);
var
  t: Int64;
begin
  c := Ord(c <> 0);
  if Op = 0 then
  begin
    s := a + b;
    t := Ord(ULt(s, a));
    s := s + c;
    k := t or Ord(ULt(s, c));
  end
  else
  begin
    s := a - b;
    t := Ord(ULt(a, b));
    k := t or Ord(ULt(s, c));
    s := s - c;
  end;
end;

procedure Judge(Op, WhichY, Cie: Int64);
var
  i, s, k: Int64;
  Z: W4;
  bad1: Boolean;
begin
  k := Cie;
  for i := 0 to 3 do
  begin
    case WhichY of
      0: RefStep(Op, X[i], Y[i], k, s, k);
      1: RefStep(Op, X[i], KC[i], k, s, k);
      3: RefStep(Op, EX[i], EY[i], k, s, k);
    else
      RefStep(Op, X[i], X[i], k, s, k);
    end;
    Z[i] := s;
  end;
  bad1 := (Rc <> k);
  for i := 0 to 3 do
    if R[i] <> Z[i] then
      bad1 := True;
  if bad1 then
    Inc(Bad);
  Inc(Cases);
  for i := 0 to 3 do
    Fold(R[i]);
  Fold(Rc);
end;

procedure Step(Op: Int64; var r, c: Int64; a, b: Int64);
begin
  if Op = 0 then
    r := AddCarry(a, b, c, c)
  else
    r := SubBorrow(a, b, c, c);
end;

procedure F_local_0(ci: Int64);
var
  a0, a1, a2, a3, b0, b1, b2, b3, r0, r1, r2, r3, c: Int64;
begin
  Pz := AddCarry(-1, -1, 0, Pc);
  a0 := X[0]; a1 := X[1]; a2 := X[2]; a3 := X[3];
  b0 := Y[0]; b1 := Y[1]; b2 := Y[2]; b3 := Y[3];
  r0 := AddCarry(a0, b0, ci, c);
  r1 := AddCarry(a1, b1, c, c);
  r2 := AddCarry(a2, b2, c, c);
  r3 := AddCarry(a3, b3, c, c);
  R[0] := r0; R[1] := r1; R[2] := r2; R[3] := r3; Rc := c;
end;

procedure F_local_1(ci: Int64);
var
  a0, a1, a2, a3, b0, b1, b2, b3, r0, r1, r2, r3, c: Int64;
begin
  Pz := SubBorrow(0, 1, 0, Pc);
  a0 := X[0]; a1 := X[1]; a2 := X[2]; a3 := X[3];
  b0 := Y[0]; b1 := Y[1]; b2 := Y[2]; b3 := Y[3];
  r0 := SubBorrow(a0, b0, ci, c);
  r1 := SubBorrow(a1, b1, c, c);
  r2 := SubBorrow(a2, b2, c, c);
  r3 := SubBorrow(a3, b3, c, c);
  R[0] := r0; R[1] := r1; R[2] := r2; R[3] := r3; Rc := c;
end;

