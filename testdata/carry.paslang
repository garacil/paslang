end;

procedure F_expr_0(ci: Int64);
var
  c: Int64;
begin
  Pz := AddCarry(-1, -1, 0, Pc);
  R[0] := AddCarry(X[0] and (-1), Y[0] or 0, ci, c);
  R[1] := AddCarry(X[1] xor 0, Y[1] + 0, c, c);
  R[2] := AddCarry(X[2] - 0, Y[2] * 1, c, c);
  R[3] := AddCarry(0 + X[3], Y[3] and $FFFFFFFFFFFFFFFF, c, c);
  Rc := c;
end;

