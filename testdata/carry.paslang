procedure F_rec_0(ci: Int64);
var
  P, Q, S: P4;
  c: Int64;
begin
  Pz := AddCarry(-1, -1, 0, Pc);
  P.a0 := X[0]; P.a1 := X[1]; P.a2 := X[2]; P.a3 := X[3];
  Q.a0 := Y[0]; Q.a1 := Y[1]; Q.a2 := Y[2]; Q.a3 := Y[3];
  S.a0 := AddCarry(P.a0, Q.a0, ci, c);
  S.a1 := AddCarry(P.a1, Q.a1, c, c);
  S.a2 := AddCarry(P.a2, Q.a2, c, c);
  S.a3 := AddCarry(P.a3, Q.a3, c, c);
  R[0] := S.a0; R[1] := S.a1; R[2] := S.a2; R[3] := S.a3; Rc := c;
end;

