var
  c: Int64;
begin
  Pz := AddCarry(-1, -1, 0, Pc);
  Gq0 := AddCarry(X[0], Y[0], ci, c);
  Gq1 := AddCarry(X[1], Y[1], c, c);
  Gq2 := AddCarry(X[2], Y[2], c, c);
  Gq3 := AddCarry(X[3], Y[3], c, c);
  R[0] := Gq0; R[1] := Gq1; R[2] := Gq2; R[3] := Gq3; Rc := c;
end;

procedure F_gdest_1(ci: Int64);
var
  c: Int64;
begin
  Pz := SubBorrow(0, 1, 0, Pc);
  Gq0 := SubBorrow(X[0], Y[0], ci, c);
  Gq1 := SubBorrow(X[1], Y[1], c, c);
  Gq2 := SubBorrow(X[2], Y[2], c, c);
  Gq3 := SubBorrow(X[3], Y[3], c, c);
  R[0] := Gq0; R[1] := Gq1; R[2] := Gq2; R[3] := Gq3; Rc := c;
end;

procedure F_upvar_0(ci: Int64);
var
  r0, r1, r2, r3, c: Int64;

  procedure Go;
  begin
    r0 := AddCarry(X[0], Y[0], ci, c);
    r1 := AddCarry(X[1], Y[1], c, c);
    r2 := AddCarry(X[2], Y[2], c, c);
    r3 := AddCarry(X[3], Y[3], c, c);
  end;

begin
  Pz := AddCarry(-1, -1, 0, Pc);
  Go;
  R[0] := r0; R[1] := r1; R[2] := r2; R[3] := r3; Rc := c;
end;

procedure F_upvar_1(ci: Int64);
var
  r0, r1, r2, r3, c: Int64;

  procedure Go;
  begin
    r0 := SubBorrow(X[0], Y[0], ci, c);
    r1 := SubBorrow(X[1], Y[1], c, c);
    r2 := SubBorrow(X[2], Y[2], c, c);
    r3 := SubBorrow(X[3], Y[3], c, c);
  end;

begin
  Pz := SubBorrow(0, 1, 0, Pc);
  Go;
  R[0] := r0; R[1] := r1; R[2] := r2; R[3] := r3; Rc := c;
end;

procedure F_narrow_0(ci: Int64);
var
  wa: Word;
  bb: Byte;
  sx, si: SmallInt;
  c: Int64;
begin
  Pz := AddCarry(-1, -1, 0, Pc);
  wa := Word(X[0] and $FFFF);
  bb := Byte(Y[0] and $FF);
  if X[1] < 0 then
    sx := -5
  else
    sx := 7;
  if Y[1] < 0 then
    si := -100
  else
    si := 100;
  EX[0] := wa; EX[1] := sx; EX[2] := X[2]; EX[3] := wa;
  EY[0] := bb; EY[1] := si; EY[2] := bb; EY[3] := Y[3];
  R[0] := AddCarry(wa, bb, ci, c);
  R[1] := AddCarry(sx, si, c, c);
  R[2] := AddCarry(X[2], bb, c, c);
  R[3] := AddCarry(wa, Y[3], c, c);
  Rc := c;
end;

procedure F_narrow_1(ci: Int64);
var
  wa: Word;
  bb: Byte;
  sx, si: SmallInt;
  c: Int64;
begin
  Pz := SubBorrow(0, 1, 0, Pc);
  wa := Word(X[0] and $FFFF);
  bb := Byte(Y[0] and $FF);
  if X[1] < 0 then
    sx := -5
  else
    sx := 7;
  if Y[1] < 0 then
    si := -100
  else
    si := 100;
  EX[0] := wa; EX[1] := sx; EX[2] := X[2]; EX[3] := wa;
  EY[0] := bb; EY[1] := si; EY[2] := bb; EY[3] := Y[3];
  R[0] := SubBorrow(wa, bb, ci, c);
  R[1] := SubBorrow(sx, si, c, c);
  R[2] := SubBorrow(X[2], bb, c, c);
  R[3] := SubBorrow(wa, Y[3], c, c);
  Rc := c;
end;

procedure F_elemcarry_0(ci: Int64);
var
  c: array[0..1] of Int64;
begin
  Pz := AddCarry(-1, -1, 0, Pc);
  R[0] := AddCarry(X[0], Y[0], ci, c[1]);
  R[1] := AddCarry(X[1], Y[1], c[1], c[1]);
  R[2] := AddCarry(X[2], Y[2], c[1], c[1]);
  R[3] := AddCarry(X[3], Y[3], c[1], c[1]);
  Rc := c[1];
end;

procedure F_elemcarry_1(ci: Int64);
var
  c: array[0..1] of Int64;
begin
  Pz := SubBorrow(0, 1, 0, Pc);
  R[0] := SubBorrow(X[0], Y[0], ci, c[1]);
  R[1] := SubBorrow(X[1], Y[1], c[1], c[1]);
  R[2] := SubBorrow(X[2], Y[2], c[1], c[1]);
  R[3] := SubBorrow(X[3], Y[3], c[1], c[1]);
  Rc := c[1];
end;

procedure F_fieldcarry_0(ci: Int64);
var
  c: P4;
begin
  Pz := AddCarry(-1, -1, 0, Pc);
  R[0] := AddCarry(X[0], Y[0], ci, c.a1);
  R[1] := AddCarry(X[1], Y[1], c.a1, c.a1);
  R[2] := AddCarry(X[2], Y[2], c.a1, c.a1);
  R[3] := AddCarry(X[3], Y[3], c.a1, c.a1);
  Rc := c.a1;
end;

procedure F_fieldcarry_1(ci: Int64);
var
  c: P4;
begin
  Pz := SubBorrow(0, 1, 0, Pc);
  R[0] := SubBorrow(X[0], Y[0], ci, c.a1);
  R[1] := SubBorrow(X[1], Y[1], c.a1, c.a1);
  R[2] := SubBorrow(X[2], Y[2], c.a1, c.a1);
  R[3] := SubBorrow(X[3], Y[3], c.a1, c.a1);
  Rc := c.a1;
end;

{ the calls whose value is used or dropped; each returns what it computed
  in R[0] and Rc, and a third word in R[1] }
procedure M_cond(Op, a, b, ci: Int64);
var
  c: Int64;
begin
  R[1] := 0;
  if Op = 0 then
  begin
    if AddCarry(a, b, ci, c) < 0 then
      R[1] := 1;
  end
  else if SubBorrow(a, b, ci, c) < 0 then
    R[1] := 1;
  R[0] := 0;
  Rc := c;
end;

procedure M_drop(Op, a, b, ci: Int64);
var
  c: Int64;
begin
  if Op = 0 then
    AddCarry(a, b, ci, c)
  else
    SubBorrow(a, b, ci, c);
  R[0] := 0;
  R[1] := 0;
  Rc := c;
end;

procedure M_nest(Op, a, b, ci: Int64);
var
  c1, c2: Int64;
begin
  if Op = 0 then
    R[0] := AddCarry(AddCarry(a, b, ci, c1), b, c1, c2)
  else
    R[0] := SubBorrow(SubBorrow(a, b, ci, c1), b, c1, c2);
  R[1] := c1;
  Rc := c2;
end;

procedure M_consta(Op, a, b, ci: Int64);
var
  c: Int64;
begin
  if Op = 0 then
    R[0] := AddCarry(-1, b, ci, c)
  else
    R[0] := SubBorrow(-1, b, ci, c);
  R[1] := 0;
  Rc := c;
end;

procedure M_bigb(Op, a, b, ci: Int64);
var
  c: Int64;
begin
  if Op = 0 then
    R[0] := AddCarry(a, $8000000000000000, ci, c)
  else
    R[0] := SubBorrow(a, $8000000000000000, ci, c);
  R[1] := 0;
  Rc := c;
end;

procedure M_big(Op, a, b, ci: Int64);
var
  c: Int64;
begin
  if Op = 0 then
    R[0] := AddCarry($FFFFFFFF00000000, $0123456789ABCDEF, ci, c)
  else
    R[0] := SubBorrow($FFFFFFFF00000000, $0123456789ABCDEF, ci, c);
  R[1] := 0;
  Rc := c;
end;

procedure M_mulhi(Op, a, b, ci: Int64);
var
  c: Int64;
begin
  if Op = 0 then
    R[0] := AddCarry(MulHi(a, b), a * b, ci, c)
  else
    R[0] := SubBorrow(MulHi(a, b), a * b, ci, c);
  R[1] := 0;
  Rc := c;
end;

procedure M_zero(Op, a, b, ci: Int64);
var
  c: Int64;
begin
  if Op = 0 then
  begin
    Pz := AddCarry(-1, -1, 0, Pc);
    R[0] := AddCarry(a, b, 0, c);
  end
  else
  begin
    Pz := SubBorrow(0, 1, 0, Pc);
    R[0] := SubBorrow(a, b, 0, c);
  end;
  R[1] := 0;
  Rc := c;
end;

procedure M_sumvar(Op, a, b, ci: Int64);
var
  c: Int64;
begin
  c := ci;
  if Op = 0 then
    R[0] := AddCarry(a, b, c, c)
  else
    R[0] := SubBorrow(a, b, c, c);
  R[1] := 0;
  Rc := c;
end;

procedure RunOne(Idx, ci: Int64);
begin
  case Idx of
    0:
      begin
        F_local_0(ci);
        Judge(0, 0, ci);
      end;
    1:
      begin
        F_local_1(ci);
        Judge(1, 0, ci);
      end;
    2:
      begin
        F_elems_0(ci);
        Judge(0, 0, ci);
      end;
    3:
      begin
        F_elems_1(ci);
        Judge(1, 0, ci);
      end;
    4:
      begin
        F_destarr_0(ci);
        Judge(0, 0, ci);
      end;
    5:
      begin
        F_destarr_1(ci);
        Judge(1, 0, ci);
      end;
    6:
      begin
        F_byte_0(ci);
        Judge(0, 0, ci);
      end;
    7:
      begin
        F_byte_1(ci);
        Judge(1, 0, ci);
      end;
    8:
      begin
        F_word_0(ci);
        Judge(0, 0, ci);
      end;
    9:
      begin
        F_word_1(ci);
        Judge(1, 0, ci);
      end;
    10:
      begin
        F_glob_0(ci);
        Judge(0, 0, ci);
      end;
    11:
      begin
        F_glob_1(ci);
        Judge(1, 0, ci);
      end;
    12:
      begin
        F_loop_0(ci);
        Judge(0, 0, ci);
      end;
    13:
      begin
        F_loop_1(ci);
        Judge(1, 0, ci);
      end;
    14:
      begin
        F_rec_0(ci);
        Judge(0, 0, ci);
      end;
    15:
      begin
        F_rec_1(ci);
        Judge(1, 0, ci);
      end;
    16:
      begin
        F_expr_0(ci);
        Judge(0, 0, ci);
      end;
    17:
      begin
        F_expr_1(ci);
        Judge(1, 0, ci);
      end;
    18:
      begin
        F_consts_0(ci);
        Judge(0, 1, ci);
      end;
    19:
      begin
        F_consts_1(ci);
        Judge(1, 1, ci);
      end;
    20:
      begin
        F_same_0(ci);
        Judge(0, 0, ci);
      end;
    21:
      begin
        F_same_1(ci);
        Judge(1, 0, ci);
      end;
    22:
      begin
        F_twice_0(ci);
        Judge(0, 2, ci);
      end;
    23:
      begin
        F_twice_1(ci);
        Judge(1, 2, ci);
      end;
    24:
      begin
        F_cineq_0(ci);
        Judge(0, 0, Ord(X[0] = Y[0]));
      end;
    25:
      begin
        F_cineq_1(ci);
        Judge(1, 0, Ord(X[0] = Y[0]));
      end;
    26:
      begin
        F_cinone_0(ci);
        Judge(0, 0, 1);
      end;
    27:
      begin
        F_cinone_1(ci);
        Judge(1, 0, 1);
      end;
    28:
      begin
        F_cinfive_0(ci);
        Judge(0, 0, 5);
      end;
    29:
      begin
        F_cinfive_1(ci);
        Judge(1, 0, 5);
      end;
    30:
      begin
        F_cinzero_0(ci);
        Judge(0, 0, 0);
      end;
    31:
      begin
        F_cinzero_1(ci);
        Judge(1, 0, 0);
      end;
    32:
      begin
        F_cinglob_0(ci);
        Judge(0, 0, ci);
      end;
    33:
      begin
        F_cinglob_1(ci);
        Judge(1, 0, ci);
      end;
    34:
      begin
        F_cinbyte_0(ci);
        Judge(0, 0, ci);
      end;
    35:
      begin
        F_cinbyte_1(ci);
        Judge(1, 0, ci);
      end;
    36:
      begin
        F_cinexpr_0(ci);
        Judge(0, 0, (ci and 6));
      end;
    37:
      begin
        F_cinexpr_1(ci);
        Judge(1, 0, (ci and 6));
      end;
    38:
      begin
        F_varpar_0(ci);
        Judge(0, 0, ci);
      end;
    39:
      begin
        F_varpar_1(ci);
        Judge(1, 0, ci);
      end;
    40:
      begin
        F_gdest_0(ci);
        Judge(0, 0, ci);
      end;
    41:
      begin
        F_gdest_1(ci);
        Judge(1, 0, ci);
      end;
    42:
      begin
        F_upvar_0(ci);
        Judge(0, 0, ci);
      end;
    43:
      begin
        F_upvar_1(ci);
        Judge(1, 0, ci);
      end;
    44:
      begin
        F_narrow_0(ci);
        Judge(0, 3, ci);
      end;
    45:
      begin
        F_narrow_1(ci);
        Judge(1, 3, ci);
      end;
    46:
      begin
        F_elemcarry_0(ci);
        Judge(0, 0, ci);
      end;
    47:
      begin
        F_elemcarry_1(ci);
        Judge(1, 0, ci);
      end;
    48:
      begin
        F_fieldcarry_0(ci);
        Judge(0, 0, ci);
      end;
    49:
      begin
        F_fieldcarry_1(ci);
        Judge(1, 0, ci);
      end;
  end;
end;

procedure Setup(a, b: Int64);
begin
  X[0] := a;
  X[1] := a xor b;
  X[2] := b;
  X[3] := a + b + 1;
  Y[0] := b;
  Y[1] := a;
  Y[2] := b xor 12345;
  Y[3] := a - 3;
end;

procedure Sweep(Idx: Int64; const Name: string);
var
  i, j, k: Int64;
begin
  Hh := $CBF29CE484222325;
  Bad := 0;
  Cases := 0;
  for i := 0 to NV - 1 do
    for j := 0 to NV - 1 do
      for k := 0 to NC - 1 do
      begin
        Setup(VA[i], VA[j]);
        RunOne(Idx, CIS[k]);
      end;
  WriteLn(Name, ' cases ', Cases, ' bad ', Bad, ' hash ', Hh);
end;

procedure MiscOne(Idx, Op, a, b, ci: Int64);
begin
  case Idx of
    0: M_cond(Op, a, b, ci);
    1: M_drop(Op, a, b, ci);
    2: M_nest(Op, a, b, ci);
    3: M_consta(Op, a, b, ci);
    4: M_bigb(Op, a, b, ci);
    5: M_big(Op, a, b, ci);
    6: M_mulhi(Op, a, b, ci);
    7: M_sumvar(Op, a, b, ci);
    8: M_zero(Op, a, b, ci);
  end;
end;

procedure SweepMisc(Idx, Op: Int64; const Name: string);
var
  i, j, k: Int64;
begin
  Hh := $CBF29CE484222325;
  Cases := 0;
  for i := 0 to NV - 1 do
    for j := 0 to NV - 1 do
      for k := 0 to NC - 1 do
      begin
        MiscOne(Idx, Op, VA[i], VA[j], CIS[k]);
        Fold(R[0]);
        Fold(R[1]);
        Fold(Rc);
        Inc(Cases);
      end;
  WriteLn(Name, ' cases ', Cases, ' hash ', Hh);
end;

var
  f: Int64;
begin
  KC[0] := $FFFFFFFF00000000;
  KC[1] := $FFFFFFFFFFFFFFFF;
  KC[2] := $5;
  KC[3] := $8000000000000000;
  VA[0] := 0;
  VA[1] := 1;
  VA[2] := 2;
  VA[3] := $7FFFFFFFFFFFFFFF;
  VA[4] := $8000000000000000;
  VA[5] := $8000000000000001;
  VA[6] := -2;
  VA[7] := -1;
  VA[8] := $FFFFFFFF;
  VA[9] := $100000000;
  VA[10] := $FFFFFFFF00000000;
  VA[11] := $0123456789ABCDEF;
  CIS[0] := 0;
  CIS[1] := 1;
  CIS[2] := 2;
  CIS[3] := -1;
  CIS[4] := 5;
  for f := 0 to 49 do
    case f of
      0: Sweep(f, 'local add');
      1: Sweep(f, 'local sub');
      2: Sweep(f, 'elems add');
      3: Sweep(f, 'elems sub');
      4: Sweep(f, 'destarr add');
      5: Sweep(f, 'destarr sub');
      6: Sweep(f, 'byte add');
      7: Sweep(f, 'byte sub');
      8: Sweep(f, 'word add');
      9: Sweep(f, 'word sub');
      10: Sweep(f, 'glob add');
      11: Sweep(f, 'glob sub');
      12: Sweep(f, 'loop add');
      13: Sweep(f, 'loop sub');
      14: Sweep(f, 'rec add');
      15: Sweep(f, 'rec sub');
      16: Sweep(f, 'expr add');
      17: Sweep(f, 'expr sub');
      18: Sweep(f, 'consts add');
      19: Sweep(f, 'consts sub');
      20: Sweep(f, 'same add');
      21: Sweep(f, 'same sub');
      22: Sweep(f, 'twice add');
      23: Sweep(f, 'twice sub');
      24: Sweep(f, 'cineq add');
      25: Sweep(f, 'cineq sub');
      26: Sweep(f, 'cinone add');
      27: Sweep(f, 'cinone sub');
      28: Sweep(f, 'cinfive add');
      29: Sweep(f, 'cinfive sub');
      30: Sweep(f, 'cinzero add');
      31: Sweep(f, 'cinzero sub');
      32: Sweep(f, 'cinglob add');
      33: Sweep(f, 'cinglob sub');
      34: Sweep(f, 'cinbyte add');
      35: Sweep(f, 'cinbyte sub');
      36: Sweep(f, 'cinexpr add');
      37: Sweep(f, 'cinexpr sub');
      38: Sweep(f, 'varpar add');
      39: Sweep(f, 'varpar sub');
      40: Sweep(f, 'gdest add');
      41: Sweep(f, 'gdest sub');
      42: Sweep(f, 'upvar add');
      43: Sweep(f, 'upvar sub');
      44: Sweep(f, 'narrow add');
      45: Sweep(f, 'narrow sub');
      46: Sweep(f, 'elemcarry add');
      47: Sweep(f, 'elemcarry sub');
      48: Sweep(f, 'fieldcarry add');
      49: Sweep(f, 'fieldcarry sub');
    end;
  SweepMisc(0, 0, 'misc cond add');
  SweepMisc(0, 1, 'misc cond sub');
  SweepMisc(1, 0, 'misc drop add');
  SweepMisc(1, 1, 'misc drop sub');
  SweepMisc(2, 0, 'misc nest add');
  SweepMisc(2, 1, 'misc nest sub');
  SweepMisc(3, 0, 'misc consta add');
  SweepMisc(3, 1, 'misc consta sub');
  SweepMisc(4, 0, 'misc bigb add');
  SweepMisc(4, 1, 'misc bigb sub');
  SweepMisc(5, 0, 'misc big add');
  SweepMisc(5, 1, 'misc big sub');
  SweepMisc(6, 0, 'misc mulhi add');
  SweepMisc(6, 1, 'misc mulhi sub');
  SweepMisc(7, 0, 'misc sumvar add');
  SweepMisc(7, 1, 'misc sumvar sub');
  SweepMisc(8, 0, 'misc zero add');
  SweepMisc(8, 1, 'misc zero sub');
end.

