  Q.a0 := Y[0]; Q.a1 := Y[1]; Q.a2 := Y[2]; Q.a3 := Y[3];
  S.a0 := SubBorrow(P.a0, Q.a0, ci, c);
  S.a1 := SubBorrow(P.a1, Q.a1, c, c);
  S.a2 := SubBorrow(P.a2, Q.a2, c, c);
