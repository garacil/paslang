program fwdptr;

{ Forward pointers (1.0.73): PNode = ^TNode before TNode must not touch
  ^Integer, Pointer or PInt. }

type
  PInt = ^Integer;
  PNode = ^TNode;
  PNode2 = ^TNode;
  TNode = record
    V: Integer;
    Next: PNode;
    Prev: ^TNode;
  end;
  PA = ^TA;
  PB = ^TB;
  TA = record
    X: Integer;
    B: PB;
  end;
  TB = record
    Y: string;
    A: PA;
  end;
  PC = ^TC;
  TC = TA;

var
  i: Integer;
  ip: PInt;
  p: Pointer;
  n: TNode;
  a: TA;
  b: TB;
  c: PC;
  head, q: PNode;
  q2: PNode2;
  k, sum: Integer;
  s: string;

procedure Local;
type
  PL = ^TL;
  TL = record
    S: string;
    Up: PL;
  end;
var
  l1, l2: PL;
begin
  New(l1);
  New(l2);
  l1^.S := 'local';
  l2^.S := 'ok';
  l2^.Up := l1;
  WriteLn(l2^.Up^.S, ' ', l2^.S, ' ', SizeOf(l1^));
end;

begin
  s := '';
  i := 41;
  ip := @i;
  ip^ := ip^ + 1;
  WriteLn(i, ' ', SizeOf(ip^));
  p := @i;
  WriteLn(PInt(p)^);
  n.V := 5;
  n.Next := @n;
  n.Prev := n.Next;
  WriteLn(n.Next^.V, ' ', n.Prev^.Next^.V, ' ', SizeOf(n.Next^));
  a.X := 1;
  b.Y := 'b';
  a.B := @b;
  b.A := @a;
  WriteLn(a.B^.Y, ' ', b.A^.X, ' ', SizeOf(a.B^), ' ', SizeOf(b.A^));
  c := @a;
  WriteLn(c^.X, ' ', c^.B^.Y, ' ', SizeOf(c^));
  { A heap list the collector walks through PNode and ^TNode fields. }
  head := nil;
  for k := 1 to 20000 do
  begin
    New(q);
    q^.V := k;
    q^.Next := head;
    q^.Prev := nil;
    if head <> nil then
      head^.Prev := q;
    head := q;
    if k mod 1000 = 0 then
      s := s + Chr(48 + (k div 1000) mod 10);
  end;
  sum := 0;
  q2 := head;
  while q2 <> nil do
  begin
    sum := sum + q2^.V;
    q2 := q2^.Next;
  end;
  WriteLn(sum, ' ', head^.Next^.Prev^.V, ' ', s);
  Local;
end.

