{ P291: a field of a record in the frame, at any depth of fields, is one
  load or one store addressed from rbp or x29. Every width is written
  and read, in a record near the frame pointer (within arm64's -256 to
  255 of LDUR and STUR) and in one past it, through nested records and
  Result; each line is what the code before P291 gives. }
program framefield;

type
  TInner = record
    B: Byte;
    S8: Int8;
    W: Word;
    S16: Int16;
    U32: UInt32;
    S32: Int32;
    Q: Integer;
  end;
  TOuter = record
    Head: Integer;
    In1: TInner;
    In2: TInner;
  end;

var
  g: TOuter;

function Fill(var r: TOuter; i: Integer): Integer;
begin
  Result := r.Head + r.In2.Q;
  r.Head := i;
end;

function Near(n: Integer): Integer;
var
  r: TOuter;
  i, t: Integer;
begin
  t := 0;
  r.Head := 0;
  for i := 1 to n do
  begin
    r.In1.B := Byte(i * 3);
    r.In1.S8 := Int8(i - 100);
    r.In1.W := Word(i * 1000);
    r.In1.S16 := Int16(i * 300 - 30000);
    r.In1.U32 := UInt32(i * 50000000);
    r.In1.S32 := Int32(i * 30000000 - 2000000000);
    r.In1.Q := i * 1000000007;
    r.In2.B := r.In1.B + 1;
    r.In2.Q := r.In1.Q - r.In1.S32;
    r.Head := r.Head + r.In1.B + r.In1.S8 + r.In1.W + r.In1.S16;
    t := t + r.In1.U32 + r.In1.S32 + r.In1.Q + r.In2.B + r.In2.Q;
  end;
  Result := t + r.Head + Fill(r, n) + r.Head;
end;

function Far(n: Integer): Integer;
var
  pad: array[0..40] of Integer;
  r: TOuter;
  i, t: Integer;
begin
  t := 0;
  r.Head := 0;
  pad[0] := 1;
  for i := 1 to n do
  begin
    r.In2.B := Byte(i * 7);
    r.In2.S8 := Int8(100 - i);
    r.In2.W := Word(i * 999);
    r.In2.S16 := Int16(30000 - i * 301);
    r.In2.U32 := UInt32(i * 70000001);
    r.In2.S32 := Int32(2000000000 - i * 30000001);
    r.In2.Q := -i * 1000000009;
    r.Head := r.Head + r.In2.B - r.In2.S8 + r.In2.W - r.In2.S16;
    t := t + r.In2.U32 - r.In2.S32 + r.In2.Q + pad[0];
  end;
  Result := t + r.Head;
end;

function MakeInner(i: Integer): TInner;
begin
  Result.B := Byte(i);
  Result.S8 := Int8(-i);
  Result.W := Word(i * 77);
  Result.S16 := Int16(-i * 77);
  Result.U32 := UInt32(i * 123456);
  Result.S32 := Int32(-i * 123456);
  Result.Q := i * 987654321;
end;

var
  k: TInner;

begin
  WriteLn(Near(1000));
  WriteLn(Far(1000));
  k := MakeInner(200);
  WriteLn(k.B, ' ', k.S8, ' ', k.W, ' ', k.S16, ' ', k.U32, ' ', k.S32, ' ', k.Q);
  g.In1.S16 := -5;
  g.In2.U32 := 4000000000;
  g.Head := g.In1.S16 + g.In2.U32;
  WriteLn(g.Head, ' ', Fill(g, 7), ' ', g.Head);
end.

