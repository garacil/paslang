{ P110: a B+ tree, a binary heap, FIPS 180-4 Sha256, RFC 9162 Merkle,
  and an LSM store that comes back after the process drops it. }
program tree1;

var
  t: tree[Integer] of Integer;
  h: heap of Integer;
  k, v, i, n: Integer;
  leaves: array of string;
  root, proof, dig: string;
  db: store;

begin
  New(t);
  for i := 0 to 40 do
    t[(i * 7) mod 41] := i;
  n := 0;
  for k, v in t do
    n := n + 1;
  WriteLn(n);
  WriteLn(Length(t));
  WriteLn(Rank(t, 10));
  WriteLn(t[3]);
  Delete(t, 3);
  WriteLn(Length(t));
  if 3 in t then
    WriteLn('still')
  else
    WriteLn('gone');
  dig := Sha256('');
  WriteLn(Hex(dig));
  dig := Sha256('abc');
  WriteLn(Hex(dig));
  SetLength(leaves, 3);
  leaves[0] := 'a';
  leaves[1] := 'b';
  leaves[2] := 'c';
  root := MerkleRoot(leaves);
  proof := MerkleProof(leaves, 1);
  if MerkleCheck('b', 1, 3, proof, root) then
    WriteLn('merkle')
  else
    WriteLn('bad merkle');
  New(h);
  Push(h, 3);
  Push(h, 1);
  Push(h, 2);
  Pop(h, k);
  WriteLn(k);
  Pop(h, k);
  WriteLn(k);
  db := StoreOpen('/tmp/paslang-tree1-store');
  StorePut(db, 'a', 'one');
  StorePut(db, 'b', 'two');
  StoreSync(db);
  StoreAbandon(db);
  db := StoreOpen('/tmp/paslang-tree1-store');
  WriteLn(StoreGet(db, 'a'));
  WriteLn(StoreGet(db, 'b'));
  StoreClose(db);
  db := StoreOpen('/tmp/paslang-tree1-store');
  WriteLn(StoreGet(db, 'a'));
  StoreAbandon(db);
end.

