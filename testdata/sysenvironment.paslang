program sysenvironment;
uses sysutils, paslinux, paslib;
const Workers = 128;
var original: TEnvironment; joined: waitgroup;

procedure InvalidEntry(const Item: string);
var value: TEnvironment; caught: Boolean;
begin
  caught := False;
  try value := TEnvironment.Create([Item]);
  except on EArgumentException do caught := True; end;
  if not caught then Halt(30);
end;

procedure Check(Index: Integer);
var local, changed, removed: TEnvironment; value: string;
  entries: TEnvironmentEntries; i: Integer;
begin
  local := original;
  SetLastOSError(Index + 1);
  for i := 1 to 16 do
  begin
    if not local.Lookup('PASLANG_ENV_CASE', value) or (value <> 'first') then Halt(2);
    value[1] := 'X';
    if not local.Lookup('PASLANG_ENV_CASE', value) or (value <> 'first') then Halt(3);
    if not LookupEnv('PASLANG_ENV_EMPTY', value) or (value <> '') then Halt(4);
    if not TryGetEnvironmentVariable('PASLANG_ENV_UTF8', value) or
      (value <> 'ni'#195#177'o'#233#155#170) then Halt(5);
    if GetEnvironmentVariable('PASLANG_ENV_EQUALS') <> 'a=b=c' then Halt(6);
    if not local.Lookup('paslang_env_case', value) or (value <> 'lower') then Halt(7);
    if local.Lookup('missing', value) or (value <> '') then Halt(8);
    if local.Lookup('', value) or local.Lookup('a=b', value) or local.Lookup('a'#0, value) then Halt(9);
    value := GetEnvironmentVariable('PASLANG_ENV_LONG');
    if (Length(value) <> 65000) or (value[1] <> 'x') or (value[65000] <> 'Z') then Halt(11);
    if value <> GetEnv('PASLANG_ENV_LONG') then Halt(10);
    entries := local.ToArray;
    if Length(entries) <> local.Count then Halt(12);
    entries[0] := 'PASLANG_ENV_CASE=bad';
    if not local.Lookup('PASLANG_ENV_CASE', value) or (value <> 'first') then Halt(13);
    changed := local.WithValue('PASLANG_ENV_CASE', IntToStr(Index));
    changed := changed.WithValue('added', '');
    removed := changed.WithoutValue('PASLANG_ENV_CASE');
    if removed.Lookup('PASLANG_ENV_CASE', value) or not removed.Lookup('added', value) then Halt(14);
    if not changed.Lookup('PASLANG_ENV_CASE', value) or (value <> IntToStr(Index)) then Halt(15);
    if not original.Lookup('PASLANG_ENV_CASE', value) or (value <> 'first') then Halt(16);
    if GetLastOSError <> Index + 1 then Halt(17);
    Yield;
  end;
  joined.Done;
end;

var value, item, mutated: string; entries: TEnvironmentEntries;
  environment: TEnvironment; count, i, duplicates, malformed: Integer;
begin
  original := TEnvironment.Current;
  count := GetEnvironmentVariableCount;
  if count <> ProcessEnvironmentCount then Halt(18);
  duplicates := 0;
  malformed := 0;
  for i := 1 to count do
  begin
    item := GetEnvironmentString(i);
    if item <> ProcessEnvironmentEntry(i) then Halt(19);
    mutated := item;
    if mutated <> '' then mutated[1] := '!';
    if GetEnvironmentString(i) <> item then Halt(20);
    if Copy(item, 1, 17) = 'PASLANG_ENV_CASE=' then Inc(duplicates);
    if (item = 'BROKEN') or (item = '=nameless') or (item = '') then Inc(malformed);
  end;
  if (GetEnvironmentString(0) <> '') or (GetEnvironmentString(count + 1) <> '') then Halt(21);
  if (original.Entry(0) <> '') or (original.Entry(original.Count + 1) <> '') then Halt(22);
  { QEMU linux-user/main.c populates envlist_setenv backwards: it
    keeps the first duplicate, but filters entries without '='.
    The native Linux ABI retains all ten entries from our C fixture. }
  if ParamStr(1) = 'qemu-normalized' then
  begin
    if (duplicates <> 1) or (malformed <> 1) then Halt(23);
  end
  else if (duplicates <> 2) or (malformed <> 3) then Halt(23);
  environment := TEnvironment.Create(['key=first', 'other=', 'key=last', 'KEY=case']);
  if (environment.Count <> 3) or not environment.Lookup('key', value) or (value <> 'last') then Halt(24);
  entries := environment.ToArray;
  entries[0] := 'key=changed';
  if environment.Entry(1) <> 'key=last' then Halt(25);
  environment := TEnvironment.Create([]);
  environment := environment.WithValue('key', 'value');
  environment := environment.WithoutValue('missing');
  environment := environment.WithoutValue('key');
  if environment.Count <> 0 then Halt(26);
  InvalidEntry(''); InvalidEntry('broken'); InvalidEntry('=nameless'); InvalidEntry('key=a'#0'b');
  joined.Add(Workers);
  for i := 0 to Workers - 1 do pas Check(i);
  GcCollect;
  joined.Wait;
  WriteLn('immutable environments, empty/missing, duplicates and owned copies');
  WriteLn('large UTF-8 values and concurrent lookups ', Workers);
end.
