program busy;

var
  done, i: Integer;

procedure Spin;
begin
  while done = 0 do
    i := i + 1;
  WriteLn(2);
end;

begin
  done := 0;
  i := 0;
  pas Spin;
  Sleep(80);
  WriteLn(1);
  done := 1;
end.

