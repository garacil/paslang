{ P556: a loop of a routine with a var or const open array parameter keeps the
  array's pointer and length in registers, loaded from the descriptor the
  parameter is the address of (nil when the array is empty), where it read
  both words again at every element. Each line checks one shape against the
  result worked out another way (a static array, a formula, a model): the
  loops of each form and element size, a sort (Hoare's partition, the routine
  that recurses with the array by reference), the arrays that are empty, and
  what changes the descriptor under a loop: a call that grows or shrinks the
  array, the array assigned through the parameter, through a global the
  parameter is the address of and through a second parameter that is the same
  variable, and the registers a call takes, which are loaded again after it. }
program descparts;

uses
  sysutils;

type
  TArr = array of Int64;
  TRec = record
    A: Int64;
    B: Byte;
  end;
  TRecs = array of TRec;
  TDbls = array of Double;
  TBytes2 = array of Byte;
  TBox = record
    F: TArr;
    N: Int64;
  end;

var
  fails: Integer;
  G, H: TArr;
  GB, GB2: TBox;
  Seed: Int64;
  Calls: Integer;

procedure Chk(const Name: string; Ok: Boolean);
begin
  if Ok then
    WriteLn('ok ', Name)
  else
  begin
    Inc(fails);
    WriteLn('FAIL ', Name);
  end;
end;

function Rnd(n: Integer): Integer;
begin
  Seed := Seed * 6364136223846793005 + 1442695040888963407;
  Result := (Seed shr 33) mod n;
end;

{ ---- loops of each form over a var or const parameter ---- }

function SumFor(const A: array of Int64): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i] * (i + 1);
end;

function SumWhile(var A: array of Int64): Int64;
var
  i: Integer;
begin
  Result := 0;
  i := 0;
  while i < Length(A) do
  begin
    Result := Result + A[i] * 3 - i;
    i := i + 1;
  end;
end;

function SumRepeat(const A: array of Int64): Int64;
var
  i: Integer;
begin
  Result := 0;
  i := 0;
  if Length(A) = 0 then
    Exit;
  repeat
    Result := Result * 7 + A[i];
    i := i + 1;
  until i > High(A);
end;

function Neighbours(const A: array of Int64): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to High(A) - 1 do
    Result := Result + A[i - 1] * 2 - A[i + 1] + A[i * 2 mod Length(A)];
end;

procedure Reverse(var A: array of Int64);
var
  i, j: Integer;
  t: Int64;
begin
  i := 0;
  j := High(A);
  while i < j do
  begin
    t := A[i];
    A[i] := A[j];
    A[j] := t;
    i := i + 1;
    j := j - 1;
  end;
end;

procedure Prefix(var A: array of Int64);
var
  i: Integer;
begin
  for i := 1 to High(A) do
    A[i] := A[i] + A[i - 1];
end;

function CountBytes(const A: array of Byte; v: Byte): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    if A[i] = v then
      Result := Result + 1;
end;

procedure FillWords(var A: array of Word);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := Word((i * 4099 + 17) and 65535);
end;

function SumDoubles(const A: array of Double): Double;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i] * 0.5;
end;

function SumRecs(var A: TRecs): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
  begin
    A[i].A := A[i].A + i;
    Result := Result + A[i].A + A[i].B;
  end;
end;

function TwoArrays(const A: array of Int64; var B: array of Int64): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
  begin
    B[i] := B[i] + A[i];
    Result := Result + B[i] - A[High(A) - i];
  end;
end;

procedure Matrix(const A, B: array of Int64; var C: array of Int64; n: Integer);
var
  i, j, k: Integer;
  s: Int64;
begin
  for i := 0 to n - 1 do
    for j := 0 to n - 1 do
    begin
      s := 0;
      for k := 0 to n - 1 do
        s := s + A[i * n + k] * B[k * n + j];
      C[i * n + j] := s;
    end;
end;

{ ---- Hoare's partition and a sort that recurses with the array by reference ---- }

procedure Ins(var A: array of Int64; Lo, Hi: Integer);
var
  i, j: Integer;
  v: Int64;
begin
  for i := Lo + 1 to Hi do
  begin
    v := A[i];
    j := i - 1;
    while (j >= Lo) and (A[j] > v) do
    begin
      A[j + 1] := A[j];
      j := j - 1;
    end;
    A[j + 1] := v;
  end;
end;

procedure Quick(var A: array of Int64; Lo, Hi: Integer);
var
  i, j, mid: Integer;
  p, t: Int64;
begin
  while Hi - Lo >= 12 do
  begin
    mid := Lo + (Hi - Lo) div 2;
    if A[mid] < A[Lo] then
    begin
      t := A[mid];
      A[mid] := A[Lo];
      A[Lo] := t;
    end;
    if A[Hi] < A[Lo] then
    begin
      t := A[Hi];
      A[Hi] := A[Lo];
      A[Lo] := t;
    end;
    if A[Hi] < A[mid] then
    begin
      t := A[Hi];
      A[Hi] := A[mid];
      A[mid] := t;
    end;
    p := A[mid];
    i := Lo;
    j := Hi;
    while i <= j do
    begin
      while A[i] < p do
        i := i + 1;
      while A[j] > p do
        j := j - 1;
      if i <= j then
      begin
        t := A[i];
        A[i] := A[j];
        A[j] := t;
        i := i + 1;
        j := j - 1;
      end;
    end;
    if (j - Lo) < (Hi - i) then
    begin
      Quick(A, Lo, j);
      Lo := i;
    end
    else
    begin
      Quick(A, i, Hi);
      Hi := j;
    end;
  end;
  Ins(A, Lo, Hi);
end;

{ ---- what changes the descriptor under a loop ---- }

procedure Grow(var A: TArr; n: Integer);
var
  i: Integer;
begin
  SetLength(A, n);
  for i := 0 to n - 1 do
    A[i] := 1000 + i;
end;

procedure Shrink(var A: TArr; n: Integer);
begin
  SetLength(A, n);
end;

procedure Swap(var A: TArr);
begin
  A := H;
end;

function Bump(k: Integer): Integer;
begin
  Calls := Calls + 1;
  Result := k + 1;
end;

{ a call that grows the array in the middle of the loop: the elements after
  it are read from the new buffer, the length is the new one }
function GrowInLoop(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  i := 0;
  while i < Length(A) do
  begin
    Result := Result + A[i];
    if i = 3 then
      Grow(A, 20);
    i := i + 1;
  end;
end;

{ the same with a shrink: the loop stops at the new length }
function ShrinkInLoop(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to Length(A) - 1 do
  begin
    if i >= Length(A) then
      Break;
    Result := Result + A[i];
    if i = 4 then
      Shrink(A, 6);
  end;
end;

{ the array assigned by a call, and by the parameter itself, in the loop }
function SwapInLoop(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 2 then
      Swap(A);
  end;
end;

function AssignInLoop(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 5 then
      A := H;
  end;
end;

{ A is the global G: G assigned in the loop, with no call }
function GlobalInLoop(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 3 then
      G := H;
  end;
end;

{ A and B are the same variable: B assigned, A read }
function SameVar(var A, B: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 4 then
      B := H;
  end;
end;

{ A is the array in the record GB, which a copy of another record writes in
  line, with no call }
function BlockInLoop(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 3 then
      GB := GB2;
  end;
end;

{ and the words of the record moved over it }
function MoveInLoop(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 3 then
      Move(GB2, GB, SizeOf(GB));
  end;
end;

{ a call in the key and in the loop's test: the registers it takes }
function CallsInLoop(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  i := 0;
  while i < Length(A) do
  begin
    Result := Result + A[i] * Bump(i);
    i := Bump(i);
  end;
end;

{ nothing the loop does is a call: the words are read once, the length is not }
function ManyLoops(var A: TArr): Int64;
var
  i, j: Integer;
begin
  Result := 0;
  for j := 1 to 3 do
    for i := 0 to High(A) do
      Result := Result + A[i] * j;
  Grow(A, 7);
  for j := 1 to 3 do
    for i := 0 to High(A) do
      Result := Result + A[i] * j;
end;

{ a nested routine reads the array of the routine around it: an up-level
  parameter, which no region keeps }
function Outer(var A: TArr): Int64;
  function Inner(k: Integer): Int64;
  var
    i: Integer;
  begin
    Result := 0;
    for i := 0 to High(A) do
      Result := Result + A[i] * k;
  end;
begin
  Result := Inner(2) + Inner(3);
  A[0] := 77;
  Result := Result + Inner(1);
end;

{ more values live in the loop than there are registers: the words of the
  array take what is left, one or both or none }
function Pressure(var A: TArr; k: Int64): Int64;
var
  i: Integer;
  a1, a2, a3, a4, a5, a6, a7, a8: Int64;
begin
  a1 := k;
  a2 := k + 1;
  a3 := k + 2;
  a4 := k + 3;
  a5 := k + 4;
  a6 := k + 5;
  a7 := k + 6;
  a8 := k + 7;
  for i := 0 to High(A) do
  begin
    a1 := a1 + A[i];
    a2 := a2 xor (a1 + i);
    a3 := a3 + a2 - A[High(A) - i];
    a4 := a4 xor a3;
    a5 := a5 + a4 * 3;
    a6 := a6 - a5 + A[i];
    a7 := a7 + a6;
    a8 := a8 xor a7;
  end;
  Result := a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8;
end;

function PressureRef(const A: array of Int64; k: Int64): Int64;
var
  i: Integer;
  a1, a2, a3, a4, a5, a6, a7, a8: Int64;
  st: array[0..63] of Int64;
begin
  for i := 0 to High(A) do
    st[i] := A[i];
  a1 := k;
  a2 := k + 1;
  a3 := k + 2;
  a4 := k + 3;
  a5 := k + 4;
  a6 := k + 5;
  a7 := k + 6;
  a8 := k + 7;
  for i := 0 to High(A) do
  begin
    a1 := a1 + st[i];
    a2 := a2 xor (a1 + i);
    a3 := a3 + a2 - st[High(A) - i];
    a4 := a4 xor a3;
    a5 := a5 + a4 * 3;
    a6 := a6 - a5 + st[i];
    a7 := a7 + a6;
    a8 := a8 xor a7;
  end;
  Result := a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8;
end;

{ four values and the loop's own take all but one of the registers a region
  with a call has: the array's pointer may get it and its length none, and
  the elements are read through memory then, the length checked there }
function Squeeze(var A: TArr; k: Int64; hi: Integer): Int64;
var
  i, rd: Integer;
  s1, s2, s3, s4: Int64;
begin
  s1 := k; s2 := k + 1; s3 := k + 2; s4 := k + 3;
  for rd := 0 to 2 do
  begin
    for i := 0 to hi do
    begin
      s1 := s1 + A[i] + s2;
      s2 := s2 xor s1 + s3;
      s3 := s3 + s2 xor s4;
      s4 := s4 + s3 - s1;
      s1 := s1 xor s4 + s1;
      s1 := s1 + s1 xor A[hi - i];
      s2 := s2 + s1 + s3;
      s3 := s3 xor s2 + s4;
      s4 := s4 + s3 xor s1;
      s1 := s1 + s4 + s1;
    end;
    s1 := Bump(s1);
  end;
  Result := s1 + s2 + s3 + s4;
end;

function SqueezeRef(const B: array of Int64; k: Int64; hi: Integer): Int64;
var
  A: array[0..63] of Int64;
  i, rd: Integer;
  s1, s2, s3, s4: Int64;
begin
  for i := 0 to High(B) do
    A[i] := B[i];
  s1 := k; s2 := k + 1; s3 := k + 2; s4 := k + 3;
  for rd := 0 to 2 do
  begin
    for i := 0 to hi do
    begin
      s1 := s1 + A[i] + s2;
      s2 := s2 xor s1 + s3;
      s3 := s3 + s2 xor s4;
      s4 := s4 + s3 - s1;
      s1 := s1 xor s4 + s1;
      s1 := s1 + s1 xor A[hi - i];
      s2 := s2 + s1 + s3;
      s3 := s3 xor s2 + s4;
      s4 := s4 + s3 xor s1;
      s1 := s1 + s4 + s1;
    end;
    s1 := Bump(s1);
  end;
  Result := s1 + s2 + s3 + s4;
end;

{ the same over records, whose elements are reached by their addresses }
function SqueezeR(var A: TRecs; k: Int64; hi: Integer): Int64;
var
  i, rd: Integer;
  s1, s2, s3, s4: Int64;
begin
  s1 := k; s2 := k + 1; s3 := k + 2; s4 := k + 3;
  for rd := 0 to 2 do
  begin
    for i := 0 to hi do
    begin
      s1 := s1 + A[i].A + s2;
      s2 := s2 xor s1 + s3;
      s3 := s3 + s2 xor s4;
      s4 := s4 + s3 - s1;
      s1 := s1 xor s4 + s1;
      s1 := s1 + s1 xor A[hi - i].A;
      s2 := s2 + s1 + s3;
      s3 := s3 xor s2 + s4;
      s4 := s4 + s3 xor s1;
      s1 := s1 + s4 + s1;
    end;
    s1 := Bump(s1);
  end;
  Result := s1 + s2 + s3 + s4;
end;

function SqueezeRRef(const B: array of TRec; k: Int64; hi: Integer): Int64;
var
  A: array[0..63] of TRec;
  i, rd: Integer;
  s1, s2, s3, s4: Int64;
begin
  for i := 0 to High(B) do
    A[i] := B[i];
  s1 := k; s2 := k + 1; s3 := k + 2; s4 := k + 3;
  for rd := 0 to 2 do
  begin
    for i := 0 to hi do
    begin
      s1 := s1 + A[i].A + s2;
      s2 := s2 xor s1 + s3;
      s3 := s3 + s2 xor s4;
      s4 := s4 + s3 - s1;
      s1 := s1 xor s4 + s1;
      s1 := s1 + s1 xor A[hi - i].A;
      s2 := s2 + s1 + s3;
      s3 := s3 xor s2 + s4;
      s4 := s4 + s3 xor s1;
      s1 := s1 + s4 + s1;
    end;
    s1 := Bump(s1);
  end;
  Result := s1 + s2 + s3 + s4;
end;

{ and over Doubles, which are loaded by their addresses }
function SqueezeD(var A: TDbls; k: Int64; hi: Integer): Int64;
var
  i, rd: Integer;
  s1, s2, s3, s4: Int64;
begin
  s1 := k; s2 := k + 1; s3 := k + 2; s4 := k + 3;
  for rd := 0 to 2 do
  begin
    for i := 0 to hi do
    begin
      s1 := s1 + Trunc(A[i]) + s2;
      s2 := s2 xor s1 + s3;
      s3 := s3 + s2 xor s4;
      s4 := s4 + s3 - s1;
      s1 := s1 xor s4 + s1;
      s1 := s1 + s1 xor Trunc(A[hi - i]);
      s2 := s2 + s1 + s3;
      s3 := s3 xor s2 + s4;
      s4 := s4 + s3 xor s1;
      s1 := s1 + s4 + s1;
    end;
    s1 := Bump(s1);
  end;
  Result := s1 + s2 + s3 + s4;
end;

function SqueezeDRef(const B: array of Double; k: Int64; hi: Integer): Int64;
var
  A: array[0..63] of Double;
  i, rd: Integer;
  s1, s2, s3, s4: Int64;
begin
  for i := 0 to High(B) do
    A[i] := B[i];
  s1 := k; s2 := k + 1; s3 := k + 2; s4 := k + 3;
  for rd := 0 to 2 do
  begin
    for i := 0 to hi do
    begin
      s1 := s1 + Trunc(A[i]) + s2;
      s2 := s2 xor s1 + s3;
      s3 := s3 + s2 xor s4;
      s4 := s4 + s3 - s1;
      s1 := s1 xor s4 + s1;
      s1 := s1 + s1 xor Trunc(A[hi - i]);
      s2 := s2 + s1 + s3;
      s3 := s3 xor s2 + s4;
      s4 := s4 + s3 xor s1;
      s1 := s1 + s4 + s1;
    end;
    s1 := Bump(s1);
  end;
  Result := s1 + s2 + s3 + s4;
end;

procedure Fill(var A: TArr; n: Integer);
var
  i: Integer;
begin
  SetLength(A, n);
  for i := 0 to n - 1 do
    A[i] := (i * 7919 + 13) mod 1009 - 500;
end;

procedure Models;
var
  a, b, c: TArr;
  by: TBytes2;
  w: array of Word;
  d: array of Double;
  rc: TRecs;
  st: array[0..39] of Int64;
  sw: array[0..99] of Word;
  i, k, n, bad: Integer;
  s: Int64;
  x: Double;
begin
  { sums of each form against a static array }
  Fill(a, 40);
  for i := 0 to 39 do
    st[i] := a[i];
  s := 0;
  for i := 0 to 39 do
    s := s + st[i] * (i + 1);
  Chk('for', SumFor(a) = s);
  s := 0;
  for i := 0 to 39 do
    s := s + st[i] * 3 - i;
  Chk('while', SumWhile(a) = s);
  s := 0;
  for i := 0 to 39 do
    s := s * 7 + st[i];
  Chk('repeat', SumRepeat(a) = s);
  s := 0;
  for i := 1 to 38 do
    s := s + st[i - 1] * 2 - st[i + 1] + st[(i * 2) mod 40];
  Chk('neighbours', Neighbours(a) = s);
  Reverse(a);
  bad := 0;
  for i := 0 to 39 do
    if a[i] <> st[39 - i] then
      bad := bad + 1;
  Chk('reverse', bad = 0);
  Prefix(a);
  s := 0;
  bad := 0;
  for i := 0 to 39 do
  begin
    s := s + st[39 - i];
    if a[i] <> s then
      bad := bad + 1;
  end;
  Chk('prefix', bad = 0);
  { other element sizes }
  SetLength(by, 300);
  for i := 0 to 299 do
    by[i] := Byte((i * 37 + 11) and 255);
  n := 0;
  for i := 0 to 299 do
    if by[i] = 11 then
      n := n + 1;
  Chk('bytes', CountBytes(by, 11) = n);
  SetLength(w, 100);
  FillWords(w);
  for i := 0 to 99 do
    sw[i] := Word((i * 4099 + 17) and 65535);
  bad := 0;
  for i := 0 to 99 do
    if w[i] <> sw[i] then
      bad := bad + 1;
  Chk('words', bad = 0);
  SetLength(d, 33);
  x := 0;
  for i := 0 to 32 do
  begin
    d[i] := i * 0.25;
    x := x + d[i] * 0.5;
  end;
  Chk('doubles', SumDoubles(d) = x);
  SetLength(rc, 20);
  s := 0;
  for i := 0 to 19 do
  begin
    rc[i].A := i * 11;
    rc[i].B := Byte(i);
    s := s + i * 11 + i + i;
  end;
  Chk('records', SumRecs(rc) = s);
  { two arrays, a product }
  Fill(a, 25);
  Fill(b, 25);
  for i := 0 to 24 do
    b[i] := b[i] * 2;
  s := 0;
  for i := 0 to 24 do
    st[i] := b[i] + a[i];
  for i := 0 to 24 do
    s := s + st[i] - a[24 - i];
  Chk('two', TwoArrays(a, b) = s);
  Fill(a, 36);
  Fill(b, 36);
  SetLength(c, 36);
  for i := 0 to 35 do
    b[i] := b[i] mod 17;
  Matrix(a, b, c, 6);
  bad := 0;
  for n := 0 to 5 do
    for i := 0 to 5 do
    begin
      s := 0;
      for k := 0 to 5 do
        s := s + a[n * 6 + k] * b[k * 6 + i];
      if c[n * 6 + i] <> s then
        bad := bad + 1;
    end;
  Chk('matrix', bad = 0);
end;

procedure Sorts;
var
  a, b: TArr;
  i, n, r, bad: Integer;
  s1, s2: Int64;
begin
  bad := 0;
  for r := 1 to 60 do
  begin
    n := Rnd(3000);
    SetLength(a, n);
    SetLength(b, n);
    s1 := 0;
    for i := 0 to n - 1 do
    begin
      case r mod 4 of
        0: a[i] := Rnd(1000000) - 500000;
        1: a[i] := Rnd(5);
        2: a[i] := i;
        3: a[i] := n - i;
      end;
      b[i] := a[i];
      s1 := s1 + a[i] * a[i] mod 1009;
    end;
    if n > 0 then
      Quick(a, 0, n - 1);
    for i := 1 to n - 1 do
      if a[i - 1] > a[i] then
        bad := bad + 1;
    { the sort moved the values and lost none: the same sum of squares }
    s2 := 0;
    for i := 0 to n - 1 do
      s2 := s2 + a[i] * a[i] mod 1009;
    if s1 <> s2 then
      bad := bad + 1;
  end;
  Chk('sort', bad = 0);
end;

procedure Empty;
var
  e, f: TArr;
  by: TBytes2;
  p: ^TArr;
  s: Int64;
begin
  { a nil pointer's target is an empty array: its descriptor's address is nil }
  p := nil;
  Chk('nil descriptor', (SumFor(p^) = 0) and (SumWhile(p^) = 0) and (SumRepeat(p^) = 0));
  Reverse(p^);
  Prefix(p^);
  Chk('nil loops', Neighbours(p^) = 0);
  s := SumFor(e) + SumWhile(e) + SumRepeat(e) + Neighbours(f);
  Chk('empty sums', s = 0);
  Reverse(e);
  Prefix(e);
  SetLength(f, 0);
  Reverse(f);
  Chk('empty loops', (Length(e) = 0) and (Length(f) = 0));
  Chk('empty bytes', CountBytes(by, 0) = 0);
  SetLength(f, 1);
  f[0] := 5;
  Chk('one', (SumFor(f) = 5) and (SumWhile(f) = 15) and (SumRepeat(f) = 5));
  Fill(e, 3);
  Chk('after empty', SumFor(e) = e[0] + 2 * e[1] + 3 * e[2]);
end;

procedure Changes;
var
  a, b: TArr;
  rc: TRecs;
  dv: TDbls;
  i: Integer;
  s: Int64;
begin
  Fill(H, 40);
  for i := 0 to 39 do
    H[i] := H[i] + 7777;
  { grown in the loop: four elements of the old, the others of the new }
  Fill(a, 6);
  s := a[0] + a[1] + a[2] + a[3];
  for i := 4 to 19 do
    s := s + 1000 + i;
  Chk('grow', GrowInLoop(a) = s + 0);
  Chk('grown', (Length(a) = 20) and (a[19] = 1019));
  { shrunk: the elements up to the fifth, then the loop stops }
  Fill(a, 12);
  s := a[0] + a[1] + a[2] + a[3] + a[4] + a[5];
  Chk('shrink', ShrinkInLoop(a) = s);
  Chk('shrunk', Length(a) = 6);
  { assigned by a call: three elements of the old, the rest of H }
  Fill(a, 10);
  s := a[0] + a[1] + a[2];
  for i := 3 to 9 do
    s := s + H[i];
  Chk('swap', SwapInLoop(a) = s);
  Fill(a, 10);
  s := 0;
  for i := 0 to 5 do
    s := s + a[i];
  for i := 6 to 9 do
    s := s + H[i];
  Chk('assign', AssignInLoop(a) = s);
  { A is the global G, assigned with no call }
  Fill(G, 10);
  s := G[0] + G[1] + G[2] + G[3];
  for i := 4 to 9 do
    s := s + H[i];
  Chk('global', GlobalInLoop(G) = s);
  { A in a record, the record copied over in line }
  Fill(GB.F, 10);
  Fill(GB2.F, 40);
  for i := 0 to 39 do
    GB2.F[i] := GB2.F[i] + 5555;
  s := GB.F[0] + GB.F[1] + GB.F[2] + GB.F[3];
  for i := 4 to 9 do
    s := s + GB2.F[i];
  Chk('block', BlockInLoop(GB.F) = s);
  Fill(GB.F, 10);
  s := GB.F[0] + GB.F[1] + GB.F[2] + GB.F[3];
  for i := 4 to 9 do
    s := s + GB2.F[i];
  Chk('move', MoveInLoop(GB.F) = s);
  { A and B the same variable }
  Fill(b, 10);
  s := b[0] + b[1] + b[2] + b[3] + b[4];
  for i := 5 to 9 do
    s := s + H[i];
  Chk('same', SameVar(b, b) = s);
  { calls in the loop }
  Fill(a, 10);
  Calls := 0;
  s := 0;
  i := 0;
  while i < 10 do
  begin
    s := s + a[i] * (i + 1);
    i := i + 1;
  end;
  Chk('calls', (CallsInLoop(a) = s) and (Calls = 20));
  { loops, a call that grows, loops }
  Fill(a, 5);
  s := 0;
  for i := 0 to 4 do
    s := s + a[i] * 6;
  for i := 0 to 6 do
    s := s + (1000 + i) * 6;
  Chk('many', ManyLoops(a) = s);
  { a nested routine }
  Fill(a, 17);
  s := 0;
  for i := 0 to 16 do
    s := s + a[i];
  s := 5 * s + (s - a[0] + 77);
  Chk('nested', Outer(a) = s);
  { registers short }
  Fill(a, 50);
  Chk('pressure', Pressure(a, 3) = PressureRef(a, 3));
  Fill(a, 1);
  Chk('pressure one', Pressure(a, 9) = PressureRef(a, 9));
  Fill(a, 30);
  Chk('squeeze', Squeeze(a, 5, 29) = SqueezeRef(a, 5, 29));
  Chk('squeeze short', Squeeze(a, 7, 11) = SqueezeRef(a, 7, 11));
  SetLength(rc, 25);
  for i := 0 to 24 do
  begin
    rc[i].A := a[i] mod 100 + i;
    rc[i].B := Byte(i);
  end;
  Chk('squeeze records', SqueezeR(rc, 5, 24) = SqueezeRRef(rc, 5, 24));
  Chk('squeeze records short', SqueezeR(rc, 2, 9) = SqueezeRRef(rc, 2, 9));
  SetLength(dv, 25);
  for i := 0 to 24 do
    dv[i] := a[i] mod 100 + i * 0.5;
  Chk('squeeze doubles', SqueezeD(dv, 5, 24) = SqueezeDRef(dv, 5, 24));
  Chk('squeeze doubles short', SqueezeD(dv, 2, 9) = SqueezeDRef(dv, 2, 9));
end;

begin
  Seed := 12345;
  Models;
  Sorts;
  Empty;
  Changes;
  if fails = 0 then
    WriteLn('all ok')
  else
    WriteLn('fails ', fails);
end.
