{ A var parameter past the sixth travels on the stack; forwarded through
  two routines that call each other while the stack grows, its address
  must move with the stack (1.1.1: the map of the words left for a call
  had the classes of the first arguments; make check also runs this under
  PASLANG_GCVERIFY, where the old stack is poisoned). }
program stackargs;
var
  total: Integer;
  wg: WaitGroup;

function Deep(N: Integer): Integer;
var
  pad: array[0..255] of Integer;
begin
  pad[N mod 256] := N;
  if N = 0 then
    Result := pad[0]
  else
    Result := Deep(N - 1) + pad[N mod 256] - N + 1;
end;

procedure InsertSepX(A1, A2, A3, A4, A5, A6: Integer; var Depth: Integer; var NewRoot: Boolean); forward;

procedure SplitInnerX(A1, A2, A3: Integer; var Depth: Integer; var NewRoot: Boolean);
begin
  total := total + Deep(300 + A1 * 100);
  InsertSepX(A1, A2, A3, 1, 2, 3, Depth, NewRoot);
end;

procedure InsertSepX(A1, A2, A3, A4, A5, A6: Integer; var Depth: Integer; var NewRoot: Boolean);
begin
  if A1 > 0 then
  begin
    SplitInnerX(A1 - 1, A2, A3, Depth, NewRoot);
    Depth := Depth + 1;
  end;
  NewRoot := True;
end;

procedure Caller;
var
  depth: Integer;
  newRoot: Boolean;
begin
  depth := 0;
  newRoot := False;
  InsertSepX(3, 0, 0, 0, 0, 0, depth, newRoot);
  WriteLn(depth, ' ', newRoot, ' ', total);
  wg.Done;
end;

begin
  wg.Add(1);
  pas Caller;
  wg.Wait;
end.

