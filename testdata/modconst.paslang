begin
  Result := x mod 1000000007;
end;

function Loop3(n: Integer): Integer;
var
  k, a, d, e, t: Integer;
begin
  t := 0;
  for k := 0 to n - 1 do
  begin
    a := ys[k and 7];
    d := a * 3;
    e := 3 * k;
    d := d * 3;
    e := e + xs[k and 15] mod 3;
    t := (t xor d) + e;
  end;
  Result := t;
end;

function Glob3(j: Integer): Integer;
begin
  g := ys[j];
  g := g * 3;
  g := g + xs[j + 8] mod 3;
  Result := g;
end;

