  WriteLn('mul 100 ', Loop100(16), ' ', Loop100(3), ' ', Glob100(3), ' ', Glob100(6));
  WriteLn('mul 131 ', Loop131(16), ' ', Loop131(3), ' ', Glob131(3), ' ', Glob131(6));
  WriteLn('mul 641 ', Loop641(16), ' ', Loop641(3), ' ', Glob641(3), ' ', Glob641(6));
  WriteLn('mul 1000 ', Loop1000(16), ' ', Loop1000(3), ' ', Glob1000(3), ' ', Glob1000(6));
