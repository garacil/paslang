  g := g + xs[j + 8] mod 1;
  Result := g;
end;

var
  i: Integer;
begin
  xs[0] := 0;
  xs[1] := 1;
  xs[2] := -1;
  xs[3] := 2;
  xs[4] := -2;
  xs[5] := 9223372036854775807;
  xs[6] := Low(Integer);
  xs[7] := -9223372036854775807;
  xs[8] := 9223372036854775806;
  xs[9] := 1000000006;
  xs[10] := -1000000008;
  xs[11] := 4611686018427387904;
  xs[12] := -4611686018427387905;
  xs[13] := 123456789012345678;
  xs[14] := -987654321098765432;
  xs[15] := 999999999999;
  ys[0] := 0;
  ys[1] := 1;
  ys[2] := -1;
  ys[3] := 65535;
  ys[4] := -65536;
  ys[5] := 4097;
  ys[6] := -12345;
  ys[7] := 30000;
  Write('mod 3');
  for i := 0 to 15 do
    Write(' ', M3(xs[i]));
  WriteLn;
  Write('mod 5');
  for i := 0 to 15 do
    Write(' ', M5(xs[i]));
  WriteLn;
  Write('mod 6');
  for i := 0 to 15 do
    Write(' ', M6(xs[i]));
  WriteLn;
  Write('mod 7');
  for i := 0 to 15 do
    Write(' ', M7(xs[i]));
  WriteLn;
  Write('mod 9');
  for i := 0 to 15 do
    Write(' ', M9(xs[i]));
  WriteLn;
  Write('mod 10');
  for i := 0 to 15 do
    Write(' ', M10(xs[i]));
  WriteLn;
  Write('mod 11');
  for i := 0 to 15 do
    Write(' ', M11(xs[i]));
  WriteLn;
  Write('mod 12');
  for i := 0 to 15 do
    Write(' ', M12(xs[i]));
  WriteLn;
  Write('mod 13');
  for i := 0 to 15 do
    Write(' ', M13(xs[i]));
  WriteLn;
  Write('mod 24');
  for i := 0 to 15 do
    Write(' ', M24(xs[i]));
  WriteLn;
  Write('mod 25');
  for i := 0 to 15 do
    Write(' ', M25(xs[i]));
  WriteLn;
  Write('mod 26');
  for i := 0 to 15 do
    Write(' ', M26(xs[i]));
  WriteLn;
  Write('mod 37');
  for i := 0 to 15 do
    Write(' ', M37(xs[i]));
  WriteLn;
  Write('mod 40');
  for i := 0 to 15 do
    Write(' ', M40(xs[i]));
  WriteLn;
  Write('mod 48');
  for i := 0 to 15 do
    Write(' ', M48(xs[i]));
  WriteLn;
  Write('mod 100');
  for i := 0 to 15 do
    Write(' ', M100(xs[i]));
  WriteLn;
  Write('mod 131');
  for i := 0 to 15 do
    Write(' ', M131(xs[i]));
  WriteLn;
  Write('mod 641');
  for i := 0 to 15 do
    Write(' ', M641(xs[i]));
  WriteLn;
  Write('mod 1000');
  for i := 0 to 15 do
    Write(' ', M1000(xs[i]));
  WriteLn;
  Write('mod 7919');
  for i := 0 to 15 do
    Write(' ', M7919(xs[i]));
  WriteLn;
  Write('mod 1000000007');
  for i := 0 to 15 do
    Write(' ', M1000000007(xs[i]));
  WriteLn;
  WriteLn('mul 3 ', Loop3(16), ' ', Loop3(3), ' ', Glob3(3), ' ', Glob3(6));
  WriteLn('mul 5 ', Loop5(16), ' ', Loop5(3), ' ', Glob5(3), ' ', Glob5(6));
  WriteLn('mul 6 ', Loop6(16), ' ', Loop6(3), ' ', Glob6(3), ' ', Glob6(6));
  WriteLn('mul 7 ', Loop7(16), ' ', Loop7(3), ' ', Glob7(3), ' ', Glob7(6));
  WriteLn('mul 9 ', Loop9(16), ' ', Loop9(3), ' ', Glob9(3), ' ', Glob9(6));
  WriteLn('mul 10 ', Loop10(16), ' ', Loop10(3), ' ', Glob10(3), ' ', Glob10(6));
  WriteLn('mul 11 ', Loop11(16), ' ', Loop11(3), ' ', Glob11(3), ' ', Glob11(6));
  WriteLn('mul 12 ', Loop12(16), ' ', Loop12(3), ' ', Glob12(3), ' ', Glob12(6));
