{ P453: pashttp reads a head fed in small pieces in time linear in its size.
  A response head of many fields (and one with a single line of 600 KB, and one
  that is over the limit) is fed whole, one byte at a time and in pieces of 7, 3
  and 1,000 bytes; the reader must give the same fields and the same errors, and
  must not take the time of a parse from the start at every byte (a head of 5 KB
  took 300 ms, one of 600 KB hours). Under the collector's stress the heads are a
  tenth of the size; nothing printed depends on the size. }
program httpslow;

uses
  sysutils, pascodec, pastextproto, pasurl, pashttp;

var
  Div10: Integer;

function Sum(const S: string): string;
begin
  Result := IntToStr(Length(S)) + ':' + IntToStr(Crc32(S));
end;

function MakeHead(Fields: Integer): string;
var
  i: Integer;
begin
  Result := 'HTTP/1.1 200 OK' + #13#10;
  for i := 1 to Fields do
    Result := Result + 'X-Header-' + IntToStr(i) + ': value ' + IntToStr(i) + #13#10;
  Result := Result + 'Content-Length: 5' + #13#10 + #13#10 + 'hello';
end;

{ the head fed in pieces of Step bytes (0: whole); what it gave or the error }
function Run(const Msg: string; Step: Integer; Limit: Integer): string;
var
  r: THttpMessageReader;
  i, n: Integer;
begin
  r := THttpMessageReader.Create(False, 'GET');
  if Limit > 0 then
    r.MaxHeaderBytes := Limit;
  try
    if Step = 0 then
      r.Feed(Msg)
    else
    begin
      i := 1;
      while i <= Length(Msg) do
      begin
        n := Step;
        if i + n - 1 > Length(Msg) then
          n := Length(Msg) - i + 1;
        r.Feed(Copy(Msg, i, n));
        i := i + n;
      end;
    end;
    r.AtEof;
    Result := 'status ' + IntToStr(r.Head.Status) + ' fields ' + IntToStr(r.Head.Fields.Count) + ' ' + Sum(r.Head.Fields.Text) + ' body ' + Sum(r.TakeBody);
  except
    on E: EHttpMsgError do
      Result := 'error ' + E.Message + ' toolarge ' + BoolToStr(E.TooLarge, True);
  end;
end;

{ what whole says without the numbers that follow the size of the head }
function Brief(const S: string): string;
var
  p: Integer;
begin
  p := Pos(' fields ', S);
  if p > 0 then
    Result := Copy(S, 1, p - 1)
  else
    Result := S;
end;

procedure Same(const Name, Msg: string; Limit: Integer; Scaled: Boolean);
var
  whole, got: string;
  steps: array[0..3] of Integer;
  i: Integer;
  ok: Boolean;
begin
  steps[0] := 1;
  steps[1] := 3;
  steps[2] := 7;
  steps[3] := 1000;
  whole := Run(Msg, 0, Limit);
  ok := True;
  for i := 0 to 3 do
  begin
    got := Run(Msg, steps[i], Limit);
    if got <> whole then
    begin
      ok := False;
      WriteLn(Name, ': step ', steps[i], ' gave ', got, ' and whole gave ', whole);
    end;
  end;
  if Scaled then
    WriteLn(Name, ': ', Brief(whole), ' pieces ', BoolToStr(ok, True))
  else
    WriteLn(Name, ': ', whole, ' pieces ', BoolToStr(ok, True));
end;

var
  big: string;
begin
  Div10 := 1;
  if GetEnvironmentVariable('PASLANG_GCSTRESS') <> '' then
    Div10 := 10;
  Same('many fields', MakeHead(20000 div Div10), 0, True);
  Same('few fields', MakeHead(5), 0, False);
  { a single line of 600 KB }
  SetLength(big, 600000 div Div10);
  FillChar(big[1], Length(big), Ord('v'));
  Same('one long line', 'HTTP/1.1 200 OK' + #13#10 + 'X-Long: ' + big + #13#10 + 'Content-Length: 5' + #13#10 + #13#10 + 'hello', 0, True);
  { over the limit with no line feed, and with lines }
  Same('over the limit without a line end', 'HTTP/1.1 200 OK' + #13#10 + 'X-Long: ' + big, 100000 div Div10, True);
  Same('over the limit with lines', MakeHead(5000 div Div10), 20000 div Div10, True);
  { the byte after a line decides whether it goes on }
  Same('continuation', 'HTTP/1.1 200 OK' + #13#10 + 'X-A: one' + #13#10 + ' two' + #13#10 + #9 + 'three' + #13#10 + 'Content-Length: 0' + #13#10 + #13#10, 0, False);
  Same('bad line', 'HTTP/1.1 200 OK' + #13#10 + 'X-A one' + #13#10 + #13#10, 0, False);
  Same('cut short', 'HTTP/1.1 200 OK' + #13#10 + 'X-A: one' + #13#10, 0, False);
  Same('bare line feeds', 'HTTP/1.1 200 OK' + #10 + 'X-A: one' + #10 + 'Content-Length: 1' + #10 + #10 + 'x', 0, False);
end.
