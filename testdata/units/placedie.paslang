{ P572: no SysUtils and no handler: the runtime ends the program and its
  line names the unit. }
program placedie;

uses
  PlaceV;

var
  a: array of Integer;
begin
  SetLength(a, 3);
  WriteLn('before');
  WriteLn(Deep(a, 9));
  WriteLn('after');
end.

