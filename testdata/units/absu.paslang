{ A unit whose settings record has fields that names of their own
  stand for (P162), as SysUtils' TwoDigitYearCenturyWindow stands for
  DefaultFormatSettings.TwoDigitYearCenturyWindow. }
unit absu;

{$mode objfpc}{$H+}

interface

type
  TInner = record
    Lo, Hi: Word;
  end;
  TSettings = record
    Name: string;
    Window: Word;
    Sep: Char;
    Inner: TInner;
  end;

var
  Settings: TSettings = (Name: 'unit'; Window: 50; Sep: '-'; Inner: (Lo: 1; Hi: 2));
  Window: Word absolute Settings.Window;
  InnerHi: Word absolute Settings.Inner.Hi;

function Describe: string;

implementation

function Describe: string;
var
  w, h: string;
begin
  Str(Settings.Window, w);
  Str(InnerHi, h);
  Result := Settings.Name + ' ' + w + ' ' + Settings.Sep + ' ' + h;
end;

end.

