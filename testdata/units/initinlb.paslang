unit initinlb;
{$mode objfpc}{$H+}
interface
implementation
function Twice(N: Int64): Int64;
begin Result := N * 2 end;
initialization
  WriteLn('b-init ', Twice(5));
finalization
  WriteLn('b-fini ', Twice(7));
end.
