unit visu;

{ A class with members in every section (1.0.137), for visuse, visd and
  the testdata/bitbad/vis* rejects: its private and strict members are
  this unit's to use, its protected ones also the methods' of its
  descendants, in any unit. Its interface, parent and properties travel
  in the .pi (PASLANGI13). }

interface

type
  ISay = interface
    function Say: Integer;
  end;

  TVisBase = class(ISay)
    Tag: Integer;
  private
    FPriv: Integer;
    constructor MakeHidden;
    procedure PrivShow;
    property Priv: Integer read FPriv write FPriv;
  strict private
    FSecret: Integer;
    function SecretTwice: Integer;
  protected
    FProt: Integer;
    procedure ProtShow; virtual;
    function ProtTwice: Integer;
    property ProtProp: Integer read FProt write FProt;
  strict protected
    FSP: Integer;
    function SPValue: Integer;
  public
    constructor Create(N: Integer);
    destructor Destroy; virtual;
    function Sum: Integer;
    function Say: Integer;
    procedure Report; virtual;
    property Secret: Integer read FSecret;
  end;

function MakeHiddenBase: TVisBase;
function PeekPriv(B: TVisBase): Integer;

implementation

constructor TVisBase.Create(N: Integer);
begin
  FSecret := N;
  FPriv := N + 1;
  FProt := N + 2;
  FSP := N + 3;
end;

constructor TVisBase.MakeHidden;
begin
  FSecret := -1;
end;

destructor TVisBase.Destroy;
begin
  WriteLn('TVisBase.Destroy ', FSecret);
end;

procedure TVisBase.PrivShow;
begin
  WriteLn('TVisBase.PrivShow ', FPriv);
end;

function TVisBase.SecretTwice: Integer;
begin
  Result := FSecret * 2;
end;

procedure TVisBase.ProtShow;
begin
  WriteLn('TVisBase.ProtShow ', FProt);
end;

function TVisBase.ProtTwice: Integer;
begin
  Result := FProt * 2;
end;

function TVisBase.SPValue: Integer;
begin
  Result := FSP * 10;
end;

function TVisBase.Sum: Integer;
begin
  Result := FSecret + SecretTwice + FPriv + FProt + FSP;
end;

function TVisBase.Say: Integer;
begin
  Result := 1000 + FSecret;
end;

procedure TVisBase.Report;
begin
  WriteLn('TVisBase.Report ', Sum);
end;

{ private and protected members are this unit's to use }
function MakeHiddenBase: TVisBase;
begin
  Result := TVisBase.MakeHidden;
  Result.FPriv := 40;
  Result.FProt := 41;
  Result.PrivShow;
end;

function PeekPriv(B: TVisBase): Integer;
begin
  Result := B.FPriv + B.Priv + B.FProt + B.ProtTwice + B.ProtProp;
end;

end.
