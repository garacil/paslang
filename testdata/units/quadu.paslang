unit quadu;

{ A unit whose interface has Quad (P103): a function, a procedure, a
  variable; its .pi says PASLANGI10. }

interface

var
  Last: Quad;

function Tenth: Quad;
procedure Keep(q: Quad);

implementation

function Tenth: Quad;
begin
  Result := 0.1;
end;

procedure Keep(q: Quad);
begin
  Last := q * 2;
end;

end.

