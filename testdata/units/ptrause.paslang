{ A pointer type is one type whichever unit brings it in (P164): each
  unit's .pi carries its own copy of PChar and PInteger, and the
  program's PChar was the copy the first unit brought, so a PChar did
  not go into the other unit's overloads (no matching overload), and
  which one worked depended on the order of the uses clause. Both
  units' routines take the program's PChar and PInteger here, by value
  and as var, and a PChar one unit gives goes where the other's goes.
  The output is Free Pascal's. }
program ptrause;

{$mode objfpc}{$H+}

uses ptra, ptrb;

var
  s, t: string;
  p, q: PChar;
  n: Integer;
  pn: PInteger;
begin
  s := 'hello';
  t := 'world';
  p := PChar(s);
  q := HereB(t);
  n := 21;
  pn := @n;
  WriteLn(Head(p, 2), HeadB(q, 3), ' ', Twice(pn), ' ', TwiceB(pn), ' ', Twice(4));
  Swap(p, q);
  SwapB(p, q);
  Swap(p, q);
  WriteLn(Head(p, 5), ' ', HeadB(q, 5));
  p := Here(s);
  q := p;
  WriteLn(q[1], ' ', HeadB(Here(t), 5));
end.

