{ P460: unit 2 of the chain; its interface uses unit 1. }
unit pichain2;

interface

uses
  pichain1;

type
  TP2 = record
    Inner: TP1;
    B: Integer;
    function Sum: Integer;
  end;

  TC2 = class(TC1)
    function Get: Integer; override;
  end;

function Step2(X: Integer): Integer;

implementation

function TP2.Sum: Integer;
begin
  Result := Inner.Twice + B;
end;

function TC2.Get: Integer;
begin
  Result := inherited Get + 2;
end;

function Step2(X: Integer): Integer;
begin
  Result := Step1(X) + 1;
end;

end.
