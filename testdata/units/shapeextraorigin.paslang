unit shapeextraorigin;
interface
type
  TExtraAnchor = class
    function Add(X: Integer): Integer;
  end;
  TExtraOther = class end;
procedure SeedExtra(P: ^Integer; M: function(X: Integer): Integer of object; R: 0..7; S: set of 0..7; F: function(X: Integer): Integer; T: tree[Integer] of Integer; U: tree of Integer; H: heap of Integer; C: class of TExtraAnchor);
implementation
function TExtraAnchor.Add(X: Integer): Integer;
begin Result := X + 20 end;
procedure SeedExtra(P: ^Integer; M: function(X: Integer): Integer of object; R: 0..7; S: set of 0..7; F: function(X: Integer): Integer; T: tree[Integer] of Integer; U: tree of Integer; H: heap of Integer; C: class of TExtraAnchor);
begin end;
end.
