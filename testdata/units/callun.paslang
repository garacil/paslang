{ P579: an uncaught raise names the calls still on the stack, a line
  each after the place of the raise (P578): "  called at line N of unit
  U", the program's own code "  called at line N". The argument picks
  the case, one raise nobody takes a run, each through the unit CallU
  down to CallV, where the object is raised: a straight chain; through
  a finally of CallV, whose routine is then the lowest left standing,
  so the calls start at CallU's call of it; through a method; through a
  procedure variable; from a nested routine; a recursion of twenty-one
  calls, of which sixteen are said and then "  ..."; a raise in the
  main block itself, which has no call to name; a routine of the
  program between the main block and the unit; and a fault of the
  runtime that nobody takes (P567), which says its own line and no
  more. Every run ends with status 1. }
program callun;

uses
  sysutils, CallU;

type
  EOwn = class
  end;

var
  a: array of Integer;

{ an open array keeps it a call }
procedure Own(const A: array of Integer; N: Integer);
begin
  Middle(N + Length(A));
  WriteLn('not raised');
end;

function Fault(const A: array of Integer; I: Integer): Integer;
begin
  try
    Result := A[I];
  finally
    WriteLn('finally');
  end;
end;

var
  k: Integer;
begin
  k := StrToInt(ParamStr(1));
  SetLength(a, 3);
  WriteLn('before ', k);
  case k of
    1: Middle(5);
    2: ViaGuard(5);
    3: ViaMethod(5);
    4: ViaVar(5);
    5: Nested(5);
    6: ManyDown(20);
    7: raise EOwn.Create;
    8: Own(a, 5);
    9: WriteLn(Fault(a, 11));
  end;
  WriteLn('after');
end.

