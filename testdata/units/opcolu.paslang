{ P157: a second unit with its own type's operators, and two on
  opvecu's TVec: a product of two vectors, which opvecu does not give,
  and a < by length, which hides opvecu's from a program that uses this
  unit after opvecu. }
unit opcolu;

interface

uses opvecu;

type
  TCol = record
    R, G, B: Integer;
  end;

function Col(R, G, B: Integer): TCol;
function Dot(const A, B: TVec): Integer;

operator + (A, B: TCol): TCol;
operator * (A, B: TVec): Integer;
operator < (A, B: TVec): Boolean;

implementation

function Sat(N: Integer): Integer;
begin
  if N > 255 then
    Result := 255
  else
    Result := N;
end;

function Col(R, G, B: Integer): TCol;
begin
  Result.R := R;
  Result.G := G;
  Result.B := B;
end;

{ this unit's *, the dot product, which the program's own hides from it }
function Dot(const A, B: TVec): Integer;
begin
  Result := A * B;
end;

operator + (A, B: TCol): TCol;
begin
  Result := Col(Sat(A.R + B.R), Sat(A.G + B.G), Sat(A.B + B.B));
end;

operator * (A, B: TVec): Integer;
begin
  Result := A.X * B.X + A.Y * B.Y;
end;

operator < (A, B: TVec): Boolean;
begin
  Result := A * A < B * B;
end;

end.

