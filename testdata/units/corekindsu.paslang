unit corekindsu;
interface
uses sysutils;
function KindOf(const Args: array of const): Integer;
function CurrencyKind: Integer;
implementation
function KindOf(const Args: array of const): Integer;
begin
  if Length(Args) <> 1 then Halt(2);
  Result := Args[0].VType;
end;
function CurrencyKind: Integer;
begin Result := vtCurrency end;
end.
