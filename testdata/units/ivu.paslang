{ A unit's variables with a value and one absolute over another, both
  exported (P144), as SysUtils' FormatSettings over DefaultFormatSettings. }
unit ivu;

interface

type
  TOpts = record
    Sep: Char;
    Width: Int64;
    Label1: string;
  end;

var
  DefaultOpts: TOpts = (Sep: '.'; Width: 8; Label1: 'opts');
  Opts: TOpts absolute DefaultOpts;
  Calls: Int64 = 1000;

function Show: string;

implementation

var
  Hidden: string = 'hid';

function Show: string;
begin
  Inc(Calls);
  Result := DefaultOpts.Sep + ' ' + Chr(48 + DefaultOpts.Width) + ' ' + DefaultOpts.Label1 + ' ' + Hidden;
end;

end.

