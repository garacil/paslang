program pisum;

{ Writes a .pi's SUM line again after a test changed its body, so the
  loader reads the changed interface instead of refusing its checksum
  (1.0.87: the check of the builtin types). }

uses
  paslib;

var
  data, body, path: string;
  p, q, e: Integer;

begin
  path := ParamStr(1);
  if not ReadFile(path, data) then
    Halt(1);
  p := 1;
  while data[p] <> #10 do
    p := p + 1;
  q := p + 1;
  while data[q] <> #10 do
    q := q + 1;
  e := q + 1;
  while (e <= Length(data)) and (Copy(data, e, 4) <> 'DEP ') do
  begin
    while (e <= Length(data)) and (data[e] <> #10) do
      e := e + 1;
    e := e + 1;
  end;
  body := Copy(data, q + 1, e - q - 1);
  data := Copy(data, 1, p) + 'SUM ' + HashHex(body) + #10 + body +
    Copy(data, e, Length(data) - e + 1);
  if not WriteFile(path, data) then
    Halt(1);
end.
