{ A unit's records with methods and properties (P165): the program that
  uses it calls them, reads the properties and makes one, and sees no
  private member. }
unit recu;

{$mode objfpc}{$H+}{$modeswitch advancedrecords}

interface

type
  TStack = record
  private
    FItems: array of Int64;
    FPeak: Int64;
    function GetCount: Int64;
    function GetTop: Int64;
  public
    constructor Create(First: Int64);
    procedure Put(V: Int64);
    function Take: Int64;
    class function Of2(A, B: Int64): TStack; static;
    property Count: Int64 read GetCount;
    property Top: Int64 read GetTop;
    property Peak: Int64 read FPeak;
  end;

  TMoney = record
  strict private
    FCents: Int64;
  public
    constructor Create(Euros, Cents: Int64);
    function Text: string;
    procedure Add(const M: TMoney);
    property Cents: Int64 read FCents write FCents;
  end;

function Total(const A, B: TMoney): TMoney;

implementation

uses SysUtils;

constructor TStack.Create(First: Int64);
begin
  FItems := nil;
  FPeak := 0;
  Put(First);
end;

procedure TStack.Put(V: Int64);
begin
  SetLength(FItems, Length(FItems) + 1);
  FItems[High(FItems)] := V;
  if Length(FItems) > FPeak then
    FPeak := Length(FItems);
end;

function TStack.Take: Int64;
begin
  Result := FItems[High(FItems)];
  SetLength(FItems, Length(FItems) - 1);
end;

function TStack.GetCount: Int64;
begin
  Result := Length(FItems);
end;

function TStack.GetTop: Int64;
begin
  Result := FItems[High(FItems)];
end;

class function TStack.Of2(A, B: Int64): TStack;
begin
  Result := TStack.Create(A);
  Result.Put(B);
end;

constructor TMoney.Create(Euros, Cents: Int64);
begin
  FCents := Euros * 100 + Cents;
end;

function TMoney.Text: string;
begin
  Result := IntToStr(FCents div 100) + '.' + Format('%.2d', [FCents mod 100]);
end;

procedure TMoney.Add(const M: TMoney);
begin
  FCents := FCents + M.Cents;
end;

function Total(const A, B: TMoney): TMoney;
begin
  Result := A;
  Result.Add(B);
end;

end.

