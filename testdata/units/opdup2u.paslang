{ P157: the operator the interface declares given two bodies: refused, where the assembler saw its symbol twice. }
unit opdup2u;

interface

type
  TV = record
    X: Integer;
  end;

operator + (A, B: TV): TV;

implementation

operator + (A, B: TV): TV;
begin
  Result.X := A.X + B.X;
end;

operator + (A, B: TV): TV;
begin
  Result.X := A.X - B.X;
end;

end.

