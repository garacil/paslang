program genericprobe;
{$mode objfpc}{$H+}
uses genericu, generica, genericb;
type
  TNumber = specialize TCell<generica.TItem>;
  TText = specialize TCell<genericb.TItem>;
var N: TNumber; S: TText;
begin
  N.Item.Number := 37;
  S.Item.Text := 'different';
  WriteLn('origins ', N.Item.Number, ' ', S.Item.Text);
end.
