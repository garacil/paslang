program clsfwduse;

uses clsfwdu;

type
  TSum = class(TObject, IVisit)
    function Visit(L: TLeaf): Int64;
  end;
  TMine = class(ELeafError);

function TSum.Visit(L: TLeaf): Int64;
begin
  Result := L.Weight;
end;

var
  t: TTree;
  l: TLeaf;
  s: TSum;
  v: IVisit;
  i: Int64;
  x: TTree;
begin
  t := TTree.Create;
  for i := 1 to 4 do
  begin
    l := TLeaf.Create;
    l.Weight := i * 10;
    t.Add(l);
  end;
  s := TSum.Create;
  v := s;
  WriteLn('sum ', t.Walk(v));
  x := t.Leaves[2];
  WriteLn(t.Kind, ' ', x.Kind, ' ', x.ClassName, ' ', x.ClassParent.ClassName);
  WriteLn(TMine.ClassParent.ClassName, ' ', TMine.ClassParent.ClassParent.ClassName);
end.

