unit currencyu;
interface
uses sysutils;
type
  TAmount = Currency;
  TAccount = record
    Balance: TAmount;
    constructor Create(Initial: TAmount = 1.23445);
    procedure Deposit(Value: TAmount = 0.0001);
    function Text: string;
    property Amount: TAmount read Balance write Balance;
  end;
const Upper: TAmount = 922337203685477.5807;
var Initial: TAmount = -1.23455;
function Choose(Value: Currency): string; overload;
function Choose(Value: Double): string; overload;
function DefaultPrice(Value: TAmount = 2.675): TAmount;
implementation
constructor TAccount.Create(Initial: TAmount);
begin Balance := Initial end;
procedure TAccount.Deposit(Value: TAmount);
begin Balance := Balance + Value end;
function TAccount.Text: string;
begin Result := CurrToStr(Balance) end;
function Choose(Value: Currency): string;
begin Result := 'decimal ' + CurrToStr(Value) end;
function Choose(Value: Double): string;
begin Result := 'binary ' + FloatToStr(Value) end;
function DefaultPrice(Value: TAmount): TAmount;
begin Result := Value end;
end.
