{ P578: an uncaught raise says where it was raised. The line of the main
  routine named the class and the message and no place; it ends now
  with the place of the raise, at line N for the program's own code and
  at line N of unit U for a unit's (P572). The argument picks the case,
  one raise nobody takes a run: the program's own, with an object and
  without; then the unit's, a plain object, an exception with its
  message, a method, a nested routine, a raise again in a handler (the
  first raise is named), one through a finally, another object raised
  at the first one's address, a handler of another class that lets it
  by; and a fault of the runtime nobody takes, whose own line is the
  whole of it. Every run ends with status 1. }
program raiseun;

uses
  sysutils, RaiseU;

type
  EOwn = class
  end;

var
  a: array of Integer;
  f: TFuse;
  k: Integer;
begin
  k := StrToInt(ParamStr(1));
  SetLength(a, 3);
  WriteLn('before ', k);
  case k of
    1: raise EOwn.Create;
    2: raise;
    3: Boom(5);
    4: Many(5);
    5:
      begin
        f := TFuse.Create;
        f.Blow;
      end;
    6: Deep(5);
    7: Again(5);
    8: After(5);
    9: Renamed(5);
    10: Passes(5);
    11: WriteLn(Fault(a, 11));
  end;
  WriteLn('after');
end.

