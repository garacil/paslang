{ A unit whose own names hide the ones of a unit its implementation uses
  (P158), as SysUtils' hide pastime's: its type TDate, its variable
  Stamp, its routine Counter and its constant Today; hidelo's are
  reached through hidelo's name, and its Step, which nothing hides, by
  its own. }
unit hidehi;

{$mode objfpc}{$H+}

interface

type
  TDate = Double;

var
  Stamp: string = 'high stamp';

function Counter: Integer;

const
  Today = 'high today';

function Describe: string;

implementation

uses hidelo;

function Num(N: Int64): string;
begin
  Str(N, Result);
end;

function Counter: Integer;
begin
  Result := hidelo.Counter + 1;
end;

function Describe: string;
var
  d: hidelo.TDate;
  x: TDate;
begin
  d := hidelo.Today;
  x := 1.5;
  Result := Stamp + ' ' + hidelo.Stamp + ' ' + Num(Counter) + ' ' + Today + ' ' + Num(d.Y) + ' ' +
    Num(Step) + ' ' + Num(Trunc(x * 2)) + ' ' + Num(SizeOf(hidelo.TDate));
end;

end.

