{ A unit that hidehi uses in its implementation, whose names hidehi's
  interface already declares (P158). }
unit hidelo;

{$mode objfpc}{$H+}

interface

type
  TDate = record
    Y, M, D: Int64;
  end;
  TColor = (Red, Green, Blue);

var
  Counter: Integer = 100;

const
  Step = 5;

function Stamp: string;
function Today: TDate;

implementation

function Stamp: string;
begin
  Result := 'low stamp';
end;

function Today: TDate;
begin
  Result.Y := 2026;
  Result.M := 9;
  Result.D := 30;
end;

end.

