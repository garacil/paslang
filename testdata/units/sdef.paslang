unit sdef;

interface

procedure Tag(S: string = 'hi');
procedure Scale(R: Real = 2.5);

implementation

procedure Tag(S: string);
begin
  WriteLn(S);
end;

procedure Scale(R: Real);
begin
  WriteLn(R);
end;

end.

