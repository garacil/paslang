{ A program's routine hides a unit's of its name unless it is declared
  overload, and a nested routine the ones around it (P160), as in Free
  Pascal: Half(3) is the program's Half(Double), Twice(3) ovan's beside
  the program's Twice(Double) overload; inside Show, a nested Half of a
  string hides the others, and a nested Twice of a string declared
  overload leaves them. The output is Free Pascal's. }
program ovuse4;

{$mode objfpc}{$H+}

uses ovan;

function Half(X: Double): string;
begin
  Result := 'P.dbl';
end;

function Twice(X: Double): string; overload;
begin
  Result := 'P.twice';
end;

procedure Show;

  function Half(S: string): string;
  begin
    Result := 'N.' + S;
  end;

  function Twice(S: string): string; overload;
  begin
    Result := 'N.twice.' + S;
  end;

begin
  WriteLn(Half('x'), ' ', Twice('y'), ' ', Twice(3), ' ', Twice(2.5));
end;

begin
  WriteLn(Half(3), ' ', Half(2.5), ' ', Twice(3), ' ', Twice(2.5));
  Show;
end.

