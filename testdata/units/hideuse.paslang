{ A program's types hide the ones of the same names in a unit it uses
  (P155), as in Free Pascal: a record, an alias, an enumeration and a
  class of its own; the unit's are still hideu.TPoint and the rest, and
  its routines keep theirs. The output is Free Pascal's. }
program hideuse;

{$mode objfpc}{$H+}

uses hideu;

type
  TPoint = record
    Name: string;
    Z: Integer;
  end;
  TCount = string;
  TColor = (Blue, Cyan, Magenta);
  TShape = class
    function Name: string;
  end;

function TShape.Name: string;
begin
  Result := 'program shape';
end;

var
  p: TPoint;
  up: hideu.TPoint;
  c: TCount;
  k: TColor;
  s: TShape;
  us: hideu.TShape;
begin
  p.Name := 'mine';
  p.Z := 9;
  up := Origin;
  c := 'text';
  k := Magenta;
  s := TShape.Create;
  us := MakeShape;
  WriteLn(p.Name, ' ', p.Z, ' ', up.X, ' ', up.Y);
  WriteLn(c, ' ', Three + 1, ' ', Ord(k), ' ', Ord(Second));
  WriteLn(s.Name, ' ', us.Name);
end.

