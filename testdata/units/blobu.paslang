{ P153: a unit's routines whose result is a block, called from another
  compilation: a record's constructor through the type (its maker, a
  routine of this unit the importer does not list), functions, a
  record's method and a class's virtual method. }
unit blobu;

interface

type
  TVec = record
    X, Y: Integer;
    Name: string;
    constructor Create(AX, AY: Integer; const AName: string);
    function Scaled(K: Integer): TVec;
  end;

  TBox = class
    V: TVec;
    function Get: TVec; virtual;
  end;

  TBigBox = class(TBox)
    function Get: TVec; override;
  end;

function MkVec(X, Y: Integer): TVec;
function AddVec(const A, B: TVec): TVec;

implementation

constructor TVec.Create(AX, AY: Integer; const AName: string);
begin
  X := AX;
  Y := AY;
  Name := AName;
end;

function TVec.Scaled(K: Integer): TVec;
begin
  Result := TVec.Create(X * K, Y * K, Name + '*');
end;

function TBox.Get: TVec;
begin
  Result := V;
end;

function TBigBox.Get: TVec;
begin
  Result := V.Scaled(10);
end;

function MkVec(X, Y: Integer): TVec;
begin
  Result := TVec.Create(X, Y, 'mk');
end;

function AddVec(const A, B: TVec): TVec;
begin
  Result := TVec.Create(A.X + B.X, A.Y + B.Y, A.Name + B.Name);
end;

end.

