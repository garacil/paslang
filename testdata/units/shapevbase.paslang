{ P619: the silent form. This unit has no free routine whose body could
  go missing: on 1.3.0 it compiled, the override in shapevderived took
  no slot, and the base method ran. }
unit shapevbase;

interface

type
  TShapeVBase = class
  public
    function Sum(const A: array of Integer): Integer; virtual;
  end;

function CallSum(B: TShapeVBase): Integer;

implementation

uses
  shapealias;

function TShapeVBase.Sum(const A: array of Integer): Integer;
begin
  Result := -1;
end;

function CallSum(B: TShapeVBase): Integer;
var
  v: array of Integer;
begin
  SetLength(v, 3);
  v[0] := 1;
  v[1] := 2;
  v[2] := 3;
  Result := B.Sum(v);
end;

end.
