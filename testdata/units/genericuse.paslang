program genericuse;
{$mode objfpc}{$H+}
uses genericu, generica, genericb, genericwrap;
type
  TCell_string = record Marker: Int64; end;
  TText = specialize TCell<string>;
  TNumber = specialize TCell<generica.TItem>;
  TNamed = specialize TCell<genericb.TItem>;
  TAlias = TNamed;
  TLeft = specialize generica.TOther<Int64>;
  TRight = specialize genericb.TOther<Int64>;
var A: TText; B: TNumber; C: TNamed; D: TAlias;
    E: TImportedText; F: TImportedNumber; H: TImportedNamed;
    L: TLeft; R: TRight; Own: TCell_string;
begin
  Fill(E, F, H);
  A := E; B := F; C := H; D := C;
  A.Item[1] := 'O';
  D.Item.Text[1] := 'N';
  L.Item := 17; R.Item := 19; Own.Marker := 23;
  WriteLn('identity ', A.Item, ' ', E.Item, ' ', B.Item.Number, ' ',
    C.Item.Text, ' ', D.Item.Text, ' ', L.Item, ' ', R.Item, ' ', Own.Marker);
end.
