{ P460: unit 6 of the chain; its interface uses unit 5. }
unit pichain6;

interface

uses
  pichain5;

type
  TP6 = record
    Inner: TP5;
    B: Integer;
    function Sum: Integer;
  end;

  TC6 = class(TC5)
    function Get: Integer; override;
  end;

function Step6(X: Integer): Integer;

implementation

function TP6.Sum: Integer;
begin
  Result := Inner.Sum + B;
end;

function TC6.Get: Integer;
begin
  Result := inherited Get + 6;
end;

function Step6(X: Integer): Integer;
begin
  Result := Step5(X) + 1;
end;

end.
