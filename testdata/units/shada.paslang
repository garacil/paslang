{ Names of one spelling in two units (P138): the first unit, whose
  names the second hides and its own name still reaches. }
unit shada;
interface
type
  TBox = record
    A: Integer;
  end;
const
  Kind = 'a';
  Size = 1;
var
  Count: Integer;
function Twice(X: Integer): Integer;
function OnlyA: string;
implementation
function Twice(X: Integer): Integer;
begin
  Result := X * 2;
end;
function OnlyA: string;
begin
  Result := 'only a';
end;
end.

