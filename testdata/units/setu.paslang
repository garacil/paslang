{ Sets across a unit (P126): a set type of 32 bytes, named constants
  of one word and of 32 bytes, a typed constant, a routine whose set
  parameter has a default, one that returns a set, and a class with a
  set field and a method whose set parameter has a default. }
unit setu;

interface

type
  TChars = set of Char;
  TSmall = set of 0..7;

  TScanner = class
    Stops: TChars;
    function Skip(const S: string; Blanks: TChars = [' ', #9]): Integer;
  end;

const
  Digits = ['0'..'9'];
  Odds = [1, 3, 5, 7];
  Letters: TChars = ['A'..'Z', 'a'..'z'];

function CountIn(const S: string; C: TChars = ['a', 'e', 'i', 'o', 'u']): Integer;
function Upper: TChars;

implementation

function TScanner.Skip(const S: string; Blanks: TChars): Integer;
begin
  Result := 1;
  while (Result <= Length(S)) and (S[Result] in Blanks) do
    Result := Result + 1;
end;

function CountIn(const S: string; C: TChars): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to Length(S) do
    if S[i] in C then
      Result := Result + 1;
end;

function Upper: TChars;
begin
  Result := ['A'..'Z'];
end;

end.

