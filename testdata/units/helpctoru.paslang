{ P170: a unit's class helper with a constructor and a static method,
  which a program reaches through the class's name. }
unit helpctoru;

interface

type
  TCell = class
    V: Integer;
  end;

  TCellHelper = class helper for TCell
    constructor Make(AV: Integer);
    class function Seed: Integer; static;
  end;

implementation

constructor TCellHelper.Make(AV: Integer);
begin
  V := AV * 10 + Seed;
end;

class function TCellHelper.Seed: Integer;
begin
  Result := 7;
end;

end.

