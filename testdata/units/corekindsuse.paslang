program corekindsuse;
uses corekindsu;
var value: Currency;
begin
  value := 1.25;
  if (CurrencyKind <> vtCurrency) or (KindOf([value]) <> vtCurrency)
    or (KindOf([42]) <> vtInteger) or (KindOf(['text']) <> vtAnsiString)
    or (KindOf([True]) <> vtBoolean) then Halt(1);
  WriteLn('TVarRec kinds survive unit interfaces and re-exported core types');
end.
