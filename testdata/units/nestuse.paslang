{ A name inside a routine hides the ones around it at every depth
  (P159), as in Free Pascal: a nested function X hides a global
  variable X in the routines inside it too, and a constant of a routine
  deeper still hides the function there; a nested function calls
  itself; a nested routine hides a unit's constant, variable and
  routine, which the unit's name still reaches; a parameter hides a
  global type. The output is Free Pascal's. }
program nestuse;

{$mode objfpc}{$H+}

uses nestu;
type
  TB = record A, B: Int64; end;
var
  X: Int64;
  V1: Int64;

procedure P;
  function X: Int64;
  begin
    Result := 21;
  end;

  procedure Q;
    procedure R;
    const
      X = 33;
    begin
      WriteLn('R ', X);
    end;
  begin
    WriteLn('Q ', X);
    R;
    WriteLn('Q ', X);
  end;

  function Fact(N: Int64): Int64;
  begin
    if N <= 1 then
      Result := 1
    else
      Result := N * Fact(N - 1);
  end;

  procedure C1;
  begin
    WriteLn('C1 ', nestu.C1);
  end;

begin
  Q;
  WriteLn('P ', X, ' ', Fact(5));
  C1;
end;

procedure S(TB: Int64);
begin
  WriteLn('S ', TB, ' ', SizeOf(TB));
end;

procedure T;
  function V1: Int64;
  begin
    Result := 44;
  end;
  procedure R1;
  begin
    WriteLn('R1 ', nestu.R1);
  end;
begin
  WriteLn('T ', V1, ' ', nestu.V1);
  R1;
end;

begin
  X := 10;
  V1 := 5;
  P;
  S(7);
  T;
  WriteLn('main ', X, ' ', V1, ' ', SizeOf(TB));
end.

