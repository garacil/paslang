{ One of two units whose routines take a PChar, a PInteger and a var
  PChar among overloads (P164): each unit's .pi brings its own copy of
  the pointer types, and a program's PChar goes into both. }
unit ptra;

{$mode objfpc}{$H+}

interface

function Head(P: PChar; N: Integer): string;
function Head(const S: string): string;
function Twice(P: PInteger): Integer;
function Twice(N: Integer): Integer;
procedure Swap(var A, B: PChar);
function Here(const S: string): PChar;

implementation

function Head(P: PChar; N: Integer): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to N - 1 do
    Result := Result + P[i];
end;

function Head(const S: string): string;
begin
  Result := S;
end;

function Twice(P: PInteger): Integer;
begin
  Result := 2 * P^;
end;

function Twice(N: Integer): Integer;
begin
  Result := 3 * N;
end;

procedure Swap(var A, B: PChar);
var
  t: PChar;
begin
  t := A;
  A := B;
  B := t;
end;

function Here(const S: string): PChar;
begin
  Result := PChar(S);
end;

end.

