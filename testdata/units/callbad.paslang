{ P579: the walk of the calls of an uncaught raise must not follow a
  frame pointer that is none. Code in assembly may use the register for
  something else, and a program that is ending must still end with its
  line. Each case raises with no object from a block of assembly, with
  the frame pointer set by hand: far below the routine's stack, far
  above it, and at a frame made by hand whose own frame pointer points
  at itself, with this routine's code as its return address. The first
  two name no call; the third names its one call once, where a walk
  that went on would name it sixteen times. Every run ends with
  status 1 and the line of its raise. }
program callbad;

uses
  sysutils;

procedure Below;
begin
  asm amd64
    movq $4096, %rbp
    xorl %edi, %edi
    xorl %esi, %esi
    call rt_raiseobj
  end;
  asm arm64
    mov x29, #4096
    mov x0, xzr
    mov x1, xzr
    bl rt_raiseobj
  end;
end;

procedure Above;
begin
  asm amd64
    movq $-4096, %rbp
    xorl %edi, %edi
    xorl %esi, %esi
    call rt_raiseobj
  end;
  asm arm64
    mov x29, #-4096
    mov x0, xzr
    mov x1, xzr
    bl rt_raiseobj
  end;
end;

procedure Itself;
begin
  asm amd64
    subq $16, %rsp
    movq %rsp, (%rsp)
    leaq 1f(%rip), %rax
    movq %rax, 8(%rsp)
    movq %rsp, %rbp
    xorl %edi, %edi
    xorl %esi, %esi
    call rt_raiseobj
  1:
    addq $16, %rsp
  end;
  asm arm64
    sub sp, sp, #16
    mov x9, sp
    str x9, [sp]
    adr x9, 1f
    str x9, [sp, #8]
    mov x29, sp
    mov x0, xzr
    mov x1, xzr
    bl rt_raiseobj
  1:
    add sp, sp, #16
  end;
end;

var
  k: Integer;
begin
  k := StrToInt(ParamStr(1));
  WriteLn('before ', k);
  case k of
    1: Below;
    2: Above;
    3: Itself;
  end;
  WriteLn('after');
end.

