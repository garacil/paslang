unit recsu;
{$mode delphi}{$H+}
interface
type
  TCache = record
  strict private
    class var FText: string;
  private
    class var FCount: Int64;
  public
    class var Shared: Int64;
    class constructor Start;
    class destructor Finish;
    class function GetCount: Int64; static;
    class procedure SetCount(V: Int64); static;
    class property Text: string read FText;
    class property Count: Int64 read GetCount write SetCount;
  end;
implementation
class constructor TCache.Start;
begin
  FText := 'unit-cache';
  FCount := 7;
  Shared := 9;
  WriteLn('unit-start');
end;
class destructor TCache.Finish;
begin
  WriteLn('unit-end ', FText, ' ', FCount, ' ', Shared);
end;
class function TCache.GetCount: Int64;
begin
  Result := FCount;
end;
class procedure TCache.SetCount(V: Int64);
begin
  FCount := V;
end;
initialization
  WriteLn('unit-init ', TCache.Count);
finalization
  WriteLn('unit-fini ', TCache.Count);
end.
