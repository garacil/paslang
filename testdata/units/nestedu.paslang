unit nestedu;
{$mode delphi}{$H+}
interface
type
  TInfo = record
  public
    const Mark = 6;
  strict private
    const Hidden = 13;
    type THidden = Byte;
  private
    const UnitOnly = 17;
    type TUnitOnly = Word;
  public
    type
      TMode = (M0, M1);
      TAlias = Int64;
      TNested = record
        const Flag = Mark + 2;
      public
        X: Int64;
        function Compute: Int64;
      end;
  var
    Value: TAlias;
    function Total: Int64;
    class function Mode: TMode; static;
  end;
  TInfoHelper = record helper for TInfo
    const Extra = 4;
    type TCounter = Int64;
    class function Code: TCounter; static;
  end;
function UnitAccess: Int64;
implementation
function TInfo.TNested.Compute: Int64;
begin Result := X + Flag + Mark end;
function TInfo.Total: Int64;
begin Result := Value + Hidden end;
class function TInfo.Mode: TMode;
begin Result := M1 end;
class function TInfoHelper.Code: TCounter;
begin Result := Mark + Extra end;
function UnitAccess: Int64;
begin Result := TInfo.UnitOnly + SizeOf(TInfo.TUnitOnly) end;
end.
