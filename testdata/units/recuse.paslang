{ The records of unit recu, with their methods and properties (P165). }
program recuse;

{$mode objfpc}{$H+}{$modeswitch advancedrecords}

uses recu;

var
  s: TStack;
  m, n: TMoney;
begin
  s := TStack.Create(1);
  s.Put(2);
  s.Put(3);
  WriteLn(s.Count, ' ', s.Top, ' ', s.Peak);
  WriteLn(s.Take, ' ', s.Take, ' ', s.Count, ' ', s.Peak);
  s := TStack.Of2(7, 8);
  WriteLn(s.Count, ' ', s.Top);
  with s do
  begin
    Put(9);
    WriteLn(Count, ' ', Top, ' ', Peak);
  end;
  m := TMoney.Create(3, 50);
  n := TMoney.Create(1, 75);
  WriteLn(m.Text, ' ', n.Text, ' ', Total(m, n).Text);
  m.Add(n);
  m.Cents := m.Cents + 1;
  WriteLn(m.Text, ' ', m.Cents);
end.

