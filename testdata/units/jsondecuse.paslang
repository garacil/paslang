{ P206: a program decodes the types of the unit jsondec, the private
  fields of its class included, and calls the unit's own decodes. }
program jsondecuse;

uses
  jsondec;

var
  u: TUser;
  a: TAccount;
  b: TIntBox;
  j: json;

begin
  JsonDecode('{"id": 3, "name": "ana", "tags": ["x", "y"]}', u);
  WriteLn(u.Id, ' ', u.Name, ' ', Length(u.Tags), ' ', JsonEncode(u));
  JsonDecode('{"owner": "bo", "secret": 42, "balance": 10.5}', a);
  WriteLn(a.Owner, ' ', a.Secret, ' ', a.Balance, ' ', JsonEncode(a));
  JsonDecode('{"value": 7, "seen": true}', b);
  WriteLn(b.Value, ' ', b.Seen);
  u := ParseUser('{"id": 9, "name": "cy"}');
  WriteLn(u.Id, ' ', u.Name, ' ', Length(u.Tags));
  j := JsonParse('{"a": {"id": 1, "name": "one"}, "b": {"id": 20, "name": "two"}}');
  WriteLn(SumIds(j), ' ', NameOf(j, 'b'), ' ', NameOf(j, 'z'));
end.

