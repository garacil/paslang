{ The subranges of unit subu used from a program (P135). }
program subuse;

uses subu;

var
  d: TDigit;
  w: TWork;
  day: TDay;
  s: string;

begin
  d := NextDigit('8');
  s := d + FirstDigit;
  WriteLn(s, ' ', NextDigit(d), ' ', Low(TDigit), High(TDigit));
  day := DayAfter(Fri);
  WriteLn(Ord(day), ' ', Ord(DayAfter(Mon)));
  for w in Busy do
    Write(Ord(w));
  day := Tue;
  WriteLn(' ', Ord(day in Busy), Ord(Thu in Busy));
end.

