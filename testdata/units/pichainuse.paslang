{ P460: a program at the end of a chain of eight units, which names the
  last, a middle one and the first. Each unit's .pi holds a type once,
  however many .pi before it brought it in; the records, classes and
  TSysError of the chain are the types of every unit's routines. }
program pichainuse;

uses
  sysutils, pichain8, pichain4, pichain1;

var
  p: TP8;
  q: TP4;
  c: TC1;
  b: TBytes;
  f: TSysError;

begin
  p.B := 8;
  p.Inner.B := 7;
  p.Inner.Inner.B := 6;
  p.Inner.Inner.Inner.B := 5;
  p.Inner.Inner.Inner.Inner.B := 4;
  p.Inner.Inner.Inner.Inner.Inner.B := 3;
  p.Inner.Inner.Inner.Inner.Inner.Inner.B := 2;
  p.Inner.Inner.Inner.Inner.Inner.Inner.Inner.A := 1;
  WriteLn('sum ', p.Sum);
  q := p.Inner.Inner.Inner.Inner;
  WriteLn('middle ', q.Sum);
  c := TC8.Create;
  c.N := 10;
  WriteLn('class ', c.Get, ' ', TC4(c).Get);
  WriteLn('step ', Step8(0), ' ', Step4(10), ' ', Step1(100));
  SetLength(b, 4);
  if TryRandomBytes(b, 0, 4, f) then
    WriteLn('random ok')
  else
    WriteLn('random ', f.Code);
end.
