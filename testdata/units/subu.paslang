{ Subranges of Char and of an enumeration across a unit (P135): the
  host crosses with the subrange, so a program's '0'..'9' is a Char and
  its Mon..Fri a day. }
unit subu;

interface

type
  TDigit = '0'..'9';
  TDay = (Mon, Tue, Wed, Thu, Fri, Sat, Sun);
  TWork = Mon..Fri;
  TWorks = set of TWork;

const
  FirstDigit: TDigit = '0';
  Busy: TWorks = [Mon, Wed..Fri];

function NextDigit(D: TDigit): TDigit;
function DayAfter(W: TWork): TDay;

implementation

function NextDigit(D: TDigit): TDigit;
begin
  if D = High(TDigit) then
    Result := Low(TDigit)
  else
    Result := Succ(D);
end;

function DayAfter(W: TWork): TDay;
begin
  Result := Succ(W);
end;

end.

