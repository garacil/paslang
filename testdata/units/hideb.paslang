{ The second unit (P158): its routine Shared hides hidea's variable, its
  constant Mark hidea's variable, its variable Limit hidea's constant. }
unit hideb;

{$mode objfpc}{$H+}

interface

function Shared: Integer;

const
  Mark = 77;

var
  Limit: Integer = 55;

implementation

function Shared: Integer;
begin
  Result := 20;
end;

end.

