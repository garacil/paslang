program reguse;

{ Another unit's global stays in memory (1.0.136): the unit holds the
  address of UG and of US[1], and this program's loop wrote UG in a
  register, so the writes through the pointer were lost (3 6 instead
  of 33 66). }

uses regu;

var
  j, t, k: Integer;

begin
  t := 0;
  for j := 1 to 3 do
  begin
    UG := UG + 1;
    PG^ := PG^ + 10;
    t := t + UG;
  end;
  WriteLn(UG, ' ', t);
  k := 0;
  for j := 1 to 3 do
  begin
    US[1] := US[1] + 1;
    PS^ := PS^ + 10;
    k := k + US[1];
  end;
  WriteLn(US[1], ' ', k);
  for j := 1 to 2 do
  begin
    UG := UG + 1;
    Bump;
  end;
  WriteLn(UG, ' ', US[1]);
end.
