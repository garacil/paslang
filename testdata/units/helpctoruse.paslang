{ P170: a used unit's class helper: its constructor makes a TCell, its
  static method is called through the class's name. }
program helpctoruse;

uses helpctoru;

var
  c: TCell;

begin
  c := TCell.Make(4);
  WriteLn(c.V, ' ', TCell.Seed);
end.

