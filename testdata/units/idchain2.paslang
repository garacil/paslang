{ P458: the second of the chain: its interface uses the first and sysutils,
  and it gives a TSysError. }
unit idchain2;

interface

uses
  idchain1, sysutils;

type
  TCrate = record
    Box: TBox;
    N: Integer;
    procedure Fill(Count: Integer);
    function Volume: Integer;
  end;

function Probe(Code: Integer; out Err: TSysError): Boolean;
function Inspect(var Err: TSysError): Boolean;
procedure Settle(var Err: TSysError);

implementation

procedure TCrate.Fill(Count: Integer);
begin
  N := Count;
end;

function TCrate.Volume: Integer;
begin
  Result := Box.Area * N;
end;

function Probe(Code: Integer; out Err: TSysError): Boolean;
begin
  Err := Default(TSysError);
  Result := Code = 0;
  if not Result then
  begin
    Err.Code := Code;
    Err.Operation := 'probe';
  end;
end;

function Inspect(var Err: TSysError): Boolean;
begin
  Result := Probe(2, Err);
end;

procedure Settle(var Err: TSysError);
begin
  Probe(0, Err);
end;

end.
