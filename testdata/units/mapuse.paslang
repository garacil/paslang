{ Uses a map type from a unit. }
program mapuse;

uses mapu;

var
  m: TNames;
  m2: map[Integer] of string;
  k, n: Integer;
  v: string;

begin
  m := NewNames;
  m[3] := 'three';
  WriteLn(m[1], ' ', m[2], ' ', m[3], ' ', Length(m[1]), ' ', Count(m));
  n := 0;
  for k, v in m do
    n := n + Length(v);
  WriteLn(n);
  { the same type written here goes into the unit's (1.0.140) }
  New(m2);
  m2[9] := 'nine';
  m2 := NewNames;
  m2[4] += '!';
  m[1] += 'x';
  WriteLn(Count(m2), ' ', m2[4], ' ', m[1]);
end.
