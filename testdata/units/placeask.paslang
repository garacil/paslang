{ P572: the runtime's own answer for every pc it is asked. The first
  line of the input is how many follow, each a pc in decimal; for each
  the program writes the line rt_pcline gives and the unit's name, as
  SysUtils and a fatal line read them. scripts/check_paslines.py --ask
  sends every address of the assembler's line table, the ones around
  them and the ends of every routine, and compares: what halves the
  records and reads the tables here is the runtime's code itself, on
  each machine. SysUtils calls rt_pcline from a block of assembly that
  names no register, so the registers a routine keeps across a call
  must come back from it as they were: three of them hold marks here,
  and an answer says so when one is lost.

  Made carries a routine, its record and its table written by hand, the
  labels of the table out of the order of their addresses (the third,
  then the first, a step back of three bytes as the ten bytes of its
  two's complement, then the second): the compiler writes no such
  table, and the runtime must read one right all the same, by the
  greatest offset not above the pc and not by the last one written.
  The .loc lines give the assembler's table the same three lines, 901
  to 903, for the checker to compare. }
program placeask;

uses
  sysutils, PlaceU;

function LineAt(Pc: Int64; out Nm: Pointer; out Lost: Int64): Int64;
var
  p: Pointer;
  bad: Int64;
begin
  asm amd64 (Pc: in rdi; Result: out rax; p: out rdx; bad: out rcx)
    movq $273, %rbx
    movq $546, %r12
    movq $819, %r13
    call rt_pcline
    xorl %ecx, %ecx
    cmpq $273, %rbx
    je 1f
    orl $1, %ecx
  1:
    cmpq $546, %r12
    je 2f
    orl $2, %ecx
  2:
    cmpq $819, %r13
    je 3f
    orl $4, %ecx
  3:
  end;
  asm arm64 (Pc: in x0; Result: out x0; p: out x1; bad: out x2)
    mov x19, #273
    mov x20, #546
    mov x21, #819
    str x30, [sp, #-16]!
    bl rt_pcline
    ldr x30, [sp], #16
    mov x2, xzr
    cmp x19, #273
    b.eq 1f
    orr x2, x2, #1
  1:
    cmp x20, #546
    b.eq 2f
    orr x2, x2, #2
  2:
    cmp x21, #819
    b.eq 3f
    orr x2, x2, #4
  3:
  end;
  Nm := p;
  Lost := bad;
end;

function Made: Int64;
begin
  asm amd64 (Result: out rax)
    leaq p_placeask_made(%rip), %rax
    .pushsection .text.p_placeask_made,"ax",@progbits
  p_placeask_made:
    .loc 1 901
  1:
    nop
    .loc 1 902
  2:
    nop
    nop
    .loc 1 903
  3:
    nop
  4:
    .popsection
    .pushsection .rodata.plmade,"a"
  5:
    .uleb128 3
    .uleb128 3b-p_placeask_made, 1806
    .uleb128 1b-3b, 3
    .uleb128 2b-1b, 2
    .popsection
    .pushsection paslines.p_placeask_made,"ao",@progbits,p_placeask_made
    .balign 4
    .long p_placeask_made-.
    .long 4b-p_placeask_made
    .long 5b-.
    .long 0
    .popsection
  end;
  asm arm64 (Result: out x0)
    adrp x0, p_placeask_made
    add x0, x0, :lo12:p_placeask_made
    .pushsection .text.p_placeask_made,"ax",%progbits
  p_placeask_made:
    .loc 1 901
  1:
    nop
    .loc 1 902
  2:
    nop
    nop
    .loc 1 903
  3:
    nop
  4:
    .popsection
    .pushsection .rodata.plmade,"a"
  5:
    .uleb128 3
    .uleb128 3b-p_placeask_made, 1806
    .uleb128 1b-3b, 3
    .uleb128 2b-1b, 2
    .popsection
    .pushsection paslines.p_placeask_made,"ao",%progbits,p_placeask_made
    .balign 4
    .long p_placeask_made-.
    .long 4b-p_placeask_made
    .long 5b-.
    .long 0
    .popsection
  end;
end;

var
  s, name: string;
  n, i, k, line, lost: Int64;
  nm: Pointer;
  a: array of Integer;
begin
  { the unit's routines are in the program }
  SetLength(a, 4);
  if Pick(a, 1) + Half(4, 2) + Through(a, 0) + Outer(a, 1) + SumTo(a, 4) + CallFill(1) + Whole(1.5) < 0 then
    WriteLn('never');
  if Made = 0 then
    WriteLn('never');
  ReadLn(s);
  n := StrToInt64(s);
  for i := 1 to n do
  begin
    ReadLn(s);
    line := LineAt(StrToInt64(s), nm, lost);
    name := '';
    if (line <> 0) and (nm <> nil) then
      for k := 1 to PByte(nm)^ do
        name := name + Char(PByte(Int64(nm) + k)^);
    if lost <> 0 then
      WriteLn('registers lost: ', lost)
    else
      WriteLn(line, ' ', name);
  end;
end.

