unit shapevderived;

interface

uses
  shapevbase;

type
  TShapeVDerived = class(TShapeVBase)
  public
    function Sum(const A: array of Integer): Integer; override;
  end;

implementation

function TShapeVDerived.Sum(const A: array of Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
end;

end.
