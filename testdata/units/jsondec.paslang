{ P206: typed decoding across units: a record, a class whose private
  fields have json directives, a generic instance, and a unit that
  decodes in its own routines (its decoders written at its end), a
  typed for and a typed TryGet among them. }
unit jsondec;

interface

type
  TUser = record
    Id: Integer json 'id';
    Name: string json 'name';
    Tags: array of string json 'tags' omitempty;
  end;

  TAccount = class
  private
    FOwner: string json 'owner';
    FSecret: Integer json 'secret';
  public
    Balance: Currency json 'balance';
    property Owner: string read FOwner;
    function Secret: Integer;
  end;

  generic TBox<T> = record
    Value: T json 'value';
    Seen: Boolean json 'seen';
  end;
  TIntBox = specialize TBox<Integer>;

function ParseUser(const S: string): TUser;
function SumIds(J: json): Integer;
function NameOf(J: json; const K: string): string;

implementation

function TAccount.Secret: Integer;
begin
  Result := FSecret;
end;

function ParseUser(const S: string): TUser;
begin
  JsonDecode(S, Result);
end;

function SumIds(J: json): Integer;
var
  u: TUser;
begin
  Result := 0;
  for u in J do
    Result := Result + u.Id;
end;

function NameOf(J: json; const K: string): string;
var
  u: TUser;
begin
  if TryGet(J, K, u) then
    Result := u.Name
  else
    Result := '?';
end;

end.

