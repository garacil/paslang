unit shapeextrabase;
interface
uses shapeextraorigin;
type
  TExtraBase = class
  public
    Tag: Integer;
    constructor Create(P: ^Integer; M: function(X: Integer): Integer of object; R: 0..7; S: set of 0..7; F: function(X: Integer): Integer; T: tree[Integer] of Integer; U: tree of Integer; H: heap of Integer; C: class of TExtraAnchor);
    function PtrValue(P: ^Integer): Integer; virtual;
    function MethodValue(M: function(X: Integer): Integer of object): Integer; virtual;
    function RangeValue(R: 0..7): Integer; virtual;
    function SetValue(S: set of 0..7): Integer; virtual;
    function ProcValue(F: function(X: Integer): Integer): Integer; virtual;
    function TreeValue(T: tree[Integer] of Integer): Integer; virtual;
    function TreeSetValue(U: tree of Integer): Integer; virtual;
    function HeapValue(H: heap of Integer): Integer; virtual;
    function ClassValue(C: class of TExtraAnchor): Integer; virtual;
  end;
procedure FreeExtra(P: ^Integer; M: function(X: Integer): Integer of object; R: 0..7; S: set of 0..7; F: function(X: Integer): Integer; T: tree[Integer] of Integer; U: tree of Integer; H: heap of Integer; C: class of TExtraAnchor);
function TotalExtra(P: ^Integer; M: function(X: Integer): Integer of object; R: 0..7; S: set of 0..7; F: function(X: Integer): Integer; T: tree[Integer] of Integer; U: tree of Integer; H: heap of Integer; C: class of TExtraAnchor): Integer;
function SeenExtra: Integer;
implementation
uses shapeextraaliasa, shapeextraaliasb, pasjson;
var Seen: Integer;
constructor TExtraBase.Create(P: ^Integer; M: function(X: Integer): Integer of object; R: 0..7; S: set of 0..7; F: function(X: Integer): Integer; T: tree[Integer] of Integer; U: tree of Integer; H: heap of Integer; C: class of TExtraAnchor);
begin Tag := TotalExtra(P, M, R, S, F, T, U, H, C) end;
function TExtraBase.PtrValue(P: ^Integer): Integer;
begin Result := -1 end;
function TExtraBase.MethodValue(M: function(X: Integer): Integer of object): Integer;
begin Result := -1 end;
function TExtraBase.RangeValue(R: 0..7): Integer;
begin Result := -1 end;
function TExtraBase.SetValue(S: set of 0..7): Integer;
begin Result := -1 end;
function TExtraBase.ProcValue(F: function(X: Integer): Integer): Integer;
begin Result := -1 end;
function TExtraBase.TreeValue(T: tree[Integer] of Integer): Integer;
begin Result := -1 end;
function TExtraBase.TreeSetValue(U: tree of Integer): Integer;
begin Result := -1 end;
function TExtraBase.HeapValue(H: heap of Integer): Integer;
begin Result := -1 end;
function TExtraBase.ClassValue(C: class of TExtraAnchor): Integer;
begin Result := -1 end;
procedure FreeExtra(P: ^Integer; M: function(X: Integer): Integer of object; R: 0..7; S: set of 0..7; F: function(X: Integer): Integer; T: tree[Integer] of Integer; U: tree of Integer; H: heap of Integer; C: class of TExtraAnchor);
begin Seen := TotalExtra(P, M, R, S, F, T, U, H, C) end;
function TotalExtra(P: ^Integer; M: function(X: Integer): Integer of object; R: 0..7; S: set of 0..7; F: function(X: Integer): Integer; T: tree[Integer] of Integer; U: tree of Integer; H: heap of Integer; C: class of TExtraAnchor): Integer;
begin Result := P^ + M(2) + R + Ord(2 in S) + F(3) + T[4] + Ord(4 in U) + Length(H) + Ord(C = TExtraAnchor) end;
function SeenExtra: Integer;
begin Result := Seen end;
end.
