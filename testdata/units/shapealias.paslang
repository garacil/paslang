{ P619: aliases of shapes, as sysutils, passort and sqlite declare them.
  A unit whose implementation uses this one gave its own anonymous
  types these names in its .pi. }
unit shapealias;

interface

type
  TShapeInts = array of Integer;
  TShapeStrs = array of string;
  TShapeMap = map[Integer] of string;
  TShapeChan = chan of Integer;
  TShapeFixed = array[0..3] of Integer;

implementation

end.
