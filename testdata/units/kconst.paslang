{ A unit interface exports constants of every kind, and the
  implementation may keep its own (P97). }
unit kconst;

interface

const
  Tag = 'unit';
  Scale = 2.5;
  Bell = #7;
  Flag = True;
  Count = 4;

function Inside: string;
function Doubled: Integer;

implementation

const
  Hidden = 'inside';
  Twice = Count;

function Inside: string;
begin
  Result := Hidden;
end;

function Doubled: Integer;
begin
  Result := Twice * 2;
end;

end.

