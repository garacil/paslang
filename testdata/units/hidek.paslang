{ A unit with a name of every kind for each kind of name a program
  declares to hide it (P158): Gxy is hidden at the top level by a y
  (v a variable, c a constant, r a routine, t a type), Lxy in a
  routine by a y (v a variable, p a parameter, c a constant, t a type);
  x is what the unit declares (V, C, R, T). }
unit hidek;

{$mode objfpc}{$H+}

interface

type
  GTv = array[1..12] of Byte;
  GTc = array[1..13] of Byte;
  GTr = array[1..14] of Byte;
  GTt = array[1..15] of Byte;
  LTv = array[1..28] of Byte;
  LTp = array[1..29] of Byte;
  LTc = array[1..30] of Byte;
  LTt = array[1..31] of Byte;

var
  GVv: Integer = 100;
  GVc: Integer = 101;
  GVr: Integer = 102;
  GVt: Integer = 103;
  LVv: Integer = 116;
  LVp: Integer = 117;
  LVc: Integer = 118;
  LVt: Integer = 119;

const
  GCv = 104;
  GCc = 105;
  GCr = 106;
  GCt = 107;
  LCv = 120;
  LCp = 121;
  LCc = 122;
  LCt = 123;

function GRv: Integer;
function GRc: Integer;
function GRr: Integer;
function GRt: Integer;
function LRv: Integer;
function LRp: Integer;
function LRc: Integer;
function LRt: Integer;

implementation

function GRv: Integer;
begin
  Result := 108;
end;

function GRc: Integer;
begin
  Result := 109;
end;

function GRr: Integer;
begin
  Result := 110;
end;

function GRt: Integer;
begin
  Result := 111;
end;

function LRv: Integer;
begin
  Result := 124;
end;

function LRp: Integer;
begin
  Result := 125;
end;

function LRc: Integer;
begin
  Result := 126;
end;

function LRt: Integer;
begin
  Result := 127;
end;

end.

