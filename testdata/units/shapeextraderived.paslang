unit shapeextraderived;
interface
uses shapeextraorigin, shapeextrabase;
type
  TExtraDerived = class(TExtraBase)
  public
    function PtrValue(P: ^Integer): Integer; override;
    function MethodValue(M: function(X: Integer): Integer of object): Integer; override;
    function RangeValue(R: 0..7): Integer; override;
    function SetValue(S: set of 0..7): Integer; override;
    function ProcValue(F: function(X: Integer): Integer): Integer; override;
    function TreeValue(T: tree[Integer] of Integer): Integer; override;
    function TreeSetValue(U: tree of Integer): Integer; override;
    function HeapValue(H: heap of Integer): Integer; override;
    function ClassValue(C: class of TExtraAnchor): Integer; override;
  end;
implementation
function TExtraDerived.PtrValue(P: ^Integer): Integer;
begin Result := P^ end;
function TExtraDerived.MethodValue(M: function(X: Integer): Integer of object): Integer;
begin Result := M(2) end;
function TExtraDerived.RangeValue(R: 0..7): Integer;
begin Result := R end;
function TExtraDerived.SetValue(S: set of 0..7): Integer;
begin Result := Ord(2 in S) end;
function TExtraDerived.ProcValue(F: function(X: Integer): Integer): Integer;
begin Result := F(3) end;
function TExtraDerived.TreeValue(T: tree[Integer] of Integer): Integer;
begin Result := T[4] end;
function TExtraDerived.TreeSetValue(U: tree of Integer): Integer;
begin Result := Ord(4 in U) end;
function TExtraDerived.HeapValue(H: heap of Integer): Integer;
begin Result := Length(H) end;
function TExtraDerived.ClassValue(C: class of TExtraAnchor): Integer;
begin Result := Ord(C = TExtraAnchor) end;
end.
