unit PlaceV;

{ P572: a failure inside a unit names its line and the unit. This one
  uses nothing, so a program without SysUtils reads the place from the
  runtime alone (placedie, placenil, placefin); PlaceU uses it, and a
  failure two units down names this one. }

interface

type
  PCell = ^TCell;
  TCell = record
    Value: Integer;
  end;

var
  FailAtEnd: Boolean;

function Deep(const A: array of Integer; I: Integer): Integer;
function Peek(P: PCell): Integer;

implementation

var
  parts: Integer;

function Deep(const A: array of Integer; I: Integer): Integer;
begin
  Result := A[I] + 1;
end;

function Peek(P: PCell): Integer;
begin
  Result := P^.Value;
end;

finalization
  if FailAtEnd then
    WriteLn(100 div parts);
end.

