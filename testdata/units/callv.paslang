unit CallV;

{ P579, for callun: the lowest unit, where the object is raised: from a
  routine, from a method, under a finally of its own (whose routine is
  then the lowest that still stands on the stack when the program ends)
  and at the bottom of a recursion deeper than the calls that are said. }

interface

type
  EDeep = class
  end;
  TDoor = class
    procedure Open(N: Integer);
  end;

procedure Lowest(N: Integer);
procedure Guarded(N: Integer);
procedure Down(N: Integer);

implementation

procedure TDoor.Open(N: Integer);
begin
  if N > 3 then
    raise EDeep.Create;
  WriteLn('not raised');
end;

procedure Lowest(N: Integer);
begin
  if N > 3 then
    raise EDeep.Create;
  WriteLn('not raised');
end;

procedure Guarded(N: Integer);
begin
  try
    Lowest(N);
  finally
    WriteLn('closed');
  end;
end;

procedure Down(N: Integer);
begin
  if N = 0 then
    raise EDeep.Create;
  Down(N - 1);
  WriteLn('not raised');
end;

end.

