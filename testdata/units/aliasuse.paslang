program aliasuse;
{$mode objfpc}{$H+}
uses aliasu, aliaswrap;
var A: TAlias; B: aliasu.TNumber; C: TOther; D: TWrapped;
    N: TWrappedNumber;
begin
  Fill(D, N);
  C := D;
  C.Text[1] := 'A';
  A := N; B := A + 2;
  WriteLn('aliases ', A, ' ', B, ' ', C.Text, ' ', D.Text);
end.
