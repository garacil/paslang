{ P261: a unit's routine, initialization and finalization compiled for
  the processor its $CPU says, whatever the unit's -cpu: make check
  compiles it with -cpu base and greps its .s, and cputuse prints what
  it works out. }
unit cpuu;

interface

function UHigh(x: Integer): Integer;

var
  UInit: Integer;

implementation

{$ifdef CPUX86_64}
{$CPU haswell}
{$else}
{$CPU neoverse-n1}
{$endif}
function UHigh(x: Integer): Integer;
begin
  Result := 63 - LeadingZeros(x);
end;

initialization
  UInit := TrailingZeros(UInit + 40);
end.
