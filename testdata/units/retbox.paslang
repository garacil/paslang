unit retbox;

interface

type
  PBox = ^TBox;
  TBox = record
    N: Integer;
  end;

function Make(V: Integer): PBox;
function Id(P: PBox): PBox;

implementation

function Make(V: Integer): PBox;
var
  b: PBox;
begin
  New(b);
  b^.N := V;
  Result := b;
end;

function Id(P: PBox): PBox;
begin
  Result := P;
end;

end.

