{ P458: the third: its interface uses the second, which used the first. }
unit idchain3;

interface

uses
  idchain2;

type
  TPallet = record
    Crate: TCrate;
    Rows: Integer;
    function Total: Integer;
  end;

procedure Stack(var P: TPallet; Rows: Integer; var Err: TSysError);

implementation

function TPallet.Total: Integer;
begin
  Result := Crate.Volume * Rows;
end;

procedure Stack(var P: TPallet; Rows: Integer; var Err: TSysError);
begin
  P.Rows := Rows;
  Settle(Err);
end;

end.
