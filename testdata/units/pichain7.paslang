{ P460: unit 7 of the chain; its interface uses unit 6. }
unit pichain7;

interface

uses
  pichain6;

type
  TP7 = record
    Inner: TP6;
    B: Integer;
    function Sum: Integer;
  end;

  TC7 = class(TC6)
    function Get: Integer; override;
  end;

function Step7(X: Integer): Integer;

implementation

function TP7.Sum: Integer;
begin
  Result := Inner.Sum + B;
end;

function TC7.Get: Integer;
begin
  Result := inherited Get + 7;
end;

function Step7(X: Integer): Integer;
begin
  Result := Step6(X) + 1;
end;

end.
