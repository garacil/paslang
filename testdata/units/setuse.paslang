{ The sets of unit setu used from a program (P126). }
program setuse;

uses setu;

var
  sc: TScanner;
  s: TSmall;
  c: Char;
  i: Integer;

begin
  WriteLn(CountIn('education'), ' ', CountIn('a1b22c333', Digits), ' ', CountIn('Hi There', Upper));
  WriteLn(CountIn('Hi There', Letters - Upper), ' ', CountIn('x7', Letters + Digits));
  s := Odds;
  Include(s, 2);
  for i in s do
    Write(i);
  WriteLn;
  sc := TScanner.Create;
  sc.Stops := Digits + ['.'];
  WriteLn(sc.Skip('   word'), ' ', sc.Skip(#9' x'), ' ', sc.Skip('..5x', sc.Stops));
  for c in sc.Stops do
    Write(c);
  WriteLn;
end.

