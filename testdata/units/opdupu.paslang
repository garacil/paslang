{ P157: one operator on the same types declared twice in the interface: refused. }
unit opdupu;

interface

type
  TV = record
    X: Integer;
  end;

operator + (A, B: TV): TV;
operator + (C, D: TV): TV;

implementation

operator + (A, B: TV): TV;
begin
  Result.X := A.X + B.X;
end;

end.

