program nestedguse;
{$mode objfpc}{$H+}
uses nestedgu;
type
  TText = specialize nestedgu.TContainer.TSlot<string>;
  TNumber = specialize TContainer.TSlot<Int64>;
var R: TContainer; S: TText; N: TNumber;
begin
  SetText(R, 'imported');
  S := R.Entry;
  S.Data[1] := 'I';
  N.Data := 1000;
  WriteLn('import ', R.Entry.Data, ' ', S.Data, ' ', N.Data, ' ', SizeOf(N.Padding));
end.
