{ A program that hides every kind of name of unit hidek with every kind
  of its own (P158), as Free Pascal does: at the top level a variable, a
  constant, a routine and a type; in a routine a variable, a parameter,
  a constant and a type. Each line writes the program's own and the
  unit's, which its name still reaches. The output is Free Pascal's. }
program hidekuse;

{$mode objfpc}{$H+}

uses hidek;

type
  GVt = array[1..3] of Int64;
  GCt = array[1..7] of Int64;
  GRt = array[1..11] of Int64;
  GTt = array[1..15] of Int64;

const
  GVc = 1001;
  GCc = 1005;
  GRc = 1009;
  GTc = 1013;

var
  GVv: Integer;
  GCv: Integer;
  GRv: Integer;
  GTv: Integer;

function GVr: Integer;
begin
  Result := 1002;
end;

function GCr: Integer;
begin
  Result := 1006;
end;

function GRr: Integer;
begin
  Result := 1010;
end;

function GTr: Integer;
begin
  Result := 1014;
end;

procedure Inside(LVp: Integer; LCp: Integer; LRp: Integer; LTp: Integer);
type
  LVt = array[1..19] of Int64;
  LCt = array[1..23] of Int64;
  LRt = array[1..27] of Int64;
  LTt = array[1..31] of Int64;
const
  LVc = 1018;
  LCc = 1022;
  LRc = 1026;
  LTc = 1030;
var
  LVv: Integer;
  LCv: Integer;
  LRv: Integer;
  LTv: Integer;
begin
  LVv := 1016;
  WriteLn('LVv ', LVv, ' ', hidek.LVv);
  WriteLn('LVp ', LVp, ' ', hidek.LVp);
  WriteLn('LVc ', LVc, ' ', hidek.LVc);
  WriteLn('LVt ', SizeOf(LVt), ' ', hidek.LVt);
  LCv := 1020;
  WriteLn('LCv ', LCv, ' ', hidek.LCv);
  WriteLn('LCp ', LCp, ' ', hidek.LCp);
  WriteLn('LCc ', LCc, ' ', hidek.LCc);
  WriteLn('LCt ', SizeOf(LCt), ' ', hidek.LCt);
  LRv := 1024;
  WriteLn('LRv ', LRv, ' ', hidek.LRv);
  WriteLn('LRp ', LRp, ' ', hidek.LRp);
  WriteLn('LRc ', LRc, ' ', hidek.LRc);
  WriteLn('LRt ', SizeOf(LRt), ' ', hidek.LRt);
  LTv := 1028;
  WriteLn('LTv ', LTv, ' ', SizeOf(hidek.LTv));
  WriteLn('LTp ', LTp, ' ', SizeOf(hidek.LTp));
  WriteLn('LTc ', LTc, ' ', SizeOf(hidek.LTc));
  WriteLn('LTt ', SizeOf(LTt), ' ', SizeOf(hidek.LTt));
end;

begin
  GVv := 1000;
  WriteLn('GVv ', GVv, ' ', hidek.GVv);
  WriteLn('GVc ', GVc, ' ', hidek.GVc);
  WriteLn('GVr ', GVr, ' ', hidek.GVr);
  WriteLn('GVt ', SizeOf(GVt), ' ', hidek.GVt);
  GCv := 1004;
  WriteLn('GCv ', GCv, ' ', hidek.GCv);
  WriteLn('GCc ', GCc, ' ', hidek.GCc);
  WriteLn('GCr ', GCr, ' ', hidek.GCr);
  WriteLn('GCt ', SizeOf(GCt), ' ', hidek.GCt);
  GRv := 1008;
  WriteLn('GRv ', GRv, ' ', hidek.GRv);
  WriteLn('GRc ', GRc, ' ', hidek.GRc);
  WriteLn('GRr ', GRr, ' ', hidek.GRr);
  WriteLn('GRt ', SizeOf(GRt), ' ', hidek.GRt);
  GTv := 1012;
  WriteLn('GTv ', GTv, ' ', SizeOf(hidek.GTv));
  WriteLn('GTc ', GTc, ' ', SizeOf(hidek.GTc));
  WriteLn('GTr ', GTr, ' ', SizeOf(hidek.GTr));
  WriteLn('GTt ', SizeOf(GTt), ' ', SizeOf(hidek.GTt));
  Inside(1017, 1021, 1025, 1029);
end.

