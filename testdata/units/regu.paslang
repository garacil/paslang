unit regu;

{ A unit whose initialization keeps the address of its own globals
  (1.0.136): a program that imports them must not keep them in
  registers across writes through that pointer. }

interface

var
  UG: Integer;
  PG: ^Integer;
  US: array of Integer;
  PS: ^Integer;

procedure Bump;

implementation

procedure Bump;
begin
  PG^ := PG^ + 100;
  PS^ := PS^ + 100;
end;

initialization
  PG := @UG;
  SetLength(US, 4);
  PS := @US[1];
end.

