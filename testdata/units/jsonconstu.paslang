{ P209: a unit's json constant, in its interface: made in the unit's
  initialization, read by a program through the .pi as its variable;
  the unit's own JsonParse of a constant, made there too. }
unit jsonconstu;

interface

const
  Defaults: json = '{"retries":3,"hosts":["a","b"]}';

function Limits: json;

implementation

function Limits: json;
begin
  Result := JsonParse('{"max":10}');
end;

end.

