unit genericu;
{$mode objfpc}{$H+}
interface
type
  generic TCell<T> = record
    Item: T;
  end;
  TTextCell = specialize TCell<string>;
procedure SetText(var C: TTextCell; const S: string);
implementation
procedure SetText(var C: TTextCell; const S: string);
begin C.Item := S end;
end.
