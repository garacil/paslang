{ P205: JsonEncode of bindu's types, written here from what its .pi says. }
program bindmain;

uses
  bindu;

var
  t: TThing;
  it: TItem;

begin
  t := Make;
  WriteLn(JsonEncode(t));
  WriteLn(JsonEncode(t, JsonPretty));
  it.Qty := 12;
  WriteLn(JsonEncode(it), ' ', JsonOf(it)['Qty']);
  t.Free;
end.

