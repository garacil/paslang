{ Two units declare the same class, interface, record, operator and
  helper names (P154), and a program uses both, as in Free Pascal: each
  unit's names are its own in the object code, so the program links, and
  twina.TShape and twinb.TShape stay two classes. The same source
  compiles with Free Pascal, whose output is the one expected. }
program twinuse;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$interfaces corba}
{$endif}

uses sysutils, twina, twinb;

var
  a, sa: twina.TShape;
  b, sb: twinb.TShape;
  va, vb: twina.TVec;
  wa, wb: twinb.TVec;
begin
  a := twina.MakeShape;
  sa := twina.MakeSquare;
  b := twinb.MakeShape;
  sb := twinb.MakeSquare;
  WriteLn(a.Name, ' | ', sa.Name, ' | ', b.Name, ' | ', sb.Name);
  WriteLn(a.ClassName, ' ', sa.ClassName, ' ', b.ClassName, ' ', sb.ClassName);
  WriteLn(twina.CountOf(a), ' ', twinb.CountOf(b), ' ', twina.CountOf(sa), ' ', twinb.CountOf(sb));
  WriteLn(BoolToStr(sa is twina.TSquare, True), ' ', BoolToStr(a is twina.TSquare, True), ' ',
    BoolToStr(sb is twinb.TSquare, True), ' ', BoolToStr(b is twinb.TSquare, True));
  va := twina.Vec(1);
  vb := twina.Vec(2);
  wa := twinb.Vec(1);
  wb := twinb.Vec(2);
  WriteLn(twina.Sum(va, vb).X, ' ', twinb.Sum(wa, wb).X);
  WriteLn(a.Loud, ' ', b.Loud, ' ', sa.Loud, ' ', sb.Loud);
end.

