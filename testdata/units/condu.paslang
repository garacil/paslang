{ P263 (1.1.108): a unit chooses its bodies by the version of paslangc
  compiling it, as a program does (testdata/conduse). }
unit condu;

interface

function Which: string;

implementation

{$if PASLANG_FULLVERSION >= 1001108}
function Which: string;
begin
  Result := 'the body for 1.1.108 and later';
end;
{$else}
function Which: string;
begin
  Result := 'the old body';
end;
{$endif}

end.
