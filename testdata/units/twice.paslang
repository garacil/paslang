unit twice;

{ Uses adder: its .pi names the adder interface it was compiled against
  (DEP adder <sum>), so a program that loads it after adder's interface
  changed is refused (1.0.49). }
interface

uses
  adder;

function AddTwice(A, B: Integer): Integer;

implementation

function AddTwice(A, B: Integer): Integer;
begin
  Result := Add(Add(A, B), Add(A, B));
end;

end.
