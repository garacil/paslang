{ P576: failures belong to the life block itself, including its cold paths. }
unit LifeCaught;
interface
var InitDone: Integer;
implementation
uses sysutils;
type PCell = ^Integer;
var
  Cells: array[0..1] of Integer;
  Index, Zero, Saved, Cleanup: Integer;
  P: PCell;
initialization
  Index := ParamCount + 5;
  Zero := ParamCount;
  Saved := 11;
  Cleanup := 0;
  try
    try
      Saved := Cells[Index]; { init bounds }
    finally
      Cleanup := Cleanup + 1;
    end;
  except
    on E: ERangeError do
    begin
      WriteLn('init bounds ', E.ClassName);
      WriteLn('paslang: ', E.Message);
    end;
  end;
  try
    try
      Saved := 70 div Zero; { init division }
    finally
      Cleanup := Cleanup + 1;
    end;
  except
    on E: EDivByZero do
    begin
      WriteLn('init division ', E.ClassName);
      WriteLn('paslang: ', E.Message);
    end;
  end;
  try
    try
      Saved := P^; { init nil }
    finally
      Cleanup := Cleanup + 1;
    end;
  except
    on E: EAccessViolation do
    begin
      WriteLn('init nil ', E.ClassName);
      WriteLn('paslang: ', E.Message);
    end;
  end;
  Cells[1] := 41;
  Saved := Cells[1] + 1;
  WriteLn('init cleanup ', Cleanup, ' success ', Saved);
  InitDone := 1;
finalization
  Index := ParamCount + 5;
  Zero := ParamCount;
  Saved := 11;
  Cleanup := 0;
  try
    try
      Saved := Cells[Index]; { fini bounds }
    finally
      Cleanup := Cleanup + 1;
    end;
  except
    on E: ERangeError do
    begin
      WriteLn('fini bounds ', E.ClassName);
      WriteLn('paslang: ', E.Message);
    end;
  end;
  try
    try
      Saved := 70 div Zero; { fini division }
    finally
      Cleanup := Cleanup + 1;
    end;
  except
    on E: EDivByZero do
    begin
      WriteLn('fini division ', E.ClassName);
      WriteLn('paslang: ', E.Message);
    end;
  end;
  try
    try
      Saved := P^; { fini nil }
    finally
      Cleanup := Cleanup + 1;
    end;
  except
    on E: EAccessViolation do
    begin
      WriteLn('fini nil ', E.ClassName);
      WriteLn('paslang: ', E.Message);
    end;
  end;
  Cells[1] := 41;
  Saved := Cells[1] + 1;
  WriteLn('fini cleanup ', Cleanup, ' success ', Saved);
end.
