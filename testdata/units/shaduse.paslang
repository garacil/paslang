{ The last unit in uses hides the names the earlier ones share with it,
  as in Free Pascal, and a unit's name reaches its own names (P138):
  shada.Twice, shada.Count, shada.TBox. The same source compiles
  with Free Pascal, whose output is the one expected. }
program shaduse;
uses shada, shadb;
var
  x: TBox;
  y: shada.TBox;
begin
  Count := 5;
  shada.Count := 7;
  x.C := 3;
  y.A := 4;
  WriteLn(Twice(5), ' ', shada.Twice(5), ' ', shadb.Twice(5), ' ', Twice('ab'), ' ', OnlyA, ' ', shada.OnlyA);
  WriteLn(Kind, ' ', shada.Kind, ' ', shadb.Kind, ' ', Size, ' ', shada.Size);
  WriteLn(Count, ' ', shada.Count, ' ', shadb.Count, ' ', x.C, ' ', y.A);
end.

