{ P204: a unit's interface carries json: a variable, routines that take
  and give one, a record and a class with a json field, a generic
  instance of json and a helper of its own, all through its .pi. }
unit jsonu;

interface

type
  TCfg = record
    Name: string;
    Body: json;
  end;

  TDoc = class
  private
    FRoot: json;
  public
    constructor Create(const Text: string);
    property Root: json read FRoot;
  end;

  generic TBag<T> = record
    Item: T;
    Count: Integer;
  end;
  TJsonBag = specialize TBag<json>;

  TCfgHelper = type helper(TJsonHelper) for json
    function PortOr(Otherwise: Integer): Integer;
  end;

var
  Shared: json;

function Load(const S: string): TCfg;
function Port(const C: TCfg): Integer;
function Pick(J: json; const Name: string): json;
function Bag(J: json): TJsonBag;

implementation

constructor TDoc.Create(const Text: string);
begin
  FRoot := JsonParse(Text);
end;

function TCfgHelper.PortOr(Otherwise: Integer): Integer;
begin
  if ('port' in Self) and (Self['port'].Kind = jkNumber) then
    Result := Self['port'].AsInteger
  else
    Result := Otherwise;
end;

function Load(const S: string): TCfg;
begin
  Result.Name := 'cfg';
  Result.Body := JsonParse(S);
  Shared := Result.Body['server'];
end;

function Port(const C: TCfg): Integer;
begin
  Result := C.Body['server']['port'].AsInteger;
end;

function Pick(J: json; const Name: string): json;
begin
  Result := J[Name];
end;

function Bag(J: json): TJsonBag;
begin
  Result.Item := J;
  Result.Count := Length(J);
end;

end.

