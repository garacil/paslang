{ P460: unit 8 of the chain; its interface uses unit 7. }
unit pichain8;

interface

uses
  pichain7;

type
  TP8 = record
    Inner: TP7;
    B: Integer;
    function Sum: Integer;
  end;

  TC8 = class(TC7)
    function Get: Integer; override;
  end;

function Step8(X: Integer): Integer;

implementation

function TP8.Sum: Integer;
begin
  Result := Inner.Sum + B;
end;

function TC8.Get: Integer;
begin
  Result := inherited Get + 8;
end;

function Step8(X: Integer): Integer;
begin
  Result := Step7(X) + 1;
end;

end.
