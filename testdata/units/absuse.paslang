{ absolute names a field of a global record (P162), and of a record in
  it: the name and the field are one variable, written through either,
  in a program, in a routine and through a unit's interface. The output
  is Free Pascal's. }
program absuse;

{$mode objfpc}{$H+}

uses absu;

type
  TPoint = record
    X, Y: Int64;
  end;
  TShape = record
    Tag: Char;
    Corner: TPoint;
  end;

var
  s: TShape;
  cx: Int64 absolute s.Corner.X;
  tag: Char absolute s.Tag;

procedure Shift(D: Int64);
var
  y: Int64 absolute s.Corner.Y;
begin
  y := y + D;
  cx := cx + 2 * D;
end;

begin
  s.Tag := 'a';
  s.Corner.X := 10;
  s.Corner.Y := 20;
  cx := cx + 1;
  tag := 'b';
  Shift(5);
  WriteLn(s.Tag, ' ', s.Corner.X, ' ', s.Corner.Y, ' ', cx, ' ', tag);
  WriteLn(Window, ' ', InnerHi, ' ', Describe);
  Window := 80;
  InnerHi := 7;
  Settings.Sep := '/';
  WriteLn(Settings.Window, ' ', Settings.Inner.Hi, ' ', Describe);
  Settings.Window := 30;
  WriteLn(Window, ' ', Describe);
end.

