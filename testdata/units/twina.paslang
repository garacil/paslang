{ One of two units that declare the same names (P154): a class and its
  descendant, an interface the class implements, a record with its +,
  and a class helper; the + is the unit's own, which Sum uses (a unit
  does not export an operator yet). }
unit twina;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$interfaces corba}
{$endif}

interface

type
  ICount = interface
    function Count: Int64;
  end;

  TShape = class(TObject, ICount)
    function Name: string; virtual;
    function Count: Int64;
  end;

  TSquare = class(TShape)
    function Name: string; override;
  end;

  TVec = record
    X: Int64;
  end;

  TShapeHelper = class helper for TShape
    function Loud: string;
  end;

function Sum(A, B: TVec): TVec;
function MakeShape: TShape;
function MakeSquare: TShape;
function CountOf(C: ICount): Int64;
function Vec(X: Int64): TVec;

implementation

function TShape.Name: string;
begin
  Result := 'shape a';
end;

function TShape.Count: Int64;
begin
  Result := 10;
end;

function TSquare.Name: string;
begin
  Result := 'square a';
end;

function TShapeHelper.Loud: string;
begin
  Result := Name + '!a';
end;


operator + (A, B: TVec): TVec;
begin
  Result.X := A.X + B.X + 10;
end;

function Sum(A, B: TVec): TVec;
begin
  Result := A + B;
end;

function MakeShape: TShape;
begin
  Result := TShape.Create;
end;

function MakeSquare: TShape;
begin
  Result := TSquare.Create;
end;

function CountOf(C: ICount): Int64;
begin
  Result := C.Count;
end;

function Vec(X: Int64): TVec;
begin
  Result.X := X;
end;

end.

