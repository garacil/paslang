{ The later unit's Half(Double) hides the earlier unit's Half(Integer)
  (P160): Half(2.5) goes to ovan's Half, which ovbn's does not hide
  when ovan comes last. Free Pascal refuses it too. }
program ovbad;

{$mode objfpc}{$H+}

uses ovbn, ovan;

begin
  WriteLn(Half(2.5));
end.

