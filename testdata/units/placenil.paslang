{ P572: a nil pointer read inside a unit: the signal's report names the
  unit's line. }
program placenil;

uses
  PlaceV;

var
  p: PCell;
begin
  p := nil;
  WriteLn('before');
  WriteLn(Peek(p));
  WriteLn('after');
end.

