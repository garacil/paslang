{ Whether the earlier unit's routine is declared overload does not
  matter (P160): ovbn's Half hides ovao's. The output is Free Pascal's. }
program ovuse3;

{$mode objfpc}{$H+}

uses ovao, ovbn;

begin
  WriteLn(Half(3), ' ', Half(2.5));
end.

