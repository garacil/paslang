{ P460: the first of a chain of eight units, each using the one before
  in its interface: a record with methods, a class, and SysUtils used in
  the implementation, whose types come into every unit after it. }
unit pichain1;

interface

type
  TP1 = record
    A: Integer;
    function Twice: Integer;
  end;

  TC1 = class
    N: Integer;
    function Get: Integer; virtual;
  end;

function Step1(X: Integer): Integer;

implementation

uses
  sysutils;

function TP1.Twice: Integer;
begin
  Result := 2 * A;
end;

function TC1.Get: Integer;
begin
  Result := N;
end;

function Step1(X: Integer): Integer;
begin
  Result := StrToInt(IntToStr(X)) + 1;
end;

end.
