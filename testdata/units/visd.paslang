unit visd;

{ A descendant, in another unit, of visu's TVisBase (1.0.137): its
  methods use the protected and strict protected members, Self's and
  another instance's, through Self. and without, a protected method
  through inherited, a protected property. }

interface

uses visu;

type
  TVisKid = class(TVisBase)
  protected
    procedure ProtShow; override;
  public
    constructor Create(N: Integer);
    destructor Destroy; override;
    function Total: Integer;
    function Other(B: TVisBase): Integer;
    procedure Report; override;
  end;

implementation

constructor TVisKid.Create(N: Integer);
begin
  inherited Create(N);
  FProt := FProt + 100;
end;

destructor TVisKid.Destroy;
begin
  WriteLn('TVisKid.Destroy ', Secret);
  inherited Destroy;
end;

procedure TVisKid.ProtShow;
begin
  inherited ProtShow;
  WriteLn('TVisKid.ProtShow ', ProtProp);
end;

function TVisKid.Total: Integer;
begin
  ProtShow;
  Result := FProt + ProtTwice + Self.FSP + SPValue + Secret;
end;

function TVisKid.Other(B: TVisBase): Integer;
begin
  Result := B.FProt + B.ProtTwice + B.ProtProp + B.FSP + B.SPValue;
end;

procedure TVisKid.Report;
begin
  inherited Report;
  WriteLn('TVisKid.Report ', Total);
end;

end.

