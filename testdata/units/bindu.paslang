{ P205: a unit's types with json directives, encoded by a program that
  uses it: the names, options and private members come through the .pi. }
unit bindu;

interface

type
  TItem = record
    Name: string json 'full name' omitempty;
    Qty: Integer json quoted;
    Plain: Integer;
  end;

  TThing = class
  private
    FN: string;
    FHidden: Integer;
  public
    Items: array of TItem json 'items';
    property N: string read FN write FN json 'n';
  end;

function Make: TThing;

implementation

function Make: TThing;
begin
  Result := TThing.Create;
  Result.FN := 'thing';
  Result.FHidden := 7;
  SetLength(Result.Items, 2);
  Result.Items[0].Name := 'a';
  Result.Items[0].Qty := 3;
  Result.Items[1].Qty := 4;
end;

end.

