{ P458: the fourth uses the second and the third: the first's types come
  to it by two roads. }
unit idchain4;

interface

uses
  idchain2, idchain3;

type
  TLoad = record
    Pallet: TPallet;
    Crate: TCrate;
    function Count: Integer;
  end;

function Weigh(const L: TLoad; out Err: TSysError): Integer;

implementation

function TLoad.Count: Integer;
begin
  Result := Pallet.Total + Crate.Volume;
end;

function Weigh(const L: TLoad; out Err: TSysError): Integer;
begin
  Inspect(Err);
  Result := L.Count;
end;

end.
