{ P458: the same chain reached through its last unit alone, and sysutils
  named after it. }
program idchainuse2;

uses
  idchain4, sysutils;

var
  b: TBytes;
  f: TSysError;
  l: TLoad;

begin
  SetLength(b, 4);
  if TryRandomBytes(b, 0, 4, f) then
    WriteLn('random ok')
  else
    WriteLn('random ', f.Code);
  l.Crate.Box.W := 1;
  l.Crate.Box.H := 2;
  l.Crate.Fill(5);
  l.Pallet.Crate := l.Crate;
  Stack(l.Pallet, 3, f);
  WriteLn('load ', l.Count, ' weighed ', Weigh(l, f), ' ', f.Code, ' ', f.Failed);
  WriteLn(Inspect(f), ' ', f.Code);
end.
