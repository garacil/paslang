{ A unit whose variable, constant and routine a program's nested
  routines hide (P159). }
unit nestu;

{$mode objfpc}{$H+}

interface

var
  V1: Int64 = 11;

const
  C1 = 3;

function R1: Int64;

implementation

function R1: Int64;
begin
  Result := 5;
end;

end.

