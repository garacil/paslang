{ P458: a unit's type is one type however the chain of units that reach
  it runs. TSysError and the records of idchain1..4, which have methods,
  are given to routines of every unit of the chain, the program naming
  the units in the order that brought a second copy of them in. }
program idchainuse;

uses
  sysutils, idchain2, idchain3, idchain4, idchain1;

var
  b: TBytes;
  f, g: TSysError;
  l: TLoad;
  box: TBox;
  pal: TPallet;
  crate: TCrate;

begin
  SetLength(b, 8);
  if TryRandomBytes(b, 0, 8, f) then
    WriteLn('random ok')
  else
    WriteLn('random ', f.Code);
  box := MakeBox(2, 3);
  box.Grow(1);
  WriteLn('box ', box.W, 'x', box.H, ' ', box.Area);
  crate.Box := box;
  crate.Fill(4);
  WriteLn('crate ', crate.Volume);
  Stack(pal, 2, f);
  pal.Crate := crate;
  WriteLn('pallet ', pal.Rows, ' ', pal.Total, ' failed ', f.Failed);
  l.Pallet := pal;
  l.Crate := crate;
  WriteLn('load ', l.Count, ' weighed ', Weigh(l, g), ' error ', g.Code, ' ', g.Operation, ' ', g.Failed);
  WriteLn('inspect ', Inspect(g), ' ', g.Code, ' ', g.Failed);
  g := f;
  WriteLn('copied ', g.Failed, ' ', g.Code);
end.
