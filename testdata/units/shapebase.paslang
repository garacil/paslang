{ P619: a unit whose implementation uses a unit of aliases. Its own
  heads say the shapes without a name, as a user writes them. }
unit shapebase;

interface

type
  TShapeBase = class
  public
    Tag: string;
    constructor Create(const Names: array of string);
    function Sum(const A: array of Integer): Integer; virtual;
    function Count(M: map[Integer] of string): Integer; virtual;
    function Fixed(const F: array[0..3] of Integer): Integer; virtual;
    function Pass(C: chan of Integer): Integer; virtual;
  end;

procedure Free1(const Names: array of string);
function Total(const Names: array of string): Integer;
function CallAll(B: TShapeBase): string;

implementation

uses
  shapealias, sysutils, passort;

var
  seen: array of string;

constructor TShapeBase.Create(const Names: array of string);
begin
  Tag := IntToStr(Length(Names));
end;

function TShapeBase.Sum(const A: array of Integer): Integer;
begin
  Result := -1;
end;

function TShapeBase.Count(M: map[Integer] of string): Integer;
begin
  Result := -1;
end;

function TShapeBase.Fixed(const F: array[0..3] of Integer): Integer;
begin
  Result := -1;
end;

function TShapeBase.Pass(C: chan of Integer): Integer;
begin
  Result := -1;
end;

procedure Free1(const Names: array of string);
begin
  seen := Append(seen, IntToStr(Length(Names)));
end;

function Total(const Names: array of string): Integer;
begin
  Result := Length(Names) + Length(seen);
end;

function CallAll(B: TShapeBase): string;
var
  v: array of Integer;
  m: map[Integer] of string;
  f: array[0..3] of Integer;
  c: chan of Integer;
begin
  SetLength(v, 3);
  v[0] := 1;
  v[1] := 2;
  v[2] := 3;
  New(m);
  m[1] := 'a';
  m[2] := 'b';
  f[0] := 10;
  f[1] := 20;
  f[2] := 30;
  f[3] := 40;
  c := MakeChan(1);
  Send(c, 42);
  Result := IntToStr(B.Sum(v)) + ' ' + IntToStr(B.Count(m)) + ' ' + IntToStr(B.Fixed(f)) + ' ' + IntToStr(B.Pass(c));
end;

end.
