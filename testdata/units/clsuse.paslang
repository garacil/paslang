program clsuse;

{ Class members of a unit's classes (P123): the class variable through
  its class property, class methods and the virtual one on each class
  and through a reference, a virtual constructor through the unit's
  registry and through a reference of this program, a class of this
  program's own that descends from the unit's, with its class
  constructor and destructor. }

uses clsu;

type
  TTwig = class(TLeaf)
    class function Kind: string; override;
    class constructor Open;
    class destructor Shut;
  end;

class function TTwig.Kind: string;
begin
  Result := 'twig';
end;

class constructor TTwig.Open;
begin
  WriteLn('class constructor of TTwig');
end;

class destructor TTwig.Shut;
begin
  WriteLn('class destructor of TTwig');
end;

var
  c: TNodeClass;
  n: TNode;

begin
  WriteLn('main starts, ', TNode.Made, ' made');
  WriteLn(TNode.Label('a'), ' ', TLeaf.Label('b'), ' ', TTwig.Label('c'));
  WriteLn(TNode.Label, ' ', TLeaf.Label('e', '='));
  WriteLn(MakeAll('x'));
  c := TTwig;
  n := c.Create('y');
  WriteLn(n.ClassName, ' ', n.Tag, ' ', c.Kind, ' ', TNode.Made, ' made');
  Registry[0] := TTwig;
  WriteLn(MakeAll('z'));
  WriteLn('main ends, ', TLeaf.Made, ' made');
end.

