{ P460: unit 3 of the chain; its interface uses unit 2. }
unit pichain3;

interface

uses
  pichain2;

type
  TP3 = record
    Inner: TP2;
    B: Integer;
    function Sum: Integer;
  end;

  TC3 = class(TC2)
    function Get: Integer; override;
  end;

function Step3(X: Integer): Integer;

implementation

function TP3.Sum: Integer;
begin
  Result := Inner.Sum + B;
end;

function TC3.Get: Integer;
begin
  Result := inherited Get + 3;
end;

function Step3(X: Integer): Integer;
begin
  Result := Step2(X) + 1;
end;

end.
