{ P572: a failure inside a unit names its line and the unit, where the
  place was an address (at pc 0x40cd98) or the line of some code of the
  program that stood below it; the program's own code stays at line N.
  Every failure here is taken as an exception (P567), so the place is
  the one SysUtils reads from the runtime's tables: a routine of the
  unit, a method, a nested routine, a loop, a routine put in line, a
  second unit below the first, a routine of the unit run by a
  pasroutine, and beside them a failure of the program's own, before
  and after. }
program placeuse;

uses
  sysutils, PlaceU;

var
  a: array of Integer;
  box: TBox;
  said: chan of string;

procedure Own(I: Integer);
begin
  try
    WriteLn(a[I]);
  except
    on e: Exception do
      WriteLn('the program: ', e.Message);
  end;
end;

procedure Worker;
begin
  try
    Send(said, IntToStr(Pick(a, 40)));
  except
    on e: Exception do
      Send(said, e.Message);
  end;
end;

procedure Try1(K: Integer);
begin
  try
    case K of
      1: WriteLn(Pick(a, 7));
      2: WriteLn(Half(7, K - 2));
      3: WriteLn(Through(a, 9));
      4: WriteLn(box.At(4));
      5: WriteLn(Outer(a, 5));
      6: WriteLn(SumTo(a, 4));
      7: WriteLn(CallFill(6));
      8: WriteLn(Whole(1.0e30));
    end;
  except
    on e: Exception do
      WriteLn(K, ': ', e.Message);
  end;
end;

var
  k: Integer;
begin
  SetLength(a, 3);
  box := TBox.Create(2);
  Own(3);
  for k := 1 to 8 do
    Try1(k);
  said := MakeChan(1);
  pas Worker;
  WriteLn('a pasroutine: ', Recv(said));
  Own(-1);
  { inside their ranges nothing fails }
  WriteLn(Pick(a, 2) + Half(8, 2) + Through(a, 0) + box.At(1) + Outer(a, 1) + SumTo(a, 3) + CallFill(2) + Whole(2.5));
end.

