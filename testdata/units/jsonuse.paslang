{ P204: what jsonu exports, used through its .pi. }
program jsonuse;

uses
  jsonu;

var
  c: TCfg;
  d: TDoc;
  b: TJsonBag;
  local: specialize TBag<json>;

begin
  c := Load('{"server":{"port":8080,"host":"h"},"tags":["a","b"]}');
  WriteLn(c.Name, ' ', Port(c), ' ', Shared['host'], ' ', Shared.PortOr(1));
  WriteLn(Pick(c.Body, 'tags'), ' ', c.Body['tags'].PortOr(80));
  d := TDoc.Create('[1,{"port":443}]');
  WriteLn(d.Root, ' ', d.Root[1].PortOr(0));
  b := Bag(c.Body['tags']);
  WriteLn(b.Item, ' ', b.Count);
  local.Item := Shared;
  local.Count := 1;
  WriteLn(local.Item['port'], ' ', local.Item = Shared);
  d.Free;
end.

