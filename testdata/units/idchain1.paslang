{ P458: the base of a chain of units. A record with methods (its own
  helper goes into the .pi beside it), and sysutils used in the
  implementation alone. The units after it use each other in their
  interfaces, and every one's .pi brings the types of those before it in
  again. }
unit idchain1;

interface

type
  TBox = record
    W, H: Integer;
    procedure Grow(By: Integer);
    function Area: Integer;
  end;

function MakeBox(W, H: Integer): TBox;

implementation

uses
  sysutils;

procedure TBox.Grow(By: Integer);
begin
  W := W + By;
  H := H + By;
end;

function TBox.Area: Integer;
begin
  Result := W * H;
end;

function MakeBox(W, H: Integer): TBox;
begin
  Result.W := W;
  Result.H := H;
end;

end.
