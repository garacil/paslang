{ P171: a used unit's record operators and conversions. }
program recopsuse;

uses recopsu;

var
  a, b: TVec2;

begin
  a := Vec2(1, 2);
  b := 3;
  a := a + b;
  WriteLn(a.X, ' ', a.Y, ' ', Integer(a), ' ', a = Vec2(4, 5), ' ', a = b);
end.

