{ A unit whose classes name each other (P139): TLeaf is declared
  forward, TTree names it, and TLeaf descends from TTree, so the
  descendant's type comes before its parent's in the unit's interface. }
unit clsfwdu;

interface

type
  TLeaf = class;
  IVisit = interface;

  TTree = class
    Leaves: array of TLeaf;
    procedure Add(L: TLeaf);
    function Walk(V: IVisit): Int64;
    function Kind: string; virtual;
  end;

  TLeaf = class(TTree)
    Weight: Int64;
    function Kind: string; override;
  end;

  IVisit = interface
    function Visit(L: TLeaf): Int64;
  end;

  ELeafError = class(TObject);

implementation

procedure TTree.Add(L: TLeaf);
begin
  SetLength(Leaves, Length(Leaves) + 1);
  Leaves[High(Leaves)] := L;
end;

function TTree.Walk(V: IVisit): Int64;
var
  i: Int64;
begin
  Result := 0;
  for i := 0 to High(Leaves) do
    Result := Result + V.Visit(Leaves[i]);
end;

function TTree.Kind: string;
begin
  Result := 'tree';
end;

function TLeaf.Kind: string;
begin
  Result := 'leaf';
end;

end.

