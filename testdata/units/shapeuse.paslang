{ P619: an anonymous shape is one type in every unit. Before, a unit whose
  implementation used a unit of aliases (sysutils, passort, sqlite...)
  wrote its anonymous types under an alias's name, an importer gave the
  shared type that name, and the same shape written in another unit was
  a second type: an override there took no slot and the base method ran,
  and a routine, a function or a constructor of that unit had no body. }
program shapeuse;

uses
  shapebase, shapederived, shapevbase, shapevderived;

var
  d: TShapeDerived;
  v: TShapeVDerived;
  names: array of string;
begin
  SetLength(names, 2);
  names[0] := 'x';
  names[1] := 'y';
  d := TShapeDerived.Create(names);
  WriteLn('overrides in another unit: ', CallAll(d), ' (want 6 2 100 42)');
  Free1(names);
  WriteLn('a constructor, a routine and a function of the unit: ', d.Tag, ' ', Total(names), ' (want 2 3)');
  v := TShapeVDerived.Create;
  WriteLn('an override that took no slot ran the base method: ', CallSum(v), ' (want 6)');
end.
