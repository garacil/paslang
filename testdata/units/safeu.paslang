safe unit safeu;

{ A safe unit (P102): its .pi says SAFE; no raw pointer work inside. }

interface

function Total(const A: array of Integer): Integer;

implementation

function Total(const A: array of Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
end;

end.

