unit uvar;

{ A unit's interface globals are the program's too (1.0.76). }

interface

type
  TPos = record
    X, Y: Integer;
  end;

var
  Counter: Integer;
  Last: string;
  Names: array of string;
  Where: TPos;

const
  Greeting: string = 'hello';
  Limits: array[0..1] of Integer = (5, 9);
  Origin: TPos = (X: -1; Y: -2);

procedure Bump;
procedure AddName(const S: string);
function HiddenValue: Integer;

implementation

var
  Hidden: Integer;

const
  Step: Integer = 100;

procedure Bump;
begin
  Counter := Counter + 1;
  Hidden := Hidden + Step;
end;

procedure AddName(const S: string);
begin
  SetLength(Names, Length(Names) + 1);
  Names[High(Names)] := S + '!';
  Last := Names[High(Names)];
end;

function HiddenValue: Integer;
begin
  Result := Hidden;
end;

end.
