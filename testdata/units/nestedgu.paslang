unit nestedgu;
{$mode objfpc}{$H+}{$modeswitch advancedrecords}
interface
type
  TContainer = record
    const Width = 4;
    type
      generic TSlot<T> = record
        Data: T;
        Padding: array[0..Width - 1] of Byte;
      end;
      TText = specialize TSlot<string>;
  var
    Entry: TText;
  end;
procedure SetText(var R: TContainer; const Text: string);
implementation
procedure SetText(var R: TContainer; const Text: string);
begin R.Entry.Data := Text end;
end.
