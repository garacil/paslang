program shapeextraab;
uses shapeextraorigin, shapeextraaliasa, shapeextraaliasb, shapeextrabase, shapeextraderived;
function PlusTen(X: Integer): Integer;
begin Result := X + 10 end;
var
  N: Integer;
  A: TExtraAnchor;
  B: TExtraBase;
  P: shapeextraaliasb.TExtraTwinPtr;
  M: shapeextraaliasb.TExtraTwinMethod;
  R: shapeextraaliasb.TExtraTwinRange;
  S: shapeextraaliasb.TExtraTwinSet;
  F: shapeextraaliasb.TExtraTwinProc;
  T: shapeextraaliasb.TExtraTwinTree;
  U: shapeextraaliasb.TExtraTwinTreeSet;
  H: shapeextraaliasb.TExtraTwinHeap;
  C: shapeextraaliasb.TExtraTwinClass;
begin
  N := 11; P := @N;
  A := TExtraAnchor.Create; M := A.Add;
  R := 3; S := [2, 4]; F := @PlusTen;
  New(T); T[4] := 42;
  New(U); Include(U, 4);
  New(H); Push(H, 3); Push(H, 1); Push(H, 2);
  C := TExtraAnchor;
  SeedExtra(P, M, R, S, F, T, U, H, C);
  B := TExtraDerived.Create(P, M, R, S, F, T, U, H, C);
  WriteLn(B.PtrValue(P), ' ', B.MethodValue(M), ' ', B.RangeValue(R), ' ', B.SetValue(S), ' ', B.ProcValue(F), ' ', B.TreeValue(T), ' ', B.TreeSetValue(U), ' ', B.HeapValue(H), ' ', B.ClassValue(C));
  FreeExtra(P, M, R, S, F, T, U, H, C);
  WriteLn(B.Tag, ' ', SeenExtra, ' ', TotalExtra(P, M, R, S, F, T, U, H, C));
  B.Free; A.Free;
end.
