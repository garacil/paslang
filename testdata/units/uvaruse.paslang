program uvaruse;

uses uvar, uvar2;

var
  Hidden: Integer;
  i: Integer;
  s: string;

begin
  Hidden := 7;
  Bump;
  Bump;
  WriteLn(Counter, ' ', HiddenValue, ' ', Hidden);
  Counter := 10;
  Bump;
  WriteLn(Counter);
  for i := 1 to 200 do
  begin
    s := 'n';
    s := s + Chr(48 + i mod 10);
    AddName(s);
  end;
  GcCollect;
  WriteLn(Length(Names), ' ', Names[0], ' ', Names[199], ' ', Last);
  Where.Y := 5;
  Twice;
  WriteLn(Counter, ' ', Where.X, ' ', Where.Y, ' ', HiddenValue);
  WriteLn(Greeting, ' ', Limits[0] + Limits[1], ' ', Origin.X, Origin.Y);
  Greeting := Greeting + '!';
  Limits[1] := 1;
  WriteLn(Greeting, ' ', Limits[0] + Limits[1]);
end.
