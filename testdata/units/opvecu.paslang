{ P157: a record that brings its arithmetic with it. The heads of its
  operators are in the interface, which the .pi exports; their bodies
  are in the implementation, where one operator calls others whose
  bodies come after it. The implementation's own div stays private. }
unit opvecu;

interface

type
  TVec = record
    X, Y: Integer;
  end;

function Vec(X, Y: Integer): TVec;
function Half(const A: TVec): TVec;
function Before(const A, B: TVec): Boolean;

operator + (A, B: TVec): TVec;
operator - (A, B: TVec): TVec;
operator * (A: TVec; K: Integer): TVec;
operator = (A, B: TVec): Boolean;
operator < (A, B: TVec): Boolean;

implementation

{ the implementation's own operator: the .pi does not carry it }
operator div (A: TVec; K: Integer): TVec;
begin
  Result.X := A.X div K;
  Result.Y := A.Y div K;
end;

function Vec(X, Y: Integer): TVec;
begin
  Result.X := X;
  Result.Y := Y;
end;

function Half(const A: TVec): TVec;
begin
  Result := A div 2;
end;

{ this unit's <, which a later unit's on TVec hides from a program that
  uses both, but not from here }
function Before(const A, B: TVec): Boolean;
begin
  Result := A < B;
end;

{ - before + and *: their heads in the interface let it call them }
operator - (A, B: TVec): TVec;
begin
  Result := A + B * (-1);
end;

operator + (A, B: TVec): TVec;
begin
  Result.X := A.X + B.X;
  Result.Y := A.Y + B.Y;
end;

operator * (A: TVec; K: Integer): TVec;
begin
  Result.X := A.X * K;
  Result.Y := A.Y * K;
end;

operator = (A, B: TVec): Boolean;
begin
  Result := (A.X = B.X) and (A.Y = B.Y);
end;

operator < (A, B: TVec): Boolean;
begin
  if A.X <> B.X then
    Result := A.X < B.X
  else
    Result := A.Y < B.Y;
end;

end.

