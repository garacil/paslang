{ P460: unit 4 of the chain; its interface uses unit 3. }
unit pichain4;

interface

uses
  pichain3;

type
  TP4 = record
    Inner: TP3;
    B: Integer;
    function Sum: Integer;
  end;

  TC4 = class(TC3)
    function Get: Integer; override;
  end;

function Step4(X: Integer): Integer;

implementation

function TP4.Sum: Integer;
begin
  Result := Inner.Sum + B;
end;

function TC4.Get: Integer;
begin
  Result := inherited Get + 4;
end;

function Step4(X: Integer): Integer;
begin
  Result := Step3(X) + 1;
end;

end.
