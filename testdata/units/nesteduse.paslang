program nesteduse;
{$mode delphi}{$H+}
uses nestedu, nestedwrap;
var
  N: nestedu.TInfo.TNested;
  R: TInfo;
  V: TInfo.TAlias;
  C: TInfo.TCounter;
  M: TInfo.TMode;
begin
  N.X := 20;
  V := Touch(N);
  R.Value := 30;
  C := TInfo.Code;
  M := TInfo.Mode;
  WriteLn('unit ', N.X, ' ', V, ' ', R.Total, ' ', C, ' ', Ord(M), ' ',
    nestedu.TInfo.TNested.Flag, ' ', TInfo.Mark, ' ', TInfo.Extra, ' ', UnitAccess);
end.
