{ The other unit of ptrause (P164), ptra's routines under other names. }
unit ptrb;

{$mode objfpc}{$H+}

interface

function HeadB(P: PChar; N: Integer): string;
function HeadB(const S: string): string;
function TwiceB(P: PInteger): Integer;
function TwiceB(N: Integer): Integer;
procedure SwapB(var A, B: PChar);
function HereB(const S: string): PChar;

implementation

function HeadB(P: PChar; N: Integer): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to N - 1 do
    Result := Result + P[i];
end;

function HeadB(const S: string): string;
begin
  Result := S;
end;

function TwiceB(P: PInteger): Integer;
begin
  Result := 2 * P^;
end;

function TwiceB(N: Integer): Integer;
begin
  Result := 3 * N;
end;

procedure SwapB(var A, B: PChar);
var
  t: PChar;
begin
  t := A;
  A := B;
  B := t;
end;

function HereB(const S: string): PChar;
begin
  Result := PChar(S);
end;

end.

