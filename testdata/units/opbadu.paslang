{ P157: the implementation's operator of the types the interface declared, with another result: refused. }
unit opbadu;

interface

type
  TV = record
    X: Integer;
  end;

operator + (A, B: TV): TV;

implementation

operator + (A, B: TV): Integer;
begin
  Result := A.X + B.X;
end;

end.

