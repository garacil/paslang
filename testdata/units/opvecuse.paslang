{ P157: the operators two units export, a later unit's on a type
  hiding an earlier one's, and the program's own hiding a unit's. }
program opvecuse;

uses opvecu, opcolu;

{ the cross product: it hides opcolu's dot product from the program }
operator * (A, B: TVec): Integer;
begin
  Result := A.X * B.Y - A.Y * B.X;
end;

{ a - on TCol, which no unit gives }
operator - (A, B: TCol): TCol;
begin
  Result := Col(A.R - B.R, A.G - B.G, A.B - B.B);
end;

procedure Show(const A: TVec);
begin
  WriteLn(A.X, ' ', A.Y);
end;

procedure ShowCol(const A: TCol);
begin
  WriteLn(A.R, ' ', A.G, ' ', A.B);
end;

var
  A, B, C: TVec;
  P, Q: TCol;

begin
  A := Vec(1, 2);
  B := Vec(3, 4);
  Show(A + B);
  Show(B - A);
  Show(A * 3);
  Show(A + B * 2 - A);
  WriteLn(A = B, ' ', A = Vec(1, 2));
  Show(Half(Vec(9, -7)));
  { opcolu's < compares lengths, opvecu's Before the coordinates }
  C := Vec(4, 0);
  WriteLn(C < B, ' ', Before(C, B));
  WriteLn(B < C, ' ', Before(B, C));
  WriteLn(A * B, ' ', Dot(A, B));
  P := Col(200, 100, 10);
  Q := Col(100, 100, 100);
  ShowCol(P + Q);
  ShowCol(P - Q);
end.

