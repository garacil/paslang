unit aliaswrap;
{$mode objfpc}{$H+}
interface
uses aliasu;
type
  TWrapped = aliasu.TOther;
  TWrappedNumber = aliasu.TAlias;
procedure Fill(var B: TWrapped; var N: TWrappedNumber);
implementation
procedure Fill(var B: TWrapped; var N: TWrappedNumber);
begin B.Text := 'alias'; N := 59 end;
end.
