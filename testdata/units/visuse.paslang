program visuse;

{ Visibility across units (1.0.137): visu's TVisBase and visd's TVisKid
  as a program sees them, their public members, a descendant here whose
  methods use the protected and strict protected members two units up,
  an override in a public section, virtual calls, an interface and Free
  across units. }

uses visu, visd;

type
  TUseKid = class(TVisKid)
  public
    function Deep: Integer;
    procedure ProtShow; override;
    function Twice: Integer; virtual;
  end;

function TUseKid.Deep: Integer;
begin
  Result := FProt + FSP + SPValue + ProtTwice + ProtProp;
end;

procedure TUseKid.ProtShow;
begin
  inherited ProtShow;
  WriteLn('TUseKid.ProtShow ', Deep);
end;

function TUseKid.Twice: Integer;
begin
  Result := Secret * 2;
end;

var
  b: TVisBase;
  k: TVisKid;
  u: TUseKid;
  s: ISay;

begin
  b := TVisBase.Create(1);
  b.Tag := 5;
  WriteLn(b.Sum, ' ', b.Secret, ' ', b.Tag);
  WriteLn(PeekPriv(b));
  b.Report;
  s := b;
  WriteLn(s.Say);
  k := TVisKid.Create(10);
  WriteLn(k.Total);
  WriteLn(k.Other(b));
  b.Free;
  b := k;
  b.Report;
  s := k;
  WriteLn(s.Say);
  u := TUseKid.Create(20);
  u.ProtShow;
  WriteLn(u.Twice, ' ', u is TVisKid, ' ', b is TUseKid);
  b := MakeHiddenBase;
  WriteLn(PeekPriv(b));
  k.Free;
  b := u;
  b.Free;
end.
