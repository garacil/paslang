{ The first of two units a program uses (P158): hideb, used after it,
  hides three of its names with names of other kinds; the program hides
  more of them and reaches each through the unit's name, a type in
  every place a type goes. }
unit hidea;

{$mode objfpc}{$H+}{$interfaces corba}

interface

type
  TColor = (Red, Green, Blue);
  TBase = class
    function Name: string; virtual;
  end;
  IBase = interface
    function Twice(N: Integer): Integer;
  end;
  EHide = class(TObject)
  end;
  TRec = record
    A, B: Int64;
  end;

var
  Shared: Integer = 10;
  Mark: Integer = 1;

const
  Limit = 3;

function Mark2: Integer;

implementation

function TBase.Name: string;
begin
  Result := 'hidea base';
end;

function Mark2: Integer;
begin
  Result := 2;
end;

end.

