{ P619: overrides in another unit, which never sees the aliases. }
unit shapederived;

interface

uses
  shapebase;

type
  TShapeDerived = class(TShapeBase)
  public
    function Sum(const A: array of Integer): Integer; override;
    function Count(M: map[Integer] of string): Integer; override;
    function Fixed(const F: array[0..3] of Integer): Integer; override;
    function Pass(C: chan of Integer): Integer; override;
  end;

implementation

function TShapeDerived.Sum(const A: array of Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
end;

function TShapeDerived.Count(M: map[Integer] of string): Integer;
begin
  Result := Length(M);
end;

function TShapeDerived.Fixed(const F: array[0..3] of Integer): Integer;
begin
  Result := F[0] + F[1] + F[2] + F[3];
end;

function TShapeDerived.Pass(C: chan of Integer): Integer;
begin
  Result := Recv(C);
end;

end.
