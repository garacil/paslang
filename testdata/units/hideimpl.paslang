{ A unit's own names hide a unit its implementation uses (P158), and a
  program's hide the values of an enumeration of a unit: Red is the
  program's variable, and Str and Val still write and read the unit's
  values by their names. The output is Free Pascal's. }
program hideimpl;

{$mode objfpc}{$H+}

uses hidelo, hidehi;

type
  TColor = (Cyan, Magenta);

var
  Red: string;
  c: hidelo.TColor;
  k: TColor;
  s1, s2, s3: string;
  e: hidelo.TColor;
  code: Integer;

begin
  Red := 'mine';
  c := hidelo.Blue;
  k := Magenta;
  WriteLn(Describe);
  Str(c, s1);
  Str(hidelo.Red, s2);
  Str(k, s3);
  Val('Green', e, code);
  WriteLn(Red, ' ', s1, ' ', s2, ' ', s3, ' ', Ord(e), ' ', code, ' ', Counter, ' ', hidelo.Counter,
    ' ', Stamp, ' ', Today);
end.

