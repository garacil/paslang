{ A unit whose code differs by processor level (P143): Crc32c takes the
  SSE4.2 or the ARMv8.1 CRC kernel where the unit is compiled for them.
  The check builds it for the base processor and for the level, and a
  program links the build its -cpu allows. }
unit lvlu;

interface

function Check(const S: string): Int64;

implementation

function Check(const S: string): Int64;
begin
  Result := Crc32c(S);
end;

end.

