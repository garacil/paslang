{ Names of one spelling in two units (P138): the second unit, whose
  routine, constant, type and variable hide the first's; a second
  Twice of other parameters is an overload. }
unit shadb;
interface
type
  TBox = record
    B, C: Integer;
  end;
const
  Kind = 'b';
var
  Count: Integer;
function Twice(X: Integer): Integer;
function Twice(const S: string): string;
implementation
function Twice(X: Integer): Integer;
begin
  Result := X * 3;
end;
function Twice(const S: string): string;
begin
  Result := S + S;
end;
end.

