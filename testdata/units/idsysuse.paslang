{ P458: the types of sysutils through a chain of units that used it in
  their implementations alone: TSysError is the one type the program
  declares and the routines of sysutils take (this failed, "var
  parameter of type TSysError given a TSysError", with the third unit of
  the chain in the uses clause). }
program idsysuse;

uses
  sysutils, idsys2, idsys3;

var
  b: TBytes;
  f: TSysError;

begin
  SetLength(b, 8);
  if TryRandomBytes(b, 0, 8, f) then
    WriteLn('ok ', Dos + Tres)
  else
    WriteLn('failed ', f.Code);
end.
