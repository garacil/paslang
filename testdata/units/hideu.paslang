{ A unit whose type names a program hides with its own (P155). }
unit hideu;

{$mode objfpc}{$H+}

interface

type
  TPoint = record
    X, Y: Integer;
  end;
  TCount = Integer;
  TColor = (Red, Green);
  TShape = class
    function Name: string;
  end;

function Origin: TPoint;
function Three: TCount;
function MakeShape: TShape;
function Second: TColor;

implementation

function TShape.Name: string;
begin
  Result := 'unit shape';
end;

function Origin: TPoint;
begin
  Result.X := 1;
  Result.Y := 2;
end;

function Three: TCount;
begin
  Result := 3;
end;

function MakeShape: TShape;
begin
  Result := TShape.Create;
end;

function Second: TColor;
begin
  Result := Green;
end;

end.

