unit clsu;

{ Class members across a unit (P123), for clsuse: a class variable, a
  class property, class methods, a virtual class method, a virtual
  constructor, a class constructor and destructor. The class variables
  are this unit's globals, which the .pi names (CVAR, VAR); the class
  constructor runs before the initialization, the destructor after the
  finalization. }

interface

type
  TNode = class
  private
    class var FMade: Int64;
    class function GetMade: Int64; static;
  public
    Tag: string;
    constructor Create(const ATag: string); virtual;
    class function Kind: string; virtual;
    class function Label(const S: string): string;
    class property Made: Int64 read GetMade;
    class constructor Start;
    class destructor Stop;
  end;

  TLeaf = class(TNode)
    constructor Create(const ATag: string); override;
    class function Kind: string; override;
  end;

  TNodeClass = class of TNode;

var
  Registry: array[0..1] of TNodeClass;

function MakeAll(const T: string): string;

implementation

constructor TNode.Create(const ATag: string);
begin
  Tag := ATag;
  FMade := FMade + 1;
end;

class function TNode.Kind: string;
begin
  Result := 'node';
end;

class function TNode.Label(const S: string): string;
begin
  Result := Kind + ':' + S;
end;

class function TNode.GetMade: Int64;
begin
  Result := FMade;
end;

class constructor TNode.Start;
begin
  WriteLn('class constructor of TNode');
end;

class destructor TNode.Stop;
begin
  WriteLn('class destructor of TNode, ', FMade, ' made');
end;

constructor TLeaf.Create(const ATag: string);
begin
  inherited Create('leaf ' + ATag);
end;

class function TLeaf.Kind: string;
begin
  Result := 'leaf';
end;

function MakeAll(const T: string): string;
var
  i: Int64;
  n: TNode;
begin
  Result := '';
  for i := 0 to 1 do
  begin
    n := Registry[i].Create(T);
    Result := Result + n.ClassName + '(' + n.Tag + ') ';
  end;
end;

initialization
  WriteLn('initialization of clsu');
  Registry[0] := TNode;
  Registry[1] := TLeaf;

finalization
  WriteLn('finalization of clsu');

end.

