unit genericwrap;
{$mode objfpc}{$H+}
interface
uses genericu, generica, genericb;
type
  TImportedText = specialize TCell<string>;
  TImportedNumber = specialize TCell<generica.TItem>;
  TImportedNamed = specialize TCell<genericb.TItem>;
procedure Fill(var A: TImportedText; var B: TImportedNumber; var C: TImportedNamed);
implementation
procedure Fill(var A: TImportedText; var B: TImportedNumber; var C: TImportedNamed);
begin
  SetText(A, 'original');
  B.Item.Number := 43;
  C.Item.Text := 'named';
end;
end.
