{ Half and Twice of an Integer, not declared overload (P160). }
unit ovan;

{$mode objfpc}{$H+}

interface

function Half(X: Integer): string;
function Twice(X: Integer): string;

implementation

function Half(X: Integer): string;
begin
  Result := 'A.int';
end;

function Twice(X: Integer): string;
begin
  Result := 'A.twice';
end;

end.

