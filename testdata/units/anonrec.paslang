unit anonrec;

{ A unit whose interface has variables of records with no name
  (1.0.116); one holds a string, so the collector must see it. }

interface

var
  Pt: record X, Y: Int32; Name: string end;
  Grid: array[0..2] of record B: Byte; W: Word end;

procedure Place(AX, AY: Int32; const AName: string);

implementation

procedure Place(AX, AY: Int32; const AName: string);
var
  i: Integer;
begin
  Pt.X := AX;
  Pt.Y := AY;
  Pt.Name := AName + '!';
  for i := 0 to 2 do
  begin
    Grid[i].B := Byte(AX + i);
    Grid[i].W := Word(AY * (i + 1));
  end;
end;

end.

