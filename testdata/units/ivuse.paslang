program ivuse;

uses ivu;

begin
  WriteLn(Show);
  Opts.Sep := ',';
  Opts.Width := 4;
  Opts.Label1 := 'changed';
  WriteLn(Show, ' ', DefaultOpts.Sep, ' ', ivu.Opts.Width);
  WriteLn(Calls);
end.

