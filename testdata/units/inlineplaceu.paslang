unit InlinePlaceU;

interface

function UnitCell(I: Integer): Integer;
function UnitHalf(A, B: Integer): Integer;
function UnitWhole(X: Double): Integer;
function UnitLoad(P: ^Integer): Integer;
function UnitConstant(K: Integer): Integer;

implementation

var
  grid: array[0..3] of Integer;

function Cell(I: Integer): Integer;
begin
  Result := grid[I];
end;

function Half(A, B: Integer): Integer;
begin
  Result := A div B;
end;

function Whole(X: Double): Integer;
begin
  Result := Trunc(X);
end;

function Load(P: ^Integer): Integer;
begin
  Result := P^;
end;

function UnitCell(I: Integer): Integer;
begin
  Result := Cell(I) + 1;
end;

function UnitHalf(A, B: Integer): Integer;
begin
  Result := Half(A, B) + 1;
end;

function UnitWhole(X: Double): Integer;
begin
  Result := Whole(X) + 1;
end;

function UnitLoad(P: ^Integer): Integer;
begin
  Result := Load(P) + 1;
end;

function Letter(I: Integer): Integer;
begin
  Result := Ord(('abc')[I]);
end;

function UnitConstant(K: Integer): Integer;
begin
  case K of
    1: Result := Cell(6) + 1;
    2: Result := Half(7, 0) + 1;
    3: Result := Whole(1.0e30) + 1;
    4: Result := Load(nil) + 1;
    5: Result := Letter(4) + 1;
    6: Result := Cell(-1) + 1;
  end;
end;

end.

