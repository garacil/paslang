{ A unit that exports a map type: the compiled interface carries the
  key type and the value type. }
unit mapu;

interface

type
  TNames = map[Integer] of string;

function NewNames: TNames;
function Count(M: TNames): Integer;

implementation

function NewNames: TNames;
var
  m: TNames;
begin
  New(m);
  m[1] := 'one';
  m[2] := 'two';
  Result := m;
end;

function Count(M: TNames): Integer;
begin
  Result := Length(M);
end;

end.
