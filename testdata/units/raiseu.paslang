unit RaiseU;

{ P578, for raiseun: raises from a unit's code that the program does not
  take, each from a line of its own: a plain object, an exception of
  SysUtils with its message, a method, a nested routine, a raise again
  in a handler, a raise through a finally, a new object raised at the
  first one's address, and a fault of the runtime (P567), which has its
  line in its own text and must say it once. }

interface

uses
  sysutils;

type
  EBoom = class
  end;
  EOther = class
  end;
  TFuse = class
    procedure Blow;
  end;

procedure Boom(N: Integer);
procedure Many(N: Integer);
procedure Deep(N: Integer);
procedure Again(N: Integer);
procedure After(N: Integer);
procedure Renamed(N: Integer);
procedure Passes(N: Integer);
function Fault(const A: array of Integer; I: Integer): Integer;

implementation

procedure TFuse.Blow;
begin
  raise EBoom.Create;
end;

procedure Boom(N: Integer);
begin
  if N > 3 then
    raise EBoom.Create;
  WriteLn('not raised');
end;

procedure Many(N: Integer);
begin
  if N > 3 then
    raise Exception.Create('too many');
  WriteLn('not raised');
end;

procedure Deep(N: Integer);

  procedure Inner(K: Integer);
  begin
    if K > 3 then
      raise EBoom.Create;
  end;

begin
  Inner(N + 1);
  WriteLn('not raised');
end;

{ the handler raises what it took again: the place is Boom's }
procedure Again(N: Integer);
begin
  try
    Boom(N);
  except
    raise;
  end;
end;

procedure After(N: Integer);
begin
  try
    Boom(N);
  finally
    WriteLn('finally');
  end;
end;

{ another object, raised at the address of the first }
procedure Renamed(N: Integer);
begin
  try
    Boom(N);
  except
    raise EOther.Create at ExceptAddr;
  end;
end;

{ a handler for another class does not take it }
procedure Passes(N: Integer);
begin
  try
    Boom(N);
  except
    on e: EOther do
      WriteLn('taken');
  end;
end;

function Fault(const A: array of Integer; I: Integer): Integer;
begin
  try
    Result := A[I];
  finally
    WriteLn('finally');
  end;
end;

end.

