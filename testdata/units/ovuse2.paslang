{ A later unit's routine declared overload leaves the earlier unit's of
  its name visible (P160): Half(3) is ovan's, Half(2.5) ovbo's. The
  output is Free Pascal's. }
program ovuse2;

{$mode objfpc}{$H+}

uses ovan, ovbo;

begin
  WriteLn(Half(3), ' ', Half(2.5));
end.

