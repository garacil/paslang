{ P572: a failure inside a unit raised as an exception (a try stands on
  its way, P567) that no handler takes: SysUtils writes its line, the
  unit's, and the program ends with status 1 after the finally. }
program placeun;

uses
  sysutils, PlaceU;

var
  a: array of Integer;
begin
  SetLength(a, 3);
  WriteLn('before');
  try
    WriteLn(Pick(a, 11));
  finally
    WriteLn('finally');
  end;
  WriteLn('after');
end.

