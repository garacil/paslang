unit shapeheaduser;
interface
type
  THead = class
    constructor Create(const A: array of string);
    function Count(const A: array of string): Integer;
  end;
procedure Touch(const A: array of string);
function Size(const A: array of string): Integer;
implementation
uses shapealias;
constructor THead.Create(const A: array of string);
begin end;
function THead.Count(const A: array of string): Integer;
begin Result := Length(A) end;
procedure Touch(const A: array of string);
begin end;
function Size(const A: array of string): Integer;
begin Result := Length(A) end;
end.
