program currencyuse;
uses currencyu, currencywrap, sysutils;
var account: TImportedAccount; amount: TImportedAmount;
begin
  if (Upper <> High(Currency)) or (Initial <> -1.2346) then Halt(1);
  account := TAccount.Create;
  if account.Amount <> 1.2344 then Halt(2);
  account.Deposit;
  if account.Text <> '1.2345' then Halt(3);
  amount := DefaultPrice;
  if Choose(amount) <> 'decimal 2.675' then Halt(4);
  if Choose(2.675) <> 'binary 2.675' then Halt(5);
  account.Amount := amount;
  if account.Amount.ToScaled <> 26750 then Halt(6);
  WriteLn('Currency aliases, exact constants/defaults, methods and overloads across units');
end.
