unit quadcu;

{ A unit that exports a real constant with its binary128 value and a
  procedure with a Quad default (1.0.115): the .pi carries both. }

interface

const
  Seventh = 1 / 7;

procedure Put(x: Quad = 2 / 3);

implementation

procedure Put(x: Quad = 2 / 3);
begin
  WriteLn(x:0:36);
end;

end.

