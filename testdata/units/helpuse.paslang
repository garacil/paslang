{ The helpers of unit helpu used from a program (P127). }
program helpuse;

uses helpu;

type
  TMoreTools = type helper(TStrTools) for string
    function Shout: string;
  end;

function TMoreTools.Shout: string;
begin
  Result := Boxed + '!';
end;

var
  s: string;
  z: TSize;

begin
  s := 'one two  three';
  WriteLn(s.Boxed, ' ', s.Words, ' ', s.Width, ' ', s.Shout);
  WriteLn(string.Repeated('ab', 3), ' ', 'xy'.Boxed);
  z.W := 2;
  z.H := 3;
  z.Grow;
  WriteLn(z.Area);
  z.Grow(2);
  WriteLn(z.W, ' ', z.H, ' ', z.Area);
end.

