unit CallU;

{ P579, for callun: the unit between the program and CallV. Each
  routine calls into CallV its own way: straight, through CallV's
  finally, through a method, through a procedure variable and from a
  nested routine. Every call of the chain crosses a unit or goes to a
  routine the compiler leaves a call, so the frames are the same with
  and without inlining. }

interface

uses
  CallV;

procedure Middle(N: Integer);
procedure ViaGuard(N: Integer);
procedure ViaMethod(N: Integer);
procedure ViaVar(N: Integer);
procedure Nested(N: Integer);
procedure ManyDown(N: Integer);

implementation

type
  TStep = procedure(N: Integer);

procedure Middle(N: Integer);
begin
  Lowest(N);
  WriteLn('not raised');
end;

procedure ViaGuard(N: Integer);
begin
  Guarded(N);
  WriteLn('not raised');
end;

procedure ViaMethod(N: Integer);
var
  d: TDoor;
begin
  d := TDoor.Create;
  d.Open(N);
  WriteLn('not raised');
end;

procedure ViaVar(N: Integer);
var
  step: TStep;
begin
  step := @Lowest;
  step(N);
  WriteLn('not raised');
end;

procedure Nested(N: Integer);

  procedure Inner(K: Integer);
  begin
    Lowest(K + N);
    WriteLn('not raised');
  end;

begin
  Inner(1);
  WriteLn('not raised');
end;

procedure ManyDown(N: Integer);
begin
  Down(N);
  WriteLn('not raised');
end;

end.

