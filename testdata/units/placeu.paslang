unit PlaceU;

{ P572, for placeuse and placeun: the failures of a unit's code, each
  with its own line: a routine, a method, a nested routine, a loop (its
  head aligned, the line label before the padding), a routine put in
  line in another (Fill's two statements in CallFill, a call again
  with -inline 0: the line is Fill's either way), a real out of
  Integer's range and a call into a second unit. }

interface

uses
  PlaceV;

type
  TBox = class
    Items: array of Integer;
    constructor Create(N: Integer);
    function At(I: Integer): Integer;
  end;

function Pick(const A: array of Integer; I: Integer): Integer;
function Half(A, B: Integer): Integer;
function Through(const A: array of Integer; I: Integer): Integer;
function Outer(const A: array of Integer; I: Integer): Integer;
function SumTo(const A: array of Integer; N: Integer): Integer;
function CallFill(I: Integer): Integer;
function Whole(X: Double): Integer;

implementation

constructor TBox.Create(N: Integer);
begin
  SetLength(Items, N);
end;

function TBox.At(I: Integer): Integer;
begin
  Result := Items[I];
end;

function Pick(const A: array of Integer; I: Integer): Integer;
begin
  Result := 0;
  if I > -100 then
    Result := A[I];
end;

function Half(A, B: Integer): Integer;
begin
  Result := A div B;
end;

function Through(const A: array of Integer; I: Integer): Integer;
begin
  Result := Deep(A, I) * 2;
end;

function Outer(const A: array of Integer; I: Integer): Integer;

  function Inner(K: Integer): Integer;
  begin
    Result := A[K] + I;
  end;

begin
  Result := Inner(I + 1);
end;

function SumTo(const A: array of Integer; N: Integer): Integer;
var
  k: Integer;
begin
  Result := 0;
  for k := 0 to N - 1 do
    Result := Result +
      A[k];
end;

var
  grid: array[0..3] of Integer;
  filled: Integer;

procedure Fill(I, V: Integer);
begin
  grid[I] := V;
  filled := filled + 1;
end;

function CallFill(I: Integer): Integer;
begin
  Fill(I, 7);
  Result := filled;
end;

function Whole(X: Double): Integer;
begin
  Result := Trunc(X);
end;

end.

