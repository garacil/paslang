unit initinla;
{$mode objfpc}{$H+}
interface
implementation
function Twice(N: Int64): Int64;
begin Result := N * 2 end;
initialization
  WriteLn('a-init ', Twice(3));
finalization
  WriteLn('a-fini ', Twice(11));
end.
