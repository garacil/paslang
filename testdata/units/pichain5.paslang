{ P460: unit 5 of the chain; its interface uses unit 4. }
unit pichain5;

interface

uses
  pichain4;

type
  TP5 = record
    Inner: TP4;
    B: Integer;
    function Sum: Integer;
  end;

  TC5 = class(TC4)
    function Get: Integer; override;
  end;

function Step5(X: Integer): Integer;

implementation

function TP5.Sum: Integer;
begin
  Result := Inner.Sum + B;
end;

function TC5.Get: Integer;
begin
  Result := inherited Get + 5;
end;

function Step5(X: Integer): Integer;
begin
  Result := Step4(X) + 1;
end;

end.
