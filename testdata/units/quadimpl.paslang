unit quadimpl;

{ A unit that names pasquad's routines in its implementation (1.0.114):
  every compilation links pasquad without its names, and a uses clause
  must still bring them (the second one read them no more). }

interface

function Quarter(D: Double): Double;

implementation

uses
  pasquad;

function Quarter(D: Double): Double;
var
  bits, lo, hi, rlo, rhi: Int64;
  r: Double;
begin
  bits := 0;
  Move(D, bits, 8);
  PasQFromDouble(bits, lo, hi);
  PasQMul(lo, hi, 0, 4610841593497255936, rlo, rhi);
  bits := PasQToDouble(rlo, rhi);
  r := 0;
  Move(bits, r, 8);
  Result := r;
end;

end.

