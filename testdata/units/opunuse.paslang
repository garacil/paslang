{ P381: a used unit's operators of one operand, its xor and its :=. }
program opunuse;

uses opunu;

var
  c: TCount;
  p: TPt;

begin
  c.N := 41;
  Inc(c);
  p := 5;
  WriteLn(Trunc(c), ' ', (-p).X, ' ', not p, ' ', (p xor TPt(3)).X);
end.

