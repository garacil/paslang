{ A later unit's name hides an earlier unit's of another kind, and a
  program's own names hide both units' (P158), as in Free Pascal: the
  program's variables Red and Blue hide hidea's values; hideb's Shared,
  Mark and Limit hide hidea's. A unit's name reaches every hidden name,
  and a type of a unit wherever a type goes: a class's parent, the
  interfaces it implements, class of, a pointer, SizeOf, High and Low,
  on E: T and on T. A parameter hides a unit's routine and a local
  variable a unit's type. The output is Free Pascal's. }
program hideab;

{$mode objfpc}{$H+}{$interfaces corba}

uses hidea, hideb;

type
  TKid = class(hidea.TBase)
    function Name: string; override;
  end;
  TKidClass = class of hidea.TBase;
  TImpl = class(TObject, hidea.IBase)
    function Twice(N: Integer): Integer;
  end;
  PR = ^hidea.TRec;

var
  Red: Integer;
  Blue: string;
  c: hidea.TColor;
  k: TKidClass;
  r: hidea.TRec;
  p: PR;
  i: hidea.IBase;

function TKid.Name: string;
begin
  Result := 'kid of ' + inherited Name;
end;

function TImpl.Twice(N: Integer): Integer;
begin
  Result := 2 * N;
end;

procedure Show(Mark2: Integer);
var
  TRec: Integer;
begin
  TRec := 5;
  WriteLn(Mark2, ' ', hidea.Mark2, ' ', TRec, ' ', SizeOf(hidea.TRec));
end;

begin
  Red := 7;
  Blue := 'blue';
  c := hidea.Red;
  WriteLn(Red, ' ', Blue, ' ', Ord(c), ' ', Ord(hidea.Blue), ' ', Ord(High(hidea.TColor)), ' ',
    Ord(Low(hidea.TColor)));
  WriteLn(Shared, ' ', hidea.Shared, ' ', Mark, ' ', hidea.Mark, ' ', Limit, ' ', hidea.Limit);
  k := TKid;
  WriteLn(k.ClassName, ' ', TKid.Create.Name, ' ', SizeOf(hidea.TRec), ' ', SizeOf(PR));
  r.A := 3;
  p := @r;
  WriteLn(p^.A);
  i := TImpl.Create;
  WriteLn(i.Twice(21));
  Show(9);
  try
    raise hidea.EHide.Create;
  except
    on E: hidea.EHide do
      WriteLn('caught ', E.ClassName);
  end;
  try
    raise hidea.EHide.Create;
  except
    on hidea.EHide do
      WriteLn('caught again');
  end;
end.

