{ P209: a program reading a unit's json constants. }
program jsonconstuse;

uses
  jsonconstu;

const
  Mine: json = '{"retries":5}';

begin
  WriteLn(JsonEncode(Defaults), ' ', Defaults['retries'].AsInteger, ' ', Defaults['hosts'][1].AsString);
  WriteLn(JsonEncode(Limits), ' ', (Limits as Pointer) = (Limits as Pointer));
  WriteLn(JsonEncode(JsonMergePatch(Defaults, Mine)));
end.

