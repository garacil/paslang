{ P153: blobu's routines whose result is a block, from a program: each
  gives the buffer it is called with, so the maker of TVec.Create, which
  this program's routines do not list, writes where the call says. }
program blobuse;

uses blobu;

var
  a, b, c: TVec;
  bx: TBox;

begin
  a := TVec.Create(1, 2, 'a');
  b := MkVec(3, 4);
  c := AddVec(a, b);
  WriteLn(c.X, ' ', c.Y, ' ', c.Name);
  c := c.Scaled(2);
  WriteLn(c.X, ' ', c.Y, ' ', c.Name);
  bx := TBigBox.Create;
  bx.V := a;
  c := bx.Get;
  WriteLn(c.X, ' ', c.Y, ' ', c.Name, ' ', TVec.Create(7, 8, 'n').Y, ' ', MkVec(5, 6).X);
end.

