unit shapeextraaliasa;
interface
uses shapeextraorigin;
type
  TExtraDyn = array of Integer;
  TExtraFixed = array[0..3] of Integer;
  TExtraMap = map[Integer] of string;
  TExtraChan = chan of Integer;
  TExtraPtr = ^Integer;
  TExtraMethod = function(X: Integer): Integer of object;
  TExtraRange = 0..7;
  TExtraSet = set of 0..7;
  TExtraProc = function(X: Integer): Integer;
  TExtraTree = tree[Integer] of Integer;
  TExtraTreeSet = tree of Integer;
  TExtraHeap = heap of Integer;
  TExtraClass = class of TExtraAnchor;
implementation
end.
