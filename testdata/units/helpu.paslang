{ Helpers across a unit (P127): a type helper for string with a static
  method, a property and a private method, a record helper, and a helper
  that descends from another; the program uses them, adds its own, and
  the last one for a type is the one in scope. }
unit helpu;

interface

type
  TStrTools = type helper for string
  private
    function Pad(N: Integer): string;
  public
    function Boxed: string;
    function Words: Integer;
    class function Repeated(const S: string; N: Integer): string; static;
    function GetWidth: Integer;
    property Width: Integer read GetWidth;
  end;

  TSize = record
    W, H: Integer;
  end;

  TSizeTools = record helper for TSize
    function Area: Integer;
    procedure Grow(By: Integer = 1);
  end;

implementation

function TStrTools.Pad(N: Integer): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to N do
    Result := Result + ' ';
end;

function TStrTools.Boxed: string;
begin
  Result := '[' + Pad(1) + Self + Pad(1) + ']';
end;

function TStrTools.Words: Integer;
var
  i: Integer;
  inw: Boolean;
begin
  Result := 0;
  inw := False;
  for i := 1 to Length(Self) do
    if Self[i] = ' ' then
      inw := False
    else if not inw then
    begin
      inw := True;
      Result := Result + 1;
    end;
end;

class function TStrTools.Repeated(const S: string; N: Integer): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to N do
    Result := Result + S;
end;

function TStrTools.GetWidth: Integer;
begin
  Result := Length(Self);
end;

function TSizeTools.Area: Integer;
begin
  Result := W * H;
end;

procedure TSizeTools.Grow(By: Integer);
begin
  W := W + By;
  H := H + By;
end;

end.

