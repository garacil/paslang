{ P381: a unit's operators of one operand, top level and a record's,
  its logic and its conversion, which its .pi exports (UNOP, OPER and
  CONV lines). }
unit opunu;

interface

type
  TCount = record
    N: Integer;
    class operator Inc(a: TCount): TCount;
    class operator Trunc(a: TCount): Integer;
  end;

  TPt = record
    X: Integer;
  end;

operator - (A: TPt): TPt;
operator not (A: TPt): Boolean;
operator xor (A, B: TPt): TPt;
operator := (N: Integer): TPt;

implementation

class operator TCount.Inc(a: TCount): TCount;
begin
  Result.N := a.N + 1;
end;

class operator TCount.Trunc(a: TCount): Integer;
begin
  Result := a.N;
end;

operator - (A: TPt): TPt;
begin
  Result.X := -A.X;
end;

operator not (A: TPt): Boolean;
begin
  Result := A.X = 0;
end;

operator xor (A, B: TPt): TPt;
begin
  Result.X := A.X xor B.X;
end;

operator := (N: Integer): TPt;
begin
  Result.X := N;
end;

end.

