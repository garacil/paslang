{ P171: a unit's record with class operators, which its .pi exports:
  Add and Equal as OPER lines, Implicit and Explicit as CONV lines. }
unit recopsu;

interface

type
  TVec2 = record
    X, Y: Integer;
    class operator Add(a, b: TVec2): TVec2;
    class operator Equal(a, b: TVec2): Boolean;
    class operator Implicit(n: Integer): TVec2;
    class operator Explicit(v: TVec2): Integer;
  end;

function Vec2(X, Y: Integer): TVec2;

implementation

function Vec2(X, Y: Integer): TVec2;
begin
  Result.X := X;
  Result.Y := Y;
end;

class operator TVec2.Add(a, b: TVec2): TVec2;
begin
  Result := Vec2(a.X + b.X, a.Y + b.Y);
end;

class operator TVec2.Equal(a, b: TVec2): Boolean;
begin
  Result := (a.X = b.X) and (a.Y = b.Y);
end;

class operator TVec2.Implicit(n: Integer): TVec2;
begin
  Result := Vec2(n, n);
end;

class operator TVec2.Explicit(v: TVec2): Integer;
begin
  Result := v.X + v.Y;
end;

end.

