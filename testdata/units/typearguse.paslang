program typearguse;
uses typeargtypes;
const TShadow = Char('S');
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('qualified type argument ', Stage, ': ', Actual, ' <> ', Expected); Halt(107); end;
end;
procedure Local(TScalar: Byte);
const TConstShadow = Char('C');
begin
  Equal(1, SizeOf(TScalar), 1);
  Equal(2, SizeOf(typeargtypes.TScalar), 2);
  Equal(3, SizeOf(TConstShadow), 1);
  Equal(4, SizeOf(typeargtypes.TConstShadow), 2);
  Equal(5, High(TScalar), 255);
  Equal(6, High(typeargtypes.TScalar), 65535);
end;
begin
  Equal(7, SizeOf(typeargtypes.TScalar), 2);
  Equal(8, SizeOf(typeargtypes.TOuter.TSmall), 1);
  Equal(9, SizeOf(typeargtypes.TScalar(7)), 2);
  Equal(10, SizeOf(typeargtypes.TOuter.TSmall(7)), 1);
  Equal(11, High(typeargtypes.TScalar(7)), 65535);
  Equal(12, Low(typeargtypes.TOuter.TSmall(7)), 0);
  Equal(13, SizeOf(typeargtypes.TOuter.Mark), 8);
  Equal(14, SizeOf(TShadow), 1);
  Equal(15, SizeOf(typeargtypes.TShadow), 2);
  Local(7);
  WriteLn('ok qualified type argument ownership');
end.
