      k29v11 := ((k29v1 and k29v10) or k29v10);
      k29v10 := (k29v12 + k29v6);
      k29cw := k29cw - 1;
    end;
    k29v3 := 0;
    for k29cj := 1 to k29dv do
      k29v3 := k29v3 + k29cj;
    k29v5 := Mix(k29v5, k29v3, 1);
    k29v6 := (k29v12 shr 20);
    k29v7 := 0;
    for k29cj := 1 to k29dv do
      k29v7 := k29v7 + k29cj;
    k29v10 := Mix(k29v1, k29v0, 1);
    k29v2 := ((k29v7 mod 10) rol 36);
    k29v11 := 0;
    for k29cj := 1 to k29dv do
      k29v11 := k29v11 + k29cj;
    k29v9 := (17 shl 23);
    k29v2 := (k29v1 div 7);
    k29v2 := (k29v2 xor k29v0);
    k29cw := 1;
    while k29cw > 0 do
    begin
      k29v5 := ((k29v6 or 6364136223846793005) xor k29v7);
      k29v9 := (k29v12 shl 27);
      k29cw := k29cw - 1;
    end;
    k29cw := 2;
    while k29cw > 0 do
    begin
      if ((k29v8 and 255) <> 1) then
      begin
        k29v4 := ((3 * k29v2) shr 13);
        k29v8 := (k29v7 xor k29v12);
      end
      else
      begin
        if ((k29v7 rol 53) > k29v5) then
        begin
          k29v6 := ((4097 rol 26) or k29v12);
          k29v8 := ((k29v4 + 4097) + k29v7);
        end;
      end;
      k29cw := k29cw - 1;
    end;
    k29v0 := (k29v0 + k29v7);
  end;
  Result := 0;
  Result := Result * 31 + k29v0 + 0;
  Result := Result * 31 + k29v1 + 1;
  Result := Result * 31 + k29v2 + 2;
  Result := Result * 31 + k29v3 + 3;
  Result := Result * 31 + k29v4 + 4;
  Result := Result * 31 + k29v5 + 5;
  Result := Result * 31 + k29v6 + 6;
  Result := Result * 31 + k29v7 + 7;
  Result := Result * 31 + k29v8 + 8;
  Result := Result * 31 + k29v9 + 9;
  Result := Result * 31 + k29v10 + 10;
  Result := Result * 31 + k29v11 + 11;
  Result := Result * 31 + k29v12 + 12;
end;

{ the eight variables of scripts/bench/b10rot, xoshiro256**: the
  Makefile reads this routine's assembly, where mixt takes the register the
  pool does not need }
function Mixer(x, y: Int64): Int64;
var
  mixs0, mixs1, mixs2, mixs3, mixt, mixr, mixsum, mixi: Int64;
begin
  mixs0 := x;
  mixs1 := y or 1;
  mixs2 := x xor 3;
  mixs3 := y + 4;
  mixsum := 0;
  for mixi := 1 to 1000 do
  begin
    mixr := ((mixs1 * 5) rol 7) * 9;
    mixt := mixs1 shl 17;
    mixs2 := mixs2 xor mixs0;
    mixs3 := mixs3 xor mixs1;
    mixs1 := mixs1 xor mixs2;
    mixs0 := mixs0 xor mixs3;
    mixs2 := mixs2 xor mixt;
    mixs3 := mixs3 rol 45;
    mixsum := mixsum + mixr;
  end;
  Result := mixsum xor mixs0;
end;

{ ten variables in a loop whose every right side is an operation: two
  registers of the pool, so rdi stays the pool's }
function DeepLoop(x, y: Int64): Int64;
var
  a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, i: Int64;
begin
  a0 := x;
  a1 := y;
  a2 := x xor 5;
  a3 := y + 3;
  a4 := x + y;
  a5 := x - y;
  a6 := a0 xor a1;
  a7 := a2 + a3;
  a8 := a4 xor a5;
  a9 := 1;
  for i := 1 to 100 do
  begin
    a0 := a1 - (a2 - a3);
    a1 := a2 xor (a3 + a4);
    a2 := a3 + (a4 xor a5);
    a3 := a4 - (a5 + a6);
    a4 := a5 xor (a6 - a7);
    a5 := a6 + (a7 - a8);
    a6 := a7 xor (a8 + a9);
    a7 := a8 - (a9 xor a0);
    a8 := a9 + (a0 - a1);
    a9 := a0 xor (a1 + a2);
  end;
  Result := a0 xor a1 xor a2 xor a3 xor a4 xor a5 xor a6 xor a7 xor a8 xor a9;
end;

{ ten variables in a loop with ifs of single assignments, which are
  conditional moves: they work their values out in the pool's second
  register, so the loop keeps it and the moves }
function SelLoop(x, y: Int64): Int64;
var
  a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, i: Int64;
begin
  a0 := x;
  a1 := y;
  a2 := x xor 5;
  a3 := y + 3;
  a4 := x + y;
  a5 := x - y;
  a6 := a0 xor a1;
  a7 := a2 + a3;
  a8 := a4 xor a5;
  a9 := 1;
  for i := 1 to 100 do
  begin
    if a1 > a2 then
      a3 := a1;
    if a4 < a5 then
      a6 := a4
    else
      a6 := a5 + a7;
    a0 := a0 + a3;
    a1 := a1 xor a6;
    a2 := a2 + a0;
    a4 := a4 xor a2;
    a5 := a5 + a1;
    a7 := a7 xor a3;
    a8 := a8 + a6;
    a9 := a9 xor a8;
  end;
  Result := a0 xor a1 xor a2 xor a3 xor a4 xor a5 xor a6 xor a7 xor a8 xor a9;
end;

{ an expression two registers deep in a routine with no frame, after the
  kernels: it keeps the pool's second register }
function DeepLeaf(a, b, c: Int64): Int64;
begin
  Result := (a - (b - c)) xor (c - (a - b));
end;

