  v5 := (v5 + 36);
  v6 := ((x * 15) xor y);
  v6 := (v6 + 43);
  v7 := ((x * 17) xor y);
  v7 := (v7 + 50);
  v8 := ((x * 19) xor y);
  v8 := (v8 + 57);
  dv := 5;
  for ci := 1 to 4 do
  begin
    if ((v5 and 1) <> 1) then
    begin
      v5 := ((65521 * 4097) shr 22);
      v5 := (7 shr 31);
    end
    else
    begin
      v6 := ((255 shr 27) + v1);
    end;
    v5 := (v4 shr 4);
    v8 := 0;
    for cj := 1 to dv do
      v8 := v8 + cj;
    v5 := (7 shr 11);
    v8 := 0;
    for cj := 1 to dv do
      v8 := v8 + cj;
    for cj := 1 to 4 do
    begin
      if ((v0 and 1) <> 1) then
      begin
        v8 := (v7 shl 19);
      end;
    end;
    cw := 1;
    while cw > 0 do
    begin
      v2 := (v0 or 4097);
      cw := cw - 1;
    end;
    v6 := (v2 shr 11);
    v4 := ((v5 shr 25) shr 9);
    v1 := (v1 div 7);
    v1 := (v1 xor v0);
    v5 := ((9 + 2147483647) * v7);
  end;
  Result := 0;
  Result := Result * 31 + v0 + 0;
  Result := Result * 31 + v1 + 1;
  Result := Result * 31 + v2 + 2;
  Result := Result * 31 + v3 + 3;
  Result := Result * 31 + v4 + 4;
  Result := Result * 31 + v5 + 5;
