{ P214 (1.1.99): SetLength that shortens a string no other string
  shares, or keeps its length, keeps its block: only the length
  changes, nothing is copied. A string another variable holds, a
  literal and a view of a block nothing writes (PasStrView) still get a
  block of their own, so a write through the shortened string never
  reaches the others and the viewed block's sum stays the same. Nothing
  past the new length shows again: a grow takes a new block whose new
  characters are zero, and a join reads only the length. Each line says
  whether a case held; main runs them, then 16 routines at once, with
  the collector running between the steps. }
program strshrink;

const
  Routines = 16;

type
  TStrWords = record
    P: Pointer;
    N: Integer;
  end;
  PStrWords = ^TStrWords;
  TRec = record
    Name: string;
    Tag: Integer;
  end;

var
  wg: waitgroup;
  failed: Integer;

function Words(var S: string): Pointer;
begin
  Result := PStrWords(@S)^.P;
end;

{ Letters K, K+1, ... L of them, in a block of their own }
function Fresh(K, L: Integer): string;
var
  j: Integer;
begin
  Result := '';
  for j := 0 to L - 1 do
    Result := Result + Chr(Ord('a') + (K + j) mod 26);
end;

{ The same letters into S, in a block SetLength gives it: a string no
  other variable holds, as a read buffer is }
procedure Fill(var S: string; K, L: Integer);
var
  j: Integer;
begin
  SetLength(S, L);
  for j := 1 to L do
    S[j] := Chr(Ord('a') + (K + j - 1) mod 26);
end;

function Sum(P: PByte; N: Integer): Integer;
var
  j: Integer;
begin
  Result := 0;
  for j := 0 to N - 1 do
    Result := Result * 31 + P[j];
end;

{ Garbage, so the collector runs and reuses what nothing holds. }
procedure Churn;
var
  j: Integer;
  s: string;
begin
  for j := 1 to 300 do
    s := Fresh(j, 40) + Fresh(j + 1, 40);
end;

procedure Cut(var S: string; N: Integer);
begin
  SetLength(S, N);
end;

function Check(const What: string; Ok, Show: Boolean): Integer;
begin
  if Show then
    WriteLn('  ', What, ': ', Ok);
  if Ok then
    Result := 0
  else
    Result := 1;
end;

function Cases(Show: Boolean): Integer;
var
  s, t, u, v, w, lit: string;
  p, q: Pointer;
  blk: PByte;
  sum0: Integer;
  arr: array of string;
  rec: TRec;
begin
  Result := 0;

  Fill(s, 0, 300);
  p := Words(s);
  SetLength(s, 5);
  Churn;
  Result := Result + Check('an owned string shortened keeps its block',
    (Words(s) = p) and (s = 'abcde') and (Length(s) = 5), Show);
  SetLength(s, 5);
  Result := Result + Check('the same length keeps it too', Words(s) = p, Show);
  s[1] := 'Z';
  Result := Result + Check('a write after it needs no copy', (Words(s) = p) and (s = 'Zbcde'), Show);
  t := s + '!';
  Result := Result + Check('a join reads only the length', t = 'Zbcde!', Show);
  SetLength(s, 9);
  Churn;
  Result := Result + Check('a grow takes a new block and its new characters are zero',
    (Words(s) <> p) and (Copy(s, 1, 5) = 'Zbcde') and (s[6] = #0) and (s[9] = #0) and (Length(s) = 9), Show);

  Fill(s, 1, 50);
  t := s;
  p := Words(t);
  SetLength(s, 3);
  s[1] := 'Q';
  Churn;
  Result := Result + Check('a shared string shortened gets a block of its own',
    (Words(s) <> p) and (s = 'Qcd') and (t = Fresh(1, 50)) and (Words(t) = p), Show);
  SetLength(t, 2);
  t[2] := 'R';
  Result := Result + Check('so does the other holder',
    (Words(t) <> p) and (t = 'bR') and (s = 'Qcd'), Show);

  lit := 'a literal of some length';
  p := Words(lit);
  u := lit;
  SetLength(u, 4);
  u[1] := 'X';
  Result := Result + Check('a literal shortened is copied',
    (Words(u) <> p) and (u = 'X li') and (lit = 'a literal of some length'), Show);

  blk := PByte(GetMem(65, 0));
  blk[0] := 1;
  for sum0 := 1 to 64 do
    blk[sum0] := Byte(Ord('a') + sum0 mod 26);
  sum0 := Sum(blk, 65);
  v := PasStrView(blk + 1, 64);
  q := Words(v);
  SetLength(v, 10);
  v[1] := 'V';
  Churn;
  Result := Result + Check('a view shortened is copied and its block never written',
    (Words(v) <> q) and (Length(v) = 10) and (v[1] = 'V') and (v[2] = Chr(Ord('a') + 2)) and
    (Sum(blk, 65) = sum0), Show);

  SetLength(arr, 3);
  Fill(arr[1], 2, 100);
  p := Words(arr[1]);
  SetLength(arr[1], 7);
  Fill(rec.Name, 3, 100);
  q := Words(rec.Name);
  Cut(rec.Name, 6);
  Churn;
  Result := Result + Check('an element, a field and a var parameter keep their blocks',
    (Words(arr[1]) = p) and (arr[1] = Fresh(2, 7)) and (Words(rec.Name) = q) and
    (rec.Name = Fresh(3, 6)), Show);

  u := Fresh(5, 10) + Fresh(6, 10);
  p := Words(u);
  SetLength(u, 12);
  w := Copy(lit, 1, 20);
  q := Words(w);
  SetLength(w, 9);
  Churn;
  Result := Result + Check('a join and a Copy are their own and keep theirs too',
    (Words(u) = p) and (u = Fresh(5, 10) + Fresh(6, 2)) and (Words(w) = q) and (w = 'a literal'), Show);

  s := Fresh(4, 20);
  SetLength(s, 0);
  Result := Result + Check('shortened to nothing it is the empty string', (s = '') and (Length(s) = 0), Show);
end;

procedure Routine;
begin
  AtomicAdd(@failed, Cases(False));
  wg.Done;
end;

var
  k: Integer;

begin
  WriteLn('in main');
  failed := Cases(True);
  wg.Add(Routines);
  for k := 1 to Routines do
    pas Routine;
  wg.Wait;
  WriteLn(Routines, ' routines at once, every case held: ', failed = 0);
end.

