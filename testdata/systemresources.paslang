program systemresources;
uses sysutils, paslinux;
const Workers = 64; Each = 8;
var root: string; names, directories: array of string;
  joined: waitgroup; i, j, answer: Integer; unique: map[string] of Boolean;
  info: TFileInfo; error: TSysError; bytes: TBytes; environment: TEnvironment;
  path, value: string; handle: THandle;

procedure CreateResources(Index: Integer);
var k, transferred, position: Integer; localError: TSysError;
  data, received: TBytes; fd, base: THandle; localInfo: TFileInfo;
begin
  SetLastOSError(Index + 500);
  if not TryOpenFileAt(CurrentDirectoryHandle, root, ODirectory, 0, base, localError) then Halt(20);
  for k := 0 to Each - 1 do
  begin
    position := Index * Each + k;
    if not TryCreateTempFileAt(base, '.', 'pre*mid*.bin', names[position], fd, localError) then Halt(21);
    if Pos('./pre*mid', names[position]) <> 1 then Halt(22);
    if Length(names[position]) <> Length('./pre*mid') + 32 + Length('.bin') then Halt(23);
    if not TryHandleInfo(fd, localInfo, localError) then Halt(24);
    if (localInfo.Mode and 511) <> 384 then Halt(25);
    if Amd64 then transferred := Syscall(72, fd, 1) else transferred := Syscall(25, fd, 1);
    if transferred <> 1 then Halt(26);
    data := RandomBytes(513);
    if not TryFileWrite(fd, data, 0, 513, transferred, localError) or (transferred <> 513) then Halt(27);
    SetLength(received, 513);
    if not TryFileReadAt(fd, received, 0, 513, 0, transferred, localError) then Halt(28);
    if (transferred <> 513) or (StringOf(data) <> StringOf(received)) then Halt(29);
    if not TryFileClose(fd, localError) then Halt(30);
    if not TryCreateTempDirectoryAt(base, '.', 'dir-*', directories[position], localError) then Halt(31);
    if not TryFileInfoAt(base, directories[position], True, localInfo, localError) then Halt(32);
    if not localInfo.IsDirectory or ((localInfo.Mode and 511) <> 448) then Halt(33);
    if GetLastOSError <> Index + 500 then Halt(34);
    if TOSVersion.Name <> 'Linux' then Halt(35);
    if not TOSVersion.Check(TOSVersion.Major, TOSVersion.Minor, TOSVersion.Build) then Halt(36);
  end;
  if not TryFileClose(base, localError) then Halt(37);
  joined.Done;
end;

begin
  root := ParamStr(1);
  { This test owns its process umask; no user/global process is changed. }
  if Amd64 then answer := Syscall(95, 0) else answer := Syscall(166, 0);
  bytes := BytesOf('keep');
  if TryRandomBytes(bytes, 3, 2, error) or (error.Code <> 22) then Halt(2);
  if StringOf(bytes) <> 'keep' then Halt(3);
  if not TryRandomBytes(bytes, 4, 0, error) then Halt(4);
  try bytes := RandomBytes(-1); Halt(5) except on EArgumentException do ; end;
  if TryCreateTempFileAt(CurrentDirectoryHandle, root, '../escape', path, handle, error) then Halt(6);
  if (error.Code <> 22) or (handle <> -1) or (path <> '') then Halt(7);
  if TryCreateTempDirectoryAt(CurrentDirectoryHandle, root, 'bad'#0, path, error) then Halt(8);
  if error.Code <> 22 then Halt(9);
  if TryCreateTempFileAt(CurrentDirectoryHandle, root + '/absent', '*', path, handle, error) then Halt(10);
  if error.Code <> 2 then Halt(11);
  environment := TEnvironment.Create(['HOME=/home/test/./user/', 'XDG_CONFIG_HOME=relative',
    'XDG_CACHE_HOME=/cache/../cache', 'XDG_DATA_HOME=', 'XDG_STATE_HOME=/state']);
  if not TryGetUserDirectory(environment, value, error) or (value <> '/home/test/user') then Halt(12);
  if not TryGetUserConfigDirectory(environment, value, error) or (value <> '/home/test/user/.config') then Halt(13);
  if not TryGetUserCacheDirectory(environment, value, error) or (value <> '/cache') then Halt(14);
  if not TryGetUserDataDirectory(environment, value, error) or (value <> '/home/test/user/.local/share') then Halt(15);
  if not TryGetUserStateDirectory(environment, value, error) or (value <> '/state') then Halt(16);
  if GetApplicationConfigDirectory(environment, 'my app') <> '/home/test/user/.config/my app/' then Halt(17);
  if GetApplicationConfigDirectory(environment, 'app', True) <> '/etc/app/' then Halt(18);
  try value := GetApplicationConfigDirectory(environment, '..'); Halt(19)
  except on EArgumentException do ; end;
  environment := TEnvironment.Create([]);
  if TryGetUserConfigDirectory(environment, value, error) or (error.Code <> 2) or (value <> '') then Halt(38);
  environment := TEnvironment.Create(['HOME=relative']);
  if TryGetUserDirectory(environment, value, error) or (error.Code <> 22) then Halt(39);
  environment := TEnvironment.Create(['XDG_CONFIG_HOME=/explicit']);
  if not TryGetUserConfigDirectory(environment, value, error) or (value <> '/explicit') then Halt(40);
  SetLength(names, Workers * Each); SetLength(directories, Workers * Each);
  joined.Add(Workers);
  for i := 0 to Workers - 1 do pas CreateResources(i);
  joined.Wait;
  GcCollect;
  if not TryOpenFileAt(CurrentDirectoryHandle, root, ODirectory, 0, handle, error) then Halt(41);
  New(unique);
  for j := 0 to High(names) do
  begin
    if unique[names[j]] or unique[directories[j]] then Halt(42);
    unique[names[j]] := True; unique[directories[j]] := True;
    if not TryDeleteFileAt(handle, names[j], False, error) then Halt(43);
    if not TryDeleteFileAt(handle, directories[j], True, error) then Halt(44);
  end;
  FileClose(handle);
  path := GetTempFileName(root, 'compat-');
  if not FileExists(path) then Halt(45);
  if not TryFileInfoAt(CurrentDirectoryHandle, path, True, info, error) then Halt(46);
  if info.Size <> 0 then Halt(47);
  if not DeleteFile(path) then Halt(48);
  if TOSVersion.Architecture <> GetCompiledArchitecture then Halt(49);
  if not TOSVersion.Check(0) or TOSVersion.Check(TOSVersion.Major + 1) then Halt(50);
  if TOSVersion.Check(TOSVersion.Major, TOSVersion.Minor + 1) then Halt(51);
  if TOSVersion.Check(TOSVersion.Major, TOSVersion.Minor, TOSVersion.Build + 1) then Halt(52);
  WriteLn('exclusive temporary files/directories ', Workers * Each, ', kernel randomness');
  WriteLn('explicit XDG paths and immutable kernel identity');
end.
