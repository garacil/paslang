program gen;

type
  generic TList<T> = record
    N: Integer;
    A: array[1..2] of T;
  end;
  TIntList = specialize TList<Integer>;
  TStrList = specialize TList<string>;

var
  li: TIntList;
  ls: TStrList;

begin
  li.N := 2;
  li.A[1] := 10;
  li.A[2] := 20;
  ls.N := 2;
  ls.A[1] := 'a';
  ls.A[2] := 'b';
  WriteLn(li.A[1]);
  WriteLn(li.A[2]);
  WriteLn(ls.A[1]);
  WriteLn(ls.A[2]);
end.

