{ P422: what a var or out parameter takes: a variable of its own type,
  and for an open array any array of its element type, named or not }
program varparamtype;

type
  TBase = class
    N: Integer;
  end;
  TPoint = record
    X, Y: Integer;
  end;
  TPoints = array of TPoint;
  TNames = array of string;
  TColor = (cRed, cGreen, cBlue);
  TMyInt = Integer;

procedure Bump(var P: array of TPoint);
var
  i: Integer;
begin
  for i := 0 to High(P) do
    P[i].X := P[i].X + 10;
end;

procedure Names(out N: array of string);
var
  i: Integer;
begin
  for i := 0 to High(N) do
    N[i] := 'n' + Chr(48 + i);
end;

procedure Swap(var A, B: TPoint);
var
  t: TPoint;
begin
  t := A;
  A := B;
  B := t;
end;

procedure Make(var C: TBase);
begin
  C := TBase.Create;
  C.N := 7;
end;

procedure Next(var C: TColor);
begin
  C := Succ(C);
end;

procedure Twice(var D: Double);
begin
  D := D * 2;
end;

procedure IncBy(var I: Integer; K: TMyInt);
begin
  I := I + K;
end;

var
  pts: TPoints;
  raw: array of TPoint;
  nm: TNames;
  a, b: TPoint;
  c: TBase;
  col: TColor;
  d: Double;
  m: TMyInt;
begin
  SetLength(pts, 2);
  pts[1].X := 5;
  Bump(pts);
  WriteLn(pts[0].X, ' ', pts[1].X);
  SetLength(raw, 1);
  Bump(raw);
  WriteLn(raw[0].X);
  SetLength(nm, 3);
  Names(nm);
  WriteLn(nm[0], nm[1], nm[2]);
  a.X := 1;
  b.X := 2;
  Swap(a, b);
  WriteLn(a.X, ' ', b.X);
  Make(c);
  WriteLn(c.N);
  col := cRed;
  Next(col);
  WriteLn(Ord(col));
  d := 1.5;
  Twice(d);
  WriteLn(d:0:1);
  m := 40;
  IncBy(m, 2);
  WriteLn(m);
end.
