program quadconst;

{ Quad constants (1.0.115): a named constant expression folded in
  binary128, typed constants of Quad in an array and a record (a Quad
  field on 16, as C's _Float128), default values of Quad, and a Single
  typed constant rounded once from its digits. The values are the ones
  GCC's __float128 gives. }

const
  Third = 1 / 3;
  Sum = 1.1 + 2.2;
  Big = 1e30 * 3;

type
  TRec = record
    B: Byte;
    Q: Quad;
  end;

const
  One: Quad = 1 / 7;
  Arr: array[0..1] of Quad = (0.5, 2 / 3);
  R: TRec = (B: 9; Q: 1e-40);
  S1: Single = 0.1;

var
  q: Quad;
  g: TRec;

procedure P(x: Quad; y: Quad = 1 / 3; z: Quad = 5);
begin
  WriteLn(x:0:36, ' ', y:0:36, ' ', z:0:1);
end;

begin
  q := Third;
  WriteLn(q:0:36);
  q := Sum;
  WriteLn(q:0:36);
  q := 1.1 + 2.2;
  WriteLn(q:0:36);
  WriteLn(Quad(Big):0:3);
  WriteLn(One:0:36);
  WriteLn(Arr[0]:0:3, ' ', Arr[1]:0:36);
  WriteLn(R.B, ' ', R.Q:0:60);
  WriteLn(S1:0:10);
  P(2);
  P(2, 0.25);
  WriteLn(SizeOf(TRec), ' ', SizeOf(g));
end.

