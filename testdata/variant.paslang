program variant;

type
  TNode = record
    Tag: Integer;
    case Integer of
      0: (X: Integer);
      1: (Y: Integer; Z: Integer);
  end;

  TAlt = record
    case Kind: Integer of
      1: (A: Integer);
      2: (B: Integer);
  end;

  TNest = record
    case Integer of
      0: (
        A: Integer;
        case Integer of
          1: (B: Integer);
          2: (C: Integer)
      );
      3: (D: Integer);
  end;

  TText = record
    case Integer of
      0: (N: Integer);
      1: (S: string);
  end;

var
  N: TNode;
  V: TAlt;
  K: TNest;
  T: TText;

begin
  N.Tag := 1;
  N.Y := 10;
  N.Z := 20;
  WriteLn(N.Tag);
  WriteLn(N.Y);
  WriteLn(N.Z);
  N.X := 7;
  WriteLn(N.Y);
  WriteLn(N.Z);
  V.Kind := 2;
  V.B := 5;
  WriteLn(V.Kind);
  WriteLn(V.A);
  K.A := 4;
  K.B := 9;
  WriteLn(K.A);
  WriteLn(K.B);
  WriteLn(K.D);
  T.S := 'hi';
  WriteLn(T.S);
  WriteLn(Length(T.S));
end.
