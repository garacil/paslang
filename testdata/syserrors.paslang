program syserrors;
uses sysutils;
var
  joined: waitgroup;
  completed, phase, i: Integer;
  error: TSysError;

procedure Worker(Index: Integer);
var
  k: Integer;
  marker: string;
begin
  if GetLastOSError <> 0 then Halt(10); { includes recycled Gs }
  Carry := Odd(Index);
  SetLastOSError(Index + 1);
  marker := 'error-' + IntToStr(Index);
  for k := 1 to 5 do
  begin
    Yield;
    GcCollect;
    if GetLastOSError <> Index + 1 then Halt(11);
    if Carry <> Odd(Index) then Halt(12);
    if marker <> 'error-' + IntToStr(Index) then Halt(13);
  end;
  try
    RaiseLastOSError;
    Halt(14);
  except
    on E: EOSError do
      if (E.ErrorCode <> Index + 1) or (E.Message <> SysErrorMessage(Index + 1)) then Halt(15);
  end;
  if GetLastOSError <> Index + 1 then Halt(16);
  AtomicAdd(@completed, 1);
  joined.Done;
end;

begin
  SetLastOSError(13);
  for phase := 1 to 4 do
  begin
    joined.Add(128);
    for i := 0 to 127 do pas Worker(i);
    joined.Wait;
    if GetLastOSError <> 13 then Halt(17);
  end;
  for i := 1 to 2 do
  begin
    try
      if i = 1 then SetLastOSError(-1) else SetLastOSError(2147483648);
      Halt(18);
    except
      on E: EArgumentOutOfRangeException do
        if GetLastOSError <> 13 then Halt(19);
    end;
  end;
  SetLastOSError(2147483647);
  if GetLastOSError <> 2147483647 then Halt(20);
  error.Code := 13;
  error.Operation := 'read';
  error.Path := 'item';
  if not error.Failed then Halt(21);
  WriteLn(error.Message);
  try
    error.RaiseError;
    Halt(22);
  except
    on E: EOSError do
      if (E.ErrorCode <> error.Code) or (E.Message <> error.Message) then Halt(23);
  end;
  error.Code := 0;
  error.RaiseError;
  if error.Failed then Halt(24);
  if SysErrorMessage(0) <> 'success' then Halt(25);
  if SysErrorMessage(41) <> 'unknown system error 41' then Halt(26);
  if SysErrorMessage(-1) <> 'unknown system error -1' then Halt(27);
  WriteLn('independent errors ', completed);
  WriteLn('unknown ', SysErrorMessage(999));
end.
