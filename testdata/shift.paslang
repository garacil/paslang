program shift;

var
  a, b: Integer;

begin
  a := 1;
  b := 4;
  WriteLn(a shl b);
  a := 256;
  b := 8;
  WriteLn(a shr b);
  a := 183;
  b := 8;
  WriteLn((a shl b) or a);
  WriteLn((a shr b) and 255);
  a := $B7;
  WriteLn(a);
end.

