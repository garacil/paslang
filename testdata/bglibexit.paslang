program bglibexit;

uses passignal, pasnet;

procedure Install(Ready, Hold: chan of Integer);
var
  signals: chan of Integer;
  n: Integer;
begin
  signals := MakeChan(1);
  if not SignalNotify(signals, [SIGUSR1]) then
    Halt(1);
  Send(Ready, 1);
  n := Recv(Hold);
end;

function DebuggerReady(const SocketPath: string): Boolean;
var
  Fd: Integer;
  Buffer, Line: string;
begin
  Result := False;
  Fd := UnixConnect(SocketPath);
  if Fd < 0 then
    Exit;
  try
    if TcpWrite(Fd, 'help' + #10) <> 5 then
      Exit;
    Buffer := '';
    while TcpReadLine(Fd, Buffer, Line) do
      if Line = 'ok' then
        Exit(True);
  finally
    UnixClose(Fd);
  end;
end;

procedure Foreground(Start: chan of Integer);
var
  n: Integer;
begin
  n := Recv(Start);
  Sleep(20);
  WriteLn('foreground finished');
end;

var
  Ready, Hold, Start: chan of Integer;
  n: Integer;
begin
  Ready := MakeChan(1);
  Hold := MakeChan(1);
  Start := MakeChan(1);
  pas Foreground(Start);
  pas background Install(Ready, Hold);
  n := Recv(Ready);
  if (ParamCount = 1) and not DebuggerReady(ParamStr(1)) then
    Halt(1);
  WriteLn('foreground routines: ', NumGoroutine);
  Send(Start, 1);
end.
