{ A routine that read standard input and then waits on a channel is
  woken by the channel, not again by the input still left in the pipe:
  the poller's registration stayed armed with the routine itself, so it
  kept readying it, and Recv returned 0 and the program died on a nil
  pointer (1.0.57). The input comes 0.2 s late with 100000 more bytes. }
program spurwake;

var
  c: chan of Integer;
  s: string;
  v: Integer;

procedure Sender;
begin
  Sleep(400);
  Send(c, 42);
end;

begin
  c := MakeChan();
  pas Sender;
  ReadLn(s);
  v := Recv(c);
  WriteLn(s, ' ', v);
end.
