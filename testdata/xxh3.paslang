{ XxHash3: XXH3, 64 bits, with a seed, against the reference
  implementation (xxhash 0.8, XXH3_64bits_withSeed): every length from 0
  to 300 (the paths of 1 to 3, 4 to 8, 9 to 16, 17 to 128 and 129 to 240
  bytes and the first long ones) and lengths about the 1024-byte block
  of the long path, each with four seeds, one negative and one wide.
  make check runs it again compiled with -cpu base for the SSE2 path. }
program xxh3;
var
  s: string;
  i, k, j: Integer;
  lens: array[0..8] of Integer;
  seeds: array[0..3] of Integer;
begin
  seeds[0] := 0; seeds[1] := 1; seeds[2] := -7; seeds[3] := 1311768467294899695;
  lens[0] := 1023; lens[1] := 1024; lens[2] := 1025; lens[3] := 2047; lens[4] := 2048;
  lens[5] := 2049; lens[6] := 3071; lens[7] := 4100; lens[8] := 241;
  s := '';
  for i := 0 to 300 do
  begin
    for k := 0 to 3 do
      WriteLn(XxHash3(s, seeds[k]));
    s := s + Chr(97 + (i * 7) mod 26);
  end;
  for j := 0 to 8 do
  begin
    s := '';
    for i := 0 to lens[j] - 1 do
      s := s + Chr(48 + (i * 13 + j) mod 75);
    for k := 0 to 3 do
      WriteLn(XxHash3(s, seeds[k]));
  end;
  WriteLn(XxHash3('abc'));
end.
