program quadfast;

{ Quad add, subtract, multiply and divide on 2000 operand pairs of every kind
  (normal, far and near exponents, cancellation, near overflow and
  underflow, subnormal), the fast paths of 1.0.122 and the general way,
  their words printed; checked when made against an exact oracle
  (Python fractions, round to nearest even) on 120,000 pairs. }

var
  st: Integer;
  i, cat, fa, fb, sa, sb: Integer;
  a, b, r: Quad;

function Next: Integer;
var
  z: Integer;
begin
  st := st + $9E3779B97F4A7C15;
  z := st;
  z := (z xor (z shr 30)) * $BF58476D1CE4E5B9;
  z := (z xor (z shr 27)) * $94D049BB133111EB;
  Result := z xor (z shr 31);
end;

function Pick(Lo, Hi: Integer): Integer;
begin
  Result := Lo + Integer(UInt32(Next)) mod (Hi - Lo + 1);
end;

procedure Put(var q: Quad; S, F: Integer);
begin
  (q as array[0..1] of Integer)[0] := Next;
  (q as array[0..1] of Integer)[1] := (S shl 63) or (F shl 48) or (Next and 281474976710655);
end;

procedure Show(const q: Quad);
begin
  Write((q as array[0..1] of Integer)[0], ' ', (q as array[0..1] of Integer)[1], ' ');
end;

begin
  st := 12345;
  for i := 1 to 2000 do
  begin
    cat := Pick(0, 5);
    if cat = 0 then
    begin
      fa := Pick(100, 32600);
      fb := fa + Pick(0, 4) - 2;
    end
    else if cat = 1 then
    begin
      fa := Pick(1, 32766);
      fb := Pick(1, 32766);
    end
    else if cat = 2 then
    begin
      fa := Pick(32600, 32766);
      fb := Pick(16300, 16500);
    end
    else if cat = 3 then
    begin
      fa := Pick(1, 130);
      fb := Pick(1, 130);
    end
    else if cat = 4 then
    begin
      fa := 0;
      fb := Pick(0, 200);
    end
    else
    begin
      fa := Pick(16000, 16700);
      fb := fa + Pick(0, 130) - 65;
    end;
    sa := Next and 1;
    sb := Next and 1;
    Put(a, sa, fa);
    Put(b, sb, fb);
    Show(a);
    Show(b);
    r := a + b;
    Show(r);
    r := a - b;
    Show(r);
    r := a * b;
    Show(r);
    r := a / b;
    Show(r);
    WriteLn;
  end;
end.

