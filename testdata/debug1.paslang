{ The debugger inside the executable (P118, 1.1.1): this program is
  compiled with -debug and run with PASLANG_DEBUG naming a socket; its
  main routine connects to its own debugger, sets a break at the loop of Work, waits
  for the stop, reads the variables and the frames, steps a line,
  continues, and prints every reply. make check runs it on both
  machines; the output is the same anywhere. }
program debug1;

uses pasnet;

var
  total: Integer;
  greeting: string;

function Twice(V: Integer): Integer;
begin
  Result := V * 2;
end;

procedure Work(Fin: chan of Integer);
var
  i, x, y: Integer;
  name: string;
  half: Real;
  flag: Boolean;
begin
  name := 'worker';
  flag := False;
  for i := 1 to 3 do
  begin
    x := Twice(i * 5);
    y := x + 1;
    half := x / 4;
    flag := y > 20;
    total := total + y;
  end;
  Send(Fin, 1);
end;

{ The session: its state is local here, so the globals the debugger
  lists are total and greeting alone, the same on every machine. }
procedure Session;
var
  c, v: Integer;
  buf, line: string;
  fin: chan of Integer;

  procedure Ask(const Cmd: string);
  var
    l: string;
  begin
    WriteLn('> ', Cmd);
    TcpWrite(c, Cmd + #10);
    while TcpReadLine(c, buf, l) do
    begin
      WriteLn(l);
      if (l = 'ok') or (Copy(l, 1, 7) = 'error: ') then
        Break;
    end;
  end;

begin
  fin := MakeChan(1);
  c := UnixConnect(ParamStr(1));
  if c < 0 then
  begin
    WriteLn('debug1: no debugger at ', ParamStr(1));
    Halt(1);
  end;
  buf := '';
  TcpReadLine(c, buf, line);
  WriteLn(line);
  Ask('functions');
  Ask('break 29');
  Ask('breaks');
  pas Work(fin);
  Ask('wait');
  Ask('vars g3');
  Ask('where g3');
  Ask('step g3');
  Ask('wait');
  Ask('vars g3');
  Ask('next g3');
  Ask('wait');
  Ask('vars g3');
  Ask('delete 1');
  Ask('break Twice');
  Ask('continue g3');
  Ask('wait');
  Ask('where g3');
  Ask('vars g3 1');
  Ask('delete 2');
  Ask('continue g3');
  v := Recv(fin);
  Ask('globals');
  Ask('quit');
  TcpClose(c);
end;

begin
  greeting := 'hello';
  Session;
  WriteLn('total ', total);
end.

