program rotwords;

uses paslib;

{ Generated by scripts/rotmodel.py (P108, 1.0.129): the rotation and
  shift words and Carry on every integer width, against an exact model. }

var
  cnt: array[0..23] of Integer;
  gByte: Byte;
  gInt8: Int8;
  gWord: Word;
  gInt16: Int16;
