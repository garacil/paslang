procedure FByte(hi, lo: Byte);
var
  j: Integer;
begin
  Write('FunnelLeft Byte ', hi, ' ', lo, ':');
  for j := 0 to High(cnt) do
    Write(' ', FunnelLeft(hi, lo, cnt[j]));
  WriteLn;
  WriteLn('FunnelLeft Byte const', ' ', FunnelLeft(hi, lo, -1), ' ', FunnelLeft(hi, lo, 0), ' ', FunnelLeft(hi, lo, 1), ' ', FunnelLeft(hi, lo, 2), ' ', FunnelLeft(hi, lo, 5), ' ', FunnelLeft(hi, lo, 7), ' ', FunnelLeft(hi, lo, 8), ' ', FunnelLeft(hi, lo, 9), ' ', FunnelLeft(hi, lo, 15), ' ', FunnelLeft(hi, lo, 16), ' ', FunnelLeft(hi, lo, 17), ' ', FunnelLeft(hi, lo, 64), ' ', FunnelLeft(hi, lo, 65), ' ', FunnelLeft(hi, lo, 100), ' ', FunnelLeft(hi, lo, 128), ' ', FunnelLeft(hi, lo, 129), ' ', FunnelLeft(hi, lo));
  Write('FunnelRight Byte ', hi, ' ', lo, ':');
  for j := 0 to High(cnt) do
    Write(' ', FunnelRight(hi, lo, cnt[j]));
  WriteLn;
  WriteLn('FunnelRight Byte const', ' ', FunnelRight(hi, lo, -1), ' ', FunnelRight(hi, lo, 0), ' ', FunnelRight(hi, lo, 1), ' ', FunnelRight(hi, lo, 2), ' ', FunnelRight(hi, lo, 5), ' ', FunnelRight(hi, lo, 7), ' ', FunnelRight(hi, lo, 8), ' ', FunnelRight(hi, lo, 9), ' ', FunnelRight(hi, lo, 15), ' ', FunnelRight(hi, lo, 16), ' ', FunnelRight(hi, lo, 17), ' ', FunnelRight(hi, lo, 64), ' ', FunnelRight(hi, lo, 65), ' ', FunnelRight(hi, lo, 100), ' ', FunnelRight(hi, lo, 128), ' ', FunnelRight(hi, lo, 129), ' ', FunnelRight(hi, lo));
end;

