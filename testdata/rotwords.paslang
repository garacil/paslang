procedure VByteRotateLeft(v: Byte);
var
  j, c: Integer;
  x: Byte;
begin
  for c := 0 to 1 do
  begin
    Write('RotateLeft Byte ', v, ' ', c, ':');
    for j := 0 to High(cnt) do
    begin
      Carry := c = 1;
      x := RotateLeft(v, cnt[j]);
      Write(' ', x, '/', Carry);
    end;
    WriteLn;
  end;
end;

