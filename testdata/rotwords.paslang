procedure SetOn;
begin
  CarryOn;
end;

function Peek: Boolean;
begin
  Result := Carry;
end;

procedure Deep(d: Integer);
var
  pad: array[0..63] of Integer;
begin
  pad[d and 63] := d;
  if d = 0 then
    CarryFlip
  else
    Deep(d - 1);
end;

procedure Child(id: Integer);
var
  i: Integer;
begin
  childSaw := Carry;
  for i := 1 to 1000 do
    CarryFlip;
  CarryOn;
  Send(done, id);
end;

procedure Flipper(id: Integer);
var
  i, bad: Integer;
  want: Boolean;
begin
  bad := 0;
  want := (id and 1) = 1;
  Carry := want;
  for i := 1 to 200000 do
  begin
    CarryFlip;
    want := not want;
    if (i mod 20000) = 0 then
    begin
      Deep(400 + id * 100);
      want := not want;
    end;
    if Carry <> want then
      bad := bad + 1;
  end;
  Send(done, bad);
end;

procedure Wide256;
var
  a: array[0..3] of Integer;
  k, i: Integer;
begin
  a[0] := -1;
  a[1] := 0;
  a[2] := 9223372036854775807;
  a[3] := 1;
  for k := 1 to 5 do
  begin
    CarryOff;
    for i := 0 to 3 do
      a[i] := RotateLeftThroughCarry(a[i]);
  end;
  WriteLn('wide256 ', a[0], ' ', a[1], ' ', a[2], ' ', a[3], ' ', Carry);
end;

procedure Ring9;
var
  b: Byte;
  i, s, ones: Integer;
begin
  b := $B5;
  CarryOn;
  s := 0;
  ones := 0;
  for i := 1 to 100 do
  begin
    b := RotateLeftThroughCarry(b);
    s := s + b;
    if Carry then
      ones := ones + 1;
  end;
  WriteLn('ring9 ', b, ' ', Carry, ' ', s, ' ', ones);
end;

function Crc8(const s: string): Byte;
var
  crc: Byte;
  i, k: Integer;
begin
  crc := 0;
  for i := 1 to Length(s) do
  begin
    crc := crc xor Byte(Ord(s[i]));
    for k := 0 to 7 do
    begin
      crc := ShiftLeftToCarry(crc);
      if Carry then
        crc := crc xor $07;
    end;
  end;
  Result := crc;
end;

