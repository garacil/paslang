procedure SInt8;
var
  x, y: Int8;
  i, sum: Integer;
begin
  x := -75;
  y := -128;
  sum := 0;
  CarryOn;
  for i := 1 to 20 do
  begin
    x := RotateLeftThroughCarry(x, 1);
    y := RotateLeftThroughCarry(y);
    sum := sum + x + y;
    if x < 0 then
      sum := sum + 1000;
  end;
  WriteLn('sign RotateLeftThroughCarry Int8 ', x, ' ', y, ' ', sum, ' ', Carry);
  x := -75;
  y := -128;
  sum := 0;
  CarryOn;
  for i := 1 to 20 do
  begin
    x := ShiftLeftToCarry(x, 1);
    y := ShiftLeftToCarry(y);
    sum := sum + x + y;
    if x < 0 then
      sum := sum + 1000;
  end;
  WriteLn('sign ShiftLeftToCarry Int8 ', x, ' ', y, ' ', sum, ' ', Carry);
  x := -75;
  y := -128;
  sum := 0;
  CarryOn;
  for i := 1 to 20 do
  begin
    x := RotateLeftToCarry(x, 3);
    y := RotateLeftToCarry(y);
    sum := sum + x + y;
    if x < 0 then
      sum := sum + 1000;
  end;
  WriteLn('sign RotateLeftToCarry Int8 ', x, ' ', y, ' ', sum, ' ', Carry);
  x := -75;
  y := -128;
  sum := 0;
  CarryOn;
  for i := 1 to 20 do
  begin
    x := ShiftRightSigned(x, 2);
    y := ShiftRightSigned(y);
    sum := sum + x + y;
    if x < 0 then
      sum := sum + 1000;
  end;
  WriteLn('sign ShiftRightSigned Int8 ', x, ' ', y, ' ', sum, ' ', Carry);
