  WriteLn;
  WriteLn('FunnelLeft Integer const', ' ', FunnelLeft(hi, lo, -1), ' ', FunnelLeft(hi, lo, 0), ' ', FunnelLeft(hi, lo, 1), ' ', FunnelLeft(hi, lo, 2), ' ', FunnelLeft(hi, lo, 5), ' ', FunnelLeft(hi, lo, 63), ' ', FunnelLeft(hi, lo, 64), ' ', FunnelLeft(hi, lo, 65), ' ', FunnelLeft(hi, lo, 127), ' ', FunnelLeft(hi, lo, 128), ' ', FunnelLeft(hi, lo, 129), ' ', FunnelLeft(hi, lo, 100), ' ', FunnelLeft(hi, lo));
  Write('FunnelRight Integer ', hi, ' ', lo, ':');
  for j := 0 to High(cnt) do
    Write(' ', FunnelRight(hi, lo, cnt[j]));
  WriteLn;
  WriteLn('FunnelRight Integer const', ' ', FunnelRight(hi, lo, -1), ' ', FunnelRight(hi, lo, 0), ' ', FunnelRight(hi, lo, 1), ' ', FunnelRight(hi, lo, 2), ' ', FunnelRight(hi, lo, 5), ' ', FunnelRight(hi, lo, 63), ' ', FunnelRight(hi, lo, 64), ' ', FunnelRight(hi, lo, 65), ' ', FunnelRight(hi, lo, 127), ' ', FunnelRight(hi, lo, 128), ' ', FunnelRight(hi, lo, 129), ' ', FunnelRight(hi, lo, 100), ' ', FunnelRight(hi, lo));
end;

