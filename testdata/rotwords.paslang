  u := ShiftLeftToCarry($80000001);
  WriteLn('const uint32 ', u, ' ', Carry);
  WriteLn('const alone ', ShiftLeftToCarry($80), ' ', Carry);
  WriteLn('const count ', RotateLeftToCarry(b, 2 + 3), ' ', FunnelLeft(1, 2, 60));
  b := $81;
  w := $1234;
  s8 := -2;
  WriteLn('mixed ', FunnelLeft(b, w, 4), ' ', FunnelRight(s8, b, 4), ' ', FunnelLeft(w, 1, 12));
  i := 48;
  ShiftRightToCarry(i, 5);
  WriteLn('statement ', i, ' ', Carry);
  CarryOn;
  i := (i rol 70) shl 3;
  i := i shr 1;
  WriteLn('operators ', i, ' ', Carry);
  CarryOff;
  SetOn;
  WriteLn('after a call ', Carry, ' ', Peek);
  CarryOff;
  Deep(3000);
  WriteLn('after deep recursion ', Carry);
  CarryOn;
  done := MakeChan(1);
  pas Child(7);
  hid := Recv(done);
  CarryFlip;
  WriteLn('a new routine starts with ', childSaw, '; this one kept ', Carry, ' ', hid);
  done := MakeChan(4);
  for hid := 0 to 3 do
    pas Flipper(hid);
  for hid := 0 to 100000 do
    junk := 'x' + IntToStr(hid);
  hid := 0;
  for i := 0 to 3 do
    hid := hid + Recv(done);
  WriteLn('flippers ', hid);
  Wide256;
  Ring9;
  WriteLn('crc8 ', Crc8('123456789'));
end.

