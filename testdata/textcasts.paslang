program textcasts;
type TText = string; TChars = ^Char;
var joined: waitgroup; i: Integer;
procedure Check(Index: Integer);
var s, t: string; c: Char; p, q: PChar; aliasPointer: TChars; k: Integer;
begin
  c := Chr(65 + Index mod 26);
  s := string(c);
  if (Length(s) <> 1) or (s[1] <> c) then Halt(2);
  t := TText(c);
  if t <> s then Halt(3);
  if string(t) <> t then Halt(4);
  for k := 0 to 128 do
  begin
    s := StringOfChar(c, k);
    p := PChar(s); q := PChar(s);
    aliasPointer := TChars(s);
    if (p = nil) or (q = nil) or (aliasPointer = nil) then Halt(5);
    if (p[k] <> #0) or (q[k] <> #0) or (aliasPointer[k] <> #0) then Halt(6);
    if k > 0 then
    begin
      p[0] := '!';
      if (q[0] <> c) or (s[1] <> c) then Halt(7);
      s[1] := '?';
      if (p[0] <> '!') or (q[0] <> c) then Halt(8);
    end;
    s := ''; t := '';
    GcCollect;
    if (p[k] <> #0) or (q[k] <> #0) then Halt(9);
  end;
  p := PChar('literal');
  if (p[0] <> 'l') or (p[7] <> #0) then Halt(10);
  p := PChar('a'#0'b');
  if (p[0] <> 'a') or (p[1] <> #0) or (p[2] <> 'b') or (p[3] <> #0) then Halt(11);
  joined.Done;
end;
begin
  joined.Add(64);
  for i := 0 to 63 do pas Check(i);
  joined.Wait;
  WriteLn('string/Char casts and owned NUL-terminated PChar snapshots');
end.
