program visibility;

{ Visibility as FPC enforces it (1.0.137). Every class here is declared
  in this program, so its private and protected members are the
  program's to use; a strict private member is used only in its class's
  methods (Self's, another instance's, a nested routine's, a closure's,
  inside a with), a strict protected one in the methods of its class and
  of its descendants. Published properties still reach RTTI. The rules
  across units: testdata/units/visu, visd and visuse; the rejects:
  testdata/bitbad/vis*. }

type
  THit = procedure(N: Integer);
  TIntMeth = procedure(N: Integer) of object;
  TMap = function(X: Integer): Integer;
  TPoint = record
    X, Y: Integer;
  end;

  TBase = class
    Tag: Integer;
  private
    FPriv: Integer;
    constructor MakeQuiet;
    procedure PrivShow;
    property Priv: Integer read FPriv write FPriv;
  strict private
    FSecret: Integer;
    FHit: THit;
    function SecretTwice: Integer;
    procedure Bump(N: Integer);
    property Secret2: Integer read FSecret;
  protected
    FProt: Integer;
    procedure ProtShow; virtual;
  strict protected
    FSP: Integer;
    function SPValue: Integer;
    procedure SPShow; virtual;
  public
    constructor Create(ASecret: Integer);
    function Secret: Integer;
    function Peek(Other: TBase): Integer;
    function Nested: Integer;
    function Adder: TMap;
    function WithRec: Integer;
    function ByValue: Integer;
    procedure Fire(N: Integer);
  published
    property Prot: Integer read FProt write FProt;
  end;

  TChild = class(TBase)
  protected
    procedure ProtShow; override;
  strict protected
    procedure SPShow; override;
  public
    constructor Create;
    function Sum: Integer;
    function Via(B: TBase): Integer;
  end;

var
  fired: Integer;

procedure Hit(N: Integer);
begin
  fired := fired + N;
end;

constructor TBase.Create(ASecret: Integer);
begin
  FSecret := ASecret;
  FSP := 100;
  FProt := 10;
  FHit := @Hit;
end;

constructor TBase.MakeQuiet;
begin
  FSecret := -1;
end;

procedure TBase.PrivShow;
begin
  WriteLn('private method: ', FPriv);
end;

function TBase.SecretTwice: Integer;
begin
  Result := FSecret * 2;
end;

procedure TBase.Bump(N: Integer);
begin
  FSecret := FSecret + N;
end;

procedure TBase.ProtShow;
begin
  WriteLn('TBase.ProtShow ', FProt);
end;

function TBase.SPValue: Integer;
begin
  Result := FSP + 1;
end;

procedure TBase.SPShow;
begin
  WriteLn('TBase.SPShow ', FSP);
end;

function TBase.Secret: Integer;
begin
  Result := SecretTwice + Self.FSecret + Secret2;
end;

function TBase.Peek(Other: TBase): Integer;
begin
  { another instance's strict private members, in its class's method }
  Other.Bump(1);
  Result := Other.FSecret + Other.SecretTwice;
end;

function TBase.Nested: Integer;
  function Inner: Integer;
  begin
    Result := FSecret + SecretTwice;
  end;
begin
  Result := Inner;
end;

function TBase.Adder: TMap;
begin
  Result := function(X: Integer): Integer
  begin
    Result := X + FSecret;
  end;
end;

function TBase.WithRec: Integer;
var
  p: TPoint;
begin
  p.X := 3;
  p.Y := 4;
  with p do
    Result := X + Y + FSecret;
end;

function TBase.ByValue: Integer;
var
  m: TIntMeth;
begin
  m := Self.Bump;
  m(5);
  Result := FSecret;
end;

procedure TBase.Fire(N: Integer);
begin
  FHit(N);
end;

constructor TChild.Create;
begin
  inherited Create(7);
  FProt := 20;
  FSP := 200;
end;

procedure TChild.ProtShow;
begin
  inherited ProtShow;
  WriteLn('TChild.ProtShow ', FProt + 1);
end;

procedure TChild.SPShow;
begin
  inherited SPShow;
  WriteLn('TChild.SPShow ', SPValue);
end;

function TChild.Sum: Integer;
begin
  SPShow;
  Result := FSP + SPValue + Self.FProt;
end;

function TChild.Via(B: TBase): Integer;
begin
  Result := B.FSP + B.SPValue;
end;

var
  b, q: TBase;
  c: TChild;
  f: TMap;

begin
  fired := 0;
  b := TBase.Create(5);
  b.Tag := 1;
  { private and protected: this program declared the class }
  b.FPriv := 3;
  b.PrivShow;
  b.Priv := b.Priv + 1;
  WriteLn('private property: ', b.Priv);
  b.FProt := b.FProt + 2;
  b.ProtShow;
  WriteLn('published: ', GetPropInt(b, 'Prot'));
  q := TBase.MakeQuiet;
  WriteLn('private constructor: ', q.Peek(b));
  { strict members through the class's own methods }
  WriteLn('secret: ', b.Secret);
  WriteLn('nested: ', b.Nested);
  f := b.Adder;
  WriteLn('closure: ', f(10));
  WriteLn('with: ', b.WithRec);
  WriteLn('method value: ', b.ByValue);
  b.Fire(4);
  b.Fire(5);
  WriteLn('routine field: ', fired);
  c := TChild.Create;
  WriteLn('strict protected: ', c.Sum);
  WriteLn('via: ', c.Via(b));
  b := c;
  b.ProtShow;
  { before any section: public }
  c.Tag := 2;
  WriteLn('tag: ', b.Tag + c.Tag);
end.
