program realincplace;
var
  a: array[0..3] of Real;
  calls: Integer;

function K: Integer;
begin
  Inc(calls);
  K := 1;
end;

begin
  Inc(a[K]);
  if (calls <> 1) or (a[1] <> 1) then Halt(1);
  WriteLn(a[1]);
end.

