{ P94: Result starts as zero, all of it. A string, a slice or a record
  that a function never assigns comes back empty, not with the length a
  previous frame left in its second word (amd64 cleared only the first). }
program reszero;

type
  TPair = record
    A, B, C: Integer;
  end;

function Noise(A, B, C: Integer): Integer;
var
  x, y, z: Integer;
begin
  x := A * 7777777;
  y := B * 5555555;
  z := C * 3333333;
  Result := x + y + z;
end;

function Str(N: Integer): string;
begin
  if N > 100 then
    Result := 'big';
end;

function Arr(N: Integer): array of Integer;
begin
  if N > 100 then
    SetLength(Result, 3);
end;

function Rec(N: Integer): TPair;
begin
  if N > 100 then
    Result.A := 1;
end;

var
  s: string;
  a: array of Integer;
  r: TPair;
  k: Integer;
begin
  k := Noise(123456, 654321, 999999);
  s := Str(1);
  WriteLn(Length(s));
  k := k + Noise(7, 8, 9);
  a := Arr(1);
  WriteLn(Length(a));
  k := k + Noise(3, 2, 1);
  r := Rec(1);
  WriteLn(r.A, ' ', r.B, ' ', r.C);
  WriteLn(Str(200), ' ', Length(Arr(200)), ' ', Rec(200).A, ' ', k <> 0);
end.

