program propacc;

type
  TFoo = class
    FX: Integer;
    function GetX: Integer; virtual;
    procedure SetX(V: Integer);
    property X: Integer read GetX write SetX;
    property Y: Integer read FX write FX;
  end;

  TBar = class(TFoo)
    function GetX: Integer; virtual;
  end;

function TFoo.GetX: Integer;
begin
  Result := FX + 1;
end;

procedure TFoo.SetX(V: Integer);
begin
  FX := V + 2;
end;

function TBar.GetX: Integer;
begin
  Result := FX + 10;
end;

var
  o: TFoo;
  b: TBar;

begin
  o := TFoo.Create;
  o.FX := 10;
  WriteLn(o.X);
  o.X := 5;
  WriteLn(o.FX);
  o.Y := 7;
  WriteLn(o.Y);
  b := TBar.Create;
  b.FX := 3;
  WriteLn(b.X);
  o := b;
  WriteLn(o.X);
end.
