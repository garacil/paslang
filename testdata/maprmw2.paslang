program maprmw2;

{ P557: m[K] := m[K] and E, or, xor and * of a word-sized integer entry (E on
  either side), m[K] := m[K] + E, - and * of a Double entry (E on either side
  of a sum and a product, the entry on the left of a difference), and every
  form P555 has on arm64, look the key up once. This checks what the two
  lookups gave: a key that is not there made with zero, E that is an integer,
  a Single, a constant and an expression, the entry on the right of a
  difference (the two lookups still), keys that are expressions, fields,
  pointers, elements and strings, a call in the key (made twice, as before),
  a call in E that writes the entry or the map (the entry was read first),
  the wrap of a product, entries of other sizes and sorts, the growth of the
  map under the statement, and random operations against a model. }

uses sysutils;

type
  TIM = map[Integer] of Integer;
  TSI = map[string] of Integer;
  TUM = map[Integer] of UInt64;
  TBM = map[Integer] of Byte;
  T3M = map[Integer] of Int32;
  TWM = map[Integer] of Word;
  TRM = map[Integer] of 0..200;
  TDM = map[Integer] of Double;
  TSD = map[string] of Double;
  TGM = map[Integer] of Single;
  THolder = record
    N: Integer;
    M: TDM;
  end;
  PHolder = ^THolder;
  PBits = ^Int64;

var
  Calls: Integer;
  Glob: TIM;
  GlobD: TDM;
  Seed: Integer;

function F(k: Integer): Integer;
begin
  Calls := Calls + 1;
  Result := k;
end;

{ writes the entry it is combined with, and grows the map }
function G(k: Integer): Integer;
var
  i: Integer;
begin
  Glob[k] := 1000;
  for i := 1 to 200 do
    Glob[100000 + i] := i;
  Result := 5;
end;

function GD(k: Integer): Double;
var
  i: Integer;
begin
  GlobD[k] := 1000.5;
  for i := 1 to 200 do
    GlobD[100000 + i] := i;
  Result := 2.5;
end;

function Rnd(n: Integer): Integer;
begin
  Seed := Seed * 6364136223846793005 + 1442695040888963407;
  Result := (Seed shr 33) mod n;
end;

{ five updates of one entry of the new kinds: five lookups now, each a put }
procedure Mixi(m: TIM; k, n: Integer);
begin
  m[k] := m[k] and n;
  m[k] := m[k] or n;
  m[k] := n xor m[k];
  m[k] := m[k] * n;
  m[k] := n * m[k];
end;

procedure Mixd(m: TDM; k: Integer; x: Double);
begin
  m[k] := m[k] + x;
  m[k] := m[k] - x;
  m[k] := x + m[k];
  m[k] := m[k] * x;
  m[k] := x * m[k];
end;

procedure Bits;
var
  m: TIM;
  k, n: Integer;
begin
  New(m);
  k := 5;
  n := $F0F0;
  m[k] := m[k] and n;
  WriteLn('absent and ', m[k], ' ', Length(m));
  m[6] := m[6] or n;
  WriteLn('absent or ', m[6], ' ', Length(m));
  m[7] := n xor m[7];
  WriteLn('absent xor ', m[7], ' ', Length(m));
  m[k] := m[k] or $0FF0;
  m[k] := m[k] xor 255;
  WriteLn('mixed ', m[k]);
  m[k] := m[k] and $FF00;
  WriteLn('masked ', m[k]);
  m[k] := $55 or m[k];
  m[k] := $F xor m[k];
  m[k] := $FFFF and m[k];
  WriteLn('swapped ', m[k]);
  m[k] := m[k] and (n shr 4);
  WriteLn('expression ', m[k]);
  m[8] := -1;
  m[8] := m[8] and $7FFF;
  m[8] := m[8] xor -1;
  WriteLn('negative ', m[8]);
  m[9] := -12345;
  m[9] := m[9] or n;
  m[9] := m[9] and m[8];
  WriteLn('two entries ', m[9]);
  m[10] := High(Int64);
  m[10] := m[10] xor Low(Int64);
  WriteLn('extremes ', m[10]);
  Mixi(m, 11, 6);
  WriteLn('routine ', m[11], ' ', Length(m));
  m[12] := 77;
  Mixi(m, 12, 6);
  WriteLn('routine again ', m[12], ' ', Length(m));
end;

procedure Times;
var
  m: TIM;
  k, n, i: Integer;
begin
  New(m);
  k := 3;
  n := 7;
  m[k] := m[k] * n;
  WriteLn('absent times ', m[k], ' ', Length(m));
  m[k] := 5;
  m[k] := m[k] * n;
  m[k] := n * m[k];
  m[k] := m[k] * (n + 1);
  m[k] := -3 * m[k];
  WriteLn('times ', m[k]);
  m[4] := 3;
  for i := 1 to 50 do
    m[4] := m[4] * 3;
  WriteLn('wrap ', m[4]);
  m[5] := 1;
  for i := 1 to 70 do
    m[5] := 2 * m[5];
  WriteLn('shifted out ', m[5]);
  m[6] := High(Int64);
  m[6] := m[6] * 2;
  WriteLn('largest doubled ', m[6]);
  m[7] := Low(Int64);
  m[7] := m[7] * -1;
  WriteLn('lowest negated ', m[7]);
end;

procedure Reals;
var
  d: TDM;
  sg: Single;
  k, n: Integer;
  x, e1, e2, y: Double;
begin
  New(d);
  k := 4;
  x := 0.25;
  d[k] := d[k] + x;
  WriteLn('absent add ', d[k]:0:4, ' ', Length(d));
  d[5] := d[5] - 0.5;
  WriteLn('absent sub ', d[5]:0:4, ' ', Length(d));
  d[6] := d[6] * 3.0;
  WriteLn('absent mul ', d[6]:0:4, ' ', Length(d));
  d[k] := d[k] + 1.5;
  d[k] := 2.5 + d[k];
  d[k] := d[k] - x;
  d[k] := d[k] * 4.0;
  d[k] := 0.5 * d[k];
  WriteLn('chain ', d[k]:0:4);
  n := 3;
  d[k] := d[k] + n;
  d[k] := n + d[k];
  d[k] := d[k] - n;
  d[k] := d[k] * n;
  WriteLn('integer E ', d[k]:0:4);
  sg := 1.5;
  d[k] := d[k] + sg;
  d[k] := sg * d[k];
  d[k] := d[k] - sg;
  WriteLn('single E ', d[k]:0:4);
  d[7] := 10.0;
  d[7] := 1.0 - d[7];
  WriteLn('reversed ', d[7]:0:4);
  d[8] := 0.1;
  d[8] := d[8] + 0.2;
  WriteLn('rounding ', d[8] = 0.30000000000000004, ' ', d[8] = 0.3);
  d[9] := 0.0;
  d[9] := d[9] * -1.0;
  WriteLn('minus zero ', d[9]:0:1, ' ', d[9] = 0.0);
  d[10] := 1.0e308;
  d[10] := d[10] * 10.0;
  d[11] := d[10] - d[10];
  d[11] := d[11] + 1.0;
  WriteLn('infinity ', d[10] > 1.0e308, ' ', d[11] <> d[11]);
  d[12] := d[11];
  d[12] := d[12] * 0.0;
  WriteLn('not a number stays ', d[12] <> d[12]);
  { two NaNs of different payloads: the result keeps the first operand's }
  PBits(@e1)^ := $7FF8000000000001;
  PBits(@e2)^ := $7FF8000000000002;
  d[15] := e2;
  d[15] := e1 + d[15];
  y := d[15];
  WriteLn('payload sum ', PBits(@y)^ and 255);
  d[16] := e2;
  d[16] := d[16] + e1;
  y := d[16];
  WriteLn('payload sum, entry first ', PBits(@y)^ and 255);
  d[17] := e2;
  d[17] := e1 * d[17];
  y := d[17];
  WriteLn('payload product ', PBits(@y)^ and 255);
  d[18] := e2;
  d[18] := d[18] * e1;
  y := d[18];
  WriteLn('payload product, entry first ', PBits(@y)^ and 255);
  d[19] := e2;
  d[19] := d[19] - e1;
  y := d[19];
  WriteLn('payload difference ', PBits(@y)^ and 255);
  d[13] := 2.0;
  d[13] := d[13] * d[13];
  WriteLn('square ', d[13]:0:4);
  d[14] := d[13] + d[13] * 0.5;
  WriteLn('other entries ', d[14]:0:4);
  Mixd(d, 20, 1.5);
  WriteLn('routine ', d[20]:0:4, ' ', Length(d));
  d[21] := 8.0;
  Mixd(d, 21, 0.5);
  WriteLn('routine again ', d[21]:0:4, ' ', Length(d));
end;

procedure Keys;
var
  m: TIM;
  d: TDM;
  a: array[0..4] of Integer;
  rec: THolder;
  p: PHolder;
  recs: array[0..2] of THolder;
  i, j, k: Integer;
  t: Double;
begin
  New(m);
  New(d);
  for i := 0 to 4 do
    a[i] := i * 11;
  for i := 1 to 20 do
  begin
    j := i mod 5;
    m[a[j]] := m[a[j]] xor i;
    m[i * 3 + 1] := m[i * 3 + 1] or (1 shl (i mod 9));
    m[j + 100] := m[j + 100] * 3 + 1;
    d[a[j]] := d[a[j]] + i;
    d[j + 100] := d[j + 100] * 1.5;
    d[i * 3 + 1] := d[i * 3 + 1] - 0.5;
  end;
  k := 0;
  t := 0;
  for i := 0 to 4 do
  begin
    k := k + m[a[i]] * (i + 1);
    t := t + d[a[i]] * (i + 1);
  end;
  WriteLn('keys ', k, ' ', Length(m), ' ', m[0], ' ', m[44], ' ', m[102], ' ', m[61]);
  WriteLn('real keys ', t:0:4, ' ', Length(d), ' ', d[0]:0:4, ' ', d[44]:0:4, ' ', d[102]:0:4, ' ', d[61]:0:4);
  New(rec.M);
  rec.M[3] := rec.M[3] + 4.5;
  rec.M[3] := rec.M[3] * 2.0;
  New(p);
  New(p^.M);
  p^.M[3] := p^.M[3] - 4.5;
  p^.M[3] := 1.5 * p^.M[3];
  for i := 0 to 2 do
  begin
    New(recs[i].M);
    for j := 1 to 5 do
    begin
      recs[i].M[j] := recs[i].M[j] + i * j;
      recs[i].M[j] := recs[i].M[j] * 2.0;
    end;
  end;
  WriteLn('fields ', rec.M[3]:0:4, ' ', p^.M[3]:0:4, ' ', recs[2].M[5]:0:4, ' ', recs[1].M[4]:0:4, ' ', recs[0].M[3]:0:4);
end;

procedure Strings;
var
  s: TSI;
  e: TSD;
  words: array[0..7] of string;
  w: string;
  i, n, total, cnt: Integer;
  xors: array[0..7] of Integer;
  sum: Double;
begin
  words[0] := 'the';
  words[1] := 'quick';
  words[2] := 'brown';
  words[3] := 'fox';
  words[4] := 'jumps';
  words[5] := 'over';
  words[6] := 'lazy';
  words[7] := 'dog';
  New(s);
  New(e);
  for i := 0 to 7 do
    xors[i] := 0;
  for n := 1 to 5000 do
  begin
    i := (n * 7 + n div 3) mod 8;
    w := words[i];
    s[w] := s[w] xor n;
    e[w] := e[w] + n * 0.5;
    xors[i] := xors[i] xor n;
  end;
  s['literal'] := s['literal'] or 5;
  e['literal'] := e['literal'] + 2.25;
  e['literal'] := e['literal'] * 2.0;
  cnt := 0;
  sum := 0;
  for i := 0 to 7 do
    if s[words[i]] = xors[i] then
      cnt := cnt + 1;
  total := 0;
  sum := 0;
  for w, n in s do
    total := total xor n;
  for i := 0 to 7 do
    sum := sum + e[words[i]];
  WriteLn('strings ', cnt, ' ', total, ' ', s['literal'], ' ', Length(s), ' ', sum:0:2, ' ', e['literal']:0:4, ' ', Length(e));
  w := 'q';
  s['q'] := 12;
  s[''] := 10;
  s[w] := s[''] * 3;
  s[w] := s[w] and 255;
  e[w] := e[w] + 1.0;
  e[''] := 3.0;
  e[w] := e[''] * e[w];
  WriteLn('literal and variable ', s['q'], ' ', s[''], ' ', e['q']:0:4, ' ', e['']:0:4);
end;

procedure Calling;
var
  m: TIM;
  d: TDM;
  k: Integer;
begin
  New(m);
  New(d);
  Calls := 0;
  m[F(4)] := m[F(4)] xor 3;
  d[F(4)] := d[F(4)] + 3.5;
  WriteLn('call in the key ', m[4], ' ', d[4]:0:4, ' ', Calls);
  k := 4;
  m[k] := m[k] or F(8);
  d[k] := d[k] * F(2);
  WriteLn('call in E ', m[4], ' ', d[4]:0:4, ' ', Calls);
  Glob := m;
  GlobD := d;
  m[k] := m[k] and G(k);
  d[k] := d[k] + GD(k);
  WriteLn('E writes the entry ', m[4], ' ', d[4]:0:4, ' ', Length(m), ' ', Length(d));
  m[k] := G(k) xor m[k];
  d[k] := GD(k) * d[k];
  WriteLn('E first, the entry later ', m[4], ' ', d[4]:0:4);
end;

procedure Others;
var
  u: TUM;
  b: TBM;
  w: TWM;
  i3: T3M;
  sm: TGM;
  sr: TRM;
  k: Integer;
begin
  New(u);
  New(b);
  New(w);
  New(i3);
  New(sm);
  New(sr);
  u[1] := High(UInt64);
  u[1] := u[1] and $FF00FF00FF00FF00;
  u[1] := u[1] xor 1;
  u[2] := u[2] or $8000000000000000;
  u[2] := u[2] * 3;
  u[3] := 5;
  u[3] := u[3] * u[3];
  WriteLn('unsigned ', u[1] shr 60, ' ', u[1] and 255, ' ', u[2] shr 62, ' ', u[2] and 255, ' ', u[3]);
  for k := 1 to 300 do
  begin
    b[k mod 3] := Byte(b[k mod 3] xor k);
    i3[k mod 3] := Int32(i3[k mod 3] or (1 shl (k mod 31)));
    sm[k mod 3] := sm[k mod 3] + 0.5;
  end;
  for k := 1 to 20 do
  begin
    b[3 + k mod 3] := b[3 + k mod 3] and 15;
    b[3 + k mod 3] := b[3 + k mod 3] or 33;
    b[3 + k mod 3] := b[3 + k mod 3] xor 7;
    b[3 + k mod 3] := b[3 + k mod 3] * 3;
    w[k mod 3] := w[k mod 3] * 3;
    w[k mod 3] := w[k mod 3] xor 4660;
    i3[3 + k mod 3] := i3[3 + k mod 3] * 3;
    i3[3 + k mod 3] := i3[3 + k mod 3] xor 9;
    sm[3 + k mod 3] := sm[3 + k mod 3] * 1.5;
    sm[3 + k mod 3] := sm[3 + k mod 3] + 0.25;
    sr[k mod 3] := sr[k mod 3] xor 5;
    sr[k mod 3] := sr[k mod 3] and 100;
  end;
  WriteLn('narrow plain ', b[3], ' ', b[4], ' ', b[5], ' ', w[0], ' ', w[1], ' ', w[2], ' ', i3[3], ' ', i3[4], ' ', i3[5], ' ', sm[3]:0:3, ' ', sm[5]:0:3, ' ', sr[0], ' ', sr[1], ' ', sr[2]);
  WriteLn('narrow ', b[0], ' ', b[1], ' ', b[2], ' ', i3[0], ' ', i3[1], ' ', i3[2], ' ', sm[0]:0:2, ' ', sm[2]:0:2);
end;

procedure Growth;
var
  m: TIM;
  d: TDM;
  i, sum, bad: Integer;
  total: Double;
begin
  New(m);
  New(d);
  for i := 1 to 200000 do
  begin
    m[i * 7919] := m[i * 7919] xor i;
    d[i * 7919] := d[i * 7919] + i;
  end;
  for i := 1 to 200000 do
  begin
    m[i * 7919] := m[i * 7919] or 3;
    d[i * 7919] := d[i * 7919] * 0.5;
  end;
  for i := 1 to 200000 do
    if i mod 3 = 0 then
    begin
      m[i * 7919] := m[i * 7919] * 2;
      d[i * 7919] := d[i * 7919] - i;
    end;
  sum := 0;
  bad := 0;
  total := 0;
  for i := 1 to 200000 do
  begin
    sum := sum + m[i * 7919];
    total := total + d[i * 7919];
    if i mod 3 = 0 then
    begin
      if m[i * 7919] <> (i or 3) * 2 then
        bad := bad + 1;
      if d[i * 7919] <> i * 0.5 - i then
        bad := bad + 1;
    end
    else
    begin
      if m[i * 7919] <> (i or 3) then
        bad := bad + 1;
      if d[i * 7919] <> i * 0.5 then
        bad := bad + 1;
    end;
  end;
  WriteLn('growth ', Length(m), ' ', Length(d), ' ', sum, ' ', total:0:1, ' ', bad);
end;

procedure Fuzz;
const
  Space = 500;
var
  m: TIM;
  d: TDM;
  model: array[0..Space - 1] of Integer;
  dmodel: array[0..Space - 1] of Double;
  here, dhere: array[0..Space - 1] of Boolean;
  r, i, k, e, bad, n: Integer;
  x: Double;
begin
  Seed := 4242;
  bad := 0;
  for r := 1 to 200 do
  begin
    New(m);
    New(d);
    for i := 0 to Space - 1 do
    begin
      here[i] := False;
      dhere[i] := False;
      model[i] := 0;
      dmodel[i] := 0;
    end;
    for n := 1 to Rnd(3000) do
    begin
      k := Rnd(Space);
      e := Rnd(2000) - 1000;
      x := (Rnd(2000) - 1000) / 8;
      case Rnd(16) of
        0:
          begin
            m[k * 31] := m[k * 31] and e;
            here[k] := True;
            model[k] := model[k] and e;
          end;
        1:
          begin
            m[k * 31] := m[k * 31] or e;
            here[k] := True;
            model[k] := model[k] or e;
          end;
        2:
          begin
            m[k * 31] := m[k * 31] xor e;
            here[k] := True;
            model[k] := model[k] xor e;
          end;
        3:
          begin
            m[k * 31] := m[k * 31] * e;
            here[k] := True;
            model[k] := model[k] * e;
          end;
        4:
          begin
            m[k * 31] := e and m[k * 31];
            here[k] := True;
            model[k] := e and model[k];
          end;
        5:
          begin
            m[k * 31] := e or m[k * 31];
            here[k] := True;
            model[k] := e or model[k];
          end;
        6:
          begin
            m[k * 31] := e xor m[k * 31];
            here[k] := True;
            model[k] := e xor model[k];
          end;
        7:
          begin
            m[k * 31] := e * m[k * 31] + 1;
            here[k] := True;
            model[k] := e * model[k] + 1;
          end;
        8:
          begin
            Delete(m, k * 31);
            here[k] := False;
            model[k] := 0;
          end;
        9:
          begin
            d[k * 31] := d[k * 31] + x;
            dhere[k] := True;
            dmodel[k] := dmodel[k] + x;
          end;
        10:
          begin
            d[k * 31] := d[k * 31] - x;
            dhere[k] := True;
            dmodel[k] := dmodel[k] - x;
          end;
        11:
          begin
            d[k * 31] := x + d[k * 31];
            dhere[k] := True;
            dmodel[k] := x + dmodel[k];
          end;
        12:
          begin
            d[k * 31] := d[k * 31] * 0.75;
            dhere[k] := True;
            dmodel[k] := dmodel[k] * 0.75;
          end;
        13:
          begin
            d[k * 31] := -1.0 * d[k * 31];
            dhere[k] := True;
            dmodel[k] := -1.0 * dmodel[k];
          end;
        14:
          begin
            d[k * 31] := d[k * 31] + e;
            dhere[k] := True;
            dmodel[k] := dmodel[k] + e;
          end;
        15:
          begin
            Delete(d, k * 31);
            dhere[k] := False;
            dmodel[k] := 0;
          end;
      end;
    end;
    n := 0;
    for i := 0 to Space - 1 do
    begin
      if here[i] then
        n := n + 1;
      if m[i * 31] <> model[i] then
        bad := bad + 1;
    end;
    if Length(m) <> n then
      bad := bad + 1;
    n := 0;
    for i := 0 to Space - 1 do
    begin
      if dhere[i] then
        n := n + 1;
      if d[i * 31] <> dmodel[i] then
        bad := bad + 1;
    end;
    if Length(d) <> n then
      bad := bad + 1;
  end;
  WriteLn('fuzz rounds=200 bad=', bad);
end;

begin
  Bits;
  Times;
  Reals;
  Keys;
  Strings;
  Calling;
  Others;
  Growth;
  Fuzz;
end.
