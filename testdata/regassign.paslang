function MixInteger(n, c: Integer): Integer;
var
  k, s, cnt: Integer;
  v, w: Integer;
begin
  s := 0;
  cnt := 0;
  w := c;
  for k := 0 to n - 1 do
  begin
    v := k * 5 + w;
    w := v xor k;
    s := s + v - w;
    v := v * 3 + k;
    s := s + (v and 255) + (v or 1) - (k xor v);
    if v > 100 then
      cnt := cnt + 1;
    if k < v then
      cnt := cnt + 2;
    if v <= w then
      cnt := cnt + 4;
    v := k - v;
    s := s + v;
  end;
  Result := s + cnt + w;
end;

function EdgeInteger(start: Integer; up: Boolean): Integer;
var
  k, s: Integer;
  v: Integer;
begin
  v := start;
  s := 0;
  for k := 0 to 5 do
  begin
    if up then
      Inc(v)
    else
      Dec(v);
    s := s + v;
  end;
  Result := s;
end;

begin
  WriteLn('Byte ', MixByte(300, 7), ' ', MixByte(70000, -3), ' ', EdgeByte(253, True), ' ', EdgeByte(2, False));
  WriteLn('Word ', MixWord(300, 7), ' ', MixWord(70000, -3), ' ', EdgeWord(65533, True), ' ', EdgeWord(2, False));
  WriteLn('UInt32 ', MixUInt32(300, 7), ' ', MixUInt32(70000, -3), ' ', EdgeUInt32(4294967293, True), ' ', EdgeUInt32(2, False));
  WriteLn('Int8 ', MixInt8(300, 7), ' ', MixInt8(70000, -3), ' ', EdgeInt8(125, True), ' ', EdgeInt8(-126, False));
  WriteLn('Int16 ', MixInt16(300, 7), ' ', MixInt16(70000, -3), ' ', EdgeInt16(32765, True), ' ', EdgeInt16(-32766, False));
  WriteLn('Int32 ', MixInt32(300, 7), ' ', MixInt32(70000, -3), ' ', EdgeInt32(2147483645, True), ' ', EdgeInt32(-2147483646, False));
  WriteLn('Integer ', MixInteger(300, 7), ' ', MixInteger(70000, -3), ' ', EdgeInteger(High(Integer) - 2, True), ' ', EdgeInteger(Low(Integer) + 2, False));
end.
