{ P318: variables a region keeps in registers, of every integer type:
  values of plain steps that do not read the variable worked out in its
  register, values that read it, Inc and Dec at the type's edges, and a
  narrow variable an operand and on either side of a compare from its
  register. scripts/check_regassign.py reads that the loops move no
  value from the pool into a variable's register and no narrow variable
  through rax or x17. Written by a script; the answers are Python's. }
program regassign;

function MixByte(n, c: Integer): Integer;
var
  k, s, cnt: Integer;
  v, w: Byte;
begin
  s := 0;
  cnt := 0;
  w := Byte(c);
  for k := 0 to n - 1 do
  begin
    v := Byte(k * 5 + w);
    w := Byte(v xor k);
    s := s + v - w;
    v := Byte(v * 3 + k);
    s := s + (v and 255) + (v or 1) - (k xor v);
    if v > 100 then
      cnt := cnt + 1;
    if k < v then
      cnt := cnt + 2;
    if v <= w then
      cnt := cnt + 4;
    v := Byte(k - v);
    s := s + v;
  end;
  Result := s + cnt + w;
end;

function EdgeByte(start: Integer; up: Boolean): Integer;
var
  k, s: Integer;
  v: Byte;
begin
  v := Byte(start);
  s := 0;
  for k := 0 to 5 do
  begin
    if up then
      Inc(v)
    else
      Dec(v);
    s := s + v;
  end;
  Result := s;
end;

