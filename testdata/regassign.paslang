    v := Word(v * 3 + k);
    s := s + (v and 255) + (v or 1) - (k xor v);
    if v > 100 then
      cnt := cnt + 1;
    if k < v then
      cnt := cnt + 2;
    if v <= w then
      cnt := cnt + 4;
