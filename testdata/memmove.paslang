program memmove;

{ Move between every source and destination offset, overlapping either
  way, for every size up to 80 and around each step of the copy loops up
  to 4200 bytes, against a byte-by-byte copy (1.0.86). A byte written
  outside the destination, or one read after it was overwritten, shows
  as a difference. }

var
  a, b, t: string;
  checks, bad: Integer;

procedure Fill(var s: string);
var
  k: Integer;
begin
  for k := 1 to Length(s) do
    s[k] := Chr(1 + (k * 7 + k div 251) mod 251);
end;

procedure Buffers(L: Integer);
begin
  a := '';
  b := '';
  t := '';
  SetLength(a, L);
  SetLength(b, L);
  SetLength(t, L);
end;

procedure Check(n, src, dst: Integer);
var
  k: Integer;
  same: Boolean;
begin
  Fill(a);
  Fill(b);
  for k := 0 to n - 1 do
    t[k + 1] := b[src + k];
  for k := 0 to n - 1 do
    b[dst + k] := t[k + 1];
  Move(a[src], a[dst], n);
  same := True;
  for k := 1 to Length(a) do
    if a[k] <> b[k] then
      same := False;
  checks := checks + 1;
  if not same then
  begin
    bad := bad + 1;
    if bad <= 5 then
      WriteLn('wrong: n ', n, ' src ', src, ' dst ', dst);
  end;
end;

procedure Big(n: Integer);
var
  off, src: Integer;
begin
  Buffers(3 * n + 200);
  for off := 0 to 3 do
  begin
    src := n + 60 + off;
    Check(n, src, src - n - 10);
    Check(n, src, src - n);
    Check(n, src, src - n + 1);
    Check(n, src, src - 17);
    Check(n, src, src - 16);
    Check(n, src, src - 15);
    Check(n, src, src - 9);
    Check(n, src, src - 8);
    Check(n, src, src - 7);
    Check(n, src, src - 1);
    Check(n, src, src);
    Check(n, src, src + 1);
    Check(n, src, src + 7);
    Check(n, src, src + 8);
    Check(n, src, src + 9);
    Check(n, src, src + 15);
    Check(n, src, src + 16);
    Check(n, src, src + 17);
    Check(n, src, src + n - 1);
    Check(n, src, src + n);
    Check(n, src, src + n + 10);
  end;
end;

var
  n, off, d: Integer;

begin
  checks := 0;
  bad := 0;
  Buffers(200);
  for n := 0 to 80 do
    for off := 0 to 7 do
      for d := -40 to 40 do
        Check(n, 60 + off, 60 + off + d);
  WriteLn('small: ', checks, ' checks, ', bad, ' wrong');
  for n := 81 to 100 do
    Big(n);
  Big(127);
  Big(128);
  Big(129);
  Big(255);
  Big(256);
  Big(257);
  Big(511);
  Big(512);
  Big(513);
  Big(1023);
  Big(1024);
  Big(1025);
  Big(2047);
  Big(2048);
  Big(2049);
  Big(2055);
  Big(4095);
  Big(4096);
  Big(4097);
  Big(4200);
  WriteLn('all: ', checks, ' checks, ', bad, ' wrong');
end.

