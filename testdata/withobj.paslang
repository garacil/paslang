{ P172: with on an object, as FPC's reference has it (13.2.8): with Obj
  do reaches the object's fields, properties and methods by name, its
  own and its ancestors', with and without arguments, as values with @
  and without, its class variable and class method, ClassName and Free;
  the reference is worked out once, so changing the variable inside does
  not change the object reached; with on a record holding an object and
  on an object holding a record, the innermost first; the object's names
  hide a global's, a local's and Self's; a closure in the with reads the
  object after it. The answers are worked out by hand in the comments.
  testdata/withbad holds the refusals. }
program withobj;

uses paslib;

type
  TBase = class
    Id: Integer;
    function Kind: string; virtual;
  end;

  TBox = class(TBase)
  private
    FCount: Integer;
    procedure SetCount(V: Integer);
  public
    Name: string;
    Total: Integer;
    class var Made: Integer;
    constructor Create(const AName: string; ACount: Integer);
    destructor Destroy;
    procedure Add(K: Integer);
    procedure Bump;
    function Get: Integer;
    function Twice(K: Integer): Integer;
    function Kind: string; override;
    class function Describe: string;
    property Count: Integer read FCount write SetCount;
  end;

  TInner = record
    X, Y: Integer;
  end;

  TOuter = class
    X: Integer;
    Name: string;
    In1: TInner;
    procedure Show(B: TBox);
  end;

  THold = record
    Tag: Integer;
    Box: TBox;
  end;

  TGet = function: Integer of object;
  TAdd = procedure(K: Integer) of object;
  TFn = function: Integer;

var
  Log: string;
  Calls: Integer;
  Total: Integer;

function TBase.Kind: string;
begin
  Result := 'base';
end;

constructor TBox.Create(const AName: string; ACount: Integer);
begin
  Name := AName;
  FCount := ACount;
  Total := 0;
  Made := Made + 1;
end;

destructor TBox.Destroy;
begin
  Log := Log + '-' + Name;
end;

procedure TBox.SetCount(V: Integer);
begin
  FCount := V;
  Log := Log + '=' + IntToStr(V);
end;

procedure TBox.Add(K: Integer);
begin
  Total := Total + K;
end;

procedure TBox.Bump;
begin
  FCount := FCount + 1;
end;

function TBox.Get: Integer;
begin
  Result := Total + FCount;
end;

function TBox.Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

function TBox.Kind: string;
begin
  Result := 'box';
end;

class function TBox.Describe: string;
begin
  Result := 'boxes ' + IntToStr(Made);
end;

{ inside a with on a box, its Name is the box's and X Self's }
procedure TOuter.Show(B: TBox);
begin
  with B do
    WriteLn(Name, ' ', X, ' ', Self.Name);
end;

{ a routine of the name of TBox's Add and a function of its Get's: the
  box's hide them inside a with }
procedure Add(K: Integer);
begin
  Log := Log + '!Add';
end;

function Get: Integer;
begin
  Result := -1000;
end;

function NextBox(B: TBox): TBox;
begin
  Calls := Calls + 1;
  Result := B;
end;

{ the box's Name and Total hide the locals }
procedure Locals(B: TBox);
var
  Name: string;
  Total: Integer;
begin
  Name := 'local';
  Total := -1;
  with B do
    WriteLn(Name, ' ', Total, ' ', Kind, ' ', Describe);
  WriteLn(Name, ' ', Total);
end;

var
  a, b, c: TBox;
  base: TBase;
  h: THold;
  o: TOuter;
  m: TGet;
  p: TAdd;
  f: TFn;

begin
  Log := '';
  Total := 77;
  a := TBox.Create('a', 3);
  b := TBox.Create('b', 10);
  { Total 5, then 5 + 8 = 13; FCount 3 + 1 = 4, then Count := 4 + 2
    sets 6 and logs =6; Get 13 + 6 = 19; Made 2: a 13 6 19 42 box TBox 2 }
  with a do
  begin
    Add(5);
    Add(Twice(4));
    Bump;
    Count := Count + 2;
    Id := 42;
    WriteLn(Name, ' ', Total, ' ', Count, ' ', Get, ' ', Id, ' ', Kind, ' ', ClassName, ' ',
      Made);
  end;
  { the global Total and the global Add untouched: 77 =6 }
  WriteLn(Total, ' ', Log);
  { NextBox once; c changed inside, the box reached is still a's:
    a 113 1 b, then 113 0 }
  Calls := 0;
  c := a;
  with NextBox(c) do
  begin
    c := b;
    Add(100);
    WriteLn(Name, ' ', Total, ' ', Calls, ' ', c.Name);
  end;
  WriteLn(a.Total, ' ', b.Total);
  { a record holding a box, with on both: Add and Total the box's, Tag
    the record's; b.Total 7, Tag 7 + 7: 14 b 7 }
  h.Tag := 7;
  h.Box := b;
  with h, Box do
  begin
    Add(Tag);
    Tag := Tag + Total;
    WriteLn(Tag, ' ', Name, ' ', Total);
  end;
  { an object holding a record: X the object's, then the record's
    inside the inner with: 11 5 15 }
  o := TOuter.Create;
  o.X := 1;
  o.Name := 'outer';
  with o do
  begin
    X := X + 10;
    with In1 do
    begin
      X := 5;
      Y := X * 3;
    end;
    WriteLn(X, ' ', In1.X, ' ', In1.Y);
  end;
  { in a method: a 11 outer }
  o.Show(a);
  { a's method values and a closure kept past the with: p(1) makes
    a.Total 114, m() 114 + 6 = 120, f() 228: 120 228 114 }
  with a do
  begin
    m := @Get;
    p := Add;
    f := function: Integer
    begin
      Result := Total * 2;
    end;
  end;
  p(1);
  WriteLn(m(), ' ', f(), ' ', a.Total);
  { the locals hidden: b 7 box boxes 2, then local -1 }
  Locals(b);
  { an ancestor's type holding a box: the virtual Kind and Id: box 42 }
  base := a;
  with base do
    WriteLn(Kind, ' ', Id);
  { the object made in the with's head, freed in it: Add 2, Get 2 + 1,
    Destroy logs -t; Made 3: t3-t 3 }
  Log := '';
  with TBox.Create('t', 1) do
  try
    Add(2);
    Log := Log + Name + IntToStr(Get);
  finally
    Free;
  end;
  WriteLn(Log, ' ', TBox.Made);
end.

