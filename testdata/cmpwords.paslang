{ CompareByte and IndexByte (P147), Free Pascal's System words on the
  processor's kernels; the output is Free Pascal's. }
program cmpwords;
var
  a, b: string;
  x, y: array[0..99] of Byte;
  i: Integer;
begin
  a := 'hello world';
  b := 'hello there';
  WriteLn(CompareByte(a[1], b[1], 5), ' ', CompareByte(a[1], b[1], 7), ' ', CompareByte(b[1], a[1], 7),
    ' ', CompareByte(a[1], b[1], 0));
  WriteLn(IndexByte(a[1], Length(a), Ord('o')), ' ', IndexByte(a[1], Length(a), Ord('z')), ' ',
    IndexByte(a[1], 4, Ord('o')), ' ', IndexByte(a[7], 5, Ord('d')));
  for i := 0 to 99 do
  begin
    x[i] := Byte(i);
    y[i] := Byte(i);
  end;
  WriteLn(CompareByte(x, y, 100));
  y[77] := 200;
  WriteLn(CompareByte(x, y, 100), ' ', CompareByte(y, x, 100), ' ', CompareByte(x, y, 77));
  WriteLn(IndexByte(y, 100, 200), ' ', IndexByte(x[50], 50, 60));
end.

