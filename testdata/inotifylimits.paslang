program inotifylimits;
uses pasinotify, sysutils;
var
  root, pending: string;
  watcher: TInotify;
  completed: waitgroup;
  stopInstead: Boolean;

procedure MakeFile(const Name: string);
var
  handle: THandle;
  bytes: TBytes;
begin
  handle := FileCreate(Name);
  if handle < 0 then Halt(8);
  SetLength(bytes, 1);
  bytes[0] := 120;
  if FileWrite(handle, bytes, 1) <> 1 then Halt(8);
  FileClose(handle);
end;

procedure Later;
begin
  Sleep(50);
  if stopInstead then watcher.Dispose else MakeFile(pending);
  completed.Done;
end;

procedure Delayed(const LabelText: string; Timeout: Integer; Stop: Boolean);
var
  event: TInotifyEvent;
  answer: Boolean;
  started, elapsed: Integer;
begin
  ForceDirectories(root + '/' + LabelText);
  watcher := TInotify.Create;
  if not watcher.Valid then Halt(9);
  if watcher.Add(root + '/' + LabelText, [ikCreate]) < 0 then Halt(9);
  pending := root + '/' + LabelText + '/ready';
  stopInstead := Stop;
  completed.Add(1);
  pas Later;
  started := Nanotime;
  answer := watcher.Next(event, Timeout);
  elapsed := Nanotime - started;
  completed.Wait;
  WriteLn(LabelText, ' event ', answer, ' waited ', elapsed >= 20000000,
    ' clean ', watcher.Error = 0);
  if answer and ((event.Name <> 'ready') or (event.Kinds <> [ikCreate])) then Halt(10);
  watcher.Free;
end;

var
  event: TInotifyEvent;
  wd: Integer;
  answer: Boolean;
  error: TSysError;
begin
  if ParamCount > 1 then Halt(2);
  if ParamCount = 0 then
  begin
    if not TryCreateTempDirectoryAt(CurrentDirectoryHandle, '',
      'paslang-inotify-limits-*', root, error) then Halt(2);
  end
  else
  begin
    root := ParamStr(1);
    if not TryCreateDirectoryAt(CurrentDirectoryHandle, root, 448, error) then Halt(2);
  end;
  Delayed('normal', 1000, False);
  Delayed('large', High(Integer), False);
  Delayed('sum-large', High(Integer) div 1000000, False);
  Delayed('normal-stop', 1000, True);
  Delayed('large-stop', High(Integer), True);

  ForceDirectories(root + '/literal');
  watcher := TInotify.Create;
  if not watcher.Valid then Halt(9);
  wd := watcher.Add(root + '/literal' + #0 + '/absent', [ikCreate]);
  WriteLn('nul rejected ', wd = -1, ' errno22 ', watcher.Error = 22);
  MakeFile(root + '/literal/hidden');
  WriteLn('nul installed watch ', watcher.Next(event, 20));
  wd := watcher.Add(root + '/literal', [ikCreate]);
  if wd < 0 then Halt(9);
  MakeFile(root + '/literal/visible');
  answer := watcher.Next(event, 1000);
  WriteLn('literal path ', answer and (event.Name = 'visible') and (event.Kinds = [ikCreate]),
    ' clean ', watcher.Error = 0);

  wd := watcher.Add(root + '/missing', [ikCreate]);
  WriteLn('failed add ', wd = -1, ' enoent ', watcher.Error = 2);
  MakeFile(root + '/literal/error-reset');
  answer := watcher.Next(event, 1000);
  WriteLn('success clears error ', answer and (event.Name = 'error-reset'), ' clean ', watcher.Error = 0);
  wd := watcher.Add(root + '/missing', [ikCreate]);
  WriteLn('failed add again ', wd = -1, ' enoent ', watcher.Error = 2);
  answer := watcher.Next(event, 10);
  WriteLn('timeout ', answer, ' clean ', watcher.Error = 0);
  watcher.Free;
  Delayed('infinite', -1, False);
  Delayed('infinite-stop', -1, True);
  if not RemoveAll(root) then Halt(11);
end.
