program inotifylimits;
uses pasinotify, paslib, sysutils;
var
  root, pending: string;
  watcher: TInotify;
  completed: waitgroup;
  stopInstead: Boolean;

procedure MakeFile(const Name: string);
var
  handle: THandle;
  bytes: TBytes;
begin
  handle := FileCreate(Name);
  if handle < 0 then Halt(8);
  SetLength(bytes, 1);
  bytes[0] := 120;
  if FileWrite(handle, bytes, 1) <> 1 then Halt(8);
  FileClose(handle);
end;

procedure Later;
begin
  Sleep(50);
  if stopInstead then watcher.Dispose else MakeFile(pending);
  completed.Done;
end;

procedure Delayed(const LabelText: string; Timeout: Integer; Stop: Boolean);
var
  event: TInotifyEvent;
  answer: Boolean;
  started, elapsed: Integer;
begin
  ForceDirectories(root + '/' + LabelText);
  watcher := TInotify.Create;
  if not watcher.Valid then Halt(9);
  if watcher.Add(root + '/' + LabelText, [ikCreate]) < 0 then Halt(9);
  pending := root + '/' + LabelText + '/ready';
  stopInstead := Stop;
  completed.Add(1);
  pas Later;
  started := Nanotime;
  answer := watcher.Next(event, Timeout);
  elapsed := Nanotime - started;
  completed.Wait;
  WriteLn(LabelText, ' event ', answer, ' waited ', elapsed >= 20000000,
    ' clean ', watcher.Error = 0);
  if answer and ((event.Name <> 'ready') or (event.Kinds <> [ikCreate])) then Halt(10);
  watcher.Free;
end;

procedure AccessAndCookie;
var
  watch: TInotify;
  event: TInotifyEvent;
  fileName, path, data: string;
  descriptor, oracle, watchNr, initNr, readNr, closeNr, count: Integer;
  raw: array[0..127] of Byte;
begin
  path := root + '/access';
  if not ForceDirectories(path) then Halt(20);
  fileName := path + '/opened';
  MakeFile(fileName);
  watch := TInotify.Create;
  try
    if not watch.Valid then Halt(21);
    if (watch.Add(fileName, []) <> -1) or (watch.Error <> 22) then Halt(22);
    descriptor := watch.Add(fileName, [ikAccess]);
    if (descriptor <= 0) or (watch.Error <> 0) then Halt(23);
    if (not ReadFile(fileName, data)) or (data <> 'x') then Halt(24);
    if not watch.Next(event, 500) or (event.Watch <> descriptor) or
      (event.Kinds <> [ikAccess]) or (event.Name <> '') or (event.Cookie <> 0) or
      (InotifyKindsText(event.Kinds) <> 'access') then Halt(25);

    { A second inotify group decodes the same kernel rename cookie directly.
      The two event records arrive together because RenameFile has returned. }
    if Amd64 = 1 then
    begin
      initNr := 294;
      watchNr := 254;
      readNr := 0;
      closeNr := 3;
    end
    else
    begin
      initNr := 26;
      watchNr := 27;
      readNr := 63;
      closeNr := 57;
    end;
    oracle := Syscall(initNr, 2048 or 524288);
    if oracle < 0 then Halt(26);
    try
      data := path + #0;
      if Syscall(watchNr, oracle, @data[1], 64 or 128) <= 0 then Halt(27);
      descriptor := watch.Add(path, [ikMovedFrom, ikMovedTo]);
      if (descriptor <= 0) or not RenameFile(fileName, path + '/renamed') then Halt(28);
      count := Syscall(readNr, oracle, @raw[0], SizeOf(raw));
      if (count <> 64) or (PUInt32(@raw[4])^ <> 64) or (PUInt32(@raw[36])^ <> 128) then Halt(29);
      if not watch.Next(event, 500) or (event.Kinds <> [ikMovedFrom]) or
        (event.Watch <> descriptor) or (event.Name <> 'opened') or
        (event.Cookie <> PUInt32(@raw[8])^) then Halt(30);
      if not watch.Next(event, 500) or (event.Kinds <> [ikMovedTo]) or
        (event.Watch <> descriptor) or (event.Name <> 'renamed') or
        (event.Cookie <> PUInt32(@raw[40])^) then Halt(31);
    finally
      Syscall(closeNr, oracle);
    end;
  finally
    watch.Free;
  end;
end;

var
  event: TInotifyEvent;
  wd: Integer;
  answer: Boolean;
  error: TSysError;
begin
  if ParamCount > 1 then Halt(2);
  if ParamCount = 0 then
  begin
    if not TryCreateTempDirectoryAt(CurrentDirectoryHandle, '',
      'paslang-inotify-limits-*', root, error) then Halt(2);
  end
  else
  begin
    root := ParamStr(1);
    if not TryCreateDirectoryAt(CurrentDirectoryHandle, root, 448, error) then Halt(2);
  end;
  Delayed('normal', 1000, False);
  Delayed('large', High(Integer), False);
  Delayed('sum-large', High(Integer) div 1000000, False);
  Delayed('normal-stop', 1000, True);
  Delayed('large-stop', High(Integer), True);

  ForceDirectories(root + '/literal');
  watcher := TInotify.Create;
  if not watcher.Valid then Halt(9);
  wd := watcher.Add(root + '/literal' + #0 + '/absent', [ikCreate]);
  WriteLn('nul rejected ', wd = -1, ' errno22 ', watcher.Error = 22);
  MakeFile(root + '/literal/hidden');
  WriteLn('nul installed watch ', watcher.Next(event, 20));
  wd := watcher.Add(root + '/literal', [ikCreate]);
  if wd < 0 then Halt(9);
  MakeFile(root + '/literal/visible');
  answer := watcher.Next(event, 1000);
  WriteLn('literal path ', answer and (event.Name = 'visible') and (event.Kinds = [ikCreate]),
    ' clean ', watcher.Error = 0);

  wd := watcher.Add(root + '/missing', [ikCreate]);
  WriteLn('failed add ', wd = -1, ' enoent ', watcher.Error = 2);
  MakeFile(root + '/literal/error-reset');
  answer := watcher.Next(event, 1000);
  WriteLn('success clears error ', answer and (event.Name = 'error-reset'), ' clean ', watcher.Error = 0);
  wd := watcher.Add(root + '/missing', [ikCreate]);
  WriteLn('failed add again ', wd = -1, ' enoent ', watcher.Error = 2);
  answer := watcher.Next(event, 10);
  WriteLn('timeout ', answer, ' clean ', watcher.Error = 0);

  wd := watcher.Add(root + '/literal', [ikCreate]);
  if wd < 0 then Halt(9);
  answer := watcher.Remove(-1);
  WriteLn('failed remove ', not answer, ' einval ', watcher.Error = 22);
  answer := watcher.Remove(wd);
  WriteLn('removed ', answer, ' clean ', watcher.Error = 0);
  answer := watcher.Next(event, 1000);
  WriteLn('ignored ', answer and (event.Kinds = [ikIgnored]) and (event.Watch = wd));
  wd := watcher.Add(root + '/missing', [ikCreate]);
  if (wd <> -1) or (watcher.Error <> 2) then Halt(9);
  wd := watcher.Add(root + '/literal', [ikCreate]);
  WriteLn('added again ', wd >= 0, ' clean ', watcher.Error = 0);
  watcher.Free;
  Delayed('infinite', -1, False);
  Delayed('infinite-stop', -1, True);
  AccessAndCookie;
  if not RemoveAll(root) then Halt(11);
end.
