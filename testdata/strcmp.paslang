{ P74: strings compare by what they say, not by where they sit. The
  four relations go through rt_strcmp, which walks both strings byte by
  byte; when one is a prefix of the other the shorter one comes first.
  Two literals, two variables and two array elements must all agree,
  and a list of names must sort. }
program strcmp;

var
  a: array of string;
  x, y, t: string;
  i, j: Integer;

begin
  { Two variables. Before P74 this compared the addresses, so both
    answers came out the same. }
  x := 'two';
  y := 'one';
  WriteLn(x < y, ' ', y < x, ' ', x > y, ' ', y > x);

  { Array elements, which is where the addresses ran the other way. }
  SetLength(a, 2);
  a[0] := 'two';
  a[1] := 'one';
  WriteLn(a[0] < a[1], ' ', a[1] < a[0]);

  { Literals. }
  WriteLn('abc' < 'abd', ' ', 'abd' < 'abc', ' ', 'abc' = 'abc');

  { A prefix comes first, and equal strings are neither less nor more. }
  WriteLn('ab' < 'abc', ' ', 'abc' < 'ab', ' ', 'abc' <= 'abc', ' ',
    'abc' >= 'abc', ' ', 'abc' < 'abc');

  { The six relations agree with one another. }
  x := 'alpha';
  y := 'beta';
  WriteLn(x < y, ' ', x <= y, ' ', x > y, ' ', x >= y, ' ', x = y, ' ',
    x <> y);

  { Case is the byte value: the capitals come first. }
  WriteLn('Z' < 'a', ' ', 'a' < 'z', ' ', '' < 'a', ' ', 'a' < '');

  { A list of names sorts. }
  SetLength(a, 5);
  a[0] := 'pear';
  a[1] := 'apple';
  a[2] := 'fig';
  a[3] := 'apricot';
  a[4] := 'date';
  for i := 0 to High(a) do
    for j := i + 1 to High(a) do
      if a[j] < a[i] then
      begin
        t := a[i];
        a[i] := a[j];
        a[j] := t;
      end;
  t := '';
  for i := 0 to High(a) do
    t := t + a[i] + ' ';
  WriteLn(t);
end.

