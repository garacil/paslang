{ P432: pasurl against Go's net/url. testdata/url.txt (scripts/url_corpus.py
  writes it) holds 1,232 strings and what Go makes of each: Parse and
  ParseRequestURI (the parts of the URL, String, EscapedPath, RequestURI,
  Hostname, Port, or the error text), the string resolved against three
  bases, and its query parsed and encoded. The same cells are made here and
  compared; only the lines that differ are written, then the counts. Then
  the writer's own cases: escaping in each mode, query values, a URL built
  and written, the references of RFC 3986, 5.4. }
program url;

uses
  sysutils, pascodec, pasurl;

const
  HexDigits: string = '0123456789abcdef';

function Q(const S: string): string;
var
  i: Integer;
  c: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
  begin
    c := Ord(S[i]);
    if (c > 32) and (c < 127) and (c <> 124) then
      Result := Result + S[i]
    else
      Result := Result + '\x' + HexDigits[(c shr 4) + 1] + HexDigits[(c and 15) + 1];
  end;
  if Result = '' then
    Result := '-';
end;

function Bit(V: Boolean): string;
begin
  if V then
    Result := '1'
  else
    Result := '0';
end;

function Dump(const U: TUrl; Ok: Boolean; const Err: string): string;
begin
  if not Ok then
  begin
    Result := 'err|' + Q(Err);
    Exit;
  end;
  Result := 'ok|' + Q(U.Scheme) + '|' + Q(U.Opaque) + '|' + Bit(U.HasUser) + '|' + Q(U.User) + '|' + Bit(U.HasPassword) + '|' +
    Q(U.Password) + '|' + Q(U.Host) + '|' + Q(U.Path) + '|' + Q(U.RawPath) + '|' + Q(U.RawQuery) + '|' + Q(U.Fragment) + '|' +
    Q(U.RawFragment) + '|' + Bit(U.ForceQuery) + '|' + Bit(U.OmitHost) + '|' + Q(UrlString(U)) + '|' + Q(UrlEscapedPath(U)) + '|' +
    Q(UrlRequestURI(U)) + '|' + Q(UrlHostname(U)) + '|' + Q(UrlPort(U));
end;

function Verdict(const Raw: string; const Bases: array of TUrl): string;
var
  u, u2, r: TUrl;
  ok, ok2: Boolean;
  err, err2, qe: string;
  i: Integer;
  v: TUrlValues;
begin
  ok := UrlParse(Raw, u, err);
  Result := Dump(u, ok, err);
  ok2 := UrlParseRequestURI(Raw, u2, err2);
  Result := Result + '|' + Dump(u2, ok2, err2);
  for i := 0 to High(Bases) do
    if ok then
    begin
      r := UrlResolve(Bases[i], u);
      Result := Result + '|' + Q(UrlString(r));
    end
    else
      Result := Result + '|-';
  if not ok then
    Result := Result + '|-'
  else
  begin
    v := TUrlValues.Create;
    qe := UrlParseQuery(u.RawQuery, v);
    Result := Result + '|' + Q(v.Encode) + '|' + Q(qe);
  end;
end;

procedure Resolve(const Base, Ref: string);
var
  b, r: TUrl;
  err: string;
begin
  if not UrlParse(Base, b, err) then
  begin
    WriteLn('bad base ', Base, ': ', err);
    Exit;
  end;
  if UrlParseRef(b, Ref, r, err) then
    WriteLn('  ', Ref, ' -> ', UrlString(r))
  else
    WriteLn('  ', Ref, ' -> error: ', err);
end;

var
  corpus, line, id, raw, want, got: string;
  p, q1, nl, count, bad, i: Integer;
  bases: array of TUrl;
  e: string;
  vals: TUrlValues;
  u: TUrl;
  all: TStringArray;
begin
  SetLength(bases, 3);
  UrlParse('http://a/b/c/d;p?q', bases[0], e);
  UrlParse('http://user:pw@h:81/x/y/', bases[1], e);
  UrlParse('mailto:x@y.z', bases[2], e);
  if not ReadFile('testdata/url.txt', corpus) then
  begin
    WriteLn('no testdata/url.txt');
    Halt(2);
  end;
  p := 1;
  count := 0;
  bad := 0;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    q1 := Pos(' ', line);
    id := Copy(line, 1, q1 - 1);
    line := Copy(line, q1 + 1, Length(line) - q1);
    q1 := Pos(' ', line);
    if Copy(line, 1, q1 - 1) = '-' then
      raw := ''
    else if not Base64Decode(Copy(line, 1, q1 - 1), False, True, raw) then
    begin
      WriteLn('bad base64 ', id);
      Halt(2);
    end;
    want := Copy(line, q1 + 1, Length(line) - q1);
    got := Verdict(raw, bases);
    if got <> want then
    begin
      bad := bad + 1;
      if bad <= 12 then
      begin
        WriteLn('DIFFERS ', id, ' [', Q(raw), ']');
        WriteLn('  go   ', want);
        WriteLn('  here ', got);
      end;
    end;
    count := count + 1;
  end;
  WriteLn('strings ', count, ', differ from Go ', bad);
  { RFC 3986, 5.4: the references against http://a/b/c/d;p?q }
  WriteLn('RFC 3986 5.4.1:');
  Resolve('http://a/b/c/d;p?q', 'g:h');
  Resolve('http://a/b/c/d;p?q', 'g');
  Resolve('http://a/b/c/d;p?q', './g');
  Resolve('http://a/b/c/d;p?q', 'g/');
  Resolve('http://a/b/c/d;p?q', '/g');
  Resolve('http://a/b/c/d;p?q', '//g');
  Resolve('http://a/b/c/d;p?q', '?y');
  Resolve('http://a/b/c/d;p?q', 'g?y');
  Resolve('http://a/b/c/d;p?q', '#s');
  Resolve('http://a/b/c/d;p?q', 'g#s');
  Resolve('http://a/b/c/d;p?q', 'g?y#s');
  Resolve('http://a/b/c/d;p?q', ';x');
  Resolve('http://a/b/c/d;p?q', 'g;x');
  Resolve('http://a/b/c/d;p?q', 'g;x?y#s');
  Resolve('http://a/b/c/d;p?q', '');
  Resolve('http://a/b/c/d;p?q', '.');
  Resolve('http://a/b/c/d;p?q', './');
  Resolve('http://a/b/c/d;p?q', '..');
  Resolve('http://a/b/c/d;p?q', '../');
  Resolve('http://a/b/c/d;p?q', '../g');
  Resolve('http://a/b/c/d;p?q', '../..');
  Resolve('http://a/b/c/d;p?q', '../../');
  Resolve('http://a/b/c/d;p?q', '../../g');
  Resolve('http://a/b/c/d;p?q', '../../../g');
  Resolve('http://a/b/c/d;p?q', '/./g');
  Resolve('http://a/b/c/d;p?q', '/../g');
  Resolve('http://a/b/c/d;p?q', 'g.');
  Resolve('http://a/b/c/d;p?q', '.g');
  Resolve('http://a/b/c/d;p?q', 'g..');
  Resolve('http://a/b/c/d;p?q', '..g');
  Resolve('http://a/b/c/d;p?q', './../g');
  Resolve('http://a/b/c/d;p?q', './g/.');
  Resolve('http://a/b/c/d;p?q', 'g/./h');
  Resolve('http://a/b/c/d;p?q', 'g/../h');
  Resolve('http://a/b/c/d;p?q', 'g;x=1/./y');
  Resolve('http://a/b/c/d;p?q', 'g;x=1/../y');
  Resolve('http://a/b/c/d;p?q', 'http:g');
  { escaping }
  WriteLn('escape:');
  WriteLn('  query  ', UrlEscape('a b&c=d/é?+~', umQueryComponent));
  WriteLn('  path   ', UrlEscape('a b&c=d/é?+~;,', umPathSegment));
  WriteLn('  path   ', UrlEscape('a b&c=d/é?+~;,', umPath));
  WriteLn('  user   ', UrlEscape('us:er@ho/st?', umUserPassword));
  WriteLn('  host   ', UrlEscape('[::1]:80 é', umHost));
  WriteLn('  frag   ', UrlEscape('a b!(*)''#é', umFragment));
  if UrlUnescape('a%20b+c%2', umQueryComponent, raw, e) then
    WriteLn('  unescape ', raw)
  else
    WriteLn('  unescape: ', e);
  if UrlUnescape('a%20b+c%41', umQueryComponent, raw, e) then
    WriteLn('  unescape ', raw);
  if UrlUnescape('a%20b+c%41', umPathSegment, raw, e) then
    WriteLn('  unescape ', raw);
  { query values }
  vals := TUrlValues.Create;
  e := UrlParseQuery('b=2&a=1&b=3&c=%7B&d=x;y&e=%zz&f', vals);
  WriteLn('values: ', vals.Count, ' keys, error [', e, ']');
  all := vals.GetAll('b');
  WriteLn('  b ', Length(all), ' ', vals.Get('b'), ' ', vals.Get('a'), ' ', vals.Has('c'), ' ', vals.Has('zz'), ' [', vals.Get('f'), ']');
  vals.Add('k', 'v w');
  vals.SetValue('a', 'x&y');
  vals.Del('c');
  WriteLn('  ', vals.Encode);
  { a URL built and written }
  u.Scheme := 'https';
  u.HasUser := True;
  u.User := 'ana';
  u.HasPassword := True;
  u.Password := 'p@ss';
  u.Host := 'example.com:8443';
  u.Path := '/a b/ñ';
  u.RawPath := '';
  u.RawQuery := 'q=1';
  u.Fragment := 'f g';
  u.RawFragment := '';
  u.Opaque := '';
  u.ForceQuery := False;
  u.OmitHost := False;
  WriteLn('built: ', UrlString(u), ' ', UrlRequestURI(u), ' ', UrlHostname(u), ' ', UrlPort(u), ' ', UrlIsAbs(u));
end.
