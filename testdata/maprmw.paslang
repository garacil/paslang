program maprmw;

{ P555: m[K] := m[K] + E, m[K] := E + m[K], m[K] := m[K] - E, Inc and Dec of
  a map entry of a word-sized integer are worked out with one lookup: E
  first, then the entry where the put leaves it, changed in place. This
  checks what the two lookups gave: a key that is not there is made with
  zero first, the swapped form and the difference with the entry on the
  right, keys that are expressions, fields, pointers, elements and strings
  (a literal and a variable), a call in the key (made twice, as before), a
  call in E that writes the entry or the map (the entry was read first), E
  that reads the entry, the wrap of the largest number, entries of other
  sizes and sorts, the growth of the map under the statement, and random
  operations against a model. The expected lines are worked out by
  scripts/gen_maprmw.py. }

uses sysutils;

type
  TIM = map[Integer] of Integer;
  TSI = map[string] of Integer;
  TBM = map[Integer] of Byte;
  TWM = map[Integer] of Word;
  T3M = map[Integer] of Int32;
  T6M = map[Integer] of Int64;
  TLM = map[Integer] of LongInt;
  TDM = map[Integer] of Double;
  TUM = map[Integer] of UInt64;
  THolder = record
    N: Integer;
    M: TIM;
  end;
  PHolder = ^THolder;

var
  Calls: Integer;
  Glob: TIM;
  Seed: Integer;

function F(k: Integer): Integer;
begin
  Calls := Calls + 1;
  Result := k;
end;

{ writes the entry it is added to, and grows the map }
function G(k: Integer): Integer;
var
  i: Integer;
begin
  Glob[k] := 1000;
  for i := 1 to 200 do
    Glob[100000 + i] := i;
  Result := 5;
end;

function Rnd(n: Integer): Integer;
begin
  Seed := Seed * 6364136223846793005 + 1442695040888963407;
  Result := (Seed shr 33) mod n;
end;

{ five updates of one entry: five lookups now, each a put }
procedure Upd(m: TIM; k, n: Integer);
begin
  m[k] := m[k] + n;
  Inc(m[k]);
  Dec(m[k], n);
  m[k] := n + m[k];
  m[k] := m[k] - 3;
end;

procedure Basic;
var
  m, m2: TIM;
  k, n: Integer;
begin
  New(m);
  New(m2);
  k := 5;
  n := 7;
  m[k] := m[k] + n;
  WriteLn('absent add ', m[k], ' ', Length(m));
  m[6] := m[6] - 7;
  WriteLn('absent sub ', m[6], ' ', Length(m));
  m[k] := m[k] + 1;
  Inc(m[k]);
  Inc(m[k], 10);
  Dec(m[k]);
  Dec(m[k], 3);
  WriteLn('present ', m[k]);
  m[k] := n + m[k];
  WriteLn('swapped ', m[k]);
  m[k] := m[k] - n;
  WriteLn('difference ', m[k]);
  m[k] := n - m[k];
  WriteLn('reversed ', m[k]);
  m[k] := m[k] + m[k];
  WriteLn('doubled ', m[k]);
  m[k] := m[k] + m[6];
  WriteLn('other entry ', m[k]);
  m[k] := m[k] - (n * 3 - 4);
  WriteLn('expression ', m[k]);
  m[9] := m[9] + m[9];
  WriteLn('absent doubled ', m[9], ' ', Length(m));
  Upd(m, 77, 4);
  WriteLn('routine ', m[77], ' ', Length(m));
  m[21] := 100;
  m[20] := m[21] + 3;
  m[21] := m[22] - 2;
  WriteLn('other keys ', m[20], ' ', m[21], ' ', m[22], ' ', Length(m));
  m2[k] := m[k] + 1;
  m2[k] := m2[k] + m[k];
  WriteLn('two maps ', m2[k], ' ', m[k], ' ', Length(m2));
end;

procedure Keys;
var
  m: TIM;
  a: array[0..4] of Integer;
  rec: THolder;
  p: PHolder;
  recs: array[0..2] of THolder;
  i, j, k: Integer;
begin
  New(m);
  for i := 0 to 4 do
    a[i] := i * 11;
  for i := 1 to 20 do
  begin
    j := i mod 5;
    m[a[j]] := m[a[j]] + i;
    m[i * 3 + 1] := m[i * 3 + 1] + 2;
    m[j + 100] := m[j + 100] - i;
  end;
  k := 0;
  for i := 0 to 4 do
    k := k + m[a[i]] * (i + 1);
  WriteLn('keys ', k, ' ', Length(m), ' ', m[0], ' ', m[44], ' ', m[102], ' ', m[61]);
  New(rec.M);
  rec.M[3] := rec.M[3] + 4;
  rec.M[3] := rec.M[3] + 4;
  New(p);
  New(p^.M);
  p^.M[3] := p^.M[3] - 4;
  Inc(p^.M[3], 9);
  for i := 0 to 2 do
  begin
    New(recs[i].M);
    for j := 1 to 5 do
      recs[i].M[j] := recs[i].M[j] + i * j;
  end;
  WriteLn('fields ', rec.M[3], ' ', p^.M[3], ' ', recs[2].M[5], ' ', recs[1].M[4], ' ', recs[0].M[3]);
end;

procedure Strings;
var
  s: TSI;
  words: array[0..7] of string;
  w: string;
  i, n, total, cnt: Integer;
  counts: array[0..7] of Integer;
begin
  words[0] := 'the';
  words[1] := 'quick';
  words[2] := 'brown';
  words[3] := 'fox';
  words[4] := 'jumps';
  words[5] := 'over';
  words[6] := 'lazy';
  words[7] := 'dog';
  New(s);
  for i := 0 to 7 do
    counts[i] := 0;
  for n := 1 to 5000 do
  begin
    i := (n * 7 + n div 3) mod 8;
    w := words[i];
    s[w] := s[w] + 1;
    counts[i] := counts[i] + 1;
  end;
  s['literal'] := s['literal'] + 4;
  Inc(s['literal'], 5);
  Dec(s['other']);
  total := 0;
  cnt := 0;
  for i := 0 to 7 do
    if s[words[i]] = counts[i] then
      cnt := cnt + 1;
  for w, n in s do
    total := total + n;
  WriteLn('strings ', cnt, ' ', total, ' ', s['literal'], ' ', s['other'], ' ', Length(s));
  s['y'] := 10;
  s['x'] := s['y'] + 5;
  s['y'] := s['x'] - 1;
  WriteLn('string keys ', s['x'], ' ', s['y'], ' ', Length(s));
  w := 'q';
  s['q'] := 4;
  s[''] := 10;
  s[w] := s[''] + 1;
  WriteLn('literal and variable ', s['q'], ' ', s['']);
end;

procedure Calling;
var
  m: TIM;
  k: Integer;
begin
  New(m);
  Calls := 0;
  m[F(4)] := m[F(4)] + 3;
  WriteLn('call in the key ', m[4], ' ', Calls);
  k := 4;
  m[k] := m[k] + F(2);
  WriteLn('call in E ', m[4], ' ', Calls);
  Glob := m;
  m[k] := m[k] + G(k);
  WriteLn('E writes the entry ', m[4], ' ', Length(m));
  m[k] := G(k) + m[k];
  WriteLn('E first, the entry later ', m[4]);
end;

procedure Wrap;
var
  m: TIM;
  u: TUM;
  k: Integer;
begin
  New(m);
  New(u);
  k := 1;
  m[k] := High(Int64);
  m[k] := m[k] + 1;
  WriteLn('wrap up ', m[k]);
  m[k] := m[k] - 1;
  WriteLn('wrap down ', m[k]);
  u[k] := 0;
  u[k] := u[k] - 1;
  WriteLn('unsigned ', u[k] shr 63, ' ', u[k] and 255);
  u[k] := u[k] + 2;
  WriteLn('unsigned back ', u[k] shr 63, ' ', u[k] and 255);
end;

procedure Others;
var
  b: TBM;
  w: TWM;
  i3: T3M;
  i6: T6M;
  l: TLM;
  d: TDM;
  k: Integer;
  sr: 1..9;
begin
  New(b);
  New(w);
  New(i3);
  New(i6);
  New(l);
  New(d);
  for k := 1 to 300 do
  begin
    b[k mod 3] := b[k mod 3] + 1;
    l[k mod 3] := l[k mod 3] + 1000000000;
    d[k mod 3] := d[k mod 3] + 0.5;
    d[k mod 3] := d[k mod 3] + k;
  end;
  for k := 1 to 1000 do
  begin
    b[7] := b[7] + 1;
    w[7] := w[7] + 100;
    w[8] := w[8] - 1;
  end;
  for k := 1 to 10 do
  begin
    i3[7] := i3[7] + 1000000000;
    i3[8] := i3[8] - 1000000000;
    i6[7] := i6[7] - 5;
  end;
  sr := 9;
  i6[8] := i6[8] + sr;
  Inc(i6[8], sr);
  WriteLn('narrow ', b[7], ' ', w[7], ' ', w[8], ' ', i3[7], ' ', i3[8], ' ', i6[7], ' ', i6[8], ' ', b[0], ' ', b[1], ' ', Length(b));
  WriteLn('byte ', b[0], ' ', b[1], ' ', b[2]);
  WriteLn('long ', l[0], ' ', l[1], ' ', l[2]);
  WriteLn('double ', d[0]:0:1, ' ', d[1]:0:1, ' ', d[2]:0:1);
end;

procedure Growth;
var
  m: TIM;
  i, sum, bad: Integer;
begin
  New(m);
  for i := 1 to 200000 do
    m[i * 7919] := m[i * 7919] + i;
  for i := 1 to 200000 do
    m[i * 7919] := m[i * 7919] + i;
  for i := 1 to 200000 do
    if i mod 3 = 0 then
      Dec(m[i * 7919], 2 * i);
  sum := 0;
  bad := 0;
  for i := 1 to 200000 do
  begin
    sum := sum + m[i * 7919];
    if i mod 3 = 0 then
    begin
      if m[i * 7919] <> 0 then
        bad := bad + 1;
    end
    else if m[i * 7919] <> 2 * i then
      bad := bad + 1;
  end;
  WriteLn('growth ', Length(m), ' ', sum, ' ', bad);
end;

procedure Fuzz;
const
  Space = 500;
var
  m: TIM;
  model: array[0..Space - 1] of Integer;
  here: array[0..Space - 1] of Boolean;
  r, i, k, d, bad, n: Integer;
begin
  Seed := 777;
  bad := 0;
  for r := 1 to 200 do
  begin
    New(m);
    for i := 0 to Space - 1 do
    begin
      here[i] := False;
      model[i] := 0;
    end;
    for n := 1 to Rnd(3000) do
    begin
      k := Rnd(Space);
      d := Rnd(1000) - 500;
      case Rnd(6) of
        0:
          begin
            m[k * 31] := m[k * 31] + d;
            here[k] := True;
            model[k] := model[k] + d;
          end;
        1:
          begin
            m[k * 31] := m[k * 31] - d;
            here[k] := True;
            model[k] := model[k] - d;
          end;
        2:
          begin
            Inc(m[k * 31], d);
            here[k] := True;
            model[k] := model[k] + d;
          end;
        3:
          begin
            m[k * 31] := d;
            here[k] := True;
            model[k] := d;
          end;
        4:
          begin
            Delete(m, k * 31);
            here[k] := False;
            model[k] := 0;
          end;
        5:
          begin
            m[k * 31] := d + m[k * 31];
            here[k] := True;
            model[k] := model[k] + d;
          end;
      end;
    end;
    n := 0;
    for i := 0 to Space - 1 do
    begin
      if here[i] then
        n := n + 1;
      if m[i * 31] <> model[i] then
        bad := bad + 1;
    end;
    if Length(m) <> n then
      bad := bad + 1;
  end;
  WriteLn('fuzz rounds=200 bad=', bad);
end;

begin
  Basic;
  Keys;
  Strings;
  Calling;
  Wrap;
  Others;
  Growth;
  Fuzz;
end.
