{ P483: Format reads a directive that is a letter or a precision and a letter
  where it lies, a width of up to nine digits without a copy, and writes %f
  from the digits of the value straight into the text. The expected output
  was made by the compiler before: fixed formats with fixed arguments, then a
  hundred and fifty thousand formats made of pieces (literal text, a percent
  sign, an index, a minus, a width of digits or a star, a precision, a letter)
  applied to six sets of arguments, the text or the message of the error folded
  into a hash. }
program fmtfast;

uses
  sysutils;

var
  h: Int64;
  seed: Int64;
  Reals: array[0..22] of Double;

function Next: Int64;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := seed;
end;

procedure Mix(const S: string);
var
  i: Integer;
begin
  h := h * 1000003 + Length(S);
  for i := 1 to Length(S) do
    h := (h * 31 + Ord(S[i])) xor (h shr 33);
end;

function Try1(const F: string; const A: array of const): string;
begin
  try
    Result := Format(F, A);
  except
    on E: Exception do
      Result := '!' + E.ClassName + ':' + E.Message;
  end;
end;

procedure Fixed(const F: string);
var
  i: Integer;
begin
  for i := 0 to High(Reals) do
    WriteLn(F, ' | ', Reals[i], ' | ', Try1(F, [Reals[i]]), ' | ', Try1(F, [i, 'ab', Reals[i]]));
end;

function Piece(k: Integer): string;
begin
  case k mod 23 of
    0: Result := '%d';
    1: Result := '%s';
    2: Result := '%f';
    3: Result := '%.3f';
    4: Result := '%5d';
    5: Result := '%-5d';
    6: Result := '%05d';
    7: Result := '%.0f';
    8: Result := '%10.3f';
    9: Result := '%x';
    10: Result := '%e';
    11: Result := '%g';
    12: Result := '%n';
    13: Result := '%%';
    14: Result := '%*d';
    15: Result := '%0:d';
    16: Result := '%1:s';
    17: Result := '%.12f';
    18: Result := '%.20f';
    19: Result := '%.2d';
    20: Result := '%.5s';
    21: Result := '%8s';
    22: Result := '%-8.2f';
  end;
end;

var
  i, j, n, k: Integer;
  f: string;
  r: Double;
  bits: Int64;
begin
  Reals[0] := 0.0;
  Reals[1] := -0.0;
  Reals[2] := 0.5;
  Reals[3] := 2.675;
  Reals[4] := 1.0 / 3.0;
  Reals[5] := 123456.789;
  Reals[6] := -123456.789e-20;
  Reals[7] := 1e300;
  Reals[8] := 5e-324;
  Reals[9] := 1.7976931348623157e308;
  Reals[10] := 0.1;
  Reals[11] := 9.995;
  Reals[12] := 0.0005;
  Reals[13] := 999999999999999.9;
  Reals[14] := 1e15;
  Reals[15] := 1e17;
  Reals[16] := 12345678901234567890.0;
  Reals[17] := 1.0 / 0.0;
  Reals[18] := -1.0 / 0.0;
  Reals[19] := 0.0 / 0.0;
  Reals[20] := 0.045;
  Reals[21] := -2.5;
  Reals[22] := 100.0;
  Fixed('%f');
  Fixed('%.0f');
  Fixed('%.1f');
  Fixed('%.2f');
  Fixed('%.3f');
  Fixed('%.9f');
  Fixed('%.15f');
  Fixed('%.17f');
  Fixed('%.18f');
  Fixed('%.25f');
  Fixed('%10.2f');
  Fixed('%-10.2f|');
  Fixed('%*.*f');
  Fixed('%.f');
  Fixed('%.3');
  Fixed('%12345d');
  Fixed('%d:%s:%.3f');
  Fixed('a%%b%.2fc');
  seed := 20261028;
  h := 5;
  for i := 1 to 150000 do
  begin
    n := Integer((Next shr 40) mod 4) + 1;
    f := '';
    for j := 1 to n do
    begin
      k := Integer((Next shr 40) mod 60);
      if k < 23 then
        f := f + Piece(k)
      else if k < 33 then
        f := f + 'ab:'
      else if k < 36 then
        f := f + '%' + Chr(97 + k - 36 + 3)
      else if k < 40 then
        f := f + '%.' + Chr(48 + k mod 10)
      else
        f := f + Piece(Integer((Next shr 40) mod 23));
    end;
    bits := Next;
    Move(bits, r, 8);
    case i mod 6 of
      0: Mix(Try1(f, [i, 'ab', r]));
      1: Mix(Try1(f, [r]));
      2: Mix(Try1(f, [i]));
      3: Mix(Try1(f, ['x']));
      4: Mix(Try1(f, [r, i]));
      5: Mix(Try1(f, [i, i, i, 'q']));
    end;
    Mix(Try1(f, [Reals[i mod 23], i mod 1000, 'abc']));
  end;
  WriteLn('hash ', h);
end.
