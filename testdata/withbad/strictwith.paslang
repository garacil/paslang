program strictwith;
type
  TSecret = class
  strict private
    Hidden: Integer;
  public
    Shown: Integer;
  end;
var
  s: TSecret;
begin
  s := TSecret.Create;
  with s do
  begin
    Shown := 1;
    Hidden := 2;
  end;
end.
