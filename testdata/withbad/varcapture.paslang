program varcapture;
type
  TR = record X: Integer end;
  PR = ^TR;
  TF = function: Integer;
function Capture(var R: TR): TF;
var P: PR;
begin
  P := @R;
  with P^ do
    Result := function: Integer
    begin
      Result := X;
    end;
end;
begin
end.
