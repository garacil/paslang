{ Subranges of Char and of an enumeration (P135), more: typed constants
  of each, an untyped Char constant into one, defaults of each, a case
  on an enumeration's subrange, an array indexed by characters. The
  same source compiles with Free Pascal, whose output is the one
  expected. }
program subrange2;
{$ifndef PASLANG}{$mode objfpc}{$H+}{$endif}
type
  TDigit = '0'..'9';
  TDay = (Mon, Tue, Wed, Thu, Fri, Sat, Sun);
  TWork = Mon..Fri;
const
  Zero: TDigit = '0';
  Mid: TWork = Wed;
  Nine = '9';
var
  a: array['a'..'e'] of Integer;
  c: Char;
  d: TDigit;
  w: TWork;
  i: Integer;
  s: string;
procedure P(X: TDigit = '5'; Y: TWork = Tue);
begin
  WriteLn(X, Ord(Y));
end;
begin
  for c := 'a' to 'e' do
    a[c] := Ord(c) - 96;
  i := 0;
  for c := Low(a) to High(a) do
    i := i + a[c];
  WriteLn(i, ' ', Zero, Ord(Mid), Nine);
  P;
  P('8', Fri);
  d := Nine;
  s := d;
  s := s + Zero;
  WriteLn(s, ' ', Length(s), ' ', Ord(d = Nine), ' ', Ord(d) - Ord(Zero));
  w := Mid;
  case w of
    Mon, Tue: WriteLn('early');
    Wed..Fri: WriteLn('late');
  end;
  c := d;
  WriteLn(c);
end.

