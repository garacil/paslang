program cpwalk;

{ Pointer walks that are right under paslangc -checkptr (1.0.111): a step
  may reach one past the end of its object, as in C, so a walk can end
  there and come back from there; an access there cannot. make check
  runs it with -checkptr and without, and both print the same. }

type
  PRec = ^TRec;
  TRec = record
    A, B, C, D: Integer;
  end;

var
  blk, p, e: PByte;
  q, qe: PInteger;
  r1, r2: PRec;
  i, n: Integer;
  s: string;
  pc: PChar;

begin
  GetMem(blk, 64);
  p := blk;
  for i := 0 to 63 do
  begin
    p^ := Byte(i);
    Inc(p);
  end;
  e := p;
  n := 0;
  while p > blk do
  begin
    Dec(p);
    n := n + p^;
  end;
  WriteLn('walk ', n, ' ', e - blk);
  New(r1);
  New(r2);
  r1^.A := 1;
  r1^.B := 2;
  r1^.C := 3;
  r1^.D := 4;
  r2^.A := 100;
  q := PInteger(r1);
  qe := q + 4;
  n := 0;
  while q < qe do
  begin
    n := n + q^;
    Inc(q);
  end;
  WriteLn('rec ', n, ' ', (qe - 1)^, ' ', PInteger(r1)[3], ' ', (PInteger(r1) + 3)^);
  s := 'hello';
  s := s + ' world';
  pc := PChar(s);
  n := 0;
  while pc^ <> #0 do
  begin
    Inc(n);
    Inc(pc);
  end;
  WriteLn('pchar ', n);
end.

