{ Val into an integer type reads the number into that type's range
  (P149), as Free Pascal 3.3.1's Val (rtl/inc/sstrings.inc checks the
  destination's size): a number past it is an error at the digit that
  goes past, a minus into an unsigned type at its place; a number in
  another base fills the width's pattern ($FF into an Int8 is -1); a
  subrange's bounds hold in every base, and a number below a positive
  one's lowest value is an error at its last digit. On an error the
  variable is 0, or the type's lowest value when 0 is not one of them.
  SysUtils' DWord words read the same range: StrToDWord raises, the Def
  form gives the default, where their low 32 bits were kept; and the
  QWord words, 0 to 2^64 - 1. The positions were checked against a model
  of the rule with exact integers on 20000 strings for every type. }
program valrange;

uses sysutils;

type
  TMonth = 1..12;
  TMid = 5..10;
  TSym = -5..5;
  TNeg = -10..-3;

var
  i8: Int8;
  b: Byte;
  i16: Int16;
  w: Word;
  i32: Int32;
  u32: UInt32;
  i: Integer;
  m: TMonth;
  k: TMid;
  t: TSym;
  g: TNeg;
  code, d: Int64;
  s: string;
begin
  for s in ['127', '128', '-128', '-129', '$7F', '$80', '$FF', '$100', '-$80', '-$81', '%11111111', '&377',
    '255', '256', '1000', '-0', '12x'] do
  begin
    Val(s, i8, code);
    Write(s, ' i8=', i8, '/', code);
    Val(s, b, code);
    WriteLn(' b=', b, '/', code);
  end;
  for s in ['32767', '32768', '-32768', '-32769', '$FFFF', '$10000', '65535', '65536', '-65536'] do
  begin
    Val(s, i16, code);
    Write(s, ' i16=', i16, '/', code);
    Val(s, w, code);
    WriteLn(' w=', w, '/', code);
  end;
  for s in ['2147483647', '2147483648', '-2147483648', '-2147483649', '$FFFFFFFF', '$100000000',
    '4294967295', '4294967296', '99999999999'] do
  begin
    Val(s, i32, code);
    Write(s, ' i32=', i32, '/', code);
    Val(s, u32, code);
    WriteLn(' u32=', u32, '/', code);
  end;
  for s in ['9223372036854775807', '9223372036854775808', '-9223372036854775808',
    '-9223372036854775809', '$FFFFFFFFFFFFFFFF', '$10000000000000000', '-$8000000000000000',
    '-$8000000000000001'] do
  begin
    Val(s, i, code);
    WriteLn(s, ' i=', i, '/', code);
  end;
  for s in ['1', '12', '13', '0', '-1', '$C', '$D', '99'] do
  begin
    Val(s, m, code);
    Write(s, ' m=', m, '/', code);
    Val(s, k, code);
    WriteLn(' k=', k, '/', code);
  end;
  for s in ['5', '6', '-5', '-6', '0', '$5', '-$5', '$6'] do
  begin
    Val(s, t, code);
    Write(s, ' t=', t, '/', code);
    Val(s, g, code);
    WriteLn(' g=', g, '/', code);
  end;
  for s in ['4294967295', '4294967296', '$FFFFFFFF', '$100000000', '-1', '12x'] do
  begin
    Write(s, ' ', BoolToStr(TryStrToDWord(s, d), True), ' ', StrToDWordDef(s, 77));
    try
      Write(' ', StrToDWord(s));
    except
      on e: EConvertError do
        Write(' ', e.Message);
    end;
    WriteLn(' ', StrToUIntDef(s, 88));
  end;
  { a QWord's range, to 2^64 - 1: a 21st digit went through the test of
    2^64 once the number had passed 2^63, and wrapped (P142's, found by
    P149) }
  for s in ['18446744073709551615', '18446744073709551616', '184467440737095516150',
    '10000000000000000000'] do
    WriteLn(s, ' ', BoolToStr(TryStrToQWord(s, d), True), ' ', UIntToStr(d));
end.

