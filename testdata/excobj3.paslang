{ Exceptions with objects (P122), what is paslang's own: an object
  lives while something points to it, so a handler may raise the object
  it holds again, or keep it after the handler; a closure made in a
  handler keeps the handler's object; every routine started with pas
  has its own object and handlers, so two routines raising at once
  catch their own; raise with no object, outside an except part, is
  taken by a plain except part and by an else part, never by on; a
  routine whose raise nobody handles ends alone, its finally part run. }
program excobj3;

uses paslib;

type
  EA = class
    Tag: string;
    constructor Create(const T: string);
  end;

  EB = class(EA)
  end;

  TShow = function: string;

var
  kept: EA;
  wg: waitgroup;
  results: chan of string;
  ended: chan of Integer;

constructor EA.Create(const T: string);
begin
  Tag := T;
end;

procedure RaiseHeld;
begin
  try
    try
      raise EB.Create('held');
    except
      on E: EA do
      begin
        kept := E;
        raise E;
      end;
    end;
  except
    on E: EB do
      WriteLn('raised again: ', E.Tag, ', the same object: ', Ord(Pointer(E) = Pointer(kept)));
  end;
  WriteLn('kept after the handler: ', kept.Tag);
end;

function Closure: TShow;
begin
  Result := nil;
  try
    raise EA.Create('in a closure');
  except
    on E: EA do
      Result := function: string
      begin
        Result := E.Tag;
      end;
  end;
end;

procedure Worker(Id: Integer);
var
  i: Integer;
  n: Integer;
begin
  n := 0;
  for i := 1 to 2000 do
  begin
    try
      if (i + Id) mod 2 = 0 then
        raise EA.Create('a' + IntToStr(Id))
      else
        raise EB.Create('b' + IntToStr(Id));
    except
      on E: EB do
        if E.Tag = 'b' + IntToStr(Id) then
          n := n + 1;
      on E: EA do
        if E.Tag = 'a' + IntToStr(Id) then
          n := n + 1;
    end;
    if i mod 100 = 0 then
      Sleep(0);
  end;
  Send(results, 'worker ' + IntToStr(Id) + ' caught its own ' + IntToStr(n));
  wg.Done;
end;

procedure NoObject;
begin
  try
    raise;
  except
    on E: TObject do
      WriteLn('not taken by on');
  else
    WriteLn('no object: the else part');
  end;
  try
    try
      raise;
    except
      on E: TObject do
        WriteLn('not taken by on');
    end;
  except
    WriteLn('no object: past on, to the plain except');
  end;
end;

procedure Lone;
begin
  try
    raise EB.Create('nobody handles it');
  finally
    Send(ended, 1);
  end;
end;

var
  f: TShow;
  a, b: string;

begin
  RaiseHeld;
  f := Closure;
  WriteLn('the closure says: ', f());
  results := MakeChan(2);
  wg.Add(2);
  pas Worker(1);
  pas Worker(2);
  wg.Wait;
  a := Recv(results);
  b := Recv(results);
  if a > b then
    WriteLn(b, ' / ', a)
  else
    WriteLn(a, ' / ', b);
  NoObject;
  ended := MakeChan(1);
  pas Lone;
  WriteLn('Lone ended: ', Recv(ended));
  WriteLn('done');
end.

