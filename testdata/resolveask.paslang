{ P224: Resolve asks as Go's resolver does. A nameserver routine on the
  loopback answers the first question with forgeries before the answer:
  from another port, with another id, for another name, a message too
  short to be one, and the question sent back unanswered; then the
  answer, its name in capitals. One that never answers ends the wait at
  the deadline. A host that is no domain name is asked of nobody.
  Twenty questions in a row take ids that make no sequence, and sixty-four routines asking at once each take their own
  answer. Loopback only, so the output is the same on every machine. }
program resolveask;

uses pasnet;

var
  forger, echo, silent, fport, eport, sport, i, ok, steps: Integer;
  t0, ms: Integer;
  ids: array of Integer;
  done, edone: WaitGroup;
  mu: TPasMutex;
  same: Boolean;
  a: string;

{ the number at the end of a name rN.test }
function NumOf(const Name: string): Integer;
var
  i: Integer;
begin
  Result := 0;
  i := 2;
  while (i <= Length(Name)) and (Name[i] >= '0') and (Name[i] <= '9') do
  begin
    Result := Result * 10 + Ord(Name[i]) - 48;
    i := i + 1;
  end;
end;

{ the forgeries, then the answer }
procedure Forge(Fd: Integer);
var
  m, r, host: string;
  port, id, other: Integer;
begin
  m := UdpRecvFrom(Fd, 4096, host, port);
  id := Ord(m[1]) * 256 + Ord(m[2]);
  other := UdpBindAt('127.0.0.1', 0);
  UdpSendTo(other, host, port, DnsReplyA(m, $0A060606, 60));
  UdpClose(other);
  r := DnsReplyA(m, $0A060606, 60);
  r[2] := Chr(Ord(r[2]) xor 1);
  UdpSendTo(Fd, host, port, r);
  UdpSendTo(Fd, host, port, DnsReplyA(DnsQueryA('other.test', id), $0A060606, 60));
  UdpSendTo(Fd, host, port, 'abc');
  UdpSendTo(Fd, host, port, m);
  UdpSendTo(Fd, host, port, DnsReplyA(DnsQueryA('HOST.TEST', id), $0A010203, 60));
  done.Done;
end;

{ every question answered with 10.0.0.N for rN.test, its id kept, until
  stop.test }
procedure Serve(Fd: Integer);
var
  m, host, name: string;
  port, n: Integer;
begin
  while True do
  begin
    m := UdpRecvFrom(Fd, 4096, host, port);
    if host = '' then
      Break;
    name := DnsQuestionName(m);
    n := Length(ids);
    SetLength(ids, n + 1);
    ids[n] := Ord(m[1]) * 256 + Ord(m[2]);
    UdpSendTo(Fd, host, port, DnsReplyA(m, $0A000000 + NumOf(name), 60));
    if name = 'stop.test' then
      Break;
  end;
  edone.Done;
end;

procedure Ask(K: Integer);
begin
  if ResolveVia('r' + IntToStr(K) + '.test', '127.0.0.1', eport, 5000) = '10.0.0.' + IntToStr(K) then
    lock mu do
      ok := ok + 1;
  done.Done;
end;

begin
  forger := UdpBindAt('127.0.0.1', 0);
  fport := UdpPort(forger);
  done.Add(1);
  pas Forge(forger);
  a := ResolveVia('host.test', '127.0.0.1', fport, 5000);
  done.Wait;
  WriteLn(a);
  { a nameserver that never answers: the deadline ends the wait }
  silent := UdpBindAt('127.0.0.1', 0);
  sport := UdpPort(silent);
  t0 := Nanotime;
  a := ResolveVia('host.test', '127.0.0.1', sport, 300);
  ms := (Nanotime - t0) div 1000000;
  WriteLn(a = '', ' ', (ms >= 250) and (ms < 1900));
  { twenty in a row: their ids are no sequence; before them two that are
    no names, asked of no nameserver, which would make the ids 22 }
  echo := UdpBindAt('127.0.0.1', 0);
  eport := UdpPort(echo);
  edone.Add(1);
  pas Serve(echo);
  WriteLn(ResolveVia('256.1.1.1', '127.0.0.1', eport, 5000) = '', ' ',
    ResolveVia('a b.test', '127.0.0.1', eport, 5000) = '');
  for i := 1 to 20 do
    if ResolveVia('r' + IntToStr(i) + '.test', '127.0.0.1', eport, 5000) <> '10.0.0.' + IntToStr(i) then
      WriteLn('no answer for r', i);
  same := True;
  steps := (ids[1] - ids[0]) and 65535;
  for i := 2 to High(ids) do
    if ((ids[i] - ids[i - 1]) and 65535) <> steps then
      same := False;
  WriteLn(Length(ids), ' ', same);
  { sixty-four at once }
  ok := 0;
  done.Add(64);
  for i := 1 to 64 do
    pas Ask(i);
  done.Wait;
  ResolveVia('stop.test', '127.0.0.1', eport, 5000);
  edone.Wait;
  WriteLn(ok);
  UdpClose(forger);
  UdpClose(echo);
  UdpClose(silent);
end.

