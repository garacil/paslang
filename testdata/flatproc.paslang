{ P296: a routine that calls nothing keeps its locals, parameters and
  Result in registers, with no frame. scripts/check_flatproc.py reads
  that the routines named Flat... have no frame and no stack check and
  that Clamp3 is a few instructions; Many, with more variables than
  registers, keeps its frame. Written by a script; the answers are
  Python's. }
program flatproc;

type
  PNode = ^TNode;
  TNode = record
    Value: Integer;
    Next: PNode;
  end;

  TBox = class
    W, H: Integer;
    function FlatArea(K: Integer): Integer;
  end;

var
  tab: array[0..15] of Integer;
  nodes: array[0..3] of TNode;

function FlatClamp3(X, Lo, Hi: Integer): Integer;
var
  r: Integer;
begin
  r := X;
  if r < Lo then
    r := Lo;
  if r > Hi then
    r := Hi;
  Result := r;
end;

function Mix6(a, b, c, d, e, f: Integer): Integer;
var
  t, u: Integer;
begin
  t := a * 3 + b;
  u := c xor d;
  if t > u then
    t := t - u
  else
    t := u - t + e;
  Result := t * f + (a and 7);
end;

function FlatSumTo(n: Integer): Integer;
var
  i, s: Integer;
begin
  s := 0;
  for i := 1 to n do
    s := s + i * i;
  Result := s;
end;

function FlatWhile(n: Integer): Integer;
var
  k, steps: Integer;
begin
  k := n;
  steps := 0;
  while k <> 1 do
  begin
    if (k and 1) = 0 then
      k := k shr 1
    else
      k := 3 * k + 1;
    steps := steps + 1;
  end;
  Result := steps;
end;

function FlatFind(n, target: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  i := 0;
  repeat
    if (i * 7) mod 13 = target then
    begin
      Result := i;
      Exit;
    end;
    i := i + 1;
  until i >= n;
end;

function FlatCase(k: Integer): Integer;
begin
  case k mod 5 of
    0: Result := 10;
    1: Result := k * 2;
    2, 3: Result := -k;
  else
    Result := k + 100;
  end;
end;

function FlatNarrow(x: Integer): Integer;
var
  b: Byte;
  w: Word;
  ok: Boolean;
begin
  b := Byte(x * 3);
  w := Word(x * 1000 + b);
  ok := (b > 100) or (w < 5000);
  if ok then
    Result := b + w
  else
    Result := w - b;
end;

function FlatField(p: PNode): Integer;
begin
  Result := p^.Value * 2 + 1;
end;

function FlatElem(i: Integer): Integer;
begin
  Result := tab[i] + tab[i and 15] * 2;
end;

function TBox.FlatArea(K: Integer): Integer;
begin
  Result := W * H + K;
end;

function Many(a, b, c, d, e, f: Integer): Integer;
var
  g, h, i, j, k, l: Integer;
begin
  g := a + b;
  h := c + d;
  i := e + f;
  j := g * h;
  k := h * i;
  l := g * i;
  Result := g + h + i + j + k + l + a * b * c * d * e * f;
end;

var
  i, s: Integer;
  bx: TBox;

begin
  for i := 0 to 15 do
    tab[i] := i * i - 7;
  for i := 0 to 3 do
    nodes[i].Value := i * 11 - 5;
  WriteLn(FlatClamp3(5, 1, 9), ' ', FlatClamp3(-3, 1, 9), ' ', FlatClamp3(42, 1, 9));
  WriteLn(Mix6(1, 2, 3, 4, 5, 6), ' ', Mix6(-7, 100, 5, 9, -2, 3));
  WriteLn(FlatSumTo(10), ' ', FlatSumTo(5000));
  WriteLn(FlatWhile(27), ' ', FlatWhile(97));
  WriteLn(FlatFind(20, 5), ' ', FlatFind(20, 99));
  s := 0;
  for i := 0 to 20 do
    s := s + FlatCase(i) * (i + 1);
  WriteLn(s);
  WriteLn(FlatNarrow(7), ' ', FlatNarrow(40), ' ', FlatNarrow(-3));
  WriteLn(FlatField(@nodes[2]), ' ', FlatElem(3), ' ', FlatElem(15));
  bx := TBox.Create;
  bx.W := 6;
  bx.H := 7;
  WriteLn(bx.FlatArea(5));
  WriteLn(Many(1, 2, 3, 4, 5, 6), ' ', Many(-1, 3, -5, 7, -9, 11));
end.
