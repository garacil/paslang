program forlimit;

{ A for loop's limit is worked out once, before the loop, as in every
  Pascal (1.0.93): a body that changes n does not change the loop, and a
  limit that calls a function calls it once. It was worked out again
  after each pass. }

var
  n, i, calls, sum: Integer;
  a: array of Integer;
  b: Byte;

function Limit: Integer;
begin
  calls := calls + 1;
  Result := 4;
end;

procedure Inner;
var
  k, m: Integer;
begin
  m := 2;
  for k := 0 to m + 1 do
  begin
    m := 100;
    Write(k, ' ');
  end;
  WriteLn;
end;

begin
  n := 3;
  for i := 1 to n do
  begin
    n := 10;
    Write(i, ' ');
  end;
  WriteLn;
  calls := 0;
  sum := 0;
  for i := 1 to Limit do
    sum := sum + i;
  WriteLn(sum, ' ', calls);
  SetLength(a, 3);
  for i := 0 to High(a) do
  begin
    SetLength(a, Length(a) + 1);
    a[i] := i;
  end;
  WriteLn(Length(a));
  n := 5;
  for i := n downto n - 2 do
  begin
    n := 0;
    Write(i, ' ');
  end;
  WriteLn;
  Inner;
  n := 0;
  for b := 250 to Byte(n + 255) do
    n := n + 1;
  WriteLn(n);
end.

