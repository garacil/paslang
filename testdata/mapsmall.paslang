program mapsmall;

{ A map of up to eight keys is one group and nothing else, as Go's small
  map (P285): no group until its first key, the eight slots read whole,
  a deleted key's slot empty again, the ninth key taking it into a table
  of sixteen slots. String and integer keys, lookups that hit and miss,
  updates, deletes and reinserts, Clear, values of several words and
  values that hold pointers, loops over a small map, also while it grows
  into a table and while it loses keys; the memory of a map counted entry
  by entry, against what Go 1.27 takes for the same map (48 bytes empty,
  256 up to eight keys, 504 with nine). }

uses sysutils;

type
  TRec = record
    A, B, C: Integer;
    S: string;
  end;
  TSM = map[string] of Integer;
  TIM = map[Integer] of Integer;
  TRM = map[string] of TRec;

var
  keys: array[0..15] of string;

procedure Strings;
var
  m: TSM;
  i, j, n, v: Integer;
  ok: Boolean;
  line: string;
begin
  for n := 0 to 10 do
  begin
    New(m);
    for i := 0 to n - 1 do
      m[keys[i]] := i * 10;
    line := IntToStr(n) + ':' + IntToStr(Length(m));
    for i := 0 to 11 do
    begin
      ok := keys[i] in m;
      v := m[keys[i]];
      if ok <> (i < n) then
        line := line + ' bad in ' + keys[i];
      if ok and (v <> i * 10) then
        line := line + ' bad value ' + keys[i];
      if (not ok) and (v <> 0) then
        line := line + ' bad zero ' + keys[i];
    end;
    { update all, delete the odd, put two back }
    for i := 0 to n - 1 do
      m[keys[i]] := m[keys[i]] + 1;
    j := 0;
    for i := 0 to n - 1 do
      if i mod 2 = 1 then
      begin
        Delete(m, keys[i]);
        j := j + 1;
      end;
    if n > 1 then
    begin
      m[keys[1]] := 77;
      m[keys[n + 3]] := 88;
    end;
    v := 0;
    for i := 0 to 15 do
      v := v + m[keys[i]];
    line := line + ' ' + IntToStr(Length(m)) + ' ' + IntToStr(v);
    WriteLn(line);
  end;
end;

procedure Ints;
var
  m: TIM;
  i, n, s: Integer;
begin
  for n := 0 to 10 do
  begin
    New(m);
    for i := 1 to n do
      m[i * 1000003] := i;
    s := 0;
    for i := 0 to 12 do
      s := s + m[i * 1000003] * 7 + Ord(i * 1000003 in m);
    Delete(m, 2000006);
    Delete(m, 12345);
    m[-5] := 9;
    Write(n, ':', Length(m), ':', s, ':', m[-5], ':', m[2000006], ' ');
  end;
  WriteLn;
end;

procedure Records;
var
  m: TRM;
  r: TRec;
  i: Integer;
  t: string;
begin
  New(m);
  for i := 0 to 7 do
  begin
    r.A := i;
    r.B := i * i;
    r.C := -i;
    r.S := 'rec' + IntToStr(i);
    m[keys[i]] := r;
  end;
  t := '';
  for i := 0 to 8 do
  begin
    r := m[keys[i]];
    t := t + IntToStr(r.A + r.B + r.C) + r.S + ' ';
  end;
  r.S := 'nine';
  m[keys[8]] := r;
  t := t + IntToStr(Length(m)) + ' ' + m[keys[8]].S + ' ' + m[keys[3]].S;
  WriteLn(t);
end;

{ A loop over a small map, and over one that grows into a table during
  the loop, and one that loses keys during it: every key that stays is
  seen once, a deleted one is not seen after its delete. }
procedure Loops;
var
  m: TSM;
  k: string;
  v, seen, sum, i: Integer;
begin
  New(m);
  for i := 0 to 5 do
    m[keys[i]] := i + 1;
  seen := 0;
  sum := 0;
  for k, v in m do
  begin
    seen := seen + 1;
    sum := sum + v;
  end;
  Write('six ', seen, ' ', sum);
  seen := 0;
  sum := 0;
  for k, v in m do
  begin
    if seen = 0 then
      for i := 6 to 13 do
        m[keys[i]] := 100;
    seen := seen + 1;
    if v < 100 then
      sum := sum + v;
  end;
  Write(' grown ', Length(m), ' ', sum, ' ', seen >= 6);
  Clear(m);
  for i := 0 to 7 do
    m[keys[i]] := 1;
  seen := 0;
  for k, v in m do
  begin
    if seen = 0 then
      for i := 0 to 7 do
        if keys[i] <> k then
          Delete(m, keys[i]);
    seen := seen + 1;
  end;
  WriteLn(' emptied ', Length(m), ' ', seen);
end;

{ Clear keeps the group; the map stays small. }
procedure Clears;
var
  m: TSM;
  i: Integer;
begin
  New(m);
  for i := 0 to 7 do
    m[keys[i]] := i;
  Clear(m);
  Write(Length(m), ' ', m[keys[3]], ' ');
  for i := 0 to 7 do
    m[keys[i]] := i + 1;
  Write(Length(m), ' ', m[keys[7]], ' ');
  for i := 0 to 7 do
    Delete(m, keys[i]);
  for i := 0 to 7 do
    m[keys[15 - i]] := i;
  WriteLn(Length(m), ' ', m[keys[15]], ' ', m[keys[8]]);
end;

{ A whole cycle: GcCollect answers 0 when it cannot run one (a cycle of
  the pacer's own under way), and the blocks a cycle finds dead are
  counted out by the next, so two that ran. }
procedure Collect;
var
  n: Integer;
begin
  n := 0;
  while n < 2 do
    if GcCollect = 1 then
      n := n + 1
    else
      Sleep(1);
end;

{ The bytes a map takes, entry count by entry count, rounded to 8:
  N maps of each count, the heap's live bytes before and after, with
  nothing else alive between (the array is the same one, emptied). }
procedure Memory;
var
  keep: array of TSM;
  m: TSM;
  k, i, j, n, a, b, per: Integer;
  gol: array[0..9] of Integer;
begin
  gol[0] := 48;
  for k := 1 to 8 do
    gol[k] := 256;
  gol[9] := 504;
  n := 20000;
  SetLength(keep, n);
  for k := 0 to 9 do
  begin
    for i := 0 to n - 1 do
      keep[i] := nil;
    m := nil;
    Collect;
    a := HeapStat(1);
    for i := 0 to n - 1 do
    begin
      New(m);
      for j := 0 to k - 1 do
        m[keys[j]] := j;
      keep[i] := m;
    end;
    m := nil;
    Collect;
    b := HeapStat(1);
    per := ((b - a) div n + 4) div 8 * 8;
    WriteLn(k, ' keys: ', per, ' bytes, less than Go''s ', gol[k], ': ', per < gol[k]);
  end;
end;

var
  i: Integer;
begin
  for i := 0 to 15 do
    keys[i] := 'k' + IntToStr(i * 37) + Copy('abcdefghijklmnop', 1, i);
  Strings;
  Ints;
  Records;
  Loops;
  Clears;
  { the collector's stress runs it with nomem: the counts of memory
    take a quarter of a million maps }
  if ParamStr(1) <> 'nomem' then
    Memory;
end.

