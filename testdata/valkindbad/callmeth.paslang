{ P338: a parameterless function's name calls it; its method value is
  @b.Get, and the refusal says so. }
program callmeth;

type
  TMeth = function: Integer of object;
  TBox = class
    N: Integer;
    function Get: Integer;
  end;

function TBox.Get: Integer;
begin
  Result := N;
end;

var
  m: TMeth;
  b: TBox;

begin
  b := TBox.Create;
  m := b.Get;
end.

