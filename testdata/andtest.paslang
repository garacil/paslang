      5: v := 1;
      6: v := 16384;
    else
      v := 0;
    end;
    if (v and 1) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and 256) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and 32768) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and 65535) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
  end;
  Result := s;
end;

