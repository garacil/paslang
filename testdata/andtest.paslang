{ P322: an and compared with 0 is one test of its source: TEST or BT on
  amd64, TST or TBZ and TBNZ on arm64, for masks of every width, of
  variables in registers and at their homes and of expressions, in
  jumps, selects and Boolean values, and of narrow variables with
  constants of their type. scripts/check_andtest.py reads that the
  routines write no AND before a compare of it with zero. Written by a
  script; the answers are Python's. }
program andtest;

var
  gv: Integer;
  vals: array[0..15] of Integer;

procedure Touch(x: Integer);
begin
  if x = -12345 then
    WriteLn('touch');
end;

{ mask 1: in a register, at home, of an expression; jump, select, value }
function Reg0(n: Integer): Integer;
var
  i, s, x, t: Integer;
  b: Boolean;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    x := vals[i];
    if (x and 1) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (x and 1) <> 0 then
      t := 5
    else
      t := 9;
    b := (x and 1) = 0;
    if b then
      s := s + t
    else
      s := s - t;
    if ((x + i) and 1) <> 0 then
      s := s xor 7;
  end;
  Result := s;
end;

function Home0(n: Integer): Integer;
var
  i, s, x: Integer;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    x := vals[i];
    gv := x;
    Touch(i);
    if (x and 1) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (gv and 1) <> 0 then
      s := s + 4;
  end;
  Result := s;
end;

