  WriteLn('-1 ', Reg12(16), ' ', Home12(16));
  WriteLn('-256 ', Reg13(16), ' ', Home13(16));
  WriteLn('-2147483648 ', Reg14(16), ' ', Home14(16));
  WriteLn('4294967297 ', Reg15(16), ' ', Home15(16));
  WriteLn('Byte ', NarrowByte(7));
  WriteLn('Word ', NarrowWord(7));
  WriteLn('UInt32 ', NarrowUInt32(7));
  WriteLn('Int8 ', NarrowInt8(9));
  WriteLn('Int16 ', NarrowInt16(9));
  WriteLn('Int32 ', NarrowInt32(9));
end.
