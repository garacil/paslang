function NarrowByte(n: Integer): Integer;
var
  i, s: Integer;
  v: Byte;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    case i of
      0: v := 0;
      1: v := 1;
      2: v := 255;
      3: v := 254;
      4: v := 0;
      5: v := 1;
      6: v := 64;
    else
      v := 0;
    end;
    if (v and 1) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and 128) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and 255) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and 15) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
  end;
  Result := s;
end;

