      8: v := -2;
    else
      v := 0;
    end;
    if (v and 1) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and -32768) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and 256) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and -1) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
  end;
  Result := s;
end;

function NarrowInt32(n: Integer): Integer;
var
  i, s: Integer;
  v: Int32;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    case i of
      0: v := -2147483648;
      1: v := -2147483647;
      2: v := 2147483647;
      3: v := 2147483646;
      4: v := 0;
      5: v := 1;
      6: v := 16384;
      7: v := -1;
      8: v := -2;
    else
      v := 0;
    end;
    if (v and 1) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and -2147483648) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and 65536) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
    if (v and -1) = 0 then
      s := s * 3 + 1
    else
      s := s * 3 + 2;
  end;
  Result := s;
end;

begin
  vals[0] := 0;
