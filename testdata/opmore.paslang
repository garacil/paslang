program opmore;

type
  TPoint = record
    X, Y: Integer;
  end;

operator = (A, B: TPoint): Boolean;
begin
  Result := (A.X = B.X) and (A.Y = B.Y);
end;

operator < (A, B: TPoint): Boolean;
begin
  if A.X <> B.X then
    Result := A.X < B.X
  else
    Result := A.Y < B.Y;
end;

operator * (A: TPoint; K: Integer): TPoint;
begin
  Result.X := A.X * K;
  Result.Y := A.Y * K;
end;

var
  A, B, C: TPoint;

begin
  A.X := 3;
  A.Y := 4;
  B.X := 3;
  B.Y := 4;
  C.X := 5;
  C.Y := 1;
  if A = B then
    WriteLn(1)
  else
    WriteLn(0);
  if A = C then
    WriteLn(1)
  else
    WriteLn(0);
  if A < C then
    WriteLn(1)
  else
    WriteLn(0);
  if C < A then
    WriteLn(1)
  else
    WriteLn(0);
  B := A * 3;
  WriteLn(B.X);
  WriteLn(B.Y);
  WriteLn(2 * 4);
end.

