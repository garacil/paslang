{ The standard string words (P134): Pos with and without a start, of a
  string and of a Char, over short and long text, with many false
  starts; Insert, Delete, Copy of the rest, Concat, UpCase and LowerCase
  of a Char and of a string, StringOfChar; Str of an integer, a real and
  an enumeration's member with a width; Val of integers in every base,
  of narrow types, of reals and of members, with the place of the
  first bad character. The same source compiles with Free Pascal, whose
  output is the one expected. }
program strwords;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  TColor = (Red, Green, Blue);

var
  s, t, long: string;
  i, n, code: Integer;
  b: Byte;
  w: Word;
  l: Int32;
  r: Double;
  col: TColor;
  c: Char;

procedure VI(const x: string);
var
  v: Int64;
begin
  Val(x, v, code);
  WriteLn('[', x, '] ', v, ' ', code);
end;

procedure VR(const x: string);
begin
  r := 0;
  Val(x, r, code);
  WriteLn('r[', x, '] ', r:0:6, ' ', code);
end;

begin
  WriteLn(Pos('lo', 'hello'), Pos('z', 'hello'), Pos('', 'hello'), Pos('l', 'hello', 4),
    Pos('l', 'hello', 5), Pos('hello', 'hello'), Pos('helloo', 'hello'), Pos('l', 'hello', 0),
    Pos('l', 'hello', 9));
  c := 'o';
  WriteLn(Pos(c, 'hello world'), ' ', Pos(c, 'hello world', 6), ' ', Pos('o w', 'hello world'));
  long := '';
  for i := 1 to 300 do
    long := long + Chr(97 + i mod 7);
  long := long + 'needle';
  WriteLn(Pos('needle', long), ' ', Pos('needlf', long), ' ', Pos('gab', long), ' ',
    Pos('gab', long, 200), ' ', Pos('e', long, 290));
  { the first two bytes match everywhere, the rest nowhere: Rabin-Karp }
  long := '';
  for i := 1 to 2000 do
    long := long + 'aa';
  WriteLn(Pos('aab', long), ' ', Pos('aaaaaaaaaab', long + 'aaaaaaaaaab'), ' ',
    Pos(StringOfChar('a', 64) + 'b', long + 'b'));
  s := 'hello';
  Insert('XY', s, 3);
  Write(s, ' ');
  s := 'hello';
  Insert('XY', s, 0);
  Write(s, ' ');
  s := 'hello';
  Insert('XY', s, 99);
  Write(s, ' ');
  s := 'hello';
  Insert('!', s, 6);
  WriteLn(s);
  s := 'hello';
  Delete(s, 2, 2);
  Write(s, ' ');
  s := 'hello';
  Delete(s, 4, 99);
  Write(s, ' ');
  s := 'hello';
  Delete(s, 0, 2);
  Write(s, ' ');
  s := 'hello';
  Delete(s, 9, 2);
  Write(s, ' ');
  s := 'hello';
  Delete(s, 2, -1);
  WriteLn(s);
  WriteLn(Copy('hello', 3), ' ', Copy('hello', 9), ' ', Copy('hello', 0), ' ', Copy('hello', -2, 3), '|');
  WriteLn(Concat('a', 'bc', 'def'), ' ', Concat('x'), ' ', Concat('p', c, 'q'));
  WriteLn(UpCase('a'), UpCase('Z'), UpCase('1'), LowerCase('Q'), LowerCase('q'), ' ',
    UpCase('Hello, World ~[`{'), ' ', LowerCase('Hello ABC @[\'));
  t := '';
  for i := 0 to 99 do
    t := t + Chr(32 + i);
  WriteLn(UpCase(t));
  WriteLn(LowerCase(t));
  c := 'm';
  WriteLn(UpCase(c), LowerCase(UpCase(c)), ' ', StringOfChar('*', 5), '|', StringOfChar('x', 0), '|',
    StringOfChar(c, -3), '|', Length(StringOfChar('-', 1000)));
  Str(42, s);
  Write('[', s, ']');
  Str(42:6, s);
  Write('[', s, ']');
  Str(-7:3, s);
  Write('[', s, ']');
  Str(3.14159:0:2, s);
  Write('[', s, ']');
  Str(3.14159:8:3, s);
  Write('[', s, ']');
  Str(Green, s);
  Write('[', s, ']');
  col := Blue;
  Str(col:6, s);
  WriteLn('[', s, ']');
  VI('123');
  VI('  42');
  VI('-17');
  VI('+5');
  VI('$ff');
  VI('%101');
  VI('&17');
  VI('0x1F');
  VI('x10');
  VI('');
  VI(' ');
  VI('12a');
  VI('9223372036854775807');
  VI('9223372036854775808');
  VI('-9223372036854775808');
  VI('1 ');
  VI('--1');
  VI('$');
  VI(' $1g');
  VI('$FFFFFFFFFFFFFFFF');
  VI('0b101');
  VI(#9'12');
  VI('1_000');
  b := 7;
  Val('255', b, code);
  Write(b, ' ', code, ' ');
  Val('256', b, code);
  Write(b, ' ', code, ' ');
  Val('-1', b, code);
  Write(b, ' ', code, ' ');
  Val(' -1', b, code);
  Write(b, ' ', code, ' ');
  Val('70000', w, code);
  Write(w, ' ', code, ' ');
  Val('3000000000', l, code);
  WriteLn(l, ' ', code);
  VR('1.5');
  VR('  -2.25e2');
  VR('3.');
  VR('.5');
  VR('1e');
  VR('abc');
  VR('1.5x');
  VR('7');
  VR('-0.125E+1');
  Val('Green', col, code);
  Write(Ord(col), ' ', code, ' ');
  Val('blue', col, code);
  Write(Ord(col), ' ', code, ' ');
  Val('Pink', col, code);
  WriteLn(Ord(col), ' ', code);
  n := 0;
  for i := 1 to 50 do
    if Pos(Chr(96 + i mod 26 + 1), 'the quick brown fox jumps over the lazy dog') > 0 then
      n := n + 1;
  WriteLn(n);
end.

