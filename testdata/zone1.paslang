{ pastime's local clock (P131) as Go's time.Local, under TZ set to a
  TZif file of testdata/zoneinfo: a moment's zone (its abbreviation,
  offset east of UTC and daylight saving time), the local date it is,
  and the moment a local date and time is, a time the clock skipped or
  showed twice too, before the first transition, across the table's
  moments and after its last, where the file's POSIX rule goes on. The
  make check runs it with five zones; the output is Go's. }
program zone1;

uses pastime;

var
  moments: array[0..23] of Int64 = (
    -5000000000, -2208988800, -1000000000, -1, 0, 1,
    500000000, 1000000000, 1234567890, 1500000000,
    1774746000, 1774749599, 1774749600, 1761440400,
    1761443999, 1761444000, 1772953200, 1772960400,
    1759586400, 1775311200, 2147483647, 2147483648,
    3500000000, 4102444800);
  locals: array[0..9, 0..5] of Integer = (
    (2026, 3, 29, 2, 30, 0), (2026, 10, 25, 2, 30, 0),
    (2026, 3, 8, 2, 30, 0), (2026, 11, 1, 1, 30, 0),
    (2026, 4, 5, 2, 30, 0), (2026, 10, 4, 2, 30, 0),
    (1900, 1, 1, 0, 0, 0), (2080, 7, 1, 12, 0, 0),
    (1970, 1, 1, 0, 0, 0), (2026, 9, 30, 14, 5, 7));
  i: Integer;
  abbr: string;
  off: Int64;
  dst: Boolean;
  d: TDate;
  t: Int64;
begin
  for i := 0 to High(moments) do
  begin
    LocalZoneAt(moments[i], abbr, off, dst);
    d := UnixToLocalDate(moments[i]);
    t := LocalDateToUnix(d.Year, d.Month, d.Day, d.Hour, d.Minute, d.Second);
    WriteLn(moments[i], ' ', abbr, ' ', off, ' ', Ord(dst), ' ', StampOf(d), ' ', d.Wday, ' ', d.Yday,
      ' ', t, ' ', LocalOffset(moments[i]));
  end;
  for i := 0 to High(locals) do
  begin
    t := LocalDateToUnix(locals[i, 0], locals[i, 1], locals[i, 2], locals[i, 3], locals[i, 4],
      locals[i, 5]);
    LocalZoneAt(t, abbr, off, dst);
    WriteLn(locals[i, 0], '-', locals[i, 1], '-', locals[i, 2], ' ', locals[i, 3], ':', locals[i, 4],
      ' ', t, ' ', abbr, ' ', off, ' ', StampOf(UnixToLocalDate(t)));
  end;
end.

