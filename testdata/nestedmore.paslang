program nestedmore;
{$mode delphi}{$H+}
type
  TPlain = record
    const K = 13;
    type TKind = (Alpha, Beta);
  var
    X: Int64;
    Anonymous: record Value: Int64 end;
  end;
  TOuter = class
    const K = 19;
    type TA = class;
      TB = class
      public A: TA;
      end;
      TA = class
      public B: TB;
      end;
  strict protected
    type TNumber = Int64;
    const Bonus = 7;
  public
    class function Make: TA; static;
    class function Shadow: Int64; static;
  end;
  TDerived = class(TOuter)
    class function ProtectedValue: TNumber; static;
  end;
  TOuterClass = class of TOuter;

var
  R: TPlain;
  O: TOuter;
  C: TOuterClass;
  E: TPlain.TKind;
  S: string;
  N: Int64;

function MakePlain: TPlain;
begin Inc(N); Result.X := 1 end;
function MakeObject: TOuter;
begin Inc(N); Result := nil end;
class function TOuter.Make: TA;
begin Result := TA.Create; Result.B := TB.Create end;
class function TOuter.Shadow: Int64;
const K = 23;
begin Result := K end;
class function TDerived.ProtectedValue: TNumber;
var V: TNumber;
begin V := K + Bonus; Result := V end;

var A: TOuter.TA;
begin
  N := 0;
  O := nil;
  C := TOuter;
  { A type-owned constant does not evaluate the value that qualifies
    it; the qualifier may be nil, as Pascal's class constants allow. }
  WriteLn('access ', R.K, ' ', O.K, ' ', C.K, ' ', MakePlain.K, ' ', MakeObject.K, ' ', N);
  with R do begin Anonymous.Value := K; WriteLn('with ', K, ' ', Anonymous.Value) end;
  E := TPlain.TKind.Beta;
  Str(E, S);
  WriteLn('enum ', S);
  Val('Alpha', E, N);
  WriteLn('read ', Ord(E), ' ', N);
  A := TOuter.Make;
  A.B.A := A;
  WriteLn('scope ', Ord(A.B.A = A), ' ', TOuter.Shadow, ' ', TDerived.ProtectedValue);
  A.B.Free;
  A.Free;
end.
