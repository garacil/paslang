program sysdirectories;
uses sysutils;
const Files = 256; Readers = 16;
var
  root, name, prefix: string;
  i, handle, count, found, baseHandle: Integer;
  reader: TDirectoryReader;
  search: TSearchRec;
  error: TSysError;
  joined: waitgroup;

procedure Scan(Index: Integer);
var cursor: TDirectoryReader; localName: string; localError: TSysError; entries: Integer;
begin
  SetLastOSError(Index + 1);
  if not TryOpenDirectoryAt(baseHandle, '.', cursor, localError) then Halt(20);
  try
    entries := 0;
    while cursor.Next(localName, localError) do
    begin
      if (localName = '.') or (localName = '..') then Halt(21);
      Inc(entries);
      if entries mod 31 = 0 then Yield;
    end;
    if localError.Failed or (entries <> Files + 3) then Halt(22);
    if not cursor.CloseDirectory(localError) or not cursor.CloseDirectory(localError) then Halt(23);
    if GetLastOSError <> Index + 1 then Halt(24);
  finally
    cursor.Free;
  end;
  joined.Done;
end;

begin
  root := ParamStr(1) + '/directories';
  if not CreateDir(root) then Halt(2);
  prefix := StringOfChar('r', 220);
  for i := 0 to Files - 1 do
  begin
    handle := FileCreate(root + '/' + prefix + IntToStr(i) + '.dat', 384);
    if handle < 0 then Halt(3);
    FileClose(handle);
  end;
  handle := FileCreate(root + '/.hidden', 384);
  if handle < 0 then Halt(4);
  FileClose(handle);
  handle := FileCreate(root + '/ni'#195#177'o', 384);
  if handle < 0 then Halt(5);
  FileClose(handle);
  if not CreateDir(root + '/sub') then Halt(6);
  if not TryOpenDirectoryAt(CurrentDirectoryHandle, root, reader, error) then Halt(7);
  baseHandle := reader.Handle;
  joined.Add(Readers);
  for i := 0 to Readers - 1 do pas Scan(i);
  joined.Wait;
  reader.Free;
  found := 0;
  count := FindFirst(root + '/*.dat', 0, search);
  while count = 0 do
  begin
    if search.IsDirectory or search.IsCurrentOrParentDir or (search.Size <> 0) then Halt(8);
    Inc(found);
    count := FindNext(search);
  end;
  if (count <> 2) or (found <> Files) then Halt(9);
  FindClose(search);
  FindClose(search);
  if FindNext(search) <> 2 then Halt(10);
  if FindFirst(root + '/.hidden', 0, search) <> 2 then Halt(11);
  if FindFirst(root + '/.hidden', faHidden, search) <> 0 then Halt(12);
  FindClose(search);
  if FindFirst(root + '/missing-*', faAnyFile, search) <> 2 then Halt(13);
  if FindFirst(root + '/sub', faDirectory, search) <> 0 then Halt(14);
  if not search.IsDirectory then Halt(15);
  FindClose(search);
  if not MatchesFileName('ni?o', 'ni'#195#177'o') then Halt(16);
  if MatchesFileName('ni??o', 'ni'#195#177'o') then Halt(17);
  if not MatchesFileName('*a*b*', 'xxaaybzz') or MatchesFileName('*a*b', 'xxxaa') then Halt(18);
  if not TryOpenDirectoryAt(CurrentDirectoryHandle, root, reader, error) then Halt(19);
  if not reader.CloseDirectory(error) then Halt(25);
  if reader.Next(name, error) or (error.Code <> 9) then Halt(26);
  reader.Free;
  for i := 0 to Files - 1 do
    if not DeleteFile(root + '/' + prefix + IntToStr(i) + '.dat') then Halt(27);
  if not DeleteFile(root + '/.hidden') or not DeleteFile(root + '/ni'#195#177'o') then Halt(28);
  if not RemoveDir(root + '/sub') or not RemoveDir(root) then Halt(29);
  GcCollect;
  WriteLn('bounded directory cursors ', Readers, ', entries ', Files + 3);
  WriteLn('Pascal search filters, UTF-8 patterns and cleanup');
end.
