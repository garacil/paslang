program checkptr;

{ paslangc -checkptr (P104): every pointer step and access is held to
  the object it came from, and one that leaves it stops the program at
  its line: pointer outside its object. Without the option the same code
  runs on (make check runs it both ways); steps inside the object pass. }

type
  PRec = ^TRec;
  TRec = record
    A, B: Integer;
  end;

var
  q1, q2: PRec;
  p: PInteger;
  i, n: Integer;
  buf: array[0..7] of Byte;

begin
  New(q1);
  New(q2);
  q1^.A := 1;
  q1^.B := 2;
  q2^.A := 777;
  p := PInteger(q1);
  n := 0;
  for i := 0 to 1 do
    n := n + (p + i)^;
  WriteLn('inside ', n);
  n := PWord(PByte(q1) + 6)^;
  Inc(p);
  WriteLn('views ', n, ' ', p^, ' ', PByte(@buf[7])^);
  WriteLn('before');
  n := (PInteger(q1) + 2)^;
  WriteLn('read');
end.

