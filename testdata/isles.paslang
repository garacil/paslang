{ P384: a loop that calls keeps its variables in registers, each
  statement with a call an island: what the loop wrote of the variables
  the island names stored home before it, those loaded after, a variable
  of a register every routine keeps left there. Loops calling on every
  pass and on a few, nested both ways, an island holding a loop that
  calls, a var parameter, a closure, an exit, a break and a continue out
  of an island, an exit in the arm of an island whose test calls, after
  the loop wrote Result, a raise caught outside the loop and one caught
  by the routine the loop calls, which gives back the registers its
  callee's region had, a pointer into the stack across a call that grows it,
  objects held only by a loop's registers while a call churns the heap,
  Result and the main block's globals. Every line is the same at
  -inline 0, where the calls stay calls. }
program isles;

uses SysUtils;

type
  TAdd = procedure(D: Integer);
  TBox = class
    V: Integer;
    constructor Create(A: Integer);
  end;

  TPair = record
    A, B: Integer;
  end;

var
  gsum, gi, gk: Integer;
  churned: Integer;

constructor TBox.Create(A: Integer);
begin
  V := A;
end;

function Twice(X: Integer): Integer;
begin
  Result := X * 2 + Ord(X < 0);
end;

function Odd3(X: Integer): Boolean;
begin
  Result := X mod 3 = 1;
end;

procedure Bump(var X: Integer; D: Integer);
begin
  X := X + D;
end;

{ a call on every pass, eight locals in use around it }
function EveryPass(N: Integer): Integer;
var
  i, a, b, c, d, e, f: Integer;
begin
  a := 1;
  b := 2;
  c := 3;
  d := 4;
  e := 5;
  f := 6;
  for i := 0 to N - 1 do
  begin
    a := a + b xor i;
    b := b + c + Twice(i);
    c := c xor (d + i);
    d := d + e - a;
    e := e + f + (i and 7);
    f := f xor a + b;
  end;
  Result := a + b + c + d + e + f;
end;

{ a call on a few passes only }
function FewPasses(N: Integer): Integer;
var
  i, s, t, u: Integer;
begin
  s := 0;
  t := 7;
  u := 0;
  i := 0;
  while i < N do
  begin
    s := s + i * t;
    if i mod 97 = 0 then
      t := Twice(t) and 1023;
    u := u xor s;
    i := i + 1;
  end;
  Result := s + t + u;
end;

{ an outer loop that calls around an inner one that does not }
function OuterCalls(N: Integer): Integer;
var
  i, j, s, w: Integer;
begin
  s := 0;
  for i := 1 to N do
  begin
    w := Twice(i);
    for j := 0 to 15 do
      s := s + (w xor j);
    s := s and $FFFFFF;
  end;
  Result := s;
end;

{ an inner loop that calls in an outer one that does not }
function InnerCalls(N: Integer): Integer;
var
  i, j, s: Integer;
begin
  s := 0;
  for i := 1 to N do
  begin
    s := s + i;
    for j := 0 to 3 do
      if Odd3(i + j) then
        s := s + Twice(j);
  end;
  Result := s;
end;

{ an island holding a loop that calls: a region in it of its own }
function IslandLoop(N: Integer): Integer;
var
  i, j, s, k: Integer;
begin
  s := 0;
  k := 3;
  for i := 0 to N - 1 do
  begin
    s := s + k;
    if Odd3(i) then
      for j := 0 to 4 do
        s := s + Twice(j + k);
    k := (k * 5 + 1) and 255;
  end;
  Result := s + k;
end;

{ a var parameter of a call in the loop, and the loop's own reads of it }
function VarArg(N: Integer): Integer;
var
  i, x, y: Integer;
begin
  x := 0;
  y := 0;
  for i := 0 to N - 1 do
  begin
    y := y + x;
    Bump(x, i and 3);
    y := y xor x;
  end;
  Result := x * 1000 + (y and 999);
end;

{ a closure that reads and writes the loop's variables }
function Closure(N: Integer): Integer;
var
  i, acc, seen: Integer;
  add: TAdd;
begin
  acc := 0;
  seen := 0;
  add := procedure(D: Integer)
  begin
    acc := acc + D;
    seen := seen + 1;
  end;
  for i := 0 to N - 1 do
  begin
    if i mod 5 = 0 then
      add(i);
    acc := acc + 1;
  end;
  Result := acc * 100 + seen;
end;

{ an exit from an island in the middle of the loop, and one at its end }
function FindTwice(N, Want: Integer): Integer;
var
  i, s: Integer;
begin
  Result := -1;
  s := 0;
  for i := 0 to N - 1 do
  begin
    s := s + i;
    if Twice(i) = Want then
    begin
      Result := i * 1000 + s;
      Exit;
    end;
    if s > 1000000 then
      Exit(-2);
  end;
end;

{ break and continue out of an island, its writes seen after }
function BreakOut(N: Integer): Integer;
var
  i, s, last: Integer;
begin
  s := 0;
  last := -1;
  i := 0;
  while i < N do
  begin
    i := i + 1;
    if Odd3(i) then
    begin
      last := Twice(i);
      if last > 50 then
        Break;
      Continue;
    end;
    s := s + i;
  end;
  Result := s * 1000 + last + i;
end;

{ a raise from a call in the loop, caught outside it: what the loop
  wrote is home }
function Raises(N: Integer): Integer;
var
  i, s, t: Integer;
begin
  s := 0;
  t := 0;
  try
    for i := 0 to N - 1 do
    begin
      s := s + i;
      t := t xor (s + 1);
      if i = 37 then
        raise Exception.Create('at 37');
      t := t + Twice(i);
    end;
  except
    on E: Exception do
      s := s * 10 + 7;
  end;
  Result := s + t;
end;

{ a call that grows the stack: a pointer into this frame is relocated }
function Deep(N: Integer): Integer;
var
  pad: array[0..63] of Integer;
begin
  pad[N and 63] := N;
  if N = 0 then
    Result := 0
  else
    Result := Deep(N - 1) + pad[N and 63] - N + 1;
end;

function StackPtr(N: Integer): Integer;
var
  arr: array[0..7] of Integer;
  p: ^Integer;
  i, s: Integer;
begin
  for i := 0 to 7 do
    arr[i] := i * 11;
  p := @arr[3];
  s := 0;
  for i := 0 to N - 1 do
  begin
    s := s + p^;
    if i mod 4 = 0 then
      s := s + Deep(2000 + i);
    p^ := p^ + 1;
  end;
  Result := s + arr[3];
end;

{ objects only the loop's registers hold while a call churns the heap }
procedure Churn;
var
  k: Integer;
  b: TBox;
  s: string;
begin
  for k := 0 to 1999 do
  begin
    b := TBox.Create(k);
    s := IntToStr(b.V) + 'x';
    churned := churned + Length(s);
  end;
end;

function Held(N: Integer): Integer;
var
  i, s: Integer;
  a, b, x: TBox;
begin
  a := TBox.Create(5);
  b := TBox.Create(9);
  s := 0;
  for i := 0 to N - 1 do
  begin
    s := s + a.V * b.V;
    { x alone holds a's object once a holds b's: its register goes home
      before a call that may collect and does not name it }
    x := a;
    a := b;
    Churn;
    s := s + x.V;
    s := s xor (x.V shl 2);
    s := s + (x.V and 7) * i;
    if i mod 3 = 0 then
      b := TBox.Create(b.V + 2)
    else
      b := TBox.Create(x.V + 1);
  end;
  Result := s + a.V + b.V;
end;

{ Result written by the loop and read by its calls' neighbours }
function ResLoop(N: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to N do
  begin
    Result := Result + i;
    Result := Result xor Twice(Result and 15);
  end;
end;

{ recursive, so never put in place: a call in the test of an if }
function Probe(X: Integer): Boolean;
begin
  if X > 1000000 then
    Result := Probe(X - 1)
  else
    Result := (X mod 7) = 6;
end;

{ an exit in the arm of an island whose test calls: Result, which the
  loop wrote in its register, reaches its home before the island }
function ExitArm(N: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  for i := 0 to N do
  begin
    Result := i * 2 + 1;
    if Probe(i) then
      Exit;
  end;
end;

function ExitArmW(N: Integer): Integer;
var
  i: Integer;
begin
  Result := -1;
  i := 0;
  while i <= N do
  begin
    Result := Result + i;
    if Probe(i + 100) then
      Exit;
    i := i + 1;
  end;
end;

{ a region that raises from an island, caught one call up: the try
  gives back the registers the region had, so the caller's loop finds
  its own in them }
function Thrower(N: Integer): Integer;
var
  i, a, b, c, d: Integer;
begin
  a := 1;
  b := 2;
  c := 3;
  d := 4;
  for i := 0 to N do
  begin
    a := a + b;
    b := b xor c;
    c := c + d;
    d := d + a;
    if i = N then
      raise Exception.Create('thrown');
  end;
  Result := a + b + c + d;
end;

function Catcher(N: Integer): Integer;
begin
  try
    Result := Thrower(N);
  except
    on E: Exception do
      Result := -Length(E.Message);
  end;
end;

{ a loop whose variables stay in registers across calls that raise and
  catch, exit from an island and break out of one }
function Across(N: Integer): Integer;
var
  i, s, t, u, w: Integer;
begin
  s := 0;
  t := 5;
  u := 7;
  w := 11;
  for i := 1 to N do
  begin
    s := s + t * u + w;
    s := s + Catcher(i and 7);
    t := t xor i;
    s := s + FindTwice(i, 2 * (i div 2));
    u := u + 1;
    s := s + BreakOut(i);
    w := w + t;
  end;
  Result := s + t + u + w;
end;

{ a record field written through the loop's variables }
function Fields(N: Integer): Integer;
var
  r: TPair;
  i: Integer;
begin
  r.A := 1;
  r.B := 2;
  for i := 0 to N - 1 do
  begin
    r.A := r.A + r.B;
    r.B := Twice(r.B) and 4095;
  end;
  Result := r.A + r.B;
end;

begin
  WriteLn('every ', EveryPass(1000));
  WriteLn('few ', FewPasses(10000));
  WriteLn('outer ', OuterCalls(300));
  WriteLn('inner ', InnerCalls(300));
  WriteLn('island ', IslandLoop(200));
  WriteLn('var ', VarArg(500));
  WriteLn('closure ', Closure(100));
  WriteLn('find ', FindTwice(100, 84), ' ', FindTwice(100, 3), ' ', FindTwice(5000, -1));
  WriteLn('break ', BreakOut(100), ' ', BreakOut(10));
  WriteLn('raise ', Raises(100));
  WriteLn('stack ', StackPtr(40));
  churned := 0;
  WriteLn('held ', Held(60), ' ', churned);
  WriteLn('result ', ResLoop(1000));
  WriteLn('exitarm ', ExitArm(20), ' ', ExitArm(3), ' ', ExitArmW(20), ' ', ExitArmW(2));
  WriteLn('fields ', Fields(100));
  WriteLn('across ', Across(60));
  { the main block's own globals, in a loop that calls }
  gsum := 0;
  gk := 1;
  for gi := 1 to 500 do
  begin
    gsum := gsum + gk;
    gk := (Twice(gk) + gi) and 65535;
    gsum := gsum xor gi;
  end;
  WriteLn('main ', gsum, ' ', gk, ' ', gi);
end.

