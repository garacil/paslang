{ The string kernels of passtr (P134) held to their Pascal bodies:
  IndexByte, MemEq, CmpByte (P147), CaseCmp (P128) and CaseMap, each on
  the processor's extension (Cpu)
  and on the base processor (Base), over every length to 160 at every
  alignment to 33, the byte sought at each place and nowhere, the runs
  equal and differing at each byte, and ending at a page's end, where
  a load may not cross into the next page. Run under -cpu native and
  -cpu base on both machines. }
program strkern;

const
  MaxLen = 160;
  MaxAlign = 33;

var
  buf, other, dst1, dst2, dst3: string;
  base, p, q: PByte;
  len, al, k, i, bad, calls: Integer;
  r1, r2, r3: Integer;
  e1, e2, e3: Boolean;
  seed: Integer;

function Next: Integer;
begin
  seed := (seed * 1103515245 + 12345) and $7fffffff;
  Result := seed shr 8;
end;

procedure Check(Ok: Boolean; const What: string; L, A, K: Integer);
begin
  if not Ok then
  begin
    bad := bad + 1;
    if bad < 10 then
      WriteLn('bad ', What, ' len ', L, ' align ', A, ' at ', K);
  end;
end;

begin
  bad := 0;
  calls := 0;
  seed := 7;
  buf := StringOfChar('.', 4 * 4096);
  other := StringOfChar('.', 4 * 4096);
  base := PByte(@buf[1]);
  { IndexByte }
  for len := 0 to MaxLen do
    for al := 0 to MaxAlign do
    begin
      p := PByte(Pointer(Integer(base) + al));
      for i := 0 to len - 1 do
        p[i] := Byte(97 + i mod 20);
      for k := -1 to len - 1 do
      begin
        if k >= 0 then
          p[k] := 90;
        r1 := PasIndexBytePlain(p, len, 90);
        r2 := PasIndexByteCpu(p, len, 90);
        r3 := PasIndexByteBase(p, len, 90);
        Check((r1 = r2) and (r1 = r3) and (r1 = k), 'indexbyte', len, al, k);
        calls := calls + 1;
        if k >= 0 then
          p[k] := Byte(97 + k mod 20);
      end;
    end;
  { ending at a page's end }
  p := PByte(Pointer((Integer(base) + 8191) and not 4095));
  for len := 0 to 64 do
  begin
    q := PByte(Pointer(Integer(p) - len));
    for i := 0 to len - 1 do
      q[i] := Byte(65 + i mod 26);
    for k := -1 to len - 1 do
    begin
      if k >= 0 then
        q[k] := 33;
      r1 := PasIndexBytePlain(q, len, 33);
      r2 := PasIndexByteCpu(q, len, 33);
      r3 := PasIndexByteBase(q, len, 33);
      Check((r1 = r2) and (r1 = r3) and (r1 = k), 'indexbyte page', len, 0, k);
      e1 := PasMemEqPlain(q, PByte(@other[1]), len);
      e2 := PasMemEqCpu(q, PByte(@other[1]), len);
      e3 := PasMemEqBase(q, PByte(@other[1]), len);
      Check((e1 = e2) and (e1 = e3), 'memeq page', len, 0, k);
      calls := calls + 1;
      if k >= 0 then
        q[k] := Byte(65 + k mod 26);
    end;
  end;
  WriteLn('indexbyte ', bad);
  { MemEq }
  for len := 0 to MaxLen + 40 do
    for al := 0 to MaxAlign do
    begin
      p := PByte(Pointer(Integer(base) + al));
      q := PByte(Pointer(Integer(@other[1]) + (al * 7) mod 33));
      for i := 0 to len - 1 do
      begin
        p[i] := Byte(Next and 255);
        q[i] := p[i];
      end;
      for k := -1 to len - 1 do
      begin
        if k >= 0 then
          q[k] := Byte(q[k] xor (1 shl (k mod 8)));
        e1 := PasMemEqPlain(p, q, len);
        e2 := PasMemEqCpu(p, q, len);
        e3 := PasMemEqBase(p, q, len);
        Check((e1 = e2) and (e1 = e3) and (e1 = (k < 0)), 'memeq', len, al, k);
        calls := calls + 1;
        if k >= 0 then
          q[k] := p[k];
      end;
    end;
  WriteLn('memeq ', bad);
  { CmpByte (P147): the difference at each place, a byte above and one
    below, at every length and alignment of both runs; at a page's end;
    a count not above 0 }
  for len := 0 to MaxLen + 40 do
    for al := 0 to MaxAlign do
    begin
      p := PByte(Pointer(Integer(base) + al));
      q := PByte(Pointer(Integer(@other[1]) + (al * 5) mod 33));
      for i := 0 to len - 1 do
      begin
        p[i] := Byte(Next and 255);
        q[i] := p[i];
      end;
      for k := -1 to len - 1 do
        for i := 0 to 1 do
        begin
          if k >= 0 then
          begin
            if i = 0 then
              q[k] := Byte(q[k] + 1 + k mod 7)
            else
              q[k] := Byte(q[k] - 1 - k mod 5);
          end;
          r1 := PasCmpBytePlain(p, q, len);
          r2 := PasCmpByteCpu(p, q, len);
          r3 := PasCmpByteBase(p, q, len);
          Check((r1 = r2) and (r1 = r3) and ((r1 = 0) = (k < 0) or (p[k] = q[k])), 'cmpbyte', len, al, k);
          calls := calls + 1;
          if k >= 0 then
            q[k] := p[k];
        end;
    end;
  p := PByte(Pointer((Integer(base) + 8191) and not 4095));
  q := PByte(Pointer((Integer(@other[1]) + 8191) and not 4095));
  for len := 0 to 80 do
  begin
    for i := 1 to len do
    begin
      PByte(Pointer(Integer(p) - i))^ := Byte(i * 3);
      PByte(Pointer(Integer(q) - i))^ := Byte(i * 3);
    end;
    for k := 1 to len do
    begin
      PByte(Pointer(Integer(q) - k))^ := Byte(k * 3 + 9);
      r1 := PasCmpBytePlain(PByte(Pointer(Integer(p) - len)), PByte(Pointer(Integer(q) - len)), len);
      r2 := PasCmpByteCpu(PByte(Pointer(Integer(p) - len)), PByte(Pointer(Integer(q) - len)), len);
      r3 := PasCmpByteBase(PByte(Pointer(Integer(p) - len)), PByte(Pointer(Integer(q) - len)), len);
      Check((r1 = r2) and (r1 = r3) and (r1 <> 0), 'cmpbyte page', len, 0, k);
      PByte(Pointer(Integer(q) - k))^ := Byte(k * 3);
      calls := calls + 1;
    end;
  end;
  for len := -3 to 0 do
  begin
    Check((PasCmpByteCpu(base, PByte(@other[1]), len) = 0) and
      (PasCmpByteBase(base, PByte(@other[1]), len) = 0), 'cmpbyte none', len, 0, 0);
    Check((PasIndexByteCpu(base, len, 46) = -1) and (PasIndexByteBase(base, len, 46) = -1),
      'indexbyte none', len, 0, 0);
  end;
  WriteLn('cmpbyte ', bad);
  { CaseCmp (P128): bytes around the letters' ranges, the other run the
    same with the case of its letters changed at random (equal as
    capitals), then a byte that differs as a capital at each place }
  for len := 0 to MaxLen + 40 do
    for al := 0 to MaxAlign do
    begin
      p := PByte(Pointer(Integer(base) + al));
      q := PByte(Pointer(Integer(@other[1]) + (al * 3) mod 33));
      for i := 0 to len - 1 do
      begin
        case Next mod 12 of
          0: p[i] := 64;
          1: p[i] := 91;
          2: p[i] := 96;
          3: p[i] := 123;
          4: p[i] := 0;
          5: p[i] := 255;
          6, 7: p[i] := Byte(65 + Next mod 26);
          8, 9: p[i] := Byte(97 + Next mod 26);
        else
          p[i] := Byte(Next and 255);
        end;
        q[i] := p[i];
        if ((q[i] >= 65) and (q[i] <= 90) or (q[i] >= 97) and (q[i] <= 122)) and (Next mod 2 = 0) then
          q[i] := q[i] xor 32;
      end;
      for k := -1 to len - 1 do
      begin
        e1 := True;
        if k >= 0 then
        begin
          i := q[k];
          if (p[k] >= 65) and (p[k] <= 90) or (p[k] >= 97) and (p[k] <= 122) then
            q[k] := Byte(((p[k] and 223) - 65 + 1 + k mod 25) mod 26 + 65 + 32 * (k mod 2))
          else
            q[k] := Byte(p[k] + 1);
          if (q[k] >= 97) and (q[k] <= 122) and (p[k] = q[k] - 32) then
            e1 := False;
        end;
        r1 := PasCaseCmpPlain(p, q, len);
        r2 := PasCaseCmpCpu(p, q, len);
        r3 := PasCaseCmpBase(p, q, len);
        Check((r1 = r2) and (r1 = r3) and ((r1 = 0) = (k < 0)) or not e1, 'casecmp', len, al, k);
        calls := calls + 1;
        if k >= 0 then
          q[k] := Byte(i);
      end;
    end;
  WriteLn('casecmp ', bad);
  { CaseMap }
  for len := 0 to MaxLen do
    for al := 0 to 3 do
    begin
      p := PByte(Pointer(Integer(base) + al));
      for i := 0 to len - 1 do
        p[i] := Byte(Next and 255);
      for k := 0 to 1 do
      begin
        dst1 := StringOfChar('#', len + 1);
        dst2 := StringOfChar('#', len + 1);
        dst3 := StringOfChar('#', len + 1);
        PasCaseMapPlain(p, @dst1[1], len, k = 1);
        PasCaseMapCpu(p, @dst2[1], len, k = 1);
        PasCaseMapBase(p, @dst3[1], len, k = 1);
        Check((dst1 = dst2) and (dst1 = dst3), 'casemap', len, al, k);
        calls := calls + 1;
      end;
    end;
  WriteLn('casemap ', bad);
  WriteLn(calls, ' calls');
end.

