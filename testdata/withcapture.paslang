program withcapture;
{ P166: a closure pins the binding, its target outlives the frame, and
  each with over a value owns a distinct record. Go escape.go's two
  lifetime invariants, with Pascal's mutable by-reference captures. }
type
  TR = record
    X, Y: Integer;
    Text: string;
    Data: ^Integer;
  end;
  PR = ^TR;
  TF = function: Integer;
  TMaker = function: TF;
  TFunctions = array of TF;

function Make(N: Integer): TR;
begin
  Result.X := N;
  Result.Y := N * 2;
  Result.Text := 'kept';
end;

function CapturePlace(N: Integer): TF;
var
  R: TR;
begin
  R := Make(N);
  with R do
    Result := function: Integer
    begin
      X := X + 1;
      Result := X + Y + Length(Text);
    end;
end;

function CaptureValues: TFunctions;
var
  I: Integer;
begin
  Result := nil;
  for I := 1 to 3 do
    with Make(I) do
      Result := Append(Result, function: Integer
      begin
        X := X + 1;
        Result := X + Y + Length(Text);
      end);
end;

function CapturePointer(N: Integer): TF;
var
  R: TR;
  P: PR;
begin
  R := Make(N);
  P := @R;
  with P^ do
    Result := function: Integer
    begin
      X := X + 1;
      Result := X + Y + Length(Text);
    end;
end;

function CaptureFieldPointer: TF;
var
  N: Integer;
  R: TR;
begin
  N := 70;
  R := Make(1);
  R.Data := @N;
  with R do
    Result := function: Integer
    begin
      Data^ := Data^ + 1;
      Result := Data^;
    end;
end;

function CaptureElements: TFunctions;
var
  Items: array[0..2] of TR;
  I: Integer;
begin
  Result := nil;
  for I := 0 to 2 do
  begin
    Items[I] := Make(I + 1);
    with Items[I] do
      Result := Append(Result, function: Integer
      begin
        X := X + 1;
        Result := X + Y + Length(Text);
      end);
  end;
  Items[0].Y := 100;
end;

function CaptureNested: TMaker;
begin
  with Make(10) do
    Result := function: TF
    begin
      Result := function: Integer
      begin
        X := X + 1;
        Result := X + Y + Length(Text);
      end;
    end;
end;

function CaptureConst(const R: TR): TF;
begin
  with R do
    Result := function: Integer
    begin
      Result := X + Y + Length(Text);
    end;
end;

function CaptureCopy(R: TR): TF;
begin
  with R do
    Result := function: Integer
    begin
      X := X + 1;
      Result := X + Y;
    end;
end;

var
  F, G, H, PointerF, FieldF: TF;
  Maker: TMaker;
  Values, Elements: TFunctions;
  R: TR;
begin
  F := CapturePlace(10);
  PointerF := CapturePointer(10);
  FieldF := CaptureFieldPointer;
  Values := CaptureValues;
  Elements := CaptureElements;
  Maker := CaptureNested;
  R := Make(7);
  G := CaptureConst(R);
  H := CaptureCopy(R);
  GcCollect;
  WriteLn('place ', F(), ' ', F());
  WriteLn('pointer ', PointerF(), ' ', PointerF());
  WriteLn('field-pointer ', FieldF(), ' ', FieldF());
  WriteLn('values ', Values[0](), ' ', Values[1](), ' ', Values[2]());
  WriteLn('elements ', Elements[0](), ' ', Elements[1](), ' ', Elements[2]());
  F := Maker();
  GcCollect;
  WriteLn('nested ', F(), ' ', F());
  WriteLn('const ', G(), ' ', G());
  WriteLn('copy ', H(), ' ', H(), ' caller ', R.X, ' ', R.Y);
  GcCollect;
  WriteLn('values-again ', Values[0](), ' ', Values[1](), ' ', Values[2]());
end.
