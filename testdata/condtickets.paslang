program condtickets;

const Waiters = 32;
var
  mu: mutex;
  changed: cond;
  ready, finished: chan of Integer;

procedure Waiter(Id: Integer);
begin
  mu.Lock;
  Send(ready, Id);
  changed.Wait(mu);
  mu.Unlock;
  Send(finished, Id);
end;

procedure LaunchWaiters;
var
  id, greeted: Integer;
begin
  for id := 1 to Waiters do
  begin
    pas Waiter(id);
    greeted := Recv(ready);
    if greeted <> id then Halt(2);
    { The waiter took its ticket before releasing this mutex. }
    mu.Lock;
    mu.Unlock;
  end;
end;

var
  i, got: Integer;
  seen: array[1..Waiters] of Boolean;
begin
  ready := MakeChan(1);
  finished := MakeChan(Waiters);
  {$if PASLANG_FULLVERSION >= 1003046}
  { Cross the 63-bit wrap during the first group of reservations. }
  changed.Waited := High(Integer) - 2;
  changed.Notified := changed.Waited;
  {$endif}
  LaunchWaiters;
  for i := 1 to Waiters do
  begin
    changed.Signal;
    got := Recv(finished);
    if got <> i then
    begin
      WriteLn('ticket order: expected ', i, ', got ', got);
      Halt(1);
    end;
  end;
  changed.Signal;
  changed.Broadcast;
  LaunchWaiters;
  changed.Broadcast;
  for i := 1 to Waiters do
  begin
    got := Recv(finished);
    if (got < 1) or (got > Waiters) or seen[got] then Halt(3);
    seen[got] := True;
  end;
  WriteLn('condition tickets ok');
end.
