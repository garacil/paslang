{ P553: the bits of an integer seen as a Double (n as Double) as an operand of Double arithmetic: the integer
  in a register and a movq, where a push and a pop carried it. Each shape is worked out with the view and
  with the Double the bytes of n make (Move), and the 64 bits of the two results must be the same. The
  patterns are zeros of both signs, ones, a denormal, the largest, the infinities, NaN, and numbers of
  every size. }
program bitview;

var
  pats: array[0..13] of Int64 = (
    0, $8000000000000000, $3FF0000000000000, $BFF0000000000000, $0000000000000001, $000FFFFFFFFFFFFF,
    $7FEFFFFFFFFFFFFF, $7FF0000000000000, $FFF0000000000000, $7FF8000000000000, $400921FB54442D18,
    $C0F86A0000000000, $3C9CD2B297D889BC, $5FE0000000000000);
  bad, total: Integer;

function Same(a, b: Double): Boolean;
begin
  if (a <> a) and (b <> b) then
    Result := True
  else
    Result := (a as Int64) = (b as Int64);
end;

procedure Check(const Name: string; a, b: Double);
begin
  Inc(total);
  if not Same(a, b) then
  begin
    Inc(bad);
    WriteLn(Name, ' differs');
  end;
end;

{ n in a frame slot, one operation on the view }
function F1(a: Double; n: Int64): Double;
begin
  Result := a * (n as Double);
end;

function F2(a: Double; n: Int64): Double;
begin
  Result := (n as Double) - a;
end;

function F3(a: Double; n: Int64): Double;
begin
  Result := a / (n as Double);
end;

function F4(a: Double; n: Int64): Double;
begin
  Result := (n as Double) / a + a;
end;

function F5(a: Double; n: Int64): Double;
begin
  Result := Abs(n as Double) * a;
end;

function F6(a: Double; n: Int64): Double;
begin
  Result := -(n as Double) + a * a;
end;

{ the view of a computed integer }
function F7(a: Double; n: Int64): Double;
begin
  Result := a + ((n xor $4000000000000000) as Double);
end;

{ a Horner chain with the view as a coefficient }
function F8(a: Double; n: Int64): Double;
begin
  Result := (((a * 0.5 + (n as Double)) * a + 1.25) * a + (n as Double)) * a;
end;

{ a loop: the integer in a register, the Double in another }
function F9(a: Double; n: Int64): Double;
var
  i: Integer;
  x: Double;
begin
  x := a;
  for i := 1 to 4 do
  begin
    x := x * 0.75 + (n as Double);
    n := n + 1;
  end;
  Result := x;
end;

function F10(a: Double; n: Int64): Double;
var
  x: Double;
begin
  x := a;
  x := x - (n as Double) * 0.5;
  if (n as Double) < x then
    x := x + 1.0
  else
    x := x - 1.0;
  Result := x;
end;

{ the same with the Double of the bytes of n }
function G1(a, d: Double): Double;
begin
  Result := a * d;
end;

function G2(a, d: Double): Double;
begin
  Result := d - a;
end;

function G3(a, d: Double): Double;
begin
  Result := a / d;
end;

function G4(a, d: Double): Double;
begin
  Result := d / a + a;
end;

function G5(a, d: Double): Double;
begin
  Result := Abs(d) * a;
end;

function G6(a, d: Double): Double;
begin
  Result := -d + a * a;
end;

function G8(a, d: Double): Double;
begin
  Result := (((a * 0.5 + d) * a + 1.25) * a + d) * a;
end;

function G9(a: Double; n: Int64): Double;
var
  i: Integer;
  x, d: Double;
begin
  x := a;
  for i := 1 to 4 do
  begin
    Move(n, d, 8);
    x := x * 0.75 + d;
    n := n + 1;
  end;
  Result := x;
end;

function G10(a, d: Double): Double;
var
  x: Double;
begin
  x := a;
  x := x - d * 0.5;
  if d < x then
    x := x + 1.0
  else
    x := x - 1.0;
  Result := x;
end;

var
  i, j: Integer;
  n, m: Int64;
  d, d2, a: Double;
  as_: array[0..4] of Double = (0.0, 1.0, -2.5, 3.75e10, 1e-300);

begin
  bad := 0;
  total := 0;
  for i := 0 to 13 do
  begin
    n := pats[i];
    Move(n, d, 8);
    m := n xor $4000000000000000;
    Move(m, d2, 8);
    for j := 0 to 4 do
    begin
      a := as_[j];
      Check('F1', F1(a, n), G1(a, d));
      Check('F2', F2(a, n), G2(a, d));
      Check('F3', F3(a, n), G3(a, d));
      Check('F4', F4(a, n), G4(a, d));
      Check('F5', F5(a, n), G5(a, d));
      Check('F6', F6(a, n), G6(a, d));
      Check('F7', F7(a, n), a + d2);
      Check('F8', F8(a, n), G8(a, d));
      Check('F9', F9(a, n), G9(a, n));
      Check('F10', F10(a, n), G10(a, d));
    end;
  end;
  if bad = 0 then
    WriteLn('bitview ok ', total)
  else
    WriteLn('bitview FAIL ', bad, ' of ', total);
end.
