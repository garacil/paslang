program strcow;

{ Strings are values (1.0.82): a write through one string never shows
  through another, however they came to share their characters: an
  assignment, a literal, a parameter, a record or an array copied whole,
  a map, a grown slice, a loop over a map. The characters are copied
  once, on the first write after the sharing. }

type
  TPair = record
    Name: string;
    N: Integer;
    Tags: array[0..1] of string;
  end;
  TNames = array of string;

const
  Greeting: string = 'hello';

procedure Poke(S: string);
begin
  S[1] := 'X';
  WriteLn('in: ', S);
end;

var
  s, t, u: string;
  p, q: TPair;
  a: array[0..2] of string;
  b: array[0..2] of string;
  d, e: TNames;
  m: map[string] of string;
  k, v: string;
  pc: ^Char;
  i: Integer;

begin
  s := 'abc';
  t := s;
  s[1] := 'X';
  WriteLn(s, ' ', t);
  t := Greeting;
  t[5] := '!';
  WriteLn(t, ' ', Greeting);
  s := 'orig';
  Poke(s);
  WriteLn('out: ', s);
  p.Name := 'rec';
  p.Tags[0] := 'zero';
  p.Tags[1] := 'one';
  q := p;
  q.Name[1] := 'R';
  q.Tags[1][1] := 'O';
  WriteLn(p.Name, ' ', p.Tags[1], ' ', q.Name, ' ', q.Tags[1]);
  a[0] := 'x0';
  a[1] := 'x1';
  a[2] := 'x2';
  b := a;
  b[2][2] := '9';
  WriteLn(a[2], ' ', b[2]);
  SetLength(d, 2);
  d[0] := 'd0';
  d[1] := 'd1';
  e := d;
  SetLength(d, 100);
  d[1][2] := '#';
  WriteLn(e[1], ' ', d[1]);
  New(m);
  s := 'key';
  u := 'val';
  m[s] := u;
  s[1] := 'K';
  u[1] := 'V';
  WriteLn(m['key'], ' ', s, ' ', u);
  for k, v in m do
  begin
    k[1] := 'Q';
    v[1] := 'Q';
    WriteLn(k, ' ', v);
  end;
  WriteLn(m['key']);
  s := 'pointer';
  t := s;
  pc := @s[1];
  pc^ := 'P';
  WriteLn(s, ' ', t);
  s := 'inc';
  t := s;
  Inc(s[1]);
  WriteLn(s, ' ', t);
  s := 'loop';
  t := s;
  for i := 1 to Length(s) do
    s[i] := Chr(Ord(s[i]) - 32);
  WriteLn(s, ' ', t);
  s := Copy(t, 2, 2);
  s[1] := '_';
  WriteLn(s, ' ', t);
  s := t + '!';
  s[1] := '=';
  WriteLn(s, ' ', t);
  s := ParamStr(0);
  s[1] := '*';
  WriteLn(s[1], ' ', ParamStr(0)[1] <> '*');
end.

