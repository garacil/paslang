program closures;

{ Closures (P109, 1.0.134): anonymous routines that keep their outer
  variables by reference in a heap box, a nested routine as a value,
  pas of a nested routine, a loop counter that is each pass's own
  (Go 1.22), for x in a slice, and the variables two routines out. }

uses paslib;

type
  TGen = function: Integer;
  TAct = procedure;
  TMap = function(X: Integer): Integer;
  TAdder = class
    Base: Integer;
    function Maker: TMap;
  end;

function TAdder.Maker: TMap;
begin
  Result := function(X: Integer): Integer
  begin
    Result := X + Base;
  end;
end;

function Counter(Start: Integer): TGen;
var
  n: Integer;
begin
  n := Start;
  Result := function: Integer
  begin
    n := n + 1;
    Result := n;
  end;
end;

procedure Twice(A: TAct);
begin
  A;
  A;
end;

function Apply(F: TMap; X: Integer): Integer;
begin
  Result := F(X);
end;

procedure Shared;
var
  total: Integer;
  add, show: TAct;
  procedure Bump;
  begin
    total := total + 100;
  end;
begin
  total := 1;
  add := procedure
  begin
    total := total + 10;
  end;
  show := procedure
  begin
    WriteLn('total ', total);
  end;
  Twice(add);
  show;
  Twice(@Bump);
  show;
  total := total * 2;
  show;
end;

procedure Loops;
var
  i: Integer;
  fs: array[0..3] of TGen;
  s: string;
  words: array of string;
  gs: array of TGen;
begin
  for i := 0 to 3 do
    fs[i] := function: Integer
    begin
      Result := i * 10;
    end;
  WriteLn(fs[0](), ' ', fs[1](), ' ', fs[2](), ' ', fs[3](), ' after ', i);
  words := ['a', 'bb', 'ccc'];
  for s in words do
    gs := Append(gs, function: Integer
    begin
      Result := Length(s);
    end);
  WriteLn(gs[0](), gs[1](), gs[2]());
end;

procedure Nested2;
var
  a: Integer;
  outer: TGen;
begin
  a := 5;
  outer := function: Integer
  var
    b: Integer;
    inner: TGen;
  begin
    b := 7;
    inner := function: Integer
    begin
      a := a + 1;
      Result := a * 100 + b;
    end;
    Result := inner() + inner();
  end;
  WriteLn('nested ', outer(), ' a ', a);
end;

procedure Workers;
var
  sum: Integer;
  wg: waitgroup;
  mu: mutex;
  procedure Work;
  begin
    lock mu do
      sum := sum + 1;
    wg.Done;
  end;
var
  k: Integer;
begin
  sum := 0;
  for k := 1 to 8 do
  begin
    wg.Add(1);
    pas Work;
  end;
  wg.Wait;
  WriteLn('workers ', sum);
end;

function MakeAcc: TMap;
var
  total: Integer;
begin
  total := 0;
  Result := function(X: Integer): Integer
  begin
    total := total + X;
    Result := total;
  end;
end;

function Deep(N: Integer): Integer;
var
  pad: array[0..63] of Integer;
  s: string;
begin
  pad[N and 63] := N;
  s := 'x' + IntToStr(N);
  if N = 0 then
    Result := 0
  else
    Result := Deep(N - 1) + pad[N and 63] - N + Length(s) - Length(s);
end;

procedure Params(P: Integer; const S: string);
var
  f: TAct;
  r: record
    A, B: Integer;
    T: string;
  end;
begin
  r.A := 1;
  r.T := S;
  f := procedure
  begin
    P := P * 2;
    r.A := r.A + P;
    r.T := r.T + '!';
  end;
  f;
  f;
  WriteLn('params ', P, ' ', r.A, ' ', r.T);
end;

procedure Passes;
var
  i: Integer;
  fs: array of TGen;
  sum: Integer;
begin
  for i := 0 to 9 do
  begin
    if i mod 2 = 0 then
      continue;
    fs := Append(fs, function: Integer
    begin
      Result := i;
    end);
    if i = 7 then
      break;
  end;
  sum := 0;
  for i := 0 to High(fs) do
    sum := sum * 10 + fs[i]();
  WriteLn('passes ', sum, ' ', Length(fs));
  fs := nil;
  for i := 0 to 5 do
  begin
    fs := Append(fs, function: Integer
    begin
      Result := i;
    end);
    i := i + 1;
  end;
  sum := 0;
  for i := 0 to High(fs) do
    sum := sum * 10 + fs[i]();
  WriteLn('changed ', sum, ' ', Length(fs));
end;

procedure Grand;
var
  g: Integer;
  procedure Mid;
  var
    m: Integer;
    procedure Leaf;
    begin
      g := g + m;
    end;
  begin
    m := 5;
    Twice(@Leaf);
  end;
begin
  g := 1;
  Mid;
  WriteLn('grand ', g);
end;

procedure Chans;
var
  c: chan of Integer;
  base: Integer;
  procedure Send3;
  var
    k: Integer;
  begin
    for k := 1 to 3 do
      Send(c, base + k);
  end;
var
  got: Integer;
begin
  c := MakeChan(3);
  base := 40;
  pas Send3;
  got := Recv(c) + Recv(c) + Recv(c);
  WriteLn('chans ', got);
end;

procedure More;
var
  acc: TMap;
  fib: TMap;
  i: Integer;
  junk: string;
begin
  acc := MakeAcc;
  WriteLn('deep ', Deep(3000));
  for i := 1 to 20000 do
    junk := 'j' + IntToStr(i);
  acc(5);
  WriteLn('acc ', acc(10), ' ', acc(0));
  Params(3, 'ab');
  fib := function(X: Integer): Integer
  begin
    if X < 2 then
      Result := X
    else
      Result := fib(X - 1) + fib(X - 2);
  end;
  WriteLn('fib ', fib(20));
  Passes;
  Grand;
  Chans;
end;

var
  g1, g2: TGen;
  glob: Integer;
  ad: TAdder;
  m: TMap;
  j: Integer;
  hs: array[0..2] of TGen;

begin
  g1 := Counter(10);
  g2 := Counter(100);
  WriteLn(g1(), ' ', g1(), ' ', g2(), ' ', g1(), ' ', g2());
  Shared;
  Loops;
  Nested2;
  glob := 3;
  m := function(X: Integer): Integer
  begin
    Result := X * glob;
  end;
  glob := 4;
  WriteLn('glob ', Apply(m, 5));
  ad := TAdder.Create;
  ad.Base := 1000;
  m := ad.Maker;
  ad.Base := 2000;
  WriteLn('method ', m(1));
  for j := 0 to 2 do
    hs[j] := function: Integer
    begin
      Result := j + 1;
    end;
  WriteLn('main loop ', hs[0](), hs[1](), hs[2](), ' ', j);
  Workers;
  More;
end.
