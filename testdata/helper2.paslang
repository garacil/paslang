{ Type helpers (P127), more: a helper that descends from another, an
  indexed property and one written through its method, a const and a
  value parameter as the value, an array's element and a record's field
  as the value, recursion, a nested routine that sees the record's
  fields, a helper for a set, and a class helper whose method hides the
  class's. The same source compiles with Free Pascal, whose output is
  the one expected. }
program helper2;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$modeswitch typehelpers}
{$modeswitch advancedrecords}
{$endif}

type
  TBase = type helper for string
    function First: Char;
    function GetChar(I: Integer): Char;
    procedure SetChar(I: Integer; C: Char);
    property Chars[I: Integer]: Char read GetChar write SetChar;
  end;

  TMore = type helper(TBase) for string
    function Last: Char;
    function Around: string;
    function GetSize: Integer;
    procedure SetSize(N: Integer);
    property Size: Integer read GetSize write SetSize;
  end;

  TCounter = type helper for Integer
    procedure Bump;
    function Twice: Integer;
    function Fact: Integer;
  end;

  TPair = record
    A, B: Integer;
  end;

  TPairHelper = record helper for TPair
    function Total: Integer;
    procedure Swap;
    function Scaled(K: Integer): Integer;
  end;

  TColor = (Red, Green, Blue);
  TColors = set of TColor;

  TColorsHelper = type helper for TColors
    function Count: Integer;
  end;

  TAnimal = class
    function Speak: string;
  end;

  TAnimalHelper = class helper for TAnimal
    function Speak: string;
    function Loud: string;
  end;

function TBase.First: Char;
begin
  Result := Self[1];
end;

function TBase.GetChar(I: Integer): Char;
begin
  Result := Self[I];
end;

procedure TBase.SetChar(I: Integer; C: Char);
begin
  Self[I] := C;
end;

function TMore.Last: Char;
begin
  Result := Self[Length(Self)];
end;

function TMore.Around: string;
begin
  Result := First + '..' + Last;
end;

function TMore.GetSize: Integer;
begin
  Result := Length(Self);
end;

procedure TMore.SetSize(N: Integer);
begin
  SetLength(Self, N);
end;

procedure TCounter.Bump;
begin
  Self := Self + 1;
end;

function TCounter.Twice: Integer;
begin
  Result := Self * 2;
end;

function TCounter.Fact: Integer;
var
  n: Integer;
begin
  if Self <= 1 then
    Result := 1
  else
  begin
    n := Self - 1;
    Result := Self * n.Fact;
  end;
end;

function TPairHelper.Total: Integer;

  function Part(X: Integer): Integer;
  begin
    Result := X + B;
  end;

begin
  Result := Part(A);
end;

procedure TPairHelper.Swap;
var
  t: Integer;
begin
  t := A;
  A := B;
  B := t;
end;

function TPairHelper.Scaled(K: Integer): Integer;
begin
  Result := Total * K;
end;

function TColorsHelper.Count: Integer;
var
  c: TColor;
begin
  Result := 0;
  for c in Self do
    Result := Result + 1;
end;

function TAnimal.Speak: string;
begin
  Result := 'animal';
end;

function TAnimalHelper.Speak: string;
begin
  Result := 'helper';
end;

function TAnimalHelper.Loud: string;
begin
  Result := Speak + '!';
end;

procedure ShowConst(const S: string);
begin
  WriteLn(S.Around, ' ', S.Chars[2], ' ', S.Size);
end;

procedure GrowCopy(S: string);
begin
  S.Size := 2;
  WriteLn(S);
end;

function Name: string;
begin
  Result := 'paslang';
end;

var
  s: string;
  a: array[1..3] of Integer;
  p: TPair;
  n: Integer;
  cs: TColors;
  an: TAnimal;

begin
  s := 'hello';
  WriteLn(s.First, s.Last, ' ', s.Around, ' ', s.Chars[2], ' ', s.Size);
  s.Chars[1] := 'j';
  WriteLn(s);
  s.Size := 3;
  WriteLn(s, ' ', s.Size);
  ShowConst('world');
  GrowCopy(s);
  WriteLn(s, ' ', Name.Around, ' ', Name.Size);
  a[1] := 1;
  a[2] := 5;
  a[3] := 9;
  a[2].Bump;
  a[3].Bump;
  WriteLn(a[1], a[2], a[3], ' ', a[2].Twice, ' ', a[1].Twice.Twice);
  n := 5;
  WriteLn(n.Fact, ' ', n.Twice.Fact);
  p.A := 3;
  p.B := 4;
  p.Swap;
  WriteLn(p.A, p.B, ' ', p.Total, ' ', p.Scaled(10), ' ', p.A.Twice);
  p.A.Bump;
  WriteLn(p.A);
  cs := [Red, Blue];
  WriteLn(cs.Count);
  an := TAnimal.Create;
  WriteLn(an.Speak, ' ', an.Loud);
end.

