{ P204: json with the rest of the language. A json is one word, the
  address of a value in a document that never changes: a channel, a
  select, a map, a tree, a record, a class, a static and a dynamic
  array, a generic, a closure and a routine pas starts carry that word
  and nothing else, so the string a value holds is at the same address
  wherever it went. A helper of a program's own descends from
  TJsonHelper, case takes Kind, an array of const takes a json
  (vtJson, VJson) and Format's %s writes it, Write pads it, and a safe
  routine walks one. The same lines at -inline 0 and 40, with
  -checkptr, under the collector's stress and on both machines. }
program jsonlang;

uses
  sysutils;

type
  TItem = record
    Name: string;
    Data: json;
  end;

  TBox = class
    J: json;
    constructor Create(AJ: json);
  end;

  generic TPair<T> = record
    A, B: T;
  end;
  TJsonPair = specialize TPair<json>;

  TMine = type helper(TJsonHelper) for json
    function Twice: Integer;
    function Describe: string;
  end;

constructor TBox.Create(AJ: json);
begin
  J := AJ;
end;

function TMine.Twice: Integer;
begin
  Result := Self.AsInteger * 2;
end;

function TMine.Describe: string;
begin
  case Self.Kind of
    jkNull:
      Result := 'null';
    jkBoolean:
      Result := 'a Boolean';
    jkNumber:
      Result := 'a number';
    jkString:
      Result := 'a string of ' + IntToStr(Length(Self.AsString));
    jkArray:
      Result := 'an array of ' + IntToStr(Length(Self));
    jkObject:
      Result := 'an object of ' + IntToStr(Length(Self));
  end;
end;

{ No pointer work here, and a json is no pointer to the program. }
safe function Total(J: json): Integer;
var
  v: json;
begin
  Result := 0;
  for v in J do
    Result := Result + v.AsInteger;
end;

{ Where the characters of the string a json holds are: the same
  address is the same document, nothing copied. }
function At(J: json): Pointer;
begin
  Result := Pointer(J.AsString);
end;

procedure Sum(J: json; Into: chan of Integer);
begin
  Send(Into, Total(J));
end;

procedure Kinds(const Args: array of const);
var
  i: Integer;
begin
  for i := 0 to High(Args) do
    if Args[i].VType = vtJson then
      Write(' json ', JsonEncode(Args[i].VJson))
    else if Args[i].VType = vtInteger then
      Write(' integer ', Args[i].VInteger)
    else if Args[i].VType = vtAnsiString then
      Write(' string ', Args[i].VAnsiString)
    else
      Write(' kind ', Args[i].VType);
  WriteLn;
end;

var
  doc, got, v: json;
  name: Pointer;
  c: chan of json;
  ints: chan of Integer;
  m: map[string] of json;
  t: tree[Integer] of json;
  item: TItem;
  box: TBox;
  pair: TJsonPair;
  fixed: array[0..2] of json;
  dyn: array of json;
  pick: function(K: string): json;
  k: string;
  i, n: Integer;

begin
  doc := JsonParse('{"name":"paslang","list":[1,2,3,4],"nested":{"x":21,"none":null}}');
  name := At(doc['name']);

  { a channel and a select carry the word }
  c := MakeChan(2);
  Send(c, doc['name']);
  got := Recv(c);
  WriteLn('channel: ', got, ' ', At(got) = name);
  Send(c, doc['list']);
  select
    Recv(c, got): WriteLn('select: ', got, ' ', Length(got));
  else
    WriteLn('select: nothing');
  end;

  { a map, a tree, a record, a class, arrays, a generic }
  New(m);
  New(t);
  m['who'] := doc['name'];
  t[7] := doc['nested'];
  item.Name := 'item';
  item.Data := doc['name'];
  box := TBox.Create(doc['name']);
  fixed[1] := doc['name'];
  SetLength(dyn, 2);
  dyn[1] := doc['name'];
  pair.A := doc['name'];
  pair.B := doc['list'];
  WriteLn('map: ', m['who'], ' ', At(m['who']) = name, ' ', 'who' in m);
  WriteLn('tree: ', t[7]['x'], ' ', t[7]['none'].IsNull);
  WriteLn('record: ', item.Data, ' ', At(item.Data) = name);
  WriteLn('class: ', box.J, ' ', At(box.J) = name);
  WriteLn('arrays: ', fixed[1], ' ', dyn[1], ' ', At(fixed[1]) = name, ' ', At(dyn[1]) = name);
  WriteLn('generic: ', pair.A, ' ', pair.B, ' ', At(pair.A) = name);
  box.Free;

  { a closure keeps the document it was given }
  pick := function(K: string): json begin Result := doc[K]; end;
  WriteLn('closure: ', pick('name'), ' ', At(pick('name')) = name, ' ', pick('nested')['x']);

  { a routine pas starts gets the word }
  ints := MakeChan();
  pas Sum(doc['list'], ints);
  n := Recv(ints);
  WriteLn('pas: ', n);

  { helpers and case on Kind }
  WriteLn('helper: ', doc['nested']['x'].Twice);
  for k in doc do
    WriteLn('  ', k, ' is ', doc[k].Describe);
  v := nil;
  WriteLn('  nil is ', v.Describe);

  { array of const, Format and Write's width }
  Kinds([doc['name'], 3, 'x', doc['list']]);
  WriteLn(Format('format: [%s] [%s] [%.4s] [%5s]', [doc['name'], doc['list'], doc, doc['nested']['x']]));
  WriteLn('[', doc['name']:12, '] [', doc['name']:0, '] [', doc['list']:3, ']');

  { a safe routine }
  WriteLn('safe: ', Total(doc['list']));
  for i := 0 to 3 do
    if doc['list'][i].AsInteger <> i + 1 then
      Halt(1);
end.

