program selwalkerflow;
procedure ContinueInArm;
var i, total: Integer;
begin
  i := 0;
  total := 0;
  while i < 6 do
  begin
    Inc(i);
    select
    else
      begin
        if i = 2 then continue;
        total := total + i;
      end;
    end;
  end;
  WriteLn('continue: ', total);
end;
procedure NestedLoop;
var i, j, total: Integer;
begin
  total := 0;
  for i := 0 to 2 do
    select
    else
      for j := 0 to 2 do
        total := total + i * 10 + j;
    end;
  WriteLn('nested loop: ', total);
end;
procedure WriteCounter;
var i, total: Integer;
begin
  total := 0;
  for i := 1 to 5 do
    select
    else
      begin
        Inc(i);
        total := total + i;
      end;
    end;
  WriteLn('write counter: ', total);
end;
procedure ReceiveCounter;
var c: chan of Integer; i, passes, total: Integer;
begin
  c := MakeChan(2);
  Send(c, 3);
  Send(c, 5);
  passes := 0;
  total := 0;
  for i := 1 to 5 do
    select
      Recv(c, i):
        begin
          Inc(passes);
          total := total + i;
        end;
    else
      break;
    end;
  WriteLn('receive counter: ', passes, ' ', total);
end;
begin
  ContinueInArm;
  NestedLoop;
  WriteCounter;
  ReceiveCounter;
end.

