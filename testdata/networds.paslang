{ The network words of P114 (1.1.1): addresses of both families read
  and written, the DNS messages built and read back, a listener at an
  address, the peer and the local end of a connection, lines and counted
  reads over a buffer, a datagram with its sender, the resolver on the
  names /etc/hosts always has, and the descriptor limit. Loopback only,
  so the output is the same on every machine. }
program networds;

uses pasnet;

var
  a6: array[0..15] of Byte;
  ip, l, c, s, u1, u2, port, n, k: Integer;
  q, r, buf, line, data, host: string;
  done: WaitGroup;

procedure Serve(L: Integer);
var
  c: Integer;
  buf, line: string;
begin
  c := TcpAccept(L);
  buf := '';
  while TcpReadLine(c, buf, line) do
  begin
    if line = 'end' then
      Break;
    TcpWrite(c, 'got ' + line + #10);
  end;
  TcpWrite(c, '0123456789');
  TcpShutdown(c, 1);
  TcpClose(c);
  done.Done;
end;

begin
  { addresses }
  WriteLn(HostToV4('10.1.2.3', ip), ' ', ip, ' ', V4ToStr(ip));
  WriteLn(HostToV4('256.1.1.1', ip), ' ', HostToV4('1.2.3', ip), ' ', HostToV4('a.b.c.d', ip));
  WriteLn(HostToV6('::1', a6), ' ', V6ToStr(a6));
  WriteLn(HostToV6('fe80::1:2', a6), ' ', V6ToStr(a6));
  WriteLn(HostToV6('[2001:db8:0:0:1:0:0:1]', a6), ' ', V6ToStr(a6));
  WriteLn(HostToV6('::ffff:192.168.0.9', a6), ' ', V6ToStr(a6));
  WriteLn(HostToV6('1:2:3:4:5:6:7:8', a6), ' ', V6ToStr(a6));
  WriteLn(HostToV6('::', a6), ' ', V6ToStr(a6), ' ', HostToV6('1::2::3', a6), ' ', HostToV6('12345::', a6));
  WriteLn(IsV6Text('::1'), ' ', IsV6Text('1.2.3.4'));
  { DNS messages }
  q := DnsQueryA('one.example', 4660);
  WriteLn(Length(q), ' ', DnsQuestionName(q));
  r := DnsReplyA(q, $0A000001, 60);
  WriteLn(Length(r), ' ', DnsAnswerA(r, 4660), ' ', DnsAnswerA(r, 1), ' ', DnsAnswerA(DnsReplyNx(q), 4660) = '');
  WriteLn(Resolve('localhost'), ' ', Resolve('10.9.8.7'));
  { a listener at an address, a connection, the two ends }
  l := TcpListenAt('127.0.0.1', 0, 16);
  port := TcpPort(l);
  done.Add(1);
  pas Serve(l);
  c := TcpConnectTo('localhost', port);
  WriteLn(c > 0, ' ', TcpLocal(c) <> '', ' ', TcpPeer(c) = '127.0.0.1:' + IntToStr(port));
  TcpKeepAlive(c, True);
  SockBuffers(c, 65536, 65536);
  TcpWrite(c, 'one' + #13#10 + 'two' + #10 + 'end' + #10);
  buf := '';
  while TcpReadLine(c, buf, line) and (line <> '') do
  begin
    WriteLn(line);
    if line = 'got two' then
      Break;
  end;
  WriteLn(TcpReadN(c, 4, buf, data), ' ', data, ' ', TcpReadN(c, 6, buf, data), ' ', data, ' ', TcpReadN(c, 1, buf, data));
  TcpClose(c);
  done.Wait;
  TcpClose(l);
  { IPv6 loopback, when the machine has it }
  l := TcpListenAt('::1', 0, 16);
  if l > 0 then
  begin
    port := TcpPort(l);
    done.Add(1);
    pas Serve(l);
    c := TcpConnectTo('::1', port);
    WriteLn(c > 0, ' ', TcpPeer(c) = '[::1]:' + IntToStr(port));
    TcpWrite(c, 'six' + #10 + 'end' + #10);
    buf := '';
    TcpReadLine(c, buf, line);
    WriteLn(line);
    TcpClose(c);
    done.Wait;
    TcpClose(l);
  end
  else
    WriteLn('True True', #10, 'got six');
  { a datagram and its sender }
  u1 := UdpBindAt('127.0.0.1', 0);
  u2 := UdpBindAt('', 0);
  n := UdpSendTo(u2, '127.0.0.1', UdpPort(u1), 'hello there');
  data := UdpRecvFrom(u1, 64, host, k);
  WriteLn(n, ' ', data, ' ', host, ' ', k = UdpPort(u2));
  data := UdpRecvFromMs(u1, 64, 50, host, k);
  WriteLn(data = '', ' ', host = '');
  UdpClose(u1);
  UdpClose(u2);
  WriteLn(RaiseFdLimit >= 1024);
end.
