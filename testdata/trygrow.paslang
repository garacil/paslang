{ P95c: a raise after the stack grew inside the try. The head of the
  routine's try records (G+224) points into the stack, and rt_newstack
  did not move it: the record it named was in a stack that the second
  growth unmapped, and the raise read freed memory. Here the stack grows
  once before the try, so the record is in the second stack, and once
  more inside it. }
program trygrow;

var
  hits: Integer;

function Down(N: Integer; Boom: Boolean): Integer;
var
  pad: array[0..63] of Integer;
begin
  pad[N mod 64] := N;
  if N = 0 then
  begin
    if Boom then
      Raise;
    Result := 0;
  end
  else
    Result := Down(N - 1, Boom) + pad[N mod 64];
end;

procedure Work;
var
  s: string;
begin
  s := 'kept';
  hits := Down(200, False);
  try
    hits := Down(4000, True);
  except
    WriteLn('caught ', s);
  end;
  WriteLn('after');
end;

begin
  pas Work;
end.
