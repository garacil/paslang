program opadd;

type
  TPoint = record
    X, Y: Integer;
  end;

operator + (A, B: TPoint): TPoint;
begin
  Result.X := A.X + B.X;
  Result.Y := A.Y + B.Y;
end;

var
  A, B, C: TPoint;

begin
  A.X := 3;
  A.Y := 4;
  B.X := 10;
  B.Y := 20;
  C := A + B;
  WriteLn(C.X);
  WriteLn(C.Y);
  WriteLn((A + B).X);
  WriteLn(1 + 2);
end.
