{ P646: JsonEncode with JsonCanonical writes a number as RFC 8785 asks,
  the shortest text of its IEEE 754 double (3.2.2.3), and refuses one
  past the largest double: its double is an infinity, which the RFC
  says must end the canonicalization with an error. It clamped 1e400 to
  the largest double, so two texts signed as one (reported by 7KSP). The
  edges: the largest double, the texts that round to it and the first
  that does not, the least subnormal, an underflow to 0, -0. }
program jsoncanonrange;

uses
  sysutils;

procedure Canon(const T: string);
var
  j: json;
begin
  try
    j := JsonParse(T);
    WriteLn(T, ' -> ', JsonEncode(j, JsonCanonical));
  except
    on e: EJsonError do
      WriteLn(T, ' -> ', e.ClassName, ' ', Ord(e.Kind), ': ', e.Message);
  end;
end;

begin
  Canon('1.7976931348623157e308');
  Canon('-1.7976931348623157e308');
  Canon('1.7976931348623158e308');
  Canon('1.79769313486231580793728971405301e308');
  Canon('1.7976931348623159e308');
  Canon('2e308');
  Canon('1e400');
  Canon('-1e400');
  Canon('[1, 1e400]');
  Canon('{"b": 1, "a": {"x": -1e999}}');
  Canon('5e-324');
  Canon('2.4703282292062328e-324');
  Canon('1e-400');
  Canon('-0');
  Canon('-0.0');
  Canon('0.000001');
  Canon('1e21');
  Canon('9007199254740993');
  Canon('[1E400, 2]');
  { the plain writer keeps the text as it came }
  WriteLn('plain: ', JsonEncode(JsonParse('[1e400, -0, 1.50]')));
end.

