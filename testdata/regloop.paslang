{ P93: a loop without calls keeps its integer variables in registers.
  Every number here is what the 1.0.37 compiler printed, which kept them
  all in memory. }
program regloop;

var
  s, i, n, k, flag, spins: Integer;
  a: array[0..99] of Integer;

function Sum(N: Integer): Integer;
var
  j: Integer;
begin
  Result := 0;
  j := 1;
  while j <= N do
  begin
    Result := Result + j * j;
    j := j + 1;
  end;
end;

function Collatz(N: Integer): Integer;
var
  x, steps: Integer;
begin
  x := N;
  steps := 0;
  while x <> 1 do
  begin
    if x mod 2 = 0 then
      x := x div 2
    else
      x := 3 * x + 1;
    Inc(steps);
  end;
  Result := steps;
end;

{ A var parameter stays in memory: the loop writes through its address. }
procedure Mix(var Acc: Integer; N: Integer);
var
  j: Integer;
begin
  for j := 1 to N do
    Acc := Acc xor (j shl (j mod 7));
end;

{ A nested routine reaches the parent's local through the static link. }
function Outer(N: Integer): Integer;
var
  t, j: Integer;

  procedure Bump;
  begin
    t := t + 1000;
  end;

begin
  t := 0;
  for j := 1 to N do
    t := t + j;
  Bump;
  for j := 1 to N do
    t := t - 1;
  Result := t;
end;

{ x has its address taken, so it stays home: the loop writes it both
  directly and through p. }
function Taken(N: Integer): Integer;
var
  x, j: Integer;
  p: ^Integer;
begin
  x := 0;
  p := @x;
  for j := 1 to N do
  begin
    p^ := p^ + j;
    x := x + 1;
  end;
  Result := x;
end;

function Nested(N: Integer): Integer;
var
  u, v, w: Integer;
begin
  w := 0;
  for u := 1 to N do
  begin
    v := 0;
    repeat
      v := v + 1;
      if v = 3 then
        continue;
      if (u + v) mod 5 = 0 then
        break;
      w := w + u * v - (u shl 1) + (v shr 1);
    until v >= u;
  end;
  Result := w;
end;

function Kinds(N: Integer): Integer;
var
  j, r: Integer;
begin
  r := 1;
  for j := 0 to N - 1 do
    case j mod 4 of
      0: r := r + 1;
      1: r := r - 2;
      2: r := r * 3;
    else
      r := -r;
    end;
  Result := r;
end;

{ Long enough for sysmon to preempt it many times: every preemption
  goes through the slow path, which spills and reloads the registers. }
function Long(N: Integer): Integer;
var
  j, acc: Integer;
begin
  acc := 0;
  for j := 1 to N do
    acc := acc + (j and 7) - 3;
  Result := acc;
end;

function Down(N: Integer): Integer;
var
  j, q: Integer;
begin
  q := 0;
  for j := N downto 1 do
    if (j * 7 + q) mod 3 <> 1 then
      q := q + j div 2
    else
      q := q - (not j) + (-j);
  Result := q;
end;

procedure Setter;
begin
  flag := 1;
end;

begin
  n := 3000000;
  s := 0;
  i := 1;
  while i <= n do
  begin
    s := s + ((i xor s) and 255);
    i := i + 1;
  end;
  WriteLn(s);
  WriteLn(Sum(1000));
  WriteLn(Collatz(27));
  k := 5;
  Mix(k, 1000);
  WriteLn(k);
  WriteLn(Outer(100));
  WriteLn(Taken(10));
  WriteLn(Nested(50));
  WriteLn(Kinds(25));
  WriteLn(Long(200000000));
  WriteLn(Down(1000));
  for i := 0 to 99 do
    a[i] := i * i - 3 * i;
  s := 0;
  i := 0;
  while i < 100 do
  begin
    if a[i] > 1000 then
      s := s + a[i] div 7
    else
      s := s - a[i] mod 5;
    Inc(i, 3);
    Dec(i);
  end;
  WriteLn(s);
  { A global the loop only reads: another routine writes it, and the
    loop sees the write at its next slow path. }
  flag := 0;
  spins := 0;
  pas Setter;
  while flag = 0 do
    spins := spins + 1;
  WriteLn('flag seen');
end.

