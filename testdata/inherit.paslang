program inherit;

type
  TFoo = class
    FX: Integer;
    constructor Create;
    procedure Hello; virtual;
  end;

  TBar = class(TFoo)
    FY: Integer;
    procedure Hello; virtual;
    procedure SetY;
  end;

constructor TFoo.Create;
begin
  FX := 1;
end;

procedure TFoo.Hello;
begin
  WriteLn(FX);
end;

procedure TBar.Hello;
begin
  WriteLn(FX + FY);
end;

procedure TBar.SetY;
begin
  FY := 10;
end;

var
  b: TBar;
  o: TFoo;

begin
  b := TBar.Create;
  b.SetY;
  b.Hello;
  WriteLn(b.FX);
  WriteLn(b.FY);
  o := b;
  o.Hello;
end.

