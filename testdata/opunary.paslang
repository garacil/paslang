{ P381: the top level's operators of one operand, its logic, shifts and
  in, and its conversions: -v, +v and not v, Inc(v) and Dec(v); v and w,
  v or w, v xor w, v shl 2, v shr 1 and a point in a box; := and
  explicit. The output is written by hand from Free Pascal's reference
  (15.2: the arithmetic, logical, comparison and other operators). }
program opunary;

type
  TVec = record
    X, Y: Integer;
  end;

  TBox = record
    Lo, Hi: TVec;
  end;

function Vec(X, Y: Integer): TVec;
begin
  Result.X := X;
  Result.Y := Y;
end;

operator - (A: TVec): TVec;
begin
  Result := Vec(-A.X, -A.Y);
end;

operator + (A: TVec): TVec;
begin
  Result := Vec(Abs(A.X), Abs(A.Y));
end;

operator not (A: TVec): TVec;
begin
  Result := Vec(A.Y, A.X);
end;

operator inc (A: TVec): TVec;
begin
  Result := Vec(A.X + 1, A.Y + 1);
end;

operator dec (A: TVec): TVec;
begin
  Result := Vec(A.X - 1, A.Y - 1);
end;

operator and (A, B: TVec): TVec;
begin
  Result := Vec(Min(A.X, B.X), Min(A.Y, B.Y));
end;

operator or (A, B: TVec): TVec;
begin
  Result := Vec(Max(A.X, B.X), Max(A.Y, B.Y));
end;

operator xor (A, B: TVec): TVec;
begin
  Result := Vec(A.X xor B.X, A.Y xor B.Y);
end;

operator shl (A: TVec; N: Integer): TVec;
begin
  Result := Vec(A.X shl N, A.Y shl N);
end;

operator shr (A: TVec; N: Integer): TVec;
begin
  Result := Vec(A.X shr N, A.Y shr N);
end;

operator in (A: TVec; B: TBox): Boolean;
begin
  Result := (A.X >= B.Lo.X) and (A.X <= B.Hi.X) and (A.Y >= B.Lo.Y) and (A.Y <= B.Hi.Y);
end;

operator := (N: Integer): TVec;
begin
  Result := Vec(N, N);
end;

operator explicit (A: TVec): Integer;
begin
  Result := A.X * 100 + A.Y;
end;

procedure Show(const A: TVec);
begin
  WriteLn(A.X, ' ', A.Y);
end;

var
  v, w: TVec;
  b: TBox;

begin
  v := Vec(3, -4);
  w := Vec(5, 1);
  Show(-v);
  Show(+v);
  Show(not v);
  Inc(v);
  Show(v);
  Dec(v);
  Dec(v);
  Show(v);
  Show(v and w);
  Show(v or w);
  Show(w xor Vec(1, 1));
  Show(w shl 2);
  Show(Vec(20, 9) shr 1);
  b.Lo := Vec(0, 0);
  b.Hi := Vec(10, 10);
  WriteLn(w in b, ' ', v in b);
  v := 7;
  Show(v);
  WriteLn(Integer(w));
end.

