{ P355: every argument that calls nothing pushes nothing. Calls with
  several elements, fields and divisions among their arguments, each
  worked out in the pool: a direct call, a nested routine's, a method's
  on a class variable and on an element, and calls through a routine
  value, a method value and an interface. Each waits in its own
  register where the pool leaves that alone, or in one the call leaves
  free, and moves to its own at the end, where a second one sent those
  before it to the stack. The answers are worked out by hand in the
  comments, Mix's digits in base 101; scripts/check_argpush.py finds no
  push in the routines named By. }
program heldargs;

type
  TF6 = function(A, B, C, D, E, F: Integer): Integer;
  TF5 = function(A, B, C, D, E: Integer): Integer;
  TM4 = function(A, B, C, D: Integer): Integer of object;
  TPt = record
    X, Y: Integer;
  end;
  IFour = interface
    function Four(A, B, C, D: Integer): Integer;
  end;
  TBox = class(IFour)
    Base: Integer;
    function Sum5(A, B, C, D, E: Integer): Integer;
    function Four(A, B, C, D: Integer): Integer;
  end;

var
  a: array[0..15] of Integer;
  pt: TPt;
  k, t, i: Integer;
  f6: TF6;
  f5: TF5;
  mv: TM4;
  box: TBox;
  boxes: array[0..1] of TBox;
  fv: IFour;

function Mix(A, B, C, D, E, F: Integer): Integer;
begin
  Result := ((((A * 101 + B) * 101 + C) * 101 + D) * 101 + E) * 101 + F;
end;

function Mix5(A, B, C, D, E: Integer): Integer;
begin
  Result := (((A * 101 + B) * 101 + C) * 101 + D) * 101 + E;
end;

function TBox.Sum5(A, B, C, D, E: Integer): Integer;
begin
  Result := Base + Mix5(A, B, C, D, E);
end;

function TBox.Four(A, B, C, D: Integer): Integer;
begin
  Result := Base + ((A * 101 + B) * 101 + C) * 101 + D;
end;

function ByDirect: Integer;
begin
  { Mix(10, 15, 26, 7, 2, 11) = 106688770471 }
  Result := Mix(k shl 1, pt.X div 3, a[k], 7, k mod t, pt.Y);
end;

function ByDirect5: Integer;
begin
  { a[6] = 37, 37 div 2 = 18, 47 mod 4 = 3: Mix5(26, 10, 3, 18, 9) =
    2715905866 }
  Result := Mix5(a[k], a[t], pt.X mod 4, a[k + 1] div 2, 9);
end;

function ByMethod: Integer;
begin
  { 500 + Mix5(6, 23, 4, 2, 11) = 648100846 }
  Result := box.Sum5(k + 1, pt.X div 2, 4, k mod t, pt.Y);
end;

function ByMethodE: Integer;
begin
  { boxes[1], 700 + Mix5(6, 26, 4, 2, 11) = 651191949 }
  Result := boxes[k and 1].Sum5(k + 1, a[k], 4, k mod t, pt.Y);
end;

function ByValue: Integer;
begin
  { Mix(10, 2, 15, 4, 5, 11) = 105324621647 }
  Result := f6(k shl 1, 2, pt.X div 3, 4, 5, pt.Y);
end;

function ByValue5: Integer;
begin
  { Mix5(26, 2, 3, 2, 5) = 2707661838 }
  Result := f5(a[k], 2, 3, k mod t, 5);
end;

function ByMethVal: Integer;
begin
  { 500 + ((26 * 101 + 2) * 101 + 3) * 101 + 2 = 26809033 }
  Result := mv(a[k], 2, 3, k mod t);
end;

function ByIface: Integer;
begin
  { the same through the interface: 26809033 }
  Result := fv.Four(a[k], 2, 3, k mod t);
end;

function ByNested: Integer;
var
  base: Integer;

  function Inner(A, B, C: Integer): Integer;
  begin
    Result := base + (A * 101 + B) * 101 + C;
  end;

begin
  { the static link set after the arguments: 1000000 + (26 * 101 + 15)
    * 101 + 2 = 1266743 }
  base := 1000000;
  Result := Inner(a[k], pt.X div 3, k mod t);
end;

begin
  for i := 0 to 15 do
    a[i] := i * i + 1;
  k := 5;
  t := 3;
  pt.X := 47;
  pt.Y := 11;
  f6 := @Mix;
  f5 := @Mix5;
  box := TBox.Create;
  box.Base := 500;
  boxes[0] := box;
  boxes[1] := TBox.Create;
  boxes[1].Base := 700;
  mv := box.Four;
  fv := box;
  WriteLn(ByDirect);
  WriteLn(ByDirect5);
  WriteLn(ByMethod);
  WriteLn(ByMethodE);
  WriteLn(ByValue);
  WriteLn(ByValue5);
  WriteLn(ByMethVal);
  WriteLn(ByIface);
  WriteLn(ByNested);
  boxes[1].Free;
  box.Free;
end.
