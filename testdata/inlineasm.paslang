program inlineasm;

{ Inline assembly per machine (P106, 1.0.127): an asm amd64 block and an
  asm arm64 block side by side, of which the target's runs, with values
  bound to registers in, out and inout: integers, a narrow out, a var
  parameter, a function's Result through a callee-saved register, a
  Double, a Single, a V128, a V256 on AVX2, an element with an
  expression in, a loop with a local label, pushes and pops inside, a
  for loop around a block. }

var
  a, b, c, g, i: Integer;
  w: Word;
  d, e: Double;
  s: Single;
  v, u: V128;
  y: V256;
  arr: array[0..3] of Integer;

procedure Twice(var x: Integer);
begin
  asm amd64 (x: inout rdx)
    addq %rdx, %rdx
  end;
  asm arm64 (x: inout x3)
    add x3, x3, x3
  end;
end;

function AddMul(p, q: Integer): Integer;
begin
  asm amd64 (p: in rbx; q: in rcx; Result: out rax)
    movq %rbx, %rax
    imulq %rcx, %rax
    addq %rbx, %rax
  end;
  asm arm64 (p: in x19; q: in x1; Result: out x0)
    mul x0, x19, x1
    add x0, x0, x19
  end;
end;

begin
  a := 40;
  b := 2;
  asm amd64 (a: in rax; b: in rcx; c: out rax)
    addq %rcx, %rax
  end;
  asm arm64 (a: in x0; b: in x1; c: out x0)
    add x0, x0, x1
  end;
  WriteLn(c);
  asm amd64 (g: out rax)
    xorl %eax, %eax
    movl $10, %ecx
  1:
    addq %rcx, %rax
    decq %rcx
    jnz 1b
  end;
  asm arm64 (g: out x0)
    mov x0, #0
    mov x1, #10
  1:
    add x0, x0, x1
    subs x1, x1, #1
    b.ne 1b
  end;
  WriteLn(g);
  a := $12345;
  asm amd64 (a: in rsi; w: out rsi)
  end;
  asm arm64 (a: in x5; w: out x5)
  end;
  WriteLn(w);
  Twice(b);
  WriteLn(b);
  WriteLn(AddMul(6, 7));
  d := 2.25;
  asm amd64 (d: in xmm3; e: out xmm3)
    sqrtsd %xmm3, %xmm3
  end;
  asm arm64 (d: in d3; e: out d3)
    fsqrt d3, d3
  end;
  WriteLn(e:0:2);
  s := 1.5;
  asm amd64 (s: inout xmm1)
    addss %xmm1, %xmm1
  end;
  asm arm64 (s: inout s1)
    fadd s1, s1, s1
  end;
  WriteLn(s:0:1);
  v := VSplat8(3);
  asm amd64 (v: in xmm5; u: out xmm6)
    movdqa %xmm5, %xmm6
    paddb %xmm5, %xmm6
  end;
  asm arm64 (v: in q5; u: out q6)
    add v6.16b, v5.16b, v5.16b
  end;
  WriteLn((u as array[0..15] of Byte)[7]);
  y := VSplat16(1000);
  if CpuHas('avx2') then
  begin
    asm amd64 (y: inout ymm4)
      vpaddw %ymm4, %ymm4, %ymm4
    end;
    asm arm64 ((y as array[0..1] of V128)[0]: inout q4)
      add v4.8h, v4.8h, v4.8h
    end;
  end
  else
    y := VAdd16(y, y);
  WriteLn((y as array[0..15] of Word)[15]);
  arr[2] := 100;
  asm amd64 (arr[2] * 3 + 1: in r8; arr[1]: out r8)
    negq %r8
  end;
  asm arm64 (arr[2] * 3 + 1: in x8; arr[1]: out x8)
    neg x8, x8
  end;
  WriteLn(arr[1]);
  asm amd64 (a: in rdi; c: out rax)
    pushq %rdi
    popq %rax
  end;
  asm arm64 (a: in x2; c: out x0)
    str x2, [sp, #-16]!
    ldr x0, [sp], #16
  end;
  WriteLn(c);
  g := 0;
  for i := 1 to 5 do
  begin
    asm amd64 (i: in rax; g: inout rcx)
      addq %rax, %rcx
    end;
    asm arm64 (i: in x0; g: inout x1)
      add x1, x1, x0
    end;
  end;
  WriteLn(g);
end.

