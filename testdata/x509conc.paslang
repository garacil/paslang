{ P430: routines sharing one pool of roots (Regla 11): eight routines
  start at once, each verifies the chains of correo.7kas.com and
  api.deepseek.com twenty times at a fixed time against the roots in
  testdata/x509/realroots.pem; every verdict must be the expected one. }
program x509conc;

uses
  paslib, pasx509;

var
  wg: waitgroup;
  mu: mutex;
  correo, deepseek: array of string;
  roots: TX509Pool;
  good, bad: Integer;

function PemChain(const Path: string): array of string;
var
  data: string;
  b: TPemBlocks;
  i: Integer;
begin
  Result := nil;
  if ReadFile(Path, data) then
  begin
    b := PemDecodeAll(data);
    for i := 0 to High(b) do
      Result := Append(Result, b[i].Bytes);
  end;
end;

procedure Worker(K: Integer);
var
  i, g, b: Integer;
  err: string;
begin
  g := 0;
  b := 0;
  for i := 1 to 20 do
  begin
    if X509VerifyServer(correo, 'correo.7kas.com', 1790856000, roots, err) then Inc(g) else Inc(b);
    if not X509VerifyServer(deepseek, 'deepseek.com', 1790856000, roots, err) and
      (err = 'x509: certificate is valid for *.deepseek.com, not deepseek.com') then Inc(g) else Inc(b);
  end;
  lock mu do
  begin
    good := good + g;
    bad := bad + b;
  end;
  wg.Done;
end;

var
  i: Integer;
  text: string;
begin
  roots := TX509Pool.Create;
  if (not ReadFile('testdata/x509/realroots.pem', text)) or not roots.AppendCertsFromPEM(text) then
  begin
    WriteLn('no roots');
    Halt(1);
  end;
  correo := PemChain('testdata/x509/correo.7kas.com.pem');
  deepseek := PemChain('testdata/x509/api.deepseek.com.pem');
  wg.Add(8);
  for i := 1 to 8 do
    pas Worker(i);
  wg.Wait;
  WriteLn('concurrent verifications right ', good, ' wrong ', bad);
end.
