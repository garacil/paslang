program withonce;
{$mode objfpc}{$H+}{$modeswitch advancedrecords}

type
  TR = record
    X, Y: Int64;
    Text: string;
    procedure Bump;
    function Total: Int64;
    property Sum: Int64 read Total;
  end;
  PR = ^TR;
  TNested = record
    Outer: Int64;
    Inner: TR;
  end;

var
  Calls, IndexCalls, PointerCalls: Int64;
  Items: array[1..3] of TR;
  First, Second: TR;
  P: PR;
  Nested: TNested;
  X: Int64;

procedure TR.Bump;
begin
  X := X + 1;
  Y := Y + 2;
  Text := Text + '!';
end;

function TR.Total: Int64;
begin
  Result := X + Y;
end;

function Make(K: Int64): TR;
begin
  Calls := Calls + 1;
  Result.X := K;
  Result.Y := K * 2;
  Result.Text := 'made';
end;

function NextIndex: Int64;
begin
  IndexCalls := IndexCalls + 1;
  Result := IndexCalls;
end;

function NextPointer: PR;
begin
  PointerCalls := PointerCalls + 1;
  Result := @First;
end;

procedure ChangeCopy(R: TR);
begin
  with R do
  begin
    X := 100;
    Y := 200;
    Text := 'copy';
    WriteLn('copy ', X, ' ', Y, ' ', Text);
  end;
end;

function ReadConst(const R: TR): Int64;
begin
  with R do
    Result := X + Y;
end;

procedure Recurse(K: Integer);
begin
  if K = 0 then
    Exit;
  with Make(K) do
  begin
    Recurse(K - 1);
    if K <= 3 then
      WriteLn('nested-call ', X, ' ', Y);
  end;
end;

begin
  Calls := 0;
  with Make(5) do
    WriteLn('value ', X, ' ', Y, ' ', X + Y, ' ', Calls);
  with Make(7) do
  begin
    Bump;
    WriteLn('method ', X, ' ', Y, ' ', Sum, ' ', Text, ' ', Calls);
  end;
  with Make(9) do ;
  WriteLn('empty ', Calls);
  IndexCalls := 0;
  with Items[NextIndex] do
  begin
    X := 7;
    Y := 8;
    Text := 'element';
    Bump;
  end;
  WriteLn('index ', IndexCalls, ' ', Items[1].X, ' ', Items[1].Y, ' ',
    Items[1].Text, ' ', Items[2].X, ' ', Items[2].Y);
  First := Make(11);
  Second := Make(20);
  P := @First;
  with P^ do
  begin
    P := @Second;
    X := 12;
    Y := 24;
  end;
  WriteLn('pointer ', First.X, ' ', First.Y, ' ', Second.X, ' ', Second.Y);
  with NextPointer^ do
    WriteLn('pointer-call ', X, ' ', Y, ' ', PointerCalls);
  Nested.Outer := 50;
  Nested.Inner := Make(3);
  X := 999;
  with Nested do
    with Inner do
    begin
      X := X + Outer;
      WriteLn('nested ', X, ' ', Y, ' ', Outer);
    end;
  WriteLn('priority ', X, ' ', Nested.Inner.X);
  with First, Second do
    WriteLn('comma ', X, ' ', Y);
  ChangeCopy(First);
  WriteLn('caller ', First.X, ' ', First.Y, ' ', First.Text);
  WriteLn('const ', ReadConst(First));
  Calls := 0;
  Recurse(80);
  WriteLn('recursion ', Calls);
end.
