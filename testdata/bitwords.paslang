program bitwords;

{ The bit words of P105 (1.0.117) on every integer width: PopCount,
  LeadingZeros, TrailingZeros, ReverseBits, ByteSwap, RotateLeft and
  RotateRight, IsBitSet, GetBits, SetBit, ToggleBit and SetBits, with
  constant and variable bit numbers, worked out on the stack and in the
  register pool, against a Python model of the widths. }

const
  VB: array[0..4] of Byte = (0, 1, $80, $B4, $FF);
  V8: array[0..4] of Int8 = (0, 1, -128, -76, -1);
  VW: array[0..4] of Word = (0, 1, $8000, $B401, $FFFF);
  V16: array[0..4] of Int16 = (0, 1, -32768, -19455, -1);
  VU: array[0..4] of UInt32 = (0, 1, $80000000, $80000013, $FFFFFFFF);
  V32: array[0..4] of Int32 = (0, 1, -2147483647 - 1, -2, -1);
  VI: array[0..4] of Integer = (0, 1, -9223372036854775807 - 1, $0123456789ABCDEF, -1);
  KPop = PopCount(255);
  KLz = LeadingZeros(Byte(1));
  KTz = TrailingZeros(Word(0));
  KRev = ReverseBits(Byte(1));
  KSwap = ByteSwap(Word($1234));

var
  b: Byte;
  s8: Int8;
  w: Word;
  s16: Int16;
  u32: UInt32;
  s32: Int32;
  i, n, k: Integer;
  c: Char;
  bits: string;

procedure Pool;
var
  x, h, m, j: Integer;
  pb: Byte;
  p8: Int8;
  pw: Word;
  pu: UInt32;
  p32: Int32;
begin
  h := 0;
  x := $0123456789ABCDEF;
  for j := 0 to 999 do
  begin
    x := x xor (x shl 13);
    x := x xor (x shr 7);
    x := x xor (x shl 17);
    pb := Byte(x);
    p8 := Int8(x shr 8);
    pw := Word(x shr 16);
    pu := UInt32(x shr 24);
    p32 := Int32(x shr 32);
    m := j and 63;
    h := h * 31 + PopCount(x) + LeadingZeros(x) * 3 + TrailingZeros(x) * 5;
    h := h * 31 + PopCount(pb) + LeadingZeros(p8) * 3 + TrailingZeros(pw) * 5;
    h := h * 31 + PopCount(pu) + LeadingZeros(p32) * 7 + TrailingZeros(p8) * 11;
    h := h * 31 + ReverseBits(x) + ByteSwap(x);
    h := h * 31 + ReverseBits(pb) + ByteSwap(pw) + ReverseBits(p8) + ByteSwap(p32);
    h := h * 31 + ReverseBits(pu) + ByteSwap(pu) + ReverseBits(pw);
    h := h * 31 + IsBitSet(x, m) + IsBitSet(pb, m and 7) * 2 + IsBitSet(p8, m and 7) * 4;
    h := h * 31 + GetBits(x, m and 31, 5) + GetBits(pw, m and 7, 9);
    SetBit(x, m, j and 1);
    ToggleBit(pb, m and 7);
    SetBits(pw, m and 7, 5, j);
    SetBit(p32, m and 31, IsBitSet(x, 3));
    h := h * 31 + x + pb + pw + p32;
    h := h * 31 + RotateLeft(pb, m) + RotateRight(p8, m) + RotateLeft(x, m);
  end;
  WriteLn('pool ', h);
end;

begin
  for k := 0 to 4 do
  begin
    b := VB[k];
    s8 := V8[k];
    w := VW[k];
    s16 := V16[k];
    u32 := VU[k];
    s32 := V32[k];
    i := VI[k];
    WriteLn(PopCount(b), ' ', PopCount(s8), ' ', PopCount(w), ' ', PopCount(s16), ' ',
      PopCount(u32), ' ', PopCount(s32), ' ', PopCount(i));
    WriteLn(LeadingZeros(b), ' ', LeadingZeros(s8), ' ', LeadingZeros(w), ' ', LeadingZeros(s16), ' ',
      LeadingZeros(u32), ' ', LeadingZeros(s32), ' ', LeadingZeros(i));
    WriteLn(TrailingZeros(b), ' ', TrailingZeros(s8), ' ', TrailingZeros(w), ' ', TrailingZeros(s16), ' ',
      TrailingZeros(u32), ' ', TrailingZeros(s32), ' ', TrailingZeros(i));
    WriteLn(ReverseBits(b), ' ', ReverseBits(s8), ' ', ReverseBits(w), ' ', ReverseBits(s16), ' ',
      ReverseBits(u32), ' ', ReverseBits(s32), ' ', ReverseBits(i));
    WriteLn(ByteSwap(b), ' ', ByteSwap(s8), ' ', ByteSwap(w), ' ', ByteSwap(s16), ' ',
      ByteSwap(u32), ' ', ByteSwap(s32), ' ', ByteSwap(i));
    bits := '';
    for n := 0 to 15 do
      bits := bits + Chr(Ord('0') + IsBitSet(s16, n));
    WriteLn(bits, ' ', GetBits(u32, 28, 4), ' ', GetBits(s8, 1, 7), ' ', GetBits(i, 60, 4), ' ',
      GetBits(i, 0, 64));
  end;
  c := 'A';
  WriteLn(PopCount(c), ' ', LeadingZeros(c), ' ', TrailingZeros(c), ' ', Ord(ReverseBits(c)), ' ', IsBitSet(c, 6));
  WriteLn(KPop, ' ', KLz, ' ', KTz, ' ', KRev, ' ', KSwap, ' ', PopCount(-1), ' ', LeadingZeros(0),
    ' ', TrailingZeros(Int8(-128)), ' ', ByteSwap(UInt32($11223344)), ' ', ReverseBits(Word(1)));
  b := $B4;
  SetBit(b, 0, 1);
  SetBit(b, 7, 0);
  ToggleBit(b, 3);
  WriteLn(b);
  s8 := 0;
  SetBit(s8, 7, True);
  w := $FFFF;
  SetBits(w, 4, 8, $A5);
  s16 := 0;
  SetBits(s16, 12, 4, -1);
  u32 := 0;
  n := 31;
  SetBit(u32, n, 5);
  WriteLn(s8, ' ', w, ' ', s16, ' ', u32, ' ', IsBitSet(u32, n), ' ', IsBitSet(u32, 0));
  i := 0;
  for n := 0 to 63 do
    if n mod 3 = 0 then
      SetBit(i, n, 1);
  WriteLn(i, ' ', PopCount(i));
  b := $C8;
  i := RotateLeft(b, 1);
  WriteLn(i, ' ', Integer(b rol 1), ' ', RotateRight(Int8(-56), 1), ' ', RotateLeft(i, 70));
  Pool;
end.

