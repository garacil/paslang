program inotifyerrors;

uses pasinotify, paslinux, paslib, sysutils;

const
  NoFile = 7;           { Linux RLIMIT_NOFILE, getrlimit(2) }
  DupCloseOnExec = 1030; { Linux F_DUPFD_CLOEXEC, fcntl(2) }
  GetDescriptorFlags = 1;
  GetStatusFlags = 3;
  CloseOnExec = 524288;
  NonBlocking = 2048;
  FdDirectory = '/proc/self/fd';

type
  TDescriptorSlots = array[0..2] of Integer;

function Nr(Amd, Arm: Integer): Integer;
begin
  {$ifdef CPUX86_64}
  Result := Amd;
  {$else}
  Result := Arm;
  {$endif}
end;

procedure Require(OK: Boolean; const What: string);
begin
  if not OK then
  begin
    WriteLn('inotify error test: ', What);
    Halt(1);
  end;
end;

function Duplicate(Fd: Integer): Integer;
begin
  Result := Syscall(Nr(72, 25), Fd, DupCloseOnExec, 0);
end;

function Descriptors(out Fd: Integer): Integer;
var
  entries: TDirectoryReader;
  error: TSysError;
  name, target: string;
begin
  Result := 0;
  Fd := -1;
  Require(TryOpenDirectoryAt(CurrentDirectoryHandle, FdDirectory, entries, error), 'open descriptor list');
  try
    while entries.Next(name, error) do
    begin
      Inc(Result);
      if ReadLink(FdDirectory + '/' + name, target) and (target = 'anon_inode:inotify') then
      begin
        Require(Fd < 0, 'only the test watcher has an inotify descriptor');
        Fd := StrToInt(name);
      end;
    end;
    Require(error.Code = 0, 'read descriptor list');
  finally
    entries.Free;
  end;
end;

procedure ExhaustDescriptors;
var
  original, limited: array[0..1] of UInt64;
  held: array[0..31] of Integer;
  count, control, fd, available, stdinFlags: Integer;
  watcher: TInotify;
  event: TInotifyEvent;
begin
  stdinFlags := Syscall(Nr(72, 25), 0, GetDescriptorFlags);
  control := FileOpen('/dev/null', fmOpenRead);
  Require(control >= 0, 'open control descriptor');
  Require(Syscall(Nr(302, 261), 0, NoFile, 0, @original[0]) = 0, 'read soft file limit');
  limited := original;
  if limited[0] > Length(held) then
    limited[0] := Length(held);
  Require(Syscall(Nr(302, 261), 0, NoFile, @limited[0], 0) = 0, 'lower soft file limit');
  count := 0;
  fd := Duplicate(control);
  while fd >= 0 do
  begin
    held[count] := fd;
    Inc(count);
    fd := Duplicate(control);
  end;
  Require((fd = -24) and (count >= 2), 'reached descriptor limit');

  { With 0, 1, or 2 slots left, inotify_init1, eventfd, or
    epoll_create1 is the first allocation to fail, respectively. }
  for available := 0 to 2 do
  begin
    watcher := TInotify.Create;
    Require(not watcher.Valid, 'exhausted watcher is invalid');
    Require(watcher.Error = 24, 'exhausted watcher reports EMFILE');
    Require(not watcher.Next(event, 0) and (watcher.Error = 24), 'invalid Next preserves creation error');
    watcher.Free;
    if available < 2 then
    begin
      Dec(count);
      Require(OsClose(held[count]) = 0, 'free one slot');
    end;
  end;

  Require(Syscall(Nr(302, 261), 0, NoFile, @original[0], 0) = 0, 'restore soft file limit');
  while count > 0 do
  begin
    Dec(count);
    Require(OsClose(held[count]) = 0, 'close a filler descriptor');
  end;
  Require(OsClose(control) = 0, 'close control descriptor');
  Require(Syscall(Nr(72, 25), 0, GetDescriptorFlags) = stdinFlags, 'creation failure preserves stdin');
end;

{ Find the next three descriptor numbers by borrowing them for /dev/null.
  The test creates the watcher before opening any other descriptors. }
procedure FindSlots(out Slots: TDescriptorSlots);
var
  i: Integer;
begin
  Slots[0] := FileOpen('/dev/null', fmOpenRead);
  Require(Slots[0] >= 0, 'open descriptor probe');
  for i := 1 to High(Slots) do
  begin
    Slots[i] := Duplicate(Slots[0]);
    Require(Slots[i] >= 0, 'duplicate descriptor probe');
  end;
  for i := 0 to High(Slots) do
    Require(OsClose(Slots[i]) = 0, 'release descriptor probe');
end;

function WatcherEpoll(const Slots: TDescriptorSlots): Integer;
var
  i, flags: Integer;
  target: string;
begin
  Result := -1;
  for i := 0 to High(Slots) do
  begin
    Require(ReadLink(FdDirectory + '/' + IntToStr(Slots[i]), target), 'read watcher descriptor target');
    flags := Syscall(Nr(72, 25), Slots[i], GetDescriptorFlags);
    Require(flags = 1, 'watcher descriptor is close-on-exec');
    if target = 'anon_inode:[eventpoll]' then
      Result := Slots[i]
    else
    begin
      Require((target = 'anon_inode:inotify') or (target = 'anon_inode:[eventfd]'), 'watcher descriptor kind');
      flags := Syscall(Nr(72, 25), Slots[i], GetStatusFlags);
      Require((flags >= 0) and ((flags and NonBlocking) <> 0), 'watcher descriptor is nonblocking');
    end;
  end;
  Require(Result >= 0, 'find the watcher epoll descriptor');
end;

{ Hold the open file description while faulting the original descriptor
  number, then restore it before the watcher releases its descriptors. }
procedure CheckClosed(Watcher: TInotify; Fd, Ms: Integer; const Action: string);
var
  backup, started: Integer;
  event: TInotifyEvent;
begin
  backup := Duplicate(Fd);
  Require(backup >= 0, 'duplicate ' + Action + ' descriptor');
  Require(OsClose(Fd) = 0, 'close ' + Action + ' descriptor');
  started := Nanotime;
  Require(not Watcher.Next(event, Ms) and (Watcher.Error = 9), 'Next reports ' + Action + ' EBADF');
  { an error ends the wait at once, whatever time it had left }
  Require(Nanotime - started < 2000000000, 'Next reports ' + Action + ' EBADF at once');
  Require(Syscall(Nr(292, 24), backup, Fd, CloseOnExec) = Fd, 'restore ' + Action + ' descriptor');
  Require(OsClose(backup) = 0, 'close backup descriptor');
end;

procedure DescriptorZero;
var
  savedFlags, backup, flags: Integer;
  target: string;
  watcher: TInotify;
begin
  savedFlags := Syscall(Nr(72, 25), 0, GetDescriptorFlags);
  backup := -1;
  if savedFlags >= 0 then
  begin
    backup := Duplicate(0);
    Require(backup > 0, 'save stdin');
    Require(OsClose(0) = 0, 'release descriptor zero');
  end
  else
    Require(savedFlags = -9, 'stdin absence reports EBADF');
  try
    watcher := TInotify.Create;
    try
      Require(watcher.Valid and (watcher.Error = 0), 'descriptor zero is a valid inotify handle');
      Require(ReadLink(FdDirectory + '/0', target) and (target = 'anon_inode:inotify'),
        'the watcher owns descriptor zero');
    finally
      watcher.Free;
    end;
    Require(Syscall(Nr(72, 25), 0, GetDescriptorFlags) = -9, 'Free releases descriptor zero');
  finally
    if backup >= 0 then
    begin
      flags := 0;
      if (savedFlags and 1) <> 0 then
        flags := CloseOnExec;
      Require(Syscall(Nr(292, 24), backup, 0, flags) = 0, 'restore stdin');
      Require(OsClose(backup) = 0, 'close stdin backup');
    end;
  end;
end;

procedure EmptyWait(Watcher: TInotify; Ms: Integer);
var
  event: TInotifyEvent;
  started, elapsed: Integer;
  answer: Boolean;
begin
  event.Watch := 42;
  event.Kinds := [ikCreate];
  event.Cookie := 1;
  event.Name := 'previous';
  started := Nanotime;
  answer := Watcher.Next(event, Ms);
  elapsed := Nanotime - started;
  Require(not answer and (Watcher.Error = 0), 'empty wait status');
  Require((event.Watch = 0) and (event.Kinds = []) and (event.Cookie = 0) and
    (event.Name = ''), 'empty wait clears the output event');
  Require((elapsed >= Ms * 1000000) and (elapsed < 5000000000), 'empty wait duration');
end;

{ These cases use a build whose constructor reaches a real kernel setup
  error or allocates a particular descriptor in the zero slot. }
procedure CheckSetup(const CaseName: string);
var
  beforeCount, expectedCount, fd, expectedError: Integer;
  counter: UInt64;
  target: string;
  watcher: TInotify;
  event: TInotifyEvent;
begin
  beforeCount := Descriptors(fd);
  Require((fd < 0) and (Syscall(Nr(72, 25), 0, GetDescriptorFlags) >= 0),
    'setup test starts with open stdin and no watcher');
  expectedCount := beforeCount;
  if (CaseName <> 'reject') and (CaseName <> 'reject-init') then
    Dec(expectedCount);
  expectedError := 0;
  if CaseName = 'reject' then
    expectedError := 9
  else if (CaseName = 'reject-zero-wake') or (CaseName = 'reject-init') then
    expectedError := 22;
  watcher := TInotify.Create;
  if expectedError <> 0 then
  begin
    Require(not watcher.Valid and (watcher.Error = expectedError), 'setup reports kernel errno');
    Require(not watcher.Next(event, 0) and (watcher.Error = expectedError), 'invalid wait preserves setup error');
  end
  else
  begin
    Require(watcher.Valid, 'zero descriptor watcher is valid');
    Require(Syscall(Nr(72, 25), 0, GetDescriptorFlags) = 1, 'zero descriptor is close-on-exec');
    Require(ReadLink(FdDirectory + '/0', target), 'read zero descriptor type');
    if CaseName = 'zero-wake' then
    begin
      Require(target = 'anon_inode:[eventfd]', 'eventfd owns zero');
      Require(OsRead(0, Int64(@counter), SizeOf(counter)) = -11, 'wake counter starts empty');
      watcher.Dispose;
      Require((OsRead(0, Int64(@counter), SizeOf(counter)) = 8) and (counter = 1),
        'Dispose writes one notification to fd zero');
      watcher.Dispose;
      Require(OsRead(0, Int64(@counter), SizeOf(counter)) = -11, 'repeated Dispose does not write');
      Require(not watcher.Next(event, 0) and (watcher.Error = 0), 'disposed wait returns cleanly');
    end
    else
    begin
      Require((CaseName = 'zero-poll') and (target = 'anon_inode:[eventpoll]'), 'epoll owns zero');
      EmptyWait(watcher, 5);
    end;
  end;
  watcher.Free;
  Require((Descriptors(fd) = expectedCount) and (fd < 0), 'setup case frees owned descriptors');
  if (CaseName <> 'reject') and (CaseName <> 'reject-init') then
    Require(Syscall(Nr(72, 25), 0, GetDescriptorFlags) = -9, 'Free releases descriptor zero');
end;

{ Next on a watcher that is disposed gives the caller an empty event,
  not the one its variable held. }
procedure AfterDispose;
var
  watcher: TInotify;
  event: TInotifyEvent;
begin
  watcher := TInotify.Create;
  Require(watcher.Valid, 'create watcher to dispose');
  event.Watch := 7;
  event.Cookie := 9;
  event.Name := 'stale';
  event.Kinds := [ikCreate];
  watcher.Dispose;
  Require(not watcher.Next(event, 0) and (watcher.Error = 0), 'a disposed watcher gives no event and no error');
  Require((event.Watch = 0) and (event.Kinds = []) and (event.Cookie = 0) and (event.Name = ''),
    'a disposed watcher clears the event');
  watcher.Free;
end;

procedure WaitNext(Watcher: TInotify; Ms: Integer; Answer: chan of Integer);
var
  event: TInotifyEvent;
begin
  if Watcher.Next(event, Ms) then
    Send(Answer, -1)
  else
    Send(Answer, Watcher.Error);
end;

{ A watcher freed while another routine waits in Next: the wait ends,
  as after Dispose, with no error, whether the eventfd or the close of
  the set wakes it. }
procedure FreeUnderWait(Ms: Integer; const Action: string);
var
  watcher: TInotify;
  answer: chan of Integer;
  value, due: Integer;
  got: Boolean;
begin
  watcher := TInotify.Create;
  Require(watcher.Valid, 'create watcher to free under a wait');
  answer := MakeChan(1);
  pas WaitNext(watcher, Ms, answer);
  Sleep(100);
  watcher.Free;
  got := False;
  value := 0;
  due := Nanotime + 5000000000;
  while (not got) and (Nanotime < due) do
  begin
    select
      Recv(answer, value):
        got := True;
    else
      Sleep(1);
    end;
  end;
  Require(got, 'Free ends ' + Action + ' wait');
  Require(value = 0, 'Free ends ' + Action + ' wait with no error');
end;

{ After Free the watcher holds no descriptor: its words answer EBADF
  and a second Free closes nothing, though the numbers it had are other
  descriptors of the process by then. }
procedure AfterFree;
var
  watcher: TInotify;
  event: TInotifyEvent;
  held: array[0..3] of Integer;
  i, zero: Integer;
begin
  { descriptor 0 open, whoever started the test }
  zero := -1;
  if Syscall(Nr(72, 25), 0, GetDescriptorFlags) < 0 then
  begin
    zero := Duplicate(1);
    Require(zero = 0, 'open descriptor zero');
  end;
  watcher := TInotify.Create;
  Require(watcher.Valid, 'create watcher to free');
  watcher.Free;
  { the lowest free numbers are the three it had }
  for i := 0 to 3 do
  begin
    held[i] := Duplicate(1);
    Require(held[i] > 1, 'take a freed number');
  end;
  Require((watcher.Add('.', [ikCreate]) = -1) and (watcher.Error = 9), 'Add after Free answers EBADF');
  Require(not watcher.Remove(1) and (watcher.Error = 9), 'Remove after Free answers EBADF');
  Require(not watcher.Next(event, 0) and (watcher.Error = 0), 'Next after Free gives no event');
  watcher.Free;
  for i := 0 to 3 do
    Require(Syscall(Nr(72, 25), held[i], GetDescriptorFlags) >= 0, 'a second Free closes no descriptor it does not own');
  Require(Syscall(Nr(72, 25), 1, GetDescriptorFlags) >= 0, 'a second Free leaves descriptor one');
  Require(Syscall(Nr(72, 25), 0, GetDescriptorFlags) >= 0, 'a second Free leaves descriptor zero');
  for i := 0 to 3 do
    Require(OsClose(held[i]) = 0, 'release a taken number');
  if zero = 0 then
    Require(OsClose(0) = 0, 'release descriptor zero');
end;

procedure CheckDeadline;
var
  milliseconds: Integer;
  watcher: TInotify;
  event: TInotifyEvent;
begin
  Require(paslib.StrToInt64(ParamStr(2), milliseconds), 'parse test deadline');
  watcher := TInotify.Create;
  Require(watcher.Valid, 'create deadline watcher');
  Require(not watcher.Next(event, milliseconds), 'empty deadline returns no event');
  WriteLn('error ', watcher.Error);
  watcher.Free;
end;

var
  beforeCount, fd, pollFd: Integer;
  watcher: TInotify;
  slots: TDescriptorSlots;
begin
  if ParamStr(1) = 'deadline' then
  begin
    CheckDeadline;
    Halt(0);
  end;
  if ParamCount <> 0 then
  begin
    CheckSetup(ParamStr(1));
    WriteLn('inotify setup path ok');
    Halt(0);
  end;
  beforeCount := Descriptors(fd);
  Require(fd < 0, 'no inherited inotify descriptor');
  ExhaustDescriptors;
  Require((Descriptors(fd) = beforeCount) and (fd < 0), 'failed creation releases descriptors');

  FindSlots(slots);
  watcher := TInotify.Create;
  Require(watcher.Valid, 'create watcher');
  Require((Descriptors(fd) = beforeCount + 3) and (fd >= 0), 'watcher owns three descriptors');
  pollFd := WatcherEpoll(slots);
  EmptyWait(watcher, 0);
  EmptyWait(watcher, 1);
  EmptyWait(watcher, 50);

  CheckClosed(watcher, fd, 0, 'read');
  CheckClosed(watcher, fd, 4000, 'read with time left');
  CheckClosed(watcher, pollFd, 50, 'timed poll');
  CheckClosed(watcher, pollFd, -1, 'untimed poll');
  EmptyWait(watcher, 0);
  watcher.Free;
  Require((Descriptors(fd) = beforeCount) and (fd < 0), 'Free releases all watcher descriptors');
  AfterDispose;
  FreeUnderWait(20000, 'a timed');
  FreeUnderWait(-1, 'an untimed');
  AfterFree;
  Require((Descriptors(fd) = beforeCount) and (fd < 0), 'the later cases release their descriptors');
  DescriptorZero;
  WriteLn('inotify error paths ok');
end.
