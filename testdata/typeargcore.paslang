program typeargcore;
type
  TByteAlias = Byte;
  TFloatAlias = Double;
  TWords = array[2..4] of Word;
  TNums = array of Word;
  PByteValue = ^Byte;
  TShadow = Word;
  TConstShadow = Word;
  TOuter = record
    type TSmall = Byte;
      TMedium = Word;
    const Mark = 7;
    var Value: Integer;
  end;
const
  ConstantSize = SizeOf(Char('A'));
  ConstantHigh = Ord(High(Char('A')));
  ConstantLow = Ord(Low(Char('A')));
var Calls: Integer;
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('type argument ', Stage, ': ', Actual, ' <> ', Expected); Halt(105); end;
end;
function NextOrdinal: Integer;
begin Calls := Calls + 1; Result := 300; end;
function MakeText: string;
begin Calls := Calls + 1; Result := 'abc'; end;
function MakeNums: TNums;
begin Calls := Calls + 1; SetLength(Result, 3); Result[0] := 9; end;
procedure VariableShadow;
var TShadow: array[1..3] of Byte;
begin
  Equal(40, SizeOf(TShadow), 3);
  Equal(41, High(TShadow), 3);
  Equal(42, Low(TShadow), 1);
  Equal(43, SizeOf(TShadow[1]), 1);
end;
procedure ConstantShadow;
const TConstShadow = Char('B');
begin
  Equal(44, SizeOf(TConstShadow), 1);
  Equal(45, Ord(High(TConstShadow)), 255);
  Equal(46, Ord(Low(TConstShadow)), 0);
end;
var Words: TWords; Rec: TOuter; ByteValue: Byte;
begin
  Equal(1, SizeOf(Integer), 8);
  Equal(2, SizeOf(Boolean), 8);
  Equal(3, SizeOf(string), 16);
  Equal(4, SizeOf(Char), 1);
  Equal(5, SizeOf(TByteAlias), 1);
  Equal(6, SizeOf(TFloatAlias), 8);
  Equal(7, SizeOf(TOuter.TSmall), 1);
  Equal(8, SizeOf(TOuter.TMedium), 2);
  Equal(9, SizeOf(TWords), 6);
  Equal(10, High(TWords), 4); Equal(11, Low(TWords), 2);
  Equal(12, High(TByteAlias), 255); Equal(13, Low(TByteAlias), 0);
  Equal(14, SizeOf(Char('A')), 1);
  Equal(15, SizeOf(TByteAlias(7)), 1);
  Equal(16, SizeOf(TOuter.TSmall(7)), 1);
  Equal(17, SizeOf(Integer(7)), 8);
  Equal(18, SizeOf(Boolean(7)), 8);
  Equal(19, SizeOf(string('abc')), 16);
  Equal(20, SizeOf(Double(7)), 8);
  Equal(21, SizeOf(TFloatAlias(7)), 8);
  Equal(22, SizeOf(Integer(7) + 1), 8);
  Equal(23, SizeOf(TByteAlias(1) + Byte(2)), 1);
  Equal(24, SizeOf((Char('A'))), 1);
  Equal(25, SizeOf(Words[2]), 2);
  Equal(26, SizeOf(Rec.Value), 8);
  Equal(27, SizeOf(PByteValue(@ByteValue)^), 1);
  Equal(28, SizeOf(TOuter.Mark), 8);
  Equal(29, Ord(High(Char('A'))), 255);
  Equal(30, Ord(Low(Char('A'))), 0);
  Equal(31, High(Byte(1)), 255);
  Equal(32, Low(Int8(1)), -128);
  Equal(33, Ord(High(Boolean(0))), 1);
  Equal(34, Ord(Low(Boolean(1))), 0);
  Equal(35, High(Integer(1) + 2), 9223372036854775807);
  Equal(36, Low(Integer(1) + 2), -9223372036854775807 - 1);
  Equal(37, ConstantSize, 1); Equal(38, ConstantHigh, 255); Equal(39, ConstantLow, 0);
  VariableShadow(); ConstantShadow();
  Calls := 0;
  Equal(50, SizeOf(NextOrdinal()), 8);
  Equal(51, SizeOf(Char(NextOrdinal())), 1);
  Equal(52, SizeOf(MakeText()), 16);
  Equal(53, SizeOf(MakeNums()), 24);
  Equal(54, Ord(High(Char(NextOrdinal()))), 255);
  Equal(55, Ord(Low(Char(NextOrdinal()))), 0);
  Equal(56, High(Byte(NextOrdinal()) + Byte(1)), 255);
  Equal(57, Calls, 0);
  Equal(58, High(MakeText()), 3); Equal(59, Calls, 1);
  Equal(60, Low(MakeText()), 1); Equal(61, Calls, 1);
  Equal(62, High(MakeNums()), 2); Equal(63, Calls, 2);
  Equal(64, Low(MakeNums()), 0); Equal(65, Calls, 2);
  WriteLn('ok complete type and expression arguments');
end.
