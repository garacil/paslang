{ The debugger's console (P120): run under --debug-mode with the
  commands on standard input, the program stops before its first
  statement, at a break in Square, steps, prints, lists and runs to the
  end; the words that asked for the console are not in its command
  line, and its environment is as it was. The same under --debug-listen
  with --debug-attach from a second process. }
program debug2;

uses paslib;

var
  total: Integer;
  name: string;

function Square(X: Integer): Integer;
var
  r: Integer;
begin
  r := X * X;
  Result := r;
end;

var
  i: Integer;
begin
  name := 'debug2';
  WriteLn('args ', ParamCount, ' ', ParamStr(1), ' ', ParamStr(2));
  WriteLn('env ', GetEnv('DEBUG2_ENV'));
  total := 0;
  for i := 1 to 3 do
    total := total + Square(i);
  WriteLn('total ', total, ' of ', name);
end.

