program narrowmem;

{ The narrow integers in memory (P99, 1.0.91): Byte, Int8 one byte, Word,
  Int16 two, UInt32, Int32 four, in arrays, records, through pointers and
  var parameters. A record's fields lie at their natural alignment, a
  field that holds a pointer on a word. A load extends by the sign for
  Int8, Int16 and Int32; a store writes its width alone, so a packed
  neighbour stays as it was ($FF around each). }

type
  TMix = record
    B: Byte;
    W: Word;
    I: Int32;
  end;
  TPad = record
    C: Char;
    S: string;
    B: Byte;
  end;
  TAll = record
    B: Byte;
    S8: Int8;
    W: Word;
    S16: Int16;
    U: UInt32;
    S32: Int32;
    N: Integer;
  end;
  PAll = ^TAll;

const
  Table: array[0..3] of Byte = (1, 200, 255, 7);
  Signs: array[0..2] of Int8 = (-1, 127, -128);

var
  bytes: array[0..9] of Byte;
  words: array[0..4] of Word;
  ints: array[0..3] of Int32;
  s8s: array[0..3] of Int8;
  dyn: array of Int16;
  m: TMix;
  all: TAll;
  p: PAll;
  pad: array[0..1] of TPad;
  i, sum: Integer;
  pb: ^Byte;
  pw: ^Word;

procedure Bump(var X: Byte);
begin
  X := X + 1;
end;

procedure Twice(var X: Int16);
begin
  X := X * 2;
end;

function Low8(V: Integer): Byte;
begin
  Result := Byte(V);
end;

function Neg8(V: Int8): Int8;
begin
  Result := -V;
end;

begin
  WriteLn(SizeOf(Byte), ' ', SizeOf(Int8), ' ', SizeOf(Word), ' ', SizeOf(Int16), ' ',
    SizeOf(UInt32), ' ', SizeOf(Int32), ' ', SizeOf(Integer));
  WriteLn(SizeOf(bytes), ' ', SizeOf(words), ' ', SizeOf(ints), ' ', SizeOf(TMix), ' ',
    SizeOf(TPad), ' ', SizeOf(TAll));
  WriteLn(Integer(@m.W) - Integer(@m), ' ', Integer(@m.I) - Integer(@m), ' ',
    Integer(@pad[0].S) - Integer(@pad[0]), ' ', Integer(@pad[0].B) - Integer(@pad[0]), ' ',
    Integer(@pad[1]) - Integer(@pad[0]));
  WriteLn(Integer(@all.S8) - Integer(@all), ' ', Integer(@all.W) - Integer(@all), ' ',
    Integer(@all.S16) - Integer(@all), ' ', Integer(@all.U) - Integer(@all), ' ',
    Integer(@all.S32) - Integer(@all), ' ', Integer(@all.N) - Integer(@all));
  { A store writes its width alone. }
  for i := 0 to 9 do
    bytes[i] := 255;
  bytes[4] := 1;
  bytes[5] := bytes[5] + 1;
  Inc(bytes[6]);
  Bump(bytes[7]);
  sum := 0;
  for i := 0 to 9 do
    sum := sum * 3 + bytes[i];
  WriteLn(bytes[3], ' ', bytes[4], ' ', bytes[5], ' ', bytes[6], ' ', bytes[7], ' ', bytes[8], ' ', sum);
  for i := 0 to 4 do
    words[i] := 65535;
  words[2] := 1;
  Dec(words[3]);
  WriteLn(words[1], ' ', words[2], ' ', words[3], ' ', words[4]);
  for i := 0 to 3 do
    ints[i] := -1;
  ints[1] := 5;
  WriteLn(ints[0], ' ', ints[1], ' ', ints[2]);
  { Loads extend by the sign. }
  s8s[0] := -1;
  s8s[1] := -128;
  s8s[2] := 127;
  s8s[3] := s8s[0] + s8s[2];
  WriteLn(s8s[0], ' ', s8s[1], ' ', s8s[2], ' ', s8s[3], ' ', s8s[0] * 3);
  SetLength(dyn, 3);
  dyn[0] := -300;
  dyn[1] := 30000;
  dyn[2] := dyn[1] + dyn[1];
  Twice(dyn[0]);
  WriteLn(dyn[0], ' ', dyn[1], ' ', dyn[2], ' ', SizeOf(dyn[0]));
  { Records and a pointer to one. }
  m.B := 250;
  m.W := 65000;
  m.I := -2000000000;
  m.B := m.B + 10;
  WriteLn(m.B, ' ', m.W, ' ', m.I);
  New(p);
  p^.B := 255;
  p^.S8 := -5;
  p^.W := 40000;
  p^.S16 := -20000;
  p^.U := 4000000000;
  p^.S32 := -7;
  p^.N := 1 shl 40;
  Inc(p^.B);
  Dec(p^.S8, 124);
  WriteLn(p^.B, ' ', p^.S8, ' ', p^.W, ' ', p^.S16, ' ', p^.U, ' ', p^.S32, ' ', p^.N);
  all := p^;
  WriteLn(all.S16 + all.S32, ' ', all.U + all.S8);
  pad[1].C := 'z';
  pad[1].S := 'str';
  pad[1].B := 9;
  WriteLn(pad[1].C, pad[1].S, pad[1].B);
  { Through typed pointers. }
  pb := @bytes[2];
  pb^ := 42;
  pw := @words[0];
  pw^ := pw^ - 1;
  WriteLn(bytes[1], ' ', bytes[2], ' ', bytes[3], ' ', words[0], ' ', words[1]);
  { Move and FillChar see the real sizes (FillChar: 1.0.91). }
  FillChar(bytes, SizeOf(bytes), 0);
  Move(Table, bytes[3], SizeOf(Table));
  WriteLn(bytes[2], ' ', bytes[3], ' ', bytes[4], ' ', bytes[5], ' ', bytes[6], ' ', bytes[7]);
  WriteLn(Signs[0], ' ', Signs[1], ' ', Signs[2], ' ', Table[1] + Table[2]);
  WriteLn(Low8(513), ' ', Neg8(-128), ' ', Neg8(5));
  FillChar(words, SizeOf(words), 255);
  FillChar(words[1], 2, 0);
  FillChar(words[3], 0, 7);
  WriteLn(words[0], ' ', words[1], ' ', words[2], ' ', words[3], ' ', words[4]);
  FillChar(pad[0].C, 1, 'q');
  WriteLn(pad[0].C);
end.
