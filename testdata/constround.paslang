{ Int, Trunc, Round and Frac in a constant (P163), as Free Pascal's
  reference lists them: each constant is the value the same word gives
  at run time, which the program writes beside it: Round a tie to even,
  Trunc towards zero, Int an integral real, Frac what is left, of
  negatives, of integers and of reals near 2^60 and 2^63, which a
  Double holds exactly (Free Pascal works a constant out in its 80-bit
  Extended, paslang in the Double, section 19). The output is Free
  Pascal's. }
program constround;

{$mode objfpc}{$H+}

type
  TDateTime = Double;

const
  JulianEpoch = TDateTime(-2415018.5);
  UnixEpoch = JulianEpoch + TDateTime(2440587.5);
  UnixDateDelta = Trunc(UnixEpoch);
  T1 = Trunc(2.7);
  T2 = Trunc(-2.7);
  T3 = Trunc(7);
  R1 = Round(2.5);
  R2 = Round(3.5);
  R3 = Round(-2.5);
  R4 = Round(-0.5);
  R5 = Round(2.4999999999999996);
  R6 = Round(1e18 + 0.5);
  I1 = Int(2.75);
  I2 = Int(-2.75);
  I3 = Int(1152921504606846976.0);
  F1 = Frac(2.75);
  F2 = Frac(-2.75);
  F3 = Frac(1152921504606846976.0);
  P = Trunc(Pi * 1000) + Round(Frac(Pi) * 100);
  Big = Trunc(9223372036854774784.0);
  Days: array[0..UnixDateDelta mod 7] of Byte = (1, 2, 3, 4, 5, 6);

var
  x: Double;

begin
  WriteLn(UnixDateDelta, ' ', Length(Days));
  x := 2.7;
  WriteLn(T1, ' ', Trunc(x), ' ', T2, ' ', Trunc(-x), ' ', T3);
  x := 2.5;
  WriteLn(R1, ' ', Round(x), ' ', R3, ' ', Round(-x));
  x := 3.5;
  WriteLn(R2, ' ', Round(x), ' ', R4, ' ', Round(-0.5 + x - x));
  x := 2.4999999999999996;
  WriteLn(R5, ' ', Round(x), ' ', R6);
  x := 2.75;
  WriteLn(I1:0:2, ' ', Int(x):0:2, ' ', I2:0:2, ' ', Int(-x):0:2, ' ', F1:0:2, ' ', Frac(x):0:2, ' ',
    F2:0:2, ' ', Frac(-x):0:2);
  x := 1152921504606846976.0;
  WriteLn(I3:0:1, ' ', Int(x):0:1, ' ', F3:0:1, ' ', Frac(x):0:1, ' ', P, ' ', Big);
end.

