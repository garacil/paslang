{ P170: a class helper's constructors and static methods through the
  class's name. TFoo.Make runs the helper's constructor on a new TFoo
  and its AfterConstruction after it; TBar.Make on a new TBar, and a
  class reference's on a new object of the class it holds; f.Make runs
  it on f again, as a method, with no new object and no
  AfterConstruction. A constructor of the helper runs another on Self;
  a helper descending from it finds its constructors and static methods,
  and a static method makes an object itself. The output is written by
  hand from Free Pascal's reference (10.1: a helper declares extra
  constructors). }
program helpctor;

type
  TFoo = class
    N: Integer;
    Log: string;
    procedure AfterConstruction; override;
  end;

  TBar = class(TFoo)
    Extra: Integer;
  end;

  TFooClass = class of TFoo;

  TFooHelper = class helper for TFoo
    constructor Make(AN: Integer);
    constructor MakeDouble(AN: Integer);
    class function Twice(K: Integer): Integer; static;
    class function Fresh(K: Integer): TFoo; static;
  end;

  TFooMore = class helper(TFooHelper) for TFoo
    constructor MakeThree;
  end;

procedure TFoo.AfterConstruction;
begin
  Log := Log + ' after';
end;

constructor TFooHelper.Make(AN: Integer);
begin
  N := AN;
  Log := Log + ' make';
end;

constructor TFooHelper.MakeDouble(AN: Integer);
begin
  Make(AN * 2);
  Log := Log + ' double';
end;

class function TFooHelper.Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

class function TFooHelper.Fresh(K: Integer): TFoo;
begin
  Result := TFoo.Make(K + 1);
end;

constructor TFooMore.MakeThree;
begin
  Make(3);
  Log := Log + ' three';
end;

var
  f, g: TFoo;
  b: TBar;
  c: TFooClass;

begin
  f := TFoo.Make(5);
  WriteLn(f.N, f.Log);
  f.Make(9);
  WriteLn(f.N, f.Log);
  b := TBar.Make(7);
  WriteLn(b.N, ' ', b.Extra, b.Log);
  g := TBar.Make(8);
  WriteLn(g.N, ' ', g is TBar);
  c := TBar;
  g := c.Make(3);
  WriteLn(g.N, g.Log, ' ', g is TBar);
  c := TFoo;
  g := c.Make(4);
  WriteLn(g.N, g.Log, ' ', g is TBar);
  g := TFoo.MakeDouble(4);
  WriteLn(g.N, g.Log);
  g := TFoo.MakeThree;
  WriteLn(g.N, g.Log);
  WriteLn(TFoo.Twice(21), ' ', TBar.Twice(5));
  g := TFoo.Fresh(10);
  WriteLn(g.N, g.Log);
end.

