program wide;

{ The wide words of P106 (1.0.121): MulHi, MulHiS, Mul128, DivMod128,
  AddCarry, SubBorrow, AddOverflow, SubOverflow, MulOverflow, AddSat and
  SubSat, on edge values and on 2000 values of a xorshift, in a loop the
  register pool keeps, against a Python model. }

var
  a, b, hi, lo, q, r, c, x, h, k: Integer;
  i: Integer;
  bb: Byte;
  s8: Int8;
  w: Word;
  ov: Boolean;

procedure Pool;
var
  x, y, h, j: Integer;
begin
  h := 0;
  x := $0123456789ABCDEF;
  y := -7;
  for j := 1 to 1000 do
  begin
    x := x xor (x shl 13);
    x := x xor (x shr 7);
    x := x xor (x shl 17);
    y := y * 31 + j;
    h := h * 31 + MulHi(x, y) + MulHiS(x, y) * 3 + MulHi(x, 12345);
  end;
  WriteLn('pool ', h);
end;

begin
  WriteLn(MulHi(-1, -1), ' ', MulHiS(-1, -1), ' ', MulHi(-9223372036854775807 - 1, 2), ' ',
    MulHiS(-9223372036854775807 - 1, 2), ' ', MulHi(4294967296, 4294967296));
  a := -1;
  b := 3;
  WriteLn(MulHi(a, b), ' ', MulHiS(a, b), ' ', MulHi(a, a), ' ', MulHiS(a, a));
  { 128-bit a1:a0 + b1:b0 and a1:a0 - b1:b0 }
  lo := AddCarry(-1, 1, 0, c);
  hi := AddCarry(5, 7, c, c);
  WriteLn(hi, ' ', lo, ' ', c);
  lo := SubBorrow(0, 1, 0, c);
  hi := SubBorrow(5, 7, c, c);
  WriteLn(hi, ' ', lo, ' ', c);
  lo := AddCarry(-1, -1, 1, c);
  WriteLn(lo, ' ', c);
  ov := AddOverflow(9223372036854775807, 1, r);
  WriteLn(ov, ' ', r);
  ov := SubOverflow(-9223372036854775807 - 1, 1, r);
  WriteLn(ov, ' ', r);
  ov := MulOverflow(4294967296, 4294967296, r);
  WriteLn(ov, ' ', r);
  ov := MulOverflow(-3, 7, r);
  WriteLn(ov, ' ', r);
  ov := AddOverflow(200, 100, bb);
  WriteLn(ov, ' ', bb);
  ov := AddOverflow(100, 27, s8);
  WriteLn(ov, ' ', s8);
  ov := AddOverflow(100, 28, s8);
  WriteLn(ov, ' ', s8);
  ov := SubOverflow(0, 1, w);
  WriteLn(ov, ' ', w);
  WriteLn(AddSat(9223372036854775807, 5), ' ', SubSat(-9223372036854775807 - 1, 5), ' ',
    AddSat(-5, 3), ' ', SubSat(3, -9223372036854775807));
  bb := 250;
  s8 := -120;
  w := 10;
  WriteLn(AddSat(bb, Byte(10)), ' ', SubSat(Byte(3), bb), ' ', AddSat(s8, Int8(-20)), ' ',
    SubSat(s8, Int8(20)), ' ', SubSat(w, Word(11)), ' ', AddSat(s8, Int8(5)));
  Mul128(-1, -1, hi, lo);
  WriteLn(hi, ' ', lo);
  DivMod128(hi, lo, -1, q, r);
  WriteLn(q, ' ', r);
  h := 0;
  x := 88172645463325252;
  for i := 1 to 2000 do
  begin
    x := x xor (x shl 13);
    x := x xor (x shr 7);
    x := x xor (x shl 17);
    a := x;
    b := x shr 3 or 1;
    Mul128(a, b, hi, lo);
    DivMod128(hi, lo, b, q, r);
    k := 0;
    if q = a then
      k := 1;
    if r = 0 then
      k := k + 2;
    DivMod128(hi and 1023, lo, b or $1000000000000, q, r);
    h := h * 31 + q + r * 7 + k;
    lo := AddCarry(a, b, i and 1, c);
    h := h * 31 + lo + c;
    lo := SubBorrow(a, b, i and 1, c);
    h := h * 31 + lo + c;
    if AddOverflow(a, b, r) then
      h := h + 1;
    if MulOverflow(a shr 40, b shr 40, r) then
      h := h + 2;
    h := h * 31 + AddSat(a, b) + SubSat(a, b);
  end;
  WriteLn('loop ', h);
  Pool;
end.

