function MachineRolDynamic(seed, count: Integer): Integer;
begin
  asm amd64 (seed: in rdx; count: in rcx; Result: out rax)
    movq %rdx, %rax
    roll %cl, %eax
  end;
  asm arm64 (seed: in x2; count: in x1; Result: out x0)
    mov x0, x2
    neg w1, w1
    ror w0, w0, w1
  end;
end;
