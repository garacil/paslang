var Calls, n: Integer;
function Pass(a: UInt32): UInt32; begin Calls += 1; Result := a; end;
function MachineRol0(seed: Integer): Integer;
begin
  asm amd64 (seed: in rdx; Result: out rax)
    movq %rdx, %rax
    roll $0, %eax
  end;
  asm arm64 (seed: in x2; Result: out x0)
    mov x0, x2
    ror w0, w0, #0
  end;
end;
function TypedRol0(a: UInt32): UInt32;
begin Result := Pass(a) rol 0; end;
function MachineRol7(seed: Integer): Integer;
begin
  asm amd64 (seed: in rdx; Result: out rax)
