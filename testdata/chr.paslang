{ Chr(n) is the character with code n (1.0.53): a Char, so it prints as
  the character, joins a string and goes back through Ord. }
program chr;

var
  i: Integer;
  s: string;
  c: Char;

begin
  s := '';
  for i := 0 to 25 do
    s := s + Chr(Ord('a') + i);
  WriteLn(s);
  c := Chr(90);
  WriteLn(c, ' ', Ord(Chr(65)), ' ', Ord(Chr(52)) - Ord(Chr(50)));
end.
