program genericlocal;
{$mode objfpc}{$H+}
procedure Outer;
type
  generic TBox<T> = record First: T; end;
  TNumber = specialize TBox<Int64>;
var N: TNumber;
  procedure Inner;
  type
    generic TBox<T> = record Other: T; end;
    TNumber = specialize TBox<Int64>;
  var M: TNumber;
  begin M.Other := 31; WriteLn('inner ', M.Other) end;
begin
  N.First := 29;
  Inner;
  WriteLn('outer ', N.First);
end;
begin Outer end.
