{ P275: a routine whose var or out parameter is a record goes in place
  where it is called: its fields read and write the place the caller
  gives, as through the address the call would pass. Places of every
  kind (a local, a global, a field, an element at a constant and at a
  variable, a pointer's target, the caller's own var parameter), out,
  a record with a string, and a place found through a variable another
  var parameter is given, which stays a call: the body changes that
  variable before it writes the place, and the call reached the place
  by the address it took first. -inline 0 gives the same lines. }
program inlinevar;

type
  TPos = record
    X, Y: Integer;
    Name: string;
  end;
  PPos = ^TPos;
  TBox = record
    Inner: TPos;
    Count: Integer;
  end;

procedure Step(var P: TPos; D: Integer);
begin
  P.X := P.X + D;
  if P.X > 10 then
    P.Y := P.Y + 1;
end;

function Sum(var P: TPos): Integer;
begin
  Result := P.X + P.Y;
end;

procedure Wipe(out P: TPos);
begin
  P.X := 0;
  P.Y := 0;
  P.Name := '';
end;

procedure Tag(var P: TPos; C: Char);
begin
  P.Name := P.Name + C;
end;

procedure Shift(var A, B: TPos);
begin
  A.X := A.X + B.X;
  B.X := 0;
end;

{ The place the first is given may be found through the second. }
procedure Bump(var P: Integer; var I: Integer);
begin
  I := I + 1;
  P := P + 10;
end;

procedure BumpPos(var P: TPos; var I: Integer);
begin
  I := I + 1;
  P.X := P.X + 100;
end;

procedure Repoint(var P: TPos; var Q: PPos; Other: PPos);
begin
  Q := Other;
  P.Y := P.Y + 1000;
end;

var
  g: TPos;
  gbox: TBox;
  garr: array[0..3] of TPos;

procedure Show(const Title: string; const P: TPos);
begin
  WriteLn(Title, ' ', P.X, ' ', P.Y, ' ', P.Name);
end;

procedure Inner(var P: TPos);
begin
  Step(P, 7);
  Tag(P, 'i');
end;

{ A place found through a pointer another var parameter is given stays
  a call. Here, apart: a call may change a variable whose address went
  to another (P326), so in Locals p's places would stay calls too. }
procedure Repointing(p: PPos);
var
  q, r: PPos;
begin
  New(q);
  q^.Y := 0;
  p^.Y := 0;
  r := p;
  Repoint(p^, p, q);
  Write('repoint ', r^.Y, ' ', q^.Y);
  if p = q then
    WriteLn(' moved')
  else
    WriteLn(' stayed');
end;

procedure Locals;
var
  a, b: TPos;
  box: TBox;
  arr: array[0..3] of TPos;
  dyn: array of TPos;
  p: PPos;
  j, k, n: Integer;
  ints: array[0..3] of Integer;
begin
  Wipe(a);
  Wipe(b);
  for j := 1 to 20 do
    Step(a, j);
  Show('local', a);
  WriteLn('sum ', Sum(a));
  box.Count := 0;
  Wipe(box.Inner);
  Step(box.Inner, 15);
  Tag(box.Inner, 'b');
  Show('field', box.Inner);
  for j := 0 to 3 do
  begin
    Wipe(arr[j]);
    Step(arr[j], j * 7);
  end;
  Step(arr[2], 1);
  Show('element 2', arr[2]);
  Show('element 3', arr[3]);
  SetLength(dyn, 3);
  for j := 0 to 2 do
  begin
    Wipe(dyn[j]);
    Step(dyn[j], 11 + j);
    Tag(dyn[j], Char(Ord('a') + j));
  end;
  Show('dynamic 2', dyn[2]);
  New(p);
  Wipe(p^);
  Step(p^, 12);
  Tag(p^, 'p');
  Show('pointer', p^);
  Inner(a);
  Show('inner', a);
  a.X := 5;
  b.X := 6;
  Shift(a, b);
  WriteLn('move ', a.X, ' ', b.X);
  Shift(a, a);
  WriteLn('move self ', a.X);
  { found through a variable another var parameter is given }
  for n := 0 to 3 do
    ints[n] := 0;
  k := 1;
  Bump(ints[k], k);
  WriteLn('bump ', ints[0], ' ', ints[1], ' ', ints[2], ' ', k);
  for n := 0 to 3 do
    arr[n].X := 0;
  k := 1;
  BumpPos(arr[k], k);
  WriteLn('bumppos ', arr[0].X, ' ', arr[1].X, ' ', arr[2].X, ' ', k);
  Repointing(p);
end;

begin
  Wipe(g);
  Step(g, 30);
  Tag(g, 'g');
  Show('global', g);
  Wipe(gbox.Inner);
  Step(gbox.Inner, 4);
  Show('global field', gbox.Inner);
  Wipe(garr[1]);
  Step(garr[1], 40);
  Show('global element', garr[1]);
  Locals;
end.

