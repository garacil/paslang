program forkguard;
var realGuard, observed, pid, resultValue, forkNumber, forkFlags,
  exitNumber, waitNumber: Int64;
  status: Int32;
begin
  if Amd64 then
  begin forkNumber := 57; forkFlags := 0; exitNumber := 60; waitNumber := 61 end
  else
  begin forkNumber := 220; forkFlags := 17; exitNumber := 93; waitNumber := 260 end;
  { Deterministically model the GC's copied stack-move request at fork.
    The child has no GC/scheduler threads; only its real guard is valid.
    Official Intel MOV and ARM LDR/STR/MOVN were read for these fixtures. }
  asm amd64 (realGuard: out rax)
    movq 24(%r14), %rax
    movq $-1315, 16(%r14)
  end;
  asm arm64 (realGuard: out x0)
    ldr x0, [x28, #24]
    movn x1, #1314
    str x1, [x28, #16]
  end;
  pid := Syscall(forkNumber, forkFlags, 0, 0, 0, 0);
  asm amd64 (observed: out rax)
    movq 16(%r14), %rax
  end;
  asm arm64 (observed: out x0)
    ldr x0, [x28, #16]
  end;
  if pid = 0 then
  begin
    if observed = realGuard then resultValue := Syscall(exitNumber, 0)
    else resultValue := Syscall(exitNumber, 42);
  end;
  { The injected request was not a real GC cycle. Restore the parent's
    guard before calling ordinary Pascal. Never share this fixture API. }
  asm amd64
    movq 24(%r14), %rax
    movq %rax, 16(%r14)
  end;
  asm arm64
    ldr x0, [x28, #24]
    str x0, [x28, #16]
  end;
  if pid < 0 then Halt(2);
  status := 0;
  repeat resultValue := Syscall(waitNumber, pid, Integer(@status), 0, 0); until resultValue <> -4;
  if (resultValue <> pid) or (status <> 0) then Halt(3);
  WriteLn('fork child discards copied GC/preemption guards');
end.
