{ P75: a local may not take a name the routine already uses. This
  program is the good one: the same shapes as the three that are
  refused, but with names of their own. The refusals are checked by
  make check, which compiles four small programs that must each fail
  with duplicate identifier. }
program dupparam;

type
  TThing = class
    Depth: Integer;
    function Routine: string;
    function Go: string;
  end;

function TThing.Routine: string;
begin
  Result := 'method';
end;

{ A local with a name of its own: it does not hide the method Routine
  nor the field Depth, so both are still reachable. }
function TThing.Go: string;
var
  what: string;
  d: Integer;
begin
  what := 'local';
  d := 7;
  Depth := 5;
  if d + Depth = 12 then
    Result := what + ' ' + Routine
  else
    Result := 'wrong';
end;

{ A parameter and a local that do not clash. }
function Twice(N: Integer): Integer;
var
  M: Integer;
begin
  M := 2;
  Result := N * M;
end;

var
  t: TThing;

begin
  t := TThing.Create;
  WriteLn(t.Go);
  WriteLn(t.Depth);
  WriteLn(Twice(21));
end.

