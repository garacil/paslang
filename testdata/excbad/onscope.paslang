{ P122: the name an on handler gives the object is the handler's
  alone: after it, the name is unknown. }
program onscope;

begin
  try
    raise TObject.Create;
  except
    on Err: TObject do
      WriteLn('caught');
  end;
  WriteLn(Err.ClassName);
end.

