{ P196: a kernel word calls its processor body only when the -cpu the
  program is compiled for has every feature the body uses. The SHA-NI
  rounds need sha, ssse3 and sse41 on amd64 (three features, which the
  old CpuSuffix could not ask for), CRC-32 pclmul and sse41, CRC-32C
  sse42; on arm64 the crypto extension and crc32. make check compiles
  this program for each -cpu of a matrix, greps the .s for the body
  each word calls and runs it: every path prints the same bytes, which
  Python's hashlib, hmac and zlib also give (the RFC 9162 Merkle root
  and CRC-32C by their definitions). }
program cpufeat;

var
  s: string;
  i: Integer;
  leaves: array of string;

begin
  SetLength(s, 300);
  for i := 1 to 300 do
    s[i] := Char((i * 7 + 3) and 255);
  WriteLn(Hex(Sha1(s)));
  WriteLn(Hex(Sha256(s)));
  WriteLn(Hex(Sha224(s)));
  WriteLn(Hex(HmacSha1('key', s)));
  WriteLn(Hex(HmacSha256('key', s)));
  SetLength(leaves, 3);
  leaves[0] := 'a';
  leaves[1] := 'b';
  leaves[2] := 'c';
  WriteLn(Hex(MerkleRoot(leaves)));
  WriteLn(Crc32(s), ' ', Crc32c(s));
  WriteLn(Pos('z', s + 'z'));
end.
