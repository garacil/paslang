{ P323: a product by a constant no recipe takes reads its variable's
  register, or its home, into IMUL's destination: imulq $c, %src, %dst
  with no move first. Reg multiplies a loop's variable, Home a global and
  a local across a call, for every integer type, each widened first.
  scripts/check_imulconst.py reads that no register is moved before an
  imulq of a constant. Written by a script; the answers are Python's. }
program imulconst;

var
  g: Integer;

procedure Touch(x: Integer);
begin
  if x = -12345 then
    WriteLn('touch');
end;

function RegInteger(n: Integer): Integer;
var
  i, s: Integer;
  v: Integer;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    v := Integer(i * 37 + 5);
    s := s xor (Integer(v) * 1000);
    s := s xor (Integer(v) * 1021);
    s := s xor (Integer(v) * 12345);
    s := s xor (Integer(v) * -1000);
    s := s xor (Integer(v) * -77777);
    s := s xor (Integer(v) * 2147483647);
    s := s xor (Integer(v) * -2147483648);
    s := s xor (Integer(v) * 4099);
  end;
  Result := s;
end;

function RegInt32(n: Integer): Integer;
var
  i, s: Integer;
  v: Int32;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    v := Int32(i * 37 + 5);
    s := s xor (Integer(v) * 1000);
    s := s xor (Integer(v) * 1021);
    s := s xor (Integer(v) * 12345);
    s := s xor (Integer(v) * -1000);
    s := s xor (Integer(v) * -77777);
    s := s xor (Integer(v) * 2147483647);
    s := s xor (Integer(v) * -2147483648);
    s := s xor (Integer(v) * 4099);
  end;
  Result := s;
end;

function RegWord(n: Integer): Integer;
var
  i, s: Integer;
  v: Word;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    v := Word(i * 37 + 5);
    s := s xor (Integer(v) * 1000);
    s := s xor (Integer(v) * 1021);
    s := s xor (Integer(v) * 12345);
    s := s xor (Integer(v) * -1000);
    s := s xor (Integer(v) * -77777);
    s := s xor (Integer(v) * 2147483647);
    s := s xor (Integer(v) * -2147483648);
    s := s xor (Integer(v) * 4099);
  end;
  Result := s;
end;

function RegByte(n: Integer): Integer;
var
  i, s: Integer;
  v: Byte;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    v := Byte(i * 37 + 5);
    s := s xor (Integer(v) * 1000);
    s := s xor (Integer(v) * 1021);
    s := s xor (Integer(v) * 12345);
    s := s xor (Integer(v) * -1000);
    s := s xor (Integer(v) * -77777);
    s := s xor (Integer(v) * 2147483647);
    s := s xor (Integer(v) * -2147483648);
    s := s xor (Integer(v) * 4099);
  end;
  Result := s;
end;

function Home(n: Integer): Integer;
var
  i, s, x: Integer;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    x := i * 91 - 7;
    g := i * 13 + 1;
    Touch(i);
    s := s + x * 1000 - g * 1000;
    s := s + x * 1021 - g * 1021;
    s := s + x * 12345 - g * 12345;
    s := s + x * -1000 - g * -1000;
    s := s + x * -77777 - g * -77777;
    s := s + x * 2147483647 - g * 2147483647;
    s := s + x * -2147483648 - g * -2147483648;
    s := s + x * 4099 - g * 4099;
  end;
  Result := s;
end;

begin
  WriteLn('Integer ', RegInteger(300));
  WriteLn('Int32 ', RegInt32(300));
  WriteLn('Word ', RegWord(300));
  WriteLn('Byte ', RegByte(300));
  WriteLn('Home ', Home(300));
end.
