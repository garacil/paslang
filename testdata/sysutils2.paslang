{ SysUtils (P128): what Free Pascal's sources after 3.2.2 add, which its
  3.2.2 release does not have to compare with: StringReplace with the
  count of replacements, EInOutArgumentException with its path, and
  GetBaseException, the object it is called on (paslang keeps no list
  of the exceptions being handled). The output follows those sources. }
program sysutils2;

uses sysutils;

var
  n: Integer;
  e: Exception;
begin
  WriteLn(StringReplace('aXbXc', 'X', '--', [rfReplaceAll], n), ' ', n);
  WriteLn(StringReplace('aXbXc', 'X', '--', [], n), ' ', n);
  WriteLn(StringReplace('abc', 'z', '-', [rfReplaceAll], n), ' ', n);
  WriteLn(StringReplace('xxAxa', 'XA', '.', [rfReplaceAll, rfIgnoreCase], n), ' ', n);
  e := EInOutArgumentException.Create('no such file', '/x/y');
  WriteLn(e.ClassName, ' ', e.Message, ' ', EInOutArgumentException(e).Path, ' ',
    e.ClassParent.ClassName);
  try
    raise EConvertError.Create('inner');
  except
    on x: Exception do
      WriteLn(x.GetBaseException.Message, ' ', x.GetBaseException = x);
  end;
end.

