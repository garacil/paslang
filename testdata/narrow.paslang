program narrow;

{ The narrow integers keep their width in their values (P99, 1.0.89).
  The indicated type rules: the variable assigned, a value parameter,
  a conversion, a for counter, Result; with none, an integer tree works
  in its widest operand's type and a constant with no type adapts. A
  signed and an unsigned type join in the signed type that holds both.
  Values wrap to the low bits, extended by the sign for Int8, Int16 and
  Int32 and by zeros for the others. }

type
  TRec = record
    B: Byte;
    S: Int8;
    W: Word;
  end;

var
  b, b2: Byte;
  s8: Int8;
  w: Word;
  s16: Int16;
  u32: UInt32;
  s32: Int32;
  i, n, x: Integer;
  d: Double;
  r: TRec;

function Next(v: Byte): Byte;
begin
  Result := v + 1;
end;

function Wide(v: Byte): Integer;
begin
  Result := v + 1;
end;

begin
  { Wraps. }
  b := 255;
  b := b + 1;
  w := 65535;
  w := w + 1;
  s8 := 127;
  s8 := s8 + 1;
  s16 := -32768;
  s16 := s16 - 1;
  u32 := 4294967295;
  u32 := u32 + 1;
  s32 := 2147483647;
  s32 := s32 + 1;
  WriteLn(b, ' ', w, ' ', s8, ' ', s16, ' ', u32, ' ', s32);
  { The context decides the width. }
  b := 255;
  i := b + 1;
  WriteLn(i, ' ', Integer(b + 1), ' ', b + 1, ' ', b + 1 + i);
  b := 200;
  WriteLn(b + 100, ' ', Word(b + 100), ' ', b * 2, ' ', b shl 1);
  d := b + 100;
  WriteLn(d);
  { Joins. }
  b := 200;
  s8 := -100;
  w := 65535;
  s16 := -1;
  u32 := 4000000000;
  s32 := -1;
  WriteLn(b + s8, ' ', w + s16, ' ', u32 + s32, ' ', b + w);
  { Conversions keep the low bits. }
  x := 300;
  WriteLn(Byte(x), ' ', Int8(x - 100), ' ', Word(-x), ' ', UInt32(-1 * x), ' ', Int32(4294967295 + x));
  x := -1;
  WriteLn(Byte(x), ' ', Word(x), ' ', UInt32(x), ' ', Int16(x));
  { div, mod and shr by the sign. }
  s8 := -128;
  s8 := s8 div -1;
  WriteLn(s8);
  s8 := -7;
  WriteLn(s8 div 2, ' ', s8 mod 3, ' ', s8 shr 1);
  b := 200;
  WriteLn(b shr 1, ' ', b div 3, ' ', b mod 7);
  s16 := -1;
  s32 := -256;
  u32 := 4294967295;
  WriteLn(s16 shr 4, ' ', s32 shr 4, ' ', u32 shr 31);
  { not and the negative stay in the type. }
  b := 1;
  b2 := -b;
  s8 := -128;
  s8 := -s8;
  WriteLn(b2, ' ', s8, ' ', not b, ' ', not w);
  w := 300;
  w := w * w;
  WriteLn(w);
  { Inc and Dec wrap. }
  b := 255;
  Inc(b);
  w := 0;
  Dec(w);
  b2 := 0;
  Inc(b2, 300);
  s8 := -128;
  Dec(s8);
  WriteLn(b, ' ', w, ' ', b2, ' ', s8);
  { A narrow counter stops on its limit. }
  n := 0;
  for b := 0 to 255 do
    n := n + 1;
  WriteLn(n);
  n := 0;
  for s8 := 127 downto -128 do
    n := n + s8;
  WriteLn(n);
  n := 0;
  for b := 250 to 255 do
  begin
    if b = 252 then
      Continue;
    n := n + b;
  end;
  WriteLn(n);
  { case, a record, routines. }
  b := 7;
  case b of
    0..6: WriteLn('low');
    7: WriteLn('seven');
    255: WriteLn('top');
  end;
  r.B := 255;
  r.B := r.B + 1;
  r.S := -128;
  r.S := r.S - 1;
  r.W := 1;
  r.W := r.W - 2;
  WriteLn(r.B, ' ', r.S, ' ', r.W);
  WriteLn(Next(255), ' ', Wide(255), ' ', Next(Next(254)));
  b := 255;
  if b + 1 = 0 then
    WriteLn('wrapped in Byte');
  if b + 1 > i then
    WriteLn('never')
  else
    WriteLn('Integer side');
end.
