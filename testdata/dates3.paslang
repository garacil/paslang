{ SysUtils' local time (P131) on pastime's zone, Go's time.Local, under
  TZ set to a TZif file of testdata/zoneinfo: DateTimeToFileDate and
  UniversalToFileDate (a moment in Unix seconds from a local and a UTC
  date), FileDateToDateTime and FileDateToUniversal back, the offset
  GetLocalTimeOffset gives of a date taken as UTC and as local time, and
  UniversalTimeToLocal and LocalTimeToUniversal, exact to the second.
  The make check runs it with five zones; the output is Go's. }
program dates3;

uses sysutils;

function F(d: TDateTime): string;
begin
  Result := FormatDateTime('yyyy-mm-dd hh:nn:ss', d);
end;

procedure One(y, m, d, h, n, s: Integer);
var
  t: TDateTime;
  fd: Int64;
  offU, offL: Integer;
  dstU, dstL: Boolean;
begin
  t := EncodeDate(y, m, d) + EncodeTime(h, n, s, 0);
  fd := DateTimeToFileDate(t);
  Write(F(t), ' fd ', fd, ' ufd ', UniversalToFileDate(t), ' back ', F(FileDateToDateTime(fd)),
    ' univ ', F(FileDateToUniversal(fd)), ' +100 ', F(FileDateToDateTime(fd + 8640000)));
  GetLocalTimeOffset(t, True, offU, dstU);
  GetLocalTimeOffset(t, False, offL, dstL);
  Write(' offU ', offU, ' ', Ord(dstU), ' offL ', offL, ' ', Ord(dstL));
  WriteLn(' u2l ', F(UniversalTimeToLocal(t)), ' l2u ', F(LocalTimeToUniversal(t)));
end;

begin
  One(2026, 1, 15, 12, 0, 0);
  One(2026, 7, 15, 12, 0, 0);
  One(1999, 12, 31, 23, 30, 0);
  One(2038, 1, 19, 3, 14, 7);
  One(1985, 6, 1, 6, 0, 0);
  One(2026, 10, 25, 12, 0, 0);
  One(2026, 3, 1, 0, 0, 0);
  One(2080, 8, 8, 8, 8, 8);
  One(1970, 1, 2, 0, 0, 0);
  One(2010, 11, 7, 12, 0, 0);
  One(1950, 6, 15, 9, 30, 0);
  One(1901, 1, 1, 0, 0, 0);
end.

