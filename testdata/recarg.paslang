{ P80: a record that a function returns can be handed straight to
  another routine. A record travels by address; a record value is
  already an address, because a function that returns one returns a
  pointer to a copy of it on the heap. The argument path used to spill
  that pointer as if it were a string and pass the address of the
  pointer, so the callee read the pointer as its first field and got
  nonsense, with nothing said. }
program recarg;

type
  TPoint = record
    X: Integer;
    Y: Integer;
  end;

  TBig = record
    A, B, C, D, E: Int64;
    Name: string;
  end;

function Make(N: Integer): TPoint;
begin
  Result.X := N;
  Result.Y := N * 2;
end;

function Sum(const P: TPoint): Integer;
begin
  Result := P.X + P.Y;
end;

function Moved(const P: TPoint; Dx, Dy: Integer): TPoint;
begin
  Result.X := P.X + Dx;
  Result.Y := P.Y + Dy;
end;

function Big(const S: string): TBig;
begin
  Result.A := 1;
  Result.B := 2;
  Result.C := 3;
  Result.D := 4;
  Result.E := 5;
  Result.Name := S;
end;

function Tell(const B: TBig): string;
begin
  Result := B.Name + ' ' + Char(48 + B.A) + Char(48 + B.E);
end;

type
  TBox = class
    Base: TPoint;
    function Plus(const P: TPoint): Integer;
    procedure Note(const P: TPoint);
  end;

procedure Note(const P: TPoint);
begin
  WriteLn('note ', P.X, ' ', P.Y);
end;

function TBox.Plus(const P: TPoint): Integer;
begin
  Result := Base.X + Base.Y + P.X + P.Y;
end;

procedure TBox.Note(const P: TPoint);
begin
  WriteLn('box ', Base.X, ' ', P.X, ' ', P.Y);
end;

var
  p: TPoint;
  b: TBox;
  arr: array of TPoint;
begin
  { Through a variable, which always worked. }
  p := Make(3);
  WriteLn(Sum(p));

  { Straight from the function that made it, which did not. }
  WriteLn(Sum(Make(3)));

  { Two deep, and with other arguments beside it. }
  WriteLn(Sum(Moved(Make(3), 10, 20)));
  WriteLn(Sum(Moved(Moved(Make(1), 1, 1), 1, 1)));

  { A record bigger than two words, with a string inside it. }
  WriteLn(Tell(Big('big')));

  { A method takes one the same way. }
  b := TBox.Create;
  b.Base := Make(5);
  WriteLn(b.Plus(Make(2)), ' ', b.Plus(b.Base));

  { The same thing as a statement, which is another path through the
    emitter and had the same hole in it. }
  b.Note(Make(6));
  Note(Make(7));

  { An element of an array and a field still travel by address. }
  SetLength(arr, 2);
  arr[0] := Make(4);
  arr[1] := Moved(arr[0], 1, 1);
  WriteLn(Sum(arr[0]), ' ', Sum(arr[1]), ' ', Sum(b.Base));
end.

