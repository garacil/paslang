end;

begin
  WriteLn('Byte ', RegByte(6), ' ', HomeByte(6));
  WriteLn('Word ', RegWord(6), ' ', HomeWord(6));
  WriteLn('UInt32 ', RegUInt32(6), ' ', HomeUInt32(6));
  WriteLn('Int8 ', RegInt8(8), ' ', HomeInt8(8));
  WriteLn('Int16 ', RegInt16(8), ' ', HomeInt16(8));
  WriteLn('Int32 ', RegInt32(8), ' ', HomeInt32(8));
  WriteLn('Integer ', RegInteger(8), ' ', HomeInteger(8));
  WriteLn($12345678 and $FF, ' ', $12345678 and $FFFF, ' ', -2 and $FFFFFFFF);
end.
