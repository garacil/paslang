function ValInteger(i: Integer): Integer;
begin
  case i of
    0: Result := Low(Integer);
    1: Result := -9223372036854775807;
    2: Result := 9223372036854775806;
    3: Result := High(Integer);
    4: Result := 0;
    5: Result := 1;
    6: Result := -1;
    7: Result := -2;
  else
    Result := 0;
  end;
end;

{ in registers: the loop calls nothing but Val's leaf, inlined }
function RegInteger(n: Integer): Integer;
