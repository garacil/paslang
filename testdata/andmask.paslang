{ P320: an and with $FF, $FFFF or $FFFFFFFF is a zero extension from
  its source: of a variable a loop keeps in a register, of one at its
  home (a global, and a local of a routine that calls), and of an
  expression, for every integer type at its edges, each widened to
  Integer first: a narrow variable and a constant work in its type. scripts/check_andmask.py
  reads that the routines write no AND of those masks. Written by a
  script; the answers are Python's. }
program andmask;

var
  gByte: Byte;
  gWord: Word;
  gUInt32: UInt32;
  gInt8: Int8;
  gInt16: Int16;
  gInt32: Int32;
  gInteger: Integer;

procedure Touch(x: Integer);
begin
  if x = 12345 then
    WriteLn('touch');
end;

function ValByte(i: Integer): Byte;
begin
  case i of
    0: Result := 0;
    1: Result := 1;
    2: Result := 254;
    3: Result := 255;
    4: Result := 0;
    5: Result := 1;
  else
    Result := 0;
  end;
end;

{ in registers: the loop calls nothing but Val's leaf, inlined }
function RegByte(n: Integer): Integer;
var
  i, s: Integer;
  v: Byte;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    v := ValByte(i);
    s := s * 3 + (Integer(v) and $FF) + (Integer(v) and $FFFF) * 5 + (Integer(v) and $FFFFFFFF) * 7;
    s := s xor ((Integer(v) + 1) and $FF) + ((Integer(v) * 3) and $FFFF);
  end;
  Result := s;
end;

{ at home: a local of a routine that calls, and a global }
function HomeByte(n: Integer): Integer;
var
  i, s: Integer;
  v: Byte;
begin
  s := 0;
  for i := 0 to n - 1 do
  begin
    v := ValByte(i);
    gByte := v;
    Touch(i);
    s := s * 3 + (Integer(v) and $FF) + (Integer(v) and $FFFF) * 5 + (Integer(v) and $FFFFFFFF) * 7;
    s := s xor (Integer(gByte) and $FF) + (Integer(gByte) and $FFFF) - (Integer(gByte) and $FFFFFFFF);
  end;
  Result := s;
end;

