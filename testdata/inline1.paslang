{ P112: inline by measure. Small routines of this program are put in
  place where they are called: procedures and functions, value, const
  and var parameters, locals that start at zero at every call, a for
  inside, a call inside a loop, Break inside its own loop, a routine
  that calls another small one, and the ones that stay calls (Exit
  inside, recursion, a string parameter, one declared too big). The
  output is the same with -inline 0, and make check compares the two
  and looks at the .s for the calls that must be gone and the ones
  that must stay. }
program inline1;

var
  total, i, x, y: Integer;
  arr: array[0..9] of Integer;

function Sq(N: Integer): Integer;
begin
  Result := N * N;
end;

function Clamp(const V, Lo, Hi: Integer): Integer;
begin
  Result := V;
  if Result < Lo then
    Result := Lo;
  if Result > Hi then
    Result := Hi;
end;

procedure Swap(var A, B: Integer);
var
  t: Integer;
begin
  t := A;
  A := B;
  B := t;
end;

function SumTo(N: Integer): Integer;
var
  k: Integer;
begin
  Result := 0;
  for k := 1 to N do
    Result := Result + k;
end;

function FirstOver(Limit: Integer): Integer;
var
  k, acc: Integer;
begin
  acc := 0;
  Result := -1;
  for k := 0 to 9 do
  begin
    acc := acc + arr[k];
    if acc > Limit then
    begin
      Result := k;
      Break;
    end;
  end;
end;

function Twice(N: Integer): Integer;
begin
  Result := Sq(N) + Sq(N);            { a small routine inside a small one }
end;

function Count(N: Integer): Integer;  { stays a call: Exit inside }
begin
  Result := 0;
  if N < 0 then
    Exit;
  Result := N;
end;

function Fact(N: Integer): Integer;   { stays a call: itself inside }
begin
  if N <= 1 then
    Result := 1
  else
    Result := N * Fact(N - 1);
end;

function Len2(const S: string): Integer;   { stays a call: a string parameter }
begin
  Result := Length(S) * 2;
end;

function Big(N: Integer): Integer;    { stays a call: too big for -inline 40 }
begin
  Result := N;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
end;

function Huge(N: Integer): Integer; inline;   { goes in whatever its size }
begin
  Result := N;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
  Result := Result * 3 + 1;
end;

procedure Tally(N: Integer);
begin
  total := total + N;
end;

begin
  for i := 0 to 9 do
    arr[i] := i * 3;
  total := 0;
  for i := 1 to 5 do
  begin
    Tally(Sq(i));
    x := Clamp(i * 4, 3, 15);
    y := SumTo(i);
    Tally(x + y);
  end;
  WriteLn(total);                                    { 55 + (4+1)+(8+3)+(12+6)+(15+10)+(15+15) = 144 }
  x := 1;
  y := 2;
  Swap(x, y);
  Swap(arr[3], arr[7]);
  WriteLn(x, ' ', y, ' ', arr[3], ' ', arr[7]);      { 2 1 21 9 }
  WriteLn(FirstOver(20), ' ', FirstOver(1000), ' ', Twice(6));   { 3 -1 72: arr[3] is 21 after the swap }
  y := Huge(1);
  WriteLn(Count(-3), ' ', Count(7), ' ', Fact(5), ' ', Len2('abc'), ' ', Big(1), ' ', y);
  x := 0;
  for i := 1 to 3 do
    x := x + SumTo(i) + FirstOver(i * 10);
  WriteLn(x);                                        { 1+3 + 3+3 + 6+4 = 20 }
end.

