program funcval2;

{ Routine values are 16 bytes from 1.0.133 (P109): the code and an
  environment, nil for a plain routine. They go through records, arrays,
  channels, parameters and results whole; a method value passes a
  string, a record and a slice as every other call does (amd64 passed
  the string's first word alone). }

uses paslib;

type
  TPt = record
    X, Y: Integer;
  end;
  TInts = array of Integer;
  TOp = function(A, B: Integer): Integer;
  TNote = procedure(const S: string; P: TPt; const D: TInts) of object;
  THold = record
    Name: string;
    Op: TOp;
  end;
  TLog = class
    Tag: string;
    procedure Note(const S: string; P: TPt; const D: TInts);
  end;

procedure TLog.Note(const S: string; P: TPt; const D: TInts);
begin
  WriteLn(Tag, ' ', S, ' ', Length(S), ' ', P.X + P.Y, ' ', Length(D), ' ', D[High(D)]);
end;

function Add(A, B: Integer): Integer;
begin
  Result := A + B;
end;

function Mul(A, B: Integer): Integer;
begin
  Result := A * B;
end;

function Pick(Big: Boolean): TOp;
begin
  if Big then
    Result := @Mul
  else
    Result := @Add;
end;

function Fold(const D: TInts; F: TOp; Start: Integer): Integer;
var
  i: Integer;
begin
  Result := Start;
  for i := 0 to High(D) do
    Result := F(Result, D[i]);
end;

var
  ops: array[0..1] of TOp;
  h: THold;
  f, g: TOp;
  c: chan of TOp;
  l: TLog;
  n: TNote;
  p: TPt;
  d: TInts;

begin
  ops[0] := @Add;
  ops[1] := @Mul;
  WriteLn(ops[0](3, 4), ' ', ops[1](3, 4), ' ', SizeOf(f));
  h.Name := 'mul';
  h.Op := ops[1];
  WriteLn(h.Name, ' ', h.Op(6, 7));
  f := Pick(True);
  g := Pick(False);
  WriteLn(f(5, 5), ' ', g(5, 5), ' ', Pick(True)(2, 21));
  d := [1, 2, 3, 4];
  WriteLn(Fold(d, @Add, 0), ' ', Fold(d, @Mul, 1));
  f := nil;
  WriteLn(f = nil, ' ', g <> nil, ' ', Assigned(g));
  c := MakeChan(2);
  Send(c, @Mul);
  Send(c, @Add);
  f := Recv(c);
  g := Recv(c);
  WriteLn(f(9, 9), ' ', g(9, 9));
  l := TLog.Create;
  l.Tag := 'log';
  n := l.Note;
  p.X := 40;
  p.Y := 2;
  n('hello', p, d);
  n('a' + 'bc', p, Append(d, 99));
end.

