{ A write to a peer that went away fails and the program goes on
  (1.1.1): the kernel raised SIGPIPE on such a write and the signal
  ended the whole program, so one client that closed while a server
  wrote to it took the server down. Socket writes now ask for no
  signal and get EPIPE back, as Go's net does. }
program sigpipe;

uses pasnet;

var
  l, c, s, i, failed: Integer;
  data: string;
begin
  l := TcpListen(0);
  c := TcpConnectTo('127.0.0.1', TcpPort(l));
  s := TcpAccept(l);
  TcpClose(c);                          { the peer goes away }
  data := 'x';
  for i := 1 to 16 do
    data := data + data;                { 64 KB }
  failed := 0;
  for i := 1 to 200 do
    if TcpWrite(s, data) < 0 then
    begin
      failed := i;
      Break;
    end;
  if failed > 0 then
    WriteLn('a write to a closed peer fails and the program goes on')
  else
    WriteLn('every write went through');
  TcpClose(s);
  TcpClose(l);
  WriteLn('done');
end.
