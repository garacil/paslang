program ifaceargs;

{ An interface's call takes its arguments by the rules of every other
  call (1.0.135): a string, a record, a slice, a Double, a Byte and more
  than five of them; a function's answer of each kind in an expression.
  function ... of object with its signature: through a variable, a
  field, @obj.F of a function with no parameters. }

uses paslib;

type
  TPt = record
    X, Y: Integer;
    Tag: string;
  end;
  TInts = array of Integer;
  IWork = interface
    procedure Say(S: string; N: Integer);
    function Glue(A: string; P: TPt; V: TInts; D: Double; B: Byte): string;
    function Many(A, B, C, D, E, F, G: Integer; S: string): Integer;
    function Pt(K: Integer): TPt;
    function Half(D: Double): Double;
  end;
  TWork = class(IWork)
    Id: Integer;
    procedure Say(S: string; N: Integer);
    function Glue(A: string; P: TPt; V: TInts; D: Double; B: Byte): string;
    function Many(A, B, C, D, E, F, G: Integer; S: string): Integer;
    function Pt(K: Integer): TPt;
    function Half(D: Double): Double;
  end;
  TJoin = function(A: string; P: TPt; V: TInts; D: Double; B: Byte): string of object;
  TGet = function: Integer of object;
  THalf = function(D: Double): Double of object;
  TBox = class
    Id: Integer;
    OnJoin: TJoin;
    function GetId: Integer;
  end;

function TBox.GetId: Integer;
begin
  Result := Id * 3;
end;

procedure TWork.Say(S: string; N: Integer);
begin
  WriteLn(S, N + Id);
end;

function TWork.Glue(A: string; P: TPt; V: TInts; D: Double; B: Byte): string;
begin
  Result := A + IntToStr(P.X + P.Y) + P.Tag + IntToStr(Length(V)) +
    IntToStr(V[High(V)]) + IntToStr(Trunc(D * 10)) + IntToStr(B + Id);
end;

function TWork.Many(A, B, C, D, E, F, G: Integer; S: string): Integer;
begin
  Result := A + B * 2 + C * 3 + D * 4 + E * 5 + F * 6 + G * 7 + Length(S) * 1000;
end;

function TWork.Pt(K: Integer): TPt;
begin
  Result.X := K;
  Result.Y := K * 2;
  Result.Tag := 'pt' + IntToStr(Id);
end;

function TWork.Half(D: Double): Double;
begin
  Result := D / 2;
end;

var
  w: TWork;
  i: IWork;
  p: TPt;
  v: TInts;
  j: TJoin;
  g: TGet;
  h: THalf;
  b: TBox;

begin
  w := TWork.Create;
  w.Id := 1;
  i := w;
  i.Say('say ', 4);
  p.X := 2;
  p.Y := 3;
  p.Tag := 't';
  v := [7, 8, 9];
  WriteLn(i.Glue('join ', p, v, 1.5, 254));
  WriteLn('many ', i.Many(1, 1, 1, 1, 1, 1, 1, 'abc'));
  p := i.Pt(5);
  WriteLn('pt ', p.X, ' ', p.Y, ' ', p.Tag, ' ', i.Pt(6).Y);
  WriteLn('half ', Trunc(i.Half(9.0) * 100));
  WriteLn('join2 ', Length(i.Glue('ab', p, v, 0.0, 0)));
  j := w.Glue;
  WriteLn(j('of object ', p, v, 2.5, 3));
  b := TBox.Create;
  b.Id := 7;
  g := @b.GetId;
  WriteLn('get ', g() + 1);
  b.OnJoin := w.Glue;
  WriteLn(b.OnJoin('field ', p, v, 0.1, 9));
  h := w.Half;
  WriteLn('half value ', Trunc(h(h(10.0)) * 100));
end.

