{ P365: nor the value a property's getter gives. }
program getterfield;
type
  TPair = record
    A, B: Integer;
  end;
  TShape = class
    function GetCorner: TPair;
    property Corner: TPair read GetCorner;
  end;
function TShape.GetCorner: TPair;
begin
  Result.A := 1;
end;
var
  sh: TShape;
begin
  sh := TShape.Create;
  sh.Corner.B := 5;
end.
