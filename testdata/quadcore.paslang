program quadcore;

{ The binary128 core unit pasquad (P103) against GCC's __float128: 18
  cases at the edges (ties to even, overflow, the smallest subnormal
  halved, -2^63 and 2^63 into an Integer, exact cancellation, invalid
  operations, NaN operands) and 500 drawn by splitmix64 over every
  exponent, each through add, sub, mul, div, sqrt of |a|, compare, the
  four roundings to Integer, Int, to Double, to Single, from Double and
  from Integer. The .out is what the same program in C with __float128
  printed (docs/QUAD.md); a NaN prints as nan, its payload aside. }

uses pasquad;

const
  SignBit = -9223372036854775807 - 1;

var
  st: Int64;
  specLo, specHi: array[0..11] of Int64;

function NextR: Int64;
var
  z: Int64;
begin
  st := st + (-7046029254386353131);
  z := st;
  z := (z xor (z shr 30)) * (-4658895280553007687);
  z := (z xor (z shr 27)) * (-7723592293110705685);
  Result := z xor (z shr 31);
end;

{ X mod M with X read as an unsigned 64-bit number. }
function UMod(X, M: Int64): Int64;
begin
  if X >= 0 then
    Result := X mod M
  else
    Result := (2 * ((X shr 1) mod M) + (X and 1)) mod M;
end;

function Hex64(X: Int64): string;
var
  i, d: Int64;
  s: string;
begin
  s := '';
  for i := 15 downto 0 do
  begin
    d := (X shr (i * 4)) and 15;
    if d < 10 then
      s := s + Chr(48 + d)
    else
      s := s + Chr(87 + d);
  end;
  Result := s;
end;

procedure PQ(Lo, Hi: Int64);
begin
  if (((Hi shr 48) and 32767) = 32767) and (((Hi and 281474976710655) <> 0) or (Lo <> 0)) then
    Write(' nan')
  else
    Write(' ', Hex64(Hi), Hex64(Lo));
end;

procedure Gen(out Lo, Hi: Int64);
var
  r1, r2, r3, cat, sign, e: Int64;
begin
  r1 := NextR;
  r2 := NextR;
  r3 := NextR;
  cat := r1 and 15;
  sign := (r1 shr 8) and 1;
  if cat = 0 then
  begin
    Lo := specLo[UMod(r2, 12)];
    Hi := specHi[UMod(r2, 12)];
    Exit;
  end;
  if cat <= 2 then
    e := 16383 - 64 + UMod(r1 shr 16, 129)
  else if cat = 3 then
    e := 0
  else if cat = 4 then
    e := 32760 + UMod(r1 shr 16, 7)
  else if cat = 5 then
    e := 1 + UMod(r1 shr 16, 10)
  else if cat = 6 then
  begin
    PasQFromInt(r2 shr UMod(r1 shr 16, 64), Lo, Hi);
    if sign = 1 then
      Hi := Hi xor SignBit;
    Exit;
  end
  else
    e := 1 + UMod(r1 shr 16, 32766);
  Lo := r3;
  Hi := (sign shl 63) or (e shl 48) or (r2 and 281474976710655);
end;

procedure ToIntOut(Lo, Hi, Mode: Int64);
var
  ok: Boolean;
  v: Int64;
begin
  v := PasQToInt(Lo, Hi, Mode, ok);
  if ok then
    Write(' ', v)
  else
    Write(' bad');
end;

procedure DoCase(const Lab: string; alo, ahi, blo, bhi, k, db: Int64);
var
  m, rlo, rhi, x, slo, shi: Int64;
begin
  Write(Lab);
  PasQAdd(alo, ahi, blo, bhi, rlo, rhi);
  PQ(rlo, rhi);
  PasQSub(alo, ahi, blo, bhi, rlo, rhi);
  PQ(rlo, rhi);
  PasQMul(alo, ahi, blo, bhi, rlo, rhi);
  PQ(rlo, rhi);
  PasQDiv(alo, ahi, blo, bhi, rlo, rhi);
  PQ(rlo, rhi);
  slo := alo;
  shi := ahi;
  if PasQCmp(alo, ahi, 0, 0) = -1 then
    shi := shi xor SignBit;
  PasQSqrt(slo, shi, rlo, rhi);
  PQ(rlo, rhi);
  Write(' ', PasQCmp(alo, ahi, blo, bhi));
  for m := 0 to 3 do
    ToIntOut(alo, ahi, m);
  PasQInt(alo, ahi, rlo, rhi);
  PQ(rlo, rhi);
  x := PasQToDouble(alo, ahi);
  if (((x shr 52) and 2047) = 2047) and ((x and 4503599627370495) <> 0) then
    Write(' nan')
  else
    Write(' ', Hex64(x));
  x := PasQToSingle(alo, ahi);
  if (((x shr 23) and 255) = 255) and ((x and 8388607) <> 0) then
    Write(' nan')
  else
    Write(' ', Copy(Hex64(x), 9, 8));
  PasQFromDouble(db, rlo, rhi);
  PQ(rlo, rhi);
  PasQFromInt(k, rlo, rhi);
  PQ(rlo, rhi);
  WriteLn;
end;

const
  edges: array[0..71] of Int64 = (
    0, 4611404543450677248, 0, 4579597871082373120,
    1, 4611404543450677248, 0, 4579597871082373120,
    0, 4611404543450677248, 0, 4579738608570728448,
    -1, 9223090561878065151, -1, 9223090561878065151,
    1, 0, 0, 4611686018427387904,
    3, 0, 0, 4611686018427387904,
    0, 281474976710656, 1, 4611404543450677248,
    0, 4629137466983448576, 0, 4611404543450677248,
    0, -4594234569871327232, 0, 4611404543450677248,
    0, 4611756387171565568, 0, -4611615649683210240,
    0, 4611897124659920896, 0, 4611897124659920896,
    0, 4611967493404098560, 0, 4611826755915743232,
    0, 4611404543450677248, 0, 4611826755915743232,
    0, 9223090561878065152, 0, 9223090561878065152,
    0, 0, 0, -281474976710656,
    5, 9223160930622242816, 0, 4611404543450677248,
    0, SignBit, 0, 0,
    291, 4611123068473966592, 1110, -4612248968380809216);

var
  n, i, alo, ahi, blo, bhi, de, ea, kr, k, db, x: Int64;

begin
  specLo[0] := 0; specHi[0] := 0;
  specLo[1] := 0; specHi[1] := SignBit;
  specLo[2] := 0; specHi[2] := 9223090561878065152;
  specLo[3] := 0; specHi[3] := -281474976710656;
  specLo[4] := 0; specHi[4] := 9223231299366420480;
  specLo[5] := -1; specHi[5] := 9223090561878065151;
  specLo[6] := 0; specHi[6] := 281474976710656;
  specLo[7] := 1; specHi[7] := 0;
  specLo[8] := 0; specHi[8] := 4611404543450677248;
  specLo[9] := 0; specHi[9] := -4611967493404098560;
  specLo[10] := -1; specHi[10] := 281474976710655;
  specLo[11] := 0; specHi[11] := 4611686018427387904;
  n := 500;
  for i := 0 to 17 do
    DoCase('e' + PasFmtInt(i, 0), edges[4 * i], edges[4 * i + 1], edges[4 * i + 2], edges[4 * i + 3],
      -7, 4607182418800017408);
  st := 12345;
  for i := 0 to n - 1 do
  begin
    Gen(alo, ahi);
    Gen(blo, bhi);
    if (NextR and 3) = 0 then
    begin
      blo := alo;
      bhi := ahi;
      x := NextR;
      blo := blo xor (x shr UMod(NextR, 64));
      de := UMod(NextR, 3);
      ea := (ahi shr 48) and 32767;
      if (ea > 3) and (ea < 32760) then
        bhi := (bhi and (not (Int64(32767) shl 48))) or ((ea - de) shl 48);
      if (NextR and 1) = 1 then
        bhi := bhi xor SignBit;
    end;
    kr := NextR;
    k := NextR shr (kr and 63);
    if (kr and 64) <> 0 then
      k := -k;
    db := NextR;
    if ((kr shr 8) and 3) = 0 then
    begin
      if UMod(kr shr 16, 3) = 0 then
        db := db and (-9218868437227405313)
      else
        db := (db and (-9218868437227405313)) or 9218868437227405312;
    end;
    DoCase(PasFmtInt(i, 0), alo, ahi, blo, bhi, k, db);
  end;
end.
