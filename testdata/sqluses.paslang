{ P403: SQLite named in a uses clause, the library unit sqlite (P418):
  a database in memory, a file that is not there opened read-only, the
  words of SQLite's result codes, a record built by hand and read back,
  a value as quote() writes it. }
program sqluses;

uses sqlite;

var
  db: TSqlite;
  v: TSqliteValues;
  rec: string;
  i: Integer;

begin
  db := TSqlite.Open(':memory:');
  WriteLn('memory ', db.PageCount, ' ', Length(db.Schema));
  db.Free;
  try
    db := TSqlite.Open('/nonexistent-dir/x.db', SQLITE_OPEN_READONLY);
    WriteLn('opened?');
  except
    on E: ESqliteError do
      WriteLn('cantopen ', E.Code, ' ', E.Message);
  end;
  for i := 0 to 28 do
    if SqliteErrStr(i) <> 'unknown error' then
      WriteLn(i, ' ', SqliteErrStr(i));
  WriteLn(100, ' ', SqliteErrStr(SQLITE_ROW));
  WriteLn(101, ' ', SqliteErrStr(SQLITE_DONE));
  WriteLn(516, ' ', SqliteErrStr(SQLITE_ABORT_ROLLBACK));
  { a record: header of 7 bytes (its size, then the serial types 1, 7,
    23 = a text of 5, 14 = a blob of 1, 0, 9), then the bodies }
  rec := #7#1#7#23#14#0#9#254#64#9#33#251#84#68#45#24 + 'hello' + #171;
  v := SqliteRecord(rec, SQLITE_UTF8);
  for i := 0 to High(v) do
    WriteLn(v[i].Kind, ' ', SqliteQuote(v[i]));
  WriteLn(v[1].R:0:15);
end.
