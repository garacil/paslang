program dwarfreal;

{ The debug information types a real local (P101): gdb reads a Single as
  4 bytes of binary32 and a Double as 8 of binary64. }

procedure Show;
var
  s: Single;
  d: Double;
  r: Real;
begin
  s := 0.1;
  d := 0.1;
  r := -2.5;
  s := s * 3;
  WriteLn(s:0:9, ' ', d:0:17, ' ', r:0:1);
end;

begin
  Show;
end.
