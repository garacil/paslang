program sysbuilder;
uses sysutils;
const Workers = 128;
var joined: waitgroup; i: Integer;

procedure Build(Index: Integer);
var builder: TStringBuilder; before, snapshot, expected: string;
  settings: TFormatSettings; k, capacityValue: Integer;
begin
  settings := DefaultFormatSettings;
  if Odd(Index) then settings.DecimalSeparator := ',';
  builder := TStringBuilder.Create(0);
  try
    if (builder.ByteLength <> 0) or (builder.Capacity <> 0) then Halt(2);
    for k := 1 to 256 do builder.AddText('ñ雪');
    expected := '';
    for k := 1 to 256 do expected := expected + 'ñ雪';
    if builder.ToString <> expected then Halt(3);
    if builder.ByteLength <> Length(expected) then Halt(4);
    snapshot := builder.ToString;
    builder.InsertText(0, 'prefix').InsertText(builder.ByteLength, 'tail');
    if builder.ToString <> 'prefix' + expected + 'tail' then Halt(5);
    builder.Remove(0, 6).Remove(builder.ByteLength - 4, 4);
    if builder.ToString <> expected then Halt(6);
    if snapshot <> expected then Halt(7);
    before := builder.ToString;
    try builder.Remove(High(Integer), 2); Halt(8)
    except on EArgumentOutOfRangeException do ; end;
    try builder.Remove(0, High(Integer)); Halt(9)
    except on EArgumentOutOfRangeException do ; end;
    try builder.InsertText(-1, 'bad'); Halt(10)
    except on EArgumentOutOfRangeException do ; end;
    try capacityValue := builder.EnsureCapacity(-1); Halt(11)
    except on EArgumentOutOfRangeException do ; end;
    if builder.ToString <> before then Halt(12);
    capacityValue := builder.Capacity;
    builder.Reset;
    if (builder.ByteLength <> 0) or (builder.Capacity <> capacityValue) then Halt(13);
    builder.AddInteger(Low(Integer)).AddChar(' ').AddBoolean(True).AddChar(' ');
    builder.AddReal(1.25, settings).AddLine;
    builder.AddFormat('%d:%s', [Index, 'λ'], settings);
    if Odd(Index) then expected := '-9223372036854775808 True 1,25'#10
    else expected := '-9223372036854775808 True 1.25'#10;
    expected := expected + IntToStr(Index) + ':λ';
    if builder.ToString <> expected then Halt(14);
    GcCollect;
    if builder.ToString <> expected then Halt(15);
    if snapshot <> before then Halt(16);
  finally builder.Free; end;
  joined.Done;
end;

begin
  joined.Add(Workers);
  for i := 0 to Workers - 1 do pas Build(i);
  joined.Wait;
  WriteLn('owned builders ', Workers, ', snapshots, checked byte edits, independent settings');
end.
