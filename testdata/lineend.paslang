{ P339: SrcLine is the line where it is written, in a statement whose
  first word ends its line too: 15 in the WriteLn of line 14, 17 and 18
  in the WriteLn of line 16, and 20 in the Inc of line 19. The lines are
  counted by hand. testdata/linebad holds refusals at a number, a string
  and a word that end their lines, testdata/fatal/divfirst a division
  by zero in a statement whose first word ends its line. }
program lineend;

var
  k: Integer;

begin
  k := 0;
  WriteLn(
    SrcLine);
  WriteLn
    (SrcLine, ' ',
     SrcLine);
  Inc
  (k, SrcLine);
  WriteLn(k);
end.

