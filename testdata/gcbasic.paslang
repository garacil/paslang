{ P95b: the collector. What is reachable survives any number of cycles
  (a list, a class, a map, a dynamic array of records, a large block, a
  pointer held only by a record after a char array, only by a routine's
  argument, only by a routine's stack), what is not is taken back: the
  heap stays a few MiB while the program allocates hundreds, and the
  heap's own check finds nothing wrong. Routines allocate on every P at
  once while cycles stop them. The numbers printed do not depend on how
  the routines were spread over the Ms. }
program gcbasic;

uses
  paslib;

type
  PNode = ^TNode;
  TNode = record
    Name: string;
    V: Integer;
    Next: PNode;
  end;
  TBox = class
    Title: string;
    Items: array of Integer;
  end;
  TPair = record
    L, R: string;
  end;
  TTagged = record
    Tag: array[0..9] of Char;
    P: PNode;
    C: Char;
    S: string;
  end;

var
  keep, p, q: PNode;
  box: TBox;
  m: map[Integer] of string;
  pairs: array of TPair;
  big: PNode;
  bigraw: Pointer;
  tg: TTagged;
  i, j, bad, n0, r: Integer;
  s: string;
  wg: waitgroup;
  errs: Integer;

procedure Churn(Seed: Integer; Own: PNode);
var
  k, bad2: Integer;
  mine: array of string;
  x: PNode;
  t: string;
begin
  SetLength(mine, 300);
  for k := 0 to 299 do
    mine[k] := 'r' + IntToStr(Seed) + '-' + IntToStr(k);
  bad2 := 0;
  for k := 1 to 30000 do
  begin
    New(x);
    x^.Name := IntToStr(k);
    t := x^.Name + '.';
  end;
  bad2 := 0;
  for k := 0 to 299 do
    if mine[k] <> 'r' + IntToStr(Seed) + '-' + IntToStr(k) then
      bad2 := bad2 + 1;
  if Own^.Name <> 'own' + IntToStr(Seed) then
    bad2 := bad2 + 1;
  AtomicAdd(@errs, bad2);
  wg.Done;
end;

function Sum(L: PNode): Integer;
begin
  Result := 0;
  while L <> nil do
  begin
    Result := Result + L^.V;
    L := L^.Next;
  end;
end;

begin
  keep := nil;
  for i := 1 to 1000 do
  begin
    New(p);
    p^.Name := 'keep' + IntToStr(i);
    p^.V := i;
    p^.Next := keep;
    keep := p;
  end;
  box := TBox.Create;
  box.Title := 'box';
  SetLength(box.Items, 5000);
  for i := 0 to 4999 do
    box.Items[i] := i * 3;
  New(m);
  for i := 1 to 2000 do
    m[i] := 'm' + IntToStr(i);
  SetLength(pairs, 500);
  for i := 0 to 499 do
  begin
    pairs[i].L := 'l' + IntToStr(i);
    pairs[i].R := 'r' + IntToStr(i);
  end;
  GetMem(bigraw, 200000);
  New(big);
  big^.Name := 'big';
  PNode(bigraw)^.Next := big;
  big := nil;
  New(tg.P);
  tg.P^.Name := 'tagged';
  tg.S := 'tail' + IntToStr(7);
  { garbage of every size: small nodes, strings, blocks with and
    without pointers, large blocks }
  for i := 1 to 200000 do
  begin
    New(q);
    q^.Name := 'garbage' + IntToStr(i);
    s := q^.Name + '!';
    if i mod 100 = 0 then
      GetMem(bigraw, 50000 + i mod 7 * 1000, 0);
    if i mod 50 = 0 then
      SetLength(pairs[i mod 500].L, 0);
  end;
  for i := 0 to 499 do
    if i mod 50 <> 0 then
      if pairs[i].L <> 'l' + IntToStr(i) then
        bad := bad + 1;
  { routines, each with a node only its argument holds }
  errs := 0;
  wg.Add(8);
  for i := 1 to 8 do
  begin
    New(p);
    p^.Name := 'own' + IntToStr(i);
    pas Churn(i, p);
  end;
  p := nil;
  wg.Wait;
  n0 := HeapStat(0);
  r := GcCollect;
  bad := 0;
  j := 0;
  p := keep;
  while p <> nil do
  begin
    if p^.Name <> 'keep' + IntToStr(p^.V) then
      bad := bad + 1;
    j := j + 1;
    p := p^.Next;
  end;
  for i := 0 to 4999 do
    if box.Items[i] <> i * 3 then
      bad := bad + 1;
  for i := 1 to 2000 do
    if m[i] <> 'm' + IntToStr(i) then
      bad := bad + 1;
  WriteLn('list ', j, ' sum ', Sum(keep), ' bad ', bad);
  WriteLn('box ', box.Title, ' map ', Length(m), ' routines ', errs);
  WriteLn('tagged ', tg.P^.Name, ' ', tg.S);
  WriteLn('collected ', r, ' cycles ', HeapStat(0) > n0, ' ', n0 > 2);
  WriteLn('alive under 4 MiB ', HeapStat(1) < 4194304, ' mapped under 64 MiB ', HeapStat(3) < 67108864);
  WriteLn('check ', HeapCheck);
end.

