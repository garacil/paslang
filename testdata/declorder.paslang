program declorder;

{ A routine's sections and nested routines in any order, as in FPC
  (1.0.116): a var, a const or a type after a nested routine was a
  syntax error. A nested routine sees what is declared before it; one
  declared later sees more. }

function Walk(n: Integer): Integer;
var
  total: Integer;

  procedure Add(k: Integer);
  begin
    total := total + k;
  end;

const
  Step = 3;
type
  TPair = record A, B: Integer end;
var
  p: TPair;
  s: string;

  procedure Note(const t: string);
  begin
    s := s + t;
    p.A := p.A + 1;
    total := total + Step;
  end;

var
  i: Integer;
begin
  total := 0;
  s := '';
  for i := 1 to n do
  begin
    Add(i);
    Note(Chr(Ord('a') + i - 1));
  end;
  p.B := total;
  WriteLn(s, ' ', p.A, ' ', p.B);
  Result := total;
end;

begin
  WriteLn(Walk(4));
end.
