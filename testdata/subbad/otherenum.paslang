program otherenum;
type
  TColor = (Red, Green, Blue);
  TDay = (Mon, Tue, Wed, Thu, Fri, Sat, Sun);
  TWork = Mon..Fri;
var
  ws: set of TWork;
begin
  ws := [Tue, Red];
end.

