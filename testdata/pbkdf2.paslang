program pbkdf2;

procedure Vector(Alg, Stage: Integer; const Password, Salt: string;
  Iterations: Integer; const Expected: string);
var D: string;
begin
  if Alg = 1 then D := Pbkdf2HmacSha1(Password, Salt, Iterations, Length(Expected) div 2)
  else D := Pbkdf2HmacSha256(Password, Salt, Iterations, Length(Expected) div 2);
  if Hex(D) <> Expected then begin WriteLn('PBKDF2 vector ', Stage); Halt(119); end;
end;

begin
  Vector(1, 1, 'password', 'salt', 1,
    '0c60c80f961f0e71f3a9b524af6012062fe037a6');
  Vector(1, 2, 'password', 'salt', 2,
    'ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957');
  Vector(1, 3, 'password', 'salt', 4096,
    '4b007901b765489abead49d926f721d065a429c1');
  Vector(1, 5, 'passwordPASSWORDpassword', 'saltSALTsaltSALTsaltSALTsaltSALTsalt', 4096,
    '3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038');
  Vector(1, 6, 'pass'#0'word', 'sa'#0'lt', 4096,
    '56fa6aa75548099dcc37d7f03425e0c3');
  Vector(256, 7, 'passwd', 'salt', 1,
    '55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783');
  Vector(256, 8, 'Password', 'NaCl', 80000,
    '4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d');
  WriteLn('ok PBKDF2 RFC vectors');
end.

