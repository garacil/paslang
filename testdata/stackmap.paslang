{ P95c: the stack maps. Each case keeps a block alive only where a map
  must say so while Churn allocates enough for cycles to run under
  PASLANG_GCSTRESS: a pushed temporary, a computed argument in a scratch
  slot, a map's key, the Self of a method called on a temporary, the
  outer locals a nested routine reaches through its static link, a
  record passed by value, a string held across a try block, and the
  copy of a map's directory that only a for loop's iterator holds.
  make check runs it with PASLANG_GCVERIFY=1, which poisons whatever a
  map leaves out, so a missing pointer changes the output. }
program stackmap;

uses
  paslib;

type
  TRec = record
    A: string;
    N: Integer;
    B: string;
  end;

  TBox = class
    FS: string;
    procedure SetS(V: string);
    function GetS: string;
    function Say(const X: string): string;
    property S: string read GetS write SetS;
  end;

var
  total: Integer;

function Churn(N: Integer): string;
var
  i: Integer;
  t: string;
begin
  t := '';
  for i := 1 to N do
    t := IntToStr(i) + t;
  Result := Copy(t, 1, 2);
end;

function Mk(const P: string; N: Integer): string;
begin
  Result := P + IntToStr(N) + P;
end;

function Two(const A, B: string): string;
begin
  Result := A + '|' + B;
end;

procedure TBox.SetS(V: string);
begin
  FS := V;
end;

function TBox.GetS: string;
begin
  Result := FS;
end;

function TBox.Say(const X: string): string;
begin
  Result := FS + ':' + X;
end;

function NewBox(const S: string): TBox;
begin
  Result := TBox.Create;
  Result.FS := S;
end;

function RecSum(R: TRec; const X: string): string;
begin
  Result := R.A + X + R.B + IntToStr(R.N);
end;

function Deep(N: Integer): string;
var
  s: string;
begin
  s := Mk('d', N);
  if N = 0 then
    Result := s + Churn(3)
  else
    Result := s + Deep(N - 1) + Churn(2);
end;

procedure Nested;
var
  outer, got: string;
  k: Integer;

  procedure Inner(N: Integer);
  begin
    got := got + outer + Churn(N);
  end;

begin
  outer := Mk('o', 7);
  got := '';
  for k := 1 to 20 do
    Inner(k);
  WriteLn('nested ', Length(got), ' ', Copy(got, 1, 7));
end;

procedure Check(const Name, S: string);
var
  i, h: Integer;
begin
  h := 0;
  for i := 1 to Length(S) do
    h := (h * 31 + Ord(S[i])) mod 1000003;
  total := total + h;
  WriteLn(Name, ' ', Length(S), ' ', h);
end;

var
  s, t: string;
  i, n: Integer;
  m: map[string] of string;
  big: map[Integer] of string;
  k: Integer;
  v: string;
  r: TRec;
  b: TBox;

begin
  total := 0;
  { A pushed temporary: Mk's result waits while Churn allocates. }
  s := Mk('a', 1) + Churn(200) + Mk('b', 2) + Churn(100);
  Check('push', s);
  { A computed string argument waits in a scratch slot. }
  s := Two(Mk('x', 3) + Mk('y', 4), Churn(150));
  Check('scratch', s);
  { A comparison of a computed string with another computed one. }
  if Mk('c', 5) + Churn(80) <> Mk('c', 5) then
    WriteLn('cmp ok');
  { Keys and values made while the map grows. }
  New(m);
  for i := 1 to 300 do
    m[Mk('k', i) + Churn(5)] := Mk('v', i) + Churn(7);
  n := 0;
  for i := 1 to 300 do
    if (Mk('k', i) + Churn(5)) in m then
      n := n + 1;
  WriteLn('map ', Length(m), ' ', n);
  { The Self of a method called on a temporary object. }
  s := NewBox(Mk('self', 9)).Say(Churn(120));
  Check('self', s);
  { A property set from a computed string. }
  b := TBox.Create;
  b.S := Mk('p', 1) + Churn(60);
  Check('prop', b.S);
  { A record passed by value, its strings built just before. }
  r.A := Mk('ra', 1);
  r.B := Mk('rb', 2);
  r.N := 42;
  s := RecSum(r, Churn(90));
  Check('record', s);
  { Deep recursion, every frame holding a string. }
  s := Deep(150);
  Check('deep', s);
  Nested;
  { A string held across a try block that allocates and raises. }
  t := Mk('t', 3);
  try
    s := Churn(70);
    Raise;
  except
    s := t + Churn(40);
  end;
  Check('try', s);
  t := Mk('f', 4);
  try
    s := Churn(30);
  finally
    s := t + s + Churn(20);
  end;
  Check('finally', s);
  { A loop over a map big enough to have a directory, whose copy only
    the loop holds, while the body allocates. }
  New(big);
  for i := 1 to 3000 do
    big[i] := Mk('e', i);
  n := 0;
  for k, v in big do
  begin
    if v = Mk('e', k) then
      n := n + 1;
    t := Churn(3);
  end;
  WriteLn('forin ', n);
  WriteLn('total ', total);
end.
