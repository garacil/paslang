program sysencodingmodel;
uses sysutils;
function HexDigit(Value: Char): Integer;
begin
  if (Value >= '0') and (Value <= '9') then Result := Ord(Value) - 48
  else if (Value >= 'a') and (Value <= 'f') then Result := Ord(Value) - 87
  else Halt(2);
end;
function DecodeHex(const Text: string): TBytes;
var i: Integer;
begin
  if Odd(Length(Text)) then Halt(3);
  SetLength(Result, Length(Text) div 2);
  for i := 0 to High(Result) do
    Result[i] := Byte(HexDigit(Text[i * 2 + 1]) * 16 + HexDigit(Text[i * 2 + 2]));
end;
function EncodeHex(const Bytes: TBytes): string;
const Digits = '0123456789abcdef';
var i: Integer;
begin
  SetLength(Result, Length(Bytes) * 2);
  for i := 0 to High(Bytes) do
  begin
    Result[i * 2 + 1] := Digits[Integer(Bytes[i] shr 4) + 1];
    Result[i * 2 + 2] := Digits[Integer(Bytes[i] and 15) + 1];
  end;
end;
var i, n, kind, operation: Integer; line, text: string;
  source, output: TBytes; encoding: TEncoding; error: TEncodingError; ok: Boolean;
begin
  ReadLn(line); n := StrToInt(line);
  for i := 1 to n do
  begin
    ReadLn(line); kind := StrToInt(line);
    ReadLn(line); operation := StrToInt(line);
    ReadLn(line);
    case kind of
      0: encoding := TEncoding.UTF8;
      1: encoding := TEncoding.Unicode;
      2: encoding := TEncoding.BigEndianUnicode;
      3: encoding := TEncoding.ASCII;
    else Halt(4);
    end;
    source := DecodeHex(line);
    if operation = 0 then ok := encoding.TryGetBytes(StringOf(source), output, error)
    else
    begin
      ok := encoding.TryGetString(source, text, error);
      output := BytesOf(text);
    end;
    if ok then WriteLn('OK ', EncodeHex(output))
    else
    begin
      if (Length(output) <> 0) then Halt(5);
      WriteLn('ERROR ', Ord(error.Kind), ' ', error.ByteIndex);
    end;
  end;
end.
