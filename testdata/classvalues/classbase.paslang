unit ClassBase;
interface
type
  TBase = class
    N: Integer;
    function Value: Integer; virtual;
  end;
  TChild = class(TBase)
    Extra: Integer;
    function Value: Integer; override;
  end;
  TAlias = TBase;
  IValue = interface
    function Value: Integer;
  end;
  TImplementation = class(TChild, IValue);
implementation
function TBase.Value: Integer;
begin Result := N end;
function TChild.Value: Integer;
begin Result := N + Extra end;
end.
