program ForwardValues;
type
  TBase = class N: Integer; end;
  TChild = class;
function Widen(C: TChild): TBase;
begin Result := C end;
function Root(C: TChild): TObject;
begin Result := C end;
procedure Outer;
  procedure Save(C: TChild; out B: TBase);
  begin B := C end;
begin end;
type
  TChild = class(TBase) Extra: Integer; end;
procedure Local;
type
  TParent = class N: Integer; end;
  TLeaf = class;
  function Up(X: TLeaf): TParent;
  begin Result := X end;
type
  TLeaf = class(TParent);
var
  L: TLeaf;
begin
  L := TLeaf.Create; L.N := 42;
  WriteLn(Up(L).N);
end;
var C: TChild;
begin
  C := TChild.Create; C.N := 7;
  WriteLn(Widen(C).N, ' ', Root(C).ClassName);
  Local;
end.
