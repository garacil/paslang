program ClassValues;
uses ClassBase, ClassDerived;
type
  THolder = record Item: TBase; end;
  generic TCell<T> = record Item: T; end;
  TBaseCell = specialize TCell<TBase>;
  TWrap = record
    Item: TBase;
    class operator Implicit(W: TWrap): TBase;
    class operator Implicit(B: TBase): TWrap;
  end;
class operator TWrap.Implicit(W: TWrap): TBase;
begin Result := W.Item end;
class operator TWrap.Implicit(B: TBase): TWrap;
begin Result.Item := B end;
procedure Check(Ok: Boolean);
begin if not Ok then Halt(2) end;
function Take(B: TBase): Integer;
begin Result := B.Value end;
function TakeConst(const B: TBase): Integer;
begin Result := B.Value end;
procedure SameVar(var B: TBase);
begin B := B end;
procedure Give(out B: TBase; C: TChild);
begin B := C end;
function Widen(C: TChild): TBase;
begin Result := C end;
function ExitWiden(C: TChild): TBase;
begin Exit(C) end;
var
  B: TBase;
  C: TChild;
  Alias: TAlias;
  Impl: TImplementation;
  Grand: TGrand;
  V: IValue;
  Obj: TObject;
  P: Pointer;
  H: THolder;
  G: TBaseCell;
  I: Integer;
  W: TWrap;
  Fixed: array[0..1] of TBase;
  Items: array of TBase;
  M: map[Integer] of TBase;
  Ch: chan of TBase;
  Done: chan of Integer;
procedure Worker;
var
  X: TBase;
  I: Integer;
begin
  for I := 1 to 40 do
  begin
    X := Recv(Ch);
    Check(X.Value = 42);
    GcCollect;
  end;
  Send(Done, 1);
end;
begin
  C := TChild.Create;
  C.N := 40; C.Extra := 2;
  B := C; Alias := C; Obj := C; P := C;
  Check((B.Value = 42) and (Alias.Value = 42));
  Check((TChild(Obj).Extra = 2) and (TChild(P).N = 40));
  Check((Take(C) = 42) and (TakeConst(C) = 42));
  SameVar(B); Give(B, C);
  Check((Widen(C).Value = 42) and (ExitWiden(C).Value = 42));
  G.Item := C; B := G.Item;
  Check((B as TChild).Extra = 2);
  H.Item := C; Fixed[0] := C; Items := [C, nil];
  New(M); M[1] := C;
  Check((H.Item.Value = 42) and (Fixed[0].Value = 42));
  Check((Items[0].Value = 42) and (Items[1] = nil) and (M[1].Value = 42));
  W := B; B := W; Check(B.Value = 42);
  Impl := TImplementation.Create; Impl.N := 20; Impl.Extra := 22;
  V := Impl; Check(V.Value = 42);
  Grand := TGrand.Create; Grand.N := 41; Grand.Extra := 1;
  Check(Up(Grand).Value = 42);
  B := nil; Alias := nil; C := nil; Check((B = nil) and (Alias = nil) and (C = nil));
  Ch := MakeChan(2); Done := MakeChan();
  pas Worker;
  for I := 1 to 40 do Send(Ch, Impl);
  Check(Recv(Done) = 1);
  WriteLn('ok class values');
end.
