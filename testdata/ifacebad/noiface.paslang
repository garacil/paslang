program noiface;
type
  IShape = interface
    function Area: Int64;
  end;
  TPlain = class
    function Area: Int64;
  end;
function TPlain.Area: Int64;
begin
  Result := 1;
end;
procedure Show(S: IShape);
begin
  WriteLn(S.Area);
end;
begin
  Show(TPlain.Create);
end.

