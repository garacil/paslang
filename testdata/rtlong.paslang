{ P271: the runtime's copies, clears, comparisons and hashes go 256 KiB
  a piece; across the edges of the pieces the answer must be the one of
  a single pass. Move at lengths about the multiples of 256 KiB, to a
  place before and after its source, near and far, against a copy byte
  by byte through a buffer; FillChar at the same lengths; a record of
  more than 256 KiB set to its zero value; a routine whose frame holds
  more than 256 KiB, which must start zero after another one filled the
  stack there; string = and < with one byte changed at places about the
  edges of the pieces; XxHash3, XxHash64 and XxHash32 of texts of
  lengths about the edges, which scripts/rtlong_model.py gives from
  xxhsum 0.8. Every mismatch is counted. }
program rtlong;

uses sysutils;

const
  NLen = 7;
  Lens: array[0..6] of Integer = (262143, 262144, 262145, 524319, 786431, 1000003, 1310720);
  Offs: array[0..7] of Integer = (-300001, -262144, -4097, -17, 17, 4097, 262144, 300001);
  { the texts the hashes read, and the places a comparison differs at:
    scripts/rtlong_model.py reads these tables }
  HLens: array[0..8] of Integer = (262143, 262144, 262145, 524287, 524288, 524289, 786431, 786432, 787431);
  Diffs: array[0..7] of Integer = (0, 262143, 262144, 262145, 524287, 524288, 600000, 786430);

type
  TBig = record
    A: array[0..300000] of Byte;
    Tail: Integer;
  end;

var
  bad: Integer;
  big: TBig;

function Pat(I: Integer): Byte;
begin
  Result := Byte((I * 131 + 7) and 255);
end;

{ a frame of more than 256 KiB: its local array starts zero }
procedure BigFrame;
var
  a: array[0..400000] of Byte;
  i: Integer;
begin
  i := 0;
  while i <= 400000 do
  begin
    if a[i] <> 0 then
      bad := bad + 1;
    i := i + 997;
  end;
  if a[400000] <> 0 then
    bad := bad + 1;
end;

{ the same frame filled, to leave its bytes in the stack }
procedure Dirty;
var
  a: array[0..400000] of Byte;
begin
  FillChar(a[0], 400001, 201);
  if a[200000] <> 201 then
    bad := bad + 1;
end;

var
  buf, want: array of Byte;
  s, t: string;
  i, k, j, n, len, base, d: Integer;

begin
  bad := 0;
  n := 4 shl 20;
  SetLength(buf, n);
  SetLength(want, n);
  base := 1500000;
  { Move: every length to every place, against a copy through a buffer }
  for i := 0 to NLen - 1 do
  begin
    len := Lens[i];
    for k := 0 to 7 do
    begin
      d := base + Offs[k];
      for j := 0 to n - 1 do
        buf[j] := Pat(j);
      for j := 0 to n - 1 do
        want[j] := buf[j];
      for j := 0 to len - 1 do
        want[d + j] := Pat(base + j);
      Move(buf[base], buf[d], len);
      for j := 0 to n - 1 do
        if buf[j] <> want[j] then
          bad := bad + 1;
    end;
    { FillChar of the same length, one byte before and after untouched }
    for j := 0 to n - 1 do
      buf[j] := Pat(j);
    FillChar(buf[base], len, 66);
    for j := base - 1 to base + len do
      if (j = base - 1) or (j = base + len) then
      begin
        if buf[j] <> Pat(j) then
          bad := bad + 1;
      end
      else if buf[j] <> 66 then
        bad := bad + 1;
  end;
  WriteLn('move and fill ', bad);

  { a record of more than 256 KiB set to its zero value }
  FillChar(big, SizeOf(big), 9);
  big := Default(TBig);
  for j := 0 to 300000 do
    if big.A[j] <> 0 then
      bad := bad + 1;
  if big.Tail <> 0 then
    bad := bad + 1;
  { a frame of more than 256 KiB, after another one filled the stack }
  Dirty;
  BigFrame;
  WriteLn('zero values ', bad);

  { = and < with one byte changed about the edges of the pieces }
  SetLength(s, 900000);
  for j := 1 to 900000 do
    s[j] := Chr(Pat(j));
  for i := 0 to 7 do
  begin
    t := Copy(s, 1, 900000);
    if not (s = t) then
      bad := bad + 1;
    if (s < t) or (t < s) then
      bad := bad + 1;
    t[Diffs[i] + 1] := Chr(Ord(s[Diffs[i] + 1]) xor 1);
    if s = t then
      bad := bad + 1;
    if (s < t) <> (Ord(s[Diffs[i] + 1]) < Ord(t[Diffs[i] + 1])) then
      bad := bad + 1;
    if (t < s) <> (Ord(t[Diffs[i] + 1]) < Ord(s[Diffs[i] + 1])) then
      bad := bad + 1;
  end;
  WriteLn('comparisons ', bad);

  { the hashes of texts about the edges }
  for i := 0 to 8 do
  begin
    t := Copy(s, 1, HLens[i]);
    WriteLn(HLens[i], ' ', IntToHex(XxHash3(t), 16), ' ', IntToHex(XxHash64(t), 16), ' ',
      IntToHex(XxHash32(t), 8));
  end;
  WriteLn('bad ', bad);
end.
