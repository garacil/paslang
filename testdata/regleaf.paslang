{ P397: a word field of an object a register holds is one load at an
  offset from that register, as a word variable is one, so it is a
  leaf of an expression: + * and or xor take it as their operand where
  it lies and a comparison as its right side (amd64), and nothing is
  pushed to keep the other side while it is loaded; Pointer(S) of a
  string field is the string's first word, read the same way; a
  constant shifted by a count is loaded after the count; the address of
  a pointer's element whose pointer and index the pool works out is one
  lea. Fields of Self, of a parameter and of a list's nodes a loop walks,
  narrow fields, read before and after calls; check_regleaf reads the
  forms. }
program regleaf;

type
  TNode = class
    Num: Integer;
    Small: LongInt;
    Next: TNode;
  end;

  TR = class
    FP: PByte;
    FTA, FTB: Integer;
    W: LongInt;
    S: string;
    Base: PByte;
    function Addr: PByte;
    function Same: Boolean;
    function Moved: Integer;
    function Bit(N: Integer): Int64;
    function Span: Integer;
    function Mix(N: Integer): Integer;
    function Diff: Integer;
    function Narrow(N: Integer): Integer;
    function Other(R: TR): Integer;
    function Around(N: Integer): Integer;
  end;

var
  buf: array[0..63] of Byte;
  calls: Integer;

function Twice(X: Integer): Integer;
begin
  Inc(calls);
  Result := X * 2;
end;

function TR.Addr: PByte;
begin
  Result := @FP[FTA];
end;

function TR.Same: Boolean;
begin
  Result := Base = PByte(Pointer(S));
end;

function TR.Moved: Integer;
begin
  Result := 0;
  if Base <> PByte(Pointer(S)) then
    Result := 7;
end;

function TR.Bit(N: Integer): Int64;
begin
  Result := Int64(1) shl ((9 * (N - 2) + FTA) and 63);
end;

function TR.Span: Integer;
begin
  Result := FTB - FTA + Length(S);
end;

function TR.Mix(N: Integer): Integer;
begin
  Result := ((FTA + FTB) * N) xor (FTA and N) or (FTB * FTA);
end;

function TR.Diff: Integer;
begin
  Result := FTB - FTA;
  if FTA < FTB then
    Result := Result + 1000;
  if FTB >= FTA then
    Result := Result + 100;
end;

function TR.Narrow(N: Integer): Integer;
begin
  Result := W + N;
  if W < N then
    Result := Result * 2;
end;

function TR.Other(R: TR): Integer;
begin
  Result := R.FTA + FTB;
  if R.FTB = FTA then
    Result := -Result;
end;

function TR.Around(N: Integer): Integer;
begin
  Result := FTA + Twice(FTB) + FTA;
  Result := Result + Twice(N) * FTB - FTA;
end;

{ a list's nodes, the loop's pointer in a register, their fields its
  leaves }
function Walk(First: TNode; Limit: Integer): Integer;
var
  p: TNode;
begin
  Result := 0;
  p := First;
  while p <> nil do
  begin
    Result := Result + p.Num + p.Num * 3;
    if p.Num > Limit then
      Result := Result - p.Small;
    if p.Small = p.Num then
      Result := Result + Twice(p.Small);
    p := p.Next;
  end;
end;

var
  r, q: TR;
  n, first: TNode;
  i: Integer;

begin
  for i := 0 to 63 do
    buf[i] := Byte(i * 3);
  r := TR.Create;
  r.FP := @buf[0];
  r.FTA := 5;
  r.FTB := 21;
  r.W := -9;
  r.S := 'hello';
  r.Base := nil;
  WriteLn('addr ', Integer(r.Addr) - Integer(@buf[0]), ' ', r.Addr^);
  WriteLn('same ', r.Same, ' moved ', r.Moved);
  r.Base := PByte(Pointer(r.S));
  WriteLn('same ', r.Same, ' moved ', r.Moved);
  r.S := '';
  WriteLn('empty same ', r.Same, ' moved ', r.Moved);
  r.Base := nil;
  WriteLn('nil same ', r.Same, ' moved ', r.Moved);
  r.S := 'abc';
  WriteLn('bit ', r.Bit(7), ' ', r.Bit(2), ' ', r.Bit(9));
  WriteLn('span ', r.Span, ' mix ', r.Mix(3), ' ', r.Mix(-17), ' diff ', r.Diff);
  WriteLn('narrow ', r.Narrow(4), ' ', r.Narrow(-20));
  r.W := 2147483647;
  WriteLn('narrow max ', r.Narrow(1));
  q := TR.Create;
  q.FTA := 21;
  q.FTB := 5;
  WriteLn('other ', r.Other(q), ' ', q.Other(r), ' ', q.Diff);
  calls := 0;
  WriteLn('around ', r.Around(4), ' ', q.Around(-3), ' calls ', calls);
  first := nil;
  for i := 1 to 12 do
  begin
    n := TNode.Create;
    n.Num := i * i - 30;
    n.Small := i * 7 - 40;
    if i = 5 then
      n.Small := n.Num;
    n.Next := first;
    first := n;
  end;
  calls := 0;
  WriteLn('walk ', Walk(first, 10), ' ', Walk(first, -100), ' calls ', calls);
  r.FTA := -4;
  r.FTB := -9;
  WriteLn('neg mix ', r.Mix(7), ' diff ', r.Diff, ' span ', r.Span);
end.
