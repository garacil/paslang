{ P293: a loop that neither counts nor calls tests nothing at its
  passes: on one CPU the main routine still runs while Spin loops, since
  sysmon's SIGURG stops Spin where it is, and Spin sees done, a global
  another routine writes, which no register keeps. }
program asyncspin;

var
  done, x: Integer;

procedure Spin;
var
  v: Integer;
begin
  v := 1;
  while done = 0 do
    v := v xor (v shl 1) xor 12345;
  x := v;
  WriteLn('spin stopped');
end;

begin
  done := 0;
  pas Spin;
  Sleep(50);
  WriteLn('main ran');
  done := 1;
  Sleep(50);
end.

