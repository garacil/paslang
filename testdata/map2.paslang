{ Delete, in, TryGet, Clear, for k in m, for k, v in m, changing the map
  inside its own loop, and a record value. The order of a loop is not
  specified, so the loops count and add. }
program map2;

type
  TPoint = record
    X, Y: Integer;
  end;

var
  m, u: map[Integer] of Integer;
  w: map[string] of TPoint;
  k, v, n, sum, i: Integer;
  p: TPoint;
  found: Boolean;

begin
  New(m);
  for i := 1 to 100 do
    m[i] := i * i;
  i := 2;
  while i <= 100 do              { delete the even keys }
  begin
    Delete(m, i);
    i := i + 2;
  end;
  WriteLn(Length(m), ' ', 2 in m, ' ', 3 in m, ' ', Delete(m, 2), ' ',
    Delete(m, 3), ' ', 3 in m);
  m[3] := 9;
  m[2] := 4;                     { deleted slots are reused }
  n := 0;
  sum := 0;
  for k in m do
  begin
    n := n + 1;
    sum := sum + k;
  end;
  WriteLn(n, ' ', Length(m), ' ', sum);
  n := 0;
  sum := 0;
  for k, v in m do               { key and value together }
  begin
    n := n + 1;
    sum := sum + v - k * k;      { every value is the square of its key }
  end;
  WriteLn(n, ' ', sum);
  for k in m do                  { deleting inside the loop is allowed }
    if k > 50 then
      Delete(m, k);
  n := 0;
  for k in m do
    n := n + 1;
  WriteLn(n, ' ', Length(m));
  for i := 101 to 400 do
    m[i] := i * i;
  n := 0;
  for k in m do                  { inserting inside the loop is allowed }
  begin
    n := n + 1;
    if k < 60 then
      m[k + 1000] := 0;
  end;
  WriteLn((n >= 326) and (n <= 352), ' ', Length(m));
  found := TryGet(m, 3, v);      { TryGet reads without a zero-value guess }
  WriteLn(found, ' ', v);
  found := TryGet(m, 4, v);
  WriteLn(found);
  New(w);
  p.X := 1;
  p.Y := 2;
  w['a'] := p;
  p.X := 0;
  p.Y := 0;
  found := TryGet(w, 'a', p);
  WriteLn(found, ' ', p.X, ' ', p.Y);
  p := w['zz'];                  { a missing record is all zero }
  WriteLn(p.X, ' ', p.Y);
  Clear(m);
  WriteLn(Length(m), ' ', 3 in m);
  m[7] := 49;
  WriteLn(Length(m), ' ', m[7]);
  Delete(u, 1);                  { a nil map takes Delete and Clear }
  Clear(u);
  WriteLn(Length(u));
end.

