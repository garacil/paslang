{ Subranges of Char and of an enumeration (P135): a value of one is a
  value of its host, Char or the enumeration: written as a Char, joined
  to a string, compared with a Char, assigned both ways, walked by for,
  a case selector; Low, High, Succ and Pred; a set of each, a record's
  fields, a routine's parameter and result. The same source compiles
  with Free Pascal, whose output is the one expected. }
program subrange1;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  TDigit = '0'..'9';
  TUpper = 'A'..'Z';
  TCtl = #0..#31;
  TDay = (Mon, Tue, Wed, Thu, Fri, Sat, Sun);
  TWork = Mon..Fri;
  TWeekEnd = Sat..Sun;
  TDigits = set of TDigit;
  TWorks = set of TWork;

  TRec = record
    D: TDigit;
    W: TWork;
    N: Integer;
  end;

function Next(D: TDigit): TDigit;
begin
  if D = High(TDigit) then
    Result := Low(TDigit)
  else
    Result := Succ(D);
end;

function B(V: Boolean): Integer;
begin
  if V then
    Result := 1
  else
    Result := 0;
end;

function Kind(D: TDigit): string;
begin
  case D of
    '0': Result := 'zero';
    '1'..'4': Result := 'low';
    '5', '6': Result := 'mid';
  else
    Result := 'high';
  end;
end;

function Rest(W: TWork): Integer;
begin
  Result := Ord(High(TWork)) - Ord(W);
end;

var
  d, e: TDigit;
  c: Char;
  s: string;
  u: TUpper;
  w: TWork;
  day: TDay;
  ds: TDigits;
  ws: TWorks;
  r: TRec;

begin
  d := '7';
  c := d;
  s := 'n' + d + c;
  WriteLn(d, ' ', c, ' ', s, ' ', Ord(d), ' ', Length(s));
  WriteLn(Low(TDigit), High(TDigit), ' ', Low(TUpper), High(TUpper), ' ', Ord(High(TCtl)));
  e := Next(d);
  Write(e);
  e := Next('9');
  WriteLn(e);
  WriteLn(B(d < '8'), B(d > c), B(d = '7'), B('7' = d), B(d <> e));
  c := 'X';
  u := c;
  WriteLn(u, Succ(u), Pred(u), ' ', u + 'y');
  for d := '3' to '6' do
    Write(d);
  WriteLn;
  for d := High(TDigit) downto '8' do
    Write(d, Kind(d));
  WriteLn(' ', Kind('0'), ' ', Kind('3'), ' ', Kind('6'));
  s := '';
  for d in ['1', '5'..'7'] do
    s := s + d;
  WriteLn(s);
  ds := ['0', '2'..'4'];
  Include(ds, '9');
  Exclude(ds, '3');
  for d in ds do
    Write(d);
  d := '5';
  WriteLn(' ', B('2' in ds), B(d in ds), B(ds <= ['0'..'9']));
  w := Wed;
  day := w;
  WriteLn(Ord(w), ' ', Ord(day), ' ', Ord(High(TWork)), ' ', Ord(Low(TWeekEnd)), ' ', Rest(w), ' ', Rest(Mon));
  ws := [Tue, w, Fri];
  for day in ws do
    Write(Ord(day));
  for w in ws do
    Write(Ord(w));
  day := Sat;
  WriteLn(' ', B(Thu in ws), B(day in ws), B(Pred(day) = w), B(w > Thu));
  for w := Low(TWork) to High(TWork) do
    Write(Ord(w));
  WriteLn;
  r.D := '4';
  r.W := Thu;
  r.N := 5;
  WriteLn(r.D, Ord(r.W), r.N, ' ', r.D + r.D);
end.

