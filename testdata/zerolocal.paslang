{ Locals start as zero, including the strings and slices inside a
  record, even when an earlier call left the same stack bytes dirty. }
program zerolocal;

type
  TRec = record
    A, B: Integer;
    S: string;
    L: array of Integer;
  end;

procedure Dirty;
var
  x, y, z: Integer;
  s: string;
begin
  x := 111;
  y := 222;
  z := 333;
  s := 'garbage';
  WriteLn(x + y + z, ' ', Length(s));
end;

procedure Clean;
var
  r: TRec;
  k: Integer;
  t: string;
  q: array of Integer;
begin
  WriteLn(r.A, ' ', r.B, ' ', Length(r.S), ' ', Length(r.L), ' ', k, ' ',
    Length(t), ' ', Length(q));
  r.A := 5;
  t := 'x';
end;

begin
  Dirty;
  Clean;
  Dirty;
  Clean;
end.

