{ P319: a run's head proves a slice by its length, in a register or
  at its home. Sum5 reads five slices at the counter plus 0 to 2, more
  pointers and lengths than the region keeps in registers; Mix5 writes
  the elements of one from the others, Local5 reads five local slices
  and Back walks down. Their free bodies check none of them:
  scripts/check_chkcse.py counts the checks, the checked body's alone.
  Written by a script; the answers are Python's. }
program runlen;

var
  a, b, c, d, e: array of Integer;

procedure Fill(n: Integer);
var
  k: Integer;
begin
  SetLength(a, n + 2);
  SetLength(b, n + 2);
  SetLength(c, n + 2);
  SetLength(d, n + 2);
  SetLength(e, n + 2);
  for k := 0 to n + 1 do
  begin
    a[k] := k * 3 + 1;
    b[k] := k xor 5;
    c[k] := 100 - k;
    d[k] := k * k;
    e[k] := k and 7;
  end;
end;

function Sum5(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to n - 1 do
    t := t + a[k] + b[k + 1] + c[k] + d[k + 2] + e[k];
  Result := t;
end;

function Mix5(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to n - 1 do
  begin
    a[k] := b[k + 1] - c[k] + d[k] xor e[k + 2];
    t := t + a[k];
  end;
  Result := t;
end;

function Local5(n: Integer): Integer;
var
  k, t: Integer;
  p, q, r, u, w: array of Integer;
begin
  SetLength(p, n + 1);
  SetLength(q, n + 1);
  SetLength(r, n + 1);
  SetLength(u, n + 1);
  SetLength(w, n + 1);
  for k := 0 to n do
  begin
    p[k] := k;
    q[k] := k * 2;
    r[k] := k xor 3;
    u[k] := 7 - k;
    w[k] := k and 15;
  end;
  t := 0;
  for k := 0 to n - 1 do
    t := t + p[k + 1] - q[k] + r[k] * u[k + 1] + w[k];
  Result := t;
end;

function Back(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := n - 1 downto 0 do
    t := t * 3 + b[k] - e[k + 1] + c[k + 2] - d[k];
  Result := t;
end;

begin
  Fill(10);
  WriteLn(Sum5(10), ' ', Mix5(10), ' ', Back(10), ' ', Local5(10));
  Fill(5000);
  WriteLn(Sum5(5000), ' ', Mix5(5000), ' ', Back(5000), ' ', Local5(5000));
  Fill(3000);
  WriteLn(Sum5(1), ' ', Mix5(2999), ' ', Back(3000), ' ', Local5(1));
end.
