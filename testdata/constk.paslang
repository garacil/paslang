{ A const section takes every constant kind: an integer, a real, a
  string, a Char, True, False, and the name of another constant (P97). }
program constk;

const
  N = 3;
  Neg = -2;
  Ratio = 1.5;
  NegRatio = -0.25;
  Name = 'paslang';
  Nl = #10;
  Yes = True;
  No = False;
  Alias = Name;
  Twice = N;
  Third = Twice;

var
  s: string;
  c: Char;
  r: Real;
  a: array[1..N] of Integer;

begin
  WriteLn(N + Twice + Third);
  WriteLn(Neg);
  WriteLn(Ratio);
  WriteLn(NegRatio);
  WriteLn(Name, ' ', Length(Name));
  s := Alias + '!';
  WriteLn(s);
  c := Nl;
  WriteLn(Ord(c));
  if Yes and not No then
    WriteLn('booleans');
  r := Ratio * 2;
  WriteLn(r);
  a[N] := 7;
  WriteLn(a[3]);
end.

