{ P317: a product by a constant inside a narrowing conversion reads its
  variable where the register keeps it: Byte, Word, UInt32, Int8, Int16
  and Int32 of k * C for C of 3 to 24 and negative ones, k a loop's
  variable in a register, summed. scripts/check_convmul.py reads that
  the routines Conv move no variable before its recipe. Written by a
  script; the answers are Python's. }
program convmul;

function ConvByte3(n: Integer): Integer;
var
  k, s: Integer;
  v: Byte;
begin
  s := 0;
  for k := 0 to n - 1 do
  begin
    v := Byte(k * 3);
    s := s + v;
  end;
  Result := s;
end;

