program narrowgo;

{ The lines of the narrow integers where the rules are Go's (P99): wraps,
  conversions that keep the low bits, div, mod and shr by the sign, not
  and the negative in the type. testdata/narrowgo.go prints the same;
  make check runs both against narrowgo.out. }

var
  b: Byte;
  s8: Int8;
  w: Word;
  s16: Int16;
  u32: UInt32;
  s32: Int32;
  x: Integer;

begin
  b := 255;
  b := b + 1;
  w := 65535;
  w := w + 1;
  s8 := 127;
  s8 := s8 + 1;
  s16 := -32768;
  s16 := s16 - 1;
  u32 := 4294967295;
  u32 := u32 + 1;
  s32 := 2147483647;
  s32 := s32 + 1;
  WriteLn(b, ' ', w, ' ', s8, ' ', s16, ' ', u32, ' ', s32);
  x := 300;
  WriteLn(Byte(x), ' ', Int8(x - 100), ' ', Word(-x), ' ', UInt32(-x), ' ', Int32(4294967295 + x));
  x := -1;
  WriteLn(Byte(x), ' ', Word(x), ' ', UInt32(x), ' ', Int16(x));
  s8 := -128;
  s8 := s8 div -1;
  WriteLn(s8);
  s8 := -7;
  WriteLn(s8 div 2, ' ', s8 mod 3, ' ', s8 shr 1);
  b := 200;
  WriteLn(b shr 1, ' ', b div 3, ' ', b mod 7, ' ', b shl 1, ' ', b * 2, ' ', b + 100);
  s16 := -1;
  s32 := -256;
  u32 := 4294967295;
  WriteLn(s16 shr 4, ' ', s32 shr 4, ' ', u32 shr 31);
  b := 1;
  b := -b;
  s8 := -128;
  s8 := -s8;
  WriteLn(b, ' ', s8, ' ', not b, ' ', not s8);
  w := 300;
  w := w * w;
  s32 := 100000;
  s32 := s32 * s32;
  WriteLn(w, ' ', s32);
  b := 200;
  s8 := -100;
  WriteLn(Int16(b) + Int16(s8), ' ', Int32(Word(65535)) + Int32(Int16(-1)));
end.

