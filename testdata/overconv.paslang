{ Overloads take what a call takes (P141): a Char for a string, an
  object for its ancestor and for an interface it implements, a pointer
  for Pointer, a subrange for its host, a routine for a routine type, a
  list for an open array, nil for a slice, a one-character literal for
  a Char. The output is Free Pascal's (with CORBA interfaces). }
program overconv;
type
  TDay = (Mon, Tue, Wed);
  TWork = Mon..Tue;
  TProc = procedure(X: Int64);
  PInt = ^Int64;
  TBase = class
  end;
  TKid = class(TBase)
  end;
  IThing = interface
    function Id: Int64;
  end;
  TThing = class(TObject, IThing)
    function Id: Int64;
  end;
  TInts = array of Int64;
function TThing.Id: Int64;
begin
  Result := 9;
end;
function N(X: Int64): string;
begin
  Str(X, Result);
end;
procedure Show(X: Int64);
begin
  WriteLn('show ', X);
end;
function F(const S: string): string; overload; begin Result := 'str ' + S; end;
function F(B: TBase): string; overload; begin Result := 'base ' + B.ClassName; end;
function F(T: IThing): string; overload; begin Result := 'thing ' + N(T.Id); end;
function F(P: Pointer): string; overload; begin Result := 'pointer'; end;
function F(D: TDay): string; overload; begin Result := 'day ' + N(Ord(D)); end;
function F(P: TProc): string; overload; begin Result := 'proc'; end;
function F(const A: array of Int64): string; overload; begin Result := 'open ' + N(Length(A)); end;
function F(X: Double; Y: Double): string; overload; begin Result := 'reals'; end;
function G(C: Char): string; overload; begin Result := 'char ' + C; end;
function G(I: Int64): string; overload; begin Result := 'int'; end;
function Kf(T: IThing): string; overload; begin Result := 'kthing ' + N(T.Id); end;
function Kf(S: string): string; overload; begin Result := 'kstr'; end;
function H(A: TInts): string; overload; begin Result := 'ints ' + N(Length(A)); end;
function H(S: string): string; overload; begin Result := 'hstr'; end;
var
  c: Char;
  k: TKid;
  th: TThing;
  pv: PInt;
  v: Int64;
  w: TWork;
begin
  c := 'z';
  WriteLn(F(c));
  WriteLn(F(#65));
  k := TKid.Create;
  WriteLn(F(k));
  th := TThing.Create;
  WriteLn(Kf(th));
  v := 5;
  pv := @v;
  WriteLn(F(pv));
  w := Tue;
  WriteLn(F(w));
  WriteLn(F(@Show));
  WriteLn(F([7, 8]));
  WriteLn(F(1, 2));
  WriteLn(G('x'));
  WriteLn(G(3));
  WriteLn(H(nil));
end.

