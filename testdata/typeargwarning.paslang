program typeargwarning;
type TOuter = record
  type TSmall = Byte;
end;
begin
  if SizeOf(TOuter {$WARNING type argument lookahead once}.TSmall) <> 1 then Halt(108);
  WriteLn('ok type argument warning');
end.
