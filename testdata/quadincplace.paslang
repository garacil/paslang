{ P190: Inc(a[F]) binds a Quad destination once. }
program quadincplace;

var
  q: Quad;
  d: Double;
  s: Single;
  i: Integer;
  b: Boolean;
  a: array[0..1] of Quad;
  calls: Integer;

function F: Integer;
begin
  Inc(calls);
  Result := 0;
end;

begin
  q := 1;
  Inc(a[F]);
  if (calls <> 1) or (a[0] <> 1) then Halt(1);
  WriteLn('Quad Inc destination evaluated once');
end.

