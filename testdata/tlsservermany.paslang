program tlsservermany;

uses sysutils, paslib, pasroutines, pastls, httpserver;

var
  Server: THttpServer;
  Serving: waitgroup;

procedure Hello(Req: THttpRequest; Resp: THttpResponse);
begin
  Resp.ReplyText(200, 'hello');
end;

procedure Status(Req: THttpRequest; Resp: THttpResponse);
begin
  Resp.ReplyText(200, IntToStr(Server.Active) + ' ' + IntToStr(NumGoroutine));
end;

procedure Collect(Req: THttpRequest; Resp: THttpResponse);
begin
  GcCollect;
  Resp.ReplyText(200, 'collected');
end;

procedure RunServer;
begin
  try
    Server.Serve;
  finally
    Serving.Done;
  end;
end;

var
  Cert, Key, Err, Command: string;
  Config: TTlsServerConfig;
  Router: THttpRouter;
  IdleRoutines, Deadline: Integer;

begin
  if not ReadFile(ParamStr(1), Cert) or not ReadFile(ParamStr(2), Key) then Halt(2);
  Config := TTlsServerConfig.Create;
  Config.MinVersion := TlsVersion12;
  if not Config.LoadKeyPair(Cert, Key, Err) then
  begin
    WriteLn(Err);
    Halt(3);
  end;
  Router := THttpRouter.Create;
  Router.Handle('GET', '/', @Hello);
  Router.Handle('GET', '/status', @Status);
  Router.Handle('GET', '/collect', @Collect);
  Server := THttpServer.Create(Router);
  Server.Tls := Config;
  Server.AccessLog := False;
  { The test controls when clients advance. A deadline limits a broken run. }
  Server.HeaderTimeoutMs := 300000;
  Server.IdleTimeoutMs := 300000;
  Server.ShutdownTimeoutMs := 10000;
  if not Server.ListenTcp('127.0.0.1', 0) then Halt(4);
  IdleRoutines := NumGoroutine;
  Serving.Add(1);
  pas RunServer;
  WriteLn(Server.Port);
  ReadLn(Command);
  if Command <> 'stop' then Halt(5);
  Server.Shutdown;
  Serving.Wait;
  { WaitGroup.Done and Untrack can run just before the routine returns. }
  Deadline := Nanotime + 5000000000;
  while (NumGoroutine > IdleRoutines) and (Nanotime < Deadline) do Sleep(1);
  WriteLn(Server.Active, ' ', NumGoroutine, ' ', IdleRoutines);
  { The checker counts sockets before the process exits. }
  ReadLn(Command);
  if Command <> 'exit' then Halt(6);
end.
