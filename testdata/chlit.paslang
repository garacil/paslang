program chlit;

var
  s: string;
  c: Char;

begin
  s := 'ab'#10'c';
  WriteLn(Length(s));
  WriteLn(Ord(s[3]));
  c := #10;
  WriteLn(Ord(c));
  if s[2] = #98 then
    WriteLn('b')
  else
    WriteLn('no');
  s := 'a' + #10 + 'b';
  WriteLn(Length(s));
  WriteLn(Ord(s[2]));
  s := 'lazlang'#0'lazlang'#0;
  WriteLn(Length(s));
  WriteLn(Ord(s[8]));
  WriteLn(Ord(s[16]));
end.

