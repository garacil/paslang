{ P395: the token reader's errors in a literal, a number and a comma
  before a closing bracket, as Go's jsontext Decoder words them and at
  its offsets: each text read a token at a time from a string, which
  reads where it can in place, and from a source routine that gives it
  whole, which reads the slow way alone; both must say the same. }
program jsontokerr;

const
  KindName: array[TJsonErrorKind] of string = ('syntax', 'encoding', 'duplicate', 'depth',
    'too large', 'missing', 'type', 'range', 'unknown', 'test', 'io');
  Texts: array[0..17] of string = ('[tru]', '[1.]', '[01]', '[1,2,]', '{"a":tru}', '-', '1e',
    '1.5e+', '{"a":}', '{"a":1,}', '[1x]', 'tru', '[-]', '[1.5e]', '[nul ]', '[true1]',
    '{"a":01}', '[ 1 , ]');

var
  cur: string;
  given: Boolean;
  i: Integer;
  a, b: string;

{ the source: the text whole, then the end }
function Source: string;
begin
  if given then
    Result := ''
  else
    Result := cur;
  given := True;
end;

function ReadAll(R: TJsonReader): string;
begin
  Result := 'ok';
  try
    while R.Next <> jtkEnd do
      ;
  except
    on x: EJsonError do
      Result := KindName[x.Kind] + ': ' + x.Message;
  end;
end;

begin
  for i := 0 to High(Texts) do
  begin
    cur := Texts[i];
    a := ReadAll(JsonReader(cur));
    given := False;
    b := ReadAll(JsonReader(@Source));
    Write(cur, ': ', a);
    if b <> a then
      Write(' | from a source: ', b);
    WriteLn;
  end;
end.
