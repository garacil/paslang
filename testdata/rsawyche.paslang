program rsawyche;
{ P429: Wycheproof's RSA signature vectors for pasrsa
  (testdata/wycheproof: PKCS #1 v1.5 with 2048, 3072 and 4096-bit keys
  and SHA-256, -384 and -512, the signatures made by the private key,
  and PSS with 2048 and 4096-bit keys), run as Go's crypto/rsa
  rsa_wycheproof_test.go runs them.
  A file of RsassaPkcs1Verify groups goes to RsaVerifyPkcs1v15: a test
  must pass when "valid", fail when "invalid", and fail when
  "acceptable" with the flag MissingNull (Go's flagsShouldPass). A file
  of RsassaPssVerify groups goes to RsaVerifyPss twice, with the salt
  length found (RsaPssSaltAuto) and with the group's sLen: with the
  salt found, a signature whose only fault is its salt length ("s_len
  changed to n") is valid, the tests Go's filesOverrideToPassZeroSLen
  lists. Groups whose hash paslang has no word for (SHA-512/224,
  SHA-512/256, SHAKE) and PSS groups whose MGF1 hash differs from the
  message hash (Go does not support them either) are skipped and
  counted. }
uses pasrsa, paslib, sysutils;

function UnHex(const h: string): string;
var
  i, d, v: Integer;
  c: Char;
begin
  Result := '';
  SetLength(Result, Length(h) div 2);
  v := 0;
  for i := 1 to Length(h) do
  begin
    c := h[i];
    if (c >= '0') and (c <= '9') then d := Ord(c) - 48
    else if (c >= 'a') and (c <= 'f') then d := Ord(c) - 87
    else d := Ord(c) - 55;
    if Odd(i) then v := d shl 4
    else Result[i div 2] := Chr(v or d);
  end;
end;

function HashId(const s: string): Integer;
begin
  if s = 'SHA-1' then Result := RsaSha1
  else if s = 'SHA-224' then Result := RsaSha224
  else if s = 'SHA-256' then Result := RsaSha256
  else if s = 'SHA-384' then Result := RsaSha384
  else if s = 'SHA-512' then Result := RsaSha512
  else if s = 'SHA3-224' then Result := RsaSha3_224
  else if s = 'SHA3-256' then Result := RsaSha3_256
  else if s = 'SHA3-384' then Result := RsaSha3_384
  else if s = 'SHA3-512' then Result := RsaSha3_512
  else Result := -1;
end;

const
  Files: array[0..5] of string = ('rsa_signature_2048_sha256_test.json', 'rsa_signature_3072_sha384_test.json',
    'rsa_signature_4096_sha512_test.json', 'rsa_pkcs1_2048_sig_gen_test.json',
    'rsa_pss_2048_sha256_mgf1_32_test.json', 'rsa_pss_4096_sha512_mgf1_64_test.json');

var
  text, res, n, comment, fname, ty, kname: string;
  doc, grp, tc, fl: json;
  pass, fail, skip, tpass, tfail, tskip, e, hash, slen, fi, pass2, i, ntc: Integer;
  ok, want, missingNull, isPss: Boolean;
  hashed, sig: string;
begin
  tpass := 0; tfail := 0; tskip := 0;
  for fi := 0 to 5 do
  begin
    fname := 'testdata/wycheproof/' + Files[fi];
    if not ReadFile(fname, text) then
    begin
      WriteLn('cannot read ', fname);
      Halt(1);
    end;
    doc := JsonParse(text);
    pass := 0; fail := 0; skip := 0; ntc := 0;
    for grp in doc['testGroups'] do
    begin
      ty := grp['type'].AsString;
      isPss := (ty = 'RsassaPssVerify') or (ty = 'RsassaPssWithParametersVerify');
      if not isPss and (ty <> 'RsassaPkcs1Verify') and (ty <> 'RsassaPkcs1Generate') then
      begin
        { not a signature: rsa_pkcs1_*_test.json and the OAEP files decrypt }
        WriteLn('  group of type ', ty, ': not a signature, skipped');
        for tc in grp['tests'] do
        begin
          Inc(ntc);
          Inc(skip);
        end;
        Continue;
      end;
      hash := HashId(grp['sha'].AsString);
      kname := 'publicKey';
      if ty = 'RsassaPkcs1Generate' then
        kname := 'privateKey';
      n := UnHex(grp[kname]['modulus'].AsString);
      res := grp[kname]['publicExponent'].AsString;
      e := 0;
      if Length(res) <= 15 then
        for i := 1 to Length(res) do
          e := e * 16 + Pos(LowerCase(res[i]), '0123456789abcdef') - 1;
      slen := 0;
      if isPss then
        slen := grp['sLen'].AsInteger;
      if (hash < 0) or (isPss and ((grp['mgf'].AsString <> 'MGF1') or (grp['mgfSha'].AsString <> grp['sha'].AsString))) then
      begin
        for tc in grp['tests'] do
        begin
          Inc(ntc);
          if isPss then skip := skip + 2 else Inc(skip);
        end;
        Continue;
      end;
      for tc in grp['tests'] do
      begin
        Inc(ntc);
        res := tc['result'].AsString;
        comment := tc['comment'].AsString;
        missingNull := False;
        for fl in tc['flags'] do
          if fl.AsString = 'MissingNull' then
            missingNull := True;
        hashed := RsaHash(hash, UnHex(tc['msg'].AsString));
        sig := UnHex(tc['sig'].AsString);
        if not isPss then
        begin
          ok := RsaVerifyPkcs1v15(n, e, hash, hashed, sig);
          want := (res = 'valid') or ((res = 'acceptable') and not missingNull);
          { a signature made by the generation tests: valid, or acceptable
            for a 1024-bit key, SHA-1 or e = 3, which Go verifies }
          if ty = 'RsassaPkcs1Generate' then
            want := res <> 'invalid';
          if ok = want then Inc(pass)
          else
          begin
            Inc(fail);
            WriteLn('FAIL ', fname, ' tcId ', tc['tcId'].AsInteger, ' ', res, ' got ', ok, ' ', comment);
          end;
          Continue;
        end;
        for pass2 := 0 to 1 do
        begin
          if pass2 = 0 then
          begin
            ok := RsaVerifyPss(n, e, hash, hashed, sig, RsaPssSaltAuto);
            want := (res = 'valid') or (Copy(comment, 1, 17) = 's_len changed to ');
          end
          else
          begin
            ok := RsaVerifyPss(n, e, hash, hashed, sig, slen);
            want := res = 'valid';
          end;
          if ok = want then Inc(pass)
          else
          begin
            Inc(fail);
            WriteLn('FAIL ', fname, ' tcId ', tc['tcId'].AsInteger, ' round ', pass2, ' ', res, ' got ', ok, ' ', comment);
          end;
        end;
      end;
    end;
    WriteLn(ExtractFileName(fname), ': ', ntc, ' tests, ', pass, ' pass, ', fail, ' fail, ', skip, ' skipped');
    tpass := tpass + pass; tfail := tfail + fail; tskip := tskip + skip;
  end;
  WriteLn('total: ', tpass, ' pass, ', tfail, ' fail, ', tskip, ' skipped (PSS files count each test twice: salt found and salt given)');
end.
