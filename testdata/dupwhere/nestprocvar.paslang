program nestprocvar;

{ A variable may not take the name of a routine around it (P151, P159):
  inside, a call of the routine would find the variable. }
procedure P;
  function X: Integer;
  begin
    Result := 1;
  end;

  procedure Q;
  var
    X: Integer;
  begin
    X := 2;
  end;

begin
  Q;
end;

begin
  P;
end.

