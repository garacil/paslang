program nestprocvar;

{ P691: a local hides the enclosing scope's routine. }
procedure P;
  function X: Integer;
  begin
    Result := 1;
  end;

  procedure Q;
  var
    X: Integer;
  begin
    X := 2;
    WriteLn(X);
  end;

begin
  Q;
  WriteLn(X());
end;

begin
  P;
end.

