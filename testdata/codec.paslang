{ P435: pascodec against Go (uses pascodec). testdata/codec.out is what
  scripts/codec_oracle.go prints from Go's encoding/base64, net/url,
  encoding/csv and strings (with golang.org/x/text's NFD for the
  folding): base64 in the four forms over lengths 0 to 300 and a list of
  malformed texts; URL escapes of every byte and of random strings and
  the unescapes of a list; CSV records or errors of a list of texts under
  six readers, a hash of the outcome of 1500 random texts under each, and
  the writer's lines; upper, lower and folded letters of every code point
  to U+017F and of random strings. The same lines, byte for byte. }
program codec;

uses
  pascodec;

var
  GS: Integer;
  FH: Integer;

function GNext: Integer;
var
  z: Integer;
begin
  GS := GS + Integer($9E3779B97F4A7C15);
  z := GS;
  z := (z xor (z shr 30)) * Integer($BF58476D1CE4E5B9);
  z := (z xor (z shr 27)) * Integer($94D049BB133111EB);
  Result := z xor (z shr 31);
end;

function Hex16(V: Integer): string;
const
  D: string = '0123456789abcdef';
var
  i: Integer;
begin
  SetLength(Result, 16);
  for i := 16 downto 1 do
  begin
    Result[i] := D[(V and 15) + 1];
    V := V shr 4;
  end;
end;

procedure FnvNew;
begin
  FH := Integer($CBF29CE484222325);
end;

procedure FnvAdd(const S: string);
var
  i: Integer;
begin
  for i := 1 to Length(S) do
    FH := (FH xor Ord(S[i])) * Integer($100000001B3);
  FH := (FH xor 255) * Integer($100000001B3);
end;

function RandBytes(N: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, N);
  for i := 1 to N do
    Result[i] := Chr((GNext shr 24) and 255);
end;

{ ---- base64 ---- }

procedure Base64Lines;
const
  Bad: array[0..33] of string = ('', 'Zg==', 'Zg=', 'Zg', 'Zm8=', 'Zm8', 'Zm9v', 'Zm9vYg==', 'Zm9vYg',
    'Zm9v'#13#10'YmFy', 'Zm9v YmFy', 'Zm=v', 'Z===', '====', 'Zg==Zg==', 'Zh==', 'Zm9vYmE=', 'Zm9vYmE', 'Zm9vYmFy',
    '-_-_', '+/+/', 'Zg=='#10, 'Zg='#10'=', 'Zg==x', 'A', 'AA', 'AAA', 'AAAA', 'AAAAA', 'Zm9vYg=', 'Zm9vYg===',
    'Z'#10'g==', '=Zg=', 'Zg'#13#10'=='#13#10);
var
  v, n, i, ok: Integer;
  url, pad: Boolean;
  b, s, d: string;
begin
  for v := 0 to 3 do
  begin
    url := v >= 2;
    pad := (v = 0) or (v = 2);
    GS := 1;
    FnvNew;
    ok := 0;
    for n := 0 to 300 do
    begin
      b := RandBytes(n);
      s := Base64Encode(b, url, pad);
      FnvAdd(s);
      if Base64Decode(s, url, pad, d) and (d = b) then
        ok := ok + 1;
    end;
    WriteLn('b64 ', v, ' ', Hex16(FH), ' roundtrip ', ok);
  end;
  for v := 0 to 3 do
  begin
    url := v >= 2;
    pad := (v = 0) or (v = 2);
    for i := 0 to High(Bad) do
      if Base64Decode(Bad[i], url, pad, d) then
        WriteLn('b64d ', v, ' ', i, ' ok ', Hex(d))
      else
        WriteLn('b64d ', v, ' ', i, ' err');
  end;
end;

{ ---- url ---- }

procedure UrlLines;
const
  Un: array[0..15] of string = ('', 'abc', 'a%20b', 'a+b', '%', '%4', '%zz', '%41%42', 'a%2', '%C3%A9', '%00',
    '100%', '%%41', '%4g', '+%2B+', '%2b');
var
  c, k, n, rt, i: Integer;
  fq, fp: Integer;
  s, q, p, a, b: string;
  qs, ps: string;
begin
  GS := 2;
  FnvNew;
  for c := 0 to 255 do
    FnvAdd(UrlQueryEscape(Chr(c)));
  fq := FH;
  FnvNew;
  for c := 0 to 255 do
    FnvAdd(UrlPathEscape(Chr(c)));
  fp := FH;
  WriteLn('url bytes ', Hex16(fq), ' ', Hex16(fp));
  rt := 0;
  FnvNew;
  fq := FH;
  FnvNew;
  fp := FH;
  for k := 0 to 2999 do
  begin
    n := (GNext shr 40) mod 31;
    s := RandBytes(n);
    q := UrlQueryEscape(s);
    p := UrlPathEscape(s);
    FH := fq;
    FnvAdd(q);
    fq := FH;
    FH := fp;
    FnvAdd(p);
    fp := FH;
    if UrlQueryUnescape(q, a) and UrlPathUnescape(p, b) and (a = s) and (b = s) then
      rt := rt + 1;
  end;
  WriteLn('url random ', Hex16(fq), ' ', Hex16(fp), ' roundtrip ', rt);
  for i := 0 to 15 do
  begin
    if UrlQueryUnescape(Un[i], a) then
      qs := 'ok ' + Hex(a)
    else
      qs := 'err';
    if UrlPathUnescape(Un[i], b) then
      ps := 'ok ' + Hex(b)
    else
      ps := 'err';
    WriteLn('urlu ', i, ' q ', qs, ' p ', ps);
  end;
end;

{ ---- csv ---- }

type
  TOpt = record
    Name: string;
    Comma, Comment: Char;
    Lazy, Trim: Boolean;
    Fields: Integer;
  end;

var
  Opts: array[0..5] of TOpt;

procedure SetOpt(I: Integer; const AName: string; AComma, AComment: Char; ALazy, ATrim: Boolean; AFields: Integer);
begin
  Opts[I].Name := AName;
  Opts[I].Comma := AComma;
  Opts[I].Comment := AComment;
  Opts[I].Lazy := ALazy;
  Opts[I].Trim := ATrim;
  Opts[I].Fields := AFields;
end;

{ the outcome of reading Text under O, as the oracle prints it }
function CsvRun(const Text: string; const O: TOpt): string;
var
  r: TCsvReader;
  rec: TStringArray;
  i: Integer;
  done: Boolean;
begin
  Result := '';
  r := TCsvReader.Create(Text);
  r.Comma := O.Comma;
  r.Comment := O.Comment;
  r.LazyQuotes := O.Lazy;
  r.TrimLeadingSpace := O.Trim;
  r.FieldsPerRecord := O.Fields;
  done := False;
  while not done do
  begin
    try
      if not r.ReadRecord(rec) then
        Break;
    except
      on E: ECsvError do
      begin
        Result := Result + 'ERR ' + IntToStr(E.Kind) + ' ' + IntToStr(E.StartLine) + ' ' + IntToStr(E.Line) + ' ' +
          IntToStr(E.Column);
        if E.Kind = 3 then
          for i := 0 to High(rec) do
            Result := Result + ' ' + Hex(rec[i]);
        Break;
      end;
    end;
    for i := 0 to High(rec) do
    begin
      if i > 0 then
        Result := Result + ' ';
      Result := Result + Hex(rec[i]);
    end;
    Result := Result + ' | ';
  end;
end;

procedure CsvLines;
const
  Cases: array[0..30] of string = ('', 'a,b,c'#10, 'a,b,c', 'a,b,c'#13#10, '"a","b"'#10, '"a""b",c'#10,
    'a,"b'#10'c",d'#10'e,f,g'#10, 'a,b'#10#10'c,d'#10, 'a,"b'#13#10'c",d'#13#10, '"abc'#10, '"abc', 'a"b,c'#10,
    '"a"b,c'#10, 'a,b'#10'c'#10, '# c'#10'a,b'#10, 'a, b ,c'#10, ' "a",b'#10, '﻿a,b'#10, 'a,b'#13'c,d'#10,
    'a,b'#13, ',,'#10, '"",""'#10, 'a;b;c'#10, '"a" ,b'#10, '"a'#10'""'#10'b"'#10, 'x'#10'"', '"'#10, 'a,"b"'#10,
    'a,"b"c'#10, 'a,b'#10'"c'#10'd', '  '#10' a'#10);
  Alpha: array[0..12] of string = ('a', 'b', '"', '"', ',', ',', #10, #10, #13, ' ', '#', ';', 'xy');
  WAlpha: array[0..12] of string = ('a', 'b', '"', ',', #10, #13, ' ', '\.', 'é', ' ', ';', 'x', '');
var
  i, k, j, n, o, nf: Integer;
  s: string;
  f: Integer;
  fields: array of string;
  outp: string;
begin
  SetOpt(0, 'def', ',', #0, False, False, 0);
  SetOpt(1, 'lazy', ',', #0, True, False, 0);
  SetOpt(2, 'trim', ',', #0, False, True, 0);
  SetOpt(3, 'semi', ';', #0, False, False, -1);
  SetOpt(4, 'hash', ',', '#', False, False, -1);
  SetOpt(5, 'two', ',', #0, False, False, 2);
  for i := 0 to High(Cases) do
    for o := 0 to 5 do
      WriteLn('csv ', i, ' ', Opts[o].Name, ' ', CsvRun(Cases[i], Opts[o]));
  GS := 3;
  for o := 0 to 5 do
  begin
    FnvNew;
    f := FH;
    for k := 0 to 1499 do
    begin
      n := (GNext shr 40) mod 14;
      s := '';
      for j := 1 to n do
        s := s + Alpha[(GNext shr 40) mod 13];
      outp := CsvRun(s, Opts[o]);
      FH := f;
      FnvAdd(outp);
      f := FH;
    end;
    WriteLn('csv random ', Opts[o].Name, ' ', Hex16(f));
  end;
  GS := 4;
  FnvNew;
  for k := 0 to 1999 do
  begin
    nf := 1 + (GNext shr 40) mod 4;
    SetLength(fields, nf);
    for j := 0 to nf - 1 do
    begin
      n := (GNext shr 40) mod 4;
      fields[j] := '';
      for i := 1 to n do
        fields[j] := fields[j] + WAlpha[(GNext shr 40) mod 13];
    end;
    FnvAdd(CsvLine(fields, ',', False));
    FnvAdd(CsvLine(fields, ';', True));
  end;
  WriteLn('csv writer ', Hex16(FH));
end;

{ ---- letters ---- }

function RuneStr(R: Integer): string;
begin
  if R < $80 then
    Result := Chr(R)
  else if R < $800 then
    Result := Chr($C0 or (R shr 6)) + Chr($80 or (R and $3F))
  else
    Result := Chr($E0 or (R shr 12)) + Chr($80 or ((R shr 6) and $3F)) + Chr($80 or (R and $3F));
end;

procedure LetterLines;
const
  Pool: array[0..19] of Integer = (97, 90, 32, 48, $E9, $D1, $FC, $DF, $E7, $C1, $FF, $178, $152, $142, $130,
    $131, $17F, $20AC, $4E2D, 10);
var
  r, k, n, j: Integer;
  s: string;
  fu, fl, ff: Integer;
begin
  GS := 5;
  FnvNew;
  fu := FH;
  fl := FH;
  ff := FH;
  for r := 0 to $17F do
  begin
    s := RuneStr(r);
    FH := fu;
    FnvAdd(UpperText(s));
    fu := FH;
    FH := fl;
    FnvAdd(LowerText(s));
    fl := FH;
    FH := ff;
    FnvAdd(FoldAccents(s));
    ff := FH;
  end;
  WriteLn('letters all ', Hex16(fu), ' ', Hex16(fl), ' ', Hex16(ff));
  FnvNew;
  fu := FH;
  fl := FH;
  ff := FH;
  for k := 0 to 1999 do
  begin
    n := (GNext shr 40) mod 12;
    s := '';
    for j := 1 to n do
      s := s + RuneStr(Pool[(GNext shr 40) mod 20]);
    FH := fu;
    FnvAdd(UpperText(s));
    fu := FH;
    FH := fl;
    FnvAdd(LowerText(s));
    fl := FH;
    FH := ff;
    FnvAdd(FoldAccents(s));
    ff := FH;
  end;
  WriteLn('letters random ', Hex16(fu), ' ', Hex16(fl), ' ', Hex16(ff));
  WriteLn('spanish ', Hex(UpperText('Ñandú, camión, pingüino, ¿qué?')), ' ', Hex(LowerText('ÑANDÚ, CAMIÓN, PINGÜINO')), ' ',
    Hex(FoldAccents('Ñandú, camión, pingüino, ¿qué? Ça va, Œuvre, Łódź')));
end;

begin
  Base64Lines;
  UrlLines;
  CsvLines;
  LetterLines;
end.

