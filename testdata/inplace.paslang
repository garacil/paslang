program inplace;

{ d := d op x for an element, a field or a dereference changes the memory
  in place at its width (P100, 1.0.95): a Byte wraps, a neighbour stays,
  the address is worked out once. }

type
  PCell = ^TCell;
  TCell = record
    B: Byte;
    W: Word;
    S: Int8;
    N: Integer;
  end;

var
  bytes: array[0..3] of Byte;
  words: array[0..3] of Word;
  s8: array[0..3] of Int8;
  ints: array[0..3] of Integer;
  hist: array[0..255] of Integer;
  data: array of Byte;
  c: PCell;
  i, k: Integer;
  b: Byte;

begin
  for i := 0 to 3 do
  begin
    bytes[i] := 250;
    words[i] := 65530;
    s8[i] := 120;
    ints[i] := 7;
  end;
  bytes[1] := bytes[1] + 10;
  bytes[2] := bytes[2] - 251;
  words[1] := words[1] + 10;
  s8[1] := s8[1] + 10;
  ints[1] := ints[1] + 5;
  ints[2] := ints[2] - 9;
  ints[3] := ints[3] xor 2;
  bytes[3] := bytes[3] and 15;
  words[3] := words[3] or 5;
  b := 7;
  k := 1000;
  bytes[0] := bytes[0] + b;
  ints[0] := ints[0] + k;
  WriteLn(bytes[0], ' ', bytes[1], ' ', bytes[2], ' ', bytes[3]);
  WriteLn(words[0], ' ', words[1], ' ', words[3]);
  WriteLn(s8[0], ' ', s8[1], ' ', s8[2]);
  WriteLn(ints[0], ' ', ints[1], ' ', ints[2], ' ', ints[3]);
  New(c);
  c^.B := 255;
  c^.W := 1;
  c^.S := -128;
  c^.N := 10;
  c^.B := c^.B + 1;
  c^.W := c^.W - 2;
  c^.S := c^.S - 1;
  c^.N := c^.N + c^.N;
  WriteLn(c^.B, ' ', c^.W, ' ', c^.S, ' ', c^.N);
  SetLength(data, 1000);
  for i := 0 to 999 do
    data[i] := Byte(i * 7);
  for i := 0 to 999 do
    hist[data[i]] := hist[data[i]] + 1;
  k := 0;
  for i := 0 to 255 do
    k := k + hist[i] * i;
  WriteLn(k, ' ', hist[0], ' ', hist[7]);
end.
