{ map[K] of V: New, insert, read, overwrite, Length, growth past 13
  entries and past 100000 entries, and the zero value of a missing key. }
program map1;

var
  m: map[string] of Integer;
  n: map[Integer] of Integer;
  e: map[string] of string;
  i, total: Integer;
  s, key: string;

begin
  WriteLn(Length(m));            { a nil map has no entries }
  WriteLn(m['none']);            { and every key reads as zero }
  WriteLn('none' in m);
  New(m);
  m['one'] := 1;
  m['two'] := 2;
  m['three'] := 3;
  WriteLn(Length(m), ' ', m['one'], ' ', m['two'], ' ', m['three'], ' ', m['missing']);
  m['one'] := 11;                { an overwrite keeps one entry }
  WriteLn(Length(m), ' ', m['one']);
  key := '';
  for i := 1 to 40 do            { past 13 entries the table grows }
  begin
    key := key + 'x';
    m[key] := i * 10;
  end;
  key := '';
  total := 0;
  for i := 1 to 40 do
  begin
    key := key + 'x';
    total := total + m[key];
  end;
  WriteLn(Length(m), ' ', total);
  New(n, 1000);                  { a size hint is optional }
  for i := 1 to 100000 do
    n[i * 7919] := i;
  total := 0;
  for i := 1 to 100000 do
    total := total + n[i * 7919];
  WriteLn(Length(n), ' ', total, ' ', n[5]);
  New(e);
  e['a'] := 'alpha';
  e['a'] := e['a'] + '!';        { read, change, write back }
  s := e['b'];                   { a missing string is empty }
  WriteLn(e['a'], ' [', s, '] ', Length(e));
end.

