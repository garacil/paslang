program fpbaselinedirectdouble;
var X: Double;
begin
  X := ($3FF0000000000000 as Double) + ($3FF0000000000000 as Double);
  if (X as Integer) <> $4000000000000000 then
  begin WriteLn('direct Double: ', X as Integer, ' <> ', $4000000000000000); Halt(88); end;
  WriteLn('ok FP direct Double');
end.
