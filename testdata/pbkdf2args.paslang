program pbkdf2args;

var Trace: Integer;

function TextArg(Tag: Integer; const S: string): string;
begin
  Trace := Trace * 10 + Tag;
  Result := S;
end;

function IntArg(Tag, V: Integer): Integer;
begin
  Trace := Trace * 10 + Tag;
  Result := V;
end;

function Nested: string;
begin
  Result := Pbkdf2HmacSha1(TextArg(1, 'password'), TextArg(2, 'salt'),
    IntArg(3, 2), IntArg(4, 20));
end;

var D, E: string; C: Char;
begin
  Trace := 0;
  D := Nested;
  if (Trace <> 1234) or (Hex(D) <> 'ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957') then Halt(127);
  Trace := 0;
  D := Pbkdf2HmacSha256(TextArg(1, 'passwd'), TextArg(2, 'salt'),
    IntArg(3, 1), IntArg(4, 64));
  if (Trace <> 1234) or (Hex(D) <> '55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783') then Halt(127);
  Trace := 0;
  D := Pbkdf2HmacSha1(TextArg(1, 'p'), TextArg(2, 's'), IntArg(3, 0), IntArg(4, 20));
  if (Trace <> 1234) or (D <> '') then Halt(127);
  { Char arguments use the normal conversion to a one-byte string. }
  C := #0;
  D := Pbkdf2HmacSha1(C, C, 2, 21);
  E := Pbkdf2HmacSha1(#0, #0, 2, 21);
  if D <> E then Halt(127);
  WriteLn('ok PBKDF2 argument evaluation');
end.

