program mapiter;

{ P257: the loops over a map. A for loop takes the slots of one group
  of a table at a time (the full ones of its control word, from a random
  slot, each once) and the groups of a table from a random one; this
  checks what the loop must be whatever the order is: every key once and
  only once, with its value, at every size round the groups' and tables'
  limits (8, 16, 1024 slots, the splits of a map of 100,000 keys), after
  deletes that leave tombstones, with the keys of both sorts and the keys
  and values of every size the loop variables can be (a byte, a half, a
  word, a double word, two words, a Double, a string, a record of three
  words and an array of three bytes, which are copied by registers or by
  rt_memcpy), when the loop deletes keys it has not reached (they do not
  come), when it inserts keys until the map splits and grows under it
  (the keys it started with come once, with the value the map holds),
  loops inside loops, and loops left by Break and Continue. The expected
  lines are worked out by scripts/gen_mapiter.py. }

uses sysutils;

type
  TIM = map[Integer] of Integer;
  TBW = map[Byte] of Word;
  TLL = map[Int32] of Int32;
  TID = map[Integer] of Double;
  TSS = map[string] of string;
  TSI = map[string] of Integer;
  TIS = map[Integer] of string;
  TR8 = record
    A: Integer;
  end;
  TR16 = record
    A, B: Integer;
  end;
  TR24 = record
    A, B, C: Integer;
  end;
  TB3 = array[0..2] of Byte;
  TIR8 = map[Integer] of TR8;
  TIR16 = map[Integer] of TR16;
  TIR24 = map[Integer] of TR24;
  TIB3 = map[Integer] of TB3;

function Key(i: Integer): Integer;
begin
  Result := i * 7919 + 13;
end;

function Index(k: Integer): Integer;
begin
  Result := (k - 13) div 7919;
end;

{ every key of a map of n keys once, with its value }
procedure Whole(const Tag: string; n, step: Integer; Del: Boolean);
var
  m: TIM;
  i, k, v, cnt, sk, sv, dups, bad: Integer;
  seen: array of Boolean;
begin
  New(m);
  for i := 0 to n - 1 do
    m[Key(i)] := i xor 5;
  if Del then
    for i := 0 to n - 1 do
      if ((i * 2654435761) shr 7) mod step < 2 then
        Delete(m, Key(i));
  SetLength(seen, n + 1);
  cnt := 0;
  sk := 0;
  sv := 0;
  dups := 0;
  bad := 0;
  for k, v in m do
  begin
    i := Index(k);
    if (i < 0) or (i >= n) then
      bad := bad + 1
    else
    begin
      if seen[i] then
        dups := dups + 1;
      seen[i] := True;
      if v <> (i xor 5) then
        bad := bad + 1;
    end;
    cnt := cnt + 1;
    sk := sk + k;
    sv := sv + v;
  end;
  WriteLn(Tag, ' n=', n, ' len=', Length(m), ' count=', cnt, ' sumk=', sk, ' sumv=', sv, ' dups=', dups,
    ' bad=', bad);
end;

procedure Sizes;
const
  N: array[0..37] of Integer = (0, 1, 2, 3, 7, 8, 9, 15, 16, 17, 63, 64, 65, 100, 127, 128, 129, 200, 255,
    256, 257, 500, 511, 512, 513, 1000, 1023, 1024, 1025, 2000, 2047, 2048, 2049, 4096, 5000, 9999, 20000, 100000);
var
  j: Integer;
begin
  for j := 0 to 37 do
    Whole('plain', N[j], 0, False);
  for j := 0 to 37 do
    Whole('del', N[j], 5, True);
  for j := 0 to 37 do
    Whole('del2', N[j], 3, True);
end;

{ a loop that deletes the partner of the key it is at: of each pair only
  the first reached comes }
procedure Partners(n: Integer);
var
  m: TIM;
  i, j, k, v, cnt: Integer;
begin
  New(m);
  for i := 0 to n - 1 do
    m[Key(i)] := i;
  cnt := 0;
  for k, v in m do
  begin
    cnt := cnt + 1;
    j := Index(k) xor 1;
    if j < n then
      Delete(m, Key(j));
  end;
  WriteLn('partners n=', n, ' visited=', cnt, ' left=', Length(m));
end;

{ a loop that deletes the key it is at }
procedure Eaten(n: Integer);
var
  m: TIM;
  i, k, v, cnt: Integer;
begin
  New(m);
  for i := 0 to n - 1 do
    m[Key(i)] := i;
  cnt := 0;
  for k, v in m do
  begin
    cnt := cnt + 1;
    Delete(m, k);
  end;
  WriteLn('eaten n=', n, ' visited=', cnt, ' left=', Length(m));
end;

{ a loop that inserts a key at each step: the tables split and grow
  under it }
procedure Grows(n: Integer);
var
  m: TIM;
  i, k, v, cnt, dups, bad, ins: Integer;
  seen: array of Boolean;
begin
  New(m);
  for i := 0 to n - 1 do
    m[Key(i)] := i;
  SetLength(seen, n + 1);
  cnt := 0;
  dups := 0;
  bad := 0;
  ins := 0;
  for k, v in m do
  begin
    i := Index(k);
    if i < n then
    begin
      cnt := cnt + 1;
      if seen[i] then
        dups := dups + 1;
      seen[i] := True;
      if v <> m[k] then
        bad := bad + 1;
    end;
    ins := ins + 1;
    m[Key(n + ins)] := n + ins;
  end;
  WriteLn('grows n=', n, ' original=', cnt, ' dups=', dups, ' bad=', bad, ' lenok=', Length(m) = n + ins);
end;

{ a loop that rewrites every value: the loop's value is the map's }
procedure Rewrites(n: Integer);
var
  m: TIM;
  i, j, k, v, bad, cnt: Integer;
begin
  New(m);
  for i := 0 to n - 1 do
    m[Key(i)] := i;
  bad := 0;
  cnt := 0;
  for k, v in m do
  begin
    if v <> m[k] then
      bad := bad + 1;
    cnt := cnt + 1;
    j := Index(k) xor 1;
    if j < n then
      m[Key(j)] := 1000000 + Index(k);
  end;
  WriteLn('rewrites n=', n, ' visited=', cnt, ' bad=', bad);
end;

{ Random operations on a map and on a model of it (an array of flags and
  values), and loops that delete and insert keys while they walk it: a key
  comes at most once (a key deleted and put back may come again), never
  while it is deleted, with the value the map holds, and a key that was
  there when the loop began and was not deleted since comes. }
var
  Seed: Integer;

function Rnd(n: Integer): Integer;
begin
  Seed := Seed * 6364136223846793005 + 1442695040888963407;
  Result := (Seed shr 33) mod n;
end;

procedure Fuzz(rounds: Integer);
const
  Space = 3000;
var
  m: TIM;
  here, was, gone, seen: array of Boolean;
  cur: array of Integer;
  r, i, j, k, v, n, ops, loops, visits, dups, stale, wrong, missing, size: Integer;
begin
  SetLength(here, Space);
  SetLength(was, Space);
  SetLength(gone, Space);
  SetLength(seen, Space);
  SetLength(cur, Space);
  dups := 0;
  stale := 0;
  wrong := 0;
  missing := 0;
  visits := 0;
  loops := 0;
  Seed := 12345;
  for r := 1 to rounds do
  begin
    New(m);
    for i := 0 to Space - 1 do
      here[i] := False;
    case Rnd(4) of
      0: size := Rnd(10);
      1: size := Rnd(40);
      2: size := Rnd(400);
    else
      size := Rnd(Space);
    end;
    for n := 1 to size do
    begin
      i := Rnd(Space);
      here[i] := True;
      cur[i] := Rnd(1000000);
      m[Key(i)] := cur[i];
    end;
    { some deletes before the loops, tombstones }
    for n := 1 to size div 3 do
    begin
      i := Rnd(Space);
      if here[i] then
      begin
        here[i] := False;
        Delete(m, Key(i));
      end;
    end;
    for loops := 1 to 3 do
    begin
      for i := 0 to Space - 1 do
      begin
        was[i] := here[i];
        gone[i] := False;
        seen[i] := False;
      end;
      ops := Rnd(4);
      for k, v in m do
      begin
        i := Index(k);
        visits := visits + 1;
        if (i < 0) or (i >= Space) then
          wrong := wrong + 1
        else
        begin
          if seen[i] then
            dups := dups + 1;
          seen[i] := True;
          if not here[i] then
            stale := stale + 1
          else if v <> cur[i] then
            wrong := wrong + 1;
        end;
        if ops = 1 then
        begin
          j := Rnd(Space);
          if here[j] then
          begin
            here[j] := False;
            gone[j] := True;
            seen[j] := False;
            Delete(m, Key(j));
          end;
        end
        else if ops = 2 then
        begin
          j := Rnd(Space);
          if not here[j] then
          begin
            here[j] := True;
            cur[j] := Rnd(1000000);
            m[Key(j)] := cur[j];
          end
          else
          begin
            cur[j] := Rnd(1000000);
            m[Key(j)] := cur[j];
          end;
        end
        else if ops = 3 then
        begin
          j := Rnd(Space);
          if here[j] and (Rnd(2) = 0) then
          begin
            here[j] := False;
            gone[j] := True;
            seen[j] := False;
            Delete(m, Key(j));
          end
          else if not here[j] then
          begin
            here[j] := True;
            cur[j] := Rnd(1000000);
            m[Key(j)] := cur[j];
          end;
        end;
      end;
      for i := 0 to Space - 1 do
        if was[i] and (not gone[i]) and (not seen[i]) then
          missing := missing + 1;
      if Length(m) <> 0 then
      begin
        n := 0;
        for i := 0 to Space - 1 do
          if here[i] then
            n := n + 1;
        if n <> Length(m) then
          wrong := wrong + 1;
      end;
    end;
  end;
  WriteLn('fuzz rounds=', rounds, ' stale=', stale, ' dups=', dups, ' wrong=', wrong, ' missing=', missing,
    ' ', visits > rounds * 10);
end;

procedure Nested;
var
  m: TIM;
  i, j, k, v, k2, v2, cnt: Integer;
begin
  New(m);
  for i := 0 to 199 do
    m[Key(i)] := i;
  cnt := 0;
  for k, v in m do
    for k2, v2 in m do
      cnt := cnt + 1;
  WriteLn('nested visited=', cnt);
  j := 0;
  for k, v in m do
    for i := 1 to 2 do
      for k2, v2 in m do
        if k2 = k then
          j := j + 1;
  WriteLn('nested3 matches=', j);
end;

procedure Leaves;
var
  m: TIM;
  i, k, v, cnt, r: Integer;
begin
  New(m);
  for i := 0 to 999 do
    m[Key(i)] := i;
  for r := 1 to 3 do
  begin
    cnt := 0;
    for k, v in m do
    begin
      cnt := cnt + 1;
      if cnt = 3 then
        Break;
    end;
    WriteLn('break ', r, ' ', cnt);
  end;
  cnt := 0;
  for k, v in m do
    cnt := cnt + 1;
  WriteLn('whole ', cnt);
  cnt := 0;
  for k, v in m do
  begin
    if Index(k) mod 2 = 1 then
      Continue;
    cnt := cnt + 1;
  end;
  WriteLn('continue ', cnt);
end;

procedure Empty;
var
  m: TIM;
  k, v, cnt: Integer;
begin
  m := nil;
  cnt := 0;
  for k, v in m do
    cnt := cnt + 1;
  WriteLn('nil ', cnt);
  New(m);
  for k, v in m do
    cnt := cnt + 1;
  WriteLn('empty ', cnt);
  m[5] := 6;
  Delete(m, 5);
  for k, v in m do
    cnt := cnt + 1;
  WriteLn('emptied ', cnt);
  m[5] := 6;
  Clear(m);
  for k, v in m do
    cnt := cnt + 1;
  WriteLn('cleared ', cnt);
end;

procedure Narrow;
var
  mb: TBW;
  ml: TLL;
  md: TID;
  b: Byte;
  w: Word;
  l, l2: Int32;
  d: Double;
  i, k, cnt, sk, sv: Integer;
  sd: Double;
begin
  New(mb);
  for i := 0 to 199 do
    mb[Byte(i)] := Word(i * 300 + 7);
  cnt := 0;
  sk := 0;
  sv := 0;
  for b, w in mb do
  begin
    cnt := cnt + 1;
    sk := sk + b;
    sv := sv + w;
  end;
  WriteLn('byte word ', cnt, ' ', sk, ' ', sv);
  New(ml);
  for i := 0 to 499 do
    ml[Int32(i * 1000 - 250000)] := Int32(i * 3 - 700);
  cnt := 0;
  sk := 0;
  sv := 0;
  for l, l2 in ml do
  begin
    cnt := cnt + 1;
    sk := sk + l;
    sv := sv + l2;
  end;
  WriteLn('int32 int32 ', cnt, ' ', sk, ' ', sv);
  New(md);
  for i := 0 to 299 do
    md[Key(i)] := i * 0.5;
  cnt := 0;
  sk := 0;
  sd := 0;
  for k, d in md do
  begin
    cnt := cnt + 1;
    sk := sk + k;
    sd := sd + d;
  end;
  WriteLn('int double ', cnt, ' ', sk, ' ', sd:0:1);
end;

procedure Strings;
var
  m: TSS;
  mi: TSI;
  ms: TIS;
  i, v, cnt, bad, sv, n, k: Integer;
  ks, vs: string;
begin
  New(m);
  New(mi);
  New(ms);
  for i := 0 to 599 do
  begin
    m['key' + IntToStr(i)] := 'key' + IntToStr(i) + '!';
    mi['key' + IntToStr(i)] := i;
    ms[Key(i)] := 'v' + IntToStr(Key(i));
  end;
  cnt := 0;
  bad := 0;
  n := 0;
  for ks, vs in m do
  begin
    cnt := cnt + 1;
    if vs <> ks + '!' then
      bad := bad + 1;
    n := n + Length(ks);
  end;
  WriteLn('string string ', cnt, ' ', bad, ' ', n);
  cnt := 0;
  sv := 0;
  bad := 0;
  for ks, v in mi do
  begin
    cnt := cnt + 1;
    sv := sv + v;
    if ks <> 'key' + IntToStr(v) then
      bad := bad + 1;
  end;
  WriteLn('string int ', cnt, ' ', bad, ' ', sv);
  cnt := 0;
  bad := 0;
  for k, vs in ms do
  begin
    cnt := cnt + 1;
    if vs <> 'v' + IntToStr(k) then
      bad := bad + 1;
  end;
  WriteLn('int string ', cnt, ' ', bad);
end;

procedure Records;
var
  m8: TIR8;
  m16: TIR16;
  m24: TIR24;
  m3: TIB3;
  r8: TR8;
  r16: TR16;
  r24: TR24;
  b3: TB3;
  i, k, cnt, s1, s2, s3: Integer;
begin
  New(m8);
  New(m16);
  New(m24);
  New(m3);
  for i := 0 to 299 do
  begin
    r8.A := i * 3;
    m8[Key(i)] := r8;
    r16.A := i * 5;
    r16.B := i * 7;
    m16[Key(i)] := r16;
    r24.A := i * 11;
    r24.B := i * 13;
    r24.C := i * 17;
    m24[Key(i)] := r24;
    b3[0] := Byte(i);
    b3[1] := Byte(i * 2);
    b3[2] := Byte(i * 3);
    m3[Key(i)] := b3;
  end;
  cnt := 0;
  s1 := 0;
  for k, r8 in m8 do
  begin
    cnt := cnt + 1;
    s1 := s1 + k + r8.A;
  end;
  WriteLn('rec8 ', cnt, ' ', s1);
  cnt := 0;
  s1 := 0;
  s2 := 0;
  for k, r16 in m16 do
  begin
    cnt := cnt + 1;
    s1 := s1 + r16.A;
    s2 := s2 + r16.B;
  end;
  WriteLn('rec16 ', cnt, ' ', s1, ' ', s2);
  cnt := 0;
  s1 := 0;
  s2 := 0;
  s3 := 0;
  for k, r24 in m24 do
  begin
    cnt := cnt + 1;
    s1 := s1 + r24.A;
    s2 := s2 + r24.B;
    s3 := s3 + r24.C;
  end;
  WriteLn('rec24 ', cnt, ' ', s1, ' ', s2, ' ', s3);
  cnt := 0;
  s1 := 0;
  s2 := 0;
  s3 := 0;
  for k, b3 in m3 do
  begin
    cnt := cnt + 1;
    s1 := s1 + b3[0];
    s2 := s2 + b3[1];
    s3 := s3 + b3[2];
  end;
  WriteLn('bytes3 ', cnt, ' ', s1, ' ', s2, ' ', s3);
end;

begin
  Sizes;
  Partners(0);
  Partners(1);
  Partners(2);
  Partners(9);
  Partners(100);
  Partners(1001);
  Partners(5000);
  Eaten(0);
  Eaten(7);
  Eaten(8);
  Eaten(9);
  Eaten(1000);
  Eaten(5000);
  Grows(1);
  Grows(5);
  Grows(8);
  Grows(9);
  Grows(100);
  Grows(1000);
  Grows(3000);
  Rewrites(0);
  Rewrites(8);
  Rewrites(9);
  Rewrites(1000);
  Rewrites(3000);
  Fuzz(300);
  Nested;
  Leaves;
  Empty;
  Narrow;
  Strings;
  Records;
end.
