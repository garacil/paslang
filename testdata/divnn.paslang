program divnn;

{ P536: div and mod by a constant of a value that cannot be negative }

function da1(x: Integer): Integer;
begin
  Result := (x and 255) div 2;
end;

function ra1(x: Integer): Integer;
begin
  Result := (x and 255) mod 2;
end;

