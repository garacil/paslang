program dirlist;

uses
  paslib;

function HasEntry(const All, Name: string): Boolean;
var
  i, n: Integer;
  line: string;
begin
  Result := False;
  n := Length(All);
  i := 1;
  line := '';
  while i <= n do
  begin
    if All[i] = #10 then
    begin
      if line = Name then
      begin
        Result := True;
        Exit;
      end;
      line := '';
    end
    else
      line := line + All[i];
    Inc(i);
  end;
end;

var
  names: string;

begin
  names := ListDir('testdata');
  if HasEntry(names, 'hello.paslang') then
    WriteLn('ok hello.paslang');
  if HasEntry(names, 'args8.paslang') then
    WriteLn('ok args8.paslang');
  if FileSize('testdata/hello.paslang') > 0 then
    WriteLn('ok stat');
end.

