{ P364: for x in E over a static array takes E once when E calls
  something: a function, an element of a function's array, an element a
  call picks and a method; a variable is read where it is, so a pass
  sees what the passes before it wrote there. }
program forinonce;

type
  TArr = array[0..3] of Integer;
  TGrid = array[0..2] of TArr;

  TBag = class
    Items: TArr;
    Asked: Integer;
    function Get: TArr;
  end;

var
  calls, picks, x, s, i, j, k: Integer;
  grid: TGrid;
  live: TArr;
  bag: TBag;

function Make(K: Integer): TArr;
var
  n: Integer;
begin
  Inc(calls);
  for n := 0 to 3 do
    Result[n] := K * 10 + n;
end;

function MakeGrid: TGrid;
var
  a, b: Integer;
begin
  Inc(calls);
  for a := 0 to 2 do
    for b := 0 to 3 do
      Result[a][b] := a * 100 + b;
end;

function Pick: Integer;
begin
  Inc(picks);
  Result := 1;
end;

function TBag.Get: TArr;
begin
  Inc(Asked);
  Result := Items;
end;

begin
  calls := 0;
  s := 0;
  for x in Make(3) do
    s := s + x;
  WriteLn('function ', s, ' ', calls);
  calls := 0;
  s := 0;
  for x in MakeGrid[2] do
    s := s + x;
  WriteLn('element ', s, ' ', calls);
  for i := 0 to 2 do
    for j := 0 to 3 do
      grid[i][j] := i * 1000 + j;
  picks := 0;
  s := 0;
  for x in grid[Pick] do
    s := s + x;
  WriteLn('picked ', s, ' ', picks);
  bag := TBag.Create;
  for i := 0 to 3 do
    bag.Items[i] := i + 1;
  s := 0;
  for x in bag.Get do
    s := s + x;
  WriteLn('method ', s, ' ', bag.Asked);
  for i := 0 to 3 do
    live[i] := 1;
  s := 0;
  k := 0;
  for x in live do
  begin
    s := s + x;
    if k < 3 then
      live[k + 1] := live[k + 1] + 10;
    Inc(k);
  end;
  WriteLn('variable ', s);
end.

