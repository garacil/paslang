{ P211: a typed decode reserves an array at the length StCount counts
  when the reader's window holds it within JsonCountMax (2048) entries,
  and grows it as it reads it otherwise. Arrays of integers of every
  length around the bound and past it, one that crosses the window of
  64 KiB, arrays of arrays, records with strings and an array of them
  past the window, each read back whole: its length, its sum, its last
  element. }
program jsondecgrow;

uses SysUtils;

type
  TItem = record
    Name: string json 'name';
    Vals: array of Integer json 'vals';
  end;
  TBox = record
    Ints: array of Integer json 'ints';
    Rows: array of array of Integer json 'rows';
    Items: array of TItem json 'items';
  end;

var
  lens: array[0..8] of Integer = (0, 1, 2, 1023, 2046, 2047, 2048, 2049, 20000);
  k, i, j, n: Integer;
  s, pad: string;
  a: array of Integer;
  box: TBox;
  sum: Int64;

function IntArray(N: Integer): string;
var
  i: Integer;
begin
  Result := '[';
  for i := 0 to N - 1 do
  begin
    if i > 0 then
      Result := Result + ',';
    Result := Result + IntToStr(i * 3);
  end;
  Result := Result + ']';
end;

procedure ShowInts(const Name: string; const A: array of Integer);
var
  i: Integer;
  t: Int64;
begin
  t := 0;
  for i := 0 to High(A) do
    t := t + A[i];
  Write(Name, ' ', Length(A), ' sum ', t);
  if Length(A) > 0 then
    Write(' last ', A[High(A)]);
  WriteLn;
end;

begin
  { arrays of integers around the bound and past it }
  for k := 0 to High(lens) do
  begin
    JsonDecode(IntArray(lens[k]), a);
    ShowInts('ints', a);
  end;
  { one that crosses the window: 40 KiB of blanks before it }
  pad := '';
  for i := 1 to 40000 do
    pad := pad + ' ';
  JsonDecode(pad + IntArray(9000) + pad, a);
  ShowInts('ints past the window', a);

  { arrays of arrays, records with strings, an array of them past the window }
  s := '{"ints":' + IntArray(3000) + ',"rows":[';
  for i := 0 to 99 do
  begin
    if i > 0 then
      s := s + ',';
    s := s + IntArray(i * 30);
  end;
  s := s + '],"items":[';
  for i := 0 to 2999 do
  begin
    if i > 0 then
      s := s + ',';
    s := s + '{"name":"item' + IntToStr(i) + '","vals":' + IntArray(i mod 7) + '}';
  end;
  s := s + ']}';
  WriteLn('text ', Length(s), ' bytes');
  JsonDecode(s, box);
  ShowInts('box ints', box.Ints);
  n := 0;
  sum := 0;
  for i := 0 to High(box.Rows) do
  begin
    n := n + Length(box.Rows[i]);
    for j := 0 to High(box.Rows[i]) do
      sum := sum + box.Rows[i][j];
  end;
  WriteLn('rows ', Length(box.Rows), ' elements ', n, ' sum ', sum);
  n := 0;
  sum := 0;
  for i := 0 to High(box.Items) do
  begin
    n := n + Length(box.Items[i].Vals);
    for j := 0 to High(box.Items[i].Vals) do
      sum := sum + box.Items[i].Vals[j];
  end;
  WriteLn('items ', Length(box.Items), ' vals ', n, ' sum ', sum, ' last ',
    box.Items[High(box.Items)].Name);
end.
