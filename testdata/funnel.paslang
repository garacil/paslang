program funnel;

{ FunnelLeft and FunnelRight (P509): the operands and the count in every
  form, a count the compiler can prove lies in 0..63 and the ones that only
  look as if it did. Each procedure folds 133 counts over 8 pairs of values
  into one hash a form and writes one line; the hashes are the ones
  scripts/gen_funnel.py works out from the meaning of the words. }

var
  HS: array[0..31] of Int64;
  SCounts: array[0..9] of Integer;
  PHInt64, PLInt64: array[0..7] of Int64;
  GHInt64, GLInt64: Int64;
  PHInt32, PLInt32: array[0..7] of Int32;
  GHInt32, GLInt32: Int32;
  PHUInt32, PLUInt32: array[0..7] of UInt32;
  GHUInt32, GLUInt32: UInt32;
  PHInt16, PLInt16: array[0..7] of Int16;
  GHInt16, GLInt16: Int16;
  PHWord, PLWord: array[0..7] of Word;
  GHWord, GLWord: Word;
  PHInt8, PLInt8: array[0..7] of Int8;
  GHInt8, GLInt8: Int8;
  PHByte, PLByte: array[0..7] of Byte;
  GHByte, GLByte: Byte;

function IdI(x: Int64; d: Integer): Int64;
begin
  if d <= 0 then
    Result := x
  else
    Result := IdI(x, d - 1);
end;

function IdTInt64(x: Int64; d: Integer): Int64;
begin
  if d <= 0 then
    Result := x
  else
    Result := IdTInt64(x, d - 1);
end;

function IdTInt32(x: Int32; d: Integer): Int32;
begin
  if d <= 0 then
    Result := x
  else
    Result := IdTInt32(x, d - 1);
end;

function IdTUInt32(x: UInt32; d: Integer): UInt32;
begin
  if d <= 0 then
    Result := x
  else
    Result := IdTUInt32(x, d - 1);
end;

function IdTInt16(x: Int16; d: Integer): Int16;
begin
  if d <= 0 then
    Result := x
  else
    Result := IdTInt16(x, d - 1);
end;

function IdTWord(x: Word; d: Integer): Word;
begin
  if d <= 0 then
    Result := x
  else
    Result := IdTWord(x, d - 1);
end;

function IdTInt8(x: Int8; d: Integer): Int8;
begin
  if d <= 0 then
    Result := x
  else
    Result := IdTInt8(x, d - 1);
end;

function IdTByte(x: Byte; d: Integer): Byte;
begin
  if d <= 0 then
    Result := x
  else
    Result := IdTByte(x, d - 1);
end;

procedure InitInt64;
begin
  PHInt64[0] := 0;
  PLInt64[0] := 0;
  PHInt64[1] := -1;
  PLInt64[1] := -1;
  PHInt64[2] := 1;
  PLInt64[2] := 0;
  PHInt64[3] := 0;
  PLInt64[3] := Low(Int64);
  PHInt64[4] := -6148914691236517206;
  PLInt64[4] := 6148914691236517205;
  PHInt64[5] := Low(Int64);
  PLInt64[5] := 1;
  PHInt64[6] := 81985529216486895;
  PLInt64[6] := -81985529216486896;
  PHInt64[7] := -4294967296;
  PLInt64[7] := 4294967295;
end;

procedure InitInt32;
begin
  PHInt32[0] := 0;
  PLInt32[0] := 0;
  PHInt32[1] := -1;
  PLInt32[1] := -1;
  PHInt32[2] := 1;
  PLInt32[2] := 0;
  PHInt32[3] := 0;
  PLInt32[3] := -2147483648;
  PHInt32[4] := -1431655766;
  PLInt32[4] := 1431655765;
  PHInt32[5] := -2147483648;
  PLInt32[5] := 1;
  PHInt32[6] := -1985229329;
  PLInt32[6] := 1985229328;
  PHInt32[7] := -65536;
  PLInt32[7] := 65535;
end;

procedure InitUInt32;
begin
  PHUInt32[0] := 0;
  PLUInt32[0] := 0;
  PHUInt32[1] := 4294967295;
  PLUInt32[1] := 4294967295;
  PHUInt32[2] := 1;
  PLUInt32[2] := 0;
  PHUInt32[3] := 0;
  PLUInt32[3] := 2147483648;
  PHUInt32[4] := 2863311530;
  PLUInt32[4] := 1431655765;
  PHUInt32[5] := 2147483648;
  PLUInt32[5] := 1;
  PHUInt32[6] := 2309737967;
  PLUInt32[6] := 1985229328;
  PHUInt32[7] := 4294901760;
  PLUInt32[7] := 65535;
end;

procedure InitInt16;
begin
  PHInt16[0] := 0;
  PLInt16[0] := 0;
  PHInt16[1] := -1;
  PLInt16[1] := -1;
  PHInt16[2] := 1;
  PLInt16[2] := 0;
  PHInt16[3] := 0;
  PLInt16[3] := -32768;
  PHInt16[4] := -21846;
  PLInt16[4] := 21845;
  PHInt16[5] := -32768;
  PLInt16[5] := 1;
  PHInt16[6] := -12817;
  PLInt16[6] := 12816;
  PHInt16[7] := -256;
  PLInt16[7] := 255;
end;

procedure InitWord;
begin
  PHWord[0] := 0;
  PLWord[0] := 0;
  PHWord[1] := 65535;
  PLWord[1] := 65535;
  PHWord[2] := 1;
  PLWord[2] := 0;
  PHWord[3] := 0;
  PLWord[3] := 32768;
  PHWord[4] := 43690;
  PLWord[4] := 21845;
  PHWord[5] := 32768;
  PLWord[5] := 1;
  PHWord[6] := 52719;
  PLWord[6] := 12816;
  PHWord[7] := 65280;
  PLWord[7] := 255;
end;

procedure InitInt8;
begin
  PHInt8[0] := 0;
  PLInt8[0] := 0;
  PHInt8[1] := -1;
  PLInt8[1] := -1;
  PHInt8[2] := 1;
  PLInt8[2] := 0;
  PHInt8[3] := 0;
  PLInt8[3] := -128;
  PHInt8[4] := -86;
  PLInt8[4] := 85;
  PHInt8[5] := -128;
  PLInt8[5] := 1;
  PHInt8[6] := -17;
  PLInt8[6] := 16;
  PHInt8[7] := -16;
  PLInt8[7] := 15;
end;

procedure InitByte;
begin
  PHByte[0] := 0;
  PLByte[0] := 0;
  PHByte[1] := 255;
  PLByte[1] := 255;
  PHByte[2] := 1;
  PLByte[2] := 0;
  PHByte[3] := 0;
  PLByte[3] := 128;
  PHByte[4] := 170;
  PLByte[4] := 85;
  PHByte[5] := 128;
  PLByte[5] := 1;
  PHByte[6] := 239;
  PLByte[6] := 16;
  PHByte[7] := 240;
  PLByte[7] := 15;
end;

{ small routines whose assembly the Makefile reads (compiled with -inline 0):
  a count and 63 is in 0..63 and needs no test, and 127 does }
function S_SafeL(h, l, c: Int64): Int64;
begin
  Result := FunnelLeft(h, l, c and 63);
end;

function S_SafeR(h, l, c: Int64): Int64;
begin
  Result := FunnelRight(h, l, c and 63);
end;

function S_WideL(h, l, c: Int64): Int64;
begin
  Result := FunnelLeft(h, l, c and 127);
end;

function S_ByteR(h, l: Byte; c: Int64): Byte;
begin
  Result := FunnelRight(h, l, c and 63);
end;

function S_ByteU(h, l: Byte; c: Int64): Byte;
begin
  Result := FunnelRight(h, l, c);
end;

procedure Shapes;
var
  k: Integer;
  c: Int64;
  h, l: Int64;
  hb, lb: Byte;
begin
  h := $0123456789ABCDEF;
  l := $FEDCBA9876543210;
  hb := $A5;
  lb := $3C;
  for k := 0 to 9 do
  begin
    c := SCounts[k];
    WriteLn('shape ', c, ' ', S_SafeL(h, l, c), ' ', S_SafeR(h, l, c), ' ', S_WideL(h, l, c), ' ',
      S_ByteR(hb, lb, c), ' ', S_ByteU(hb, lb, c));
  end;
end;

procedure F_Int64_Left_0;
var
  i, j: Integer;
  v, n: Int64;
  nb: Byte;
  hv, lv, x: Int64;
begin
  FillChar(HS, SizeOf(HS), 0);
  for i := 0 to 7 do
  begin
    hv := PHInt64[i]; lv := PLInt64[i];
    for v := -2 to 130 do
    begin
      n := v;
      nb := Byte(v and 255);
      x := FunnelLeft(hv, lv, n);
      HS[0] := (HS[0] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, n and 63);
      HS[1] := (HS[1] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, n and 127);
      HS[2] := (HS[2] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, n and 64);
      HS[3] := (HS[3] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, (n and 255) mod 64);
      HS[4] := (HS[4] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, (n and 63) - 1);
      HS[5] := (HS[5] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, (n and 63) + 1);
      HS[6] := (HS[6] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, (n * 7919) shr 58);
      HS[7] := (HS[7] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, nb);
      HS[8] := (HS[8] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, nb and 63);
      HS[9] := (HS[9] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, nb mod 64);
      HS[10] := (HS[10] xor x) * 1099511628211 + 7;
      x := FunnelLeft(hv, lv, IdI(n, 0) and 63);
      HS[11] := (HS[11] xor x) * 1099511628211 + 7;
    end;
    x := FunnelLeft(hv, lv, (-1));
    HS[12] := (HS[12] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 0);
    HS[13] := (HS[13] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 1);
    HS[14] := (HS[14] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 5);
    HS[15] := (HS[15] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 7);
    HS[16] := (HS[16] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 8);
    HS[17] := (HS[17] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 15);
    HS[18] := (HS[18] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 16);
    HS[19] := (HS[19] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 31);
    HS[20] := (HS[20] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 32);
    HS[21] := (HS[21] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 33);
    HS[22] := (HS[22] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 63);
    HS[23] := (HS[23] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 64);
    HS[24] := (HS[24] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 65);
    HS[25] := (HS[25] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 127);
    HS[26] := (HS[26] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 128);
    HS[27] := (HS[27] xor x) * 1099511628211 + 7;
    x := FunnelLeft(hv, lv, 129);
    HS[28] := (HS[28] xor x) * 1099511628211 + 7;
    for j := 0 to 63 do
    begin
      x := FunnelLeft(hv, lv, j);
      HS[29] := (HS[29] xor x) * 1099511628211 + 7;
    end;
    for j := 0 to 64 do
    begin
      x := FunnelLeft(hv, lv, j);
      HS[30] := (HS[30] xor x) * 1099511628211 + 7;
    end;
    for j := -1 to 62 do
    begin
      x := FunnelLeft(hv, lv, j);
      HS[31] := (HS[31] xor x) * 1099511628211 + 7;
    end;
  end;
  Write('Int64 Left locals:');
  for i := 0 to 31 do
    Write(' ', HS[i]);
  WriteLn;
end;

procedure F_Int64_Left_1;
var
  i, j: Integer;
  v, n: Int64;
  nb: Byte;
  hv, lv, x: Int64;
begin
  FillChar(HS, SizeOf(HS), 0);
  for i := 0 to 7 do
  begin
    GHInt64 := PHInt64[i]; GLInt64 := PLInt64[i];
    for v := -2 to 130 do
    begin
      n := v;
      nb := Byte(v and 255);
      x := FunnelLeft(GHInt64, GLInt64, n);
      HS[0] := (HS[0] xor x) * 1099511628211 + 7;
      x := FunnelLeft(GHInt64, GLInt64, n and 63);
      HS[1] := (HS[1] xor x) * 1099511628211 + 7;
      x := FunnelLeft(GHInt64, GLInt64, n and 127);
      HS[2] := (HS[2] xor x) * 1099511628211 + 7;
