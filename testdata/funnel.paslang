procedure F_Int16_Right_5;
var
  i, j: Integer;
  v, n: Int64;
  nb: Byte;
  hv, lv, x: Int16;
begin
  FillChar(HS, SizeOf(HS), 0);
  for i := 0 to 7 do
  begin
    hv := PHInt16[i]; lv := PLInt16[i];
    for v := -2 to 130 do
    begin
      n := v;
      nb := Byte(v and 255);
      x := FunnelRight(IdTInt16(hv, 0), lv, n);
      HS[0] := (HS[0] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, n and 63);
      HS[1] := (HS[1] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, n and 127);
      HS[2] := (HS[2] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, n and 64);
      HS[3] := (HS[3] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, (n and 255) mod 64);
      HS[4] := (HS[4] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, (n and 63) - 1);
      HS[5] := (HS[5] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, (n and 63) + 1);
      HS[6] := (HS[6] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, (n * 7919) shr 58);
      HS[7] := (HS[7] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, nb);
      HS[8] := (HS[8] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, nb and 63);
      HS[9] := (HS[9] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, nb mod 64);
      HS[10] := (HS[10] xor x) * 1099511628211 + 7;
      x := FunnelRight(IdTInt16(hv, 0), lv, IdI(n, 0) and 63);
      HS[11] := (HS[11] xor x) * 1099511628211 + 7;
    end;
    x := FunnelRight(IdTInt16(hv, 0), lv, (-1));
