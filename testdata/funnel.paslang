  i, j: Integer;
  v, n: Int64;
  nb: Byte;
  hv, lv, x: Byte;
begin
  FillChar(HS, SizeOf(HS), 0);
  for i := 0 to 7 do
  begin
    for v := -2 to 130 do
    begin
      n := v;
      nb := Byte(v and 255);
      x := FunnelLeft(PHByte[i], PLByte[i], n);
      HS[0] := (HS[0] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], n and 63);
      HS[1] := (HS[1] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], n and 127);
      HS[2] := (HS[2] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], n and 64);
      HS[3] := (HS[3] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], (n and 255) mod 64);
      HS[4] := (HS[4] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], (n and 63) - 1);
      HS[5] := (HS[5] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], (n and 63) + 1);
      HS[6] := (HS[6] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], (n * 7919) shr 58);
      HS[7] := (HS[7] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], nb);
      HS[8] := (HS[8] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], nb and 63);
      HS[9] := (HS[9] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], nb mod 64);
      HS[10] := (HS[10] xor x) * 1099511628211 + 7;
      x := FunnelLeft(PHByte[i], PLByte[i], IdI(n, 0) and 63);
      HS[11] := (HS[11] xor x) * 1099511628211 + 7;
    end;
    x := FunnelLeft(PHByte[i], PLByte[i], (-1));
    HS[12] := (HS[12] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 0);
    HS[13] := (HS[13] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 1);
    HS[14] := (HS[14] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 5);
    HS[15] := (HS[15] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 7);
    HS[16] := (HS[16] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 8);
    HS[17] := (HS[17] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 15);
    HS[18] := (HS[18] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 16);
    HS[19] := (HS[19] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 31);
    HS[20] := (HS[20] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 32);
    HS[21] := (HS[21] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 33);
    HS[22] := (HS[22] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 63);
    HS[23] := (HS[23] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 64);
    HS[24] := (HS[24] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 65);
    HS[25] := (HS[25] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 127);
    HS[26] := (HS[26] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 128);
    HS[27] := (HS[27] xor x) * 1099511628211 + 7;
    x := FunnelLeft(PHByte[i], PLByte[i], 129);
    HS[28] := (HS[28] xor x) * 1099511628211 + 7;
    for j := 0 to 63 do
    begin
      x := FunnelLeft(PHByte[i], PLByte[i], j);
      HS[29] := (HS[29] xor x) * 1099511628211 + 7;
    end;
    for j := 0 to 64 do
    begin
      x := FunnelLeft(PHByte[i], PLByte[i], j);
      HS[30] := (HS[30] xor x) * 1099511628211 + 7;
    end;
    for j := -1 to 62 do
    begin
      x := FunnelLeft(PHByte[i], PLByte[i], j);
      HS[31] := (HS[31] xor x) * 1099511628211 + 7;
    end;
  end;
  Write('Byte Left elements:');
  for i := 0 to 31 do
    Write(' ', HS[i]);
  WriteLn;
end;

