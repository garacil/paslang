  i, j: Integer;
  v, n: Int64;
  nb: Byte;
  hv, lv, x: Int32;
begin
  FillChar(HS, SizeOf(HS), 0);
  for i := 0 to 7 do
  begin
    hv := PHInt32[i]; lv := PLInt32[i];
    for v := -2 to 130 do
    begin
      n := v;
      nb := Byte(v and 255);
      x := FunnelLeft(IdTInt32(hv, 0), lv, n);
      HS[0] := (HS[0] xor x) * 1099511628211 + 7;
      x := FunnelLeft(IdTInt32(hv, 0), lv, n and 63);
      HS[1] := (HS[1] xor x) * 1099511628211 + 7;
