      HS[5] := (HS[5] xor x) * 1099511628211 + 7;
      x := FunnelLeft(GHInt64, GLInt64, (n and 63) + 1);
      HS[6] := (HS[6] xor x) * 1099511628211 + 7;
      x := FunnelLeft(GHInt64, GLInt64, (n * 7919) shr 58);
      HS[7] := (HS[7] xor x) * 1099511628211 + 7;
      x := FunnelLeft(GHInt64, GLInt64, nb);
      HS[8] := (HS[8] xor x) * 1099511628211 + 7;
      x := FunnelLeft(GHInt64, GLInt64, nb and 63);
      HS[9] := (HS[9] xor x) * 1099511628211 + 7;
      x := FunnelLeft(GHInt64, GLInt64, nb mod 64);
      HS[10] := (HS[10] xor x) * 1099511628211 + 7;
      x := FunnelLeft(GHInt64, GLInt64, IdI(n, 0) and 63);
      HS[11] := (HS[11] xor x) * 1099511628211 + 7;
    end;
    x := FunnelLeft(GHInt64, GLInt64, (-1));
    HS[12] := (HS[12] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 0);
    HS[13] := (HS[13] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 1);
    HS[14] := (HS[14] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 5);
    HS[15] := (HS[15] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 7);
    HS[16] := (HS[16] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 8);
    HS[17] := (HS[17] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 15);
    HS[18] := (HS[18] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 16);
    HS[19] := (HS[19] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 31);
    HS[20] := (HS[20] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 32);
    HS[21] := (HS[21] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 33);
    HS[22] := (HS[22] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 63);
    HS[23] := (HS[23] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 64);
    HS[24] := (HS[24] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 65);
    HS[25] := (HS[25] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 127);
    HS[26] := (HS[26] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 128);
    HS[27] := (HS[27] xor x) * 1099511628211 + 7;
    x := FunnelLeft(GHInt64, GLInt64, 129);
    HS[28] := (HS[28] xor x) * 1099511628211 + 7;
    for j := 0 to 63 do
    begin
      x := FunnelLeft(GHInt64, GLInt64, j);
      HS[29] := (HS[29] xor x) * 1099511628211 + 7;
    end;
    for j := 0 to 64 do
    begin
      x := FunnelLeft(GHInt64, GLInt64, j);
      HS[30] := (HS[30] xor x) * 1099511628211 + 7;
    end;
    for j := -1 to 62 do
    begin
      x := FunnelLeft(GHInt64, GLInt64, j);
      HS[31] := (HS[31] xor x) * 1099511628211 + 7;
    end;
  end;
  Write('Int64 Left globals:');
  for i := 0 to 31 do
    Write(' ', HS[i]);
  WriteLn;
end;

