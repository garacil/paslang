    x := FunnelRight(Byte(77), Byte(100), 127);
    HS[26] := (HS[26] xor x) * 1099511628211 + 7;
    x := FunnelRight(Byte(77), Byte(100), 128);
    HS[27] := (HS[27] xor x) * 1099511628211 + 7;
    x := FunnelRight(Byte(77), Byte(100), 129);
    HS[28] := (HS[28] xor x) * 1099511628211 + 7;
    for j := 0 to 63 do
    begin
      x := FunnelRight(Byte(77), Byte(100), j);
      HS[29] := (HS[29] xor x) * 1099511628211 + 7;
    end;
    for j := 0 to 64 do
    begin
      x := FunnelRight(Byte(77), Byte(100), j);
      HS[30] := (HS[30] xor x) * 1099511628211 + 7;
    end;
    for j := -1 to 62 do
    begin
      x := FunnelRight(Byte(77), Byte(100), j);
      HS[31] := (HS[31] xor x) * 1099511628211 + 7;
    end;
  end;
  Write('Byte Right constants:');
  for i := 0 to 31 do
    Write(' ', HS[i]);
  WriteLn;
end;

