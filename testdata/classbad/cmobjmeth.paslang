{ P123: a class method has no object to call an object's method on. }
program cmobjmeth;
type
  TA = class
    procedure Show;
    class procedure Run;
  end;
procedure TA.Show;
begin
end;
class procedure TA.Run;
begin
  Show;
end;
begin
end.

