{ P570: inherited of a method that is abstract in the parent is refused:
  there is no body to call. }
program inhabstract;

type
  TShape = class
    function Area: Integer; virtual; abstract;
  end;

  TSquare = class(TShape)
    function Area: Integer; override;
  end;

function TSquare.Area: Integer;
begin
  Result := inherited Area + 1;
end;

begin
end.

