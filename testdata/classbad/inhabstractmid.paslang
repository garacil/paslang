{ P570: the same through a class in between that does not override the
  abstract method: its entry is still abstract. }
program inhabstractmid;

type
  TShape = class
    function Area: Integer; virtual; abstract;
  end;

  TMid = class(TShape)
    procedure Other;
  end;

  TLeaf = class(TMid)
    function Area: Integer; override;
  end;

procedure TMid.Other;
begin
end;

function TLeaf.Area: Integer;
begin
  Result := inherited Area + 1;
end;

begin
end.

