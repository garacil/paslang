{ P123: a class property reads a class variable or a static class method. }
program cpropnotstatic;
type
  TA = class
    class function Get: Int64;
    class property P: Int64 read Get;
  end;
class function TA.Get: Int64;
begin
  Result := 1;
end;
begin
  WriteLn(TA.P);
end.

