program pbkdf2routines;

var
  Group, Collector: waitgroup;
  Failed: array[0..7] of Boolean;
  Stop, Collections: Integer;

function OwnBytes(const S: string): string;
var I: Integer;
begin
  SetLength(Result, Length(S));
  for I := 1 to Length(S) do Result[I] := S[I];
end;

{ Derivation occurs at the bottom, while all pads and dynamic inputs in
  the outer frames remain live. The return sum reads the pads afterwards. }
function Grow(Depth, Seed: Integer; const Password, Salt, Expected: string): Integer;
var Pad: array[0..63] of Integer; I: Integer; D: string;
begin
  for I := 0 to 63 do Pad[I] := Seed + Depth * 64 + I;
  if Depth > 0 then Result := Grow(Depth - 1, Seed, Password, Salt, Expected)
  else
  begin
    Sleep(1);
    GcCollect;
    if Seed mod 2 = 0 then D := Pbkdf2HmacSha1(Password, Salt, 4096, 16)
    else D := Pbkdf2HmacSha256(Password, Salt, 80000, 64);
    if Hex(D) <> Expected then Failed[Seed] := True;
    GcCollect;
    Result := 0;
  end;
  Result := Result + Pad[0] + Pad[63];
end;

procedure Derive(Id: Integer);
var Password, Salt, Expected: string;
begin
  Password := OwnBytes('pass'#0'word');
  Salt := OwnBytes('sa'#0'lt');
  Expected := OwnBytes('56fa6aa75548099dcc37d7f03425e0c3');
  if Id mod 2 = 1 then
  begin
    Password := OwnBytes('Password'); Salt := OwnBytes('NaCl');
    Expected := OwnBytes('4ddcd8f60b98be21830cee5ef22701f9641a4418d04c0414aeff08876b34ab56a1d425a1225833549adb841b51c9b3176a272bdebba1d078478f62b397f33c8d');
  end;
  if Grow(16, Id, Password, Salt, Expected) <> 34 * Id + 18479 then Failed[Id] := True;
  Group.Done;
end;

procedure Collect;
begin
  repeat
    GcCollect;
    AtomicAdd(@Collections, 1);
    Yield;
  until AtomicLoad(Stop) <> 0;
  Collector.Done;
end;

var I: Integer;
begin
  Collector.Add(1);
  pas Collect;
  Group.Add(8);
  for I := 0 to 7 do pas Derive(I);
  Group.Wait;
  AtomicStore(Stop, 1);
  Collector.Wait;
  if AtomicLoad(Collections) < 1 then Halt(126);
  for I := 0 to 7 do
    if Failed[I] then begin WriteLn('PBKDF2 routine ', I); Halt(125); end;
  WriteLn('ok PBKDF2 routines and roots');
end.

