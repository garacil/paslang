{ P433: the readers of pasmime on inputs of the shapes a hostile message has,
  big enough that a routine which copies the rest of its input at every step
  (what the first versions did: a Latin-1 text of 300 KB took minutes, a header
  of 20,000 encoded words 12 seconds, a Content-Type of 20,000 parameters 27
  seconds) would not end within the limit of the test (the Makefile's timeout), and
  which take a few milliseconds as they are now. Each shape prints "ok", or what it
  got and what it should have got: the sizes are not printed because under the
  collector's stress (an allocation in three makes a collection, which is minutes
  for texts of this size) the shapes are a tenth of the size. }
program mailscale;

uses
  sysutils, pascodec, pastextproto, pasmime;

var
  s, tmp, r, err, mt, body: string;
  i, k, d, n, want: Integer;
  al: TMailAddressArray;
  a: TMailAddress;
  pr: TMimeParams;
  parts: TMimePartArray;
  e: TMailEntity;
  f: TMimeFields;
  ok: Boolean;

function Chk(Got, Want: Integer): string;
begin
  if Got = Want then
    Result := 'ok'
  else
    Result := 'got ' + IntToStr(Got) + ' want ' + IntToStr(Want);
end;

begin
  d := 1;
  if GetEnvironmentVariable('PASLANG_GCSTRESS') <> '' then
    d := 10;
  { a Latin-1 text into UTF-8 }
  n := 1000000 div d;
  SetLength(s, n);
  for i := 1 to Length(s) do
    s[i] := Chr(128 + (i mod 100));
  ok := MimeCharsetToUtf8('iso-8859-1', s, False, r);
  WriteLn('latin1 ', ok, ' ', Chk(Length(r), 2 * n));
  { windows-1252 with Extra: a period of 100 bytes converted, times the periods }
  ok := MimeCharsetToUtf8('windows-1252', Copy(s, 1, 100), True, r);
  want := Length(r) * (n div 100);
  ok := MimeCharsetToUtf8('windows-1252', s, True, r);
  WriteLn('cp1252 ', ok, ' ', Chk(Length(r), want));
  { a header of encoded words }
  n := 20000 div d;
  tmp := '';
  want := 0;
  for i := 1 to n do
  begin
    tmp := tmp + '=?UTF-8?Q?Se=C3=B1or_' + IntToStr(i) + '?= ';
    want := want + 7 + Length(IntToStr(i));
  end;
  ok := MimeDecodeHeader(tmp, False, r, err);
  { the text after the last word is the blank that follows it }
  WriteLn('header words ', ok, ' ', Chk(Length(r), want + 1));
  { a Content-Type of parameters, read and written }
  tmp := 'text/plain';
  for i := 1 to n do
    tmp := tmp + '; p' + IntToStr(i) + '=v' + IntToStr(i);
  pr := TMimeParams.Create;
  ok := MimeParseMediaType(tmp, mt, pr, err);
  WriteLn('media type ', ok, ' ', Chk(pr.Count, n));
  r := MimeFormatMediaType('text/plain', pr);
  WriteLn('media type written ', Chk(Length(r), Length(tmp) + 0));
  { parts of a multipart }
  n := 5000 div d;
  tmp := '';
  for i := 1 to n do
    tmp := tmp + '--Q' + #13#10 + 'Content-Type: text/plain' + #13#10 + #13#10 + 'part ' + IntToStr(i) + #13#10;
  tmp := tmp + '--Q--' + #13#10;
  ok := MimeReadMultipart(tmp, 'Q', True, parts, err);
  WriteLn('parts ', ok, ' ', Chk(Length(parts), n));
  { parts whose text holds lines that look like the boundary }
  n := 3000 div d;
  tmp := '';
  for i := 1 to n do
    tmp := tmp + '--B' + #13#10 + 'Content-Type: text/plain' + #13#10 + #13#10 + '--Bnot a boundary line' + #13#10 + 'text ' + IntToStr(i) + #13#10;
  tmp := tmp + '--B--';
  ok := MailParseEntity('Content-Type: multipart/mixed; boundary=B' + #13#10 + #13#10 + tmp, e, err);
  WriteLn('lookalike boundaries ', ok, ' ', Chk(e.KidCount, n));
  { a quoted display name, and written back }
  n := 200000 div d;
  tmp := '"';
  for i := 1 to n do
    tmp := tmp + 'abcde';
  tmp := tmp + '" <a@b.c>';
  ok := MailParseAddress(tmp, False, a, err);
  WriteLn('quoted name ', ok, ' ', Chk(Length(a.Name), 5 * n));
  r := MailAddressString(a);
  WriteLn('address string ', Chk(Length(r), 5 * n + 10));
  { addresses }
  n := 20000 div d;
  tmp := '';
  for i := 1 to n do
    tmp := tmp + 'User ' + IntToStr(i) + ' <u' + IntToStr(i) + '@example.com>, ';
  tmp := tmp + 'last@example.com';
  ok := MailParseAddressList(tmp, False, al, err);
  WriteLn('addresses ', ok, ' ', Chk(Length(al), n + 1));
  { fields, and a folded subject }
  n := 10000 div d;
  tmp := '';
  for i := 1 to n do
    tmp := tmp + 'X-Header-' + IntToStr(i) + ': value ' + IntToStr(i) + #13#10;
  tmp := tmp + #13#10 + 'body' + #13#10;
  f := TMimeFields.Create;
  ok := MailReadMessage(tmp, f, body, err);
  WriteLn('fields ', ok, ' ', Chk(f.Count, n));
  n := 100000 div d;
  tmp := 'Subject: start' + #13#10;
  want := 5;
  for i := 1 to n do
  begin
    tmp := tmp + ' continuation line number ' + IntToStr(i) + ' of the subject' + #13#10;
    want := want + 1 + Length('continuation line number ' + IntToStr(i) + ' of the subject');
  end;
  tmp := tmp + #13#10 + 'body';
  f := TMimeFields.Create;
  ok := MailReadMessage(tmp, f, body, err);
  WriteLn('folded ', ok, ' ', Chk(Length(f.Get('Subject')), want));
  { quoted-printable, an encoded word }
  n := 100000 div d;
  tmp := '';
  for i := 1 to n do
    tmp := tmp + 'Se=C3=B1or ';
  ok := QpDecode(tmp, r, err);
  WriteLn('qp ', ok, ' ', Chk(Length(r), 7 * n - 1));
  tmp := '=?UTF-8?Q?';
  for i := 1 to n do
    tmp := tmp + 'Se=C3=B1or_';
  tmp := tmp + '?=';
  ok := MimeDecodeWord(tmp, False, r, err);
  WriteLn('word ', ok, ' ', Chk(Length(r), 7 * n));
end.
