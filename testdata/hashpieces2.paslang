{ P443: HMAC and SHA-3 in pieces (HmacMd5Begin ... HmacSha512Final,
  Sha3_224Begin ... Sha3_512Final) against the whole-message words. For
  each: every length from 0 to 300 (HMAC) or 400 (SHA-3) cut at every
  place into two pieces, and into three at places a splitmix64 gives;
  pieces of every size to 200 over 1000 bytes; keys shorter than, equal
  to and longer than the block; a million 'a' in pieces of 997 bytes;
  the state finished twice and fed again; a state begun again; the
  vectors of RFC 4231 and RFC 2202 for the keys and data they name and
  FIPS 202's examples, their digests the ones Python's hmac and hashlib
  give (hashpieces2.out). }
program hashpieces2;

var
  GS: Integer;

function GNext: Integer;
var
  z: Integer;
begin
  GS := GS + Integer($9E3779B97F4A7C15);
  z := GS;
  z := (z xor (z shr 30)) * Integer($BF58476D1CE4E5B9);
  z := (z xor (z shr 27)) * Integer($94D049BB133111EB);
  Result := z xor (z shr 31);
end;

{ the whole-message MAC of hash A (0 MD5 ... 5 SHA-512) }
function HWhole(A: Integer; const K, S: string): string;
begin
  case A of
    0: Result := HmacMd5(K, S);
    1: Result := HmacSha1(K, S);
    2: Result := HmacSha224(K, S);
    3: Result := HmacSha256(K, S);
    4: Result := HmacSha384(K, S);
  else
    Result := HmacSha512(K, S);
  end;
end;

procedure HBegin(A: Integer; var St: THmacState; const K: string);
begin
  case A of
    0: HmacMd5Begin(St, K);
    1: HmacSha1Begin(St, K);
    2: HmacSha224Begin(St, K);
    3: HmacSha256Begin(St, K);
    4: HmacSha384Begin(St, K);
  else
    HmacSha512Begin(St, K);
  end;
end;

procedure HUpdate(A: Integer; var St: THmacState; const S: string);
begin
  case A of
    0: HmacMd5Update(St, S);
    1: HmacSha1Update(St, S);
    2: HmacSha224Update(St, S);
    3: HmacSha256Update(St, S);
    4: HmacSha384Update(St, S);
  else
    HmacSha512Update(St, S);
  end;
end;

function HFinal(A: Integer; var St: THmacState): string;
begin
  case A of
    0: Result := HmacMd5Final(St);
    1: Result := HmacSha1Final(St);
    2: Result := HmacSha224Final(St);
    3: Result := HmacSha256Final(St);
    4: Result := HmacSha384Final(St);
  else
    Result := HmacSha512Final(St);
  end;
end;

{ the whole-message SHA-3 of size index B (0 224, 1 256, 2 384, 3 512) }
function SWhole(B: Integer; const S: string): string;
begin
  case B of
    0: Result := Sha3_224(S);
    1: Result := Sha3_256(S);
    2: Result := Sha3_384(S);
  else
    Result := Sha3_512(S);
  end;
end;

procedure SBegin(B: Integer; var St: TSha3State);
begin
  case B of
    0: Sha3_224Begin(St);
    1: Sha3_256Begin(St);
    2: Sha3_384Begin(St);
  else
    Sha3_512Begin(St);
  end;
end;

procedure SUpdate(B: Integer; var St: TSha3State; const S: string);
begin
  case B of
    0: Sha3_224Update(St, S);
    1: Sha3_256Update(St, S);
    2: Sha3_384Update(St, S);
  else
    Sha3_512Update(St, S);
  end;
end;

function SFinal(B: Integer; var St: TSha3State): string;
begin
  case B of
    0: Result := Sha3_224Final(St);
    1: Result := Sha3_256Final(St);
    2: Result := Sha3_384Final(St);
  else
    Result := Sha3_512Final(St);
  end;
end;

{ S cut at C1 and C2 (C2 = 0 for one cut) into pieces }
procedure Cut(const S: string; C1, C2: Integer; out P0, P1, P2: string);
begin
  P0 := Copy(S, 1, C1);
  if C2 > C1 then
  begin
    P1 := Copy(S, C1 + 1, C2 - C1);
    P2 := Copy(S, C2 + 1, Length(S) - C2);
  end
  else
  begin
    P1 := Copy(S, C1 + 1, Length(S) - C1);
    P2 := '';
  end;
end;

function HPieces(A: Integer; const K, S: string; C1, C2: Integer): string;
var
  st: THmacState;
  p0, p1, p2: string;
begin
  Cut(S, C1, C2, p0, p1, p2);
  HBegin(A, st, K);
  HUpdate(A, st, p0);
  HUpdate(A, st, p1);
  HUpdate(A, st, p2);
  Result := HFinal(A, st);
end;

function HByK(A: Integer; const K, S: string; N: Integer): string;
var
  st: THmacState;
  i: Integer;
begin
  HBegin(A, st, K);
  i := 1;
  while i <= Length(S) do
  begin
    HUpdate(A, st, Copy(S, i, N));
    i := i + N;
  end;
  Result := HFinal(A, st);
end;

function SPieces(B: Integer; const S: string; C1, C2: Integer): string;
var
  st: TSha3State;
  p0, p1, p2: string;
begin
  Cut(S, C1, C2, p0, p1, p2);
  SBegin(B, st);
  SUpdate(B, st, p0);
  SUpdate(B, st, p1);
  SUpdate(B, st, p2);
  Result := SFinal(B, st);
end;

function SByK(B: Integer; const S: string; N: Integer): string;
var
  st: TSha3State;
  i: Integer;
begin
  SBegin(B, st);
  i := 1;
  while i <= Length(S) do
  begin
    SUpdate(B, st, Copy(S, i, N));
    i := i + N;
  end;
  Result := SFinal(B, st);
end;

{ n bytes of a pattern }
function Pat(N, Mul, Add: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, N);
  for i := 1 to N do
    Result[i] := Char((i * Mul + Add) and 255);
end;

const
  HNames: array[0..5] of string = ('md5', 'sha1', 'sha224', 'sha256', 'sha384', 'sha512');
  SNames: array[0..3] of string = ('sha3-224', 'sha3-256', 'sha3-384', 'sha3-512');
  KeyLens: array[0..6] of Integer = (0, 1, 20, 63, 64, 65, 200);

var
  a, n, c1, c2, k, bad, runs, i, kl: Integer;
  msg, want, key, m2, rep: string;
  hs: THmacState;
  ss: TSha3State;

begin
  GS := 11;
  { HMAC: for each hash and each key length, every length to 300, every cut }
  for a := 0 to 5 do
  begin
    bad := 0;
    runs := 0;
    for kl := 0 to 6 do
    begin
      key := Pat(KeyLens[kl], 17, 5);
      msg := '';
      for n := 0 to 300 do
      begin
        if (kl = 2) or (n mod 37 = 0) or (n > 250) then
        begin
          want := HWhole(a, key, msg);
          for c1 := 0 to n do
            if (kl = 2) or (c1 mod 7 = 0) or (c1 = n) then
            begin
              runs := runs + 1;
              if HPieces(a, key, msg, c1, 0) <> want then
                bad := bad + 1;
            end;
          for i := 1 to 4 do
          begin
            c1 := (GNext shr 1) mod (n + 1);
            c2 := c1 + (GNext shr 1) mod (n - c1 + 1);
            runs := runs + 1;
            if HPieces(a, key, msg, c1, c2) <> want then
              bad := bad + 1;
          end;
        end;
        msg := msg + Chr((n * 31 + 7) and 255);
      end;
    end;
    msg := Pat(1000, 131, 3);
    key := Pat(70, 3, 9);
    want := HWhole(a, key, msg);
    for k := 1 to 200 do
    begin
      runs := runs + 1;
      if HByK(a, key, msg, k) <> want then
        bad := bad + 1;
    end;
    WriteLn('hmac-', HNames[a], ': ', runs, ' runs, ', bad, ' differ');
  end;

  { SHA-3: every length to 400, every cut }
  for a := 0 to 3 do
  begin
    bad := 0;
    runs := 0;
    msg := '';
    for n := 0 to 400 do
    begin
      want := SWhole(a, msg);
      for c1 := 0 to n do
      begin
        runs := runs + 1;
        if SPieces(a, msg, c1, 0) <> want then
          bad := bad + 1;
      end;
      for i := 1 to 8 do
      begin
        c1 := (GNext shr 1) mod (n + 1);
        c2 := c1 + (GNext shr 1) mod (n - c1 + 1);
        runs := runs + 1;
        if SPieces(a, msg, c1, c2) <> want then
          bad := bad + 1;
      end;
      msg := msg + Chr((n * 31 + 7) and 255);
    end;
    msg := Pat(1000, 131, 3);
    want := SWhole(a, msg);
    for k := 1 to 200 do
    begin
      runs := runs + 1;
      if SByK(a, msg, k) <> want then
        bad := bad + 1;
    end;
    WriteLn(SNames[a], ': ', runs, ' runs, ', bad, ' differ');
  end;

  { RFC 4231 test cases 1, 2, 3, 4, 6 and 7, fed in three pieces }
  WriteLn('rfc4231-1 sha256: ', Hex(HPieces(3, StringOfChar(Chr($0b), 20), 'Hi There', 2, 5)));
  WriteLn('rfc4231-2 sha224: ', Hex(HPieces(2, 'Jefe', 'what do ya want for nothing?', 7, 20)));
  WriteLn('rfc4231-2 sha256: ', Hex(HByK(3, 'Jefe', 'what do ya want for nothing?', 1)));
  WriteLn('rfc4231-2 sha384: ', Hex(HPieces(4, 'Jefe', 'what do ya want for nothing?', 3, 0)));
  WriteLn('rfc4231-2 sha512: ', Hex(HPieces(5, 'Jefe', 'what do ya want for nothing?', 11, 12)));
  WriteLn('rfc4231-3 sha256: ', Hex(HPieces(3, StringOfChar(Chr($aa), 20), StringOfChar(Chr($dd), 50), 25, 26)));
  key := '';
  for i := 1 to 25 do
    key := key + Chr(i);
  WriteLn('rfc4231-4 sha256: ', Hex(HPieces(3, key, StringOfChar(Chr($cd), 50), 1, 49)));
  WriteLn('rfc4231-6 sha256: ', Hex(HPieces(3, StringOfChar(Chr($aa), 131), 'Test Using Larger Than Block-Size Key - Hash Key First', 5, 30)));
  WriteLn('rfc4231-6 sha512: ', Hex(HPieces(5, StringOfChar(Chr($aa), 131), 'Test Using Larger Than Block-Size Key - Hash Key First', 5, 30)));
  m2 := 'This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.';
  WriteLn('rfc4231-7 sha256: ', Hex(HPieces(3, StringOfChar(Chr($aa), 131), m2, 64, 100)));
  WriteLn('rfc4231-7 sha384: ', Hex(HPieces(4, StringOfChar(Chr($aa), 131), m2, 64, 100)));
  WriteLn('rfc2202-1 md5: ', Hex(HPieces(0, StringOfChar(Chr($0b), 16), 'Hi There', 3, 0)));
  WriteLn('rfc2202-2 md5: ', Hex(HPieces(0, 'Jefe', 'what do ya want for nothing?', 9, 10)));
  WriteLn('rfc2202-1 sha1: ', Hex(HPieces(1, StringOfChar(Chr($0b), 20), 'Hi There', 3, 0)));
  WriteLn('rfc2202-2 sha1: ', Hex(HByK(1, 'Jefe', 'what do ya want for nothing?', 1)));

  { FIPS 202 examples: the empty message, abc, and a million a }
  WriteLn('sha3-224 abc: ', Hex(SPieces(0, 'abc', 1, 2)));
  WriteLn('sha3-256 empty: ', Hex(SPieces(1, '', 0, 0)));
  WriteLn('sha3-256 abc: ', Hex(SByK(1, 'abc', 1)));
  WriteLn('sha3-384 abc: ', Hex(SPieces(2, 'abc', 2, 0)));
  WriteLn('sha3-512 abc: ', Hex(SPieces(3, 'abc', 1, 2)));
  rep := StringOfChar('a', 997);
  SBegin(1, ss);
  for i := 1 to 1003 do
    SUpdate(1, ss, rep);
  SUpdate(1, ss, StringOfChar('a', 1000000 - 1003 * 997));
  WriteLn('sha3-256 a million a: ', Hex(SFinal(1, ss)));
  HBegin(3, hs, 'key');
  for i := 1 to 1003 do
    HUpdate(3, hs, rep);
  HUpdate(3, hs, StringOfChar('a', 1000000 - 1003 * 997));
  WriteLn('hmac-sha256 key a million a: ', Hex(HFinal(3, hs)));

  { a state finished twice gives the same MAC and goes on when fed }
  HBegin(3, hs, 'key');
  HUpdate(3, hs, 'abc');
  want := HFinal(3, hs);
  WriteLn('hmac final twice: ', HFinal(3, hs) = want, ' ', want = HmacSha256('key', 'abc'));
  HUpdate(3, hs, 'def');
  WriteLn('hmac fed after final: ', HFinal(3, hs) = HmacSha256('key', 'abcdef'));
  SBegin(1, ss);
  SUpdate(1, ss, 'abc');
  want := SFinal(1, ss);
  WriteLn('sha3 final twice: ', SFinal(1, ss) = want, ' ', want = Sha3_256('abc'));
  SUpdate(1, ss, 'def');
  WriteLn('sha3 fed after final: ', SFinal(1, ss) = Sha3_256('abcdef'));
  { begun again, and empty pieces }
  HBegin(3, hs, 'other');
  HUpdate(3, hs, 'something');
  HBegin(3, hs, 'key');
  HUpdate(3, hs, '');
  HUpdate(3, hs, 'abc');
  HUpdate(3, hs, '');
  WriteLn('hmac begun again: ', HFinal(3, hs) = HmacSha256('key', 'abc'));
  SBegin(1, ss);
  SUpdate(1, ss, 'something');
  SBegin(1, ss);
  SUpdate(1, ss, '');
  SUpdate(1, ss, 'abc');
  WriteLn('sha3 begun again: ', SFinal(1, ss) = Sha3_256('abc'));
end.

