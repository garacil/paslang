program wrout;

var
  wg: waitgroup;

procedure W(K: Integer);
begin
  if K = 1 then
    WriteLn('aaaa')
  else if K = 2 then
    WriteLn('bbbb')
  else if K = 3 then
    WriteLn('cccc')
  else
    WriteLn('dddd');
  wg.Done;
end;

begin
  wg.Add(4);
  pas W(1);
  pas W(2);
  pas W(3);
  pas W(4);
  wg.Wait;
  WriteLn('done');
end.
