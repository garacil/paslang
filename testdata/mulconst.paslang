{ P295: a product by a constant is one or two adds, subs, negs, shifts
  or leas where that costs less than a multiply, as Go's recipes make
  it, the costs those of the processor -cpu or -tune names. Every
  constant from -1025 to 1025, every power of two and its neighbours
  either way round, and some large ones, times values at the edges of
  the integer, from a variable in a register, from an array's element,
  in place in a loop and in 32 bits; the output is 1.1.156's, which
  multiplied. Written by a script. }
program mulconst;

var
  xs: array[0..7] of Integer;
  a: array[0..0] of Integer;
  h: Integer;

{ the forms make check reads: x * 10 is two instructions on both
  machines, x * 641 two on arm64 tuned for Neoverse N1 (whose multiply
  takes 4 cycles) and a multiply where it takes 2, x * 1000003 a
  multiply everywhere }
function Ten(x: Integer): Integer;
begin
  Result := x * 10;
end;

function SixFortyOne(x: Integer): Integer;
begin
  Result := x * 641;
end;

function Large(x: Integer): Integer;
begin
  Result := x * 1000003;
end;

{ x a parameter, kept in a register }
function FromReg(x: Integer): Integer;
var
  t: Integer;
begin
  t := 0;
  t := t xor (x * -1025) + 55;
  t := t xor (x * -1024) + 54;
