{ in place on a variable a loop keeps in a register }
function InPlace(x: Integer): Integer;
var
  i, y, t: Integer;
begin
  t := 0;
  for i := 1 to 3 do
  begin
    y := x + i;
    y := y * -1025;
    t := t + y;
    y := x + i;
    y := y * -1018;
    t := t + y;
    y := x + i;
    y := y * -1011;
    t := t + y;
    y := x + i;
    y := y * -1004;
    t := t + y;
    y := x + i;
    y := y * -997;
    t := t + y;
    y := x + i;
    y := y * -990;
    t := t + y;
    y := x + i;
    y := y * -983;
    t := t + y;
    y := x + i;
    y := y * -976;
    t := t + y;
