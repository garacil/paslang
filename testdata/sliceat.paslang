{ P398: an element of a slice or a string held in a field of an object
  a register holds (of a record in it too), or in a global or a local
  on amd64, indexed by a constant or a word variable, takes the
  pointer and the length where they lie: the index checked against the
  length in memory, the pointer loaded after it, nothing pushed; a
  descriptor's nil test is a var parameter's alone. Reads, writes,
  addresses, Inc of an element, strings' characters; a call that
  shortens the field between two reads is still stopped by the next
  check; check_sliceat reads the forms. }
program sliceat;

type
  TLv = record
    Count: Integer;
    Items: array of Integer;
  end;

  TC = class
    A: array of Integer;
    S: string;
    Lv: TLv;
    function At(I: Integer): Integer;
    function AtK: Integer;
    procedure Put(I, V: Integer);
    function Addr(I: Integer): PInteger;
    function Ch(I: Integer): Char;
    function LvAt(I: Integer): Integer;
    function Sum: Integer;
    function Other(O: TC; I: Integer): Integer;
    procedure Shrink;
    function Guarded(I: Integer): Integer;
  end;

var
  ga: array of Integer;
  log: string;

function TC.At(I: Integer): Integer;
begin
  Result := A[I];
end;

function TC.AtK: Integer;
begin
  Result := A[2] + A[0];
end;

procedure TC.Put(I, V: Integer);
begin
  A[I] := V;
  Inc(A[I], 1000);
end;

function TC.Addr(I: Integer): PInteger;
begin
  Result := @A[I];
end;

function TC.Ch(I: Integer): Char;
begin
  Result := S[I];
end;

function TC.LvAt(I: Integer): Integer;
begin
  Result := Lv.Items[I] * 2;
  Lv.Items[I] := Result;
end;

function TC.Sum: Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i] * (i + 1);
end;

function TC.Other(O: TC; I: Integer): Integer;
begin
  Result := O.A[I] - A[I];
end;

procedure TC.Shrink;
begin
  SetLength(A, 2);
  log := log + 'shrunk ';
end;

{ the field's length read again after the call that shrank it }
function TC.Guarded(I: Integer): Integer;
begin
  Result := A[I];
  Shrink;
  if I < Length(A) then
    Result := Result + A[I]
  else
    Result := -Result;
end;

function Glob(I: Integer): Integer;
var
  loc: array of Integer;
  j: Integer;
begin
  SetLength(loc, 4);
  for j := 0 to 3 do
    loc[j] := j * 11;
  Result := ga[I] + loc[I] + ga[1] + loc[3];
  ga[I] := Result;
  Inc(loc[I], 5);
  Result := Result + loc[I];
end;

var
  c, d: TC;
  i: Integer;
  p: PInteger;

begin
  c := TC.Create;
  d := TC.Create;
  SetLength(c.A, 6);
  SetLength(d.A, 6);
  for i := 0 to 5 do
  begin
    c.A[i] := i * i;
    d.A[i] := 100 - i;
  end;
  c.S := 'paslang';
  SetLength(c.Lv.Items, 3);
  c.Lv.Items[0] := 4;
  c.Lv.Items[1] := -9;
  c.Lv.Items[2] := 21;
  WriteLn('at ', c.At(0), ' ', c.At(5), ' ', c.AtK);
  c.Put(3, 7);
  WriteLn('put ', c.At(3), ' sum ', c.Sum);
  p := c.Addr(4);
  p^ := p^ + 1;
  WriteLn('addr ', c.At(4), ' ', Integer(c.Addr(5)) - Integer(c.Addr(1)));
  WriteLn('ch ', c.Ch(1), c.Ch(7), c.Ch(4));
  WriteLn('lv ', c.LvAt(0), ' ', c.LvAt(1), ' ', c.LvAt(2), ' ', c.LvAt(1));
  WriteLn('other ', c.Other(d, 2), ' ', d.Other(c, 5));
  SetLength(ga, 4);
  for i := 0 to 3 do
    ga[i] := 1000 + i;
  WriteLn('glob ', Glob(0), ' ', Glob(2), ' ', ga[0], ' ', ga[2]);
  log := '';
  WriteLn('guarded ', c.Guarded(1), ' ', log);
  SetLength(c.A, 6);
  c.A[5] := 77;
  log := '';
  WriteLn('guarded ', c.Guarded(5), ' ', log);
end.
