program rtti;

type
  TBtn = class
  published
    FCap: string;
    FLeft: Integer;
    FOn: procedure of object;
    constructor Create;
    procedure Ping;
    property Caption: string read FCap write FCap;
    property Left: Integer read FLeft write FLeft;
    property OnClick: procedure of object read FOn write FOn;
  end;

var
  b: TBtn;
  n: Integer;

constructor TBtn.Create;
begin
  FCap := '';
  FLeft := 0;
end;

procedure TBtn.Ping;
begin
  n := n + 1;
end;

begin
  n := 0;
  b := TBtn.Create;
  SetPropStr(b, 'Caption', 'Go');
  WriteLn(GetPropStr(b, 'Caption'));
  SetPropInt(b, 'Left', 20);
  WriteLn(GetPropInt(b, 'Left'));
  WriteLn(PropKind(b, 'OnClick'));
  SetPropMeth(b, 'OnClick', b.Ping);
  CallProp(b, 'OnClick');
  WriteLn(n);
end.

