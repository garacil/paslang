{ P219 (1.1.103): a cycle wakes only the mark workers its work keeps
  busy, and a worker with nothing to take sleeps instead of spinning.
  Many small cycles with idle routines and every M a cycle may mark
  with: the process's CPU (getrusage, every thread) stays under twice
  the wall clock; the workers that woke for nothing spun until the end
  of every cycle and took eleven times it. Then a heap of trees built
  after them, a million nodes of 24 bytes, which four workers or more
  mark as soon as four may: on its first cycle what the cycle before
  scanned asks for few, and those that have more than they can scan ask
  for the rest (Enlist; with PASLANG_GC=off no cycle runs while the
  trees grow, so the first one has only that). The workers are threads
  the kernel runs: on a loaded machine one may wake after the marking it
  was asked for has ended (once under qemu in P272's chain, three of
  four), so the heap of trees is built again, up to three times, and
  four or more must have marked in one first cycle and in one next.
  Every node is still there, and alive for the collector. }
program markidle;

type
  PNode = ^TNode;
  TNode = record
    L, R: PNode;
    V: Integer;
  end;

var
  ch: chan of Integer;
  keep: PNode;
  trees: array of PNode;

procedure Idle;
var
  v: Integer;
begin
  v := Recv(ch);
end;

{ The CPU this process has used, user and system, in nanoseconds:
  getrusage is 98 on amd64 and 165 on arm64 (Go's zsysnum_linux_*.go),
  ru_utime and ru_stime its first four words. }
function CpuNs: Integer;
var
  ru: array[0..17] of Integer;
  r: Integer;
begin
  if Amd64 = 1 then
    r := Syscall(98, 0, @ru)
  else
    r := Syscall(165, 0, @ru);
  Result := (ru[0] + ru[2]) * 1000000000 + (ru[1] + ru[3]) * 1000;
end;

function MakeTree(Depth, V: Integer): PNode;
var
  p: PNode;
begin
  New(p);
  p^.V := V;
  if Depth > 0 then
  begin
    p^.L := MakeTree(Depth - 1, V * 2);
    p^.R := MakeTree(Depth - 1, V * 2 + 1);
  end;
  Result := p;
end;

{ The nodes of P whose value is where they are. }
function Count(P: PNode; V: Integer): Integer;
begin
  Result := 0;
  if (P <> nil) and (P^.V = V) then
    Result := 1 + Count(P^.L, V * 2) + Count(P^.R, V * 2 + 1);
end;

var
  i, k, c0, t0, cpu, wall, may, first, second, n, tries: Integer;
  q: PNode;
  firstOk, secondOk: Boolean;

begin
  ch := MakeChan();
  for i := 1 to 8 do
    pas Idle;
  keep := nil;
  for i := 1 to 2000 do
  begin
    New(q);
    q^.L := keep;
    q^.V := i;
    keep := q;
  end;
  GcCollect;
  c0 := CpuNs;
  t0 := Nanotime;
  for k := 1 to 500 do
  begin
    for i := 1 to 100 do
    begin
      New(q);
      q^.V := i;
    end;
    GcCollect;
  end;
  cpu := CpuNs - c0;
  wall := Nanotime - t0;
  WriteLn('500 small cycles: the CPU under twice the wall clock ', Ord(cpu < 2 * wall));

  SetLength(trees, 16);
  may := HeapStat(15);
  firstOk := False;
  secondOk := False;
  tries := 0;
  while (tries < 3) and not (firstOk and secondOk) do
  begin
    for i := 0 to 15 do
      trees[i] := MakeTree(15, i);
    GcCollect;
    first := HeapStat(14);
    GcCollect;
    second := HeapStat(14);
    firstOk := firstOk or (may < 4) or (first >= 4);
    secondOk := secondOk or (may < 4) or (second >= 4);
    tries := tries + 1;
  end;
  WriteLn('a heap of trees: four workers or more when four may, on its first cycle ',
    Ord(firstOk), ' and on the next ', Ord(secondOk));
  n := 0;
  for i := 0 to 15 do
    n := n + Count(trees[i], i);
  WriteLn('nodes ', n, ' all alive ', Ord(HeapStat(1) >= n * SizeOf(TNode)));
  for i := 1 to 8 do
    Send(ch, 0);
end.

