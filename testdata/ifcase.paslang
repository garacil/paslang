{ P305: an if without an else jumps over nothing, a case's arm is
  entered by its last test falling through, the last arm without an
  else falls to the end, and an Exit that ends a routine falls into its
  epilogue. Every if and case form, in loops and out of them, on
  integers, characters, enumerations, strings and labels past 32 bits;
  scripts/check_nextjump.py reads every golden program's assembly for a
  jump to the next instruction. }
program ifcase;

type
  TColor = (Red, Green, Blue, Cyan, Magenta);

function Ifs(n: Integer): Integer;
var
  i, a, b, c: Integer;
begin
  a := 0;
  b := 0;
  c := 0;
  for i := 1 to n do
  begin
    if i mod 3 = 0 then
      a := a + 1;
    if i mod 5 = 0 then
      b := b + i
    else
      b := b - 1;
    if i mod 7 = 0 then
    begin
      if i mod 2 = 0 then
        c := c + 100;
      c := c + 1;
    end;
    if i > n then
      a := a + 1000
    else
    begin
    end;
  end;
  Result := a * 1000000 + b * 1000 + c;
end;

function Kind(i: Integer): Integer;
begin
  case i of
    0: Result := 10;
    1, 2: Result := 20;
    3..5: Result := 30;
    6, 8..9: Result := 40;
    -20..-10, 100: Result := 50;
    5000000000: Result := 60;
    -5000000000..-4000000000: Result := 70;
  else
    Result := -1;
  end;
end;

function NoElse(i: Integer): Integer;
begin
  Result := 0;
  case i of
    1: Result := 1;
    2, 3: Result := 2;
    4..7: Result := 3;
  end;
end;

function Shade(c: TColor): Integer;
begin
  Result := 0;
  case c of
    Red: Result := 1;
    Green, Blue: Result := 2;
    Cyan..Magenta: Result := 3;
  end;
end;

function Letter(ch: Char): Integer;
begin
  case ch of
    'a'..'z': Result := 1;
    'A'..'Z': Result := 2;
    '0'..'9', '_': Result := 3;
  else
    Result := 0;
  end;
end;

function Named(const s: string): Integer;
begin
  case s of
    'one': Result := 1;
    'two', 'deux': Result := 2;
    'three': Result := 3;
  else
    Result := 0;
  end;
end;

function NamedNoElse(const s: string): Integer;
begin
  Result := -1;
  case s of
    'x': Result := 10;
    'y', 'z': Result := 20;
  end;
end;

{ an Exit that ends the routine, and one that ends its last case arm }
function Ends(i: Integer): Integer;
begin
  Result := i;
  if i < 0 then
  begin
    Result := -i;
    Exit;
  end;
  case i of
    0: Result := 100;
    1:
      begin
        Result := 200;
        Exit;
      end;
  end;
  Result := Result + 1;
  Exit;
end;

var
  i, t: Integer;
  ch: Char;
begin
  WriteLn(Ifs(0), ' ', Ifs(1), ' ', Ifs(1000));
  t := 0;
  for i := -25 to 15 do
    t := t * 3 + Kind(i) + 7;
  WriteLn(t, ' ', Kind(100), ' ', Kind(5000000000), ' ', Kind(-4500000000), ' ', Kind(-3999999999));
  t := 0;
  for i := -1 to 9 do
    t := t * 5 + NoElse(i);
  WriteLn(t);
  WriteLn(Shade(Red), Shade(Green), Shade(Blue), Shade(Cyan), Shade(Magenta));
  t := 0;
  for ch := ' ' to '~' do
    t := t * 2 + Letter(ch) mod 7;
  WriteLn(t);
  WriteLn(Named('one'), Named('two'), Named('deux'), Named('three'), Named('four'), Named(''));
  WriteLn(NamedNoElse('x'), ' ', NamedNoElse('z'), ' ', NamedNoElse('w'));
  WriteLn(Ends(-5), ' ', Ends(0), ' ', Ends(1), ' ', Ends(2));
end.
