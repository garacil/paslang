program currencyfrontendmodel;
uses sysutils;
type TWords = array[0..1] of Integer;
var count, i, a, b, n, code, bits, point, otherPoint: Integer;
  value, left, right: Currency; operation, text, formatted, fraction, significant: string;
  realValue: Double; quadValue: Quad; words: TWords; valid: Boolean;
  settings: TFormatSettings; decimalValue: TFloatRec;

function ReadInteger: Integer;
var input: string; error: Integer;
begin
  ReadLn(input); Val(input, Result, error);
  if error <> 0 then Halt(2);
end;

begin
  settings := DefaultFormatSettings;
  settings.DecimalSeparator := '.'; settings.ThousandSeparator := ',';
  count := ReadInteger;
  for i := 1 to count do
  begin
    ReadLn(operation); ReadLn(text); b := ReadInteger; n := ReadInteger;
    try
      if operation = 'parse' then
      begin
        valid := TryStrToCurr(text, value, settings);
        if not valid then begin WriteLn('parse error ', CurrencyToScaled(value)); Continue end;
      end
      else
      begin
        Val(text, a, code); if code <> 0 then Halt(3);
        left := CurrencyFromScaled(a); right := CurrencyFromScaled(b);
        if operation = 'add' then value := left + right
        else if operation = 'sub' then value := left - right
        else if operation = 'mul' then value := left * right
        else if operation = 'div' then value := left / right
        else if operation = 'neg' then value := -left
        else if operation = 'abs' then value := Abs(left)
        else if operation = 'int' then value := Currency(a)
        else if operation = 'real' then
        begin realValue := a as Double; value := Currency(realValue) end
        else if operation = 'quad' then
        begin words[0] := a; words[1] := b; quadValue := words as Quad; value := Currency(quadValue) end
        else if operation = 'scaled' then value := left
        else Halt(4);
      end;
      if Currency(Quad(value)) <> value then Halt(6);
      realValue := Double(value); bits := realValue as Integer;
      Str(value:0:n, formatted);
      if formatted <> CurrToStrF(value, ffFixed, n, settings) then Halt(5);
      WriteLn(CurrencyToScaled(value), ' ', CurrToStr(value, settings), ' ',
        formatted, ' ', bits, ' ', Trunc(value), ' ', Round(value), ' ', Floor(value), ' ', Ceil(value));
      fraction := PasCurrencyDigits(CurrencyToScaled(value), 0, 0, point);
      FloatToDecimal(decimalValue, value, 7, 4);
      significant := ''; otherPoint := decimalValue.Exponent;
      for code := 0 to High(decimalValue.Digits) do
      begin
        if decimalValue.Digits[code] = #0 then Break;
        significant := significant + decimalValue.Digits[code];
      end;
      WriteLn('[', fraction, '] ', point, ' [', significant, '] ', otherPoint);
    except
      on error: ECurrencyError do WriteLn('fault ', Ord(error.Kind));
    end;
  end;
end.
