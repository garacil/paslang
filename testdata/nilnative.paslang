{ P568: two faults that only a run on the processor itself shows, so
  this test is amd64's alone.

  An address that is not in canonical form. The processor refuses it
  with a general-protection fault and not a page fault (SDM vol. 1,
  3.3.7.1), and the kernel sends SIGSEGV with the code SI_KERNEL and no
  address (Linux 7.2 arch/x86/kernel/traps.c, gp_user_force_sig_segv).
  The runtime says so, where the address field, zero, would say a nil
  pointer: EAccessViolation, invalid memory address at line N, with no
  address. Read, written, called as a procedure variable (the call
  itself is refused, at its own pc), and in a loop that keeps its
  variables in registers. arm64's kernel tells the address of every such
  fault (arch/arm64/mm/fault.c, do_bad_area), and it is another address
  there as any other.

  A call of a page of code whose file was cut short: a call of nothing
  that is a bus error, EBusError with the call's line. The emulator
  that runs arm64's tests reads that page itself to translate it, and
  dies of it.

  With one argument it dies of kind K with no try, for the recipe to
  compare the runtime's line with the Message. }
program nilnative;

uses
  sysutils;

type
  PNode = ^TNode;
  TNode = record
    V: Int64;
    Next: PNode;
  end;
  TStep = procedure;

var
  far: PNode;
  go, gone: TStep;
  k, i, total: Int64;

{ a page of a file mapped to be run and the file then cut to nothing
  (mmap(2): SIGBUS for a page past the end of the file). The system
  calls by their numbers (asm/unistd_64.h): getpid, openat with O_CREAT,
  O_RDWR and O_TRUNC, ftruncate, mmap PROT_READ and PROT_EXEC and
  MAP_SHARED, close, unlinkat. }
function CutCode: Pointer;
var
  fd, r: Int64;
  name: string;
begin
  r := Syscall(39);
  name := '/tmp/nilnative-' + IntToStr(r) + '.bin' + #0;
  fd := Syscall(257, -100, @name[1], 578, 448);
  r := Syscall(77, fd, 4096);
  Result := Pointer(Syscall(9, 0, 4096, 5, 1, fd, 0));
  r := Syscall(77, fd, 0);
  r := Syscall(3, fd);
  r := Syscall(263, -100, @name[1], 0);
end;

procedure Fail(K: Int64);
begin
  case K of
    1: WriteLn(far^.V);
    2: far^.V := 5;
    3: go();
    4: gone();
  end;
end;

begin
  { eight letters where a pointer was: bits 63 to 47 are not all the same }
  far := PNode(Pointer($4847464544434241 + Ord(ParamCount > 99)));
  go := TStep(Pointer(far));
  gone := TStep(CutCode);
  if ParamCount = 1 then
  begin
    Fail(StrToInt(ParamStr(1)));
    WriteLn('not reached');
    Halt(0);
  end;
  for k := 1 to 4 do
    try
      Fail(k);
      WriteLn('not raised');
    except
      on e: EAccessViolation do
      begin
        WriteLn('paslang: ', e.Message);
        if e is EBusError then
          WriteLn('a bus error by its class');
      end;
    end;
  total := 0;
  try
    for i := 1 to 10 do
    begin
      total := total + i;
      if i = 7 then
        total := total + far^.V;
    end;
  except
    on e: EAccessViolation do
      WriteLn('a loop: i ', i, ' total ', total, ', ', e.Message);
  end;
  WriteLn('done');
end.

