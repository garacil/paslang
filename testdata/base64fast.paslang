{ P451: Base64Encode and Base64Decode of pascodec against the first versions
  written (a symbol at a time through string indexes, P435, checked against Go's
  encoding/base64 by testdata/codec), which are copied here as RefEncode and
  RefDecode. Random bytes of every length to 400 in the four forms; the
  texts of the decoder with CR and LF put in at random places, a symbol
  changed, a symbol taken out and a text cut short, which go the slow way
  and mix with the quantum at a time; and a buffer of 3 MB + 2 bytes whose
  encodings and decoding are printed as sums. The reference and the unit
  must agree on every text, the flag and the bytes. }
program base64fast;

uses
  pascodec;

const
  RefStd: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
  RefUrl: string = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_';

function RefEncode(const S: string; Url, Pad: Boolean): string;
var
  i, n, v, k: Integer;
  al: string;
begin
  if Url then
    al := RefUrl
  else
    al := RefStd;
  n := Length(S);
  SetLength(Result, ((n + 2) div 3) * 4);
  k := 0;
  i := 1;
  while i + 2 <= n do
  begin
    v := (Ord(S[i]) shl 16) or (Ord(S[i + 1]) shl 8) or Ord(S[i + 2]);
    Result[k + 1] := al[(v shr 18) + 1];
    Result[k + 2] := al[((v shr 12) and 63) + 1];
    Result[k + 3] := al[((v shr 6) and 63) + 1];
    Result[k + 4] := al[(v and 63) + 1];
    k := k + 4;
    i := i + 3;
  end;
  if n - i = 1 then
  begin
    v := (Ord(S[i]) shl 16) or (Ord(S[i + 1]) shl 8);
    Result[k + 1] := al[(v shr 18) + 1];
    Result[k + 2] := al[((v shr 12) and 63) + 1];
    Result[k + 3] := al[((v shr 6) and 63) + 1];
    if Pad then
    begin
      Result[k + 4] := '=';
      k := k + 4;
    end
    else
      k := k + 3;
  end
  else if n - i = 0 then
  begin
    v := Ord(S[i]) shl 16;
    Result[k + 1] := al[(v shr 18) + 1];
    Result[k + 2] := al[((v shr 12) and 63) + 1];
    if Pad then
    begin
      Result[k + 3] := '=';
      Result[k + 4] := '=';
      k := k + 4;
    end
    else
      k := k + 2;
  end;
  SetLength(Result, k);
end;

function RefVal(C: Char; Url: Boolean): Integer;
begin
  case C of
    'A'..'Z': Result := Ord(C) - 65;
    'a'..'z': Result := Ord(C) - 71;
    '0'..'9': Result := Ord(C) + 4;
    '+': if Url then Result := -1 else Result := 62;
    '/': if Url then Result := -1 else Result := 63;
    '-': if Url then Result := 62 else Result := -1;
    '_': if Url then Result := 63 else Result := -1;
  else
    Result := -1;
  end;
end;

function RefDecode(const S: string; Url, Pad: Boolean; out R: string): Boolean;
var
  i, n, k, d, cnt, v, pads, w: Integer;
  c: Char;
begin
  Result := False;
  R := '';
  n := Length(S);
  SetLength(R, (n div 4) * 3 + 3);
  k := 0;
  cnt := 0;
  v := 0;
  pads := 0;
  i := 1;
  while i <= n do
  begin
    c := S[i];
    i := i + 1;
    if (c = #13) or (c = #10) then
      Continue;
    if c = '=' then
    begin
      { only when padding is on, after two or three symbols of a quantum,
        and then up to the quantum's end, and the text ends there }
      if (not Pad) or (cnt < 2) then
      begin
        R := '';
        Exit;
      end;
      pads := 1;
      w := cnt + 1;
      while w < 4 do
      begin
        while (i <= n) and ((S[i] = #13) or (S[i] = #10)) do
          i := i + 1;
        if (i > n) or (S[i] <> '=') then
        begin
          R := '';
          Exit;
        end;
        i := i + 1;
        w := w + 1;
      end;
      while (i <= n) and ((S[i] = #13) or (S[i] = #10)) do
        i := i + 1;
      if i <= n then
      begin
        R := '';
        Exit;
      end;
      Break;
    end;
    d := RefVal(c, Url);
    if d < 0 then
    begin
      R := '';
      Exit;
    end;
    v := (v shl 6) or d;
    cnt := cnt + 1;
    if cnt = 4 then
    begin
      R[k + 1] := Chr((v shr 16) and 255);
      R[k + 2] := Chr((v shr 8) and 255);
      R[k + 3] := Chr(v and 255);
      k := k + 3;
      cnt := 0;
      v := 0;
    end;
  end;
  if pads = 0 then
  begin
    { no padding: a last quantum of two or three symbols (Go: when Pad
      is on a short last quantum is an error) }
    if cnt = 1 then
    begin
      R := '';
      Exit;
    end;
    if (cnt > 0) and Pad then
    begin
      R := '';
      Exit;
    end;
  end;
  if cnt = 2 then
  begin
    R[k + 1] := Chr((v shr 4) and 255);
    k := k + 1;
  end
  else if cnt = 3 then
  begin
    R[k + 1] := Chr((v shr 10) and 255);
    R[k + 2] := Chr((v shr 2) and 255);
    k := k + 2;
  end;
  SetLength(R, k);
  Result := True;
end;

var
  GS: Integer;

function GNext: Integer;
var
  z: Integer;
begin
  GS := GS + Integer($9E3779B97F4A7C15);
  z := GS;
  z := (z xor (z shr 30)) * Integer($BF58476D1CE4E5B9);
  z := (z xor (z shr 27)) * Integer($94D049BB133111EB);
  Result := z xor (z shr 31);
end;

function Rnd(N: Integer): Integer;
begin
  Result := (GNext shr 1) mod N;
end;

function Hex8(V: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, 8);
  for i := 8 downto 1 do
  begin
    Result[i] := Copy('0123456789abcdef', (V and 15) + 1, 1)[1];
    V := V shr 4;
  end;
end;

var
  cases, bad, len, form, i, j, k, e: Integer;
  b, s, t, d1, d2: string;
  url, pad, ok1, ok2: Boolean;
  big, enc: string;
begin
  GS := 4511;
  cases := 0;
  bad := 0;
  for len := 0 to 400 do
    for form := 0 to 3 do
    begin
      url := (form and 1) <> 0;
      pad := (form and 2) <> 0;
      SetLength(b, len);
      for i := 1 to len do
        b[i] := Chr(Rnd(256));
      s := Base64Encode(b, url, pad);
      cases := cases + 1;
      if s <> RefEncode(b, url, pad) then
        bad := bad + 1;
      { the decoder on the encoding and on texts made from it }
      for e := 0 to 5 do
      begin
        t := s;
        case e of
          1:
            for k := 1 to 1 + Rnd(4) do
            begin
              j := 1 + Rnd(Length(t) + 1);
              if Rnd(2) = 0 then
                t := Copy(t, 1, j - 1) + #13#10 + Copy(t, j, Length(t))
              else
                t := Copy(t, 1, j - 1) + #10 + Copy(t, j, Length(t));
            end;
          2:
            if Length(t) > 0 then
            begin
              j := 1 + Rnd(Length(t));
              t[j] := Chr(Rnd(256));
            end;
          3:
            if Length(t) > 0 then
            begin
              j := 1 + Rnd(Length(t));
              t := Copy(t, 1, j - 1) + Copy(t, j + 1, Length(t));
            end;
          4:
            t := Copy(t, 1, Rnd(Length(t) + 1));
          5:
            for k := 1 to Length(t) div 76 do
              t := Copy(t, 1, k * 76 + k * 2 - 2) + #13#10 + Copy(t, k * 76 + k * 2 - 1, Length(t));
        end;
        ok1 := Base64Decode(t, url, pad, d1);
        ok2 := RefDecode(t, url, pad, d2);
        cases := cases + 1;
        if (ok1 <> ok2) or (d1 <> d2) then
        begin
          bad := bad + 1;
          if bad <= 5 then
            WriteLn('differs: len ', len, ' form ', form, ' kind ', e);
        end;
        if (e = 0) and (not ok1 or (d1 <> b)) then
        begin
          bad := bad + 1;
          WriteLn('no round trip: len ', len, ' form ', form);
        end;
      end;
    end;
  WriteLn('cases ', cases, ' mismatches ', bad);
  { a buffer of 3 MB and two bytes }
  SetLength(big, 3 * 1024 * 1024 + 2);
  for i := 1 to Length(big) do
    big[i] := Chr((i * 7 + (i shr 9)) and 255);
  WriteLn('big crc ', Hex8(Crc32(big)), ' length ', Length(big));
  for form := 0 to 3 do
  begin
    url := (form and 1) <> 0;
    pad := (form and 2) <> 0;
    enc := Base64Encode(big, url, pad);
    ok1 := Base64Decode(enc, url, pad, d1);
    WriteLn('form ', form, ' encoded ', Length(enc), ' crc ', Hex8(Crc32(enc)), ' decoded ', ok1, ' ', d1 = big);
  end;
  { the same text with a line break every 76 symbols, as mail has it }
  enc := Base64Encode(big, False, True);
  t := '';
  i := 1;
  while i <= Length(enc) do
  begin
    t := t + Copy(enc, i, 76) + #13#10;
    i := i + 76;
  end;
  ok1 := Base64Decode(t, False, True, d1);
  WriteLn('wrapped ', Length(t), ' decoded ', ok1, ' ', d1 = big);
end.
