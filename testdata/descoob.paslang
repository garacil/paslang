{ P556: an index past the length of an open array that arrives by reference
  is stopped where it is read, with the length the array has then: the
  array empty (a nil descriptor), shrunk by a call in the loop, replaced by
  a shorter one by an assignment with no call, zeroed with the record it is in, indexed past its end in a loop that has
  one register left. The scenario is the first argument. }
program descoob;

type
  TArr = array of Int64;
  TBox = record
    F: TArr;
    N: Int64;
  end;

var
  G, H: TArr;
  GB: TBox;

procedure Shrink(var A: TArr; n: Integer);
begin
  SetLength(A, n);
end;

function Walk(var A: TArr; n: Integer): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to n do
    Result := Result + A[i];
end;

function WalkShrink(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 3 then
      Shrink(A, 2);
  end;
end;

function WalkGlobal(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 3 then
      G := H;
  end;
end;

function Bump(k: Int64): Int64;
begin
  Result := k + 1;
end;

{ four values and the loop's own take all but one of the registers: the
  length of the array is read where it lies }
function Squeeze(var A: TArr; k: Int64; hi: Integer): Int64;
var
  i, rd: Integer;
  s1, s2, s3, s4: Int64;
begin
  s1 := k; s2 := k + 1; s3 := k + 2; s4 := k + 3;
  for rd := 0 to 2 do
  begin
    for i := 0 to hi do
    begin
      s1 := s1 + A[i] + s2;
      s2 := s2 xor s1 + s3;
      s3 := s3 + s2 xor s4;
      s4 := s4 + s3 - s1;
      s1 := s1 xor s4 + s1;
      s1 := s1 + s1 xor A[hi - i];
      s2 := s2 + s1 + s3;
      s3 := s3 xor s2 + s4;
      s4 := s4 + s3 xor s1;
      s1 := s1 + s4 + s1;
    end;
    s1 := Bump(s1);
  end;
  Result := s1 + s2 + s3 + s4;
end;

{ the record the array is in, zeroed in line }
function WalkZero(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to 9 do
  begin
    Result := Result + A[i];
    if i = 3 then
      FillChar(GB, SizeOf(GB), 0);
  end;
end;

var
  E: TArr;
begin
  SetLength(GB.F, 10);
  SetLength(G, 10);
  SetLength(H, 3);
  if ParamStr(1) = '1' then
    WriteLn(Walk(E, 0))
  else if ParamStr(1) = '2' then
    WriteLn(WalkShrink(G))
  else if ParamStr(1) = '4' then
    WriteLn(WalkZero(GB.F))
  else if ParamStr(1) = '5' then
    WriteLn(Squeeze(G, 3, 10))
  else
    WriteLn(WalkGlobal(G));
end.
