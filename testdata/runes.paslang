program runes;

var
  s: string;
  r: Rune;
  n: Integer;

begin
  s := 'Aé你';
  n := 0;
  for r in s do
  begin
    WriteLn(r);
    n := n + 1;
  end;
  WriteLn(n);
  s := 'hi'#255;
  n := 0;
  for r in s do
  begin
    WriteLn(r);
    n := n + 1;
  end;
  WriteLn(n);
  s := '';
  n := 0;
  for r in s do
    n := n + 1;
  WriteLn(n);
  s := 'ab';
  n := 0;
  for r in s do
  begin
    if r = 97 then
      Continue;
    n := n + r;
    if r = 98 then
      Break;
  end;
  WriteLn(n);
  s := '😀';
  for r in s do
    WriteLn(r);
  WriteLn(Length(s));
  s := #194#128;
  for r in s do
    WriteLn(r);
  s := #237#160#128;
  n := 0;
  for r in s do
  begin
    WriteLn(r);
    n := n + 1;
  end;
  WriteLn(n);
  n := 0;
  for r in 'A' + 'B' do
    n := n + r;
  WriteLn(n);
end.

