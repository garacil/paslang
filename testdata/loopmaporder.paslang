{ P591: deferred cooperative checks retain complete maps in code order.
  Empty dual asm disables asynchronous stops without emitting instructions.
  Calls remain calls at inline 40; AddIsland also tests actual inlining. }
program loopmaporder;
uses SysUtils;

type
  TLoopNode = class
    N: Integer;
  end;

var
  Collections, WorkerResult: Integer;
  Workers: waitgroup;

procedure Check(OK: Boolean; const Name: string);
begin
  if not OK then begin WriteLn('FAIL ', Name); Halt(1); end;
end;

function NextValue591(X: Integer): Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  Result := X + 1;
end;

function Eight591(A, B, C, D, E, F, G, H: Integer): Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  Result := A + B + C + D + E + F + G + H;
end;

function WorkRepeat(N: Integer): Integer;
var I, S: Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  I := 0; S := 0;
  repeat
    S := S + I;
    I := NextValue591(I);
  until I >= N;
  Result := S;
end;

function WorkPost(N: Integer): Integer;
var I, S: Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  I := 0; S := 0;
  while I < N do begin S := S + I; I := NextValue591(I); end;
  S := NextValue591(S);
  Result := S;
end;

function WorkNested(N: Integer): Integer;
var I, J, S: Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  I := 0; S := 0;
  while I < N do
  begin
    J := 0;
    while J < 3 do begin S := S + I + J; Inc(J); end;
    I := NextValue591(I);
  end;
  Result := S;
end;

function WorkRegions(N: Integer): Integer;
var I, J, S: Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  I := 0; S := 0;
  repeat S := S + I; I := NextValue591(I); until I >= N;
  { A real boundary between separate promoted regions, with no opcode. }
  asm amd64
  end;
  asm arm64
  end;
  J := 0;
  repeat S := S + NextValue591(J); Inc(J); until J >= N;
  Result := S;
end;

procedure AddIsland591(var S: Integer; Base: Integer); inline;
var J: Integer;
begin
  J := 0;
  repeat
    S := S + Eight591(Base, J, 1, 2, 3, 4, 5, 6);
    J := NextValue591(J);
  until J >= 3;
end;

function WorkIslands(N: Integer): Integer;
var I, S: Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  I := 0; S := 0;
  repeat
    S := S + I;
    if NextValue591(I) > 0 then AddIsland591(S, I);
    I := NextValue591(I);
  until I >= N;
  Result := S;
end;

function ColdRead(N, Slot: Integer): Integer;
var I, S: Integer; A: array[0..3] of Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  A[0] := 2; A[1] := 3; A[2] := 5; A[3] := 7;
  I := 0; S := 0;
  repeat S := S + A[Slot]; I := NextValue591(I); until I >= N;
  Result := S;
end;

function Deep591(N: Integer): Integer;
var Pad: array[0..63] of Integer;
begin
  Pad[N and 63] := N;
  if N = 0 then Result := 0
  else Result := Deep591(N - 1) + Pad[N and 63] - N + 1;
end;

procedure Pulse591(N: Integer);
var Temporary: TLoopNode; Text: string;
begin
  Temporary := TLoopNode.Create; Temporary.N := N;
  Text := 'collection ' + IntToStr(Temporary.N);
  while GcCollect <> 1 do Sleep(1);
  Inc(Collections);
  Check(Length(Text) >= 12, 'allocated value survives explicit collection');
end;

function WorkRoots: Integer;
var
  Node: TLoopNode;
  Text: string;
  A: array[0..3] of Integer;
  P: ^Integer;
  I, S: Integer;
begin
  asm amd64
  end;
  asm arm64
  end;
  Node := TLoopNode.Create; Node.N := 73;
  Text := StringOfChar('q', 19);
  A[2] := 11; P := @A[2]; S := 0;
  for I := 0 to 3 do
  begin
    S := S + P^ + Node.N;
    Check(Deep591(128) = 128, 'recursive stack growth result');
    Pulse591(I);
    Check((Length(Text) = 19) and (Text[19] = 'q'), 'held string after collection');
    Inc(P^);
  end;
  Check((P^ = 15) and (Node.N = 73), 'stack interior pointer and held object');
  Result := S + A[2];
end;

procedure Worker591;
begin
  WorkerResult := WorkRoots;
  Workers.Done;
end;

var BeforeMoves: Integer;
begin
  Check(WorkRepeat(7 + ParamCount) = 21, 'repeat call island');
  Check(WorkPost(7 + ParamCount) = 22, 'post-loop hot call');
  Check(WorkNested(7 + ParamCount) = 84, 'nested cooperative loops');
  Check(WorkRegions(7 + ParamCount) = 49, 'multiple promoted regions');
  Check(WorkIslands(4 + ParamCount) = 288, 'nested and inlined island');
  Check(ColdRead(4, 2 + ParamCount) = 20, 'final cold bounds block');
  Collections := 0;
  BeforeMoves := HeapStat(13);
  Workers.Add(1);
  pas Worker591;
  Workers.Wait;
  Check((WorkerResult = 357) and (Collections = 4), 'worker GC and value progress');
  Check(HeapStat(13) > BeforeMoves, 'worker stack actually grew');
  WriteLn('loopmaporder ok');
end.

