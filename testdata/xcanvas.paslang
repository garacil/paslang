program xcanvas;

uses
  paslinux, pasx11;

function KindOf(const E: string): Integer;
begin
  Result := Ord(E[1]) and 127;
end;

function EvX(const E: string): Integer;
begin
  Result := Ord(E[25]) or (Ord(E[26]) shl 8);
end;

function EvY(const E: string): Integer;
begin
  Result := Ord(E[27]) or (Ord(E[28]) shl 8);
end;

var
  x: TX11;
  win, gc, pix: Int64;
  ev, clip: string;
  sawEx, sawPress, sawMove, sawRel: Boolean;
  tw, i, k: Integer;

begin
  x := TX11.Create;
  if not x.Connect then
  begin
    WriteLn('no display');
    Halt(1);
  end;
  x.LoadFont;
  tw := x.TextWidth('Hi');
  if (tw > 0) and (x.Ascent > 0) and
    (x.TextWidth('H') + x.TextWidth('i') = tw) and
    (x.TextWidth('') = 0) then
    WriteLn('ok metrics');
  win := x.CreateWin(160, 80);
  gc := x.CreateGc(win);
  x.MapWin(win);
  sawEx := False;
  for i := 1 to 30 do
  begin
    ev := x.NextEvent;
    if Length(ev) < 32 then
      Break;
    if KindOf(ev) = 12 then
      sawEx := True;
    if sawEx then
      Break;
  end;
  if sawEx then
    WriteLn('ok expose');
  { The window says what it is, so a desktop treats it as an
    application: a name, a class, a kind and the close protocol. }
  x.SetTitle(win, 'xcanvas');
  x.SetClass(win, 'xcanvas', 'Xcanvas');
  x.SetWinType(win);
  x.SetProtocols(win);
  x.RaiseWin(win);
  x.Activate(win);
  if x.Sync then
    if (x.TakeProp(win, 39) = 'xcanvas') and
      (x.TakeProp(win, 67) = 'xcanvas' + #0 + 'Xcanvas' + #0) and
      (x.DeleteAtom <> 0) and (x.LastErr = 0) then
      WriteLn('ok wmhints');
  x.SendClick(win, 4, 1, 10, 12);
  x.SendClick(win, 6, 1, 40, 20);
  x.SendClick(win, 5, 1, 40, 20);
  x.SendKey(win, 24);
  if not x.Sync then
    WriteLn('no sync');
  sawPress := False;
  sawMove := False;
  sawRel := False;
  while x.Queued > 0 do
  begin
    ev := x.NextEvent;
    if Length(ev) < 32 then
      Break;
    k := KindOf(ev);
    if (k = 4) and (EvX(ev) = 10) and (EvY(ev) = 12) then
      sawPress := True
    else if (k = 6) and (EvX(ev) = 40) and (EvY(ev) = 20) then
      sawMove := True
    else if (k = 5) and (EvX(ev) = 40) then
      sawRel := True;
  end;
  if sawPress then
    WriteLn('ok click');
  if sawMove and sawRel then
    WriteLn('ok drag');
  if x.Keysym(24) <> 0 then
    WriteLn('ok keysym');
  clip := x.ClipRound(win, 'hello-clip');
  if clip = 'hello-clip' then
    WriteLn('ok clip');
  x.SetClip(gc, 0, 0, 100, 50);
  x.FillRect(win, gc, 8, 8, 40, 24, x.Black);
  x.DrawText(win, gc, 12, 24, 'Go', x.White);
  x.DrawLine(win, gc, 8, 36, 48, 36, x.Black);
  if x.Sync then
  begin
    pix := x.PixelAt(win, 12, 12);
    if (x.LastErr = 0) and (pix = x.Black) then
      WriteLn('ok fill');
  end;
  Sys1(3, x.Fd);
end.
