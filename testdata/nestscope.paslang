{ A name declared inside a routine hides what is declared around it,
  whatever the kinds of the two (P159), as in Free Pascal: a nested
  function, a variable, a constant and a type of routine Q hide a
  global variable, constant, type or routine (G..) or one of routine P
  around Q (R..) of the name; Q writes its own, P the one around. A
  global variable was read in silence where a nested function of its
  name was called, and the other kinds were refused. A variable may
  not take a routine's name (P151), so those two are not here. The
  output is Free Pascal's. }
program nestscope;

{$mode objfpc}{$H+}

type
  GTP = array[1..10] of Byte;
  GTV = array[1..11] of Byte;
  GTC = array[1..12] of Byte;
  GTT = array[1..13] of Byte;

const
  GCP = 105;
  GCV = 106;
  GCC = 107;
  GCT = 108;

var
  GVP: Int64;
  GVV: Int64;
  GVC: Int64;
  GVT: Int64;

function GPP: Int64;
begin
  Result := 113;
end;

function GPC: Int64;
begin
  Result := 114;
end;

function GPT: Int64;
begin
  Result := 115;
end;

procedure P;
  type
    RTP = array[1..25] of Byte;
    RTV = array[1..26] of Byte;
    RTC = array[1..27] of Byte;
    RTT = array[1..28] of Byte;

  const
    RCP = 120;
    RCV = 121;
    RCC = 122;
    RCT = 123;

  var
    RVP: Int64;
    RVV: Int64;
    RVC: Int64;
    RVT: Int64;

  function RPP: Int64;
  begin
    Result := 128;
  end;

  function RPC: Int64;
  begin
    Result := 129;
  end;

  function RPT: Int64;
  begin
    Result := 130;
  end;

  procedure Q;
    type
      GVT = array[1..5] of Byte;
      GCT = array[1..9] of Byte;
      GTT = array[1..13] of Byte;
      GPT = array[1..16] of Byte;
      RVT = array[1..20] of Byte;
      RCT = array[1..24] of Byte;
      RTT = array[1..28] of Byte;
      RPT = array[1..31] of Byte;

    const
      GVC = 203;
      GCC = 207;
      GTC = 211;
      GPC = 214;
      RVC = 218;
      RCC = 222;
      RTC = 226;
      RPC = 229;

    var
      GVV: Int64;
      GCV: Int64;
      GTV: Int64;
      RVV: Int64;
      RCV: Int64;
      RTV: Int64;

    function GVP: Int64;
    begin
      Result := 201;
    end;

    function GCP: Int64;
    begin
      Result := 205;
    end;

    function GTP: Int64;
    begin
      Result := 209;
    end;

    function GPP: Int64;
    begin
      Result := 213;
    end;

    function RVP: Int64;
    begin
      Result := 216;
    end;

    function RCP: Int64;
    begin
      Result := 220;
    end;

    function RTP: Int64;
    begin
      Result := 224;
    end;

    function RPP: Int64;
    begin
      Result := 228;
    end;

  begin
    WriteLn('GVP ', GVP);
    GVV := 202;
    WriteLn('GVV ', GVV);
    WriteLn('GVC ', GVC);
    WriteLn('GVT ', SizeOf(GVT));
    WriteLn('GCP ', GCP);
    GCV := 206;
    WriteLn('GCV ', GCV);
    WriteLn('GCC ', GCC);
    WriteLn('GCT ', SizeOf(GCT));
    WriteLn('GTP ', GTP);
    GTV := 210;
    WriteLn('GTV ', GTV);
    WriteLn('GTC ', GTC);
    WriteLn('GTT ', SizeOf(GTT));
    WriteLn('GPP ', GPP);
    WriteLn('GPC ', GPC);
    WriteLn('GPT ', SizeOf(GPT));
    WriteLn('RVP ', RVP);
    RVV := 217;
    WriteLn('RVV ', RVV);
    WriteLn('RVC ', RVC);
    WriteLn('RVT ', SizeOf(RVT));
    WriteLn('RCP ', RCP);
    RCV := 221;
    WriteLn('RCV ', RCV);
    WriteLn('RCC ', RCC);
    WriteLn('RCT ', SizeOf(RCT));
    WriteLn('RTP ', RTP);
    RTV := 225;
    WriteLn('RTV ', RTV);
    WriteLn('RTC ', RTC);
    WriteLn('RTT ', SizeOf(RTT));
    WriteLn('RPP ', RPP);
    WriteLn('RPC ', RPC);
    WriteLn('RPT ', SizeOf(RPT));
  end;

begin
  RVP := 116;
  RVV := 117;
  RVC := 118;
  RVT := 119;
  Q;
  WriteLn('GVP ', GVP);
  WriteLn('GVV ', GVV);
  WriteLn('GVC ', GVC);
  WriteLn('GVT ', GVT);
  WriteLn('GCP ', GCP);
  WriteLn('GCV ', GCV);
  WriteLn('GCC ', GCC);
  WriteLn('GCT ', GCT);
  WriteLn('GTP ', SizeOf(GTP));
  WriteLn('GTV ', SizeOf(GTV));
  WriteLn('GTC ', SizeOf(GTC));
  WriteLn('GTT ', SizeOf(GTT));
  WriteLn('GPP ', GPP);
  WriteLn('GPC ', GPC);
  WriteLn('GPT ', GPT);
  WriteLn('RVP ', RVP);
  WriteLn('RVV ', RVV);
  WriteLn('RVC ', RVC);
  WriteLn('RVT ', RVT);
  WriteLn('RCP ', RCP);
  WriteLn('RCV ', RCV);
  WriteLn('RCC ', RCC);
  WriteLn('RCT ', RCT);
  WriteLn('RTP ', SizeOf(RTP));
  WriteLn('RTV ', SizeOf(RTV));
  WriteLn('RTC ', SizeOf(RTC));
  WriteLn('RTT ', SizeOf(RTT));
  WriteLn('RPP ', RPP);
  WriteLn('RPC ', RPC);
  WriteLn('RPT ', RPT);
end;

begin
  GVP := 101;
  GVV := 102;
  GVC := 103;
  GVT := 104;
  P;
end.

