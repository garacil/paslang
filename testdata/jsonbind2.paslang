{ P206: a value of any type with a JSON form read by JsonDecode, through
  the decoder the compiler writes for its type: what JsonEncode writes
  reads back the same, from the text and from a json; null gives the
  zero, an absent member stays zero, Merge reads into what is there as
  Go's v2 does; every kind of member (integers in their range, reals
  rounded once, Quad, Currency exact, Char, enumerations, sets, bytes
  in base64, maps and trees by each kind of key, records, classes made
  with their Create, pointers, embed, unknown, required, quoted,
  rfc3339); a typed for over a json, a typed TryGet and TryJsonDecode. }
program jsonbind2;

uses
  sysutils;

type
  TColor = (Red, Green, Blue);
  TColors = set of TColor;
  TDigit = 0..9;
  TWeek = (Mon, Tue, Wed, Thu, Fri, Sat, Sun);
  TWork = Tue..Fri;
  TLower = 'a'..'z';

  PNode = ^TNode;
  TNode = record
    V: Integer json 'v';
    Next: PNode json 'next' omitempty;
  end;

  TPoint = record
    X, Y: Integer;
  end;
  PPoint = ^TPoint;

  TBase = record
    Id: Integer json 'id';
    Kind: string json 'kind';
  end;
  TMore = record
    Score: Integer json 'score';
    Tag: string;
  end;
  PMore = ^TMore;

  TMeta = record
    Base: TBase json embed;
    More: PMore json embed;
    Extra: json json unknown;
  end;

  TAnimal = class
  private
    FName: string;
    FLegs: Integer;
  public
    Weight: Single;
    Made: Integer;
    constructor Create;
    property Name: string read FName write FName json 'name';
    property Legs: Integer read FLegs write FLegs json 'legs' omitzero;
  end;

  TDog = class(TAnimal)
  public
    Good: Boolean json 'good';
  end;

  TAll = record
    Q: Quad;
    QQ: Quad json quoted;
    C: Currency;
    CQ: Currency json quoted;
    S: Single;
    Ch: Char;
    Digit: TDigit;
    Bytes: array of Byte;
    Fixed: array[0..3] of Byte;
    Grid: array[1..2] of Integer;
    ByColor: array[TColor] of Integer;
    Colors: TColors;
    Small: set of Byte;
    Letters: set of Char;
    M: map[string] of Integer;
    MI: map[Integer] of string;
    ME: map[TColor] of Boolean;
    MC: map[Char] of Integer;
    MB: map[Boolean] of Integer;
    T: tree[string] of Boolean;
    TI: tree[Integer] of Integer;
    NoMap: map[string] of Integer;
    When: TDateTime json rfc3339;
    Pet: TAnimal;
    NoPet: TAnimal;
    Raw: json;
    Big: Int64 json quoted;
    Origin: TPoint json omitzero;
    Corner: TPoint json omitzero;
    Pair: array[0..1] of Integer json omitzero;
  end;

  TNeed = record
    A: Integer json 'a' required;
    B: string json 'b';
  end;

  TSmall = record
    Day: TWork;
    Lower: TLower;
    W: Word;
    I8: ShortInt;
    U32: UInt32;
    Neg: Double;
    Tiny: Double;
    F: Single;
    Q: Quad;
  end;

constructor TAnimal.Create;
begin
  Made := 1;
end;

var
  a, b, c, z: TAll;
  t1: string;
  m: TMeta;
  n: TNode;
  p, q: PNode;
  dog: TDog;
  pet: TAnimal;
  need: TNeed;
  sm: TSmall;
  opts: TJsonOptions;
  j: json;
  i, sum: Integer;
  k, s: string;
  pt: TPoint;
  pp: PPoint;
  e: EJsonError;
  ok: Boolean;
  names: array of string;
  ints: array of Integer;
  pts: array of TPoint;
  when: TDateTime;

begin
  { what JsonEncode writes reads back the same, from text and from a json }
  a.Q := 1.5;
  a.QQ := -0.000125;
  a.C := 12.34;
  a.CQ := -7;
  a.S := 0.1;
  a.Ch := 'z';
  a.Digit := 7;
  SetLength(a.Bytes, 5);
  a.Bytes[0] := 104;
  a.Bytes[1] := 105;
  a.Bytes[2] := 33;
  a.Bytes[3] := 0;
  a.Bytes[4] := 255;
  a.Fixed[0] := 1;
  a.Fixed[3] := 2;
  a.Grid[1] := 10;
  a.Grid[2] := 20;
  a.ByColor[Green] := 7;
  a.Colors := [Red, Blue];
  a.Small := [3, 200];
  a.Letters := ['b', 'a', '"'];
  New(a.M);
  a.M['b'] := 2;
  a.M['a'] := 1;
  New(a.MI);
  a.MI[10] := 'ten';
  a.MI[-1] := 'minus';
  New(a.ME);
  a.ME[Blue] := True;
  a.ME[Red] := False;
  New(a.MC);
  a.MC['y'] := 1;
  New(a.MB);
  a.MB[True] := 1;
  a.MB[False] := 0;
  New(a.T);
  a.T['y'] := True;
  a.T['x'] := False;
  New(a.TI);
  a.TI[10] := 1;
  a.TI[-1] := 2;
  a.When := EncodeDate(2026, 10, 14) + EncodeTime(13, 5, 9, 250);
  a.Pet := TAnimal.Create;
  a.Pet.Name := 'Rex';
  a.Pet.Weight := 12.5;
  a.Pet.Legs := 4;
  a.Raw := JsonParse('{"k":[1,2]}');
  a.Big := 9007199254740993;
  a.Corner.Y := 1;
  t1 := JsonEncode(a);
  WriteLn(t1);
  JsonDecode(t1, b);
  WriteLn(JsonEncode(b) = t1, ' ', b.Pet <> a.Pet, ' ', b.Pet.Made, ' ', b.Big, ' ', b.When = a.When);
  JsonDecode(JsonParse(t1), c);
  WriteLn(JsonEncode(c) = t1, ' ', Length(PasJsonImage(b.Raw)) > 0, ' ', b.Raw = a.Raw);

  { null gives the zero, and so does an absent member }
  JsonDecode('null', b);
  WriteLn(JsonEncode(b) = JsonEncode(z));
  JsonDecode('{"S": 2.5, "Q": null, "Ch": null, "Bytes": null, "M": null, "Pet": null, "Raw": null}', c);
  WriteLn(JsonEncode(c));
  j := nil;
  JsonDecode(j, c);
  WriteLn(JsonEncode(c) = JsonEncode(z));

  { Merge: into what is there, as Go's v2: members merge, a map keeps its
    entries, a pointer and an object are read into, arrays are replaced }
  opts := JsonDefaults;
  opts.Merge := True;
  JsonDecode(t1, b);
  pet := b.Pet;
  JsonDecode('{"S": 4, "M": {"c": 3}, "Pet": {"legs": 3}, "Grid": [5, 6], "Corner": {"X": 9}}', b, opts);
  WriteLn(b.S, ' ', Length(b.M), ' ', b.M['a'], b.M['b'], b.M['c'], ' ', b.Pet = pet, ' ',
    b.Pet.Name, ' ', b.Pet.Legs, ' ', b.Grid[1], b.Grid[2], ' ', b.Corner.X, b.Corner.Y, ' ',
    b.Q, ' ', b.Ch);
  JsonDecode('{"S": 4}', b);
  WriteLn(b.Pet = nil, ' ', b.M = nil, ' ', b.Q);
  New(pp);
  pp^.X := 1;
  pp^.Y := 2;
  q := nil;
  JsonDecode('{"Y": 5}', pp^, opts);
  WriteLn(pp^.X, ' ', pp^.Y);

  { integers in their type's range, -0, quoted, subranges }
  JsonDecode('{"Day": "Wed", "Lower": "q", "W": 65535, "I8": -128, "U32": 4294967295, "Neg": -0, ' +
    '"Tiny": 1e-400, "F": 16777217, "Q": 0.1}', sm);
  WriteLn(Ord(sm.Day), ' ', sm.Lower, ' ', sm.W, ' ', sm.I8, ' ', sm.U32, ' ', sm.Neg, ' ', sm.Tiny,
    ' ', sm.F, ' ', JsonEncode(sm.Q));
  JsonDecode('-0', i);
  WriteLn(i);
  JsonDecode('{"Big": "-9223372036854775808", "QQ": "1e-5", "CQ": "-0.0001", "C": 1e3}', b);
  WriteLn(b.Big, ' ', JsonEncode(b.QQ), ' ', b.CQ, ' ', b.C);

  { a list through pointers, embed and the members json unknown keeps }
  JsonDecode('{"v": 1, "next": {"v": 2, "next": {"v": 3}}}', n);
  sum := 0;
  p := @n;
  while p <> nil do
  begin
    sum := sum * 10 + p^.V;
    p := p^.Next;
  end;
  WriteLn(sum);
  JsonDecode('{"id": 5, "kind": "x", "n": 1, "more": [true]}', m);
  WriteLn(m.Base.Id, ' ', m.Base.Kind, ' ', m.More = nil, ' ', m.Extra, ' ', JsonEncode(m));
  JsonDecode('{"Tag": "t", "id": 6, "x": {"y": null}, "score": 9}', m);
  WriteLn(m.More^.Score, ' ', m.More^.Tag, ' ', m.Extra, ' ', JsonEncode(m));
  JsonDecode('{"z": 1, "x": 2}', m, opts);
  WriteLn(m.Base.Id, ' ', m.Extra);

  { classes made with their Create, and a descendant }
  JsonDecode('{"name": "Fido", "good": true, "Weight": 3.5}', dog);
  WriteLn(dog.Name, ' ', dog.Good, ' ', dog.Weight, ' ', dog.Made, ' ', dog.Legs);
  dog.Made := 5;
  JsonDecode('{"legs": 4}', dog, opts);
  WriteLn(dog.Name, ' ', dog.Legs, ' ', dog.Made);
  JsonDecode('null', dog);
  WriteLn(dog = nil);

  { required }
  JsonDecode('{"a": 0}', need);
  WriteLn(need.A, ' ', need.B = '');

  { a typed for over a json, a typed TryGet }
  sum := 0;
  for i in JsonParse('[1, 2, 3, 40]') do
    sum := sum + i;
  WriteLn(sum);
  for k, pt in JsonParse('{"a": {"X": 1, "Y": 2}, "b": {"X": 3}}') do
    WriteLn(k, ' ', pt.X, ' ', pt.Y);
  for i, s in JsonParse('["x", "y"]') do
    WriteLn(i, s);
  for pt in JsonParse('{"a": {"X": 7}, "b": null}') do
    WriteLn(pt.X, pt.Y);
  j := JsonParse('{"p": {"X": 4, "Y": 5}, "bad": "no", "list": [10, 20]}');
  pt.X := -1;
  WriteLn(TryGet(j, 'p', pt), ' ', pt.X, pt.Y);
  pt.X := -1;
  WriteLn(TryGet(j, 'zz', pt), ' ', pt.X, ' ', TryGet(j, 'bad', pt), ' ', pt.X);
  WriteLn(TryGet(j['list'], 1, i), ' ', i, ' ', TryGet(j['list'], 2, i), ' ', i);
  SetLength(names, 1);
  WriteLn(TryGet(j, 'list', names), ' ', Length(names));
  JsonDecode(j['list'], ints);
  WriteLn(Length(ints), ' ', ints[1]);

  { TryJsonDecode: Err nil and the value, or the error and nothing changed }
  ok := TryJsonDecode('[{"X": 1}, {"Y": 2}]', pts, e);
  WriteLn(ok, ' ', e = nil, ' ', Length(pts), ' ', pts[1].Y);
  ok := TryJsonDecode('[{"X": 1}, {"Y": "2"}]', pts, e);
  WriteLn(ok, ' ', e.Message, ' ', pts[0].X, ' ', Ord(e.Kind));
  ok := TryJsonDecode(JsonParse('[{"X": 5}]'), pts, e, opts);
  WriteLn(ok, ' ', Length(pts), ' ', pts[0].X);

  { a TDateTime is a number, and RFC 3339 text with json rfc3339: with an
    offset, nanoseconds, the first and the last day }
  JsonDecode('45000.5', when);
  WriteLn(FormatDateTime('yyyy-mm-dd hh:nn', when));
  JsonDecode('{"When": "2026-10-14T13:05:09.25Z"}', b);
  WriteLn(b.When = a.When, ' ', JsonEncode(b.When), ' ', FormatDateTime('yyyy-mm-dd hh:nn:ss.zzz', b.When));
  JsonDecode('{"When": "2026-10-14T15:05:09.250000000999+02:00"}', c);
  JsonDecode('{"When": "0001-01-01T00:00:00Z"}', z);
  WriteLn(c.When = b.When, ' ', z.When, ' ', FormatDateTime('yyyy-mm-dd', z.When));
  JsonDecode('{"When": "1899-12-29T18:00:00-00:00"}', z);
  WriteLn(z.When, ' ', JsonEncode(z));
  JsonDecode('{"When": "9999-12-31T23:59:59.999Z"}', z);
  WriteLn(JsonEncode(z.When), ' ', FormatDateTime('yyyy-mm-dd hh:nn:ss.zzz', z.When));
  JsonDecode('{"When": "2024-02-29T23:30:00-01:30"}', z);
  WriteLn(FormatDateTime('yyyy-mm-dd hh:nn:ss', z.When));
end.

