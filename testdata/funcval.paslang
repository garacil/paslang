{ P81: a routine as a value. A type can now be written
  function(a, b: Int64): Boolean or procedure(n: Integer), a value of
  it is @TheRoutine, and calling through it is F(x, y). It is eight
  bytes, the address of the code, and the signature belongs to the
  type, so the call knows what to pass and what comes back.

  A method value, procedure of object, is a different animal and stays
  as it was: sixteen bytes, code and Self. }
program funcval;

type
  TLess = function(A, B: Int64): Boolean;
  TAct = procedure(N: Integer);
  TName = function(const S: string): string;
  TMake = function(N: Integer): Int64;

  TPair = record
    Cmp: TLess;
    Tag: string;
  end;

var
  seen: Integer;

function Up(A, B: Int64): Boolean;
begin
  Result := A < B;
end;

function Down(A, B: Int64): Boolean;
begin
  Result := A > B;
end;

procedure Count(N: Integer);
begin
  seen := seen + N;
end;

function Shout(const S: string): string;
begin
  Result := S + '!';
end;

function Twice(N: Integer): Int64;
begin
  Result := N * 2;
end;

{ A routine value as a parameter: this is what a comparator is. }
function PickOne(F: TLess; X, Y: Int64): Int64;
begin
  Result := Y;
  if F(X, Y) then
    Result := X;
end;

{ And as an answer. }
function Chooser(Rising: Boolean): TLess;
begin
  if Rising then
    Result := @Up
  else
    Result := @Down;
end;

{ Sorting with the order handed in, which is the whole point. }
procedure SortBy(var A: array of Int64; F: TLess);
var
  i, j: Integer;
  t: Int64;
begin
  for i := 0 to High(A) do
    for j := i + 1 to High(A) do
      if F(A[j], A[i]) then
      begin
        t := A[i];
        A[i] := A[j];
        A[j] := t;
      end;
end;

var
  f: TLess;
  act: TAct;
  nm: TName;
  mk: TMake;
  p: TPair;
  fs: array of TLess;
  a: array of Int64;
  i: Integer;
  line: string;

begin
  { A value, and a call through it. }
  f := @Up;
  WriteLn(f(3, 7), ' ', f(7, 3));
  f := @Down;
  WriteLn(f(3, 7), ' ', f(7, 3));

  { Eight bytes, and it can be nil and be asked. }
  WriteLn(SizeOf(f), ' ', f <> nil);
  f := nil;
  WriteLn(f = nil);
  f := @Up;
  WriteLn(f = nil, ' ', f <> nil);

  { A procedure value, called as a statement, with and without the
    parentheses that have nothing in them. }
  seen := 0;
  act := @Count;
  act(5);
  act(7);
  WriteLn(seen);

  { Strings go through a routine value like anything else. }
  nm := @Shout;
  WriteLn(nm('hola'), ' ', Length(nm('a')));

  { One handed to another routine. }
  WriteLn(PickOne(@Up, 3, 7), ' ', PickOne(@Down, 3, 7), ' ',
    PickOne(f, 10, 2));

  { One given back by another routine. }
  f := Chooser(True);
  WriteLn(f(1, 2), ' ', Chooser(False)(1, 2));

  { One kept in a record and in an array. }
  p.Cmp := @Down;
  p.Tag := 'down';
  WriteLn(p.Tag, ' ', p.Cmp(1, 2));
  SetLength(fs, 2);
  fs[0] := @Up;
  fs[1] := @Down;
  WriteLn(fs[0](1, 2), ' ', fs[1](1, 2));

  { Sorting with the order handed in. }
  SetLength(a, 6);
  a[0] := 5;
  a[1] := 1;
  a[2] := 4;
  a[3] := 1;
  a[4] := 9;
  a[5] := 3;
  SortBy(a, @Up);
  line := '';
  for i := 0 to High(a) do
    line := line + Char(48 + a[i]);
  Write(line, ' ');
  SortBy(a, @Down);
  line := '';
  for i := 0 to High(a) do
    line := line + Char(48 + a[i]);
  WriteLn(line);

  { A function value that gives back a number, and two of them in one
    expression. }
  mk := @Twice;
  WriteLn(mk(21), ' ', mk(mk(3)));
end.

