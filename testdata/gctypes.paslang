{ P95a: every allocation says what the block holds. The program runs as
  any other; make check greps the assembly for the descriptors: TNode
  is a string (pointer, length), an integer and a pointer, so words 0
  and 3 hold pointers (mask 0x9); TBox's instance has the VMT in word
  0 and a string and a slice after it (0xa); an array of TPair tiles
  the pair (0x5); TPlain holds no pointer and has no descriptor. }
program gctypes;

uses
  paslib;

type
  PNode = ^TNode;
  TNode = record
    Name: string;
    Count: Integer;
    Next: PNode;
  end;
  TPlain = record
    A, B: Integer;
  end;
  PPlain = ^TPlain;
  TPair = record
    L, R: string;
  end;
  TBox = class
    Title: string;
    Items: array of Integer;
    constructor Create(const T: string);
  end;

constructor TBox.Create(const T: string);
begin
  Title := T;
  SetLength(Items, 3);
end;

function MakePair(const A, B: string): TPair;
begin
  Result.L := A;
  Result.R := B;
end;

var
  n, m: PNode;
  pl: PPlain;
  pairs: array of TPair;
  box: TBox;
  raw, bytes: Pointer;
  p: TPair;
  i, total: Integer;

begin
  New(n);
  n^.Name := 'first';
  n^.Count := 1;
  New(m);
  m^.Name := 'second';
  m^.Count := 2;
  n^.Next := m;
  New(pl);
  pl^.A := 40;
  pl^.B := 2;
  SetLength(pairs, 4);
  for i := 0 to 3 do
    pairs[i] := MakePair('l' + IntToStr(i), 'r' + IntToStr(i));
  box := TBox.Create('box');
  GetMem(raw, 64);
  GetMem(bytes, 64, 0);
  PChar(bytes)^ := 'z';
  p := MakePair('x', 'y');
  total := n^.Count + n^.Next^.Count + pl^.A + pl^.B + Length(pairs) + Length(box.Items);
  WriteLn(n^.Name, ' ', n^.Next^.Name, ' ', total);
  WriteLn(pairs[3].L, pairs[3].R, ' ', box.Title, ' ', PChar(bytes)^, ' ', p.L, p.R);
  if raw = nil then
    WriteLn('no memory');
end.
