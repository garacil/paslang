{ P435: LoadZone against Go's time.LoadLocation (uses pastime). testdata/
  zones.out is what scripts/zone_oracle.go prints from the system's
  zoneinfo: fourteen zones at fixed moments (abbreviation, offset, daylight
  saving, the clock's date and time), a hash of 20000 random moments and
  of 20000 random clock readings in each, the names Go refuses, and the
  readings a clock skipped or showed twice. The process's own zone (TZ) is
  not the zone of any of it. }
program zones;

uses
  pastime;

var
  GS: Integer;
  FH: Integer;

function GNext: Integer;
var
  z: Integer;
begin
  GS := GS + Integer($9E3779B97F4A7C15);
  z := GS;
  z := (z xor (z shr 30)) * Integer($BF58476D1CE4E5B9);
  z := (z xor (z shr 27)) * Integer($94D049BB133111EB);
  Result := z xor (z shr 31);
end;

function Hex16(V: Integer): string;
const
  D: string = '0123456789abcdef';
var
  i: Integer;
begin
  SetLength(Result, 16);
  for i := 16 downto 1 do
  begin
    Result[i] := D[(V and 15) + 1];
    V := V shr 4;
  end;
end;

procedure FnvAdd(const S: string);
var
  i: Integer;
begin
  for i := 1 to Length(S) do
    FH := (FH xor Ord(S[i])) * Integer($100000001B3);
  FH := (FH xor 255) * Integer($100000001B3);
end;

function Pad(V, W: Integer): string;
begin
  Result := IntToStr(V);
  while Length(Result) < W do
    Result := '0' + Result;
end;

function BoolText(B: Boolean): string;
begin
  if B then
    Result := 'true'
  else
    Result := 'false';
end;

{ the clock's date and time as the oracle prints them with %04d-%02d-... }
function Clock(const D: TDate): string;
begin
  Result := Pad(D.Year, 4) + '-' + Pad(D.Month, 2) + '-' + Pad(D.Day, 2) + ' ' + Pad(D.Hour, 2) + ':' + Pad(D.Minute, 2) +
    ':' + Pad(D.Second, 2);
end;

function Raw(const D: TDate): string;
begin
  Result := IntToStr(D.Year) + '-' + IntToStr(D.Month) + '-' + IntToStr(D.Day) + ' ' + IntToStr(D.Hour) + ':' +
    IntToStr(D.Minute) + ':' + IntToStr(D.Second);
end;

const
  Names: array[0..13] of string = ('Europe/Madrid', 'America/New_York', 'Pacific/Kiritimati', 'Asia/Kolkata',
    'Australia/Lord_Howe', 'America/Sao_Paulo', 'UTC', '', 'Asia/Kathmandu', 'Pacific/Chatham', 'Europe/Dublin',
    'Africa/Casablanca', 'Etc/GMT+5', 'America/St_Johns');
  Fixed: array[0..10] of Integer = (0, 1000000000, 1700000000, 1711846800, 1711846799, 1729990800, 1729990799,
    1893456000, 2147483647, 2556143999, 4102444800);
  Refused: array[0..5] of string = ('Nowhere/City', '../etc/passwd', '/usr/share/zoneinfo/UTC', 'Europe/../UTC', '\x',
    'Europe/Madrid/');

var
  z: TZone;
  i, k, t, y, mo, d, h, mi, se: Integer;
  s: string;

begin
  for i := 0 to High(Names) do
  begin
    z := LoadZone(Names[i]);
    if z = nil then
    begin
      WriteLn('zone "', Names[i], '" nil');
      Continue;
    end;
    WriteLn('zone "', Names[i], '" ', z.Name);
    for k := 0 to High(Fixed) do
      WriteLn('  at ', Fixed[k], ' ', z.AbbrevAt(Fixed[k]), ' ', z.OffsetAt(Fixed[k]), ' dst ', BoolText(z.IsDstAt(Fixed[k])),
        ' ', Clock(z.ToDate(Fixed[k])));
    GS := 7;
    FH := Integer($CBF29CE484222325);
    for k := 1 to 20000 do
    begin
      t := 315532800 + (GNext shr 11) mod (2840140800 - 315532800);
      FnvAdd(z.AbbrevAt(t) + ' ' + IntToStr(z.OffsetAt(t)) + ' ' + BoolText(z.IsDstAt(t)) + ' ' + Raw(z.ToDate(t)));
    end;
    WriteLn('  random moments ', Hex16(FH));
    FH := Integer($CBF29CE484222325);
    for k := 1 to 20000 do
    begin
      y := 1980 + (GNext shr 40) mod 80;
      mo := 1 + (GNext shr 40) mod 12;
      d := 1 + (GNext shr 40) mod 28;
      h := (GNext shr 40) mod 24;
      mi := (GNext shr 40) mod 60;
      se := (GNext shr 40) mod 60;
      FnvAdd(IntToStr(z.ToUnix(y, mo, d, h, mi, se)));
    end;
    WriteLn('  random readings ', Hex16(FH));
  end;
  for i := 0 to High(Refused) do
    WriteLn('bad "', Refused[i], '" ', BoolText(LoadZone(Refused[i]) = nil));
  z := LoadZone('Europe/Madrid');
  WriteLn('gap ', z.ToUnix(2024, 3, 31, 2, 30, 0));
  WriteLn('twice ', z.ToUnix(2024, 10, 27, 2, 30, 0));
end.

