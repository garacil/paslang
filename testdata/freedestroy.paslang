program freedestroy;

{ x.Free (1.0.137), as in Delphi and FPC: x is worked out once and, when
  it is not nil, its destructor Destroy runs (the class's or an
  ancestor's, with no parameters; through its slot when it is virtual,
  called straight otherwise). The collector keeps the memory, so the
  object is still there after. A class with no Destroy frees nothing; a
  class with a method named Free keeps its own. It was a statement that
  did nothing. inherited Create and Destroy, and a bare inherited, with
  no ancestor that has them do nothing, as TObject's in FPC. }

uses paslib;

type
  TBase = class
    Name: string;
    constructor Create(const AName: string);
    destructor Destroy; virtual;
  end;

  TChild = class(TBase)
    destructor Destroy; override;
  end;

  TGrand = class(TChild)
    procedure Done;
  end;

  TSig = class(TBase)
    destructor Destroy; override;
  end;

  TPlain = class
    destructor Destroy;
  end;

  TPlainKid = class(TPlain)
    destructor Destroy;
  end;

  TNone = class
    N: Integer;
  end;

  TOwnFree = class
    procedure Free;
  end;

  TLeaf = class(TNone)
    constructor Create;
    destructor Destroy; override;
    procedure Poke;
  end;

  TParams = class
    destructor Destroy(Loud: Boolean);
  end;

  THolder = class
    Kid: TBase;
    Kids: array of TBase;
    constructor Create;
    procedure Drop;
    procedure DropAll;
  end;

var
  made, destroyed, picks: Integer;
  done: chan of Integer;

constructor TBase.Create(const AName: string);
begin
  Name := AName;
  made := made + 1;
end;

destructor TBase.Destroy;
begin
  destroyed := destroyed + 1;
  WriteLn('TBase.Destroy ', Name);
end;

destructor TChild.Destroy;
begin
  WriteLn('TChild.Destroy ', Name);
  inherited Destroy;
end;

procedure TGrand.Done;
begin
  WriteLn('TGrand.Done');
  Free;
end;

destructor TSig.Destroy;
begin
  inherited Destroy;
  Send(done, 1);
end;

destructor TPlain.Destroy;
begin
  WriteLn('TPlain.Destroy');
end;

destructor TPlainKid.Destroy;
begin
  WriteLn('TPlainKid.Destroy');
end;

constructor TLeaf.Create;
begin
  inherited Create;
  N := 9;
end;

destructor TLeaf.Destroy;
begin
  WriteLn('TLeaf.Destroy ', N);
  inherited Destroy;
end;

procedure TLeaf.Poke;
begin
  inherited;
  WriteLn('TLeaf.Poke');
end;

procedure TOwnFree.Free;
begin
  WriteLn('TOwnFree.Free');
end;

destructor TParams.Destroy(Loud: Boolean);
begin
  WriteLn('TParams.Destroy ', Loud);
end;

constructor THolder.Create;
var
  i: Integer;
begin
  Kid := TChild.Create('field');
  SetLength(Kids, 3);
  for i := 0 to 2 do
    Kids[i] := TBase.Create('elem' + IntToStr(i));
end;

procedure THolder.Drop;
begin
  Kid.Free;
  Self.Kid.Free;
end;

procedure THolder.DropAll;
var
  i: Integer;
  procedure Inner;
  begin
    Kids[0].Free;
  end;
begin
  Inner;
  for i := 1 to High(Kids) do
    Kids[i].Free;
end;

function Pick(B: TBase): TBase;
begin
  picks := picks + 1;
  WriteLn('pick ', picks);
  Result := B;
end;

function PickIndex(I: Integer): Integer;
begin
  picks := picks + 1;
  WriteLn('index ', picks);
  Result := I;
end;

function NewNone: TNone;
begin
  picks := picks + 1;
  WriteLn('none ', picks);
  Result := TNone.Create;
end;

procedure Churn;
var
  i: Integer;
  b: TBase;
begin
  for i := 1 to 2000 do
  begin
    b := TGrand.Create('g' + IntToStr(i));
    b.Name := b.Name + '!';
    if i mod 1000 = 0 then
      b.Free
    else
      b.Name := '';
  end;
end;

procedure Later(B: TBase);
begin
  B.Free;
  Send(done, 1);
end;

var
  b, n: TBase;
  sig: TSig;
  c: TChild;
  p: TPlain;
  none: TNone;
  own: TOwnFree;
  leaf: TLeaf;
  prm: TParams;
  h: THolder;
  arr: array of TBase;
  got: Integer;

begin
  got := 0;
  made := 0;
  destroyed := 0;
  picks := 0;
  done := MakeChan();
  { virtual: the object's own Destroy, whatever the variable's type }
  b := TChild.Create('one');
  b.Free;
  WriteLn('after free: ', b.Name, ' ', destroyed);
  { an ancestor's Destroy }
  c := TGrand.Create('two');
  c.Free;
  { nil: nothing runs }
  n := nil;
  n.Free;
  WriteLn('nil freed: ', destroyed);
  { worked out once }
  Pick(TBase.Create('three')).Free;
  SetLength(arr, 2);
  arr[1] := TChild.Create('four');
  arr[PickIndex(1)].Free;
  { not virtual: the Destroy of the variable's class }
  p := TPlainKid.Create;
  p.Free;
  TPlainKid(p).Free;
  { no Destroy: nothing, but a call in x still runs once }
  none := TNone.Create;
  none.Free;
  NewNone.Free;
  { a method named Free is the class's own }
  own := TOwnFree.Create;
  own.Free;
  { Free alone in a method is Self.Free }
  TGrand.Create('seven').Done;
  { a Destroy whose inherited Destroy has no ancestor to reach }
  leaf := TLeaf.Create;
  leaf.Poke;
  leaf.Free;
  { a Destroy with parameters is not the one Free calls }
  prm := TParams.Create;
  prm.Free;
  prm.Destroy(True);
  { fields, elements, a nested routine }
  h := THolder.Create;
  h.Drop;
  h.DropAll;
  { pas x.Free: the new routine calls Destroy }
  sig := TSig.Create('five');
  pas sig.Free;
  got := got + Recv(done);
  sig := nil;
  pas sig.Free;
  pas Later(TBase.Create('six'));
  got := got + Recv(done);
  Churn;
  WriteLn('made ', made, ' destroyed ', destroyed, ' picks ', picks, ' signals ', got);
end.
