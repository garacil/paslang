program chrboundary;
uses SysUtils;
type TByteChar = Char;
const First = Chr(0); Last = Chr(255); FromByte = Chr(Byte(44));
  NestedZero = Integer(Chr(0)); NestedTop = Ord(Char(255));
  TypedByte = Chr(Byte(Integer(300)));
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('char boundary ', Stage, ': ', Actual, ' <> ', Expected); Halt(93); end;
end;
function HighValue: Integer;
begin Result := 9223372036854775807; end;
function LowValue: Integer;
begin Result := -9223372036854775807 - 1; end;
function Echo(X: Integer): Integer;
begin Result := X; end;
function HighChar: Char;
begin Result := Chr(HighValue()); end;
function LowChar: Char;
begin Result := Char(LowValue()); end;
function NumberText(X: Integer): string;
begin Result := X.ToString; end;
var
  Values: array[0..11] of Integer =
    (9223372036854775807, -9223372036854775807 - 1,
     -257, -256, -255, -1, 0, 1, 255, 256, 300, 511);
  Expected: array[0..11] of Integer = (255, 0, 255, 0, 1, 255, 0, 1, 255, 0, 44, 255);
  I, Want, SignedWant, Raw: Integer;
  C: Char; Flag: Boolean; D: Double; S: Single; B: Byte;
begin
  { Stored controls and direct nilary calls retain separate observations. }
  C := Chr(HighValue()); Equal(1, Integer(C), 255);
  C := Chr(LowValue()); Equal(2, Integer(C), 0);
  Equal(3, Integer(Chr(HighValue())), 255);
  Equal(4, Integer(Chr(LowValue())), 0);
  Equal(5, Ord(Char(HighValue())), 255);
  Equal(6, Ord(Char(LowValue())), 0);
  Equal(7, Integer(HighChar()), 255);
  Equal(8, Integer(LowChar()), 0);
  Equal(9, Integer(First), 0); Equal(10, Integer(Last), 255);
  Equal(11, Integer(FromByte), 44);
  Equal(12, NestedZero, 0); Equal(13, NestedTop, 255); Equal(14, Integer(TypedByte), 44);
  B := Ord(Chr(44)); Equal(15, B, 44);
  B := Ord(Char(255)); Equal(16, B, 255);
  Equal(17, Integer(Chr(Boolean(not False))), 1);
  Equal(18, Ord(Char(not True)), 0);
  Equal(19, Integer(Char(Byte(Integer(300)))), 44);
  for I := 0 to 11 do
  begin
    Want := Expected[I]; SignedWant := Want;
    if Want >= 128 then SignedWant := Want - 256;
    Equal(100 + I, Integer(Chr(Echo(Values[I]))), Want);
    Equal(120 + I, Ord(Chr(Echo(Values[I]))), Want);
    Equal(140 + I, Integer(Char(Echo(Values[I]))), Want);
    Equal(160 + I, Integer(TByteChar(Echo(Values[I]))), Want);
    Equal(180 + I, Integer(Byte(Chr(Echo(Values[I])))), Want);
    Equal(200 + I, Integer(Word(Char(Echo(Values[I])))), Want);
    Equal(220 + I, Integer(Int8(Chr(Echo(Values[I])))), SignedWant);
    D := Double(Chr(Echo(Values[I]))); Equal(240 + I, Trunc(D), Want);
    S := Single(Char(Echo(Values[I]))); Equal(260 + I, Trunc(S), Want);
    Flag := Boolean(Chr(Echo(Values[I]))); Equal(280 + I, Ord(Flag), Ord(Want <> 0));
  end;
  if NumberText(Integer(Chr(HighValue()))) <> '255' then Halt(94);
  if NumberText(Ord(Char(LowValue()))) <> '0' then Halt(95);
  Flag := Boolean(Chr(Echo(256)));
  if Flag then Halt(96);
  Flag := Boolean(Char(Echo(300)));
  if not Flag then Halt(97);
  { Existing numeric narrowing and raw views retain their own contracts. }
  Raw := 300; Equal(300, Integer(Byte(Raw)), 44);
  Equal(301, Integer(Raw as Byte), 44);
  Equal(302, Integer(Raw as Char), 44);
  Raw := -1; Equal(303, Integer(Raw as Int8), -1);
  Raw := $3F800000; D := Double(Raw as Single);
  if D <> 1.0 then Halt(98);
  WriteLn('ok char conversion boundaries');
end.
