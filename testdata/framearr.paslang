program framearr;

{ A loop over a routine's own static array (P100, 1.0.101): amd64
  reaches its elements at -80(%rbp,%rdi,8), arm64 keeps its address in a
  register. Routines spin over theirs while the main program makes the
  collector run, which moves their stacks under PASLANG_GCVERIFY: the
  address is worked out again after the loop's slow path. }

uses paslib;

var
  wg: waitgroup;
  results: array[0..5] of Integer;

procedure Work(Id: Integer);
var
  a: array[0..999] of Integer;
  w: array[1..64] of Word;
  i, pass, s: Integer;
begin
  for i := 0 to 999 do
    a[i] := i * (Id + 1) + Id;
  for i := 1 to 64 do
    w[i] := Word(i * 1000 + Id * 7);
  s := 0;
  for pass := 1 to 3000 do
  begin
    for i := 0 to 999 do
      s := s + a[i] * (pass and 7);
    for i := 1 to 64 do
      s := s xor (w[i] + pass);
  end;
  results[Id] := s;
  wg.Done;
end;

procedure Churn;
var
  i: Integer;
  t: string;
begin
  for i := 1 to 300000 do
  begin
    t := IntToStr(i) + '.';
    if Length(t) = 0 then
      WriteLn('never');
  end;
end;

var
  k: Integer;

begin
  wg.Add(6);
  for k := 0 to 5 do
    pas Work(k);
  Churn;
  wg.Wait;
  for k := 0 to 5 do
    WriteLn(k, ' ', results[k]);
end.

