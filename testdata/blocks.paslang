program blocks;

{ Logic on whole blocks (P105, 1.0.120): records and static arrays of one
  size byte by byte, an array of integers with one integer repeated over
  its elements, strings of one length into a new string; nested,
  compound, on what a routine gives back. }

type
  TRec = record
    A: Word;
    B: Byte;
    C: Int32;
  end;
  TArr = array[0..3] of UInt32;
  TBytes = array[0..10] of Byte;

var
  r1, r2, r3: TRec;
  a1, a2, a3: TArr;
  b1, b2, b3: TBytes;
  s1, s2, s3, keep: string;
  i: Integer;

function MakeRec(n: Integer): TRec;
begin
  Result.A := Word(n);
  Result.B := Byte(n * 2);
  Result.C := Int32(n * 3);
end;

procedure Show(const r: TRec);
begin
  WriteLn(r.A, ' ', r.B, ' ', r.C);
end;

procedure ShowA(const a: TArr);
begin
  WriteLn(a[0], ' ', a[1], ' ', a[2], ' ', a[3]);
end;

begin
  r1.A := $F0F0;
  r1.B := $0F;
  r1.C := -1;
  r2.A := $FF00;
  r2.B := $33;
  r2.C := $0F0F0F0F;
  r3 := r1 xor r2;
  Show(r3);
  r3 := r1 and r2;
  Show(r3);
  r3 := r1 or r2;
  Show(r3);
  r3 := r1 nand r2;
  Show(r3);
  r3 := r1 nor r2;
  Show(r3);
  r3 := r1 xnor r2;
  Show(r3);
  r3 := r1 andnot r2;
  Show(r3);
  r3 := not r1;
  Show(r3);
  r3 := not (r1 xor r2);
  Show(r3);
  r3 := (r1 xor r2) and r1;
  Show(r3);
  r3 := MakeRec(5) or r2;
  Show(r3);
  r1 xor= r2;
  Show(r1);
  for i := 0 to 3 do
  begin
    a1[i] := UInt32($11111111 * (i + 1));
    a2[i] := $0F0F0F0F;
  end;
  a3 := a1 and $FF00FF00;
  ShowA(a3);
  a3 := a1 xor a2;
  ShowA(a3);
  a1 or= 1;
  ShowA(a1);
  for i := 0 to 10 do
  begin
    b1[i] := Byte(i * 23);
    b2[i] := $5A;
  end;
  b3 := b1 xor b2;
  for i := 0 to 10 do
    Write(b3[i], ' ');
  WriteLn;
  b3 := not b1;
  WriteLn(b3[0], ' ', b3[10]);
  s1 := 'AbCd' + 'Ef';
  keep := s1;
  s2 := '      ';
  s3 := s1 xor s2;
  WriteLn(s3, ' ', s1 or s2, ' ', s1 and (s1 xor s2), ' ', keep);
  s1 xor= s2;
  WriteLn(s1, ' ', keep, ' ', Length(not s1), ' ', Ord((not s1)[1]));
end.

