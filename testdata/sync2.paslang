{ Sync locals start ready, once makes late routines wait, Break and
  Continue release a lock, and Signal hands a turn over. }
program sync2;

var
  wg: waitgroup;
  gate: once;
  mu: mutex;
  handoff: cond;
  slow, seen, turn, i: Integer;

procedure Slow;
begin
  Sleep(20);
  slow := slow + 1;
end;

procedure Enter(K: Integer);
begin
  once gate do                   { one routine runs Slow; the others wait }
    Slow;
  lock mu do
    seen := seen + slow;         { so every routine sees slow = 1 }
  wg.Done;
end;

function LocalCount: Integer;
var
  lm: mutex;                     { a local mutex starts unlocked }
  lw: waitgroup;                 { a local wait group starts at zero }
  i, t: Integer;
begin
  t := 0;
  for i := 1 to 10 do
  begin
    lock lm do
    begin
      if i = 3 then
        Continue;                { released before the next turn }
      if i = 8 then
        Break;                   { released before leaving the loop }
      t := t + i;
    end;
  end;
  lw.Wait;                       { returns at once }
  Result := t + Ord(lm.TryLock); { 25 + 1 }
end;

procedure PingPong(K: Integer);
var
  j: Integer;
begin
  for j := 1 to 50 do
  begin
    mu.Lock;
    while turn <> K do
      handoff.Wait(mu);
    turn := 3 - K;
    handoff.Signal;
    mu.Unlock;
  end;
  wg.Done;
end;

begin
  slow := 0;
  seen := 0;
  wg.Add(5);
  for i := 1 to 5 do
    pas Enter(i);
  wg.Wait;
  WriteLn(slow, ' ', seen);
  WriteLn(LocalCount);
  turn := 1;
  wg.Add(2);
  pas PingPong(1);
  pas PingPong(2);
  wg.Wait;
  WriteLn(turn);
end.

