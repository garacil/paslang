{ P350: a Sleep pokes the poller only when its timer comes before the
  earliest one, and one wake is written while one is pending, as Go's
  wakeNetPoller and netpollWakeSig. With a routine waiting in the
  poller (an accept nobody answers), the first Sleep, made when no timer
  was ever set, and one made after the heap emptied come back; a Sleep
  earlier than a long one wakes long before it, and one later than a
  short one on its own time. The first slept for ever when an empty
  heap's earliest read as 0 (rt_timer0 before the first timer), and the
  second on arm64 when the drain left the pending wake set. }
program pokewait;

uses
  pasnet, paslib;

var
  l, t0, ms, bad: Integer;

procedure Waiter;
var
  c: Integer;
begin
  c := TcpAccept(l);
  TcpClose(c);
end;

procedure Sleeper(Ms: Integer);
begin
  Sleep(Ms);
end;

function Took(Ms: Integer): Integer;
begin
  t0 := Nanotime;
  Sleep(Ms);
  Result := (Nanotime - t0) div 1000000;
end;

begin
  bad := 0;
  l := TcpListen(0);
  pas Waiter;
  Yield;
  if Took(20) < 20 then
    bad := bad + 1;
  WriteLn('the first Sleep came back');
  if Took(20) < 20 then
    bad := bad + 1;
  WriteLn('a Sleep after the heap emptied came back');
  { the earliest timer 600 ms away: this one is earlier and pokes }
  pas Sleeper(600);
  Yield;
  ms := Took(20);
  if (ms < 20) or (ms >= 300) then
    bad := bad + 1;
  WriteLn('a Sleep before a longer one woke first');
  { the earliest 10 ms away: this one is later, the poller meets it }
  pas Sleeper(10);
  Yield;
  if Took(40) < 40 then
    bad := bad + 1;
  WriteLn('a Sleep after a shorter one came back on its time');
  if bad <> 0 then
    WriteLn(bad, ' Sleeps woke at the wrong time');
  Halt(0);
end.
