program chanany;

{ A channel carries any type (1.0.83): strings, records, arrays; a value
  wider than a word travels in a box. A received value is the receiver's
  own: the sender changing its variable afterwards does not show. A
  closed channel gives the zero value. }

type
  TMsg = record
    Id: Integer;
    Text: string;
    Parts: array[0..1] of string;
  end;
  TTrio = array[0..2] of Integer;
  TList = array of Integer;

var
  cs, done: chan of string;
  cm: chan of TMsg;
  ct: chan of TTrio;
  cl: chan of TList;
  s, got: string;
  m: TMsg;
  t: TTrio;
  l: TList;
  i: Integer;

procedure Strings;
var
  buf: string;
  k: Integer;
begin
  buf := 'hello';
  Send(cs, buf);
  buf[1] := 'J';
  Send(cs, buf + ' world');
  for k := 1 to 3 do
    Send(cs, 'n' + Chr(48 + k));
  Close(cs);
end;

procedure Records;
var
  x: TMsg;
begin
  x.Id := 7;
  x.Text := 'seven';
  x.Parts[0] := 'a';
  x.Parts[1] := 'b';
  Send(cm, x);
  x.Text[1] := 'S';
  x.Id := 8;
  Send(cm, x);
end;

procedure Arrays;
var
  y: TTrio;
  z: TList;
begin
  y[0] := 1;
  y[1] := 2;
  y[2] := 3;
  Send(ct, y);
  SetLength(z, 4);
  z[3] := 44;
  Send(cl, z);
end;

procedure Selecting;
var
  w: string;
begin
  w := 'via select';
  select
    Send(cs, w):
      w[1] := 'V';
  end;
  Send(done, w);
end;

begin
  cs := MakeChan();
  cm := MakeChan();
  ct := MakeChan();
  cl := MakeChan();
  done := MakeChan();
  pas Strings;
  s := Recv(cs);
  WriteLn(s, ' ', Length(s));
  WriteLn(Recv(cs));
  for i := 1 to 3 do
  begin
    s := Recv(cs);
    Write(s, ' ');
  end;
  WriteLn;
  s := Recv(cs);
  WriteLn('closed: [', s, '] ', Length(s));
  pas Records;
  m := Recv(cm);
  WriteLn(m.Id, ' ', m.Text, ' ', m.Parts[0], m.Parts[1]);
  m := Recv(cm);
  WriteLn(m.Id, ' ', m.Text);
  pas Arrays;
  t := Recv(ct);
  WriteLn(t[0] + t[1] + t[2]);
  l := Recv(cl);
  WriteLn(Length(l), ' ', l[3]);
  cs := MakeChan();
  pas Selecting;
  select
    Recv(cs, got):
      WriteLn('select got ', got);
  end;
  WriteLn(Recv(done));
  Close(cm);
  m := Recv(cm);
  WriteLn('zero: ', m.Id, ' [', m.Text, ']');
end.

