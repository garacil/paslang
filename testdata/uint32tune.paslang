program uint32tune;
{ Width and tune switches share one compilation. The expected numbers are
  computed independently with arbitrary-precision integers in the check helper.
  Every function is called with inline disabled when its ELF body is checked. }

{$ifdef CPUX86_64}
{$TUNE generic}
{$else}
{$TUNE neoverse-n1}
{$endif}

function N1XFirst99(a: Integer): Integer;
begin Result := a * 99; end;

function N1WFirst99(a: UInt32): UInt32;
begin Result := a * 99; end;

function N1XAfterW99(a: Integer): Integer;
begin Result := a * 99; end;

function N1WAfterX99(a: UInt32): UInt32;
begin Result := a * 99; end;

{$ifdef CPUX86_64}
{$TUNE generic}
{$else}
{$TUNE neoverse-n2}
{$endif}

function N2X99(a: Integer): Integer;
begin Result := a * 99; end;

function N2W99(a: UInt32): UInt32;
begin Result := a * 99; end;

{$ifdef CPUX86_64}
{$TUNE generic}
{$else}
{$TUNE neoverse-n1}
{$endif}

function N1XAgain99(a: Integer): Integer;
begin Result := a * 99; end;

function N1WAgain99(a: UInt32): UInt32;
begin Result := a * 99; end;

function N1WBit31(a: UInt32): UInt32;
begin Result := a * 2147483648; end;

function N1WMinus1(a: UInt32): UInt32;
begin Result := a * 4294967295; end;

function N1XBit31(a: Integer): Integer;
begin Result := a * 2147483648; end;

function N1XPositiveFFFFFFFF(a: Integer): Integer;
begin Result := a * 4294967295; end;

{$TUNE DEFAULT}

function DefaultX99(a: Integer): Integer;
begin Result := a * 99; end;

function DefaultWideFromU32(a: UInt32): Integer;
begin Result := a * 99; end;

function DefaultXBit32(a: Integer): Integer;
begin Result := a * 4294967296; end;

begin
  WriteLn(N1XFirst99(0));
  WriteLn(N1XFirst99(1));
  WriteLn(N1XFirst99((-1)));
  WriteLn(N1XFirst99(2147483647));
  WriteLn(N1XFirst99(2147483648));
  WriteLn(N1XFirst99(4294967295));
  WriteLn(N1XFirst99(4294967296));
  WriteLn(N1XFirst99(1311768467034293607));
  WriteLn(N1XFirst99(9223372036854775807));
  WriteLn(N1XFirst99((-9223372036854775807 - 1)));
  WriteLn(N1WFirst99(0));
  WriteLn(N1WFirst99(1));
  WriteLn(N1WFirst99(2));
  WriteLn(N1WFirst99(2147483647));
  WriteLn(N1WFirst99(2147483648));
  WriteLn(N1WFirst99(2166572391));
  WriteLn(N1WFirst99(4294967294));
  WriteLn(N1WFirst99(4294967295));
  WriteLn(N1XAfterW99(0));
  WriteLn(N1XAfterW99(1));
  WriteLn(N1XAfterW99((-1)));
  WriteLn(N1XAfterW99(2147483647));
  WriteLn(N1XAfterW99(2147483648));
  WriteLn(N1XAfterW99(4294967295));
  WriteLn(N1XAfterW99(4294967296));
  WriteLn(N1XAfterW99(1311768467034293607));
  WriteLn(N1XAfterW99(9223372036854775807));
  WriteLn(N1XAfterW99((-9223372036854775807 - 1)));
  WriteLn(N1WAfterX99(0));
  WriteLn(N1WAfterX99(1));
  WriteLn(N1WAfterX99(2));
  WriteLn(N1WAfterX99(2147483647));
  WriteLn(N1WAfterX99(2147483648));
  WriteLn(N1WAfterX99(2166572391));
  WriteLn(N1WAfterX99(4294967294));
  WriteLn(N1WAfterX99(4294967295));
  WriteLn(N2X99(0));
  WriteLn(N2X99(1));
  WriteLn(N2X99((-1)));
  WriteLn(N2X99(2147483647));
  WriteLn(N2X99(2147483648));
  WriteLn(N2X99(4294967295));
  WriteLn(N2X99(4294967296));
  WriteLn(N2X99(1311768467034293607));
  WriteLn(N2X99(9223372036854775807));
  WriteLn(N2X99((-9223372036854775807 - 1)));
  WriteLn(N2W99(0));
  WriteLn(N2W99(1));
  WriteLn(N2W99(2));
  WriteLn(N2W99(2147483647));
  WriteLn(N2W99(2147483648));
  WriteLn(N2W99(2166572391));
  WriteLn(N2W99(4294967294));
  WriteLn(N2W99(4294967295));
  WriteLn(N1XAgain99(0));
  WriteLn(N1XAgain99(1));
  WriteLn(N1XAgain99((-1)));
  WriteLn(N1XAgain99(2147483647));
  WriteLn(N1XAgain99(2147483648));
  WriteLn(N1XAgain99(4294967295));
  WriteLn(N1XAgain99(4294967296));
  WriteLn(N1XAgain99(1311768467034293607));
  WriteLn(N1XAgain99(9223372036854775807));
  WriteLn(N1XAgain99((-9223372036854775807 - 1)));
  WriteLn(N1WAgain99(0));
  WriteLn(N1WAgain99(1));
  WriteLn(N1WAgain99(2));
  WriteLn(N1WAgain99(2147483647));
  WriteLn(N1WAgain99(2147483648));
  WriteLn(N1WAgain99(2166572391));
  WriteLn(N1WAgain99(4294967294));
  WriteLn(N1WAgain99(4294967295));
  WriteLn(N1WBit31(0));
  WriteLn(N1WBit31(1));
  WriteLn(N1WBit31(2));
  WriteLn(N1WBit31(2147483647));
  WriteLn(N1WBit31(2147483648));
  WriteLn(N1WBit31(2166572391));
  WriteLn(N1WBit31(4294967294));
  WriteLn(N1WBit31(4294967295));
  WriteLn(N1WMinus1(0));
  WriteLn(N1WMinus1(1));
  WriteLn(N1WMinus1(2));
  WriteLn(N1WMinus1(2147483647));
  WriteLn(N1WMinus1(2147483648));
  WriteLn(N1WMinus1(2166572391));
  WriteLn(N1WMinus1(4294967294));
  WriteLn(N1WMinus1(4294967295));
  WriteLn(N1XBit31(0));
  WriteLn(N1XBit31(1));
  WriteLn(N1XBit31((-1)));
  WriteLn(N1XBit31(2147483647));
  WriteLn(N1XBit31(2147483648));
  WriteLn(N1XBit31(4294967295));
  WriteLn(N1XBit31(4294967296));
  WriteLn(N1XBit31(1311768467034293607));
  WriteLn(N1XBit31(9223372036854775807));
  WriteLn(N1XBit31((-9223372036854775807 - 1)));
  WriteLn(N1XPositiveFFFFFFFF(0));
  WriteLn(N1XPositiveFFFFFFFF(1));
  WriteLn(N1XPositiveFFFFFFFF((-1)));
  WriteLn(N1XPositiveFFFFFFFF(2147483647));
  WriteLn(N1XPositiveFFFFFFFF(2147483648));
  WriteLn(N1XPositiveFFFFFFFF(4294967295));
  WriteLn(N1XPositiveFFFFFFFF(4294967296));
  WriteLn(N1XPositiveFFFFFFFF(1311768467034293607));
  WriteLn(N1XPositiveFFFFFFFF(9223372036854775807));
  WriteLn(N1XPositiveFFFFFFFF((-9223372036854775807 - 1)));
  WriteLn(DefaultX99(0));
  WriteLn(DefaultX99(1));
  WriteLn(DefaultX99((-1)));
  WriteLn(DefaultX99(2147483647));
  WriteLn(DefaultX99(2147483648));
  WriteLn(DefaultX99(4294967295));
  WriteLn(DefaultX99(4294967296));
  WriteLn(DefaultX99(1311768467034293607));
  WriteLn(DefaultX99(9223372036854775807));
  WriteLn(DefaultX99((-9223372036854775807 - 1)));
  WriteLn(DefaultWideFromU32(0));
  WriteLn(DefaultWideFromU32(1));
  WriteLn(DefaultWideFromU32(2));
  WriteLn(DefaultWideFromU32(2147483647));
  WriteLn(DefaultWideFromU32(2147483648));
  WriteLn(DefaultWideFromU32(2166572391));
  WriteLn(DefaultWideFromU32(4294967294));
  WriteLn(DefaultWideFromU32(4294967295));
  WriteLn(DefaultXBit32(0));
  WriteLn(DefaultXBit32(1));
  WriteLn(DefaultXBit32((-1)));
  WriteLn(DefaultXBit32(2147483647));
  WriteLn(DefaultXBit32(2147483648));
  WriteLn(DefaultXBit32(4294967295));
  WriteLn(DefaultXBit32(4294967296));
  WriteLn(DefaultXBit32(1311768467034293607));
  WriteLn(DefaultXBit32(9223372036854775807));
  WriteLn(DefaultXBit32((-9223372036854775807 - 1)));
end.
