program dwarfnarrow;

{ The debug information types every integer local (1.0.92): gdb reads a
  Byte as one byte and an Int8, an Int16 and an Int32 with their sign. }

procedure Show;
var
  b: Byte;
  s8: Int8;
  w: Word;
  s16: Int16;
  u32: UInt32;
  s32: Int32;
  n: Integer;
begin
  b := 255;
  s8 := -1;
  w := 65535;
  s16 := -2;
  u32 := 4000000000;
  s32 := -3;
  n := -4;
  WriteLn(b, ' ', s8, ' ', w, ' ', s16, ' ', u32, ' ', s32, ' ', n);
end;

begin
  Show;
end.

