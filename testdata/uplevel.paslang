{ P357: a nested routine reads its outer routine's variables in the
  pool. Deep reads two levels out and one, and writes both; Mid reads
  and writes its outer routine's word, Int32 and Byte, in an expression,
  a condition, a call's arguments and an index. The answers are worked
  out by hand in the comments; scripts/check_argpush.py finds no push
  in Mid and Deep. }
program uplevel;

var
  ga: array[0..3] of Integer;
  i: Integer;

function Sum3(A, B, C: Integer): Integer;
begin
  Result := A * 10000 + B * 100 + C;
end;

function Outer(K: Integer): Integer;
var
  base, acc: Integer;
  small: Int32;
  flag: Byte;

  function Mid(X: Integer): Integer;
  var
    m, t1, t2: Integer;

    function Deep(Y: Integer): Integer;
    begin
      Result := base + m * Y + small;
      acc := acc + Y * 2;
      m := m + 1;
    end;

  begin
    m := X + 1;
    t1 := Deep(X);
    t2 := Deep(m);
    Result := t1 + t2;
    if (acc > 10) and (base <> 0) then
      flag := flag + 1;
    small := small - 3;
    Result := Result + Sum3(base div 100, acc mod 7, m) + ga[acc mod 4];
  end;

begin
  { Mid(5): m 6; Deep(5) 1000 + 30 + 7 = 1037, acc 15, m 7; Deep(7)
    1000 + 49 + 7 = 1056, acc 29, m 8; flag 1, small 4; Sum3(10, 1, 8)
    = 100108, ga[1] = 4: 102205. Mid(6): m 7; Deep(6) 1000 + 42 + 4 =
    1046, acc 41, m 8; Deep(8) 1000 + 64 + 4 = 1068, acc 57, m 9; flag
    2, small 1; Sum3(10, 1, 9) = 100109, ga[1] = 4: 102227. }
  base := 1000;
  acc := K;
  small := 7;
  flag := 0;
  Result := Mid(K) + Mid(K + 1);
  { 57 1 2 }
  WriteLn(acc, ' ', small, ' ', flag);
end;

begin
  for i := 0 to 3 do
    ga[i] := i * 3 + 1;
  { 102205 + 102227 = 204432 }
  WriteLn(Outer(5));
end.
