{ P336: a loop of four passes or fewer that the optimizer unrolls keeps
  its counter where the body's calls, pointers and nested routines read
  it: a global a routine reads, a local whose address is taken, one a
  nested routine reads and a var parameter, each stored before its
  copy. The answers are those of the loops as written, worked out by
  hand in the comments, the same at every -inline. }
program unrollctr;

uses paslib;

type
  PInt = ^Integer;

var
  gi, seen: Integer;

procedure Look;
begin
  seen := seen * 3 + gi;
end;

function Peek(P: PInt): Integer;
begin
  Result := P^;
end;

{ k read through its address, by a call and in the body itself:
  (1 + 2 + 3) * 10, then (1 + 2) * 1000, and k 2 after }
function ByPointer: Integer;
var
  k, s: Integer;
  p: PInt;
begin
  p := @k;
  s := 0;
  for k := 1 to 3 do
    s := s + Peek(p) * 10;
  for k := 1 to 2 do
    s := s + p^ * 1000;
  Result := s + k;
end;

{ k read by a nested routine: 4 * 100 + 3 * 100 + 2 * 100 + 1 * 100 }
function ByNested: Integer;
var
  k, s: Integer;

  function Now: Integer;
  begin
    Result := k * 100;
  end;

begin
  s := 0;
  for k := 4 downto 1 do
    s := s + Now;
  Result := s + k;
end;

{ X the global gi, which Look reads: 0 * 3 + 1, then 1 * 3 + 2 }
procedure ByVar(var X: Integer);
begin
  for X := 1 to 2 do
    Look;
end;

begin
  { gi a global Look reads: 0, 1, 5, 18, 58 }
  seen := 0;
  for gi := 1 to 4 do
    Look;
  WriteLn(seen, ' ', gi);
  WriteLn(ByPointer, ' ', ByNested);
  seen := 0;
  ByVar(gi);
  WriteLn(seen, ' ', gi);
end.

