program valpar;

{ A value parameter is a copy (1.0.81): a routine that changes its
  string, record, array, interface or method parameter changes its own
  copy, not the caller's variable. A var parameter is the variable. }

type
  TR = record
    A, B: Integer;
    S: string;
  end;
  TArr = array[0..2] of Integer;
  TDyn = array of Integer;
  TObj = class
    procedure Take(R: TR);
  end;

procedure TObj.Take(R: TR);
begin
  R.A := R.A * 100;
  WriteLn('method ', R.A);
end;

procedure SetStr(S: string);
begin
  S := 'changed';
  WriteLn('in: ', S);
end;

procedure SetRec(R: TR);
begin
  R.A := 99;
  R.S := R.S + '!';
  WriteLn('in: ', R.A, ' ', R.S);
end;

procedure SetArr(A: TArr);
begin
  A[1] := -1;
  WriteLn('in: ', A[0], A[1], A[2]);
end;

procedure Grow(D: TDyn);
begin
  SetLength(D, 10);
  D[0] := 7;
  WriteLn('in: ', Length(D));
end;

procedure Poke(D: TDyn);
begin
  D[0] := 42;
end;

procedure Bump(var X: Integer);
begin
  X := X + 1;
end;

procedure ByVar(R: TR);
begin
  Bump(R.B);
  WriteLn('in: ', R.B);
end;

procedure Nested(S: string);
  procedure Inner;
  begin
    S := S + '-inner';
  end;
begin
  Inner;
  WriteLn('in: ', S);
end;

procedure ReadOnly(const S: string; R: TR);
begin
  WriteLn('reads ', S, ' ', R.A);
end;

procedure RefStr(var S: string);
begin
  S := S + '+ref';
end;

var
  t: string;
  r: TR;
  a: TArr;
  d: TDyn;
  o: TObj;

begin
  t := 'orig';
  SetStr(t);
  WriteLn('out: ', t);
  r.A := 1;
  r.B := 2;
  r.S := 'rs';
  SetRec(r);
  WriteLn('out: ', r.A, ' ', r.S);
  a[0] := 1;
  a[1] := 2;
  a[2] := 3;
  SetArr(a);
  WriteLn('out: ', a[0], a[1], a[2]);
  SetLength(d, 3);
  d[0] := 5;
  Grow(d);
  WriteLn('out: ', Length(d), ' ', d[0]);
  Poke(d);
  WriteLn('shared elements: ', d[0]);
  ByVar(r);
  WriteLn('out: ', r.B);
  Nested(t);
  WriteLn('out: ', t);
  ReadOnly(t, r);
  o := TObj.Create;
  o.Take(r);
  WriteLn('out: ', r.A);
  RefStr(t);
  WriteLn('var: ', t);
end.

