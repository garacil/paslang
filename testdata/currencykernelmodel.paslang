{$mode objfpc}{$H+}
program currencykernelmodel;
{$ifdef FPC}uses pasfmt;{$endif}
var count, i, a, b, n, value, code, bits, lo, hi: Int64;
  operation, text: string; realValue: Double; valid: Boolean;
function ReadInteger: Int64;
var input: string; error: Integer;
begin
  ReadLn(input); Val(input, Result, error);
  if error <> 0 then Halt(2);
end;
begin
  count := ReadInteger;
  for i := 1 to count do
  begin
    ReadLn(operation); ReadLn(text); b := ReadInteger; n := ReadInteger;
    try
      if operation = 'parse' then
      begin
        valid := PasTryParseCurrency(text, value);
        if not valid then begin WriteLn('parse error ', value); Continue end;
      end
      else
      begin
        Val(text, a, code); if code <> 0 then Halt(3);
        if operation = 'add' then value := PasCurrAdd(a, b)
        else if operation = 'sub' then value := PasCurrSub(a, b)
        else if operation = 'mul' then value := PasCurrMul(a, b)
        else if operation = 'div' then value := PasCurrDiv(a, b)
        else if operation = 'neg' then value := PasCurrNeg(a)
        else if operation = 'abs' then value := PasCurrAbs(a)
        else if operation = 'int' then value := PasCurrFromInt(a)
        else if operation = 'real' then
        begin realValue := 0; Move(a, realValue, 8); value := PasCurrFromReal(realValue) end
        else if operation = 'quad' then value := PasCurrFromQuad(a, b)
        else if operation = 'scaled' then value := a
        else Halt(4);
      end;
      realValue := PasCurrToReal(value); bits := 0; Move(realValue, bits, 8);
      WriteLn(value, ' ', PasFmtCurrency(value, 0, -1), ' ',
        PasFmtCurrency(value, 0, n), ' ', bits, ' ', PasCurrTrunc(value),
        ' ', PasCurrRound(value), ' ', PasCurrFloor(value), ' ', PasCurrCeil(value));
      { Significant/shortest digits are independently modelled too. }
      text := PasCurrencyDigits(value, 0, 0, lo);
      operation := PasCurrencyDigits(value, 1, 7, hi);
      WriteLn('[', text, '] ', lo, ' [', operation, '] ', hi);
    except
      on error: ECurrencyError do WriteLn('fault ', Ord(error.Kind));
    end;
  end;
end.
