{ Reads of a nil map give the zero value and never stop the program;
  the first write to a nil map stops it with paslang: nil map and exit
  status 1, like every runtime domain error. The Makefile checks the
  message and the status. }
program nilmap;

var
  m: map[string] of Integer;
  v: Integer;

begin
  WriteLn(Length(m), ' ', m['x'], ' ', 'x' in m, ' ', TryGet(m, 'x', v));
  Delete(m, 'x');
  Clear(m);
  WriteLn('reads ok');
  m['x'] := 1;
  WriteLn('never printed');
end.
