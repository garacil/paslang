program debuggrow;
uses SysUtils;

procedure Grow(Depth: Integer);
var pad: array[0..8191] of Integer;
begin
  pad[0] := Depth;
  if Depth > 0 then Grow(Depth - 1);
  if pad[0] <> Depth then Halt(1);
end;

procedure Show;
var amount, upper, lower: Currency;
begin
  amount := 2.675;
  upper := High(Currency);
  lower := Low(Currency);
  Grow(40); { the debugger's next must step over growing nested frames }
  amount := amount + 0.0001;
  WriteLn(amount, ' ', upper, ' ', lower);
end;

begin Show end.
