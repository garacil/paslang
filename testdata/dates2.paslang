{ SysUtils' dates and times (P131) where paslang writes otherwise than
  Free Pascal 3.2.2, as the manual's section 19 says; each line says
  what 3.2.2 writes. And the clock itself, which no output can hold:
  Now, Date, Time, NowUTC, GetLocalTime and GetUniversalTime agree with
  one another, and a year of two digits is placed by today's year. }
program dates2;

uses sysutils;

function Bits(d: Double): string;
var
  i: Int64;
begin
  Move(d, i, 8);
  Result := IntToHex(i, 16);
end;

function B(x: Boolean): string;
begin
  if x then
    Result := 'T'
  else
    Result := 'F';
end;

procedure Try2(const What: string; y, m, d: Integer);
begin
  try
    WriteLn(What, ' ', Bits(EncodeDate(y, m, d)));
  except
    on E: EConvertError do
      WriteLn(What, ' ! ', E.Message);
  end;
end;

procedure TryT(const What: string; h, n, s, ms: Integer);
begin
  try
    WriteLn(What, ' ', Bits(EncodeTime(h, n, s, ms)));
  except
    on E: EConvertError do
      WriteLn(What, ' ! ', E.Message);
  end;
end;

var
  vals: array[1..6] of Double;
  i: Integer;
  fs: TFormatSettings;
  s: string;
  d, t, n, u: TDateTime;
  sys, sys2: TSystemTime;
  y, cy: Integer;
  p: PChar;
begin
  { a value parameter Free Pascal declares a Word is an Integer: 70000,
    -5 and -1 are what they are (3.2.2: 4464-1-1 is a date, 65531 and
    65535 in the messages) }
  Try2('year 70000', 70000, 1, 1);
  Try2('year -5', -5, 1, 1);
  TryT('hour -1', -1, 0, 0, 0);
  WriteLn(B(TryEncodeDate(2026, 70002, 1, d)), ' ', B(IsLeapYear(-4)), ' ', B(IsLeapYear(70000)));
  { 23:59:60, a leap second, is the next midnight, as in Free Pascal
    3.3.1 (3.2.2: not a valid time specification) }
  TryT('leap', 23, 59, 60, 0);
  TryT('not leap', 22, 59, 60, 0);
  WriteLn(Bits(StrToTime('23:59:60')));
  { an interval before 0 has its sign, [hh] and [nn] two digits, and the
    counts 64 bits, as 3.3.1 (3.2.2: no sign, one digit, 32 bits that
    wrap to negative numbers) }
  vals[1] := EncodeDate(2026, 9, 30) + EncodeTime(14, 5, 7, 89);
  vals[2] := 0;
  vals[3] := -1.25;
  vals[4] := EncodeTime(0, 30, 0, 0);
  vals[5] := EncodeDate(1, 1, 1) + EncodeTime(0, 0, 1, 0);
  vals[6] := EncodeDate(9999, 12, 31) + EncodeTime(12, 30, 0, 0);
  for i := 1 to 6 do
    WriteLn('iv ', i, ' [', FormatDateTime('[h]:nn:ss [n] [s] [hh]:mm [mm] [nn]', vals[i],
      [fdoInterval]), ']');
  { a #0 separator is none, as 3.3.1 (3.2.2 ends the text there) }
  fs := DefaultFormatSettings;
  fs.TimeSeparator := #0;
  fs.DateSeparator := #0;
  WriteLn('[', FormatDateTime('dd/mm/yyyy hh:nn:ss', vals[1], fs), '] [', TimeToStr(vals[1], fs), ']');
  { a letter that is no directive as it is written (3.2.2: in capitals,
    30.09.2026 X Q E G) }
  WriteLn('[', FormatDateTime('dd.mm.yyyy x q e g', vals[1]), ']');
  { no 255-character limit (3.2.2 cuts the text at 255) }
  s := '';
  while Length(s) < 300 do
    s := s + 'yyyy-';
  WriteLn(Length(FormatDateTime(s, vals[1])), ' ', Length(s));
  { a number too long for its field is a bad date format, as 3.3.1's Val
    says (3.2.2: Invalid date) }
  try
    d := StrToDate('30-9-9999999999');
  except
    on E: EConvertError do
      WriteLn(E.Message);
  end;
  { a PChar and a length }
  s := '30-9-2026 garbage';
  p := PChar(s);
  WriteLn(FormatDateTime('yyyy-mm-dd', StrToDate(p, 9, 'd/m/y')), ' ',
    FormatDateTime('hh:nn', StrToTime(PChar('14:05xyz'), 5)));
  { TSystemTime's Windows names, 3.3.1's variant }
  DateTimeToSystemTime(vals[1], sys);
  WriteLn(sys.wYear, ' ', sys.wMonth, ' ', sys.wDay, ' ', sys.wDayOfWeek, ' ', sys.wHour, ' ',
    sys.wMinute, ' ', sys.wSecond, ' ', sys.wMilliseconds);
  { the clock: the readings are within a minute of one another (read
    again when midnight falls between them); UTC and the local time
    differ by the zone's offset; GetUniversalTime fills the day of the
    week too, where 3.2.2 leaves it }
  repeat
    d := Date;
    n := Now;
    t := Time;
    u := NowUTC;
  until (Trunc(n) = d) and (Date = d);
  WriteLn(B(Abs(n - (d + t)) < 60 / SecsPerDay), ' ', B(Frac(d) = 0), ' ', B(t < 1),
    ' ', B(Abs(LocalTimeToUniversal(n) - u) < 60 / SecsPerDay),
    ' ', B(Abs(UniversalTimeToLocal(u) - n) < 60 / SecsPerDay),
    ' ', B(Abs((n - u) * MinsPerDay + GetLocalTimeOffset) < 1.5));
  sys2.DayOfWeek := 99;
  GetUniversalTime(sys2);
  GetLocalTime(sys);
  WriteLn(B(sys2.DayOfWeek = DayOfWeek(u) - 1), ' ', B(sys.DayOfWeek = DayOfWeek(n) - 1), ' ',
    B(CurrentYear = sys.Year), ' ', B(sys.Year >= 2026));
  { a year of two digits: in the hundred years that end
    TwoDigitYearCenturyWindow years after this one (read again when the
    year turns meanwhile) }
  repeat
    cy := CurrentYear;
    s := '';
    for i := 0 to 3 do
    begin
      y := i * 33;
      d := StrToDate('1-6-' + IntToStr(y));
      y := y + (cy - 50) div 100 * 100;
      if y < cy - 50 then
        y := y + 100;
      s := s + B(FormatDateTime('yyyy', d) = IntToStr(y)) + ' ';
    end;
    d := StrToDate('15-6');
    s := s + B(FormatDateTime('yyyy', d) = IntToStr(cy));
  until CurrentYear = cy;
  WriteLn(s);
end.

