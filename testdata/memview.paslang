program memview;

{ Pointer bounds, the tools (P104): MemBase, MemSize and MemEnd give the
  object an address is in (a heap block, the routine's stack, the
  globals; 0 when none); View(p, n) is n elements at p as a slice; d[i..j]
  is a slice that shares its elements, a static array's too, capacity 0
  so SetLength takes a new block; s[i..j] of a string is a copy. }

type
  PRec = ^TRec;
  TRec = record
    A, B, C: Integer;
  end;

var
  g: array[1..10] of Integer;
  d, e, f: array of Integer;
  q: PRec;
  p: Pointer;
  ip: PInteger;
  v: array of Integer;
  s: string;
  i: Integer;

procedure Local;
var
  x: Integer;
begin
  x := 5;
  WriteLn('local ', MemBase(@x) <> 0, ' ', MemBase(@x) <= Integer(@x),
    ' ', Integer(@x) < MemEnd(@x), ' ', MemSize(@x) >= 4096, ' ', x);
end;

procedure Show(const Name: string; const A: array of Integer);
var
  k: Integer;
begin
  Write(Name, ' [', Length(A), ']');
  for k := 0 to High(A) do
    Write(' ', A[k]);
  WriteLn;
end;

begin
  New(q);
  WriteLn('new ', MemBase(q) = Integer(q), ' ', MemSize(q) >= SizeOf(TRec),
    ' ', MemEnd(q) = MemBase(q) + MemSize(q), ' ', MemBase(@q^.C) = Integer(q));
  p := GetMem(1000);
  WriteLn('getmem ', MemBase(p) = Integer(p), ' ', MemSize(p) >= 1000,
    ' ', MemBase(PByte(p) + 999) = Integer(p));
  WriteLn('global ', MemBase(@g[3]) <> 0, ' ', MemBase(@g[3]) <= Integer(@g[3]),
    ' ', Integer(@g[10]) < MemEnd(@g[1]));
  WriteLn('nil ', MemBase(nil), ' ', MemSize(nil), ' ', MemEnd(Pointer(8)));
  Local;
  for i := 1 to 10 do
    g[i] := i * 10;
  ip := @g[3];
  v := View(ip, 4);
  Show('view', v);
  v[0] := -30;
  WriteLn('through the view ', g[3]);
  SetLength(v, 6);
  v[1] := 0;
  WriteLn('after SetLength ', g[4], ' ', Length(v));
  ip := PInteger(p);
  for i := 0 to 9 do
    ip[i] := i * i;
  Show('getmem view', View(ip + 2, 5));
  SetLength(d, 8);
  for i := 0 to 7 do
    d[i] := i;
  e := d[2..5];
  Show('d[2..5]', e);
  e[0] := 200;
  WriteLn('shared ', d[2]);
  f := e[1..2];
  Show('e[1..2]', f);
  Show('d[3..2]', d[3..2]);
  Show('d[0..High(d)]', d[0..High(d)]);
  SetLength(e, 10);
  e[1] := 300;
  WriteLn('e grew apart ', d[3], ' ', e[1], ' ', Length(d));
  Show('g[2..5]', g[2..5]);
  g[2..5][0] := 7;
  WriteLn('g[2] ', g[2]);
  s := 'address';
  WriteLn(s[2..4], ' ', s[1..1], ' ', Length(s[3..2]));
end.

