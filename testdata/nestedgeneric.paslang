program nestedgeneric;
{$mode objfpc}{$H+}{$modeswitch advancedrecords}
type
  TOuter = record
    const K = 3;
    type T = Byte;
      generic TPair<T> = record
        Value: T;
        Other: array[0..K - 1] of Byte;
      end;
      TNumber = specialize TPair<Int64>;
      TText = specialize TPair<string>;
  var
    Item: TNumber;
    Text: TText;
  end;
  TNumber = specialize TOuter.TPair<Int64>;
  TText = specialize TOuter.TPair<string>;
var R: TOuter; P: TNumber; S: TText;
begin
  R.Item.Value := 300;
  P.Value := 700;
  R.Text.Value := 'outer';
  S := R.Text;
  S.Value[1] := 'O';
  WriteLn('generic ', R.Item.Value, ' ', P.Value, ' ', SizeOf(P.Other), ' ',
    R.Text.Value, ' ', S.Value, ' ', SizeOf(TOuter.T));
end.
