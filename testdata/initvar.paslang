{ Variables with a value and absolute (P144): a global starts with its
  value; a routine's variable takes it at every call; absolute is
  another name for a variable of its type. }
program initvar;

type
  TNames = array[1..3] of string;
  TSettings = record
    Sep: Char;
    Digits: Int64;
    Money: string;
    Names: TNames;
  end;
  TColor = (Red, Green, Blue);
  TColors = set of TColor;

var
  Settings: TSettings = (Sep: '.'; Digits: 2; Money: '$'; Names: ('one', 'two', 'three'));
  Current: TSettings absolute Settings;
  Count: Int64 = 40;
  Ratio: Double = 2.5;
  Name: string = 'initvar';
  Shade: TColor = Blue;
  Shades: TColors = [Red, Blue];
  Flag: Boolean = True;
  Letter: Char = 'q';
  Ptr: Pointer = nil;

function Depth(N: Int64): string;
var
  Trail: string = '<';
  Level: Int64 = 100;
begin
  Trail := Trail + Chr(48 + N);
  Level := Level + N;
  if N > 0 then
    Result := Trail + Depth(N - 1) + Chr(48 + Level mod 10)
  else
    Result := Trail + '|';
end;

procedure Twice(var V: Int64; W: Int64);
var
  Alias: Int64 absolute V;
  Twin: Int64 absolute W;
  Local: Int64 = 7;
  Same: Int64 absolute Local;
begin
  Alias := Alias * 2;
  Twin := Twin + 1;
  Same := Same + W;
  WriteLn('twice ', V, ' ', W, ' ', Local);
end;

var
  k: Int64;
begin
  WriteLn(Settings.Sep, ' ', Settings.Digits, ' ', Settings.Money, ' ', Settings.Names[3]);
  Current.Sep := ',';
  Current.Names[1] := 'uno';
  WriteLn(Settings.Sep, ' ', Settings.Names[1], ' ', Current.Names[2]);
  WriteLn(Count, ' ', Ratio:0:2, ' ', Name, ' ', Ord(Shade), ' ', Ord(Blue in Shades), ' ', Ord(Green in Shades),
    ' ', Ord(Flag), ' ', Letter, ' ', Ord(Ptr = nil));
  Count := Count + 2;
  Name := Name + '!';
  WriteLn(Count, ' ', Name);
  WriteLn(Depth(3));
  WriteLn(Depth(2));
  k := 5;
  Twice(k, 10);
  Twice(k, 20);
  WriteLn(k);
end.

