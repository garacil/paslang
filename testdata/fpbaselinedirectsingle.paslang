program fpbaselinedirectsingle;
var X: Single;
begin
  X := ($3F800000 as Single) + ($3F800000 as Single);
  if (X as UInt32) <> $40000000 then
  begin WriteLn('direct Single: ', X as UInt32, ' <> ', $40000000); Halt(88); end;
  WriteLn('ok FP direct Single');
end.
