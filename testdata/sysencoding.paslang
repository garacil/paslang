program sysencoding;
uses sysutils;
const Workers = 128;
var joined: waitgroup; i: Integer;
procedure Encode(Index: Integer);
var utf8, little, big, ascii: TEncoding; text, decoded: string;
  bytes, encoded, expected: TBytes; error: TEncodingError;
  builder: TStringBuilder; k: Integer;
begin
  utf8 := TEncoding.UTF8; little := TEncoding.Unicode;
  big := TEncoding.BigEndianUnicode; ascii := TEncoding.ASCII;
  if (utf8.CodePage <> 65001) or (little.CodePage <> 1200) or
    (big.CodePage <> 1201) or (ascii.CodePage <> 20127) then Halt(2);
  if (utf8.EncodingName <> 'UTF-8') or (ascii.EncodingName <> 'US-ASCII') then Halt(3);
  if TEncoding.ANSI.EncodingName <> utf8.EncodingName then Halt(4);
  for k := 1 to 32 do
  begin
    text := 'a'#0'ñ雪😀';
    expected := BytesOf(#97#0#0#0#241#0#234#150#61#216#0#222);
    encoded := little.GetBytes(text);
    if StringOf(encoded) <> StringOf(expected) then Halt(5);
    if little.GetString(encoded) <> text then Halt(6);
    bytes := big.GetBytes(text);
    expected := BytesOf(#0#97#0#0#0#241#150#234#216#61#222#0);
    if StringOf(bytes) <> StringOf(expected) then Halt(7);
    if big.GetString(bytes) <> text then Halt(8);
    bytes := TEncoding.Convert(big, utf8, bytes);
    if StringOf(bytes) <> text then Halt(9);
    if utf8.GetString(bytes) <> text then Halt(10);
    encoded := ascii.GetBytes('ASCII'#0'127');
    if ascii.GetString(encoded) <> 'ASCII'#0'127' then Halt(11);
    if ascii.TryGetBytes('okñ', bytes, error) then Halt(12);
    if (error.Kind <> teNonASCII) or (error.ByteIndex <> 2) or (Length(bytes) <> 0) then Halt(13);
    encoded := BytesOf('xx'#255);
    if utf8.TryGetString(encoded, 2, 1, decoded, error) then Halt(14);
    if (error.Kind <> teInvalidUTF8) or (error.ByteIndex <> 2) or (decoded <> '') then Halt(15);
    if utf8.TryGetString(encoded, 2, High(Integer), decoded, error) then Halt(16);
    if (error.Kind <> teRange) or (decoded <> '') then Halt(17);
    if not utf8.TryGetString(encoded, 3, 0, decoded, error) then Halt(18);
    if (decoded <> '') or (error.Kind <> teNone) or (error.ByteIndex <> -1) then Halt(19);
    encoded := BytesOf(#0#216#0);
    if little.TryGetString(encoded, decoded, error) then Halt(20);
    if (error.Kind <> teInvalidUTF16) or (error.ByteIndex <> 0) then Halt(21);
    try decoded := little.GetString(encoded); Halt(22)
    except on e: EEncodingError do if e.ByteIndex <> 0 then Halt(23); end;
    if StringOf(utf8.GetPreamble) <> #239#187#191 then Halt(24);
    if StringOf(little.GetPreamble) <> #255#254 then Halt(25);
    if StringOf(big.GetPreamble) <> #254#255 then Halt(26);
    if Length(ascii.GetPreamble) <> 0 then Halt(27);
  end;
  builder := TStringBuilder.Create;
  try
    builder.AddRune(0).AddRune($10FFFF).AddRune($FFFE);
    if builder.ToString <> #0#244#143#191#191#239#191#190 then Halt(28);
    text := builder.ToString;
    try builder.AddRune($D800); Halt(29) except on EEncodingError do ; end;
    try builder.AddRune(-1); Halt(30) except on EEncodingError do ; end;
    try builder.AddRune($110000); Halt(31) except on EEncodingError do ; end;
    if builder.ToString <> text then Halt(32);
    builder.AddInteger(Index);
    GcCollect;
    if builder.ToString <> text + IntToStr(Index) then Halt(33);
  finally builder.Free; end;
  joined.Done;
end;
begin
  joined.Add(Workers);
  for i := 0 to Workers - 1 do pas Encode(i);
  joined.Wait;
  WriteLn('immutable strict encodings ', Workers, ', Unicode scalars, byte errors, BOM and ownership');
end.
