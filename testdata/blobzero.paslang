{ A value whose size is not a multiple of 8 read from a missing map key
  is zero, and the bytes after it are left alone: arm64 zeroed it eight
  bytes at a time and, past the size, ran on until it faulted; so did the
  Result of a function returning one. Copy with an index below 1 starts
  at the first character, as FPC's does. }
program blobzero;

type
  TTri = array[0..2] of Char;
  TName = record
    n: array[0..9] of Char;
  end;
  TWrap = record
    t: TTri;
    guard: array[0..4] of Char;
  end;

function Make(c: Char): TTri;
begin
  Result[0] := c;
  Result[1] := c;
end;

var
  m: map[Integer] of TTri;
  mn: map[Integer] of TName;
  t: TTri;
  nm: TName;
  w: TWrap;
  i: Integer;
  s: string;

begin
  New(m);
  New(mn);
  t[0] := 'a';
  t[1] := 'b';
  t[2] := 'c';
  m[1] := t;
  for i := 0 to 4 do
    w.guard[i] := 'g';
  w.t := m[1];
  Write(w.t[0], w.t[1], w.t[2]);
  w.t := m[2];
  Write(' ', Ord(w.t[0]), Ord(w.t[1]), Ord(w.t[2]), ' ');
  for i := 0 to 4 do
    Write(w.guard[i]);
  WriteLn;
  for i := 0 to 9 do
    nm.n[i] := 'x';
  nm := mn[5];
  WriteLn(Ord(nm.n[0]), Ord(nm.n[9]));
  nm := Default(TName);
  WriteLn(Ord(nm.n[3]));
  s := 'abcdef';
  WriteLn('[', Copy(s, 0, 3), '] [', Copy(s, -5, 4), '] [', Copy(s, 1, 3), '] [',
    Copy(s, 7, 2), '] [', Copy(s, 1, 100), '] [', Copy(s, 3, 0), '] [', Copy(s, 3, -1), ']');
  s := '';
  WriteLn('[', Copy(s, 0, 1), ']');
  t := Make('q');
  WriteLn(t[0], t[1], Ord(t[2]));
end.

