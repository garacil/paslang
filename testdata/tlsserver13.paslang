program tlsserver13;

uses
  sysutils, paslib, pasnet, pasconn, pasroutines, pastls, httpserver;

var
  filePath: string;

procedure Hello(Req: THttpRequest; Resp: THttpResponse);
begin
  Resp.ReplyText(200, 'hello over TLS' + #10);
end;

procedure Echo(Req: THttpRequest; Resp: THttpResponse);
begin
  Resp.ReplyText(200, Req.ReadAllBody);
end;

procedure Download(Req: THttpRequest; Resp: THttpResponse);
begin
  Resp.ServeFile(filePath, 'application/octet-stream', '');
end;

procedure ServeRaw(Config: TTlsServerConfig);
var
  listener, fd, deadline: Integer;
  stream: TTlsStream;
  err: string;
begin
  Config.Alpn := ['pas-test', 'http/1.1'];
  listener := TcpListenAt('127.0.0.1', 0, 16);
  if listener < 0 then Halt(4);
  WriteLn(TcpPort(listener));
  fd := TcpAccept(listener);
  TcpClose(listener);
  if fd < 0 then Halt(6);
  deadline := PasIoDeadline(5000);
  stream := TlsServer(TTcpStream.Create(fd), Config, deadline, err);
  if stream = nil then
  begin
    WriteLn(err);
    Halt(7);
  end;
  if not stream.WriteAll(stream.RequestedServerName + ' ' + stream.Protocol, deadline) then Halt(8);
  stream.Dispose;
end;

var
  cert, key, err: string;
  config: TTlsServerConfig;
  router: THttpRouter;
  server: THttpServer;
begin
  if not ReadFile(ParamStr(1), cert) or not ReadFile(ParamStr(2), key) then Halt(2);
  config := TTlsServerConfig.Create;
  if ParamStr(5) = 'tls12' then config.MinVersion := TlsVersion12;
  config.SessionTickets := ParamStr(6) = 'tickets';
  if not config.LoadKeyPair(cert, key, err) then
  begin
    WriteLn(err);
    Halt(3);
  end;
  if ParamStr(4) = 'raw' then
  begin
    ServeRaw(config);
    Halt(0);
  end;
  filePath := ParamStr(3);
  router := THttpRouter.Create;
  router.Handle('GET', '/', @Hello);
  router.Handle('POST', '/echo', @Echo);
  router.Handle('GET', '/file', @Download);
  server := THttpServer.Create(router);
  server.AccessLog := False;
  server.HeaderTimeoutMs := 1800;
  server.ShutdownTimeoutMs := 2000;
  server.Tls := config;
  if not server.ListenTcp('127.0.0.1', 0) then Halt(4);
  WriteLn(server.Port);
  if server.ServeUntilSignal <> 15 then Halt(5);
end.
