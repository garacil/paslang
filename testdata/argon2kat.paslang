{ P438: Argon2 and BLAKE2b against their published vectors (uses
  argon2). BLAKE2b: RFC 7693 appendix A ('abc', 64 bytes) and the keyed
  vectors' shape; Argon2id, Argon2i and Argon2d: the reference
  implementation's kats (m=32 KiB, t=3, p=4, tag 32, a secret and
  associated data), RFC 9106 5.3; the PHC string written, parsed and
  verified, with a wrong password, a changed tag and malformed strings;
  base64 with no padding both ways; the parameters refused. }
program argon2kat;

uses
  argon2;

function Bytes(C: Char; N: Integer): string;
begin
  Result := StringOfChar(C, N);
end;

var
  pw, salt, secret, ad, tag, phc, s, r: string;
  i, t, m, p: Integer;
  b: TBlake2b;

begin
  WriteLn('blake2b-512 of abc: ', Hex(Blake2b('abc', 64, '')));
  WriteLn('blake2b-256 of empty: ', Hex(Blake2b('', 32, '')));
  { the same digest in one piece and in pieces of 1, 100 and 200 bytes }
  s := '';
  for i := 0 to 299 do
    s := s + Chr(i and 255);
  Blake2bInit(b, 64, '');
  Blake2bUpdate(b, Copy(s, 1, 1));
  Blake2bUpdate(b, Copy(s, 2, 100));
  Blake2bUpdate(b, Copy(s, 102, 199));
  WriteLn('pieces equal: ', Blake2bFinal(b) = Blake2b(s, 64, ''));
  WriteLn('keyed blake2b-64 of 00..ff: ', Hex(Blake2b(Copy(s, 1, 255), 64, Copy(s, 1, 64))));
  WriteLn('blake2b sizes: [', Length(Blake2b('x', 1, '')), ' ', Length(Blake2b('x', 64, '')), ' ',
    Length(Blake2b('x', 0, '')), ' ', Length(Blake2b('x', 65, '')), ' ', Length(Blake2b('x', 32, Bytes('k', 65))), ']');

  pw := Bytes(#1, 32);
  salt := Bytes(#2, 16);
  secret := Bytes(#3, 8);
  ad := Bytes(#4, 12);
  WriteLn('argon2id kat: ', Hex(Argon2Raw(Argon2id, pw, salt, secret, ad, 3, 32, 4, 32)));
  WriteLn('argon2i kat:  ', Hex(Argon2Raw(Argon2i, pw, salt, secret, ad, 3, 32, 4, 32)));
  WriteLn('argon2d kat:  ', Hex(Argon2Raw(Argon2d, pw, salt, secret, ad, 3, 32, 4, 32)));
  { a tag longer than 64 bytes goes through the chained H' }
  WriteLn('argon2id 100-byte tag: ', Hex(Argon2idKey('password', 'somesalt', 1, 64, 1, 100)));
  WriteLn('argon2id one lane: ', Hex(Argon2idKey('password', 'somesalt', 2, 64, 1, 32)));

  WriteLn('refused: [', Argon2idKey('p', 'short', 3, 32, 4, 32), '] [', Argon2idKey('p', 'somesalt', 0, 32, 4, 32),
    '] [', Argon2idKey('p', 'somesalt', 3, 7, 1, 32), '] [', Argon2idKey('p', 'somesalt', 3, 32, 0, 32), '] [',
    Argon2idKey('p', 'somesalt', 3, 32, 4, 3), '] [', Argon2Raw(3, 'p', 'somesalt', '', '', 3, 32, 4, 32), ']');

  WriteLn('base64: ', Base64NoPad(''), '|', Base64NoPad('f'), '|', Base64NoPad('fo'), '|', Base64NoPad('foo'), '|',
    Base64NoPad('foob'), '|', Base64NoPad('fooba'), '|', Base64NoPad('foobar'));
  for s in ['', 'Zg', 'Zm8', 'Zm9v', 'Zm9vYg', 'Zm9vYmE', 'Zm9vYmFy', 'Zg=', 'Z', 'Zh', 'Zm9!'] do
  begin
    if Base64NoPadDecode(s, r) then
      Write('[', r, '] ')
    else
      Write('(no) ');
  end;
  WriteLn;

  phc := Argon2idHashWith('correct horse', 'saltsaltsaltsalt', 2, 64, 2, 32);
  WriteLn('phc: ', phc);
  WriteLn('parse: ', Argon2idParse(phc, t, m, p, salt, tag), ' t=', t, ' m=', m, ' p=', p, ' salt=', salt, ' tag ',
    Length(tag), ' bytes');
  WriteLn('verify right: ', Argon2idVerify('correct horse', phc));
  WriteLn('verify wrong: ', Argon2idVerify('correct horse ', phc));
  s := phc;
  if s[Length(s)] = 'A' then
    s[Length(s)] := 'B'
  else
    s[Length(s)] := 'A';
  WriteLn('verify a changed tag: ', Argon2idVerify('correct horse', s));
  for s in ['', '$argon2i$v=19$m=64,t=2,p=2$c2FsdHNhbHRzYWx0c2FsdA$AAAA', '$argon2id$v=16$m=64,t=2,p=2$c2FsdHNhbHRzYWx0c2FsdA$AAAA',
    '$argon2id$v=19$m=64,p=2,t=2$c2FsdHNhbHRzYWx0c2FsdA$AAAA', '$argon2id$v=19$m=64,t=2,p=2$c2FsdA$AAAA',
    '$argon2id$v=19$m=64,t=2,p=2$c2FsdHNhbHRzYWx0c2FsdA$AA=', '$argon2id$v=19$m=64,t=2,p=2$c2FsdHNhbHRzYWx0c2FsdA$AAAA$x',
    '$argon2id$v=19$m=64,t=2,p=2$c2FsdHNhbHRzYWx0c2FsdA', 'argon2id$v=19$m=64,t=2,p=2$c2FsdHNhbHRzYWx0c2FsdA$AAAA'] do
    Write(Argon2idParse(s, t, m, p, salt, tag), ' ');
  WriteLn;
  { the default parameters: 64 MiB, 3 passes, 4 lanes, a random salt of
    16 bytes, a tag of 32; two hashes of one password differ by salt and
    both verify }
  phc := Argon2idHash('pw');
  s := Argon2idHash('pw');
  WriteLn('default: ', Copy(phc, 1, 30), ' salt ', Length(phc) - 31 - 43 - 1 = 22, ' two differ ', phc <> s,
    ' both verify ', Argon2idVerify('pw', phc) and Argon2idVerify('pw', s));
end.

