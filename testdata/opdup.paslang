{ P157: a program's operator on the same types given twice: refused,
  where the assembler saw its symbol twice. }
program opdup;

type
  TV = record
    X: Integer;
  end;

operator + (A, B: TV): TV;
begin
  Result.X := A.X + B.X;
end;

operator + (A, B: TV): TV;
begin
  Result.X := A.X - B.X;
end;

begin
end.

