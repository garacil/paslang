{ P390: a comparison whose sides are deeper than the register pool, as a
  condition, is one compare and one branch: no Boolean made and tested.
  Every relation, against a constant and against a variable, of words
  and of bytes, in loops that keep their variables in registers (whose
  pool a region lends down to two or three registers) and out of them,
  in if, while, repeat, and, or and not. scripts/check_cmpdeep.py reads
  the assembly of the routines Deep* on both machines: no set or cset. }
program cmpdeep;

const
  Tab: array[0..15] of Byte = (3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 7, 9, 3);

var
  w: array of Integer;
  b: array of Byte;
  i, total: Integer;

{ an or and a sum of four table loads through computed indexes, in a loop }
function DeepLoop(const t: array of Byte; k, lim: Integer): Integer;
var
  j: Integer;
begin
  Result := 0;
  for j := 0 to k do
  begin
    if (Tab[t[j] and 15] or Tab[t[j + 1] and 15] or Tab[t[j + 2] and 15] or Tab[t[j + 3] and 15]) > 7 then
      Result := Result + 1;
    if (Tab[t[j] and 15] + Tab[t[j + 1] and 15] + Tab[t[j + 2] and 15] + Tab[t[j + 3] and 15]) = lim then
      Result := Result + 10;
    if (Tab[t[j] and 15] xor Tab[t[j + 2] and 15] xor Tab[t[j + 1] and 15]) <> 0 then
      Result := Result + 100;
    if (Integer(Tab[t[j] and 15]) * Tab[t[j + 3] and 15] - Integer(Tab[t[j + 1] and 15]) * Tab[t[j + 2] and 15]) < -10 then
      Result := Result + 1000;
    if lim <= (Tab[t[j] and 15] + Tab[t[j + 1] and 15] + Tab[t[j + 2] and 15] + Tab[t[j + 3] and 15]) then
      Result := Result + 10000;
    if (Tab[t[j] and 15] + Tab[t[j + 1] and 15]) >= (Tab[t[j + 2] and 15] + Tab[t[j + 3] and 15]) then
      Result := Result + 100000;
  end;
end;

{ right-nested words deeper than the pool outside a loop, every relation
  against a variable and a constant }
function DeepFlat(const v: array of Integer; o, x: Integer): Integer;
begin
  Result := 0;
  if (v[o] + (v[o + 1] + (v[o + 2] + (v[o + 3] + (v[o + 4] + (v[o + 5] + (v[o + 6] + v[o + 7]))))))) = x then
    Result := Result + 1;
  if (v[o] - (v[o + 1] - (v[o + 2] - (v[o + 3] - (v[o + 4] - (v[o + 5] - (v[o + 6] - v[o + 7]))))))) <> x then
    Result := Result + 2;
  if (v[o] xor (v[o + 1] or (v[o + 2] and (v[o + 3] + (v[o + 4] xor (v[o + 5] - (v[o + 6] + v[o + 7]))))))) < x then
    Result := Result + 4;
  if (v[o] + (v[o + 1] * (v[o + 2] + (v[o + 3] * (v[o + 4] + (v[o + 5] * (v[o + 6] + v[o + 7]))))))) <= 5000 then
    Result := Result + 8;
  if (v[o + 7] - (v[o + 6] - (v[o + 5] - (v[o + 4] - (v[o + 3] - (v[o + 2] - (v[o + 1] - v[o]))))))) > -3 then
    Result := Result + 16;
  if (v[o] + (v[o + 1] + (v[o + 2] + (v[o + 3] + (v[o + 4] + (v[o + 5] + (v[o + 6] + v[o + 7]))))))) >= x + 1 then
    Result := Result + 32;
end;

{ in while, repeat, not, and and or }
function DeepLoops(const t: array of Byte; k: Integer): Integer;
var
  j, n: Integer;
begin
  Result := 0;
  j := 0;
  while (j <= k) and ((Tab[t[j] and 15] or Tab[t[j + 1] and 15] or Tab[t[j + 2] and 15]) < 15) do
  begin
    Result := Result + 1;
    j := j + 1;
  end;
  n := 0;
  repeat
    n := n + 1;
    Result := Result + 3;
  until (n > k) or ((Tab[t[n] and 15] + Tab[t[n + 1] and 15] + Tab[t[n + 2] and 15] + Tab[t[n + 3] and 15]) > 24);
  for j := 0 to k do
    if not ((Tab[t[j] and 15] or Tab[t[j + 1] and 15] or Tab[t[j + 2] and 15] or Tab[t[j + 3] and 15]) = 15) then
      Result := Result + 7;
end;

begin
  SetLength(w, 64);
  SetLength(b, 64);
  for i := 0 to 63 do
  begin
    w[i] := (i * 37 + 11) mod 23 - 9;
    b[i] := Byte((i * 53 + 7) mod 251);
  end;
  total := 0;
  for i := 0 to 59 do
    total := total + DeepLoop(b, i, 14 + i mod 7);
  WriteLn('loop ', total, ' ', DeepLoop(b, 59, 16));
  for i := -40 to 40 do
    total := total + DeepFlat(w, (i + 40) mod 50, i) * (i + 41);
  WriteLn('flat ', total, ' ', DeepFlat(w, 3, 2), ' ', DeepFlat(w, 10, -7));
  for i := 0 to 59 do
    total := total + DeepLoops(b, i);
  WriteLn('loops ', total, ' ', DeepLoops(b, 59));
end.
