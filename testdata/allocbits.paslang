{ 1.0.68: a swept span with every other slot free hands its slots out
  from a bitmap in the mcache entry (Go's allocCache), in rt_alloc, not
  through pasheap. Spans of several classes (strings, records with
  pointers, records without, small ones) are made half garbage and
  collected; what is made next goes into the holes. Every slot handed
  out must start cleared, none may be handed out twice or while still
  taken, and everything kept must read back as it was written, after
  more cycles. }
program allocbits;

uses
  paslib;

type
  PRec = ^TRec;
  TRec = record
    A: Integer;
    P: PRec;
    S: string;
  end;
  PBig = ^TBig;
  TBig = record
    W: array[0..9] of Integer;
    Q: PBig;
  end;
  PSmall = ^TSmall;
  TSmall = record
    V: Integer;
  end;

var
  keepS, dropS: array of string;
  keepR: array of PRec;
  keepB: array of PBig;
  keepT: array of PSmall;
  newS: array of string;
  newR: array of PRec;
  newB: array of PBig;
  newT: array of PSmall;
  r, d: PRec;
  b, db: PBig;
  t, dt: PSmall;
  i, j, n, bad, dirty, c0, rnd: Integer;

function Name(K, Rnd: Integer): string;
begin
  Result := 'r' + IntToStr(Rnd) + '-' + IntToStr(K) + Copy('abcdefghijklmnopqrstuvwxyz', 1, K mod 27);
end;

begin
  n := 40000;
  SetLength(keepS, n);
  SetLength(dropS, n);
  SetLength(keepR, n);
  SetLength(keepB, n);
  SetLength(keepT, n);
  { one kept, one dropped, in the same spans }
  for i := 0 to n - 1 do
  begin
    keepS[i] := Name(i, 0);
    dropS[i] := Name(i, 99);
    New(r);
    r^.A := i;
    r^.S := Name(i, 1);
    keepR[i] := r;
    New(d);
    d^.A := -1;
    d^.P := d;
    d^.S := 'garbage';
    New(b);
    for j := 0 to 9 do
      b^.W[j] := i * 10 + j;
    keepB[i] := b;
    New(db);
    for j := 0 to 9 do
      db^.W[j] := -7;
    db^.Q := db;
    New(t);
    t^.V := i;
    keepT[i] := t;
    New(dt);
    dt^.V := -9;
  end;
  SetLength(dropS, 0);
  c0 := HeapStat(0);
  GcCollect;
  GcCollect;
  { into the holes }
  SetLength(newS, n);
  SetLength(newR, n);
  SetLength(newB, n);
  SetLength(newT, n);
  dirty := 0;
  for rnd := 1 to 3 do
    for i := 0 to n - 1 do
    begin
      newS[i] := Name(i, 10 + rnd);
      New(r);
      if (r^.A <> 0) or (r^.P <> nil) or (r^.S <> '') then
        dirty := dirty + 1;
      r^.A := i + rnd;
      r^.P := keepR[i];
      r^.S := Name(i, 20 + rnd);
      newR[i] := r;
      New(b);
      for j := 0 to 9 do
        if b^.W[j] <> 0 then
          dirty := dirty + 1;
      if b^.Q <> nil then
        dirty := dirty + 1;
      for j := 0 to 9 do
        b^.W[j] := i * 100 + j + rnd;
      b^.Q := keepB[i];
      newB[i] := b;
      New(t);
      if t^.V <> 0 then
        dirty := dirty + 1;
      t^.V := i * 3 + rnd;
      newT[i] := t;
      if i mod 5000 = 0 then
        GcCollect;
    end;
  GcCollect;
  bad := 0;
  for i := 0 to n - 1 do
  begin
    if keepS[i] <> Name(i, 0) then
      bad := bad + 1;
    if (keepR[i]^.A <> i) or (keepR[i]^.S <> Name(i, 1)) or (keepR[i]^.P <> nil) then
      bad := bad + 1;
    for j := 0 to 9 do
      if keepB[i]^.W[j] <> i * 10 + j then
        bad := bad + 1;
    if keepT[i]^.V <> i then
      bad := bad + 1;
    if newS[i] <> Name(i, 13) then
      bad := bad + 1;
    if (newR[i]^.A <> i + 3) or (newR[i]^.S <> Name(i, 23)) or (newR[i]^.P <> keepR[i]) then
      bad := bad + 1;
    for j := 0 to 9 do
      if newB[i]^.W[j] <> i * 100 + j + 3 then
        bad := bad + 1;
    if newB[i]^.Q <> keepB[i] then
      bad := bad + 1;
    if newT[i]^.V <> i * 3 + 3 then
      bad := bad + 1;
  end;
  WriteLn('kept ', n, ' bad ', bad, ' dirty ', dirty);
  WriteLn('cycles ', HeapStat(0) > c0 + 10, ' alive under 32 MiB ', HeapStat(1) < 33554432);
  WriteLn('check ', HeapCheck);
end.
