program typeargdirectives;
type TOuter = record
  type TSmall = Byte;
    TMedium = Word;
end;
{$CPU base}
const CpuSize = SizeOf(TOuter
  {$IFDEF CPUAARCH64}{$CPU v8.2+crypto}{$ELSE}{$CPU v3}{$ENDIF}
  .TSmall);
{$IFDEF CPUAARCH64}
  {$IFNDEF CPU_AES}{$FATAL expected AES after ARM CPU directive}{$ENDIF}
{$ELSE}
  {$IFNDEF CPU_AVX2}{$FATAL expected AVX2 after AMD CPU directive}{$ENDIF}
{$ENDIF}
{$CPU DEFAULT}
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('type directive ', Stage, ': ', Actual, ' <> ', Expected); Halt(106); end;
end;
begin
  Equal(1, SizeOf(TOuter { qualified comment }. TSmall), 1);
  Equal(2, SizeOf(TOuter {$IF PASLANG_FULLVERSION >= 1000000}.TSmall{$ELSE}.TMedium{$ENDIF}), 1);
  {$DEFINE TYPEARG_ARMED}
  Equal(3, SizeOf(Char {$IFDEF TYPEARG_ARMED}{$UNDEF TYPEARG_ARMED}('A'){$ELSE}(256){$ENDIF}), 1);
  {$IFDEF TYPEARG_ARMED}{$FATAL real lexer must consume the undef}{$ENDIF}
  Equal(4, Ord(High(TOuter {$DEFINE TYPEARG_SEEN}.TSmall(7))), 255);
  {$IFNDEF TYPEARG_SEEN}{$FATAL real lexer must consume the define}{$ENDIF}
  Equal(5, Ord(Low(TOuter {$IF PASLANG_VERSION = 1}.TSmall(7){$ELSE}.TMedium(7){$ENDIF})), 0);
  Equal(6, CpuSize, 1);
  Equal(7, SizeOf(TOuter
    // qualification crosses a line comment
    .TMedium), 2);
  Equal(8, SizeOf(TOuter {$IF defined(TYPEARG_SEEN) and (PASLANG_RELEASE >= 0)}.TSmall{$ELSE}.TMedium{$ENDIF}(7)), 1);
  WriteLn('ok isolated type argument lookahead');
end.
