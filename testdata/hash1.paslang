{ P111: the hash words against the exact model in scripts/hashmodel.py
  (Python's hashlib, zlib and the reference definitions), which writes
  hash1.out: the standards' vectors, every length from 0 to 300 bytes
  folded into one line per word (each block boundary of 64, 128 and
  136 bytes, and the PCLMULQDQ path from 64 bytes), long messages, and
  a CRC or Adler-32 that goes on from a value. make check runs it on
  both machines and again compiled with -cpu base, so the Pascal
  rounds and the processor's give the same bytes. }
program hash1;

var
  s, key, msg, acc: string;
  i, n: Integer;
  lens: array[0..15] of Integer;

function Pattern(N: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, N);
  for i := 1 to N do
    Result[i] := Char((i * 7 + 3) and 255);
end;

procedure Fold(const Digest: string);
begin
  acc := Sha256(acc + Digest);
end;

begin
  WriteLn(Hex(''), Hex('paslang'), ' ', Hex(#0#255#16));
  s := 'abc';
  WriteLn(Hex(Md5('')), ' ', Hex(Md5(s)));
  WriteLn(Hex(Sha1('')), ' ', Hex(Sha1(s)));
  WriteLn(Hex(Sha224('')), ' ', Hex(Sha224(s)));
  WriteLn(Hex(Sha256('')), ' ', Hex(Sha256(s)));
  WriteLn(Hex(Sha384('')), ' ', Hex(Sha384(s)));
  WriteLn(Hex(Sha512('')), ' ', Hex(Sha512(s)));
  WriteLn(Hex(Sha3_224('')), ' ', Hex(Sha3_224(s)));
  WriteLn(Hex(Sha3_256('')), ' ', Hex(Sha3_256(s)));
  WriteLn(Hex(Sha3_384('')), ' ', Hex(Sha3_384(s)));
  WriteLn(Hex(Sha3_512('')), ' ', Hex(Sha3_512(s)));
  { FIPS 180-4's two-block message }
  s := 'abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq';
  WriteLn(Hex(Sha256(s)), ' ', Hex(Sha1(s)));
  s := 'The quick brown fox jumps over the lazy dog';
  WriteLn(Crc32(s), ' ', Crc32c(s), ' ', Adler32(s), ' ', Fnv1a32(s), ' ', Fnv1a64(s), ' ', Murmur3(s), ' ', Murmur3(s, 42));
  { RFC 4231 test case 2 }
  key := 'Jefe';
  msg := 'what do ya want for nothing?';
  WriteLn(Hex(HmacSha256(key, msg)));
  WriteLn(Hex(HmacSha224(key, msg)));
  WriteLn(Hex(HmacSha384(key, msg)));
  WriteLn(Hex(HmacSha512(key, msg)));
  WriteLn(Hex(HmacSha1(key, msg)), ' ', Hex(HmacMd5(key, msg)));
  { RFC 4231 test case 6: a key longer than the block }
  SetLength(key, 131);
  for i := 1 to 131 do
    key[i] := Char($aa);
  WriteLn(Hex(HmacSha256(key, 'Test Using Larger Than Block-Size Key - Hash Key First')));
  WriteLn(Hex(HmacSha512(key, 'Test Using Larger Than Block-Size Key - Hash Key First')));
  { the SipHash paper's vector: the key 00..0f, the message 00..0e }
  SetLength(msg, 15);
  for i := 1 to 15 do
    msg[i] := Char(i - 1);
  WriteLn(SipHash(msg, $0706050403020100, $0f0e0d0c0b0a0908), ' ', SipHash('', 0, 0));
  { every length from 0 to 300, one line per word }
  acc := '';
  for i := 0 to 300 do
    Fold(Md5(Pattern(i)));
  WriteLn('md5 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(Sha1(Pattern(i)));
  WriteLn('sha1 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(Sha224(Pattern(i)));
  WriteLn('sha224 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(Sha256(Pattern(i)));
  WriteLn('sha256 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(Sha384(Pattern(i)));
  WriteLn('sha384 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(Sha512(Pattern(i)));
  WriteLn('sha512 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(Sha3_256(Pattern(i)));
  WriteLn('sha3_256 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(Sha3_512(Pattern(i)));
  WriteLn('sha3_512 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(Sha3_224(Pattern(i)) + Sha3_384(Pattern(i)));
  WriteLn('sha3_224_384 ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(PasFmtInt(Crc32(Pattern(i)), 0) + ' ' + PasFmtInt(Crc32c(Pattern(i)), 0) + ' ' +
      PasFmtInt(Adler32(Pattern(i)), 0));
  WriteLn('crc ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(PasFmtInt(Fnv1a32(Pattern(i)), 0) + ' ' + PasFmtInt(Fnv1a64(Pattern(i)), 0) + ' ' +
      PasFmtInt(Murmur3(Pattern(i), i), 0) + ' ' + PasFmtInt(SipHash(Pattern(i), i, -i), 0));
  WriteLn('fnv_murmur_sip ', Hex(acc));
  acc := '';
  for i := 0 to 300 do
    Fold(HmacSha256(Pattern(i), Pattern(300 - i)) + HmacMd5(Pattern(i), Pattern(i)));
  WriteLn('hmac ', Hex(acc));
  { long messages: the block loops many times over }
  lens[0] := 63; lens[1] := 64; lens[2] := 65; lens[3] := 127; lens[4] := 128; lens[5] := 129;
  lens[6] := 191; lens[7] := 192; lens[8] := 193; lens[9] := 255; lens[10] := 256; lens[11] := 257;
  lens[12] := 1000; lens[13] := 4096; lens[14] := 4097; lens[15] := 100000;
  for n := 0 to 15 do
  begin
    s := Pattern(lens[n]);
    WriteLn(lens[n], ' ', Hex(Sha256(s)), ' ', Hex(Sha512(s)), ' ', Crc32(s), ' ', Crc32c(s));
    WriteLn(Hex(Sha1(s)), ' ', Hex(Md5(s)), ' ', Hex(Sha3_256(s)), ' ', Adler32(s));
  end;
  { going on from a value }
  s := Pattern(1000);
  WriteLn(Crc32(s) = Crc32(Copy(s, 301, 700), Crc32(Copy(s, 1, 300))), ' ',
    Crc32c(s) = Crc32c(Copy(s, 301, 700), Crc32c(Copy(s, 1, 300))), ' ',
    Adler32(s) = Adler32(Copy(s, 301, 700), Adler32(Copy(s, 1, 300))));
end.

