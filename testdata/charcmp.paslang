{ A string compared with a Char, a literal or a variable, compares as
  with the one-byte string (1.1.1: the string's pointer was compared
  with the character's code, so s = #0 was never True and s = c never
  for any c). Every operator, both sides, NUL bytes included. }
program charcmp;

var
  s: string;
  c: Char;
begin
  s := #0;
  c := #0;
  WriteLn(s = #0, ' ', s = c, ' ', #0 = s, ' ', c = s, ' ', s <> #0, ' ', s = Chr(0), ' ', Length(s));
  s := 'a';
  c := 'a';
  WriteLn(s = 'a', ' ', s = c, ' ', s <> c, ' ', s < 'b', ' ', 'b' > s, ' ', s <= c, ' ', s >= #97, ' ', s = #98);
  s := 'ab';
  WriteLn(s = c, ' ', s > c, ' ', c < s, ' ', s = 'a' + #0);
  s := 'a' + #0;
  WriteLn(s = 'a' + #0, ' ', s = c, ' ', Length(s), ' ', s > c);
  s := '';
  WriteLn(s = #0, ' ', s < #0, ' ', #0 > s);
end.

