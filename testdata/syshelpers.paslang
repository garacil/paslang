program syshelpers;
uses sysutils;
const Workers = 128;
var done: waitgroup; i: Integer;

procedure Check(Index: Integer);
var text, trimmed: string; parts: TStringArray; settings: TFormatSettings;
  k, number, bad, bits: Integer; realValue: Double; truth: Boolean; value: Char;
begin
  settings := DefaultFormatSettings;
  if Odd(Index) then settings.DecimalSeparator := ',';
  text := 'ñ::雪::::😀::';
  for k := 1 to 32 do
  begin
    parts := text.SplitText('::');
    if (Length(parts) <> 5) or (parts[0] <> 'ñ') or (parts[1] <> '雪') or
      (parts[2] <> '') or (parts[3] <> '😀') or (parts[4] <> '') then Halt(2);
    if string.JoinText('::', parts) <> text then Halt(3);
    parts := text.SplitText('::', 2);
    if (Length(parts) <> 2) or (parts[1] <> '雪::::😀::') then Halt(4);
    parts := text.SplitText('::', 0);
    if Length(parts) <> 0 then Halt(5);
    if (text.ByteLength <> Length(text)) or (text.Chars[0] <> #195) then Halt(6);
    if not text.StartsWith('ñ') or not text.EndsWith('::') or not text.HasText('😀') then Halt(7);
    if (text.IndexOf('雪') <> 4) or (text.IndexOf('absent') <> -1) or
      (text.IndexOf('', text.ByteLength) <> text.ByteLength) then Halt(8);
    if text.Substring(4, 3) <> '雪' then Halt(9);
    trimmed := '  abc  ';
    if (trimmed.Trim <> 'abc') or (trimmed.Remove(0, 2).Trim <> 'abc') then Halt(10);
    if text.InsertText(0, '!').Remove(0, 1) <> text then Halt(11);
    if text.Replace('::', '/') <> 'ñ/雪//😀/' then Halt(12);
    try trimmed := text.Substring(High(Integer), 2); Halt(13)
    except on EArgumentOutOfRangeException do ; end;
    try bad := Ord(text.Chars[text.ByteLength]); Halt(14)
    except on EArgumentOutOfRangeException do ; end;
    try parts := text.SplitText(''); Halt(15)
    except on EArgumentException do ; end;
    try parts := text.SplitText('::', -2); Halt(16)
    except on EArgumentOutOfRangeException do ; end;
    number := Integer.Parse('-9223372036854775808');
    if (number <> Low(Integer)) or (number.ToString <> '-9223372036854775808') or
      (number.ToHexString <> '8000000000000000') then Halt(17);
    if Integer.TryParse('9223372036854775808', number) then Halt(18);
    number := Index;
    if (number.ToBoolean <> (Index <> 0)) or (number.ToDouble <> Double(Index)) then Halt(19);
    if Odd(Index) then trimmed := '1,25' else trimmed := '1.25';
    realValue := Double.Parse(trimmed, settings);
    if (realValue <> 1.25) or (realValue.ToString(settings) <> trimmed) or
      not realValue.IsFinite or realValue.IsNotANumber or realValue.IsInfinity then Halt(20);
    if not Double.TryParse(trimmed, realValue, settings) then Halt(21);
    bits := 9221120237041090561; Move(bits, realValue, 8);
    if not realValue.IsNotANumber or realValue.IsInfinity or realValue.IsFinite then Halt(31);
    bits := 9218868437227405312; Move(bits, realValue, 8);
    if realValue.IsNotANumber or not realValue.IsInfinity or realValue.IsFinite then Halt(32);
    bits := -4503599627370496; Move(bits, realValue, 8);
    if realValue.IsNotANumber or not realValue.IsInfinity or realValue.IsFinite then Halt(33);
    truth := Boolean.Parse('true');
    if (not truth) or (truth.ToString <> 'True') or (truth.ToInteger <> 1) then Halt(22);
    if not Boolean.TryParse('false', truth) or truth then Halt(23);
    if (truth.ToString <> 'False') or (truth.ToString(False) <> '0') then Halt(24);
    if (Length(TrueBoolStrs) <> 0) or (Length(FalseBoolStrs) <> 0) then Halt(25);
    if k = 1 then for bad := 0 to 255 do
    begin
      value := Chr(bad);
      if value.IsAsciiDigit <> ((bad >= 48) and (bad <= 57)) then Halt(26);
      if value.IsAsciiLetter <> (((bad >= 65) and (bad <= 90)) or
        ((bad >= 97) and (bad <= 122))) then Halt(27);
      if value.IsAsciiWhiteSpace <> ((bad = 32) or ((bad >= 9) and (bad <= 13))) then Halt(28);
      if value.ToString <> string(value) then Halt(29);
      if value.ToUpper <> UpCase(value) then Halt(30);
    end;
    if (k mod 8) = 0 then GcCollect;
  end;
  done.Done;
end;

procedure CustomTables;
var truth: Boolean;
begin
  if BoolToStr(True, True) <> 'yes' then Halt(34);
  if BoolToStr(False, True) <> 'no' then Halt(35);
  if not TryStrToBool('ON', truth) or not truth then Halt(36);
  if not TryStrToBool('OFF', truth) or truth then Halt(37);
  if TryStrToBool('true', truth) or truth then Halt(38);
  if not TryStrToBool('12', truth) or not truth then Halt(39);
  if TryStrToBool('not a boolean', truth) or truth then Halt(40);
  done.Done;
end;
begin
  done.Add(Workers);
  for i := 0 to Workers - 1 do pas Check(i);
  done.Wait;
  TrueBoolStrs := ['yes', 'on']; FalseBoolStrs := ['no', 'off'];
  done.Add(Workers);
  for i := 0 to Workers - 1 do pas CustomTables;
  done.Wait;
  WriteLn('checked UTF-8 byte helpers, ASCII classification, independent settings and pure boolean defaults 128');
end.
