program fpconstant;
type TS = Single; TD = Double;
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('FP constant ', Stage, ': ', Actual, ' <> ', Expected); Halt(91); end;
end;
function SBits(X: Single): Integer;
begin Result := X as UInt32; end;
function DBits(X: Double): Integer;
begin Result := X as Integer; end;
function OneS: TS;
begin Result := $3F800000 as Single; end;
function OneD: TD;
begin Result := $3FF0000000000000 as Double; end;
function ZeroS: Single;
begin Result := $0 as Single; end;
function ZeroD: Double;
begin Result := $0 as Double; end;
function NegZeroS: Single;
begin Result := $80000000 as Single; end;
function NegZeroD: Double;
begin Result := $8000000000000000 as Double; end;
function LiteralS: Single;
begin Result := 1.0; end;
function LiteralD: Double;
begin Result := 1.0; end;
function EchoS(X: Single): Single;
begin Result := X; end;
function EchoD(X: Double): Double;
begin Result := X; end;
function NumericS(X: Single): Double;
begin Result := X; end;
var S: Single; D: Double; Flag: Boolean; N: Integer;
begin
  { Arithmetic on real values differs from arithmetic on their encoded bits. }
  S := ($3F800000 as Single) + ($3F800000 as Single); Equal(1, SBits(S), $40000000);
  D := ($3FF0000000000000 as Double) + ($3FF0000000000000 as Double); Equal(2, DBits(D), $4000000000000000);
  S := ($40400000 as Single) - ($40000000 as Single); Equal(3, SBits(S), $3F800000);
  D := ($4008000000000000 as Double) - ($4000000000000000 as Double); Equal(4, DBits(D), $3FF0000000000000);
  S := ($40000000 as Single) * ($40400000 as Single); Equal(5, SBits(S), $40C00000);
  D := ($4000000000000000 as Double) * ($4008000000000000 as Double); Equal(6, DBits(D), $4018000000000000);
  S := ($40400000 as Single) / ($40000000 as Single); Equal(7, SBits(S), $3FC00000);
  D := ($4008000000000000 as Double) / ($4000000000000000 as Double); Equal(8, DBits(D), $3FF8000000000000);
  S := ($3F800000 + $3F800000) as Single; Equal(9, SBits(S), $7F000000);
  D := ($3FF0000000000000 + $3FF0000000000000) as Double; Equal(10, DBits(D), $7FE0000000000000);

  S := -($3F800000 as Single); Equal(11, SBits(S), $BF800000);
  D := -($3FF0000000000000 as Double); Equal(12, DBits(D), $BFF0000000000000);
  S := -($0 as Single); Equal(13, SBits(S), $80000000);
  D := -($0 as Double); Equal(14, DBits(D), $8000000000000000);
  S := -($80000000 as Single); Equal(15, SBits(S), 0);
  D := -($8000000000000000 as Double); Equal(16, DBits(D), 0);
  S := -($1 as Single); Equal(17, SBits(S), $80000001);
  D := -($1 as Double); Equal(18, DBits(D), $8000000000000001);

  Flag := ($80000000 as Single) = ($0 as Single); Equal(20, Ord(Flag), 1);
  Flag := ($8000000000000000 as Double) = ($0 as Double); Equal(21, Ord(Flag), 1);
  Flag := ($80000000 as Single) <> ($0 as Single); Equal(22, Ord(Flag), 0);
  Flag := ($8000000000000000 as Double) <> ($0 as Double); Equal(23, Ord(Flag), 0);
  Flag := ($C0000000 as Single) < ($BF800000 as Single); Equal(24, Ord(Flag), 1);
  Flag := ($C000000000000000 as Double) <= ($BFF0000000000000 as Double); Equal(25, Ord(Flag), 1);
  Flag := ($BF800000 as Single) > ($C0000000 as Single); Equal(26, Ord(Flag), 1);
  Flag := ($BFF0000000000000 as Double) >= ($C000000000000000 as Double); Equal(27, Ord(Flag), 1);
  { Quiet NaN comparisons test classification, never a resulting payload. }
  Flag := ($7FC00001 as Single) = ($7FC00001 as Single); Equal(28, Ord(Flag), 0);
  Flag := ($7FF8000000000001 as Double) <> ($7FF8000000000001 as Double); Equal(29, Ord(Flag), 1);

  S := OneS; Equal(30, SBits(S), $3F800000);
  D := OneD; Equal(31, DBits(D), $3FF0000000000000);
  S := EchoS(OneS); Equal(32, SBits(S), $3F800000);
  D := EchoD(OneD); Equal(33, DBits(D), $3FF0000000000000);
  S := ZeroS; Equal(34, SBits(S), 0);
  D := ZeroD; Equal(35, DBits(D), 0);
  S := EchoS(ZeroS); Equal(36, SBits(S), 0);
  D := EchoD(ZeroD); Equal(37, DBits(D), 0);
  S := NegZeroS; Equal(38, SBits(S), $80000000);
  D := NegZeroD; Equal(39, DBits(D), $8000000000000000);
  S := EchoS(NegZeroS); Equal(40, SBits(S), $80000000);
  D := EchoD(NegZeroD); Equal(41, DBits(D), $8000000000000000);
  D := OneS; Equal(42, DBits(D), $3FF0000000000000);
  S := Single(OneD); Equal(43, SBits(S), $3F800000);
  D := Double(NegZeroS); Equal(44, DBits(D), $8000000000000000);
  S := Single(NegZeroD); Equal(45, SBits(S), $80000000);
  S := LiteralS; Equal(46, SBits(S), $3F800000);
  D := LiteralD; Equal(47, DBits(D), $3FF0000000000000);
  S := OneS + ZeroS; Equal(48, SBits(S), $3F800000);
  D := OneD + ZeroD; Equal(49, DBits(D), $3FF0000000000000);
  D := NumericS(16777217); Equal(50, DBits(D), $4170000000000000);
  D := NumericS(16777216 + 1); Equal(51, DBits(D), $4170000000000000);
  N := 16777217; D := NumericS(N); Equal(52, DBits(D), $4170000000000000);
  WriteLn('ok typed FP constants');
end.
