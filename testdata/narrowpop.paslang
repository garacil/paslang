{ Heaps and trees of narrow elements (1.1.1). An element is kept in an
  8-byte slot; Pop and PopLow/PopHigh copied the whole slot into the
  variable they were given, so a Byte or a Single field took the fields
  after it with it. And a heap of Single compared the bits of a Double,
  so a negative one came out after the positives. Each record here has
  a sentinel beside the field a pop writes. }
program narrowpop;

type
  TB = record
    before: Byte;
    x: Byte;
    after: Byte;
    tail: Integer;
  end;
  TS = record
    x: Single;
    y: Single;
    tail: Integer;
  end;
  TI = record
    x: Int8;
    y: Int16;
    z: Int32;
    tail: Integer;
  end;

var
  hb: heap of Byte;
  hs: heap of Single;
  hi: heap of Int8;
  tbt: tree[Byte] of Byte;
  b: TB;
  s: TS;
  r: TI;

begin
  New(hb);
  Push(hb, 200);
  Push(hb, 7);
  b.before := 11;
  b.after := 22;
  b.tail := 333;
  while Pop(hb, b.x) do
    WriteLn('byte ', b.x, ' kept ', b.before, ' ', b.after, ' ', b.tail);

  New(hs);
  Push(hs, Single(3.5));
  Push(hs, Single(-1.25));
  Push(hs, Single(2.0));
  Push(hs, Single(-7.0));
  s.y := 9.0;
  s.tail := 444;
  while Pop(hs, s.x) do
    WriteLn('single ', s.x:0:2, ' kept ', s.y:0:1, ' ', s.tail);

  New(hi);
  Push(hi, -100);
  Push(hi, 50);
  Push(hi, -3);
  r.y := 12345;
  r.z := -7;
  r.tail := 555;
  while Pop(hi, r.x) do
    WriteLn('int8 ', r.x, ' kept ', r.y, ' ', r.z, ' ', r.tail);

  New(tbt);
  tbt[9] := 90;
  tbt[4] := 40;
  b.before := 1;
  b.after := 2;
  b.tail := 3;
  while PopLow(tbt, b.x, b.before) do
    WriteLn('tree byte key ', b.x, ' value ', b.before, ' kept ', b.after, ' ', b.tail);
end.

