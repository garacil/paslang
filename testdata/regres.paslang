{ P366: a block of one to three words comes back in registers, rax, rdx
  and r8 (x0, x2, x3), and a Result read and written field by field is
  words in registers or in the frame: one, two and three words; a
  method, whose Self comes in a register a word goes back in; words read
  before they are written; writes in branches and loops; a word worked
  out by a call; a string field and narrow fields, which come back in
  registers as the record lies in memory; a static array of three
  words; words that change places, a cycle of moves; the values stored
  where the caller's assignment goes, into a field, an element, an
  argument and a with. }
program regres;

type
  TOne = record
    V: Integer;
  end;
  TPair = record
    A, B: Integer;
  end;
  TTri = record
    X, Y, Z: Integer;
  end;
  TNamed = record
    Name: string;
    N: Integer;
  end;
  TPacked = record
    B1, B2: Byte;
    W: Word;
    L: LongInt;
    Q: Integer;
  end;
  TReal = record
    R: Double;
    K: Integer;
  end;
  TArr3 = array[0..2] of Integer;

  TCounter = class
    Base: Integer;
    function Pair(N: Integer): TPair;
    function Tri: TTri;
  end;

var
  one: TOne;
  p, q: TPair;
  t: TTri;
  nm: TNamed;
  pk: TPacked;
  rl: TReal;
  a3: TArr3;
  ps: array[0..3] of TPair;
  c: TCounter;
  i, s: Integer;

function MkOne(V: Integer): TOne;
begin
  Result.V := V * 3;
end;

function MkPair(A, B: Integer): TPair;
begin
  Result.A := A;
  Result.B := B;
end;

function Rot(A, B, C: Integer): TTri;
begin
  Result.X := B;
  Result.Y := C;
  Result.Z := A;
end;

function Rot3(const T: TTri): TTri;
begin
  Result.X := T.Z;
  Result.Y := T.X;
  Result.Z := T.Y;
end;

function Bump(N: Integer): TPair;
begin
  Result.A := Result.A + N;
  Result.B := Result.A * 2;
  Result.A := Result.A + 1;
end;

function Pick(N: Integer): TPair;
begin
  if N > 10 then
  begin
    Result.A := N;
    Result.B := -N;
  end
  else
    Result.B := N * 100;
end;

function Sum(N: Integer): TPair;
var
  k: Integer;
begin
  for k := 1 to N do
  begin
    Result.A := Result.A + k;
    if k mod 2 = 0 then
      Result.B := Result.B + k;
  end;
end;

function Twice(N: Integer): TPair;
begin
  Result.A := MkOne(N).V;
  Result.B := MkPair(N, N + 1).B + Result.A;
end;

function MkNamed(const S: string; N: Integer): TNamed;
begin
  Result.Name := S + '!';
  Result.N := N;
end;

function MkPacked(K: Integer): TPacked;
begin
  Result.B1 := Byte(K);
  Result.B2 := Byte(K + 1);
  Result.W := Word(K * 1000);
  Result.L := LongInt(-K);
  Result.Q := K * K;
end;

function MkReal(K: Integer): TReal;
begin
  Result.R := K / 4;
  Result.K := K;
end;

function MkArr3(K: Integer): TArr3;
begin
  Result[0] := K;
  Result[1] := K + 1;
  Result[2] := K + 2;
end;

function SumPair(const P: TPair): Integer;
begin
  Result := P.A * 10 + P.B;
end;

function TCounter.Pair(N: Integer): TPair;
begin
  Result.A := Base + N;
  Result.B := Base - N;
end;

function TCounter.Tri: TTri;
begin
  Result.X := Base;
  Result.Y := Base * 2;
  Result.Z := Base * 3;
end;

begin
  one := MkOne(7);
  WriteLn(one.V, ' ', MkOne(2).V);
  p := MkPair(3, 4);
  q := MkPair(p.B, p.A);
  WriteLn(p.A, ' ', p.B, ' ', q.A, ' ', q.B, ' ', SumPair(MkPair(5, 6)));
  t := Rot(1, 2, 3);
  WriteLn(t.X, ' ', t.Y, ' ', t.Z);
  t := Rot3(t);
  WriteLn(t.X, ' ', t.Y, ' ', t.Z, ' ', Rot3(Rot3(t)).X);
  p := Bump(5);
  WriteLn(p.A, ' ', p.B);
  p := Pick(20);
  q := Pick(3);
  WriteLn(p.A, ' ', p.B, ' ', q.A, ' ', q.B);
  p := Sum(10);
  WriteLn(p.A, ' ', p.B);
  p := Twice(4);
  WriteLn(p.A, ' ', p.B);
  nm := MkNamed('reg', 9);
  WriteLn(nm.Name, ' ', nm.N, ' ', MkNamed('x', 1).Name);
  pk := MkPacked(5);
  WriteLn(pk.B1, ' ', pk.B2, ' ', pk.W, ' ', pk.L, ' ', pk.Q);
  rl := MkReal(10);
  WriteLn(rl.R:0:2, ' ', rl.K);
  a3 := MkArr3(40);
  WriteLn(a3[0], ' ', a3[1], ' ', a3[2], ' ', MkArr3(1)[2]);
  c := TCounter.Create;
  c.Base := 100;
  p := c.Pair(7);
  t := c.Tri;
  WriteLn(p.A, ' ', p.B, ' ', t.X, ' ', t.Y, ' ', t.Z, ' ', c.Pair(1).A);
  for i := 0 to 3 do
    ps[i] := MkPair(i, i * i);
  s := 0;
  for i := 0 to 3 do
    s := s + SumPair(ps[i]);
  WriteLn(s);
  with MkPair(8, 9) do
    WriteLn(A, ' ', B);
  s := 0;
  for i := 1 to 100000 do
  begin
    p := MkPair(i, i + 1);
    t := Rot(p.A, p.B, i);
    s := s + p.B - p.A + t.Z - t.X + Sum(3).A;
  end;
  WriteLn(s);
end.

