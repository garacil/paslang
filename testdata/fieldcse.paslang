{ P314: the scaled index of an element is computed once for the fields
  read or written of it while nothing writes the index or the register
  that holds it: Same writes and reads the fields of 12- and 24-byte
  records, whose index both scale by 3, and InHeap those of a 40-byte
  heap array with its checks; Moved changes the index between fields,
  Called calls between them and Labeled joins two paths between them,
  where the scale is made again. scripts/check_fieldcse.py reads that
  Same and InHeap scale their index once a loop. Written by a script; the
  answers are Python's. }
program fieldcse;

type
  T12 = record a: Int32; b: Word; c: Byte; d: Int32; end;
  T24 = record x, y, z: Integer; end;
  T40 = record p, q, r, s, t: Integer; end;

var
  g12: array[0..31] of T12;
  g24: array[0..31] of T24;
  h40: array of T40;

function Bump(x: Integer): Integer;
begin
  Result := x + 1;
end;

function Same(n: Integer): Integer;
var
  k, t: Integer;
begin
  for k := 0 to 31 do
  begin
    g12[k].a := Int32(k + n);
    g12[k].b := Word(k * 3);
    g12[k].c := Byte(k);
    g12[k].d := Int32(-k);
    g24[k].x := k;
    g24[k].y := k * k;
    g24[k].z := n - k;
  end;
  t := 0;
  for k := 0 to 31 do
    t := t + g12[k].a + g12[k].b + g12[k].c + g12[k].d + g24[k].x + g24[k].y + g24[k].z;
  Result := t;
end;

function Moved(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  k := 0;
  while k < 30 do
  begin
    g24[k].x := k + n;
    k := k + 1;
    g24[k].y := k * 2;
    t := t + g24[k - 1].x + g24[k].y;
  end;
  Result := t;
end;

function Called(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to 31 do
  begin
    g24[k].x := Bump(k + n);
    g24[k].y := Bump(g24[k].x);
    g24[k].z := g24[k].x + g24[k].y;
    t := t + g24[k].z;
  end;
  Result := t;
end;

function Labeled(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to 31 do
  begin
    g24[k].x := k;
    if (k and 1) = 0 then
      g24[k].y := n
    else
      g24[k].y := -n;
    g24[k].z := g24[k].x * 2 + g24[k].y;
    t := t + g24[k].z;
  end;
  Result := t;
end;

function InHeap(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(h40, n);
  for k := 0 to n - 1 do
  begin
    h40[k].p := k;
    h40[k].q := k * 3;
    h40[k].r := -k;
    h40[k].s := n;
    h40[k].t := k xor n;
  end;
  t := 0;
  for k := 0 to n - 1 do
    t := t + h40[k].p + h40[k].q + h40[k].r + h40[k].s + h40[k].t;
  Result := t;
end;

begin
  WriteLn(Same(5), ' ', Same(-70000));
  WriteLn(Moved(3), ' ', Moved(-11));
  WriteLn(Called(2), ' ', Called(100));
  WriteLn(Labeled(9), ' ', Labeled(-4));
  WriteLn(InHeap(1), ' ', InHeap(37), ' ', InHeap(500));
end.
