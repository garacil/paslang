{ P197: maps made by 64 routines at once, every P busy. Each map keeps
  its contents and has a seed of its own: the seed word of the map
  (offset 8 of pasmap's TMap, read through a view) differs from every
  other map's. Before 1.1.92 NextSeed read and wrote two globals with
  plain loads and stores, so routines making maps at once raced on them
  and could share a seed. make check runs it on both machines, under the
  GC's stress and on one CPU. }
program mapseed;

const
  Routines = 64;
  PerRoutine = 100;
  Keys = 50;

var
  seeds: array of Integer;
  bad: Integer;
  wg: waitgroup;
  seen: map[Integer] of Integer;
  i: Integer;

procedure Make(R: Integer);
var
  i, k, sum: Integer;
  m: map[Integer] of Integer;
  s: map[string] of Integer;
begin
  for i := 0 to PerRoutine - 1 do
  begin
    New(m);
    New(s);
    for k := 1 to Keys do
    begin
      m[k * 7919 + R] := k;
      s[PasFmtInt(k * 31 + R, 0)] := k;
    end;
    sum := 0;
    for k := 1 to Keys do
      sum := sum + m[k * 7919 + R] + s[PasFmtInt(k * 31 + R, 0)];
    if (sum <> Keys * (Keys + 1)) or (Length(m) <> Keys) or (Length(s) <> Keys) then
      AtomicAdd(@bad, 1);
    seeds[R * PerRoutine + i] := PInteger(Pointer((m as Integer) + 8))^;
  end;
  wg.Done;
end;

begin
  SetLength(seeds, Routines * PerRoutine);
  wg.Add(Routines);
  for i := 0 to Routines - 1 do
    pas Make(i);
  wg.Wait;
  New(seen);
  for i := 0 to Length(seeds) - 1 do
    seen[seeds[i]] := i;
  WriteLn(Length(seeds), ' maps, ', Length(seen), ' seeds, ', bad, ' bad');
end.
