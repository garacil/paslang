program gdbg;

var
  n: Integer;

procedure Worker;
begin
  Breakpoint;
  n := 1;
end;

begin
  n := 0;
  pas Worker;
  Sleep(40);
  WriteLn(GCount);
  WriteLn(BreakCount);
  if BreakPC <> 0 then
    WriteLn(1)
  else
    WriteLn(0);
  ContinueBreak;
  Sleep(40);
  WriteLn(n);
end.

