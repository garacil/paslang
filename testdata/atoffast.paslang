{ P482: StrToFloat and TryStrToFloat read a plain number where it lies, by the
  scanner and the rounding Val uses, when the point is '.', and send every
  other text the long way. The expected output was made by the compiler
  before: fixed texts (signs, a point on either side or none, exponents,
  blanks, a comma, hexadecimal, words, numbers past the largest Double and
  Single and below the smallest, long digit strings, ties between two
  neighbours), then a hundred and fifty thousand texts of 0 to 24 bytes from
  digits, a point, e, a sign, a space and a comma, each read as a Double and
  as a Single, folded into a hash with whether it was a number; and a few
  read with a comma for the point. }
program atoffast;

uses
  sysutils;

const
  Fixed: array[0..71] of string = (
    '', '0', '-0', '+0', '1', '-1', '+1', '.5', '5.', '.', '-.', '+.5', '-5.', '1.5', '-1.5', '1e5', '1E5', '1e+5', '1e-5',
    '1e', '1e+', 'e5', '1.5e3', '.5e3', '5.e3', '1 ', ' 1', ' 1 ', '1 2', '1,5', '1.5.2', '--1', '1-', '0x10', '$10', '1_0',
    'inf', 'nan', 'Infinity', '+inf', '-nan', '1e308', '1.7976931348623157e308', '1.7976931348623159e308', '1e309', '-1e309',
    '5e-324', '2.4703282292062327e-324', '2.4703282292062328e-324', '1e-400', '3.4028235e38', '3.4028236e38', '3.5e38', '1e-45',
    '1e-46', '0.1', '0.2', '0.3', '9007199254740993', '9007199254740992.5', '9007199254740993.0000000000000000001',
    '123456789012345678901234567890', '0.000000000000000000000000000001', '00000000000000000000001', '1e0000000000005',
    '4.35', '8.41e21', '1e23', '5e-324', '-0.0', '0e100', '12345678.12345678');

var
  h: Int64;
  seed: Int64;

function Next: Int64;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := seed;
end;

procedure Mix(V: Int64; Ok: Boolean);
begin
  h := (h * 1000003 + V) xor (h shr 31);
  if Ok then
    h := h + 1;
end;

procedure One(const S: string; Show: Boolean);
var
  d: Double;
  f: Single;
  bits, bits2: Int64;
  dd: Double;
  fb: Integer;
  okd, okf: Boolean;
begin
  okd := TryStrToFloat(S, d);
  bits := 0;
  Move(d, bits, 8);
  Mix(bits, okd);
  okf := TryStrToFloat(S, f);
  fb := 0;
  Move(f, fb, 4);
  Mix(fb, okf);
  dd := StrToFloatDef(S, 123.0);
  bits2 := 0;
  Move(dd, bits2, 8);
  Mix(bits2, True);
  if Show then
    WriteLn(S, ' | ', okd, ' ', IntToHex(bits, 16), ' | ', okf, ' ', IntToHex(fb, 8));
end;

var
  i, k, n: Integer;
  s, alpha: string;
  fs: TFormatSettings;
  d: Double;
begin
  h := 11;
  for i := 0 to High(Fixed) do
    One(Fixed[i], True);
  alpha := '0123456789012345678901234567890123456789..ee+- ,';
  seed := 20261028;
  for i := 1 to 150000 do
  begin
    n := Integer((Next shr 40) mod 25);
    s := '';
    for k := 1 to n do
      s := s + alpha[Integer((Next shr 40) mod Length(alpha)) + 1];
    One(s, False);
  end;
  WriteLn('hash ', h);
  fs := DefaultFormatSettings;
  fs.DecimalSeparator := ',';
  fs.ThousandSeparator := '.';
  for i := 0 to 11 do
  begin
    s := Copy('1,5|2.5|1.234,5|0,1|7|-3,25e2|1e5|,5|5,| 4,5 |1.5|1,5,5', 1, 100);
    k := Pos('|', s);
    n := 1;
    while (n <= i) and (k > 0) do
    begin
      s := Copy(s, k + 1, Length(s) - k);
      k := Pos('|', s);
      n := n + 1;
    end;
    if k > 0 then
      s := Copy(s, 1, k - 1);
    if TryStrToFloat(s, d, fs) then
      WriteLn(s, ' -> ', IntToHex(Trunc(d * 1000), 8))
    else
      WriteLn(s, ' -> refused');
  end;
end.
