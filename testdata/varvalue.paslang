{ P325: a var or out parameter through a routine value or a method
  value gets its argument's place, as a direct call's does: integers of
  every width, a string, a record and a slice, from variables, fields,
  elements and pointers' targets, through values in variables, fields,
  elements and results. The answers are worked out by hand in the
  comments. }
program varvalue;

uses paslib;

type
  TPt = record
    X, Y: Integer;
  end;
  TInts = array of Integer;
  TBump = function(var X: Integer; K: Integer): Integer;
  TBump32 = procedure(var X: Int32; var B: Byte);
  TName = procedure(var S: string; const Tail: string);
  TMove = procedure(var P: TPt; DX: Integer);
  TGrow = procedure(var D: TInts; V: Integer);
  TSet = procedure(out X: Integer);
  THold = record
    Tag: Integer;
    Fn: TBump;
  end;
  TCount = class
    Total: Integer;
    procedure Add(var X: Integer; K: Integer);
  end;
  TAdd = procedure(var X: Integer; K: Integer) of object;
  PInt = ^Integer;

function Bump(var X: Integer; K: Integer): Integer;
begin
  X := X + 100;
  Result := K;
end;

procedure Bump32(var X: Int32; var B: Byte);
begin
  X := X - 1;
  B := B + 1;
end;

procedure Name(var S: string; const Tail: string);
begin
  S := S + Tail;
end;

procedure MovePt(var P: TPt; DX: Integer);
begin
  P.X := P.X + DX;
  P.Y := P.Y * 2;
end;

procedure Grow(var D: TInts; V: Integer);
begin
  SetLength(D, Length(D) + 1);
  D[High(D)] := V;
end;

procedure SetSeven(out X: Integer);
begin
  X := 7;
end;

procedure TCount.Add(var X: Integer; K: Integer);
begin
  X := X + K;
  Total := Total + K;
end;

function Pick: TBump;
begin
  Result := @Bump;
end;

var
  f: TBump;
  f32: TBump32;
  fn: TName;
  fm: TMove;
  fg: TGrow;
  fs: TSet;
  h: THold;
  arr: array[0..2] of TBump;
  v, w: Integer;
  n32: Int32;
  by: Byte;
  s: string;
  p: TPt;
  d: TInts;
  pts: array[0..1] of TPt;
  vals: array[0..3] of Integer;
  pw: PInt;
  c: TCount;
  ma: TAdd;
  r: Integer;

begin
  { 1 + 100: f(v, 1) gives 1 and v is 101 }
  f := @Bump;
  v := 1;
  r := f(v, 1);
  WriteLn(r, ' ', v);
  { through a field, an element and a result: v 101 + 300 }
  h.Tag := 0;
  h.Fn := @Bump;
  arr[1] := @Bump;
  r := h.Fn(v, 2) + arr[1](v, 3) + Pick()(v, 4);
  WriteLn(r, ' ', v);
  { to a record's field, an element and a pointer's target }
  p.X := 5;
  p.Y := 6;
  vals[2] := 10;
  w := 20;
  pw := @w;
  r := f(p.X, 0) + f(vals[2], 0) + f(pw^, 0);
  WriteLn(p.X, ' ', vals[2], ' ', w);
  { narrow integers: 40 - 1 and 254 + 1 }
  f32 := @Bump32;
  n32 := 40;
  by := 254;
  f32(n32, by);
  WriteLn(n32, ' ', by);
  { a string, a record, a slice, an out parameter }
  fn := @Name;
  s := 'pas';
  fn(s, 'lang');
  fm := @MovePt;
  pts[1].X := 1;
  pts[1].Y := 3;
  fm(pts[1], 9);
  fg := @Grow;
  d := [4];
  fg(d, 8);
  fg(d, 15);
  fs := @SetSeven;
  w := 0;
  fs(w);
  WriteLn(s, ' ', pts[1].X, ' ', pts[1].Y, ' ', Length(d), ' ', d[0] + d[1] + d[2], ' ', w);
  { a method value: X 5 + 6, the total 6 }
  c := TCount.Create;
  ma := c.Add;
  v := 5;
  ma(v, 6);
  WriteLn(v, ' ', c.Total);
end.

