{ SysUtils' dates and times (P131) where paslang writes what Free Pascal
  3.2.2 writes: EncodeDate and EncodeTime and their messages, DecodeDate,
  DecodeTime and the time stamps, the day of the week, IncMonth and
  IncAMonth, a TSystemTime, ComposeDateTime, ReplaceTime and
  ReplaceDate, FloatToDateTime, the constants and
  TwoDigitYearCenturyWindow, which is DefaultFormatSettings' field;
  FormatDateTime with forty formats of twelve moments and settings of
  another country; StrToDate, StrToTime, StrToDateTime and their Try
  and Def forms, good and bad, with their messages. The output is Free
  Pascal's; dates2 has what differs, and the manual's section 19 why. }
program dates1;

{$mode objfpc}{$H+}

uses sysutils;

const
  NF = 40;
  Fmts: array[1..NF] of string = (
    'dd.mm.yyyy', 'd/m/y', 'dddd, d mmmm yyyy', 'ddd dd mmm yy', 'ddddd', 'dddddd',
    'hh:nn:ss', 'h:n:s', 'hh:nn:ss.zzz', 'h:nn:ss.z', 't', 'tt', 'c', 'f', '',
    'hh:mm', 'h:m', 'mm/dd hh:mm', 'hh "o''clock" mm', 'yyyy-mm-dd"T"hh:nn:ss',
    'hh:nn am/pm', 'h:nn a/p', 'hh:nn ampm', 'AM/PM hh', 'A/P h', 'am/pmhh:mm',
    '''quoted'' "dq" ''unterminated', 'yyy yy y yyyyy', 'mmmmm mmmmmm', 'ddddddd dddddddd',
    'z zz zzz zzzz', 's ss sss', 'n nn nnn', 'h hh hhh', '[h]:nn', 'dd/mm/yyyy hh:nn',
    '[hh]', ' 1 2 3 . , ; - + ', 'd-m-yy h:n:s.zzz AM/PM', 'hh:nn:ss "and" mm');
  NV = 12;

function Bits(d: Double): string;
var
  i: Int64;
begin
  Move(d, i, 8);
  Result := IntToHex(i, 16);
end;

function B(x: Boolean): string;
begin
  if x then Result := 'T' else Result := 'F';
end;

procedure Enc(y, m, d: Integer);
var
  r: TDateTime;
  yy, mm, dd, dow: Word;
begin
  try
    r := EncodeDate(y, m, d);
    DecodeDateFully(r, yy, mm, dd, dow);
    WriteLn('enc ', y, ' ', m, ' ', d, ' = ', Bits(r), ' ', yy, '-', mm, '-', dd, ' ', dow, ' ', DayOfWeek(r));
  except
    on E: EConvertError do WriteLn('enc ', y, ' ', m, ' ', d, ' ! ', E.Message);
  end;
end;

procedure EncT(h, n, s, ms: Integer);
var
  r: TDateTime;
  hh, nn, ss, zz: Word;
begin
  try
    r := EncodeTime(h, n, s, ms);
    DecodeTime(r, hh, nn, ss, zz);
    WriteLn('enct ', h, ':', n, ':', s, '.', ms, ' = ', Bits(r), ' ', hh, ':', nn, ':', ss, '.', zz);
  except
    on E: EConvertError do WriteLn('enct ', h, ' ', n, ' ', s, ' ', ms, ' ! ', E.Message);
  end;
end;

procedure Dec2(x: Double);
var
  y, m, d, h, n, s, z, dow: Word;
  ts: TTimeStamp;
begin
  DecodeDateFully(x, y, m, d, dow);
  DecodeTime(x, h, n, s, z);
  ts := DateTimeToTimeStamp(x);
  WriteLn('dec ', Bits(x), ' ', y, '-', m, '-', d, ' ', dow, ' ', h, ':', n, ':', s, '.', z, ' ts ', ts.Date, ' ', ts.Time, ' back ', Bits(TimeStampToDateTime(ts)), ' ms ', Trunc(TimeStampToMSecs(ts)));
end;
procedure SD(const S: string);
var
  d: TDateTime;
begin
  try
    d := StrToDate(S);
    WriteLn('sd [', S, '] ', FormatDateTime('yyyy-mm-dd', d), ' ', Bits(d));
  except
    on E: EConvertError do WriteLn('sd [', S, '] ! ', E.Message);
  end;
end;

procedure SDF(const S, F: string; Sep: Char);
var
  d: TDateTime;
begin
  try
    d := StrToDate(S, F, Sep);
    WriteLn('sdf [', S, '] [', F, '] ', FormatDateTime('yyyy-mm-dd', d));
  except
    on E: EConvertError do WriteLn('sdf [', S, '] [', F, '] ! ', E.Message);
  end;
end;

procedure ST(const S: string);
var
  d: TDateTime;
begin
  try
    d := StrToTime(S);
    WriteLn('st [', S, '] ', FormatDateTime('hh:nn:ss.zzz', d), ' ', Bits(d));
  except
    on E: EConvertError do WriteLn('st [', S, '] ! ', E.Message);
  end;
end;

procedure SDT(const S: string);
var
  d: TDateTime;
  ok: Boolean;
begin
  try
    d := StrToDateTime(S);
    WriteLn('sdt [', S, '] ', FormatDateTime('yyyy-mm-dd hh:nn:ss.zzz', d));
  except
    on E: EConvertError do WriteLn('sdt [', S, '] ! ', E.Message);
  end;
  ok := TryStrToDateTime(S, d);
  if ok then
    WriteLn('tsdt [', S, '] ', FormatDateTime('yyyy-mm-dd hh:nn:ss.zzz', d))
  else
    WriteLn('tsdt [', S, '] F');
end;
var
  i, j: Integer;
  x, k1, k2, half, msd: Double;
  sys: TSystemTime;
  y, m, d: Word;
  vals: array[1..NV] of Double;
  fs: TFormatSettings;
  dt: TDateTime;
begin
  Enc(1, 1, 1); Enc(9999, 12, 31); Enc(1899, 12, 30); Enc(1900, 2, 28); Enc(1900, 2, 29); Enc(2000, 2, 29);
  Enc(2100, 2, 29); Enc(2024, 2, 29); Enc(2026, 9, 30); Enc(0, 1, 1); Enc(10000, 1, 1); Enc(2026, 13, 1);
  Enc(2026, 0, 1); Enc(2026, 4, 31); Enc(1970, 1, 1); Enc(1582, 10, 10);
  EncT(0, 0, 0, 0); EncT(23, 59, 59, 999); EncT(22, 59, 60, 0); EncT(24, 0, 0, 0);
  EncT(12, 30, 45, 500); EncT(0, 60, 0, 0); EncT(1, 2, 3, 1000);
  for i := -10 to 10 do Dec2(i * 0.25);
  Dec2(-693593.5); Dec2(-693594.0); Dec2(-693594.5); Dec2(2958465.99999999); Dec2(2958466.5);
  Dec2(46295.999999999); Dec2(46295.9999999); Dec2(46295.99999); half := 0.5; msd := 86400000; Dec2(half / msd); Dec2(-half / msd);
  Dec2(1e-12); Dec2(12345.6789); Dec2(-12345.6789); Dec2(40000.123456789);
  x := 1.0;
  k1 := 1.37;
  k2 := 0.123;
  for i := 1 to 60 do begin Dec2(x); x := x * k1 + k2; end;
  WriteLn(B(IsLeapYear(1900)), B(IsLeapYear(2000)), B(IsLeapYear(2024)), B(IsLeapYear(2026)), B(IsLeapYear(4)));
  WriteLn(Bits(ComposeDateTime(46295, 0.75)), ' ', Bits(ComposeDateTime(-3, 0.75)), ' ', Bits(ComposeDateTime(-3.5, -0.25)), ' ', Bits(ComposeDateTime(10.9, 0.1)));
  x := EncodeDate(2026, 1, 31) + EncodeTime(10, 0, 0, 0);
  for i := -14 to 14 do Write(FormatDateTime('yyyy-mm-dd', IncMonth(x, i)), ' ');
  WriteLn;
  y := 2024; m := 2; d := 29; IncAMonth(y, m, d, 12); WriteLn(y, '-', m, '-', d);
  y := 2024; m := 1; d := 31; IncAMonth(y, m, d, -13); WriteLn(y, '-', m, '-', d);
  y := 2024; m := 3; d := 31; IncAMonth(y, m, d, -1); WriteLn(y, '-', m, '-', d);
  y := 2024; m := 12; d := 15; IncAMonth(y, m, d, 1); WriteLn(y, '-', m, '-', d);
  y := 2024; m := 1; d := 15; IncAMonth(y, m, d, -1); WriteLn(y, '-', m, '-', d);
  y := 2024; m := 6; d := 15; IncAMonth(y, m, d, -30); WriteLn(y, '-', m, '-', d);
  DateTimeToSystemTime(EncodeDate(2026, 9, 30) + EncodeTime(14, 5, 7, 89), sys);
  WriteLn(sys.Year, ' ', sys.Month, ' ', sys.Day, ' ', sys.DayOfWeek, ' ', sys.Hour, ' ', sys.Minute, ' ', sys.Second, ' ', sys.MilliSecond);
  WriteLn(Bits(SystemTimeToDateTime(sys)));
  sys.Month := 13;
  WriteLn(Bits(SystemTimeToDateTime(sys)));
  WriteLn(MSecsToTimeStamp(123456789012).Date, ' ', MSecsToTimeStamp(123456789012).Time, ' ', MSecsToTimeStamp(-5).Date, ' ', MSecsToTimeStamp(-5).Time);
  x := 46295.5;
  ReplaceTime(x, 0.25); WriteLn(Bits(x));
  ReplaceDate(x, 40000.9); WriteLn(Bits(x));
  try
    x := FloatToDateTime(-1000000);
  except
    on E: EConvertError do WriteLn(E.Message);
  end;
  WriteLn(Bits(FloatToDateTime(2958465.5)));
  WriteLn(HoursPerDay, ' ', MinsPerDay, ' ', SecsPerDay, ' ', MSecsPerDay, ' ', DateDelta, ' ', UnixDateDelta, ' ', Bits(UnixEpoch), ' ', Bits(JulianEpoch), ' ', MonthDays[True, 2], ' ', MonthDays[False][2], ' ', Bits(MinDateTime), ' ', Bits(MaxDateTime));
  WriteLn(TwoDigitYearCenturyWindow, ' ', DefaultFormatSettings.TwoDigitYearCenturyWindow);
  TwoDigitYearCenturyWindow := 80;
  WriteLn(DefaultFormatSettings.TwoDigitYearCenturyWindow, ' ', FormatSettings.TwoDigitYearCenturyWindow);
  vals[1] := EncodeDate(2026, 9, 30) + EncodeTime(14, 5, 7, 89);
  vals[2] := EncodeDate(2026, 1, 2) + EncodeTime(0, 0, 0, 0);
  vals[3] := EncodeDate(1999, 12, 31) + EncodeTime(23, 59, 59, 999);
  vals[4] := EncodeDate(2000, 2, 29) + EncodeTime(12, 0, 0, 0);
  vals[5] := EncodeDate(1, 1, 1) + EncodeTime(0, 0, 1, 0);
  vals[6] := EncodeDate(9999, 12, 31) + EncodeTime(12, 30, 0, 0);
  vals[7] := 0;
  vals[8] := -1.25;
  vals[9] := EncodeDate(1900, 3, 1) + EncodeTime(1, 2, 3, 4);
  vals[10] := EncodeTime(0, 30, 0, 0);
  vals[11] := EncodeDate(2026, 6, 15) + EncodeTime(11, 59, 59, 999);
  vals[12] := EncodeDate(2026, 6, 15) + EncodeTime(12, 0, 0, 0);
  for i := 1 to NV do
    for j := 1 to NF do
      WriteLn(i, ' ', j, ' [', FormatDateTime(Fmts[j], vals[i]), ']');
  fs := DefaultFormatSettings;
  fs.DateSeparator := '.';
  fs.TimeSeparator := '.';
  fs.ShortDateFormat := 'dd/mm/yyyy';
  fs.LongTimeFormat := 'hh:nn:ss';
  fs.TimeAMString := 'vorm';
  fs.TimePMString := 'nachm';
  fs.LongMonthNames[9] := 'Septiembre';
  fs.ShortDayNames[4] := 'mié';
  for j := 1 to NF do
    WriteLn('fs ', j, ' [', FormatDateTime(Fmts[j], vals[1], fs), ']');
  WriteLn(DateToStr(vals[1], fs), '|', TimeToStr(vals[1], fs), '|', DateTimeToStr(vals[1], fs), '|', DateTimeToStr(vals[2], fs, True));
  WriteLn(DateToStr(vals[3]), '|', TimeToStr(vals[3]), '|', DateTimeToStr(vals[3]), '|', DateTimeToStr(vals[2]), '|', DateTimeToStr(vals[2], True));
  SD('30-9-2026'); SD('30-09-2026'); SD(' 30-9-2026 '); SD('30-9-2026   '#9); SD('1-1-1');
  SD('31-12-9999'); SD('29-2-2024'); SD('29-2-2023'); SD('32-1-2026'); SD('1-13-2026'); SD('0-1-2026');
  SD('30/9/2026'); SD(''); SD('   '); SD('a-b-c'); SD('30-9-2026-1');
  SD('30--2026'); SD('-9-2026'); SD('30-9-'); SD('30 - 9 - 2026'); SD('99999-1-2026'); SD('30-9-70000');
  SD('30-9-075'); SD('30-9-2026x');
  SD('00030-0009-2026'); SD('+30-9-2026');
  SDF('2026/09/30', 'yyyy/mm/dd', '/'); SDF('09/30/2026', 'mm/dd/yyyy', '/'); SDF('2026.30.09', 'y.d.m', '.');
  SDF('30 9 2026', 'd m y', ' '); SDF('30 9 2026', 'd/m/y', #0); 
  SDF('2026-9-30', 'ymd', #0); SDF('30-9-2026', 'dd', #0); SDF('30-9-2026', '', #0); SDF('30-9-2026', 'MDY', #0);
  ST('14:05:07'); ST('14:05'); ST('14'); ST('14:05:07.089'); ST('14:05:07.89'); ST('14:05:07.9');
  ST('2:05 pm'); ST('2:05 PM'); ST('12:00 am'); ST('12:00 pm'); ST('am 2:05'); ST('13:00 pm'); ST('0:00 am');
  ST('  14:05  '); ST('24:00'); ST('23:60'); ST('1:2:3.4567'); ST('007:5'); ST('14::05');
  ST(':14'); ST('14:'); ST('14:05:07:08'); ST('.5'); ST('14.5'); ST('14:05.5'); ST('abc'); ST('');
  ST('2:05pm'); ST('2:05p'); ST('2:05 a.m.'); ST('14:05:07.089 pm'); ST('00014:5');
  SDT('30-9-2026 14:05:07'); SDT('30-9-2026'); SDT('14:05'); SDT('  30-9-2026   14:05:07.5  ');
  SDT(''); SDT('30-9-2026 x'); SDT('garbage'); SDT('30-9-2026 25:00'); SDT('30-9-2026'#9'14:05');
  fs := DefaultFormatSettings;
  fs.DateSeparator := '/';
  fs.ShortDateFormat := 'mm/dd/yyyy';
  fs.TimeSeparator := '.';
  fs.DecimalSeparator := ',';
  fs.TimeAMString := 'vorm';
  WriteLn(FormatDateTime('yyyy-mm-dd', StrToDate('09/30/2026', fs)), ' ', FormatDateTime('hh:nn:ss.zzz', StrToTime('14.05.07,5', fs)));
  WriteLn(FormatDateTime('hh:nn', StrToTime('2.05 vorm', fs)), ' ', FormatDateTime('yyyy-mm-dd hh:nn', StrToDateTime('09/30/2026 14.05', fs)));
  WriteLn(B(TryStrToDate('', dt)), ' ', B(TryStrToTime('', dt)), ' ', B(TryStrToDate('30-9-2026', dt, '-')), ' ', B(TryStrToTime('14.05', dt, '.')));
  WriteLn(Bits(StrToDateDef('bad', 7.5)), ' ', Bits(StrToTimeDef('bad', 0.25)), ' ', Bits(StrToDateTimeDef('bad', 1.5)), ' ', Bits(StrToDateDef('30-9-2026', 7.5)));
  WriteLn(FormatDateTime('yyyy-mm-dd', StrToDate('2026x9x30', 'ymd', 'x')), ' ', FormatDateTime('hh:nn', StrToTime('14h05', 'h')));
  fs := DefaultFormatSettings;
  fs.DateSeparator := ' ';
  fs.TimeSeparator := ' ';
  try
    WriteLn(FormatDateTime('yyyy-mm-dd hh:nn', StrToDateTime('30 9 2026', fs)));
  except
    on E: EConvertError do WriteLn(E.Message);
  end;
  fs.TimeSeparator := '-';
  fs.DateSeparator := '-';
  try
    WriteLn(FormatDateTime('yyyy-mm-dd hh:nn', StrToDateTime('14-05', fs)));
  except
    on E: EConvertError do WriteLn(E.Message);
  end;
end.

