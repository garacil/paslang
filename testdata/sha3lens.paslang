program sha3lens;

{ P550: SHA3-224, SHA3-256, SHA3-384 and SHA3-512 of data made from a seed, for every length from 0 to 150 (every padding case of the last block of each) and for some longer ones }

uses
  sysutils;

var
  seed: Int64;

function Rnd: Integer;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := Integer((seed shr 33) and 255);
end;

function Data(n, kind: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, n);
  for i := 1 to n do
    case kind of
      0: Result[i] := Chr(Rnd);
      1: Result[i] := Chr(255);
      2: Result[i] := Chr(0);
    else
      Result[i] := Chr(97 + (i mod 7));
    end;
end;

procedure One(n, kind: Integer);
var
  s: string;
begin
  seed := 550 + n * 31 + kind;
  s := Data(n, kind);
  WriteLn(n, ' ', kind, ' ', Hex(Sha3_224(s)), ' ', Hex(Sha3_256(s)), ' ', Hex(Sha3_384(s)), ' ', Hex(Sha3_512(s)));
end;

const
  Big: array[0..3] of Integer = (1000, 4095, 4096, 65536);

var
  n, k: Integer;
begin
  for n := 0 to 150 do
    for k := 0 to 3 do
      One(n, k);
  for k := 0 to 3 do
  begin
    One(Big[k], 0);
    One(Big[k], 3);
  end;
end.
