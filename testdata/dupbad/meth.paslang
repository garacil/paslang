{ P75: a local repeating a method of its class. Refused. }
program meth;

type
  TA = class
    function Routine: string;
    function Go: string;
  end;

function TA.Routine: string;
begin
  Result := 'm';
end;

function TA.Go: string;
var
  routine: string;
begin
  routine := 'local';
  Result := routine;
end;

var
  a: TA;
begin
  a := TA.Create;
  WriteLn(a.Go);
end.

