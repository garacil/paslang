{ P75: a local repeating a field of its class. Refused. }
program field;

type
  TA = class
    Depth: Integer;
    procedure Go;
  end;

procedure TA.Go;
var
  depth: Integer;
begin
  depth := 1;
end;

var
  a: TA;
begin
  a := TA.Create;
  a.Go;
end.

