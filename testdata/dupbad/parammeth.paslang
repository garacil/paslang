{ A parameter of a method named like a method of its class: refused.
  It compiled, and Lab inside Show was the method, not the argument. }
program parammeth;

type
  TA = class
    function Lab: string;
    procedure Show(const Lab: string);
  end;

function TA.Lab: string;
begin
  Result := 'method';
end;

procedure TA.Show(const Lab: string);
begin
  WriteLn(Lab);
end;

var
  a: TA;

begin
  a := TA.Create;
  a.Show('param');
end.

