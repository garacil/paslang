{ P398: an index past the length of a slice an object's field holds is
  stopped where it is read, after a call shrank the field. }
program sliceoob;

type
  TC = class
    A: array of Integer;
    function At(I: Integer): Integer;
  end;

function TC.At(I: Integer): Integer;
begin
  Result := A[I];
end;

var
  c: TC;

begin
  c := TC.Create;
  SetLength(c.A, 3);
  c.A[2] := 7;
  WriteLn(c.At(2));
  SetLength(c.A, 2);
  WriteLn(c.At(2));
end.
