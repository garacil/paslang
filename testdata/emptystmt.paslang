program emptystmt;

{ The empty statement (1.0.78): after then, else, do, a case label, and
  before end and until. }

var
  x, n: Integer;

begin
  x := 3;
  n := 0;
  if x > 0 then ;
  if x > 5 then else n := n + 1;
  while x > 5 do ;
  for x := 1 to 3 do ;
  repeat
    n := n + 10;
  until n > 25;
  case n of
    31: ;
    0..30: n := -1;
  else
    ;
  end;
  begin
    ;
    ;
  end;
  WriteLn(n);
end.
