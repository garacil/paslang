{ P380: a class's helper is searched at the class's own level. From the
  value's class to its parents, at each class the helper for that class
  first and then the class's own members, as Free Pascal's
  searchsym_in_class walks them: TFoo's helper hides TFoo's Speak and
  Name, but not TBar's override of Speak, TBar's own Name or its field
  Tag; TBar's helper adds Only and leaves TFoo's helper reachable for
  Extra; a TBar through a TFoo variable reaches TFoo's helper; the same
  through the class's name, a with, and a constructor of the name. The
  output is written by hand from Free Pascal's compiler/symtable.pas. }
program helplevel;

type
  TFoo = class
    function Speak: string; virtual;
    function Name: string;
    class function Kind: string; static;
    constructor Make;
  end;

  TBar = class(TFoo)
    Tag: Integer;
    function Speak: string; override;
    function Name: string;
    class function Kind: string; static;
    constructor Make;
  end;

  TBaz = class(TBar)
  end;

  TFooHelper = class helper for TFoo
    function Speak: string;
    function Name: string;
    function Extra: string;
    function Tag: Integer;
    class function Kind: string; static;
    constructor Make;
  end;

  TBarHelper = class helper for TBar
    function Only: string;
  end;

function TFoo.Speak: string;
begin
  Result := 'foo speak';
end;

function TFoo.Name: string;
begin
  Result := 'foo name';
end;

class function TFoo.Kind: string;
begin
  Result := 'foo kind';
end;

constructor TFoo.Make;
begin
end;

function TBar.Speak: string;
begin
  Result := 'bar speak';
end;

function TBar.Name: string;
begin
  Result := 'bar name';
end;

class function TBar.Kind: string;
begin
  Result := 'bar kind';
end;

constructor TBar.Make;
begin
  Tag := 7;
end;

function TFooHelper.Speak: string;
begin
  Result := 'helper speak';
end;

function TFooHelper.Name: string;
begin
  Result := 'helper name';
end;

function TFooHelper.Extra: string;
begin
  Result := 'helper extra';
end;

function TFooHelper.Tag: Integer;
begin
  Result := 99;
end;

class function TFooHelper.Kind: string;
begin
  Result := 'helper kind';
end;

constructor TFooHelper.Make;
begin
end;

function TBarHelper.Only: string;
begin
  Result := 'bar only';
end;

var
  f, fb: TFoo;
  b: TBar;
  z: TBaz;

begin
  f := TFoo.Create;
  b := TBar.Create;
  z := TBaz.Create;
  fb := b;
  WriteLn(f.Speak, ', ', f.Name, ', ', f.Tag);
  WriteLn(b.Speak, ', ', b.Name, ', ', b.Extra, ', ', b.Only, ', ', b.Tag);
  WriteLn(z.Speak, ', ', z.Name, ', ', z.Extra, ', ', z.Only);
  WriteLn(fb.Speak, ', ', fb.Name, ', ', fb.Tag);
  with b do
    WriteLn(Speak, ', ', Name, ', ', Extra, ', ', Tag);
  with f do
    WriteLn(Speak, ', ', Name, ', ', Tag);
  WriteLn(TFoo.Kind, ', ', TBar.Kind, ', ', TBaz.Kind);
  b := TBar.Make;
  z := TBaz.Make;
  WriteLn(b.Tag, ' ', z.Tag);
end.

