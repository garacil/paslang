program props;

type
  TBox = class
    FS: string;
    procedure SetS(V: string);
    function GetS: string;
    property S: string read GetS write SetS;
  end;

procedure TBox.SetS(V: string);
begin
  FS := V;
end;

function TBox.GetS: string;
begin
  Result := FS;
end;

var
  O: TBox;

begin
  O := TBox.Create;
  O.S := 'hello';
  WriteLn(O.S);
  WriteLn(Length(O.S));
  O.S := 'ab';
  WriteLn(O.S);
end.
