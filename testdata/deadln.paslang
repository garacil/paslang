program deadln;

uses pasnet;

var
  l, c: Integer;
  got: string;
begin
  l := TcpListen(0);
  if l < 0 then
    Halt(1);
  c := TcpConnect('127.0.0.1', TcpPort(l));
  if c < 0 then
    Halt(1);
  got := TcpReadDeadline(c, 64, 80);
  if Length(got) <> 0 then
    Halt(1);
  WriteLn('timeout');
  TcpClose(c);
  TcpClose(l);
end.

