{ P338: what goes into a routine value, a method value and an
  interface: nil, @ of a routine, a closure, another value of the kind,
  a method value from obj.M with parameters and @obj.M without, a class
  that lists the interface and another interface value; as variables,
  arguments, fields, elements and results, both machines. The answers
  are worked out by hand in the comments. testdata/valkindbad holds
  the refusals. }
program valkinds;

type
  TFn = function(K: Integer): Integer;
  TMeth = function: Integer of object;
  TAdd = procedure(K: Integer) of object;
  IVal = interface
    function Get: Integer;
  end;
  TBox = class(IVal)
    N: Integer;
    function Get: Integer;
    procedure Add(K: Integer);
  end;
  THold = record
    Fn: TFn;
    M: TMeth;
    V: IVal;
  end;

function TBox.Get: Integer;
begin
  Result := N;
end;

procedure TBox.Add(K: Integer);
begin
  N := N + K;
end;

function Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

function Pick(Big: Boolean): TFn;
begin
  if Big then
    Result := function(K: Integer): Integer
    begin
      Result := K * 100;
    end
  else
    Result := @Twice;
end;

function Apply(F: TFn; K: Integer): Integer;
begin
  if F = nil then
    Result := -1
  else
    Result := F(K);
end;

function AsVal(B: TBox): IVal;
begin
  Result := B;
end;

var
  f, g: TFn;
  m: TMeth;
  a: TAdd;
  v, w: IVal;
  h: THold;
  arr: array[0..1] of IVal;
  b: TBox;

begin
  { 6, 300, -1, 14 }
  f := @Twice;
  g := f;
  WriteLn(g(3), ' ', Apply(Pick(True), 3), ' ', Apply(nil, 3), ' ', Apply(@Twice, 7));
  { a method value with parameters by its name, without by @: 5 + 4 }
  b := TBox.Create;
  b.N := 5;
  a := b.Add;
  a(4);
  m := @b.Get;
  WriteLn(m(), ' ', b.N);
  { interfaces from a class, an interface, a result, into fields and
    elements: 9 9 9 9 }
  v := b;
  w := v;
  h.V := AsVal(b);
  arr[1] := w;
  h.Fn := Pick(False);
  h.M := m;
  WriteLn(v.Get, ' ', w.Get, ' ', h.V.Get, ' ', arr[1].Get, ' ', h.Fn(2), ' ', h.M());
  f := nil;
  m := nil;
  WriteLn(f = nil, ' ', Assigned(m));
end.

