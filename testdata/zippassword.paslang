program zip_password_contracts;
uses paslib, sysutils, pascipher, paszip;

var
  AesBlob, LegacyBlob, AesPassword, LegacyPassword, AesHash, LegacyHash: string;
  Extractors: waitgroup;

procedure Check(Ok: Boolean; const Why: string);
begin
  if not Ok then begin WriteLn('ZIP-PASSWORD ', Why); Halt(125); end;
end;

procedure PrimitiveContracts;
var A, B: string; I: Integer; State: UInt32;
begin
  Check(CipherEqual('', ''), 'empty secret comparison');
  Check(not CipherEqual('a', ''), 'unequal public lengths');
  A := StringOfChar(#0, 10);
  Check(CipherEqual(A, StringOfChar(#0, 10)), 'equal tag');
  for I := 1 to 10 do begin
    B := StringOfChar(#0, 10); B[I] := #1;
    Check(not CipherEqual(A, B), 'tag mismatch byte ' + IntToStr(I));
  end;
  { Go hash/crc32/crc32_test.go golden[3], IEEE of abc. }
  State := UInt32($FFFFFFFF);
  State := PasCrc32Byte(State, Ord('a'));
  State := PasCrc32Byte(State, Ord('b'));
  State := PasCrc32Byte(State, Ord('c'));
  Check(UInt32(not State) = UInt32($352441C2), 'raw IEEE CRC byte adapter');
end;

function Field(var Line: string): string;
var N: Integer;
begin
  N := Pos(#9, Line);
  if N = 0 then begin Result := Line; Line := ''; end
  else begin Result := Copy(Line, 1, N - 1); Line := Copy(Line, N + 1, Length(Line)); end;
end;

function RawHex(const H: string): string;
var I, A, B: Integer;
begin
  if H = '-' then begin Result := ''; Exit; end;
  Check(Length(H) mod 2 = 0, 'password hex length');
  SetLength(Result, Length(H) div 2);
  for I := 1 to Length(Result) do begin
    A := Pos(H[2 * I - 1], '0123456789abcdef') - 1;
    B := Pos(H[2 * I], '0123456789abcdef') - 1;
    Check((A >= 0) and (B >= 0), 'password hex');
    Result[I] := Char(A * 16 + B);
  end;
end;

function SameEntry(const A, B: TZipEntry): Boolean;
begin
  Result := (A.Name = B.Name) and (A.Comment = B.Comment) and
    (A.Method = B.Method) and (A.Flags = B.Flags) and
    (A.VersionMade = B.VersionMade) and (A.VersionNeeded = B.VersionNeeded) and
    (A.DosTime = B.DosTime) and (A.DosDate = B.DosDate) and
    (A.Crc = B.Crc) and (A.CompSize = B.CompSize) and (A.Size = B.Size) and
    (A.ExternalAttr = B.ExternalAttr) and (A.Extra = B.Extra) and
    (A.LocalExtra = B.LocalExtra) and (A.HeaderOffset = B.HeaderOffset);
end;

procedure CaseRow(const Directory: string; Line: string);
var
  Id, FileName, H, WantHash, ArchiveHash, Blob, IndependentBlob, Password,
    SavedPassword, Got, SavedRaw, BeforeHash, Repacked, RawBytes: string;
  HavePassword, Raised, Created, ReplaceRaised: Boolean;
  WantStage, Limit: Integer;
  R, Independent, CopyReader: TZipReader;
  W: TZipWriter;
  E, SavedEntry: TZipEntry;
begin
  Id := Field(Line); FileName := Field(Line); H := Field(Line);
  HavePassword := Field(Line) = '1'; WantStage := sysutils.StrToInt(Field(Line));
  WantHash := Field(Line); Limit := sysutils.StrToInt(Field(Line));
  ArchiveHash := Field(Line); Check(Line = '', Id + ' extra field');
  Check(ReadFile(JoinPath(Directory, FileName), Blob), Id + ' read');
  Check(ReadFile(JoinPath(Directory, FileName), IndependentBlob), Id + ' independent read');
  Check(Hex(Sha256(Blob)) = ArchiveHash, Id + ' fixture hash');
  Password := RawHex(H); SavedPassword := RawHex(H);
  Got := 'caller sentinel'; Raised := False; Created := False;
  try
    R := TZipReader.Create(Blob); Created := True;
    Independent := TZipReader.Create(IndependentBlob);
    SavedEntry := Independent.Entry(0);
    if (WantStage < 0) or (WantStage >= Ord(zesPasswordRequired)) then
      SavedRaw := Independent.Raw(0);
    R.MaxEntrySize := Limit;
    if HavePassword then Got := R.Extract(0, Password) else Got := R.Extract(0);
  except
    on Err: EZipError do begin
      Raised := True;
      Check(WantStage >= 0, Id + ' unexpected exception: ' + Err.Message);
      Check(Ord(Err.Stage) = WantStage, Id + ' stage ' + IntToStr(Ord(Err.Stage)));
      Check(Got = 'caller sentinel', Id + ' exception assigned caller value');
      { Every corpus row has a complete one-entry central directory.
        A physical-extent error may be raised during Create with that
        entry already known, so the exact index is still zero. }
      Check(Err.EntryIndex = 0, Id + ' entry index');
    end;
  end;
  Check(Raised = (WantStage >= 0), Id + ' success/refusal');
  Check(Blob = IndependentBlob, Id + ' input changed');
  Check(Password = SavedPassword, Id + ' password changed');
  if Created then begin
    Check(SameEntry(R.Entry(0), SavedEntry), Id + ' metadata changed');
    if (WantStage < 0) or (WantStage >= Ord(zesPasswordRequired)) then
      Check(R.Raw(0) = SavedRaw, Id + ' raw changed');
  end;
  if WantStage >= 0 then Exit;
  Check(Hex(Sha256(Got)) = WantHash, Id + ' output bytes');
  if Id = 'a1-3-m0-d0' then begin
    AesBlob := Blob; AesPassword := Password; AesHash := WantHash;
  end;
  if Id = 'password-legacy-raw' then begin
    LegacyBlob := Blob; LegacyPassword := Password; LegacyHash := WantHash;
  end;
  E := R.Entry(0); RawBytes := R.Raw(0);
  W := TZipWriter.Create; W.AddRaw(E, RawBytes); Repacked := W.Finish;
  CopyReader := TZipReader.Create(Repacked);
  Check(CopyReader.Raw(0) = RawBytes, Id + ' copied raw');
  Check(SameEntry(CopyReader.Entry(0), E), Id + ' copied metadata');
  if HavePassword then Check(CopyReader.Extract(0, Password) = Got, Id + ' copied content')
  else Check(CopyReader.Extract(0) = Got, Id + ' copied content');
  if (E.Flags and 1) <> 0 then begin
    BeforeHash := Hex(Sha256(W.Finish)); ReplaceRaised := False;
    try W.Replace(E, 'replacement must not be written');
    except on Err: EZipError do begin
      ReplaceRaised := True;
      Check(Err.Stage = zesWriter, Id + ' replace stage');
    end; end;
    Check(ReplaceRaised, Id + ' encrypted replace accepted');
    Check(Hex(Sha256(W.Finish)) = BeforeHash, Id + ' failed replace changed writer');
  end;
end;

procedure RefuseSharedOffset(const Blob, Password: string);
var R: TZipReader; Got: string; Raised: Boolean;
begin
  Got := 'caller sentinel'; Raised := False;
  try
    R := TZipReader.Create(Blob); Got := R.Extract(1, Password);
  except on Err: EZipError do begin
    Raised := True; Check(Err.Stage = zesStructure, 'shared physical offset stage');
    Check(Err.EntryIndex = 0, 'first shared physical entry index');
    Check(Got = 'caller sentinel', 'shared physical offset returned plaintext');
  end; end;
  Check(Raised, 'shared physical offset accepted');
end;

procedure ExtractInRoutine(R: TZipReader; I: Integer; const Password, WantHash: string);
var Plain, Missing: string; Refused: Boolean;
begin
  Plain := R.Extract(I, Password);
  Sleep(1);
  GcCollect;
  Missing := 'caller sentinel';
  Refused := False;
  try
    Missing := R.Extract(I);
  except
    on Err: EZipError do
    begin
      Check(Err.Stage = zesPasswordRequired, 'routine password stage');
      Check(Err.EntryIndex = I, 'routine entry index');
      Refused := True;
    end;
  end;
  Check(Refused and (Missing = 'caller sentinel'), 'routine retained a password');
  Check(Hex(Sha256(Plain)) = WantHash, 'routine plaintext through GC');
  Check(R.Extract(I, Password) = Plain, 'routine retry');
  Extractors.Done;
end;

procedure MixedEntries;
var A, B, R: TZipReader; W: TZipWriter; Bad: string; EndAt, DirAt, Second: Integer;
begin
  Check((AesBlob <> '') and (LegacyBlob <> ''), 'missing mixed fixtures');
  Check(AesPassword <> LegacyPassword, 'mixed passwords not distinct');
  A := TZipReader.Create(AesBlob); B := TZipReader.Create(LegacyBlob);
  W := TZipWriter.Create;
  W.AddRaw(A.Entry(0), A.Raw(0)); W.AddRaw(B.Entry(0), B.Raw(0));
  W.Add('plain.txt', 'plain'); R := TZipReader.Create(W.Finish);
  Check((R.Count = 3) and (R.Find('a.txt') = 0), 'mixed duplicate-name order');
  Check(Hex(Sha256(R.Extract(0, AesPassword))) = AesHash, 'mixed AES');
  Check(Hex(Sha256(R.Extract(1, LegacyPassword))) = LegacyHash, 'mixed legacy');
  Check(R.Extract(2) = 'plain', 'mixed plain omitted');
  Check(R.Extract(2, LegacyPassword) = 'plain', 'mixed plain explicit');
  Check((R.Raw(0) = A.Raw(0)) and (R.Raw(1) = B.Raw(0)), 'mixed raw');
  Extractors.Add(2);
  pas ExtractInRoutine(R, 0, AesPassword, AesHash);
  pas ExtractInRoutine(R, 1, LegacyPassword, LegacyHash);
  Extractors.Wait;
  { Two identical records are valid when each owns distinct physical bytes. }
  W := TZipWriter.Create; W.AddRaw(A.Entry(0), A.Raw(0)); W.AddRaw(A.Entry(0), A.Raw(0));
  R := TZipReader.Create(W.Finish);
  Check((R.Extract(0, AesPassword) = R.Extract(1, AesPassword)) and
    (R.Entry(0).HeaderOffset <> R.Entry(1).HeaderOffset), 'distinct duplicate entries');
  { Point only the second directory record at the first physical header. }
  Bad := W.Finish; EndAt := Length(Bad) - 22;
  DirAt := LoadLE32(@Bad[EndAt + 17]);
  Second := DirAt + 46 + Length(A.Entry(0).Name) + Length(A.Entry(0).Extra) + Length(A.Entry(0).Comment);
  StoreLE32(@Bad[Second + 43], 0);
  RefuseSharedOffset(Bad, AesPassword);
end;

var Directory, Corpus, Line: string; P, Last, Count: Integer;
begin
  if ParamCount > 0 then Directory := ParamStr(1) else Directory := 'testdata/zip-password';
  Check(ReadFile(JoinPath(Directory, 'cases.tsv'), Corpus), 'missing cases.tsv');
  P := 1; Count := 0;
  while P <= Length(Corpus) do begin
    Last := P;
    while (Last <= Length(Corpus)) and (Corpus[Last] <> #10) do Inc(Last);
    Line := Copy(Corpus, P, Last - P); P := Last + 1;
    if Line <> '' then begin CaseRow(Directory, Line); Inc(Count); end;
  end;
  Check(Count = 163, 'unexpected corpus size');
  PrimitiveContracts;
  MixedEntries;
  WriteLn('ok ZIP password contracts ', Count);
end.
