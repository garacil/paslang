program anonrec;

{ Records with no name where a type goes (1.0.116): a unit's variables,
  locals, fields, array elements and a dynamic array of them, holding
  strings the collector must keep through a collection. }

uses anonrec, paslib;

type
  TBox = record
    Tag: Integer;
    Inner: record A, B: Int16; S: string end;
  end;

var
  box: TBox;
  many: array of record K: Integer; S: string end;
  i: Integer;
  sum: Integer;
  junk: string;

procedure Local;
var
  r: record C: Char; D: Double end;
begin
  r.C := 'z';
  r.D := 2.5;
  WriteLn(r.C, ' ', r.D, ' ', SizeOf(r));
end;

begin
  Place(3, -4, 'origin');
  WriteLn(Pt.X, ' ', Pt.Y, ' ', Pt.Name, ' ', SizeOf(Pt));
  for i := 0 to 2 do
    Write(Grid[i].B, ':', Grid[i].W, ' ');
  WriteLn(SizeOf(Grid));
  box.Tag := 7;
  box.Inner.A := -1;
  box.Inner.B := 300;
  box.Inner.S := 'in' + 'side';
  WriteLn(box.Tag, ' ', box.Inner.A, ' ', box.Inner.B, ' ', box.Inner.S, ' ', SizeOf(box));
  SetLength(many, 1000);
  for i := 0 to High(many) do
  begin
    many[i].K := i;
    many[i].S := 'n' + IntToStr(i);
  end;
  { Garbage enough for collections while the strings live only in the
    records. }
  for i := 1 to 2000000 do
    junk := 'j' + IntToStr(i);
  sum := 0;
  for i := 0 to High(many) do
    if many[i].S = 'n' + IntToStr(many[i].K) then
      sum := sum + 1;
  WriteLn(sum, ' ', many[999].S);
  Local;
end.

