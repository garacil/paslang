{ Arrays as Free Pascal declares them (P161): an ordinal type as the
  index (Boolean, an enumeration, Char, Byte, a subrange type), a range
  of an enumeration or of Char, several indexes that make an array of
  arrays, indexed m[i, j] as m[i][j], in variables, typed constants and
  parameters; Low and High of the index's type drive a for loop. The
  output is Free Pascal's. }
program arrindex;

{$mode objfpc}{$H+}

type
  TColor = (Red, Green, Blue);
  TDigit = 0..9;
  TDayTable = array[1..12] of Word;
  TMatrix = array[1..2, 1..3] of Int64;
  TCube = array[Boolean, TColor, 'a'..'b'] of Byte;

const
  MonthDays: array[Boolean] of TDayTable =
    ((31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31),
     (31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31));
  Names: array[TColor] of string = ('red', 'green', 'blue');
  Grid: array[1..2, 1..2] of Integer = ((1, 2), (3, 4));

var
  byColor: array[TColor] of Integer;
  byChar: array[Char] of Byte;
  byByte: array[Byte] of Word;
  byDigit: array[TDigit] of Integer;
  byRange: array[Green..Blue] of Integer;
  byLetter: array['a'..'e'] of Integer;
  m: TMatrix;
  cube: TCube;
  c: TColor;
  ch: Char;
  b: Boolean;
  i, j: Integer;

function Sum(const A: TMatrix): Integer;
var
  r, k: Integer;
begin
  Result := 0;
  for r := 1 to 2 do
    for k := 1 to 3 do
      Result := Result + A[r, k];
end;

begin
  WriteLn(MonthDays[True, 2], ' ', MonthDays[False][2], ' ', SizeOf(MonthDays));
  for c := Low(Names) to High(Names) do
    Write(Names[c], ' ');
  WriteLn(Ord(High(byColor)), ' ', Ord(Low(byRange)), ' ', Ord(High(byRange)));
  for c := Red to Blue do
    byColor[c] := 10 * (Ord(c) + 1);
  WriteLn(byColor[Green], ' ', byColor[Blue], ' ', Length(byColor));
  byChar['z'] := 26;
  byByte[255] := 65535;
  byDigit[9] := 99;
  byRange[Blue] := 7;
  for ch := Low(byLetter) to High(byLetter) do
    byLetter[ch] := Ord(ch) - Ord('a');
  WriteLn(byChar['z'], ' ', byByte[High(byByte)], ' ', byDigit[High(byDigit)], ' ', byRange[Blue],
    ' ', byLetter['e'], ' ', SizeOf(byChar), ' ', SizeOf(byByte));
  for i := 1 to 2 do
    for j := 1 to 3 do
      m[i, j] := 10 * i + j;
  WriteLn(m[2, 3], ' ', m[1][2], ' ', Sum(m), ' ', SizeOf(m), ' ', Grid[2, 1], ' ', Grid[1][2]);
  for b := False to True do
    for c := Red to Blue do
    begin
      cube[b, c, 'a'] := Byte(Ord(b) * 10 + Ord(c));
      cube[b][c]['b'] := Byte(100 + Ord(c));
    end;
  WriteLn(cube[True, Blue, 'a'], ' ', cube[False][Green]['b'], ' ', SizeOf(cube));
end.

