{ P203: the side of paslang that scripts/check_json.py holds to Go's
  encoding/json/v2 (testdata/json/oracle.go), line for line in the
  same form: each line of the input a document in hex, "-" the empty
  one; the mode p, i or c writes "ok" and the document compact, a value
  a line or in RFC 8785's form (past 200 bytes, and a value a line, its
  SHA-256), or "err",
  the byte offset, the JSON Pointer in hex (past 100 bytes its
  SHA-256) and the reason. The mode P
  parses each document twice, with the index and a byte at a time
  (PasJsonParsePlain), and writes "same" when both give the same error
  or the same document, byte for byte. The mode D reads each with the
  reader a typed decode reads text through, a token at a time with no
  document (P280), into a json, and writes "same" when it gives the
  parse's error, its place, pointer, reason and kind, or its value. }
program jsoncheck;

uses sysutils;

function FromHex(const H: string): string;
var
  i: Integer;
begin
  SetLength(Result, Length(H) div 2);
  for i := 1 to Length(H) div 2 do
    Result[i] := Chr(StrToInt('$' + Copy(H, 2 * i - 1, 2)));
end;

function ToHex(const S: string): string;
var
  i: Integer;
begin
  if S = '' then
  begin
    Result := '-';
    Exit;
  end;
  if Length(S) > 100 then
  begin
    Result := 'sha256:' + LowerCase(Hex(Sha256(S)));
    Exit;
  end;
  Result := '';
  for i := 1 to Length(S) do
    Result := Result + LowerCase(IntToHex(Ord(S[i]), 2));
end;

function Shown(const T: string; Lines: Boolean): string;
begin
  if Lines or (Length(T) > 200) then
    Result := 'sha256 ' + LowerCase(Hex(Sha256(T)))
  else
    Result := T;
end;

var
  mode, line, s: string;
  j, k: json;
  e, e2: EJsonError;
  o: TJsonOptions;

begin
  mode := ParamStr(1);
  o := JsonDefaults;
  if mode = 'i' then
    o := JsonPretty
  else if mode = 'c' then
    o := JsonCanonical;
  while True do
  begin
    ReadLn(line);
    if line = '' then
      Break;
    if line = '-' then
      s := ''
    else
      s := FromHex(line);
    if mode = 'P' then
    begin
      j := nil;
      e := nil;
      if not TryJsonParse(s, j, e) then
        j := nil;
      k := PasJsonParsePlain(s, JsonDefaults, e2);
      if (e <> nil) and (e2 <> nil) then
      begin
        if (e.Offset = e2.Offset) and (e.Path = e2.Path) and (e.Reason = e2.Reason) and
          (e.Kind = e2.Kind) then
          WriteLn('same')
        else
          WriteLn('DIFF index: ', e.Offset, ' ', e.Reason, ' / plain: ', e2.Offset, ' ', e2.Reason);
      end
      else if (e = nil) and (e2 = nil) then
      begin
        if PasJsonImage(j) = PasJsonImage(k) then
          WriteLn('same')
        else
          WriteLn('DIFF documents');
      end
      else
        WriteLn('DIFF one fails');
      Continue;
    end;
    if mode = 'D' then
    begin
      j := nil;
      e := nil;
      if not TryJsonParse(s, j, e) then
        j := nil;
      k := nil;
      e2 := nil;
      if not TryJsonDecode(s, k, e2) then
        k := nil;
      if (e <> nil) and (e2 <> nil) then
      begin
        if (e.Offset = e2.Offset) and (e.Path = e2.Path) and (e.Reason = e2.Reason) and
          (e.Kind = e2.Kind) and (e.Message = e2.Message) then
          WriteLn('same')
        else
          WriteLn('DIFF parse: ', e.Message, ' / decode: ', e2.Message);
      end
      else if (e = nil) and (e2 = nil) then
      begin
        if JsonEncode(j) = JsonEncode(k) then
          WriteLn('same')
        else
          WriteLn('DIFF values');
      end
      else if e <> nil then
        WriteLn('DIFF the decode takes it: ', e.Message)
      else
        WriteLn('DIFF the decode refuses it: ', e2.Message);
      Continue;
    end;
    if TryJsonParse(s, j, e) then
      WriteLn('ok ', Shown(JsonEncode(j, o), mode = 'i'))
    else
      WriteLn('err ', e.Offset, ' ', ToHex(e.Path), ' ', e.Reason);
  end;
end.
