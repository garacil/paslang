{ P203: the errors of the json type, as EJsonError: a text that is no
  I-JSON (each with its kind, its place, its line and column, its JSON
  Pointer and Go's reason), the limits of TJsonOptions, and the reads of
  a missing member, of a value of another kind, of a place past the
  end and of a number past its range. TryJsonParse gives the same
  error without raising. }
program json2;

procedure Bad(const S: string);
var
  j: json;
  e: EJsonError;
begin
  if TryJsonParse(S, j, e) then
    WriteLn('accepted ', j)
  else
  begin
    if Length(e.Path) <= 60 then
      WriteLn(Ord(e.Kind), ' ', e.Offset, ' ', e.Line, ':', e.Column, ' [', e.Path, '] ', e.Reason)
    else
      WriteLn(Ord(e.Kind), ' ', e.Offset, ' ', e.Line, ':', e.Column, ' [', Length(e.Path),
        ' bytes] ', e.Reason);
    WriteLn('  ', e.Message);
  end;
end;

procedure Probe(const What: string; J: json; Step: Integer);
begin
  try
    case Step of
      0: WriteLn(What, ' ', J['missing']);
      1: WriteLn(What, ' ', J[7]);
      2: WriteLn(What, ' ', J.AsInteger);
      3: WriteLn(What, ' ', J.AsString);
      4: WriteLn(What, ' ', J.AsBoolean);
      5: WriteLn(What, ' ', J.AsFloat);
      6: WriteLn(What, ' ', Length(J));
      7: WriteLn(What, ' ', J.At('/a/9'));
      8: WriteLn(What, ' ', J.At('a'));
      9: WriteLn(What, ' ', J.AsCurrency);
      10: WriteLn(What, ' ', J.AsQuad);
    end;
  except
    on e: EJsonError do
      WriteLn(What, ' -> ', Ord(e.Kind), ' [', e.Path, '] ', e.Message);
  end;
end;

var
  d: json;
  o: TJsonOptions;
  e: EJsonError;
  i: Integer;
  deep: string;

begin
  Bad('');
  Bad('[1,]');
  Bad('{"a":1,}');
  Bad('{"a":1 "b":2}');
  Bad('[01]');
  Bad('{"a":[1,{"b":tru}]}');
  Bad('{"a":1,"a":2}');
  Bad('{"x":{"k~/":1,"k~/":2}}');
  Bad('["\ud800"]');
  Bad('["\uFFFE"]');
  Bad('["a' + #239#191#191 + '"]');
  Bad('["' + #255 + '"]');
  Bad('["ab');
  Bad('[1.]');
  Bad('-');
  Bad('{"a":' + #10 + '  [1,' + #10 + '   x]}');
  Bad('NaN');
  Bad('[1]  2');
  Bad(#239#187#191 + '1');
  Bad('"\q"');
  Bad('"a' + #9 + 'b"');

  { the limits }
  deep := '';
  for i := 1 to 10001 do
    deep := deep + '[';
  Bad(deep);
  o := JsonDefaults;
  o.MaxDepth := 3;
  if not TryJsonParse('[[[1]]]', d, e, o) then
    WriteLn('depth 3: ', e.Message)
  else
    WriteLn('depth 3 takes ', d);
  if not TryJsonParse('[[[[1]]]]', d, e, o) then
    WriteLn('depth 3: ', e.Message);
  o := JsonDefaults;
  o.MaxBytes := 8;
  if not TryJsonParse('[1,2,3,4,5]', d, e, o) then
    WriteLn('8 bytes: ', Ord(e.Kind), ' ', e.Message);
  WriteLn('8 bytes take ', JsonParse('[1,2,3]', o));

  { JsonParse raises }
  try
    d := JsonParse('{"a":}');
    WriteLn('no error');
  except
    on e: EJsonError do
      WriteLn('raised: ', e.Message);
  end;

  { the reads }
  d := JsonParse('{"a":[1,2,3],"s":"x","n":1.5,"i":12345678901234567890,"t":true,' +
    '"m":1e400,"c":0.12345,"q":1e5000,"z":null}');
  Probe('missing', d, 0);
  Probe('object[7]', d, 1);
  Probe('a[7]', d['a'], 1);
  Probe('a.AsInteger', d['a'], 2);
  Probe('n.AsInteger', d['n'], 2);
  Probe('i.AsInteger', d['i'], 2);
  Probe('n.AsString', d['n'], 3);
  Probe('s.AsBoolean', d['s'], 4);
  Probe('m.AsFloat', d['m'], 5);
  Probe('s length', d['s'], 6);
  Probe('z length', d['z'], 6);
  Probe('at /a/9', d, 7);
  Probe('at a', d, 8);
  Probe('c.AsCurrency', d['c'], 9);
  Probe('n.AsCurrency', d['n'], 9);
  Probe('q.AsQuad', d['q'], 10);
  Probe('z.AsString', d['z'], 3);
  Probe('nil[0]', nil, 1);
  Probe('a[0][0]', d['a'][0], 1);
end.
