{ P334: a closure or nested routine that calls nothing has no frame.
  FlatAdd reads its outer routine's parameter, FlatLocal keeps its own
  parameters and local in registers beside the outer ones it reads,
  FlatBump writes a word, an Int32 and a Byte of its outer routine,
  FlatDeep reads two levels out, and Adder's closure reads the number
  it captured: none has a frame, the static link kept in r10 or x27;
  Mid calls and keeps its frame. The answers are worked out by hand in
  the comments; scripts/check_nestflat.py reads the forms and make
  check's debugger reads FlatLocal's variables. }
program nestflat;

type
  TFn = function(K: Integer): Integer;

var
  fns: array[0..3] of TFn;
  i, t: Integer;

function Adder(N: Integer): TFn;
begin
  Result := function(K: Integer): Integer
  begin
    Result := K + N;
  end;
end;

function Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

function Outer(N: Integer): Integer;
var
  base: Integer;
  small: Int32;
  count: Byte;

  function FlatAdd(K: Integer): Integer;
  begin
    Result := K + N;
  end;

  function FlatLocal(A, B: Integer): Integer;
  var
    m: Integer;
  begin
    m := A * B;
    if m > base then
      m := m - base;
    Result := m + small;
  end;

  procedure FlatBump(K: Integer);
  begin
    base := base + K;
    small := small - 1;
    count := count + 1;
  end;

  function Mid(K: Integer): Integer;

    function FlatDeep(Q: Integer): Integer;
    begin
      Result := Q * base + small + N;
    end;

  begin
    Result := FlatDeep(K) + Twice(K);
  end;

begin
  { base 16, small 1 and count 2 after the bumps; FlatAdd(7) = 13;
    FlatLocal(4, 5): 20 - 16 + 1 = 5; Mid(3): 3 * 16 + 1 + 6 + 6 = 61;
    13 + 5 + 61 + 2 = 81 }
  base := 10;
  small := 3;
  count := 0;
  FlatBump(5);
  FlatBump(1);
  Result := FlatAdd(7) + FlatLocal(4, 5) + Mid(3) + count;
end;

begin
  WriteLn(Outer(6));
  for i := 0 to 3 do
    fns[i] := Adder(i * 10);
  { the sum of j + 10 * (j and 3) for j = 1 to 100: 5050 + 10 * 150 =
    6550 }
  t := 0;
  for i := 1 to 100 do
    t := t + fns[i and 3](i);
  WriteLn(t);
end.
