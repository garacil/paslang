{ P76: the clock. Two clocks, and they are not the same one: the wall
  clock says what time it is, the monotonic clock only ever goes
  forward and is the one to measure with. A moment turns into a date
  and back again, in UTC, without a timezone file. }
program timeunit;

uses
  pastime;

var
  t0, t1, el: Int64;
  d: TDate;
  y, m, dd, bad, n: Integer;
  u: Int64;

begin
  { The monotonic clock measures a Sleep. It cannot be exact, so what
    is asked of it is that it went forward by at least what we slept
    and not by something wild. }
  t0 := Monotonic;
  Sleep(20);
  el := Since(t0);
  WriteLn(el >= 20 * NsPerMs, ' ', el < 2 * NsPerSec, ' ',
    Millis(el) >= 20, ' ', Micros(el) >= 20000, ' ', SecsOf(el) = 0);

  { The wall clock is a different clock: it says what year it is. }
  t1 := NowUnix;
  WriteLn(t1 > 1750000000, ' ', NowNanos div NsPerSec >= t1, ' ',
    UnixToDate(t1).Year >= 2026);

  { A moment everybody knows: the epoch, and the second before it. }
  WriteLn(StampStr(0), ' ', WeekdayName(UnixToDate(0).Wday));
  WriteLn(StampStr(-1), ' ', StampStr(86399), ' ', StampStr(86400));

  { Known stamps, taken apart. }
  d := UnixToDate(1000000000);
  WriteLn(StampOf(d), ' ', WeekdayName(d.Wday), ' ', MonthName(d.Month),
    ' ', d.Yday);
  d := UnixToDate(1769999999);
  WriteLn(StampOf(d), ' ', d.Year, ' ', d.Month, ' ', d.Day);

  { The leap day is there, and the year before it is not. }
  WriteLn(IsLeap(2024), ' ', IsLeap(2025), ' ', IsLeap(2000), ' ',
    IsLeap(1900), ' ', DaysInMonth(2024, 2), ' ', DaysInMonth(2025, 2));
  WriteLn(DateStr(DateToUnix(2024, 2, 29, 12, 0, 0)), ' ',
    TimeStr(DateToUnix(2024, 2, 29, 23, 59, 58)));

  { A date and a moment round-trip, over a hundred years and every
    month of them. }
  bad := 0;
  n := 0;
  for y := 1950 to 2050 do
    for m := 1 to 12 do
      for dd := 1 to DaysInMonth(y, m) do
      begin
        u := DateToUnix(y, m, dd, 13, 45, 30);
        d := UnixToDate(u);
        n := n + 1;
        if (d.Year <> y) or (d.Month <> m) or (d.Day <> dd) or
          (d.Hour <> 13) or (d.Minute <> 45) or (d.Second <> 30) then
          bad := bad + 1;
      end;
  WriteLn(n, ' ', bad);

  { The day of the week walks on by one each day, and the day of the
    year starts again at 1. }
  WriteLn(UnixToDate(DateToUnix(2026, 9, 25, 0, 0, 0)).Wday, ' ',
    UnixToDate(DateToUnix(2026, 9, 26, 0, 0, 0)).Wday, ' ',
    UnixToDate(DateToUnix(2026, 1, 1, 0, 0, 0)).Yday, ' ',
    UnixToDate(DateToUnix(2026, 12, 31, 0, 0, 0)).Yday);

  { A length of time, said the way a person says it. }
  WriteLn(Duration(7), ' ', Duration(1500), ' ', Duration(2500000), ' ',
    Duration(1500000000), ' ', Duration(90 * Int64(NsPerSec)), ' ',
    Duration(-2500000));
end.

