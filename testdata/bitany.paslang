program bitany;

{ The bit words on anything (P105, 1.0.118): reals, a Boolean, a pointer,
  an enumeration and a set as their bits; the bytes of a record, a static
  array, a Quad and an object's instance; the characters of a string,
  made its own before a write; the elements of a slice; raw memory at an
  untyped Pointer; and the atomic ones, from many routines at once. }

type
  TColor = (cRed, cGreen, cBlue, cGold);
  TRec = record
    A: Word;
    B: Byte;
    C: Int32;
  end;
  TBox = class
    X: Integer;
  end;

var
  d: Double;
  sg: Single;
  t: Boolean;
  p: Pointer;
  col: TColor;
  st: set of 0..63;
  r: TRec;
  a: array[0..3] of Byte;
  q: Quad;
  s, s2: string;
  da: array of Word;
  box: TBox;
  i, n, k: Integer;
  shared: array[0..1] of Byte;
  done: chan of Integer;

procedure Flip(bit: Integer);
var
  j: Integer;
begin
  for j := 1 to 2000 do
  begin
    AtomicSetBit(shared, bit);
    AtomicClearBit(shared, bit);
  end;
  AtomicSetBit(shared, bit);
  Send(done, bit);
end;

begin
  d := -1.5;
  WriteLn(IsBitSet(d, 63), ' ', PopCount(d), ' ', LeadingZeros(d), ' ', TrailingZeros(d), ' ',
    GetBits(d, 52, 11));
  d := 1.0;
  SetBit(d, 63, 1);
  WriteLn(d, ' ', ByteSwap(ByteSwap(d)), ' ', PopCount(1.0), ' ', TrailingZeros(1.0));
  ToggleBit(d, 52);
  WriteLn(d);
  sg := 1.0;
  SetBit(sg, 31, True);
  WriteLn(sg, ' ', GetBits(sg, 23, 8), ' ', IsBitSet(sg, 31));
  t := True;
  WriteLn(PopCount(t), ' ', IsBitSet(t, 0));
  SetBit(t, 0, 0);
  WriteLn(t);
  p := @r;
  SetBit(p, 0, 1);
  WriteLn(IsBitSet(p, 0));
  ToggleBit(p, 0);
  WriteLn(p = Pointer(@r));
  col := cGold;
  WriteLn(GetBits(col, 0, 2), ' ', PopCount(col));
  st := [1, 3, 5, 63];
  WriteLn(PopCount(st), ' ', LeadingZeros(st), ' ', TrailingZeros(st));
  r.A := $8001;
  r.B := 0;
  r.C := -2;
  SetBit(r, 16, 1);
  WriteLn(r.B, ' ', IsBitSet(r, 15), ' ', IsBitSet(r, 1), ' ', PopCount(r), ' ',
    LeadingZeros(r), ' ', TrailingZeros(r));
  WriteLn(GetBits(r, 12, 8), ' ', GetBits(r, 32, 32), ' ', GetBits(r, 0, 64));
  n := 20;
  SetBits(r, n, 12, $ABC);
  ToggleBit(r, n + 40);
  WriteLn(r.A, ' ', r.B, ' ', r.C, ' ', GetBits(r, n, 12));
  k := 0;
  for n := 0 to 63 do
    k := k + IsBitSet(r, n);
  WriteLn(k, ' ', PopCount(r));
  a[0] := 0;
  a[1] := 0;
  a[2] := 0;
  a[3] := $F0;
  SetBit(a, 17, 1);
  WriteLn(a[2], ' ', PopCount(a), ' ', LeadingZeros(a), ' ', TrailingZeros(a));
  q := 1;
  WriteLn(IsBitSet(q, 127), ' ', PopCount(q), ' ', GetBits(q, 112, 15));
  SetBit(q, 127, 1);
  WriteLn(q:0:1);
  s := 'AB';
  s2 := s;
  WriteLn(IsBitSet(s, 0), ' ', PopCount(s), ' ', GetBits(s, 4, 8), ' ', LeadingZeros(s));
  SetBit(s, 1, 1);
  ToggleBit(s, 13);
  WriteLn(s, ' ', s2);
  n := 0;
  SetBits(s, n + 8, 8, Ord('z'));
  WriteLn(s, ' ', s2, ' ', PopCount(s2));
  SetLength(da, 2);
  da[0] := 1;
  da[1] := $8000;
  WriteLn(PopCount(da), ' ', TrailingZeros(da), ' ', LeadingZeros(da), ' ', IsBitSet(da, 31));
  SetBit(da, 20, 1);
  WriteLn(da[1], ' ', AtomicSetBit(da, 3), ' ', da[0], ' ', AtomicClearBit(da, 0), ' ', da[0]);
  box := TBox.Create;
  box.X := 6;
  WriteLn(IsBitSet(box, 64 + 1), ' ', IsBitSet(box, 64));
  SetBit(box, 64, 1);
  WriteLn(box.X);
  p := @r;
  WriteLn(IsBitSet(p^, 16), ' ', GetBits(p^, 0, 16));
  SetBit(p^, 17, 1);
  WriteLn(r.B);
  i := 0;
  WriteLn(AtomicSetBit(i, 5), ' ', AtomicSetBit(i, 5), ' ', i, ' ', AtomicClearBit(i, 5), ' ', i);
  done := MakeChan(8);
  shared[0] := 0;
  shared[1] := 0;
  for n := 0 to 7 do
    pas Flip(n);
  k := 0;
  for n := 0 to 7 do
    k := k + Recv(done);
  WriteLn(shared[0], ' ', shared[1], ' ', k);
end.
