{ Deadlines on thousands of waits at once (P115, 1.1.1): a wait with a
  deadline is a timer of the runtime now, in a heap with the sleepers,
  not a timerfd per wait. 2000 routines wait 100 ms on sockets that stay
  quiet and must all come back empty, not before their time; 2000 more
  wait on sockets that are written first and must all get their byte,
  their timers taken off the heap; then everyone sleeps once, which
  finds a heap with nothing stale in it. }
program deadlines;

uses pasnet;

const
  N = 2000;

var
  early, empty, got, woke: Integer;
  done: WaitGroup;
  l, port: Integer;

procedure Quiet(Fd: Integer);
var
  t0: Integer;
  s: string;
begin
  t0 := Nanotime;
  s := TcpReadDeadline(Fd, 16, 100);
  if s = '' then
    AtomicAdd(@empty, 1);
  if Nanotime - t0 < 90000000 then
    AtomicAdd(@early, 1);
  done.Done;
end;

procedure Answered(Fd: Integer);
var
  s: string;
begin
  s := TcpReadDeadline(Fd, 16, 5000);
  if s = 'x' then
    AtomicAdd(@got, 1);
  Sleep(1);
  AtomicAdd(@woke, 1);
  done.Done;
end;

var
  i: Integer;
  cs, ss: array of Integer;
begin
  RaiseFdLimit;
  l := TcpListen(0);
  port := TcpPort(l);
  SetLength(cs, 2 * N);
  SetLength(ss, 2 * N);
  for i := 0 to 2 * N - 1 do
  begin
    cs[i] := TcpConnectTo('127.0.0.1', port);
    ss[i] := TcpAccept(l);
  end;
  done.Add(N);
  for i := 0 to N - 1 do
    pas Quiet(cs[i]);
  done.Wait;
  WriteLn(N, ' quiet waits: ', empty, ' came back empty, ', early, ' before their time');
  done.Add(N);
  for i := N to 2 * N - 1 do
    pas Answered(cs[i]);
  Sleep(20);
  for i := N to 2 * N - 1 do
    TcpWrite(ss[i], 'x');
  done.Wait;
  WriteLn(N, ' answered waits: ', got, ' got their byte, ', woke, ' slept after');
  for i := 0 to 2 * N - 1 do
  begin
    TcpClose(cs[i]);
    TcpClose(ss[i]);
  end;
  TcpClose(l);
end.

