program tcppark;

uses pasnet;

procedure Serve(L: Integer);
var
  c: Integer;
  got, part: string;
begin
  c := TcpAccept(L);
  if c < 0 then
    Halt(1);
  got := '';
  while Length(got) < 4 do
  begin
    part := TcpRead(c, 64);
    if Length(part) = 0 then
      Halt(1);
    got := got + part;
  end;
  if TcpWrite(c, 'pong') < 0 then
    Halt(1);
  TcpClose(c);
end;

var
  l, c: Integer;
  got, part: string;
begin
  l := TcpListen(0);
  if l < 0 then
    Halt(1);
  pas Serve(l);
  c := TcpConnect('127.0.0.1', TcpPort(l));
  if c < 0 then
    Halt(1);
  if TcpWrite(c, 'ping') < 0 then
    Halt(1);
  got := '';
  while Length(got) < 4 do
  begin
    part := TcpRead(c, 64);
    if Length(part) = 0 then
      Halt(1);
    got := got + part;
  end;
  WriteLn(got);
  TcpClose(c);
  TcpClose(l);
end.
