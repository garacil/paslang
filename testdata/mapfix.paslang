{ 1.0.140: the map's key is converted as a call's argument is, for k, v
  checks its variables, the map of a for loop is worked out once, Delete
  and Clear zero the slots, m[k].X reads zero and is written, m[k] += 1
  and Inc(m[k]) work, and a map type is one type across a unit. }
program mapfix;

type
  TPoint = record
    X, Y: Integer;
  end;
  TColor = (red, green, blue);
  TGrid = array[0..2] of Integer;

var
  ms: map[string] of Integer;
  mb: map[Byte] of Integer;
  mc: map[Char] of Integer;
  me: map[TColor] of string;
  mp: map[string] of TPoint;
  mg: map[Integer] of TGrid;
  mr: map[string] of Double;
  mstr: map[Integer] of string;
  ma: map[Integer] of array of Integer;
  mm: map[string] of Integer;
  c: Char;
  b: Byte;
  i, n, total, calls: Integer;
  ik: Integer;
  bk: Byte;
  s, k: string;
  col: TColor;
  p: TPoint;
  d: Double;
  a: array of Integer;
  b0, b1, b2: Integer;

function Maps: map[string] of Integer;
begin
  Inc(calls);
  Result := mm;
end;

function Key: string;
begin
  Inc(calls);
  Result := 'z';
end;

procedure Bump(var V: Integer);
begin
  V := V + 100;
end;

procedure Move1(var P: TPoint);
begin
  P.X := P.X + 1;
end;

begin
  { 1. the key converted to K }
  New(ms);
  c := 'a';
  ms['a'] := 5;
  WriteLn(ms[c], ' ', c in ms, ' ', TryGet(ms, c, i), ' ', i);
  ms[c] := 6;
  WriteLn(ms['a'], ' ', Length(ms));
  Delete(ms, c);
  WriteLn(Length(ms), ' ', c in ms);
  New(mb);
  mb[3] := 7;
  b := 3;
  i := 3;
  WriteLn(mb[b], ' ', mb[Byte(i)], ' ', mb[3], ' ', 255 in mb);
  New(mc);
  mc['x'] := 1;
  c := 'x';
  WriteLn(mc[c], ' ', mc['x'], ' ', 'y' in mc);
  New(me);
  me[green] := 'g';
  col := green;
  WriteLn(me[col], ' ', me[red] = '', ' ', blue in me);

  { 2. for k, v with the right types; a wider k over a Byte key }
  New(mstr);
  mstr[1] := 'one';
  mstr[2] := 'two';
  n := 0;
  for ik, s in mstr do
    n := n + ik * Length(s);
  WriteLn(n);
  mb[200] := 300;
  total := 0;
  for bk in mb do
    total := total + bk;
  WriteLn(total);
  total := 0;
  for ik, i in mb do
    total := total + ik + i;
  WriteLn(total);

  { 3. the map expression is worked out once }
  New(mm);
  mm['a'] := 1;
  mm['b'] := 2;
  mm['c'] := 3;
  calls := 0;
  total := 0;
  for k, i in Maps do
    total := total + i;
  WriteLn(total, ' ', calls);
  calls := 0;
  n := 0;
  for k in Maps do
    Inc(n);
  WriteLn(n, ' ', calls);

  { 4. Delete and Clear let the collector free the values }
  New(ma);
  GcCollect;
  b0 := HeapStat(1);
  SetLength(a, 1000000);
  ma[1] := a;
  a := nil;
  GcCollect;
  b1 := HeapStat(1);
  Delete(ma, 1);
  GcCollect;
  b2 := HeapStat(1);
  WriteLn(b1 - b0 > 7000000, ' ', b2 - b0 < 1000000);
  SetLength(a, 1000000);
  ma[2] := a;
  a := nil;
  Clear(ma);
  GcCollect;
  b2 := HeapStat(1);
  WriteLn(b2 - b0 < 1000000, ' ', Length(ma));

  { 5. m[k].X on a missing key reads zero; m[k].X := e inserts }
  New(mp);
  WriteLn(mp['none'].X, ' ', mp['none'].Y, ' ', Length(mp));
  mp['a'].X := 1;
  mp['a'].Y := 2;
  WriteLn(mp['a'].X, ' ', mp['a'].Y, ' ', Length(mp));
  p := mp['a'];
  WriteLn(p.X + p.Y);
  New(mg);
  mg[7][1] := 5;
  WriteLn(mg[7][0], ' ', mg[7][1], ' ', mg[7][2], ' ', mg[8][2]);
  with mp['w'] do
  begin
    X := 10;
    Y := X + 1;
  end;
  WriteLn(mp['w'].X, ' ', mp['w'].Y, ' ', Length(mp));

  { 6. m[k] op= e, Inc and Dec }
  ms['n'] += 1;
  ms['n'] += 2;
  Inc(ms['n']);
  Inc(ms['n'], 10);
  Dec(ms['n']);
  ms['n'] *= 2;
  WriteLn(ms['n']);
  mp['a'].X += 5;
  Inc(mp['a'].Y, 3);
  Dec(mp['a'].Y);
  WriteLn(mp['a'].X, ' ', mp['a'].Y);
  calls := 0;
  Maps[Key] += 1;
  Maps[Key] += 1;
  Inc(Maps[Key]);
  WriteLn(mm['z'], ' ', calls);
  New(mr);
  mr['d'] += 1.5;
  mr['d'] *= 2;
  d := mr['d'];
  WriteLn(d);
  mstr[1] += '!';
  WriteLn(mstr[1]);
  b := 4;
  mb[b] += 5;
  Inc(mb[b]);
  WriteLn(mb[4]);
  mg[7][2] += 4;
  Inc(mg[7][0]);
  WriteLn(mg[7][0], ' ', mg[7][2]);
  Bump(ms['n']);
  Bump(ms['fresh']);
  Move1(mp['a']);
  Move1(mp['fresh']);
  WriteLn(ms['n'], ' ', ms['fresh'], ' ', mp['a'].X, ' ', mp['fresh'].X);
  SetLength(ma[3], 4);
  ma[3][2] := 9;
  WriteLn(Length(ma[3]), ' ', ma[3][2]);
end.

