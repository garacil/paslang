program narrowbounds;

{ High and Low of a type are constants of that type (P99, 1.0.91): High(Byte)
  + 1 wraps to 0. Published narrow properties are read and written at
  their width through RTTI, Int8 with its sign. }

type
  TColor = (Red, Green, Blue);
  TDigit = 0..9;
  TTen = array[3..12] of Byte;
  TThing = class
  private
    FB: Byte;
    FS: Int8;
    FW: Word;
    FI: Int32;
    FC: Char;
  published
    property B: Byte read FB write FB;
    property S: Int8 read FS write FS;
    property W: Word read FW write FW;
    property I: Int32 read FI write FI;
    property C: Char read FC write FC;
  end;

var
  t: TThing;
  a: TTen;
begin
  WriteLn(High(Byte), ' ', Low(Int8), ' ', High(Int8), ' ', High(Word), ' ', Low(Int16), ' ',
    High(UInt32), ' ', Low(Int32), ' ', High(Integer), ' ', Low(Integer));
  WriteLn(Ord(High(Char)), ' ', High(Boolean), ' ', Ord(High(TColor)), ' ', High(TDigit), ' ',
    Low(TTen), ' ', High(TTen), ' ', High(a), ' ', SizeOf(TTen));
  WriteLn(High(Byte) + 1, ' ', Integer(High(Byte)) + 1);
  t := TThing.Create;
  SetPropInt(t, 'B', 300);
  SetPropInt(t, 'S', -1);
  SetPropInt(t, 'W', 70000);
  SetPropInt(t, 'I', -5);
  SetPropInt(t, 'C', 65);
  WriteLn(GetPropInt(t, 'B'), ' ', GetPropInt(t, 'S'), ' ', GetPropInt(t, 'W'), ' ',
    GetPropInt(t, 'I'), ' ', GetPropInt(t, 'C'), ' ', t.B, ' ', t.S, ' ', t.C);
  WriteLn(PropKind(t, 'B'), ' ', PropKind(t, 'S'), ' ', PropKind(t, 'C'));
end.

