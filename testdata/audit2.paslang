program audit2;

{ The second audit's fixes (1.0.136), the side that works:
  MakeChan(n) with a checked capacity; Trunc and Round where a real met
  an ordinal; -9223372036854775808 and the hex constants as the word's
  bits in a case; Succ and Pred inside their type; a named subrange in
  a message; Sin, Cos and Tan of an infinity or a NaN are NaN; a string
  in the variant part of a record is copied on a write to either copy;
  a value parameter of a wide type keeps the value it was given when
  the routine changes the caller's variable. }

type
  TColor = (Red, Green, Blue);
  TSmall = 1..10;
  TInner = record N: Integer; T: string; end;
  TV = record
    Tag: Integer;
    case Integer of
      0: (S: string);
      1: (A, B: Integer);
      2: (Sub: TInner);
      3: (Arr: array[0..2] of string);
  end;
  TArrV = array[0..1] of TV;
  TRec = record N: Integer; S: string; end;
  TArr = array[0..2] of Integer;

const
  CS = Succ(Red);
  CP = Pred(Blue);
  CC = Succ('a');
  Low64 = -9223372036854775808;

var
  c: chan of Integer;
  i, j: Integer;
  r, z, inf, nan: Real;
  sr: TSmall;
  a: array[0..3] of Integer;
  s: string;
  r1, r2: TV;
  av1, av2: TArrV;
  big, mid: string;
  G: string;
  GR: TRec;
  GA: TArr;

procedure Touch;
begin
  G := 'touched'; GR.N := 42; GR.S := 'touched'; GA[0] := 42;
end;

{ Each of these changes the caller's variable, by name, through a call,
  or through a pointer, then reads its parameter: the value it was
  given. }
procedure ShowStr(p: string);
begin
  G := 'changed';
  WriteLn(p, ' ', G);
end;

procedure ShowStr2(p: string);
begin
  Touch;
  WriteLn(p, ' ', G);
end;

procedure ShowRec(p: TRec);
begin
  GR.N := 2; GR.S := 'two';
  WriteLn(p.N, ' ', p.S, ' ', GR.N, ' ', GR.S);
end;

procedure ShowRec2(p: TRec);
begin
  Touch;
  WriteLn(p.N, ' ', p.S, ' ', GR.N, ' ', GR.S);
end;

procedure ShowArr(p: TArr);
begin
  GA[0] := 9;
  WriteLn(p[0], ' ', GA[0]);
end;

procedure ViaPtr(p: string);
var
  q: ^string;
begin
  q := @G; q^ := 'ptr';
  WriteLn(p, ' ', G);
end;

procedure Both(p: string; var q: string);
begin
  q := 'q';
  WriteLn(p, ' ', q);
end;

{ Reads only: keeps the address, no copy. }
procedure ReadOnly(p: string);
var
  l: string;
begin
  l := p + '!';
  WriteLn(l);
end;

begin
  { 1. a buffered channel of a checked capacity }
  c := MakeChan(3);
  Send(c, 7); Send(c, 8);
  WriteLn(Recv(c), ' ', Recv(c));
  c := MakeChan(0 + 2);
  Send(c, 9);
  WriteLn(Recv(c));

  { 3. a real becomes an ordinal through Trunc or Round }
  r := 2.7; i := 1;
  Inc(i, Trunc(r));
  a[Round(r)] := 5;
  for j := 1 to Trunc(r) do a[0] := a[0] + j;
  SetLength(s, Trunc(r));
  s[1] := 'a'; s[2] := 'b';
  case Round(r) of
    3: WriteLn(i, ' ', a[3], ' ', a[0], ' ', s);
  else
    WriteLn('no');
  end;
  if r > 0 then WriteLn('positive');

  { 4. the lowest Integer, and hex constants as the word's bits, in a case }
  i := Low64;
  case i of
    Low64..-1: WriteLn('negative ', i);
    0..9223372036854775807: WriteLn('positive');
  end;
  i := $FFFFFFFFFFFFFFFF;
  case i of
    $8000000000000000..$FFFFFFFFFFFFFFFF: WriteLn('high bit ', i);
  else
    WriteLn('low');
  end;
  WriteLn($7FFFFFFFFFFFFFFF, ' ', $8000000000000000, ' ', -9223372036854775807 - 1);

  { 5. Succ and Pred inside the type }
  WriteLn(Ord(CS), ' ', Ord(CP), ' ', CC, ' ', Ord(Succ(Green)), ' ', Ord(Pred(Green)));

  { 6. a named subrange takes an integer }
  sr := Trunc(r);
  WriteLn(sr, ' ', Low(TSmall), ' ', High(TSmall));

  { 8. Sin, Cos and Tan of an infinity or a NaN }
  z := 0.0;
  inf := 1.0 / z;
  nan := inf - inf;
  WriteLn(inf, ' ', Sin(inf), ' ', Cos(inf), ' ', Tan(inf));
  WriteLn(Sin(-inf), ' ', Cos(-inf), ' ', Sin(nan), ' ', Cos(nan), ' ', Tan(nan));
  WriteLn(Sin(0.0), ' ', Cos(0.0));

  { 9. strings in the variant part of a record are copied on write }
  r1.Tag := 0; r1.S := 'hello'; r1.S[1] := 'h';
  r2 := r1;
  r2.S[1] := 'X';
  WriteLn(r1.S, ' ', r2.S);
  r1.Tag := 1; r1.A := 12345; r1.B := 99;
  r2 := r1;
  WriteLn(r2.A, ' ', r2.B);
  { the other arm's words look like nothing of the heap: the copy leaves them }
  r1.A := Integer(@i) + 1; r1.B := 5;
  r2 := r1;
  WriteLn(r2.A = r1.A, ' ', r2.B);
  r1.A := -1; r1.B := 3;
  r2 := r1;
  WriteLn(r2.A, ' ', r2.B);
  r1.Tag := 2; r1.Sub.N := 7; r1.Sub.T := 'inner'; r1.Sub.T[1] := 'i';
  r2 := r1; r2.Sub.T[1] := 'Y';
  WriteLn(r1.Sub.T, ' ', r2.Sub.T, ' ', r2.Sub.N);
  r1.Tag := 3;
  for i := 0 to 2 do begin r1.Arr[i] := 'abc'; r1.Arr[i][1] := Chr(Ord('a') + i); end;
  r2 := r1; r2.Arr[1][1] := 'Z';
  WriteLn(r1.Arr[1], ' ', r2.Arr[1]);
  av1[0] := r1; av1[1].Tag := 0; av1[1].S := 'qq'; av1[1].S[1] := 'q';
  av2 := av1; av2[1].S[2] := 'W'; av2[0].Arr[2][1] := 'K';
  WriteLn(av1[1].S, ' ', av2[1].S, ' ', av1[0].Arr[2], ' ', av2[0].Arr[2]);
  { a string of a class with a header word, and one of a large span }
  SetLength(mid, 1000);
  for i := 1 to 1000 do mid[i] := 'm';
  r1.Tag := 0; r1.S := mid; r1.S[1] := 'b';
  r2 := r1; r2.S[2] := 'c';
  WriteLn(r1.S[1], r1.S[2], ' ', r2.S[1], r2.S[2], ' ', mid[1], mid[2]);
  SetLength(big, 100000);
  for i := 1 to 100000 do big[i] := 'a';
  r1.S := big; r1.S[1] := 'b';
  r2 := r1; r2.S[2] := 'c';
  WriteLn(r1.S[1], r1.S[2], ' ', r2.S[1], r2.S[2], ' ', big[1], big[2], ' ', Length(r2.S));

  { 10. a value parameter keeps its value when the routine changes the caller's variable }
  G := 'first'; GR.N := 1; GR.S := 'one'; GA[0] := 5;
  ShowStr(G); ShowStr2(G); ShowRec(GR); ShowRec2(GR); ShowArr(GA); ViaPtr(G);
  G := 'first'; Both(G, G); ReadOnly(G);
end.

