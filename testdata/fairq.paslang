{ 1.0.71: the global queue is first in, first out, and one round in 61
  takes from it first, as Go's. Main runs 300 ms beside 64 routines that
  never park; preempted again and again, it must come back each time.
  As a stack, the queue buried a preempted routine under the ones
  preempted after it, and it never ran again. }
program fairq;

uses
  paslib, pastime;

var
  wg: waitgroup;
  stop, acc, i, x, rounds: Integer;
  t0: Int64;

procedure Spin(K: Integer);
var
  y: Integer;
begin
  y := K;
  while stop = 0 do
    y := y * 3 + 1;
  AtomicAdd(@acc, y and 1);
  wg.Done;
end;

begin
  stop := 0;
  wg.Add(64);
  for i := 1 to 64 do
    pas Spin(i);
  rounds := 0;
  t0 := Monotonic;
  while Monotonic - t0 < 300000000 do
  begin
    x := 0;
    for i := 1 to 100000 do
      x := x + i;
    rounds := rounds + 1;
  end;
  AtomicAdd(@stop, 1);
  wg.Wait;
  WriteLn('done ', rounds > 0);
end.

