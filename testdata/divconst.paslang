procedure Fill;
var
  i, k, s: Integer;
begin
  nx := 0;
  xs[nx] := 0;
  Inc(nx);
  xs[nx] := 1;
  Inc(nx);
  xs[nx] := -1;
  Inc(nx);
  xs[nx] := 2;
  Inc(nx);
  xs[nx] := -2;
  Inc(nx);
  xs[nx] := 3;
  Inc(nx);
  xs[nx] := -3;
  Inc(nx);
  xs[nx] := 9;
  Inc(nx);
  xs[nx] := -9;
  Inc(nx);
  xs[nx] := 10;
  Inc(nx);
  xs[nx] := -10;
  Inc(nx);
  xs[nx] := 11;
  Inc(nx);
  xs[nx] := -11;
  Inc(nx);
  xs[nx] := 99;
  Inc(nx);
  xs[nx] := 100;
  Inc(nx);
  xs[nx] := 101;
  Inc(nx);
  xs[nx] := -100;
  Inc(nx);
  xs[nx] := -101;
  Inc(nx);
  xs[nx] := 9223372036854775807;
  Inc(nx);
  xs[nx] := -9223372036854775807;
  Inc(nx);
  xs[nx] := -9223372036854775807 - 1;
  Inc(nx);
  xs[nx] := 9223372036854775806;
  Inc(nx);
  xs[nx] := 4611686018427387904;
  Inc(nx);
  xs[nx] := -4611686018427387904;
  Inc(nx);
  xs[nx] := 4611686018427387903;
  Inc(nx);
  xs[nx] := -4611686018427387905;
  Inc(nx);
  xs[nx] := 2147483647;
  Inc(nx);
  xs[nx] := 2147483648;
  Inc(nx);
  xs[nx] := -2147483648;
  Inc(nx);
  xs[nx] := -2147483649;
  Inc(nx);
  xs[nx] := 4294967295;
  Inc(nx);
  xs[nx] := 4294967296;
  Inc(nx);
  xs[nx] := -4294967296;
  Inc(nx);
  s := 88172645463325252;
  for i := 1 to 3000 do
  begin
    s := s xor (s shl 13);
    s := s xor (s shr 7);
    s := s xor (s shl 17);
    k := i mod 64;
    if k < 60 then
      xs[nx] := s shr k
    else
      xs[nx] := s;
    if (i and 1) = 1 then
      xs[nx] := -xs[nx];
    Inc(nx);
  end;
end;

begin
  bad := 0;
  total := 0;
  Fill;
  T1;
  T2;
  T3;
  T5;
  T6;
  T7;
  T10;
  T12;
  T60;
  T100;
  T641;
  T1000;
  T3600;
  T10007;
  T65536;
  T1000000007;
  T2147483648;
  T2147483649;
  T4294967295;
  T1099511627776;
  T1000000000039;
  T4611686018427387904;
  T4611686018427387905;
  T9223372036854775807;
  T3037000493;
  T123456789;
  T999999999989;
  T6700417;
  T36028797018963913;
  T255;
  WriteLn(total, ' checks, ', bad, ' wrong');
end.

