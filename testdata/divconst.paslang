{ P94: division and remainder by a constant are a multiply and shifts
  (Go's magic numbers); every result here is checked against the
  division instruction, which a variable divisor still uses. }
program divconst;

var
  xs: array[0..3099] of Integer;
  nx, bad, total: Integer;
  a: array[0..0] of Integer;

procedure T1;
var
  i, x, v, q, r, q2, r2: Integer;
begin
  v := 1;
  for i := 0 to nx - 1 do
  begin
    x := xs[i];
    q := x div 1;
    r := x mod 1;
    a[0] := x;
    q2 := a[0] div 1;
    r2 := a[0] mod 1;
    if (q <> x div v) or (r <> x mod v) or (q2 <> q) or (r2 <> r) then
      Inc(bad);
    Inc(total);
  end;
end;

