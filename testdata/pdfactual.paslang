{ P516: paspdf reads the PDF files of testdata/pdfactual.txt (built by
  scripts/gen_pdfactual.py), in which a marked-content sequence tagged Span has
  an ActualText entry (ISO 32000-1 14.9.4), and gives the text each must give:
  the replacement once, where the first string of the sequence begins, and none
  of the glyphs' own; the outermost of nested sequences; the entry through the
  Properties resource; a form or a page that leaves a sequence open or closes
  one it did not open. Then every file is cut, bent and spliced by a fixed
  generator, 12 times each (the first argument changes the number, the second
  the seed), and read again: whatever the bytes, the reader returns or raises
  EPdfError and nothing else is raised. }
program pdfactual;

uses
  sysutils, pasflate, pascodec, paspdf;

var
  GS: UInt64;

function Rnd(N: Integer): Integer;
begin
  GS := GS * 6364136223846793005 + 1442695040888963407;
  if N < 1 then
    N := 1;
  Result := Integer((GS shr 33) mod UInt64(N));
end;

function Field(const Line: string; K: Integer): string;
var
  i, start, n: Integer;
begin
  Result := '';
  n := 0;
  start := 1;
  for i := 1 to Length(Line) + 1 do
    if (i > Length(Line)) or (Line[i] = #9) then
    begin
      if n = K then
      begin
        Result := Copy(Line, start, i - start);
        Exit;
      end;
      n := n + 1;
      start := i + 1;
    end;
end;

function Unb64(const S: string): string;
var
  r: string;
begin
  if not Base64Decode(S, False, True, r) then
  begin
    WriteLn('bad base64 in the corpus');
    Halt(2);
  end;
  Result := r;
end;

function Visible(const S: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
    if S[i] = #10 then
      Result := Result + '\n'
    else if S[i] = #12 then
      Result := Result + '\f'
    else
      Result := Result + S[i];
end;

{ the reading of a file: its text, or the fault }
function Reading(const Pdf: string; out Fault: string): string;
begin
  Result := '';
  Fault := '';
  try
    Result := PdfText(Pdf);
  except
    on E: EPdfError do
      Fault := E.Message;
  end;
end;

var
  corpus, line, name, kind, pdf, want, got, fault: string;
  p, nl, count, bad, rounds, i, k, a, b, ok, faults, other: Integer;
  mut: string;
  nrounds: Integer;
  lines: array of string;
  n: Integer;
begin
  if not ReadFile('testdata/pdfactual.txt', corpus) then
  begin
    WriteLn('no testdata/pdfactual.txt');
    Halt(2);
  end;
  p := 1;
  count := 0;
  bad := 0;
  n := 0;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    if line = '' then
      Continue;
    SetLength(lines, n + 1);
    lines[n] := line;
    n := n + 1;
    name := Field(line, 0);
    kind := Field(line, 1);
    pdf := Unb64(Field(line, 2));
    want := Unb64(Field(line, 3));
    got := Reading(pdf, fault);
    count := count + 1;
    if kind = 'text' then
    begin
      if fault <> '' then
      begin
        bad := bad + 1;
        WriteLn('FAULT ', name, ': ', fault);
      end
      else if got <> want then
      begin
        bad := bad + 1;
        WriteLn('DIFFERS ', name);
        WriteLn('  want ', Visible(want));
        WriteLn('  got  ', Visible(got));
      end;
    end
    else if kind = 'error' then
    begin
      if (fault = '') or (Pos(want, fault) = 0) then
      begin
        bad := bad + 1;
        WriteLn('NO FAULT ', name, ': wanted ', want, ', got ', fault, ' / ', Visible(got));
      end;
    end;
  end;
  WriteLn('pdf files ', count, ', wrong ', bad);
  { the mutations }
  GS := 5160;
  nrounds := 12;
  if ParamStr(1) <> '' then
    nrounds := StrToInt(ParamStr(1));
  if ParamStr(2) <> '' then
    GS := StrToInt(ParamStr(2));
  rounds := 0;
  ok := 0;
  faults := 0;
  other := 0;
  for i := 0 to n - 1 do
  begin
    pdf := Unb64(Field(lines[i], 2));
    if Length(pdf) < 8 then
      Continue;
    for k := 1 to nrounds do
    begin
      mut := pdf;
      case Rnd(6) of
        0: mut := Copy(pdf, 1, Rnd(Length(pdf) + 1));
        1:
          begin
            a := Rnd(Length(pdf)) + 1;
            mut := Copy(pdf, 1, a - 1) + Copy(pdf, a + 1 + Rnd(40), Length(pdf));
          end;
        2:
          for b := 1 to 1 + Rnd(8) do
          begin
            a := Rnd(Length(mut)) + 1;
            mut[a] := Chr(Rnd(256));
          end;
        3:
          begin
            a := Rnd(Length(pdf)) + 1;
            b := Rnd(Length(pdf)) + 1;
            mut := Copy(pdf, 1, a) + Copy(pdf, b, 30 + Rnd(200)) + Copy(pdf, a + 1, Length(pdf));
          end;
        4:
          for b := 1 to 1 + Rnd(4) do
          begin
            a := Rnd(Length(mut)) + 1;
            if Rnd(2) = 0 then
              mut[a] := Chr(Ord(mut[a]) xor (1 shl Rnd(8)))
            else
              mut[a] := Chr(48 + Rnd(10));
          end;
        5: mut := 'junk' + pdf + Copy(pdf, Rnd(Length(pdf)) + 1, 100);
      end;
      rounds := rounds + 1;
      try
        got := PdfText(mut);
        ok := ok + 1;
      except
        on E: EPdfError do
          faults := faults + 1;
        on E: Exception do
        begin
          other := other + 1;
          WriteLn('OTHER ', Field(lines[i], 0), ' round ', k, ': ', E.ClassName, ' ', E.Message);
        end;
      end;
    end;
  end;
  WriteLn('mutations ', rounds, ': read ', ok, ', refused ', faults, ', other ', other);
end.
