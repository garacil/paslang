{ P299: the failure of every check goes after its routine's ret, so the
  path where the check holds falls through and takes no branch; here
  every index, slice, View and divisor is in range, in routines, in
  loops kept in registers and in the main block, and make check looks
  for the calls of rt_boundsfail and rt_divzero after each ret. P300:
  the other failures (sqrt's domain, a real's integer range, a bit's
  and a set element's range, a funnel's lengths, as) and the slow paths
  that come back (a string's append when its block is full, a string
  made its own before a write, FillChar past 256 KiB) go there too. }
program coldfail;

type
  TBase = class
    Side: Integer;
  end;

  TSquare = class(TBase)
  end;

  TBits = set of Byte;

var
  a: array[0..63] of Integer;
  w: array[-3..3] of Integer;
  d: array of Integer;
  s: string;
  i, t: Integer;

{ a static array, a loop that calls nothing }
function SumA(n: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to n - 1 do
    Result := Result + a[(i * 7) mod 64] + w[i mod 4];
end;

{ a string }
function SumS(const x: string): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to Length(x) do
    Result := Result + Ord(x[i]) * i;
end;

{ a slice, its elements written and read }
function SumD(n: Integer): Integer;
var
  i, k: Integer;
begin
  Result := 0;
  for i := 0 to n - 1 do
  begin
    k := (i * 13) mod Length(d);
    d[k] := d[k] + i;
    Result := Result + d[(k + 1) mod Length(d)];
  end;
end;

{ divisions by a variable }
function Divs(n: Integer): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to n do
    Result := Result + 1000003 div i + 1000003 mod i;
end;

{ a slice of a slice and a View }
function Cuts(n: Integer): Integer;
var
  e, f: array of Integer;
  i: Integer;
begin
  Result := 0;
  for i := 0 to n - 1 do
  begin
    e := d[i mod 10..(i mod 10) + 5];
    f := View(PInteger(@a[i mod 32]), 8);
    Result := Result + e[2] + f[7] + Length(e) + Length(f);
  end;
end;

{ nested: the check is the nested routine's own }
function Outer(n: Integer): Integer;
var
  acc: Integer;

  procedure Add(k: Integer);
  begin
    acc := acc + a[k mod 64] div (k mod 7 + 1);
  end;

var
  i: Integer;
begin
  acc := 0;
  for i := 0 to n - 1 do
    Add(i);
  Result := acc;
end;

{ a string a character at a time, then written into }
function Build(n: Integer): Integer;
var
  i: Integer;
  t, c: string;
begin
  t := '';
  for i := 1 to n do
    t := t + Chr(97 + i mod 26);
  c := t;
  c[1] := 'Z';
  t[2] := 'Y';
  Result := Length(t) + Ord(t[1]) + Ord(t[2]) + Ord(c[1]) + Ord(c[2]) + Ord(t[n]);
end;

{ FillChar of a size known only when it runs }
function Fills(n: Integer): Integer;
var
  b: array[0..999] of Byte;
  i: Integer;
begin
  Result := 0;
  for i := 1 to n do
  begin
    FillChar(b, i mod 1000 + 1, i and 255);
    Result := Result + b[i mod 1000] + b[0];
  end;
end;

{ sqrt, a real's integer part, a bit, a set's element, a funnel, as }
function Others(n: Integer): Integer;
var
  i: Integer;
  r: Double;
  st: TBits;
  sh: TBase;
  sq: TSquare;
  u, v: string;
begin
  Result := 0;
  sq := TSquare.Create;
  sq.Side := 3;
  sh := sq;
  u := 'abcd';
  v := 'efgh';
  for i := 1 to n do
  begin
    r := Sqrt(i * 1.5);
    Result := Result + Trunc(r * 10) + IsBitSet(i, i mod 63);
    st := [i mod 256, (i * 7) mod 256];
    if 5 in st then
      Result := Result + 2;
    Result := Result + (sh as TSquare).Side;
  end;
  u := FunnelLeft(u, v, 2);
  Result := Result + Length(u) + Ord(u[1]);
end;

begin
  for i := 0 to 63 do
    a[i] := i * i - 100;
  for i := -3 to 3 do
    w[i] := i * 1000;
  SetLength(d, 40);
  for i := 0 to 39 do
    d[i] := 40 - i;
  s := 'paslang checks every index';
  WriteLn(SumA(1000), ' ', SumS(s), ' ', SumD(500), ' ', Divs(2000));
  WriteLn(Cuts(300), ' ', Outer(777));
  WriteLn(Build(1000), ' ', Fills(3000), ' ', Others(500));
  { the main block's own checks }
  t := 0;
  for i := 0 to 99 do
    t := t + a[i mod 64] mod (i + 1) + Ord(s[i mod Length(s) + 1]);
  WriteLn(t);
end.
