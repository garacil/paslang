program writefmt;

{ Write and WriteLn formats (1.0.79): x:w pads any value to w columns,
  x:w:d prints a real with d decimals, and a real prints exactly: 1e20,
  2.5e-7, 2.675, the infinities and NaN. }

type
  TColor = (Red, Green, Blue);

var
  i: Integer;
  x, z: Double;
  c: Char;
  s: string;
  b: Boolean;
  k: TColor;

begin
  i := 42;
  x := 3.14159;
  c := 'q';
  s := 'abc';
  b := True;
  k := Blue;
  WriteLn('[', i:5, '][', i:1, '][', -i:6, '][', 0:3, ']');
  WriteLn('[', s:6, '][', s:2, '][', c:3, '][', 'lit':5, '][', b:3, '][', k:2, ']');
  WriteLn('[', x:10:3, '][', x:0:2, '][', x:0:0, '][', x:8, '][', -x:9:4, ']');
  WriteLn(1e20);
  WriteLn(2.5e-7, ' ', 2.5e-7:0:7, ' ', 2.675, ' ', 2.675:0:2, ' ', 0.125:0:2, ' ', 0.375:0:2);
  WriteLn(1.0 / 3, ' ', 2.0 / 3, ' ', 0.1 + 0.2, ' ', (0.1 + 0.2):0:17);
  z := 0;
  WriteLn(1 / z, ' ', -1 / z, ' ', z / z, ' ', -z, ' ', (1 / z):6);
  WriteLn(1.7976931348623157e308:0:0);
  WriteLn(5e-324:0:330);
  WriteLn(123456789.987654321:0:9, ' ', 9.5e18, ' ', -0.0000004, ' ', 0.9999999);
  i := 7;
  WriteLn('[', x:i:i - 4, '][', i * 2:i, ']');
  Write(x:0:1, ' ');
  Write(ErrOutput, '');
  WriteLn(ErrOutput, 1.5:6:2);
  WriteLn;
end.

