program md5lens;

{ P547: the MD5 of data made from a seed, for every length from 0 to 140 (every padding case of the last block) and for some longer ones }

uses
  sysutils;

var
  seed: Int64;

function Rnd: Integer;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := Integer((seed shr 33) and 255);
end;

function Data(n, kind: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, n);
  for i := 1 to n do
    case kind of
      0: Result[i] := Chr(Rnd);
      1: Result[i] := Chr(255);
      2: Result[i] := Chr(0);
    else
      Result[i] := Chr(97 + (i mod 7));
    end;
end;

procedure One(n, kind: Integer);
var
  s: string;
begin
  seed := 547 + n * 31 + kind;
  s := Data(n, kind);
  WriteLn(n, ' ', kind, ' ', Hex(Md5(s)));
end;

var
  n, k: Integer;
begin
  for n := 0 to 140 do
    for k := 0 to 3 do
      One(n, k);
  One(1000, 0);
  One(4095, 0);
  One(4096, 0);
  One(65536, 0);
  One(1048576, 0);
end.
