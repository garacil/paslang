{ P381: a record's class operators by the rest of Delphi's names (Free
  Pascal's reference, table 9.1): BitwiseAnd, LogicalOr, BitwiseXor,
  LogicalNot, LeftShift, RightShift and In on a set of flags; Negative,
  Positive, Inc, Dec, Trunc and Round on a length, beside its binary -.
  The output is written by hand. }
program recops2;

type
  TFlags = record
    Bits: Integer;
    class operator BitwiseAnd(a, b: TFlags): TFlags;
    class operator LogicalOr(a, b: TFlags): TFlags;
    class operator BitwiseXor(a, b: TFlags): TFlags;
    class operator LogicalNot(a: TFlags): TFlags;
    class operator LeftShift(a: TFlags; n: Integer): TFlags;
    class operator RightShift(a: TFlags; n: Integer): TFlags;
    class operator In(n: Integer; a: TFlags): Boolean;
    class operator Implicit(n: Integer): TFlags;
  end;

  TMeter = record
    V: Double;
    class operator Negative(a: TMeter): TMeter;
    class operator Positive(a: TMeter): TMeter;
    class operator Inc(a: TMeter): TMeter;
    class operator Dec(a: TMeter): TMeter;
    class operator Trunc(a: TMeter): Integer;
    class operator Round(a: TMeter): Integer;
    class operator -(a, b: TMeter): TMeter;
  end;

class operator TFlags.BitwiseAnd(a, b: TFlags): TFlags;
begin
  Result.Bits := a.Bits and b.Bits;
end;

class operator TFlags.LogicalOr(a, b: TFlags): TFlags;
begin
  Result.Bits := a.Bits or b.Bits;
end;

class operator TFlags.BitwiseXor(a, b: TFlags): TFlags;
begin
  Result.Bits := a.Bits xor b.Bits;
end;

class operator TFlags.LogicalNot(a: TFlags): TFlags;
begin
  Result.Bits := a.Bits xor 255;
end;

class operator TFlags.LeftShift(a: TFlags; n: Integer): TFlags;
begin
  Result.Bits := a.Bits shl n;
end;

class operator TFlags.RightShift(a: TFlags; n: Integer): TFlags;
begin
  Result.Bits := a.Bits shr n;
end;

class operator TFlags.In(n: Integer; a: TFlags): Boolean;
begin
  Result := ((a.Bits shr n) and 1) = 1;
end;

class operator TFlags.Implicit(n: Integer): TFlags;
begin
  Result.Bits := n;
end;

class operator TMeter.Negative(a: TMeter): TMeter;
begin
  Result.V := -a.V;
end;

class operator TMeter.Positive(a: TMeter): TMeter;
begin
  Result.V := Abs(a.V);
end;

class operator TMeter.Inc(a: TMeter): TMeter;
begin
  Result.V := a.V + 1;
end;

class operator TMeter.Dec(a: TMeter): TMeter;
begin
  Result.V := a.V - 1;
end;

class operator TMeter.Trunc(a: TMeter): Integer;
begin
  Result := Trunc(a.V);
end;

class operator TMeter.Round(a: TMeter): Integer;
begin
  Result := Round(a.V);
end;

class operator TMeter.-(a, b: TMeter): TMeter;
begin
  Result.V := a.V - b.V;
end;

var
  f, g: TFlags;
  m: TMeter;

begin
  f := 12;
  g := 10;
  WriteLn((f and g).Bits, ' ', (f or g).Bits, ' ', (f xor g).Bits, ' ', (not f).Bits);
  WriteLn((f shl 2).Bits, ' ', (f shr 2).Bits);
  WriteLn(2 in f, ' ', 0 in f, ' ', 3 in g);
  m.V := -2.6;
  WriteLn((-m).V:0:1, ' ', (+m).V:0:1);
  Inc(m);
  WriteLn(m.V:0:1);
  Dec(m);
  Dec(m);
  WriteLn(m.V:0:1);
  WriteLn(Trunc(m), ' ', Round(m));
  m.V := 5;
  WriteLn((m - (-m)).V:0:1);
end.

