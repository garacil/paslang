program append;

{ Append, Cap and slice literals (P109, 1.0.132): elements of every kind
  (narrow, signed, real, string, record with a string, slice), a slice
  appended to one, itself too, two slices of one block that grow apart,
  literals as arguments and elements, the empty cases, and a long run
  whose capacity stays within twice its length. }

uses paslib;

type
  TPt = record
    X, Y: Integer;
    N: string;
  end;
  TInts = array of Integer;
  TGrid = array of TInts;

var
  s, t, u, e: TInts;
  w: array of Word;
  b: array of Int8;
  r: array of Double;
  ss: array of string;
  ps: array of TPt;
  g: TGrid;
  p: TPt;
  i, sum: Integer;
  str: string;

function Total(const d: TInts): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(d) do
    Result := Result + d[i];
end;

procedure Show(const d: TInts);
var
  i: Integer;
begin
  Write(Length(d), ':');
  for i := 0 to High(d) do
    Write(' ', d[i]);
  WriteLn;
end;

begin
  s := Append(s, 1, 2, 3);
  Show(s);
  WriteLn(Cap(s) >= 3, ' ', Cap(e), ' ', Length(e));
  t := s;
  t := Append(t, 4);
  s := Append(s, 9);
  Show(s);
  Show(t);
  u := [10, 20, 30];
  Show(u);
  WriteLn(Total([1, 2, 3, 4]), ' ', Total([]), ' ', Total(Append(u, 5)));
  s := Append(s, u);
  Show(s);
  s := Append(s, s);
  Show(s);
  s := Append(s);
  WriteLn(Length(s));
  e := [];
  WriteLn(Length(e), ' ', Length(Append(e, e)));
  w := Append(w, $FFFF, 7);
  b := Append(b, -128, 127);
  r := [1.5, 2];
  r := Append(r, 0.25);
  WriteLn(w[0], ' ', w[1], ' ', b[0], ' ', b[1], ' ', r[0]:0:2, ' ', r[1]:0:2, ' ', r[2]:0:2);
  str := 'b';
  ss := ['a', str + 'c'];
  str := 'z';
  ss := Append(ss, 'x' + IntToStr(5), str);
  WriteLn(ss[0], ss[1], ss[2], ss[3], ' ', Length(ss));
  p.X := 1;
  p.Y := 2;
  p.N := 'pt';
  ps := Append(ps, p, p);
  p.N := 'changed';
  ps[1].N := 'second';
  WriteLn(ps[0].X, ps[0].Y, ps[0].N, ' ', ps[1].N, ' ', p.N);
  g := Append(g, [1, 2], [3]);
  g := Append(g, Append(g[0], 7));
  WriteLn(Length(g), ' ', Total(g[0]), ' ', Total(g[1]), ' ', Total(g[2]), ' ', Length(g[0]));
  sum := 0;
  s := nil;
  for i := 1 to 100000 do
    s := Append(s, i);
  for i := 0 to High(s) do
    sum := sum + s[i];
  WriteLn(Length(s), ' ', sum, ' ', Cap(s) >= Length(s), ' ', Cap(s) <= 2 * Length(s) + 4);
  ss := nil;
  for i := 1 to 20000 do
    ss := Append(ss, 'n' + IntToStr(i));
  WriteLn(Length(ss), ' ', ss[0], ' ', ss[19999]);
end.
