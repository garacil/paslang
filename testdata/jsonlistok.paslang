{ P474: what JsonEncode still takes from a list in brackets: a set, the
  list through JsonArray, a variable of an array type and a slice. }
program jsonlistok;
uses sysutils;
type
  TStrs = array of string;
  TDay = (dMon, dTue, dWed);
var
  v: TStrs;
  s: set of Byte;
  d: set of TDay;
  a, b: string;

procedure Show(const w: array of string);
begin
  WriteLn(JsonEncode(w));
end;

begin
  a := 'SP1';
  b := 'Geogr' + #195#161 + 'fico';
  s := [1, 5, 9];
  WriteLn(JsonEncode(s));
  d := [dMon, dWed];
  WriteLn(JsonEncode(d));
  WriteLn(JsonEncode([2, 3, 5]));
  WriteLn(JsonEncode(JsonArray(['referencia', 'consulta'])));
  WriteLn(JsonEncode(JsonArray([a, b, 3, 1.5, True])));
  v := ['referencia', 'consulta'];
  WriteLn(JsonEncode(v));
  v := [a, b];
  WriteLn(JsonEncode(v));
  Show([a, b]);
  Show(['x', 'y', 'z']);
  WriteLn(JsonEncode(JsonOf(v), JsonCanonical));
end.
