{ P548: UInt32 AND bounds the value without weakening real bounds checks.
  A Byte add wrapping to zero guards against extending mathematical
  add/sub intervals to narrow arithmetic. Every expected failure checks
  its exact class, index/bounds and source line. One argument requests
  the same failure without a handler for a retained fatal-status check. }
program uint32bounds;
uses sysutils;

var
  full: array[0..255] of Integer;
  small: array[0..127] of Integer;
  positive: array[1..255] of Integer;
  calls, zero, sink: Integer;

function Pass(a: UInt32): UInt32;
begin calls := calls + 1; Result := a; end;
function Safe256(a: UInt32): Integer;
begin
  Result := full[a and 255];
end;
function SafeRaw(a: UInt32): Integer;
begin
  Result := full[Pass(a) and 255];
end;
function SafeWrap(a: UInt32): Integer;
begin
  Result := full[(a + 1) and 255];
end;
function Mask128(a: UInt32): Integer;
begin
  Result := small[a and 255]; { FAIL-MASK128 }
end;
function Mask511(a: UInt32): Integer;
begin
  Result := full[a and 511]; { FAIL-MASK511 }
end;
function Unmasked(a: UInt32): Integer;
begin
  Result := full[a]; { FAIL-UNMASKED }
end;
function FullWidthMask(a: UInt32): Integer;
begin
  Result := full[(a + 1) and 4294967295]; { FAIL-FULLWIDTH }
end;
function SignedIndex(a: Int32): Integer;
begin
  Result := full[a]; { FAIL-SIGNED }
end;
function SignedMask(a: Int32): Integer;
begin
  Result := full[a and (-1)]; { FAIL-SIGNEDMASK }
end;
function ByteWrap(a: Byte): Integer;
begin
  Result := positive[a + 1]; { FAIL-BYTEWRAP }
end;

procedure Fail(K: Integer);
begin
  case K of
    1: sink := Mask128(UInt32(zero + 255));
    2: sink := Mask511(UInt32(zero + 511));
    3: sink := Unmasked(UInt32(zero + 256));
    4: sink := FullWidthMask(UInt32(zero + 255));
    5: sink := SignedIndex(Int32(zero - 1));
    6: sink := SignedMask(Int32(zero - 1));
    7: sink := ByteWrap(Byte(zero + 255));
  end;
end;

const
  Lines: array[0..6] of Integer = (35, 39, 43, 47, 51, 55, 59);
  Faults: array[0..6] of string = (
    'index 255 out of range [0..127]',
    'index 511 out of range [0..255]',
    'index 256 out of range [0..255]',
    'index 256 out of range [0..255]',
    'index -1 out of range [0..255]',
    'index -1 out of range [0..255]',
    'index 0 out of range [1..255]');
var
  i, k: Integer;
  want: string;
begin
  zero := ParamCount div 1000;
  for i := 0 to 255 do full[i] := i * 17 + 3;
  for i := 0 to 127 do small[i] := i * 7 + 1;
  for i := 1 to 255 do positive[i] := i * 11 + 5;
  if ParamCount = 1 then
  begin
    Fail(StrToInt(ParamStr(1)));
    Halt(90);
  end;
  WriteLn('safe ', Safe256(UInt32(zero)), ' ', Safe256(UInt32(zero + 255)),
    ' ', Safe256(UInt32(zero + 2166572391)), ' ',
    Safe256(UInt32(zero + 4294967295)), ' ', SafeWrap(UInt32(zero + 4294967295)));
  calls := 0;
  sink := SafeRaw(UInt32(zero + 255));
  WriteLn('raw ', sink, ' ', calls);
  for k := 1 to 7 do
    try
      Fail(k);
      Halt(91);
    except
      on e: ERangeError do
      begin
        want := Faults[k - 1] + ' at line ' + IntToStr(Lines[k - 1]);
        if (e.ClassName <> 'ERangeError') or (e.Message <> want) then
        begin
          WriteLn('wrong bounds failure ', e.ClassName, ' [', e.Message, ']');
          Halt(92);
        end;
        WriteLn(k, ' ', e.ClassName, ' ', e.Message);
      end;
    end;
end.
