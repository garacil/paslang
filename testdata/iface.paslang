program iface;

type
  IGreeter = interface
    procedure Hello;
    function Value(X: Integer): Integer;
  end;

  IMore = interface(IGreeter)
    function Extra: Integer;
  end;

  TBox = class(IGreeter)
    FX: Integer;
    procedure Hello;
    function Value(X: Integer): Integer;
  end;

  TBar = class(TBox, IMore)
    function Extra: Integer;
  end;

procedure TBox.Hello;
begin
  WriteLn(FX);
end;

function TBox.Value(X: Integer): Integer;
begin
  Result := FX + X;
end;

function TBar.Extra: Integer;
begin
  Result := FX * 2;
end;

var
  O: TBox;
  B: TBar;
  G: IGreeter;
  M: IMore;

begin
  O := TBox.Create;
  O.FX := 10;
  G := O;
  G.Hello;
  WriteLn(G.Value(3));
  B := TBar.Create;
  B.FX := 7;
  G := B;
  G.Hello;
  WriteLn(G.Value(1));
  M := B;
  WriteLn(M.Extra);
  WriteLn(M.Value(2));
end.
