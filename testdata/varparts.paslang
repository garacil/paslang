{ P282: a loop reads the fields of a var parameter through a register
  that keeps its address; the record lies on the caller's stack, which
  grows and moves while the routines run, and the loop is long enough to
  be preempted; the sums are checked against the same loops over a copy. }
program varparts;

type
  TAcc = record
    A, B, C: Integer;
    Tag: string;
  end;

var
  wg: waitgroup;
  res: array[0..7] of Integer;

function Sum(var P: TAcc; N: Integer): Integer;
var
  i, s: Integer;
begin
  s := 0;
  for i := 1 to N do
    s := s + P.A * i + P.B - (P.C xor i);
  Result := s;
end;

function SumWhile(var P: TAcc; N: Integer): Integer;
var
  i, s: Integer;
begin
  s := 0;
  i := 0;
  while i < N do
  begin
    s := s + (P.A and i) + P.C;
    i := i + 1;
  end;
  Result := s;
end;

function SumConst(const P: TAcc; N: Integer): Integer;
var
  i, s: Integer;
begin
  s := 0;
  for i := 1 to N do
    s := s + (P.B * i) - P.A;
  Result := s;
end;

{ writes through the address the loop keeps: P.B grows by i and 3 }
procedure Bump(var P: TAcc; N: Integer);
var
  i: Integer;
begin
  i := 0;
  repeat
    P.B := P.B + (i and 3);
    i := i + 1;
  until i >= N;
end;

function Deep(K, N: Integer): Integer;
var
  acc: TAcc;
  pad: array[0..63] of Integer;
begin
  acc.A := K + 3;
  acc.B := 7;
  acc.C := K * 5;
  acc.Tag := 'k';
  pad[K mod 64] := K;
  if K > 0 then
    Result := Deep(K - 1, N) + pad[K mod 64] - K
  else
    Result := 0;
  Result := Result + Sum(acc, N) + SumWhile(acc, N) + SumConst(acc, N);
  Bump(acc, N);
  Result := Result + acc.B;
end;

procedure Work(W: Integer);
begin
  res[W] := Deep(200 + W, 20000);
  wg.Done;
end;

function Plain(K, N: Integer): Integer;
var
  i, s, a, b, c: Integer;
begin
  Result := 0;
  while K >= 0 do
  begin
    a := K + 3;
    b := 7;
    c := K * 5;
    s := 0;
    for i := 1 to N do
      s := s + a * i + b - (c xor i);
    Result := Result + s;
    s := 0;
    for i := 0 to N - 1 do
      s := s + (a and i) + c;
    Result := Result + s;
    s := 0;
    for i := 1 to N do
      s := s + (b * i) - a;
    Result := Result + s;
    for i := 0 to N - 1 do
      b := b + (i and 3);
    Result := Result + b;
    K := K - 1;
  end;
end;

var
  w: Integer;
  ok: Boolean;
begin
  for w := 0 to 7 do
  begin
    wg.Add(1);
    pas Work(w);
  end;
  wg.Wait;
  ok := True;
  for w := 0 to 7 do
    if res[w] <> Plain(200 + w, 20000) then
    begin
      WriteLn('routine ', w, ': ', res[w], ' against ', Plain(200 + w, 20000));
      ok := False;
    end;
  WriteLn(ok, ' ', res[0], ' ', res[7]);
end.

