program defaults;

const
  Ten = 10;

procedure Greet(N: Integer; Extra: Integer = 10);
begin
  WriteLn(N + Extra);
end;

function Add(A: Integer; B: Integer = 7): Integer;
begin
  Result := A + B;
end;

procedure Show(A: Integer = 1; B: Integer = 2);
begin
  WriteLn(A);
  WriteLn(B);
end;

procedure Off(N: Integer = Ten);
begin
  WriteLn(N);
end;

procedure Neg(N: Integer = -3);
begin
  WriteLn(N);
end;

procedure Flag(A: Boolean = True);
begin
  if A then
    WriteLn(1)
  else
    WriteLn(0);
end;

function One(N: Integer = 5): Integer;
begin
  Result := N;
end;

procedure Later(N: Integer = 4); forward;

procedure Later(N: Integer);
begin
  WriteLn(N);
end;

begin
  Greet(3);
  Greet(3, 4);
  WriteLn(Add(2));
  WriteLn(Add(2, 5));
  Show;
  Show(8);
  Show(8, 9);
  Off;
  Neg;
  Flag;
  Flag(False);
  WriteLn(One);
  Later;
  Later(6);
end.

