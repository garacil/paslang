  P478: a document written after an edit keeps the reference to an entity
  whose text was read as nodes (`&e;`) where nothing of the entity's nodes
  was touched, and writes their text where one was. Entities of the
  internal subset that hold markup and external ones given by a resolver;
  the entity a node was read from; whether a write would expand a
  reference. }
program xmlkeep;

uses
  sysutils, pasxml;

function Serve(const PublicId, SystemId: string): string;
begin
  if SystemId = 't.ent' then
    Result := 'T<i/>'
  else if SystemId = 'plain.ent' then
    Result := 'plain'
  else if SystemId = 'empty.ent' then
    Result := ''
  else
    raise Exception.Create('no entity ' + SystemId);
end;

function Doc(const Decls, Body: string): TXmlDoc;
begin
  Result := XmlParseWith('<!DOCTYPE doc [' + Chr(10) + Decls + ']>' + Chr(10) + Body, @Serve, False);
end;

function Src(const Decls, Body: string): string;
begin
  Result := '<!DOCTYPE doc [' + Chr(10) + Decls + ']>' + Chr(10) + Body;
end;

function Flag(B: Boolean): string;
begin
  if B then
    Result := 'expanded'
  else
    Result := 'kept';
end;

procedure Show(const Id: string; D: TXmlDoc);
var
  x: string;
begin
  x := D.Xml;
  WriteLn(Id, ' ', Flag(D.EntitiesExpanded), ' ', Copy(x, Pos(']>', x) + 3, Length(x)));
end;

const
  D1 = '<!ENTITY e "<b>x<u/></b>">' + #10 + '<!ENTITY t SYSTEM "t.ent">' + #10;
  B1 = '<doc a="1">&e;<c/>&t;</doc>';
  D2 = '<!ENTITY e "<p/><q/>">' + #10;
  B2 = '<doc>&e;</doc>';

var
  d: TXmlDoc;
  r, b, c, u, t: TXmlNode;
begin
  d := Doc(D1, B1);
  WriteLn('01 ', d.Xml = Src(D1, B1), ' ', d.Root.Count);
  Show('02 untouched', d);
  d.Root.SetAttr('a', '2');
  Show('03 attribute of the root', d);
  d := Doc(D1, B1);
  c := d.Root.Elem('c');
  c.SetAttr('k', 'v');
  Show('04 attribute of a sibling', d);
  d := Doc(D1, B1);
  b := d.Root.Elem('b');
  u := b.Elem('u');
  t := d.Root.Elem('i');
  WriteLn('05 ', b.FromEntity, ' ', u.FromEntity, ' ', t.FromEntity, ' [', c.FromEntity, '] [', d.Root.FromEntity, ']');
  b.SetText('y');
  Show('06 text inside the first entity', d);
  d := Doc(D1, B1);
  d.Root.Elem('b').Detach;
  Show('07 the only node of the first entity removed', d);
  d := Doc(D1, B1);
  d.Root.Item(2).SetValue('U');
  Show('08 text of the second entity', d);
  d := Doc(D1, B1);
  d.Root.AddElem('z');
  Show('09 a child after the references', d);
  d := Doc(D1, B1);
  d.Root.Item(3).SetAttr('k', 'v');
  Show('10 attribute inside the second entity', d);
  d := Doc(D1, B1);
  d.Root.InsertChild(0, d.CreateElement('z'));
  Show('11 a child before the references', d);

  d := Doc(D2, B2);
  d.Root.RemoveAt(0);
  Show('12 one of two nodes removed', d);
  d := Doc(D2, B2);
  d.Root.InsertChild(1, d.CreateElement('n'));
  Show('13 a node between the two', d);
  d := Doc(D2, B2);
  d.Root.AddChild(d.CreateElement('n'));
  Show('14 a node after the two', d);
  d := Doc(D2, B2);
  r := d.Root;
  c := r.Item(0);
  r.RemoveAt(0);
  r.AddChild(c);
  Show('15 the two reordered', d);
  d := Doc(D2, B2);
  d.Root.Item(1).SetAttr('k', 'v');
  Show('16 attribute of the second of two', d);

  d := Doc('<!ENTITY e "<p/>">' + #10, '<doc>&e;&e;</doc>');
  d.Root.Item(0).SetAttr('k', 'v');
  Show('17 the first of two references edited', d);
  d := Doc('<!ENTITY e "<p/>">' + #10, '<doc>&e;&e;</doc>');
  d.Root.Item(1).SetAttr('k', 'v');
  Show('18 the second of two references edited', d);

  d := Doc('<!ENTITY t SYSTEM "plain.ent">' + #10, '<doc>a&t;b</doc>');
  WriteLn('19 ', d.Root.Count, ' ', d.Root.Text, ' ', d.Root.Item(1).FromEntity);
  d.Root.SetAttr('x', '1');
  Show('20 a text entity, the root edited', d);
  d := Doc('<!ENTITY t SYSTEM "plain.ent">' + #10, '<doc>a&t;b</doc>');
  d.Root.Item(1).SetValue('Q');
  Show('21 a text entity, its text edited', d);
  d := Doc('<!ENTITY t SYSTEM "plain.ent">' + #10, '<doc>a&t;b</doc>');
  d.Root.Item(0).SetValue('A');
  Show('22 a text entity, the text before it edited', d);

  d := Doc('<!ENTITY t SYSTEM "empty.ent">' + #10, '<doc a="1">&t;x</doc>');
  WriteLn('23 ', d.Root.Count, ' [', d.Root.Text, ']');
  d.Root.SetAttr('a', '2');
  Show('24 an empty entity, the root edited', d);

  d := XmlParse(Src('', '<doc><a/></doc>'));
  d.Root.SetAttr('k', 'v');
  Show('25 no entity', d);
  d := Doc(D1, B1);
  r := d.Root;
  c := r.Elem('c');
  c.Detach;
  Show('26 a sibling removed', d);
  d := Doc('<!ENTITY e "<p/><q/><r/>">' + #10, '<doc>&e;</doc>');
  r := d.Root;
  c := r.Item(1);
  r.RemoveAt(1);
  r.AddChild(c);
  Show('27 two of three swapped, the first where it was', d);
end.
