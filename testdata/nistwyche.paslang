program nistwyche;
{ P429: Wycheproof's vectors for pasnist (testdata/wycheproof): ECDSA
  on P-256 with SHA-256 and P-384 with SHA-384, the signatures in DER
  and as r || s (P1363), and ECDH on both curves with SEC 1 points. "acceptable" may go
  either way; the counts say which way it went. }
uses pasnist, paslib;

function UnHex(const h: string): string;
var
  i, d, v: Integer;
  c: Char;
begin
  SetLength(Result, Length(h) div 2);
  v := 0;
  for i := 1 to Length(h) do
  begin
    c := h[i];
    if (c >= '0') and (c <= '9') then
      d := Ord(c) - 48
    else if (c >= 'a') and (c <= 'f') then
      d := Ord(c) - 87
    else
      d := Ord(c) - 55;
    if Odd(i) then
      v := d shl 4
    else
      Result[i div 2] := Chr(v or d);
  end;
end;

{ the scalar's bytes at the curve's size: leading zeros dropped, then
  zeros put in front; '' when it does not fit }
function FixedSize(const s: string; n: Integer): string;
var
  i: Integer;
begin
  i := 1;
  while (i <= Length(s)) and (s[i] = #0) do
    i := i + 1;
  Result := Copy(s, i, Length(s) - i + 1);
  if Length(Result) > n then
    Exit('');
  while Length(Result) < n do
    Result := #0 + Result;
end;

procedure RunFile(const Kind, Name: string);
var
  text, pub, msg, sig, hash, res, shared, got, priv: string;
  doc, grp, tc: json;
  pass, fail, accYes, accNo, n, curve, size: Integer;
  ok, valid: Boolean;
begin
  if not ReadFile('testdata/wycheproof/' + Name, text) then
  begin
    WriteLn('cannot read ', Name);
    Halt(1);
  end;
  doc := JsonParse(text);
  pass := 0;
  fail := 0;
  accYes := 0;
  accNo := 0;
  if (Kind = 'ecdsa256') or (Kind = 'p1363_256') or (Kind = 'ecdh256') then
  begin
    curve := NistP256;
    size := 32;
  end
  else
  begin
    curve := NistP384;
    size := 48;
  end;
  for grp in doc['testGroups'] do
  begin
    pub := '';
    if Copy(Kind, 1, 4) <> 'ecdh' then
      pub := UnHex(grp['publicKey']['uncompressed'].AsString);
    for tc in grp['tests'] do
    begin
      res := tc['result'].AsString;
      valid := res = 'valid';
      if Copy(Kind, 1, 4) = 'ecdh' then
      begin
        priv := FixedSize(UnHex(tc['private'].AsString), size);
        ok := NistEcdh(curve, priv, UnHex(tc['public'].AsString), got);
        shared := UnHex(tc['shared'].AsString);
        if ok and (got <> shared) then
        begin
          Inc(fail);
          WriteLn('FAIL ', tc['tcId'].AsInteger, ' ', res, ': wrong shared secret');
          Continue;
        end;
      end
      else
      begin
        msg := UnHex(tc['msg'].AsString);
        if size = 32 then
          hash := Sha256(msg)
        else
          hash := Sha384(msg);
        sig := UnHex(tc['sig'].AsString);
        if Copy(Kind, 1, 5) = 'ecdsa' then
          ok := NistEcdsaVerifyAsn1(curve, pub, hash, sig)
        else if Length(sig) = 2 * size then
          ok := NistEcdsaVerify(curve, pub, hash, Copy(sig, 1, size), Copy(sig, size + 1, size))
        else
          ok := False;
      end;
      if res = 'acceptable' then
      begin
        Inc(pass);
        if ok then
          Inc(accYes)
        else
          Inc(accNo);
      end
      else if ok = valid then
        Inc(pass)
      else
      begin
        Inc(fail);
        WriteLn('FAIL ', tc['tcId'].AsInteger, ' ', res, ' got ', Ord(ok));
      end;
    end;
  end;
  n := pass + fail;
  WriteLn(Name, ': ', n, ' tests, ', pass, ' pass, ', fail, ' fail (acceptable: ',
    accYes, ' accepted, ', accNo, ' refused)');
end;

begin
  RunFile('ecdsa256', 'ecdsa_secp256r1_sha256_test.json');
  RunFile('ecdsa384', 'ecdsa_secp384r1_sha384_test.json');
  RunFile('p1363_256', 'ecdsa_secp256r1_sha256_p1363_test.json');
  RunFile('p1363_384', 'ecdsa_secp384r1_sha384_p1363_test.json');
  RunFile('ecdh256', 'ecdh_secp256r1_ecpoint_test.json');
  RunFile('ecdh384', 'ecdh_secp384r1_ecpoint_test.json');
end.
