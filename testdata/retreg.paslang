{ P361: a routine with no frame works its value out in the register it
  returns it in. Leaves of one chain, a division and a remainder; a
  routine with no frame that reads a global, one whose value comes by
  two paths, one that exits early, and a closure: the value is worked
  out in rax or x0, where it went to another register and a move put it
  there. The answers are worked out by hand in the comments;
  scripts/check_retreg.py finds no value moved into rax or x0 just after
  it was worked out elsewhere. }
program retreg;

type
  TFn = function(K: Integer): Integer;

var
  g, i, t: Integer;
  fns: array[0..1] of TFn;

function Sum2(A, B: Integer): Integer;
begin
  Result := A + B;
end;

function Scale(A: Integer): Integer;
begin
  Result := A * 5 - 2;
end;

function Half(A, B: Integer): Integer;
begin
  Result := A div B;
end;

function Rest(A: Integer): Integer;
begin
  Result := A mod 7;
end;

function AddG(K: Integer): Integer;
begin
  Result := K + g;
end;

function Clamp(X, Lo, Hi: Integer): Integer;
var
  r: Integer;
begin
  r := X;
  if r < Lo then
    r := Lo;
  if r > Hi then
    r := Hi;
  Result := r;
end;

function Early(X: Integer): Integer;
begin
  if X < 0 then
  begin
    Result := 0;
    Exit;
  end;
  Result := X * 2;
end;

function MakeAdd(N: Integer): TFn;
begin
  Result := function(K: Integer): Integer
  begin
    Result := K + N;
  end;
end;

begin
  g := 10;
  { 7 18 3 -2 15 }
  WriteLn(Sum2(3, 4), ' ', Scale(4), ' ', Half(17, 5), ' ', Rest(-23), ' ', AddG(5));
  { 9 0 4 0 12 }
  WriteLn(Clamp(15, 0, 9), ' ', Clamp(-3, 0, 9), ' ', Clamp(4, 0, 9), ' ', Early(-5), ' ', Early(6));
  fns[0] := MakeAdd(100);
  fns[1] := MakeAdd(200);
  { 1 to 10 and 100 for the even, 200 for the odd: 55 + 500 + 1000 = 1555 }
  t := 0;
  for i := 1 to 10 do
    t := t + fns[i and 1](i);
  WriteLn(t);
end.
