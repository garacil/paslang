program fastmath;

var
  i, s, n, a, b: Integer;

begin
  s := 0;
  i := 1;
  n := 4;
  while i <= n do
  begin
    s := s + i;
    i := i + 1;
  end;
  WriteLn(s);
  a := s;
  a := a - 3;
  WriteLn(a);
  i := 3;
  while i > 0 do
  begin
    a := a - 1;
    i := i - 1;
  end;
  WriteLn(a);
  for i := 5 downto 3 do
    a := a + 1;
  WriteLn(a);
  b := 6;
  b := b shl 2;
  WriteLn(b);
  b := b and 15;
  WriteLn(b);
  if a = 7 then
    WriteLn(1);
  if b <> 8 then
    WriteLn(0)
  else
    WriteLn(2);
end.

