{ P426: pasxml's tree. Every document of testdata/xmlcorpus.txt that
  reads is written back and is the document it was, byte for byte; then,
  on each of its elements (up to a dozen), each of six edits is made on a
  fresh read: a new attribute, an attribute taken off, the text replaced,
  an element and its text added, content in XML text added, the element
  removed. For each edit the document written is the original with only
  the edited element's bytes replaced (the bytes before it and after it
  are the same), it reads again, and the reread shows the edit. After
  those, the scenarios a spreadsheet's parts are edited in, the writer
  and the escaping, with the output written out. }
program xmldom;

uses
  sysutils, pasxml;

const
  HexDigits: string = '0123456789abcdef';

var
  Fails: Integer;

procedure Fail(const What: string);
begin
  Fails := Fails + 1;
  if Fails <= 20 then
    WriteLn('FAIL ', What);
end;

function Unhex(const S: string): string;
var
  i, a, b: Integer;
begin
  SetLength(Result, Length(S) div 2);
  for i := 1 to Length(S) div 2 do
  begin
    a := Pos(S[i * 2 - 1], HexDigits) - 1;
    b := Pos(S[i * 2], HexDigits) - 1;
    Result[i] := Chr(a * 16 + b);
  end;
end;

function HexOf(const S: string): string;
var
  i: Integer;
begin
  SetLength(Result, Length(S) * 2);
  for i := 1 to Length(S) do
  begin
    Result[i * 2 - 1] := HexDigits[(Ord(S[i]) shr 4) + 1];
    Result[i * 2] := HexDigits[(Ord(S[i]) and 15) + 1];
  end;
end;

procedure Elements(N: TXmlNode; var L: TXmlNodeArray; var Cnt: Integer);
var
  i: Integer;
begin
  if N.Kind <> xkElement then
    Exit;
  if Cnt >= Length(L) then
    SetLength(L, Cnt * 2 + 8);
  L[Cnt] := N;
  Cnt := Cnt + 1;
  for i := 0 to N.Count - 1 do
    Elements(N.Item(i), L, Cnt);
end;

{ whether a node of N's subtree, or an attribute, has no place in the
  document's bytes: it came from an entity's text or from a DOCTYPE's
  default (P446), where an edit has not the one place the checks below
  need; testdata/xmlentity edits those }
function Derived(N: TXmlNode): Boolean;
var
  i: Integer;
begin
  Result := N.Offset < 0;
  if Result then
    Exit;
  for i := 0 to N.AttrCount - 1 do
    if N.AttrAt(i).Defaulted then
    begin
      Result := True;
      Exit;
    end;
  for i := 0 to N.Count - 1 do
    if Derived(N.Item(i)) then
    begin
      Result := True;
      Exit;
    end;
end;

{ the child numbers from the root to N, as 0.3.1 }
function PathOf(N: TXmlNode): string;
begin
  Result := '';
  while N.Parent <> nil do
  begin
    Result := IntToStr(N.IndexInParent) + '.' + Result;
    N := N.Parent;
  end;
end;

function Follow(D: TXmlDoc; const Path: string): TXmlNode;
var
  i, j, k: Integer;
begin
  Result := D.Root;
  i := 1;
  while (Result <> nil) and (i <= Length(Path)) do
  begin
    j := i;
    while Path[j] <> '.' do
      j := j + 1;
    k := StrToInt(Copy(Path, i, j - i));
    if k >= Result.Count then
      Result := nil
    else
      Result := Result.Item(k);
    i := j + 1;
  end;
end;

{ the namespace unprefixed names have at N: the nearest xmlns going up }
function DefaultNs(N: TXmlNode): string;
var
  i: Integer;
begin
  Result := '';
  while N <> nil do
  begin
    for i := 0 to N.AttrCount - 1 do
      if N.AttrAt(i).Name = 'xmlns' then
      begin
        Result := N.AttrAt(i).Value;
        Exit;
      end;
    N := N.Parent;
  end;
end;

var
  Docs: Integer;
  Back, BackBad: Integer;
  Edits, EditsOk: Integer;

{ the edit Op on element number K of a fresh read of Text }
procedure TryEdit(const Text: string; K, Op: Integer);
var
  d, d2: TXmlDoc;
  els: TXmlNodeArray;
  cnt, i, s, e, na, nk: Integer;
  n, m: TXmlNode;
  path, outx, x, prefix, suffix, nsdef: string;
  ok: Boolean;
  firstAttr: string;
  par: TXmlNode;
begin
  d := XmlParse(Text);
  els := nil;
  cnt := 0;
  Elements(d.Root, els, cnt);
  n := els[K];
  path := PathOf(n);
  s := n.Offset + 1;
  e := n.Offset + n.ByteLength + 1;
  prefix := Copy(Text, 1, s - 1);
  suffix := Copy(Text, e, Length(Text) - e + 1);
  na := n.AttrCount;
  nk := n.Count;
  firstAttr := '';
  for i := 0 to na - 1 do
    if (not n.AttrAt(i).IsNs) and (firstAttr = '') then
      firstAttr := n.AttrAt(i).Name;
  par := n.Parent;
  nsdef := '';
  if Op = 1 then
    if firstAttr = '' then
      Exit;
  if (Op = 5) and (par = nil) then
    Exit;
  Edits := Edits + 1;
  case Op of
    0: n.SetAttr('zz', 'v<&>"''');
    1: n.RemoveAttr(firstAttr);
    2: n.SetText('t<&]]>t');
    3:
      begin
        m := n.AddElem('zz');
        m.AppendText('x');
      end;
    4: n.AppendXml('<n a="1">t&amp;</n><!--c-->');
    5: n.Detach;
  end;
  outx := d.Xml;
  if Op = 5 then
    x := ''
  else
    x := n.OuterXml;
  ok := True;
  if outx <> prefix + x + suffix then
  begin
    ok := False;
    Fail('outside bytes changed: op ' + IntToStr(Op) + ' element ' + IntToStr(K) + ' of ' + HexOf(Text));
  end;
  if ok then
  begin
    try
      d2 := XmlParse(outx);
    except
      on E2: EXmlError do
      begin
        ok := False;
        Fail('does not read again: op ' + IntToStr(Op) + ' ' + E2.Message);
      end;
    end;
  end;
  if ok then
  begin
    m := Follow(d2, path);
    case Op of
      0: ok := (m <> nil) and (m.Attr('zz') = 'v<&>"''') and (m.AttrCount = na + 1);
      1: ok := (m <> nil) and
           (((not m.HasAttr(firstAttr)) and (m.AttrCount = na - 1)) or
            { the DOCTYPE gives it back as a default }
            (m.HasAttr(firstAttr) and m.AttrAt(m.AttrIndex(firstAttr)).Defaulted and (m.AttrCount = na)));
      2: ok := (m <> nil) and (m.Text = 't<&]]>t') and (m.Count = 1);
      3: ok := (m <> nil) and (m.Count = nk + 1) and (m.Item(nk).Local = 'zz') and (m.Item(nk).Text = 'x');
      4: ok := (m <> nil) and (m.Count = nk + 2) and (m.Item(nk).Local = 'n') and (m.Item(nk).Attr('a') = '1') and
           (m.Item(nk).Text = 't&') and (m.Item(nk + 1).Kind = xkComment) and (m.Item(nk).URI = DefaultNs(m));
      5: ok := (par <> nil) and (d2.Root <> nil);
    end;
    if not ok then
      Fail('reread differs: op ' + IntToStr(Op) + ' element ' + IntToStr(K) + ' of ' + HexOf(Text));
  end;
  if ok then
    EditsOk := EditsOk + 1;
end;

procedure RunCorpus;
var
  text, line, doc: string;
  p, q, nl, k, step, op, cnt: Integer;
  d: TXmlDoc;
  r: TXmlReader;
  els: TXmlNodeArray;
begin
  if not ReadFile('testdata/xmlcorpus.txt', text) then
  begin
    WriteLn('no testdata/xmlcorpus.txt');
    Halt(2);
  end;
  p := 1;
  while p <= Length(text) do
  begin
    nl := p;
    while (nl <= Length(text)) and (text[nl] <> #10) do
      nl := nl + 1;
    line := Copy(text, p, nl - p);
    p := nl + 1;
    q := Pos(' ', line);
    doc := Copy(line, q + 1, Length(line) - q);
    if doc = '-' then
      doc := ''
    else
      doc := Unhex(doc);
    try
      d := XmlParse(doc);
    except
      on E: EXmlError do
        Continue;
    end;
    Docs := Docs + 1;
    r := TXmlReader.Create(doc);
    if not r.Transcoded then
    begin
      Back := Back + 1;
      if d.Xml <> doc then
      begin
        BackBad := BackBad + 1;
        Fail('round trip: ' + HexOf(doc));
      end;
      els := nil;
      cnt := 0;
      Elements(d.Root, els, cnt);
      step := cnt div 12 + 1;
      k := 0;
      if Derived(d.Root) then
        k := cnt;
      while k < cnt do
      begin
        for op := 0 to 5 do
          TryEdit(doc, k, op);
        k := k + step;
      end;
    end;
  end;
  WriteLn('documents read ', Docs);
  WriteLn('written back as they were ', Back - BackBad, ' of ', Back);
  WriteLn('edits ', Edits, ' good ', EditsOk);
end;

{ ---- scenarios ---- }

const
  Sheet: string =
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' + #13#10 +
    '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" ' +
    'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">' +
    '<dimension ref="A1:B2"/><sheetData>' +
    '<row r="1" spans="1:2"><c r="A1" t="s"><v>0</v></c><c r="B1" s="2"><v>12.5</v></c></row>' +
    '<row r="2"><c r="A2" t="inlineStr"><is><t xml:space="preserve"> x &amp; y </t></is></c><c r="B2"/></row>' +
    '</sheetData><pageMargins left="0.7" right="0.7"/></worksheet>';

procedure Show(const Title, S: string);
begin
  WriteLn(Title, ': ', S);
end;

procedure Scenarios;
var
  d: TXmlDoc;
  sd, row, c, t: TXmlNode;
  rows: TXmlNodeArray;
  err: string;
  ok: Boolean;
  w: TXmlWriter;
  ns: string;
begin
  d := XmlParse(Sheet);
  Show('unchanged', BoolToStr(d.Xml = Sheet, True));
  Show('root', d.Root.Name + ' ' + d.Root.URI);
  Show('encoding', d.Encoding + ' ' + d.Standalone + ' ' + d.Version);
  sd := d.Root.Find('sheetData');
  rows := sd.Elems('row');
  Show('rows', IntToStr(Length(rows)) + ' ' + rows[0].Attr('r') + ' ' + rows[1].Attr('r'));
  c := rows[1].Item(0);
  Show('cell', c.Attr('r') + ' ' + c.Attr('t') + ' ' + c.Find('is/t').Text + ' [' + c.Find('is/t').Attr('xml:space') + ']');
  Show('ns lookup', BoolToStr(sd.ElemNS('http://schemas.openxmlformats.org/spreadsheetml/2006/main', 'row') <> nil, True) + ' ' +
    BoolToStr(sd.ElemNS('x', 'row') = nil, True));
  { one cell's text changed: everything else as it was }
  c.Find('is/t').SetText('nuevo <valor> & "más"');
  Show('edit text', d.Xml);
  { an attribute set, one taken off }
  rows[0].SetAttr('ht', '20');
  rows[0].RemoveAttr('spans');
  Show('edit attrs', rows[0].OuterXml);
  { a row added by XML text, in the scope of sheetData }
  sd.AppendXml('<row r="3"><c r="A3" t="inlineStr"><is><t>tres</t></is></c></row>');
  Show('append row', sd.Item(sd.Count - 1).OuterXml);
  Show('new row ns', sd.Item(sd.Count - 1).URI);
  { an element made here, put in with a prefix of the root }
  t := d.CreateElement('r:id');
  t.SetAttr('r:link', 'rId1');
  d.Root.AddChild(t);
  Show('prefixed', t.OuterXml + ' ' + t.URI);
  { a self-closed element given content, an element emptied }
  rows[1].Item(1).AppendText('v');
  Show('filled', rows[1].Item(1).OuterXml);
  rows[0].SetText('');
  Show('emptied', rows[0].OuterXml);
  { a node moved: detach and put it elsewhere }
  c := rows[1].Item(0);
  c.Detach;
  rows[0].AddChild(c);
  Show('moved', rows[0].OuterXml);
  { errors }
  ok := XmlTryParse('<a><b></a>', d, err);
  Show('try parse', BoolToStr(ok, True) + ' ' + err);
  ok := XmlTryParse('<a>' + #10 + '<b x="1" x="2"/></a>', d, err);
  Show('try parse', BoolToStr(ok, True) + ' ' + err);
  ok := XmlTryParse('<?xml version="1.0"?><a/>', d, err);
  Show('try parse', BoolToStr(ok, True) + ' ' + IntToStr(d.Count));
  try
    d := XmlParse('<a xmlns:p="u"><p:b/><q:c/></a>');
  except
    on E: EXmlError do
      Show('error', IntToStr(E.Offset) + ' ' + IntToStr(E.Line) + ' ' + IntToStr(E.Column) + ' ' + E.Reason);
  end;
  d := XmlParseFlat('<q:c x:y="1"/>');
  Show('flat', d.Root.Name + ' [' + d.Root.Local + '] [' + d.Root.Prefix + '] ' + d.Root.Attr('x:y'));
  { the editing errors }
  d := XmlParse('<a><b/></a>');
  try
    d.Root.AddChild(d.Root.Item(0));
  except
    on E: EXmlError do
      Show('edit error', E.Reason);
  end;
  try
    d.Root.SetAttr('bad name', '1');
  except
    on E: EXmlError do
      Show('edit error', E.Reason);
  end;
  try
    d.Root.Item(0).AddChild(d.Root);
  except
    on E: EXmlError do
      Show('edit error', E.Reason);
  end;
  { a CDATA section and the other kinds }
  d := XmlParse('<a><![CDATA[x<y]]><!--c--><?p d?>t</a>');
  Show('kinds', IntToStr(d.Root.Count) + ' ' + IntToStr(Ord(d.Root.Item(0).Kind)) + IntToStr(Ord(d.Root.Item(1).Kind)) +
    IntToStr(Ord(d.Root.Item(2).Kind)) + IntToStr(Ord(d.Root.Item(3).Kind)));
  Show('text', d.Root.Text);
  d.Root.Item(0).Value := 'a]]>b';
  Show('cdata set', d.Xml);
  d.Root.Item(1).Value := ' k ';
  d.Root.Item(2).Value := 'e f';
  Show('comment pi', d.Xml);
  { a made document }
  d := TXmlDoc.Create;
  d.AddTop(d.CreateComment(' made '));
  d.AddTop(d.CreateElement('r'));
  d.Root.SetAttr('a', 'x"y');
  d.Root.AppendText('1 < 2');
  d.Root.AddElem('e');
  Show('made', d.Xml);
  { the writer }
  w := TXmlWriter.Create;
  w.Decl('yes');
  w.Start('worksheet');
  w.Attr('xmlns', 'urn:x');
  w.Start('row');
  w.Attr('r', '1');
  w.Start('c');
  w.Attr('t', 'inlineStr');
  w.Start('is');
  w.Element('t', ' a & b ');
  w.EndElement;
  w.EndElement;
  w.Start('c');
  w.EndElement;
  w.EndElement;
  w.Comment(' end ');
  w.EndElement;
  Show('writer', w.Output);
  w := TXmlWriter.Create;
  w.Indent := '  ';
  w.Start('a');
  w.Start('b');
  w.Text('x');
  w.EndElement;
  w.Start('c');
  w.Element('d', '');
  w.Raw('<raw/>');
  w.EndElement;
  w.CData('a]]>b');
  w.EndElement;
  Show('indented', w.Output);
  { escaping }
  Show('escape text', XmlEscapeText('a<b>&"c''' + #13 + #1 + 'é'));
  Show('escape attr', XmlEscapeAttr('a<b>&"c''' + #9 + #10 + #13));
  Show('names', BoolToStr(XmlIsName('a:b'), True) + BoolToStr(XmlIsNCName('a:b'), True) + BoolToStr(XmlIsName('1a'), True) +
    BoolToStr(XmlIsName('é-.'), True) + BoolToStr(XmlIsName(''), True));
end;

{ ---- the reader's own limits ---- }

procedure Limits;
var
  r: TXmlReader;
  tok: TXmlToken;
  s: string;
  i, n: Integer;
begin
  s := '';
  for i := 1 to 100 do
    s := s + '<a>';
  for i := 1 to 100 do
    s := s + '</a>';
  r := TXmlReader.Create(s);
  r.MaxDepth := 50;
  try
    while r.Next(tok) do;
    WriteLn('depth: no error');
  except
    on E: EXmlError do
      WriteLn('depth: ', E.Reason);
  end;
  r := TXmlReader.Create('<!DOCTYPE a [<!ENTITY x "0123456789"><!ENTITY y "&x;&x;&x;&x;&x;&x;&x;&x;&x;&x;">' +
    '<!ENTITY z "&y;&y;&y;&y;&y;&y;&y;&y;&y;&y;">]><a>&z;&z;&z;</a>');
  r.MaxExpansion := 100;
  try
    while r.Next(tok) do;
    WriteLn('expansion: no error');
  except
    on E: EXmlError do
      WriteLn('expansion: ', E.Reason);
  end;
  r := TXmlReader.Create('<!DOCTYPE a [<!ENTITY x "0123456789"><!ENTITY y "&x;&x;&x;&x;&x;&x;&x;&x;&x;&x;">' +
    '<!ENTITY z "&y;&y;&y;&y;&y;&y;&y;&y;&y;&y;">]><a>&z;&z;&z;</a>');
  n := 0;
  while r.Next(tok) do
    if tok.Kind = xtText then
      n := n + Length(tok.Value);
  WriteLn('expanded: ', n);
  r := TXmlReader.Create('<a><b><c/>x</b><d/></a>');
  r.Next(tok);
  r.Next(tok);
  WriteLn('skip: ', tok.Name, ' depth ', r.OpenCount);
  r.SkipElement;
  WriteLn('skip: depth ', r.OpenCount);
  r.Next(tok);
  WriteLn('skip: next is ', tok.Name, ' ', Ord(tok.Kind));
  r := TXmlReader.CreateFragment('x<b p:y="1"/>z<!--c-->');
  r.Bind('p', 'urn:p');
  n := 0;
  while r.Next(tok) do
  begin
    n := n + 1;
    if tok.Kind = xtStart then
      WriteLn('fragment: ', tok.Name, ' ', tok.Attrs[0].URI);
  end;
  WriteLn('fragment tokens: ', n);
end;

begin
  RunCorpus;
  Scenarios;
  Limits;
  WriteLn('failures ', Fails);
end.
