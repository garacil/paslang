{ P446: pasxml reads the DOCTYPE's internal subset as XML 1.0 5.1 asks of a
  processor that reads it: an internal entity whose text holds markup is
  content, read where it is referenced; the attributes declared with a
  default value are on the start tags that do not give them, and those
  whose type is not CDATA are normalized. What the tree writes back of
  them is checked here (the corpus of testdata/xmlcorpus, against expat,
  checks what is read). }
program xmlentity;

uses
  sysutils, pasxml;

function YesNo(B: Boolean): string;
begin
  if B then
    Result := 'yes'
  else
    Result := 'no';
end;

function NodeLine(N: TXmlNode; Depth: Integer): string;
var
  i: Integer;
  a: TXmlAttr;
begin
  Result := '';
  for i := 1 to Depth do
    Result := Result + '  ';
  case N.Kind of
    xkElement:
      begin
        Result := Result + '<' + N.Name + '>';
        for i := 0 to N.AttrCount - 1 do
        begin
          a := N.AttrAt(i);
          Result := Result + ' ' + a.Name + '=[' + a.Value + ']';
          if a.Defaulted then
            Result := Result + '*';
        end;
      end;
    xkText: Result := Result + 'text [' + N.Text + ']';
    xkComment: Result := Result + 'comment';
    xkPI: Result := Result + 'pi ' + N.Name;
    xkCData: Result := Result + 'cdata [' + N.Text + ']';
  else
    Result := Result + 'other';
  end;
  if N.Offset < 0 then
    Result := Result + ' (from an entity)';
end;

procedure Dump(N: TXmlNode; Depth: Integer);
var
  i: Integer;
begin
  WriteLn(NodeLine(N, Depth));
  for i := 0 to N.Count - 1 do
    Dump(N.Item(i), Depth + 1);
end;

procedure ShowTree(const Title, Text: string);
var
  d: TXmlDoc;
begin
  WriteLn('== ', Title);
  d := XmlParse(Text);
  Dump(d.Root, 0);
  WriteLn('written back as it was: ', YesNo(d.Xml = Text));
end;

function Pad(N: Integer): string;
begin
  Result := 'x';
  while Length(Result) < N do
    Result := Result + Result;
  Result := Copy(Result, 1, N);
end;

procedure Refuse(const Text: string);
var
  d: TXmlDoc;
  err: string;
begin
  if XmlTryParse(Text, d, err) then
    WriteLn('read: ', Text)
  else
    WriteLn('refused: ', err);
end;

function Walk(N: TXmlNode; const Path: string): TXmlNode;
var
  i, k: Integer;
begin
  Result := N;
  i := 1;
  while i <= Length(Path) do
  begin
    k := Ord(Path[i]) - 48;
    Result := Result.Item(k);
    i := i + 1;
  end;
end;

procedure Tokens(const Text: string);
var
  r: TXmlReader;
  tok: TXmlToken;
  s: string;
begin
  r := TXmlReader.Create(Text);
  while r.Next(tok) do
  begin
    case tok.Kind of
      xtStart: s := 'start ' + tok.Name;
      xtEnd: s := 'end ' + tok.Name;
      xtText: s := 'text [' + tok.Value + ']';
      xtCData: s := 'cdata';
      xtComment: s := 'comment';
      xtPI: s := 'pi';
      xtDecl: s := 'decl';
    else
      s := 'doctype';
    end;
    if tok.Ent then
      s := s + ' (entity)';
    WriteLn('  ', s);
  end;
end;

var
  d: TXmlDoc;
  n: TXmlNode;
  t: string;

begin
  t := '<!DOCTYPE a [<!ENTITY e "<b x=''1''>t</b>u">]>' + #10 + '<a>[&e;]<c/></a>';
  ShowTree('markup in an entity', t);
  WriteLn('== the tokens');
  Tokens(t);
  d := XmlParse(t);
  WriteLn('== set an attribute of the entity''s element');
  Walk(d.Root, '1').SetAttr('x', '2');
  WriteLn(d.Xml);
  d := XmlParse(t);
  WriteLn('== edit an element next to it: the reference is written as its text');
  Walk(d.Root, '4').SetAttr('y', '3');
  WriteLn(d.Xml);
  d := XmlParse(t);
  WriteLn('== text replaced in the entity''s element');
  Walk(d.Root, '1').SetText('new');
  WriteLn(d.Xml);
  d := XmlParse(t);
  WriteLn('== the parent''s text replaced');
  d.Root.SetText('only');
  WriteLn(d.Xml);
  d := XmlParse(t);
  WriteLn('== an element added to the parent');
  n := d.Root.AddElem('z');
  WriteLn(d.Xml);
  WriteLn('reread: ', XmlParse(d.Xml).Root.Count);

  ShowTree('nested entities, twice', '<!DOCTYPE a [<!ENTITY i "<c>&j;</c>"><!ENTITY j "t<d/>">]><a>&i;&j;</a>');
  ShowTree('comment, instruction and CDATA', '<!DOCTYPE a [<!ENTITY e "<!--c--><?p d?><![CDATA[x<y]]>">]><a>&e;</a>');
  ShowTree('a character reference to <', '<!DOCTYPE a [<!ENTITY e "&#38;#60;b/&#62;">]><a>&e;</a>');
  ShowTree('namespaces', '<!DOCTYPE a [<!ENTITY e "<p:b/><c xmlns=''u''><d/></c>">]><a xmlns:p="v">&e;<d/></a>');

  WriteLn('== refused');
  Refuse('<!DOCTYPE a [<!ENTITY e "<b>">]><a>&e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "</a><a>">]><a>&e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "</b>">]><a><b>&e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<b">]><a>&e;></a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<b/>">]><a x="&e;"/>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<?xml version=''1.0''?>">]><a>&e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<!DOCTYPE b>">]><a>&e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "]]>">]><a>&e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<b/>">]>&e;');
  Refuse('<!DOCTYPE a [<!ENTITY e "<b/>&f;">]><a>&e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<x>&f;</x>"><!ENTITY f "&e;">]><a>&e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<p:b/>">]><a>' + #10 + '  &e;</a>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<b>' + Pad(60000) + '</b>"><!ENTITY f "&e;&e;&e;&e;&e;&e;&e;&e;&e;&e;"><!ENTITY g "&f;&f;&f;&f;&f;&f;&f;&f;&f;&f;"><!ENTITY h "&g;&g;&g;&g;&g;&g;&g;&g;&g;&g;"><!ENTITY i "&h;&h;&h;&h;&h;&h;&h;&h;&h;&h;"><!ENTITY j "&i;&i;&i;&i;&i;&i;&i;&i;&i;&i;"><!ENTITY k "&j;&j;&j;&j;&j;&j;&j;&j;&j;&j;"><!ENTITY l "&k;&k;&k;&k;&k;&k;&k;&k;&k;&k;"><!ENTITY m "&l;&l;&l;&l;&l;&l;&l;&l;&l;&l;"><!ENTITY n "&m;&m;&m;&m;&m;&m;&m;&m;&m;&m;"><!ENTITY o "&n;&n;&n;&n;&n;&n;&n;&n;&n;&n;">]><a>&o;</a>');

  ShowTree('a default value', '<!DOCTYPE a [<!ATTLIST a x CDATA "1" y CDATA "2">]><a y="9"><b/></a>');
  d := XmlParse('<!DOCTYPE a [<!ATTLIST a x CDATA "1" y CDATA "2">]><a y="9"/>');
  WriteLn('== set a defaulted attribute');
  d.Root.SetAttr('x', '5');
  WriteLn(d.Xml);
  d := XmlParse('<!DOCTYPE a [<!ATTLIST a x CDATA "1" y CDATA "2">]><a y="9"/>');
  WriteLn('== set another: the defaults are not written');
  d.Root.SetAttr('z', '5');
  WriteLn(d.Xml);
  WriteLn('x is defaulted: ', YesNo(d.Root.AttrAt(d.Root.AttrIndex('x')).Defaulted));
  d := XmlParse('<!DOCTYPE a [<!ATTLIST a x CDATA "1" y CDATA "2">]><a y="9"/>');
  WriteLn('== remove an explicit one');
  d.Root.RemoveAttr('y');
  WriteLn(d.Xml);
  d := XmlParse('<!DOCTYPE a [<!ATTLIST a x CDATA "1">]><a><b>t</b></a>');
  WriteLn('== edit a child: the start tag is as it was');
  Walk(d.Root, '0').SetText('u');
  WriteLn(d.Xml);
  ShowTree('types normalize', '<!DOCTYPE a [<!ATTLIST a x NMTOKEN " p  q " y NMTOKENS #IMPLIED z CDATA #IMPLIED>]><a y="  c   d  " z="  e   f "/>');
  ShowTree('first declaration stands', '<!DOCTYPE a [<!ATTLIST a x CDATA "1"><!ATTLIST a x CDATA "2" y CDATA "3">]><a/>');
  ShowTree('a default by entity and character reference', '<!DOCTYPE a [<!ENTITY e "v"><!ATTLIST a x CDATA "[&e;&#65;&amp;]">]><a/>');
  ShowTree('an element without a declaration, and #FIXED', '<!DOCTYPE a [<!ATTLIST a x CDATA #FIXED "f">]><a><b/></a>');
  d := XmlParse('<!DOCTYPE a [<!ATTLIST a xmlns CDATA "urn:d" xmlns:p CDATA "urn:p" p:q CDATA "1">]><a><b/></a>');
  WriteLn('== a namespace by default');
  WriteLn(d.Root.URI, ' ', Walk(d.Root, '0').URI, ' ', d.Root.AttrNS('urn:p', 'q'));
  d := XmlParseFlat('<!DOCTYPE a [<!ATTLIST a xmlns CDATA "urn:d" p:q CDATA "1">]><a/>');
  WriteLn('flat: [', d.Root.Attr('xmlns'), '] [', d.Root.Attr('p:q'), '] [', d.Root.URI, ']');
  WriteLn('== refused');
  Refuse('<!DOCTYPE a [<!ATTLIST a p:q CDATA "1">]><a/>');
  Refuse('<!DOCTYPE a [<!ATTLIST a xmlns:p CDATA "u" xmlns:q CDATA "u" p:x CDATA "1" q:x CDATA "2">]><a/>');
  Refuse('<!DOCTYPE a [<!ATTLIST a xmlns CDATA "http://www.w3.org/XML/1998/namespace">]><a/>');
  Refuse('<!DOCTYPE a [<!ATTLIST a x CDATA "<">]><a/>');
  Refuse('<!DOCTYPE a [<!ENTITY e "<b/>"><!ATTLIST a x CDATA "&e;">]><a/>');
  Refuse('<!DOCTYPE a [<!ATTLIST a xmlns:x NMTOKEN #IMPLIED>]><a xmlns:x=" u " xmlns:y="u" x:z="1" y:z="2"/>');
end.
