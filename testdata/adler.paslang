program adler;

{ P532: Adler-32 of data made from a seed, for lengths around every boundary of the eight-byte step and of the mebibyte between reductions, from the start value 1 and from others }

uses
  sysutils, pashash;

var
  seed: Int64;

function Rnd: Integer;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := Integer((seed shr 33) and 255);
end;

function Data(n, kind: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, n);
  for i := 1 to n do
    case kind of
      0: Result[i] := Chr(Rnd);
      1: Result[i] := Chr(255);
      2: Result[i] := Chr(0);
    else
      Result[i] := Chr(97 + (i mod 7));
    end;
end;

procedure One(n, kind, start: Integer);
var
  s: string;
begin
  seed := 449 + n * 31 + kind;
  s := Data(n, kind);
  WriteLn(n, ' ', kind, ' ', start, ' ', PasAdler32(s, start));
end;

var
  n, k: Integer;
begin
  for n := 0 to 70 do
    for k := 0 to 3 do
      One(n, k, 1);
  for n := 0 to 20 do
    One(n * 7 + 100, 0, 0);
  for k := 0 to 3 do
  begin
    One(1048575, k, 1);
    One(1048576, k, 1);
    One(1048577, k, 1);
    One(1048576 + 8, k, 65521 * 65536 - 1);
    One(2097152 + 13, k, 1);
    One(3000001, k, 12345 + 678 * 65536);
  end;
end.
