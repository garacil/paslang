{ P298: a lea of a base, an index and a displacement, and one of a base
  of rbp or r13 beside an index, is two leas of two components each when
  -cpu or -tune names a processor where it is slow (Intel's from Sandy
  Bridge to Skylake and Cascade Lake: 3 cycles on port 1 alone), in the
  compiled code and in the runtime, and stays whole where it is not
  (AMD's, Ice Lake and later, none named). The forms: the address of an
  element of a local array of records (a base of rbp), a field of an
  element of a heap array of records, y + k * x + c, 2 * x + 1, an
  element of 16 bytes reached through a register, on edge values; the
  same output for every processor. }
program leasplit;

type
  TRec = record
    B: Byte;
    W: Word;
    X: Int32;
    Q: Integer;
  end;
  TPair = record
    A, B: Integer;
  end;

var
  hp: array of TRec;
  pr: array of TPair;

function Locals(n: Integer): Integer;
var
  lr: array[0..7] of TRec;
  la: array[0..9] of Integer;
  k, t: Integer;
begin
  for k := 0 to 9 do
    la[k] := k * k + n;
  for k := 0 to 7 do
  begin
    lr[k].B := Byte(k + 250);
    lr[k].W := Word(k * 1000 + 60000);
    lr[k].X := Int32(k * 70000 - 100000);
    lr[k].Q := la[k + 2];
  end;
  t := 0;
  for k := 0 to 7 do
    t := t + lr[k].B + lr[k].W + lr[k].X + lr[k].Q;
  Result := t;
end;

function Heaps(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(hp, n);
  for k := 0 to n - 1 do
  begin
    hp[k].B := Byte(k);
    hp[k].W := Word(k * 3);
    hp[k].X := Int32(-k);
    hp[k].Q := k * 1000003;
  end;
  t := 0;
  for k := 0 to n - 1 do
    t := t + hp[k].B + hp[k].W + hp[k].X + hp[k].Q;
  Result := t;
end;

function PairSum(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(pr, n);
  for k := 0 to n - 1 do
  begin
    pr[k].A := k;
    pr[k].B := 2 * k + 1;
  end;
  t := 0;
  for k := 0 to n - 1 do
    t := t + pr[k].A * 3 + pr[k].B;
  Result := t;
end;

function Sums(a, b: Integer): Integer;
var
  t: Integer;
begin
  t := a + 4 * b + 7;
  t := t + 2 * a + 1;
  t := t + (b + 8 * a - 9);
  Result := t;
end;

var
  i, t: Integer;
  s: string;
begin
  WriteLn(Locals(0), ' ', Locals(-5), ' ', Locals(High(Int32)));
  WriteLn(Heaps(1), ' ', Heaps(1000));
  WriteLn(PairSum(1), ' ', PairSum(5000));
  t := 0;
  for i := -1000 to 1000 do
    t := t + Sums(i, i * 7 - 3);
  WriteLn(t, ' ', Sums(High(Integer), 1), ' ', Sums(Low(Integer), -1));
  s := '';
  for i := 1 to 300 do
    s := s + Chr(65 + i mod 26);
  WriteLn(Length(s), ' ', Copy(s, 290, 11));
end.
