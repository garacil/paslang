  P477: pasxml reads an external parsed entity through a resolver the program
  gives. Generated by scripts/gen_xmlext.py: 36 documents whose entities have
  the bytes served from memory; the line each prints is what pyexpat makes of
  the same documents (the text of the document in hex and the names of its
  elements, or ERR); then the checks that expat has no word for. }
program xmlext;

uses
  sysutils, pasxml;

var
  Names, Datas: array of string;
  Key, DocHex, LastPub, LastSys: string;
  Calls: Integer;

function FromHex(const H: string): string;
var
  i: Integer;
begin
  SetLength(Result, Length(H) div 2);
  for i := 1 to Length(H) div 2 do
    Result[i] := Chr(StrToInt('$' + Copy(H, i * 2 - 1, 2)));
end;

function ToHex(const S: string): string;
const
  D = '0123456789abcdef';
var
  i: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
    Result := Result + D[(Ord(S[i]) shr 4) + 1] + D[(Ord(S[i]) and 15) + 1];
end;

procedure Begin_(const K: string);
begin
  Key := K;
  Names := nil;
  Datas := nil;
  Calls := 0;
end;

procedure Doc_(const H: string);
begin
  DocHex := H;
end;

procedure Ent_(const N, H: string);
begin
  SetLength(Names, Length(Names) + 1);
  SetLength(Datas, Length(Datas) + 1);
  Names[High(Names)] := N;
  Datas[High(Datas)] := H;
end;

function Serve(const PublicId, SystemId: string): string;
var
  i: Integer;
begin
  Calls := Calls + 1;
  LastPub := PublicId;
  LastSys := SystemId;
  for i := 0 to High(Names) do
    if Names[i] = SystemId then
    begin
      Result := FromHex(Datas[i]);
      Exit;
    end;
  raise Exception.Create('no entity ' + SystemId);
end;

procedure Walk(N: TXmlNode; var L: string);
var
  i: Integer;
begin
  for i := 0 to N.Count - 1 do
    if N.Item(i).Kind = xkElement then
    begin
      if L <> '' then
        L := L + ',';
      L := L + N.Item(i).Name;
      Walk(N.Item(i), L);
    end;
end;

procedure Run_(Dtd: Boolean);
var
  d: TXmlDoc;
  l, t: string;
begin
  try
    if Dtd then
      d := XmlParseDtd(FromHex(DocHex), @Serve, False)
    else
      d := XmlParseWith(FromHex(DocHex), @Serve, False);
    l := d.Root.Name;
    Walk(d.Root, l);
    t := ToHex(d.Root.Text);
    if t = '' then
      t := '-';
    WriteLn(Key, ' OK ', t, ' ', l);
  except
    on E: EXmlError do
      WriteLn(Key, ' ERR');
  end;
end;

procedure Go_;
begin
  Run_(False);
end;

procedure GoD_;
begin
  Run_(True);
end;

function MsgOf(const Src: string; R: TXmlResolver; Limit: Integer): string;
var
  rd: TXmlReader;
  tok: TXmlToken;
begin
  Result := 'OK';
  try
    rd := TXmlReader.Create(Src);
    rd.Namespaces := False;
    rd.Resolver := R;
    if Limit > 0 then
      rd.MaxExpansion := Limit;
    while rd.Next(tok) do
      ;
  except
    on E: EXmlError do
      Result := E.Message;
  end;
end;

procedure Chk(const Id: string; Ok: Boolean; const Why: string);
begin
  if Ok then
    WriteLn(Id, ' ok')
  else
    WriteLn(Id, ' WRONG ', Why);
end;

function Has(const S, Sub: string): Boolean;
begin
  Result := Pos(Sub, S) > 0;
end;

function Doc1(const Decls, Body: string): string;
begin
  Result := '<!DOCTYPE doc [' + Chr(10) + '<!ELEMENT doc ANY>' + Chr(10) + Decls + ']>' + Chr(10) + Body;
end;

function RaiseXml(const PublicId, SystemId: string): string;
begin
  raise EXmlError.CreateAt(0, 1, 1, 'mine');
end;

var
  m, src, decls: string;
  d: TXmlDoc;
  rd: TXmlReader;
  tok: TXmlToken;
  n, k: Integer;

begin
