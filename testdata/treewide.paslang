program treewide;
type
  TR = record B: Byte; Text: string; N: Integer end;
  TInts = array of Integer;
  TBytes = array[0..2] of Byte;
  TF = function: Integer;
  TBigSet = set of Byte;
var
  T: tree[Integer] of TR;
  M: map[Integer] of TR;
  Slices: tree[Integer] of TInts;
  Arrays: tree[Integer] of TBytes;
  Functions: tree[Integer] of TF;
  Sets: tree[Integer] of TBigSet;
  Narrow: tree[Byte] of Byte;
  R, V: TR;
  D: TInts;
  A: TBytes;
  F: TF;
  K, I, Total: Integer;
  BK, BV: Byte;
  Big: TBigSet;

function Closure: TF;
var X: Integer;
begin
  X := 41;
  Result := function: Integer begin X := X + 1; Result := X end;
end;

begin
  R := T[9];
  WriteLn('zero ', R.B, ' ', R.N, ' ', Length(R.Text), ' ', Length(T));
  New(T);
  R.B := 123; R.N := 456; R.Text := 'value';
  T[64] := R;
  for I := 31 downto 0 do T[I] := T[64];
  T[32] := T[64];
  for I := 0 to 32 do
    if (T[I].B <> 123) or (T[I].N <> 456) or (T[I].Text <> 'value') then Halt(2);
  R.Text[1] := 'R';
  T[64].Text[1] := 'T';
  WriteLn('copy ', Length(T), ' ', T[0].B, ' ', T[32].N, ' ', T[0].Text,
    ' ', T[64].Text, ' ', R.Text);
  Total := 0;
  for K, V in T do Total := Total + V.N;
  WriteLn('walk ', Total);
  V := Default(TR);
  WriteLn('try ', TryGet(T, 32, V), ' ', V.B, ' ', V.N, ' ', V.Text);
  WriteLn('pop ', PopLow(T, K, V), ' ', K, ' ', V.N, ' ', Length(T));
  T[90] := Default(TR);
  WriteLn('default ', T[90].N, ' ', Length(T[90].Text));
  New(M);
  M[0] := R;
  for I := 1 to 3000 do M[I] := M[0];
  M[3001] := Default(TR);
  WriteLn('map-copy ', M[2999].N, ' ', M[2999].Text, ' ', M[3001].N);
  New(Slices);
  D := [10, 20, 30];
  Slices[1] := D;
  D := Slices[1];
  D := Append(D, 40);
  WriteLn('slice ', Length(Slices[1]), ' ', Cap(Slices[1]), ' ', D[3],
    ' ', Length(Slices[9]), ' ', Cap(Slices[9]));
  New(Arrays);
  A[0] := 11; A[1] := 22; A[2] := 33;
  for I := 0 to 100 do Arrays[I] := A;
  Total := 0;
  for K, A in Arrays do Total := Total + A[0] + A[1] + A[2];
  WriteLn('array ', Total, ' ', Arrays[9][1], ' ', Arrays[999][2]);
  New(Functions);
  Functions[1] := Closure;
  GcCollect;
  F := Functions[1];
  WriteLn('closure ', F(), ' ', F());
  New(Sets);
  Big := [0, 63, 64, 255];
  Sets[1] := Big;
  Big := Sets[1];
  WriteLn('set ', 0 in Big, ' ', 63 in Big, ' ', 64 in Big, ' ', 255 in Big,
    ' ', 254 in Sets[999]);
  New(Narrow);
  for I := 0 to 100 do Narrow[Byte(I)] := Byte(I);
  Total := 0;
  for BK, BV in Narrow do Total := Total + Integer(BK) + Integer(BV);
  WriteLn('narrow ', Total);
end.
