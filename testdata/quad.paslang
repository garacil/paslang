program quad;

{ Quad is IEEE binary128 (P103): 16 bytes, 113 bits of significand, the
  same bits on both machines. Every value here is checked against the
  same program in C with GCC's __float128 (docs/QUAD.md). }

type
  TPair = record
    Tag: Integer;
    Q: Quad;
  end;

var
  g: Quad;
  d, z: Double;
  s: Single;
  r: TPair;
  a: array[0..2] of Quad;
  da: array of Quad;
  i: Integer;

function Third: Quad;
begin
  Result := Quad(1) / 3;
end;

function Halve(q: Quad): Quad;
begin
  q := q / 2;                     { a value parameter is a copy }
  Exit(q);
end;

procedure Twice(var q: Quad);
begin
  q := q * 2;
end;

procedure Show(const Name: string; q: Quad);
begin
  WriteLn(Name, ' ', q:0:36);
end;

begin
  g := 0.1;                                  { rounded once, to 113 bits }
  d := 0.1;
  Show('0.1q', g);
  WriteLn('0.1d ', d:0:36);
  Show('third', Third);
  Show('halve', Halve(g));
  Show('g', g);                              { unchanged by Halve }
  Twice(g);
  Show('twice', g);
  d := 0.1;
  g := d * d;                                { worked out in Quad }
  Show('d*d', g);
  Show('Q(d*d)', Quad(d * d));
  WriteLn('dd ', d * d:0:36);                { worked out in Double }
  Show('pi', Quad(Pi));
  Show('sqrt2', Sqrt(Quad(2)));
  g := 9223372036854775807;
  Show('max+1', g + 1);
  r.Tag := 7;
  r.Q := Quad(2) / 3;
  Show('field', r.Q);
  for i := 0 to 2 do
    a[i] := Quad(i) / 7;
  Show('a2', a[2]);
  SetLength(da, 3);
  da[1] := a[1] + a[2];
  Show('da1', da[1]);
  g := -2.5;
  WriteLn('conv ', Trunc(g), ' ', Round(g), ' ', Floor(g), ' ', Ceil(g));
  Show('int', Int(Quad(-7.75)));
  Show('frac', Frac(Quad(-7.75)));
  Show('abs', Abs(g));
  Show('sqr', Sqr(Quad(1) / 3));
  Show('neg', -Third);
  Show('min', Min(Quad(1) / 3, 0.25));
  Show('max', Max(Quad(1) / 3, 0.25));
  d := Double(Third);
  s := Single(Third);
  WriteLn('back ', d:0:20, ' ', s:0:10);
  WriteLn('cmp ', Third < 0.34, ' ', Third > 0.34, ' ', Third = Quad(1) / 3,
    ' ', Third <> Quad(1) / 3, ' ', Third <= Third, ' ', Third >= 0.5);
  z := 0.0;
  g := z / z;                                { a NaN: no order holds }
  WriteLn('nan ', g, ' ', g = g, ' ', g <> g, ' ', g < 1, ' ', g >= 1);
  g := 1.0 / z;
  WriteLn('inf ', g, ' ', -g);
  WriteLn('plain ', Third, ' ', Quad(0.5), ' ', Quad(-0.0));
  WriteLn('size ', SizeOf(Quad), ' ', SizeOf(r));
end.
