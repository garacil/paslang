{ P618: a closure shares every variable a select names, also one named
  only as an arm's channel or as the value a send arm sends. Before, it
  did not: the channel read nil (`nil channel`) and a loop's counter was
  read from a frame that was gone. In a closure value, in pas procedure
  ... end, with a loop's counter kept a pass apart, and for both kinds
  of arm. }
program selclosure;

uses
  sysutils;

procedure SendArm;
var
  c: chan of Integer;
  f: procedure;
begin
  c := MakeChan(1);
  f := procedure
    begin
      select
        Send(c, 7): ;
      else
        WriteLn('full');
      end;
    end;
  f();
  WriteLn('a send arm''s channel in a closure: ', Recv(c));
end;

procedure SendValue;
var
  c: chan of Integer;
  v: Integer;
  f: procedure;
begin
  c := MakeChan(1);
  v := 41;
  f := procedure
    begin
      select
        Send(c, v + 1): ;
      else
        WriteLn('full');
      end;
    end;
  f();
  WriteLn('a send arm''s value in a closure: ', Recv(c));
end;

procedure RecvArm;
var
  c: chan of Integer;
  x: Integer;
  f: procedure;
begin
  c := MakeChan(1);
  Send(c, 5);
  x := 0;
  f := procedure
    begin
      select
        Recv(c, x): WriteLn('a receive arm''s channel in a closure: got ', x);
      else
        WriteLn('none');
      end;
    end;
  f();
  WriteLn('and the variable it received into, shared: ', x);
end;

procedure LoopCounter;
var
  ch: chan of Integer;
  fs: array of procedure;
  i: Integer;
begin
  ch := MakeChan(8);
  SetLength(fs, 3);
  for i := 0 to 2 do
    fs[i] := procedure
      begin
        select
          Send(ch, i * 10): ;
        else
          WriteLn('full');
        end;
      end;
  for i := 0 to 2 do
    fs[i]();
  WriteLn('a loop''s counter, a pass apart: ', Recv(ch), ' ', Recv(ch), ' ', Recv(ch));
end;

procedure InRoutine;
var
  c, done: chan of Integer;
  v: Integer;
begin
  c := MakeChan(1);
  done := MakeChan(1);
  v := 9;
  pas procedure
    begin
      select
        Send(c, v): ;
      else
        WriteLn('full');
      end;
      Send(done, 1);
    end;
  v := Recv(done);
  WriteLn('pas procedure: a send arm''s channel and value: ', Recv(c));
end;

begin
  SendArm;
  SendValue;
  RecvArm;
  LoopCounter;
  InRoutine;
end.
