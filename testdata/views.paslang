program views;

{ x as T (P105, 1.0.119): the bytes of x seen as T, read and written,
  not converted: a Double's bits, a Single's, the low byte of a Word, a
  record's bytes as another record or an array, a Quad's words, a
  string's characters (made its own first), a slice's elements, raw
  memory; compound assignment, Inc and SetBit through a view. }

type
  TRec = record
    A: Word;
    B: Byte;
    C: Int32;
  end;
  TPair = record
    Lo, Hi: UInt32;
  end;

var
  d: Double;
  i: Integer;
  u: UInt32;
  sg: Single;
  w: Word;
  s8: Int8;
  r: TRec;
  q: Quad;
  s, s2: string;
  da: array of Word;
  p: Pointer;

begin
  d := -2.5;
  WriteLn(d as UInt64, ' ', IsBitSet(d as UInt64, 63));
  (d as UInt64) := (d as UInt64) xor $8000000000000000;
  WriteLn(d);
  (d as UInt64) xor= $8000000000000000;
  WriteLn(d);
  i := $3FF0000000000000;
  WriteLn(i as Double);
  u := $40490FDB;
  WriteLn(u as Single);
  sg := 1.0;
  (sg as UInt32) or= 1;
  WriteLn(sg as UInt32);
  w := $1234;
  WriteLn(w as Byte, ' ', w as Int8);
  (w as Byte) := $FF;
  WriteLn(w, ' ', w as Int8);
  s8 := -1;
  WriteLn(s8 as Byte);
  i := $100 + 250;
  Inc(i as Byte, 10);
  SetBit(i as Word, 15, 1);
  WriteLn(i);
  r.A := $0102;
  r.B := 3;
  r.C := -1;
  WriteLn((r as TPair).Lo, ' ', (r as TPair).Hi, ' ', r as Integer);
  (r as TPair).Hi := 7;
  (r as array[0..7] of Byte)[2] := 9;
  WriteLn(r.A, ' ', r.B, ' ', r.C);
  q := 1;
  WriteLn((q as array[0..1] of Integer)[1], ' ', (q as array[0..1] of Integer)[0]);
  (q as array[0..1] of Integer)[1] := (q as array[0..1] of Integer)[1] or $8000000000000000;
  WriteLn(q:0:1);
  s := 'AB' + 'CD';
  s2 := s;
  WriteLn(s as UInt32);
  (s as array[0..3] of Char)[0] := 'Z';
  WriteLn(s, ' ', s2);
  (s as Word) := $6161;
  WriteLn(s, ' ', s2);
  SetLength(da, 2);
  da[0] := 1;
  da[1] := 2;
  WriteLn(da as UInt32);
  (da as UInt32) := $00050004;
  WriteLn(da[0], ' ', da[1]);
  p := @r;
  WriteLn(p^ as Word, ' ', (p^ as TPair).Hi);
end.

