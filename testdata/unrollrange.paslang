{ P614: empty constant ranges preserve the counter; one to four passes
  near either Integer limit remain legal. UInt64 and QWord are signed
  Integer aliases; UInt32 is the true unsigned narrow counter. }
program unrollrange;
uses sysutils;
procedure HugeUp;
var J: Integer;
begin
  for J := Low(Integer) to High(Integer) do
  begin WriteLn(J); Halt(0); end;
  Halt(1);
end;
procedure HugeDown;
var J: Integer;
begin
  for J := High(Integer) downto Low(Integer) do
  begin WriteLn(J); Halt(0); end;
  Halt(1);
end;
var I, N, Divisor: Integer; U64: UInt64; Q: QWord; U32: UInt32;
begin
  if ParamCount = 1 then
  begin
    if ParamStr(1) = 'huge-up' then HugeUp;
    if ParamStr(1) = 'huge-down' then HugeDown;
    Halt(2);
  end;
  WriteLn('case wrap-up-2');
  N := 7; I := 1000;
  for I := High(Integer) to Low(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case wrap-down-2');
  N := 8; I := 1001;
  for I := Low(Integer) downto High(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case wrap-up-3');
  N := 9; I := 1002;
  for I := High(Integer) - 1 to Low(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case wrap-down-3');
  N := 10; I := 1003;
  for I := Low(Integer) + 1 downto High(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case wrap-up-4');
  N := 11; I := 1004;
  for I := High(Integer) - 2 to Low(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case wrap-down-4');
  N := 12; I := 1005;
  for I := Low(Integer) + 2 downto High(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case empty-up');
  N := 13; I := 1006;
  for I := 3 to 2 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case empty-down');
  N := 14; I := 1007;
  for I := 2 downto 3 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case high-up-1');
  N := 15; I := 1008;
  for I := High(Integer) - 0 to High(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case high-down-1');
  N := 16; I := 1009;
  for I := High(Integer) downto High(Integer) - 0 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case low-up-1');
  N := 17; I := 1010;
  for I := Low(Integer) to Low(Integer) + 0 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case low-down-1');
  N := 18; I := 1011;
  for I := Low(Integer) + 0 downto Low(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case high-up-2');
  N := 19; I := 1012;
  for I := High(Integer) - 1 to High(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case high-down-2');
  N := 20; I := 1013;
  for I := High(Integer) downto High(Integer) - 1 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case low-up-2');
  N := 21; I := 1014;
  for I := Low(Integer) to Low(Integer) + 1 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case low-down-2');
  N := 22; I := 1015;
  for I := Low(Integer) + 1 downto Low(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case high-up-3');
  N := 23; I := 1016;
  for I := High(Integer) - 2 to High(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case high-down-3');
  N := 24; I := 1017;
  for I := High(Integer) downto High(Integer) - 2 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case low-up-3');
  N := 25; I := 1018;
  for I := Low(Integer) to Low(Integer) + 2 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case low-down-3');
  N := 26; I := 1019;
  for I := Low(Integer) + 2 downto Low(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case high-up-4');
  N := 27; I := 1020;
  for I := High(Integer) - 3 to High(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case high-down-4');
  N := 28; I := 1021;
  for I := High(Integer) downto High(Integer) - 3 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case low-up-4');
  N := 29; I := 1022;
  for I := Low(Integer) to Low(Integer) + 3 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case low-down-4');
  N := 30; I := 1023;
  for I := Low(Integer) + 3 downto Low(Integer) do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case cross-zero-up');
  N := 31; I := 1024;
  for I := -2 to 1 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case cross-zero-down');
  N := 32; I := 1025;
  for I := 1 downto -2 do
  begin N := N + 1; WriteLn(I); end;
  WriteLn(N, ' ', I);
  WriteLn('case uint64-alias-empty');
  N := 33; U64 := 1026;
  for U64 := High(UInt64) to Low(UInt64) do
  begin N := N + 1; WriteLn(U64); end;
  WriteLn(N, ' ', U64);
  WriteLn('case qword-alias-empty');
  N := 34; Q := 1027;
  for Q := Low(QWord) downto High(QWord) do
  begin N := N + 1; WriteLn(Q); end;
  WriteLn(N, ' ', Q);
  WriteLn('case uint32-empty-up');
  N := 35; U32 := 1028;
  for U32 := High(UInt32) to Low(UInt32) do
  begin N := N + 1; WriteLn(U32); end;
  WriteLn(N, ' ', U32);
  WriteLn('case uint32-empty-down');
  N := 36; U32 := 1029;
  for U32 := Low(UInt32) downto High(UInt32) do
  begin N := N + 1; WriteLn(U32); end;
  WriteLn(N, ' ', U32);
  WriteLn('case uint32-high-up');
  N := 37; U32 := 1030;
  for U32 := High(UInt32) - 3 to High(UInt32) do
  begin N := N + 1; WriteLn(U32); end;
  WriteLn(N, ' ', U32);
  WriteLn('case uint32-high-down');
  N := 38; U32 := 1031;
  for U32 := High(UInt32) downto High(UInt32) - 3 do
  begin N := N + 1; WriteLn(U32); end;
  WriteLn(N, ' ', U32);
  WriteLn('case uint32-cross-up');
  N := 39; U32 := 1032;
  for U32 := 2147483646 to 2147483649 do
  begin N := N + 1; WriteLn(U32); end;
  WriteLn(N, ' ', U32);
  WriteLn('case uint32-cross-down');
  N := 40; U32 := 1033;
  for U32 := 2147483649 downto 2147483646 do
  begin N := N + 1; WriteLn(U32); end;
  WriteLn(N, ' ', U32);
  { A failure leaves the unrolled counter at the failing pass. }
  Divisor := 0; I := 777; N := 7;
  try
    for I := High(Integer) - 2 to High(Integer) do N := 7 div Divisor;
  except
    WriteLn('caught ', I);
  end;
  I := 777; N := 7;
  try
    for I := High(Integer) to Low(Integer) do N := 7 div Divisor;
  except
    WriteLn('unexpected empty-loop exception');
  end;
  WriteLn('empty-try ', I, ' ', N);
end.
