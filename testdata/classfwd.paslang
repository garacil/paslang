{ The short class forms (P139): TFoo = class(TParent); declares a class
  with nothing of its own, and TFoo = class; or IFoo = interface;
  declares a class or an interface forward, for types that name each
  other. The output is Free Pascal's (with CORBA interfaces) but for the
  last line: Free Pascal refuses a class declared in a routine, which
  paslang takes, and Local declares two there. }
program classfwd;

type
  TNode = class;
  IShape = interface;
  TNodeClass = class of TNode;
  PNode = ^TNode;

  TList = class
    First: TNode;
    Count: Int64;
    procedure Add(N: TNode);
    function Area(S: IShape): Int64;
  end;

  TNode = class
    Next: TNode;
    Owner: TList;
    Value: Int64;
    constructor Create(V: Int64);
    function Describe: string; virtual;
  end;

  IShape = interface
    function Area: Int64;
  end;

  TSquare = class(TObject, IShape)
    Side: Int64;
    function Area: Int64;
  end;

  TBig = class(TNode);
  TBigger = class(TBig);

  EBase = class(TObject)
    Code: Int64;
  end;
  ENotFound = class(EBase);
  EGone = class(ENotFound);

var
  Seen: Int64;

type
  TLate = class;
  TLateClass = class of TLate;

procedure Touch;
begin
  Inc(Seen);
end;

type
  TLate = class
    class function Tag: string;
  end;

procedure TList.Add(N: TNode);
begin
  N.Next := First;
  N.Owner := Self;
  First := N;
  Inc(Count);
end;

function TList.Area(S: IShape): Int64;
begin
  Result := S.Area;
end;

constructor TNode.Create(V: Int64);
begin
  Value := V;
end;

function TNode.Describe: string;
begin
  Result := ClassName;
end;

function TSquare.Area: Int64;
begin
  Result := Side * Side;
end;

class function TLate.Tag: string;
begin
  Result := 'late';
end;

procedure Local;
type
  TKid = class;
  TMom = class
    Kid: TKid;
  end;
  TKid = class
    Mom: TMom;
    Age: Int64;
  end;
var
  m: TMom;
begin
  m := TMom.Create;
  m.Kid := TKid.Create;
  m.Kid.Mom := m;
  m.Kid.Age := 7;
  WriteLn('local ', m.Kid.Mom.Kid.Age, ' ', m.Kid.ClassName);
end;

var
  l: TList;
  n: TNode;
  p: PNode;
  k: TNodeClass;
  lc: TLateClass;
  s: TSquare;
  sh: IShape;
  e: EBase;
begin
  l := TList.Create;
  l.Add(TNode.Create(1));
  l.Add(TBig.Create(2));
  l.Add(TBigger.Create(3));
  n := l.First;
  while n <> nil do
  begin
    WriteLn(n.Value, ' ', n.Describe, ' ', n.Owner.Count);
    n := n.Next;
  end;
  p := @l.First;
  WriteLn('pointer ', p^.Value);
  k := TBigger;
  WriteLn('class of ', k.ClassName, ' ', k.ClassParent.ClassName, ' ', k.ClassParent.ClassParent.ClassName);
  if TBigger.InstanceSize = TNode.InstanceSize then
    WriteLn('same size');
  if TBigger.InheritsFrom(TNode) then
    WriteLn('inherits');
  s := TSquare.Create;
  s.Side := 6;
  sh := s;
  WriteLn('area ', l.Area(sh));
  lc := TLate;
  Touch;
  WriteLn(lc.Tag, ' ', Seen);
  try
    e := EGone.Create;
    e.Code := 404;
    raise e;
  except
    on x: ENotFound do
      WriteLn('caught ', x.ClassName, ' ', x.Code);
  end;
  Local;
end.

