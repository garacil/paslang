{ Four producers feed two channels; four consumers drain them through a
  select that also watches quit. Every value is unbuffered, so when the
  producers report done all values were consumed; closing quit wakes the
  consumers, which report their sums. The total is fixed whatever the
  interleaving: 4 * (1 + 2 + ... + 2000). }
program selstress;

const
  Producers = 4;
  Consumers = 4;
  Items = 2000;

var
  a, b, done, quit, sums: chan of Integer;

procedure Prod(K: Integer);
var
  i: Integer;
begin
  for i := 1 to Items do
    if Odd(i + K) then
      Send(a, i)
    else
      Send(b, i);
  Send(done, 0);
end;

procedure Cons(K: Integer);
var
  x, s: Integer;
begin
  s := 0;
  while True do
    select
      Recv(a, x): s := s + x;
      Recv(b, x): s := s + x;
      Recv(quit, x):
        begin
          Send(sums, s);
          Exit;
        end;
    end;
end;

var
  i, total: Integer;

begin
  a := MakeChan();
  b := MakeChan();
  done := MakeChan();
  quit := MakeChan();
  sums := MakeChan();
  for i := 1 to Consumers do
    pas Cons(i);
  for i := 1 to Producers do
    pas Prod(i);
  for i := 1 to Producers do
    total := Recv(done);
  Close(quit);
  total := 0;
  for i := 1 to Consumers do
    total := total + Recv(sums);
  WriteLn(total);
end.

