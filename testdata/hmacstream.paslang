{ P343: HMAC of every hash with its pad written into the state before the
  message, no copy of the message: messages at the edges of a block of
  64 and of 128 bytes and past one piece of 64 KiB, keys shorter and
  longer than the block. The answers are Python's hmac module's
  (hmacstream.out), byte for byte. }
program hmacstream;

uses paslib;

const
  Lens: array[0..13] of Integer = (0, 1, 55, 56, 63, 64, 65, 111, 112, 127, 128, 129, 1000,
    65636);

function Msg(N: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, N);
  for i := 1 to N do
    Result[i] := Char((i * 7 + 3) and 255);
end;

var
  i, k: Integer;
  m, key: string;

begin
  for k := 0 to 1 do
  begin
    if k = 0 then
      key := 'key'
    else
      key := Msg(200);
    for i := 0 to High(Lens) do
    begin
      m := Msg(Lens[i]);
      WriteLn(k, ' ', Lens[i], ' ', Hex(HmacMd5(key, m)), ' ', Hex(HmacSha1(key, m)));
      WriteLn('  ', Hex(HmacSha224(key, m)), ' ', Hex(HmacSha256(key, m)));
      WriteLn('  ', Hex(HmacSha384(key, m)));
      WriteLn('  ', Hex(HmacSha512(key, m)));
    end;
  end;
end.

