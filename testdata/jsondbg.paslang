{ P204: the debugger prints a json as Write does: its compact text,
  null for nil, the first 200 bytes and the length of a long one; a
  global, a local and a parameter, from --debug-mode and through a
  console attached to the program's socket, on both machines. }
program jsondbg;

var
  doc, big: json;
  text: string;
  i: Integer;

function Count(J: json): Integer;
var
  first: json;
begin
  first := J[0];
  Result := Length(J) + first.AsInteger;
end;

begin
  doc := JsonParse('{"name":"paslang","list":[1,2,3],"none":null}');
  text := '[';
  for i := 1 to 60 do
  begin
    if i > 1 then
      text := text + ',';
    text := text + IntToStr(i * 1000);
  end;
  text := text + ']';
  big := JsonParse(text);
  WriteLn(Count(doc['list']));
  WriteLn(Length(big));
end.

