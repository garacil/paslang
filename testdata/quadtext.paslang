{ SysUtils' digits of a Quad (P129, pasfmt's PasQuadDigits): FloatToStr,
  the fewest digits that read back as the Quad, FloatToStrF's significant
  digits and, for the values between 1e-60 and 1e60, its decimals, all
  rounded once, a tie to even, for 116 Quads from the ones checked
  against IEEE 754's binary128 worked out exactly with rationals: powers
  of 2 (whose neighbour below is nearer), subnormals, the largest,
  random ones at every exponent. A Quad is its two words, low first. }
program quadtext;

uses sysutils;

const
  N = 116;
  Words: array[0..231] of Int64 = (
    $0000000000000000, $0001000000000000, $0000000000000000, $0007000000000000,
    $0000000000000000, $000D000000000000, $0000000000000000, $0013000000000000,
    $0000000000000000, $0019000000000000, $0000000000000000, $001F000000000000,
    $0000000000000000, $0025000000000000, $0000000000000000, $002B000000000000,
    $0000000000000000, $0031000000000000, $0000000000000000, $0037000000000000,
    $0000000000000000, $3FAD000000000000, $0000000000000000, $3FB3000000000000,
    $0000000000000000, $3FB9000000000000, $0000000000000000, $3FBF000000000000,
    $0000000000000000, $3FC5000000000000, $0000000000000000, $3FCB000000000000,
    $0000000000000000, $3FD1000000000000, $0000000000000000, $3FD7000000000000,
    $0000000000000000, $3FDD000000000000, $0000000000000000, $3FE3000000000000,
    $0000000000000000, $3FE9000000000000, $0000000000000000, $3FEF000000000000,
    $0000000000000000, $3FF5000000000000, $0000000000000000, $3FFB000000000000,
    $0000000000000000, $4001000000000000, $0000000000000000, $4007000000000000,
    $0000000000000000, $400D000000000000, $0000000000000000, $4013000000000000,
    $0000000000000000, $4019000000000000, $0000000000000000, $401F000000000000,
    $0000000000000000, $4025000000000000, $0000000000000000, $402B000000000000,
    $0000000000000000, $4031000000000000, $0000000000000000, $4037000000000000,
    $0000000000000000, $403D000000000000, $0000000000000000, $4043000000000000,
    $0000000000000000, $4049000000000000, $0000000000000000, $7FBF000000000000,
    $0000000000000000, $7FC5000000000000, $0000000000000000, $7FCB000000000000,
    $0000000000000000, $7FD1000000000000, $0000000000000000, $7FD7000000000000,
    $0000000000000000, $7FDD000000000000, $0000000000000000, $7FE3000000000000,
    $0000000000000000, $7FE9000000000000, $0000000000000000, $7FEF000000000000,
    $0000000000000000, $7FF5000000000000, $0000000000000000, $7FFB000000000000,
    $0000000000000000, $641A000000000000, $0000000000000000, $71B6000000000000,
    $0000000000000000, $2A2A000000000000, $0000000000000000, $4635000000000000,
    $0000000000000000, $4877000000000000, $0000000000000000, $5D71000000000000,
    $0000000000000000, $0D4E000000000000, $0000000000000000, $5D67000000000000,
    $0000000000000000, $3611000000000000, $0000000000000000, $0C8E000000000000,
    $0000000000000000, $4F2E000000000000, $0000000000000000, $3DB3000000000000,
    $0000000000000000, $0CFC000000000000, $0000000000000000, $74D5000000000000,
    $0000000000000000, $511A000000000000, $0000000000000000, $7250000000000000,
    $0000000000000000, $29D9000000000000, $0000000000000000, $42AE000000000000,
    $0000000000000000, $6042000000000000, $0000000000000000, $2237000000000000,
    $0000000000000000, $0AED000000000000, $0000000000000000, $18FE000000000000,
    $0000000000000000, $169B000000000000, $0000000000000000, $4853000000000000,
    $0000000000000000, $312A000000000000, $0000000000000000, $4059000000000000,
    $0000000000000000, $31BD000000000000, $0000000000000000, $5E54000000000000,
    $0000000000000000, $649D000000000000, $0000000000000000, $346B000000000000,
    $0000000000000000, $3FB5000000000000, $0000000000000000, $6DCC000000000000,
    $0000000000000000, $0EF6000000000000, $0000000000000000, $3593000000000000,
    $0000000000000000, $5BB8000000000000, $0000000000000000, $2DD2000000000000,
    $0000000000000000, $16FF000000000000, $0000000000000000, $54D2000000000000,
    $0000000000000000, $7E5B000000000000, $0000000000000000, $28EA000000000000,
    $0000000000000000, $1B4F000000000000, $0000000000000000, $4497000000000000,
    $0000000000000000, $0491000000000000, $0000000000000000, $4B22000000000000,
    $0000000000000000, $041F000000000000, $0000000000000000, $6DFB000000000000,
    $0000000000000000, $7572000000000000, $0000000000000000, $46A5000000000000,
    $0000000000000000, $750F000000000000, $0000000000000000, $33D9000000000000,
    $4BDFEA16B17EBCB3, $000000000000153B, $F03D9AF8B9D85424, $0000004A65C8532D,
    $000014FDBF592207, $0000000000000000, $0000000000000001, $0000000000000000,
    $999999999999999A, $3FFB999999999999, $999999999999999A, $3FFC999999999999,
    $3333333333333333, $3FFD333333333333, $6800000000000000, $404B52D02C7E14AF,
    $C364E687DFD7A328, $3BCD03132B9CF541, $EF58D64CE2B76A4C, $43FEFFFFFFFFFFFF,
    $8469898CC51701B8, $4000921FB54442D1, $ED99D037E3D04B75, $7FFEAE596552B8FD,
    $0000000000000000, $0000000000000000, $EEAEC417172DCBAC, $40737C6E3BFD70FD,
    $0000000000000000, $4000400000000000, $0000000000000000, $3FFE000000000000,
    $0000000000000000, $3FFF800000000000, $0000000000000000, $402374876E800000);
  Moderate: array[0..115] of Boolean = (
    False, False, False, False, False, False, False, False,
    False, False, True, True, True, True, True, True,
    True, True, True, True, True, True, True, True,
    True, True, True, True, True, True, True, True,
    True, True, True, True, True, False, False, False,
    False, False, False, False, False, False, False, False,
    False, False, False, False, False, False, False, False,
    False, False, False, False, False, False, False, False,
    False, False, False, False, False, False, False, False,
    False, True, False, False, False, False, True, False,
    False, False, False, False, False, False, False, False,
    False, False, False, False, False, False, False, False,
    False, False, False, False, False, False, True, True,
    True, True, False, False, True, False, True, True,
    True, True, True, True);
  NS: array[0..11] of Integer = (1, 2, 5, 10, 17, 20, 30, 33, 34, 35, 36, 40);
  FS: array[0..4] of Integer = (0, 2, 5, 20, 40);

var
  i, k: Integer;
  q: Quad;
begin
  for i := 0 to N - 1 do
  begin
    Move(Words[2 * i], q, 16);
    Write(IntToHex(Words[2 * i + 1], 16), IntToHex(Words[2 * i], 16), ' s ', FloatToStr(q));
    for k := 0 to High(NS) do
      Write(' e', NS[k], ' ', FloatToStrF(q, ffExponent, NS[k], 4));
    if Moderate[i] then
      for k := 0 to High(FS) do
        Write(' f', FS[k], ' ', FloatToStrF(q, ffFixed, 0, FS[k]));
    WriteLn;
  end;
end.

