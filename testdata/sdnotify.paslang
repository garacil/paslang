{ passystemd (P560, 1.2.370): the datagrams SdNotifyTo sends to a socket
  this program listens on (an abstract name and a path), each arriving whole
  and in order from a sender with no name, and every address or state it
  must refuse; SdWatchdogOf on the texts of $WATCHDOG_USEC and
  $WATCHDOG_PID. With the argument env the program reads its own
  environment instead (SdNotify and SdWatchdogUsec) and prints one line;
  the Makefile runs it so with chosen values. }
program sdnotify;

uses sysutils, pasnet, passystemd;

var
  rx, i, a, b: Integer;
  name, path, rel, cwd, from, got, big: string;

function GetPid: Integer;
begin
  if Amd64 = 0 then
    Result := Syscall(172)
  else
    Result := Syscall(39);
end;

{ the line feeds of a state shown as bars }
function Vis(const S: string): string;
var
  k: Integer;
begin
  Result := '';
  for k := 1 to Length(S) do
    if S[k] = #10 then
      Result := Result + '|'
    else
      Result := Result + S[k];
end;

function Say(B: Boolean): string;
begin
  if B then
    Result := 'sent'
  else
    Result := 'refused';
end;

procedure Wd(const Usec: string; HavePid: Boolean; const PidText: string; Pid: Integer);
begin
  WriteLn('watchdog [', Usec, '] ', HavePid, ' [', PidText, '] ', Pid, ': ', SdWatchdogOf(Usec, HavePid, PidText, Pid));
end;

{ one datagram to the receiver and back }
procedure Trip(Fd: Integer; const Address, State: string);
var
  ok: Boolean;
begin
  ok := SdNotifyTo(Address, State);
  got := UnixRecvFrom(Fd, 65536, from);
  WriteLn(Say(ok), ' [', Vis(State), '] got [', Vis(got), '] same ', got = State, ' from [', from, ']');
end;

{ a datagram too long to show: its length and whether it came back whole }
procedure Whole(Fd: Integer; const Address, State: string);
var
  ok: Boolean;
begin
  ok := SdNotifyTo(Address, State);
  got := UnixRecvFrom(Fd, 65536, from);
  WriteLn(Say(ok), ' ', Length(State), ' bytes, got ', Length(got), ', same ', got = State, ' from [', from, ']');
end;

procedure Env;
var
  addr: string;
  r: Integer;
  ok: Boolean;
begin
  addr := GetEnvironmentVariable('NOTIFY_SOCKET');
  r := -1;
  if (addr <> '') and (addr[1] = '@') then
    r := UnixBind(addr);
  ok := SdNotify('READY=1' + #10 + 'STATUS=env');
  got := '-';
  if (r >= 0) and ok then
    got := Vis(UnixRecvFrom(r, 4096, from));
  WriteLn('notify=', Say(ok), ' got=[', got, '] watchdog=', SdWatchdogUsec);
  if r >= 0 then
    UnixClose(r);
end;

begin
  if (ParamCount >= 1) and (ParamStr(1) = 'env') then
  begin
    Env;
    Halt(0);
  end;
  { the texts of the two variables }
  Wd('', False, '', 100);
  Wd('3000000', False, '', 100);
  Wd('3000000', True, '100', 100);
  Wd('3000000', True, '101', 100);
  Wd('3000000', True, '', 100);
  Wd('3000000', True, '+100', 100);
  Wd('3000000', True, '100 ', 100);
  Wd('3000000', True, 'x', 100);
  Wd('3000000', True, '99999999999999999999', 100);
  Wd('0', False, '', 100);
  Wd('1', False, '', 100);
  Wd('abc', False, '', 100);
  Wd('-5', False, '', 100);
  Wd('12x', False, '', 100);
  Wd(' 5', False, '', 100);
  Wd('9223372036854775807', False, '', 100);
  Wd('9223372036854775808', False, '', 100);
  Wd('18446744073709551615', False, '', 100);
  Wd(':', False, '', 100);
  Wd('/', False, '', 100);
  Wd('1:2', False, '', 100);
  Wd('1/2', False, '', 100);
  Wd('3000000', True, ':0', 100);
  Wd('3000000', True, '1/', 9);
  Wd('3000000', True, '9', 9);
  WriteLn('this process: ', SdWatchdogOf('20000000', True, IntToStr(GetPid), GetPid));
  WriteLn('the next number: ', SdWatchdogOf('20000000', True, IntToStr(GetPid + 1), GetPid));
  { datagrams to an abstract name }
  name := '@paslang-sdnotify-' + IntToStr(GetPid);
  rx := UnixBind(name);
  WriteLn('listening: ', rx > 0);
  Trip(rx, name, 'READY=1');
  Trip(rx, name, 'WATCHDOG=1');
  Trip(rx, name, 'STATUS=two' + #10 + 'lines' + #10);
  Trip(rx, name, 'STOPPING=1');
  Trip(rx, name, 'STATUS=caf' + #195 + #169);
  Trip(rx, name, 'MAINPID=4711' + #10 + 'READY=1');
  { the sender's descriptor is closed again: the next socket has its number }
  a := UnixBind('');
  UnixClose(a);
  Trip(rx, name, 'STATUS=fd');
  b := UnixBind('');
  WriteLn('descriptor reused ', a = b);
  UnixClose(b);
  { in order }
  for i := 1 to 3 do
    WriteLn('three ', i, ' ', Say(SdNotifyTo(name, 'STATUS=n' + IntToStr(i))));
  for i := 1 to 3 do
  begin
    got := UnixRecvFrom(rx, 4096, from);
    WriteLn('in order ', i, ' [', got, ']');
  end;
  { a long one }
  big := '';
  for i := 0 to 3999 do
    big := big + Chr(97 + i mod 26);
  Whole(rx, name, big);
  { what is refused sends nothing: the next datagram is the one after them }
  WriteLn('empty state ', Say(SdNotifyTo(name, '')));
  WriteLn('no address ', Say(SdNotifyTo('', 'READY=1')));
  WriteLn('vsock ', Say(SdNotifyTo('vsock:2:1234', 'READY=1')));
  WriteLn('relative ', Say(SdNotifyTo('run/notify', 'READY=1')));
  WriteLn('nobody at a name ', Say(SdNotifyTo(name + '-none', 'READY=1')));
  WriteLn('nobody at a path ', Say(SdNotifyTo('/tmp/paslang-sdnotify-none-' + IntToStr(GetPid), 'READY=1')));
  big := '/';
  for i := 1 to 120 do
    big := big + 'x';
  WriteLn('path too long ', Say(SdNotifyTo(big, 'READY=1')));
  Trip(rx, name, 'READY=1' + #10 + 'STATUS=after the refusals');
  UnixClose(rx);
  { a path }
  path := '/tmp/paslang-sdnotify-' + IntToStr(GetPid);
  rx := UnixBind(path);
  WriteLn('listening at a path: ', rx > 0);
  Trip(rx, path, 'READY=1' + #10 + 'STATUS=by a path');
  UnixClose(rx);
  UnixUnlink(path);
  WriteLn('the path is gone ', Say(SdNotifyTo(path, 'READY=1')));
  { a name that is not a path or an abstract name is refused even where a socket of that name is at hand }
  cwd := GetCurrentDir;
  WriteLn('in /tmp: ', SetCurrentDir('/tmp'));
  rel := 'paslang-sdnotify-rel-' + IntToStr(GetPid);
  rx := UnixBind(rel);
  WriteLn('socket by a relative name: ', rx > 0);
  WriteLn('relative at hand ', Say(SdNotifyTo(rel, 'READY=1')));
  Trip(rx, '/tmp/' + rel, 'STATUS=the one after');
  UnixClose(rx);
  UnixUnlink('/tmp/' + rel);
  WriteLn('back: ', SetCurrentDir(cwd));
end.
