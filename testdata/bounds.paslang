{ P87: every index in range is let through, at both ends and in the
  middle, on both paths of the emitter (registers, and the general one
  an index with a call takes): static arrays from 0 and from below it,
  strings from 1 to their length, slices after they shrink (the buffer
  behind them is longer), var arguments, fields, a slice in an array, an
  element of an array of records, and a with. }
program bounds;

uses
  paslib;

type
  TRec = record
    S: string;
    D: array of Integer;
    A: array[1..3] of Char;
  end;

var
  a: array[0..4] of Integer;
  n: array[-3..3] of Integer;
  d: array of Integer;
  e: array of string;
  m: array[0..1] of array of Integer;
  r: TRec;
  rs: array of TRec;
  s, t: string;
  p: ^Integer;
  i, sum: Integer;

function Id(X: Integer): Integer;
begin
  Result := X;
end;

procedure Touch(var X: Integer);
begin
  X := X + 1;
end;

function CharAt(const S: string; I: Integer): Char;
begin
  Result := S[I];
end;

begin
  sum := 0;
  for i := 0 to 4 do
    a[i] := i * 10;
  sum := sum + a[0] + a[4] + a[Id(0)] + a[Id(4)];
  for i := Low(a) to High(a) do
    sum := sum + a[i];
  for i := -3 to 3 do
    n[i] := i * 100;
  sum := sum + n[-3] + n[3] + n[Id(-3)] + n[Id(3)];
  s := 'hel' + 'lo';
  sum := sum + Ord(s[1]) + Ord(s[5]) + Ord(s[Id(1)]) + Ord(s[Id(5)]);
  sum := sum + Ord(CharAt(s, 1)) + Ord(CharAt(s, Length(s)));
  for i := 1 to Length(s) do
    sum := sum + Ord(s[i]);
  SetLength(d, 4);
  for i := 0 to Length(d) - 1 do
    d[i] := i + 1;
  SetLength(d, 2);
  sum := sum + d[0] + d[1] + d[Id(1)];
  Touch(a[4]);
  Touch(d[Id(1)]);
  Touch(n[-3]);
  sum := sum + a[4] + d[1] + n[-3];
  SetLength(e, 3);
  e[2] := 'x';
  e[0] := 'y';
  t := e[2] + e[Id(0)] + e[Id(2)];
  SetLength(m[1], 2);
  m[1][1] := 7;
  m[1][0] := 3;
  sum := sum + m[1][1] + m[Id(1)][Id(0)];
  r.S := 'abc';
  SetLength(r.D, 2);
  r.D[1] := 5;
  r.A[3] := 'z';
  r.A[1] := 'a';
  sum := sum + Ord(r.S[3]) + r.D[1] + Ord(r.A[3]) + Ord(r.A[Id(1)]);
  SetLength(rs, 2);
  rs[1].S := 'q';
  SetLength(rs[1].D, 1);
  rs[1].D[0] := 11;
  sum := sum + Ord(rs[1].S[1]) + rs[Id(1)].D[Id(0)];
  with r do
    sum := sum + D[1] + Ord(S[1]);
  p := @a[4];
  p^ := p^ + 1;
  sum := sum + a[4];
  WriteLn(sum, ' ', t, ' ', Length(d), ' ', a[4]);
end.

