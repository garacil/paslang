{ P310: an element's index is scaled by a shift, a lea or two, or on
  arm64 an add of a shifted register, never by a multiply by a power of
  two, nor by a size a recipe makes cheaper on the processor: records of
  2, 3, 12, 16, 24, 32 and 48 bytes in local, global and heap arrays,
  through a pointer, in a view and a copy of a slice, a map's values of
  24 bytes, every element written and read back, the counts of bytes the
  runtime is asked for. The routines named Loc, Glob, Dyn, Ptr and Cut
  multiply nothing, which scripts/check_scale.py reads. }
program idxscale;

type
  TR2 = record a, b: Byte; end;
  TR3 = record a, b, c: Byte; end;
  TR12 = record a, b, c: Int32; end;
  TR16 = record a, b: Integer; end;
  TR24 = record a, b, c: Integer; end;
  TR32 = record a, b, c, d: Integer; end;
  TR48 = record a, b, c, d, e, f: Integer; end;
  P24 = ^TR24;

var
  g3: array[1..40] of TR3;
  g12: array[0..39] of TR12;
  g48: array[-5..34] of TR48;
  d16: array of TR16;
  d24: array of TR24;
  d32: array of TR32;
  m: map[Integer] of TR24;

function Loc(n: Integer): Integer;
var
  l2: array[0..39] of TR2;
  l24: array[3..42] of TR24;
  i, t: Integer;
begin
  for i := 0 to 39 do
  begin
    l2[i].a := Byte(i + n);
    l2[i].b := Byte(i + 7);
    l24[i + 3].a := i;
    l24[i + 3].b := -i;
    l24[i + 3].c := i + n;
  end;
  t := 0;
  for i := 0 to 39 do
    t := t + l2[i].a + l2[i].b + l24[i + 3].a - l24[i + 3].b + l24[i + 3].c;
  Result := t;
end;

function Glob(n: Integer): Integer;
var
  i, t: Integer;
begin
  for i := 1 to 40 do
  begin
    g3[i].a := Byte(i);
    g3[i].b := Byte(n);
    g3[i].c := Byte(i + n);
    g12[i - 1].a := Int32(i + 1000);
    g12[i - 1].c := Int32(-i);
    g48[i - 6].a := i;
    g48[i - 6].f := i + n;
  end;
  t := 0;
  for i := 1 to 40 do
    t := t + g3[i].a + g3[i].b + g3[i].c + g12[i - 1].a + g12[i - 1].c + g48[i - 6].a + g48[i - 6].f;
  Result := t;
end;

function Dyn(n: Integer): Integer;
var
  i, t: Integer;
begin
  SetLength(d16, n);
  SetLength(d24, n);
  SetLength(d32, n);
  for i := 0 to n - 1 do
  begin
    d16[i].a := i;
    d16[i].b := i + 1;
    d24[i].c := i + i + i;
    d32[i].d := -i;
  end;
  t := 0;
  for i := 0 to n - 1 do
    t := t + d16[i].a + d16[i].b + d24[i].c + d32[i].d;
  Result := t;
end;

function Ptr(p: P24; n: Integer): Integer;
var
  i, t: Integer;
begin
  t := 0;
  for i := 0 to n - 1 do
    t := t + p[i].a + p[i].c;
  Result := t;
end;

function Cut(n: Integer): Integer;
var
  c: array of TR24;
  i, t: Integer;
begin
  c := Copy(d24, 2, n);
  t := Length(c);
  for i := 0 to Length(c) - 1 do
    t := t + c[i].c;
  Result := t;
end;

var
  i, t: Integer;
  r: TR24;
begin
  WriteLn(Loc(0), ' ', Loc(5));
  WriteLn(Glob(0), ' ', Glob(77));
  WriteLn(Dyn(1), ' ', Dyn(1000));
  WriteLn(Ptr(@d24[0], 1000), ' ', Ptr(@d24[10], 5));
  WriteLn(Cut(0), ' ', Cut(10), ' ', Cut(5000));
  New(m);
  for i := 0 to 999 do
  begin
    r.a := i;
    r.b := i * 2;
    r.c := i * 3;
    m[i] := r;
  end;
  t := 0;
  for i := 0 to 999 do
    t := t + m[i].a + m[i].c;
  WriteLn(t, ' ', Length(m));
end.
