{ Deterministic EINTR injection uses this short-call fixture. The
  separate progress/roots/wait fixtures exercise real saturation. }
program syscallretry;
uses paslinux;
var
  pipeFds: array[0..1] of Int32;
  buffer: array[0..7] of Byte;
  count: Integer;
begin
  if OsPipe(Integer(@pipeFds[0])) <> 0 then Halt(1);
  buffer[0] := 42;
  if OsWrite(pipeFds[1], Integer(@buffer[0]), 1) <> 1 then Halt(2);
  if OsClose(pipeFds[1]) <> 0 then Halt(3);
  repeat
    count := OsRead(pipeFds[0], Integer(@buffer[0]), 8);
  until count <> -4;
  if (count <> 1) or (buffer[0] <> 42) then Halt(4);
  repeat
    count := OsRead(pipeFds[0], Integer(@buffer[0]), 8);
  until count <> -4;
  if count <> 0 then Halt(5);
  if OsClose(pipeFds[0]) <> 0 then Halt(6);
  WriteLn('short read and EOF');
end.
