program slicefront;

{ A slice's frontier costs no size class (P287): a grow to exactly its
  capacity takes the elements' bytes alone, with no frontier; a grow
  with room to spare keeps the frontier in the elements' class, the
  capacity a few elements short when they fill it; a shrink leaves the
  capacity at the new length. The guarantees of 1.0.88 hold: what a
  grow adds is zero, and no slice of a block changes under another,
  for exact blocks and spare ones, also across the collector's stress. }

uses sysutils;

type
  TPoint = record
    X, Y: Double;
  end;
  TPts = array of TPoint;
  TInts = array of Integer;
  TStrs = array of string;

procedure Collect;
var
  c: Integer;
begin
  c := 0;
  while c < 2 do
    if GcCollect = 1 then
      c := c + 1
    else
      Sleep(1);
end;

function Block(P: Pointer): Integer;
begin
  Result := MemSize(P);
end;

procedure Sizes;
var
  p: TPts;
  a: TInts;
  s: TStrs;
  k: Integer;
  line: string;
begin
  SetLength(p, 4);
  WriteLn('four points: cap ', Cap(p), ', block ', Block(@p[0]));
  SetLength(a, 8);
  WriteLn('eight integers: cap ', Cap(a), ', block ', Block(@a[0]));
  a := [1, 2, 3];
  WriteLn('a literal of three: cap ', Cap(a), ', block ', Block(@a[0]));
  s := nil;
  line := '';
  for k := 1 to 20 do
  begin
    s := Append(s, 'x' + IntToStr(k));
    line := line + IntToStr(Cap(s)) + '/' + IntToStr(Block(@s[0])) + ' ';
  end;
  WriteLn('appended strings: ', line);
  p := nil;
  line := '';
  for k := 1 to 10 do
  begin
    SetLength(p, k);
    line := line + IntToStr(Cap(p)) + ' ';
  end;
  WriteLn('points grown one at a time: ', line);
end;

{ The guarantees of 1.0.88 on an exact block and on a spare one. }
procedure Guarantees;
var
  e, t, u: TInts;
  i: Integer;
begin
  SetLength(e, 4);
  for i := 0 to 3 do
    e[i] := i + 1;
  t := e;
  t := Append(t, 5);
  t[0] := 100;
  WriteLn('exact: ', e[0], ' ', Length(e), ' ', Cap(e), ' ', t[0], ' ', t[4], ' ', Length(t));
  SetLength(e, 2);
  WriteLn('shrunk: ', Length(e), ' ', Cap(e));
  SetLength(e, 4);
  WriteLn('grown back: ', e[0], ' ', e[1], ' ', e[2], ' ', e[3], ' ', Cap(e));
  u := nil;
  u := Append(u, 7);
  t := u;
  u := Append(u, 8);
  t := Append(t, 9);
  WriteLn('spare: ', u[0], ' ', u[1], ' ', t[0], ' ', t[1], ' ', Length(u), ' ', Length(t));
  SetLength(u, 1);
  SetLength(u, 3);
  WriteLn('zeros: ', u[0], ' ', u[1], ' ', u[2]);
  u := nil;
  for i := 1 to 100 do
    u := Append(u, i);
  t := u;
  SetLength(t, 50);
  t := Append(t, -1);
  WriteLn('a copy cut and grown: ', u[50], ' ', t[50], ' ', Length(u), ' ', Length(t));
end;

{ Slices of strings across the collector's cycles, grown, cut, copied. }
procedure Kept;
var
  all: array of TStrs;
  i, k, bad: Integer;
  junk: string;
begin
  SetLength(all, 2000);
  for i := 0 to High(all) do
  begin
    for k := 0 to i mod 9 do
      all[i] := Append(all[i], IntToStr(i) + ':' + IntToStr(k));
    junk := IntToStr(i) + '-' + IntToStr(i * 7);
    if Length(junk) = 0 then
      WriteLn('never');
    if i mod 3 = 0 then
      all[i] := Copy(all[i], 0, Length(all[i]));
  end;
  Collect;
  bad := 0;
  for i := 0 to High(all) do
  begin
    if Length(all[i]) <> i mod 9 + 1 then
      bad := bad + 1;
    for k := 0 to High(all[i]) do
      if all[i][k] <> IntToStr(i) + ':' + IntToStr(k) then
        bad := bad + 1;
  end;
  WriteLn('kept ', Length(all), ', bad ', bad);
end;

{ The bytes of 20000 slices of four points: Go's take 64. }
procedure Memory;
var
  keep: array of TPts;
  i, a, b: Integer;
begin
  SetLength(keep, 20000);
  Collect;
  a := HeapStat(1);
  for i := 0 to High(keep) do
    SetLength(keep[i], 4);
  Collect;
  b := HeapStat(1);
  WriteLn('20000 slices of four points: ', ((b - a) div 20000 + 4) div 8 * 8, ' bytes each, Go''s 64');
end;

begin
  Sizes;
  Guarantees;
  Kept;
  if ParamStr(1) <> 'nomem' then
    Memory;
end.

