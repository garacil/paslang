{ P457: a class property's read field is a block's address even when its
  write accessor is a method. Full values, const/value arguments, nested
  fields, array-valued property indexes, sets and owner evaluation. Scalar
  and fat values, field/field and method-getter properties are controls. }
program propfield;

uses SysUtils;

type
  TR1 = record A: Integer; end;
  TR2 = record A, B: Integer; end;
  TR3 = record A, B, C: Integer; end;
  TR4 = record A, B, C, D: Integer; end;
  TOdd = record A: Byte; B: Word; C: Byte; end;
  TBytes = array[0..4] of Byte;
  TTiny = record Data: TBytes; end;
  TArray = array[-1..2] of Integer;
  TOneArray = array[3..3] of Integer;
  TBits = set of Byte;
  TIntSlice = array of Integer;
  TNested = record
    Lead: Integer;
    Pair: TR2;
    Tail: array[0..2] of Word;
  end;
  IValue = interface
    function Get: Integer;
  end;
  TToken = class(IValue)
    N: Integer;
    function Get: Integer;
  end;
  TManaged = record
    N: Integer;
    Text: string;
    Ref: TToken;
  end;
  TRecordOwner = record
    FPair: TR2;
    procedure SetPair(const V: TR2);
    property Pair: TR2 read FPair write SetPair;
  end;
  TBox = class
    Pad: Integer;
    FOne: TR1;
    FTwo: TR2;
    FThree: TR3;
    FFour: TR4;
    FOdd: TOdd;
    FTiny: TTiny;
    FArray: TArray;
    FOneArray: TOneArray;
    FBytes: TBytes;
    FBits: TBits;
    FNested: TNested;
    FManaged: TManaged;
    FNumber: Integer;
    FByte: Byte;
    FText: string;
    FItems: TIntSlice;
    FFace: IValue;
    FRatio: Quad;
    Writes, Gets: Integer;
    procedure SetOne(const V: TR1);
    procedure SetTwo(const V: TR2);
    procedure SetThree(const V: TR3);
    procedure SetFour(const V: TR4);
    procedure SetOdd(const V: TOdd);
    procedure SetTiny(const V: TTiny);
    procedure SetArray(const V: TArray);
    procedure SetOneArray(const V: TOneArray);
    procedure SetBytes(const V: TBytes);
    procedure SetWideBits(const V: TBits);
    procedure SetNested(const V: TNested);
    procedure SetManaged(const V: TManaged);
    procedure SetNumber(V: Integer);
    procedure SetByte(V: Byte);
    procedure SetText(const V: string);
    procedure SetItems(const V: TIntSlice);
    procedure SetFace(const V: IValue);
    procedure SetRatio(const V: Quad);
    function GetTwo: TR2;
    function GetAt(I: Integer): TR2;
    function Inside: Integer;
    property One: TR1 read FOne write SetOne;
    property Two: TR2 read FTwo write SetTwo;
    property Three: TR3 read FThree write SetThree;
    property Four: TR4 read FFour write SetFour;
    property Narrow: TOdd read FOdd write SetOdd;
    property Tiny: TTiny read FTiny write SetTiny;
    property Values: TArray read FArray write SetArray;
    property SingleValue: TOneArray read FOneArray write SetOneArray;
    property Bytes: TBytes read FBytes write SetBytes;
    property Bits: TBits read FBits write SetWideBits;
    property Nested: TNested read FNested write SetNested;
    property Managed: TManaged read FManaged write SetManaged;
    property Number: Integer read FNumber write SetNumber;
    property ByteValue: Byte read FByte write SetByte;
    property Text: string read FText write SetText;
    property Items: TIntSlice read FItems write SetItems;
    property Face: IValue read FFace write SetFace;
    property Ratio: Quad read FRatio write SetRatio;
    property Raw: TR2 read FTwo write FTwo;
    property Got: TR2 read GetTwo write SetTwo;
    property At[I: Integer]: TR2 read GetAt;
  end;

var
  Box: TBox;
  OwnerCalls: Integer;

procedure Check(OK: Boolean; const Name: string);
begin
  if not OK then
  begin
    WriteLn('FAIL ', Name);
    Halt(1);
  end;
end;

function TToken.Get: Integer;
begin
  Result := N;
end;

procedure TRecordOwner.SetPair(const V: TR2);
begin
  FPair := V;
end;

procedure TBox.SetOne(const V: TR1);
begin FOne := V; Inc(Writes); end;
procedure TBox.SetTwo(const V: TR2);
begin FTwo := V; Inc(Writes); end;
procedure TBox.SetThree(const V: TR3);
begin FThree := V; Inc(Writes); end;
procedure TBox.SetFour(const V: TR4);
begin FFour := V; Inc(Writes); end;
procedure TBox.SetOdd(const V: TOdd);
begin FOdd := V; Inc(Writes); end;
procedure TBox.SetTiny(const V: TTiny);
begin FTiny := V; Inc(Writes); end;
procedure TBox.SetArray(const V: TArray);
begin FArray := V; Inc(Writes); end;
procedure TBox.SetOneArray(const V: TOneArray);
begin FOneArray := V; Inc(Writes); end;
procedure TBox.SetBytes(const V: TBytes);
begin FBytes := V; Inc(Writes); end;
procedure TBox.SetWideBits(const V: TBits);
begin FBits := V; Inc(Writes); end;
procedure TBox.SetNested(const V: TNested);
begin FNested := V; Inc(Writes); end;
procedure TBox.SetManaged(const V: TManaged);
begin FManaged := V; Inc(Writes); end;
procedure TBox.SetNumber(V: Integer);
begin FNumber := V; Inc(Writes); end;
procedure TBox.SetByte(V: Byte);
begin FByte := V; Inc(Writes); end;
procedure TBox.SetText(const V: string);
begin FText := V; Inc(Writes); end;
procedure TBox.SetItems(const V: TIntSlice);
begin FItems := V; Inc(Writes); end;
procedure TBox.SetFace(const V: IValue);
begin FFace := V; Inc(Writes); end;
procedure TBox.SetRatio(const V: Quad);
begin FRatio := V; Inc(Writes); end;

function TBox.GetTwo: TR2;
begin
  Inc(Gets);
  Result := FTwo;
end;

function TBox.GetAt(I: Integer): TR2;
begin
  Result.A := FTwo.A + I;
  Result.B := FTwo.B + I;
end;

function TBox.Inside: Integer;
begin
  Result := One.A + Two.B + Three.C + Four.D + Nested.Pair.B + Values[2];
end;

function Owner: TBox;
begin
  Inc(OwnerCalls);
  Result := Box;
end;

function ConstOne(const V: TR1): Integer;
begin Result := V.A; end;
function ValueOne(V: TR1): Integer;
begin Result := V.A; V.A := 900; end;
function ConstTwo(const V: TR2): Integer;
begin Result := V.A + V.B; end;
function ValueTwo(V: TR2): Integer;
begin Result := V.A + V.B; V.A := 900; V.B := 901; end;
function ConstThree(const V: TR3): Integer;
begin Result := V.A + V.B + V.C; end;
function ValueThree(V: TR3): Integer;
begin Result := V.A + V.B + V.C; V.C := 900; end;
function ConstFour(const V: TR4): Integer;
begin Result := V.A + V.B + V.C + V.D; end;
function ValueFour(V: TR4): Integer;
begin Result := V.A + V.B + V.C + V.D; V.D := 900; end;
function ConstOdd(const V: TOdd): Integer;
begin Result := V.A + V.B + V.C; end;
function ValueOdd(V: TOdd): Integer;
begin Result := V.A + V.B + V.C; V.C := 250; end;
function ConstTiny(const V: TTiny): Integer;
begin Result := V.Data[0] + V.Data[1] + V.Data[2] + V.Data[3] + V.Data[4]; end;
function ValueTiny(V: TTiny): Integer;
begin Result := V.Data[0] + V.Data[1] + V.Data[2] + V.Data[3] + V.Data[4]; V.Data[4] := 250; end;
function ConstArray(const V: TArray): Integer;
begin Result := V[-1] + V[0] + V[1] + V[2]; end;
function ValueArray(V: TArray): Integer;
begin Result := V[-1] + V[0] + V[1] + V[2]; V[2] := 900; end;
function ConstOneArray(const V: TOneArray): Integer;
begin Result := V[3]; end;
function ValueOneArray(V: TOneArray): Integer;
begin Result := V[3]; V[3] := 900; end;
function ConstBytes(const V: TBytes): Integer;
begin Result := V[0] + V[1] + V[2] + V[3] + V[4]; end;
function ValueBytes(V: TBytes): Integer;
begin Result := V[0] + V[1] + V[2] + V[3] + V[4]; V[4] := 250; end;
function ConstBits(const V: TBits): Integer;
var K: Byte;
begin Result := 0; for K in V do Inc(Result, K); end;
function ValueBits(V: TBits): Integer;
var K: Byte;
begin Result := 0; for K in V do Inc(Result, K); V := []; end;
function ConstNested(const V: TNested): Integer;
begin Result := V.Lead + V.Pair.A + V.Pair.B + V.Tail[0] + V.Tail[1] + V.Tail[2]; end;
function ValueNested(V: TNested): Integer;
begin Result := V.Lead + V.Pair.A + V.Pair.B + V.Tail[0] + V.Tail[1] + V.Tail[2]; V.Pair.B := 900; end;
function ConstManaged(const V: TManaged): Integer;
var I: Integer; Scratch: string;
begin
  for I := 1 to 64 do Scratch := 'allocation ' + IntToStr(I);
  Result := V.N + Length(V.Text) + V.Ref.N;
end;
function ValueManaged(V: TManaged): Integer;
begin
  Result := V.N + Length(V.Text) + V.Ref.N;
  V.N := 900;
  V.Text := 'changed';
end;

{ Kept as separately named routines for the assembly checker at inline 0.
  A const argument needs the property's address even for an 8-byte record. }
function ProbeOne(B: TBox): Integer;
begin Result := ConstOne(B.One); end;
function ControlInteger(B: TBox): Integer;
begin Result := B.Number; end;
function ControlByte(B: TBox): Integer;
begin Result := B.ByteValue; end;
function ControlString(B: TBox): string;
begin Result := B.Text; end;
function ControlSlice(B: TBox): TIntSlice;
begin Result := B.Items; end;
function ControlFace(B: TBox): IValue;
begin Result := B.Face; end;
function ControlQuad(B: TBox): Quad;
begin Result := B.Ratio; end;
function ControlFieldField(B: TBox): TR2;
begin Result := B.Raw; end;
function ControlGetter(B: TBox): TR2;
begin Result := B.Got; end;

var
  R1: TR1;
  R2: TR2;
  R3: TR3;
  R4: TR4;
  NarrowValue: TOdd;
  Tiny: TTiny;
  Values: TArray;
  OneArray: TOneArray;
  Bytes: TBytes;
  Bits: TBits;
  Nested: TNested;
  Managed: TManaged;
  Token: TToken;
  Face: IValue;
  Items: TIntSlice;
  RecOwner: TRecordOwner;
  Missing: TBox;
  BaselineWrites, OriginalCapacity, I: Integer;
  Caught: Boolean;

begin
  Box := TBox.Create;
  { The optional baseline checker launches this minimal reproduction with
    one argument, before any setter or unrelated control is exercised. }
  if ParamCount <> 0 then
  begin
    Box.FOne.A := 11;
    R1 := Box.One;
    Check(R1.A = 11, 'focused one word mixed property copy');
    WriteLn('propfield repro ok');
    Halt(0);
  end;
  R1.A := 11;
  R2.A := 13; R2.B := 17;
  R3.A := 19; R3.B := 23; R3.C := 29;
  R4.A := 31; R4.B := 37; R4.C := 41; R4.D := 43;
  NarrowValue.A := 3; NarrowValue.B := 1000; NarrowValue.C := 7;
  Bytes[0] := 3; Bytes[1] := 5; Bytes[2] := 7; Bytes[3] := 11; Bytes[4] := 13;
  Tiny.Data := Bytes;
  Values[-1] := 10; Values[0] := 20; Values[1] := 30; Values[2] := 40;
  OneArray[3] := 59;
  Bits := [0, 63, 64, 127, 128, 254, 255];
  Nested.Lead := 47; Nested.Pair.A := 53; Nested.Pair.B := 59;
  Nested.Tail[0] := 61; Nested.Tail[1] := 67; Nested.Tail[2] := 71;
  Token := TToken.Create; Token.N := 73;
  Managed.N := 79; Managed.Text := 'paslang'; Managed.Ref := Token;
  Box.One := R1; Box.Two := R2; Box.Three := R3; Box.Four := R4;
  Box.Narrow := NarrowValue; Box.Tiny := Tiny; Box.Values := Values; Box.SingleValue := OneArray;
  Box.Bytes := Bytes; Box.Bits := Bits; Box.Nested := Nested; Box.Managed := Managed;
  Box.Number := -83; Box.ByteValue := 251; Box.Text := 'complete string';
  SetLength(Items, 3); Items[0] := 89; Items[1] := 97; Items[2] := 101;
  OriginalCapacity := Cap(Items);
  Box.Items := Items; Face := Token; Box.Face := Face; Box.Ratio := Quad(9) / 4;
  BaselineWrites := Box.Writes;
  Check(BaselineWrites = 18, 'every setter called once');
  Check((SizeOf(TR1) = 8) and (SizeOf(TR2) = 16) and (SizeOf(TR3) = 24) and (SizeOf(TR4) = 32), 'word record sizes');
  Check((SizeOf(TOdd) = 6) and (SizeOf(TTiny) = 5) and (SizeOf(TBits) = 32), 'narrow and odd record and wide set sizes');

  R1 := Box.One; Check(R1.A = 11, 'one word whole copy');
  R2 := Box.Two; Check((R2.A = 13) and (R2.B = 17), 'two word whole copy');
  R3 := Box.Three; Check((R3.A = 19) and (R3.B = 23) and (R3.C = 29), 'three word whole copy');
  R4 := Box.Four; Check((R4.A = 31) and (R4.B = 37) and (R4.C = 41) and (R4.D = 43), 'four word whole copy');
  NarrowValue := Box.Narrow; Check((NarrowValue.A = 3) and (NarrowValue.B = 1000) and (NarrowValue.C = 7), 'narrow record whole copy');
  Tiny := Box.Tiny;
  Check((Tiny.Data[0] = 3) and (Tiny.Data[1] = 5) and (Tiny.Data[2] = 7) and
    (Tiny.Data[3] = 11) and (Tiny.Data[4] = 13), 'five byte record whole copy');
  Values := Box.Values; Check(ConstArray(Values) = 100, 'static array whole copy');
  OneArray := Box.SingleValue; Check(OneArray[3] = 59, 'one element array whole copy');
  Bytes := Box.Bytes;
  Check((Bytes[0] = 3) and (Bytes[1] = 5) and (Bytes[2] = 7) and
    (Bytes[3] = 11) and (Bytes[4] = 13), 'odd array whole copy');
  Bits := Box.Bits; Check((ConstBits(Bits) = 891) and (255 in Bits), 'wide set whole copy');
  Nested := Box.Nested; Check(ConstNested(Nested) = 358, 'nested record whole copy');
  Managed := Box.Managed; Check((Managed.N = 79) and (Managed.Text = 'paslang') and (Managed.Ref = Token), 'managed record whole copy');

  Check((ConstOne(Box.One) = 11) and (ValueOne(Box.One) = 11), 'one word const and value');
  Check((ConstTwo(Box.Two) = 30) and (ValueTwo(Box.Two) = 30), 'two word const and value');
  Check((ConstThree(Box.Three) = 71) and (ValueThree(Box.Three) = 71), 'three word const and value');
  Check((ConstFour(Box.Four) = 152) and (ValueFour(Box.Four) = 152), 'four word const and value');
  Check((ConstOdd(Box.Narrow) = 1010) and (ValueOdd(Box.Narrow) = 1010), 'narrow record const and value');
  Check((ConstTiny(Box.Tiny) = 39) and (ValueTiny(Box.Tiny) = 39), 'five byte const and value');
  Check((ConstArray(Box.Values) = 100) and (ValueArray(Box.Values) = 100), 'static array const and value');
  Check((ConstOneArray(Box.SingleValue) = 59) and (ValueOneArray(Box.SingleValue) = 59), 'one element const and value');
  Check((ConstBytes(Box.Bytes) = 39) and (ValueBytes(Box.Bytes) = 39), 'odd array const and value');
  Check((ConstBits(Box.Bits) = 891) and (ValueBits(Box.Bits) = 891), 'wide set const and value');
  Check((ConstNested(Box.Nested) = 358) and (ValueNested(Box.Nested) = 358), 'nested const and value');
  Check((ConstManaged(Box.Managed) = 159) and (ValueManaged(Box.Managed) = 159), 'managed const allocation and value');

  Check((Box.One.A = 11) and (Box.Two.B = 17) and (Box.Three.C = 29) and (Box.Four.D = 43), 'record nested field reads');
  Check((Box.Narrow.C = 7) and (Box.Tiny.Data[4] = 13), 'odd record nested reads');
  Check((Box.Values[-1] = 10) and (Box.Values[2] = 40) and (Box.SingleValue[3] = 59) and (Box.Bytes[4] = 13), 'array valued property indexing');
  Check((0 in Box.Bits) and (64 in Box.Bits) and (255 in Box.Bits) and not (1 in Box.Bits), 'wide set property membership');
  Check((Box.Nested.Pair.B = 59) and (Box.Nested.Tail[2] = 71), 'nested record and array fields');
  Check((Box.Managed.Text = 'paslang') and (Box.Managed.Ref.N = 73), 'managed nested fields');
  Check(Box.Inside = 199, 'property reads inside instance method');

  R1.A := 901; R2.B := 902; R3.C := 903; R4.D := 904;
  NarrowValue.C := 249; Tiny.Data[4] := 248; Values[2] := 905; OneArray[3] := 906;
  Bytes[4] := 247; Bits := []; Nested.Pair.B := 907; Managed.Text := 'local only';
  Check((Box.One.A = 11) and (Box.Two.B = 17) and (Box.Three.C = 29) and (Box.Four.D = 43), 'copied records independent');
  Check((Box.Narrow.C = 7) and (Box.Tiny.Data[4] = 13) and (Box.Values[2] = 40), 'copied odd values independent');
  Check((Box.SingleValue[3] = 59) and (Box.Bytes[4] = 13) and (255 in Box.Bits), 'copied array and set independent');
  Check((Box.Nested.Pair.B = 59) and (Box.Managed.Text = 'paslang'), 'copied nested values independent');
  Check(Box.Writes = BaselineWrites, 'reads and local mutations never call setter');

  OwnerCalls := 0; R1 := Owner.One;
  Check((OwnerCalls = 1) and (R1.A = 11), 'owner once whole record');
  OwnerCalls := 0; I := ConstFour(Owner.Four);
  Check((OwnerCalls = 1) and (I = 152), 'owner once const argument');
  OwnerCalls := 0; I := ValueThree(Owner.Three);
  Check((OwnerCalls = 1) and (I = 71), 'owner once value argument');
  OwnerCalls := 0; I := Owner.Nested.Pair.B;
  Check((OwnerCalls = 1) and (I = 59), 'owner once nested field');
  OwnerCalls := 0; I := Owner.Values[2];
  Check((OwnerCalls = 1) and (I = 40), 'owner once array index');
  OwnerCalls := 0; Bits := Owner.Bits;
  Check((OwnerCalls = 1) and (255 in Bits), 'owner once wide set');

  Check(ProbeOne(Box) = 11, 'const address probe');
  Check((ControlInteger(Box) = -83) and (ControlByte(Box) = 251), 'scalar load controls');
  Check(ControlString(Box) = 'complete string', 'string load control');
  Items := ControlSlice(Box);
  Check((Length(Items) = 3) and (Cap(Items) = OriginalCapacity) and (Items[0] = 89) and (Items[2] = 101), 'slice load control');
  Face := ControlFace(Box); Check(Face.Get = 73, 'interface load control');
  Check(ControlQuad(Box) = Quad(9) / 4, 'Quad load control');
  R2 := ControlFieldField(Box); Check((R2.A = 13) and (R2.B = 17), 'field field whole control');
  Check(Box.Raw.B = 17, 'field field nested control');
  R2 := ControlGetter(Box); Check((R2.A = 13) and (R2.B = 17) and (Box.Gets = 1), 'method getter whole control');
  I := Box.Got.B;
  Check(I = 17, 'method getter nested control');
  Check(Box.Gets = 2, 'method getter called once per read');
  R2 := Box.At[5]; Check((R2.A = 18) and (R2.B = 22), 'method indexed whole control');
  Check(Box.At[7].B = 24, 'method indexed nested control');
  RecOwner.Pair := Box.Raw;
  R2 := RecOwner.Pair; Check((R2.A = 13) and (RecOwner.Pair.B = 17), 'record owned property control');
  Check(Box.Writes = BaselineWrites, 'control reads never call setter');

  { LEA itself does not read memory. These nested scalar reads must still
    fault at their actual read, just as a field/field property does. No
    expectation is imposed here on faults inside a runtime block copy. }
  Missing := nil;
  Caught := False;
  try I := Missing.Two.B; except on E: EAccessViolation do Caught := True; end;
  Check(Caught, 'nil mixed property nested read');
  Caught := False;
  try I := Missing.Raw.B; except on E: EAccessViolation do Caught := True; end;
  Check(Caught, 'nil field field nested control');
  WriteLn('propfield ok');
end.

