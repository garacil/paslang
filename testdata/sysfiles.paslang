program sysfiles;
uses sysutils, paslinux;
const Workers = 128;
var
  root, path: string;
  handle, baseHandle, other, count, i: Integer;
  data, received: TBytes;
  error: TSysError;
  joined: waitgroup;

procedure Put(Index: Integer);
var buffer: TBytes; transferred: Integer; localError: TSysError;
begin
  SetLength(buffer, 1);
  buffer[0] := Byte(Index);
  if not TryFileWriteAt(handle, buffer, 0, 1, Index, transferred, localError) then Halt(20);
  if transferred <> 1 then Halt(21);
  joined.Done;
end;

begin
  root := ParamStr(1);
  path := root + '/ data-'#195#177'.bin';
  SetLastOSError(77);
  if TryOpenFileAt(CurrentDirectoryHandle, path + #0, ORdwr or OCreat, 384, other, error) then Halt(2);
  if (other <> -1) or (error.Code <> 22) or (error.Path <> path + #0) then Halt(3);
  if GetLastOSError <> 77 then Halt(4);
  handle := FileCreate(path, 384);
  if (handle < 0) or (GetLastOSError <> 0) then Halt(5);
  { FD_CLOEXEC was set atomically during open, on both architectures. }
  if Amd64 then count := Syscall(72, handle, 1) else count := Syscall(25, handle, 1);
  if count <> 1 then Halt(6);
  data := BytesOf('abcdef');
  if FileWrite(handle, data, Length(data)) <> 6 then Halt(7);
  if FileSeek(handle, 2, fsFromBeginning) <> 2 then Halt(8);
  received := BytesOf('........');
  if not TryFileRead(handle, received, 2, 4, count, error) then Halt(9);
  if (count <> 4) or (StringOf(received) <> '..cdef..') then Halt(10);
  if not TryFileRead(handle, received, 0, 8, count, error) or (count <> 0) then Halt(11);
  if not TryFileReadAt(handle, received, 0, 8, 4, count, error) then Halt(12);
  if (count <> 2) or (FileSeek(handle, 0, fsFromCurrent) <> 6) then Halt(13);
  if TryFileRead(handle, received, 7, 2, count, error) or (error.Code <> 22) then Halt(14);
  if TryFileWrite(handle, data, 1, 9223372036854775807, count, error) then Halt(15);
  if (error.Code <> 22) or (count <> 0) then Halt(16);
  if not TryFileRead(handle, received, 8, 0, count, error) or (count <> 0) then Halt(17);
  if TryFileReadAt(handle, received, 0, 1, -1, count, error) or (error.Code <> 22) then Halt(18);
  if not FileTruncate(handle, Workers) or not FileFlush(handle) then Halt(19);
  joined.Add(Workers);
  for i := 0 to Workers - 1 do pas Put(i);
  joined.Wait;
  GcCollect;
  SetLength(received, Workers);
  if not TryFileReadAt(handle, received, 0, Workers, 0, count, error) then Halt(22);
  if count <> Workers then Halt(23);
  for i := 0 to Workers - 1 do if received[i] <> Byte(i) then Halt(24);
  if FileSeek(handle, 0, fsFromCurrent) <> 6 then Halt(25);
  if not TryOpenFileAt(CurrentDirectoryHandle, path, OWronly or OAppend, 0, other, error) then Halt(36);
  if TryFileWriteAt(other, data, 0, 1, 0, count, error) then Halt(37);
  if (error.Code <> 22) or (count <> 0) then Halt(38);
  FileClose(other);
  FileClose(handle);
  baseHandle := -1;
  if not TryOpenFileAt(CurrentDirectoryHandle, root, ORdonly or ODirectory, 0, baseHandle, error) then Halt(26);
  if not TryOpenFileAt(baseHandle, ExtractFileName(path), ORdonly, 0, handle, error) then Halt(27);
  if FileRead(handle, received, Workers) <> Workers then Halt(28);
  FileClose(handle);
  FileClose(baseHandle);
  if FileOpen(path, 16) <> -1 then Halt(29); { obsolete DOS share flag rejected }
  if GetLastOSError <> 22 then Halt(30);
  if FileOpen(root + '/absent', fmOpenRead) <> -1 then Halt(31);
  if GetLastOSError <> 2 then Halt(32);
  if TryFileClose(-1, error) or (error.Code <> 9) then Halt(33);
  if FileRead(-1, received, 1) <> -1 then Halt(34);
  if GetLastOSError <> 9 then Halt(35);
  WriteLn('bounded files, positional writers ', Workers);
  WriteLn('CLOEXEC, explicit bases and independent errors');
end.
