program chrsideeffects;
var Calls, Trace, NextN: Integer;
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('char effects ', Stage, ': ', Actual, ' <> ', Expected); Halt(99); end;
end;
function NextValue: Integer;
begin Calls := Calls + 1; Result := NextN; NextN := NextN + 1; end;
function Mark(Tag, Value: Integer): Integer;
begin Calls := Calls + 1; Trace := Trace * 10 + Tag; Result := Value; end;
function Pair(A, B: Integer): Integer;
begin Result := A * 1000 + B; end;
function BoolValue: Boolean;
begin Calls := Calls + 1; Result := False; end;
function TextOf(C: Char): string;
begin Result := 'x' + C + 'y'; end;
var N: Integer; Flag: Boolean; C: Char;
begin
  Calls := 0; NextN := 300;
  N := Integer(Chr(NextValue()));
  Equal(1, N, 44); Equal(2, Calls, 1); Equal(3, NextN, 301);
  Calls := 0; NextN := 511;
  N := Ord(Char(NextValue()));
  Equal(4, N, 255); Equal(5, Calls, 1); Equal(6, NextN, 512);
  Calls := 0; Trace := 0;
  N := Pair(Integer(Chr(Mark(1, 300))), Integer(Char(Mark(2, 511))));
  Equal(7, N, 44255); Equal(8, Calls, 2); Equal(9, Trace, 12);
  Calls := 0; Trace := 0;
  N := Integer(Chr(Mark(1, 300))) +
    Integer(Char(Mark(2, 511))) * Integer(Chr(Mark(3, 256)));
  Equal(10, N, 44); Equal(11, Calls, 3); Equal(12, Trace, 123);
  Calls := 0; Trace := 0;
  Flag := Boolean(Chr(Mark(1, 256))) and Boolean(Char(Mark(2, 1)));
  Equal(13, Ord(Flag), 0); Equal(14, Calls, 1); Equal(15, Trace, 1);
  Calls := 0; Trace := 0;
  Flag := Boolean(Char(Mark(1, 300))) or Boolean(Chr(Mark(2, 0)));
  Equal(16, Ord(Flag), 1); Equal(17, Calls, 1); Equal(18, Trace, 1);
  Calls := 0;
  Equal(19, Integer(Chr(not BoolValue())), 1); Equal(20, Calls, 1);
  Calls := 0;
  Equal(21, Ord(Char(not BoolValue())), 1); Equal(22, Calls, 1);
  Calls := 0;
  Equal(23, Ord(not BoolValue()), 1); Equal(24, Calls, 1);
  Calls := 0; Trace := 0;
  if TextOf(Chr(Mark(1, 300))) <> 'x,y' then Halt(100);
  Equal(25, Calls, 1); Equal(26, Trace, 1);
  Calls := 0; Trace := 0;
  if Boolean(Chr(Mark(1, 256))) then N := 8 else N := Integer(Char(Mark(2, 511)));
  Equal(27, N, 255); Equal(28, Calls, 2); Equal(29, Trace, 12);
  Calls := 0; NextN := 300;
  C := Chr(NextValue()); GcCollect(); Yield();
  Equal(30, Integer(C), 44); Equal(31, Calls, 1); Equal(32, NextN, 301);
  { These operands supply only their type; the user function never runs. }
  Calls := 0; NextN := 300;
  Equal(33, SizeOf(Chr(NextValue())), 1);
  Equal(34, Calls, 0); Equal(35, NextN, 300);
  Equal(36, Integer(High(Chr(NextValue()))), 255);
  Equal(37, Calls, 0);
  Equal(38, Integer(Low(Chr(NextValue()))), 0);
  Equal(39, Calls, 0); Equal(40, NextN, 300);
  WriteLn('ok char evaluation order');
end.
