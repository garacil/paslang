program arrs;

var
  A: array[1..3] of Integer;
  I, S: Integer;

begin
  A[1] := 10;
  A[2] := 20;
  A[3] := 30;
  S := 0;
  for I := 1 to 3 do
    S := S + A[I];
  WriteLn(S);
end.

