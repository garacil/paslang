{ P430: PEM decoding against Go's encoding/pem: testdata/x509/pem.txt,
  the cases scripts/x509_gen's pemgen wrote (edge cases and mutated
  texts), each text decoded call after call as Go did; one line per
  mismatch, then the counts. }
program x509pem;

uses
  paslib, pasx509;

function HexVal(C: Char): Integer;
begin
  if (C >= '0') and (C <= '9') then
    Result := Ord(C) - 48
  else
    Result := Ord(C) - 87;
end;

function UnHex(const H: string): string;
var
  i: Integer;
begin
  SetLength(Result, Length(H) div 2);
  for i := 1 to Length(H) div 2 do
    Result[i] := Chr(HexVal(H[2 * i - 1]) * 16 + HexVal(H[2 * i]));
end;

function DecodeAll(const Data0: string): string;
var
  data, rest, hs: string;
  b: TPemBlock;
  i, j, k: Integer;
  keys: array of TPemHeader;
  t: TPemHeader;
begin
  Result := '';
  data := Data0;
  for i := 1 to 50 do
  begin
    if i > 1 then
      Result := Result + ' ';
    if not PemDecode(data, b, rest) then
    begin
      Result := Result + 'none:' + IntToStr(Length(rest));
      Exit;
    end;
    keys := nil;
    keys := Append(keys, b.Headers);
    for j := 1 to High(keys) do
    begin
      t := keys[j];
      k := j - 1;
      while (k >= 0) and (keys[k].Key > t.Key) do
      begin
        keys[k + 1] := keys[k];
        Dec(k);
      end;
      keys[k + 1] := t;
    end;
    hs := '';
    for j := 0 to High(keys) do
    begin
      if j > 0 then
        hs := hs + ';';
      hs := hs + Hex(keys[j].Key) + '=' + Hex(keys[j].Value);
    end;
    Result := Result + 'B:' + Hex(b.BlockType) + ':' + hs + ':' + Hex(b.Bytes) + ':' + IntToStr(Length(rest));
    data := rest;
  end;
end;

var
  data, line, id, text, want, got: string;
  p, q, total, bad: Integer;
begin
  if not ReadFile('testdata/x509/pem.txt', data) then
    Halt(2);
  total := 0;
  bad := 0;
  p := 1;
  id := '';
  text := '';
  while p <= Length(data) do
  begin
    q := p;
    while (q <= Length(data)) and (data[q] <> #10) do
      Inc(q);
    line := Copy(data, p, q - p);
    p := q + 1;
    if Copy(line, 1, 4) = 'pem ' then
      id := Copy(line, 5, Length(line) - 4)
    else if Copy(line, 1, 5) = 'text ' then
      text := UnHex(Copy(line, 6, Length(line) - 5))
    else if line = 'text' then
      text := ''
    else if Copy(line, 1, 5) = 'want ' then
      want := Copy(line, 6, Length(line) - 5)
    else if line = 'end' then
    begin
      Inc(total);
      got := DecodeAll(text);
      if got <> want then
      begin
        Inc(bad);
        WriteLn(id, ' MISMATCH got ', got, ' | want ', want);
      end;
    end;
  end;
  WriteLn('pem cases ', total, ' mismatches ', bad);
end.
