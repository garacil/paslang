{ P271: no copy, clear, comparison or hash of the runtime holds its P
  longer than a slice. Run on one processor (taskset -c 0), where the
  runtime keeps two Ps: for each family, two routines start together
  and each makes one long call into the runtime (Move, FillChar, the
  allocation of a large block whose pages held something, string = and
  <, XxHash3, XxHash64, XxHash32), so both Ps are busy, while a third
  wakes every millisecond, makes a little garbage for the collector and
  counts the wakes that find both calls running (each call marks itself
  busy in its own word, no lock taken around it). The runtime goes 256
  KiB a piece and calls rt_yieldpoint between two when sysmon or the
  collector has asked the routine to stop, and only then can the third
  routine run while both calls do: with the whole length in one go it
  finds both busy never, as both Ps are theirs (1.1.120). A family runs
  again, its setup and its two calls, until five such wakes are counted
  in all, twelve tries or two minutes at most: a machine loaded with
  other work makes the wakes rarer and the test longer, never wrong
  (P379: it counted the wakes of one try between the later start and
  the earlier end, which a loaded machine once brought under five, the
  answer right). The two calls read the same source, and those of
  Move and FillChar write the same bytes to the same place, so the test
  holds 512 MiB at most. The allocation needs pages the heap reuses
  without giving them back to the kernel first: make check runs it with
  PASLANG_GC=20000, and the block of integers before it is taken and
  dropped by a routine that ends, so no word of a live stack keeps it;
  an eighth of it stays alive meanwhile, so the cycle's goal is above
  what the scavenger keeps resident. On amd64 six processes that spin (this program
  run again with the word hog and its parent's number) share the
  processor with the two calls and make each last some ten times as
  long; under qemu the runtime is slow enough on its own. Each family
  checks its answer: the copy and the fill byte by byte where they end,
  the new block all zero, the comparisons' results, both hashes alike
  and as xxhsum gives them. }
program rtslice;

uses paslib, sysutils;

const
  NHog = 6;
  NFam = 8;
  Names: array[0..7] of string = ('alloc', 'move', 'fillchar', 'streq',
    'strcmp', 'xxhash3', 'xxhash64', 'xxhash32');
  { each family's length in MiB: on amd64 some 15 to 30 ms of one call
    alone here, under qemu some 100 ms or more (the fills and clears of
    arm64 store 32 bytes a step since P272); the hashes read the strings
    the comparisons read }
  MiBAmd: array[0..7] of Integer = (256, 256, 256, 256, 256, 256, 256, 256);
  MiBArm: array[0..7] of Integer = (256, 128, 256, 256, 256, 256, 256, 256);
  { the three hashes of the 256 MiB of 'a' the comparisons read, on both
    machines, by xxhsum 0.8.4 (-H3, -H64, -H32: XXH3_64 9a4cbc3b6fde472d,
    XXH64 67cbf6d14f0034cf, XXH32 4e502136) }
  Hashes: array[0..7] of Integer = (0, 0, 0, 0, 0, -7328275530172709075, 7479342985012851919,
    1313874230);

var
  src, dst: array of Byte;
  s1, s2: string;
  family, n: Integer;
  ready, ticks, finished, both: Integer;
  busy, res: array[0..1] of Integer;
  mu: mutex;
  wg: waitgroup;

{ This program run with the word hog and its parent's number: spin until
  that parent is gone (getppid gives another), or a minute has passed.
  Only amd64 runs it. }
procedure Hog(Parent: Integer);
var
  start, i, x: Integer;
begin
  start := Nanotime;
  x := 0;
  while (Syscall(110) = Parent) and (Nanotime - start < 60000000000) do
    for i := 1 to 100000 do
      x := x + i;
  if x = 1 then
    WriteLn('never');
end;

procedure RunHog;
begin
  ExecuteProcess('/proc/self/exe', ['hog', IntToStr(Syscall(39))]);
end;

var
  dwg: waitgroup;

{ A block of N bytes of integers taken and dropped in a routine that
  ends: its pages go back to the heap held, not to the kernel. }
procedure Drop(N: Integer);
var
  j: array of Integer;
  i: Integer;
begin
  SetLength(j, N div 8);
  for i := 0 to Length(j) div 512 - 1 do
    j[i * 512] := i + 1;
  dwg.Done;
end;

{ The block the allocation family takes: its pages held a block of
  integers before, so rt_alloc clears them; it must be all nil. }
function AllocCheck: Integer;
var
  a: array of Pointer;
  i: Integer;
begin
  SetLength(a, n div 8);
  Result := 1;
  i := 0;
  while i < Length(a) do
  begin
    if a[i] <> nil then
      Result := 0;
    i := i + 4099;
  end;
end;

procedure Call(Id: Integer);
begin
  case family of
    0: res[Id] := AllocCheck;
    1:
      begin
        Move(src[0], dst[0], n);
        res[Id] := Ord((dst[0] = src[0]) and (dst[n - 1] = src[n - 1]) and (dst[n div 2] = src[n div 2]));
      end;
    2:
      begin
        FillChar(dst[0], n, 77);
        res[Id] := Ord((dst[0] = 77) and (dst[n - 1] = 77) and (dst[n div 3] = 77));
      end;
    3: res[Id] := Ord(s1 = s2);
    4: res[Id] := Ord(s1 < s2) + 2 * Ord(s2 < s1);
    5: res[Id] := XxHash3(s1);
    6: res[Id] := XxHash64(s1);
    7: res[Id] := XxHash32(s1);
  end;
end;

procedure Work(Id: Integer);
begin
  lock mu do
    ready := ready + 1;
  while ready < 2 do
    Yield;
  busy[Id] := 1;
  Call(Id);
  busy[Id] := 0;
  lock mu do
    finished := finished + 1;
  wg.Done;
end;

procedure Ticker;
var
  s: string;
begin
  while finished < 2 do
  begin
    ticks := ticks + 1;
    if (busy[0] = 1) and (busy[1] = 1) then
      both := both + 1;
    s := IntToStr(ticks) + 'x';
    if Length(s) = 0 then
      WriteLn('never');
    Sleep(1);
  end;
  wg.Done;
end;

var
  f, h, i, total, tries, start: Integer;
  right: Boolean;
  keep: array of Integer;

{ One try of family F: its setup, its two calls with the ticker beside
  them, their answer, and the wakes that found both busy added to total. }
procedure TryFamily(F: Integer);
begin
  case F of
    0:
      begin
        { first, while the heap is fresh: the pages both blocks will
          take hold integers before; a try again drops the blocks of the
          one before first }
        GcCollect;
        SetLength(keep, n div 64);
        dwg.Add(1);
        { a little more than twice: each block is n bytes and a header,
          a page more than n }
        pas Drop(2 * n + (n div 64));
        dwg.Wait;
        GcCollect;
        GcCollect;
      end;
    1:
      begin
        SetLength(keep, 0);
        SetLength(src, n);
        for i := 0 to n div 4096 - 1 do
          src[i * 4096] := Byte(i);
        src[n - 1] := 9;
        SetLength(dst, n);
      end;
    2:
      begin
        SetLength(src, 0);
        { the fill writes n bytes of dst, which the copy sized for its own }
        if Length(dst) < n then
          SetLength(dst, n);
      end;
    3:
      begin
        SetLength(dst, 0);
        SetLength(s1, n);
        FillChar(s1[1], n, 97);
        s2 := Copy(s1, 1, n);
      end;
    4: s2[n] := 'b';
  end;
  ready := 0;
  ticks := 0;
  finished := 0;
  both := 0;
  busy[0] := 0;
  busy[1] := 0;
  wg.Add(3);
  pas Ticker;
  pas Work(0);
  pas Work(1);
  wg.Wait;
  { the answer: both calls alike, and right where it can be known, at
    every try }
  right := right and (res[0] = res[1]);
  if F <= 3 then
    right := right and (res[0] = 1);
  if F = 4 then
    right := right and (res[0] = 1);
  if F >= 5 then
    right := right and (res[0] = Hashes[F]);
  total := total + both;
end;

begin
  if ParamStr(1) = 'hog' then
  begin
    Hog(StrToInt(ParamStr(2)));
    Halt(0);
  end;
  if Amd64 = 1 then
  begin
    for h := 1 to NHog do
      pas RunHog;
    Sleep(100);
  end;
  for f := 0 to NFam - 1 do
  begin
    family := f;
    if Amd64 = 1 then
      n := MiBAmd[f] shl 20
    else
      n := MiBArm[f] shl 20;
    total := 0;
    tries := 0;
    right := True;
    start := Nanotime;
    while (total < 5) and (tries < 12) and (Nanotime - start < 120000000000) do
    begin
      Inc(tries);
      TryFamily(f);
    end;
    WriteLn(Names[f], ': the right answer ', right, ', the other routine ran while both calls ran: ',
      total >= 5);
  end;
  Halt(0);
end.
