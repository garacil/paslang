{ P315: an arm64 constant goes into its register as Go's assembler puts
  it there, MOVZ or MOVN or ORR of a bitmask and the fewest MOVKs, with
  no load from a literal pool: constants of every class, assigned,
  added to a variable, compared, multiplied, passed, stored in an array
  and in a field, on both machines. scripts/check_armconst.py reads
  that no ldr of a literal is left anywhere in the arm64 assembly and
  that each constant takes the instructions Go's would. Written by a
  script; the answers are Python's. }
program armconst;

type
  TPair = record a, b: Integer; end;

var
  xs: array[0..63] of Integer;
  pr: TPair;
  i, t: Integer;

function Twice(x: Integer): Integer;
begin
  Result := x + x;
end;

function K0(x: Integer): Integer;
var
  v: Integer;
begin
  v := 65536;
  if x = 65536 then
    v := v + 1;
  Result := (v xor x) + Twice(65536);
end;

