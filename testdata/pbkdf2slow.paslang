program pbkdf2slow;
begin
  if Hex(Pbkdf2HmacSha1('password', 'salt', 16777216, 20)) <>
    'eefe3d61cd4da4e4e9945b3d6ba2158c2634e984' then Halt(120);
  WriteLn('ok PBKDF2 RFC 6070 long count');
end.

