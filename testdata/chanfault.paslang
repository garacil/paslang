{ P583: the failures of a channel as exceptions. A send on a closed
  channel (found closed, or closed while the sender waited; plain or as
  an arm of a select), a second close, a capacity out of range and a nil
  channel wrote their line and stopped the program, and a close with a
  sender waiting stopped it at the close. With SysUtils in the program
  and a try on the way each is raised now in the routine that made it,
  as Go panics there, its Message the line the runtime writes, without
  paslang: in front. Every one is taken here by its class, then by an
  ancestor, by a bare except, through a finally; a handler finds the
  variables of a loop as the statement found them; the channel's lock is
  given back, so the channel answers after its failure; the routine that
  closes goes on, and every sender that waited takes its own exception.

  With two arguments it dies of kind K instead, for the recipe to compare
  the runtime's own line with the Message printed here: die K with no try
  at all, fin K inside a try with a finally and no handler, pas K the
  same in a routine started with pas. }
program chanfault;

uses
  sysutils;

const
  Kinds = 15;
  Crowd = 40;

var
  shut, shutb, never, nilc: chan of Integer;
  mu: mutex;
  wg, crowdwg: waitgroup;
  got: string;
  dieK, zero, taken: Int64;

{ closes c when whoever started it has had the time to wait on it; if
  it has not, the send finds the channel closed and says the same }
procedure CloseLater(c: chan of Integer);
begin
  Sleep(20);
  Close(c);
end;

{ One failure of kind K. What is closed or nil is so when the program
  runs: nothing here is worked out by the compiler. }
procedure Fail(K: Int64);
var
  w: chan of Integer;
  n: Integer;
begin
  case K of
    1: Send(shut, 1);
    2: Send(shutb, 1);
    3:
      select
        Send(shut, 1): WriteLn('sent');
      else
        WriteLn('none');
      end;
    4:
      select
        Recv(never, n): WriteLn('got');
        Send(shut, 1): WriteLn('sent');
      end;
    5: Close(shut);
    6: w := MakeChan(-1 - zero);
    7: w := MakeChan(67108865 + zero);
    8: Send(nilc, 1);
    9: n := Recv(nilc);
    10: Close(nilc);
    11:
      select
        Recv(nilc, n): WriteLn('got');
      else
        WriteLn('none');
      end;
    12:
      select
        Recv(never, n): WriteLn('got');
        Send(nilc, 1): WriteLn('sent');
      end;
    13:
      begin
        w := MakeChan();
        pas CloseLater(w);
        Send(w, 5);
      end;
    14:
      begin
        w := MakeChan(2);
        Send(w, 1);
        Send(w, 2);
        pas CloseLater(w);
        Send(w, 3);
      end;
    15:
      begin
        w := MakeChan();
        pas CloseLater(w);
        select
          Recv(never, n): WriteLn('got');
          Send(w, 5): WriteLn('sent');
        end;
      end;
  end;
end;

{ every kind by its class: the lines the recipe compares, and the class
  under each }
procedure Caught;
var
  k: Int64;
begin
  for k := 1 to Kinds do
    try
      Fail(k);
      WriteLn('not raised');
    except
      on e: Exception do
      begin
        WriteLn('paslang: ', e.Message);
        WriteLn('  ', e.ClassName);
      end;
    end;
end;

procedure ByClass;
var
  i, total: Int64;
  w: chan of Integer;
begin
  try
    Fail(1);
  except
    on e: EInvalidOpException do
      WriteLn('a send by its class: ', e.ClassName);
  end;
  try
    Fail(6);
  except
    on e: EIntError do
      WriteLn('a capacity by an ancestor: ', e.ClassName);
  end;
  try
    Fail(8);
  except
    on e: EExternal do
      WriteLn('a nil channel by an ancestor: ', e.ClassName);
  end;
  try
    Fail(5);
  except
    WriteLn('by a bare except');
  end;
  try
    try
      Fail(15);
    finally
      WriteLn('finally on the way');
    end;
  except
    on e: EInvalidOpException do
      WriteLn('after the finally: ', e.Message);
  end;
  { the variables of a loop, as the statement found them }
  total := 0;
  i := 0;
  try
    for i := 1 to 10 do
    begin
      total := total + i;
      if i = 7 then
        Send(shut, total);
    end;
  except
    on e: EInvalidOpException do
      WriteLn('in a loop: i ', i, ' total ', total);
  end;
  { the place is the call's own, the last instruction of its line }
  try
    Close(shut);
    total := total + 1000;
  except
    on e: EInvalidOpException do
      WriteLn('the line is the call''s: ', e.Message);
  end;
  try
    Send(shut, 2);
    total := total + 1000;
  except
    on e: EInvalidOpException do
      WriteLn('and a send''s: ', e.Message);
  end;
  try
    Send(nilc, 2);
    total := total + 1000;
  except
    on e: EAccessViolation do
      WriteLn('and a nil channel''s: ', e.Message);
  end;
  { the channel's lock came back with each failure: the channel answers }
  WriteLn('a closed channel still gives ', Recv(shut), ' and ', Recv(shutb));
  { a lock block is left unlocked }
  try
    lock mu do
      Send(shut, 1);
  except
    on e: EInvalidOpException do
      WriteLn('under a lock: taken');
  end;
  lock mu do
    got := 'and the lock is free';
  WriteLn(got);
  { what a buffer held when its channel closed under a sender is still
    there, in its order, and the value that waited is not }
  w := MakeChan(2);
  Send(w, 11);
  Send(w, 22);
  pas CloseLater(w);
  try
    Send(w, 33);
    WriteLn('not raised');
  except
    on e: EInvalidOpException do
      WriteLn('the buffer after it: ', Recv(w), ' ', Recv(w), ' ', Recv(w));
  end;
  { a select that failed left its other channels as they were }
  w := MakeChan(1);
  try
    select
      Send(shut, 1): WriteLn('sent');
      Send(nilc, 1): WriteLn('sent');
      Recv(w, i): WriteLn('got');
    end;
  except
    on e: Exception do
    begin
      Send(w, 44);
      WriteLn('after a select: ', e.ClassName, ', and its other channel gives ', Recv(w));
    end;
  end;
end;

procedure OneOfMany(c: chan of Integer; Id: Int64);
begin
  try
    Send(c, Id);
  except
    on e: EInvalidOpException do
      lock mu do
        taken := taken + 1;
  end;
  crowdwg.Done;
end;

{ the routine that closes goes on, and every sender that waited takes
  its own exception: none is left asleep }
procedure Many;
var
  w: chan of Integer;
  k, first: Int64;
begin
  w := MakeChan();
  taken := 0;
  crowdwg.Add(Crowd);
  for k := 1 to Crowd do
    pas OneOfMany(w, k);
  first := Recv(w);
  Sleep(20);
  Close(w);
  WriteLn('the closer goes on');
  crowdwg.Wait;
  WriteLn(Crowd, ' senders: one was received, ', taken, ' took the exception');
  if (first < 1) or (first > Crowd) then
    WriteLn('a value nobody sent: ', first);
end;

procedure Worker;
begin
  try
    Fail(13);
  except
    on e: EInvalidOpException do
      got := 'a routine takes its own: ' + e.Message;
  end;
  wg.Done;
end;

procedure DieWorker;
begin
  try
    Fail(dieK);
  finally
    WriteLn('finally');
  end;
  wg.Done;
end;

begin
  zero := Ord(ParamCount > 99);
  shut := MakeChan();
  Close(shut);
  shutb := MakeChan(4);
  Close(shutb);
  never := MakeChan();
  if ParamCount = 2 then
  begin
    dieK := StrToInt(ParamStr(2));
    if ParamStr(1) = 'die' then
      Fail(dieK)
    else if ParamStr(1) = 'fin' then
    begin
      try
        Fail(dieK);
      finally
        WriteLn('finally');
      end;
    end
    else
    begin
      wg.Add(1);
      pas DieWorker;
      wg.Wait;
    end;
    WriteLn('not reached');
    Halt(0);
  end;
  Caught;
  ByClass;
  Many;
  wg.Add(1);
  pas Worker;
  wg.Wait;
  WriteLn(got);
  WriteLn('done');
end.

