{ P418: SQLite is a library unit, not a unit of the core: a program that
  does not name it in a uses clause does not see TSqlite, so this does
  not compile. }
program sqlnouses;

var
  db: TSqlite;

begin
  db := nil;
  WriteLn(db = nil);
end.

