{ P95a: the heap is Go's. Every block says what it holds and the heap
  keeps it: HeapMaskOf(p) is the pointer bits of the block that holds
  p (first 64 words), -1 off the heap; HeapCheck walks every span and
  counts what does not hold. Small strings share 16-byte blocks (the
  tiny allocator) and must not overlap; routines on several Ps allocate
  at once from their own caches. }
program heapspan;

uses
  paslib;

type
  PNode = ^TNode;
  TNode = record
    Name: string;
    Count: Integer;
    Next: PNode;
  end;
  TPair = record
    L, R: string;
  end;
  PBig = ^TBig;
  TBig = record
    S: string;
    Pad: array[0..99] of Integer;
  end;
  TBox = class
    Title: string;
    Items: array of Integer;
  end;

var
  n: PNode;
  pairs: array of TPair;
  big: PBig;
  box: TBox;
  raw, bytes, huge, hugeraw: Pointer;
  strs: array of string;
  i, j, bad, local: Integer;
  s: string;
  wg: waitgroup;
  errs: Integer;

procedure Churn(Seed: Integer);
var
  k, m: Integer;
  mine: array of string;
  q: PNode;
begin
  SetLength(mine, 500);
  for k := 0 to 499 do
    mine[k] := 'w' + IntToStr(Seed * 1000 + k);
  for k := 0 to 2000 do
  begin
    New(q);
    q^.Name := IntToStr(k);
    q^.Count := k;
  end;
  m := 0;
  for k := 0 to 499 do
    if mine[k] <> 'w' + IntToStr(Seed * 1000 + k) then
      m := m + 1;
  AtomicAdd(@errs, m);
  wg.Done;
end;

begin
  New(n);
  n^.Name := 'node';
  WriteLn('node ', HeapMaskOf(n), ' ', HeapMaskOf(@n^.Count));
  SetLength(pairs, 4);
  { Word 16 is the block's frontier after its four pairs (1.0.88), where
    a fifth pair's first string would be: a count, never a heap address,
    so the collector passes it by. }
  WriteLn('pairs ', HeapMaskOf(@pairs[0]));
  box := TBox.Create;
  WriteLn('box ', HeapMaskOf(box));
  New(big);
  WriteLn('header ', HeapMaskOf(big), ' ', HeapMaskOf(@big^.Pad[50]));
  GetMem(raw, 64);
  GetMem(bytes, 64, 0);
  WriteLn('getmem ', HeapMaskOf(raw), ' ', HeapMaskOf(bytes));
  GetMem(huge, 100000, 0);
  GetMem(hugeraw, 100000);
  WriteLn('large ', HeapMaskOf(huge), ' ', HeapMaskOf(hugeraw));
  s := 'x' + IntToStr(7);
  WriteLn('string ', HeapMaskOf(@s[1]), ' local ', HeapMaskOf(@local));
  { Tiny blocks: strings of 1 to 15 bytes, each checked after all exist. }
  SetLength(strs, 20000);
  for i := 0 to 19999 do
  begin
    s := '';
    for j := 1 to 1 + i mod 15 do
      s := s + Chr(97 + (i + j) mod 26);
    strs[i] := s;
  end;
  bad := 0;
  for i := 0 to 19999 do
  begin
    if Length(strs[i]) <> 1 + i mod 15 then
      bad := bad + 1
    else
      for j := 1 to Length(strs[i]) do
        if strs[i][j] <> Chr(97 + (i + j) mod 26) then
          bad := bad + 1;
  end;
  WriteLn('tiny ', bad);
  wg.Add(8);
  for i := 1 to 8 do
    pas Churn(i);
  wg.Wait;
  WriteLn('routines ', errs);
  WriteLn('check ', HeapCheck);
end.

