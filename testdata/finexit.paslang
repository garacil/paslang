{ finally runs on Exit, Break and Continue as well as on the normal
  path, including nested try blocks inside a loop. }
program finexit;

procedure P(N: Integer);
begin
  try
    WriteLn('in ', N);
    if N = 1 then
      Exit;
    WriteLn('after ', N);
  finally
    WriteLn('finally ', N);
  end;
  WriteLn('end ', N);
end;

function Nested: Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to 4 do
    try
      try
        if i = 2 then
          Continue;
        if i = 4 then
          Break;
        Result := Result + i;
      finally
        Result := Result + 10;
      end;
    finally
      Result := Result + 100;
    end;
end;

begin
  P(1);
  P(2);
  WriteLn(Nested);
end.

