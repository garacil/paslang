{$mode objfpc}{$H+}
program pathscompat;
uses sysutils;
var
  path, header: string;
  i, count: Integer;
begin
  ReadLn(header);
  count := StrToInt(header);
  for i := 1 to count do
  begin
    ReadLn(path);
    WriteLn(ExtractFileName(path));
    WriteLn(ExtractFilePath(path));
    WriteLn(ExtractFileDir(path));
    WriteLn(ExtractFileExt(path));
    WriteLn(ChangeFileExt(path, '.new'));
    {$ifdef FPC}
    { ChangeFilePath was added after the installed FPC 3.2.2. The
      current FPC fina.inc defines exactly this expression. }
    WriteLn(IncludeTrailingPathDelimiter('base') + ExtractFileName(path));
    {$else}
    WriteLn(ChangeFilePath(path, 'base'));
    {$endif}
    WriteLn(IncludeTrailingPathDelimiter(path));
    WriteLn(ExcludeTrailingPathDelimiter(path));
    WriteLn(IncludeLeadingPathDelimiter(path));
    WriteLn(ExcludeLeadingPathDelimiter(path));
    WriteLn(Ord(IsPathDelimiter(path, 0)), ' ', Ord(IsPathDelimiter(path, 1)),
      ' ', Ord(IsPathDelimiter(path, Length(path))), ' ', Ord(IsPathDelimiter(path, Length(path) + 1)));
  end;
end.
