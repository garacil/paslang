program charliteralconst;
type TCharAlias = Char;
const
  Named = 'A';
  CastConst = Char('A');
  TypedConst: Char = Char('A');
  AliasConst: TCharAlias = TCharAlias('A');
  NameConst = Char(Named);
  NamedAlias = TCharAlias(Named);
  ZeroConst = Char(#0);
  TopConst = Char(#255);
  NestedConst = Char(Char('A'));
  OrdConst = Ord(Char('A'));
  IntConst = Integer(Char('A'));
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('char literal ', Stage, ': ', Actual, ' <> ', Expected); Halt(94); end;
end;
function DefaultChar(C: Char = Char('A')): Char;
begin Result := C; end;
function DefaultAlias(C: TCharAlias = TCharAlias(Named)): Char;
begin Result := C; end;
function DefaultZero(C: Char = Char(#0)): Char;
begin Result := C; end;
function DefaultTop(C: TCharAlias = TCharAlias(#255)): Char;
begin Result := C; end;
function LiteralResult: Char;
begin Result := Char('A'); end;
var
  Stored: Char = Char('A');
  StoredAlias: TCharAlias = TCharAlias(Named);
  C: Char; B: Byte;
begin
  Equal(1, Ord(CastConst), 65);
  Equal(2, Ord(TypedConst), 65);
  Equal(3, Ord(AliasConst), 65);
  Equal(4, Ord(NameConst), 65);
  Equal(5, Ord(NamedAlias), 65);
  Equal(6, Ord(ZeroConst), 0);
  Equal(7, Ord(TopConst), 255);
  Equal(8, Ord(NestedConst), 65);
  Equal(9, OrdConst, 65);
  Equal(10, IntConst, 65);
  Equal(11, Ord(DefaultChar()), 65);
  Equal(12, Ord(DefaultAlias()), 65);
  Equal(13, Ord(DefaultZero()), 0);
  Equal(14, Ord(DefaultTop()), 255);
  Equal(15, Ord(Stored), 65);
  Equal(16, Ord(StoredAlias), 65);
  C := Char('A'); Equal(17, Ord(C), 65);
  C := TCharAlias(Named); Equal(18, Integer(C), 65);
  Equal(19, Ord(Char('A')), 65);
  Equal(20, Integer(Char('A')), 65);
  Equal(21, Ord(LiteralResult()), 65);
  Equal(22, Integer(Char(#0)), 0);
  Equal(23, Ord(TCharAlias(#255)), 255);
  B := Ord(Char('A')); Equal(24, B, 65);
  Equal(25, SizeOf(Char('A')), 1);
  WriteLn(CastConst, Ord(CastConst));
  WriteLn('ok character literal casts');
end.
