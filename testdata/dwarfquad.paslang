program dwarfquad;

{ The debug information types a Quad local (1.0.115): a 16-byte float
  named _Float128, which gdb reads as IEEE binary128 on amd64 too, where
  its 16-byte long double is x87's. }

procedure Show;
var
  q: Quad;
begin
  q := Quad(1) / 3;
  WriteLn(q:0:36);
end;

begin
  Show;
end.

