program cpufold;

{ CpuHas of a feature the target never has, or always has, is a
  constant (1.0.124): the branch goes at compile time, so the .s of
  amd64 has no 'only on arm64' and that of arm64 no 'only on amd64'. }

begin
  if CpuHas('neon') then
    WriteLn('only on arm64');
  if CpuHas('sse2') and CpuHas('simd128') then
    WriteLn('only on amd64');
  if CpuHas('avx2') or CpuHas('sve') then
    WriteLn('wide vectors');
end.
