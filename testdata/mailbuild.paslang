{ P433: TMailBuilder. testdata/mailbuild.txt (scripts/mail_build_verify.py gen
  writes it) holds 93 messages as ops (a sender, recipients, a subject, texts,
  files, extra fields, a fixed date, message id and boundary); each is built
  here and written after a line === ID, or raised: and the text of what refused
  it. The golden file is that output. scripts/mail_build_verify.py verify
  reads the same output and checks every message as Python's email package
  reads it: 7 bits, CRLF, lines of at most 998 bytes and fields of 78, the
  fields, the bodies, the files, the structure; the ones that must be refused
  are refused. }
program mailbuild;

uses
  sysutils, pascodec, pastextproto, pasmime;

function Un64(const S: string): string;
begin
  if S = '-' then
    Result := ''
  else if not Base64Decode(S, False, True, Result) then
  begin
    WriteLn('bad base64');
    Halt(2);
  end;
end;

var
  spec, line, rest, op, id, msg: string;
  args: array of string;
  p, nl, q1: Integer;
  b: TMailBuilder;
  nCases: Integer;
  e: TMailEntity;
  err, mid: string;

begin
  if not ReadFile('testdata/mailbuild.txt', spec) then
  begin
    WriteLn('no testdata/mailbuild.txt');
    Halt(2);
  end;
  { the envelope list is the To, Cc and Bcc addresses in order }
  b := TMailBuilder.Create;
  b.Sender.Address := 'a@b.c';
  b.AddTo('', 'to@x.y');
  b.AddCc('', 'cc@x.y');
  b.AddBcc('', 'bcc@x.y');
  WriteLn('recipients ', Length(b.Recipients), ' ', b.Recipients[0], ' ', b.Recipients[1], ' ', b.Recipients[2]);
  b := nil;
  nCases := 0;
  p := 1;
  while p <= Length(spec) do
  begin
    nl := p;
    while (nl <= Length(spec)) and (spec[nl] <> #10) do
      nl := nl + 1;
    line := Copy(spec, p, nl - p);
    p := nl + 1;
    q1 := Pos(' ', line);
    id := Copy(line, 1, q1 - 1);
    rest := Copy(line, q1 + 1, Length(line) - q1);
    q1 := Pos(' ', rest);
    if q1 = 0 then
    begin
      op := rest;
      rest := '';
    end
    else
    begin
      op := Copy(rest, 1, q1 - 1);
      rest := Copy(rest, q1 + 1, Length(rest) - q1);
    end;
    SetLength(args, 0);
    while rest <> '' do
    begin
      q1 := Pos(' ', rest);
      SetLength(args, Length(args) + 1);
      if q1 = 0 then
      begin
        args[Length(args) - 1] := Un64(rest);
        rest := '';
      end
      else
      begin
        args[Length(args) - 1] := Un64(Copy(rest, 1, q1 - 1));
        rest := Copy(rest, q1 + 1, Length(rest) - q1);
      end;
    end;
    if op = 'new' then
      b := TMailBuilder.Create
    else if op = 'from' then
    begin
      b.Sender.Name := args[0];
      b.Sender.Address := args[1];
    end
    else if op = 'to' then
      b.AddTo(args[0], args[1])
    else if op = 'cc' then
      b.AddCc(args[0], args[1])
    else if op = 'bcc' then
      b.AddBcc(args[0], args[1])
    else if op = 'replyto' then
    begin
      b.ReplyTo.Name := args[0];
      b.ReplyTo.Address := args[1];
    end
    else if op = 'subject' then
      b.Subject := args[0]
    else if op = 'text' then
      b.TextBody := args[0]
    else if op = 'html' then
      b.HtmlBody := args[0]
    else if op = 'att' then
      b.Attach(args[0], args[1], args[2])
    else if op = 'inl' then
      b.AttachInline(args[0], args[1], args[2], args[3])
    else if op = 'hdr' then
      b.AddHeader(args[0], args[1])
    else if op = 'date' then
      b.SetDate(StrToInt(args[0]), StrToInt(args[1]))
    else if op = 'mid' then
      b.MessageId := args[0]
    else if op = 'boundary' then
      b.Boundary := args[0]
    else if op = 'build' then
    begin
      nCases := nCases + 1;
      WriteLn('=== ', id);
      try
        msg := b.Build;
        Write(msg);
        WriteLn('');
      except
        on E: Exception do
          WriteLn('raised: ', E.Message);
      end;
    end;
  end;
  { a boundary and an id made at random: well formed, and the message reads back }
  b := TMailBuilder.Create;
  b.Sender.Address := 'me@example.net';
  b.AddTo('', 'you@example.org');
  b.Subject := 'random';
  b.TextBody := 'text' + #10;
  b.HtmlBody := '<p>html</p>';
  b.Attach('f.bin', '', 'data');
  msg := b.Build;
  if not MailParseEntity(msg, e, err) then
    WriteLn('FAIL random message does not read: ', err)
  else if (e.MediaType <> 'multipart/mixed') or (e.KidCount <> 2) or (e.Kid(0).KidCount <> 2) or (e.BodyErr <> '') then
    WriteLn('FAIL random message has the wrong tree')
  else if not MimeBoundaryValid(e.Params.Get('boundary')) or (Length(e.Params.Get('boundary')) <> 60) then
    WriteLn('FAIL random boundary ', e.Params.Get('boundary'))
  else
  begin
    mid := e.Header.Get('Message-Id');
    if (mid = '') or (mid[1] <> '<') or (Pos('@example.net>', mid) = 0) or (Length(mid) <> 24 + 14) then
      WriteLn('FAIL random id ', mid);
  end;
  WriteLn('cases ', nCases);
end.
