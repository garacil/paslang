program single;

{ Single is IEEE binary32 (P101): stored in 4 bytes, worked out in 32
  bits, a constant rounded once from its digits; Single with Single stays
  Single, with a Double it becomes Double; the context gives the width
  (d := s * t is worked out in Double); Double to Single takes Single(x).
  Checked against the same program in C with float and double. }

type
  TVec = record
    B: Byte;
    X, Y: Single;
    W: Word;
    Z: Single;
  end;

const
  Third = 1 / 3;

var
  s, t, u: Single;
  d, e: Double;
  i, n: Integer;
  v: TVec;
  a: array[0..9] of Single;
  q: array of Single;

function Half(x: Single): Single;
begin
  Result := x / 2;
end;

function Twice(x: Double): Double;
begin
  Result := x * 2;
end;

procedure Show(const Name: string; x: Double);
begin
  WriteLn(Name, ' ', x:0:12);
end;

procedure Over(x: Single); overload;
begin
  WriteLn('Single ', x:0:9);
end;

procedure Over(x: Double); overload;
begin
  WriteLn('Double ', x:0:17);
end;

procedure Def(x: Single = 0.1);
begin
  WriteLn('default ', x:0:12);
end;

begin
  WriteLn(SizeOf(Single), ' ', SizeOf(s), ' ', SizeOf(TVec), ' ', SizeOf(a));
  s := 0.1;
  d := 0.1;
  Show('s 0.1', s);
  Show('d 0.1', d);
  WriteLn(s = 0.1, ' ', d = s, ' ', s < d);
  t := 3;
  u := s * t;
  Show('s*3', u);
  d := s * t;
  Show('d:=s*t', d);
  Show('Double(s*t)', Double(s * t));
  Show('Single(d)', Single(d));
  u := Single(0.1 * 3);
  Show('Single(0.1*3)', u);
  s := 1;
  for i := 1 to 30 do
    s := s * 1.1 + 0.3;
  Show('chain', s);
  d := 1;
  for i := 1 to 30 do
    d := d * 1.1 + 0.3;
  Show('chain d', d);
  n := 16777217;
  s := n;
  Show('16777217', s);
  s := 16777217;
  Show('const 16777217', s);
  s := -2.5;
  Show('neg', -s);
  Show('abs', Abs(s));
  Show('sqr', Sqr(Single(1.1)));
  Show('sqrt', Sqrt(Single(2)));
  Show('sqrt d', Sqrt(2.0));
  Show('min', Min(Single(0.3), Single(0.2)));
  Show('max', Max(Single(0.3), 0.2));
  WriteLn(Trunc(Single(2.75)), ' ', Round(Single(2.5)), ' ', Round(Single(3.5)), ' ', Trunc(Single(-7.9)));
  s := 1e-45;
  Show('tiny', s * 1e30);
  s := 3.4028234e38;
  Show('big/1e30', s / 1e30);
  Show('big*2 inf', s * 2);
  { Write is no context: worked out in Single. }
  WriteLn(s / 1e30:0:3, ' ', s * 2);
  s := Third;
  Show('third', s);
  s := Pi;
  Show('pi', s);
  v.B := 7;
  v.X := 1.5;
  v.Y := -0.1;
  v.W := 65535;
  v.Z := v.X * v.Y;
  Show('v.Z', v.Z);
  WriteLn(v.B, ' ', v.W);
  for i := 0 to 9 do
    a[i] := i / 7;
  s := 0;
  for i := 0 to 9 do
    s := s + a[i] * a[i];
  Show('sumsq', s);
  SetLength(q, 5);
  for i := 0 to 4 do
    q[i] := Half(i + 0.5);
  Show('q4', q[4]);
  Show('twice', Twice(Half(3)));
  s := 0.5;
  Inc(s);
  Inc(s, 0.25);
  Dec(s, 2);
  Show('inc', s);
  Over(1.5);
  Over(Single(1.5));
  s := 0.1;
  Over(s);
  Def;
  Def(0.2);
  e := 1e300;
  Show('Single(1e300)', Single(e));
  WriteLn(s * s:0:12);
  WriteLn(s);
end.

