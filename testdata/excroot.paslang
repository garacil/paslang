{ P660: Exception is the root of every error class of the library. The
  errors of SQLite, of JSON and of Currency were classes of TObject, so
  on E: Exception let them by and a service that took Exception died of
  them (supervisor, 2026-11-16). Each is taken by on E: Exception with
  its message; its own class still takes it; CreateFmt and CreateFmtHelp
  still make an Exception and an EConvertError; a fault of the runtime
  is still an Exception. }
program excroot;

uses
  sysutils, sqlite;

var
  db: TSqlite;
  j: json;
  c, d: Currency;
  e: Exception;
  a: array of Integer;
  i: Integer;
begin
  SetLength(a, 2);
  db := TSqlite.Open(':memory:');
  try
    db.Exec('INSERT INTO nonexistent VALUES (1)');
  except
    on E: Exception do
      WriteLn('SQLite: ', E.ClassName, ' is an Exception: ', E.Message);
  end;
  try
    db.Exec('INSERT INTO nonexistent VALUES (1)');
  except
    on E: ESqliteError do
      WriteLn('SQLite: still its own class, code ', E.Code);
  end;
  try
    { a text made when the program runs: a constant is parsed when compiling }
    j := JsonParse('{"a": [1, ' + IntToStr(Length(a)));
    WriteLn(JsonEncode(j));
  except
    on E: Exception do
      WriteLn('JSON: ', E.ClassName, ' is an Exception: ', E.Message);
  end;
  try
    c := 900000000000000;
    d := c * c;
    WriteLn(d);
  except
    on E: Exception do
      WriteLn('Currency: ', E.ClassName, ' is an Exception: ', E.Message);
  end;
  e := Exception.CreateFmt('bad %s at %d', ['thing', 7]);
  WriteLn('CreateFmt: ', e.ClassName, ': ', e.Message);
  e := Exception.CreateFmtHelp('help %d', [9], 33);
  WriteLn('CreateFmtHelp: ', e.Message, ' ', e.HelpContext);
  try
    raise EConvertError.CreateFmt('routine %d', [5]);
  except
    on E: Exception do
      WriteLn('a descendant''s CreateFmt: ', E.ClassName, ': ', E.Message);
  end;
  SetLength(a, 2);
  i := 5;
  try
    a[i] := 1;
  except
    on E: Exception do
      WriteLn('a fault of the runtime: ', E.ClassName, ', an Exception');
  end;
end.
