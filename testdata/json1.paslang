{ P203: the json type. A document parsed, read by name, by place and by
  JSON Pointer, walked in every form of for, measured, compared as JSON
  values and written back compact, a value a line and in RFC 8785's
  form; null and nil; an index of an object of 1000 members and of an
  array; a json in a record, a slice and a map. }
program json1;

type
  TRec = record
    Name: string;
    Doc: json;
  end;

const
  Text = '{"users":[{"id":1,"name":"Ana","tags":["a","b"],"admin":true},' +
    '{"id":2,"name":"Bo\u00f1o","tags":[],"admin":false,"note":null}],' +
    '"count":2,"ratio":0.25,"big":12345678901234567890,"path/~x":"slash",' +
    '"empty":{},"nested":[[1,[2,[3]]]]}';

var
  doc, u, v, w: json;
  k, s: string;
  i, n: Integer;
  r: TRec;
  list: array of json;
  m: map[string] of json;
  nothing: json;
  big: json;
  ix: TJsonIndex;
  t: string;

begin
  doc := JsonParse(Text);
  WriteLn(doc['count'].AsInteger, ' ', doc['ratio'].AsFloat, ' ', doc['users'][1]['name'].AsString);
  WriteLn(doc['users', 0, 'tags', 1].AsString, ' ', doc.At('/users/0/id').AsInteger, ' ',
    doc.At('/path~1~0x').AsString);
  WriteLn(Length(doc['users']), ' ', Length(doc), ' ', Length(doc['empty']), ' ', Length(doc['users'][1]['tags']));
  WriteLn('users' in doc, ' ', 'nobody' in doc, ' ', 'id' in doc['users'][0], ' ', 'x' in doc['count']);
  WriteLn(doc['users'][1]['note'].IsNull, ' ', doc['users'][0]['admin'].AsBoolean, ' ',
    doc['users'][1]['admin'].AsBoolean);
  if TryGet(doc, 'count', v) then
    WriteLn('count ', v);
  if not TryGet(doc, 'missing', v) then
    WriteLn('no missing, v ', v);
  if TryGet(doc['users'], 1, v) then
    WriteLn('user 1 ', v['id']);
  if not TryGet(doc['users'], 5, v) then
    WriteLn('no user 5');
  w := doc.Find('ratio');
  WriteLn('find ', w, ' ', doc.Find('absent'), ' ', doc['count'].Find('x'));
  WriteLn(doc['big'].AsNumber, ' ', doc['big'].AsFloat);

  { every form of for }
  for v in doc['users'][0]['tags'] do
    Write(v.AsString, ' ');
  WriteLn;
  for k in doc do
    Write(k, ' ');
  WriteLn;
  for k, v in doc['users'][0] do
    Write(k, '=', v, ' ');
  WriteLn;
  for i, v in doc['nested'][0] do
    Write(i, ':', v, ' ');
  WriteLn;
  n := 0;
  for v in doc do
  begin
    if v.Kind = jkArray then
      Continue;
    n := n + 1;
    if n = 4 then
      Break;
  end;
  WriteLn('values before the break ', n);
  for v in doc['empty'] do
    WriteLn('never');

  { kinds }
  for v in doc do
    case v.Kind of
      jkNull: Write('null ');
      jkBoolean: Write('boolean ');
      jkNumber: Write('number ');
      jkString: Write('string ');
      jkArray: Write('array ');
      jkObject: Write('object ');
    end;
  WriteLn;

  { null and nil }
  WriteLn(nothing, ' ', nothing.IsNull, ' ', nothing.Kind = jkNull, ' ', nothing = nil, ' ',
    doc['users'][1]['note'] = nil, ' ', doc = nil);

  { equality as JSON values }
  u := JsonParse('{"b":[1,2.0,{"c":null}],"a":"x"}');
  w := JsonParse(' { "a" : "\u0078", "b" : [ 1e0, 20e-1, { "c" : null } ] } ');
  WriteLn(u = w, ' ', u <> w, ' ', u['b'] = w['b'], ' ', u = doc, ' ', JsonParse('1') = JsonParse('1.0'),
    ' ', JsonParse('[1,2]') = JsonParse('[2,1]'));

  { writing }
  WriteLn(doc['users'][1]);
  WriteLn('[', doc['count']:6, ']', '[', doc['users'][0]['name']:8, ']');
  WriteLn(JsonEncode(u));
  WriteLn(JsonEncode(u, JsonPretty));
  WriteLn(JsonEncode(u, JsonCanonical));
  s := JsonEncode(doc);
  WriteLn(Length(s), ' ', JsonParse(s) = doc);

  { an index: an object's members and an array's elements in O(1) }
  t := '{';
  for i := 0 to 999 do
  begin
    if i > 0 then
      t := t + ',';
    Str(i, k);
    t := t + '"m' + k + '":' + k;
  end;
  big := JsonParse(t + '}');
  ix := JsonIndex(big);
  WriteLn(ix.Count, ' ', ix.Get('m0'), ' ', ix.Get('m999'), ' ', ix.Has('m500'), ' ', ix.Has('m1000'),
    ' ', ix.Find('x'), ' ', ix.Doc = big);
  try
    WriteLn(ix.Get('nope'));
  except
    on e: EJsonError do
      WriteLn(e.Message);
  end;
  ix := JsonIndex(doc['nested'][0]);
  WriteLn(ix.Count, ' ', ix.Item(1), ' ', ix.Item(0));
  try
    WriteLn(ix.Item(2));
  except
    on e: EJsonError do
      WriteLn(e.Message);
  end;

  { a json kept in a record, a slice and a map }
  r.Name := 'first';
  r.Doc := doc['users'][0];
  list := nil;
  for v in doc['users'] do
    list := Append(list, v['name']);
  New(m);
  m['n'] := doc['nested'];
  WriteLn(r.Name, ' ', r.Doc['id'], ' ', Length(list), ' ', list[1].AsString, ' ', m['n'][0][1][1][0]);
end.
