{ P308: an arm64 prologue takes its frame size as SUB's immediates,
  one up to 4095 bytes, two up to 16 MiB and a literal past that, and
  the stack check its frame and margin the same way, with no load from
  a word after the body. Routines with frames of a few words, about
  4 KiB, 70000 bytes and past 16 MiB, every word of their frames written
  and read back, and a recursion whose frames grow the stack. }
program framesize;

function Small(n: Integer): Integer;
var
  a: array[0..2] of Integer;
begin
  { an array a register does not hold, so Small keeps a frame of a few
    words (P296: a routine that calls nothing keeps its words in
    registers, with no frame) }
  a[0] := n * 3;
  a[1] := a[0] + 7;
  Result := a[0] xor a[1];
end;

function Near4K(n: Integer): Integer;
var
  a: array[0..503] of Integer;
  i, t: Integer;
begin
  for i := 0 to 503 do
    a[i] := i * n;
  t := 0;
  for i := 0 to 503 do
    t := t + a[i];
  Result := t;
end;

function Past4K(n: Integer): Integer;
var
  a: array[0..520] of Integer;
  i, t: Integer;
begin
  for i := 0 to 520 do
    a[i] := i + n;
  t := 0;
  for i := 0 to 520 do
    t := t xor a[i];
  Result := t;
end;

function Big(n: Integer): Integer;
var
  a: array[0..8749] of Integer;
  i, t: Integer;
begin
  for i := 0 to 8749 do
    a[i] := i * 31 + n;
  t := 0;
  for i := 8749 downto 0 do
    t := t * 3 + a[i];
  Result := t;
end;

function Huge(n: Integer): Integer;
var
  a: array[0..2199999] of Integer;
  i, t: Integer;
begin
  for i := 0 to 2199999 do
    a[i] := i xor n;
  t := 0;
  for i := 0 to 2199999 do
    t := t + a[i] * (i and 7);
  Result := t;
end;

function Deep(n: Integer): Integer;
var
  a: array[0..299] of Integer;
  i: Integer;
begin
  for i := 0 to 299 do
    a[i] := n + i;
  if n = 0 then
    Result := a[299]
  else
    Result := Deep(n - 1) + a[n mod 300];
end;

begin
  WriteLn(Small(5), ' ', Near4K(3), ' ', Past4K(9));
  WriteLn(Big(1), ' ', Big(2));
  WriteLn(Huge(7));
  WriteLn(Deep(2000));
end.
