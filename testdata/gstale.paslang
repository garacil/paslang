{ P354: a routine's record keeps no word it no longer needs. Holder's
  stack grows at a call of Deep with the address of an array of eight
  megabytes in an argument register: rt_morestack saves the registers
  in the record (G+72 on), and the restart loads them back. Holder then
  lets the array go and waits, alive, while the main routine collects:
  the array goes, since the collector, which reads the record word by
  word, finds no copy of its address there any more. Before, it stayed
  until a later preemption wrote over the word, and strone counted -3
  bytes a string under load. }
program gstale;

var
  big: array of Integer;
  hold, done: chan of Integer;

function Deep(P: PInteger; N: Integer): Integer;
var
  pad: array[0..31] of Integer;
  i: Integer;
begin
  for i := 0 to 31 do
    pad[i] := N + i;
  if N = 0 then
    Result := P^ + pad[3]
  else
    Result := Deep(P, N - 1) + pad[N and 31] - N - (N and 31);
end;

procedure Holder;
var
  x: Integer;
begin
  x := Deep(@big[0], 40);
  big := nil;
  Send(done, x);
  x := Recv(hold);
end;

procedure Collect;
var
  c: Integer;
begin
  c := 0;
  while c < 2 do
    if GcCollect = 1 then
      c := c + 1
    else
      Sleep(1);
end;

var
  before, after, r: Integer;

begin
  SetLength(big, 1000000);
  big[0] := 1000000;
  hold := MakeChan();
  done := MakeChan();
  Collect;
  before := HeapStat(1);
  pas Holder;
  r := Recv(done);
  Collect;
  after := HeapStat(1);
  WriteLn('Deep: ', r);
  if before - after > 7000000 then
    WriteLn('the array went with the routine still waiting')
  else
    WriteLn('the array stayed, ', after, ' bytes alive');
  Send(hold, 0);
end.
