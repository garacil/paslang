program forwardp;

procedure Later(N: Integer); forward;
function Twice(N: Integer): Integer; forward;
procedure Bump(var N: Integer); forward;
procedure Ping(N: Integer); forward;
procedure Pong(N: Integer); forward;

procedure UseIt;
  procedure Inner(N: Integer); forward;
  procedure Inner(N: Integer);
  begin
    WriteLn(N);
  end;
begin
  Later(3);
  WriteLn(Twice(4));
  Inner(9);
end;

procedure Later(N: Integer);
begin
  WriteLn(N);
end;

function Twice(N: Integer): Integer;
begin
  Result := N + N;
end;

procedure Bump(var N: Integer);
begin
  N := N + 1;
end;

procedure Ping(N: Integer);
begin
  if N > 0 then
    Pong(N);
end;

procedure Pong(N: Integer);
begin
  WriteLn(N);
  Ping(N - 1);
end;

var
  k: Integer;

begin
  UseIt;
  k := 10;
  Bump(k);
  WriteLn(k);
  Ping(2);
end.

