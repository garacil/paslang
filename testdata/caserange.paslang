program caserange;

{ case labels (1.0.78): ranges lo..hi, constant expressions, labels
  beyond 32 bits, and a case of a string. }

type
  TDay = (Mon, Tue, Wed, Thu, Fri, Sat, Sun);

const
  Big = 3000000000;
  Top = 9223372036854775807;

function Kind(N: Integer): string;
begin
  case N of
    -9223372036854775807 - 1..-1: Result := 'negative';
    0: Result := 'zero';
    1..9: Result := 'digit';
    10, 20, 30..39: Result := 'tens';
    Big: Result := 'big';
    Big + 1..Top - 1: Result := 'huge';
    Top: Result := 'top';
  else
    Result := 'other';
  end;
end;

function Letter(C: Char): string;
begin
  case C of
    'a'..'z': Result := 'lower';
    'A'..'Z': Result := 'upper';
    '0'..'9', '_': Result := 'digit or _';
  else
    Result := 'symbol';
  end;
end;

function Weekend(D: TDay): Boolean;
begin
  case D of
    Mon..Fri: Result := False;
    Sat, Sun: Result := True;
  end;
end;

function Command(const S: string): Integer;
begin
  case S of
    'start', 'go': Result := 1;
    'stop': Result := 2;
    '': Result := 0;
    'x' + 'y': Result := 3;
  else
    Result := -1;
  end;
end;

var
  i, sum: Integer;
  w: string;

begin
  WriteLn(Kind(-5), ' ', Kind(0), ' ', Kind(7), ' ', Kind(20), ' ', Kind(35), ' ', Kind(15));
  WriteLn(Kind(3000000000), ' ', Kind(3000000001), ' ', Kind(9223372036854775807), ' ', Kind(-9223372036854775807 - 1));
  WriteLn(Letter('q'), ' ', Letter('Q'), ' ', Letter('5'), ' ', Letter('_'), ' ', Letter('#'));
  WriteLn(Weekend(Tue), ' ', Weekend(Sat), ' ', Weekend(Sun));
  w := 'st';
  w := w + 'op';
  WriteLn(Command('go'), ' ', Command('start'), ' ', Command(w), ' ', Command(''), ' ', Command('xy'), ' ', Command('stops'));
  sum := 0;
  for i := -3 to 50 do
    case i mod 10 of
      0..4: sum := sum + 1;
      5..9: sum := sum + 100;
    else
      sum := sum + 10000;
    end;
  WriteLn(sum);
end.

