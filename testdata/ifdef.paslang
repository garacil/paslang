program ifdef;

{ Conditional compilation (1.0.121): ifdef, ifndef, else, endif, define
  and undef, nested, with PASLANG and the processor under FPC's names,
  so one source builds with either compiler on either machine. Each
  machine takes exactly one of its branches. }

{$mode objfpc}{$H+}
{$define MINE}

var
  n: Integer;

begin
  n := 0;
{$ifdef PASLANG}
  WriteLn('paslang');
{$else}
  WriteLn('another compiler');
{$endif}
{$ifdef CPUAARCH64}
  n := n + 1;
{$else}
  {$ifdef CPUX86_64}
  n := n + 1;
  {$else}
  n := n + 100;
  {$endif}
{$endif}
{$ifdef CPU64}
  n := n + 10;
{$endif}
{$ifndef MINE}
  WriteLn('not mine');
{$endif}
{$ifdef MINE}
  WriteLn('mine');
{$endif}
{$undef MINE}
{$ifdef MINE}
  WriteLn('still mine');
{$endif}
  WriteLn(n);
end.

