program syscstring;
uses sysutils;
const Workers = 128;
var joined: waitgroup; i: Integer;
procedure Check(Index: Integer);
var buffer, source: TBytes; before, text: string; answer, k: Integer;
  settings: TFormatSettings;
begin
  settings := DefaultFormatSettings;
  if Odd(Index) then settings.DecimalSeparator := ',';
  { Cover every size once across 128 concurrent owners, including 128
    in owner zero. Repeating the full Cartesian product with GC on
    every refill costs tens of thousands of stop-the-world cycles
    under single-CPU emulation without adding a boundary case. }
  k := Index;
  while k <= 128 do
  begin
    text := StringOfChar('a', k);
    source := CStringOf(text);
    if (Length(source) <> k + 1) or (StrLen(source) <> k) then Halt(2);
    if StrPas(source) <> text then Halt(3);
    buffer := BytesOf('left' + StringOfChar('!', k + 1) + 'right');
    if StrCopy(buffer, 4, k + 1, source, 0, Length(source)) <> k then Halt(4);
    if StrPas(buffer, 4, k + 1) <> text then Halt(5);
    if (StringOf(Copy(buffer, 0, 4)) <> 'left') or
      (StringOf(Copy(buffer, k + 5, 5)) <> 'right') then Halt(6);
    before := StringOf(buffer);
    try answer := StrPCopy(buffer, 4, k, text); Halt(7)
    except on EArgumentOutOfRangeException do ; end;
    try answer := StrPCopy(buffer, High(Integer), 4, 'bad'); Halt(8)
    except on EArgumentOutOfRangeException do ; end;
    try StrMove(buffer, 0, source, 0, High(Integer)); Halt(9)
    except on EArgumentOutOfRangeException do ; end;
    if StringOf(buffer) <> before then Halt(10);
    k := k + Workers;
  end;
  buffer := CStringOf('abcdef');
  StrMove(buffer, 1, buffer, 0, 5);
  if StrPas(buffer) <> 'aabcde' then Halt(11);
  StrMove(buffer, 0, buffer, 1, 5);
  if StrPas(buffer) <> 'abcdee' then Halt(12);
  buffer := BytesOf('abcd');
  try answer := StrLen(buffer); Halt(13) except on EConvertError do ; end;
  if StringOf(buffer) <> 'abcd' then Halt(14);
  buffer := BytesOf('a'#0'........'); source := CStringOf('ñ雪');
  if StrCat(buffer, source) <> 6 then Halt(15);
  if StrPas(buffer) <> 'añ雪' then Halt(16);
  buffer := CStringOf('AbñA');
  if StrComp(buffer, CStringOf('AbñA')) <> 0 then Halt(17);
  if StrIComp(buffer, CStringOf('abña')) <> 0 then Halt(18);
  if StrPos(buffer, CStringOf('ñ')) <> 2 then Halt(19);
  if StrPos(buffer, CStringOf('missing')) <> -1 then Halt(20);
  if StrPos(buffer, CStringOf('')) <> 0 then Halt(21);
  if (StrScan(buffer, 'A') <> 0) or (StrRScan(buffer, 'A') <> 4) then Halt(22);
  if (StrScan(buffer, #0) <> 5) or (StrRScan(buffer, #0) <> 5) then Halt(23);
  if (StrScan(buffer, 'z') <> -1) or (StrRScan(buffer, 'z') <> -1) then Halt(24);
  StrUpper(buffer); if StrPas(buffer) <> 'ABñA' then Halt(25);
  StrLower(buffer); if StrPas(buffer) <> 'abña' then Halt(26);
  buffer := BytesOf('!..........?');
  answer := FormatBuf(buffer, 1, 10, '%.2f', [1.25], settings);
  if Odd(Index) then text := '1,25' else text := '1.25';
  if (answer <> 4) or (StringOf(buffer) <> '!' + text + '......?') then Halt(27);
  answer := StrFmt(buffer, 1, 10, '%.2f', [1.25], settings);
  if (answer <> 4) or (StrPas(buffer, 1, 10) <> text) then Halt(28);
  before := StringOf(buffer);
  try answer := FormatBuf(buffer, 1, 3, '%.2f', [1.25], settings); Halt(29)
  except on EArgumentOutOfRangeException do ; end;
  if StringOf(buffer) <> before then Halt(30);
  { A raw pointer never proves an extent, even with precision zero. }
  try text := Format('%s', [PChar(1)]); Halt(31) except on EConvertError do ; end;
  try text := Format('%.0s', [PChar(1)]); Halt(32) except on EConvertError do ; end;
  GcCollect;
  if StringOf(buffer) <> before then Halt(33);
  joined.Done;
end;
begin
  joined.Add(Workers);
  for i := 0 to Workers - 1 do pas Check(i);
  joined.Wait;
  WriteLn('bounded C-string buffers ', Workers, ', overlap, terminators, atomic writes and formatting');
end.
