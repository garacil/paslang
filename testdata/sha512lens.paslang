program sha512lens;

{ P551: SHA-384 and SHA-512, and the HMAC of both under a key of 20 bytes, of data made from a seed, for every length from 0 to 300 (every padding case of the last block) and for some longer ones }

uses
  sysutils;

var
  seed: Int64;

function Rnd: Integer;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := Integer((seed shr 33) and 255);
end;

function Data(n, kind: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, n);
  for i := 1 to n do
    case kind of
      0: Result[i] := Chr(Rnd);
      1: Result[i] := Chr(255);
      2: Result[i] := Chr(0);
    else
      Result[i] := Chr(97 + (i mod 7));
    end;
end;

procedure One(n, kind: Integer);
var
  s, key: string;
  i: Integer;
begin
  seed := 551 + n * 31 + kind;
  s := Data(n, kind);
  SetLength(key, 20);
  for i := 1 to 20 do
    key[i] := Chr(i);
  WriteLn(n, ' ', kind, ' ', Hex(Sha384(s)), ' ', Hex(Sha512(s)), ' ', Hex(HmacSha384(key, s)), ' ', Hex(HmacSha512(key, s)));
end;

const
  Big: array[0..5] of Integer = (1000, 4095, 4096, 65535, 65536, 1048576);

var
  n, k: Integer;
begin
  for n := 0 to 300 do
    for k := 0 to 3 do
      One(n, k);
  for k := 0 to 5 do
  begin
    One(Big[k], 0);
    One(Big[k], 3);
  end;
end.
