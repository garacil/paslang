{ P360: a binary operation keeps its left side in a register while a
  right side that calls nothing is worked out. A call's result plus,
  minus, times, compared with, divided by and taken the remainder of an
  element, a field, a division and an outer routine's variable: the
  call's value waits in r11 or x8, where it was pushed and popped. The
  answers are worked out by hand in the comments; scripts/check_argpush.py
  finds no push in the routines named By. }
program keepleft;

type
  TPt = record
    X, Y: Integer;
  end;

var
  a: array[0..7] of Integer;
  pt: TPt;
  k, i: Integer;

function F(X: Integer): Integer;
begin
  Result := X * 3 + 1;
end;

function BySum: Integer;
begin
  { F(5) = 16, a[2] = 9: 25 }
  Result := F(5) + a[k];
end;

function BySub: Integer;
begin
  { F(4) = 13, 47 div 2 = 23: -10 }
  Result := F(4) - pt.X div 2;
end;

function ByMul: Integer;
begin
  { F(2) = 7, a[3] - 11 = 3: 21 }
  Result := F(2) * (a[k + 1] - pt.Y);
end;

function ByLess: Integer;
begin
  { F(2) = 7 > a[2] + 1 = 10 is false: 0 }
  Result := Ord(F(k) > a[k] + 1);
end;

function ByAtLeast: Integer;
begin
  { 7 >= 9 - 2: 1 }
  Result := Ord(F(k) >= a[k] - 2);
end;

function ByDiv: Integer;
begin
  { F(10) = 31, a[2] - 4 = 5: 6 }
  Result := F(10) div (a[k] - 4);
end;

function ByMod: Integer;
begin
  { F(11) = 34, 11 + 2 = 13: 8 }
  Result := F(11) mod (pt.Y + k);
end;

function ByOuter(Z: Integer): Integer;
var
  base: Integer;

  function In1: Integer;
  begin
    { F(4) * 2 = 26, 100 + a[1] = 106: -80 }
    Result := F(Z) * 2 - (base + a[1]);
  end;

begin
  base := 100;
  Result := In1;
end;

begin
  for i := 0 to 7 do
    a[i] := i * i + 5;
  k := 2;
  pt.X := 47;
  pt.Y := 11;
  WriteLn(BySum, ' ', BySub, ' ', ByMul);
  WriteLn(ByLess, ' ', ByAtLeast);
  WriteLn(ByDiv, ' ', ByMod);
  WriteLn(ByOuter(4));
end.
