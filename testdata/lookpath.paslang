{ A program name with no slash is looked for in PATH, as a shell does,
  so a tool that runs paslangc works from any directory. A name that
  already has a slash is taken as it stands. }
program lookpath;

uses
  paslib;

var
  args: array of string;
  res: string;
  rc: LongInt;

begin
  WriteLn(LookPath('/bin/sh') = '/bin/sh');
  WriteLn(LookPath('./nothing-here') = './nothing-here');
  WriteLn(LookPath('nothing-here-at-all') = 'nothing-here-at-all');
  WriteLn(HasSuffix(LookPath('env'), '/env'));
  args := nil;
  SetLength(args, 1);
  args[0] := 'PASLANG_LOOKPATH=1';
  res := '';
  rc := RunCapture('env', args, res);
  WriteLn(rc, ' ', Length(res) > 0);
  rc := Run('env', args);
  WriteLn(rc);
end.

