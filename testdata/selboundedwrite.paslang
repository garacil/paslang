program selboundedwrite;
procedure BoundedWrite;
var
  a: array[0..8] of Integer;
  i, total: Integer;
begin
  a[7] := 7;
  total := 0;
  for i := 1 to 3 do
    select
    else
      begin
        i := 7;
        total := total + a[i];
      end;
    end;
  WriteLn('bounded write: ', total);
end;
begin
  BoundedWrite;
end.

