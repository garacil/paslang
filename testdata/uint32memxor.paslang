program uint32memxor;

uses sysutils, paslib;

{ Exact typed reads beside a protected page; constant held shifts, address
  aliases and observable calls share the same independent expected values. }
type PU32 = ^UInt32;
const
  Samples: array[0..7] of UInt32 = (0, 1, 2147483647, 2147483648, 2166572391, 4063516280, 4294967294, 4294967295);
var
  Data: array[0..3] of UInt32;
  Trace, i, slot, page, status: Integer;
  wide: Integer;
  p: PU32;
  caught: Boolean;

function First0(p: PU32; pad: Integer; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 0);
end;

function Second0(pad: Integer; p: PU32; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 0);
end;

function Third0(pad: Integer; x: UInt32; p: PU32): UInt32;
begin
  Result := p^
    xor (x shr 0);
end;

function Byte0(p: PByte; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 0);
end;

function Word0(p: PWord; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 0);
end;

function First7(p: PU32; pad: Integer; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 7);
end;

function Second7(pad: Integer; p: PU32; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 7);
end;

function Third7(pad: Integer; x: UInt32; p: PU32): UInt32;
begin
  Result := p^
    xor (x shr 7);
end;

function Byte7(p: PByte; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 7);
end;

function Word7(p: PWord; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 7);
end;

function First8(p: PU32; pad: Integer; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 8);
end;

function Second8(pad: Integer; p: PU32; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 8);
end;

function Third8(pad: Integer; x: UInt32; p: PU32): UInt32;
begin
  Result := p^
    xor (x shr 8);
end;

function Byte8(p: PByte; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 8);
end;

function Word8(p: PWord; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 8);
end;

function First31(p: PU32; pad: Integer; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 31);
end;

function Second31(pad: Integer; p: PU32; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 31);
end;

function Third31(pad: Integer; x: UInt32; p: PU32): UInt32;
begin
  Result := p^
    xor (x shr 31);
end;

function Byte31(p: PByte; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 31);
end;

function Word31(p: PWord; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 31);
end;

function First32(p: PU32; pad: Integer; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 32);
end;

function Second32(pad: Integer; p: PU32; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 32);
end;

function Third32(pad: Integer; x: UInt32; p: PU32): UInt32;
begin
  Result := p^
    xor (x shr 32);
end;

function Byte32(p: PByte; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 32);
end;

function Word32(p: PWord; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 32);
end;

function First64(p: PU32; pad: Integer; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 64);
end;

function Second64(pad: Integer; p: PU32; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 64);
end;

function Third64(pad: Integer; x: UInt32; p: PU32): UInt32;
begin
  Result := p^
    xor (x shr 64);
end;

function Byte64(p: PByte; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 64);
end;

function Word64(p: PWord; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr 64);
end;

function FirstNeg64(p: PU32; pad: Integer; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr (-64));
end;

function SecondNeg64(pad: Integer; p: PU32; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr (-64));
end;

function ThirdNeg64(pad: Integer; x: UInt32; p: PU32): UInt32;
begin
  Result := p^
    xor (x shr (-64));
end;

function ByteNeg64(p: PByte; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr (-64));
end;

function WordNeg64(p: PWord; x: UInt32): UInt32;
begin
  Result := p^
    xor (x shr (-64));
end;

function AddressAlias7(p: PU32; scramble: Integer; x: UInt32): UInt32;
begin
  Result := PU32(Pointer(Integer(p) xor scramble))^
    xor (x shr 7);
end;

function Global7(index: Integer; x: UInt32): UInt32;
begin
  Result := Data[index]
    xor (x shr 7);
end;

function GlobalMask7(x: UInt32): UInt32;
begin
  Result := Data[Integer(UInt32(x and 3))]
    xor (x shr 7);
end;

function Local7(x: UInt32): UInt32;
var a: array[0..3] of UInt32;
begin
  a[0] := 19088743;
  a[1] := 2147483648;
  a[2] := 4275878552;
  a[3] := 4294967295;
  Result := a[Integer(UInt32(x and 3))]
    xor (x shr 7);
end;

function Wide7(p: PInteger; x: UInt32): Integer;
begin
  Result := p^
    xor (x shr 7);
end;

function NarrowWide7(p: PInteger; x: UInt32): UInt32;
begin
  Result := UInt32(p^)
    xor (x shr 7);
end;

function ReadMark(p: PU32): UInt32;
var allocation: string;
begin
  Trace := Trace * 10 + 1;
  allocation := StringOfChar('r', 33);
  GcCollect;
  if Length(allocation) <> 33 then Halt(90);
  Result := p^;
end;

function PointerMark(p: PU32): PU32;
begin Trace := Trace * 10 + 1; Result := p; end;

function RightMark(x: UInt32): UInt32;
var allocation: string;
begin
  Trace := Trace * 10 + 2;
  allocation := StringOfChar('s', 17);
  if Length(allocation) <> 17 then Halt(91);
  Result := x;
end;

function Raw(p: PU32; x: UInt32; count: Integer): UInt32;
begin
  Result := ReadMark(p)
    xor (RightMark(x) shr count);
end;

function RawAddress7(p: PU32; x: UInt32): UInt32;
begin
  Result := PointerMark(p)^
    xor (RightMark(x) shr 7);
end;

function FaultTail(const message: string): string;
var at: Integer;
begin
  at := Pos(' at line ', message);
  if (at = 0) or (Pos('invalid memory address 0x', message) <> 1) then Halt(92);
  Result := Copy(message, at, Length(message) - at + 1);
end;

procedure HeapReach;
var owner: array of UInt32; held: PU32;
begin
  SetLength(owner, 4);
  owner[1] := 2147483648;
  held := @owner[1];
  SetLength(owner, 0);
  Trace := 0;
  WriteLn('gc ', Raw(held, 2166572391, 7), ' ', Trace);
  held := nil;
  GcCollect;
end;

begin
  Data[0] := 19088743;
  Data[1] := 2147483648;
  Data[2] := 4275878552;
  Data[3] := 4294967295;
  for i := 0 to 7 do
  begin
    slot := i and 3;
    WriteLn(First0(@Data[slot], i, Samples[i]));
    WriteLn(Second0(i, @Data[slot], Samples[i]));
    WriteLn(Third0(i, Samples[i], @Data[slot]));
    WriteLn(First7(@Data[slot], i, Samples[i]));
    WriteLn(Second7(i, @Data[slot], Samples[i]));
    WriteLn(Third7(i, Samples[i], @Data[slot]));
    WriteLn(First8(@Data[slot], i, Samples[i]));
    WriteLn(Second8(i, @Data[slot], Samples[i]));
    WriteLn(Third8(i, Samples[i], @Data[slot]));
    WriteLn(First31(@Data[slot], i, Samples[i]));
    WriteLn(Second31(i, @Data[slot], Samples[i]));
    WriteLn(Third31(i, Samples[i], @Data[slot]));
    WriteLn(First32(@Data[slot], i, Samples[i]));
    WriteLn(Second32(i, @Data[slot], Samples[i]));
    WriteLn(Third32(i, Samples[i], @Data[slot]));
    WriteLn(First64(@Data[slot], i, Samples[i]));
    WriteLn(Second64(i, @Data[slot], Samples[i]));
    WriteLn(Third64(i, Samples[i], @Data[slot]));
    WriteLn(FirstNeg64(@Data[slot], i, Samples[i]));
    WriteLn(SecondNeg64(i, @Data[slot], Samples[i]));
    WriteLn(ThirdNeg64(i, Samples[i], @Data[slot]));
    WriteLn(AddressAlias7(@Data[slot], 0, Samples[i]));
    WriteLn(Global7(slot, Samples[i]));
    WriteLn(GlobalMask7(Samples[i]));
    WriteLn(Local7(Samples[i]));
    wide := 1311768467034293607 + i;
    WriteLn(Wide7(@wide, Samples[i]));
    Trace := 0;
    WriteLn(Raw(@Data[slot], Samples[i], 0), ' ', Trace);
    Trace := 0;
    WriteLn(Raw(@Data[slot], Samples[i], 7), ' ', Trace);
    Trace := 0;
    WriteLn(Raw(@Data[slot], Samples[i], 8), ' ', Trace);
    Trace := 0;
    WriteLn(Raw(@Data[slot], Samples[i], 31), ' ', Trace);
    Trace := 0;
    WriteLn(Raw(@Data[slot], Samples[i], 32), ' ', Trace);
    Trace := 0;
    WriteLn(Raw(@Data[slot], Samples[i], 64), ' ', Trace);
    Trace := 0;
    WriteLn(Raw(@Data[slot], Samples[i], (-64)), ' ', Trace);
    Trace := 0;
    WriteLn(RawAddress7(@Data[slot], Samples[i]), ' ', Trace);
  end;
  if Amd64 = 1 then page := Syscall(9, 0, 8192, 3, 34, -1, 0)
  else page := Syscall(222, 0, 8192, 3, 34, -1, 0);
  if page < 0 then Halt(93);
  if Amd64 = 1 then status := Syscall(10, page + 4096, 4096, 0)
  else status := Syscall(226, page + 4096, 4096, 0);
  if status <> 0 then Halt(94);
  PByte(Pointer(page + 4095))^ := 239;
  for i := 0 to 7 do
  begin
    WriteLn(Byte0(PByte(Pointer(page + 4095)), Samples[i]));
    WriteLn(Byte7(PByte(Pointer(page + 4095)), Samples[i]));
    WriteLn(Byte8(PByte(Pointer(page + 4095)), Samples[i]));
    WriteLn(Byte31(PByte(Pointer(page + 4095)), Samples[i]));
    WriteLn(Byte32(PByte(Pointer(page + 4095)), Samples[i]));
    WriteLn(Byte64(PByte(Pointer(page + 4095)), Samples[i]));
    WriteLn(ByteNeg64(PByte(Pointer(page + 4095)), Samples[i]));
  end;
  PWord(Pointer(page + 4094))^ := 65244;
  for i := 0 to 7 do
  begin
    WriteLn(Word0(PWord(Pointer(page + 4094)), Samples[i]));
    WriteLn(Word7(PWord(Pointer(page + 4094)), Samples[i]));
    WriteLn(Word8(PWord(Pointer(page + 4094)), Samples[i]));
    WriteLn(Word31(PWord(Pointer(page + 4094)), Samples[i]));
    WriteLn(Word32(PWord(Pointer(page + 4094)), Samples[i]));
    WriteLn(Word64(PWord(Pointer(page + 4094)), Samples[i]));
    WriteLn(WordNeg64(PWord(Pointer(page + 4094)), Samples[i]));
  end;
  p := PU32(Pointer(page + 4092));
  for i := 0 to 7 do
  begin
    p^ := Samples[7 - i];
    WriteLn(First0(p, i, Samples[i]));
    WriteLn(Second0(i, p, Samples[i]));
    WriteLn(Third0(i, Samples[i], p));
    WriteLn(First7(p, i, Samples[i]));
    WriteLn(Second7(i, p, Samples[i]));
    WriteLn(Third7(i, Samples[i], p));
    WriteLn(First8(p, i, Samples[i]));
    WriteLn(Second8(i, p, Samples[i]));
    WriteLn(Third8(i, Samples[i], p));
    WriteLn(First31(p, i, Samples[i]));
    WriteLn(Second31(i, p, Samples[i]));
    WriteLn(Third31(i, Samples[i], p));
    WriteLn(First32(p, i, Samples[i]));
    WriteLn(Second32(i, p, Samples[i]));
    WriteLn(Third32(i, Samples[i], p));
    WriteLn(First64(p, i, Samples[i]));
    WriteLn(Second64(i, p, Samples[i]));
    WriteLn(Third64(i, Samples[i], p));
    WriteLn(FirstNeg64(p, i, Samples[i]));
    WriteLn(SecondNeg64(i, p, Samples[i]));
    WriteLn(ThirdNeg64(i, Samples[i], p));
  end;
  caught := False;
  Trace := 0;
  try
    WriteLn(First7(PU32(Pointer(page + 4096)), 0, 2166572391));
  except
    on err: EAccessViolation do
    begin
      caught := True;
      WriteLn('fault first ', err.ClassName, FaultTail(err.Message));
    end;
  end;
  if not caught then Halt(95);
  caught := False;
  Trace := 0;
  try
    WriteLn(Second7(0, PU32(Pointer(page + 4096)), 2166572391));
  except
    on err: EAccessViolation do
    begin
      caught := True;
      WriteLn('fault second ', err.ClassName, FaultTail(err.Message));
    end;
  end;
  if not caught then Halt(95);
  caught := False;
  Trace := 0;
  try
    WriteLn(Third7(0, 2166572391, PU32(Pointer(page + 4096))));
  except
    on err: EAccessViolation do
    begin
      caught := True;
      WriteLn('fault third ', err.ClassName, FaultTail(err.Message));
    end;
  end;
  if not caught then Halt(95);
  caught := False;
  Trace := 0;
  try
    WriteLn(AddressAlias7(PU32(Pointer(page + 4096)), 0, 2166572391));
  except
    on err: EAccessViolation do
    begin
      caught := True;
      WriteLn('fault address ', err.ClassName, FaultTail(err.Message));
    end;
  end;
  if not caught then Halt(95);
  caught := False;
  Trace := 0;
  try
    WriteLn(Wide7(PInteger(Pointer(page + 4092)), 2166572391));
  except
    on err: EAccessViolation do
    begin
      caught := True;
      WriteLn('fault wide ', err.ClassName, FaultTail(err.Message));
    end;
  end;
  if not caught then Halt(95);
  caught := False;
  Trace := 0;
  try
    WriteLn(NarrowWide7(PInteger(Pointer(page + 4092)), 2166572391));
  except
    on err: EAccessViolation do
    begin
      caught := True;
      WriteLn('fault narrow-wide ', err.ClassName, FaultTail(err.Message));
    end;
  end;
  if not caught then Halt(95);
  caught := False;
  Trace := 0;
  try
    WriteLn(Raw(PU32(Pointer(page + 4096)), 2166572391, 7));
  except
    on err: EAccessViolation do
    begin
      caught := True;
      WriteLn('fault raw ', err.ClassName, FaultTail(err.Message), ' ', Trace);
    end;
  end;
  if not caught then Halt(95);
  caught := False;
  Trace := 0;
  try
    WriteLn(RawAddress7(PU32(Pointer(page + 4096)), 2166572391));
  except
    on err: EAccessViolation do
    begin
      caught := True;
      WriteLn('fault raw-address ', err.ClassName, FaultTail(err.Message), ' ', Trace);
    end;
  end;
  if not caught then Halt(95);
  if Amd64 = 1 then status := Syscall(11, page, 8192)
  else status := Syscall(215, page, 8192);
  if status <> 0 then Halt(96);
  HeapReach;
end.
