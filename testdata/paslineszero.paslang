program paslineszero;
type TThunk = procedure;
procedure Equal(Stage, Actual, Expected: Integer);
begin
  if Actual <> Expected then
  begin WriteLn('coincident line ', Stage, ': ', Actual, ' <> ', Expected); Halt(105); end;
end;
procedure Coincident;
begin
  Equal(1, 101, 101);
  Equal(2, 102, 102);
  Equal(3, 103, 103);
  Equal(4, 104, 104);
  Equal(5, 105, 105);
  Equal(6, 106, 106);
  Equal(7, 107, 107);
  Equal(8, 108, 108);
end;
var Thunk: TThunk;
begin
  { Its address and an indirect call retain the actual out-of-line routine.
    With the ordinary inline budget, the constant Equal calls emit no code
    and their distinct source labels coincide before the return. }
  Thunk := @Coincident;
  Thunk();
  WriteLn('ok coincident line labels');
end.
