{ P485: the scavenger gives back what the heap holds past its goal and a
  tenth more (Go's retention), not past an eighth of the goal. A block of
  2 MiB made and dropped forty times, a cycle after each, is taken again from
  the free run the one before left, and nothing is given back to the kernel;
  64 MiB made and dropped is past the goal, and the free run is given back. }
program scavenge;

procedure Churn(N: Integer);
var
  s: string;
  i: Integer;
begin
  SetLength(s, N);
  i := 1;
  while i <= N do
  begin
    s[i] := 'x';
    i := i + 4096;
  end;
  if s[1] <> 'x' then
    WriteLn('lost');
end;

var
  i, most, r: Integer;
begin
  most := 0;
  for i := 1 to 40 do
  begin
    Churn(2097152);
    r := GcCollect;
    if HeapStat(4) > most then
      most := HeapStat(4);
  end;
  WriteLn('steady: nothing given back ', most < 1048576);
  Churn(67108864);
  r := GcCollect;
  r := GcCollect;
  WriteLn('64 MiB dropped: given back ', HeapStat(4) >= 33554432);
  WriteLn('check ', HeapCheck);
end.
