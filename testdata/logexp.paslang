program logexp;

begin
  WriteLn(Ln(1));
  WriteLn(Ln(2));
  WriteLn(Ln(10));
  WriteLn(Ln(0.5));
  WriteLn(Exp(0));
  WriteLn(Exp(1));
  WriteLn(Exp(-1));
  WriteLn(Exp(2));
  WriteLn(Int(1.7));
  WriteLn(Int(-1.7));
  WriteLn(Frac(1.7));
  WriteLn(Frac(-1.7));
  WriteLn(Frac(-0.3));
  WriteLn(Int(4));
  WriteLn(Frac(4));
end.

