program cls;

type
  TFoo = class
    FX: Integer;
    constructor Create;
    procedure IncX;
    function GetX: Integer;
    procedure Hello; virtual;
    property X: Integer read FX write FX;
  end;

constructor TFoo.Create;
begin
  FX := 1;
end;

procedure TFoo.IncX;
begin
  FX := FX + 1;
end;

function TFoo.GetX: Integer;
begin
  Result := FX;
end;

procedure TFoo.Hello;
begin
  WriteLn(FX);
end;

var
  o: TFoo;
  m: procedure of object;

begin
  o := TFoo.Create;
  o.Hello;
  o.IncX;
  WriteLn(o.X);
  m := o.IncX;
  m;
  WriteLn(o.GetX);
end.

