program strone;

{ A string of one character takes no memory, as Go's (P286): a
  character turned into a string, Copy of one character, a
  concatenation of one, IntToStr of a digit and JSON's strings and keys
  of one character point into the runtime's table of the 256 strings of
  one character, marked shared, so two of the same character are the
  same bytes and a write through one copies it first. They compare,
  concatenate, index and survive the collector like any string, and
  100000 of them take no memory. }

uses sysutils;

type
  TRec = record
    A: string json 'a';
    L: array of string json 'l';
    M: map[string] of Integer json 'm';
  end;

var
  keep: array of string;

function Data(const S: string): Pointer;
begin
  Result := PPointer(@S)^;
end;

procedure Collect;
var
  c: Integer;
begin
  c := 0;
  while c < 2 do
    if GcCollect = 1 then
      c := c + 1
    else
      Sleep(1);
end;

procedure Sources;
var
  c: Char;
  s1, s2, s3, s4, s5, e, t: string;
  r: TRec;
  k: string;
  v, same: Integer;
begin
  c := 'q';
  s1 := c;
  t := 'xqz';
  s2 := Copy(t, 2, 1);
  e := '';
  s3 := e + s1;
  s4 := s2 + e;
  s5 := IntToStr(7);
  WriteLn(s1, s2, s3, s4, ' ', s5, ' ', Length(s1), Length(s5));
  WriteLn('one block: ', (Data(s1) = Data(s2)) and (Data(s2) = Data(s3)) and
    (Data(s3) = Data(s4)), ' ', Data(s5) = Data(Chr(55)));
  JsonDecode('{"a":"q","l":["q","7","qq"],"m":{"q":1,"x":2}}', r);
  same := 0;
  if Data(r.A) = Data(s1) then
    same := same + 1;
  if Data(r.L[0]) = Data(s1) then
    same := same + 1;
  if Data(r.L[1]) = Data(s5) then
    same := same + 1;
  for k, v in r.M do
    if Data(k) = Data(s1) then
      same := same + v * 10;
  WriteLn('json: ', r.A, ' ', r.L[0], r.L[1], r.L[2], ' ', same, ' ', Length(r.L[2]));
end;

{ A write through one copies it: the other strings of that character,
  and the table, keep it. }
procedure Writes;
var
  a, b, c: string;
begin
  a := 'm';
  a := Copy(a, 1, 1);
  b := a;
  a[1] := 'z';
  c := Chr(109);
  WriteLn(a, b, c, ' ', Data(b) = Data(c), ' ', Data(a) <> Data(c));
  a := a + 'y';
  b := b + b;
  WriteLn(a, ' ', b, ' ', Chr(109) + Chr(122));
end;

{ Every character, from every source, compared with the others. }
procedure All;
var
  i, bad: Integer;
  s, t, u: string;
  w: string;
begin
  bad := 0;
  w := '';
  for i := 0 to 255 do
  begin
    s := Chr(i);
    w := w + s;
  end;
  for i := 0 to 255 do
  begin
    s := Chr(i);
    t := Copy(w, i + 1, 1);
    u := '' + t;
    if (s <> t) or (t <> u) or (Length(s) <> 1) or (Ord(s[1]) <> i) or
      (Data(s) <> Data(t)) or (Data(t) <> Data(u)) then
      bad := bad + 1;
  end;
  WriteLn('256 characters, bad ', bad, ', ', Length(w));
end;

{ Many of them kept across the collector's cycles. }
procedure KeepMany;
var
  i, bad: Integer;
  s: string;
begin
  SetLength(keep, 20000);
  for i := 0 to High(keep) do
  begin
    keep[i] := Chr(65 + i mod 26);
    s := IntToStr(i) + '-' + IntToStr(i * 3);
    if Length(s) = 0 then
      WriteLn('never');
  end;
  Collect;
  bad := 0;
  for i := 0 to High(keep) do
    if keep[i] <> Chr(65 + i mod 26) then
      bad := bad + 1;
  WriteLn('kept ', Length(keep), ', bad ', bad);
end;

{ 100000 strings of one character take no memory: Go's take none. }
procedure Memory;
var
  i, a, b: Integer;
  t: string;
begin
  SetLength(keep, 100000);
  for i := 0 to High(keep) do
    keep[i] := '';
  t := 'abcdefghij';
  Collect;
  a := HeapStat(1);
  for i := 0 to High(keep) do
    case i mod 3 of
      0: keep[i] := Chr(97 + i mod 26);
      1: keep[i] := Copy(t, 1 + i mod 10, 1);
    else
      keep[i] := IntToStr(i mod 10);
    end;
  Collect;
  b := HeapStat(1);
  WriteLn('100000 strings of one character: ', (b - a) div 100000, ' bytes each');
end;

begin
  Sources;
  Writes;
  All;
  KeepMany;
  if ParamStr(1) <> 'nomem' then
    Memory;
end.

