{ P491: RandBelow finds that a draw is below its zone without a division unless
  the draw is within N of the top, and RandReal multiplies by 2^-53 where it
  divided by 2^53. The expected output was made by the compiler before: two
  hundred thousand draws below each of 1, 2, 3, 7, 10, 1000, 65536, 2^31 + 1,
  2^40 + 3, 2^62, 2^62 + 1, 2^63 - 2^40 and the largest Int64 (so that the
  zone is met often), and two hundred thousand reals, from seeds 1 and 2^40,
  each folded into a hash, with the first values written. }
program randfast;

uses
  pasrand;

const
  Ns: array[0..12] of Int64 = (1, 2, 3, 7, 10, 1000, 65536, 2147483649, 1099511627779, 4611686018427387904,
    4611686018427387905, 9223371487098961920, 9223372036854775807);

var
  r: TRand;
  h: Int64;
  i, k: Integer;
  v: Int64;
  x: Real;
  bits: Int64;
begin
  for k := 0 to 1 do
  begin
    if k = 0 then
      RandInit(r, 1)
    else
      RandInit(r, 1099511627776);
    for i := 0 to High(Ns) do
    begin
      h := 17;
      for v := 1 to 200000 do
        h := h * 1000003 + RandBelow(r, Ns[i]) + (h shr 41);
      WriteLn(k, ' ', Ns[i], ' ', RandBelow(r, Ns[i]), ' ', RandBelow(r, Ns[i]), ' ', h);
    end;
    h := 19;
    for v := 1 to 200000 do
    begin
      x := RandReal(r);
      bits := 0;
      Move(x, bits, 8);
      h := h * 1000003 + bits + (h shr 37);
    end;
    WriteLn(k, ' real ', RandReal(r) < 1.0, ' ', h);
  end;
end.
