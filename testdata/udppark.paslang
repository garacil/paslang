program udppark;

uses pasnet;

procedure Give(Fd, Port: Integer);
begin
  if UdpSend(Fd, '127.0.0.1', Port, 'ping') < 0 then
    Halt(1);
  UdpClose(Fd);
end;

var
  a, b, port: Integer;
begin
  a := UdpBind(0);
  b := UdpBind(0);
  if (a < 0) or (b < 0) then
    Halt(1);
  port := UdpPort(a);
  pas Give(b, port);
  WriteLn(UdpRecv(a, 64));
  UdpClose(a);
end.
