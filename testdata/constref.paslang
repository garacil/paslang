{ 1.1.1: a const parameter is the caller's value itself. Nothing is
  copied in and nothing is marked shared, so the caller's write after
  the call touches its own bytes (the pointer stays); a value parameter
  is the routine's own, so the caller's write after that call copies
  (the pointer moves). A routine that reads a const string a million
  times pays nothing; one that changes it does not compile. }
program constref;

var
  s: string;
  before, after, n: Integer;

function Sum(const T: string): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 1 to Length(T) do
    Result := Result + Ord(T[i]);
end;

function SumV(T: string): Integer;
var
  i: Integer;
begin
  T[1] := 'z';
  Result := 0;
  for i := 1 to Length(T) do
    Result := Result + Ord(T[i]);
end;

procedure Twice(const T: string; var Both: string);
begin
  Both := T + T;
end;

var
  b: string;

begin
  s := Copy('paslang!', 1, 7);        { a string of its own, not a literal }
  before := Integer(Pointer(s));
  n := Sum(s);
  s[1] := 'P';
  after := Integer(Pointer(s));
  WriteLn(n, ' ', s, ' ', before = after);      { 742 Paslang 1 }
  before := Integer(Pointer(s));
  n := SumV(s);
  s[1] := 'Q';
  after := Integer(Pointer(s));
  WriteLn(n, ' ', s, ' ', before = after);      { 752 Qaslang 0 }
  Twice(s, b);
  s[1] := 'R';
  WriteLn(b, ' ', s);                            { QaslangQaslang Raslang }
end.

