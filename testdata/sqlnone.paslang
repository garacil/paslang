{ P418: a program that names the library unit sqlite and reaches none of
  it: it compiles, and none of SQLite's code, class tables or read-only
  data is in it (P417), only the unit's variables and its start. }
program sqlnone;

uses sqlite;

begin
  WriteLn('names sqlite, reaches none of it');
end.

