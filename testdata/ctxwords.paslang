program ctxwords;

{ 1.0.131: andnot, xnor and an or of a negation are one instruction on
  arm64 (bic, eon, orn); a narrow unsigned value keeps its two where orn
  or eon would fill its upper bits. }

var
  a, b: Integer;
  w, v: Word;
  s8, t8: Int8;

begin
  a := 12;
  b := 10;
  WriteLn(a andnot b, ' ', a xnor b, ' ', a or not b, ' ', a nand b, ' ', a nor b);
  w := $F0F0;
  v := $FF00;
  WriteLn(w andnot v, ' ', w xnor v, ' ', w or not v, ' ', w xor not v);
  s8 := -16;
  t8 := 5;
  WriteLn(s8 andnot t8, ' ', s8 xnor t8, ' ', s8 or not t8);
  a andnot= 8;
  WriteLn(a);
end.
