{ P368: a small routine whose result is a block (a record, a static
  array, a set of 32 bytes) goes in where it is called. Its Result is the
  variable the value goes to, starting at zero when a path may read it
  first; a body that ends with Result := a place gives that place, and a
  part of the result read where the call was reads that part of the
  place. Every line is the same at -inline 0, where each stays a call. }
program blockinl;

uses
  SysUtils;

type
  TPair = record
    A, B: Integer;
  end;
  TWide = record
    A, B, C, D, E: Integer;
  end;
  TNamed = record
    N: Integer;
    S: string;
  end;
  TRow = array[0..3] of Integer;
  TLetters = set of Char;
  THolder = class
    P: TPair;
  end;

var
  G: array[1..4] of TWide;
  Names: array[1..2] of TNamed;
  Rows: array[0..2] of TRow;
  gp: TPair;
  gw: TWide;
  i, s: Integer;
  h: THolder;

function MkPair(A, B: Integer): TPair;
begin
  Result.A := A;
  Result.B := B;
end;

{ a place: the element as it stands at the end }
function Get(K: Integer): TWide;
begin
  Result := G[K];
end;

{ a check, then a place }
function GetChecked(K: Integer): TWide;
begin
  if (K < 1) or (K > 4) then
    K := 1;
  Result := G[K];
end;

{ some fields only: the rest start at zero on every pass }
function Part(K: Integer): TWide;
begin
  Result.B := K;
  if K > 2 then
    Result.D := K * 10;
end;

{ reads Result before it writes it }
function Grow(K: Integer): TPair;
begin
  Result.A := Result.B + K;
  Result.B := Result.A * 2;
end;

function Name(K: Integer): TNamed;
begin
  Result := Names[K];
end;

function MkNamed(K: Integer): TNamed;
begin
  Result.N := K;
  Result.S := 'n' + IntToStr(K);
end;

function Row(K: Integer): TRow;
begin
  Result := Rows[K];
end;

function Letters(Up: Boolean): TLetters;
begin
  if Up then
    Result := ['A'..'Z']
  else
    Result := ['a'..'z'];
end;

function Change(K: Integer): Integer;
begin
  G[1].A := K;
  Result := K;
end;

{ takes the record by its address: a change of G[1] must not show }
procedure ShowAfter(const W: TWide);
begin
  G[1].A := -1;
  WriteLn('const ', W.A, ' ', W.B);
end;

procedure Fail(K: Integer);
begin
  if K = 0 then
    raise Exception.Create('zero');
end;

function Half(K: Integer): TPair;
begin
  Result.A := K;
  Fail(K);
  Result.B := K * 2;
end;

function Sum(K: Integer): Integer;
var
  p: TPair;
  w: TWide;
  j: Integer;
begin
  Result := 0;
  for j := 1 to K do
  begin
    p := MkPair(j, j * 3);
    Result := Result + p.A + p.B + MkPair(j, 1).B;
    w := Part(j);
    Result := Result + w.A + w.B + w.C + w.D + w.E;
    Result := Result + Get(1 + j mod 4).C + Part(j).D;
  end;
end;

function Guarded(K: Integer): Integer;
var
  p: TPair;
begin
  p := MkPair(5, 6);
  try
    p := Half(K);
  except
    on E: Exception do
      WriteLn('caught ', E.Message, ' p ', p.A, ' ', p.B);
  end;
  Result := p.A + p.B;
end;

function Fresh(K: Integer): Integer;
var
  p: TPair;
begin
  p := Grow(K);
  Result := p.A + p.B;
  p := Grow(K + 1);
  Result := Result * 100 + p.A + p.B;
end;

begin
  for i := 1 to 4 do
  begin
    G[i].A := i;
    G[i].B := i * 10;
    G[i].C := i * 100;
    G[i].D := i * 1000;
    G[i].E := i * 10000;
  end;
  Names[1].N := 7;
  Names[1].S := 'seven';
  Names[2].N := 8;
  Names[2].S := 'eight';
  for i := 0 to 2 do
  begin
    Rows[i][0] := i;
    Rows[i][1] := i + 10;
    Rows[i][2] := i + 20;
    Rows[i][3] := i + 30;
  end;
  { field reads where the call was }
  WriteLn('get ', Get(2).A, ' ', Get(3).E, ' ', GetChecked(9).B, ' ', GetChecked(4).D);
  if Get(4).C > 300 then
    WriteLn('get if');
  s := 0;
  for i := 1 to 4 do
    s := s + Get(i).B;
  WriteLn('get loop ', s);
  { whole copies }
  gw := Get(3);
  WriteLn('copy ', gw.A, ' ', gw.B, ' ', gw.C, ' ', gw.D, ' ', gw.E);
  gp := MkPair(4, 9);
  WriteLn('pair ', gp.A, ' ', gp.B, ' ', MkPair(2, 3).A + MkPair(5, 7).B);
  { left to right: the field is read before Change writes G[1] }
  G[1].A := 1;
  s := Get(1).A + Change(50);
  WriteLn('order ', s, ' ', G[1].A);
  s := Change(60) + Get(1).A;
  WriteLn('order2 ', s);
  G[1].A := 1;
  { a whole value given to a const parameter is a copy }
  ShowAfter(Get(1));
  WriteLn('after ', G[1].A);
  G[1].A := 1;
  { parts }
  gw := Part(1);
  WriteLn('part ', gw.A, ' ', gw.B, ' ', gw.C, ' ', gw.D, ' ', gw.E);
  WriteLn('part3 ', Part(3).D, ' ', Part(3).A, ' ', Part(1).D);
  WriteLn('grow ', Fresh(3));
  { strings: a field that is a string is read from a copy }
  WriteLn('name ', Name(1).S, ' ', Name(2).N, ' ', MkNamed(42).S, ' ', Length(Name(2).S));
  { a static array and a set of 32 bytes }
  WriteLn('row ', Row(2)[1], ' ', Row(1)[3]);
  if 'Q' in Letters(True) then
    WriteLn('letters up');
  if not ('Q' in Letters(False)) then
    WriteLn('letters down');
  { an object's field takes the value }
  h := THolder.Create;
  h.P := MkPair(11, 12);
  WriteLn('holder ', h.P.A, ' ', h.P.B);
  h.Free;
  WriteLn('sum ', Sum(6));
  WriteLn('guard ', Guarded(3));
  WriteLn('guard ', Guarded(0));
end.

