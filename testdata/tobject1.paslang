{ TObject, the root of every class (P121): a class with no parent
  descends from it; ClassName, ClassNameIs and InstanceSize read the
  method table of the object's own class; ToString, Equals and
  GetHashCode are virtual with TObject's bodies unless overridden;
  AfterConstruction runs after a constructor, BeforeDestruction before
  an outermost Destroy (Free, or x.Destroy written out), never before an
  inherited one. The same source compiles with Free Pascal, whose output
  is the one expected. }
program tobject1;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  TShape = class
    FW, FH: Int64;
    constructor Create(W, H: Int64);
    function Area: Int64; virtual;
    function Describe: string;
  end;

  TSquare = class(TShape)
    FTag: Int64;
    constructor Create(S: Int64);
    function Area: Int64; override;
    function ToString: string; override;
  end;

  TTracked = class
    FName: string;
    constructor Create(const N: string);
    procedure AfterConstruction; override;
    procedure BeforeDestruction; override;
    destructor Destroy; override;
  end;

  TTrackedMore = class(TTracked)
    destructor Destroy; override;
  end;

constructor TShape.Create(W, H: Int64);
begin
  FW := W;
  FH := H;
end;

function TShape.Area: Int64;
begin
  Result := FW * FH;
end;

{ ClassName alone in a method is Self's }
function TShape.Describe: string;
begin
  Result := ClassName + ' of ' + Self.ClassName;
end;

constructor TSquare.Create(S: Int64);
begin
  inherited Create(S, S);
  FTag := 7;
end;

function TSquare.Area: Int64;
begin
  Result := FW * FW;
end;

function TSquare.ToString: string;
begin
  Result := 'a square';
end;

constructor TTracked.Create(const N: string);
begin
  FName := N;
  WriteLn('  Create ', FName);
end;

procedure TTracked.AfterConstruction;
begin
  WriteLn('  AfterConstruction ', FName);
end;

procedure TTracked.BeforeDestruction;
begin
  WriteLn('  BeforeDestruction ', FName);
end;

destructor TTracked.Destroy;
begin
  WriteLn('  Destroy ', FName);
  inherited Destroy;
end;

destructor TTrackedMore.Destroy;
begin
  WriteLn('  TTrackedMore.Destroy ', FName);
  inherited Destroy;
end;

var
  s: TShape;
  q: TSquare;
  o: TObject;
  t: TTracked;

begin
  s := TShape.Create(2, 3);
  q := TSquare.Create(4);
  WriteLn(s.ClassName, ' ', q.ClassName, ' ', s.Area, ' ', q.Area);
  o := q;
  WriteLn('through TObject: ', o.ClassName);
  s := q;
  WriteLn('through TShape: ', s.ClassName, ' ', s.Area, ' ', s.Describe);
  WriteLn('ClassNameIs: ', Ord(q.ClassNameIs('TSQUARE')), ' ', Ord(q.ClassNameIs('TShape')),
    ' ', Ord(q.ClassNameIs('tsquarex')));
  WriteLn('InstanceSize: ', TShape.Create(1, 1).InstanceSize, ' ', q.InstanceSize);
  WriteLn('ToString: ', TShape.Create(1, 1).ToString, ' / ', q.ToString, ' / ', o.ToString);
  WriteLn('Equals: ', Ord(q.Equals(o)), ' ', Ord(q.Equals(TShape.Create(1, 1))), ' ',
    Ord(q.Equals(nil)));
  WriteLn('GetHashCode same object: ', Ord(q.GetHashCode = o.GetHashCode));
  WriteLn('Free:');
  t := TTracked.Create('a');
  t.Free;
  WriteLn('Destroy written out:');
  t := TTracked.Create('b');
  t.Destroy;
  WriteLn('a descendant through the base:');
  t := TTrackedMore.Create('c');
  t.Free;
  WriteLn('Free of nil:');
  t := nil;
  t.Free;
  WriteLn('done');
end.

