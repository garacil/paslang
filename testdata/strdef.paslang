program strdef;

procedure Tag(S: string = 'hi');
begin
  WriteLn(S);
end;

procedure Blank(S: string = '');
begin
  WriteLn(S);
  WriteLn('end');
end;

procedure Scale(R: Real = 1.5);
begin
  WriteLn(R);
end;

procedure Off(R: Real = -1.5);
begin
  WriteLn(R);
end;

begin
  Tag;
  Tag('yo');
  Blank;
  Scale;
  Scale(2.5);
  Off;
end.
