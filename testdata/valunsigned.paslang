{ Val into an unsigned type reads a number to 2^64 - 1 and keeps its
  low bits, as Free Pascal's does (P142); the output is Free Pascal's. }
program valunsigned;
var
  b: Byte;
  w: Word;
  u: UInt32;
  code: Int64;
  s: string;
begin
  for s in ['255', '256', '300', '-1', '65536', '4294967296', '18446744073709551615', '18446744073709551616', '$FFFF'] do
  begin
    Val(s, b, code);
    Write(s, ' b=', b, '/', code);
    Val(s, w, code);
    Write(' w=', w, '/', code);
    Val(s, u, code);
    WriteLn(' u=', u, '/', code);
  end;
end.

