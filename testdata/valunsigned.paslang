{ Val into an unsigned type reads a number to 2^64 - 1 (P142), and one
  past its type is an error at the digit that goes past, a minus at its
  place (P149): Free Pascal 3.3.1's Val (rtl/inc/sstrings.inc checks the
  destination's size), where the 3.2.2 release kept the low bits. }
program valunsigned;
var
  b: Byte;
  w: Word;
  u: UInt32;
  code: Int64;
  s: string;
begin
  for s in ['255', '256', '300', '-1', '65536', '4294967296', '18446744073709551615', '18446744073709551616', '$FFFF'] do
  begin
    Val(s, b, code);
    Write(s, ' b=', b, '/', code);
    Val(s, w, code);
    Write(' w=', w, '/', code);
    Val(s, u, code);
    WriteLn(' u=', u, '/', code);
  end;
end.

