{ P440: the digests in pieces (Md5Begin ... Sha512Final) against the
  whole-message words. For every algorithm: the published vectors fed
  whole, byte by byte and in pieces of every size to 200; every length
  from 0 to 300 cut at every place into two pieces, and into three at
  places a splitmix64 gives; a million 'a' in pieces of 997 bytes; a
  state reused after Begin; each count printed, and the digests of
  the vectors that FIPS 180-4, RFC 1321 and the NIST examples publish. }
program hashpieces;

var
  GS: Integer;

function GNext: Integer;
var
  z: Integer;
begin
  GS := GS + Integer($9E3779B97F4A7C15);
  z := GS;
  z := (z xor (z shr 30)) * Integer($BF58476D1CE4E5B9);
  z := (z xor (z shr 27)) * Integer($94D049BB133111EB);
  Result := z xor (z shr 31);
end;

{ the whole-message digest of algorithm A }
function Whole(A: Integer; const S: string): string;
begin
  case A of
    0: Result := Md5(S);
    1: Result := Sha1(S);
    2: Result := Sha224(S);
    3: Result := Sha256(S);
    4: Result := Sha384(S);
  else
    Result := Sha512(S);
  end;
end;

{ the digest of the pieces of S cut at C1 and C2 (0 for none) }
function Pieces(A: Integer; const S: string; C1, C2: Integer): string;
var
  st: THashState;
  p: array[0..2] of string;
begin
  p[0] := Copy(S, 1, C1);
  if C2 > C1 then
  begin
    p[1] := Copy(S, C1 + 1, C2 - C1);
    p[2] := Copy(S, C2 + 1, Length(S) - C2);
  end
  else
  begin
    p[1] := Copy(S, C1 + 1, Length(S) - C1);
    p[2] := '';
  end;
  case A of
    0:
      begin
        Md5Begin(st);
        Md5Update(st, p[0]);
        Md5Update(st, p[1]);
        Md5Update(st, p[2]);
        Result := Md5Final(st);
      end;
    1:
      begin
        Sha1Begin(st);
        Sha1Update(st, p[0]);
        Sha1Update(st, p[1]);
        Sha1Update(st, p[2]);
        Result := Sha1Final(st);
      end;
    2:
      begin
        Sha224Begin(st);
        Sha224Update(st, p[0]);
        Sha224Update(st, p[1]);
        Sha224Update(st, p[2]);
        Result := Sha224Final(st);
      end;
    3:
      begin
        Sha256Begin(st);
        Sha256Update(st, p[0]);
        Sha256Update(st, p[1]);
        Sha256Update(st, p[2]);
        Result := Sha256Final(st);
      end;
    4:
      begin
        Sha384Begin(st);
        Sha384Update(st, p[0]);
        Sha384Update(st, p[1]);
        Sha384Update(st, p[2]);
        Result := Sha384Final(st);
      end;
  else
    Sha512Begin(st);
    Sha512Update(st, p[0]);
    Sha512Update(st, p[1]);
    Sha512Update(st, p[2]);
    Result := Sha512Final(st);
  end;
end;

{ the digest with S fed in pieces of K bytes (1 byte at a time for K = 1) }
function ByK(A: Integer; const S: string; K: Integer): string;
var
  st: THashState;
  i: Integer;
begin
  case A of
    0: Md5Begin(st);
    1: Sha1Begin(st);
    2: Sha224Begin(st);
    3: Sha256Begin(st);
    4: Sha384Begin(st);
  else
    Sha512Begin(st);
  end;
  i := 1;
  while i <= Length(S) do
  begin
    case A of
      0: Md5Update(st, Copy(S, i, K));
      1: Sha1Update(st, Copy(S, i, K));
      2: Sha224Update(st, Copy(S, i, K));
      3: Sha256Update(st, Copy(S, i, K));
      4: Sha384Update(st, Copy(S, i, K));
    else
      Sha512Update(st, Copy(S, i, K));
    end;
    i := i + K;
  end;
  case A of
    0: Result := Md5Final(st);
    1: Result := Sha1Final(st);
    2: Result := Sha224Final(st);
    3: Result := Sha256Final(st);
    4: Result := Sha384Final(st);
  else
    Result := Sha512Final(st);
  end;
end;

const
  Names: array[0..5] of string = ('md5', 'sha1', 'sha224', 'sha256', 'sha384', 'sha512');

var
  a, n, c1, c2, k, bad, runs, i: Integer;
  msg, want: string;
  st: THashState;

begin
  GS := 7;
  for a := 0 to 5 do
  begin
    bad := 0;
    runs := 0;
    { every length to 300, every cut into two }
    msg := '';
    for n := 0 to 300 do
    begin
      want := Whole(a, msg);
      for c1 := 0 to n do
      begin
        runs := runs + 1;
        if Pieces(a, msg, c1, 0) <> want then
          bad := bad + 1;
      end;
      { three pieces at places the generator gives }
      for i := 1 to 8 do
      begin
        c1 := (GNext shr 1) mod (n + 1);
        c2 := c1 + (GNext shr 1) mod (n - c1 + 1);
        runs := runs + 1;
        if Pieces(a, msg, c1, c2) <> want then
          bad := bad + 1;
      end;
      msg := msg + Chr((n * 31 + 7) and 255);
    end;
    { pieces of every size to 200 over 1000 bytes }
    msg := '';
    for n := 0 to 999 do
      msg := msg + Chr((n * 131 + n div 7) and 255);
    want := Whole(a, msg);
    for k := 1 to 200 do
    begin
      runs := runs + 1;
      if ByK(a, msg, k) <> want then
        bad := bad + 1;
    end;
    WriteLn(Names[a], ': ', runs, ' runs, ', bad, ' differ');
  end;

  { the published vectors, fed whole and byte by byte }
  WriteLn('md5 abc: ', Hex(Pieces(0, 'abc', 0, 0)));
  WriteLn('sha1 abc: ', Hex(Pieces(1, 'abc', 1, 2)));
  WriteLn('sha224 abc: ', Hex(Pieces(2, 'abc', 1, 2)));
  WriteLn('sha256 abc: ', Hex(ByK(3, 'abc', 1)));
  WriteLn('sha256 two blocks: ', Hex(Pieces(3, 'abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq', 20, 40)));
  WriteLn('sha384 abc: ', Hex(Pieces(4, 'abc', 2, 0)));
  WriteLn('sha512 abc: ', Hex(ByK(5, 'abc', 1)));
  WriteLn('sha512 two blocks: ', Hex(Pieces(5, 'abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu', 60, 100)));

  { a million 'a' in pieces of 997 bytes }
  msg := StringOfChar('a', 997);
  Sha256Begin(st);
  for i := 1 to 1003 do
    Sha256Update(st, msg);
  Sha256Update(st, StringOfChar('a', 1000000 - 1003 * 997));
  WriteLn('sha256 a million a: ', Hex(Sha256Final(st)));
  Sha1Begin(st);
  for i := 1 to 1003 do
    Sha1Update(st, msg);
  Sha1Update(st, StringOfChar('a', 1000000 - 1003 * 997));
  WriteLn('sha1 a million a: ', Hex(Sha1Final(st)));
  Sha512Begin(st);
  for i := 1 to 1003 do
    Sha512Update(st, msg);
  Sha512Update(st, StringOfChar('a', 1000000 - 1003 * 997));
  WriteLn('sha512 a million a: ', Copy(Hex(Sha512Final(st)), 1, 32));

  { a state begun again forgets what it held }
  Sha256Begin(st);
  Sha256Update(st, 'something');
  Sha256Begin(st);
  Sha256Update(st, 'abc');
  WriteLn('begun again: ', Hex(Sha256Final(st)) = Hex(Sha256('abc')));
  { empty updates change nothing }
  Md5Begin(st);
  Md5Update(st, '');
  Md5Update(st, 'abc');
  Md5Update(st, '');
  WriteLn('empty pieces: ', Hex(Md5Final(st)) = Hex(Md5('abc')));
end.

