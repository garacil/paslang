program typedconst;

{ A typed constant starts with its value (1.0.77): it read the value and
  dropped it. One of a routine keeps its value from call to call. }

type
  TColor = (Red, Green, Blue);
  TPoint = record
    X, Y: Integer;
    Name: string;
  end;
  TDigits = set of 0..63;

const
  I: Integer = 5;
  N: Integer = -7;
  E: Integer = 3 * 4 + 1;
  R: Double = 1.5;
  RI: Double = 2;
  B: Boolean = True;
  C: Char = 'z';
  S: string = 'abc';
  Empty: string = '';
  K: TColor = Blue;
  A: array[0..2] of Integer = (10, 20, 30);
  Names: array[1..3] of string = ('one', 'two', 'three');
  Hx: array[0..3] of Char = 'wxyz';
  P: TPoint = (X: 3; Y: -4; Name: 'origin');
  Pts: array[0..1] of TPoint = ((X: 1; Name: 'a'), (Y: 2; Name: 'bb'));
  Odds: TDigits = [1, 3, 5..7];
  Evens = [0, 2, 4];
  Nothing: ^Integer = nil;

function Count: Integer;
const
  Calls: Integer = 100;
begin
  Calls := Calls + 1;
  Result := Calls;
end;

function Other: Integer;
const
  Calls: Integer = 7;

  function Inner: Integer;
  const
    Calls: Integer = 1000;
  begin
    Calls := Calls * 2;
    Result := Calls;
  end;

begin
  Calls := Calls + Inner;
  Result := Calls;
end;

procedure Greet;
const
  Hello: string = 'hi';
begin
  WriteLn(Hello, ' ', Length(Hello));
  Hello := Hello + '!';
end;

begin
  WriteLn(I, ' ', N, ' ', E);
  I := I + 1;
  WriteLn(I);
  WriteLn(R, ' ', RI, ' ', B, ' ', C, ' ', S, ' ', Length(S), ' [', Empty, '] ', Ord(K));
  WriteLn(A[0] + A[1] + A[2], ' ', Names[1], ' ', Names[3], ' ', Length(Names[2]), ' ', Hx[2]);
  WriteLn(P.X, ' ', P.Y, ' ', P.Name, ' ', Pts[0].X, Pts[0].Y, Pts[0].Name, ' ', Pts[1].X, Pts[1].Y, Pts[1].Name);
  WriteLn(3 in Odds, ' ', 4 in Odds, ' ', 6 in Odds, ' ', 4 in Evens, ' ', 5 in Evens, ' ', Nothing = nil);
  WriteLn(Count, ' ', Count, ' ', Count);
  WriteLn(Other, ' ', Other);
  Greet;
  Greet;
  S := S + 'd';
  Names[2] := 'deux';
  WriteLn(S, ' ', Names[2]);
end.

