{ select against select, a close that wakes a select, and two selects
  parked on one channel. Only a select whose waiters sit in the real
  channel queues can pair these; a poll-and-park-on-one-arm select
  deadlocks here. Results travel through done so the order of the
  printed lines does not depend on the scheduler. }
program selx;

var
  a, b, c, done: chan of Integer;

{ Left offers 1 on a or takes from b. }
procedure Left;
var
  x: Integer;
begin
  select
    Send(a, 1): Send(done, 11);
    Recv(b, x): Send(done, 12 + x * 100);
  end;
end;

{ Right, later, offers 2 on b or takes from a. Its send arm pairs with
  the receive arm Left has queued on b. }
procedure Right;
var
  x: Integer;
begin
  Sleep(20);
  select
    Send(b, 2): Send(done, 21);
    Recv(a, x): Send(done, 22 + x * 100);
  end;
end;

{ Waits on a and b; closing b wakes it with the zero value. }
procedure Waiter;
var
  x: Integer;
begin
  select
    Recv(a, x): Send(done, 300 + x);
    Recv(b, x): Send(done, 400 + x);
  end;
end;

{ Two of these park on c; two plain sends serve them both. }
procedure OnC(K: Integer);
var
  x: Integer;
begin
  select
    Recv(c, x): Send(done, x);
  end;
end;

procedure Two(const Title: string);
var
  v1, v2: Integer;
begin
  v1 := Recv(done);
  v2 := Recv(done);
  if v1 > v2 then
    WriteLn(Title, ' ', v2, ' ', v1)
  else
    WriteLn(Title, ' ', v1, ' ', v2);
end;

var
  i: Integer;

begin
  a := MakeChan();
  b := MakeChan();
  c := MakeChan();
  done := MakeChan();
  pas Left;
  pas Right;
  Two('cross');
  pas Waiter;
  Sleep(20);
  Close(b);
  WriteLn('closed ', Recv(done));
  pas OnC(1);
  pas OnC(2);
  Sleep(20);
  Send(c, 5);
  Send(c, 6);
  Two('shared');
  for i := 1 to 200 do            { many rounds: the queues stay consistent }
  begin
    pas OnC(i);
    Send(c, i);
    if Recv(done) <> i then
      WriteLn('lost ', i);
  end;
  WriteLn('rounds ok');
end.

