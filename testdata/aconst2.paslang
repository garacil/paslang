{ array of const (P124), what is paslang's: an Int64 is a vtInteger of
  64 bits, a Quad a vtQuad in the record itself, an interface a
  vtInterface (its object), a routine value a vtPointer (its code); a
  list walked with for x in and read by a nested routine; a slice of
  TVarRec on the heap given where an array of const goes; the list read
  after the stack grew under it and after the collector ran, its
  strings made by the caller; routines started with pas each with lists
  of their own. }
program aconst2;

type
  ISay = interface
    function Say: string;
  end;

  THello = class(ISay)
    function Say: string;
  end;

var
  done: waitgroup;
  lines: chan of string;

function THello.Say: string;
begin
  Result := 'hello';
end;

function Kinds(const Args: array of const): string;
var
  a: TVarRec;
begin
  Result := '';
  for a in Args do
    Result := Result + Chr(Ord('a') + a.VType);
end;

procedure Values(const Args: array of const);
begin
  WriteLn(Args[0].VQuad:0:30, ' ', TObject(Args[1].VInterface).ClassName, ' ',
    Args[2].VExtended:0:2);
end;

function First(const Args: array of const): Int64;
begin
  Result := Args[0].VInteger;
end;

function Deep(N: Int64): Int64;
var
  pad: array[0..63] of Int64;
begin
  pad[N mod 64] := N;
  if N = 0 then
    Result := 0
  else
    Result := Deep(N - 1) + pad[N mod 64] - N + 1;
end;

function Churn(K: Int64): Int64;
var
  i: Int64;
  s: string;
begin
  Result := 0;
  for i := 1 to K do
  begin
    s := 'churn ' + Chr(Ord('0') + i mod 10);
    Result := Result + Length(s);
  end;
end;

function Joined(const Args: array of const): string;
var
  i: Int64;

  function Part(K: Int64): string;
  begin
    if Args[K].VType = vtAnsiString then
      Result := Args[K].VAnsiString
    else
      Result := '?';
  end;

begin
  Result := '';
  for i := 0 to High(Args) do
    Result := Result + Part(i) + '|';
end;

procedure Hold(const Tag: string; const Args: array of const);
var
  d, c: Int64;
begin
  d := Deep(3000);
  c := Churn(20000);
  WriteLn(Tag, ' ', d, ' ', c, ' ', Joined(Args));
end;

procedure Worker(Id: Int64);
var
  r: string;
begin
  r := Joined(['w' + Chr(Ord('0') + Id), 'x' + Chr(Ord('0') + Id)]);
  Send(lines, r);
  done.Done;
end;

var
  big: Int64;
  q: Quad;
  say: ISay;
  onheap: array of TVarRec;
  f: function(N: Int64): Int64;
  a, b: string;

begin
  big := 9000000000000;
  q := 1;
  q := q / 3;
  say := THello.Create;
  f := @Deep;
  WriteLn(Kinds([big, q, say, f, 'z', 'zz', 1.5, True]));
  WriteLn(First([big]) = big, ' ', First([-1]));
  Values([q, say, 0.25]);
  SetLength(onheap, 2);
  onheap[0].VType := vtAnsiString;
  onheap[0].VAnsiString := 'from the heap';
  onheap[1].VType := vtInteger;
  onheap[1].VInteger := 5;
  WriteLn(Joined(onheap), ' ', Kinds(onheap));
  Hold('held', ['one' + Chr(Ord('0') + 1), 'two' + Chr(Ord('0') + 2), 'three']);
  lines := MakeChan(4);
  done.Add(4);
  pas Worker(1);
  pas Worker(2);
  pas Worker(3);
  pas Worker(4);
  done.Wait;
  b := '....';
  for big := 1 to 4 do
  begin
    a := Recv(lines);
    if a = 'w' + a[2] + '|x' + a[2] + '|' then
      b[Ord(a[2]) - Ord('0')] := a[2];
  end;
  WriteLn('workers ', b);
end.

