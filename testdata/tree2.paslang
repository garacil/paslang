{ P110: every word of tree[K] of V, tree of K and heap of T against the
  exact model in scripts/treemodel.py, which writes tree2.out: keys from
  a linear congruential generator, Length, Low, High, Succ, Pred, Floor,
  Ceil, Rank, KeyAt, TryGet, Delete, Include, Exclude, t[k] := True,
  PopLow, PopHigh, Split, Join (a merge), Clear, for k, v in t, downto,
  t[a..b], string keys and values that stay whole across the walk, and
  a heap of integers, of strings and of reals with Push, Pop and Low. }
program tree2;

var
  t, u: tree[Integer] of Integer;
  s: tree of string;
  m: tree[string] of string;
  h: heap of Integer;
  hs: heap of string;
  hr: heap of Real;
  k, v, i, n, x, acc, prev: Integer;
  ks, vs: string;
  r: Real;

function Next: Integer;
begin
  x := (x * 1103515245 + 12345) mod 2147483648;
  Result := x;
end;

begin
  { an integer tree of 5000 keys, many repeated }
  New(t);
  x := 12345;
  for i := 1 to 5000 do
    t[Next mod 100000] := i;
  WriteLn(Length(t), ' ', Low(t), ' ', High(t));
  acc := 0;
  n := 0;
  prev := -1;
  for k, v in t do
  begin
    if k <= prev then
      WriteLn('out of order');
    prev := k;
    acc := (acc * 31 + k + v) mod 1000000007;
    n := n + 1;
  end;
  WriteLn(n, ' ', acc);
  acc := 0;
  prev := 1000000;
  for k, v in t downto do
  begin
    if k >= prev then
      WriteLn('out of order');
    prev := k;
    acc := (acc * 31 + k) mod 1000000007;
  end;
  WriteLn(acc);
  n := 0;
  acc := 0;
  for k, v in t[20000..30000] do
  begin
    n := n + 1;
    acc := (acc + k) mod 1000000007;
  end;
  WriteLn(n, ' ', acc);
  n := 0;
  for k in t[30000..20000] do
    n := n + 1;
  WriteLn(n);
  n := 0;
  acc := 0;
  for k, v in t[20000..30000] downto do
  begin
    n := n + 1;
    acc := (acc * 7 + k) mod 1000000007;
  end;
  WriteLn(n, ' ', acc);
  n := 0;
  for k in t[High(t)..1000000] do
    n := n + 1;
  WriteLn(n);
  k := KeyAt(t, 100);
  WriteLn(k, ' ', Rank(t, k), ' ', Succ(t, k), ' ', Pred(t, k), ' ', Floor(t, k), ' ', Ceil(t, k));
  WriteLn(Floor(t, 50000), ' ', Ceil(t, 50000), ' ', Succ(t, 50000), ' ', Pred(t, 50000));
  WriteLn(Rank(t, 0), ' ', Rank(t, 100000), ' ', Rank(t, 50000), ' ', KeyAt(t, 0), ' ', KeyAt(t, Length(t) - 1));
  { every third key of the generator goes }
  x := 12345;
  n := 0;
  for i := 1 to 5000 do
  begin
    k := Next mod 100000;
    if i mod 3 = 0 then
      if Delete(t, k) then
        n := n + 1;
  end;
  WriteLn(n, ' ', Length(t));
  acc := 0;
  for k, v in t do
    acc := (acc * 31 + k + v) mod 1000000007;
  WriteLn(acc);
  if TryGet(t, 12, v) then
    WriteLn('has 12 ', v)
  else
    WriteLn('no 12');
  k := KeyAt(t, 7);
  if TryGet(t, k, v) then
    WriteLn('has ', k, ' ', v)
  else
    WriteLn('no ', k);
  WriteLn(t[k], ' ', t[-5], ' ', -5 in t, ' ', k in t);
  n := 0;
  acc := 0;
  while PopLow(t, k, v) do
  begin
    n := n + 1;
    acc := (acc * 31 + k + v) mod 1000000007;
    if n = 100 then
      Break;
  end;
  WriteLn(n, ' ', acc, ' ', Length(t), ' ', Low(t));
  n := 0;
  acc := 0;
  while PopHigh(t, k) do
  begin
    n := n + 1;
    acc := (acc * 31 + k) mod 1000000007;
    if n = 100 then
      Break;
  end;
  WriteLn(n, ' ', acc, ' ', Length(t), ' ', High(t));
  { Split keeps the keys below, Join merges }
  u := Split(t, 50000);
  WriteLn(Length(t), ' ', Length(u), ' ', High(t), ' ', Low(u));
  Join(t, u);
  WriteLn(Length(t), ' ', Length(u));
  New(u);
  u[KeyAt(t, 0)] := 999;
  u[123456] := 7;
  Join(t, u);
  WriteLn(t[KeyAt(t, 0)], ' ', t[123456], ' ', Length(t), ' ', Length(u));
  Clear(t);
  WriteLn(Length(t), ' ', 5 in t, ' ', t[5]);
  { a tree of strings is a set }
  New(s);
  Include(s, 'pear');
  Include(s, 'apple');
  s['fig'] := True;
  s['kiwi'] := True;
  s['kiwi'] := False;
  Exclude(s, 'none');
  Include(s, 'apple');
  WriteLn(Length(s), ' ', s['apple'], ' ', s['kiwi'], ' ', 'fig' in s);
  for ks in s do
    Write(ks, ' ');
  WriteLn;
  for ks in s downto do
    Write(ks, ' ');
  WriteLn;
  WriteLn(Low(s), ' ', High(s), ' ', Succ(s, 'b'), ' ', Pred(s, 'g'), ' ', Floor(s, 'fig'), ' ', Ceil(s, 'g'));
  for ks in s['b'..'m'] do
    Write(ks, ' ');
  WriteLn;
  { string keys and values, walked, changed after the walk, popped }
  New(m);
  for i := 1 to 300 do
    m['k' + PasFmtInt((i * 37) mod 300, 0)] := 'v' + PasFmtInt(i, 0);
  WriteLn(Length(m), ' ', m['k0'], ' ', m['k299'], ' ', m['none'] = '', ' ', Low(m), ' ', High(m));
  n := 0;
  acc := 0;
  for ks, vs in m['k10'..'k2'] do
  begin
    n := n + 1;
    acc := (acc * 31 + Length(ks) + Length(vs)) mod 1000000007;
  end;
  WriteLn(n, ' ', acc);
  for ks, vs in m do
  begin
    ks := ks + '!';
    vs := vs + '?';
  end;
  WriteLn(m['k1'], ' ', KeyAt(m, 1), ' ', Rank(m, 'k2'));
  n := 0;
  while PopLow(m, ks, vs) do
  begin
    n := n + 1;
    if n <= 3 then
      Write(ks, '=', vs, ' ');
  end;
  WriteLn(n, ' ', Length(m));
  { the heaps }
  New(h);
  x := 777;
  for i := 1 to 2000 do
    Push(h, Next mod 1000);
  WriteLn(Length(h), ' ', Low(h));
  prev := -1;
  n := 0;
  acc := 0;
  while Pop(h, k) do
  begin
    if k < prev then
      WriteLn('heap out of order');
    prev := k;
    n := n + 1;
    acc := (acc * 31 + k) mod 1000000007;
  end;
  WriteLn(n, ' ', acc, ' ', Length(h));
  Push(h, 5);
  Push(h, 3);
  Push(h, 9);
  WriteLn(Pop(h), ' ', Pop(h), ' ', Low(h), ' ', Length(h));
  New(hs);
  for i := 1 to 60 do
    Push(hs, 's' + PasFmtInt((i * 17) mod 60, 0));
  WriteLn(Length(hs), ' ', Low(hs));
  n := 0;
  while Pop(hs, ks) do
  begin
    n := n + 1;
    if n <= 4 then
      Write(ks, ' ');
  end;
  WriteLn(n);
  New(hr);
  for i := 1 to 100 do
  begin
    r := (Next mod 10000) / 100.0;
    Push(hr, r);
  end;
  acc := 0;
  n := 0;
  while Pop(hr, r) do
  begin
    n := n + 1;
    acc := (acc * 31 + Round(r * 100)) mod 1000000007;
  end;
  WriteLn(n, ' ', acc);
end.

