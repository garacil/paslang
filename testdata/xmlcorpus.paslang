{ P426: pasxml's reader against expat. testdata/xmlcorpus.txt holds the
  documents (hex, one a line): written for each production of XML 1.0 and
  Namespaces in XML 1.0, and those with bytes changed, inserted and removed.
  Each is read with namespaces and without; the line is "ok" and the FNV-1a
  hash of what the reader gave (start tags with their attributes by name,
  the text joined, comments, processing instructions, as hex), or "err".
  testdata/xmlcorpus.out is what scripts/xml_corpus.py has expat (pyexpat)
  say of the same documents. }
program xmlcorpus;

uses
  sysutils, pasxml;

const
  HexDigits: string = '0123456789abcdef';

var
  Acc: string;
  H: Integer;

function HexOf(const S: string): string;
var
  i: Integer;
begin
  SetLength(Result, Length(S) * 2);
  for i := 1 to Length(S) do
  begin
    Result[i * 2 - 1] := HexDigits[(Ord(S[i]) shr 4) + 1];
    Result[i * 2] := HexDigits[(Ord(S[i]) and 15) + 1];
  end;
end;

function Hex16(V: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, 16);
  for i := 16 downto 1 do
  begin
    Result[i] := HexDigits[(V and 15) + 1];
    V := V shr 4;
  end;
end;

function Unhex(const S: string): string;
var
  i, a, b: Integer;
begin
  SetLength(Result, Length(S) div 2);
  for i := 1 to Length(S) div 2 do
  begin
    a := Pos(S[i * 2 - 1], HexDigits) - 1;
    b := Pos(S[i * 2], HexDigits) - 1;
    Result[i] := Chr(a * 16 + b);
  end;
end;

function QN(const U, L: string): string;
begin
  if U = '' then
    Result := L
  else
    Result := U + ' ' + L;
end;

procedure Put(const S: string);
begin
  Acc := Acc + S + #10;
end;

{ the dump of a document: False when the reader refuses it }
function Dump(const Doc: string; Ns: Boolean): Boolean;
var
  r: TXmlReader;
  tok: TXmlToken;
  line, t: string;
  i, j, depth: Integer;
  names, vals: array of string;
begin
  Acc := '';
  Result := True;
  depth := 0;
  line := '';
  try
    r := TXmlReader.Create(Doc);
    r.Namespaces := Ns;
    while r.Next(tok) do
    begin
      if (tok.Kind <> xtText) and (tok.Kind <> xtCData) and (line <> '') then
      begin
        if depth > 0 then
          Put('T ' + HexOf(line));
        line := '';
      end;
      case tok.Kind of
        xtStart:
          begin
            names := nil;
            vals := nil;
            for i := 0 to High(tok.Attrs) do
              if not tok.Attrs[i].IsNs then
              begin
                SetLength(names, Length(names) + 1);
                SetLength(vals, Length(vals) + 1);
                if Ns then
                  names[High(names)] := QN(tok.Attrs[i].URI, tok.Attrs[i].Local)
                else
                  names[High(names)] := tok.Attrs[i].Name;
                vals[High(vals)] := tok.Attrs[i].Value;
              end;
            for i := 0 to High(names) do
              for j := i + 1 to High(names) do
                if names[j] < names[i] then
                begin
                  t := names[i];
                  names[i] := names[j];
                  names[j] := t;
                  t := vals[i];
                  vals[i] := vals[j];
                  vals[j] := t;
                end;
            t := 'S ' + HexOf(QN(tok.URI, tok.Local));
            for i := 0 to High(names) do
              t := t + ' ' + HexOf(names[i]) + '=' + HexOf(vals[i]);
            Put(t);
            depth := depth + 1;
          end;
        xtEnd:
          begin
            Put('E');
            depth := depth - 1;
          end;
        xtText, xtCData:
          if depth > 0 then
            line := line + tok.Value;
        xtComment:
          Put('C ' + HexOf(tok.Value));
        xtPI:
          Put('P ' + HexOf(tok.Name) + ' ' + HexOf(tok.Value));
      end;
    end;
    Put('OK');
    { the last line has no line feed in the oracle's text }
    Acc := Copy(Acc, 1, Length(Acc) - 1);
  except
    on E: EXmlError do
      Result := False;
  end;
end;

procedure Hash;
var
  i: Integer;
begin
  H := Integer($CBF29CE484222325);
  for i := 1 to Length(Acc) do
  begin
    H := H xor Ord(Acc[i]);
    H := H * Integer($100000001B3);
  end;
end;

var
  corpus, line, doc, id: string;
  p, q, nl, count: Integer;
begin
  if not ReadFile('testdata/xmlcorpus.txt', corpus) then
  begin
    WriteLn('no testdata/xmlcorpus.txt');
    Halt(2);
  end;
  p := 1;
  count := 0;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    q := Pos(' ', line);
    id := Copy(line, 1, q - 1);
    doc := Copy(line, q + 1, Length(line) - q);
    if doc = '-' then
      doc := ''
    else
      doc := Unhex(doc);
    if Dump(doc, True) then
    begin
      Hash;
      WriteLn(id, ' ns ok ', Hex16(H));
    end
    else
      WriteLn(id, ' ns err');
    if Dump(doc, False) then
    begin
      Hash;
      WriteLn(id, ' flat ok ', Hex16(H));
    end
    else
      WriteLn(id, ' flat err');
    count := count + 1;
  end;
end.
