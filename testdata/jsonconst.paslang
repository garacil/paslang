{ P209: json constants. A typed constant of json is parsed when the
  program compiles, by the parser JsonParse runs, and made once, before
  the main block and the class constructors run; nil is null; a text
  made of pieces and #nn is one text. A JsonParse of a constant string
  is the same: parsed when compiling, made once, the same document each
  time it is read, one for each text; with options, or of a text that
  varies, it is the call it was. A routine's constant is made once too,
  and a class constructor reads a constant already made. }
program jsonconst;

type
  TBoot = class
    class constructor Create;
  end;

const
  Config: json = '{"name":"svc","ports":[80,443],"tls":true}';
  Nothing: json = nil;
  Pieces: json = '["caf' + #195#169 + '", "x' + #92 + 'u0041", ' + #10 + '2]';
  Escaped: json = '{"quote":"it''s","path":"a\/b","u":"é😀"}';

var
  booted: string;

class constructor TBoot.Create;
begin
  booted := Config['name'].AsString;
end;

function Kept: json;
const
  Mine: json = '{"made":"once"}';
begin
  Result := Mine;
end;

function Fresh: json;
begin
  Result := JsonParse('{"k":[1,2,3]}');
end;

function Again: json;
begin
  Result := JsonParse('{"k":[1,2,3]}');
end;

var
  a, b: json;
  i: Integer;
  text: string;
  o: TJsonOptions;
begin
  WriteLn(JsonEncode(Config), ' ', Config['ports'][1].AsInteger);
  WriteLn(JsonEncode(Nothing), ' ', JsonEncode(Pieces));
  WriteLn(JsonEncode(Escaped), ' ', Escaped['quote'].AsString);
  WriteLn('a class constructor read ', booted);
  WriteLn(JsonEncode(Kept), ' ', (Kept as Pointer) = (Kept as Pointer));
  a := Fresh;
  for i := 1 to 1000 do
    b := Fresh;
  WriteLn(JsonEncode(b), ' one document: ', (a as Pointer) = (b as Pointer),
    ', the same text in two routines: ', (a as Pointer) = (Again as Pointer));
  text := '{"k":';
  text := text + '[1,2,3]}';
  a := JsonParse(text);
  WriteLn('a text that varies: ', JsonEncode(a), ' ', (a as Pointer) = (b as Pointer));
  o := JsonDefaults;
  o.MaxDepth := 1;
  try
    a := JsonParse('[[1]]', o);
    WriteLn('no error');
  except
    on e: EJsonError do
      WriteLn('with options, the call: ', e.Message);
  end;
end.

