program syscontents;
uses sysutils, paslinux;
const Size = 32769; Readers = 32;
var
  root: string;
  baseHandle, handle, count, i: Integer;
  contents, received: TBytes;
  error: TSysError;
  joined: waitgroup;
  pipeEnds: array[0..1] of Int32;

procedure Reader(Index: Integer);
var bytes: TBytes; localError: TSysError; k: Integer;
begin
  SetLastOSError(Index + 1);
  if not TryReadFileAt(baseHandle, 'contents', Size, bytes, localError) then Halt(20);
  if Length(bytes) <> Size then Halt(21);
  for k := 0 to High(bytes) do if bytes[k] <> Byte(k mod 251) then Halt(22);
  if GetLastOSError <> Index + 1 then Halt(23);
  joined.Done;
end;

procedure PipeReader;
var bytes: TBytes; localError: TSysError;
begin
  if not TryReadFileContents(pipeEnds[0], Size, bytes, localError) then Halt(24);
  if (Length(bytes) <> Size) or (bytes[Size - 1] <> contents[Size - 1]) then Halt(25);
  joined.Done;
end;

begin
  root := ParamStr(1);
  if not TryOpenFileAt(CurrentDirectoryHandle, root, ODirectory, 0, baseHandle, error) then Halt(2);
  SetLength(contents, Size);
  for i := 0 to Size - 1 do contents[i] := Byte(i mod 251);
  SetLastOSError(77);
  if not TryWriteFileAt(baseHandle, 'contents', contents, 384, error) then Halt(3);
  if GetLastOSError <> 77 then Halt(4);
  if not TryReadFileAt(baseHandle, 'contents', Size, received, error) then Halt(5);
  if Length(received) <> Size then Halt(6);
  if TryReadFileAt(baseHandle, 'contents', Size - 1, received, error) then Halt(7);
  if (error.Code <> 27) or (Length(received) <> 0) then Halt(8);
  if TryReadFileAt(baseHandle, 'contents', 0, received, error) or (error.Code <> 27) then Halt(9);
  if TryReadFileAt(baseHandle, 'contents', -1, received, error) or (error.Code <> 22) then Halt(10);
  received := nil;
  if not TryWriteFileAt(baseHandle, 'empty', received, 384, error) then Halt(11);
  if not TryReadFileAt(baseHandle, 'empty', 0, received, error) or (Length(received) <> 0) then Halt(12);
  joined.Add(Readers);
  for i := 0 to Readers - 1 do pas Reader(i);
  joined.Wait;
  GcCollect;
  received := GetFileContents(root + '/contents', Size);
  if StringOf(received) <> GetFileAsString(root + '/contents', Size) then Halt(13);
  try
    received := GetFileContents(root + '/contents', 1);
    Halt(14);
  except
    on e: EOSError do if e.ErrorCode <> 27 then Halt(15);
  end;
  if not TryOpenFileAt(baseHandle, 'contents', ORdonly, 0, handle, error) then Halt(16);
  received := GetFileContents(handle, Size);
  if FileSeek(handle, 0, fsFromCurrent) <> Size then Halt(17);
  FileClose(handle); { borrowed, not secretly closed by contents helper }
  if not TryReadFileAt(CurrentDirectoryHandle, '/proc/sys/kernel/pid_max', 8192, received, error) then Halt(18);
  if Length(received) = 0 then Halt(19); { stat size zero is not an empty file }
  if OsPipe(Integer(@pipeEnds[0])) <> 0 then Halt(26);
  joined.Add(1);
  pas PipeReader;
  Sleep(20);
  GcCollect;
  count := 0;
  while count < Size do
  begin
    if not TryFileWrite(pipeEnds[1], contents, count, Size - count, i, error) then Halt(27);
    count := count + i;
  end;
  FileClose(pipeEnds[1]);
  joined.Wait;
  FileClose(pipeEnds[0]);
  if not TryDeleteFileAt(baseHandle, 'contents', False, error) or
    not TryDeleteFileAt(baseHandle, 'empty', False, error) then Halt(28);
  FileClose(baseHandle);
  WriteLn('bounded contents ', Size, ', concurrent readers ', Readers);
  WriteLn('exact limits, empty/proc files, borrowed pipes and errors');
end.
