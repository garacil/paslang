unit CycleHidden;
interface
type TSecret = record Hidden: Integer; end;
  THiddenHelper = type helper for Integer
    function HiddenValue: Integer;
  end;
function SecretValue: Integer;
implementation
uses CycleState;
function THiddenHelper.HiddenValue: Integer;
begin Result := Self + 100 end;
function SecretValue: Integer;
begin Result := 11 end;
initialization Note('H');
finalization Note('h');
end.
