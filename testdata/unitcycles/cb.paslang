unit CB;
interface
uses CA;
function Plus(const V: TPair): Integer;
function FromA: Integer;
implementation
uses CycleState;
function Plus(const V: TPair): Integer;
begin Result := V.N + 3 end;
function FromA: Integer;
var P: TPair;
begin P := MakeValue; Result := Plus(P) + P.Number - 4 end;
initialization Note('B');
finalization Note('b');
end.
