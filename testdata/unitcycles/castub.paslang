unit CA;
interface
type TPair = record N: Integer; function Number: Integer; end;
function MakeValue: TPair;
function Value: Integer;
implementation
uses CycleState;
function TPair.Number: Integer;
begin Result := N end;
function MakeValue: TPair;
begin Result.N := 4 end;
function Value: Integer;
begin Result := 7 end;
initialization Note('A');
finalization Note('a');
end.
