{ P325: an expression for a var parameter through a routine value is
  refused with its line. }
program exprarg;

type
  TBump = procedure(var X: Integer);

procedure Bump(var X: Integer);
begin
  X := X + 1;
end;

var
  f: TBump;
  a: Integer;

begin
  f := @Bump;
  a := 1;
  f(a + 1);
end.

