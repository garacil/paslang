{ P498: a constant for a constructor's var parameter is refused with its line. }
program ctorconst;

type
  TBox = class
    N: Integer;
    constructor Create(A: Integer; var Acc: Integer);
  end;

constructor TBox.Create(A: Integer; var Acc: Integer);
begin
  N := A;
  Acc := Acc + A;
end;

var
  b: TBox;
begin
  b := TBox.Create(5, 3);
end.

