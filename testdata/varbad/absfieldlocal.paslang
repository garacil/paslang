{ absolute names a field of a global record (P162), not of a local one. }
program absfieldlocal;

type
  TPoint = record
    X, Y: Int64;
  end;

procedure Show;
var
  p: TPoint;
  x: Int64 absolute p.X;
begin
  x := 1;
  WriteLn(p.X);
end;

begin
  Show;
end.

