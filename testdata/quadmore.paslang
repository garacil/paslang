program quadmore;

{ Quad (P103) in every place a value goes: Inc and Dec, a map, a
  channel, a class field, a routine's result through a unit (quadu). }

uses quadu;

type
  TBox = class
    V: Quad;
  end;

var
  q, w: Quad;
  m: map[Integer] of Quad;
  c: chan of Quad;
  b: TBox;

begin
  q := 1;
  Inc(q);
  Dec(q, 3);
  WriteLn('inc ', q:0:3);
  Inc(q, 0.5);
  WriteLn('inc ', q:0:3);
  New(m);
  m[1] := Quad(1) / 3;
  m[2] := 7;
  WriteLn('map ', m[1]:0:30, ' ', m[2]:0:1, ' ', m[3]:0:1);
  c := MakeChan(1);
  Send(c, Quad(2) / 3);
  w := Recv(c);
  WriteLn('chan ', w:0:30);
  b := TBox.Create;
  b.V := Sqrt(Quad(3));
  WriteLn('class ', b.V:0:30);
  WriteLn('unit ', Tenth:0:36, ' ', Last:0:3);
  Keep(Quad(5) / 4);
  WriteLn('unit ', Last:0:3);
end.
