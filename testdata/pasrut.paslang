program pasrut;

type
  TMark = class
    procedure Touch;
  end;

var
  wg: waitgroup;
  mu: mutex;
  init: once;
  ready: cond;
  rw: rwmutex;
  mark: TMark;
  n, hits, go, i: Integer;

procedure TMark.Touch;
begin
  hits := hits + 1;
end;

procedure Worker(K: Integer);
var
  j: Integer;
begin
  for j := 1 to 50 do
  begin
    mu.Lock;
    n := n + 1;
    mu.Unlock;
  end;
  wg.Done;
end;

procedure Waiter(K: Integer);
begin
  mu.Lock;
  while go = 0 do
    ready.Wait(mu);
  n := n + 1;
  mu.Unlock;
  wg.Done;
end;

procedure Reader(K: Integer);
begin
  rw.BeginRead;
  rw.EndRead;
  wg.Done;
end;

begin
  WriteLn(NumGoroutine);
  Yield;
  n := 0;
  wg.Add(4);
  for i := 1 to 4 do
    pas Worker(i);
  wg.Wait;
  WriteLn(n);
  hits := 0;
  mark := TMark.Create;
  once init do
    mark.Touch;
  once init do
    mark.Touch;
  if not init.Done then
    hits := hits + 10;
  WriteLn(hits);
  go := 0;
  n := 0;
  wg.Add(2);
  pas Waiter(1);
  pas Waiter(2);
  mu.Lock;
  go := 1;
  n := 5;
  ready.Broadcast;
  mu.Unlock;
  wg.Wait;
  WriteLn(n);
  wg.Add(2);
  pas Reader(1);
  pas Reader(2);
  wg.Wait;
  rw.Lock;
  rw.Unlock;
  WriteLn(3);
  WriteLn(Goid);
end.

