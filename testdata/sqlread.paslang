{ P403: a SQLite database read as SQLite reads it. The database named
  first is dumped as scripts/sqlfixtures.py dumps it with the C library:
  the header's page size, text encoding and user version, sqlite_schema's
  rows, each table's rows by rowid and each index's keys in key order.
  With 'busy' second, the open is expected to meet SQLITE_BUSY; with
  'notadb', SQLITE_NOTADB; with 'memory', ':memory:' is opened. }
program sqlread;

var
  db: TSqlite;
  objs: TSqliteObjects;
  r: TSqliteRows;
  i, j, n: Integer;
  mode: string;

procedure Show(const V: TSqliteValue);
begin
  Write(SqliteQuote(V));
end;

begin
  mode := ParamStr(2);
  if mode = 'memory' then
  begin
    db := TSqlite.Open(':memory:');
    WriteLn('memory pages ', db.PageCount, ' objects ', Length(db.Schema));
    db.Free;
    Exit;
  end;
  try
    db := TSqlite.Open(ParamStr(1), SQLITE_OPEN_READONLY);
    n := db.PageCount;
    WriteLn('pagesize ', db.PageSize, ' encoding ', db.Encoding, ' userversion ', db.UserVersion);
    objs := db.Schema;
    for i := 0 to High(objs) do
      WriteLn(objs[i].Kind, '|', objs[i].Name, '|', objs[i].TblName, '|', objs[i].RootPage, '|',
        objs[i].Sql);
    for i := 0 to High(objs) do
    begin
      if objs[i].RootPage = 0 then
        Continue;
      WriteLn('== ', objs[i].Name);
      r := db.RowsAt(objs[i].RootPage);
      while r.Next do
      begin
        if not r.IsIndex then
        begin
          Write(r.RowId);
          if r.ColumnCount > 0 then
            Write('|');
        end;
        for j := 0 to r.ColumnCount - 1 do
        begin
          if j > 0 then
            Write('|');
          Show(r.Column(j));
        end;
        WriteLn;
      end;
    end;
    db.Free;
  except
    on E: ESqliteError do
      WriteLn(mode, ' ', E.Code, ' ', E.ExtendedCode, ' ', E.Message);
  end;
end.
