{ SysUtils' local time on a time the clock skipped or showed twice
  (P461), under TZ set to a TZif file of testdata/zoneinfo: for each
  local date and time of the list, the UTC moment LocalTimeToUniversal
  gives it, the offset it takes off, and the local time
  UniversalTimeToLocal gives that moment back. The list holds the
  seconds around the changes of the five zones in 2026; the clock
  tests of dates2 hold at any moment of the year because the changes
  are checked here, on fixed dates. The make check runs it with five
  zones; the output is Go's, time.Date. }
program dates4;

uses sysutils;

function F(d: TDateTime): string;
begin
  Result := FormatDateTime('yyyy-mm-dd hh:nn:ss', d);
end;

procedure One(y, m, d, h, n, s: Integer);
var
  t, u: TDateTime;
begin
  t := EncodeDate(y, m, d) + EncodeTime(h, n, s, 0);
  u := LocalTimeToUniversal(t);
  WriteLn(F(t), ' utc ', F(u), ' off ', Round((t - u) * SecsPerDay),
    ' back ', F(UniversalTimeToLocal(u)));
end;

begin
  One(2026, 10, 25, 1, 59, 59);
  One(2026, 10, 25, 2, 0, 0);
  One(2026, 10, 25, 2, 7, 23);
  One(2026, 10, 25, 2, 59, 59);
  One(2026, 10, 25, 3, 0, 0);
  One(2026, 3, 29, 1, 59, 59);
  One(2026, 3, 29, 2, 0, 0);
  One(2026, 3, 29, 2, 30, 0);
  One(2026, 3, 29, 3, 0, 0);
  One(2026, 11, 1, 0, 59, 59);
  One(2026, 11, 1, 1, 0, 0);
  One(2026, 11, 1, 1, 30, 0);
  One(2026, 11, 1, 2, 0, 0);
  One(2026, 3, 8, 1, 59, 59);
  One(2026, 3, 8, 2, 0, 0);
  One(2026, 3, 8, 2, 30, 0);
  One(2026, 3, 8, 3, 0, 0);
  One(2026, 4, 5, 1, 59, 59);
  One(2026, 4, 5, 2, 0, 0);
  One(2026, 4, 5, 2, 30, 0);
  One(2026, 4, 5, 3, 0, 0);
  One(2026, 10, 4, 1, 59, 59);
  One(2026, 10, 4, 2, 0, 0);
  One(2026, 10, 4, 2, 30, 0);
  One(2026, 10, 4, 3, 0, 0);
  One(2026, 4, 5, 3, 29, 59);
  One(2026, 4, 5, 3, 30, 0);
  One(2026, 4, 5, 3, 44, 59);
  One(2026, 4, 5, 3, 45, 0);
  One(2026, 4, 5, 4, 0, 0);
  One(2026, 9, 27, 2, 30, 0);
  One(2026, 9, 27, 2, 45, 0);
  One(2026, 9, 27, 3, 0, 0);
  One(2026, 9, 27, 3, 15, 0);
  One(2026, 9, 27, 3, 45, 0);
  One(2026, 9, 27, 4, 0, 0);
end.

