{ P321: a constant from 0 to 2^32 - 1 goes into its register by a movl
  of 32 bits, and 0 by an xorl where nothing reads the flags. Regs keeps
  its variables in registers, Homes at their homes across a call, Args
  passes the constants, Sel chooses them by compares and selects, a zero
  between the compare and its branch. scripts/check_movconst.py reads
  that no movq or movabsq of such a constant into a register is left and
  that zeros are xorl. Written by a script; the answers are Python's. }
program movconst;

procedure Touch(x: Integer);
begin
  if x = -12345 then
    WriteLn('touch');
end;

function Mix(a, b, c, d, e, f, g, h, i: Integer): Integer;
begin
  Result := a * 3 + b - c xor d + e - f * 5 + g - h + i;
end;

function Regs(n: Integer): Integer;
var
  k, s, a, b, c, d, e: Integer;
begin
  s := 0;
  for k := 0 to n - 1 do
  begin
    a := 0;
    b := 2147483647;
    c := 2147483648;
    d := 4294967295;
    e := 4294967296;
    s := s * 3 + a + b - c + d - e + k;
    a := 1;
    b := -1;
    c := -2147483648;
    d := -2147483649;
    s := s xor (a + b + c - d);
  end;
  Result := s;
end;

function Homes(n: Integer): Integer;
var
  k, s, a, b, c, d, e: Integer;
begin
  s := 0;
  for k := 0 to n - 1 do
  begin
    a := 0;
    b := 2147483647;
    c := 2147483648;
    d := 4294967295;
    e := 4294967296;
    Touch(k);
    s := s * 3 + a + b - c + d - e + k;
  end;
  Result := s;
end;

function Sel(n: Integer): Integer;
var
  k, s, t, u: Integer;
begin
  s := 0;
  for k := 0 to n - 1 do
  begin
    if k > 3 then
      t := 0
    else
      t := 4294967295;
    if k < 5 then
      u := 2147483648
    else
      u := 0;
    if (k and 1) = 0 then
      s := s + t - u
    else
      s := s - t + u + 1;
  end;
  Result := s;
end;

begin
  WriteLn(Regs(10), ' ', Regs(1000));
  WriteLn(Homes(10), ' ', Homes(1000));
  WriteLn(Mix(0, 1, 2147483647, 2147483648, 4294967295, 4294967296, -1, -2147483648, -2147483649));
  WriteLn(Sel(10), ' ', Sel(1000));
end.
