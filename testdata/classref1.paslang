{ Class methods and class references (P123): class function and class
  procedure with Self the class, virtual ones overridden and dispatched
  on the class a reference holds, static ones with no Self; class of T
  and TClass, a class as a value, the class words through a reference;
  a virtual constructor called through a reference, which makes an
  object of the class it holds; a constructor in a class method; class
  variables, shared by the descendants, and class properties; class
  constructors and destructors. The same source compiles with Free
  Pascal, whose output is the one expected. }
program classref1;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  TShape = class
  private
    class var FCount: Int64;
    class var FUnit: string;
    class function GetUnit: string; static;
    class procedure SetUnit(const V: string); static;
  public
    Name: string;
    Side: Int64;
    constructor Create(const AName: string; ASide: Int64); virtual;
    procedure AfterConstruction; override;
    class function Kind: string; virtual;
    class function Describe: string;
    class function Make(ASide: Int64): TShape;
    class procedure Bump(By: Int64); static;
    class property Count: Int64 read FCount;
    class property UnitName: string read GetUnit write SetUnit;
    function Area: Int64; virtual;
    function Report: string;
    class constructor Init;
    class destructor Done;
  end;

  TSquare = class(TShape)
    constructor Create(const AName: string; ASide: Int64); override;
    class function Kind: string; override;
    function Area: Int64; override;
  end;

  TCube = class(TSquare)
    class function Kind: string; override;
    function Area: Int64; override;
  end;

  TShapeClass = class of TShape;

var
  Log: string;

constructor TShape.Create(const AName: string; ASide: Int64);
begin
  Name := AName;
  Side := ASide;
  Bump(1);
end;

procedure TShape.AfterConstruction;
begin
  Log := Log + '+' + ClassName;
end;

class function TShape.Kind: string;
begin
  Result := 'shape';
end;

class function TShape.Describe: string;
begin
  { Self is the class it was called for; Kind is virtual }
  Result := Self.ClassName + ' is a ' + Kind;
end;

class function TShape.Make(ASide: Int64): TShape;
begin
  { a constructor in a class method makes an object of Self's class }
  Result := Create('made', ASide);
end;

class procedure TShape.Bump(By: Int64);
begin
  FCount := FCount + By;
end;

class function TShape.GetUnit: string;
begin
  Result := FUnit;
end;

class procedure TShape.SetUnit(const V: string);
begin
  FUnit := '[' + V + ']';
end;

function TShape.Area: Int64;
begin
  Result := 0;
end;

function TShape.Report: string;
begin
  { a class method called from an object's method: the object's class }
  Result := Name + ': ' + Kind;
end;

class constructor TShape.Init;
begin
  WriteLn('class constructor');
  FUnit := 'cm';
end;

class destructor TShape.Done;
begin
  { Free Pascal runs it after the output closed: it prints nothing
    here (testdata/classref2 sees paslang's) }
  FCount := 0;
end;

constructor TSquare.Create(const AName: string; ASide: Int64);
begin
  inherited Create(AName + '#', ASide);
end;

class function TSquare.Kind: string;
begin
  Result := 'square';
end;

function TSquare.Area: Int64;
begin
  Result := Side * Side;
end;

class function TCube.Kind: string;
begin
  Result := 'cube';
end;

function TCube.Area: Int64;
begin
  Result := 6 * Side * Side;
end;

function Build(C: TShapeClass; const N: string; S: Int64): TShape;
begin
  Result := C.Create(N, S);
end;

var
  cls: TShapeClass;
  any: TClass;
  s: TShape;
  kinds: array[0..2] of TShapeClass;
  i: Int64;

begin
  WriteLn(TShape.Kind, ' ', TSquare.Kind, ' ', TCube.Kind);
  WriteLn(TShape.Describe);
  WriteLn(TCube.Describe);
  cls := TSquare;
  WriteLn(cls.ClassName, ' ', cls.Kind, ' ', cls.Describe);
  cls := TCube;
  WriteLn(Ord(cls = TCube), ' ', Ord(cls <> TSquare), ' ', Ord(cls = nil));
  WriteLn(Ord(cls.InheritsFrom(TShape)), ' ', Ord(TShape.InheritsFrom(TCube)));
  WriteLn(cls.ClassParent.ClassName, ' ', TCube.ClassParent.ClassParent.ClassName);
  s := Build(TCube, 'c', 2);
  WriteLn(s.ClassName, ' ', s.Name, ' ', s.Side, ' ', s.Area, ' ', s.Report);
  s := Build(TShape, 'p', 5);
  WriteLn(s.ClassName, ' ', s.Name, ' ', s.Area);
  s := TSquare.Make(3);
  WriteLn(s.ClassName, ' ', s.Name, ' ', s.Area);
  any := s.ClassType;
  WriteLn(any.ClassName, ' ', Ord(any = TSquare), ' ', Ord(s.ClassType = TCube));
  kinds[0] := TShape;
  kinds[1] := TSquare;
  kinds[2] := TCube;
  for i := 0 to 2 do
  begin
    s := kinds[i].Create('k' + kinds[i].Kind, i + 1);
    WriteLn(i, ' ', s.ClassName, ' ', s.Name, ' ', s.Area);
  end;
  WriteLn('count ', TShape.Count, ' ', TCube.Count);
  TShape.Bump(100);
  WriteLn('count ', TSquare.Count);
  WriteLn('unit ', TShape.UnitName);
  TCube.UnitName := 'mm';
  WriteLn('unit ', TShape.UnitName, ' ', s.UnitName);
  WriteLn(Log);
end.

