{ P445: a closure over a const parameter. portabilidades found (1.1.259)
  that a closure which captures a const string parameter read it empty,
  in the whole routine; the box a captured parameter lives in was filled
  with the parameter's address (8 bytes), not with its value. Strings,
  records and arrays arrive as an address when they are const, so each case
  here passes one, captures it, and reads it before the closure, inside
  it, after it, and after the call that made it has returned. Each case
  prints the const form and the form with a value parameter, which have
  always worked, and they are equal. }
program closureconst;

uses
  sysutils;

type
  TStrFn = function: string;
  TIntFn = function: Integer;
  TRec = record
    A, B: Integer;
    S: string;
  end;
  TArr = array[0..9] of Integer;
  TKeep = class
    function Wrap(const S: string): TStrFn;
  end;

function Call(P: TStrFn): string;
begin
  Result := P();
end;

function CallI(P: TIntFn): Integer;
begin
  Result := P();
end;

function ConstStr(const S: string): string;
begin
  Result := '[' + S + ']' + Call(function: string begin Result := S end) + '[' + S + ']';
end;

function ValueStr(S: string): string;
begin
  Result := '[' + S + ']' + Call(function: string begin Result := S end) + '[' + S + ']';
end;

function ConstTwo(const S, T: string): string;
begin
  Result := S + '/' + Call(function: string begin Result := T end) + '/' + T + '/' + S;
end;

function ConstMixed(const S: string; N: Integer; const T: string): string;
begin
  Result := Call(function: string begin Result := S + IntToStr(N) + T end) + '|' + S + IntToStr(N) + T;
end;

function ConstRec(const R: TRec): string;
begin
  Result := R.S + IntToStr(R.A) + ' ' + Call(function: string begin Result := R.S + IntToStr(R.A + R.B) end) +
    ' ' + IntToStr(R.B);
end;

function ConstArr(const A: TArr): string;
var
  s: Integer;
begin
  s := CallI(function: Integer
    var
      i, t: Integer;
    begin
      t := 0;
      for i := 0 to 9 do
        t := t + A[i];
      Result := t;
    end);
  Result := IntToStr(s) + ' ' + IntToStr(A[0]) + ' ' + IntToStr(A[9]);
end;

function ConstLocal(const S: string): string;
var
  n: Integer;
  f: TStrFn;
begin
  n := 1;
  f := function: string begin n := n + 1; Result := S + IntToStr(n) end;
  Result := f() + f() + S + IntToStr(n);
end;

function ConstNested(const S: string): string;
begin
  Result := Call(function: string
    begin
      Result := Call(function: string begin Result := S + '!' end) + S;
    end);
end;

function Keep(const S: string): TStrFn;
begin
  Result := function: string begin Result := S + '?' end;
end;

function TKeep.Wrap(const S: string): TStrFn;
begin
  Result := function: string begin Result := '<' + S + '>' end;
end;

procedure Churn;
var
  i: Integer;
  s: string;
begin
  for i := 1 to 20000 do
    s := IntToStr(i) + 'xyz' + IntToStr(i * 7);
  GcCollect;
end;

var
  r: TRec;
  a: TArr;
  i: Integer;
  k1, k2, k3: TStrFn;
  tk: TKeep;
  big: string;
begin
  WriteLn('const string  ', ConstStr('dep@a'));
  WriteLn('value string  ', ValueStr('dep@a'));
  WriteLn('empty string  ', ConstStr(''));
  WriteLn('two strings   ', ConstTwo('uno', 'dos'));
  WriteLn('mixed         ', ConstMixed('a', 7, 'b'));
  r.A := 3;
  r.B := 4;
  r.S := 'rec';
  WriteLn('const record  ', ConstRec(r));
  for i := 0 to 9 do
    a[i] := i * i;
  WriteLn('const array   ', ConstArr(a));
  WriteLn('with a local  ', ConstLocal('s'));
  WriteLn('nested        ', ConstNested('n'));
  big := '';
  for i := 1 to 50 do
    big := big + 'abcdefghij';
  k1 := Keep('kept');
  k2 := Keep(big);
  tk := TKeep.Create;
  k3 := tk.Wrap('method');
  Churn;
  WriteLn('outlives call ', k1(), ' ', Length(k2()), ' ', k3());
end.
