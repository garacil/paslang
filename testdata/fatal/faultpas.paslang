{ P567: a failure of the runtime no handler takes ends the program from
  any routine, not the main one alone: a routine started with pas divides
  by zero inside a try with a finally part; the finally part runs, the
  runtime's line is written and the program ends with status 1 while the
  main routine waits. An object raised by the program and not taken still
  ends its own routine alone (testdata/fatal/mainraise). }
program faultpas;

uses
  sysutils;

var
  wg: waitgroup;
  zero: Int64;

procedure Worker;
var
  q: Int64;
begin
  try
    q := 7 div zero;
    WriteLn(q);
  finally
    WriteLn(ErrOutput, 'finally ran');
  end;
  wg.Done;
end;

begin
  zero := ParamCount;
  WriteLn('before');
  wg.Add(1);
  pas Worker;
  wg.Wait;
  WriteLn('after');
end.

