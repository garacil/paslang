{ P341: a nil dereference in a statement of several lines names the line
  where the dereference is written: p^.X on line 20 of the WriteLn that
  starts on line 19. The signal stops it in line, at the load, which
  has that line in the table. }
program nilline;

type
  PR = ^TR;
  TR = record
    X: Integer;
  end;

var
  p: PR;

begin
  WriteLn('before');
  p := nil;
  WriteLn(1,
    p^.X);
end.

