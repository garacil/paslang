{ P289: an index masked wider than the array keeps its check. }
program bmaskwide;

var
  a: array[0..63] of Integer;
  i: Integer;

begin
  i := 100 + ParamCount;
  WriteLn('before');
  WriteLn(a[i and 127]);
  WriteLn('after');
end.

