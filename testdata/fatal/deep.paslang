{ P86: a recursion deeper than a stack may grow says stack overflow,
  with the line of the call that did not fit, and exits 1. Since P92 a
  stack may reach 1 GiB, so each frame carries 64 KB and the recursion
  never ends. }
program deep;

function Depth(N: Integer): Integer;
var
  pad: array[0..8191] of Integer;
begin
  pad[N mod 8192] := N;
  Result := Depth(N + 1) + pad[0];
end;

begin
  WriteLn('before');
  WriteLn(Depth(0));
  WriteLn('after');
end.
