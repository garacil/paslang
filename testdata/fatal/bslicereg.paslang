{ P100: a loop that keeps a slice's length in a register still stops at
  an index past it, with that length in the message. }
program bslicereg;

var
  d: array of Integer;
  i, n, sum: Integer;

begin
  SetLength(d, 5);
  n := 5 + ParamCount;
  sum := 0;
  WriteLn('before');
  for i := 0 to n do
    sum := sum + d[i];
  WriteLn('after');
end.

