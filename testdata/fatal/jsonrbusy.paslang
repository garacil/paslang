{ P208: a TJsonReader used by two routines at once ends the program, as
  a map written by two does. One reads from a pipe no one writes to and
  parks inside its read; the other reads too and finds it there, or
  parks first and is found: either way the program ends. }
program jsonrbusy;

uses
  paslinux;

type
  TFds = array[0..1] of Int32;

var
  f: TFds;
  r: TJsonReader;
  j: json;

procedure Reader;
var
  v: json;
begin
  if JsonRead(r, v) then
    WriteLn('a value');
end;

begin
  WriteLn('before');
  f[0] := 0;
  f[1] := 0;
  if Amd64 = 1 then
    Syscall(293, @f[0], 524288 or ONonblock)
  else
    Syscall(59, @f[0], 524288 or ONonblock);
  r := JsonReader(f[0]);
  pas Reader;
  Sleep(50);
  if JsonRead(r, j) then
    WriteLn('a value');
  WriteLn('after');
end.

