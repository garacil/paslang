{ A bit number past the width inside a call-free loop, which the
  register pool works out, stops the program at its line (1.0.117). }
program bitpool;

var
  x: Int32;
  j, k: Integer;

begin
  x := -1;
  k := 0;
  WriteLn('before');
  for j := 0 to 40 + ParamCount do
    k := k + IsBitSet(x, j);
  WriteLn(k);
end.

