{ P319: a run whose indexes do not all fit a slice its head proves by
  the length at its home runs the checked body, which stops at the first
  index past that length and reports it. }
program brunlen;

var
  a, b, c, d, e: array of Integer;

function Sum5(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to n - 1 do
    t := t + a[k] + b[k] + c[k] + d[k] + e[k];
  Result := t;
end;

begin
  SetLength(a, 50);
  SetLength(b, 50);
  SetLength(c, 50);
  SetLength(d, 30);
  SetLength(e, 50);
  WriteLn('before');
  WriteLn(Sum5(40 + ParamCount));
  WriteLn('after');
end.

