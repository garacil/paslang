{ P568: a fault is raised only from code the runtime knows whole, the
  table of the routines a signal may stop anywhere (P293): a routine with
  an asm block is not there, and a nil pointer read in it ends the
  program inside a try too, as a checked failure of it does (faultasm). }
program nilasm;

uses
  sysutils;

type
  PRec = ^TRec;
  TRec = record
    X: Int64;
  end;

var
  p: PRec;

function Twice(Q: PRec): Int64;
var
  v: Int64;
begin
  v := Q^.X;
  asm amd64 (v: in rax; Result: out rax)
    addq %rax, %rax
  end;
  asm arm64 (v: in x0; Result: out x0)
    add x0, x0, x0
  end;
end;

begin
  p := PRec(Pointer(ParamCount * 0));
  WriteLn('before');
  try
    WriteLn(Twice(p));
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

