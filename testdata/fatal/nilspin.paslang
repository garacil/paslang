{ P568: a fault that comes while the routine holds one of the runtime's
  locks (SpinLock) is not raised, as a checked failure is not (faultspin):
  an exception would leave the lock held. The program stops with the
  fault's line, inside a try too. }
program nilspin;

uses
  sysutils;

type
  PRec = ^TRec;
  TRec = record
    X: Int64;
  end;

var
  p: PRec;
  w: Integer;

begin
  p := PRec(Pointer(ParamCount * 0));
  WriteLn('before');
  try
    SpinLock(@w);
    p^.X := 1;
    SpinUnlock(@w);
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

