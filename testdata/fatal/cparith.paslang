{ P104: under -checkptr a step past the end (one past it is in) stops at its line. }
program cparith;

type
  PRec = ^TRec;
  TRec = record
    A, B: Integer;
  end;

var
  q: PRec;
  p: PInteger;

begin
  New(q);
  WriteLn('before');
  p := PInteger(q) + 3 + ParamCount;
  WriteLn(p^);
end.

