{ P289: a for whose constant limits pass the array keeps its check. }
program bforpast;

procedure Run;
var
  a: array[0..63] of Integer;
  k, s: Integer;
begin
  s := 0;
  for k := 0 to 64 do
    s := s + a[k];
  WriteLn(s);
end;

begin
  WriteLn('before');
  Run;
end.

