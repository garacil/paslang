{ P104: under -checkptr p[i] past p's block stops, though another block follows. }
program cpindex;

type
  PRec = ^TRec;
  TRec = record
    A, B: Integer;
  end;

var
  q, q2: PRec;
  n: Integer;

begin
  New(q); New(q2); q2^.A := 5;
  WriteLn('before');
  n := PInteger(q)[2 + ParamCount];
  WriteLn(n);
end.
