{ Main has ended and the one routine left waits on a channel nobody
  sends to: the program used to wait for it for ever (1.0.139). }
program dlmain;

var
  c: chan of Integer;

procedure Waiter;
var
  x: Integer;
begin
  x := Recv(c);
  WriteLn('after');
end;

begin
  c := MakeChan();
  WriteLn('before');
  pas Waiter;
end.

