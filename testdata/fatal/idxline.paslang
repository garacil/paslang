{ P341: an index out of range in a statement of several lines names the
  line where the element is written: a[i] on line 15 of the WriteLn that
  starts on line 13, i 12 of 0..9. }
program idxline;

var
  a: array[0..9] of Integer;
  i: Integer;

begin
  WriteLn('before');
  i := ParamCount + 12;
  WriteLn(
    1,
    a[i]);
end.

