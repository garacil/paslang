{ P288: a leaf, called through a routine value so that it is not put
  in place, reads a field of a nil object: the fault says nil pointer
  with the leaf's own line, and exits 1. }
program leafnil;

type
  TBox = class
    V: Integer;
  end;
  TGet = function(B: TBox; K: Integer): Integer;

function Get(B: TBox; K: Integer): Integer;
begin
  Result := B.V + K;
end;

var
  b: TBox;
  f: TGet;

begin
  b := nil;
  f := @Get;
  WriteLn('before');
  WriteLn(f(b, 1));
  WriteLn('after');
end.

