{ P370: a block written through a nil pointer stops at its line, 40
  bytes copied in line and 300 by rt_memcpy. }
program nildest;

type
  TWide = record
    A, B, C, D, E: Integer;
  end;
  PWide = ^TWide;

var
  r: TWide;
  p: PWide;

begin
  WriteLn('before');
  p := nil;
  r.A := 1;
  p^ := r;
  WriteLn(p^.A);
end.

