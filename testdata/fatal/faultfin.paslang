{ P567: a failure of the runtime inside a try with a finally part and no
  handler: the finally part runs, as on any raise, and then the program
  stops with the runtime's line and status 1, as it did before failures
  were exceptions. }
program faultfin;

uses
  sysutils;

var
  a: array[0..4] of Int64;
  i: Int64;
begin
  i := 5 + ParamCount;
  WriteLn('before');
  try
    a[i] := 1;
  finally
    WriteLn(ErrOutput, 'finally ran');
  end;
  WriteLn('after');
end.

