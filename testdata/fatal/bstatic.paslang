{ P87: a static array's index outside its bounds stops the program. }
program bstatic;

var
  a: array[0..4] of Integer;
  i: Integer;

begin
  i := 10 + ParamCount;
  WriteLn('before');
  WriteLn(a[i]);
  WriteLn('after');
end.

