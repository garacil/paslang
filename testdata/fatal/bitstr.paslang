{ IsBitSet past a string's characters stops the program (1.0.118). }
program bitstr;

var
  s: string;
  n: Integer;

begin
  s := 'AB';
  n := 16 + ParamCount;
  WriteLn('before');
  WriteLn(IsBitSet(s, n));
  WriteLn('after');
end.

