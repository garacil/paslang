{ P104: a View of a length below 0 stops at its line. }
program bviewneg;

var
  a: array[0..3] of Integer;
  v: array of Integer;
  n: Integer;

begin
  n := -2 - ParamCount;
  WriteLn('before');
  v := View(PInteger(@a[0]), n);
  WriteLn(Length(v));
end.

