{ IsBitSet of a Byte past bit 7 stops the program (1.0.117). }
program bitchk;

var
  b: Byte;
  n: Integer;

begin
  b := 5;
  n := 8 + ParamCount;
  WriteLn('before');
  WriteLn(IsBitSet(b, n));
  WriteLn('after');
end.

