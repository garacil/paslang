{ P198: a string view over bytes whose byte before has no shared mark
  stops: the first store of the view would write that byte. }
program svmark;

var
  p: PByte;
  s: string;

begin
  p := PByte(GetMem(16, 0));
  p[1] := 104;
  p[2] := 105;
  WriteLn('before');
  s := PasStrView(p + 1, 2);
  WriteLn(s);
end.

