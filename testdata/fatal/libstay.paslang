{ P569: what Go does not let a program recover, paslang does not let it
  take. A mutex unlocked when nobody holds it is fatal in Go
  (internal/sync/mutex.go: unlock of unlocked mutex), and here it ends
  the program inside a try too, with SysUtils in the program; its line
  ends with the place, as every line of the library's failures does
  now. }
program libstay;

uses
  sysutils;

var
  mu: mutex;

begin
  WriteLn('before');
  try
    mu.Unlock;
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

