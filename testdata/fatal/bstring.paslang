{ P87: a string's index runs from 1 to its length. }
program bstring;

var
  s: string;
  i: Integer;

begin
  s := 'ab' + 'c';
  i := ParamCount;
  WriteLn('before');
  WriteLn(Ord(s[i]));
  WriteLn('after');
end.

