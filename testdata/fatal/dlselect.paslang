{ A select without else whose arms can never be ready parks main for
  ever: a deadlock (1.0.139). }
program dlselect;

var
  a, b: chan of Integer;
  x: Integer;

begin
  a := MakeChan();
  b := MakeChan();
  WriteLn('before');
  select
    Recv(a, x): WriteLn('a');
    Recv(b, x): WriteLn('b');
  end;
  WriteLn('after');
end.

