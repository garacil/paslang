{ A receive nobody will serve: every routine is asleep and nothing can
  wake one, so the program stops with paslang: all routines are asleep:
  deadlock instead of running for ever (1.0.139). }
program dlrecv;

var
  c: chan of Integer;
  x: Integer;

begin
  c := MakeChan();
  WriteLn('before');
  x := Recv(c);
  WriteLn('after');
end.
