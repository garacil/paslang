{ P400: a division that fails comes before the call the expression
  makes after it: the call does not go ahead of it into a variable of
  its own, so 'after' is never written; with the body put in place
  (pasopt HoistAt) and without (SplitAt). }
program divcall;

function Loud(X: Integer): Integer;
begin
  WriteLn('after');
  Result := X;
end;

function Run(A, B: Integer): Integer;
var
  x: Integer;
begin
  x := A div B + Loud(A);
  Result := x;
end;

begin
  WriteLn('before');
  WriteLn(Run(10, ParamCount));
end.

