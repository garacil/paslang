{ P339 and P341: the division by zero in the WriteLn of lines 14 and 15
  stops at line 15, where a div b is written: before P339 it said 15 by
  chance, the line after the word that ended line 14, then 14, the
  statement's, and P341 names the operation's. }
program divfirst;

var
  a, b: Integer;

begin
  a := 10;
  b := ParamCount;
  WriteLn('before');
  WriteLn
    (a div b);
  WriteLn('after');
end.

