{ P339: a statement whose first word ends its line has that line: the
  division by zero in the WriteLn of lines 14 and 15 stops at line 14,
  the statement's; it said 15, the line after the word, which was taken
  once the end of its line had been read. }
program divfirst;

var
  a, b: Integer;

begin
  a := 10;
  b := ParamCount;
  WriteLn('before');
  WriteLn
    (a div b);
  WriteLn('after');
end.

