program reportparallel;
uses sysutils;

const
  Workers = 48;

type
  EWorker = class(Exception)
  end;
  EFormatFailure = class(Exception)
    function ToString: string; override;
  end;

function EFormatFailure.ToString: string;
begin
  raise Exception.Create('formatting failed');
end;

var
  start: chan of Integer;
  arrived: waitgroup;

procedure Report(Id: Integer);
var
  count: Integer;
begin
  arrived.Done;
  if Recv(start) <> 0 then
    Halt(9);
  if Id mod 6 = 0 then
    raise;
  if Id = 1 then
    raise EFormatFailure.Create('use the class name');
  count := 96;
  if Id = 2 then
    count := 8192;
  raise EWorker.Create('worker-' + IntToStr(Id) + '-' + StringOfChar('x', count));
end;

type
  EMainFailure = class(Exception)
    function ToString: string; override;
  end;

function EMainFailure.ToString: string;
begin
  WriteLn('main formatting');
  Result := inherited ToString;
end;

procedure PipeWorker;
begin
  raise EWorker.Create(StringOfChar('x', 1 shl 20));
end;

procedure RaiseMain;
begin
  raise EMainFailure.Create('main');
end;

var
  i: Integer;
  release: string;
begin
  if ParamStr(1) = 'pipe' then
  begin
    pas PipeWorker;
    ReadLn(release);
    if release <> 'raise' then
      Halt(8);
    RaiseMain;
  end;
  start := MakeChan(0);
  arrived.Add(Workers);
  for i := 1 to Workers do
    pas Report(i);
  arrived.Wait;
  Close(start);
end.
