{ GetBits of a slice's field that reaches past its bytes stops the
  program (1.0.118): 8 bits from 26 of 32. }
program bitslice;

var
  da: array of Word;
  n: Integer;

begin
  SetLength(da, 2);
  n := 26 + ParamCount;
  WriteLn('before');
  WriteLn(GetBits(da, n, 8));
  WriteLn('after');
end.

