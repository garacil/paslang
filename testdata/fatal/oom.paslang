{ P86, P95b: asking for more than the heap may ever map (its 64 GiB)
  says out of memory and how much is mapped, and exits 1. Before P95b
  the heap stopped at 256 MiB; now only the reservation and the kernel
  limit it (oomlimit tests the kernel's refusal). }
program oom;

var
  p: Pointer;

begin
  WriteLn('before');
  GetMem(p, 100 * 1024 * 1024 * 1024);
  WriteLn('after');
end.

