{ A view past a string's characters stops the program (1.0.119): four
  bytes of a two-byte string. }
program viewstr;

var
  s: string;
  u: UInt32;

begin
  s := 'a' + 'b';
  WriteLn('before');
  u := s as UInt32;
  WriteLn(u);
  WriteLn('after');
end.

