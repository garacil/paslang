{ P198: a string view of a length below 0 stops, as Go's unsafe.String
  panics. }
program svneg;

var
  p: PByte;
  s: string;
  n: Integer;

begin
  p := PByte(GetMem(16, 0));
  p[0] := 1;
  n := -2 - ParamCount;
  WriteLn('before');
  s := PasStrView(p + 1, n);
  WriteLn(Length(s));
end.

