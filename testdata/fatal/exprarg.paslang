{ P266: an argument that can fail fails as the call made it fail, even
  when the function goes in as its expression and does not read it. }
program exprarg;

var
  a: array[0..4] of Integer;
  k: Integer;

function Ignore(X: Integer): Integer;
begin
  Result := 7;
end;

begin
  k := 9;
  WriteLn('before');
  WriteLn(Ignore(a[k]));
end.
