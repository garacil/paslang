{ P567: a failure that comes while the routine holds one of the
  runtime's locks (SpinLock) is not raised: an exception would leave the
  lock held and the routine never preempted again. The program stops
  with the failure's line, inside a try too, as Go throws on a panic
  holding locks (runtime/panic.go, gopanic). }
program faultspin;

uses
  sysutils;

var
  a: array[0..4] of Int64;
  w: Integer;
  i: Int64;

begin
  i := 5 + ParamCount;
  WriteLn('before');
  try
    SpinLock(@w);
    a[i] := 1;
    SpinUnlock(@w);
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

