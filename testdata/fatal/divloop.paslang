{ P93: a division by zero in a loop that keeps its variables in
  registers still names its line. }
program divloop;

var
  a, b, i: Integer;

begin
  a := 10;
  b := ParamCount;
  WriteLn('before');
  for i := 1 to 3 do
    a := a + i div b;
  WriteLn(a);
end.

