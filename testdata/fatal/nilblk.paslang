{ P370: a block read through a nil pointer stops as a word read through
  one does, at its line: the copy of r := p^ was taken for a zero value,
  whose address is 0, and gave zeros. 40 bytes, copied in line. }
program nilblk;

type
  TWide = record
    A, B, C, D, E: Integer;
  end;
  PWide = ^TWide;

var
  r: TWide;
  p: PWide;

begin
  WriteLn('before');
  p := nil;
  r := p^;
  WriteLn(r.A);
end.

