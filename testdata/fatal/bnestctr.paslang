{ P289: a for's counter a nested routine can write is no proof: the
  check stays. }
program bnestctr;

procedure Run;
var
  a: array[0..9] of Integer;
  k, s: Integer;

  procedure Jump;
  begin
    k := 50;
  end;

begin
  s := 0;
  for k := 0 to 9 do
  begin
    if k = 3 then
      Jump;
    s := s + a[k];
  end;
  WriteLn(s);
end;

begin
  WriteLn('before');
  Run;
end.

