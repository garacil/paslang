{ P316: an index that changes between two fields of an element is
  checked again: k goes past the length after the first field. }
program bkeepmoved;

type
  T3 = record a, b, c: Integer; end;

var
  h: array of T3;

procedure Walk(n: Integer);
var
  k: Integer;
begin
  k := 0;
  while k < n do
  begin
    h[k].a := k;
    k := k + 1;
    h[k].b := k;
  end;
end;

begin
  SetLength(h, 10);
  WriteLn('before');
  Walk(10 + ParamCount);
  WriteLn('after');
end.

