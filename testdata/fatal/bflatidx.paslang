{ P296: an index past its array in a routine with no frame and nothing
  pushed stops the program and reports the index and the line: the
  failure out of line puts rsp on 16 for its call. }
program bflatidx;

var
  tab: array[0..9] of Integer;

function Pick(i, j: Integer): Integer;
begin
  Result := tab[i] + tab[j];
end;

begin
  WriteLn('before');
  WriteLn(Pick(2, 10 + ParamCount));
  WriteLn('after');
end.

