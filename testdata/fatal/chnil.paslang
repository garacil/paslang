{ P583, P586: the close of a channel that was never made says so at its
  line, as Go's closechan panics; a send on it parks (fatal/dlnil). }
program chnil;

var
  c: chan of Integer;

begin
  WriteLn('before');
  Close(c);
  WriteLn('after');
end.

