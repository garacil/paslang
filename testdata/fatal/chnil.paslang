{ P583: a channel that was never made says so at the statement that
  used it; it was a nil pointer dereference at a pc of the runtime. }
program chnil;

var
  c: chan of Integer;

begin
  WriteLn('before');
  Send(c, 1);
  WriteLn('after');
end.

