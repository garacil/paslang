{ P316: the first field of an element past the length stops the program
  there and reports the index; the fields after it take that check. }
program bkeepfirst;

type
  T3 = record a, b, c: Integer; end;

var
  h: array of T3;

procedure Fill(n: Integer);
var
  k: Integer;
begin
  for k := 0 to n do
  begin
    h[k].a := k;
    h[k].b := k * 2;
    h[k].c := -k;
  end;
end;

begin
  SetLength(h, 10);
  WriteLn('before');
  Fill(10 + ParamCount);
  WriteLn('after');
end.

