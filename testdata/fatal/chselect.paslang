{ P583: a send on a closed channel as an arm of a select says the line of
  the select and exits 1; it said a pc of the runtime before. }
program chselect;

var
  c, d: chan of Integer;
  x: Integer;

begin
  c := MakeChan();
  d := MakeChan();
  Close(c);
  WriteLn('before');
  select
    Recv(d, x): WriteLn('got');
    Send(c, 1): WriteLn('sent');
  end;
  WriteLn('after');
end.

