{ P567: without SysUtils in the program a failure of the runtime stops it
  inside a try too, as in Free Pascal, whose SysUtils is what turns
  run-time errors into exceptions: the except part does not run. }
program faultbare;

var
  a: array[0..4] of Int64;
  i: Int64;
begin
  i := 5 + ParamCount;
  WriteLn('before');
  try
    a[i] := 1;
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

