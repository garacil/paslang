{ P569: the text of a failure of the library goes to the runtime with its
  length, which stands in one byte beside the kind: a longer text is cut
  at 255, and what is cut off takes nothing else with it. A store whose
  directory is not there cannot be opened; its failure ends the program
  inside a try too (the files of a store are no failure a handler can go
  on from), with a path of 325 letters in its text: the line is its
  first 255 letters and the place. }
program libcut;

uses
  sysutils;

var
  db: store;
  path: string;
  i: Int64;

begin
  path := '/nonexistent-paslang-dir/';
  for i := 1 to 30 do
    path := path + '0123456789';
  WriteLn('before');
  try
    db := StoreOpen(path);
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

