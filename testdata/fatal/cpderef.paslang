{ P104: under -checkptr an access past the object stops at its line. }
program cpderef;

type
  PRec = ^TRec;
  TRec = record
    A, B: Integer;
  end;

var
  q: PRec;
  n: Integer;

begin
  New(q);
  WriteLn('before');
  n := PInteger(PByte(q) + 12)^;
  WriteLn(n);
end.

