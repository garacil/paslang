{ SetBit with a negative bit number stops the program (1.0.117). }
program bitneg;

var
  w: Word;
  n: Integer;

begin
  w := 0;
  n := -1 + ParamCount;
  WriteLn('before');
  SetBit(w, n, 1);
  WriteLn('after');
end.

