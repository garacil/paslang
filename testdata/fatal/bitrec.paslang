{ IsBitSet past a record's bytes stops the program (1.0.118). }
program bitrec;

var
  r: record A: Word; B: Byte; C: Int32 end;
  n: Integer;

begin
  r.A := 1;
  n := 64 + ParamCount;
  WriteLn('before');
  WriteLn(IsBitSet(r, n));
  WriteLn('after');
end.

