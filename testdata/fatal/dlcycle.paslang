{ Two routines each wait for the other's channel while main waits for
  both on a waitgroup: three routines asleep, none can wake (1.0.139). }
program dlcycle;

var
  a, b: chan of Integer;
  wg: waitgroup;

procedure First;
var
  x: Integer;
begin
  x := Recv(a);
  Send(b, x);
  wg.Done;
end;

procedure Second;
var
  x: Integer;
begin
  x := Recv(b);
  Send(a, x);
  wg.Done;
end;

begin
  a := MakeChan();
  b := MakeChan();
  WriteLn('before');
  wg.Add(2);
  pas First;
  pas Second;
  wg.Wait;
  WriteLn('after');
end.
