{ P583: a sender that waits when its channel closes fails at its own
  send, as Go's does; the program ended at the close before, with the
  closer's line. }
program chwaited;

var
  c: chan of Integer;

procedure Later;
begin
  Sleep(20);
  Close(c);
end;

begin
  c := MakeChan();
  WriteLn('before');
  pas Later;
  Send(c, 1);
  WriteLn('after');
end.

