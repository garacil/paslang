{ P87: an index that calls a function takes the general path, and is
  checked there too. }
program bstrcall;

var
  s: string;

function Pick(X: Integer): Integer;
begin
  Result := X + ParamCount;
end;

begin
  s := 'ab' + 'c';
  WriteLn('before');
  WriteLn(Ord(s[Pick(4)]));
  WriteLn('after');
end.

