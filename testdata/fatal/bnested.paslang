{ P87: a slice that is an element of an array is checked against its own
  length. }
program bnested;

var
  m: array[0..1] of array of Integer;
  i: Integer;

begin
  SetLength(m[1], 2);
  i := 5 + ParamCount;
  WriteLn('before');
  WriteLn(m[1][i]);
  WriteLn('after');
end.

