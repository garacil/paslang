{ P100 (1.0.100): a loop whose first runs are proved in range and take
  the body without checks still stops at the first index past the slice,
  in the run the head could not prove. }
program bversion;

var
  d: array of Byte;
  i, n: Integer;

begin
  SetLength(d, 2500);
  n := 2999 + ParamCount;
  WriteLn('before');
  for i := 0 to n do
    d[i] := Byte(i);
  WriteLn('after');
end.

