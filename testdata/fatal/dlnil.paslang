{ P586: a send on a nil channel parks for ever, as Go's chansend does
  with c == nil; a receive on one parks a routine too, and with nothing
  else that can run the program is dead (Go's checkdead). It was the
  failure `nil channel` at the send's line since P583. }
program dlnil;

var
  c: chan of Integer;
  started: waitgroup;

procedure Receive;
var
  v: Integer;
begin
  started.Done;
  v := Recv(c);
  WriteLn('received ', v);
end;

begin
  started.Add(1);
  pas Receive;
  started.Wait;
  WriteLn('before');
  Send(c, 1);
  WriteLn('after');
end.

