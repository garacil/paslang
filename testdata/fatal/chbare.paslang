{ P583: with no SysUtils in the program a failure of a channel ends it
  inside a try too, as every failure of the runtime does (P567). }
program chbare;

var
  c: chan of Integer;

begin
  c := MakeChan();
  Close(c);
  WriteLn('before');
  try
    Send(c, 1);
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

