{ P586: a select without else whose arms are all on nil channels is
  never ready and parks main for ever, as Go's selectgo leaves those
  arms out: a deadlock. It was the failure `nil channel` at the
  select's line since P583. }
program dlnilsel;

var
  a, b: chan of Integer;
  x: Integer;

begin
  WriteLn('before');
  select
    Recv(a, x): WriteLn('a');
    Send(b, 1): WriteLn('b');
  end;
  WriteLn('after');
end.

