{ P103: Trunc of a Quad no Integer holds stops at its line. }
program qtrunc;

var
  q: Quad;
  n: Integer;

begin
  q := Quad(1e30) + ParamCount;
  WriteLn('before');
  n := Trunc(q);
  WriteLn(n);
end.

