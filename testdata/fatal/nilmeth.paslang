{ P369/P577: a method put in place on a nil object reports the field
  access on line 13, as its call does with inlining disabled. }
program nilmeth;

type
  TBox = class
    FCount: Integer;
    function Count: Integer;
  end;

function TBox.Count: Integer;
begin
  Result := FCount;
end;

var
  b: TBox;
  n: Integer;

begin
  WriteLn('before');
  b := nil;
  n := 0;
  n := b.Count + n;
  WriteLn(n);
end.

