{ P87: inside a loop the registers keep, the check stops at the line of
  the statement in the loop. }
program bloop;

var
  a: array[0..9] of Integer;
  i, sum: Integer;

begin
  for i := 0 to 9 do
    a[i] := i;
  WriteLn('before');
  sum := 0;
  for i := 0 to 10 + ParamCount do
    sum := sum + a[i];
  WriteLn(sum);
end.
