{ SetBit on an empty string has no bit to set (1.0.118). }
program bitempty;

var
  s: string;
  n: Integer;

begin
  s := '';
  n := ParamCount;
  WriteLn('before');
  SetBit(s, n, 1);
  WriteLn('after');
end.

