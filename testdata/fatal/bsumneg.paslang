{ P313: an index v - c below a static array's low bound stops the
  program, v in a register, and the report gives v - c. }
program bsumneg;

type
  T24 = record a, b, c: Integer; end;

var
  r: array[-3..20] of T24;

function Back(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := n downto -1 do
    t := t + r[k - 4].b;
  Result := t;
end;

begin
  WriteLn('before');
  WriteLn(Back(10 + ParamCount));
  WriteLn('after');
end.

