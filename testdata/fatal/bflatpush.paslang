{ P296: the same in a routine with no frame that pushes a register it
  keeps a variable in, rsp on 16 already. }
program bflatpush;

var
  tab: array[0..9] of Integer;

function Pick(a, b, c, d: Integer): Integer;
var
  t, u: Integer;
begin
  t := tab[a] + b;
  u := t * c;
  Result := u + tab[d] + t;
end;

begin
  WriteLn('before');
  WriteLn(Pick(3, 4, 5, -1 + ParamCount));
  WriteLn('after');
end.

