{ P567: a failure is raised only from code the runtime knows whole, the
  table P293 made of the routines a signal may stop anywhere: code
  paslangc compiled, outside the runtime's own units, with no asm in it.
  A routine with an asm block is not there, so a failure of its checks
  stops the program inside a try too, as every failure did. }
program faultasm;

uses
  sysutils;

var
  a: array[0..4] of Int64;
  i: Int64;

function Twice(X: Int64): Int64;
begin
  asm amd64 (X: in rax; Result: out rax)
    addq %rax, %rax
  end;
  asm arm64 (X: in x0; Result: out x0)
    add x0, x0, x0
  end;
  a[X] := Result;
end;

begin
  i := 5 + ParamCount;
  WriteLn('before');
  try
    WriteLn(Twice(i));
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

