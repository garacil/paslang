{ P95b: blocks that stay alive, so the collector cannot take them back,
  past what the kernel lets the program map (make check runs this under
  ulimit -v on amd64): out of memory with how much is mapped, exit 1. }
program oomlimit;

var
  keep: array[0..63] of Pointer;
  i: Integer;

begin
  WriteLn('before');
  for i := 0 to 63 do
    GetMem(keep[i], 20 * 1024 * 1024);
  WriteLn('after');
end.

