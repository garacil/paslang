{ P319: the same for local slices, their lengths in the frame: the run
  does not fit q, and the checked body reports q's first index past it. }
program brunloc;

function Local5(n, m: Integer): Integer;
var
  k, t: Integer;
  p, q, r, u, w: array of Integer;
begin
  SetLength(p, n);
  SetLength(q, m);
  SetLength(r, n);
  SetLength(u, n);
  SetLength(w, n);
  t := 0;
  for k := 0 to n - 1 do
    t := t + p[k] - q[k] + r[k] * u[k] + w[k];
  Result := t;
end;

begin
  WriteLn('before');
  WriteLn(Local5(2000 + ParamCount, 1500));
  WriteLn('after');
end.

