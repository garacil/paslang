{ P289: a for's counter given to a var parameter is no proof: the
  routine writes it, and the check stays. }
program bvarctr;

procedure Bump(var x: Integer);
begin
  x := 50;
end;

procedure Run;
var
  a: array[0..9] of Integer;
  k, s: Integer;
begin
  s := 0;
  for k := 0 to 9 do
  begin
    if k = 3 then
      Bump(k);
    s := s + a[k];
  end;
  WriteLn(s);
end;

begin
  WriteLn('before');
  Run;
end.

