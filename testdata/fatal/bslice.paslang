{ P87: a write past a slice's length stops before it writes, though the
  buffer behind it may be longer. }
program bslice;

var
  d: array of Integer;
  i: Integer;

begin
  SetLength(d, 3);
  i := 3 + ParamCount;
  WriteLn('before');
  d[i] := 7;
  WriteLn('after');
end.

