{ P568: a jump to nothing that is no call. A routine with an asm block
  jumps to address 0 with a word that is no code on top of its stack (on
  arm64, in the link register). The pc has no line, and neither has the
  word a call would have left: the runtime says what happened and no
  place, where a place made of that word would send the reader nowhere.
  Inside a try too: the code is not the table's. }
program niljump;

uses
  sysutils;

procedure Leap;
begin
  asm amd64
    movq $4660, %rax
    pushq %rax
    xorl %eax, %eax
    jmpq *%rax
  end;
  asm arm64
    mov x30, #4660
    mov x0, xzr
    br x0
  end;
end;

begin
  WriteLn('before');
  try
    Leap;
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

