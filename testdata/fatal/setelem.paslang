{ P126: an element of a list in brackets known only at run time and
  out of its set's range stops the program, the element and the range
  named. }
program setelem;

type
  TBytes = set of Byte;

var
  s: TBytes;
  i: Integer;

begin
  i := 300;
  WriteLn('before');
  s := [1, i];
  WriteLn(1 in s);
end.

