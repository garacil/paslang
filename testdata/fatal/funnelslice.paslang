{ A funnel of two slices of different lengths stops the program, their
  sizes in bytes (1.0.130). }
program funnelslice;

var
  a, b: array of Word;

begin
  SetLength(a, 2);
  SetLength(b, 3);
  WriteLn('before');
  a := FunnelRight(a, b, 5);
  WriteLn(Length(a));
  WriteLn('after');
end.

