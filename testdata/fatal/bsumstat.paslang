{ P313: an index v + c past a static array's bounds stops the program,
  v in a register and c in the element's displacement, and the report
  gives v + c. }
program bsumstat;

var
  a: array[1..64] of Integer;

function Sum(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to n do
    t := t + a[k + 3];
  Result := t;
end;

begin
  WriteLn('before');
  WriteLn(Sum(62 + ParamCount));
  WriteLn('after');
end.

