{ 1.0.112: Trunc of a real out of Integer's range stops at its line. }
program rrtrunc;

var
  x: Double;
  n: Integer;

begin
  x := 1e19 + ParamCount;
  WriteLn('before');
  n := Trunc(x);
  WriteLn(n);
end.

