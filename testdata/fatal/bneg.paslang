{ P87: bounds below zero, and an index below them, print with their
  signs. }
program bneg;

var
  a: array[-3..3] of Integer;
  i: Integer;

begin
  i := -5 + ParamCount;
  WriteLn('before');
  a[i] := 1;
  WriteLn('after');
end.

