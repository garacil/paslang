{ P568: a call of nothing from code that raises nothing. A routine with
  an asm block is not in the table of the routines a fault is raised in
  (nilasm), so a procedure variable that is nil, called in it, ends the
  program inside a try too. The pc of the fault is no code at all and
  has no line; the line of the program's end is the call's, which the
  runtime finds a byte under the return address. }
program nilcall;

uses
  sysutils;

type
  TStep = procedure;

var
  step: TStep;

function Twice(V: Int64): Int64;
begin
  step();
  asm amd64 (V: in rax; Result: out rax)
    addq %rax, %rax
  end;
  asm arm64 (V: in x0; Result: out x0)
    add x0, x0, x0
  end;
end;

begin
  WriteLn('before');
  try
    WriteLn(Twice(ParamCount + 1));
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

