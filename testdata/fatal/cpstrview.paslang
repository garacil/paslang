{ P198: under -checkptr a step from a view's characters is held to the
  view's block: reading past the block's end stops. }
program cpstrview;

type
  PStrWords = ^TStrWords;
  TStrWords = record
    P: Pointer;
    N: Integer;
  end;

var
  b: PByte;
  s: string;

begin
  b := PByte(GetMem(64, 0));
  b[53] := 1;
  s := PasStrView(b + 54, 10);
  WriteLn('before');
  WriteLn((PByte(PStrWords(@s)^.P) + 100)^);
end.

