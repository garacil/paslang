{ P122: an exception object nobody handles. In a routine started with
  pas it ends that routine alone, its finally part run, and the program
  goes on; in the main routine it ends the program with the object's
  class named on the error output and exit status 1. }
program raiseobj;

type
  EOops = class
    N: Integer;
  end;

var
  done: chan of Integer;

procedure Worker;
begin
  try
    raise EOops.Create;
  finally
    Send(done, 1);
  end;
  WriteLn('after');
end;

begin
  done := MakeChan(1);
  pas Worker;
  if Recv(done) = 1 then
    WriteLn('before');
  raise EOops.Create;
  WriteLn('after');
end.

