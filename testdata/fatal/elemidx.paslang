{ P373: an index the pool keeps in its own register, checked against
  the array's bounds, reports its value: 9 at line 20. }
program elemidx;

type
  TW = record
    A, B, C, D, E: Integer;
  end;

var
  g: array[0..7] of TW;
  t: TW;
  i: Integer;

begin
  WriteLn('before');
  i := 4;
  t := g[i and 7];
  i := i + 5;
  t := g[i or 1];
  WriteLn(t.A);
end.

