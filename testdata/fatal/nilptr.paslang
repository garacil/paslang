{ P86: a nil dereference says so, with the line, and exits 1. }
program nilptr;

type
  PRec = ^TRec;
  TRec = record
    X: Integer;
  end;

var
  p: PRec;

begin
  p := nil;
  WriteLn('before');
  WriteLn(p^.X);
  WriteLn('after');
end.

