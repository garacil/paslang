{ 1.0.112: Ceil of a real out of Integer's range stops at its line. }
program rrceil;

var
  x: Double;
  n: Integer;

begin
  x := (ParamCount + 0.0) / (ParamCount + 0.0);
  WriteLn('before');
  n := Ceil(x);
  WriteLn(n);
end.

