{ A mutex is not reentrant: locking it twice from the same routine parks
  that routine for ever, and with nothing else alive that is a deadlock
  (1.0.139). }
program dlmutex;

var
  mu: mutex;

begin
  WriteLn('before');
  mu.Lock;
  mu.Lock;
  WriteLn('after');
end.

