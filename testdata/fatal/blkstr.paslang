{ Logic on strings of two lengths stops the program (1.0.120). }
program blkstr;

var
  s, t: string;

begin
  s := 'abc';
  t := 'ab' + 'cd';
  WriteLn('before');
  s := s xor t;
  WriteLn(s);
  WriteLn('after');
end.

