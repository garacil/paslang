{ P568: a fault is a call of nothing only when it is the reading of the
  instruction at the pc. Here a routine with an asm block reads through a
  nil pointer with an address inside a routine of the program on top of
  its stack (on arm64, in the link register): the word a call of nothing
  would have left there, past the routine's stack check, where its entry
  in the table of the routines starts (P293). The address of the fault
  is not the pc, so the fault is this code's own, and code with asm
  raises nothing: the program ends with the line of the block, inside a
  try too. }
program nilasmtop;

uses
  sysutils;

function Bait(V: Int64): Int64;
var
  i: Int64;
begin
  Result := 0;
  for i := 1 to V do
    Result := Result + i * 3;
  if V > 0 then
    Result := Result + Bait(V - 1);
end;

function Twice(V: Int64): Int64;
begin
  asm amd64 (V: in rax; Result: out rax)
    leaq 65+p_bait(%rip), %rcx
    pushq %rcx
    xorl %ecx, %ecx
    movq (%rcx), %rax
  end;
  asm arm64 (V: in x0; Result: out x0)
    adrp x30, p_bait
    add x30, x30, :lo12:p_bait
    add x30, x30, #68
    mov x1, xzr
    ldr x0, [x1]
  end;
end;

begin
  WriteLn('before');
  if Bait(ParamCount) > 99 then
    WriteLn('never');
  try
    WriteLn(Twice(ParamCount + 1));
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

