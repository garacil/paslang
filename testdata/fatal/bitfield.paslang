{ GetBits of a field that reaches past the width stops the program
  (1.0.117): 8 bits from 25 need bits up to 32 of a UInt32. }
program bitfield;

var
  u: UInt32;
  n: Integer;

begin
  u := $FFFFFFFF;
  n := 25 + ParamCount;
  WriteLn('before');
  WriteLn(GetBits(u, n, 8));
  WriteLn('after');
end.
