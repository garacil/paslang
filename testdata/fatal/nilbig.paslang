{ P370: a block read through a nil pointer stops as a word read through
  one does, at its line, also one of 300 bytes, which rt_memcpy copies:
  r := p^ was taken for a zero value and gave zeros. }
program nilbig;

type
  TBig = record
    A: array[1..300] of Byte;
  end;
  PBig = ^TBig;

var
  r: TBig;
  p: PBig;

begin
  WriteLn('before');
  p := nil;
  r := p^;
  WriteLn(r.A[1]);
end.

