{ P639: a background routine does not keep the program alive, but main
  does while it has not ended: main parked for ever beside background
  routines parked for ever is a deadlock, said as any other. }
program dlbg;

var
  c: chan of Integer;
  started: waitgroup;

procedure Waiting;
var
  v: Integer;
begin
  started.Done;
  v := Recv(c);
end;

var
  v: Integer;

begin
  c := MakeChan();
  started.Add(2);
  pas background Waiting;
  pas background Waiting;
  started.Wait;
  WriteLn('before');
  v := Recv(c);
  WriteLn('after');
end.

