{ P207: a TJsonBuilder used by two routines at once ends the program,
  as a map written by two does. One adds a document of 300000 numbers
  over and over, each call long, while the other adds a null as fast
  as it can: a call that finds the other inside ends it. }
program jsonbusy;

var
  b, bb: TJsonBuilder;
  big, r: json;
  i, n: Integer;

procedure Copier;
var
  r: json;
begin
  while True do
    try
      b.BeginArray;
      b.Add(big);
      b.EndArray;
      r := b.Done;
    except
      on E: EJsonError do
        n := n + 1;
    end;
end;

begin
  WriteLn('before');
  bb := TJsonBuilder.Create;
  bb.BeginArray;
  for i := 1 to 300000 do
    bb.Add(i);
  bb.EndArray;
  big := bb.Done;
  b := TJsonBuilder.Create;
  pas Copier;
  for i := 1 to 100000000 do
    try
      b.AddNull;
    except
      on E: EJsonError do
        n := n + 1;
    end;
  WriteLn('after');
end.

