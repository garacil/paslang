{ P583: a capacity out of range says its number and the line and exits
  1 (1.0.136), with no SysUtils in the program. }
program chcap;

var
  c: chan of Integer;
  n: Integer;

begin
  n := -3 - ParamCount;
  WriteLn('before');
  c := MakeChan(n);
  WriteLn('after');
end.

