{ P316: the same for a static array from 1: the index changes between
  two fields and the second is checked again. }
program bkeepstat;

type
  T3 = record a, b, c: Integer; end;

var
  g: array[1..8] of T3;

procedure Walk(n: Integer);
var
  k: Integer;
begin
  k := 1;
  while k < n do
  begin
    g[k].a := k;
    k := k + 1;
    g[k].c := k;
  end;
end;

begin
  WriteLn('before');
  Walk(9 + ParamCount);
  WriteLn('after');
end.

