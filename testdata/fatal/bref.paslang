{ P87: a string passed by reference is checked against its own length. }
program bref;

procedure Show(const S: string; I: Integer);
begin
  WriteLn(Ord(S[I]));
end;

begin
  WriteLn('before');
  Show('ab' + 'c', 7 + ParamCount);
  WriteLn('after');
end.

