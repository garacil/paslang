{ P198: a string view of nil with a length above 0 stops, as Go's
  unsafe.String panics. }
program svnil;

var
  s: string;
  n: Integer;

begin
  n := 3 + ParamCount;
  WriteLn('before');
  s := PasStrView(nil, n);
  WriteLn(Length(s));
end.

