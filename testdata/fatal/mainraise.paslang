{ 1.0.147: an uncaught raise in the main routine ends the program with
  a line on the error output and exit status 1; in another routine it
  ends that routine alone and the program goes on (examples/bank). }
program mainraise;

var
  done: chan of Integer;

procedure Worker;
begin
  try
    raise;
  finally
    Send(done, 1);
  end;
  WriteLn('after');
end;

begin
  done := MakeChan(1);
  pas Worker;
  if Recv(done) = 1 then
    WriteLn('before');
  raise;
  WriteLn('after');
end.
