{ P370: Default(T) written through a nil pointer stops at its line: 300
  bytes, past the zeros written in line. }
program nilzero;

type
  TBig = record
    A: array[1..300] of Byte;
  end;
  PBig = ^TBig;

var
  p: PBig;

begin
  WriteLn('before');
  p := nil;
  p^ := Default(TBig);
  WriteLn(p^.A[1]);
end.

