{ P571: a constant index outside its array beside a call's value that
  waits in a register. The failure is written in place and stops the
  program with its line; the compiler stopped with an internal error
  there, since the failure's own lines named the register. }
program bconstleft;

var
  ga: array[0..4] of Integer;

function Rd(K: Integer): Integer;
begin
  Result := ga[K mod 5] + K;
end;

procedure Run;
var
  mb, mk, ma: Integer;
begin
  mk := 1;
  ma := 3;
  mb := (Rd(mk) or Rd(mk + 3)) and (ga[8] - ma);
  WriteLn(mb);
end;

begin
  WriteLn('before');
  Run;
  WriteLn('after');
end.

