{ P198: a string view past the end of the address space stops, as Go's
  unsafe.String panics. }
program svwrap;

var
  s: string;
  n: Integer;

begin
  n := 16 + ParamCount;
  WriteLn('before');
  s := PasStrView(Pointer(-8), n);
  WriteLn(Length(s));
end.

