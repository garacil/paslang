{ P208: a TJsonWriter used by two routines at once ends the program. One
  writes a value of 1 MiB to a pipe no one reads and parks inside its
  write once the pipe is full; the other writes too and finds it there,
  or parks first and is found: either way the program ends. }
program jsonwbusy;

uses
  paslinux;

type
  TFds = array[0..1] of Int32;

var
  f: TFds;
  w: TJsonWriter;
  big: string;

procedure Writer;
begin
  JsonWrite(w, big);
  WriteLn('written');
end;

begin
  WriteLn('before');
  f[0] := 0;
  f[1] := 0;
  if Amd64 = 1 then
    Syscall(293, @f[0], 524288 or ONonblock)
  else
    Syscall(59, @f[0], 524288 or ONonblock);
  big := StringOfChar('x', 1048576);
  w := JsonWriter(f[1]);
  pas Writer;
  Sleep(50);
  JsonWrite(w, 'small');
  WriteLn('after');
end.

