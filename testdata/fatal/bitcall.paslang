{ A bit number that calls a routine is checked by rt_bitget, at the
  line of the call (1.0.118). }
program bitcall;

var
  r: record A: Word; B: Byte; C: Int32 end;

function F: Integer;
begin
  Result := 70 + ParamCount;
end;

begin
  WriteLn('before');
  WriteLn(IsBitSet(r, F));
  WriteLn('after');
end.
