{ DivMod128 with a quotient past 64 bits stops the program (1.0.121). }
program divover;

var
  q, r, hi: Integer;

begin
  hi := 5 + ParamCount;
  WriteLn('before');
  DivMod128(hi, 0, 5, q, r);
  WriteLn(q);
end.

