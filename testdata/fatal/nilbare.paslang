{ P568: with no SysUtils in the program a nil pointer inside a try still
  ends it with its line: SysUtils is what turns a fault into an exception
  (P567's rule), and without it there is nothing to raise. }
program nilbare;

type
  PRec = ^TRec;
  TRec = record
    X: Integer;
  end;

var
  p: PRec;

begin
  p := PRec(Pointer(ParamCount * 0));
  WriteLn('before');
  try
    WriteLn(p^.X);
  except
    WriteLn('taken');
  end;
  WriteLn('after');
end.

