{ P313: an index v + c past a dynamic array's length stops the program
  before the store, v in a register and c in the displacement, and the
  report gives v + c. }
program bsumdyn;

var
  d: array of Integer;

procedure Fill(n: Integer);
var
  k: Integer;
begin
  for k := 0 to n do
    d[k + 2] := k;
end;

begin
  SetLength(d, 10);
  WriteLn('before');
  Fill(8 + ParamCount);
  WriteLn('after');
end.

