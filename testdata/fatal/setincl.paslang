{ P126: Include of an element out of the set's range stops the
  program, as a list's element does. }
program setincl;

type
  TSmall = set of 2..7;

var
  s: TSmall;
  i: Integer;

begin
  i := 1;
  s := [3];
  WriteLn('before');
  Include(s, i);
  WriteLn(3 in s);
end.

