{ P104: a slice past the slice's end stops at its line. }
program bslicehi;

var
  d, e: array of Integer;
  n: Integer;

begin
  SetLength(d, 5);
  n := 9 + ParamCount;
  WriteLn('before');
  e := d[2..n];
  WriteLn(Length(e));
end.

