{ P316: the length that changes between two fields of an element is
  checked again: SetLength leaves k past the end. }
program bkeepshrunk;

type
  T3 = record a, b, c: Integer; end;

var
  h: array of T3;

procedure Shrink(k: Integer);
begin
  h[k].a := k;
  SetLength(h, k);
  h[k].b := k;
end;

begin
  SetLength(h, 10);
  WriteLn('before');
  Shrink(3 + ParamCount);
  WriteLn('after');
end.

