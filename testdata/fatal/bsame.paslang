{ P100: d[i] := t[d[i]] checks the index once, at the load; out of
  range it still stops, before any write. }
program bsame;

var
  d: array of Byte;
  t: array[0..255] of Byte;
  i: Integer;

begin
  SetLength(d, 3);
  i := 3 + ParamCount;
  WriteLn('before');
  d[i] := t[d[i]];
  WriteLn('after');
end.
