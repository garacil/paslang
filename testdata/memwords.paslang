program memwords;

{ The memory words of P106 (1.0.123): fences, prefetches, the byte-order
  loads and stores at a pointer (aligned and not), StoreNT, and the
  atomic words on integers of every width; a spin lock of AtomicExchange
  and AtomicStore that eight routines share, and AtomicOr from eight
  routines on one word. }

var
  buf: array[0..15] of Byte;
  i, k, total: Integer;
  b: Byte;
  s8: Int8;
  w: Word;
  s32: Int32;
  lk: Integer;
  flags: Int32;
  done: chan of Integer;

procedure Worker(n: Integer);
var
  j: Integer;
begin
  for j := 1 to 1000 do
  begin
    while AtomicExchange(lk, 1) <> 0 do
      Pause;
    total := total + 1;
    AtomicStore(lk, 0);
  end;
  AtomicOr(flags, Int32(1 shl (n * 3)));
  Send(done, n);
end;

begin
  for i := 0 to 15 do
    buf[i] := Byte(i + 1);
  Prefetch(@buf);
  PrefetchWrite(@buf);
  FullFence;
  LoadFence;
  StoreFence;
  WriteLn(LoadBE32(@buf), ' ', LoadLE32(@buf), ' ', LoadBE16(@buf[1]), ' ', LoadLE16(@buf[1]));
  WriteLn(LoadBE64(@buf), ' ', LoadLE64(@buf[3]), ' ', CacheLine);
  StoreBE32(@buf[4], $A1B2C3D4);
  StoreLE16(@buf[9], $1234);
  StoreBE64(@buf[8], $0102030405060708);
  StoreLE32(@buf[1], $FFFFFFFE);
  for i := 0 to 15 do
    Write(buf[i], ' ');
  WriteLn;
  StoreNT(i, 5);
  b := 250;
  s8 := -3;
  w := 65535;
  s32 := -100;
  WriteLn(i, ' ', AtomicLoad(b), ' ', AtomicLoad(s8), ' ', AtomicLoad(w), ' ', AtomicLoad(s32));
  AtomicStore(s8, -128);
  AtomicStore(w, 7);
  WriteLn(s8, ' ', w, ' ', AtomicExchange(s8, 5), ' ', s8, ' ', AtomicExchange(b, 1), ' ', b);
  WriteLn(AtomicAnd(w, 6), ' ', w, ' ', AtomicOr(s32, 3), ' ', s32, ' ', AtomicXor(b, 255), ' ', b);
  WriteLn(AtomicOr(s8, -128), ' ', s8, ' ', AtomicXor(s32, -1), ' ', s32);
  done := MakeChan(8);
  total := 0;
  lk := 0;
  flags := 0;
  for i := 0 to 7 do
    pas Worker(i);
  k := 0;
  for i := 0 to 7 do
    k := k + Recv(done);
  WriteLn(total, ' ', flags, ' ', k);
end.

