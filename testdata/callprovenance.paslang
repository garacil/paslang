var K: Integer;
begin
  K := pasmap_result;
  WriteLn('pasmap expr ', R.N, ' ', R.Pad[1], ' ', R.Target^, ' ', A[1], ' ', S, ' ', M.LabelText, ' ', M.Items[0], ' ', Length(M.Items), ' ', D[0], ' ', Length(D));
end;

