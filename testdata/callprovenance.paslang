function ScalarValue(V: Integer): Integer;
begin
  pasheap_change;
  Result := V;
end;

begin
  Reset;
  ordinary_value(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  ordinary_expr(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  ordinary_const(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  ordinary_var(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasmap_value(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasmap_expr(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasmap_const(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasmap_var(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasfmt_value(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasfmt_expr(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasfmt_const(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasfmt_var(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasheap_value(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasheap_expr(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasheap_const(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasheap_var(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasquad_value(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasquad_expr(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasquad_const(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  pasquad_var(GRecord, GStatic, GString, GManaged, GSlice);
  Reset;
  SavedScalar := ScalarValue(GScalar);
  WriteLn('scalar value ', SavedScalar, ' ', GScalar);
  { P589_IMPORTED_RUNS }
end.
