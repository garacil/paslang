{ P589 value-parameter regression.
  The mutation call is the only user call inside each reader. Values
  retain inline fields and descriptors while pointers and slice elements
  retain sharing. Const and var parameters deliberately observe aliases.
  The checker inserts compiled helper imports at the two marked sites. }
program callprovenance;
{ P589_IMPORTS }
type
  PNumber = ^Integer;
  TStatic = array[0..2] of Integer;
  TSlice = array of Integer;
  TRecord = record
    N: Integer;
    Pad: TStatic;
    Target: PNumber;
  end;
  TManaged = record
    LabelText: string;
    Items: TSlice;
  end;
var
  GRecord: TRecord;
  GStatic: TStatic;
  GString: string;
  GManaged: TManaged;
  GSlice: TSlice;
  GPointed, GOther: Integer;
  GScalar: Integer;
  SavedScalar: Integer;

procedure Reset;
begin
  GScalar := 7;
  GPointed := 60;
  GOther := 62;
  GRecord.N := 7;
  GRecord.Pad[1] := 8;
  GRecord.Target := @GPointed;
  GStatic[1] := 9;
  GString := 'seed';
  GManaged.LabelText := 'managed';
  GManaged.Items := [10, 11];
  GSlice := [20, 21];
end;

procedure ApplyChange;
begin
  GScalar := 97;
  GRecord.N := 97;
  GRecord.Pad[1] := 98;
  GRecord.Target := @GOther;
  GStatic[1] := 99;
  GString := 'changed';
  GManaged.LabelText := 'changed';
  GManaged.Items[0] := 41;
  GManaged.Items := [49];
  GSlice[0] := 51;
  GSlice := [59];
  GPointed := 61;
end;

procedure ordinary_change;
begin
  ApplyChange;
end;
function ordinary_result: Integer;
begin
  ApplyChange;
  Result := 0;
end;

procedure ordinary_value(R: TRecord; A: TStatic; S: string; M: TManaged; D: TSlice);
begin
  ordinary_change;
  WriteLn('ordinary value ', R.N, ' ', R.Pad[1], ' ', R.Target^, ' ', A[1], ' ', S, ' ', M.LabelText, ' ', M.Items[0], ' ', Length(M.Items), ' ', D[0], ' ', Length(D));
end;

procedure ordinary_expr(R: TRecord; A: TStatic; S: string; M: TManaged; D: TSlice);
var K: Integer;
begin
  K := ordinary_result;
  WriteLn('ordinary expr ', R.N, ' ', R.Pad[1], ' ', R.Target^, ' ', A[1], ' ', S, ' ', M.LabelText, ' ', M.Items[0], ' ', Length(M.Items), ' ', D[0], ' ', Length(D));
end;

procedure ordinary_const(const R: TRecord; const A: TStatic; const S: string; const M: TManaged; const D: TSlice);
begin
  ordinary_change;
  WriteLn('ordinary const ', R.N, ' ', R.Pad[1], ' ', R.Target^, ' ', A[1], ' ', S, ' ', M.LabelText, ' ', M.Items[0], ' ', Length(M.Items), ' ', D[0], ' ', Length(D));
end;

procedure ordinary_var(var R: TRecord; var A: TStatic; var S: string; var M: TManaged; var D: TSlice);
begin
  ordinary_change;
  WriteLn('ordinary var ', R.N, ' ', R.Pad[1], ' ', R.Target^, ' ', A[1], ' ', S, ' ', M.LabelText, ' ', M.Items[0], ' ', Length(M.Items), ' ', D[0], ' ', Length(D));
end;

procedure pasmap_change;
begin
  ApplyChange;
end;
function pasmap_result: Integer;
begin
  ApplyChange;
  Result := 0;
end;

