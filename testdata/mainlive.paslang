{ P345: a global only the main block names lets its value go after the
  last statement of the block that names it, as a local of Go's main
  is dead after its last use (cmd/compile/internal/liveness/plive.go).
  big, eight megabytes read once, goes before the collection that
  follows; kept, named again in a later loop, is kept; seen, which a
  routine reads, and held, whose address a pointer keeps, stay too;
  text, a string, goes as big. Each is checked by what it still holds
  where it is read, and by the bytes alive. }
program mainlive;

type
  PArr = ^TArr;
  TArr = array of Integer;

var
  big, kept, seen, held: array of Integer;
  text: string;
  p: PArr;
  i, before, after, sum: Integer;

procedure Look;
begin
  sum := sum + Length(seen);
end;

procedure Collect;
var
  c: Integer;
begin
  c := 0;
  while c < 2 do
    if GcCollect = 1 then
      c := c + 1
    else
      Sleep(1);
end;

begin
  SetLength(big, 1000000);
  big[7] := 7;
  SetLength(kept, 1000);
  SetLength(seen, 1000);
  SetLength(held, 1000);
  p := @held;
  text := StringOfChar('x', 100000);
  Collect;
  before := HeapStat(1);
  sum := big[7] + Length(text);
  Collect;
  after := HeapStat(1);
  if before - after > 7000000 then
    WriteLn('big and text went after their last use')
  else
    WriteLn('big and text stayed: ', before - after, ' bytes fewer');
  for i := 0 to High(kept) do
    kept[i] := i;
  Look;
  WriteLn('kept ', kept[999], ', seen ', Length(seen), ', held ', Length(p^), ', sum ', sum);
end.
