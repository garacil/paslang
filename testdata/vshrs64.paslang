program vshrs64;

{ VShrS64 (1.0.136): every 64-bit lane shifted right with its sign, on
  V128 and V256, by a constant and by a variable count; a count past 63
  or negative fills with the sign. amd64 has no such instruction before
  AVX-512 and computes ((x shr c) xor m) - m; arm64 has sshr/sshl. }

var
  v: array[0..3] of Integer;
  a, r: V256;
  q, s: V128;
  cnt: array[0..8] of Integer;
  i, k, j: Integer;
  sum: Integer;

begin
  v[0] := -1;
  v[1] := Low(Integer);
  v[2] := 1234567890123;
  v[3] := -987654321987;
  for j := 0 to 3 do
    (a as array[0..3] of Integer)[j] := v[j];
  q := (a as array[0..1] of V128)[1];
  cnt[0] := 0;
  cnt[1] := 1;
  cnt[2] := 13;
  cnt[3] := 32;
  cnt[4] := 62;
  cnt[5] := 63;
  cnt[6] := 64;
  cnt[7] := 1000;
  cnt[8] := -1;
  for k := 0 to 8 do
  begin
    r := VShrS64(a, cnt[k]);
    s := VShrS64(q, cnt[k]);
    Write(cnt[k], ':');
    for j := 0 to 3 do
      Write(' ', (r as array[0..3] of Integer)[j]);
    for j := 0 to 1 do
      Write(' ', (s as array[0..1] of Integer)[j]);
    WriteLn;
  end;
  { constant counts }
  r := VShrS64(a, 0);
  WriteLn('c0 ', (r as array[0..3] of Integer)[3]);
  r := VShrS64(a, 7);
  WriteLn('c7 ', (r as array[0..3] of Integer)[1], ' ', (r as array[0..3] of Integer)[3]);
  s := VShrS64(q, 40);
  WriteLn('c40 ', (s as array[0..1] of Integer)[0], ' ', (s as array[0..1] of Integer)[1]);
  r := VShrS64(a, 64);
  WriteLn('c64 ', (r as array[0..3] of Integer)[2], ' ', (r as array[0..3] of Integer)[3]);
  { in a loop the pool keeps in registers }
  sum := 0;
  for i := 1 to 100 do
  begin
    r := VShrS64(a, i mod 70);
    sum := sum + (r as array[0..3] of Integer)[3] mod 1000;
  end;
  WriteLn('loop ', sum);
end.
