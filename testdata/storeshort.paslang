{ A file shorter than a store's header page that is not a store is
  refused and left as it was, with no log made beside it (1.1.1: it was
  taken for a new store and overwritten with an empty table). make
  check writes a short text file, runs this on it, and compares. }
program storeshort;

var
  db: store;

begin
  db := StoreOpen(ParamStr(1));
  WriteLn('opened ', ParamStr(1));
end.
