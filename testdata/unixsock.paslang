{ Unix-domain sockets (P117, 1.1.1): a stream server over a path and
  over an abstract name, with the peer's credentials; a datagram pair
  with the sender's name; a socket pair; a descriptor passed with a
  message and read through at the other end; a wait on several
  descriptors with a deadline. Everything on the loopback of this
  process, so the output is the same on every machine. }
program unixsock;

uses pasnet;

var
  done: WaitGroup;
  tmp: string;

function GetPid: Integer;
begin
  if Amd64 = 0 then
    Result := Syscall(172)
  else
    Result := Syscall(39);
end;

function GetUid: Integer;
begin
  if Amd64 = 0 then
    Result := Syscall(174)
  else
    Result := Syscall(102);
end;

procedure Serve(L: Integer; const Tag: string);
var
  c, pid, uid, grp: Integer;
  buf, line: string;
begin
  c := UnixAccept(L);
  if UnixPeer(c, pid, uid, grp) then
    WriteLn(Tag, ' peer is this process: ', pid = GetPid, ' ', uid = GetUid);
  buf := '';
  while TcpReadLine(c, buf, line) do
  begin
    if line = 'end' then
      Break;
    TcpWrite(c, Tag + ' got ' + line + #10);
  end;
  TcpClose(c);
  done.Done;
end;

procedure Talk(const Path, Tag: string);
var
  c: Integer;
  buf, line: string;
begin
  c := UnixConnect(Path);
  WriteLn(Tag, ' connected: ', c > 0);
  TcpWrite(c, 'one' + #10 + 'two' + #10 + 'end' + #10);
  buf := '';
  while TcpReadLine(c, buf, line) do
    WriteLn(line);
  TcpClose(c);
end;

var
  l, u1, u2, a, b, n, passed, k, fdA, fdB: Integer;
  data, from, s: string;
  fds: array of Integer;
begin
  tmp := '/tmp/paslang-unixsock-' + IntToStr(GetPid);
  { a server over a path }
  l := UnixListen(tmp);
  WriteLn('listening: ', l > 0);
  done.Add(1);
  pas Serve(l, 'path');
  Talk(tmp, 'path');
  done.Wait;
  UnixClose(l);
  UnixUnlink(tmp);
  { and over an abstract name }
  l := UnixListen('@paslang-unixsock-' + IntToStr(GetPid));
  done.Add(1);
  pas Serve(l, 'abstract');
  Talk('@paslang-unixsock-' + IntToStr(GetPid), 'abstract');
  done.Wait;
  UnixClose(l);
  { datagrams with the sender's name }
  u1 := UnixBind('@paslang-dgram-a-' + IntToStr(GetPid));
  u2 := UnixBind('@paslang-dgram-b-' + IntToStr(GetPid));
  n := UnixSendTo(u2, '@paslang-dgram-a-' + IntToStr(GetPid), 'hello over a datagram');
  data := UnixRecvFrom(u1, 64, from);
  WriteLn(n, ' ', data, ' from ', from = '@paslang-dgram-b-' + IntToStr(GetPid));
  UnixClose(u1);
  UnixClose(u2);
  { a pair, and a descriptor passed along it }
  WriteLn('pair: ', UnixPair(a, b));
  WriteLn('pair peer is this process: ', UnixPeer(a, n, k, passed) and (n = GetPid) and (k = GetUid));
  WriteLn(UnixPair(fdA, fdB));
  TcpWrite(fdB, 'through the passed descriptor');
  n := UnixSendFd(a, fdA, 'here is a descriptor');
  s := UnixRecvFd(b, 64, passed);
  WriteLn(n, ' ', s, ' ', passed > 0, ' ', passed <> fdA);
  s := TcpRead(passed, 64);
  WriteLn(s);
  { a wait on several: b has nothing, fdB gets a byte }
  SetLength(fds, 2);
  fds[0] := b;
  fds[1] := fdB;
  WriteLn('none ready: ', WaitAny(fds, 1, 30));
  TcpWrite(fdA, 'x');
  WriteLn('fdB ready: ', WaitAny(fds, 1, 1000));
  TcpWrite(a, 'y');
  WriteLn('b ready: ', WaitAny(fds, 1, 1000));
  UnixClose(a);
  UnixClose(b);
  UnixClose(fdA);
  UnixClose(fdB);
  UnixClose(passed);
end.

