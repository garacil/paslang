{ SetBit, ToggleBit and x := x op k on narrow globals between calls:
  one instruction of their width on the slot (1.0.117). }
program bitmem;
var b: Byte; w: Word; s32: Int32;
begin
  b := 1; w := 1; s32 := 7;
  SetBit(b, 3, 1);
  WriteLn(b);
  ToggleBit(w, 15);
  WriteLn(w);
  SetBit(s32, 1, 0);
  WriteLn(s32);
  b := b - 10;
  WriteLn(b);
end.
