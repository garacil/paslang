program inhcall;

type
  TBase = class
    function Kind: Integer;
    function Value(N: Integer): Integer; virtual;
    destructor Destroy; virtual;
  end;

  TChild = class(TBase)
    function Kind: Integer;
    function Value(N: Integer): Integer; override;
    destructor Destroy; override;
  end;

function TBase.Kind: Integer;
begin
  Result := 1;
end;

function TChild.Kind: Integer;
begin
  Result := inherited Kind + 10;
end;

function TBase.Value(N: Integer): Integer;
begin
  Result := N;
end;

function TChild.Value(N: Integer): Integer;
begin
  Result := inherited Value(N) + 2;
end;

destructor TBase.Destroy;
begin
  WriteLn(1);
end;

destructor TChild.Destroy;
begin
  inherited;
  WriteLn(2);
end;

var
  c: TChild;
  b: TBase;

begin
  c := TChild.Create;
  WriteLn(c.Kind);
  WriteLn(c.Value(5));
  b := c;
  WriteLn(b.Value(5));
  c.Destroy;
end.
