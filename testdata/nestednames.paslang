program nestednames;
{$mode delphi}{$H+}
type
  TConfig = record
  public
    const Base = 5;
    LabelText = 'cfg';
    type
      TKind = (Small, Big);
      TValue = array[0..Base - 1] of Byte;
      TPair = record A, B: Int64 end;
      PInner = ^TInner;
      TInner = record
        const Extra = Base + 7;
      public
        type TNum = Int64;
      public
        X: TNum;
        function Sum: TNum;
      end;
    const Seed: TPair = (A: 3; B: 4);
  strict private
    const Secret = 11;
  public
    Data: TValue;
    Kind: TKind;
    function Total: Int64;
    class function Choose: TKind; static;
  end;
  TBox = class
    const Base = 7;
    type TThing = class
      const Gain = 3;
    public
      Value: Int64;
      function GetValue: Int64;
    end;
  public
    Item: TThing;
    class function ReadBase: Int64; static;
  end;
  TChild = class(TBox)
    class function ReadGain: Int64; static;
  end;
  TConfigHelper = record helper for TConfig
    const Bonus = 9;
    type TCount = Int64;
    function Count: TCount;
  end;

function TConfig.TInner.Sum: TNum;
begin Result := X + Extra + Base end;
function TConfig.Total: Int64;
begin Result := Data[0] + Secret + Seed.A + Seed.B end;
class function TConfig.Choose: TKind;
begin Result := Big end;
function TBox.TThing.GetValue: Int64;
begin Result := Value + Gain + Base end;
class function TBox.ReadBase: Int64;
begin Result := Base end;
class function TChild.ReadGain: Int64;
begin Result := Base + TThing.Gain end;
function TConfigHelper.Count: TCount;
begin Result := Base + Bonus + Data[0] end;

var
  R: TConfig;
  Inner: TConfig.TInner;
  P: TConfig.PInner;
  C: TConfig.TCount;
  O: TBox.TThing;
  E: TChild.TThing;
begin
  R.Data[0] := 8;
  R.Kind := TConfig.Choose;
  Inner.X := 10;
  P := @Inner;
  C := R.Count;
  O := TBox.TThing.Create;
  O.Value := 20;
  E := TChild.TThing.Create;
  E.Value := 30;
  WriteLn('record ', TConfig.Base, ' ', TConfig.LabelText, ' ', SizeOf(TConfig.TValue), ' ',
    Ord(R.Kind), ' ', R.Total, ' ', C, ' ', TConfig.Bonus);
  WriteLn('inner ', Inner.Sum, ' ', P^.Sum, ' ', TConfig.TInner.Extra, ' ',
    SizeOf(TConfig { qualifier comments are tokens too }. TInner . TNum));
  WriteLn('class ', TBox.ReadBase, ' ', TChild.ReadGain, ' ', O.GetValue, ' ', E.GetValue);
  O.Free;
  E.Free;
end.
