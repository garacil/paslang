program parammodes;
function F(S:string):Integer;
overload;
begin Result:=Length(S);
end;
function F(N:Integer):Integer;
overload;
begin Result:=N+1;
end;
function F(var N:Integer):Integer;
overload;
begin Inc(N);
Result:=N;
end;
begin WriteLn(F('abc'));
end.
