program helpertags;
type H_A=type helper for Integer function B:Integer;
end;
H=type helper for Boolean function A_B:Integer;
end;
function H_A.B:Integer;
begin Result:=Self+1;
end;
function H.A_B:Integer;
begin if Self then Result:=43 else Result:=0;
end;
var X:Integer;
Y:Boolean;
begin X:=41;
Y:=True;
WriteLn(X.B,' ',Y.A_B);
end.
