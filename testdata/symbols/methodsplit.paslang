program methodsplit;
type T_A = class function B: Integer;
end;
T = class function A_B: Integer;
end;
function T_A.B: Integer;
begin Result := 17;
end;
function T.A_B: Integer;
begin Result := 19;
end;
var X:T_A;
Y:T;
begin X:=T_A.Create;
Y:=T.Create;
WriteLn(X.B,' ',Y.A_B);
X.Free;
Y.Free;
end.
