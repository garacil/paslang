program optags;
type T_A=record V:Integer;
end;
B=record V:Integer;
end;
T=record V:Integer;
end;
A_B=record V:Integer;
end;
operator +(X:T_A;Y:B):Integer;
begin Result:=X.V+Y.V;
end;
operator +(X:T;Y:A_B):Integer;
begin Result:=X.V+Y.V+10;
end;
var X:T_A;
Y:B;
Z:T;
W:A_B;
begin X.V:=19;
Y.V:=28;
Z.V:=20;
W.V:=23;
WriteLn(X+Y,' ',Z+W);
end.
