unit bridge;
interface
uses types_a, types_a_b;
type TA = types_a.B_C;
     TB = types_a_b.C;
function MakeA: TA;
function MakeB: TB;
implementation
function MakeA: TA;
begin Result := TA.Create; end;
function MakeB: TB;
begin Result := TB.Create; end;
end.
