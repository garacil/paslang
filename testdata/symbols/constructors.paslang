program constructors;
uses pasast;
const
  Names: array[0..9] of string =
    ('', 'A', 'a', '_', 'a_', '_a', 'a_b', 'a__b', 'a.b', '12_x');
var I, J: Integer; Parent, Stem: string;
begin
  for I := 0 to 9 do
    for J := 0 to 9 do
    begin
      Parent := ProcSym(Names[I], Names[J]);
      Stem := TypeSym(Names[I], Names[J], False);
      WriteLn(Parent);
      WriteLn(Stem);
      WriteLn(MethodSym(Stem, 'M_a'));
      WriteLn(NestedSym(Parent, 'B_c'));
      WriteLn(AnonSym(Parent, I * 10 + J));
      WriteLn(OperatorSym(Names[I], '', 'add', Names[J], 'rhs'));
      WriteLn(TypeSym(Parent, 'T_a', True));
    end;
  WriteLn(OverParamSym(TyString, False));
  WriteLn(OverParamSym(TyString, True));
end.
