program lifetags;
var Calls:Integer;
type T=class class constructor Boot;
class procedure Boot_cc;
static;
end;
class constructor T.Boot;
begin Inc(Calls);
end;
class procedure T.Boot_cc;
begin Calls:=Calls+10;
end;
begin T.Boot_cc;
WriteLn(Calls);
end.
