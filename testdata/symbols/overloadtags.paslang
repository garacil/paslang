program overloadtags;
function F(N:Integer):Integer;
overload;
begin Result:=N+1;
end;
function F(S:string):Integer;
overload;
begin Result:=Length(S)+3;
end;
function F_o_3:Integer;
begin Result:=47;
end;
function F_o_v3:Integer;
begin Result:=49;
end;
begin WriteLn(F(2),' ',F('ab'),' ',F_o_3,' ',F_o_v3);
end.
