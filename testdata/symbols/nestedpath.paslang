program nestedpath;
function A: Integer;
  function B_C: Integer;
  begin Result := 71; end;
  function B: Integer;
    function C: Integer;
    begin Result := 73; end;
  begin Result := C; end;
begin Result := B_C + B; end;
begin WriteLn(A); end.
