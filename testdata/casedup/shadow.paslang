program caseshadow;

const Limit = 3;
type NumberType = Integer;
var Total, Same: Integer;

procedure Shared;
begin
  WriteLn('global procedure');
end;

procedure Outer(Counter: Integer);
const shared = 4;
var total, Same: Integer;

  procedure Inner(coUNTER: Integer);
  var TOTAL, limit, numbertype: Integer;
  begin
    TOTAL := 5;
    limit := 6;
    numbertype := 7;
    WriteLn(TOTAL, ' ', limit, ' ', numbertype, ' ', coUNTER);
  end;

begin
  total := 2;
  Same := 9;
  Inner(Counter);
  WriteLn(total, ' ', Same, ' ', shared);
end;

begin
  Total := 1;
  Same := 10;
  Outer(8);
  Shared;
  WriteLn(Total, ' ', Same, ' ', Limit);
end.
