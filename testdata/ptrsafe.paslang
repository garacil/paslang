program ptrsafe;

{ safe before a routine, a unit or a program forbids raw pointer work in
  it (P102): arithmetic, views, conversions between pointer types,
  Pointer(n), an untyped p^, p[i]. New, p^ of a typed pointer, @x, nil,
  comparisons, arrays, strings, classes and slices stay. Code that is
  not safe keeps it all. The errors: testdata/safebad. }

type
  PNode = ^TNode;
  TNode = record
    V: Integer;
    Next: PNode;
  end;
  TBox = class
    N: Integer;
    safe function Twice: Integer;
  end;

safe function TBox.Twice: Integer;
begin
  Result := N * 2;
end;

safe function Sum(List: PNode): Integer;
var
  p: PNode;
begin
  Result := 0;
  p := List;
  while p <> nil do
  begin
    Result := Result + p^.V;
    p := p^.Next;
  end;
end;

safe procedure Build(var List: PNode; N: Integer);
var
  i: Integer;
  q: PNode;
  a: array of Integer;
  s: string;

  function Last: Integer;
  begin
    Result := a[High(a)];
  end;

begin
  SetLength(a, N);
  for i := 0 to N - 1 do
    a[i] := i * i;
  for i := 0 to N - 1 do
  begin
    New(q);
    q^.V := a[i];
    q^.Next := List;
    List := q;
  end;
  s := 'safe';
  WriteLn(s[1], Length(s), ' ', Last, ' ', @a[0] = @a[0]);
end;

{ Not safe: the raw work is allowed here. }
function Raw(var A: array of Integer): Integer;
var
  p: PInteger;
begin
  p := @A[0];
  p := p + 2;
  Result := p^ + PByte(@A[1])^;
end;

var
  list: PNode;
  b: TBox;
  xs: array of Integer;

begin
  list := nil;
  Build(list, 10);
  WriteLn(Sum(list));
  b := TBox.Create;
  b.N := 21;
  WriteLn(b.Twice);
  SetLength(xs, 4);
  xs[1] := 258;
  xs[2] := 40;
  WriteLn(Raw(xs));
end.

