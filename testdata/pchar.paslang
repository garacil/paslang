{ A dereferenced ^Char loads and stores one byte, also under Ord. }
program pchar;

type
  PCh = ^Char;
  PInt = ^Integer;

var
  p: Pointer;
  c: PCh;
  w: PInt;

begin
  GetMem(p, 16);
  w := PInt(p);
  w^ := -1;                        { every byte is 255 }
  c := PCh(Integer(p) + 2);
  c^ := 'A';                       { one byte changes }
  WriteLn(Ord(c^));                { 65 }
  WriteLn(c^ = 'A');
  WriteLn(w^ = -1);
  c := PCh(Integer(p) + 8);
  WriteLn(Ord(c^));                { untouched: 0 }
end.
