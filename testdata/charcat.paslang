{ Char + Char is a string, as in every Pascal (1.0.53). paslangc added
  the two codes: a + b printed 102 for '4' and '2', and s := a + b left
  s empty without a word. }
program charcat;

var
  a, b: Char;
  s: string;

begin
  a := '4';
  b := '2';
  s := a + b;
  WriteLn('[', s, ']');
  WriteLn('[', a + b, ']');
  WriteLn(Chr(52) + Chr(50) + '!', ' ', Length(a + b + a));
  WriteLn(Ord(a) + Ord(b));
end.

