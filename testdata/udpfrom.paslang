{ P215 (1.1.101): UdpRecvFrom and UdpRecvFromMs are one body, so they
  name the same sender the same way: an IPv6 one by its address without
  brackets, an IPv4 one as a dotted quad, the port of the socket that
  sent. An empty datagram is '' with its sender for both words; a
  deadline with nothing is '' with no sender. Before, UdpRecvFromMs
  named only IPv4 senders and took an empty datagram for none. Each
  read has room for 64 KiB and what came holds a small block (P222).
  Main runs the cases, then a routine does while main goes on. }
program udpfrom;

uses
  pasnet;

var
  done, ticks: Integer;

{ A string's block is 32 bytes or less: the byte before its characters
  is its mark; the empty string has no block }
function Small(const S: string): Boolean;
begin
  Result := (S = '') or (MemSize(PByte(Pointer(S)) - 1) <= 32);
end;

procedure Both(const What, Host, Data: string);
var
  r, s, port, port2, n: Integer;
  got, got2, from, from2: string;
begin
  r := UdpBindAt(Host, 0);
  s := UdpBindAt(Host, 0);
  if (r < 0) or (s < 0) then
    Halt(2);
  n := UdpSendTo(s, Host, UdpPort(r), Data);
  got := UdpRecvFrom(r, 65536, from, port);
  n := n + UdpSendTo(s, Host, UdpPort(r), Data);
  got2 := UdpRecvFromMs(r, 65536, 2000, from2, port2);
  WriteLn('  ', What, ': sent ', n, ', ', got = Data, ' ', got2 = Data, ', from ', from, ' and ',
    from2, ', the sender''s port ', port = UdpPort(s), ' ', port2 = UdpPort(s),
    ', small ', Small(got) and Small(got2));
  UdpClose(r);
  UdpClose(s);
end;

procedure Cases(const Where: string);
var
  r, port: Integer;
  got, from: string;
begin
  WriteLn(Where);
  Both('IPv6', '::1', 'six');
  Both('IPv4', '127.0.0.1', 'four');
  Both('IPv6, empty', '::1', '');
  Both('IPv4, empty', '127.0.0.1', '');
  r := UdpBindAt('::1', 0);
  got := UdpRecvFromMs(r, 64, 20, from, port);
  WriteLn('  nothing in 20 ms: ', got = '', ' ', from = '', ' ', port);
  UdpClose(r);
end;

procedure InRoutine;
begin
  Cases('in a routine');
  AtomicAdd(@done, 1);
end;

begin
  Cases('in main');
  pas InRoutine;
  while AtomicAdd(@done, 0) = 0 do
  begin
    Sleep(1);
    Inc(ticks);
  end;
  WriteLn('main ticked while the routine waited ', ticks > 0);
end.

