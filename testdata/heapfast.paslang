{ P492: a heap of 8-byte integers sifts on the words themselves. The expected output
  was made by the compiler before: pushes and pops mixed at random into heaps of
  Integer (negative values, duplicates, the extremes), of Byte, Int32, Double and
  string (which keep the general sifts), and of Integer pushed in order, in reverse and
  all alike; every popped value folded into a hash, the count left and Low at the end. }
program heapfast;

uses
  sysutils;

var
  seed: Int64;

function Next: Int64;
begin
  seed := seed * 6364136223846793005 + 1442695040888963407;
  Result := seed;
end;

procedure IntHeap(Mode, N: Integer);
var
  h: heap of Integer;
  i, j, k: Integer;
  v, hh, last: Int64;
begin
  New(h);
  hh := 11 + Mode;
  for i := 1 to N do
  begin
    case Mode of
      0: v := Next shr 20;
      1: v := Next;
      2: v := i;
      3: v := N - i;
      4: v := 7;
      5: v := (Next shr 40) mod 5 - 2;
    else
      v := Next mod 1000;
    end;
    Push(h, v);
    if (Next shr 61) < 3 then
    begin
      k := Integer((Next shr 59) mod 4);
      for j := 1 to k do
        if Length(h) > 0 then
        begin
          last := Pop(h);
          hh := hh * 1000003 + last + (hh shr 31);
        end;
    end;
  end;
  last := 0;
  if Length(h) > 0 then
    last := Low(h);
  while Length(h) > 0 do
    hh := hh * 1000003 + Pop(h) + (hh shr 31);
  WriteLn('integer mode ', Mode, ' n ', N, ' last low ', last, ' hash ', hh);
end;

procedure ByteHeap(N: Integer);
var
  h: heap of Byte;
  i: Integer;
  hh: Int64;
begin
  New(h);
  hh := 5;
  for i := 1 to N do
    Push(h, Byte(Next shr 50));
  while Length(h) > 0 do
    hh := hh * 1000003 + Pop(h) + (hh shr 31);
  WriteLn('byte ', N, ' ', hh);
end;

procedure RealHeap(N: Integer);
var
  h: heap of Double;
  i: Integer;
  hh: Int64;
  d: Double;
  b: Int64;
begin
  New(h);
  hh := 6;
  for i := 1 to N do
    Push(h, (Next shr 11) / 9007199254740992.0 - 0.5);
  while Length(h) > 0 do
  begin
    d := Pop(h);
    b := 0;
    Move(d, b, 8);
    hh := hh * 1000003 + b + (hh shr 31);
  end;
  WriteLn('double ', N, ' ', hh);
end;

procedure StrHeap(N: Integer);
var
  h: heap of string;
  i: Integer;
  hh: Int64;
  s: string;
  j: Integer;
begin
  New(h);
  hh := 7;
  for i := 1 to N do
    Push(h, 'k' + IntToStr((Next shr 50) mod 1000));
  while Length(h) > 0 do
  begin
    s := Pop(h);
    for j := 1 to Length(s) do
      hh := hh * 31 + Ord(s[j]);
    hh := hh xor (hh shr 29);
  end;
  WriteLn('string ', N, ' ', hh);
end;

var
  m: Integer;
begin
  seed := 20261028;
  for m := 0 to 6 do
  begin
    IntHeap(m, 1);
    IntHeap(m, 2);
    IntHeap(m, 3);
    IntHeap(m, 100);
    IntHeap(m, 20000);
  end;
  ByteHeap(5000);
  RealHeap(5000);
  StrHeap(3000);
end.
