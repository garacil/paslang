program bareln;

{ Write and WriteLn without parentheses, as in every Pascal: a bare
  WriteLn ends the line, a bare Write writes nothing (1.0.49). }
var
  i: Integer;
begin
  Write('a');
  WriteLn;
  Write;
  WriteLn('b');
  WriteLn();
  for i := 1 to 3 do
    if i = 2 then
      WriteLn
    else
      Write(i);
  WriteLn
end.

