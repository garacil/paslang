program excg;

var
  c: chan of Integer;
  x: Integer;

procedure Boom;
begin
  Raise;
end;

procedure Ok;
begin
  WriteLn(3);
  Send(c, 1);
end;

begin
  c := MakeChan();
  pas Boom;
  pas Ok;
  x := Recv(c);
  WriteLn(2);
end.

