program trig;

var
  p: Real;

begin
  WriteLn(Sqrt(0));
  WriteLn(Sqrt(1));
  WriteLn(Sqrt(4));
  WriteLn(Sqrt(9));
  WriteLn(Sqrt(2));
  p := 3.141592653589793;
  WriteLn(Sin(0));
  WriteLn(Cos(0));
  WriteLn(Sin(p / 6));
  WriteLn(Cos(p / 3));
  WriteLn(Sin(p / 2));
  WriteLn(Cos(p / 2));
  WriteLn(Sin(p));
  WriteLn(Cos(p));
  WriteLn(Sin(-p / 2));
  WriteLn(Sin(1));
  WriteLn(Cos(1));
end.

