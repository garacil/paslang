{ P505: a stack that moved stays for the next move. Under PASLANG_GCVERIFY
  every cycle of the collector moves the stack of every routine to a new
  place at the same size; the old stack used to be unmapped and a new one
  mapped for the next move, and now the old one, its used part poisoned, is
  kept and the next move at its size takes it. Here six routines walk a
  recursion that grows their stacks round after round (each round deeper
  than the one before, so a stack of the old size is waiting when the size
  doubles). Every frame holds a string, a buffer of four kilobytes and a pad
  of integers, and the first frame's integer is reached through a var
  parameter from every depth. The buffers make the cycles run; the sum each
  routine gets does not depend on where its stack is. }
program stkpool;

const
  Routines = 6;
  Rounds = 4;
  PadLen = 24;

var
  done: WaitGroup;
  sums: array[0..Routines - 1] of Integer;

function IStr(N: Integer): string;
var
  d: string;
begin
  d := '';
  if N = 0 then
    d := '0';
  while N > 0 do
  begin
    d := Chr(48 + N mod 10) + d;
    N := N div 10;
  end;
  Result := d;
end;

procedure Walk(N: Integer; var Acc: Integer);
var
  s: string;
  buf: array of Integer;
  pad: array[0..PadLen - 1] of Integer;
  i: Integer;
begin
  s := 'n' + IStr(N);
  SetLength(buf, 512);
  buf[N mod 512] := N;
  for i := 0 to PadLen - 1 do
    pad[i] := N + i;
  if N > 0 then
    Walk(N - 1, Acc);
  Acc := Acc + Length(s) + pad[N mod PadLen] - N - (N mod PadLen) + buf[N mod 512] - N;
end;

procedure Run(K: Integer);
var
  r, acc: Integer;
begin
  acc := 0;
  for r := 1 to Rounds do
    Walk(100 + 90 * K + 20 * r, acc);
  sums[K] := acc;
  done.Done;
end;

var
  k, total: Integer;
begin
  done.Add(Routines);
  for k := 0 to Routines - 1 do
    pas Run(k);
  done.Wait;
  total := 0;
  for k := 0 to Routines - 1 do
  begin
    WriteLn('routine ', k, ' ', sums[k]);
    total := total + sums[k];
  end;
  WriteLn('total ', total);
end.

