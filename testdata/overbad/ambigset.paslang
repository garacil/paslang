program ambigset;
type
  TCS = set of Char;
function G(S: TCS): string; overload;
begin
  Result := 'set';
end;
function G(const Xs: array of const): string; overload;
begin
  Result := 'const';
end;
begin
  WriteLn(G(['a', 'b']));
end.

