program ambigptr;
type
  IThing = interface
    function Id: Int64;
  end;
  TThing = class(TObject, IThing)
    function Id: Int64;
  end;
function TThing.Id: Int64;
begin
  Result := 1;
end;
function F(T: IThing): string; overload;
begin
  Result := 'thing';
end;
function F(P: Pointer): string; overload;
begin
  Result := 'pointer';
end;
begin
  WriteLn(F(TThing.Create));
end.

