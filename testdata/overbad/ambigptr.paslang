program ambigptr;

type
  IThing = interface
    function Id: Int64;
  end;
  IOther = interface
    function Id: Int64;
  end;
  TThing = class(TObject, IThing, IOther)
    function Id: Int64;
  end;

function TThing.Id: Int64;
begin
  Result := 1;
end;

function F(T: IThing): string; overload;
begin
  Result := 'thing';
end;

function F(T: IOther): string; overload;
begin
  Result := 'other';
end;

begin
  WriteLn(F(TThing.Create));
end.
