program ambigref;

type
  TBase = class
  end;
  TKid = class(TBase)
  end;
  TGrand = class(TKid)
  end;
  TBaseClass = class of TBase;
  TKidClass = class of TKid;

function H(K: TBaseClass; J: TKidClass): string; overload;
begin
  Result := 'base kid';
end;

function H(K: TKidClass; J: TBaseClass): string; overload;
begin
  Result := 'kid base';
end;

begin
  WriteLn(H(TGrand, TGrand));
end.
