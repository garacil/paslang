program loops;

var
  i, s: Integer;

begin
  s := 0;
  i := 1;
  while i <= 5 do
  begin
    s := s + i;
    i := i + 1;
  end;
  WriteLn(s);
  s := 0;
  for i := 1 to 4 do
    s := s + i;
  WriteLn(s);
  s := 0;
  i := 1;
  repeat
    s := s + i;
    i := i + 1;
  until i > 3;
  WriteLn(s);
end.

