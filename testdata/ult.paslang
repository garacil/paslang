  if t then c := c or 128;
  if (Low(Int64) xor M) < (a xor M) then c := c or 256;
  if (Low(Int64) xor M) <= (a xor M) then c := c or 512;
  if (Low(Int64) xor M) > (a xor M) then c := c or 1024;
  if (Low(Int64) xor M) >= (a xor M) then c := c or 2048;
  t := (Low(Int64) xor M) < (a xor M);
  if t then c := c or 4096;
  t := (Low(Int64) xor M) <= (a xor M);
  if t then c := c or 8192;
  t := (Low(Int64) xor M) > (a xor M);
  if t then c := c or 16384;
  t := (Low(Int64) xor M) >= (a xor M);
  if t then c := c or 32768;
  if not ((a xor M) < (Low(Int64) xor M)) then c := c or 65536;
  if (a xor M) < (Low(Int64) xor M) then
    c := c or 0
  else
    c := c or 131072;
  if ULt(a, Low(Int64)) = RefLt(a, Low(Int64)) then c := c or 262144;
  if Ord(ULt(Low(Int64), a)) = Ord(RefLt(Low(Int64), a)) then c := c or 524288;
  Check(c, Expect(a, Low(Int64)) and 1048575, a, Low(Int64));
  c := 0;
  if (a xor M) < (Low(Int64) + 1 xor M) then c := c or 1;
  if (a xor M) <= (Low(Int64) + 1 xor M) then c := c or 2;
  if (a xor M) > (Low(Int64) + 1 xor M) then c := c or 4;
  if (a xor M) >= (Low(Int64) + 1 xor M) then c := c or 8;
  t := (a xor M) < (Low(Int64) + 1 xor M);
  if t then c := c or 16;
  t := (a xor M) <= (Low(Int64) + 1 xor M);
  if t then c := c or 32;
  t := (a xor M) > (Low(Int64) + 1 xor M);
  if t then c := c or 64;
  t := (a xor M) >= (Low(Int64) + 1 xor M);
  if t then c := c or 128;
  if (Low(Int64) + 1 xor M) < (a xor M) then c := c or 256;
  if (Low(Int64) + 1 xor M) <= (a xor M) then c := c or 512;
  if (Low(Int64) + 1 xor M) > (a xor M) then c := c or 1024;
  if (Low(Int64) + 1 xor M) >= (a xor M) then c := c or 2048;
  t := (Low(Int64) + 1 xor M) < (a xor M);
  if t then c := c or 4096;
  t := (Low(Int64) + 1 xor M) <= (a xor M);
  if t then c := c or 8192;
  t := (Low(Int64) + 1 xor M) > (a xor M);
  if t then c := c or 16384;
  t := (Low(Int64) + 1 xor M) >= (a xor M);
  if t then c := c or 32768;
  if not ((a xor M) < (Low(Int64) + 1 xor M)) then c := c or 65536;
  if (a xor M) < (Low(Int64) + 1 xor M) then
    c := c or 0
  else
    c := c or 131072;
  if ULt(a, Low(Int64) + 1) = RefLt(a, Low(Int64) + 1) then c := c or 262144;
  if Ord(ULt(Low(Int64) + 1, a)) = Ord(RefLt(Low(Int64) + 1, a)) then c := c or 524288;
  Check(c, Expect(a, Low(Int64) + 1) and 1048575, a, Low(Int64) + 1);
  c := 0;
  if (a xor M) < (-2 xor M) then c := c or 1;
  if (a xor M) <= (-2 xor M) then c := c or 2;
  if (a xor M) > (-2 xor M) then c := c or 4;
  if (a xor M) >= (-2 xor M) then c := c or 8;
  t := (a xor M) < (-2 xor M);
  if t then c := c or 16;
  t := (a xor M) <= (-2 xor M);
  if t then c := c or 32;
  t := (a xor M) > (-2 xor M);
  if t then c := c or 64;
  t := (a xor M) >= (-2 xor M);
  if t then c := c or 128;
  if (-2 xor M) < (a xor M) then c := c or 256;
  if (-2 xor M) <= (a xor M) then c := c or 512;
  if (-2 xor M) > (a xor M) then c := c or 1024;
  if (-2 xor M) >= (a xor M) then c := c or 2048;
  t := (-2 xor M) < (a xor M);
  if t then c := c or 4096;
  t := (-2 xor M) <= (a xor M);
  if t then c := c or 8192;
  t := (-2 xor M) > (a xor M);
  if t then c := c or 16384;
  t := (-2 xor M) >= (a xor M);
  if t then c := c or 32768;
  if not ((a xor M) < (-2 xor M)) then c := c or 65536;
  if (a xor M) < (-2 xor M) then
    c := c or 0
  else
    c := c or 131072;
  if ULt(a, -2) = RefLt(a, -2) then c := c or 262144;
  if Ord(ULt(-2, a)) = Ord(RefLt(-2, a)) then c := c or 524288;
  Check(c, Expect(a, -2) and 1048575, a, -2);
  c := 0;
  if (a xor M) < (-1 xor M) then c := c or 1;
  if (a xor M) <= (-1 xor M) then c := c or 2;
  if (a xor M) > (-1 xor M) then c := c or 4;
  if (a xor M) >= (-1 xor M) then c := c or 8;
  t := (a xor M) < (-1 xor M);
  if t then c := c or 16;
  t := (a xor M) <= (-1 xor M);
  if t then c := c or 32;
  t := (a xor M) > (-1 xor M);
  if t then c := c or 64;
  t := (a xor M) >= (-1 xor M);
  if t then c := c or 128;
  if (-1 xor M) < (a xor M) then c := c or 256;
  if (-1 xor M) <= (a xor M) then c := c or 512;
  if (-1 xor M) > (a xor M) then c := c or 1024;
  if (-1 xor M) >= (a xor M) then c := c or 2048;
  t := (-1 xor M) < (a xor M);
  if t then c := c or 4096;
  t := (-1 xor M) <= (a xor M);
  if t then c := c or 8192;
  t := (-1 xor M) > (a xor M);
  if t then c := c or 16384;
  t := (-1 xor M) >= (a xor M);
  if t then c := c or 32768;
  if not ((a xor M) < (-1 xor M)) then c := c or 65536;
  if (a xor M) < (-1 xor M) then
    c := c or 0
  else
    c := c or 131072;
  if ULt(a, -1) = RefLt(a, -1) then c := c or 262144;
  if Ord(ULt(-1, a)) = Ord(RefLt(-1, a)) then c := c or 524288;
  Check(c, Expect(a, -1) and 1048575, a, -1);
end;

{ the order in loops: i counts up to n below it as words }
function CountUp(n: Int64): Int64;
var
  i: Int64;
begin
  i := 0;
  while (i xor M) < (n xor M) do
    Inc(i);
  Result := i;
end;

function CountRepeat(n: Int64): Int64;
var
  i: Int64;
begin
  i := 0;
  repeat
    Inc(i);
  until (i xor M) >= (n xor M);
  Result := i;
end;

function CountConst: Int64;
var
  i: Int64;
begin
  i := 0;
  while (i xor M) < (100 xor M) do
    Inc(i);
  Result := i;
end;

begin
  V[0] := 0;
  V[1] := 1;
  V[2] := 2;
  V[3] := 7;
  V[4] := 4095;
  V[5] := 4096;
  V[6] := 65535;
  V[7] := 2147483647;
  V[8] := 2147483648;
  V[9] := 4294967296;
  V[10] := 4611686018427387904;
  V[11] := 9223372036854775807;
  V[12] := Low(Int64);
  V[13] := Low(Int64) + 1;
  V[14] := -2;
  V[15] := -1;
  bad := 0;
  cells := 0;
  for i := 0 to 15 do
  begin
    row := '';
    for j := 0 to 15 do
    begin
      Vars(V[i], V[j]);
      if (V[i] xor M) < (V[j] xor M) then
      begin
        row := row + '1';
        Inc(cells);
      end
      else
        row := row + '0';
    end;
    Consts(V[i]);
    WriteLn(row);
  end;
  for n := 0 to 13 do
    for i := 0 to 15 do
    begin
      row := '';
      for j := 0 to 15 do
        if Other(V[i], V[j], n) then
          row := row + '1'
        else
          row := row + '0';
      WriteLn(row);
    end;
  steps := CountUp(300) + CountRepeat(1000) + CountConst;
  WriteLn('below ', cells);
  WriteLn('loops ', steps);
  WriteLn('mismatches ', bad);
end.

