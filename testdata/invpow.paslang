program invpow;

begin
  WriteLn(ArcSin(0));
  WriteLn(ArcSin(0.5));
  WriteLn(ArcSin(1));
  WriteLn(ArcSin(-1));
  WriteLn(ArcSin(-0.5));
  WriteLn(ArcCos(0));
  WriteLn(ArcCos(0.5));
  WriteLn(ArcCos(1));
  WriteLn(ArcCos(-1));
  WriteLn(ArcCos(-0.5));
  WriteLn(Power(2, 3));
  WriteLn(Power(2, 10));
  WriteLn(Power(-2, 3));
  WriteLn(Power(-2, 2));
  WriteLn(Power(2, -1));
  WriteLn(Power(-2, -1));
  WriteLn(Power(0, 0));
  WriteLn(Power(0, 3));
  WriteLn(Power(9, 0.5));
  WriteLn(Power(4, 0.5));
  WriteLn(Power(10, 0));
  WriteLn(Power(2, 0.5));
  WriteLn(Power(0.5, 2));
end.
