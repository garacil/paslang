{ P95c: a routine whose stack grew keeps its heap. On arm64 the stack
  that grew was copied and never adjusted: the first return past the
  copy went back to the old stack, whose addresses are not the routine's
  any more, so every allocation after it went to the persistent heap and
  no cycle ever took it back. Here each routine grows its stack, returns,
  and then makes garbage enough for cycles to run; a string made after
  the growth must survive them. }
program growgc;

function IStr(N: Integer): string;
var
  d: string;
begin
  d := '';
  if N = 0 then
    d := '0';
  while N > 0 do
  begin
    d := Chr(48 + N mod 10) + d;
    N := N div 10;
  end;
  Result := d;
end;

function Down(N: Integer): Integer;
var
  pad: array[0..31] of Integer;
begin
  pad[N mod 32] := N;
  if N = 0 then
    Result := 0
  else
    Result := Down(N - 1) + pad[N mod 32] - N;
end;

procedure Work(K: Integer);
var
  s, t: string;
  i, c0: Integer;
begin
  i := Down(40000);
  s := 'kept ' + IStr(K) + ' ' + IStr(i);
  c0 := HeapStat(0);
  t := '';
  for i := 1 to 60000 do
    t := IStr(i) + Copy(t, 1, 200);
  WriteLn(s, ' ', Length(t), ' collected ', HeapStat(0) > c0);
end;

begin
  Work(1);
  pas Work(2);
end.
