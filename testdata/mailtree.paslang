{ P433: pasmime's message tree against Python's email package. testdata/
  mailtree.txt (scripts/mail_tree_corpus.py writes it) holds 153 messages, the
  ones EmailMessage makes in every shape (a text in each transfer encoding and
  charset, alternative, mixed with attachments of every name, related with
  an inline image, an attached message, nested multiparts) and hand-written
  ones (upper-case names, folded parameters, a digest, RFC 2231 file names),
  each with the tree Python reads from it. The same dump is made here from
  MailParseEntity and compared; only the lines that differ are written, then
  the counts. Then the finders and the text decoding are checked on their own. }
program mailtree;

uses
  sysutils, pascodec, pastextproto, pasmime;

const
  HexDigits: string = '0123456789abcdef';

function Esc(const S: string): string;
var
  i, c: Integer;
begin
  Result := '';
  for i := 1 to Length(S) do
  begin
    c := Ord(S[i]);
    if ((c >= 48) and (c <= 57)) or ((c >= 65) and (c <= 90)) or ((c >= 97) and (c <= 122)) or
       (Pos(S[i], '._-@+=:;,''()~ ') > 0) then
      Result := Result + S[i]
    else
      Result := Result + '%' + Copy('0123456789ABCDEF', (c shr 4) + 1, 1) + Copy('0123456789ABCDEF', (c and 15) + 1, 1);
  end;
end;

function Hex8(V: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, 8);
  for i := 8 downto 1 do
  begin
    Result[i] := HexDigits[(V and 15) + 1];
    V := V shr 4;
  end;
end;

function NoCr(const S: string): string;
var
  i: Integer;
begin
  Result := '';
  i := 1;
  while i <= Length(S) do
  begin
    if (S[i] = #13) and (i < Length(S)) and (S[i + 1] = #10) then
      i := i + 1;
    Result := Result + S[i];
    i := i + 1;
  end;
end;

function Dump(E: TMailEntity): string;
var
  body: string;
  i: Integer;
begin
  if E.IsMultipart or (E.KidCount > 0) then
    body := '-'
  else
  begin
    body := E.Body;
    if Copy(E.MediaType, 1, 5) = 'text/' then
      body := NoCr(body);
    body := IntToStr(Length(body)) + ':' + Hex8(Crc32(body));
  end;
  Result := '{' + Esc(E.MediaType) + '|' + Esc(E.Charset) + '|' + Esc(E.Disposition) + '|' + Esc(E.FileName) + '|' +
    Esc(E.ContentId) + '|' + body + '}';
  if E.KidCount > 0 then
  begin
    Result := Result + '[';
    for i := 0 to E.KidCount - 1 do
    begin
      if i > 0 then
        Result := Result + ' ';
      Result := Result + Dump(E.Kid(i));
    end;
    Result := Result + ']';
  end;
end;

var
  bad, total, fails: Integer;

procedure Check(const What: string; Ok: Boolean);
begin
  if not Ok then
  begin
    fails := fails + 1;
    WriteLn('FAIL ', What);
  end;
end;

procedure Own;
var
  e, k: TMailEntity;
  err, s: string;
  junk: Boolean;
  atts: TMailEntityArray;
begin
  { the finders on a mixed message with an alternative and two files }
  s := 'Subject: =?UTF-8?Q?Se=C3=B1or?=' + #13#10 +
    'Content-Type: multipart/mixed; boundary=m' + #13#10 + #13#10 +
    '--m' + #13#10 + 'Content-Type: multipart/alternative; boundary=a' + #13#10 + #13#10 +
    '--a' + #13#10 + 'Content-Type: text/plain; charset=iso-8859-1' + #13#10 + 'Content-Transfer-Encoding: quoted-printable' + #13#10 + #13#10 +
    'Se=F1or' + #13#10 +
    '--a' + #13#10 + 'Content-Type: text/html; charset=utf-8' + #13#10 + #13#10 + '<p>Se' + #195 + #177 + 'or</p>' + #13#10 +
    '--a--' + #13#10 +
    '--m' + #13#10 + 'Content-Type: application/pdf; name="=?UTF-8?B?w6FiYy5wZGY=?="' + #13#10 +
    'Content-Disposition: attachment' + #13#10 + 'Content-Transfer-Encoding: base64' + #13#10 + #13#10 + 'JVBERg==' + #13#10 +
    '--m' + #13#10 + 'Content-Type: image/png' + #13#10 + 'Content-Disposition: inline; filename=p.png' + #13#10 +
    'Content-ID: <cid1@x>' + #13#10 + 'Content-Transfer-Encoding: base64' + #13#10 + #13#10 + 'iVBO' + #13#10 +
    '--m--' + #13#10;
  Check('parse', MailParseEntity(s, e, err));
  Check('subject', e.HeaderText('Subject') = 'Se' + #195 + #177 + 'or');
  Check('kids', e.KidCount = 3);
  k := MailFindText(e, False);
  Check('plain found', k <> nil);
  if k <> nil then
  begin
    Check('plain text', k.Text(False) = 'Se' + #195 + #177 + 'or');
    Check('plain charset', k.Charset = 'iso-8859-1');
  end;
  k := MailFindText(e, True);
  Check('html found', (k <> nil) and (k.Text(False) = '<p>Se' + #195 + #177 + 'or</p>'));
  atts := MailAttachments(e);
  { the inline file with a name is not an attachment }
  Check('attachments', Length(atts) = 1);
  if Length(atts) = 1 then
  begin
    Check('att 0 name', atts[0].FileName = #195 + #161 + 'bc.pdf');
    Check('att 0 body', atts[0].Body = '%PDF');
  end;
  k := e.Kid(2);
  Check('inline name', k.FileName = 'p.png');
  Check('inline cid', k.ContentId = 'cid1@x');
  Check('inline disposition', k.Disposition = 'inline');
  Check('inline body', k.Body = #137 + 'PN');
  { base64 and quoted-printable taken leniently }
  Check('b64 spaces', MailDecodeBase64('SGVs bG8g' + #13#10 + 'd29ybGQ=', junk) = 'Hello world');
  Check('b64 no junk', not junk);
  Check('b64 unpadded', MailDecodeBase64('SGVsbG8', junk) = 'Hello');
  Check('b64 junk', (MailDecodeBase64('SGV*sbG8=', junk) = 'Hello') and junk);
  Check('b64 one symbol', (MailDecodeBase64('SGVsb', junk) = 'Hel') and junk);
  Check('b64 empty', (MailDecodeBase64('', junk) = '') and not junk);
  Check('qp soft', MailDecodeQp('a=' + #13#10 + 'b=' + #10 + 'c') = 'abc');
  Check('qp hex', MailDecodeQp('=C3=A9=e9=3D') = #195 + #169 + #233 + '=');
  Check('qp bad escape', MailDecodeQp('a=zz =4 b=') = 'a=zz =4 b');
  Check('qp trailing blanks', MailDecodeQp('a  ' + #13#10 + 'b ' + #9) = 'a' + #13#10 + 'b');
  Check('qp interior blanks', MailDecodeQp('a  b') = 'a  b');
  { no charset: UTF-8 as it is, else Latin 1 }
  s := 'Content-Type: text/plain' + #13#10 + #13#10 + 'caf' + #233;
  Check('parse nocs', MailParseEntity(s, e, err));
  Check('nocs latin1', e.Text(False) = 'caf' + #195 + #169);
  s := 'Content-Type: text/plain' + #13#10 + #13#10 + 'caf' + #195 + #169;
  Check('parse nocs utf8', MailParseEntity(s, e, err));
  Check('nocs utf8', e.Text(False) = 'caf' + #195 + #169);
  { windows-1252 only when Extra }
  s := 'Content-Type: text/plain; charset=windows-1252' + #13#10 + #13#10 + #128;
  Check('parse cp1252', MailParseEntity(s, e, err));
  Check('cp1252 extra', e.Text(True) = #226 + #130 + #172);
  Check('cp1252 plain', e.Text(False) = #128);
  { what cannot be read }
  Check('bad header', not MailParseEntity(' leading space' + #13#10 + #13#10, e, err));
  Check('bad header nil', e = nil);
  Check('date fmt', MailFormatDate(0, 0) = 'Thu, 01 Jan 1970 00:00:00 +0000');
  Check('date fmt tz', MailFormatDate(1000000000, -18000) = 'Sat, 08 Sep 2001 20:46:40 -0500');
  Check('date fmt neg', MailFormatDate(-86400, 3600 + 1800) = 'Wed, 31 Dec 1969 01:30:00 +0130');
  Check('type of name', (MailTypeOfName('a/b.c/d.PDF') = 'application/pdf') and (MailTypeOfName('x') = 'application/octet-stream') and
    (MailTypeOfName('a.b/x') = 'application/octet-stream'));
end;

var
  corpus, line, id, rest, want, got, err: string;
  p, nl, q1: Integer;
  raw: string;
  e: TMailEntity;
begin
  if not ReadFile('testdata/mailtree.txt', corpus) then
  begin
    WriteLn('no testdata/mailtree.txt');
    Halt(2);
  end;
  p := 1;
  total := 0;
  bad := 0;
  fails := 0;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    q1 := Pos(' ', line);
    id := Copy(line, 1, q1 - 1);
    rest := Copy(line, q1 + 1, Length(line) - q1);
    q1 := Pos(' = ', rest);
    want := Copy(rest, q1 + 3, Length(rest) - q1 - 2);
    if not Base64Decode(Copy(rest, 1, q1 - 1), False, True, raw) then
    begin
      WriteLn('bad base64 in ', id);
      Halt(2);
    end;
    total := total + 1;
    if not MailParseEntity(raw, e, err) then
      got := 'ERR ' + err
    else
      got := Dump(e);
    if got <> want then
    begin
      bad := bad + 1;
      if bad <= 12 then
      begin
        WriteLn('DIFFERS ', id);
        WriteLn('  python ', want);
        WriteLn('  here   ', got);
      end;
    end;
  end;
  Own;
  WriteLn('messages ', total, ', differ from Python ', bad, ', own checks failed ', fails);
end.
