{ A Char where a string is wanted becomes a one-byte string, as in
  every Pascal: an assignment, an argument, a #nn argument, a method
  argument, a record field and a function result. The byte is on the
  heap, so a callee that keeps the string still has it after the frame
  that made it is gone. }
program chstr;

type
  TRec = record
    S: string;
  end;

  TBox = class
    S: string;
    procedure Put(const T: string);
  end;

var
  Kept: string;

procedure TBox.Put(const T: string);
begin
  S := '<' + T + '>';
end;

procedure Show(const T: string);
begin
  WriteLn('[', T, '] ', Length(T));
end;

procedure Keep(const T: string);
begin
  Kept := T;
end;

function Make(C: Char): string;
begin
  Result := C;
end;

{ Churns the stack after Keep, so a string left in a dead frame would
  come back as rubbish. }
function Churn(N: Integer): Integer;
var
  pad: array[0..31] of Integer;
  i: Integer;
begin
  for i := 0 to 31 do
    pad[i] := N + i;
  if N > 0 then
    Result := Churn(N - 1) + pad[0]
  else
    Result := pad[31];
end;

var
  c: Char;
  s: string;
  r: TRec;
  b: TBox;
  n: Integer;

begin
  c := 'q';
  s := c;
  WriteLn(s, ' ', Length(s));
  Show(c);
  Show(#33);
  Show('x');
  r.S := c;
  WriteLn(r.S, ' ', Length(r.S));
  b := TBox.Create;
  b.Put(c);
  WriteLn(b.S);
  Keep(c);
  n := Churn(40);
  WriteLn(Kept, ' ', Length(Kept), ' ', n > 0);
  WriteLn(Make('z'), ' ', Length(Make('z')));
  s := 'ab' + c;
  WriteLn(s, ' ', Length(s));
  s := c + 'ab';
  WriteLn(s, ' ', Length(s));
end.

