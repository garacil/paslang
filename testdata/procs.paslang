program procs;

var
  x: Integer;

function Add(A, B: Integer): Integer;
begin
  Result := A + B;
end;

procedure Show(N: Integer);
begin
  WriteLn(N);
end;

procedure IncX;
begin
  x := x + 1;
end;

function Twice(N: Integer): Integer;
var
  t: Integer;
begin
  t := N + N;
  Result := t;
end;

begin
  x := Add(10, 20);
  Show(x);
  Show(Add(1, 2));
  Show(Twice(7));
  IncX;
  Show(x);
end.
