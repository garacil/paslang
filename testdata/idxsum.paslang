  for k := -8 to 31 do
    t := t + g48[k + 1].a + g48[k + 1].f;
  for k := 3 to 42 do
    t := t + loc[k - 2].a + loc[k - 2].f;
  for k := 0 to n - 3 do
    t := t + h48[k + 2].a * 3 + h48[k + 2].f;
