end;

function Run48(n: Integer): Integer;
var
  loc: array[1..40] of T48;
  k, t: Integer;
begin
  for k := -8 to 31 do
  begin
    g48[k + 1].a := Integer(k * 7 + n);
    g48[k + 1].f := Integer(-k);
  end;
  for k := 3 to 42 do
  begin
    loc[k - 2].a := Integer(k + n);
    loc[k - 2].f := Integer(k * 3);
  end;
  SetLength(h48, 40);
  for k := 0 to n - 3 do
  begin
    h48[k + 2].a := Integer(k + 5);
    h48[k + 2].f := Integer(k - n);
  end;
