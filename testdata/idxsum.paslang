{ P313: an element's index that is a variable plus or minus a constant
  takes the constant into the element's displacement, where it cancels
  a low bound, and the element's size its recipe: records of 12, 20,
  24, 28, 40, 48 and 56 bytes in global and local arrays with low
  bounds below, at and above 0 and in heap arrays, written and read at
  k + c and k - c in loops whose range proves the index and in ones
  whose bound is a parameter, where the check stays and takes the sum,
  and through a leaf's parameter. scripts/check_idxsum.py reads that
  the routines Run and Pick add nothing to the index before it is
  scaled. Written by a script; the answers are Python's. }
program idxsum;

type
  T12 = record a, b, c: Int32; end;
  T20 = record a, b, c, d, e: Int32; end;
  T24 = record a, b, c: Integer; end;
  T28 = record a, b, c, d, e, f, g: Int32; end;
  T40 = record a, b, c, d, e: Integer; end;
  T48 = record a, b, c, d, e, f: Integer; end;
  T56 = record a, b, c, d, e, f, g: Integer; end;

var
  g12: array[1..40] of T12;
  h12: array of T12;
  g20: array[-3..36] of T20;
  h20: array of T20;
  g24: array[10..49] of T24;
  h24: array of T24;
  g28: array[0..39] of T28;
  h28: array of T28;
  g40: array[1..40] of T40;
  h40: array of T40;
  g48: array[-7..32] of T48;
  h48: array of T48;
  g56: array[1..40] of T56;
  h56: array of T56;

function Run12(n: Integer): Integer;
var
  loc: array[0..39] of T12;
  k, t: Integer;
begin
  for k := 0 to 39 do
  begin
    g12[k + 1].a := Int32(k * 7 + n);
    g12[k + 1].c := Int32(-k);
  end;
  for k := 2 to 41 do
  begin
    loc[k - 2].a := Int32(k + n);
    loc[k - 2].c := Int32(k * 3);
  end;
  SetLength(h12, 40);
  for k := 0 to n - 3 do
  begin
    h12[k + 2].a := Int32(k + 5);
    h12[k + 2].c := Int32(k - n);
  end;
  t := 0;
  for k := 0 to 39 do
    t := t + g12[k + 1].a + g12[k + 1].c;
  for k := 2 to 41 do
    t := t + loc[k - 2].a + loc[k - 2].c;
  for k := 0 to n - 3 do
    t := t + h12[k + 2].a * 3 + h12[k + 2].c;
  for k := 4 to n + 0 do
    t := t + g12[k - 3].c;
  Result := t;
end;

function Pick12(i: Integer): Integer;
begin
  Result := g12[i + 3].a - g12[i - 1].c;
end;

procedure Show12;
var
  r1, r2: Integer;
begin
  r1 := Run12(40);
  r2 := Run12(17);
  WriteLn(12, ' ', r1, ' ', r2, ' ', Pick12(2), ' ', Pick12(37));
end;

function Run20(n: Integer): Integer;
var
  loc: array[5..44] of T20;
  k, t: Integer;
begin
  for k := -4 to 35 do
  begin
    g20[k + 1].a := Int32(k * 7 + n);
    g20[k + 1].e := Int32(-k);
  end;
  for k := 7 to 46 do
  begin
    loc[k - 2].a := Int32(k + n);
    loc[k - 2].e := Int32(k * 3);
  end;
  SetLength(h20, 40);
  for k := 0 to n - 3 do
  begin
    h20[k + 2].a := Int32(k + 5);
    h20[k + 2].e := Int32(k - n);
  end;
  t := 0;
  for k := -4 to 35 do
    t := t + g20[k + 1].a + g20[k + 1].e;
  for k := 7 to 46 do
    t := t + loc[k - 2].a + loc[k - 2].e;
  for k := 0 to n - 3 do
    t := t + h20[k + 2].a * 3 + h20[k + 2].e;
  for k := 0 to n + -4 do
    t := t + g20[k - 3].e;
  Result := t;
end;

function Pick20(i: Integer): Integer;
begin
  Result := g20[i + 3].a - g20[i - 1].e;
end;

procedure Show20;
var
  r1, r2: Integer;
begin
  r1 := Run20(40);
  r2 := Run20(17);
  WriteLn(20, ' ', r1, ' ', r2, ' ', Pick20(-2), ' ', Pick20(33));
end;

function Run24(n: Integer): Integer;
var
  loc: array[-2..37] of T24;
  k, t: Integer;
begin
  for k := 9 to 48 do
  begin
    g24[k + 1].a := Integer(k * 7 + n);
    g24[k + 1].c := Integer(-k);
  end;
  for k := 0 to 39 do
  begin
    loc[k - 2].a := Integer(k + n);
    loc[k - 2].c := Integer(k * 3);
  end;
  SetLength(h24, 40);
  for k := 0 to n - 3 do
  begin
    h24[k + 2].a := Integer(k + 5);
    h24[k + 2].c := Integer(k - n);
  end;
  t := 0;
  for k := 9 to 48 do
    t := t + g24[k + 1].a + g24[k + 1].c;
  for k := 0 to 39 do
    t := t + loc[k - 2].a + loc[k - 2].c;
  for k := 0 to n - 3 do
    t := t + h24[k + 2].a * 3 + h24[k + 2].c;
  for k := 13 to n + 9 do
    t := t + g24[k - 3].c;
  Result := t;
end;

function Pick24(i: Integer): Integer;
begin
  Result := g24[i + 3].a - g24[i - 1].c;
end;

procedure Show24;
var
  r1, r2: Integer;
begin
  r1 := Run24(40);
  r2 := Run24(17);
  WriteLn(24, ' ', r1, ' ', r2, ' ', Pick24(11), ' ', Pick24(46));
end;

function Run28(n: Integer): Integer;
var
  loc: array[1..40] of T28;
  k, t: Integer;
begin
  for k := -1 to 38 do
  begin
    g28[k + 1].a := Int32(k * 7 + n);
    g28[k + 1].g := Int32(-k);
  end;
  for k := 3 to 42 do
  begin
    loc[k - 2].a := Int32(k + n);
    loc[k - 2].g := Int32(k * 3);
  end;
  SetLength(h28, 40);
  for k := 0 to n - 3 do
  begin
    h28[k + 2].a := Int32(k + 5);
    h28[k + 2].g := Int32(k - n);
  end;
  t := 0;
  for k := -1 to 38 do
    t := t + g28[k + 1].a + g28[k + 1].g;
  for k := 3 to 42 do
    t := t + loc[k - 2].a + loc[k - 2].g;
  for k := 0 to n - 3 do
    t := t + h28[k + 2].a * 3 + h28[k + 2].g;
  for k := 3 to n + -1 do
    t := t + g28[k - 3].g;
  Result := t;
end;

function Pick28(i: Integer): Integer;
begin
  Result := g28[i + 3].a - g28[i - 1].g;
end;

procedure Show28;
var
  r1, r2: Integer;
begin
  r1 := Run28(40);
  r2 := Run28(17);
  WriteLn(28, ' ', r1, ' ', r2, ' ', Pick28(1), ' ', Pick28(36));
end;

