function Run56(n: Integer): Integer;
var
  loc: array[-1..38] of T56;
  k, t: Integer;
begin
  for k := 0 to 39 do
  begin
    g56[k + 1].a := Integer(k * 7 + n);
    g56[k + 1].g := Integer(-k);
  end;
  for k := 1 to 40 do
  begin
    loc[k - 2].a := Integer(k + n);
    loc[k - 2].g := Integer(k * 3);
  end;
  SetLength(h56, 40);
  for k := 0 to n - 3 do
  begin
    h56[k + 2].a := Integer(k + 5);
    h56[k + 2].g := Integer(k - n);
  end;
  t := 0;
  for k := 0 to 39 do
    t := t + g56[k + 1].a + g56[k + 1].g;
  for k := 1 to 40 do
    t := t + loc[k - 2].a + loc[k - 2].g;
  for k := 0 to n - 3 do
    t := t + h56[k + 2].a * 3 + h56[k + 2].g;
  for k := 4 to n + 0 do
    t := t + g56[k - 3].g;
  Result := t;
end;

function Pick56(i: Integer): Integer;
