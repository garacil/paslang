begin
  for k := 0 to 39 do
  begin
    g40[k + 1].a := Integer(k * 7 + n);
    g40[k + 1].e := Integer(-k);
  end;
  for k := 5 to 44 do
  begin
    loc[k - 2].a := Integer(k + n);
    loc[k - 2].e := Integer(k * 3);
  end;
  SetLength(h40, 40);
  for k := 0 to n - 3 do
  begin
    h40[k + 2].a := Integer(k + 5);
    h40[k + 2].e := Integer(k - n);
  end;
  t := 0;
  for k := 0 to 39 do
    t := t + g40[k + 1].a + g40[k + 1].e;
  for k := 5 to 44 do
    t := t + loc[k - 2].a + loc[k - 2].e;
  for k := 0 to n - 3 do
    t := t + h40[k + 2].a * 3 + h40[k + 2].e;
