end;

procedure Show56;
var
  r1, r2: Integer;
begin
  r1 := Run56(40);
  r2 := Run56(17);
  WriteLn(56, ' ', r1, ' ', r2, ' ', Pick56(2), ' ', Pick56(37));
end;

begin
  Show12;
  Show20;
  Show24;
  Show28;
  Show40;
  Show48;
  Show56;
end.
