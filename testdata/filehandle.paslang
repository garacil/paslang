{ P77: a file a piece at a time. The handle stays open: write in
  pieces, add at the end, go back and read a slice out of the middle.
  What comes out has to agree with ReadFile, which reads the lot. }
program filehandle;

uses
  paslib;

var
  fd: Int64;
  s, whole: string;
  n: Int64;

begin
  { Written in three pieces, read back as one. }
  fd := FileCreate('build/fh.txt');
  WriteLn(fd >= 0);
  WriteLn(FileWrite(fd, 'one' + #10), ' ', FileWrite(fd, 'two' + #10), ' ',
    FileWrite(fd, 'three' + #10));
  WriteLn(FileTell(fd));
  FileClose(fd);
  whole := '';
  WriteLn(ReadFile('build/fh.txt', whole), ' ', Length(whole), ' ',
    whole = 'one' + #10 + 'two' + #10 + 'three' + #10);
  WriteLn(FileSize('build/fh.txt'));

  { Append adds at the end and leaves what was there. }
  fd := FileAppend('build/fh.txt');
  n := FileWrite(fd, 'four' + #10);
  FileClose(fd);
  whole := '';
  ReadFile('build/fh.txt', whole);
  WriteLn(n, ' ', Length(whole), ' ', Copy(whole, 14, 5) = #10 + 'four');

  { Read in pieces: three bytes, then the rest, then nothing. }
  fd := FileOpen('build/fh.txt');
  WriteLn(FileRead(fd, 3), ' ', FileTell(fd));
  s := FileRead(fd, 4);
  WriteLn(s = #10 + 'two', ' ', FileTell(fd));
  s := FileRead(fd, 1000);
  WriteLn(Length(s), ' ', s = #10 + 'three' + #10 + 'four' + #10);
  WriteLn(FileRead(fd, 10) = '', ' ', FileTell(fd));
  FileClose(fd);

  { Seek: back to the start, to a place in the middle, to the end. }
  fd := FileOpen('build/fh.txt');
  WriteLn(FileSeek(fd, 0, 0), ' ', FileRead(fd, 3));
  WriteLn(FileSeek(fd, 4, 0), ' ', FileRead(fd, 3));
  WriteLn(FileSeek(fd, 1, 1), ' ', FileRead(fd, 5));
  WriteLn(FileEnd(fd), ' ', FileRead(fd, 5) = '');
  WriteLn(FileSeek(fd, -5, 2), ' ', FileRead(fd, 5) = 'four' + #10);
  FileClose(fd);

  { Open for reading and writing: change a byte in the middle and the
    rest stays as it was. }
  fd := FileEdit('build/fh.txt');
  WriteLn(fd >= 0, ' ', FileSeek(fd, 0, 0), ' ', FileWrite(fd, 'ONE'));
  FileClose(fd);
  whole := '';
  ReadFile('build/fh.txt', whole);
  WriteLn(Copy(whole, 1, 8) = 'ONE' + #10 + 'two' + #10, ' ',
    Length(whole), ' ', Copy(whole, 1, 3));

  { A file that is not there is refused, not pretended. }
  WriteLn(FileOpen('build/nothere-at-all.txt') >= 0, ' ',
    FileRead(-1, 10) = '', ' ', FileWrite(-1, 'x'), ' ',
    FileSeek(-1, 0, 0));
  FileClose(-1);
end.

