{ A program whose routines only wait must use no CPU: the idle Ms sleep
  in epoll_wait until the timer. The Makefile reads the user time of
  the process from /proc after one second and requires it to stay near
  zero; with the epoll timeout in the wrong register every idle M spun. }
program idle;

var
  c: chan of Integer;
  x: Integer;

procedure Late;
begin
  Sleep(1500);
  Send(c, 1);
end;

begin
  c := MakeChan();
  pas Late;
  x := Recv(c);
  WriteLn(x);
end.
