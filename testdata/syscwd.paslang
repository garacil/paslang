program syscwd;
uses sysutils, paslinux;
const Depth = 400; Readers = 16;
var
  root, component, longPath, actual, oldDirectory: string;
  rootHandle, currentHandle, parentHandle: THandle;
  oldHandle, i, token, chdirCall, count: Integer;
  data: TBytes;
  error: TSysError;
  joined: waitgroup;
  started: chan of Integer;

procedure StableBase(Index: Integer);
var bytes: TBytes; localError: TSysError; k: Integer;
begin
  SetLastOSError(Index + 1);
  Send(started, Index);
  for k := 1 to 32 do
  begin
    if not TryReadFileAt(rootHandle, 'anchor', 4, bytes, localError) then Halt(30);
    if StringOf(bytes) <> 'base' then Halt(31);
    Yield;
  end;
  if GetLastOSError <> Index + 1 then Halt(32);
  joined.Done;
end;

begin
  if Amd64 then chdirCall := 81 else chdirCall := 50;
  oldDirectory := GetCurrentDir;
  if not IsAbsolutePath(oldDirectory) then Halt(2);
  if not TryOpenFileAt(CurrentDirectoryHandle, '.', ODirectory, 0, oldHandle, error) then Halt(3);
  root := ParamStr(1) + '/cwd';
  if not CreateDir(root) then Halt(4);
  if not TryOpenFileAt(CurrentDirectoryHandle, root, ODirectory, 0, rootHandle, error) then Halt(5);
  try
    component := StringOfChar('d', 12);
    longPath := component;
    for i := 2 to Depth do longPath := longPath + '/' + component;
    SetLastOSError(77);
    if not TryForceDirectoriesAt(rootHandle, longPath, 448, error) then Halt(6);
    if GetLastOSError <> 77 then Halt(7);
    if not TryForceDirectoriesAt(rootHandle, longPath, 448, error) then Halt(8);
    if not TryOpenFileAt(rootHandle, '.', ODirectory, 0, currentHandle, error) then Halt(9);
    for i := 1 to Depth do
    begin
      if not TryOpenFileAt(currentHandle, component, ODirectory, 0, parentHandle, error) then Halt(9);
      FileClose(currentHandle);
      currentHandle := parentHandle;
    end;
    if not TryGetDirectoryPath(currentHandle, actual, error) then Halt(10);
    if actual <> root + '/' + longPath then Halt(11);
    if Length(actual) <= 4096 then Halt(12);
    if Syscall(chdirCall, currentHandle) <> 0 then Halt(13);
    if not TryGetCurrentDir(actual, error) or (actual <> root + '/' + longPath) then Halt(14);
    if Syscall(chdirCall, oldHandle) <> 0 then Halt(15);
    data := BytesOf('base');
    if not TryWriteFileAt(rootHandle, 'anchor', data, 384, error) then Halt(16);
    if TryForceDirectoriesAt(rootHandle, 'anchor/no', 448, error) or (error.Code <> 20) then Halt(17);
    if TryForceDirectoriesAt(rootHandle, '', 448, error) or (error.Code <> 22) then Halt(18);
    if not ForceDirectories(root + '/normal/../normal/deeper') then Halt(19);
    if not DirectoryExists(root + '/normal/deeper') then Halt(20);
    if ExpandFileName('../file', root + '/normal') <> root + '/file' then Halt(21);
    if ExpandFileName('', root) <> root then Halt(22);
    if ExpandFileName('/a/../b', root) <> '/b' then Halt(23);
    try
      actual := ExpandFileName('a' + #0, root);
      Halt(24);
    except
      on EArgumentException do ;
    end;
    joined.Add(Readers);
    started := MakeChan();
    for i := 0 to Readers - 1 do pas StableBase(i);
    for i := 0 to Readers - 1 do token := Recv(started);
    for i := 1 to 32 do
    begin
      if not SetCurrentDir(root) then Halt(25);
      Yield;
      if not SetCurrentDir(oldDirectory) then Halt(26);
    end;
    joined.Wait;
    if not TryDeleteFileAt(rootHandle, 'anchor', False, error) then Halt(27);
    if not RemoveDir(root + '/normal/deeper') or not RemoveDir(root + '/normal') then Halt(28);
    { Deleted cwd is an explicit error, never '(unreachable)' or stale PWD. }
    if Syscall(chdirCall, currentHandle) <> 0 then Halt(33);
    if not TryOpenFileAt(currentHandle, '..', ODirectory, 0, parentHandle, error) then Halt(34);
    if not TryDeleteFileAt(parentHandle, component, True, error) then Halt(34);
    if TryGetCurrentDir(actual, error) or (error.Code <> 2) or (actual <> '') then Halt(35);
    if TryGetDirectoryPath(currentHandle, actual, error) or (error.Code <> 2) then Halt(36);
    if Syscall(chdirCall, oldHandle) <> 0 then Halt(37);
    FileClose(currentHandle);
    currentHandle := parentHandle;
    for i := Depth - 1 downto 1 do
    begin
      if not TryOpenFileAt(currentHandle, '..', ODirectory, 0, parentHandle, error) then Halt(38);
      FileClose(currentHandle);
      if not TryDeleteFileAt(parentHandle, component, True, error) then Halt(38);
      currentHandle := parentHandle;
    end;
    FileClose(currentHandle);
  finally
    if Syscall(chdirCall, oldHandle) <> 0 then Halt(39);
    FileClose(oldHandle);
    FileClose(rootHandle);
  end;
  if not RemoveDir(root) then Halt(40);
  GcCollect;
  WriteLn('descriptor paths beyond 4096 bytes, depth ', Depth);
  WriteLn('stable bases under process-wide chdir, readers ', Readers);
end.
