{ P316: a bounds check that an earlier one of the same index and length
  proves is left out. Fields walks the fields of heap, static and
  dynamic elements whose index the loop does not prove in range, one
  check an element; Moved changes the index between two fields, Called
  calls between them, Joined joins two paths between them and Grown
  changes the length between them, where the check is made again.
  scripts/check_chkcse.py reads that Fields checks once an element.
  Written by a script; the answers are Python's. }
program chkcse;

type
  T3 = record a, b, c: Integer; end;

var
  g: array[0..99] of T3;
  h: array of T3;
  w: array of Integer;

function Bump(x: Integer): Integer;
begin
  Result := x + 1;
end;

function Fields(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(h, n);
  SetLength(w, n);
  for k := 0 to n - 1 do
  begin
    g[k].a := k;
    g[k].b := k * 2;
    g[k].c := -k;
    h[k].a := k + n;
    h[k].b := k xor n;
    h[k].c := n - k;
    w[k] := k * 3;
  end;
  t := 0;
  for k := 0 to n - 1 do
    t := t + g[k].a + g[k].b + g[k].c + h[k].a + h[k].b + h[k].c + w[k];
  Result := t;
end;

function Moved(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(h, n + 1);
  t := 0;
  k := 0;
  while k < n do
  begin
    h[k].a := k;
    k := k + 1;
    h[k].b := k * 5;
    t := t + h[k - 1].a + h[k].b;
  end;
  Result := t;
end;

function Called(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(h, n);
  t := 0;
  for k := 0 to n - 1 do
  begin
    h[k].a := Bump(k);
    h[k].b := Bump(h[k].a);
    t := t + h[k].a + h[k].b;
  end;
  Result := t;
end;

function Joined(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(h, n);
  t := 0;
  for k := 0 to n - 1 do
  begin
    h[k].a := k;
    if (k and 1) = 0 then
      h[k].b := n
    else
      h[k].b := -n;
    t := t + h[k].a + h[k].b;
  end;
  Result := t;
end;

function Grown(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(w, 1);
  t := 0;
  for k := 0 to n - 1 do
  begin
    SetLength(w, k + 1);
    w[k] := k;
    SetLength(w, k + 2);
    w[k + 1] := k * 7;
    t := t + w[k] + w[k + 1];
  end;
  Result := t;
end;

begin
  WriteLn(Fields(1), ' ', Fields(37), ' ', Fields(100));
  WriteLn(Moved(5), ' ', Moved(60));
  WriteLn(Called(3), ' ', Called(70));
  WriteLn(Joined(9), ' ', Joined(64));
  WriteLn(Grown(4), ' ', Grown(50));
end.
