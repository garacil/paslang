{ P83: muchas rutinas naciendo y muriendo a la vez. Sesenta y cuatro
  rutinas que solo cuentan y terminan tumbaban el programa unas tres
  veces de cada cien, en amd64 nativo, sin sockets y sin mutex. La
  causa estaba en rt_alloc: el puntero del monton se movia con una
  lectura y una escritura corrientes, asi que dos hilos que pedian
  memoria a la vez se llevaban el mismo bloque. Al crecer una pila, el
  registro del G se copia a un bloque pedido a rt_alloc, y dos Gs
  acababan compartiendo registro.

  Ahora el puntero se mueve con un compare-and-swap y el monton crece
  bajo un cerrojo. }
program spawnrace;

uses
  pasroutines;

const
  Rout = 64;
  Each = 200;

var
  wg: TPasWaitGroup;
  n: Integer;

procedure Bump;
var
  i, k: Integer;
begin
  k := 0;
  for i := 1 to Each do
    k := k + i;
  if k > 0 then
    n := n + 0;
  PasWaitGroupDone(wg);
end;

var
  i: Integer;

begin
  n := 0;
  PasWaitGroupAdd(wg, Rout);
  for i := 1 to Rout do
    pas Bump;
  PasWaitGroupWait(wg);
  WriteLn('done');
end.
