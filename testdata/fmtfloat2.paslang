{ SysUtils' reals as text (P129) where paslang writes what Go writes and
  Free Pascal 3.2.2 does not (the manual's §19): the digits rounded once,
  a tie to even; the fewest that read back when no precision is asked;
  every digit that is asked, past 17; a Single, an integer and a Quad as
  their own values; NaN, +Inf and -Inf; one digit for a precision of 1;
  FormatFloat's empty section and a value that rounds to 0; Format's
  64-bit integers, %b and %o, and a letter it does not know. Each line
  says what Free Pascal writes. }
program fmtfloat2;

uses sysutils;

procedure Bad(const F: string; const A: array of const);
begin
  try
    WriteLn(Format(F, A));
  except
    on e: EConvertError do
      WriteLn(e.ClassName, ': ', e.Message);
  end;
end;

var
  x, z, third: Double;
  sg: Single;
  q, q3: Quad;
  code, b: Int64;
  o: TObject;
  fr: TFloatRec;
begin
  { a tie goes to the even digit (Free Pascal: up, 1 3 4 0.13 0.38 3 0.3 1) }
  WriteLn(FloatToStrF(0.5, ffFixed, 0, 0), ' ', FloatToStrF(2.5, ffFixed, 0, 0), ' ',
    FloatToStrF(3.5, ffFixed, 0, 0), ' ', FloatToStrF(0.125, ffFixed, 0, 2), ' ',
    FloatToStrF(0.375, ffFixed, 0, 2), ' ', FormatFloat('0', 2.5), ' ', FormatFloat('0.0', 0.25),
    ' ', Format('%.0f', [0.5]));
  { the digits of the Double itself: 1.005 is 1.00499999999999989...,
    2.675 is 2.67499999999999982... (Free Pascal: 1.01 2.68) }
  WriteLn(FloatToStrF(1.005, ffFixed, 0, 2), ' ', FloatToStrF(2.675, ffFixed, 0, 2));
  { the fewest digits that read back (Free Pascal: 15, 0.3 0.333333333333333
    0.666666666666667 1.23456789012346E17 1E23 5E-324 1.79769313486232E308) }
  third := 1 / 3;
  WriteLn(FloatToStr(0.1 + 0.2), ' ', FloatToStr(third), ' ', FloatToStr(2 / 3), ' ',
    FloatToStr(123456789012345678.0), ' ', FloatToStr(1e23), ' ', FloatToStr(5e-324), ' ',
    FloatToStr(1.7976931348623157e308));
  { Format's %e and %g with no precision: the same (Free Pascal: 17
    digits, 1.0000000000000000E-001 0.1 3.3333333333333331E-001
    0.33333333333333331 0.0000000000000000E+000) }
  WriteLn(Format('%e|%g|%e|%g|%e', [0.1, 0.1, third, third, 0.0]));
  { a precision of 1 is one digit (Free Pascal: two, 1.0E+001 9.9 1.3E+000) }
  WriteLn(FloatToStrF(9.96, ffExponent, 1, 3), ' ', FloatToStrF(9.94, ffGeneral, 1, 0), ' ',
    Format('%.1e', [1.25]));
  { every digit asked for, past 17 (Free Pascal: 18 decimals at most,
    0.100000000000000000; 1.0000000000000000E-001; 1e100 as
    99999999999999999996700000...; 0.333333333333333310000000;
    0.33333333333333331) }
  WriteLn(FloatToStrF(0.1, ffFixed, 0, 30));
  WriteLn(Format('%.25e', [0.1]));
  WriteLn(FloatToStrF(1e100, ffFixed, 0, 0));
  WriteLn(FormatFloat('0.000000000000000000000000', third));
  WriteLn(FloatToStrF(third, ffGeneral, 40, 0));
  { a Single's own digits (Free Pascal: 0.1000000015 0.3333333433
    3.333333433E-01) }
  sg := 0.1;
  Write(FloatToStr(sg), ' ');
  sg := Single(third);
  WriteLn(FloatToStr(sg), ' ', FloatToStrF(sg, ffExponent, 12, 2));
  { an integer's, exact (Free Pascal: 1.23456789012346E17 9.22337203685478E18) }
  WriteLn(FloatToStr(Int64(123456789012345678)), ' ', FloatToStr(High(Int64)), ' ',
    FloatToStrF(Int64(-1234567890123456789), ffNumber, 0, 2));
  { a Quad's, all 113 bits (Free Pascal has no Quad) }
  Val('0.1', q, code);
  q3 := q;
  WriteLn(FloatToStr(q), ' ', FloatToStrF(q, ffFixed, 0, 40), ' ', Format('%.36e', [q]));
  q := 1;
  q := q / 3;
  WriteLn(FloatToStr(q), ' ', FormatFloat('0.000', q), ' ', Format('%g|%.3f', [q, q3]));
  Val('1.189731495357231765085759326628007e4932', q, code);
  WriteLn(FloatToStr(q), ' ', FloatToStrF(q, ffExponent, 5, 4));
  { NaN, +Inf and -Inf as paslang and Go write them (Free Pascal: Nan,
    and its FormatFloat of a NaN stops with EInvalidOp) }
  z := 0;
  x := z / z;
  b := $7FF8000000000001;
  Move(b, x, 8);
  WriteLn(FloatToStr(x), ' ', FloatToStr(1 / z), ' ', FloatToStrF(-1 / z, ffFixed, 0, 2), ' ',
    FormatFloat('0.00', x), ' ', Format('%f|%e|%g', [1 / z, -1 / z, x]));
  { FormatFloat: an empty section takes the first (Free Pascal: -1234,
    the general form, its test of an empty section never true), a value
    that rounds to 0 has no sign and no digit for # (Free Pascal: .00 -0
    -0.00 -x0.0y), and a large one keeps its digits (Free Pascal: 1E100) }
  WriteLn(FormatFloat('#,##0.00;;Zero', -1234), '|', FormatFloat('#.##', 0.001), '|',
    FormatFloat('0', -0.004), '|', FormatFloat('0.00', -0.001), '|',
    FormatFloat('"x"0.0"y"', -0.01), '|', FormatFloat('#', 0.4), '|');
  WriteLn(FormatFloat('0', 1e100));
  { FloatToDecimal of a value that rounds to 0: exponent 0 and no sign
    (Free Pascal: -2 False and -2 True, the exponent before rounding) }
  FloatToDecimal(fr, 0.004, 15, 2);
  Write(fr.Exponent, ' ', BoolToStr(fr.Negative, True), ' ', BoolToStr(fr.Digits[0] = #0, True), ' ');
  FloatToDecimal(fr, -0.004, 15, 2);
  WriteLn(fr.Exponent, ' ', BoolToStr(fr.Negative, True), ' ', BoolToStr(fr.Digits[0] = #0, True));
  { Format's integers have 64 bits (Free Pascal: FFFFFFFF 4294967295
    00000000000000FF) }
  WriteLn(Format('%x|%u|%.20x|%d', [-1, -1, 255, Low(Int64)]));
  { %b and %o, from Free Pascal's sources after 3.2.2 (its release writes
    nothing): a Boolean or an integer, an object's ToString, a class's
    name }
  o := TObject.Create;
  WriteLn(Format('%b|%5b|%.1b|%b|%o|%o|', [True, False, True, 0, o, TObject]));
  o.Free;
  { a letter Format does not know is an error (Free Pascal: 5 5, the
    directive before written again, and nothing for %a) }
  Bad('%d %y', [5]);
  Bad('%a', [1.5]);
end.

