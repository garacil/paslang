{ SysUtils' digits of a Double (P129): FloatToStr (the fewest that read
  back, of the Double and of the Single it rounds to), FloatToStrF's
  significant digits and decimals, rounded once, a tie to even, for 169
  values taken from the 6524 checked against Go's FormatFloat ('e' and
  'f', its src/internal/strconv): exact, subnormal, near powers of 10
  and of 2, random. Each line is one value's bits. }
program realtext;

uses sysutils;

const
  N = 169;
  Bits: array[0..168] of Int64 = (
    $3FB999999999999A, $3FC0000000000000, $4004000000000000, $3FD5555555555555,
    $3FE5555555555555, $4415AF1D78B58C40, $3E8421F5F40D8376, $437B69B4BA630F35,
    $3FD8000000000000, $3FF1000000000000, $0000000000000001, $0010000000000000,
    $7FEFFFFFFFFFFFFF, $4023000000000000, $4058E00000000000, $430C6BF52633FFFF,
    $3FD3333333333333, $44B52D02C7E14AF6, $4011666666666666, $4005666666666666,
    $3F747AE147AE147B, $3F747AC66FBB79BE, $3EE4F8B588E368F1, $3FE0000000000000,
    $3FF8000000000000, $6C66A78795E761D1, $3D0561E6211C70CF, $1A358CA00D75985D,
    $66934036D17E4497, $27E6529BCE76E9F4, $7B8444D18E317041, $29ACF1A57CBD1F5A,
    $43B30F66110E2CB6, $03A63966213BCA7F, $7E834904FC173498, $75D8D8A4F9C9C679,
    $1CD86FC1E3096619, $34145E878C9A3751, $7F867D5F0FE321EC, $073B99034075916E,
    $1BE7F3CF4B80B828, $7243D47CEB64C5C4, $75F5C1A051CDF2F9, $76C32DCDA74068B2,
    $456B312CB2061ECC, $22E8FEC0ED19557A, $112ED1DF1B69567E, $22F65E3629465388,
    $0DECB3B505B4C425, $1CF99A99D039B963, $7B4E1D36B15E27E6, $21DBBD89A1AC6036,
    $7033B91536F784CC, $53971494B402B288, $1571623CB33858A1, $3AA6B8E61F55411E,
    $4C858EE3B8C730CD, $1E50F1348E18A929, $4A059E92D3A43D90, $5F3648FB5E6E383A,
    $31E13663B6AB58CA, $26AFD434D4CF50A7, $65EF8DB03B9D226A, $5EA049A48EB078C8,
    $70FE98A02B27DF87, $6CDBC47BAB14660F, $3136D5FB10D16824, $0E2C1685401E0548,
    $0FA2FC70D8FE52F8, $02FA58471FB9396F, $6F175E5DBD175335, $3B603D9294E29546,
    $4F857281D376A833, $7D8C9A1885C23DCF, $2B8028C42C685F56, $08DF8C675E34F81D,
    $6688E8AAD8C244D2, $595A75EE1705E32D, $6CB4E4F88C5AC762, $65309ECCC6419ADB,
    $24A646156CE9EB66, $5C290A376A97AD18, $74A4198A98248BD5, $40113E71E01A6EA5,
    $7DC9BD1980001CF5, $38484EA94D2E6A00, $5250F5953654771B, $0F2E494274025C14,
    $604101EC906F7B90, $222578ED0269B809, $03E49D262D5E449E, $793556EF003D1921,
    $68F778401F7F2838, $40CAE261B668C911, $03F6082DD1465C1E, $34F88738EB5C670F,
    $71418C08E7E7A469, $157B17619907E9DA, $4DAA8ABB7AF1799A, $191B7733FBA2BAE9,
    $4D8F36CAEFE7EE86, $79B2C08ACFF8D06D, $3C0CE1B98D7C38A1, $069B1B9E8B566EEE,
    $6476C5D3C7555E6D, $69E44CEC856CF413, $74337BD8D6AE2FBD, $6E6B8FE6223CFF57,
    $5D27075227646356, $616EC3F561F2C8F5, $69EACCC5EB55E7DA, $61A0B6F7D987E542,
    $40D9342DD63A13F0, $408ADFEB851EB852, $3F0C106EF282E81D, $3F4410F0F0E14A10,
    $3CD3622C9579F11B, $4001663CFB3311A5, $42A0AD4385A4F1D7, $407C86B61BB05FAF,
    $40120C7E6B3FE9FB, $3F814CE0116A5274, $4259463E2D7D0EB8, $40F01FE000000000,
    $3ED6DD10714D3F68, $42A216233771E99B, $3F47C07DAB73D90D, $40E2F296B4395810,
    $3DA379EB1304F885, $42987C6869CD3B6E, $3E012E0BE826D695, $3EA3CFED47FF639C,
    $4011B8F3D8AA50A1, $41CD50662D000000, $416910515B487626, $40C301F59B7F0EA0,
    $409594C902DE00D2, $3FEBAED474740350, $3F040934A4A7E09E, $415344E2DE8C19EA,
    $40A980531832FCAD, $408A3C8D1F6BDED3, $422F2A57B2980000, $3EE060F63A0386F3,
    $429DD84B0932D3CD, $41C5247783A66666, $411F643B921AB4B7, $433D469C6C3403A2,
    $401C75A4BF494866, $40104FF5E7B7B354, $401E4ABB2F6B7D7D, $3F6E204923932DEC,
    $4061F61E30D2B0BC, $3ED341049D54AF05, $3F7FCADA342BA6B2, $42367CDDDD1F199A,
    $3EF7456358E23BC1, $41B644EABBEC0831, $3EDA03299597D99A, $44F832925B8C29B6,
    $394A99794A9B7A31, $399AA64EB910CD8F, $3F4ACCEDAC2C0B0D, $3D4DDCCC507FDD51,
    $3F3686131EF6ADA8, $3D5F1BDF9BA9FF1B, $44B3137C3AF8FB37, $4296539E6235C237,
    $414C53D353047768);
  NS: array[0..11] of Integer = (1, 2, 3, 5, 8, 12, 15, 16, 17, 18, 20, 25);
  FS: array[0..6] of Integer = (0, 1, 2, 5, 10, 17, 20);

var
  i, k: Integer;
  x: Double;
begin
  for i := 0 to N - 1 do
  begin
    Move(Bits[i], x, 8);
    Write(IntToHex(Bits[i], 16), ' s ', FloatToStr(x));
    if Abs(x) >= 3.4028235677973366e38 then
      Write(' s32 inf')
    else
      Write(' s32 ', FloatToStr(Single(x)));
    for k := 0 to High(NS) do
      Write(' e', NS[k], ' ', FloatToStrF(x, ffExponent, NS[k], 3));
    if Abs(x) < 1e30 then
      for k := 0 to High(FS) do
        Write(' f', FS[k], ' ', FloatToStrF(x, ffFixed, 0, FS[k]));
    WriteLn;
  end;
end.

