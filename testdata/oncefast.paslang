{ P487: once ... do tests the word of a once that has run in the statement's
  own code and calls PasOnceBegin only when it has not. A global, a field, an
  element chosen by a call that must be made once, and sixteen routines on one
  once: each block runs once. }
program oncefast;

type
  TBox = record
    Name: string;
    O: once;
  end;

var
  g: once;
  box: TBox;
  arr: array[0..2] of once;
  runs: array[0..9] of Integer;
  calls: Integer;
  racing: once;
  racers: Integer;
  wg: waitgroup;

function Pick(K: Integer): Integer;
begin
  calls := calls + 1;
  Result := K;
end;

procedure Racer;
begin
  once racing do
  begin
    Yield;
    racers := racers + 1;
  end;
  wg.Done;
end;

var
  i: Integer;
begin
  for i := 1 to 5 do
    once g do
      runs[0] := runs[0] + 1;
  for i := 1 to 5 do
    once box.O do
      runs[1] := runs[1] + 1;
  for i := 1 to 5 do
    once arr[Pick(1)] do
      runs[2] := runs[2] + 1;
  for i := 1 to 5 do
    once arr[Pick(2)] do
      runs[3] := runs[3] + 1;
  WriteLn('global ', runs[0], ' field ', runs[1], ' element ', runs[2], ' ', runs[3], ' picks ', calls);
  wg.Add(16);
  for i := 1 to 16 do
    pas Racer;
  wg.Wait;
  WriteLn('racers ', racers, ' done ', racing.Done, ' ', g.Done, ' ', box.O.Done, ' ', arr[0].Done);
end.
