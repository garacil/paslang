{ P221 (1.1.106): a string a routine builds and returns is stored
  without the shared mark, so a write or SetLength on it copies nothing;
  a string another variable holds is still marked when it reaches
  Result, whichever way it gets there, so a write to the result never
  reaches that variable. Each line names a way into Result and says
  whether the stored result carries the mark (the byte before its
  characters), whether the holder it came from is unchanged after the
  result is written, and whether the result reads right; a fresh result
  also says whether SetLength shortened it in its own block. }
program resultmark;

uses
  sysutils;

type
  TStrWords = record
    P: Pointer;
    N: Integer;
  end;
  PStrWords = ^TStrWords;
  TGetter = function: string;
  TNamed = class
    FName: string;
    function Name: string;
    function Fresh(N: Integer): string; virtual;
    function GetLabel: string;
    property Caption: string read FName;
    property Labelled: string read GetLabel;
  end;
  INamed = interface
    function Title: string;
    function Made(N: Integer): string;
  end;
  TTitled = class(INamed)
    FTitle: string;
    function Title: string;
    function Made(N: Integer): string;
  end;

var
  G: string;
  m: map[Integer] of string;
  t: tree[Integer] of string;
  arr: array of string;
  ch: chan of string;
  obj: TNamed;
  ti: TTitled;
  intf: INamed;
  getter: TGetter;
  s: string;
  p: Pointer;
  x: Integer;

function Words(var S: string): Pointer;
begin
  Result := PStrWords(@S)^.P;
end;

function Marked(var S: string): Integer;
begin
  Result := Ord((PByte(Words(S)) - 1)^ and 1);
end;

function Fresh(N: Integer): string;
begin
  Result := 'fresh, made by the routine ' + IntToStr(N);
end;

function FromGlobal: string;
begin
  Result := G;
end;

function FromParam(const A: string): string;
begin
  Result := A;
end;

function ExitFresh(N: Integer): string;
begin
  if N > 0 then
    Exit('exit, made by the routine ' + IntToStr(N));
  Result := '';
end;

function ExitGlobal(N: Integer): string;
begin
  if N > 0 then
    Exit(G);
  Result := '';
end;

procedure FillFrom(var S: string);
begin
  S := G;
end;

procedure FillFresh(var S: string; N: Integer);
begin
  S := 'filled, made by the routine ' + IntToStr(N);
end;

function ByVarGlobal: string;
begin
  FillFrom(Result);
end;

function ByVarFresh(N: Integer): string;
begin
  FillFresh(Result, N);
end;

function ByNested: string;

  procedure Inner;
  begin
    Result := G;
  end;

begin
  Inner;
end;

function FromMap: string;
begin
  Result := m[1];
end;

function FromTryGet: string;
begin
  if not TryGet(m, 1, Result) then
    Result := '';
end;

function FromTree: string;
begin
  Result := t[1];
end;

function FromLoop: string;
var
  v: string;
begin
  Result := '';
  for v in arr do
    Result := v;
end;

function Chain(N: Integer): string;
begin
  Result := Fresh(N);
end;

function ChainGlobal: string;
begin
  Result := FromGlobal;
end;

function Keep(N: Integer): string;
begin
  Result := 'kept, made by the routine ' + IntToStr(N);
  G := Result;
end;

function StoredInMap(N: Integer): string;
begin
  Result := 'stored, made by the routine ' + IntToStr(N);
  m[3] := Result;
end;

function SentOnChan(N: Integer): string;
begin
  Result := 'sent, made by the routine ' + IntToStr(N);
  Send(ch, Result);
end;

function Twice(const A: string): string;
begin
  Result := A + A;
end;

function GetG: string;
begin
  Result := G;
end;

function Captures(S: string): TGetter;
begin
  Result := function: string
  begin
    Result := S;
  end;
end;

function Makes(N: Integer): TGetter;
begin
  Result := function: string
  begin
    Result := 'closure, made by the routine ' + IntToStr(N);
  end;
end;

procedure Scribble(S: string);
begin
  S[1] := 'Q';
  SetLength(S, 3);
end;

function TNamed.Name: string;
begin
  Result := FName;
end;

function TNamed.Fresh(N: Integer): string;
begin
  Result := 'method, made by the routine ' + IntToStr(N);
end;

function TNamed.GetLabel: string;
begin
  Result := FName;
end;

function TTitled.Title: string;
begin
  Result := FTitle;
end;

function TTitled.Made(N: Integer): string;
begin
  Result := 'interface, made by the routine ' + IntToStr(N);
end;

procedure Report(const Way: string; var R: string; const Want: string; Held: Boolean;
  var Source: string; const SourceWas: string);
var
  mk: Integer;
  was: string;
begin
  mk := Marked(R);
  was := R;
  R[1] := 'Z';
  if Held then
    WriteLn(Way, ': marked ', mk, ', the holder unchanged ', Ord(Source = SourceWas),
      ', the result right ', Ord(R = 'Z' + Copy(Want, 2, Length(Want))))
  else
    WriteLn(Way, ': marked ', mk, ', the result right ', Ord((was = Want) and (R = 'Z' + Copy(Want, 2, Length(Want)))));
end;

procedure Shorten(const Way: string; var R: string; const Want: string);
begin
  p := Words(R);
  SetLength(R, Length(R) - 1);
  WriteLn(Way, ': shortened in its own block ', Ord(Words(R) = p), ', the result right ',
    Ord(R = Copy(Want, 1, Length(Want) - 1)));
end;

var
  src, got, none: string;

begin
  x := 7;
  New(m);
  New(t);
  ch := MakeChan(1);
  G := 'global ' + IntToStr(x);
  m[1] := 'map value ' + IntToStr(x);
  t[1] := 'tree value ' + IntToStr(x);
  SetLength(arr, 2);
  arr[0] := 'first ' + IntToStr(x);
  arr[1] := 'last ' + IntToStr(x);
  obj := TNamed.Create;
  obj.FName := 'field ' + IntToStr(x);
  ti := TTitled.Create;
  ti.FTitle := 'title ' + IntToStr(x);
  intf := ti;
  none := '';

  { made by the routine: nothing else holds it }
  s := Fresh(1);
  Report('a fresh result', s, 'fresh, made by the routine 1', False, none, '');
  s := Fresh(2);
  Shorten('a fresh result', s, 'fresh, made by the routine 2');
  s := Chain(3);
  Report('a fresh result through a call', s, 'fresh, made by the routine 3', False, none, '');
  s := ExitFresh(4);
  Report('Exit of a fresh string', s, 'exit, made by the routine 4', False, none, '');
  s := ByVarFresh(5);
  Report('a var argument given a fresh string', s, 'filled, made by the routine 5', False, none, '');
  s := Twice('ab' + IntToStr(x));
  Report('a concatenation', s, 'ab7ab7', False, none, '');
  s := obj.Fresh(6);
  Report('a method''s fresh result', s, 'method, made by the routine 6', False, none, '');
  s := intf.Made(7);
  Report('an interface method''s fresh result', s, 'interface, made by the routine 7', False, none, '');
  s := intf.Made(8);
  Shorten('an interface method''s fresh result', s, 'interface, made by the routine 8');
  getter := Makes(9);
  s := getter();
  Report('a closure''s fresh result', s, 'closure, made by the routine 9', False, none, '');
  s := Trim('  trimmed ' + IntToStr(x) + ' ');
  Report('Trim of a string with spaces', s, 'trimmed 7', False, none, '');
  s := Fresh(13);
  Scribble(s);
  WriteLn('a fresh result given by value to a routine that writes it: unchanged ',
    Ord(s = 'fresh, made by the routine 13'));

  { held by another variable: marked, and the holder never changes }
  src := G;
  s := FromGlobal;
  Report('a global', s, src, True, G, src);
  s := FromParam(G);
  Report('a const parameter', s, src, True, G, src);
  s := ExitGlobal(1);
  Report('Exit of a global', s, src, True, G, src);
  s := ByVarGlobal;
  Report('a var argument given a global', s, src, True, G, src);
  s := ByNested;
  Report('a nested routine', s, src, True, G, src);
  s := ChainGlobal;
  Report('a global through a call', s, src, True, G, src);
  getter := @GetG;
  s := getter();
  Report('a routine value', s, src, True, G, src);
  getter := Captures(G);
  s := getter();
  Report('a closure''s captured string', s, src, True, G, src);
  s := Trim(G);
  Report('Trim of a string with nothing to trim', s, src, True, G, src);
  s := FromGlobal;
  Shorten('a global', s, src);
  WriteLn('the global ', G);

  src := m[1];
  s := FromMap;
  Report('a map''s value', s, src, True, m[1], src);
  src := m[1];
  s := FromTryGet;
  Report('TryGet of a map', s, src, True, m[1], src);
  src := t[1];
  s := FromTree;
  Report('a tree''s value', s, src, True, t[1], src);
  src := arr[1];
  s := FromLoop;
  Report('a loop variable', s, src, True, arr[1], src);
  src := obj.FName;
  s := obj.Name;
  Report('a method''s field', s, src, True, obj.FName, src);
  s := obj.Caption;
  Report('a property read from a field', s, src, True, obj.FName, src);
  s := obj.Labelled;
  Report('a property read by a method', s, src, True, obj.FName, src);
  src := ti.FTitle;
  s := intf.Title;
  Report('an interface method''s field', s, src, True, ti.FTitle, src);

  { made by the routine and kept by it too: marked }
  s := Keep(10);
  src := G;
  Report('a result the routine also kept in a global', s, src, True, G, src);
  s := StoredInMap(11);
  src := m[3];
  Report('a result the routine also kept in a map', s, src, True, m[3], src);
  s := SentOnChan(12);
  got := Recv(ch);
  Report('a result the routine also sent on a channel', s, 'sent, made by the routine 12', True,
    got, 'sent, made by the routine 12');
  m[2] := Fresh(14);
  if TryGet(m, 2, s) then
    Report('a fresh result kept by a map', s, 'fresh, made by the routine 14', True, m[2], 'fresh, made by the routine 14');
end.

