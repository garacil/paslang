    if (gy255.A[i] <> Byte((i * 5 + 9) and 255)) or (gx255.A[i] <> 0) or (x.A[i] <> Byte((i * 5 + 3) and 255)) then
      ok := False;
  if not ok then
    Report(255, 'global copy');
end;

function Make256(K: Integer): TB256;
var
  i: Integer;
begin
  for i := 1 to 256 do
    Result[i] := Byte((i * 5 + K) and 255);
end;

procedure T256;
var
  x, y: TG256;
  p, q: PG256;
  d: array of TG256;
  i: Integer;
  ok: Boolean;
begin
  y.Pre := 5;
  y.Post := 6;
  for i := 1 to 256 do
    y.A[i] := Byte((i * 7 + 256) and 255);
  x.Pre := -1;
  x.Post := -2;
  for i := 1 to 256 do
    x.A[i] := 238;
  x.A := y.A;
  ok := (x.Pre = -1) and (x.Post = -2);
  for i := 1 to 256 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(256, 'field copy');
  x.A := Default(TB256);
  ok := (x.Pre = -1) and (x.Post = -2);
  for i := 1 to 256 do
    if x.A[i] <> 0 then
      ok := False;
  if not ok then
    Report(256, 'zero');
  x := y;
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 256 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(256, 'whole copy');
  for i := 1 to 256 do
    x.A[i] := 17;
  p := @x;
  q := @y;
  p^.A := q^.A;
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 256 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(256, 'pointer copy');
  SetLength(d, 3);
  d[1] := y;
  d[2].A := d[1].A;
  d[0] := d[2];
  ok := (d[1].Pre = 5) and (d[2].Pre = 0) and (d[2].Post = 0) and (d[0].Post = 0);
  for i := 1 to 256 do
    if (d[0].A[i] <> y.A[i]) or (d[2].A[i] <> y.A[i]) then
      ok := False;
  if not ok then
    Report(256, 'element copy');
  x.A := Make256(3);
  gx256.A := Make256(9);
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 256 do
    if (x.A[i] <> Byte((i * 5 + 3) and 255)) or (gx256.A[i] <> Byte((i * 5 + 9) and 255)) then
      ok := False;
  if not ok then
    Report(256, 'result copy');
  x := x;
  x.A := x.A;
  gy256 := gx256;
  gy256.Pre := 77;
  gx256 := Default(TG256);
  ok := (x.Pre = 5) and (x.Post = 6) and (gy256.Pre = 77) and (gx256.Pre = 0) and (gx256.Post = 0);
  for i := 1 to 256 do
    if (gy256.A[i] <> Byte((i * 5 + 9) and 255)) or (gx256.A[i] <> 0) or (x.A[i] <> Byte((i * 5 + 3) and 255)) then
      ok := False;
  if not ok then
    Report(256, 'global copy');
end;

