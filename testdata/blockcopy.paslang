  gx257, gy257: TG257;
  gx300, gy300: TG300;

procedure Report(N: Integer; const What: string);
begin
  WriteLn(N, ' bad ', What);
  Inc(bad);
end;

function Make1(K: Integer): TB1;
var
  i: Integer;
begin
  for i := 1 to 1 do
    Result[i] := Byte((i * 5 + K) and 255);
end;

procedure T1;
var
  x, y: TG1;
  p, q: PG1;
  d: array of TG1;
  i: Integer;
  ok: Boolean;
begin
  y.Pre := 5;
  y.Post := 6;
  for i := 1 to 1 do
    y.A[i] := Byte((i * 7 + 1) and 255);
  x.Pre := -1;
  x.Post := -2;
  for i := 1 to 1 do
    x.A[i] := 238;
  x.A := y.A;
  ok := (x.Pre = -1) and (x.Post = -2);
  for i := 1 to 1 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(1, 'field copy');
  x.A := Default(TB1);
  ok := (x.Pre = -1) and (x.Post = -2);
  for i := 1 to 1 do
    if x.A[i] <> 0 then
      ok := False;
  if not ok then
    Report(1, 'zero');
  x := y;
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 1 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(1, 'whole copy');
  for i := 1 to 1 do
    x.A[i] := 17;
  p := @x;
  q := @y;
  p^.A := q^.A;
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 1 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(1, 'pointer copy');
  SetLength(d, 3);
  d[1] := y;
  d[2].A := d[1].A;
  d[0] := d[2];
  ok := (d[1].Pre = 5) and (d[2].Pre = 0) and (d[2].Post = 0) and (d[0].Post = 0);
  for i := 1 to 1 do
    if (d[0].A[i] <> y.A[i]) or (d[2].A[i] <> y.A[i]) then
      ok := False;
  if not ok then
    Report(1, 'element copy');
  x.A := Make1(3);
  gx1.A := Make1(9);
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 1 do
    if (x.A[i] <> Byte((i * 5 + 3) and 255)) or (gx1.A[i] <> Byte((i * 5 + 9) and 255)) then
      ok := False;
  if not ok then
    Report(1, 'result copy');
  x := x;
  x.A := x.A;
  gy1 := gx1;
  gy1.Pre := 77;
  gx1 := Default(TG1);
  ok := (x.Pre = 5) and (x.Post = 6) and (gy1.Pre = 77) and (gx1.Pre = 0) and (gx1.Post = 0);
  for i := 1 to 1 do
    if (gy1.A[i] <> Byte((i * 5 + 9) and 255)) or (gx1.A[i] <> 0) or (x.A[i] <> Byte((i * 5 + 3) and 255)) then
      ok := False;
  if not ok then
    Report(1, 'global copy');
end;

function Make2(K: Integer): TB2;
var
  i: Integer;
begin
  for i := 1 to 2 do
    Result[i] := Byte((i * 5 + K) and 255);
end;

procedure T2;
var
  x, y: TG2;
  p, q: PG2;
  d: array of TG2;
  i: Integer;
  ok: Boolean;
begin
  y.Pre := 5;
  y.Post := 6;
  for i := 1 to 2 do
    y.A[i] := Byte((i * 7 + 2) and 255);
  x.Pre := -1;
  x.Post := -2;
  for i := 1 to 2 do
    x.A[i] := 238;
  x.A := y.A;
  ok := (x.Pre = -1) and (x.Post = -2);
  for i := 1 to 2 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(2, 'field copy');
  x.A := Default(TB2);
  ok := (x.Pre = -1) and (x.Post = -2);
  for i := 1 to 2 do
    if x.A[i] <> 0 then
      ok := False;
  if not ok then
    Report(2, 'zero');
  x := y;
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 2 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(2, 'whole copy');
  for i := 1 to 2 do
    x.A[i] := 17;
  p := @x;
  q := @y;
  p^.A := q^.A;
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 2 do
    if x.A[i] <> y.A[i] then
      ok := False;
  if not ok then
    Report(2, 'pointer copy');
  SetLength(d, 3);
  d[1] := y;
  d[2].A := d[1].A;
  d[0] := d[2];
  ok := (d[1].Pre = 5) and (d[2].Pre = 0) and (d[2].Post = 0) and (d[0].Post = 0);
  for i := 1 to 2 do
    if (d[0].A[i] <> y.A[i]) or (d[2].A[i] <> y.A[i]) then
      ok := False;
  if not ok then
    Report(2, 'element copy');
  x.A := Make2(3);
  gx2.A := Make2(9);
  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 2 do
    if (x.A[i] <> Byte((i * 5 + 3) and 255)) or (gx2.A[i] <> Byte((i * 5 + 9) and 255)) then
      ok := False;
  if not ok then
    Report(2, 'result copy');
  x := x;
  x.A := x.A;
  gy2 := gx2;
  gy2.Pre := 77;
  gx2 := Default(TG2);
  ok := (x.Pre = 5) and (x.Post = 6) and (gy2.Pre = 77) and (gx2.Pre = 0) and (gx2.Post = 0);
  for i := 1 to 2 do
    if (gy2.A[i] <> Byte((i * 5 + 9) and 255)) or (gx2.A[i] <> 0) or (x.A[i] <> Byte((i * 5 + 3) and 255)) then
      ok := False;
  if not ok then
    Report(2, 'global copy');
end;

