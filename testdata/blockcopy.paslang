function Make4(K: Integer): TB4;
var
  i: Integer;
begin
  for i := 1 to 4 do
    Result[i] := Byte((i * 5 + K) and 255);
end;

procedure T4;
var
  x, y: TG4;
  p, q: PG4;
  d: array of TG4;
  i: Integer;
  ok: Boolean;
begin
  y.Pre := 5;
  y.Post := 6;
  for i := 1 to 4 do
    y.A[i] := Byte((i * 7 + 4) and 255);
  x.Pre := -1;
  x.Post := -2;
