      ok := False;
  if not ok then
    Report(3, 'pointer copy');
  SetLength(d, 3);
  d[1] := y;
  d[2].A := d[1].A;
  d[0] := d[2];
  ok := (d[1].Pre = 5) and (d[2].Pre = 0) and (d[2].Post = 0) and (d[0].Post = 0);
  for i := 1 to 3 do
