{ P370: a block assigned is Move's copy of its size, in line up to 128
  bytes, and Default(T) is its zero: arrays of bytes of every size from
  1 to 40 and on every chunk's edge up to 300, between two guards, copied
  field to field, whole, through pointers, into and out of elements of a
  dynamic array and from a routine's result, then zeroed, the bytes
  around each left as they were. Records with strings are copied and
  marked shared: a write into the copy's string leaves the source's. }
program blockcopy;

uses
  SysUtils;

type
  TB1 = array[1..1] of Byte;
  TG1 = record
    Pre: Int64;
    A: TB1;
    Post: Int64;
  end;
  PG1 = ^TG1;
  TB2 = array[1..2] of Byte;
  TG2 = record
    Pre: Int64;
    A: TB2;
    Post: Int64;
  end;
