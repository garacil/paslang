    case Integer of
      0: (Pad: Int64; A: TB16);
      1: (B: TB16);
  end;
  TV200 = record
    case Integer of
      0: (Pad: Int64; A: TB200);
      1: (B: TB200);
  end;
  TBigStr = record
    S: string;
    Pad: array[1..200] of Byte;
    T: string;
  end;

var
  bad: Integer;

  gx1, gy1: TG1;
  gx2, gy2: TG2;
  gx3, gy3: TG3;
  gx4, gy4: TG4;
  gx5, gy5: TG5;
  gx6, gy6: TG6;
  gx7, gy7: TG7;
  gx8, gy8: TG8;
  gx9, gy9: TG9;
  gx10, gy10: TG10;
  gx11, gy11: TG11;
  gx12, gy12: TG12;
  gx13, gy13: TG13;
  gx14, gy14: TG14;
  gx15, gy15: TG15;
  gx16, gy16: TG16;
  gx17, gy17: TG17;
  gx18, gy18: TG18;
  gx19, gy19: TG19;
  gx20, gy20: TG20;
  gx21, gy21: TG21;
