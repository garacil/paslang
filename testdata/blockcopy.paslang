  ok := (x.Pre = 5) and (x.Post = 6);
  for i := 1 to 3 do
    if (x.A[i] <> Byte((i * 5 + 3) and 255)) or (gx3.A[i] <> Byte((i * 5 + 9) and 255)) then
      ok := False;
  if not ok then
    Report(3, 'result copy');
  x := x;
  x.A := x.A;
  gy3 := gx3;
  gy3.Pre := 77;
  gx3 := Default(TG3);
  ok := (x.Pre = 5) and (x.Post = 6) and (gy3.Pre = 77) and (gx3.Pre = 0) and (gx3.Post = 0);
  for i := 1 to 3 do
    if (gy3.A[i] <> Byte((i * 5 + 9) and 255)) or (gx3.A[i] <> 0) or (x.A[i] <> Byte((i * 5 + 3) and 255)) then
      ok := False;
  if not ok then
    Report(3, 'global copy');
