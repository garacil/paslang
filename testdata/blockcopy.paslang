procedure Strings;
var
  a, b: TStrRec;
  c, e: TBigStr;
  i: Integer;
begin
  a.N := 4;
  a.S := 'abc' + IntToStr(a.N);
  a.T := 'xyz' + IntToStr(a.N);
  b := a;
  b.S[1] := 'X';
  b.T[2] := 'Q';
  WriteLn('strings ', a.S, ' ', a.T, ' ', b.S, ' ', b.T, ' ', b.N);
  c.S := 'big' + IntToStr(a.N);
  c.T := 'tail' + IntToStr(a.N);
  for i := 1 to 200 do
    c.Pad[i] := Byte(i);
  e := c;
  e.S[1] := 'B';
  e.T[1] := 'T';
  WriteLn('big strings ', c.S, ' ', c.T, ' ', e.S, ' ', e.T, ' ', e.Pad[200]);
  b := Default(TStrRec);
  WriteLn('zero strings ', Length(b.S), ' ', Length(b.T), ' ', b.N);
end;

{ two fields of one type in two variants, eight bytes apart: the copy
  reads every byte before it writes over it, both ways }
procedure Variants;
var
  v: TV16;
  w: TV200;
  i: Integer;
  ok: Boolean;
begin
  for i := 1 to 16 do
    v.B[i] := Byte(i);
  v.A := v.B;
  ok := True;
  for i := 1 to 16 do
    if v.A[i] <> i then
      ok := False;
  for i := 1 to 16 do
    v.A[i] := Byte(i + 100);
  v.B := v.A;
  for i := 1 to 16 do
    if v.B[i] <> i + 100 then
      ok := False;
  WriteLn('variant 16 ', ok);
  for i := 1 to 200 do
    w.B[i] := Byte(i);
  w.A := w.B;
  ok := True;
  for i := 1 to 200 do
    if w.A[i] <> i then
      ok := False;
  for i := 1 to 200 do
    w.A[i] := Byte(i + 50);
  w.B := w.A;
  for i := 1 to 200 do
    if w.B[i] <> Byte(i + 50) then
      ok := False;
  WriteLn('variant 200 ', ok);
end;

