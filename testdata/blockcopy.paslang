  gx28, gy28: TG28;
  gx29, gy29: TG29;
  gx30, gy30: TG30;
  gx31, gy31: TG31;
  gx32, gy32: TG32;
  gx33, gy33: TG33;
  gx34, gy34: TG34;
  gx35, gy35: TG35;
  gx36, gy36: TG36;
  gx37, gy37: TG37;
  gx38, gy38: TG38;
  gx39, gy39: TG39;
  gx40, gy40: TG40;
  gx47, gy47: TG47;
  gx48, gy48: TG48;
  gx63, gy63: TG63;
  gx64, gy64: TG64;
  gx65, gy65: TG65;
  gx96, gy96: TG96;
  gx97, gy97: TG97;
  gx112, gy112: TG112;
  gx127, gy127: TG127;
  gx128, gy128: TG128;
