program dwarfcurrency;
procedure Show;
var amount, upper, lower: Currency;
begin
  amount := 2.675; upper := High(Currency); lower := Low(Currency);
  WriteLn(amount, ' ', upper, ' ', lower);
end;
begin Show end.
