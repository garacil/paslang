program auditfix;

{ The code faults the documentation audit of 1.0.135 found (1.0.136):
  Append(s, [a, b]) appends a and b; Default of any type; a bare Syscall
  statement makes the call; an interface method takes const parameters;
  DumpLocals on both machines; Length of a Char; High and Low of an
  ordinal value are its type's bounds, Low of a string is 1. }

type
  TInts = array of Integer;
  TStrs = array of string;
  TGrid = array of TInts;
  ISay = interface
    function Say(const S: string; out N: Integer): string;
  end;
  TSay = class(ISay)
    function Say(const S: string; out N: Integer): string;
  end;

function TSay.Say(const S: string; out N: Integer): string;
begin
  N := Length(S);
  Result := S + '!';
end;

procedure Locals;
var
  alpha, beta: Integer;
  b: Byte;
begin
  alpha := 7;
  beta := -3;
  b := 200;
  DumpLocals;
end;

var
  a: TInts;
  ss: TStrs;
  g: TGrid;
  i, n, nr: Integer;
  s: string;
  bt: Byte;
  i8: Int8;
  c: Char;
  t: ISay;
  msg: string;

begin
  a := [1, 2, 3];
  a := Append(a, [10, 20]);
  a := Append(a, []);
  for i := 0 to High(a) do
    Write(a[i], ' ');
  WriteLn(Length(a));
  ss := Append(ss, ['x', 'y']);
  WriteLn(ss[0], ss[1], Length(ss));
  g := Append(g, [4, 5]);
  WriteLn(Length(g), ' ', Length(g[0]), ' ', g[0][1]);
  WriteLn(Default(Integer), ' [', Default(string), '] ', Default(Boolean), ' ', Default(Byte));
  msg := 'sys' + #10;
  if Amd64 then
    nr := 1
  else
    nr := 64;
  Syscall(nr, 1, Integer(@msg[1]), 4);
  nr := 0;
  t := TSay.Create;
  WriteLn(t.Say('hi', n), ' ', n);
  Locals;
  c := 'q';
  WriteLn(Length(c), ' ', Length('abc'));
  WriteLn(High(bt), ' ', Low(bt), ' ', High(i8), ' ', Low(i8), ' ', Ord(High(c)));
  s := 'hello';
  WriteLn(Low(s), ' ', High(s), ' ', s[Low(s)], s[High(s)]);
end.

