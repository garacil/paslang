procedure SetBool(A, B: Integer; out X: Boolean);
begin
  X := A > B;
end;

procedure SetChar(A: Integer; out X: Char);
begin
  X := Chr(65 + A);
end;

procedure SetReal(A: Integer; out X: Double);
begin
  X := A * 1.5;
end;

procedure SetSingle(A: Integer; out X: Single);
begin
  X := A * 0.5;
end;

procedure SetColor(A: Integer; out X: TColor);
begin
  if A > 2 then
    X := cBlue
  else
    X := cRed;
end;

procedure SetStr(A: Integer; out X: string);
begin
  X := 'n=' + IntToStr(A);
end;

procedure SetPtr(var V: Integer; out X: PInt);
begin
  X := @V;
end;

procedure BumpRef(P: PInt; var X: Integer);
begin
  X := P^ + 1;
end;

procedure NestOuter(var X: Integer; A: Integer);
  procedure Inner;
  begin
    X := A * 2 + 1;
  end;
begin
  Inner;
  Inner;
end;

procedure Kinds;
var
  b: Boolean;
  c: Char;
  d: Double;
  s: Single;
  col: TColor;
  txt: string;
  p: PInt;
  v, w: Integer;
  i: Integer;
begin
  for i := 1 to 4 do
  begin
    SetBool(i, 2, b);
    WriteLn(b);
    SetChar(i, c);
    WriteLn(c);
    SetReal(i, d);
    WriteLn(d);
    SetSingle(i, s);
    WriteLn(s);
    SetColor(i, col);
    WriteLn(Ord(col));
    SetStr(i, txt);
    WriteLn(txt);
    v := i * 11;
    SetPtr(v, p);
    BumpRef(p, w);
    WriteLn(w);
    NestOuter(w, i);
    WriteLn(w);
  end;
end;

begin
  RunByte;
  RunInt8;
  RunWord;
  RunInt16;
  RunUInt32;
  RunInt32;
  RunInteger;
  RunInt64;
  Kinds;
end.
