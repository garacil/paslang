  WriteLn(x, ' ', y);
  z := Int8(-128);
  LoopInt8(z, 7);
  WriteLn(z);
  PassInt8(z, Int8(-128));
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 7;
  y := Int8(-128);
  SetInt8(x, y, cells[2]);
  IncInt8(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillInt8(x, z);
  WriteLn(z);
  WideInt8(x, w);
  WriteLn(w);
  ConvInt8(w, z);
  WriteLn(z);
  x := 42;
  y := 2;
  SetInt8(x, y, z);
  WriteLn(z);
  IncInt8(z, x);
  WriteLn(z);
  CallInt8(x, y, z);
  WriteLn(z);
  TwoInt8(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 2;
  LoopInt8(z, 42);
  WriteLn(z);
  PassInt8(z, 2);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 42;
  y := 2;
  SetInt8(x, y, cells[2]);
  IncInt8(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillInt8(x, z);
  WriteLn(z);
  WideInt8(x, w);
  WriteLn(w);
  ConvInt8(w, z);
  WriteLn(z);
  x := 63;
  y := 127;
  SetInt8(x, y, z);
  WriteLn(z);
  IncInt8(z, x);
  WriteLn(z);
  CallInt8(x, y, z);
  WriteLn(z);
  TwoInt8(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 127;
  LoopInt8(z, 63);
  WriteLn(z);
  PassInt8(z, 127);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 63;
  y := 127;
  SetInt8(x, y, cells[2]);
  IncInt8(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillInt8(x, z);
  WriteLn(z);
  WideInt8(x, w);
  WriteLn(w);
  ConvInt8(w, z);
  WriteLn(z);
  x := 126;
  y := 1;
  SetInt8(x, y, z);
  WriteLn(z);
  IncInt8(z, x);
  WriteLn(z);
  CallInt8(x, y, z);
  WriteLn(z);
