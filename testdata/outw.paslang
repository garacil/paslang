function MixInt16(A: Int16): Int16;
begin
  Result := A * 5 + 1;
end;

procedure SetInt16(A, B: Int16; out X: Int16);
begin
  X := A * 3 + B;
end;

procedure IncInt16(var X: Int16; A: Int16);
begin
  X := X + A;
end;

procedure CallInt16(A, B: Int16; out X: Int16);
begin
  X := MixInt16(A) + B;
end;

procedure TwoInt16(A, B: Int16; out X, Y: Int16);
begin
  X := A + B;
  Y := A - B;
end;

procedure LoopInt16(var X: Int16; A: Int16);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := X + A;
end;

procedure PassInt16(var X: Int16; A: Int16);
begin
  IncInt16(X, A);
  IncInt16(X, A);
end;

procedure FillInt16(A: Int16; out X: Int16);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := A * 3 + Int16(i);
end;

procedure WideInt16(A: Int16; out X: Integer);
begin
  X := A;
end;

procedure ConvInt16(A: Integer; out X: Int16);
begin
  X := Int16(A * 3);
end;

