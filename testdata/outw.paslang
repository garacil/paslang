  cells[3] := 44;
  x := 2;
  y := 7;
  SetInt8(x, y, cells[2]);
  IncInt8(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillInt8(x, z);
  WriteLn(z);
  WideInt8(x, w);
  WriteLn(w);
