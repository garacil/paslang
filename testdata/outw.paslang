  IncInt8(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillInt8(x, z);
  WriteLn(z);
  WideInt8(x, w);
  WriteLn(w);
  ConvInt8(w, z);
  WriteLn(z);
  x := 1;
  y := Int8(-127);
  SetInt8(x, y, z);
  WriteLn(z);
  IncInt8(z, x);
  WriteLn(z);
  CallInt8(x, y, z);
  WriteLn(z);
  TwoInt8(x, y, x, y);
  WriteLn(x, ' ', y);
  z := Int8(-127);
  LoopInt8(z, 1);
  WriteLn(z);
  PassInt8(z, Int8(-127));
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 1;
  y := Int8(-127);
  SetInt8(x, y, cells[2]);
  IncInt8(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillInt8(x, z);
  WriteLn(z);
  WideInt8(x, w);
  WriteLn(w);
  ConvInt8(w, z);
  WriteLn(z);
  x := 2;
  y := 7;
  SetInt8(x, y, z);
  WriteLn(z);
  IncInt8(z, x);
  WriteLn(z);
  CallInt8(x, y, z);
  WriteLn(z);
  TwoInt8(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 7;
  LoopInt8(z, 2);
  WriteLn(z);
  PassInt8(z, 7);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
