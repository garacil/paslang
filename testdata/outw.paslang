function MixInt8(A: Int8): Int8;
begin
  Result := A * 5 + 1;
end;

procedure SetInt8(A, B: Int8; out X: Int8);
begin
  X := A * 3 + B;
end;

procedure IncInt8(var X: Int8; A: Int8);
begin
  X := X + A;
end;

procedure CallInt8(A, B: Int8; out X: Int8);
begin
  X := MixInt8(A) + B;
end;

procedure TwoInt8(A, B: Int8; out X, Y: Int8);
begin
  X := A + B;
  Y := A - B;
end;

procedure LoopInt8(var X: Int8; A: Int8);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := X + A;
end;

procedure PassInt8(var X: Int8; A: Int8);
begin
  IncInt8(X, A);
  IncInt8(X, A);
end;

procedure FillInt8(A: Int8; out X: Int8);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := A * 3 + Int8(i);
end;

procedure WideInt8(A: Int8; out X: Integer);
begin
  X := A;
end;

procedure ConvInt8(A: Integer; out X: Int8);
begin
  X := Int8(A * 3);
end;

procedure RunInt8;
var
  x, y, z: Int8;
  cells: array[0..3] of Int8;
  w: Integer;
begin
  x := Int8(-128);
  y := 0;
  SetInt8(x, y, z);
  WriteLn(z);
  IncInt8(z, x);
  WriteLn(z);
  CallInt8(x, y, z);
  WriteLn(z);
  TwoInt8(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 0;
  LoopInt8(z, Int8(-128));
  WriteLn(z);
  PassInt8(z, 0);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := Int8(-128);
  y := 0;
  SetInt8(x, y, cells[2]);
  IncInt8(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillInt8(x, z);
  WriteLn(z);
  WideInt8(x, w);
  WriteLn(w);
  ConvInt8(w, z);
  WriteLn(z);
  x := Int8(-127);
  y := 63;
  SetInt8(x, y, z);
  WriteLn(z);
  IncInt8(z, x);
  WriteLn(z);
  CallInt8(x, y, z);
  WriteLn(z);
  TwoInt8(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 63;
  LoopInt8(z, Int8(-127));
  WriteLn(z);
  PassInt8(z, 63);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := Int8(-127);
  y := 63;
  SetInt8(x, y, cells[2]);
  IncInt8(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillInt8(x, z);
  WriteLn(z);
  WideInt8(x, w);
  WriteLn(w);
  ConvInt8(w, z);
  WriteLn(z);
  x := Int8(-1);
  y := Int8(-1);
  SetInt8(x, y, z);
  WriteLn(z);
  IncInt8(z, x);
  WriteLn(z);
  CallInt8(x, y, z);
  WriteLn(z);
  TwoInt8(x, y, x, y);
  WriteLn(x, ' ', y);
  z := Int8(-1);
