function MixUInt32(A: UInt32): UInt32;
begin
  Result := A * 5 + 1;
end;

procedure SetUInt32(A, B: UInt32; out X: UInt32);
begin
  X := A * 3 + B;
end;

procedure IncUInt32(var X: UInt32; A: UInt32);
begin
  X := X + A;
end;

procedure CallUInt32(A, B: UInt32; out X: UInt32);
begin
  X := MixUInt32(A) + B;
end;

procedure TwoUInt32(A, B: UInt32; out X, Y: UInt32);
begin
  X := A + B;
  Y := A - B;
end;

