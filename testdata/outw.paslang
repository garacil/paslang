function MixInt32(A: Int32): Int32;
begin
  Result := A * 5 + 1;
end;

procedure SetInt32(A, B: Int32; out X: Int32);
begin
  X := A * 3 + B;
end;

procedure IncInt32(var X: Int32; A: Int32);
begin
  X := X + A;
end;

procedure CallInt32(A, B: Int32; out X: Int32);
begin
  X := MixInt32(A) + B;
end;

procedure TwoInt32(A, B: Int32; out X, Y: Int32);
begin
  X := A + B;
  Y := A - B;
end;

procedure LoopInt32(var X: Int32; A: Int32);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := X + A;
end;

procedure PassInt32(var X: Int32; A: Int32);
begin
  IncInt32(X, A);
  IncInt32(X, A);
end;

procedure FillInt32(A: Int32; out X: Int32);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := A * 3 + Int32(i);
end;

procedure WideInt32(A: Int32; out X: Integer);
begin
  X := A;
end;

procedure ConvInt32(A: Integer; out X: Int32);
begin
  X := Int32(A * 3);
