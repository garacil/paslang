program outw;

{ P535: writes to var and out parameters, every width and kind }

uses
  sysutils;

type
  TColor = (cRed, cGreen, cBlue, cWhite);
  PInt = ^Integer;

var
  gtotal: Integer;

function MixByte(A: Byte): Byte;
begin
  Result := A * 5 + 1;
end;

procedure SetByte(A, B: Byte; out X: Byte);
begin
  X := A * 3 + B;
end;

procedure IncByte(var X: Byte; A: Byte);
begin
  X := X + A;
end;

procedure CallByte(A, B: Byte; out X: Byte);
begin
  X := MixByte(A) + B;
end;

procedure TwoByte(A, B: Byte; out X, Y: Byte);
begin
  X := A + B;
  Y := A - B;
end;

procedure LoopByte(var X: Byte; A: Byte);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := X + A;
end;

procedure PassByte(var X: Byte; A: Byte);
begin
  IncByte(X, A);
  IncByte(X, A);
end;

procedure FillByte(A: Byte; out X: Byte);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := A * 3 + Byte(i);
end;

procedure WideByte(A: Byte; out X: Integer);
begin
  X := A;
end;

procedure ConvByte(A: Integer; out X: Byte);
begin
  X := Byte(A * 3);
end;

procedure RunByte;
var
  x, y, z: Byte;
  cells: array[0..3] of Byte;
  w: Integer;
begin
  x := 0;
  y := 0;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 0;
  LoopByte(z, 0);
  WriteLn(z);
  PassByte(z, 0);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 0;
  y := 0;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 1;
  y := 127;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 127;
  LoopByte(z, 1);
  WriteLn(z);
  PassByte(z, 127);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 1;
  y := 127;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 1;
  y := 1;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 1;
  LoopByte(z, 1);
  WriteLn(z);
  PassByte(z, 1);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 1;
  y := 1;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 0;
  y := 85;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 85;
  LoopByte(z, 0);
  WriteLn(z);
  PassByte(z, 85);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 0;
  y := 85;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 1;
  y := 1;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 1;
  LoopByte(z, 1);
  WriteLn(z);
  PassByte(z, 1);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 1;
  y := 1;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 2;
  y := 7;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 7;
  LoopByte(z, 2);
  WriteLn(z);
  PassByte(z, 7);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 2;
  y := 7;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 7;
  y := 0;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 0;
  LoopByte(z, 7);
  WriteLn(z);
  PassByte(z, 0);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 7;
  y := 0;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 85;
  y := 2;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 2;
  LoopByte(z, 85);
  WriteLn(z);
  PassByte(z, 2);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 85;
  y := 2;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 127;
  y := 255;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 255;
  LoopByte(z, 127);
  WriteLn(z);
  PassByte(z, 255);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 127;
  y := 255;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 254;
  y := 1;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
  z := 1;
  LoopByte(z, 254);
  WriteLn(z);
  PassByte(z, 1);
  WriteLn(z);
  cells[0] := 11;
  cells[1] := 22;
  cells[2] := 33;
  cells[3] := 44;
  x := 254;
  y := 1;
  SetByte(x, y, cells[2]);
  IncByte(cells[1], x);
  WriteLn(cells[0], ' ', cells[1], ' ', cells[2], ' ', cells[3]);
  FillByte(x, z);
  WriteLn(z);
  WideByte(x, w);
  WriteLn(w);
  ConvByte(w, z);
  WriteLn(z);
  x := 255;
  y := 254;
  SetByte(x, y, z);
  WriteLn(z);
  IncByte(z, x);
  WriteLn(z);
  CallByte(x, y, z);
  WriteLn(z);
  TwoByte(x, y, x, y);
  WriteLn(x, ' ', y);
