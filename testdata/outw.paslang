function MixWord(A: Word): Word;
begin
  Result := A * 5 + 1;
end;

procedure SetWord(A, B: Word; out X: Word);
begin
  X := A * 3 + B;
end;

procedure IncWord(var X: Word; A: Word);
begin
  X := X + A;
end;

procedure CallWord(A, B: Word; out X: Word);
begin
  X := MixWord(A) + B;
end;

procedure TwoWord(A, B: Word; out X, Y: Word);
begin
  X := A + B;
  Y := A - B;
end;

procedure LoopWord(var X: Word; A: Word);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := X + A;
end;

procedure PassWord(var X: Word; A: Word);
begin
  IncWord(X, A);
  IncWord(X, A);
end;

procedure FillWord(A: Word; out X: Word);
var
  i: Integer;
begin
  for i := 1 to 4 do
    X := A * 3 + Word(i);
end;

procedure WideWord(A: Word; out X: Integer);
begin
  X := A;
end;

procedure ConvWord(A: Integer; out X: Word);
begin
  X := Word(A * 3);
end;

