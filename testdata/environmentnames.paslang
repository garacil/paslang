program environmentnames;
uses paslinux, paslib, sysutils;

procedure Query(const Name: string; Size: Integer; Present: Boolean; const Expected: string);
var value: string; found: Boolean;
begin
  if Length(Name) <> Size then Halt(10);
  value := 'sentinel';
  found := LookupProcessEnvironment(Name, value);
  if (found <> Present) or (value <> Expected) then Halt(11);
  value := 'sentinel';
  found := LookupEnv(Name, value);
  if (found <> Present) or (value <> Expected) then Halt(12);
  value := 'sentinel';
  found := TryGetEnvironmentVariable(Name, value);
  if (found <> Present) or (value <> Expected) then Halt(13);
  if GetEnv(Name) <> Expected then Halt(14);
  if GetEnvironmentVariable(Name) <> Expected then Halt(15);
end;

procedure Check(Size: Integer);
var name, invalid: string;
begin
  name := 'P612_P' + StringOfChar('x', Size - 6);
  Query(name, Size, True, 'present' + IntToStr(Size));
  Query('P612_E' + StringOfChar('x', Size - 6), Size, True, '');
  Query('P612_M' + StringOfChar('x', Size - 6), Size, False, '');
  Query('p612_p' + StringOfChar('x', Size - 6), Size, False, '');
  { Replace a byte: the short mutant control must remain exactly32 bytes. }
  invalid := name; invalid[Size] := '=';
  Query(invalid, Size, False, '');
  invalid := name; invalid[Size] := #0;
  Query(invalid, Size, False, '');
  WriteLn('environment names ', Size, ': present/empty/missing/invalid OK');
end;

var mode: string;
begin
  mode := ParamStr(1);
  if mode = 'capabilities' then
    WriteLn(Ord(CpuHas('sse3')), ' ', Ord(CpuHas('cx16')), ' ',
      Ord(CpuHas('avx')), ' ', Ord(CpuHas('avx2')))
  else if mode = '32' then Check(32)
  else if mode = '33' then Check(33)
  else if mode = '64' then Check(64)
  else if mode = '65' then Check(65)
  else if mode = '' then
  begin
    Check(32); Check(33); Check(64); Check(65);
  end
  else Halt(16);
end.
