{ P228 (1.1.105): an element of a tree given as a var or out argument
  is its value's slot, as an element of a map is (1.0.140): the routine
  writes the tree, and a missing key is put in with a zero value first.
  Strings by an integer and by a string key, Integers (a tree whose
  value is one 8-byte slot) and records; each read back through the
  tree and through a const parameter. On amd64 a string went to a copy
  and an Integer was refused; on arm64 both were refused. }
program treevarg;

uses
  paslib;

type
  TRec = record
    Name: string;
    N: Integer;
  end;

var
  ts: tree[Integer] of string;
  tk: tree[string] of string;
  ti: tree[Integer] of Integer;
  tr: tree[Integer] of TRec;
  x: Integer;

procedure AddS(var S: string);
begin
  S := S + '+';
end;

procedure PutS(out S: string; N: Integer);
begin
  S := 'out ' + IntToStr(N);
end;

procedure AddI(var I: Integer);
begin
  I := I + 1;
end;

procedure PutI(out I: Integer);
begin
  I := 42;
end;

procedure AddR(var R: TRec);
begin
  R.N := R.N + 10;
  R.Name := R.Name + '!';
end;

function Show(const S: string): string;
begin
  Result := '[' + S + ']';
end;

begin
  x := 7;
  New(ts);
  New(tk);
  New(ti);
  New(tr);
  ts[1] := 'a' + IntToStr(x);
  tk['k'] := 'b' + IntToStr(x);
  ti[1] := 5;
  tr[1].Name := 'r' + IntToStr(x);
  tr[1].N := 1;

  AddS(ts[1]);
  WriteLn('a string by an integer key ', ts[1], ' ', Show(ts[1]));
  AddS(ts[2]);
  WriteLn('a missing key ', ts[2], ' ', Length(ts));
  AddS(tk['k']);
  AddS(tk['k']);
  WriteLn('a string by a string key ', tk['k']);
  AddS(tk['new']);
  WriteLn('a missing string key ', tk['new'], ' ', Length(tk));
  PutS(ts[3], 3);
  WriteLn('an out string ', ts[3]);
  AddI(ti[1]);
  AddI(ti[1]);
  WriteLn('an Integer ', ti[1]);
  AddI(ti[9]);
  WriteLn('a missing Integer ', ti[9], ' ', Length(ti));
  PutI(ti[1]);
  WriteLn('an out Integer ', ti[1]);
  AddR(tr[1]);
  WriteLn('a record ', tr[1].Name, ' ', tr[1].N);
end.

