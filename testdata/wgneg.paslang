{ Done below zero is a programming error: the waitgroup stops the
  program with paslang: negative waitgroup counter and exit status 1,
  like every runtime domain error. The Makefile checks both. }
program wgneg;

var
  wg: waitgroup;

begin
  wg.Add(1);
  wg.Done;
  WriteLn('balanced');
  wg.Done;
  WriteLn('never printed');
end.

