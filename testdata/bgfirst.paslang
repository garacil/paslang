{ P639: main ends right after it starts background routines, before
  they have run: they were counted when started, so main's end waits
  for each to start, and each, as it starts, finds main ended and no
  counted routine left, and ends the program. Nothing of theirs runs
  past that, and the program ends at once. }
program bgfirst;

procedure Late(N: Integer);
begin
  Sleep(2000);
  WriteLn('wrong: a background routine ran on after main, ', N);
end;

var
  i: Integer;

begin
  for i := 1 to 50 do
    pas background Late(i);
  WriteLn('main ends');
end.

