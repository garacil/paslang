{ P190: a[F] += 1 binds its Integer destination once. }
program intcompplace;

var
  i: Integer;
  b: Byte;
  d: Double;
  t: Boolean;
  s: string;
  q: Quad;
  a: array[0..1] of Integer;
  r: record X: Integer end;
  da: array of Integer;
  calls: Integer;

function F: Integer;
begin
  Inc(calls);
  Result := 0;
end;

begin
  i := 0;
  a[F] += 1;
  if (calls <> 1) or (a[0] <> 1) then Halt(1);
  WriteLn('Integer compound destination evaluated once');
end.

