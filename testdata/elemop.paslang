{ P329: a value of two words (three for a slice) is loaded from and
  stored to its element's own operand on amd64, the lea that worked the
  address out into rax gone: routine values, method values, interfaces,
  strings and slices in global and local arrays and in slices, at
  variable and worked-out indexes, fields of elements and of records,
  and elements passed straight to a call's registers. The answers are
  worked out by hand in the comments. scripts/check_elemop.py reads the
  forms. }
program elemop;

uses paslib;

type
  TFn = function(K: Integer): Integer;
  IVal = interface
    function Get: Integer;
  end;
  TBox = class(IVal)
    N: Integer;
    function Get: Integer;
  end;
  TMeth = function: Integer of object;
  TInts = array of Integer;
  TPair = record
    Tag: Integer;
    Name: string;
    Fn: TFn;
  end;

var
  fns: array[0..7] of TFn;
  names: array[0..7] of string;
  meths: array[0..3] of TMeth;
  vals: array of IVal;
  rows: array[0..3] of TInts;
  pairs: array[0..3] of TPair;
  gpair: TPair;

function TBox.Get: Integer;
begin
  Result := N * 10;
end;

function Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

function Thrice(K: Integer): Integer;
begin
  Result := K * 3;
end;

function Glue(const A, B: string): string;
begin
  Result := A + '-' + B;
end;

{ routine values read at a variable index and called }
function SumFns(n: Integer): Integer;
var
  k: Integer;
  f: TFn;
begin
  Result := 0;
  for k := 0 to n - 1 do
  begin
    f := fns[k];
    Result := Result * 10 + f(1);
  end;
end;

{ a local array on the frame, stored and read at worked-out indexes }
function Local(n: Integer): Integer;
var
  loc: array[0..3] of TFn;
  k: Integer;
  f: TFn;
begin
  for k := 0 to 3 do
    if k mod 2 = 0 then
      loc[(k + n) and 3] := @Thrice
    else
      loc[(k + n) and 3] := @Twice;
  Result := 0;
  for k := 0 to 3 do
  begin
    f := loc[k];
    Result := Result * 10 + f(k);
  end;
end;

{ strings read at worked-out indexes, two of them straight into a
  call's registers }
function Strs(n: Integer): string;
var
  k: Integer;
  s: string;
begin
  Result := '';
  for k := 0 to n - 1 do
  begin
    s := names[(k * 3) and 7];
    Result := Result + s;
  end;
  Result := Glue(names[(n + 1) and 7], names[(n + 2) and 7]) + ' ' + Result;
end;

{ method values and interfaces into elements and back }
function Boxes: Integer;
var
  k: Integer;
  b: TBox;
  m: TMeth;
  v: IVal;
begin
  SetLength(vals, 4);
  for k := 0 to 3 do
  begin
    b := TBox.Create;
    b.N := k + 1;
    v := b;
    vals[3 - k] := v;
    meths[(k + 1) and 3] := @b.Get;
  end;
  Result := 0;
  for k := 0 to 3 do
  begin
    v := vals[k];
    m := meths[k];
    Result := Result * 100 + v.Get + m() div 10;
  end;
end;

{ slices of three words into elements and back }
function Slices: Integer;
var
  k: Integer;
  d: TInts;
begin
  for k := 0 to 3 do
  begin
    d := [k, k + 1, k + 2];
    rows[(k + 2) and 3] := d;
  end;
  Result := 0;
  for k := 0 to 3 do
  begin
    d := rows[k];
    Result := Result * 10 + Length(d) + d[0];
  end;
end;

{ fields of elements and of a global record and a local one }
function Fields(n: Integer): string;
var
  k: Integer;
  s: string;
  f: TFn;
  lp: TPair;
begin
  for k := 0 to 3 do
  begin
    pairs[k].Tag := k;
    pairs[(k + n) and 3].Name := names[k];
    if k mod 2 = 0 then
      pairs[k].Fn := @Twice
    else
      pairs[k].Fn := @Thrice;
  end;
  gpair.Name := 'g';
  gpair.Fn := @Thrice;
  lp.Name := 'l';
  lp.Fn := @Twice;
  Result := '';
  for k := 0 to 3 do
  begin
    s := pairs[k].Name;
    f := pairs[k].Fn;
    Result := Result + s + IntToStr(f(k + 1));
  end;
  s := gpair.Name;
  f := gpair.Fn;
  Result := Result + ' ' + s + IntToStr(f(5));
  s := lp.Name;
  f := lp.Fn;
  Result := Result + ' ' + s + IntToStr(f(5));
end;

var
  k: Integer;

begin
  for k := 0 to 7 do
  begin
    if k mod 3 = 0 then
      fns[k] := @Thrice
    else
      fns[k] := @Twice;
    names[k] := Chr(Ord('a') + k);
  end;
  { fns: 0 Thrice, 1 Twice, 2 Twice, 3 Thrice, 4 Twice, 5 Twice, 6 Thrice,
    7 Twice; at 1: 3 2 2 3 2 2 3 2 }
  WriteLn(SumFns(8));
  { n = 1: k=0 -> loc[1] Thrice, 1 -> loc[2] Twice, 2 -> loc[3] Thrice,
    3 -> loc[0] Twice; loc[k](k): 0, 3, 4, 9 }
  WriteLn(Local(1));
  { (3k) and 7 for k = 0..4: 0 3 6 1 4: a d g b e; Glue(names[6],
    names[7]) }
  WriteLn(Strs(5));
  { vals[3-k] box k+1: vals[0] box 4, [1] box 3, [2] box 2, [3] box 1;
    meths[(k+1) and 3] box k+1: meths[0] box 4, [1] box 1, [2] box 2,
    [3] box 3; v.Get + m() div 10: 40+4, 30+1, 20+2, 10+3 }
  WriteLn(Boxes);
  { rows[(k+2) and 3] = [k, k+1, k+2]: rows[0] k=2, [1] k=3, [2] k=0,
    [3] k=1; 3 + d[0]: 5 6 3 4 }
  WriteLn(Slices);
  { n = 2: pairs[(k+2) and 3].Name = names[k]: pairs[0] c, [1] d,
    [2] a, [3] b; Fn: 0 Twice, 1 Thrice, 2 Twice, 3 Thrice; f(k+1): 2 6
    6 12 }
  WriteLn(Fields(2));
end.

