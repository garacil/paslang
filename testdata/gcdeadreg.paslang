{ P423: GcCollect frees a block whose address only dead registers hold.
  The registers a call may overwrite are dead at it (Go's ABIInternal
  has no others: its runtime.GC reads the caller's frame by its map
  alone), so the call clears them before the collector saves them on the
  routine's stack, which it reads word by word: inline assembly puts the
  address of a 16 MiB string, dropped, in every one of them (rcx, rdx,
  rsi, rdi, r8 to r11; x0 to x15) just before GcCollect, and the block
  is freed. P389's verify found a dead x15 keeping such a block. }
program gcdeadreg;

uses
  paslib;

const
  MiB = 1024 * 1024;

var
  s: string;
  p, base: Integer;

{ the string made, its bytes' address given as an integer, which keeps
  nothing alive }
function Fill: Integer;
begin
  s := StringOfChar('x', 16 * MiB);
  asm amd64 (@s[1]: in rax; Result: out rax)
  end;
  asm arm64 (@s[1]: in x0; Result: out x0)
  end;
end;

begin
  GcCollect;
  base := HeapStat(1);
  p := Fill;
  GcCollect;
  WriteLn('held ', HeapStat(1) - base >= 16 * MiB);
  s := '';
  asm amd64 (p: in rax)
    movq %rax, %rcx
    movq %rax, %rdx
    movq %rax, %rsi
    movq %rax, %rdi
    movq %rax, %r8
    movq %rax, %r9
    movq %rax, %r10
    movq %rax, %r11
  end;
  asm arm64 (p: in x0)
    mov x1, x0
    mov x2, x0
    mov x3, x0
    mov x4, x0
    mov x5, x0
    mov x6, x0
    mov x7, x0
    mov x8, x0
    mov x9, x0
    mov x10, x0
    mov x11, x0
    mov x12, x0
    mov x13, x0
    mov x14, x0
    mov x15, x0
  end;
  GcCollect;
  WriteLn('freed ', HeapStat(1) - base < MiB);
end.

