program fatexit;

{ Exit(v) of a value wider than a word (1.0.88): a string, a slice and
  a record come back whole. Only the first word went to Result, so
  Exit('three') gave 't', Result's old length; a slice property's
  capacity goes through its setter on arm64, and Default(T) of a slice
  has capacity 0. }

type
  TInts = array of Integer;
  TPair = record
    A, B: Integer;
    S: string;
  end;
  THolder = class
    FItems: TInts;
    FName: string;
    procedure SetItems(const V: TInts);
    property Items: TInts read FItems write SetItems;
    property Name: string read FName write FName;
    property Raw: TInts read FItems write FItems;
  end;

procedure THolder.SetItems(const V: TInts);
begin
  FItems := V;
end;

function Word3: string;
begin
  Result := 'x';
  Exit('three');
end;

function Nums(n: Integer): TInts;
var
  t: TInts;
  i: Integer;
begin
  SetLength(Result, 1);
  SetLength(t, n);
  for i := 0 to n - 1 do
    t[i] := i * 10;
  Exit(t);
end;

function Pair(n: Integer): TPair;
var
  p: TPair;
begin
  Result.A := 1;
  Result.S := 'old';
  p.A := n;
  p.B := n * 2;
  p.S := 'pair';
  Exit(p);
end;

var
  pr: TPair;
  h: THolder;
  a, d: TInts;
  s: string;
begin
  s := Word3;
  WriteLn(s, ' ', Length(s));
  a := Nums(4);
  WriteLn(Length(a), ' ', a[3]);
  SetLength(a, 5);
  a[4] := 99;
  WriteLn(a[4]);
  h := THolder.Create;
  SetLength(d, 3);
  d[2] := 7;
  h.Items := d;
  WriteLn(Length(h.Items), ' ', h.Items[2]);
  h.Name := 'hello';
  WriteLn(h.Name, ' ', Length(h.Name));
  h.Raw := d;
  WriteLn(Length(h.Raw), ' ', h.Raw[2]);
  pr := Pair(5);
  WriteLn(pr.A, ' ', pr.B, ' ', pr.S);
  d := Default(TInts);
  SetLength(d, 2);
  d[1] := 5;
  WriteLn(Length(d), ' ', d[1]);
end.

