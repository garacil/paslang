program descproof;

{ P558: the indexes of a var or const open array that a for loop takes at
  its counter plus a constant are proved for a run of the loop once, at the
  run's head, when the region keeps the array's length in a register: the
  loop then checks none. This runs such loops over arrays of every length
  that matters to the runs of 1024 (0 to 5000, round 1024, 2048 and 4096),
  starting at 0 to 3, over bytes, words, 64-bit integers, doubles and
  records, read, written and updated, with the counter plus a constant
  either side, over two arrays at once, over an empty array and over the
  nil descriptor that p^ passes, and one loop that shrinks the array it
  walks. The expected lines are the checked loops' of the installed
  compiler. }

type
  TRec = record
    A, B: Int64;
  end;
  TArr = array of Int64;

var
  Lens: array[0..15] of Integer;
  Sink: Int64;
  k: Integer;

procedure FillI(var A: array of Int64; base: Int64);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := base + i * 3 + (i mod 7);
end;

procedure FillB(var A: array of Byte);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := Byte((i * 5 + i div 3) and 255);
end;

procedure FillW(var A: array of Word);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := Word((i * 37 + 11) and 65535);
end;

procedure FillD(var A: array of Double);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := i * 0.5 - 3.25;
end;

procedure FillR(var A: array of TRec);
var
  i: Integer;
begin
  for i := 0 to High(A) do
  begin
    A[i].A := i * 7;
    A[i].B := 100 - i;
  end;
end;

function Sum(const A: array of Int64): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to High(A) do
    s := s + A[i];
  Result := s;
end;

function SumFrom(const A: array of Int64; first: Integer): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := first to High(A) do
    s := s + A[i] * 3;
  Result := s;
end;

function SumUpTo(const A: array of Int64; last: Integer): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to last do
    s := s + A[i];
  Result := s;
end;

function Diffs(const A: array of Int64): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to High(A) - 1 do
    s := s * 3 + (A[i + 1] - A[i]);
  Result := s;
end;

procedure Prefix(var A: array of Int64);
var
  i: Integer;
begin
  for i := 1 to High(A) do
    A[i] := A[i] + A[i - 1];
end;

procedure Smooth(var A: array of Int64);
var
  i: Integer;
begin
  for i := 1 to High(A) - 1 do
    A[i] := (A[i - 1] + A[i] + A[i + 1]) div 3;
end;

procedure Scale(var A: array of Int64; k: Int64);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := A[i] * k + 1;
end;

procedure Bump(var A: array of Int64);
var
  i: Integer;
begin
  for i := 0 to High(A) do
  begin
    Inc(A[i], i);
    Dec(A[i]);
  end;
end;

function Dot(const A, B: array of Int64): Int64;
var
  i, n: Integer;
  s: Int64;
begin
  n := Length(A);
  if Length(B) < n then
    n := Length(B);
  s := 0;
  for i := 0 to n - 1 do
    s := s + A[i] * B[i];
  Result := s;
end;

procedure Copy2(var D: array of Int64; const S: array of Int64);
var
  i: Integer;
begin
  for i := 0 to High(S) do
    D[i] := S[i];
end;

function CountEq(const A: array of Int64; k: Int64): Integer;
var
  i, n: Integer;
begin
  n := 0;
  for i := 0 to High(A) do
    if A[i] = k then
      n := n + 1;
  Result := n;
end;

function Biggest(const A: array of Int64): Int64;
var
  i: Integer;
  m: Int64;
begin
  m := -1;
  for i := 0 to High(A) do
    if A[i] > m then
      m := A[i];
  Result := m;
end;

function SumB(const A: array of Byte): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to High(A) do
    s := s + A[i];
  Result := s;
end;

procedure FlipB(var A: array of Byte);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := Byte(A[i] xor $5A);
end;

function SumW(const A: array of Word): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to High(A) do
    s := s + A[i];
  Result := s;
end;

function SumD(const A: array of Double): Double;
var
  i: Integer;
  s: Double;
begin
  s := 0;
  for i := 0 to High(A) do
    s := s + A[i];
  Result := s;
end;

procedure HalveD(var A: array of Double);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := A[i] * 0.5;
end;

function SumR(const A: array of TRec): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to High(A) do
    s := s + A[i].A * 2 + A[i].B;
  Result := s;
end;

{ eight live values: the length may not get a register }
function Crowd(const A: array of Int64; a1, a2, a3, a4, a5, a6: Int64): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to High(A) do
  begin
    s := s + A[i];
    a1 := a1 + s;
    a2 := a2 xor a1;
    a3 := a3 + a2;
    a4 := a4 xor a3;
    a5 := a5 + a4;
    a6 := a6 xor a5;
  end;
  Result := s + a1 + a2 + a3 + a4 + a5 + a6;
end;

{ a loop in a loop: only the inner one runs in runs }
function Grid(const A: array of Int64; w: Integer): Int64;
var
  r, c: Integer;
  s: Int64;
begin
  s := 0;
  for r := 0 to Length(A) div w - 1 do
    for c := 0 to w - 1 do
      s := s + A[r * w + c] * (c + 1);
  Result := s;
end;

{ the arrays are all one: a store through the other name is seen }
procedure Alias(var A, B: array of Int64);
var
  i: Integer;
begin
  for i := 1 to High(A) do
  begin
    A[i] := A[i - 1] + 1;
    B[i] := B[i] + A[i];
  end;
end;

function Touch(x: Int64): Int64;
var
  j: Integer;
  t: Int64;
begin
  t := x;
  for j := 1 to 3 do
    t := t * 31 + j;
  Inc(Sink);
  Result := t and 1023;
end;

{ a call in the loop: the region keeps the array across it by reading it
  again, and runs in no runs, the checks stay }
function Calls(var A: array of Int64): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to High(A) do
    s := s + A[i] + Touch(i);
  Result := s;
end;

procedure One(len: Integer);
var
  A, B, C: array of Int64;
  Y: array of Byte;
  W: array of Word;
  D: array of Double;
  R: array of TRec;
  E: array of Int64;
  s0, mid: Int64;
  p: ^TArr;
begin
  SetLength(A, len);
  SetLength(B, len);
  SetLength(C, len);
  SetLength(Y, len);
  SetLength(W, len);
  SetLength(D, len);
  SetLength(R, len);
  FillI(A, 5);
  FillI(B, 1000);
  FillB(Y);
  FillW(W);
  FillD(D);
  FillR(R);
  s0 := Sum(A);
  Write('len ', len, ' sum ', s0, ' ', SumFrom(A, 0), ' ', SumFrom(A, 1), ' ', SumFrom(A, 2), ' ', SumFrom(A, 3));
  if len > 0 then
    Write(' ', SumUpTo(A, len - 1), ' ', SumUpTo(A, len div 2))
  else
    Write(' - -');
  WriteLn;
  mid := 0;
  if len > 0 then
    mid := A[len div 2];
  WriteLn('  diffs ', Diffs(A), ' dot ', Dot(A, B), ' ', Dot(A, A), ' count ', CountEq(A, 5 + 3 * 5 + 5), ' ', CountEq(A, mid), ' ', mid);
  Copy2(C, A);
  Prefix(C);
  Write('  prefix ', Sum(C));
  Smooth(C);
  Scale(C, 3);
  Bump(C);
  WriteLn(' smooth ', Sum(C), ' biggest ', Biggest(C));
  Alias(A, B);
  Alias(C, C);
  WriteLn('  alias ', Sum(A), ' ', Sum(B), ' ', Sum(C), ' bytes ', SumB(Y));
  FlipB(Y);
  HalveD(D);
  WriteLn('  flip ', SumB(Y), ' words ', SumW(W), ' doubles ', SumD(D):0:2, ' records ', SumR(R));
  WriteLn('  crowd ', Crowd(A, 1, 2, 3, 4, 5, 6), ' grid ', Grid(A, 4), ' ', Grid(A, 1), ' calls ', Calls(A));
  SetLength(E, 0);
  p := nil;
  WriteLn('  empty ', Sum(E), ' ', Dot(E, A), ' ', Dot(A, E), ' ', SumFrom(E, 0), ' ', Diffs(E), ' ', CountEq(E, 0), ' ', Sum(p^), ' ', Dot(p^, A), ' ', Diffs(p^), ' ', SumFrom(p^, 0));
end;

begin
  Lens[0] := 0;
  Lens[1] := 1;
  Lens[2] := 2;
  Lens[3] := 3;
  Lens[4] := 7;
  Lens[5] := 8;
  Lens[6] := 1023;
  Lens[7] := 1024;
  Lens[8] := 1025;
  Lens[9] := 2047;
  Lens[10] := 2048;
  Lens[11] := 2049;
  Lens[12] := 4095;
  Lens[13] := 4096;
  Lens[14] := 4097;
  Lens[15] := 5000;
  Sink := 0;
  for k := 0 to 15 do
    One(Lens[k]);
  WriteLn('all ok');
end.
