{ P98: Ms that go idle and are woken, over and over.

  rt_wakep takes an idle M off rt_midle under the global lock and marks
  it (M+56 spinning, M+48 woken). It wrote the marks after it let the
  lock go, and a waker held up right there (by the kernel, or by the
  futex wake that rt_unlock makes since 1.0.49) wrote them into the M's
  next idle round: the M left its futex loop while it was still on
  rt_midle, pushed itself again, and the list closed on itself. The next
  rt_munidle walked it for ever holding the lock, and every M slept on
  that lock. Nine runs in a hundred of three thousand bursts hung.

  Short bursts of routines on a mutex with a wait between them make the
  Ms sleep and wake thousands of times. }
program idlerace;

var
  wg: waitgroup;
  mu: mutex;
  n, r, i: Integer;

procedure Work;
begin
  lock mu do
    n := n + 1;
  wg.Done;
end;

begin
  n := 0;
  for r := 1 to 20000 do
  begin
    wg.Add(64);
    for i := 1 to 64 do
      pas Work;
    wg.Wait;
  end;
  WriteLn(n);
end.

