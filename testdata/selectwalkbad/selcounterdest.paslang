program selcounterdest;
type TGet = function: Integer;
procedure P;
var i: Integer; c: chan of Integer; f: TGet;
begin
  c := MakeChan(1);
  for i := 0 to 0 do
  begin
    f := function: Integer begin Result := i; end;
    select
      Recv(c, i): ;
    else
      ;
    end;
  end;
end;
begin
end.

