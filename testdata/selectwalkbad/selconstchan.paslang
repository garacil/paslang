program selconstchan;
type TChan = chan of Integer;
var C: TChan;
function Touch(var X: Integer): TChan;
begin
  X := 1;
  Result := C;
end;
procedure P(const X: Integer);
begin
  select
    Send(Touch(X), 1): ;
  else
    ;
  end;
end;
begin
end.

