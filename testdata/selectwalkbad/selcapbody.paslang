program selcapbody;
type TChan = chan of Integer;
procedure P(var X: Integer; C: TChan);
var F: procedure;
begin
  F := procedure
  begin
    select
      Send(C, 1): X := 1;
    else
      ;
    end;
  end;
end;
begin
end.

