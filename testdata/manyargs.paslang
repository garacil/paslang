{ P332: several arguments worked out in the pool push nothing. A
  direct call, a method's and a call through a routine value, each with
  several chains of plain steps among their arguments: each chain is
  worked out in its own register, where a second argument worked out
  sent those before it to the stack. The answers are worked out by hand
  in the comments; scripts/check_argpush.py finds no push in ByDirect,
  ByMethod and ByValue. }
program manyargs;

type
  TF6 = function(A, B, C, D, E, F: Integer): Integer;
  TBox = class
    Base: Integer;
    function Sum4(A, B, C, D: Integer): Integer;
  end;

var
  k, t: Integer;
  f6: TF6;
  box: TBox;

function Six(A, B, C, D, E, F: Integer): Integer;
begin
  Result := A * 100000 + B * 10000 + C * 1000 + D * 100 + E * 10 + F;
end;

function TBox.Sum4(A, B, C, D: Integer): Integer;
begin
  Result := Base + A * 1000 + B * 100 + C * 10 + D;
end;

function ByDirect: Integer;
begin
  { 13 shl 1 = 26, 6 - 1 = 5, 13 and 6 = 4, 13 or 2 = 15:
    2600000 + 50000 + 4000 + 700 + 150 + 9 = 2654859 }
  Result := Six(k shl 1, t - 1, k and t, 7, k or 2, 9);
end;

function ByMethod: Integer;
begin
  { 1000 + 5 * 1000 + 0 * 100 + 11 * 10 + 3 = 6113 }
  Result := box.Sum4(k and 7, t and 1, k xor t, 3);
end;

function ByValue: Integer;
begin
  { 13 and 7 = 5, 6 and 1 = 0: 520451 }
  Result := f6(k and 7, 2, t and 1, 4, 5, 1);
end;

begin
  k := 13;
  t := 6;
  f6 := @Six;
  box := TBox.Create;
  box.Base := 1000;
  WriteLn(ByDirect, ' ', ByMethod, ' ', ByValue);
  box.Free;
end.
