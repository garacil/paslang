{ P330: a value of two words (three for a slice on amd64) goes to its
  place without the stack: routine values, method values, interfaces,
  strings and slices stored into elements at worked-out indexes, fields
  of records, fields through pointers, and read back. The answers are
  worked out by hand in the comments. scripts/check_twostore.py finds
  no push in the routines that store. }
program twostore;

uses paslib;

type
  TFn = function(K: Integer): Integer;
  IVal = interface
    function Get: Integer;
  end;
  TBox = class(IVal)
    N: Integer;
    function Get: Integer;
  end;
  TMeth = function: Integer of object;
  TInts = array of Integer;
  TRec = record
    Fn: TFn;
    Name: string;
    Nums: TInts;
    V: IVal;
    M: TMeth;
  end;
  PRec = ^TRec;

var
  fns: array[0..7] of TFn;
  names: array[0..7] of string;
  vals: array[0..3] of IVal;
  slices: array[0..3] of TInts;
  recs: array[0..3] of TRec;

function TBox.Get: Integer;
begin
  Result := N * 10;
end;

function Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

function Thrice(K: Integer): Integer;
begin
  Result := K * 3;
end;

{ routine values and strings into elements at worked-out indexes }
procedure FillFns(n: Integer);
var
  k: Integer;
  f: TFn;
  s: string;
begin
  for k := 0 to n - 1 do
  begin
    if k mod 2 = 0 then
      f := @Twice
    else
      f := @Thrice;
    fns[(k * 3 + 1) and 7] := f;
    s := 'n' + IntToStr(k);
    names[(k * 5 + 2) and 7] := s;
  end;
end;

{ interfaces and slices into elements, fields of records and through a
  pointer }
procedure FillRecs(p: PRec);
var
  k: Integer;
  b: TBox;
  v: IVal;
  d: TInts;
begin
  for k := 0 to 3 do
  begin
    b := TBox.Create;
    b.N := k + 1;
    v := b;
    vals[(k + 2) and 3] := v;
    d := [k, k * k];
    slices[3 - k] := d;
    recs[k].V := v;
    recs[k].Nums := d;
    recs[k].Fn := fns[k];
    recs[k].Name := names[k];
    recs[k].M := @b.Get;
  end;
  p^.Fn := @Thrice;
  p^.Name := 'pointed';
  p^.Nums := [7, 8, 9];
  p^.V := vals[1];
  p^.M := recs[2].M;
end;

var
  r: TRec;
  k, t: Integer;

begin
  FillFns(8);
  { fns[(3k+1) and 7]: k=0 -> 1 Twice, 1 -> 4 Thrice, 2 -> 7 Twice,
    3 -> 2 Thrice, 4 -> 5 Twice, 5 -> 0 Thrice, 6 -> 3 Twice, 7 -> 6 Thrice }
  t := 0;
  for k := 0 to 7 do
    t := t * 10 + fns[k](1);
  WriteLn(t);
  { names[(5k+2) and 7]: k=0 -> 2, 1 -> 7, 2 -> 4, 3 -> 1, 4 -> 6, 5 -> 3,
    6 -> 0, 7 -> 5 }
  for k := 0 to 7 do
    Write(names[k], ' ');
  WriteLn;
  FillRecs(@r);
  { vals[(k+2) and 3] holds box k+1: vals[0] box 3, [1] box 4, [2] box 1,
    [3] box 2 }
  for k := 0 to 3 do
    Write(vals[k].Get, ' ');
  WriteLn;
  { slices[3-k] = [k, k*k] }
  for k := 0 to 3 do
    Write(Length(slices[k]), ':', slices[k][0] + slices[k][1], ' ');
  WriteLn;
  for k := 0 to 3 do
    Write(recs[k].Fn(5), ' ', recs[k].Name, ' ', recs[k].Nums[1], ' ', recs[k].V.Get, ' ', recs[k].M(), ' ');
  WriteLn;
  WriteLn(r.Fn(4), ' ', r.Name, ' ', Length(r.Nums), ' ', r.Nums[2], ' ', r.V.Get, ' ', r.M());
end.

