{ A constructor with more arguments than registers (P123): ten, of
  every kind, made by the class and through a class reference; the
  arm64 constructor took seven at most. The same source compiles with
  Free Pascal, whose output is the one expected. }
program ctorargs;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  TRec = class
    A, B, C, D, E: Int64;
    S1, S2: string;
    R: Double;
    Ch: Char;
    F: Int64;
    constructor Create(AA, AB, AC: Int64; const AS1: string; AD: Int64;
      AR: Double; const AS2: string; ACh: Char; AE, AF: Int64); virtual;
    procedure Show;
  end;

  TRec2 = class(TRec)
    constructor Create(AA, AB, AC: Int64; const AS1: string; AD: Int64;
      AR: Double; const AS2: string; ACh: Char; AE, AF: Int64); override;
  end;

  TRecClass = class of TRec;

constructor TRec.Create(AA, AB, AC: Int64; const AS1: string; AD: Int64;
  AR: Double; const AS2: string; ACh: Char; AE, AF: Int64);
begin
  A := AA;
  B := AB;
  C := AC;
  S1 := AS1;
  D := AD;
  R := AR;
  S2 := AS2;
  Ch := ACh;
  E := AE;
  F := AF;
end;

procedure TRec.Show;
begin
  WriteLn(ClassName, ' ', A + B + C + D + E + F, ' ', S1, S2, Ch, ' ', R:0:2);
end;

constructor TRec2.Create(AA, AB, AC: Int64; const AS1: string; AD: Int64;
  AR: Double; const AS2: string; ACh: Char; AE, AF: Int64);
begin
  inherited Create(AA * 10, AB, AC, AS1 + '!', AD, AR * 2, AS2, ACh, AE, AF);
end;

var
  r: TRec;
  c: TRecClass;

begin
  r := TRec.Create(1, 2, 3, 'ab', 4, 1.25, 'cd', 'Z', 5, 6);
  r.Show;
  c := TRec2;
  r := c.Create(1, 2, 3, 'ab', 4, 1.25, 'cd', 'Y', 5, 6);
  r.Show;
  r := TRec2.Create(7, 2, 3, 'x', 4, 0.5, 'y', 'W', 5, 60);
  r.Show;
end.

