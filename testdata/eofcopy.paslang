{ P665: a program that copies standard input to standard output line by
  line, and gives back exactly what it was given: empty lines, a last
  line without a line feed, an empty input. Eof tells the end from an
  empty line, which ReadLn alone could not (both gave ''), and
  ReadLn(s, fed) says whether a line feed ended the line. The recipe
  feeds it files, pipes and nonblocking pipes and compares the bytes.

  With an argument it reads with Eof(Input) and Eof(), the other
  spellings, and counts the lines on standard error. }
program eofcopy;

var
  s: string;
  fed: Boolean;
  n: Integer;

begin
  if ParamCount = 0 then
    while not Eof do
    begin
      ReadLn(s, fed);
      if fed then
        WriteLn(s)
      else
        Write(s);
    end
  else
  begin
    n := 0;
    while not Eof(Input) do
    begin
      ReadLn(s, fed);
      Inc(n);
      if fed then
        WriteLn(s)
      else
        Write(s);
    end;
    { the end stays the end, and ReadLn there gives nothing and no line
      feed }
    ReadLn(s, fed);
    WriteLn(ErrOutput, n, ' lines, then the end: ', Eof(), ', ', s = '', ', ', fed);
  end;
end.

