program withmap;
type
  TR = record X, Y: Integer; Text: string end;
  TCells = record Cells: array[0..1] of TR end;
  TGroup = record Blocks: array[0..1] of TCells end;
  TF = function: Integer;
  TFunctions = array of TF;
var
  M, Old: map[Integer] of TR;
  Groups: map[Integer] of TGroup;
  TreeR: tree[Integer] of TR;
  Calls, IndexCalls, I: Integer;
  Functions: TFunctions;

function Maps: map[Integer] of TR;
begin
  Calls := Calls + 1;
  Result := M;
end;

function NextKey: Integer;
begin
  Calls := Calls + 1;
  Result := 7;
end;

function NextIndex: Integer;
begin
  Result := IndexCalls;
  IndexCalls := IndexCalls + 1;
end;

function CaptureEntries: TFunctions;
var
  Entries: map[Integer] of TR;
  K: Integer;
begin
  New(Entries);
  Result := nil;
  for K := 1 to 3 do
  begin
    Entries[K].X := K;
    Entries[K].Y := K * 2;
    Entries[K].Text := 'data';
    with Entries[K] do
      Result := Append(Result, function: Integer
      begin
        X := X + 1;
        Result := X + Y + Length(Text);
      end);
  end;
  for K := 100 to 3100 do
    Entries[K].X := K;
end;

begin
  New(M);
  Calls := 0;
  with Maps[NextKey] do
  begin
    X := 5;
    Y := 6;
    Text := 'entry';
  end;
  WriteLn('entry ', Calls, ' ', M[7].X, ' ', M[7].Y, ' ', M[7].Text);
  Calls := 0;
  with Maps[NextKey] do
  begin
    for I := 0 to 3000 do M[I].X := I;
    X := 77;
    Y := 78;
  end;
  WriteLn('grow ', Calls, ' ', M[7].X, ' ', M[7].Y, ' ', Length(M));
  with M[99999] do
    WriteLn('missing ', X, ' ', Y, ' ', Length(M));
  Old := M;
  with Maps[NextKey] do
  begin
    New(M);
    X := 80;
    Y := 90;
  end;
  WriteLn('rebind ', Old[7].X, ' ', Old[7].Y, ' ', Length(M));
  New(Groups);
  IndexCalls := 0;
  Calls := 0;
  with Groups[NextKey].Blocks[NextIndex].Cells[NextIndex] do
  begin
    X := 100;
    Y := 200;
  end;
  WriteLn('indexes ', Calls, ' ', IndexCalls, ' ',
    Groups[7].Blocks[0].Cells[1].X, ' ', Groups[7].Blocks[0].Cells[1].Y, ' ',
    Groups[7].Blocks[1].Cells[0].X);
  New(TreeR);
  Calls := 0;
  with TreeR[NextKey] do
  begin
    X := 11;
    for I := 0 to 3000 do TreeR[I].Y := I;
    Y := 12;
  end;
  WriteLn('tree ', Calls, ' ', TreeR[7].X, ' ', TreeR[7].Y, ' ', Length(TreeR));
  Functions := CaptureEntries;
  GcCollect;
  WriteLn('capture ', Functions[0](), ' ', Functions[1](), ' ', Functions[2]());
  GcCollect;
  WriteLn('again ', Functions[0](), ' ', Functions[1](), ' ', Functions[2]());
end.
