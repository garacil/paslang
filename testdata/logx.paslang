program logx;

begin
  WriteLn(Log10(1));
  WriteLn(Log10(10));
  WriteLn(Log10(100));
  WriteLn(Log10(1000));
  WriteLn(Log10(2));
  WriteLn(Log10(0.1));
  WriteLn(Log2(1));
  WriteLn(Log2(2));
  WriteLn(Log2(8));
  WriteLn(Log2(0.5));
  WriteLn(Log2(1024));
  WriteLn(Hypot(3, 4));
  WriteLn(Hypot(-3, 4));
  WriteLn(Hypot(0, 0));
  WriteLn(Hypot(5, 12));
  WriteLn(Hypot(1, 1));
  WriteLn(Hypot(0, 7));
end.

