{ P427: pasflate's writer. Twelve shapes of data (text, random bytes,
  zeros, periods, skewed bytes, counters, XML-like rows, a mixture) at
  each level 0 to 9: the size and a hash of what the raw, zlib and gzip
  writers make (the writer is deterministic: the same bytes on both
  machines), and that TInflater gives the data back from each, from the
  same fed in pieces with flushes between, and that gzip and zlib agree
  with the raw stream's size. Run with the argument dump it writes
  every stream as a line `KIND NAME LEVEL CRC32 LENGTH HEX` instead,
  for scripts/flate_verify.py to read them with zlib and gzip. }
program flatec;

uses
  sysutils, pasflate;

const
  HexDigits: string = '0123456789abcdef';
  Words: array[0..15] of string = ('the', 'row', 'cell', 'value', 'of', 'and', 'sheet', 'style', 'number', 'text', 'total',
    'price', 'date', 'name', 'id', 'x');

var
  GS: Integer;
  Dump: Boolean;

function GNext: Integer;
var
  z: Integer;
begin
  GS := GS + Integer($9E3779B97F4A7C15);
  z := GS;
  z := (z xor (z shr 30)) * Integer($BF58476D1CE4E5B9);
  z := (z xor (z shr 27)) * Integer($94D049BB133111EB);
  Result := z xor (z shr 31);
end;

function Rnd(N: Integer): Integer;
begin
  Result := (GNext shr 11) mod N;
end;

function Hex16(V: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, 16);
  for i := 16 downto 1 do
  begin
    Result[i] := HexDigits[(V and 15) + 1];
    V := V shr 4;
  end;
end;

function ToHex(const S: string): string;
var
  i: Integer;
begin
  SetLength(Result, Length(S) * 2);
  for i := 1 to Length(S) do
  begin
    Result[i * 2 - 1] := HexDigits[(Ord(S[i]) shr 4) + 1];
    Result[i * 2] := HexDigits[(Ord(S[i]) and 15) + 1];
  end;
end;

function Fnv(const S: string): Integer;
var
  i: Integer;
begin
  Result := Integer($CBF29CE484222325);
  for i := 1 to Length(S) do
    Result := (Result xor Ord(S[i])) * Integer($100000001B3);
end;

function MakeData(Shape: Integer): string;
var
  i, n, k, run, v: Integer;
  w: string;
begin
  Result := '';
  case Shape of
    0:
      Result := '';
    1:
      Result := 'a';
    2:
      begin
        n := 200000;
        while Length(Result) < n do
        begin
          Result := Result + Words[Rnd(16)];
          if Rnd(9) = 0 then
            Result := Result + '. '
          else
            Result := Result + ' ';
        end;
      end;
    3:
      begin
        SetLength(Result, 70000);
        for i := 1 to 70000 do
          Result[i] := Chr(Rnd(256));
      end;
    4:
      begin
        SetLength(Result, 300000);
        for i := 1 to 300000 do
          Result[i] := #0;
      end;
    5:
      begin
        SetLength(Result, 90000);
        for i := 1 to 90000 do
          Result[i] := Chr(((i - 1) mod 37) * 7 mod 256);
      end;
    6:
      begin
        SetLength(Result, 100000);
        for i := 1 to 100000 do
        begin
          v := Rnd(100);
          if v < 60 then
            k := 0
          else if v < 85 then
            k := 1
          else if v < 95 then
            k := 2 + Rnd(3)
          else
            k := Rnd(256);
          Result[i] := Chr(k);
        end;
      end;
    7:
      begin
        SetLength(Result, 100000);
        for i := 1 to 25000 do
        begin
          Result[i * 4 - 3] := Chr(i and 255);
          Result[i * 4 - 2] := Chr((i shr 8) and 255);
          Result[i * 4 - 1] := Chr(0);
          Result[i * 4] := Chr(Rnd(4));
        end;
      end;
    8:
      begin
        for i := 1 to 5000 do
        begin
          Result := Result + Words[Rnd(16)];
          Result := Result + ' ';
        end;
      end;
    9:
      begin
        while Length(Result) < 150000 do
        begin
          run := 1 + Rnd(400);
          v := Rnd(256);
          if Rnd(3) = 0 then
            run := 1 + Rnd(5);
          w := Chr(v);
          for i := 1 to run do
            Result := Result + w;
        end;
      end;
    10:
      begin
        Result := '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet><sheetData>';
        for i := 1 to 4000 do
        begin
          Result := Result + '<row r="' + IntToStr(i) + '"><c r="A' + IntToStr(i) + '" t="s"><v>' + IntToStr(Rnd(300)) +
            '</v></c><c r="B' + IntToStr(i) + '" s="2"><v>' + IntToStr(Rnd(100000)) + '.' + IntToStr(Rnd(100)) +
            '</v></c></row>';
        end;
        Result := Result + '</sheetData></worksheet>';
      end;
    11:
      begin
        for k := 0 to 11 do
        begin
          n := Rnd(3000);
          case k mod 4 of
            0:
              for i := 1 to n do
                Result := Result + Words[Rnd(16)] + ' ';
            1:
              for i := 1 to n do
                Result := Result + Chr(Rnd(256));
            2:
              for i := 1 to n do
                Result := Result + #0;
            3:
              for i := 1 to n do
                Result := Result + Chr(65 + (i mod 5));
          end;
        end;
      end;
  end;
end;

const
  Names: array[0..11] of string = ('empty', 'one', 'text200k', 'random70k', 'zeros300k', 'period90k', 'skew100k', 'counters100k',
    'text5k', 'runs150k', 'sheetxml', 'mixed');

{ the data fed in pieces of random sizes, a flush after some, written
  at Level in Kind; the stream read back by a reader fed in pieces too }
function PiecesOk(const Data: string; Kind, Level: Integer): Boolean;
var
  z: TDeflater;
  r: TInflater;
  i, n, k: Integer;
  stream, back: string;
begin
  z := TDeflater.Create(Kind, Level);
  stream := '';
  i := 1;
  while i <= Length(Data) do
  begin
    n := 1 + Rnd(70000);
    if Rnd(3) = 0 then
      n := 1 + Rnd(40);
    if i + n - 1 > Length(Data) then
      n := Length(Data) - i + 1;
    z.Feed(Copy(Data, i, n));
    i := i + n;
    if Rnd(4) = 0 then
      z.Flush;
    stream := stream + z.Take;
  end;
  stream := stream + z.Finish;
  r := TInflater.Create(Kind);
  back := '';
  i := 1;
  while i <= Length(stream) do
  begin
    k := 1 + Rnd(9000);
    if i + k - 1 > Length(stream) then
      k := Length(stream) - i + 1;
    r.Feed(Copy(stream, i, k));
    back := back + r.Take;
    i := i + k;
  end;
  back := back + r.Finish;
  Result := (back = Data) and (r.Unused = '');
end;

var
  shape, level, k: Integer;
  data, raw, zl, gz, back: string;
  ok: Boolean;
  bad: Integer;
begin
  Dump := (ParamCount > 0) and (ParamStr(1) = 'dump');
  GS := 427;
  bad := 0;
  for shape := 0 to 11 do
  begin
    data := MakeData(shape);
    for level := 0 to 9 do
    begin
      raw := FlateDeflate(data, level);
      zl := ZlibEncode(data, level);
      gz := GzipEncode(data, level);
      if Dump then
      begin
        WriteLn('raw ', Names[shape], ' ', level, ' ', Crc32(data), ' ', Length(data), ' ', ToHex(raw));
        WriteLn('zlib ', Names[shape], ' ', level, ' ', Crc32(data), ' ', Length(data), ' ', ToHex(zl));
        WriteLn('gzip ', Names[shape], ' ', level, ' ', Crc32(data), ' ', Length(data), ' ', ToHex(gz));
        Continue;
      end;
      ok := True;
      k := 0;
      if FlateInflate(raw, 1, k) <> data then
        ok := False;
      if k <> Length(raw) then
        ok := False;
      if ZlibDecode(zl) <> data then
        ok := False;
      if GzipDecode(gz) <> data then
        ok := False;
      if Length(zl) <> Length(raw) + 6 then
        ok := False;
      if Length(gz) <> Length(raw) + 18 then
        ok := False;
      if not PiecesOk(data, flRaw, level) then
        ok := False;
      if not PiecesOk(data, flZlib, level) then
        ok := False;
      if not PiecesOk(data, flGzip, level) then
        ok := False;
      if not ok then
        bad := bad + 1;
      WriteLn(Names[shape], ' ', Length(data), ' level ', level, ': ', Length(raw), ' ', Hex16(Fnv(raw)), ' ', Hex16(Fnv(gz)), ' ',
        ok);
    end;
  end;
  if not Dump then
    WriteLn('bad ', bad);
end.
