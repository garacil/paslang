{ P427, P449: pasflate's writer. Twelve shapes of data (text, random bytes,
  zeros, periods, skewed bytes, counters, XML-like rows, a mixture) at
  each level -2 and 0 to 9: the size and a hash of what the raw, zlib and
  gzip writers make (the writer is deterministic: the same bytes on both
  machines), and that TInflater gives the data back from each, from the
  same fed in pieces with flushes between, that gzip and zlib agree with
  the raw stream's size, and that a writer whose tables start over from
  small numbers every 70000 bytes makes the same stream. A second line
  gives the size and hash of the raw stream made of the data written in
  pieces of 1 to 70000 bytes with a flush after some, the pieces and the
  flushes those of scripts/flate_gocheck.go. The writer makes the bytes of
  Go's compress/flate at every level: scripts/flate_gocheck.py runs both
  and compares the lines.
  Run with the argument dump it writes every stream as a line `KIND NAME
  LEVEL CRC32 LENGTH HEX` instead, for scripts/flate_verify.py to read
  them with zlib and gzip; with data, a line `NAME HEX` for each shape. Last,
  that a writer fed a few bytes holds a few thousand of memory. }
program flatec;

uses
  sysutils, pasflate;

const
  HexDigits: string = '0123456789abcdef';
  Words: array[0..15] of string = ('the', 'row', 'cell', 'value', 'of', 'and', 'sheet', 'style', 'number', 'text', 'total',
    'price', 'date', 'name', 'id', 'x');

var
  GS: Integer;
  Dump: Boolean;

function GNext: Integer;
var
  z: Integer;
begin
  GS := GS + Integer($9E3779B97F4A7C15);
  z := GS;
  z := (z xor (z shr 30)) * Integer($BF58476D1CE4E5B9);
  z := (z xor (z shr 27)) * Integer($94D049BB133111EB);
  Result := z xor (z shr 31);
end;

function Rnd(N: Integer): Integer;
begin
  Result := (GNext shr 11) mod N;
end;

function Hex16(V: Integer): string;
var
  i: Integer;
begin
  SetLength(Result, 16);
  for i := 16 downto 1 do
  begin
    Result[i] := HexDigits[(V and 15) + 1];
    V := V shr 4;
  end;
end;

function ToHex(const S: string): string;
var
  i: Integer;
begin
  SetLength(Result, Length(S) * 2);
  for i := 1 to Length(S) do
  begin
    Result[i * 2 - 1] := HexDigits[(Ord(S[i]) shr 4) + 1];
    Result[i * 2] := HexDigits[(Ord(S[i]) and 15) + 1];
  end;
end;

function Fnv(const S: string): Integer;
var
  i: Integer;
begin
  Result := Integer($CBF29CE484222325);
  for i := 1 to Length(S) do
    Result := (Result xor Ord(S[i])) * Integer($100000001B3);
end;

function MakeData(Shape: Integer): string;
var
  i, n, k, run, v, sl, dd: Integer;
  w: string;
begin
  Result := '';
  case Shape of
    0:
      Result := '';
    1:
      Result := 'a';
    2:
      begin
        n := 200000;
        while Length(Result) < n do
        begin
          Result := Result + Words[Rnd(16)];
          if Rnd(9) = 0 then
            Result := Result + '. '
          else
            Result := Result + ' ';
        end;
      end;
    3:
      begin
        SetLength(Result, 70000);
        for i := 1 to 70000 do
          Result[i] := Chr(Rnd(256));
      end;
    4:
      begin
        SetLength(Result, 300000);
        for i := 1 to 300000 do
          Result[i] := #0;
      end;
    5:
      begin
        SetLength(Result, 90000);
        for i := 1 to 90000 do
          Result[i] := Chr(((i - 1) mod 37) * 7 mod 256);
      end;
    6:
      begin
        SetLength(Result, 100000);
        for i := 1 to 100000 do
        begin
          v := Rnd(100);
          if v < 60 then
            k := 0
          else if v < 85 then
            k := 1
          else if v < 95 then
            k := 2 + Rnd(3)
          else
            k := Rnd(256);
          Result[i] := Chr(k);
        end;
      end;
    7:
      begin
        SetLength(Result, 100000);
        for i := 1 to 25000 do
        begin
          Result[i * 4 - 3] := Chr(i and 255);
          Result[i * 4 - 2] := Chr((i shr 8) and 255);
          Result[i * 4 - 1] := Chr(0);
          Result[i * 4] := Chr(Rnd(4));
        end;
      end;
    8:
      begin
        for i := 1 to 5000 do
        begin
          Result := Result + Words[Rnd(16)];
          Result := Result + ' ';
        end;
      end;
    9:
      begin
        while Length(Result) < 150000 do
        begin
          run := 1 + Rnd(400);
          v := Rnd(256);
          if Rnd(3) = 0 then
            run := 1 + Rnd(5);
          w := Chr(v);
          for i := 1 to run do
            Result := Result + w;
        end;
      end;
    10:
      begin
        Result := '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet><sheetData>';
        for i := 1 to 4000 do
        begin
          Result := Result + '<row r="' + IntToStr(i) + '"><c r="A' + IntToStr(i) + '" t="s"><v>' + IntToStr(Rnd(300)) +
            '</v></c><c r="B' + IntToStr(i) + '" s="2"><v>' + IntToStr(Rnd(100000)) + '.' + IntToStr(Rnd(100)) +
            '</v></c></row>';
        end;
        Result := Result + '</sheetData></worksheet>';
      end;
    11:
      begin
        for k := 0 to 11 do
        begin
          n := Rnd(3000);
          case k mod 4 of
            0:
              for i := 1 to n do
                Result := Result + Words[Rnd(16)] + ' ';
            1:
              for i := 1 to n do
                Result := Result + Chr(Rnd(256));
            2:
              for i := 1 to n do
                Result := Result + #0;
            3:
              for i := 1 to n do
                Result := Result + Chr(65 + (i mod 5));
          end;
        end;
      end;
    13:
      begin
        { a soup of LZ77: bytes of every value and copies of every length from 4 to 258 and of distances of every
          size, so that a block uses every length code and every distance code }
        SetLength(Result, 200000);
        n := 0;
        k := 0;
        while n < 200000 do
        begin
          if (Rnd(100) < 35) or (n < 8) then
          begin
            run := 1 + Rnd(20);
            for i := 1 to run do
              if n < 200000 then
              begin
                n := n + 1;
                Result[n] := Chr(Rnd(256));
              end;
          end
          else
          begin
            k := k + 1;
            sl := 4 + (k * 7) mod 255;
            dd := 1 + Rnd(1 shl (1 + Rnd(15)));
            if dd > n then
              dd := 1 + Rnd(n);
            for i := 1 to sl do
              if n < 200000 then
              begin
                n := n + 1;
                Result[n] := Result[n - dd];
              end;
          end;
        end;
      end;
    12:
      begin
        i := 0;
        while Length(Result) < 400000 do
        begin
          Result := Result + Words[Rnd(16)] + ' ';
          if Rnd(5) = 0 then
            Result := Result + IntToStr(Rnd(100000)) + ' ';
          if Rnd(40) = 0 then
            Result := Result + Chr(Rnd(256));
          i := i + 1;
        end;
      end;
  end;
end;

const
  Names: array[0..13] of string = ('empty', 'one', 'text200k', 'random70k', 'zeros300k', 'period90k', 'skew100k', 'counters100k',
    'text5k', 'runs150k', 'sheetxml', 'mixed', 'text400k', 'soup200k');
  { the sizes of the fourth sweep, of random bytes: where stored blocks begin and end }
  RandSizes: array[0..25] of Integer = (1023, 1024, 1025, 1026, 4095, 4096, 4097, 8191, 8192, 8193, 16383, 16384, 16385, 32767,
    32768, 32769, 65533, 65534, 65535, 65536, 65537, 65538, 69999, 70000, 2047, 2049);
  { the periods of the fifth sweep: a block of random bytes repeated, the matches as far as the window reaches }
  Periods: array[0..15] of Integer = (258, 259, 4097, 16382, 16383, 16384, 16385, 32763, 32764, 32765, 32766, 32767, 32768, 32769, 65534, 65535);
  { the sizes of the sixth sweep, of the soup of LZ77, and the pieces of the seventh, in which a long text is written }
  SoupSizes: array[0..8] of Integer = (200000, 150000, 100000, 65535, 65536, 40000, 20000, 5000, 1000);
  PieceSizes: array[0..4] of Integer = (65534, 65535, 65536, 32768, 100000);
  { the eighth sweep: random bytes with a short repeat after every so many, the tokens a block holds near the limit between a block of codes alone and a dynamic one }
  SparseK: array[0..8] of Integer = (60, 80, 100, 120, 135, 150, 170, 200, 300);
  { the offsets at which the tables of a writer start over, in the tests of Rebased }
  Rebases: array[0..12] of Integer = (32768, 32769, 40000, 65535, 65536, 65537, 70000, 98304, 98305, 131070, 131071, 131072, 131073);
  { the sizes of the third sweep: around the limits of the windows and the blocks }
  SweepSizes: array[0..33] of Integer = (12, 13, 14, 31, 32, 33, 127, 128, 129, 255, 256, 257, 4095, 4096, 4097, 32767, 32768,
    32769, 65534, 65535, 65536, 65537, 131070, 131071, 131072, 131073, 262143, 262144, 327674, 327675, 327676, 327677, 327680,
    392000);

{ the data fed in pieces of random sizes, a flush after some, written
  at Level in Kind; the stream read back by a reader fed in pieces too }
function PiecesOk(const Data: string; Kind, Level: Integer): Boolean;
var
  z: TDeflater;
  r: TInflater;
  i, n, k: Integer;
  stream, back: string;
begin
  z := TDeflater.Create(Kind, Level);
  stream := '';
  i := 1;
  while i <= Length(Data) do
  begin
    n := 1 + Rnd(70000);
    if Rnd(3) = 0 then
      n := 1 + Rnd(40);
    if i + n - 1 > Length(Data) then
      n := Length(Data) - i + 1;
    z.Feed(Copy(Data, i, n));
    i := i + n;
    if Rnd(4) = 0 then
      z.Flush;
    stream := stream + z.Take;
  end;
  stream := stream + z.Finish;
  r := TInflater.Create(Kind);
  back := '';
  i := 1;
  while i <= Length(stream) do
  begin
    k := 1 + Rnd(9000);
    if i + k - 1 > Length(stream) then
      k := Length(stream) - i + 1;
    r.Feed(Copy(stream, i, k));
    back := back + r.Take;
    i := i + k;
  end;
  back := back + r.Finish;
  Result := (back = Data) and (r.Unused = '');
end;

function XorShift(X: Integer): Integer;
begin
  X := X xor ((X shl 13) and $FFFFFFFF);
  X := X xor (X shr 17);
  X := X xor ((X shl 5) and $FFFFFFFF);
  Result := X;
end;

{ the raw stream of the data written in pieces, a flush after one in five, the sizes
  and the flushes from a xorshift32 stream seeded by the name and the level }
function Chunked(const Name, Data: string; Level: Integer): string;
const
  Sizes: array[0..7] of Integer = (1, 3, 7, 100, 1000, 5000, 33000, 70000);
var
  z: TDeflater;
  x, sum, i, p, m, n: Integer;
begin
  sum := 0;
  for i := 1 to Length(Name) do
    sum := sum + Ord(Name[i]);
  x := (2463534242 xor ((sum * 2654435761) and $FFFFFFFF) xor (((Level + 3) * 40503) and $FFFFFFFF)) or 1;
  z := TDeflater.Create(flRaw, Level);
  Result := '';
  p := 0;
  while p < Length(Data) do
  begin
    x := XorShift(x);
    m := Sizes[x and 7];
    x := XorShift(x);
    n := 1 + x mod m;
    if n > Length(Data) - p then
      n := Length(Data) - p;
    z.Feed(Copy(Data, p + 1, n));
    p := p + n;
    x := XorShift(x);
    if x mod 5 = 0 then
      z.Flush;
    Result := Result + z.Take;
  end;
  Result := Result + z.Finish;
end;

{ the raw stream of Data when the tables start over from small numbers at the offset At }
function Rebased(const Data: string; Level, At: Integer): string;
var
  z: TDeflater;
begin
  z := TDeflater.Create(flRaw, Level);
  z.RebaseAt := At;
  z.Feed(Data);
  Result := z.Finish;
end;

{ the streams of the data cut at many lengths, one after the other: the lengths 0 to 300 of a text and of random bytes,
  and the lengths round the limits of the windows and the blocks of a long text; the size and a hash of all of them
  at one level (a line of the output for each, scripts/flate_gocheck.go writes the same) }
function Sweep(Which: Integer; const Text, Rand, Long, Skew, Soup: string; Level: Integer): string;
var
  n, i, j, total: Integer;
  h: Integer;
  raw, rep: string;
  z: TDeflater;

  procedure Add(const S: string);
  var
    j: Integer;
  begin
    for j := 1 to Length(S) do
      h := (h xor Ord(S[j])) * Integer($100000001B3);
    total := total + Length(S);
  end;

begin
  h := Integer($CBF29CE484222325);
  total := 0;
  case Which of
    0:
      for n := 0 to 300 do
        Add(FlateDeflate(Copy(Text, 1, n), Level));
    1:
      for n := 0 to 300 do
        Add(FlateDeflate(Copy(Rand, 1, n), Level));
    3:
      for i := 0 to High(RandSizes) do
        Add(FlateDeflate(Copy(Rand, 1, RandSizes[i]), Level));
    4:
      for n := 1 to 1500 do
        Add(FlateDeflate(Copy(Skew, 1, n), Level));
    6:
      for j := 1 to 10 do
      begin
        rep := '';
        for i := 1 to 50 do
          rep := rep + Chr(97 + (i - 1) mod j);
        for n := 0 to 40 do
          Add(FlateDeflate(Copy(rep, 1, n), Level));
      end;
    10:
      for j := 0 to High(SparseK) do
      begin
        rep := '';
        n := 1;
        while (Length(rep) < 65535) and (n < 69000) do
        begin
          rep := rep + Copy(Rand, n, SparseK[j]);
          n := n + SparseK[j];
          if Length(rep) > 200 then
            rep := rep + Copy(rep, Length(rep) - 150, 8);
        end;
        Add(FlateDeflate(Copy(rep, 1, 65535), Level));
        Add(FlateDeflate(Copy(rep, 1, 40000), Level));
      end;
    9:
      for n := 11 to 15 do
        for j := 0 to 3 do
        begin
          z := TDeflater.Create(flRaw, Level);
          z.Feed(Copy(Text, 1, 3000 + 7 * j));
          z.Flush;
          z.Feed(Copy(Text, 100 + j * 50, n));
          Add(z.Take + z.Finish);
        end;
    7:
      for i := 0 to High(SoupSizes) do
        Add(FlateDeflate(Copy(Soup, 1, SoupSizes[i]), Level));
    8:
      for i := 0 to High(PieceSizes) do
        for j := 0 to 1 do
        begin
          z := TDeflater.Create(flRaw, Level);
          n := 1;
          while n <= 300000 do
          begin
            z.Feed(Copy(Long, n, PieceSizes[i]));
            n := n + PieceSizes[i];
            if j = 1 then
              z.Flush;
          end;
          Add(z.Take + z.Finish);
        end;
    5:
      for i := 0 to High(Periods) do
      begin
        rep := Copy(Rand, 1, Periods[i]);
        while Length(rep) < 140000 do
          rep := rep + rep;
        Add(FlateDeflate(Copy(rep, 1, 140000), Level));
      end;
  else
    for i := 0 to High(SweepSizes) do
      Add(FlateDeflate(Copy(Long, 1, SweepSizes[i]), Level));
  end;
  raw := Hex16(h);
  Result := IntToStr(total) + ' ' + raw;
end;

{ the memory of a writer follows its input: a few thousand bytes for a few bytes, under a megabyte for
  a few thousand (the tables of the levels 1 to 6 are what it holds then) }
function SmallOk(Level: Integer): Boolean;
var
  z: TDeflater;
  a, b: Integer;
begin
  z := TDeflater.Create(flGzip, Level);
  z.Feed('hello hello hello');
  a := z.Footprint;
  z.Feed(MakeData(8));
  b := z.Footprint;
  z.Finish;
  Result := (a < 65536) and (b < 1048576);
end;

var
  shape, level, k, li: Integer;
  data, raw, zl, gz, back: string;
  ok: Boolean;
  bad: Integer;
begin
  Dump := (ParamCount > 0) and (ParamStr(1) = 'dump');
  if (ParamCount > 0) and (ParamStr(1) = 'data') then
  begin
    for shape := 0 to 13 do
    begin
      GS := 427 + shape;
      WriteLn(Names[shape], ' ', ToHex(MakeData(shape)));
    end;
    Halt(0);
  end;
  bad := 0;
  for shape := 0 to 11 do
  begin
    GS := 427 + shape;
    data := MakeData(shape);
    for li := -2 to 9 do
    begin
      if li = -1 then
        Continue;
      level := li;
      raw := FlateDeflate(data, level);
      zl := ZlibEncode(data, level);
      gz := GzipEncode(data, level);
      if Dump then
      begin
        WriteLn('raw ', Names[shape], ' ', level, ' ', Crc32(data), ' ', Length(data), ' ', ToHex(raw));
        WriteLn('zlib ', Names[shape], ' ', level, ' ', Crc32(data), ' ', Length(data), ' ', ToHex(zl));
        WriteLn('gzip ', Names[shape], ' ', level, ' ', Crc32(data), ' ', Length(data), ' ', ToHex(gz));
        Continue;
      end;
      ok := True;
      k := 0;
      if FlateInflate(raw, 1, k) <> data then
        ok := False;
      if k <> Length(raw) then
        ok := False;
      if ZlibDecode(zl) <> data then
        ok := False;
      if GzipDecode(gz) <> data then
        ok := False;
      if Length(zl) <> Length(raw) + 6 then
        ok := False;
      if Length(gz) <> Length(raw) + 18 then
        ok := False;
      if (level >= 1) and (shape in [2, 7, 11]) then
        for k := 0 to High(Rebases) do
          if Rebased(data, level, Rebases[k]) <> raw then
            ok := False;
      k := 0;
      if not PiecesOk(data, flRaw, level) then
        ok := False;
      if not PiecesOk(data, flZlib, level) then
        ok := False;
      if not PiecesOk(data, flGzip, level) then
        ok := False;
      if not ok then
        bad := bad + 1;
      WriteLn(Names[shape], ' ', Length(data), ' level ', level, ': ', Length(raw), ' ', Hex16(Fnv(raw)), ' ', Hex16(Fnv(gz)), ' ',
        ok);
      back := Chunked(Names[shape], data, level);
      WriteLn(Names[shape], ' ', Length(data), ' pieces ', level, ': ', Length(back), ' ', Hex16(Fnv(back)));
    end;
  end;
  if not Dump then
  begin
    GS := 427 + 8;
    data := MakeData(8);
    GS := 427 + 3;
    raw := MakeData(3);
    GS := 427 + 12;
    zl := MakeData(12);
    GS := 427 + 6;
    back := MakeData(6);
    GS := 427 + 13;
    gz := MakeData(13);
    for li := -2 to 9 do
    begin
      if li = -1 then
        Continue;
      WriteLn('sweep text ', li, ': ', Sweep(0, data, raw, zl, back, gz, li));
      WriteLn('sweep random ', li, ': ', Sweep(1, data, raw, zl, back, gz, li));
      WriteLn('sweep sizes ', li, ': ', Sweep(2, data, raw, zl, back, gz, li));
      WriteLn('sweep randsizes ', li, ': ', Sweep(3, data, raw, zl, back, gz, li));
      WriteLn('sweep skew ', li, ': ', Sweep(4, data, raw, zl, back, gz, li));
      WriteLn('sweep periods ', li, ': ', Sweep(5, data, raw, zl, back, gz, li));
      WriteLn('sweep tiny ', li, ': ', Sweep(6, data, raw, zl, back, gz, li));
      WriteLn('sweep soup ', li, ': ', Sweep(7, data, raw, zl, back, gz, li));
      WriteLn('sweep pieces ', li, ': ', Sweep(8, data, raw, zl, back, gz, li));
      WriteLn('sweep after ', li, ': ', Sweep(9, data, raw, zl, back, gz, li));
      WriteLn('sweep sparse ', li, ': ', Sweep(10, data, raw, zl, back, gz, li));
    end;
    for li := -2 to 6 do
    begin
      if li = -1 then
        Continue;
      if not SmallOk(li) then
      begin
        bad := bad + 1;
        WriteLn('level ', li, ': a small stream holds too much memory');
      end;
    end;
    WriteLn('bad ', bad);
  end;
end.
