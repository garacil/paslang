{ SysUtils' names are no reserved words (P158): a program that uses the
  unit declares its own Trim, FormatSettings, EmptyStr, TBytes and
  IntToStr, a parameter Format, a parameter UpperCase and a local
  Exception, as in Free Pascal, and reaches the unit's through its name.
  The output is Free Pascal's. }
program hidesys;

{$mode objfpc}{$H+}

uses sysutils;

var
  Trim: Integer;
  FormatSettings: string;

const
  EmptyStr = 'not empty';

type
  TBytes = record
    N: Int64;
  end;

function IntToStr(A, B: Int64): string;
begin
  Result := sysutils.IntToStr(A) + '/' + sysutils.IntToStr(B);
end;

procedure Show(Format: string; UpperCase: Integer);
var
  Exception: Integer;
begin
  Exception := UpperCase * 2;
  WriteLn(Format, ' ', UpperCase, ' ', Exception, ' ', sysutils.Format('%d', [UpperCase]));
end;

var
  b: TBytes;
  sb: sysutils.TBytes;

begin
  Trim := 3;
  FormatSettings := 'mine';
  b.N := 4;
  SetLength(sb, 2);
  WriteLn(Trim, ' ', sysutils.Trim('  x  '), '|', FormatSettings, ' ',
    sysutils.FormatSettings.DecimalSeparator, ' ', EmptyStr, '|', sysutils.EmptyStr, '|');
  WriteLn(IntToStr(1, 2), ' ', b.N, ' ', Length(sb));
  Show('fmt', 21);
  try
    raise sysutils.Exception.Create('boom');
  except
    on E: sysutils.Exception do
      WriteLn(E.Message);
  end;
end.

