{ P272: FillChar 32 bytes a store on arm64 (rt_fill: DUP, STP of Q
  registers, the head and the tail by stores that overlap), rep stosb on
  amd64. Every length from 0 to 300 at every place from 0 to 63, with
  the 64 bytes before and after untouched; lengths about 128, the loop's
  step, and about the 256 KiB pieces of rt_fillbig; the zero values of
  records from 8 to 520 bytes; frames of 17 to 41 words, which must
  start zero after a routine filled the stack there. Every byte wrong is
  counted. }
program fillkern;

type
  T1 = record A: array[0..0] of Integer; end;
  T8 = record A: array[0..7] of Integer; end;
  T9 = record A: array[0..8] of Integer; end;
  T17 = record A: array[0..16] of Integer; end;
  T65 = record A: array[0..64] of Integer; end;

const
  Bigs: array[0..9] of Integer = (127, 128, 129, 255, 256, 257, 262143, 262144, 262145, 600001);

var
  bad, checked: Integer;
  r1: T1;
  r8: T8;
  r9: T9;
  r17: T17;
  r65: T65;

procedure Frame17;
var
  a: array[0..16] of Integer;
  i: Integer;
begin
  for i := 0 to 16 do
    if a[i] <> 0 then
      bad := bad + 1;
end;

procedure Frame18;
var
  a: array[0..17] of Integer;
  i: Integer;
begin
  for i := 0 to 17 do
    if a[i] <> 0 then
      bad := bad + 1;
end;

procedure Frame41;
var
  a: array[0..40] of Integer;
  i: Integer;
begin
  for i := 0 to 40 do
    if a[i] <> 0 then
      bad := bad + 1;
end;

procedure Dirty;
var
  a: array[0..63] of Integer;
  i: Integer;
begin
  for i := 0 to 63 do
    a[i] := -1;
  if a[5] <> -1 then
    bad := bad + 1;
end;

procedure Check(var B: array of Byte; Start, Len: Integer; V: Byte);
var
  i: Integer;
begin
  for i := 0 to High(B) do
  begin
    if (i >= Start) and (i < Start + Len) then
    begin
      if B[i] <> V then
        bad := bad + 1;
    end
    else if B[i] <> Byte(i * 7 + 1) then
      bad := bad + 1;
    checked := checked + 1;
  end;
end;

var
  b, big: array of Byte;
  len, al, i, j, v: Integer;

begin
  bad := 0;
  checked := 0;
  SetLength(b, 64 + 63 + 300 + 64);
  for len := 0 to 300 do
    for al := 0 to 63 do
    begin
      for i := 0 to High(b) do
        b[i] := Byte(i * 7 + 1);
      v := (len * 31 + al) and 255;
      FillChar(b[64 + al], len, v);
      Check(b, 64 + al, len, Byte(v));
    end;
  WriteLn('lengths to 300 at every place ', bad);
  SetLength(big, 600001 + 200);
  for j := 0 to 9 do
    for al := 0 to 3 do
    begin
      for i := 0 to High(big) do
        big[i] := Byte(i * 7 + 1);
      FillChar(big[64 + al * 5], Bigs[j], 0);
      Check(big, 64 + al * 5, Bigs[j], 0);
      for i := 0 to High(big) do
        big[i] := Byte(i * 7 + 1);
      FillChar(big[64 + al * 5], Bigs[j], 211);
      Check(big, 64 + al * 5, Bigs[j], 211);
    end;
  WriteLn('lengths about the steps and the pieces ', bad);
  FillChar(r1, SizeOf(r1), 9);
  FillChar(r8, SizeOf(r8), 9);
  FillChar(r9, SizeOf(r9), 9);
  FillChar(r17, SizeOf(r17), 9);
  FillChar(r65, SizeOf(r65), 9);
  r1 := Default(T1);
  r8 := Default(T8);
  r9 := Default(T9);
  r17 := Default(T17);
  r65 := Default(T65);
  if r1.A[0] <> 0 then
    bad := bad + 1;
  for i := 0 to 7 do
    if r8.A[i] <> 0 then
      bad := bad + 1;
  for i := 0 to 8 do
    if r9.A[i] <> 0 then
      bad := bad + 1;
  for i := 0 to 16 do
    if r17.A[i] <> 0 then
      bad := bad + 1;
  for i := 0 to 64 do
    if r65.A[i] <> 0 then
      bad := bad + 1;
  WriteLn('zero values ', bad);
  Dirty;
  Frame17;
  Dirty;
  Frame18;
  Dirty;
  Frame41;
  WriteLn('frames ', bad);
  WriteLn('checked ', checked);
end.
