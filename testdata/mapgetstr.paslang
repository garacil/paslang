{ 1.0.69: m[s] and s in m with a string key run rt_mapgetstr, the
  runtime's own lookup. A nil map and an empty one answer the zero
  value; the empty key is a key; keys of one length that differ in one
  byte, at every place of the eight-byte pieces and the tail, are told
  apart when the key looked up is a copy (its bytes compared) and when
  it is the stored string itself (its pointer). }
program mapgetstr;

uses
  paslib;

var
  m, e, z: map[string] of Integer;
  keys: array of string;
  s, t: string;
  i, n, len, pos, bad, found, sum: Integer;

function Key(Len, Pos: Integer): string;
var
  j: Integer;
begin
  Result := '';
  for j := 0 to Len - 1 do
    if j = Pos then
      Result := Result + '#'
    else
      Result := Result + Chr(97 + j mod 26);
end;

begin
  { nil and empty }
  WriteLn(z['a'], ' ', 'a' in z);
  New(e);
  WriteLn(e['a'], ' ', 'a' in e, ' ', e[''], ' ', Length(e));
  New(m);
  m[''] := 7;
  WriteLn(m[''], ' ', '' in m, ' ', m['a'], ' ', 'a' in m);
  { one key per length and differing byte, plus the plain one }
  n := 0;
  SetLength(keys, 24 * 26);
  for len := 1 to 24 do
  begin
    keys[n] := Key(len, -1);
    m[keys[n]] := len * 1000;
    n := n + 1;
    for pos := 0 to len - 1 do
    begin
      keys[n] := Key(len, pos);
      m[keys[n]] := len * 1000 + pos + 1;
      n := n + 1;
    end;
  end;
  bad := 0;
  found := 0;
  sum := 0;
  for len := 1 to 24 do
  begin
    { a copy: the bytes are compared }
    s := Key(len, -1);
    if m[s] <> len * 1000 then
      bad := bad + 1;
    for pos := 0 to len - 1 do
    begin
      t := Key(len, pos);
      if m[t] <> len * 1000 + pos + 1 then
        bad := bad + 1;
      if t in m then
        found := found + 1;
      { one byte more or less is another key }
      if (t + 'y') in m then
        bad := bad + 1;
      if Copy(t, 1, len - 1) + 'z' in m then
        bad := bad + 1;
    end;
  end;
  { the stored strings themselves: the pointers are equal }
  for i := 0 to n - 1 do
    sum := sum + m[keys[i]];
  WriteLn(n, ' ', Length(m), ' ', found, ' ', bad, ' ', sum);
  { a long key goes through rt_xxh3's long path and a long compare }
  s := '';
  for i := 1 to 1000 do
    s := s + Chr(65 + i mod 50);
  m[s] := 99;
  t := Copy(s, 1, 999) + Chr(65 + 1000 mod 50);
  WriteLn(m[t], ' ', t in m, ' ', m[Copy(s, 1, 999) + '!'], ' ', Length(m));
end.

