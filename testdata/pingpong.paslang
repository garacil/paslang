program pingpong;

var
  c: chan of Integer;
  x: Integer;

procedure Pong;
var
  n: Integer;
begin
  n := Recv(c);
  Send(c, n + 1);
end;

begin
  c := MakeChan();
  pas Pong;
  Send(c, 1);
  x := Recv(c);
  WriteLn(x);
end.

