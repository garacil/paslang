{ P289: an index whose range its operation proves lies in a static
  array's bounds is not checked: x and K, x mod K of a value not
  negative, x shr K, a narrow value, a sum of those, and a for's counter
  between constant limits that only its loop writes, on the word path
  and on the general one (elements of 16 and 24 bytes, a low bound of
  1). Each value is the one the checked index gives. The fatal tests bmaskwide, bmodneg,
  bmaskone, bforpast, bvarctr and bnestctr keep the checks a proof
  cannot drop. }
program bceprove;

type
  TFn = function(K: Integer): Integer;
  TPair = record
    A, B: Integer;
  end;
  TTriple = record
    A, B, C: Integer;
  end;

var
  g: array[0..63] of Integer;
  h: array[1..16] of Integer;
  w: array[0..255] of Integer;
  q: array[0..3] of Integer;
  fns: array[0..63] of TFn;
  pairs: array[1..8] of TPair;
  triples: array[1..8] of TTriple;

function Masked(i: Integer): Integer;
begin
  Result := g[i and 63];
end;

function ModPos(i: Integer): Integer;
begin
  Result := g[(i and 1023) mod 64];
end;

function Shifted(x: Integer): Integer;
begin
  Result := q[x shr 62];
end;

function OneBased(i: Integer): Integer;
begin
  Result := h[(i and 15) + 1];
end;

function ByteIdx(b: Byte): Integer;
begin
  Result := w[b];
end;

function SumFor: Integer;
var
  k, s: Integer;
begin
  s := 0;
  for k := 0 to 63 do
    s := s + g[k];
  for k := 16 downto 1 do
    s := s + h[k];
  Result := s;
end;

function Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

function Thrice(K: Integer): Integer;
begin
  Result := K * 3;
end;

{ elements of 16 and of 24 bytes and a low bound of 1: the general path }
function PairAt(i: Integer): Integer;
begin
  Result := pairs[(i and 7) + 1].B;
end;

function TripleAt(i: Integer): Integer;
var
  r: TTriple;
begin
  r := triples[(i and 7) + 1];
  Result := r.C;
end;

function PairAny(i: Integer): Integer;
var
  r: TPair;
begin
  r := pairs[i];
  Result := r.A;
end;

function CallMasked(n: Integer): Integer;
var
  i, t: Integer;
begin
  t := 0;
  for i := 1 to n do
    t := t + fns[i and 63](i and 15);
  Result := t;
end;

var
  i: Integer;

begin
  for i := 0 to 63 do
    g[i] := i * 3;
  for i := 1 to 16 do
    h[i] := i * 5;
  for i := 0 to 255 do
    w[i] := 1000 + i;
  for i := 0 to 3 do
    q[i] := 7 * i;
  for i := 0 to 63 do
    if i mod 2 = 0 then
      fns[i] := @Twice
    else
      fns[i] := @Thrice;
  WriteLn(Masked(5), ' ', Masked(-1), ' ', Masked(1000));
  WriteLn(ModPos(70), ' ', ModPos(-1));
  WriteLn(Shifted(-1), ' ', Shifted(5), ' ', Shifted(High(Integer)));
  WriteLn(OneBased(0), ' ', OneBased(15), ' ', OneBased(-1));
  WriteLn(ByteIdx(0), ' ', ByteIdx(255));
  WriteLn(SumFor);
  WriteLn(CallMasked(1000));
  for i := 1 to 8 do
  begin
    pairs[i].A := i;
    pairs[i].B := 10 * i;
    triples[i].A := i;
    triples[i].B := 0;
    triples[i].C := 100 * i;
  end;
  WriteLn(PairAt(0), ' ', PairAt(7), ' ', PairAt(-1), ' ', PairAt(12));
  WriteLn(TripleAt(0), ' ', TripleAt(7), ' ', TripleAt(-3));
  WriteLn(PairAny(1), ' ', PairAny(8));
end.

