program miscmath;

var
  n, i: Real;
  c: array of Real;

begin
  WriteLn(Pi);
  n := Pi;
  WriteLn(n);
  WriteLn(Pi() * 2.0);
  WriteLn(Odd(3));
  WriteLn(Odd(4));
  WriteLn(Odd(-7));
  WriteLn(Min(3, 7));
  WriteLn(Max(3, 7));
  WriteLn(Min(-3, -7));
  WriteLn(Max(-3, -7));
  WriteLn(Min(2.5, 2.25));
  WriteLn(Max(2.5, 2.25));
  WriteLn(Floor(2.5));
  WriteLn(Floor(-2.5));
  WriteLn(Floor(2.0));
  WriteLn(Ceil(2.5));
  WriteLn(Ceil(-2.5));
  WriteLn(Ceil(2.0));
  WriteLn(Floor(7));
  WriteLn(Ceil(7));
  WriteLn(Ldexp(1.5, 3));
  WriteLn(Ldexp(1.0, -2));
  WriteLn(Ldexp(3.0, 0));
  WriteLn(Ldexp(-1.0, 4));
  WriteLn(LnXP1(1.0));
  WriteLn(LnXP1(0.0));
  WriteLn(LnXP1(-0.5));
  WriteLn(LnXP1(1.0E-9));
  WriteLn(LogN(2, 8));
  WriteLn(LogN(10, 100));
  WriteLn(LogN(3, 81));
  SetLength(c, 4);
  c[0] := 1;
  c[1] := 2;
  c[2] := 3;
  c[3] := 4;
  WriteLn(Poly(2.0, c));
  SetLength(c, 1);
  c[0] := 7.5;
  WriteLn(Poly(3.0, c));
  n := 0.0 / 0.0;
  i := 1.0 / 0.0;
  WriteLn(IsNan(n));
  WriteLn(IsNan(i));
  WriteLn(IsInfinite(i));
  WriteLn(IsInfinite(n));
  WriteLn(IsNan(2.0));
end.

