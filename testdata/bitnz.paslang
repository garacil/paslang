{ P394: a bit count of a value an if proved not zero takes no sentinel:
  TrailingZeros and LeadingZeros in the then of x <> 0 and the else of
  x = 0, of 64, 32, 16 and 8 bits, against a count bit by bit over
  values of every width; and the counts that keep it: the value written
  in the branch, a var parameter, a global, and outside any test, where
  0 gives the width. The routines Nz* are read by scripts/check_bitnz.py
  (-cpu base: no cmovz, no sentinel), the routines Keep* keep it. }
program bitnz;

var
  g: Int64;
  bad, i, k, n: Integer;
  v: Int64;

function RefTz(X: Int64; W: Integer): Integer;
var
  k: Integer;
begin
  Result := W;
  for k := 0 to W - 1 do
    if ((X shr k) and 1) <> 0 then
    begin
      Result := k;
      Exit;
    end;
end;

function RefLz(X: Int64; W: Integer): Integer;
var
  k: Integer;
begin
  Result := W;
  for k := W - 1 downto 0 do
    if ((X shr k) and 1) <> 0 then
    begin
      Result := W - 1 - k;
      Exit;
    end;
end;

function NzTz64(X: Int64): Integer;
begin
  Result := -1;
  if X <> 0 then
    Result := TrailingZeros(X);
end;

function NzLz64(X: Int64): Integer;
begin
  if X = 0 then
    Result := -1
  else
    Result := LeadingZeros(X);
end;

function NzTz32(X: UInt32): Integer;
begin
  Result := -1;
  if 0 <> X then
    Result := TrailingZeros(X);
end;

function NzLz16(X: Word): Integer;
begin
  Result := -1;
  if X <> 0 then
    Result := LeadingZeros(X);
end;

function NzTz8(X: Byte): Integer;
begin
  Result := -1;
  if X <> 0 then
    Result := TrailingZeros(X) + LeadingZeros(X) * 10;
end;

{ the loop's word cleared bit by bit, the count before the write }
function NzBits(X: Int64): Integer;
var
  w: Int64;
begin
  Result := 0;
  w := X;
  while True do
  begin
    if w <> 0 then
    begin
      Result := Result * 3 + TrailingZeros(w);
      Result := Result and $FFFFFFF;
    end
    else
      Exit;
    w := w and (w - 1);
  end;
end;

{ written in the branch: the sentinel stays }
function KeepWritten(X: Int64): Integer;
var
  w: Int64;
begin
  Result := -1;
  w := X;
  if w <> 0 then
  begin
    w := w shr 1;
    Result := TrailingZeros(w);
  end;
end;

{ a var parameter, which a call could write: the sentinel stays }
function KeepVar(var X: Int64): Integer;
begin
  Result := -1;
  if X <> 0 then
    Result := TrailingZeros(X);
end;

{ a global: the sentinel stays }
function KeepGlobal: Integer;
begin
  Result := -1;
  if g <> 0 then
    Result := LeadingZeros(g);
end;

begin
  bad := 0;
  n := 0;
  v := 1;
  for i := 0 to 400 do
  begin
    { values of every width: a walking bit, its neighbours and a mix }
    case i mod 4 of
      0: v := Int64(1) shl (i mod 64);
      1: v := (Int64(1) shl (i mod 64)) or (Int64(1) shl ((i * 7) mod 64));
      2: v := v * 6364136223846793005 + 1442695040888963407;
    else
      v := v xor (v shr 13);
    end;
    if v = 0 then
      Continue;
    n := n + 1;
    if NzTz64(v) <> RefTz(v, 64) then
      bad := bad + 1;
    if NzLz64(v) <> RefLz(v, 64) then
      bad := bad + 1;
    if (UInt32(v) <> 0) and (NzTz32(UInt32(v)) <> RefTz(v and $FFFFFFFF, 32)) then
      bad := bad + 1;
    if (Word(v) <> 0) and (NzLz16(Word(v)) <> RefLz(v and $FFFF, 16)) then
      bad := bad + 1;
    if (Byte(v) <> 0) and (NzTz8(Byte(v)) <> RefTz(v and 255, 8) + RefLz(v and 255, 8) * 10) then
      bad := bad + 1;
    if KeepWritten(v) <> RefTz(v shr 1, 64) then
      bad := bad + 1;
    if KeepVar(v) <> RefTz(v, 64) then
      bad := bad + 1;
    g := v;
    if KeepGlobal <> RefLz(v, 64) then
      bad := bad + 1;
  end;
  WriteLn('values ', n, ' bad ', bad);
  WriteLn('zeros ', NzTz64(0), ' ', NzLz64(0), ' ', NzTz32(0), ' ', NzLz16(0), ' ', NzTz8(0));
  v := 1;
  WriteLn('written ', KeepWritten(1), ' var ', KeepVar(v), ' bits ', NzBits(Int64($8000000000000401)));
  k := 0;
  g := 0;
  WriteLn('global ', KeepGlobal, ' ', TrailingZeros(g), ' ', LeadingZeros(g), ' ', k);
end.
