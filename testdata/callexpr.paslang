{ P297: a call inside an expression pushes nothing. An operand no call
  can change (a constant, a local of the routine's own, a global of the
  program that only its main block names) is read after the call, the
  same value; one a call can change (a global a routine names, a
  variable a var parameter is given, one a closure captures or a nested
  routine names, a field) is read before it, left to right; the calls
  stay left to right. The code and second word of a routine value, a
  method value and an interface go from their place to the call's
  registers; a static array's address is taken after its index, also
  when the index calls a routine whose stack grows. scripts/
  check_callexpr.py reads the forms. }
program callexpr;

uses paslib;

type
  TFn = function(K: Integer): Integer;
  TF32 = function(K: Int32): Int32;
  TF6 = function(A, B, C, D, E, F: Integer): Integer;
  PInt = ^Integer;
  TBumpP = function(P: PInt; K: Integer): Integer;
  TPair = record
    Tag: Integer;
    Fn: TFn;
  end;
  PFn = ^TFn;
  IShape = interface
    function Area(K: Integer): Integer;
  end;
  TSquare = class(IShape)
    Side: Integer;
    function Area(K: Integer): Integer;
  end;
  TRect = class(IShape)
    W, H: Integer;
    function Area(K: Integer): Integer;
  end;
  TCount = class
    Count: Integer;
    function Bump(K: Integer): Integer;
    function Get(K: Integer): Integer; virtual;
  end;
  TCount2 = class(TCount)
    function Get(K: Integer): Integer; override;
  end;
  TMeth = function(K: Integer): Integer of object;

var
  fns: array[0..63] of TFn;
  shapes: array[0..3] of IShape;
  objs: array[0..1] of TCount;
  g, m, mt, i, r: Integer;
  lg: string;

function TSquare.Area(K: Integer): Integer;
begin
  Result := Side * Side + K;
end;

function TRect.Area(K: Integer): Integer;
begin
  Result := W * H - K;
end;

function TCount.Bump(K: Integer): Integer;
begin
  Count := Count + 10;
  Result := K;
end;

function TCount.Get(K: Integer): Integer;
begin
  lg := lg + 'a' + IntToStr(K);
  Result := Count + K;
end;

function TCount2.Get(K: Integer): Integer;
begin
  lg := lg + 'b' + IntToStr(K);
  Result := Count * 2 + K;
end;

function Twice(K: Integer): Integer;
begin
  Result := K * 2;
end;

function Thrice(K: Integer): Integer;
begin
  Result := K * 3;
end;

function Neg32(K: Int32): Int32;
begin
  Result := -K;
end;

function Mix6(A, B, C, D, E, F: Integer): Integer;
begin
  Result := A + B * 10 + C * 100 + D * 1000 + E * 10000 + F * 100000;
end;

function BumpG(K: Integer): Integer;
begin
  g := g + 100;
  Result := K;
end;

function BumpVar(var X: Integer; K: Integer): Integer;
begin
  X := X + 100;
  Result := K;
end;

function BumpPtr(P: PInt; K: Integer): Integer;
begin
  P^ := P^ + 100;
  Result := K;
end;

function Note(K: Integer): Integer;
begin
  lg := lg + IntToStr(K);
  Result := K;
end;

function Sum3(A, B, C: Integer): Integer;
begin
  Result := A * 100 + B * 10 + C;
end;

function Pick(Big: Boolean): TFn;
begin
  if Big then
    Result := @Thrice
  else
    Result := @Twice;
end;

function Deep(N: Integer): Integer;
begin
  if N = 0 then
    Result := 0
  else
    Result := Deep(N - 1);
end;

{ t a local: fns alternate Twice and Thrice, so an even k doubles k and
  15 and an odd one triples it }
function Run(n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to n - 1 do
    t := t + fns[k and 63](k and 15);
  Result := t;
end;

{ v's address taken, and a routine value writes through it: read
  before the call }
function LocVar: Integer;
var
  v: Integer;
  p: PInt;
  bp: TBumpP;
begin
  v := 5;
  p := @v;
  bp := @BumpPtr;
  Result := v + bp(p, 1) * 10;
  Result := Result * 1000 + v;
end;

{ c in the closure's box: read before the call }
function Boxed: Integer;
var
  c: Integer;
  f: TFn;
begin
  c := 1;
  f := function(K: Integer): Integer
  begin
    c := c + 50;
    Result := K;
  end;
  Result := c + f(2);
  Result := Result * 100 + c;
end;

{ Inner writes v: read before the call }
function Outer: Integer;
var
  v: Integer;

  function Inner(K: Integer): Integer;
  begin
    v := v + 1000;
    Result := K;
  end;

begin
  v := 1;
  Result := v + Inner(5);
  Result := Result * 10000 + v;
end;

{ a routine value of the routine around: one level up }
function Around(K: Integer): Integer;
var
  f: TFn;

  function Use(J: Integer): Integer;
  begin
    Result := J + f(J);
  end;

begin
  f := @Thrice;
  Result := Use(K) + K;
end;

function Adder(N: Integer): TFn;
begin
  Result := function(K: Integer): Integer
  begin
    Result := K + N;
  end;
end;

{ the right side an outer routine's variable or a closure's, which
  calls nothing: worked out first, the left read after it }
function Upper(N: Integer): Integer;
var
  v: Integer;
  f: TFn;

  function Diff(J: Integer): Integer;
  var
    b: Boolean;
  begin
    Result := J - v;
    b := J < v * 2;
    if b then
      Result := Result * 10;
  end;

begin
  v := N;
  f := Adder(N);
  Result := Diff(50) * 1000 + f(7);
end;

function Narrow: Int32;
var
  a: Int32;
  f: TF32;
begin
  a := -5;
  f := @Neg32;
  Result := a + f(3);
  Result := Result * f(-2);
end;

function CallVia(var F: TFn; K: Integer): Integer;
begin
  Result := F(K) + 1;
end;

{ a local array's element whose index calls a routine that grows the
  stack: the array's address is taken after the call }
function LocArr(N: Integer): Integer;
var
  a: array[0..9] of TPair;
  k: Integer;
begin
  for k := 0 to 9 do
  begin
    a[k].Tag := k * 11;
    if k mod 2 = 0 then
      a[k].Fn := @Twice
    else
      a[k].Fn := @Thrice;
  end;
  Result := a[Deep(N) + 3].Tag * 1000 + a[Deep(N) + 4].Fn(Deep(N) + 7);
end;

{ interfaces, from an array and held in a local }
function Areas(n: Integer): Integer;
var
  k, t: Integer;
  sh: IShape;
begin
  t := 0;
  for k := 0 to n - 1 do
    t := t + shapes[k and 3].Area(k and 7);
  sh := shapes[1];
  Result := t * 10 + sh.Area(3);
end;

{ virtual methods through an array of objects, and a method value }
function Gets(n: Integer): Integer;
var
  k, t, t0: Integer;
  mv: TMeth;
begin
  t := 0;
  for k := 0 to n - 1 do
    t := t + objs[k and 1].Get(k and 3);
  mv := objs[0].Bump;
  t0 := 7;
  Result := t * 100 + t0 + mv(5);
end;

{ six arguments through a routine value, one worked out and the others
  straight; then one too wide for three registers }
function Six(n: Integer): Integer;
var
  k, t: Integer;
  f6: TF6;
  f: TFn;
begin
  f6 := @Mix6;
  t := 0;
  for k := 0 to n - 1 do
    t := t + f6(k and 7, 2, n, 4, 5, 1);
  f := @Twice;
  Result := t + f((n and 7) + (n shr 1) * ((n xor 3) + (n and 1)) - ((n or 2) * (n and 5)));
end;

var
  h: TPair;
  pf: PFn;
  fv, lv: TFn;
  sq: TSquare;
  re: TRect;
  c1: TCount;
  c2: TCount2;
  k: Integer;

begin
  for k := 0 to 63 do
    if k mod 2 = 0 then
      fns[k] := @Twice
    else
      fns[k] := @Thrice;
  WriteLn(Run(1000), ' ', Run(64));
  { g a routine names: left to right }
  g := 5;
  r := g + BumpG(1);
  WriteLn(r, ' ', g);
  fv := @BumpG;
  g := 5;
  r := g * fv(2);
  WriteLn(r, ' ', g);
  { m given to a var parameter: left to right }
  m := 5;
  r := m + BumpVar(m, 1);
  WriteLn(r, ' ', m);
  { mt only the main block names: read after the call }
  mt := 0;
  for i := 1 to 100 do
    mt := mt + fns[i and 63](i and 15);
  WriteLn(mt);
  mt := 7 * fns[3](4);
  WriteLn(mt);
  mt := mt xor fns[2](5);
  WriteLn(mt);
  mt := mt and fns[1](31);
  WriteLn(mt);
  mt := mt or fns[0](64);
  WriteLn(mt);
  mt := mt - fns[1](1);
  WriteLn(mt, ' ', mt < fns[0](100), ' ', 100 > fns[1](33), ' ', 3 * fns[5](mt) - mt);
  { locals given, boxed or named by a nested routine }
  WriteLn(LocVar, ' ', Boxed, ' ', Outer, ' ', Around(4), ' ', Narrow);
  WriteLn(Upper(4), ' ', Upper(30));
  { a field a method changes: left to right }
  c1 := TCount.Create;
  c1.Count := 3;
  r := c1.Count + c1.Bump(4);
  WriteLn(r, ' ', c1.Count);
  { calls left to right }
  lg := '';
  r := Note(1) + Note(2) * Note(3);
  lv := @Note;
  r := r * 100 + lv(4) - lv(5) * lv(6);
  WriteLn(r, ' ', lg);
  lg := '';
  r := Sum3(Note(7), Note(8), Note(9)) + lv(1) * Sum3(lv(2), 3, lv(4));
  WriteLn(r, ' ', lg);
  { routine values from a record, a pointer, a var parameter, a result }
  h.Tag := 1;
  h.Fn := @Thrice;
  pf := @fv;
  fv := @Twice;
  WriteLn(h.Fn(3), ' ', pf^(4), ' ', CallVia(fv, 5), ' ', Pick(True)(5), ' ', Pick(False)(6) + h.Fn(1));
  { a local array, its index calling deep }
  WriteLn(LocArr(3000));
  { interfaces }
  for k := 0 to 3 do
    if k mod 2 = 0 then
    begin
      sq := TSquare.Create;
      sq.Side := k + 1;
      shapes[k] := sq;
    end
    else
    begin
      re := TRect.Create;
      re.W := k;
      re.H := 3;
      shapes[k] := re;
    end;
  WriteLn(Areas(100));
  { virtual methods and a method value }
  c1 := TCount.Create;
  c1.Count := 2;
  c2 := TCount2.Create;
  c2.Count := 5;
  objs[0] := c1;
  objs[1] := c2;
  lg := '';
  WriteLn(Gets(6), ' ', lg, ' ', objs[0].Count);
  { six arguments }
  WriteLn(Six(10), ' ', Six(37));
end.

