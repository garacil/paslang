{ P363: a heap that grows under the collector's stress, whose slow paths
  run through rt_gocall with the routine's lock count up; under gdb,
  scripts/check_nopre.py asks for a stop there and reads the record at
  rt_morestack's return by .ms_nopre. The sums say the program ran as
  it would without the stop. }
program nopre;

var
  i, j, s: Integer;
  a: array of Integer;
  t: string;

begin
  s := 0;
  for i := 1 to 3000 do
  begin
    SetLength(a, 0);
    SetLength(a, 100 + (i and 255));
    for j := 0 to High(a) do
      a[j] := i + j;
    t := 'n' + Chr(Ord('a') + (i mod 26));
    s := s + a[High(a)] + Length(t);
  end;
  WriteLn(s);
end.

