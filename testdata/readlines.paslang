{ ReadLn keeps what follows a line for the next ReadLn (1.0.57): each
  call had a buffer of its own, so the second of two lines that came in
  one read was lost and a line was cut at 256 bytes. A line ends at a
  line feed or at the end of the input; past the end ReadLn gives ''. }
program readlines;

var
  s: string;
  i: Integer;

begin
  for i := 1 to 6 do
  begin
    ReadLn(s);
    if Length(s) > 20 then
      WriteLn(i, ' ', Length(s), ' ', s[1], s[Length(s)])
    else
      WriteLn(i, ' [', s, ']');
  end;
end.
