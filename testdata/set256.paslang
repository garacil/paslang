{ Sets up to 256 elements (P126): a set of Char, of Byte, of a subrange
  past 63, of an enumeration of 70 names, next to sets of one word; a
  list in brackets with ranges and elements known only at run time;
  + - * = <> <= >= and in on each; for x in with break and continue;
  typed and named constants, a set's default parameter, a set field of a
  record and of an object, a set passed by value, var and const, and
  one a function returns; Include and Exclude. The same source compiles
  with Free Pascal, whose output is the one expected. }
program set256;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  TChars = set of Char;
  TBytes = set of Byte;
  TSmall = set of 0..7;
  TWord = set of 0..63;
  TMid = set of 60..140;
  TGlyph = (g00, g01, g02, g03, g04, g05, g06, g07, g08, g09, g10, g11, g12, g13, g14, g15, g16, g17, g18, g19, g20, g21, g22, g23, g24, g25, g26, g27, g28, g29, g30, g31, g32, g33, g34, g35, g36, g37, g38, g39, g40, g41, g42, g43, g44, g45, g46, g47, g48, g49, g50, g51, g52, g53, g54, g55, g56, g57, g58, g59, g60, g61, g62, g63, g64, g65, g66, g67, g68, g69);
  TGlyphs = set of TGlyph;
  TColor = (Red, Green, Blue);
  TColors = set of TColor;

  TRec = record
    Tag: Integer;
    Cs: TChars;
    Last: Integer;
  end;

  TBox = class
    Cs: TChars;
    Small: TSmall;
    function Total: Integer;
  end;

const
  Vowels: TChars = ['a', 'e', 'i', 'o', 'u'];
  HexDigits = ['0'..'9', 'a'..'f', 'A'..'F'];
  Evens: TBytes = [0, 2, 4, 250, 252, 254];
  Far: TGlyphs = [g01, g63, g64, g69];

function TBox.Total: Integer;
var
  c: Char;
  i: Integer;
begin
  Result := 0;
  for c in Cs do
    Result := Result + Ord(c);
  for i in Small do
    Result := Result + i;
end;

procedure Show(const S: TChars);
var
  c: Char;
begin
  Write('[');
  for c in S do
    Write(c);
  WriteLn(']');
end;

procedure ShowB(S: TBytes);
var
  b: Byte;
begin
  Write('{');
  for b in S do
    Write(' ', b);
  WriteLn(' }');
end;

procedure ShowG(const S: TGlyphs);
var
  g: TGlyph;
begin
  Write('<');
  for g in S do
    Write(' ', Ord(g));
  WriteLn(' >');
end;

procedure AddTo(var S: TChars; c: Char);
begin
  S := S + [c];
end;

function Letters(Upper: Boolean): TChars;
begin
  if Upper then
    Result := ['A'..'Z']
  else
    Result := ['a'..'z'];
end;

function Picked(S: TChars = ['x', 'y', 'z']): Integer;
var
  c: Char;
begin
  Result := 0;
  for c in S do
    Result := Result * 3 + Ord(c) - 96;
end;

function B(V: Boolean): Integer;
begin
  if V then
    Result := 1
  else
    Result := 0;
end;

var
  s, t, u: TChars;
  bs, bt: TBytes;
  sm, sn: TSmall;
  wd: TWord;
  md: TMid;
  gs, gt: TGlyphs;
  cs: TColors;
  r: TRec;
  box: TBox;
  c, lo, hi: Char;
  i, n: Integer;
  bb: Byte;
  g: TGlyph;

begin
  { a set of Char: literal ranges, run-time elements, the operators }
  s := ['a'..'f', 'x', '0'..'3'];
  Show(s);
  lo := 'k';
  hi := 'p';
  c := '!';
  t := [lo..hi, c, Chr(Ord(c) + 1), #200, #255, #0];
  Write(Ord(#0 in t), Ord(#255 in t), Ord(#200 in t), Ord(#199 in t), ' ');
  Show(t - [#0, #200, #255]);
  u := s + t;
  Show(u * ['a'..'z']);
  Show(u - s - [#0, #200, #255]);
  Show(s * t);
  Show((s + ['m']) * t);
  WriteLn(B(s = s + []), B(s <> t), B(s * t = []), B(['a', 'b'] <= s), B(s >= ['x']),
    B(['a', 'z'] <= s), B(s >= s), B([] <= t), B(u >= s), B(u <= s));
  WriteLn(B('c' in s), B('g' in s), B(c in t), B(c in s), B('k' in [lo..hi]), B('q' in [lo..hi]));
  AddTo(s, 'Z');
  Include(s, 'Y');
  Exclude(s, 'a');
  Show(s);
  Show(Letters(True) * ['X'..'b']);
  Show(Letters(False) - ['b'..'y']);
  Show(Vowels + ['y']);
  WriteLn(B('F' in HexDigits), B('g' in HexDigits), B('7' in HexDigits), B('e' in Vowels));
  { a set of Byte and one past 63 }
  bs := [1, 3, 5, 63, 64, 65, 127, 128, 200, 255];
  ShowB(bs);
  ShowB(bs * Evens);
  ShowB(Evens - bs);
  bt := [];
  for i := 250 to 255 do
    bt := bt + [i];
  ShowB(bt + [0]);
  bb := 128;
  WriteLn(B(bb in bs), B(Byte(129) in bs), B(0 in Evens), B(255 in bt), B(bs = bs * bs));
  n := 70;
  md := [60, 99..101, 140];
  Include(md, n);
  WriteLn(B(n in md), B(100 in md), B(102 in md), B(140 in md), B(60 in md), B(61 in md));
  for i in md do
    Write(i, ' ');
  WriteLn;
  { an enumeration of 70 names }
  gs := [g00, g05..g07, g63, g64, g65, g69];
  ShowG(gs);
  ShowG(gs * Far);
  ShowG(Far - gs);
  gt := gs;
  Include(gt, g30);
  Exclude(gt, g64);
  ShowG(gt);
  WriteLn(B(g64 in gs), B(g64 in gt), B(gt >= [g30]), B(Far <= gs), B(gs <> gt));
  { sets of one word, beside them }
  sm := [1, 3, 5];
  sn := [0, 2];
  WriteLn(B([1] <= sn), B(sn >= [0]), B([1, 2] <= [1, 2, 3]), B(sm * sn = []), B(sm + sn = [0..3, 5]));
  for i in sm + sn do
    Write(i);
  WriteLn;
  { one kind of element, other ranges: the set that holds both, and the
    elements outside a range dropped where a set goes into it }
  bs := [1, 3, 100, 200];
  sm := bs;
  for i in sm do
    Write(i, ' ');
  WriteLn('.');
  sm := [2, 5];
  bs := sm + [150];
  ShowB(bs);
  md := bs;
  for i in md do
    Write(i, ' ');
  WriteLn('.');
  md := [70, 130];
  bs := md + sm;
  ShowB(bs);
  WriteLn(B(sm <= bs), B(bs = sm + md), B(md * bs = [70]), B(md * bs = [70, 130]), B(md <= bs));
  wd := [1, 40, 63];
  sm := wd;
  for i in sm do
    Write(i, ' ');
  wd := sm + wd + [7];
  for i in wd do
    Write(' ', i);
  WriteLn;
  WriteLn(B(sm <= wd), B(wd - sm = [7, 40, 63]), B([40] <= wd - sm));
  bs := [1, 3, 5, 63, 64, 65, 127, 128, 200, 255];
  sm := [1, 3, 5];
  cs := [Red, Blue];
  WriteLn(B(Green in cs), B(Blue in cs), B(cs >= [Red]), B([Red, Green] <= cs));
  { for x in: break, continue, a list }
  n := 0;
  for c in ['a'..'z'] do
  begin
    if c in Vowels then
      continue;
    if c > 'h' then
      break;
    n := n * 2 + 1;
    Write(c);
  end;
  WriteLn(' ', n);
  for i in sm do
  begin
    if i = 3 then
      continue;
    Write(i);
  end;
  WriteLn;
  for i in [9, 2, 5] do
    Write(i);
  WriteLn;
  for g in gs do
  begin
    if Ord(g) < 60 then
      continue;
    if g = g69 then
      break;
    Write(' ', Ord(g));
  end;
  WriteLn;
  for bb in bs do
  begin
    if bb < 100 then
      continue;
    Write(' ', bb);
  end;
  WriteLn;
  { in a record, in an object, a default }
  r.Tag := 7;
  r.Cs := ['p', 'q'];
  r.Last := 9;
  Include(r.Cs, 'r');
  Show(r.Cs);
  WriteLn(r.Tag, ' ', r.Last);
  box := TBox.Create;
  box.Cs := ['A', 'B'];
  box.Small := [1, 7];
  WriteLn(box.Total);
  WriteLn(Picked, ' ', Picked(['a', 'c']), ' ', Picked([]));
  { an element out of the set's range is in no set }
  i := 300;
  WriteLn(B(i in bs), B(i in md));
  i := -1;
  WriteLn(B(i in bs), B(i in sm));
  i := 64;
  WriteLn(B(i in sm), B(i in bs));
end.

