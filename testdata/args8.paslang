program args8;

function Sum8(A, B, C, D, E, F, G, H: Integer): Integer;
begin
  Result := A + B + C + D + E + F + G + H;
end;

procedure AddOut(A, B, C, D, E, F, G, H: Integer);
begin
  WriteLn(A + B + C + D + E + F + G + H);
end;

function NestSum: Integer;
var
  k: Integer;

  function Inner(A, B, C, D, E, F, G, H: Integer): Integer;
  begin
    Result := A + B + C + D + E + F + G + H + k;
  end;

begin
  k := 0;
  Result := Inner(1, 2, 3, 4, 5, 6, 7, 8);
end;

type
  TBox = class
    function Add6(A, B, C, D, E, F: Integer): Integer;
    procedure Show6(A, B, C, D, E, F: Integer);
  end;

function TBox.Add6(A, B, C, D, E, F: Integer): Integer;
begin
  Result := A + B + C + D + E + F;
end;

procedure TBox.Show6(A, B, C, D, E, F: Integer);
begin
  WriteLn(A + B + C + D + E + F);
end;

var
  o: TBox;

begin
  WriteLn(Sum8(1, 2, 3, 4, 5, 6, 7, 8));
  AddOut(1, 2, 3, 4, 5, 6, 7, 8);
  WriteLn(NestSum);
  o := TBox.Create;
  WriteLn(o.Add6(1, 2, 3, 4, 5, 6));
  o.Show6(1, 2, 3, 4, 5, 6);
end.

