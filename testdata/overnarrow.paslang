program overnarrow;

{ Overloads with the narrow integers (P99, 1.0.87). Each row of TYPES.md
  is a type of its own, so a routine can take Byte and Int16 apart. A
  call takes the same type first; then an integer that widens without
  losing a value, the nearer width first and the same sign before the
  other; then an integer for a real. A constant with no type is an
  Integer, so the widest type it fits comes first, and one with a sign
  before one without. }

type
  TBox = class
    procedure Put(x: Byte); overload;
    procedure Put(x: Int32); overload;
  end;

procedure TBox.Put(x: Byte);
begin
  WriteLn('box Byte ', x);
end;

procedure TBox.Put(x: Int32);
begin
  WriteLn('box Int32 ', x);
end;

procedure Show(x: Byte); overload;
begin
  WriteLn('Byte ', x);
end;

procedure Show(x: Int16); overload;
begin
  WriteLn('Int16 ', x);
end;

procedure Show(x: Integer); overload;
begin
  WriteLn('Integer ', x);
end;

procedure Show(const x: string); overload;
begin
  WriteLn('string ', x);
end;

procedure Put(x: Byte); overload;
begin
  WriteLn('put Byte ', x);
end;

procedure Put(x: Word); overload;
begin
  WriteLn('put Word ', x);
end;

procedure Sign(x: Byte); overload;
begin
  WriteLn('sign Byte ', x);
end;

procedure Sign(x: Int8); overload;
begin
  WriteLn('sign Int8 ', x);
end;

procedure Half(x: Double); overload;
begin
  WriteLn('half Double ', x / 2);
end;

procedure Half(const x: string); overload;
begin
  WriteLn('half string ', x);
end;

procedure Wide(x: Word); overload;
begin
  WriteLn('wide Word ', x);
end;

procedure Wide(x: Int16); overload;
begin
  WriteLn('wide Int16 ', x);
end;

var
  b: Byte;
  w: Word;
  i8: Int8;
  i32: Int32;
  u32: UInt32;
  box: TBox;

begin
  b := 7;
  w := 9;
  i8 := -3;
  i32 := 5;
  u32 := 11;
  Show(b);
  Show(w);
  Show(i8);
  Show(i32);
  Show(5);
  Show(300);
  Show('x');
  Put(b);
  Put(w);
  Put(5);
  Put(300);
  Sign(5);
  Sign(200);
  Sign(-5);
  Half(3);
  Half(i32);
  Half(u32);
  Half('y');
  Wide(b);
  Wide(i8);
  box := TBox.Create;
  box.Put(b);
  box.Put(i8);
  box.Put(w);
  box.Put(5);
  box.Put(255);
  box.Put(256);
end.

