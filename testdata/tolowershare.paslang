program tolowershare;
uses
  paslib;
{ ToLower of a string with no capital is the string itself, shared and
  not copied (P463): a change to either leaves the other as it was. }
var
  a, b, c, d: string;
  i: Integer;
begin
  a := 'alpha beta 123';
  b := ToLower(a);
  WriteLn(b);
  b[1] := 'X';
  WriteLn(a);
  WriteLn(b);
  a[2] := 'Y';
  WriteLn(a);
  WriteLn(b);
  c := 'Alpha BETA 456';
  d := ToLower(c);
  WriteLn(d);
  d[1] := 'Z';
  WriteLn(c);
  WriteLn(d);
  c := '';
  d := ToLower(c);
  WriteLn(Length(d));
  d := d + 'k';
  WriteLn(d, Length(c));
  c := 'result.w3';
  d := ToLower(c);
  i := 0;
  while i < 3 do
  begin
    d := ToLower(d);
    Inc(i);
  end;
  d := d + '!';
  WriteLn(c);
  WriteLn(d);
  WriteLn(ToLower('MiXeD') + ToLower('lower') + ToLower('UPPER'));
end.
