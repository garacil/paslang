program ptrtyped;

{ Pointer is an address and nothing more (P102): its target has a type
  only through a view. T(X^) is the T at X, a variable; PT(X) sees X as a
  pointer to T; the predefined PByte, PWord, PDWord, PInteger, PSingle
  and the rest are ^ of their types. Through a typed pointer T(pb^)
  converts the value, as in FPC. }

var
  buf: array[0..15] of Byte;
  i: Integer;
  X: Pointer;
  pb: PByte;
  pw: PWord;
  pd: PDWord;
  ip: PInteger;
  ps: PSingle;
  pp: PPointer;
  s: Single;

begin
  for i := 0 to 15 do
    buf[i] := Byte(i + 1);
  X := @buf;
  pb := @buf[0];
  WriteLn(Integer(pb^));
  WriteLn(PInteger(pb)^);
  WriteLn(Integer(X^));
  WriteLn(Byte(X^), ' ', Word(X^), ' ', UInt32(X^), ' ', Int8(X^));
  pw := PWord(X);
  WriteLn(pw^, ' ', pw[3]);
  pd := PDWord(X);
  WriteLn(pd[1], ' ', pd[3]);
  Word(X^) := 65535;
  WriteLn(buf[0], ' ', buf[1], ' ', buf[2]);
  PWord(X)^ := 258;
  WriteLn(buf[0], ' ', buf[1]);
  s := 1.5;
  X := @s;
  WriteLn(UInt32(X^));
  ps := PSingle(X);
  WriteLn(ps^:0:1);
  ip := @i;
  i := 42;
  WriteLn(ip^, ' ', Integer(PInteger(@i)^));
  pp := @X;
  WriteLn(pp^ = X);
  WriteLn(SizeOf(PByte), ' ', SizeOf(Pointer), ' ', SizeOf(pd^));
end.

