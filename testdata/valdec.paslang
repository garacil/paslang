{ P480: a plain decimal of up to eighteen bytes is read by a short path (eight
  digits a step) in Val and StrToInt and their kin; every other text, and a
  number outside the type, goes the long way. The expected output was made
  by the compiler before the short path existed: fixed texts of every kind
  of text Val reads, then a hundred thousand made of the bytes 0 to 9, a
  sign, a space, x and $ at lengths 0 to 20, read as an Int64, an Integer,
  a Byte, a ShortInt, a SmallInt, a Word, a LongInt, a QWord and a
  subrange; each result, and the place of the first fault, folded into a
  hash. }
program valdec;

uses
  sysutils;

type
  TR = -5..300;

const
  Fixed: array[0..58] of string = (
    '', '0', '-0', '+0', '7', '-7', '+7', '-', '+', '--1', '+-1', '1-', '12a', 'a12', '1 2', ' 12', '12 ', '1_0',
    '00000000', '00000001', '12345678', '123456789', '1234567890', '12345678901234567', '123456789012345678',
    '1234567890123456789', '9223372036854775807', '9223372036854775808', '-9223372036854775808', '-9223372036854775809',
    '+123456789012345678', '-12345678901234567', '-123456789012345678', '99999999', '-99999999', '255', '256', '-128', '-129',
    '32767', '32768', '65535', '65536', '2147483647', '2147483648', '$1F', '0x1F', '&17', '%101', 'x1F', '1e5', '1.5', '٣',
    '0000000a', '1234567a', 'a2345678', '12345a78', '1234567' + #0, '12' + #0 + '34');

var
  h: Int64;

procedure Mix(V, Code: Int64);
begin
  h := (h * 1000003 + V) xor (Code * 7919 + (h shr 29));
end;

procedure One(const S: string);
var
  i64, c: Int64;
  i32, ci: Integer;
  b: Byte;
  sh: ShortInt;
  sm: SmallInt;
  w: Word;
  lw: LongWord;
  q: QWord;
  r: TR;
begin
  Val(S, i64, ci);
  Mix(i64, ci);
  Val(S, i32, ci);
  Mix(i32, ci);
  Val(S, b, ci);
  Mix(b, ci);
  Val(S, sh, ci);
  Mix(sh, ci);
  Val(S, sm, ci);
  Mix(sm, ci);
  Val(S, w, ci);
  Mix(w, ci);
  Val(S, lw, ci);
  Mix(lw, ci);
  Val(S, q, ci);
  Mix(Int64(q), ci);
  Val(S, r, ci);
  Mix(r, ci);
  Mix(StrToInt64Def(S, -777), 0);
  Mix(StrToIntDef(S, -777), 1);
end;

function Raises(const S: string): Boolean;
var
  v: Integer;
begin
  Result := False;
  try
    v := StrToInt(S);
    if v = 123456789 then
      Result := False;
  except
    Result := True;
  end;
end;

var
  i, k, n, seed, bad: Integer;
  s: string;
  alpha: string;
begin
  h := 17;
  for i := 0 to High(Fixed) do
  begin
    One(Fixed[i]);
    WriteLn(i, ' ', StrToInt64Def(Fixed[i], -777), ' ', StrToIntDef(Fixed[i], -777), ' ', Raises(Fixed[i]));
  end;
  alpha := '0123456789012345678901234567890123456789+- x$';
  seed := 20261027;
  bad := 0;
  for i := 1 to 100000 do
  begin
    seed := (seed * 1103515245 + 12345) and $7FFFFFFF;
    n := (seed shr 8) mod 21;
    s := '';
    for k := 1 to n do
    begin
      seed := (seed * 1103515245 + 12345) and $7FFFFFFF;
      s := s + alpha[((seed shr 8) mod Length(alpha)) + 1];
    end;
    One(s);
    if Raises(s) then
      bad := bad + 1;
  end;
  WriteLn('hash ', h, ' refused ', bad);
end.
