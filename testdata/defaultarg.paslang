{ P456: Default(T) of a block (a record, a static array, a set of 32
  bytes) where a value stands. Before, the value was the three zero
  registers, and since a block's value is its address the routine read
  its parameter through nil (reported by portabilidades: a const record
  argument). Every size the emitter clears differently (one word, 16-byte
  stores up to 256 bytes, a loop past it with an odd count of words), each
  after a statement that left ones in the same scratch slot; records
  with a string and an object read while the callee allocates (the
  collector's stress runs this); by value and changed by the callee; a
  method, a routine value, a nested routine, an open array, a field of a
  Default, a Default through a routine that returns it; a set compared;
  and Default stored where no BlockAssign place is (an element of a
  dynamic array, through a pointer, a field of an object, a property). }
program defaultarg;

uses
  sysutils;

type
  TA8 = array[0..7] of Byte;
  TA16 = array[0..15] of Byte;
  TA24 = array[0..23] of Byte;
  TA40 = array[0..39] of Byte;
  TA136 = array[0..135] of Byte;
  TA200 = array[0..199] of Byte;
  TA256 = array[0..255] of Byte;
  TA264 = array[0..263] of Byte;
  TA1000 = array[0..999] of Byte;
  TA4104 = array[0..4103] of Byte;
  TOdd = array[0..12] of Byte;
  TBig = set of Byte;

  TObj = class
  public
    Tag: Integer;
  end;

  TR = record
    N: Integer;
    S: string;
    O: TObj;
  end;

  TH = record
    K: Integer;
    R: TR;
    W: array[0..9] of Integer;
  end;

  TOnly = record
    N: Integer;
  end;

  TBox = class
  private
    FR: TR;
    procedure SetR(const V: TR);
  public
    F: TR;
    Sets: Integer;
    function Take(const X: TR): Integer;
    property R: TR read FR write SetR;
  end;

  TRFunc = function(const X: TR): Integer;

{ ---- each size: a sum of the bytes, and the ones left before ---- }

function Sum8(const A: TA8): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
end;

function Ones8: TA8;
var
  i: Integer;
begin
  for i := 0 to High(Result) do
    Result[i] := 255;
end;

function Sum16(const A: TA16): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
end;

function Ones16: TA16;
var
  i: Integer;
begin
  for i := 0 to High(Result) do
    Result[i] := 255;
end;

