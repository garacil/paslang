var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
end;

function Ones1000: TA1000;
var
  i: Integer;
begin
  for i := 0 to High(Result) do
    Result[i] := 255;
end;

function Sum4104(const A: TA4104): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
end;

function Ones4104: TA4104;
var
  i: Integer;
begin
  for i := 0 to High(Result) do
    Result[i] := 255;
end;

{ by value: the callee's copy, written }
function SumOdd(A: TOdd): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
  A[3] := 9;
  Result := Result + A[3];
end;

function OnesOdd: TOdd;
var
  i: Integer;
begin
  for i := 0 to High(Result) do
    Result[i] := 255;
end;

procedure Sizes;
var
  n: Integer;
begin
  n := Sum8(Ones8);
  WriteLn('8: ones ', n, ' default ', Sum8(Default(TA8)));
  n := Sum16(Ones16);
  WriteLn('16: ones ', n, ' default ', Sum16(Default(TA16)));
  n := Sum24(Ones24);
  WriteLn('24: ones ', n, ' default ', Sum24(Default(TA24)));
  n := Sum40(Ones40);
  WriteLn('40: ones ', n, ' default ', Sum40(Default(TA40)));
  n := Sum136(Ones136);
  WriteLn('136: ones ', n, ' default ', Sum136(Default(TA136)));
  n := Sum200(Ones200);
  WriteLn('200: ones ', n, ' default ', Sum200(Default(TA200)));
  n := Sum256(Ones256);
  WriteLn('256: ones ', n, ' default ', Sum256(Default(TA256)));
  n := Sum264(Ones264);
  WriteLn('264: ones ', n, ' default ', Sum264(Default(TA264)));
  n := Sum1000(Ones1000);
  WriteLn('1000: ones ', n, ' default ', Sum1000(Default(TA1000)));
  n := Sum4104(Ones4104);
  WriteLn('4104: ones ', n, ' default ', Sum4104(Default(TA4104)));
  n := SumOdd(OnesOdd);
  WriteLn('13 by value: ones ', n, ' default ', SumOdd(Default(TOdd)));
end;

{ ---- records with a string and an object, read while the callee
  allocates ---- }

function Churn(const X: TR): string;
var
  i: Integer;
  t: string;
begin
  t := '';
  for i := 1 to 3000 do
  begin
    t := t + IntToStr(i mod 10);
    if i mod 500 = 0 then
      t := Copy(t, 2, Length(t));
  end;
  Result := IntToStr(X.N) + ' [' + X.S + '] ' + BoolToStr(X.O = nil, True) + ' ' + IntToStr(Length(t));
end;

function ByValue(X: TR): string;
begin
  X.S := X.S + 'written';
  X.N := X.N + 4;
  Result := IntToStr(X.N) + ' ' + X.S;
end;

function ByConst(const X: TR): Integer;
begin
  Result := X.N + Length(X.S);
end;

function Only(const X: TOnly): Integer;
begin
  Result := X.N;
end;

function Pass(const X: TR): TR;
begin
  Result := X;
  Result.N := Result.N + 1;
end;

function SumOpen(const A: array of TR): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i].N + Length(A[i].S);
end;

function TBox.Take(const X: TR): Integer;
begin
  Result := X.N + Length(X.S) + 100;
end;

procedure TBox.SetR(const V: TR);
begin
  FR := V;
  Sets := Sets + 1;
end;

function Nested(K: Integer): Integer;

  function Inner(const X: TR): Integer;
  begin
    Result := X.N + K;
  end;

begin
  Result := Inner(Default(TR));
end;

procedure Records;
var
  r: TR;
  h: TH;
  b: TBox;
  f: TRFunc;
  s: TBig;
begin
  r.N := 5;
  r.S := 'five';
  WriteLn('churn ', Churn(Default(TR)));
  WriteLn('churn of a variable ', Churn(r));
  WriteLn('by value ', ByValue(Default(TR)));
  WriteLn('by const ', ByConst(Default(TR)), ' only ', Only(Default(TOnly)));
  WriteLn('through Pass ', Pass(Default(TR)).N, ' ', ByConst(Pass(Default(TR))));
  WriteLn('open array ', SumOpen([Default(TR), r, Default(TR)]));
  b := TBox.Create;
  WriteLn('method ', b.Take(Default(TR)));
  f := @ByConst;
  WriteLn('routine value ', f(Default(TR)));
  WriteLn('nested ', Nested(7));
  WriteLn('field of a Default ', Default(TH).K, ' ', ByConst(Default(TH).R), ' ', Default(TH).W[9]);
  s := [1, 200];
  WriteLn('set ', BoolToStr(s = Default(TBig), True), ' ', BoolToStr(Default(TBig) = [], True));
  h.K := 3;
  h.R := r;
  h := Default(TH);
  WriteLn('assigned ', h.K, ' ', h.R.N, ' [', h.R.S, ']');
end;

{ ---- stored where no plain variable is ---- }

procedure Places;
type
  PR = ^TR;
var
  r0: TR;
  a: array of TR;
  p: PR;
  b: TBox;
  i: Integer;
begin
  SetLength(a, 3);
  for i := 0 to 2 do
  begin
    a[i].N := i + 10;
    a[i].S := 'x' + IntToStr(i);
  end;
  i := 1;
  a[i] := Default(TR);
  WriteLn('element ', a[0].N, ' ', a[1].N, ' [', a[1].S, '] ', a[2].N);
  New(p);
  p^.N := 8;
  p^.S := 'eight';
  p^ := Default(TR);
  WriteLn('through a pointer ', p^.N, ' [', p^.S, ']');
  r0.N := 2;
  r0.S := 'two';
  b := TBox.Create;
  b.F.N := 6;
  b.F.S := 'six';
  b.F := Default(TR);
  WriteLn('object field ', b.F.N, ' [', b.F.S, ']');
  b.R := r0;
  b.R := Default(TR);
  { read through the field: a field-read property of a record is P457 }
  WriteLn('property ', b.FR.N, ' [', b.FR.S, '] sets ', b.Sets);
end;

begin
  Sizes;
  Records;
  Places;
end.
