var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i];
end;

function Ones136: TA136;
var
  i: Integer;
begin
  for i := 0 to High(Result) do
    Result[i] := 255;
end;

