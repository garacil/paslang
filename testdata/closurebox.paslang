program closurebox;

{ A routine whose closures share none of its own variables still gets a
  heap box for the link (1.0.136): the box was 8 bytes and $box, the
  block's address plus 8, pointed one past it, so the collector freed
  the box and the closure read garbage or crashed after a collection. }

uses paslib;

type
  TF = function: Integer;
  PP = ^Pointer;

var
  f, g: TF;
  keep: array of PP;
  i: Integer;

function Q(n: Integer): TF;
var
  x: Integer;
  function P: TF;
  begin
    Result := function: Integer
    begin
      Result := x;
    end;
  end;
begin
  x := n;
  Result := P();
end;

function Outer(n: Integer): TF;
  function Mid: TF;
    function Inner: TF;
    begin
      Result := function: Integer
      begin
        Result := n * 2;
      end;
    end;
  begin
    Result := Inner();
  end;
begin
  Result := Mid();
end;

begin
  f := Q(42);
  g := Outer(21);
  WriteLn(f(), ' ', g());
  GcCollect;
  SetLength(keep, 100000);
  for i := 0 to 99999 do
  begin
    New(keep[i]);
    keep[i]^ := Pointer(8);
  end;
  GcCollect;
  WriteLn(f(), ' ', g());
end.

