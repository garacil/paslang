{ P665: Eof waits for an octet or the end of standard input, and the
  routine that waits parks on the poller: the other routines run
  meanwhile. The recipe gives it a pipe whose writer waits a little
  before it writes one line; a routine here counts its turns while the
  main one is in Eof. Then the line read is the one the pipe carried:
  what Eof saw is ReadLn's. }
program eofpark;

var
  mu: mutex;
  stop: Boolean;
  turns: Integer;
  done: waitgroup;

procedure Count;
var
  over: Boolean;
begin
  repeat
    Sleep(5);
    lock mu do
    begin
      Inc(turns);
      over := stop;
    end;
  until over;
  done.Done;
end;

var
  s: string;
  fed, atend: Boolean;
  t: Integer;

begin
  done.Add(1);
  pas Count;
  atend := Eof;
  lock mu do
  begin
    stop := True;
    t := turns;
  end;
  done.Wait;
  ReadLn(s, fed);
  WriteLn('the end before the line: ', atend);
  WriteLn('the other routine ran while Eof waited: ', t > 5);
  WriteLn('the line: ', s, ', fed: ', fed);
  WriteLn('then the end: ', Eof);
end.

