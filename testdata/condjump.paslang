{ P265: a condition as branches against the same condition as a value,
  written by scripts/condjump_gen.py 265 120. For every value of the
  variables each condition is worked out as an if, an if whose then is
  an Exit, a while, a repeat and an if not, and as a value: the answers
  and the traces of the calls made, in order, must be the same. Digit
  is the shape make check greps in the .s of both machines: its
  condition is two compares and two branches, no Boolean in a
  register. }
program condjump;

var
  a, b, total, bad, k: Integer;
  c: Byte;
  ch: Char;
  d: Double;
  p, q, v: Boolean;
  trace: string;
  ia, ib, ic, ich, id, ip, iq: Integer;

function T(N: Integer; V: Boolean): Boolean;
begin
  trace := trace + Chr(64 + N);
  Result := V;
end;

function I(N: Integer; V: Integer): Integer;
begin
  trace := trace + Chr(96 + N);
  Result := V;
end;

function Digit(X: Integer): Boolean;
begin
  if (X >= 48) and (X <= 57) then
    Result := True
  else
    Result := False;
end;

procedure Check(K: Integer; R1, R2: Boolean; const T1, T2: string);
begin
  total := total + 1;
  if (R1 <> R2) or (T1 <> T2) then
  begin
    bad := bad + 1;
    if bad < 20 then
      WriteLn('condition ', K, ': branch ', R1, ' ', T1, ', value ', R2, ' ', T2,
        ' at a=', a, ' b=', b, ' c=', c, ' ch=', ch, ' p=', p, ' q=', q);
  end;
end;

{ (((((d > 0.5) and (I(4, b) <> a + 1)) or ((ch > '0') and (b - a = a))) and (not (c < 255) and p)) and (((p or (c <= 255)) and not T(7, c > 50)) and p)) }
