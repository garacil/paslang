  Check(0, r, v, trace, t0);
  trace := '';
  r := Exits0;
  Check(0, r, v, trace, t0);
  trace := '';
  r := False;
  while (((((d > 0.5) and (I(4, b) <> a + 1)) or ((ch > '0') and (b - a = a))) and (not (c < 255) and p)) and (((p or (c <= 255)) and not T(7, c > 50)) and p)) do
  begin
    r := True;
    Break;
  end;
  Check(0, r, v, trace, t0);
  trace := '';
  n := 0;
  repeat
    n := n + 1;
    if n > 1 then
      Break;
  until (((((d > 0.5) and (I(4, b) <> a + 1)) or ((ch > '0') and (b - a = a))) and (not (c < 255) and p)) and (((p or (c <= 255)) and not T(7, c > 50)) and p));
