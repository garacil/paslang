begin
  Result := True;
  if (((((d > 0.5) and (I(4, b) <> a + 1)) or ((ch > '0') and (b - a = a))) and (not (c < 255) and p)) and (((p or (c <= 255)) and not T(7, c > 50)) and p)) then
    Exit;
  Result := False;
end;

