{ P564: the cookie jar of httpclient on the script testdata/cookiejar.txt
  (set URL HEADER, get URL, count, clear; sets URL H1 | H2 the fields of one
  response through SetCookies; now N sets the jar's clock, dump
  prints every cookie with its flags, date TEXT reads a date as 5.1.1 does,
  fill fills domains past the limits; a line after ! is the standard's alone
  and Go's jar takes no part in it; scripts/cookie_date_check.py is the
  oracle of the date lines). Every command's answer is printed;
  scripts/cookie_oracle.go runs the same script through Go's
  net/http/cookiejar (no public suffix list) and must print the same lines
  for the commands it takes part in. The clock is the real one, as Go's. }
program cookiejar;

uses
  sysutils, pasurl, pashttp, httpclient;

{ seconds to the expiry, 0 for a session cookie }
function ExpiresIn(Expires, Clock: Int64): Int64;
begin
  if Expires = 0 then
    Result := 0
  else
    Result := Expires - Clock;
end;

function Yn(B: Boolean): string;
begin
  if B then
    Result := 'y'
  else
    Result := 'n';
end;

var
  jar: TCookieJar;
  corpus, line, cmd, arg, url, hdr, err: string;
  p, nl, sp, i, k: Integer;
  u: TUrl;
  go: Boolean;
  all: TCookieArray;
  t: Int64;
  fields: THttpFields;
begin
  if not ReadFile('testdata/cookiejar.txt', corpus) then
  begin
    WriteLn('no testdata/cookiejar.txt');
    Halt(2);
  end;
  jar := TCookieJar.Create;
  p := 1;
  while p <= Length(corpus) do
  begin
    nl := p;
    while (nl <= Length(corpus)) and (corpus[nl] <> #10) do
      nl := nl + 1;
    line := Copy(corpus, p, nl - p);
    p := nl + 1;
    if (line = '') or (line[1] = '#') then
      Continue;
    go := True;
    if Copy(line, 1, 2) = '! ' then
    begin
      go := False;
      line := Copy(line, 3, Length(line) - 2);
    end;
    sp := Pos(' ', line);
    if sp = 0 then
    begin
      cmd := line;
      arg := '';
    end
    else
    begin
      cmd := Copy(line, 1, sp - 1);
      arg := Copy(line, sp + 1, Length(line) - sp);
    end;
    if not go then
      Write('! ');
    if cmd = 'set' then
    begin
      sp := Pos(' ', arg);
      url := Copy(arg, 1, sp - 1);
      hdr := Copy(arg, sp + 1, Length(arg) - sp);
      if not UrlParse(url, u, err) then
      begin
        WriteLn('set ', url, ': ', err);
        Continue;
      end;
      if hdr = 'fill=50' then
      begin
        { the limit of a domain: 60 cookies, the 10 least recently used go }
        for i := 1 to 60 do
          jar.SetCookie(u, 'c' + IntToStr(i) + '=' + IntToStr(i));
        WriteLn('set ', url, ' sixty cookies -> ', jar.Count, ' kept');
      end
      else if hdr = 'fill=3000' then
      begin
        { the limit of the jar: 61 hosts of 50 cookies each, the 50 least recently used go }
        for k := 1 to 61 do
        begin
          UrlParse('http://d' + IntToStr(k) + '.many.test/', u, err);
          for i := 1 to 50 do
            jar.SetCookie(u, 'c' + IntToStr(i) + '=' + IntToStr(i));
        end;
        WriteLn('set 61 hosts of 50 cookies -> ', jar.Count, ' kept');
      end
      else if jar.SetCookie(u, hdr) then
        WriteLn('set ', url, ' ', hdr, ' -> stored')
      else
        WriteLn('set ', url, ' ', hdr, ' -> refused');
    end
    else if cmd = 'get' then
    begin
      if not UrlParse(arg, u, err) then
      begin
        WriteLn('get ', arg, ': ', err);
        Continue;
      end;
      WriteLn('get ', arg, ' -> [', jar.CookieHeader(u), ']');
    end
    else if cmd = 'count' then
      WriteLn('count ', jar.Count)
    else if cmd = 'clear' then
    begin
      jar.Reset;
      WriteLn('clear');
    end
    else if cmd = 'sets' then
    begin
      { the Set-Cookie fields of one response, | between them, through SetCookies }
      sp := Pos(' ', arg);
      url := Copy(arg, 1, sp - 1);
      hdr := Copy(arg, sp + 1, Length(arg) - sp);
      if not UrlParse(url, u, err) then
      begin
        WriteLn('sets ', url, ': ', err);
        Continue;
      end;
      fields := THttpFields.Create;
      while Pos(' | ', hdr) > 0 do
      begin
        fields.Add('Set-Cookie', Copy(hdr, 1, Pos(' | ', hdr) - 1));
        hdr := Copy(hdr, Pos(' | ', hdr) + 3, Length(hdr));
      end;
      fields.Add('Set-Cookie', hdr);
      jar.SetCookies(u, fields);
      WriteLn('sets ', url, ' ', fields.CountOf('Set-Cookie'), ' fields -> ', jar.Count, ' cookies');
    end
    else if cmd = 'now' then
    begin
      jar.Clock := StrToInt64(arg);
      WriteLn('now ', arg);
    end
    else if cmd = 'dump' then
    begin
      all := jar.All;
      WriteLn('dump ', Length(all));
      for i := 0 to Length(all) - 1 do
        WriteLn('  cookie ', all[i].Name, '=', all[i].Value, ' domain=', all[i].Domain, ' path=', all[i].Path, ' hostonly=', Yn(all[i].HostOnly),
          ' secure=', Yn(all[i].Secure), ' httponly=', Yn(all[i].HttpOnly), ' quoted=', Yn(all[i].Quoted), ' persistent=', Yn(all[i].Expires <> 0),
          ' expires-in=', ExpiresIn(all[i].Expires, jar.Clock));
    end
    else if cmd = 'date' then
    begin
      if CookieParseDate(arg, t) then
        WriteLn('date ', arg, ' -> ', t)
      else
        WriteLn('date ', arg, ' -> none');
    end
    else
      WriteLn('? ', line);
  end;
end.
