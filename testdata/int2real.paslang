program int2real;

{ An integer where a real is expected becomes that real (1.0.75): as an
  argument of a routine, a method, a constructor or a routine value, in
  Exit, in Result, sent on a channel, and in a constant. It passed the
  integer's bits, a denormal that printed 0.0. }

type
  TProcD = procedure(X: Double);
  TFunD = function(X: Double): Double;
  TObj = class
    FV: Double;
    constructor Create(V: Double);
    function Twice(V: Double): Double;
    procedure Add(var Acc: Double; V: Double);
  end;
  TRec = record
    F: TFunD;
  end;

const
  D3 = Double(3);
  Half = Double(1) / 2;

var
  o: TObj;
  ch: chan of Double;
  pd: TProcD;
  r: TRec;
  i: Integer;
  acc: Double;

constructor TObj.Create(V: Double);
begin
  FV := V;
end;

function TObj.Twice(V: Double): Double;
begin
  Result := V * 2;
end;

procedure TObj.Add(var Acc: Double; V: Double);
begin
  Acc := Acc + V;
end;

procedure Show(X: Double);
begin
  WriteLn('show ', X);
end;

function Sq(X: Double): Double;
begin
  Result := X * X;
end;

function Three: Double;
begin
  Result := 3;
end;

function Four: Double;
begin
  Exit(4);
end;

function Pick(N: Integer): Double;
begin
  if N > 0 then
    Exit(N * 10);
  Result := N;
end;

procedure Sender;
begin
  Send(ch, i + 1);
end;

begin
  i := 2;
  WriteLn(Sq(5), ' ', Sq(i), ' ', Sq(i * 3), ' ', Sq(-1));
  WriteLn(Three, ' ', Four, ' ', Pick(7), ' ', Pick(-2));
  o := TObj.Create(i);
  WriteLn(o.FV, ' ', o.Twice(i), ' ', o.Twice(7));
  acc := 1;
  o.Add(acc, i);
  o.Add(acc, 10);
  WriteLn(acc);
  pd := @Show;
  pd(i);
  pd(9);
  r.F := @Sq;
  WriteLn(r.F(i + 1));
  ch := MakeChan();
  pas Sender;
  WriteLn(Recv(ch));
  WriteLn(D3, ' ', Half);
end.
