program bce;

{ An index whose every value lies in a static array's bounds needs no
  check (P100, 1.0.94): a Byte into array[0..255], a Char into
  array[Char]-sized tables, an Int8 into array[-128..127]. Table has no
  call to rt_boundsfail (make check greps it). A subrange or an Integer
  keeps its check. }

var
  byByte: array[0..255] of Integer;
  bySign: array[-128..127] of Integer;
  small: array[0..9] of Integer;

procedure Table;
var
  b: Byte;
  c: Char;
  s: Int8;
begin
  for b := 0 to 255 do
    byByte[b] := b * 2;
  c := #255;
  byByte[Ord(c)] := byByte[Byte(c)] + 1;
  for s := -128 to 127 do
    bySign[s] := s;
end;

var
  i: Integer;
  b: Byte;
begin
  Table;
  WriteLn(byByte[0], ' ', byByte[255], ' ', bySign[-128], ' ', bySign[127]);
  b := 9;
  small[b] := 5;
  WriteLn(small[9]);
  b := 10;
  i := 20;
  WriteLn(small[b mod 10] + small[i - 11]);
end.
