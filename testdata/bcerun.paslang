program bcerun;

{ Bounds checks out of runs (P100, 1.0.100): a run's head checks once
  that every index at counter + c of a static array or of a slice the
  loop keeps in registers stays in range to the run's end, and takes a
  copy of the body without those checks; a run it cannot prove takes the
  checked body. Conditional indexes that would be out of range at a
  run's edge, offsets, low bounds, both directions, narrow counters,
  break and continue. }

var
  d: array of Integer;
  e: array of Int16;
  t: array[-5..2994] of Integer;
  small: array[0..99] of Byte;
  full: array[0..255] of Word;
  i, n, sum, k: Integer;
  b: Byte;

begin
  n := 3000;
  SetLength(d, n);
  SetLength(e, n);
  for i := 0 to n - 1 do
    d[i] := i * 7 mod 1000;
  { a[i - 1] and a[i + 1] guarded at the ends: the first and last runs
    cannot be proved, the ones between can. }
  sum := 0;
  for i := 0 to n - 1 do
  begin
    if i > 0 then
      sum := sum + d[i - 1];
    if i < n - 1 then
      sum := sum + 2 * d[i + 1];
    e[i] := Int16(d[i] - 500);
  end;
  WriteLn('neighbours ', sum);
  { The same going down. }
  sum := 0;
  for i := n - 1 downto 0 do
  begin
    if i < n - 1 then
      sum := sum * 3 mod 1000003 + d[i + 1];
    sum := sum + e[i];
  end;
  WriteLn('down ', sum);
  { A static array below and above zero, indexed at i and i - 5. }
  for i := -5 to 2994 do
    t[i] := i;
  sum := 0;
  for i := 0 to 2999 do
    sum := sum + t[i - 5] - d[i];
  WriteLn('static ', sum);
  { The limit past the slice: each run proved until the one that holds
    the slice's end; the guard keeps the body in range. }
  sum := 0;
  k := 0;
  for i := 0 to n + 1500 do
    if i < n then
      sum := sum + d[i]
    else
      k := k + 1;
  WriteLn('past ', sum, ' ', k);
  { break and continue in a proved run. }
  sum := 0;
  for i := 0 to n - 1 do
  begin
    if d[i] mod 3 = 0 then
      Continue;
    if i = 2222 then
      Break;
    sum := sum + d[i];
  end;
  WriteLn('break ', sum, ' ', i);
  { A Byte counter: over 0..255 the full table is proved; the small one
    is guarded, and b + 1 wraps, so it is never proved. }
  for b := 0 to 255 do
    full[b] := Word(b * 257);
  sum := 0;
  for b := 0 to 99 do
    small[b] := b;
  for b := 0 to 255 do
  begin
    sum := sum + full[b];
    if b < 99 then
      sum := sum + small[b] + small[b + 1];
  end;
  WriteLn('narrow ', sum);
end.

