{ P261: the processor in the code. The same counts of every integer
  width from routines compiled for the base processor (bsf and bsr, a
  cmov for 0), for a processor with LZCNT and BMI1 (haswell on amd64,
  lzcnt and tzcnt; neoverse-n1 on arm64) and for the command line's,
  against scripts/cputune_out.py, which works them out with Python's
  integers; string comparisons and the counts of a whole string, which
  the runtime does with bsf and bsr, or tzcnt and 63 - lzcnt as -tune
  says. make check greps the .s: which routine has which instructions,
  the processor each one says it is for, a routine of another processor
  kept a call from the main block, and the runtime's choice by -tune. }
program cputune;

var
  vals: array[0..11] of Integer;
  i, k, bad: Integer;
  s, t: string;

{$CPU base}
function LzBase(v, k: Integer): Integer;
begin
  case k of
    0: Result := LeadingZeros(v);
    1: Result := LeadingZeros(Int32(v));
    2: Result := LeadingZeros(UInt32(v));
    3: Result := LeadingZeros(Int16(v));
    4: Result := LeadingZeros(Word(v));
    5: Result := LeadingZeros(Int8(v));
  else
    Result := LeadingZeros(Byte(v));
  end;
end;

function TzBase(v, k: Integer): Integer;
begin
  case k of
    0: Result := TrailingZeros(v);
    1: Result := TrailingZeros(Int32(v));
    2: Result := TrailingZeros(UInt32(v));
    3: Result := TrailingZeros(Int16(v));
    4: Result := TrailingZeros(Word(v));
    5: Result := TrailingZeros(Int8(v));
  else
    Result := TrailingZeros(Byte(v));
  end;
end;

{$if defined(CPU_BMI1) or defined(CPU_ATOMICS)}
const BaseHasMore = True;
{$else}
const BaseHasMore = False;
{$endif}

{$ifdef CPUX86_64}
{$CPU haswell}
{$else}
{$CPU neoverse-n1}
{$endif}
function One(x: Integer): Integer;
begin
  Result := x + 1;
end;

function LzFast(v, k: Integer): Integer;
begin
  case k of
    0: Result := LeadingZeros(v);
    1: Result := LeadingZeros(Int32(v));
    2: Result := LeadingZeros(UInt32(v));
    3: Result := LeadingZeros(Int16(v));
    4: Result := LeadingZeros(Word(v));
    5: Result := LeadingZeros(Int8(v));
  else
    Result := LeadingZeros(Byte(v));
  end;
end;

function TzFast(v, k: Integer): Integer;
begin
  case k of
    0: Result := TrailingZeros(v);
    1: Result := TrailingZeros(Int32(v));
    2: Result := TrailingZeros(UInt32(v));
    3: Result := TrailingZeros(Int16(v));
    4: Result := TrailingZeros(Word(v));
    5: Result := TrailingZeros(Int8(v));
  else
    Result := TrailingZeros(Byte(v));
  end;
end;

{$if defined(CPU_BMI1) or defined(CPU_ATOMICS)}
const FastHasMore = True;
{$else}
const FastHasMore = False;
{$endif}

{$ifdef CPUX86_64}
{$TUNE zen1}
{$else}
{$TUNE neoverse-v1}
{$endif}
function Tuned(v: Integer): Integer;
begin
  Result := LeadingZeros(v) + TrailingZeros(v);
end;
{$TUNE DEFAULT}
{$CPU DEFAULT}

function Two(x: Integer): Integer;
begin
  Result := x + 2;
end;

function LzMain(v, k: Integer): Integer;
begin
  case k of
    0: Result := LeadingZeros(v);
    1: Result := LeadingZeros(Int32(v));
    2: Result := LeadingZeros(UInt32(v));
    3: Result := LeadingZeros(Int16(v));
    4: Result := LeadingZeros(Word(v));
    5: Result := LeadingZeros(Int8(v));
  else
    Result := LeadingZeros(Byte(v));
  end;
end;

function TzMain(v, k: Integer): Integer;
begin
  case k of
    0: Result := TrailingZeros(v);
    1: Result := TrailingZeros(Int32(v));
    2: Result := TrailingZeros(UInt32(v));
    3: Result := TrailingZeros(Int16(v));
    4: Result := TrailingZeros(Word(v));
    5: Result := TrailingZeros(Int8(v));
  else
    Result := TrailingZeros(Byte(v));
  end;
end;

begin
  vals[0] := 0;
  vals[1] := 1;
  vals[2] := -1;
  vals[3] := 2;
  vals[4] := 128;
  vals[5] := 255;
  vals[6] := 256;
  vals[7] := 65536;
  vals[8] := 2147483648;
  vals[9] := 4294967296;
  vals[10] := -9223372036854775807 - 1;
  vals[11] := 1311768467463790320;
  bad := 0;
  { a CPU_ word follows $CPU at once }
  for i := 0 to 11 do
  begin
    for k := 0 to 6 do
    begin
      if (LzBase(vals[i], k) <> LzFast(vals[i], k)) or (LzMain(vals[i], k) <> LzFast(vals[i], k)) or
        (TzBase(vals[i], k) <> TzFast(vals[i], k)) or (TzMain(vals[i], k) <> TzFast(vals[i], k)) then
        bad := bad + 1;
      Write(LzFast(vals[i], k), '/', TzFast(vals[i], k), ' ');
    end;
    WriteLn(Tuned(vals[i]));
  end;
  WriteLn('disagree ', bad);
  WriteLn(BaseHasMore, ' ', FastHasMore, ' ', One(Two(39)));
  { the runtime's bit scans: a string comparison ends on the highest
    bit of the first word that differs, a whole string's counts }
  s := 'abcdefgh';
  t := 'abcdefgi';
  WriteLn(s < t, ' ', t < s, ' ', 'abc' < 'abd', ' ', 'ab' < 'a', ' ', 'abcdefghijklmnopq' < 'abcdefghijklmnopr');
  s := 'A';
  t := 'P' + #0 + #0;
  Write(LeadingZeros(s), ' ', TrailingZeros(s), ' ', LeadingZeros(t), ' ', TrailingZeros(t));
  s := '     P';
  t := #0 + #0 + '  p';
  WriteLn(' ', LeadingZeros(s), ' ', TrailingZeros(s), ' ', LeadingZeros(t), ' ', TrailingZeros(t));
end.
