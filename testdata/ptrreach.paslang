program ptrreach;
{ Accesses where the code names the object and a constant offset (P104):
  inside it they compile and run; a step alone, an end pointer, is not an
  access; a var parameter may be one element of a bigger array. }
type
  TRec = record
    B: Byte;
    W: Word;
    I: Int32;
    J: Int32;
  end;
var
  x: Integer;
  r: TRec;
  a: array[1..4] of Word;
  arr: array[0..2] of Integer;
  e, q: PByte;
  n: Integer;

procedure Next(var v: Integer);
begin
  WriteLn((PInteger(@v) + 1)^);
end;

procedure Local;
var
  y: Integer;
begin
  y := $0102;
  WriteLn((PByte(@y) + 1)^);
end;

begin
  x := $0807060504030201;
  WriteLn((PByte(@x) + 7)^);
  WriteLn(PWord(@x)[3]);
  r.B := 1;
  r.W := 2;
  r.I := 3;
  r.J := 4;
  WriteLn(PInt32(@r.J)^);
  WriteLn(^TRec(@r)^.J);
  WriteLn(TRec(Pointer(@r)).W);
  a[1] := 10;
  a[2] := 20;
  a[3] := 30;
  a[4] := 40;
  WriteLn(PWord(@a[3])[1]);
  WriteLn((PWord(@a[1]) + 3)^);
  e := PByte(@x) + 8;
  q := PByte(@x);
  n := 0;
  while q < e do
  begin
    n := n + q^;
    Inc(q);
  end;
  WriteLn(n);
  arr[0] := 5;
  arr[1] := 6;
  arr[2] := 7;
  Next(arr[1]);
  Local;
  FillChar(r, SizeOf(r), 0);
  WriteLn(r.J);
  Move(x, arr, 8);
  WriteLn(arr[0] - x);
end.

