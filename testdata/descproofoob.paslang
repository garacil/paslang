{ P558: an index past the length of an open array that arrives by
  reference is stopped at the index the checked loop reaches first, where
  the proof at the head of a run failed or never was made: a loop one past
  the end in a first run, in a second one and at the edge of one, the
  counter plus one past the end, the counter minus one before the start, an
  empty array, the nil descriptor, an array shrunk in the loop, doubles and
  bytes, the shorter of two arrays and loops that have one register
  left or none. The scenario is the first argument. }
program descproofoob;

type
  TArr = array of Int64;

function Past(var A: TArr; n: Integer): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to n do
    Result := Result + A[i];
end;

function Ahead(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i + 1];
end;

function Behind(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i - 1];
end;

function Shrunk(var A: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
  begin
    Result := Result + A[i];
    if i = 1500 then
      SetLength(A, 1200);
  end;
end;

function PastD(var A: array of Double; n: Integer): Double;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to n do
    Result := Result + A[i];
end;

function PastB(var A: array of Byte; n: Integer): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to n do
    Result := Result + A[i];
end;

function Both(var A, B: TArr): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i] * B[i];
end;

{ eight live values: the length has no register, the checks stay }
function Crowd(var Z: TArr; n: Integer; a1, a2, a3, a4, a5, a6: Int64): Int64;
var
  i: Integer;
  s: Int64;
begin
  s := 0;
  for i := 0 to n do
  begin
    s := s + Z[i];
    a1 := a1 + s;
    a2 := a2 xor a1;
    a3 := a3 + a2;
    a4 := a4 xor a3;
    a5 := a5 + a4;
    a6 := a6 xor a5;
  end;
  Result := s + a1 + a2 + a3 + a4 + a5 + a6;
end;

{ four values and the loop's own take all but one of the registers: the
  pointer of the array has one and its length is read where it lies }
function Squeeze(var Z: TArr; k: Int64; hi: Integer): Int64;
var
  i: Integer;
  s1, s2, s3, s4: Int64;
begin
  s1 := k;
  s2 := k + 1;
  s3 := k + 2;
  s4 := k + 3;
  for i := 0 to hi do
  begin
    s1 := s1 + Z[i];
    s1 := s1 + s2 xor s3;
    s2 := s2 + s3 xor s4;
    s3 := s3 + s4 xor s1;
    s4 := s4 + s1 xor s2;
  end;
  Result := s1 + s2 + s3 + s4;
end;

var
  A, B, E: TArr;
  D: array of Double;
  Y: array of Byte;
  p: ^TArr;
  sc: string;
begin
  SetLength(A, 3000);
  SetLength(B, 2000);
  SetLength(D, 2000);
  SetLength(Y, 1025);
  p := nil;
  sc := ParamStr(1);
  if sc = '1' then
    WriteLn(Past(A, 3000))
  else if sc = '2' then
  begin
    SetLength(A, 1500);
    WriteLn(Past(A, 1500));
  end
  else if sc = '3' then
    WriteLn(Ahead(A))
  else if sc = '4' then
    WriteLn(Behind(A))
  else if sc = '5' then
    WriteLn(Past(E, 0))
  else if sc = '6' then
    WriteLn(Past(p^, 0))
  else if sc = '7' then
    WriteLn(Shrunk(A))
  else if sc = '8' then
    WriteLn(PastD(D, 2000))
  else if sc = '9' then
    WriteLn(PastB(Y, 1025))
  else if sc = '10' then
    WriteLn(Both(A, B))
  else if sc = '11' then
    WriteLn(Crowd(A, 3000, 1, 2, 3, 4, 5, 6))
  else
    WriteLn(Squeeze(A, 3, 3000));
end.
