{ P98: Unlock of a mutex nobody holds is a fatal error, as in Go, and
  the mutex that took and gave back once is free again. }
program unlockfree;

var
  mu: mutex;

begin
  mu.Lock;
  mu.Unlock;
  WriteLn('before');
  mu.Unlock;
  WriteLn('after');
end.

