program chanbuf;

{ Buffered channels (1.0.85): MakeChan(n) keeps up to n values, as Go's
  make(chan T, n). A send parks only when the buffer is full, a receive
  takes the oldest value first; a closed channel still gives what it
  holds, then zero values; select sees the buffer. }

var
  c, big, done: chan of Integer;
  cs: chan of string;
  i, sum, v: Integer;
  s: string;

procedure Fill;
var
  k: Integer;
begin
  for k := 1 to 10 do
    Send(big, k * k);
  Send(done, 1);
end;

begin
  c := MakeChan(3);
  Send(c, 10);
  Send(c, 20);
  Send(c, 30);
  WriteLn(Recv(c), ' ', Recv(c), ' ', Recv(c));
  big := MakeChan(2);
  done := MakeChan();
  pas Fill;
  sum := 0;
  for i := 1 to 10 do
    sum := sum + Recv(big);
  WriteLn(sum, ' ', Recv(done));
  cs := MakeChan(4);
  for i := 1 to 4 do
  begin
    s := 'msg';
    s := s + Chr(48 + i);
    Send(cs, s);
  end;
  GcCollect;
  s := '';
  for i := 1 to 4 do
    s := s + Recv(cs) + ' ';
  WriteLn(s);
  Send(c, 7);
  Send(c, 8);
  Close(c);
  WriteLn(Recv(c), ' ', Recv(c), ' ', Recv(c));
  c := MakeChan(1);
  select
    Send(c, 99):
      WriteLn('sent to the buffer');
  else
    WriteLn('full');
  end;
  select
    Send(c, 100):
      WriteLn('sent again');
  else
    WriteLn('full now');
  end;
  select
    Recv(c, v):
      WriteLn('got ', v);
  else
    WriteLn('empty');
  end;
  select
    Recv(c, v):
      WriteLn('got ', v);
  else
    WriteLn('empty now');
  end;
  c := MakeChan(3);
  sum := 0;
  for i := 1 to 1000 do
  begin
    Send(c, i);
    if i mod 2 = 0 then
    begin
      sum := sum + Recv(c);
      sum := sum + Recv(c);
    end;
  end;
  while sum >= 0 do
  begin
    select
      Recv(c, v):
        sum := sum + v;
    else
      Break;
    end;
  end;
  WriteLn(sum);
end.

