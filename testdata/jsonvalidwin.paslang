{ P211: JsonValid where its window of 64 KiB ends, at every byte of an
  object's members: a name, its colon, a value of each kind after it,
  checked in the same pass of CheckFast or in the next window's, and the
  comma after it. Each text as it is, which JsonValid takes, and broken
  at the byte before the window's end, at it and after it, a byte put
  for another in eight ways, which it takes or refuses as TryJsonParse
  does (a byte of a name or of a string may change and leave the text
  good). }
program jsonvalidwin;

uses pasjson;

const
  Win = 65536;
  Obj = '{"name":"v\"w","n":-12.5e3,"z":0,"t":true,"f":false,"u":null,"o":{},' +
    '"a":[1,"x"],"d":{"k":[]},"e":2E-7,"s":"","q":0.25}';
  { what a byte becomes }
  Puts: array[0..7] of Byte = (32, 48, 34, 44, 92, 125, 58, 120);

var
  text: string;
  d, p, k, at, whole, taken, broken, refused, agree: Integer;
  j: json;
  err: EJsonError;
  was: Byte;

{ the text with the object's first byte at Win - D: an array of spaces
  around it }
procedure Build(D: Integer);
var
  i, n: Integer;
begin
  n := Win + Length(Obj) + 64;
  SetLength(text, n);
  for i := 1 to n do
    text[i] := ' ';
  text[1] := '[';
  for i := 1 to Length(Obj) do
    text[Win - D + i] := Obj[i];
  text[n] := ']';
end;

{ JsonValid against TryJsonParse }
function Check: Boolean;
var
  v, t: Boolean;
begin
  v := JsonValid(text);
  t := TryJsonParse(text, j, err);
  if v = t then
    agree := agree + 1
  else
    WriteLn('disagree: valid ', v, ' parse ', t, ' at ', at, ' put ', Puts[k]);
  Result := v;
end;

begin
  whole := 0;
  taken := 0;
  broken := 0;
  refused := 0;
  agree := 0;
  for d := 0 to Length(Obj) do
  begin
    Build(d);
    at := 0;
    k := 0;
    whole := whole + 1;
    if Check then
      taken := taken + 1;
    for p := -1 to 1 do
    begin
      { the byte at the window's end and those beside it, in the object }
      at := Win + p;
      if (at <= Win - d) or (at > Win - d + Length(Obj)) then
        Continue;
      was := Byte(text[at]);
      for k := 0 to High(Puts) do
      begin
        if Puts[k] = was then
          Continue;
        text[at] := Char(Puts[k]);
        broken := broken + 1;
        if not Check then
          refused := refused + 1;
      end;
      text[at] := Char(was);
    end;
  end;
  WriteLn('whole ', whole, ' taken ', taken);
  WriteLn('broken ', broken, ' refused ', refused);
  WriteLn('agree ', agree, ' of ', whole + broken);
end.
