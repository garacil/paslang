  ti13: Int64;
  ta14: Int64;
  tb15: Int64;
begin
  acc := (x xor (y * 31));
  kp := ((3 and acc) and (y + x));
  tn1 := 4;
  while (tn1 > 0) do
  begin
    ta2 := ((tn1 * y) xor (7 or kp));
    acc := (acc + ta2);
    tn1 := (tn1 - 1);
  end;
  tn3 := 3;
  repeat
    ta4 := ((12345678901 shl 8) shr 1);
    acc := (acc xor ta4);
    tn3 := (tn3 - 1);
  until (tn3 <= 0);
  ta7 := 0;
  for ti5 := 1 to 3 do
  begin
    ta7 := (ta7 + (ti5 * 3));
  end;
  for tj6 := 1 to 4 do
  begin
    acc := (acc + (ta7 xor tj6));
  end;
  for ti8 := 1 to 4 do
  begin
    if (((2147483647 or x) and 7) = 4) then
    begin
      ta9 := ((255 xor acc) xor (kp shr 13));
      acc := (acc + ta9);
    end
    else
    begin
      tb10 := ((x xor 1) shr 3);
      acc := (acc - tb10);
    end;
  end;
  ta11 := ((2147483647 xor y) - (y or acc));
  tb12 := ((3 xor kp) + 65537);
  acc := (acc + (ta11 xor tb12));
  for ti13 := 1 to 5 do
  begin
    if ((x + acc) <> (ti13 + kp)) then
    begin
      ta14 := ((2654435761 + acc) - x);
      acc := (acc + ta14);
    end
    else
    begin
      tb15 := 65537;
      acc := (acc - tb15);
    end;
  end;
  acc := (acc + kp);
  Result := acc;
end;

