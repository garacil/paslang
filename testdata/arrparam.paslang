{ P554: the elements of an open array that arrives by reference (a var or const parameter of the type
  array of T) are reached through the address of its descriptor, whose words stay where they are: the
  index first, then the length compared and the pointer loaded, nothing pushed. Each routine reads or
  writes the elements in one form of index (a variable, a sum, a product, a call, a constant, a field, a
  Double or an Int64) and the result is checked against the same formula worked out on a static array,
  whose elements the compiler reaches another way. }
program arrparam;

uses
  sysutils;

type
  TRec = record
    A: Int64;
    B: Double;
    C: Byte;
  end;
  TRecs = array of TRec;

const
  N = 37;

var
  fails: Integer;
  si: array[0..N - 1] of Int64;
  sd: array[0..N - 1] of Double;
  sb: array[0..N - 1] of Byte;
  sw: array[0..N - 1] of Word;
  sl: array[0..N - 1] of LongInt;
  sr: array[0..N - 1] of TRec;
  ss: array[0..N - 1] of string;

function Id(X: Integer): Integer;
begin
  Result := X;
end;

procedure Chk(const Name: string; Ok: Boolean);
begin
  if not Ok then
  begin
    Inc(fails);
    WriteLn('FAIL ', Name);
  end;
end;

{ ---- writes in each form of index ---- }

procedure FillI(var A: array of Int64);
var
  i, j: Integer;
begin
  for i := 0 to High(A) do
    A[i] := i * 7 + 1;
  j := 3;
  A[j] := A[j] + 1000;
  A[0] := A[0] - 1;
  A[Id(5)] := A[Id(5)] * 2;
  A[High(A)] := 99;
  A[High(A) - 1] := A[High(A)] + A[1];
  for i := 0 to High(A) div 2 - 1 do
    A[i * 2 + 1] := A[i * 2 + 1] + i;
end;

procedure FillD(var A: array of Double);
var
  i: Integer;
begin
  A[0] := 1.0;
  for i := 1 to High(A) do
    A[i] := A[i - 1] * 0.5 + i;
  A[Id(4)] := A[Id(4)] + A[2] * A[3];
  for i := 0 to High(A) do
    A[i] := -A[i] + 2.0 * A[High(A) - i];
end;

procedure FillB(var A: array of Byte);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := Byte((i * 37 + 11) and 255);
  A[2] := Byte((A[2] + 200) and 255);
  A[High(A)] := 255;
end;

procedure FillW(var A: array of Word);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := Word((i * 4099 + 17) and 65535);
  A[1] := Word(A[1] xor $FFFF);
end;

procedure FillL(var A: array of LongInt);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := LongInt(i * 100003 - 5000000);
  A[3] := LongInt(-A[3]);
end;

procedure FillR(var A: TRecs);
var
  i: Integer;
begin
  for i := 0 to High(A) do
  begin
    A[i].A := i * 3 + 1;
    A[i].B := i * 0.25;
    A[i].C := Byte(i and 255);
  end;
  A[2].A := A[1].A + A[3].A;
  A[Id(4)].B := A[1].B * 4.0;
end;

procedure FillS(var A: array of string);
var
  i: Integer;
begin
  for i := 0 to High(A) do
    A[i] := 'x' + IntToStr(i * 5);
  A[3] := A[3] + A[4];
end;

{ ---- reads ---- }

function SumI(const A: array of Int64): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i] * (i + 1);
  Result := Result + A[Id(2)] + A[High(A)];
end;

function DotD(const A, B: array of Double): Double;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i] * B[High(B) - i] - A[Id(i)] * 0.125;
end;

function MaxD(const A: array of Double): Double;
var
  i: Integer;
begin
  Result := A[0];
  for i := 1 to High(A) do
    if A[i] > Result then
      Result := A[i];
end;

function SumB(const A: array of Byte): Integer;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i] * ((i and 3) + 1);
end;

function SumW(const A: array of Word): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result * 3 + A[i];
end;

function SumL(const A: array of LongInt): Int64;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i] - i;
end;

function SumR(const A: TRecs): Double;
var
  i: Integer;
begin
  Result := 0;
  for i := 0 to High(A) do
    Result := Result + A[i].A * 0.5 + A[i].B + A[i].C;
end;

function CatS(const A: array of string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to High(A) do
    Result := Result + A[i] + ',';
end;

{ ---- two levels, a swap and a reversal ---- }

procedure SwapD(var A: array of Double; I, J: Integer);
var
  t: Double;
begin
  t := A[I];
  A[I] := A[J];
  A[J] := t;
end;

procedure RevD(var A: array of Double);
var
  i: Integer;
begin
  for i := 0 to High(A) div 2 do
    SwapD(A, i, High(A) - i);
end;

procedure BubbleI(var A: array of Int64);
var
  i, j: Integer;
  t: Int64;
begin
  for i := 0 to High(A) - 1 do
    for j := 0 to High(A) - 1 - i do
      if A[j] > A[j + 1] then
      begin
        t := A[j];
        A[j] := A[j + 1];
        A[j + 1] := t;
      end;
end;

var
  di: array of Int64;
  dd, dd2: array of Double;
  db: array of Byte;
  dw: array of Word;
  dl: array of LongInt;
  dr: TRecs;
  ds: array of string;
  i, j: Integer;
  t: Int64;
  x, y: Double;
  s1, s2: string;
  pd: ^Double;
  pr: ^TRec;

begin
  fails := 0;
  SetLength(di, N);
  SetLength(dd, N);
  SetLength(dd2, N);
  SetLength(db, N);
  SetLength(dw, N);
  SetLength(dl, N);
  SetLength(dr, N);
  SetLength(ds, N);
  { the same formulas on static arrays, by the paths the compiler took before }
  for i := 0 to N - 1 do
    si[i] := i * 7 + 1;
  j := 3;
  si[j] := si[j] + 1000;
  si[0] := si[0] - 1;
  si[Id(5)] := si[Id(5)] * 2;
  si[N - 1] := 99;
  si[N - 2] := si[N - 1] + si[1];
  for i := 0 to N div 2 - 1 do
    si[i * 2 + 1] := si[i * 2 + 1] + i;
  FillI(di);
  for i := 0 to N - 1 do
    Chk('FillI', di[i] = si[i]);
  { the Doubles }
  sd[0] := 1.0;
  for i := 1 to N - 1 do
    sd[i] := sd[i - 1] * 0.5 + i;
  sd[Id(4)] := sd[Id(4)] + sd[2] * sd[3];
  for i := 0 to N - 1 do
    sd[i] := -sd[i] + 2.0 * sd[N - 1 - i];
  FillD(dd);
  for i := 0 to N - 1 do
    Chk('FillD', (dd[i] as Int64) = (sd[i] as Int64));
  for i := 0 to N - 1 do
    sb[i] := Byte((i * 37 + 11) and 255);
  sb[2] := Byte((sb[2] + 200) and 255);
  sb[N - 1] := 255;
  FillB(db);
  for i := 0 to N - 1 do
    Chk('FillB', db[i] = sb[i]);
  for i := 0 to N - 1 do
    sw[i] := Word((i * 4099 + 17) and 65535);
  sw[1] := Word(sw[1] xor $FFFF);
  FillW(dw);
  for i := 0 to N - 1 do
    Chk('FillW', dw[i] = sw[i]);
  for i := 0 to N - 1 do
    sl[i] := LongInt(i * 100003 - 5000000);
  sl[3] := LongInt(-sl[3]);
  FillL(dl);
  for i := 0 to N - 1 do
    Chk('FillL', dl[i] = sl[i]);
  for i := 0 to N - 1 do
  begin
    sr[i].A := i * 3 + 1;
    sr[i].B := i * 0.25;
    sr[i].C := Byte(i and 255);
  end;
  sr[2].A := sr[1].A + sr[3].A;
  sr[Id(4)].B := sr[1].B * 4.0;
  FillR(dr);
  for i := 0 to N - 1 do
    Chk('FillR', (dr[i].A = sr[i].A) and ((dr[i].B as Int64) = (sr[i].B as Int64)) and (dr[i].C = sr[i].C));
  for i := 0 to N - 1 do
    ss[i] := 'x' + IntToStr(i * 5);
  ss[3] := ss[3] + ss[4];
  FillS(ds);
  for i := 0 to N - 1 do
    Chk('FillS', ds[i] = ss[i]);
  { the reads }
  t := 0;
  for i := 0 to N - 1 do
    t := t + si[i] * (i + 1);
  t := t + si[Id(2)] + si[N - 1];
  Chk('SumI', SumI(di) = t);
  x := 0;
  for i := 0 to N - 1 do
    dd2[i] := sd[N - 1 - i] + 0.375;
  for i := 0 to N - 1 do
    x := x + sd[i] * (sd[i] + 0.375) - sd[Id(i)] * 0.125;
  Chk('DotD', (DotD(dd, dd2) as Int64) = (x as Int64));
  y := sd[0];
  for i := 1 to N - 1 do
    if sd[i] > y then
      y := sd[i];
  Chk('MaxD', (MaxD(dd) as Int64) = (y as Int64));
  j := 0;
  for i := 0 to N - 1 do
    j := j + sb[i] * ((i and 3) + 1);
  Chk('SumB', SumB(db) = j);
  t := 0;
  for i := 0 to N - 1 do
    t := t * 3 + sw[i];
  Chk('SumW', SumW(dw) = t);
  t := 0;
  for i := 0 to N - 1 do
    t := t + sl[i] - i;
  Chk('SumL', SumL(dl) = t);
  x := 0;
  for i := 0 to N - 1 do
    x := x + sr[i].A * 0.5 + sr[i].B + sr[i].C;
  Chk('SumR', (SumR(dr) as Int64) = (x as Int64));
  s1 := '';
  for i := 0 to N - 1 do
    s1 := s1 + ss[i] + ',';
  s2 := CatS(ds);
  Chk('CatS', s1 = s2);
  { a Double through a pointer and a field through a pointer }
  pd := @sd[5];
  x := pd^ * 3.0 + sd[5];
  y := sd[5] * 3.0 + sd[5];
  Chk('deref', (x as Int64) = (y as Int64));
  pr := @sr[7];
  x := pr^.B * 2.0 - sr[7].B;
  y := sr[7].B * 2.0 - sr[7].B;
  Chk('field', (x as Int64) = (y as Int64));
  { reversal, a swap through a second level, and a sort }
  RevD(dd);
  for i := 0 to N - 1 do
    Chk('RevD', (dd[i] as Int64) = (sd[N - 1 - i] as Int64));
  for i := 0 to N - 1 do
    di[i] := (i * 1103515245 + 12345) mod 1009;
  BubbleI(di);
  for i := 1 to N - 1 do
    Chk('BubbleI', di[i - 1] <= di[i]);
  if fails = 0 then
    WriteLn('arrparam ok')
  else
    WriteLn('arrparam FAIL ', fails);
end.
