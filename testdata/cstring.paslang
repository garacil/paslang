{ P666: paslib's CString, a C string for a system call, in its interface
  (supervisor asked for it). A directory made and taken away by path
  through paslinux, the C string held in a variable for the calls; a
  string with a NUL inside gives nil, since the call would act on the
  shorter name; many C strings made while the collector runs. }
program cstring;

uses
  paslib, paslinux;

var
  p, q: PChar;
  dir: string;
  r, i, bad: Integer;
begin
  dir := ParamStr(0) + '.cdir';
  p := CString(dir);
  r := OsMkdir(Int64(p), 493);
  WriteLn('mkdir through CString: ', r, ', there: ', OsAccess(Int64(p), 0) = 0);
  if Amd64 = 1 then
    r := Syscall(84, Int64(p))
  else
    r := Syscall(35, -100, Int64(p), 512);
  WriteLn('rmdir through CString: ', r, ', gone: ', OsAccess(Int64(p), 0) <> 0);
  q := CString('a' + #0 + 'b');
  WriteLn('a NUL inside: ', q = nil);
  q := CString('');
  WriteLn('the empty string: ', Ord(q[0]));
  bad := 0;
  for i := 1 to 20000 do
  begin
    q := CString('name' + IntToStr(i));
    if (q[0] <> 'n') or (q[4 + Length(IntToStr(i))] <> #0) then
      Inc(bad);
  end;
  WriteLn('twenty thousand C strings, each whole: ', bad = 0);
end.
