{ P564: a client with a jar against a server on the loopback: /login sets
  three cookies (one for the path /app only, one Secure, which the loopback
  gets as a secure origin, as Go sends it) and answers 302 to /home, which
  echoes the Cookie header it sees; /app/x and /other show the path
  rule, /logout deletes the session with Max-Age=0, a client with no jar
  carries nothing, and a Cookie header the caller gives is sent as given. }
program cookiehttp;

uses
  sysutils, pasnet, pashttp, pasurl, httpclient, httpserver;

procedure HLogin(Req: THttpRequest; Resp: THttpResponse);
var
  c: THttpCookie;
begin
  c := Default(THttpCookie);
  c.Name := 'session';
  c.Value := 'S1';
  c.Path := '/';
  c.HttpOnly := True;
  Resp.SetCookie(c);
  c := Default(THttpCookie);
  c.Name := 'app';
  c.Value := 'A1';
  c.Path := '/app';
  Resp.SetCookie(c);
  c := Default(THttpCookie);
  c.Name := 'tls';
  c.Value := 'T1';
  c.Secure := True;
  Resp.SetCookie(c);
  Resp.Redirect(302, '/home');
end;

procedure HEcho(Req: THttpRequest; Resp: THttpResponse);
begin
  Resp.ReplyText(200, Req.Path + ' cookie=[' + Req.Header.Get('Cookie') + ']' + #10);
end;

procedure HLogout(Req: THttpRequest; Resp: THttpResponse);
var
  c: THttpCookie;
begin
  c := Default(THttpCookie);
  c.Name := 'session';
  c.Value := '';
  c.Path := '/';
  c.MaxAge := -1;
  Resp.SetCookie(c);
  Resp.ReplyText(200, 'bye' + #10);
end;

procedure RunServer(S: THttpServer);
begin
  S.Serve;
end;

var
  Router: THttpRouter;
  Srv: THttpServer;
  Port: Integer;
  c, bare: THttpClient;
  r: THttpClientResponse;
  f: THttpFields;
  base: string;
begin
  Router := THttpRouter.Create;
  Router.Handle('GET', '/login', @HLogin);
  Router.Handle('GET', '/home', @HEcho);
  Router.Handle('GET', '/app/x', @HEcho);
  Router.Handle('GET', '/other', @HEcho);
  Router.Handle('GET', '/logout', @HLogout);
  Srv := THttpServer.Create(Router);
  Srv.AccessLog := False;
  if not Srv.ListenTcp('127.0.0.1', 0) then
    Halt(1);
  Port := Srv.Port;
  pas RunServer(Srv);
  base := 'http://127.0.0.1:' + IntToStr(Port);
  c := THttpClient.Create;
  c.TimeoutMs := 20000;
  c.Jar := TCookieJar.Create;
  r := c.Get(base + '/login');
  WriteLn('login: ', r.Status, ' redirects ', r.Redirects, ' ', r.ReadAll(0));
  WriteLn('jar holds ', c.Jar.Count);
  r := c.Get(base + '/app/x');
  Write('app: ', r.ReadAll(0));
  r := c.Get(base + '/other');
  Write('other: ', r.ReadAll(0));
  f := THttpFields.Create;
  f.Add('Cookie', 'mine=given');
  r := c.Perform('GET', base + '/other', f, '');
  Write('given: ', r.ReadAll(0));
  r := c.Get(base + '/logout');
  Write('logout: ', r.ReadAll(0));
  WriteLn('jar holds ', c.Jar.Count);
  r := c.Get(base + '/home');
  Write('after: ', r.ReadAll(0));
  bare := THttpClient.Create;
  bare.TimeoutMs := 20000;
  r := bare.Get(base + '/login');
  Write('no jar: ', r.ReadAll(0));
  r := bare.Get(base + '/home');
  Write('no jar again: ', r.ReadAll(0));
  Srv.Shutdown;
  Halt(0);
end.
