{ P377: Length and High of a string or a slice in a place read its
  length word alone, and an index tested against both ends of a slice
  is one compare without sign and one branch: every form of the test,
  out and in, through a field and a pointer, for indexes below, inside
  and past a slice of five, an empty slice, the largest and the
  smallest Integer, and a narrow index, which keeps the old test. }
program boundsidiom;

type
  TInts = array of Integer;
  TRec = record
    Name: string;
    Items: array of Integer;
  end;

var
  a: array of Integer;
  s: string;
  r: TRec;
  p: ^TRec;
  i, hits: Integer;
  i32: Int32;

{ a slice passed by reference arrives as its descriptor's address, nil
  for an empty one }
function HighOf(const A: TInts): Integer;
begin
  Result := High(A);
end;

function LenOf(var A: TInts): Integer;
begin
  Result := Length(A);
end;

function InConst(const A: TInts; K: Integer): Boolean;
begin
  if (K >= 0) and (K <= High(A)) then
    Result := True
  else
    Result := False;
end;

function InA(K: Integer): Boolean;
begin
  if (K >= 0) and (K <= High(a)) then
    Result := True
  else
    Result := False;
end;

function OutA(K: Integer): Boolean;
begin
  if (K < 0) or (K >= Length(a)) then
    Result := True
  else
    Result := False;
end;

function InR(K: Integer): Boolean;
begin
  if (K >= 0) and (K <= High(r.Items)) then
    Result := True
  else
    Result := False;
end;

function InP(K: Integer): Boolean;
begin
  if (K >= 0) and (K < Length(p^.Items)) then
    Result := True
  else
    Result := False;
end;

function Zero(K: Integer): Boolean;
begin
  if (0 > K) or (K > High(a)) then
    Result := False
  else
    Result := True;
end;

begin
  SetLength(a, 5);
  s := 'hello';
  SetLength(r.Items, 3);
  p := @r;
  for i := -3 to 7 do
    Write(Ord(InA(i)), Ord(OutA(i)), Ord(InR(i)), Ord(InP(i)), Ord(Zero(i)), ' ');
  WriteLn;
  WriteLn(Length(s), ' ', High(s), ' ', Length(a), ' ', High(a), ' ', Length(r.Name), ' ',
    High(r.Items), ' ', Length(p^.Items));
  { an empty slice: every index is out }
  SetLength(a, 0);
  hits := 0;
  for i := -2 to 2 do
    if (i < 0) or (i > High(a)) then
      Inc(hits);
  WriteLn(hits);
  SetLength(a, 4);
  { a narrow index keeps the old test }
  i32 := -1;
  if (i32 < 0) or (i32 > High(a)) then
    WriteLn('narrow out');
  i := High(Integer);
  if (i < 0) or (i > High(a)) then
    WriteLn('max out');
  i := Low(Integer);
  if (i < 0) or (i > High(a)) then
    WriteLn('min out');
  i := 3;
  if (i < 0) or (i > High(a)) then
    WriteLn('3 out')
  else
    WriteLn('3 in');
  WriteLn(HighOf(nil), ' ', HighOf(a), ' ', LenOf(a), ' ', Ord(InConst(nil, 0)), ' ',
    Ord(InConst(a, 3)), ' ', Ord(InConst(a, 4)));
end.

