program forrun;

{ A for stops on its limit and never passes it (P100, 1.0.98): a loop up
  to High(Integer) or down to Low(Integer) ends, and the counter holds
  the limit after a loop that ran to its end, as in FPC. An innermost
  loop of a promoted region runs in runs of 1024 with one preemption test
  a run: break and continue across the runs' edges, runs of every length
  near 1024, and a routine spinning in such a loop while the collector
  stops the world. }

uses paslib;

var
  done, spins, finished: Integer;
  done2, spins2, finished2: Integer;

procedure Ends;
var
  i, n: Integer;
  b: Byte;
  s: Int8;
  w: Word;
begin
  n := 0;
  for i := High(Integer) - 2 to High(Integer) do
    n := n + 1;
  WriteLn('up to High: ', n, ' ', i = High(Integer));
  n := 0;
  for i := Low(Integer) + 2 downto Low(Integer) do
    n := n + 1;
  WriteLn('down to Low: ', n, ' ', i = Low(Integer));
  for i := 1 to 3 do
    n := n + i;
  WriteLn('after 1 to 3: ', i, ' ', n);
  for i := 3 downto 1 do
    n := n - i;
  WriteLn('after 3 downto 1: ', i, ' ', n);
  for i := 5 to 4 do
    n := 99;
  WriteLn('no pass: ', i, ' ', n);
  n := 0;
  for b := 250 to 255 do
    n := n + b;
  WriteLn('Byte to 255: ', n, ' ', b);
  n := 0;
  for s := -126 downto -128 do
    n := n + s;
  WriteLn('Int8 to -128: ', n, ' ', s);
  n := 0;
  for w := 65530 to 65535 do
    n := n + 1;
  WriteLn('Word to 65535: ', n, ' ', w);
  b := 7;
  w := 9;
  for b := Byte(w + 1) to Byte(w) do
    n := 0;
  WriteLn('Byte no pass: ', b, ' ', n);
end;

{ acc := acc + i, the loop ForAcc emits. }
procedure Sums;
var
  i, acc, lim: Integer;
begin
  acc := 0;
  for i := High(Integer) - 3 to High(Integer) do
    acc := acc + 1;
  WriteLn('acc to High: ', acc, ' ', i = High(Integer));
  acc := 0;
  lim := 5000;
  for i := 0 to lim do
    acc := acc + i;
  WriteLn('acc 0..5000: ', acc, ' ', i);
  acc := 0;
  for i := 5000 downto 0 do
    acc := acc - i;
  WriteLn('acc 5000 downto 0: ', acc, ' ', i);
  i := 77;
  acc := 1;
  lim := 4;
  for i := 5 to lim do
    acc := acc + i;
  WriteLn('acc no pass: ', acc, ' ', i);
end;

{ Runs of every length around the run size, both ways. }
procedure Runs;
var
  lens: array[0..8] of Integer;
  i, k, n, x: Integer;
begin
  lens[0] := 0;
  lens[1] := 1;
  lens[2] := 1022;
  lens[3] := 1023;
  lens[4] := 1024;
  lens[5] := 1025;
  lens[6] := 2047;
  lens[7] := 2048;
  lens[8] := 2049;
  for k := 0 to 8 do
  begin
    n := 0;
    x := 0;
    for i := 7 to 7 + lens[k] - 1 do
    begin
      n := n + 1;
      x := x xor (i * 31);
    end;
    Write(n, ':', x, ' ');
    n := 0;
    for i := 7 + lens[k] - 1 downto 7 do
    begin
      n := n + 1;
      x := x xor (i * 17);
    end;
    WriteLn(n, ':', x);
  end;
end;

{ break and continue on and around the runs' edges. }
procedure Edges;
var
  i, n, skip: Integer;
  a: array of Byte;
begin
  SetLength(a, 5000);
  n := 0;
  skip := 0;
  for i := 0 to 4999 do
  begin
    if i mod 1024 = 1023 then
    begin
      skip := skip + 1;
      Continue;
    end;
    if i = 4100 then
      Break;
    a[i] := Byte(i);
    n := n + a[i];
  end;
  WriteLn('edges up: ', n, ' ', skip, ' ', i);
  n := 0;
  for i := 4999 downto 0 do
  begin
    if i mod 1024 = 0 then
      Continue;
    if i = 1023 then
      Break;
    n := n + a[i];
  end;
  WriteLn('edges down: ', n, ' ', i);
end;

{ An outer loop runs as before; its inner one runs in runs. }
procedure Nest;
var
  i, j, n: Integer;
begin
  n := 0;
  for i := 1 to 30 do
    for j := i to 3000 do
      n := n + (j and i);
  WriteLn('nest: ', n, ' ', i, ' ', j);
end;

{ Spins in a loop of runs; the collector has to stop it many times. }
procedure Spin;
var
  k: Integer;
begin
  for k := 0 to High(Integer) do
  begin
    if done <> 0 then
      Break;
    spins := spins + 1;
  end;
  finished := 1;
end;

{ Sets its counter back, so it never reaches a run's end: it is not run
  in runs, and the collector still stops it (1.0.99). }
procedure Spin2;
var
  k: Integer;
begin
  for k := 0 to 100 do
  begin
    if done2 <> 0 then
      Break;
    spins2 := spins2 + 1;
    if k = 50 then
      k := 0;
  end;
  finished2 := 1;
end;

procedure Churn;
var
  i: Integer;
  s: string;
begin
  s := '';
  for i := 1 to 200000 do
  begin
    s := IntToStr(i) + 'x';
    if Length(s) = 0 then
      WriteLn('never');
  end;
end;

begin
  Ends;
  Sums;
  Runs;
  Edges;
  Nest;
  done := 0;
  spins := 0;
  finished := 0;
  pas Spin;
  Sleep(20);
  Churn;
  done := 1;
  while finished = 0 do
    Sleep(1);
  WriteLn('spin stopped: ', spins > 0);
  done2 := 0;
  spins2 := 0;
  finished2 := 0;
  pas Spin2;
  Sleep(20);
  Churn;
  done2 := 1;
  while finished2 = 0 do
    Sleep(1);
  WriteLn('counter set back: ', spins2 > 100);
end.
