{ P225: TcpConnect and UdpSend read a host as TcpConnectTo and UdpSendTo
  do: a name, an IPv6 literal, a part above 255, garbage and an empty
  host, -1 where the host cannot be used, and the program goes on, where
  HostV4 ended it. Loopback only; each host refused is refused before a
  nameserver is asked, so the output is the same on every machine. }
program hostread;

uses pasnet;

var
  l, l6, port, c, u, r: Integer;
  done: WaitGroup;
  m, host: string;
  hport: Integer;

procedure Serve(L: Integer);
var
  c: Integer;
begin
  c := TcpAccept(L);
  TcpClose(c);
  done.Done;
end;

begin
  l := TcpListenAt('127.0.0.1', 0, 16);
  port := TcpPort(l);
  done.Add(1);
  pas Serve(l);
  c := TcpConnect('localhost', port);
  WriteLn(c > 0);
  TcpClose(c);
  done.Wait;
  WriteLn(TcpConnect('256.1.1.1', port), ' ', TcpConnect('bad host!', port), ' ',
    TcpConnect('', port), ' ', TcpConnect('1.2.3', port));
  TcpClose(l);
  { an IPv6 literal, when the machine has IPv6 }
  l6 := TcpListenAt('::1', 0, 16);
  if l6 > 0 then
  begin
    done.Add(1);
    pas Serve(l6);
    c := TcpConnect('[::1]', TcpPort(l6));
    WriteLn(c > 0);
    TcpClose(c);
    done.Wait;
    TcpClose(l6);
  end
  else
    WriteLn(True);
  u := UdpBind(0);
  r := UdpBindAt('127.0.0.1', 0);
  WriteLn(UdpSend(u, 'localhost', UdpPort(r), 'hi'));
  m := UdpRecvFrom(r, 100, host, hport);
  WriteLn(m, ' ', host);
  WriteLn(UdpSend(u, '256.1.1.1', UdpPort(r), 'x'), ' ', UdpSend(u, 'bad host!', UdpPort(r), 'x'), ' ',
    UdpSend(u, '', UdpPort(r), 'x'));
  UdpClose(u);
  UdpClose(r);
  WriteLn('still here');
end.

