{ P660: Exception is the core's now, as it was SysUtils'; a program that
  declares its own class of the name, as one that did not use SysUtils
  did, still has its own. }
program excown;

type
  Exception = class
    Code: Integer;
  end;

var
  e: Exception;
begin
  e := Exception.Create;
  e.Code := 3;
  WriteLn('a program''s own class named Exception: ', e.Code);
end.
