{ P342: many routines asleep at once, each holding its record and its
  first stack and no more. The first argument is how many (20,000 when
  none is given): each waits at a gate the main block opens once every
  one has started, so that all are alive together, then sleeps 1 ms
  three times and counts itself. scripts/check_routinemem.py runs it with
  0 and with 20,000 and holds the difference of the two peaks, what one
  routine costs, to a bound. }
program sleepers;

uses SysUtils;

var
  wg: waitgroup;
  gate: chan of Integer;
  count: Integer;

procedure Sleeper;
var
  k, x: Integer;
begin
  { closed, the gate gives 0 at once }
  x := Recv(gate);
  for k := 1 to 3 do
    Sleep(1);
  AtomicAdd(@count, 1);
  wg.Done;
end;

var
  i, n: Integer;

begin
  n := 20000;
  if ParamCount > 0 then
    n := StrToInt(ParamStr(1));
  count := 0;
  gate := MakeChan();
  wg.Add(n);
  for i := 1 to n do
    pas Sleeper;
  Close(gate);
  wg.Wait;
  WriteLn(count, ' slept');
end.

