{ P293: Walker keeps the only pointer to a ring of 1000 records in a
  register while it loops without testing anything, and the main
  routine makes garbage; every cycle of the collector stops Walker by a
  signal wherever it is and reads its registers word by word, so the
  ring outlives them all and still sums 1 to 1000. }
program asyncgc;

uses sysutils;

type
  PNode = ^TNode;
  TNode = record
    V: Integer;
    Next: PNode;
  end;

var
  done: Integer;
  res: chan of Integer;

procedure Walker;
var
  head, p, q: PNode;
  i, s, n: Integer;
begin
  head := nil;
  q := nil;
  for i := 1 to 1000 do
  begin
    New(p);
    p^.V := i;
    p^.Next := nil;
    if head = nil then
      head := p
    else
      q^.Next := p;
    q := p;
  end;
  q^.Next := head;
  head := nil;
  q := nil;
  s := 0;
  n := 0;
  while done = 0 do
  begin
    p := p^.Next;
    s := s + p^.V;
    n := n + 1;
  end;
  { every node still holds its value: the walk from p sums 1..1000 }
  s := 0;
  for i := 1 to 1000 do
  begin
    s := s + p^.V;
    p := p^.Next;
  end;
  if n > 0 then
    Send(res, s)
  else
    Send(res, -1);
end;

var
  i, k: Integer;
  junk: array of Integer;
  t: string;

begin
  done := 0;
  res := MakeChan();
  pas Walker;
  Sleep(5);
  for i := 1 to 3000 do
  begin
    SetLength(junk, 0);
    SetLength(junk, 200);
    for k := 0 to 199 do
      junk[k] := i + k;
    t := IntToStr(i) + IntToStr(junk[7]);
  end;
  done := 1;
  WriteLn(Recv(res));
end.

