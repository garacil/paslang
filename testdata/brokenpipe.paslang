{ P382: a write to a broken pipe answers EPIPE and the program goes on,
  as in Go: every program has a SIGPIPE handler that returns, so
  write(2) gives EPIPE ("the write return value is seen only if the
  program catches, blocks or ignores this signal"). Here on a pipe whose
  read end is closed, from the main routine and from four others at
  once, through PasIoWrite and a plain write, and on a stream socket
  whose peer closed, written without MSG_NOSIGNAL. A program it starts
  gets SIGPIPE's default action back at exec (execve(2), which a
  handler gives and SIG_IGN would not): a shell it runs dies of it.
  With "out" or "err" it writes lines to its standard output or error
  until it dies of SIGPIPE, as Go's os.Stdout and os.Stderr do, which
  make check runs under a pipe that head closes, on both machines. }
program brokenpipe;

uses
  paslib, paslinux, pasnet;

const
  EPIPE = -32;

type
  TFds = array[0..1] of Int32;

var
  p: TFds;
  a, b, i, n, bad: Integer;
  output: string;
  wg: waitgroup;
  answers: array[0..3] of Integer;

function NbPipe(var F: TFds): Boolean;
begin
  F[0] := 0;
  F[1] := 0;
  if Amd64 = 1 then
    Result := Syscall(293, @F[0], 524288 or ONonblock) = 0
  else
    Result := Syscall(59, @F[0], 524288 or ONonblock) = 0;
end;

{ A pipe of its own with its read end closed, written twice }
procedure Broken(K: Integer);
var
  f: TFds;
  buf: array[0..7] of Byte;
  m: Integer;
begin
  if not NbPipe(f) then
    AtomicAdd(@bad, 1)
  else
  begin
    OsClose(f[0]);
    m := PasIoWrite(f[1], @buf[0], 8, 0);
    if m = EPIPE then
      m := PasIoWrite(f[1], @buf[0], 8, PasIoDeadline(1000));
    answers[K] := m;
    OsClose(f[1]);
  end;
  wg.Done;
end;

procedure Lines(Err: Boolean);
var
  k: Integer;
begin
  for k := 1 to 200000 do
    if Err then
      WriteLn(ErrOutput, 'a line that no one reads')
    else
      WriteLn('a line that no one reads');
  Halt(0);
end;

begin
  if ParamStr(1) = 'out' then
    Lines(False);
  if ParamStr(1) = 'err' then
    Lines(True);

  if not NbPipe(p) then
    Halt(1);
  OsClose(p[0]);
  n := PasIoWrite(p[1], @p[0], 4, 0);
  WriteLn('PasIoWrite to a pipe no one reads: ', n);
  n := OsWrite(p[1], Int64(@p[0]), 4);
  WriteLn('write(2) again: ', n);
  OsClose(p[1]);

  bad := 0;
  wg.Add(4);
  for i := 0 to 3 do
    pas Broken(i);
  wg.Wait;
  WriteLn('four routines: ', answers[0], ' ', answers[1], ' ', answers[2], ' ', answers[3], ', bad ', bad);

  if not UnixPair(a, b) then
    Halt(2);
  OsClose(b);
  n := OsWrite(a, Int64(@p[0]), 4);
  WriteLn('write(2) to a socket whose peer closed: ', n);
  OsClose(a);

  { the inner shell kills itself with SIGPIPE: 141 when its action is
    the default, "alive" when it is ignored }
  RunCapture('sh', ['-c', 'sh -c ''kill -s PIPE $$; echo alive''; echo $?'], output);
  Write('a shell it runs: ', output);
  WriteLn('still running');
end.

