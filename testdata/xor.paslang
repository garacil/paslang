program xorp;

var
  a, b: Integer;
  p, q: Boolean;

begin
  a := 6;
  b := 3;
  WriteLn(a xor b);
  WriteLn(255 xor 15);
  p := True;
  q := False;
  if p xor q then
    WriteLn(1)
  else
    WriteLn(0);
  if p xor True then
    WriteLn(1)
  else
    WriteLn(0);
  WriteLn(12 xor 12);
end.

