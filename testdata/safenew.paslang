{ P523: typed allocation keeps its pointer map in safe code while
  pointer-bearing nodes travel through a buffered channel. }
safe program safenew;

uses paslib;

type
  PNode = ^TNode;
  TNode = record
    Value: Integer;
    Text: string;
    Next: PNode;
  end;

var
  nodes: chan of PNode;
  finished: waitgroup;
  p: PNode;
  total, bad, count, collected: Integer;

procedure Produce;
var
  head, item: PNode;
  i: Integer;
begin
  head := nil;
  for i := 1 to 128 do
  begin
    New(item);
    item^.Value := i;
    item^.Text := 'node' + IntToStr(i);
    item^.Next := head;
    head := item;
  end;
  Send(nodes, head);
  finished.Done;
end;

function Deep(N: Integer; Item: PNode): Integer;
var
  pad: array[0..63] of Integer;
  cycle: Integer;
begin
  pad[N mod 64] := N;
  if N = 0 then
  begin
    cycle := GcCollect;
    Result := Item^.Value;
  end
  else
    Result := Deep(N - 1, Item) + pad[N mod 64] - N;
end;

begin
  nodes := MakeChan(1);
  finished.Add(1);
  pas Produce;
  finished.Wait;
  collected := GcCollect;
  p := Recv(nodes);
  WriteLn('deep ', Deep(100, p));
  total := 0;
  count := 0;
  bad := 0;
  while p <> nil do
  begin
    total := total + p^.Value;
    count := count + 1;
    if p^.Text <> 'node' + IntToStr(p^.Value) then
      bad := bad + 1;
    p := p^.Next;
  end;
  WriteLn('nodes ', count, ' total ', total, ' bad ', bad);
end.

