{ A routine's constants, types and nested routines are its own (P137):
  two routines each with a nested Sub, a constant K and a type TLoc of
  their own, a nested routine's own nested routine, an enumeration
  declared inside a routine, and a local name that hides a global
  one; after a routine, its names are gone and the global ones are
  seen again. The same source compiles with Free Pascal, whose output
  is the one expected. }
program scope1;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

const
  K = 100;

type
  TLoc = record
    Z: Integer;
  end;

function Sub(X: Integer): Integer;
begin
  Result := X - 1;
end;

procedure A;
const
  K = 1;
type
  TLoc = record
    X: Integer;
  end;
var
  r: TLoc;

  function Sub(X: Integer): Integer;

    function Inner(Y: Integer): Integer;
    begin
      Result := Y * K;
    end;

  begin
    Result := Inner(X) + 1;
  end;

begin
  r.X := Sub(K);
  WriteLn('A ', r.X, ' ', K);
end;

procedure B;
const
  K = 2;
type
  TLoc = record
    Y, X: Integer;
  end;
  TMood = (Glad, Sad);
var
  r: TLoc;
  m: TMood;

  function Sub(X: Integer): Integer;
  begin
    Result := X * 100;
  end;

  function Inner(const S: string): string;
  begin
    Result := S + '!';
  end;

begin
  r.X := Sub(K);
  r.Y := 7;
  m := Sad;
  WriteLn('B ', r.X, ' ', r.Y, ' ', Ord(m), ' ', Inner('b'), ' ', K);
end;

procedure C;
type
  TMood = (Calm, Busy, Glad);
var
  m: TMood;
begin
  m := Glad;
  WriteLn('C ', Ord(m), ' ', Sub(K), ' ', K);
end;

var
  g: TLoc;

begin
  A;
  B;
  C;
  g.Z := Sub(K);
  WriteLn(g.Z, ' ', K);
end.

