program typeargkeywords;

type
  TKeywordJson = json;
  TKeywordStore = store;
  TKeywordTree = tree[Integer] of Integer;
  TKeywordHeap = heap of Integer;
  TKeywordMap = map[Integer] of Integer;
  TKeywordChan = chan of Integer;
  TKeywordArray = array[0..1] of Byte;
  TKeywordSlice = array of Byte;
  TKeywordSet = set of Byte;
  TKeywordMutex = mutex;
  TKeywordRWMutex = rwmutex;
  TKeywordWaitGroup = waitgroup;
  TKeywordCond = cond;
  TKeywordOnce = once;
  TKeywordProc = procedure;
  TKeywordMethod = procedure of object;

var
  J: json;
  S: store;
  Calls: Integer;

procedure Check(Ok: Boolean; Stage: Integer);
begin
  if not Ok then begin WriteLn('keyword type stage ', Stage); Halt(118); end;
end;

function MakeJson: json;
begin
  Inc(Calls);
  Result := Default(json);
end;

begin
  Check(SizeOf(json) = 8, 1);
  Check(SizeOf(JSON) = 8, 2);
  Check(SizeOf(json { the entire operand }) = 8, 3);
  Check(SizeOf(TKeywordJson) = 8, 4);
  Check(SizeOf(J) = 8, 5);
  Check(SizeOf(MakeJson()) = 8, 6);
  Check(Calls = 0, 7);
  Check(SizeOf(Default(json)) = 8, 8);
  Check(SizeOf('Byte') = 16, 9);
  Check(SizeOf('json') = 16, 10);
  Check(SizeOf('Integer') = 16, 11);
  Check(SizeOf(Integer) = 8, 12);
  Check(SizeOf(Boolean) = 8, 13);
  Check(SizeOf(string) = 16, 14);
  Check(SizeOf(Char('A')) = 1, 15);
  Check(Ord(High(Char('A'))) = 255, 16);
  Check(Ord(Low(Char('A'))) = 0, 17);
  Check(Ord(High(Boolean)) = 1, 18);
  Check(Ord(Low(Boolean)) = 0, 19);
  Check(SizeOf(TKeywordStore) = 8, 20);
  Check(SizeOf(S) = 8, 21);
  Check(SizeOf(TKeywordTree) = 8, 22);
  Check(SizeOf(TKeywordHeap) = 8, 23);
  Check(SizeOf(TKeywordMap) = 8, 24);
  Check(SizeOf(TKeywordChan) = 8, 25);
  Check(SizeOf(TKeywordArray) = 2, 26);
  Check(SizeOf(TKeywordSlice) = 24, 27);
  Check(SizeOf(TKeywordSet) = 32, 28);
  Check(SizeOf(TKeywordMutex) = 32, 29);
  Check(SizeOf(TKeywordRWMutex) = 88, 30);
  Check(SizeOf(TKeywordWaitGroup) = 24, 31);
  Check(SizeOf(TKeywordCond) = 16, 32);
  Check(SizeOf(TKeywordOnce) = 32, 33);
  Check(SizeOf(TKeywordProc) = 16, 34);
  Check(SizeOf(TKeywordMethod) = 16, 35);
  Check(Calls = 0, 36);
  WriteLn('ok keyword type operands');
end.

