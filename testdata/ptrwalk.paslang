{ P303: a pointer a region keeps in a register is read and tested where
  it lives. p^.f is a load with p's register as its base on arm64 (it
  was copied into the pool first), a load into a register variable or
  into the result register goes there, and a word or a pointer compared
  with 0 or nil is CBZ or CBNZ on arm64 and TEST on amd64. Fields of
  every width and sign, at offset 0, at a natural offset and past
  LDR's, nil and 0 on either side, objects, and a walk whose appends
  run the collector while the list's only pointer is in a register. }
program ptrwalk;

type
  PNode = ^TNode;
  TNode = record
    b: Byte;
    i8: Int8;
    w: Word;
    i32: Int32;
    v: Integer;
    next: PNode;
  end;

  { fields past the reach of LDR's scaled offset (4095 words, 4095
    bytes) }
  PFar = ^TFar;
  TFar = record
    pad: array[0..4099] of Integer;
    far: Integer;
    fb: Byte;
    nx: PFar;
  end;

  TBox = class
    n: Integer;
    link: TBox;
  end;

function Build(n: Integer): PNode;
var
  i: Integer;
  p: PNode;
begin
  Result := nil;
  for i := n - 1 downto 0 do
  begin
    New(p);
    p^.b := Byte((i * 37) and 255);
    p^.i8 := Int8((i * 53) and 255);
    p^.w := Word((i * 4099) and 65535);
    p^.i32 := Int32(i * 100003) - 7;
    p^.v := i - 500;
    p^.next := Result;
    Result := p;
  end;
end;

{ every width, sign extended or not, summed through p in a register }
function Widths(p: PNode): Integer;
var
  t, c: Integer;
begin
  t := 0;
  c := 0;
  while p <> nil do
  begin
    t := t + p^.b + p^.i8 + p^.w + p^.i32;
    c := c + 1;
    p := p^.next;
  end;
  Result := t * 1000 + c;
end;

{ fields far from the pointer, and the next one there too }
function Far(n: Integer): Integer;
var
  i, t: Integer;
  p, q: PFar;
begin
  q := nil;
  for i := 1 to n do
  begin
    New(p);
    p^.far := i * 3;
    p^.fb := Byte(i and 255);
    p^.nx := q;
    q := p;
  end;
  t := 0;
  while q <> nil do
  begin
    t := t + q^.far + q^.fb;
    q := q^.nx;
  end;
  Result := t;
end;

{ nil on the left, = nil to stop, and a load into a register variable }
function Last(p: PNode): Integer;
var
  q: PNode;
  n: Integer;
begin
  n := 0;
  q := p;
  repeat
    n := n + 1;
    p := q;
    q := q^.next;
  until nil = q;
  Result := n * 100000 + p^.v;
end;

{ fields compared with 0, each width, both ways round }
function Zeros(p: PNode): Integer;
var
  z: Integer;
begin
  z := 0;
  while p <> nil do
  begin
    if p^.b = 0 then
      z := z + 1;
    if 0 = p^.i8 then
      z := z + 10;
    if p^.w <> 0 then
      z := z + 100;
    if p^.i32 = 0 then
      z := z + 1000;
    if p^.v = 0 then
      z := z + 10000;
    if p^.next = nil then
      z := z + 100000;
    p := p^.next;
  end;
  Result := z;
end;

{ an integer counter tested against 0, in a register and in memory }
function Down(n: Integer): Integer;
var
  k, s: Integer;
begin
  k := n;
  s := 0;
  while k <> 0 do
  begin
    s := s + k;
    k := k - 1;
  end;
  if s = 0 then
    s := -1;
  Result := s;
end;

{ objects: a chain of boxes, nil compares on a class }
function Boxes(n: Integer): Integer;
var
  b, h: TBox;
  i, t: Integer;
begin
  h := nil;
  for i := 1 to n do
  begin
    b := TBox.Create;
    b.n := i;
    b.link := h;
    h := b;
  end;
  t := 0;
  b := h;
  while b <> nil do
  begin
    if b.link = nil then
      t := t + 1000000;
    t := t + b.n;
    b := b.link;
  end;
  Result := t;
end;

{ the list's only pointer is p, in a register, while the appends run the
  collector (P301) }
function Spell(n: Integer): Integer;
var
  p: PNode;
  s: string;
begin
  p := Build(n);
  s := '';
  while p <> nil do
  begin
    s := s + Chr(97 + p^.b mod 26);
    p := p^.next;
  end;
  Result := Length(s) * 1000 + Ord(s[1]) + Ord(s[n]);
end;

var
  l: PNode;
begin
  l := Build(700);
  WriteLn(Widths(l), ' ', Widths(nil), ' ', Far(40));
  WriteLn(Last(l), ' ', Last(Build(1)));
  WriteLn(Zeros(l), ' ', Zeros(Build(1)));
  WriteLn(Down(0), ' ', Down(1), ' ', Down(100000));
  WriteLn(Boxes(1), ' ', Boxes(500));
  WriteLn(Spell(1), ' ', Spell(20000));
end.
