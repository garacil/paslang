{ P647: a character by its hexadecimal code, #$41, as Free Pascal and
  Delphi take it, everywhere a decimal code #65 goes: alone, joined with
  strings and other codes, in constants, case labels, sets, comparisons
  and typed constants, with either case of hex digit. }
program hexchar;

const
  Euro = #$e2#$82#$ac;
  Tab = #$09;
  Line = 'a'#$0A'b';
  Low0 = #$0;
  High1 = #$FF;

type
  TLetters = set of Char;

var
  c: Char;
  s: string;
  letters: TLetters;
  i, n: Integer;

function Kind(Ch: Char): string;
begin
  case Ch of
    #$30..#$39: Result := 'digit';
    #$41..#$5A, #$61..#$7a: Result := 'letter';
    #$20: Result := 'space';
  else
    Result := 'other';
  end;
end;

begin
  WriteLn(#$41, #66, #$43);
  WriteLn('the euro sign in UTF-8: ', Euro, ', ', Length(Euro), ' octets');
  s := 'x' + Tab + 'y';
  WriteLn('a tab between: ', Ord(s[2]), ', a line feed joined: ', Ord(Line[2]));
  WriteLn('#$0 and #$FF: ', Ord(Low0), ' ', Ord(High1));
  WriteLn('Ord(#$41) = ', Ord(#$41), ', #$41 = #65: ', #$41 = #65, ', #$7f = #127: ', #$7f = #127);
  WriteLn(Kind('7'), ' ', Kind('Q'), ' ', Kind('q'), ' ', Kind(' '), ' ', Kind('!'));
  letters := [#$41..#$46];
  n := 0;
  for i := 0 to 255 do
    if Chr(i) in letters then
      Inc(n);
  WriteLn('A to F by codes: ', n, ' letters, C among them: ', 'C' in letters);
  c := #$61;
  if c = 'a' then
    WriteLn('a comparison: ', c);
end.

