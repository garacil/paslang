{ P178: both original Ms wait for child processes which cannot exit
  until main runs and writes. A fork child uses raw syscall-only
  wrappers, never heap, scheduler, Pascal prologues or finalization. }
program syscallwait;

uses paslinux;

var
  pipes: array[0..1, 0..1] of Int32;
  pids: array[0..1] of Integer;
  started: chan of Integer;
  joined: waitgroup;
  phase, i, token, pid, count, readNumber, exitNumber, completed: Integer;
  byteValue: Byte;

procedure Waiter(Index: Integer);
var
  status: Int32;
  waited: Integer;
begin
  Send(started, Index);
  repeat
    waited := OsWait(pids[Index], Integer(@status), 0, 0);
  until waited <> -4;
  if (waited <> pids[Index]) or ((status and 127) <> 0) or
     ((status shr 8) <> Index + 7) then
  begin
    WriteLn('wait failed ', waited, ' wanted ', pids[Index], ' status ', status);
    Halt(40);
  end;
  AtomicAdd(@completed, 1);
  joined.Done;
end;

begin
  started := MakeChan();
  if Amd64 then readNumber := 0 else readNumber := 63;
  exitNumber := NrExit;
  for phase := 1 to 5 do
  begin
    for i := 0 to 1 do
      if OsPipe(Integer(@pipes[i, 0])) <> 0 then Halt(41);
    for i := 0 to 1 do
    begin
      pid := OsFork;
      if pid < 0 then Halt(42);
      if pid = 0 then
      begin
        repeat
          count := Sys3(readNumber, pipes[i, 0], Integer(@byteValue), 1);
        until count <> -4;
        if (count = 1) and (byteValue = 42) then
          count := Sys1(exitNumber, i + 7)
        else count := Sys1(exitNumber, 99);
      end;
      pids[i] := pid;
    end;
    joined.Add(2);
    for i := 0 to 1 do pas Waiter(i);
    for i := 0 to 1 do token := Recv(started);
    Sleep(30);
    GcCollect;
    byteValue := 42;
    for i := 0 to 1 do
      if OsWrite(pipes[i, 1], Integer(@byteValue), 1) <> 1 then Halt(43);
    joined.Wait;
    for i := 0 to 1 do
    begin
      if OsClose(pipes[i, 0]) <> 0 then Halt(44);
      if OsClose(pipes[i, 1]) <> 0 then Halt(45);
    end;
  end;
  WriteLn('child wait progress ', completed);
  WriteLn('bad fd ', OsRead(-1, 0, 0), ' missing syscall ', Sys0(-1));
end.
