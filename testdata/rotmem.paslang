  SShiftLeft(s);
  SetLength(d, 0);
  DShiftLeft(d);
  SetLength(d, 1);
  d[0] := 32769;
  DShiftLeft(d);
  SetLength(d, 5);
  d[0] := 1;
  d[1] := 32768;
  d[2] := 65535;
  d[3] := 4660;
  d[4] := 32767;
  DShiftLeft(d);
  s := '';
  SShiftRight(s);
  s := 'Z';
  SShiftRight(s);
  s := 'paslang!!';
  SShiftRight(s);
  s := '!"#$%&''()*+,-./01234';
  SShiftRight(s);
  SetLength(d, 0);
  DShiftRight(d);
  SetLength(d, 1);
  d[0] := 32769;
  DShiftRight(d);
  SetLength(d, 5);
  d[0] := 1;
  d[1] := 32768;
  d[2] := 65535;
  d[3] := 4660;
  d[4] := 32767;
  DShiftRight(d);
  s := '';
  SShiftRightSigned(s);
  s := 'Z';
  SShiftRightSigned(s);
  s := 'paslang!!';
  SShiftRightSigned(s);
  s := '!"#$%&''()*+,-./01234';
  SShiftRightSigned(s);
  SetLength(d, 0);
  DShiftRightSigned(d);
  SetLength(d, 1);
  d[0] := 32769;
  DShiftRightSigned(d);
  SetLength(d, 5);
  d[0] := 1;
  d[1] := 32768;
  d[2] := 65535;
  d[3] := 4660;
  d[4] := 32767;
  DShiftRightSigned(d);
  s := '';
  SShiftLeftToCarry(s);
  s := 'Z';
  SShiftLeftToCarry(s);
  s := 'paslang!!';
  SShiftLeftToCarry(s);
  s := '!"#$%&''()*+,-./01234';
  SShiftLeftToCarry(s);
  SetLength(d, 0);
  DShiftLeftToCarry(d);
  SetLength(d, 1);
  d[0] := 32769;
  DShiftLeftToCarry(d);
  SetLength(d, 5);
  d[0] := 1;
  d[1] := 32768;
  d[2] := 65535;
  d[3] := 4660;
  d[4] := 32767;
  DShiftLeftToCarry(d);
  s := '';
  SShiftRightToCarry(s);
  s := 'Z';
  SShiftRightToCarry(s);
  s := 'paslang!!';
  SShiftRightToCarry(s);
  s := '!"#$%&''()*+,-./01234';
  SShiftRightToCarry(s);
  SetLength(d, 0);
  DShiftRightToCarry(d);
  SetLength(d, 1);
  d[0] := 32769;
  DShiftRightToCarry(d);
  SetLength(d, 5);
  d[0] := 1;
  d[1] := 32768;
  d[2] := 65535;
  d[3] := 4660;
  d[4] := 32767;
  DShiftRightToCarry(d);
  s := '';
  SShiftRightSignedToCarry(s);
  s := 'Z';
  SShiftRightSignedToCarry(s);
  s := 'paslang!!';
  SShiftRightSignedToCarry(s);
  s := '!"#$%&''()*+,-./01234';
  SShiftRightSignedToCarry(s);
  SetLength(d, 0);
  DShiftRightSignedToCarry(d);
  SetLength(d, 1);
  d[0] := 32769;
  DShiftRightSignedToCarry(d);
  SetLength(d, 5);
  d[0] := 1;
  d[1] := 32768;
  d[2] := 65535;
  d[3] := 4660;
  d[4] := 32767;
  DShiftRightSignedToCarry(d);
  CarryOff;
  s := RotateLeftToCarry('paslang', 3);
  Write('literal ');
  HexOut(PByte(s), Length(s));
  WriteLn(' ', Carry);
  WriteLn('literal right ', RotateRight('paslang', 8));
  Fill(PByte(@big), 33, 11);
  CarryOn;
  for i := 1 to 70 do
    big := RotateLeftThroughCarry(big);
  Write('in place ');
  HexOut(PByte(@big), 33);
  WriteLn('/', Carry);
  Fill(PByte(@big), 33, 12);
  big := ShiftRightSignedToCarry(big, 100);
  Write('constant ');
  HexOut(PByte(@big), 33);
  WriteLn('/', Carry);
  r.A := $8001;
  r.B := 3;
  r.C := -1;
  r.D := 5;
  CarryOff;
  r := RotateLeftToCarry(r, 17);
  WriteLn('record ', r.A, ' ', r.B, ' ', r.C, ' ', r.D, ' ', Carry);
  WriteLn('field ', RotateLeft(r, 16).A);
  s := 'AB';
  s2 := s;
  s := ShiftLeftToCarry(s, 9);
  WriteLn('copy ', Ord(s[1]), ' ', Ord(s[2]), ' ', s2, ' ', Carry);
  ShiftRightToCarry('A', 1);
  Write('statement ', Carry);
  ShiftRightToCarry('AB', 9);
  Write(' ', Carry);
  ShiftRightToCarry('AB', 10);
  WriteLn(' ', Carry);
  WriteLn('funnel strings ', FunnelLeft('ab', 'cd', 8), ' ', FunnelRight('ab', 'cd', 12));
  SetLength(d2, 2);
  d2[0] := 1;
  d2[1] := 2;
  SetLength(d, 2);
  d[0] := $FFFF;
  d[1] := 3;
  d := FunnelRight(d, d2, 20);
  WriteLn('funnel words ', d[0], ' ', d[1], ' ', Length(d));
  WriteLn('funnel reals ', FunnelLeft(1.0, 2.0, 4) as UInt64);
  q := 1;
  q := FunnelLeft(q, q, 20);
  WriteLn('funnel quad ', (q as array[0..1] of Integer)[0], ' ', (q as array[0..1] of Integer)[1]);
  SetLength(bb, 0);
  bb := ShiftLeftToCarry(bb, 1);
  WriteLn('empty ', Length(bb), ' ', Carry);
end.

