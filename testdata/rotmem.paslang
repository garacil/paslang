      y := ShiftRightToCarry(x, cnt[j]);
      Write(' ');
      HexOut(PByte(@y), 32);
      Write('/', Carry);
    end;
    WriteLn;
  end;
end;

procedure MV256ShiftRightSignedToCarry(seed: Integer);
var
  x, y: V256;
  j, c: Integer;
begin
  Fill(PByte(@x), 32, seed);
  for c := 0 to 1 do
  begin
    Write('ShiftRightSignedToCarry V256 ', seed, ' ', c, ':');
    for j := 0 to High(cnt) do
    begin
      Carry := c = 1;
      y := ShiftRightSignedToCarry(x, cnt[j]);
      Write(' ');
      HexOut(PByte(@y), 32);
      Write('/', Carry);
    end;
    WriteLn;
  end;
end;

procedure FV256(seed: Integer);
var
  x, z, y: V256;
  j: Integer;
begin
  Fill(PByte(@x), 32, seed);
  Fill(PByte(@z), 32, seed + 1);
  Write('FunnelLeft V256 ', seed, ':');
  for j := 0 to High(cnt) do
  begin
    y := FunnelLeft(x, z, cnt[j]);
    Write(' ');
    HexOut(PByte(@y), 32);
  end;
  WriteLn;
  Write('FunnelRight V256 ', seed, ':');
  for j := 0 to High(cnt) do
  begin
    y := FunnelRight(x, z, cnt[j]);
    Write(' ');
    HexOut(PByte(@y), 32);
  end;
  WriteLn;
end;

procedure SRotateLeft(const s: string);
