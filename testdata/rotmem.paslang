program rotmem;

uses paslib;

{ Generated by scripts/rotmodel.py (P108, 1.0.130): the rotation words
  on values bigger than a register, strings and slices, their whole
  extent as one number, bit i being bit i mod 8 of byte i div 8. }

type
  TRec = record
    A: Word;
    B: Byte;
    C: Int32;
    D: Int32;
  end;
  TWords = array of Word;
  TBytes = array of Byte;
  TB1 = array[0..0] of Byte;
  TB3 = array[0..2] of Byte;
  TB8 = array[0..7] of Byte;
  TB9 = array[0..8] of Byte;
  TB17 = array[0..16] of Byte;
  TB33 = array[0..32] of Byte;

var
  cnt: array of Integer;

procedure Fill(p: PByte; n, seed: Integer);
var
  i, s: Integer;
begin
  s := seed;
  for i := 0 to n - 1 do
  begin
    s := (s * 1103515245 + 12345) and $7FFFFFFF;
    p[i] := Byte((s shr 16) and 255);
  end;
end;

procedure HexOut(p: PByte; n: Integer);
const
  Digits = '0123456789abcdef';
var
  i: Integer;
begin
  for i := 0 to n - 1 do
    Write(Digits[(p[i] shr 4) + 1], Digits[(p[i] and 15) + 1]);
end;

procedure SetCnt(nb: Integer);
var
  k: array of Integer;
  i, j, n: Integer;
  dup: Boolean;
begin
  SetLength(k, 14);
  k[0] := -3;
  k[1] := 0;
  k[2] := 1;
  k[3] := 7;
  k[4] := 8;
  k[5] := 9;
  k[6] := 64;
  k[7] := 65;
  k[8] := nb - 1;
  k[9] := nb;
  k[10] := nb + 1;
  k[11] := 2 * nb + 1;
  k[12] := 1000;
  k[13] := 1099511627776;
  SetLength(cnt, 0);
  for i := 0 to 13 do
  begin
    dup := False;
    for j := 0 to i - 1 do
      if k[j] = k[i] then
        dup := True;
    if not dup then
    begin
      n := Length(cnt);
      SetLength(cnt, n + 1);
      cnt[n] := k[i];
    end;
  end;
end;

procedure MB1RotateLeft(seed: Integer);
var
  x, y: TB1;
  j, c: Integer;
begin
  Fill(PByte(@x), 1, seed);
  for c := 0 to 1 do
  begin
    Write('RotateLeft B1 ', seed, ' ', c, ':');
    for j := 0 to High(cnt) do
    begin
      Carry := c = 1;
      y := RotateLeft(x, cnt[j]);
      Write(' ');
      HexOut(PByte(@y), 1);
      Write('/', Carry);
    end;
    WriteLn;
  end;
end;

