{ P584: the actual view still owns no bytes and preserves its checks.
  The unrepresentable memory at the top of the address space is tested
  separately, through the production predicate, without dereferencing it. }
program strviewrange;

uses SysUtils;

var
  p, unmarked: PByte;
  s, t: string;
  zero: Integer;

begin
  zero := ParamCount;
  WriteLn('empty ', Length(PasStrView(nil, zero)), ' ',
    Length(PasStrView(Pointer(-8), zero)));
  p := PByte(GetMem(4, 0));
  p[0] := 1;
  p[1] := 97; p[2] := 98; p[3] := 99;
  s := PasStrView(p + 1, 3);
  t := s;
  s[1] := 'X';
  WriteLn('live ', s, ' ', t, ' ', Integer(p[1]), ' ', Integer(p[0]));
  try
    s := PasStrView(nil, 1 + zero);
    WriteLn('nil was accepted');
  except
    on e: EArgumentNilException do WriteLn('nil ', e.ClassName);
  end;
  try
    s := PasStrView(p + 1, -1 - zero);
    WriteLn('negative was accepted');
  except
    on e: ERangeError do WriteLn('negative ', e.ClassName);
  end;
  try
    s := PasStrView(Pointer(-8), 9 + zero);
    WriteLn('wrap was accepted');
  except
    on e: ERangeError do WriteLn('wrap ', e.ClassName);
  end;
  unmarked := PByte(GetMem(4, 0));
  unmarked[0] := 0;
  try
    s := PasStrView(unmarked + 1, 1 + zero);
    WriteLn('unmarked was accepted');
  except
    on e: EArgumentException do WriteLn('mark ', e.ClassName);
  end;
end.

