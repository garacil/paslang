{ P356: a division's value lands in the register that reads it.
  Divisions and remainders by variables and by constants (powers of two
  and others), of negative dividends and narrow ones, as a call's
  arguments, into variables a loop keeps in registers and into memory,
  and in a condition. The answers are worked out by hand in the
  comments, the quotient truncated towards 0 and the remainder with the
  dividend's sign, Mix3's digits in base 1009; scripts/check_divmove.py
  finds no second move of a division's value, no dividend moved to rax
  from the pool and on arm64 no operand moved to x0 or x1, in the
  routines named By. }
program divreg;

var
  k, t, x, n, q: Integer;
  a: array[0..15] of Integer;
  b32: Int32;
  w: Word;

function Mix3(A, B, C: Integer): Integer;
begin
  Result := (A * 1009 + B) * 1009 + C;
end;

function ByArgs: Integer;
begin
  { 5 mod 3 = 2, 47 div 3 = 15, a[5] = 26, 26 div 3 = 8:
    (2 * 1009 + 15) * 1009 + 8 = 2051305 }
  Result := Mix3(k mod t, x div 3, a[k] div t);
end;

function ByConsts: Integer;
begin
  { 47 div 8 = 5, 47 mod 8 = 7, 47 mod 7 = 5: (5 * 1009 + 7) * 1009 + 5
    = 5097473 }
  Result := Mix3(x div 8, x mod 8, x mod 7);
end;

function ByNeg: Integer;
begin
  { -47 div 8 = -5, -47 mod 8 = -7, -47 div 7 = -6, -47 mod t = -2:
    (-5 * 1009 - 7) * 1009 - 6 - (-2) = -5097472 }
  Result := Mix3(n div 8, n mod 8, n div 7) - n mod t;
end;

function ByNarrow: Integer;
begin
  { -100 div 3 = -33, 65000 div 3 = 21666, -100 mod 5 = 0:
    (-33 * 1009 + 21666) * 1009 = -11735679 }
  Result := Mix3(b32 div t, w div 3, b32 mod 5);
end;

function ByLoop: Integer;
var
  j, acc, r: Integer;
begin
  { the sum over j = 1 to 1000 of j div 3 + j mod 7 + (j * 3) div 4 +
    j mod t: 166500 + 3003 + 375000 + 1000 = 545503 }
  acc := 0;
  for j := 1 to 1000 do
  begin
    r := j div t;
    acc := acc + r + j mod 7 + (j * 3) div 4 + j mod t;
  end;
  Result := acc;
end;

begin
  for k := 0 to 15 do
    a[k] := k * k + 1;
  k := 5;
  t := 3;
  x := 47;
  n := -47;
  b32 := -100;
  w := 65000;
  WriteLn(ByArgs);
  WriteLn(ByConsts);
  WriteLn(ByNeg);
  WriteLn(ByNarrow);
  WriteLn(ByLoop);
  q := x div t;
  { 15 and 2 }
  if (q = 15) and (x mod t = 2) then
    WriteLn('15 2');
  q := a[k + 1] mod t;
  { a[6] = 37, 37 mod 3 = 1 }
  WriteLn(q);
end.
