{ P124: a closure may not keep an array of const. }
program closure;
type
  TF = function: Int64;
function P(const A: array of const): TF;
begin
  Result := function: Int64
  begin
    Result := Length(A);
  end;
end;
begin
  WriteLn(P([1])());
end.

