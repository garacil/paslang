program syswidth;
uses sysutils, paslinux;
var root, path: string; handle, base, alias, other, count, i: Integer;
  data: TBytes; info: TFileInfo; stamp: TFileTime; error: TSysError;
  reader: TDirectoryReader; joined: waitgroup;

procedure RejectClose;
var localError: TSysError;
begin
  if TryFileClose(handle + 4294967296, localError) or (localError.Code <> 9) then Halt(40);
  joined.Done;
end;

begin
  root := ParamStr(1);
  path := root + '/width.bin';
  handle := FileCreate(path, 384);
  if handle < 0 then Halt(2);
  data := BytesOf('unchanged');
  if FileWrite(handle, data, Length(data)) <> Length(data) then Halt(3);
  for i := 0 to 1 do
  begin
    if i = 0 then alias := handle + 4294967296 else alias := handle - 4294967296;
    if TryFileReadAt(alias, data, 0, 1, 0, count, error) or (error.Code <> 9) then Halt(4);
    if TryFileWriteAt(alias, data, 0, 1, 0, count, error) or (error.Code <> 9) then Halt(5);
    if TryFileRead(alias, data, 0, 1, count, error) or (error.Code <> 9) then Halt(6);
    if TryFileWrite(alias, data, 0, 1, count, error) or (error.Code <> 9) then Halt(7);
    if TryFileRead(alias, data, 0, 0, count, error) or (error.Code <> 9) then Halt(8);
    if TryFileWrite(alias, data, 0, 0, count, error) or (error.Code <> 9) then Halt(9);
    if FileSeek(alias, 0, fsFromBeginning) <> -1 then Halt(10);
    if GetLastOSError <> 9 then Halt(11);
    if FileFlush(alias) or (GetLastOSError <> 9) then Halt(12);
    if FileTruncate(alias, 0) or (GetLastOSError <> 9) then Halt(13);
    if TryHandleInfo(alias, info, error) or (error.Code <> 9) then Halt(14);
    if FileGetDate(alias) <> -1 then Halt(15);
    if GetLastOSError <> 9 then Halt(16);
    if FileSetDate(alias, Integer(0)) <> 9 then Halt(17);
    if TryFileClose(alias, error) or (error.Code <> 9) then Halt(18);
  end;
  if not TryOpenFileAt(CurrentDirectoryHandle, root, ODirectory, 0, base, error) then Halt(19);
  stamp.Seconds := 0;
  stamp.Nanoseconds := 0;
  for i := 0 to 2 do
  begin
    if i = 0 then alias := base + 4294967296
    else if i = 1 then alias := base - 4294967296
    else alias := CurrentDirectoryHandle + 4294967296;
    if TryOpenFileAt(alias, 'width.bin', ORdonly, 0, other, error) or (error.Code <> 9) then Halt(20);
    if (other <> -1) then Halt(21);
    if TryFileInfoAt(alias, 'width.bin', True, info, error) or (error.Code <> 9) then Halt(22);
    if TrySetFileTimesAt(alias, 'width.bin', True, stamp, stamp, error) or (error.Code <> 9) then Halt(23);
    if TrySetFileModeAt(alias, 'width.bin', 384, error) or (error.Code <> 9) then Halt(24);
    if TryDeleteFileAt(alias, 'width.bin', False, error) or (error.Code <> 9) then Halt(25);
    if TryRenameFileAt(alias, 'width.bin', base, 'moved', True, error) or (error.Code <> 9) then Halt(26);
    if TryRenameFileAt(base, 'width.bin', alias, 'moved', True, error) or (error.Code <> 9) then Halt(27);
    if TryCreateDirectoryAt(alias, 'width-dir', 448, error) or (error.Code <> 9) then Halt(28);
    if TryForceDirectoriesAt(alias, 'width-dir', 448, error) or (error.Code <> 9) then Halt(29);
    if TryGetDirectoryPath(alias, path, error) or (error.Code <> 9) then Halt(30);
    if TryOpenDirectoryAt(alias, '.', reader, error) or (error.Code <> 9) then Halt(31);
    { Linux ignores the base for absolute paths, even an invalid base. }
    if not TryOpenFileAt(alias, root + '/width.bin', ORdonly, 0, other, error) then Halt(32);
    FileClose(other);
  end;
  if TryOpenFileAt(base, 'width.bin', 4294967296, 0, other, error) or (error.Code <> 22) then Halt(33);
  if FileSeek(handle, 0, 4294967296) <> -1 then Halt(34);
  if GetLastOSError <> 22 then Halt(35);
  joined.Add(128);
  for i := 1 to 128 do pas RejectClose;
  joined.Wait;
  GcCollect;
  if not TryFileReadAt(handle, data, 0, Length(data), 0, count, error) then Halt(36);
  if (StringOf(data) <> 'unchanged') or (count <> 9) then Halt(37);
  FileClose(base);
  FileClose(handle);
  if not DeleteFile(root + '/width.bin') then Halt(38);
  WriteLn('64-bit handles never alias Linux descriptors or flags');
end.
