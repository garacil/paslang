{ P311: a field of an element is read and written through one address:
  on amd64 the element's base, its index scaled and the field's offset
  in the load's or store's own operand, with no lea of the element
  first; on arm64 one add of the scaled index and the field's offset in
  the load or store. Records of 12, 16, 24 and 48 bytes with fields of
  every size (Byte, Word, Int32, Integer, Double, a nested record), in
  local, global and heap arrays and through a pointer, written, read,
  changed in place and passed, on edge values. The routines Loc, Glob,
  Heap2, Ptr and Nest, which scripts/check_fieldaddr.py reads, form no
  element's address before a field. }
program fieldaddr;

type
  TIn = record
    u: Int32;
    v: Integer;
  end;
  T12 = record a: Int32; b: Word; c: Byte; d: Int32; end;
  T16 = record b: Byte; w: Word; x: Int32; q: Integer; end;
  T24 = record r: Double; i: Integer; s: Byte; end;
  T48 = record h: Integer; n: TIn; t: array[0..1] of Integer; z: Integer; w: Word; end;
  P16 = ^T16;

var
  g12: array[0..63] of T12;
  g48: array[1..64] of T48;
  h16: array of T16;
  h24: array of T24;

function Loc(n: Integer): Integer;
var
  l16: array[0..63] of T16;
  l24: array[0..63] of T24;
  k, t: Integer;
begin
  for k := 0 to 63 do
  begin
    l16[k].b := Byte(k + n);
    l16[k].w := Word(k * 1000 + n);
    l16[k].x := Int32(-k - n);
    l16[k].q := k + n + High(Int32);
    l24[k].i := k - n;
    l24[k].s := Byte(255 - k);
  end;
  for k := 0 to 63 do
    l16[k].q := l16[k].q + l16[k].b;
  t := 0;
  for k := 0 to 63 do
    t := t + l16[k].b + l16[k].w + l16[k].x + l16[k].q + l24[k].i + l24[k].s;
  Result := t;
end;

function Glob(n: Integer): Integer;
var
  k, t: Integer;
begin
  for k := 0 to 63 do
  begin
    g12[k].a := Int32(k + n);
    g12[k].b := Word(k + 60000);
    g12[k].c := Byte(k);
    g12[k].d := Int32(Low(Int32) + k);
    g48[k + 1].h := k;
    g48[k + 1].z := -k;
    g48[k + 1].w := Word(k + n);
  end;
  t := 0;
  for k := 0 to 63 do
    t := t + g12[k].a + g12[k].b + g12[k].c + g12[k].d + g48[k + 1].h + g48[k + 1].z + g48[k + 1].w;
  Result := t;
end;

function Heap2(n: Integer): Integer;
var
  k, t: Integer;
begin
  SetLength(h16, n);
  SetLength(h24, n);
  for k := 0 to n - 1 do
  begin
    h16[k].b := Byte(k);
    h16[k].x := Int32(k * 3);
    h16[k].q := -k;
    h24[k].i := k + 7;
  end;
  t := 0;
  for k := 0 to n - 1 do
    t := t + h16[k].b + h16[k].x + h16[k].q + h24[k].i;
  Result := t;
end;

function Ptr(p: P16; n: Integer): Integer;
var
  k, t: Integer;
begin
  t := 0;
  for k := 0 to n - 1 do
    t := t + p[k].x + p[k].q;
  Result := t;
end;

function Nest(n: Integer): Integer;
var
  k, t: Integer;
begin
  for k := 1 to 64 do
  begin
    g48[k].n.u := Int32(k + n);
    g48[k].n.v := k * k;
  end;
  t := 0;
  for k := 1 to 64 do
    t := t + g48[k].n.u + g48[k].n.v;
  Result := t;
end;

function Reals(n: Integer): Double;
var
  k: Integer;
  s: Double;
begin
  for k := 0 to n - 1 do
    h24[k].r := k * 0.5;
  s := 0;
  for k := 0 to n - 1 do
    s := s + h24[k].r;
  Result := s;
end;

procedure Bump(var x: Integer);
begin
  x := x + 1000;
end;

var
  i: Integer;
begin
  WriteLn(Loc(0), ' ', Loc(9));
  WriteLn(Glob(0), ' ', Glob(-3));
  WriteLn(Heap2(1), ' ', Heap2(500));
  WriteLn(Ptr(@h16[0], 500), ' ', Ptr(@h16[100], 3));
  WriteLn(Nest(0), ' ', Nest(5));
  WriteLn(Reals(100):0:1);
  for i := 0 to 9 do
    Bump(h16[i].q);
  WriteLn(h16[0].q, ' ', h16[9].q, ' ', g48[64].n.v, ' ', g12[63].d);
end.
