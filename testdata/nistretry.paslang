program nistretry;
{ P615: a rejected first candidate must leave subsequent HMAC output real.
  The private unit view exports counters and the observed accepted nonce. }
uses pasnist, paslib;

procedure Require(OK: Boolean; const Name: string);
begin
  if not OK then
  begin
    WriteLn('FAIL ', Name, ' curve=', TestCurve, ' mode=', TestMode,
      ' calls=', TestCalls, ' points=', TestPoints, ' inverses=', TestInverses);
    Halt(1);
  end;
end;

var
  C, M, Size, WantPoints, WantInverses: Integer;
  P, H, R, S, PublicKey: string;
begin
  for C := NistP256 to NistP384 do
    for M := 1 to 7 do
    begin
      TestCurve := C;
      TestMode := M;
      TestCalls := 0;
      TestPoints := 0;
      TestInverses := 0;
      TestNonce := '';
      if C = NistP256 then Size := 32 else Size := 48;
      P := TestBytes(1);
      H := TestBytes(2);
      PublicKey := NistPublicKey(C, P);
      Require(NistEcdsaSign(C, P, H, R, S), 'retry sign');
      Require(TestCalls = 8, 'exactly one RFC retry');
      if M <= 4 then WantPoints := 1 else WantPoints := 2;
      if M = 6 then WantInverses := 2 else WantInverses := 1;
      Require(TestPoints = WantPoints, 'point attempts');
      Require(TestInverses = WantInverses, 'inverse attempts');
      Require(Length(TestNonce) = Size, 'observed real HMAC width');
      Require((Length(R) = Size) and (Length(S) = Size), 'fixed signature width');
      Require(NistEcdsaVerify(C, PublicKey, H, R, S), 'retry signature verifies');
      WriteLn('retry ', C, ' ', M, ' ', Hex(TestNonce), ' ', Hex(R), ' ', Hex(S), ' verified');
    end;
end.

