program selvaluecapture;
type TAct = procedure;
procedure ValueCapture;
var
  c: chan of Integer;
  acts: array[0..2] of TAct;
  i, j, value: Integer;
begin
  c := MakeChan(3);
  for i := 0 to 2 do
    acts[i] := procedure
      begin
        select
          Send(c, i + 10): ;
        else
          WriteLn('full');
        end;
      end;
  for j := 0 to 2 do
    acts[j]();
  for j := 0 to 2 do
    select
      Recv(c, value): WriteLn('value ', j, ': ', value);
    else
      WriteLn('missing');
    end;
end;
begin
  ValueCapture;
end.

