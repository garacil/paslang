{ Exceptions with objects (P122): raise carries an object of a class;
  an except part picks the first on-handler whose class the object's is
  or descends from, with its name for the object in that handler alone,
  runs the else part when none fits, and passes the object on to the
  next handler out when there is no else; raise; in a handler raises the
  same object again; finally runs and the object goes on; a plain except
  takes every object. The same source compiles with Free Pascal, whose
  output is the one expected. }
program excobj1;

{$ifndef PASLANG}
{$mode objfpc}{$H+}
{$endif}

type
  EBase = class
    Msg: string;
    Code: Int64;
    constructor Create(const M: string; C: Int64);
  end;

  EMid = class(EBase)
  end;

  ELeaf = class(EMid)
  end;

  EOther = class
    Why: string;
    constructor Create(const W: string);
  end;

var
  keep: EBase;

constructor EBase.Create(const M: string; C: Int64);
begin
  Msg := M;
  Code := C;
end;

constructor EOther.Create(const W: string);
begin
  Why := W;
end;

procedure Fail(Kind: Int64);
begin
  case Kind of
    1: raise EBase.Create('base', 1);
    2: raise EMid.Create('mid', 2);
    3: raise ELeaf.Create('leaf', 3);
    4: raise EOther.Create('other');
  end;
  WriteLn('no raise for ', Kind);
end;

procedure Catch(Kind: Int64);
begin
  try
    Fail(Kind);
    WriteLn('after Fail ', Kind);
  except
    on E: ELeaf do
      WriteLn('leaf handler: ', E.Msg, ' ', E.Code);
    on E: EMid do
      WriteLn('mid handler: ', E.Msg, ' ', E.Code, ' ', E.ClassName);
    on EBase do
      WriteLn('base handler with no name');
  else
    WriteLn('else part');
  end;
end;

procedure Outer;
begin
  try
    try
      raise EOther.Create('deep');
    except
      on E: EBase do
        WriteLn('wrong handler');
    end;
    WriteLn('not reached');
  except
    on E: EOther do
      WriteLn('outer caught ', E.Why);
  end;
end;

procedure Reraise;
begin
  try
    try
      raise EMid.Create('again', 7);
    except
      on E: EMid do
      begin
        keep := E;
        WriteLn('inner sees ', E.Msg);
        raise;
      end;
    end;
  except
    on E: EBase do
      WriteLn('outer sees ', E.Msg, ', the same object: ', Ord(Pointer(E) = Pointer(keep)));
  end;
end;

procedure NewInHandler;
begin
  try
    try
      raise EBase.Create('first', 1);
    except
      on E: EBase do
        raise EOther.Create('second, from ' + E.Msg);
    end;
  except
    on E: EOther do
      WriteLn('caught ', E.Why);
  end;
end;

procedure Fin;
begin
  try
    try
      raise ELeaf.Create('through finally', 9);
    finally
      WriteLn('finally runs');
    end;
  except
    on E: ELeaf do
      WriteLn('after finally: ', E.Msg);
  end;
end;

function FirstOk: Int64;
var
  i: Int64;
begin
  Result := -1;
  for i := 1 to 5 do
  begin
    try
      if i < 3 then
        raise EBase.Create('skip', i);
      Result := i;
      Exit;
    except
      on E: EBase do
      begin
        WriteLn('skip ', E.Code);
        Continue;
      end;
    end;
  end;
end;

procedure Scope;
var
  E: Int64;
begin
  E := 42;
  try
    raise EBase.Create('scoped', 5);
  except
    on E: EBase do
      WriteLn('inside ', E.Code);
  end;
  WriteLn('outside ', E);
end;

procedure Plain;
begin
  try
    raise EOther.Create('plain');
  except
    WriteLn('a plain except takes it');
  end;
end;

procedure WithAt;
begin
  try
    raise EBase.Create('with at', 11) at nil;
  except
    on E: EBase do
      WriteLn('raised with at: ', E.Msg);
  end;
end;

var
  k: Int64;

begin
  for k := 0 to 4 do
    Catch(k);
  Outer;
  Reraise;
  NewInHandler;
  Fin;
  k := FirstOk;
  WriteLn('FirstOk ', k);
  Scope;
  Plain;
  WithAt;
  WriteLn('done');
end.

