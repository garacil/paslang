program armmeth;

type
  TBox = class
    Seen: Integer;
    procedure Hit(X, Y: Integer);
    function Sum8(A, B, C, D, E, F, G, H: Integer): Integer;
    function Add(X: Integer): Integer; virtual;
  end;

  THit = procedure(X, Y: Integer) of object;

procedure TBox.Hit(X, Y: Integer);
begin
  Seen := X * 100 + Y;
  WriteLn(X);
  WriteLn(Y);
end;

function TBox.Sum8(A, B, C, D, E, F, G, H: Integer): Integer;
begin
  Result := A + B + C + D + E + F + G + H;
end;

function TBox.Add(X: Integer): Integer;
begin
  Result := X + 1;
end;

var
  o: TBox;
  m: THit;

begin
  o := TBox.Create;
  o.Hit(3, 4);
  WriteLn(o.Seen);
  WriteLn(o.Sum8(1, 2, 3, 4, 5, 6, 7, 8));
  WriteLn(o.Add(20));
  m := o.Hit;
  m(7, 8);
  WriteLn(o.Seen);
end.

