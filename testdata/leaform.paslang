program leaform;

{ c + k * x and y + k * x in one instruction, and loads and stores at
  p - k and p + k with the offset in the instruction, at the edges of
  the forms (P294). }

type
  PInt = ^Integer;
  PI32 = ^Int32;
  PU32 = ^UInt32;
  PI16 = ^Int16;
  PU16 = ^Word;
  PI8 = ^Int8;
  PU8 = ^Byte;

var
  big: array[0..4999] of Integer;
  w32: array[0..63] of Int32;
  w16: array[0..63] of Int16;
  w8: array[0..63] of Int8;

function Off8(x: Integer): Integer;
begin
  Result := 8 + 8 * x;
end;

function Off8R(x: Integer): Integer;
begin
  Result := x * 8 + 8;
end;

function ShlC(x: Integer): Integer;
begin
  Result := (x shl 3) + 16;
end;

function Edge32(x: Integer): Integer;
begin
  Result := -2147483648 + 4 * x;
end;

function Edge32Hi(x: Integer): Integer;
begin
  Result := 2147483647 + 2 * x;
end;

function Past32(x: Integer): Integer;
begin
  Result := 2147483648 + 2 * x;
end;

function MovTop(x: Integer): Integer;
begin
  Result := 65535 + 8 * x;
end;

function MovPast(x: Integer): Integer;
begin
  Result := 65536 + 8 * x;
end;

function Odd17(x: Integer): Integer;
begin
  Result := 70001 + 2 * x;
end;

function NegMov(x: Integer): Integer;
begin
  Result := -65536 + 4 * x;
end;

function NegPast(x: Integer): Integer;
begin
  Result := -65537 + 4 * x;
end;

function NegAdd(x: Integer): Integer;
begin
  Result := 4 * x - 4096;
end;

function Base(y, x: Integer): Integer;
begin
  Result := y + 4 * x;
end;

function BaseR(y, x: Integer): Integer;
begin
  Result := 8 * x + y;
end;

function Three(y, x: Integer): Integer;
begin
  Result := y + 8 * x + 16;
end;

function ThreeL(y, x: Integer): Integer;
begin
  Result := 16 + y + 2 * x;
end;

function Nested(a, b, c: Integer): Integer;
begin
  Result := (a + 2 * b) + 4 * (c + 8 * a);
end;

function MulL(x: Integer): Integer;
begin
  Result := 8 * x;
end;

function AndL(x: Integer): Integer;
begin
  Result := 255 and x;
end;

{ every register a loop keeps, r13 among them on amd64, as the base of a
  scaled sum }
function Loop(n: Integer): Integer;
var
  i, s, t, u, v: Integer;
begin
  s := 1;
  t := 2;
  u := 3;
  v := 4;
  for i := 0 to n - 1 do
  begin
    s := s + 8 * i;
    t := t + 4 * s;
    u := u + 2 * t;
    v := v + 8 * u + 3;
    s := s xor (v shr 7);
  end;
  Result := s + t + u + v;
end;

{ seven variables in registers, so amd64 keeps one in r13, whose sum
  with a scaled index is Intel's slow LEA: it stays a shift and an add }
function Loop7(n: Integer): Integer;
var
  i, a, b, c, d, e, f: Integer;
begin
  a := 1;
  b := 2;
  c := 3;
  d := 4;
  e := 5;
  f := 6;
  for i := 1 to n do
  begin
    a := a + 2 * f;
    b := b + 4 * a;
    c := c + 8 * b;
    d := d + 2 * c;
    e := e + 4 * d;
    f := f + 8 * e;
    a := a xor (f shr 11);
    b := b - 8 * i;
    c := c + (d shl 3) + 1;
  end;
  Result := a + b + c + d + e + f;
end;

function Back(p: Integer): Integer;
begin
  Result := PInt(p - 8)^ + PInt(p - 16)^;
end;

function Fwd(p: Integer): Integer;
begin
  Result := PInt(p + 8)^ + PInt(8 + p)^;
end;

procedure Put(p, v: Integer);
begin
  PInt(p - 8)^ := v;
  PInt(p + 16)^ := v + 1;
end;

function Far(p: Integer): Integer;
begin
  { -256 and 255 are LDUR's ends, 256 and 32760 LDR's scaled offset,
    -264, 260 and 32768 none of them }
  Result := PInt(p - 256)^ + PInt(p - 264)^ * 3 + PInt(p + 256)^ * 5 +
    PInt(p + 32760)^ * 7 + PInt(p + 32768)^ * 11;
end;

function FarOdd(p: Integer): Integer;
begin
  Result := PU8(p + 255)^ + PU8(p + 260)^ * 3 + PU8(p + 4095)^ * 5 + PU8(p + 4096)^ * 7;
end;

function Narrow(p32, p16, p8: Integer): Integer;
begin
  Result := PI32(p32 - 4)^ + PU32(p32 - 8)^ + PI16(p16 - 2)^ + PU16(p16 - 4)^ +
    PI8(p8 - 1)^ + PU8(p8 - 2)^ + PI32(p32 + 4)^ + PI16(p16 + 6)^ + PI8(p8 + 3)^;
end;

procedure PutNarrow(p32, p16, p8: Integer);
begin
  PI32(p32 - 4)^ := -7;
  PI16(p16 - 2)^ := -9;
  PI8(p8 - 1)^ := -11;
  PU16(p16 + 2)^ := 65000;
end;

function Idx(p, i: Integer): Integer;
begin
  Result := PInt(p + (i shl 3))^ + PInt(p + 8 * i - 8)^ + PInt((p - 16) + (i shl 3))^;
end;

function Idx32(p, i: Integer): Integer;
begin
  Result := PI32(p + 4 * i)^ + PI32(p + (i shl 2) + 4)^;
end;

var
  i, p, q, r, s: Integer;
begin
  WriteLn(Off8(3), ' ', Off8(-5), ' ', Off8R(7), ' ', ShlC(-3), ' ', Off8(2305843009213693951));
  WriteLn(Edge32(1), ' ', Edge32Hi(-1), ' ', Past32(5), ' ', Edge32(-2305843009213693952));
  WriteLn(MovTop(1), ' ', MovPast(-1), ' ', Odd17(3), ' ', NegMov(2), ' ', NegPast(-2), ' ', NegAdd(1025));
  WriteLn(Base(100, 7), ' ', BaseR(-100, 7), ' ', Three(5, -6), ' ', ThreeL(-5, 6), ' ', Nested(1, 2, 3));
  WriteLn(MulL(-9), ' ', AndL(4660), ' ', Base(9223372036854775807, 1), ' ', BaseR(1, 4611686018427387904));
  WriteLn(Loop(10), ' ', Loop(1000));
  WriteLn(Loop7(3), ' ', Loop7(5000));
  for i := 0 to 4999 do
    big[i] := i * 3 - 7000;
  for i := 0 to 63 do
  begin
    w32[i] := Int32(-2147483600 + i * 1000);
    w16[i] := Int16(-32000 + i * 900);
    w8[i] := Int8(-128 + i * 4);
  end;
  p := Integer(@big[2000]);
  q := Integer(@big[40]);
  WriteLn(Back(p), ' ', Fwd(p), ' ', Far(q), ' ', FarOdd(q));
  Put(p, 4242);
  WriteLn(big[1999], ' ', big[2002]);
  q := Integer(@w32[10]);
  r := Integer(@w16[10]);
  s := Integer(@w8[10]);
  WriteLn(Narrow(q, r, s));
  PutNarrow(q, r, s);
  WriteLn(w32[9], ' ', w16[9], ' ', w8[9], ' ', w16[11], ' ', Narrow(q, r, s));
  WriteLn(Idx(p, 3), ' ', Idx(p, -4), ' ', Idx32(q, 5), ' ', Idx32(q, -3));
end.
