program currency1;
uses pasfmt;
const
  Upper: Currency = 922337203685477.5807;
  Lower: Currency = -922337203685477.5808;
  Tie: Currency = 1.23445;
type
  TAmounts = array[0..1] of Currency;
  TPrice = record
    Amount: Currency;
    function Total(Count: Integer): Currency;
  end;
var
  amount, other: Currency;
  values: TAmounts;
  price: TPrice;
  calls, code: Integer;
  text: string;
  realValue: Double;
  singleValue: Single;
  quadValue: Quad;
  table: map[Integer] of TAmounts;

procedure Check(Value: Currency; Scaled: Integer);
begin if (Value as Integer) <> Scaled then Halt(2) end;

function TPrice.Total(Count: Integer): Currency;
begin Result := Amount * Count end;

function DefaultValue(Value: Currency = -1.23455): Currency;
begin Result := Value end;

function Next: Integer;
begin Inc(calls); Result := 0 end;

function Make: Currency;
begin Inc(calls); Result := 1.25 end;

function MakeQuad: Quad;
begin Inc(calls); Result := 1.25 end;

procedure VarValue(var Value: Currency; out CopyValue: Currency);
begin CopyValue := Value; Value := Value + 0.25 end;

procedure Worker(Index: Integer);
var local: Currency; held: string; i: Integer;
begin
  local := Index;
  held := 'currency-' + PasFmtInt(Index, 0);
  for i := 1 to 16 do
  begin
    local := local + 0.0001;
    if held <> 'currency-' + PasFmtInt(Index, 0) then Halt(3);
  end;
  Check(local, Index * 10000 + 16);
end;

begin
  Check(Upper, High(Integer)); Check(Lower, Low(Integer));
  Check(High(Currency), High(Integer)); Check(Low(Currency), Low(Integer));
  Check(Tie, 12344); Check(DefaultValue, -12346);
  Check(Default(Currency), 0); if SizeOf(Currency) <> 8 then Halt(4);
  amount := 1.23445; Check(amount, 12344);
  amount := -1.23455; Check(amount, -12346);
  amount := 2; other := 3;
  Check(amount + other, 50000); Check(other - amount, 10000);
  Check(amount * other, 60000); Check(amount / other, 6667);
  Check(-amount, -20000); Check(Abs(-amount), 20000);
  if not ((amount < other) and (amount <> other) and (amount <= other) and
    (other > amount) and (other >= amount) and (amount = amount)) then Halt(5);
  amount := -2.75;
  if (Trunc(amount) <> -2) or (Round(amount) <> -3) or
    (Floor(amount) <> -3) or (Ceil(amount) <> -2) then Halt(6);
  Check(Int(amount), -20000); Check(Frac(amount), -7500);
  Check(Min(amount, 1), -27500); Check(Max(amount, 1), 10000);
  calls := 0; Check(Sqr(Make), 15625); if calls <> 1 then Halt(7);
  calls := 0; Check(Currency(MakeQuad), 12500); if calls <> 1 then Halt(8);
  realValue := 1.25; Check(Currency(realValue), 12500);
  amount := 1.25; realValue := Double(amount); if realValue <> 1.25 then Halt(9);
  singleValue := Single(amount); if singleValue <> 1.25 then Halt(23);
  Check(Currency(singleValue), 12500);
  quadValue := Quad(amount); if quadValue <> 1.25 then Halt(10);
  Check(Currency(quadValue), 12500);
  VarValue(amount, other); Check(amount, 15000); Check(other, 12500);
  price.Amount := amount; Check(price.Total(3), 45000);
  amount += 0.25; Check(amount, 17500);
  amount *= 2; Check(amount, 35000);
  amount /= 4; Check(amount, 8750);
  Inc(amount); Dec(amount, 0.25); Check(amount, 16250);
  calls := 0; values[0] := 1; Inc(values[Next], 0.25);
  if calls <> 1 then Halt(11); Check(values[0], 12500);
  values[Next] += 0.25; if calls <> 2 then Halt(12); Check(values[0], 15000);
  New(table); table[4] := values;
  table[4][Next] += 0.25; if calls <> 3 then Halt(13); Check(table[4][0], 17500);
  Val('1.23445', amount, code); if code <> 0 then Halt(14); Check(amount, 12344);
  Str(amount:0:4, text); if text <> '1.2344' then Halt(15);
  Str(Upper, text); if text <> '922337203685477.5807' then Halt(16);
  amount := Upper;
  try amount := amount + 0.0001; Halt(17)
  except on error: ECurrencyError do if error.Kind <> cfOverflow then Halt(18) end;
  Check(amount, High(Integer));
  other := 0;
  try amount := amount / other; Halt(19)
  except on error: ECurrencyError do if error.Kind <> cfDivideByZero then Halt(20) end;
  amount := Lower;
  try amount := -amount; Halt(21)
  except on error: ECurrencyError do if error.Kind <> cfOverflow then Halt(22) end;
  for code := 0 to 127 do pas Worker(code);
  WriteLn('Currency exact constants, operators, conversions and places');
end.
