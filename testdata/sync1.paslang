{ mutex, lock ... do, waitgroup, rwmutex, once and cond shared by
  routines. Every count is exact: the primitives are what make it so. }
program sync1;

var
  mu: mutex;
  wg: waitgroup;
  rw: rwmutex;
  init: once;
  ready: cond;
  n, a, b, bad, inits, waked, i: Integer;

procedure Worker(K: Integer);
var
  j: Integer;
begin
  for j := 1 to 500 do
    lock mu do                   { held for the statement, then released }
      n := n + 1;
  wg.Done;
end;

procedure Early(K: Integer);
begin
  lock mu do
  begin
    n := n + K;
    if K > 0 then
      Exit;                      { leaving early still releases mu }
    n := n + 1000;
  end;
end;

procedure Writer(K: Integer);
var
  j: Integer;
begin
  for j := 1 to 200 do
    lock rw do                   { exclusive }
    begin
      a := a + 1;
      Yield;                     { a reader let in here would see a <> b }
      b := b + 1;
    end;
  wg.Done;
end;

procedure Reader(K: Integer);
var
  j: Integer;
begin
  for j := 1 to 200 do
    lock rw read do              { shared: readers run together }
      if a <> b then
        bad := bad + 1;
  wg.Done;
end;

procedure Setup;
begin
  inits := inits + 1;
end;

procedure Starter(K: Integer);
begin
  once init do                   { one routine runs Setup, the rest wait }
    Setup;
  wg.Done;
end;

procedure Waiter(K: Integer);
begin
  mu.Lock;
  while waked = 0 do
    ready.Wait(mu);
  n := n + 1;
  mu.Unlock;
  wg.Done;
end;

begin
  WriteLn(NumGoroutine);
  n := 0;
  wg.Add(8);
  for i := 1 to 8 do
    pas Worker(i);
  wg.Wait;
  WriteLn(n);
  Early(5);
  WriteLn(n, ' ', mu.TryLock);
  mu.Unlock;
  a := 0;
  b := 0;
  bad := 0;
  wg.Add(4);
  pas Writer(1);
  pas Writer(2);
  pas Reader(1);
  pas Reader(2);
  wg.Wait;
  WriteLn(a, ' ', b, ' ', bad);
  inits := 0;
  wg.Add(4);
  for i := 1 to 4 do
    pas Starter(i);
  wg.Wait;
  WriteLn(inits, ' ', init.Done);
  n := 0;
  waked := 0;
  wg.Add(2);
  pas Waiter(1);
  pas Waiter(2);
  Sleep(10);
  lock mu do
  begin
    waked := 1;
    ready.Broadcast;
  end;
  wg.Wait;
  WriteLn(n);
  WriteLn(Goid);
end.

