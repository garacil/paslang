program selectflow;
uses sysutils;
var done: chan of Integer;

function Grow(N: Integer; const Kept: string): Integer;
var pad: array[0..31] of Integer;
begin
  pad[N mod 32] := N;
  if N = 0 then
  begin
    GcCollect;
    if Kept <> 'owned select value' then Halt(2);
    Result := 0;
  end
  else Result := Grow(N - 1, Kept) + pad[N mod 32];
end;

procedure Worker;
var values: chan of string; text, kept: string; i, finals: Integer;
begin
  values := MakeChan(1); kept := 'owned select value'; finals := 0;
  Send(values, kept);
  while True do
  begin
    select
      Recv(values, text): if text = kept then Break;
    else Halt(3);
    end;
  end;
  if Grow(128, kept) <> 8256 then Halt(4);
  i := 0;
  while i < 8 do
  begin
    Inc(i);
    try
      select
        Recv(values, text): Halt(5);
      else
        begin
          if (i mod 2) = 0 then Continue;
          select
            Recv(values, text): Halt(6);
          else Continue;
          end;
        end;
      end;
    finally Inc(finals) end;
  end;
  if (finals <> 8) or (Grow(128, kept) <> 8256) then Halt(7);
  Send(values, kept);
  while True do
  begin
    try
      select
        Recv(values, text): Break;
      else Halt(8);
      end;
    finally Inc(finals) end;
  end;
  if (finals <> 9) or (Grow(128, kept) <> 8256) then Halt(9);
  Send(done, 1);
end;

function Leave: Integer;
var values: chan of Integer; value: Integer;
begin
  values := MakeChan();
  select
    Recv(values, value): Halt(10);
  else Exit(42);
  end;
  Result := 0;
end;

var i: Integer;
begin
  done := MakeChan();
  for i := 1 to 16 do pas Worker;
  for i := 1 to 16 do if Recv(done) <> 1 then Halt(11);
  if Leave <> 42 then Halt(12);
  WriteLn('select break/continue/exit preserve stacks, roots and finally');
end.
