{ P207: documents transformed, the old ones unchanged. JsonSet and
  JsonRemove at RFC 6901 pointers, an array element made a container
  and read past; JsonClone; the examples of RFC 6902 (appendix A) and
  RFC 7396 (appendix A); errors; and routines editing one document at
  once, which none of them changes. }
program jsonmod;

var
  doc, d2, d3, d4, d5, d6, d7, c: json;
  text: string;
  done: WaitGroup;
  mu: TPasMutex;
  same: Integer;

procedure Show(const What: string; J: json);
begin
  WriteLn(What, ' ', J);
end;

{ a JSON Patch of RFC 6902's appendix: the result and whether it is the
  one the RFC gives, or the error }
procedure Patch(const Name, Target, Ops, Want: string);
var
  r: json;
begin
  try
    r := JsonPatch(JsonParse(Target), JsonParse(Ops));
    WriteLn(Name, ' ', r, ' ', r = JsonParse(Want));
  except
    on E: EJsonError do
      WriteLn(Name, ' ', E.Message);
  end;
end;

procedure Merge(const Target, P, Want: string);
var
  r: json;
begin
  r := JsonMergePatch(JsonParse(Target), JsonParse(P));
  WriteLn(r, ' ', r = JsonParse(Want));
end;

procedure Fails(N: Integer);
var
  r: json;
  twice: string;
begin
  { a name twice: of a constant text a compile error (P209), so a
    variable's }
  twice := '[{"op": "add", "path": "/baz", "value": "qux", "op": "remove"}]';
  try
    case N of
      0: r := JsonSet(doc, '/nope/x', 1);
      1: r := JsonRemove(doc, '/server/zz');
      2: r := JsonSet(doc, 'bad', 1);
      3: r := JsonSet(doc, '/server/hosts/5', 1);
      4: r := JsonRemove(doc, '');
      5: r := JsonSet(doc, '/server/hosts/01', 1);
      6: r := JsonPatch(doc, JsonParse('{"op":"add"}'));
      7: r := JsonPatch(doc, JsonParse('[{"op":"jump","path":"/a"}]'));
      8: r := JsonPatch(doc, JsonParse('[{"op":"add","path":"/a"}]'));
      9: r := JsonPatch(doc, JsonParse('[{"op":"move","from":"/server","path":"/server/x"}]'));
      10: r := JsonPatch(doc, JsonParse('[{"op":"replace","path":"/zz","value":1}]'));
      11: r := JsonParse(twice);
    end;
    WriteLn(N, ' no error ', r);
  except
    on E: EJsonError do
      WriteLn(N, ' ', E.Message);
  end;
end;

procedure Edit(K: Integer);
var
  i: Integer;
  r: json;
begin
  for i := 1 to 500 do
  begin
    r := JsonSet(doc, '/server/port', K * 1000 + i);
    r := JsonRemove(r, '/debug');
    r := JsonSet(r, '/server/hosts/-', 'h');
    if (JsonEncode(doc) <> text) or (r['server']['port'].AsInteger <> K * 1000 + i) then
      lock mu do
        same := 0;
  end;
  done.Done;
end;

var
  k: Integer;

begin
  text := '{"server":{"port":80,"hosts":["a","b"]},"debug":false}';
  doc := JsonParse(text);
  d2 := JsonSet(doc, '/server/port', 8080);
  d3 := JsonSet(d2, '/server/name', 'web');
  d4 := JsonSet(d3, '/server/hosts/-', 'c');
  d5 := JsonSet(d4, '/server/hosts/0', JsonObject(['h', 'x', 'n', JsonArray([1, 2])]));
  d6 := JsonRemove(d5, '/debug');
  d7 := JsonRemove(d6, '/server/hosts/1');
  Show('d2', d2);
  Show('d3', d3);
  Show('d4', d4);
  Show('d5', d5);
  Show('d6', d6);
  Show('d7', d7);
  Show('doc', doc);
  WriteLn(d5['server']['hosts'][1].AsString, ' ', d5['server']['hosts'][2].AsString, ' ',
    Length(d5['server']['hosts']), ' ', d7['server']['hosts'][1].AsString, ' ',
    d5.At('/server/hosts/0/n/1').AsInteger);
  WriteLn(JsonParse(JsonEncode(d7)) = d7, ' ', JsonSet(doc, '', 5), ' ',
    JsonSet(doc, '/debug', True), ' ', JsonSet(doc, '/server/port', 0.5));
  c := JsonClone(doc['server']['hosts']);
  Show('clone', c);
  { RFC 6902, appendix A }
  Patch('A.1', '{"foo":"bar"}', '[{"op":"add","path":"/baz","value":"qux"}]', '{"baz":"qux","foo":"bar"}');
  Patch('A.2', '{"foo":["bar","baz"]}', '[{"op":"add","path":"/foo/1","value":"qux"}]',
    '{"foo":["bar","qux","baz"]}');
  Patch('A.3', '{"baz":"qux","foo":"bar"}', '[{"op":"remove","path":"/baz"}]', '{"foo":"bar"}');
  Patch('A.4', '{"foo":["bar","qux","baz"]}', '[{"op":"remove","path":"/foo/1"}]', '{"foo":["bar","baz"]}');
  Patch('A.5', '{"baz":"qux","foo":"bar"}', '[{"op":"replace","path":"/baz","value":"boo"}]',
    '{"baz":"boo","foo":"bar"}');
  Patch('A.6', '{"foo":{"bar":"baz","waldo":"fred"},"qux":{"corge":"grault"}}',
    '[{"op":"move","from":"/foo/waldo","path":"/qux/thud"}]',
    '{"foo":{"bar":"baz"},"qux":{"corge":"grault","thud":"fred"}}');
  Patch('A.7', '{"foo":["all","grass","cows","eat"]}', '[{"op":"move","from":"/foo/1","path":"/foo/3"}]',
    '{"foo":["all","cows","eat","grass"]}');
  Patch('A.8', '{"baz":"qux","foo":["a",2,"c"]}',
    '[{"op":"test","path":"/baz","value":"qux"},{"op":"test","path":"/foo/1","value":2}]',
    '{"baz":"qux","foo":["a",2,"c"]}');
  Patch('A.9', '{"baz":"qux"}', '[{"op":"test","path":"/baz","value":"bar"}]', '{}');
  Patch('A.10', '{"foo":"bar"}', '[{"op":"add","path":"/child","value":{"grandchild":{}}}]',
    '{"foo":"bar","child":{"grandchild":{}}}');
  Patch('A.11', '{"foo":"bar"}', '[{"op":"add","path":"/baz","value":"qux","xyz":123}]',
    '{"foo":"bar","baz":"qux"}');
  Patch('A.12', '{"foo":"bar"}', '[{"op":"add","path":"/baz/bat","value":"qux"}]', '{}');
  Patch('A.14', '{"/":9,"~1":10}', '[{"op":"test","path":"/~01","value":10}]', '{"/":9,"~1":10}');
  Patch('A.15', '{"/":9,"~1":10}', '[{"op":"test","path":"/~01","value":"10"}]', '{}');
  Patch('A.16', '{"foo":["bar"]}', '[{"op":"add","path":"/foo/-","value":["abc","def"]}]',
    '{"foo":["bar",["abc","def"]]}');
  Patch('copy', '{"a":{"b":1}}', '[{"op":"copy","from":"/a","path":"/c"}]', '{"a":{"b":1},"c":{"b":1}}');
  Patch('root', '{"a":1}', '[{"op":"replace","path":"","value":[1]}]', '[1]');
  { RFC 7396, appendix A }
  Merge('{"a":"b"}', '{"a":"c"}', '{"a":"c"}');
  Merge('{"a":"b"}', '{"b":"c"}', '{"a":"b","b":"c"}');
  Merge('{"a":"b"}', '{"a":null}', '{}');
  Merge('{"a":"b","b":"c"}', '{"a":null}', '{"b":"c"}');
  Merge('{"a":["b"]}', '{"a":"c"}', '{"a":"c"}');
  Merge('{"a":"c"}', '{"a":["b"]}', '{"a":["b"]}');
  Merge('{"a":{"b":"c"}}', '{"a":{"b":"d","c":null}}', '{"a":{"b":"d"}}');
  Merge('{"a":[{"b":"c"}]}', '{"a":[1]}', '{"a":[1]}');
  Merge('["a","b"]', '["c","d"]', '["c","d"]');
  Merge('{"a":"b"}', '["c"]', '["c"]');
  Merge('{"a":"foo"}', 'null', 'null');
  Merge('{"a":"foo"}', '"bar"', '"bar"');
  Merge('{"e":null}', '{"a":1}', '{"e":null,"a":1}');
  Merge('[1,2]', '{"a":"b","c":null}', '{"a":"b"}');
  Merge('{}', '{"a":{"bb":{"ccc":null}}}', '{"a":{"bb":{}}}');
  for k := 0 to 11 do
    Fails(k);
  { four routines editing one document: it stays as it was }
  same := 1;
  done.Add(4);
  for k := 1 to 4 do
    pas Edit(k);
  done.Wait;
  WriteLn('unchanged across routines ', same, ' ', JsonEncode(doc) = text);
end.

