{ P78: random numbers. A generator you own gives the same sequence
  every run for the same seed, which is what a test needs; the global
  one is there for everything else and two routines may draw from it at
  the same time. }
program randunit;

uses
  pasrand, pasroutines;

var
  a, b: TRand;
  i, n, lo, hi, heads: Integer;
  v: Int64;
  bad: Integer;
  counts: array of Integer;
  wg: TPasWaitGroup;
  draws: array of Int64;
  x: Real;

procedure Draw(Slot: Integer);
var
  k: Integer;
begin
  for k := 0 to 99 do
    draws[Slot * 100 + k] := RandN(1000);
  PasWaitGroupDone(wg);
end;

begin
  { The same seed, the same numbers, every run and on any machine. }
  RandInit(a, 1);
  WriteLn(RandNext(a));
  WriteLn(RandNext(a));
  WriteLn(RandNext(a));
  RandInit(a, 1);
  RandInit(b, 1);
  bad := 0;
  for i := 1 to 200 do
    if RandNext(a) <> RandNext(b) then
      bad := bad + 1;
  WriteLn(bad);

  { Two seeds, two streams. }
  RandInit(a, 1);
  RandInit(b, 2);
  WriteLn(RandNext(a) <> RandNext(b));

  { A seed of zero is a seed like any other: the state never ends up
    all zeros, which is the one state this generator cannot leave. }
  RandInit(a, 0);
  WriteLn(RandNext(a) <> 0, ' ', RandNext(a) <> 0);

  { Below N never leaves the range, and every value turns up. }
  RandInit(a, 7);
  SetLength(counts, 6);
  bad := 0;
  for i := 1 to 60000 do
  begin
    v := RandBelow(a, 6);
    if (v < 0) or (v > 5) then
      bad := bad + 1
    else
      counts[v] := counts[v] + 1;
  end;
  n := 0;
  for i := 0 to 5 do
    if (counts[i] > 8000) and (counts[i] < 12000) then
      n := n + 1;
  WriteLn(bad, ' ', n, ' ', counts[0] + counts[1] + counts[2] + counts[3] +
    counts[4] + counts[5]);

  { Below 1 and below 0 are not a question anybody can answer, so they
    are zero and do not loop for ever. }
  WriteLn(RandBelow(a, 1), ' ', RandBelow(a, 0), ' ', RandBelow(a, -5));

  { A range keeps its ends. }
  lo := 0;
  hi := 0;
  bad := 0;
  for i := 1 to 5000 do
  begin
    v := RandRange(a, 10, 20);
    if (v < 10) or (v > 20) then
      bad := bad + 1;
    if v = 10 then
      lo := lo + 1;
    if v = 20 then
      hi := hi + 1;
  end;
  WriteLn(bad, ' ', lo > 0, ' ', hi > 0, ' ', RandRange(a, 5, 5), ' ',
    RandRange(a, 9, 3));

  { A real between zero and one, never one. }
  bad := 0;
  for i := 1 to 5000 do
  begin
    x := RandReal(a);
    if (x < 0.0) or (x >= 1.0) then
      bad := bad + 1;
  end;
  WriteLn(bad);

  { Heads and tails come out about even. }
  heads := 0;
  for i := 1 to 10000 do
    if RandBool(a) then
      heads := heads + 1;
  WriteLn((heads > 4700) and (heads < 5300));

  { The global generator: seeded by hand it repeats, and two routines
    may draw from it at once. }
  RandSeed(99);
  v := RandInt;
  RandSeed(99);
  WriteLn(v = RandInt, ' ', RandN(10) < 10, ' ', RandFloat < 1.0, ' ',
    RandRangeN(3, 4) >= 3);

  SetLength(draws, 400);
  PasWaitGroupAdd(wg, 4);
  for i := 0 to 3 do
    pas Draw(i);
  PasWaitGroupWait(wg);
  bad := 0;
  for i := 0 to 399 do
    if (draws[i] < 0) or (draws[i] > 999) then
      bad := bad + 1;
  WriteLn(bad, ' ', Length(draws));

  { Randomize takes its seed from the kernel, so it is another stream
    every time; all that can be said for certain is that it works. }
  Randomize;
  WriteLn(RandN(100) < 100);
end.

