program sysguid;
uses sysutils, passort;
const Workers = 128; PerWorker = 16;
var done: waitgroup; ids: TStrArray; i: Integer;

procedure Check(Index: Integer);
var random, timed, again, empty: TGUID; bytes: TBytes;
  k, bit, position: Integer; text: string;
begin
  if SizeOf(TGUID) <> 16 then Halt(2);
  empty := StringToGUID('00000000-0000-0000-0000-000000000000');
  if not empty.IsEmpty then Halt(3);
  timed := TGUID.Create('017f22e2-79b0-7cc3-98c4-dc0c0c07398f');
  if (timed.UnixMilliseconds <> 1645557742000) or (timed.Version <> 7) then Halt(4);
  if timed.ToString <> '{017F22E2-79B0-7CC3-98C4-DC0C0C07398F}' then Halt(5);
  bytes := timed.ToByteArray;
  if (bytes[0] <> 1) or (bytes[1] <> 127) or (bytes[6] <> 124) or (bytes[15] <> 143) then Halt(6);
  if not IsEqualGUID(TGUID.Create(bytes), timed) then Halt(7);
  position := Index + 1;
  while position <= 36 do
  begin
    text := timed.ToString(True); text[position] := '!';
    if TryStringToGUID(text, again) or not again.IsEmpty then Halt(8);
    position := position + Workers;
  end;
  try again := TGUID.Create(RandomBytes(15)); Halt(9)
  except on EArgumentException do ; end;
  try bit := empty.UnixMilliseconds; Halt(10)
  except on EArgumentException do ; end;
  for k := 0 to PerWorker - 1 do
  begin
    random := TGUID.NewGuid;
    if random.IsEmpty or (random.Version <> 4) or ((random.D4[0] and 192) <> 128) then Halt(11);
    timed := TGUID.NewTimeGuid;
    if timed.IsEmpty or (timed.Version <> 7) or (timed.UnixMilliseconds <= 1645557742000) or
      ((timed.D4[0] and 192) <> 128) then Halt(12);
    ids[(Index * PerWorker + k) * 2] := random.ToString;
    ids[(Index * PerWorker + k) * 2 + 1] := timed.ToString;
    if k = 0 then
    begin
      again := StringToGUID(random.ToString);
      if not IsEqualGUID(random, again) then Halt(13);
      bytes := GuidToBytes(timed);
      again := GuidFromBytes(bytes);
      if not IsEqualGUID(timed, again) then Halt(14);
      bytes[0] := 0;
      if timed.D1 = 0 then Halt(15);
    end;
    if (k mod 4) = 0 then GcCollect;
  end;
  done.Done;
end;
begin
  SetLength(ids, Workers * PerWorker * 2);
  done.Add(Workers);
  for i := 0 to Workers - 1 do pas Check(i);
  done.Wait;
  { Reuse the in-place sorter: collision checking itself need not
    allocate a map node and force another full GC for every identifier. }
  SortStrings(ids);
  for i := 1 to High(ids) do
    if ids[i] = ids[i - 1] then Halt(16);
  WriteLn('RFC GUID fields/text/network bytes, strict rejection, 4096 concurrent random/time IDs');
end.
