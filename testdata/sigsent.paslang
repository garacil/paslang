{ P568: a signal that someone sent is no fault of the code it lands on.
  The program says it is ready, and the thread it runs on, and then turns
  in a loop of its own code, inside a try with a handler for
  EAccessViolation, until scripts/sigsent_check.py sends it SIGSEGV or
  SIGBUS: with kill(2), which the kernel gives to any thread of the
  program, and with tgkill(2) at the thread of the loop, where a fault of
  the loop's own code would be raised. The signal's code says it was sent
  (SI_USER, SI_TKILL: 0 or less), so nothing is raised: the program ends
  as it always did, with a line of the runtime and status 1, and the
  handler never runs. Go asks the same of a signal (sigFromUser). gettid
  by its number (asm/unistd_64.h, asm-generic/unistd.h). }
program sigsent;

uses
  sysutils;

var
  n, i, tid: Int64;

begin
  if Amd64 = 1 then
    tid := Syscall(186)
  else
    tid := Syscall(178);
  WriteLn('ready ', tid);
  n := ParamCount;
  try
    while n >= 0 do
    begin
      for i := 1 to 1000000 do
        n := (n + i) and 1048575;
    end;
  except
    on e: EAccessViolation do
      WriteLn('taken: ', e.Message);
  end;
  WriteLn('not reached');
end.

