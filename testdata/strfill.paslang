{ for i := 1 to Length(s) do s[i] := ... (1.1.1): the loop owns s's
  characters from one check before it, and its stores take no check of
  each. A string shared with another before the loop is copied once, so
  the other keeps its characters; a loop from 2, an empty string and a
  body of two stores that reads s[i] take the rule too; a value that
  calls a routine keeps the checks, and every result is the same. }
program strfill;

function Twice(c: Char): Char;
begin
  Result := Char((Ord(c) * 2) and 255);
end;

var
  s, t, e: string;
  i, sum: Integer;

begin
  SetLength(s, 10);
  for i := 1 to Length(s) do
    s[i] := Char(64 + i);
  WriteLn(s);
  t := s;
  for i := 1 to Length(s) do
    s[i] := Char(Ord(s[i]) + 32);
  WriteLn(s, ' ', t);
  for i := 2 to Length(s) do
  begin
    s[i] := 'x';
    s[i] := Char(Ord(s[i]) - 1);
  end;
  WriteLn(s);
  e := '';
  for i := 1 to Length(e) do
    e[i] := 'z';
  WriteLn(Length(e));
  for i := 1 to Length(s) do
    s[i] := Twice(s[i]);
  sum := 0;
  for i := 1 to Length(s) do
    sum := sum + Ord(s[i]);
  WriteLn(sum);
  WriteLn(t);
end.

