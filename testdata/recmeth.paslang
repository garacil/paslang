{ Records with methods and properties (P165), as Free Pascal's advanced
  records: methods on Self, static class methods, constructors (TVec.Create
  makes one, v.Create runs on v), field and method properties, private and
  strict private, a with that reaches the members, and helpers that add
  to them and make a value. }
program recmeth;

{$mode objfpc}{$H+}{$modeswitch advancedrecords}{$modeswitch typehelpers}

uses SysUtils;

type
  TVec = record
    X, Y: Int64;
  private
    FTag: Int64;
    function GetLen2: Int64;
    procedure SetTag(V: Int64);
  public
    constructor Create(AX, AY: Int64);
    function Add(const B: TVec): TVec;
    procedure Scale(K: Int64);
    class function Zero: TVec; static;
    property Len2: Int64 read GetLen2;
    property Tag: Int64 read FTag write SetTag;
    property Raw: Int64 read FTag write FTag;
  end;

  TCount = record
  strict private
    FN: Int64;
  private
    FName: string;
    procedure Bump;
  public
    constructor Create(const AName: string); overload;
    constructor Create(const AName: string; AN: Int64); overload;
    function Twice: Int64;
    procedure AddTo(var Total: Int64);
    function Describe: string;
    class procedure Hello; static;
    class function Make(K: Int64): TCount; static;
    property N: Int64 read FN;
    property Name: string read FName write FName;
  end;

  TPair = record
    A, B: TCount;
  end;

  { a helper adds to the record's own members, and may make one }
  TCountHelper = record helper for TCount
    constructor Named(const AName: string);
    function Thrice: Int64;
  end;

  TWideHelper = type helper for Int64
    constructor Doubled(V: Int64);
    function Half: Int64;
  end;

var
  calls: Int64;

constructor TVec.Create(AX, AY: Int64);
begin
  X := AX;
  Y := AY;
  FTag := 1;
end;

function TVec.GetLen2: Int64;
begin
  Result := X * X + Y * Y;
end;

procedure TVec.SetTag(V: Int64);
begin
  FTag := V * 10;
end;

function TVec.Add(const B: TVec): TVec;
begin
  Result := TVec.Create(X + B.X, Y + B.Y);
end;

procedure TVec.Scale(K: Int64);
begin
  X := X * K;
  Self.Y := Self.Y * K;
end;

class function TVec.Zero: TVec;
begin
  Result.X := 0;
  Result.Y := 0;
  Result.FTag := 0;
end;

{ the constructor of one name calls the other on the same Self }
constructor TCount.Create(const AName: string);
begin
  FName := 'none';
  Create(AName, 1);
end;

constructor TCount.Create(const AName: string; AN: Int64);
begin
  FName := AName;
  FN := AN;
end;

procedure TCount.Bump;
begin
  FN := FN + 1;
  calls := calls + 1;
end;

function TCount.Twice: Int64;
begin
  Bump;
  Self.Bump;
  Result := FN * 2;
end;

procedure TCount.AddTo(var Total: Int64);
begin
  Total := Total + FN;
end;

function TCount.Describe: string;
begin
  Result := FName + '=' + IntToStr(FN);
end;

class procedure TCount.Hello;
begin
  WriteLn('hello ', calls);
end;

class function TCount.Make(K: Int64): TCount;
begin
  Result := TCount.Create('made', K);
end;

constructor TCountHelper.Named(const AName: string);
begin
  Create(AName, 100);
end;

function TCountHelper.Thrice: Int64;
begin
  Result := N * 3;
end;

constructor TWideHelper.Doubled(V: Int64);
begin
  Self := V * 2;
end;

function TWideHelper.Half: Int64;
begin
  Result := Self div 2;
end;

function Show(const C: TCount): string;
begin
  Result := C.Describe;
end;

var
  a, b, c: TVec;
  k: TCount;
  arr: array[0..2] of TCount;
  p: TPair;
  t, w: Int64;
  i: Integer;
  X: Int64;
begin
  a := TVec.Create(3, 4);
  b := TVec.Create(1, 2);
  c := a.Add(b);
  WriteLn(c.X, ' ', c.Y, ' ', a.Len2, ' ', c.Tag);
  c.Scale(2);
  c.Tag := 5;
  WriteLn(c.X, ' ', c.Y, ' ', c.Tag, ' ', c.Raw);
  c.Raw := 7;
  WriteLn(c.Tag, ' ', TVec.Zero.Len2, ' ', SizeOf(TVec));
  { v.Create runs on v }
  c.Raw := 9;
  c.Create(5, 6);
  WriteLn(c.X, ' ', c.Y, ' ', c.Raw);
  k := TCount.Create('k');
  WriteLn(k.Describe, ' ', k.Twice, ' ', k.Describe);
  t := 10;
  k.AddTo(t);
  WriteLn(t);
  k.Create('again');
  WriteLn(k.Describe);
  for i := 0 to 2 do
    arr[i] := TCount.Make(i * 10);
  arr[1].Twice;
  WriteLn(arr[0].Describe, ' ', arr[1].Describe, ' ', arr[2].Describe);
  p.A := TCount.Create('a', 5);
  p.B := TCount.Create('b');
  p.A.Twice;
  WriteLn(Show(p.A), ' ', Show(p.B));
  { a with reaches the fields, methods and properties, before a local }
  X := 100;
  with a do
  begin
    Scale(2);
    Tag := 3;
    WriteLn(X, ' ', Y, ' ', Len2, ' ', Tag);
  end;
  WriteLn(X);
  with p.B do
  begin
    Twice;
    Name := 'bee';
    WriteLn(Describe, ' ', Thrice);
  end;
  WriteLn(p.B.Describe, ' ', p.B.N, ' ', p.B.Thrice);
  WriteLn(TCount.Make(7).Describe, ' ', TCount.Make(4).Thrice);
  WriteLn(TCount.Named('nm').Describe);
  k.Named('kn');
  WriteLn(k.Describe);
  TCount.Hello;
  k.Hello;
  k.Name := k.Name + 'x';
  WriteLn(k.Name);
  w := Int64.Doubled(21);
  WriteLn(w, ' ', w.Half);
  w.Doubled(5);
  WriteLn(w);
end.

