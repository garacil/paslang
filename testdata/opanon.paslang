{ P157: operators on two types with no name, array of Integer and array
  of Byte, are two routines: their symbols were one. }
program opanon;

type
  TV = record
    X: Integer;
  end;

operator + (A: TV; B: array of Integer): TV;
begin
  Result.X := A.X + Length(B);
end;

operator + (A: TV; B: array of Byte): TV;
begin
  Result.X := A.X - Length(B);
end;

var
  v: TV;
  a: array of Integer;
  b: array of Byte;

begin
  v.X := 10;
  SetLength(a, 3);
  SetLength(b, 2);
  WriteLn((v + a).X, ' ', (v + b).X);
end.

