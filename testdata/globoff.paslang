{ P374: on arm64 a global's field or element at a constant offset is one
  adrp and one access, the offset in :lo12:: fields of every width of a
  global record and of a record in an element of a global array, nested,
  read, written and read again; a block copied between them keeps its
  form. The layout: TIn is B at 0, W at 2, L at 4, Q at 8, 16 bytes;
  TOut is A at 0, Inner at 8, Arr at 24, 88 bytes, so g[3].Arr[2] is at
  2 * 88 + 24 + 2 * 16 = 232 of g, its Q at 240. }
program globoff;

type
  TIn = record
    B: Byte;
    W: Word;
    L: Int32;
    Q: Integer;
  end;
  TOut = record
    A: Integer;
    Inner: TIn;
    Arr: array[0..3] of TIn;
  end;

var
  g: array[1..4] of TOut;
  o: TOut;
  x: Integer;
  b: Byte;
  w: Word;
  l: Int32;

begin
  o.Inner.B := 200;
  o.Inner.W := 60000;
  o.Inner.L := -70000;
  o.Inner.Q := 1 shl 40;
  g[3].Arr[2].B := 7;
  g[3].Arr[2].W := 8;
  g[3].Arr[2].L := 9;
  g[3].Arr[2].Q := 10;
  g[4].A := 11;
  b := o.Inner.B;
  w := o.Inner.W;
  l := o.Inner.L;
  x := o.Inner.Q;
  WriteLn(b, ' ', w, ' ', l, ' ', x);
  WriteLn(g[3].Arr[2].B, ' ', g[3].Arr[2].W, ' ', g[3].Arr[2].L, ' ', g[3].Arr[2].Q, ' ', g[4].A);
  Inc(g[3].Arr[2].Q, 5);
  g[2].Inner := o.Inner;
  WriteLn(g[3].Arr[2].Q, ' ', g[2].Inner.L, ' ', g[2].Inner.B);
end.

