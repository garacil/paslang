{ P328: a word worked out in the pool lands in the register that reads
  it. An argument worked out first goes to its own register, a chain of
  plain steps worked out there (F(i and 15) is a load and an and into
  the first argument's register, as Go's MOVQ AX, BX; ANDL $15, BX); a
  condition the pool works out is tested where it is; WriteLn's words
  are stored from where they are, on arm64 at sp's offset. The answers
  are worked out by hand in the comments. scripts/check_argreg.py finds
  no move of the pool's value to rax or x0 that a move to the reader
  follows. }
program argreg;

var
  i, k, p, q: Integer;
  a: array[0..63] of Integer;
  b: Boolean;

function F(X: Integer): Integer;
begin
  Result := X * 3;
end;

function G(X, Y: Integer): Integer;
begin
  Result := X - Y;
end;

begin
  i := 21;
  k := 5;
  p := 6;
  q := 3;
  a[5] := 7;
  a[21] := 9;
  { 21 and 15 = 5, F 15; 21 and 7 = 5, G 0; a[5] - 6 = 1; a[21] = 9, F 27 }
  WriteLn(F(i and 15), ' ', G(k, i and 7), ' ', G(a[k], k + 1), ' ', F(a[i and 63]));
  { 6 xor 3 = 5, not 0 }
  if (p xor q) <> 0 then
    WriteLn('p xor q is ', p xor q);
  b := (p and 1) = 0;
  if b xor (q > 2) then
    WriteLn('one of them')
  else
    WriteLn('both or neither');
  { 21 + 5 = 26, 21 * 3 - 5 = 58, 21 shl 2 = 84 }
  WriteLn(i + k, ' ', i * 3 - k, ' ', i shl 2);
end.
