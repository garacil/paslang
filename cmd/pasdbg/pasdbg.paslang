{ pasdbg: the terminal of a program compiled with -debug (P118). The
  program listens on the socket PASLANG_DEBUG names; pasdbg connects,
  sends each line typed and prints the reply up to its ok or error.

    pasdbg <socket>          a path, or @name for an abstract one
    pasdbg <socket> <cmd>    one command, its reply, and out

  The commands: help, routines, stopped, wait, where g, vars g [frame],
  globals, functions, break line | file:line | routine, breaks,
  delete n, step g, next g, continue g, stop [g], run [args], quit. }
program pasdbg;

uses pasnet;

var
  c: Integer;
  buf, line, cmd: string;

function Reply: Boolean;
var
  l: string;
begin
  Result := False;
  while TcpReadLine(c, buf, l) do
  begin
    WriteLn(l);
    if (l = 'ok') or (Copy(l, 1, 7) = 'error: ') then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

begin
  if ParamCount < 1 then
  begin
    WriteLn('pasdbg <socket> [command]');
    Halt(2);
  end;
  c := UnixConnect(ParamStr(1));
  if c < 0 then
  begin
    WriteLn('pasdbg: cannot connect to ', ParamStr(1));
    Halt(1);
  end;
  buf := '';
  { the greeting }
  TcpReadLine(c, buf, line);
  WriteLn(line);
  if ParamCount >= 2 then
  begin
    cmd := ParamStr(2);
    if ParamCount >= 3 then
      cmd := cmd + ' ' + ParamStr(3);
    if ParamCount >= 4 then
      cmd := cmd + ' ' + ParamStr(4);
    TcpWrite(c, cmd + #10);
    Reply;
    TcpClose(c);
    Exit;
  end;
  while True do
  begin
    Write('> ');
    ReadLn(cmd);
    if cmd = '' then
      cmd := 'quit';
    if TcpWrite(c, cmd + #10) < 0 then
      Break;
    if not Reply then
      Break;
    if cmd = 'quit' then
      Break;
  end;
  TcpClose(c);
end.
